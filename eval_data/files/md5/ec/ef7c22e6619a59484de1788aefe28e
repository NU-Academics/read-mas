{"task_id": "Mbpp/308", "solution": "from typing import List\nfrom dataclasses import dataclass\ndef computeCartesian(list1: List[float], list2: List[float]) -> List[Product]:\n    \"\"\"Returns List[Product] for all possible factor pairs from list1 and list2.\"\"\"\n    products = []\n    for i, val1 in enumerate(list1):\n        for j, val2 in enumerate(list2):\n            products.append(Product(value=float(val1 * val2), factor1_index=i, factor2_index=j))\n    return products\ndef sortDescending(products: List[Product]) -> List[Product]:\n    \"\"\"Returns List[Product] sorted by product.value in descending order.\"\"\"\n    return sorted(products, key=lambda p: p.value, reverse=True)\ndef selectTopK(products: List[Product], k: int) -> List[float]:\n    \"\"\"Returns List[number] of up to k values from products.\"\"\"\n    top_products_slice = products[:k]\n    return [p.value for p in top_products_slice]\ndef large_product(list1: List[float], list2: List[float], k: int) -> List[float]:\n    \"\"\"\n    Public API: returns List[number] of the top k products (sorted descending).\n    Orchestrates computing Cartesian product, sorting, and selecting top K.\n    \"\"\"\n    products = computeCartesian(list1, list2)\n    sorted_products = sortDescending(products)\n    top_values = selectTopK(sorted_products, k)\n    return top_values"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Set the left-most unset (0) bit in integer n and return the resulting integer.\n    This function assumes n is a non-negative integer.\n    \"\"\"\n    k = n.bit_length()\n\n    if k == 0:\n        # If n is 0, its binary representation is \"0\". The left-most unset bit is at position 0.\n        mask = 1 << 0\n    else:\n        mask_found = False\n        # Search for the highest-order (left-most) 0 bit from k-1 down to 0.\n        for p in range(k - 1, -1, -1):\n            if ((n >> p) & 1) == 0:  # Check if the bit at position p is 0\n                mask = 1 << p\n                mask_found = True\n                break\n        \n        if not mask_found:\n            # If all bits from 0 to k-1 are 1 (e.g., n=7, binary 111),\n            # set the next higher-order bit at position k.\n            mask = 1 << k\n    \n    return n | mask"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n):\n    \"\"\"Return the largest power of two less than or equal to positive integer n.\"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n    k = n.bit_length() - 1\n    return 1 << k"}
{"task_id": "Mbpp/312", "solution": "import math\nclass Cone:\n    \"\"\"Lightweight cone model used internally by the module.\"\"\"\n\n    def __init__(self, radius, height):\n        self._radius = float(radius)\n        self._height = float(height)\n\n    def volume(self) -> float:\n        \"\"\"Compute V = (\u03c0 * radius^2 * height) / 3 and return float.\"\"\"\n        return (math.pi * (self._radius ** 2) * self._height) / 3.0\ndef volume_cone(radius, height) -> float:\n    \"\"\"Public API: compute the cone volume and return a float.\n    It converts inputs to float and computes V = (\u03c0 * r^2 * h) / 3 using math.pi.\n    \"\"\"\n    cone = Cone(radius, height)\n    return cone.volume()"}
{"task_id": "Mbpp/389", "solution": "class Error(Exception):\n    \"\"\"Custom exception for Lucas number calculation errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass Validator:\n    \"\"\"Validates input to ensure it's a non-negative integer.\"\"\"\n    def validate(self, n: int) -> None:\n        if not isinstance(n, int):\n            raise Error(f\"Input must be an integer, got {type(n).__name__}.\")\n        if n < 0:\n            raise Error(f\"Input must be a non-negative integer, got {n}.\")\nclass LucasSequence:\n    \"\"\"Computes Lucas numbers using an iterative approach.\"\"\"\n    L0 = 2\n    L1 = 1\n\n    def compute(self, n: int) -> int:\n        if n == 0:\n            return self.L0\n        if n == 1:\n            return self.L1\n\n        a, b = self.L0, self.L1\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b\ndef find_lucas(n: int) -> int:\n    \"\"\"Finds the n'th Lucas number. Raises Error on invalid input.\"\"\"\n    validator = Validator()\n    validator.validate(n)\n\n    lucas_sequence_engine = LucasSequence()\n    result = lucas_sequence_engine.compute(n)\n    \n    return result"}
{"task_id": "Mbpp/394", "solution": "from typing import Tuple\ndef check_distinct(input_tuple: tuple) -> bool:\n    \"\"\"\n    Checks if the given tuple contains no duplicate elements.\n    Compares elements using equality (==).\n    \"\"\"\n    seen = set()\n    for item in input_tuple:\n        if item in seen:\n            return False\n        seen.add(item)\n    return True"}
{"task_id": "Mbpp/391", "solution": "class ValidationError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\ndef convert_list_dictionary(primary: list, secondary: list, values: list) -> list:\n    \"\"\"\n    Convert three lists into a list of nested dictionaries.\n    Raises ValidationError if input list lengths are not equal.\n    \"\"\"\n    if not (len(primary) == len(secondary) == len(values)):\n        raise ValidationError(\"Input lists must have equal length\")\n\n    result = []\n    for i in range(len(primary)):\n        result.append({primary[i]: {secondary[i]: values[i]}})\n    return result"}
{"task_id": "Mbpp/390", "solution": "def _apply_format(value: any, pattern: str) -> str:\n    \"\"\"\n    Converts a value to its string representation and substitutes it into a pattern.\n    The substitution is a literal replacement of '{0}' in the pattern.\n    \"\"\"\n    s = str(value)\n    return pattern.replace('{0}', s)\ndef add_string(input_list: list, format_string: str) -> list:\n    \"\"\"\n    Applies a format string to each element in a list, returning a new list of formatted strings.\n    Each element is converted to its string representation and substitutes '{0}' in the format_string.\n    \"\"\"\n    output_list = []\n    for element in input_list:\n        formatted_element = _apply_format(element, format_string)\n        output_list.append(formatted_element)\n    return output_list"}
{"task_id": "Mbpp/392", "solution": "_memo_cache = {}\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Calculates the maximum sum for n using the recursive formula\n    f(n) = max(f(n/2) + f(n/3) + f(n/4) + f(n/5), n), with memoization.\n    \"\"\"\n    if n in _memo_cache:\n        return _memo_cache[n]\n\n    if n == 0:\n        _memo_cache[0] = 0\n        return 0\n\n    # Recursively calculate sums for subproblems using integer division\n    sum_parts = (\n        get_max_sum(n // 2) +\n        get_max_sum(n // 3) +\n        get_max_sum(n // 4) +\n        get_max_sum(n // 5)\n    )\n\n    result = max(sum_parts, n)\n    _memo_cache[n] = result\n    return result"}
{"task_id": "Mbpp/395", "solution": "import collections\nfrom typing import Optional, Dict\nclass InputString:\n    \"\"\"Lightweight wrapper around the input string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self.value)\nclass FrequencyMap:\n    \"\"\"Maintains counts and first-occurrence positions for characters.\"\"\"\n    def __init__(self):\n        self.counts: Dict[str, int] = {}\n        self.positions: Dict[str, int] = {}\n\n    def increment(self, char: str, index: int) -> None:\n        \"\"\"Increments the count for a character and records its first position.\"\"\"\n        self.counts[char] = self.counts.get(char, 0) + 1\n        if char not in self.positions:\n            self.positions[char] = index\n\n    def get_count(self, char: str) -> int:\n        \"\"\"Returns the count of a character.\"\"\"\n        return self.counts.get(char, 0)\n\n    def get_first_position(self, char: str) -> int:\n        \"\"\"Returns the first position of a character.\"\"\"\n        return self.positions.get(char, -1) # -1 implies not found\ndef first_non_repeating_character(input_str: str) -> Optional[str]:\n    \"\"\"\n    Finds the first non-repeated character in a given string.\n\n    Returns None if no non-repeating character exists or for an empty input string.\n    \"\"\"\n    if not input_str:\n        return None\n\n    input_string_wrapper = InputString(input_str)\n    freq_map = FrequencyMap()\n\n    # First pass: build frequency map and record first positions\n    for i, char in enumerate(input_string_wrapper.value):\n        freq_map.increment(char, i)\n\n    # Second pass: iterate through the string in original order to find the first non-repeating character\n    for char in input_string_wrapper.value:\n        if freq_map.get_count(char) == 1:\n            return char\n\n    # If no non-repeating character is found\n    return None"}
{"task_id": "Mbpp/397", "solution": "from dataclasses import dataclass\nclass MedianCalculator:\n    \"\"\"Encapsulates the median computation logic for three numeric values.\"\"\"\n    @staticmethod\n    def median_numbers(a: float, b: float, c: float) -> Result:\n        \"\"\"Computes the median of three numbers and returns it as a Result object.\"\"\"\n        inputs = [\n            NumberInput(value=a, position=0),\n            NumberInput(value=b, position=1),\n            NumberInput(value=c, position=2),\n        ]\n        inputs.sort(key=lambda x: x.value)\n        return Result(value=inputs[1].value)\ndef median_numbers(a: float, b: float, c: float) -> float:\n    \"\"\"Accepts three numeric inputs and returns the median as a float.\"\"\"\n    result_obj = MedianCalculator.median_numbers(a, b, c)\n    return result_obj.value"}
