{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"Compute and return sum_{k=1..n} (2k)^2. For n==0 return 0. Precondition: n is an int.\"\"\"\n    if n == 0:\n        return 0\n    return 4 * n * (n + 1) * (2 * n + 1) // 6"}
{"task_id": "Mbpp/290", "solution": "class InputList:\n    def __init__(self, items: list):\n        self.items = items\n\n    def validate(self) -> None:\n        \"\"\"Raise TypeError if items is not a list or any element is not a list.\"\"\"\n        if not isinstance(self.items, list):\n            raise TypeError(\"Input must be a list.\")\n        for sublist in self.items:\n            if not isinstance(sublist, list):\n                raise TypeError(\"All elements in the input list must be lists.\")\n\n    def getSublists(self) -> list:\n        \"\"\"Return the underlying list of sublists.\"\"\"\n        return self.items\nclass Sublist:\n    def __init__(self, items: list):\n        self.items = items\n\n    def length(self) -> int:\n        \"\"\"Return len(self.items).\"\"\"\n        return len(self.items)\nclass MaxLengthResult:\n    def __init__(self, max_length: int, chosen_sublist: list):\n        self.max_length = max_length\n        self.chosen_sublist = chosen_sublist\nclass MaxLengthCalculator:\n    def validateInput(self, input_list: InputList) -> None:\n        \"\"\"Delegate to input_list.validate(); raise TypeError on invalid input.\"\"\"\n        input_list.validate()\n\n    def compute(self, input_list: InputList) -> MaxLengthResult:\n        \"\"\"Scan sublists once to produce MaxLengthResult. Time complexity O(n).\"\"\"\n        max_len = 0\n        chosen_sublist = []\n\n        for raw_sublist in input_list.getSublists():\n            current_sublist = Sublist(raw_sublist)\n            current_length = current_sublist.length()\n            if current_length > max_len:\n                max_len = current_length\n                chosen_sublist = raw_sublist\n\n        return MaxLengthResult(max_len, chosen_sublist)\ndef max_length(list_of_lists):\n    \"\"\"Public API: validate argument type, return tuple (max_length:int, chosen_sublist:list) or raise TypeError.\"\"\"\n    input_list = InputList(list_of_lists)\n    calculator = MaxLengthCalculator()\n\n    calculator.validateInput(input_list)\n    result = calculator.compute(input_list)\n\n    return (result.max_length, result.chosen_sublist)"}
{"task_id": "Mbpp/286", "solution": "from typing import List\nfrom dataclasses import dataclass\ndef _compute_max_subarray_sum(base_array: Array, k: int) -> Result:\n    \"\"\"\n    Computes the maximum contiguous subarray sum in the conceptual\n    repeated array without constructing it explicitly.\n    \"\"\"\n    if k == 0 or base_array.n == 0:\n        return Result(0)\n\n    # Initialize variables for Kadane's, prefix, suffix, and total sum\n    kadane_max_single = -float('inf')\n    current_kadane_sum = 0\n    \n    prefix_max_sum = -float('inf')\n    current_prefix_sum = 0\n    \n    total_sum_arr = 0\n\n    # Calculate Kadane's max sum for a single copy and max prefix sum\n    for x in base_array.elements:\n        total_sum_arr += x\n        \n        current_prefix_sum += x\n        prefix_max_sum = max(prefix_max_sum, current_prefix_sum)\n        \n        current_kadane_sum = max(x, current_kadane_sum + x)\n        kadane_max_single = max(kadane_max_single, current_kadane_sum)\n\n    # Calculate max suffix sum\n    suffix_max_sum = -float('inf')\n    current_suffix_sum = 0\n    for x in reversed(base_array.elements):\n        current_suffix_sum += x\n        suffix_max_sum = max(suffix_max_sum, current_suffix_sum)\n\n    # Determine the overall maximum sum based on k\n    result_max_sum = kadane_max_single\n\n    if k > 1:\n        # Consider a sum spanning across two copies (prefix from first, suffix from second)\n        result_max_sum = max(result_max_sum, prefix_max_sum + suffix_max_sum)\n        \n        # If total sum of base array is positive, we can include it multiple times\n        if total_sum_arr > 0:\n            # Consider a sum spanning multiple copies: suffix + (k-2)*total_sum + prefix\n            result_max_sum = max(result_max_sum, prefix_max_sum + total_sum_arr * (k - 2) + suffix_max_sum)\n\n    return Result(result_max_sum)\ndef max_sub_array_sum_repeated(arr: List[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous array in the modified array\n    formed by repeating the given array k times.\n    \"\"\"\n    _validate_inputs(arr, n, k)\n    \n    base_array = Array(elements=arr, n=n)\n    \n    result = _compute_max_subarray_sum(base_array, k)\n    \n    return result.max_sum"}
{"task_id": "Mbpp/293", "solution": "import math\nclass RightTriangleCalculator:\n    @staticmethod\n    def otherside_rightangle(a: float, b: float) -> float:\n        \"\"\"Computes the hypotenuse using the Pythagorean theorem.\"\"\"\n        return math.sqrt(a * a + b * b)\ndef otherside_rightangle(a: float, b: float) -> float:\n    \"\"\"Finds the third side (hypotenuse) of a right-angled triangle.\"\"\"\n    return RightTriangleCalculator.otherside_rightangle(a, b)"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: list) -> int:\n    \"\"\"Compute and return number of inversions in arr.\n    An inversion is any index pair (i, j) where i < j and arr[i] > arr[j].\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return 0\n\n    inv_count = 0\n    for i in range(n):\n        for j in range(i + 1, n):\n            if arr[i] > arr[j]:\n                inv_count += 1\n    return inv_count"}
