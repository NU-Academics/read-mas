{"task_id": "Mbpp/8", "solution": "def square_nums(input_list):\n    \"\"\"Compute element-wise squares preserving input order.\"\"\"\n    output = []\n    for x in input_list:\n        output.append(x * x)\n    return output"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(a, b):\n    \"\"\"Finds the unique shared elements from two sequences (list or tuple).\n    Raises TypeError for invalid input types and returns a list of common elements.\n    \"\"\"\n    if not isinstance(a, (list, tuple)) or not isinstance(b, (list, tuple)):\n        raise TypeError(\"Inputs must be list or tuple\")\n\n    intersection = set(a) & set(b)\n    return list(intersection)"}
{"task_id": "Mbpp/7", "solution": "from typing import List\nclass InputString:\n    \"\"\"Immutable value object carrying the original input text.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    @property\n    def value(self) -> str:\n        return self._value\nclass Word:\n    \"\"\"Value object representing a tokenized word, preserving its text and length.\"\"\"\n    def __init__(self, text: str):\n        self._text = text\n        self._length = len(text)\n\n    @property\n    def text(self) -> str:\n        return self._text\n\n    @property\n    def length(self) -> int:\n        return self._length\nclass WordCollection:\n    \"\"\"A container for Word instances, capable of exporting them as a list of strings.\"\"\"\n    def __init__(self):\n        self._words: List[Word] = []\n\n    def add(self, word: Word):\n        self._words.append(word)\n\n    def as_list(self) -> List[str]:\n        return [word.text for word in self._words]\nclass TextProcessor:\n    \"\"\"Stateless service providing operations for tokenization and filtering of text.\"\"\"\n    def tokenize(self, input_string: InputString) -> List[Word]:\n        \"\"\"Splits the input string into Word objects based on whitespace.\"\"\"\n        tokens = input_string.value.split()\n        return [Word(token) for token in tokens]\n\n    def filterByMinLength(self, words: List[Word], min_len: int) -> List[Word]:\n        \"\"\"Filters a list of Word objects, keeping only those at least min_len long.\"\"\"\n        return [word for word in words if word.length >= min_len]\n\n    def find_char_long(self, input_string: InputString) -> WordCollection:\n        \"\"\"Orchestrates tokenization and filtering to find words of at least 4 characters.\"\"\"\n        all_words = self.tokenize(input_string)\n        filtered_words = self.filterByMinLength(all_words, 4)\n\n        collection = WordCollection()\n        for word in filtered_words:\n            collection.add(word)\n        return collection\ndef find_char_long(text: str) -> List[str]:\n    \"\"\"\n    Finds all words in a string that are at least 4 characters long.\n    Words are tokenized by whitespace and original casing is preserved.\n    \"\"\"\n    input_obj = InputString(text)\n    processor = TextProcessor()\n    word_collection = processor.find_char_long(input_obj)\n    return word_collection.as_list()"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(value: int) -> bool:\n    \"\"\"\n    Identifies whether an integer is a non-prime number.\n    Returns True if the number is not prime (composite, 0, 1, or negative), False if it is prime.\n    \"\"\"\n    if not isinstance(value, int):\n        raise TypeError(\"is_not_prime: value must be int\")\n\n    # Numbers less than 2 are not prime (0, 1, negative numbers).\n    if value < 2:\n        return True\n    \n    # 2 is the only even prime number.\n    if value == 2:\n        return False\n    \n    # All other even numbers greater than 2 are composite (not prime).\n    if value % 2 == 0:\n        return True\n    \n    # Check for odd divisors from 3 up to the square root of the value.\n    # If any divisor is found, the number is composite (not prime).\n    i = 3\n    while i * i <= value:\n        if value % i == 0:\n            return True  # Found a divisor, so it's not prime\n        i += 2  # Check only odd numbers\n            \n    # If no divisors were found, the number is prime.\n    return False # It is prime, so it is NOT not-prime."}
{"task_id": "Mbpp/9", "solution": "def _is_rotation(s: str, k: int) -> bool:\n    \"\"\"Return True if rotating s by k (cyclic shift) yields s.\"\"\"\n    rotated_s = s[k:] + s[:k]\n    return s == rotated_s\ndef find_Rotations(s: str) -> int:\n    \"\"\"Compute minimal positive rotation k per design and return it as int.\n       Raises TypeError for non-str inputs and ValueError for empty string.\"\"\"\n    n = len(s)\n    \n    # Iterate k from 1 up to n-1.\n    # If s is empty (n=0), range(1,0) is empty, loop is skipped, returns n (0).\n    for k in range(1, n):\n        if _is_rotation(s, k):\n            return k\n            \n    # If no 0 < k < n satisfies the condition, return len(s).\n    return n"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string, char_to_remove) -> str:\n    \"\"\"\n    Validate parameters and return a new string where the first and last occurrences\n    of char_to_remove in input_string are removed according to SRS rules.\n    Raises ValueError on invalid parameters.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise ValueError(\"input_string must be a str\")\n    if not isinstance(char_to_remove, str) or len(char_to_remove) != 1:\n        raise ValueError(\"char_to_remove must be a single-character str\")\n\n    first_index = input_string.find(char_to_remove)\n    last_index = input_string.rfind(char_to_remove)\n\n    if first_index == -1:\n        return input_string\n\n    # Collect indices to skip: first and last occurrence.\n    # If char_to_remove occurs only once, first_index == last_index, so only one index is added to the set.\n    indices_to_skip = {first_index, last_index}\n\n    result_chars = []\n    for i, char in enumerate(input_string):\n        if i not in indices_to_skip:\n            result_chars.append(char)\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/6", "solution": "class IntegerInput:\n    \"\"\"Lightweight container for two integer inputs.\"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\nclass BitCounter:\n    \"\"\"Stateless utility to count set bits (popcount).\"\"\"\n    @staticmethod\n    def count_set_bits(x: int) -> int:\n        \"\"\"Counts the number of set bits in an integer using Python's built-in method.\"\"\"\n        return x.bit_count()\nclass XORResult:\n    \"\"\"Store xor value and compute population count.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def bit_count(self) -> int:\n        \"\"\"Returns the population count of the stored XOR value.\"\"\"\n        return BitCounter.count_set_bits(self.value)\ndef differ_At_One_Bit_Pos(a, b) -> bool:\n    \"\"\"\n    Checks if two numbers differ at exactly one bit position.\n    \"\"\"\n    # Create IntegerInput for precondition clarity as per design.\n    _ = IntegerInput(a, b)\n\n    xor_value = a ^ b\n    xr = XORResult(xor_value)\n    popcount = xr.bit_count()\n\n    return popcount == 1"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List, Iterable, Iterator\nclass Validator:\n    \"\"\"Validates input arguments for type and content as per design.\"\"\"\n    def validate_iterable(self, iterable: Iterable) -> None:\n        \"\"\"Confirms object is iterable and elements are numeric types.\"\"\"\n        if not hasattr(iterable, '__iter__'):\n            raise TypeError(\"Input must be an iterable.\")\n        \n        # The design states to validate elements are numeric.\n        # This approach iterates the given iterable once for validation.\n        # If the iterable is a generator, it will be consumed here.\n        # The design implies list_of_numbers is passed to validate_iterable and then\n        # filter_integer_values, suggesting it's not a single-pass generator\n        # or that a consumed generator is an acceptable consequence of validation.\n        # For a truly robust design with generators, validation would need to\n        # create a tee object or pass a separate copy.\n        # Sticking to the literal design, we iterate the original.\n        for i, element in enumerate(iterable):\n            if not isinstance(element, (int, float)):\n                raise TypeError(f\"Iterable element at index {i} is not a number (int or float).\")\n\n    def validate_n(self, n: int) -> None:\n        \"\"\"Confirms n is an integer.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"n must be an integer.\")\nclass IntegerFilter:\n    \"\"\"Filters an iterable to yield only integer-valued elements.\"\"\"\n    def filter_integer_values(self, iterable: Iterable) -> Iterator[int]:\n        \"\"\"Yields integer-valued elements from the iterable.\"\"\"\n        for element in iterable:\n            if isinstance(element, int):\n                yield element\n            elif isinstance(element, float) and element.is_integer():\n                yield int(element)\nclass HeapSelector:\n    \"\"\"Selects the top-k largest integers using a min-heap.\"\"\"\n    def select_top_k(self, integers: Iterator[int], k: int) -> List[int]:\n        \"\"\"Maintains a min-heap of size up to k, containing the largest integers.\"\"\"\n        min_heap: List[int] = []\n        if k <= 0:\n            return []\n\n        for number in integers:\n            if len(min_heap) < k:\n                heapq.heappush(min_heap, number)\n            elif number > min_heap[0]:\n                heapq.heappushpop(min_heap, number)\n        return min_heap\nclass ResultList:\n    \"\"\"Holds a list of integers and provides a method to sort them in descending order.\"\"\"\n    def __init__(self, values: List[int]):\n        \"\"\"Initializes with a list of values.\"\"\"\n        self.values = values\n\n    def sort_desc(self) -> List[int]:\n        \"\"\"Returns the stored values sorted in descending order.\"\"\"\n        return sorted(self.values, reverse=True)\ndef heap_queue_largest(list_of_numbers: Iterable, n: int) -> List[int]:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n    Validates inputs, filters for integer values, selects using a heap, and sorts the result.\n    \"\"\"\n    validator = Validator()\n    # The design implies validate_iterable can consume generators if iterated fully.\n    # To conform to passing the original iterable to IntegerFilter later, we might\n    # need to convert list_of_numbers to a list first if it could be a generator\n    # and we fully iterate for validation. The sequence diagram, however, implies\n    # passing the same object twice.\n    # We create a list copy to allow validation iteration without consuming the\n    # original for IntegerFilter, ensuring independent processing.\n    if hasattr(list_of_numbers, '__iter__') and not isinstance(list_of_numbers, (list, tuple)):\n        # If it's a generator or other single-pass iterable, convert to list for validation\n        # and subsequent filtering, as validate_iterable iterates it fully.\n        processed_list_of_numbers = list(list_of_numbers)\n    else:\n        processed_list_of_numbers = list_of_numbers\n\n    validator.validate_iterable(processed_list_of_numbers)\n    validator.validate_n(n)\n\n    if n <= 0:\n        return []\n\n    integer_filter = IntegerFilter()\n    integer_iter = integer_filter.filter_integer_values(processed_list_of_numbers)\n\n    heap_selector = HeapSelector()\n    selected = heap_selector.select_top_k(integer_iter, n)\n\n    result_list = ResultList(selected)\n    return result_list.sort_desc()"}
