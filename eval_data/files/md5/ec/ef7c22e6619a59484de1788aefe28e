{"task_id": "Mbpp/126", "solution": "from typing import List\nclass NumberPair:\n    \"\"\"Encapsulates two integer inputs a and b.\"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\nclass Divisor:\n    \"\"\"Represents a candidate divisor value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def isCommon(self, pair: 'NumberPair') -> bool:\n        \"\"\"Returns True if value divides both pair.a and pair.b with zero remainder.\"\"\"\n        return pair.a % self.value == 0 and pair.b % self.value == 0\nclass DivisorCalculator:\n    \"\"\"Computes divisors, determines common divisors, and sums them.\"\"\"\n    def find_divisors(self, n: int) -> List[int]:\n        \"\"\"Return a list of positive integer divisors of n (>= 1).\"\"\"\n        if n == 0:\n            return []\n        divisors = []\n        for i in range(1, abs(n) + 1):\n            if n % i == 0:\n                divisors.append(i)\n        return divisors\n\n    def find_common_divisors(self, pair: 'NumberPair') -> List[int]:\n        \"\"\"Return a list of positive integers dividing both pair.a and pair.b.\"\"\"\n        divisors_a = set(self.find_divisors(pair.a))\n        divisors_b = set(self.find_divisors(pair.b))\n        common_values = list(divisors_a.intersection(divisors_b))\n        common_divs = []\n        for val in common_values:\n            # The design context mentions Divisor.isCommon but for common divisors\n            # found by intersection, this check is redundant and implicit.\n            # However, to strictly follow the \"loop for each value in common_values, Calc->>Div: create Divisor(value), Div->>Calc: Divisor.isCommon(NumberPair)\"\n            # sequence diagram, we'll instantiate Divisor and call isCommon.\n            # In a simplified implementation, we'd just return common_values.\n            divisor_obj = Divisor(val)\n            if divisor_obj.isCommon(pair): # This will always be true given how common_values are derived\n                common_divs.append(val)\n        return common_divs\n\n    def sum_common_divisors(self, pair: 'NumberPair') -> int:\n        \"\"\"Return the integer sum of the common positive divisors.\"\"\"\n        common_divs = self.find_common_divisors(pair)\n        return sum(common_divs)\ndef sum(a: int, b: int) -> int:\n    \"\"\"\n    Finds the sum of common divisors of two given numbers.\n    The function delegates computation to DivisorCalculator methods.\n    \"\"\"\n    number_pair = NumberPair(a, b)\n    calculator = DivisorCalculator()\n    total_sum = calculator.sum_common_divisors(number_pair)\n    return total_sum"}
{"task_id": "Mbpp/123", "solution": "import math\nfrom typing import Optional, List, Dict\nclass DivisorSum:\n    \"\"\"Computes the sum of proper divisors for a given number.\"\"\"\n    def compute(self, n_value: int) -> int:\n        if n_value <= 1:\n            return 0\n        s = 1\n        for i in range(2, int(math.sqrt(n_value)) + 1):\n            if n_value % i == 0:\n                s += i\n                if i * i != n_value:\n                    s += n_value // i\n        return s\nclass Number:\n    \"\"\"Represents a number with a cached sum of its proper divisors.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n        self._proper_divisor_sum_cache: Optional[int] = None\n\n    def properDivisorSum(self) -> int:\n        \"\"\"Calculates and caches the sum of proper divisors.\"\"\"\n        if self._proper_divisor_sum_cache is None:\n            self._proper_divisor_sum_cache = DivisorSum().compute(self.value)\n        return self._proper_divisor_sum_cache\nclass AmicablePair:\n    \"\"\"Checks if two Number instances form an amicable pair.\"\"\"\n    def __init__(self, a: Number, b: Number):\n        self.a = a\n        self.b = b\n\n    def isAmicable(self) -> bool:\n        \"\"\"\n        Returns True iff a.value != b.value and their proper divisor sums match\n        their respective partners (perfect numbers implicitly excluded).\n        \"\"\"\n        return (self.a.value != self.b.value and\n                self.a.properDivisorSum() == self.b.value and\n                self.b.properDivisorSum() == self.a.value)\nclass Range:\n    \"\"\"Generates Number instances within a specified range.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def numbersInRange(self) -> List[Number]:\n        \"\"\"Returns a list of Number instances for 1..n inclusive.\"\"\"\n        return [Number(i) for i in range(1, self.n + 1)]\nclass Result:\n    \"\"\"Stores the aggregated sum and contributing numbers.\"\"\"\n    def __init__(self):\n        self.sum: int = 0\n        self.contributingNumbers: List[Number] = []\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"\n    Sums all amicable numbers from 1 to a specified number n.\n    \"\"\"\n    if n < 1:\n        return 0\n\n    number_range = Range(n)\n    all_numbers_in_range: List[Number] = number_range.numbersInRange()\n\n    # Create a mapping from value to Number object for efficient lookups\n    number_objects_map: Dict[int, Number] = {num.value: num for num in all_numbers_in_range}\n\n    result = Result()\n    processed_amicable_values: set[int] = set()\n\n    for number_a in all_numbers_in_range:\n        a_value = number_a.value\n\n        if a_value in processed_amicable_values:\n            continue\n\n        sum_a = number_a.properDivisorSum()\n\n        # Candidate for 'b' must be within the range [1, n] and distinct from 'a'\n        if 1 <= sum_a <= n and sum_a != a_value:\n            number_b = number_objects_map[sum_a]\n            \n            # Check if (number_a, number_b) form an amicable pair\n            pair = AmicablePair(number_a, number_b)\n            if pair.isAmicable():\n                result.sum += number_a.value + number_b.value\n                result.contributingNumbers.append(number_a)\n                result.contributingNumbers.append(number_b)\n                processed_amicable_values.add(number_a.value)\n                processed_amicable_values.add(number_b.value)\n\n    return result.sum"}
{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    \"\"\"\n    Calculates the maximum difference between the number of 0s and 1s\n    in any contiguous substring of the given binary string.\n    \"\"\"\n    # Map '0' to +1 and '1' to -1, then apply a Kadane-like algorithm.\n    # Assume input 's' is a non-empty string of '0's and '1's based on requirements.\n    \n    # Initialize max_so_far and current_max using the first character's mapped value.\n    # This handles the case where all differences are negative (e.g., all '1's).\n    current_val = 1 if s[0] == '0' else -1\n    max_so_far = current_val\n    current_max = current_val\n\n    for char in s[1:]:\n        val = 1 if char == '0' else -1\n        # Kadane's algorithm variation: either start a new subarray or extend the current one\n        current_max = max(val, current_max + val)\n        # Update the overall maximum found\n        max_so_far = max(max_so_far, current_max)\n        \n    return max_so_far"}
{"task_id": "Mbpp/128", "solution": "class InputWords:\n    \"\"\"Normalizes input (string or list) into a list of tokens.\"\"\"\n    def __init__(self, words):\n        self._raw = words\n        self._tokens = None\n\n    def parse(self):\n        \"\"\"\n        Parses the raw input into a list of string tokens.\n        Splits string input on contiguous whitespace; returns a shallow copy for list input.\n        \"\"\"\n        if self._tokens is not None:\n            return self._tokens\n\n        if isinstance(self._raw, str):\n            self._tokens = self._raw.split()\n        elif isinstance(self._raw, list):\n            self._tokens = list(self._raw)\n        return self._tokens\nclass Word:\n    \"\"\"Represents a token and provides its length.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the word's text.\"\"\"\n        return len(self.text)\nclass ResultList:\n    \"\"\"Accumulates result tokens, preserving input order.\"\"\"\n    def __init__(self):\n        self._items = []\n\n    def append(self, word: str):\n        \"\"\"Appends a word to the internal list of results.\"\"\"\n        self._items.append(word)\n\n    def items(self) -> list[str]:\n        \"\"\"Returns a shallow copy of the accumulated items.\"\"\"\n        return list(self._items)\nclass LongWordsFunction:\n    \"\"\"Orchestrates parsing and filtering tokens based on length > n.\"\"\"\n    @staticmethod\n    def long_words(n: int, words: str | list[str]) -> list[str]:\n        input_parser = InputWords(words)\n        tokens = input_parser.parse()\n        \n        result_list = ResultList()\n        \n        for token_text in tokens:\n            word_obj = Word(token_text)\n            if word_obj.length() > n:\n                result_list.append(word_obj.text)\n                \n        return result_list.items()\ndef long_words(n, words):\n    \"\"\"\n    Return list[str] of tokens whose length > n.\n    Delegates to LongWordsFunction.long_words for implementation.\n    \"\"\"\n    return LongWordsFunction.long_words(n, words)"}
{"task_id": "Mbpp/130", "solution": "from typing import Any\nclass FrequencyMap:\n    \"\"\"Maintains counts for distinct values and provides the value with maximal count.\"\"\"\n    def __init__(self):\n        self.counts: dict[Any, int] = {}\n\n    def increment(self, value: Any) -> None:\n        \"\"\"Increments the count for a given value.\"\"\"\n        self.counts[value] = self.counts.get(value, 0) + 1\n\n    def max_key(self) -> Any:\n        \"\"\"Returns the key with the highest count, raising ValueError if the map is empty.\"\"\"\n        if not self.counts:\n            raise ValueError(\"FrequencyMap is empty, no max key to return.\")\n\n        max_val = None\n        max_freq = -1\n\n        for key, freq in self.counts.items():\n            if freq > max_freq:\n                max_freq = freq\n                max_val = key\n        return max_val\ndef max_occurrences(items: list) -> Any:\n    \"\"\"\n    Finds the item with maximum frequency in a given list.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not items:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    frequency_map = FrequencyMap()\n    for item in items:\n        frequency_map.increment(item)\n\n    return frequency_map.max_key()"}
{"task_id": "Mbpp/129", "solution": "def _is_list_of_lists(obj) -> bool:\n    \"\"\"Checks if the object is a list where all elements are lists.\"\"\"\n    if not isinstance(obj, list):\n        return False\n    return all(isinstance(sublist, list) for sublist in obj)\nclass Matrix:\n    \"\"\"Represents a 2D list matrix with basic accessors and shape check.\"\"\"\n    def __init__(self, rows: list) -> None:\n        self.rows = rows\n        self.n = len(rows)\n\n    def get(self, i: int, j: int):\n        \"\"\"Retrieves the element at the specified row and column.\"\"\"\n        return self.rows[i][j]\n\n    def is_square(self) -> bool:\n        \"\"\"Checks if the matrix is n x n with n >= 1 and is a list of lists.\"\"\"\n        if self.n < 1:\n            return False\n        if not _is_list_of_lists(self.rows):\n            return False\n        for row in self.rows:\n            if len(row) != self.n:\n                return False\n        return True\nclass Validator:\n    \"\"\"Provides methods to validate matrix shape and element types.\"\"\"\n    def validate_matrix_shape(self, matrix: Matrix) -> bool:\n        \"\"\"Validates if the matrix is square and has at least one row/column.\"\"\"\n        return matrix.is_square()\n\n    def validate_elements_numeric(self, matrix: Matrix) -> bool:\n        \"\"\"Validates if all elements in the matrix are numbers (int or float).\"\"\"\n        for i in range(matrix.n):\n            for j in range(matrix.n):\n                if not isinstance(matrix.get(i, j), (int, float)):\n                    return False\n        return True\nclass MagicSquareTest:\n    \"\"\"Contains domain logic for magic square computations and comparisons.\"\"\"\n    def compute_row_sums(self, matrix: Matrix) -> list:\n        \"\"\"Computes the sum of elements for each row.\"\"\"\n        sums = []\n        for i in range(matrix.n):\n            current_sum = 0\n            for j in range(matrix.n):\n                current_sum += matrix.get(i, j)\n            sums.append(current_sum)\n        return sums\n\n    def compute_col_sums(self, matrix: Matrix) -> list:\n        \"\"\"Computes the sum of elements for each column.\"\"\"\n        sums = []\n        for j in range(matrix.n):\n            current_sum = 0\n            for i in range(matrix.n):\n                current_sum += matrix.get(i, j)\n            sums.append(current_sum)\n        return sums\n\n    def compute_diagonal_sums(self, matrix: Matrix) -> list:\n        \"\"\"Computes sums for the main diagonal and the anti-diagonal.\"\"\"\n        main_diag_sum = 0\n        anti_diag_sum = 0\n        for i in range(matrix.n):\n            main_diag_sum += matrix.get(i, i)\n            anti_diag_sum += matrix.get(i, matrix.n - 1 - i)\n        return [main_diag_sum, anti_diag_sum]\n\n    def all_sums_equal(self, sums: list) -> bool:\n        \"\"\"Checks if all collected sums are identical.\"\"\"\n        if not sums:\n            return True\n        first_sum = sums[0]\n        for s in sums:\n            if s != first_sum:\n                return False\n        return True\n\n    def magic_square_test(self, matrix: Matrix) -> bool:\n        \"\"\"Orchestrates sum computations and checks if they are all equal.\"\"\"\n        row_sums = self.compute_row_sums(matrix)\n        col_sums = self.compute_col_sums(matrix)\n        diag_sums = self.compute_diagonal_sums(matrix)\n\n        all_collected_sums = row_sums + col_sums + diag_sums\n\n        is_magic = self.all_sums_equal(all_collected_sums)\n        \n        # TestResult DTO is used internally per design, but the method returns bool\n        # magic_sum = all_collected_sums[0] if is_magic and all_collected_sums else None\n        # result_dto = TestResult(is_magic, magic_sum) \n\n        return is_magic\ndef magic_square_test(matrix_list) -> bool:\n    \"\"\"\n    Determines if a given 2D list represents a magic square.\n    Returns True if it is a magic square, False otherwise.\n    \"\"\"\n    matrix_obj = Matrix(matrix_list)\n    validator = Validator()\n\n    if not validator.validate_matrix_shape(matrix_obj):\n        return False\n    if not validator.validate_elements_numeric(matrix_obj):\n        return False\n\n    magic_square_tester = MagicSquareTest()\n    return magic_square_tester.magic_square_test(matrix_obj)"}
{"task_id": "Mbpp/132", "solution": "from dataclasses import dataclass\nclass InputValidator:\n    \"\"\"Validates that input is a tuple of single-character strings.\"\"\"\n    def is_valid(self, chars: tuple) -> bool:\n        \"\"\"Return True if chars is a tuple and each element is a string of length 1, otherwise False.\"\"\"\n        if not isinstance(chars, tuple):\n            return False\n        for char in chars:\n            if not isinstance(char, str) or len(char) != 1:\n                return False\n        return True\ndef tup_string(chars: tuple) -> str:\n    \"\"\"\n    Accepts chars: tuple (each element a single-character string) and returns concatenated string.\n    Raises ValueError on invalid input per design choice.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.is_valid(chars):\n        raise ValueError(\"Input must be a tuple of single-character strings\")\n\n    return \"\".join(chars)"}
{"task_id": "Mbpp/131", "solution": "VOWEL_SET = {\"a\",\"e\",\"i\",\"o\",\"u\",\"A\",\"E\",\"I\",\"O\",\"U\"}\ndef is_vowel(c: str) -> bool:\n    \"\"\"Checks if a character is a vowel based on VOWEL_SET.\"\"\"\n    return c in VOWEL_SET\ndef _collect_vowel_indices(s: str) -> list[int]:\n    \"\"\"Collects the indices of all vowels in the string.\"\"\"\n    indices = []\n    for i, char in enumerate(s):\n        if is_vowel(char):\n            indices.append(i)\n    return indices\ndef _collect_vowel_chars(s: str, indices: list[int]) -> list[str]:\n    \"\"\"Extracts characters from string s at the given indices.\"\"\"\n    chars = []\n    for i in indices:\n        chars.append(s[i])\n    return chars\ndef _reconstruct_string(s: str, indices: list[int], reversed_vowels: list[str]) -> str:\n    \"\"\"Builds a new string by replacing characters at indices with reversed_vowels.\"\"\"\n    s_list = list(s)\n    for i, idx in enumerate(indices):\n        s_list[idx] = reversed_vowels[i]\n    return \"\".join(s_list)\ndef reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels in a given string (where y is not a vowel).\n    Non-vowel characters maintain their original positions.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    vowel_indices = _collect_vowel_indices(s)\n\n    if not vowel_indices:\n        return s\n\n    vowel_chars = _collect_vowel_chars(s, vowel_indices)\n    reversed_vowel_chars = vowel_chars[::-1]\n\n    return _reconstruct_string(s, vowel_indices, reversed_vowel_chars)"}
{"task_id": "Mbpp/133", "solution": "class SumNegativeCalculator:\n    \"\"\"Computes the sum of negative numbers from a list.\"\"\"\n    def sumNegatives(self, numbers: list) -> float:\n        total_sum = 0.0\n        for num in numbers:\n            if num < 0:\n                total_sum += num\n        return total_sum\ndef sum_negativenum(numbers: list) -> float:\n    \"\"\"\n    Calculates the sum of negative numbers in a given list.\n    This function delegates the calculation to a SumNegativeCalculator instance.\n    \"\"\"\n    calculator = SumNegativeCalculator()\n    return calculator.sumNegatives(numbers)"}
