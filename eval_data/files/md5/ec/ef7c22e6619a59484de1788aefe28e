{"task_id": "Mbpp/100", "solution": "class PalindromeChecker:\n    \"\"\"\n    Stateless utility class for palindrome detection and searching.\n    \"\"\"\n    def is_palindrome(self, n: int) -> bool:\n        \"\"\"\n        Checks if an integer reads the same forwards and backwards.\n        \"\"\"\n        s = str(n)\n        return s == s[::-1]\n\n    def find_next(self, n: int) -> int:\n        \"\"\"\n        Finds the smallest integer strictly greater than n that is a palindrome.\n        \"\"\"\n        candidate = n + 1\n        while True:\n            if self.is_palindrome(candidate):\n                return candidate\n            candidate += 1\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome of a specified integer.\n    \"\"\"\n    checker = PalindromeChecker()\n    return checker.find_next(n)"}
{"task_id": "Mbpp/98", "solution": "import numbers\nfrom typing import Sequence, List\nclass NumericValue:\n    \"\"\"Wraps a numeric primitive and provides type checking.\"\"\"\n    def __init__(self, value):\n        self._value = value\n\n    def isNumeric(self) -> bool:\n        \"\"\"Checks if the wrapped value is a numeric type.\"\"\"\n        return isinstance(self._value, numbers.Number)\n\n    def get_value(self):\n        \"\"\"Returns the wrapped numeric value.\"\"\"\n        return self._value\nclass InputSequence:\n    \"\"\"Represents an ordered collection of validated NumericValue elements.\"\"\"\n    def __init__(self, sequence_or_iterable):\n        if not isinstance(sequence_or_iterable, Sequence) or isinstance(sequence_or_iterable, str):\n            raise TypeError(\"Input must be a sequence (e.g., list, tuple) of numbers, not a string.\")\n        \n        self._elements: List[NumericValue] = []\n        for item in sequence_or_iterable:\n            numeric_item = NumericValue(item)\n            if not numeric_item.isNumeric():\n                raise TypeError(f\"All elements in the sequence must be numeric. Found non-numeric type: {type(item).__name__} with value '{item}'\")\n            self._elements.append(numeric_item)\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the sequence.\"\"\"\n        return len(self._elements)\n\n    def getElements(self) -> List[NumericValue]:\n        \"\"\"Returns the list of NumericValue objects.\"\"\"\n        return self._elements\nclass CalculationResult:\n    \"\"\"Container for a numeric result, ensuring it can be retrieved as a float.\"\"\"\n    def __init__(self, value: float):\n        self._value = float(value)\n\n    def asFloat(self) -> float:\n        \"\"\"Returns the stored value as a float.\"\"\"\n        return self._value\nclass MultiplyNumFunction:\n    \"\"\"Domain service responsible for computing the product-then-divide operation.\"\"\"\n    def compute(self, seq: InputSequence) -> CalculationResult:\n        \"\"\"Computes the product of elements divided by the sequence length.\"\"\"\n        product = 1.0\n        for numeric_value_obj in seq.getElements():\n            product *= numeric_value_obj.get_value()\n        \n        length = seq.length()\n        if length == 0:\n            raise ValueError(\"Input sequence cannot be empty.\")\n        \n        final_result = product / length\n        return CalculationResult(final_result)\ndef multiply_num(sequence) -> float:\n    \"\"\"\n    Multiplies all numbers in a sequence and divides the product by the sequence's length.\n    Raises TypeError for invalid input or ValueError for an empty sequence.\n    \"\"\"\n    input_seq = InputSequence(sequence)\n    \n    multiplier = MultiplyNumFunction()\n    result_obj = multiplier.compute(input_seq)\n    \n    return result_obj.asFloat()"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(input_str: str) -> str:\n    \"\"\"Converts a snake_case string to CamelCase by splitting, capitalizing, and joining words.\"\"\"\n    words = input_str.split('_')\n    capitalized_words = [word.capitalize() for word in words if word]\n    return ''.join(capitalized_words)"}
{"task_id": "Mbpp/103", "solution": "class ValidationError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass EulerianNumber:\n    def __init__(self, value: int):\n        self._value = value\n    def get(self) -> int:\n        return self._value\nclass InputValidator:\n    def validate_types(self, n, m) -> None:\n        \"\"\"Raise ValidationError if n or m are not integers.\"\"\"\n        if not isinstance(n, int):\n            raise ValidationError(\"n must be an integer.\")\n        if not isinstance(m, int):\n            raise ValidationError(\"m must be an integer.\")\n\n    def validate_ranges(self, n, m) -> None:\n        \"\"\"Raise ValidationError if not (0 <= m < n).\"\"\"\n        if not (0 <= m < n):\n            raise ValidationError(f\"Invalid range: 0 <= m < n is required, but m={m}, n={n}.\")\nclass EulerianCalculator:\n    def __init__(self, validator: InputValidator = None):\n        self._validator = validator if validator is not None else InputValidator()\n        self._memo = {}\n\n    def eulerian_num(self, n: int, m: int) -> int:\n        \"\"\"Validate inputs then compute Eulerian number and return int.\"\"\"\n        self._validator.validate_types(n, m)\n        self._validator.validate_ranges(n, m)\n        self._memo = {}  # Reset memoization for each public call\n        result = self.compute_by_recurrence(n, m)\n        return EulerianNumber(result).get()\n\n    def compute_by_recurrence(self, n: int, m: int) -> int:\n        \"\"\"Internal recurrence-based implementation producing integer a(n,m).\"\"\"\n        if m < 0 or m >= n:\n            return 0\n        if n == 1 and m == 0:\n            return 1\n\n        if (n, m) in self._memo:\n            return self._memo[(n, m)]\n\n        val = (n - m) * self.compute_by_recurrence(n - 1, m - 1) + \\\n              (m + 1) * self.compute_by_recurrence(n - 1, m)\n        \n        self._memo[(n, m)] = val\n        return val\ndef eulerian_num(n, m) -> int:\n    \"\"\"Public package-level function. Constructs EulerianCalculator (which uses InputValidator) and returns integer result or propagates ValidationError.\"\"\"\n    calc = EulerianCalculator()\n    return calc.eulerian_num(n, m)"}
{"task_id": "Mbpp/105", "solution": "def count(items: list) -> int:\n    \"\"\"Counts literal True booleans in the given list.\n\n    Only elements that are exactly `True` are counted; truthy non-booleans are ignored.\n    \"\"\"\n    true_count = 0\n    for item in items:\n        if item is True:\n            true_count += 1\n    return true_count"}
{"task_id": "Mbpp/104", "solution": "def sort_sublists(input_sequence):\n    \"\"\"\n    Sorts each sublist of strings in a given list or tuple of lists.\n    Returns a new list of lists with each sublist sorted lexicographically.\n    \"\"\"\n    sorted_main_list = []\n    for sublist in input_sequence:\n        sorted_sublist = sorted(sublist)\n        sorted_main_list.append(sorted_sublist)\n    return sorted_main_list"}
{"task_id": "Mbpp/106", "solution": "def add_lists(lst: list, tup: tuple) -> tuple:\n    \"\"\"Return a tuple containing elements of tup followed by elements of lst.\n\n    Raises:\n        TypeError: if lst is not a list or tup is not a tuple.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"First argument must be a list\")\n    if not isinstance(tup, tuple):\n        raise TypeError(\"Second argument must be a tuple\")\n    # tuple(lst) is O(m); tup + tuple(lst) is O(n + m)\n    return tup + tuple(lst)"}
{"task_id": "Mbpp/108", "solution": "def merge_sorted_list(list1, list2, list3):\n    \"\"\"\n    Merges three lists into a single sorted list, preserving duplicates.\n    The input lists are not modified.\n    \"\"\"\n    combined_list = list1 + list2 + list3\n    return sorted(combined_list)"}
{"task_id": "Mbpp/113", "solution": "def check_integer(input: str) -> bool:\n    \"\"\"\n    Evaluate whether the provided input string represents an integer.\n\n    Returns True if input represents an integer, otherwise False.\n    \"\"\"\n    s = input.strip()\n\n    if not s:\n        return False\n\n    start_index = 0\n    if s[0] == '+' or s[0] == '-':\n        start_index = 1\n\n    # The remaining part of the string must contain at least one digit\n    # and all characters in it must be digits.\n    numeric_part = s[start_index:]\n    return bool(numeric_part) and numeric_part.isdigit()"}
{"task_id": "Mbpp/111", "solution": "from typing import List, Any\ndef common_in_nested_lists(nested_lists: List[List[Any]]) -> List[Any]:\n    \"\"\"\n    Finds elements common to all sublists in a given list of lists.\n    Returns a list of unique common elements, handling edge cases like empty input or single sublist.\n    \"\"\"\n    if not nested_lists:\n        return []\n\n    # Initialize the set of common elements with the unique elements of the first sublist\n    common_elements = set(nested_lists[0])\n\n    # If there's only one sublist, return its unique elements\n    if len(nested_lists) == 1:\n        return list(common_elements)\n\n    # Iterate through the rest of the sublists to find the intersection\n    for sublist in nested_lists[1:]:\n        common_elements.intersection_update(sublist)\n        # Optimization: if common_elements becomes empty, no more common elements are possible\n        if not common_elements:\n            return []\n\n    return list(common_elements)"}
{"task_id": "Mbpp/109", "solution": "import collections\nclass BinaryString:\n    \"\"\"Encapsulates a binary string and provides rotation and oddness checks.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n        self.length = len(value)\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the string is non-empty and contains only '0' or '1'.\"\"\"\n        if not self._value:\n            return False\n        return all(char in ('0', '1') for char in self._value)\n\n    def rotate_left(self) -> 'BinaryString':\n        \"\"\"Returns a new BinaryString rotated left by one position.\"\"\"\n        if self.length <= 1:\n            return BinaryString(self._value)\n        return BinaryString(self._value[1:] + self._value[0])\n\n    def is_odd(self) -> bool:\n        \"\"\"Returns True if the rightmost character is '1'.\"\"\"\n        if not self._value: # Should be prevented by validation, but defensive.\n            return False\n        return self._value[-1] == '1'\nclass Validator:\n    \"\"\"Provides static methods for input validation.\"\"\"\n    @staticmethod\n    def validate_binary_string(value: str) -> None:\n        \"\"\"Validates if the string is a non-empty binary string.\"\"\"\n        if not value:\n            raise ValueError(\"binary_string cannot be empty.\")\n        if not all(char in ('0', '1') for char in value):\n            raise ValueError(\"binary_string must contain only '0' or '1'.\")\n\n    @staticmethod\n    def validate_k(k) -> None:\n        \"\"\"Validates if k is a non-negative integer.\"\"\"\n        if not isinstance(k, int):\n            raise ValueError(\"k must be an integer.\")\n        if k < 0:\n            raise ValueError(\"k must be non-negative.\")\nclass RotationEngine:\n    \"\"\"Generates configurations by left-rotating the original binary string.\"\"\"\n    def __init__(self, original: BinaryString, k: int):\n        self.original = original\n        self.k = k\n        self._current_index = 0\n\n    def get_configuration_at(self, i: int) -> BinaryString:\n        \"\"\"Computes the binary string configuration at a specific rotation index.\"\"\"\n        effective_rotation = i % self.original.length\n        rotated_str = self.original._value[effective_rotation:] + self.original._value[:effective_rotation]\n        return BinaryString(rotated_str)\n\n    def __iter__(self):\n        \"\"\"Returns the iterator object itself.\"\"\"\n        return self\n\n    def __next__(self):\n        \"\"\"Returns the next rotated configuration until k examinations are met.\"\"\"\n        if self._current_index >= self.k:\n            raise StopIteration\n        \n        config = self.get_configuration_at(self._current_index)\n        self._current_index += 1\n        return config\nclass Counter:\n    \"\"\"Counts the number of odd configurations from a RotationEngine.\"\"\"\n    def count_odd(self, engine: RotationEngine) -> int:\n        \"\"\"Iterates through configurations from the engine and counts odd ones.\"\"\"\n        odd_count = 0\n        for config in engine:\n            if config.is_odd():\n                odd_count += 1\n        return odd_count\nclass Result:\n    \"\"\"A value object to hold and provide the integer result.\"\"\"\n    def __init__(self, odd_count: int):\n        self._odd_count = odd_count\n\n    def as_int(self) -> int:\n        \"\"\"Returns the stored odd count as an integer.\"\"\"\n        return self._odd_count\ndef odd_Equivalent(binary_string, k):\n    \"\"\"\n    Finds the number of numbers with an odd value when rotating a binary string the given number of times.\n    \"\"\"\n    Validator.validate_binary_string(binary_string)\n    Validator.validate_k(k)\n\n    original_binary_string = BinaryString(binary_string)\n    rotation_engine = RotationEngine(original_binary_string, k)\n    \n    counter = Counter()\n    odd_count = counter.count_odd(rotation_engine)\n    \n    result = Result(odd_count)\n    return result.as_int()"}
