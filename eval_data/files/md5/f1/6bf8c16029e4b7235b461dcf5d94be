 0\nclass ResultList:\n    \"\"\"Aggregates ordered group strings and provides final output.\"\"\"\n    def __init__(self) -> None:\n        self._groups: List[str] = []\n\n    def add(self, group: str) -> None:\n        \"\"\"Adds a group string to the list.\"\"\"\n        self._groups.append(group)\n\n    def to_list(self) -> List[str]:\n        \"\"\"Returns the accumulated list of group strings.\"\"\"\n        return self._groups\nclass Parser:\n    \"\"\"Scans normalized input, identifies top-level balanced groups, and populates a ResultList.\"\"\"\n    def __init__(self) -> None:\n        self._index: int = 0\n        self._stack: List[int] = []  # Stores indices of open parentheses\n        self._current_group_start: int | None = None\n        self._result_list: ResultList = ResultList()\n\n    def separate_paren_groups(self, normalized_string: str) -> List[str]:\n        \"\"\"Processes a normalized string to extract top-level parenthesis groups.\"\"\"\n        self._index = 0\n        self._stack = []\n        self._current_group_start = None\n        self._result_list = ResultList()\n\n        for self._index, char in enumerate(normalized_string):\n            if char == '(':\n                # If the stack is empty, this marks the beginning of a new top-level group\n                if not self._stack:\n                    self._current_group_start = self._index\n                self._stack.append(self._index)\n            elif char == ')':\n                # If there's an opening parenthesis to match, pop it\n                if self._stack:\n                    self._stack.pop()\n                    # If the stack becomes empty, a top-level group has just closed\n                    if not self._stack and self._current_group_start is not None:\n                        # Extract the content of the identified top-level group\n                        content = normalized_string[self._current_group_start : self._index + 1]\n                        # Instantiate PAREN_GROUP (depth is 0 for a top-level group)\n                        paren_group = PAREN_GROUP(content, self._current_group_start, self._index, 0)\n                        self._result_list.add(paren_group.content)\n                        self._current_group_start = None\n\n        return self._result_list.to_list()\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Separates multiple groups of nested parentheses into separate strings. \"\"\"\n    input_obj = InputString(paren_string)\n    normalized_string = input_obj.normalize()\n\n    parser = Parser()\n    return parser.separate_paren_groups(normalized_string)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/8": [{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n\n    return (total_sum, total_product)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/9": [{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence. The returned list will have the same length as the input, and the input list will not be modified.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    current_max = numbers[0]\n\n    for number in numbers:\n        if number > current_max:\n         