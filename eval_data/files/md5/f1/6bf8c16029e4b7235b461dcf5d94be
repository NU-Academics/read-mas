val/30": [{"task_id": "HumanEval/30", "solution": "def filterPositive(numbers: list) -> list:\n    \"\"\"Return a new list containing elements x from numbers where x > 0, preserving order and duplicates.\"\"\"\n    return [x for x in numbers if x > 0]\ndef get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    return filterPositive(l)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/32": [{"task_id": "HumanEval/32", "solution": "import math\nclass ValidationError(ValueError):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass Evaluator:\n    \"\"\"Evaluates polynomial values.\"\"\"\n    def poly(self, xs: list, x: float) -> float:\n        \"\"\"Evaluates polynomial with coefficients xs at point x using math.pow.\"\"\"\n        return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef _is_numeric_list(xs: list) -> bool:\n    \"\"\"Checks if all elements in the list are numeric (int or float).\"\"\"\n    return all(isinstance(x, (int, float)) for x in xs)\nclass RootFinder:\n    \"\"\"Finds roots of polynomials.\"\"\"\n    def validate(self, xs: list) -> None:\n        \"\"\"Validates the input coefficients list for root finding.\"\"\"\n        if not xs:\n            raise ValidationError(\"Coefficients list cannot be empty.\")\n        if not _is_numeric_list(xs):\n            raise ValidationError(\"All coefficients must be numeric (int or float).\")\n        # len(xs) must be even, so polynomial degree (len(xs) - 1) must be odd.\n        if len(xs) % 2 != 0:\n            raise ValidationError(\"Number of coefficients must be even (polynomial degree must be odd).\")\n        # Leading coefficient (highest degree) must be non-zero to ensure the declared odd degree.\n        if xs[-1] == 0:\n            raise ValidationError(\"Leading coefficient must be non-zero to guarantee an odd degree polynomial.\")\n\n    def _bracket_and_bisect(self, xs: list, evaluator: Evaluator) -> float:\n        \"\"\"\n        Deterministically finds a root using bracket search and bisection.\n        Assumes degree is odd, guaranteeing a real root.\n        \"\"\"\n        # Numerical tolerances for root finding\n        value_tolerance = 1e-9\n        interval_tolerance = 1e-12\n\n        # Initial check at 0.0 for efficiency\n        val_at_0 = evaluator.poly(xs, 0.0)\n        if abs(val_at_0) < value_tolerance:\n            return 0.0\n\n        # Bracket search strategy: symmetric intervals expanding outwards from 0\n        # Uses sample points \u00b11, \u00b12, \u00b14, etc., to find an initial interval [low, high]\n        low, high = -1.0, 1.0\n        val_low = evaluator.poly(xs, low)\n        val_high = evaluator.poly(xs, high)\n\n        max_bracket_iterations = 100 # Safety limit for bracket expansion\n        found_bracket = False\n\n        # Check if the initial interval [-1, 1] contains a sign change\n        if (val_low < 0 and val_high > 0) or (val_low > 0 and val_high < 0):\n            found_bracket = True\n        else:\n            # Expand search range by doubling the bounds\n            current_bound = 1.0\n            for _ in range(max_bracket_iterations):\n                current_bound *= 2.0\n                val_neg_bound = evaluator.poly(xs, -current_bound)\n                val_pos_bound = evaluator.poly(xs, current_bound)\n\n                if (val_neg_bound < 0 and val_pos_bound > 0) or (val_neg_bound > 0 and val_pos_bound < 0):\n                    low, high = -current_bound, current_bound\n                    found_bracket = True\n                    break\n        \n        if not found_bracket:\n            # If a bracket is not found after e