ger >= 1\")\nclass PileGenerator:\n    \"\"\"\n    Generates the list of stone counts for each level of the pile.\n    \"\"\"\n    def generate(self, n: int) -> List[int]:\n        \"\"\"\n        Returns a list where the i-th element is n + 2*i.\n        \"\"\"\n        return [n + 2 * i for i in range(n)]\ndef make_a_pile(n):\n    \"\"\"\n    Given a positive integer n, you have to make a pile of n levels of stones.\n    The first level has n stones.\n    The number of stones in the next level is:\n        - the next odd number if n is odd.\n        - the next even number if n is even.\n    Return the number of stones in each level in a list, where element at index\n    i represents the number of stones in the level (i+1).\n\n    Examples:\n    >>> make_a_pile(3)\n    [3, 5, 7]\n    \"\"\"\n    validator = InputValidator()\n    validator.validate(n)\n    generator = PileGenerator()\n    return generator.generate(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/105": [{"task_id": "HumanEval/105", "solution": "_MAPPING_TABLE = {\n    1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n    6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n}\ndef filter_valid_digits(arr):\n    \"\"\"Filters the input array, keeping only integers between 1 and 9 inclusive.\"\"\"\n    return [x for x in arr if 1 <= x <= 9]\ndef sort_ascending(values):\n    \"\"\"Sorts a list of integers in ascending order (stable sort).\"\"\"\n    return sorted(values)\ndef reverse_list(values):\n    \"\"\"Reverses the order of elements in a list.\"\"\"\n    return values[::-1]\ndef map_to_names(values):\n    \"\"\"Maps integers to their corresponding English names using a predefined table.\"\"\"\n    return [_MAPPING_TABLE[x] for x in values]\ndef by_length(arr):\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name from\n    \"One\", \"Two\", \"Three\", \"Four\", \"Five\", \"Six\", \"Seven\", \"Eight\", \"Nine\".\n\n    For example:\n      arr = [2, 1, 1, 4, 5, 8, 2, 3]   \n            -> sort arr -> [1, 1, 2, 2, 3, 4, 5, 8] \n            -> reverse arr -> [8, 5, 4, 3, 2, 2, 1, 1]\n      return [\"Eight\", \"Five\", \"Four\", \"Three\", \"Two\", \"Two\", \"One\", \"One\"]\n    \n      If the array is empty, return an empty array:\n      arr = []\n      return []\n    \n      If the array has any strange number ignore it:\n      arr = [1, -1 , 55] \n            -> sort arr -> [-1, 1, 55]\n            -> reverse arr -> [55, 1, -1]\n      return = ['One']\n    \"\"\"\n    filtered = filter_valid_digits(arr)\n    sorted_arr = sort_ascending(filtered)\n    reversed_arr = reverse_list(sorted_arr)\n    result_names = map_to_names(reversed_arr)\n    return result_names", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/106": [{"task_id": "HumanEval/106", "solution": "import abc\nclass Computation(abc.ABC):\n    \"\"\"Abstract base class for computation strategies.\"\"\"\n    @abc.abstractmethod\n    def compute_for(self, i: int) -> int:\n        \"\"\"Abstract method to compute a value for operand i.\"\"\"\n        pass\nclass Factorial(Computation):\n    \"\"\"Computes factorial(i) iteratively.\"\"\"\n    def compute_for(self, i: int) -> int:\n        result = 1\n        for x in range(1, i + 1):\n            result *= x\n        return result\nclass Sum(Computation):\n    \"\"\"Computes sum(1..i) using the arithmetic formula.\"\"\"\n    def compute_for(self, i: int) -> int:\n        return i * (i + 1) // 2\nclass ListElement:\n    \"\"\"Holds a zero-based index and its computed value.\"\"\"\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\nclass OutputList:\n    \"\"\"Container for ListElement items and conversion to a plain list.\"\"\"\n    def __init__(self, expected_length: int):\n        self.elements = []\n        self.length = expected_length\n\n    def append(self, element: ListElement) -> None:\n        \"\"\"Appends a ListElement to the internal list.\"\"\"\n        self.elements.append(element)\n\n    def to_list(self) -> list:\n        \"\"\"Converts the stored ListElements to a plain list of values.\"\"\"\n        return [element.value for element in self.elements]\nclass Function:\n    \"\"\"Orchestrates the computation loop, selects strategies, and builds the output list.\"\"\"\n    def compute(self, n: int) -> list:\n        output_list = OutputList(n)\n        for i in range(1, n + 1):\n            if i % 2 == 0:  # i is even\n                computation_strategy = Factorial()\n            else:  # i is odd\n                computation_strategy = Sum()\n            \n            computed_value = computation_strategy.compute_for(i)\n            list_element = ListElement(index=i - 1, value=computed_value)\n            output_list.append(list_element)\n            \n        return output_list.to_list()\ndef f(n):\n    \"\"\" Implement the function f that takes n as a parameter,\n    and returns a list of size n, such that the value of the element at index i is the factorial of i if i is even\n    or the sum of numbers from 1 to i otherwise.\n    i starts from 1.\n    the factorial of i is the multiplication of the numbers from 1 to i (1 * 2 * ... * i).\n    Example:\n    f(5) == [1, 2, 6, 24, 15]\n    \"\"\"\n    return Function().compute(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/107": [{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n\n    class InputValidator:\n        # Enforces validation rules for input n.\n        def validate(self, n_param):\n            if not isinstance(n_param, int) or not (1 <= n_param <= 1000):\n                raise ValueError(\"Input n must be an integer between 1 and 1000 inclusive.\")\n\n    class IntegerRangeEnumerator:\n        # Generates integers from 1 up to n_param.\n        def enumerate(self, n_param):\n            for i in range(1, n_param + 1):\n                yield i\n\n    class PalindromeChecker:\n        # Determines if an integer is a decimal palindrome.\n        def is_palindrome(self, x):\n            return str(x) == str(x)[::-1]\n\n    class ParityClassifier:\n        # Classifies an integer as even or odd.\n        def is_even(self, x):\n            return x % 2 == 0\n        def is_odd(self, x):\n            return x % 2 != 0\n\n    class Result:\n        # Immutable-like container for even and odd counts.\n        def __init__(self, even_count: int, odd_count: int):\n            self.even_count = even_count\n            self.odd_count = odd_count\n        def to_tuple(self) -> tuple[int, int]:\n            return (self.even_count, self.odd_count)\n\n    class Counter:\n        # Accumulates counts of even and odd palindromes.\n        def __init__(self):\n            self._even_count = 0\n            self._odd_count = 0\n        def increment_even(self):\n            self._even_count += 1\n        def increment_odd(self):\n            self._odd_count += 1\n        def to_result(self) -> Result:\n            return Result(self._even_count, self._odd_count)\n\n    # Orchestration logic for the even_odd_palindrome function.\n    validator = InputValidator()\n    validator.validate(n)\n\n    enumerator = IntegerRangeEnumerator()\n    checker = PalindromeChecker()\n    parity = ParityClassifier()\n    counter = Counter()\n\n    for i in enumerator.enumerate(n):\n        if checker.is_palindrome(i):\n            if parity.is_even(i):\n                counter.increment_even()\n            else:\n                counter.increment_odd()\n\n    result_obj = counter.to_result()\n    return result_obj.to_tuple()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/108": [{"task_id": "HumanEval/108", "solution": "class IntegerElement:\n    def __init__(self, value: int) -> None:\n        self.value = value\n        self._signed_digits = None\n\n    def computeSignedDigits(self) -> None:\n        \"\"\"Computes signed digits, where for negative numbers, only the most-significant digit is negative.\"\"\"\n        if self._signed_digits is not None:\n            return\n\n        digits = []\n        if self.value == 0:\n            digits.append(0)\n        elif self.value > 0:\n            temp_val = self.value\n            while temp_val > 0:\n                digits.append(temp_val % 10)\n                temp_val //= 10\n            digits.reverse()\n        else:  # self.value < 0\n            str_val = str(self.value)\n            digits.append(int(str_val[1]) * -1)\n            for char_digit in str_val[2:]:\n                digits.append(int(char_digit))\n        self._signed_digits = digits\n\n    def signedDigitSum(self) -> int:\n        \"\"\"Returns the sum of the computed signed digits.\"\"\"\n        if self._signed_digits is None:\n            self.computeSignedDigits()\n        return sum(self._signed_digits)\nclass InputArray:\n    def __init__(self, arr) -> None:\n        \"\"\"Wraps each integer from the input array into an IntegerElement instance.\"\"\"\n        self.elements = [IntegerElement(val) for val in arr]\nclass CountNums:\n    def count(self, nums: InputArray) -> int:\n        \"\"\"Iterates through elements and counts those with a signed-digit sum greater than 0.\"\"\"\n        positive_sum_count = 0\n        for element in nums.elements:\n            if element.signedDigitSum() > 0:\n                positive_sum_count += 1\n        return positive_sum_count\ndef count_nums(arr):\n    \"\"\"\n    Write a function count_nums which takes an array of integers and returns\n    the number of elements which has a sum of digits > 0.\n    If a number is negative, then its first signed digit will be negative:\n    e.g. -123 has signed digits -1, 2, and 3.\n    >>> count_nums([]) == 0\n    >>> count_nums([-1, 11, -11]) == 1\n    >>> count_nums([1, 1, 2]) == 3\n    \"\"\"\n    input_array = InputArray(arr)\n    counter_service = CountNums()\n    return counter_service.count(input_array)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/110": [{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if lst1 can be made all-even by exchanging elements with lst2.\"\"\"\n    even_count_lst1 = sum(1 for x in lst1 if x % 2 == 0)\n    even_count_lst2 = sum(1 for x in lst2 if x % 2 == 0)\n\n    total_even_available = even_count_lst1 + even_count_lst2\n\n    if total_even_available >= len(lst1):\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/109": [{"task_id": "HumanEval/109", "solution": "class Array:\n    \"\"\"Represents an ordered collection of integers.\"\"\"\n    def __init__(self, elements: list[int]) -> None:\n        self.elements = elements\n        self.length = len(elements)\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the array is empty.\"\"\"\n        return self.length == 0\n\n    def get(self, index: int) -> int:\n        \"\"\"Returns the element at the given index.\"\"\"\n        return self.elements[index]\nclass RightShiftOperation:\n    \"\"\"Stateless utility to apply right shift operations.\"\"\"\n    @staticmethod\n    def apply_once(arr: Array) -> Array:\n        \"\"\"Performs one right shift on the array, returning a new Array instance.\"\"\"\n        if arr.is_empty():\n            return Array([])\n        \n        rotated_elements = [arr.get(arr.length - 1)] + arr.elements[:-1]\n        return Array(rotated_elements)\n\n    @staticmethod\n    def apply_k(arr: Array, k: int) -> Array:\n        \"\"\"Performs k right shifts on the array, returning a new Array instance.\"\"\"\n        if arr.is_empty():\n            return Array([])\n        \n        num_shifts = k % arr.length\n        if num_shifts == 0:\n            return Array(list(arr.elements))\n\n        rotated_elements = arr.elements[-num_shifts:] + arr.elements[:-num_shifts]\n        return Array(rotated_elements)\nclass SortabilityChecker:\n    \"\"\"Core analysis to determine if an array can be sorted by right shifts.\"\"\"\n    @staticmethod\n    def can_be_sorted_by_right_shifts(arr: Array) -> bool:\n        \"\"\"Checks if the array can be sorted by any number of right shifts.\"\"\"\n        if arr.is_empty() or arr.length == 1:\n            return True\n\n        for k in range(arr.length):\n            rotated_arr = RightShiftOperation.apply_k(arr, k)\n            if SortabilityChecker._is_non_decreasing(rotated_arr):\n                return True\n        return False\n\n    @staticmethod\n    def _find_rotation_index(arr: Array) -> int:\n        \"\"\"Finds the index of the first descent (where arr[i] > arr[i+1]).\"\"\"\n        if arr.is_empty() or arr.length == 1:\n            return -1\n\n        for i in range(arr.length - 1):\n            if arr.get(i) > arr.get(i + 1):\n                return i\n        return -1\n\n    @staticmethod\n    def _is_non_decreasing(arr: Array) -> bool:\n        \"\"\"Checks if the array is sorted in non-decreasing order.\"\"\"\n        if arr.is_empty() or arr.length == 1:\n            return True\n\n        for i in range(arr.length - 1):\n            if arr.get(i) > arr.get(i + 1):\n                return False\n        return True\ndef move_one_ball(arr):\n    \"\"\"We have an array 'arr' of N integers arr[1], arr[2], ..., arr[N].The\n    numbers in the array will be randomly ordered. Your task is to determine if\n    it is possible to get an array sorted in non-decreasing order by performing \n    the following operation on the given array:\n        You are allowed to perform right shift operation any number of times.\n    \n    One right shift operation means shifting all elements of the array by one\n    position in the right direction. The last element of the array will be moved to\n    the starting position in the array i.e. 0th index. \n\n    If it is possible to obtain the sorted array by performing the above operation\n    then return True else return False.\n    If the given array is empty then return True.\n\n    Note: The given list is guaranteed to have unique elements.\n\n    For Example:\n    \n    move_one_ball([3, 4, 5, 1, 2])==>True\n    Explanation: By performin 2 right shift operations, non-decreasing order can\n                 be achieved for the given array.\n    move_one_ball([3, 5, 4, 1, 2])==>False\n    Explanation:It is not possible to get non-decreasing order for the given\n                array by performing any number of right shift operations.\n                \n    \"\"\"\n    if not arr:\n        return True\n    \n    array_obj = Array(arr)\n    return SortabilityChecker.can_be_sorted_by_right_shifts(array_obj)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/112": [{"task_id": "HumanEval/112", "solution": "def reverse_delete(s, c):\n    \"\"\"Deletes characters from s that are in c, then checks if the resulting string is a palindrome.\"\"\"\n    \n    # Simulate CharacterSet.fromString: Create a set of characters to delete for efficient lookup.\n    chars_to_delete = set(c)\n\n    # Simulate ReverseDeleteOperation.filter: Build the filtered string.\n    filtered_chars = []\n    for char_s in s:\n        if char_s not in chars_to_delete:\n            filtered_chars.append(char_s)\n    result_string = \"\".join(filtered_chars)\n\n    # Simulate PalindromeChecker.isPalindrome: Check if the result string is a palindrome.\n    is_palindrome = (result_string == result_string[::-1])\n\n    # Simulate Result.as_tuple: Return the tuple.\n    return (result_string, is_palindrome)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/36": [{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    class NumberSelector:\n        def __init__(self):\n            self.divisor_a = 11\n            self.divisor_b = 13\n\n        def is_divisible(self, i: int) -> bool:\n            return (i % self.divisor_a == 0) or (i % self.divisor_b == 0)\n\n        def select(self, n: int) -> list[int]:\n            selected_numbers = []\n            for i in range(n):\n                if self.is_divisible(i):\n                    selected_numbers.append(i)\n            return selected_numbers\n\n    class DigitCounter:\n        def count_digit_occurrences(self, numbers: list[int], digit: str) -> list[int]:\n            per_integer_counts = []\n            for num in numbers:\n                num_str = str(abs(num))\n                count = num_str.count(digit)\n                per_integer_counts.append(count)\n            return per_integer_counts\n\n    class Aggregator:\n        def aggregate_counts(self, counts: list[int]) -> int:\n            return sum(counts)\n\n    class FizzBuzzService:\n        def __init__(self, selector: NumberSelector, counter: DigitCounter, aggregator: Aggregator) -> None:\n            self.selector = selector\n            self.counter = counter\n            self.aggregator = aggregator\n\n        def fizz_buzz(self, n: int) -> int:\n            selected_numbers = self.selector.select(n)\n            per_integer_counts = self.counter.count_digit_occurrences(selected_numbers, '7')\n            total = self.aggregator.aggregate_counts(per_integer_counts)\n            return total\n\n    selector = NumberSelector()\n    counter = DigitCounter()\n    aggregator = Aggregator()\n    service = FizzBuzzService(selector, counter, aggregator)\n    return service.fizz_buzz(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/111": [{"task_id": "HumanEval/111", "solution": "def histogram(test):\n    \"\"\"Given a string representing a space separated lowercase letters, return a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\n    \"\"\"\n\n    class InputString:\n        def __init__(self, raw: str):\n            self.raw: str = raw\n\n        def is_empty(self) -> bool:\n            return not self.raw.strip()\n\n    class Token:\n        def __init__(self, value: str):\n            self.value: str = value\n\n    class LetterCount:\n        def __init__(self, letter: str, count: int):\n            self.letter: str = letter\n            self.count: int = count\n\n    class HistogramResult:\n        def __init__(self, top_counts: dict):\n            self.top_counts: dict[str, int] = top_counts\n\n    class Parser:\n        def parse(self, raw: str) -> list[Token]:\n            # Splits the raw string by space and creates Token objects for non-empty tokens.\n            return [Token(value=tok) for tok in raw.split(' ') if tok]\n\n    class Counter:\n        def count(self, tokens: list[Token]) -> list[LetterCount]:\n            # Aggregates token values into counts and returns a list of LetterCount objects.\n            counts_map = {}\n            for token in tokens:\n                counts_map[token.value] = counts_map.get(token.value, 0) + 1\n            return [LetterCount(letter, count) for letter, count in counts_map.items()]\n\n        def select_max(self, counts: list[LetterCount]) -> HistogramResult:\n            # Identifies the maximum count and includes all letters with that count in a HistogramResult.\n            if not counts:\n                return HistogramResult({})\n\n            max_count = 0\n            for lc in counts:\n                if lc.count > max_count:\n                    max_count = lc.count\n            \n            top_counts_dict = {}\n            for lc in counts:\n                if lc.count == max_count:\n                    top_counts_dict[lc.letter] = lc.count\n            \n            return HistogramResult(top_counts_dict)\n\n    inp = InputString(raw=test)\n    if inp.is_empty():\n        return {}\n    \n    parser = Parser()\n    tokens = parser.parse(inp.raw)\n    \n    counter = Counter()\n    counts = counter.count(tokens)\n    result = counter.select_max(counts)\n    \n    return result.top_counts", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/114": [{"task_id": "HumanEval/114", "solution": "from typing import Optional\nclass InputArray:\n    \"\"\"\n    Validates and encapsulates the input iterable of integers.\n    \"\"\"\n    def __init__(self, values: list[int]):\n        self.values = values\n\n    @staticmethod\n    def from_iterable(iterable):\n        \"\"\"\n        Validates iterable, element types (ints), and non-empty.\n        \"\"\"\n        if not hasattr(iterable, '__iter__'):\n            raise TypeError(\"Input must be an iterable.\")\n        if not iterable:\n            raise ValueError(\"Input iterable cannot be empty.\")\n        \n        values = []\n        for item in iterable:\n            if not isinstance(item, int):\n                raise TypeError(\"All elements in the input iterable must be integers.\")\n            values.append(item)\n        \n        return InputArray(values)\n\n    def length(self) -> int:\n        \"\"\"Returns number of elements.\"\"\"\n        return len(self.values)\nclass MinSubArrayCalculator:\n    \"\"\"\n    Computes the minimum sum of any non-empty contiguous sub-array.\n    \"\"\"\n    def minSubArraySum(self, nums_obj: InputArray) -> int:\n        \"\"\"\n        Computes the minimum contiguous sub-array sum using a Kadane's algorithm variant.\n        \"\"\"\n        nums = nums_obj.values\n        # InputArray.from_iterable ensures nums is not empty.\n        \n        min_so_far = nums[0]\n        current_min = nums[0]\n\n        for i in range(1, len(nums)):\n            num = nums[i]\n            current_min = min(num, current_min + num)\n            min_so_far = min(min_so_far, current_min)\n        \n        return min_so_far\ndef minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums.\n    Example\n    minSubArraySum([2, 3, 4, 1, 2, 4]) == 1\n    minSubArraySum([-1, -2, -3]) == -6\n    \"\"\"\n    input_obj = InputArray.from_iterable(nums)\n    calculator = MinSubArrayCalculator()\n    min_sum = calculator.minSubArraySum(input_obj)\n    return min_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/113": [{"task_id": "HumanEval/113", "solution": "from typing import List\nclass Digit:\n    \"\"\"Represents a single character and determines its oddness.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def isOdd(self) -> bool:\n        \"\"\"Checks if the digit is odd.\"\"\"\n        return self.value in {'1', '3', '5', '7', '9'}\nclass DigitString:\n    \"\"\"Represents a single input string and counts its odd digits.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n        self.length = len(value)\n\n    def countOdd(self) -> int:\n        \"\"\"Counts the number of odd digits in the string.\"\"\"\n        odd_count = 0\n        for char in self.value:\n            digit = Digit(char)\n            if digit.isOdd():\n                odd_count += 1\n        return odd_count\nclass OddDigitCounter:\n    \"\"\"Provides a counting service for DigitString objects.\"\"\"\n    def countOdd(self, ds: DigitString) -> int:\n        \"\"\"Delegates odd digit counting to DigitString.\"\"\"\n        return ds.countOdd()\nclass InputList:\n    \"\"\"Represents the input list of digit-strings.\"\"\"\n    def __init__(self, items: List[str]) -> None:\n        self.items = items\n\n    def validate_all_digits(self) -> bool:\n        \"\"\"Validates if all characters in all strings are digits.\"\"\"\n        for item in self.items:\n            if not item.isdigit():\n                return False\n        return True\nclass OutputString:\n    \"\"\"Constructs the output string using a template and replacement.\"\"\"\n    _TEMPLATE = \"the number of odd elements in the string i of the input.\"\n\n    def construct(self, count: int) -> str:\n        \"\"\"Replaces 'i' in the template with the given count.\"\"\"\n        return self._TEMPLATE.replace('i', str(count))\nclass OutputList:\n    \"\"\"Aggregates constructed output strings.\"\"\"\n    def __init__(self) -> None:\n        self.items: List[str] = []\n\n    def append(self, s: str) -> None:\n        \"\"\"Adds a constructed string to the list.\"\"\"\n        self.items.append(s)\n\n    def to_list(self) -> List[str]:\n        \"\"\"Returns the aggregated list of strings.\"\"\"\n        return self.items\ndef odd_count(lst: List[str]) -> List[str]:\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n    \"\"\"\n    input_wrapper = InputList(lst)\n    output_list = OutputList()\n    odd_digit_counter = OddDigitCounter()\n    output_string_constructor = OutputString()\n\n    for value in input_wrapper.items:\n        ds = DigitString(value)\n        count = odd_digit_counter.countOdd(ds)\n        out = output_string_constructor.construct(count)\n        output_list.append(out)\n\n    return output_list.to_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/115": [{"task_id": "HumanEval/115", "solution": "def max_fill(grid, capacity):\n    \"\"\"\n    Calculates the total number of times buckets need to be lowered to empty all wells.\n    It counts water units per well and applies the bucket capacity using ceiling division.\n    \"\"\"\n    total_lowers = 0\n    for row in grid:\n        units_in_row = sum(row)\n        if units_in_row > 0:\n            # Calculate ceiling division using integer arithmetic: (units + capacity - 1) // capacity\n            lowers_for_row = (units_in_row + capacity - 1) // capacity\n            total_lowers += lowers_for_row\n    return total_lowers", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/117": [{"task_id": "HumanEval/117", "solution": "from typing import List, Set, Optional\nclass InputString:\n    \"\"\"Represents the raw input string and produces Word tokens.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw = raw\n\n    def split_on_spaces(self) -> List['Word']:\n        \"\"\"Splits the raw string into Word objects, filtering out empty tokens.\"\"\"\n        tokens = []\n        for word_text in self.raw.split(' '):\n            if word_text:\n                tokens.append(Word(word_text))\n        return tokens\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the raw input string is empty.\"\"\"\n        return self.raw == \"\"\nclass Word:\n    \"\"\"Represents a single token with its original text.\"\"\"\n    def __init__(self, text: str) -> None:\n        self.text = text\n        self.consonant_count: Optional[int] = None\n\n    def get_text(self) -> str:\n        \"\"\"Returns the original text of the word.\"\"\"\n        return self.text\n\n    def compute_consonant_count(self, counter: 'ConsonantCounter') -> int:\n        \"\"\"Computes and stores the consonant count for the word using a ConsonantCounter.\"\"\"\n        if self.consonant_count is None:\n            self.consonant_count = counter.count(self)\n        return self.consonant_count\nclass ResultList:\n    \"\"\"Collects matched Word objects and produces the final list of strings.\"\"\"\n    def __init__(self) -> None:\n        self.words: List[Word] = []\n\n    def add(self, word: 'Word') -> None:\n        \"\"\"Adds a Word object to the list of results.\"\"\"\n        self.words.append(word)\n\n    def to_string_list(self) -> List[str]:\n        \"\"\"Converts the collected Word objects into a list of their original texts.\"\"\"\n        return [w.get_text() for w in self.words]\nclass ConsonantCounter:\n    \"\"\"Encapsulates vowel set and logic to classify letters as consonants.\"\"\"\n    def __init__(self, vowels: Optional[Set[str]] = None) -> None:\n        self.vowels = vowels if vowels is not None else {'a', 'e', 'i', 'o', 'u'}\n\n    def set_vowels(self, vowels: Set[str]) -> None:\n        \"\"\"Sets the vowel set to be used for consonant classification.\"\"\"\n        self.vowels = vowels\n\n    def is_consonant(self, ch: str) -> bool:\n        \"\"\"Determines if a character is a consonant (case-insensitively).\"\"\"\n        lower_ch = ch.lower()\n        return lower_ch.isalpha() and lower_ch not in self.vowels\n\n    def count(self, word: 'Word') -> int:\n        \"\"\"Counts the number of consonants in a given Word object.\"\"\"\n        consonant_count = 0\n        for char in word.text:\n            if self.is_consonant(char):\n                consonant_count += 1\n        return consonant_count\ndef select_words(s: str, n: int) -> List[str]:\n    \"\"\"Given a string s and a natural number n, returns a list of all words\n    from string s that contain exactly n consonants, in order these words appear in the string s.\n    \"\"\"\n    input_string = InputString(s)\n    if input_string.is_empty():\n        return []\n\n    tokens = input_string.split_on_spaces()\n    counter = ConsonantCounter()\n    collector = ResultList()\n\n    for token in tokens:\n        count = token.compute_consonant_count(counter)\n        if count == n:\n            collector.add(token)\n\n    return collector.to_string_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/118": [{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel between two consonants from the right side of the word.\n    Returns the vowel preserving its case, or an empty string if none is found.\n    \"\"\"\n\n    class VowelSet:\n        \"\"\"Manages the set of vowels for classification.\"\"\"\n        _instance = None\n        def __new__(cls):\n            if cls._instance is None:\n                cls._instance = super(VowelSet, cls).__new__(cls)\n                cls._instance.vowels = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n            return cls._instance\n\n        def contains(self, ch: str) -> bool:\n            return ch in self.vowels\n\n    class Character:\n        \"\"\"Represents a character with classification helpers.\"\"\"\n        def __init__(self, value: str, index: int):\n            self.value = value\n            self.index = index\n            self._vowel_set = VowelSet()\n\n        def isVowel(self) -> bool:\n            return self._vowel_set.contains(self.value)\n\n        def isConsonant(self) -> bool:\n            return self.value.isalpha() and not self.isVowel()\n\n    class Word:\n        \"\"\"Domain representation of the input word.\"\"\"\n        def __init__(self, value: str):\n            self.value = value\n\n        def length(self) -> int:\n            return len(self.value)\n\n        def get_char_at(self, index: int) -> 'Character':\n            return Character(self.value[index], index)\n\n    class ClosestVowelFinder:\n        \"\"\"Implements the right-to-left scan and candidate selection logic.\"\"\"\n        def __init__(self):\n            pass\n\n        def _is_valid_candidate(self, index: int, word_obj: 'Word') -> bool:\n            \"\"\"Checks if the character at index is a vowel with consonant neighbors.\"\"\"\n            current_char = word_obj.get_char_at(index)\n            if not current_char.isVowel():\n                return False\n\n            left_char = word_obj.get_char_at(index - 1)\n            right_char = word_obj.get_char_at(index + 1)\n\n            return left_char.isConsonant() and right_char.isConsonant()\n\n        def find(self, word_obj: 'Word') -> str:\n            \"\"\"Scans the word from right-to-left for a qualifying vowel.\"\"\"\n            word_length = word_obj.length()\n            if word_length < 3: # Words shorter than 3 cannot have a qualifying vowel.\n                return \"\"\n\n            # Iterate from the second to last character (index len-2) down to the second character (index 1).\n            for i in range(word_length - 2, 0, -1):\n                if self._is_valid_candidate(i, word_obj):\n                    return word_obj.value[i]\n\n            return \"\"\n\n    # Input validation as per design: empty string or non-alphabetic input.\n    if not word or not word.isalpha():\n        return \"\"\n\n    word_obj = Word(word)\n    finder = ClosestVowelFinder()\n    return finder.find(word_obj)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/116": [{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n\n    It must be implemented like this:\n    >>> sort_array([1, 5, 2, 3, 4]) == [1, 2, 3, 4, 5]\n    >>> sort_array([-2, -3, -4, -5, -6]) == [-6, -5, -4, -3, -2]\n    >>> sort_array([1, 0, 2, 3, 4]) [0, 1, 2, 3, 4]\n    \"\"\"\n\n    # Helper function to compute the number of '1' bits for non-negative integers.\n    def compute_ones_count(value: int) -> int:\n        return bin(value).count('1')\n\n    # Value object to hold the integer and its computed ones_count.\n    class IntegerElement:\n        def __init__(self, value: int):\n            self.value = value\n            self.ones_count = None\n\n        def is_negative(self) -> bool:\n            return self.value < 0\n\n        def as_int(self) -> int:\n            return self.value\n\n    # Create a copy of the input list to ensure the original array is not mutated.\n    input_copy = list(arr)\n\n    # Convert all integers into IntegerElement instances for processing.\n    elements = [IntegerElement(val) for val in input_copy]\n\n    # Partition elements into non-negative and negative groups.\n    non_negatives_elements = []\n    negatives_elements = []\n    for el in elements:\n        if el.is_negative():\n            negatives_elements.append(el)\n        else:\n            non_negatives_elements.append(el)\n\n    # Compute ones_count for all non-negative elements as required by the design.\n    for el in non_negatives_elements:\n        el.ones_count = compute_ones_count(el.value)\n\n    # Sort non-negative elements primarily by ones_count, then by decimal value.\n    non_negatives_elements.sort(key=lambda el: (el.ones_count, el.value))\n\n    # Sort negative elements by their numeric value in ascending order.\n    negatives_elements.sort(key=lambda el: el.value)\n\n    # Merge the two sorted lists. The design implies merging sorted partitions,\n    # with negatives preceding non-negatives to maintain overall numerical order.\n    # Convert IntegerElement instances back to plain integers for the final output.\n    sorted_result = []\n    for el in negatives_elements:\n        sorted_result.append(el.as_int())\n    for el in non_negatives_elements:\n        sorted_result.append(el.as_int())\n\n    return sorted_result", "base_status": "fail", "plus_status": "pass", "base_fail_tests": [[[-2, -3, -4, -5, -6]]], "plus_fail_tests": []}], "HumanEval/121": [{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    \"\"\"\n    from typing import List\n\n    class InputList:\n        \"\"\"Represents the input list and provides validation methods.\"\"\"\n        def __init__(self, elements: List[int]):\n            self.elements = elements\n\n        def validateNonEmpty(self) -> None:\n            \"\"\"Validates that the list is not empty.\"\"\"\n            if not self.elements:\n                raise ValueError(\"Input list cannot be empty.\")\n\n        def validateAllIntegers(self) -> None:\n            \"\"\"Validates that all elements in the list are integers.\"\"\"\n            for element in self.elements:\n                if not isinstance(element, int):\n                    raise ValueError(\"All elements in the list must be integers.\")\n\n    class IntegerElement:\n        \"\"\"Represents an integer element with its value and index.\"\"\"\n        def __init__(self, index: int, value: int):\n            self.index = index\n            self.value = value\n\n        def isOdd(self) -> bool:\n            \"\"\"Checks if the element's value is odd.\"\"\"\n            return self.value % 2 != 0\n\n    class Result:\n        \"\"\"Holds the computed sum.\"\"\"\n        def __init__(self, value: int):\n            self.value = value\n\n    class SumCalculator:\n        \"\"\"Calculates the sum of odd elements at even positions.\"\"\"\n        def computeSum(self, input_list: InputList) -> Result:\n            \"\"\"Iterates through the input list to compute the required sum.\"\"\"\n            current_sum = 0\n            for index, value in enumerate(input_list.elements):\n                if index % 2 == 0:  # Check for even position\n                    element = IntegerElement(index, value)\n                    if element.isOdd():\n                        current_sum += value\n            return Result(current_sum)\n\n    input_list = InputList(lst)\n    input_list.validateNonEmpty()\n    input_list.validateAllIntegers()\n    \n    calculator = SumCalculator()\n    result = calculator.computeSum(input_list)\n    \n    return result.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/119": [{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    You are given a list of two strings, both strings consist of open\n    parentheses '(' or close parentheses ')' only.\n    Your job is to check if it is possible to concatenate the two strings in\n    some order, that the resulting string will be good.\n    A string S is considered to be good if and only if all parentheses in S\n    are balanced. For example: the string '(())()' is good, while the string\n    '())' is not.\n    Return 'Yes' if there's a way to make a good string, and return 'No' otherwise.\n\n    Examples:\n    match_parens(['()(', ')']) == 'Yes'\n    match_parens([')', ')']) == 'No'\n    \"\"\"\n\n    class ValidationError(ValueError):\n        \"\"\"Exception raised for invalid input according to specified rules.\"\"\"\n        pass\n\n    class ParenthesisString:\n        \"\"\"Encapsulates a parenthesis-only string and validates its characters.\"\"\"\n        def __init__(self, content):\n            self.content = content\n\n        def isValidChars(self):\n            return all(c in '()' for c in self.content)\n\n    class InputList:\n        \"\"\"Represents and validates the structure of the input list.\"\"\"\n        def __init__(self, items_raw):\n            self.items = [ParenthesisString(s) for s in items_raw]\n\n        def validate(self):\n            if len(self.items) != 2:\n                raise ValidationError(\"Input list must contain exactly two strings.\")\n            for p_string in self.items:\n                if not p_string.isValidChars():\n                    raise ValidationError(\"Strings must contain only '(' and ')' characters.\")\n            return True\n\n    def validate_input_list(raw_lst):\n        \"\"\"Validates the raw input list's type and contents, raising ValidationError on failure.\"\"\"\n        if not isinstance(raw_lst, list):\n            raise ValidationError(\"Input must be a list.\")\n        if not all(isinstance(s, str) for s in raw_lst):\n            raise ValidationError(\"All items in the input list must be strings.\")\n\n        input_list_obj = InputList(raw_lst)\n        input_list_obj.validate()\n        return input_list_obj\n\n    class BalanceChecker:\n        \"\"\"Evaluates if a string is 'good' (balanced) by tracking running balance.\"\"\"\n        def check(self, s: str) -> bool:\n            running_balance = 0\n            for char in s:\n                if char == '(':\n                    running_balance += 1\n                elif char == ')':\n                    running_balance -= 1\n                if running_balance < 0:\n                    return False\n            return running_balance == 0\n\n    class Concatenation:\n        \"\"\"Represents a combined string and provides a method to check if it is 'good'.\"\"\"\n        def __init__(self, combined_str):\n            self.combined = combined_str\n\n        @classmethod\n        def concat(cls, a: ParenthesisString, b: ParenthesisString) -> 'Concatenation':\n            return cls(a.content + b.content)\n\n        def isGood(self) -> bool:\n            return BalanceChecker().check(self.combined)\n\n    # Orchestration logic as per the design\n    input_list_obj = validate_input_list(lst)\n\n    p_string1 = input_list_obj.items[0]\n    p_string2 = input_list_obj.items[1]\n\n    # Check first concatenation order: string1 + string2\n    concat1 = Concatenation.concat(p_string1, p_string2)\n    if concat1.isGood():\n        return 'Yes'\n\n    # Check second concatenation order: string2 + string1\n    concat2 = Concatenation.concat(p_string2, p_string1)\n    if concat2.isGood():\n        return 'Yes'\n\n    return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/120": [{"task_id": "HumanEval/120", "solution": "class Sorter:\n    @staticmethod\n    def sortAscending(values: list[int]) -> list[int]:\n        \"\"\"Sorts a list of integers in non-decreasing order.\"\"\"\n        return sorted(values)\nclass Selector:\n    @staticmethod\n    def selectTopK(arr: list[int], k: int) -> list[int]:\n        \"\"\"\n        Selects the k largest elements from arr, preserving duplicates,\n        using original index for deterministic tie-breaking.\n        \"\"\"\n        if k == 0:\n            return []\n        \n        # Pair each element with its original index\n        candidates = [(value, index) for index, value in enumerate(arr)]\n        \n        # Sort by value in descending order, then by original index in ascending order\n        candidates.sort(key=lambda x: (-x[0], x[1]))\n        \n        # Take the first k candidates and return only their values\n        chosen = candidates[:k]\n        return [value for (value, _) in chosen]\nclass Result:\n    def __init__(self, values: list[int], k: int):\n        \"\"\"Initializes the Result container with the selected values.\"\"\"\n        self._values = values\n        # The design mentioned storing k, but it's not used in as_list()\n        # self._k = k \n\n    def as_list(self) -> list[int]:\n        \"\"\"Returns the stored values as a list.\"\"\"\n        return self._values\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n\n    Example 1:\n\n        Input: arr = [-3, -4, 5], k = 3\n        Output: [-4, -3, 5]\n\n    Example 2:\n\n        Input: arr = [4, -4, 4], k = 2\n        Output: [4, 4]\n\n    Example 3:\n\n        Input: arr = [-3, 2, 1, 2, -1, -2, 1], k = 1\n        Output: [2]\n\n    Note:\n        1. The length of the array will be in the range of [1, 1000].\n        2. The elements in the array will be in the range of [-1000, 1000].\n        3. 0 <= k <= len(arr)\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Select the k largest elements (values only, unsorted)\n    selection = Selector.selectTopK(arr, k)\n\n    # Sort the selected elements in ascending order\n    sorted_selection = Sorter.sortAscending(selection)\n\n    # Wrap the result and return as a list\n    result_obj = Result(sorted_selection, k)\n    return result_obj.as_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/123": [{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n\n    The Collatz conjecture is a conjecture in mathematics that concerns a sequence defined\n    as follows: start with any positive integer n. Then each term is obtained from the \n    previous term as follows: if the previous term is even, the next term is one half of \n    the previous term. If the previous term is odd, the next term is 3 times the previous\n    term plus 1. The conjecture is that no matter what value of n, the sequence will always reach 1.\n\n    Note: \n        1. Collatz(1) is [1].\n        2. returned list sorted in increasing order.\n\n    For example:\n    get_odd_collatz(5) returns [1, 5] # The collatz sequence for 5 is [5, 16, 8, 4, 2, 1], so the odd numbers are only 1, and 5.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    odd_numbers = set()\n    current = n\n\n    if current % 2 != 0:\n        odd_numbers.add(current)\n\n    while current != 1:\n        if current % 2 == 0:\n            current = current // 2\n        else:\n            current = 3 * current + 1\n        \n        if current % 2 != 0:\n            odd_numbers.add(current)\n            \n    return sorted(list(odd_numbers))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/122": [{"task_id": "HumanEval/122", "solution": "class ArrayElement:\n    \"\"\"Wraps an integer value and provides a predicate for two-digit numbers.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isTwoDigits(self) -> bool:\n        \"\"\"Returns True if the absolute value is at most two digits.\"\"\"\n        return abs(self.value) <= 99\nclass Validator:\n    \"\"\"Validates input array and k according to specified constraints.\"\"\"\n    def validateArray(self, arr) -> bool:\n        \"\"\"Checks if arr is a list of integers with valid length.\"\"\"\n        if not isinstance(arr, list):\n            return False\n        if not (1 <= len(arr) <= 100):\n            return False\n        for x in arr:\n            if not isinstance(x, int):\n                return False\n        return True\n\n    def validateK(self, k, arrLength: int) -> bool:\n        \"\"\"Checks if k is an integer within the valid range of array length.\"\"\"\n        if not isinstance(k, int):\n            return False\n        if not (1 <= k <= arrLength):\n            return False\n        return True\nclass Filter:\n    \"\"\"Selects and filters ArrayElement objects.\"\"\"\n    def filterFirstK(self, arr, k) -> list[ArrayElement]:\n        \"\"\"Wraps the first k elements of arr into ArrayElement objects.\"\"\"\n        return [ArrayElement(arr[i]) for i in range(k)]\n\n    def selectTwoDigits(self, elements: list[ArrayElement]) -> list[ArrayElement]:\n        \"\"\"Returns ArrayElement objects that represent at most two-digit numbers.\"\"\"\n        return [element for element in elements if element.isTwoDigits()]\nclass SumOperation:\n    \"\"\"Aggregates integer values from ArrayElement objects.\"\"\"\n    def computeSum(self, elements: list[ArrayElement]) -> int:\n        \"\"\"Computes the sum of values from ArrayElement objects.\"\"\"\n        total_sum = 0\n        for element in elements:\n            total_sum += element.value\n        return total_sum\ndef add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    validator = Validator()\n    if not validator.validateArray(arr):\n        raise ValueError(\"input validation error\")\n    if not validator.validateK(k, len(arr)):\n        raise ValueError(\"input validation error\")\n\n    filter_op = Filter()\n    first_k_elements = filter_op.filterFirstK(arr, k)\n    filtered_two_digit_elements = filter_op.selectTwoDigits(first_k_elements)\n\n    sum_op = SumOperation()\n    result_sum = sum_op.computeSum(filtered_two_digit_elements)\n\n    return result_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "from typing import List, Union\nclass InputValidator:\n    \"\"\"Validates that the input is a string.\"\"\"\n    def validate(self, txt: str) -> bool:\n        \"\"\"Returns True if txt is a string, False otherwise.\"\"\"\n        return isinstance(txt, str)\nclass Splitter:\n    \"\"\"Detects separators and performs splitting operations.\"\"\"\n    def contains_whitespace(self, txt: str) -> bool:\n        \"\"\"Returns True if txt contains any whitespace character.\"\"\"\n        return any(c.isspace() for c in txt)\n\n    def contains_comma(self, txt: str) -> bool:\n        \"\"\"Returns True if txt contains a comma.\"\"\"\n        return ',' in txt\n\n    def split_on_whitespace(self, txt: str) -> List[str]:\n        \"\"\"Splits the text on any whitespace.\"\"\"\n        return txt.split()\n\n    def split_on_commas(self, txt: str) -> List[str]:\n        \"\"\"Splits the text on commas.\"\"\"\n        return txt.split(',')\nclass LetterCounter:\n    \"\"\"Counts lowercase ASCII letters with odd alphabet index.\"\"\"\n    def count_odd_index_lowercase(self, txt: str) -> int:\n        \"\"\"Iterates through the text and counts relevant letters.\"\"\"\n        count = 0\n        ord_a = ord('a')\n        for char in txt:\n            if 'a' <= char <= 'z':\n                if (ord(char) - ord_a) % 2 == 1:\n                    count += 1\n        return count\ndef split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3\n    '''\n    validator = InputValidator()\n    if not validator.validate(txt):\n        raise TypeError('txt must be a string')\n\n    splitter = Splitter()\n    if splitter.contains_whitespace(txt):\n        return splitter.split_on_whitespace(txt)\n\n    if splitter.contains_comma(txt):\n        return splitter.split_on_commas(txt)\n\n    counter = LetterCounter()\n    return counter.count_odd_index_lowercase(txt)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two\n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n    \"\"\"\n\n    class Interval:\n        \"\"\"Represents a closed interval [start, end].\"\"\"\n        def __init__(self, start: int, end: int):\n            self.start = start\n            self.end = end\n\n        def isValid(self) -> bool:\n            \"\"\"Checks if the interval's start is less than or equal to its end.\"\"\"\n            return self.start <= self.end\n\n    class Intersection:\n        \"\"\"Represents the intersection of two intervals.\"\"\"\n        def __init__(self, start: int, end: int):\n            self.start = start\n            self.end = end\n\n        def length(self) -> int:\n            \"\"\"Calculates the numeric length of the intersection.\"\"\"\n            return self.end - self.start\n\n    class PrimeChecker:\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        def isPrime(self, n: int) -> bool:\n            \"\"\"Returns True if n is prime, False otherwise.\"\"\"\n            if n <= 1:\n                return False\n            if n == 2:\n                return True\n            if n % 2 == 0:\n                return False\n            i = 3\n            while i * i <= n:\n                if n % i == 0:\n                    return False\n                i += 2\n            return True\n\n    i1 = Interval(interval1[0], interval1[1])\n    i2 = Interval(interval2[0], interval2[1])\n\n    if not i1.isValid() or not i2.isValid():\n        return \"NO\"\n\n    intersection_start = max(i1.start, i2.start)\n    intersection_end = min(i1.end, i2.end)\n\n    if intersection_start > intersection_end:\n        return \"NO\"\n\n    inter = Intersection(intersection_start, intersection_end)\n    length = inter.length()\n\n    checker = PrimeChecker()\n    if checker.isPrime(length):\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/126": [{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    def _is_non_decreasing(lst):\n        '''Checks if the list is sorted in non-decreasing order.'''\n        if len(lst) <= 1:\n            return True\n        for i in range(1, len(lst)):\n            if lst[i] < lst[i-1]:\n                return False\n        return True\n\n    def _has_triple_duplicate(lst):\n        '''Checks if any number appears three or more times in the list.'''\n        counts = {}\n        for num in lst:\n            counts[num] = counts.get(num, 0) + 1\n            if counts[num] >= 3:\n                return True\n        return False\n\n    non_decreasing = _is_non_decreasing(lst)\n    triple_duplicate_found = _has_triple_duplicate(lst)\n\n    return non_decreasing and (not triple_duplicate_found)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/128": [{"task_id": "HumanEval/128", "solution": "class Element:\n    \"\"\"Represents an integer with methods to get its sign and magnitude.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def sign(self) -> int:\n        \"\"\"Returns 1 if positive, -1 if negative, 0 if zero.\"\"\"\n        if self.value > 0:\n            return 1\n        elif self.value < 0:\n            return -1\n        else:\n            return 0\n\n    def magnitude(self) -> int:\n        \"\"\"Returns the absolute value of the integer.\"\"\"\n        return abs(self.value)\nclass Array:\n    \"\"\"A wrapper for a list of integers, providing length and element access.\"\"\"\n    def __init__(self, elements: list[int]):\n        self.elements = elements\n        self.length = len(elements)\n\n    def get_element(self, index: int) -> int:\n        \"\"\"Returns the integer at the specified index.\"\"\"\n        return self.elements[index]\nclass SignCalculator:\n    \"\"\"Calculates the product of signs of numbers in an array.\"\"\"\n    def productOfSigns(self, arr: Array) -> int:\n        \"\"\"Iterates through the array to compute the product of signs.\"\"\"\n        product = 1\n        for val in arr.elements:\n            element = Element(val)\n            current_sign = element.sign()\n            if current_sign == 0:\n                return 0\n            product *= current_sign\n        return product\nclass MagnitudeCalculator:\n    \"\"\"Calculates the sum of magnitudes of numbers in an array.\"\"\"\n    def sumOfMagnitudes(self, arr: Array) -> int:\n        \"\"\"Iterates through the array to compute the sum of magnitudes.\"\"\"\n        total_magnitude = 0\n        for val in arr.elements:\n            element = Element(val)\n            total_magnitude += element.magnitude()\n        return total_magnitude\nclass ProdSignsService:\n    \"\"\"Orchestrates calculation of sum of magnitudes multiplied by product of signs.\"\"\"\n    def __init__(self, sign_calc: SignCalculator, mag_calc: MagnitudeCalculator):\n        self._sign_calc = sign_calc\n        self._mag_calc = mag_calc\n\n    def compute(self, arr: Array) -> int | None:\n        \"\"\"Computes the result based on array elements, handling empty and zero cases.\"\"\"\n        if arr.length == 0:\n            return None\n\n        product_of_signs = 1\n        sum_of_magnitudes = 0\n        \n        # Single pass to accumulate both and handle short-circuit\n        for val in arr.elements:\n            element = Element(val)\n            current_sign = element.sign()\n            if current_sign == 0:\n                return 0 # Short-circuit if any element is zero\n            \n            product_of_signs *= current_sign\n            sum_of_magnitudes += element.magnitude()\n            \n        return sum_of_magnitudes * product_of_signs\ndef prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    # Instantiate calculators and service as per design\n    sign_calc = SignCalculator()\n    mag_calc = MagnitudeCalculator()\n    service = ProdSignsService(sign_calc, mag_calc)\n    \n    # Adapt input list to domain.Array and compute\n    return service.compute(Array(arr))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/124": [{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"Validates a given date string according to specific rules and format mm-dd-yyyy.\"\"\"\n    # Rule 1: The date string is not empty.\n    if not date:\n        return False\n\n    # Rule 4: The date should be in the format: mm-dd-yyyy\n    if len(date) != 10:\n        return False\n\n    if date[2] != '-' or date[5] != '-':\n        return False\n\n    month_str = date[0:2]\n    day_str = date[3:5]\n    year_str = date[6:10]\n\n    # Check if all parts are composed of digits\n    if not (month_str.isdigit() and day_str.isdigit() and year_str.isdigit()):\n        return False\n\n    try:\n        month = int(month_str)\n        day = int(day_str)\n        # Year is parsed but not validated further by the given rules.\n        _ = int(year_str) \n    except ValueError:\n        return False\n\n    # Rule 3: The months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # Rule 2: Validate day based on month group.\n    if month in [1, 3, 5, 7, 8, 10, 12]:\n        if not (1 <= day <= 31):\n            return False\n    elif month in [4, 6, 9, 11]:\n        if not (1 <= day <= 30):\n            return False\n    elif month == 2:\n        if not (1 <= day <= 29): # Allow up to 29 days for February, no leap year calculation.\n            return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/131": [{"task_id": "HumanEval/131", "solution": "class Digit:\n    \"\"\"Represents a single decimal digit and its parity logic.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isOdd(self) -> bool:\n        \"\"\"Returns True if the digit is odd, False otherwise.\"\"\"\n        return self.value % 2 == 1\nclass DigitExtractor:\n    \"\"\"Parses an integer into a list of Digit instances.\"\"\"\n    def extract(self, n: int) -> list[Digit]:\n        \"\"\"Extracts individual digits from an integer n.\"\"\"\n        digits_list = []\n        # Convert integer to string to iterate through its digits\n        for char_digit in str(n):\n            digit_value = int(char_digit)\n            digits_list.append(Digit(digit_value))\n        return digits_list\nclass ProductCalculator:\n    \"\"\"Computes the product of odd digits, returning 0 if none are odd.\"\"\"\n    def computeProduct(self, digits: list[Digit]) -> int:\n        \"\"\"Calculates the product of odd digits in a list of Digit objects.\"\"\"\n        product = 1\n        has_odd_digits = False\n        for digit_obj in digits:\n            if digit_obj.isOdd():\n                product *= digit_obj.value\n                has_odd_digits = True\n        \n        if not has_odd_digits:\n            return 0\n        else:\n            return product\ndef digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    extractor = DigitExtractor()\n    digits_list = extractor.extract(n)\n\n    calculator = ProductCalculator()\n    result = calculator.computeProduct(digits_list)\n    \n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/39": [{"task_id": "HumanEval/39", "solution": "import math\nclass FibonacciNumber:\n    \"\"\"Data holder for a Fibonacci term.\"\"\"\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\nclass InputValidator:\n    \"\"\"Validates input for the prime_fib function.\"\"\"\n    def validate(self, n: int) -> None:\n        if not isinstance(n, int):\n            raise ValueError(\"Input 'n' must be an integer.\")\n        if n < 1:\n            raise ValueError(\"Input 'n' must be greater than or equal to 1.\")\nclass FibonacciGenerator:\n    \"\"\"Generates Fibonacci numbers in ascending order.\"\"\"\n    def __init__(self):\n        self._index = 0\n        self._a = 0\n        self._b = 1\n        self.reset()\n\n    def reset(self) -> None:\n        \"\"\"Initializes internal state to start the sequence (0, 1, 1, 2, ...).\"\"\"\n        self._index = 0\n        self._a = 0\n        self._b = 1\n\n    def next(self) -> FibonacciNumber:\n        \"\"\"Advances and returns the next Fibonacci number.\"\"\"\n        if self._index == 0:\n            value_to_return = 0\n        elif self._index == 1:\n            value_to_return = 1\n        else:\n            value_to_return = self._a + self._b\n            self._a = self._b\n            self._b = value_to_return\n        \n        fib_num = FibonacciNumber(index=self._index, value=value_to_return)\n        self._index += 1\n        return fib_num\nclass PrimalityTester:\n    \"\"\"Determines primality of integers.\"\"\"\n    def is_prime(self, x: int) -> bool:\n        \"\"\"Returns True if x is prime, False otherwise.\"\"\"\n        if x < 2:\n            return False\n        if x == 2:\n            return True\n        if x % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(x)) + 1, 2):\n            if x % i == 0:\n                return False\n        return True\nclass PrimeFibService:\n    \"\"\"Orchestrates finding the n-th prime Fibonacci number.\"\"\"\n    def __init__(self):\n        self.validator = InputValidator()\n        self.generator = FibonacciGenerator()\n        self.primality_tester = PrimalityTester()\n\n    def prime_fib(self, n: int) -> int:\n        \"\"\"Finds the n-th Fibonacci number that is also prime.\"\"\"\n        self.validator.validate(n)\n        self.generator.reset()\n\n        prime_count = 0\n        while True:\n            fib_number_obj = self.generator.next()\n            fib_value = fib_number_obj.value\n\n            if self.primality_tester.is_prime(fib_value):\n                prime_count += 1\n                if prime_count == n:\n                    return fib_value\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    service = PrimeFibService()\n    return service.prime_fib(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[12]]}], "HumanEval/133": [{"task_id": "HumanEval/133", "solution": "def sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    Examples:\n    For lst = [1,2,3] the output should be 14\n    For lst = [1,4,9] the output should be 98\n    For lst = [1,3,5,7] the output should be 84\n    For lst = [1.4,4.2,0] the output should be 29\n    For lst = [-2.4,1,1] the output should be 6\n    \"\"\"\n    import math\n\n    def _ceil_value(x):\n        \"\"\"Return math.ceil(x) as int.\"\"\"\n        return int(math.ceil(x))\n\n    def _square_value(n):\n        \"\"\"Return n * n.\"\"\"\n        return n * n\n\n    def _sum_values(values):\n        \"\"\"Return sum(values) as int.\"\"\"\n        return sum(values)\n\n    ceiled_values = [_ceil_value(x) for x in lst]\n    squared_values = [_square_value(n) for n in ceiled_values]\n    return _sum_values(squared_values)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/134": [{"task_id": "HumanEval/134", "solution": "from dataclasses import dataclass\nfrom typing import Optional\nclass InputString:\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        return len(self.text)\n\n    def last_char(self) -> Optional[str]:\n        if self.length() == 0:\n            return None\n        return self.text[-1]\n\n    def prev_char(self) -> Optional[str]:\n        if self.length() < 2:\n            return None\n        return self.text[-2]\nclass Character:\n    def __init__(self, ch: str):\n        self.ch = ch\n\n    def is_alphabetic(self) -> bool:\n        \"\"\"Checks if the character is an ASCII letter (A-Z or a-z).\"\"\"\n        return ('A' <= self.ch <= 'Z') or ('a' <= self.ch <= 'z')\n\n    def is_space(self) -> bool:\n        \"\"\"Checks if the character is a space.\"\"\"\n        return self.ch == ' '\nclass LastCharChecker:\n    def check(self, txt: str) -> bool:\n        \"\"\"\n        Implements the core logic to determine if the last character\n        is a standalone letter based on the given rules.\n        \"\"\"\n        input_string = InputString(txt)\n\n        if input_string.length() == 0:\n            return Result(value=False).value\n\n        last_char_str = input_string.last_char()\n        last_char = Character(last_char_str)\n\n        if not last_char.is_alphabetic():\n            return Result(value=False).value\n\n        if input_string.length() == 1:\n            return Result(value=True).value\n\n        prev_char_str = input_string.prev_char()\n        prev_char = Character(prev_char_str)\n\n        if prev_char.is_space():\n            return Result(value=True).value\n        else:\n            return Result(value=False).value\ndef check_if_last_char_is_a_letter(txt):\n    '''\n    Create a function that returns True if the last character\n    of a given string is an alphabetical character and is not\n    a part of a word, and False otherwise.\n    Note: \"word\" is a group of characters separated by space.\n    '''\n    checker = LastCharChecker()\n    return checker.check(txt)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["apple"]], "plus_fail_tests": [["Pumpkin pi e"]]}], "HumanEval/135": [{"task_id": "HumanEval/135", "solution": "from typing import List, Any\nclass InputArray:\n    \"\"\"Wraps caller-supplied array and provides validation for no-duplicates.\"\"\"\n    def __init__(self, elements: List[Any]):\n        self.elements = elements\n\n    def validateNoDuplicates(self) -> bool:\n        \"\"\"Returns True if no duplicates, False otherwise.\"\"\"\n        return len(set(self.elements)) == len(self.elements)\nclass CanArrangeService:\n    \"\"\"Core algorithm to compute the largest zero-based index i such that arr[i] < arr[i-1].\"\"\"\n    @staticmethod\n    def can_arrange(arr_obj: InputArray) -> int:\n        \"\"\"Returns the largest index satisfying arr.elements[i] < arr.elements[i-1], or -1 if none.\"\"\"\n        elements = arr_obj.elements\n        n = len(elements)\n        # Iterate from the second to last element down to the second element (index 1).\n        # We need to compare elements[i] with elements[i-1].\n        for i in range(n - 1, 0, -1):\n            if elements[i] < elements[i-1]:\n                return i\n        return -1\ndef can_arrange(arr):\n    \"\"\"Create a function which returns the largest index of an element which\n    is not greater than or equal to the element immediately preceding it. If\n    no such element exists then return -1. The given array will not contain\n    duplicate values.\n\n    Examples:\n    can_arrange([1,2,4,3,5]) = 3\n    can_arrange([1,2,3]) = -1\n    \"\"\"\n    input_array = InputArray(arr)\n    if not input_array.validateNoDuplicates():\n        raise ValueError(\"duplicate elements in arr\")\n    \n    index = CanArrangeService.can_arrange(input_array)\n    return index", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/132": [{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets \n    where at least one bracket in the subsequence is nested.\n    '''\n\n    class InputString:\n        def __init__(self, content: str):\n            self.content = content\n            self.length = len(content)\n\n        def validateCharacters(self) -> bool:\n            \"\"\"Checks that content contains only '[' and ']'.\"\"\"\n            for char in self.content:\n                if char not in {'[', ']'}:\n                    return False\n            return True\n\n    class Subsequence:\n        def __init__(self, content: str):\n            self.content = content\n            self.length = len(content)\n\n        def isBalanced(self) -> bool:\n            \"\"\"Returns True iff content is a well-formed bracket sequence.\"\"\"\n            stack = []\n            for char in self.content:\n                if char == '[':\n                    stack.append(char)\n                elif char == ']':\n                    if not stack:\n                        return False\n                    stack.pop()\n            return not stack\n\n        def maxDepth(self) -> int:\n            \"\"\"Returns the maximum nesting depth for a balanced subsequence.\"\"\"\n            if not self.isBalanced(): # Precondition: balanced. Returning 0 if not balanced for simplicity.\n                return 0\n            max_d = 0\n            current_d = 0\n            for char in self.content:\n                if char == '[':\n                    current_d += 1\n                    max_d = max(max_d, current_d)\n                elif char == ']':\n                    current_d -= 1\n            return max_d\n\n    class BracketPair:\n        def __init__(self, openIndex: int, closeIndex: int):\n            self.openIndex = openIndex\n            self.closeIndex = closeIndex\n\n    class Result:\n        def __init__(self, isNested: bool):\n            self.isNested = isNested\n\n    class BracketMatcher:\n        def __init__(self, input_string: InputString):\n            self.input_string = input_string\n\n        def findBalancedSubsequenceWithMinDepth(self, minDepth: int) -> bool:\n            \"\"\"Returns True iff there exists a balanced subsequence with maximum nesting depth >= minDepth (2).\"\"\"\n            # An O(N) greedy search for the simplest depth-2 subsequence: '[[ ]]'.\n            # We need to find four characters in increasing order of indices:\n            # string[i] == '[', string[j] == '[', string[k] == ']', string[l] == ']' where i < j < k < l.\n\n            open1_idx = -1\n            # Find the first '['\n            for i in range(self.input_string.length):\n                if self.input_string.content[i] == '[':\n                    open1_idx = i\n                    break\n            if open1_idx == -1:\n                return False\n\n            open2_idx = -1\n            # Find the second '[' after the first '['\n            for i in range(open1_idx + 1, self.input_string.length):\n                if self.input_string.content[i] == '[':\n                    open2_idx = i\n                    break\n            if open2_idx == -1:\n                return False\n\n            close1_idx = -1\n            # Find the first ']' after the second '['\n            for i in range(open2_idx + 1, self.input_string.length):\n                if self.input_string.content[i] == ']':\n                    close1_idx = i\n                    break\n            if close1_idx == -1:\n                return False\n\n            close2_idx = -1\n            # Find the second ']' after the first ']'\n            for i in range(close1_idx + 1, self.input_string.length):\n                if self.input_string.content[i] == ']':\n                    close2_idx = i\n                    break\n            if close2_idx == -1:\n                return False\n\n            # If all four required brackets are found in the correct relative order,\n            # a '[[ ]]' subsequence exists, satisfying minDepth >= 2.\n            return True\n\n    # Main entry point logic for is_nested(string)\n    inp = InputString(content=string)\n\n    if not inp.validateCharacters():\n        return False\n\n    matcher = BracketMatcher(inp)\n    found = matcher.findBalancedSubsequenceWithMinDepth(2)\n    return found", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["[][][]"]]}], "HumanEval/136": [{"task_id": "HumanEval/136", "solution": "import sys\nfrom typing import List, Optional, Tuple\nclass IntegerElement:\n    def __init__(self, value: int) -> None:\n        self.value: int = value\n\n    def isNegative(self) -> bool:\n        return self.value < 0\n\n    def isPositive(self) -> bool:\n        return self.value > 0\nclass ResultTuple:\n    def __init__(self, a: Optional[int], b: Optional[int]) -> None:\n        self.a: Optional[int] = a\n        self.b: Optional[int] = b\nclass InputList:\n    def __init__(self, values: List[int]) -> None:\n        self.values: List[int] = values\n\n    def getNegatives(self) -> List[IntegerElement]:\n        return [IntegerElement(val) for val in self.values if val < 0]\n\n    def getPositives(self) -> List[IntegerElement]:\n        return [IntegerElement(val) for val in self.values if val > 0]\n\n    def produceResult(self) -> 'ResultTuple':\n        largest_negative = None\n        smallest_positive = None\n\n        for num in self.values:\n            if num < 0:\n                if largest_negative is None or num > largest_negative:\n                    largest_negative = num\n            elif num > 0:\n                if smallest_positive is None or num < smallest_positive:\n                    smallest_positive = num\n        return ResultTuple(largest_negative, smallest_positive)\ndef largest_smallest_integers(lst: List[int]) -> Tuple[Optional[int], Optional[int]]:\n    \"\"\"\n    Public API per SRS FR1/FR2. Caller must pass a list of integers.\n    Returns (a, b) where a is largest negative or None and b is smallest positive or None.\n    \"\"\"\n    input_list = InputList(lst)\n    result = input_list.produceResult()\n    return (result.a, result.b)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n    def __str__(self) -> str:\n        return f\"ValidationError: {self.message}\"\nclass InputParameter:\n    \"\"\"Encapsulates input 'n' and validates its preconditions.\"\"\"\n    def __init__(self, value: object) -> None:\n        self.value = value\n\n    def validate(self) -> bool:\n        if not isinstance(self.value, int):\n            raise ValidationError(\"Input 'n' must be an integer.\")\n        if self.value <= 0:\n            raise ValidationError(\"Input 'n' must be greater than 0.\")\n        return True\nclass FactorialCalculator:\n    \"\"\"Computes factorial values k! using memoization.\"\"\"\n    def __init__(self) -> None:\n        self._cache: dict[int, int] = {0: 1, 1: 1}\n\n    def compute(self, k: int) -> int:\n        if k < 0:\n            raise ValueError(\"Factorial is not defined for negative numbers.\")\n        if k in self._cache:\n            return self._cache[k]\n\n        # Compute iteratively from the largest cached value.\n        last_cached_k = max(self._cache.keys())\n        result = self._cache[last_cached_k]\n        for i in range(last_cached_k + 1, k + 1):\n            result *= i\n            self._cache[i] = result\n        return result\nclass BrazilianFactorial:\n    \"\"\"Computes the Brazilian factorial using FactorialCalculator.\"\"\"\n    def __init__(self, factorial_calculator: 'FactorialCalculator' | None = None) -> None:\n        self._factorial_calculator = factorial_calculator or FactorialCalculator()\n\n    def compute(self, n: int) -> int:\n        if n < 1:\n            raise ValueError(\"n must be greater than 0 for Brazilian Factorial computation.\")\n\n        total_product = 1\n        for k in range(1, n + 1):\n            k_factorial = self._factorial_calculator.compute(k)\n            total_product *= k_factorial\n        return total_product\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    ip = InputParameter(n)\n    ip.validate()\n\n    bf = BrazilianFactorial()\n    value = bf.compute(ip.value)\n    return value", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/137": [{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    \"\"\"\n\n    class StringParser:\n        \"\"\"Parses string numeric representations, handling '.' or ',' as decimal separators.\"\"\"\n        def __init__(self, decimal_separators=None):\n            self.decimal_separators = decimal_separators if decimal_separators is not None else ['.', ',']\n\n        def parse_string(self, s: str) -> float:\n            \"\"\"Converts a string to a float, replacing ',' with '.' for standard parsing.\"\"\"\n            processed_s = s\n            if ',' in s and '.' not in s: # Replace ',' only if it seems to be the decimal separator\n                processed_s = s.replace(',', '.')\n            return float(processed_s)\n\n    class InputValue:\n        \"\"\"Encapsulates a raw input value and its parsed numeric representation.\"\"\"\n        def __init__(self, raw_value):\n            self.raw_value = raw_value\n            self.numeric_value = None\n            self.is_string = isinstance(raw_value, str)\n\n        def parse(self, parser: 'StringParser') -> float:\n            \"\"\"Parses the raw value to its numeric float representation.\"\"\"\n            if self.is_string:\n                self.numeric_value = parser.parse_string(self.raw_value)\n            else:\n                self.numeric_value = float(self.raw_value)\n            return self.numeric_value\n\n    class Comparator:\n        \"\"\"Compares two InputValue objects based on their numeric values.\"\"\"\n        def compare(self, a: 'InputValue', b: 'InputValue') -> int:\n            \"\"\"Returns 1 if a > b, -1 if a < b, 0 if equal.\"\"\"\n            if a.numeric_value > b.numeric_value:\n                return 1\n            elif a.numeric_value < b.numeric_value:\n                return -1\n            else:\n                return 0\n\n    # Orchestration\n    parser = StringParser()\n    left_input = InputValue(a)\n    right_input = InputValue(b)\n\n    left_input.parse(parser)\n    right_input.parse(parser)\n\n    comparator = Comparator()\n    comparison_result = comparator.compare(left_input, right_input)\n\n    if comparison_result == 1:\n        return left_input.raw_value\n    elif comparison_result == -1:\n        return right_input.raw_value\n    else: # comparison_result == 0 (values are numerically equal)\n        return None", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/140": [{"task_id": "HumanEval/140", "solution": "from dataclasses import dataclass\nclass Transformer:\n    \"\"\"Core component to encapsulate transformation algorithm and rules.\"\"\"\n    def __init__(self):\n        self._rules = [\n            TransformationRule('one-space', 'len==1', '_'),\n            TransformationRule('two-spaces', 'len==2', '__'),\n            TransformationRule('threeplus-spaces', 'len>=3', '-')\n        ]\n\n    def identifyRuns(self, text: str) -> list[SpaceRun]:\n        \"\"\"Scans text and returns SpaceRun objects for contiguous U+0020 runs.\"\"\"\n        runs = []\n        i = 0\n        n = len(text)\n        while i < n:\n            if text[i] == ' ':\n                start = i\n                while i < n and text[i] == ' ':\n                    i += 1\n                runs.append(SpaceRun(start, i - start))\n            else:\n                i += 1\n        return runs\n\n    def applyRule(self, run: SpaceRun) -> str:\n        \"\"\"Returns the replacement string according to run's length.\"\"\"\n        for rule in self._rules:\n            if rule.appliesTo(run):\n                return rule.replacement\n        return \"\" # Should not occur if rules are exhaustive\n\n    def fix_spaces(self, text: str) -> str:\n        \"\"\"Orchestrates the space transformation process.\"\"\"\n        input_str = InputString(text)\n        if input_str.isEmpty():\n            return \"\"\n\n        output_parts = []\n        last_index = 0\n        \n        runs = self.identifyRuns(text)\n\n        for run in runs:\n            # Append characters before the current space run\n            if run.startIndex > last_index:\n                output_parts.append(text[last_index : run.startIndex])\n            \n            # Apply rule for the space run and append replacement\n            output_parts.append(self.applyRule(run))\n            \n            last_index = run.startIndex + run.length\n        \n        # Append any remaining characters after the last space run\n        if last_index < len(text):\n            output_parts.append(text[last_index:])\n            \n        return \"\".join(output_parts)\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    return Transformer().fix_spaces(text)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/138": [{"task_id": "HumanEval/138", "solution": "from datetime import datetime\nfrom typing import Optional\nclass Input:\n    \"\"\"Represents and validates caller-provided integer n.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def validate(self) -> None:\n        \"\"\"Ensures n is an integer; raises ValueError otherwise.\"\"\"\n        if not isinstance(self.n, int):\n            raise ValueError(\"Input n must be an integer.\")\nclass EvenSumEvaluator:\n    \"\"\"Stateless evaluator implementing the decision rule.\"\"\"\n    def is_sum_of_four_even(self, n: int) -> bool:\n        \"\"\"Returns True if n is even and greater than or equal to 8.\"\"\"\n        return self.check_parity(n) and self.check_minimum(n)\n\n    def check_parity(self, n: int) -> bool:\n        \"\"\"Returns True if n is an even number.\"\"\"\n        return n % 2 == 0\n\n    def check_minimum(self, n: int) -> bool:\n        \"\"\"Returns True if n is greater than or equal to 8.\"\"\"\n        return n >= 8\nclass EvaluationResult:\n    \"\"\"Immutable record of an evaluation.\"\"\"\n    def __init__(self, n: int, result: bool, evaluated_at: datetime) -> None:\n        self.n = n\n        self.result = result\n        self.evaluated_at = evaluated_at\nclass Logger:\n    \"\"\"Lightweight in-memory logging of evaluation events.\"\"\"\n    _events: list = [] # Class variable to store events across instances\n\n    def __init__(self) -> None:\n        pass\n\n    def log(self, event: dict) -> None:\n        \"\"\"Appends an event dictionary to the in-memory log.\"\"\"\n        Logger._events.append(event)\n\n    def retrieve(self, filter_fn: Optional[callable] = None) -> list:\n        \"\"\"Retrieves logged events, optionally filtered.\"\"\"\n        if filter_fn:\n            return [event for event in Logger._events if filter_fn(event)]\n        return list(Logger._events)\ndef is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    input_obj = Input(n)\n    input_obj.validate()\n\n    evaluator = EvenSumEvaluator()\n    result = evaluator.is_sum_of_four_even(n)\n\n    evaluated_at = datetime.now()\n    _ = EvaluationResult(n, result, evaluated_at) # Create result object as per design\n\n    current_logger = Logger()\n    current_logger.log({'n': n, 'result': result, 'evaluated_at': evaluated_at})\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/144": [{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Represents a fraction with numerator and denominator.\"\"\"\n    def __init__(self):\n        self.raw = \"\"\n        self.numerator = 0\n        self.denominator = 0\n\n    def parse(self, raw: str) -> None:\n        \"\"\"Parses a raw fraction string \"<numerator>/<denominator>\".\"\"\"\n        self.raw = raw\n        parts = raw.split('/')\n        self.numerator = int(parts[0])\n        self.denominator = int(parts[1])\nclass Product:\n    \"\"\"Represents the product of two fractions.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    def isWhole(self) -> bool:\n        \"\"\"Checks if the product is a whole number.\"\"\"\n        return self.numerator % self.denominator == 0\nclass FractionParser:\n    \"\"\"Parses fraction strings into Fraction objects.\"\"\"\n    def parseFraction(self, s: str) -> Fraction:\n        \"\"\"Parses a fraction string and returns a Fraction object.\"\"\"\n        fraction = Fraction()\n        fraction.parse(s)\n        return fraction\nclass Simplifier:\n    \"\"\"Coordinates the simplification process.\"\"\"\n    def isWholeProduct(self, a: Fraction, b: Fraction) -> bool:\n        \"\"\"Calculates the product of two fractions and checks if it's a whole number.\"\"\"\n        product_numerator = a.numerator * b.numerator\n        product_denominator = a.denominator * b.denominator\n        product = Product(product_numerator, product_denominator)\n        return product.isWhole()\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n    \"\"\"\n    parser = FractionParser()\n    fx = parser.parseFraction(x)\n    fn = parser.parseFraction(n)\n    simplifier = Simplifier()\n    return simplifier.isWholeProduct(fx, fn)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/141": [{"task_id": "HumanEval/141", "solution": "class FileName:\n    \"\"\"Represents a file's name with its parsed components and digit count.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n        self.nameBeforeDot = \"\"\n        self.extension = \"\"\n        self.digitCount = sum(1 for char in raw if '0' <= char <= '9')\nclass ValidationResult:\n    \"\"\"Represents the outcome of a validation check.\"\"\"\n    def __init__(self, valid: bool, message: str = \"\"):\n        self.valid = valid\n        self.message = message\nclass FileNameValidator:\n    \"\"\"Provides atomic validation checks and orchestrates filename validation.\"\"\"\n\n    def countDigits(self, s: str) -> int:\n        \"\"\"Counts the number of digits ('0'-'9') in a string.\"\"\"\n        return sum(1 for char in s if '0' <= char <= '9')\n\n    def hasExactlyOneDot(self, s: str) -> bool:\n        \"\"\"Checks if a string contains exactly one dot '.'.\"\"\"\n        return s.count('.') == 1\n\n    def splitNameAndExtension(self, s: str) -> (str, str):\n        \"\"\"Splits a string into name before dot and extension, assuming exactly one dot.\"\"\"\n        if self.hasExactlyOneDot(s):\n            parts = s.split('.', 1)\n            return parts[0], parts[1]\n        return '', ''\n\n    def startsWithLatinLetter(self, s: str) -> bool:\n        \"\"\"Checks if a string is non-empty and starts with a Latin alphabet letter.\"\"\"\n        if not s:\n            return False\n        first_char = s[0]\n        return ('a' <= first_char <= 'z') or ('A' <= first_char <= 'Z')\n\n    def isAllowedExtension(self, ext: str) -> bool:\n        \"\"\"Checks if the extension is one of the allowed values (case-sensitive).\"\"\"\n        return ext in ['txt', 'exe', 'dll']\n\n    def isValid(self, fileName: 'FileName') -> 'ValidationResult':\n        \"\"\"Runs all atomic checks to determine if the filename is valid.\"\"\"\n        raw_name = fileName.raw\n\n        # Condition 1: There should not be more than three digits.\n        digit_count = self.countDigits(raw_name)\n        if digit_count > 3:\n            return ValidationResult(False, \"More than three digits in file name.\")\n\n        # Condition 2: The file's name contains exactly one dot.\n        if not self.hasExactlyOneDot(raw_name):\n            return ValidationResult(False, \"File name does not contain exactly one dot.\")\n\n        # If exactly one dot, then split and populate fileName object fields\n        name_before_dot, extension = self.splitNameAndExtension(raw_name)\n        fileName.nameBeforeDot = name_before_dot\n        fileName.extension = extension\n\n        # Condition 3a: The substring before the dot should not be empty.\n        if not name_before_dot:\n            return ValidationResult(False, \"Substring before the dot is empty.\")\n\n        # Condition 3b: The substring before the dot starts with a Latin alphabet letter.\n        if not self.startsWithLatinLetter(name_before_dot):\n            return ValidationResult(False, \"Substring before the dot does not start with a latin letter.\")\n\n        # Condition 4: The substring after the dot should be one of ['txt', 'exe', 'dll'].\n        if not self.isAllowedExtension(extension):\n            return ValidationResult(False, \"Extension is not one of ['txt', 'exe', 'dll'].\")\n\n        return ValidationResult(True, \"File name is valid.\")\ndef file_name_check(file_name):\n    \"\"\"\n    Checks if a file's name is valid based on specific criteria.\n    Returns 'Yes' if valid, 'No' otherwise.\n    \"\"\"\n    file_obj = FileName(raw=file_name)\n    validator = FileNameValidator()\n    result = validator.isValid(file_obj)\n    return 'Yes' if result.valid else 'No'", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\u00e9xample.exe"]]}], "HumanEval/143": [{"task_id": "HumanEval/143", "solution": "import math\nclass PrimeChecker:\n    \"\"\"\n    Determines whether an integer is a prime number.\n    \"\"\"\n    def isPrime(self, n: int) -> bool:\n        \"\"\"\n        Checks if a number n is prime.\n        A number is prime if it is greater than 1 and has no positive divisors other than 1 and itself.\n        \"\"\"\n        if n <= 1:\n            return False\n        for i in range(2, int(math.sqrt(n)) + 1):\n            if n % i == 0:\n                return False\n        return True\nclass Sentence:\n    \"\"\"\n    Represents an input sentence, providing validation and length.\n    \"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        \"\"\"\n        Returns the total character length of the sentence.\n        \"\"\"\n        return len(self.text)\n\n    def validate(self) -> bool:\n        \"\"\"\n        Validates if the sentence contains only letters and spaces and its length is between 1 and 100.\n        \"\"\"\n        if not (1 <= len(self.text) <= 100):\n            return False\n        if not all(c.isalpha() or c == ' ' for c in self.text):\n            return False\n        return True\nclass Word:\n    \"\"\"\n    Represents a single word token, storing its text and computing its length.\n    \"\"\"\n    def __init__(self, text: str):\n        self.text = text\n        self.length = len(text)\ndef _split_by_single_space(sentence_text: str) -> list[str]:\n    \"\"\"\n    Splits the sentence into words using a single space as a delimiter.\n    \"\"\"\n    return sentence_text.split(' ')\ndef _assemble_result(words: list[str]) -> str:\n    \"\"\"\n    Joins a list of words into a single string, separated by spaces.\n    Returns an empty string if the list is empty.\n    \"\"\"\n    return ' '.join(words)\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Returns a string containing words from the original sentence whose lengths are prime numbers,\n    preserving their original order.\n    \"\"\"\n    sentence_obj = Sentence(sentence)\n\n    if not sentence_obj.validate():\n        raise ValueError(\"Input sentence invalid: must be letters and spaces and length 1..100 per NFRs\")\n\n    words_text = _split_by_single_space(sentence_obj.text)\n    prime_checker = PrimeChecker()\n    \n    selected_words = []\n    for text in words_text:\n        # According to design, Word length is computed as len(text) and sentence contains only letters.\n        word_obj = Word(text)\n        if prime_checker.isPrime(word_obj.length):\n            selected_words.append(word_obj.text)\n            \n    return _assemble_result(selected_words)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/146": [{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Filters numbers based on value and digit parity, returning a count.\n    Delegates the filtering logic to internal classes.\n    \"\"\"\n\n    def _is_odd(digit: int) -> bool:\n        \"\"\"Returns True if the digit is odd (1, 3, 5, 7, 9).\"\"\"\n        return digit in {1, 3, 5, 7, 9}\n\n    class Result:\n        \"\"\"Value object holding an integer count.\"\"\"\n        def __init__(self, count: int):\n            self.count = count\n\n    class NumberElement:\n        \"\"\"Represents a numeric element and provides digit-extraction helpers.\"\"\"\n        def __init__(self, value):\n            self._value = value\n\n        def getFirstDigit(self) -> int:\n            \"\"\"Returns the most significant base-10 digit of abs(value).\"\"\"\n            abs_val = abs(self._value)\n            if abs_val == 0:\n                return 0\n            while abs_val >= 10:\n                abs_val //= 10\n            return abs_val\n\n        def getLastDigit(self) -> int:\n            \"\"\"Returns the least significant base-10 digit of abs(value).\"\"\"\n            return abs(self._value) % 10\n\n        def isGreaterThan10(self) -> bool:\n            \"\"\"Returns True if the number's value is strictly greater than 10.\"\"\"\n            return self._value > 10\n\n    class InputArray:\n        \"\"\"Read-only wrapper for a sequence of numbers, yielding NumberElement instances.\"\"\"\n        def __init__(self, nums):\n            self._nums = nums\n\n        def __iter__(self):\n            for num in self._nums:\n                yield NumberElement(num)\n\n    class SpecialFilter:\n        \"\"\"Encapsulates the filtering algorithm, acting as a stateless application service.\"\"\"\n        def apply(self, nums) -> Result:\n            \"\"\"Accepts nums, produces a Result(count) based on filtering rules.\"\"\"\n            if not nums:\n                return Result(0)\n\n            count = 0\n            for elem in InputArray(nums):\n                if self._evaluate_element(elem):\n                    count += 1\n            return Result(count)\n\n        def _evaluate_element(self, element: NumberElement) -> bool:\n            \"\"\"Private helper returning True if element satisfies value and digit parity conditions.\"\"\"\n            if element.isGreaterThan10():\n                first_digit = element.getFirstDigit()\n                last_digit = element.getLastDigit()\n                if _is_odd(first_digit) and _is_odd(last_digit):\n                    return True\n            return False\n\n    return SpecialFilter().apply(nums).count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/145": [{"task_id": "HumanEval/145", "solution": "class IntegerElement:\n    \"\"\"Represents an integer with its computed digit sum and original index.\"\"\"\n    def __init__(self, value: int, originalIndex: int):\n        self.value = value\n        self.originalIndex = originalIndex\n        self.digitSum = self.computeDigitSum()\n\n    def computeDigitSum(self) -> int:\n        \"\"\"Computes the sum of the decimal digits of the absolute value.\"\"\"\n        s = str(abs(self.value))\n        current_sum = 0\n        for digit_char in s:\n            current_sum += int(digit_char)\n        return current_sum\nclass InputList:\n    \"\"\"Builds and holds IntegerElement instances from a list of numbers.\"\"\"\n    def __init__(self, nums: list):\n        self.elements = []\n        for i, num in enumerate(nums):\n            self.elements.append(IntegerElement(num, i))\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\nclass OutputList:\n    \"\"\"Holds sorted IntegerElement instances and provides conversion to a plain list.\"\"\"\n    def __init__(self, elements: list[IntegerElement]):\n        self.elements = elements\n\n    def to_list(self) -> list[int]:\n        \"\"\"Converts the list of IntegerElement objects to a list of their original integer values.\"\"\"\n        return [e.value for e in self.elements]\nclass Sorter:\n    \"\"\"Implements stable sorting logic by digit sum with original index as tie-breaker.\"\"\"\n    def orderByPoints(self, input_list: InputList) -> OutputList:\n        \"\"\"Sorts IntegerElement instances based on digit sum and original index.\"\"\"\n        sorted_elements = sorted(input_list.elements, key=lambda e: (e.digitSum, e.originalIndex))\n        return OutputList(sorted_elements)\ndef order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers in ascending order by the sum of their digits.\n    Ties are broken by the original index of the elements.\n    \"\"\"\n    if not nums:\n        return []\n\n    input_list = InputList(nums)\n    sorter = Sorter()\n    output_list = sorter.orderByPoints(input_list)\n    return output_list.to_list()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[-5, -12, 9, 15]]]}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) from an array a where a[x] = x*x - x + 1,\n    such that i < j < k and their sum is a multiple of 3.\n    Returns 0 if n is less than 3.\n    \"\"\"\n    \n    class Validator:\n        \"\"\"Validates if an input is a positive integer.\"\"\"\n        def validate(self, n_val) -> bool:\n            return self.isInteger(n_val) and self.isPositive(n_val)\n\n        def isInteger(self, n_val) -> bool:\n            return isinstance(n_val, int)\n\n        def isPositive(self, n_val) -> bool:\n            return n_val > 0\n\n    class ArrayGenerator:\n        \"\"\"Generates the array 'a' based on the given formula.\"\"\"\n        def generate(self, n_gen) -> list:\n            arr = []\n            for i in range(1, n_gen + 1):\n                arr.append(self.formula(i))\n            return arr\n\n        def formula(self, i_form) -> int:\n            return i_form * i_form - i_form + 1\n\n    class TripleCounter:\n        \"\"\"Counts valid triples where the sum is a multiple of 3.\"\"\"\n        def _combinations(self, n_comb, k_comb):\n            # Calculates combinations (n_comb choose k_comb).\n            if k_comb < 0 or k_comb > n_comb:\n                return 0\n            if k_comb == 0 or k_comb == n_comb:\n                return 1\n            if k_comb > n_comb // 2:\n                k_comb = n_comb - k_comb\n            \n            res = 1\n            for i in range(k_comb):\n                res = res * (n_comb - i) // (i + 1)\n            return res\n\n        def countTriples(self, arr_tc: list) -> int:\n            # Counts elements by their residue modulo 3 for efficient calculation.\n            counts = [0, 0, 0] \n            for x in arr_tc:\n                counts[x % 3] += 1\n            \n            c0, c1, c2 = counts[0], counts[1], counts[2]\n            \n            # Sum of three numbers is a multiple of 3 if:\n            # (0,0,0), (1,1,1), (2,2,2), or (0,1,2) modulo 3.\n            total_triples = self._combinations(c0, 3) + \\\n                            self._combinations(c1, 3) + \\\n                            self._combinations(c2, 3) + \\\n                            (c0 * c1 * c2)\n            return total_triples\n\n        def isSumDivisibleBy3(self, val1: int, val2: int, val3: int) -> bool:\n            return (val1 + val2 + val3) % 3 == 0\n\n    class Result:\n        \"\"\"Encapsulates the final count value.\"\"\"\n        def __init__(self, count_res: int):\n            self.count = count_res\n\n        def get(self) -> int:\n            return self.count\n\n    # Orchestration logic\n    validator = Validator()\n    if not validator.validate(n):\n        raise ValueError(\"n must be a positive integer\")\n\n    if n < 3:\n        return 0\n    \n    arr = ArrayGenerator().generate(n)\n    count = TripleCounter().countTriples(arr)\n    \n    return Result(count).get()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/15": [{"task_id": "HumanEval/15", "solution": "class SequenceString:\n    \"\"\"Encapsulates a generated sequence string.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the number of characters in the sequence string.\"\"\"\n        return len(self.value)\ndef generate_sequence(n: int) -> SequenceString:\n    \"\"\"Composes numbers from 0 to n into a space-delimited string.\"\"\"\n    numbers = [str(i) for i in range(n + 1)]\n    sequence_str = \" \".join(numbers)\n    return SequenceString(sequence_str)\ndef string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    sequence_object = generate_sequence(n)\n    return sequence_object.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "class Planet:\n    \"\"\"Immutable data holder representing a planet and its order from the Sun.\"\"\"\n    def __init__(self, name: str, orderFromSun: int):\n        self.name = name\n        self.orderFromSun = orderFromSun\nclass PlanetRepository:\n    \"\"\"Encapsulates canonical planet data and provides validation and query methods.\"\"\"\n    def __init__(self):\n        # Canonical list of planets, ordered by proximity to the Sun\n        self.planets = [\n            Planet('Mercury', 1),\n            Planet('Venus', 2),\n            Planet('Earth', 3),\n            Planet('Mars', 4),\n            Planet('Jupiter', 5),\n            Planet('Saturn', 6),\n            Planet('Uranus', 7),\n            Planet('Neptune', 8),\n        ]\n        # Internal mapping for fast name lookup\n        self._name_to_order = {p.name: p.orderFromSun for p in self.planets}\n\n    def isValidName(self, name: str) -> bool:\n        \"\"\"Checks if the given name is a valid canonical planet name.\"\"\"\n        return name in self._name_to_order\n\n    def getOrder(self, name: str) -> int:\n        \"\"\"Returns the order from the Sun for a given planet name.\"\"\"\n        return self._name_to_order[name]\n\n    def getBetween(self, nameA: str, nameB: str) -> list[Planet]:\n        \"\"\"\n        Returns a list of Planet instances whose orbit is strictly between\n        the orbits of nameA and nameB, sorted by proximity to the Sun.\n        \"\"\"\n        orderA = self.getOrder(nameA)\n        orderB = self.getOrder(nameB)\n\n        min_order = min(orderA, orderB)\n        max_order = max(orderA, orderB)\n\n        between_planets = [\n            p for p in self.planets\n            if min_order < p.orderFromSun < max_order\n        ]\n        return between_planets\nclass BFService:\n    \"\"\"Implements business rules and use-case logic for computing planets between two given planets.\"\"\"\n    def __init__(self, repository: PlanetRepository):\n        self.repository = repository\n\n    def bf(self, planet1: str, planet2: str) -> tuple:\n        \"\"\"\n        Returns a tuple of planet names whose orbits are strictly between\n        planet1 and planet2, sorted by proximity to the Sun.\n        \"\"\"\n        # Validate input names\n        if not self.repository.isValidName(planet1) or \\\n           not self.repository.isValidName(planet2):\n            return ()\n\n        # Handle identical planet names\n        if planet1 == planet2:\n            return ()\n\n        # Get planets strictly between the two input planets\n        between_planets = self.repository.getBetween(planet1, planet2)\n\n        # Extract names and convert to tuple\n        return tuple(p.name for p in between_planets)\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    # Instantiate the repository and service to handle the request.\n    repository = PlanetRepository()\n    service = BFService(repository)\n\n    return service.bf(planet1, planet2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/150": [{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    import math\n\n    def _is_prime(num):\n        \"\"\"Checks if a number is prime. Returns True if prime, False otherwise.\"\"\"\n        if num <= 1:\n            return False\n        for i in range(2, int(math.sqrt(num)) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    if _is_prime(n):\n        return x\n    else:\n        return y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/149": [{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Write a function that accepts a list of strings as a parameter,\n    deletes the strings that have odd lengths from it,\n    and returns the resulted list with a sorted order,\n    The list is always a list of strings and never an array of numbers,\n    and it may contain duplicates.\n    The order of the list should be ascending by length of each word, and you\n    should return the list sorted by that rule.\n    If two words have the same length, sort the list alphabetically.\n    The function should return a list of strings in sorted order.\n    You may assume that all words will have the same length.\n    For example:\n    assert list_sort([\"aa\", \"a\", \"aaa\"]) => [\"aa\"]\n    assert list_sort([\"ab\", \"a\", \"aaa\", \"cd\"]) => [\"ab\", \"cd\"]\n    \"\"\"\n    from typing import List\n\n    class InputList:\n        \"\"\"Encapsulates and validates the input list.\"\"\"\n        def __init__(self, items: List[str]) -> None:\n            self._items = items\n\n        def validate(self) -> bool:\n            \"\"\"Checks if the input is a list of strings, raising TypeError if not.\"\"\"\n            if not isinstance(self._items, list):\n                raise TypeError(\"Input must be a list.\")\n            for item in self._items:\n                if not isinstance(item, str):\n                    raise TypeError(\"All elements in the list must be strings.\")\n            return True\n\n        def get_items(self) -> List[str]:\n            \"\"\"Returns a shallow copy of the input list items.\"\"\"\n            return list(self._items)\n\n    class StringItem:\n        \"\"\"Wrapper for a string with convenience methods for length.\"\"\"\n        def __init__(self, value: str) -> None:\n            self._value = value\n\n        def length(self) -> int:\n            \"\"\"Returns the length of the string.\"\"\"\n            return len(self._value)\n\n        def is_even_length(self) -> bool:\n            \"\"\"Checks if the string has an even length.\"\"\"\n            return self.length() % 2 == 0\n\n    class FilterOperation:\n        \"\"\"Stateless service to filter strings based on length.\"\"\"\n        @staticmethod\n        def filter_even(strings: List[str]) -> List[str]:\n            \"\"\"Filters out strings with odd lengths, preserving duplicates and order.\"\"\"\n            return [s for s in strings if StringItem(s).is_even_length()]\n\n    class SortOperation:\n        \"\"\"Stateless service to sort strings.\"\"\"\n        @staticmethod\n        def sort_by_length_then_alpha(strings: List[str]) -> List[str]:\n            \"\"\"Sorts strings by length ascending, then alphabetically ascending.\"\"\"\n            return sorted(strings, key=lambda s: (len(s), s))\n\n    class ResultList:\n        \"\"\"Accumulator for the final list of results.\"\"\"\n        def __init__(self) -> None:\n            self._items: List[str] = []\n\n        def add(self, item: str) -> None:\n            \"\"\"Adds an item to the result list.\"\"\"\n            self._items.append(item)\n            \n        def add_all(self, items: List[str]) -> None:\n            \"\"\"Adds multiple items to the result list.\"\"\"\n            self._items.extend(items)\n\n        def as_list(self) -> List[str]:\n            \"\"\"Returns a shallow copy of the accumulated list.\"\"\"\n            return list(self._items)\n\n    # Orchestration logic\n    inp = InputList(lst)\n    # The SRS and design context assumes that the input `lst` is always a list of strings.\n    # The validate method is included in the design, but per the requirements,\n    # \"DO NOT add isinstance() checks or raise exceptions for edge cases\" in the final\n    # code that directly relates to input validation for the main function.\n    # Therefore, the explicit call to inp.validate() is commented out to adhere strictly\n    # to the completion constraints that prohibit adding new isinstance() checks or\n    # raising exceptions for general edge cases in the top-level function,\n    # relying instead on the problem statement's assumption of valid input.\n    # inp.validate()\n\n    items = inp.get_items()\n    filtered = FilterOperation.filter_even(items)\n    sorted_items = SortOperation.sort_by_length_then_alpha(filtered)\n\n    result = ResultList()\n    result.add_all(sorted_items)\n    return result.as_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/142": [{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n\n    class InputList:\n        \"\"\"Adapts a raw list to provide length and indexed access.\"\"\"\n        def __init__(self, elements):\n            self._elements = elements\n\n        def length(self):\n            return len(self._elements)\n\n        def get(self, index):\n            return self._elements[index]\n\n    class Result:\n        \"\"\"Accumulates the sum of transformed values.\"\"\"\n        def __init__(self, initial=0):\n            self.sum = initial\n\n        def add(self, value):\n            self.sum += value\n\n        def value(self):\n            return self.sum\n\n    class TransformationRule:\n        \"\"\"Abstract base class for defining transformation rules.\"\"\"\n        def __init__(self, name):\n            self.name = name\n\n        def applies_to_index(self, index):\n            raise NotImplementedError\n\n        def apply(self, value):\n            raise NotImplementedError\n\n    class SquareRule(TransformationRule):\n        \"\"\"Squares the value if the index is a multiple of 3.\"\"\"\n        def __init__(self):\n            super().__init__('square')\n\n        def applies_to_index(self, index):\n            return index % 3 == 0\n\n        def apply(self, value):\n            return value ** 2\n\n    class CubeRule(TransformationRule):\n        \"\"\"Cubes the value if the index is a multiple of 4 but not 3.\"\"\"\n        def __init__(self):\n            super().__init__('cube')\n\n        def applies_to_index(self, index):\n            return index % 4 == 0 and index % 3 != 0\n\n        def apply(self, value):\n            return value ** 3\n\n    class Processor:\n        \"\"\"Orchestrates rule application and sum computation.\"\"\"\n        def __init__(self, rules=None):\n            if rules is None:\n                # SquareRule precedes CubeRule to enforce precedence\n                self.rules = [SquareRule(), CubeRule()]\n            else:\n                self.rules = rules\n\n        def _select_rule_for_index(self, index):\n            \"\"\"Selects the first applicable rule for a given index.\"\"\"\n            for rule in self.rules:\n                if rule.applies_to_index(index):\n                    return rule\n            return None\n\n        def computeSum(self, input_list: InputList):\n            \"\"\"Iterates through the input list, applies rules, and returns the total sum.\"\"\"\n            result = Result(0)\n            for i in range(input_list.length()):\n                value = input_list.get(i)\n                rule = self._select_rule_for_index(i)\n                \n                transformed_value = value\n                if rule is not None:\n                    transformed_value = rule.apply(value)\n                \n                result.add(transformed_value)\n            return result.value()\n\n    # Public entry point logic: adapt input, process, and return sum.\n    input_list = InputList(lst)\n    processor = Processor()\n    return processor.computeSum(input_list)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/152": [{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"I think we all remember that feeling when the result of some long-awaited\n    event is finally known. The feelings and thoughts you have at that moment are\n    definitely worth noting down and comparing.\n    Your task is to determine if a person correctly guessed the results of a number of matches.\n    You are given two arrays of scores and guesses of equal length, where each index shows a match. \n    Return an array of the same length denoting how far off each guess was. If they have guessed correctly,\n    the value is 0, and if not, the value is the absolute difference between the guess and the score.\n    \n    \n    example:\n\n    compare([1,2,3,4,5,1],[1,2,3,4,2,-2]) -> [0,0,0,0,3,3]\n    compare([0,5,0,0,0,4],[4,1,1,0,0,-2]) -> [4,4,1,0,0,6]\n    \"\"\"\n    if len(game) != len(guess):\n        raise Exception(\"Input lists 'game' and 'guess' must have equal length.\")\n    \n    results = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            results.append(0)\n        else:\n            results.append(abs(game[i] - guess[i]))\n            \n    return results", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "class CycPatternChecker:\n    def generate_rotations(self, b: str) -> list[str]:\n        \"\"\"Produces distinct cyclic rotations of string b.\"\"\"\n        if not b:\n            return [\"\"]\n\n        rotations = set()\n        current_rotation = b\n        for _ in range(len(b)):\n            rotations.add(current_rotation)\n            current_rotation = current_rotation[1:] + current_rotation[0]\n            if current_rotation == b:\n                break\n        return list(rotations)\n\n    def is_substring(self, haystack: str, needle: str) -> bool:\n        \"\"\"Checks if needle is a substring of haystack.\"\"\"\n        return needle in haystack\n\n    def cycpattern_check(self, a: str, b: str) -> bool:\n        \"\"\"Checks if b or any of its rotations is a substring in a.\"\"\"\n        rotations = self.generate_rotations(b)\n        for rot in rotations:\n            if self.is_substring(a, rot):\n                return True\n        return False\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    checker = CycPatternChecker()\n    return checker.cycpattern_check(a, b)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/83": [{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    else:\n        # For n >= 2, the count is derived from the inclusion-exclusion principle.\n        # It simplifies to 18 * 10^(n-2).\n        return 18 * (10**(n - 2))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "class IntegerNumber:\n    def __init__(self, value: int):\n        self.value = value\n\n    def getAbsoluteValue(self) -> int:\n        return abs(self.value)\nclass Digit:\n    def __init__(self, value: int, position: int):\n        self.value = value\n        self.position = position\n\n    def isEven(self) -> bool:\n        return self.value % 2 == 0\nclass Result:\n    def __init__(self, even_count: int, odd_count: int):\n        self.even_count = even_count\n        self.odd_count = odd_count\nclass EvenOddCounter:\n    def countDigits(self, num_obj: IntegerNumber) -> tuple[int, int]:\n        abs_value = num_obj.getAbsoluteValue()\n\n        if abs_value == 0:\n            return (1, 0)\n\n        even_count = 0\n        odd_count = 0\n\n        digits_list = self.extractDigits(num_obj)\n\n        for digit_obj in digits_list:\n            if self.classifyDigit(digit_obj): # calls d.isEven() internally\n                even_count += 1\n            else:\n                odd_count += 1\n        \n        # As per design, EvenOddCounter produces a Result object internally\n        _ = Result(even_count, odd_count) \n        return (even_count, odd_count)\n\n    def extractDigits(self, num_obj: IntegerNumber) -> list[Digit]:\n        digits_list = []\n        val = num_obj.getAbsoluteValue()\n        \n        if val == 0: # This case is mostly handled by countDigits, but ensures robustness for direct calls.\n            digits_list.append(Digit(0, 0))\n        else:\n            position = 0\n            while val > 0:\n                digit_value = val % 10\n                digits_list.append(Digit(digit_value, position))\n                val //= 10\n                position += 1\n            # The order of digits doesn't affect the count, so no need to reverse.\n        return digits_list\n\n    def classifyDigit(self, d: Digit) -> bool:\n        return d.isEven()\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    integer_number_obj = IntegerNumber(num)\n    counter_instance = EvenOddCounter()\n    result_tuple = counter_instance.countDigits(integer_number_obj)\n    return result_tuple", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/156": [{"task_id": "HumanEval/156", "solution": "class ConversionRuleSet:\n    \"\"\"Manages Roman numeral conversion rules and applies them.\"\"\"\n    def __init__(self):\n        self.mappings = {\n            1000: 'm', 900: 'cm', 500: 'd', 400: 'cd',\n            100: 'c', 90: 'xc', 50: 'l', 40: 'xl',\n            10: 'x', 9: 'ix', 5: 'v', 4: 'iv', 1: 'i'\n        }\n\n    def apply_rules(self, number):\n        \"\"\"Converts an integer to its lowercase Roman numeral string.\"\"\"\n        roman_numeral = []\n        for value, symbol in self.mappings.items():\n            while number >= value:\n                roman_numeral.append(symbol)\n                number -= value\n        return \"\".join(roman_numeral)\nclass Converter:\n    \"\"\"Orchestrates the conversion of an integer to a Roman numeral.\"\"\"\n    def __init__(self, rules: ConversionRuleSet = None):\n        self._rules = rules or ConversionRuleSet()\n\n    def int_to_mini_roman(self, number: int) -> str:\n        \"\"\"Converts a validated integer to its lowercase Roman numeral.\"\"\"\n        return self._apply_rules(number)\n\n    def _apply_rules(self, number: int) -> str:\n        \"\"\"Applies conversion rules using the ConversionRuleSet.\"\"\"\n        return self._rules.apply_rules(number)\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    validate_type(number)\n    validate_range(number)\n    return Converter().int_to_mini_roman(number)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[19]], "plus_fail_tests": [[111]]}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n\n    class InputList:\n        \"\"\"Encapsulates input list and performs validation.\"\"\"\n        def __init__(self, words_input):\n            self.words = words_input\n\n        def validate(self):\n            \"\"\"Validates the input list according to design rules.\"\"\"\n            if not isinstance(self.words, list):\n                raise ValueError(\"Input must be a list.\")\n            if not self.words:\n                raise ValueError(\"Input list cannot be empty.\")\n            if not all(isinstance(w, str) for w in self.words):\n                raise ValueError(\"All elements in the list must be strings.\")\n            if len(self.words) != len(set(self.words)):\n                raise ValueError(\"Input list contains duplicate words.\")\n\n    class Word:\n        \"\"\"Represents a single string with its unique character count.\"\"\"\n        def __init__(self, value: str):\n            self.value = value\n            self.uniqueCharCount = 0\n\n        def computeUniqueChars(self, counter):\n            \"\"\"Computes and stores the unique character count.\"\"\"\n            self.uniqueCharCount = counter.countUniqueChars(self.value)\n\n    class UniqueCharCounter:\n        \"\"\"Stateless service for counting unique characters.\"\"\"\n        def countUniqueChars(self, s: str) -> int:\n            \"\"\"Returns the number of distinct characters in a string.\"\"\"\n            return len(set(s))\n\n    class Comparator:\n        \"\"\"Stateless service to select and tie-break words.\"\"\"\n        def selectMaxByUniqueChars(self, words_list):\n            \"\"\"Finds the word(s) with the maximum unique character count.\"\"\"\n            if not words_list:\n                return None # Should not happen due to InputList validation\n\n            max_unique_count = -1\n            for word_obj in words_list:\n                if word_obj.uniqueCharCount > max_unique_count:\n                    max_unique_count = word_obj.uniqueCharCount\n            \n            tied_words = [word_obj for word_obj in words_list if word_obj.uniqueCharCount == max_unique_count]\n            \n            if len(tied_words) == 1:\n                return tied_words[0]\n            else:\n                return self.breakTieLexicographically(tied_words)\n\n        def breakTieLexicographically(self, tiedWords_list):\n            \"\"\"Returns the word with the lexicographically smallest value.\"\"\"\n            return min(tiedWords_list, key=lambda w: w.value)\n\n    class Result:\n        \"\"\"Value object to hold the selected word and its count.\"\"\"\n        def __init__(self, selectedValue: str, selectedUniqueCharCount: int):\n            self.selectedValue = selectedValue\n            self.selectedUniqueCharCount = selectedUniqueCharCount\n\n    # Orchestration logic as per design\n    input_list = InputList(words)\n    input_list.validate()\n\n    word_objects = [Word(v) for v in input_list.words]\n    \n    char_counter = UniqueCharCounter()\n    for word_obj in word_objects:\n        word_obj.computeUniqueChars(char_counter)\n\n    word_comparator = Comparator()\n    winner_word = word_comparator.selectMaxByUniqueChars(word_objects)\n\n    final_result = Result(winner_word.value, winner_word.uniqueCharCount)\n    return final_result.selectedValue", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[["play", "play", "play"]]], "plus_fail_tests": [[["aaa", "bbb", "ccc", "aaa"]]]}], "HumanEval/151": [{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0  \n   \n    If the input list is empty, return 0.\n    '''\n    from typing import List, Any\n\n    class NumberItem:\n        def __init__(self, value: Any) -> None:\n            self.value = value\n\n        def isInteger(self) -> bool:\n            # Returns True only when value is of Python int type.\n            return isinstance(self.value, int)\n\n        def isNonNegative(self) -> bool:\n            # True if value is numeric and value >= 0.\n            try:\n                return self.value >= 0\n            except TypeError:\n                return False\n\n        def isOdd(self) -> bool:\n            # True when isInteger() and isNonNegative() and (int(value) % 2 != 0).\n            return self.isInteger() and self.isNonNegative() and (self.value % 2 != 0)\n\n        def square(self) -> int:\n            # Returns int(value) * int(value); caller must ensure qualification.\n            return self.value * self.value\n\n    class InputList:\n        def __init__(self, items: List[Any]) -> None:\n            self.items = items\n\n        def validate(self) -> List[NumberItem]:\n            # Iterate self.items and return a list of NumberItem(value) instances (no filtering).\n            return [NumberItem(item) for item in self.items]\n\n    class Calculator:\n        def __init__(self) -> None:\n            pass\n\n        def filterItems(self, items: List[NumberItem]) -> List[NumberItem]:\n            # Filters out negatives and non-integers, keeping items that are integer and non-negative.\n            return [item for item in items if item.isInteger() and item.isNonNegative()]\n\n        def computeSquares(self, items: List[NumberItem]) -> List[int]:\n            # For each item, if item.isOdd() is True, compute item.square() and return a list of squares.\n            squares = []\n            for item in items:\n                if item.isOdd():\n                    squares.append(item.square())\n            return squares\n\n        def sumSquares(self, squares: List[int]) -> int:\n            # Sum integers in the squares list, returning 0 if the list is empty.\n            return sum(squares)\n\n    class Result:\n        def __init__(self, sum_val: int) -> None:\n            self.sum = sum_val\n\n    # Orchestration logic as per design\n    input_list_instance = InputList(items=lst)\n    number_items = input_list_instance.validate()\n    \n    calculator = Calculator()\n    \n    filtered_items = calculator.filterItems(number_items)\n    squares = calculator.computeSquares(filtered_items)\n    total = calculator.sumSquares(squares)\n    \n    return total", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    '''\n\n    class InputValidator:\n        \"\"\"Utility for validating input values.\"\"\"\n        def validate_numeric(self, s1, s2, s3) -> bool:\n            return all(isinstance(s, (int, float)) for s in [s1, s2, s3])\n\n        def validate_positive(self, s1, s2, s3) -> bool:\n            return all(s > 0 for s in [s1, s2, s3])\n\n    class GeometryRules:\n        \"\"\"Encapsulates geometric rules for triangles.\"\"\"\n        def satisfies_triangle_inequality(self, s1, s2, s3) -> bool:\n            return (s1 + s2 > s3) and (s1 + s3 > s2) and (s2 + s3 > s1)\n\n        def pythagorean_holds(self, h, x, y) -> bool:\n            return h * h == x * x + y * y\n\n    class Triangle:\n        \"\"\"Represents a triangle with side lengths.\"\"\"\n        def __init__(self, s1: float, s2: float, s3: float):\n            self.a = s1\n            self.b = s2\n            self.c = s3\n            self._sorted_sides = sorted([s1, s2, s3])\n\n        def is_valid(self) -> bool:\n            return GeometryRules().satisfies_triangle_inequality(self.a, self.b, self.c)\n\n        def largest_side(self) -> float:\n            return self._sorted_sides[2]\n\n        def other_sides(self) -> tuple[float, float]:\n            return (self._sorted_sides[0], self._sorted_sides[1])\n\n        def is_right_angled(self) -> bool:\n            if not self.is_valid():\n                return False\n            h = self.largest_side()\n            x, y = self.other_sides()\n            return GeometryRules().pythagorean_holds(h, x, y)\n\n    # Orchestration of validation and checks\n    validator = InputValidator()\n    if not validator.validate_numeric(a, b, c):\n        return False\n    if not validator.validate_positive(a, b, c):\n        return False\n\n    triangle = Triangle(a, b, c)\n    if not triangle.is_valid():\n        return False\n\n    hypotenuse = triangle.largest_side()\n    side1, side2 = triangle.other_sides()\n\n    rules = GeometryRules()\n    return rules.pythagorean_holds(hypotenuse, side1, side2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/103": [{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"You are given two positive integers n and m, and your task is to compute the\n    average of the integers from n through m (including n and m). \n    Round the answer to the nearest integer and convert that to binary.\n    If n is greater than m, return -1.\n    Example:\n    rounded_avg(1, 5) => \"0b11\"\n    rounded_avg(7, 5) => -1\n    rounded_avg(10, 20) => \"0b1111\"\n    rounded_avg(20, 33) => \"0b11010\"\n    \"\"\"\n\n    # Helper classes defined inline as per design context and constraints.\n    class InputParameters:\n        def __init__(self, n_val: int, m_val: int):\n            self.n = n_val\n            self.m = m_val\n\n        def validate(self) -> bool:\n            # Checks if n is less than or equal to m, returning False if n > m.\n            return self.n <= self.m\n\n    class RangeSequence:\n        def generate(self, n_val: int, m_val: int) -> list[int]:\n            # Generates the sequence of integers from n to m inclusive.\n            return list(range(n_val, m_val + 1))\n\n    class AverageComputation:\n        def compute(self, sequence: list[int]) -> float:\n            # Computes the arithmetic mean using the O(1) formula (first + last) / 2.\n            if not sequence:\n                return 0.0 # Should not occur under problem constraints n <= m.\n            n_seq = sequence[0]\n            m_seq = sequence[-1]\n            return (n_seq + m_seq) / 2.0\n\n    class RoundingStrategy:\n        def round(self, value: float) -> int:\n            # Rounds a float to the nearest integer using banker's rounding.\n            return int(round(value))\n\n    class BinaryFormatter:\n        def format(self, value: int) -> str:\n            # Formats an integer into a '0b' prefixed binary string.\n            return bin(value)\n\n    # Orchestration logic from the design.\n    params = InputParameters(n, m)\n    \n    # If n > m, return -1 as specified by the problem.\n    if not params.validate():\n        return -1\n    \n    # Proceed with computation if n <= m.\n    seq = RangeSequence().generate(params.n, params.m)\n    mean = AverageComputation().compute(seq)\n    rounded = RoundingStrategy().round(mean)\n    return BinaryFormatter().format(rounded)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \"\"\"\n\n    # Private helper for input validation as per design context.\n    def _validate_inputs(number, need, remaining):\n        if not all(isinstance(x, int) for x in (number, need, remaining)):\n            raise ValueError(\"Inputs must be integers\")\n        if not all(0 <= x <= 1000 for x in (number, need, remaining)):\n            raise ValueError(\"Inputs must be in range 0..1000\")\n\n    # Domain classes as specified in the design context.\n    class MealRequirement:\n        def __init__(self, need: int):\n            self.need = need\n\n    class CarrotStock:\n        def __init__(self, remaining: int):\n            self.remaining = remaining\n        def remove(self, qty: int) -> int:\n            removed = min(qty, self.remaining)\n            self.remaining -= removed\n            return removed\n\n    class ConsumptionResult:\n        def __init__(self, totalEaten: int, remainingAfter: int):\n            self.totalEaten = totalEaten\n            self.remainingAfter = remainingAfter\n\n    class Rabbit:\n        def __init__(self, numberEaten: int):\n            self.numberEaten = numberEaten\n        def eat(self, req: MealRequirement, stock: CarrotStock) -> ConsumptionResult:\n            eaten_now = min(req.need, stock.remaining)\n            stock.remove(eaten_now)\n            totalEaten = self.numberEaten + eaten_now\n            return ConsumptionResult(totalEaten, stock.remaining)\n\n    _validate_inputs(number, need, remaining)\n    \n    req = MealRequirement(need)\n    stock = CarrotStock(remaining)\n    rabbit = Rabbit(number)\n    \n    result = rabbit.eat(req, stock)\n    \n    return [result.totalEaten, result.remainingAfter]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/162": [{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    \n    data = text.encode('utf-8')\n    md5_hash = hashlib.md5(data).hexdigest()\n    return md5_hash", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "class ValidationError(Exception):\n    \"\"\"Base class for validation failures.\"\"\"\n    pass\nclass UnsupportedOperatorError(ValidationError):\n    \"\"\"Raised when an unsupported operator is encountered.\"\"\"\n    def __init__(self, message, operator):\n        super().__init__(message)\n        self.operator = operator\nclass DivisionByZeroError(ValidationError):\n    \"\"\"Raised when floor division by zero is attempted.\"\"\"\n    def __init__(self, message, context=\"\"):\n        super().__init__(message)\n        self.context = context\nclass Token:\n    \"\"\"Represents a token (number or operator) for evaluation.\"\"\"\n    def __init__(self, type_str, value):\n        self.type = type_str\n        self.value = value\nclass OperatorList:\n    \"\"\"Manages and validates a list of algebraic operators.\"\"\"\n    SUPPORTED_OPERATORS = {'+', '-', '*', '//', '**'}\n\n    def __init__(self, operators):\n        self.operators = operators\n\n    def validateLength(self, operands_list):\n        \"\"\"Ensures operator list length is operand list length minus one.\"\"\"\n        if not (len(self.operators) == len(operands_list.operands) - 1):\n            raise ValidationError(\n                f\"Operator list length ({len(self.operators)}) must be one less than operand list length ({len(operands_list.operands)}).\"\n            )\n\n    def validateOperators(self):\n        \"\"\"Ensures all operators are supported.\"\"\"\n        for op in self.operators:\n            if op not in self.SUPPORTED_OPERATORS:\n                raise UnsupportedOperatorError(f\"Unsupported operator: '{op}'.\", op)\nclass OperandList:\n    \"\"\"Manages and validates a list of integer operands.\"\"\"\n    def __init__(self, operands):\n        self.operands = operands\n\n    def validateCount(self):\n        \"\"\"Ensures operand list length is at least two and contains non-negative integers.\"\"\"\n        if len(self.operands) < 2:\n            raise ValidationError(\"Operand list must contain at least two operands.\")\n        for i, val in enumerate(self.operands):\n            if not isinstance(val, int) or val < 0:\n                raise ValidationError(f\"Operand at index {i} is not a non-negative integer: {val}.\")\nclass Expression:\n    \"\"\"Builds and holds the interleaved infix expression string and token list.\"\"\"\n    def __init__(self):\n        self.infix = \"\"\n        self.tokens = []\n\n    def build(self, operands_list, operators_list):\n        \"\"\"Constructs infix string and tokens by interleaving operands and operators.\"\"\"\n        infix_parts = []\n        for i in range(len(operators_list.operators)):\n            self.tokens.append(Token('NUMBER', operands_list.operands[i]))\n            infix_parts.append(str(operands_list.operands[i]))\n            self.tokens.append(Token('OPERATOR', operators_list.operators[i]))\n            infix_parts.append(operators_list.operators[i])\n        self.tokens.append(Token('NUMBER', operands_list.operands[-1]))\n        infix_parts.append(str(operands_list.operands[-1]))\n        self.infix = \" \".join(infix_parts)\nclass Evaluator:\n    \"\"\"Evaluates an expression token list using operator precedence and associativity.\"\"\"\n    OPERATOR_PRECEDENCE = {\n        '+': 1, '-': 1,\n        '*': 2, '//': 2,\n        '**': 3\n    }\n    OPERATOR_ASSOCIATIVITY = {\n        '+': 'left', '-': 'left',\n        '*': 'left', '//': 'left',\n        '**': 'right'\n    }\n\n    def evaluate(self, expr):\n        \"\"\"Public evaluation entry; returns integer result or raises runtime errors.\"\"\"\n        return self._applyPrecedenceAndAssociativity(expr.tokens)\n\n    def _applyPrecedenceAndAssociativity(self, tokens):\n        \"\"\"Converts infix tokens to RPN and evaluates it.\"\"\"\n        output_queue = []\n        operator_stack = []\n\n        for token in tokens:\n            if token.type == 'NUMBER':\n                output_queue.append(token.value)\n            elif token.type == 'OPERATOR':\n                o1 = token.value\n                while (operator_stack and operator_stack[-1] in self.OPERATOR_PRECEDENCE and\n                       (self.OPERATOR_PRECEDENCE[operator_stack[-1]] > self.OPERATOR_PRECEDENCE[o1] or\n                        (self.OPERATOR_PRECEDENCE[operator_stack[-1]] == self.OPERATOR_PRECEDENCE[o1] and\n                         self.OPERATOR_ASSOCIATIVITY[o1] == 'left'))):\n                    output_queue.append(operator_stack.pop())\n                operator_stack.append(o1)\n\n        while operator_stack:\n            output_queue.append(operator_stack.pop())\n\n        # Evaluate RPN\n        operand_stack = []\n        for element in output_queue:\n            if isinstance(element, int):\n                operand_stack.append(element)\n            else: # It's an operator\n                op2 = operand_stack.pop()\n                op1 = operand_stack.pop()\n                result = 0\n                if element == '+':\n                    result = op1 + op2\n                elif element == '-':\n                    result = op1 - op2\n                elif element == '*':\n                    result = op1 * op2\n                elif element == '//':\n                    if op2 == 0:\n                        raise DivisionByZeroError(\"Attempted floor division by zero.\", f\"{op1} // {op2}\")\n                    result = op1 // op2\n                elif element == '**':\n                    result = op1 ** op2\n                operand_stack.append(result)\n\n        return operand_stack[0]\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n    ops = OperatorList(operator)\n    vals = OperandList(operand)\n    \n    vals.validateCount()\n    ops.validateLength(vals)\n    ops.validateOperators()\n    \n    expr = Expression()\n    expr.build(vals, ops)\n    \n    evaluator = Evaluator()\n    result_int = evaluator.evaluate(expr)\n    \n    return result_int", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on CAP-SM strength and formats the result.\n    Helper functions compute strength, select the strongest, and format the output.\n    \"\"\"\n    from dataclasses import dataclass\n\n    @dataclass\n    class Extension:\n        \"\"\"Domain data structure to hold extension details and computed metrics.\"\"\"\n        name: str\n        capCount: int\n        smCount: int\n        strength: int\n        position: int\n\n    @dataclass\n    class Result:\n        \"\"\"Encapsulates the final formatted output string.\"\"\"\n        value: str\n\n    def computeStrength(extension_name, position):\n        \"\"\"\n        Calculates the strength of an extension based on uppercase (CAP) and lowercase (SM) letters.\n        Counts only alphabetic characters, ignoring others.\n        \"\"\"\n        capCount = 0\n        smCount = 0\n        for char in extension_name:\n            if char.isupper():\n                capCount += 1\n            elif char.islower():\n                smCount += 1\n        strength = capCount - smCount\n        return Extension(name=extension_name, capCount=capCount, smCount=smCount, strength=strength, position=position)\n\n    def selectStrongest(extension_records):\n        \"\"\"\n        Selects the extension with the highest strength, using position as a stable tie-breaker.\n        Assumes `extension_records` is not empty, consistent with design examples.\n        \"\"\"\n        strongest_record = extension_records[0]\n        for record in extension_records[1:]:\n            if record.strength > strongest_record.strength:\n                strongest_record = record\n            elif record.strength == strongest_record.strength:\n                # Tie-breaker: choose the one that comes first (smaller position)\n                if record.position < strongest_record.position:\n                    strongest_record = record\n        return strongest_record\n\n    def formatResult(class_name, chosen_extension_name):\n        \"\"\"\n        Formats the final output string as 'ClassName.StrongestExtensionName'.\n        Preserves original casing of both class name and chosen extension.\n        \"\"\"\n        composed_string = f\"{class_name}.{chosen_extension_name}\"\n        return Result(value=composed_string)\n\n    # Orchestration of the main logic\n    extension_records = [computeStrength(name, idx) for idx, name in enumerate(extensions)]\n    chosen = selectStrongest(extension_records)\n    result = formatResult(class_name, chosen.name)\n    return result.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/163": [{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n\n    class Validator:\n        def isInteger(self, x):\n            return isinstance(x, int)\n        def isPositive(self, x):\n            return x > 0\n\n    class ValidationResult:\n        def __init__(self, passed, handler_func=None):\n            self.passed = passed\n            self._handler_func = handler_func\n        def handle(self):\n            # Per BR-10, policy for invalid inputs is undefined.\n            # Returning an empty list is a safe default for a List[int] return type.\n            if self._handler_func:\n                return self._handler_func()\n            return []\n\n    class Input:\n        def __init__(self, a, b):\n            self.a = a\n            self.b = b\n        def validate(self):\n            validator = Validator()\n            # As per docstring and BR-2, inputs a and b must be positive integers.\n            if not (validator.isInteger(self.a) and validator.isInteger(self.b)):\n                return ValidationResult(False)\n            if not (validator.isPositive(self.a) and validator.isPositive(self.b)):\n                return ValidationResult(False)\n            return ValidationResult(True)\n\n    class Range:\n        def __init__(self, min_val, max_val):\n            self.min = min_val\n            self.max = max_val\n        @classmethod\n        def compute(cls, a, b):\n            return cls(min(a, b), max(a, b))\n\n    class EvenDigit:\n        def __init__(self, value):\n            self.value = value\n        def isSingleDigit(self):\n            return 0 <= self.value <= 9\n        def isEven(self):\n            return self.value % 2 == 0\n\n    class DigitFilter:\n        def __init__(self):\n            # allowedDigits is fixed to {0,2,4,6,8} per BR-4 in the design.\n            self.allowedDigits = {0, 2, 4, 6, 8}\n        def filter(self, range_obj):\n            filtered_even_digits = []\n            # Iterate through the fixed set of allowed single-digit even numbers,\n            # ensuring they are processed in ascending order before checking range.\n            for digit_candidate in sorted(list(self.allowedDigits)):\n                if range_obj.min <= digit_candidate <= range_obj.max:\n                    filtered_even_digits.append(EvenDigit(digit_candidate))\n            return filtered_even_digits\n\n    class Result:\n        def __init__(self, digits_list):\n            self.digits = digits_list\n        def sortAscending(self):\n            self.digits.sort()\n        def toList(self):\n            return self.digits\n\n    # Orchestration logic as described in the design context.\n    inp = Input(a, b)\n    validation = inp.validate()\n    if not validation.passed:\n        return validation.handle()\n\n    r = Range.compute(a, b)\n\n    digit_filter = DigitFilter()\n    filtered_even_digits = digit_filter.filter(r)\n\n    # Extract integer values from EvenDigit objects for the final Result.\n    result_values = [d.value for d in filtered_even_digits]\n    result = Result(result_values)\n\n    result.sortAscending()\n\n    return result.toList()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"\n    Transforms the input string s based on its content.\n    If s contains letters, reverses the case of each letter; otherwise, reverses the entire string.\n    \"\"\"\n\n    class InputString:\n        def __init__(self, value: str):\n            self.value = value\n\n        def length(self) -> int:\n            return len(self.value)\n\n        def containsLetter(self) -> bool:\n            return any(char.isalpha() for char in self.value)\n\n    class Character:\n        def __init__(self, char: str):\n            self.char = char\n\n        def isAlphabetic(self) -> bool:\n            return self.char.isalpha()\n\n        def isUpper(self) -> bool:\n            return self.char.isupper()\n\n        def toOppositeCase(self) -> str:\n            if self.isAlphabetic():\n                if self.isUpper():\n                    return self.char.lower()\n                else:\n                    return self.char.upper()\n            return self.char\n\n    class ResultString:\n        def __init__(self, value: str):\n            self.value = value\n\n    class Transformer:\n        def reverseCase(self, s: InputString) -> ResultString:\n            transformed_chars = []\n            for char_val in s.value:\n                char_obj = Character(char_val)\n                transformed_chars.append(char_obj.toOppositeCase())\n            return ResultString(\"\".join(transformed_chars))\n\n        def reverseString(self, s: InputString) -> ResultString:\n            return ResultString(s.value[::-1])\n\n        def transform(self, s: InputString) -> ResultString:\n            if not s.containsLetter():\n                return self.reverseString(s)\n            else:\n                return self.reverseCase(s)\n\n    input_obj = InputString(s)\n    transformer = Transformer()\n    result_obj = transformer.transform(input_obj)\n    return result_obj.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/94": [{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime using trial division.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    def sum_digits(n):\n        \"\"\"Calculates the sum of the decimal digits of a number's absolute value.\"\"\"\n        digit_sum = 0\n        s_n = str(abs(n))\n        for digit_char in s_n:\n            digit_sum += int(digit_char)\n        return digit_sum\n\n    prime_values = []\n    for num in lst:\n        if is_prime(num):\n            prime_values.append(num)\n\n    if not prime_values:\n        # If no primes are found, the sum of digits of the non-existent largest prime is 0.\n        return 0\n\n    largest_prime = max(prime_values)\n    return sum_digits(largest_prime)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    find the minimum path of length k lexicographically.\n    \"\"\"\n\n    class Coordinate:\n        \"\"\"Represents a 0-based (row, col) coordinate in the grid.\"\"\"\n        def __init__(self, row: int, col: int):\n            self.row = row\n            self.col = col\n\n        def __eq__(self, other):\n            if not isinstance(other, Coordinate):\n                return NotImplemented\n            return self.row == other.row and self.col == other.col\n\n        def __hash__(self):\n            return hash((self.row, self.col))\n\n    class Grid:\n        \"\"\"Read-only representation of the N x N grid.\"\"\"\n        def __init__(self, cells: list[list[int]]):\n            # Stores a shallow copy to ensure the input grid is not mutated.\n            self._cells = [row[:] for row in cells] \n            self._N = len(cells)\n\n        def getCell(self, row: int, col: int) -> int:\n            \"\"\"Retrieves the value of a cell at given coordinates.\"\"\"\n            return self._cells[row][col]\n\n        @property\n        def N(self) -> int:\n            \"\"\"Returns the dimension N of the N x N grid.\"\"\"\n            return self._N\n\n    def from_python_grid(grid_list: list[list[int]]) -> Grid:\n        \"\"\"Creates a Grid object from a standard Python list of lists.\"\"\"\n        return Grid(grid_list)\n\n    def lex_compare(a: list[int], b: list[int]) -> int:\n        \"\"\"Compares two lists lexicographically, returning -1 if a < b, 0 if equal, 1 if a > b.\"\"\"\n        min_len = min(len(a), len(b))\n        for i in range(min_len):\n            if a[i] < b[i]:\n                return -1\n            elif a[i] > b[i]:\n                return 1\n        return 0 if len(a) == len(b) else (-1 if len(a) < len(b) else 1)\n\n    def neighbors_of(coord: Coordinate, gridN: int) -> list[Coordinate]:\n        \"\"\"Generates valid neighbor coordinates in deterministic order (up, left, right, down).\"\"\"\n        row, col = coord.row, coord.col\n        possible_neighbors = []\n        if row > 0: possible_neighbors.append(Coordinate(row - 1, col)) # Up\n        if col > 0: possible_neighbors.append(Coordinate(row, col - 1)) # Left\n        if col < gridN - 1: possible_neighbors.append(Coordinate(row, col + 1)) # Right\n        if row < gridN - 1: possible_neighbors.append(Coordinate(row + 1, col)) # Down\n        return possible_neighbors\n\n    class PathFinder:\n        \"\"\"Finds the lexicographically minimal path of length k in the grid.\"\"\"\n        def __init__(self, grid_obj: Grid):\n            self._grid = grid_obj\n            self._gridN = grid_obj.N\n            self._best_values: list[int] | None = None\n\n        def find_min_path(self, k_val: int) -> list[int]:\n            \"\"\"Searches all possible paths of length k and returns the lexicographically smallest.\"\"\"\n            self._best_values = None \n            \n            for r in range(self._gridN):\n                for c in range(self._gridN):\n                    start_coord = Coordinate(r, c)\n                    initial_value = self._grid.getCell(r, c)\n                    self._search_from(start_coord, k_val, [initial_value])\n            \n            return self._best_values\n\n        def _search_from(self, current_coord: Coordinate, target_k: int, current_path_values: list[int]) -> None:\n            \"\"\"Recursively explores paths from a given coordinate, pruning branches that are not optimal.\"\"\"\n            if len(current_path_values) == target_k:\n                self._consider_candidate(current_path_values)\n                return\n\n            # Pruning: if current path prefix is already lexicographically greater than the best path's prefix.\n            if self._best_values is not None:\n                comparison_result = lex_compare(current_path_values, self._best_values[:len(current_path_values)])\n                if comparison_result == 1:\n                    return\n\n            for neighbor_coord in neighbors_of(current_coord, self._gridN):\n                neighbor_value = self._grid.getCell(neighbor_coord.row, neighbor_coord.col)\n                self._search_from(neighbor_coord, target_k, current_path_values + [neighbor_value])\n\n        def _consider_candidate(self, candidate_values: list[int]) -> None:\n            \"\"\"Updates the best path found so far if the candidate is lexicographically smaller.\"\"\"\n            if self._best_values is None or lex_compare(candidate_values, self._best_values) < 0:\n                self._best_values = candidate_values[:] # Store a copy\n\n    # Main logic for minPath function.\n    grid_obj = from_python_grid(grid)\n    finder = PathFinder(grid_obj)\n    return finder.find_min_path(k)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[2, 7, 4], [3, 1, 5], [6, 8, 9]], 20]]}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in\n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8\n    You are given a non-negative integer number n, you have to a return a list of the\n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    from typing import List, Dict\n\n    class SequenceElement:\n        def __init__(self, index: int, value: int):\n            self.index = index\n            self.value = value\n\n    class Sequence:\n        def __init__(self, elements: List[int]):\n            self.elements = elements\n            self.length = len(elements)\n\n        def to_list(self) -> List[int]:\n            return self.elements\n\n    class TriCalculator:\n        def __init__(self):\n            self._cache: Dict[int, int] = {}\n\n        def computeTri(self, k: int) -> int:\n            if k in self._cache:\n                return self._cache[k]\n\n            if k == 1:\n                v = 3\n            elif k % 2 == 0:\n                v = 1 + (k // 2)\n            else:\n                v = self.computeTri(k - 1) + self.computeTri(k - 2) + self.computeTri(k + 1)\n            \n            self._cache[k] = v\n            return v\n\n        def computeSequence(self, n: int) -> List[int]:\n            elements: List[int] = []\n            for k in range(0, n + 1):\n                elements.append(self.computeTri(k))\n            return Sequence(elements).to_list()\n\n    calculator = TriCalculator()\n    return calculator.computeSequence(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}