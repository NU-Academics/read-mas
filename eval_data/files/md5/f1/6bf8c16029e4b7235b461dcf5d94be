y shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    function_instance = CircularShiftFunction(x, shift)\n    result = function_instance.execute()\n    return result.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/66": [{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII codes for uppercase characters in the input string.\n    Ignores non-uppercase ASCII characters.\"\"\"\n    accumulator = 0\n    for c in s:\n        code = ord(c)\n        # Check if the character's ASCII code is within the range for 'A' through 'Z'\n        if 65 <= code <= 90:\n            accumulator += code\n    return accumulator", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/62": [{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    \"\"\"\n    if len(xs) <= 1:\n        return []\n\n    # Calculate derivative coefficients. For a term c*x^i, its derivative is c*i*x^(i-1).\n    # The new coefficients start from x^0 (constant term), which comes from the x^1 term of the original polynomial.\n    derivative_coeffs = []\n    for i in range(1, len(xs)):\n        derivative_coeffs.append(i * xs[i])\n\n    return derivative_coeffs", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/64": [{"task_id": "HumanEval/64", "solution": "class InputString:\n    def __init__(self, value: str):\n        self.value: str = value\n    def is_empty(self) -> bool:\n        return self.value == ''\n    def to_lower(self) -> str:\n        return self.value.lower()\nclass VowelCounter:\n    def __init__(self):\n        self.vowels: set = {'a', 'e', 'i', 'o', 'u'}\n    def count(self, s: InputString) -> int:\n        lower_s = s.to_lower()\n        count = 0\n        \n        for char in lower_s:\n            if char in self.vowels:\n                count += 1\n        \n        if lower_s.endswith('y'):\n            count += 1\n            \n        return count\ndef vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    \"\"\"\n    input_obj = InputString(s)\n    if input_obj.is_empty():\n        return 0\n    counter = VowelCounter()\n    return counter.count(input_obj)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/67": [{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s,n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges \n    that are distributed in a basket of fruit this basket contains \n    apples, oranges, and mango fruits. Given the string that represents the total number of \n    the oranges and apples and an integer that represent the total number of the fruits \n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    from dataclasses import dataclass\n    import re\n\n    @dataclass\n    class FruitCounts:\n        apples: int\n        oranges: int\n\n    def parseInput(s_input: str) -> FruitCounts:\n        \"\"\"Parses the input string to extract apple and orange counts.\"\"\"\n        pattern = r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\"\n        match = re.fullmatch(pattern, s_input.strip())\n\n        if match:\n            apples_count = int(match.group(1))\n            oranges_count = int(match.group(2))\n            return FruitCounts(apples=apples_count, oranges=oranges_count)\n        else:\n            raise ValueError(\"parse error: expected '<apples> apples and <oranges> oranges'\")\n\n    def computeMangoes(total: int, apples: int, oranges: int) -> int:\n        \"\"\"Computes the number of mangoes from total and other fruit counts.\"\"\"\n        return total - apples - oranges\n\n    # Main logic for fruit_distribution\n    counts = parseInput(s)\n    mangoes = computeMangoes(n, counts.apples, counts.oranges)\n    return mangoes", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/70": [{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    \n    # Create a sorted copy of the input list. This allows efficient retrieval\n    # of minimum (from the beginning) and maximum (from the end) elements.\n    working_list = sorted(list(lst))\n    result = []\n\n    while working_list:\n        # Always pick the minimum remaining element first.\n        # Since the list is sorted, the minimum is at index 0.\n        min_val = working_list.pop(0)\n        result.append(min_val)\n\n        # If there are still elements remaining, pick the maximum.\n        # Since the list is sorted, the maximum remaining is at the last index.\n        if working_list:\n            max_val = working_list.pop()\n            result.append(max_val)\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/68": [{"task_id": "HumanEval/68", "solution": "class Node:\n    \"\"\"Represents a node in the tree branch with its value and index.\"\"\"\n    def __init__(self, value: int, index: int):\n        self.value = value\n        self.index = index\nclass Result:\n    \"\"\"Encapsulates the result of the pluck operation, either a value/index pair or an empty state.\"\"\"\n    def __init__(self, value: int = None, index: int = None, isEmpty: bool = False):\n        self.value = value\n        self.index = index\n        self.isEmpty = isEmpty\nclass Branch:\n    \"\"\"Manages a list of nodes and implements the core pluck logic to find the smallest even node.\"\"\"\n    def __init__(self, nodes: list):\n        self.nodes = nodes\n\n    def pluck(self) -> Result:\n        min_value = None\n        min_index = None\n\n        for node in self.nodes:\n            if node.value % 2 == 0:  # Check if the node value is even (0 is even).\n                if min_value is None or node.value < min_value:\n                    min_value = node.value\n                    min_index = node.index\n                elif node.value == min_value:\n                    # If values are equal, retain the smallest index (first occurrence).\n                    # This is implicitly handled as we iterate in order and only update for smaller values.\n                    pass \n\n        if min_value is None:\n            return Result(isEmpty=True)\n        else:\n            return Result(value=min_value, index=min_index)\nclass Validator:\n    \"\"\"Validates the input array's length and element non-negativity.\"\"\"\n    def __init__(self, arr: list, min_length: int = 1, max_length: int = 10000):\n        self._arr = arr\n        self._min_length = min_length\n        self._max_length = max_length\n\n    def validateLength(self) -> bool:\n        \"\"\"Checks if the array length is within the configured bounds.\"\"\"\n        return self._min_length <= len(self._arr) <= self._max_length\n\n    def validateNonNegative(self) -> bool:\n        \"\"\"Ensures all array elements are non-negative integers.\"\"\"\n        return all(isinstance(x, int) and x >= 0 for x in self._arr)\nclass ResultFormatter:\n    \"\"\"Formats a Result object into the specified list output.\"\"\"\n    def format(self, result: Result) -> list:\n        if result.isEmpty:\n            return []\n        else:\n            return [result.value, result.index]\ndef pluck(arr):\n    \"\"\"\n    Given an array representing a branch of a tree, plucks the node with the smallest even value.\n    Returns [value, index] or [] if no even values or an empty/invalid array.\n    \"\"\"\n    validator = Validator(arr, min_length=0) # min_length=0 to handle empty arrays as per Example 3.\n    \n    if not validator.validateLength() or not validator.validateNonNegative():\n        return [] # Return empty list on validation failure.\n\n    nodes = [Node(value, i) for i, value in enumerate(arr)]\n    branch = Branch(nodes)\n    \n    result = branch.pluck()\n    \n    formatter = ResultFormatter()\n    return formatter.format(result)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/69": [{"task_id": "HumanEval/69", "solution": "import collections\nfrom typing import List\nclass IntegerFrequency:\n    \"\"\"Represents an integer and its frequency.\"\"\"\n    def __init__(self, value: int, frequency: int):\n        self.value = value\n        self.frequency = frequency\nclass InputList:\n    \"\"\"Encapsulates the input list and performs initial validation.\"\"\"\n    def __init__(self, values: List[int]):\n        if not values:\n            raise ValueError(\"Input list cannot be empty.\")\n        for item in values:\n            if not isinstance(item, int) or item <= 0:\n                raise ValueError(\"All elements in the list must be positive integers.\")\n        self.values = values\n\n    def isNonEmpty(self) -> bool:\n        \"\"\"Checks if the internal list of values is non-empty.\"\"\"\n        return bool(self.values)\nclass FrequencyCounter:\n    \"\"\"Computes exact frequencies of integers in an InputList.\"\"\"\n    def computeFrequencies(self, input_list: InputList) -> List[IntegerFrequency]:\n        counts = collections.Counter(input_list.values)\n        freq_list = [IntegerFrequency(value, count) for value, count in counts.items()]\n        return freq_list\nclass SearchService:\n    \"\"\"Finds the greatest integer satisfying the frequency condition.\"\"\"\n    def findGreatestQualifyingInteger(self, freqs: List[IntegerFrequency]) -> int:\n        max_eligible_value = -1\n        for freq in freqs:\n            if freq.value > 0 and freq.frequency >= freq.value:\n                if freq.value > max_eligible_value:\n                    max_eligible_value = freq.value\n        return max_eligible_value\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    input_list = InputList(lst)\n    \n    freq_counter = FrequencyCounter()\n    freqs = freq_counter.computeFrequencies(input_list)\n    \n    search_service = SearchService()\n    result_value = search_service.findGreatestQualifyingInteger(freqs)\n    \n    return result_value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/71": [{"task_id": "HumanEval/71", "solution": "from math import sqrt\nclass Triangle:\n    \"\"\"Represents a triangle with side lengths a, b, c and provides area computation.\"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        self.a = a\n        self.b = b\n        self.c = c\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if side lengths are positive and satisfy strict triangle inequality.\"\"\"\n        if not (self.a > 0 and self.b > 0 and self.c > 0):\n            return False\n        if not (self.a + self.b > self.c and\n                self.a + self.c > self.b and\n                self.b + self.c > self.a):\n            return False\n        return True\n\n    def semiperimeter(self) -> float:\n        \"\"\"Calculates the semiperimeter of the triangle.\"\"\"\n        return (self.a + self.b + self.c) / 2\n\n    def area(self) -> float:\n        \"\"\"Calculates the raw area of the triangle using Heron's formula.\"\"\"\n        s = self.semiperimeter()\n        # If is_valid() passes, the term inside sqrt will always be positive.\n        product = s * (s - self.a) * (s - self.b) * (s - self.c)\n        return sqrt(product)\nclass Validator:\n    \"\"\"Validates side lengths for positivity and strict triangle inequalities.\"\"\"\n    def validate_sides(self, a: float, b: float, c: float) -> bool:\n        \"\"\"Checks if the given side lengths form a valid triangle.\"\"\"\n        triangle = Triangle(a, b, c)\n        return triangle.is_valid()\nclass AreaCalculator:\n    \"\"\"Computes the raw area of a triangle using Heron's formula.\"\"\"\n    def compute_area(self, a: float, b: float, c: float) -> float:\n        \"\"\"Calculates the raw area of the triangle.\"\"\"\n        triangle = Triangle(a, b, c)\n        return triangle.area()\nclass Result:\n    \"\"\"Holds the computed value and an error flag for internal orchestration.\"\"\"\n    def __init__(self, value: float, is_error: bool):\n        self.value = value\n        self.is_error = is_error\ndef triangle_area(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    \"\"\"\n    validator = Validator()\n    if not validator.validate_sides(a, b, c):\n        result = Result(value=-1.0, is_error=True)\n        return result.value\n\n    area_calculator = AreaCalculator()\n    raw_area = area_calculator.compute_area(a, b, c)\n    rounded_area = round(raw_area, 2)\n    \n    result = Result(value=rounded_area, is_error=False)\n    return result.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/72": [{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n\n    Example:\n    will_it_fly([1, 2], 5) \u279e False \n    # 1+2 is less than the maximum possible weight, but it's unbalanced.\n\n    will_it_fly([3, 2, 3], 1) \u279e False\n    # it's balanced, but 3+2+3 is more than the maximum possible weight.\n\n    will_it_fly([3, 2, 3], 9) \u279e True\n    # 3+2+3 is less than the maximum possible weight, and it's balanced.\n\n    will_it_fly([3], 5) \u279e True\n    # 3 is less than the maximum possible weight, and it's balanced.\n    '''\n    is_balanced = True\n    left = 0\n    right = len(q) - 1\n    while left < right:\n        if q[left] != q[right]:\n            is_balanced = False\n            break\n        left += 1\n        right -= 1\n\n    total_q_weight = 0\n    for element in q:\n        total_q_weight += element\n\n    return is_balanced and total_q_weight <= w", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/74": [{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    '''\n    Compares two lists of strings based on their total character count and returns the list with fewer characters.\n    If counts are equal, the first list is returned.\n    '''\n    def _compute_total_chars(lst):\n        '''Computes the total number of characters in all strings within a list.'''\n        total = 0\n        for s in lst:\n            total += len(s)\n        return total\n\n    total_chars_lst1 = _compute_total_chars(lst1)\n    total_chars_lst2 = _compute_total_chars(lst2)\n\n    if total_chars_lst1 <= total_chars_lst2:\n        return lst1\n    else:\n        return lst2", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/73": [{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic. A palindromic array is an array that\n    is read the same backwards and forwards. In one change, you can change one element to any other element.\n\n    For example:\n    smallest_change([1,2,3,5,4,7,9,6]) == 4\n    smallest_change([1, 2, 3, 4, 3, 2, 2]) == 1\n    smallest_change([1, 2, 3, 2, 1]) == 0\n    \"\"\"\n    if not isinstance(arr, (list, tuple)):\n        raise ValueError(\"validation error: input must be a sequence (list or tuple)\")\n\n    for element in arr:\n        if not isinstance(element, int):\n            raise ValueError(\"validation error: all elements in the sequence must be integers\")\n\n    n = len(arr)\n    if n <= 1:\n        return 0\n\n    mismatches = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            mismatches += 1\n\n    return mismatches", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/75": [{"task_id": "HumanEval/75", "solution": "import math\nclass IntegerInput:\n    \"\"\"Represents an integer input value with domain validation.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_valid_domain(self) -> bool:\n        \"\"\"Checks if the value is an integer and less than 100.\"\"\"\n        return isinstance(self.value, int) and self.value < 100\nclass PrimeFactorization:\n    \"\"\"Computes and holds the list of prime factors with multiplicity.\"\"\"\n    def __init__(self) -> None:\n        self.factors = []\n\n    def factorize(self, input_obj: IntegerInput) -> None:\n        \"\"\"Computes prime factors of the input value and populates self.factors.\"\"\"\n        num = input_obj.value\n\n        if num < 2:\n            return\n\n        d = 2\n        temp_num = num\n        while d * d <= temp_num:\n            while temp_num % d == 0:\n                self.factors.append(d)\n                temp_num //= d\n            d += 1\n        if temp_num > 1:\n            self.factors.append(temp_num)\n\n    def factorCount(self) -> int:\n        \"\"\"Returns the count of prime factors.\"\"\"\n        return len(self.factors)\nclass IsMultiplyPrimeFunction:\n    \"\"\"Orchestrates validation, factorization, and determines if a number is a product of three primes.\"\"\"\n    def is_multiply_prime(self, input_obj: IntegerInput) -> bool:\n        \"\"\"Determines if the given number is a multiplication of 3 prime numbers.\"\"\"\n        if not input_obj.is_valid_domain():\n            return False\n\n        if input_obj.value < 2:\n            return False\n\n        prime_factorization = PrimeFactorization()\n        prime_factorization.factorize(input_obj)\n\n        return prime_factorization.factorCount() == 3\ndef is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    integer_input = IntegerInput(a)\n    service = IsMultiplyPrimeFunction()\n    return service.is_multiply_prime(integer_input)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/78": [{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts the number of prime hexadecimal digits in a given string.\n    Prime hexadecimal digits are 2, 3, 5, 7, B (11), D (13).\n    \"\"\"\n    PRIME_HEX_DIGITS = {'2', '3', '5', '7', 'B', 'D'}\n\n    # _is_prime_hex_digit is defined as a nested helper function to ensure it's \"inline\"\n    # and satisfies the \"Do NOT call any helper that is not defined inline in your response\" constraint.\n    def _is_prime_hex_digit(ch: str) -> bool:\n        return ch in PRIME_HEX_DIGITS\n\n    count = 0\n    for char_digit in num:\n        if _is_prime_hex_digit(char_digit):\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/77": [{"task_id": "HumanEval/77", "solution": "from typing import Optional\nclass CubeCandidate:\n    \"\"\"Represents a candidate integer 'n' and its cube 'n_cubed'.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n        self.n_cubed = n * n * n # Compute n_cubed during initialization\nclass CheckResult:\n    \"\"\"Holds the boolean result of a cube check.\"\"\"\n    def __init__(self, is_cube: bool) -> None:\n        self.is_cube = is_cube\nclass CubeChecker:\n    \"\"\"Encapsulates the algorithm to check if an integer is a perfect cube.\"\"\"\n    def iscube(self, a) -> bool:\n        \"\"\"\n        Determines if integer 'a' is a perfect cube.\n        Delegates to _integer_cube_root to find and verify the root.\n        \"\"\"\n        root_candidate = self._integer_cube_root(a)\n        result = CheckResult(root_candidate is not None)\n        return result.is_cube\n\n    def _integer_cube_root(self, a) -> Optional[int]:\n        \"\"\"\n        Finds the integer cube root of 'a'.\n        Returns the integer root if 'a' is a perfect cube, otherwise None.\n        Handles negative numbers and zero by checking abs(a) and applying sign.\n        \"\"\"\n        if a == 0:\n            return 0\n\n        sign = 1 if a > 0 else -1\n        abs_a = abs(a)\n\n        # Compute a candidate integer root using floating-point math,\n        # then check it and its immediate neighbors for exact match to avoid inaccuracies.\n        candidate_abs_n = int(round(abs_a**(1/3)))\n\n        # Check candidate_abs_n and its neighbors (-1, 0, +1)\n        for n_offset in [-1, 0, 1]:\n            current_candidate = candidate_abs_n + n_offset\n            # Ensure candidate for abs_a is non-negative\n            if current_candidate < 0:\n                continue\n            \n            # Use CubeCandidate object to verify, as per design\n            cube_check = CubeCandidate(current_candidate)\n            if cube_check.n_cubed == abs_a:\n                return current_candidate * sign # Found the integer cube root, apply original sign\n                \n        return None # No integer cube root found within the checked range\ndef iscube(a):\n    '''\n    Write a function that takes an integer a and returns True \n    if this ingeger is a cube of some integer number.\n    Note: you may assume the input is always valid.\n    Examples:\n    iscube(1) ==> True\n    iscube(2) ==> False\n    iscube(-1) ==> True\n    iscube(64) ==> True\n    iscube(0) ==> True\n    iscube(180) ==> False\n    '''\n    # The module-level function acts as the public API and delegates to CubeChecker.\n    checker = CubeChecker()\n    return checker.iscube(a)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/61": [{"task_id": "HumanEval/61", "solution": "from datetime import datetime\ndef correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n\n    class BracketString:\n        \"\"\"Represents the input sequence of parentheses.\"\"\"\n        def __init__(self, value: str):\n            self.value = value\n\n        def length(self) -> int:\n            \"\"\"Returns the length of the bracket string.\"\"\"\n            return len(self.value)\n\n    class ValidationResult:\n        \"\"\"Represents the outcome of validation and balance checking.\"\"\"\n        def __init__(self, is_balanced: bool, error_message: str = \"\"):\n            self.is_balanced = is_balanced\n            self.error_message = error_message\n\n    class BracketingChecker:\n        \"\"\"Encapsulates validation and algorithm for checking balance and nesting.\"\"\"\n        def __init__(self):\n            self.last_result: bool | None = None\n            self.checked_at: datetime | None = None\n\n        def validate(self, b: BracketString) -> ValidationResult:\n            \"\"\"Verifies b.value contains only '(' and ')'.\"\"\"\n            for char in b.value:\n                if char not in \"()\":\n                    return ValidationResult(is_balanced=False, error_message=\"Invalid characters found\")\n            return ValidationResult(is_balanced=True, error_message=\"\")\n\n        def isBalanced(self, b: BracketString) -> bool:\n            \"\"\"Evaluates whether parentheses in b.value are balanced and properly nested.\"\"\"\n            balance_counter = 0\n            for char in b.value:\n                if char == '(':\n                    balance_counter += 1\n                elif char == ')':\n                    balance_counter -= 1\n                if balance_counter < 0:\n                    self.last_result = False\n                    self.checked_at = datetime.now()\n                    return False\n            \n            result = balance_counter == 0\n            self.last_result = result\n            self.checked_at = datetime.now()\n            return result\n\n    bracket_string = BracketString(brackets)\n    checker = BracketingChecker()\n\n    validation_result = checker.validate(bracket_string)\n\n    if not validation_result.is_balanced:\n        # If validation failed due to invalid characters, return False as per design.\n        return validation_result.is_balanced\n    \n    # If validation passed, proceed to check balance and nesting.\n    return checker.isBalanced(bracket_string)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/82": [{"task_id": "HumanEval/82", "solution": "import math\nfrom dataclasses import dataclass\nclass PrimeDefinition:\n    min_prime: int = 2\n\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Checks if a number is prime based on the canonical definition.\"\"\"\n        if n < self.min_prime:\n            return False\n        if n == self.min_prime:\n            return True\n        if n % 2 == 0:\n            return False\n        \n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\nclass PrimeLengthService:\n    def __init__(self, prime_def: PrimeDefinition):\n        \"\"\"Initializes the service with a PrimeDefinition instance.\"\"\"\n        self.prime_def = prime_def\n\n    def prime_length(self, string: str) -> bool:\n        \"\"\"Computes the length of the string and checks if it is prime.\"\"\"\n        input_str = InputString(value=string)\n        length_to_check = input_str.length()\n        return self.prime_def.is_prime(length_to_check)\ndef prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    prime_definition = PrimeDefinition()\n    service = PrimeLengthService(prime_definition)\n    return service.prime_length(string)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["Hello"]], "plus_fail_tests": [["a"]]}], "HumanEval/80": [{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"You are given a string s.\n    Your task is to check if the string is happy or not.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct\n    For example:\n    is_happy(a) => False\n    is_happy(aa) => False\n    is_happy(abcd) => True\n    is_happy(aabb) => False\n    is_happy(adb) => True\n    is_happy(xyy) => False\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        # Extract three consecutive characters\n        char1 = s[i]\n        char2 = s[i+1]\n        char3 = s[i+2]\n\n        # Check if they are distinct\n        # A triple is not distinct if any two characters are the same\n        if char1 == char2 or char1 == char3 or char2 == char3:\n            return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/76": [{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Your task is to write a function that returns true if a number x is a simple\n    power of n and false in other cases.\n    x is a simple power of n if n**int=x\n    For example:\n    is_simple_power(1, 4) => true\n    is_simple_power(2, 2) => true\n    is_simple_power(8, 2) => true\n    is_simple_power(3, 2) => false\n    is_simple_power(3, 1) => false\n    is_simple_power(5, 3) => false\n    \"\"\"\n\n    class InputValidator:\n        def validate_integer_inputs(self, x_val, n_val):\n            return isinstance(x_val, int) and isinstance(n_val, int)\n\n    class PowerEvaluator:\n        def find_k_or_fail(self, x_val, n_val):\n            if x_val == 1:\n                return 0\n\n            if n_val == 1:\n                return None\n\n            if n_val == 0:\n                if x_val == 0:\n                    return 1\n                else:\n                    return None\n\n            if x_val < 0 and n_val > 0:\n                return None\n\n            current_power = n_val\n            k = 1\n            while True:\n                if current_power == x_val:\n                    return k\n\n                if abs(current_power) > abs(x_val):\n                    return None\n                \n                current_power *= n_val\n                k += 1\n\n        def is_power(self, x_val, n_val):\n            return self.find_k_or_fail(x_val, n_val) is not None\n\n    validator = InputValidator()\n    if not validator.validate_integer_inputs(x, n):\n        return False\n    \n    evaluator = PowerEvaluator()\n    return evaluator.is_power(x, n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/84": [{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n    \n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n    # Calculate the sum of the decimal digits of N.\n    # This logic assumes N is a non-negative integer as per constraints.\n    digit_sum = 0\n    if N == 0:\n        digit_sum = 0\n    else:\n        temp_N = N\n        while temp_N > 0:\n            digit_sum += temp_N % 10\n            temp_N //= 10\n    \n    # Convert the computed digit_sum into its binary string representation.\n    # Python's bin() function provides \"0b\" prefix, which is removed by slicing.\n    return bin(digit_sum)[2:]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/81": [{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write \n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A \n            > 3.3                A- \n            > 3.0                B+\n            > 2.7                B \n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+ \n            > 0.7                D \n            > 0.0                D-\n              0.0                E\n    \n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    letter_grades = []\n    for gpa in grades:\n        current_gpa = float(gpa)\n        if current_gpa == 4.0:\n            letter_grades.append('A+')\n        elif current_gpa > 3.7:\n            letter_grades.append('A')\n        elif current_gpa > 3.3:\n            letter_grades.append('A-')\n        elif current_gpa > 3.0:\n            letter_grades.append('B+')\n        elif current_gpa > 2.7:\n            letter_grades.append('B')\n        elif current_gpa > 2.3:\n            letter_grades.append('B-')\n        elif current_gpa > 2.0:\n            letter_grades.append('C+')\n        elif current_gpa > 1.7:\n            letter_grades.append('C')\n        elif current_gpa > 1.3:\n            letter_grades.append('C-')\n        elif current_gpa > 1.0:\n            letter_grades.append('D+')\n        elif current_gpa > 0.7:\n            letter_grades.append('D')\n        elif current_gpa > 0.0:\n            letter_grades.append('D-')\n        elif current_gpa == 0.0:\n            letter_grades.append('E')\n        # No explicit else for values not matching the table (e.g., negative)\n        # as per design context, these are unspecified and fall through.\n    return letter_grades", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/85": [{"task_id": "HumanEval/85", "solution": "class ListElement:\n    def __init__(self, value: int, index: int) -> None:\n        self.value = value\n        self.index = index\n\n    def isEven(self) -> bool:\n        return self.value % 2 == 0\n\n    def isOddIndex(self) -> bool:\n        return self.index % 2 != 0\nclass InputList:\n    def __init__(self, elements: list[int]) -> None:\n        self.elements = elements\n        self.size = len(elements)\n\n    def validateNonEmpty(self) -> None:\n        if not self.elements:\n            raise ValueError(\"Input list cannot be empty.\")\n\n    def validateAllIntegers(self) -> None:\n        for element in self.elements:\n            if not isinstance(element, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n\n    def getElement(self, index: int) -> 'ListElement':\n        return ListElement(self.elements[index], index)\nclass SumResult:\n    def __init__(self, total: int) -> None:\n        self.total = total\n\n    def toInt(self) -> int:\n        return self.total\nclass SumCalculator:\n    def __init__(self) -> None:\n        pass\n\n    def computeSumEvenAtOddIndices(self, input_list: InputList) -> SumResult:\n        total_sum = 0\n        for i in range(input_list.size):\n            element = input_list.getElement(i)\n            if element.isOddIndex() and element.isEven():\n                total_sum += element.value\n        return SumResult(total_sum)\ndef add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\"\"\"\n    input_list = InputList(lst)\n    input_list.validateNonEmpty()\n    input_list.validateAllIntegers()\n    \n    calc = SumCalculator()\n    result = calc.computeSumEvenAtOddIndices(input_list)\n    \n    return result.toInt()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/79": [{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a decimal number to a binary string, prefixed and suffixed with 'db'.\n    Raises TypeError if the input is not an integer.\n    \"\"\"\n\n    class Validator:\n        \"\"\"Responsible for validating input types.\"\"\"\n        @staticmethod\n        def isInteger(value) -> bool:\n            \"\"\"Return True iff value is an integer type per Python semantics.\"\"\"\n            return isinstance(value, int)\n\n    class DecimalToBinaryConverter:\n        \"\"\"Responsible for converting integer to canonical binary string.\"\"\"\n        @staticmethod\n        def convert(decimal: int) -> str:\n            \"\"\"Return canonical binary representation (string of '0'/'1'); for 0 return '0'.\"\"\"\n            if decimal == 0:\n                return \"0\"\n            return bin(decimal)[2:] # bin(15) -> '0b1111'; slice removes '0b'\n\n    if not Validator.isInteger(decimal):\n        raise TypeError(\"Input must be an integer\")\n\n    binary_string = DecimalToBinaryConverter.convert(decimal)\n    return \"db\" + binary_string + \"db\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/87": [{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    You are given a 2 dimensional data, as a nested lists,\n    which is similar to matrix, however, unlike matrices,\n    each row may contain a different number of columns.\n    Given lst, and integer x, find integers x in the list,\n    and return list of tuples, [(x1, y1), (x2, y2) ...] such that\n    each tuple is a coordinate - (row, columns), starting with 0.\n    Sort coordinates initially by rows in ascending order.\n    Also, sort coordinates of the row by columns in descending order.\n    \n    Examples:\n    get_row([\n      [1,2,3,4,5,6],\n      [1,2,3,4,1,6],\n      [1,2,3,4,5,1]\n    ], 1) == [(0, 0), (1, 4), (1, 0), (2, 5), (2, 0)]\n    get_row([], 1) == []\n    get_row([[], [1], [1, 2, 3]], 3) == [(2, 2)]\n    \"\"\"\n    # Helper class for coordinates, defined inline as per problem constraints.\n    # Assumes List and Tuple from 'typing' are available in the execution environment.\n    class Coordinate:\n        def __init__(self, row_index: int, col_index: int) -> None:\n            self.row_index = row_index\n            self.col_index = col_index\n\n        def to_tuple(self) -> tuple[int, int]:\n            return (self.row_index, self.col_index)\n\n    coordinates: list[Coordinate] = []\n\n    for r_index, row in enumerate(lst):\n        for c_index, value in enumerate(row):\n            if value == x:\n                coordinates.append(Coordinate(r_index, c_index))\n\n    # Sort the collected coordinates: primary by row_index ascending, secondary by col_index descending.\n    coordinates.sort(key=lambda coord: (coord.row_index, -coord.col_index))\n\n    return [coord.to_tuple() for coord in coordinates]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/88": [{"task_id": "HumanEval/88", "solution": "class InputArray:\n    \"\"\"Wraps an input list and provides accessors.\"\"\"\n    def __init__(self, elements: list[int]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def getFirst(self) -> int:\n        return self.elements[0]\n\n    def getLast(self) -> int:\n        return self.elements[-1]\nclass Validator:\n    \"\"\"Validates array elements for non-negativity and type.\"\"\"\n    def validateNonNegative(self, arr: InputArray) -> bool:\n        if not isinstance(arr.elements, list):\n            return False\n        for x in arr.elements:\n            if not isinstance(x, int) or x < 0:\n                return False\n        return True\nclass SumCalculator:\n    \"\"\"Calculates the sum of the first and last elements.\"\"\"\n    def computeFirstLastSum(self, arr: InputArray) -> int:\n        return arr.getFirst() + arr.getLast()\nclass SortEngine:\n    \"\"\"Sorts a list either ascending or descending based on a sum's parity.\"\"\"\n    def sortAscending(self, arr_elements: list[int]) -> list[int]:\n        return sorted(arr_elements)\n\n    def sortDescending(self, arr_elements: list[int]) -> list[int]:\n        return sorted(arr_elements, reverse=True)\n\n    def sortByParity(self, arr: InputArray) -> list[int]:\n        sum_calculator = SumCalculator()\n        first_last_sum = sum_calculator.computeFirstLastSum(arr)\n        \n        elements_copy = list(arr.elements) # Work on a copy of the elements\n\n        if first_last_sum % 2 == 1:  # Odd sum\n            return self.sortAscending(elements_copy)\n        else:  # Even sum\n            return self.sortDescending(elements_copy)\ndef sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n    input_arr = InputArray(array)\n    \n    validator = Validator()\n    if not validator.validateNonNegative(input_arr):\n        raise ValueError(\"Input array must contain only non-negative integers.\")\n    \n    if input_arr.length() == 0:\n        return []\n    \n    if input_arr.length() == 1:\n        return [input_arr.getFirst()] # Return a new list instance\n\n    sort_engine = SortEngine()\n    return sort_engine.sortByParity(input_arr)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/90": [{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Returns the 2nd smallest unique element of the list, or None if not available.\n    \"\"\"\n    unique_elements = sorted(list(set(lst)))\n    if len(unique_elements) < 2:\n        return None\n    return unique_elements[1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/89": [{"task_id": "HumanEval/89", "solution": "from dataclasses import dataclass\nROTATION: int = 4\nclass Alphabet:\n    \"\"\"Helper for lowercase English alphabet rotation.\"\"\"\n    letters: str = 'abcdefghijklmnopqrstuvwxyz'\n\n    def rotate(self, letter: str, offset: int) -> str:\n        \"\"\"Returns the letter shifted forward by offset with modulo-26 wrap-around.\"\"\"\n        if letter not in self.letters:\n            return letter \n        \n        index = self.letters.index(letter)\n        new_index = (index + offset) % len(self.letters)\n        return self.letters[new_index]\nclass Encryptor:\n    \"\"\"Encapsulates the rotational encryption algorithm.\"\"\"\n    def __init__(self, rotation: int = ROTATION):\n        self.rotation = rotation\n        self._alphabet = Alphabet()\n\n    def encrypt(self, s: str) -> str:\n        \"\"\"Encrypts a string by rotating each lowercase letter.\"\"\"\n        encrypted_chars = []\n        for char in s:\n            if char in self._alphabet.letters:\n                encrypted_chars.append(self._alphabet.rotate(char, self.rotation))\n            else:\n                # Non-lowercase characters are preserved as per design.\n                encrypted_chars.append(char)\n        \n        return \"\".join(encrypted_chars)\ndef encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated. \n    The alphabet should be rotated in a manner such that the letters \n    shift down by two multiplied to two places.\n    For example:\n    encrypt('hi') returns 'lm'\n    encrypt('asdfghjkl') returns 'ewhjklnop'\n    encrypt('gf') returns 'kj'\n    encrypt('et') returns 'ix'\n    \"\"\"\n    return Encryptor().encrypt(s)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/92": [{"task_id": "HumanEval/92", "solution": "class InputValue:\n    def __init__(self, value):\n        self.value = value\n\n    def is_int(self) -> bool:\n        \"\"\"Returns True if the value is strictly an integer.\"\"\"\n        return type(self.value) is int\nclass SumCheck:\n    def is_sum(self, a: int, b: int, c: int) -> bool:\n        \"\"\"Checks if any one number is the sum of the other two.\"\"\"\n        return (a == b + c) or (b == a + c) or (c == a + b)\ndef any_int(x, y, z) -> bool:\n    ix = InputValue(x)\n    iy = InputValue(y)\n    iz = InputValue(z)\n\n    if not (ix.is_int() and iy.is_int() and iz.is_int()):\n        return False\n\n    sc = SumCheck()\n    return sc.is_sum(x, y, z)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/93": [{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Write a function that takes a message, and encodes in such a \n    way that it swaps case of all letters, replaces all vowels in \n    the message with the letter that appears 2 places ahead of that \n    vowel in the english alphabet. \n    Assume only letters. \n    \n    Examples:\n    >>> encode('test')\n    'TGST'\n    >>> encode('This is a message')\n    'tHKS KS C MGSSCGG'\n    \"\"\"\n    VOWEL_MAPPING = {\n        'a': 'c', 'A': 'C',\n        'e': 'g', 'E': 'G',\n        'i': 'k', 'I': 'K',\n        'o': 'q', 'O': 'Q',\n        'u': 'w', 'U': 'W'\n    }\n    \n    encoded_chars = []\n    for char in message:\n        if char == ' ':\n            encoded_chars.append(char)\n        else:\n            # Transformation order: Vowel mapping first, then case swapping.\n            # Apply vowel mapping\n            mapped_char = VOWEL_MAPPING.get(char, char)\n            \n            # Apply case swapping\n            if mapped_char.islower():\n                transformed_char = mapped_char.upper()\n            else: # mapped_char.isupper()\n                transformed_char = mapped_char.lower()\n            \n            encoded_chars.append(transformed_char)\n            \n    return \"\".join(encoded_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/86": [{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n\n    class Character:\n        \"\"\"Represents a single character and its ASCII code point for sorting.\"\"\"\n        def __init__(self, char: str):\n            self.char = char\n            self.ascii = ord(char)\n\n    class Sorter:\n        \"\"\"A stateless service to sort lists of Character by ASCII ascending.\"\"\"\n        def sortCharacters(self, chars: list[Character]) -> list[Character]:\n            return sorted(chars, key=lambda c: c.ascii)\n\n    class Word:\n        \"\"\"Represents a token (word) with its value, original position, and characters.\"\"\"\n        def __init__(self, value: str, position: int):\n            self.value = value\n            self.position = position\n            self.characters = [Character(c) for c in value]\n\n        def sortChars(self) -> 'Word':\n            \"\"\"Sorts the characters of the word and returns a new Word with sorted value.\"\"\"\n            if not self.characters:\n                return Word('', self.position)\n            \n            sorter = Sorter()\n            sorted_chars_objs = sorter.sortCharacters(self.characters)\n            sorted_value = ''.join(c.char for c in sorted_chars_objs)\n            return Word(sorted_value, self.position)\n\n    class InputString:\n        \"\"\"Encapsulates the input string and provides tokenization.\"\"\"\n        def __init__(self, value: str):\n            self.value = value\n            self.length = len(value)\n\n        def tokenize(self) -> list[Word]:\n            \"\"\"Splits the input string by space (U+0020), preserving zero-length tokens.\"\"\"\n            tokens_raw = self.value.split(' ')\n            words = []\n            for i, token_value in enumerate(tokens_raw):\n                words.append(Word(token_value, i))\n            return words\n\n    class OutputString:\n        \"\"\"A value object representing the assembled output string.\"\"\"\n        def __init__(self, value: str):\n            self.value = value\n\n    if s == '':\n        return ''\n\n    inp = InputString(value=s)\n    tokens = inp.tokenize()\n\n    processed_tokens_values = []\n    for w in tokens:\n        if w.value == '':\n            processed_tokens_values.append('')\n        else:\n            sorted_word = w.sortChars()\n            processed_tokens_values.append(sorted_word.value)\n\n    output_value = ' '.join(processed_tokens_values)\n    out = OutputString(value=output_value)\n    return out.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/91": [{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts sentences starting with \"I\", delimited by '.', '?', or '!'.\n    Leading whitespace is trimmed, and \"I\" must be followed by whitespace, delimiter, or end-of-sentence.\n    \"\"\"\n\n    DELIMITERS = {'.', '?', '!'}\n\n    class Sentence:\n        def __init__(self, raw_text: str):\n            self.text = raw_text.lstrip()\n\n        def isWhitespaceOnly(self) -> bool:\n            # A sentence is whitespace-only if its trimmed text is empty.\n            return not self.text\n\n        def startsWithI(self) -> bool:\n            # Check for empty trimmed text.\n            if not self.text:\n                return False\n\n            # Must start with 'I' (case-sensitive).\n            if not self.text.startswith(\"I\"):\n                return False\n\n            # If the entire sentence is just \"I\", it counts.\n            if self.text == \"I\":\n                return True\n\n            # Check the character immediately following 'I'.\n            follower_char = self.text[1]\n\n            # Follower must be whitespace or a sentence delimiter.\n            return follower_char.isspace() or follower_char in DELIMITERS\n\n    class BoredomCounter:\n        def splitSentences(self, s: str) -> list[Sentence]:\n            sentences = []\n            current_sentence_start = 0\n            s_len = len(s)\n\n            for i in range(s_len):\n                if s[i] in DELIMITERS:\n                    raw_sentence_text = s[current_sentence_start:i]\n                    temp_sentence = Sentence(raw_sentence_text)\n                    if not temp_sentence.isWhitespaceOnly():\n                        sentences.append(temp_sentence)\n                    \n                    # Move past the delimiter(s) for the next sentence.\n                    current_sentence_start = i + 1\n                    # Skip over subsequent delimiters without creating empty sentences.\n                    while current_sentence_start < s_len and s[current_sentence_start] in DELIMITERS:\n                        current_sentence_start += 1\n                \n            # Add any remaining text as the last sentence if it's not just whitespace.\n            if current_sentence_start < s_len:\n                raw_sentence_text = s[current_sentence_start:s_len]\n                temp_sentence = Sentence(raw_sentence_text)\n                if not temp_sentence.isWhitespaceOnly():\n                    sentences.append(temp_sentence)\n\n            return sentences\n\n        def countBoredoms(self, S: str) -> int:\n            boredom_count = 0\n            sentences = self.splitSentences(S)\n            for sentence in sentences:\n                if not sentence.isWhitespaceOnly():\n                    if sentence.startsWithI():\n                        boredom_count += 1\n            return boredom_count\n\n    # Instantiate and run the BoredomCounter.\n    counter = BoredomCounter()\n    return counter.countBoredoms(S)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["I"]]}], "HumanEval/95": [{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    keys_list = list(dict.keys())\n\n    # First, verify that all keys are strings.\n    for key in keys_list:\n        if not isinstance(key, str):\n            return False\n\n    # Check if all keys are lowercase strings.\n    all_lower = True\n    for key in keys_list:\n        if not key.islower():\n            all_lower = False\n            break\n    if all_lower:\n        