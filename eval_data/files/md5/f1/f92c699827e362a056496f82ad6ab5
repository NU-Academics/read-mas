{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"You are given a string s.\n    Your task is to check if the string is happy or not.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct\n    For example:\n    is_happy(a) => False\n    is_happy(aa) => False\n    is_happy(abcd) => True\n    is_happy(aabb) => False\n    is_happy(adb) => True\n    is_happy(xyy) => False\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        # Check if s[i], s[i+1], s[i+2] are all distinct\n        if s[i] == s[i+1] or s[i] == s[i+2] or s[i+1] == s[i+2]:\n            return False\n    return True"}
{"task_id": "HumanEval/75", "solution": "import itertools\ndef is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    # Input validation based on the prompt's implied constraints and common practice for boolean functions.\n    # 'a' is less than 100 typically implies 1 <= a <= 99.\n    # If 'a' is not an integer, or outside this range, it cannot be a product of three primes, so return False.\n    if not isinstance(a, int) or not (1 <= a <= 99):\n        return False\n\n    # The smallest product of three distinct prime numbers is 2 * 3 * 5 = 30.\n    # If 'a' is less than 30, it cannot be a product of three distinct primes.\n    if a < 30:\n        return False\n\n    # Helper function to generate prime numbers up to a given limit using the Sieve of Eratosthenes.\n    # This function is defined locally to ensure self-containment within the \"bare function\" requirement.\n    def _generate_primes_up_to(limit: int) -> list[int]:\n        if limit < 2:\n            return []\n\n        # Initialize a boolean array 'is_prime_sieve' where is_prime_sieve[i] is True if i is prime.\n        is_prime_sieve = [True] * (limit + 1)\n        is_prime_sieve[0] = is_prime_sieve[1] = False  # 0 and 1 are not prime numbers.\n\n        p = 2\n        # Iterate up to the square root of the limit.\n        # This optimization avoids checking multiples of numbers beyond the square root,\n        # as their smaller prime factors would have already marked their multiples.\n        while p * p <= limit:\n            if is_prime_sieve[p]:\n                # Mark all multiples of p (starting from p*p) as not prime.\n                for multiple in range(p * p, limit + 1, p):\n                    is_prime_sieve[multiple] = False\n            p += 1\n\n        # Collect all numbers that are marked as prime.\n        return [i for i, prime_val in enumerate(is_prime_sieve) if prime_val]\n\n    # Generate all prime numbers up to 'a'.\n    primes_up_to_a = _generate_primes_up_to(a)\n\n    # Optimization: If 'a' is a product of three distinct primes p1, p2, p3 such that p1 < p2 < p3,\n    # then the largest prime factor p3 must be less than or equal to a / (2 * 3) = a / 6\n    # (since the smallest distinct primes are 2 and 3).\n    # Therefore, all three prime factors (p1, p2, p3) must be less than or equal to 'a // 6'.\n    candidate_primes_for_combinations = [p for p in primes_up_to_a if p <= a // 6]\n\n    # Use itertools.combinations to find all unique combinations of three distinct primes\n    # from the list of candidate primes.\n    for p1, p2, p3 in itertools.combinations(candidate_primes_for_combinations, 3):\n        # If the product of the three primes equals 'a', then 'a' is a multiply prime.\n        if p1 * p2 * p3 == a:\n            return True\n\n    # If no such combination is found after checking all possibilities, 'a' is not a multiply prime.\n    return False"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"\n    Checks if a string is happy. A string is happy if its length is at least 3\n    and every 3 consecutive letters are distinct.\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        # Check if the three consecutive characters are distinct\n        if s[i] == s[i+1] or s[i] == s[i+2] or s[i+1] == s[i+2]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/82", "solution": "def _is_prime(n):\n    \"\"\"\n    Helper function to check if a number is prime.\n    A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef prime_length(string):\n    \"\"\"\n    Checks if the length of the input string is a prime number.\n    Returns True if the string's length is a prime number, False otherwise.\n    \"\"\"\n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n: int) -> int:\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    else:\n        # Numbers starting with 1: 1 * 10^(n-1)\n        starts_with_1 = 10**(n - 1)\n        # Numbers ending with 1: (first digit 1-9) * 10^(n-2) * (last digit 1)\n        ends_with_1 = 9 * (10**(n - 2))\n        # Numbers starting AND ending with 1: (first digit 1) * 10^(n-2) * (last digit 1)\n        starts_and_ends_with_1 = 10**(n - 2)\n        return starts_with_1 + ends_with_1 - starts_and_ends_with_1"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n: int) -> int:\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    count_starts_with_1 = 10**(n - 1)\n    count_ends_with_1 = 10**(n - 1)\n\n    if n == 1:\n        count_starts_and_ends_with_1 = 1\n    elif n == 2:\n        count_starts_and_ends_with_1 = 1\n    else:\n        count_starts_and_ends_with_1 = 10**(n - 2)\n\n    return count_starts_with_1 + count_ends_with_1 - count_starts_and_ends_with_1"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string: str) -> bool:\n    \"\"\"Returns True if the string length is a prime number, False otherwise.\"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if a given integer n is a prime number. It uses an optimized trial division algorithm.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:  # Covers 2 and 3\n            return True\n        if n % 2 == 0 or n % 3 == 0: # Excludes multiples of 2 and 3 greater than 3\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    length = len(string)\n    return is_prime(length)"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n\n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n\n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n\n    def _sum_digits_inline(num: int) -> int:\n        \"\"\"Calculates the sum of decimal digits of an integer.\"\"\"\n        s = 0\n        for digit_char in str(num):\n            s += int(digit_char)\n        return s\n\n    def _to_binary_string_inline(decimal_sum: int) -> str:\n        \"\"\"Converts a decimal integer into its binary string representation.\"\"\"\n        if decimal_sum == 0:\n            return \"0\"\n        return bin(decimal_sum)[2:]\n\n    decimal_sum = _sum_digits_inline(N)\n    binary_string = _to_binary_string_inline(decimal_sum)\n    return binary_string"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs to a list of letter grades.\n    Applies a predefined grading scale to determine each corresponding letter grade.\n    \"\"\"\n\n    # Define the grading scale internally as per requirements.\n    # The order is crucial: from highest GPA threshold to lowest.\n    GRADING_SCALE_THRESHOLDS = [\n        (4.0, \"A+\"), (3.7, \"A\"), (3.3, \"A-\"), (3.0, \"B+\"),\n        (2.7, \"B\"), (2.3, \"B-\"), (2.0, \"C+\"), (1.7, \"C\"),\n        (1.3, \"C-\"), (1.0, \"D+\"), (0.7, \"D\"), (0.0, \"D-\")\n    ]\n    GRADE_E_THRESHOLD = 0.0\n    GRADE_E_LETTER = \"E\"\n\n    def _convert_single_gpa(gpa):\n        # Handle exact 0.0 GPA.\n        if gpa == GRADE_E_THRESHOLD:\n            return GRADE_E_LETTER\n\n        # Iterate through thresholds from highest to lowest.\n        for threshold, letter_grade in GRADING_SCALE_THRESHOLDS:\n            if gpa >= threshold:\n                # 'A+' is exclusively for 4.0, others strictly greater are 'A'.\n                if letter_grade == \"A+\" and gpa != 4.0:\n                    continue\n                return letter_grade\n\n        # Assign 'E' for negative GPAs or values below D- range.\n        return GRADE_E_LETTER\n\n    result_grades = []\n    for gpa in grades:\n        result_grades.append(_convert_single_gpa(gpa))\n\n    return result_grades"}
{"task_id": "HumanEval/85", "solution": "def add(lst: list[int]) -> int:\n    \"\"\"Calculates the sum of even elements located at odd 0-based indices in a list.\n    The input `lst` is assumed to be a list of integers.\n    \"\"\"\n    total_sum = 0\n    for i, element in enumerate(lst):\n        if i % 2 != 0 and element % 2 == 0:\n            total_sum += element\n    return total_sum"}
