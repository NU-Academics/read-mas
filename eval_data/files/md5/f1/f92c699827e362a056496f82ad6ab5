{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    def _validate_positive_number(value, param_name):\n        if not isinstance(value, (int, float)):\n            raise ValueError(f\"{param_name} must be a number.\")\n        if value <= 0:\n            raise ValueError(f\"{param_name} must be a positive number.\")\n\n    _validate_positive_number(a, \"a\")\n    _validate_positive_number(h, \"h\")\n\n    return 0.5 * a * h"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if not (2 <= base <= 9):\n        raise ValueError(f\"Base must be between 2 and 9, but got {base}\")\n    if x < 0:\n        raise ValueError(f\"Number x must be non-negative, but got {x}\")\n\n    if x == 0:\n        return \"0\"\n\n    result = []\n    current_x = x\n    while current_x > 0:\n        remainder = current_x % base\n        result.append(str(remainder))\n        current_x //= base\n\n    return \"\".join(result[::-1])"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    Checks if there are two distinct elements in the list that sum to zero.\n    It uses a hash set for efficient O(N) average time complexity.\n    \"\"\"\n    if len(l) < 2:\n        return False\n\n    seen_numbers = set()\n    for num in l:\n        complement = -num\n        if complement in seen_numbers:\n            return True\n        seen_numbers.add(num)\n    return False"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int) -> int:\n    \"\"\"Computes the n-th element of the Fib4 number sequence iteratively.\n    The sequence is defined by fib4(0)=0, fib4(1)=0, fib4(2)=2, fib4(3)=0, and fib4(n) = fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4) for n > 3.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n    else:\n        # Store the last four computed values: [fib4(i-4), fib4(i-3), fib4(i-2), fib4(i-1)]\n        # Initialize with base cases corresponding to fib4(0), fib4(1), fib4(2), fib4(3)\n        current_values = [0, 0, 2, 0]\n\n        for _ in range(4, n + 1):\n            next_fib4 = sum(current_values)\n            # Shift values: remove the oldest and add the newest\n            current_values.pop(0)\n            current_values.append(next_fib4)\n        return current_values[3]"}
