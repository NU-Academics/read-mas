{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    if n <= 1:\n        return 1\n\n    # Iterate downwards from n // 2 to 1\n    for i in range(n // 2, 0, -1):\n        if n % i == 0:\n            return i\n    # This part should ideally not be reached for n > 1 as 1 is always a divisor.\n    # However, if n is prime, the loop will complete and return 1.\n    return 1"}
{"task_id": "HumanEval/26", "solution": "from typing import List\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    \"\"\"\n    counts = {}\n    # First pass: count frequencies of all elements.\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    result = []\n    # Second pass: build the result list, preserving order and including only unique elements.\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n\n    return result"}
{"task_id": "HumanEval/25", "solution": "from typing import List\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    factors = []\n    d = 2\n    temp_n = n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n    if temp_n > 1:\n        factors.append(temp_n)\n    return factors"}
{"task_id": "HumanEval/26", "solution": "from typing import List\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\"From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\"\"\"\n\n    counts = {}\n    # First pass: count occurrences of each number.\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    result = []\n    # Second pass: build the result list with numbers that appeared exactly once.\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n\n    return result"}
