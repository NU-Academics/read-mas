{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Calculates the special factorial of a positive integer n.\n    This is defined as n! * (n-1)! * ... * 1!.\n    \"\"\"\n    total_product = 1\n    for i in range(1, n + 1):\n        current_factorial = 1\n        for j in range(1, i + 1):\n            current_factorial *= j\n        total_product *= current_factorial\n    return total_product"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compares two numbers of mixed types and returns the larger in its original type, or None if equal.\n    Handles string representations of real numbers with '.' or ',' decimal separators.\n    \"\"\"\n\n    def _parse_real_number(value):\n        # Converts any input (int, float, str) to a float for comparison.\n        # It handles string inputs by replacing comma decimals with dots before conversion.\n        return float(str(value).replace(',', '.'))\n\n    num_a = _parse_real_number(a)\n    num_b = _parse_real_number(b)\n\n    if num_a > num_b:\n        return a\n    elif num_b > num_a:\n        return b\n    else:  # num_a == num_b\n        return None"}
{"task_id": "HumanEval/139", "solution": "def factorial(k):\n    \"\"\"Calculates the standard factorial of a non-negative integer k.\"\"\"\n    if k == 0:\n        return 1\n    result = 1\n    for i in range(1, k + 1):\n        result *= i\n    return result\ndef special_factorial(n):\n    \"\"\"Calculates the Brazilian factorial of a positive integer n.\"\"\"\n    special_fact_result = 1\n    for i in range(1, n + 1):\n        special_fact_result *= factorial(i)\n    return special_fact_result"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compares two values (int, float, or string representing real numbers)\n    and returns the larger one in its original type, or None if equal.\n    \"\"\"\n\n    def _normalize_to_float(value):\n        \"\"\"Converts value to float, handling strings with ',' decimal separator.\n        Native Python exceptions are allowed to propagate for invalid inputs.\"\"\"\n        if isinstance(value, str):\n            value = value.replace(',', '.')\n        return float(value)\n\n    normalized_a = _normalize_to_float(a)\n    normalized_b = _normalize_to_float(b)\n\n    if normalized_a > normalized_b:\n        return a\n    elif normalized_b > normalized_a:\n        return b\n    else:\n        return None"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text: str) -> str:\n    \"\"\"\n    Replaces spaces in the input string according to specific rules.\n    It handles single, double, and three-or-more consecutive spaces.\n    \"\"\"\n    # Replace 3 or more consecutive spaces with a hyphen\n    text = re.sub(r' {3,}', '-', text)\n    # Replace exactly two consecutive spaces with two underscores\n    text = re.sub(r' {2}', '__', text)\n    # Replace single spaces with an underscore\n    text = re.sub(r' ', '_', text)\n    return text"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n    \"\"\"\n    processed_text = re.sub(r' {3,}', '-', text)\n    processed_text = processed_text.replace(' ', '_')\n    return processed_text"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"\n    Checks if a file's name is valid based on specific criteria.\n    Returns 'Yes' if valid, 'No' otherwise.\n    \"\"\"\n    MAX_DIGITS_ALLOWED = 3\n    ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n\n    # BR1: A valid file name must not contain more than three digits ('0'-'9').\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > MAX_DIGITS_ALLOWED:\n        return 'No'\n\n    # BR2: A valid file name must contain exactly one dot '.'.\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split the file name into name_part and extension_part.\n    parts = file_name.split('.')\n    name_part = parts[0]\n    extension_part = parts[1]\n\n    # BR3: The part of the file name before the dot must not be empty.\n    if not name_part:\n        return 'No'\n\n    # BR4: The part of the file name before the dot must start with a letter from the Latin alphabet ('a'-'z' or 'A'-'Z').\n    first_char = name_part[0]\n    if not (('a' <= first_char <= 'z') or ('A' <= first_char <= 'Z')):\n        return 'No'\n\n    # BR5: The part of the file name after the dot (extension) must be one of ['txt', 'exe', 'dll'].\n    if extension_part not in ALLOWED_EXTENSIONS:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n\n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    processed_list = list(lst)  # Create a mutable copy to store transformed values.\n    for i in range(len(processed_list)):\n        if i % 3 == 0:\n            processed_list[i] = processed_list[i] ** 2\n        elif i % 4 == 0:\n            processed_list[i] = processed_list[i] ** 3\n    return sum(processed_list)"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n\n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    transformed_elements = []\n    for i, x in enumerate(lst):\n        if i % 3 == 0:\n            transformed_elements.append(x * x)\n        elif i % 4 == 0:\n            transformed_elements.append(x * x * x)\n        else:\n            transformed_elements.append(x)\n    return sum(transformed_elements)"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"Filters words from a sentence, returning only those whose lengths are prime numbers. The original order of words is preserved.\"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Checks if a number is prime. Handles 0, 1, and positive integers.\"\"\"\n        if n < 2:\n            return False\n        # Loop up to the square root of n for efficiency.\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split(' ')\n    filtered_words = []\n    for word in words:\n        if _is_prime(len(word)):\n            filtered_words.append(word)\n    return ' '.join(filtered_words)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"\n    Checks if a file's name is valid based on predefined conditions.\n    Returns 'Yes' if valid, 'No' otherwise.\n    \"\"\"\n    allowed_extensions = ['txt', 'exe', 'dll']\n    max_digits = 3\n\n    # Check for exactly one dot (FR2, BR2)\n    if not isinstance(file_name, str) or file_name.count('.') != 1:\n        return 'No'\n\n    # Split the file name into base and extension\n    base_name, extension = file_name.split('.', 1)\n\n    # Check if base name is not empty and starts with a letter (FR3, BR3)\n    if not base_name or not base_name[0].isalpha():\n        return 'No'\n\n    # Count digits in the file name and check against max_digits (FR1, BR1)\n    digit_count = 0\n    for char in file_name:\n        if char.isdigit():\n            digit_count += 1\n    if digit_count > max_digits:\n        return 'No'\n\n    # Check if the extension is one of the allowed extensions (FR4, BR4)\n    if extension not in allowed_extensions:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"\n    Determines if the product of two fractions results in a whole number.\n    Inputs `x` and `n` are string representations of fractions (e.g., \"1/2\").\n    \"\"\"\n\n    class Fraction:\n        \"\"\"Represents a mathematical fraction with a numerator and a denominator.\"\"\"\n        def __init__(self, numerator: int, denominator: int):\n            self._numerator = numerator\n            self._denominator = denominator\n\n        @property\n        def numerator(self) -> int:\n            return self._numerator\n\n        @property\n        def denominator(self) -> int:\n            return self._denominator\n\n        def multiply(self, other: 'Fraction') -> 'Fraction':\n            \"\"\"Multiplies this fraction by another Fraction object.\"\"\"\n            new_numerator = self.numerator * other.numerator\n            new_denominator = self.denominator * other.denominator\n            return Fraction(new_numerator, new_denominator)\n\n        def is_whole_number(self) -> bool:\n            \"\"\"Checks if the fraction represents a whole number.\"\"\"\n            return self.numerator % self.denominator == 0\n\n    class FractionParser:\n        \"\"\"Parses fraction strings into Fraction objects.\"\"\"\n        @staticmethod\n        def parse_fraction(fraction_str: str) -> Fraction:\n            parts = fraction_str.split('/')\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n            return Fraction(numerator, denominator)\n\n    x_fraction = FractionParser.parse_fraction(x)\n    n_fraction = FractionParser.parse_fraction(n)\n\n    product_fraction = x_fraction.multiply(n_fraction)\n\n    return product_fraction.is_whole_number()"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, keeping only those with prime lengths.\n    Words are separated by spaces, and their original order is preserved.\n    \"\"\"\n\n    def is_prime(number: int) -> bool:\n        \"\"\"Checks if a given number is a prime number.\"\"\"\n        if number < 2:\n            return False\n        for i in range(2, int(number**0.5) + 1):\n            if number % i == 0:\n                return False\n        return True\n\n    words = sentence.split()\n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n\n    return \" \".join(filtered_words)"}
{"task_id": "HumanEval/145", "solution": "def _calculate_digit_sum(num: int) -> int:\n    \"\"\"Calculates the sum of the digits of an integer, using its absolute value.\"\"\"\n    s = 0\n    num_abs = abs(num)\n    if num_abs == 0:\n        return 0\n    while num_abs > 0:\n        s += num_abs % 10\n        num_abs //= 10\n    return s\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If sums are equal, order them based on their original index.\n    \"\"\"\n    if not nums:\n        return []\n\n    decorated_list = []\n    for i, num in enumerate(nums):\n        digit_sum = _calculate_digit_sum(num)\n        decorated_list.append((digit_sum, i, num))\n\n    decorated_list.sort()\n\n    sorted_nums = [item[2] for item in decorated_list]\n    return sorted_nums"}
{"task_id": "HumanEval/144", "solution": "def gcd(a: int, b: int) -> int:\n    \"\"\"Calculates the greatest common divisor of two non-negative integers.\"\"\"\n    while b:\n        a, b = b, a % b\n    return a\nclass Fraction:\n    \"\"\"Represents a mathematical fraction, always simplified and with a positive denominator.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        # Normalize sign to ensure denominator is positive.\n        if denominator < 0:\n            numerator *= -1\n            denominator *= -1\n\n        # Simplify the fraction using the inline gcd function.\n        common_divisor = gcd(abs(numerator), abs(denominator))\n        self._numerator = numerator // common_divisor\n        self._denominator = denominator // common_divisor\n\n    def __repr__(self) -> str:\n        return f\"{self._numerator}/{self._denominator}\"\n\n    def __eq__(self, other: object) -> bool:\n        # Assumed 'other' will always be a Fraction object due to problem constraints.\n        return self._numerator == other._numerator and self._denominator == other._denominator\n\n    def get_numerator(self) -> int:\n        return self._numerator\n\n    def get_denominator(self) -> int:\n        return self._denominator\nclass FractionParser:\n    \"\"\"Parses a fraction string into a Fraction object.\"\"\"\n    @staticmethod\n    def parse(fraction_str: str) -> Fraction:\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return Fraction(numerator, denominator)\nclass FractionCalculator:\n    \"\"\"Performs arithmetic on Fraction objects and checks for whole numbers.\"\"\"\n    @staticmethod\n    def multiply(f1: Fraction, f2: Fraction) -> Fraction:\n        new_numerator = f1.get_numerator() * f2.get_numerator()\n        new_denominator = f1.get_denominator() * f2.get_denominator()\n        return Fraction(new_numerator, new_denominator)\n\n    @staticmethod\n    def is_whole_number(f: Fraction) -> bool:\n        return f.get_denominator() == 1\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"Determines if the product of two fractions (given as strings) is a whole number.\"\"\"\n    fraction_x = FractionParser.parse(x)\n    fraction_n = FractionParser.parse(n)\n\n    product_fraction = FractionCalculator.multiply(fraction_x, fraction_n)\n\n    return FractionCalculator.is_whole_number(product_fraction)"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums: list[int]) -> int:\n    \"\"\"\n    Counts numbers in a list that are greater than 10 and have both their first and last digits as odd numbers.\n    The absolute value of the number is used for digit extraction.\n    \"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:  # Number must be strictly greater than 10.\n            abs_num = abs(num)\n            num_str = str(abs_num)\n\n            first_digit = int(num_str[0])\n            last_digit = int(num_str[-1])\n\n            # Check if both first and last digits are odd.\n            if (first_digit % 2 != 0) and (last_digit % 2 != 0):\n                count += 1\n    return count"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits, breaking ties by original position.\n    The sum of digits for negative numbers considers their absolute value.\n    \"\"\"\n    if not nums:\n        return []\n\n    def _calculate_digit_sum(number):\n        \"\"\"\n        Calculates the sum of the absolute digits of an integer.\n        For example, _calculate_digit_sum(-12) is 1+2=3.\n        \"\"\"\n        s = 0\n        for digit in str(abs(number)):\n            s += int(digit)\n        return s\n\n    decorated_list = []\n    for index, num in enumerate(nums):\n        digit_sum = _calculate_digit_sum(num)\n        decorated_list.append((digit_sum, index, num))\n\n    decorated_list.sort()\n\n    return [item[2] for item in decorated_list]"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from an array 'a' of length 'n'\n    such that i < j < k and a[i] + a[j] + a[k] is a multiple of 3.\n    Elements a[i] are generated by the formula i * i - i + 1 (1-indexed i).\n    \"\"\"\n    counts = [0, 0, 0]  # counts for remainder 0, 1, 2\n\n    for index in range(n):\n        # a[i] = i*i - i + 1, where i is 1-indexed.\n        # For 0-indexed 'index', the 1-indexed value is 'index + 1'.\n        i_one_indexed = index + 1\n        value = i_one_indexed * i_one_indexed - i_one_indexed + 1\n        remainder = value % 3\n        counts[remainder] += 1\n\n    count0, count1, count2 = counts\n    total_triples = 0\n\n    # Case 1: All three elements have remainder 0 (sum % 3 == 0)\n    # Number of ways to choose 3 elements from count0: C(count0, 3)\n    if count0 >= 3:\n        total_triples += (count0 * (count0 - 1) * (count0 - 2)) // 6\n\n    # Case 2: All three elements have remainder 1 (sum % 3 == 3 % 3 == 0)\n    # Number of ways to choose 3 elements from count1: C(count1, 3)\n    if count1 >= 3:\n        total_triples += (count1 * (count1 - 1) * (count1 - 2)) // 6\n\n    # Case 3: All three elements have remainder 2 (sum % 3 == 6 % 3 == 0)\n    # Number of ways to choose 3 elements from count2: C(count2, 3)\n    if count2 >= 3:\n        total_triples += (count2 * (count2 - 1) * (count2 - 2)) // 6\n\n    # Case 4: One element with remainder 0, one with remainder 1, and one with remainder 2 (sum % 3 == (0+1+2) % 3 == 3 % 3 == 0)\n    total_triples += count0 * count1 * count2\n\n    return total_triples"}
{"task_id": "HumanEval/146", "solution": "def _is_odd(digit: int) -> bool:\n    \"\"\"Checks if a digit is odd.\"\"\"\n    return digit % 2 != 0\ndef _get_first_digit(num: int) -> int:\n    \"\"\"Extracts the first digit of a number, considering its absolute value.\"\"\"\n    return int(str(abs(num))[0])\ndef _get_last_digit(num: int) -> int:\n    \"\"\"Extracts the last digit of a number, considering its absolute value.\"\"\"\n    return abs(num) % 10\ndef specialFilter(nums):\n    \"\"\"Filters numbers that are greater than 10 and have odd first/last digits.\n    Returns the count of such numbers in the input array.\n    \"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = _get_first_digit(num)\n            last_digit = _get_last_digit(num)\n            if _is_odd(first_digit) and _is_odd(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/147", "solution": "import math\ndef get_max_triples(n: int) -> int:\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    # Calculate counts of indices i (1 to n) based on i % 3.\n    # num_x_mod_idx is the count of i such that i % 3 == x.\n    num_0_mod_idx = n // 3\n    num_1_mod_idx = (n - 1) // 3 + 1 if n >= 1 else 0\n    num_2_mod_idx = (n - 2) // 3 + 1 if n >= 2 else 0\n\n    # a[x] = x*x - x + 1\n    # Let's analyze a[x] % 3 based on x % 3:\n    # If x % 3 == 0: x = 3k => a[x] = (3k)^2 - 3k + 1 = 9k^2 - 3k + 1 => a[x] % 3 == 1\n    # If x % 3 == 1: x = 3k + 1 => a[x] = (3k+1)^2 - (3k+1) + 1 = 9k^2 + 6k + 1 - 3k - 1 + 1 = 9k^2 + 3k + 1 => a[x] % 3 == 1\n    # If x % 3 == 2: x = 3k + 2 => a[x] = (3k+2)^2 - (3k+2) + 1 = 9k^2 + 12k + 4 - 3k - 2 + 1 = 9k^2 + 9k + 3 => a[x] % 3 == 0\n\n    # So, a[x] % 3 == 0 if x % 3 == 2\n    # And a[x] % 3 == 1 if x % 3 == 0 or x % 3 == 1\n\n    # Count of elements a[x] where a[x] % 3 == 0 (i.e., x % 3 == 2)\n    count_elements_mod_0 = num_2_mod_idx\n    # Count of elements a[x] where a[x] % 3 == 1 (i.e., x % 3 == 0 or x % 3 == 1)\n    count_elements_mod_1 = num_0_mod_idx + num_1_mod_idx\n\n    # Triples (A, B, C) such that (A + B + C) % 3 == 0\n    # This condition is met if:\n    # 1. All three elements A, B, C have remainder 0 when divided by 3. (0 + 0 + 0) % 3 == 0\n    # 2. All three elements A, B, C have remainder 1 when divided by 3. (1 + 1 + 1) % 3 == 0\n    # 3. All three elements A, B, C have remainder 2 when divided by 3. (2 + 2 + 2) % 3 == 0 (This case is not possible here as a[x] can only be 0 or 1 mod 3)\n    # 4. One element has remainder 0, one has remainder 1, and one has remainder 2. (0 + 1 + 2) % 3 == 0 (This case is also not possible here as a[x] can only be 0 or 1 mod 3)\n\n    # Based on our analysis of a[x] % 3, the only possible remainders are 0 and 1.\n    # Therefore, we only need to consider two cases for the sum to be a multiple of 3:\n    # Case 1: All three a[i], a[j], a[k] are such that a[x] % 3 == 0.\n    #   This means all three corresponding indices i, j, k must have their (index % 3) == 2.\n    triples_from_mod_0 = math.comb(count_elements_mod_0, 3)\n\n    # Case 2: All three a[i], a[j], a[k] are such that a[x] % 3 == 1.\n    #   This means all three corresponding indices i, j, k must have their (index % 3) == 0 or (index % 3) == 1.\n    triples_from_mod_1 = math.comb(count_elements_mod_1, 3)\n\n    return triples_from_mod_0 + triples_from_mod_1"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    \"\"\"\n    Returns planets whose orbits are between planet1 and planet2, sorted by proximity to the sun.\n    Returns an empty tuple if planet names are invalid or no planets are found between them.\n    \"\"\"\n    planets_data = {\n        \"mercury\": (\"Mercury\", 0),\n        \"venus\": (\"Venus\", 1),\n        \"earth\": (\"Earth\", 2),\n        \"mars\": (\"Mars\", 3),\n        \"jupiter\": (\"Jupiter\", 4),\n        \"saturn\": (\"Saturn\", 5),\n        \"uranus\": (\"Uranus\", 6),\n        \"neptune\": (\"Neptune\", 7),\n    }\n\n    ordered_planet_names = [\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n    ]\n\n    p1_info = planets_data.get(planet1.lower())\n    p2_info = planets_data.get(planet2.lower())\n\n    if p1_info is None or p2_info is None:\n        return ()\n\n    p1_order = p1_info[1]\n    p2_order = p2_info[1]\n\n    start_order = min(p1_order, p2_order)\n    end_order = max(p1_order, p2_order)\n\n    found_planets = []\n    for i, name in enumerate(ordered_planet_names):\n        if start_order < i < end_order:\n            found_planets.append(name)\n\n    return tuple(found_planets)"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings to include only even lengths, then sorts them.\n    Strings are sorted primarily by length ascending, and secondarily alphabetically ascending.\n    \"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    sorted_result = sorted(even_length_strings, key=lambda s: (len(s), s))\n    return sorted_result"}
