{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs into a list of corresponding letter grades.\n    The conversion uses a predefined grading scale from highest GPA to lowest.\n    \"\"\"\n    GRADING_SCALE = [\n        (4.0, \"A+\"),\n        (3.700001, \"A\"),\n        (3.300001, \"A-\"),\n        (3.000001, \"B+\"),\n        (2.7, \"B\"),\n        (2.300001, \"B-\"),\n        (2.000001, \"C+\"),\n        (1.7, \"C\"),\n        (1.3, \"C-\"),\n        (1.000001, \"D+\"),\n        (0.700001, \"D\"),\n        (0.000001, \"D-\"),\n        (0.0, \"E\")\n    ]\n\n    letter_grades = []\n    for gpa in grades:\n        for threshold, grade in GRADING_SCALE:\n            if gpa >= threshold:\n                letter_grades.append(grade)\n                break\n    return letter_grades"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n\n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n\n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n\n    # Calculate the sum of the decimal digits of N\n    digit_sum = 0\n    if N == 0:\n        digit_sum = 0\n    else:\n        temp_n = N\n        while temp_n > 0:\n            digit_sum += temp_n % 10\n            temp_n //= 10\n\n    # Convert the calculated sum to its binary string representation\n    if digit_sum == 0:\n        binary_sum_str = \"0\"\n    else:\n        binary_sum_str = bin(digit_sum)[2:]\n\n    return binary_sum_str"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Sorts characters within each word of a string based on ASCII values,\n    preserving original word order and spacing.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    words = s.split(' ')\n\n    sorted_words = []\n    for word in words:\n        sorted_word = \"\".join(sorted(word))\n        sorted_words.append(sorted_word)\n\n    return ' '.join(sorted_words)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts an array of non-negative integers based on the parity of the sum of its first and last elements.\n    The original array is not modified.\n    \"\"\"\n    if len(array) < 2:\n        return array[:]\n\n    first_element = array[0]\n    last_element = array[-1]\n    sum_elements = first_element + last_element\n\n    array_copy = array[:]\n\n    if sum_elements % 2 != 0:\n        return sorted(array_copy, reverse=False)\n    else:\n        return sorted(array_copy, reverse=True)"}
{"task_id": "HumanEval/87", "solution": "from typing import Any, List, Tuple\ndef get_row(lst: List[List[Any]], x: Any) -> List[Tuple[int, int]]:\n    \"\"\"\n    Finds all occurrences of 'x' in a nested list 'lst' and returns a list of (row, column) tuples, 0-indexed.\n    The result is sorted primarily by row in ascending order and secondarily by column in descending order.\n    \"\"\"\n    coordinates: List[Tuple[int, int]] = []\n\n    for row_index, row in enumerate(lst):\n        for col_index, item in enumerate(row):\n            if item == x:\n                coordinates.append((row_index, col_index))\n\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return coordinates"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    You are given a 2 dimensional data, as a nested lists,\n    which is similar to matrix, however, unlike matrices,\n    each row may contain a different number of columns.\n    Given lst, and integer x, find integers x in the list,\n    and return list of tuples, [(x1, y1), (x2, y2) ...] such that\n    each tuple is a coordinate - (row, columns), starting with 0.\n    Sort coordinates initially by rows in ascending order.\n    Also, sort coordinates of the row by columns in descending order.\n\n    Examples:\n    get_row([\n      [1,2,3,4,5,6],\n      [1,2,3,4,1,6],\n      [1,2,3,4,5,1]\n    ], 1) == [(0, 0), (1, 4), (1, 0), (2, 5), (2, 0)]\n    get_row([], 1) == []\n    get_row([[], [1], [1, 2, 3]], 3) == [(2, 2)]\n    \"\"\"\n    found_coordinates = []\n\n    for row_idx, inner_list in enumerate(lst):\n        # Trust that inner_list is iterable, as per \"FORBIDDEN: Do NOT add isinstance() checks\"\n        for col_idx, element in enumerate(inner_list):\n            if element == x:\n                found_coordinates.append((row_idx, col_idx))\n\n    # Sort primarily by row (ascending), then by column (descending).\n    # Sorting by -coord[1] achieves descending order for the column index.\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return found_coordinates"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated.\n    \"\"\"\n    SHIFT_AMOUNT = 4\n    ALPHABET_SIZE = 26\n    encrypted_chars = []\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Handle lowercase letters with wrap-around.\n            relative_pos = ord(char) - ord('a')\n            shifted_relative_pos = (relative_pos + SHIFT_AMOUNT) % ALPHABET_SIZE\n            encrypted_chars.append(chr(ord('a') + shifted_relative_pos))\n        elif 'A' <= char <= 'Z':\n            # Handle uppercase letters with wrap-around.\n            relative_pos = ord(char) - ord('A')\n            shifted_relative_pos = (relative_pos + SHIFT_AMOUNT) % ALPHABET_SIZE\n            encrypted_chars.append(chr(ord('A') + shifted_relative_pos))\n        else:\n            # Non-alphabetic characters remain unchanged.\n            encrypted_chars.append(char)\n\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    if not array or len(array) == 1:\n        return list(array)\n\n    first_element = array[0]\n    last_element = array[-1]\n\n    if (first_element + last_element) % 2 != 0:\n        return sorted(array)\n    else:\n        return sorted(array, reverse=True)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Returns the 2nd smallest distinct element of the list.\n    Returns None if there is no such element.\n    \"\"\"\n    unique_sorted_list = sorted(list(set(lst)))\n\n    if len(unique_sorted_list) < 2:\n        return None\n    else:\n        return unique_sorted_list[1]"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string using a Caesar cipher with a rotation of 4.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n    encrypted_chars = []\n    rotation_factor = 4\n\n    for char in s:\n        if 'A' <= char <= 'Z':\n            start_code = ord('A')\n            end_code = ord('Z') # Not strictly needed for logic, but for clarity\n            char_code = ord(char)\n            shifted_code = start_code + (char_code - start_code + rotation_factor) % 26\n            encrypted_chars.append(chr(shifted_code))\n        elif 'a' <= char <= 'z':\n            start_code = ord('a')\n            end_code = ord('z') # Not strictly needed for logic, but for clarity\n            char_code = ord(char)\n            shifted_code = start_code + (char_code - start_code + rotation_factor) % 26\n            encrypted_chars.append(chr(shifted_code))\n        else:\n            encrypted_chars.append(char)\n\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/86", "solution": "import re\nfrom typing import List\nclass Token:\n    \"\"\"Abstract base class for all token types.\n    Provides a common interface for retrieving the token's raw value.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def get_value(self) -> str:\n        \"\"\"Returns the raw string value of the token.\"\"\"\n        return self._value\nclass WordToken(Token):\n    \"\"\"Represents a word from the input string.\n    Provides a method to get its characters sorted.\"\"\"\n    def __init__(self, value: str):\n        super().__init__(value)\n\n    def get_sorted_value(self) -> str:\n        \"\"\"Returns the word's characters sorted in ascending ASCII order.\"\"\"\n        return \"\".join(sorted(list(self._value)))\nclass SpaceToken(Token):\n    \"\"\"Represents a sequence of space characters.\n    Its value remains unchanged.\"\"\"\n    def __init__(self, value: str):\n        super().__init__(value)\n\n    def get_value(self) -> str:\n        \"\"\"Returns the original space sequence.\"\"\"\n        return self._value\nclass StringTokenizer:\n    \"\"\"Splits an input string into an ordered list of Token objects.\n    It identifies words and space sequences.\"\"\"\n    _WHITESPACE_PATTERN = r'(\\s+)'\n\n    def tokenize(self, input_string: str) -> List[Token]:\n        \"\"\"Takes an input string and returns a list of Token objects.\"\"\"\n        if not input_string:\n            return []\n\n        # re.split keeps the delimiters if the pattern is wrapped in parentheses.\n        parts = re.split(self._WHITESPACE_PATTERN, input_string)\n        tokens: List[Token] = []\n        for part in parts:\n            if not part:\n                continue\n            # Check if the part consists entirely of whitespace\n            if re.fullmatch(self._WHITESPACE_PATTERN, part):\n                tokens.append(SpaceToken(part))\n            else:\n                tokens.append(WordToken(part))\n        return tokens\nclass StringProcessor:\n    \"\"\"Orchestrates the entire string processing workflow.\n    It handles tokenization, word sorting, and string reconstruction.\"\"\"\n    def __init__(self, tokenizer: StringTokenizer = None):\n        \"\"\"Initializes with a StringTokenizer instance, or creates a default one.\"\"\"\n        self._tokenizer = tokenizer if tokenizer is not None else StringTokenizer()\n\n    def process_string(self, input_string: str) -> str:\n        \"\"\"Processes a string by sorting characters within words and preserving space sequences.\"\"\"\n        if not isinstance(input_string, str):\n            raise TypeError(\"Input must be a string.\")\n\n        tokens: List[Token] = self._tokenizer.tokenize(input_string)\n        processed_parts: List[str] = []\n\n        for token in tokens:\n            if isinstance(token, WordToken):\n                processed_parts.append(token.get_sorted_value())\n            elif isinstance(token, SpaceToken):\n                processed_parts.append(token.get_value())\n\n        return \"\".join(processed_parts)\ndef anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n    processor = StringProcessor()\n    return processor.process_string(s)"}
{"task_id": "HumanEval/90", "solution": "from typing import List, Optional\nclass ListProcessor:\n    def get_distinct_sorted_elements(self, lst: List[int]) -> List[int]:\n        \"\"\"\n        Takes a list of integers, removes duplicates, and returns a new list\n        with unique elements sorted in ascending order.\n        \"\"\"\n        if not lst:\n            return []\n        return sorted(list(set(lst)))\nclass NextSmallestFinder:\n    def __init__(self, list_processor: Optional[ListProcessor] = None):\n        # Initializes the finder, using a default ListProcessor if none is provided.\n        self._list_processor = list_processor if list_processor is not None else ListProcessor()\n\n    def find(self, lst: List[int]) -> Optional[int]:\n        \"\"\"\n        Returns the 2nd smallest distinct element of the list.\n        Returns None if there is no such element.\n        \"\"\"\n        distinct_sorted_list = self._list_processor.get_distinct_sorted_elements(lst)\n\n        if len(distinct_sorted_list) < 2:\n            return None\n        return distinct_sorted_list[1]\ndef next_smallest(lst: List[int]) -> Optional[int]:\n    \"\"\"\n    Returns the 2nd smallest distinct element of the list.\n    Returns None if no such element exists.\n    \"\"\"\n    finder = NextSmallestFinder()\n    return finder.find(lst)"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts sentences starting with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    if not S:\n        return 0\n\n    DELIMITERS = ['.', '?', '!']\n\n    # Simulate SentenceSplitter.split_sentences logic\n    temp_text = S\n    for delimiter in DELIMITERS:\n        temp_text = temp_text.replace(delimiter, delimiter + \"|SENTENCE_END|\")\n\n    sentences = [\n        s.strip()\n        for s in temp_text.split(\"|SENTENCE_END|\")\n        if s.strip()\n    ]\n\n    # Handle case where no delimiters were found, treat entire text as one sentence\n    if not sentences and S.strip():\n        sentences = [S.strip()]\n    elif not S.strip():\n        # If the original string was empty or just whitespace, return 0\n        return 0\n\n    # Simulate BoredomCounterService._count_boredoms logic\n    boredom_count = 0\n    for sentence in sentences:\n        if sentence.startswith(\"I\"):\n            # Check if 'I' is a standalone word at the beginning of the sentence\n            if len(sentence) == 1:\n                boredom_count += 1\n            elif sentence[1] == ' ':\n                boredom_count += 1\n            elif sentence[1] in DELIMITERS:\n                boredom_count += 1\n\n    return boredom_count"}
{"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S):\n    \"\"\"\n    Counts \"boredoms\" in a string, where a boredom is a sentence starting with \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    boredom_count = 0\n\n    # Split the text into potential sentences using the specified delimiters.\n    # re.split will return empty strings for consecutive delimiters or delimiters at ends,\n    # which will be filtered out by the subsequent processing of trimmed_sentence.\n    raw_sentences = re.split(r'[.?!]', S)\n\n    # Process each potential sentence from the split.\n    for sentence in raw_sentences:\n        # Trim leading/trailing whitespace from the current sentence segment.\n        trimmed_sentence = sentence.strip()\n\n        # If the trimmed sentence is not empty, check if its first word is \"I\".\n        if trimmed_sentence:\n            # Extract the first word using split, limiting to one split for efficiency.\n            words = trimmed_sentence.split(maxsplit=1)\n\n            # If a word was found and it is \"I\" (case-insensitive), increment the boredom count.\n            if words and words[0].lower() == \"i\":\n                boredom_count += 1\n\n    return boredom_count"}
