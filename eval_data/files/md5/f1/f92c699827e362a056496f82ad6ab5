{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"Computes the rounded average of integers from n to m and returns its binary string.\n    Returns -1 if n > m.\n    \"\"\"\n    if n > m:\n        return -1\n\n    # Calculate sum of integers in the range [n, m] using arithmetic series formula.\n    # (m - n + 1) is the count of numbers.\n    sum_val = (m - n + 1) * (n + m) // 2\n    count = m - n + 1\n\n    # Compute the floating-point average.\n    avg_float = sum_val / count\n\n    # Round the average to the nearest integer (Python's round half to even).\n    rounded_int = round(avg_float)\n\n    # Convert the rounded integer to its binary string representation.\n    return bin(rounded_int)"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"Computes the rounded average of integers in a range and converts it to binary.\n    If n is greater than m, it returns -1 as per requirements.\n    \"\"\"\n    if n > m:\n        return -1\n\n    # Calculate count of integers (FR2)\n    count = m - n + 1\n\n    # Calculate sum of integers using arithmetic series formula (FR1)\n    # (m - n + 1) * (n + m) / 2\n    total_sum = (count * (n + m)) // 2\n\n    # Compute the average (FR3)\n    average_val = total_sum / count\n\n    # Round the average to the nearest integer (FR4)\n    # Using int(value + 0.5) for \"round half up\" behavior, matching examples.\n    rounded_avg_int = int(average_val + 0.5)\n\n    # Convert the rounded integer to its binary string representation (FR5)\n    return bin(rounded_avg_int)"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x: list[int]) -> list[int]:\n    \"\"\"\n    Given a list of positive integers x, returns a new sorted list containing only\n    elements that do not have any even digits.\n    \"\"\"\n    EVEN_DIGITS = {0, 2, 4, 6, 8}\n\n    def _has_even_digit(number: int) -> bool:\n        \"\"\"\n        Checks if any digit within the given integer is an even digit.\n        Returns True if an even digit is found, False otherwise.\n        \"\"\"\n        for digit_char in str(number):\n            if int(digit_char) in EVEN_DIGITS:\n                return True\n        return False\n\n    filtered_numbers = []\n    for number in x:\n        if not _has_even_digit(number):\n            filtered_numbers.append(number)\n\n    filtered_numbers.sort()\n    return filtered_numbers"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Transforms an array of integers by filtering, sorting, reversing, and converting valid numbers to English words.\n    Only integers between 1 and 9 (inclusive) are processed.\n    \"\"\"\n    DIGIT_TO_WORD_MAP = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    filtered_numbers = [n for n in arr if 1 <= n <= 9]\n\n    if not filtered_numbers:\n        return []\n\n    filtered_numbers.sort()\n    filtered_numbers.reverse()\n\n    word_list = [DIGIT_TO_WORD_MAP[n] for n in filtered_numbers]\n\n    return word_list"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x, returns a sorted list of elements\n    that do not contain any even digits.\n    \"\"\"\n\n    def _has_even_digit(number):\n        \"\"\"Checks if any digit in the given number is even (0, 2, 4, 6, 8).\"\"\"\n        # Assumes 'number' is a positive integer, based on input constraints.\n        num_str = str(number)\n        for digit_char in num_str:\n            if int(digit_char) % 2 == 0:\n                return True\n        return False\n\n    filtered_numbers = []\n    # Trusting caller's input: 'x' is a list of positive integers.\n    for num in x:\n        if not _has_even_digit(num):\n            filtered_numbers.append(num)\n\n    filtered_numbers.sort()\n    return filtered_numbers"}
{"task_id": "HumanEval/106", "solution": "def _calculate_factorial(k: int) -> int:\n    \"\"\"Calculates the factorial of a non-negative integer k.\n    Factorial of 0 is 1, and for k > 0 it's the product of integers from 1 to k.\"\"\"\n    if k == 0:\n        return 1\n    result = 1\n    for i in range(1, k + 1):\n        result *= i\n    return result\ndef _calculate_sum_up_to(k: int) -> int:\n    \"\"\"Calculates the sum of integers from 1 up to k.\n    Uses the arithmetic series formula for efficiency.\"\"\"\n    return k * (k + 1) // 2\ndef f(n: int) -> list[int]:\n    \"\"\"Generates a sequence where elements are factorials for even indices\n    and sums for odd indices, starting with index 1.\"\"\"\n    result_list = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # Even index\n            result_list.append(_calculate_factorial(i))\n        else:  # Odd index\n            result_list.append(_calculate_sum_up_to(i))\n    return result_list"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr: list[int]) -> list[str]:\n    \"\"\"\n    Processes an array of integers by filtering, sorting, reversing, and converting valid digits (1-9) to their English word representations.\n    Numbers outside the 1-9 range are ignored, and non-numeric elements may cause errors due to strict constraints.\n    \"\"\"\n    _DIGIT_TO_WORD_MAP: dict[int, str] = {\n        1: \"One\",\n        2: \"Two\",\n        3: \"Three\",\n        4: \"Four\",\n        5: \"Five\",\n        6: \"Six\",\n        7: \"Seven\",\n        8: \"Eight\",\n        9: \"Nine\"\n    }\n\n    def is_valid_digit(num: int) -> bool:\n        \"\"\"\n        Checks if an integer is within the valid range (1-9 inclusive).\n        This function assumes 'num' is comparable to an integer without type checking.\n        \"\"\"\n        return 1 <= num <= 9\n\n    if not arr:\n        return []\n\n    # Filter integers between 1 and 9 using the nested helper function.\n    # No isinstance() check is performed as per specific instruction.\n    filtered_numbers: list[int] = [num for num in arr if is_valid_digit(num)]\n\n    if not filtered_numbers:\n        return []\n\n    # Sort the filtered integers in ascending order.\n    filtered_numbers.sort()\n\n    # Reverse the sorted array to achieve descending order.\n    filtered_numbers.reverse()\n\n    # Replace each integer with its corresponding word using the inlined map.\n    # Due to prior filtering, digits are guaranteed to be valid keys (1-9).\n    result_words: list[str] = [_DIGIT_TO_WORD_MAP[digit] for digit in filtered_numbers]\n\n    return result_words"}
{"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\"Generates a list of n elements based on index parity.\"\"\"\n    result_list = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # Even index: calculate factorial\n            factorial_val = 1\n            for j in range(1, i + 1):\n                factorial_val *= j\n            result_list.append(factorial_val)\n        else:  # Odd index: calculate sum from 1 to i\n            sum_val = i * (i + 1) // 2\n            result_list.append(sum_val)\n    return result_list"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple with the count of even and odd\n    integer palindromes in the range [1, n], inclusive.\n    \"\"\"\n    def _is_palindrome(num: int) -> bool:\n        \"\"\"Checks if a number is a palindrome by comparing its string representation.\"\"\"\n        s = str(num)\n        return s == s[::-1]\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        if _is_palindrome(i):\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        # Convert integer to string to check for palindrome property.\n        s_i = str(i)\n        if s_i == s_i[::-1]:\n            # If it's a palindrome, classify it as even or odd.\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr: list[int]) -> int:\n    \"\"\"Counts numbers in an array where the sum of their digits is greater than zero.\"\"\"\n\n    def _sum_digits(num: int) -> int:\n        \"\"\"Calculates the special digit sum for an integer.\"\"\"\n        s = str(num)\n        digit_sum = 0\n        if num < 0:\n            # First digit after '-' is negative\n            digit_sum += -int(s[1])\n            # Subsequent digits are positive\n            for digit_char in s[2:]:\n                digit_sum += int(digit_char)\n        else:\n            # All digits are positive for non-negative numbers\n            for digit_char in s:\n                digit_sum += int(digit_char)\n        return digit_sum\n\n    count = 0\n    for num in arr:\n        if _sum_digits(num) > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Determines if an array can be sorted in non-decreasing order by\n    performing right shift operations.\n    \"\"\"\n\n    def is_sorted(current_arr_to_check):\n        \"\"\"Checks if the given array is sorted in non-decreasing order.\"\"\"\n        if not current_arr_to_check or len(current_arr_to_check) == 1:\n            return True\n        for i in range(len(current_arr_to_check) - 1):\n            if current_arr_to_check[i] > current_arr_to_check[i+1]:\n                return False\n        return True\n\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    current_arr = list(arr) # Create a mutable copy\n\n    for _ in range(n): # Try up to N shifts\n        if is_sorted(current_arr):\n            return True\n\n        # Perform one right shift\n        last_element = current_arr.pop()\n        current_arr.insert(0, last_element)\n\n    return False"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts numbers in an array whose signed digit sum is greater than zero.\n    For negative numbers, the most significant digit is treated as negative.\n    \"\"\"\n    count = 0\n    for number in arr:\n        current_sum_of_digits = 0\n        if number == 0:\n            current_sum_of_digits = 0\n        else:\n            digits = []\n            is_negative = number < 0\n            abs_number = abs(number)\n\n            temp_num = abs_number\n            # Extract digits in reverse order\n            while temp_num > 0:\n                digits.append(temp_num % 10)\n                temp_num //= 10\n\n            digits.reverse() # Get digits in the correct order\n\n            if is_negative and digits:\n                # Apply negative sign to the first (most significant) digit\n                digits[0] = -digits[0]\n\n            current_sum_of_digits = sum(digits)\n\n        if current_sum_of_digits > 0:\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"\n    Determines if an array can be sorted in non-decreasing order by right shift operations.\n    An empty array is considered sorted.\n    \"\"\"\n    n = len(arr)\n\n    if n == 0:\n        return True\n\n    def is_sorted_inline(current_arr_to_check):\n        \"\"\"Checks if the given array is sorted in non-decreasing order.\"\"\"\n        if len(current_arr_to_check) <= 1:\n            return True\n        for i in range(len(current_arr_to_check) - 1):\n            if current_arr_to_check[i] > current_arr_to_check[i+1]:\n                return False\n        return True\n\n    def perform_right_shift_inline(current_arr_to_shift):\n        \"\"\"Performs a single right shift operation on the array.\"\"\"\n        if not current_arr_to_shift:\n            return []\n        return [current_arr_to_shift[-1]] + current_arr_to_shift[:-1]\n\n    current_arr = list(arr) # Create a mutable copy of the input array.\n\n    # Iterate through all possible shifts (up to n times).\n    for _ in range(n):\n        if is_sorted_inline(current_arr):\n            return True\n        current_arr = perform_right_shift_inline(current_arr)\n\n    return False"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if lst1 can become all even by exchanging elements with lst2.\n    Returns \"YES\" if possible, otherwise \"NO\".\n    \"\"\"\n    odd_count_lst1 = sum(1 for x in lst1 if x % 2 != 0)\n    even_count_lst2 = sum(1 for x in lst2 if x % 2 == 0)\n\n    if odd_count_lst1 <= even_count_lst2:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s, c):\n    \"\"\"\n    Deletes characters from string s that are present in string c, then checks if the result is a palindrome.\n    Returns the processed string and a boolean indicating if it's a palindrome.\n    \"\"\"\n    s_prime_chars = []\n    for char_s in s:\n        if char_s not in c:\n            s_prime_chars.append(char_s)\n\n    s_prime = \"\".join(s_prime_chars)\n\n    is_palindrome = (s_prime == s_prime[::-1])\n\n    return (s_prime, is_palindrome)"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if lst1 can become all even by exchanging elements with lst2.\n    It counts needed odd numbers from lst1 and available even numbers from lst2.\"\"\"\n    odd_count_lst1 = sum(1 for num in lst1 if num % 2 != 0)\n    even_count_lst2 = sum(1 for num in lst2 if num % 2 == 0)\n\n    if even_count_lst2 >= odd_count_lst1:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s, c):\n    \"\"\"\n    Deletes characters from 's' found in 'c' and checks if the resulting string is a palindrome.\n    An empty string is considered a palindrome.\n    \"\"\"\n\n    chars_to_delete = set(c)\n\n    filtered_s = \"\".join([char for char in s if char not in chars_to_delete])\n\n    is_palindrome_result = (filtered_s == filtered_s[::-1])\n\n    return (filtered_s, is_palindrome_result)"}
{"task_id": "HumanEval/111", "solution": "import re\nfrom collections import Counter\ndef histogram(test: str) -> dict:\n    \"\"\"Given a string of space-separated lowercase letters, return a dictionary of the most frequent letters and their counts.\n    If several letters have the same highest occurrence, all are included.\n    \"\"\"\n    if not test:\n        return {}\n\n    # Define a pattern for validating single lowercase letters.\n    valid_char_pattern = re.compile(r'^[a-z]$')\n\n    # Split the input string by spaces, filtering out empty tokens.\n    tokens = [token for token in test.split(' ') if token]\n\n    # Filter tokens to ensure only valid single lowercase letters are considered.\n    letters = [token for token in tokens if valid_char_pattern.match(token)]\n\n    # If no valid letters are found, return an empty dictionary.\n    if not letters:\n        return {}\n\n    # Count the frequencies of each valid letter.\n    frequencies = Counter(letters)\n\n    # Find the maximum frequency among all counted letters.\n    max_freq = 0\n    if frequencies:\n        max_freq = max(frequencies.values())\n\n    # Filter the frequencies to include only letters that match the maximum frequency.\n    result = {letter: count for letter, count in frequencies.items() if count == max_freq}\n\n    return result"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n\n    >>> odd_count(['1234567'])\n    [\"the number of odd elements 4n the str4ng 4 of the 4nput.\"]\n    >>> odd_count(['3',\"11111111\"])\n    [\"the number of odd elements 1n the str1ng 1 of the 1nput.\",\n     \"the number of odd elements 8n the str8ng 8 of the 8nput.\"]\n    \"\"\"\n    ODD_DIGITS = {'1', '3', '5', '7', '9'}\n    results = []\n\n    for digit_string in lst:\n        # Count odd digits in the current string\n        current_odd_count = 0\n        for char_digit in digit_string:\n            if char_digit in ODD_DIGITS:\n                current_odd_count += 1\n\n        # Format the output string\n        formatted_string = f\"the number of odd elements {current_odd_count}n the str{current_odd_count}ng {current_odd_count} of the {current_odd_count}nput.\"\n        results.append(formatted_string)\n\n    return results"}
{"task_id": "HumanEval/114", "solution": "import math\ndef minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array.\n    This implementation uses a modified Kadane's algorithm for O(n) performance.\n    \"\"\"\n    current_min = math.inf\n    overall_min = math.inf\n\n    for num in nums:\n        # Update current_min: either start new or extend previous sub-array.\n        current_min = min(num, current_min + num)\n        # Update overall_min with the smallest sum encountered.\n        overall_min = min(overall_min, current_min)\n\n    return overall_min"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst: list[str]) -> list[str]:\n    \"\"\"\n    Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n    \"\"\"\n    results = []\n    for digit_string in lst:\n        odd_count_value = 0\n        for char_digit in digit_string:\n            digit = int(char_digit)\n            if digit % 2 != 0:\n                odd_count_value += 1\n\n        formatted_string = f\"the number of odd elements {odd_count_value}n the str{odd_count_value}ng {odd_count_value} of the {odd_count_value}nput.\"\n        results.append(formatted_string)\n\n    return results"}
{"task_id": "HumanEval/115", "solution": "import math\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the minimum number of bucket lowering operations to empty wells.\n    Each '1' is one unit of water; all buckets have the same capacity.\n    \"\"\"\n    total_operations = 0\n    for well in grid:\n        water_units = sum(well)\n        if water_units > 0:\n            operations_for_well = math.ceil(water_units / capacity)\n            total_operations += operations_for_well\n    return total_operations"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Calculates the minimum sum of any non-empty contiguous sub-array within `nums`.\n    Assumes `nums` is a non-empty list of integers.\n    \"\"\"\n    current_min = nums[0]\n    global_min = nums[0]\n\n    for i in range(1, len(nums)):\n        current_min = min(nums[i], current_min + nums[i])\n        global_min = min(global_min, current_min)\n\n    return global_min"}
{"task_id": "HumanEval/115", "solution": "import math\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the minimum number of times buckets must be lowered to empty all wells.\n    It sums water units and applies ceiling division to determine bucket operations.\n    \"\"\"\n    total_water = 0\n    for row in grid:\n        total_water += sum(row)\n\n    if total_water == 0:\n        return 0\n    else:\n        return math.ceil(total_water / capacity)"}
{"task_id": "HumanEval/111", "solution": "def histogram(test):\n    \"\"\"Given a string of space-separated lowercase letters, return a dictionary\n    of the most frequent letter(s) and their count.\n    If multiple letters share the highest frequency, all are included.\n    \"\"\"\n    if not test.strip():\n        return {}\n\n    # Parse letters: split by space and filter for single lowercase letters\n    letters = [char for char in test.split(' ') if char.islower() and len(char) == 1]\n\n    if not letters:\n        return {}\n\n    # Count frequencies of each letter\n    frequencies = {}\n    for letter in letters:\n        frequencies[letter] = frequencies.get(letter, 0) + 1\n\n    # Find the maximum frequency\n    max_freq = 0\n    if frequencies: # Ensure frequencies is not empty before finding max\n        max_freq = max(frequencies.values())\n\n    # Filter letters that have the maximum frequency\n    result = {}\n    for letter, count in frequencies.items():\n        if count == max_freq:\n            result[letter] = count\n\n    return result"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"\n    Given a string s and a natural number n, returns a list of all words\n    from string s that contain exactly n consonants, in their original order.\n    Handles empty input strings by returning an empty list.\n    \"\"\"\n    VOWELS = \"aeiou\"\n\n    def _count_consonants(word: str) -> int:\n        \"\"\"Counts consonants in a word, ignoring non-letter characters and case.\"\"\"\n        consonant_count = 0\n        for char in word.lower():\n            if 'a' <= char <= 'z' and char not in VOWELS:\n                consonant_count += 1\n        return consonant_count\n\n    if not s:\n        return []\n\n    result_words = []\n    # Splits by any whitespace, handling multiple spaces and leading/trailing whitespace.\n    words = s.split()\n\n    for word in words:\n        if _count_consonants(word) == n:\n            result_words.append(word)\n    return result_words"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n\n    It must be implemented like this:\n    >>> sort_array([1, 5, 2, 3, 4]) == [1, 2, 3, 4, 5]\n    >>> sort_array([-2, -3, -4, -5, -6]) == [-6, -5, -4, -3, -2]\n    >>> sort_array([1, 0, 2, 3, 4]) [0, 1, 2, 3, 4]\n    \"\"\"\n    def count_set_bits(n):\n        \"\"\"\n        Counts the number of '1' bits in the binary representation of an integer.\n        Handles negative numbers by considering their absolute value's binary representation.\n        \"\"\"\n        if n == 0:\n            return 0\n        # Convert to binary, remove '0b' prefix, and count '1's\n        # For negative numbers, bin() returns '-0b...' so we take absolute value\n        return bin(abs(n)).count('1')\n\n    def generate_sort_key(num):\n        \"\"\"\n        Generates a custom sort key for a number: (bit_count, decimal_value).\n        \"\"\"\n        bit_count = count_set_bits(num)\n        return (bit_count, num)\n\n    # Use a lambda function with the custom key generator\n    return sorted(arr, key=generate_sort_key)"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    Sorts an array of integers. Non-negative numbers are sorted by binary '1' count then decimal value,\n    while negative numbers are sorted purely by decimal value.\n    \"\"\"\n\n    def _count_set_bits_local(n: int) -> int:\n        # Counts set bits for non-negative integers as per problem spec.\n        return bin(n).count('1')\n\n    if not arr:\n        return []\n\n    # Determine if array contains only non-negative or only negative numbers.\n    # No explicit error handling for mixed arrays due to \"trust caller's inputs\".\n    all_non_negative = all(n >= 0 for n in arr)\n\n    if all_non_negative:\n        # Sort non-negative numbers by (count of set bits, decimal value).\n        return sorted(arr, key=lambda x: (_count_set_bits_local(x), x))\n    else:\n        # If not all non-negative, implicitly assumes all are negative due to \"trust caller's inputs\"\n        # and no error handling for mixed arrays. Sort purely by decimal value.\n        return sorted(arr)"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel from the right surrounded by two consonants (case sensitive).\n    Vowels at word boundaries are excluded; returns an empty string if none found.\n    \"\"\"\n    VOWELS_LOWER = \"aeiou\"\n\n    def _is_vowel(char: str) -> bool:\n        return char.lower() in VOWELS_LOWER\n\n    def _is_consonant(char: str) -> bool:\n        return char.isalpha() and not _is_vowel(char)\n\n    n = len(word)\n    if n < 3:\n        return \"\"\n\n    # Iterate from right to left, excluding the first and last characters (FR7)\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n\n        if _is_vowel(current_char):\n            left_char = word[i - 1]\n            right_char = word[i + 1]\n\n            if _is_consonant(left_char) and _is_consonant(right_char):\n                return current_char\n\n    return \"\""}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel surrounded by two consonants from the right.\n    Returns the vowel (case-sensitive) or an empty string if not found.\n    \"\"\"\n    VOWELS_SET = {'a', 'e', 'i', 'o', 'u'}\n\n    def _is_vowel(char_to_check: str) -> bool:\n        \"\"\"Checks if a character is an English vowel (case-insensitive).\"\"\"\n        return char_to_check.lower() in VOWELS_SET\n\n    def _is_consonant(char_to_check: str) -> bool:\n        \"\"\"Checks if a character is an English consonant (case-insensitive).\"\"\"\n        return char_to_check.isalpha() and not _is_vowel(char_to_check)\n\n    n = len(word)\n    if n < 3:\n        return \"\"\n\n    # Iterate from the second-to-last character down to the second character (index 1)\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n\n        # Check if the current character is a vowel\n        if _is_vowel(current_char):\n            left_char = word[i - 1]\n            right_char = word[i + 1]\n\n            # Check if its immediate left and right neighbors are consonants\n            if _is_consonant(left_char) and _is_consonant(right_char):\n                return current_char\n\n    return \"\""}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if concatenating two strings of parentheses in any order\n    can form a balanced parentheses string.\n    \"\"\"\n    def is_balanced(s: str) -> bool:\n        \"\"\"\n        Determines if a string of parentheses is balanced.\n        It uses a balance counter to track open and close parentheses.\n        \"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    s1, s2 = lst[0], lst[1]\n\n    if is_balanced(s1 + s2):\n        return 'Yes'\n\n    if is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if two strings of parentheses can form a balanced string when concatenated.\n    Returns 'Yes' if a balanced string can be formed, 'No' otherwise.\n    \"\"\"\n\n    def _is_balanced(s: str) -> bool:\n        \"\"\"\n        Helper function to determine if a single string of parentheses is balanced.\n        It uses a balance counter to check the rules for balanced parentheses.\n        \"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:  # char is ')'\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    s1, s2 = lst[0], lst[1]\n\n    if _is_balanced(s1 + s2) or _is_balanced(s2 + s1):\n        return 'Yes'\n    return 'No'"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"\n    Selects words from a string that have exactly n consonants.\n    Returns words in their original order.\n    \"\"\"\n\n    if not s:\n        return []\n\n    # VOWELS constant defined within the function's scope.\n    VOWELS = \"aeiouAEIOU\"\n\n    def _count_consonants(word_param: str) -> int:\n        \"\"\"\n        Counts consonants in a word.\n        A consonant is any letter not in the VOWELS set.\n        \"\"\"\n        consonant_count = 0\n        for char in word_param:\n            if char.isalpha() and char not in VOWELS:\n                consonant_count += 1\n        return consonant_count\n\n    result_words = []\n    # Tokenize the input string using spaces as delimiters.\n    words = s.split()\n\n    for word in words:\n        # Count consonants for each word.\n        consonant_count = _count_consonants(word)\n\n        # Select words where consonant count matches n.\n        if consonant_count == n:\n            result_words.append(word)\n\n    return result_words"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a non-negative integer k,\n    returns a sorted list of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Sort the array in descending order to easily pick the largest k elements.\n    arr.sort(reverse=True)\n\n    # Select the first k elements, which are the k largest.\n    k_largest = arr[:k]\n\n    # Sort these k elements in ascending order as required.\n    k_largest.sort()\n\n    return k_largest"}
