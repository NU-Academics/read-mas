{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    Coefficients are ordered from lowest degree to highest.\\n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list):\n    \"\"\"\n    Finds a single real zero of a polynomial given its coefficients.\n    Uses the bisection method within a default range and tolerance.\n    \"\"\"\n    DEFAULT_TOLERANCE: float = 1e-6\n    DEFAULT_MAX_ITERATIONS: int = 100\n    DEFAULT_SEARCH_RANGE: tuple[float, float] = (-100.0, 100.0)\n\n    # Wrap the poly function to fit the bisection method's signature\n    def _polynomial_function_wrapper(x_val: float) -> float:\n        return poly(xs, x_val)\n\n    a = DEFAULT_SEARCH_RANGE[0]\n    b = DEFAULT_SEARCH_RANGE[1]\n    tol = DEFAULT_TOLERANCE\n    max_iter = DEFAULT_MAX_ITERATIONS\n\n    fa = _polynomial_function_wrapper(a)\n    fb = _polynomial_function_wrapper(b)\n\n    # As per critical requirements, no error checks like fa*fb > 0 are performed.\n    # The function proceeds assuming the problem's guarantee of a solution.\n\n    c = (a + b) / 2.0 # Initialize c for potential return if loop doesn't run or converges late\n\n    for _ in range(max_iter):\n        c = (a + b) / 2.0\n        fc = _polynomial_function_wrapper(c)\n\n        if abs(fc) < tol:\n            return c\n\n        if fa * fc < 0:\n            b = c\n            # fb = fc is not strictly needed if fa is always kept updated based on a\n        else:\n            a = c\n            fa = fc\n\n    # As per critical requirements, no exception is raised if method fails to converge.\n    # Returns the last calculated midpoint as the closest estimate.\n    return c"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"Return the count of '7's in numbers less than n which are divisible by 11 or 13.\"\"\"\n\n    total_sevens_count = 0\n    for i in range(1, n):\n        if (i % 11 == 0) or (i % 13 == 0):\n            current_number_sevens = 0\n            num_str = str(i)\n            for char_digit in num_str:\n                if int(char_digit) == 7:\n                    current_number_sevens += 1\n            total_sevens_count += current_number_sevens\n    return total_sevens_count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"This function sorts elements at even indices of a list in ascending order.\n    Odd-indexed elements retain their original positions in the returned new list.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    even_indexed_elements = [l[i] for i in range(0, len(l), 2)]\n    sorted_even_elements = sorted(even_indexed_elements)\n\n    result_list = l[:]  # Create a shallow copy to preserve odd-indexed elements.\n    sorted_idx = 0\n    for i in range(0, len(l), 2):\n        result_list[i] = sorted_even_elements[sorted_idx]\n        sorted_idx += 1\n\n    return result_list"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n    sorted_even_elements = sorted(even_elements)\n\n    result = list(l)\n\n    even_idx_ptr = 0\n    for i in range(0, len(result), 2):\n        result[i] = sorted_even_elements[even_idx_ptr]\n        even_idx_ptr += 1\n\n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    This function processes numbers from 1 up to n-1.\n    \"\"\"\n\n    def _count_digit_in_number(number: int, digit: int) -> int:\n        \"\"\"Counts occurrences of a specific digit in a number.\n        Converts the number to a string to facilitate digit counting.\n        \"\"\"\n        count = 0\n        num_str = str(number)\n        for char in num_str:\n            if int(char) == digit:\n                count += 1\n        return count\n\n    total_sevens = 0\n    # Iterate through all integers i such that 1 <= i < n.\n    for i in range(1, n):\n        # Determine if i is divisible by 11 or 13.\n        if (i % 11 == 0) or (i % 13 == 0):\n            # If divisible, count occurrences of digit '7' within i.\n            total_sevens += _count_digit_in_number(i, 7)\n\n    # Return the final accumulated count.\n    return total_sevens"}
