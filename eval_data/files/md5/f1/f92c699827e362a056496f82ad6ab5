{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    '''\n    Compares two lists of strings based on their total character count.\n    Returns the list with the smaller total number of characters, or lst1 on a tie.\n    '''\n    def _calculate_total_chars(lst):\n        '''\n        Calculates the sum of the lengths of all strings within a list.\n        This helper function efficiently sums string lengths using a generator expression.\n        '''\n        return sum(len(s) for s in lst)\n\n    total_chars_lst1 = _calculate_total_chars(lst1)\n    total_chars_lst2 = _calculate_total_chars(lst2)\n\n    if total_chars_lst1 <= total_chars_lst2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/77", "solution": "import math\ndef iscube(a):\n    \"\"\"\n    Checks if the given integer 'a' is a perfect cube.\n    Handles positive, negative, and zero inputs efficiently.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Determine the sign of 'a' to reapply after calculating the cube root of its absolute value.\n    sign = 1 if a >= 0 else -1\n    abs_a = abs(a)\n\n    # Calculate the cube root and round to the nearest integer to mitigate floating-point inaccuracies.\n    potential_root = round(math.cbrt(abs_a)) * sign\n\n    # Check if cubing the potential_root yields the original number 'a'.\n    return potential_root ** 3 == a"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Checks if the given integer 'a' is a cube of some integer number.\n    Returns True if 'a' is a perfect cube, False otherwise.\n    \"\"\"\n    if a == 0:\n        return True\n\n    abs_a = abs(a)\n    cbrt_a_approx = round(abs_a**(1/3))\n\n    return cbrt_a_approx * cbrt_a_approx * cbrt_a_approx == abs_a"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"\n    Checks if x is a simple power of n, meaning n**k = x for some non-negative integer k.\n    \"\"\"\n    if x == 1:\n        # 1 is n^0 for any n except 0.\n        return n != 0\n\n    if n == 0:\n        # 0^k = 0 for k > 0.\n        return x == 0\n\n    if n == 1:\n        # 1^k = 1 for any k.\n        return x == 1\n\n    # Optimization: if x is less than n (and not 1), it cannot be a power of n for n > 1.\n    if x < n:\n        return False\n\n    # Repeatedly divide x by n until it's no longer divisible or becomes 1.\n    current_x = x\n    while current_x > 1 and current_x % n == 0:\n        current_x //= n\n\n    return current_x == 1"}
{"task_id": "HumanEval/76", "solution": "import math\ndef is_simple_power(x, n):\n    \"\"\"Checks if a number x is a simple power of n.\n    Returns True if n^k = x for some non-negative integer k.\"\"\"\n\n    # Define tolerance for floating point comparisons\n    FLOAT_TOLERANCE = 1e-9\n\n    # Handle x = 1 explicitly (n^0 = 1 for any n)\n    if x == 1:\n        return True\n\n    # Handle n = 1: only x = 1 is a power of 1 (covered above)\n    if n == 1:\n        return False\n\n    # Handle non-positive bases or non-positive x (when x is not 1)\n    if n <= 0 or x <= 0:\n        return False\n\n    # Calculate log_n(x) using natural logarithm properties\n    exponent = math.log(x) / math.log(n)\n\n    # Check if the exponent is an integer within tolerance\n    return abs(exponent - round(exponent)) < FLOAT_TOLERANCE"}
