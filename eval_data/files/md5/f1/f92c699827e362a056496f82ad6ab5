{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    An element has at most two digits if its absolute value is between -99 and 99 inclusive.\n    \"\"\"\n\n    # Consider only the first k elements of arr\n    sub_array = arr[:k]\n\n    # Identify elements with at most two digits and sum them\n    total_sum = 0\n    for num in sub_array:\n        if -99 <= num <= 99:\n            total_sum += num\n\n    return total_sum"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n\n    The Collatz conjecture states that the sequence always reaches 1.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    # Generate the Collatz sequence\n    sequence = []\n    current = n\n    while current != 1:\n        sequence.append(current)\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n    sequence.append(1) # Ensure 1 is always included\n\n    # Filter and collect unique odd numbers\n    odd_numbers = set()\n    for num in sequence:\n        if num % 2 != 0:\n            odd_numbers.add(num)\n\n    # Convert to a list and sort it\n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    total_sum = 0\n    # Iterate through the first k elements of the array.\n    for i in range(k):\n        element = arr[i]\n        # Check if the absolute value of the element is less than 100.\n        if -99 <= element <= 99:\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n: int) -> list[int]:\n    \"\"\"\n    Given a positive integer n, returns a sorted list that has the odd numbers in its Collatz sequence.\n    The sequence is generated until it reaches 1, and the odd numbers are collected and sorted.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    sequence = [n]\n    current = n\n    while current != 1:\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n        sequence.append(current)\n\n    odd_numbers = sorted(list(set(num for num in sequence if num % 2 != 0)))\n    return odd_numbers"}
{"task_id": "HumanEval/125", "solution": "import re\ndef split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    '''\n    if re.search(r'\\s', txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    count += 1\n        return count"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Splits a string based on whitespace, then commas, or counts odd-ordered lowercase letters.\n    The splitting logic follows a strict precedence: whitespace, then comma, then character counting.\n    '''\n\n    # Check if the string contains any whitespace characters.\n    has_whitespace = False\n    for char in txt:\n        if char.isspace():\n            has_whitespace = True\n            break\n\n    if has_whitespace:\n        return txt.split()\n\n    # If no whitespace, check if the string contains any comma characters.\n    if ',' in txt:\n        return txt.split(',')\n\n    # If neither whitespace nor commas, count lowercase letters with odd alphabetical order.\n    count = 0\n    alphabet_start_ord = ord('a')\n    for char in txt:\n        if 'a' <= char <= 'z':\n            order = ord(char) - alphabet_start_ord\n            if order % 2 != 0:\n                count += 1\n    return count"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"Validates a date string in \"mm-dd-yyyy\" format.\n    Ensures non-empty, correct format, valid month (1-12), and valid day for the month.\n    \"\"\"\n    if not date:\n        return False\n\n    try:\n        parts = date.split('-')\n        if len(parts) != 3:\n            return False\n\n        month_str, day_str, year_str = parts\n        month = int(month_str)\n        day = int(day_str)\n        year = int(year_str)\n    except ValueError:\n        return False\n\n    if not (1 <= month <= 12):\n        return False\n\n    if not (1 <= day):\n        return False\n\n    if month in [1, 3, 5, 7, 8, 10, 12]:\n        if not (day <= 31):\n            return False\n    elif month in [4, 6, 9, 11]:\n        if not (day <= 30):\n            return False\n    elif month == 2:\n        if not (day <= 29):\n            return False\n\n    return True"}
{"task_id": "HumanEval/124", "solution": "import re\ndef valid_date(date):\n    \"\"\"\n    Validates a given date string according to specific rules:\n    non-empty, mm-dd-yyyy format, valid month (1-12), and valid day for the month.\n    \"\"\"\n    # 1. The date string is not empty.\n    if not date:\n        return False\n\n    # 4. The date should be in the format: mm-dd-yyyy\n    date_format_regex = r\"^\\d{2}-\\d{2}-\\d{4}$\"\n    if not re.match(date_format_regex, date):\n        return False\n\n    try:\n        month_str, day_str, year_str = date.split('-')\n        month = int(month_str)\n        day = int(day_str)\n        # Year is parsed but not further validated beyond format rules.\n        _ = int(year_str)\n    except ValueError:\n        # This handles cases where split parts might not convert to int,\n        # though regex matching should largely prevent it.\n        return False\n\n    # 3. The months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # 2. Validate day component based on month rules.\n    # Max days for each month, with February having 29 days as per requirement.\n    days_in_month = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n        4: 30, 6: 30, 9: 30, 11: 30,\n        2: 29\n    }\n\n    if month not in days_in_month:\n        # This should ideally not be reached if month validation passed.\n        return False\n\n    max_days = days_in_month[month]\n    if not (1 <= day <= max_days):\n        return False\n\n    return True"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False.\n    '''\n    if len(lst) <= 1:\n        return True\n\n    # Check for ascending order.\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check for duplicate constraint: each number can appear at most twice.\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    return True"}
{"task_id": "HumanEval/126", "solution": "import collections\ndef is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n\n    Examples\n    is_sorted([5]) \u279e True\n    is_sorted([1, 2, 3, 4, 5]) \u279e True\n    is_sorted([1, 3, 2, 4, 5]) \u279e False\n    is_sorted([1, 2, 3, 4, 5, 6]) \u279e True\n    is_sorted([1, 2, 3, 4, 5, 6, 7]) \u279e True\n    is_sorted([1, 3, 2, 4, 5, 6, 7]) \u279e False\n    is_sorted([1, 2, 2, 3, 3, 4]) \u279e True\n    is_sorted([1, 2, 2, 2, 3, 4]) \u279e False\n    '''\n    # Empty lists or lists with a single element are considered sorted.\n    if len(lst) < 2:\n        return True\n\n    # Check if the list is sorted in ascending order.\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check the duplicate constraint: no number appears more than twice.\n    counts = collections.Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    return True"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of all signs.\n    Returns None for an empty array.\n    \"\"\"\n    def _get_sign(n):\n        if n > 0:\n            return 1\n        elif n < 0:\n            return -1\n        else:\n            return 0\n\n    def _get_magnitude(n):\n        return abs(n)\n\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        product_of_signs *= _get_sign(num)\n        sum_of_magnitudes += _get_magnitude(num)\n\n    return sum_of_magnitudes * product_of_signs"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"\n    Determines whether the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" if the length is prime, \"NO\" otherwise, or \"NO\" if there is no intersection.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"\n        Checks if a given non-negative integer is a prime number.\n        It implements an efficient primality test for numbers up to its square root.\n        \"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    start1, end1 = interval1[0], interval1[1]\n    start2, end2 = interval2[0], interval2[1]\n\n    # Calculate the intersection of the two intervals\n    max_start = max(start1, start2)\n    min_end = min(end1, end2)\n\n    # If max_start is greater than min_end, there is no intersection\n    if max_start > min_end:\n        return \"NO\"\n\n    # Calculate the length of the intersection interval\n    length = min_end - max_start\n\n    # Check if the calculated length is a prime number\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/127", "solution": "import math\ndef intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two\n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if the given integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    s1, e1 = interval1[0], interval1[1]\n    s2, e2 = interval2[0], interval2[1]\n\n    intersection_start = max(s1, s2)\n    intersection_end = min(e1, e2)\n\n    if intersection_start >= intersection_end:\n        length = 0\n    else:\n        length = intersection_end - intersection_start\n\n    if is_prime(length):\n        return 'YES'\n    else:\n        return 'NO'"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of their signs.\n    Returns None if the input array is empty.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = sum(abs(x) for x in arr)\n\n    product_signs = 1\n    for num in arr:\n        sign_val = 0\n        if num > 0:\n            sign_val = 1\n        elif num < 0:\n            sign_val = -1\n        # If num is 0, sign_val remains 0.\n        product_signs *= sign_val\n\n    return sum_magnitudes * product_signs"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of its odd digits.\n    Returns 0 if all digits are even.\"\"\"\n    product = 1\n    has_odd_digit = False\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:\n            product *= digit\n            has_odd_digit = True\n\n    if not has_odd_digit:\n        return 0\n    return product"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    product = 1\n    has_odd_digit = False\n\n    # Iterate through digits by converting number to string.\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:  # Check if digit is odd.\n            product *= digit\n            has_odd_digit = True\n\n    return product if has_odd_digit else 0"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n + 1 Tribonacci numbers.\n    Uses memoization for efficient computation of recursive calls.\n    \"\"\"\n    sequence = []\n    memo = {}\n\n    def _calculate_tribonacci_value(k):\n        \"\"\"Recursively calculates a single Tribonacci number tri(k) using memoization.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        result = 0.0\n        if k == 0:\n            result = 1.0\n        elif k == 1:\n            result = 3.0\n        elif k % 2 == 0:  # k is even and k > 1\n            result = 1.0 + k / 2.0\n        else:  # k is odd and k > 1\n            result = (\n                _calculate_tribonacci_value(k - 1)\n                + _calculate_tribonacci_value(k - 2)\n                + _calculate_tribonacci_value(k + 1)\n            )\n\n        memo[k] = result\n        return result\n\n    for i in range(n + 1):\n        sequence.append(_calculate_tribonacci_value(i))\n    return sequence"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in\n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8\n    You are given a non-negative integer number n, you have to a return a list of the\n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    if n < 0:\n        return []\n\n    # Initialize the list to store the Tribonacci sequence.\n    # We need n + 1 numbers, from tri(0) to tri(n).\n    trib_sequence = [0] * (n + 1)\n\n    # Base case for tri(0) derived from example: tri(3) = [1, 3, 2, 8] implies tri(0) = 1\n    if n >= 0:\n        trib_sequence[0] = 1\n\n    # Base case for tri(1)\n    if n >= 1:\n        trib_sequence[1] = 3\n\n    # Calculate subsequent Tribonacci numbers\n    for i in range(2, n + 1):\n        if i % 2 == 0:  # i is even\n            # Use integer division as per example output\n            trib_sequence[i] = 1 + i // 2\n        else:  # i is odd\n            # To calculate tri(i) when i is odd, we need tri(i+1).\n            # Since i is odd, i+1 is even, so tri(i+1) can be calculated directly.\n            # Use integer division for tri(i+1) calculation\n            tri_i_plus_1_val = 1 + (i + 1) // 2\n            trib_sequence[i] = trib_sequence[i-1] + trib_sequence[i-2] + tri_i_plus_1_val\n\n    return trib_sequence"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k,\n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n    N = len(grid)\n    min_path_result = None\n\n    def dfs(r, c, current_path_values):\n        nonlocal min_path_result\n\n        # Pruning: If the current partial path is already lexicographically greater than the best path found so far, prune this branch.\n        if min_path_result is not None and current_path_values > min_path_result[:len(current_path_values)]:\n            return\n\n        # Base case: A path of desired length k is formed.\n        if len(current_path_values) == k:\n            if min_path_result is None or current_path_values < min_path_result:\n                min_path_result = list(current_path_values) # Store a copy of the path.\n            return\n\n        # Explore neighbors: up, down, left, right movements.\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n        for dr, dc in directions:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < N and 0 <= nc < N: # Check if the neighbor is within grid boundaries.\n                next_value = grid[nr][nc]\n                dfs(nr, nc, current_path_values + [next_value])\n\n    # Start the DFS from every possible cell in the grid.\n    for r_start in range(N):\n        for c_start in range(N):\n            dfs(r_start, c_start, [grid[r_start][c_start]])\n\n    return min_path_result"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    balance = 0\n    current_max_balance = 0\n    overall_max_depth_of_valid_sequences = 0\n\n    for char in string:\n        if char == '[':\n            balance += 1\n            current_max_balance = max(current_max_balance, balance)\n        elif char == ']':\n            if balance > 0:\n                balance -= 1\n                if balance == 0:\n                    overall_max_depth_of_valid_sequences = max(overall_max_depth_of_valid_sequences, current_max_balance)\n                    current_max_balance = 0\n            else:\n                # Unmatched closing bracket or balance already 0, reset for a new potential segment\n                balance = 0\n                current_max_balance = 0\n\n    # The final check determines if any *completed* valid sequence achieved a depth of 2 or more.\n    # An open 'balance' at the end means the last segment was not valid.\n    return overall_max_depth_of_valid_sequences >= 2"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squares of numbers in a list, after rounding each number up.\n    Each element is rounded to the nearest upper integer (ceiling) before squaring.\n    \"\"\"\n    squared_sum = 0\n    for num in lst:\n        rounded_num = math.ceil(num)\n        squared_sum += rounded_num * rounded_num\n    return squared_sum"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squares for a list of numbers.\n    Each number is first rounded up to the nearest integer (ceiling).\"\"\"\n    total_sum = 0\n    for number in lst:\n        rounded_num = math.ceil(number)\n        total_sum += rounded_num ** 2\n    return total_sum"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Returns True if the last character of a given string is an alphabetical character and is not a part of a word, and False otherwise.\n    A word is defined as a group of characters separated by space.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    # Check if it's an isolated letter (not part of a word).\n    # It's isolated if it's the only character, or if the character before it is a space.\n    if len(txt) == 1:\n        return True\n    elif txt[-2] == ' ':\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets\n    where at least one bracket in the subsequence is nested.\n    '''\n\n    def _is_valid_bracket_sequence(s: str) -> bool:\n        \"\"\"\n        Checks if a string is a valid bracket sequence using a stack.\n        e.g., '[]' -> True, '][ ' -> False.\n        \"\"\"\n        stack = []\n        for char in s:\n            if char == '[':\n                stack.append(char)\n            elif char == ']':\n                if not stack:\n                    return False\n                stack.pop()\n        return not stack\n\n    n = len(string)\n    for i in range(n):\n        if string[i] == '[':\n            for j in range(i + 1, n):\n                if string[j] == ']':\n                    inner_content = string[i+1:j]\n                    # Check if the inner content is non-empty and a valid bracket sequence.\n                    if inner_content and _is_valid_bracket_sequence(inner_content):\n                        return True\n    return False"}
{"task_id": "HumanEval/129", "solution": "import heapq\nfrom typing import List, Tuple\ndef is_valid_coordinate(row: int, col: int, N: int) -> bool:\n    \"\"\"Checks if a given (row, col) is within the N x N grid boundaries.\"\"\"\n    return 0 <= row < N and 0 <= col < N\nclass Coordinate:\n    def __init__(self, row: int, col: int) -> None:\n        self.row = row\n        self.col = col\n\n    def __hash__(self) -> int:\n        return hash((self.row, self.col))\n\n    def __eq__(self, other: object) -> bool:\n        # Trusting input as per requirements, assuming 'other' is Coordinate\n        return self.row == other.row and self.col == other.col\n\n    def __repr__(self) -> str:\n        return f\"({self.row}, {self.col})\"\nclass Grid:\n    def __init__(self, grid_data: List[List[int]]) -> None:\n        self._grid_data = grid_data\n        self._N = len(grid_data)\n\n    def get_value(self, row: int, col: int) -> int:\n        return self._grid_data[row][col]\n\n    def get_neighbors(self, row: int, col: int) -> List[Coordinate]:\n        neighbors: List[Coordinate] = []\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n\n        for dr, dc in directions:\n            new_row, new_col = row + dr, col + dc\n            if is_valid_coordinate(new_row, new_col, self._N):\n                neighbors.append(Coordinate(new_row, new_col))\n        return neighbors\n\n    def get_N(self) -> int:\n        return self._N\nclass Path:\n    def __init__(self, initial_value: int, initial_coord: Coordinate) -> None:\n        self._values: List[int] = [initial_value]\n        self._coordinates: List[Coordinate] = [initial_coord]\n\n    def append(self, value: int, coord: Coordinate) -> None:\n        self._values.append(value)\n        self._coordinates.append(coord)\n\n    def get_values(self) -> List[int]:\n        return self._values\n\n    def get_last_coordinate(self) -> Coordinate:\n        return self._coordinates[-1]\n\n    def get_length(self) -> int:\n        return len(self._values)\n\n    def clone(self) -> 'Path':\n        new_path = Path(self._values[0], self._coordinates[0])\n        new_path._values = list(self._values)\n        new_path._coordinates = list(self._coordinates)\n        return new_path\n\n    def __lt__(self, other: 'Path') -> bool:\n        # Lexicographical comparison for paths.\n        return self.get_values() < other.get_values()\n\n    def __eq__(self, other: object) -> bool:\n        # Trusting input as per requirements, assuming 'other' is Path\n        return self.get_values() == other.get_values()\n\n    def __repr__(self) -> str:\n        return f\"Path(values={self._values}, coords={self._coordinates})\"\nclass MinPathFinder:\n    def find_min_path(self, grid_data: List[List[int]], k: int) -> List[int]:\n        grid = Grid(grid_data)\n        N = grid.get_N()\n\n        # Priority queue stores (path_values_tuple, path_object)\n        pq: List[Tuple[Tuple[int, ...], Path]] = []\n\n        for r in range(N):\n            for c in range(N):\n                initial_coord = Coordinate(r, c)\n                initial_value = grid.get_value(r, c)\n                initial_path = Path(initial_value, initial_coord)\n                heapq.heappush(pq, (tuple(initial_path.get_values()), initial_path))\n\n        while pq:\n            current_path_values_tuple, current_path = heapq.heappop(pq)\n\n            if current_path.get_length() == k:\n                # The first path of length k popped from the priority queue is the answer.\n                return current_path.get_values()\n\n            # Paths longer than k are not needed.\n            if current_path.get_length() > k:\n                continue\n\n            last_coord = current_path.get_last_coordinate()\n            neighbors = grid.get_neighbors(last_coord.row, last_coord.col)\n\n            for neighbor_coord in neighbors:\n                neighbor_value = grid.get_value(neighbor_coord.row, neighbor_coord.col)\n                new_path = current_path.clone()\n                new_path.append(neighbor_value, neighbor_coord)\n                heapq.heappush(pq, (tuple(new_path.get_values()), new_path))\n\n        # This part should ideally not be reached given problem constraints (k is positive).\n        return []\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k,\n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n    \"\"\"\n    finder = MinPathFinder()\n    return finder.find_min_path(grid, k)"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an isolated alphabetical character.\n    An isolated letter is either the only character or preceded by a space.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    char_before_last = txt[-2]\n    return char_before_last == ' '"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst: list[int]) -> tuple[int | None, int | None]:\n    \"\"\"\n    Returns a tuple (a, b) where 'a' is the largest negative and 'b' is the smallest positive integer in 'lst'.\n    If no such integers exist, 'None' is returned for that part.\n    \"\"\"\n    largest_neg = None\n    smallest_pos = None\n\n    for num in lst:\n        if num < 0:\n            if largest_neg is None or num > largest_neg:\n                largest_neg = num\n        elif num > 0:\n            if smallest_pos is None or num < smallest_pos:\n                smallest_pos = num\n\n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr: list[int]) -> int:\n    \"\"\"Returns the largest index of an element which is not greater than or\n    equal to the element immediately preceding it. Returns -1 if no such element exists.\n    \"\"\"\n    if not arr or len(arr) < 2:\n        return -1\n\n    # Iterate from right to left to find the largest index efficiently.\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i-1]:\n            return i\n    return -1"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Returns the largest index where an element is smaller than its predecessor.\n    Returns -1 if the array is sorted or has fewer than two elements.\"\"\"\n\n    if len(arr) < 2:\n        return -1\n\n    # Iterate from the second-to-last element down to the first.\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i - 1]:\n            return i\n    return -1"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Finds the largest negative and smallest positive integers in a list.\n    Returns (largest_negative, smallest_positive) or None for missing values.\n    \"\"\"\n    largest_neg = None\n    smallest_pos = None\n\n    for num in lst:\n        if num < 0:\n            if largest_neg is None or num > largest_neg:\n                largest_neg = num\n        elif num > 0:\n            if smallest_pos is None or num < smallest_pos:\n                smallest_pos = num\n\n    return (largest_neg, smallest_pos)"}
