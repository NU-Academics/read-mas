{"task_id": "HumanEval/148", "solution": "SOLAR_SYSTEM_PLANETS = (\n    \"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n    \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n)\ndef bf(planet1: str, planet2: str) -> tuple[str, ...]:\n    \"\"\"\n    Returns planets between planet1 and planet2, sorted by proximity to the sun.\n    Returns an empty tuple if either planet is invalid.\n    \"\"\"\n    if planet1 not in SOLAR_SYSTEM_PLANETS or planet2 not in SOLAR_SYSTEM_PLANETS:\n        return ()\n\n    index1 = SOLAR_SYSTEM_PLANETS.index(planet1)\n    index2 = SOLAR_SYSTEM_PLANETS.index(planet2)\n\n    if abs(index1 - index2) <= 1:\n        return ()\n\n    start_index = min(index1, index2)\n    end_index = max(index1, index2)\n\n    return SOLAR_SYSTEM_PLANETS[start_index + 1:end_index]"}
{"task_id": "HumanEval/150", "solution": "import math\ndef x_or_y(n, x, y):\n    \"\"\"Returns x if n is a prime number, and y otherwise.\"\"\"\n\n    def is_prime(num):\n        \"\"\"Checks if a number is prime using an efficient algorithm.\"\"\"\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"Returns x if n is a prime number, otherwise returns y.\n    Assumes n is an integer.\n    \"\"\"\n\n    def _is_prime(num):\n        \"\"\"Determines if a number is prime.\"\"\"\n        if num <= 1:\n            return False\n        if num <= 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n\n        # Check for factors from 5 up to sqrt(num) using 6k \u00b1 1 optimization.\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    if _is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"\n    Compares actual game scores to user guesses and returns a list of absolute differences.\n    Each element indicates how far off the corresponding guess was.\n    \"\"\"\n    differences = []\n    for i in range(len(game)):\n        diff = abs(game[i] - guess[i])\n        differences.append(diff)\n    return differences"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Calculates the sum of squares of odd, positive integers from a list.\n    Non-integer, negative, or even numbers are ignored.\n    \"\"\"\n    total_sum = 0\n    if not lst:\n        return 0\n\n    for num in lst:\n        # Check if it's an integer\n        if not isinstance(num, int):\n            continue\n        # Check if it's positive\n        if num <= 0:\n            continue\n        # Check if it's odd\n        if num % 2 == 0:\n            continue\n\n        total_sum += num * num\n\n    return total_sum"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n\n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0\n\n    If the input list is empty, return 0.\n    '''\n    total_sum = 0\n\n    if not lst:\n        return 0\n\n    for item in lst:\n        # Ignore non-integer types\n        if not isinstance(item, int):\n            continue\n\n        # Ignore non-positive numbers including zero.\n        if item <= 0:\n            continue\n\n        # If a positive number is odd, calculate its square and add to sum.\n        if item % 2 != 0:\n            total_sum += item * item\n\n    return total_sum"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Determine how far off each guess was for a series of matches.\n    Returns an array of absolute differences, with 0 for correct guesses.\n    \"\"\"\n    result = []\n    for i in range(len(game)):\n        game_score = game[i]\n        guess_score = guess[i]\n        if game_score == guess_score:\n            result.append(0)\n        else:\n            result.append(abs(game_score - guess_score))\n    return result"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension for a given class name based on a strength calculation.\n    \"\"\"\n\n    def _calculate_strength(extension_name_str):\n        \"\"\"Counts uppercase and lowercase letters to determine strength.\"\"\"\n        cap_count = sum(1 for char in extension_name_str if 'A' <= char <= 'Z')\n        sm_count = sum(1 for char in extension_name_str if 'a' <= char <= 'z')\n        return cap_count - sm_count\n\n    strongest_ext_name = \"\"\n    # Initialize with a very low number to ensure any real strength becomes the max.\n    max_strength = float('-inf')\n\n    # Iterate through extensions to find the one with the highest strength.\n    for ext_name in extensions:\n        current_strength = _calculate_strength(ext_name)\n        # Update if a strictly stronger extension is found, or if it's the first encountered.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = ext_name\n\n    return f\"{class_name}.{strongest_ext_name}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"\n    Checks if `b` or any of its rotations is a substring in `a`.\n    \"\"\"\n    if not b:\n        return True\n\n    if len(b) > len(a):\n        return False\n\n    rotations = set()\n    n = len(b)\n    for i in range(n):\n        rotated_b = b[i:] + b[:i]\n        rotations.add(rotated_b)\n\n    for rotation in rotations:\n        if rotation in a:\n            return True\n\n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\n    It processes the absolute value of the input number.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Process the absolute value of the number as per FR5.\n    # Convert the absolute number to a string to iterate through its digits.\n    num_str = str(abs(num))\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:  # Identify even digits (BR1).\n            even_count += 1\n        else:  # Identify odd digits (BR2).\n            odd_count += 1\n\n    return (even_count, odd_count) # Return counts as a tuple (FR4)."}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a, b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\n    Returns True if a rotation of b is a substring of a, False otherwise.\"\"\"\n\n    if not b:\n        return True\n    if not a and b:\n        return False\n\n    generated_rotations = set()\n    n = len(b)\n    for i in range(n):\n        rotated = b[i:] + b[:i]\n        generated_rotations.add(rotated)\n\n    for rotation in generated_rotations:\n        if rotation in a:\n            return True\n\n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n\n    # Logic to extract digits, considering absolute value and handling zero.\n    if num == 0:\n        digits = [0]\n    else:\n        abs_num = abs(num)\n        digits = []\n        while abs_num > 0:\n            digits.append(abs_num % 10)\n            abs_num //= 10\n        # Reverse to get digits in their original order.\n        digits = digits[::-1]\n\n    even_count = 0\n    odd_count = 0\n\n    # Iterate through extracted digits and count even/odd.\n    for digit in digits:\n        if digit % 2 == 0: # Check if digit is even.\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    _ROMAN_MAP = [\n        (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n        (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n        (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'), (1, 'i')\n    ]\n\n    if not isinstance(number, int) or not (1 <= number <= 1000):\n        raise ValueError(\"Input number must be an integer between 1 and 1000.\")\n\n    roman_numeral = []\n    temp_num = number\n    for value, numeral in _ROMAN_MAP:\n        while temp_num >= value:\n            roman_numeral.append(numeral)\n            temp_num -= value\n    return \"\".join(roman_numeral)"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension for a given class name based on CAP - SM strength.\n    In case of a tie, the first occurring extension in the list is chosen.\n    \"\"\"\n    strongest_extension_name = \"\"\n    max_strength = -float('inf')\n\n    for extension_name in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in extension_name:\n            if 'A' <= char <= 'Z':\n                cap_count += 1\n            elif 'a' <= char <= 'z':\n                sm_count += 1\n        current_strength = cap_count - sm_count\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension_name\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/156", "solution": "ROMAN_MAP = [\n    (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n    (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n    (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'), (1, 'i')\n]\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase. Assumes input is an integer between 1 and 1000.\n    \"\"\"\n    roman_numeral_parts = []\n    temp_num = number\n    for value, symbol in ROMAN_MAP:\n        while temp_num >= value:\n            roman_numeral_parts.append(symbol)\n            temp_num -= value\n    return \"\".join(roman_numeral_parts)"}
{"task_id": "HumanEval/159", "solution": "def eat(number: int, need: int, remaining: int) -> list:\n    \"\"\"\n    Calculates the total carrots eaten and remaining after a rabbit's meal.\n    The rabbit eats no more than its need or the available stock.\n    \"\"\"\n    carrots_to_eat_now = min(need, remaining)\n    total_eaten = number + carrots_to_eat_now\n    carrots_left = remaining - carrots_to_eat_now\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/158", "solution": "def _count_unique_chars(word):\n    \"\"\"Calculates the number of unique characters in a string.\n    This is a helper for the main function.\"\"\"\n    return len(set(word))\ndef find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n\n    find_max([\"name\", \"of\", \"string\"]) == \"string\"\n    find_max([\"name\", \"enam\", \"game\"]) == \"enam\"\n    find_max([\"aaaaaaa\", \"bb\" ,\"cc\"]) == \"\"aaaaaaa\"\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = _count_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: lexicographical order\n            if result_word == \"\" or word < result_word:\n                result_word = word\n\n    return result_word"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten by a rabbit and remaining in stock after a meal.\n    The rabbit eats either its need or all remaining carrots, whichever is less.\n    \"\"\"\n    carrots_to_eat_this_meal = min(need, remaining)\n    total_eaten_carrots = number + carrots_to_eat_this_meal\n    carrots_left_in_stock = remaining - carrots_to_eat_this_meal\n    return [total_eaten_carrots, carrots_left_in_stock]"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Finds the word with the maximum unique characters from a list of strings.\n    Ties are broken by selecting the lexicographically smallest string.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Apply lexicographical tie-breaking if unique character counts are equal.\n            if word < result_word:\n                result_word = word\n\n    return result_word"}
{"task_id": "HumanEval/157", "solution": "import math\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Tolerance for floating-point comparisons to account for precision errors.\n    # This value is chosen to be reasonably small to catch close matches.\n    FLOAT_TOLERANCE = 1e-9\n\n    # Check for non-positive side lengths.\n    # A triangle must have positive side lengths.\n    if not (a > 0 and b > 0 and c > 0):\n        return False\n\n    # Check for triangle inequality theorem.\n    # The sum of the lengths of any two sides of a triangle must be greater than the length of the third side.\n    if not (a + b > c and a + c > b and b + c > a):\n        return False\n\n    # Calculate the squares of the side lengths.\n    a_sq = a * a\n    b_sq = b * b\n    c_sq = c * c\n\n    # Sort the squared side lengths to easily identify the potential hypotenuse (the largest side).\n    # The Pythagorean theorem states a^2 + b^2 = c^2, where c is the hypotenuse (the longest side).\n    sides_squared = sorted([a_sq, b_sq, c_sq])\n\n    # Check if the sum of the squares of the two shorter sides is approximately equal to\n    # the square of the longest side, using floating-point comparison.\n    # math.isclose is used because direct comparison with `==` can be unreliable for floats.\n    return math.isclose(sides_squared[0] + sides_squared[1], sides_squared[2], rel_tol=FLOAT_TOLERANCE)"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    \"\"\"\n    Given three side lengths, determine if they form a right-angled triangle.\n    It checks for positive lengths, triangle inequality, and the Pythagorean theorem.\n    \"\"\"\n    # FR2: Validate that all three side lengths are positive (BR1).\n    if not (a > 0 and b > 0 and c > 0):\n        return False\n\n    # FR3: Validate that the three side lengths can form a valid triangle (BR2).\n    if not ((a + b > c) and (a + c > b) and (b + c > a)):\n        return False\n\n    # FR4: Apply the Pythagorean theorem (BR3) with floating-point precision (NFR2).\n    # Sort sides to ensure 'z' is the longest side for a^2 + b^2 = c^2 comparison.\n    sides = sorted([a, b, c])\n    x, y, z = sides[0], sides[1], sides[2]\n\n    # Use a small epsilon for floating-point comparison (NFR2).\n    epsilon = 1e-9\n\n    # FR5: Return True if right-angled, False otherwise.\n    return abs(x*x + y*y - z*z) < epsilon"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Constructs and evaluates an algebraic expression from given operators and operands.\n    The evaluation respects standard mathematical operator precedence.\n    \"\"\"\n    expression_parts = []\n    for i in range(len(operator)):\n        expression_parts.append(str(operand[i]))\n        expression_parts.append(operator[i])\n    expression_parts.append(str(operand[-1]))\n\n    expression_string = \" \".join(expression_parts)\n\n    result = eval(expression_string)\n    return int(result)"}
{"task_id": "HumanEval/162", "solution": "import hashlib\nfrom typing import Optional\ndef string_to_md5(text: str) -> Optional[str]:\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    # Encode the input string to UTF-8 bytes and compute its MD5 hash.\n    # Return the hash as a hexadecimal string.\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"\n    Processes a string by reversing letter cases or reversing the whole string if no letters are found.\n    \"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if not has_letters:\n        return s[::-1]\n    else:\n        return \"\".join([char.swapcase() for char in s])"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s. If s[i] is a letter, reverse its case; otherwise, keep it as is.\n    If the string contains no letters, reverse the entire string.\n    \"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if not has_letters:\n        return s[::-1]\n    else:\n        result_chars = []\n        for char in s:\n            if char.islower():\n                result_chars.append(char.upper())\n            elif char.isupper():\n                result_chars.append(char.lower())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)"}
{"task_id": "HumanEval/162", "solution": "import hashlib\nfrom typing import Optional\ndef string_to_md5(text: str) -> Optional[str]:\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    result = []\n    even_digits_to_check = [0, 2, 4, 6, 8]\n\n    for digit in even_digits_to_check:\n        if min_val <= digit <= max_val:\n            result.append(digit)\n    return result"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a: int, b: int) -> list[int]:\n    \"\"\"\n    Returns a list of even digits (0-9) within the inclusive range [min(a, b), max(a, b)].\n    Input integers a and b are assumed to be positive.\n    \"\"\"\n    start = min(a, b)\n    end = max(a, b)\n\n    result = []\n    for num in range(start, end + 1):\n        if 0 <= num <= 9 and num % 2 == 0:\n            result.append(num)\n\n    return result"}
{"task_id": "HumanEval/160", "solution": "import operator as op_module\nfrom collections import deque\nfrom typing import Callable\nclass OperatorRegistry:\n    \"\"\"Manages and provides information about supported operators.\n    It stores operator precedence and their corresponding functions.\n    \"\"\"\n    def __init__(self):\n        self._precedence = {\n            '**': 3,\n            '*': 2,\n            '//': 2,\n            '+': 1,\n            '-': 1,\n        }\n        self._operations: dict[str, Callable[[int, int], int]] = {\n            '+': op_module.add,\n            '-': op_module.sub,\n            '*': op_module.mul,\n            '//': op_module.floordiv,\n            '**': op_module.pow,\n        }\n\n    def get_precedence(self, op: str) -> int:\n        \"\"\"Returns the precedence level for a given operator.\"\"\"\n        return self._precedence[op]\n\n    def get_operation(self, op: str) -> Callable[[int, int], int]:\n        \"\"\"Returns the callable function for a given operator.\"\"\"\n        return self._operations[op]\nclass AlgebraEvaluator:\n    \"\"\"Core logic for evaluating algebraic expressions.\n    It implements a shunting-yard like algorithm for precedence.\n    \"\"\"\n    def __init__(self, operator_registry: OperatorRegistry):\n        self._operator_registry = operator_registry\n\n    def evaluate(self, operators: list[str], operands: list[int]) -> int:\n        \"\"\"Evaluates the algebraic expression using RPN conversion and stack evaluation.\"\"\"\n        output_queue = deque()\n        operator_stack = deque()\n\n        operand_idx = 0\n        for i in range(len(operators)):\n            output_queue.append(operands[operand_idx])\n            operand_idx += 1\n\n            current_op = operators[i]\n            current_op_precedence = self._operator_registry.get_precedence(current_op)\n\n            while (operator_stack and\n                   self._operator_registry.get_precedence(operator_stack[-1]) >= current_op_precedence):\n                output_queue.append(operator_stack.pop())\n            operator_stack.append(current_op)\n\n        output_queue.append(operands[operand_idx])\n\n        while operator_stack:\n            output_queue.append(operator_stack.pop())\n\n        evaluation_stack = deque()\n        for token in output_queue:\n            if isinstance(token, int):\n                evaluation_stack.append(token)\n            else:\n                val2 = evaluation_stack.pop()\n                val1 = evaluation_stack.pop()\n                result = self._apply_operation(token, val1, val2)\n                evaluation_stack.append(result)\n\n        return evaluation_stack.pop()\n\n    def _apply_operation(self, op: str, val1: int, val2: int) -> int:\n        \"\"\"Applies a specific operation using the OperatorRegistry.\"\"\"\n        operation_func = self._operator_registry.get_operation(op)\n        return operation_func(val1, val2)\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + )\n    Subtraction ( - )\n    Multiplication ( * )\n    Floor division ( // )\n    Exponentiation ( ** )\n\n    Example:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n    \"\"\"\n    registry = OperatorRegistry()\n    evaluator = AlgebraEvaluator(registry)\n    return evaluator.evaluate(operator, operand)"}
{"task_id": "HumanEval/30", "solution": "def get_positive(l: list) -> list:\n    \"\"\"Return only positive numbers in the list.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    positive_numbers = []\n    for item in l:\n        if item > 0:\n            positive_numbers.append(item)\n    return positive_numbers"}
