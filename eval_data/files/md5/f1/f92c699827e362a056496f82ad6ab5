{"task_id": "HumanEval/68", "solution": "def pluck(arr: list[int]) -> list[int]:\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    # Return empty list if the input array is empty.\n    if not arr:\n        return []\n\n    # Iterate to find the smallest even value and its smallest index.\n    for i, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the node's value is even.\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            elif value == smallest_even_value:\n                # If values are equal, prioritize the node with the smaller index.\n                if i < smallest_even_index:\n                    smallest_even_index = i\n\n    # Return the identified node or an empty list if no even values were found.\n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than\n    zero, and has a frequency greater than or equal to the value of the integer itself.\n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    '''\n    # Calculate frequency of each integer in the list using a Counter.\n    frequency_map = Counter(lst)\n\n    # Sort unique numbers from the list in descending order to find the greatest match efficiently.\n    unique_numbers = sorted(frequency_map.keys(), reverse=True)\n\n    for num in unique_numbers:\n        # Check if the number is positive and its frequency meets the criteria.\n        if num > 0 and frequency_map[num] >= num:\n            return num\n\n    # Return -1 if no integer satisfies the condition after checking all unique numbers.\n    return -1"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket.\n    It parses apple and orange counts from a string and subtracts them from the total.\n    \"\"\"\n    FRUIT_PATTERN = r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\"\n\n    match = re.search(FRUIT_PATTERN, s)\n\n    apples_str, oranges_str = match.groups()\n\n    apples = int(apples_str)\n    oranges = int(oranges_str)\n\n    mangoes = n - apples - oranges\n\n    return mangoes"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts vowels in a string, where 'y' is a vowel only if it's the last character.\n    The count is case-insensitive, and non-alphabetic characters are ignored.\n    \"\"\"\n    vowel_count = 0\n    if not s:\n        return 0\n\n    s_lower = s.lower()\n    last_char_index = len(s_lower) - 1\n\n    for i, char in enumerate(s_lower):\n        is_last = (i == last_char_index)\n\n        if char in ('a', 'e', 'i', 'o', 'u'):\n            vowel_count += 1\n        elif char == 'y' and is_last:\n            vowel_count += 1\n\n    return vowel_count"}
{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket based on a string of apples and oranges.\n    This implementation assumes strict adherence to the input format and trusts caller's inputs.\n    \"\"\"\n    # Extract apple count\n    apples_idx = s.find(\"apples\")\n    apples_str = s[:apples_idx].strip()\n    apples = int(apples_str.split()[-1])\n\n    # Extract orange count\n    oranges_idx = s.find(\"oranges\")\n    oranges_str_segment = s[:oranges_idx]\n    oranges_str = oranges_str_segment.split(\" and \")[-1].strip()\n    oranges = int(oranges_str)\n\n    # Calculate mangoes\n    mangoes = n - (apples + oranges)\n    return mangoes"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    \"\"\"\n    Finds the greatest positive integer x in a list where its frequency is greater than or equal to x.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    frequencies = {}\n    for x in lst:\n        frequencies[x] = frequencies.get(x, 0) + 1\n\n    unique_numbers = sorted(frequencies.keys(), reverse=True)\n\n    for num in unique_numbers:\n        # Check if the number is positive and its frequency meets the condition.\n        if num > 0 and frequencies[num] >= num:\n            return num\n\n    return -1"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers by alternating between the minimum and maximum remaining elements.\n    The process continues until all elements are moved to the result list.\n\n    Examples:\n    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]\n    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]\n    strange_sort_list([]) == []\n    \"\"\"\n    if not lst:\n        return []\n\n    # Create a sorted copy to efficiently pop min (from start) and max (from end).\n    mutable_list = sorted(lst)\n    result_list = []\n\n    while mutable_list:\n        # Add minimum element.\n        result_list.append(mutable_list.pop(0))\n        if not mutable_list:  # Check if list became empty after popping min.\n            break\n        # Add maximum element.\n        result_list.append(mutable_list.pop())\n    return result_list"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even-valued node in an array, prioritizing the smallest index in case of ties.\n    Returns [value, index] or an empty list [] if no even numbers are found or the array is empty.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    if not arr:\n        return []\n\n    for i, node_value in enumerate(arr):\n        if node_value % 2 == 0:  # Check if it's an even number\n            if node_value < smallest_even_value:\n                smallest_even_value = node_value\n                smallest_even_index = i\n            elif node_value == smallest_even_value and i < smallest_even_index:\n                # If same smallest even value, pick the one with the smaller index\n                smallest_even_index = i\n\n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers in a 'strange' order: alternating minimum and maximum elements from the remaining pool.\n    The original list remains unchanged.\n    \"\"\"\n    if not lst:\n        return []\n\n    mutable_list = sorted(lst)\n    result_list = []\n    is_min_turn = True\n\n    while mutable_list:\n        if is_min_turn:\n            result_list.append(mutable_list.pop(0))\n        else:\n            result_list.append(mutable_list.pop())\n        is_min_turn = not is_min_turn\n\n    return result_list"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum number of elements to change to make the array palindromic.\n    A palindromic array reads the same forwards and backwards; each differing pair counts as one change.\n    \"\"\"\n    changes = 0\n    left = 0\n    right = len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    '''\n    Determines if object q will fly.\n    It flies if balanced (palindromic list) and its sum is less than or equal to maximum weight w.\n    '''\n    is_palindromic = q == q[::-1]\n    total_weight = sum(q)\n    is_light_enough = total_weight <= w\n    return is_palindromic and is_light_enough"}
{"task_id": "HumanEval/72", "solution": "def _is_palindrome(q):\n    \"\"\"Checks if a list is a palindrome.\"\"\"\n    return q == q[::-1]\ndef _calculate_sum(q):\n    \"\"\"Calculates the sum of elements in a list.\"\"\"\n    return sum(q)\ndef will_it_fly(q, w):\n    \"\"\"\n    Determines if an object will fly based on its balance and total weight.\n    An object flies if it's palindromic and its sum of elements is less than or equal to w.\n    \"\"\"\n    is_balanced = _is_palindrome(q)\n    total_weight = _calculate_sum(q)\n    return is_balanced and (total_weight <= w)"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum number of changes to make an array palindromic.\n    It compares elements from both ends, incrementing a counter for each mismatch.\n    \"\"\"\n    changes_count = 0\n    left = 0\n    right = len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes_count += 1\n        left += 1\n        right -= 1\n\n    return changes_count"}
{"task_id": "HumanEval/71", "solution": "import math\nclass Triangle:\n    \"\"\"Represents a triangle with three side lengths.\n    It stores the lengths as attributes a, b, and c.\"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        self.a = a\n        self.b = b\n        self.c = c\nclass TriangleService:\n    \"\"\"Provides business logic for triangle validation and area calculation.\n    It includes methods to check validity and compute area using Heron's formula.\"\"\"\n    def is_valid(self, triangle: Triangle) -> bool:\n        \"\"\"Checks if the given side lengths form a valid triangle.\n        All sides must be positive and satisfy the triangle inequality.\"\"\"\n        a, b, c = triangle.a, triangle.b, triangle.c\n        if not (a > 0 and b > 0 and c > 0):\n            return False\n        return (a + b > c) and (a + c > b) and (b + c > a)\n\n    def calculate_area(self, triangle: Triangle) -> float:\n        \"\"\"Calculates the area of a valid triangle using Heron's formula.\n        It assumes the triangle has already been validated.\"\"\"\n        a, b, c = triangle.a, triangle.b, triangle.c\n        s = (a + b + c) / 2\n        area_squared = s * (s - a) * (s - b) * (s - c)\n        # Handle potential floating point inaccuracies that might make area_squared slightly negative.\n        if area_squared < 0:\n            area_squared = 0\n        return math.sqrt(area_squared)\ndef triangle_area(a, b, c):\n    \"\"\"Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1.\"\"\"\n    triangle = Triangle(a, b, c)\n    service = TriangleService()\n\n    if not service.is_valid(triangle):\n        return -1.00 # Return -1 as a float for consistency\n\n    area = service.calculate_area(triangle)"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    \"\"\"\n    Given three side lengths, calculate and return the triangle's area rounded to two decimal places if valid, otherwise return -1.\n    A triangle is valid if all sides are positive and the sum of any two sides is strictly greater than the third.\n    \"\"\"\n    # Check if side lengths are positive.\n    if a <= 0 or b <= 0 or c <= 0:\n        return -1.0\n\n    # Check if the triangle inequality theorem holds.\n    if not ((a + b > c) and (a + c > b) and (b + c > a)):\n        return -1.0\n\n    # Calculate the semi-perimeter.\n    s = (a + b + c) / 2\n\n    # Calculate the area using Heron's formula.\n    area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n\n    # Round the calculated area to two decimal places.\n    return round(area, 2)"}
