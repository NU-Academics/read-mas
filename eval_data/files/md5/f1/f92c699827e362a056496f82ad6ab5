{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    The list is assumed to contain only numeric elements and be non-empty.\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # Odd number of elements\n        return sorted_l[n // 2]\n    else:\n        # Even number of elements\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2.0"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_list = sorted(l)\n    n = len(sorted_list)\n\n    if n % 2 == 1:\n        # For odd-sized lists, the median is the middle element.\n        return sorted_list[n // 2]\n    else:\n        # For even-sized lists, the median is the average of the two middle elements.\n        mid1 = sorted_list[n // 2 - 1]\n        mid2 = sorted_list[n // 2]\n        return (mid1 + mid2) / 2"}
{"task_id": "HumanEval/46", "solution": "FIB4_INITIAL_VALUES = {\n    0: 0,\n    1: 0,\n    2: 2,\n    3: 0\n}\ndef fib4(n: int) -> int:\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n in FIB4_INITIAL_VALUES:\n        return FIB4_INITIAL_VALUES[n]\n\n    # Use a list to store previous values for iterative calculation\n    # Initialize with the first four values\n    dp = [0] * (n + 1)\n    dp[0] = FIB4_INITIAL_VALUES[0]\n    dp[1] = FIB4_INITIAL_VALUES[1]\n    dp[2] = FIB4_INITIAL_VALUES[2]\n    dp[3] = FIB4_INITIAL_VALUES[3]\n\n    for i in range(4, n + 1):\n        dp[i] = dp[i-1] + dp[i-2] + dp[i-3] + dp[i-4]\n\n    return dp[n]"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int) -> int:\n    \"\"\"Calculates 2^n modulo p using modular exponentiation.\n    It assumes n is non-negative and p is positive.\n    \"\"\"\n    if n == 0:\n        return 1 % p\n\n    result = 1\n    base = 2 % p # Initializes base, correctly handling p=1.\n\n    # Perform modular exponentiation (exponentiation by squaring).\n    while n > 0:\n        if n % 2 == 1:\n            result = (result * base) % p\n        base = (base * base) % p\n        n //= 2\n    return result"}
