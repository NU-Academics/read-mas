{"task_id": "HumanEval/99", "solution": "import math\ndef _parse_number(value):\n    return float(value)\ndef _round_away_from_zero(number):\n    if number == 0:\n        return 0\n\n    fractional_part = abs(number) - math.floor(abs(number))\n    if fractional_part == 0.5:\n        if number > 0:\n            return math.ceil(number)\n        else:\n            return math.floor(number)\n    else:\n        return round(number)\ndef closest_integer(value):\n    \"\"\"\n    Converts a string number to the closest integer.\n    Equidistant values (X.5) are rounded away from zero.\n    \"\"\"\n    parsed_number = _parse_number(value)\n    return _round_away_from_zero(parsed_number)"}
{"task_id": "HumanEval/101", "solution": "def words_string(s: str) -> list[str]:\n    \"\"\"\n    Splits a string into individual words using commas or spaces as delimiters.\n    It handles multiple consecutive delimiters and leading/trailing delimiters by filtering out empty strings.\n    \"\"\"\n    if not s:\n        return []\n    processed_s = s.replace(',', ' ')\n    words = [word for word in processed_s.split(' ') if word]\n    return words"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lower_case_keys = True\n    all_upper_case_keys = True\n\n    for key in dict.keys():\n        # Per critical requirements, no isinstance() checks are added.\n        # This assumes all keys are strings, otherwise an AttributeError will occur.\n        if key != key.lower():\n            all_lower_case_keys = False\n        if key != key.upper():\n            all_upper_case_keys = False\n\n        # If neither all lowercase nor all uppercase can be true, it's mixed or partial case.\n        if not all_lower_case_keys and not all_upper_case_keys:\n            return False\n\n    return all_lower_case_keys or all_upper_case_keys"}
