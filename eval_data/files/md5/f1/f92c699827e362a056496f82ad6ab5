{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    \"\"\"\n    integer_part = int(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    cleaned_string = paren_string.replace(\" \", \"\")\n    groups: List[str] = []\n    current_group_start = 0\n    balance = 0\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        if balance == 0 and current_group_start <= i:\n            groups.append(cleaned_string[current_group_start : i + 1])\n            current_group_start = i + 1\n        elif balance < 0:\n            balance = 0\n            current_group_start = i + 1\n    return groups"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"\n    Check if any two distinct numbers in the list are closer than the given threshold.\n    Returns True if such a pair exists, False otherwise.\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(len(sorted_numbers)):\n        for j in range(i + 1, len(sorted_numbers)):\n            # Since sorted_numbers is sorted, sorted_numbers[j] - sorted_numbers[i] is always non-negative.\n            if (sorted_numbers[j] - sorted_numbers[i]) < threshold:\n                return True\n\n            # Optimization: If the difference between current i and j is already >= threshold,\n            # then any subsequent number k > j will also have a difference >= threshold.\n            if (sorted_numbers[j] - sorted_numbers[i]) >= threshold:\n                break\n\n    return False"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    # Sorting the list can improve efficiency by allowing early exit from the inner loop.\\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            # If the difference is already too large, subsequent elements will also be further away due to sorting.\\n\n            if sorted_numbers[j] - sorted_numbers[i] < threshold:\n                return True\n            elif sorted_numbers[j] - sorted_numbers[i] >= threshold:\n                break\n    return False"}
{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"\n    Detects if a bank account balance, starting at zero, falls below zero at any point.\n    Returns True immediately if balance drops below zero, otherwise False after all operations.\n    \"\"\"\n    current_balance = 0\n    for op in operations:\n        current_balance += op\n        if current_balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers`.\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty for MAD calculation.\")\n\n    mean = sum(numbers) / len(numbers)\n    absolute_differences = [abs(x - mean) for x in numbers]\n    return sum(absolute_differences) / len(absolute_differences)"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"\n    Inserts a number 'delimeter' between every two consecutive elements of input list `numbers`.\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates a string into distinct, balanced, non-nested parenthetical groups.\n    Spaces are ignored when identifying and forming the groups.\n    \"\"\"\n    groups: List[str] = []\n    # Remove all whitespace characters to ensure they are ignored for both parsing and output content.\n    cleaned_string = \"\".join(char for char in paren_string if not char.isspace())\n\n    balance = 0\n    group_start_index = -1\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            if balance == 0:\n                group_start_index = i\n            balance += 1\n        elif char == ')':\n            balance -= 1\n            if balance == 0 and group_start_index != -1:\n                # A top-level balanced group has closed.\n                groups.append(cleaned_string[group_start_index : i + 1])\n                group_start_index = -1 # Reset for the next group.\n\n    return groups"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring.\"\"\"\n    if not strings:\n        return []\n    if not substring:\n        return list(strings)\n\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    \"\"\"\n    groups = [group for group in paren_string.split(' ') if group]\n\n    depths = []\n    for group_string in groups:\n        max_depth = 0\n        current_depth = 0\n        for char in group_string:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        depths.append(max_depth)\n\n    return depths"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    \"\"\"\n    # Calculate the mean of the input numbers.\n    data_sum = sum(numbers)\n    count = len(numbers)\n    mean = data_sum / count\n\n    # Calculate the absolute differences between each number and the mean.\n    absolute_differences = [abs(num - mean) for num in numbers]\n\n    # Calculate the mean of these absolute differences to get the MAD.\n    mad_sum = sum(absolute_differences)\n    mad = mad_sum / count\n\n    return mad"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef _calculate_max_depth(group: str) -> int:\n    \"\"\"Calculates the deepest level of nesting for a single group of parentheses.\n    Assumes the group is well-formed for accurate depth.\n    \"\"\"\n    current_depth = 0\n    max_depth = 0\n    for char in group:\n        if char == '(':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            current_depth -= 1\n            # Ensure depth does not go below zero for malformed groups.\n            current_depth = max(0, current_depth)\n    return max_depth\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Parses a string of space-separated parentheses groups to determine each group's deepest nesting level.\n    Returns a list of integers representing the maximum nesting depth for each group.\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    if not paren_string.strip():\n        return []\n\n    # Split the input string into individual parentheses groups based on spaces.\n    groups = paren_string.split(' ')\n    results = []\n    for group in groups:\n        # Handle empty groups resulting from multiple spaces gracefully.\n        if group:\n            # For each group, calculate its deepest level of nesting.\n            results.append(_calculate_max_depth(group))\n    return results"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\"Filter an input list of strings, returning only those that contain the given substring.\n    The filtering is case-sensitive and preserves the original order of elements.\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\nfrom functools import reduce\nimport operator\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    For a given list of integers, return a tuple consisting of a sum and a product\n    of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    total_sum = sum(numbers)\n    total_product = reduce(operator.mul, numbers, 1)\n\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/9", "solution": "from typing import List\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"From a given list of integers, generate a list of rolling maximum element.\n    Each element is the maximum found until that point in the sequence.\"\"\"\n    result_list = []\n    current_max = None\n\n    for number in numbers:\n        if current_max is None:\n            current_max = number\n        else:\n            current_max = max(current_max, number)\n        result_list.append(current_max)\n\n    return result_list"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n    for i, num in enumerate(numbers):\n        if not isinstance(num, int):\n            raise ValueError(f\"List element at index {i} is not an integer: {num}\")\n\n    if not numbers:\n        return []\n\n    rolling_max_list: List[int] = []\n    current_max: int = float('-inf')\n\n    for num in numbers:\n        if num > current_max:\n            current_max = num\n        rolling_max_list.append(current_max)\n\n    return rolling_max_list"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"\n    Returns the longest string from a list of strings.\n    If the list is empty, returns None; otherwise, returns the first longest string encountered.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str = \"\"\n    max_length = -1\n\n    for s in strings:\n        if len(s) > max_length:\n            max_length = len(s)\n            longest_str = s\n    return longest_str"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\"Performs binary XOR on two binary strings, returning the result as a string.\n    It assumes valid, equal-length binary string inputs without validation.\"\"\"\n    result_chars = []\n    for i in range(len(a)):\n        if a[i] == b[i]:\n            result_chars.append('0')\n        else:\n            result_chars.append('1')\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\"Test if given string is a palindrome.\n    Compares the string with its reverse.\"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\"Find the shortest palindrome that begins with a supplied string.\n    Identifies the longest palindromic suffix and appends the reversed prefix.\"\"\"\n    if not string:\n        return \"\"\n\n    if is_palindrome(string):\n        return string\n\n    longest_palindromic_suffix = \"\"\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            longest_palindromic_suffix = suffix\n            break\n\n    prefix_to_reverse = string[:len(string) - len(longest_palindromic_suffix)]\n\n    return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea: find longest palindromic postfix, append reverse of preceding prefix.\n    \"\"\"\n    if is_palindrome(string):\n        return string\n\n    longest_palindromic_postfix_len = 0\n    for i in range(len(string)):\n        postfix = string[i:]\n        if is_palindrome(postfix):\n            longest_palindromic_postfix_len = len(postfix)\n            break\n\n    prefix_to_reverse = string[:len(string) - longest_palindromic_postfix_len]\n    return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\"Performs binary XOR on two input strings of '1's and '0's.\n    The shorter string is implicitly padded with leading '0's to match the longer string's length.\"\"\"\n    max_len = max(len(a), len(b))\n\n    padded_a = a.zfill(max_len)\n    padded_b = b.zfill(max_len)\n\n    result_bits = []\n    for i in range(max_len):\n        bit_a = int(padded_a[i])\n        bit_b = int(padded_b[i])\n        xor_result = bit_a ^ bit_b\n        result_bits.append(str(xor_result))\n\n    return \"\".join(result_bits)"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Returns the longest string from a list, or None if the list is empty.\n    If multiple strings share the maximum length, the first encountered is returned.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str: Optional[str] = None\n    max_length: int = -1\n\n    for s in strings:\n        if len(s) > max_length:\n            max_length = len(s)\n            longest_str = s\n    return longest_str"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"Return a greatest common divisor of two integers a and b.\n    This uses the Euclidean algorithm, handling zero and negative inputs.\"\"\"\n\n    if a == 0 and b == 0:\n        return 0\n    if a == 0:\n        return abs(b)\n    if b == 0:\n        return abs(a)\n\n    a = abs(a)\n    b = abs(b)\n\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/14", "solution": "from typing import List\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    prefixes = []\n    for i in range(1, len(string) + 1):\n        prefixes.append(string[:i])\n    return prefixes"}
