{"task_id": "HumanEval/94", "solution": "import math\ndef skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    def calculate_digit_sum(n):\n        \"\"\"Calculates the sum of the digits of a number.\"\"\"\n        s = 0\n        n_abs = abs(n)\n        while n_abs > 0:\n            s += n_abs % 10\n            n_abs //= 10\n        return s\n\n    largest_prime = None\n    for num in lst:\n        if is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n\n    if largest_prime is None:\n        return 0\n    else:\n        return calculate_digit_sum(largest_prime)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping letter case and replacing vowels.\n    Vowels are replaced by the letter two places ahead in the alphabet, preserving case.\n    \"\"\"\n    case_swapped_message = message.swapcase()\n\n    vowel_map_lower = {\n        'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w'\n    }\n    vowel_map_upper = {\n        'A': 'C', 'E': 'G', 'I': 'K', 'O': 'Q', 'U': 'W'\n    }\n\n    result_chars = []\n    for char in case_swapped_message:\n        if char in vowel_map_lower:\n            result_chars.append(vowel_map_lower[char])\n        elif char in vowel_map_upper:\n            result_chars.append(vowel_map_upper[char])\n        else:\n            result_chars.append(char)\n\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/94", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Helper function for checking primality.\n    It uses an optimized trial division method.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef sum_digits(n: int) -> int:\n    \"\"\"Helper function for summing digits of an integer.\n    Converts the number to a string and sums its integer digits.\n    \"\"\"\n    return sum(int(digit) for digit in str(n))\ndef skjkasdkd(lst):\n    \"\"\"Given a list of integers, find the largest prime and return the sum of its digits.\n    Assumes the input list always contains at least one prime number.\n    \"\"\"\n\n    primes = []\n    for item in lst:\n        if is_prime(item):\n            primes.append(item)\n\n    largest_prime = max(primes)\n\n    return sum_digits(largest_prime)"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Implement a function that takes an non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    for example:\n    count_up_to(5) => [2,3]\n    count_up_to(11) => [2,3,5,7]\n    count_up_to(0) => []\n    count_up_to(20) => [2,3,5,7,11,13,17,19]\n    count_up_to(1) => []\n    count_up_to(18) => [2,3,5,7,11,13,17]\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n <= 2:\n        return []\n\n    primes = []\n    for num in range(2, n):\n        is_prime_candidate = True\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                is_prime_candidate = False\n                break\n\n        if is_prime_candidate:\n            primes.append(num)\n\n    return primes"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case of all letters and replacing vowels\n    with the letter that appears 2 places ahead in the English alphabet.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n    ALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\n    ALPHABET_UPPER = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n    encoded_chars = []\n\n    for original_char in message:\n        # Step 1: Swap the case of all letters. Non-alphabetic characters are returned unchanged.\n        # This gives us the character with its case potentially swapped.\n        processed_char = original_char.swapcase()\n\n        # Step 2: Replace vowels (from the original character set) with the letter that appears\n        # 2 places ahead in the English alphabet, maintaining the case of the *processed_char*.\n        if original_char in VOWELS:\n            if processed_char.islower():\n                idx = ALPHABET_LOWER.find(processed_char)\n                processed_char = ALPHABET_LOWER[(idx + 2) % len(ALPHABET_LOWER)]\n            elif processed_char.isupper():\n                idx = ALPHABET_UPPER.find(processed_char)\n                processed_char = ALPHABET_UPPER[(idx + 2) % len(ALPHABET_UPPER)]\n\n        encoded_chars.append(processed_char)\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    Examples:\n    check_dict_case({\"a\":\"apple\", \"b\":\"banana\"}) should return True.\n    check_dict_case({\"a\":\"apple\", \"A\":\"banana\", \"B\":\"banana\"}) should return False.\n    check_dict_case({\"a\":\"apple\", 8:\"banana\", \"a\":\"apple\"}) should return False.\n    check_dict_case({\"Name\":\"John\", \"Age\":\"36\", \"City\":\"Houston\"}) should return False.\n    check_dict_case({\"STATE\":\"NC\", \"ZIP\":\"12345\" }) should return True.\n    \"\"\"\n    if not dict:\n        return False\n\n    string_keys = [k for k in dict.keys() if isinstance(k, str)]\n\n    if not string_keys:\n        # If there are no string keys, but the dict is not empty,\n        # it means all keys are non-strings, which should return False.\n        return False\n\n    all_lower = True\n    all_upper = True\n\n    for key in string_keys:\n        if not key.islower():\n            all_lower = False\n        if not key.isupper():\n            all_upper = False\n\n        # Optimization: if both flags are false, we can stop early\n        if not all_lower and not all_upper:\n            return False\n\n    return all_lower or all_upper"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Implement a function that takes an non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    for example:\n    count_up_to(5) => [2,3]\n    count_up_to(11) => [2,3,5,7]\n    count_up_to(0) => []\n    count_up_to(20) => [2,3,5,7,11,13,17,19]\n    count_up_to(1) => []\n    count_up_to(18) => [2,3,5,7,11,13,17]\n    \"\"\"\n\n    def is_prime(num):\n        \"\"\"\n        Checks if a given integer num is a prime number.\n        It optimizes checks for odd divisors up to its square root.\n        \"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n\n        # Check for odd divisors from 3 up to the square root of num\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    if n <= 2:\n        return []\n\n    primes = []\n    for num in range(2, n):\n        if is_prime(num):\n            primes.append(num)\n    return primes"}
