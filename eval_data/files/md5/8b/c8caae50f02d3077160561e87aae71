{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p using modular exponentiation (exponentiation by squaring).\n    This avoids large intermediate numbers that might overflow standard integer types.\n    \"\"\"\n    result = 1 % p\n    base = 2 % p\n    exp = n\n    while exp > 0:\n        if exp & 1:  # If exp is odd\n            result = (result * base) % p\n        base = (base * base) % p\n        exp >>= 1  # Divide exp by 2\n    return result"}
{"task_id": "HumanEval/53", "solution": "def add(x: int, y: int):\n    \"\"\"Add two numbers x and y\n    >>> add(2, 3)\n    5\n    >>> add(5, 7)\n    12\n    \"\"\"\n    from simplemath.services import CalculatorService\n    from simplemath.repositories import SqliteCalculationRepository\n    from simplemath.config import PERSIST_ON_ADD # Import persist_on_add from config\n\n    _default_repo = SqliteCalculationRepository()\n    _service = CalculatorService(repo=_default_repo, persist_on_add=PERSIST_ON_ADD) # Use config for persist_on_add\n    return _service.add(float(x), float(y)).result"}
{"task_id": "HumanEval/54", "solution": "def same_chars(s0: str, s1: str):\n    \"\"\"\n    Check if two words have the same characters.\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')\n    True\n    >>> same_chars('abcd', 'dddddddabc')\n    True\n    >>> same_chars('dddddddabc', 'abcd')\n    True\n    >>> same_chars('eabcd', 'dddddddabc')\n    False\n    >>> same_chars('abcd', 'dddddddabce')\n    False\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddddabc')\n    False\n    \"\"\"\n    # Normalize s0: convert to lowercase and filter out whitespace characters.\n    normalized_s0_chars = {char for char in s0.casefold() if not char.isspace()}\n\n    # Normalize s1: convert to lowercase and filter out whitespace characters.\n    normalized_s1_chars = {char for char in s1.casefold() if not char.isspace()}\n\n    # Compare the sets of normalized characters.\n    return normalized_s0_chars == normalized_s1_chars"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    counter = 0\n    for char in brackets:\n        if char == '<':\n            counter += 1\n        elif char == '>':\n            counter -= 1\n        # If the counter drops below zero, it means a closing bracket appeared without a matching opening bracket.\n        if counter < 0:\n            return False\n    # After iterating through all characters, if the counter is zero, all brackets are correctly matched.\n    return counter == 0"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\"\"\"\n    if len(l) <= 1:\n        return True\n\n    increasing = True\n    decreasing = True\n\n    for i in range(1, len(l)):\n        if l[i] > l[i-1]:\n            decreasing = False\n        elif l[i] < l[i-1]:\n            increasing = False\n\n        if not increasing and not decreasing:\n            return False\n\n    return True"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    # This function uses trial division to find all prime factors and returns the largest.\n    # It covers cases where the input n is prime by returning n itself.\n\n    largest_factor = 1\n\n    # Divide out factors of 2\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Divide out odd factors starting from 3 up to sqrt(n)\n    p = 3\n    while p * p <= n:\n        while n % p == 0:\n            largest_factor = p\n            n //= p\n        p += 2 # Move to the next odd number\n\n    # If n is still greater than 1 after the loop, it means the remaining n is a prime factor\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number using the fast-doubling method.\n    This method efficiently calculates F(n) in logarithmic time.\n    \"\"\"\n    def _fd_recursive(k):\n        if k == 0:\n            return (0, 1) # Base case: (F(0), F(1))\n        \n        # Calculate F(k/2) and F(k/2 + 1)\n        a, b = _fd_recursive(k >> 1)\n\n        # Apply fast doubling identities\n        c = a * (2*b - a) # F(2k) = F(k) * (2 * F(k+1) - F(k))\n        d = a*a + b*b     # F(2k+1) = F(k)^2 + F(k+1)^2\n        \n        if k & 1: # If k is odd\n            return (d, c + d) # (F(k), F(k+1)) = (F(2m+1), F(2m+2)) = (d, c+d) where m = k/2\n        else: # If k is even\n            return (c, d) # (F(k), F(k+1)) = (F(2m), F(2m+1)) = (c, d) where m = k/2\n    \n    # The result of _fd_recursive(n) is (F(n), F(n+1)), so we return F(n)\n    return _fd_recursive(n)[0]"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    \"\"\"\n    if len(xs) <= 1:\n        return []\n    # The derivative of a_n * x^n is n * a_n * x^(n-1).\n    # So the coefficient for x^(i-1) in the derivative is i * xs[i].\n    return [i * xs[i] for i in range(1, len(xs))]"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    return n * (n + 1) // 2"}
