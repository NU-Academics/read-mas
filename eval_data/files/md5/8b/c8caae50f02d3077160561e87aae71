{"task_id": "HumanEval/4", "solution": "```python\nimport math\nfrom typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    # The design context indicates that empty input lists should raise a CalculationError.\n    # However, per the requirements, we should not add isinstance() checks or raise exceptions.\n    # We proceed with the calculation assuming a valid, non-empty list of floats.\n\n    # Calculate the mean of the numbers\n    mean = math.fsum(numbers) / len(numbers)\n\n    # Calculate the absolute deviations from the mean\n    deviations = [abs(x - mean) for x in numbers]\n\n    # Calculate the mean of the absolute deviations\n    mad = math.fsum(deviations) / len(deviations)\n\n    return mad\n```"}
{"task_id": "HumanEval/7", "solution": "```python\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    matches = []\n    if not substring: # If substring is empty, return original list as per design context (match-all default).\n        return strings[:]\n    \n    for s in strings:\n        if substring in s:\n            matches.append(s)\n    return matches\n```"}
{"task_id": "HumanEval/2", "solution": "import math\nfrom typing import Any, Optional\nfrom dataclasses import dataclass\n\nclass TruncationError(Exception):\n    def __init__(self, message: str, code: Optional[int] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.code = code\n    def __str__(self) -> str:\n        return f\"TruncationError: {self.message}\"\n\nclass NumberValidator:\n    MIN_VALUE: float = 0.0\n    def validate(self, number: Any) -> float:\n        try:\n            val = float(number)\n        except (TypeError, ValueError) as e:\n            raise TruncationError(f\"Input is not a number: {e}\")\n        if math.isnan(val) or math.isinf(val):\n            raise TruncationError(\"Input must be finite number\")\n        if val < self.MIN_VALUE:\n            raise TruncationError(f\"Negative numbers are not supported: {val}\")\n        return val\n\n@dataclass(frozen=True)\nclass NumberDTO:\n    original_value: float\n    integer_part: int\n    decimal_part: float\n    def as_dict(self) -> dict:\n        return {\n            \"original_value\": self.original_value,\n            \"integer_part\": self.integer_part,\n            \"decimal_part\": self.decimal_part,\n        }\n\nclass Truncator:\n    DEFAULT_ROUND_PLACES: int = 12\n    def truncate(self, number: float) -> float:\n        \"\"\"Return the fractional part of a validated number.\"\"\"\n        integer_part = int(math.floor(number))\n        decimal_part = round(number - integer_part, self.DEFAULT_ROUND_PLACES)\n        if decimal_part < 0 and abs(decimal_part) < 1e-15:\n            decimal_part = 0.0\n        return decimal_part\n\n    def decompose(self, number: float) -> NumberDTO:\n        \"\"\"Decompose a number into its original value, integer, and decimal parts.\"\"\"\n        validated = NumberValidator().validate(number)\n        integer_part = int(math.floor(validated))\n        decimal_part = self.truncate(validated)\n        return NumberDTO(original_value=validated, integer_part=integer_part, decimal_part=decimal_part)\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    validated = NumberValidator().validate(number)\n    return Truncator().truncate(validated)"}
{"task_id": "HumanEval/3", "solution": "def below_zero(operations: List[int]) -> bool:\n    \"\"\"Detects if a bank account balance, starting at zero, ever falls below zero.\n\n    Returns True if the balance falls below zero at any point, False otherwise.\n    \"\"\"\n    balance = 0\n    for amount in operations:\n        balance += amount\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    result: List[str] = []\n    current_group_chars: List[str] = []\n    balance = 0\n\n    for char in paren_string:\n        if char == ' ':\n            continue\n        elif char == '(':\n            if balance == 0:\n                # Start of a new top-level group\n                current_group_chars = []\n            balance += 1\n            current_group_chars.append(char)\n        elif char == ')':\n            balance -= 1\n            current_group_chars.append(char)\n            if balance == 0:\n                # End of a top-level group\n                result.append(\"\".join(current_group_chars))\n                current_group_chars = [] \n    return result"}
{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n    \"\"\"\n\n    class Config:\n        \"\"\"Runtime configuration for the parser.\"\"\"\n        def __init__(self, enable_history: bool = False, history_path: str = \"parse_history.json\") -> None:\n            self.enable_history: bool = enable_history\n            self.history_path: str = history_path\n\n    class ParserError(Exception):\n        \"\"\"Domain exception for parsing errors.\"\"\"\n        def __init__(self, message: str, group_index: int | None = None) -> None:\n            self.message: str = message\n            self.group_index: int | None = group_index\n            super().__init__(message)\n\n    class ParenGroup:\n        \"\"\"Represents a parenthesis group and computes its depth.\"\"\"\n        def __init__(self, text: str) -> None:\n            self.text: str = text\n            self.depth: int = 0\n\n        def compute_depth(self) -> int:\n            \"\"\"Computes the maximum nesting depth for the group.\"\"\"\n            current = 0\n            max_depth = 0\n            for ch in self.text:\n                if ch == \"(\":\n                    current += 1\n                    if current > max_depth:\n                        max_depth = current\n                elif ch == \")\":\n                    current -= 1\n                    if current < 0:\n                        raise ParserError(\"Unmatched closing parenthesis\")\n                # No need for an 'else' block here as Validator.is_valid_group\n                # already ensures only '(' and ')' characters are present.\n            if current != 0:\n                raise ParserError(\"Unmatched opening parenthesis\")\n            self.depth = max_depth\n            return max_depth\n\n    class Validator:\n        \"\"\"Utility class for input validation and normalization.\"\"\"\n        @staticmethod\n        def normalize_input(input_str: str) -> str:\n            \"\"\"Strips whitespace and collapses internal multiple spaces to single spaces.\"\"\"\n            return \" \".join(input_str.strip().split())\n\n        @staticmethod\n        def split_groups(input_str: str) -> List[str]:\n            \"\"\"Splits an input string into individual parenthesis groups.\"\"\"\n            norm = Validator.normalize_input(input_str)\n            if not norm:\n                return []\n            return norm.split(\" \")\n\n        @staticmethod\n        def is_valid_group(text: str) -> tuple[bool, str | None]:\n            \"\"\"Checks if a group string contains only valid characters.\"\"\"\n            if not text:\n                return False, \"Empty group\"\n            for ch in text:\n                if ch not in (\"(\", \")\"):\n                    return False, f\"Invalid character: {ch}\"\n            return True, None\n\n    class HistoryRepository:\n        \"\"\"Provides optional persistence for parse history.\"\"\"\n        def __init__(self, path: str) -> None:\n            self.path: str = path\n\n        def append_record(self, input_str: str, output: List[int], timestamp: str) -> None:\n            \"\"\"Appends a new record to the history file. (Not used by default config)\"\"\"\n            # This implementation is a placeholder as default config has enable_history=False\n            pass\n\n        def read_all(self) -> List[dict]:\n            \"\"\"Reads all records from the history file. (Not used by default config)\"\"\"\n            # This implementation is a placeholder as default config has enable_history=False\n            return []\n\n    class ParserService:\n        \"\"\"Orchestrates parsing, validation, and optional history persistence.\"\"\"\n        def __init__(self, config: Config, repo: HistoryRepository | None = None) -> None:\n            self.config: Config = config\n            self.repo: HistoryRepository | None = repo\n\n        def parse_input(self, input_str: str, ignore_errors: bool = False) -> List[int]:\n            \"\"\"Parses an input string, computing depths for each group.\"\"\"\n            groups = Validator.split_groups(input_str)\n            depths: List[int] = []\n\n            for idx, g in enumerate(groups):\n                valid, err = Validator.is_valid_group(g)\n                if not valid:\n                    if ignore_errors:\n                        continue\n                    raise ParserError(err, group_index=idx)\n\n                try:\n                    depth = self._parse_group(g, idx)\n                    depths.append(depth)\n                except ParserError as e:\n                    if ignore_errors:\n                        continue\n                    # Re-raise with group_index if it wasn't set by ParenGroup\n                    if e.group_index is None:\n                        e.group_index = idx\n                    raise e\n\n            # History persistence is skipped by default config for this function\n            # if self.config.enable_history and self.repo:\n            #     from datetime import datetime\n            #     self.repo.append_record(input_str, depths, datetime.utcnow().isoformat() + \"Z\")\n\n            return depths\n\n        def _parse_group(self, group_text: str, index: int) -> int:\n            \"\"\"Helper to parse a single group and handle potential errors.\"\"\"\n            group_model = ParenGroup(group_text)\n            try:\n                return group_model.compute_depth()\n            except ParserError as e:\n                e.group_index = index\n                raise e\n\n    class ParserController:\n        \"\"\"High-level controller for parsing operations.\"\"\"\n        def __init__(self, service: ParserService) -> None:\n            self.service: ParserService = service\n\n        def parse_and_return(self, input_str: str, ignore_errors: bool = False) -> List[int]:\n            \"\"\"Delegates parsing to the service and returns results.\"\"\"\n            return self.service.parse_input(input_str, ignore_errors=ignore_errors)\n\n    # Instantiate default components as per design for the library function\n    _default_config = Config(enable_history=False) # history is not enabled for the library function\n    _default_service = ParserService(config=_default_config, repo=None)\n    _default_controller = ParserController(service=_default_service)\n\n    # Delegate the call to the default controller\n    return _default_controller.parse_and_return(paren_string)"}
{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n    if len(numbers) == 1:\n        return [numbers[0]]\n    \n    out: List[int] = []\n    for i, v in enumerate(numbers):\n        out.append(v)\n        if i < len(numbers) - 1:\n            out.append(delimeter)\n    return out"}
{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(len(sorted_numbers) - 1):\n        if (sorted_numbers[i+1] - sorted_numbers[i]) < threshold:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    \n    current_sum = 0\n    current_product = 1\n\n    if not numbers:\n        return (current_sum, current_product)\n\n    current_sum = sum(numbers)\n    for num in numbers:\n        current_product *= num\n    \n    return (current_sum, current_product)"}
