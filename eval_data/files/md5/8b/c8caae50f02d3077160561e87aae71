{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    Checks if there are three distinct elements in the list that sum to zero.\n    Uses a two-pointer approach after sorting for O(N^2) time complexity.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    nums = sorted(l) # Sort the list to use the two-pointer technique\n\n    for i in range(n - 2):\n        # Skip duplicate elements for `i` to avoid redundant calculations\n        if i > 0 and nums[i] == nums[i-1]:\n            continue\n\n        left = i + 1\n        right = n - 1\n\n        while left < right:\n            current_sum = nums[i] + nums[left] + nums[right]\n\n            if current_sum == 0:\n                return True # Found a triplet that sums to zero\n            elif current_sum < 0:\n                left += 1 # Move left pointer to increase the sum\n            else:\n                right -= 1 # Move right pointer to decrease the sum\n    return False"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    seen_numbers = set()\n    for num in l:\n        # Check if the negation of the current number is already in the set of seen numbers.\n        # If it is, then we've found two distinct elements that sum to zero.\n        if -num in seen_numbers:\n            return True\n        seen_numbers.add(num)\n    return False"}
{"task_id": "HumanEval/39", "solution": "import math\nimport sqlite3\nimport datetime\nfrom typing import Iterator, Optional\n\nclass PrimeFibError(Exception):\n    pass\n\nclass InvalidInputError(PrimeFibError):\n    pass\n\nclass ComputationError(PrimeFibError):\n    pass\n\nclass RepositoryError(PrimeFibError):\n    pass\n\nclass MathUtils:\n    def fib_generator(self, start_index: int = 0) -> Iterator[int]:\n        a, b = 0, 1\n        idx = 0\n        while True:\n            if idx >= start_index:\n                yield a\n            a, b = b, a + b\n            idx += 1\n\n    def is_prime(self, n: int) -> bool:\n        if n < 2:\n            return False\n        if n % 2 == 0:\n            return n == 2\n        r = int(math.isqrt(n))\n        for i in range(3, r + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\nclass CacheRepository:\n    def __init__(self, enable_persistence: bool=False, db_path: Optional[str]=None):\n        self.enable_persistence = enable_persistence\n        self.db_path = db_path or \"primefib_cache.db\"\n        self.in_memory_cache = {}\n        if self.enable_persistence:\n            self.ensure_schema()\n\n    def get(self, n: int) -> Optional[int]:\n        if n in self.in_memory_cache:\n            return self.in_memory_cache[n]\n        if not self.enable_persistence:\n            return None\n        try:\n            conn = self._connect_db()\n            cur = conn.execute(\"SELECT value FROM prime_fib_cache WHERE n = ?\", (n,))\n            row = cur.fetchone()\n            conn.close()\n            if row:\n                value = int(row[0])\n                self.in_memory_cache[n] = value\n                return value\n        except sqlite3.Error:\n            pass\n        return None\n\n    def set(self, n: int, value: int) -> None:\n        self.in_memory_cache[n] = value\n        if self.enable_persistence:\n            try:\n                conn = self._connect_db()\n                conn.execute(\n                    \"INSERT OR REPLACE INTO prime_fib_cache (n, value, computed_at) VALUES (?, ?, ?)\",\n                    (n, value, datetime.datetime.utcnow().isoformat()),\n                )\n                conn.commit()\n                conn.close()\n            except sqlite3.Error:\n                pass\n\n    def ensure_schema(self) -> None:\n        try:\n            conn = self._connect_db()\n            conn.execute(\n                \"CREATE TABLE IF NOT EXISTS prime_fib_cache (n INTEGER PRIMARY KEY, value INTEGER NOT NULL, computed_at TEXT NOT NULL)\"\n            )\n            conn.commit()\n            conn.close()\n        except sqlite3.Error:\n            self.enable_persistence = False\n\n    def _connect_db(self):\n        return sqlite3.connect(self.db_path)\n\nclass PrimeFibService:\n    def __init__(self, repo: CacheRepository, utils: MathUtils):\n        self.repo = repo\n        self.utils = utils\n\n    def get_nth(self, n: int) -> int:\n        if n < 1:\n            raise InvalidInputError(\"n must be >= 1\")\n        cached = self.repo.get(n)\n        if cached is not None:\n            return cached\n        value = self._compute_nth(n)\n        self.repo.set(n, value)\n        return value\n\n    def _compute_nth(self, n: int) -> int:\n        count = 0\n        for f in self.utils.fib_generator(start_index=2):\n            if self.utils.is_prime(f):\n                count += 1\n                if count == n:\n                    return f\n        raise ComputationError(\"Failed to compute\")\n\nclass PrimeFibController:\n    def __init__(self, service: PrimeFibService):\n        self.service = service\n\n    def prime_fib(self, n: int) -> int:\n        return self.service.get_nth(n)\n\nclass Config:\n    def __init__(self, enable_persistence: bool = False, db_path: Optional[str] = None, use_miller_rabin: bool = False):\n        self.enable_persistence = enable_persistence\n        self.db_path = db_path\n        self.use_miller_rabin = use_miller_rabin\n\n    def create_repository(self) -> CacheRepository:\n        return CacheRepository(enable_persistence=self.enable_persistence, db_path=self.db_path)\n\n_config = Config()\n_repo = _config.create_repository()\n_service: Optional[PrimeFibService] = None\n\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    global _service\n    if _service is None:\n        _service = PrimeFibService(_repo, MathUtils())\n    controller = PrimeFibController(_service)\n    return controller.prime_fib(n)"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    \"\"\"\n    if x == 0:\n        return \"0\"\n    \n    digits = []\n    n = x\n    while n > 0:\n        digits.append(str(n % base))\n        n //= base\n    \n    digits.reverse()\n    return ''.join(digits)"}
{"task_id": "HumanEval/42", "solution": "class ValidationError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\ndef incr_list(l: list):\n    \"\"\"Return list with elements incremented by 1.\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    \"\"\"\n    if not isinstance(l, list):\n        raise ValidationError(\"Input must be a list\")\n    for i, v in enumerate(l):\n        if not isinstance(v, int) or isinstance(v, bool):\n            raise ValidationError(f\"Element at index {i} is not an integer: {v!r}\")\n\n    return [x + 1 for x in l]"}
{"task_id": "HumanEval/45", "solution": "import logging\nimport os\nimport json\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any, Tuple, List, Dict\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return self.message\n\nclass PersistenceError(Exception):\n    \"\"\"Exception raised for issues during data persistence.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return self.message\n\nclass Config:\n    \"\"\"Central configuration values and default paths.\"\"\"\n    default_persist_path: str = \"~/.triangle_area\"\n    default_host: str = \"127.0.0.1\"\n    default_port: int = 8080\n\ndef get_persist_dir() -> str:\n    \"\"\"Expands and returns the configured persistence directory path.\"\"\"\n    return str(Path(Config.default_persist_path).expanduser())\n\ndef now_iso() -> str:\n    \"\"\"Returns the current UTC time as an ISO 8601 string.\"\"\"\n    return datetime.utcnow().isoformat(timespec='seconds') + \"Z\"\n\nclass Triangle:\n    \"\"\"Triangle domain model and basic invariants.\"\"\"\n    def __init__(self, base: float, height: float) -> None:\n        self.base: float = base\n        self.height: float = height\n\n    def area(self) -> float:\n        \"\"\"Computes the area of the triangle.\"\"\"\n        return 0.5 * self.base * self.height\n\nclass Validator:\n    \"\"\"Input validation and conversion.\"\"\"\n    def validate_positive_number(self, name: str, value: Any) -> float:\n        \"\"\"Ensures a value can be converted to a positive float.\"\"\"\n        try:\n            v = float(value)\n        except (ValueError, TypeError):\n            raise ValidationError(f\"{name} must be a number\")\n        if v <= 0:\n            raise ValidationError(f\"{name} must be > 0\")\n        return v\n\n    def validate_triangle_params(self, base: Any, height: Any) -> Tuple[float, float]:\n        \"\"\"Validates and returns typed floats for base and height.\"\"\"\n        return (self.validate_positive_number(\"base\", base),\n                self.validate_positive_number(\"height\", height))\n\nclass ResultRepository:\n    \"\"\"Append-only persistence of computation records to a JSON file.\"\"\"\n    DEFAULT_FILENAME: str = \"records.json\"\n\n    def __init__(self, path: str) -> None:\n        self._dir_path = path\n        self._file_path = os.path.join(path, self.DEFAULT_FILENAME)\n        os.makedirs(self._dir_path, exist_ok=True)\n\n    def _read_records(self) -> List[Dict[str, Any]]:\n        \"\"\"Reads all records from the JSON file.\"\"\"\n        if not os.path.exists(self._file_path):\n            return []\n        try:\n            with open(self._file_path, 'r', encoding='utf-8') as f:\n                return json.load(f)\n        except json.JSONDecodeError:\n            # File might be empty or corrupted, return empty list to start fresh.\n            return []\n        except IOError as e:\n            raise PersistenceError(f\"Failed to read records from {self._file_path}: {e}\")\n\n    def _write_records(self, records: List[Dict[str, Any]]) -> None:\n        \"\"\"Writes records to the JSON file atomically.\"\"\"\n        temp_file_path = self._file_path + \".tmp\"\n        try:\n            with open(temp_file_path, 'w', encoding='utf-8') as f:\n                json.dump(records, f, indent=2)\n            os.replace(temp_file_path, self._file_path)\n        except IOError as e:\n            if os.path.exists(temp_file_path):\n                os.remove(temp_file_path)\n            raise PersistenceError(f\"Failed to write records to {self._file_path}: {e}\")\n\n    def append_record(self, record: Dict[str, Any]) -> None:\n        \"\"\"Appends a new record to the JSON file.\"\"\"\n        records = self._read_records()\n        records.append(record)\n        self._write_records(records)\n\n    def load_all(self) -> List[Dict[str, Any]]:\n        \"\"\"Returns all persisted records.\"\"\"\n        return self._read_records()\n\nclass AreaService:\n    \"\"\"Coordinates validation, computation, and persistence.\"\"\"\n    def __init__(self, repo: ResultRepository, validator: Validator) -> None:\n        self._repo = repo\n        self._validator = validator\n\n    def compute_area(self, base: Any, height: Any, persist: bool = True) -> float:\n        \"\"\"Computes the area of a triangle, validates inputs, and optionally persists the result.\"\"\"\n        b, h = self._validator.validate_triangle_params(base, height)\n        triangle = Triangle(b, h)\n        area = triangle.area()\n\n        if persist:\n            record = {\"timestamp\": now_iso(), \"base\": b, \"height\": h, \"area\": area}\n            try:\n                self._repo.append_record(record)\n            except PersistenceError:\n                logging.warning(\"Failed to persist triangle record due to an error.\", exc_info=True)\n        return area\n\ndef triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    validator = Validator()\n    repo = ResultRepository(path=get_persist_dir())\n    area_service = AreaService(repo=repo, validator=validator)\n    return area_service.compute_area(a, h, persist=True)"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize with the base values: a=fib4(0), b=fib4(1), c=fib4(2), d=fib4(3)\n    # These represent fib4(i-4), fib4(i-3), fib4(i-2), fib4(i-1) for the current iteration i\n    a, b, c, d = 0, 0, 2, 0\n\n    # Iterate from n=4 up to the desired n\n    for i in range(4, n + 1):\n        # Calculate the next Fib4 number using the recurrence relation\n        next_fib = d + c + b + a\n        # Shift the window: (n-4), (n-3), (n-2), (n-1) becomes (n-3), (n-2), (n-1), n\n        a, b, c, d = b, c, d, next_fib\n\n    return d"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n    \n    mid = n // 2\n    \n    if n % 2 == 1:\n        # For an odd number of elements, the median is the middle element.\n        return sorted_l[mid]\n    else:\n        # For an even number of elements, the median is the average of the two middle elements.\n        # The example `[-10, 4, 6, 1000, 10, 20]` expects `15.0`, which implies averaging elements at indices `mid` and `mid + 1` from the sorted list.\n        val1 = sorted_l[mid]\n        val2 = sorted_l[mid + 1]\n        return (float(val1) + float(val2)) / 2.0"}
