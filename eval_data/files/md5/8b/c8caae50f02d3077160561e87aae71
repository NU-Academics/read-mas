{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    import math\n    import random\n\n    class InMemoryCache:\n        \"\"\"A simple in-memory dictionary cache for primality results.\"\"\"\n        def __init__(self):\n            self._store = {}\n        def get(self, n):\n            return self._store.get(n)\n        def set(self, n, is_prime, ttl=None):\n            self._store[n] = is_prime\n\n    class TrialDivisionTester:\n        \"\"\"Implements primality test using trial division up to sqrt(n).\"\"\"\n        def test(self, n: int) -> bool:\n            if n < 2: return False\n            if n == 2 or n == 3: return True\n            if n % 2 == 0 or n % 3 == 0: return False\n\n            i = 5\n            limit = int(math.isqrt(n))\n            while i <= limit:\n                if n % i == 0 or n % (i + 2) == 0: return False\n                i += 6\n            return True\n\n    class MillerRabinTester:\n        \"\"\"Implements the Miller-Rabin probabilistic primality test.\"\"\"\n        DETERMINISTIC_BASES_64 = [2, 3, 5, 7, 11, 13, 17] # Example bases from design context\n\n        def _decompose(self, n_minus_1: int) -> tuple[int, int]:\n            s = 0\n            d = n_minus_1\n            while d % 2 == 0:\n                s += 1\n                d //= 2\n            return s, d\n\n        def _miller_rabin_check(self, n: int, a: int, s: int, d: int) -> bool:\n            x = pow(a, d, n)\n            if x == 1 or x == n - 1:\n                return True\n            for _ in range(s - 1):\n                x = pow(x, 2, n)\n                if x == n - 1:\n                    return True\n            return False\n\n        def test(self, n: int, k: int = 5) -> bool:\n            if n < 2: return False\n            if n == 2 or n == 3: return True\n            if n % 2 == 0: return False\n\n            s, d = self._decompose(n - 1)\n\n            bases_to_check = []\n            if n < (1 << 64): # Use deterministic bases for numbers up to 64-bit\n                for base in self.DETERMINISTIC_BASES_64:\n                    if base < n - 1: # Bases must be in [2, n-2]\n                        bases_to_check.append(base)\n                    else:\n                        break # Bases are sorted, so no need to check further\n            else: # For very large numbers, use k random bases\n                unique_bases = set()\n                while len(unique_bases) < k:\n                    val = random.randint(2, n - 2)\n                    if val not in unique_bases:\n                        unique_bases.add(val)\n                bases_to_check = list(unique_bases)\n\n            for a in bases_to_check:\n                if not self._miller_rabin_check(n, a, s, d):\n                    return False\n            return True\n\n    class PrimalityService:\n        \"\"\"Coordinates primality checking, caching, and algorithm selection.\"\"\"\n        TRIAL_DIVISION_THRESHOLD = 10_000_000 # Threshold for switching algorithms, per design\n\n        def __init__(self, trial_division_algo, miller_rabin_algo, cache=None):\n            self._trial_division_algo = trial_division_algo\n            self._miller_rabin_algo = miller_rabin_algo\n            self._cache = cache\n\n        def _select_algorithm(self, n: int):\n            \"\"\"Selects the appropriate algorithm based on the number's magnitude.\"\"\"\n            if n < self.TRIAL_DIVISION_THRESHOLD:\n                return self._trial_division_algo\n            return self._miller_rabin_algo\n\n        def check(self, n: int) -> bool:\n            if n < 2: return False\n\n            if self._cache:\n                cached = self._cache.get(n)\n                if cached is not None:\n                    return cached\n            \n            algo = self._select_algorithm(n)\n            result = algo.test(n)\n\n            if self._cache:\n                self._cache.set(n, result)\n            \n            return result\n\n    # Initialize the default service instance as described in the design context.\n    # The PrimalityService is instantiated with both algorithms and an in-memory cache.\n    _default_service = PrimalityService(\n        trial_division_algo=TrialDivisionTester(),\n        miller_rabin_algo=MillerRabinTester(),\n        cache=InMemoryCache()\n    )\n    \n    return _default_service.check(n)"}
{"task_id": "HumanEval/34", "solution": "```python\ndef unique(l: list):\n    \"\"\"Return sorted unique elements in a list.\"\"\"\n    return sorted(list(set(l)))\n```"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    # This implementation relies on Python's default comparison behavior for elements.\n    # It does not include explicit checks for empty lists or uncomparable types due to constraints.\n    current_max = l[0]\n\n    for item in l[1:]:\n        if item > current_max:\n            current_max = item\n\n    return current_max"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    # Extract elements at indices divisible by three\n    thirds = [l[i] for i in range(0, len(l), 3)]\n    # Sort these extracted elements\n    thirds_sorted = sorted(thirds)\n\n    # Create a mutable copy of the input list to modify\n    result = list(l)\n    \n    # Replace the elements at indices divisible by three with their sorted counterparts\n    thirds_sorted_idx = 0\n    for i in range(0, len(result), 3):\n        result[i] = thirds_sorted[thirds_sorted_idx]\n        thirds_sorted_idx += 1\n        \n    return result"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\"\"\"\n    total_sevens = 0\n    for x in range(n):\n        if x % 11 == 0 or x % 13 == 0:\n            total_sevens += str(x).count('7')\n    return total_sevens"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    even_elements = []\n    for i in range(0, len(l), 2):\n        even_elements.append(l[i])\n\n    even_elements.sort()\n\n    result = list(l)  # Create a shallow copy to avoid mutating the original list\n    even_idx_tracker = 0\n    for i in range(0, len(result), 2):\n        result[i] = even_elements[even_idx_tracker]\n        even_idx_tracker += 1\n    return result"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n\n    # Helper function to get coefficients of the derivative polynomial\n    def _get_derivative_coeffs(coeffs: list) -> list:\n        \"\"\"Computes the coefficients of the derivative polynomial.\"\"\"\n        if not coeffs or len(coeffs) == 1:  # Degree 0 or empty polynomial, derivative is 0\n            return [0.0]\n        # d_coeffs[i] = (i+1) * coeffs[i+1]\n        d_coeffs = [(i + 1) * coeffs[i + 1] for i in range(len(coeffs) - 1)]\n        return d_coeffs\n\n    # Helper for float comparison\n    def _is_close(a: float, b: float, tol: float) -> bool:\n        \"\"\"Checks if two floats are close enough given a tolerance.\"\"\"\n        return abs(a - b) < tol\n\n    # Helper to calculate Cauchy bound for roots\n    def _cauchy_bound(coeffs: list[float]) -> float:\n        \"\"\"Computes a Cauchy bound for the roots of the polynomial.\"\"\"\n        if not coeffs:\n            return 0.0\n        # The problem statement implies `coeffs[-1]` (leading coefficient) is non-zero.\n        abs_leading_coeff = abs(coeffs[-1])\n        \n        max_ratio = 0.0\n        for i in range(len(coeffs) - 1):  # Iterate over non-leading coefficients\n            max_ratio = max(max_ratio, abs(coeffs[i] / abs_leading_coeff))\n        return 1.0 + max_ratio\n\n    # Helper to find a bracket where a sign change occurs\n    def _find_sign_change_bracket(coefficients: list, radius: float, steps: int) -> tuple[float, float] | None:\n        \"\"\"Searches for an interval [a, b] where poly(a)*poly(b) <= 0.\"\"\"\n        if steps <= 0:\n            return None\n        step_size = (2 * radius) / steps\n        x1 = -radius\n        y1 = poly(coefficients, x1)\n\n        for _ in range(steps):\n            x2 = x1 + step_size\n            y2 = poly(coefficients, x2)\n\n            if y1 * y2 <= 0:\n                return (x1, x2)\n            \n            x1 = x2\n            y1 = y2\n        return None\n\n    # Helper for bisection method\n    def _bisection(coefficients: list, a: float, b: float, tol: float, max_iter: int) -> float:\n        \"\"\"Performs bisection method to find a root within [a, b].\"\"\"\n        fa = poly(coefficients, a)\n        fb = poly(coefficients, b)\n        \n        # Ensure fa and fb have opposite signs (or one is zero) for proper bisection\n        if fa * fb > 0:\n             return (a + b) / 2 # Fallback if bracket doesn't guarantee sign change\n\n        if _is_close(fa, 0.0, tol): return a\n        if _is_close(fb, 0.0, tol): return b\n\n        for _ in range(max_iter):\n            c = (a + b) / 2\n            fc = poly(coefficients, c)\n\n            if _is_close(fc, 0.0, tol) or (b - a) / 2 < tol:\n                return c\n\n            if fa * fc < 0:\n                b = c\n            else: \n                a = c\n                fa = fc \n\n        return (a + b) / 2  # Return best estimate if max_iter reached\n\n    # Helper for Newton-Raphson method\n    def _newton(coefficients: list, x0: float, tol: float, max_iter: int) -> float:\n        \"\"\"Performs Newton-Raphson method to find a root.\"\"\"\n        d_coeffs = _get_derivative_coeffs(coefficients)\n        \n        for _ in range(max_iter):\n            fx = poly(coefficients, x0)\n            \n            if _is_close(fx, 0.0, tol):\n                return x0\n\n            f_prime_x = poly(d_coeffs, x0)\n            \n            # If derivative is too small, Newton-Raphson may fail or become unstable.\n            # Returning math.nan signals failure to try another seed.\n            if abs(f_prime_x) < 1e-15: \n                return math.nan \n\n            x_new = x0 - fx / f_prime_x\n            \n            if _is_close(x_new, x0, tol):\n                return x_new\n            \n            x0 = x_new\n        \n        return x0 # Return best estimate if max_iter reached\n\n    # Main logic of find_zero\n    coeffs_list = xs \n    tolerance = 1e-12\n    max_iterations = 1000\n    \n    # Preconditions (even number of coefficients, non-zero leading coefficient) \n    # are assumed to be met as per the docstring; no explicit checks.\n\n    R = _cauchy_bound(coeffs_list)\n    \n    bracket = _find_sign_change_bracket(coeffs_list, R, steps=400)\n\n    if bracket:\n        a, b = bracket\n        return _bisection(coeffs_list, a, b, tolerance, max_iterations)\n    \n    # Fallback to Newton's method with multiple seeds if no bracket found\n    for x0_seed in (0.0, R / 2.0, -R / 2.0):\n        root = _newton(coeffs_list, x0_seed, tolerance, max_iterations)\n        if not math.isnan(root):  # If Newton converged\n            return root\n    \n    # If all methods fail to converge from multiple seeds,\n    # return a fallback result from Newton's method with x0=0.0.\n    # The problem guarantees a solution under specified conditions.\n    return _newton(coeffs_list, 0.0, tolerance, max_iterations)"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # inverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
