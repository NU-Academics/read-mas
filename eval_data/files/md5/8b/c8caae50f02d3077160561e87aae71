{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    import math\n\n    if n <= 1:\n        return 0\n\n    max_divisor_found = 1\n\n    root = int(math.isqrt(n))\n    for i in range(1, root + 1):\n        if n % i == 0:\n            divisor1 = i\n            divisor2 = n // i\n\n            if divisor1 < n:\n                max_divisor_found = max(max_divisor_found, divisor1)\n            if divisor2 < n:\n                max_divisor_found = max(max_divisor_found, divisor2)\n\n    return max_divisor_found"}
{"task_id": "HumanEval/26", "solution": "def remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n\n    return result"}
{"task_id": "HumanEval/25", "solution": "```python\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    \"\"\"\n    factors = []\n    # Divide by 2 until n is odd\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Divide by odd numbers starting from 3\n    # We only need to check up to the square root of n\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            factors.append(i)\n            n //= i\n        i += 2\n\n    # If n is still greater than 1, it must be a prime factor itself\n    if n > 1:\n        factors.append(n)\n\n    return factors\n```"}
