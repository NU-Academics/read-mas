{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'.\n    Handles empty and single-element lists by returning them unchanged.\n    \"\"\"\n    if not numbers:\n        return []\n    if len(numbers) == 1:\n        return list(numbers) # Return a new list to avoid modifying the original if it were mutable\n\n    result_list = [numbers[0]]\n    for num in numbers[1:]:\n        result_list.append(delimeter)\n        result_list.append(num)\n    return result_list"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlaping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n    count = 0\n    start_index = 0\n    while True:\n        index = string.find(substring, start_index)\n        if index == -1:\n            break\n        count += 1\n        start_index = index + 1\n    return count"}
{"task_id": "HumanEval/17", "solution": "def parse_music(music_string: str) -> List[int]:\n    \"\"\" Parses a string representing musical notes and returns a list of their beat durations. \"\"\"\n    _NOTE_BEAT_MAP = {\n        \"o\": 4,   # Whole note lasts four beats\n        \"o|\": 2,  # Half note lasts two beats\n        \".|\": 1   # Quarter note lasts one beat\n    }\n    \n    notes = music_string.split(' ')\n    beat_durations = []\n    for note_symbol in notes:\n        beat_durations.append(_NOTE_BEAT_MAP[note_symbol])\n    \n    return beat_durations"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlaping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n    count = 0\n    len_string = len(string)\n    len_substring = len(substring)\n\n    # Handle the special case where the substring is empty, as per common string method behavior.\n    if len_substring == 0:\n        return len_string + 1\n\n    # Iterate through the string to check for the substring at every possible starting position.\n    for i in range(len_string - len_substring + 1):\n        if string[i : i + len_substring] == substring:\n            count += 1\n            \n    return count"}
{"task_id": "HumanEval/17", "solution": "from typing import List\n_NOTE_BEAT_MAP = {\n    'o': 4,   # whole note, lasts four beats\n    'o|': 2,  # half note, lasts two beats\n    '.|': 1   # quarter note, lasts one beat\n}\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n\n    Here is a legend:\n    'o' - whole note, lasts four beats\n    'o|' - half note, lasts two beats\n    '.|' - quater note, lasts one beat\n\n    >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    \"\"\"\n    results = []\n    i = 0\n    n = len(music_string)\n\n    while i < n:\n        # Prioritize matching longer note patterns first to avoid partial matches\n        # Check for 'o|' (length 2)\n        if i + 2 <= n and music_string[i:i+2] == 'o|':\n            results.append(_NOTE_BEAT_MAP['o|'])\n            i += 2\n        # Check for '.|' (length 2)\n        elif i + 2 <= n and music_string[i:i+2] == '.|':\n            results.append(_NOTE_BEAT_MAP['.|'])\n            i += 2\n        # Check for 'o' (length 1)\n        elif i + 1 <= n and music_string[i:i+1] == 'o':\n            results.append(_NOTE_BEAT_MAP['o'])\n            i += 1\n        else:\n            # If no known note pattern matches, advance the pointer (e.g., skip spaces).\n            i += 1\n            \n    return results"}
{"task_id": "HumanEval/19", "solution": "class NumberWord:\n    \"\"\"Encapsulates a number word's textual representation and its corresponding integer value.\"\"\"\n    def __init__(self, text: str, value: int):\n        self.text = text\n        self.value = value\n\n    def __lt__(self, other):\n        \"\"\"Enables comparison for sorting based on the numerical value.\"\"\"\n        return self.value < other.value\nWORD_TO_VALUE_MAP = {\n    'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n    'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n}\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    number_words_list = []\n    for word_text in numbers.split(' '):\n        value = WORD_TO_VALUE_MAP[word_text]\n        number_words_list.append(NumberWord(word_text, value))\n\n    number_words_list.sort() # Uses the __lt__ method of NumberWord for sorting\n\n    sorted_texts = [nw.text for nw in number_words_list]\n    return ' '.join(sorted_texts)"}
