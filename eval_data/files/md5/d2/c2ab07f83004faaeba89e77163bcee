{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\"\"\"\n\n    def _is_monotonically_increasing(lst: list) -> bool:\n        \"\"\"Checks if the given list is monotonically increasing (non-decreasing).\"\"\"\n        for i in range(1, len(lst)):\n            if lst[i] < lst[i-1]:\n                return False\n        return True\n\n    def _is_monotonically_decreasing(lst: list) -> bool:\n        \"\"\"Checks if the given list is monotonically decreasing (non-increasing).\"\"\"\n        for i in range(1, len(lst)):\n            if lst[i] > lst[i-1]:\n                return False\n        return True\n\n    if _is_monotonically_increasing(l):\n        return True\n    \n    if _is_monotonically_decreasing(l):\n        return True\n        \n    return False"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    i = 2\n    largest_factor = 1\n    while i * i <= n:\n        if n % i == 0:\n            largest_factor = i\n            while n % i == 0:\n                n //= i\n        i += 1\n    if n > 1:  # If n is still greater than 1, it must be a prime factor itself\n        largest_factor = n\n    return largest_factor"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n    d = 2\n\n    while n % d == 0:\n        largest_factor = d\n        n //= d\n\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            largest_factor = d\n            n //= d\n        d += 2\n\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
