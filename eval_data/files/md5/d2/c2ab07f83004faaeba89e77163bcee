{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    is_even = (n % 2 == 0)\n    is_greater_or_equal_to_8 = (n >= 8)\n\n    if not is_even:\n        return False\n    if not is_greater_or_equal_to_8:\n        return False\n\n    return True"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    # First, replace sequences of 3 or more spaces with a single hyphen.\n    # This handles \"more than 2 consecutive spaces\".\n    text = re.sub(r' {3,}', '-', text)\n    \n    # Next, replace sequences of exactly 2 spaces with two underscores.\n    text = re.sub(r' {2}', '__', text)\n    \n    # Finally, replace any remaining single spaces with an underscore.\n    text = text.replace(' ', '_')\n    \n    return text"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    # First, replace sequences of 3 or more spaces with a single hyphen.\n    # This must be done before replacing single spaces to ensure the correct rule application.\n    text = re.sub(r' {3,}', '-', text)\n    \n    # Second, replace any remaining single spaces (which now only come from original\n    # single or double space sequences) with underscores.\n    text = re.sub(r' ', '_', text)\n    \n    return text"}
{"task_id": "HumanEval/141", "solution": "class FileName:\n    \"\"\"Encapsulates file name string and provides methods for individual validation checks.\"\"\"\n    def __init__(self, full_name: str):\n        self._full_name = full_name\n        self._name_part = \"\"\n        self._extension_part = \"\"\n        self._split_name_parts()\n\n    def _split_name_parts(self):\n        \"\"\"Splits the full file name into name and extension parts based on the dot.\"\"\"\n        if self._full_name.count('.') == 1:\n            parts = self._full_name.split('.')\n            self._name_part = parts[0]\n            self._extension_part = parts[1]\n\n    def check_digit_count(self) -> bool:\n        \"\"\"Checks if the full name contains no more than three digits.\"\"\"\n        digit_count = sum(1 for char in self._full_name if char.isdigit())\n        return digit_count <= 3\n\n    def check_dot_count(self) -> bool:\n        \"\"\"Checks if the full name contains exactly one dot.\"\"\"\n        return self._full_name.count('.') == 1\n\n    def check_name_part_not_empty(self) -> bool:\n        \"\"\"Checks if the substring before the dot is not empty.\"\"\"\n        return bool(self._name_part)\n\n    def check_name_part_starts_with_letter(self) -> bool:\n        \"\"\"Checks if the substring before the dot starts with a latin letter.\"\"\"\n        return bool(self._name_part) and self._name_part[0].isalpha()\n\n    def check_extension_type(self) -> bool:\n        \"\"\"Checks if the substring after the dot is one of 'txt', 'exe', or 'dll'.\"\"\"\n        return self._extension_part in ['txt', 'exe', 'dll']\nclass FileNameValidator:\n    \"\"\"Orchestrates the validation process by applying all business rules to a FileName object.\"\"\"\n    def validate(self, file_name_obj: FileName) -> bool:\n        \"\"\"Takes a FileName object and returns True if all validation checks pass, False otherwise.\"\"\"\n        results = [\n            file_name_obj.check_digit_count(),\n            file_name_obj.check_dot_count(),\n            file_name_obj.check_name_part_not_empty(),\n            file_name_obj.check_name_part_starts_with_letter(),\n            file_name_obj.check_extension_type()\n        ]\n        return all(results)\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions \n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from \n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    file_name_obj = FileName(file_name)\n    validator = FileNameValidator()\n    \n    if validator.validate(file_name_obj):\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, returning only those whose lengths are prime numbers.\n    The order of words is preserved.\n    \"\"\"\n\n    class PrimeNumberChecker:\n        \"\"\"Utility for determining if a number is prime.\"\"\"\n        @staticmethod\n        def is_prime(number: int) -> bool:\n            if number < 2:\n                return False\n            if number == 2:\n                return True\n            if number % 2 == 0:\n                return False\n            i = 3\n            while i * i <= number:\n                if number % i == 0:\n                    return False\n                i += 2\n            return True\n\n    class Word:\n        \"\"\"Represents a word with its value and length, and prime length status.\"\"\"\n        def __init__(self, value: str):\n            self.value = value\n            self.length = len(value)\n\n        def is_prime_length(self) -> bool:\n            return PrimeNumberChecker.is_prime(self.length)\n\n    def validate_sentence(s: str):\n        \"\"\"Validates the input sentence against length and character set constraints.\"\"\"\n        if not (1 <= len(s) <= 100):\n            raise ValueError(\"Sentence length must be between 1 and 100 characters.\")\n        if not all(c.isalpha() or c.isspace() for c in s):\n            raise ValueError(\"Sentence must contain only letters and spaces.\")\n\n    # Main orchestration logic\n    validate_sentence(sentence)\n\n    words_list = sentence.split()\n    filtered_words = []\n\n    for word_string in words_list:\n        word_obj = Word(word_string)\n        if word_obj.is_prime_length():\n            filtered_words.append(word_obj.value)\n\n    return \" \".join(filtered_words)"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += num * num\n        elif i % 4 == 0:\n            total_sum += num * num * num\n        else:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for index, value in enumerate(lst):\n        processed_value = value\n        if index % 3 == 0:\n            processed_value = value ** 2\n        elif index % 4 == 0: # This implicitly means index % 3 != 0 due to the 'if' condition above\n            processed_value = value ** 3\n        total_sum += processed_value\n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words in a sentence, returning only those with prime lengths,\n    maintaining their original order.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a given integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split()\n    prime_length_words = []\n\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Represents a fraction with a numerator and a denominator.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    @staticmethod\n    def parse(fraction_string: str) -> 'Fraction':\n        \"\"\"Parses a string \"num/den\" into a Fraction object.\"\"\"\n        num_str, den_str = fraction_string.split('/')\n        return Fraction(int(num_str), int(den_str))\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another fraction and returns a new Fraction.\"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Checks if the fraction represents a whole number.\"\"\"\n        return self.numerator % self.denominator == 0\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n    \"\"\"\n    fraction_x = Fraction.parse(x)\n    fraction_n = Fraction.parse(n)\n\n    product_fraction = fraction_x.multiply(fraction_n)\n\n    return product_fraction.is_whole_number()"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions \n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from \n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    \"\"\"\n\n    class FileName:\n        \"\"\"Encapsulates a file's full name and provides methods to parse and store its components.\"\"\"\n        def __init__(self, full_name: str):\n            self._full_name = full_name\n            self.digit_count = 0\n            self.dot_count = 0\n            self.prefix = \"\"\n            self.suffix = \"\"\n            self.is_valid = False\n\n        def parse_name(self) -> None:\n            \"\"\"Parses the full_name to populate digit_count, dot_count, prefix, and suffix.\"\"\"\n            self.digit_count = self.count_digits()\n            self.dot_count = self.count_dots()\n            self.prefix = self.extract_prefix()\n            self.suffix = self.extract_suffix()\n\n        def count_digits(self) -> int:\n            \"\"\"Counts and returns the number of digits in _full_name.\"\"\"\n            return sum(1 for char in self._full_name if char.isdigit())\n\n        def count_dots(self) -> int:\n            \"\"\"Counts and returns the number of dots in _full_name.\"\"\"\n            return self._full_name.count('.')\n\n        def extract_prefix(self) -> str:\n            \"\"\"Extracts and returns the substring before the first dot.\"\"\"\n            dot_index = self._full_name.find('.')\n            if dot_index != -1:\n                return self._full_name[:dot_index]\n            return self._full_name\n\n        def extract_suffix(self) -> str:\n            \"\"\"Extracts and returns the substring after the first dot.\"\"\"\n            dot_index = self._full_name.find('.')\n            if dot_index != -1:\n                return self._full_name[dot_index + 1:]\n            return \"\"\n\n    class Validator:\n        \"\"\"Applies all defined business rules to a FileName object to determine its validity.\"\"\"\n        def validate_digit_count(self, file_name_obj: FileName) -> bool:\n            \"\"\"Checks if digit_count is not more than three.\"\"\"\n            return file_name_obj.digit_count <= 3\n\n        def validate_dot_count(self, file_name_obj: FileName) -> bool:\n            \"\"\"Checks if dot_count is exactly one.\"\"\"\n            return file_name_obj.dot_count == 1\n\n        def validate_prefix_not_empty(self, file_name_obj: FileName) -> bool:\n            \"\"\"Checks if prefix is not empty.\"\"\"\n            return len(file_name_obj.prefix) > 0\n\n        def validate_prefix_start_char(self, file_name_obj: FileName) -> bool:\n            \"\"\"Checks if prefix starts with a latin letter.\"\"\"\n            if not file_name_obj.prefix:\n                return False\n            return file_name_obj.prefix[0].isalpha()\n\n        def validate_suffix_type(self, file_name_obj: FileName) -> bool:\n            \"\"\"Checks if suffix is one of ['txt', 'exe', 'dll'].\"\"\"\n            return file_name_obj.suffix in ['txt', 'exe', 'dll']\n\n        def check_file_name(self, file_name_obj: FileName) -> str:\n            \"\"\"Orchestrates all validation checks and returns 'Yes' or 'No'.\"\"\"\n            # Validate dot count first, as other rules depend on a single dot.\n            if not self.validate_dot_count(file_name_obj):\n                file_name_obj.is_valid = False\n                return 'No'\n\n            is_valid = (\n                self.validate_digit_count(file_name_obj) and\n                self.validate_prefix_not_empty(file_name_obj) and\n                self.validate_prefix_start_char(file_name_obj) and\n                self.validate_suffix_type(file_name_obj)\n            )\n            file_name_obj.is_valid = is_valid\n            return 'Yes' if is_valid else 'No'\n\n    file_name_obj = FileName(file_name)\n    file_name_obj.parse_name()\n\n    validator = Validator()\n    result = validator.check_file_name(file_name_obj)\n\n    return result"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Represents a fraction parsed from a string.\"\"\"\n    def __init__(self, fraction_string: str):\n        \"\"\"Parses a fraction string 'numerator/denominator' into integer components.\"\"\"\n        numerator_str, denominator_str = fraction_string.split('/')\n        self._numerator = int(numerator_str)\n        self._denominator = int(denominator_str)\n\n    def getNumerator(self) -> int:\n        \"\"\"Returns the numerator of the fraction.\"\"\"\n        return self._numerator\n\n    def getDenominator(self) -> int:\n        \"\"\"Returns the denominator of the fraction.\"\"\"\n        return self._denominator\nclass FractionProduct:\n    \"\"\"Manages two Fraction objects, calculates their product, and checks if it's a whole number.\"\"\"\n    def __init__(self, fraction_x: Fraction, fraction_n: Fraction):\n        \"\"\"Initializes with two Fraction objects and calculates their product numerator and denominator.\"\"\"\n        self._fraction_x = fraction_x\n        self._fraction_n = fraction_n\n        self._product_numerator = self.calculateProductNumerators()\n        self._product_denominator = self.calculateProductDenominators()\n\n    def calculateProductNumerators(self) -> int:\n        \"\"\"Calculates and returns the product of the numerators of the two fractions.\"\"\"\n        return self._fraction_x.getNumerator() * self._fraction_n.getNumerator()\n\n    def calculateProductDenominators(self) -> int:\n        \"\"\"Calculates and returns the product of the denominators of the two fractions.\"\"\"\n        return self._fraction_x.getDenominator() * self._fraction_n.getDenominator()\n\n    def isWholeNumber(self) -> bool:\n        \"\"\"Determines if the calculated fraction product is a whole number.\"\"\"\n        return self._product_numerator % self._product_denominator == 0\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    x_fraction = Fraction(x)\n    n_fraction = Fraction(n)\n\n    fraction_product = FractionProduct(x_fraction, n_fraction)\n    return fraction_product.isWholeNumber()"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits, then by original index.\n    Helper `_calculate_digit_sum` computes the sum of absolute digits.\n    \"\"\"\n\n    class SortableInteger:\n        \"\"\"\n        Encapsulates an integer with its digit sum and original index for sorting.\n        Comparison is based on digit sum, then original index.\n        \"\"\"\n        def __init__(self, value, original_index):\n            self.value = value\n            self.original_index = original_index\n            self.digit_sum = _calculate_digit_sum(value)\n\n        def __lt__(self, other):\n            if self.digit_sum != other.digit_sum:\n                return self.digit_sum < other.digit_sum\n            return self.original_index < other.original_index\n\n    def _calculate_digit_sum(num):\n        \"\"\"Calculates the sum of the absolute values of digits for an integer.\"\"\"\n        s = 0\n        num = abs(num)\n        if num == 0:\n            return 0\n        while num > 0:\n            s += num % 10\n            num //= 10\n        return s\n\n    if not nums:\n        return []\n\n    sortable_items = []\n    for i, num in enumerate(nums):\n        sortable_items.append(SortableInteger(num, i))\n\n    sortable_items.sort()\n\n    return [item.value for item in sortable_items]"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns\n    the number of elements in the array that are greater than 10 and both\n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    \"\"\"\n\n    def _is_odd(digit: int) -> bool:\n        \"\"\"Determines if a given digit is odd.\"\"\"\n        return digit % 2 != 0\n\n    def _get_first_digit(number: int) -> int:\n        \"\"\"Extracts the first digit of a number (considering its absolute value).\"\"\"\n        return int(str(abs(number))[0])\n\n    def _get_last_digit(number: int) -> int:\n        \"\"\"Extracts the last digit of a number (considering its absolute value).\"\"\"\n        return abs(number) % 10\n\n    def _is_greater_than_ten(number: int) -> bool:\n        \"\"\"Checks if a number is strictly greater than 10.\"\"\"\n        return number > 10\n\n    count = 0\n    for number in nums:\n        if _is_greater_than_ten(number):\n            first_digit = _get_first_digit(number)\n            last_digit = _get_last_digit(number)\n            if _is_odd(first_digit) and _is_odd(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/148", "solution": "class Planet:\n    \"\"\"Represents a single planet with its name and orbital order from the Sun.\"\"\"\n    def __init__(self, name: str, order_from_sun: int):\n        self.name = name\n        self.order_from_sun = order_from_sun\nclass SolarSystem:\n    \"\"\"Manages the predefined list of planets and provides methods to query their properties.\"\"\"\n    def __init__(self):\n        self._planets_data = [\n            Planet(\"Mercury\", 1),\n            Planet(\"Venus\", 2),\n            Planet(\"Earth\", 3),\n            Planet(\"Mars\", 4),\n            Planet(\"Jupiter\", 5),\n            Planet(\"Saturn\", 6),\n            Planet(\"Uranus\", 7),\n            Planet(\"Neptune\", 8),\n        ]\n        self._planet_name_to_order = {\n            planet.name: planet.order_from_sun for planet in self._planets_data\n        }\n\n    def get_planet_order(self, planet_name: str) -> int | None:\n        \"\"\"Returns the orbital order of a given planet name, or None if not found.\"\"\"\n        return self._planet_name_to_order.get(planet_name)\n\n    def get_planets_between(self, planet1_name: str, planet2_name: str) -> tuple[str, ...]:\n        \"\"\"Identifies and returns a tuple of planet names located strictly between planet1 and planet2.\"\"\"\n        order1 = self.get_planet_order(planet1_name)\n        order2 = self.get_planet_order(planet2_name)\n\n        if order1 is None or order2 is None:\n            return ()\n\n        min_order = min(order1, order2)\n        max_order = max(order1, order2)\n\n        result_planets = []\n        for planet in self._planets_data:\n            if min_order < planet.order_from_sun < max_order:\n                result_planets.append(planet.name)\n\n        return tuple(result_planets)\ndef bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple containing all planets whose orbits are located between the orbit of planet1 and planet2.\n    Returns an empty tuple if planet1 or planet2 are not correct planet names.\n    \"\"\"\n    solar_system = SolarSystem()\n    return solar_system.get_planets_between(planet1, planet2)"}
{"task_id": "HumanEval/146", "solution": "from typing import List\nclass Number:\n    \"\"\"Encapsulates an integer and provides methods for digit analysis.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def getFirstDigit(self) -> int:\n        \"\"\"Returns the first digit of the absolute value of the number.\"\"\"\n        abs_value_str = str(abs(self._value))\n        return int(abs_value_str[0])\n\n    def getLastDigit(self) -> int:\n        \"\"\"Returns the last digit of the absolute value of the number.\"\"\"\n        abs_value_str = str(abs(self._value))\n        return int(abs_value_str[-1])\n\n    def isOdd(self, digit: int) -> bool:\n        \"\"\"Checks if a given digit is odd.\"\"\"\n        return digit in {1, 3, 5, 7, 9}\nclass ArrayOfNumbers:\n    \"\"\"Manages a collection of Number objects, converting raw integers to Number instances.\"\"\"\n    def __init__(self, nums: List[int]):\n        self._elements: List[Number] = [Number(num) for num in nums]\n\n    def getNumbers(self) -> List[Number]:\n        \"\"\"Returns the list of Number objects.\"\"\"\n        return self._elements\ndef specialFilter(nums: List[int]) -> int:\n    \"\"\"Write a function that takes an array of numbers as input and returns\n    the number of elements in the array that are greater than 10 and both\n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    For example:\n    specialFilter([15, -73, 14, -15]) => 1\n    specialFilter([33, -2, -3, 45, 21, 109]) => 2\n    \"\"\"\n    special_numbers_count = 0\n    array_of_numbers = ArrayOfNumbers(nums)\n\n    for num_obj in array_of_numbers.getNumbers():\n        is_greater_than_10 = num_obj._value > 10\n\n        first_digit = num_obj.getFirstDigit()\n        is_first_digit_odd = num_obj.isOdd(first_digit)\n\n        last_digit = num_obj.getLastDigit()\n        is_last_digit_odd = num_obj.isOdd(last_digit)\n\n        if is_greater_than_10 and is_first_digit_odd and is_last_digit_odd:\n            special_numbers_count += 1\n\n    return special_numbers_count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) where i < j < k and their sum is a multiple of 3.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    # Generate array 'a' where a[idx] = (idx+1)*(idx+1) - (idx+1) + 1 for 0-based idx\n    array_a = [(idx + 1) * (idx + 1) - (idx + 1) + 1 for idx in range(n)]\n\n    valid_triples_count = 0\n    array_len = len(array_a)\n\n    for i in range(array_len - 2):\n        for j in range(i + 1, array_len - 1):\n            for k in range(j + 1, array_len):\n                # Check if the sum of three integers is a multiple of 3\n                if (array_a[i] + array_a[j] + array_a[k]) % 3 == 0:\n                    valid_triples_count += 1\n\n    return valid_triples_count"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If digit sums are equal, items are ordered based on their original index.\n    \"\"\"\n\n    def _calculate_digit_sum(num: int) -> int:\n        \"\"\"Calculates the sum of the absolute digits of a given integer.\"\"\"\n        s = str(abs(num))\n        digit_sum = 0\n        for digit_char in s:\n            digit_sum += int(digit_char)\n        return digit_sum\n\n    class SortableInteger:\n        \"\"\"Encapsulates an integer's value, its digit sum, and original index for sorting.\"\"\"\n        def __init__(self, value: int, original_index: int):\n            self.value = value\n            self.original_index = original_index\n            self.digit_sum = _calculate_digit_sum(value)\n\n        def __lt__(self, other) -> bool:\n            \"\"\"Implements less-than comparison for sorting based on digit_sum then original_index.\"\"\"\n            if self.digit_sum != other.digit_sum:\n                return self.digit_sum < other.digit_sum\n            return self.original_index < other.original_index\n\n    if not nums:\n        return []\n\n    sortable_items = []\n    for i, num in enumerate(nums):\n        sortable_items.append(SortableInteger(num, i))\n\n    sortable_items.sort()\n\n    sorted_values = [item.value for item in sortable_items]\n\n    return sorted_values"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, \n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation: \n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n\n    # Generate the array 'a' where a_values[idx] corresponds to the a[i] from the problem with i = idx + 1.\n    a_values = []\n    for i in range(1, n + 1):\n        a_values.append(i * i - i + 1)\n\n    count = 0\n    # Iterate through all combinations of three distinct indices (i, j, k) such that i < j < k.\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                # Calculate the sum of the elements at these indices.\n                current_sum = a_values[i] + a_values[j] + a_values[k]\n                \n                # If the sum is a multiple of 3, increment the counter.\n                if current_sum % 3 == 0:\n                    count += 1\n                    \n    return count"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    \n    class Planet:\n        '''Represents a planet with its name and orbital order.'''\n        def __init__(self, name: str, orbital_order: int):\n            self.name = name\n            self.orbital_order = orbital_order\n\n    class SolarSystem:\n        '''Manages the predefined list of planets and provides lookup methods.'''\n        def __init__(self):\n            planet_names = [\n                \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \n                \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n            ]\n            self._planets = [Planet(name, i) for i, name in enumerate(planet_names)]\n            self._planet_map = {planet.name: planet for planet in self._planets}\n\n        def get_planet_by_name(self, name: str) -> Planet | None:\n            '''Returns a Planet object if the name is valid, otherwise None.'''\n            return self._planet_map.get(name)\n\n        def get_planets_between(self, planet1: Planet, planet2: Planet) -> list[Planet]:\n            '''Returns a list of planets strictly between planet1 and planet2, sorted by orbital order.'''\n            start_order = min(planet1.orbital_order, planet2.orbital_order)\n            end_order = max(planet1.orbital_order, planet2.orbital_order)\n            \n            between_planets = []\n            for planet in self._planets:\n                if start_order < planet.orbital_order < end_order:\n                    between_planets.append(planet)\n            return between_planets\n\n    solar_system = SolarSystem()\n\n    p1_obj = solar_system.get_planet_by_name(planet1)\n    p2_obj = solar_system.get_planet_by_name(planet2)\n\n    if p1_obj is None or p2_obj is None:\n        return ()\n\n    intermediate_planets = solar_system.get_planets_between(p1_obj, p2_obj)\n    \n    return tuple(p.name for p in intermediate_planets)"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    def is_prime(num):\n        \"\"\"Checks if a given integer is a prime number.\"\"\"\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    def is_prime(num):\n        \"\"\"Helper function to determine if a number is prime.\"\"\"\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/149", "solution": "class String:\n    \"\"\"Encapsulates a string value and its length, providing odd-length check and comparison.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n        self._length = len(value)\n\n    def is_odd_length(self) -> bool:\n        \"\"\"Returns True if the string's length is odd.\"\"\"\n        return self._length % 2 != 0\n\n    def get_value(self) -> str:\n        \"\"\"Returns the encapsulated string value.\"\"\"\n        return self._value\n\n    def get_length(self) -> int:\n        \"\"\"Returns the length of the encapsulated string.\"\"\"\n        return self._length\n\n    def __lt__(self, other) -> bool:\n        \"\"\"Enables comparison for sorting: first by length, then alphabetically.\"\"\"\n        if self._length != other._length:\n            return self._length < other._length\n        return self._value < other._value\nclass StringList:\n    \"\"\"Manages a collection of String objects, providing filtering and sorting.\"\"\"\n    def __init__(self, initial_strings: list[str]):\n        self._strings = [String(s) for s in initial_strings]\n\n    def remove_odd_length_strings(self) -> None:\n        \"\"\"Filters out String objects with odd lengths.\"\"\"\n        self._strings = [s for s in self._strings if not s.is_odd_length()]\n\n    def sort_strings(self) -> None:\n        \"\"\"Sorts the internal list of String objects by length then alphabetically.\"\"\"\n        self._strings.sort()\n\n    def get_sorted_list(self) -> list[str]:\n        \"\"\"Returns the current list of String objects converted back to raw strings.\"\"\"\n        return [s.get_value() for s in self._strings]\ndef sorted_list_sum(lst):\n    \"\"\"Write a function that accepts a list of strings as a parameter,\n    deletes the strings that have odd lengths from it,\n    and returns the resulted list with a sorted order,\n    The list is always a list of strings and never an array of numbers,\n    and it may contain duplicates.\n    The order of the list should be ascending by length of each word, and you\n    should return the list sorted by that rule.\n    If two words have the same length, sort the list alphabetically.\n    The function should return a list of strings in sorted order.\n    You may assume that all words will have the same length.\n    For example:\n    assert list_sort([\"aa\", \"a\", \"aaa\"]) => [\"aa\"]\n    assert list_sort([\"ab\", \"a\", \"aaa\", \"cd\"]) => [\"ab\", \"cd\"]\n    \"\"\"\n    string_list_manager = StringList(lst)\n    string_list_manager.remove_odd_length_strings()\n    string_list_manager.sort_strings()\n    return string_list_manager.get_sorted_list()"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Write a function that accepts a list of strings as a parameter,\n    deletes the strings that have odd lengths from it,\n    and returns the resulted list with a sorted order,\n    The list is always a list of strings and never an array of numbers,\n    and it may contain duplicates.\n    The order of the list should be ascending by length of each word, and you\n    should return the list sorted by that rule.\n    If two words have the same length, sort the list alphabetically.\n    The function should return a list of strings in sorted order.\n    You may assume that all words will have the same length.\n    For example:\n    assert list_sort([\"aa\", \"a\", \"aaa\"]) => [\"aa\"]\n    assert list_sort([\"ab\", \"a\", \"aaa\", \"cd\"]) => [\"ab\", \"cd\"]\n    \"\"\"\n    # Filter out strings with odd lengths.\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort primarily by length (ascending), secondarily by alphabetical order (ascending).\n    sorted_result = sorted(even_length_strings, key=lambda s: (len(s), s))\n\n    return sorted_result"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Calculates the absolute difference between corresponding game scores and guesses.\n    Returns a list of these differences, with 0 if the guess was correct.\"\"\"\n    result_list = []\n    for i in range(len(game)):\n        actual_score = game[i]\n        guessed_score = guess[i]\n        difference = abs(actual_score - guessed_score)\n        result_list.append(difference)\n    return result_list"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0  \n   \n    If the input list is empty, return 0.\n    '''\n    \n    class _NumberValidator:\n        def __init__(self, value):\n            self._value = value\n\n        def is_integer(self):\n            # Checks if the value is an integer or a float representing an integer.\n            return isinstance(self._value, int) or \\\n                   (isinstance(self._value, float) and self._value.is_integer())\n\n        def is_non_negative(self):\n            return self._value >= 0\n\n        def is_odd(self):\n            # Assumes the value is an integer at this point.\n            return self._value % 2 != 0\n\n        def get_square(self):\n            return int(self._value * self._value)\n\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for element in lst:\n        validator = _NumberValidator(element)\n        if validator.is_integer() and validator.is_non_negative() and validator.is_odd():\n            total_sum += validator.get_square()\n            \n    return total_sum"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    '''\n    total_sum = 0\n    if not lst:\n        return 0\n\n    for item in lst:\n        # Check if the item is an integer and non-negative.\n        # We need to explicitly check for float because type(item) is int for integers\n        # and float for floats, but a float can represent an integer value (e.g., 5.0).\n        # However, the problem statement says \"not integers\", implying strict integer types.\n        # So, we check for both `isinstance(item, int)` and `item >= 0`.\n        if isinstance(item, int) and item >= 0:\n            # Check if the non-negative integer is odd.\n            if item % 2 != 0:\n                total_sum += item * item\n    return total_sum"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM calculation and returns it in ClassName.StrongestExtensionName format.\"\"\"\n\n    def _calculate_extension_strength(extension_name: str) -> int:\n        \"\"\"Calculates the strength of an extension by counting uppercase (CAP) and lowercase (SM) letters (CAP - SM).\"\"\"\n        cap_count = 0\n        sm_count = 0\n        for char in extension_name:\n            if char.isupper():\n                cap_count += 1\n            elif char.islower():\n                sm_count += 1\n        return cap_count - sm_count\n\n    if not extensions:\n        return f\"{class_name}.\"\n\n    strongest_extension_name = \"\"\n    max_strength = float('-inf')\n\n    # Iterate through extensions to find the strongest one.\n    # The tie-breaking rule (first in list) is implicitly handled\n    # by only updating the strongest if current_strength is strictly greater.\n    for extension_name in extensions:\n        current_strength = _calculate_extension_strength(extension_name)\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension_name\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Compares actual game scores with guessed scores to determine the difference for each match.\n    Returns a list of absolute differences, with 0 for correctly guessed scores.\"\"\"\n    \n    differences = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            differences.append(0)\n        else:\n            differences.append(abs(game[i] - guess[i]))\n    return differences"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\n    \"\"\"\n    def _generate_rotations(s: str) -> list[str]:\n        \"\"\"Generates all cyclic rotations of a given string.\"\"\"\n        rotations = []\n        n = len(s)\n        if n == 0:\n            return [\"\"]\n        for i in range(n):\n            rotated_s = s[i:] + s[:i]\n            rotations.append(rotated_s)\n        return rotations\n\n    b_rotations = _generate_rotations(b)\n\n    for rotation in b_rotations:\n        if rotation in a:\n            return True\n    return False"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    def _generate_rotations(s: str) -> list[str]:\n        # Helper function to generate all cyclic rotations of string 's'.\n        # Returns a list of unique rotations.\n        if not s:\n            return [\"\"]\n\n        n = len(s)\n        rotations = set()\n        for i in range(n):\n            rotated_s = s[i:] + s[:i]\n            rotations.add(rotated_s)\n        return list(rotations)\n\n    if len(b) > len(a):\n        return False\n\n    rotations_of_b = _generate_rotations(b)\n\n    for rotation in rotations_of_b:\n        if rotation in a:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/153", "solution": "class ExtensionInfo:\n    \"\"\"Encapsulates an extension's name and its calculated strength.\"\"\"\n    def __init__(self, name: str, strength: int):\n        self.name = name\n        self.strength = strength\ndef _calculate_strength(extension_name: str) -> int:\n    \"\"\"Calculates the strength of an extension name (CAP - SM).\"\"\"\n    cap_count = 0\n    sm_count = 0\n    for char in extension_name:\n        if 'A' <= char <= 'Z':\n            cap_count += 1\n        elif 'a' <= char <= 'z':\n            sm_count += 1\n    return cap_count - sm_count\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on character case count and formats the output.\n    \"\"\"\n    strongest_extension_info = None\n    max_strength = float('-inf')\n\n    for extension_name in extensions:\n        current_strength = _calculate_strength(extension_name)\n        current_ext_info = ExtensionInfo(extension_name, current_strength)\n\n        if current_ext_info.strength > max_strength:\n            max_strength = current_ext_info.strength\n            strongest_extension_info = current_ext_info\n        # If strengths are equal, the first encountered extension is kept.\n\n    return f\"{class_name}.{strongest_extension_info.name}\""}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Converts a positive integer to its lowercase Roman numeral equivalent.\n    The input number must be between 1 and 1000, inclusive.\n    \"\"\"\n    _ROMAN_MAPS = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'),\n        (1, 'I')\n    ]\n\n    def _validate_input(num_to_validate):\n        \"\"\"Validates if the input number is within the range [1, 1000].\"\"\"\n        if not (1 <= num_to_validate <= 1000):\n            raise ValueError(\"Input out of range: number must be between 1 and 1000.\")\n\n    def _convert_to_uppercase_roman(num_to_convert):\n        \"\"\"Converts a validated integer into its uppercase Roman numeral string.\"\"\"\n        roman_numeral = []\n        current_num = num_to_convert\n        for value, symbol in _ROMAN_MAPS:\n            while current_num >= value:\n                roman_numeral.append(symbol)\n                current_num -= value\n        return \"\".join(roman_numeral)\n\n    _validate_input(number)\n    uppercase_roman = _convert_to_uppercase_roman(number)\n    return uppercase_roman.lower()"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    \n    # Get the absolute value of the number to handle negative inputs\n    abs_num = abs(num)\n    \n    # Convert the absolute number to a string to easily iterate through its digits\n    num_str = str(abs_num)\n    \n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n            \n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Input number must be between 1 and 1000, inclusive.\")\n\n    roman_map = {\n        1000: 'M', 900: 'CM', 500: 'D', 400: 'CD', 100: 'C', 90: 'XC',\n        50: 'L', 40: 'XL', 10: 'X', 9: 'IX', 5: 'V', 4: 'IV', 1: 'I'\n    }\n    result = []\n    temp_num = number\n    # Iterate through the map in descending order of values.\n    for value, numeral in sorted(roman_map.items(), reverse=True):\n        while temp_num >= value:\n            result.append(numeral)\n            temp_num -= value\n    standard_roman = \"\".join(result)\n\n    return standard_roman.lower()"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    \n    # Convert the absolute value of the number to a string to iterate through digits.\n    # This handles negative numbers and makes digit extraction straightforward.\n    num_str = str(abs(num))\n    \n    for char_digit in num_str:\n        digit = int(char_digit)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n            \n    return (even_count, odd_count)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    def _calculate_unique_chars(word: str) -> int:\n        \"\"\"Counts the number of unique characters in a string.\"\"\"\n        return len(set(word))\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = _calculate_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: return the one which comes first in lexicographical order\n            if word < result_word:\n                result_word = word\n\n    return result_word"}
{"task_id": "HumanEval/157", "solution": "import math\nclass Triangle:\n    \"\"\"\n    Represents a triangle with three side lengths and provides methods\n    for validation and determining if it is a right-angled triangle.\n    \"\"\"\n    _EPSILON = 1e-9 # Tolerance for floating-point comparisons\n\n    def __init__(self, a: float, b: float, c: float):\n        \"\"\"\n        Initializes a Triangle object with three side lengths.\n        \"\"\"\n        self._sideA = float(a)\n        self._sideB = float(b)\n        self._sideC = float(c)\n\n    def is_valid_sides(self) -> bool:\n        \"\"\"\n        Checks if all side lengths are positive.\n        \"\"\"\n        return self._sideA > 0 and self._sideB > 0 and self._sideC > 0\n\n    def forms_valid_triangle(self) -> bool:\n        \"\"\"\n        Checks if the side lengths satisfy the triangle inequality theorem.\n        \"\"\"\n        if not self.is_valid_sides():\n            return False\n\n        sides = sorted([self._sideA, self._sideB, self._sideC])\n        return (sides[0] + sides[1]) > sides[2]\n\n    def is_right_angled(self) -> bool:\n        \"\"\"\n        Determines if the triangle is right-angled using the Pythagorean theorem.\n        \"\"\"\n        if not self.forms_valid_triangle():\n            return False\n\n        sides = sorted([self._sideA, self._sideB, self._sideC])\n        a_sq = sides[0] ** 2\n        b_sq = sides[1] ** 2\n        c_sq = sides[2] ** 2\n\n        return abs(a_sq + b_sq - c_sq) < self._EPSILON\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    triangle = Triangle(a, b, c)\n    return triangle.is_right_angled()"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Side lengths must be positive.\n    if a <= 0 or b <= 0 or c <= 0:\n        return False\n\n    # Square the side lengths.\n    a_sq = a * a\n    b_sq = b * b\n    c_sq = c * c\n\n    # Check if the sum of squares of two sides equals the square of the third side.\n    # This implicitly identifies the hypotenuse as the longest side.\n    return (a_sq + b_sq == c_sq) or \\\n           (a_sq + c_sq == b_sq) or \\\n           (b_sq + c_sq == a_sq)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n\n    def _calculate_unique_chars(word: str) -> int:\n        \"\"\"Counts the number of unique characters in a given string.\"\"\"\n        return len(set(word))\n\n    max_unique_chars_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_chars_count = _calculate_unique_chars(word)\n\n        if current_unique_chars_count > max_unique_chars_count:\n            max_unique_chars_count = current_unique_chars_count\n            result_word = word\n        elif current_unique_chars_count == max_unique_chars_count:\n            # Tie-breaking: return the lexicographically smaller word\n            if word < result_word:\n                result_word = word\n\n    return result_word"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \"\"\"\n    \n    carrots_consumed: int\n    total_eaten_carrots: int\n    carrots_left: int\n\n    if need <= remaining:\n        carrots_consumed = need\n        total_eaten_carrots = number + carrots_consumed\n        carrots_left = remaining - carrots_consumed\n    else:\n        carrots_consumed = remaining\n        total_eaten_carrots = number + carrots_consumed\n        carrots_left = 0\n            \n    return [total_eaten_carrots, carrots_left]"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \"\"\"\n    total_eaten_carrots = 0\n    carrots_left_after_meals = 0\n\n    if need <= remaining:\n        total_eaten_carrots = number + need\n        carrots_left_after_meals = remaining - need\n    else:\n        # Not enough remaining carrots, eat all available\n        total_eaten_carrots = number + remaining\n        carrots_left_after_meals = 0\n\n    return [total_eaten_carrots, carrots_left_after_meals]"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand, builds and evaluates an algebraic expression.\n    \"\"\"\n    \n    def _build_expression_string(operator_list, operand_list):\n        \"\"\"Constructs the algebraic expression as a string by interleaving operands and operators.\"\"\"\n        expression_parts = []\n        expression_parts.append(str(operand_list[0]))\n        for i in range(len(operator_list)):\n            expression_parts.append(operator_list[i])\n            expression_parts.append(str(operand_list[i+1]))\n        return \" \".join(expression_parts)\n\n    def _evaluate_expression_string(expression_str):\n        \"\"\"Safely evaluates the constructed algebraic expression string respecting standard mathematical operator precedence.\"\"\"\n        return int(eval(expression_str))\n\n    expression_str = _build_expression_string(operator, operand)\n    result = _evaluate_expression_string(expression_str)\n    return result"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    def _contains_alphabetic_characters(s: str) -> bool:\n        \"\"\"Checks if the string s contains any alphabetic characters (a-z, A-Z).\"\"\"\n        return any(char.isalpha() for char in s)\n\n    def _reverse_string(s: str) -> str:\n        \"\"\"Reverses the entire input string s.\"\"\"\n        return s[::-1]\n\n    def _transform_case_character(char: str) -> str:\n        \"\"\"Transforms the case of a single character if it's alphabetic, otherwise retains it.\"\"\"\n        if char.islower():\n            return char.upper()\n        elif char.isupper():\n            return char.lower()\n        else:\n            return char\n\n    def _transform_case_string(s: str) -> str:\n        \"\"\"Applies case transformation to alphabetic characters in the string, retaining others.\"\"\"\n        transformed_chars = [_transform_case_character(char) for char in s]\n        return \"\".join(transformed_chars)\n\n    if not _contains_alphabetic_characters(s):\n        return _reverse_string(s)\n    else:\n        return _transform_case_string(s)"}
{"task_id": "HumanEval/160", "solution": "class Operand:\n    \"\"\"Represents a single non-negative integer value in an expression.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def __str__(self) -> str:\n        return str(self.value)\nclass Operator:\n    \"\"\"Represents a single algebraic operation symbol.\"\"\"\n    def __init__(self, symbol: str):\n        self.symbol = symbol\n\n    def __str__(self) -> str:\n        return self.symbol\nclass Expression:\n    \"\"\"Constructs and evaluates an algebraic expression string.\"\"\"\n    def __init__(self, operators: list[Operator], operands: list[Operand]):\n        self._expression_string = \"\"\n        num_operators = len(operators)\n        for i in range(num_operators):\n            self._expression_string += str(operands[i])\n            self._expression_string += \" \" + str(operators[i]) + \" \"\n        self._expression_string += str(operands[num_operators])\n\n    def evaluate(self) -> int:\n        \"\"\"Evaluates the constructed expression string using Python's eval().\"\"\"\n        return int(eval(self._expression_string))\ndef do_algebra(operator: list[str], operand: list[int]) -> int:\n    \"\"\"\n    Builds and evaluates an algebraic expression from given lists of operators and operands.\n    Leverages domain classes to structure the expression and Python's eval() for precedence.\n    \"\"\"\n    operand_objects = [Operand(val) for val in operand]\n    operator_objects = [Operator(sym) for sym in operator]\n\n    expression_obj = Expression(operator_objects, operand_objects)\n    return expression_obj.evaluate()"}
{"task_id": "HumanEval/162", "solution": "def string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    import hashlib\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Reverses the case of letters in a string or reverses the entire string if no letters are present.\"\"\"\n    \n    contains_letters = False\n    for char in s:\n        if char.isalpha():\n            contains_letters = True\n            break\n\n    if contains_letters:\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                if char.islower():\n                    result_chars.append(char.upper())\n                else:  # char is uppercase\n                    result_chars.append(char.lower())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n    else:\n        return s[::-1]"}
{"task_id": "HumanEval/162", "solution": "def string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    \n    import hashlib\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n    \n    even_digits_in_range = []\n    # Iterate through potential even digits (0 is excluded as a and b are positive, so min_val >= 1)\n    for digit in [2, 4, 6, 8]:\n        if min_val <= digit <= max_val:\n            even_digits_in_range.append(digit)\n            \n    return even_digits_in_range"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    even_numbers = []\n    for num in range(min_val, max_val + 1):\n        if num % 2 == 0:\n            even_numbers.append(num)\n\n    return even_numbers"}
