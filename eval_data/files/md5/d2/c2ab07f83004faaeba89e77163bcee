{"task_id": "HumanEval/65", "solution": "class InputInteger:\n    \"\"\"Encapsulates the input integer and provides digit-related properties.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n        self._digits_str = str(abs(value)) # Handle negative numbers by converting to positive string representation\n\n    def get_digits(self) -> str:\n        \"\"\"Returns the string representation of the digits.\"\"\"\n        return self._digits_str\n\n    def get_number_of_digits(self) -> int:\n        \"\"\"Returns the count of digits.\"\"\"\n        return len(self._digits_str)\nclass ShiftOperation:\n    \"\"\"Performs the core digit manipulation logic (circular shift or reversal).\"\"\"\n    def apply_shift(self, number_str: str, shift_amount: int) -> str:\n        \"\"\"Performs a circular right shift on number_str by shift_amount positions.\"\"\"\n        length = len(number_str)\n        if length == 0:\n            return \"\"\n        # The effective shift is shift_amount modulo the number of digits.\n        # A right shift means the last `effective_shift` digits move to the front.\n        effective_shift = shift_amount % length\n        return number_str[-effective_shift:] + number_str[:-effective_shift]\n\n    def reverse_digits(self, number_str: str) -> str:\n        \"\"\"Reverses the digits of number_str.\"\"\"\n        return number_str[::-1]\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    input_int = InputInteger(x)\n    digits_str = input_int.get_digits()\n    num_digits = input_int.get_number_of_digits()\n    \n    shift_op = ShiftOperation()\n\n    if shift > num_digits:\n        return shift_op.reverse_digits(digits_str)\n    else:\n        return shift_op.apply_shift(digits_str, shift)"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n\n    class IntegerInput:\n        \"\"\"Encapsulates an integer input and provides methods to access its string representation and digit count.\"\"\"\n        def __init__(self, value: int):\n            self._value = value\n\n        def get_digits(self) -> str:\n            \"\"\"Returns the string representation of the integer's digits.\"\"\"\n            return str(abs(self._value))\n\n        def get_number_of_digits(self) -> int:\n            \"\"\"Returns the count of digits in the integer.\"\"\"\n            return len(str(abs(self._value)))\n\n    class DigitSequence:\n        \"\"\"Manages a sequence of digits, providing operations for circular right shifting and reversal.\"\"\"\n        def __init__(self, digits: str):\n            self._digits = digits\n            self._length = len(digits)\n\n        def shift_right(self, shift_amount: int) -> str:\n            \"\"\"Performs a circular right shift on the digits and returns the new digit string.\"\"\"\n            if self._length == 0:\n                return \"\"\n            actual_shift = shift_amount % self._length\n            if actual_shift == 0:\n                return self._digits\n            return self._digits[-actual_shift:] + self._digits[:-actual_shift]\n\n        def reverse(self) -> str:\n            \"\"\"Reverses the digit sequence and returns the reversed digit string.\"\"\"\n            return self._digits[::-1]\n\n    integer_input_obj = IntegerInput(x)\n    num_digits = integer_input_obj.get_number_of_digits()\n    digits_str = integer_input_obj.get_digits()\n\n    digit_sequence_obj = DigitSequence(digits_str)\n\n    if shift > num_digits:\n        return digit_sequence_obj.reverse()\n    else:\n        return digit_sequence_obj.shift_right(shift)"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given total fruits and counts of apples and oranges.\n    \"\"\"\n    def _extract_fruit_count(text: str, fruit_name: str) -> int:\n        \"\"\"Extracts the numerical count of a specific fruit from a text string using regex.\"\"\"\n        pattern = r\"(\\d+)\\s+\" + re.escape(fruit_name)\n        match = re.search(pattern, text)\n        if match:\n            return int(match.group(1))\n        return 0\n\n    apple_count = _extract_fruit_count(s, \"apples\")\n    orange_count = _extract_fruit_count(s, \"oranges\")\n\n    total_apples_oranges = apple_count + orange_count\n    mango_count = n - total_apples_oranges\n\n    return mango_count"}
{"task_id": "HumanEval/68", "solution": "import math\ndef pluck(arr):\n    \"\"\"\n    Given an array of non-negative integers, find the smallest even value and its index.\n    If multiple nodes have the same smallest even value, return the one with the smallest index.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = math.inf\n    smallest_even_index = -1\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            # If value == smallest_even_value, the current smallest_even_index is already for the smallest index (first occurrence).\n            # No action needed as we prioritize the smallest index for ties.\n\n    if smallest_even_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/68", "solution": "class Node:\n    \"\"\"\n    Represents a single element from the input array with its value and original index.\n    \"\"\"\n    def __init__(self, value: int, index: int):\n        self.value = value\n        self.index = index\n\n    def is_even(self) -> bool:\n        \"\"\"Checks if the node's value is even.\"\"\"\n        return self.value % 2 == 0\ndef pluck(arr):\n    \"\"\"\n    Given an array representing a branch of a tree that has non-negative integer nodes,\n    your task is to pluck one of the nodes and return it.\n    The plucked node should be the node with the smallest even value.\n    If multiple nodes with the same smallest even value are found return the node that has smallest index.\n\n    The plucked node should be returned in a list, [ smalest_value, its index ],\n    If there are no even values or the given array is empty, return [].\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    if not arr:\n        return []\n\n    for index, value in enumerate(arr):\n        current_node = Node(value, index)\n\n        if current_node.is_even():\n            if current_node.value < smallest_even_value:\n                smallest_even_value = current_node.value\n                smallest_even_index = current_node.index\n            elif current_node.value == smallest_even_value:\n                # Tie-breaking: if values are equal, choose the one with the smaller index\n                if current_node.index < smallest_even_index:\n                    smallest_even_index = current_node.index\n\n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    frequency_map = {}\n    for x in lst:\n        frequency_map[x] = frequency_map.get(x, 0) + 1\n\n    qualifying_integers = []\n    for number, freq in frequency_map.items():\n        if freq >= number:\n            qualifying_integers.append(number)\n    \n    if qualifying_integers:\n        return max(qualifying_integers)\n    else:\n        return -1"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    mutable_list = list(lst)\n    result_list = []\n\n    while mutable_list:\n        # Select the minimum value\n        min_val = min(mutable_list)\n        result_list.append(min_val)\n        mutable_list.remove(min_val)\n\n        # If there are still elements, select the maximum value\n        if mutable_list:\n            max_val = max(mutable_list)\n            result_list.append(max_val)\n            mutable_list.remove(max_val)\n\n    return result_list"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n\n    class _FrequencyMap:\n        def __init__(self, frequencies: dict[int, int]):\n            self.frequencies = frequencies\n\n        def get_qualifying_integers(self) -> list[int]:\n            # Returns a list of integers where frequency >= value.\n            qualifying = []\n            for val, freq in self.frequencies.items():\n                if freq >= val:\n                    qualifying.append(val)\n            return qualifying\n\n    class _IntegerList:\n        def __init__(self, elements: list[int]):\n            self.elements = elements\n\n        def get_frequencies(self) -> dict[int, int]:\n            # Calculates and returns a dictionary mapping each integer to its frequency.\n            frequencies = {}\n            for x in self.elements:\n                frequencies[x] = frequencies.get(x, 0) + 1\n            return frequencies\n\n        def find_greatest_qualifying_integer(self) -> int:\n            frequencies_dict = self.get_frequencies()\n            freq_map = _FrequencyMap(frequencies_dict)\n            qualifying_list = freq_map.get_qualifying_integers()\n\n            if not qualifying_list:\n                return -1\n            return max(qualifying_list)\n\n    integer_list_obj = _IntegerList(lst)\n    return integer_list_obj.find_greatest_qualifying_integer()"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    # Check if sides are positive and satisfy the triangle inequality.\n    if not (a > 0 and b > 0 and c > 0 and \\\n            a + b > c and a + c > b and b + c > a):\n        return -1\n    \n    # Calculate the semi-perimeter.\n    s = (a + b + c) / 2\n    \n    # Calculate the area using Heron's formula.\n    area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n    \n    # Round the area to 2 decimal points.\n    return round(area, 2)"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    # Create a sorted mutable copy of the input list.\n    working_list = sorted(lst)\n    result_list = []\n    is_min_turn = True\n\n    while working_list:\n        if is_min_turn:\n            # Select the minimum value from the remaining integers.\n            result_list.append(working_list.pop(0))\n        else:\n            # Select the maximum value from the remaining integers.\n            result_list.append(working_list.pop())\n        is_min_turn = not is_min_turn\n        \n    return result_list"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    # Check if all sides are positive and satisfy the triangle inequality theorem.\n    if not (a > 0 and b > 0 and c > 0 and\n            a + b > c and a + c > b and b + c > a):\n        return -1\n    \n    # Calculate the semi-perimeter.\n    s = (a + b + c) / 2\n    \n    # Calculate the area using Heron's formula.\n    # The term under the square root will always be non-negative if the triangle is valid.\n    area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n    \n    # Round the calculated area to two decimal places.\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n\n    Example:\n    will_it_fly([1, 2], 5) \u279e False \n    # 1+2 is less than the maximum possible weight, but it's unbalanced.\n\n    will_it_fly([3, 2, 3], 1) \u279e False\n    # it's balanced, but 3+2+3 is more than the maximum possible weight.\n\n    will_it_fly([3, 2, 3], 9) \u279e True\n    # 3+2+3 is less than the maximum possible weight, and it's balanced.\n\n    will_it_fly([3], 5) \u279e True\n    # 3 is less than the maximum possible weight, and it's balanced.\n    '''\n    \n    # Checks if a list is a palindrome.\n    def _is_palindrome(lst):\n        return lst == lst[::-1]\n\n    # Calculates the sum of elements in a list.\n    def _calculate_sum(lst):\n        return sum(lst)\n\n    # First, check if the object is balanced (palindromic).\n    if not _is_palindrome(q):\n        return False\n    \n    # If balanced, calculate its total weight.\n    total_weight = _calculate_sum(q)\n\n    # Return True if total weight is within the limit, False otherwise.\n    return total_weight <= w"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum number of elements that need to be changed to make the array palindromic.\n    It compares elements from both ends of the array and increments a counter for mismatches.\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n\n    Example:\n    will_it_fly([1, 2], 5) \u279e False \n    # 1+2 is less than the maximum possible weight, but it's unbalanced.\n\n    will_it_fly([3, 2, 3], 1) \u279e False\n    # it's balanced, but 3+2+3 is more than the maximum possible weight.\n\n    will_it_fly([3, 2, 3], 9) \u279e True\n    # 3+2+3 is less than the maximum possible weight, and it's balanced.\n\n    will_it_fly([3], 5) \u279e True\n    # 3 is less than the maximum possible weight, and it's balanced.\n    '''\n    def _is_palindrome(q: list) -> bool:\n        \"\"\"Checks if a list is a palindrome.\"\"\"\n        return q == q[::-1]\n\n    def _calculate_sum(q: list) -> int:\n        \"\"\"Calculates the sum of elements in a list.\"\"\"\n        return sum(q)\n\n    if not _is_palindrome(q):\n        return False\n\n    total_weight = _calculate_sum(q)\n\n    if total_weight > w:\n        return False\n\n    return True"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum number of elements that need to be changed to make the array palindromic.\n    It iterates from both ends towards the center, counting mismatches.\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    \"\"\"\n    Compares two lists of strings based on their total character lengths.\n    Returns the list with fewer total characters, or lst1 if lengths are equal.\n    \"\"\"\n\n    def _calculate_total_length(string_list):\n        \"\"\"Calculates the sum of lengths of all strings in a given list.\"\"\"\n        total_length = 0\n        for s in string_list:\n            total_length += len(s)\n        return total_length\n\n    total_length_1 = _calculate_total_length(lst1)\n    total_length_2 = _calculate_total_length(lst2)\n\n    if total_length_1 < total_length_2:\n        return lst1\n    elif total_length_2 < total_length_1:\n        return lst2\n    else:  # total_length_1 == total_length_2\n        return lst1"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    '''\n    Compares two lists of strings by their total character count and returns the list with fewer characters, or the first list on a tie.\n    '''\n    def _calculate_total_length(lst):\n        '''\n        Calculates the sum of lengths of all strings in the given list.\n        '''\n        total_len = 0\n        for s in lst:\n            total_len += len(s)\n        return total_len\n\n    len1 = _calculate_total_length(lst1)\n    len2 = _calculate_total_length(lst2)\n\n    if len1 < len2:\n        return lst1\n    elif len2 < len1:\n        return lst2\n    else:  # len1 == len2\n        return lst1"}
{"task_id": "HumanEval/75", "solution": "def _get_prime_factors(n: int) -> list[int]:\n    \"\"\"Finds all prime factors of a number, including multiplicity.\"\"\"\n    factors = []\n    # Handle factor 2\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n    # Handle odd factors\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            factors.append(i)\n            n //= i\n        i += 2\n    # If n is still greater than 1, it must be a prime factor itself\n    if n > 1:\n        factors.append(n)\n    return factors\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"Returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise. Knowing that (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    if a < 1 or a >= 100:\n        return False\n    \n    factors = _get_prime_factors(a)\n    \n    return len(factors) == 3"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n\n    def _is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    def _get_prime_factors(n):\n        \"\"\"Finds all prime factors of a number, including repetitions.\"\"\"\n        factors = []\n        d = 2\n        temp_n = n\n        # Iterate through potential divisors, checking their primality.\n        while d * d <= temp_n:\n            if _is_prime(d):\n                while temp_n % d == 0:\n                    factors.append(d)\n                    temp_n //= d\n            d += 1\n        # If temp_n is still greater than 1, it must be the last prime factor.\n        if temp_n > 1:\n            factors.append(temp_n)\n        return factors\n\n    factors = _get_prime_factors(a)\n    return len(factors) == 3"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Checks if an integer is a perfect cube.\n    Calculates the integer cube root and verifies by cubing it.\n    '''\n    if a == 0:\n        return True\n    \n    # Calculate the integer cube root of the absolute value.\n    # Using round() helps mitigate floating-point inaccuracies.\n    abs_cbrt = round(abs(a)**(1/3))\n    \n    # Determine the sign of the cube root.\n    # If a is negative, its cube root must also be negative.\n    if a < 0:\n        cbrt = -abs_cbrt\n    else:\n        cbrt = abs_cbrt\n        \n    # Check if the cubed integer root equals the original number.\n    return cbrt * cbrt * cbrt == a"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Your task is to write a function that returns true if a number x is a simple\n    power of n and false in other cases.\n    x is a simple power of n if n**int=x\n    For example:\n    is_simple_power(1, 4) => true\n    is_simple_power(2, 2) => true\n    is_simple_power(8, 2) => true\n    is_simple_power(3, 2) => false\n    is_simple_power(3, 1) => false\n    is_simple_power(5, 3) => false\n    \"\"\"\n    import math\n\n    # Handle special cases for the base n.\n    if n == 1:\n        return x == 1\n    if n == 0:\n        return x == 0 or x == 1\n    if n == -1:\n        return x == 1 or x == -1\n\n    # Handle special cases for the number x.\n    if x == 1:\n        # Any non-zero base to the power of 0 is 1.\n        return True\n    if x == 0:\n        # A non-zero base to any integer power is never 0.\n        return False\n\n    # If x is negative and n is positive (and not 0 or 1), it's impossible.\n    if x < 0 and n > 0:\n        return False\n\n    # Case: n is positive (n > 1) and x is positive (x > 0).\n    if n > 0:\n        try:\n            # Calculate the potential exponent k using logarithms.\n            log_val = math.log(x) / math.log(n)\n        except ValueError:\n            # This should ideally not occur with x > 0 and n > 0.\n            return False\n\n        # Round to the nearest integer, as the exponent must be an integer.\n        k_candidate = round(log_val)\n\n        # Check if the calculated log_val is very close to an integer.\n        if not math.isclose(log_val, k_candidate):\n            return False\n\n        # Verify n raised to this integer power is approximately x.\n        return math.isclose(n**k_candidate, x)\n\n    # Case: n is negative (n < -1) and x can be positive or negative.\n    if n < -1:\n        try:\n            # Use absolute values for logarithm calculation.\n            log_abs_val = math.log(abs(x)) / math.log(abs(n))\n        except ValueError:\n            return False\n\n        k_candidate = round(log_abs_val)\n\n        # Check if log_abs_val is very close to an integer.\n        if not math.isclose(log_abs_val, k_candidate):\n            return False\n\n        # Verify n**k_candidate == x with tolerance and check exponent parity.\n        if math.isclose(n**k_candidate, x):\n            if x > 0:\n                # If x is positive, k_candidate must be even.\n                return k_candidate % 2 == 0\n            else:\n                # If x is negative, k_candidate must be odd.\n                return k_candidate % 2 != 0\n        return False\n\n    # This line should be unreachable if all cases are covered.\n    return False"}
