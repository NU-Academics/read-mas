{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts the number of \"boredoms\" in a string. A boredom is a sentence\n    that starts with the case-sensitive word \"I\".\n    \"\"\"\n    def _split_into_sentences(text: str, delimiters: tuple = ('.', '?', '!')) -> list[str]:\n        \"\"\"Splits text into sentences using specified delimiters, removing the delimiters.\"\"\"\n        sentences = []\n        current_sentence_start_index = 0\n        for i in range(len(text)):\n            if text[i] in delimiters:\n                sentence_content = text[current_sentence_start_index:i].strip()\n                if sentence_content:\n                    sentences.append(sentence_content)\n                current_sentence_start_index = i + 1\n        \n        # Add any remaining text as a sentence if it doesn't end with a delimiter\n        remaining_content = text[current_sentence_start_index:].strip()\n        if remaining_content:\n            sentences.append(remaining_content)\n            \n        return sentences\n\n    def _starts_with_i(sentence_content: str) -> bool:\n        \"\"\"Checks if a sentence starts with the standalone, case-sensitive word 'I'.\"\"\"\n        cleaned_sentence = sentence_content.strip()\n        words = cleaned_sentence.split(maxsplit=1)\n        return len(words) > 0 and words[0] == \"I\"\n\n    boredom_count = 0\n    sentences = _split_into_sentences(S)\n\n    for sentence in sentences:\n        if _starts_with_i(sentence):\n            boredom_count += 1\n            \n    return boredom_count"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    '''\n    # First, check if all three inputs are integers (including float-represented integers like 5.0).\n    is_x_int = isinstance(x, int) or (isinstance(x, float) and x.is_integer())\n    is_y_int = isinstance(y, int) or (isinstance(y, float) and y.is_integer())\n    is_z_int = isinstance(z, int) or (isinstance(z, float) and z.is_integer())\n\n    if not (is_x_int and is_y_int and is_z_int):\n        return False # If any number is not an integer, return False immediately.\n\n    # If all are integers, check if one equals the sum of the other two.\n    return (x == y + z) or (y == x + z) or (z == x + y)"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    '''\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False\n    \n    return (x == y + z) or (y == x + z) or (z == x + y)"}
{"task_id": "HumanEval/93", "solution": "class Character:\n    \"\"\"Encapsulates a single character and provides methods for its properties and transformations.\"\"\"\n    _VOWELS = \"aeiouAEIOU\"\n\n    def __init__(self, value: str):\n        self._value = value\n\n    def is_vowel(self) -> bool:\n        \"\"\"Determines if the character is an English vowel.\"\"\"\n        return self._value in Character._VOWELS\n\n    def is_alphabetic(self) -> bool:\n        \"\"\"Determines if the character is an English alphabetic letter.\"\"\"\n        return self._value.isalpha()\n\n    def swap_case(self) -> 'Character':\n        \"\"\"Returns a new Character instance with the case of the current character swapped.\"\"\"\n        return Character(self._value.swapcase())\n\n    def shift_two_places(self) -> 'Character':\n        \"\"\"Returns a new Character instance with the character shifted two positions forward in the English alphabet, preserving its case.\"\"\"\n        if not self.is_alphabetic():\n            return Character(self._value)\n\n        current_char_code = ord(self._value)\n        if 'a' <= self._value <= 'z':\n            shifted_char_code = ((current_char_code - ord('a') + 2) % 26) + ord('a')\n        elif 'A' <= self._value <= 'Z':\n            shifted_char_code = ((current_char_code - ord('A') + 2) % 26) + ord('A')\n        else:\n            return Character(self._value) # Should not happen due to is_alphabetic check\n\n        return Character(chr(shifted_char_code))\n\n    def get_value(self) -> str:\n        \"\"\"Returns the string representation of the character.\"\"\"\n        return self._value\nclass Message:\n    \"\"\"Manages the overall encoding process for a given message string.\"\"\"\n    def __init__(self, content: str):\n        self._content = content\n\n    def encode(self) -> str:\n        \"\"\"Processes the message character by character, applying encoding rules.\"\"\"\n        encoded_chars = []\n        for char_str in self._content:\n            char_obj = Character(char_str)\n            \n            final_char_obj = char_obj\n            if char_obj.is_alphabetic():\n                processed_char_obj = char_obj.swap_case()\n                if processed_char_obj.is_vowel():\n                    final_char_obj = processed_char_obj.shift_two_places()\n                else:\n                    final_char_obj = processed_char_obj\n            \n            encoded_chars.append(final_char_obj.get_value())\n        return \"\".join(encoded_chars)\ndef encode(message):\n    \"\"\"\n    Encodes a message by swapping case of letters and replacing vowels with a letter 2 places ahead.\n    Assumes only letters.\n    \"\"\"\n    msg_obj = Message(message)\n    return msg_obj.encode()"}
{"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S):\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n   \n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n\n    def _split_into_sentences(text: str, delimiters: tuple = ('.', '?', '!')) -> list[str]:\n        # Splits the input text into sentences based on the provided delimiters.\n        # Each sentence is cleaned of leading/trailing whitespace and filtered.\n        if not text:\n            return []\n        pattern = '|'.join(re.escape(d) for d in delimiters)\n        sentences = re.split(f'[{pattern}]', text)\n        cleaned_sentences = [s.strip() for s in sentences if s.strip()]\n        return cleaned_sentences\n\n    def _is_bored_sentence(sentence: str) -> bool:\n        # Checks if a sentence starts with the word 'I' (case-insensitive).\n        # Handles leading/trailing spaces and splits the sentence into words.\n        words = sentence.strip().split()\n        return len(words) > 0 and words[0].lower() == 'i'\n\n    boredom_count = 0\n    sentences = _split_into_sentences(S)\n    for sentence in sentences:\n        if _is_bored_sentence(sentence):\n            boredom_count += 1\n    return boredom_count"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Finds the largest prime number in the list and returns the sum of its digits.\n    Returns 0 if no prime numbers are found or the list is empty.\"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def sum_digits(n):\n        \"\"\"Calculates the sum of the digits of a number.\"\"\"\n        total_sum = 0\n        n = abs(n)\n        while n > 0:\n            total_sum += n % 10\n            n //= 10\n        return total_sum\n\n    largest_prime_val = -1\n    largest_prime_found = False\n\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime_val:\n                largest_prime_val = num\n                largest_prime_found = True\n\n    if largest_prime_found:\n        return sum_digits(largest_prime_val)\n    else:\n        return 0"}
{"task_id": "HumanEval/93", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u'}\nALPHABET_LOWER = 'abcdefghijklmnopqrstuvwxyz'\nALPHABET_UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'\ndef _is_letter(char):\n    \"\"\"Checks if the character is an English alphabet letter.\"\"\"\n    return 'a' <= char.lower() <= 'z'\ndef _is_vowel(char):\n    \"\"\"Checks if the original character is an English alphabet vowel (case-insensitive).\"\"\"\n    return char.lower() in VOWELS\ndef _swap_case(char):\n    \"\"\"Swaps the case of an English alphabet letter.\"\"\"\n    if 'a' <= char <= 'z':\n        return char.upper()\n    elif 'A' <= char <= 'Z':\n        return char.lower()\n    return char\ndef _get_two_places_ahead(vowel_char):\n    \"\"\"Gets the letter two places ahead of the given vowel, preserving its case.\"\"\"\n    if 'a' <= vowel_char <= 'z':\n        idx = ALPHABET_LOWER.find(vowel_char)\n        if idx != -1:\n            return ALPHABET_LOWER[(idx + 2) % len(ALPHABET_LOWER)]\n    elif 'A' <= vowel_char <= 'Z':\n        idx = ALPHABET_UPPER.find(vowel_char)\n        if idx != -1:\n            return ALPHABET_UPPER[(idx + 2) % len(ALPHABET_UPPER)]\n    return vowel_char\ndef encode(message):\n    \"\"\"\n    Write a function that takes a message, and encodes in such a \n    way that it swaps case of all letters, replaces all vowels in \n    the message with the letter that appears 2 places ahead of that \n    vowel in the english alphabet. \n    Assume only letters. \n    \n    Examples:\n    >>> encode('test')\n    'TGST'\n    >>> encode('This is a message')\n    'tHKS KS C MGSSCGG'\n    \"\"\"\n    encoded_chars = []\n    for original_char in message:\n        if _is_letter(original_char):\n            case_swapped_char = _swap_case(original_char)\n\n            if _is_vowel(original_char):\n                final_char = _get_two_places_ahead(case_swapped_char)\n            else:\n                final_char = case_swapped_char\n        else:\n            final_char = original_char\n        encoded_chars.append(final_char)\n\n    return ''.join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def _find_primes(numbers: list[int]) -> list[int]:\n        \"\"\"Identifies all prime numbers in a list.\"\"\"\n        return [n for n in numbers if _is_prime(n)]\n\n    def _find_largest_prime(primes: list[int]) -> int | None:\n        \"\"\"Finds the largest prime number from a list of primes.\"\"\"\n        if not primes:\n            return None\n        return max(primes)\n\n    def _sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the digits of a number.\"\"\"\n        s = 0\n        while n > 0:\n            s += n % 10\n            n //= 10\n        return s\n\n    identified_primes = _find_primes(lst)\n\n    if not identified_primes:\n        return 0\n\n    largest_prime = _find_largest_prime(identified_primes)\n    \n    return _sum_digits(largest_prime)"}
