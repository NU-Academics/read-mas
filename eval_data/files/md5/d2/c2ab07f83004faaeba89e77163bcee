{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n\n    def _is_eligible(x: int) -> bool:\n        \"\"\"Determines if an integer x is divisible by 11 or 13.\"\"\"\n        return (x % 11 == 0) or (x % 13 == 0)\n\n    def _count_digit_7(num: int) -> int:\n        \"\"\"Counts the occurrences of the digit '7' within a given integer.\n        Handles both positive and negative numbers by converting to absolute string.\n        \"\"\"\n        count = 0\n        num_str = str(abs(num))\n        for digit_char in num_str:\n            if digit_char == '7':\n                count += 1\n        return count\n\n    total_count_of_7 = 0\n    for x in range(1, n):\n        if _is_eligible(x):\n            digit_7_count = _count_digit_7(x)\n            total_count_of_7 += digit_7_count\n\n    return total_count_of_7"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n\n    def _is_divisible_by_11_or_13(x: int) -> bool:\n        \"\"\"Checks if x is perfectly divisible by 11 OR by 13.\"\"\"\n        return x % 11 == 0 or x % 13 == 0\n\n    def _count_digit(number: int, digit: int) -> int:\n        \"\"\"Counts how many times 'digit' appears in 'number'.\"\"\"\n        return str(number).count(str(digit))\n\n    total_count = 0\n    for x in range(1, n):\n        if _is_divisible_by_11_or_13(x):\n            total_count += _count_digit(x, 7)\n    return total_count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    result_list = list(l)\n    even_indexed_elements = [l[i] for i in range(0, len(l), 2)]\n    even_indexed_elements.sort()\n\n    sorted_idx = 0\n    for i in range(0, len(l), 2):\n        result_list[i] = even_indexed_elements[sorted_idx]\n        sorted_idx += 1\n\n    return result_list"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    n = len(l)\n    l_prime = [None] * n\n    even_elements = []\n\n    for i in range(n):\n        if i % 2 == 0:  # Even index\n            even_elements.append(l[i])\n        else:  # Odd index\n            l_prime[i] = l[i]\n\n    even_elements.sort()\n\n    even_idx_ptr = 0\n    for i in range(n):\n        if i % 2 == 0:  # Even index\n            l_prime[i] = even_elements[even_idx_ptr]\n            even_idx_ptr += 1\n            \n    return l_prime"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[2] + group[0] + group[1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # Split the encoded string into groups of 3 characters, similar to how it was encoded.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # Reverse cycle elements in each group. Only groups of 3 characters were shifted.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    def is_prime(num: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    from typing import Iterator\n\n    def generate_fibonacci_numbers() -> Iterator[int]:\n        \"\"\"Generates an infinite sequence of Fibonacci numbers starting from 2.\"\"\"\n        a, b = 0, 1\n        while True:\n            if a > 1: # Yield Fibonacci numbers starting from 2 (F_3)\n                yield a\n            a, b = b, a + b\n\n    count = 0\n    for fib_num in generate_fibonacci_numbers():\n        if is_prime(fib_num):\n            count += 1\n            if count == n:\n                return fib_num"}
