{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    for i in range(len(string)):\n        if is_palindrome(string[i:]):\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n\n    class InvalidBinaryStringError(Exception):\n        \"\"\"Custom exception for invalid binary string content.\"\"\"\n        pass\n\n    class MismatchedLengthError(Exception):\n        \"\"\"Custom exception for binary strings of different lengths.\"\"\"\n        pass\n\n    class BinaryString:\n        \"\"\"Encapsulates a binary string, ensuring its validity.\"\"\"\n        def __init__(self, value: str):\n            self._value = value\n            self.validate_content()\n\n        def validate_content(self) -> None:\n            \"\"\"Checks if _value consists only of '0's and '1's.\"\"\"\n            if not all(char in ('0', '1') for char in self._value):\n                raise InvalidBinaryStringError(\"Binary string must contain only '0's and '1's.\")\n\n        def get_value(self) -> str:\n            \"\"\"Returns the string value.\"\"\"\n            return self._value\n\n        def get_length(self) -> int:\n            \"\"\"Returns the length of the string.\"\"\"\n            return len(self._value)\n\n    class XORProcessor:\n        \"\"\"Coordinates the XOR operation on BinaryString objects.\"\"\"\n        def execute_xor(self, a_bs: BinaryString, b_bs: BinaryString) -> BinaryString:\n            \"\"\"Performs binary XOR on two BinaryString objects.\"\"\"\n            if a_bs.get_length() != b_bs.get_length():\n                raise MismatchedLengthError(\"Binary strings must have the same length for XOR operation.\")\n\n            result_chars = []\n            for i in range(a_bs.get_length()):\n                xor_result = str(int(a_bs.get_value()[i]) ^ int(b_bs.get_value()[i]))\n                result_chars.append(xor_result)\n\n            return BinaryString(\"\".join(result_chars))\n\n    # Application Layer logic\n    binary_a = BinaryString(a)\n    binary_b = BinaryString(b)\n\n    xor_processor = XORProcessor()\n    result_binary_string = xor_processor.execute_xor(binary_a, binary_b)\n\n    return result_binary_string.get_value()"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    \"\"\"\n    if not string or is_palindrome(string):\n        return string\n\n    # Iterate from the full string down to an empty string to find the longest palindromic postfix.\n    # 'i' represents the starting index of the postfix within the original string.\n    for i in range(len(string) + 1):\n        postfix = string[i:]\n        if is_palindrome(postfix):\n            # Once the longest palindromic postfix is found, the part of the string before it\n            # needs to be reversed and appended to make the full string a palindrome.\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]\n\n    # This line should theoretically not be reached if the input string is valid,\n    # as an empty string (string[len(string):]) is always a palindrome,\n    # ensuring a postfix is always found.\n    return string"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    def _validate_binary_string(s: str) -> None:\n        \"\"\"Ensures a string consists only of '0' and '1' characters.\"\"\"\n        for char in s:\n            if char not in ('0', '1'):\n                raise ValueError('Input string must contain only 0s and 1s')\n\n    def _perform_char_xor(char_a: str, char_b: str) -> str:\n        \"\"\"Performs binary XOR on two single binary characters.\"\"\"\n        return '1' if char_a != char_b else '0'\n\n    _validate_binary_string(a)\n    _validate_binary_string(b)\n\n    if len(a) != len(b):\n        raise ValueError('Input strings must be of equal length')\n\n    result_chars = []\n    for i in range(len(a)):\n        result_chars.append(_perform_char_xor(a[i], b[i]))\n\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    current_longest = strings[0]\n    for s in strings[1:]:\n        if len(s) > len(current_longest):\n            current_longest = s\n    return current_longest"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    # Implementation using Euclidean algorithm.\n    while b:\n        a, b = b, a % b\n    return abs(a)"}
