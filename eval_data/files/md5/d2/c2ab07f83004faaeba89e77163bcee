{"task_id": "HumanEval/2", "solution": "import math\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n\n    class FloatingPointNumber:\n        \"\"\"Encapsulates a floating point number and its decomposition into integer and decimal parts.\"\"\"\n        def __init__(self, value: float):\n            self._value = value\n            self._integer_part = 0.0\n            self._decimal_part = 0.0\n\n        def calculate_integer_part(self) -> None:\n            \"\"\"Calculates the largest integer smaller than or equal to the value using floor.\"\"\"\n            self._integer_part = math.floor(self._value)\n\n        def calculate_decimal_part(self) -> None:\n            \"\"\"Calculates the decimal part by subtracting the integer part from the original value.\"\"\"\n            self._decimal_part = self._value - self._integer_part\n\n        def get_decimal_part(self) -> float:\n            \"\"\"Returns the calculated decimal part.\"\"\"\n            return self._decimal_part\n\n    # Create an instance of FloatingPointNumber to manage the decomposition.\n    fp_num = FloatingPointNumber(number)\n    # Calculate the integer component of the number.\n    fp_num.calculate_integer_part()\n    # Determine the decimal part by subtracting the integer part from the original number.\n    fp_num.calculate_decimal_part()\n    # Return the final calculated decimal part.\n    return fp_num.get_decimal_part()"}
{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    import math\n\n    integer_part = math.floor(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    cleaned_string = paren_string.replace(\" \", \"\")\n    result = []\n    balance = 0\n    start_index = -1\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance += 1\n            if balance == 1:\n                start_index = i\n        elif char == ')':\n            balance -= 1\n            if balance == 0:\n                if start_index != -1:\n                    result.append(cleaned_string[start_index : i + 1])\n                    start_index = -1\n    return result"}
{"task_id": "HumanEval/3", "solution": "class Account:\n    \"\"\"Manages the account balance and checks if it falls below zero.\"\"\"\n    def __init__(self):\n        self._balance = 0\n\n    def process_operation(self, amount: int):\n        \"\"\"Updates the account balance by adding the given amount.\"\"\"\n        self._balance += amount\n\n    def is_below_zero(self) -> bool:\n        \"\"\"Returns True if the current balance is less than zero, False otherwise.\"\"\"\n        return self._balance < 0\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"Detects if an account balance ever falls below zero after a sequence of operations.\"\"\"\n    account = Account()\n    for op in operations:\n        account.process_operation(op)\n        if account.is_below_zero():\n            return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    cleaned_string = paren_string.replace(' ', '')\n    result = []\n    balance_counter = 0\n    start_index = 0\n\n    for i, char in enumerate(cleaned_string):\n        if balance_counter == 0 and char == '(':\n            start_index = i\n\n        if char == '(':\n            balance_counter += 1\n        elif char == ')':\n            balance_counter -= 1\n\n        if balance_counter == 0 and char == ')':\n            group = cleaned_string[start_index : i + 1]\n            result.append(group)\n    return result"}
{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n    for i in range(len(numbers)):\n        for j in range(i + 1, len(numbers)):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty for MAD calculation.\")\n    if len(numbers) == 1:\n        return 0.0\n\n    # Calculate the mean of the numbers\n    mean_value = sum(numbers) / len(numbers)\n\n    # Compute the absolute difference between each number and the calculated mean\n    absolute_diffs = [abs(number - mean_value) for number in numbers]\n\n    # Average these absolute differences to produce the MAD\n    return sum(absolute_diffs) / len(absolute_diffs)"}
{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    n = len(numbers)\n    if n == 0:\n        return []\n    if n == 1:\n        return numbers\n\n    result = []\n    for i in range(n - 1):\n        result.append(numbers[i])\n        result.append(delimeter)\n    result.append(numbers[n - 1]) # Append the last element\n\n    return result"}
{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n\n    def _calculate_deepest_nesting_for_group(group_string: str) -> int:\n        \"\"\"Calculates the deepest level of nesting for a single group of parentheses.\"\"\"\n        current_depth = 0\n        max_depth = 0\n        for char in group_string:\n            if char == '(':\n                current_depth += 1\n            elif char == ')':\n                current_depth -= 1\n            max_depth = max(max_depth, current_depth)\n        return max_depth\n\n    groups = paren_string.split(' ')\n    result_list = []\n    for group in groups:\n        if group: # Ensure not to process empty strings if multiple spaces exist\n            result_list.append(_calculate_deepest_nesting_for_group(group))\n    return result_list"}
{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    result_list = []\n    for s in strings:\n        if substring in s:\n            result_list.append(s)\n    return result_list"}
{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    def _calculate_deepest_nesting(group_string: str) -> int:\n        \"\"\"Calculates the deepest nesting level for a single parentheses group.\"\"\"\n        current_depth = 0\n        max_depth = 0\n        for char in group_string:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        return max_depth\n\n    groups = paren_string.split(' ')\n    results = []\n    for group_string in groups:\n        if group_string: # Handle potential empty strings from multiple spaces\n            results.append(_calculate_deepest_nesting(group_string))\n    return results"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    # Calculate the mean of the input numbers.\n    mean_value = sum(numbers) / len(numbers)\n\n    # Calculate absolute differences between each number and the mean.\n    absolute_differences = [abs(x - mean_value) for x in numbers]\n\n    # Calculate the average of these absolute differences.\n    mad_value = sum(absolute_differences) / len(absolute_differences)\n\n    return mad_value"}
{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    current_sum = 0\n    current_product = 1\n    for num in numbers:\n        current_sum += num\n        current_product *= num\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    if not numbers:\n        return (current_sum, current_product)\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result_list = []\n    current_max = float('-inf')\n\n    for number in numbers:\n        if number > current_max:\n            current_max = number\n        result_list.append(current_max)\n    return result_list"}
