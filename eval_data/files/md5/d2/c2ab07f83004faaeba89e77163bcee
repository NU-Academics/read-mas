{"task_id": "HumanEval/63", "solution": "_memo: dict[int, int] = {\n    0: 0,\n    1: 0,\n    2: 1\n}\ndef fibfib(n: int):\n    \"\"\"The FibFib number sequence is defined by base cases and a recurrence relation.\n    This function efficiently computes the n-th element using memoization.\"\"\"\n    if n in _memo:\n        return _memo[n]\n\n    result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n    _memo[n] = result\n    return result"}
{"task_id": "HumanEval/62", "solution": "from typing import List, Union\nNumber = Union[int, float]\nclass Polynomial:\n    \"\"\"Represents a polynomial and provides methods for mathematical operations like differentiation.\"\"\"\n\n    def __init__(self, coefficients: List[Number]):\n        \"\"\"Initializes a Polynomial instance with a list of coefficients.\"\"\"\n        self._coefficients = coefficients\n\n    def calculate_derivative(self) -> List[Number]:\n        \"\"\"Computes the derivative of the polynomial, returning its coefficients.\"\"\"\n        n = len(self._coefficients)\n        if n <= 1:\n            return []\n\n        derived_coefficients = []\n        for i in range(1, n):\n            derived_coefficients.append(self._coefficients[i] * i)\n\n        return derived_coefficients\ndef derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    polynomial_instance = Polynomial(xs)\n    return polynomial_instance.calculate_derivative()"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    \"\"\"\n    if not xs or len(xs) <= 1:\n        return []\n\n    derived_coefficients = []\n    for i in range(1, len(xs)):\n        derived_coefficients.append(xs[i] * i)\n    return derived_coefficients"}
{"task_id": "HumanEval/63", "solution": "_memo: dict[int, int] = {}\ndef fibfib(n: int):\n    \"\"\"Computes the n-th element of the fibfib number sequence using memoization.\"\"\"\n    if n in _memo:\n        return _memo[n]\n\n    if n == 0:\n        result = 0\n    elif n == 1:\n        result = 0\n    elif n == 2:\n        result = 1\n    else:\n        result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n\n    _memo[n] = result\n    return result"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    \"\"\"\n\n    def _is_standard_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a standard vowel (a, e, i, o, u), case-insensitive.\"\"\"\n        return char.lower() in {'a', 'e', 'i', 'o', 'u'}\n\n    def _is_conditional_y_vowel(char: str, is_last_char: bool) -> bool:\n        \"\"\"Checks if a character 'y' is a vowel, considering its position.\"\"\"\n        return char.lower() == 'y' and is_last_char\n\n    vowel_count = 0\n    n = len(s)\n\n    for i in range(n):\n        char = s[i]\n        is_last_char = (i == n - 1)\n\n        if _is_standard_vowel(char):\n            vowel_count += 1\n        elif _is_conditional_y_vowel(char, is_last_char):\n            vowel_count += 1\n\n    return vowel_count"}
{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits given a string describing apples and oranges\n    and the total number of fruits.\n    \"\"\"\n    def _parse_fruit_string(s: str) -> tuple[int, int]:\n        \"\"\"\n        Extracts apple and orange counts from the input string.\n        Assumes the string format is \"<number> apples and <number> oranges\".\n        \"\"\"\n        parts = s.split(\" \")\n        apple_count = int(parts[0])\n        orange_count = int(parts[3])\n        return apple_count, orange_count\n\n    apple_count, orange_count = _parse_fruit_string(s)\n    mango_count = n - (apple_count + orange_count)\n    return mango_count"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    \"\"\"\n    count = 0\n    lower_s = s.lower()\n    n = len(lower_s)\n    \n    for i in range(n):\n        char = lower_s[i]\n        if char in ('a', 'e', 'i', 'o', 'u'):\n            count += 1\n        elif char == 'y' and i == n - 1:\n            count += 1\n            \n    return count"}
