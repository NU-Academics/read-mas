{"task_id": "HumanEval/78", "solution": "PRIME_HEX_DECIMAL_VALUES = {2, 3, 5, 7, 11, 13}\ndef _hex_char_to_decimal(hex_char):\n    \"\"\"Converts a single hexadecimal character to its decimal integer equivalent.\"\"\"\n    return int(hex_char, 16)\ndef hex_key(num):\n    \"\"\"Counts the number of prime hexadecimal digits (2, 3, 5, 7, B, D) in the input string.\"\"\"\n    prime_count = 0\n    for char in num:\n        decimal_value = _hex_char_to_decimal(char)\n        if decimal_value in PRIME_HEX_DECIMAL_VALUES:\n            prime_count += 1\n    return prime_count"}
{"task_id": "HumanEval/76", "solution": "import math\ndef is_simple_power(x, n):\n    \"\"\"Returns true if a number x is a simple power of n, meaning n**k = x for some non-negative integer k.\n    This function handles floating point inputs and checks for non-negative integer exponents.\n    \"\"\"\n    # If n is negative, it cannot be a base for a \"simple power\" in this context\n    # as math.log requires n > 0.\n    if n < 0:\n        return False\n\n    # Case 1: x is 1\n    # 1 is n**0 for any non-negative n (Python handles 0**0 as 1, 1**0=1, any_other_positive_n**0=1).\n    if x == 1:\n        return True\n\n    # Case 2: n is 1 (and x is not 1, as handled above)\n    # If n is 1, then 1**k = 1 for any k. Since x != 1, it cannot be a power of 1.\n    if n == 1:\n        return False\n\n    # Case 3: n is 0 (and x is not 1)\n    # If n is 0, then 0**k = 0 for k > 0.\n    # We've already handled x=1 (0**0=1).\n    # So, if n=0 and x != 1, then x must be 0 for it to be a power.\n    if n == 0:\n        return x == 0\n\n    # Case 4: x is less than 1 (and x is not 0 or 1, and n > 1)\n    # We now have x > 0 and n > 1.\n    # If x is between 0 and 1, log_n(x) will be negative.\n    # For example, is_simple_power(0.5, 2) => k = -1. This is an integer but not non-negative.\n    # Therefore, if x < 1 (and x is not 0 or 1), it cannot be a simple power.\n    if x < 1:\n        return False\n\n    # General case: x > 1 and n > 1.\n    # In this region, k = log_n(x) will always be positive.\n    # We just need to check if k is an integer.\n    k = math.log(x, n)\n\n    # Use a small epsilon for floating point comparison to check if k is an integer.\n    # This accounts for potential floating point inaccuracies.\n    epsilon = 1e-9\n    return abs(k - round(k)) < epsilon"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"You are given a string s.\n    Your task is to check if the string is happy or not.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct\n    For example:\n    is_happy(a) => False\n    is_happy(aa) => False\n    is_happy(abcd) => True\n    is_happy(aabb) => False\n    is_happy(adb) => True\n    is_happy(xyy) => False\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        char1 = s[i]\n        char2 = s[i+1]\n        char3 = s[i+2]\n\n        # Check if all three characters are distinct\n        if char1 == char2 or char1 == char3 or char2 == char3:\n            return False\n\n    return True"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"Checks if the string s is happy.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct.\n    \"\"\"\n    def _are_three_chars_distinct(c1, c2, c3):\n        \"\"\"Checks if three characters are distinct.\"\"\"\n        return c1 != c2 and c1 != c3 and c2 != c3\n\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        if not _are_three_chars_distinct(s[i], s[i+1], s[i+2]):\n            return False\n            \n    return True"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    \"\"\"\n    def _is_prime(n):\n        \"\"\"Checks if a given integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPA values into a list of corresponding letter grades.\"\"\"\n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append('A+')\n        elif gpa > 3.7:\n            letter_grades.append('A')\n        elif gpa > 3.3:\n            letter_grades.append('A-')\n        elif gpa > 3.0:\n            letter_grades.append('B+')\n        elif gpa > 2.7:\n            letter_grades.append('B')\n        elif gpa > 2.3:\n            letter_grades.append('B-')\n        elif gpa > 2.0:\n            letter_grades.append('C+')\n        elif gpa > 1.7:\n            letter_grades.append('C')\n        elif gpa > 1.3:\n            letter_grades.append('C-')\n        elif gpa > 1.0:\n            letter_grades.append('D+')\n        elif gpa > 0.7:\n            letter_grades.append('D')\n        elif gpa > 0.0:\n            letter_grades.append('D-')\n        else: # gpa == 0.0\n            letter_grades.append('E')\n    return letter_grades"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    def _is_prime(n):\n        \"\"\"Helper function to check if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    else:\n        # Count of numbers starting with 1: 1 * 10^(n-1)\n        # Count of numbers ending with 1: 9 * 10^(n-2) * 1 (first digit 1-9, middle n-2 digits 0-9)\n        # Count of numbers starting AND ending with 1: 1 * 10^(n-2) * 1\n        # Using inclusion-exclusion: P(A or B) = P(A) + P(B) - P(A and B)\n        return (10**(n - 1)) + (9 * (10**(n - 2))) - (10**(n - 2))"}
{"task_id": "HumanEval/83", "solution": "def _count_starts_with_one(n):\n    \"\"\"Calculates the count of n-digit numbers that start with 1.\n    The first digit is fixed as 1, and the remaining n-1 digits can be any of 0-9.\"\"\"\n    return 10**(n - 1)\ndef _count_ends_with_one(n):\n    \"\"\"Calculates the count of n-digit numbers that end with 1.\n    Handles the special case for n=1, where only '1' qualifies.\"\"\"\n    if n == 1:\n        return 1\n    # For n > 1: The first digit has 9 choices (1-9), and n-2 middle digits have 10 choices each.\n    return 9 * (10**(n - 2))\ndef _count_starts_and_ends_with_one(n):\n    \"\"\"Calculates the count of n-digit numbers that start and end with 1.\n    Handles the special case for n=1, where only '1' qualifies.\"\"\"\n    if n == 1:\n        return 1\n    # For n > 1: The first and last digits are fixed as 1, leaving n-2 middle digits with 10 choices each.\n    return 10**(n - 2)\ndef starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    # Apply the principle of inclusion-exclusion: |A union B| = |A| + |B| - |A intersection B|.\n    # A = numbers that start with 1, B = numbers that end with 1.\n    count_starts = _count_starts_with_one(n)\n    count_ends = _count_ends_with_one(n)\n    count_both = _count_starts_and_ends_with_one(n)\n    \n    return count_starts + count_ends - count_both"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \n    This function calculates the sum of the decimal digits of N and then converts this sum to its binary string representation.\n    \"\"\"\n    \n    # Calculate the sum of the decimal digits of N\n    decimal_sum = 0\n    # Convert N to a string to easily iterate over its digits.\n    # For N = 0, str(0) is \"0\", sum is 0.\n    # For N > 0, iterate and sum.\n    for digit_char in str(N):\n        decimal_sum += int(digit_char)\n            \n    # Convert the calculated decimal sum to its binary string representation.\n    # The `bin()` function returns a string prefixed with \"0b\", so we slice it off.\n    binary_string = bin(decimal_sum)[2:]\n    \n    return binary_string"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n\n    This function orchestrates the calculation of the sum of digits and its\n    conversion to a binary string.\n    \"\"\"\n    def calculate_sum_of_digits(n: int) -> int:\n        \"\"\"Calculates the decimal sum of the digits of N.\"\"\"\n        sum_digits = 0\n        if n == 0:\n            return 0\n        for digit_char in str(n):\n            sum_digits += int(digit_char)\n        return sum_digits\n\n    def convert_to_binary_string(decimal_sum: int) -> str:\n        \"\"\"Converts a decimal integer sum into its binary string representation.\"\"\"\n        if decimal_sum == 0:\n            return \"0\"\n        return bin(decimal_sum)[2:]\n\n    decimal_sum = calculate_sum_of_digits(N)\n    binary_string = convert_to_binary_string(decimal_sum)\n    return binary_string"}
{"task_id": "HumanEval/81", "solution": "from typing import List\nclass GPA:\n    # Encapsulates a numerical GPA value, validating its range and type.\n    def __init__(self, value: float):\n        if not isinstance(value, (int, float)):\n            raise ValueError(\"GPA value must be a number.\")\n        if not (0.0 <= value <= 4.0):\n            raise ValueError(\"GPA value must be between 0.0 and 4.0.\")\n        self.value = float(value)\nclass LetterGrade:\n    # Encapsulates a letter grade string, validating its type and non-emptiness.\n    def __init__(self, grade: str):\n        if not isinstance(grade, str) or not grade:\n            raise ValueError(\"Letter grade must be a non-empty string.\")\n        self.grade = grade\nclass GradingScaleRule:\n    # Represents a single rule in the grading scale for GPA to letter grade conversion.\n    def __init__(self, threshold_gpa: float, letter_grade: str, is_exact_match: bool = False):\n        self.threshold_gpa = threshold_gpa\n        self.letter_grade = letter_grade\n        self.is_exact_match = is_exact_match\n\n    def applies_to(self, gpa_value: float) -> bool:\n        if self.is_exact_match:\n            return gpa_value == self.threshold_gpa\n        else:\n            return gpa_value > self.threshold_gpa\nclass GradingScale:\n    # Manages the collection of GradingScaleRule objects to determine letter grades.\n    def __init__(self):\n        self._rules: List[GradingScaleRule] = [\n            GradingScaleRule(4.0, 'A+', is_exact_match=True),\n            GradingScaleRule(3.7, 'A'),\n            GradingScaleRule(3.3, 'A-'),\n            GradingScaleRule(3.0, 'B+'),\n            GradingScaleRule(2.7, 'B'),\n            GradingScaleRule(2.3, 'B-'),\n            GradingScaleRule(2.0, 'C+'),\n            GradingScaleRule(1.7, 'C'),\n            GradingScaleRule(1.3, 'C-'),\n            GradingScaleRule(1.0, 'D+'),\n            GradingScaleRule(0.7, 'D'),\n            GradingScaleRule(0.0, 'D-'),\n            GradingScaleRule(0.0, 'E', is_exact_match=True)\n        ]\n\n    def get_letter_grade(self, gpa_value: float) -> LetterGrade:\n        for rule in self._rules:\n            if rule.applies_to(gpa_value):\n                return LetterGrade(rule.letter_grade)\n        # All valid GPA values (0.0 to 4.0) are covered by the rules, so this point should not be reached.\nclass GPAToLetterGradeConverter:\n    # Provides the application service for converting a list of GPA objects to letter grades.\n    def __init__(self, grading_scale: GradingScale):\n        self._grading_scale = grading_scale\n\n    def convert_gpas(self, gpas: List[GPA]) -> List[LetterGrade]:\n        converted_grades: List[LetterGrade] = []\n        for gpa_obj in gpas:\n            letter_grade = self._grading_scale.get_letter_grade(gpa_obj.value)\n            converted_grades.append(letter_grade)\n        return converted_grades\ndef numerical_letter_grade(grades: List[float]) -> List[str]:\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write \n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A \n            > 3.3                A- \n            > 3.0                B+\n            > 2.7                B \n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+ \n            > 0.7                D \n            > 0.0                D-\n              0.0                E\n    \n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    gpa_objects: List[GPA] = []\n    for gpa_value in grades:\n        try:\n            gpa_objects.append(GPA(gpa_value))\n        except ValueError as e:\n            raise ValueError(f\"Invalid GPA value '{gpa_value}': {e}\")\n\n    grading_scale = GradingScale()\n    converter = GPAToLetterGradeConverter(grading_scale)\n    letter_grade_objects = converter.convert_gpas(gpa_objects)\n\n    return [lg.grade for lg in letter_grade_objects]"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n    \"\"\"\n    total_sum = 0\n    for i, element in enumerate(lst):\n        # Check if the index is odd\n        if i % 2 != 0:\n            # Check if the element at the odd index is even\n            if element % 2 == 0:\n                total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n\n    Examples:\n        add([4, 2, 6, 7]) ==> 2 \n    \"\"\"\n    if not lst:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    for element in lst:\n        if not isinstance(element, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\n    current_sum = 0\n    for index, element in enumerate(lst):\n        if index % 2 != 0 and element % 2 == 0:\n            current_sum += element\n    return current_sum"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    \"\"\"\n    \n    def _sort_word_characters(word: str) -> str:\n        \"\"\"Sorts characters in a word by ASCII value.\"\"\"\n        return \"\".join(sorted(word))\n\n    def _tokenize_string(s: str) -> list[str]:\n        \"\"\"Splits the input string into a list of words and spaces.\"\"\"\n        tokens = []\n        current_token = []\n        is_space = s and s[0].isspace()\n\n        for char in s:\n            if char.isspace() == is_space:\n                current_token.append(char)\n            else:\n                tokens.append(\"\".join(current_token))\n                current_token = [char]\n                is_space = not is_space\n        if current_token:\n            tokens.append(\"\".join(current_token))\n        return tokens\n\n    tokens = _tokenize_string(s)\n    result_tokens = []\n    for token in tokens:\n        if not token.isspace():\n            result_tokens.append(_sort_word_characters(token))\n        else:\n            result_tokens.append(token)\n    \n    return \"\".join(result_tokens)"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Sorts characters within each word of a string and preserves word order and spaces.\n    \"\"\"\n\n    import re\n\n    def _sort_word_characters(word):\n        \"\"\"Sorts characters of a single word alphabetically based on ASCII values.\"\"\"\n        return \"\".join(sorted(word))\n\n    def _split_into_elements(text):\n        \"\"\"Splits text into a list of words and space segments.\"\"\"\n        # Split by one or more whitespace characters, keeping the delimiters.\n        # Filter out any empty strings that might result from leading/trailing delimiters.\n        elements = re.split(r'(\\s+)', text)\n        return [e for e in elements if e]\n\n    def _join_elements(elements_list):\n        \"\"\"Joins a list of string elements into a single string.\"\"\"\n        return \"\".join(elements_list)\n\n    elements = _split_into_elements(s)\n    processed_elements = []\n\n    for element in elements:\n        if element.isspace():\n            processed_elements.append(element)\n        else:\n            processed_elements.append(_sort_word_characters(element))\n\n    return _join_elements(processed_elements)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds occurrences of x in a nested list and returns their (row, column) coordinates.\n    The coordinates are sorted primarily by row ascending, then by column descending.\n    \"\"\"\n    found_coordinates = []\n    for row_idx, inner_list in enumerate(lst):\n        for col_idx, element in enumerate(inner_list):\n            if element == x:\n                found_coordinates.append((row_idx, col_idx))\n\n    # Sort primarily by row in ascending order (default for first element of tuple)\n    # Secondarily by column in descending order (negate column for ascending sort)\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return found_coordinates"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integers x in the list and returns a list of (row, columns) coordinates.\n    Sorts coordinates by rows (ascending) and then by columns (descending).\n    \"\"\"\n    found_coordinates = []\n    for row_index, row in enumerate(lst):\n        for col_index, element in enumerate(row):\n            if element == x:\n                found_coordinates.append((row_index, col_index))\n\n    # Sort primarily by row_index ascending, and secondarily by col_index descending\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return found_coordinates"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n    if not array:\n        return []\n\n    if len(array) == 1:\n        return array.copy()\n\n    array_copy = array.copy()\n\n    first_element = array[0]\n    last_element = array[-1]\n    total_sum = first_element + last_element\n\n    if total_sum % 2 == 0: # Even sum, sort in descending order\n        array_copy.sort(reverse=True)\n    else: # Odd sum, sort in ascending order\n        array_copy.sort(reverse=False)\n\n    return array_copy"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated. \n    The alphabet should be rotated in a manner such that the letters \n    shift down by two multiplied to two places.\n    For example:\n    encrypt('hi') returns 'lm'\n    encrypt('asdfghjkl') returns 'ewhjklnop'\n    encrypt('gf') returns 'kj'\n    encrypt('et') returns 'ix'\n    \"\"\"\n    LOWERCASE_ALPHABET = \"abcdefghijklmnopqrstuvwxyz\"\n    SHIFT_AMOUNT = 4  # Shift down by two multiplied by two places\n\n    def _get_shifted_char(char, shift):\n        # Calculates the shifted character for a given lowercase alphabetic character.\n        original_index = LOWERCASE_ALPHABET.index(char)\n        new_index = (original_index + shift) % len(LOWERCASE_ALPHABET)\n        return LOWERCASE_ALPHABET[new_index]\n\n    encrypted_chars = []\n    for char in s:\n        if char in LOWERCASE_ALPHABET:\n            encrypted_chars.append(_get_shifted_char(char, SHIFT_AMOUNT))\n        else:\n            # Non-alphabetic characters remain unchanged.\n            encrypted_chars.append(char)\n            \n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated. \n    The alphabet should be rotated in a manner such that the letters \n    shift down by two multiplied to two places.\n    \"\"\"\n    SHIFT_AMOUNT = 4  # Shift down by 2 * 2 = 4 places\n\n    def _is_lowercase_english(char_code):\n        \"\"\"Checks if a character code corresponds to a lowercase English letter.\"\"\"\n        return ord('a') <= char_code <= ord('z')\n\n    def _get_shifted_char_code(char_code, shift):\n        \"\"\"Calculates the new character code with wrap-around.\"\"\"\n        base = ord('a')\n        return base + (char_code - base + shift) % 26\n\n    encrypted_chars = []\n    for char in s:\n        char_code = ord(char)\n        if _is_lowercase_english(char_code):\n            shifted_code = _get_shifted_char_code(char_code, SHIFT_AMOUNT)\n            encrypted_chars.append(chr(shifted_code))\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the input array based on the parity of the sum of its first and last elements.\n    Returns an empty list for empty input, and the original list for single-element input.\n    \"\"\"\n    array_copy = list(array)\n\n    if not array_copy:\n        return []\n\n    if len(array_copy) == 1:\n        return array_copy\n\n    first_element = array_copy[0]\n    last_element = array_copy[-1]\n    sum_first_last = first_element + last_element\n\n    if sum_first_last % 2 != 0:  # Odd sum, sort ascending\n        return sorted(array_copy)\n    else:  # Even sum, sort descending\n        return sorted(array_copy, reverse=True)"}
