{"task_id": "HumanEval/53", "solution": "class Integer:\n    def __init__(self, value: int):\n        self._value = value\n\n    def get_value(self) -> int:\n        return self._value\nclass Calculator:\n    def add(self, x: Integer, y: Integer) -> Integer:\n        sum_value = x.get_value() + y.get_value()\n        return Integer(sum_value)\ndef add(x: int, y: int):\n    \"\"\"Add two numbers x and y\n    >>> add(2, 3)\n    5\n    >>> add(5, 7)\n    12\n    \"\"\"\n    integer_x = Integer(x)\n    integer_y = Integer(y)\n    calculator = Calculator()\n    result_integer = calculator.add(integer_x, integer_y)\n    return result_integer.get_value()"}
