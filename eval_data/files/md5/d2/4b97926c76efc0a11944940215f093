{"task_id": "Mbpp/245", "solution": "def max_sum(arr: list) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence in the given array.\n    A sequence is bitonic if it is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    # Calculate LIS Sums (Longest Increasing Subsequence Sums)\n    # lis_sums[i] stores the maximum sum of an increasing subsequence ending at index i.\n    lis_sums = list(arr)\n    for i in range(n):\n        for j in range(i):\n            if arr[i] > arr[j]:\n                lis_sums[i] = max(lis_sums[i], lis_sums[j] + arr[i])\n\n    # Calculate LDS Sums (Longest Decreasing Subsequence Sums)\n    # lds_sums[i] stores the maximum sum of a decreasing subsequence starting at index i.\n    lds_sums = list(arr)\n    for i in range(n - 1, -1, -1):\n        for j in range(n - 1, i, -1):\n            if arr[i] > arr[j]:\n                lds_sums[i] = max(lds_sums[i], lds_sums[j] + arr[i])\n\n    # Combine LIS and LDS sums to find the maximum bitonic sum.\n    # For each element arr[i], it can serve as the peak of a bitonic subsequence.\n    # The sum of such a subsequence would be lis_sums[i] + lds_sums[i] - arr[i]\n    # (arr[i] is counted twice, once in LIS and once in LDS, so subtract it).\n    max_bitonic_sum = float('-inf')\n\n    for i in range(n):\n        current_bitonic_sum = lis_sums[i] + lds_sums[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n\n    # The problem context implies integer return type from the example.\n    return int(max_bitonic_sum)"}
{"task_id": "Mbpp/252", "solution": "import cmath\n\ndef convert(input):\n    \"\"\"Converts a complex number (or real number) to polar coordinates (magnitude, angle).\n    Handles real numbers by treating them as complex numbers with a zero imaginary part.\n    \"\"\"\n    complex_number = complex(input)\n    magnitude, angle = cmath.polar(complex_number)\n    return (magnitude, angle)"}
{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Calculates the length of the longest palindromic subsequence in the given string.\n    Uses dynamic programming with a 2D table for memoization.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the longest palindromic subsequence for substring s[i...j]\n    dp = [[0] * n for _ in range(n)]\n\n    # All substrings of length 1 are palindromic subsequences of length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the table for substrings of length 2 to n\n    for length in range(2, n + 1):\n        for i in range(n - length + 1):\n            j = i + length - 1\n\n            if s[i] == s[j]:\n                # If characters at the ends match, they contribute 2 to the LPS,\n                # plus the LPS of the inner substring s[i+1...j-1].\n                dp[i][j] = 2 + dp[i + 1][j - 1]\n            else:\n                # If characters at the ends don't match, take the maximum of\n                # LPS when excluding s[i] (s[i+1...j]) or excluding s[j] (s[i...j-1]).\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    return dp[0][n - 1]"}
{"task_id": "Mbpp/256", "solution": "def count_Primes_nums(number):\n    \"\"\"\n    Counts the number of prime numbers strictly less than the given non-negative number.\n    Uses a helper function for primality testing.\n    \"\"\"\n    if number < 0:\n        # Based on design, input validation would be handled by _validate_input.\n        # However, for a self-contained function, we handle this basic check.\n        raise ValueError(\"Input number must be non-negative.\")\n\n    def _is_prime(n):\n        \"\"\"\n        Determines if a number is prime.\n        This is a helper function for primality testing.\n        \"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    count = 0\n    for i in range(2, number):\n        if _is_prime(i):\n            count += 1\n    return count"}
