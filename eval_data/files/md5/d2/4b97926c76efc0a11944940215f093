{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"\n    Main entry point for magic square validation.\n    Determines if the input matrix satisfies the properties of a magic square.\n    \"\"\"\n\n    def _is_valid_matrix(matrix: list[list[int]]) -> bool:\n        \"\"\"\n        Validates the input matrix structure to ensure it's a square matrix.\n        \"\"\"\n        if not matrix:\n            return False\n        n = len(matrix)\n        for row in matrix:\n            if not isinstance(row, list) or len(row) != n:\n                return False\n            for x in row:\n                if not isinstance(x, int):\n                    return False\n        return True\n\n    def _calculate_row_sums(matrix: list[list[int]]) -> list[int]:\n        \"\"\"\n        Calculates the sum of each row in the matrix.\n        \"\"\"\n        return [sum(row) for row in matrix]\n\n    def _calculate_column_sums(matrix: list[list[int]]) -> list[int]:\n        \"\"\"\n        Calculates the sum of each column in the matrix.\n        \"\"\"\n        n = len(matrix)\n        return [sum(matrix[r][c] for r in range(n)) for c in range(n)]\n\n    def _calculate_diagonal_sums(matrix: list[list[int]]) -> tuple[int, int]:\n        \"\"\"\n        Calculates the sums of both main diagonals of the matrix.\n        \"\"\"\n        n = len(matrix)\n        main_diag_sum = sum(matrix[i][i] for i in range(n))\n        anti_diag_sum = sum(matrix[i][n - 1 - i] for i in range(n))\n        return main_diag_sum, anti_diag_sum\n\n    def _compare_sums(row_sums: list[int], col_sums: list[int], diag_sums: tuple[int, int]) -> bool:\n        \"\"\"\n        Compares all calculated sums for equality to determine if it's a magic square.\n        \"\"\"\n        if not row_sums:\n            return False\n        expected_sum = row_sums[0]\n        if not all(s == expected_sum for s in row_sums):\n            return False\n        if not all(s == expected_sum for s in col_sums):\n            return False\n        if diag_sums[0] != expected_sum or diag_sums[1] != expected_sum:\n            return False\n        return True\n\n    if not _is_valid_matrix(matrix):\n        return False\n\n    row_sums = _calculate_row_sums(matrix)\n    col_sums = _calculate_column_sums(matrix)\n    diag_sums = _calculate_diagonal_sums(matrix)\n\n    return _compare_sums(row_sums, col_sums, diag_sums)"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"Reverses only the vowels of a given string (where y is not a vowel).\"\"\"\n\n    def is_vowel(char: str) -> bool:\n        \"\"\"Determines if a character is a vowel (a,e,i,o,u case-insensitive).\"\"\"\n        return char.lower() in \"aeiou\"\n\n    def extract_vowels(text: str) -> list:\n        \"\"\"Extracts vowels from the string along with their original positions.\"\"\"\n        vowel_data = []\n        for i, char in enumerate(text):\n            if is_vowel(char):\n                vowel_data.append((char, i))\n        return vowel_data\n\n    def build_result(original_chars_list: list, vowel_positions: list, reversed_vowels_chars: list) -> str:\n        \"\"\"Reconstructs the string by placing reversed vowels into their original positions.\"\"\"\n        result_list = list(original_chars_list)\n        for i, (_, original_index) in enumerate(vowel_positions):\n            result_list[original_index] = reversed_vowels_chars[i]\n        return \"\".join(result_list)\n\n    # Main logic for reverse_vowels\n    vowel_data = extract_vowels(s)\n\n    if not vowel_data:\n        return s  # No vowels to reverse\n\n    # Extract just the vowel characters and reverse them\n    vowel_chars_only = [item[0] for item in vowel_data]\n    reversed_vowel_chars = vowel_chars_only[::-1]\n\n    # Reconstruct the string\n    return build_result(list(s), vowel_data, reversed_vowel_chars)"}
