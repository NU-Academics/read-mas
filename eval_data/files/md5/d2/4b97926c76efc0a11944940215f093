{"task_id": "Mbpp/274", "solution": "import math\n\ndef _binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"\n    Calculates the binomial coefficient C(n, k) for non-negative integers n and k.\n    Returns 0 if k is out of range [0, n].\n    \"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n    \n    # Iteratively calculates C(n, k) to avoid large intermediate factorial values.\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\n\ndef _validate_input(n: int) -> bool:\n    \"\"\"\n    Validates if the input n is a positive integer.\n    \"\"\"\n    return n > 0\n\ndef even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of even index binomial coefficients for a given positive integer n.\n    This includes C(n,k) where k is even and 0 <= k <= n.\n    \"\"\"\n    # Per design context, input validation is conceptually performed.\n    # The problem guarantees `n` is a positive integer, so `_validate_input(n)` will always be true.\n    _validate_input(n) \n\n    total_sum = 0\n    # Sum binomial coefficients for even indices k from 0 to n.\n    for k in range(0, n + 1, 2):\n        total_sum += _binomial_coefficient(n, k)\n    \n    return total_sum"}
{"task_id": "Mbpp/273", "solution": "def substract_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Subtract elements of second tuple from corresponding elements of first tuple.\n\n    Raises ValueError if tuples have unequal lengths.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have equal lengths.\")\n\n    result_elements = [t1_elem - t2_elem for t1_elem, t2_elem in zip(tuple1, tuple2)]\n    return tuple(result_elements)"}
