{"task_id": "Mbpp/142", "solution": "def count_samepair(list1, list2, list3):\n    \"\"\"\n    Counts the number of positions where elements are identical across three lists.\n    Raises ValueError if the input lists do not have the same length.\n    \"\"\"\n    # Validate that all three lists have the same length as per design.\n    if not (len(list1) == len(list2) and len(list2) == len(list3)):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    count = 0\n    # Iterate through the lists' indices to compare elements at each position.\n    for i in range(len(list1)):\n        # Check if the elements at the current index are identical in all three lists.\n        if list1[i] == list2[i] and list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(arr: list) -> list:\n    \"\"\"\n    Sorts a list of elements using the pancake sort algorithm.\n    Returns a new sorted list without modifying the original input.\n    \"\"\"\n    def flip(arr: list, k: int) -> None:\n        \"\"\"\n        Performs a pancake flip operation, reversing elements from start to position k.\n        \"\"\"\n        start = 0\n        while start < k:\n            arr[start], arr[k] = arr[k], arr[start]\n            start += 1\n            k -= 1\n\n    def find_max_index(arr: list, n: int) -> int:\n        \"\"\"\n        Finds the index of the maximum element within the first n elements of the list.\n        \"\"\"\n        max_idx = 0\n        for i in range(1, n):\n            if arr[i] > arr[max_idx]:\n                max_idx = i\n        return max_idx\n\n    # Create a copy of the input list to avoid modifying the original\n    current_list = list(arr)\n    n = len(current_list)\n\n    # One by one, reduce the current size of the array and sort remaining elements\n    for curr_size in range(n, 1, -1):\n        # Find index of the maximum element in the current unsorted subarray\n        max_idx = find_max_index(current_list, curr_size)\n\n        # Move the maximum element to the beginning if it's not already there\n        if max_idx != 0:\n            flip(current_list, max_idx)\n\n        # Move the maximum element from the beginning to its correct position\n        flip(current_list, curr_size - 1)\n\n    return current_list"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(array):\n    \"\"\"\n    Calculates the maximum absolute difference between any two elements in an array.\n    Assumes the input array contains at least two numeric elements.\n    \"\"\"\n    min_val = float('inf')\n    max_val = float('-inf')\n\n    for x in array:\n        if x < min_val:\n            min_val = x\n        if x > max_val:\n            max_val = x\n\n    return max_val - min_val"}
