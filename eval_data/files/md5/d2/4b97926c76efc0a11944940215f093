{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) for i from 0 to n // 2,\n    stopping when the term becomes less than or equal to 0.\n    \"\"\"\n    total_sum = 0\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        if term <= 0:\n            break\n        total_sum += term\n    return total_sum"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers: list[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list where their bitwise XOR results in an even number.\n    This implementation iterates through all unique pairs and checks their XOR parity.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n\n    # Iterate through all unique pairs (numbers[i], numbers[j])\n    for i in range(n):\n        for j in range(i + 1, n):\n            # Perform the bitwise XOR operation\n            xor_result = numbers[i] ^ numbers[j]\n            \n            # Check if the XOR result is even by checking its least significant bit\n            if (xor_result & 1) == 0:\n                count += 1\n                \n    return count"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string that occur at the same position as in the English alphabet (case insensitive).\n    \"\"\"\n    def _normalize_char(char: str) -> str:\n        \"\"\"Converts a character to lowercase.\"\"\"\n        return char.lower()\n\n    def _get_alphabet_char(position: int) -> str:\n        \"\"\"Gets the alphabet character at a given 0-indexed position.\"\"\"\n        return chr(ord('a') + position)\n\n    def _is_valid_position(position: int) -> bool:\n        \"\"\"Checks if a position is within the valid alphabet range (0-25).\"\"\"\n        return 0 <= position < 26\n\n    count = 0\n    for position, char in enumerate(input_string):\n        if _is_valid_position(position):\n            normalized_char = _normalize_char(char)\n            expected_char = _get_alphabet_char(position)\n            if normalized_char == expected_char:\n                count += 1\n    return count"}
