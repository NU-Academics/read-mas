{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # For odd-length lists, the median is the middle element.\n        median_val = sorted_l[n // 2]\n    else:\n        # For even-length lists, the median is the average of the two middle elements.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        median_val = (mid1 + mid2) / 2\n\n    # Return as an integer if it's a whole number, otherwise as a float.\n    if median_val == int(median_val):\n        return int(median_val)\n    else:\n        return median_val"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int) -> int:\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    This function uses modular exponentiation to efficiently compute 2^n mod p.\n    \"\"\"\n    result = 1\n    base = 2 % p\n\n    while n > 0:\n        if n % 2 == 1:  # If n is odd, multiply result by current base\n            result = (result * base) % p\n        base = (base * base) % p  # Square the base\n        n = n // 2  # Halve the exponent\n\n    return result"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    This implements modular exponentiation to handle large n efficiently.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    result = 1\n    # Initialize base as 2 modulo p to keep intermediate values small.\n    base = 2 % p\n\n    # Apply binary exponentiation (exponentiation by squaring) algorithm.\n    while n > 0:\n        # If the current bit of n is 1 (n is odd), multiply result by base.\n        if n % 2 == 1:\n            result = (result * base) % p\n\n        # Square the base and take modulo p for the next iteration.\n        base = (base * base) % p\n\n        # Right shift n by 1 (integer division by 2).\n        n //= 2\n\n    return result"}
