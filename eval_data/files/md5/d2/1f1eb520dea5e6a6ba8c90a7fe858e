{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to base.\n    Returns string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    result = \"\"\n    is_negative = False\n    if x < 0:\n        is_negative = True\n        x = -x\n\n    while x > 0:\n        remainder = x % base\n        result = str(remainder) + result\n        x //= base\n\n    if is_negative:\n        result = \"-\" + result\n\n    return result"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Converts an integer x from base 10 to its string representation in the specified base.\n    The target base must be less than 10.\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    is_negative = False\n    if x < 0:\n        is_negative = True\n        x = abs(x)\n\n    result_digits = []\n    while x > 0:\n        remainder = x % base\n        result_digits.append(str(remainder))\n        x //= base\n\n    # The digits are collected in reverse order, so reverse them for the final string.\n    converted_string = \"\".join(result_digits[::-1])\n\n    if is_negative:\n        return \"-\" + converted_string\n    else:\n        return converted_string"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n    else:\n        # Initialize the last four Fib4 numbers: fib4(0), fib4(1), fib4(2), fib4(3)\n        a, b, c, d = 0, 0, 2, 0\n        for _ in range(4, n + 1):\n            next_fib4 = d + c + b + a\n            a, b, c, d = b, c, d, next_fib4\n        return d"}
