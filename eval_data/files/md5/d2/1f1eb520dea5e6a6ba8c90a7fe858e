{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/31", "solution": "import math\ndef is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for odd factors from 3 up to the square root of n.\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True"}
{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list) -> float:\n    \"\"\"\n    Finds a zero of a polynomial given its coefficients xs.\n    It returns a single zero, guaranteed to exist for valid inputs based on problem constraints.\n    \"\"\"\n    _validate_coefficients(xs)\n\n    low = -10000.0  # Initial lower bound for the search interval\n    high = 10000.0  # Initial upper bound for the search interval\n    epsilon = 1e-7  # Tolerance for determining if a value is a zero\n    max_iterations = 100  # Maximum iterations to prevent infinite loops\n\n    for _ in range(max_iterations):\n        mid = (low + high) / 2.0\n        p_mid = poly(xs, mid)\n\n        if abs(p_mid) < epsilon:\n            return mid\n\n        # Determine which half of the interval contains the root\n        if poly(xs, low) * p_mid < 0:\n            high = mid\n        else:\n            low = mid\n\n    # Return the current best approximation if max_iterations is reached\n    return (low + high) / 2.0"}
{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    Returns the sum of coeff * x^i for each coefficient at index i.\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list):\n    \"\"\"\n    Finds a single zero point `x` for a polynomial with coefficients `xs` such that `poly(xs, x) = 0`.\n    This function requires an even number of coefficients and a non-zero largest coefficient, which guarantees a solution.\n    \"\"\"\n    n = len(xs)\n\n    # NFR1: Even Number of Coefficients for Zero Finding\n    if n % 2 != 0:\n        raise ValueError(\"Coefficients list must have an even number of elements.\")\n\n    # NFR2: Non-Zero Largest Coefficient for Zero Finding\n    # The largest coefficient is at index n-1, corresponding to x^(n-1).\n    if xs[n - 1] == 0:\n        raise ValueError(\"Largest coefficient must be non-zero.\")\n\n    # Implement zero-finding algorithm (Bisection method)\n    # For an odd-degree polynomial (len(xs) even implies degree n-1 is odd),\n    # a real root is guaranteed. We choose a sufficiently large initial interval.\n    low = -1000.0\n    high = 1000.0\n    tolerance = 1e-6\n    max_iterations = 200\n\n    for _ in range(max_iterations):\n        mid = (low + high) / 2.0\n        p_mid = poly(xs, mid)\n\n        if abs(p_mid) < tolerance:\n            return mid\n\n        # Check for sign change to narrow the interval.\n        # This re-evaluates poly(xs, low) in each iteration.\n        p_low_val = poly(xs, low)\n        if p_low_val * p_mid < 0:\n            high = mid\n        else:\n            low = mid\n\n    # If max_iterations are exhausted, return the midpoint of the final interval.\n    # This value is the best approximation found and serves as the single zero point (FR4).\n    return (low + high) / 2.0"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"Returns a new list where elements at indices divisible by three are sorted,\n    while other elements remain in their original positions.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    l_prime = list(l)\n\n    divisible_by_three_elements = []\n    divisible_by_three_indices = []\n    for i, item in enumerate(l):\n        if i % 3 == 0:\n            divisible_by_three_elements.append(item)\n            divisible_by_three_indices.append(i)\n\n    divisible_by_three_elements.sort()\n\n    for i, original_index in enumerate(divisible_by_three_indices):\n        l_prime[original_index] = divisible_by_three_elements[i]\n\n    return l_prime"}
