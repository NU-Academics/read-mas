{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    Handles both odd and even length lists after sorting.\n    \"\"\"\n    l_sorted = sorted(l)\n    n = len(l_sorted)\n\n    # Assuming non-empty lists based on \"Trust the caller's inputs\" constraint.\n    # No error handling for empty lists as per critical requirements.\n\n    if n % 2 == 1:\n        # For odd length lists, the median is the middle element.\n        mid_idx = n // 2\n        return float(l_sorted[mid_idx])\n    else:\n        # For even length lists, the median is the average of the two middle elements.\n        mid1_idx = n // 2 - 1\n        mid2_idx = n // 2\n        return (l_sorted[mid1_idx] + l_sorted[mid2_idx]) / 2.0"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\"Checks if all opening brackets have a corresponding closing bracket in the correct order.\n    Returns True for correctly bracketed strings, False otherwise.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n\n        if balance < 0:\n            return False  # Unmatched closing bracket\n\n    return balance == 0  # True if all brackets matched, False if unmatched opening brackets"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int) -> int:\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer (n > 0).\")\n    elif n == 1:\n        return 1\n    else:\n        a, b = 0, 1\n        for _ in range(n - 1):\n            a, b = b, a + b\n        return b"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list) -> list:\n  \"\"\"Return sorted unique common elements for two lists.\n  >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n  [1, 5, 653]\n  >>> common([5, 3, 2, 8], [3, 2])\n  [2, 3]\n  \"\"\"\n  set1 = set(l1)\n  set2 = set(l2)\n  common_elements = list(set1.intersection(set2))\n  common_elements.sort()\n  return common_elements"}
{"task_id": "HumanEval/57", "solution": "def _is_monotonically_increasing(l: list) -> bool:\n    \"\"\"Checks if a list is monotonically increasing.\"\"\"\n    for i in range(1, len(l)):\n        if l[i] < l[i-1]:\n            return False\n    return True\ndef _is_monotonically_decreasing(l: list) -> bool:\n    \"\"\"Checks if a list is monotonically decreasing.\"\"\"\n    for i in range(1, len(l)):\n        if l[i] > l[i-1]:\n            return False\n    return True\ndef monotonic(l: list) -> bool:\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    return _is_monotonically_increasing(l) or _is_monotonically_decreasing(l)"}
{"task_id": "HumanEval/50", "solution": "def decode_shift(s: str):\n    \"\"\"\n    takes as input string encoded with encode_shift function. Returns decoded string.\n    \"\"\"\n    shift_amount = 5\n    alphabet_start_char_ord = ord('a')\n    alphabet_size = 26\n    decoded_chars = []\n    for char_val in s:\n        current_position = ord(char_val) - alphabet_start_char_ord\n        shifted_position = (current_position - shift_amount + alphabet_size) % alphabet_size\n        new_char = chr(shifted_position + alphabet_start_char_ord)\n        decoded_chars.append(new_char)\n    return \"\".join(decoded_chars)"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    max_prime_factor = 1\n\n    # Divide by 2 until n is odd\n    while n % 2 == 0:\n        max_prime_factor = 2\n        n //= 2\n\n    # Iterate for odd factors from 3 up to sqrt(n)\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            max_prime_factor = i\n            n //= i\n        i += 2\n\n    # If n is still greater than 1, it is the largest prime factor\n    if n > 1:\n        max_prime_factor = n\n\n    return max_prime_factor"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n.\n    Assumes n is an integer greater than 1 and not a prime number.\n    \"\"\"\n    largest_factor = 1\n\n    # Handle factor 2\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Handle odd factors starting from 3\n    # Iterate while i*i is less than or equal to n.\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n        i += 2\n\n    # If n remains greater than 1, it must be the largest prime factor itself.\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int) -> int:\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket and is correctly nested.\n\n    >>> correct_bracketing(\"(\")\n    False\n    >>> correct_bracketing(\"()\")\n    True\n    >>> correct_bracketing(\"(()())\")\n    True\n    >>> correct_bracketing(\")(()\")\n    False\n    >>> correct_bracketing(\"\")\n    True\n    >>> correct_bracketing(\"())(\")\n    False\n    \"\"\"\n    # This function implements the BracketSequenceValidator's validate operation.\n    # It processes the input 'brackets' character by character.\n\n    stack = []  # Using a Python list as a stack.\n\n    for char in brackets:\n        if char == '(': # An opening bracket must have a corresponding closing bracket.\n            stack.append(char)\n        elif char == ')': # A closing bracket must have a preceding, unmatched opening bracket.\n            if not stack: # No opening bracket to match.\n                return False\n            stack.pop() # Match found, remove from stack.\n\n    # All opening brackets must be matched.\n    # Brackets must be correctly nested.\n    return not stack"}
{"task_id": "HumanEval/62", "solution": "from typing import List\nclass Coefficient:\n    \"\"\"Represents a single term's coefficient and its exponent.\"\"\"\n    def __init__(self, value: float, exponent: int):\n        self.value = value\n        self.exponent = exponent\nclass Polynomial:\n    \"\"\"Encapsulates a polynomial using a list of Coefficient objects.\"\"\"\n    def __init__(self, raw_coefficients: List[float]):\n        self._coefficients: List[Coefficient] = []\n        for i, val in enumerate(raw_coefficients):\n            self._coefficients.append(Coefficient(val, i))\n\n    def compute_derivative(self) -> 'Polynomial':\n        \"\"\"Computes the derivative of the polynomial and returns a new Polynomial object.\"\"\"\n        if len(self._coefficients) <= 1:\n            return Polynomial([])\n\n        derived_coeffs_raw: List[float] = []\n        # The coefficient for x^k in the output is (k+1) * xs[k+1] from the input list.\n        for k in range(len(self._coefficients) - 1):\n            new_coeff_value = (k + 1) * self._coefficients[k + 1].value\n            derived_coeffs_raw.append(new_coeff_value)\n\n        return Polynomial(derived_coeffs_raw)\n\n    def to_list(self) -> List[float]:\n        \"\"\"Converts the internal list of Coefficient objects back into a simple List[float].\"\"\"\n        return [coeff.value for coeff in self._coefficients]\ndef derivative(xs: list) -> list:\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    poly = Polynomial(xs)\n    derived_poly = poly.compute_derivative()\n    result_list = derived_poly.to_list()\n    return result_list"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\" Determines if a given string of brackets is correctly balanced and ordered.\n    It returns True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance_counter = 0\n    for char in brackets:\n        if char == '(':\n            balance_counter += 1\n        elif char == ')':\n            if balance_counter == 0:\n                return False\n            balance_counter -= 1\n\n    return balance_counter == 0"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list) -> list:\n    \"\"\"xs represent coefficients of a polynomial.\n    Return derivative of this polynomial in the same form.\n    \"\"\"\n    derived_coefficients = []\n    # For a term xs[i] * x^i, its derivative is (i * xs[i]) * x^(i-1).\n    # The constant term xs[0] (x^0) has a derivative of 0 and is thus omitted.\n    for i in range(1, len(xs)):\n        new_coeff = i * xs[i]\n        derived_coefficients.append(new_coeff)\n    return derived_coefficients"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts vowels in a string, including 'y' if it's the last character.\n    Vowels are 'a', 'e', 'i', 'o', 'u' (case-insensitive) and 'y' at the end.\"\"\"\n    count = 0\n    vowels = \"aeiou\"\n\n    for char in s:\n        if char.lower() in vowels:\n            count += 1\n\n    if len(s) > 0 and s[-1].lower() == 'y':\n        count += 1\n\n    return count"}
{"task_id": "HumanEval/63", "solution": "_memo = {0: 0, 1: 0, 2: 1}\ndef fibfib(n: int) -> int:\n    \"\"\"Computes the n-th element of the FibFib sequence efficiently using dynamic programming (memoization).\n    It stores previously calculated values to avoid redundant computations.\n    \"\"\"\n    if n in _memo:\n        return _memo[n]\n\n    # Calculate and store the result for n > 2\n    _memo[n] = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n    return _memo[n]"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\"Checks if every opening bracket has a corresponding closing bracket.\n    The counter must not drop below zero and must be zero at the end.\n    \"\"\"\n    open_bracket_counter = 0\n    for char in brackets:\n        if char == '<':\n            open_bracket_counter += 1\n        elif char == '>':\n            open_bracket_counter -= 1\n            if open_bracket_counter < 0:\n                return False\n    return open_bracket_counter == 0"}
{"task_id": "HumanEval/64", "solution": "def _is_standard_vowel(char: str) -> bool:\n    \"\"\"Helper to check if a character is one of the standard English vowels.\"\"\"\n    return char in {'a', 'e', 'i', 'o', 'u'}\ndef _is_conditional_y_vowel(char: str, is_last: bool) -> bool:\n    \"\"\"Helper to check if 'y' qualifies as a vowel based on its position.\"\"\"\n    return char == 'y' and is_last\ndef vowels_count(s: str) -> int:\n    \"\"\"Counts vowels in a string, including 'y' only if it's the last character.\n    Vowels 'a', 'e', 'i', 'o', 'u' are always counted case-insensitively.\n    \"\"\"\n    vowel_count = 0\n    s_lower = s.lower()\n    string_length = len(s_lower)\n\n    for i, char in enumerate(s_lower):\n        if _is_standard_vowel(char):\n            vowel_count += 1\n        elif _is_conditional_y_vowel(char, i == string_length - 1):\n            vowel_count += 1\n\n    return vowel_count"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\"\"\"\n    if len(l) <= 1:\n        return True\n\n    # Check if the list is monotonically increasing\n    is_increasing = True\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False\n            break\n\n    if is_increasing:\n        return True\n\n    # If not increasing, check if the list is monotonically decreasing\n    is_decreasing = True\n    for i in range(len(l) - 1):\n        if l[i] < l[i+1]:\n            is_decreasing = False\n            break\n\n    return is_decreasing"}
{"task_id": "HumanEval/65", "solution": "def _reverse_string(digits_str: str) -> str:\n    \"\"\"Reverses a string of digits.\n    \"\"\"\n    return digits_str[::-1]\ndef _perform_right_circular_shift(digits_str: str, shift_amount: int) -> str:\n    \"\"\"Performs a circular right shift on a string of digits.\n    The shift amount is normalized to the string length.\n    \"\"\"\n    length = len(digits_str)\n    if length == 0:\n        return \"\"\n    effective_shift = shift_amount % length\n    return digits_str[length - effective_shift:] + digits_str[:length - effective_shift]\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string. If shift > number of digits, return digits reversed.\n    \"\"\"\n    digits_str = str(abs(x))\n    num_digits = len(digits_str)\n\n    if shift > num_digits:\n        return _reverse_string(digits_str)\n    else:\n        return _perform_right_circular_shift(digits_str, shift)"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list) -> list:\n    \"\"\"Return sorted unique common elements for two lists.\n    This function identifies elements present in both lists, ensures uniqueness, and returns them sorted.\n    \"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_elements = list(set1.intersection(set2))\n    common_elements.sort()\n    return common_elements"}
{"task_id": "HumanEval/66", "solution": "def _is_uppercase_char(char_val: str) -> bool:\n    \"\"\"Checks if a character is an uppercase letter.\n    This helper function uses the built-in `isupper()` method.\n    \"\"\"\n    return char_val.isupper()\ndef _get_ascii_code(char_val: str) -> int:\n    \"\"\"Retrieves the ASCII integer value for a character.\n    This helper function uses the built-in `ord()` function.\n    \"\"\"\n    return ord(char_val)\ndef digitSum(s):\n    \"\"\"Calculates the sum of ASCII codes for uppercase characters in a string.\n    Returns 0 if the string is empty or contains no uppercase characters.\n    \"\"\"\n    if not s:\n        return 0\n\n    total_sum = 0\n    for char in s:\n        if _is_uppercase_char(char):\n            total_sum += _get_ascii_code(char)\n\n    return total_sum"}
{"task_id": "HumanEval/67", "solution": "def _parse_fruit_counts(s: str) -> tuple[int, int]:\n    \"\"\"Parses the input string to extract apple and orange counts.\"\"\"\n    parts = s.split(\" apples and \")\n    apple_count = int(parts[0])\n    orange_count = int(parts[1].split(\" oranges\")[0])\n    return apple_count, orange_count\ndef fruit_distribution(s,n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges\n    that are distributed in a basket of fruit this basket contains\n    apples, oranges, and mango fruits. Given the string that represents the total number of\n    the oranges and apples and an an integer that represent the total number of the fruits\n    in the basket return the number of the mango fruits in the basket.\n    \"\"\"\n    apple_count, orange_count = _parse_fruit_counts(s)\n    mango_count = n - apple_count - orange_count\n\n    # Optionally instantiate FruitCounts for conceptual clarity\n    # fruit_counts_obj = FruitCounts(apple_count, orange_count, mango_count)\n\n    return mango_count"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s, n):\n    \"\"\"Calculates the number of mango fruits in a basket.\n    It subtracts known apple and orange counts from the total.\n    \"\"\"\n    def _parse_fruit_string(s_val):\n        \"\"\"Parses fruit counts from the input string.\n        Extracts apple and orange counts using regular expressions.\n        \"\"\"\n        apples_match = re.search(r'(\\d+)\\s*apples', s_val)\n        oranges_match = re.search(r'(\\d+)\\s*oranges', s_val)\n\n        apples_count = int(apples_match.group(1))\n        oranges_count = int(oranges_match.group(1))\n\n        return apples_count, oranges_count\n\n    apples_count, oranges_count = _parse_fruit_string(s)\n    total_known_fruits = apples_count + oranges_count\n    mangoes_count = n - total_known_fruits\n    return mangoes_count"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII values of only the uppercase characters in the input string.\n    Returns 0 if the string is empty or contains no uppercase characters.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/69", "solution": "import collections\ndef search(lst):\n    \"\"\"\n    Finds the greatest integer 'x' such that its frequency in the list is greater than or equal to 'x'.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    frequency_map = collections.Counter(lst)\n    qualifying_integers = []\n\n    for num, freq in frequency_map.items():\n        if freq >= num:\n            qualifying_integers.append(num)\n\n    if qualifying_integers:\n        return max(qualifying_integers)\n    else:\n        return -1"}
{"task_id": "HumanEval/69", "solution": "def _calculate_frequencies(lst: list[int]) -> dict[int, int]:\n    \"\"\"Calculates the frequency of each integer in the list.\n    Returns a dictionary mapping integers to their counts.\n    \"\"\"\n    frequencies = {}\n    for num in lst:\n        frequencies[num] = frequencies.get(num, 0) + 1\n    return frequencies\ndef _identify_candidates(frequencies: dict[int, int]) -> list[int]:\n    \"\"\"Identifies integers whose frequency is greater than or equal to their value.\n    Returns a list of such candidate integers.\n    \"\"\"\n    candidates = []\n    for x, freq in frequencies.items():\n        if freq >= x:\n            candidates.append(x)\n    return candidates\ndef search(lst: list[int]) -> int:\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than\n    zero, and has a frequency greater than or equal to the value of the integer itself.\n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    frequencies = _calculate_frequencies(lst)\n    candidates = _identify_candidates(frequencies)\n\n    if not candidates:\n        return -1\n    return max(candidates)"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Given an array of non-negative integer nodes, finds the smallest even value.\n    If multiple nodes share the smallest even value, the node with the smallest index is returned as `[value, index]` or `[]` if no even nodes are found.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, node_value in enumerate(arr):\n        if node_value % 2 == 0:\n            if node_value < smallest_even_value:\n                smallest_even_value = node_value\n                smallest_even_index = index\n            elif node_value == smallest_even_value:\n                if index < smallest_even_index:\n                    smallest_even_index = index\n\n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr: list[int]) -> list[int]:\n    \"\"\"Finds the smallest even non-negative integer and its first occurrence index in `arr`.\n    Returns `[value, index]` or `[]` if no even numbers are found or `arr` is empty.\"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the number is even\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n\n    if smallest_even_index == -1:\n        return []\n    else:\n        return [int(smallest_even_value), smallest_even_index]"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers into a unique 'strange order' by alternately picking minimum and maximum values.\n    Handles empty lists and preserves duplicates as specified in the design.\n    \"\"\"\n    if not lst:\n        return []\n\n    sorted_working_list = sorted(lst)\n    result_list = []\n\n    while sorted_working_list:\n        # Extract and append the current minimum value\n        min_val = sorted_working_list.pop(0)\n        result_list.append(min_val)\n\n        # If there are still elements, extract and append the current maximum value\n        if sorted_working_list:\n            max_val = sorted_working_list.pop()\n            result_list.append(max_val)\n\n    return result_list"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Sorts a list of integers in a strange order, alternately selecting the minimum and then the maximum of remaining elements.\n    Returns an empty list if the input list is empty.\n    \"\"\"\n    mutable_list_copy = list(lst)\n    result_list = []\n    is_min_turn = True\n\n    while mutable_list_copy:\n        if is_min_turn:\n            # Find and append the minimum element\n            min_val = min(mutable_list_copy)\n            result_list.append(min_val)\n            mutable_list_copy.remove(min_val)\n        else:\n            # Find and append the maximum element\n            max_val = max(mutable_list_copy)\n            result_list.append(max_val)\n            mutable_list_copy.remove(max_val)\n\n        is_min_turn = not is_min_turn # Toggle the turn\n\n    return result_list"}
{"task_id": "HumanEval/71", "solution": "import math\ndef _is_valid_triangle(a: float, b: float, c: float) -> bool:\n    \"\"\"Checks if three side lengths can form a valid triangle.\n    Sides must be positive and satisfy the triangle inequality theorem.\"\"\"\n    if a <= 0 or b <= 0 or c <= 0:\n        return False\n    return (a + b > c) and (a + c > b) and (b + c > a)\ndef _calculate_herons_area(a: float, b: float, c: float) -> float:\n    \"\"\"Calculates the area of a triangle using Heron's formula.\n    Precondition: The sides form a valid triangle.\"\"\"\n    s = (a + b + c) / 2\n    area_squared = s * (s - a) * (s - b) * (s - c)\n    if area_squared < 0: # Handle potential floating point inaccuracies for valid triangles\n        return 0.0\n    return math.sqrt(area_squared)\ndef _round_area(area: float) -> float:\n    \"\"\"Rounds a float value to two decimal places.\"\"\"\n    return round(area, 2)\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1\n    '''\n    if not _is_valid_triangle(a, b, c):\n        return -1.0\n\n    raw_area = _calculate_herons_area(a, b, c)\n    rounded_area = _round_area(raw_area)\n\n    return rounded_area"}
{"task_id": "HumanEval/71", "solution": "import math\nclass Triangle:\n    \"\"\"Represents a triangle with three side lengths.\"\"\"\n\n    def __init__(self, a: float, b: float, c: float):\n        \"\"\"Initializes the Triangle object with given side lengths.\"\"\"\n        self._side_a = a\n        self._side_b = b\n        self._side_c = c\n\n    def is_valid(self) -> bool:\n        \"\"\"Determines if the side lengths form a valid triangle.\n        Checks positivity and triangle inequality.\"\"\"\n        if self._side_a <= 0 or self._side_b <= 0 or self._side_c <= 0:\n            return False\n        if not (self._side_a + self._side_b > self._side_c and\n                self._side_a + self._side_c > self._side_b and\n                self._side_b + self._side_c > self._side_a):\n            return False\n        return True\n\n    def calculate_area(self) -> float:\n        \"\"\"Calculates the area of the triangle using Heron's formula.\n        This method assumes the triangle is valid when called.\"\"\"\n        s = (self._side_a + self._side_b + self._side_c) / 2\n        area = math.sqrt(s * (s - self._side_a) * (s - self._side_b) * (s - self._side_c))\n        return area\ndef triangle_area(a: float, b: float, c: float) -> float:\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater\n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    triangle = Triangle(a, b, c)\n    if triangle.is_valid():\n        raw_area = triangle.calculate_area()\n        return round(raw_area, 2)\n    else:\n        return -1"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr: list[int]) -> int:\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic.\n    \"\"\"\n    changes = 0\n    left = 0\n    right = len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q: list, w: int) -> bool:\n    \"\"\"\n    Checks if list q is a palindrome and if the sum of its elements\n    is less than or equal to w.\n    \"\"\"\n    is_palindrome = (q == q[::-1])\n    current_sum = sum(q)\n    return is_palindrome and (current_sum <= w)"}
{"task_id": "HumanEval/65", "solution": "def _reverse_digits(s: str) -> str:\n    \"\"\"Reverses a given string.\"\"\"\n    return s[::-1]\ndef _circular_right_shift(s: str, shift_amount: int) -> str:\n    \"\"\"Performs a circular right shift on a string.\"\"\"\n    if not s:\n        return \"\"\n    actual_shift = shift_amount % len(s)\n    return s[-actual_shift:] + s[:-actual_shift]\ndef circular_shift(x: int, shift: int) -> str:\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    s_x = str(x)\n    num_digits = len(s_x)\n\n    if shift > num_digits:\n        return _reverse_digits(s_x)\n    else:\n        return _circular_right_shift(s_x, shift)"}
{"task_id": "HumanEval/72", "solution": "def _is_palindrome(q):\n    \"\"\"\n    Checks if a list q is a palindrome.\n    Returns True if q reads the same forwards and backward, False otherwise.\n    \"\"\"\n    return q == q[::-1]\ndef _calculate_sum(q):\n    \"\"\"\n    Calculates the sum of all elements in list q.\n    It expects q to contain numerical values.\n    \"\"\"\n    return sum(q)\ndef will_it_fly(q,w):\n    '''\n    Determines if an object q will fly based on balance and weight conditions.\n    Returns True if q is a palindrome and its sum is less than or equal to w.\n    '''\n    if not _is_palindrome(q):\n        return False\n\n    total_weight = _calculate_sum(q)\n    return total_weight <= w"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates minimum changes to make an array palindromic.\n    Compares elements from both ends and counts mismatches.\n    \"\"\"\n    changes = 0\n    left = 0\n    right = len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes"}
{"task_id": "HumanEval/74", "solution": "def _calculate_total_chars(string_list: list[str]) -> int:\n    \"\"\"Calculates the total character count for all strings in a list.\"\"\"\n    total_chars = 0\n    for s in string_list:\n        total_chars += len(s)\n    return total_chars\ndef total_match(lst1: list[str], lst2: list[str]) -> list[str]:\n    \"\"\"Compares two lists of strings by total character count, returning the one with fewer characters or the first list on a tie.\"\"\"\n    total_chars_lst1 = _calculate_total_chars(lst1)\n    total_chars_lst2 = _calculate_total_chars(lst2)\n\n    if total_chars_lst1 <= total_chars_lst2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/74", "solution": "from typing import List\ndef _calculate_total_chars(string_list: List[str]) -> int:\n    \"\"\"\n    Calculates the total number of characters across all strings in a given list.\n    Corresponds to FR2, FR3, and BR1.\n    \"\"\"\n    total_count = 0\n    for s in string_list:\n        total_count += len(s)\n    return total_count\ndef total_match(lst1: List[str], lst2: List[str]) -> List[str]:\n    \"\"\"\n    Compares two lists of strings based on their total character counts.\n    Returns the list with the smaller total number of characters, or lst1 if counts are equal.\n    \"\"\"\n    count1 = _calculate_total_chars(lst1)\n    count2 = _calculate_total_chars(lst2)\n\n    if count1 < count2:\n        return lst1\n    elif count2 < count1:\n        return lst2\n    else:\n        return lst1"}
{"task_id": "HumanEval/75", "solution": "def _get_prime_factors(n: int) -> list[int]:\n    \"\"\"Computes and returns a list of all prime factors (with multiplicity) for a given integer n.\"\"\"\n    factors = []\n    d = 2\n    temp_n = n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n    if temp_n > 1:\n        factors.append(temp_n)\n    return factors\ndef is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    if a < 2:\n        return False\n\n    prime_factors = _get_prime_factors(a)\n\n    return len(prime_factors) == 3"}
{"task_id": "HumanEval/76", "solution": "import math\ndef is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n (n**k = x for integer k). Returns true if it is, false otherwise.\"\"\"\n    # Handle common edge cases for n=0, n=1, and x=1 as defined.\n    if n == 1:\n        return x == 1\n    if n == 0:\n        # 0**k = 0 (k>0), 0**0 = 1.\n        return x == 0 or x == 1\n    if x == 1:\n        # For x=1, any n (except 0, which is handled) to power 0 is 1.\n        return True\n\n    # Negative x or x=0 (unless covered by n=0 case) are not simple powers.\n    if x <= 0:\n        return False\n\n    try:\n        power = math.log(x, n)\n    except ValueError:\n        # math.log raises ValueError if x or n are invalid inputs.\n        return False\n\n    # Check if the calculated power is an integer, accounting for float precision.\n    return abs(power - round(power)) < 1e-9"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Determines if an integer 'a' is a perfect cube.\n    It calculates the integer cube root candidate and checks its cube.\n    '''\n\n    if a == 0:\n        return True\n\n    is_negative = a < 0\n\n    # Calculate the cube root of the absolute value, then round to the nearest integer.\n    candidate_root = round(abs(a)**(1/3))\n\n    # If the original number was negative, the candidate root must also be negative.\n    if is_negative:\n        candidate_root = -candidate_root\n\n    # Check if the cube of the candidate integer root equals the original number.\n    return candidate_root * candidate_root * candidate_root == a"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num: str) -> int:\n    \"\"\"\n    Counts the number of hexadecimal digits that are primes.\n    Prime hexadecimal digits are 2, 3, 5, 7, B (decimal 11), D (decimal 13).\n    \"\"\"\n    _PRIME_HEX_DECIMAL_VALUES = {2, 3, 5, 7, 11, 13}\n\n    def _hex_char_to_decimal(char: str) -> int:\n        return int(char, 16)\n\n    prime_count = 0\n    for char_digit in num:\n        decimal_value = _hex_char_to_decimal(char_digit)\n        if decimal_value in _PRIME_HEX_DECIMAL_VALUES:\n            prime_count += 1\n    return prime_count"}
{"task_id": "HumanEval/63", "solution": "_memo = {}\ndef fibfib(n: int) -> int:\n    \"\"\"Computes the n-th FibFib number using memoization.\n    Base cases are fibfib(0)=0, fibfib(1)=0, fibfib(2)=1; for n>2, fibfib(n) = fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    \"\"\"\n    if n in _memo:\n        return _memo[n]\n\n    if n == 0:\n        result = 0\n    elif n == 1:\n        result = 0\n    elif n == 2:\n        result = 1\n    else:\n        result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n\n    _memo[n] = result\n    return result"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a non-negative decimal integer to its binary string representation.\n    The output string is formatted with \"db\" prefixes and suffixes.\n    \"\"\"\n    binary_representation = bin(decimal)\n    binary_string_without_prefix = binary_representation[2:]\n    return \"db\" + binary_string_without_prefix + \"db\""}
