{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Converts a positive integer (1-1000) to its lowercase Roman numeral equivalent.\n    Assumes valid input within the specified range.\n    \"\"\"\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    result_roman = []\n    num_to_convert = number\n    for value, symbol in roman_map:\n        while num_to_convert >= value:\n            result_roman.append(symbol)\n            num_to_convert -= value\n\n    uppercase_roman = \"\".join(result_roman)\n    return uppercase_roman.lower()"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the single-digit even numbers\n    between a and b (inclusive), in ascending order.\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    identified_even_digits = []\n    # Define the set of target single-digit even numbers for efficient lookup.\n    single_digit_evens = {0, 2, 4, 6, 8}\n\n    for num in range(min_val, max_val + 1):\n        if num in single_digit_evens:\n            identified_even_digits.append(num)\n\n    # Sort the identified numbers in ascending order as required by FR5.\n    identified_even_digits.sort()\n\n    return identified_even_digits"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    \"\"\"\n    Checks if three given side lengths form a right-angled triangle.\n    It applies the Pythagorean theorem with a small tolerance for float comparison.\n    \"\"\"\n    epsilon = 1e-9\n\n    # Square the sides to prepare for the Pythagorean theorem\n    a_sq = a * a\n    b_sq = b * b\n    c_sq = c * c\n\n    # Check all three possible permutations where one side could be the hypotenuse\n    if abs(a_sq + b_sq - c_sq) < epsilon:\n        return True\n    if abs(a_sq + c_sq - b_sq) < epsilon:\n        return True\n    if abs(b_sq + c_sq - a_sq) < epsilon:\n        return True\n\n    return False"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    result = []\n    even_single_digits = [0, 2, 4, 6, 8]\n\n    for digit in even_single_digits:\n        if min_val <= digit <= max_val:\n            result.append(digit)\n\n    return result"}
{"task_id": "HumanEval/129", "solution": "from typing import List, Optional\nclass ValidationError(Exception):\n    \"\"\"Custom exception for input validation failures.\"\"\"\n    pass\nclass Cell:\n    \"\"\"Stores the coordinates and value of a grid cell.\"\"\"\n    def __init__(self, row: int, col: int, value: int):\n        self.row = row\n        self.col = col\n        self.value = value\n\n    def __eq__(self, other) -> bool:\n        \"\"\"Compares two cells for equality based on coordinates.\"\"\"\n        if not isinstance(other, Cell):\n            return NotImplemented\n        return self.row == other.row and self.col == other.col\n\n    def __hash__(self) -> int:\n        \"\"\"Enables Cell objects to be used in sets/dictionaries.\"\"\"\n        return hash((self.row, self.col))\nclass Grid:\n    \"\"\"Manages the grid structure and provides access to cells.\"\"\"\n    def __init__(self, grid_data: List[List[int]]):\n        self.N = len(grid_data)\n        self._grid_data: List[List[Cell]] = []\n        for r_idx, row_values in enumerate(grid_data):\n            cell_row = [Cell(r_idx, c_idx, value) for c_idx, value in enumerate(row_values)]\n            self._grid_data.append(cell_row)\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        \"\"\"Returns the Cell object at the given coordinates.\"\"\"\n        return self._grid_data[row][col]\n\n    def is_valid_coordinate(self, row: int, col: int) -> bool:\n        \"\"\"Checks if the given coordinates are within grid boundaries.\"\"\"\n        return 0 <= row < self.N and 0 <= col < self.N\nclass Path:\n    \"\"\"Represents a path of k cells and provides lexicographical comparison.\"\"\"\n    def __init__(self, length_k: int, initial_cell: Optional[Cell] = None):\n        self.cells: List[Cell] = []\n        self.values: List[int] = []\n        self.lengthK: int = length_k\n        if initial_cell:\n            self.add_cell(initial_cell)\n\n    def add_cell(self, cell: Cell):\n        \"\"\"Adds a cell to the path, appending its value.\"\"\"\n        self.cells.append(cell)\n        self.values.append(cell.value)\n\n    def remove_last_cell(self):\n        \"\"\"Removes the last cell and its value from the path.\"\"\"\n        if self.cells:\n            self.cells.pop()\n            self.values.pop()\n\n    def is_complete(self) -> bool:\n        \"\"\"Checks if the path has reached the required lengthK.\"\"\"\n        return len(self.cells) == self.lengthK\n\n    def __lt__(self, other) -> bool:\n        \"\"\"Implements lexicographical comparison for Path objects.\"\"\"\n        if not isinstance(other, Path):\n            return NotImplemented\n        return self.values < other.values\ndef validate_grid_dimensions(grid_data: List[List[int]]) -> int:\n    \"\"\"Validates if grid_data is an N x N matrix with N >= 2.\"\"\"\n    N = len(grid_data)\n    if N < 2:\n        raise ValidationError(\"Grid must be N x N with N >= 2.\")\n    for row in grid_data:\n        if len(row) != N:\n            raise ValidationError(\"Grid is not an N x N matrix.\")\n    return N\ndef _dfs(current_cell: Cell, current_path: Path, grid: Grid, k: int, min_path_values: List[int]):\n    \"\"\"Recursive helper for depth-first search to explore paths.\"\"\"\n    \n    # Base case: Path is complete\n    if current_path.is_complete():\n        if not min_path_values or current_path.values < min_path_values:\n            min_path_values[:] = current_path.values # Update in-place\n        return\n\n    # Explore neighbors\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n    for dr, dc in directions:\n        next_row, next_col = current_cell.row + dr, current_cell.col + dc\n        if grid.is_valid_coordinate(next_row, next_col):\n            next_cell = grid.get_cell(next_row, next_col)\n            \n            current_path.add_cell(next_cell)\n            _dfs(next_cell, current_path, grid, k, min_path_values)\n            current_path.remove_last_cell() # Backtrack\ndef find_minimum_path_helper(grid: Grid, k: int) -> List[int]:\n    \"\"\"Finds the lexicographically minimum path of length k in the grid.\"\"\"\n    min_path_values: List[int] = [float('inf')] * k # Initialize with values guaranteed to be greater\n\n    # Iterate through all possible starting cells\n    for r in range(grid.N):\n        for c in range(grid.N):\n            start_cell = grid.get_cell(r, c)\n            current_path = Path(k, initial_cell=start_cell)\n            _dfs(start_cell, current_path, grid, k, min_path_values)\n            \n    return min_path_values\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n    N = validate_grid_dimensions(grid)\n    validate_grid_values(grid, N)\n    validate_k(k)\n\n    grid_obj = Grid(grid)\n    min_path = find_minimum_path_helper(grid_obj, k)\n    \n    return min_path"}
