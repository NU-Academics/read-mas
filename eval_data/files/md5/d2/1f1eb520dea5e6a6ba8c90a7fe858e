{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"Checks if a string is \"happy\" according to specific criteria.\n    A string is happy if its length is at least 3 and every 3 consecutive characters are distinct.\"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        # Get three consecutive characters\n        c1 = s[i]\n        c2 = s[i+1]\n        c3 = s[i+2]\n\n        # Check if they are distinct\n        if c1 == c2 or c1 == c3 or c2 == c3:\n            return False\n\n    return True"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"It converts a list of GPAs to letter grades based on a predefined scale.\n    It iterates through GPAs and applies a specific grading logic.\n    \"\"\"\n\n    def _get_letter_grade(gpa: float) -> str:\n        \"\"\"Converts a single GPA to its corresponding letter grade.\"\"\"\n        if gpa == 4.0:\n            return 'A+'\n        elif gpa > 3.7:\n            return 'A'\n        elif gpa > 3.3:\n            return 'A-'\n        elif gpa > 3.0:\n            return 'B+'\n        elif gpa > 2.7:\n            return 'B'\n        elif gpa > 2.3:\n            return 'B-'\n        elif gpa > 2.0:\n            return 'C+'\n        elif gpa > 1.7:\n            return 'C'\n        elif gpa > 1.3:\n            return 'C-'\n        elif gpa > 1.0:\n            return 'D+'\n        elif gpa > 0.7:\n            return 'D'\n        elif gpa > 0.0:\n            return 'D-'\n        else:\n            return 'E'\n\n    converted_grades = []\n    for gpa_value in grades:\n        converted_grades.append(_get_letter_grade(gpa_value))\n    return converted_grades"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"\n    Checks if a string is happy based on length and distinct consecutive characters.\n    Returns True if happy, False otherwise.\n    \"\"\"\n    n = len(s)\n\n    # Return False if the length of the input string s is less than 3.\n    if n < 3:\n        return False\n\n    # Iterate through the string, examining every consecutive sequence of three characters.\n    for i in range(n - 2):\n        # Check if the three characters are distinct.\n        if s[i] == s[i+1] or s[i] == s[i+2] or s[i+1] == s[i+2]:\n            # If any 3-character sequence contains non-distinct characters, return False.\n            return False\n\n    # If the loop completes, all sequences were distinct and the length was at least 3.\n    return True"}
{"task_id": "HumanEval/82", "solution": "def _is_prime(number):\n    \"\"\"\n    Checks if a given integer is a prime number.\n    Handles edge cases for numbers less than or equal to 2 efficiently.\n    \"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n\n    # Check for divisors from 3 up to the square root of the number, incrementing by 2.\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\ndef prime_length(string):\n    \"\"\"\n    Checks if the length of the input string is a prime number.\n    Returns True if the length is prime, False otherwise.\n    \"\"\"\n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/75", "solution": "def _is_prime(n: int) -> bool:\n    \"\"\"Checks if a given integer n is a prime number.\n    Returns True if n is prime, False otherwise.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    d = 3\n    while d * d <= n:\n        if n % d == 0:\n            return False\n        d += 2\n    return True\ndef _get_prime_factors(n: int) -> list[int]:\n    \"\"\"Finds all prime factors of a given integer n, including multiplicity.\n    Each potential factor is checked for primality as per design.\n    \"\"\"\n    factors = []\n    temp_n = n\n    d = 2\n    while d * d <= temp_n:\n        if _is_prime(d):\n            while temp_n % d == 0:\n                factors.append(d)\n                temp_n //= d\n        d += 1\n    if temp_n > 1:\n        factors.append(temp_n)\n    return factors\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"Determines if the number 'a' is a product of exactly three prime numbers.\n    The input 'a' must be less than 100.\n    \"\"\"\n    if a >= 100:\n        return False\n\n    prime_factors = _get_prime_factors(a)\n    return len(prime_factors) == 3"}
{"task_id": "HumanEval/76", "solution": "import math\ndef is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n (i.e., x = n**k for some integer k).\n    This function handles various edge cases including zero, one, and negative bases.\n    \"\"\"\n    epsilon = 1e-9\n\n    if abs(n) < epsilon:  # Handle n = 0\n        return abs(x) < epsilon\n    if abs(n - 1) < epsilon:  # Handle n = 1\n        return abs(x - 1) < epsilon\n    if abs(n + 1) < epsilon:  # Handle n = -1\n        return abs(x - 1) < epsilon or abs(x + 1) < epsilon\n\n    if abs(x - 1) < epsilon:  # Handle x = 1 (n**0 = 1 for valid n)\n        return True\n    if abs(x) < epsilon:  # Handle x = 0 (only possible if n=0, already handled)\n        return False\n\n    if n > 0:\n        if x < 0:  # Positive base cannot yield negative result\n            return False\n        # For positive x and n, calculate k = log_n(x).\n        k = math.log(x, n)\n        return abs(k - round(k)) < epsilon\n    else:  # n < 0 (n is not -1)\n        temp_x = abs(x)\n        temp_n = abs(n)\n        # Calculate k_abs such that abs(x) = abs(n)**k_abs.\n        k_abs = math.log(temp_x, temp_n)\n\n        if abs(k_abs - round(k_abs)) < epsilon:\n            k_int = round(k_abs)\n            # Check sign based on k's parity: even k for x>0, odd k for x<0.\n            if k_int % 2 == 0:\n                return x > 0\n            else:\n                return x < 0\n        return False"}
{"task_id": "HumanEval/82", "solution": "def _is_prime(n: int) -> bool:\n    \"\"\"Checks if an integer is a prime number.\n    Handles edge cases for 1, 2, and even numbers, then iterates through odd divisors.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for odd divisors from 3 up to the square root of n\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\ndef prime_length(string: str) -> bool:\n    \"\"\"Checks if the length of a string is a prime number.\n    It computes the string's length and then verifies its primality.\"\"\"\n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n: int) -> int:\n    \"\"\"\n    Given a positive integer n, return the count of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n\n    # Apply the principle of inclusion-exclusion for n > 1.\n    starts_with_1 = 10**(n - 1)\n    ends_with_1 = 9 * (10**(n - 2))\n    starts_and_ends_with_1 = 10**(n - 2)\n\n    return starts_with_1 + ends_with_1 - starts_and_ends_with_1"}
