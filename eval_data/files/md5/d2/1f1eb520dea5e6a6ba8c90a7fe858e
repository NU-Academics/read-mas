{"task_id": "HumanEval/14", "solution": "from typing import List\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string.\n    An empty string input results in an empty list output.\n    \"\"\"\n    if not string:\n        return []\n\n    prefixes = []\n    for i in range(1, len(string) + 1):\n        prefixes.append(string[:i])\n    return prefixes"}
{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    lower_cased_string = string.lower()\n    distinct_chars = set(lower_cased_string)\n    return len(distinct_chars)"}
{"task_id": "HumanEval/17", "solution": "from typing import List\n_NOTE_BEAT_MAPPING = {\n    'o': 4,\n    'o|': 2,\n    '.|': 1\n}\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n\n    Here is a legend:\n    'o' - whole note, lasts four beats\n    'o|' - half note, lasts two beats\n    '.|' - quater note, lasts one beat\n\n    >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    \"\"\"\n    cleaned_string = music_string.strip()\n    note_symbols = cleaned_string.split(' ')\n\n    beat_durations = []\n    for symbol in note_symbols:\n        # Look up the beat duration for each note symbol.\n        beat_durations.append(_NOTE_BEAT_MAPPING[symbol])\n\n    return beat_durations"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\"Find how many times a given substring can be found in the original string, counting overlapping cases.\"\"\"\n    if not string or not substring:\n        return 0\n\n    count = 0\n    start_index = 0\n    while True:\n        found_index = string.find(substring, start_index)\n        if found_index != -1:\n            count += 1\n            start_index = found_index + 1\n        else:\n            break\n    return count"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlaping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n    count = 0\n    len_s = len(string)\n    len_sub = len(substring)\n\n    # Iterate through the main string to find all possible starting positions for the substring.\n    # The loop considers overlapping occurrences by advancing one character at a time.\n    for i in range(len_s - len_sub + 1):\n        if string[i : i + len_sub] == substring:\n            count += 1\n    return count"}
{"task_id": "HumanEval/17", "solution": "from typing import List\n_NOTE_MAPPINGS = {'o': 4, 'o|': 2, '.|': 1}\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"Parses a string representing musical notes in a special ASCII format and returns a list of integers\n    corresponding to how many beats each note lasts.\n    \"\"\"\n    result_list = []\n    note_symbols = music_string.split(' ')\n    for symbol in note_symbols:\n        result_list.append(_NOTE_MAPPINGS[symbol])\n    return result_list"}
{"task_id": "HumanEval/19", "solution": "from typing import List\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    class Mapper:\n        \"\"\"Handles mapping between number words and integers.\"\"\"\n        _word_to_int_map = {\n            'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n            'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n        }\n        _int_to_word_map = {\n            0: 'zero', 1: 'one', 2: 'two', 3: 'three', 4: 'four',\n            5: 'five', 6: 'six', 7: 'seven', 8: 'eight', 9: 'nine'\n        }\n\n        def word_to_int(self, word: str) -> int:\n            \"\"\"Converts a number word to its integer equivalent.\"\"\"\n            return self._word_to_int_map[word]\n\n        def int_to_word(self, value: int) -> str:\n            \"\"\"Converts an integer to its number word representation.\"\"\"\n            return self._int_to_word_map[value]\n\n        def is_valid_word(self, word: str) -> bool:\n            \"\"\"Checks if a word is a valid number word (zero to nine).\"\"\"\n            return word in self._word_to_int_map\n\n\n    class Parser:\n        \"\"\"Parses the input string into a list of number words.\"\"\"\n        def __init__(self, mapper: Mapper):\n            self._mapper = mapper\n\n        def parse(self, input_string: str) -> List[str]:\n            \"\"\"Splits the input string and validates each word.\"\"\"\n            words = input_string.split(' ')\n            for word in words:\n                if not self._mapper.is_valid_word(word):\n                    raise ValueError(f\"Invalid number word: {word}\")\n            return words\n\n\n    class Formatter:\n        \"\"\"Formats a list of words into a space-delimited string.\"\"\"\n        def format(self, words: List[str]) -> str:\n            \"\"\"Joins a list of words into a single space-delimited string.\"\"\"\n            return ' '.join(words)\n\n    mapper = Mapper()\n    parser = Parser(mapper)\n    formatter = Formatter()\n\n    word_list = parser.parse(numbers)\n\n    integer_list = [mapper.word_to_int(word) for word in word_list]\n\n    sorted_integer_list = sorted(integer_list)\n\n    sorted_word_list = [mapper.int_to_word(value) for value in sorted_integer_list]"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/19", "solution": "from typing import List\n_word_to_num_map = {\n    'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n    'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n}\n_num_to_word_map = {\n    0: 'zero', 1: 'one', 2: 'two', 3: 'three', 4: 'four',\n    5: 'five', 6: 'six', 7: 'seven', 8: 'eight', 9: 'nine'\n}\ndef _parse_input(input_str: str) -> List[str]:\n    \"\"\"Splits the input string by spaces into a list of words.\"\"\"\n    return input_str.split(' ')\ndef _validate_and_map_to_nums(words: List[str]) -> List[int]:\n    \"\"\"Converts valid numeral words to their integer values.\"\"\"\n    numerical_values = []\n    for word in words:\n        if word in _word_to_num_map:\n            numerical_values.append(_word_to_num_map[word])\n    return numerical_values\ndef _sort_numbers_list(nums: List[int]) -> List[int]:\n    \"\"\"Sorts a list of integer numerical values in ascending order.\"\"\"\n    return sorted(nums)\ndef _map_nums_to_words(nums: List[int]) -> List[str]:\n    \"\"\"Converts a list of integer values back to numeral words.\"\"\"\n    word_list = []\n    for num in nums:\n        word_list.append(_num_to_word_map[num])\n    return word_list\ndef _format_output(words: List[str]) -> str:\n    \"\"\"Joins a list of words into a space-delimited string.\"\"\"\n    return ' '.join(words)\ndef sort_numbers(numbers: str) -> str:\n    \"\"\"Input is a space-delimited string of numerals from 'zero' to 'nine'.\n    Returns the string with numbers sorted from smallest to largest.\n    \"\"\"\n    parsed_words = _parse_input(numbers)\n    numerical_values = _validate_and_map_to_nums(parsed_words)\n    sorted_numerical_values = _sort_numbers_list(numerical_values)\n    sorted_numeral_words = _map_nums_to_words(sorted_numerical_values)\n    output_string = _format_output(sorted_numeral_words)\n\n    return output_string"}
