{"task_id": "HumanEval/25", "solution": "from typing import List\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    factors = []\n\n    # Factor out all occurrences of 2\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Iterate through odd numbers starting from 3 up to the square root of n\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            factors.append(i)\n            n //= i\n        i += 2  # Move to the next odd number\n\n    # If n is still greater than 1, it must be a prime factor itself\n    if n > 1:\n        factors.append(n)\n\n    return factors"}
{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\"\n    Finds the largest divisor of `n` strictly less than `n`.\n    Returns 1 if `n` is prime or `n <= 1`.\n    \"\"\"\n    if n <= 1:\n        # Handles edge cases for n <= 1, where the largest divisor strictly less than n is 1 by definition.\n        return 1\n\n    for i in range(n - 1, 0, -1):\n        if n % i == 0:\n            return i\n    return 1 # This is reached only if n is a prime number."}
{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\"Counts distinct characters in a string, case-insensitively.\n    It converts each character to lowercase and adds to a set, then returns the set's size.\n    \"\"\"\n    distinct_chars = set()\n    for char in string:\n        distinct_chars.add(char.lower())\n    return len(distinct_chars)"}
{"task_id": "HumanEval/25", "solution": "from typing import List\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    \"\"\"\n    factors = []\n\n    if n <= 1:\n        return factors\n\n    d = 2\n    while d * d <= n:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 1\n\n    if n > 1:\n        factors.append(n)\n\n    return factors"}
{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\"\n    For a given number n, find the largest number that divides n evenly, smaller than n.\n    Returns 0 if no such divisor exists (e.g., for n=1).\n    \"\"\"\n    if n == 1:\n        return 0\n    for i in range(n - 1, 0, -1):\n        if n % i == 0:\n            return i\n    return 0"}
