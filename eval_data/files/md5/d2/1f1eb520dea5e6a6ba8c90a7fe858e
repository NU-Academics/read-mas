{"task_id": "HumanEval/36", "solution": "def _is_divisible(num: int, divisor: int) -> bool:\n    \"\"\"Checks if a number is perfectly divisible by a divisor.\"\"\"\n    return num % divisor == 0\ndef _is_fizzbuzz_candidate(num: int) -> bool:\n    \"\"\"Determines if a number is divisible by 11 or 13.\"\"\"\n    return _is_divisible(num, 11) or _is_divisible(num, 13)\ndef _count_digit(num: int, digit: int) -> int:\n    \"\"\"Counts occurrences of a specific digit in a number.\"\"\"\n    return str(num).count(str(digit))\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n):\n        if _is_fizzbuzz_candidate(i):\n            total_sum += _count_digit(i, 7)\n    return total_sum"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\"\"\"\n    total_seven_count = 0\n    for i in range(1, n):\n        if i % 11 == 0 or i % 13 == 0:\n            total_seven_count += str(i).count('7')\n    return total_seven_count"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n\n    def _fibonacci_generator():\n        \"\"\"Generates Fibonacci numbers indefinitely.\"\"\"\n        a, b = 0, 1\n        while True:\n            yield a\n            a, b = b, a + b\n\n    def _is_prime(num: int):\n        \"\"\"Checks if a given number is prime.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    prime_fib_count = 0\n    fib_gen = _fibonacci_generator()\n\n    while True:\n        current_fib = next(fib_gen)\n        if _is_prime(current_fib):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return current_fib"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function sorts elements at even indices of a list in ascending order.\n    Odd-indexed elements remain in their original positions.\n    \"\"\"\n    l_prime = list(l)  # Initialize l' as a copy of the input list l.\n    even_values = []\n\n    # Extract all values from even indices.\n    for i in range(len(l)):\n        if i % 2 == 0:  # Check if index is even\n            even_values.append(l[i])\n\n    even_values.sort()  # Sort the extracted even-indexed values in ascending order.\n\n    # Place the sorted values back into the corresponding even indices of l'.\n    sorted_idx_counter = 0\n    for i in range(len(l_prime)):\n        if i % 2 == 0:  # Check if index is even\n            l_prime[i] = even_values[sorted_idx_counter]\n            sorted_idx_counter += 1\n\n    return l_prime"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"This function sorts elements at even indices of an input list while preserving elements at odd indices.\n    It returns a new list with these modifications.\"\"\"\n\n    l_prime = list(l) # Create a mutable copy of the input list for the output.\n\n    even_values = []\n    # Collect all elements from even indices of the input list.\n    for i in range(len(l)):\n        if i % 2 == 0:\n            even_values.append(l[i])\n\n    # Sort the collected even-indexed values in ascending order.\n    sorted_even_values = sorted(even_values)\n\n    even_values_ptr = 0\n    # Iterate through the copied list and replace elements at even indices with the sorted values.\n    for i in range(len(l_prime)):\n        if i % 2 == 0:\n            l_prime[i] = sorted_even_values[even_values_ptr]\n            even_values_ptr += 1\n\n    return l_prime"}
{"task_id": "HumanEval/38", "solution": "def _split_into_groups(s: str, group_size: int) -> list[str]:\n    \"\"\"Splits a string into chunks of a specified size.\n    It handles remaining characters as a smaller last group.\n    \"\"\"\n    return [s[(group_size * i):min((group_size * i + group_size), len(s))]\n            for i in range((len(s) + group_size - 1) // group_size)]\ndef _reverse_cyclic_shift(group: str) -> str:\n    \"\"\"Reverses the cyclic shift for a three-character group.\n    Example: 'bca' becomes 'abc'.\n    \"\"\"\n    return group[-1] + group[:-1]\ndef decode_cyclic(s: str):\n    \"\"\"Decodes a cyclically encoded string by reversing the cyclic shift for three-character groups.\n    Groups with fewer than three characters are left unchanged.\n    \"\"\"\n    group_size = 3\n    groups = _split_into_groups(s, group_size)\n\n    decoded_groups = []\n    for group in groups:\n        if len(group) == group_size:\n            decoded_groups.append(_reverse_cyclic_shift(group))\n        else:\n            decoded_groups.append(group)\n\n    return \"\".join(decoded_groups)"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    Decodes a string that was cyclically encoded in blocks of three characters.\n    It applies specific transformations for 3, 2, or 1 character blocks as described in the design.\n    \"\"\"\n    decoded_parts = []\n    n = len(s)\n    for i in range(0, n, 3):\n        block = s[i:i+3]\n        if len(block) == 3:\n            # Transform [e1, e2, e3] to [e3, e1, e2]\n            decoded_parts.append(block[2] + block[0] + block[1])\n        elif len(block) == 2:\n            # Transform [e1, e2] to [e2, e1]\n            decoded_parts.append(block[1] + block[0])\n        else: # len(block) == 1\n            # Transform [e1] to [e1]\n            decoded_parts.append(block[0])\n    return \"\".join(decoded_parts)"}
{"task_id": "HumanEval/39", "solution": "import math\ndef is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime using an optimized trial division method.\"\"\"\n    if num <= 1:\n        return False\n    if num <= 3:\n        return True\n    if num % 2 == 0 or num % 3 == 0:\n        return False\n    i = 5\n    while i * i <= num:\n        if num % i == 0 or num % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef prime_fib(n: int):\n    \"\"\"Returns the n-th number that is both a Fibonacci number and a prime number.\"\"\"\n    count = 0\n    fib_a = 0\n    fib_b = 1\n\n    while True:\n        current_fib = fib_a\n\n        # Generate the next Fibonacci number for the subsequent iteration.\n        fib_a, fib_b = fib_b, fib_a + fib_b\n\n        if current_fib <= 1: # 0 and 1 are not prime numbers.\n            continue\n\n        if is_prime(current_fib):\n            count += 1\n            if count == n:\n                return current_fib"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"Checks if there are three distinct elements in list 'l' that sum to zero.\n    Returns True if such a triplet is found, False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    # Iterate through all combinations of three distinct indices (i, j, k).\n    # Return True if their corresponding elements sum to zero.\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n    return False"}
