{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"\n    Detects if a bank account's balance falls below zero during a sequence of operations.\n    Starts with a zero balance and returns True if it ever becomes negative, False otherwise.\n    \"\"\"\n    balance = 0\n\n    for operation_value in operations:\n        balance += operation_value\n        if balance < 0:\n            return True\n\n    return False"}
{"task_id": "HumanEval/2", "solution": "import math\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    \"\"\"\n    integer_part = math.floor(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"Detects if a bank account balance, starting at zero, ever drops below zero after a series of operations.\n    Returns True immediately if the balance becomes negative, otherwise False after all operations.\"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"Check if in given list of numbers, any two numbers are closer to each other than the\n    given threshold. Iterates through all unique pairs to find if their absolute difference\n    is less than the threshold.\n    \"\"\"\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    integer_part = int(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates a string into balanced, non-nested parenthesis groups.\n    Spaces are ignored, and each group is properly closed and extracted.\n    \"\"\"\n\n    cleaned_string = \"\".join(char for char in paren_string if char != ' ')\n    groups = []\n    balance = 0\n    current_group_start_index = -1\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            if balance == 0:  # Mark the start of a new top-level group\n                current_group_start_index = i\n            balance += 1\n        elif char == ')':\n            balance -= 1\n            # If balance is 0, a top-level group has just closed\n            if balance == 0 and current_group_start_index != -1:\n                groups.append(cleaned_string[current_group_start_index : i + 1])\n                current_group_start_index = -1  # Reset for the next group\n\n    return groups"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"Checks if any two numbers in the list are closer than the given threshold.\n    It iterates through all unique pairs to find if their absolute difference is less than the threshold.\"\"\"\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"\n    Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    \"\"\"\n    cleaned_string = paren_string.replace(\" \", \"\")\n\n    result_list: List[str] = []\n    balance_counter: int = 0\n    current_group_start_index: int = -1\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            if balance_counter == 0:\n                current_group_start_index = i\n            balance_counter += 1\n        elif char == ')':\n            balance_counter -= 1\n            if balance_counter == 0 and current_group_start_index != -1:\n                extracted_group = cleaned_string[current_group_start_index : i + 1]\n                result_list.append(extracted_group)\n                current_group_start_index = -1\n\n    return result_list"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    # Calculate the arithmetic mean of the input numbers.\n    mean_value = sum(numbers) / len(numbers)\n\n    # Calculate the absolute difference between each number and the mean.\n    absolute_differences = [abs(num - mean_value) for num in numbers]\n\n    # Calculate the average of these absolute differences.\n    mad_value = sum(absolute_differences) / len(absolute_differences)\n\n    return mad_value"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"\n    Inserts a delimiter between every two consecutive elements of a list of numbers.\n    Handles empty and single-element lists as specified.\n    \"\"\"\n    if not numbers:\n        return []\n\n    if len(numbers) == 1:\n        return numbers[:]\n\n    result = []\n    result.append(numbers[0])\n\n    for i in range(1, len(numbers)):\n        result.append(delimeter)\n        result.append(numbers[i])\n\n    return result"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    if not strings:\n        return []\n\n    results_list = []\n    for current_string in strings in strings:\n        if substring in current_string:\n            results_list.append(current_string)\n\n    return results_list"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    # Calculate the mean of the input list.\n    data_mean = sum(numbers) / len(numbers)\n\n    # Compute absolute differences between each number and the mean.\n    absolute_differences = [abs(number - data_mean) for number in numbers]\n\n    # Calculate the average of these absolute differences.\n    mad_value = sum(absolute_differences) / len(absolute_differences)\n\n    return mad_value"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Calculates the deepest nesting level for groups of parentheses separated by spaces.\n    E.g. '(()()) ((())) () ((())()())' returns [2, 3, 1, 3].\n    \"\"\"\n\n    def _calculate_deepest_nesting(group_string: str) -> int:\n        \"\"\"\n        Determines the deepest nesting level within a single group of parentheses.\n        It iterates through characters, tracking current and maximum nesting levels.\n        \"\"\"\n        current_level = 0\n        max_level = 0\n        for char in group_string:\n            if char == '(':\n                current_level += 1\n                max_level = max(max_level, current_level)\n            elif char == ')':\n                current_level -= 1\n        return max_level\n\n    groups = paren_string.split()\n    results_list = []\n\n    for group_string in groups:\n        deepest_level = _calculate_deepest_nesting(group_string)\n        results_list.append(deepest_level)\n\n    return results_list"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\"Filter an input list of strings, returning only those that contain the given substring.\n    Returns an empty list if no matches are found or the input list is empty.\n    \"\"\"\n    filtered_strings = []\n    for s in strings:\n        if substring in s:\n            filtered_strings.append(s)\n    return filtered_strings"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    n = len(numbers)\n\n    if n == 0:\n        return []\n    if n == 1:\n        return numbers\n\n    result = []\n    for i in range(n):\n        result.append(numbers[i])\n        if i < n - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef _calculate_max_nesting_for_group(group_string: str) -> int:\n    \"\"\"Calculates the deepest nesting level for a single parenthesis group string.\n    It iterates through characters, tracking current and maximum nesting.\n    \"\"\"\n    current_nesting = 0\n    max_nesting = 0\n    for char in group_string:\n        if char == '(':\n            current_nesting += 1\n            max_nesting = max(max_nesting, current_nesting)\n        elif char == ')':\n            current_nesting -= 1\n    return max_nesting\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n    \"\"\"\n    results = []\n    groups = paren_string.split(' ')\n    for group in groups:\n        if group:  # Handle potential empty strings from multiple spaces\n            results.append(_calculate_max_nesting_for_group(group))\n    return results"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    current_sum = 0\n    current_product = 1\n    for num in numbers:\n        current_sum += num\n        current_product *= num\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    This function finds the longest palindromic postfix and appends the reversed prefix.\n    \"\"\"\n    if not string:\n        return \"\"\n\n    n = len(string)\n    suffix_start_index = 0\n\n    # Find the longest palindromic postfix\n    for i in range(n):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            suffix_start_index = i\n            break\n\n    # Identify the prefix that comes before the palindromic suffix\n    prefix_to_add = string[:suffix_start_index]\n\n    # Append the reversed prefix to the original string\n    return string + prefix_to_add[::-1]"}
{"task_id": "HumanEval/9", "solution": "from typing import List\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"\n    Computes the rolling maximums for a list of integers.\n    Each element in the output is the maximum value found up to that point in the input sequence.\n    \"\"\"\n    if not numbers:\n        return []\n\n    current_max = numbers[0]\n    result_list = [current_max]\n\n    for i in range(1, len(numbers)):\n        current_max = max(current_max, numbers[i])\n        result_list.append(current_max)\n\n    return result_list"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\ndef _find_longest_palindromic_postfix(string: str) -> str:\n    \"\"\" Identifies the longest palindromic postfix of a supplied string.\n    It iterates from the beginning of the string to find the longest suffix that is a palindrome.\n    \"\"\"\n    if not string:\n        return \"\"\n    for i in range(len(string)):\n        postfix = string[i:]\n        if is_palindrome(postfix):\n            return postfix\n    return \"\"\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple: find the longest palindromic postfix and append the reverse of the preceding prefix.\n    \"\"\"\n    if not string:\n        return \"\"\n\n    longest_pal_postfix = _find_longest_palindromic_postfix(string)\n\n    prefix_to_reverse_length = len(string) - len(longest_pal_postfix)\n    prefix = string[:prefix_to_reverse_length]\n\n    reversed_prefix = prefix[::-1]\n\n    return string + reversed_prefix"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\nimport math\nclass SequenceOfIntegers:\n    \"\"\"Encapsulates a list of integers and provides methods for sequence manipulation.\"\"\"\n    def __init__(self, elements: List[int]):\n        self._elements = elements\n\n    def get_element_at(self, index: int) -> int:\n        \"\"\"Returns the element at the specified index.\"\"\"\n        return self._elements[index]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the sequence.\"\"\"\n        return len(self._elements)\n\n    def calculate_rolling_maximum(self) -> 'SequenceOfIntegers':\n        \"\"\"Calculates and returns a new SequenceOfIntegers with rolling maximums.\"\"\"\n        rolling_max_list = []\n        current_max = -math.inf\n        for element in self._elements:\n            current_max = max(current_max, element)\n            rolling_max_list.append(current_max)\n        return SequenceOfIntegers(rolling_max_list)\nclass RollingMaxFacade:\n    \"\"\"Provides a simplified interface to the core rolling maximum calculation logic.\"\"\"\n    def rolling_max(self, numbers: List[int]) -> List[int]:\n        \"\"\"Calculates rolling maximums for the given list of numbers using the core logic.\"\"\"\n        input_sequence = SequenceOfIntegers(numbers)\n        rolling_max_sequence = input_sequence.calculate_rolling_maximum()\n        return rolling_max_sequence._elements\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    # This function acts as the public programmatic interface, using the defined facade.\n    facade = RollingMaxFacade()\n    return facade.rolling_max(numbers)"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n\n    def _validate_binary_string(s: str, name: str):\n        \"\"\"Validates that a string contains only '0's and '1's.\"\"\"\n        for char in s:\n            if char not in ('0', '1'):\n                raise ValueError(f\"Input '{name}' contains non-binary characters.\")\n\n    _validate_binary_string(a, 'a')\n    _validate_binary_string(b, 'b')\n\n    if len(a) != len(b):\n        raise ValueError(\"Input strings must be of equal length.\")\n\n    result_chars = []\n    for i in range(len(a)):\n        # Perform binary XOR operation on corresponding characters.\n        result_chars.append('0' if a[i] == b[i] else '1')\n\n    return \"\".join(result_chars)"}
