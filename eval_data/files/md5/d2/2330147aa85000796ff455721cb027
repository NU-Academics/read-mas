{"task_id": "HumanEval/56", "solution": "```python\ndef correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    counter = 0\n    for char in brackets:\n        if char == \"<\":\n            counter += 1\n        elif char == \">\":\n            counter -= 1\n        \n        # If a closing bracket appears before a corresponding opening bracket\n        if counter < 0:\n            return False\n            \n    # For a correctly bracketed string, the counter must be zero at the end\n    return counter == 0\n```"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n == 0:\n        return 0\n    a, b = 0, 1\n    for _ in range(1, n):\n        a, b = b, a + b\n    return b"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    length = len(l)\n    if length <= 1:\n        return True\n\n    inc = False\n    dec = False\n\n    for i in range(1, length):\n        a, b = l[i-1], l[i]\n        if a < b:\n            inc = True\n        elif a > b:\n            dec = True\n        \n        if inc and dec:\n            return False\n            \n    return True"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    # The sum of an arithmetic series from 1 to n is given by the formula n * (n + 1) / 2.\n    # Python's // operator ensures integer division, as required for a sum of integers.\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n\n    \"\"\"\n\n    def _to_unique(iterable):\n        \"\"\"Return a list of unique elements from an iterable, preserving order for first seen.\"\"\"\n        seen = set()\n        unique = []\n        for item in iterable:\n            try:\n                if item not in seen:\n                    seen.add(item)\n                    unique.append(item)\n            except TypeError:\n                # Fallback for unhashable items: linear check.\n                if item not in unique:\n                    unique.append(item)\n        return unique\n\n    def _try_hashable_partition(seq):\n        \"\"\"Partition a sequence into two lists: hashable and unhashable elements.\"\"\"\n        hashable, unhashable = [], []\n        for item in seq:\n            try:\n                hash(item)\n                hashable.append(item)\n            except TypeError:\n                unhashable.append(item)\n        return hashable, unhashable\n\n    def _sort_list(seq):\n        \"\"\"Return a sorted copy of the list.\"\"\"\n        return sorted(seq)\n\n    # Convert inputs to unique lists\n    u1 = _to_unique(l1)\n    u2 = _to_unique(l2)\n\n    # Partition unique lists into hashable and unhashable parts\n    h1, unh1 = _try_hashable_partition(u1)\n    h2, unh2 = _try_hashable_partition(u2)\n\n    common_elements = []\n\n    # Find common hashable elements using sets\n    if h1 and h2:\n        hashable_common = set(h1).intersection(set(h2))\n        common_elements.extend(list(hashable_common))\n\n    # Find common unhashable elements using pairwise comparison\n    if unh1 and unh2:\n        for item1 in unh1:\n            for item2 in unh2:\n                if item1 == item2 and item1 not in common_elements:\n                    common_elements.append(item1)\n\n    # Sort the combined list of common elements\n    final_result = _sort_list(common_elements)\n\n    return final_result"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\"\"\"\n    max_pf = -1\n\n    # Divide by 2 until n is odd\n    while n % 2 == 0:\n        max_pf = 2\n        n //= 2\n\n    # Check for odd factors from 3 up to sqrt(n)\n    f = 3\n    while f * f <= n:\n        while n % f == 0:\n            max_pf = f\n            n //= f\n        f += 2\n\n    # If n is still greater than 1, it must be the largest prime factor\n    if n > 1:\n        max_pf = n\n\n    return max_pf"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        # If balance drops below zero, a closing bracket appeared without a corresponding opening one.\n        if balance < 0:\n            return False\n    # After iterating through all characters, if balance is zero, all brackets are correctly matched.\n    return balance == 0"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    coeffs = list(xs)\n\n    # Normalize coefficients by removing trailing zeros, keeping at least one coefficient.\n    # This ensures consistent behavior for polynomials like [1, 2, 0] (1 + 2x)\n    # and constant polynomials like [3, 0, 0] (3).\n    while len(coeffs) > 1 and coeffs[-1] == 0:\n        coeffs.pop()\n\n    # If the polynomial is a constant (or reduces to one after normalization), its derivative is an empty list.\n    if len(coeffs) <= 1:\n        return []\n\n    # Calculate the derivative coefficients using the rule:\n    # The derivative of c_k * x^k is k * c_k * x^(k-1).\n    # For a coefficient list [c0, c1, c2, ...], the derivative's coefficients will be\n    # [1*c1, 2*c2, 3*c3, ...].\n    result = []\n    for i in range(len(coeffs) - 1):\n        # The new coefficient at index i corresponds to the original coefficient at index i+1\n        # multiplied by its power (which is i+1).\n        result.append(coeffs[i+1] * (i+1))\n\n    return result"}
{"task_id": "HumanEval/64", "solution": "import unicodedata\nimport string\n\ndef vowels_count(s):\n    \"\"\"Counts vowels in a word, where 'y' is a vowel only at the end of the word.\"\"\"\n\n    PUNCTUATION_CHARS = string.punctuation + \" \\t\\n\\r\"\n\n    def _normalize(text: str) -> str:\n        \"\"\"Converts text to NFKC normalized lowercase.\"\"\"\n        return unicodedata.normalize(\"NFKC\", text).lower()\n\n    def _strip_trailing_punctuation(text: str) -> str:\n        \"\"\"Removes trailing punctuation and whitespace from a string.\"\"\"\n        i = len(text)\n        while i > 0 and text[i-1] in PUNCTUATION_CHARS:\n            i -= 1\n        return text[:i]\n\n    def _last_alpha_char(text: str) -> str | None:\n        \"\"\"Returns the last alphabetic character in a string, or None if none exist.\"\"\"\n        for char in reversed(text):\n            if char.isalpha():\n                return char\n        return None\n\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    normalized_s = _normalize(s)\n    trimmed_s = _strip_trailing_punctuation(normalized_s)\n\n    count = 0\n    for char in trimmed_s:\n        if char in standard_vowels:\n            count += 1\n\n    last_char_for_y_check = _last_alpha_char(trimmed_s)\n    if last_char_for_y_check == 'y':\n        count += 1\n\n    return count"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circularly shift the digits of integer x to the right by shift.\n    If shift exceeds the number of digits, the digits are reversed.\n    \"\"\"\n    s = str(x)\n    n = len(s)\n\n    if n == 0:\n        return \"\"\n\n    if shift > n:\n        return s[::-1]\n\n    effective_shift = shift % n\n\n    if effective_shift == 0:\n        return s\n\n    return s[-effective_shift:] + s[:-effective_shift]"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"\n    Computes the n-th FibFib number using matrix exponentiation for efficiency.\n    Handles base cases for n=0, 1, 2 directly.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    class Matrix3x3:\n        \"\"\"Helper class for 3x3 matrix operations, used for matrix exponentiation.\"\"\"\n        def __init__(self, m: list[list[int]]) -> None:\n            self.m = m\n\n        @staticmethod\n        def multiply(a: \"Matrix3x3\", b: \"Matrix3x3\") -> \"Matrix3x3\":\n            res = [[0] * 3 for _ in range(3)]\n            for i in range(3):\n                for j in range(3):\n                    s = 0\n                    for k in range(3):\n                        s += a.m[i][k] * b.m[k][j]\n                    res[i][j] = s\n            return Matrix3x3(res)\n\n        @staticmethod\n        def pow(mat: \"Matrix3x3\", exponent: int) -> \"Matrix3x3\":\n            result = Matrix3x3([[1, 0, 0], [0, 1, 0], [0, 0, 1]]) # Identity matrix\n            base = mat\n            e = exponent\n            while e > 0:\n                if e & 1: # If exponent is odd\n                    result = Matrix3x3.multiply(result, base)\n                base = Matrix3x3.multiply(base, base)\n                e >>= 1 # e //= 2\n            return result\n\n        @staticmethod\n        def apply(mat: \"Matrix3x3\", state: tuple[int, int, int]) -> tuple[int, int, int]:\n            res = [0, 0, 0]\n            for i in range(3):\n                s = 0\n                for j in range(3):\n                    s += mat.m[i][j] * state[j]\n                res[i] = s\n            return tuple(res)\n\n    # Transformation matrix for FibFib sequence:\n    # [f(k+1), f(k), f(k-1)] = T * [f(k), f(k-1), f(k-2)]\n    # f(k+1) = f(k) + f(k-1) + f(k-2)\n    # f(k)   = f(k)\n    # f(k-1) = f(k-1)\n    transformation_matrix = Matrix3x3([\n        [1, 1, 1],\n        [1, 0, 0],\n        [0, 1, 0]\n    ])\n\n    # Initial state vector for n=2: [f(2), f(1), f(0)]\n    initial_state = (1, 0, 0)\n\n    # To find fibfib(n), we need to apply the transformation (n-2) times\n    # to the initial state S_2. This means calculating T^(n-2).\n    exponent = n - 2\n    powered_matrix = Matrix3x3.pow(transformation_matrix, exponent)\n\n    # Apply the powered matrix to the initial state vector\n    final_state = Matrix3x3.apply(powered_matrix, initial_state)\n\n    # The first element of the final state vector is fibfib(n)\n    return final_state[0]"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Task\n    Write a function that takes a string as input and returns the sum of the upper characters only'\n    ASCII codes.\n\n    Examples:\n        digitSum(\"\") => 0\n        digitSum(\"abAB\") => 131\n        digitSum(\"abcCd\") => 67\n        digitSum(\"helloE\") => 69\n        digitSum(\"woArBld\") => 131\n        digitSum(\"aAaaaXa\") => 153\n    \"\"\"\n    total_sum = 0\n    for char_code in s:\n        if 'A' <= char_code <= 'Z':\n            total_sum += ord(char_code)\n    return total_sum"}
{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given a string describing\n    apples and oranges, and the total number of fruits.\n    \"\"\"\n    import re\n\n    def normalize_whitespace(text: str) -> str:\n        \"\"\"Removes extra whitespace and strips the string.\"\"\"\n        return re.sub(r\"\\s+\", \" \", text).strip()\n\n    def extract_int(token: str) -> int:\n        \"\"\"Converts a string token to an integer.\"\"\"\n        return int(token)\n\n    normalized_s = normalize_whitespace(s).lower()\n\n    apples = 0\n    oranges = 0\n\n    # Find numbers followed by 'apple' or 'apples'\n    match_apples = re.search(r'(\\d+)\\s*apples?', normalized_s)\n    if match_apples:\n        apples = extract_int(match_apples.group(1))\n\n    # Find numbers followed by 'orange' or 'oranges'\n    match_oranges = re.search(r'(\\d+)\\s*oranges?', normalized_s)\n    if match_oranges:\n        oranges = extract_int(match_oranges.group(1))\n\n    # Calculate the number of mango fruits\n    mango = n - apples - oranges\n    return mango"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\n\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    '''\n    \n    # Count the frequency of each integer in the list.\n    freqs = Counter(lst)\n\n    candidates = []\n    # Iterate through the unique numbers and their frequencies.\n    for val, freq in freqs.items():\n        # Check if the number is positive and its frequency is greater than or equal to its value.\n        if val > 0 and freq >= val:\n            candidates.append(val)\n    \n    # If there are no such candidates, return -1.\n    if not candidates:\n        return -1\n    else:\n        # Otherwise, return the greatest among the candidate numbers.\n        return max(candidates)"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    \n    if not lst:\n        return []\n\n    sorted_items = sorted(lst)\n    result = []\n    left, right = 0, len(sorted_items) - 1\n    toggle_min = True\n\n    while left <= right:\n        if toggle_min:\n            result.append(sorted_items[left])\n            left += 1\n        else:\n            result.append(sorted_items[right])\n            right -= 1\n        toggle_min = not toggle_min\n            \n    return result"}
{"task_id": "HumanEval/68", "solution": "class PluckResult:\n    \"\"\"A simple DTO representing a plucked node.\"\"\"\n    def __init__(self, value: int, index: int) -> None:\n        self.value = value\n        self.index = index\n    def to_list(self) -> list:\n        return [self.value, self.index]\n\nclass ArrayValidator:\n    \"\"\"Utility for finding the smallest even value and its index.\"\"\"\n    def is_even(self, value: int) -> bool:\n        return (value % 2) == 0\n    def find_smallest_even(self, arr):\n        \"\"\"Finds the smallest even value and its first index in the array.\"\"\"\n        best_value = None\n        best_index = -1\n        for i, v in enumerate(arr):\n            if self.is_even(v):\n                if best_value is None or v < best_value:\n                    best_value = v\n                    best_index = i\n        return (best_value, best_index) if best_value is not None else None\n\nclass InMemoryArrayRepository:\n    \"\"\"An in-memory repository for storing arrays, acting as a no-op for this pluck operation.\"\"\"\n    def __init__(self) -> None:\n        pass\n    def save(self, arr) -> None:\n        pass\n\nclass PluckService:\n    \"\"\"Orchestrates the core pluck logic using a validator and repository.\"\"\"\n    def __init__(self, repo=None, validator=None) -> None:\n        self.repo = repo or InMemoryArrayRepository()\n        self.validator = validator or ArrayValidator()\n    def pluck(self, arr) -> PluckResult | None:\n        found = self.validator.find_smallest_even(arr)\n        if found is None:\n            return None\n        value, index = found\n        result = PluckResult(value, index)\n        self.repo.save(arr) # Repository save is optional for core logic, here it's a no-op.\n        return result\n\nclass PluckController:\n    \"\"\"Adapts the PluckService result to the required list format.\"\"\"\n    def __init__(self, service):\n        self.service = service\n    def run(self, arr):\n        result = self.service.pluck(arr)\n        return [] if result is None else result.to_list()\n\ndef pluck(arr):\n    \"\"\"\n    \"Given an array representing a branch of a tree that has non-negative integer nodes\n    your task is to pluck one of the nodes and return it.\n    The plucked node should be the node with the smallest even value.\n    If multiple nodes with the same smallest even value are found return the node that has smallest index.\n\n    The plucked node should be returned in a list, [ smalest_value, its index ],\n    If there are no even values or the given array is empty, return [].\n\n    Example 1:\n        Input: [4,2,3]\n        Output: [2, 1]\n        Explanation: 2 has the smallest even value, and 2 has the smallest index.\n\n    Example 2:\n        Input: [1,2,3]\n        Output: [2, 1]\n        Explanation: 2 has the smallest even value, and 2 has the smallest index. \n\n    Example 3:\n        Input: []\n        Output: []\n    \n    Example 4:\n        Input: [5, 0, 3, 0, 4, 2]\n        Output: [0, 1]\n        Explanation: 0 is the smallest value, but  there are two zeros,\n                     so we will choose the first zero, which has the smallest index.\n\n    Constraints:\n        * 1 <= nodes.length <= 10000\n        * 0 <= node.value\n    \"\"\"\n    _default_repo = InMemoryArrayRepository()\n    _default_validator = ArrayValidator()\n    _default_service = PluckService(repo=_default_repo, validator=_default_validator)\n    _default_controller = PluckController(service=_default_service)\n\n    return _default_controller.run(arr)"}
