{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(len(sorted_numbers) - 1):\n        if abs(sorted_numbers[i+1] - sorted_numbers[i]) < threshold:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n    \"\"\"\n\n    def _tokenize_groups(input_str: str) -> List[str]:\n        # Splits the input string into groups based on whitespace.\n        # Empty input or input with only spaces results in an empty list.\n        return input_str.strip().split() if input_str.strip() else []\n\n    def _max_nesting_single_group(group: str) -> int:\n        # Calculates the maximum nesting level for a single string of parentheses.\n        # It assumes the input group is well-formed according to the problem's examples.\n        current_depth = 0\n        max_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        return max_depth\n\n    groups = _tokenize_groups(paren_string)\n    results = []\n    for group in groups:\n        results.append(_max_nesting_single_group(group))\n\n    return results"}
{"task_id": "HumanEval/3", "solution": "from typing import List, Optional\n\nclass AccountBalanceCheckResult:\n    \"\"\"DTO for the result of a balance check.\"\"\"\n    def __init__(self, result: bool, first_negative_index: Optional[int], balances: List[int]) -> None:\n        self.result = result\n        self.first_negative_index = first_negative_index\n        self.balances = balances\n\nclass BalanceCalculator:\n    \"\"\"Core algorithm for detecting if a balance falls below zero.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def check_below_zero(self, operations: List[int]) -> AccountBalanceCheckResult:\n        balances = []\n        bal = 0\n        first_neg = None\n        for i, op in enumerate(operations):\n            bal += op\n            balances.append(bal)\n            if first_neg is None and bal < 0:\n                first_neg = i\n        return AccountBalanceCheckResult(result=(first_neg is not None),\n                                         first_negative_index=first_neg,\n                                         balances=balances)\n\nclass BalanceService:\n    \"\"\"Orchestrates balance checking using BalanceCalculator.\"\"\"\n    def __init__(self) -> None:\n        self._calculator = BalanceCalculator()\n\n    def check_below_zero(self, operations: List[int]) -> AccountBalanceCheckResult:\n        return self._calculator.check_below_zero(operations)\n\n    def check_below_zero_bool(self, operations: List[int]) -> bool:\n        return self.check_below_zero(operations).result\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should be False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    svc = BalanceService()\n    return svc.check_below_zero_bool(operations)"}
{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if len(numbers) <= 1:\n        return list(numbers)\n\n    result_size = 2 * len(numbers) - 1\n    result: List[int] = [0] * result_size\n    \n    idx = 0\n    for i, num in enumerate(numbers):\n        result[idx] = num\n        idx += 1\n        if i < len(numbers) - 1:\n            result[idx] = delimeter\n            idx += 1\n            \n    return result"}
{"task_id": "HumanEval/4", "solution": "```python\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    n = len(numbers)\n    # The design context indicates that empty lists should raise a ValueError.\n    if n == 0:\n        raise ValueError(\"numbers must be non-empty\")\n\n    mean = sum(numbers) / n\n    abs_diffs = [abs(x - mean) for x in numbers]\n    return sum(abs_diffs) / n\n```"}
{"task_id": "HumanEval/14", "solution": "def all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    prefixes = []\n    for i in range(1, len(string) + 1):\n        prefixes.append(string[:i])\n    return prefixes"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n    for number in numbers:\n        total_sum += number\n        total_product *= number\n    return total_sum, total_product"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    \"\"\"\n    result = []\n    for i in range(len(a)):\n        if a[i] == b[i]:\n            result.append('0')\n        else:\n            result.append('1')\n    return \"\".join(result)"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    result: List[int] = []\n    current_max: int | None = None\n    for x in numbers:\n        if current_max is None or x > current_max:\n            current_max = x\n        result.append(current_max)\n    return result"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    def _is_palindrome_local(s: str) -> bool:\n        return s == s[::-1]\n\n    if not string:\n        return \"\"\n\n    # Find the starting index (i) of the longest palindromic suffix.\n    # This means string[i:] is a palindrome, and we want the smallest such i.\n    i = 0\n    for j in range(len(string)):\n        if _is_palindrome_local(string[j:]):\n            i = j\n            break\n    \n    # The prefix to reverse and append is string[0:i].\n    prefix_to_reverse = string[:i]\n    \n    return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Returns the longest string from a list, or the first one if multiple have the same length.\n    Returns None if the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_found_str = strings[0]\n    max_length = len(strings[0])\n\n    for s in strings[1:]:\n        current_length = len(s)\n        if current_length > max_length:\n            max_length = current_length\n            longest_found_str = s\n\n    return longest_found_str"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b.\n    Uses Euclid's iterative algorithm, handling zero and negative inputs.\n    \"\"\"\n    a, b = abs(a), abs(b)\n    if a == 0 and b == 0:\n        return 0\n    while b:\n        a, b = b, a % b\n    return a"}
