{"task_id": "HumanEval/25", "solution": "def factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    num = abs(n)\n    factors = []\n\n    # Divide by 2 until num is odd\n    while num % 2 == 0:\n        factors.append(2)\n        num //= 2\n\n    # Divide by odd numbers from 3 up to sqrt(num)\n    f = 3\n    while f * f <= num:\n        while num % f == 0:\n            factors.append(f)\n            num //= f\n        f += 2\n\n    # If num is still greater than 1, it must be a prime factor itself\n    if num > 1:\n        factors.append(num)\n\n    return factors"}
{"task_id": "HumanEval/29", "solution": "def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    The filtering is case-sensitive, does not strip whitespace, and ignores empty strings by default.\n    \"\"\"\n    \n    result: List[str] = []\n    for item in strings:\n        # Default behavior: ignore empty strings in input\n        if item == \"\":\n            continue\n        \n        # Default behavior: case-sensitive matching, no whitespace stripping\n        if item.startswith(prefix):\n            result.append(item)\n            \n    return result"}
{"task_id": "HumanEval/30", "solution": "def get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\"\"\"\n    positives = []\n    for item in l:\n        coerced_value = None\n        if isinstance(item, int):\n            coerced_value = item\n        elif isinstance(item, float):\n            if item.is_integer():\n                coerced_value = int(item)\n        elif isinstance(item, str):\n            try:\n                coerced_value = int(item)\n            except ValueError:\n                try:\n                    float_val = float(item)\n                    if float_val.is_integer():\n                        coerced_value = int(float_val)\n                except ValueError:\n                    pass # String is not an int or integral float, ignore\n        \n        if coerced_value is not None and coerced_value > 0:\n            positives.append(coerced_value)\n    return positives"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    # Check for factors from 3 up to the square root of n, incrementing by 2\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    from typing import Any, Iterable, Optional, Callable\n\n    class EmptySequenceError(Exception):\n        \"\"\"Exception raised when an empty sequence is provided.\"\"\"\n        def __init__(self, message: str = \"sequence is empty\") -> None:\n            super().__init__(message)\n            self.message = message\n\n    class KeyEvaluationError(Exception):\n        \"\"\"Exception raised when the key function fails.\"\"\"\n        def __init__(self, original_exception: Exception, item: Any) -> None:\n            super().__init__(f\"Key evaluation failed for item {item!r}: {original_exception}\")\n            self.original_exception = original_exception\n            self.item = item\n\n    class MaxResult:\n        \"\"\"A data transfer object for the maximum element.\"\"\"\n        def __init__(self, value: Any) -> None:\n            self.value = value\n\n    class MaxFinder:\n        \"\"\"Implements the core algorithm to find the maximum element.\"\"\"\n        def find_max(self, iterable: Iterable[Any], key: Optional[Callable[[Any], Any]] = None) -> Any:\n            it = iter(iterable)\n            try:\n                best_item = next(it)\n            except StopIteration:\n                raise EmptySequenceError()\n\n            try:\n                best_key = self._apply_key(best_item, key)\n            except Exception as exc:\n                raise KeyEvaluationError(exc, best_item)\n\n            for item in it:\n                try:\n                    k = self._apply_key(item, key)\n                except Exception as exc:\n                    raise KeyEvaluationError(exc, item)\n                if k > best_key:\n                    best_key = k\n                    best_item = item\n            return best_item\n\n        def _apply_key(self, item: Any, key: Optional[Callable[[Any], Any]]) -> Any:\n            \"\"\"Applies the key function to an item, or returns the item itself.\"\"\"\n            return key(item) if key is not None else item\n\n    class MaxElementService:\n        \"\"\"Orchestrates validation and the max-finding algorithm.\"\"\"\n        def __init__(self, finder: Optional[MaxFinder] = None) -> None:\n            self.finder = finder if finder is not None else MaxFinder()\n\n        def get_max(self, sequence: Iterable[Any], key: Optional[Callable[[Any], Any]] = None) -> MaxResult:\n            \"\"\"Finds the maximum element in a sequence using a MaxFinder.\"\"\"\n            max_value = self.finder.find_max(sequence, key)\n            return MaxResult(max_value)\n\n    service = MaxElementService()\n    # The stub `max_element(l: list)` does not include a `key` parameter.\n    # Therefore, we pass `key=None` to the service.\n    result = service.get_max(l, key=None)\n    return result.value"}
{"task_id": "HumanEval/34", "solution": "import abc\nimport logging\n\n# Configure a basic logger for internal use, as per design context guidance\n# on logging configuration.\nlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s %(levelname)s %(name)s: %(message)s\")\n_logger = logging.getLogger(__name__)\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input types or formats.\"\"\"\n    pass\n\nclass SortingError(Exception):\n    \"\"\"Exception raised when sorting fails due to incomparable elements.\"\"\"\n    pass\n\nclass UniqueAdapter(abc.ABC):\n    \"\"\"Abstract base class for deduplication strategies.\"\"\"\n    @abc.abstractmethod\n    def unique(self, items: list) -> list:\n        pass\n\nclass HashSetAdapter(UniqueAdapter):\n    \"\"\"Deduplicates items using a set, assuming all items are hashable.\"\"\"\n    def unique(self, items: list) -> list:\n        # This will raise TypeError if any item is unhashable, which UniqueService handles.\n        return list(set(items))\n\nclass OrderPreservingAdapter(UniqueAdapter):\n    \"\"\"Deduplicates items while preserving their original order, suitable for unhashable items.\"\"\"\n    def unique(self, items: list) -> list:\n        result = []\n        for item in items:\n            if item not in result: # Uses `__eq__` for comparison, leading to O(N^2) worst-case.\n                result.append(item)\n        return result\n\nclass SortService:\n    \"\"\"Provides a safe sorting mechanism, handling incomparable types gracefully.\"\"\"\n    def safe_sort(self, items: list) -> list:\n        \"\"\"Attempts to sort the list; raises SortingError if items are incomparable.\"\"\"\n        try:\n            return sorted(items)\n        except TypeError as e:\n            _logger.warning(\"Sorting failed due to incomparable types, raising SortingError.\")\n            raise SortingError(\"Items could not be sorted due to incomparable types.\") from e\n\nclass UniqueService:\n    \"\"\"Orchestrates deduplication and sorting, including strategy selection and fallback behaviors.\"\"\"\n    def __init__(self, unique_adapter: UniqueAdapter, sorter: SortService):\n        self._default_adapter = unique_adapter\n        self._sorter = sorter\n\n    def _is_hashable(self, item) -> bool:\n        \"\"\"Checks if an item is hashable by attempting to call hash().\"\"\"\n        try:\n            hash(item)\n            return True\n        except TypeError:\n            return False\n\n    def _choose_adapter(self, items: list) -> UniqueAdapter:\n        \"\"\"Selects a deduplication adapter based on the hashability of the items.\"\"\"\n        if all(self._is_hashable(item) for item in items):\n            return HashSetAdapter() # Prefer hash-based for performance if all items are hashable.\n        else:\n            _logger.info(\"Some items are unhashable; using OrderPreservingAdapter for initial deduplication.\")\n            return OrderPreservingAdapter() # Fallback to order-preserving for unhashable items.\n\n    def unique(self, l: list) -> list:\n        \"\"\"Returns unique sorted elements from a list, with fallbacks for unhashable/uncomparable items.\"\"\"\n        # Input validation (e.g., checking if 'l' is a list) is expected to be handled upstream by the caller.\n\n        chosen_adapter = self._choose_adapter(l)\n        \n        initial_unique_items = []\n        try:\n            initial_unique_items = chosen_adapter.unique(l)\n        except TypeError as e:\n            # If the chosen adapter (e.g., HashSetAdapter) fails due to unhashable items,\n            # fall back to OrderPreservingAdapter for deduplication.\n            _logger.warning(f\"Initial deduplication with {type(chosen_adapter).__name__} failed; falling back to OrderPreservingAdapter.\")\n            initial_unique_items = OrderPreservingAdapter().unique(l)\n\n        try:\n            return self._sorter.safe_sort(initial_unique_items)\n        except SortingError:\n            # If sorting fails, return an order-preserved unique list from the original input 'l'.\n            _logger.info(\"Sorting failed due to incomparable types; returning order-preserved unique elements from original list.\")\n            return OrderPreservingAdapter().unique(l)\n\nclass UniqueController:\n    \"\"\"A thin adapter that interfaces between external calls and the UniqueService.\"\"\"\n    def __init__(self, service: UniqueService):\n        self._service = service\n\n    def unique(self, l: list) -> list:\n        \"\"\"Delegates the unique element retrieval to the underlying UniqueService.\"\"\"\n        # Per requirements, `isinstance` checks are omitted here; `l` is expected to be a list.\n        return self._service.unique(l)\n\n# Initialize default components for the public `unique` function.\n# These instances are effectively singletons for the default public API entry point.\n_default_sort_service = SortService()\n_default_unique_service = UniqueService(unique_adapter=HashSetAdapter(), sorter=_default_sort_service) # `unique_adapter` here is the initial default, but UniqueService._choose_adapter will pick dynamically.\n_default_unique_controller = UniqueController(service=_default_unique_service)\n\ndef unique(l: list):\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    return _default_unique_controller.unique(l)"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group right. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Constants for root finding adapted from design document.\n    TOLERANCE = 1e-9\n    MAX_ITERATIONS = 1000\n    BRACKET_START_RANGE = 0.1\n    BRACKET_FACTOR = 2.0\n    MAX_BRACKET_TRIES = 50\n\n    # Bracketing phase: Search for an interval [a, b] where poly(a) and poly(b) have opposite signs.\n    # We expand symmetrically around 0.0.\n    a = -BRACKET_START_RANGE\n    b = BRACKET_START_RANGE\n    \n    val_a = poly(xs, a)\n    val_b = poly(xs, b)\n\n    if abs(val_a) < TOLERANCE: # Check if start of interval is already a root\n        return a\n    if abs(val_b) < TOLERANCE: # Check if end of interval is already a root\n        return b\n    \n    if val_a * val_b >= 0: # If signs are not opposite, expand the search range\n        current_range = BRACKET_START_RANGE\n        for _ in range(MAX_BRACKET_TRIES):\n            current_range *= BRACKET_FACTOR\n            a_test = -current_range\n            b_test = current_range\n\n            val_a_test = poly(xs, a_test)\n            val_b_test = poly(xs, b_test)\n\n            if abs(val_a_test) < TOLERANCE:\n                return a_test\n            if abs(val_b_test) < TOLERANCE:\n                return b_test\n\n            if val_a_test * val_b_test < 0:\n                a, b = a_test, b_test\n                break\n    \n    # Bisection phase: Narrow down the interval [a, b] until a root is found within tolerance.\n    for _ in range(MAX_ITERATIONS):\n        c = (a + b) / 2.0\n        val_c = poly(xs, c)\n\n        if abs(val_c) < TOLERANCE or (b - a) / 2.0 < TOLERANCE:\n            return c\n\n        val_a = poly(xs, a) # Re-evaluate to avoid using potentially stale `val_a` if it was from bracketing\n        if val_a * val_c < 0:\n            b = c\n        else:\n            a = c\n    \n    # If maximum iterations reached, return the midpoint of the final interval as the approximation.\n    return (a + b) / 2.0"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    result = list(l)\n    even_indexed_values = []\n    even_indices = []\n\n    for i in range(0, len(l), 2):\n        even_indexed_values.append(l[i])\n        even_indices.append(i)\n\n    even_indexed_values.sort()\n\n    for i, val in zip(even_indices, even_indexed_values):\n        result[i] = val\n\n    return result"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n\n    divisors = (11, 13)\n    seen_numbers = set()\n\n    # Generator function to yield numbers less than n that are divisible by 11 or 13, without duplicates.\n    def generate_divisible_numbers_less_than_n():\n        for d in divisors:\n            multiple = 0\n            while multiple < n:\n                if multiple not in seen_numbers:\n                    seen_numbers.add(multiple)\n                    yield multiple\n                multiple += d\n    \n    target_digit = '7'\n    total_sevens = 0\n\n    # Iterate through the generated numbers and count occurrences of the digit '7'.\n    for x in generate_divisible_numbers_less_than_n():\n        total_sevens += str(abs(x)).count(target_digit)\n\n    return total_sevens"}
{"task_id": "HumanEval/39", "solution": "import random\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    def is_prime(num: int) -> bool:\n        if num < 2:\n            return False\n        if num in (2, 3):\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n\n        # Small prime checks from design context\n        small_primes = (5, 7, 11, 13, 17, 19, 23, 29)\n        for p in small_primes:\n            if num == p:\n                return True\n            if num % p == 0:\n                return False\n\n        # Miller-Rabin probabilistic test for larger numbers, k=8 as per design\n        def miller_rabin(m: int, k: int = 8) -> bool:\n            # Assumes m is odd and m > 3 based on prior checks\n            s = 0\n            d = m - 1\n            while d % 2 == 0:\n                d //= 2\n                s += 1\n\n            for _ in range(k):\n                a = random.randrange(2, m - 1)\n                x = pow(a, d, m)\n                if x == 1 or x == m - 1:\n                    continue\n                for _ in range(s - 1):\n                    x = pow(x, 2, m)\n                    if x == m - 1:\n                        break\n                else:\n                    return False\n            return True\n\n        return miller_rabin(num)\n\n    def fib_generator():\n        # Yields Fibonacci numbers: F1=1, F2=1, F3=2...\n        a, b = 1, 1\n        yield a\n        yield b\n        while True:\n            a, b = b, a + b\n            yield b\n\n    prime_count = 0\n    for fib_num in fib_generator():\n        if fib_num < 2:\n            continue\n        \n        if is_prime(fib_num):\n            prime_count += 1\n            if prime_count == n:\n                return fib_num"}
{"task_id": "HumanEval/33", "solution": "```python\ndef sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    indices_to_sort = [i for i in range(len(l)) if i % 3 == 0]\n    values_to_sort = [l[i] for i in indices_to_sort]\n    sorted_values = sorted(values_to_sort)\n\n    result = list(l)  # Create a shallow copy to preserve original list\n    for original_idx, sorted_val in zip(indices_to_sort, sorted_values):\n        result[original_idx] = sorted_val\n    return result\n```"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    Checks if there are three distinct elements in the list that sum to zero.\n    The algorithm uses a sorted list and the two-pointer technique for efficiency.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    arr = sorted(l)\n\n    for i in range(n - 2):\n        a = arr[i]\n        left, right = i + 1, n - 1\n\n        while left < right:\n            s = a + arr[left] + arr[right]\n\n            if s == 0:\n                return True\n            elif s < 0:\n                left += 1\n            else:\n                right -= 1\n    \n    return False"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    seen_numbers = set()\n    for number in l:\n        # If the complement (-number) has been seen, a pair summing to zero exists.\n        if -number in seen_numbers:\n            return True\n        seen_numbers.add(number)\n    return False"}
{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int):\n    \"\"\"\n    Imagine a road that's a perfectly straight infinitely long line.\n    n cars are driving left to right;  simultaneously, a different set of n cars\n    are driving right to left.   The two sets of cars start out being very far from\n    each other.  All cars move in the same speed.  Two cars are said to collide\n    when a car that's moving left to right hits a car that's moving right to left.\n    However, the cars are infinitely sturdy and strong; as a result, they continue moving\n    in their trajectory as if they did not collide.\n\n    This function outputs the number of such collisions.\n    \"\"\"\n    # Each of the n cars moving left collides with each of the n cars moving right.\n    # Since cars pass through each other, each pair collides exactly once.\n    return n * n"}
{"task_id": "HumanEval/42", "solution": "def incr_list(l: list):\n    \"\"\"Return list with elements incremented by 1.\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    \"\"\"\n    return [x + 1 for x in l]"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base, returning its string representation.\n    Base numbers are less than 10 and non-negative.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n\n    class ConversionError(Exception):\n        \"\"\"Domain-specific exception for conversion failures.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class NumberInput:\n        \"\"\"Immutable DTO for validated input values.\"\"\"\n        def __init__(self, x: int, base: int) -> None:\n            self.x = x\n            self.base = base\n\n        def to_tuple(self) -> tuple[int, int]:\n            return (self.x, self.base)\n\n    class ConversionResult:\n        \"\"\"Immutable DTO for conversion result string.\"\"\"\n        def __init__(self, value: str) -> None:\n            self.value = value\n\n        def __str__(self) -> str:\n            return self.value\n\n    MIN_BASE = 2\n    MAX_BASE = 9\n\n    class Validator:\n        \"\"\"Validates input types and ranges.\"\"\"\n        @staticmethod\n        def validate_input(x_any, base_any) -> NumberInput:\n            if not isinstance(x_any, int):\n                raise ConversionError(\"x must be an integer\")\n            if x_any < 0:\n                raise ConversionError(\"x must be non-negative\")\n            if not isinstance(base_any, int):\n                raise ConversionError(\"base must be an integer\")\n            if base_any < MIN_BASE or base_any > MAX_BASE:\n                raise ConversionError(f\"base must be between {MIN_BASE} and {MAX_BASE}\")\n            return NumberInput(x=x_any, base=base_any)\n\n    def format_digits(digits: list[int]) -> str:\n        \"\"\"Join a list of integer digits into a string.\"\"\"\n        return \"\".join(map(str, digits))\n\n    class BaseConverterService:\n        \"\"\"Core algorithm to convert integer to digits in given base.\"\"\"\n        def convert(self, input_dto: NumberInput) -> ConversionResult:\n            x_val, base_val = input_dto.to_tuple()\n            if x_val == 0:\n                return ConversionResult(\"0\")\n            digits = self._compute_digits(x_val, base_val)\n            value = format_digits(digits)\n            return ConversionResult(value)\n\n        def _compute_digits(self, x_val: int, base_val: int) -> list[int]:\n            \"\"\"Compute digits for conversion using repeated division.\"\"\"\n            if base_val <= 1:\n                raise ConversionError(\"Base must be >= 2\")\n            digits = []\n            n = x_val\n            while n > 0:\n                digits.append(n % base_val)\n                n //= base_val\n            digits.reverse()\n            return digits\n\n    class ConverterFactory:\n        \"\"\"Factory for obtaining converter instances.\"\"\"\n        def get_converter(self) -> BaseConverterService:\n            return BaseConverterService()\n\n    input_dto = Validator.validate_input(x, base)\n    converter = ConverterFactory().get_converter()\n    result = converter.convert(input_dto)\n    return str(result)"}
{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    This function assumes valid positive float inputs.\n    \"\"\"\n    return 0.5 * a * h"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"Computes the n-th element of the Fib4 number sequence efficiently without recursion.\"\"\"\n    if n == 0 or n == 1 or n == 3:\n        return 0\n    if n == 2:\n        return 2\n\n    # Initialize the first four Fib4 numbers: fib4(0), fib4(1), fib4(2), fib4(3)\n    a, b, c, d = 0, 0, 2, 0\n\n    # Iterate from fib4(4) up to fib4(n)\n    for i in range(4, n + 1):\n        # Calculate the next Fib4 number\n        next_fib4 = a + b + c + d\n        # Shift the values: a becomes b, b becomes c, c becomes d, d becomes next_fib4\n        a, b, c, d = b, c, d, next_fib4\n        \n    return d"}
