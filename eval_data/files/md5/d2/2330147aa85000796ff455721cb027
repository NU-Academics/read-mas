{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    from typing import List, Optional\n\n    class ParseError(Exception):\n        def __init__(self, message: str, position: Optional[int] = None):\n            super().__init__(message)\n            self.message = message\n            self.position = position\n\n        def __str__(self) -> str:\n            if self.position is not None:\n                return f\"{self.message} (pos={self.position})\"\n            return self.message\n\n    class InvalidCharacterError(ParseError):\n        def __init__(self, message: str, position: int, invalid_char: str):\n            super().__init__(message, position=position)\n            self.invalid_char = invalid_char\n\n    class Tokenizer:\n        VALID_TOKENS = {\"(\", \")\"}\n\n        def tokenize(self, paren_string: str) -> List[str]:\n            \"\"\"Return token list composed only of '(' and ')'. Raises InvalidCharacterError for any non-space char.\"\"\"\n            tokens: List[str] = []\n            for idx, ch in enumerate(paren_string):\n                if ch.isspace():\n                    continue\n                if ch not in self.VALID_TOKENS:\n                    raise InvalidCharacterError(f\"Invalid character '{ch}'\", position=idx, invalid_char=ch)\n                tokens.append(ch)\n            return tokens\n\n    class Validator:\n        def is_balanced(self, tokens: List[str]) -> bool:\n            \"\"\"Fast check that tokens form a balanced parentheses sequence.\"\"\"\n            depth = 0\n            for ch in tokens:\n                if ch == \"(\":\n                    depth += 1\n                else:\n                    depth -= 1\n                    if depth < 0:\n                        return False\n            return depth == 0\n\n        def validate_group(self, tokens: List[str]) -> None:\n            \"\"\"Raise ParseError if group invalid.\"\"\"\n            depth = 0\n            for idx, ch in enumerate(tokens):\n                if ch == \"(\":\n                    depth += 1\n                else:\n                    depth -= 1\n                    if depth < 0:\n                        raise ParseError(\"Too many closing parens\", position=idx)\n            if depth != 0:\n                raise ParseError(\"Unbalanced parentheses: missing closing parens\", position=len(tokens))\n\n    class ParenParser:\n        def __init__(self, tokenizer: Tokenizer, validator: Validator):\n            self._tokenizer = tokenizer\n            self._validator = validator\n\n        def separate_groups(self, paren_string: str) -> List[str]:\n            \"\"\"Return list of normalized group strings (no internal spaces).\"\"\"\n            tokens = self._tokenizer.tokenize(paren_string)\n            groups: List[str] = []\n            current: List[str] = []\n            depth = 0\n            for idx, t in enumerate(tokens):\n                current.append(t)\n                if t == \"(\":\n                    depth += 1\n                else:\n                    depth -= 1\n                if depth == 0 and current:\n                    self._validator.validate_group(current)\n                    groups.append(\"\".join(current))\n                    current = []\n            if depth != 0:\n                raise ParseError(\"Unbalanced input: trailing open parens\", position=len(tokens))\n            return groups\n\n    class ParenService:\n        def __init__(self, parser: ParenParser):\n            self._parser = parser\n\n        def separate(self, paren_string: str) -> List[str]:\n            \"\"\"High-level API; trims input, handles exceptions, and returns groups.\"\"\"\n            return self._parser.separate_groups(paren_string)\n\n    _parser = ParenParser(Tokenizer(), Validator())\n    _service = ParenService(_parser)\n    return _service.separate(paren_string)"}
{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    return number - math.floor(number)"}
