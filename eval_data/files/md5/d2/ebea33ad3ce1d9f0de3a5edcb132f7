ance = FractionSimplifierService(parser=_parser_instance)\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"Checks if the product of two fractions, given as strings, evaluates to a whole number.\n    Returns True if the product is a whole number, False otherwise.\"\"\"\n    return _service_instance.simplify(x, n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/144", "solution": "import math\nclass Fraction:\n    \"\"\"Represents a mathematical fraction and provides operations for multiplication and simplification.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        if not isinstance(numerator, int) or not isinstance(denominator, int):\n            raise TypeError(\"Numerator and denominator must be integers.\")\n        if denominator == 0:\n            raise ValueError(\"Denominator cannot be zero.\")\n        # Normalize negative sign to numerator for consistent representation.\n        if denominator < 0:\n            numerator = -numerator\n            denominator = -denominator\n        self.numerator = numerator\n        self.denominator = denominator\n        self._simplify()\n\n    def __mul__(self, other: 'Fraction') -> 'Fraction':\n        # Multiplies this fraction by another, returning a new simplified Fraction.\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        # Checks if the fraction simplifies to a whole number.\n        return self.denominator == 1\n\n    def _simplify(self) -> None:\n        # Simplifies the fraction by dividing by their greatest common divisor.\n        if self.numerator == 0:\n            self.denominator = 1\n            return\n        common_divisor = self._gcd(abs(self.numerator), self.denominator)\n        self.numerator //= common_divisor\n        self.denominator //= common_divisor\n\n    @staticmethod\n    def _gcd(a: int, b: int) -> int:\n        # Calculates the greatest common divisor of two integers.\n        return math.gcd(a, b)\nclass FractionParser:\n    \"\"\"Parses a string representation of a fraction into a Fraction object.\"\"\"\n    @staticmethod\n    def parse(fraction_str: str) -> Fraction:\n        parts = fraction_str.split('/')\n        if len(parts) != 2:\n            raise ValueError(\"Invalid fraction string format. Expected 'numerator/denominator'.\")\n        try:\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n        except ValueError:\n            raise ValueError(\"Numerator and denominator must be integers.\")\n\n        # Enforce problem constraints for input fractions: non-negative numerator, positive denominator.\n        if numerator < 0 or denominator <= 0:\n             raise ValueError(\"Numerator must be non-negative and denominator must be positive.\")\n\n        return Fraction(numerator, denominator)\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    fraction_x = FractionParser.parse(x)\n    fraction_n = FractionParser.parse(n)\n\n    product_fraction = fraction_x * fraction_n\n\n    return product_fraction.is_whole_number()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "PLANET_OR