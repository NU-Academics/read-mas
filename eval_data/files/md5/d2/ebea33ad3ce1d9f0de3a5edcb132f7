hen original_index.\n    decorated_list.sort()\n\n    # Extract the original numbers in their new sorted order.\n    sorted_nums = [item[2] for item in decorated_list]\n    return sorted_nums", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[-5, -12, 9, 15]]]}], "HumanEval/146": [{"task_id": "HumanEval/146", "solution": "def specialFilter(nums: list[int]) -> int:\n    \"\"\"\n    Counts numbers in the array that are greater than 10 and have\n    both their first and last digits odd.\n    \"\"\"\n\n    def _is_odd(digit: int) -> bool:\n        \"\"\"Checks if a given digit is odd.\"\"\"\n        return digit % 2 != 0\n\n    def _get_first_digit(num: int) -> int:\n        \"\"\"Extracts the first digit of an integer using its absolute value.\"\"\"\n        num_str = str(abs(num))\n        return int(num_str[0])\n\n    def _get_last_digit(num: int) -> int:\n        \"\"\"Extracts the last digit of an integer using its absolute value.\"\"\"\n        num_str = str(abs(num))\n        return int(num_str[-1])\n\n    count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = _get_first_digit(num)\n            last_digit = _get_last_digit(num)\n            if _is_odd(first_digit) and _is_odd(last_digit):\n                count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/146", "solution": "{\"error\": \"agent_no_response\", \"message\": \"Agent returned no response.\"}", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/150": [{"task_id": "HumanEval/150", "solution": "{\"error\": \"agent_no_response\", \"message\": \"Agent returned no response.\"}", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/150", "solution": "import math\ndef x_or_y(n, x, y):\n    \"\"\"Returns x if n 