Agent returned no response.\"}", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Compares two arrays of scores and guesses of equal length, returning an array of the same length denoting how far off each guess was. If guessed correctly, the value is 0; otherwise, it's the absolute difference.\"\"\"\n    if len(game) != len(guess):\n        raise ValueError(\"Input arrays must be of equal length.\")\n\n    differences = []\n    for i in range(len(game)):\n        differences.append(abs(game[i] - guess[i]))\n    return differences", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/151": [{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Calculates the sum of squares of positive odd integers in the list.\n    Ignores negative numbers and non-integers, returning 0 for an empty list.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for item in lst:\n        # Check if item is an integer or a float representing an integer (e.g., 7.0)\n        is_integer_like = isinstance(item, int) or (isinstance(item, float) and item.is_integer())\n\n        if is_integer_like:\n            num = int(item)  # Convert to integer for subsequent checks and squaring\n            is_positive = num > 0\n            is_odd = num % 2 != 0\n\n            if is_positive and is_odd:\n                total_sum += num ** 2\n    return total_sum", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1.0, 3.5, -4.6]]]}, {"task_id": "HumanEval/151", "solution": "class Validator:\n    \"\"\"\n    Provides static utility methods for validating numbers based on specific criteria.\n    \"\"\"\n    @staticmethod\n    def is_valid_number(num: any) -> bool:\n        \"\"\"\n        Checks if a given input `num` is a non-negative integer.\n        Only integers that are zero or greater are considered valid.\n        \"\"\"\n        return isinstance(num, int) and num >= 0\n\n    @staticmethod\n    def is_odd(num: int) -> bool:\n        \"\"\"\n        Checks if a given integer `num` is odd.\n        This method assumes `num` is already an integer.\n        \"\"\"\n        return num % 2 != 0\ndef double_the_difference(lst: list) -> int:\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0  \n   \n    If the input list is empty, return 0.\n    '''\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for num in lst:\n        if Validator.is_valid_number(num) and Validator.is_odd(num):\n            total_sum += num * num\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "{\"error\": \"agent_no_response\", \"message\": \"Agent returned no response.\"}", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/154", "solution": "class StringUtils:\n    @staticmethod\n    def generate_rotations(s: str) -> list[str]:\n        \"\"\"\n        Generates all unique cyclic rotations of the input string s.\n        \"\"\"\n        if not s:\n            return []\n        \n        rotations = set()\n        n = len(s)\n        for i in range(n):\n            rotated_s = s[i:] + s[:i]\n            rotations.add(rotated_s)\n        return sorted(list(rotations))\nclass CycPatternChecker:\n    @staticmethod\n    def check(a: str, b: str) -> bool:\n        \"\"\"\n        Checks if the second word (b) or any of its rotations is a substring in the first word (a).\n        \"\"\"\n        if not b:\n            return True if not a else True # An empty string is a substring of any string (or itself)\n        if not a:\n            return False # A non-empty b cannot be a substring of an empty a\n\n        rotations_of_b = StringUtils.generate_rotations(b)\n        \n        for rotation in rotations_of_b:\n            if rotation in a:\n                return True\n        return False\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    return CycPatternChecker.check(a, b)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name: str, extensions: list[str]) -> str:\n    \"\"\"Calculates extension strength (uppercase - lowercase) and finds the strongest, returning `ClassName.StrongestExtensionName`.\n    Tie-breaking selects the first extension with maximum strength.\n    \"\"\"\n\n    def _calculate_strength(ext_name: str) -> int:\n        \"\"\"Counts uppercase and lowercase letters to determine extension strength.\"\"\"\n        cap_count = sum(1 for char in ext_name if 'A' <= char <= 'Z')\n        sm_count = sum(1 for char in ext_name if 'a' <= char <= 'z')\n        return cap_count - sm_count\n\n    if not extensions:\n        return f\"{class_name}.\"\n\n    strongest_ext_name: str = \"\"\n    max_strength: int = -float('inf')  # Initialize with a very low strength\n\n    for ext_name in extensions:\n        current_strength = _calculate_strength(ext_name)\n\n        # Update if current extension is stronger.\n        # If strengths are equal, the first encountered (current strongest) is kept.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = ext_name\n\n    return f\"{class_name}.{strongest_ext_name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/153", "solution": "# src/services.py\nclass ExtensionService:\n    @staticmethod\n    def calculate_strength(extension_name: str) -> int:\n        \"\"\"Calculates the strength of an extension name.\n        Strength is CAP - SM (uppercase count minus lowercase count).\n        \"\"\"\n        cap_count = sum(1 for char in extension_name if char.isupper())\n        sm_count = sum(1 for char in extension_name if char.islower())\n        return cap_count - sm_count\n\n    @staticmethod\n    def find_strongest_extension(extensions: list[str]) -> str | None:\n        \"\"\"Identifies the strongest extension from a list based on strength.\n        Ties are resolved by choosing the first extension encountered.\n        \"\"\"\n        if not extensions:\n            return None\n\n        max_strength = -float('inf')\n        strongest_extension_name = None\n\n        for extension in extensions:\n            current_strength = ExtensionService.calculate_strength(extension)\n            if current_strength > max_strength:\n                max_strength = current_strength\n                strongest_extension_name = extension\n        \n        return strongest_extension_name", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/156": [{"task_id": "HumanEval/156", "solution": "from typing import List, Tuple\nROMAN_MAP: List[Tuple[int, str]] = [\n    (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"),\n    (100, \"C\"), (90, \"XC\"), (50, \"L\"), (40, \"XL\"),\n    (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"), (1, \"I\")\n]\nMIN_INPUT_VALUE = 1\nMAX_INPUT_VALUE = 1000\ndef int_to_mini_roman(number: int) -> str:\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    # Input validation\n    if not isinstance(number, int):\n        raise ValueError(\"Input must be an integer.\")\n    if not (MIN_INPUT_VALUE <= number <= MAX_INPUT_VALUE):\n        raise ValueError(f\"Input must be between {MIN_INPUT_VALUE} and {MAX_INPUT_VALUE}, inclusive.\")\n\n    # Roman numeral conversion\n    roman_numeral_parts = []\n    temp_num = number\n    for value, symbol in ROMAN_MAP:\n        while temp_num >= value:\n            roman_numeral_parts.append(symbol)\n            temp_num -= value\n    \n    roman_uppercase = \"\".join(roman_numeral_parts)\n    return roman_uppercase.lower()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number: int) -> str:\n    \"\"\"\n    Converts a positive integer to its lowercase Roman numeral equivalent.\n    Input must be an integer between 1 and 1000, inclusive.\n    \"\"\"\n    if not isinstance(number, int) or not (1 <= number <= 1000):\n        raise ValueError(\"Input number must be an integer between 1 and 1000.\")\n\n    roman_map = [\n        (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n        (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n        (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'), (1, 'i')\n    ]\n\n    roman_numeral_parts = []\n    temp_num = number\n    for value, symbol in roman_map:\n        while temp_num >= value:\n            roman_numeral_parts.append(symbol)\n            temp_num -= value\n    return \"\".join(roman_numeral_parts)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "def even_odd_count(num: int) -> tuple[int, int]:\n    \"\"\"Given an integer, return a tuple containing the count of even and odd digits respectively.\n    Negative numbers are processed by their absolute value.\n    \"\"\"\n    if not isinstance(num, int):\n        raise TypeError(\"Input 'num' must be an integer.\")\n\n    even_count = 0\n    odd_count = 0\n    \n    # Process the absolute value to handle negative numbers\n    abs_num_str = str(abs(num))\n    \n    for digit_char in abs_num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n            \n    return (even_count, odd_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/155", "solution": "def even_odd_count(num: int) -> tuple[int, int]:\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\n    Negative numbers are processed using their absolute value, and zero is considered an even digit.\n    \"\"\"\n    if not isinstance(num, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    even_count = 0\n    odd_count = 0\n    \n    current_num = abs(num)\n\n    # Special case for 0, as per business rule BR2\n    if current_num == 0:\n        return (1, 0)\n\n    while current_num > 0:\n        digit = current_num % 10\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n        current_num //= 10\n        \n    return (even_count, odd_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    '''\n    # Validate that all inputs are numerical types (int or float).\n    if not all(isinstance(side, (int, float)) for side in [a, b, c]):\n        raise TypeError(\"Side lengths must be numerical.\")\n\n    # Validate that all side lengths are positive.\n    if not (a > 0 and b > 0 and c > 0):\n        raise ValueError(\"Side lengths must be positive.\")\n\n    # Validate the triangle inequality theorem.\n    if not (a + b > c and a + c > b and b + c > a):\n        raise ValueError(\"The given side lengths do not form a valid triangle.\")\n\n    # Apply the Pythagorean theorem with a small epsilon for floating-point comparison.\n    sides = sorted([a, b, c])\n    epsilon = 1e-9\n    return abs(sides[0]**2 + sides[1]**2 - sides[2]**2) < epsilon", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[1, 2, 3]], "plus_fail_tests": [[16, 6, 6]]}, {"task_id": "HumanEval/157", "solution": "from dataclasses import dataclass\nclass NonPositiveSideError(ValueError):\n    \"\"\"Raised when a triangle side length is not positive.\"\"\"\n    pass\nclass InvalidTriangleError(ValueError):\n    \"\"\"Raised when side lengths do not form a valid triangle.\"\"\"\n    pass\nclass TriangleValidator:\n    \"\"\"Validates triangle side lengths for positivity and triangle inequality.\"\"\"\n    EPSILON: float = 1e-9\n\n    def validate_sides(self, a, b, c) -> TriangleSides:\n        \"\"\"Validates three input side lengths and returns a TriangleSides object.\"\"\"\n        if not all(isinstance(side, (int, float)) for side in [a, b, c]):\n            raise TypeError(\"Side lengths must be numerical.\")\n\n        if not (self._is_positive(a) and self._is_positive(b) and self._is_positive(c)):\n            raise NonPositiveSideError(\"All side lengths must be positive.\")\n\n        if not self._satisfies_triangle_inequality(a, b, c):\n            raise InvalidTriangleError(\"The given side lengths cannot form a valid triangle.\")\n\n        return TriangleSides(a, b, c)\n\n    def _is_positive(self, side: float) -> bool:\n        \"\"\"Checks if a single side length is positive.\"\"\"\n        return side > 0\n\n    def _satisfies_triangle_inequality(self, a: float, b: float, c: float) -> bool:\n        \"\"\"Checks if the three sides satisfy the triangle inequality theorem.\"\"\"\n        return (a + b > c) and (a + c > b) and (b + c > a)\nclass TriangleService:\n    \"\"\"Determines if a triangle is right-angled after validation.\"\"\"\n    def __init__(self):\n        \"\"\"Initializes the service with a TriangleValidator instance.\"\"\"\n        self._validator = TriangleValidator()\n\n    def is_right_angle_triangle(self, a, b, c) -> bool:\n        \"\"\"Determines if the given side lengths form a right-angled triangle.\"\"\"\n        validated_sides = self._validator.validate_sides(a, b, c)\n        sides_list = validated_sides.get_sides() # Sorted list: [shortest, middle, longest]\n        return self._is_pythagorean_triple(sides_list)\n\n    def _is_pythagorean_triple(self, sides: list[float]) -> bool:\n        \"\"\"Checks if the sorted sides satisfy the Pythagorean theorem.\"\"\"\n        s1_sq = sides[0] ** 2\n        s2_sq = sides[1] ** 2\n        s3_sq = sides[2] ** 2\n        \n        # Use epsilon from the validator for floating-point comparison.\n        return abs(s1_sq + s2_sq - s3_sq) < self._validator.EPSILON\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    service = TriangleService()\n    return service.is_right_angle_triangle(a, b, c)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Finds the word with the most unique characters in a list.\n    Ties are broken by lexicographical order (ascending).\n    \"\"\"\n\n    def _count_unique_chars(word_str: str) -> int:\n        \"\"\"Calculates the number of unique characters in a given string.\"\"\"\n        return len(set(word_str))\n\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = _count_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: if counts are equal, choose the lexicographically smaller word.\n            if word < result_word:\n                result_word = word\n    \n    return result_word", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/158", "solution": "class StringMetrics:\n    \"\"\"Encapsulates a word and provides functionality to calculate its unique character count.\n    This class lazily computes the unique character count.\"\"\"\n    def __init__(self, word: str):\n        self.word = word\n        self._unique_char_count = -1\n\n    def calculate_unique_chars(self) -> int:\n        \"\"\"Calculates and returns the number of unique characters in the word.\n        It caches the result after the first calculation.\"\"\"\n        if self._unique_char_count == -1:\n            self._unique_char_count = len(set(self.word))\n        return self._unique_char_count\ndef find_max(words: list[str]) -> str:\n    \"\"\"Accepts a list of strings and returns the word with the maximum unique characters.\n    In case of a tie, the lexicographically smallest word is returned.\"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        metrics = StringMetrics(word)\n        current_unique_count = metrics.calculate_unique_chars()\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Lexicographical tie-breaker.\n            # The result_word == \"\" condition handles initialization if the first candidate was an empty string.\n            if result_word == \"\" or word < result_word:\n                result_word = word\n    return result_word", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "def eat(number: int, need: int, remaining: int) -> list[int]:\n    \"\"\"\n    Calculates the total number of carrots eaten and the number of carrots left after a meal.\n    If not enough carrots are remaining, the rabbit eats all available carrots.\n    \"\"\"\n    carrots_to_eat_this_meal = min(need, remaining)\n    total_eaten_after_meal = number + carrots_to_eat_this_meal\n    carrots_left_in_stock = remaining - carrots_to_eat_this_meal\n    return [total_eaten_after_meal, carrots_left_in_stock]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/159", "solution": "{\"error\": \"agent_no_response\", \"message\": \"Agent returned no response.\"}", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Transforms a string: reverses case of letters, or reverses the whole string if no letters.\n    This provides a specific string transformation utility.\"\"\"\n    \n    # Determine if the input string contains any alphabetic characters.\n    has_alpha = any(char.isalpha() for char in s)\n\n    if not has_alpha:\n        # If no alphabetic characters are found, reverse the entire string.\n        return s[::-1]\n    else:\n        # Otherwise, iterate and reverse the case of alphabetic characters.\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                result_chars.append(char.swapcase())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Transforms a string by reversing letter cases or reversing the whole string if no letters are present.\n    Non-alphabetic characters are preserved unless the string is fully reversed.\"\"\"\n    \n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if not has_letters:\n        return s[::-1]\n    else:\n        transformed_chars = []\n        for char in s:\n            if char.isalpha():\n                if char.islower():\n                    transformed_chars.append(char.upper())\n                else:  # Must be uppercase\n                    transformed_chars.append(char.lower())\n            else:\n                transformed_chars.append(char)\n        return \"\".join(transformed_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/162": [{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text: str) -> str | None:\n    \"\"\"\n    Computes the MD5 hash of the given string.\n    Returns None if the input string is empty.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text: str) -> str | None:\n    \"\"\"\n    Given a string 'text', return its MD5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "from typing import List, Set, Any\nclass InvalidInputError(Exception):\n    \"\"\"Raised when general input types or structures are invalid.\"\"\"\n    def __init__(self, message=\"Invalid input provided.\"):\n        self.message = message\n        super().__init__(self.message)\nclass InvalidExpressionError(Exception):\n    \"\"\"Raised when specific expression rules are violated.\"\"\"\n    def __init__(self, message=\"Invalid expression rules violated.\"):\n        self.message = message\n        super().__init__(self.message)\nclass CalculationError(Exception):\n    \"\"\"Raised for errors during expression evaluation.\"\"\"\n    def __init__(self, message=\"An error occurred during calculation.\"):\n        self.message = message\n        super().__init__(self.message)\nVALID_OPERATORS: Set[str] = {'+', '-', '*', '//', '**'}\ndef _is_valid_operator(op: str) -> bool:\n    \"\"\"Checks if a string is one of the allowed algebraic operators.\"\"\"\n    return isinstance(op, str) and op in VALID_OPERATORS\ndef _is_non_negative_int(num: Any) -> bool:\n    \"\"\"Checks if a value is a non-negative integer.\"\"\"\n    return isinstance(num, int) and num >= 0\ndef do_algebra(operator: List[str], operand: List[int]) -> int:\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + )\n    Subtraction ( - )\n    Multiplication ( * )\n    Floor division ( // )\n    Exponentiation ( ** )\n\n    Example:\n    operator=['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n    \"\"\"\n    # Validate inputs\n    if not isinstance(operator, list) or not isinstance(operand, list):\n        raise InvalidInputError(\"Inputs 'operator' and 'operand' must be lists.\")\n\n    if not operator or not operand or len(operand) < 2:\n        raise InvalidExpressionError(\n            \"Operator list must have at least one operator, and operand list at least two operands.\"\n        )\n\n    if len(operator) != len(operand) - 1:\n        raise InvalidExpressionError(\n            \"The length of operator list must be equal to the length of operand list minus one.\"\n        )\n\n    for op_item in operator:\n        if not isinstance(op_item, str):\n            raise InvalidInputError(f\"Operator list contains non-string element: '{op_item}'.\")\n        if not _is_valid_operator(op_item):\n            raise InvalidExpressionError(f\"Invalid operator '{op_item}' found. Supported: {', '.join(VALID_OPERATORS)}.\")\n\n    for i, num in enumerate(operand):\n        if not isinstance(num, int):\n            raise InvalidInputError(f\"Operand list contains non-integer element at index {i}: '{num}'.\")\n        if not _is_non_negative_int(num):\n            raise InvalidExpressionError(f\"Operand at index {i} ('{num}') is not a non-negative integer.\")\n\n    # Build expression string\n    expression_parts = []\n    for i in range(len(operator)):\n        expression_parts.append(str(operand[i]))\n        expression_parts.append(operator[i])\n    expression_parts.append(str(operand[-1]))\n    expression_string = \" \".join(expression_parts)\n\n    # Evaluate expression\n    try:\n        # Using eval() is safe here due to strict input validation.\n        result = eval(expression_string)\n        return int(result)\n    except ZeroDivisionError:\n        raise CalculationError(\"Division by zero occurred.\")\n    except Exception as e:\n        raise CalculationError(f\"An unexpected error occurred during evaluation: {e}\")", "base_status": "timeout", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/160", "solution": "def do_algebra(operator: list[str], operand: list[int]) -> int:\n    \"\"\"Evaluates an algebraic expression from operator and operand lists.\n    This function processes operands and operators, respecting standard mathematical precedence.\n    \"\"\"\n\n    _OPERATORS = {\n        '+': 1, '-': 1,\n        '*': 2, '//': 2,\n        '**': 3\n    }\n\n    def _validate_inputs(op_list: list[str], val_list: list[int]) -> None:\n        \"\"\"Validates the input operator and operand lists according to business rules.\"\"\"\n        if not isinstance(op_list, list) or not all(isinstance(op, str) for op in op_list):\n            raise ValueError(\"Operator list must be a list of strings.\")\n        if not isinstance(val_list, list) or not all(isinstance(val, int) and val >= 0 for val in val_list):\n            raise ValueError(\"Operand list must be a list of non-negative integers.\")\n        if len(op_list) != len(val_list) - 1:\n            raise ValueError(\"Length of operator list must be equal to length of operand list minus one.\")\n        if len(op_list) < 1:\n            raise ValueError(\"Operator list must have at least one operator.\")\n        if len(val_list) < 2:\n            raise ValueError(\"Operand list must have at least two operands.\")\n        if not all(op in _OPERATORS for op in op_list):\n            raise ValueError(f\"Invalid operator found. Allowed operators are: {list(_OPERATORS.keys())}\")\n\n    def _tokenize_expression(op_list: list[str], val_list: list[int]) -> list[str | int]:\n        \"\"\"Interleaves operands and operators into a single list of tokens.\"\"\"\n        tokens = []\n        for i in range(len(val_list)):\n            tokens.append(val_list[i])\n            if i < len(op_list):\n                tokens.append(op_list[i])\n        return tokens\n\n    def _apply_operator(op: str, val1: int, val2: int) -> int:\n        \"\"\"Performs a single arithmetic operation on two integer values.\"\"\"\n        if op == '+':\n            return val1 + val2\n        elif op == '-':\n            return val1 - val2\n        elif op == '*':\n            return val1 * val2\n        elif op == '//':\n            if val2 == 0:\n                raise ZeroDivisionError(\"Cannot perform floor division by zero.\")\n            return val1 // val2\n        elif op == '**':\n            return val1 ** val2\n        else:\n            raise ValueError(f\"Unknown operator: {op}\") # Should not be reached due to validation\n\n    def _evaluate_expression(tokens: list[str | int]) -> int:\n        \"\"\"Evaluates the tokenized expression using a shunting-yard like algorithm.\"\"\"\n        output_queue = []\n        operator_stack = []\n\n        for token in tokens:\n            if isinstance(token, int):\n                output_queue.append(token)\n            elif isinstance(token, str):  # It's an operator (o1)\n                while operator_stack and operator_stack[-1] in _OPERATORS:\n                    o2 = operator_stack[-1]\n                    # Apply operator precedence and associativity rules.\n                    if (o2 == '**' and _OPERATORS[o2] > _OPERATORS[token]) or \\\n                       (o2 != '**' and _OPERATORS[o2] >= _OPERATORS[token]):\n                        op = operator_stack.pop()\n                        val2 = output_queue.pop()\n                        