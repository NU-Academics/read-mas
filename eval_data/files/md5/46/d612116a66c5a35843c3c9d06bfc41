{"task_id": "HumanEval/93", "solution": "def encode(text: str) -> str:\n    VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n    result = []\n    for c in text:\n        if c == ' ':\n            result.append(c)\n            continue\n        swapped = c.upper() if c.islower() else c.lower()\n        if swapped in VOWELS:\n            base = ord('A') if swapped.isupper() else ord('a')\n            pos = ord(swapped) - base\n            new_pos = (pos + 2) % 26\n            replacement = chr(base + new_pos)\n            result.append(replacement)\n        else:\n            result.append(swapped)\n    return ''.join(result)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(numbers: list[int]) -> int:\n    def is_prime(n: int) -> bool:\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def digit_sum(n: int) -> int:\n        total = 0\n        while n > 0:\n            total += n % 10\n            n //= 10\n        return total\n\n    max_prime = None\n    for n in numbers:\n        if n < 2:\n            continue\n        if is_prime(n):\n            if max_prime is None or n > max_prime:\n                max_prime = n\n\n    if max_prime is None:\n        return 0\n    return digit_sum(max_prime)"}
{"task_id": "HumanEval/95", "solution": "from typing import Any\ndef check_dict_case(d: dict[str, Any]) -> bool:\n    \"\"\"\n    Determine whether all keys in the dictionary are consistently lowercase or uppercase.\n    Returns False for empty dictionaries, non-string keys, or mixed/non-alphabetic keys.\n    \"\"\"\n    if not d:\n        return False\n\n    all_lower = True\n    all_upper = True\n\n    for key in d:\n        if not isinstance(key, str):\n            return False\n        if key.islower():\n            all_upper = False\n        elif key.isupper():\n            all_lower = False\n        else:\n            # key contains non-alphabetic or mixed case characters\n            return False\n\n    return all_lower or all_upper"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n: int) -> list[int]:\n    \"\"\"Return a list of prime numbers strictly less than n.\n\n    Parameters\n    ----------\n    n : int\n        The upper bound (exclusive). Must be a non\u2011negative integer.\n\n    Returns\n    -------\n    list[int]\n        Ordered list of prime numbers less than n.\n\n    Raises\n    ------\n    TypeError\n        If n is not an integer.\n    ValueError\n        If n is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non\u2011negative\")\n    if n <= 2:\n        return []\n\n    is_prime = [True] * n\n    is_prime[0] = False\n    is_prime[1] = False\n\n    limit = int(n**0.5) + 1\n    for p in range(2, limit):\n        if is_prime[p]:\n            start = p * p\n            step = p\n            for multiple in range(start, n, step):\n                is_prime[multiple] = False\n\n    return [i for i, prime in enumerate(is_prime) if prime]"}
{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Complete the function that takes two integers and returns \n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    \"\"\"\n    unit_a = abs(a) % 10\n    unit_b = abs(b) % 10\n    return unit_a * unit_b"}
{"task_id": "HumanEval/98", "solution": "def count_upper(s: str) -> int:\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n    vowels = {\"A\", \"E\", \"I\", \"O\", \"U\"}\n    count = 0\n    for idx in range(0, len(s), 2):\n        if s[idx] in vowels:\n            count += 1\n    return count"}
{"task_id": "HumanEval/99", "solution": "import re\n_NUM_RE = re.compile(r'^[+-]?(\\\\d+(\\\\.\\\\d*)?|\\\\.\\\\d+)$')\ndef closest_integer(num_str: str) -> int:\n    trimmed = num_str.strip()\n    if not _NUM_RE.match(trimmed):\n        raise ValueError(f\"Invalid numeric string: '{num_str}'\")\n    value = float(trimmed)\n    int_part = int(value)  # truncates toward zero\n    sign = 1 if value >= 0 else -1\n    frac_part = abs(value - int_part)\n    if frac_part < 0.5:\n        result = int_part\n    else:\n        result = int_part + sign\n    return result"}
{"task_id": "HumanEval/100", "solution": "def _next_odd(current: int) -> int:\n    \"\"\"Return the next odd integer after `current`.\"\"\"\n    return current + 2 if current % 2 else current + 1\ndef _next_even(current: int) -> int:\n    \"\"\"Return the next even integer after `current`.\"\"\"\n    return current + 2 if current % 2 == 0 else current + 1\ndef make_a_pile(n: int) -> list[int]:\n    \"\"\"\n    Generate stone counts for each level of a pile.\n\n    Parameters:\n        n (int): Positive integer indicating the stone count of the first level.\n\n    Returns:\n        list[int]: Stone counts for levels 1 to n.\n\n    Raises:\n        ValueError: If n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"Input must be a positive integer.\")\n\n    result: list[int] = [n]\n    next_func = _next_odd if n % 2 == 1 else _next_even\n\n    for _ in range(1, n):\n        last = result[-1]\n        result.append(next_func(last))\n\n    return result"}
{"task_id": "HumanEval/101", "solution": "def words_string(s: str) -> list[str]:\n    \"\"\"\n    Extract words from a string.\n\n    Parameters\n    ----------\n    s : str\n        Input string to be tokenized.\n\n    Returns\n    -------\n    list[str]\n        Ordered list of words found in the input.\n    \"\"\"\n    words: list[str] = []\n    current: list[str] = []\n\n    for ch in s:\n        if ch.isalpha():\n            current.append(ch)\n        else:\n            if current:\n                words.append(''.join(current))\n                current.clear()\n\n    if current:\n        words.append(''.join(current))\n\n    return words"}
{"task_id": "HumanEval/102", "solution": "def choose_num(x: int, y: int) -> int:\n    \"\"\"\n    Return the largest even integer in the inclusive range [x, y].\n\n    Parameters\n    ----------\n    x : int\n        Lower bound of the range (must be positive).\n    y : int\n        Upper bound of the range (must be positive).\n\n    Returns\n    -------\n    int\n        The largest even integer within [x, y] if it exists;\n        otherwise, -1.\n\n    Behavior\n    --------\n    - If x > y, or either bound is non\u2011positive, the function returns -1.\n    - The function assumes integer inputs; non\u2011integer arguments will\n      raise a TypeError before the function body executes.\n    \"\"\"\n    if x <= 0 or y <= 0 or x > y:\n        return -1\n    if y % 2 == 0:\n        return y\n    candidate = y - 1\n    return candidate if candidate >= x else -1"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n: int, m: int) -> str:\n    \"\"\"\n    Compute the rounded average of integers from n to m inclusive,\n    return the result as a binary string.\n\n    Parameters:\n        n (int): Start of the inclusive range.\n        m (int): End of the inclusive range.\n\n    Returns:\n        str: Binary string of the rounded average, or \"-1\" if inputs\n             are invalid (negative values or n > m).\n    \"\"\"\n    # Validation\n    if not isinstance(n, int) or not isinstance(m, int):\n        return \"-1\"\n    if n < 0 or m < 0:\n        return \"-1\"\n    if n > m:\n        return \"-1\"\n\n    # Computation\n    count = m - n + 1\n    total = (n + m) * count // 2\n\n    # Average and rounding using integer arithmetic\n    rounded = (total + count // 2) // count\n\n    # Formatting\n    return bin(rounded)[2:]"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x: list[int]) -> list[int]:\n    \"\"\"Return a sorted list of integers from x that contain no even digits.\n\n    Parameters\n    ----------\n    x : list[int]\n        A list of positive integers.\n\n    Returns\n    -------\n    list[int]\n        A list of integers that have only odd digits, sorted in ascending order.\n    \"\"\"\n    def has_no_even_digit(num: int) -> bool:\n        for ch in str(num):\n            if ch in {\"0\", \"2\", \"4\", \"6\", \"8\"}:\n                return False\n        return True\n\n    result = [n for n in x if has_no_even_digit(n)]\n    return sorted(result)"}
{"task_id": "HumanEval/105", "solution": "def by_length(nums: list[int]) -> list[str]:\n    \"\"\"Transform a list of integers into a list of English number names\n    for values 1\u20139 inclusive, sorted descending.\"\"\"\n    if not isinstance(nums, list):\n        raise TypeError(\"Input must be a list of integers.\")\n    for v in nums:\n        if not isinstance(v, int):\n            raise TypeError(\"All elements must be integers.\")\n    NUM_NAMES = {\n        1: \"One\",\n        2: \"Two\",\n        3: \"Three\",\n        4: \"Four\",\n        5: \"Five\",\n        6: \"Six\",\n        7: \"Seven\",\n        8: \"Eight\",\n        9: \"Nine\",\n    }\n    valid_nums = [v for v in nums if 1 <= v <= 9]\n    sorted_nums = sorted(valid_nums)\n    reversed_nums = list(reversed(sorted_nums))\n    return [NUM_NAMES[v] for v in reversed_nums]"}
{"task_id": "HumanEval/106", "solution": "def f(n: int) -> list[int]:\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer \u2265 1\")\n\n    result: list[int] = []\n    fact: int = 1\n\n    for i in range(1, n + 1):\n        if i > 1:\n            fact *= i\n        sum_i = i * (i + 1) // 2\n\n        if i % 2 == 0:\n            result.append(fact)\n        else:\n            result.append(sum_i)\n\n    return result"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n: int) -> tuple[int, int]:\n    \"\"\"\n    Return a tuple (even_count, odd_count) where even_count is the number of even\n    integer palindromes in the inclusive range [1, n] and odd_count is the number\n    of odd integer palindromes in the same range.\n\n    A positive integer is a palindrome if its decimal representation reads the same\n    forwards and backwards.\n\n    Parameters\n    ----------\n    n : int\n        Upper bound of the range. Must be a non\u2011negative integer.\n\n    Returns\n    -------\n    tuple[int, int]\n        (even_count, odd_count)\n\n    Notes\n    -----\n    * If n is less than 1, the function returns (0, 0).\n    * Input validation is performed; a TypeError is raised if n is not an int.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        return (0, 0)\n\n    even_count = 0\n    odd_count = 0\n    for num in range(1, n + 1):\n        s = str(num)\n        if s == s[::-1]:\n            if num % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr: list[int]) -> int:\n    \"\"\"\n    Count elements in an integer list whose digit sum, taking into account sign\n    on first digit for negative numbers, is greater than 0.\n    \"\"\"\n    count = 0\n    for n in arr:\n        first_sign = -1 if n < 0 else 1\n        m = abs(n)\n        s = str(m)\n        sum_digits = 0\n        for i, ch in enumerate(s):\n            d = ord(ch) - 48  # convert char to int without int()\n            if i == 0:\n                sum_digits += first_sign * d\n            else:\n                sum_digits += d\n        if sum_digits > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Return True if array can be sorted by right shifts, else False.\"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    # Count places where the order breaks (arr[i] > arr[i+1]) with wrap around.\n    breaks = 0\n    for i in range(n):\n        next_i = (i + 1) % n\n        if arr[i] > arr[next_i]:\n            breaks += 1\n            if breaks > 1:\n                return False\n\n    # If there are 0 or 1 breaks, a rotation can sort the array.\n    return True"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1: list[int], lst2: list[int]) -> str:\n    \"\"\"Return \"YES\" if all elements in lst1 can be made even by swapping\n    elements with lst2; otherwise return \"NO\".\"\"\"\n    odd_in_lst1 = 0\n    for val in lst1:\n        if val % 2 != 0:\n            odd_in_lst1 += 1\n\n    even_in_lst2 = 0\n    for val in lst2:\n        if val % 2 == 0:\n            even_in_lst2 += 1\n\n    return \"YES\" if odd_in_lst1 <= even_in_lst2 else \"NO\""}
{"task_id": "HumanEval/111", "solution": "def histogram(s: str) -> dict[str, int]:\n    tokens = s.split()\n    if not tokens:\n        return {}\n    counts: dict[str, int] = {}\n    for token in tokens:\n        counts[token] = counts.get(token, 0) + 1\n    max_count = max(counts.values())\n    return {token: count for token, count in counts.items() if count == max_count}"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s: str, c: str) -> tuple[str, bool]:\n    deletion_set = set(c)\n    filtered = []\n    for ch in s:\n        if ch not in deletion_set:\n            filtered.append(ch)\n    result = ''.join(filtered)\n    is_palindrome = result == result[::-1]\n    return result, is_palindrome"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst: list[str]) -> list[str]:\n    template = \"the number of odd elements in the string i of the input.\"\n    result: list[str] = []\n    for s in lst:\n        odd_count_val = 0\n        for ch in s:\n            if int(ch) % 2 != 0:\n                odd_count_val += 1\n        sentence = template.replace(\"i\", str(odd_count_val))\n        result.append(sentence)\n    return result"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Find the minimum sum of any non-empty sub-array of nums.\n    \"\"\"\n    if not nums:\n        raise ValueError(\"The input list must contain at least one element.\")\n    current_min = nums[0]\n    global_min = nums[0]\n    for num in nums[1:]:\n        current_min = num if current_min > 0 else current_min + num\n        if current_min < global_min:\n            global_min = current_min\n    return global_min"}
{"task_id": "HumanEval/115", "solution": "def max_fill(grid: list[list[int]], capacity: int) -> int:\n    if capacity <= 0:\n        raise ValueError(\"Capacity must be a positive integer.\")\n    total = 0\n    for row in grid:\n        for amount in row:\n            if amount < 0:\n                raise ValueError(\"Grid values must be non-negative.\")\n            if amount:\n                total += (amount + capacity - 1) // capacity\n    return total"}
{"task_id": "HumanEval/116", "solution": "def _popcount(value: int) -> int:\n    \"\"\"Return popcount of abs(value).\"\"\"\n    return bin(abs(value)).count(\"1\")\ndef sort_array(numbers: list[int]) -> list[int]:\n    \"\"\"Sort integers by popcount of abs(value), then by integer value.\n\n    Parameters\n    ----------\n    numbers : list[int]\n        A list of integers to be sorted.\n\n    Returns\n    -------\n    list[int]\n        A new list containing the sorted integers.\n\n    Notes\n    -----\n    * The input list is not modified.\n    * Sorting is performed using Python's built\u2011in Timsort, resulting in O(n log n) time complexity.\n    * An empty list returns an empty list.\n\n    Examples\n    --------\n    >>> sort_array([3, -1, 2, 0])\n    [0, -1, 2, 3]\n    >>> sort_array([])\n    []\n    \"\"\"\n    return sorted(numbers, key=lambda x: (_popcount(x), x))"}
{"task_id": "HumanEval/117", "solution": "def _is_vowel(char: str) -> bool:\n    \"\"\"Return True if the character is a vowel (case\u2011insensitive).\"\"\"\n    return char.lower() in {'a', 'e', 'i', 'o', 'u'}\ndef _count_consonants(word: str) -> int:\n    \"\"\"Count consonants in a word, case\u2011insensitively.\"\"\"\n    count = 0\n    for c in word:\n        if c.isalpha() and not _is_vowel(c):\n            count += 1\n    return count\ndef select_words(s: str, n: int) -> list[str]:\n    \"\"\"\n    Return a list of words from s that contain exactly n consonants.\n\n    Parameters\n    ----------\n    s : str\n        Input string containing only alphabetic characters and spaces.\n    n : int\n        Target consonant count (must be non\u2011negative).\n\n    Returns\n    -------\n    list[str]\n        Ordered list of qualifying words. Empty list if s is empty or no\n        words match the criterion.\n    \"\"\"\n    if n < 0 or not s:\n        return []\n\n    words = s.split()\n    result: list[str] = []\n\n    for word in words:\n        if _count_consonants(word) == n:\n            result.append(word)\n\n    return result"}
{"task_id": "HumanEval/118", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\ndef _is_vowel(ch: str) -> bool:\n    return ch in VOWELS\ndef _is_consonant(ch: str) -> bool:\n    return ch.isalpha() and not _is_vowel(ch)\ndef get_closest_vowel(word: str) -> str:\n    \"\"\"Find the rightmost vowel that is surrounded by consonants.\n\n    Parameters:\n        word (str): The input word consisting only of alphabetic characters.\n\n    Returns:\n        str: The vowel character if found, otherwise an empty string.\n    \"\"\"\n    length = len(word)\n    if length < 3:\n        return \"\"\n    # Traverse from right to left, skipping the first and last positions\n    for i in range(length - 2, 0, -1):\n        ch = word[i]\n        if _is_vowel(ch):\n            if _is_consonant(word[i - 1]) and _is_consonant(word[i + 1]):\n                return ch\n    return \"\""}
{"task_id": "HumanEval/119", "solution": "def match_parens(strings: list[str]) -> str:\n    \"\"\"Determine whether any concatenation of the two input strings results\n    in a balanced parentheses string.\n\n    Parameters\n    ----------\n    strings : list[str]\n        Exactly two strings consisting solely of '(' and ')'.\n\n    Returns\n    -------\n    str\n        'Yes' if a balanced concatenation exists, otherwise 'No'.\n    \"\"\"\n    _validate_input(strings)\n    s1, s2 = strings\n    if is_balanced(s1 + s2) or is_balanced(s2 + s1):\n        return \"Yes\"\n    return \"No\""}
{"task_id": "HumanEval/120", "solution": "def maximum(arr: list[int], k: int) -> list[int]:\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n    for x in arr:\n        if not isinstance(x, int):\n            raise ValueError(\"All elements in arr must be integers\")\n    if k < 0 or k > len(arr):\n        raise ValueError(\"k must be between 0 and len(arr) inclusive\")\n    if k == 0:\n        return []\n    sorted_arr = sorted(arr)\n    return sorted_arr[-k:] if k else []"}
{"task_id": "HumanEval/121", "solution": "def solution(nums: list[int]) -> int:\n    if not isinstance(nums, list):\n        raise ValueError(\"Input must be a non\u2011empty list of integers.\")\n    if not nums:\n        raise ValueError(\"Input list cannot be empty.\")\n    for idx, val in enumerate(nums):\n        if not isinstance(val, int):\n            raise ValueError(\"All elements must be integers.\")\n    total = 0\n    for idx, val in enumerate(nums):\n        if idx % 2 == 0 and val % 2 != 0:\n            total += val\n    return total"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr: list[int], k: int) -> int:\n    \"\"\"\n    Return the sum of the elements with at most two digits from the first k elements of arr.\n    \n    Parameters\n    ----------\n    arr : list[int]\n        Non-empty list of integers.\n    k : int\n        Number of elements to consider from the beginning of arr.\n    \n    Returns\n    -------\n    int\n        Sum of qualifying elements.\n    \n    Raises\n    ------\n    TypeError\n        If arr is not a list, contains non\u2011integer elements, or k is not an integer.\n    ValueError\n        If k is outside the range 1 <= k <= len(arr).\n    \"\"\"\n    # Validate arr is a list\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list\")\n    # Validate arr is non-empty\n    if len(arr) == 0:\n        raise ValueError(\"arr must contain at least one element\")\n    # Validate each element is an integer\n    for i, val in enumerate(arr):\n        if not isinstance(val, int):\n            raise TypeError(f\"arr contains non-integer element at index {i}\")\n    # Validate k is an integer\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n    # Validate k bounds\n    if k < 1 or k > len(arr):\n        raise ValueError(\"k must satisfy 1 <= k <= len(arr)\")\n    # Compute the sum of elements with at most two digits in the first k elements\n    total = 0\n    for i in range(k):\n        val = arr[i]\n        # Count digits ignoring sign\n        digit_count = len(str(abs(val)))\n        if digit_count <= 2:\n            total += val\n    return total"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n: int) -> list[int]:\n    \"\"\"\n    Compute the Collatz sequence starting from n, collect all odd values,\n    sort them in ascending order, and return the sorted list.\n\n    Parameters\n    ----------\n    n : int\n        Positive integer starting value for the Collatz sequence.\n\n    Returns\n    -------\n    list[int]\n        Sorted list of all odd integers encountered during the sequence,\n        including the starting value if odd and the terminating 1.\n\n    Raises\n    ------\n    TypeError\n        If n is not an integer.\n    ValueError\n        If n is not a positive integer.\n    \"\"\"\n    # Input validation\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    current = n\n    odds: list[int] = []\n\n    while current != 1:\n        if current % 2 == 1:\n            odds.append(current)\n        # Update current according to Collatz rule\n        if current % 2 == 1:\n            current = 3 * current + 1\n        else:\n            current //= 2\n\n    # Append the final 1 (always odd)\n    odds.append(1)\n\n    return sorted(odds)"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date_str: str) -> bool:\n    date_str = date_str.strip()\n    if not date_str or len(date_str) != 10:\n        return False\n    if date_str[2] != '-' or date_str[5] != '-':\n        return False\n    month_str = date_str[0:2]\n    day_str = date_str[3:5]\n    year_str = date_str[6:10]\n    if not (month_str.isdigit() and day_str.isdigit() and year_str.isdigit()):\n        return False\n    month = int(month_str)\n    day = int(day_str)\n    if month < 1 or month > 12:\n        return False\n    if day < 1 or day > 31:\n        return False\n    if month == 2:\n        max_day = 29\n    elif month in (4, 6, 9, 11):\n        max_day = 30\n    else:\n        max_day = 31\n    if day > max_day:\n        return False\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(s: str) -> list[str] | int:\n    if \" \" in s:\n        return s.split()\n    if \",\" in s:\n        return s.split(\",\")\n    count = 0\n    for ch in s:\n        if \"a\" <= ch <= \"z\":\n            pos = ord(ch) - ord(\"a\") + 1\n            if pos % 2 == 1:\n                count += 1\n    return count"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(nums: list[int]) -> bool:\n    if not isinstance(nums, list):\n        raise TypeError(\"Input must be a list of integers.\")\n    for x in nums:\n        if not isinstance(x, int):\n            raise TypeError(\"All elements must be integers.\")\n        if x < 0:\n            raise ValueError(\"All integers must be non\u2011negative.\")\n    if len(nums) <= 1:\n        return True\n    prev = nums[0]\n    seen = {prev}\n    for current in nums[1:]:\n        if current in seen or current <= prev:\n            return False\n        seen.add(current)\n        prev = current\n    return True"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"\n    Determine whether the length of the intersection of two closed intervals\n    (each represented as a tuple of two integers) is a prime number.\n\n    Args:\n        interval1: Tuple[int, int] representing the first interval (start, end).\n        interval2: Tuple[int, int] representing the second interval (start, end).\n\n    Returns:\n        \"YES\" if the intersection length is a prime number,\n        otherwise \"NO\". If the intervals do not intersect, returns \"NO\".\n    \"\"\"\n    # Validate input structure\n    if (not isinstance(interval1, tuple) or not isinstance(interval2, tuple) or\n        len(interval1) != 2 or len(interval2) != 2):\n        raise TypeError(\"Both intervals must be tuples of two integers.\")\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    # Ensure interval bounds are integers\n    if (not isinstance(start1, int) or not isinstance(end1, int) or\n        not isinstance(start2, int) or not isinstance(end2, int)):\n        raise TypeError(\"Interval boundaries must be integers.\")\n\n    # Intervals are assumed to have start <= end; if not, swap\n    if start1 > end1:\n        start1, end1 = end1, start1\n    if start2 > end2:\n        start2, end2 = end2, start2\n\n    # Compute intersection bounds\n    intersect_start = start1 if start1 > start2 else start2\n    intersect_end = end1 if end1 < end2 else end2\n\n    # No intersection\n    if intersect_start > intersect_end:\n        return \"NO\"\n\n    # Length of intersection (closed interval)\n    length = intersect_end - intersect_start + 1\n\n    # Helper function to test primality\n    def is_prime(n: int) -> bool:\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0:\n            return False\n        # Check odd divisors up to sqrt(n)\n        limit = int(n ** 0.5) + 1\n        divisor = 3\n        while divisor <= limit:\n            if n % divisor == 0:\n                return False\n            divisor += 2\n        return True\n\n    return \"YES\" if is_prime(length) else \"NO\""}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr: list[float]) -> float | None:\n    if not arr:\n        return None\n    sum_abs = 0.0\n    sign_prod = 1\n    for x in arr:\n        sum_abs += abs(x)\n        if x == 0.0:\n            sign_prod = 0\n        else:\n            sign_prod *= 1 if x > 0 else -1\n    return sum_abs * sign_prod"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Return the lexicographically smallest sequence of length k that can be obtained by\n    traversing a 2\u2011D integer grid using only orthogonal (up, down, left, right) moves.\n\n    Parameters\n    ----------\n    grid : list[list[int]]\n        A rectangular grid of integers. All rows must have the same length.\n    k : int\n        Desired path length (number of cells visited). Must be non\u2011negative.\n\n    Returns\n    -------\n    list[int]\n        The lexicographically smallest sequence of length k. If k is 0, returns an empty list.\n\n    Raises\n    ------\n    ValueError\n        If the grid is empty, rows are not rectangular, k is negative, or k exceeds the\n        total number of cells in the grid.\n    \"\"\"\n    # Input validation\n    if not grid or not grid[0]:\n        raise ValueError(\"Grid must be non\u2011empty.\")\n    rows = len(grid)\n    cols = len(grid[0])\n    for r in grid:\n        if len(r) != cols:\n            raise ValueError(\"All rows in the grid must have the same length.\")\n    if k < 0:\n        raise ValueError(\"k must be non\u2011negative.\")\n    total_cells = rows * cols\n    if k > total_cells:\n        raise ValueError(\"k cannot exceed the total number of cells in the grid.\")\n    if k == 0:\n        return []\n\n    # Directions: up, down, left, right\n    dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    # prev stores the best sequence of length l-1 for each cell\n    prev = [[None for _ in range(cols)] for _ in range(rows)]\n    for r in range(rows):\n        for c in range(cols):\n            prev[r][c] = [grid[r][c]]  # length 1\n\n    # Build sequences for lengths 2 .. k\n    for length in range(2, k + 1):\n        curr = [[None for _ in range(cols)] for _ in range(rows)]\n        for r in range(rows):\n            for c in range(cols):\n                best_suffix = None\n                for dr, dc in dirs:\n                    nr = r + dr\n                    nc = c + dc\n                    if 0 <= nr < rows and 0 <= nc < cols:\n                        candidate = prev[nr][nc]\n                        if candidate is not None:\n                            if best_suffix is None or candidate < best_suffix:\n                                best_suffix = candidate\n                if best_suffix is not None:\n                    curr[r][c] = [grid[r][c]] + best_suffix\n        prev = curr\n\n    # Extract the lexicographically smallest sequence of length k\n    min_sequence = None\n    for r in range(rows):\n        for c in range(cols):\n            seq = prev[r][c]\n            if seq is not None:\n                if min_sequence is None or seq < min_sequence:\n                    min_sequence = seq\n    return min_sequence if min_sequence is not None else []"}
{"task_id": "HumanEval/130", "solution": "def tri(n: int) -> list[int]:\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non\u2011negative integer\")\n\n    memo: dict[int, int] = {}\n\n    def _tri(k: int) -> int:\n        if k in memo:\n            return memo[k]\n        if k == 0:\n            value = 1\n        elif k == 1:\n            value = 3\n        elif k == 2:\n            value = 2\n        elif k % 2 == 0:  # even and k > 2\n            value = 1 + k // 2\n        else:  # odd and k > 1\n            # k + 1 is even; use the even rule directly to avoid deeper recursion\n            next_val = 1 + (k + 1) // 2\n            value = _tri(k - 1) + _tri(k - 2) + next_val\n        memo[k] = value\n        return value\n\n    return [_tri(i) for i in range(n + 1)]"}
{"task_id": "HumanEval/131", "solution": "def digits(n: int) -> int:\n    \"\"\"Return the product of the odd digits of a positive integer `n`.\n    If `n` contains no odd digits, return 0.\n    Raise TypeError if the argument is not an int.\n    Raise ValueError if the argument is not strictly positive.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"Input must be a positive integer.\")\n\n    product = 1\n    has_odd = False\n    while n > 0:\n        digit = n % 10\n        if digit % 2 == 1:\n            product *= digit\n            has_odd = True\n        n //= 10\n    return 0 if not has_odd else product"}
{"task_id": "HumanEval/132", "solution": "def is_nested(s: str) -> bool:\n    \"\"\"Determine whether a string of '[' and ']' characters contains a\n    nested subsequence of brackets, i.e., a subsequence that can be\n    represented as '[ [ ... ] ]'.\n\n    Parameters:\n    s (str): Input string containing only '[' and ']'.\n\n    Returns:\n    bool: True if such a nested subsequence exists, False otherwise.\n    \"\"\"\n    n = len(s)\n    # Need at least four characters to form a nested pair\n    if n < 4:\n        return False\n\n    # Find the first '['\n    i = s.find('[')\n    if i == -1:\n        return False\n\n    # Find a second '[' after the first\n    j = s.find('[', i + 1)\n    if j == -1:\n        return False\n\n    # Find the first ']' after the second '['\n    k = s.find(']', j + 1)\n    if k == -1:\n        return False\n\n    # Find a second ']' after the first ']' found\n    l = s.find(']', k + 1)\n    if l == -1:\n        return False\n\n    # All required indices found: nested subsequence exists\n    return True"}
{"task_id": "HumanEval/133", "solution": "def sum_squares(data: list[float]) -> int:\n    \"\"\"Compute the sum of squares of the ceiling of each numeric element in data.\n\n    Parameters\n    ----------\n    data : list[float]\n        A list of numeric values (int or float). All elements must be numeric.\n\n    Returns\n    -------\n    int\n        Sum of the squares of the ceiling of each element.\n\n    Raises\n    ------\n    TypeError\n        If the input is not a list or if any element in data is not an int or float.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input must be a list\")\n\n    total: int = 0\n\n    for elem in data:\n        if not isinstance(elem, (int, float)):\n            raise TypeError(\"All elements must be int or float\")\n\n        if isinstance(elem, int):\n            ceil_val = elem\n        else:  # float\n            if elem.is_integer():\n                ceil_val = int(elem)\n            else:\n                if elem > 0:\n                    ceil_val = int(elem) + 1\n                else:\n                    ceil_val = int(elem)\n\n        square: int = ceil_val * ceil_val\n        total += square\n\n    return total"}
