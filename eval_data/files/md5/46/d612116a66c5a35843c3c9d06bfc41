{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name: str, extensions: list[str]) -> str:\n    if class_name is None:\n        raise TypeError(\"class_name must not be None\")\n    if extensions is None or len(extensions) == 0:\n        return class_name\n\n    best_extension: str | None = None\n    best_strength = -10**9  # sufficiently small\n\n    for ext in extensions:\n        cap = 0\n        sm = 0\n        for ch in ext:\n            if ch.isalpha():\n                if ch.isupper():\n                    cap += 1\n                elif ch.islower():\n                    sm += 1\n        strength = cap - sm\n        if strength > best_strength:\n            best_strength = strength\n            best_extension = ext\n\n    if best_extension is None:\n        return class_name\n    return f\"{class_name}.{best_extension}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a: str, b: str) -> bool:\n    if not b:\n        return True\n    if not a:\n        return False\n    if len(b) > len(a):\n        return False\n\n    rotations = b + b\n    m = len(b)\n\n    for i in range(m):\n        candidate = rotations[i:i + m]\n        if candidate in a:\n            return True\n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(number: int) -> tuple[int, int]:\n    \"\"\"Count even and odd digits in an integer.\n\n    Parameters\n    ----------\n    number : int\n        The integer whose digits are to be counted. The sign is ignored.\n\n    Returns\n    -------\n    tuple[int, int]\n        A two\u2011tuple where the first element is the number of even digits and the second element is the number of odd digits.\n\n    Raises\n    ------\n    TypeError\n        If *number* is not an instance of :class:`int`.\n\n    Notes\n    -----\n    The integer ``0`` is considered to have one even digit and zero odd digits.\n    \"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"Input must be an integer.\")\n    num_str = str(abs(number))\n    even_count = 0\n    odd_count = 0\n    for ch in num_str:\n        digit = int(ch)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    return even_count, odd_count"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(num: int) -> str:\n    \"\"\"Return the minimal Roman numeral representation of a positive integer between 1 and 3999.\"\"\"\n    if not isinstance(num, int):\n        raise ValueError(\"int_to_mini_roman accepts integers 1..3999\")\n    if num < 1 or num > 3999:\n        raise ValueError(\"int_to_mini_roman accepts integers 1..3999\")\n\n    ROMAN_MAP = (\n        (1000, \"M\"),\n        (900, \"CM\"),\n        (500, \"D\"),\n        (400, \"CD\"),\n        (100, \"C\"),\n        (90, \"XC\"),\n        (50, \"L\"),\n        (40, \"XL\"),\n        (10, \"X\"),\n        (9, \"IX\"),\n        (5, \"V\"),\n        (4, \"IV\"),\n        (1, \"I\"),\n    )\n\n    parts = []\n    for value, symbol in ROMAN_MAP:\n        while num >= value:\n            parts.append(symbol)\n            num -= value\n    return \"\".join(parts)"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a: float, b: float, c: float) -> bool:\n    \"\"\"\n    Determine whether three side lengths form a right triangle.\n\n    Parameters\n    ----------\n    a : float\n        Length of side a.\n    b : float\n        Length of side b.\n    c : float\n        Length of side c.\n\n    Returns\n    -------\n    bool\n        True if the sides can form a right triangle, False otherwise.\n    \"\"\"\n    # Type check: all must be int or float\n    if not all(isinstance(x, (int, float)) for x in (a, b, c)):\n        return False\n\n    # Convert to float and check positivity\n    a, b, c = float(a), float(b), float(c)\n    if a <= 0 or b <= 0 or c <= 0:\n        return False\n\n    # Triangle inequality\n    if a + b <= c or a + c <= b or b + c <= a:\n        return False\n\n    # Identify the hypotenuse by sorting\n    x, y, z = sorted((a, b, c))\n    lhs = x * x + y * y\n    rhs = z * z\n\n    eps = 1e-9\n    return abs(lhs - rhs) <= eps * max(lhs, rhs)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words: list[str]) -> str:\n    \"\"\"\n    Return the word with the maximum number of unique characters.\n    If multiple words share the same maximum count, return the\n    lexicographically smallest one.\n    If the input list is empty, return an empty string.\n    \"\"\"\n    best_word = \"\"\n    max_unique = -1\n\n    for word in words:\n        try:\n            unique_count = len(set(word))\n        except Exception:\n            # If word is not iterable (unlikely), skip it\n            continue\n\n        if unique_count > max_unique:\n            max_unique = unique_count\n            best_word = word\n        elif unique_count == max_unique:\n            # Choose lexicographically smaller word\n            if best_word == \"\" or word < best_word:\n                best_word = word\n\n    return best_word if max_unique >= 0 else \"\""}
{"task_id": "HumanEval/159", "solution": "def eat(number: int, need: int, remaining: int) -> list[int]:\n    \"\"\"Determines how many items are eaten and the remaining count after consumption.\n\n    Parameters\n    ----------\n    number : int\n        Total number of items originally available. Must be non\u2011negative.\n    need : int\n        Number of items the consumer wants to eat. Must be non\u2011negative.\n    remaining : int\n        Current number of items left before this consumption. Must be\n        non\u2011negative and <= number.\n\n    Returns\n    -------\n    list[int]\n        A list of two integers:\n        [total_eaten, remaining_left]\n        - total_eaten : int, number of items actually eaten.\n        - remaining_left : int, items left after eating.\n\n    Raises\n    ------\n    ValueError\n        If any of the arguments are negative, or if remaining > number,\n        or if need > number (indicating an impossible request).\n    \"\"\"\n    if number < 0:\n        raise ValueError(\"number must be non\u2011negative\")\n    if need < 0:\n        raise ValueError(\"need must be non\u2011negative\")\n    if remaining < 0:\n        raise ValueError(\"remaining must be non\u2011negative\")\n    if remaining > number:\n        raise ValueError(\"remaining cannot exceed number\")\n    if need > number:\n        raise ValueError(\"need cannot exceed total number\")\n\n    total_eaten = min(need, remaining)\n    remaining_left = remaining - total_eaten\n    return [total_eaten, remaining_left]"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operators, operands):\n    \"\"\"\n    Evaluate an arithmetic expression defined by two lists: operators and operands.\n    Operators are strings among '+', '-', '*', '//', '**'.\n    Operands are non\u2011negative integers.\n    The expression is formed as:\n        operand[0] op[0] operand[1] op[1] operand[2] ... op[n-1] operand[n]\n    The function respects normal arithmetic precedence:\n        '**' (right associative) > '*', '//' > '+', '-'.\n    Returns an integer result.\n    \"\"\"\n    # Basic validation\n    if not operators or not operands:\n        raise ValueError(\"Operator and operand lists must not be empty.\")\n    if len(operators) != len(operands) - 1:\n        raise ValueError(\"Number of operators must be one less than number of operands.\")\n\n    # Operator precedence and associativity\n    precedence = {'**': 3, '*': 2, '//': 2, '+': 1, '-': 1}\n    associativity = {'**': 'right', '*': 'left', '//': 'left', '+': 'left', '-': 'left'}\n\n    # Operator functions\n    def add(a, b): return a + b\n    def sub(a, b): return a - b\n    def mul(a, b): return a * b\n    def floordiv(a, b):\n        if b == 0:\n            raise ZeroDivisionError(\"division by zero\")\n        return a // b\n    def power(a, b): return a ** b\n\n    op_func = {'+': add, '-': sub, '*': mul, '//': floordiv, '**': power}\n\n    # Build token list: alternating numbers and operators\n    tokens = []\n    for i in range(len(operators)):\n        tokens.append(('number', operands[i]))\n        tokens.append(('operator', operators[i]))\n    tokens.append(('number', operands[-1]))\n\n    # Shunting-yard algorithm to convert to RPN\n    output_queue = []\n    operator_stack = []\n\n    for tok_type, tok_value in tokens:\n        if tok_type == 'number':\n            output_queue.append(('number', tok_value))\n        elif tok_type == 'operator':\n            o1 = tok_value\n            while operator_stack:\n                top_type, top_value = operator_stack[-1]\n                if top_type != 'operator':\n                    break\n                o2 = top_value\n                if (associativity[o1] == 'left' and precedence[o1] <= precedence[o2]) or \\\n                   (associativity[o1] == 'right' and precedence[o1] < precedence[o2]):\n                    output_queue.append(operator_stack.pop())\n                else:\n                    break\n            operator_stack.append(('operator', o1))\n        else:\n            raise ValueError(\"Unknown token type\")\n\n    while operator_stack:\n        top_type, top_value = operator_stack.pop()\n        if top_type == 'operator':\n            output_queue.append(('operator', top_value))\n        else:\n            raise ValueError(\"Mismatched parentheses (not used in this implementation)\")\n\n    # Evaluate RPN\n    stack = []\n    for tok_type, tok_value in output_queue:\n        if tok_type == 'number':\n            stack.append(tok_value)\n        elif tok_type == 'operator':\n            if len(stack) < 2:\n                raise ValueError(\"Insufficient operands for operator\")\n            b = stack.pop()\n            a = stack.pop()\n            result = op_func[tok_value](a, b)\n            stack.append(result)\n        else:\n            raise ValueError(\"Unexpected token during evaluation\")\n\n    if len(stack) != 1:\n        raise ValueError(\"Malformed expression evaluation\")\n\n    return stack[0]"}
{"task_id": "HumanEval/161", "solution": "def solve(s: str) -> str:\n    \"\"\"Reverse case of letters in a string, or reverse the string if no letters.\"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n\n    has_letter = False\n    for ch in s:\n        if ch.isalpha():\n            has_letter = True\n            break\n\n    if not has_letter:\n        return s[::-1]\n\n    result = []\n    for ch in s:\n        if ch.isalpha():\n            result.append(ch.upper() if ch.islower() else ch.lower())\n        else:\n            result.append(ch)\n\n    return \"\".join(result)"}
{"task_id": "HumanEval/162", "solution": "def string_to_md5(message: str) -> str:\n    if not isinstance(message, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # 1. Encode to bytes\n    msg_bytes = message.encode(\"utf-8\")\n    orig_len_bits = len(msg_bytes) * 8\n\n    # 2. Append 0x80 byte\n    msg_bytes += b\"\\x80\"\n\n    # 3. Pad with zeros until length \u2261 448 mod 512\n    while (len(msg_bytes) * 8) % 512 != 448:\n        msg_bytes += b\"\\x00\"\n\n    # 4. Append original length as 64\u2011bit little\u2011endian\n    msg_bytes += orig_len_bits.to_bytes(8, \"little\")\n\n    # 5. Constants\n    K = [\n        0xd76aa478,\n        0xe8c7b756,\n        0x242070db,\n        0xc1bdceee,\n        0xf57c0faf,\n        0x4787c62a,\n        0xa8304613,\n        0xfd469501,\n        0x698098d8,\n        0x8b44f7af,\n        0xffff5bb1,\n        0x895cd7be,\n        0x6b901122,\n        0xfd987193,\n        0xa679438e,\n        0x49b40821,\n        0xf61e2562,\n        0xc040b340,\n        0x265e5a51,\n        0xe9b6c7aa,\n        0xd62f105d,\n        0x02441453,\n        0xd8a1e681,\n        0xe7d3fbc8,\n        0x21e1cde6,\n        0xc33707d6,\n        0xf4d50d87,\n        0x455a14ed,\n        0xa9e3e905,\n        0xfcefa3f8,\n        0x676f02d9,\n        0x8d2a4c8a,\n        0xfffa3942,\n        0x8771f681,\n        0x6d9d6122,\n        0xfde5380c,\n        0xa4beea44,\n        0x4bdecfa9,\n        0xf6bb4b60,\n        0xbebfbc70,\n        0x289b7ec6,\n        0xeaa127fa,\n        0xd4ef3085,\n        0x04881d05,\n        0xd9d4d039,\n        0xe6db99e5,\n        0x1fa27cf8,\n        0xc4ac5665,\n        0xf4292244,\n        0x432aff97,\n        0xab9423a7,\n        0xfc93a039,\n        0x655b59c3,\n        0x8f0ccc92,\n        0xffeff47d,\n        0x85845dd1,\n        0x6fa87e4f,\n        0xfe2ce6e0,\n        0xa3014314,\n        0x4e0811a1,\n        0xf7537e82,\n        0xbd3af235,\n        0x2ad7d2bb,\n        0xeb86d391,\n    ]\n    S = [\n        7,\n        12,\n        17,\n        22,\n        7,\n        12,\n        17,\n        22,\n        7,\n        12,\n        17,\n        22,\n        7,\n        12,\n        17,\n        22,\n        5,\n        9,\n        14,\n        20,\n        5,\n        9,\n        14,\n        20,\n        5,\n        9,\n        14,\n        20,\n        5,\n        9,\n        14,\n        20,\n        4,\n        11,\n        16,\n        23,\n        4,\n        11,\n        16,\n        23,\n        4,\n        11,\n        16,\n        23,\n        4,\n        11,\n        16,\n        23,\n        6,\n        10,\n        15,\n        21,\n        6,\n        10,\n        15,\n        21,\n        6,\n        10,\n        15,\n        21,\n        6,\n        10,\n        15,\n        21,\n    ]\n\n    # 6. Initialize state\n    A = 0x67452301\n    B = 0xefcdab89\n    C = 0x98badcfe\n    D = 0x10325476\n\n    # 7. Process each 512\u2011bit block\n    for i in range(0, len(msg_bytes), 64):\n        block = msg_bytes[i : i + 64]\n        M = []\n        for j in range(0, 64, 4):\n            word = (\n                block[j]\n                | (block[j + 1] << 8)\n                | (block[j + 2] << 16)\n                | (block[j + 3] << 24)\n            )\n            M.append(word)\n\n        a, b, c, d = A, B, C, D\n\n        for k in range(64):\n            if k < 16:\n                f = (b & c) | (~b & d)\n                g = k\n            elif k < 32:\n                f = (d & b) | (~d & c)\n                g = (5 * k + 1) % 16\n            elif k < 48:\n                f = b ^ c ^ d\n                g = (3 * k + 5) % 16\n            else:\n                f = c ^ (b | ~d)\n                g = (7 * k) % 16\n\n            temp = (a + f + K[k] + M[g]) & 0xffffffff\n            temp = ((temp << S[k]) | (temp >> (32 - S[k]))) & 0xffffffff\n            a, b, c, d = d, (b + temp) & 0xffffffff, b, c\n\n        A = (A + a) & 0xffffffff\n        B = (B + b) & 0xffffffff\n        C = (C + c) & 0xffffffff\n        D = (D + d) & 0xffffffff\n\n    # 8. Produce final digest\n    digest_bytes = (\n        A.to_bytes(4, \"little\")\n        + B.to_bytes(4, \"little\")\n        + C.to_bytes(4, \"little\")\n        + D.to_bytes(4, \"little\")\n    )\n    return \"\".join(f\"{byte:02x}\" for byte in digest_bytes)"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a: int, b: int) -> list[int]:\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"Inputs must be integers\")\n    low, high = (a, b) if a <= b else (b, a)\n    candidates = [0, 2, 4, 6, 8]\n    return [c for c in candidates if low <= c <= high]"}
