{"task_id": "HumanEval/0", "solution": "def has_close_pair(values: list[float], threshold: float) -> bool:\n    \"\"\"\n    Determine whether any two elements in `values` are closer than `threshold`.\n\n    Parameters\n    ----------\n    values : list[float]\n        List of floating\u2011point numbers. May be empty or contain a single element.\n    threshold : float\n        Non\u2011negative number defining the minimum allowed distance between two elements.\n\n    Returns\n    -------\n    bool\n        True if there exists at least one pair (values[i], values[j]) with\n        |values[i] - values[j]| < threshold, otherwise False.\n\n    Raises\n    ------\n    ValueError\n        If `threshold` is negative.\n    \"\"\"\n    if threshold < 0:\n        raise ValueError(\"threshold must be non-negative\")\n\n    n = len(values)\n    if n <= 1:\n        return False\n\n    sorted_values = sorted(values)\n    for i in range(n - 1):\n        if sorted_values[i + 1] - sorted_values[i] < threshold:\n            return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> list[str]:\n    \"\"\"\n    Return a list of top\u2011level balanced parenthesis groups from ``paren_string``.\n\n    Parameters\n    ----------\n    paren_string : str\n        The input string containing parentheses.\n\n    Returns\n    -------\n    list[str]\n        Ordered list of substrings, each a balanced parenthesis group.\n\n    Raises\n    ------\n    ValueError\n        If parentheses are unmatched or improperly nested.\n    \"\"\"\n    _validate_parentheses(paren_string)\n    return _extract_groups(paren_string)\ndef _extract_groups(paren_string: str) -> list[str]:\n    \"\"\"\n    Core algorithm: scans once, tracks depth, collects groups.\n    Assumes input is already validated.\n\n    Parameters\n    ----------\n    paren_string : str\n        The input string to extract groups from.\n\n    Returns\n    -------\n    list[str]\n        The list of top\u2011level balanced parenthesis groups.\n    \"\"\"\n    depth = 0\n    start_idx = None\n    groups: list[str] = []\n\n    for idx, ch in enumerate(paren_string):\n        if ch == \"(\":\n            if depth == 0:\n                start_idx = idx\n            depth += 1\n        elif ch == \")\":\n            depth -= 1\n            if depth == 0 and start_idx is not None:\n                groups.append(paren_string[start_idx : idx + 1])\n                start_idx = None\n    return groups"}
{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\"\n    Return the fractional part of a positive floating\u2011point number.\n\n    Parameters\n    ----------\n    number : float\n        The number to truncate. Must be a positive float.\n\n    Returns\n    -------\n    float\n        Fractional part of ``number`` in the range [0, 1). 0.0 if ``number`` is an integer.\n\n    Raises\n    ------\n    TypeError\n        If ``number`` is not of type float.\n    ValueError\n        If ``number`` is negative.\n\n    Notes\n    -----\n    - The function performs input validation before computation.\n    - Uses ``int(number)`` for truncating the integer portion, which truncates toward zero.\n    - For large floats, the subtraction preserves the precision within IEEE\u2011754 limits.\n    \"\"\"\n    if not isinstance(number, float):\n        raise TypeError(\"Input must be a float\")\n    if number < 0.0:\n        raise ValueError(\"Input must be non\u2011negative\")\n    integer_part = int(number)\n    fractional = number - integer_part\n    if fractional < 0.0:\n        fractional = 0.0\n    elif fractional >= 1.0:\n        fractional = 1.0 - 1e-15\n    return fractional"}
{"task_id": "HumanEval/3", "solution": "def below_zero(data: list[float]) -> bool:\n    cumulative_sum = 0.0\n    for value in data:\n        cumulative_sum += value\n        if cumulative_sum < 0.0:\n            return True\n    return False"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: list[float]) -> float:\n    \"\"\"\n    For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n\n    Parameters\n    ----------\n    numbers : list[float]\n        List of numerical values.\n\n    Returns\n    -------\n    float\n        The mean absolute deviation of the input numbers.\n\n    Raises\n    ------\n    ValueError\n        If the input list is empty.\n\n    Examples\n    --------\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input list 'numbers' must contain at least one element.\")\n    mean_value = sum(numbers) / len(numbers)\n    total_abs_diff = 0.0\n    for n in numbers:\n        total_abs_diff += abs(n - mean_value)\n    return total_abs_diff / len(numbers)"}
{"task_id": "HumanEval/5", "solution": "def intersperse(iterable: list[object] | tuple[object], separator: object) -> list[object]:\n    \"\"\"Inserts a separator between each pair of elements in an iterable.\n\n    Args:\n        iterable (list[object] | tuple[object]): The input sequence of items.\n        separator (object): The item to insert between elements.\n\n    Returns:\n        list[object]: A new list with the separator interspersed.\n\n    Raises:\n        TypeError: If the first argument is not a list or tuple, or if the separator\n                   is missing.\n\n    Examples:\n        >>> intersperse([1, 2, 3], '-')\n        [1, '-', 2, '-', 3]\n        >>> intersperse([], ',')\n        []\n    \"\"\"\n    if not isinstance(iterable, (list, tuple)):\n        raise TypeError(\"First argument must be a list or tuple\")\n\n    if len(iterable) <= 1:\n        return list(iterable)\n\n    result: list[object] = []\n    for idx, item in enumerate(iterable):\n        result.append(item)\n        if idx < len(iterable) - 1:\n            result.append(separator)\n\n    return result"}
{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(input_str: str) -> list[int]:\n    parts = input_str.split(' ')\n    results: list[int] = []\n    for part in parts:\n        if not part:\n            continue\n        depth = 0\n        max_depth = 0\n        for ch in part:\n            if ch == '(':\n                depth += 1\n                if depth > max_depth:\n                    max_depth = depth\n            elif ch == ')':\n                depth -= 1\n                if depth < 0:\n                    raise ValueError(\"Mismatched parentheses\")\n        if depth != 0:\n            raise ValueError(\"Mismatched parentheses\")\n        results.append(max_depth)\n    return results"}
{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: list[str], substring: str) -> list[str]:\n    \"\"\"Filter a list of strings, returning only those that contain the given substring.\n\n    The function performs a case\u2011sensitive search and preserves the original order of matching elements.\n\n    Parameters\n    ----------\n    strings : list[str]\n        The list of strings to filter.\n    substring : str\n        The substring to search for within each string.\n\n    Returns\n    -------\n    list[str]\n        A new list containing only the strings from `strings` that include `substring`.\n\n    Raises\n    ------\n    TypeError\n        If any element in `strings` is not a string.\n\n    Examples\n    --------\n    >>> filter_by_substring(['apple', 'banana', 'apricot'], 'ap')\n    ['apple', 'apricot']\n\n    >>> filter_by_substring(['test', 'testing', 'best'], 'test')\n    ['test', 'testing']\n\n    >>> filter_by_substring([], 'any')\n    []\n\n    >>> filter_by_substring(['a', 'b', 'c'], '')\n    ['a', 'b', 'c']\n\n    >>> filter_by_substring(['valid', 123, 'strings'], 'v')\n    Traceback (most recent call last):\n        ...\n    TypeError: Element at index 1 is not a string: 123\n    \"\"\"\n    for idx, item in enumerate(strings):\n        if not isinstance(item, str):\n            raise TypeError(f\"Element at index {idx} is not a string: {item}\")\n    result: list[str] = []\n    for s in strings:\n        if substring in s:\n            result.append(s)\n    return result"}
{"task_id": "HumanEval/8", "solution": "def sum_product(values: list[int]) -> tuple[int, int]:\n    \"\"\"\n    Compute the sum and product of a list of integers.\n\n    Parameters\n    ----------\n    values : list[int]\n        The list of integers to aggregate.\n\n    Returns\n    -------\n    tuple[int, int]\n        A tuple containing the sum and product of the integers.\n\n    Raises\n    ------\n    TypeError\n        If any element in `values` is not an int.\n    \"\"\"\n    # Input validation\n    for v in values:\n        if not isinstance(v, int):\n            raise TypeError(\"All elements must be integers.\")\n\n    # Special case for empty list\n    if not values:\n        return 0, 1\n\n    # Aggregate sum and product\n    total_sum = 0\n    total_prod = 1\n    for v in values:\n        total_sum += v\n        total_prod *= v\n\n    return total_sum, total_prod"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: list[int]) -> list[int]:\n    \"\"\"\n    From a given list of integers, generate a list of rolling maximum element found until the given moment\n    in the sequence.\n\n    Example:\n        >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n        [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    # Validate input type\n    if not isinstance(numbers, list):\n        raise TypeError(f\"Expected list[int], got {type(numbers).__name__}\")\n    # Empty list returns an empty result\n    if not numbers:\n        return []\n    result = []\n    current_max = numbers[0]\n    result.append(current_max)\n    for num in numbers[1:]:\n        if not isinstance(num, int):\n            raise TypeError(f\"All elements must be integers, found {type(num).__name__}\")\n        if num > current_max:\n            current_max = num\n        result.append(current_max)\n    return result"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(s: str) -> str:\n    \"\"\"\n    Construct the shortest palindrome that starts with the given string `s`.\n\n    Parameters\n    ----------\n    s : str\n        The input string from which to build the palindrome.\n\n    Returns\n    -------\n    str\n        The shortest palindrome that begins with `s`. If `s` is empty, returns an\n        empty string.\n\n    Raises\n    ------\n    TypeError\n        If `s` is not an instance of :class:`str`.\n\n    Examples\n    --------\n    >>> make_palindrome(\"abca\")\n    'abcbaba'\n    >>> make_palindrome(\"race\")\n    'racecar'\n    >>> make_palindrome(\"\")\n    ''\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n\n    if s == \"\":\n        return \"\"\n\n    n = len(s)\n    max_suffix_len = 0\n\n    for i in range(n - 1, -1, -1):\n        suffix = s[i:]\n        if suffix == suffix[::-1]:\n            max_suffix_len = n - i\n            break\n\n    prefix = s[:n - max_suffix_len]\n    return s + prefix[::-1]"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\"Perform a bitwise XOR on two binary strings of equal length.\n    \n    Args:\n        a: A string composed only of '0' and '1' characters.\n        b: A string composed only of '0' and '1' characters.\n    \n    Returns:\n        A string of the same length where each bit is the result of XOR\n        between the corresponding bits of `a` and `b`.\n    \n    Raises:\n        ValueError: If the input strings are of different lengths or contain\n        characters other than '0' or '1'.\n    \"\"\"\n    if len(a) != len(b):\n        raise ValueError(\"Input strings must have the same length.\")\n    \n    # Validate characters\n    for ch in a + b:\n        if ch not in ('0', '1'):\n            raise ValueError(\"Input strings must consist only of '0' and '1'.\")\n    \n    # Perform XOR using list comprehension\n    result_bits = ['1' if a_bit != b_bit else '0' for a_bit, b_bit in zip(a, b)]\n    return ''.join(result_bits)"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: list[str]) -> str | None:\n    \"\"\"\n    Return the longest string from a list of strings, or None if the list is empty.\n    Ties are broken by returning the first string of the maximum length.\n\n    Parameters\n    ----------\n    strings : list[str]\n        List of strings to search.\n\n    Returns\n    -------\n    str | None\n        The longest string, or None if the input list is empty.\n\n    Raises\n    ------\n    TypeError\n        If the input is not a list of strings.\n\n    Examples\n    --------\n    >>> longest([\"apple\", \"banana\", \"cherry\"])\n    'banana'\n    >>> longest([\"dog\", \"cat\", \"mouse\"])\n    'mouse'\n    >>> longest([\"same\", \"tall\", \"also\"])\n    'same'\n    >>> longest([])\n    None\n    >>> longest([\"one\", 2, \"three\"])\n    Traceback (most recent call last):\n        ...\n    TypeError: All elements must be strings, found <class 'int'> at index 1\n    >>> longest(\"not a list\")\n    Traceback (most recent call last):\n        ...\n    TypeError: Input must be a list of strings, found <class 'str'>\n    \"\"\"\n    if not isinstance(strings, list):\n        raise TypeError(f\"Input must be a list of strings, found {type(strings)}\")\n    if not strings:\n        return None\n    max_len = -1\n    longest_str = None\n    for i, s in enumerate(strings):\n        if not isinstance(s, str):\n            raise TypeError(f\"All elements must be strings, found {type(s)} at index {i}\")\n        if len(s) > max_len:\n            max_len = len(s)\n            longest_str = s\n    return longest_str"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"Compute the greatest common divisor (GCD) of two integers.\n\n    Parameters:\n        a (int): First integer.\n        b (int): Second integer.\n\n    Returns:\n        int: The absolute value of the GCD of a and b.\n             Returns 0 if both a and b are 0.\n\n    Examples:\n        >>> greatest_common_divisor(48, 18)\n        6\n        >>> greatest_common_divisor(-48, 18)\n        6\n        >>> greatest_common_divisor(0, 0)\n        0\n    \"\"\"\n    if a == 0 and b == 0:\n        return 0\n\n    a_abs = abs(a)\n    b_abs = abs(b)\n\n    while b_abs != 0:\n        temp = a_abs % b_abs\n        a_abs = b_abs\n        b_abs = temp\n\n    return a_abs"}
{"task_id": "HumanEval/14", "solution": "def all_prefixes(string: str) -> list[str]:\n    \"\"\"Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string\")\n    prefixes: list[str] = []\n    for i in range(1, len(string) + 1):\n        prefixes.append(string[:i])\n    return prefixes"}
{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\"Return a string containing numbers from 0 to `n` inclusive separated by single spaces.\n\n    Parameters\n    ----------\n    n : int\n        Non\u2011negative integer.\n\n    Returns\n    -------\n    str\n        Sequence \"0 1 2 ... n\" with no leading or trailing spaces.\n    \"\"\"\n    return ' '.join(str(i) for i in range(n + 1))"}
{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(s: str) -> int:\n    \"\"\"Count the number of distinct characters in a string, ignoring case.\n\n    Parameters\n    ----------\n    s : str\n        The string to be analyzed. The function treats all characters in a\n        case\u2011insensitive manner; 'A' and 'a' are considered the same.\n\n    Returns\n    -------\n    int\n        The number of unique characters present in the string after\n        normalizing case. The count includes all Unicode code points\n        that appear in the input.\n\n    Example\n    -------\n    >>> count_distinct_characters(\"Hello World!\")\n    6\n        # 'h', 'e', 'l', 'o', ' ', 'w', 'r', 'd', '!' -> 9 distinct characters\n        # but case is ignored so 'H'/'h', 'W'/'w' count once each\n    \"\"\"\n    normalized = s.lower()\n    unique_chars = set(normalized)\n    return len(unique_chars)"}
{"task_id": "HumanEval/17", "solution": "def parse_music(music_string: str) -> list[int]:\n    \"\"\"Parse a string of musical notes in ASCII format and return the duration of each note in beats.\n\n    The notation is:\n      'o'   : whole note (4 beats)\n      'o|'  : half note (2 beats)\n      '.|'  : quarter note (1 beat)\n\n    Parameters\n    ----------\n    music_string : str\n        The input string containing notes separated by whitespace.\n\n    Returns\n    -------\n    list[int]\n        A list of integers where each integer is the beat count of a note.\n    \"\"\"\n    durations: list[int] = []\n\n    for token in music_string.split():\n        if token == 'o':\n            durations.append(4)\n        elif token == 'o|':\n            durations.append(2)\n        elif token == '.|':\n            durations.append(1)\n        # Unknown tokens are ignored; adjust as needed.\n\n    return durations"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\"Find how many times a given substring can be found in the original string.\n    Count overlapping cases.\n\n    Args:\n        string: The string to search within.\n        substring: The substring to search for.\n\n    Returns:\n        The number of occurrences of substring in string, counting overlaps.\n        If the substring is empty, returns 0.\n    \"\"\"\n    if not substring:\n        return 0\n    sub_len = len(substring)\n    max_start = len(string) - sub_len\n    if max_start < 0:\n        return 0\n    count = 0\n    for i in range(max_start + 1):\n        if string[i:i + sub_len] == substring:\n            count += 1\n    return count"}
{"task_id": "HumanEval/19", "solution": "def sort_numbers(numbers: str) -> str:\n    \"\"\"\n    Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest.\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    # Mapping of word to numeric value\n    word_to_value: dict[str, int] = {\n        'zero': 0,\n        'one': 1,\n        'two': 2,\n        'three': 3,\n        'four': 4,\n        'five': 5,\n        'six': 6,\n        'seven': 7,\n        'eight': 8,\n        'nine': 9\n    }\n    # Reverse mapping for output\n    value_to_word: list[str] = [\n        'zero', 'one', 'two', 'three', 'four',\n        'five', 'six', 'seven', 'eight', 'nine'\n    ]\n\n    if not numbers:\n        return ''\n\n    try:\n        words = numbers.split()\n        values = [word_to_value[word] for word in words]\n    except KeyError as e:\n        raise ValueError(f\"Invalid number word: {e.args[0]}\") from None\n\n    values.sort()\n    sorted_words = [value_to_word[v] for v in values]\n    return ' '.join(sorted_words)"}
{"task_id": "HumanEval/20", "solution": "def find_closest_elements(numbers: list[float]) -> tuple[float, float]:\n    \"\"\"\n    Find the pair of numbers with the smallest absolute difference.\n\n    Parameters\n    ----------\n    numbers : list[float]\n        A list of at least two floating point numbers.\n\n    Returns\n    -------\n    tuple[float, float]\n        The closest pair, sorted in ascending order.\n\n    Raises\n    ------\n    ValueError\n        If the input list has fewer than two elements.\n    \"\"\"\n    if len(numbers) < 2:\n        raise ValueError(\"Input list must contain at least two elements.\")\n\n    sorted_numbers = sorted(numbers)\n    min_diff = float('inf')\n    closest_pair = (0.0, 0.0)\n\n    for i in range(len(sorted_numbers) - 1):\n        a = sorted_numbers[i]\n        b = sorted_numbers[i + 1]\n        diff = abs(b - a)\n        if diff < min_diff:\n            min_diff = diff\n            closest_pair = (a, b)\n\n    return closest_pair"}
{"task_id": "HumanEval/21", "solution": "def rescale_to_unit(data: list[float]) -> list[float]:\n    if len(data) < 2:\n        raise ValueError(\"Input list must contain at least two elements.\")\n    min_value = min(data)\n    max_value = max(data)\n    if min_value == max_value:\n        return [0.0 for _ in data]\n    scale = max_value - min_value\n    return [(x - min_value) / scale for x in data]"}
{"task_id": "HumanEval/22", "solution": "def filter_integers(values: list[object]) -> list[int]:\n    \"\"\"Filter the given list for integer values only.\n\n    >>> filter_integers(['a', 3.14, 5])\n    [5]\n    >>> filter_integers([1, 2, 3, 'abc', {}, []])\n    [1, 2, 3]\n    \"\"\"\n    return [value for value in values if isinstance(value, int)]"}
{"task_id": "HumanEval/23", "solution": "\"\"\"robust_strlen_module.strlen\n\nProvides a single function, `robust_strlen`, that returns the length of a string.\nThe function validates its input, handles None gracefully, and includes\ndetailed documentation.\n\"\"\"\n\ndef robust_strlen(s: str | None) -> int:\n    \"\"\"Return the length of a string.\n\n    Parameters\n    ----------\n    s : str | None\n        The string whose length is to be measured. If ``None`` is passed,\n        the function returns 0 instead of raising an exception.\n\n    Returns\n    -------\n    int\n        The number of characters in ``s``. Returns 0 if ``s`` is None.\n\n    Raises\n    ------\n    TypeError\n        If ``s`` is not a string or None.\n\n    Examples\n    --------\n    >>> robust_strlen(\"hello\")\n    5\n    >>> robust_strlen(\"\")\n    0\n    >>> robust_strlen(None)\n    0\n    >>> robust_strlen(42)\n    Traceback (most recent call last):\n        ...\n    TypeError: Input must be a string or None.\n    \"\"\"\n    if s is None:\n        return 0\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string or None.\")\n    return len(s)"}
{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\"\n    Return the largest proper divisor of a positive integer `n`.\n\n    Parameters\n    ----------\n    n : int\n        The integer whose largest proper divisor is requested.\n        Must be greater than 1.\n\n    Returns\n    -------\n    int\n        The largest integer `d` such that `1 <= d < n` and `n % d == 0`.\n        For a prime `n`, returns 1.\n\n    Raises\n    ------\n    ValueError\n        If `n` is not an integer, or if `n <= 1`.\n    \"\"\"\n    if not isinstance(n, int) or n <= 1:\n        raise ValueError(\"n must be an integer greater than 1\")\n\n    max_div = 1\n    limit = int(n ** 0.5)\n    for i in range(2, limit + 1):\n        if n % i == 0:\n            max_div = max(max_div, n // i)\n    return max_div"}
{"task_id": "HumanEval/25", "solution": "def factorize(n: int) -> list[int]:\n    if n <= 1:\n        raise ValueError(\"n must be > 1\")\n\n    factors: list[int] = []\n\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    divisor = 3\n    while divisor * divisor <= n:\n        while n % divisor == 0:\n            factors.append(divisor)\n            n //= divisor\n        divisor += 2\n\n    if n > 1:\n        factors.append(n)\n\n    return factors"}
{"task_id": "HumanEval/26", "solution": "def remove_duplicates(numbers: list[int]) -> list[int]:\n    \"\"\"\n    From a list of integers, return a new list containing only those elements\n    that appear exactly once in the input, preserving the original order.\n\n    Args:\n        numbers: A list of integers.\n\n    Returns:\n        A list of integers that occur only once in the input list.\n\n    Raises:\n        TypeError: If the input is not a list or contains non-integer elements.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"numbers must be a list of ints\")\n    # Count frequencies\n    freq: dict[int, int] = {}\n    for num in numbers:\n        if not isinstance(num, int):\n            raise TypeError(\"all elements must be ints\")\n        freq[num] = freq.get(num, 0) + 1\n    # Build result preserving order\n    return [num for num in numbers if freq[num] == 1]"}
{"task_id": "HumanEval/27", "solution": "def flip_case(s: str) -> str:\n    \"\"\"Flip the case of every alphabetic character in the input string.\n\n    Parameters:\n        s (str): Input string to transform.\n\n    Returns:\n        str: New string with each letter's case inverted; other characters unchanged.\n    \"\"\"\n    result_chars = []\n    for c in s:\n        if c.islower():\n            result_chars.append(c.upper())\n        elif c.isupper():\n            result_chars.append(c.lower())\n        else:\n            result_chars.append(c)\n    return ''.join(result_chars)"}
{"task_id": "HumanEval/28", "solution": "def concatenate(strings: list[str]) -> str:\n    \"\"\"Concatenate a list of strings into a single string.\n\n    Examples\n    --------\n    >>> concatenate([])\n    ''\n    >>> concatenate(['a', 'b', 'c'])\n    'abc'\n    \"\"\"\n    if not isinstance(strings, list):\n        raise TypeError(\"Expected a list of strings\")\n    for item in strings:\n        if not isinstance(item, str):\n            raise TypeError(f\"Expected all elements to be strings, got {type(item)}\")\n    result = ''\n    for s in strings:\n        result += s\n    return result"}
{"task_id": "HumanEval/29", "solution": "def filter_by_prefix(strings: list[str], prefix: str) -> list[str]:\n    \"\"\"\n    Filter a list of strings by a given prefix.\n\n    The function returns a new list containing only the strings from the\n    input list that start with the specified prefix. It performs explicit\n    type checking and raises a TypeError if the inputs are not of the\n    expected types.\n\n    Parameters\n    ----------\n    strings : list[str]\n        The list of strings to filter.\n    prefix : str\n        The prefix to match at the beginning of each string.\n\n    Returns\n    -------\n    list[str]\n        A list of strings from `strings` that start with `prefix`.\n\n    Raises\n    ------\n    TypeError\n        If `strings` is not a list of strings or if `prefix` is not a string.\n\n    Examples\n    --------\n    >>> filter_by_prefix(['apple', 'banana', 'apricot', 'cherry'], 'ap')\n    ['apple', 'apricot']\n\n    >>> filter_by_prefix([], 'a')\n    []\n\n    >>> filter_by_prefix(['one', 2, 'three'], 't')\n    Traceback (most recent call last):\n        ...\n    TypeError: strings must be a list of strings\n\n    >>> filter_by_prefix(['one', 'two'], 123)\n    Traceback (most recent call last):\n        ...\n    TypeError: prefix must be a string\n    \"\"\"\n    if not isinstance(prefix, str):\n        raise TypeError(\"prefix must be a string\")\n    if not isinstance(strings, list) or not all(isinstance(s, str) for s in strings):\n        raise TypeError(\"strings must be a list of strings\")\n    return [s for s in strings if s.startswith(prefix)]"}
{"task_id": "HumanEval/30", "solution": "def get_positive(nums: list[float]) -> list[float]:\n    if not isinstance(nums, list):\n        raise TypeError(\"nums must be a list\")\n    positives: list[float] = []\n    for x in nums:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"all elements must be numeric\")\n        if x > 0:\n            positives.append(x)\n    return positives"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"\n    Determine whether an integer n is a prime number.\n\n    Args:\n        n (int): The integer to check for primality.\n\n    Returns:\n        bool: True if n is prime, False otherwise.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    limit = int(n ** 0.5)\n    i = 3\n    while i <= limit:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list) -> float:\n    def f(x: float) -> float:\n        return poly(xs, x)\n    # If zero is an exact root, return it immediately\n    if f(0.0) == 0.0:\n        return 0.0\n    left = 0.0\n    right = 1.0\n    # Expand interval until a sign change is found\n    while f(left) * f(right) > 0:\n        left -= 1.0\n        right += 1.0\n    # Bisection method to approximate the root\n    for _ in range(100):\n        mid = (left + right) / 2.0\n        if f(left) * f(mid) <= 0:\n            right = mid\n        else:\n            left = mid\n    return (left + right) / 2.0"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list) -> list:\n    \"\"\"Sort elements at indices divisible by three.\n\n    Parameters\n    ----------\n    l : list\n        The input list.\n\n    Returns\n    -------\n    list\n        A new list with elements at indices divisible by three sorted.\n\n    Raises\n    ------\n    TypeError\n        If the input is not a list.\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list\")\n\n    # Identify indices that are divisible by three\n    indices = [i for i in range(len(l)) if i % 3 == 0]\n    if not indices:\n        # No indices to sort, return a copy of the original list\n        return l[:]\n\n    # Extract the values at those indices\n    values = [l[i] for i in indices]\n\n    try:\n        sorted_values = sorted(values)\n    except TypeError as exc:\n        # Re\u2011raise with a clearer message\n        raise TypeError(\"Elements at indices divisible by three must be comparable\") from exc\n\n    # Create a copy of the original list to avoid mutation\n    result = l[:]\n\n    # Place sorted values back into their respective positions\n    for idx, val in zip(indices, sorted_values):\n        result[idx] = val\n\n    return result"}
{"task_id": "HumanEval/34", "solution": "def unique(data: list[object]) -> list[object]:\n    \"\"\"\n    Return a sorted list of unique elements from the input list.\n\n    Parameters\n    ----------\n    data : list[object]\n        The input list containing elements to be de\u2011duplicated and sorted.\n        All elements must be hashable and support the '<' comparison operator.\n\n    Returns\n    -------\n    list[object]\n        A new list containing each distinct element from `data` exactly once,\n        sorted in ascending order.\n\n    Raises\n    ------\n    TypeError\n        If `data` is not a list.\n    ValueError\n        If any element in `data` is not hashable or not comparable (i.e. does\n        not support the '<' operator).\n\n    Notes\n    -----\n    - The function does not alter the input list.\n    - Time complexity: O(n log n) due to sorting.\n    - Space complexity: O(n) for the auxiliary set and result list.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input must be a list.\")\n    # Validate elements: hashable and comparable\n    temp_set = set()\n    for element in data:\n        try:\n            temp_set.add(element)\n        except TypeError:\n            raise ValueError(\"All elements must be hashable.\") from None\n        try:\n            _ = element < element\n        except Exception:\n            raise ValueError(\"All elements must support comparison.\") from None\n    # De\u2011duplication using a set\n    unique_list = list(temp_set)\n    # Sorting\n    return sorted(unique_list)"}
{"task_id": "HumanEval/35", "solution": "def max_element(values: list[float]) -> float:\n    \"\"\"Return the maximum numeric value from a list.\n\n    The function iterates over the provided list of numeric values\n    (both integers and floats) and returns the maximum element.\n    An empty list results in a ValueError.\n\n    Args:\n        values: A list of numbers (int or float). Must not be empty.\n\n    Returns:\n        The maximum value in the list, as a float.\n\n    Raises:\n        ValueError: If 'values' is an empty list.\n\n    Doctest:\n        >>> max_element([1, 2, 3])\n        3\n        >>> max_element([3.5, 2.1, 3.5])\n        3.5\n        >>> max_element([])\n        Traceback (most recent call last):\n            ...\n        ValueError: The input list is empty and cannot determine a maximum.\n    \"\"\"\n    if not values:\n        raise ValueError(\"The input list is empty and cannot determine a maximum.\")\n    max_val = float(values[0])\n    for x in values[1:]:\n        fx = float(x)\n        if fx > max_val:\n            max_val = fx\n    return max_val"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n <= 0:\n        return 0\n\n    total = 0\n    # Process multiples of 11\n    for x in range(11, n, 11):\n        total += str(x).count('7')\n\n    # Process multiples of 13, skip those already counted (divisible by 11)\n    for x in range(13, n, 13):\n        if x % 11 != 0:\n            total += str(x).count('7')\n\n    return total"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list[object]) -> list[object]:\n    even_vals = [val for i, val in enumerate(l) if i % 2 == 0]\n    sorted_even = sorted(even_vals)\n    result = l.copy()\n    even_idx = 0\n    for i in range(len(l)):\n        if i % 2 == 0:\n            result[i] = sorted_even[even_idx]\n            even_idx += 1\n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string into the same groups used during encoding\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse the rotation applied to each 3\u2011character group\n    decoded_groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(decoded_groups)"}
{"task_id": "HumanEval/39", "solution": "def is_prime(num: int) -> bool:\n    \"\"\"\n    Return True if num is a prime number, False otherwise.\n    \"\"\"\n    if num <= 1:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    limit = int(num**0.5) + 1\n    divisor = 3\n    while divisor <= limit:\n        if num % divisor == 0:\n            return False\n        divisor += 2\n    return True\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    Return the n-th Fibonacci number that is also prime.\n\n    Parameters\n    ----------\n    n : int\n        The position (1-indexed) of the desired prime Fibonacci number.\n        Must be a positive integer.\n\n    Returns\n    -------\n    int\n        The n-th prime Fibonacci number.\n\n    Raises\n    ------\n    ValueError\n        If n is not a positive integer.\n\n    Examples\n    --------\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n    count = 0\n    prev = 0\n    curr = 1\n    while True:\n        next_fib = prev + curr\n        prev, curr = curr, next_fib\n        if is_prime(next_fib):\n            count += 1\n            if count == n:\n                return next_fib"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(nums: list[int]) -> bool:\n    \"\"\"\n    Return True if there exist indices i, j, k with i < j < k such that\n    nums[i] + nums[j] + nums[k] == 0; otherwise return False.\n    \"\"\"\n    n = len(nums)\n    if n < 3:\n        return False\n\n    sorted_nums = sorted(nums)\n    for i in range(n - 2):\n        left = i + 1\n        right = n - 1\n        while left < right:\n            current_sum = sorted_nums[i] + sorted_nums[left] + sorted_nums[right]\n            if current_sum == 0:\n                return True\n            if current_sum < 0:\n                left += 1\n            else:\n                right -= 1\n    return False"}
{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int) -> int:\n    \"\"\"\n    Calculate the square of a non\u2011negative integer.\n\n    Parameters\n    ----------\n    n : int\n        The integer to square. Must be a non\u2011negative integer.\n\n    Returns\n    -------\n    int\n        The result of n multiplied by itself.\n\n    Raises\n    ------\n    TypeError\n        If n is not an instance of int.\n    ValueError\n        If n is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    return n * n"}
