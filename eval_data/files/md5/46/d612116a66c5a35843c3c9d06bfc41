{"task_id": "HumanEval/82", "solution": "def is_prime(n: int) -> bool:\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef prime_length(s: str) -> bool:\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n    length = len(s)\n    return is_prime(length)"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n: int) -> int:\n    \"\"\"\n    Count n-digit positive integers that start with 1 or end with 1 (or both).\n    \"\"\"\n    if n < 1:\n        raise ValueError(\"n must be at least 1\")\n    if n == 1:\n        return 1\n    pow10_n_minus_2 = pow(10, n - 2)\n    return 18 * pow10_n_minus_2"}
{"task_id": "HumanEval/84", "solution": "def solve(N: int) -> str:\n    if not isinstance(N, int):\n        raise TypeError(\"N must be an integer\")\n    if N < 0:\n        raise ValueError(\"N must be non\u2011negative\")\n    digit_sum = 0\n    for ch in str(N):\n        digit_sum += ord(ch) - 48  # ord('0') == 48\n    return bin(digit_sum)[2:]"}
{"task_id": "HumanEval/85", "solution": "def add(nums: list[int]) -> int:\n    if not isinstance(nums, list):\n        raise TypeError(\"Input must be a list.\")\n    if len(nums) == 0:\n        raise ValueError(\"Input list must not be empty.\")\n    for idx, element in enumerate(nums):\n        if not isinstance(element, int):\n            raise TypeError(\"All elements must be integers.\")\n    total = 0\n    for i, x in enumerate(nums):\n        if i % 2 == 1 and x % 2 == 0:\n            total += x\n    return total"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s: str) -> str:\n    \"\"\"\n    Return a string where each word in the input string is replaced by a word\n    with its characters sorted in ascending ASCII order. The order of words\n    and the spaces between them are preserved.\n\n    Parameters\n    ----------\n    s : str\n        The input string to process.\n\n    Returns\n    -------\n    str\n        The processed string with each word's characters sorted.\n    \"\"\"\n    result = []\n    word = []\n    for ch in s:\n        if ch == ' ':\n            if word:\n                result.append(''.join(sorted(word)))\n                word = []\n            result.append(' ')\n        else:\n            word.append(ch)\n    if word:\n        result.append(''.join(sorted(word)))\n    return ''.join(result)"}
{"task_id": "HumanEval/87", "solution": "def get_row(matrix: list[list[int]], x: int) -> list[tuple[int, int]]:\n    \"\"\"Locate every occurrence of x in a 2D list and return a list of\n    (row_index, col_index) tuples sorted by row ascending and column descending.\n    \"\"\"\n    if not matrix:\n        return []\n    coords: list[tuple[int, int]] = []\n    for row_index, row in enumerate(matrix):\n        if not row:\n            continue\n        for col_index, value in enumerate(row):\n            if value == x:\n                coords.append((row_index, col_index))\n    return sorted(coords, key=lambda p: (p[0], -p[1]))"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array: list[int]) -> list[int]:\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum(first index value, last index value)\n    is odd, or sort it in descending order if the sum(first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    # Validate input type\n    if not isinstance(array, list):\n        raise TypeError(\"Input must be a list\")\n\n    # Validate elements\n    for idx, val in enumerate(array):\n        if not isinstance(val, int):\n            raise TypeError(f\"Element at index {idx} is not an integer\")\n        if val < 0:\n            raise ValueError(f\"Element at index {idx} is negative; only non-negative integers are allowed\")\n\n    # If array is empty, return empty list\n    if not array:\n        return []\n\n    # Determine sort order based on sum of first and last elements\n    first_val = array[0]\n    last_val = array[-1]\n    sum_first_last = first_val + last_val\n    ascending = sum_first_last % 2 == 1  # odd => ascending\n\n    # Return sorted copy\n    sorted_copy = sorted(array)\n    if not ascending:\n        sorted_copy = sorted_copy[::-1]\n    return sorted_copy"}
{"task_id": "HumanEval/89", "solution": "import logging\nfrom cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes\nfrom cryptography.hazmat.primitives import padding\nfrom cryptography.hazmat.backends import default_backend\nlogger = logging.getLogger(__name__)\ndef encrypt(plaintext: str, key: bytes, iv: bytes) -> bytes:\n    \"\"\"Encrypts the given plaintext using AES\u2011256-CBC with PKCS#7 padding.\n\n    Parameters:\n        plaintext: The text to encrypt. UTF\u20118 encoded internally.\n        key: 32\u2011byte secret key for AES\u2011256.\n        iv: 16\u2011byte initialization vector for CBC mode.\n\n    Returns:\n        Ciphertext as a bytes object.\n\n    Raises:\n        ValueError: If key length is not 32 bytes or IV length is not 16 bytes.\n        TypeError: If any argument is not of the expected type.\n        Exception: For unexpected encryption failures.\n    \"\"\"\n    # Input validation\n    if not isinstance(plaintext, str):\n        raise TypeError(\"plaintext must be a str\")\n    if not isinstance(key, bytes):\n        raise TypeError(\"key must be bytes\")\n    if not isinstance(iv, bytes):\n        raise TypeError(\"iv must be bytes\")\n    if len(key) != 32:\n        raise ValueError(\"key must be 32 bytes long\")\n    if len(iv) != 16:\n        raise ValueError(\"iv must be 16 bytes long\")\n\n    logger.debug(\n        \"Starting encryption: plaintext length=%d, key length=%d, iv length=%d\",\n        len(plaintext),\n        len(key),\n        len(iv),\n    )\n\n    try:\n        # Encode plaintext to UTF\u20118 bytes\n        plaintext_bytes = plaintext.encode(\"utf-8\")\n\n        # Pad plaintext\n        padder = padding.PKCS7(algorithms.AES.block_size).padder()\n        padded_data = padder.update(plaintext_bytes) + padder.finalize()\n\n        # Encrypt\n        cipher = Cipher(algorithms.AES(key), modes.CBC(iv), backend=default_backend())\n        encryptor = cipher.encryptor()\n        ciphertext = encryptor.update(padded_data) + encryptor.finalize()\n\n        logger.debug(\"Encryption successful: ciphertext length=%d\", len(ciphertext))\n        return ciphertext\n\n    except Exception as e:\n        logger.exception(\"Encryption failed\")\n        raise Exception(\"Encryption failed\") from e"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst: list[int]) -> int | None:\n    \"\"\"\n    Return the second smallest distinct integer in `lst`.\n    If `lst` contains fewer than two distinct values, return None.\n\n    Parameters\n    ----------\n    lst : list[int]\n        A list of integers.\n\n    Returns\n    -------\n    int | None\n        The second smallest distinct integer or None if not found.\n    \"\"\"\n    if not lst:\n        return None\n\n    min_val: int | None = None\n    second_min: int | None = None\n\n    for number in lst:\n        if min_val is None or number < min_val:\n            second_min = min_val\n            min_val = number\n        elif number != min_val:\n            if second_min is None or number < second_min:\n                second_min = number\n\n    return second_min"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S: str) -> int:\n    \"\"\"\n    Return the number of sentences in ``S`` that start with the uppercase\n    letter 'I'. Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    if not isinstance(S, str):\n        raise TypeError(\"Input must be of type str\")\n\n    count = 0\n    sentence_start = True\n\n    for ch in S:\n        if sentence_start:\n            # Skip any leading whitespace for the sentence\n            if ch in (\" \", \"\\t\", \"\\n\", \"\\r\"):\n                continue\n            if ch == \"I\":\n                count += 1\n            sentence_start = False\n\n        # End of sentence detected\n        if ch in (\".\", \"?\", \"!\"):\n            sentence_start = True\n\n    return count"}
