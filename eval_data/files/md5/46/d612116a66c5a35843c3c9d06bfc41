{"task_id": "HumanEval/62", "solution": "def derivative(xs: list[float]) -> list[float]:\n    \"\"\"\n    xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n    Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    if not isinstance(xs, list):\n        raise TypeError(\"Input must be a list of numbers.\")\n    for idx, val in enumerate(xs):\n        if not isinstance(val, (int, float)):\n            raise TypeError(f\"All coefficients must be numeric, but element at index {idx} is {type(val).__name__}.\")\n    if len(xs) == 0:\n        return []\n    return [i * xs[i] for i in range(1, len(xs))]"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int) -> int:\n    \"\"\"Compute the n-th element of the fibfib sequence.\n\n    Parameters:\n        n (int): The index in the fibfib sequence (must be non-negative).\n\n    Returns:\n        int: The value of fibfib(n).\n\n    Raises:\n        ValueError: If n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be a non\u2011negative integer\")\n\n    if n == 0 or n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    a, b, c = 0, 0, 1  # fibfib(0), fibfib(1), fibfib(2)\n    for _ in range(3, n + 1):\n        next_val = a + b + c\n        a, b, c = b, c, next_val\n\n    return c"}
{"task_id": "HumanEval/64", "solution": "import string\ndef vowels_count(text: object) -> int:\n    \"\"\"Counts vowels in the supplied text.\n\n    Parameters\n    ----------\n    text : object\n        The input to analyze. Expected to be a string; other types are tolerated.\n\n    Returns\n    -------\n    int\n        The number of vowel characters in the input string. For empty strings\n        or non\u2011string inputs the function returns 0.\n    \"\"\"\n    if not isinstance(text, str):\n        return 0\n\n    lower_text = text.lower()\n    count = 0\n\n    # Count aeiou\n    for ch in lower_text:\n        if ch in \"aeiou\":\n            count += 1\n\n    # Count trailing y at end of words\n    for word in lower_text.split():\n        stripped = word.strip(string.punctuation)\n        if stripped.endswith('y'):\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x: int, shift: int) -> str:\n    \"\"\"\n    Circularly shift the decimal digits of an integer to the right.\n\n    The function interprets the digits of the absolute value of `x` as a\n    string and performs a circular right shift by `shift` positions.\n    If `shift` exceeds the number of digits, the function returns the\n    reversed digit sequence instead.\n\n    Parameters\n    ----------\n    x : int\n        The integer whose digits are to be shifted.\n    shift : int\n        Non\u2011negative integer indicating how many positions to shift right.\n        If shift > number of digits, the digits are reversed.\n\n    Returns\n    -------\n    str\n        The resulting digit sequence after the circular shift or\n        reversal.\n\n    Raises\n    ------\n    TypeError\n        If `x` or `shift` is not an integer.\n    ValueError\n        If `shift` is negative.\n\n    Examples\n    --------\n    >>> circular_shift(12345, 2)\n    '45123'\n    >>> circular_shift(12345, 5)\n    '54321'\n    >>> circular_shift(123, 7)\n    '321'\n    >>> circular_shift(-9876, 3)\n    '8769'\n    >>> circular_shift(0, 0)\n    '0'\n    >>> circular_shift(123, -1)\n    Traceback (most recent call last):\n        ...\n    ValueError: shift must be non\u2011negative\n    >>> circular_shift('abc', 1)\n    Traceback (most recent call last):\n        ...\n    TypeError: x must be an integer\n    \"\"\"\n    if not isinstance(x, int):\n        raise TypeError(\"x must be an integer\")\n    if not isinstance(shift, int):\n        raise TypeError(\"shift must be an integer\")\n    if shift < 0:\n        raise ValueError(\"shift must be non\u2011negative\")\n\n    digits = str(abs(x))\n    n = len(digits)\n\n    if shift == 0:\n        return digits\n    if shift > n:\n        return digits[::-1]\n\n    shift_mod = shift % n\n    if shift_mod == 0:\n        return digits\n    return digits[-shift_mod:] + digits[:-shift_mod]"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s: str) -> int:\n    if not isinstance(s, str):\n        raise TypeError(f\"digitSum() expects a string, got {type(s).__name__}\")\n    total = 0\n    for ch in s:\n        if 'A' <= ch <= 'Z':\n            total += ord(ch)\n    return total"}
{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s: str, n: int) -> int:\n    \"\"\"\n    Calculates the number of mangoes in a basket given a descriptive string of apples and oranges\n    and the total number of fruits.\n\n    The input string should contain two integer numbers: the number of apples and the number of oranges.\n    The function extracts those numbers and subtracts their sum from the total number of fruits.\n\n    Parameters\n    ----------\n    s : str\n        A string describing the number of apples and oranges, e.g. \"5 apples and 6 oranges\".\n    n : int\n        The total number of fruits in the basket.\n\n    Returns\n    -------\n    int\n        The number of mangoes in the basket.\n\n    Raises\n    ------\n    ValueError\n        If the input string does not contain two integer numbers.\n    \"\"\"\n    # Split the string into words and look for integer tokens\n    words = s.split()\n    apple: int | None = None\n    orange: int | None = None\n\n    for word in words:\n        if word.isdigit():\n            if apple is None:\n                apple = int(word)\n            elif orange is None:\n                orange = int(word)\n                break\n\n    if apple is None or orange is None:\n        raise ValueError(\"Input string must contain two integer numbers representing apples and oranges.\")\n\n    return n - apple - orange"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr: list[int]) -> list[int]:\n    \"\"\"\n    Return the smallest even number in arr along with its index.\n    If no even numbers or arr is empty, return an empty list.\n    \"\"\"\n    best_value: int | None = None\n    best_index: int | None = None\n\n    for idx, value in enumerate(arr):\n        if value % 2 == 0:\n            if best_value is None or value < best_value:\n                best_value = value\n                best_index = idx\n            # If the value equals the current best_value, we keep the first occurrence\n            # so we do nothing in that case.\n\n    if best_value is None:\n        return []\n\n    return [best_value, best_index]"}
{"task_id": "HumanEval/69", "solution": "def search(nums: list[int]) -> int:\n    \"\"\"Find the greatest positive integer x in nums such that\n    the count of x in nums is at least x.\n    If no such integer exists, return -1.\n\n    Parameters:\n        nums: A non-empty list of positive integers.\n\n    Returns:\n        int: The greatest qualifying integer or -1.\n\n    Raises:\n        ValueError: If nums is empty or contains non-positive integers.\n    \"\"\"\n    if not nums:\n        raise ValueError(\"Input list must not be empty.\")\n    freq = {}\n    for v in nums:\n        if v <= 0:\n            raise ValueError(\"All elements must be positive integers.\")\n        freq[v] = freq.get(v, 0) + 1\n    best = -1\n    for value, count in freq.items():\n        if count >= value and value > best:\n            best = value\n    return best"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(values: list[int]) -> list[int]:\n    if len(values) == 0:\n        raise ValueError(\"Empty list provided\")\n    if len(set(values)) != len(values):\n        raise ValueError(\"List contains duplicate values\")\n    sorted_list = sorted(values)\n    result: list[int] = []\n    left = 0\n    right = len(sorted_list) - 1\n    while left <= right:\n        result.append(sorted_list[left])\n        if left != right:\n            result.append(sorted_list[right])\n        left += 1\n        right -= 1\n    return result"}
{"task_id": "HumanEval/71", "solution": "def triangle_area(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Calculate the area of a triangle using Heron's formula.\n\n    Parameters\n    ----------\n    a : float\n        Length of side a.\n    b : float\n        Length of side b.\n    c : float\n        Length of side c.\n\n    Returns\n    -------\n    float\n        The area rounded to two decimal places if the sides form a valid triangle;\n        otherwise, returns -1.\n\n    Raises\n    ------\n    TypeError\n        If any of the arguments is not an int or float.\n    \"\"\"\n    for name, val in ((\"a\", a), (\"b\", b), (\"c\", c)):\n        if not isinstance(val, (int, float)):\n            raise TypeError(f\"{name} must be int or float, got {type(val).__name__}\")\n\n    if a <= 0 or b <= 0 or c <= 0:\n        return -1\n\n    if a + b <= c or a + c <= b or b + c <= a:\n        return -1\n\n    s = (a + b + c) / 2.0\n    area_sq = s * (s - a) * (s - b) * (s - c)\n    if area_sq <= 0:\n        return -1\n\n    area = area_sq ** 0.5\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q: list, w: float) -> bool:\n    \"\"\"Determine if the list `q` is a palindrome and its sum is <= `w`.\n\n    Parameters\n    ----------\n    q : list\n        List of numeric or comparable elements.\n    w : float or int\n        Threshold value for the sum of `q`.\n\n    Returns\n    -------\n    bool\n        True if `q` is a palindrome and sum(q) <= w, False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If `q` is not a list or `w` is not a numeric type.\n    \"\"\"\n    if not isinstance(q, list):\n        raise TypeError(\"q must be a list\")\n    if not isinstance(w, (int, float)):\n        raise TypeError(\"w must be a numeric type\")\n\n    left = 0\n    right = len(q) - 1\n    while left < right:\n        if q[left] != q[right]:\n            return False\n        left += 1\n        right -= 1\n\n    total = 0\n    for item in q:\n        total += item\n\n    return total <= w"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr: list[int]) -> int:\n    \"\"\"Count the minimal number of element changes required to make arr palindromic.\n\n    Parameters\n    ----------\n    arr : list[int]\n        The input list of integers.\n\n    Returns\n    -------\n    int\n        Minimum number of changes.\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    half = n // 2\n    for i in range(half):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1: list[str], lst2: list[str]) -> list[str]:\n    \"\"\"\n    Returns the list with the smaller total number of characters.\n    If both lists have the same total, returns the first list.\n    \"\"\"\n    total1 = sum(len(s) for s in lst1)\n    total2 = sum(len(s) for s in lst2)\n    return lst1 if total1 <= total2 else lst2"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a: int) -> bool:\n    \"\"\"Check whether a < 100 can be expressed as the product of exactly three prime numbers.\"\"\"\n    if not isinstance(a, int):\n        raise TypeError(\"Input must be an integer\")\n    if a <= 0 or a >= 100:\n        raise ValueError(\"Input must satisfy 0 < a < 100\")\n\n    remaining = a\n    factor_count = 0\n    p = 2\n    while p * p <= remaining:\n        while remaining % p == 0:\n            factor_count += 1\n            remaining //= p\n        p += 1\n    if remaining > 1:\n        factor_count += 1\n\n    return factor_count == 3"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x: int, n: int) -> bool:\n    \"\"\"Return True if there exists an integer k such that x == n ** k.\n    Raises TypeError if x or n is not an integer.\n    \"\"\"\n    if type(x) is not int or type(n) is not int:\n        raise TypeError(\"x and n must be integers\")\n\n    # Special cases\n    if x == 1:\n        return n != 0\n    if n == 0:\n        return x == 0\n    if n == 1:\n        return x == 1\n    if n == -1:\n        return x in (1, -1)\n\n    # Zero cannot be expressed as a non\u2011zero base raised to any power\n    if x == 0:\n        return False\n\n    # Positive base cannot produce a negative result\n    if x < 0 and n > 0:\n        return False\n\n    base_abs = abs(n)\n    current = abs(x)\n    exponent = 0\n\n    while current % base_abs == 0:\n        current //= base_abs\n        exponent += 1\n\n    if current != 1:\n        return False\n\n    # At this point, x == (abs(n) ** exponent) in magnitude\n    if n > 0:\n        return True\n\n    # n is negative: parity of exponent determines the sign\n    if exponent % 2 == 0:\n        return x > 0\n    else:\n        return x < 0"}
{"task_id": "HumanEval/77", "solution": "def iscube(a: int) -> bool:\n    \"\"\"Return True if integer a is a perfect cube, False otherwise.\n    Uses binary search over the non\u2011negative integer domain.\n    Handles negative values by comparing to the absolute value.\"\"\"\n    if a == 0:\n        return True\n\n    abs_a = a if a >= 0 else -a\n    low = 0\n    high = abs_a\n\n    while low <= high:\n        mid = (low + high) // 2\n        mid_cubed = mid * mid * mid\n\n        if a >= 0:\n            if mid_cubed == a:\n                return True\n            elif mid_cubed < a:\n                low = mid + 1\n            else:\n                high = mid - 1\n        else:\n            if mid_cubed == -a:\n                return True\n            elif mid_cubed < -a:\n                low = mid + 1\n            else:\n                high = mid - 1\n\n    return False"}
{"task_id": "HumanEval/78", "solution": "def hex_key(hex_str: str) -> int:\n    \"\"\"Count prime hexadecimal digits in an uppercase hex string.\n\n    Parameters\n    ----------\n    hex_str : str\n        A string of uppercase hexadecimal characters (0\u20119, A\u2011F).\n\n    Returns\n    -------\n    int\n        The number of characters in `hex_str` that are prime digits\n        (2, 3, 5, 7, B, D).\n    \"\"\"\n    prime_digits = {'2', '3', '5', '7', 'B', 'D'}\n    count = 0\n    for c in hex_str:\n        if c in prime_digits:\n            count += 1\n    return count"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal: int) -> str:\n    \"\"\"\n    Convert a non\u2011negative integer from decimal to a binary string with\n    a leading and trailing 'db' marker.\n\n    Parameters\n    ----------\n    decimal : int\n        The number to convert. Must be a non\u2011negative integer.\n\n    Returns\n    -------\n    str\n        Binary representation of ``decimal`` surrounded by 'db' markers.\n\n    Raises\n    ------\n    TypeError\n        If ``decimal`` is not an instance of ``int``.\n    ValueError\n        If ``decimal`` is negative.\n    \"\"\"\n    # Validate the input type\n    if not isinstance(decimal, int):\n        raise TypeError(f\"Expected an int, got {type(decimal).__name__}\")\n\n    # Validate the input value\n    if decimal < 0:\n        raise ValueError(\"Negative numbers are not supported\")\n\n    # Special case for zero to avoid an empty string from bin(0)\n    if decimal == 0:\n        binary_part = \"0\"\n    else:\n        # bin() returns a string like '0b1010'; strip the '0b' prefix\n        binary_part = bin(decimal)[2:]\n\n    # Wrap the binary string with the required 'db' markers\n    return f\"db{binary_part}db\""}
