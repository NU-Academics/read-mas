{"task_id": "HumanEval/135", "solution": "def can_arrange(nums: list[int]) -> int:\n    if len(nums) < 2:\n        return -1\n    last_inversion = -1\n    for i in range(1, len(nums)):\n        if nums[i] < nums[i - 1]:\n            last_inversion = i\n    return last_inversion"}
{"task_id": "HumanEval/136", "solution": "def find_extremes(nums: list[int]) -> tuple[int | None, int | None]:\n    \"\"\"\n    Find the largest negative and the smallest positive integers in a list.\n\n    Parameters\n    ----------\n    nums : list[int]\n        The list of integers to analyze.\n\n    Returns\n    -------\n    tuple[int | None, int | None]\n        A 2\u2011tuple where the first element is the largest negative integer\n        found or None if no negative numbers exist, and the second element\n        is the smallest positive integer found or None if no positive numbers exist.\n\n    Edge Cases\n    ----------\n    * Empty list -> (None, None)\n    * No negative numbers -> (None, smallest positive)\n    * No positive numbers -> (largest negative, None)\n    * Zero values are ignored as they are neither negative nor positive\n    * Duplicate values do not affect the result\n    \"\"\"\n    max_neg: int | None = None\n    min_pos: int | None = None\n    for x in nums:\n        if x < 0:\n            if max_neg is None or x > max_neg:\n                max_neg = x\n        elif x > 0:\n            if min_pos is None or x < min_pos:\n                min_pos = x\n    return max_neg, min_pos"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a: int | float | str, b: int | float | str) -> int | float | str | None:\n    # Type validation\n    if not isinstance(a, (int, float, str)):\n        raise TypeError(\"First argument must be int, float, or str\")\n    if not isinstance(b, (int, float, str)):\n        raise TypeError(\"Second argument must be int, float, or str\")\n\n    # Parsing to numeric values\n    try:\n        num_a = float(a) if isinstance(a, str) else a\n    except ValueError:\n        raise ValueError(f\"String '{a}' is not a valid real number\")\n\n    try:\n        num_b = float(b) if isinstance(b, str) else b\n    except ValueError:\n        raise ValueError(f\"String '{b}' is not a valid real number\")\n\n    # Comparison\n    if num_a > num_b:\n        return a\n    if num_b > num_a:\n        return b\n    return None"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n: int) -> bool:\n    \"\"\"\n    Determine if an integer can be expressed as the sum of exactly four positive even numbers.\n\n    The smallest sum of four positive even numbers is 8 (2 + 2 + 2 + 2).  \n    Because the sum of even numbers is always even, a valid representation exists\n    if and only if the input is an even integer greater than or equal to 8.\n\n    Parameters\n    ----------\n    n : int\n        The integer to test.\n\n    Returns\n    -------\n    bool\n        True if `n` can be written as the sum of four positive even integers,\n        False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If `n` is not an instance of `int`.\n\n    Examples\n    --------\n    >>> is_equal_to_sum_even(10)\n    True   # 2 + 2 + 2 + 4\n\n    >>> is_equal_to_sum_even(7)\n    False  # cannot satisfy constraints\n\n    >>> is_equal_to_sum_even(12.5)\n    Traceback (most recent call last):\n        ...\n    TypeError: Input must be an integer\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer\")\n    return n >= 8 and n % 2 == 0"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n: int) -> int:\n    \"\"\"\n    Return the Brazilian factorial of n, defined as the product of all\n    factorials from 1! up to n!.\n\n    Raises:\n        ValueError: If n is not a positive integer.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    result = 1\n    current_factorial = 1\n    for i in range(1, n + 1):\n        current_factorial *= i\n        result *= current_factorial\n\n    return result"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(s: str) -> str:\n    \"\"\"\n    Normalizes whitespace in the input string by stripping leading and trailing spaces,\n    collapsing any sequence of whitespace characters (spaces, tabs, newlines) into a\n    single space, and preserving the original text otherwise.\n\n    Parameters\n    ----------\n    s : str\n        The string to normalize.\n\n    Returns\n    -------\n    str\n        The normalized string.\n    \"\"\"\n    result = []\n    prev_ws = False\n    for ch in s:\n        if ch.isspace():\n            if not prev_ws:\n                result.append(' ')\n                prev_ws = True\n        else:\n            result.append(ch)\n            prev_ws = False\n    return ''.join(result).strip()"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name: str) -> str:\n    # Trim leading/trailing whitespace\n    trimmed = file_name.strip()\n    if not trimmed:\n        return 'No'\n\n    allowed_chars = set(\n        \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.\")\n    period_count = 0\n    prev_char = ''\n    for ch in trimmed:\n        if ch not in allowed_chars:\n            return 'No'\n        if ch == '.':\n            period_count += 1\n            if period_count > 1:\n                return 'No'\n            if prev_char == '.':\n                return 'No'  # consecutive periods\n        prev_char = ch\n\n    if period_count:\n        if trimmed[0] == '.' or trimmed[-1] == '.':\n            return 'No'\n        base, ext = trimmed.split('.', 1)\n        if not (1 <= len(ext) <= 4):\n            return 'No'\n    else:\n        base = trimmed\n\n    if not (1 <= len(base) <= 255):\n        return 'No'\n\n    reserved = {\n        \"CON\", \"PRN\", \"AUX\", \"NUL\", \"COM1\", \"COM2\", \"COM3\", \"COM4\", \"COM5\", \"COM6\", \"COM7\", \"COM8\",\n        \"COM9\", \"LPT1\", \"LPT2\", \"LPT3\", \"LPT4\", \"LPT5\", \"LPT6\", \"LPT7\", \"LPT8\", \"LPT9\"\n    }\n    if base.upper() in reserved:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst: list[int]) -> int:\n    \"\"\"Return the sum of the transformed list according to the rules specified.\"\"\"\n    if type(lst) is not list:\n        raise TypeError(\"Input must be a list\")\n    if len(lst) == 0:\n        return 0\n    for item in lst:\n        if type(item) is not int:\n            raise TypeError(\"All elements must be integers\")\n    total = 0\n    for i in range(len(lst)):\n        value = lst[i]\n        if i % 3 == 0:\n            transformed = value * value\n        elif i % 4 == 0:\n            transformed = value * value * value\n        else:\n            transformed = value\n        total += transformed\n    return total"}
{"task_id": "HumanEval/143", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Return True if n is a prime number, False otherwise.\"\"\"\n    if n < 2:\n        return False\n    if n == 2 or n == 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"Return words of prime length from the input sentence as a space-separated string.\n\n    Parameters\n    ----------\n    sentence : str\n        The input sentence to process.\n\n    Returns\n    -------\n    str\n        Space-separated prime-length words. Empty if none found.\n\n    Raises\n    ------\n    TypeError\n        If the input is not a string.\n    \"\"\"\n    if not isinstance(sentence, str):\n        raise TypeError(\"Input must be a string\")\n\n    words = sentence.split()\n    prime_words: list[str] = []\n\n    for w in words:\n        if is_prime(len(w)):\n            prime_words.append(w)\n\n    return \" \".join(prime_words)"}
{"task_id": "HumanEval/144", "solution": "def simplify(x: str, n: str) -> bool:\n    \"\"\"Return True if the product of the two fractions is a whole number.\"\"\"\n    # Parse the first fraction\n    try:\n        num1_str, den1_str = x.split(\"/\")\n        num1 = int(num1_str)\n        den1 = int(den1_str)\n    except Exception:\n        # Invalid format or non-integer values\n        return False\n\n    # Parse the second fraction\n    try:\n        num2_str, den2_str = n.split(\"/\")\n        num2 = int(num2_str)\n        den2 = int(den2_str)\n    except Exception:\n        return False\n\n    # Compute the product numerator and denominator\n    product_num = num1 * num2\n    product_den = den1 * den2\n\n    # The product is a whole number if the numerator is divisible by the denominator\n    if product_den == 0:\n        return False\n    return product_num % product_den == 0"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"\n    Write a function which sorts the given list of integers\n    in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their index in original list.\n\n    For example:\n    >>> order_by_points([1, 11, -1, -11, -12]) == [-1, -11, 1, -12, 11]\n    >>> order_by_points([]) == []\n    \"\"\"\n    def digit_sum(n: int) -> int:\n        total = 0\n        for d in str(abs(n)):\n            total += int(d)\n        return total\n\n    # Enumerate to preserve original indices for stable sorting\n    enumerated = list(enumerate(nums))\n    # Sort by (digit sum, original index)\n    sorted_enumerated = sorted(enumerated, key=lambda pair: (digit_sum(pair[1]), pair[0]))\n    # Extract sorted numbers\n    return [num for _, num in sorted_enumerated]"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(numbers: list[int]) -> int:\n    odd_digits = {1, 3, 5, 7, 9}\n    count = 0\n    for num in numbers:\n        abs_num = abs(num)\n        if abs_num <= 10:\n            continue\n        s = str(abs_num)\n        first_digit = int(s[0])\n        last_digit = int(s[-1])\n        if first_digit in odd_digits and last_digit in odd_digits:\n            count += 1\n    return count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n: int) -> int:\n    \"\"\"\n    Counts the number of index triples (i, j, k) with 0 <= i < j < k < n\n    such that a[i] + a[j] + a[k] is divisible by 3, where\n    a[i] = i^2 - i + 1.\n    \"\"\"\n    full_groups = n // 3\n    remainder = n % 3\n    count0 = full_groups\n    if remainder == 2:\n        count0 += 1\n    count1 = n - count0\n\n    def comb3(m: int) -> int:\n        if m < 3:\n            return 0\n        return m * (m - 1) * (m - 2) // 6\n\n    return comb3(count0) + comb3(count1)"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closest to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    # Canonical list of planets in order from the Sun\n    planets = [\n        \"Mercury\",\n        \"Venus\",\n        \"Earth\",\n        \"Mars\",\n        \"Jupiter\",\n        \"Saturn\",\n        \"Uranus\",\n        \"Neptune\",\n    ]\n\n    # Create a mapping from lowercase names to canonical names\n    name_map = {p.lower(): p for p in planets}\n\n    # Normalize input names\n    key1 = planet1.strip().lower()\n    key2 = planet2.strip().lower()\n\n    # Validate names\n    if key1 not in name_map or key2 not in name_map:\n        return ()\n\n    # Find indices\n    idx1 = planets.index(name_map[key1])\n    idx2 = planets.index(name_map[key2])\n\n    # Determine the slice bounds\n    start = min(idx1, idx2) + 1\n    end = max(idx1, idx2)\n\n    # Slice the list and return as a tuple\n    return tuple(planets[start:end])"}
{"task_id": "HumanEval/149", "solution": "def list_sort(strings: list[str]) -> list[str]:\n    \"\"\"Sort strings by length and alphabetically, keeping only even\u2011length strings.\"\"\"\n    # Input validation\n    for s in strings:\n        if type(s) is not str:\n            raise TypeError(f\"Non-string element encountered: {s!r}\")\n\n    # Filter even\u2011length strings\n    filtered = [s for s in strings if len(s) % 2 == 0]\n\n    # Sort by length then alphabetically\n    return sorted(filtered, key=lambda s: (len(s), s))"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"Return `x` if `n` is a prime number, otherwise return `y`.\n\n    Parameters\n    ----------\n    n : int\n        The number to test for primality.\n    x : any\n        Value to return if `n` is prime.\n    y : any\n        Value to return if `n` is not prime.\n\n    Returns\n    -------\n    any\n        `x` or `y` depending on whether `n` is prime.\n    \"\"\"\n    def _is_prime(num: int) -> bool:\n        \"\"\"Check whether an integer is prime.\n\n        Handles negative numbers, 0, and 1 as non\u2011prime.\n        \"\"\"\n        if num <= 1:\n            return False\n        if num <= 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    try:\n        if _is_prime(int(n)):\n            return x\n        else:\n            return y\n    except Exception:\n        # If n cannot be cast to int or other error, default to y\n        return y"}
