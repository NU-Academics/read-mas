{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\"\"\"\n    # The implementation calculates the n-th Fibonacci number using an iterative approach.\n    a, b = 1, 1  # Initialize for F(1) and F(2)\n    for _ in range(n - 1):  # Iterate n-1 times to reach the n-th number\n        a, b = b, a + b\n    return a"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    n = len(l)\n    if n <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(n - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False\n        if l[i] < l[i+1]:\n            is_decreasing = False\n        \n        # Optimization: if neither increasing nor decreasing, it's not monotonic\n        if not is_increasing and not is_decreasing:\n            return False\n\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for bracket in brackets:\n        if bracket == '<':\n            balance += 1\n        elif bracket == '>':\n            balance -= 1\n        if balance < 0:  # A closing bracket appeared without a matching opening bracket\n            return False\n    return balance == 0"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    counter = 0\n    for char in brackets:\n        if char == '(':\n            counter += 1\n        elif char == ')':\n            counter -= 1\n        \n        if counter < 0:\n            return False\n            \n    return counter == 0"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_elements = set1.intersection(set2)\n    return sorted(list(common_elements))"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n\n    # Divide by 2 until n is odd\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Iterate through odd numbers starting from 3\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            largest_factor = d\n            n //= d\n        d += 2\n\n    # If n is still greater than 1, it must be a prime factor itself\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/60", "solution": "class SumCalculator:\n    \"\"\"Encapsulates the logic for summing numbers up to n.\"\"\"\n    def __init__(self, n: int):\n        self._n = n\n\n    def sum_to_n(self) -> int:\n        \"\"\"Calculates the sum of integers from 1 to _n.\"\"\"\n        return self._n * (self._n + 1) // 2\ndef sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n    \n    calculator = SumCalculator(n)\n    return calculator.sum_to_n()"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    result = []\n    for i in range(len(xs) - 1):\n        new_coefficient = (i + 1) * xs[i + 1]\n        result.append(new_coefficient)\n    return result"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    \"\"\"\n    if not s:\n        return 0\n\n    vowels = set(\"aeiouAEIOU\")\n    count = 0\n\n    for i, ch in enumerate(s):\n        if ch in vowels:\n            count += 1\n        elif ch in \"yY\" and i == len(s) - 1:\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    s = str(x)\n    num_digits = len(s)\n\n    if shift > num_digits:\n        return s[::-1]\n    else:\n        effective_shift = shift % num_digits\n        # Perform circular right shift\n        # The last `effective_shift` digits move to the front\n        # The remaining digits follow\n        shifted_s = s[num_digits - effective_shift:] + s[:num_digits - effective_shift]\n        return shifted_s"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    # Use a list for memoization (dynamic programming)\n    # The size of dp will be n+1 to store values from 0 to n.\n    dp = [0] * (n + 1)\n    dp[0] = 0\n    dp[1] = 0\n    dp[2] = 1\n\n    # Calculate fibfib numbers iteratively up to n\n    for i in range(3, n + 1):\n        dp[i] = dp[i-1] + dp[i-2] + dp[i-3]\n\n    return dp[n]"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Task\n    Write a function that takes a string as input and returns the sum of the upper characters only'\n    ASCII codes.\n\n    Examples:\n        digitSum(\"\") => 0\n        digitSum(\"abAB\") => 131\n        digitSum(\"abcCd\") => 67\n        digitSum(\"helloE\") => 69\n        digitSum(\"woArBld\") => 131\n        digitSum(\"aAaaaXa\") => 153\n    \"\"\"\n    total = 0\n    for ch in s:\n        if 'A' <= ch <= 'Z':\n            total += ord(ch)\n    return total"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given a string description\n    of apples and oranges and the total fruit count.\n    \"\"\"\n    pattern = r\"(\\d+) apples and (\\d+) oranges\"\n    match = re.search(pattern, s)\n    \n    # Extract apple and orange counts, converting them to integers.\n    apples = int(match.group(1))\n    oranges = int(match.group(2))\n    \n    # Calculate and return the number of mangoes.\n    return n - apples - oranges"}
{"task_id": "HumanEval/69", "solution": "import collections\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    counts = collections.Counter(lst)\n    \n    max_valid_num = -1\n    \n    # Iterate through unique numbers in descending order to find the greatest qualifying one.\n    for num in sorted(counts.keys(), reverse=True):\n        if counts[num] >= num:\n            max_valid_num = num\n            break\n            \n    return max_valid_num"}
{"task_id": "HumanEval/68", "solution": "from typing import List\ndef pluck(arr: List[int]) -> List[int]:\n    \"\"\"\n    Finds the smallest even value in the array and its smallest index.\n    Returns [value, index] or [] if no even values are found.\n    \"\"\"\n    smallest_even_value = None\n    smallest_even_index = None\n\n    for i, num in enumerate(arr):\n        if num % 2 == 0:  # Check if the number is even\n            if smallest_even_value is None or num < smallest_even_value:\n                smallest_even_value = num\n                smallest_even_index = i\n\n    if smallest_even_value is not None:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    \"\"\"\n    if not lst:\n        return []\n\n    sorted_list = sorted(lst)\n    result = []\n    min_turn = True\n\n    while sorted_list:\n        if min_turn:\n            # Take the minimum element\n            result.append(sorted_list.pop(0))\n        else:\n            # Take the maximum element\n            result.append(sorted_list.pop())\n        min_turn = not min_turn\n        \n    return result"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    # Check if sides are positive\n    if a <= 0 or b <= 0 or c <= 0:\n        return -1\n    \n    # Check triangle inequality theorem\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1\n    \n    # Calculate semi-perimeter\n    s = (a + b + c) / 2\n    \n    # Calculate area using Heron's formula\n    area_squared = s * (s - a) * (s - b) * (s - c)\n    \n    # Due to floating point precision, area_squared might be very slightly negative for valid triangles\n    # if it's supposed to be zero. Handle this to avoid math.sqrt(negative) error.\n    if area_squared < 0:\n        area_squared = 0\n\n    area = math.sqrt(area_squared)\n    \n    # Round the area to 2 decimal points\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"\n    Checks if an object q will fly based on two conditions:\n    1. It is balanced (a palindromic list).\n    2. The sum of its elements is less than or equal to the maximum possible weight w.\n    \"\"\"\n    is_balanced = (q == q[::-1])\n    total_weight = sum(q)\n    weight_within_limit = (total_weight <= w)\n    \n    return is_balanced and weight_within_limit"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic.\n    \"\"\"\n    n = len(arr)\n    count = 0\n    # Iterate through the first half of the array, comparing elements\n    # with their symmetric counterparts from the end of the array.\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            count += 1\n    return count"}
{"task_id": "HumanEval/75", "solution": "def prime_factors(n: int) -> list[int]:\n    \"\"\"Return a list of prime factors of n (with multiplicity).\"\"\"\n    factors = []\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n    p = 3\n    while p * p <= n:\n        while n % p == 0:\n            factors.append(p)\n            n //= p\n        p += 2\n    if n > 1:\n        factors.append(n)\n    return factors\ndef is_multiply_prime(a):\n    \"\"\"Return True if a is the product of exactly three prime numbers.\n    Assumes 'a' is an integer between 1 and 99.\n    \"\"\"\n    factors = prime_factors(a)\n    return len(factors) == 3"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    \"\"\"\n    Calculates the total number of characters in each list of strings.\n    Returns the list with fewer characters, or the first list if counts are equal.\n    \"\"\"\n    total1 = sum(len(s) for s in lst1)\n    total2 = sum(len(s) for s2 in lst2)\n\n    if total1 < total2:\n        return lst1\n    elif total2 < total1:\n        return lst2\n    else:\n        return lst1"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if a number x is a simple power of n (n**integer_exponent = x).\n    Handles edge cases for n <= 1 or x <= 0, and correctly identifies x=1 as n^0.\n    \"\"\"\n    if n <= 1 or x <= 0:\n        return False\n\n    if x == 1:\n        return True\n\n    current_x = x\n    while current_x % n == 0:\n        current_x //= n\n    \n    return current_x == 1"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Write a function that takes an integer a and returns True \n    if this ingeger is a cube of some integer number.\n    Note: you may assume the input is always valid.\n    Examples:\n    iscube(1) ==> True\n    iscube(2) ==> False\n    iscube(-1) ==> True\n    iscube(64) ==> True\n    iscube(0) ==> True\n    iscube(180) ==> False\n    '''\n    if a == 0:\n        return True\n    \n    abs_a = abs(a)\n    # Binary search for the integer cube root of abs_a.\n    # The upper bound for the search is int(abs_a ** (1/3)) + 2 to be safe,\n    # or just int(abs_a ** (1/3)) + 1 as per the design.\n    low, high = 1, int(abs_a ** (1/3)) + 2 \n\n    while low <= high:\n        mid = (low + high) // 2\n        cube = mid ** 3\n        if cube == abs_a:\n            return True\n        elif cube < abs_a:\n            low = mid + 1\n        else:\n            high = mid - 1\n            \n    return False"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts the number of prime hexadecimal digits in a given string.\n    The prime hexadecimal digits are 2, 3, 5, 7, B (11), D (13).\n    \"\"\"\n    prime_decimal_values = {2, 3, 5, 7, 11, 13}\n    prime_count = 0\n    \n    for char_digit in num:\n        # Convert hexadecimal character to its decimal equivalent\n        # This simulates the HexDigit parsing and value retrieval\n        decimal_value = int(char_digit, 16)\n        \n        # Check if the decimal value is one of the specified primes\n        # This simulates the isPrime() check from HexDigit\n        if decimal_value in prime_decimal_values:\n            prime_count += 1\n            \n    return prime_count"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a decimal number to its binary string representation,\n    prefixed and suffixed with 'db'.\n    \"\"\"\n    if decimal == 0:\n        binary_representation = \"0\"\n    else:\n        binary_digits = []\n        current_decimal = decimal\n        while current_decimal > 0:\n            remainder = current_decimal % 2\n            binary_digits.append(str(remainder))\n            current_decimal //= 2\n        binary_representation = \"\".join(binary_digits[::-1])\n\n    return f\"db{binary_representation}db\""}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"Checks if a string is happy.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct.\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        if s[i] == s[i+1] or s[i] == s[i+2] or s[i+1] == s[i+2]:\n            return False\n    return True"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of GPAs into a list of corresponding letter grades based on a predefined scale.\"\"\"\n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append('A+')\n        elif gpa > 3.7:\n            letter_grades.append('A')\n        elif gpa > 3.3:\n            letter_grades.append('A-')\n        elif gpa > 3.0:\n            letter_grades.append('B+')\n        elif gpa > 2.7:\n            letter_grades.append('B')\n        elif gpa > 2.3:\n            letter_grades.append('B-')\n        elif gpa > 2.0:\n            letter_grades.append('C+')\n        elif gpa > 1.7:\n            letter_grades.append('C')\n        elif gpa > 1.3:\n            letter_grades.append('C-')\n        elif gpa > 1.0:\n            letter_grades.append('D+')\n        elif gpa > 0.7:\n            letter_grades.append('D')\n        elif gpa > 0.0:\n            letter_grades.append('D-')\n        else: # Assumes gpa is 0.0 or less, mapping 0.0 to 'E'\n            letter_grades.append('E')\n    return letter_grades"}
{"task_id": "HumanEval/82", "solution": "import math\ndef prime_length(string):\n    \"\"\"Checks if the length of a string is a prime number.\n    Returns True if the length is prime, False otherwise.\"\"\"\n    length = len(string)\n\n    if length < 2:\n        return False\n    if length == 2:\n        return True\n    if length % 2 == 0:\n        return False\n\n    # Check for factors from 3 up to the square root of length, only odd numbers\n    limit = int(math.isqrt(length)) + 1\n    for i in range(3, limit, 2):\n        if length % i == 0:\n            return False\n    return True"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    This implementation applies the formula 10**(n-1) + 8 * 10**(n-2) and casts the result to an integer.\n    \"\"\"\n    return int(10**(n - 1) + 8 * 10**(n - 2))"}
