{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x == 0:\n        return '0'\n\n    res = []\n    while x > 0:\n        remainder = x % base\n        res.append(str(remainder))\n        x //= base\n    \n    return \"\".join(res[::-1])"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"Computes the n-th element of the Fib4 number sequence efficiently without recursion.\n    The sequence is defined by base cases and a recurrence relation.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the last four values required for the recurrence\n    # [fib4(k-4), fib4(k-3), fib4(k-2), fib4(k-1)]\n    # For k=4, these are fib4(0), fib4(1), fib4(2), fib4(3)\n    a, b, c, d = 0, 0, 2, 0\n\n    for _ in range(4, n + 1):\n        # Calculate the next Fib4 number\n        next_fib = a + b + c + d\n        # Shift the window: a becomes b, b becomes c, c becomes d, d becomes next_fib\n        a, b, c, d = b, c, d, next_fib\n    \n    return d"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\"\"\"\n    n = len(l)\n    sorted_l = sorted(l)\n\n    if n % 2 == 1:\n        # Odd number of elements, return the middle element\n        return sorted_l[n // 2]\n    else:\n        # Even number of elements, return the average of the two middle elements\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2.0"}
