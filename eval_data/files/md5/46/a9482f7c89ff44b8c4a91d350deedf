{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    # Create a copy to store the result, ensuring the original list is not modified.\n    result = list(l)\n\n    # Extract elements from even indices.\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n\n    # Sort the extracted even elements.\n    even_elements.sort()\n\n    # Place the sorted even elements back into the even indices of the result list.\n    sorted_even_idx = 0\n    for i in range(0, len(l), 2):\n        result[i] = even_elements[sorted_even_idx]\n        sorted_even_idx += 1\n\n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "class PrimeChecker:\n    \"\"\"Checks if a number is prime.\"\"\"\n    def is_prime(self, num: int) -> bool:\n        if num < 2:\n            return False\n        i = 2\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 1\n        return True\nclass FibonacciGenerator:\n    \"\"\"Generates Fibonacci numbers (1, 1, 2, 3, 5, ...).\"\"\"\n    def __init__(self):\n        self._a = 1  # Current F(k-1)\n        self._b = 1  # Current F(k)\n        self._counter = 0 # Tracks how many numbers have been generated\n\n    def generate(self) -> int:\n        self._counter += 1\n        if self._counter == 1:\n            return 1 # F_1\n        elif self._counter == 2:\n            return 1 # F_2\n        else:\n            # For F_3 onwards\n            next_val = self._a + self._b\n            self._a = self._b\n            self._b = next_val\n            return next_val\nclass PrimeFibonacciSequence:\n    \"\"\"Orchestrates finding the n-th prime Fibonacci number.\"\"\"\n    def __init__(self):\n        self._generator = FibonacciGenerator()\n        self._checker = PrimeChecker()\n\n    def get_prime_fibonacci(self, n: int) -> int:\n        count = 0\n        \n        # Advance the generator past F_1=1 and F_2=1 as they are not prime.\n        self._generator.generate() # Skips F_1 = 1\n        self._generator.generate() # Skips F_2 = 1\n\n        while True:\n            fib_num = self._generator.generate()\n            if self._checker.is_prime(fib_num):\n                count += 1\n                if count == n:\n                    return fib_num\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    sequence_finder = PrimeFibonacciSequence()\n    return sequence_finder.get_prime_fibonacci(n)"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    if len(l) < 3:\n        return False\n\n    # The algorithm iterates through all unique pairs (a, b) and\n    # checks if the third required number (c = -(a + b)) exists in the remainder of the list.\n    for i in range(len(l)):\n        a = l[i]\n        for j in range(i + 1, len(l)):\n            b = l[j]\n            c_needed = -(a + b)\n            # Check for c_needed in the part of the list after index j\n            if c_needed in l[j + 1:]:\n                return True\n    return False"}
