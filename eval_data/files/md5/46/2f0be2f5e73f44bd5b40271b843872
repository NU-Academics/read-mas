{"task_id": "Mbpp/160", "solution": "def find_solution(a, b, n):\n    # Extended Euclidean Algorithm to find gcd and coefficients\n    def extended_gcd(a, b):\n        if b == 0:\n            return a, 1, 0\n        gcd, x1, y1 = extended_gcd(b, a % b)\n        x = y1\n        y = x1 - (a // b) * y1\n        return gcd, x, y\n    \n    gcd, x, y = extended_gcd(a, b)\n    \n    # Check if solution exists\n    if n % gcd != 0:\n        return None\n    \n    # Scale the solution\n    factor = n // gcd\n    return (x * factor, y * factor)"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(arr):\n    \"\"\"Sorts array using pancake sort algorithm by repeatedly flipping portions.\"\"\"\n    def flip(arr, k):\n        return arr[:k+1][::-1] + arr[k+1:]\n    \n    def find_max_index(arr, n):\n        max_idx = 0\n        for i in range(1, n):\n            if arr[i] > arr[max_idx]:\n                max_idx = i\n        return max_idx\n    \n    n = len(arr)\n    for curr_size in range(n, 1, -1):\n        max_idx = find_max_index(arr, curr_size)\n        if max_idx != curr_size - 1:\n            if max_idx != 0:\n                arr = flip(arr, max_idx)\n            arr = flip(arr, curr_size - 1)\n    \n    return arr"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a, b, n):\n    def extended_gcd(a, b):\n        if a == 0:\n            return b, 0, 1\n        gcd, x1, y1 = extended_gcd(b % a, a)\n        x = y1 - (b // a) * x1\n        y = x1\n        return gcd, x, y\n    \n    gcd, x, y = extended_gcd(abs(a), abs(b))\n    \n    if n % gcd != 0:\n        return None\n    \n    x *= n // gcd\n    y *= n // gcd\n    \n    if a < 0:\n        x = -x\n    if b < 0:\n        y = -y\n    \n    return (x, y)"}
