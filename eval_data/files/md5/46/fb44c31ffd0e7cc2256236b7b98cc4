{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    l_prime = list(l) # Create a copy to preserve original and odd indices\n\n    even_values = []\n    for i in range(len(l)):\n        if i % 2 == 0:\n            even_values.append(l[i])\n\n    even_values.sort()\n\n    even_idx_counter = 0\n    for i in range(len(l_prime)):\n        if i % 2 == 0:\n            l_prime[i] = even_values[even_idx_counter]\n            even_idx_counter += 1\n\n    return l_prime"}
{"task_id": "HumanEval/32", "solution": "import math\n\nclass InvalidCoefficientsError(ValueError):\n    \"\"\"Custom exception for invalid polynomial coefficients.\"\"\"\n    def __init__(self, message=\"Invalid coefficients for find_zero: list must have an even number of elements.\"):\n        super().__init__(message)\n\nclass Polynomial:\n    \"\"\"Encapsulates polynomial coefficients and provides methods for evaluation and zero-finding.\"\"\"\n    def __init__(self, coefficients: list[float]):\n        self._coefficients = coefficients\n\n    def evaluate(self, x: float) -> float:\n        \"\"\"Evaluates the polynomial at a given point x.\"\"\"\n        return sum([coeff * math.pow(x, i) for i, coeff in enumerate(self._coefficients)])\n\n    def find_zero(self) -> float:\n        \"\"\"\n        Finds and returns a single zero point for the polynomial using the bisection method.\n        Assumes a root exists within a reasonable range.\n        \"\"\"\n        # Find an initial interval [low_bound, high_bound] that brackets a root\n        abs_val = 1.0\n        max_range_exp_loops = 100 # Safety limit for expanding search range\n\n        # For an odd-degree polynomial, a root is guaranteed to exist.\n        # The function will have opposite signs at sufficiently large positive and negative x.\n        for _ in range(max_range_exp_loops):\n            f_low = self.evaluate(-abs_val)\n            f_high = self.evaluate(abs_val)\n\n            if f_low * f_high <= 0: # Found an interval with a sign change\n                low_bound = -abs_val\n                high_bound = abs_val\n                break\n            abs_val *= 2.0 # Exponentially expand the search range\n        else:\n            # Fallback if no sign change found within max_range_exp_loops,\n            # which theoretically should not happen given the problem's guarantee.\n            low_bound = -abs_val\n            high_bound = abs_val\n\n        # Perform bisection method\n        tolerance = 1e-6 # Desired accuracy for the root\n        max_bisection_iterations = 100 # Safety limit for bisection iterations\n\n        # Re-evaluate f_low and f_high for the determined bracketed interval\n        f_low = self.evaluate(low_bound)\n        f_high = self.evaluate(high_bound)\n\n        for _ in range(max_bisection_iterations):\n            mid = (low_bound + high_bound) / 2\n            f_mid = self.evaluate(mid)\n\n            if abs(f_mid) < tolerance:\n                return mid # Root found within tolerance\n\n            if f_low * f_mid < 0: # Root is in the left half [low_bound, mid]\n                high_bound = mid\n                f_high = f_mid\n            else: # Root is in the right half [mid, high_bound]\n                low_bound = mid\n                f_low = f_mid\n        \n        # If max iterations reached, return the midpoint as the best approximation\n        return (low_bound + high_bound) / 2\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Constraint from NFR1: \"xs must have an even number of elements.\"\n    if len(xs) % 2 != 0:\n        raise InvalidCoefficientsError()\n\n    poly_instance = Polynomial(xs)\n    return poly_instance.find_zero()"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups, each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    # e.g., 'bca' becomes 'abc' by moving the last char to the front.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/40", "solution": "```python\ndef triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    if len(l) < 3:\n        return False\n\n    n = len(l)\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n\n    return False\n```"}
{"task_id": "HumanEval/39", "solution": "import math\nfrom typing import Generator\n\ndef _is_prime(num: int) -> bool:\n    \"\"\"\n    _is_prime checks if a number is prime.\n    A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself.\n    \"\"\"\n    if num < 2:\n        return False\n    for i in range(2, int(math.sqrt(num)) + 1):\n        if num % i == 0:\n            return False\n    return True\n\ndef _fibonacci_generator() -> Generator[int, None, None]:\n    \"\"\"\n    _fibonacci_generator yields Fibonacci numbers indefinitely, starting with 0, 1, 1, 2, 3, 5...\n    For prime_fib, we are interested in numbers >= 2, so the first few values might be skipped.\n    \"\"\"\n    a, b = 0, 1\n    while True:\n        yield a\n        a, b = b, a + b\n\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    if n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    fib_gen = _fibonacci_generator()\n    prime_fib_count = 0\n    result = 0\n\n    # Skip initial Fibonacci numbers 0 and 1 as they are not prime (or 1 is not considered prime)\n    # The first prime Fibonacci number is 2.\n    next(fib_gen) # yields 0\n    next(fib_gen) # yields 1\n    next(fib_gen) # yields 1\n\n    while prime_fib_count < n:\n        current_fib = next(fib_gen)\n        if _is_prime(current_fib):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                result = current_fib\n                break\n\n    return result"}
