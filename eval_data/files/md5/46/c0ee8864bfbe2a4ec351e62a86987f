omplexNumber:\n    \"\"\"Represents a complex number with real and imaginary parts.\"\"\"\n    def __init__(self, real: float, imag: float):\n        self.real = real\n        self.imag = imag\n\n    @staticmethod\n    def from_numeric(n) -> 'ComplexNumber':\n        \"\"\"Creates a ComplexNumber from int, float, or complex input.\"\"\"\n        if isinstance(n, complex):\n            return ComplexNumber(float(n.real), float(n.imag))\n        elif isinstance(n, (int, float)):\n            return ComplexNumber(float(n), 0.0)\n        else:\n            raise TypeError(\"Unsupported input type for convert: expected int, float, or complex\")\nclass InputValidator:\n    \"\"\"Validates input and converts it to a ComplexNumber.\"\"\"\n    def validate(self, value) -> ComplexNumber:\n        return ComplexNumber.from_numeric(value)\nclass MathUtils:\n    \"\"\"Provides utility methods for mathematical computations.\"\"\"\n    @staticmethod\n    def magnitude(c: ComplexNumber) -> float:\n        \"\"\"Computes the magnitude (r) of a complex number.\"\"\"\n        return math.hypot(c.real, c.imag)\n\n    @staticmethod\n    def argument(c: ComplexNumber) -> float:\n        \"\"\"Computes the argument (theta) of a complex number.\"\"\"\n        return math.atan2(c.imag, c.real)\nclass PolarCoordinates:\n    \"\"\"A container for polar coordinates (r, theta).\"\"\"\n    def __init__(self, r: float, theta: float):\n        self.r = r\n        self.theta = theta\ndef convert(value) -> Tuple[float, float]:\n    \"\"\"\n    Converts a numeric value (int, float, complex) to polar coordinates (r, theta).\n    r is the magnitude and theta is the argument in radians, in (-pi, pi].\n    \"\"\"\n    validator = InputValidator()\n    cn = validator.validate(value)\n    r = MathUtils.magnitude(cn)\n    theta = MathUtils.argument(cn)\n    pc = PolarCoordinates(r, theta)\n    return (pc.r, pc.theta)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/162": [{"task_id": "Mbpp/162", "solution": "from dataclasses import dataclass\nfrom typing import List\nclass SumSeries:\n    \"\"\"\n    Encapsulates computation described in SRS Appendix B.\n    \"\"\"\n    def __init__(self, n: int) -> None:\n        self.n: int = n\n        self._terms: List[int] = []\n        self._result: int = 0\n\n    def _generate_terms(self) -> List[int]:\n        \"\"\"\n        Generates and returns list of integer term values t_i = n - 2*i for i = 0..floor(n/2).\n        \"\"\"\n        terms = []\n        for i in range(self.n // 2 + 1):\n            term_value = self.n - 2 * i\n            terms.append(term_value)\n        self._terms = terms\n        return terms\n\n    def compute(self) -> int:\n        \"\"\"\n        Populates _terms and _result, then returns the result.\n        \"\"\"\n        self._terms = self._generate_terms()\n        self._result = sum(self._terms)\n        return self._result\ndef sum_series(n: int) -> int:\n    \"\"\"\n    Public API required by FR1 and SRS, computes the sum of the series.\n    \"\"\"\n    calculator = SumSeries(n)\n    return calculator.compute()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/123": [{"task_id": "Mbpp/123", "solution": "import math\nfrom typing import List, Dict, Set\nclass Error(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\nclass Result:\n    \"\"\"Domain model for the aggregated result.\"\"\"\n    def __init__(self, amicableNumbers: List[int]):\n        self.amicableNumbers = amicableNumbers\n        self.sum = sum(amicableNumbers)\nclass InputValidator:\n    \"\"\"Validates input parameters.\"\"\"\n    def validateInteger(self, limit) -> None:\n        \"\"\"Raises Error if the limit is not an integer.\"\"\"\n        if not isinstance(limit, int):\n            raise Error(\"Input 'limit' must be an integer.\")\nclass AmicableCalculator:\n    \"\"\"Core computation service for amicable numbers.\"\"\"\n    def __init__(self):\n        self._divisor_sum_cache: Dict[int, int] = {}\n\n    def compute_divisor_sum(self, n: int) -> int:\n        \"\"\"Returns the sum of proper divisors of n, excluding n itself.\"\"\"\n        if n < 1:\n            return 0\n        if n == 1:\n            return 0\n\n        if n in self._divisor_sum_cache:\n            return self._divisor_sum_cache[n]\n\n        div_sum = 1 # 1 is always a proper divisor\n        for i in range(2, int(math.sqrt(n)) + 1):\n            if n % i == 0:\n                div_sum += i\n                if i * i != n:\n                    div_sum += n // i\n        self._divisor_sum_cache[n] = div_sum\n        return div_sum\n\n    def find_amicable_numbers(self, limit: int) -> List[int]:\n        \"\"\"Identifies amicable numbers within the range 1 to limit.\"\"\"\n        self._divisor_sum_cache.clear() # Clear cache for a new calculation\n\n        amicable_set: Set[int] = set()\n\n        for n in range(1, limit + 1):\n            if n in amicable_set: # Skip if already identified as part of an amicable pair\n                continue\n\n            sum_div_n = self.compute_divisor_sum(n)\n            m = sum_div_n\n\n            if m <= 1 or m == n: # Not amicable if m is 1 or equals n\n                continue\n\n            sum_div_m = self.compute_divisor_sum(m) # Compute d(m) even if m > limit\n\n            if sum_div_m == n: # Found an amicable pair (n, m)\n                if n <= limit:\n                    amicable_set.add(n)\n                if m <= limit: # Add m if it's also within the specified limit\n                    amicable_set.add(m)\n\n        return sorted(list(amicable_set))\n\n    def amicable_numbers_sum(self, limit: int) -> int:\n        \"\"\"Returns 0 for limit < 2, otherwise sums amicable numbers up to limit.\"\"\"\n        if limit < 2:\n            return 0\n\n        amicable_nums = self.find_amicable_numbers(limit)\n        result = Result(amicable_nums)\n        return result.sum\ndef amicable_numbers_sum(limit):\n    \"\"\"Public API function to sum all amicable numbers up to a specified limit.\"\"\"\n    InputValidator().validateInteger(limit)\n    calculator = AmicableCalculator()\n    return calculator.amicable_numbers_sum(limit)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/262": [{"task_id": "Mbpp/262", "solution": "from dataclasses import dataclass\nfrom typing import List, Tuple\ndef split_two_parts(input_list: list, L: int) -> tuple[list, list]:\n    \"\"\"\n    Partition input_list into two lists where the first has length L.\n    Returns: (first_part, second_part) as tuple of lists.\n    \"\"\"\n    first = input_list[:L]\n    second = input_list[L:]\n    return SplitResult(first, second).as_tuple()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 1, 2, 3, 4, 4, 5, 1], 3]], "plus_fail_tests": [[[1, 2, 3, 4, 5, 6, 7, 8, 9], 0]]}], "Mbpp/259": [{"task_id": "Mbpp/259", "solution": "def computeElementMax(a_item: tuple, b_item: tuple) -> tuple:\n    \"\"\"Returns a new tuple with element-wise maximums of two input tuples.\"\"\"\n    return tuple(max(x, y) for x, y in zip(a_item, b_item))\ndef maximize_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Maximizes elements of two tuples of tuples element-wise.\n    Raises ValueError if tuple lengths or inner tuple lengths do not match.\n    \"\"\"\n    validateOuterLengths(a, b)\n    validateInnerLengths(a, b)\n\n    result_inner_tuples = [computeElementMax(a_item, b_item) for a_item, b_item in zip(a, b)]\n    return tuple(result_inner_tuples)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[1, 3], [4, 5], [2, 9], [1, 10]], [[6, 7], [3, 9], [1, 1], [7, 3]]]], "plus_fail_tests": [[[[1, 2], [3, 4], [5, 6], [7, 8]], [[8, 7], [6, 5], [4, 3], [2, 1]]]