e ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n    sum_val = n * (n + 1) // 2\n    average = sum_val / n\n    \n    return (sum_val, average)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/462": [{"task_id": "Mbpp/462", "solution": "import collections\nimport typing\nclass InputList:\n    \"\"\"Holds input elements and precomputed length n.\"\"\"\n    def __init__(self, elements: typing.List[typing.Any]):\n        self.elements = elements\n        self.n = len(elements)\nclass BinaryMask:\n    \"\"\"Iterates integer masks from 0..max_value.\"\"\"\n    def __init__(self, max_value: int):\n        self._value = 0\n        self._max = max_value\n\n    def __iter__(self):\n        return self\n\n    def __next__(self) -> int:\n        if self._value > self._max:\n            raise StopIteration\n        current_value = self._value\n        self._value += 1\n        return current_value\nclass Combination:\n    \"\"\"Immutable value object holding elements (in reverse order) and mask.\"\"\"\n    def __init__(self, elements: typing.List[typing.Any], mask: int):\n        self._elements = elements\n        self._mask = mask\n\n    def to_list(self) -> typing.List[typing.Any]:\n        return self._elements\nclass ResultSet:\n    \"\"\"Collects Combination instances and serializes to list-of-lists.\"\"\"\n    def __init__(self):\n        self._combinations: typing.List[Combination] = []\n\n    def add(self, combination: Combination) -> None:\n        self._combinations.append(combination)\n\n    def to_list(self) -> typing.List[typing.List[typing.Any]]:\n        return [c.to_list() for c in self._combinations]\nclass CombinationGenerator:\n    \"\"\"Orchestrates validation and combination generation.\"\"\"\n    def combinations_list(self, input_list: typing.List[typing.Any]) -> typing.List[typing.List[typing.Any]]:\n        self._validate_input(input_list)\n        return self._generate_by_mask(input_list).to_list()\n\n    def _validate_input(self, input_list: typing.List[typing.Any]) -> None:\n        if not isinstance(input_list, (list, collections.abc.Sequence)):\n            raise TypeError(\"Input must be a list or sequence.\")\n\n    def _generate_by_mask(self, original_input_list: typing.List[typing.Any]) -> ResultSet:\n        input_list_obj = InputList(original_input_list)\n        n = input_list_obj.n\n        \n        max_mask = (1 << n) - 1 # 2**n - 1\n        binary_masks = BinaryMask(max_mask)\n        \n        result_set = ResultSet()\n\n        for mask in binary_masks:\n            current_combination_elements: typing.List[typing.Any] = []\n            for i in range(n - 1, -1, -1): # Iterate elements from last to first\n                # Check if the i-th bit (from right, 0-indexed) is set in the mask\n                if (mask >> i) & 1:\n                    current_combination_elements.append(input_list_obj.elements[i])\n            result_set.add(Combination(current_combination_elements, mask))\n        \n        return result_set\ndef combinations_list(input_list: typing.List[typing.Any]) -> typing.List[typing.List[typing.Any]]:\n    \"\"\"\n    Finds all possible combinations (power set) of the elements of a given list.\n    Generates combinations ordered by binary masks, with elements within each combination \n    ordered in reverse of their appearance in the input list.\n    \"\"\"\n    return CombinationGenerator().combinations_list(input_list)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/600": [{"task_id": "Mbpp/600", "solution": "def is_Even(number):\n    \"\"\"\n    Checks if a given number is even.\n    Returns True if the number is even, False otherwise.\n    \"\"\"\n    return number % 2 == 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/602": [{"task_id": "Mbpp/602", "solution": "def validate_input(input_value: objec