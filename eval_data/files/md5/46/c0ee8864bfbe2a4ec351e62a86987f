r is not None else Counter()\n\n    def is_majority(self, array, n, x) -> bool:\n        \"\"\"Checks if element x is the majority element in array[0..n-1].\"\"\"\n        if len(array) != n:\n            raise ValidationError(f\"n mismatch: len(array)={len(array)} != n={n}\")\n\n        if n == 0:\n            return False\n\n        count = self.counter.count(x, array, upto_index=n-1)\n        return count > (n / 2)\ndef is_majority(array, n, x) -> bool:\n    \"\"\"\n    Checks if element x is the majority element in the first n elements of a sorted array.\n    (The majority element is the element that occurs more than n/2 times.)\n    \"\"\"\n    service = IsMajorityService()\n    return service.is_majority(array, n, x)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[], 1, 0]]}], "Mbpp/172": [{"task_id": "Mbpp/172", "solution": "PATTERN: str = \"std\"\nCASE_SENSITIVE: bool = True\nclass InputString:\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\nclass CountResult:\n    def __init__(self, count: int) -> None:\n        self.count = count\nclass OccurrenceCounter:\n    def __init__(self, pattern: str = PATTERN, case_sensitive: bool = CASE_SENSITIVE) -> None:\n        self.pattern = pattern\n        self.case_sensitive = case_sensitive\n        self.pattern_len = len(pattern)\n\n    def _match_at(self, s: str, pos: int) -> bool:\n        if pos + self.pattern_len > len(s):\n            return False\n        return s[pos : pos + self.pattern_len] == self.pattern\n\n    def count(self, input_string: InputString) -> CountResult:\n        s = input_string.value\n        n = input_string.length()\n        count = 0\n        i = 0\n        while i <= n - self.pattern_len:\n            if self._match_at(s, i):\n                count += 1\n                i += self.pattern_len\n            else:\n                i += 1\n        return CountR