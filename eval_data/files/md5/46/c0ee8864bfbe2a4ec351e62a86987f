solution(a: int, b: int, n: int) -> Optional[Solution]:\n        \"\"\"\n        Finds a particular integer solution (x, y) for ax + by = n.\n        \"\"\"\n        # Special case: a=0 and b=0 (BR8)\n        if a == 0 and b == 0:\n            return Solution(x=0, y=0) if n == 0 else None\n\n        # Use Extended Euclidean Algorithm\n        result = ExtendedEuclid.extended_gcd(a, b)\n        g = result.g\n        x0 = result.xCoef\n        y0 = result.yCoef\n\n        # If n is not divisible by g, no integer solution exists\n        if n % g != 0:\n            return None\n\n        # Scale the particular solution to satisfy ax + by = n\n        scale_factor = n // g\n        x_base = x0 * scale_factor\n        y_base = y0 * scale_factor\n\n        # Deterministic representative selection to satisfy FR4 (e.g., find_solution(2, 3, 7) == (2, 1))\n        # General solution: x = x_base + (b/g)*t, y = y_base - (a/g)*t\n        # As per design: if a_div_g != 0 then t = y_base // a_div_g else t = 0\n        t = 0\n        a_div_g = a // g\n        b_div_g = b // g # Use this directly, as g is always positive after extended_gcd\n        \n        if a_div_g != 0:\n            t = y_base // a_div_g\n\n        x = x_base + b_div_g * t\n        y = y_base - a_div_g * t\n\n        return Solution(x=x, y=y)\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"\n    Finds integers x and y that satisfy ax + by = n as a tuple, or return None if no solution exists.\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int) or not isinstance(n, int):\n        raise TypeError(\"Inputs a, b, and n must be integers.\")\n\n    solution = Solver.find_solution(a, b, n)\n\n    if solution:\n        return (solution.x, solution.y)\n    else:\n        return None", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/167": [{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n):\n    \"\"\"\n    Fi