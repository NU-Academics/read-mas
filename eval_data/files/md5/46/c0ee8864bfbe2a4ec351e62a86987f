ion for finding the next smallest palindrome and related helpers.\"\"\"\n\n    def next_smallest_palindrome(self, n: int) -> int:\n        \"\"\"\n        Computes the smallest integer palindrome strictly greater than n.\n        Handles negative inputs by returning 0, as per design specification.\n        \"\"\"\n        if n < 0:\n            return 0\n        if n == 0:\n            return 1 # 0 is a palindrome, the next smallest is 1.\n        return self.generate_next_palindrome(n)\n\n    def is_palindrome(self, n: int) -> bool:\n        \"\"\"Determines if a given integer's decimal representation is a palindrome.\"\"\"\n        s = str(n)\n        return s == s[::-1]\n\n    def generate_next_palindrome(self, n: int) -> int:\n        \"\"\"\n        Constructs the smallest integer palindrome strictly greater than n\n        by manipulating its digits. Assumes n is positive (handled by caller).\n        \"\"\"\n        s = str(n)\n        L = len(s)\n        mid = L // 2\n\n        left_half = s[0:mid]\n        \n        # Build a candidate palindrome P1 by mirroring the left half\n        candidate_palindrome_str = \"\"\n        if L % 2 == 1:\n            middle_char = s[mid]\n            candidate_palindrome_str = left_half + middle_char + left_half[::-1]\n        else:\n            candidate_palindrome_str = left_half + left_half[::-1]\n\n        candidate_palindrome_val = int(candidate_palindrome_str)\n\n        # If P1 is already strictly greater than n, it is the answer.\n        if candidate_palindrome_val > n:\n            return candidate_palindrome_val\n\n        # If P1 is not strictly greater than n, we need to increment the 'left' part and rebuild.\n        # The 'left' part for incrementation includes the middle digit if L is odd.\n        num_to_increment_str = \"\"\n        if L % 2 == 1:\n            num_to_increment_str = left_half + s[mid]\n        else:\n            num_to_increment_str = left_half\n\n        incremented_num = int(num_to_inc