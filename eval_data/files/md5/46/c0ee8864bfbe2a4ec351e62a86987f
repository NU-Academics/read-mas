validTupleError(msg)\n\n    def validate_number(self, value, index=None, tuple_index=None):\n        \"\"\"Ensures a value is numeric (int or float).\"\"\"\n        if not isinstance(value, (int, float)):\n            location_msg = f\"at index {index}, element {tuple_index}\" if index is not None and tuple_index is not None else \"\"\n            msg = f\"Non-numeric value {location_msg}: {value}.\"\n            raise InvalidTupleError(msg)\ndef max_product_tuple(input_list):\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    Validates input and handles various error conditions per design.\n    \"\"\"\n    validator = Validator()\n    \n    validator.validate_list(input_list)\n    validator.validate_non_empty(input_list)\n\n    absolute_products = []\n    \n    for i, item in enumerate(input_list):\n        validator.validate_tuple(item, index=i)\n        \n        validator.validate_number(item[0], index=i, tuple_index=0)\n        validator.validate_number(item[1], index=i, tuple_index=1)\n        \n        tuple_item = TupleItem(item)\n        product = ProductCalculation.compute_abs_product(tuple_item)\n        absolute_products.append(product)\n        \n    return max(absolute_products)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/127": [{"task_id": "Mbpp/127", "solution": "def multiply_int(a: int, b: int) -> int:\n    return a * b", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/132": [{"task_id": "Mbpp/132", "solution": "def tup_string(t: tuple) -> str:\n    \"\"\"\n    Converts a tuple of characters/strings into a single concatenated string.\n    Elements are joined in order without any separators.\n    \"\"\"\n    return \"\".join(t)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/129": [{"task_id": "Mbpp/129", "solution": "from datac