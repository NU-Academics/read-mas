ist[int]]) -> set[int]:\n    \"\"\"\n    Accepts a single argument representing a list of lists of integers and returns a set of integers found in every inner list.\n    \"\"\"\n    if not nested_lists:\n        return set()\n\n    # Convert the first list to a set to start the intersection\n    # This also handles the case where the first list is empty, resulting in an empty initial_set\n    initial_set = set(nested_lists[0])\n\n    # If initial_set is empty, subsequent intersections will also yield an empty set.\n    # This also covers the edge case where there's only one inner list,\n    # or the first inner list is empty, fulfilling the \"empty set if any inner list is empty\" requirement implicitly.\n    if not initial_set:\n        return set()\n\n    # Use functools.reduce to find the intersection of all sets\n    # We convert each sublist to a set before intersecting.\n    # If any subsequent sublist is empty, its set conversion will be an empty set,\n    # and intersection with an empty set always results in an empty set.\n    common_elements = functools.reduce(lambda acc, current_list: acc.intersection(set(current_list)),\n                                       nested_lists[1:],\n                                       initial_set)\n\n    return common_elements", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/116": [{"task_id": "Mbpp/116", "solution": "class IntegerElement:\n    \"\"\"Encapsulates a single integer element and provides its decimal string representation.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def to_decimal_string(self) -> str:\n        \"\"\"Return canonical decimal string for value.\"\"\"\n        return str(self.value)\nclass TupleInput:\n    \"\"\"Represent an input tuple as a domain object that contains IntegerElement instances and can validate constraints.\"\"\"\n    def __init__(self, elements: tuple[int, ...]):\n        self._raw_elements = elements\n        self.elements: list[IntegerElement] = [IntegerElement(e) for e in elements]\n\n    def is_valid(self) -> bool:\n        \"\"\"Validate that elements is a non-empty tuple of positive integers.\"\"\"\n        if not isinstance(self._raw_elements, tuple):\n            return False\n        if not self._raw_elements:\n            return False\n        for element in self._raw_elements:\n            if not isinstance(element, int) or element <= 0:\n                return False\n        return True\nclass ResultInteger:\n    \"\"\"Represent the produced integer result of concatenation.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass Converter:\n    \"\"\"Perform conversion logic from a TupleInput to a ResultInteger.\"\"\"\n    def tuple_to_int(self, tuple_input: TupleInput) -> ResultInteger:\n        \"\"\"Accepts a TupleInput and returns a ResultInteger containing the concatenated integer.\"\"\"\n        if not tuple_input.is_valid():\n            raise ValueError(\"Input must be a non-empty tuple of positive integers.\")\n\n        string_parts = [e.to_decimal_string() for e in tuple_input.elements]\n        concatenated_string = \"\".join(string_parts)\n        result_value = int(concatenated_string)\n        return ResultInteger(result_value)\ndef tuple_to_int(input_tuple: tuple[int, ...]) -> int:\n    \"\"\"Converts a given tuple of positive integers into a single integer.\"\"\"\n    tuple_input_obj = TupleInput(input_tuple)\n    converter = Converter()\n    result_obj = converter.tuple_to_int(tuple_input_obj)\n    return result_obj.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/124": [{"task_id": "Mbpp/124", "solution": "import math\ndef angle_complex(z: complex) -> float:\n    \"\"\"Public API: Accepts a language-native complex number and returns the argument in radians as float.\"\"\"\n    real_part = float(z.real)\n    imag_part = float(z.imag)\n    radians =