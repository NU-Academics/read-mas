resents an integer number and provides access to its decimal digits.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n        self._digits: List[int] | None = None\n\n    def getDigits(self) -> List[int]:\n        \"\"\"Extracts and caches the decimal digits of the number.\"\"\"\n        if self._digits is None:\n            if self.value == 0:\n                self._digits = [0]\n            else:\n                # Use abs() to handle potential negative numbers gracefully\n                self._digits = [int(d) for d in str(abs(self.value))]\n        return self._digits\nclass UndulatingChecker:\n    \"\"\"Encapsulates the logic for checking if a number is undulating.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def is_undulating(self, number_obj: Number) -> bool:\n        \"\"\"Checks if the given Number object represents an undulating number.\"\"\"\n        digits = self.extract_digits(number_obj)\n        return self.check_alternation(digits)\n\n    def extract_digits(self, number_obj: Number) -> List[int]:\n        \"\"\"Delegates to Number object to get its digits.\"\"\"\n        return number_obj.getDigits()\n\n    def check_alternation(self, digits: List[int]) -> bool:\n        \"\"\"Determines if digits alternate between exactly two distinct digits.\"\"\"\n        n = len(digits)\n\n        if n < 2:\n            return False  # Cannot form an alternating pattern with less than 2 digits\n\n        d1 = digits[0]\n        d2 = digits[1]\n\n        if d1 == d2:\n            return False  # Adjacent digits cannot be equal\n\n        # For numbers with only two digits (e.g., 12), they are undulating\n        if n == 2:\n            return True\n\n        # Check for alternation pattern d1, d2, d1, d2, ...\n        for i in range(2, n):\n            if i % 2 == 0:  # Even index, should match d1\n                if digits[i] != d1:\n                    return False\n            else:           # Odd index, should match d2\n                if digits[i] != d2:\n                    return False\n        return True\ndef is_undulating(number) -> bool:\n    \"\"\"\n    Checks whether the given number is undulating.\n    An undulating number alternates between exactly two distinct digits (e.g., 1212121).\n    \"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    number_obj = Number(number)\n    checker = UndulatingChecker()\n    return checker.is_undulating(number_obj)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/95": [{"task_id": "Mbpp/95", "solution": "from typing import List, Any\ndef Find_Min_Length(input: List[List[Any]]) -> int:\n    \"\"\"Finds the length of the smallest list in a list of lists.\n    It expects `input` to be a list of lists, as per design preconditions.\n    \"\"\"\n    lengths = [len(inner_list) for inner_list in input]\n    return min(lengths)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/96": [{"task_id": "Mbpp/96", "solution": "import math\ndef divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer.\n    Assumes n is a non-zero integer.\n    \"\"\"\n    m = abs(n)\n    count = 0\n    # Enumerate divisors up to the square root of m, handling pairs.\n    for i in range(1, math.isqrt(m) + 1):\n        if m % i == 0:\n            if i * i == m:\n                count += 1\n            else:\n                count += 2\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/99": [{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal: int) -> str:\n    \"\"\"Convert a non-negative decimal integer to its binary string representation with no leading zeros.\n    Returns '0' when decimal == 0.\n    \"\"\"\n    if decimal == 0:\n        return \"0\"\n\n    binary_string = \"\"\n   