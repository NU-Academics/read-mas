, n):\n        \"\"\"\n        Validates the input n and calculates C(2n, n) for the binary sequences.\n        \"\"\"\n        self.validator.validate_n(n)\n        return self.binomial_calculator.binomial(2 * n, n)\ndef count_binary_seq(n):\n    \"\"\"\n    Counts binary sequences of length 2n such that the sum of the first n bits\n    is the same as the sum of the last n bits.\n    \"\"\"\n    counter = SequenceCounter()\n    return counter.count_binary_seq(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[50]]}], "Mbpp/299": [{"task_id": "Mbpp/299", "solution": "from typing import List, Tuple, Dict, Union\nclass Aggregator:\n    def aggregateByName(self, entries: List[Tuple[str, Union[int, float]]]) -> Dict[str, Union[int, float]]:\n        \"\"\"\n        Aggregates numeric values by name, summing them up.\n        Preserves numeric type (int if all values for a name are int, else float).\n        \"\"\"\n        aggregates: Dict[str, Union[int, float]] = {}\n        for name, value in entries:\n            aggregates[name] = aggregates.get(name, 0) + value\n        return aggregates\n\n    def findMax(self, aggregates: Dict[str, Union[int, float]]) -> Tuple[str, Union[int, float]]:\n        \"\"\"\n        Finds the (name, total) pair with the maximum total from a dictionary of aggregates.\n        Returns ('', 0) if the aggregates dictionary is empty.\n        \"\"\"\n        if not aggregates:\n            return ('', 0)\n        max_entry = max(aggregates.items(), key=lambda item: item[1])\n        return max_entry\n\n    def max_aggregate(self, entries: List[Tuple[str, Union[int, float]]]) -> Tuple[str, Union[int, float]]:\n        \"\"\"\n        Orchestrates the aggregation and maximum selection process.\n        \"\"\"\n        aggregated_totals = self.aggregateByName(entries)\n        return self.findMax(aggregated_totals)\ndef max_aggregate(entries: List[Tuple[str, Union[int, float]]]) -> Tuple[str, Union[int, float]]:\n    \"\"\"\n    Calculates the maximum aggregate from a list of (name, value) tuples.\n    Values are summed by name, and the (name, total) pair with the highest total is returned.\n    \"\"\"\n    return Aggregator().max_aggregate(entries)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/306": [{"task_id": "Mbpp/306", "solution": "from typing import List\nclass InvalidInputException(Exception):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass Validator:\n    \"\"\"Validates input parameters for the max_sum_increasing_subseq function.\"\"\"\n    def validate(self, arr: List[int], n: int, i: int, k: int) -> None:\n        if n != len(arr):\n            raise InvalidInputException(\"n does not equal len(arr)\")\n        if not (0 <= i < k < n):\n            raise InvalidInputException(\"indices must satisfy 0 \u2264 i < k < n\")\ndef max_sum_increasing_subseq(arr: List[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from a prefix until the ith index,\n    including a given kth element (k > i).\n    \"\"\"\n    validator = Validator()\n    validator.validate(arr, n, i, k)\n\n    target_element = arr[k]\n    max_overall_sum = target_element  # Initialize with arr[k] for the fallback case\n\n    # dp[j] stores the maximum sum of an increasing subsequence ending at arr[j]\n    dp = [0] * (i + 1)\n\n    for j in range(i + 1):\n        current_val = arr[j]\n        # The sum of an increasing subsequence ending at current_val\n        # must be at least current_val itself (subsequence of length 1)\n        dp[j] = current_val\n\n        # Find a previous element arr[prev_j] such that arr[prev_j] < current_val\n        # and dp[prev_j] is maximized\n        for prev_j in range(j):\n            if arr[prev_j] < current_val:\n                dp[j] = max(dp[j], dp[prev_j] + current_val)\n        \n        # If arr[j] can be a predecessor to target_element, update max_overall_sum\n        if current_val < target_element:\n            max_overall_sum = max(max_overall_sum, dp[j] + target_element)\n\n    return max_overall_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/301": [{"task_id": "Mbpp/301", "solution": "class DictDepthCalculator:\n    \"\"\"\n    Helper class to encapsulate the recursive logic for calculating dictionary depth.\n    \"\"\"\n    def dict_depth(self, d: dict) -> int:\n        \"\"\"\n        Initiates the depth calculation from the top-level dictionary.\n        \"\"\"\n        return self._compute_depth(d, 1)\n\n    def _compute_depth(self, d: dict, current_depth: int) -> int:\n        \"\"\"\n        Recursively computes the maximum depth of nested dictionaries.\n        \"\"\"\n        max_nested_depth_from_children = 0\n        for value in d.values():\n            if isinstance(value, dict):\n                child_depth = self._compute_depth(value, current_depth + 1)\n                max_nested_depth_from_children = max(max_nested_depth_from_children, child_depth)\n\n        return max(current_depth, max_nested_depth_from_children)\ndef dict_depth(d: dict) -> int:\n    \"\"\"\n    Finds the maximum depth of a dictionary.\n    The top-level dictionary counts as depth 1.\n    \"\"\"\n    calculator = DictDepthCalculator()\n    return calculator.dict_depth(d)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/310": [{"task_id": "Mbpp/310", "solution": "def string_to_tuple(s: str) -> tuple:\n    \"\"\"Convert input string s into tuple of single-character strings excluding U+0020.\"\"\"\n    return tuple(char for char in s if char != ' ')", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\n\t"]]}], "Mbpp/278": [{"task_id": "Mbpp/278", "solution"