sor = BitwiseProcessor()\n    result_tuple = processor.elementwise_and(a, b)\n\n    return AndResult(result_tuple).as_tuple()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/430": [{"task_id": "Mbpp/430", "solution": "class Error(Exception):\n    \"\"\"Deterministic exception for invalid inputs or computation errors.\"\"\"\n    def __init__(self, message: str, code: int = 1) -> None:\n        self.message = message\n        self.code = code\n        super().__init__(f\"Error {self.code}: {self.message}\")\nclass InputValidator:\n    \"\"\"Validate input types and enforce the business rule that a != 0.\"\"\"\n    def validate_numeric(self, a, b, c) -> None:\n        \"\"\"Verify that a, b, c are numeric (int or float).\"\"\"\n        if not all(isinstance(arg, (int, float)) for arg in [a, b, c]):\n            raise Error(\"Inputs a, b, c must be numeric (int or float).\", code=1)\n\n    def ensure_a_nonzero(self, a) -> None:\n        \"\"\"Verify that a != 0.\"\"\"\n        if a == 0:\n            raise Error(\"Coefficient 'a' must be non-zero.\", code=2)\ndef parabola_directrix(a, b, c):\n    \"\"\"\n    Computes the directrix of a parabola given its coefficients a, b, and c.\n    This function validates inputs and computes the directrix based on the formula\n    documented in the module docstring.\n\n    Parameters:\n        a (numeric): The coefficient of the x^2 term (must be non-zero).\n        b (numeric): The coefficient of the x term.\n        c (numeric): The constant term.\n\n    Returns:\n        numeric: The calculated directrix value (float).\n\n    Raises:\n        Error: If inputs are non-numeric or if 'a' is zero.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate_numeric(a, b, c)\n    validator.ensure_a_nonzero(a)\n\n    # Convert inputs to float for consistent calculations.\n    a_f = float(a)\n    b_f = float(b)\n    c_f = float(c)\n\n    # Compute the directrix using the spec