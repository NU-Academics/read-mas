\n        self.is_even = is_even\ndef _get_divisors(n: int) -> list[int]:\n    \"\"\"Enumerates and returns a list of positive divisors of n.\"\"\"\n    divisors = []\n    limit = int(math.sqrt(n))\n\n    for i in range(1, limit + 1):\n        if n % i == 0:\n            divisors.append(i)\n            if i * i != n:\n                divisors.append(n // i)\n    return divisors\nclass DivisorCounter:\n    \"\"\"Encapsulates divisor enumeration and counting logic.\"\"\"\n\n    def _get_divisors(self, n: int) -> list[int]:\n        \"\"\"Internal helper to enumerate positive divisors, delegating to module-level.\"\"\"\n        return _get_divisors(n)\n\n    def _count(self, n: int) -> int:\n        \"\"\"Returns integer count of positive divisors.\"\"\"\n        return len(self._get_divisors(n))\n\n    def count_divisors(self, n: int) -> bool:\n        \"\"\"\n        Calculates the number of divisors and returns True if it's even, False otherwise.\n        \"\"\"\n        divisor_count = self._count(n)\n        is_even = divisor_count % 2 == 0\n        _ = Result(divisor_count, is_even) # Instantiated as per design\n        return is_even\ndef count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks whether the count of positive divisors of n is even.\n    Raises ValueError if n is not an integer or n < 1.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer >= 1\")\n\n    return DivisorCounter().count_divisors(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/721": [{"task_id": "Mbpp/721", "solution": "from typing import List, Iterator, Optional\nclass Cell:\n    \"\"\"Represents a cell in the matrix with its coordinates and cost.\"\"\"\n    def __init__(self, row: int, col: int, cost: float) -> None:\n        self.row = row\n        self.col = col\n        self.cost = cost\nclass Path:\n    \"\"\"Represents a path as a sequence of cells, providing cost and average calculations.\"\"\"\n    def __init__(self, cells: List[Cell]) -> None:\n        self.cells = cells\n\n    def length(self) -> int:\n        \"\"\"Returns the number of cells in the path.\"\"\"\n        return len(self.cells)\n\n    def totalCost(self) -> float:\n        \"\"\"Calculates the total cost of all cells in the path.\"\"\"\n        return sum(cell.cost for cell in self.cells)\n\n    def average(self) -> float:\n        \"\"\"Calculates the average cost per cell in the path.\"\"\"\n        path_length = self.length()\n        # For valid paths, length will always be >= 1.\n        return self.totalCost() / path_length\nclass Matrix:\n    \"\"\"Represents the square matrix, holding Cell objects.\"\"\"\n    def __init__(self, rows: List[List[float]]) -> None:\n        self.size = len(rows)\n        self.cells: List[List[Cell]] = []\n        for r_idx, row_values in enumerate(rows):\n            current_row_cells = []\n            for c_idx, cost_value in enumerate(row_values):\n                current_row_cells.append(Cell(r_idx, c_idx, float(cost_value)))\n            self.cells.append(current_row_cells)\n\n    def getCell(self, row: int, col: int) -> Cell:\n        \"\"\"Retrieves a Cell object by its row and column.\"\"\"\n        return self.cells[row][col]\nclass MaxAverageCalculator:\n    \"\"\"Calculates the maximum average path in a given matrix.\"\"\"\n    def __init__(self, matrix: Matrix) -> None:\n        self.matrix = matrix\n        self._n = matrix.size\n\n    def _generate_paths(self) -> Iterator[Path]:\n        \"\"\"Generates all valid paths from top-left to bottom-right (Right/Down moves only).\"\"\"\n        current_path_cells: List[Cell] = []\n\n        def _dfs(r: int, c: int) -> Iterator[Path]:\n            current_path_cells.append(self.matrix.getCell(r, c))\n\n            if r == self._n - 1 and c == self._n - 1:\n                yield Path(list(current_path_cells))\n            else:\n                if c + 1 < self._n: # Move Right\n                    yield from _dfs(r, c + 1)\n                if r + 1 < self._n: # Move Down\n                    yield from _dfs(r + 1, c)\n\n            current_path_cells.pop() # Backtrack\n\n        yield from _dfs(0, 0)\n\n    def _evaluate_path(self, path: Path) -> float:\n        \"\"\"Computes the average cost for a given path.\"\"\"\n        return path.average()\n\n    def maxAverageOfPath(self) -> float:\n        \"\"\"Finds the maximum average path in the matrix.\"\"\"\n        max_avg: Optional[float] = None\n        for path in self._generate_paths():\n            avg = self._evaluate_path(path)\n            if max_avg is None or avg > max_avg:\n                max_avg = avg\n        # A valid N x N matrix (N>=1) will always have at least one path.\n        return max_avg if max_avg is not None else 0.0\ndef _validate_matrix(matrix: List[List[float]]) -> Matrix:\n    \"\"\"Validates the input matrix and converts it to a models.Matrix object, raising ValueError on invalid input.\"\"\"\n    if not matrix:\n        raise ValueError(\"Matrix cannot be empty.\")\n\n    n = len(matrix)\n    if any(len(row) != n for row in matrix):\n        raise ValueError(\"Matrix must be square (N x N).\")\n\n    for r_idx, row in enumerate(matrix):\n        for c_idx, item in enumerate(row):\n            # Check for numeric types (int or float) and exclude booleans (subclass of int)\n            if not isinstance(item, (int, float)) or isinstance(item, bool):\n                raise ValueError(f\"Matrix elements must be numeric (int or float), found '{type(item).__name__}' at ({r_idx},{c_idx}).\")\n\n    return Matrix(matrix)\ndef maxAverageOfPath(matrix: List[List[float]]) -> float:\n    \"\"\"\n    Given a square matrix, finds a path from top-left to bottom-right\n    moving only right or down, with the maximum average cost per cell.\n    \"\"\"\n    validated_matrix = _validate_matrix(matrix)\n    calculator = MaxAverageCalculator(validated_matrix)\n    return calc