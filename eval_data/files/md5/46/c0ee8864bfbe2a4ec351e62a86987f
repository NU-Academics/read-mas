st)\n\n    def _validate_input(self, input_list: list) -> None:\n        \"\"\"Validate input is a Python list; raise TypeError if not.\"\"\"\n        if not isinstance(input_list, list):\n            raise TypeError(\"Input must be a list.\")\n\n    def _are_elements_integers(self, input_list: list) -> None:\n        \"\"\"Validate all elements are integers; raise ValueError if any are not.\"\"\"\n        for item in input_list:\n            if not isinstance(item, int):\n                raise ValueError(\"All elements in the list must be integers.\")\n\n    def _normalize_and_sort(self, input_list: list) -> List[int]:\n        \"\"\"Normalize elements and return sorted values for order-insensitive check.\"\"\"\n        return sorted(input_list)\n\n    def _has_no_duplicates(self, values: List[int]) -> bool:\n        \"\"\"Return True if no duplicates present in the given list.\"\"\"\n        return len(values) == len(set(values))\n\n    def _is_consecutive(self, sorted_values: List[int]) -> bool:\n        \"\"\"For sorted unique values, return True if adjacent differences are 1.\"\"\"\n        for i in range(len(sorted_values) - 1):\n            if sorted_values[i+1] - sorted_values[i] != 1:\n                return False\n        return True\ndef check_Consecutive(input_list: list) -> bool:\n    \"\"\"Checks whether the given list contains consecutive numbers or not.\n    Delegates validation and core logic to an internal SequenceChecker.\"\"\"\n    checker = SequenceChecker()\n    return checker.check_Consecutive(input_list)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/474": [{"task_id": "Mbpp/474", "solution": "def performReplacement(char_list: list, old_char: str, new_char: str) -> list:\n    \"\"\"\n    Iterates through a list of characters and replaces occurrences of old_char with new_char.\n    \"\"\"\n    new_list = []\n    for char in char_list:\n        if char == old_char:\n            new_list.app