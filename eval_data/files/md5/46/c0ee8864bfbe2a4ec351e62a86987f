adius and height must be > 0\")\n\n        cylinder = Cylinder(float(radius), float(height))\n        return cylinder.lateralSurface()\ndef lateralsuface_cylinder(radius, height) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cylinder given its radius and height.\n    Validates inputs and delegates computation to an internal service.\n    \"\"\"\n    service = CylinderService()\n    return service.lateralsuface_cylinder(radius, height)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/234": [{"task_id": "Mbpp/234", "solution": "from numbers import Number\nclass VolumeResult:\n    \"\"\"Container/value object for the numeric computed volume.\"\"\"\n    def __init__(self, value: Number) -> None:\n        self.value: Number = value\nclass Cube:\n    \"\"\"Encapsulate side_length and compute its volume.\"\"\"\n    def __init__(self, side_length: Number) -> None:\n        self.side_length: Number = side_length\n\n    def volume(self) -> Number:\n        \"\"\"Return numeric side_length^3.\"\"\"\n        return self.side_length * self.side_length * self.side_length\nclass VolumeCalculator:\n    \"\"\"Provide volume_cube(side_length) operation; stateless service.\"\"\"\n    def volume_cube(self, side_length: Number) -> Number:\n        \"\"\"Compute and return side_length^3.\"\"\"\n        cube = Cube(side_length)\n        volume_value = cube.volume()\n        result = VolumeResult(value=volume_value)\n        return result.value\ndef volume_cube(side_length: Number) -> Number:\n    \"\"\"Public API: compute cube volume = side_length^3 and return numeric result.\"\"\"\n    calculator = VolumeCalculator()\n    return calculator.volume_cube(side_length)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/237": [{"task_id": "Mbpp/237", "solution": "def _normalize_pair(tup):\n    \"\"\"Returns a tuple with its two elements sorted in ascending order.\"\"\"\n    return tuple(sorted(tup))\ndef check_occurences(list_of_tuples):\n    \"\"\"\n    Takes a list of tuples and returns a dictionary mapping each unique normalized tuple to its occurrence count.\n    Normalized tuples have their elements sorted in ascending order.\n    \"\"\"\n    _validate_input(list_of_tuples)\n\n    if not list_of_tuples:\n        return {}\n\n    counts = {}\n    for tup in list_of_tuples:\n        normalized_key = _normalize_pair(tup)\n        _increment_count(counts, normalized_key)\n    return counts", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[3, 1], [1, 3], [2, 5], [5, 2], [6, 3]]]], "plus_fail_tests": [[[[2, 2], [1, 3], [2, 2], [3, 1], [1, 3]]]]}], "Mbpp/238": [{"task_id": "Mbpp/238", "solution": "def number_of_substrings(s: str) -> int:\n    \"\"\"Counts the number of non-empty contiguous substrings of a given string.\n\n    Each substring, distinct by its start and end positions, is counted.\n    \"\"\"\n    n = len(s)\n    # The number of non-empty contiguous substrings of a string of length n is n * (n + 1) / 2.\n    # This can be derived by summing the lengths of all possible substrings:\n    # 1 substring of length n (the string itself)\n    # 2 substrings of length n-1\n    # ...\n    # n substrings of length 1\n    # Or, equivalently, using nested loops for start and end indices.\n    return n * (n + 1) // 2", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/240": [{"task_id": "Mbpp/240", "solution": "def replace_list(inputA: list, inputB: list) -> list:\n    \"\"\"\n    Replaces the last element of the first list with the elements of the second list.\n    Returns a new list without modifying the input lists; if inputA is empty, it returns a copy of inputB.\n    \"\"\"\n    return inputA[:-1] + inputB", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/235": [{"task_id": "Mbpp/235", "solution": "class IntegerValue:\n    def __init__(self, value: int):\n        self.value: int = value\n    def bit_length(self) -> int:\n        return self.value.bit_length()\n    def is_non_negative(self) -> bool:\n        return self.value >= 0\nclass BitPosition:\n    def __init__(self, index: int):\n        self.index: int = index  # 1-based index\n    def is_even(self) -> bool:\n        return (self.index % 2) == 0\nclass BitMask:\n    def __init__(self, mask: int, generated_for_length: int):\n        self.mask: int = mask\n        self.generated_for_length: int = generated_for_length\n\n    @staticmethod\n    def generate_for_length(length: int) -> int:\n        \"\"\"\n        Generates an integer mask with 1s at 1-based even bit positions up to the given length.\n        For example, for length 4, it generates a mask like 0b1010 (decimal 10).\n        \"\"\"\n        mask = 0\n        for i in range(1, length + 1):  # 1-based index\n            if BitPosition(i).is_even():\n                mask |= (1 << (i - 1))  # Set the (i-1)-th bit (0-based)\n        return mask\ndef even_bit_set_number(n) -> int:\n    \"\"\"\n    Sets all 1-based even bits of a given non-negative number to 1.\n    This function processes the input number `n` and returns the result `n | mask`.\n    \"\"\"\n    # Input validation for type and non-negativity is explicitly omitted per requirements.\n    # The function expects 'n' to be a non-negative integer.\n\n    integer_value = IntegerValue(n)\n    max_length = integer_value.bit_length()\n\n    even_bits_mask = BitMask.generate_for_length(max_length)\n\n    result = n | even_bits_mask\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/242": [{"task_id": "Mbpp/242", "solution": "def count_charac(input_string: str) -> int:\n    \"\"\"Return the total number of characters in input_string, counting all characters including whitespace.\"\"\"\n    return len(input_string)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/239": [{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the number of possible sequences of length n,\n    such that each element is a positive integer, less than or equal to m,\n    and greater than or equal to twice the previous element.\n    \"\"\"\n    if n == 0:\n        return 0 # A sequence of length 0 technically has 1 way (empty sequence), but problem implies n > 0.\n                 # Given \"positive integers m and n\", n=0 should not happen based on input constraints.\n\n    # dp[j] will store the number of valid sequences of current length ending with value j.\n    # We use a space-optimized approach, only keeping track of the previous length's prefix sums.\n    # prev_prefix_sum[x] stores the sum of dp[length-1][k] for 1 <= k <= x.\n    prev_prefix_sum = [0] * (m + 1)\n\n    # Base case: sequences of length 1\n    # Each integer from 1 to m is a valid sequence of length 1.\n    # dp[1][j] = 1 for 1 <= j <= m\n    # prev_prefix_sum[j] will store the cumulative sum for length 1.\n    for j in range(1, m + 1):\n        prev_prefix_sum[j] = prev_prefix_sum[j-1] + 1\n\n    # Fill DP table for lengths from 2 to n\n    for length in range(2, n + 1):\n        current_dp_row = [0] * (m + 1)\n        current_prefix_sum = [0] * (m + 1)\n\n        for current_val in range(1, m + 1):\n            # The previous element (prev_val) must satisfy: current_val >= 2 * prev_val\n            # This implies prev_val <= current_val // 2\n            max_prev_val = current_val // 2\n\n            if max_prev_val == 0:\n                # No positive integer prev_val can satisfy the condition\n                current_dp_row[current_val] = 0\n            else:\n                # Sum of all valid sequences of length (length-1) ending with a value\n                # up to max_prev_val. This is directly available from prev_prefix_sum.\n                current_dp_row[current_val] = prev_prefix_sum[max_prev_val]\n\n        # Calculate prefix sums for the current length\n        for j in range(1, m + 1):\n            current_prefix_sum[j] = current_prefix_sum[j-1] + current_dp_row[j]\n\n        # Update prev_prefix_sum for the next iteration\n        prev_prefix_sum = current_prefix_sum\n\n    # The total number of sequences of length n is the sum of all dp[n][j] for 1 <= j <= m,\n    # which is stored in prev_prefix_sum[m] after the loops complete.\n    return prev_prefix_sum[m]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/245": [{"task_id": "Mbpp/245", "solution": "import collections\nimport numbers\ndef _compute_lis_sums(array) -> list[int]:\n    n = len(array)\n    if n == 0:\n        return []\n    lis_sums = list(array)\n\n    for i in range(n):\n        for j in range(i):\n            if array[j] < array[i]:\n                lis_sums[i] = max(lis_sums[i], lis_sums[j] + array[i])\n    return lis_sums\ndef _compute_lds_sums(array) -> list[int]:\n    n = len(array)\n    if n == 0:\n        return []\n    lds_sums = list(array)\n\n    for i in range(n - 1, -1, -1):\n        for j in range(i + 1, n):\n            if array[j] < array[i]:\n                lds_sums[i] = max(lds_sums[i], lds_sums[j] + array[i])\n    return lds_sums\ndef max_sum(array) -> int:\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence in the given array.\n    A bitonic subsequence first increases and then decreases.\n    \"\"\"\n    _validate_input(array)\n\n    n = len(array)\n    if n == 0:\n        return 0\n\n    lis_sums = _compute_lis_sums(array)\n    lds_sums = _compute_lds_sums(array)\n\n    candidate_sums = [lis_sums[i] + lds_sums[i] - array[i] for i in range(n)]\n\n    return max(candidate_sums)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 15, 51, 45, 33, 100, 12, 18, 9]]], "plus_fail_tests": [[[10, 9, 8, 7, 6