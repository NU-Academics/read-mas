: InputList) -> None:\n        \"\"\"Validates that all elements in both lists are numeric (int or float).\"\"\"\n        for input_list_obj in [a, b]:\n            for element_obj in input_list_obj.elements:\n                if not isinstance(element_obj.value, (int, float)):\n                    raise ValidationError('ERR_NON_NUMERIC', \"All elements must be numeric (int or float).\")\n\n    def validatePreconditions(self, a: InputList, b: InputList, n: int) -> None:\n        \"\"\"Performs comprehensive validation including lengths, types, n >= 1, and sortedness.\"\"\"\n        self.validateLengths(a, b, n)\n        self.validateTypes(a, b)\n        if n < 1:\n            raise ValidationError('ERR_INVALID_N', \"Parameter 'n' must be an integer greater than or equal to 1.\")\n        if not a.isSorted() or not b.isSorted():\n            raise ValidationError('ERR_UNSORTED', \"Input lists must be sorted in non-decreasing order.\")\nclass Result:\n    \"\"\"Encapsulates the computed median value as a float.\"\"\"\n    def __init__(self, median: float):\n        self.median = median\ndef _selectKthWithoutFullMerge(k: int, a: InputList, b: InputList):\n    \"\"\"\n    Finds the k-th smallest element from two sorted InputList objects.\n    Assumes k is 1-based and within valid bounds [1, a.length + b.length].\n    \"\"\"\n    n = a.length\n    i = 0  # Pointer for list a\n    j = 0  # Pointer for list b\n    count = 0 # Count of elements considered\n\n    kth_element_value = None\n\n    while i < n and j < n:\n        if a.elements[i].value <= b.elements[j].value:\n            kth_element_value = a.elements[i].value\n            i += 1\n        else:\n            kth_element_value = b.elements[j].value\n            j += 1\n        count += 1\n        if count == k:\n            return kth_element_value\n\n    while i < n:\n        kth_element_value = a.elements[i].value\n        i += 1\n        count += 1\n        if count == k:\n            return kth_element_value\n\n    while j < n:\n        kth_element_value = b.elements[j].value\n        j += 1\n        count += 1\n        if count == k:\n            return kth_element_value\n    \n    return kth_element_value\ndef get_median(a: list, b: list, n: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size n.\n    The median is the average of the n-th and (n+1)-th smallest elements.\n    \"\"\"\n    list_a = InputList(a)\n    list_b = InputList(b)\n\n    validator = Validator()\n    validator.validatePreconditions(list_a, list_b, n)\n\n    nth_smallest = _selectKthWithoutFullMerge(n, list_a, list_b)\n    nplus1th_smallest = _selectKthWithoutFullMerge(n + 1, list_a, list_b)\n\n    median_value = (float(nth_smallest) + float(nplus1th_smallest)) / 2.0\n\n    result = Result(median_value)\n    return result.median", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[3, 6, 14, 23], [2, 18, 27, 39, 49, 55], 4]]}], "Mbpp/626": [{"task_id": "Mbpp/626", "solution": "class InputValidator:\n    def is_valid(self, radius) -> bool:\n        \"\"\"Validates if the input radius is a numeric type (int or float).\"\"\"\n        return isinstance(radius, (int, float))\nclass TriangleAreaCalculator:\n    def triangle_area(self, radius) -> float or None:\n        \"\"\"Calculates the area of the largest inscribed triangle, returning None for negative radius.\"\"\"\n        if radius < 0:\n            return None\n        return radius * radius\ndef triangle_area(radius):\n    \"\"\"\n    Finds the area of the largest triangle that can be inscribed in a semicircle with a given radius.\n    Returns None if the radius is negative or non-numeric.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.is_valid(radius):\n        return None\n    \n    calculator = TriangleAreaCalculator()\n    return calculator.triangle_area(radius)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": [