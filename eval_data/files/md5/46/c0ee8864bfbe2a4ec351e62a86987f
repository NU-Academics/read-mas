rns a bool. Direct return aligns with UC3.\n        return is_equal\ndef noprofit_noloss(selling_price, cost_price) -> bool:\n    \"\"\"\n    Checks whether the given amount has no profit and no loss.\n    Returns True if selling_price equals cost_price, False otherwise.\n    \"\"\"\n    return PriceComparison().noprofit_noloss(selling_price, cost_price)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/638": [{"task_id": "Mbpp/638", "solution": "import math\ndef _compute_wind_chill_raw(wind_velocity_kmh, temperature_c):\n    \"\"\"Computes the raw wind-chill numeric value using the prescribed formula.\"\"\"\n    # Formula for wind chill index in Celsius and km/h\n    # WC = 13.12 + 0.6215T - 11.37V^0.16 + 0.3965TV^0.16\n    # Where T is temperature in Celsius and V is wind velocity in km/h.\n    return (13.12 + (0.6215 * temperature_c) -\n            (11.37 * (wind_velocity_kmh ** 0.16)) +\n            (0.3965 * temperature_c * (wind_velocity_kmh ** 0.16)))\ndef _ceil_to_int(value):\n    \"\"\"Rounds a numeric value up to the next integer (ceiling).\"\"\"\n    return int(math.ceil(value))\ndef wind_chill(wind_velocity_kmh, temperature_c):\n    \"\"\"\n    Calculates the wind chill index rounded to the next integer.\n\n    Args:\n        wind_velocity_kmh (float or int): The wind velocity in km/h.\n        temperature_c (float or int): The temperature in Celsius.\n\n    Returns:\n        int: The wind chill index, rounded up to the nearest integer.\n\n    Raises:\n        TypeError: If either input is not a numeric value.\n    \"\"\"\n    _validate_numeric(wind_velocity_kmh, 'wind_velocity_kmh')\n    _validate_numeric(temperature_c, 'temperature_c')\n\n    raw_wind_chill = _compute_wind_chill_raw(float(wind_velocity_kmh), float(temperature_c))\n    return _ceil_to_int(raw_wind_chill)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[120, 35]], "plus_fail_tests": [[0, 0]]}], "Mbpp/639": [{"task_id": "Mbpp/639", "solution": "import typing\ndef sample_nam(names: typing.List[str]) -> int:\n    \"\"\"\n    Sums the length of names that do not start with a lowercase letter.\n    Uses an internal helper to check for lowercase starting characters.\n    \"\"\"\n    def _starts_with_ascii_lowercase(s: str) -> bool:\n        \"\"\"Checks if a string starts with an ASCII lowercase letter.\"\"\"\n        return len(s) > 0 and 'a' <= s[0] <= 'z'\n\n    total_length = 0\n    for name in names:\n        if not _starts_with_ascii_lowercase(name):\n            total_length += len(name)\n    return total_length", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[["AbCdE", "fGH", "IJKLMnOp", "qrs", "TUVW", "xyz"]]]}], "Mbpp/641": [{"task_id": "Mbpp/641", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for validation failures.\"\"\"\n    def __init__(self, message=\"Invalid input provided.\"):\n        self.message = message\n        super().__init__(self.message)\nclass NonagonalNumber:\n    \"\"\"A value object to hold a nonagonal number.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass NonagonalCalculator:\n    \"\"\"Calculates nonagonal numbers, including input validation.\"\"\"\n\n    def validate(self, n: int):\n        \"\"\"Validates if n is an integer and n >= 1.\"\"\"\n        if not isinstance(n, int):\n            raise ValidationError(\"Input 'n' must be an integer.\")\n        if n < 1:\n            raise ValidationError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the nth nonagonal number using the formula.\"\"\"\n        return (7 * n * n - 5 * n) // 2\n\n    def is_nonagonal(self, n: int) -> int:\n        \"\"\"Orchestrates validation, computation, and returns the integer result.\"\"\"\n        self.validate(n)\n        computed_value = self.compute(n)\n        # The design implies NonagonalCalculator produces NonagonalNumber,\n        # but the method returns int. We extract the value.\n        return NonagonalNumber(computed_value).value\ndef is_nonagonal(n: int) -> int:\n    \"\"\"\n    Finds the nth nonagonal number.\n    Validates input and computes the number using a NonagonalCalculator.\n    \"\"\"\n    calculator = NonagonalCalculator()\n    return calculator.is_nonagonal(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[0]]}], "Mbpp/643": [{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"\n    Checks if any word in the string contains a lowercase 'z' not at its first or last position.\n    Words are defined as contiguous alphanumeric sequences.\n    \"\"\"\n    words = []\n    current_word_chars = []\n    \n    for char in input_string:\n        if char.isalnum():\n            current_word_chars.append(char)\n        else:\n            if current_word_chars:\n                words.append(\"\".join(current_word_chars))\n                current_word_chars = []\n    \n    if current_word_chars:\n        words.append(\"\".join(current_word_chars))\n\n    for word in words:\n        if len(word) >= 3:\n            # Check for 'z' strictly between the first and last characters\n            for i in range(1, len(word) - 1):\n                if word[i] == 'z':\n                    return True\n                    \n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/644": [{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(list, k):\n    \"\"\"\n    Reverses elements of a list up to a specified position k, returning a new list.\n\n    Type validation and specific reversal behaviors are applied based on the value of k.\n    \"\"\"\n    if not isinstance(list, list):\n        raise TypeError(\"First argument must be a list.\")\n    if not isinstance(k, int):\n        raise TypeError(\"Second argument 'k' must be an integer.\")\n\n    if k <= 0:\n        return list.copy()\n\n    if k >= len(list):\n        return list[::-1]\n\n    reversed_part = list[:k][::-1]\n    remaining_part = list[k:]\n    return reversed_part + remaining_part", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 2, 3, 4, 5, 6], 4]], "plus_fail_tests": [[[6, 9, 2, 1, 5, 3], 4]]}], "Mbpp/630": [{"task_id": "Mbpp/630", "solution": "class Coordinate:\n    \"\"\"\n    Represents a single coordinate pair (x, y).\n    Provides conversion to the required output format and supports equality checks.\n    \"\"\"\n    def __init__(self, x: int, y: int) -> None:\n        self.x = x\n        self.y = y\n\n    def to_list(self) -> list:\n        \"\"\"Returns the coordinate as a list [x, y].\"\"\"\n        return [self.x, self.y]\n\n    def __eq__(self, other) -> bool:\n        \"\"\"Compares two Coordinate objects for equality.\"\"\"\n        if not isinstance(other, Coordinate):\n            return NotImplemented\n        return self.x == other.x and self.y == other.y\n\n    def __hash__(self) -> int:\n        \"\"\"Returns a hash for the Coordinate object, enabling use in sets/dicts.\"\"\"\n        return hash((self.x, self.y))\nclass CoordinateService:\n    \"\"\"\n    Orchestrates the process of extracting adjacent coordinates,\n    including validation, generation, deduplication, sorting, and formatting.\n    \"\"\"\n    def get_coordinates(self, coord: tuple) -> list:\n        \"\"\"\n        Processes the input coordinate to return its 8 neighbors and itself,\n        deduplicated, sorted, and formatted.\n        \"\"\"\n        x, y = self._validate_input(coord)\n        \n        candidates = self._generate_candidates(x, y)\n        deduped_coords = self._dedupe(candidates)\n        sorted_coords = self._sort(deduped_coords)\n        formatted_coords = self._format(sorted_coords)\n        \n        return formatted_coords\n\n    def _validate_input(self, c