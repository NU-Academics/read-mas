            max_sublist = sublist\n        return max_sublist\ndef max_sum_list(input_arg: Union[List[List[float]], InputList]) -> List[float]:\n    \"\"\"\n    Returns the sublist from a list of lists of numbers whose sum of elements is the highest.\n    Handles input normalization and delegates to internal logic.\n    \"\"\"\n    if not isinstance(input_arg, InputList):\n        input_list_obj = InputList(lists=input_arg)\n    else:\n        input_list_obj = input_arg\n\n    msf = MaxSumFunction()\n    selected_sublist_obj = msf.max_sum_list(input_list_obj)\n\n    return selected_sublist_obj.elements", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/765": [{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number. A polite number is a positive integer that is not a power of two.\n    \"\"\"\n    polite_count = 0\n    current_num = 1\n\n    while True:\n        # Check if current_num is a power of two (including 1 = 2^0)\n        # A positive integer x is a power of two if x > 0 and (x & (x - 1)) == 0.\n        is_power_of_two = (current_num > 0) and ((current_num & (current_num - 1)) == 0)\n\n        if not is_power_of_two:\n            polite_count += 1\n            if polite_count == n:\n                return current_num\n        current_num += 1", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[1000000000]]}], "Mbpp/271": [{"task_id": "Mbpp/271", "solution": "def even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fifth powers of the first n even natural numbers.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    def _validate_n(n_val) -> None:\n        if not isinstance(n_val, int):\n            raise TypeError(\"Input n must be an integer.\")\n        if n_val < 0:\n            raise ValueError(\"Input n must be a non-negative integer.\")\n\n    def _generate_even_sequence(n_val) -> 