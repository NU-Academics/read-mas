o numbers.\"\"\"\n\n    def compute_gcd(self, a: int, b: int) -> int:\n        \"\"\"Computes the greatest common divisor of two non-negative integers.\"\"\"\n        return math.gcd(a, b)\n\n    def list_common_divisors(self, num: int) -> List[int]:\n        \"\"\"Lists all positive divisors of a given non-negative integer.\"\"\"\n        divs = set()\n        if num == 0:\n            return []\n\n        for i in range(1, int(math.sqrt(num)) + 1):\n            if num % i == 0:\n                divs.add(i)\n                divs.add(num // i)\n        return sorted(list(divs))\n\n    def sum_common_divisors(self, a: int, b: int) -> int:\n        \"\"\"Computes the sum of common divisors for two non-negative integers.\"\"\"\n        gcd_val = self.compute_gcd(a, b)\n        divs = self.list_common_divisors(gcd_val)\n        return sum(divs)\ndef sum(a, b) -> int:\n    \"\"\"\n    Finds the sum of common divisors of two given numbers.\n    Uses absolute values of inputs for calculation.\n    \"\"\"\n    a_abs, b_abs = abs(a), abs(b)\n    calculator = CommonDivisorCalculator()\n    return calculator.sum_common_divisors(a_abs, b_abs)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[10, 15]], "plus_fail_tests": [[27, 81]]}], "Mbpp/119": [{"task_id": "Mbpp/119", "solution": "def search(sorted_list):\n    \"\"\"\n    Finds the element that appears only once in a sorted array\n    where all other elements appear exactly twice using the XOR property.\n    \"\"\"\n    unique_element = 0\n    for num in sorted_list:\n        unique_element ^= num\n    return unique_element", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/118": [{"task_id": "Mbpp/118", "solution": "def string_to_list(input_string):\n    \"\"\"Split input_string on the space character (' ') and return a List[str].\"\"\"\n    return input_string.split(' ')", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tes