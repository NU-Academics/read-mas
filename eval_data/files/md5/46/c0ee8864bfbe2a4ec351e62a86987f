"class InvalidArgumentError(Exception):\n    \"\"\"Exception raised for invalid arguments to find_kth.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass Validator:\n    \"\"\"Helper class for validating inputs to find_kth.\"\"\"\n    @staticmethod\n    def validate(A, B, k):\n        if not isinstance(k, int):\n            raise InvalidArgumentError(\"Parameter 'k' must be an integer.\")\n        \n        if A is None or B is None:\n             raise InvalidArgumentError(\"Arrays A and B cannot be None.\")\n\n        total_length = len(A) + len(B)\n        if not (1 <= k <= total_length):\n            raise InvalidArgumentError(\n                f\"Parameter 'k' ({k}) is out of range. \"\n                f\"It must be between 1 and {total_length} (inclusive).\"\n            )\ndef find_kth(A, B, k):\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays using a two-pointer scan.\n    Input arrays A and B are assumed to be sorted in non-decreasing order.\n    \"\"\"\n    Validator.validate(A, B, k)\n\n    len_A, len_B = len(A), len(B)\n    ptr_A, ptr_B = 0, 0\n    \n    current_kth_element = None\n\n    # Iterate k times to find the k-th element (1-based indexing)\n    for _ in range(k):\n        # If array A is exhausted, take elements from B\n        if ptr_A == len_A:\n            current_kth_element = B[ptr_B]\n            ptr_B += 1\n        # If array B is exhausted, take elements from A\n        elif ptr_B == len_B:\n            current_kth_element = A[ptr_A]\n            ptr_A += 1\n        # Compare current elements from both arrays and pick the smaller one\n        elif A[ptr_A] <= B[ptr_B]:\n            current_kth_element = A[ptr_A]\n            ptr_A += 1\n        else: # B[ptr_B] < A[ptr_A]\n            current_kth_element = B[ptr_B]\n            ptr_B += 1\n            \n    return current_kth_element", "base_status": "pass", "plus_status": "fail", "base_fail_tests"