    return bit_op.set_bit(value, unset_bit_position)\n    else:\n        # If all bits in the minimal representation are set, set the next higher-order bit.\n        new_bit_position = value.bit_length()\n        return bit_op.set_bit(value, new_bit_position)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[10]], "plus_fail_tests": [[125]]}], "Mbpp/308": [{"task_id": "Mbpp/308", "solution": "from typing import List, Tuple\nimport heapq\nclass ProductPair:\n    \"\"\"Encapsulates a pair (values and indices) and computes product and ordering key.\"\"\"\n    def __init__(self, a: float, b: float, i: int, j: int):\n        self.a = a\n        self.b = b\n        self.i = i\n        self.j = j\n\n    def product(self) -> float:\n        \"\"\"Returns the product of a and b.\"\"\"\n        return self.a * self.b\n\n    def key_for_ordering(self) -> Tuple[float, int, int]:\n        \"\"\"Returns the key for deterministic ordering: (product, i, j).\"\"\"\n        return (self.product(), self.i, self.j)\nclass ProductResult:\n    \"\"\"Encapsulates final result list and deterministic sorting behavior.\"\"\"\n    def __init__(self):\n        self.products: List[float] = []\n\n    def sorted_desc(self, pairs: List[ProductPair]) -> None:\n        \"\"\"Converts ProductPair list into numeric products sorted by product descending, then i asc, then j asc.\"\"\"\n        # Sort ProductPair objects according to the deterministic tie-break rule.\n        sorted_pairs = sorted(pairs, key=lambda p: (-p.product(), p.i, p.j))\n        self.products = [p.product() for p in sorted_pairs]\nclass Validator:\n    \"\"\"Validates input lists and k; enforces boundary policies.\"\"\"\n    def validate_inputs(self, list1: List[float], list2: List[float], k: int) -> bool:\n        \"\"\"Returns True if inputs are valid for computation, False for boundary cases (k <= 0 or empty lists).\"\"\"\n        if k <= 0 or not list1 or not list2:\n            return False\n        return True\nclass TopKCalculator:\n    \"\"\"Computes k largest pairwise products efficiently and deterministically.\"\"\"\n    def compute_top_k(self, list1: List[float], list2: List[float], k: int) -> List[ProductPair]:\n        \"\"\"\n        Produces k largest ProductPair objects efficiently using a best-first search (heap-based).\n        Handles general numeric lists (positive/negative/zero) by exploring relevant quadrants.\n        \"\"\"\n        if not list1 or not list2 or k <= 0:\n            return []\n\n        # Categorize numbers, keeping original indices for tie-breaking.\n        pos1 = sorted([(val, idx) for idx, val in enumerate(list1) if val > 0], key=lambda x: x[0], reverse=True)\n        neg1 = sorted([(val, idx) for idx, val in enumerate(list1) if val < 0], key=lambda x: x[0]) # Smallest (most negative) first\n        zero1 = [(val, idx) for idx, val in enumerate(list1) if val == 0]\n\n        pos2 = sorted([(val, idx) for idx, val in enumerate(list2) if val > 0], key=lambda x: x[0], reverse=True)\n        neg2 = sorted([(val, idx) for idx, val in enumerate(list2) if val < 0], key=lambda x: x[0]) # Smallest (most negative) first\n        zero2 = [(val, idx) for idx, val in enumerate(list2) if val == 0]\n\n        all_candidate_pairs: List[ProductPair] = []\n\n        # Helper to run best-first search on a specific quadrant\n        # sorted_l1 and sorted_l2 are lists of (value, original_index) tuples, pre-sorted\n        # is_neg_prod is a flag if the products in this quadrant are generally negative\n        def _run_heap_search(sorted_l1: List[Tuple[float, int]], sorted_l2: List[Tuple[float, int]]):\n            if not sorted_l1 or not sorted_l2:\n                return\n\n            current_heap = []\n            visited = set()\n\n            val1, orig_idx1 = sorted_l1[0]\n            val2, orig_idx2 = sorted_l2[0]\n            initial_product = val1 * val2\n            # Store (-product, original_idx1, original_idx2, index_in_sorted_l1, index_in_sorted_l2)\n            heapq.heappush(current_heap, (-initial_product, orig_idx1, orig_idx2, 0, 0))\n            visited.add((0, 0))\n\n            while current_heap:\n                prod_neg, o_idx1, o_idx2, cur_i, cur_j = heapq.heappop(current_heap)\n                all_candidate_pairs.append(ProductPair(sorted_l1[cur_i][0], sorted_l2[cur_j][0], o_idx1, o_idx2))\n\n                # Explore right neighbor (next element in sorted_l2)\n                if cur_j + 1 < len(sorted_l2) and (cur_i, cur_j + 1) not in visited:\n                    n_val1, n_o_idx1 = sorted_l1[cur_i]\n                    n_val2, n_o_idx2 = sorted_l2[cur_j + 1]\n                    new_prod = n_val1 * n_val2\n                    heapq.heappush(current_heap, (-new_prod, n_o_idx1, n_o_idx2, cur_i, cur_j + 1))\n                    visited.add((cur_i, cur_j + 1))\n\n                # Explore down neighbor (next element in sorted_l1)\n                if cur_i + 1 < len(sorted_l1) and (cur_i + 1, cur_j) not in visited:\n                    n_val1, n_o_idx1 = sorted_l1[cur_i + 1]\n                    n_val2, n_o_idx2 = sorted_l2[cur_j]\n                    new_prod = n_val1 * n_val2\n                    heapq.heappush(current_heap, (-new_prod, n_o_idx1, n_o_idx2, cur_i + 1, cur_j))\n                    visited.add((cur_i + 1, cur_j))\n\n        # 1. Products from (Positive * Positive)\n        _run_heap_search(pos1, pos2)\n        \n        # 2. Products from (Negative * Negative)\n        _run_heap_search(neg1, neg2)\n\n        # 3. Products from (Positive * Negative) - this will yield negative results\n        # To get the \"largest\" negative products (closest to zero, e.g., -1 > -100),\n        # we need to combine largest positive with smallest (most negative) negative, and vice versa.\n        # This means two starting points for heap search:\n        # A. From (pos1[0], neg2[0]) - largest positive * smallest negative (most negative product)\n        # B. From (neg1[0], pos2[0]) - small