sk_id": "Mbpp/67", "solution": "import math\nclass InputValidator:\n    \"\"\"\n    Validates that the input is a non-negative integer.\n    Raises TypeError for non-integer inputs and ValueError for negative integers.\n    \"\"\"\n    def _is_non_negative_integer(self, n) -> bool:\n        return isinstance(n, int) and n >= 0\n\n    def validate(self, n) -> None:\n        if not self._is_non_negative_integer(n):\n            if not isinstance(n, int):\n                raise TypeError(f\"Input must be an integer, but got {type(n).__name__}\")\n            else:\n                raise ValueError(f\"Input must be a non-negative integer, but got {n}\")\nclass BellNumberCalculator:\n    \"\"\"\n    Computes Bell numbers using a recursive summation formula and memoization.\n    It maintains a private cache to store previously computed values.\n    \"\"\"\n    def __init__(self):\n        self._cache = {0: 1} # Base case: B_0 = 1\n\n    def _nCr(self, n: int, r: int) -> int:\n        \"\"\"Helper to calculate combinations C(n, r) using math.comb.\"\"\"\n        if r < 0 or r > n:\n            return 0\n        return math.comb(n, r)\n\n    def _compute_recursive_sum(self, n: int) -> int:\n        \"\"\"\n        Calculates B_n using the recurrence B_n = sum_{k=0}^{n-1} C(n-1, k) * B_k for n > 0.\n        Results are memoized in the internal cache.\n        \"\"\"\n        if n in self._cache:\n            return self._cache[n]\n\n        bell_n = 0\n        for k in range(n):\n            bell_n += self._nCr(n - 1, k) * self._compute_recursive_sum(k)\n\n        self._cache[n] = bell_n\n        return bell_n\n\n    def bell_number(self, n: int) -> int:\n        \"\"\"Public method for the calculator to get the nth Bell number.\"\"\"\n        return self._compute_recursive_sum(n)\n_input_validator = InputValidator()\n_bell_calculator = BellNumberCalculator()\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number, which represents the number of partitions of a set of size n.\n    Input n must be a non-negative integer.\n    \"\"\"\n    _input_validator.validate(n)\n    return _bell_calculator.bell_number(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/71": [{"task_id": "Mbpp/71", "solution": "class Element:\n    \"\"\"Wraps a value and provides comparison logic.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def compareTo(self, other):\n        \"\"\"Compares this element's value with another Element's value.\"\"\"\n        # This relies on Python's natural comparison, propagating TypeError for incompatible types.\n        if self.value < other.value:\n            return -1\n        elif self.value > other.value:\n            return 1\n        else:\n            return 0\n\n    def __lt__(self, other):\n        return self.compareTo(other) < 0\n\n    def __le__(self, other):\n        return self.compareTo(other) <= 0\n\n    def __gt__(self, other):\n        return self.compareTo(other) > 0\n\n    def __ge__(self, other):\n        return self.compareTo(other) >= 0\n\n    def __eq__(self, other):\n        return self.compareTo(other) == 0\n\n    def __ne__(self, other):\n        return self.compareTo(other) != 0\nclass List:\n    \"\"\"Lightweight wrapper for an input list.\"\"\"\n    def __init__(self, elements):\n        self.elements = elements\n\n    def length(self):\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\nclass ResultList:\n    \"\"\"Lightweight wrapper for an output list.\"\"\"\n    def __init__(self, elements):\n        self.elements = elements\n\n    def length(self):\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\nclass CombSortSystem:\n    \"\"\"Encapsulates the comb sort algorithm parameters and execution.\"\"\"\n    def __init__(self, shrink_factor = 1.3):\n        self._shrinkFactor = shrink_factor\n\n    def _next_gap(self, current_gap):\n        \"\"\"Computes the next gap from the current gap using the shrinkFactor.\"\"\"\n        new_gap = int(current_gap / self._shrinkFactor)\n        return max(1, new_gap)\n\n    def validate_input(self, input_list):\n        \"\"\"Verifies input is a list of mutually comparable elements.\"\"\"\n        if len(input_list) > 1:\n            # Check comparability by attempting a comparison between two elements.\n            # Element.compareTo will raise TypeError if the underlying values are not comparable.\n            _ = Element(input_list[0]).compareTo(Element(input_list[1]))\n\n    def comb_sort(self, input_list_wrapper):\n        \"\"\"Performs comb sort and returns a new sorted ResultList.\"\"\"\n        elements_wrapped = [Element(item) for item in input_list_wrapper.elements]\n        n = len(elements_wrapped)\n\n        if n <= 1:\n            return ResultList([e.value for e in elements_wrapped])\n\n        gap = n\n        swapped = True\n\n        while gap > 1 or swapped:\n            gap = self._next_gap(gap)\n            swapped = False\n\n            for i in range(n - gap):\n                if elements_wrapped[i] > elements_wrapped[i + gap]:\n                    elements_wrapped[i], elements_wrapped[i + gap] = elements_wrapped[i + gap], elements_wrapped[i]\n                    swapped = True\n        \n        return ResultList([e.value for e in elements_wrapped])\ndef comb_sort(list):\n    \"\"\"Sorts a list of elements using the comb sort algorithm.\"\"\"\n    system = CombSortSystem()\n    system.validate_input(list)\n    \n    input_list_wrapped = List(list)\n    sorted_result_wrapped = system.comb_sort(input_list_wrapped)\n    \n    return sorted_result_wrapped.elements", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/75": [{"task_id": "Mbpp/75", "solution": "def _tuple_all_divisible(tpl: tuple, k: int) -> bool:\n    \"\"\"Checks if all elements in a tu