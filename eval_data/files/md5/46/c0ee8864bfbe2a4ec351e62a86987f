of a regex match.\"\"\"\n    def __init__(self, matched_substring: str, start_index: int, end_index: int):\n        self.matched_substring = matched_substring\n        self.start_index = start_index\n        self.end_index = end_index\n\n    def isMatch(self) -> bool:\n        \"\"\"Indicates if a valid match was found.\"\"\"\n        return self.start_index >= 0 and self.matched_substring is not None\n\n    def as_tuple(self) -> tuple:\n        \"\"\"Returns the match details as a tuple (substring, start, end).\"\"\"\n        return (self.matched_substring, self.start_index, self.end_index)\nclass SearchEngine:\n    \"\"\"Performs the regex search operation.\"\"\"\n    def findFirst(self, input_string_obj: InputString, pattern_obj: RegexPattern) -> MatchResult | None:\n        \"\"\"\n        Finds the first (left-most) occurrence of the pattern in the input string.\n        Returns a MatchResult object if a match is found, otherwise None.\n        \"\"\"\n        compiled_pattern = pattern_obj.compile()\n        match = compiled_pattern.search(input_string_obj.text)\n        if match:\n            return MatchResult(match.group(0), match.start(), match.end())\n        return None\ndef find_literals(input_string, pattern):\n    \"\"\"\n    Searches a string for a regex pattern, returning the matching substring,\n    start index, and end index.\n    \"\"\"\n    isrc = InputString(input_string)\n    rpat = RegexPattern(pattern)\n    \n    engine = SearchEngine()\n    result = engine.findFirst(isrc, rpat)\n\n    if result is None:\n        return None\n    return result.as_tuple()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/605": [{"task_id": "Mbpp/605", "solution": "import math\ndef isPrime(n: int) -> bool:\n    \"\"\"Helper: returns True iff n is prime for n >= 2.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    # Check odd divisors up to the square root of n\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\ndef prime_num(value: int) -> bool:\n    \"\"\"Checks if the given integer is a prime number.\"\"\"\n    # Return False if input is not an integer, as per design.\n    if not isinstance(value, int):\n        return False\n\n    # Numbers less than 2 are not prime, as per design.\n    if value < 2:\n        return False\n    \n    # For integers >= 2, delegate the primality check to the isPrime helper.\n    return isPrime(value)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/610": [{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list, k):\n    \"\"\"Return a new list with the k'th (1-based) element removed.\n\n    This function does not mutate the original input_list.\n    \"\"\"\n    def _validate_parameters(input_list, k):\n        \"\"\"Validates input_list and k, raising TypeError or IndexError on failure.\"\"\"\n        if not isinstance(k, int):\n            raise TypeError('k must be an integer')\n        if not (1 <= k <= len(input_list)):\n            raise IndexError('k is out of range for the input list')\n\n    _validate_parameters(input_list, k)\n\n    # Create a shallow copy of the list to avoid mutating the original\n    copy_list = input_list[:]\n    # k is 1-based, so the actual index is k-1\n    del copy_list[k - 1]\n    return copy_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/608": [{"task_id": "Mbpp/608", "solution": "class InputParameter:\n    \"\"\"Logical holder representing the input parameter n.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\nclass BellNumberResult:\n    \"\"\"Logical holder representing the computed Bell number result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass BellNumberCalculator:\n    \"\"\"\n    Validates input and computes the nth Bell number using dynamic programming,\n    maintaining a memoization cache.\n    \"\"\"\n    def __init__(self):\n        # Memoization cache mapping int n -> int Bell number.\n        self._cache = {0: 1} # Base case: B_0 = 1\n\n    def validate(self, n) -> bool:\n        \"\"\"Validates if n is a non-negative number.\"\"\"\n        # Per \"DO NOT add isinstance() checks\", type validation is implicitly limited.\n        return n >= 0\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Computes the nth Bell number using Stirling numbers of the second kind,\n        employing memoization to store previously computed Bell numbers.\n        \"\"\"\n        if n in self._cache:\n            return self._cache[n]\n\n        # Determine the maximum Bell number already computed to fill the cache efficiently.\n        # This implementation will recompute Stirling numbers for the required range\n        # if `n` is outside the current cache scope.\n        \n        # Create a local DP table for Stirling numbers S(i, k) up to n.\n        # S(i, k) = S(i-1, k-1) + k * S(i-1, k)\n        stirling_numbers = [[0] * (n + 1) for _ in range(n + 1)]\n        stirling_numbers[0][0] = 1 # S(0,0) = 1\n\n        for i in range(1, n + 1):\n            current_bell_number = 0\n            for k in range(1, i + 1):\n                stirling_numbers[i][k] = stirling_numbers[i - 1][k - 1] + k * stirling_numbers[i - 1][k]\n            \n            # Sum S(i, k) for k from 0 to i to get B_i.\n            # S(i,0) is 0 for i > 0, so loop sums for all k.\n            for k_sum in range(i + 1):\n                current_bell_number += stirling_numbers[i][k_sum]\n            self._cache[i] = current_bell_number\n            \n        return self._cache[n]\n_bell_calculator = BellNumberCalculator()\ndef bell_Number(n):\n    \"\"\"\n    Computes the nth Bell number by delegating to a BellNumberCalculator instance.\n    Handles validation for non-negative input; returns 0 for negative input.\n    \"\"\"\n    # Create InputParameter as a logical holder for traceability.\n    param = InputParameter(n)\n    \n    # Validate input using the calculator.\n    if not _bell_calculator.validate(param.n):\n        # Per \"DO NOT raise exceptions for edge cases\" constraint, return 0 for negative n.\n        return 0\n    \n    # Compute the Bell number.\n    result_value = _bell_calculator.compute(param.n)\n    \n    # Create BellNumberResult as a logical holder for traceability.\n    result = BellNumberResult(result_value)\n    return result.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/611": [{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix, n):\n    \"\"\"\n    Returns the maximum value found in the nth column of the given matrix.\n    Assumes a valid matrix (list of lists) and column index n.\n    \"\"\"\n    column_values = [row[n] for row in matrix]\n    return max(column_values)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/615": [{"task_id": "Mbpp/615", "solution": "class TupleCollection:\n    \"\"\"Data holder representing the top-level input tuple-of-tuples.\"\"\"\n    def __init__(self, tuples: tuple):\n        self.tuples = tuples\n\n    def get_tuples(self) -> tuple:\n        return self.tuples\nclass ResultList:\n    \"\"\"Data holder for results; accumulates float results and exposes them as a Python list.\"\"\"\n    def __init__(self):\n        self.results: list[float] = []\n\n    def append(self, value: float) -> None:\n        self.results.append(value)\n\n    def to_list(self) -> list[float]:\n        return self.results\nclass InputValidator:\n    \"\"\"Validates input structure and element types, raising TypeError/ValueError on failure.\"\"\"\n    def validate_collection(self, collection: any) -> bool:\n        if not isinstance(collection, tuple):\n            raise TypeError(\"Input must be a tuple of tuples\")\n        \n        for inner_tuple in collection:\n            self.validate_tuple(inner_tuple) \n        return True\n\n    def validate_tuple(self, t: any) -> bool:\n        if not isinstance(t, tuple):\n            raise TypeError(\"Input must be a tuple of tuples\")\n        \n        if not t:\n            raise ValueError(\"Inner tuples must be non-empty\")\n        \n        for item in t:\n            if not isinstance(item, (int, float)):\n                raise TypeError(\"All elements must be numeric (int or float)\")\n        return True\nclass AverageCalculator:\n    \"\"\"Computes arithmetic mean for each inner tuple.\"\"\"\n    def compute_mean(self, values: tuple) -> float:\n        return float(sum(values)) / len(values)\n\n    def average_tuple(self, collection: TupleCollection) -> ResultList:\n        result_list = ResultList()\n        for inner_tuple_values in collection.get_tuples():\n            mean = self.compute_mean(inner_tuple_values)\n            result_list.append(mean)\n        return result_list\ndef average_tuple(collection):\n    \"\"\"\n    Computes the average value for each inner tuple in a tuple of tuples.\n    Validates input and returns a list of floats.\n    \"\"\"\n    tc = TupleCollection(collection)\n    validator = InputValidator()\n    validator.validate_collection(tc.get_tuples())\n    \n    calculator = AverageCalculator()\n    results = calculator.average_tuple(tc)\n    return results.to_list()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[10, 10, 10, 12], [30, 45, 56, 45], [81, 80, 39, 32], [1, 2, 3, 4]]]], "plus_fail_tests": [[[[7, 8, 9], [-2, -4, -6], [0, 20, 30]]]]}], "Mbpp/612": [{"task_id": "Mbpp/612", "solution": "from typing import Any, List, Sequence\nclass Pair:\n    \"\"\"Two-element value object.\"\"\"\n    def __init__(self, first: Any, second: Any) -> None:\n        self.first = first\n        self.second = second\n\n    def getFirst(self) -> Any:\n        return self.first\n\n    def getSecond(self) -> Any:\n        return self.second\nclass InputList:\n    \"\"\"Logical container for input pairs.\"\"\"\n    def __init__(self, raw_pairs: Sequence[Sequence[Any]]) -> None:\n        self.pairs: List[Pair] = []\n        for item in raw_pairs:\n            self.pairs.append(Pair(item[0], item[1]))\n\n    def count(self) -> int:\n        return len(self.pairs)\nclass OutputLists:\n    \"\"\"Hold resulting firsts and seconds and present as nested list.\"\"\"\n    def __init__(self, firsts: List[Any], seconds: List[Any]) -> None:\n        self.firsts = firsts\n        self.seconds = seconds\n\n    def asList(self) -> List[List[Any]]:\n        return [self.firsts, self.seconds]\nclass MergeFunction:\n    \"\"\"Core merge operation and validation.\"\"\"\n    def validate(self, input_list: List[List[Any]]) -> None:\n        \"\"\"Raise ValueError if input is not a list of 2-element lists.\"\"\"\n        for i, sublist in enumerate(input_list):\n            if not isinstance(sublist, list) or len(sublist) != 2:\n                raise ValueError(f\"Each sublist must contain exactly two elements. Sublist at index {i} is invalid.\")\n\n    def merge(self, input_list: List[List[Any]]) -> List[List[Any]]:\n        \"\"\"Validate input and return [firsts, seconds].\"\"\"\n        self.validate(input_list)\n\n        if not input_list:\n            return OutputLists([], []).asList()\n\n        input_container = InputList(input_list)\n        \n        firsts: List[Any] = []\n        seconds: List[Any] = []\n\n        for pair_obj in input_container.pairs:\n            firsts.append(pair_obj.getFirst())\n            seconds.append(pair_obj.getSecond())\n        \n        return OutputLists(firsts, seconds).asList()\ndef merge(input: List[List[Any]]) -> List[List[Any]]:\n    \"\"\"\n    Public API function: transforms a list of 2-element sublists into a list of two lists\n    (firsts, seconds), or raises ValueError for invalid input.\n    \"\"\"\n    return MergeFunction().merge(input)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/614": [{"task_id": "Mbpp/614", "solution": "def cummulative_sum(input_list: list[tuple[int, ...]]) -> int:\n    \"\"\"Compute the cumulative sum of all integers in the provided list of tuples.\n    It iterates through each tuple and each integer to sum them up.\n    \"\"\"\n    total_sum = 0\n    for tup in input_list:\n        for num in tup:\n            total_sum += num\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/616": [{"task_id": "Mbpp/616", "solution": "class Validator:\n    def check_types(self, input_a, input_b) -> None:\n        if not isinstance(input_a, tuple) or not isinstance(input_b, tuple):\n            raise TypeError(\"Both inputs must be tuples\")\n    def check_length(self, input_a, input_b) -> None:\n        if len(input_a) != len(input_b):\n            raise ValueError(\"Input tuples must have the same length\")\n    def check_no_zero(self, input_b) -> None:\n        if any(b == 0 for b in input_b):\n            raise ZeroDivisionError(\"Divisor tuple contains zero\")\ndef tuple_modulo(input_a: tuple, input_b: tuple) -> tuple:\n    \"\"\"Performs element-wise modulo on two tuples after validating inputs.\"\"\"\n    validator = Validator()\n    validator.check_types(input_a, input_b)\n    validator.check_length(input_a, input_b)\n    validator.check_no_zero(input_b)\n    results = tuple(a % b for a, b in zip(input_a, input_b))\n    return results", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/618": [{"task_id": "Mbpp/618", "solution": "class NumberList:\n    \"\"\"Encapsulates a sequence of numeric elements with read-only access.\"\"\"\n    def __init__(self, elements):\n        self._elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self._elements)\n\n    def get(self, index: int):\n        \"\"\"Returns the element at the specified index.\"\"\"\n        return self._elements[index]\nclass DivisionResult:\n    \"\"\"Container for the float results of element-wise division.\"\"\"\n    def __init__(self, results):\n        self.results = results\n\n    def length(self) -> int:\n        \"\"\"Returns the number of results.\"\"\"\n        return len(self.results)\nclass DivOperation:\n    \"\"\"Encapsulates and executes the element-wise division operation including validations.\"\"\"\n    def __init__(self, numerator: NumberList, denominator: NumberList):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    def execute(self) -> DivisionResult:\n        \"\"\"Performs element-wise division, including length and zero denominator validations.\"\"\"\n        if self.numerator.length() != self.denominator.length():\n            raise ValueError(\n                f\"input lists must have identical lengths: len(a)={self.numerator.length()}, \"\n                f\"len(b)={self.denominator.length()}\"\n            )\n\n        for i in range(self.denominator.length()):\n            if self.denominator.get(i) == 0:\n                raise ZeroDivisionError(f\"zero denominator at index {i}\")\n\n        results = []\n        for i in range(self.numerator.length()):\n            num_val = float(self.numerator.get(i))\n            denom_val = float(self.denominator.get(i))\n            results.append(num_val / denom_val)\n\n        return DivisionResult(results)\ndef div_list(a, b):\n    \"\"\"\n    Divides two lists element-wise, returning a new list of floats.\n\n    Raises ValueError for length mismatches or ZeroDivisionError for zero denominators.\n    \"\"\"\n    numerator_list = NumberList(a)\n    denominator_list = NumberList(b)\n\n    operation = DivOperation(numerator_list, denominator_list)\n    division_result = operation.execute()\n\n    return division_result.results", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/619": [{"task_id": "Mbpp/619", "solution": "import collections\ndef move_num(input_str: str) -> str:\n    \"\"\"Move all numbers to the end of the given string while maintaining relative order.\"\"\"\n    non_digits = collections.deque()\n    digits = collections.deque()\n\n    for char in input_str:\n        if '0' <= char <= '9':\n            digits.append(char)\n        else:\n            non_digits.append(char)\n\n    return \"\".join(non_digits) + \"\".join(digits)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/620": [{"task_id": "Mbpp/620", "solution": "class NumberElement:\n    \"\"\"Represents an integer value, maintaining identity for duplicates.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def equals(self, other: 'NumberElement') -> bool:\n        return self.value == other.value\nclass NumberList:\n    \"\"\"A list of NumberElement instances.\"\"\"\n    def __init__(self, numbers: list[NumberElement]):\n        self.numbers = numbers\n\n    def size(self) -> int:\n        return len(self.numbers)\nclass SubsetResult:\n    \"\"\"Holds the elements of a divisible subset and its size.\"\"\"\n    def __init__(self, elements: list[NumberElement]):\n        self.elements = elements\n        self.size = len(elements)\nclass Divisibility:\n    \"\"\"Stateless utility for checking pairwise divisibility, robust for zero.\"\"\"\n    @staticmethod\n    def divides(a: int, b: int) -> bool:\n        \"\"\"Checks if a is divisible by b or b is divisible by a.\"\"\"\n        if b == 0:\n            return a == 0 # 0 is divisible by 0. Any non-zero number is not divisible by 0.\n        if a == 0:\n            return True # 0 is divisible by any non-zero number.\n        return a % b == 0 or b % a == 0\ndef _build_number_list(numbers: list[int]) -> NumberList:\n    \"\"\"Convert primitive int list into NumberList preserving duplicates as separate NumberElement instances.\"\"\"\n    elements = [NumberElement(num) for num in numbers]\n    return NumberList(elements)\ndef _find_largest_divisible_subset(num_list: NumberList) -> SubsetResult:\n    \"\"\"Algorithm core: returns SubsetResult for the largest divisible subset found in num_list.\"\"\"\n    if not num_list.numbers:\n        return SubsetResult([])\n\n    sorted_elements = sorted(num_list.numbers, key=lambda x: x.value)\n    n = len(sorted_elements)\n    \n    dp = [1] * n\n    parent = [-1] * n\n    \n    max_len = 0\n    max_idx = -1\n\n    for i in range(n):\n        for j in range(i):\n            val_i = sorted_elements[i].value\n            val_j = sorted_elements[j].value\n            \n            if Divisibility.divides(val_i, val_j):\n                if dp[j] + 1 > dp[i]:\n                    dp[i] = dp[j] + 1\n                    parent[i] = j\n        \n        if dp[i] > max_len:\n            max_len = dp[i]\n            max_idx = i\n            \n    if max_idx == -1:\n        return SubsetResult([])\n\n    longest_subset_elements = []\n    current_idx = max_idx\n    while current_idx != -1:\n        longest_subset_elements.append(sorted_elements[current_idx])\n        current_idx = parent[current_idx]\n    \n    longest_subset_elements.reverse()\n    \n    return SubsetResult(longest_subset_elements)\ndef largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of a list of numbers where every pair is divisible.\n    Treats duplicates as distinct elements.\n    \"\"\"\n    if not numbers:\n        return 0\n    if len(numbers) == 1:\n        return 1\n\n    number_list = _build_number_list(numbers)\n    result = _find_largest_divisible_subset(number_list)\n    return result.size", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tes