: int) -> bool:\n        \"\"\"Checks if n is a positive integer (n >= 1).\"\"\"\n        return isinstance(n, int) and n >= 1\nclass NewmanConwayCalculator:\n    \"\"\"Computes Newman-Conway sequence values using recurrence and memoization.\"\"\"\n    def __init__(self):\n        self._cache = SequenceCache()\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Computes the nth Newman-Conway number, leveraging memoization.\n        Handles base cases and delegates recurrence to the internal helper.\n        \"\"\"\n        if self._cache.contains(n):\n            return self._cache.lookup(n)\n        \n        if n == 1 or n == 2:\n            self._cache.store(n, 1)\n            return 1\n            \n        result = self._a(n)\n        self._cache.store(n, result)\n        return result\n\n    def _a(self, n: int) -> int:\n        \"\"\"Internal helper implementing the Newman-Conway recurrence formula.\"\"\"\n        # a(n) = a(a(n-1)) + a(n-a(n-1))\n        # Recursive calls go through compute to ensure memoization.\n        term_n_minus_1 = self.compute(n - 1) \n        first_part = self.compute(term_n_minus_1)\n        second_part = self.compute(n - term_n_minus_1)\n        \n        return first_part + second_part\nclass SequenceFunction:\n    \"\"\"Public API class for accessing the Newman-Conway sequence.\"\"\"\n    def __init__(self):\n        self._validator = Validator()\n        self._calculator = NewmanConwayCalculator()\n\n    def sequence(self, n: int) -> int:\n        \"\"\"\n        Validates input n and returns the nth Newman-Conway number.\n        Raises InvalidInputError for invalid inputs.\n        \"\"\"\n        if not self._validator.isValid(n):\n            raise InvalidInputError(f\"Input must be a positive integer (n >= 1), but got {n}\")\n        \n        return self._calculator.compute(n)\n_sequence_handler = SequenceFunction()\ndef sequence(n: int) -> int:\n    \"\"\"\n    Finds the nth number in the Newman-Conway sequence.\n    a(1)=1, a(2)=1, and for n>2 a(n)=a(a(n-1))+a(n-a(n-1)).\n    \"\"\"\n    return _sequence_handler.sequence(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[10000]]}], "Mbpp/87": [{"task_id": "Mbpp/87", "solution": "from typing import Dict, Iterable, Tuple, Optional\nclass Dictionary:\n    \"\"\"Represents an input dictionary; provides deterministic enumeration access.\"\"\"\n    def __init__(self, backing: Dict = None) -> None:\n        self._entries: Dict[str, str] = {}\n        if backing is not None:\n            self._entries.update(backing)\n\n    def add(self, key: str, value: str) -> None:\n        \"\"\"Adds or updates a key-value pair in the dictionary.\"\"\"\n        self._entries[key] = value\n\n    def get(self, key: str) -> Optional[str]:\n        \"\"\"Retrieves the value for a given key, or None if not found.\"\"\"\n        return self._entries.get(key)\n\n    def items(self) -> Iterable[Tuple[str, str]]:\n        \"\"\"Returns an iterable of (key, value) pairs in insertion order.\"\"\"\n        return self._entries.items()\nclass ResultDictionary(Dictionary):\n    \"\"\"Represents the merged result; provides conversion to native dict.\"\"\"\n    def __init__(self, backing: Dict = None) -> None:\n        super().__init__(backing)\n\n    def to_native(self) -> Dict:\n        \"\"\"Converts the ResultDictionary instance to a native Python dictionary.\"\"\"\n        return dict(self._entries)\nclass MergeFunction:\n    \"\"\"Encapsulates merge logic combining three Dictionary instances.\"\"\"\n    def merge(self, dict1: 'Dictionary', dict2: 'Dictionary', dict3: 'Dictionary') -> 'ResultDictionary':\n        \"\"\"Merges three Dictionary objects into a single ResultDictionary using a \"first-seen wins\" strategy.\"\"\"\n        merged_result = ResultDictionary()\n\n        # Iterate inputs in order (dict1, dict2, dict3). First-seen value wins for duplicate keys.\n        for key, value in dict1.items():\n            if merged_result.get(key) is None:\n                merged_result.add(key, value)\n\n        for key, value in dict2.items():\n            if merged_result.get(key) is None:\n                merged_result.add(key, value)\n\n        for key, value in dict3.items():\n            if merged_result.get(key) is None:\n                merged_result.add(key, value)\n\n        return merged_result\ndef merge_dictionaries_three(dict1: Dict, dict2: Dict, dict3: Dict) -> Dict:\n    \"\"\"\n    Merges three dictionaries into a single dictionary.\n    Duplicate keys are resolved by keeping the value from the first-seen dictionary (dict1, then dict2, then dict3).\n    \"\"\"\n    # Wrap native dicts into domain objects\n    domain_dict1 = Dictionary(dict1)\n    domain_dict2 = Dictionary(dict2)\n    domain_dict3 = Dictionary(dict3)\n\n    # Delegate merging to MergeFunction\n    merge_logic = MergeFunction()\n    result_domain_dict = merge_logic.merge(domain_dict1, domain_dict2, domain_dict3)\n\n    # Convert the result back to a native dictionary\n    return result_domain_dict.to_native()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/90": [{"task_id": "Mbpp/90", "solution": "from dataclasses import dataclass\nfrom typing import List\ndef len_log(words: list[str]) -> int:\n    \"\"\"Compute and return the length of the longest string in words.\n\n    Returns 0 for an empty list, as per design.\n    \"\"\"\n    if not words:\n        return 0\n\n    word_objects = [Word(value=s) for s in words]\n    word_list_obj = WordList(words=word_objects)\n    all_lengths = word_list_obj.lengths()\n    max_length = max(all_lengths)\n    result_obj = Result(length=max_length)\n    return result_obj.length", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[["python", "PHP", "bigdata"]]], "plus_fail_tests": [[["Longest", "word", "length"]]]}], "Mbpp/91": [{"task_id": "Mbpp/91", "solution": "from typing impor