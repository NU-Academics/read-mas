lements appearing only in one input are included once in the output, preserving their first-occurrence order.\n    \"\"\"\n    if not isinstance(tuple_a, tuple) or not isinstance(tuple_b, tuple):\n        raise TypeError(\"Both inputs must be tuples\")\n\n    result = []\n    seen = set()\n\n    # Add elements from tuple_a that are not in tuple_b\n    for item in tuple_a:\n        if item not in tuple_b and item not in seen:\n            result.append(item)\n            seen.add(item)\n\n    # Add elements from tuple_b that are not in tuple_a\n    for item in tuple_b:\n        if item not in tuple_a and item not in seen:\n            result.append(item)\n            seen.add(item)\n\n    return tuple(result)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/581": [{"task_id": "Mbpp/581", "solution": "def surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the surface area of a square pyramid using the base edge and slant height.\n    The 'height' parameter is interpreted as the slant height for this calculation.\n    \"\"\"\n    # Calculate the surface area using the formula: base_edge^2 + 2 * base_edge * slant_height\n    # The 'height' parameter is interpreted as the slant height.\n    return base_edge**2 + 2 * base_edge * height", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/583": [{"task_id": "Mbpp/583", "solution": "import math\nclass Error(Exception):\n    \"\"\"Domain error object containing clear, testable message; implemented as an Exception subtype to be raised.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\nclass CatalanNumber:\n    \"\"\"Domain wrapper representing Catalan numeric result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass InputValidator:\n    \"\"\"Validates that input n is integer and n >= 0; raises domain.Error on invalid input.\"