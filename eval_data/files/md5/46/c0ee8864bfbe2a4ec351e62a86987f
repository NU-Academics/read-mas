_init__(self, raw: str, start: int, end: int) -> None:\n        self.raw = raw\n        self.start = start\n        self.end = end\n        self.cleaned: str = \"\" # To be populated by the cleaner\n        self.leading_punct_count: int = 0 # To be populated by the cleaner\n        self.trailing_punct_count: int = 0 # To be populated by the cleaner\nclass AdverbMatch:\n    \"\"\"\n    Immutable container for a detected adverb, its indices, and normalized text.\n    \"\"\"\n    def __init__(self, start_index: int, end_index: int, adverb_text: str) -> None:\n        self.start_index = start_index\n        self.end_index = end_index\n        self.adverb_text = adverb_text\ndef _tokenize_single_pass(sentence: str) -> Iterator[Token]:\n    \"\"\"\n    Yields Token objects with raw text and original start/end indices from the sentence.\n    This performs a single-pass, whitespace-based tokenization as per design (BR7, BR9).\n    \"\"\"\n    length = len(sentence)\n    if length == 0:\n        return\n\n    i = 0\n    while i < length:\n        # Skip leading whitespace\n        while i < length and sentence[i].isspace():\n            i += 1\n        if i == length: # Reached end of string after skipping spaces\n            break\n\n        # Found start of a token\n        token_start = i\n        # Find end of token (next whitespace or end of string)\n        while i < length and not sentence[i].isspace():\n            i += 1\n        token_end = i\n        yield Token(sentence[token_start:token_end], token_start, token_end)\ndef _is_adverb_candidate(token: Token) -> Optional[AdverbMatch]:\n    \"\"\"\n    Checks if a cleaned token is an adverb candidate based on its cleaned text.\n    Returns an AdverbMatch if it's a valid adverb, otherwise None (BR1, BR8).\n    \"\"\"\n    if not token.cleaned:\n        return None\n\n    # BR8: Consider only alphabetic characters; tokens containing non-alphabetic\n    # characters (e.g., digits, internal punctuation) are disqualified.\n    if not token.cleaned.isalpha():\n        return None\n\n    # BR1: An adverb candidate's alphabetic characters must end with \"ly\" (case-insensitive).\n    if token.cleaned.lower().endswith(\"ly\"):\n        # BR4: Compute start_index and end_index using original token span and removed punctuation counts.\n        start_index = token.start + token.leading_punct_count\n        end_index = start_index + len(token.cleaned)\n        # BR5: adverb_text returned lowercase and punctuation-free.\n        adverb_text = token.cleaned.lower()\n        return AdverbMatch(start_index, end_index, adverb_text)\n    return None\ndef find_adverb_position(sentence: str) -> Optional[Tuple[int, int, str]]:\n    \"\"\"\n    Finds the first adverb and its position (start_index, end_index) in a given sentence.\n\n    An adverb is defined as a token whose alphabetic characters, after removing\n    leading and trailing punctuation, end with \"ly\" (case-insensitive) (BR1, BR2).\n    \"\"\"\n    if not sentence: # BR6: Returns None for an empty input string.\n        return None\n\n    # Orchestrates Tokenizer -> Cleaner -> Detector in a single pass (BR9).\n    for token in _tokenize_single_pass(sentence):\n        _strip_token_punctuation(token) # Cleaner processes the token by updating its fields.\n\n        adverb_match = _is_adverb_candidate(token) # Detector checks the cleaned token.\n        if adverb_match: # FR7: Returns only the first (leftmost) matching adverb.\n            return (adverb_match.start_index, adverb_match.end_index, adverb_match.adverb_text)\n\n    return None # BR6: Returns None when no token meets the adverb definition.", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["clearly!! we can see the sky"]], "plus_fail_tests": [["heavily and quickly we ran down the steep hill"]]}], "Mbpp/445": [{"task_id": "Mbpp/445", "solution": "def compute_products(a, b) -> tuple:\n    \"\"\"\n    Computes element-wise products and returns an immutable tuple-