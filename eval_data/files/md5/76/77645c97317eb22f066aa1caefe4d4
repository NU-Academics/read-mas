{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_string, rotations):\n    \"\"\"\n    Finds the number of numbers with an odd value when rotating a binary string.\n    The original string is counted as the first rotation.\n    \"\"\"\n\n    class BinaryString:\n        \"\"\"Encapsulates binary string behavior for validation and rotation.\"\"\"\n        def __init__(self, value: str):\n            self.value = value\n\n        def is_valid(self) -> bool:\n            \"\"\"Checks if the string contains only '0' and '1'.\"\"\"\n            return all(ch in {'0', '1'} for ch in self.value)\n\n        def rotateLeft(self, positions: int) -> str:\n            \"\"\"Performs a cyclic left rotation by the given number of positions.\"\"\"\n            if not self.value:\n                return self.value\n            length = len(self.value)\n            normalized_positions = positions % length\n            return self.value[normalized_positions:] + self.value[:normalized_positions]\n\n        def last_bit(self) -> str:\n            \"\"\"Returns the last bit of the string, or an empty string if empty.\"\"\"\n            return self.value[-1] if self.value else ''\n\n    class RotationInstance:\n        \"\"\"Represents one rotation instance and checks for oddness.\"\"\"\n        def __init__(self, index: int, rotated_value: str):\n            self.index = index\n            self.rotated_value = rotated_value\n\n        def is_odd(self) -> bool:\n            \"\"\"Determines if the rotated value represents an odd number.\"\"\"\n            return self.rotated_value and self.rotated_value[-1] == '1'\n\n    class Result:\n        \"\"\"Simple Data Transfer Object for the final odd_count.\"\"\"\n        def __init__(self, odd_count: int):\n            self.odd_count = odd_count\n\n    class OddEquivalentFunction:\n        \"\"\"Coordinates validation and computation for odd_Equivalent.\"\"\"\n        def __init__(self, binary_string: str, rotations: int):\n            self.binary_string = binary_string\n            self.rotations = rotations\n            self.odd_count = 0\n\n        def validate(self):\n            \"\"\"Validates inputs and raises ValueError if invalid.\"\"\"\n            binary_obj = BinaryString(self.binary_string)\n            if not binary_obj.is_valid():\n                raise ValueError(\"binary_string must contain only '0' and '1'\")\n\n            if not isinstance(self.rotations, int) or self.rotations < 0:\n                raise ValueError(\"rotations must be a non-negative integer\")\n\n        def compute(self) -> Result:\n            \"\"\"Performs rotations and counts odd values based on the design.\"\"\"\n            if self.rotations == 0:\n                return Result(0)\n\n            binary_obj = BinaryString(self.binary_string)\n            \n            for i in range(1, self.rotations + 1):\n                rotated_val_for_this_iteration = \"\"\n                if i == 1:\n                    rotated_val_for_this_iteration = binary_obj.value\n                else:\n                    rotated_val_for_this_iteration = binary_obj.rotateLeft(i - 1)\n                \n                rotation_instance = RotationInstance(i, rotated_val_for_this_iteration)\n                if rotation_instance.is_odd():\n                    self.odd_count += 1\n\n            return Result(self.odd_count)\n\n    coordinator = OddEquivalentFunction(binary_string, rotations)\n    coordinator.validate()\n    result = coordinator.compute()\n    return result.odd_count"}
{"task_id": "Mbpp/113", "solution": "import re\n\ndef check_integer(s: str) -> bool:\n    \"\"\"Return True iff s matches an optional leading '+' or '-' followed by one or more digits.\"\"\"\n    pattern = re.compile(r'^[+-]?[0-9]+$')\n    if s == \"\":\n        return False\n    return bool(pattern.match(s))"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists):\n    \"\"\"\n    Finds common elements in a list of nested lists.\n    Returns a set containing elements present in every inner list.\n    \"\"\"\n    # If the input list of lists is empty, there are no common elements.\n    if not nested_lists:\n        return set()\n\n    # Start with the elements of the first list as the initial set of common elements.\n    # Converting to a set efficiently handles duplicates within the first list.\n    common_elements = set(nested_lists[0])\n\n    # If the first list itself was empty, then the common_elements set is empty,\n    # and no further processing is needed as the intersection will always be empty.\n    if not common_elements:\n        return set()\n\n    # Iterate through the rest of the lists to find their intersection with the current common_elements.\n    for inner_list in nested_lists[1:]:\n        # Update common_elements by intersecting it with the current inner_list, converted to a set.\n        common_elements.intersection_update(inner_list)\n\n        # If at any point the common_elements set becomes empty,\n        # further intersections will also result in an empty set, so we can return early.\n        if not common_elements:\n            return set()\n\n    return common_elements"}
{"task_id": "Mbpp/116", "solution": "class ValidationError(Exception):\n    \"\"\"Internal exception type for validation failures within the converter.\"\"\"\n    pass\n\nclass TupleConverter:\n    \"\"\"Encapsulates validation and concatenation logic for tuple to int conversion.\"\"\"\n\n    def validate(self, t) -> None:\n        \"\"\"Raises ValidationError if t is not a tuple of positive integers.\"\"\"\n        if not isinstance(t, tuple):\n            raise ValidationError(\"Input must be a tuple.\")\n        if not t:\n            raise ValidationError(\"Input tuple must not be empty.\")\n        for element in t:\n            if not isinstance(element, int):\n                raise ValidationError(\"All elements of the tuple must be integers.\")\n            if element <= 0:\n                raise ValidationError(\"All elements of the tuple must be positive integers (> 0).\")\n\n    def tuple_to_int(self, t) -> int:\n        \"\"\"Converts a tuple of positive integers into a single integer after validation.\n        Raises ValidationError if input is invalid.\"\"\"\n        self.validate(t)\n        return int(\"\".join(map(str, t)))\n\ndef tuple_to_int(t) -> int:\n    \"\"\"Validates the input tuple of positive integers and converts it to a single integer.\n    Raises ValueError for any invalid input.\"\"\"\n    converter = TupleConverter()\n    try:\n        return converter.tuple_to_int(t)\n    except ValidationError as e:\n        raise ValueError(str(e))"}
{"task_id": "Mbpp/119", "solution": "def search(array: list[int]) -> int:\n    \"\"\"Public API: finds the element that appears only once in a sorted array.\"\"\"\n\n    class SearchFunction:\n        \"\"\"Encapsulates the algorithm and validation for finding the unique element.\"\"\"\n\n        def validate_sorted(self, array: list[int]) -> bool:\n            \"\"\"Checks if the given array is sorted in non-decreasing order.\"\"\"\n            if not array:\n                return True\n            for i in range(len(array) - 1):\n                if array[i] > array[i+1]:\n                    return False\n            return True\n\n        def search(self, array: list[int]) -> int:\n            \"\"\"\n            Finds the element that appears only once in a sorted array\n            where every other element appears exactly twice, using binary search.\n            \"\"\"\n            low = 0\n            high = len(array) - 1\n\n            while low < high:\n                mid = (low + high) // 2\n\n                if mid % 2 == 0:  # mid is at an even index\n                    if array[mid] == array[mid + 1]:\n                        # The pair is (array[mid], array[mid+1]), unique is to the right\n                        low = mid + 2\n                    else:\n                        # array[mid] is not paired with array[mid+1], unique is at or to the left\n                        high = mid\n                else:  # mid is at an odd index\n                    if array[mid] == array[mid - 1]:\n                        # The pair is (array[mid-1], array[mid]), unique is to the right\n                        low = mid + 1\n                    else:\n                        # array[mid] is not paired with array[mid-1], unique is at or to the left\n                        high = mid - 1\n            \n            # When low == high, this is the index of the unique element\n            return array[low]\n\n    search_func_instance = SearchFunction()\n    return search_func_instance.search(array)"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(tuples):\n    \"\"\"Public API. Validate then compute max absolute product.\n    Raises: ValueError, TypeError\n    Returns: int or float per return-type rule\n    Complexity: O(n) time, O(1) extra space\n    \"\"\"\n\n    def _is_number(value) -> bool:\n        \"\"\"Return True if value is int or float as allowed by requirements.\"\"\"\n        return isinstance(value, (int, float))\n\n    def _validate_non_empty(tuples_list):\n        \"\"\"Raise ValueError if tuples is empty.\"\"\"\n        if not tuples_list:\n            raise ValueError(\"Input list cannot be empty.\")\n\n    def _validate_and_inspect_items(tuples_list) -> bool:\n        \"\"\"Validate item shape and numeric types; return True if any float seen; else False. Raise TypeError on invalid items.\"\"\"\n        seen_float = False\n        for item in tuples_list:\n            if not isinstance(item, tuple) or len(item) != 2:\n                raise TypeError(f\"Each item in the list must be a tuple of length 2, but found: {item}\")\n            a, b = item\n            if not _is_number(a) or not _is_number(b):\n                raise TypeError(f\"Tuple elements must be numbers (int or float), but found non-numeric in: {item}\")\n            if isinstance(a, float) or isinstance(b, float):\n                seen_float = True\n        return seen_float\n\n    _validate_non_empty(tuples)\n    seen_float = _validate_and_inspect_items(tuples)\n\n    running_max = None\n    for a, b in tuples:\n        tmp_product = a * b\n        abs_tmp_product = abs(tmp_product)\n        if running_max is None or abs_tmp_product > running_max:\n            running_max = abs_tmp_product\n\n    if seen_float:\n        return float(running_max)\n    else:\n        return int(running_max)"}
