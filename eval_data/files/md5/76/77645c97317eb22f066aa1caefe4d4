{"task_id": "Mbpp/170", "solution": "from typing import List, Union\n\nclass ValidationError(Exception):\n    \"\"\"Domain-level exception representing validation failures.\"\"\"\n    def __init__(self, message: str, code: str = \"ValidationError\") -> None:\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\nclass NumberList:\n    \"\"\"Wrapper for input list; provides length accessor and element access.\"\"\"\n    def __init__(self, elements: List[Union[int, float]]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\nclass IndexRange:\n    \"\"\"Value object for start_index and end_index.\"\"\"\n    def __init__(self, start_index: int, end_index: int) -> None:\n        self.start_index = start_index\n        self.end_index = end_index\n\nclass Result:\n    \"\"\"Container for returned numeric sum.\"\"\"\n    def __init__(self, sum_value: Union[int, float]) -> None:\n        self.sum = sum_value\n\nclass SumRangeFunction:\n    \"\"\"Encapsulate validation and computation of sum for a numeric list subrange.\"\"\"\n    def sum(self, input_list_param: List[Union[int, float]], start_index_param: int, end_index_param: int) -> Union[int, float]:\n        \"\"\"Validate via validate_indices and compute inclusive sum.\"\"\"\n        self.validate_indices(input_list_param, start_index_param, end_index_param)\n\n        total_sum = 0\n        for i in range(start_index_param, end_index_param + 1):\n            total_sum += input_list_param[i]\n        return total_sum\n\n    def validate_indices(self, list_param: List[Union[int, float]], start_index: int, end_index: int) -> None:\n        \"\"\"Enforce BR1, BR2, BR3, BR5; raise ValidationError on violations.\"\"\"\n        number_list = NumberList(list_param)\n        index_range = IndexRange(start_index, end_index)\n\n        # BR1: Require indices be integers.\n        if not isinstance(index_range.start_index, int) or not isinstance(index_range.end_index, int):\n            raise ValidationError(\"Indices must be integers.\")\n\n        list_length = number_list.length()\n\n        # Handle empty list: allow (0, -1) to signify an empty range resulting in sum 0.\n        if list_length == 0:\n            if not (index_range.start_index == 0 and index_range.end_index == -1):\n                raise ValidationError(\"Cannot sum a non-empty range on an empty list or indices are out of bounds.\")\n            return # Validation passes for (0, -1) on an empty list.\n\n        # BR2: Indices within bounds 0..len(list)-1.\n        if not (0 <= index_range.start_index < list_length and 0 <= index_range.end_index < list_length):\n            raise ValidationError(\"Indices are out of bounds.\")\n\n        # BR3: start_index <= end_index.\n        if index_range.start_index > index_range.end_index:\n            raise ValidationError(\"start_index must be less than or equal to end_index.\")\n\n        # BR5: Accept lists of numeric values (ints or floats) and sum them.\n        for i in range(index_range.start_index, index_range.end_index + 1):\n            if not isinstance(number_list.elements[i], (int, float)):\n                raise ValidationError(f\"List contains non-numeric element at index {i}: {number_list.elements[i]}\")\n\ndef sum_range_list(list: List[Union[int, float]], start_index: int, end_index: int) -> Union[int, float]:\n    \"\"\"Public entry point; validate inputs and return inclusive sum or raise ValidationError.\"\"\"\n    calculator = SumRangeFunction()\n    return calculator.sum(list, start_index, end_index)"}
{"task_id": "Mbpp/172", "solution": "def count_occurance(input: str) -> int:\n    \"\"\"Counts 'std' occurrences in the given string input.\"\"\"\n    from typing import Any\n\n    class InputString:\n        \"\"\"Holds string value and its length.\"\"\"\n        def __init__(self, value: str):\n            self.value = value\n            self.length = len(value)\n\n    class CountResult:\n        \"\"\"Stores the integer count.\"\"\"\n        def __init__(self, count: int):\n            self.count = count\n\n    class OccurrenceCounter:\n        \"\"\"Validates input and counts 'std' occurrences.\"\"\"\n        _pattern: str = \"std\"\n\n        def count_occurance(self, input_str: str) -> int:\n            \"\"\"Validates and counts occurrences of the pattern in the input string.\"\"\"\n            self._validate_input(input_str)\n            src = InputString(input_str)\n            count = 0\n            p_len = len(self._pattern)\n            # Scans every possible starting index for the pattern.\n            for i in range(0, max(0, src.length - p_len + 1)):\n                if src.value[i:i+p_len] == self._pattern:\n                    count += 1\n            return CountResult(count).count\n\n        def _validate_input(self, input_val: Any) -> None:\n            \"\"\"Raises TypeError if input is not a string.\"\"\"\n            if not isinstance(input_val, str):\n                raise TypeError(\"count_occurance expects a string input\")\n\n    counter = OccurrenceCounter()\n    return counter.count_occurance(input)"}
{"task_id": "Mbpp/222", "solution": "```python\ndef check_type(tuple_arg: tuple) -> bool:\n    \"\"\"\n    Checks if all elements in the tuple have the same data type.\n    Handles empty tuples by returning True.\n    \"\"\"\n    if not isinstance(tuple_arg, tuple):\n        raise TypeError(\"check_type expects a tuple\")\n\n    if len(tuple_arg) == 0:\n        return True\n\n    first_type = type(tuple_arg[0])\n    for elem in tuple_arg:\n        if type(elem) is not first_type:\n            return False\n    return True\n```"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(number):\n    \"\"\"Return int: number of set bits in 'number'.\n    This counts the '1' digits in the binary representation string.\n    \"\"\"\n    return bin(number).count('1')"}
{"task_id": "Mbpp/223", "solution": "class SortedArray:\n    \"\"\"Wrapper for a sorted list providing read-only accessors.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n\n    def get_length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self.elements)\n\n    def get_element(self, index: int):\n        \"\"\"Returns the element at the specified index.\"\"\"\n        return self.elements[index]\n\nclass InputValidator:\n    \"\"\"Validates input parameters for the majority element check.\"\"\"\n    def validate_params(self, sorted_array: SortedArray, n: int, x) -> bool:\n        \"\"\"Checks if array length n is valid and matches the array's actual length.\"\"\"\n        if not isinstance(sorted_array, SortedArray):\n            return False\n        if not isinstance(n, int):\n            return False\n        if n <= 0:\n            return False\n        if n != sorted_array.get_length():\n            return False\n        return True\n\nclass OccurrenceCounter:\n    \"\"\"Counts occurrences of an element in a sorted array using binary search.\"\"\"\n    def find_first_occurrence(self, sorted_array: SortedArray, x) -> int:\n        \"\"\"Finds the index of the first occurrence of x using binary search.\"\"\"\n        low = 0\n        high = sorted_array.get_length() - 1\n        result = -1\n        while low <= high:\n            mid = low + (high - low) // 2\n            mid_element = sorted_array.get_element(mid)\n            if mid_element == x:\n                result = mid\n                high = mid - 1  # Try to find an earlier occurrence\n            elif mid_element < x:\n                low = mid + 1\n            else: # mid_element > x\n                high = mid - 1\n        return result\n\n    def find_last_occurrence(self, sorted_array: SortedArray, x) -> int:\n        \"\"\"Finds the index of the last occurrence of x using binary search.\"\"\"\n        low = 0\n        high = sorted_array.get_length() - 1\n        result = -1\n        while low <= high:\n            mid = low + (high - low) // 2\n            mid_element = sorted_array.get_element(mid)\n            if mid_element == x:\n                result = mid\n                low = mid + 1  # Try to find a later occurrence\n            elif mid_element < x:\n                low = mid + 1\n            else: # mid_element > x\n                high = mid - 1\n        return result\n\n    def count_occurrences(self, sorted_array: SortedArray, x) -> int:\n        \"\"\"Counts how many times x appears in the sorted array.\"\"\"\n        first = self.find_first_occurrence(sorted_array, x)\n        if first == -1:\n            return 0\n        last = self.find_last_occurrence(sorted_array, x)\n        return last - first + 1\n\ndef is_majority(array, n, x) -> bool:\n    \"\"\"\n    Checks if an element x is the majority element in a given sorted array.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n    sorted_array = SortedArray(array)\n    validator = InputValidator()\n    if not validator.validate_params(sorted_array, n, x):\n        return False\n\n    counter = OccurrenceCounter()\n    count = counter.count_occurrences(sorted_array, x)\n\n    return count > (n / 2)"}
