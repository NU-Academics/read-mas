{"task_id": "Mbpp/84", "solution": "class SequenceResult:\n    \"\"\"Data holder for computed Newman-Conway sequence term.\"\"\"\n    def __init__(self, n: int, value: int):\n        self.n = n\n        self.value = value\n\nclass InputValidator:\n    \"\"\"Validates input n, returning true for valid inputs.\"\"\"\n    def isValid(self, n: int) -> bool:\n        \"\"\"\n        Always returns True to adhere to constraints on not checking types or raising errors.\n        \"\"\"\n        return True\n\nclass NewmanConwayGenerator:\n    \"\"\"Computes Newman-Conway sequence values and caches them.\"\"\"\n    def __init__(self):\n        # cache[0] holds a(1), cache[1] holds a(2), etc.\n        # Base cases: a(1)=1, a(2)=1\n        self.cache = [1, 1]\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Computes the nth Newman-Conway sequence term, using a cache for efficiency.\n        \"\"\"\n        if n <= 0: # This case would typically be handled by InputValidator and raise an error.\n                   # Given constraints, we assume n is valid and >= 1.\n                   # If n=0, IndexError will occur, which aligns with 'no raise exceptions for edge cases'.\n            pass # The negative constraint means we don't explicitly handle this with a raise or isinstance.\n\n        # If the term is already in the cache, return it\n        if n <= len(self.cache):\n            return self.cache[n - 1]\n\n        # Compute iteratively from the current cache length up to n\n        for i in range(len(self.cache), n):\n            # For 1-based index k (current term to compute), k = i + 1\n            # Recurrence: a(k) = a(a(k-1)) + a(k - a(k-1))\n            # a(k-1) is self.cache[k-1 - 1] = self.cache[i-1]\n            val_a_k_minus_1 = self.cache[i - 1]\n\n            # First part: a(a(k-1))\n            first_term_index = val_a_k_minus_1 - 1\n            first_term = self.cache[first_term_index]\n\n            # Second part: a(k - a(k-1))\n            second_term_index = (i + 1) - val_a_k_minus_1 - 1\n            second_term = self.cache[second_term_index]\n\n            next_val = first_term + second_term\n            self.cache.append(next_val)\n\n        return self.cache[n - 1]\n\nclass SequenceService:\n    \"\"\"Orchestrates Newman-Conway sequence term generation.\"\"\"\n    _generator: NewmanConwayGenerator\n\n    def __init__(self):\n        self._validator = InputValidator()\n        self._generator = NewmanConwayGenerator()\n\n    def sequence(self, n: int) -> int:\n        \"\"\"\n        Returns the nth Newman-Conway sequence term.\n        Input validation is performed, but errors are not explicitly raised due to constraints.\n        \"\"\"\n        # Call validator as per design, but do not use its result to raise errors due to constraints.\n        _ = self._validator.isValid(n)\n        return self._generator.compute(n)\n\n# Create a singleton SequenceService instance as specified in the design\n_default_service = SequenceService()\n\ndef sequence(n: int) -> int:\n    \"\"\"\n    Finds the nth number in the newman conway sequence.\n    \"\"\"\n    return _default_service.sequence(n)"}
{"task_id": "Mbpp/86", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for validation errors in centered hexagonal number calculations.\"\"\"\n    def __init__(self, message: str, code: str = \"\") -> None:\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\ndef centered_hexagonal_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth centered hexagonal number.\n    Raises ValidationError if n is not an integer or is less than 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValidationError(\"Input 'n' must be an integer.\", code=\"INVALID_TYPE\")\n    if n < 1:\n        raise ValidationError(\"Input 'n' must be a positive integer (n >= 1).\", code=\"INVALID_VALUE\")\n\n    return 3 * n * (n - 1) + 1"}
