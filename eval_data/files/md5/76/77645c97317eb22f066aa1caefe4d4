{"task_id": "Mbpp/440", "solution": "import re\nimport string\n\nclass Sentence:\n    \"\"\"Represents an input sentence.\"\"\"\n    def __init__(self, text: str):\n        self.text: str = text\n\nclass Token:\n    \"\"\"Represents a token with its raw text and original string indices.\"\"\"\n    def __init__(self, rawText: str, startIndex: int, endIndex: int):\n        self.rawText: str = rawText\n        self.cleanText: str = '' # Intended to be populated externally after trimming\n        self.startIndex: int = startIndex\n        self.endIndex: int = endIndex\n\nclass AdverbResult:\n    \"\"\"Represents the detected adverb with its start index, end index, and cleaned text.\"\"\"\n    def __init__(self, startIndex: int, endIndex: int, adverb: str):\n        self.startIndex: int = startIndex\n        self.endIndex: int = endIndex\n        self.adverb: str = adverb\n\nclass PunctuationHelper:\n    \"\"\"Helper to trim leading and trailing punctuation from a string.\"\"\"\n    @staticmethod\n    def trimPunctuation(tokenText: str) -> str:\n        \"\"\"Removes leading and trailing non-alphabetic ASCII characters.\"\"\"\n        start = 0\n        end = len(tokenText) - 1\n\n        while start <= end and tokenText[start] not in string.ascii_letters:\n            start += 1\n        while end >= start and tokenText[end] not in string.ascii_letters:\n            end -= 1\n\n        if start > end:\n            return \"\"\n        return tokenText[start : end + 1]\n\nclass AdverbFinder:\n    \"\"\"Finds the first adverb in a sentence, orchestrating tokenization and detection.\"\"\"\n\n    def find_adverb_position(self, sentence: Sentence) -> AdverbResult | None:\n        \"\"\"Finds the first adverb and its positions in the given sentence.\"\"\"\n        tokens = self.tokenizeKeepingIndices(sentence.text)\n\n        for token in tokens:\n            clean_text_for_detection = PunctuationHelper.trimPunctuation(token.rawText)\n\n            if self.isAdverb(clean_text_for_detection):\n                # Calculate the indices of the cleaned adverb within the original sentence.\n                if clean_text_for_detection:\n                    relative_start = token.rawText.find(clean_text_for_detection)\n                    if relative_start != -1:\n                        adverb_start_index = token.startIndex + relative_start\n                        adverb_end_index = adverb_start_index + len(clean_text_for_detection)\n                        return AdverbResult(adverb_start_index, adverb_end_index, clean_text_for_detection.lower())\n        return None\n\n    def tokenizeKeepingIndices(self, text: str) -> list[Token]:\n        \"\"\"Tokenizes the text into a list of Token objects, preserving original indices.\"\"\"\n        tokens = []\n        for match in re.finditer(r'\\S+', text):\n            raw_text = match.group(0)\n            start_index = match.start()\n            end_index = match.end()\n            tokens.append(Token(raw_text, start_index, end_index))\n        return tokens\n\n    def isAdverb(self, cleanText: str) -> bool:\n        \"\"\"Checks if the given cleaned text qualifies as an adverb.\"\"\"\n        # Adverb must be non-empty, all alphabetic, and end with \"ly\" (case-insensitive).\n        if not cleanText:\n            return False\n        if not cleanText.isalpha():\n            return False\n        return cleanText.lower().endswith(\"ly\")\n\ndef find_adverb_position(sentence_str: str) -> tuple[int, int, str] | None:\n    \"\"\"Finds the first adverb and its positions in a given sentence string.\"\"\"\n    sentence_obj = Sentence(sentence_str)\n    adverb_finder = AdverbFinder()\n    adverb_result = adverb_finder.find_adverb_position(sentence_obj)\n\n    if adverb_result:\n        return (adverb_result.startIndex, adverb_result.endIndex, adverb_result.adverb)\n    else:\n        return None"}
{"task_id": "Mbpp/445", "solution": "def index_multiplication(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Performs index-wise multiplication of tuple elements from two given tuples of tuples.\n    Validates input types, lengths, and element numerics before computation.\n    \"\"\"\n\n    def _validate_outer_tuple_type(value: object, name: str) -> None:\n        \"\"\"Ensures the provided value is a tuple.\"\"\"\n        if not isinstance(value, tuple):\n            raise TypeError(f\"Expected tuple for {name}, got {type(value).__name__}\")\n\n    def _validate_outer_lengths(a: tuple, b: tuple) -> None:\n        \"\"\"Ensures the two outer tuples have equal lengths.\"\"\"\n        if len(a) != len(b):\n            raise ValueError(f\"Outer tuple length mismatch: len(a)={len(a)}, len(b)={len(b)}\")\n\n    def _validate_inner_lengths(a: tuple, b: tuple) -> None:\n        \"\"\"Ensures corresponding inner tuples have equal lengths.\"\"\"\n        for i in range(len(a)):\n            if not isinstance(a[i], tuple):\n                raise TypeError(f\"Expected tuple for a[{i}], got {type(a[i]).__name__}\")\n            if not isinstance(b[i], tuple):\n                raise TypeError(f\"Expected tuple for b[{i}], got {type(b[i]).__name__}\")\n            if len(a[i]) != len(b[i]):\n                raise ValueError(f\"Inner tuple length mismatch at index {i}: len(a[{i}])={len(a[i])}, len(b[{i}])={len(b[i])}\")\n\n    def _validate_element_numeric(value: object, path: str) -> None:\n        \"\"\"Ensures the value is an int or float.\"\"\"\n        if not isinstance(value, (int, float)):\n            raise TypeError(f\"Non-numeric element at {path}: {value!r} (type {type(value).__name__})\")\n\n    def _multiply_inner_pairs(a_inner: tuple, b_inner: tuple) -> tuple:\n        \"\"\"Multiplies corresponding elements of two inner tuples.\"\"\"\n        return tuple(a_inner[j] * b_inner[j] for j in range(len(a_inner)))\n\n    _validate_outer_tuple_type(a, 'a')\n    _validate_outer_tuple_type(b, 'b')\n    _validate_outer_lengths(a, b)\n    _validate_inner_lengths(a, b) # This also implicitly checks if inner elements are tuples\n\n    result_list = []\n    for i in range(len(a)):\n        a_inner = a[i]\n        b_inner = b[i]\n\n        for j in range(len(a_inner)):\n            _validate_element_numeric(a_inner[j], f\"a[{i}][{j}]\")\n            _validate_element_numeric(b_inner[j], f\"b[{i}][{j}]\")\n        \n        product_inner = _multiply_inner_pairs(a_inner, b_inner)\n        result_list.append(product_inner)\n\n    return tuple(result_list)"}
