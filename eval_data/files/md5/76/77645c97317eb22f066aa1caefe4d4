{"task_id": "Mbpp/255", "solution": "import itertools\n\ndef combinations_colors(elements: list, n: int) -> list[tuple]:\n    \"\"\"Generate all ordered length-n tuples (with repetition) from elements and return as list of tuples.\"\"\"\n    if n == 1:\n        # For n=1, ensure the output order matches the input elements' order.\n        return [(e,) for e in elements]\n    else:\n        # Use itertools.product for cartesian product with repetition.\n        return list(itertools.product(elements, repeat=n))"}
{"task_id": "Mbpp/256", "solution": "import math\n\nclass NumberInput:\n    def __init__(self, value):\n        self.value = value\n\n    def is_non_negative(self):\n        return self.value >= 0\n\nclass PrimeChecker:\n    def is_prime(self, num: int) -> bool:\n        \"\"\"Checks if a given integer is a prime number.\n        Uses trial division up to the square root of the number.\"\"\"\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        # Check odd divisors from 3 up to the integer square root.\n        for divisor in range(3, int(math.isqrt(num)) + 1, 2):\n            if num % divisor == 0:\n                return False\n        return True\n\nclass PrimeCounter:\n    def count_Primes_nums(self, n) -> int:\n        \"\"\"Counts prime numbers strictly less than n.\n        Returns 0 if n is less than or equal to 2, otherwise iterates and checks primality.\"\"\"\n        if n <= 2:\n            return 0\n\n        prime_count = 0\n        # Iterate up to floor(n) - 1 to count primes p where p < n.\n        upper_bound_exclusive = int(math.floor(n))\n        checker = PrimeChecker()\n\n        for p in range(2, upper_bound_exclusive):\n            if checker.is_prime(p):\n                prime_count += 1\n        return prime_count\n\ndef count_Primes_nums(n):\n    \"\"\"\n    Counts the number of prime numbers less than the given non-negative number.\n    Handles type and value validation before delegating to a PrimeCounter.\n    \"\"\"\n    if not isinstance(n, (int, float)):\n        raise TypeError(\"n must be a number\")\n\n    number_input = NumberInput(n)\n    if not number_input.is_non_negative():\n        raise ValueError(\"n must be a non-negative number\")\n\n    # Handle the base case where no primes exist below or at n=2.\n    if n <= 2:\n        return 0\n\n    counter = PrimeCounter()\n    return counter.count_Primes_nums(n)"}
{"task_id": "Mbpp/264", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass AgeInput:\n    \"\"\"DTO for human years input.\"\"\"\n    humanYears: int\n\n@dataclass\nclass AgeOutput:\n    \"\"\"DTO for dog years output.\"\"\"\n    dogYears: int\n\nclass DogAgeCalculator:\n    \"\"\"Encapsulates the logic for converting human years to dog years.\"\"\"\n    def calculate(self, humanYears: int) -> int:\n        \"\"\"Calculates dog years based on human years, satisfying dog_age(12) == 61.\"\"\"\n        if humanYears <= 0:\n            return 0\n        elif humanYears <= 2:\n            return int(humanYears * 10.5)\n        else:\n            return int(2 * 10.5 + (humanYears - 2) * 4)\n\ndef dog_age(age: int) -> int:\n    \"\"\"Top-level API. Accepts integer 'age' (human years) and returns integer dog years.\"\"\"\n    calc = DogAgeCalculator()\n    return calc.calculate(age)"}
{"task_id": "Mbpp/259", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for input validation failures.\"\"\"\n    pass\n\ndef _is_two_element_numeric_tuple(item) -> bool:\n    \"\"\"Checks if an item is a 2-element tuple with numeric components.\"\"\"\n    return (\n        isinstance(item, tuple) and\n        len(item) == 2 and\n        isinstance(item[0], (int, float)) and\n        isinstance(item[1], (int, float))\n    )\n\ndef _validate_inputs(input1: tuple, input2: tuple) -> None:\n    \"\"\"Validates the structure and types of the input tuples.\"\"\"\n    if not isinstance(input1, tuple) or not isinstance(input2, tuple):\n        raise ValidationError(\"Inputs must be tuples.\")\n\n    if len(input1) != len(input2):\n        raise ValidationError('input tuples must have same length')\n    \n    for i in range(len(input1)):\n        if not _is_two_element_numeric_tuple(input1[i]) or not _is_two_element_numeric_tuple(input2[i]):\n            raise ValidationError('each element must be 2-element numeric tuple')\n\ndef maximize_elements(input1: tuple, input2: tuple) -> tuple:\n    \"\"\"\n    Combines two tuples of 2-element numeric tuples by taking the maximum\n    of corresponding elements at each position.\n    \"\"\"\n    _validate_inputs(input1, input2)\n\n    result_list = []\n    for i in range(len(input1)):\n        first_max = max(input1[i][0], input2[i][0])\n        second_max = max(input1[i][1], input2[i][1])\n        result_list.append((first_max, second_max))\n    \n    return tuple(result_list)"}
{"task_id": "Mbpp/261", "solution": "from typing import List\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for validation errors in tuple division.\"\"\"\n    def __init__(self, code: str, message: str):\n        self.code = code\n        self.message = message\n        super().__init__(f\"[{self.code}] {self.message}\")\n\nclass TupleInput:\n    \"\"\"Represents an input tuple for internal service use.\"\"\"\n    def __init__(self, values: tuple):\n        self.values = values\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the tuple.\"\"\"\n        return len(self.values)\n\n    def is_tuple(self) -> bool:\n        \"\"\"Checks if the wrapped value is a tuple.\"\"\"\n        return isinstance(self.values, tuple)\n\nclass ResultTuple:\n    \"\"\"Holds computed results and provides conversion to an immutable tuple.\"\"\"\n    def __init__(self, values: List[float]):\n        self.values = values\n\n    def to_tuple(self) -> tuple:\n        \"\"\"Converts the list of results to an immutable tuple.\"\"\"\n        return tuple(self.values)\n\nclass Validator:\n    \"\"\"Performs various validation checks on input tuples.\"\"\"\n    def check_types(self, input1, input2) -> None:\n        \"\"\"Ensures both inputs are tuples.\"\"\"\n        if not isinstance(input1, tuple) or not isinstance(input2, tuple):\n            raise ValidationError(\n                code='TYPE_MISMATCH',\n                message='Both inputs must be tuples.'\n            )\n\n    def check_length(self, input1: tuple, input2: tuple) -> None:\n        \"\"\"Ensures both input tuples have the same length.\"\"\"\n        if len(input1) != len(input2):\n            raise ValidationError(\n                code='LENGTH_MISMATCH',\n                message='Input tuples must have the same length.'\n            )\n\n    def check_no_zero_denominator(self, denominator: tuple) -> None:\n        \"\"\"Ensures the denominator tuple contains no zero values.\"\"\"\n        if 0 in denominator:\n            raise ValidationError(\n                code='ZERO_DENOMINATOR',\n                message='Denominator tuple cannot contain zero.'\n            )\n\nclass DivisionService:\n    \"\"\"Orchestrates validation and performs element-wise division.\"\"\"\n    def __init__(self):\n        self._validator = Validator()\n\n    def division_elements(self, numerator: tuple, denominator: tuple) -> tuple:\n        \"\"\"\n        Validates inputs and computes element-wise division.\n        \"\"\"\n        self._validator.check_types(numerator, denominator)\n        self._validator.check_length(numerator, denominator)\n        self._validator.check_no_zero_denominator(denominator)\n\n        results = []\n        for n, d in zip(numerator, denominator):\n            # Perform float division, then cast to int to match canonical example's expected output type.\n            results.append(int(n / d))\n\n        result_obj = ResultTuple(results)\n        return result_obj.to_tuple()\n\n\ndef division_elements(numerator: tuple, denominator: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise division operation across two given tuples.\n\n    Raises ValidationError for invalid input types, lengths, or zero denominators.\n    \"\"\"\n    service = DivisionService()\n    return service.division_elements(numerator, denominator)"}
{"task_id": "Mbpp/262", "solution": "from typing import List, Tuple\n\nclass ValidationError(ValueError):\n    \"\"\"\n    Domain-specific exception for invalid inputs.\n    Subclasses ValueError as specified in the design.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass InputList:\n    \"\"\"\n    Lightweight wrapper around a language-level list to express domain operations.\n    Provides methods for length and slicing as per design.\n    \"\"\"\n    def __init__(self, elements: List) -> None:\n        self._elements = elements\n\n    def length(self) -> int:\n        return len(self._elements)\n\n    def get_slice(self, start: int, end: int) -> List:\n        return self._elements[start:end]\n\nclass SplitResult:\n    \"\"\"\n    Encapsulates two resulting lists and provides conversion to the tuple returned by API.\n    Used to structure the output as per design.\n    \"\"\"\n    def __init__(self, first_part: List, second_part: List) -> None:\n        self._first_part = first_part\n        self._second_part = second_part\n\n    def as_tuple(self) -> Tuple[List, List]:\n        return (self._first_part, self._second_part)\n\ndef split_two_parts(input_list: List, L: int) -> Tuple[List, List]:\n    \"\"\"\n    Splits a list into two parts where the first part has length L, returning them as a tuple.\n    Utilizes helper classes InputList and SplitResult as per design.\n    \"\"\"\n    # Instantiate InputList to wrap the input and access its properties.\n    input_wrapper = InputList(input_list)\n    list_length = input_wrapper.length()\n\n    # Use InputList's get_slice method to create the two parts.\n    # Python's list slicing naturally handles L=0 and L=len(input_list) boundary conditions.\n    first_part = input_wrapper.get_slice(0, L)\n    second_part = input_wrapper.get_slice(L, list_length)\n\n    # Encapsulate the resulting parts in a SplitResult object and return as a tuple.\n    result = SplitResult(first_part, second_part)\n    return result.as_tuple()"}
{"task_id": "Mbpp/260", "solution": "class InputValidator:\n    \"\"\"Validates input parameter n.\"\"\"\n    def validate_n(self, n) -> None:\n        \"\"\"Validates that n is a non-negative integer.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\nclass NewmanShanksWilliamsSequence:\n    \"\"\"Computes Newman-Shanks-Williams sequence values using memoization.\"\"\"\n    def __init__(self):\n        self._memo = {0: 1, 1: 1}\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes S(n) using memoization and iterative calculation.\"\"\"\n        if n in self._memo:\n            return self._memo[n]\n\n        # Calculate values iteratively up to n and store in memo.\n        # Ensure memo has values up to n, starting from last known or 2.\n        for i in range(max(self._memo.keys()) + 1, n + 1):\n            self._memo[i] = 2 * self._memo[i-1] + self._memo[i-2]\n        \n        return self._memo[n]\n\n    def compute_iterative(self, n: int) -> int:\n        \"\"\"Alternative iterative implementation for S(n).\"\"\"\n        if n == 0:\n            return 1\n        if n == 1:\n            return 1\n\n        a, b = 1, 1 # S(0), S(1)\n        for _ in range(2, n + 1):\n            next_val = 2 * b + a\n            a = b\n            b = next_val\n        return b\n\nclass PrimeChecker:\n    \"\"\"Provides primality checking utilities for future use.\"\"\"\n    def is_prime(self, x: int) -> bool:\n        \"\"\"Determines if a number is prime using a deterministic test.\"\"\"\n        if x <= 1:\n            return False\n        if x <= 3:\n            return True\n        if x % 2 == 0 or x % 3 == 0:\n            return False\n        i = 5\n        while i * i <= x:\n            if x % i == 0 or x % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def is_probable_prime(self, x: int) -> bool:\n        \"\"\"Checks if a number is a probable prime (delegates to deterministic check).\"\"\"\n        return self.is_prime(x)\n\nclass NewmanPrimeService:\n    \"\"\"Orchestrates validation and Newman-Shanks-Williams sequence computation.\"\"\"\n    def __init__(self, sequence=None, validator=None, checker=None):\n        self._sequence = sequence or NewmanShanksWilliamsSequence()\n        self._validator = validator or InputValidator()\n        self._checker = checker or PrimeChecker() # Included per design, not used for S(n) directly.\n\n    def newman_prime(self, n: int) -> int:\n        \"\"\"Validates input and computes the nth Newman-Shanks-Williams number.\"\"\"\n        self._validator.validate_n(n)\n        return self._sequence.compute(n)\n\ndef newman_prime(n: int) -> int:\n    \"\"\"Finds the nth Newman-Shanks-Williams number (S(n)).\"\"\"\n    service = NewmanPrimeService()\n    return service.newman_prime(n)"}
{"task_id": "Mbpp/266", "solution": "def lateralsurface_cube(side):\n    \"\"\"\n    Calculates the lateral surface area of a cube given its side length.\n    Raises TypeError if side is not a numeric type.\n    \"\"\"\n    def _validate_numeric(s_val):\n        \"\"\"Internal helper to validate that the input 's_val' is a numeric type (int or float).\"\"\"\n        if not isinstance(s_val, (int, float)):\n            raise TypeError(\"Side length must be a numeric value.\")\n\n    def _compute_lateral_surface(s_len):\n        \"\"\"Internal helper to compute the lateral surface area (4 * s_len * s_len).\"\"\"\n        return 4 * s_len * s_len\n\n    _validate_numeric(side)\n    return _compute_lateral_surface(side)"}
{"task_id": "Mbpp/265", "solution": "class InvalidNException(Exception):\n    \"\"\"Exception raised when n is not an integer or is less than 1.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass Element:\n    \"\"\"Minimal wrapper representing an input element per the domain model.\"\"\"\n    def __init__(self, value: any):\n        self._value = value\n\n    def value(self) -> any:\n        return self._value\n\nclass Sublist:\n    \"\"\"Accumulates elements destined for a particular modulo bucket.\"\"\"\n    def __init__(self):\n        self._elements = []\n\n    def append(self, e: any):\n        self._elements.append(e)\n\n    def as_list(self) -> list:\n        return list(self._elements)\n\nclass InputList:\n    \"\"\"Thin wrapper around provided input list to make explicit non-mutation.\"\"\"\n    def __init__(self, elements: list):\n        self._elements = list(elements) # Shallow copy of the input list.\n\n    def length(self) -> int:\n        return len(self._elements)\n\n    def get(self, i: int) -> any:\n        return self._elements[i]\n\n    def as_list(self) -> list:\n        return list(self._elements)\n\nclass ListSplitter:\n    \"\"\"Encapsulates validation and distribution logic for list splitting.\"\"\"\n    def validate_n(self, n: int):\n        \"\"\"Ensures n is an integer greater than or equal to 1, raising InvalidNException if not.\"\"\"\n        if not isinstance(n, int) or n < 1:\n            raise InvalidNException(\"n must be an integer >= 1\")\n\n    def distribute(self, input_list: InputList, n: int) -> list:\n        \"\"\"Distributes elements from InputList into n sublists based on index modulo n.\"\"\"\n        sublists = [Sublist() for _ in range(n)]\n        \n        for i in range(input_list.length()):\n            element = input_list.get(i)\n            target_sublist_idx = i % n\n            sublists[target_sublist_idx].append(element)\n            \n        return [sublist.as_list() for sublist in sublists]\n\ndef list_split(lst: list, n: int) -> list:\n    \"\"\"\n    Splits a list into n sublists, placing each element at original index i into sublist (i mod n).\n    Raises InvalidNException if n is not an integer greater than 0.\n    \"\"\"\n    splitter = ListSplitter()\n    splitter.validate_n(n)\n    \n    input_list = InputList(lst)\n    \n    return splitter.distribute(input_list, n)"}
{"task_id": "Mbpp/269", "solution": "def ascii_value(character: str) -> int:\n    \"\"\"Return ASCII integer code for a single-character string.\n    Raises ValueError if character is not a string of length 1.\n    \"\"\"\n    if len(character) != 1:\n        raise ValueError(\"Input must be a single character string.\")\n    return ord(character)"}
{"task_id": "Mbpp/267", "solution": "class OddNumberSequence:\n    def generate(self, n: int) -> list[int]:\n        \"\"\"Return list of first n odd natural numbers (1, 3, 5, ...).\"\"\"\n        odd_numbers = []\n        current_odd = 1\n        for _ in range(n):\n            odd_numbers.append(current_odd)\n            current_odd += 2\n        return odd_numbers\n\nclass Result:\n    def __init__(self, value: int) -> None:\n        \"\"\"Lightweight container holding the integer result.\"\"\"\n        self.value: int = value\n\ndef square_Sum(n: int) -> int:\n    \"\"\"Compute and return sum of squares of first n odd natural numbers.\"\"\"\n    odd_seq_gen = OddNumberSequence()\n    odd_numbers = odd_seq_gen.generate(n)\n\n    sum_of_squares = 0\n    for num in odd_numbers:\n        sum_of_squares += num * num\n\n    result_obj = Result(sum_of_squares)\n    return result_obj.value"}
{"task_id": "Mbpp/268", "solution": "def find_star_num(n: int) -> int:\n    \"\"\"\n    Finds the n'th star number using the formula 6 * n * (n - 1) + 1.\n    Validates input n to be an integer >= 1.\n    \"\"\"\n\n    class StarNumberCalculator:\n        \"\"\"\n        Calculates and validates star numbers according to design.\n        \"\"\"\n        def compute_using_formula(self, n_val: int) -> int:\n            \"\"\"\n            Computes the star number value using the mathematical formula.\n            \"\"\"\n            return 6 * n_val * (n_val - 1) + 1\n\n        def find_star_num(self, n_val: int) -> int:\n            \"\"\"\n            Validates the input n and computes the n'th star number.\n            Raises ValueError for invalid inputs.\n            \"\"\"\n            if not isinstance(n_val, int) or n_val < 1:\n                raise ValueError(\"invalid input: n must be integer >= 1\")\n            return self.compute_using_formula(n_val)\n\n    calculator = StarNumberCalculator()\n    return calculator.find_star_num(n)"}
{"task_id": "Mbpp/272", "solution": "def validate_input(tuples_list) -> bool:\n    \"\"\"Checks if the input is a list of tuples for rear_extract.\"\"\"\n    if not isinstance(tuples_list, list):\n        return False\n    for item in tuples_list:\n        if not isinstance(item, tuple):\n            return False\n    return True\n\ndef rear_extract(tuples_list) -> list:\n    \"\"\"Extracts the rear element from each tuple in a list.\"\"\"\n    if not validate_input(tuples_list):\n        raise TypeError(\"Input must be a list of tuples.\")\n\n    extracted_elements = []\n    for tpl in tuples_list:\n        extracted_elements.append(tpl[-1])\n    return extracted_elements"}
{"task_id": "Mbpp/271", "solution": "def even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the first n even natural numbers raised to the fifth power.\n    This function computes sum_{k=1..n} (2k)^5.\n    \"\"\"\n    total = 0\n    for k in range(1, n + 1):\n        term = (2 * k) ** 5\n        total += term\n    return total"}
{"task_id": "Mbpp/270", "solution": "class InputValidator:\n    def validate(self, lst) -> None:\n        \"\"\"Raises TypeError if the input is not a Python list.\"\"\"\n        if not isinstance(lst, list):\n            raise TypeError(\"Input must be a Python list.\")\n\nclass Element:\n    def __init__(self, index: int, value) -> None:\n        \"\"\"Initializes an Element with its index and value.\"\"\"\n        self.index = index\n        self.value = value\n\n    def is_even_index(self) -> bool:\n        \"\"\"Checks if the element's index is even.\"\"\"\n        return self.index % 2 == 0\n\n    def is_even_number(self) -> bool:\n        \"\"\"Checks if the element's value is an even integer.\"\"\"\n        return isinstance(self.value, int) and self.value % 2 == 0\n\ndef sum_even_and_even_index(lst) -> int:\n    \"\"\"\n    Finds the sum of even numbers located at even positions (0-indexed) in a list.\n    assert sum_even_and_even_index([5, 6, 12, 1, 18, 8]) == 30\n    \"\"\"\n    InputValidator().validate(lst)\n\n    running_sum = 0\n    for index, value in enumerate(lst):\n        element = Element(index, value)\n        if element.is_even_index() and element.is_even_number():\n            running_sum += value\n    return running_sum"}
{"task_id": "Mbpp/273", "solution": "class ErrorCondition(Exception):\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\ndef validate_inputs(first_tuple, second_tuple) -> None:\n    \"\"\"Validate that both inputs are tuples and have equal length; raise ErrorCondition on violation.\"\"\"\n    if not isinstance(first_tuple, tuple) or not isinstance(second_tuple, tuple):\n        raise ErrorCondition(\"Inputs must be tuples.\")\n    if len(first_tuple) != len(second_tuple):\n        raise ErrorCondition(\"Tuples must have the same length.\")\n\ndef _compute_elementwise(first_tuple, second_tuple) -> tuple:\n    \"\"\"Compute element-wise subtraction and return a tuple of results.\"\"\"\n    return tuple(first_tuple[i] - second_tuple[i] for i in range(len(first_tuple)))\n\ndef substract_elements(first_tuple, second_tuple) -> tuple:\n    \"\"\"Public API (name must be exactly 'substract_elements'). Validates inputs and returns element-wise subtraction result.\"\"\"\n    validate_inputs(first_tuple, second_tuple)\n    return _compute_elementwise(first_tuple, second_tuple)"}
{"task_id": "Mbpp/276", "solution": "PI: float = 3.141592653589793\n\ndef volume_cylinder(radius: float, height: float) -> float:\n    \"\"\"Compute cylinder volume using PI * radius^2 * height.\"\"\"\n    return PI * (radius ** 2) * height"}
{"task_id": "Mbpp/277", "solution": "def dict_filter(input_dict: dict, n: int) -> dict:\n    \"\"\"\n    Filters a dictionary to include only entries with values greater than or equal to n.\n    Raises TypeError if input_dict is not a dict or n is not an int.\n    \"\"\"\n    if not isinstance(input_dict, dict):\n        raise TypeError(\"input_dict must be a dictionary\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n\n    filtered_dict = {}\n    for key, value in input_dict.items():\n        if value >= n:\n            filtered_dict[key] = value\n    return filtered_dict"}
{"task_id": "Mbpp/278", "solution": "def count_first_elements(input_tuple):\n    \"\"\"Return number of elements that occur before the first element whose runtime type is tuple.\n\n    Raises:\n        TypeError: if input_tuple is not of type tuple.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"input_tuple must be of type tuple\")\n    for i, element in enumerate(input_tuple):\n        if isinstance(element, tuple):\n            return i\n    # Return 0 if no nested tuple is found, as per design.\n    return 0"}
{"task_id": "Mbpp/274", "solution": "def even_binomial_Coeff_Sum(n):\n    \"\"\"\n    Calculates the sum of even-indexed binomial coefficients for a positive integer n.\n    This function sums C(n, k) for k = 0, 2, 4, ... up to n.\n    \"\"\"\n    import math\n\n    # Helper function to compute the binomial coefficient C(n, k).\n    # The design specifies using math.comb for exact integer calculation.\n    def _binomial_coefficient(n_val, k_val):\n        return math.comb(n_val, k_val)\n\n    # Helper function to sum binomial coefficients for even indices.\n    # The design specifies accumulating C(n, k) for k in range(0, n+1, 2).\n    def _sum_even_binomials(n_val):\n        total = 0\n        for k_val in range(0, n_val + 1, 2):\n            total += _binomial_coefficient(n_val, k_val)\n        return total\n\n    # Input validation logic (_validate_n) is omitted as per the constraint:\n    # \"Do NOT add isinstance() checks or raise exceptions for edge cases\".\n    # The function assumes 'n' is a positive integer as per the problem's premise.\n\n    return _sum_even_binomials(n)"}
{"task_id": "Mbpp/280", "solution": "def sequential_search(array, element):\n    \"\"\"Searches for an element in an array sequentially.\n    Returns (True, index) if found, otherwise (False, -1).\"\"\"\n    for i in range(len(array)):\n        if array[i] == element:\n            return (True, i)\n    return (False, -1)"}
{"task_id": "Mbpp/281", "solution": "def all_unique(input_list) -> bool:\n    \"\"\"Return True if every element in input_list is unique, otherwise False.\n    This relies on the fact that sets only store unique elements.\n    \"\"\"\n    return len(input_list) == len(set(input_list))"}
{"task_id": "Mbpp/282", "solution": "def sub_list(a: list, b: list) -> list:\n    \"\"\"Subtracts two lists element-wise, returning a new list.\"\"\"\n    result = []\n    min_length = min(len(a), len(b))\n    for i in range(min_length):\n        result.append(a[i] - b[i])\n    return result"}
{"task_id": "Mbpp/284", "solution": "def check_element(list, element) -> bool:\n    \"\"\"Return True iff every item in list is equal to element using ==.\"\"\"\n    return all(item == element for item in list)"}
{"task_id": "Mbpp/283", "solution": "def validate(n):\n    \"\"\"\n    Checks if the frequency of each digit in the integer n is less than or equal to the digit itself.\n    A leading minus sign for negative numbers is ignored when counting digits.\n    \"\"\"\n    s = str(n)\n    if s.startswith('-'):\n        s = s[1:]\n\n    counts = {}\n    for char_digit in s:\n        digit = int(char_digit)\n        counts[digit] = counts.get(digit, 0) + 1\n\n    for digit, count in counts.items():\n        if count > digit:\n            return False\n\n    return True"}
{"task_id": "Mbpp/279", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass InputParameter:\n    \"\"\"Handles and validates the input parameter n.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def validate(self) -> None:\n        \"\"\"Validates that n is an integer and n >= 1.\"\"\"\n        if not isinstance(self.n, int):\n            raise ValidationError(\"Input 'n' must be an integer.\")\n        if self.n < 1:\n            raise ValidationError(\"Input 'n' must be greater than or equal to 1.\")\n\nclass DecagonalNumber:\n    \"\"\"Computes the decagonal number for a given n.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n        self.value = 0\n\n    def computeValue(self) -> int:\n        \"\"\"Computes the nth decagonal number using the formula D(n) = 4*n^2 - 3*n.\"\"\"\n        self.value = 4 * self.n * self.n - 3 * self.n\n        return self.value\n\ndef is_num_decagonal(n):\n    \"\"\"\n    Finds the nth decagonal number.\n    Raises ValidationError if n is not a positive integer.\n    \"\"\"\n    input_param = InputParameter(n)\n    input_param.validate()\n    decagonal_num_obj = DecagonalNumber(n)\n    return decagonal_num_obj.computeValue()"}
{"task_id": "Mbpp/285", "solution": "from typing import List\n\nclass Pattern:\n    \"\"\"Represents a literal string pattern to be matched.\"\"\"\n    def __init__(self, value: str, description: str = \"\"):\n        self.value = value\n        self.description = description\n\nclass InputString:\n    \"\"\"Represents the input string for matching operations.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\n\nclass MatchResult:\n    \"\"\"DTO containing the result of a match operation.\"\"\"\n    def __init__(self, matched: bool = False, positions: List[int] = None):\n        self.matched = matched\n        self.positions = positions if positions is not None else []\n\nclass TextMatchFunction:\n    \"\"\"Encapsulates pattern-matching logic for 'abb' and 'abbb'.\"\"\"\n    def __init__(self, name: str = \"text_match_two_three\"):\n        self.name = name\n        self._patterns: List[Pattern] = [\n            Pattern(\"abb\", \"character 'a' followed by two 'b's\"),\n            Pattern(\"abbb\", \"character 'a' followed by three 'b's\")\n        ]\n\n    def find_matches(self, text: InputString) -> MatchResult:\n        \"\"\"Scans the InputString for all occurrences of predefined patterns.\"\"\"\n        all_positions = []\n        matched = False\n        for pattern_obj in self._patterns:\n            pattern = pattern_obj.value\n            start = 0\n            while True:\n                idx = text.value.find(pattern, start)\n                if idx == -1:\n                    break\n                all_positions.append(idx)\n                matched = True\n                start = idx + 1 # Move past the found match to find next\n\n        return MatchResult(matched=matched, positions=sorted(list(set(all_positions))))\n\n    def text_match_two_three(self, text: str) -> bool:\n        \"\"\"Convenience method to check for 'abb' or 'abbb' in a string.\"\"\"\n        input_string = InputString(text)\n        result = self.find_matches(input_string)\n        return result.matched\n\ndef text_match_two_three(text: str) -> bool:\n    \"\"\"Checks whether a string contains the 'a' character followed by two or three 'b' characters.\"\"\"\n    matcher = TextMatchFunction()\n    return matcher.text_match_two_three(text)"}
{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(arr, n, k):\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in the array formed by\n    repeating the given array k times.\n    \"\"\"\n\n    def _kadane(data: list[int]) -> int:\n        \"\"\"Finds the maximum sum of a contiguous subarray in a single array.\"\"\"\n        max_so_far = data[0]\n        current_max = data[0]\n        for x in data[1:]:\n            current_max = max(x, current_max + x)\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    def _prefix_suffix_sums(data: list[int]) -> tuple[int, int]:\n        \"\"\"Calculates the maximum prefix sum and maximum suffix sum of an array.\"\"\"\n        # Assumes data is not empty as per design context (validation handles this).\n        \n        max_prefix_sum = -float('inf')\n        current_prefix_sum = 0\n        for x in data:\n            current_prefix_sum += x\n            max_prefix_sum = max(max_prefix_sum, current_prefix_sum)\n\n        max_suffix_sum = -float('inf')\n        current_suffix_sum = 0\n        for x in reversed(data):\n            current_suffix_sum += x\n            max_suffix_sum = max(max_suffix_sum, current_suffix_sum)\n\n        return max_prefix_sum, max_suffix_sum\n\n    # Input validation (arr, n, k) is assumed to have happened externally\n    # as per design context. arr is non-empty, k > 0.\n    \n    if k == 1:\n        return _kadane(arr)\n\n    kadane_single = _kadane(arr)\n    total_sum = sum(arr)\n    pref_max, suff_max = _prefix_suffix_sums(arr)\n\n    # Max sum spanning exactly two copies (max suffix of first + max prefix of second)\n    candidate_cross_two_arrays = suff_max + pref_max\n\n    result = kadane_single # Initialize result with the max from a single array.\n\n    if total_sum > 0:\n        # If total_sum > 0, including (k-2) full copies can increase the sum.\n        # This covers subarrays spanning multiple full arrays with max prefix and suffix.\n        max_sum_with_middle_arrays = suff_max + (k - 2) * total_sum + pref_max\n        result = max(result, candidate_cross_two_arrays, max_sum_with_middle_arrays)\n    else:\n        # If total_sum <= 0, adding full copies won't help.\n        # The max sum can only be within one copy or span at most two copies.\n        result = max(result, candidate_cross_two_arrays)\n    \n    return result"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers.\n    Includes input validation for type and value of n.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input n must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input n must be a non-negative integer.\")\n    \n    if n == 0:\n        return 0\n    \n    # Using the closed-form expression for sum_{k=1..n} (2k)^2 = 4 * sum_{k=1..n} k^2\n    # sum_{k=1..n} k^2 = n * (n+1) * (2n+1) / 6\n    # So, 4 * n * (n+1) * (2n+1) / 6 = 2 * n * (n+1) * (2n+1) / 3\n    # Use integer division to ensure an integer result.\n    result = (2 * n * (n + 1) * (2 * n + 1)) // 3\n    return result"}
{"task_id": "Mbpp/292", "solution": "from math import floor\n\ndef find(dividend, divisor) -> int:\n    \"\"\"Return math.floor(dividend / divisor) as int. Raises TypeError for non-numeric inputs and ZeroDivisionError for divisor == 0.\"\"\"\n    _validate_numeric(dividend, 'dividend')\n    _validate_numeric(divisor, 'divisor')\n    if divisor == 0:\n        raise ZeroDivisionError('divisor must not be zero')\n    return _compute_floor_quotient(dividend, divisor)\n\ndef _validate_numeric(value, role: str) -> None:\n    if not isinstance(value, (int, float)):\n        raise TypeError(f\"{role} must be numeric (int or float)\")\n\ndef _compute_floor_quotient(dividend, divisor) -> int:\n    return int(floor(dividend / divisor))"}
{"task_id": "Mbpp/290", "solution": "def _compute_lengths(lists):\n    \"\"\"Computes the length of each sublist from a list of lists.\"\"\"\n    return [len(sublist) for sublist in lists]\n\ndef _select_first_max_sublist(lists, lengths):\n    \"\"\"Selects the first sublist with the maximum length.\"\"\"\n    max_len = max(lengths)\n    max_idx = lengths.index(max_len)\n    return lists[max_idx]\n\ndef max_length(lists):\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns a tuple of (maximum_length, chosen_sublist).\n    \"\"\"\n    # _validate_input is omitted as per the \"Do NOT add isinstance() checks or raise exceptions for edge cases\" constraint.\n    lengths = _compute_lengths(lists)\n    max_len = max(lengths)\n    chosen_sublist = _select_first_max_sublist(lists, lengths)\n    return (max_len, chosen_sublist)"}
{"task_id": "Mbpp/293", "solution": "import math\n\ndef otherside_rightangle(a, b):\n    \"\"\"\n    Calculates the length of the hypotenuse of a right-angled triangle.\n    It applies the Pythagorean theorem: c = sqrt(a^2 + b^2).\n    \"\"\"\n    hypotenuse = math.sqrt(a * a + b * b)\n    return hypotenuse"}
{"task_id": "Mbpp/294", "solution": "def max_val(lst: list) -> int | float | None:\n    \"\"\"\n    Finds the maximum numeric value in a given heterogeneous list.\n    Non-numeric elements are ignored, and None is returned if no numeric elements are present.\n    \"\"\"\n\n    def _is_numeric(value: any) -> bool:\n        \"\"\"Determines if a value is an integer or a float, explicitly excluding booleans.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    def _collect_numeric_elements(input_list: list) -> list:\n        \"\"\"Filters the input list to gather only numeric elements as defined by _is_numeric.\"\"\"\n        numeric_elements = []\n        for item in input_list:\n            if _is_numeric(item):\n                numeric_elements.append(item)\n        return numeric_elements\n\n    numeric_values = _collect_numeric_elements(lst)\n\n    if not numeric_values:\n        return None\n    else:\n        return max(numeric_values)"}
{"task_id": "Mbpp/297", "solution": "def _flatten_recursive(item, output_list) -> None:\n    \"\"\"Module-private helper: if item is a list, recursively process its elements; else append item to output_list.\"\"\"\n    if isinstance(item, list):\n        for sub_item in item:\n            _flatten_recursive(sub_item, output_list)\n    else:\n        output_list.append(item)\n\ndef flatten_list(input_list) -> list:\n    \"\"\"Accepts a top-level Python list and returns a new flattened list (does not mutate input_list).\"\"\"\n    flattened_result = []\n    _flatten_recursive(input_list, flattened_result)\n    return flattened_result"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: list) -> int:\n    \"\"\"\n    Counts inversions in an array using a merge-sort based algorithm.\n    Validates input and ensures array immutability.\n    \"\"\"\n\n    def validate_input(arr_to_validate: list) -> bool:\n        \"\"\"\n        Validates that the input is an iterable (list-like).\n        Raises ValueError if the input is not iterable.\n        \"\"\"\n        if not hasattr(arr_to_validate, '__iter__'):\n            raise ValueError(\"Input must be an iterable (e.g., list, tuple).\")\n        return True\n\n    def _merge_and_count(left: list, right: list) -> tuple[list, int]:\n        \"\"\"\n        Merges two sorted lists and counts cross inversions.\n        Returns the merged sorted list and the count of cross inversions.\n        \"\"\"\n        merged_list = []\n        inversions = 0\n        i, j = 0, 0\n        n1, n2 = len(left), len(right)\n\n        while i < n1 and j < n2:\n            if left[i] <= right[j]:\n                merged_list.append(left[i])\n                i += 1\n            else:\n                # If left[i] > right[j], all remaining elements in left are also greater than right[j].\n                inversions += (n1 - i)\n                merged_list.append(right[j])\n                j += 1\n\n        merged_list.extend(left[i:])\n        merged_list.extend(right[j:])\n\n        return merged_list, inversions\n\n    def count_merge_sort(arr_to_sort: list) -> int:\n        \"\"\"\n        Counts inversions using a recursive merge sort approach on a shallow copy.\n        This function orchestrates the recursive counting process.\n        \"\"\"\n        # Create a shallow copy for the recursive process to ensure input immutability.\n        temp_arr_for_sort = list(arr_to_sort)\n\n        def _merge_sort_recursive(sub_arr: list) -> tuple[list, int]:\n            \"\"\"\n            Recursive helper that returns a sorted sub-array and its inversion count.\n            \"\"\"\n            n = len(sub_arr)\n            if n <= 1:\n                return sub_arr, 0\n\n            mid = n // 2\n            \n            # Recursively count inversions in left and right halves.\n            left_sorted, left_inversions = _merge_sort_recursive(sub_arr[:mid])\n            right_sorted, right_inversions = _merge_sort_recursive(sub_arr[mid:])\n\n            # Merge sorted halves and count cross-inversions.\n            merged_sorted, cross_inversions = _merge_and_count(left_sorted, right_sorted)\n\n            total_inversions = left_inversions + right_inversions + cross_inversions\n            return merged_sorted, total_inversions\n\n        _, inversions = _merge_sort_recursive(temp_arr_for_sort)\n        return inversions\n\n    # Main logic for get_Inv_Count\n    validate_input(arr)\n    return count_merge_sort(arr)"}
{"task_id": "Mbpp/299", "solution": "from typing import List, Tuple, Union\n\ndef max_aggregate(records: List[Tuple[str, Union[int, float]]]) -> Tuple[str, Union[int, float]]:\n    \"\"\"Group by name, sum values, and return (name, total) with maximal total.\n    Preconditions: records conforms to SRS BR6.\n    \"\"\"\n    totals: dict[str, Union[int, float]] = {}\n    for name, value in records:\n        totals[name] = totals.get(name, 0) + value\n    max_name, max_total = max(totals.items(), key=lambda kv: kv[1])\n    return (max_name, max_total)"}
{"task_id": "Mbpp/300", "solution": "def count_binary_seq(n):\n    \"\"\"\n    Calculates the count of binary sequences of length 2n where the sum of the first n bits\n    is the same as the sum of the last n bits. This value is the central binomial coefficient C(2n, n).\n    \"\"\"\n    def _factorial(val):\n        \"\"\"Helper function to compute factorial of a non-negative integer.\"\"\"\n        if val == 0:\n            return 1\n        res = 1\n        for i in range(1, val + 1):\n            res *= i\n        return res\n\n    # The number of such sequences is given by the central binomial coefficient C(2n, n).\n    # This is calculated as (2n)! / (n! * n!).\n    numerator = _factorial(2 * n)\n    denominator = _factorial(n) * _factorial(n)\n    return numerator / denominator"}
{"task_id": "Mbpp/301", "solution": "class DepthResult:\n    \"\"\"A data container for a computed depth value.\"\"\"\n    def __init__(self, depth: int) -> None:\n        self.depth = depth\n\nclass NonDictValue:\n    \"\"\"Represents a non-dictionary leaf value, holding its type and value.\"\"\"\n    def __init__(self, value: any) -> None:\n        self.value = value\n        self.value_type = str(type(value))\n\nclass DepthCalculator:\n    \"\"\"A stateless service to compute the maximum nesting depth of a dictionary.\"\"\"\n    def dict_depth(self, d: dict) -> int:\n        \"\"\"\n        Calculates the maximum nesting depth of the given dictionary.\n        A dictionary's depth is 1 plus the maximum depth of its dictionary-valued entries.\n        \"\"\"\n        return 1 + self._compute_max_child_depth(d)\n\n    def _compute_max_child_depth(self, d: dict) -> int:\n        \"\"\"\n        Recursively finds the maximum depth among dictionary-valued entries.\n        Returns 0 if no dictionary children, otherwise the maximum absolute depth found among children.\n        \"\"\"\n        max_depth_of_children = 0\n        for value in d.values():\n            if isinstance(value, dict):\n                # Recursively calculate the total depth of the child dictionary.\n                child_total_depth = self.dict_depth(value)\n                max_depth_of_children = max(max_depth_of_children, child_total_depth)\n        return max_depth_of_children\n\ndef dict_depth(d: dict) -> int:\n    \"\"\"\n    Computes the maximum nesting depth of a dictionary.\n    Delegates depth calculation to a DepthCalculator instance.\n    \"\"\"\n    calculator = DepthCalculator()\n    return calculator.dict_depth(d)"}
{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple\n\ndef _tokenize(text: str) -> List[str]:\n    \"\"\"Split text on whitespace and return tokens.\"\"\"\n    return text.split()\n\ndef _starts_with_p(word: str) -> bool:\n    \"\"\"Return True if word starts with 'p' or 'P'.\"\"\"\n    return len(word) > 0 and word[0].lower() == 'p'\n\ndef _collect_first_two(matches: List[str]) -> Tuple[str, str]:\n    \"\"\"Return first two matches as tuple; raise ValueError if fewer than two.\"\"\"\n    if len(matches) < 2:\n        raise ValueError(\"fewer than two words starting with 'p' found\")\n    return matches[0], matches[1]\n\ndef start_withp(input_list: List[str]) -> Tuple[str, str]:\n    \"\"\"Iterate input_list, tokenizes each string, filters words starting with 'p' or 'P',\n    and returns a tuple of the first two matches.\n    \"\"\"\n    matches: List[str] = []\n    for text in input_list:\n        tokens = _tokenize(text)\n        for token in tokens:\n            if _starts_with_p(token):\n                matches.append(token)\n                if len(matches) == 2:\n                    return _collect_first_two(matches)\n    return _collect_first_two(matches)"}
