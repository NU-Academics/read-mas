{"task_id": "Mbpp/125", "solution": "def find_length(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and number of 1s in any substring.\n    \"\"\"\n    class InvalidBinaryStringError(ValueError):\n        \"\"\"Exception raised for invalid characters in a binary string.\"\"\"\n        def __init__(self, message: str = \"Input contains invalid characters; only '0' and '1' allowed.\") -> None:\n            super().__init__(message)\n\n    class Validator:\n        \"\"\"Validates that a string contains only '0' and '1' characters.\"\"\"\n        def validateCharacters(self, value: str) -> None:\n            for char in value:\n                if char not in ('0', '1'):\n                    raise InvalidBinaryStringError()\n\n    class BinaryString:\n        \"\"\"Represents the input binary string, holding its value and length.\"\"\"\n        def __init__(self, value: str) -> None:\n            self.value: str = value\n            self.length: int = len(value)\n\n        def validate(self) -> None:\n            \"\"\"Validates the binary string, raising InvalidBinaryStringError if invalid.\"\"\"\n            validator = Validator()\n            validator.validateCharacters(self.value)\n\n    class Substring:\n        \"\"\"Data holder describing a contiguous substring and its computed difference.\"\"\"\n        def __init__(self, start_index: int, end_index: int, zeros_count: int, ones_count: int) -> None:\n            self.start_index: int = start_index\n            self.end_index: int = end_index\n            self.zeros_count: int = zeros_count\n            self.ones_count: int = ones_count\n            self.difference: int = zeros_count - ones_count\n\n    class Result:\n        \"\"\"Holds the maximum difference computed by the Finder.\"\"\"\n        def __init__(self, max_difference: int) -> None:\n            self.max_difference: int = max_difference\n\n    class Finder:\n        \"\"\"Finds the maximum difference between zeros and ones in any substring.\"\"\"\n        def __init__(self, input_string: BinaryString) -> None:\n            self._input_string = input_string\n\n        def find_length(self) -> int:\n            \"\"\"Computes and returns the maximum difference (zeros - ones).\"\"\"\n            if self._input_string.length == 0:\n                return 0\n            return self._max_diff_kadane()\n\n        def _max_diff_kadane(self) -> int:\n            \"\"\"Efficiently computes the maximum difference using Kadane's algorithm.\"\"\"\n            mapped_values = []\n            for char in self._input_string.value:\n                mapped_values.append(1 if char == '0' else -1)\n\n            max_so_far = mapped_values[0]\n            current_max = mapped_values[0]\n\n            for i in range(1, len(mapped_values)):\n                current_max = max(mapped_values[i], current_max + mapped_values[i])\n                max_so_far = max(max_so_far, current_max)\n            \n            return max_so_far\n\n    binary_string = BinaryString(input_string)\n    binary_string.validate()\n\n    finder = Finder(binary_string)\n    return finder.find_length()"}
{"task_id": "Mbpp/126", "solution": "def divisors(n: int) -> set[int]:\n    \"\"\"Return set of positive integer divisors of n (divisors are d > 0 where n % d == 0).\"\"\"\n    n = abs(n)\n    if n == 0:\n        return set()\n    \n    result = set()\n    for i in range(1, int(n**0.5) + 1):\n        if n % i == 0:\n            result.add(i)\n            result.add(n // i)\n    return result\n\ndef common_divisors(a: int, b: int) -> set[int]:\n    \"\"\"Return divisors(a) \u2229 divisors(b).\"\"\"\n    return divisors(a) & divisors(b)\n\nimport builtins\n\ndef sum(a: int, b: int) -> int:\n    \"\"\"Return integer sum of the common divisors of a and b. Function name required by specification.\"\"\"\n    return builtins.sum(common_divisors(a, b))"}
{"task_id": "Mbpp/123", "solution": "import math\n\nclass Number:\n    \"\"\"Lightweight holder for a number and its sum of proper divisors.\"\"\"\n    def __init__(self, value: int, sumProperDivisors: int):\n        self.value = value\n        self.sumProperDivisors = sumProperDivisors\n\nclass AmicablePair:\n    \"\"\"Lightweight holder for two integers forming an amicable pair.\"\"\"\n    def __init__(self, a: int, b: int):\n        self.a = a\n        self.b = b\n\nclass Result:\n    \"\"\"Final result holder: members and their sum.\"\"\"\n    def __init__(self, members: list[int]):\n        self.members = members\n        self.sum = sum(members)\n\nclass AmicableCalculator:\n    \"\"\"Central algorithmic coordinator; computes amicable numbers and produces result.\"\"\"\n    def __init__(self):\n        self._divisors_cache: dict[int, int] = {}\n        self._found_amicables: set[int] = set()\n\n    def sum_proper_divisors(self, n: int) -> int:\n        \"\"\"Compute and return sum of proper divisors of n, using memoization.\"\"\"\n        if n in self._divisors_cache:\n            return self._divisors_cache[n]\n        \n        if n <= 1:\n            self._divisors_cache[n] = 0\n            return 0\n\n        sum_divs = 1\n        sqrt_n = int(math.sqrt(n))\n        for i in range(2, sqrt_n + 1):\n            if n % i == 0:\n                sum_divs += i\n                if i * i != n:\n                    sum_divs += n // i\n        \n        self._divisors_cache[n] = sum_divs\n        return sum_divs\n\n    def _record_if_amicable(self, n: int, limit: int) -> None:\n        \"\"\"Checks if n is part of an amicable pair and records valid members within limit.\"\"\"\n        sum_n = self.sum_proper_divisors(n)\n        \n        if sum_n > 0 and sum_n != n:\n            sum_m = self.sum_proper_divisors(sum_n)\n            \n            if sum_m == n:\n                if 1 <= n <= limit:\n                    self._found_amicables.add(n)\n                if 1 <= sum_n <= limit:\n                    self._found_amicables.add(sum_n)\n\n    def amicable_numbers_sum(self, limit: int) -> int:\n        \"\"\"Computes and returns the sum of all amicable numbers up to the limit.\"\"\"\n        for n in range(1, limit + 1):\n            if n not in self._found_amicables: # Optimize by not re-checking already found amicables\n                self._record_if_amicable(n, limit)\n        \n        final_result = Result(list(self._found_amicables))\n        return final_result.sum\n\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Sums all amicable numbers from 1 to a specified number.\n    Raises ValueError if limit is not an integer or is less than 1.\n    \"\"\"\n    if not isinstance(limit, int) or limit < 1:\n        raise ValueError(\"Limit must be an integer greater than or equal to 1.\")\n    \n    calculator = AmicableCalculator()\n    return calculator.amicable_numbers_sum(limit)"}
{"task_id": "Mbpp/124", "solution": "import math\n\nclass ComplexPoint:\n    \"\"\"Holds a complex number's real and imaginary parts.\"\"\"\n    def __init__(self, real: float, imag: float) -> None:\n        self.real = real\n        self.imag = imag\n\n    def to_complex(self) -> complex:\n        \"\"\"Converts to a built-in complex number.\"\"\"\n        return complex(self.real, self.imag)\n\nclass InputValidator:\n    \"\"\"Validates and converts numeric inputs into ComplexPoint instances.\"\"\"\n    @staticmethod\n    def validate_and_convert(value) -> ComplexPoint:\n        # Python's built-in complex() constructor handles int, float, or complex inputs.\n        c_value = complex(value)\n        return ComplexPoint(c_value.real, c_value.imag)\n\nclass AngleComputation:\n    \"\"\"Computes the angle of a vector from start to end.\"\"\"\n    def __init__(self, start: ComplexPoint, end: ComplexPoint) -> None:\n        self.start = start\n        self.end = end\n\n    def computeAngle(self) -> float:\n        \"\"\"Computes the argument of the vector (end - start) in radians.\"\"\"\n        delta = self.end.to_complex() - self.start.to_complex()\n        \n        # Design decision: For zero-length vectors (start == end), return 0.0.\n        if delta.real == 0.0 and delta.imag == 0.0:\n            angle = 0.0\n        else:\n            angle = math.atan2(delta.imag, delta.real)\n        \n        return angle\n\ndef angle_complex(start, end) -> float:\n    \"\"\"\n    Computes the angle (argument) of the complex number representing the vector\n    from 'start' to 'end' in radians.\n    \"\"\"\n    start_cp = InputValidator.validate_and_convert(start)\n    end_cp = InputValidator.validate_and_convert(end)\n    comp = AngleComputation(start_cp, end_cp)\n    return comp.computeAngle()"}
{"task_id": "Mbpp/128", "solution": "from typing import List, Union\n\ndef long_words(n: int, words: Union[str, List[str]]) -> List[str]:\n    \"\"\"\n    Finds words longer than n characters from a given list or string of words.\n    The function returns a new list of qualifying words, preserving their original order.\n    \"\"\"\n    if isinstance(words, str):\n        tokens = words.split()\n    else:\n        tokens = words\n\n    result = []\n    for word in tokens:\n        if len(word) > n:\n            result.append(word)\n            \n    return result"}
{"task_id": "Mbpp/129", "solution": "class Matrix:\n    \"\"\"A lightweight wrapper for the input list-of-lists matrix, providing size and accessors.\"\"\"\n    def __init__(self, rows):\n        self.rows = rows\n        self.size = len(rows) if rows else 0\n\n    def get_row(self, i):\n        \"\"\"Returns the list representing the i-th row.\"\"\"\n        if 0 <= i < self.size:\n            return self.rows[i]\n        return []\n\n    def get_column(self, j):\n        \"\"\"Constructs and returns a list representing the j-th column.\"\"\"\n        if not self.rows or not (0 <= j < len(self.rows[0])):\n            return []\n        return [self.rows[i][j] for i in range(self.size)]\n\nclass ValidationResult:\n    \"\"\"Internal diagnostic container for magic square test results.\"\"\"\n    def __init__(self, isMagic: bool, magicConstant: float | None = None, errors: list[str] | None = None):\n        self.isMagic = isMagic\n        self.magicConstant = magicConstant\n        self.errors = errors if errors is not None else []\n\nclass MagicSquareTest:\n    \"\"\"Orchestrates validations and checks to determine if a matrix is a magic square.\"\"\"\n    def magic_square_test(self, matrix_list: list[list[float]]) -> bool:\n        \"\"\"Runs all checks to determine if the given matrix is a magic square.\"\"\"\n        matrix = Matrix(matrix_list)\n\n        if not self.validate_shape(matrix):\n            return False\n        if not self.validate_numeric_entries(matrix):\n            return False\n\n        magic_constant = self.compute_magic_constant(matrix)\n\n        if not self.check_rows(matrix, magic_constant):\n            return False\n        if not self.check_columns(matrix, magic_constant):\n            return False\n        if not self.check_diagonals(matrix, magic_constant):\n            return False\n\n        return True\n\n    def validate_shape(self, matrix: Matrix) -> bool:\n        \"\"\"Checks if the matrix is non-empty and square.\"\"\"\n        if matrix.size == 0:\n            return False\n        \n        expected_row_length = len(matrix.get_row(0))\n        if expected_row_length == 0 or expected_row_length != matrix.size:\n            return False\n            \n        for i in range(matrix.size):\n            if len(matrix.get_row(i)) != expected_row_length:\n                return False\n        \n        return True\n\n    def validate_numeric_entries(self, matrix: Matrix) -> bool:\n        \"\"\"Verifies that all matrix entries are numeric (int or float).\"\"\"\n        for i in range(matrix.size):\n            for element in matrix.get_row(i):\n                if not isinstance(element, (int, float)):\n                    return False\n        return True\n\n    def compute_magic_constant(self, matrix: Matrix) -> float:\n        \"\"\"Calculates the magic constant by summing the elements of the first row.\"\"\"\n        return sum(matrix.get_row(0))\n\n    def check_rows(self, matrix: Matrix, magic_constant: float) -> bool:\n        \"\"\"Verifies that the sum of each row equals the magic constant.\"\"\"\n        for i in range(matrix.size):\n            if sum(matrix.get_row(i)) != magic_constant:\n                return False\n        return True\n\n    def check_columns(self, matrix: Matrix, magic_constant: float) -> bool:\n        \"\"\"Verifies that the sum of each column equals the magic constant.\"\"\"\n        for j in range(matrix.size):\n            if sum(matrix.get_column(j)) != magic_constant:\n                return False\n        return True\n\n    def check_diagonals(self, matrix: Matrix, magic_constant: float) -> bool:\n        \"\"\"Verifies that the sum of both main diagonals equals the magic constant.\"\"\"\n        main_diagonal_sum = 0\n        anti_diagonal_sum = 0\n        \n        for i in range(matrix.size):\n            main_diagonal_sum += matrix.get_row(i)[i]\n            anti_diagonal_sum += matrix.get_row(i)[matrix.size - 1 - i]\n            \n        if main_diagonal_sum != magic_constant:\n            return False\n        if anti_diagonal_sum != magic_constant:\n            return False\n        \n        return True\n\ndef magic_square_test(matrix: list[list[float]]) -> bool:\n    \"\"\"\n    Checks if a given matrix is a magic square according to defined rules.\n    It performs shape and type validation, then verifies row, column, and diagonal sums.\n    \"\"\"\n    tester = MagicSquareTest()\n    return tester.magic_square_test(matrix)"}
{"task_id": "Mbpp/130", "solution": "def computeFrequencies(items):\n    \"\"\"Builds a dictionary mapping each item to its frequency count.\"\"\"\n    freq_map = {}\n    for item in items:\n        freq_map[item] = freq_map.get(item, 0) + 1\n    return freq_map\n\ndef _get_max_from_freq_map(freq_map):\n    \"\"\"Finds the item with the maximum frequency from the frequency map.\"\"\"\n    if not freq_map:\n        raise ValueError(\"Frequency map cannot be empty.\")\n    \n    # max() with a key finds the (item, count) pair with the highest count.\n    # item_count_pair[1] refers to the count in the (item, count) tuple.\n    max_pair = max(freq_map.items(), key=lambda item_count_pair: item_count_pair[1])\n    return max_pair # Returns a (value, count) tuple\n\ndef max_occurrences(items):\n    \"\"\"Finds the item with the maximum frequency in a given list.\"\"\"\n    if not isinstance(items, list):\n        raise TypeError(\"Input must be a list.\")\n    if not items:\n        raise ValueError(\"Input list cannot be empty.\")\n    \n    freq_map = computeFrequencies(items)\n    max_item, _ = _get_max_from_freq_map(freq_map)\n    return max_item"}
