{"task_id": "Mbpp/140", "solution": "def extract_singly(iterable_list) -> set:\n    \"\"\"Public API: flatten top-level list of inner iterables into a set of unique elements.\"\"\"\n    all_items = []\n    for inner_iterable in iterable_list:\n        for item in inner_iterable:\n            all_items.append(item)\n    return set(all_items)"}
{"task_id": "Mbpp/141", "solution": "class Element:\n    \"\"\"Minimal wrapper for individual element values for traceability.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\nclass List:\n    \"\"\"Minimal utility wrapper reflecting the SRS domain List for traceability.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\nclass PancakeSort:\n    \"\"\"Encapsulates the pancake sorting algorithm logic.\"\"\"\n\n    def _flip(self, arr: list, k: int):\n        \"\"\"Reverses the prefix of the list from index 0 up to index k (inclusive).\"\"\"\n        start = 0\n        while start < k:\n            arr[start], arr[k] = arr[k], arr[start]\n            start += 1\n            k -= 1\n\n    def sort(self, items: list) -> list:\n        \"\"\"Sorts a list using the pancake sort algorithm.\"\"\"\n        n = len(items)\n        # Create a mutable copy to perform sorting in-place on the copy.\n        arr = items[:]\n\n        for current_size in range(n, 1, -1):\n            # Find the index of the maximum element in the unsorted part (arr[0...current_size-1])\n            max_idx = 0\n            for i in range(1, current_size):\n                if arr[i] > arr[max_idx]:\n                    max_idx = i\n\n            # If the maximum element is not already at its correct sorted position\n            if max_idx != current_size - 1:\n                # If the maximum element is not at the beginning, flip to bring it there\n                if max_idx != 0:\n                    self._flip(arr, max_idx)\n\n                # Flip to move the maximum element from the front to its correct position\n                self._flip(arr, current_size - 1)\n        return arr\n\ndef pancake_sort(input_list: list) -> list:\n    \"\"\"Sorts a list of elements using the pancake sort algorithm.\"\"\"\n    sorter = PancakeSort()\n    return sorter.sort(input_list)"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(sequence):\n    \"\"\"\n    Computes the maximum absolute difference between any two elements in a given numeric sequence.\n    Assumes the input sequence contains numeric elements (ints or floats).\n    \"\"\"\n    def _compute_max_abs_diff(seq):\n        \"\"\"\n        Private helper to compute max(seq) - min(seq) for a non-empty numeric sequence.\n        \"\"\"\n        return max(seq) - min(seq)\n\n    if len(sequence) < 2:\n        return 0\n\n    return _compute_max_abs_diff(sequence)"}
{"task_id": "Mbpp/142", "solution": "class CountSamepairFunction:\n    \"\"\"Encapsulates the logic for counting identical items in three lists.\"\"\"\n    def __init__(self) -> None:\n        self._counter: int = 0\n\n    def validate_inputs(self, a: list, b: list, c: list) -> bool:\n        \"\"\"Validates that inputs conform to list semantics (duck-typing for __len__ and __getitem__).\"\"\"\n        for obj, name in zip([a, b, c], ['a', 'b', 'c']):\n            if not (hasattr(obj, '__len__') and hasattr(obj, '__getitem__')):\n                raise TypeError(f\"Input '{name}' must be a sequence (have __len__ and __getitem__).\")\n        return True\n\n    def _compute_min_length(self, a: list, b: list, c: list) -> int:\n        \"\"\"Returns the minimum length among the three input lists.\"\"\"\n        return min(len(a), len(b), len(c))\n\n    def count_samepair(self, a: list, b: list, c: list) -> int:\n        \"\"\"Performs the counting algorithm and returns the integer count.\"\"\"\n        self.validate_inputs(a, b, c)\n        min_len = self._compute_min_length(a, b, c)\n\n        for i in range(min_len):\n            va = a[i]\n            vb = b[i]\n            vc = c[i]\n            if va == vb == vc:\n                self._counter += 1\n        return self._counter\n\ndef count_samepair(a: list, b: list, c: list) -> int:\n    \"\"\"\n    Counts the number of items that are identical in the same position of three given lists.\n    Compares elements at each index across the three input lists and counts positions where all three elements are equal.\n    Comparisons are limited to indices present in all three lists (stops at min length).\n    \"\"\"\n    cf = CountSamepairFunction()\n    return cf.count_samepair(a, b, c)"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(list_a, list_b):\n    \"\"\"\n    Removes all elements from list_a that are present in list_b,\n    preserving the original relative order.\n    \"\"\"\n    elements_to_remove = set(list_b)\n    result = []\n    for item in list_a:\n        if item not in elements_to_remove:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/162", "solution": "class InputParameter:\n    \"\"\"A data class to hold the input integer n.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\nclass SeriesTerm:\n    \"\"\"A data class to represent an individual term in the series.\"\"\"\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\n\nclass Result:\n    \"\"\"A data class to hold the aggregated integer result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass SumSeriesFunction:\n    \"\"\"Handles validation and computation of the series sum.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n        self.terms = []\n        self.result = 0\n\n    def validateInput(self) -> bool:\n        \"\"\"Validates if the input 'n' is an integer.\"\"\"\n        return isinstance(self.n, int)\n\n    def compute(self) -> int:\n        \"\"\"Generates series terms, aggregates their sum, and stores the result.\"\"\"\n        self.terms = []\n        for i in range(0, self.n // 2 + 1):\n            term_value = self.n - 2 * i\n            self.terms.append(term_value)\n        \n        self.result = sum(self.terms)\n        return self.result\n\ndef sum_series(n):\n    \"\"\"\n    Calculates the sum (n - 2*i) from i=0 to n // 2.\n    Raises ValueError if n is not an integer.\n    \"\"\"\n    input_param = InputParameter(n=n)\n    inst = SumSeriesFunction(n=input_param.n)\n    if not inst.validateInput():\n        raise ValueError(\"n must be an integer\")\n    result_value = inst.compute()\n    return result_value"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a, b, n):\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple, or None if no solution exists.\n    The solution is canonical, with x in the range [0, abs(b/g) - 1] where g = gcd(a,b).\n    \"\"\"\n\n    def extended_gcd(num1, num2):\n        # Computes g, x, y such that num1*x + num2*y = g = gcd(num1, num2).\n        # g is guaranteed to be non-negative.\n        \n        if num1 == 0:\n            return (abs(num2), 0, 1 if num2 >= 0 else -1)\n        if num2 == 0:\n            return (abs(num1), 1 if num1 >= 0 else -1, 0)\n\n        original_num1, original_num2 = num1, num2\n        \n        # Ensure positive for core Euclidean algorithm and then adjust signs.\n        a_abs, b_abs = abs(num1), abs(num2)\n\n        x0, y0 = 1, 0\n        x1, y1 = 0, 1\n\n        while b_abs != 0:\n            q = a_abs // b_abs\n            a_abs, b_abs = b_abs, a_abs % b_abs\n            x0, x1 = x1, x0 - q * x1\n            y0, y1 = y1, y0 - q * y1\n        \n        # a_abs is the GCD. Adjust Bezout coefficients for original numbers' signs.\n        x_final = x0 * (1 if original_num1 >= 0 else -1)\n        y_final = y0 * (1 if original_num2 >= 0 else -1)\n\n        return (a_abs, x_final, y_final)\n\n    g, x0, y0 = extended_gcd(a, b)\n\n    if g == 0:  # This implies a == 0 and b == 0\n        return (0, 0) if n == 0 else None\n\n    if n % g != 0:\n        return None\n\n    # Handle cases where one coefficient is zero but not both (since g != 0).\n    if a == 0: \n        return (0, n // b)\n    if b == 0:\n        return (n // a, 0)\n\n    # Both a and b are non-zero.\n    # Calculate a particular solution (x_p, y_p)\n    factor = n // g\n    x_p = x0 * factor\n    y_p = y0 * factor\n\n    # Apply canonical translation such that 0 <= x < abs(b // g).\n    # The general solution is x = x_p + k * (b/g), y = y_p - k * (a/g).\n    # We find k to shift x_p to the smallest non-negative x.\n    \n    b_prime = b // g # b_prime is non-zero here\n    a_prime = a // g # a_prime is non-zero here\n\n    # Calculate k to bring x_p into the range [0, abs(b_prime)-1].\n    # Python's `%` operator's result has the same sign as the divisor.\n    # To get a non-negative x, we use `x_p % abs(b_prime)`.\n    k_final = ( (x_p % abs(b_prime)) - x_p ) // b_prime\n\n    x_final = x_p + k_final * b_prime\n    y_final = y_p - k_final * a_prime\n\n    return (x_final, y_final)"}
{"task_id": "Mbpp/166", "solution": "class ParityCounter:\n    \"\"\"Encapsulates the algorithm for counting same-parity unordered pairs.\"\"\"\n    def countPairs(self, nums: list[int]) -> int:\n        \"\"\"\n        Counts unordered pairs (i < j) in nums where nums[i] XOR nums[j] is even.\n        This is equivalent to counting pairs with the same parity.\n        \"\"\"\n        even_count = 0\n        odd_count = 0\n\n        for v in nums:\n            if v % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n        # Compute combinations: C(n, 2) = n * (n - 1) // 2\n        # Sum pairs of even numbers and pairs of odd numbers.\n        result = (even_count * (even_count - 1) // 2) + \\\n                 (odd_count * (odd_count - 1) // 2)\n        return result\n\ndef find_even_pair(nums: list[int]) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that xor to an even number.\n    Delegates the counting logic to a ParityCounter instance.\n    \"\"\"\n    counter = ParityCounter()\n    return counter.countPairs(nums)"}
{"task_id": "Mbpp/165", "solution": "ALPHABET_POSITIONS = {chr(i): i - ord('A') + 1 for i in range(ord('A'), ord('Z') + 1)}\n\ndef _is_alpha_char(ch: str) -> bool:\n    \"\"\"Checks if a character is an English alphabet letter.\"\"\"\n    return ch.isalpha()\n\ndef _alphabet_position(ch: str) -> int:\n    \"\"\"Returns the 1-based alphabet position of an alphabetic character.\"\"\"\n    return ALPHABET_POSITIONS[ch.upper()]\n\ndef count_char_position(input: str) -> int:\n    \"\"\"\n    Evaluates a string to count characters that match their 1-based alphabet position (case insensitive).\n    Non-alphabetic characters are ignored for position matching.\n    \"\"\"\n    match_count = 0\n    for i, char in enumerate(input):\n        if _is_alpha_char(char):\n            alphabet_pos = _alphabet_position(char)\n            if (i + 1) == alphabet_pos:\n                match_count += 1\n    return match_count"}
{"task_id": "Mbpp/168", "solution": "def frequency(list, target):\n    \"\"\"Count occurrences of target in a list and return the integer count.\"\"\"\n    count = 0\n    for element in list:\n        if element == target:\n            count += 1\n    return count"}
{"task_id": "Mbpp/167", "solution": "def is_power_of_two(n: int) -> bool:\n    \"\"\"Checks if n is a power of two.\"\"\"\n    return n > 0 and (n & (n - 1)) == 0\n\ndef next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Precondition: n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    if is_power_of_two(n):\n        return n\n\n    # For n > 0 and not a power of two, compute the smallest power of two strictly greater than n.\n    # This is done by 'smearing' the bits to the right of the MSB to 1s, then adding 1.\n    p = n\n    p |= p >> 1\n    p |= p >> 2\n    p |= p >> 4\n    p |= p >> 8\n    p |= p >> 16\n    p |= p >> 32 # Apply enough shifts to cover typical integer sizes (e.g., up to 64-bit)\n\n    return p + 1"}
