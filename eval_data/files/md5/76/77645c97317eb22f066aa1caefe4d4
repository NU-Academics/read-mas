{"task_id": "Mbpp/410", "solution": "def min_val(list):\n    \"\"\"\n    Finds the minimum numeric value (int or float) in a heterogeneous list.\n    Raises ValueError if no numeric data is found.\n    \"\"\"\n    min_value = float('inf')\n    has_numeric_elements = False\n\n    for item in list:\n        if isinstance(item, (int, float)):\n            has_numeric_elements = True\n            if item < min_value:\n                min_value = item\n    \n    if not has_numeric_elements:\n        raise ValueError(\"no numeric data\")\n    \n    return min_value"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(input_list):\n    \"\"\"Return an element from input_list that has maximal length measured by len().\n\n    Preserves the first-occurring element for ties.\n    \"\"\"\n    max_element = input_list[0]\n    max_length = len(input_list[0])\n\n    for i in range(1, len(input_list)):\n        current_element = input_list[i]\n        current_length = len(current_element)\n\n        if current_length > max_length:\n            max_length = current_length\n            max_element = current_element\n\n    return max_element"}
{"task_id": "Mbpp/414", "solution": "from typing import Iterable, Any, Optional\n\ndef overlapping(seq1: Iterable[Any], seq2: Iterable[Any]) -> bool:\n    \"\"\"\n    Checks if any value in seq1 exists in seq2.\n    Optimizes with set-based checking for hashable elements, falls back to nested loops otherwise.\n    \"\"\"\n    # Convert sequences to lists to handle potential generators and allow multiple iterations.\n    list_seq1 = list(seq1)\n    list_seq2 = list(seq2)\n\n    # Return False early if either sequence is empty.\n    if not list_seq1 or not list_seq2:\n        return False\n\n    seq2_as_set: Optional[set] = None\n    try:\n        # Attempt to convert seq2 to a set for efficient membership testing.\n        seq2_as_set = set(list_seq2)\n    except TypeError:\n        # If seq2 contains unhashable elements, set conversion fails,\n        # indicating the need to use the fallback path.\n        pass\n\n    if seq2_as_set is not None:\n        # Performance path: use set-based membership testing.\n        for item_s1 in list_seq1:\n            if item_s1 in seq2_as_set:\n                return True\n    else:\n        # Fallback path: nested element-by-element equality comparisons.\n        for item_s1 in list_seq1:\n            for item_s2 in list_seq2:\n                if item_s1 == item_s2:\n                    return True\n\n    # No overlapping elements were found.\n    return False"}
{"task_id": "Mbpp/420", "solution": "class Parameter:\n    \"\"\"Encapsulates and holds input n.\n    Per prompt, no validation is performed here.\n    \"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n\nclass Calculation:\n    \"\"\"Computes the sum of cubes of first n even natural numbers.\"\"\"\n    formula: str = \"sum_{k=1..n} (2*k)^3\"\n    \n    def computeSum(self, n: int) -> int:\n        total_sum = 0\n        for k in range(1, n + 1):\n            total_sum += (2 * k) ** 3\n        return total_sum\n\nclass Result:\n    \"\"\"Simple container for the integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\ndef cube_Sum(n: int) -> int:\n    \"\"\"Calculates the cube sum of first n even natural numbers.\n    Input n is assumed to be a valid integer >= 1, per prompt constraints.\n    \"\"\"\n    p = Parameter(n)\n    \n    calc = Calculation()\n    value = calc.computeSum(p.n)\n    \n    res = Result(value)\n    return res.value"}
{"task_id": "Mbpp/415", "solution": "def max_Product(numbers: list[int]) -> tuple[int, int]:\n    \"\"\"\n    Finds a pair of integers from a list with the highest product.\n\n    Raises ValueError if the input list contains fewer than two integers.\n    \"\"\"\n    if len(numbers) < 2:\n        raise ValueError(\"Input list must contain at least two integers.\")\n\n    # Initialize variables to keep track of the two largest and two smallest numbers.\n    # Use float('-inf') and float('inf') for initial comparison to ensure correctness\n    # even with very small/large negative/positive numbers.\n    max1 = float('-inf')  # Largest number\n    max2 = float('-inf')  # Second largest number\n    min1 = float('inf')   # Smallest number\n    min2 = float('inf')    # Second smallest number\n\n    for num in numbers:\n        # Update max1 and max2\n        if num > max1:\n            max2 = max1\n            max1 = num\n        elif num > max2:\n            max2 = num\n\n        # Update min1 and min2\n        if num < min1:\n            min2 = min1\n            min1 = num\n        elif num < min2:\n            min2 = num\n\n    # Calculate candidate products\n    product1 = max1 * max2\n    product2 = min1 * min2\n\n    # Determine which pair has the highest product\n    if product1 >= product2:\n        # The pair is (max1, max2). Return them in ascending order.\n        return (int(max2), int(max1))\n    else:\n        # The pair is (min1, min2). Return them in ascending order.\n        return (int(min1), int(min2))"}
