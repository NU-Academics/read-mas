{"task_id": "Mbpp/75", "solution": "from typing import List, Tuple, Iterable, Union\n\nclass Element:\n    \"\"\"Encapsulates a single integer element.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value: int = value\n\nclass TupleEntity:\n    \"\"\"Represents a tuple and checks divisibility for all its elements.\"\"\"\n    def __init__(self, elements_input: Union[Iterable[int], Iterable['Element']]) -> None:\n        self.elements: List[Element] = []\n        if elements_input:\n            # Determine if elements_input contains ints or Element objects\n            first_item = next(iter(elements_input))\n            if isinstance(first_item, int):\n                self.elements = [Element(e) for e in elements_input]\n            elif isinstance(first_item, Element):\n                self.elements = list(elements_input)\n\n    def allElementsDivisibleBy(self, k: int) -> bool:\n        \"\"\"Returns True if every element's value is divisible by k.\"\"\"\n        if not self.elements:\n            return True\n        for element in self.elements:\n            if element.value % k != 0:\n                return False\n        return True\n\nclass FindTuplesFunction:\n    \"\"\"Coordinates the filtering of TupleEntity objects.\"\"\"\n    def __init__(self, input_tuples: List[TupleEntity], k: int) -> None:\n        self.input_tuples = input_tuples\n        self.k = k\n\n    def filter(self) -> List[TupleEntity]:\n        \"\"\"Filters input tuples, returning those where all elements are divisible by k.\"\"\"\n        filtered_list: List[TupleEntity] = []\n        for tuple_entity in self.input_tuples:\n            if tuple_entity.allElementsDivisibleBy(self.k):\n                filtered_list.append(tuple_entity)\n        return filtered_list\n\ndef _to_tuple_entities(list_of_tuples: List[Tuple[int, ...]]) -> List[TupleEntity]:\n    \"\"\"Converts a list of native Python tuples into a list of TupleEntity objects.\"\"\"\n    return [TupleEntity(t) for t in list_of_tuples]\n\ndef find_tuples(list_of_tuples: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    \"\"\"\n    Finds tuples where all elements are divisible by k from the given list of tuples.\n    It delegates filtering to domain objects and converts results back to native tuples.\n    \"\"\"\n    tuple_entities = _to_tuple_entities(list_of_tuples)\n    filter_function = FindTuplesFunction(tuple_entities, k)\n    filtered_entities = filter_function.filter()\n\n    result: List[Tuple[int, ...]] = []\n    for entity in filtered_entities:\n        result.append(tuple(element.value for element in entity.elements))\n    return result"}
{"task_id": "Mbpp/80", "solution": "def _validate_integer(n) -> None:\n    \"\"\"Validates if the input n is an integer.\"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n\ndef _validate_non_negative(n: int) -> None:\n    \"\"\"Validates if the input n is non-negative.\"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\ndef tetrahedral_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth tetrahedral number using the closed-form formula.\n    Validates input for type and non-negativity, raising ValueError if invalid.\n    \"\"\"\n    _validate_integer(n)\n    _validate_non_negative(n)\n    return (n * (n + 1) * (n + 2)) // 6"}
