{"task_id": "Mbpp/108", "solution": "from typing import List, Optional\n\nclass IntegerList:\n    def __init__(self, items: List[int]) -> None:\n        self.items: List[int] = items\n\nclass MergeRequest:\n    def __init__(self, list1: List[int], list2: List[int], list3: List[int]) -> None:\n        self.list1: List[int] = list1\n        self.list2: List[int] = list2\n        self.list3: List[int] = list3\n\nclass MergeResult:\n    def __init__(self, merged_list: List[int]) -> None:\n        self.merged_list: List[int] = merged_list\n\nclass MergeService:\n    def __init__(self) -> None:\n        self._request: Optional[MergeRequest] = None\n\n    def merge_sorted_list(self, list1: List[int], list2: List[int], list3: List[int]) -> List[int]:\n        self._request = MergeRequest(list1, list2, list3)\n        # Concatenate inputs into a new list, preserving original lists.\n        merged = self._request.list1 + self._request.list2 + self._request.list3\n        # Sort the new list in ascending order.\n        sorted_merged = sorted(merged)\n        result = MergeResult(sorted_merged)\n        return result.merged_list\n\ndef merge_sorted_list(list1: List[int], list2: List[int], list3: List[int]) -> List[int]:\n    \"\"\"Public API (FR1): delegates to MergeService.\"\"\"\n    service = MergeService()\n    return service.merge_sorted_list(list1, list2, list3)"}
