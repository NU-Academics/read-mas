{"task_id": "Mbpp/63", "solution": "from typing import List, Tuple, Optional, Iterator\n\ndef max_difference(pairs: List[Tuple[float, float]]) -> float:\n    \"\"\"\n    Finds the maximum difference between available pairs in the given tuple list.\n    This function delegates the computation to an internal DifferenceCalculator.\n    \"\"\"\n\n    class Pair:\n        \"\"\"Represents a 2-element numeric tuple and computes its absolute difference.\"\"\"\n        def __init__(self, a: float, b: float) -> None:\n            self.a = float(a)\n            self.b = float(b)\n\n        def abs_difference(self) -> float:\n            \"\"\"Computes the absolute difference between a and b.\"\"\"\n            return abs(self.a - self.b)\n\n    class PairList:\n        \"\"\"Represents a collection of Pair objects.\"\"\"\n        def __init__(self, pairs: Optional[List[Tuple[float, float]]] = None) -> None:\n            self.pairs: List[Pair] = []\n            if pairs is not None:\n                for item_a, item_b in pairs:\n                    self.pairs.append(Pair(item_a, item_b))\n\n        def __iter__(self) -> Iterator[Pair]:\n            \"\"\"Allows iteration over the contained Pair objects.\"\"\"\n            return iter(self.pairs)\n\n        def __len__(self) -> int:\n            \"\"\"Returns the number of Pair objects.\"\"\"\n            return len(self.pairs)\n\n    class DifferenceCalculator:\n        \"\"\"A stateless domain service responsible for computing the maximum absolute difference.\"\"\"\n        def max_difference(self, pairs_data: List[Tuple[float, float]]) -> float:\n            \"\"\"\n            Calculates the maximum absolute difference among all given pairs.\n            Returns 0.0 if the input list is empty.\n            \"\"\"\n            if not pairs_data:\n                return 0.0\n\n            pair_list = PairList(pairs_data)\n            \n            max_diff = 0.0 \n\n            for pair in pair_list:\n                diff = pair.abs_difference()\n                if diff > max_diff:\n                    max_diff = diff\n            return max_diff\n\n    calc = DifferenceCalculator()\n    return calc.max_difference(pairs)"}
{"task_id": "Mbpp/66", "solution": "def _validate_input(numbers) -> None:\n    \"\"\"Raise TypeError if numbers is not list-like.\n    This ensures deterministic behavior for the required API.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list-like object.\")\n\ndef _count_positives(numbers) -> int:\n    \"\"\"Internal iteration to count items strictly greater than 0.\n    Non-numeric elements will raise during comparison and exceptions will propagate.\n    \"\"\"\n    count = 0\n    for item in numbers:\n        if item > 0:\n            count += 1\n    return count\n\ndef pos_count(numbers: list) -> int:\n    \"\"\"Return the number of elements in numbers that are strictly greater than 0.\n    This function validates the input and then counts positive numbers.\n    \"\"\"\n    _validate_input(numbers)\n    return _count_positives(numbers)"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list):\n    \"\"\"\n    Flattens a list, summing all numeric elements recursively.\n    Non-numeric elements encountered during traversal are ignored.\n    \"\"\"\n    \n    def _recursive_sum(obj):\n        \"\"\"\n        Internal helper to recursively traverse and sum numeric elements.\n        If an element is a list, it recurses; if numeric, it adds its value.\n        \"\"\"\n        current_sum = 0\n        if isinstance(obj, list):\n            for item in obj:\n                current_sum += _recursive_sum(item)\n        elif isinstance(obj, (int, float)):\n            current_sum += obj\n        return current_sum\n\n    total_sum = _recursive_sum(input_list)\n    return int(total_sum)"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list, sub_list) -> bool:\n    \"\"\"Return True if sub_list appears as a contiguous subsequence in main_list, else False.\n\n    This implementation performs an early length check and then uses a sliding-window comparison.\n    \"\"\"\n    m = len(main_list)\n    s = len(sub_list)\n\n    if s > m:\n        return False\n\n    for i in range(m - s + 1):\n        if main_list[i : i + s] == sub_list:\n            return True\n\n    return False"}
{"task_id": "Mbpp/67", "solution": "class InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to the bell_number function.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\ndef validate(n) -> None:\n    \"\"\"Validates the input n to be a non-negative integer.\"\"\"\n    if not isinstance(n, int):\n        raise InvalidInputError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n\ndef _compute_bell(n) -> int:\n    \"\"\"Computes the Bell number B_n using dynamic programming (Bell triangle).\"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize a Bell triangle (list of lists)\n    # bell_triangle[i][j] stores the j-th element of the i-th row\n    bell_triangle = [[0] * (i + 1) for i in range(n + 1)]\n    bell_triangle[0][0] = 1\n\n    for i in range(1, n + 1):\n        # The first element of each row is the last element of the previous row\n        bell_triangle[i][0] = bell_triangle[i - 1][i - 1]\n        for j in range(1, i + 1):\n            # Each subsequent element is the sum of the element to its left\n            # and the element diagonally above-left.\n            bell_triangle[i][j] = bell_triangle[i][j - 1] + bell_triangle[i - 1][j - 1]\n\n    return bell_triangle[n][0]\n\ndef bell_number(n) -> int:\n    \"\"\"\n    Computes the nth Bell number B_n.\n\n    The function validates the input n, which must be a non-negative integer.\n    It returns the exact integer result B_n using dynamic programming.\n    \"\"\"\n    validate(n)\n    return _compute_bell(n)"}
{"task_id": "Mbpp/68", "solution": "class Validation:\n    \"\"\"Validates input is a list and elements are numeric.\"\"\"\n    def is_list(self, values) -> bool:\n        \"\"\"Checks if the input is a list.\"\"\"\n        return isinstance(values, list)\n\n    def elements_are_numeric(self, values: list) -> bool:\n        \"\"\"Checks if all elements in the list are numeric (int or float).\"\"\"\n        return all(isinstance(x, (int, float)) for x in values)\n\nclass NumericList:\n    \"\"\"Thin data holder for the input list; provides length().\"\"\"\n    def __init__(self, values: list) -> None:\n        \"\"\"Initializes with the list of numeric values.\"\"\"\n        self.values = values\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the numeric list.\"\"\"\n        return len(self.values)\n\nclass MonotonicityResult:\n    \"\"\"Data carrier for the monotonicity boolean result.\"\"\"\n    def __init__(self, is_monotonic: bool) -> None:\n        \"\"\"Initializes with the boolean monotonicity result.\"\"\"\n        self.is_monotonic = is_monotonic\n\nclass MonotonicChecker:\n    \"\"\"Orchestrates validation and monotonicity checks.\"\"\"\n    def __init__(self, validator: 'Validation' = None) -> None:\n        \"\"\"Initializes with an optional Validation instance.\"\"\"\n        self._validator = validator if validator is not None else Validation()\n\n    def is_Monotonic(self, values: list) -> bool:\n        \"\"\"Checks if the given list is monotonic after validating its input.\"\"\"\n        if not self._validator.is_list(values):\n            raise TypeError(\"Input must be a list.\")\n        if not self._validator.elements_are_numeric(values):\n            raise TypeError(\"All elements in the list must be numeric (int or float).\")\n\n        numeric_list = NumericList(values)\n        \n        if numeric_list.length() <= 1:\n            return True\n\n        non_decreasing = self._check_non_decreasing(numeric_list)\n        non_increasing = self._check_non_increasing(numeric_list)\n        \n        result = MonotonicityResult(non_decreasing or non_increasing)\n        return result.is_monotonic\n\n    def _check_non_decreasing(self, numeric_list: 'NumericList') -> bool:\n        \"\"\"Checks if the list is non-decreasing (allows equal adjacent elements).\"\"\"\n        for i in range(numeric_list.length() - 1):\n            if numeric_list.values[i] > numeric_list.values[i+1]:\n                return False\n        return True\n\n    def _check_non_increasing(self, numeric_list: 'NumericList') -> bool:\n        \"\"\"Checks if the list is non-increasing (allows equal adjacent elements).\"\"\"\n        for i in range(numeric_list.length() - 1):\n            if numeric_list.values[i] < numeric_list.values[i+1]:\n                return False\n        return True\n\ndef is_Monotonic(values) -> bool:\n    \"\"\"\n    Checks whether the given array is monotonic (non-increasing or non-decreasing).\n    Raises TypeError if input is not a list or contains non-numeric elements.\n    \"\"\"\n    checker = MonotonicChecker()\n    return checker.is_Monotonic(values)"}
{"task_id": "Mbpp/70", "solution": "def validate_items(sequence):\n    \"\"\"Raise TypeError if any element in sequence is not a tuple.\"\"\"\n    for item in sequence:\n        if not isinstance(item, tuple):\n            raise TypeError(\"All elements in the sequence must be tuples.\")\n\ndef compare_lengths(sequence):\n    \"\"\"Return True if all tuples in sequence have equal length.\"\"\"\n    if not sequence or len(sequence) == 1:\n        return True\n\n    first_length = len(sequence[0])\n    for i in range(1, len(sequence)):\n        if len(sequence[i]) != first_length:\n            return False\n    return True\n\ndef get_equal(sequence):\n    \"\"\"Validate input elements are tuples, then return True if all tuples have the same length, False otherwise.\n    Raises TypeError if any element is not a tuple.\n    \"\"\"\n    validate_items(sequence)\n    return compare_lengths(sequence)"}
{"task_id": "Mbpp/71", "solution": "DEFAULT_SHRINK_FACTOR: float = 1.3\n\ndef _validate_input(elements: object) -> None:\n    \"\"\"Validates the input type and probes comparability of elements.\"\"\"\n    if not isinstance(elements, list):\n        raise TypeError(\"Input must be a list.\")\n    if len(elements) > 1:\n        # Probe comparability by attempting a comparison between the first two elements.\n        # This will raise an error if they are not comparable.\n        try:\n            _ = elements[0] > elements[1]\n        except TypeError as e:\n            raise TypeError(\"Elements in the list must be mutually comparable.\") from e\n\ndef comb_sort(elements: list) -> list:\n    \"\"\"\n    Sorts a list of comparable elements in ascending order using the comb sort algorithm.\n    This function validates input and applies the comb sort with a default shrink factor.\n    \"\"\"\n    _validate_input(elements)\n    arr = list(elements) # Create a mutable copy to avoid modifying the original list\n    n = len(arr)\n    gap = n\n    swapped = True\n\n    while gap > 1 or swapped:\n        if gap > 1:\n            gap = int(gap / DEFAULT_SHRINK_FACTOR)\n            if gap < 1:\n                gap = 1\n\n        swapped = False\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/72", "solution": "class InputValidator:\n    \"\"\"Validates if a given value is an integer.\"\"\"\n    def validate_is_int(self, value) -> bool:\n        \"\"\"Checks if the value is an instance of Python int.\"\"\"\n        return isinstance(value, int)\n\nclass DifferenceOfSquaresChecker:\n    \"\"\"Checks if a number can be represented as the difference of two squares.\"\"\"\n    def __init__(self, validator: InputValidator = None) -> None:\n        self._validator = validator if validator is not None else InputValidator()\n\n    def is_representable(self, n: int) -> bool:\n        \"\"\"Applies the mathematical rule: n is representable iff n % 4 != 2.\"\"\"\n        return n % 4 != 2\n\n    def dif_Square(self, n: int) -> bool:\n        \"\"\"Validates input and applies the difference of squares rule.\"\"\"\n        # If input is not an int, return False as it cannot be represented.\n        if not self._validator.validate_is_int(n):\n            return False\n        return self.is_representable(n)\n\ndef dif_Square(n):\n    \"\"\"\n    Top-level function to check if a number can be represented as the difference of two squares.\n    It delegates the actual logic and validation to an instance of DifferenceOfSquaresChecker.\n    \"\"\"\n    checker = DifferenceOfSquaresChecker()\n    return checker.dif_Square(n)"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(patterns, sequence):\n    \"\"\"\n    Checks whether the sequence follows the pattern given in the patterns array.\n    \"\"\"\n    class PatternList:\n        def __init__(self, patterns_data: list) -> None:\n            self.patterns = patterns_data\n\n        def length(self) -> int:\n            return len(self.patterns)\n\n        def get(self, index: int):\n            return self.patterns[index]\n\n    class SequenceList:\n        def __init__(self, sequence_data: list) -> None:\n            self.sequence = sequence_data\n\n        def length(self) -> int:\n            return len(self.sequence)\n\n        def get(self, index: int):\n            return self.sequence[index]\n\n    class MatchResult:\n        def __init__(self, isMatch: bool, reason: str = None) -> None:\n            self.isMatch = isMatch\n            self.reason = reason\n\n    class Validator:\n        def validateLengths(self, patterns_arg, sequence_arg) -> bool:\n            # Checks if the lengths of patterns and sequence are equal.\n            return len(patterns_arg) == len(sequence_arg)\n\n        def validateTypes(self, patterns_arg, sequence_arg) -> bool:\n            # Best-effort type check. Given constraints, this method assumes inputs are valid.\n            return True\n\n    class PatternMapper:\n        def __init__(self) -> None:\n            self._mapping = {}  # Stores pattern_value -> sequence_value mappings.\n\n        def addMapping(self, pattern, value) -> None:\n            # Adds a new pattern-to-value mapping if the pattern is not already mapped.\n            if pattern not in self._mapping:\n                self._mapping[pattern] = value\n\n        def consistent(self, pattern, value) -> bool:\n            # Checks if an existing mapping for the pattern matches the given value, or if it's new.\n            return pattern not in self._mapping or self._mapping[pattern] == value\n\n        def check_all(self, patterns_list: PatternList, sequence_list: SequenceList) -> MatchResult:\n            # Iterates through patterns and sequence to build and verify consistency of mappings.\n            length = patterns_list.length()\n            for i in range(length):\n                pattern_val = patterns_list.get(i)\n                sequence_val = sequence_list.get(i)\n\n                if not self.consistent(pattern_val, sequence_val):\n                    return MatchResult(False, f\"Inconsistent mapping for pattern '{pattern_val}' at index {i}\")\n                \n                self.addMapping(pattern_val, sequence_val)\n            \n            return MatchResult(True, \"All patterns consistent\")\n\n    v = Validator()\n\n    # Validate types (returns True due to constraints on not using isinstance)\n    if not v.validateTypes(patterns, sequence):\n        return False\n\n    # Validate lengths of input lists\n    if not v.validateLengths(patterns, sequence):\n        return False\n    \n    # Handle the specific case for empty lists explicitly\n    if len(patterns) == 0 and len(sequence) == 0:\n        return True\n\n    # Create domain objects for easier access\n    pl = PatternList(patterns)\n    sl = SequenceList(sequence)\n    \n    # Use PatternMapper to check all patterns against the sequence\n    pm = PatternMapper()\n    result = pm.check_all(pl, sl)\n    \n    return result.isMatch"}
