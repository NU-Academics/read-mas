{"task_id": "Mbpp/398", "solution": "def sum_of_digits(numbers):\n    class Digit:\n        \"\"\"Represents a single decimal digit value.\"\"\"\n        def __init__(self, value: int) -> None:\n            self.value = value\n\n    class Number:\n        \"\"\"Represents an integer and provides decomposition into decimal digits.\"\"\"\n        def __init__(self, value: int) -> None:\n            self.value = value\n\n        def digits(self) -> list[int]:\n            \"\"\"Decomposes the number into its absolute base-10 digits.\"\"\"\n            if self.value == 0:\n                return [0]\n            \n            abs_value = abs(self.value)\n            digits_list = []\n            while abs_value > 0:\n                digit = abs_value % 10\n                digits_list.append(digit)\n                abs_value //= 10\n            digits_list.reverse()\n            return digits_list\n\n    class InputList:\n        \"\"\"Represents and validates the provided list of integers.\"\"\"\n        def __init__(self, numbers: list[int]) -> None:\n            self.numbers = numbers\n\n        def validate(self) -> None:\n            \"\"\"Raises TypeError if any element in the list is not an integer.\"\"\"\n            for item in self.numbers:\n                if not isinstance(item, int):\n                    raise TypeError(f\"Input list must contain only integers, but found {type(item).__name__}\")\n\n    class Result:\n        \"\"\"Represents the aggregated sum of digits.\"\"\"\n        def __init__(self, total: int) -> None:\n            self.total = total\n\n    class SumOfDigitsService:\n        \"\"\"Encapsulates business logic to compute aggregated sum of decimal digits.\"\"\"\n        def sum_of_digits(self, numbers: list[int]) -> int:\n            \"\"\"Computes the sum of digits for each number in the list and aggregates them.\"\"\"\n            input_list = InputList(numbers)\n            input_list.validate()\n\n            total_aggregated_sum = 0\n            for num_value in numbers:\n                number_obj = Number(num_value)\n                digits_list = number_obj.digits()\n                total_aggregated_sum += sum(digits_list)\n            \n            result_obj = Result(total_aggregated_sum)\n            return result_obj.total\n\n    return SumOfDigitsService().sum_of_digits(numbers)"}
{"task_id": "Mbpp/409", "solution": "import math\nimport numbers\nfrom typing import List, Tuple\n\ndef min_product_tuple(items: List[Tuple[numbers.Number, numbers.Number]]) -> numbers.Number:\n    \"\"\"\n    Computes the minimum product from pairs of tuples within a given list.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not items:\n        raise ValueError(\"Input list 'items' cannot be empty.\")\n\n    min_prod = math.inf\n\n    for a, b in items:\n        current_prod = a * b\n        if current_prod < min_prod:\n            min_prod = current_prod\n            \n    return min_prod"}
