{"task_id": "Mbpp/232", "solution": "def larg_nnum(items: list, n: int) -> list:\n    \"\"\"Return a list containing the n largest items from items.\n\n    Order of returned items is not significant.\n    \"\"\"\n    if n <= 0:\n        return []\n\n    # Sort the list in descending order to easily pick the largest items\n    sorted_items = sorted(items, reverse=True)\n\n    # Return the first n items from the sorted list\n    # Slicing handles the case where n > len(items) gracefully by returning all items\n    return sorted_items[:n]"}
{"task_id": "Mbpp/233", "solution": "def lateralsuface_cylinder(height, radius):\n    \"\"\"\n    Calculates the lateral surface area of a right circular cylinder.\n    Validates inputs for numeric type (int/float) and finiteness before computing 2 * pi * radius * height.\n    \"\"\"\n    import math\n\n    # Validate height input: must be int or float and finite.\n    if not isinstance(height, (int, float)) or not math.isfinite(height):\n        raise TypeError(\"Height must be a finite numeric value (int or float).\")\n    \n    # Validate radius input: must be int or float and finite.\n    if not isinstance(radius, (int, float)) or not math.isfinite(radius):\n        raise TypeError(\"Radius must be a finite numeric value (int or float).\")\n\n    # Convert inputs to float for consistent calculation and return type.\n    # This also correctly handles integer inputs by converting them to float.\n    height_f = float(height)\n    radius_f = float(radius)\n\n    # Calculate the lateral surface area using the formula: 2 * pi * radius * height.\n    lateral_area = 2 * math.pi * radius_f * height_f\n    \n    return lateral_area"}
{"task_id": "Mbpp/238", "solution": "def number_of_substrings(s: str) -> int:\n    \"\"\"Return the number of non-empty contiguous substrings of s; return 0 for empty s.\"\"\"\n    n = len(s)\n    return n * (n + 1) // 2"}
{"task_id": "Mbpp/235", "solution": "class EvenBitSetter:\n    def even_bit_set_number(self, number: int) -> int:\n        \"\"\"Applies the even bit mask to the number to set all even bits.\"\"\"\n        bit_length = number.bit_length()\n        even_mask = self.generate_even_mask(bit_length)\n        result = number | even_mask\n        return result\n\n    def generate_even_mask(self, bit_length: int) -> int:\n        \"\"\"Generates a mask with 1s at all even bit positions up to the given length.\"\"\"\n        mask = 0\n        for i in range(bit_length):\n            if i % 2 == 0:  # If the bit position is even (0-indexed)\n                mask |= (1 << i)\n        return mask\n\ndef even_bit_set_number(number: int) -> int:\n    \"\"\"Public API: accepts an integer and returns an integer with all even bits set.\"\"\"\n    setter = EvenBitSetter()\n    return setter.even_bit_set_number(number)"}
{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the number of sequences of length n with elements a_i such that\n    1 <= a_i <= m and a_i >= 2 * a_{i-1} for i >= 2.\n    \"\"\"\n    # dp_prev[j] stores the number of sequences of the current length ending with j.\n    # Initialize for sequences of length 1: any integer from 1 to m is valid.\n    dp_prev = [0] * (m + 1)\n    for j in range(1, m + 1):\n        dp_prev[j] = 1\n\n    # Build up for sequences of length k from 2 to n using dynamic programming.\n    for _ in range(2, n + 1):\n        dp_curr = [0] * (m + 1)\n        \n        # Calculate prefix sums of dp_prev to efficiently sum counts from previous states.\n        prefix_sums_prev = [0] * (m + 1)\n        current_sum = 0\n        for idx in range(1, m + 1):\n            current_sum += dp_prev[idx]\n            prefix_sums_prev[idx] = current_sum\n        \n        # For each possible last element 'j' in the current sequence length,\n        # sum counts from valid previous elements (up to j // 2).\n        for j in range(1, m + 1):\n            max_prev_val = j // 2\n            if max_prev_val >= 1:\n                dp_curr[j] = prefix_sums_prev[max_prev_val]\n        \n        dp_prev = dp_curr\n    \n    # The total count is the sum of all valid sequences of length n,\n    # which are stored in dp_prev after n iterations.\n    return sum(dp_prev)"}
