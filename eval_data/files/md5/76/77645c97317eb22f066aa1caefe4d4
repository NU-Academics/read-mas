{"task_id": "Mbpp/61", "solution": "from dataclasses import dataclass\nfrom typing import Iterator\n\n@dataclass\nclass InputString:\n    value: str\n    def length(self) -> int:\n        \"\"\"Return len(self.value)\"\"\"\n        return len(self.value)\n\n@dataclass\nclass Substring:\n    parent: InputString\n    start_index: int\n    end_index: int  # inclusive\n    def length(self) -> int:\n        \"\"\"Return end_index - start_index + 1\"\"\"\n        return self.end_index - self.start_index + 1\n    def digit_sum(self) -> int:\n        \"\"\"Compute sum(int(ch) for ch in parent.value[start_index:end_index+1])\"\"\"\n        return sum(int(ch) for ch in self.parent.value[self.start_index : self.end_index + 1])\n\n@dataclass\nclass Digit:\n    position: int\n    value: int\n\n@dataclass\nclass Counter:\n    count: int = 0\n    def increment(self) -> None:\n        \"\"\"Increment count by 1\"\"\"\n        self.count += 1\n    def value(self) -> int:\n        \"\"\"Return current count\"\"\"\n        return self.count\n\ndef _is_digits_only(s: str) -> bool:\n    \"\"\"Return True iff all characters in s are in '0'..'9'\"\"\"\n    return s.isdigit()\n\ndef _generate_substrings(s_obj: InputString) -> Iterator[Substring]:\n    \"\"\"Yield Substring objects covering all contiguous substrings of s_obj\"\"\"\n    n = s_obj.length()\n    for i in range(n):\n        for j in range(i, n):\n            yield Substring(parent=s_obj, start_index=i, end_index=j)\n\ndef count_Substrings(s: str) -> int:\n    \"\"\"\n    Validate s (digits-only). For each contiguous substring of s, compute digit sum and\n    increment counter when digit_sum == substring_length. Return final counter value.\n    Raises ValueError if s contains non-digit characters.\n    \"\"\"\n    if not _is_digits_only(s):\n        raise ValueError(\"Input string must contain only digits.\")\n\n    if not s:\n        return 0\n\n    counter = Counter()\n    n = len(s)\n\n    for i in range(n):\n        running_sum = 0\n        for j in range(i, n):\n            running_sum += int(s[j])\n            substring_length = j - i + 1\n            if running_sum == substring_length:\n                counter.increment()\n    \n    return counter.value()"}
