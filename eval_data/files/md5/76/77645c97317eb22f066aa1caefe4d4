{"task_id": "Mbpp/92", "solution": "def digits_from_int(raw_value: int) -> list[int]:\n    \"\"\"Converts an integer to a list of its base-10 digits, ignoring sign.\"\"\"\n    if raw_value == 0:\n        return [0]\n    s_val = str(abs(raw_value))\n    return [int(d) for d in s_val]\n\nclass NumberValue:\n    \"\"\"Domain model for an input integer, handling normalization and digit extraction.\"\"\"\n    def __init__(self, raw_value: int):\n        self.raw_value = raw_value\n        self.is_negative = raw_value < 0\n        self.digits: list[int] | None = None\n\n    def normalize(self) -> list[int]:\n        \"\"\"Computes and stores the canonical list of digits for the absolute value.\"\"\"\n        self.digits = digits_from_int(self.raw_value)\n        return self.digits\n\nclass UndulatingResult:\n    \"\"\"Encapsulates the boolean outcome and a human-readable reason for undulating checks.\"\"\"\n    def __init__(self, result: bool, reason: str):\n        self.result = result\n        self.reason = reason\n\nclass UndulatingChecker:\n    \"\"\"Implements the logic to determine if a number is undulating.\"\"\"\n    def is_undulating(self, number_value: 'NumberValue') -> bool:\n        \"\"\"Determines if the given NumberValue represents an undulating number.\"\"\"\n        evaluation_result = self.evaluate(number_value)\n        return evaluation_result.result\n\n    def evaluate(self, number_value: 'NumberValue') -> 'UndulatingResult':\n        \"\"\"Evaluates a NumberValue and returns an UndulatingResult with reason.\"\"\"\n        digits = number_value.digits\n        if digits is None:\n            return UndulatingResult(False, \"NumberValue not normalized; digits not available.\")\n\n        if len(digits) < 2:\n            return UndulatingResult(False, \"Numbers with less than two digits are not undulating.\")\n\n        a_val = digits[0]\n        b_val = digits[1]\n\n        if a_val == b_val:\n            return UndulatingResult(False, \"The first two digits are identical, so it's not undulating.\")\n\n        for i, digit in enumerate(digits):\n            if i % 2 == 0: # 1-based odd position (1st, 3rd, etc.)\n                if digit != a_val:\n                    return UndulatingResult(False, f\"Digit at 1-based position {i+1} ({digit}) does not match A ({a_val}).\")\n            else: # 1-based even position (2nd, 4th, etc.)\n                if digit != b_val:\n                    return UndulatingResult(False, f\"Digit at 1-based position {i+1} ({digit}) does not match B ({b_val}).\")\n\n        return UndulatingResult(True, f\"The number is undulating with alternating digits A={a_val}, B={b_val}.\")\n\ndef is_undulating(number: int) -> bool:\n    \"\"\"Checks whether the given integer is an undulating number.\n    An undulating number has an alternating pattern of two distinct digits (A, B) where A != B, and single-digit numbers are not undulating.\n    \"\"\"\n    nv = NumberValue(number)\n    nv.normalize()\n    checker = UndulatingChecker()\n    return checker.is_undulating(nv)"}
{"task_id": "Mbpp/97", "solution": "from typing import Any, Dict, Hashable, Iterable, List\n\ndef frequency_lists(listOfLists) -> dict:\n    \"\"\"Compute frequency mapping for flattened listOfLists.\n\n    Parameters:\n    - listOfLists: expected to be an outer list whose elements are sublists.\n      Each element in sublists must be hashable to be used as a dict key.\n\n    Returns:\n    - dict mapping element -> int (counts)\n    \"\"\"\n    counts: Dict[Hashable, int] = {}\n    for sublist in listOfLists:\n        for item in sublist:\n            counts[item] = counts.get(item, 0) + 1\n    return counts"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(sequence):\n    \"\"\"Multiplies all numbers in a sequence and divides the product by the sequence's length.\"\"\"\n    product = 1\n    for num in sequence:\n        product *= num\n    \n    length = len(sequence)\n    # The design context implies validation and error handling for empty sequences,\n    # but the explicit requirements for this task state:\n    # \"DO NOT add isinstance() checks or raise exceptions for edge cases\".\n    # Therefore, we proceed assuming a non-empty sequence as per the example.\n    \n    return float(product) / length"}
{"task_id": "Mbpp/99", "solution": "class DecimalNumber:\n    \"\"\"Represents a decimal integer and checks its non-negativity.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_non_negative(self) -> bool:\n        \"\"\"Checks if the decimal number is non-negative.\"\"\"\n        return self.value >= 0\n\nclass BinaryString:\n    \"\"\"Represents a binary string and checks for leading zeros.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def has_no_leading_zeros(self) -> bool:\n        \"\"\"Checks if the binary string has no leading zeros, unless it is '0'.\"\"\"\n        if self.value == \"0\":\n            return True\n        return not (self.value.startswith('0') and len(self.value) > 1)\n\nclass Converter:\n    \"\"\"Converts a decimal number to its binary string representation.\"\"\"\n    def decimal_to_binary(self, n: int) -> str:\n        \"\"\"Converts a non-negative decimal integer to its binary equivalent.\"\"\"\n        self._validate_input(n)\n\n        if n == 0:\n            return \"0\"\n\n        binary_str = self._convert_positive(n)\n        \n        # The design implies the Converter 'produces' a BinaryString object,\n        # which can then be used to ensure 'has_no_leading_zeros()'.\n        # Though the method returns a string, this line acknowledges the design.\n        _ = BinaryString(binary_str) \n\n        return binary_str\n\n    def _validate_input(self, n: int) -> bool:\n        \"\"\"Validates if the input is a non-negative integer, raising ValueError if invalid.\"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"Input must be an integer.\")\n        if not DecimalNumber(n).is_non_negative():\n            raise ValueError(\"Input must be a non-negative integer.\")\n        return True\n\n    def _convert_positive(self, n: int) -> str:\n        \"\"\"Converts a positive integer to its binary string representation without leading zeros.\"\"\"\n        digits = []\n        while n > 0:\n            remainder = n % 2\n            digits.append(str(remainder))\n            n //= 2\n        \n        # The digits are collected in reverse order, so reverse them to get the correct binary string.\n        binary_result = \"\".join(digits[::-1])\n        return binary_result\n\ndef decimal_to_binary(n: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal number to its binary equivalent,\n    represented as a string with no leading zeros.\n    \"\"\"\n    converter = Converter()\n    return converter.decimal_to_binary(n)"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"Finds the next smallest palindrome strictly greater than the input integer.\"\"\"\n\n    class IntegerInput:\n        \"\"\"Encapsulates the input integer value.\"\"\"\n        def __init__(self, value: int):\n            self.value = value\n\n    class PalindromeGenerator:\n        \"\"\"Generates and checks for palindrome numbers.\"\"\"\n        def is_palindrome(self, num: int) -> bool:\n            \"\"\"Checks if a number is a palindrome by comparing its string representation with its reverse.\"\"\"\n            s = str(num)\n            return s == s[::-1]\n\n        def generate_next(self, num: int) -> int:\n            \"\"\"Finds the smallest palindrome strictly greater than num by incrementing and checking.\"\"\"\n            candidate = num + 1\n            while not self.is_palindrome(candidate):\n                candidate += 1\n            return candidate\n\n    # Instantiate the domain model for the input.\n    input_obj = IntegerInput(n)\n    # Instantiate the palindrome generation service.\n    generator_obj = PalindromeGenerator()\n    # Compute and return the next smallest palindrome.\n    return generator_obj.generate_next(input_obj.value)"}
{"task_id": "Mbpp/101", "solution": "def kth_element(array, k):\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    Raises KthElementError for invalid inputs according to design specifications.\n    \"\"\"\n\n    class Error:\n        def __init__(self, type: str, message: str):\n            self.type = type\n            self.message = message\n\n    class KthElementError(Exception):\n        def __init__(self, message: str, error: Error = None):\n            super().__init__(message)\n            self.error = error\n\n    # Helper function for validation, as specified in design's validator.py\n    def validate_k(arr, val_k):\n        if not arr:\n            raise KthElementError(\"Array cannot be empty.\", Error(\"ValueError\", \"Array is empty\"))\n        \n        if not isinstance(val_k, int):\n            raise KthElementError(f\"k must be an integer, but received {type(val_k).__name__}.\", Error(\"TypeError\", \"k is not an integer\"))\n        \n        if not (1 <= val_k <= len(arr)):\n            raise KthElementError(f\"k ({val_k}) is out of bounds for array of length {len(arr)}.\", Error(\"IndexError\", \"k out of bounds\"))\n        \n        return val_k - 1\n\n    # Helper function for selection, as specified in design's selector.py\n    def select_element(arr, index):\n        # This function assumes 'index' is already validated to be within bounds.\n        return arr[index]\n\n    zero_based_index = validate_k(array, k)\n    element_value = select_element(array, zero_based_index)\n    return element_value"}
{"task_id": "Mbpp/104", "solution": "def sort_sublists(iterable):\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists lexicographically.\n    Returns a new list of lists without modifying the input.\n    \"\"\"\n    if not isinstance(iterable, (list, tuple)):\n        raise TypeError(\"Outer iterable must be a list or tuple.\")\n\n    result = []\n    for sublist in iterable:\n        if not isinstance(sublist, (list, tuple)):\n            raise TypeError(\"Each sublist must be a list or tuple.\")\n\n        current_sublist = []\n        for item in sublist:\n            if not isinstance(item, str):\n                raise ValueError(\"All elements within sublists must be strings.\")\n            current_sublist.append(item)\n\n        current_sublist.sort()\n        result.append(current_sublist)\n    return result"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(input_string: str) -> str:\n    \"\"\"Converts a snake_case string to PascalCase.\"\"\"\n\n    def split(input_string: str) -> list[str]:\n        \"\"\"Splits a string by underscores.\"\"\"\n        return input_string.split('_')\n\n    def capitalize(word: str) -> str:\n        \"\"\"Capitalizes the first letter of a word, leaving the rest unchanged.\"\"\"\n        if not word:\n            return \"\"\n        return word[0].upper() + word[1:]\n\n    words = split(input_string)\n    camel_case_words = [capitalize(word) for word in words]\n    return \"\".join(camel_case_words)"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Computes the Eulerian number A(n, m) using dynamic programming.\n    Assumes n is a positive integer and 0 <= m < n as per problem context.\n    \"\"\"\n    # DP table where dp[i][j] stores A(i, j)\n    # Rows i from 0 to n, Columns j from 0 to n-1.\n    dp = [[0 for _ in range(n)] for _ in range(n + 1)]\n\n    # Base case: A(1, 0) = 1\n    # This is valid for n >= 1. The problem implies n >= 1 for valid m.\n    dp[1][0] = 1\n\n    # Fill the DP table using the recurrence relation: A(i, j) = (i - j) * A(i-1, j-1) + (j + 1) * A(i-1, j)\n    # i represents the current 'n' value\n    for i in range(2, n + 1):\n        # j represents the current 'm' value; valid j for A(i, j) are from 0 to i-1\n        for j in range(i):\n            # Term 1: (i - j) * A(i-1, j-1)\n            # A(i-1, j-1) is 0 if j-1 is out of range (< 0)\n            term1 = 0\n            if j - 1 >= 0:\n                term1 = (i - j) * dp[i-1][j-1]\n\n            # Term 2: (j + 1) * A(i-1, j)\n            # A(i-1, j) is 0 if j is out of range (>= i-1, as valid m for n-1 is 0 to n-2)\n            term2 = 0\n            if j < i - 1:\n                term2 = (j + 1) * dp[i-1][j]\n            \n            dp[i][j] = term1 + term2\n\n    return dp[n][m]"}
