{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr, n, i, k):\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from prefix until ith index,\n    including a given kth element where k > i.\n    \"\"\"\n\n    class ValidationError(Exception):\n        \"\"\"Exception raised for invalid input parameters.\"\"\"\n        pass\n\n    class Validator:\n        \"\"\"Validates input parameters for the subsequence function.\"\"\"\n        @staticmethod\n        def validate(arr_param, n_param, i_param, k_param):\n            if n_param != len(arr_param):\n                raise ValidationError(\"n must be equal to len(arr)\")\n            if not (0 <= i_param < n_param):\n                raise ValidationError(\"index i is out of bounds [0, n-1]\")\n            if not (0 <= k_param < n_param):\n                raise ValidationError(\"index k is out of bounds [0, n-1]\")\n            if k_param <= i_param:\n                raise ValidationError(\"k must be strictly greater than i\")\n\n    class SubsequenceCalculator:\n        \"\"\"Calculates maximum sum of increasing subsequences.\"\"\"\n\n        @staticmethod\n        def compute_prefix_best_sums(arr_param, i_param):\n            \"\"\"\n            Computes the maximum sum of an increasing subsequence ending at each index j in [0, i_param].\n            \"\"\"\n            # dp_sums[j] stores the maximum sum of an increasing subsequence ending at arr_param[j]\n            # considering elements from arr_param[0] to arr_param[j].\n            dp_sums = [0] * (i_param + 1)\n\n            for j in range(i_param + 1):\n                dp_sums[j] = arr_param[j]  # The element itself forms a subsequence of length 1\n                for p in range(j):\n                    if arr_param[p] < arr_param[j]:\n                        dp_sums[j] = max(dp_sums[j], dp_sums[p] + arr_param[j])\n            return dp_sums\n\n        @staticmethod\n        def max_sum_including_k(arr_param, n_param, i_param, k_param):\n            \"\"\"\n            Finds the maximum sum of an increasing subsequence from prefix 0..i_param\n            and including arr_param[k_param].\n            \"\"\"\n            prefix_best_sums = SubsequenceCalculator.compute_prefix_best_sums(arr_param, i_param)\n\n            max_predecessor_sum = float('-inf') # Initialize with negative infinity to handle potentially negative sums\n\n            # Find the best predecessor from indices 0 to i_param that is less than arr_param[k_param]\n            for j in range(i_param + 1):\n                if arr_param[j] < arr_param[k_param]:\n                    max_predecessor_sum = max(max_predecessor_sum, prefix_best_sums[j])\n\n            # If a valid predecessor was found, sum its best subsequence sum with arr_param[k_param]\n            if max_predecessor_sum != float('-inf'):\n                return max_predecessor_sum + arr_param[k_param]\n            else:\n                # If no element in arr[0...i] can precede arr[k], the subsequence is just arr[k]\n                return arr_param[k_param]\n\n    # Main logic of the max_sum_increasing_subseq function\n    Validator.validate(arr, n, i, k)\n    return SubsequenceCalculator.max_sum_including_k(arr, n, i, k)"}
{"task_id": "Mbpp/310", "solution": "from dataclasses import dataclass\nfrom typing import Tuple, List\n\n@dataclass\nclass InputString:\n    \"\"\"Encapsulates the raw input string value.\"\"\"\n    value: str\n\n    def length(self) -> int:\n        return len(self.value)\n\n@dataclass\nclass Character:\n    \"\"\"Represents a single character with its original position.\"\"\"\n    char: str\n    position: int\n\n@dataclass\nclass TupleOutput:\n    \"\"\"Encapsulates the assembled immutable tuple result.\"\"\"\n    elements: Tuple[str, ...]\n\n    def length(self) -> int:\n        return len(self.elements)\n\nclass StringToTupleFunction:\n    \"\"\"Orchestrates the conversion of an InputString to a TupleOutput.\"\"\"\n\n    def _process(self, input_string: InputString) -> TupleOutput:\n        \"\"\"Processes the InputString, filters spaces, and returns TupleOutput.\"\"\"\n        collected_chars: List[str] = []\n        for i, char_str in enumerate(input_string.value):\n            # As per design, Character objects are conceptually created but not stored in the final tuple elements.\n            # character_obj = Character(char=char_str, position=i) \n            \n            if char_str != ' ':  # Exclude U+0020 (ASCII space) characters.\n                collected_chars.append(char_str)\n        \n        return TupleOutput(elements=tuple(collected_chars))\n\ndef string_to_tuple(input: str) -> tuple:\n    \"\"\"Converts a string to a tuple of characters, excluding spaces.\"\"\"\n    input_obj = InputString(value=input)\n    processor = StringToTupleFunction()\n    output_obj = processor._process(input_obj)\n    \n    return output_obj.elements"}
{"task_id": "Mbpp/308", "solution": "class ProductPair:\n    \"\"\"Represents a product of two numbers along with their original indices.\"\"\"\n    def __init__(self, value: int, indexA: int, indexB: int):\n        self.value = value\n        self.indexA = indexA\n        self.indexB = indexB\n\nclass ProductRepository:\n    \"\"\"Stores and provides access to a collection of ProductPair objects.\"\"\"\n    def __init__(self):\n        self._products: list[ProductPair] = []\n\n    def add(self, pair: ProductPair) -> None:\n        self._products.append(pair)\n\n    def all(self) -> list[ProductPair]:\n        return self._products\n\nclass LargeProductService:\n    \"\"\"Orchestrates the logic for finding the largest products from two lists.\"\"\"\n    def large_product(self, list_a: list, list_b: list, k: int) -> list:\n        self._validate_inputs(list_a, list_b, k)\n\n        if not list_a or not list_b or k == 0:\n            return []\n\n        repo = self._generate_products(list_a, list_b)\n        return self._select_top_k(repo.all(), k)\n\n    def _validate_inputs(self, list_a: list, list_b: list, k: int) -> None:\n        if not isinstance(list_a, list) or not isinstance(list_b, list):\n            raise TypeError(\"list_a and list_b must be lists.\")\n        if not all(isinstance(x, int) for x in list_a):\n            raise TypeError(\"Elements in list_a must be integers.\")\n        if not all(isinstance(x, int) for x in list_b):\n            raise TypeError(\"Elements in list_b must be integers.\")\n        if not isinstance(k, int) or k < 0:\n            raise TypeError(\"k must be a non-negative integer.\")\n\n    def _generate_products(self, list_a: list, list_b: list) -> ProductRepository:\n        repo = ProductRepository()\n        for i in range(len(list_a)):\n            for j in range(len(list_b)):\n                pair = ProductPair(list_a[i] * list_b[j], i, j)\n                repo.add(pair)\n        return repo\n\n    def _select_top_k(self, products: list[ProductPair], k: int) -> list[int]:\n        products.sort(key=lambda p: p.value, reverse=True)\n        \n        result_values = [p.value for p in products]\n        if k >= len(result_values):\n            return result_values\n        else:\n            return result_values[:k]\n\ndef large_product(list_a, list_b, k):\n    \"\"\"\n    Finds the specified number of largest products from two lists,\n    selecting one factor from each list.\n    \"\"\"\n    svc = LargeProductService()\n    return svc.large_product(list_a, list_b, k)"}
{"task_id": "Mbpp/312", "solution": "import math\n\ndef volume_cone(radius, height):\n    \"\"\"\n    Public API. Validate radius and height then compute and return volume as float.\n    \"\"\"\n    if not isinstance(radius, (int, float)):\n        raise TypeError(\"Radius must be a numeric value (int or float).\")\n    if radius < 0:\n        raise ValueError(\"Radius cannot be negative.\")\n\n    if not isinstance(height, (int, float)):\n        raise TypeError(\"Height must be a numeric value (int or float).\")\n    if height < 0:\n        raise ValueError(\"Height cannot be negative.\")\n\n    # Ensure inputs are floats for consistent calculation\n    radius = float(radius)\n    height = float(height)\n\n    # Compute volume using the formula V = (1/3) * pi * radius^2 * height\n    volume = (1/3) * math.pi * (radius ** 2) * height\n\n    return volume"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n):\n    \"\"\"Return the largest power of two less than or equal to integer n.\n\n    Args:\n        n: int -- input integer (single parameter)\n\n    Returns:\n        int -- largest power of two <= n\n\n    Notes:\n        - SRS does not specify behavior for n <= 0 or non-integer inputs.\n    \"\"\"\n    power = 1\n    # Loop to find the highest power of 2.\n    # It continues as long as the next power of 2 (power * 2) is less than or equal to n.\n    while (power << 1) <= n:\n        power <<= 1\n    return power"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"Sets the left-most (highest-order) unset bit in a non-negative integer n.\"\"\"\n    if n == 0:\n        return 1\n\n    # Find the mask for the highest-order zero bit.\n    # This logic is inlined from _find_highest_zero_bit_mask as per instructions.\n    mask = 0\n    b = n.bit_length()\n    for pos in range(b - 1, -1, -1):\n        if ((n >> pos) & 1) == 0:\n            mask = 1 << pos\n            break\n    else:\n        # If no zero bit is found (e.g., n = 7 which is 111), set the next higher bit.\n        mask = 1 << b\n\n    return n | mask"}
{"task_id": "Mbpp/389", "solution": "class InvalidInputException(Exception):\n    def __init__(self, message: str) -> None:\n        \"\"\"Initializes the exception with a descriptive message.\"\"\"\n        self.message = message\n        super().__init__(self.message)\n\nclass Validator:\n    def is_non_negative_integer(self, n: any) -> bool:\n        \"\"\"Checks if the input n is a non-negative integer.\"\"\"\n        return isinstance(n, int) and n >= 0\n\n    def raise_invalid_input_exception(self, n: any) -> None:\n        \"\"\"Raises an InvalidInputException with a descriptive message.\"\"\"\n        raise InvalidInputException(f\"Input must be a non-negative integer, but got {n} of type {type(n).__name__}.\")\n\nclass LucasCalculator:\n    def find_lucas(self, n: int) -> int:\n        \"\"\"Computes the n-th Lucas number, handling base cases and delegating to iterative computation.\"\"\"\n        if n == 0:\n            return 2\n        elif n == 1:\n            return 1\n        else:\n            return self._compute_iterative(n)\n\n    def _compute_iterative(self, n: int) -> int:\n        \"\"\"Calculates Lucas numbers iteratively for n >= 2.\"\"\"\n        l_n_minus_2, l_n_minus_1 = 2, 1  # Corresponds to L0 and L1\n        for _ in range(2, n + 1):\n            current_lucas = l_n_minus_2 + l_n_minus_1\n            l_n_minus_2 = l_n_minus_1\n            l_n_minus_1 = current_lucas\n        return l_n_minus_1\n\ndef find_lucas(n: int) -> int:\n    \"\"\"\n    Finds the n'th Lucas number.\n    Validates input and delegates the computation to an internal calculator.\n    \"\"\"\n    validator = Validator()\n    if not validator.is_non_negative_integer(n):\n        validator.raise_invalid_input_exception(n)\n\n    calculator = LucasCalculator()\n    return calculator.find_lucas(n)"}
{"task_id": "Mbpp/390", "solution": "def add_string(input_list, format_string):\n    \"\"\"Applies a format string to each element in a list, replacing '{0}' with the element's string representation.\"\"\"\n    if not input_list:\n        return []\n\n    output_list = []\n    for element in input_list:\n        element_str = str(element)\n        formatted_element = format_string.replace(\"{0}\", element_str)\n        output_list.append(formatted_element)\n    return output_list"}
{"task_id": "Mbpp/391", "solution": "class Validator:\n    @staticmethod\n    def validate(ids: list, names: list, values: list) -> None:\n        \"\"\"Perform type and length checks, raising TypeError or ValueError on failure.\"\"\"\n        if not isinstance(ids, list):\n            raise TypeError(f\"ids must be list; got {type(ids).__name__}\")\n        if not isinstance(names, list):\n            raise TypeError(f\"names must be list; got {type(names).__name__}\")\n        if not isinstance(values, list):\n            raise TypeError(f\"values must be list; got {type(values).__name__}\")\n\n        len_ids = len(ids)\n        len_names = len(names)\n        len_values = len(values)\n\n        if not (len_ids == len_names == len_values):\n            raise ValueError(f\"Input lists must have equal length; got lengths: ids={len_ids}, names={len_names}, values={len_values}\")\n\nclass ConvertListDictionary:\n    @staticmethod\n    def convert(ids: list, names: list, values: list) -> list:\n        \"\"\"Convert parallel lists into a new list of nested dictionaries.\"\"\"\n        result = []\n        for i in range(len(ids)):\n            nested_dict = {ids[i]: {names[i]: values[i]}}\n            result.append(nested_dict)\n        return result\n\ndef convert_list_dictionary(ids: list, names: list, values: list) -> list:\n    \"\"\"Validate inputs and return list of nested dictionaries.\n    Raises TypeError if any input is not a list.\n    Raises ValueError if lists have unequal lengths.\n    \"\"\"\n    Validator.validate(ids, names, values)\n    return ConvertListDictionary.convert(ids, names, values)"}
{"task_id": "Mbpp/394", "solution": "def check_distinct(input_tuple):\n    \"\"\"\n    Checks if a given tuple contains no duplicate elements.\n    It raises TypeError if the input is not a tuple.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple\")\n\n    if not input_tuple:\n        return True\n\n    def _is_hashable(obj):\n        \"\"\"Safely checks if an object is hashable.\"\"\"\n        try:\n            hash(obj)\n            return True\n        except TypeError:\n            return False\n\n    def _check_with_set(elements_to_check):\n        \"\"\"\n        Uses a set for hashable elements and collects unhashable ones.\n        Returns (False, None) if a duplicate hashable is found,\n        else (True, list_of_unhashable_elements).\n        \"\"\"\n        seen_hashable = set()\n        unhashable_elements = []\n        for element in elements_to_check:\n            if _is_hashable(element):\n                if element in seen_hashable:\n                    return False, None  # Duplicate hashable found\n                seen_hashable.add(element)\n            else:\n                unhashable_elements.append(element)\n        return True, unhashable_elements\n\n    def _check_unhashable_fallback(elements_to_check):\n        \"\"\"\n        Performs pairwise comparison for unhashable elements.\n        Returns False if any two elements compare equal, True otherwise.\n        \"\"\"\n        n = len(elements_to_check)\n        for i in range(n):\n            for j in range(i + 1, n):\n                if elements_to_check[i] == elements_to_check[j]:\n                    return False  # Duplicate unhashable found\n        return True\n\n    no_hashable_duplicates, unhashable_elements = _check_with_set(input_tuple)\n\n    if not no_hashable_duplicates:\n        return False\n\n    if not unhashable_elements:\n        return True\n\n    return _check_unhashable_fallback(unhashable_elements)"}
{"task_id": "Mbpp/392", "solution": "def get_max_sum(n: int) -> int:\n    \"\"\"\n    Validates input and computes the maximum sum using memoized recursion.\n    f(n) = max( f(floor(n/2)) + f(floor(n/3)) + f(floor(n/4)) + f(floor(n/5)), n ).\n    \"\"\"\n    def _validate_input(n_val: int) -> None:\n        \"\"\"Ensures n is an integer and non-negative, raising ValueError otherwise.\"\"\"\n        if not isinstance(n_val, int):\n            raise ValueError(\"Input must be an integer.\")\n        if n_val < 0:\n            raise ValueError(\"Input must be a non-negative integer.\")\n\n    class GetMaxSumFunction:\n        \"\"\"Encapsulates the recursive computation of f(n) with memoization.\"\"\"\n        def __init__(self):\n            # Cache for memoization: maps n to f(n).\n            self._memo: dict[int, int] = {}\n\n        def computeBaseCase(self, n_val: int) -> int:\n            \"\"\"Returns the base case value for n=0.\"\"\"\n            return 0\n\n        def compute(self, n_val: int) -> int:\n            \"\"\"Recursively computes f(n_val), storing results in the memoization cache.\"\"\"\n            if n_val in self._memo:\n                return self._memo[n_val]\n\n            if n_val == 0:\n                result = self.computeBaseCase(n_val)\n            else:\n                sum_children = (\n                    self.compute(n_val // 2) +\n                    self.compute(n_val // 3) +\n                    self.compute(n_val // 4) +\n                    self.compute(n_val // 5)\n                )\n                result = max(sum_children, n_val)\n\n            self._memo[n_val] = result\n            return result\n\n    _validate_input(n)\n    calculator = GetMaxSumFunction()\n    return calculator.compute(n)"}
{"task_id": "Mbpp/395", "solution": "from typing import Optional\nfrom collections import Counter\n\ndef first_non_repeating_character(s: str) -> Optional[str]:\n    \"\"\"Return the earliest non-repeated character from s, or None if none exist.\n    This function counts character frequencies then iterates the string to find the first unique character.\n    \"\"\"\n    char_counts = Counter(s)\n    for char in s:\n        if char_counts[char] == 1:\n            return char\n    return None"}
{"task_id": "Mbpp/397", "solution": "def median_numbers(a: float, b: float, c: float) -> float:\n    \"\"\"Return the median (middle) of three numeric inputs as a float.\n    Preconditions: a, b, c are int or float (caller responsibility).\"\"\"\n    \n    # The sum of three numbers minus their minimum and maximum values yields the median.\n    # This approach uses a fixed number of comparisons and arithmetic operations, satisfying O(1) time and memory.\n    median_val = (a + b + c) - min(a, b, c) - max(a, b, c)\n    return float(median_val)"}
