{"task_id": "Mbpp/3", "solution": "def is_not_prime(n: int) -> bool:\n    \"\"\"Public API. Returns True if n is not prime, False if n is prime.\"\"\"\n    import math\n\n    class PrimeChecker:\n        \"\"\"Encapsulates primality logic.\"\"\"\n\n        def is_not_prime(self, num: int) -> bool:\n            \"\"\"Returns True if num is not prime (including num < 2), False if num is prime.\"\"\"\n            if num < 2:\n                return True\n            return not self._is_prime(num)\n\n        def _is_prime(self, num: int) -> bool:\n            \"\"\"Internal helper: returns True if num is prime, False otherwise.\"\"\"\n            if num < 2:\n                return False\n            if num == 2 or num == 3:\n                return True\n            if num % 2 == 0 or num % 3 == 0:\n                return False\n\n            i = 5\n            limit = math.isqrt(num)\n            while i <= limit:\n                if num % i == 0 or num % (i + 2) == 0:\n                    return False\n                i += 6\n            return True\n\n    checker = PrimeChecker()\n    return checker.is_not_prime(n)"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    \"\"\"\n\n    class StringInput:\n        \"\"\"Represents the input string with its value and length.\"\"\"\n        def __init__(self, value: str) -> None:\n            self.value = value\n            self.length = len(value)\n\n    class Result:\n        \"\"\"Represents the result, which is the minimum rotation count k.\"\"\"\n        def __init__(self, k: int) -> None:\n            self.k = k\n\n    class Rotation:\n        \"\"\"Provides static methods for string rotation operations.\"\"\"\n        @staticmethod\n        def rotate_left(s: str, k: int) -> str:\n            \"\"\"Performs a cyclic left shift of the string s by k positions.\"\"\"\n            return s[k:] + s[:k]\n\n    class RotationChecker:\n        \"\"\"Provides static methods to check for rotation equality.\"\"\"\n        @staticmethod\n        def is_rotation_equal(original: str, k: int) -> bool:\n            \"\"\"Checks if rotating the original string by k positions yields the original string.\"\"\"\n            return Rotation.rotate_left(original, k) == original\n\n    input_obj = StringInput(s)\n\n    # For an empty string, the concept of rotation is ill-defined, and the loop range would be empty.\n    # Assuming valid non-empty string input based on problem context (\"aaaa\").\n    if input_obj.length == 0:\n        return 0 # Or handle as an exceptional case if problem domain allowed.\n\n    for k in range(1, input_obj.length + 1):\n        if RotationChecker.is_rotation_equal(input_obj.value, k):\n            return Result(k).k\n    \n    # This line should theoretically not be reached for non-empty strings,\n    # as k = input_obj.length will always result in equality.\n    # It's here for logical completeness if the loop were somehow bypassed or for an empty string.\n    return input_obj.length"}
{"task_id": "Mbpp/7", "solution": "def find_char_long(input: str) -> list[str]:\n    \"\"\"\n    Finds words at least 4 characters long in a string after validation and tokenization.\n    Returns an empty list for invalid input or if no words meet the criteria.\n    \"\"\"\n    def validateInput(input: str) -> bool:\n        \"\"\"\n        Checks if the input is a valid string.\n        Returns True if input is a string, False otherwise.\n        \"\"\"\n        return isinstance(input, str)\n\n    def splitOnWhitespace(input: str) -> list[str]:\n        \"\"\"\n        Splits the input string into words based on whitespace.\n        Handles multiple spaces and leading/trailing whitespace by default.\n        \"\"\"\n        return input.split()\n\n    def filterByLength(words: list[str], minLen: int) -> list[str]:\n        \"\"\"\n        Filters a list of words, keeping only those that meet a minimum length.\n        Preserves original word casing and order.\n        \"\"\"\n        return [word for word in words if len(word) >= minLen]\n\n    if not validateInput(input):\n        return []\n\n    tokens = splitOnWhitespace(input)\n    filtered_tokens = filterByLength(tokens, 4)\n    return filtered_tokens"}
