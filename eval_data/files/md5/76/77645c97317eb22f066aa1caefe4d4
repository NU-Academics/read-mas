{"task_id": "Mbpp/91", "solution": "class StringList:\n    def __init__(self, items: list[str]) -> None:\n        self.items = items\n\nclass StringItem:\n    def __init__(self, value: str) -> None:\n        self.value = value\n\nclass QueryString:\n    def __init__(self, value: str) -> None:\n        self.value = value\n\nclass Result:\n    def __init__(self, found: bool) -> None:\n        self.found = found\n\nclass FindSubstringService:\n    def evaluate(self, list_of_strings: list[str], query_string: str) -> Result:\n        if not list_of_strings:\n            return Result(found=False)\n\n        for item_str in list_of_strings:\n            if query_string in item_str:\n                return Result(found=True)\n        return Result(found=False)\n\ndef find_substring(list_of_strings: list[str], query_string: str) -> bool:\n    # Delegates the core logic to the FindSubstringService.\n    service = FindSubstringService()\n    result = service.evaluate(list_of_strings, query_string)\n    return result.found"}
