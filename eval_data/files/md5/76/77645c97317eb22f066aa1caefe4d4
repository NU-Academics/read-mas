{"task_id": "Mbpp/244", "solution": "def next_Perfect_Square(n):\n    \"\"\"\n    Finds the smallest integer perfect square strictly greater than n.\n    Handles negative inputs by returning the smallest non-negative perfect square greater than n.\n    \"\"\"\n    if n < 0:\n        return 0  # Smallest perfect square is 0, which is greater than any negative n.\n\n    # Find the integer square root of n.\n    # We use math.isqrt for robustness and to avoid floating point issues.\n    import math\n    root = math.isqrt(n)\n\n    # If n is already a perfect square, we need the next one.\n    # Otherwise, we need the square of (root + 1).\n    if root * root == n:\n        next_root = root + 1\n    else:\n        next_root = root + 1\n    \n    return next_root * next_root"}
{"task_id": "Mbpp/245", "solution": "def max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Computes the maximum sum of a bitonic subsequence for the given array.\n    A sequence is bitonic if it is first increasing and then decreasing.\n    \"\"\"\n\n    class ArrayInput:\n        \"\"\"Represents ordered input array preserving indices.\"\"\"\n        def __init__(self, elements: list[int]):\n            self.elements = elements\n\n        def __len__(self) -> int:\n            return len(self.elements)\n\n        def __getitem__(self, index: int) -> int:\n            return self.elements[index]\n\n    class Element:\n        \"\"\"Represents a value/index pair.\"\"\"\n        def __init__(self, value: int, index: int):\n            self.value = value\n            self.index = index\n\n    class Subsequence:\n        \"\"\"Represents a subsequence and can compute its sum.\"\"\"\n        def __init__(self, elements: list[Element]):\n            self.elements = elements\n\n        def sum(self) -> int:\n            return sum(e.value for e in self.elements)\n\n    class BitonicSubsequence(Subsequence):\n        \"\"\"Represents a bitonic subsequence and can validate its property.\"\"\"\n        def isBitonic(self) -> bool:\n            if not self.elements:\n                return True\n            \n            n = len(self.elements)\n            # Find the peak element\n            peak_index = 0\n            while peak_index < n - 1 and self.elements[peak_index].value < self.elements[peak_index+1].value:\n                peak_index += 1\n            \n            # Check strictly increasing part\n            for i in range(1, peak_index + 1):\n                if self.elements[i].value <= self.elements[i-1].value:\n                    return False\n            \n            # Check strictly decreasing part\n            for i in range(peak_index + 1, n):\n                if self.elements[i].value >= self.elements[i-1].value:\n                    return False\n            \n            return True\n\n    class Result:\n        \"\"\"Container for the algorithm's maximum sum result.\"\"\"\n        def __init__(self, maxSum: int):\n            self.maxSum = maxSum\n\n    class MaxSumCalculator:\n        \"\"\"Encapsulates the algorithm to compute maximum-sum bitonic subsequence.\"\"\"\n        def max_sum(self, arr_input: ArrayInput) -> int:\n            n = len(arr_input)\n            if n == 0:\n                return 0\n            if n == 1: # A single element is considered bitonic (both inc and dec)\n                return arr_input[0]\n\n            # Compute inc_sum[i]: maximum-sum strictly increasing subsequence ending at index i\n            inc_sum = [0] * n\n            for i in range(n):\n                inc_sum[i] = arr_input[i]\n                for j in range(i):\n                    if arr_input[i] > arr_input[j] and inc_sum[i] < inc_sum[j] + arr_input[i]:\n                        inc_sum[i] = inc_sum[j] + arr_input[i]\n\n            # Compute dec_sum[i]: maximum-sum strictly decreasing subsequence starting at index i\n            dec_sum = [0] * n\n            for i in range(n - 1, -1, -1):\n                dec_sum[i] = arr_input[i]\n                for j in range(n - 1, i, -1):\n                    if arr_input[i] > arr_input[j] and dec_sum[i] < dec_sum[j] + arr_input[i]:\n                        dec_sum[i] = dec_sum[j] + arr_input[i]\n\n            # For each index i, compute candidate = inc_sum[i] + dec_sum[i] - value[i]\n            # (value[i] is subtracted because it's counted in both inc_sum[i] and dec_sum[i])\n            max_overall_sum = -float('inf')\n            for i in range(n):\n                # A valid bitonic subsequence must have at least one increasing and one decreasing part\n                # or just an increasing or just a decreasing part (single element acts as both peak).\n                # To be a valid peak 'i', it must be possible to form both an increasing and decreasing part\n                # (even if one part is just 'i' itself). The check `inc_sum[i] > arr_input[i]` implies there\n                # was a preceding element in the increasing part, and `dec_sum[i] > arr_input[i]` implies\n                # there was a succeeding element in the decreasing part.\n                # If only arr_input[i] is considered for one part, then its sum will be just arr_input[i].\n                # If inc_sum[i] == arr_input[i] and dec_sum[i] == arr_input[i], it means 'i' cannot extend\n                # any increasing or decreasing sequence from prior/after, which means it cannot form a bitonic\n                # sequence of length > 1, unless it's just itself. But the problem implies >1 for a \"sequence\".\n                # The assertion example suggests that inc_sum and dec_sum can be just the element itself.\n                # So we simply check if a bitonic sequence of length >= 1 is possible at index i.\n                # If n is 1, max_overall_sum initialized to -inf would return arr[0] correctly.\n                # If n > 1 and all elements are increasing or decreasing, some intermediate calculations might\n                # lead to a valid bitonic sequence of length 2 or more.\n                \n                # A bitonic subsequence must have at least two elements to be meaningful as \"increasing then decreasing\".\n                # If inc_sum[i] == arr_input[i] AND dec_sum[i] == arr_input[i], it means element i itself\n                # is the entire \"increasing\" part and the entire \"decreasing\" part. Such a sequence has length 1.\n                # If the problem strictly means \"first increasing AND THEN decreasing\" with >1 length,\n                # we would need to filter cases where `inc_sum[i] == arr_input[i]` and `dec_sum[i] == arr_input[i]`.\n                # However, the standard interpretation allows subsequences that are purely increasing or purely decreasing\n                # to be considered bitonic (with peak at end/start respectively), as long as length >= 1.\n                # So, (inc_sum[i] - arr_input[i] + dec_sum[i]) > 0 for a valid sum means length > 1 if sum includes arr_input[i].\n                # Or, if inc_sum[i] == arr_input[i] and dec_sum[i] == arr_input[i], then the sum is arr_input[i].\n                \n                current_sum = inc_sum[i] + dec_sum[i] - arr_input[i]\n                \n                # If the current sum is just the element itself (meaning no valid increasing or decreasing extension),\n                # we only consider it if it's the only element or if it can still form a valid bitonic sequence (length > 1).\n                # A bitonic sequence must have at least two elements, or one element if it is trivially both increasing and decreasing.\n                # The minimum sum is from a single element, which should be included if it's the only option or part of a larger sum.\n                # The problem statement example has a positive sum, so negative intermediate values could be ignored if we want only positive sums.\n                # But typically, it's about max sum, which can be negative if all numbers are negative.\n                \n                # The standard definition of bitonic implies it must be increasing *and* decreasing.\n                # This usually means it must have a length of at least 2.\n                # If inc_sum[i] == arr_input[i] and dec_sum[i] == arr_input[i], it means this element 'i' is not a \"peak\"\n                # in a sequence that has both an increasing part *before* it AND a decreasing part *after* it.\n                # However, a sequence that is purely increasing (with peak at end) or purely decreasing (with peak at start)\n                # is also often considered bitonic.\n                # To ensure we only pick sequences of length >= 1 for each part that contributes:\n                # A sequence of length 1 (arr_input[i]) is formed if inc_sum[i] == arr_input[i] AND dec_sum[i] == arr_input[i].\n                # A bitonic sequence of length 1 is arr_input[i]. Its sum is arr_input[i].\n                # This logic is correct for bitonic sequences of length >= 1.\n                if current_sum > max_overall_sum:\n                    max_overall_sum = current_sum\n            \n            # If all numbers are negative, and max_overall_sum remains -inf or is 0,\n            # we should return the largest single element, or 0 if it must be non-negative.\n            # Assuming it can be negative.\n            # However, `inc_sum` and `dec_sum` calculations naturally handle negative numbers\n            # by potentially only including single numbers or not extending sequences if it reduces sum.\n            \n            # If max_overall_sum is still -inf, it implies an empty array, which is handled at the start.\n            # Or if `n == 0` case. If `n > 0` but `max_overall_sum` is not updated because all `current_sum`\n            # are less than -inf (which is impossible), then we might have an issue.\n            # But `inc_sum[i]` and `dec_sum[i]` are initialized with `arr_input[i]`, so they're at least `arr_input[i]`.\n            # Thus, `current_sum` will be at least `arr_input[i]`. `max_overall_sum` will be at least the maximum single element.\n            return Result(max_overall_sum).maxSum\n\n    array_input_obj = ArrayInput(arr)\n    return MaxSumCalculator().max_sum(array_input_obj)"}
{"task_id": "Mbpp/250", "solution": "class TupleInput:\n    \"\"\"Lightweight wrapper for the input tuple.\"\"\"\n    def __init__(self, elements: tuple):\n        self.elements = elements\n    def get_elements(self) -> tuple:\n        return self.elements\n    def length(self) -> int:\n        return len(self.elements)\n\nclass Element:\n    \"\"\"Wrapper for the target element value.\"\"\"\n    def __init__(self, value):\n        self.value = value\n    def get_value(self):\n        return self.value\n\nclass CountResult:\n    \"\"\"Encapsulate the integer count result.\"\"\"\n    def __init__(self, count: int):\n        self._count = int(count)\n    def get_count(self) -> int:\n        return self._count\n\nclass CountXService:\n    \"\"\"Encapsulates counting logic and input validation.\"\"\"\n    def validate_input(self, input_tuple) -> None:\n        if not isinstance(input_tuple, tuple):\n            raise TypeError(\"first argument must be a tuple\")\n    def count_X(self, input_tuple, element) -> int:\n        self.validate_input(input_tuple)\n        t = TupleInput(input_tuple)\n        e = Element(element)\n        counter = 0\n        for item in t.get_elements():\n            if item == e.get_value():\n                counter += 1\n        result = CountResult(counter)\n        return result.get_count()\n\ndef count_X(tuple, element) -> int:\n    \"\"\"Counts occurrences of an element in a tuple, raising TypeError if the first argument is not a tuple.\"\"\"\n    svc = CountXService()\n    return svc.count_X(tuple, element)"}
{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Finds the length of the longest palindromic subsequence in the given string.\n    The algorithm uses dynamic programming, filling a table where dp[i][j] stores\n    the length of the LPS for the substring s[i..j].\n    \"\"\"\n    class LPSFunction:\n        def lps(self, s: str) -> int:\n            n = len(s)\n            if n == 0:\n                return 0\n\n            # dp[i][j] will store the length of the longest palindromic subsequence\n            # for the substring s[i...j].\n            dp = [[0] * n for _ in range(n)]\n\n            # Base case: Every single character is a palindromic subsequence of length 1.\n            for i in range(n):\n                dp[i][i] = 1\n\n            # Fill the DP table for substrings of length 2 up to n.\n            # `length` is the current length of the substring (j - i + 1).\n            for length in range(2, n + 1):\n                # `i` is the starting index of the current substring.\n                for i in range(n - length + 1):\n                    j = i + length - 1 # `j` is the ending index of the current substring.\n\n                    # If the characters at the ends of the substring match.\n                    if s[i] == s[j]:\n                        # If the substring length is 2, it's just those two characters.\n                        # Otherwise, it's 2 plus the LPS of the inner substring s[i+1...j-1].\n                        dp[i][j] = 2 + (dp[i + 1][j - 1] if length > 2 else 0)\n                    else:\n                        # If the characters don't match, the LPS length is the maximum of:\n                        # 1. LPS of substring s[i+1...j] (excluding s[i])\n                        # 2. LPS of substring s[i...j-1] (excluding s[j])\n                        dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n            \n            # The result is the length of the LPS for the entire string s[0...n-1].\n            return dp[0][n - 1]\n\n    # The public `lps` function instantiates `LPSFunction` and calls its `lps` method.\n    return LPSFunction().lps(s)"}
{"task_id": "Mbpp/251", "solution": "def insert_element(input_list, element):\n    \"\"\"\n    Inserts an element before each element in the input list.\n    Returns a new list with the inserted elements.\n    \"\"\"\n    result = []\n    for item in input_list:\n        result.append(element)\n        result.append(item)\n    return result"}
{"task_id": "Mbpp/252", "solution": "def convert(value: Union[complex, int, float]) -> Tuple[float, float]:\n    \"\"\"Converts a numeric input (complex, int, float) into polar coordinates.\n    Returns (r, theta) as a tuple of floats.\n    \"\"\"\n    import math\n    from typing import Tuple, Union\n\n    def _normalize_input(val: Union[complex, int, float]) -> Tuple[float, float]:\n        \"\"\"Normalizes input to (real: float, imag: float).\"\"\"\n        if isinstance(val, complex):\n            return (float(val.real), float(val.imag))\n        else:\n            return (float(val), 0.0)\n\n    def _compute_magnitude(real_val: float, imag_val: float) -> float:\n        \"\"\"Computes r = sqrt(real^2 + imag^2).\"\"\"\n        return float(math.sqrt(real_val * real_val + imag_val * imag_val))\n\n    def _compute_angle(real_val: float, imag_val: float) -> float:\n        \"\"\"Computes theta = atan2(imag, real) in radians.\"\"\"\n        return float(math.atan2(imag_val, real_val))\n\n    real, imag = _normalize_input(value)\n    r = _compute_magnitude(real, imag)\n    theta = _compute_angle(real, imag)\n    return (r, theta)"}
