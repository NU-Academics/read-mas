{"task_id": "Mbpp/56", "solution": "def check(n: int) -> bool:\n    \"\"\"Return True iff n == 2 * reverse(n) - 1; otherwise False.\"\"\"\n\n    def reverse(number: int) -> int:\n        \"\"\"Compute decimal-digit reversal of integer number; drop leading zeros of reversed representation.\"\"\"\n        if number == 0:\n            return 0\n        \n        abs_n_str = str(abs(number))\n        reversed_str = abs_n_str[::-1]\n        return int(reversed_str)\n\n    reversed_n = reverse(n)\n    return n == 2 * reversed_n - 1"}
{"task_id": "Mbpp/18", "solution": "def _build_char_set(chars_to_remove: str) -> set[str]:\n    \"\"\"Builds a set of characters to be removed.\"\"\"\n    return set(chars_to_remove)\n\ndef _filter_string(first_string: str, char_set: set[str]) -> str:\n    \"\"\"Filters the first string, removing characters present in the set.\"\"\"\n    result_chars = []\n    for char in first_string:\n        if char not in char_set:\n            result_chars.append(char)\n    return \"\".join(result_chars)\n\ndef remove_dirty_chars(first_string: str, chars_to_remove: str) -> str:\n    \"\"\"\n    Removes characters from the first string which are present in the second string.\n    \"\"\"\n    char_set = _build_char_set(chars_to_remove)\n    result = _filter_string(first_string, char_set)\n    return result"}
{"task_id": "Mbpp/58", "solution": "class IntegerPair:\n    \"\"\"Holds a pair of integers.\"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n\nclass FunctionResult:\n    \"\"\"Holds the boolean result of an operation.\"\"\"\n    def __init__(self, result: bool) -> None:\n        self.result = result\n\nclass OppositeSignChecker:\n    \"\"\"Service to evaluate if two integers have opposite signs.\"\"\"\n    @staticmethod\n    def evaluate(pair: IntegerPair) -> FunctionResult:\n        \"\"\"Determines if the integers in the pair have opposite signs.\"\"\"\n        if (pair.a > 0 and pair.b < 0) or (pair.a < 0 and pair.b > 0):\n            return FunctionResult(True)\n        else:\n            return FunctionResult(False)\n\ndef opposite_Signs(a: int, b: int) -> bool:\n    \"\"\"\n    Checks whether two given integers have opposite signs.\n    Zero is treated as neither positive nor negative.\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"Both inputs must be integers.\")\n\n    pair = IntegerPair(a, b)\n    result_obj = OppositeSignChecker.evaluate(pair)\n    return result_obj.result"}
{"task_id": "Mbpp/57", "solution": "from typing import List\n\nclass Digit:\n    \"\"\"Represents a single digit, validating its range.\"\"\"\n    def __init__(self, value: int) -> None:\n        if not isinstance(value, int) or not (0 <= value <= 9):\n            raise ValueError(\"Each digit must be an integer between 0 and 9.\")\n        self.value = value\n\nclass DigitList:\n    \"\"\"Manages a list of digit values.\"\"\"\n    def __init__(self, digits_values: List[int]) -> None:\n        self.digits = digits_values\n\n    def length(self) -> int:\n        return len(self.digits)\n\nclass NumberResult:\n    \"\"\"Holds the final integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def to_int(self) -> int:\n        return self.value\n\ndef validate_digits(digits: List[int]) -> bool:\n    \"\"\"Validates that the input is a list of integers between 0 and 9.\"\"\"\n    if not isinstance(digits, list):\n        raise ValueError(\"Input must be a list of digits.\")\n    for digit in digits:\n        if not isinstance(digit, int):\n            raise ValueError(\"All elements in the list must be integers.\")\n        if not (0 <= digit <= 9):\n            raise ValueError(\"Each digit must be between 0 and 9.\")\n    return True\n\ndef arrange_descending(digits: List[int]) -> List[int]:\n    \"\"\"Sorts a list of digits in descending order without mutation.\"\"\"\n    return sorted(digits, reverse=True)\n\ndef find_Max_Num(digits: List[int]) -> int:\n    \"\"\"\n    Finds the largest number that can be formed with the given list of digits.\n    assert find_Max_Num([1,2,3]) == 321\n    \"\"\"\n    validate_digits(digits)\n\n    if not digits:\n        return 0\n\n    arranged_digits = arrange_descending(digits)\n    number_str = \"\".join(str(d) for d in arranged_digits)\n    \n    result_int = int(number_str)\n    \n    number_result = NumberResult(result_int)\n    return number_result.to_int()"}
