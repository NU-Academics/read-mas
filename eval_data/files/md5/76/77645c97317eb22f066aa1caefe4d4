{"task_id": "Mbpp/6", "solution": "def _xor(a: int, b: int) -> int:\n    \"\"\"Computes the bitwise exclusive OR of two integers.\"\"\"\n    return a ^ b\n\ndef _count_set_bits(x: int) -> int:\n    \"\"\"Counts the number of set bits (1s) in an integer.\n    For negative integers, it counts bits in the positive representation equivalent to abs(x) within its bit_length.\"\"\"\n    count = 0\n    if x < 0:\n        # Mask negative numbers to their positive equivalent within their bit_length for counting.\n        x = x & ((1 << x.bit_length()) - 1)\n    \n    while x > 0:\n        x &= (x - 1) # Brian Kernighan's algorithm\n        count += 1\n    return count\n\ndef differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"Checks if two integers differ at exactly one bit position.\n    This is determined by computing their XOR and counting the set bits in the result.\"\"\"\n    \n    xor_result = _xor(a, b)\n    set_bit_count = _count_set_bits(xor_result)\n    \n    return set_bit_count == 1"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_str, char):\n    \"\"\"Removes the first and last occurrences of a given character from the string.\n    Returns a new string with the specified characters removed.\"\"\"\n    if not input_str:\n        return \"\"\n\n    first_idx = input_str.find(char)\n\n    if first_idx == -1:\n        return input_str\n\n    last_idx = input_str.rfind(char)\n\n    if first_idx == last_idx:\n        # Only one occurrence\n        return input_str[:first_idx] + input_str[first_idx+1:]\n    else:\n        # Multiple occurrences, remove first and last\n        return input_str[:first_idx] + input_str[first_idx+1:last_idx] + input_str[last_idx+1:]"}
{"task_id": "Mbpp/2", "solution": "from typing import Iterable, Any, List\n\ndef _is_iterable(obj: Any) -> bool:\n    \"\"\"Return True if obj is iterable.\n    Used for input validation.\n    \"\"\"\n    return isinstance(obj, Iterable)\n\ndef _contains_by_equality(collection: List[Any], item: Any) -> bool:\n    \"\"\"Check if an item is in a collection using equality comparison (==).\n    Supports unhashable elements.\n    \"\"\"\n    for existing_item in collection:\n        if existing_item == item:\n            return True\n    return False\n\ndef _unique_by_equality(iterable: Iterable[Any]) -> List[Any]:\n    \"\"\"Return a list of items deduplicated by equality preserving first-seen order.\n    Supports unhashable elements.\n    \"\"\"\n    unique_items: List[Any] = []\n    for item in iterable:\n        if not _contains_by_equality(unique_items, item):\n            unique_items.append(item)\n    return unique_items\n\ndef similar_elements(a: Iterable[Any], b: Iterable[Any]) -> List[Any]:\n    \"\"\"Compute shared elements between iterables a and b.\n\n    Precondition: a and b are iterables; if not, raise TypeError.\n    The returned collection is a concrete Python list of unique elements\n    (deduplicated by equality) preserving an implementation-determined order.\n    set(returned_list) must equal the intersection set of elements from a and b,\n    supporting unhashable elements by performing equality comparisons.\n    \"\"\"\n    if not _is_iterable(a):\n        raise TypeError(\"Input 'a' must be an iterable.\")\n    if not _is_iterable(b):\n        raise TypeError(\"Input 'b' must be an iterable.\")\n\n    unique_a = _unique_by_equality(a)\n    unique_b = _unique_by_equality(b)\n\n    result_elements: List[Any] = []\n    for item_a in unique_a:\n        if _contains_by_equality(unique_b, item_a):\n            if not _contains_by_equality(result_elements, item_a):\n                result_elements.append(item_a)\n\n    return result_elements"}
{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef heap_queue_largest(numbers: list[int], n: int) -> list[int]:\n    \"\"\"\n    Finds the n largest integers from a list using a min-heap and returns them in descending order.\n    Duplicates are preserved as separate entries.\n    \"\"\"\n    if n <= 0:\n        return []\n\n    min_heap = []\n    for num in numbers:\n        heapq.heappush(min_heap, num)\n        if len(min_heap) > n:\n            heapq.heappop(min_heap)\n    \n    # The heap now contains the n largest elements (or fewer if len(numbers) < n).\n    # Popping them gives them in ascending order.\n    result = [heapq.heappop(min_heap) for _ in range(len(min_heap))]\n    \n    # Reverse to get descending order as required.\n    return result[::-1]"}
{"task_id": "Mbpp/16", "solution": "import re\nfrom typing import Pattern as RePattern, Optional\n\nclass Pattern:\n    \"\"\"Encapsulates a regular expression pattern and provides a method for matching strings.\"\"\"\n    regex: str = \"^[a-z]+_[a-z]+$\"\n    _compiled: RePattern\n\n    def __init__(self, regex: Optional[str] = None) -> None:\n        \"\"\"Initializes the Pattern with a given regex or the default anchored pattern.\"\"\"\n        self._compiled = re.compile(regex if regex is not None else self.regex)\n\n    def matches(self, input_string: str) -> bool:\n        \"\"\"Returns True if the input string exactly matches the compiled pattern, otherwise False.\"\"\"\n        return self._compiled.fullmatch(input_string) is not None\n\nPATTERN = Pattern()\n\ndef text_lowercase_underscore(input_string: str) -> bool:\n    \"\"\"\n    Returns true if the input string contains sequences of lowercase letters \n    joined with an underscore and false otherwise.\n    \"\"\"\n    return PATTERN.matches(input_string)"}
{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix):\n    \"\"\"Sort rows of matrix (list-of-lists) in ascending order by row sums.\n    Stable; preserves element order inside each row.\n    \"\"\"\n\n    def _validate_matrix(m):\n        if not isinstance(m, list):\n            raise TypeError(\"Matrix must be a list of lists.\")\n        for row in m:\n            if not isinstance(row, list):\n                raise TypeError(\"Each row in the matrix must be a list.\")\n            for element in row:\n                if not isinstance(element, (int, float)):\n                    raise ValueError(\"All elements in the matrix must be numeric (int or float).\")\n\n    def _row_sum(row):\n        return float(sum(row))\n\n    _validate_matrix(matrix)\n\n    # Enumerate rows to preserve original order for stability in case of equal sums,\n    # though Python's Timsort is stable by default.\n    # The key for sorting will be the sum of each row.\n    rows_with_sums = []\n    for i, row in enumerate(matrix):\n        rows_with_sums.append((_row_sum(row), i, row))\n\n    # Sort based on the row sum. Python's sort is stable, so original index (i)\n    # is a secondary sort key if explicitly needed, but not strictly required\n    # for stability here, as the default sort is stable.\n    rows_with_sums.sort(key=lambda x: x[0])\n\n    # Extract the original rows in the new sorted order\n    sorted_matrix = [row_info[2] for row_info in rows_with_sums]\n\n    return sorted_matrix"}
{"task_id": "Mbpp/17", "solution": "def square_perimeter(side_length):\n    \"\"\"\n    Returns the perimeter of a square given its side length.\n    This implementation delegates computation to internal helper classes as per design guidance.\n    \"\"\"\n\n    class Square:\n        def __init__(self, sideLength) -> None:\n            self.sideLength = sideLength\n            self.perimeter = 0\n\n        def computePerimeter(self):\n            self.perimeter = 4 * self.sideLength\n            return self.perimeter\n\n    class SquarePerimeterFunction:\n        def compute(self, sideLength):\n            square = Square(sideLength)\n            return square.computePerimeter()\n\n    # The public API delegates to SquarePerimeterFunction.\n    spf = SquarePerimeterFunction()\n    return spf.compute(side_length)"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number) -> bool:\n    \"\"\"Checks if a given number is a Woodall number by validating input and searching for a witness k.\n    A number is Woodall if it equals k * 2^k - 1 for some integer k >= 1.\n    \"\"\"\n\n    class InputValidator:\n        def is_valid(self, input_val) -> bool:\n            # Validates if the input is an integer and is greater than or equal to 1.\n            return isinstance(input_val, int) and input_val >= 1\n\n    class WoodallChecker:\n        def _find_k(self, num_to_check: int):\n            # Searches for a witness k such that num_to_check = k * 2^k - 1.\n            # The search terminates when k * 2^k - 1 exceeds num_to_check.\n            k = 1\n            while True:\n                value = k * (1 << k) - 1\n                if value == num_to_check:\n                    return k\n                if value > num_to_check:\n                    return None\n                k += 1\n\n        def is_woodall(self, num_to_check: int) -> bool:\n            # Determines if the number is a Woodall number by finding a witness k.\n            return self._find_k(num_to_check) is not None\n\n    validator = InputValidator()\n    if not validator.is_valid(number):\n        return False\n    checker = WoodallChecker()\n    return checker.is_woodall(int(number))"}
{"task_id": "Mbpp/19", "solution": "from typing import List\n\ndef test_duplicate(array: List[int]) -> bool:\n    \"\"\"\n    Checks if the given array of integers contains any duplicate element.\n    Uses a set to track seen elements for efficient duplicate detection.\n    \"\"\"\n    seen = set()\n    for element in array:\n        if element in seen:\n            return True\n        seen.add(element)\n    return False"}
