{"task_id": "Mbpp/237", "solution": "class InputValidator:\n    \"\"\"Validates input items to ensure they are 2-element tuples.\"\"\"\n    def validate_item(self, item):\n        \"\"\"Checks if an item is a 2-element tuple. Raises TypeError if invalid.\"\"\"\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise TypeError(\"Each item must be a 2-element tuple.\")\n\nclass TupleNormalizer:\n    \"\"\"Normalizes a 2-element tuple to a canonical ascending-order tuple.\"\"\"\n    def normalize(self, item):\n        \"\"\"Returns a new tuple with elements sorted in ascending order.\"\"\"\n        return tuple(sorted(item))\n\nclass CountAggregator:\n    \"\"\"Aggregates counts of normalized tuples and provides the final dictionary.\"\"\"\n    def __init__(self):\n        \"\"\"Initializes the internal counts dictionary.\"\"\"\n        self._counts = {}\n\n    def increment(self, normalized_tuple):\n        \"\"\"Increments the count for a given normalized tuple.\"\"\"\n        self._counts[normalized_tuple] = self._counts.get(normalized_tuple, 0) + 1\n\n    def to_dict(self):\n        \"\"\"Returns a copy of the aggregated counts dictionary.\"\"\"\n        return self._counts.copy()\n\nclass OccurrenceCounter:\n    \"\"\"Orchestrates validation, normalization, and aggregation of tuple occurrences.\"\"\"\n    def __init__(self):\n        \"\"\"Initializes the components used for processing.\"\"\"\n        self._validator = InputValidator()\n        self._normalizer = TupleNormalizer()\n        self._aggregator = CountAggregator()\n\n    def check_occurences(self, list_of_tuples):\n        \"\"\"Processes a list of tuples to count occurrences of normalized pairs.\"\"\"\n        for item in list_of_tuples:\n            self._validator.validate_item(item)\n            normalized_tuple = self._normalizer.normalize(item)\n            self._aggregator.increment(normalized_tuple)\n        return self._aggregator.to_dict()\n\ndef check_occurences(list_of_tuples):\n    \"\"\"\n    Takes a list of tuples and returns a dictionary mapping each unique normalized\n    tuple to its occurrence count.\n    \"\"\"\n    counter = OccurrenceCounter()\n    return counter.check_occurences(list_of_tuples)"}
