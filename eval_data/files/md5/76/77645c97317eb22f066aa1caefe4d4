{"task_id": "Mbpp/446", "solution": "class TupleInput:\n    \"\"\"Holds and implicitly assumes a tuple input.\"\"\"\n    def __init__(self, items: tuple):\n        self._items = items\n\n    def validate(self) -> bool:\n        \"\"\"Always returns True, as explicit type validation is not performed here.\"\"\"\n        return True\n\nclass ListInput:\n    \"\"\"Holds and implicitly assumes a list input.\"\"\"\n    def __init__(self, items: list):\n        self._items = items\n\n    def validate(self) -> bool:\n        \"\"\"Always returns True, as explicit type validation is not performed here.\"\"\"\n        return True\n\nclass OccurrenceResult:\n    \"\"\"Encapsulates the integer count result.\"\"\"\n    def __init__(self, count: int):\n        self._count = count\n\n    def to_int(self) -> int:\n        \"\"\"Returns the encapsulated count as an integer.\"\"\"\n        return self._count\n\nclass OccurrenceCounter:\n    \"\"\"Core counting service to find occurrences.\"\"\"\n    def count_Occurrence(self, t: tuple, l: list) -> int:\n        \"\"\"Counts occurrences of elements from list l in tuple t.\"\"\"\n        count = 0\n        for item_t in t:\n            if item_t in l:\n                count += 1\n        return OccurrenceResult(count).to_int()\n\ndef count_Occurrence(t: tuple, l: list) -> int:\n    \"\"\"\n    Counts the occurrences of all elements of list in a tuple.\n    Assumes t is a tuple and l is a list, following strict output constraints.\n    \"\"\"\n    # Per design, instantiate input objects, though explicit type validation is omitted here.\n    _ = TupleInput(t)\n    _ = ListInput(l)\n\n    counter = OccurrenceCounter()\n    final_count = counter.count_Occurrence(t, l)\n\n    return final_count"}
{"task_id": "Mbpp/448", "solution": "class PerrinCalculator:\n    \"\"\"\n    A helper class to compute Perrin numbers efficiently using memoization.\n    It pre-populates initial Perrin numbers and iteratively computes others.\n    \"\"\"\n    def __init__(self):\n        self._memo = {\n            0: 3,\n            1: 0,\n            2: 2\n        }\n\n    def computePerrin(self, k: int) -> int:\n        \"\"\"\n        Computes the k-th Perrin number.\n        Perrin numbers are P(0)=3, P(1)=0, P(2)=2, and P(k) = P(k-2) + P(k-3) for k >= 3.\n        \"\"\"\n        if k < 0:\n            # This case is handled by cal_sum's input validation for 'n',\n            # but computePerrin itself should not be called with negative k.\n            raise ValueError(\"Perrin number index must be non-negative.\")\n\n        if k in self._memo:\n            return self._memo[k]\n\n        # Calculate iteratively from the last known value up to k\n        for i in range(max(3, len(self._memo)), k + 1):\n            self._memo[i] = self._memo[i - 2] + self._memo[i - 3]\n\n        return self._memo[k]\n\ndef cal_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) to P(n).\n    It validates the input 'n' and uses a PerrinCalculator for computation.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    calculator = PerrinCalculator()\n    total_sum = 0\n    for k in range(n + 1):\n        total_sum += calculator.computePerrin(k)\n    return total_sum"}
{"task_id": "Mbpp/453", "solution": "from typing import List\n\nclass Factor:\n    \"\"\"Represents a single factor of a number.\n    Provides a method to check if its value is even.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the factor's value is even.\"\"\"\n        return self.value % 2 == 0\n\nclass IntegerNumber:\n    \"\"\"Represents an integer and provides methods to find its divisors.\n    Divisors are returned as a list of Factor objects.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def getDivisors(self) -> List[\"Factor\"]:\n        \"\"\"Calculates and returns all positive divisors as Factor objects.\"\"\"\n        divisors = set()\n        if self.value == 0:\n            return []\n        \n        limit = int(self.value**0.5) + 1\n        for i in range(1, limit):\n            if self.value % i == 0:\n                divisors.add(i)\n                divisors.add(self.value // i)\n        \n        return [Factor(d) for d in sorted(list(divisors))]\n\nclass CalculationResult:\n    \"\"\"A simple data transfer object to hold the computed sum.\n    Encapsulates the final sum of even factors.\n    \"\"\"\n    def __init__(self, sum_val: int) -> None:\n        self.sum = sum_val\n\nclass SumCalculator:\n    \"\"\"Orchestrates the calculation of the sum of even factors.\n    Delegates to IntegerNumber for factor enumeration and filters using Factor.isEven().\n    \"\"\"\n    def sumofFactors(self, n: int) -> int:\n        \"\"\"\n        Calculates the sum of even factors for a given number n.\n        It uses IntegerNumber to get divisors and Factor to check parity.\n        \"\"\"\n        integer_number = IntegerNumber(n)\n        factors = integer_number.getDivisors()\n        \n        total_even_factors_sum = 0\n        for factor in factors:\n            if factor.isEven():\n                total_even_factors_sum += factor.value\n        \n        result = CalculationResult(total_even_factors_sum)\n        return result.sum\n\ndef sumofFactors(n: int) -> int:\n    \"\"\"\n    Computes and returns the sum of even factors of a number.\n    This is the public API function, delegating the core logic to SumCalculator.\n    \"\"\"\n    calculator = SumCalculator()\n    return calculator.sumofFactors(n)"}
{"task_id": "Mbpp/451", "solution": "def remove_whitespaces(input: str) -> str:\n    \"\"\"Removes all specified whitespace characters from the input string.\"\"\"\n    result_chars = []\n    whitespace_to_remove = ' \\t\\n\\r'\n    for char in input:\n        if char not in whitespace_to_remove:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/447", "solution": "def _validate_input(input_list):\n    \"\"\"\n    Validates that the input is a list and all its elements are numbers (int or float).\n    Raises TypeError if validation fails.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n    for element in input_list:\n        if not isinstance(element, (int, float)):\n            raise TypeError(\"All elements in the list must be numbers (int or float).\")\n\ndef cube_nums(input_list):\n    \"\"\"\n    Finds cubes of individual elements in a list.\n\n    This function validates the input, computes the cube of each numeric element,\n    and returns a new list containing the results while preserving order.\n    \"\"\"\n    _validate_input(input_list)\n    \n    cubed_list = []\n    for num in input_list:\n        cubed_list.append(num ** 3)\n    return cubed_list"}
{"task_id": "Mbpp/455", "solution": "def check_monthnumb_number(month: int) -> bool:\n    \"\"\"Checks if the given month number corresponds to a month with 31 days.\n    Returns True for months 1, 3, 5, 7, 8, 10, 12, False otherwise.\n    \"\"\"\n    _MONTHS_WITH_31_DAYS = {1, 3, 5, 7, 8, 10, 12}\n    return month in _MONTHS_WITH_31_DAYS"}
{"task_id": "Mbpp/454", "solution": "def _is_letter(char: str) -> bool:\n    \"\"\"Checks if a character is an ASCII letter.\"\"\"\n    return ('A' <= char <= 'Z') or ('a' <= char <= 'z')\n\nclass Word:\n    \"\"\"Represents a word extracted from text.\"\"\"\n    def __init__(self, text: str, startIndex: int, endIndex: int):\n        self.text = text\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n        self.contains_z = ('z' in text)\n\n    def hasZ(self) -> bool:\n        \"\"\"Returns True if the word contains 'z'.\"\"\"\n        return self.contains_z\n\nclass Matcher:\n    \"\"\"Handles tokenization and 'z' matching logic.\"\"\"\n    def tokenize(self, text: str) -> list[Word]:\n        \"\"\"Scans text to create a list of Word objects.\"\"\"\n        words = []\n        current_word_start = -1\n        \n        for i, char in enumerate(text):\n            if _is_letter(char):\n                if current_word_start == -1:\n                    current_word_start = i\n            else: # Not a letter\n                if current_word_start != -1:\n                    word_text = text[current_word_start:i]\n                    words.append(Word(word_text, current_word_start, i))\n                    current_word_start = -1\n        \n        # Add the last word if text ends with a letter\n        if current_word_start != -1:\n            word_text = text[current_word_start:len(text)]\n            words.append(Word(word_text, current_word_start, len(text)))\n            \n        return words\n\n    def text_match_wordz(self, text: str) -> bool:\n        \"\"\"Matches a word containing 'z' within the given text.\"\"\"\n        # The design context explicitly states to include this defensive check.\n        if not isinstance(text, str):\n            raise TypeError(\"Input must be a string.\")\n\n        words = self.tokenize(text)\n        for word in words:\n            if word.hasZ():\n                return True\n        return False\n\ndef text_match_wordz(text) -> bool:\n    \"\"\"Checks if the input text contains at least one word with 'z'.\"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n\n    matcher = Matcher()\n    return matcher.text_match_wordz(text)"}
{"task_id": "Mbpp/460", "solution": "def Extract(inputList: list) -> list:\n    \"\"\"Return a list containing the first element (index 0) of each sublist in inputList, preserving input order.\"\"\"\n    return [sublist[0] for sublist in inputList]"}
{"task_id": "Mbpp/457", "solution": "def Find_Min(sublists):\n    \"\"\"\n    Finds the sublist with the minimum length from a list of sublists.\n    Raises ValueError if the input list is empty or TypeError for invalid elements.\n    \"\"\"\n    if not sublists:\n        raise ValueError(\"Input list 'sublists' cannot be empty.\")\n\n    min_sublist = None\n    min_length = float('inf')\n\n    for sublist in sublists:\n        try:\n            current_length = len(sublist)\n        except TypeError:\n            raise TypeError(f\"Sublist element '{sublist}' does not support len().\")\n\n        if current_length < min_length:\n            min_length = current_length\n            min_sublist = sublist\n            \n    return min_sublist"}
{"task_id": "Mbpp/456", "solution": "def reverse_string_list(input: List[str]) -> List[str]:\n    \"\"\"\n    Reverses each string in the given list of string values.\n    \"\"\"\n    reversed_items = []\n    for item in input:\n        reversed_items.append(item[::-1])\n    return reversed_items"}
{"task_id": "Mbpp/459", "solution": "def remove_uppercase(input_string: str) -> str:\n    \"\"\"\n    Removes all uppercase characters from the input string, preserving the order of other characters.\n    Uses str.isupper() for character classification.\n    \"\"\"\n    result_chars = []\n    for char in input_string:\n        if not char.isupper():\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/458", "solution": "class Validator:\n    \"\"\"Provides utility for validating numeric values.\"\"\"\n    def isNumeric(self, value) -> bool:\n        \"\"\"Checks if the given value is an integer or a float.\"\"\"\n        return isinstance(value, (int, float))\n\nclass Rectangle:\n    \"\"\"Represents a rectangle with methods to compute its area.\"\"\"\n    def __init__(self, width: float, height: float) -> None:\n        self.width = width\n        self.height = height\n        self.area = None\n\n    def computeArea(self) -> float:\n        \"\"\"Calculates and returns the area of the rectangle.\"\"\"\n        self.area = self.width * self.height\n        return self.area\n\nclass RectangleCalculator:\n    \"\"\"Orchestrates validation and area computation for rectangles.\"\"\"\n    def __init__(self, validator: Validator = None) -> None:\n        self.validator = validator if validator is not None else Validator()\n\n    def validateNumeric(self, width, height) -> bool:\n        \"\"\"Validates if both width and height are numeric.\"\"\"\n        return self.validator.isNumeric(width) and self.validator.isNumeric(height)\n\n    def rectangle_area(self, width, height) -> float:\n        \"\"\"Computes the area of a rectangle after validating inputs.\"\"\"\n        if not self.validateNumeric(width, height):\n            raise TypeError(\"Width and height must be numeric values (int or float).\")\n        \n        rect = Rectangle(width, height)\n        return rect.computeArea()\n\ndef rectangle_area(width, height) -> float:\n    \"\"\"Calculates the area of a rectangle given its width and height.\"\"\"\n    calc = RectangleCalculator()\n    return calc.rectangle_area(width, height)"}
{"task_id": "Mbpp/463", "solution": "class ArrayInput:\n    \"\"\"Domain representation of input arrays, holding values and derived length.\"\"\"\n    def __init__(self, values: list) -> None:\n        self.values = values\n        self.length = len(values)\n\nclass InputValidator:\n    \"\"\"Validates ArrayInput instances according to specified rules.\"\"\"\n    def __init__(self) -> None:\n        self.errorMessage: str = \"\"\n\n    def isValid(self, arrayInput: ArrayInput) -> bool:\n        \"\"\"Checks if the array input is valid (non-empty, all integers).\"\"\"\n        if not arrayInput.values:\n            self.errorMessage = \"Input array cannot be empty.\"\n            return False\n        for element in arrayInput.values:\n            if not isinstance(element, int):\n                self.errorMessage = \"All elements in the array must be integers.\"\n                return False\n        self.errorMessage = \"\"\n        return True\n\nclass MaxProductEngine:\n    \"\"\"Computes the maximum product of any contiguous subarray using an O(n) algorithm.\"\"\"\n    def computeMaxProduct(self, arrayInput: ArrayInput) -> int:\n        \"\"\"Calculates the maximum product subarray from the given ArrayInput.\"\"\"\n        nums = arrayInput.values\n        \n        max_so_far = nums[0]\n        current_max_prod = nums[0]\n        current_min_prod = nums[0]\n\n        for i in range(1, len(nums)):\n            num = nums[i]\n            \n            # Store current_max_prod before it's updated, needed for current_min_prod calculation\n            temp_current_max_prod = current_max_prod\n            \n            current_max_prod = max(num, current_max_prod * num, current_min_prod * num)\n            current_min_prod = min(num, temp_current_max_prod * num, current_min_prod * num)\n            \n            max_so_far = max(max_so_far, current_max_prod)\n        \n        return max_so_far\n\nclass ProductResult:\n    \"\"\"Value object for encapsulating the integer product result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\ndef max_subarray_product(array: list) -> int:\n    \"\"\"\n    Finds the maximum product subarray of the given array.\n    Handles input validation and delegates computation to an O(n) engine.\n    \"\"\"\n    if array is None:\n        raise ValueError(\"Input array cannot be None.\")\n    if not isinstance(array, list):\n        raise ValueError(\"Input array must be a list of integers.\")\n\n    array_input = ArrayInput(array)\n    validator = InputValidator()\n\n    if not validator.isValid(array_input):\n        raise ValueError(validator.errorMessage)\n\n    engine = MaxProductEngine()\n    max_product_value = engine.computeMaxProduct(array_input)\n    \n    product_result = ProductResult(max_product_value)\n    return product_result.value"}
{"task_id": "Mbpp/465", "solution": "def drop_empty(input_dict):\n    \"\"\"Accepts a single dictionary argument and returns a dictionary with None-valued entries removed.\"\"\"\n    return {k: v for k, v in input_dict.items() if v is not None}"}
{"task_id": "Mbpp/462", "solution": "def combinations_list(input_list):\n    \"\"\"Return a list of lists representing all combinations of input_list.\n\n    Args:\n        input_list: Python list of elements.\n\n    Returns:\n        List of lists, length 2**len(input_list), ordered by k from 0..2^n-1 where inclusion of input_list[i] is determined by the i-th bit of k and inner lists list elements in descending input index order.\n    \"\"\"\n\n    def _build_combination(k, input_list, n):\n        \"\"\"Return a single combination list for integer k by testing bits and appending elements in descending index order.\"\"\"\n        current_combination = []\n        # Iterate from highest index down to 0 to ensure descending order within combinations\n        for i in range(n - 1, -1, -1):\n            # Check if the i-th bit of k is set\n            if (k >> i) & 1:\n                current_combination.append(input_list[i])\n        return current_combination\n\n    n = len(input_list)\n    num_combinations = 1 << n  # This is 2^n\n    all_combinations = []\n\n    # Iterate k from 0 to 2^n - 1 to get all combinations in the specified order\n    for k in range(num_combinations):\n        combination = _build_combination(k, input_list, n)\n        all_combinations.append(combination)\n\n    return all_combinations"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"Compute pairwise sums of neighboring elements in a tuple.\n    Returns an empty tuple if the input has fewer than two elements.\"\"\"\n    n = len(input_tuple)\n    if n < 2:\n        return ()\n    \n    result = []\n    for i in range(n - 1):\n        result.append(input_tuple[i] + input_tuple[i+1])\n        \n    return tuple(result)"}
{"task_id": "Mbpp/474", "solution": "def replace_char(original: str, target: str, replacement: str) -> str:\n    \"Replace every occurrence of target with replacement in original and return the result.\"\n    return original.replace(target, replacement)"}
{"task_id": "Mbpp/471", "solution": "def _validate_inputs(array, n):\n    \"\"\"Internal: validate types and modulus positivity; raises on violation.\"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Modulus n must be a positive integer.\")\n    \n    if not hasattr(array, '__iter__'):\n        raise TypeError(\"Input 'array' must be an iterable.\")\n\n    for element in array:\n        if not isinstance(element, int):\n            raise TypeError(\"All elements in the array must be integers.\")\n\ndef _compute_product_modulo(array, n):\n    \"\"\"Internal: compute product modulo n; returns int remainder.\"\"\"\n    product = 1\n    for element in array:\n        product = (product * element) % n\n    return product\n\ndef find_remainder(array, n):\n    \"\"\"Compute (product of array elements) % n.\n\n    Parameters:\n      array: list or iterable of integers\n      n: integer modulus (must be > 0)\n\n    Returns:\n      int: remainder in range 0..n-1\n\n    Raises:\n      TypeError: if any element in array is not an int\n      ValueError: if n <= 0\n    \"\"\"\n    _validate_inputs(array, n)\n    return _compute_product_modulo(array, n)"}
{"task_id": "Mbpp/473", "solution": "from typing import List, Tuple, Set\n\ndef tuple_intersection(list1: List[Tuple], list2: List[Tuple]) -> Set[Tuple]:\n    \"\"\"\n    Finds the tuple intersection of elements in the given tuple lists,\n    irrespective of their order, returning elements from list1.\n    \"\"\"\n    def normalize(t: Tuple) -> Tuple:\n        \"\"\"Produces a canonical, hashable TupleKey by sorting elements.\"\"\"\n        return tuple(sorted(t))\n\n    set2_keys = {normalize(t) for t in list2}\n    result: Set[Tuple] = set()\n    for t in list1:\n        if normalize(t) in set2_keys:\n            result.add(t)\n    return result"}
{"task_id": "Mbpp/468", "solution": "from typing import List\n\ndef max_product(numbers: List[float]) -> float:\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence.\n\n    This function uses a dynamic programming approach to calculate the maximum product\n    of a strictly increasing subsequence, preserving original index ordering.\n    \"\"\"\n    n = len(numbers)\n\n    if n == 0:\n        return 0.0\n\n    # best_product[i] stores the maximum product of an increasing subsequence\n    # ending at index i.\n    best_product = list(numbers) # Initialize with each number as a subsequence of length 1\n\n    # max_overall_product tracks the global maximum product found across all subsequences.\n    # Initialize with the largest single number if all numbers are non-positive,\n    # or the max of single elements.\n    max_overall_product = float('-inf') if any(num < 0 for num in numbers) else 0.0\n    if n > 0:\n        max_overall_product = max(best_product)\n\n    for i in range(n):\n        for j in range(i):\n            # If numbers[j] can precede numbers[i] in an increasing subsequence\n            if numbers[j] < numbers[i]:\n                # Calculate a candidate product by extending the subsequence ending at j\n                candidate_product = best_product[j] * numbers[i]\n\n                # Update best_product[i] if a larger product is found\n                if candidate_product > best_product[i]:\n                    best_product[i] = candidate_product\n        \n        # Update the overall maximum product after considering all subsequences ending at i\n        max_overall_product = max(max_overall_product, best_product[i])\n\n    # If all numbers were negative and no positive product was found,\n    # the max_overall_product might still be negative (e.g., -5 for input [-5]).\n    # We should return the single largest element product if no increasing product is positive.\n    # However, if initialized with 0.0 and numbers contain only negatives resulting in negative products,\n    # 0.0 would be returned. The design states `max_overall_product` to track max.\n    # The initialization of `max_overall_product` to `max(best_product)` after `best_product` is initialized\n    # correctly handles single negative elements being the maximum.\n\n    return float(max_overall_product)"}
{"task_id": "Mbpp/475", "solution": "def sort_counter(input_dict: dict) -> list:\n    \"\"\"Return a list of (key, value) tuples sorted descending by value.\n\n    The function MUST NOT modify input_dict and MUST include every key/value pair.\n    \"\"\"\n    items = list(input_dict.items())\n    sorted_items = sorted(items, key=lambda kv: kv[1], reverse=True)\n    return sorted_items"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(values):\n    # Checks if the given list contains consecutive numbers.\n    # The input list is assumed to contain only integers based on prompt constraints.\n\n    # An empty list is not considered consecutive.\n    if not values:\n        return False\n\n    s = set(values)\n\n    # If the set has a different number of elements than the list, there are duplicates.\n    if len(s) != len(values):\n        return False\n\n    # For a set of distinct numbers to be consecutive, the difference between\n    # the maximum and minimum elements must be equal to (number of elements - 1).\n    return (max(s) - min(s)) == (len(s) - 1)"}
