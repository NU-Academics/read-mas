{"task_id": "Mbpp/428", "solution": "def shell_sort(lst: list) -> list:\n    \"\"\"\n    Sorts the given array by using shell sort.\n    \"\"\"\n    n = len(lst)\n    \n    # Create a copy of the list to perform sorting without modifying the original.\n    arr = lst[:]\n\n    # Start with a large gap and reduce it until it's 1.\n    gap = n // 2\n    while gap > 0:\n        # Perform a gapped insertion sort for the current gap size.\n        # Elements at arr[0], arr[gap], arr[2*gap], ... form a sublist, which is sorted.\n        for i in range(gap, n):\n            # Save arr[i] in a temporary variable to insert it into the correct position.\n            temp = arr[i]\n\n            # Shift earlier gap-sorted elements up until the correct location for temp is found.\n            j = i\n            while j >= gap and arr[j - gap] > temp:\n                arr[j] = arr[j - gap]\n                j -= gap\n\n            # Place temp (the original arr[i]) in its correct sorted position.\n            arr[j] = temp\n        \n        # Reduce the gap for the next pass.\n        gap //= 2\n        \n    return arr"}
{"task_id": "Mbpp/427", "solution": "class DateString:\n    def __init__(self, raw: str):\n        self.raw: str = raw\n        self.year: str = \"\"\n        self.month: str = \"\"\n        self.day: str = \"\"\n\n    def parse(self) -> bool:\n        \"\"\"Parses the raw date string into year, month, and day components.\n        Assumes the input format is 'yyyy-mm-dd' and extracts the parts.\"\"\"\n        parts = self.raw.split('-')\n        self.year, self.month, self.day = parts[0], parts[1], parts[2]\n        return True\n\nclass DateComponents:\n    def __init__(self, year: str, month: str, day: str):\n        self.year: str = year\n        self.month: str = month\n        self.day: str = day\n\n    def formatDDMMYYYY(self) -> str:\n        \"\"\"Formats the date components into 'dd-mm-yyyy' string.\n        Ensures day and month components are zero-padded to two digits.\"\"\"\n        day_padded = self.day.zfill(2)\n        month_padded = self.month.zfill(2)\n        return f\"{day_padded}-{month_padded}-{self.year}\"\n\ndef change_date_format(dateStr: str) -> str:\n    \"\"\"Converts a date string from 'yyyy-mm-dd' format to 'dd-mm-yyyy' format.\n    It orchestrates parsing and formatting using helper classes.\"\"\"\n    date_string_parser = DateString(dateStr)\n    date_string_parser.parse()\n\n    date_components_formatter = DateComponents(\n        date_string_parser.year,\n        date_string_parser.month,\n        date_string_parser.day\n    )\n\n    return date_components_formatter.formatDDMMYYYY()"}
{"task_id": "Mbpp/429", "solution": "from typing import Tuple, Any\n\ndef validateTypes(a: tuple, b: tuple) -> None:\n    \"\"\"Raise TypeError if a or b is not tuple.\"\"\"\n    if not isinstance(a, tuple):\n        raise TypeError(\"Input 'a' must be a tuple.\")\n    if not isinstance(b, tuple):\n        raise TypeError(\"Input 'b' must be a tuple.\")\n\ndef validateLengths(a: tuple, b: tuple) -> None:\n    \"\"\"Raise ValueError if len(a) != len(b).\"\"\"\n    if len(a) != len(b):\n        raise ValueError(\"Input tuples must have equal length.\")\n\ndef validateElements(a: tuple, b: tuple) -> None:\n    \"\"\"Raise TypeError if any element in a or b is not int.\"\"\"\n    for x, y in zip(a, b):\n        if not isinstance(x, int):\n            raise TypeError(f\"All elements in tuple 'a' must be integers, found {type(x).__name__}.\")\n        if not isinstance(y, int):\n            raise TypeError(f\"All elements in tuple 'b' must be integers, found {type(y).__name__}.\")\n\ndef computeBitwiseAnd(a: tuple, b: tuple) -> tuple:\n    \"\"\"Return tuple of a[i] & b[i] for each index i.\"\"\"\n    return tuple(x & y for x, y in zip(a, b))\n\ndef and_tuples(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Computes the element-wise bitwise AND of two input tuples.\n    Validates inputs for type, length, and element types before computation.\n    \"\"\"\n    validateTypes(a, b)\n    validateLengths(a, b)\n    validateElements(a, b)\n    return computeBitwiseAnd(a, b)"}
{"task_id": "Mbpp/432", "solution": "class Validator:\n    \"\"\"Validates if a value is numeric (int or float, excluding bool).\"\"\"\n    def isNumeric(self, value) -> bool:\n        \"\"\"Checks if the value is a numeric type, excluding boolean.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\nclass Argument:\n    \"\"\"Represents a function argument with its value and position.\"\"\"\n    def __init__(self, value, position):\n        self.value = value\n        self.position = position\n\nclass Trapezium:\n    \"\"\"Domain container for trapezium bases.\"\"\"\n    def __init__(self, base1, base2, base3):\n        self.base1 = base1\n        self.base2 = base2\n        self.base3 = base3\n\nclass MedianCalculator:\n    \"\"\"Encapsulates the computation of a trapezium's median.\"\"\"\n    def median_trapezium(self, a, b, c) -> float:\n        \"\"\"Constructs a Trapezium object and computes its median from bases a and b.\"\"\"\n        _ = Trapezium(base1=a, base2=b, base3=c) # The third argument c is ignored in computation.\n        return self.computeMedian(a, b)\n\n    def computeMedian(self, base1, base2) -> float:\n        \"\"\"Computes the arithmetic mean of two bases.\"\"\"\n        return (base1 + base2) / 2\n\ndef median_trapezium(a, b, c):\n    \"\"\"\n    Computes the median length of a trapezium.\n    The first two arguments are parallel sides; the third is ignored.\n    \"\"\"\n    validator = Validator()\n    if not (validator.isNumeric(a) and validator.isNumeric(b) and validator.isNumeric(c)):\n        raise TypeError(\"Inputs must be numeric\")\n\n    calculator = MedianCalculator()\n    return calculator.median_trapezium(a, b, c)"}
