{"task_id": "Mbpp/131", "solution": "VOWEL_SET = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\ndef reverse_vowels(input: str) -> str:\n    \"\"\"\n    Return input with only vowel characters reversed.\n    Non-vowel characters maintain their original positions.\n    \"\"\"\n    if not input:\n        return \"\"\n\n    vowels_in_order = []\n    for char in input:\n        if char in VOWEL_SET:\n            vowels_in_order.append(char)\n\n    # Reverse the collected vowels\n    reversed_vowels = vowels_in_order[::-1]\n\n    result_chars = []\n    vowel_idx = 0\n    for char in input:\n        if char in VOWEL_SET:\n            result_chars.append(reversed_vowels[vowel_idx])\n            vowel_idx += 1\n        else:\n            result_chars.append(char)\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/135", "solution": "def hexagonal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth hexagonal number.\n    The nth hexagonal number is given by the formula H_n = n * (2 * n - 1).\n    \"\"\"\n    return n * (2 * n - 1)"}
{"task_id": "Mbpp/133", "solution": "from typing import Iterable, List, Any, Union\n\ndef _validate_input(numbers: Any) -> List[Union[int, float]]:\n    \"\"\"Validate numbers is iterable and every element is int or float; return a list copy of values.\n    Raises TypeError if numbers is not iterable or contains non-numeric elements.\n    \"\"\"\n    if not isinstance(numbers, Iterable) or isinstance(numbers, (str, bytes)):\n        raise TypeError(\"Input must be an iterable of numbers.\")\n    \n    validated_numbers = []\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise TypeError(\"All elements in the input iterable must be numbers (int or float).\")\n        validated_numbers.append(num)\n    return validated_numbers\n\ndef _filter_negatives(numbers: Iterable[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"Return list of elements x where x < 0.\"\"\"\n    return [num for num in numbers if num < 0]\n\ndef _deterministic_sum(numbers: Iterable[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Return numeric sum; return int when all inputs are ints and result integral, else float.\"\"\"\n    if not numbers:\n        return 0\n\n    total = sum(numbers)\n    \n    all_filtered_are_ints = True\n    for num in numbers:\n        if not isinstance(num, int):\n            all_filtered_are_ints = False\n            break\n            \n    if all_filtered_are_ints and total % 1 == 0:\n        return int(total)\n    else:\n        return total\n\ndef sum_negativenum(numbers: Iterable[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Public API per SRS: returns sum of negative numbers (x < 0). Raises TypeError on invalid input.\"\"\"\n    validated_numbers = _validate_input(numbers)\n    negatives_list = _filter_negatives(validated_numbers)\n    total = _deterministic_sum(negatives_list)\n    return total"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(n):\n    \"\"\"\n    Checks if the given number can be represented as a sum of distinct non-zero powers of 2.\n    This holds true for any positive even integer.\n    \"\"\"\n    return isinstance(n, int) and n > 0 and n % 2 == 0"}
{"task_id": "Mbpp/137", "solution": "from typing import List\nfrom dataclasses import dataclass\n\nclass IntegerArray:\n    \"\"\"Wraps a Python list of integers and provides basic array operations.\"\"\"\n    def __init__(self, elements: List[int]):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self.elements)\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the array is empty.\"\"\"\n        return self.length() == 0\n\nclass InputValidator:\n    \"\"\"Validates the input IntegerArray against specified rules.\"\"\"\n    @staticmethod\n    def validate_types(arr: IntegerArray) -> None:\n        \"\"\"Raises TypeError if any element in the array is not an integer.\"\"\"\n        for element in arr.elements:\n            if not isinstance(element, int):\n                raise TypeError(\"All elements in the array must be integers.\")\n\n    @staticmethod\n    def validate_non_empty(arr: IntegerArray) -> None:\n        \"\"\"Raises ValueError if the array is empty.\"\"\"\n        if arr.is_empty():\n            raise ValueError(\"Input array cannot be empty.\")\n\n@dataclass(frozen=True)\nclass ComputationResult:\n    \"\"\"Immutable data holder for the ratio, zero count, and non-zero count.\"\"\"\n    ratio: float\n    zero_count: int\n    non_zero_count: int\n\nclass ZeroCountFunction:\n    \"\"\"Performs the counting of zeros and non-zeros, and computes the ratio.\"\"\"\n    def count_zeros(self, arr: IntegerArray) -> int:\n        \"\"\"Counts the number of zero elements in the array.\"\"\"\n        return sum(1 for x in arr.elements if x == 0)\n\n    def count_non_zeros(self, arr: IntegerArray) -> int:\n        \"\"\"Counts the number of non-zero elements in the array.\"\"\"\n        return sum(1 for x in arr.elements if x != 0)\n\n    def compute(self, arr: IntegerArray) -> ComputationResult:\n        \"\"\"Computes the ratio of zeros to non-zeros, raising ValueError if non-zero count is zero.\"\"\"\n        zero_c = self.count_zeros(arr)\n        non_zero_c = self.count_non_zeros(arr)\n\n        if non_zero_c == 0:\n            raise ValueError('No non-zero elements; ratio undefined')\n\n        ratio_val = float(zero_c) / non_zero_c\n        return ComputationResult(ratio=ratio_val, zero_count=zero_c, non_zero_count=non_zero_c)\n\ndef zero_count(arr: List[int]) -> float:\n    \"\"\"\n    Calculates the ratio of zeroes to non-zeroes in an array of integers.\n    Raises TypeError if any element is not an integer, or ValueError for empty\n    arrays or when no non-zero elements are present.\n    \"\"\"\n    integer_array = IntegerArray(arr)\n    InputValidator.validate_types(integer_array)\n    InputValidator.validate_non_empty(integer_array)\n\n    zero_count_function = ZeroCountFunction()\n    result = zero_count_function.compute(integer_array)\n    return result.ratio"}
