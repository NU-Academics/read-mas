{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    '''\n    largest_neg = None\n    smallest_pos = None\n\n    for x in lst:\n        if x < 0:\n            if largest_neg is None or x > largest_neg:\n                largest_neg = x\n        elif x > 0:\n            if smallest_pos is None or x < smallest_pos:\n                smallest_pos = x\n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/136", "solution": "```python\ndef largest_smallest_integers(lst):\n    \"\"\"\n    Finds the largest negative and smallest positive integers in a list.\n    Returns (largest_negative, smallest_positive), with None if either is absent.\n    \"\"\"\n    negatives = [x for x in lst if x < 0]\n    positives = [x for x in lst if x > 0]\n\n    largest_neg = max(negatives) if negatives else None\n    smallest_pos = min(positives) if positives else None\n\n    return (largest_neg, smallest_pos)\n```"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"Compares two values (int, float, or numeric string) and returns the larger in its original type, or None if equal.\"\"\"\n\n    # Helper function to parse any value into its canonical float representation while retaining the original.\n    def _parse_and_retain_original(val):\n        # Convert all inputs to string to uniformly handle decimal separators.\n        str_val = str(val)\n        # Replace comma with dot for consistent float conversion.\n        # This handles strings like \"2,3\" and is harmless for \"2.3\" or \"2\".\n        normalized_str_val = str_val.replace(',', '.')\n        # Convert to float. As per requirements, we trust inputs are valid numeric representations.\n        numeric_val = float(normalized_str_val)\n        return numeric_val, val\n\n    # Parse both input values to their numeric float form and keep their original representation.\n    numeric_a, original_a = _parse_and_retain_original(a)\n    numeric_b, original_b = _parse_and_retain_original(b)\n\n    # Compare the numeric values and return the original representation of the larger one.\n    if numeric_a > numeric_b:\n        return original_a\n    elif numeric_b > numeric_a:\n        return original_b\n    else:\n        # If numeric values are equal, return None as per the problem statement.\n        return None"}
{"task_id": "HumanEval/137", "solution": "import math\nfrom typing import Union, Optional, List\n\n# 1. Exceptions (src/compare_one/exceptions.py)\nclass ParseError(Exception):\n    \"\"\"Exception raised for errors during number parsing.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass ComparisonError(Exception):\n    \"\"\"Exception raised for errors during value comparison.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\n# 2. Models (src/compare_one/models.py)\nclass ParsedNumber:\n    \"\"\"Represents a parsed number with its original value and numeric form.\"\"\"\n    def __init__(self, original: Union[str, int, float], numeric: float, is_string: bool) -> None:\n        self._original = original\n        self._numeric = numeric\n        self._is_string = is_string\n\n    @property\n    def numeric(self) -> float:\n        return self._numeric\n\n    def as_return_value(self) -> Union[str, int, float]:\n        \"\"\"Returns the original input value, preserving its type and exact formatting.\"\"\"\n        return self._original\n\n# 3. Utilities (src/compare_one/utils.py)\nclass Normalizer:\n    \"\"\"Helper for normalizing numeric strings (handling decimal separators).\"\"\"\n    def normalize_number_string(self, s: str) -> str:\n        s = s.strip()\n        if not s:\n            raise ParseError(\"Empty string cannot be parsed.\")\n\n        # Handle both '.' and ',' as decimal separators (Assumption 4).\n        last_dot = s.rfind('.')\n        last_comma = s.rfind(',')\n\n        if last_dot != -1 and last_comma != -1:\n            if last_dot > last_comma: # Example: \"1,234.56\"\n                s = s.replace(',', '')\n            else: # Example: \"1.234,56\"\n                s = s.replace('.', '').replace(',', '.')\n        elif ',' in s: # Only comma present\n            s = s.replace(',', '.')\n\n        # Basic validation for allowed characters, as per design snippet.\n        allowed = set(\"0123456789+-.eE\")\n        if any(ch not in allowed for ch in s):\n            raise ParseError(f\"Invalid characters in numeric string: '{s}'.\")\n\n        return s\n\n# 4. Parser (src/compare_one/parser.py)\nclass NumberParser:\n    \"\"\"Robustly parses input types into ParsedNumber.\"\"\"\n    def __init__(self, normalizer: Normalizer) -> None:\n        self._normalizer = normalizer\n\n    def parse(self, value: Union[str, int, float]) -> ParsedNumber:\n        if isinstance(value, int):\n            return ParsedNumber(original=value, numeric=float(value), is_string=False)\n        if isinstance(value, float):\n            if math.isnan(value) or math.isinf(value):\n                raise ParseError(f\"Non-finite float value encountered: {value}.\")\n            return ParsedNumber(original=value, numeric=value, is_string=False)\n        if isinstance(value, str):\n            try:\n                normalized = self._normalizer.normalize_number_string(value)\n                num = float(normalized)\n            except ParseError as e:\n                raise ParseError(f\"Failed to normalize and parse string '{value}': {e}.\") from e\n            except ValueError:\n                raise ParseError(f\"Cannot parse string '{value}' to a number.\")\n            \n            if math.isnan(num) or math.isinf(num):\n                raise ParseError(f\"Parsed string '{value}' resulted in a non-finite number.\")\n            \n            return ParsedNumber(original=value, numeric=num, is_string=True)\n        \n        raise ParseError(f\"Unsupported input type: {type(value).__name__}.\")\n\n# 5. Comparator (src/compare_one/comparator.py)\nclass ComparatorService:\n    \"\"\"Compares two raw inputs and chooses the larger value respecting original types.\"\"\"\n    def __init__(self, parser: NumberParser) -> None:\n        self._parser = parser\n\n    def compare(self, a: Union[str, int, float], b: Union[str, int, float]) -> Optional[Union[str, int, float]]:\n        try:\n            pa = self._parser.parse(a)\n            pb = self._parser.parse(b)\n        except ParseError as e:\n            raise ComparisonError(f\"Failed to parse input during comparison: {e}.\") from e\n\n        if pa.numeric > pb.numeric:\n            return pa.as_return_value()\n        if pb.numeric > pa.numeric:\n            return pb.as_return_value()\n        return None\n\n# 6. Controller (src/compare_one/controller.py)\nclass CompareController:\n    \"\"\"Public API surface for library clients, handles input validation and exception mapping.\"\"\"\n    def __init__(self, service: ComparatorService) -> None:\n        self._service = service\n\n    def compare_one(self, a: Union[str, int, float], b: Union[str, int, float]) -> Optional[Union[str, int, float]]:\n        allowed_types = (str, int, float)\n        if not isinstance(a, allowed_types) or not isinstance(b, allowed_types):\n            raise ValueError(f\"Inputs must be int, float, or str. Got types {type(a).__name__} and {type(b).__name__}.\")\n\n        try:\n            return self._service.compare(a, b)\n        except (ParseError, ComparisonError) as e:\n            # Maps internal errors to ValueError for simpler library consumption.\n            raise ValueError(f\"Comparison failed due to an internal error: {e}.\") from e\n\n# 7. Public compare_one function (from src/compare_one/__init__.py)\n# Setup default controller for the public function using dependency injection.\n_default_normalizer = Normalizer()\n_default_parser = NumberParser(_default_normalizer)\n_default_comparator_service = ComparatorService(_default_parser)\n_default_controller = CompareController(_default_comparator_service)\n\ndef compare_one(a, b):\n    \"\"\"\n    Compares two values and returns the numerically larger value in its original type.\n    Returns None if the values are numerically equal.\n    \"\"\"\n    return _default_controller.compare_one(a, b)"}
