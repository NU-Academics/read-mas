{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    return pow(2, n, p)"}
{"task_id": "HumanEval/48", "solution": "```python\n# pyproject.toml\n# [tool.poetry]\n# name = \"palindrome-app\"\n# version = \"0.1.0\"\n# description = \"Palindrome checker service\"\n# authors = [\"Your Name <you@example.com>\"]\n# readme = \"README.md\"\n# packages = [{include = \"palindrome_app\", from = \"src\"}]\n#\n# [tool.poetry.dependencies]\n# python = \"^3.9\"\n# fastapi = \"^0.104.1\"\n# uvicorn = {extras = [\"standard\"], version = \"^0.23.2\"}\n# pydantic = \"^2.4.2\"\n# python-dotenv = \"^1.0.0\" # for loading .env files in dev\n#\n# [tool.poetry.group.dev.dependencies]\n# pytest = \"^7.4.2\"\n#\n# [build-system]\n# requires = [\"poetry-core\"]\n# build-backend = \"poetry.core.masonry.api\"\n\n# For simplicity, I'm providing `requirements.txt` instead of `pyproject.toml` content,\n# as `pyproject.toml` is typically generated by a tool like Poetry.\n# If a `pyproject.toml` is strictly required, the commented section above can be used.\n\n# requirements.txt\n# fastapi==0.104.1\n# uvicorn[standard]==0.23.2\n# pydantic==2.4.2\n# python-dotenv==1.0.0 # for development\n#\n# # For testing\n# pytest==7.4.2\n\n# README.md\n# (Content for README.md would go here, including usage instructions, setup, and examples.)\n```\n\n```sql\n-- migrations/0001_create_palindrome_checks.sql\nCREATE TABLE IF NOT EXISTS palindrome_checks (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  original_text TEXT NOT NULL,\n  normalized_text TEXT NOT NULL,\n  is_palindrome INTEGER NOT NULL CHECK (is_palindrome IN (0,1)),\n  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\nCREATE INDEX IF NOT EXISTS idx_palindrome_checks_created_at ON palindrome_checks(created_at DESC);\n```\n\n```python\n# src/palindrome_app/__init__.py\n# Palindrome application package.\n```\n\n```python\n# src/palindrome_app/config.py\nimport os\nfrom dotenv import load_dotenv\n\nload_dotenv()  # Load environment variables from .env file\n\nclass Config:\n    \"\"\"\n    Application configuration loaded from environment variables.\n    Provides default values for all settings.\n    \"\"\"\n    DB_PATH: str = os.getenv(\"PAL_DB_PATH\", \"data/palindrome_checks.db\")\n    API_KEY: str | None = os.getenv(\"PAL_API_KEY\", None)\n    NORMALIZE_REMOVE_NON_ALNUM: bool = os.getenv(\"PAL_NORMALIZE_REMOVE_NON_ALNUM\", \"true\").lower() == \"true\"\n    NORMALIZE_LOWER: bool = os.getenv(\"PAL_NORMALIZE_LOWER\", \"true\").lower() == \"true\"\n    MAX_INPUT_LENGTH: int = int(os.getenv(\"PAL_MAX_INPUT_LENGTH\", \"10000\"))\n\n    @classmethod\n    def from_env(cls) -> \"Config\":\n        \"\"\"Load configuration from environment variables.\"\"\"\n        return cls()\n\n```\n\n```python\n# src/palindrome_app/exceptions.py\nclass AppException(Exception):\n    \"\"\"\n    Custom exception for application-specific errors with status codes.\n    Controllers catch this to return appropriate HTTP/CLI responses.\n    \"\"\"\n    def __init__(self, status_code: int, message: str):\n        self.status_code = status_code\n        self.message = message\n        super().__init__(f\"Status {status_code}: {message}\")\n\n    def to_dict(self) -> dict:\n        \"\"\"Return a serializable dictionary representation of the exception.\"\"\"\n        return {\"detail\": self.message, \"status_code\": self.status_code}\n\n```\n\n```python\n# src/palindrome_app/models.py\nfrom datetime import datetime\nfrom typing import Optional\nfrom pydantic import BaseModel, Field\n\nclass PalindromeRecord(BaseModel):\n    \"\"\"\n    Represents a stored record of a palindrome check.\n    Used for persistence and history retrieval.\n    \"\"\"\n    id: Optional[int] = Field(None, description=\"Unique identifier for the check record\")\n    original_text: str = Field(..., description=\"The original text submitted for checking\")\n    normalized_text: str = Field(..., description=\"The text after normalization\")\n    is_palindrome: bool = Field(..., description=\"True if the text is a palindrome, False otherwise\")\n    created_at: datetime = Field(default_factory=datetime.utcnow, description=\"Timestamp of when the check occurred\")\n\n    def to_dict(self) -> dict:\n        \"\"\"Convert the record to a dictionary.\"\"\"\n        return self.model_dump()\n\nclass CheckRequest(BaseModel):\n    \"\"\"\n    Request model for the palindrome check endpoint.\n    Contains the text string to be checked.\n    \"\"\"\n    text: str = Field(..., description=\"The text string to check for palindrome property\")\n\n    def to_dict(self) -> dict:\n        \"\"\"Convert the request to a dictionary.\"\"\"\n        return self.model_dump()\n\nclass CheckResponse(BaseModel):\n    \"\"\"\n    Response model for the palindrome check endpoint.\n    Includes original, normalized text, and the palindrome result.\n    \"\"\"\n    text: str = Field(..., description=\"The original text submitted\")\n    normalized: str = Field(..., description=\"The normalized text used for the check\")\n    is_palindrome: bool = Field(..., description=\"True if the text is a palindrome, False otherwise\")\n    timestamp: datetime = Field(..., description=\"Timestamp of when the check was performed\")\n\n    def to_dict(self) -> dict:\n        \"\"\"Convert the response to a dictionary.\"\"\"\n        return self.model_dump()\n\n```\n\n```python\n# src/palindrome_app/utils.py\nfrom palindrome_app.exceptions import AppException\n\nclass Validator:\n    \"\"\"\n    Utility class for common validation logic.\n    Provides static methods for input checks.\n    \"\"\"\n    @staticmethod\n    def validate_input_length(text: str, max_length: int) -> None:\n        \"\"\"\n        Validates that the input text does not exceed a maximum allowed length.\n        Raises AppException (413) if the text is too long.\n        \"\"\"\n        if len(text) > max_length:\n            raise AppException(\n                status_code=413,\n                message=f\"Request entity too large: input text exceeds maximum length of {max_length} characters.\"\n            )\n\n    @staticmethod\n    def is_alphanumeric(c: str) -> bool:\n        \"\"\"\n        Checks if a character is alphanumeric (a-z, A-Z, 0-9).\n        Helper for text normalization.\n        \"\"\"\n        return c.isalnum()\n\n```\n\n```python\n# src/palindrome_app/text_normalizer.py\nfrom palindrome_app.utils import Validator\nfrom palindrome_app.exceptions import AppException\n\nclass TextNormalizer:\n    \"\"\"\n    Handles text normalization according to configured rules.\n    This includes optionally removing non-alphanumeric characters and lowercasing.\n    \"\"\"\n    def __init__(self, remove_non_alnum: bool, lower: bool) -> None:\n        \"\"\"\n        Initializes the normalizer with specific configuration.\n        \"\"\"\n        self._remove_non_alnum = remove_non_alnum\n        self._lower = lower\n\n    def normalize(self, text: str) -> str:\n        \"\"\"\n        Applies configured normalization rules to the input text.\n        Returns the processed text.\n        \"\"\"\n        if not isinstance(text, str):\n            raise AppException(status_code=400, message=\"Input for normalization must be a string.\")\n\n        normalized_chars = []\n        for char in text:\n            if self._remove_non_alnum:\n                if Validator.is_alphanumeric(char):\n                    normalized_chars.append(char)\n            else:\n                normalized_chars.append(char)\n\n        processed_text = \"\".join(normalized_chars)\n\n        if self._lower:\n            processed_text = processed_text.lower()\n\n        return processed_text\n\n```\n\n```python\n# src/palindrome_app/palindrome_repository.py\nimport sqlite3\nimport os\nfrom typing import List, Optional\nfrom datetime import datetime\nimport logging\n\nfrom palindrome_app.models import PalindromeRecord\nfrom palindrome_app.exceptions import AppException\n\nlogger = logging.getLogger(__name__)\n\nclass DatabaseAdapter:\n    \"\"\"\n    Adapter for SQLite database operations.\n    Manages connection and executes SQL queries.\n    \"\"\"\n    def __init__(self, db_path: str) -> None:\n        \"\"\"Initializes the database adapter with the given DB path.\"\"\"\n        self._db_path = db_path\n        self._conn: Optional[sqlite3.Connection] = None\n        self._connect()\n\n    def _connect(self) -> None:\n        \"\"\"Establishes a connection to the SQLite database.\"\"\"\n        try:\n            # Ensure the directory exists\n            os.makedirs(os.path.dirname(self._db_path), exist_ok=True)\n            self._conn = sqlite3.connect(self._db_path, detect_types=sqlite3.PARSE_DECLTYPES|sqlite3.PARSE_COLNAMES)\n            self._conn.row_factory = sqlite3.Row # Allows dictionary-like access to rows\n            logger.info(f\"Connected to database: {self._db_path}\")\n        except sqlite3.Error as e:\n            logger.error(f\"Failed to connect to database {self._db_path}: {e}\")\n            raise AppException(status_code=500, message=f\"Database connection error: {e}\")\n\n    def execute(self, query: str, params: tuple = ()) -> sqlite3.Cursor:\n        \"\"\"Executes a read query and returns the cursor.\"\"\"\n        if not self._conn:\n            self._connect()\n        try:\n            return self._conn.execute(query, params)\n        except sqlite3.Error as e:\n            logger.error(f\"Database read error: {e} with query: {query}, params: {params}\")\n            raise AppException(status_code=500, message=f\"Database read error: {e}\")\n\n    def execute_commit(self, query: str, params: tuple = ()) -> int:\n        \"\"\"Executes a write query, commits changes, and returns last inserted row ID.\"\"\"\n        if not self._conn:\n            self._connect()\n        try:\n            cursor = self._conn.execute(query, params)\n            self._conn.commit()\n            return cursor.lastrowid if cursor.lastrowid is not None else -1 # Return -1 if not applicable\n        except sqlite3.Error as e:\n            self._conn.rollback()\n            logger.error(f\"Database write error: {e} with query: {query}, params: {params}\")\n            raise AppException(status_code=500, message=f\"Database write error: {e}\")\n\n    def close(self) -> None:\n        \"\"\"Closes the database connection.\"\"\"\n        if self._conn:\n            self._conn.close()\n            logger.info(f\"Database connection to {self._db_path} closed.\")\n            self._conn = None\n\nclass PalindromeRepository:\n    \"\"\"\n    Repository for PalindromeRecord objects, managing persistence to SQLite.\n    Provides CRUD operations for palindrome check history.\n    \"\"\"\n    def __init__(self, db: DatabaseAdapter) -> None:\n        \"\"\"Initializes the repository with a DatabaseAdapter.\"\"\"\n        self._db = db\n\n    def create_table_if_not_exists(self) -> None:\n        \"\"\"\n        Applies the initial database schema migration if the table does not exist.\n        Reads the SQL script from the migrations directory.\n        \"\"\"\n        script_dir = os.path.dirname(__file__)\n        migrations_dir = os.path.join(script_dir, \"../../migrations\")\n        migration_file = os.path.join(migrations_dir, \"0001_create_palindrome_checks.sql\")\n        \n        try:\n            with open(migration_file, 'r') as f:\n                sql_script = f.read()\n            self._db.execute_commit(sql_script)\n            logger.info(\"Palindrome checks table ensured to exist.\")\n        except FileNotFoundError:\n            logger.error(f\"Migration file not found at {migration_file}. Cannot initialize database schema.\")\n            raise AppException(status_code=500, message=f\"Database migration file missing: {migration_file}\")\n        except AppException as e:\n            logger.error(f\"Failed to create palindrome checks table: {e.message}\")\n            raise # Re-raise AppException from DatabaseAdapter\n\n    def insert(self, record: PalindromeRecord) -> int:\n        \"\"\"Inserts a new PalindromeRecord into the database.\"\"\"\n        query = \"\"\"\n            INSERT INTO palindrome_checks (original_text, normalized_text, is_palindrome, created_at)\n            VALUES (?, ?, ?, ?)\n        \"\"\"\n        params = (\n            record.original_text,\n            record.normalized_text,\n            int(record.is_palindrome),  # SQLite stores bool as INTEGER (0 or 1)\n            record.created_at.isoformat()\n        )\n        try:\n            record_id = self._db.execute_commit(query, params)\n            logger.info(f\"Inserted palindrome record with ID: {record_id}\")\n            return record_id\n        except AppException as e:\n            logger.error(f\"Failed to insert palindrome record: {e.message}\")\n            raise\n\n    def list_recent(self, limit: int = 100) -> List[PalindromeRecord]:\n        \"\"\"Retrieves a list of recent PalindromeRecord entries.\"\"\"\n        query = \"\"\"\n            SELECT id, original_text, normalized_text, is_palindrome, created_at\n            FROM palindrome_checks\n            ORDER BY created_at DESC\n            LIMIT ?\n        \"\"\"\n        try:\n            cursor = self._db.execute(query, (limit,))\n            records = []\n            for row in cursor.fetchall():\n                records.append(PalindromeRecord(\n                    id=row['id'],\n                    original_text=row['original_text'],\n                    normalized_text=row['normalized_text'],\n                    is_palindrome=bool(row['is_palindrome']),\n                    created_at=datetime.fromisoformat(row['created_at'])\n                ))\n            return records\n        except AppException as e:\n            logger.error(f\"Failed to list recent palindrome records: {e.message}\")\n            raise\n\n```\n\n```python\n# src/palindrome_app/palindrome_service.py\nfrom typing import Optional\nfrom datetime import datetime\nimport logging\n\nfrom palindrome_app.text_normalizer import TextNormalizer\nfrom palindrome_app.palindrome_repository import PalindromeRepository\nfrom palindrome_app.models import PalindromeRecord, CheckResponse\nfrom palindrome_app.utils import Validator\nfrom palindrome_app.exceptions import AppException\n\nlogger = logging.getLogger(__name__)\n\nclass PalindromeService:\n    \"\"\"\n    Core business logic for palindrome checking.\n    Orchestrates text normalization, palindrome determination, and optional history persistence.\n    \"\"\"\n    def __init__(self, normalizer: TextNormalizer, repository: Optional[PalindromeRepository], max_length: int) -> None:\n        \"\"\"\n        Initializes the PalindromeService with dependencies.\n        \"\"\"\n        self._normalizer = normalizer\n        self._repository = repository\n        self._max_length = max_length\n\n    def _is_palindrome_core(self, text: str) -> bool:\n        \"\"\"\n        Internal method to check if a string is a palindrome.\n        Assumes text is already normalized.\n        \"\"\"\n        return text == text[::-1]\n\n    def is_palindrome(self, text: str) -> bool:\n        \"\"\"\n        Checks if the given text is a palindrome after normalization.\n        This method performs the core palindrome check without recording history.\n        \"\"\"\n        Validator.validate_input_length(text, self._max_length)\n        normalized_text = self._normalizer.normalize(text)\n        return self._is_palindrome_core(normalized_text)\n\n    def check_and_record(self, text: str) -> CheckResponse:\n        \"\"\"\n        Performs a palindrome check, persists the history if a repository is provided,\n        and returns a detailed CheckResponse.\n        \"\"\"\n        Validator.validate_input_length(text, self._max_length)\n\n        normalized_text = self._normalizer.normalize(text)\n        is_pal = self._is_palindrome_core(normalized_text)\n        current_time = datetime.utcnow()\n\n        record = PalindromeRecord(\n            original_text=text,\n            normalized_text=normalized_text,\n            is_palindrome=is_pal,\n            created_at=current_time\n        )\n\n        if self._repository:\n            try:\n                self._repository.insert(record)\n            except AppException as e:\n                logger.warning(f\"Failed to persist palindrome check history: {e.message}. Core operation continues.\")\n            except Exception as e:\n                logger.warning(f\"Unexpected error during history persistence: {e}. Core operation continues.\")\n        else:\n            logger.debug(\"History persistence is disabled (no repository provided).\")\n\n        return CheckResponse(\n            text=text,\n            normalized=normalized_text,\n            is_palindrome=is_pal,\n            timestamp=current_time\n        )\n\n```\n\n```python\n# src/palindrome_app/api_controller.py\nfrom fastapi import FastAPI, HTTPException, status, Depends, Security\nfrom fastapi.security import APIKeyHeader\nfrom typing import List, Optional\nimport logging\n\nfrom palindrome_app.config import Config\nfrom palindrome_app.exceptions import AppException\nfrom palindrome_app.models import CheckRequest, CheckResponse, PalindromeRecord\nfrom palindrome_app.palindrome_service import PalindromeService\n\nlogger = logging.getLogger(__name__)\n\nclass APIController:\n    \"\"\"\n    FastAPI controller for exposing palindrome checking functionality via HTTP API.\n    Handles request validation, API key authentication, and error responses.\n    \"\"\"\n    def __init__(self, service: PalindromeService, config: Config) -> None:\n        \"\"\"\n        Initializes the API controller with the PalindromeService and application configuration.\n        \"\"\"\n        self._service = service\n        self._config = config\n        self._app = FastAPI(\n            title=\"Palindrome Checker API\",\n            description=\"API to check if a string is a palindrome and optionally store history.\",\n            version=\"1.0.0\"\n        )\n        self._setup_routes()\n\n    def _get_api_key_header(self) -> APIKeyHeader:\n        \"\"\"Returns the APIKeyHeader for security.\"\"\"\n        return APIKeyHeader(name=\"X-API-Key\", auto_error=False)\n\n    async def _verify_api_key(self, api_key: Optional[str] = Security(APIKeyHeader(name=\"X-API-Key\", auto_error=False))) -> None:\n        \"\"\"\n        Dependency to verify API key if configured.\n        Raises HTTPException if key is missing or invalid.\n        \"\"\"\n        if self._config.API_KEY:  # If API key is configured\n            if not api_key:\n                logger.warning(\"API key missing for authenticated endpoint.\")\n                raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail=\"API Key missing\")\n            if api_key != self._config.API_KEY:\n                logger.warning(\"Invalid API key provided.\")\n                raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail=\"Invalid API Key\")\n        # If _config.API_KEY is None, no authentication is required, so proceed.\n\n    def _setup_routes(self) -> None:\n        \"\"\"Sets up the API endpoints.\"\"\"\n        app = self._app\n\n        @app.post(\"/check\", response_model=CheckResponse, summary=\"Check if text is a palindrome\")\n        async def check_palindrome_endpoint(\n            request: CheckRequest,\n            _: None = Depends(self._verify_api_key) # Apply API key check\n        ) -> CheckResponse:\n            \"\"\"\n            Submits a text string to be checked for the palindrome property.\n            Optionally persists the check history.\n            \"\"\"\n            try:\n                logger.info(f\"Received check request for text: '{request.text}'\")\n                response = self._service.check_and_record(request.text)\n                return response\n            except AppException as e:\n                logger.error(f\"AppException during /check: {e.message}\", exc_info=True)\n                raise HTTPException(status_code=e.status_code, detail=e.message)\n            except Exception as e:\n                logger.critical(f\"Unhandled exception during /check: {e}\", exc_info=True)\n                raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"Internal server error\")\n\n        @app.get(\"/history\", response_model=List[PalindromeRecord], summary=\"Retrieve recent palindrome checks\")\n        async def get_history_endpoint(\n            limit: int = 100,\n            _: None = Depends(self._verify_api_key)\n        ) -> List[PalindromeRecord]:\n            \"\"\"\n            Retrieves a list of recent palindrome check records.\n            The `limit` query parameter controls the number of records returned (max 1000).\n            \"\"\"\n            if not self._service._repository: # Access private member to check if repo exists\n                logger.warning(\"Attempted to access /history but persistence is disabled.\")\n                raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail=\"History persistence is not enabled.\")\n            \n            if not (1 <= limit <= 1000):\n                raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=\"Limit must be between 1 and 1000.\")\n\n            try:\n                logger.info(f\"Retrieving recent history with limit: {limit}\")\n                history = self._service._repository.list_recent(limit=limit)\n                return history\n            except AppException as e:\n                logger.error(f\"AppException during /history: {e.message}\", exc_info=True)\n                raise HTTPException(status_code=e.status_code, detail=e.message)\n            except Exception as e:\n                logger.critical(f\"Unhandled exception during /history: {e}\", exc_info=True)\n                raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"Internal server error\")\n\n        @app.get(\"/health\", summary=\"Health check endpoint\")\n        async def health_check() -> dict:\n            \"\"\"\n            Returns a simple status to indicate the API is operational.\n            \"\"\"\n            return {\"status\": \"ok\"}\n\n    def get_app(self) -> FastAPI:\n        \"\"\"Returns the configured FastAPI application instance.\"\"\"\n        return self._app\n\n```\n\n```python\n# src/palindrome_app/cli_controller.py\nimport argparse\nimport sys\nimport logging\nfrom typing import List\n\nfrom palindrome_app.palindrome_service import PalindromeService\nfrom palindrome_app.exceptions import AppException\n\nlogger = logging.getLogger(__name__)\n\nclass CLIController:\n    \"\"\"\n    Controller for the command-line interface.\n    Parses arguments and invokes the PalindromeService.\n    \"\"\"\n    def __init__(self, service: PalindromeService) -> None:\n        \"\"\"Initializes the CLI controller with the PalindromeService.\"\"\"\n        self._service = service\n        self._parser = self._setup_parser()\n\n    def _setup_parser(self) -> argparse.ArgumentParser:\n        \"\"\"Configures the argument parser for CLI commands.\"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"palindrome\",\n            description=\"Palindrome Checker CLI tool.\",\n            formatter_class=argparse.RawTextHelpFormatter\n        )\n\n        subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\")\n\n        # Check command\n        check_parser = subparsers.add_parser(\n            \"check\",\n            help=\"Check if a given text is a palindrome.\",\n            description=\"\"\"\nCheck if a given text is a palindrome.\nReturns exit code 0 if palindrome, 1 if not, >1 on error.\n\"\"\",\n        )\n        check_parser.add_argument(\n            \"text\",\n            type=str,\n            help=\"The text string to check for palindrome property.\"\n        )\n        return parser\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"\n        Executes the CLI command based on the provided arguments.\n        Returns an exit code (0 for success, 1 for not palindrome, >1 for error).\n        \"\"\"\n        args = self._parser.parse_args(argv[1:]) # Exclude script name\n\n        if args.command == \"check\":\n            return self._handle_check_command(args.text)\n        else:\n            self._parser.print_help()\n            return 2 # Invalid command\n\n    def _handle_check_command(self, text: str) -> int:\n        \"\"\"\n        Handles the 'check' subcommand, calls the service, and prints the result.\n        Returns appropriate exit codes.\n        \"\"\"\n        try:\n            response = self._service.check_and_record(text)\n            print(f\"Original Text: '{response.text}'\")\n            print(f\"Normalized Text: '{response.normalized}'\")\n            print(f\"Is Palindrome: {response.is_palindrome}\")\n            logger.info(f\"CLI check for '{text}' -> {response.is_palindrome}\")\n            return 0 if response.is_palindrome else 1\n        except AppException as e:\n            logger.error(f\"CLI error for '{text}': {e.message}\", exc_info=True)\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return e.status_code # Use status code as exit code for errors\n        except Exception as e:\n            logger.critical(f\"Unhandled CLI error for '{text}': {e}\", exc_info=True)\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 255 # Generic unexpected error code\n\n```\n\n```python\n# src/palindrome_app/main.py\nimport sys\nimport uvicorn\nimport logging\n\n# Configure basic logging for the entire application\nlogging.basicConfig(level=logging.INFO, stream=sys.stdout,\n                    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\nlogger = logging.getLogger(__name__)\n\nfrom palindrome_app.config import Config\nfrom palindrome_app.text_normalizer import TextNormalizer\nfrom palindrome_app.palindrome_repository import PalindromeRepository, DatabaseAdapter\nfrom palindrome_app.palindrome_service import PalindromeService\nfrom palindrome_app.api_controller import APIController\nfrom palindrome_app.cli_controller import CLIController\nfrom palindrome_app.exceptions import AppException\n\ndef create_service_from_config(config: Config) -> PalindromeService:\n    \"\"\"\n    Factory function to assemble all core components based on the configuration.\n    Initializes TextNormalizer, optional DatabaseAdapter, PalindromeRepository,\n    and finally PalindromeService.\n    \"\"\"\n    normalizer = TextNormalizer(\n        remove_non_alnum=config.NORMALIZE_REMOVE_NON_ALNUM,\n        lower=config.NORMALIZE_LOWER\n    )\n\n    repository: Optional[PalindromeRepository] = None\n    if config.DB_PATH:\n        try:\n            db_adapter = DatabaseAdapter(config.DB_PATH)\n            repository = PalindromeRepository(db_adapter)\n            repository.create_table_if_not_exists()\n            logger.info(f\"History persistence enabled to '{config.DB_PATH}'.\")\n        except AppException as e:\n            logger.error(f\"Failed to initialize database for history persistence: {e.message}. History will be disabled.\", exc_info=True)\n            repository = None # Disable repository if initialization fails\n        except Exception as e:\n            logger.error(f\"Unexpected error initializing database: {e}. History will be disabled.\", exc_info=True)\n            repository = None\n    else:\n        logger.info(\"PAL_DB_PATH not set, history persistence disabled.\")\n\n    service = PalindromeService(\n        normalizer=normalizer,\n        repository=repository,\n        max_length=config.MAX_INPUT_LENGTH\n    )\n    return service\n\ndef run_api() -> None:\n    \"\"\"\n    Entrypoint for running the HTTP API server.\n    Initializes the application components and starts Uvicorn.\n    \"\"\"\n    config = Config.from_env()\n    service = create_service_from_config(config)\n    controller = APIController(service=service, config=config)\n    app = controller.get_app()\n\n    logger.info(\"Starting API server...\")\n    uvicorn.run(app, host=\"0.0.0.0\", port=8000)\n    logger.info(\"API server stopped.\")\n\n    # Ensure DB connection is closed if it was opened\n    if service._repository and service._repository._db:\n        service._repository._db.close()\n\n\ndef run_cli(argv: List[str]) -> int:\n    \"\"\"\n    Entrypoint for running the CLI application.\n    Initializes components and executes the CLI command.\n    \"\"\"\n    config = Config.from_env()\n    service = create_service_from_config(config)\n    controller = CLIController(service=service)\n\n    logger.info(f\"Running CLI command: {' '.join(argv)}\")\n    exit_code = controller.run(argv)\n    logger.info(f\"CLI command finished with exit code: {exit_code}\")\n\n    # Ensure DB connection is closed if it was opened\n    if service._repository and service._repository._db:\n        service._repository._db.close()\n        \n    return exit_code\n\nif __name__ == \"__main__\":\n    # Determine if running as CLI or API based on environment or arguments\n    # For simplicity, we can check for an explicit command or an environment variable.\n    # E.g., `python -m palindrome_app.main api` or `python -m palindrome_app.main check \"hello\"`\n    # Or, if deployed, often run via `uvicorn palindrome_app.main:app` (but here app is dynamically created)\n    # A common way to distinguish is checking the first argument.\n\n    if len(sys.argv) > 1 and sys.argv[1].lower() == \"api\":\n        # Remove 'api' argument so uvicorn doesn't try to parse it\n        sys.argv.pop(1) \n        run_api()\n    elif len(sys.argv) > 1: # Assume any other argument means CLI command\n        sys.exit(run_cli(sys.argv))\n    else:\n        # Default to CLI help if no arguments provided, or if invoked without 'api'\n        print(\"Usage:\")\n        print(\"  python -m palindrome_app.main api                       # Run HTTP API server\")\n        print(\"  python -m palindrome_app.main check \\\"<text>\\\"            # Run CLI palindrome check\")\n        sys.exit(2) # Indicate incorrect usage\n\n```"}
{"task_id": "HumanEval/50", "solution": "```\n# pyproject.toml\n[project]\nname = \"shift-cipher\"\nversion = \"0.1.0\"\ndescription = \"A Python library and CLI for a simple shift cipher (Caesar cipher variant).\"\nreadme = \"README.md\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\nrequires-python = \">=3.10\"\nkeywords = [\"cipher\", \"shift\", \"cli\", \"library\"]\nlicense = { text = \"MIT\" }\n\n[project.scripts]\nshift-cipher = \"shift_cipher.cli:main\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n```\n# src/shift_cipher/__init__.py\n\"\"\"\nShift Cipher package: provides encoding/decoding functions and a service.\n\"\"\"\n\nfrom .core import encode_shift, decode_shift\nfrom .services import CipherService\n\n__version__ = \"0.1.0\"\n```\n```\n# src/shift_cipher/exceptions.py\n\"\"\"\nCustom exception classes for shift cipher operations.\n\"\"\"\n\nclass InvalidInputError(ValueError):\n    \"\"\"Raised when input to cipher operations is invalid.\"\"\"\n    pass\n\nclass PersistenceError(Exception):\n    \"\"\"Raised when an error occurs during log persistence.\"\"\"\n    pass\n```\n```\n# src/shift_cipher/utils.py\n\"\"\"\nUtility functions and classes for validation and timestamps.\n\"\"\"\nimport re\nfrom datetime import datetime\n\nclass Validator:\n    \"\"\"Provides methods for validating input strings.\"\"\"\n    @staticmethod\n    def is_lowercase_alpha(s: str) -> bool:\n        \"\"\"Checks if a string is non-empty and contains only lowercase a-z characters.\"\"\"\n        return bool(s) and bool(re.fullmatch(r\"[a-z]+\", s))\n\ndef current_iso_timestamp() -> str:\n    \"\"\"Returns the current UTC time as an ISO 8601 string with milliseconds and 'Z' suffix.\"\"\"\n    return datetime.utcnow().isoformat(timespec=\"milliseconds\") + \"Z\"\n```\n```\n# src/shift_cipher/core.py\n\"\"\"\nCore logic for encoding and decoding strings using a shift cipher.\n\"\"\"\nfrom .exceptions import InvalidInputError\n\nDEFAULT_SHIFT = 5\nALPHA_START = ord(\"a\")\nALPHA_LEN = 26\n\nclass CipherCore:\n    \"\"\"Performs the actual character shifting for encoding and decoding.\"\"\"\n    def __init__(self, shift: int = DEFAULT_SHIFT) -> None:\n        self.shift: int = shift\n\n    def encode(self, s: str) -> str:\n        \"\"\"\n        Shifts each character in the string forward by the configured shift amount.\n        Raises InvalidInputError if a character is not a lowercase alphabet.\n        \"\"\"\n        encoded_chars = []\n        for ch in s:\n            if not ('a' <= ch <= 'z'):\n                raise InvalidInputError(f\"Character '{ch}' is not a lowercase alphabet.\")\n            shifted_ord = ((ord(ch) + self.shift - ALPHA_START) % ALPHA_LEN) + ALPHA_START\n            encoded_chars.append(chr(shifted_ord))\n        return \"\".join(encoded_chars)\n\n    def decode(self, s: str) -> str:\n        \"\"\"\n        Shifts each character in the string backward by the configured shift amount.\n        Raises InvalidInputError if a character is not a lowercase alphabet.\n        \"\"\"\n        decoded_chars = []\n        for ch in s:\n            if not ('a' <= ch <= 'z'):\n                raise InvalidInputError(f\"Character '{ch}' is not a lowercase alphabet.\")\n            shifted_ord = ((ord(ch) - self.shift - ALPHA_START) % ALPHA_LEN) + ALPHA_START\n            decoded_chars.append(chr(shifted_ord))\n        return \"\".join(decoded_chars)\n\ndef encode_shift(s: str) -> str:\n    \"\"\"\n    Returns an encoded string by shifting every character by 5 in the alphabet.\n    This function is a direct wrapper around CipherCore for convenience.\n    \"\"\"\n    return CipherCore().encode(s)\n\ndef decode_shift(s: str) -> str:\n    \"\"\"\n    Takes as input a string encoded with encode_shift function and returns the decoded string.\n    This function is a direct wrapper around CipherCore for convenience.\n    \"\"\"\n    return CipherCore().decode(s)\n```\n```\n# src/shift_cipher/models.py\n\"\"\"\nData Transfer Objects (DTOs) for operation records.\n\"\"\"\nimport json\nfrom dataclasses import dataclass\n\n@dataclass\nclass OperationRecord:\n    \"\"\"Represents a single operation record for logging.\"\"\"\n    timestamp: str\n    operation: str\n    input: str\n    output: str\n\n    def to_json(self) -> dict:\n        \"\"\"Converts the OperationRecord instance to a dictionary for JSON serialization.\"\"\"\n        return self.__dict__\n\n    @staticmethod\n    def from_json(d: dict) -> \"OperationRecord\":\n        \"\"\"Constructs an OperationRecord instance from a dictionary.\"\"\"\n        return OperationRecord(\n            timestamp=d[\"timestamp\"],\n            operation=d[\"operation\"],\n            input=d[\"input\"],\n            output=d[\"output\"]\n        )\n```\n```\n# src/shift_cipher/repositories.py\n\"\"\"\nPersistence layer for logging operation records to a file.\n\"\"\"\nimport json\nimport os\nfrom collections import deque\nfrom .models import OperationRecord\nfrom .exceptions import PersistenceError\n\nclass LogRepository:\n    \"\"\"Manages the persistence of operation records to a JSON-lines file with rotation.\"\"\"\n    DEFAULT_LOG_PATH = \"./shift_cipher_logs.jsonl\"\n    DEFAULT_MAX_BYTES = 5_000_000  # 5 MB\n    DEFAULT_MAX_FILES = 5\n\n    def __init__(self, path: str = DEFAULT_LOG_PATH) -> None:\n        self.path = path\n\n    def append(self, record: OperationRecord) -> None:\n        \"\"\"Appends an operation record as a JSON line to the log file.\"\"\"\n        line = json.dumps(record.to_json(), ensure_ascii=False)\n        try:\n            with open(self.path, \"a\", encoding=\"utf-8\") as f:\n                f.write(line + \"\\n\")\n        except OSError as ex:\n            raise PersistenceError(f\"Failed to append to log file '{self.path}': {ex}\") from ex\n\n    def rotate_if_needed(self, max_bytes: int = DEFAULT_MAX_BYTES, max_files: int = DEFAULT_MAX_FILES) -> None:\n        \"\"\"Rotates the log file if its size exceeds max_bytes, keeping a limited number of files.\"\"\"\n        try:\n            if not os.path.exists(self.path):\n                return\n\n            if os.path.getsize(self.path) > max_bytes:\n                # Delete oldest file if max_files limit is reached\n                if os.path.exists(f\"{self.path}.{max_files - 1}\"):\n                    os.remove(f\"{self.path}.{max_files - 1}\")\n\n                # Shift existing numbered files (e.g., .2 becomes .3, .1 becomes .2)\n                for i in range(max_files - 2, 0, -1):\n                    old_name = f\"{self.path}.{i}\"\n                    new_name = f\"{self.path}.{i + 1}\"\n                    if os.path.exists(old_name):\n                        os.rename(old_name, new_name)\n\n                # Rename current log file to .1\n                os.rename(self.path, f\"{self.path}.1\")\n\n        except OSError as ex:\n            print(f\"Warning: Log rotation failed for '{self.path}': {ex}\")\n        except Exception as ex:\n            print(f\"Warning: Unexpected error during log rotation for '{self.path}': {ex}\")\n\n    def read_all(self) -> list[OperationRecord]:\n        \"\"\"Reads all operation records from the log file and returns them as a list.\"\"\"\n        records: list[OperationRecord] = []\n        try:\n            if not os.path.exists(self.path):\n                return []\n            with open(self.path, \"r\", encoding=\"utf-8\") as f:\n                for line in f:\n                    if line.strip():\n                        data = json.loads(line)\n                        records.append(OperationRecord.from_json(data))\n        except (OSError, json.JSONDecodeError) as ex:\n            raise PersistenceError(f\"Failed to read log file '{self.path}': {ex}\") from ex\n        return records\n```\n```\n# src/shift_cipher/services.py\n\"\"\"\nService layer for orchestrating cipher operations, validation, and logging.\n\"\"\"\nfrom .core import CipherCore\nfrom .repositories import LogRepository\nfrom .utils import Validator, current_iso_timestamp\nfrom .models import OperationRecord\nfrom .exceptions import InvalidInputError, PersistenceError\n\nclass CipherService:\n    \"\"\"\n    Orchestrates cipher operations, including input validation, core transformation,\n    and logging to a persistent store.\n    \"\"\"\n    def __init__(\n        self,\n        repo: LogRepository,\n        core: CipherCore,\n        validator: Validator,\n        rotate_max_bytes: int | None = None,\n        rotate_max_files: int | None = None\n    ) -> None:\n        self.repo = repo\n        self.core = core\n        self.validator = validator\n        self.rotate_max_bytes = rotate_max_bytes if rotate_max_bytes is not None else repo.DEFAULT_MAX_BYTES\n        self.rotate_max_files = rotate_max_files if rotate_max_files is not None else repo.DEFAULT_MAX_FILES\n\n    def encode(self, s: str) -> str:\n        \"\"\"\n        Validates input, encodes the string, and records the operation.\n        Raises InvalidInputError for invalid input or PersistenceError on logging failure.\n        \"\"\"\n        if not self.validator.is_lowercase_alpha(s):\n            raise InvalidInputError(\"Input must be lowercase a-z only.\")\n\n        output = self.core.encode(s)\n        self._record_operation(operation=\"encode\", input=s, output=output)\n        return output\n\n    def decode(self, s: str) -> str:\n        \"\"\"\n        Validates input, decodes the string, and records the operation.\n        Raises InvalidInputError for invalid input or PersistenceError on logging failure.\n        \"\"\"\n        if not self.validator.is_lowercase_alpha(s):\n            raise InvalidInputError(\"Input must be lowercase a-z only.\")\n\n        output = self.core.decode(s)\n        self._record_operation(operation=\"decode\", input=s, output=output)\n        return output\n\n    def _record_operation(self, operation: str, input: str, output: str) -> None:\n        \"\"\"Helper to create an OperationRecord and append it to the repository.\"\"\"\n        try:\n            record = OperationRecord(\n                timestamp=current_iso_timestamp(),\n                operation=operation,\n                input=input,\n                output=output\n            )\n            self.repo.append(record)\n            self.repo.rotate_if_needed(self.rotate_max_bytes, self.rotate_max_files)\n        except PersistenceError as e:\n            raise PersistenceError(f\"Failed to log operation: {e}\") from e\n```\n```\n# src/shift_cipher/controllers.py\n\"\"\"\nCommand-line interface controller to handle user requests.\n\"\"\"\nimport sys\n\nfrom .services import CipherService\nfrom .exceptions import InvalidInputError, PersistenceError\n\nclass CLIController:\n    \"\"\"Handles CLI commands by interacting with the CipherService.\"\"\"\n    def __init__(self, service: CipherService) -> None:\n        self.service = service\n\n    def handle_encode(self, text: str) -> int:\n        \"\"\"Encodes text from CLI, prints result, and handles errors.\"\"\"\n        try:\n            encoded_text = self.service.encode(text)\n            print(encoded_text)\n            return 0\n        except InvalidInputError as e:\n            print(f\"Error: {e}\", file=sys.stderr)\n            return 2\n        except PersistenceError as e:\n            print(f\"Warning: Failed to log operation: {e}\", file=sys.stderr)\n            print(\"Operation completed successfully, but logging failed.\", file=sys.stderr)\n            return 0\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n\n    def handle_decode(self, text: str) -> int:\n        \"\"\"Decodes text from CLI, prints result, and handles errors.\"\"\"\n        try:\n            decoded_text = self.service.decode(text)\n            print(decoded_text)\n            return 0\n        except InvalidInputError as e:\n            print(f\"Error: {e}\", file=sys.stderr)\n            return 2\n        except PersistenceError as e:\n            print(f\"Warning: Failed to log operation: {e}\", file=sys.stderr)\n            print(\"Operation completed successfully, but logging failed.\", file=sys.stderr)\n            return 0\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n```\n```\n# src/shift_cipher/cli.py\n\"\"\"\nCommand-line interface entry point for the shift-cipher application.\n\"\"\"\nimport argparse\nimport sys\n\nfrom .core import CipherCore\nfrom .services import CipherService\nfrom .controllers import CLIController\nfrom .repositories import LogRepository\nfrom .utils import Validator\n\ndef main(argv: list[str] | None = None) -> int:\n    \"\"\"\n    Main entry point for the shift-cipher CLI application.\n    Parses arguments, sets up components, and dispatches commands.\n    \"\"\"\n    parser = argparse.ArgumentParser(\n        description=\"Encode or decode text using a shift cipher.\",\n        formatter_class=argparse.RawTextHelpFormatter\n    )\n\n    subparsers = parser.add_subparsers(dest=\"command\", required=True, help=\"Available commands\")\n\n    encode_parser = subparsers.add_parser(\n        \"encode\",\n        help=\"Encode a string by shifting characters +5 positions.\"\n    )\n    encode_parser.add_argument(\n        \"text\",\n        type=str,\n        help=\"The lowercase alphabetic string to encode.\"\n    )\n\n    decode_parser = subparsers.add_parser(\n        \"decode\",\n        help=\"Decode a string by shifting characters -5 positions.\"\n    )\n    decode_parser.add_argument(\n        \"text\",\n        type=str,\n        help=\"The lowercase alphabetic string to decode.\"\n    )\n\n    args = parser.parse_args(argv)\n\n    log_repo = LogRepository()\n    cipher_core = CipherCore()\n    validator = Validator()\n    cipher_service = CipherService(repo=log_repo, core=cipher_core, validator=validator)\n    cli_controller = CLIController(service=cipher_service)\n\n    if args.command == \"encode\":\n        return cli_controller.handle_encode(args.text)\n    elif args.command == \"decode\":\n        return cli_controller.handle_decode(args.text)\n    else:\n        parser.print_help(sys.stderr)\n        return 1\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n```"}
