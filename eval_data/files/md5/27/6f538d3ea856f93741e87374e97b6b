{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    The sequence stops when it reaches 1, and the returned list contains unique, sorted odd numbers.\n    \"\"\"\n    odd_numbers = set()\n    current_val = n\n    while True:\n        if current_val % 2 == 1:\n            odd_numbers.add(current_val)\n        if current_val == 1:\n            break\n        if current_val % 2 == 0:\n            current_val = current_val // 2\n        else:\n            current_val = 3 * current_val + 1\n    \n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list of the distinct odd numbers\n    in its Collatz sequence.\n    \"\"\"\n    sequence = []\n    current = n\n    while True:\n        sequence.append(current)\n        if current == 1:\n            break\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n    \n    odd_numbers = [x for x in sequence if x % 2 == 1]\n    return sorted(list(set(odd_numbers)))"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"Validates a date string in mm-dd-yyyy format according to specific rules.\n    Returns True for a valid date, False otherwise.\n    \"\"\"\n    # 1. The date string is not empty.\n    if not date:\n        return False\n\n    # 4. The date should be in the format: mm-dd-yyyy\n    parts = date.split('-')\n    if len(parts) != 3:\n        return False\n\n    m_str, d_str, y_str = parts\n\n    # Year must be exactly 4 digits. Month and day can be 1 or 2 digits.\n    if len(y_str) != 4:\n        return False\n\n    # Attempt to convert parts to integers.\n    try:\n        month = int(m_str)\n        day = int(d_str)\n        year = int(y_str) # Year value is parsed but not used for leap year in day validation.\n    except ValueError:\n        return False # Non-numeric components.\n\n    # 3. The months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # 2. Day validation: not less than 1 or higher than allowed days for month.\n    if day < 1:\n        return False\n\n    if month in [1, 3, 5, 7, 8, 10, 12]:\n        if day > 31:\n            return False\n    elif month in [4, 6, 9, 11]:\n        if day > 30:\n            return False\n    elif month == 2: # Month 2 (February) is capped at 29 days per requirement.\n        if day > 29:\n            return False\n\n    return True"}
{"task_id": "HumanEval/124", "solution": "```python\ndef valid_date(date):\n    \"\"\"Validates a date string in mm-dd-yyyy format.\n    Returns True if valid, False otherwise, based on month, day, and year ranges.\n    \"\"\"\n    if not date:\n        return False\n\n    parts = date.split('-')\n    if len(parts) != 3:\n        return False\n\n    try:\n        month = int(parts[0])\n        day = int(parts[1])\n        year = int(parts[2])\n    except ValueError:\n        return False\n\n    # Validate month range (1 to 12)\n    if not (1 <= month <= 12):\n        return False\n\n    # Validate day range based on month (February up to 29, no leap year check)\n    month_max_days = {\n        1: 31, 2: 29, 3: 31, 4: 30, 5: 31, 6: 30,\n        7: 31, 8: 31, 9: 30, 10: 31, 11: 30, 12: 31\n    }\n    \n    # Use .get() with a default that will cause the day check to fail for invalid months.\n    max_day_for_month = month_max_days.get(month, 0) \n    \n    if not (1 <= day <= max_day_for_month):\n        return False\n\n    # Year validation (must be non-negative as per assumption)\n    if year < 0:\n        return False\n\n    return True\n```"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits text based on whitespace, then commas, or counts odd-order lowercase letters.\n    Follows a strict precedence for splitting and counting.\n    \"\"\"\n    # Check for whitespace first\n    if any(c.isspace() for c in txt):\n        return txt.split()\n\n    # If no whitespace, check for commas\n    if ',' in txt:\n        # Split by comma, trim each token, and remove empty tokens\n        return [token.strip() for token in txt.split(',') if token.strip()]\n\n    # If neither whitespace nor commas, count lowercase letters with odd alphabet order\n    count = 0\n    base_ord_a = ord('a')\n    for char in txt:\n        if 'a' <= char <= 'z':\n            # Alphabet order is 0-indexed (a=0, b=1, ...)\n            if (ord(char) - base_ord_a) % 2 == 1:\n                count += 1\n    return count"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits text by whitespace, then commas, or counts odd-order lowercase letters.\n    The order of operations is whitespace > commas > counting.\n    \"\"\"\n    # Rule 1: Split on whitespace if any is present.\n    has_whitespace = False\n    for char in txt:\n        if char.isspace():\n            has_whitespace = True\n            break\n    if has_whitespace:\n        return txt.split()\n\n    # Rule 2: If no whitespace, split on commas if any are present.\n    if ',' in txt:\n        parts = []\n        for part in txt.split(','):\n            stripped_part = part.strip()\n            if stripped_part:  # Filter out empty strings after stripping\n                parts.append(stripped_part)\n        return parts\n\n    # Rule 3: If neither, count lowercase letters with odd alphabet order.\n    count = 0\n    # 'a' is at index 0, 'b' at 1, etc.\n    for char in txt:\n        if 'a' <= char <= 'z':\n            # Calculate alphabet order (0-indexed)\n            order = ord(char) - ord('a')\n            if order % 2 == 1:\n                count += 1\n    return count"}
{"task_id": "HumanEval/126", "solution": "```python\n# src/sortedchecker/__init__.py\n__version__ = \"0.1.0\"\n\nfrom .exceptions import ValidationError\nfrom .services import SortedCheckerService\nfrom .validators import InputValidator\n\n# Primary programmatic API entry point\ndef is_sorted(lst):\n    \"\"\"\n    Checks if a list of non-negative integers is sorted ascending,\n    allowing values to appear at most twice.\n    \"\"\"\n    validator = InputValidator()\n    service = SortedCheckerService(validator)\n    return service.is_sorted(lst)\n\n__all__ = [\"is_sorted\", \"ValidationError\", \"SortedCheckerService\", \"InputValidator\"]\n\n```python\n# src/sortedchecker/models.py\nfrom typing import Sequence, List\n\nclass SortedRequest:\n    \"\"\"\n    DTO for input lists, primarily used for packaging data in controllers.\n    \"\"\"\n    def __init__(self, values: Sequence[int]) -> None:\n        self.values: List[int] = list(values)\n\nclass SortedResult:\n    \"\"\"\n    DTO for the boolean result of the sorted check.\n    \"\"\"\n    def __init__(self, is_sorted: bool) -> None:\n        self.is_sorted: bool = is_sorted\n\n```python\n# src/sortedchecker/exceptions.py\nclass ValidationError(Exception):\n    \"\"\"\n    Custom exception raised for invalid inputs or data formats.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n```python\n# src/sortedchecker/validators.py\nfrom typing import Sequence, Any, Optional\nfrom .exceptions import ValidationError\n\nclass InputValidator:\n    \"\"\"\n    Handles validation of input lists and individual elements.\n    Ensures elements are non-negative integers.\n    \"\"\"\n    ALLOWED_TYPE = int\n\n    def __init__(self, max_value: Optional[int] = None) -> None:\n        self._max_value = max_value\n\n    def validate_list(self, lst: Sequence[int]) -> None:\n        \"\"\"\n        Validates that the input is a sequence and all its elements\n        are non-negative integers within optional bounds.\n        \"\"\"\n        if not isinstance(lst, Sequence):\n            raise ValidationError(\"Input must be a sequence (e.g., list, tuple) of integers.\")\n        \n        for idx, v in enumerate(lst):\n            self.validate_element(v, idx)\n            if self._max_value is not None and v > self._max_value:\n                raise ValidationError(f\"Value at index {idx} ({v}) exceeds max allowed value ({self._max_value}).\")\n\n    def validate_element(self, value: Any, index: Optional[int] = None) -> None:\n        \"\"\"\n        Validates a single element to be a non-negative integer.\n        \"\"\"\n        location_str = f\"at index {index}\" if index is not None else \"\"\n        if not isinstance(value, self.ALLOWED_TYPE):\n            raise ValidationError(f\"Element {location_str} must be an integer, got {type(value).__name__}.\")\n        if value < 0:\n            raise ValidationError(f\"Element {location_str} ({value}) must be non-negative.\")\n\n```python\n# src/sortedchecker/services.py\nfrom typing import Sequence, List, Dict\nfrom collections import Counter\nfrom .validators import InputValidator\nfrom .exceptions import ValidationError\n\nclass SortedCheckerService:\n    \"\"\"\n    Implements the core business logic for checking sorted order and duplicate rules.\n    \"\"\"\n    def __init__(self, validator: InputValidator) -> None:\n        self._validator = validator\n\n    def is_sorted(self, lst: Sequence[int]) -> bool:\n        \"\"\"\n        Checks if the given list is sorted ascending (non-decreasing) and\n        if no value appears more than twice.\n        \"\"\"\n        self._validator.validate_list(lst)\n        values: List[int] = list(lst) # Convert to list for consistent iteration and potential multiple passes\n\n        if not self._check_ascending(values):\n            return False\n        \n        if not self._check_duplicate_rule(values):\n            return False\n        \n        return True\n\n    def _check_ascending(self, values: List[int]) -> bool:\n        \"\"\"\n        Private helper to check for non-decreasing order.\n        \"\"\"\n        if not values:\n            return True  # An empty list is considered sorted\n\n        for i in range(len(values) - 1):\n            if values[i] > values[i+1]:\n                return False\n        return True\n\n    def _check_duplicate_rule(self, values: List[int]) -> bool:\n        \"\"\"\n        Private helper to check if any value appears more than twice.\n        \"\"\"\n        counts: Dict[int, int] = Counter(values)\n        for count in counts.values():\n            if count > 2:\n                return False\n        return True\n\n```python\n# src/sortedchecker/controllers.py\nimport sys\nimport argparse\nfrom typing import Sequence, List\nfrom .services import SortedCheckerService\nfrom .exceptions import ValidationError\nfrom .utils import parse_list_arg\n\nclass CLIController:\n    \"\"\"\n    Controller responsible for parsing CLI arguments, invoking the service,\n    and printing results or error messages.\n    \"\"\"\n    def __init__(self, service: SortedCheckerService) -> None:\n        self._service = service\n\n    def parse_args(self, argv: Sequence[str]) -> List[int]:\n        \"\"\"\n        Parses command line arguments to extract the list of integers.\n        Supports space- or comma-separated lists, and reading from stdin.\n        \"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"sorted-checker\",\n            description=\"Check if a list of non-negative integers is sorted ascending with a duplicate rule.\",\n            epilog=\"Example: sorted-checker 1 2 2 3 or sorted-checker \\\"1,2,3,4\\\"\"\n        )\n        parser.add_argument(\n            \"numbers\",\n            nargs=\"*\",\n            help=\"Space- or comma-separated list of non-negative integers. If multiple arguments are given, they are joined