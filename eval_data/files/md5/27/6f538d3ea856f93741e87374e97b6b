ime_utils):\n    \"\"\"FactorizationService without persistence.\"\"\"\n    with patch('prime_factor.services.PrimeUtils', return_value=mock_prime_utils):\n        service = FactorizationService(cache=in_memory_cache, persistence=None)\n        yield service\n\n@pytest.fixture\ndef service_with_persistence(in_memory_cache, file_cache, mock_prime_utils):\n    \"\"\"FactorizationService with file persistence.\"\"\"\n    with patch('prime_factor.services.PrimeUtils', return_value=mock_prime_utils):\n        service = FactorizationService(cache=in_memory_cache, persistence=file_cache)\n        yield service\n\n# --- largest_prime_factor tests ---\n\ndef test_largest_prime_factor_valid_inputs(service_no_persistence):\n    \"\"\"Test largest_prime_factor with standard valid inputs.\"\"\"\n    assert service_no_persistence.largest_prime_factor(13195) == 29\n    assert service_no_persistence.largest_prime_factor(2048) == 2\n    assert service_no_persistence.largest_prime_factor(7) == 7 # prime input\n    assert service_no_persistence.largest_prime_factor(6) == 3\n    assert service_no_persistence.largest_prime_factor(997) == 997\n\ndef test_largest_prime_factor_invalid_inputs(service_no_persistence):\n    \"\"\"Test largest_prime_factor with invalid inputs.\"\"\"\n    with pytest.raises(InvalidInputError, match=\"n must be integer >= 2\"):\n        service_no_persistence.largest_prime_factor(1)\n    with pytest.raises(InvalidInputError, match=\"n must be integer >= 2\"):\n        service_no_persistence.largest_prime_factor(0)\n    with pytest.raises(InvalidInputError, match=\"n must be integer >= 2\"):\n        service_no_persistence.largest_prime_factor(-5)\n    with pytest.raises(InvalidInputError, match=\"n must be integer >= 2\"):\n        service_no_persistence.largest_prime_factor(3.14)\n    with pytest.raises(InvalidInputError, match=\"n must be integer >= 2\"):\n        service_no_persistence.largest_prime_factor(\"abc\")\n\ndef test_largest_prime_factor_cache_hit(service_no_persistence, in_memory_cache):\n    \"\"\"Test that largest_prime_factor uses the cache.\"\"\"\n    service_no_persistence.largest_prime_factor(13195)\n    assert in_memory_cache.get(13195) == 29\n    service_no_persistence._prime_utils.trial_division_factors.reset_mock() # Reset mock call count\n    \n    # Second call should hit cache\n    assert service_no_persistence.largest_prime_factor(13195) == 29\n    service_no_persistence._prime_utils.trial_division_factors.assert_not_called()\n\ndef test_largest_prime_factor_persistence(service_with_persistence, file_cache_path):\n    \"\"\"Test that largest_prime_factor persists results to file.\"\"\"\n    # Ensure file does not exist initially\n    assert not os.path.exists(file_cache_path)\n\n    service_with_persistence.largest_prime_factor(13195)\n    \n    assert os.path.exists(file_cache_path)\n    with open(file_cache_path, 'r', encoding='utf-8') as f:\n        data = json.load(f)\n    \n    assert data[\"version\"] == 1\n    assert \"13195\" in data[\"entries\"]\n    assert data[\"entries\"][\"13195\"][\"largest_prime\"] == 29\n\ndef test_largest_prime_factor_persistence_load_on_init(file_cache_path, mock_prime_utils):\n    \"\"\"Test that FactorizationService loads cache from file on initialization.\"\"\"\n    # Pre-populate cache file\n    initial_cache_data = {\n        \"version\": 1,\n        \"created_at\": datetime.now().isoformat(),\n        \"entries\": {\n            \"100\": {\"largest_prime\": 5, \"computed_at\": datetime.now().isoformat()},\n            \"125\": {\"largest_prime\": 5, \"computed_at\": datetime.now().isoformat()}\n        }\n    }\n    with open(file_cache_path, 'w', encoding='utf-8') as f:\n        json.dump(initial_cache_data, f)\n    \n    # Initialize a new service instance\n    in_memory_cache = InMemoryCache(max_size=10)\n    file_cache = FileCache(path=file_cache_path)\n    \n    with patch('prime_factor.services.PrimeUtils', return_value=mock_prime_utils):\n        service = FactorizationService(cache=in_memory_cache, persistence=file_cache)\n        # Manually trigger load if not automatically done by service. (It's done in CLI/API init)\n        loaded_store = file_cache.load()\n        for n_str, p_data in loaded_store.items():\n            in_memory_cache.put(int(n_str), p_data['largest_prime'])\n\n        assert in_memory_cache.get(100) == 5\n        assert in_memory_cache.get(125) == 5\n        \n        # Ensure it doesn't recompute\n        service._prime_utils.trial_division_factors.reset_mock()\n        assert service.largest_prime_factor(100) == 5\n        service._prime_utils.trial_division_factors.assert_not_called()\n\ndef test_largest_prime_factor_persistence_failure_logs_and_continues(service_with_persistence, in_memory_cache, caplog):\n    \"\"\"Test that persistence failures are logged but don't stop execution.\"\"\"\n    # Mock FileCache.persist to raise an exception\n    service_with_persistence._persistence.persist = MagicMock(side_effect=IOError(\"Disk full!\"))\n    \n    with caplog.at_level(logging.WARNING):\n        result = service_with_persistence.largest_prime_factor(13195)\n    \n    assert result == 29\n    assert in_memory_cache.get(13195) == 29\n    assert \"Failed to persist cache\" in caplog.text\n    assert \"Disk full!\" in caplog.text\n\n# --- factorize tests ---\n\ndef test_factorize_valid_inputs(service_no_persistence):\n    \"\"\"Test factorize with standard valid inputs.\"\"\"\n    result = service_no_persistence.factorize(13195)\n    assert result.n == 13195\n    assert result.largest_prime == 29\n    assert result.factors == [5, 7, 13, 29]\n    assert isinstance(result.computed_at, datetime)\n\n    result = service_no_persistence.factorize(2048)\n    assert result.n == 2048\n    assert result.largest_prime == 2\n    assert result.factors == [2] * 11\n\ndef test_factorize_invalid_inputs(service_no_persistence):\n    \"\"\"Test factorize with invalid inputs.\"\"\"\n    with pytest.raises(InvalidInputError, match=\"n must be integer >= 2\"):\n        service_no_persistence.factorize(1)\n    with pytest.raises(InvalidInputError, match=\"n must be integer >= 2\"):\n        service_no_persistence.factorize(-10)\n\ndef test_factorize_updates_cache(service_no_persistence, in_memory_cache):\n    \"\"\"Test that factorize updates the in-memory cache.\"\"\"\n    assert in_memory_cache.get(12345) is None\n    service_no_persistence.factorize(12345)\n    assert in_memory_cache.get(12345) == 823\n\ndef test_factorize_persistence(service_with_persistence, file_cache_path):\n    \"\"\"Test that factorize also triggers persistence.\"\"\"\n    assert not os.path.exists(file_cache_path)\n    service_with_persistence.factorize(12345)\n    assert os.path.exists(file_cache_path)\n    with open(file_cache_path, 'r', encoding='utf-8') as f:\n        data = json.load(f)\n    assert \"12345\" in data[\"entries\"]\n    assert data[\"entries\"][\"12345\"][\"largest_prime\"] == 823\n\n```\n```python\n# tests/test_cache.py\nimport pytest\nimport os\nimport json\nimport time\nimport tempfile\nfrom datetime import datetime, timedelta\n\nfrom prime_factor.cache import InMemoryCache, FileCache\n\n# --- InMemoryCache Tests ---\n\ndef test_in_memory_cache_get_put():\n    \"\"\"Test basic put and get operations.\"\"\"\n    cache = InMemoryCache(max_size=2)\n    cache.put(10, 5)\n    assert cache.get(10) == 5\n    assert cache.get(20) is None\n\ndef test_in_memory_cache_eviction():\n    \"\"\"Test LRU eviction behavior.\"\"\"\n    cache = InMemoryCache(max_size=2)\n    cache.put(10, 5) # {10: 5}\n    cache.put(20, 2) # {10: 5, 20: 2}\n    cache.put(30, 3) # {20: 2, 30: 3} -- 10 should be evicted\n    assert cache.get(10) is None\n    assert cache.get(20) == 2\n    assert cache.get(30) == 3\n\n    cache.get(20) # {30: 3, 20: 2} -- 20 becomes most recent\n    cache.put(40, 4) # {20: 2, 40: 4} -- 30 should be evicted\n    assert cache.get(30) is None\n    assert cache.get(20) == 2\n    assert cache.get(40) == 4\n\ndef test_in_memory_cache_clear():\n    \"\"\"Test clearing the cache.\"\"\"\n    cache = InMemoryCache(max_size=2)\n    cache.put(10, 5)\n    cache.put(20, 2)\n    cache.clear()\n    assert cache.get(10) is None\n    assert cache.get(20) is None\n    assert len(cache._store) == 0\n\ndef test_in_memory_cache_update_existing():\n    \"\"\"Test updating an existing entry.\"\"\"\n    cache = InMemoryCache(max_size=2)\n    cache.put(10, 5)\n    cache.put(10, 7) # Update 10\n    assert cache.get(10) == 7\n    assert len(cache._store) == 1 # Size should remain 1\n\ndef test_in_memory_cache_store_snapshot():\n    \"\"\"Test store_snapshot returns a copy.\"\"\"\n    cache = InMemoryCache(max_size=10)\n    cache.put(10, 2)\n    snapshot = cache.store_snapshot\n    assert snapshot == {10: 2}\n    cache.put(20, 3)\n    assert snapshot == {10: 2} # Snapshot should not change\n\n# --- FileCache Tests ---\n\n@pytest.fixture\ndef temp_cache_file():\n    \"\"\"Provides a temporary file path for FileCache, ensuring cleanup.\"\"\"\n    with tempfile.TemporaryDirectory() as tmpdir:\n        yield os.path.join(tmpdir, \"test_file_cache.json\")\n\ndef test_file_cache_load_empty_file(temp_cache_file):\n    \"\"\"Test loading from a non-existent file.\"\"\"\n    file_cache = FileCache(path=temp_cache_file)\n    store = file_cache.load()\n    assert store == {}\n    assert not os.path.exists(temp_cache_file)\n\ndef test_file_cache_persist_and_load(temp_cache_file):\n    \"\"\"Test persisting data and then loading it back.\"\"\"\n    file_cache = FileCache(path=temp_cache_file)\n    \n    # Simulate a cache store to persist\n    initial_store = {\n        13195: 29,\n        2048: 2,\n        997: 997,\n    }\n    file_cache.persist(initial_store)\n\n    assert os.path.exists(temp_cache_file)\n    \n    # Now, load from the file\n    loaded_data = file_cache.load()\n    \n    # The loaded data is the raw dictionary from entries, keys are strings\n    expected_entries = {\n        \"13195\": {\"largest_prime\": 29, \"computed_at\": loaded_data[\"13195\"][\"computed_at\"]},\n        \"2048\": {\"largest_prime\": 2, \"computed_at\": loaded_data[\"2048\"][\"computed_at\"]},\n        \"997\": {\"largest_prime\": 997, \"computed_at\": loaded_data[\"997\"][\"computed_at\"]},\n    }\n    assert loaded_data == expected_entries\n\ndef test_file_cache_load_invalid_json(temp_cache_file, caplog):\n    \"\"\"Test loading from a file with invalid JSON.\"\"\"\n    with open(temp_cache_file, 'w', encoding='utf-8') as f:\n        f.write(\"{invalid json\")\n    \n    file_cache = FileCache(path=temp_cache_file)\n    with caplog.at_level(logging.ERROR):\n        store = file_cache.load()\n    \n    assert store == {}\n    assert \"Failed to decode JSON\" in caplog.text\n\ndef test_file_cache_persist_failure_logs_and_continues(temp_cache_file, caplog):\n    \"\"\"Test that persistence failures are logged but don't raise.\"\"\"\n    file_cache = FileCache(path=temp_cache_file)\n    \n    # Make the directory read-only to simulate a write error\n    if os.path.exists(os.path.dirname(temp_cache_file)):\n        os.chmod(os.path.dirname(temp_cache_file), 0o555) # r-xr-xr-x\n    \n    initial_store = {100: 5}\n    with caplog.at_level(logging.ERROR):\n        file_cache.persist(initial_store)\n    \n    assert \"Failed to persist cache\" in caplog.text\n    assert not os.path.exists(temp_cache_file) # Should not have created the file\n\n    # Reset permissions for cleanup\n    if os.path.exists(os.path.dirname(temp_cache_file)):\n        os.chmod(os.path.dirname(temp_cache_file), 0o777)\n\ndef test_file_cache_atomic_write(temp_cache_file):\n    \"\"\"Test atomic write ensures integrity during persistence.\"\"\"\n    file_cache = FileCache(path=temp_cache_file)\n    \n    store1 = {1: 10, 2: 20}\n    file_cache.persist(store1)\n    \n    # Simulate a crash during writing by not deleting the temporary file\n    # This is hard to test directly without mocking os.replace to fail after writing tmp\n    # Instead, we check the outcome. If os.replace works, the main file is correct.\n    # If it fails, the temp file *might* remain, but the original file should be intact.\n\n    # Modify the original store to simulate an update\n    store2 = {1: 10, 3: 30, 4: 40}\n    file_cache.persist(store2)\n\n    # Check the final file content\n    loaded_data = file_cache.load()\n    expected_entries = {\n        \"1\": {\"largest_prime\": 10, \"computed_at\": loaded_data[\"1\"][\"computed_at\"]},\n        \"3\": {\"largest_prime\": 30, \"computed_at\": loaded_data[\"3\"][\"computed_at\"]},\n        \"4\": {\"largest_prime\": 40, \"computed_at\": loaded_data[\"4\"][\"computed_at\"]},\n    }\n    assert loaded_data == expected_entries\n    assert not any(f.endswith(\".tmp\") for f in os.listdir(os.path.dirname(temp_cache_file)))\n\ndef test_file_cache_old_format_load(temp_cache_file, caplog):\n    \"\"\"Test loading from an older cache file format (flat dict).\"\"\"\n    # Simulate an old format file (e.g., just a dict of {int: int})\n    old_format_data = {\n        \"10\": 5,\n        \"20\": 2\n    }\n    with open(temp_cache_file, 'w', encoding='utf-8') as f:\n        json.dump(old_format_data, f)\n    \n    file_cache = FileCache(path=temp_cache_file)\n    with caplog.at_level(logging.WARNING):\n        loaded_store = file_cache.load()\n    \n    assert loaded_store == {\"10\": 5, \"20\": 2}\n    assert \"Invalid or old cache file format\" in caplog.text\n\n    # Test loading from a slightly newer old format (with 'entries' but no 'version' or wrong version)\n    old_format_with_entries = {\n        \"entries\": {\n            \"30\": 3,\n            \"40\": 4\n        }\n    }\n    with open(temp_cache_file, 'w', encoding='utf-8') as f:\n        json.dump(old_format_with_entries, f)\n    \n    file_cache = FileCache(path=temp_cache_file)\n    with caplog.at_level(logging.WARNING):\n        loaded_store = file_cache.load()