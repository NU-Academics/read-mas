wo lists of match scores and returns per-match absolute differences.\n    If guessed correctly, the value is 0, otherwise it's the absolute difference.\n    \"\"\"\n    return [abs(a - b) for a, b in zip(game, guess)]\n\ndef main_cli() -> None:\n    \"\"\"Console scripts entry point for the CLI.\"\"\"\n    # CLI uses the full CompareService with validation and optional persistence\n    # Instantiate service without a repository initially, CLIController will manage it.\n    compare_svc = CompareService(repository=None, validator=Validator()) \n    cli_controller = CLIController(service=compare_svc)\n    \n    # Check if a default repository should be active based on config\n    if Config.PERSISTENCE_ENABLED and cli_controller.service.repository is None:\n        cli_controller.service.repository = FileRepository(Config.DEFAULT_STORAGE_PATH)\n\n    args = cli_controller.parse_args()\n    sys.exit(cli_controller.run(args))\n\ndef create_fastapi_app() -> FastAPI:\n    \"\"\"Factory function to create and return the FastAPI app.\"\"\"\n    # HTTP API also uses the full CompareService with validation and optional persistence\n    compare_svc = CompareService() # CompareService will handle repo instantiation based on Config.PERSISTENCE_ENABLED\n    api_controller = APIController(service=compare_svc)\n    return api_controller.create_app()\n\nif __name__ == '__main__':\n    # This block is not part of the generated 'bare function' but for testing the CLI entry point\n    # To test: python -m src.scorecompare.app compare --game \"1,2,3\" --guess \"1,2,0\"\n    # To run API: uvicorn src.scorecompare.app:create_fastapi_app --reload --port 8000\n    main_cli()\n```"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension for a class name based on letter case counts.\n    Returns the class name combined with the strongest extension.\n    \"\"\"\n    max_strength = -float('inf')\n    strongest_extension_name = \"\"\n\n    for ext in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in ext:\n            if 'A' <= char <= 'Z':  # Check for uppercase ASCII letters\n                cap_count += 1\n            elif 'a' <= char <= 'z':  # Check for lowercase ASCII letters\n                sm_count += 1\n        \n        current_strength = cap_count - sm_count\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = ext\n    \n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Computes the strength of extensions (CAP-SM), selects the strongest (or earliest on tie),\n    and returns the formatted string.\n    \"\"\"\n    strongest_extension_name = None\n    max_strength = float('-inf')\n\n    for ext in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in ext:\n            if 'A' <= char <= 'Z':\n                cap_count += 1\n            elif 'a' <= char <= 'z':\n                sm_count += 1\n        \n        current_strength = cap_count - sm_count\n        \n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = ext\n            \n    return f\"{class_name}.{strongest_extension_name}\""}
