{"task_id": "HumanEval/27", "solution": "```python\n# src/string_utils/__init__.py\n\"\"\"\nPackage exports for string_utils.\nProvides the core flip_case function and FlipCaseService.\n\"\"\"\nfrom .core import flip_case\nfrom .services import FlipCaseService\nfrom .exceptions import ValidationError\nfrom .dtos import FlipCaseRequest, FlipCaseResponse\n\n__all__ = [\"flip_case\", \"FlipCaseService\", \"ValidationError\", \"FlipCaseRequest\", \"FlipCaseResponse\"]\n\n```python\n# src/string_utils/core.py\n\"\"\"\nCore domain logic for character case flipping.\nContains stateless methods for single strings and batches.\n\"\"\"\nfrom typing import Iterable, Iterator\n\nDEFAULT_ENCODING = \"utf-8\"\n\nclass FlipCaseCore:\n    \"\"\"\n    Provides static methods for case flipping operations.\n    Handles individual strings and streams of strings.\n    \"\"\"\n    @staticmethod\n    def flip_case(text: str) -> str:\n        \"\"\"\n        Flips the case of each alphabetic character in a string.\n        Non-string inputs raise TypeError.\n        \"\"\"\n        if not isinstance(text, str):\n            raise TypeError(\"Input must be a string.\")\n        return text.swapcase()\n\n    @staticmethod\n    def flip_case_batch(lines: Iterable[str]) -> Iterator[str]:\n        \"\"\"\n        Processes an iterable of strings, flipping case for each line.\n        Yields flipped lines lazily.\n        \"\"\"\n        for line in lines:\n            yield FlipCaseCore.flip_case(line)\n\n# Module-level convenience function\ndef flip_case(text: str) -> str:\n    \"\"\"\n    Module-level function to flip the case of a single string.\n    Delegates to FlipCaseCore.flip_case.\n    \"\"\"\n    return FlipCaseCore.flip_case(text)\n\n```python\n# src/string_utils/services.py\n\"\"\"\nApplication service layer for case flipping operations.\nHandles validation, orchestration, and logging.\n\"\"\"\nimport logging\nfrom pathlib import Path\nfrom typing import Optional\n\nfrom .core import FlipCaseCore\nfrom .repository import FileRepository\nfrom .exceptions import ValidationError\nfrom .utils import validate_text\n\nclass FlipCaseService:\n    \"\"\"\n    Orchestrates string case flipping, including validation and file operations.\n    Injects FileRepository and a logger for testability and observability.\n    \"\"\"\n    def __init__(self, repo: Optional[FileRepository] = None, logger: Optional[logging.Logger] = None) -> None:\n        \"\"\"\n        Initializes the service with optional repository and logger dependencies.\n        Defaults to a new FileRepository and a logger for this module.\n        \"\"\"\n        self.repo = repo or FileRepository()\n        self.logger = logger or logging.getLogger(__name__)\n\n    def flip(self, text: str) -> str:\n        \"\"\"\n        Validates a single string and flips its case.\n        Raises ValidationError for invalid text.\n        \"\"\"\n        validate_text(text)\n        result = FlipCaseCore.flip_case(text)\n        self.logger.debug(\"Flipped string: input_len=%d, output_len=%d\", len(text), len(result))\n        return result\n\n    def flip_file(self, input_path: Path, output_path: Optional[Path] = None, encoding: str = \"utf-8\") -> Path:\n        \"\"\"\n        Reads an input file, flips case line by line, and writes to an output file.\n        If output_path is None, a temporary file is created and its path returned.\n        \"\"\"\n        if not input_path.is_file():\n            raise FileNotFoundError(f\"Input file not found: {input_path}\")\n        \n        # Use a temporary file for atomic write, then replace original or specified output.\n        actual_output_path = output_path or self.repo.safe_temp_path(prefix=\"flipped_\")\n        \n        try:\n            self.logger.info(\"Processing file: %s -> %s\", input_path, actual_output_path)\n            lines_iterator = self.repo.read(input_path, encoding=encoding)\n            processed_lines_iterator = FlipCaseCore.flip_case_batch(lines_iterator)\n            self.repo.write(actual_output_path, processed_lines_iterator, encoding=encoding)\n            self.logger.info(\"Successfully processed file: %s\", actual_output_path)\n        except OSError as e:\n            self.logger.error(\"File operation failed: %s\", e)\n            raise\n        except UnicodeDecodeError as e:\n            self.logger.error(\"Encoding error in input file '%s': %s\", input_path, e)\n            raise ValidationError(f\"Encoding error in input file: {e}. Try specifying --encoding.\")\n        \n        return actual_output_path\n\n```python\n# src/string_utils/dtos.py\n\"\"\"\nData Transfer Objects for request and response structures.\nUsed primarily for the HTTP API interface.\n\"\"\"\nfrom dataclasses import dataclass\n\n@dataclass\nclass FlipCaseRequest:\n    \"\"\"\n    Represents an incoming request to flip a string's case.\n    Contains the text to be processed.\n    \"\"\"\n    text: str\n\n@dataclass\nclass FlipCaseResponse:\n    \"\"\"\n    Represents the response containing the result of a case flip operation.\n    Contains the processed string.\n    \"\"\"\n    result: str\n\n```python\n# src/string_utils/repository.py\n\"\"\"\nFileRepository class for abstracting file system operations.\nProvides methods for reading, writing, and creating temporary files.\n\"\"\"\nfrom pathlib import Path\nfrom typing import Iterator, Iterable\nimport tempfile\nimport os\n\nclass FileRepository:\n    \"\"\"\n    Manages file I/O operations, ensuring safe and streaming access.\n    Implements atomic writes using temporary files.\n    \"\"\"\n    def read(self, path: Path, encoding: str = \"utf-8\") -> Iterator[str]:\n        \"\"\"\n        Reads a file line by line, yielding each line as a string.\n        Uses specified encoding with strict error handling.\n        \"\"\"\n        try:\n            with open(path, \"r\", encoding=encoding, errors=\"strict\") as f:\n                for line in f:\n                    yield line\n        except OSError as e:\n            raise OSError(f\"Could not read file '{path}': {e}\")\n        except UnicodeDecodeError as e:\n            raise UnicodeDecodeError(f\"Failed to decode file '{path}' with encoding '{encoding}': {e}\")\n\n    def write(self, path: Path, lines: Iterable[str], encoding: str = \"utf-8\") -> None:\n        \"\"\"\n        Writes an iterable of lines to a file.\n        Performs an atomic write by using a temporary file and then replacing the target.\n        \"\"\"\n        # Create temp file in the same directory as target for atomic replace\n        temp_dir = path.parent if path.parent.is_dir() else Path(tempfile.gettempdir())\n        fd, temp_path_str = tempfile.mkstemp(prefix=f\"{path.name}.\", dir=temp_dir)\n        temp_path = Path(temp_path_str)\n        \n        try:\n            with os.fdopen(fd, \"w\", encoding=encoding, errors=\"strict\") as f:\n                for line in lines:\n                    f.write(line)\n            os.replace(temp_path, path)  # Atomic replace\n        except OSError as e:\n            # Clean up temp file on error\n            if temp_path.exists():\n                os.remove(temp_path)\n            raise OSError(f\"Could not write to file '{path}': {e}\")\n        except Exception:\n            # Clean up temp file for other exceptions\n            if temp_path.exists():\n                os.remove(temp_path)\n            raise\n\n    def safe_temp_path(self, prefix: str = \"flip_\", suffix: str = \".txt\") -> Path:\n        \"\"\"\n        Generates a unique temporary file path in the OS's temporary directory.\n        Creates the file, closes it, and returns its path.\n        \"\"\"\n        fd, path_str = tempfile.mkstemp(prefix=prefix, suffix=suffix)\n        os.close(fd) # Close the file descriptor immediately\n        return Path(path_str)\n\n```python\n# src/string_utils/cli.py\n\"\"\"\nCommand Line Interface (CLI) controller for the string utility.\nParses arguments and orchestrates calls to FlipCaseService.\n\"\"\"\nimport argparse\nimport sys\nfrom pathlib import Path\nimport logging\n\nfrom .services import FlipCaseService\nfrom .exceptions import ValidationError\nfrom .logging_config import configure_logging\n\nclass CLIController:\n    \"\"\"\n    Handles CLI argument parsing and execution flow.\n    Delegates core logic to FlipCaseService and manages error reporting.\n    \"\"\"\n    def __init__(self, service: FlipCaseService = None) -> None:\n        \"\"\"\n        Initializes the CLIController with an optional FlipCaseService instance.\n        If no service is provided, a default one is created.\n        \"\"\"\n        configure_logging()  # Configure logging at CLI start\n        self.logger = logging.getLogger(__name__)\n        self.service = service or FlipCaseService(logger=self.logger)\n\n    def run(self, argv=None) -> int:\n        \"\"\"\n        Parses command-line arguments and executes the requested operation.\n        Returns an exit code (0 for success, non-zero for errors).\n        \"\"\"\n        argv = argv or sys.argv[1:]\n        parser = argparse.ArgumentParser(\n            prog=\"flip-case\",\n            description=\"Flip character case in strings or files.\"\n        )\n        group = parser.add_mutually_exclusive_group(required=True)\n        group.add_argument(\"--text\", \"-t\", help=\"Text string to flip.\")\n        group.add_argument(\"--input\", \"-i\", type=Path, help=\"Input file path to read from.\")\n        parser.add_argument(\"--output\", \"-o\", type=Path, help=\"Output file path to write to (optional).\")\n        parser.add_argument(\"--encoding\", \"-e\", default=\"utf-8\", help=\"File encoding (e.g., utf-8, latin-1). Default: utf-8.\")\n        parser.add_argument(\"--verbose\", \"-v\", action=\"store_true\", help=\"Enable verbose logging.\")\n\n        args = parser.parse_args(argv)\n\n        if args.verbose:\n            configure_logging(level=\"DEBUG\")\n            self.logger.debug(\"Verbose logging enabled.\")\n\n        try:\n            if args.text is not None:\n                result = self.service.flip(args.text)\n                print(result)\n            elif args.input is not None:\n                output_path = self.service.flip_file(args.input, args.output, encoding=args.encoding)\n                print(f\"Output written to: {output_path}\")\n            return 0\n        except (ValidationError, FileNotFoundError, OSError, TypeError) as e:\n            self.logger.error(\"Operation failed: %s\", e)\n            print(f\"Error: {e}\", file=sys.stderr)\n            return 2  # Specific error code for validation/file issues\n        except Exception as e:\n            self.logger.exception(\"An unexpected error occurred.\")\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1 # Generic error code for unexpected issues\n\n```python\n# src/string_utils/api.py\n\"\"\"\nFastAPI application for the string utility.\nExposes HTTP endpoints for case flipping and health checks.\n\"\"\"\nfrom fastapi import FastAPI, HTTPException\nfrom pydantic import BaseModel\nimport logging\n\nfrom .services import FlipCaseService\nfrom .exceptions import ValidationError\nfrom .dtos import FlipCaseRequest, FlipCaseResponse\nfrom .logging_config import configure_logging\n\n# Configure logging for the API module\nconfigure_logging()\nlogger = logging.getLogger(__name__)\n\nclass APIController:\n    \"\"\"\n    Manages the FastAPI application and its endpoints.\n    Initializes the FastAPI app and registers routes.\n    \"\"\"\n    def __init__(self, service: FlipCaseService = None) -> None:\n        \"\"\"\n        Initializes the FastAPI application and the FlipCaseService.\n        A default service is created if none is provided.\n        \"\"\"\n        self.service = service or FlipCaseService(logger=logger)\n        self.app = FastAPI(\n            title=\"Flip Case API\",\n            description=\"A simple API to flip character case in strings.\",\n            version=\"0.1.0\"\n        )\n        self.include_routes()\n\n    def include_routes(self) -> None:\n        \"\"\"\n        Registers the API endpoints with the FastAPI application.\n        Includes /health and /flip.\n        \"\"\"\n        @self.app.get(\"/health\", summary=\"Health check endpoint\")\n        def health() -> dict[str, str]:\n            \"\"\"\n            Returns a simple status to indicate the API is running.\n            \"\"\"\n            return {\"status\": \"ok\"}\n\n        @self.app.post(\n            \"/flip\",\n            response_model=FlipCaseResponse,\n            summary=\"Flip case of a string\",\n            description=\"Flips lowercase characters to uppercase and vice versa in the provided text.\"\n        )\n        async def flip_case_endpoint(request: FlipCaseRequest) -> FlipCaseResponse:\n            \"\"\"\n            Accepts a JSON object with a 'text' field and returns the case-flipped text.\n            Handles validation errors with a 400 response.\n            \"\"\"\n            try:\n                result = self.service.flip(request.text)\n                return FlipCaseResponse(result=result)\n            except ValidationError as e:\n                logger.warning(\"Validation error on /flip: %s\", e.message)\n                raise HTTPException(status_code=400, detail=e.message)\n            except TypeError as e:\n                # This could happen if internal core logic somehow gets non-str\n                logger.error(\"Type error in core logic: %s\", e)\n                raise HTTPException(status_code=500, detail=\"Internal server error: Invalid data type encountered.\")\n            except Exception as e:\n                logger.exception(\"An unexpected error occurred during /flip request.\")\n                raise HTTPException(status_code=500, detail=\"An unexpected error occurred.\")\n\n# Initialize the APIController and expose its app for uvicorn\napi_controller = APIController()\napp = api_controller.app\n\n```python\n# src/string_utils/exceptions.py\n\"\"\"\nCustom exception classes for domain-specific errors.\nDefines ValidationError for business logic input issues.\n\"\"\"\nclass ValidationError(Exception):\n    \"\"\"\n    Custom exception raised for invalid input data based on business rules.\n    Carries a descriptive message about the validation failure.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        \"\"\"\n        Initializes the ValidationError with a message.\n        \"\"\"\n        self.message = message\n        super().__init__(message)\n\n    def __str__(self) -> str:\n        \"\"\"\n        Returns the string representation of the exception, which is its message.\n        \"\"\"\n        return self.message\n\n```python\n# src/string_utils/utils.py\n\"\"\"\nUtility functions for common tasks like validation and stream processing.\nIncludes text validation and an iterable chunker.\n\"\"\"\nfrom typing import Iterable, Iterator, List\nfrom .exceptions import ValidationError\n\ndef validate_text(text: str) -> None:\n    \"\"\"\n    Validates that the input is a non-empty string.\n    Raises ValidationError if input is not a string or is empty.\n    \"\"\"\n    if not isinstance(text, str):\n        raise ValidationError(\"Input 'text' must be a string.\")\n    if not text:\n        # Business rule might allow empty string, but for explicit validation check here\n        # Currently, the spec doesn't explicitly forbid empty, but FlipCaseService validates.\n        pass # Allow empty strings for now as per minimal validation in FR2\n        \ndef chunk_stream(iterable: Iterable[str], size: int) -> Iterator[List[str]]:\n    \"\"\"\n    Yields chunks of items from an iterable.\n    Useful for batch processing streams.\n    \"\"\"\n    bucket: List[str] = []\n    for item in iterable:\n        bucket.append(item)\n        if len(bucket) >= size:\n            yield bucket\n            bucket = []\n    if bucket:\n        yield bucket\n\n```python\n# src/string_utils/logging_config.py\n\"\"\"\nCentralized logging configuration for the string_utils package.\nSets up basic console logging.\n\"\"\"\nimport logging\nimport sys\n\ndef configure_logging(level: str = \"INFO\") -> None:\n    \"\"\"\n    Configures basic logging for the application.\n    Sets the minimum logging level and format for console output.\n    \"\"\"\n    log_level = getattr(logging, level.upper(), logging.INFO)\n    \n    # Prevent adding multiple handlers if already configured\n    if not logging.root.handlers:\n        logging.basicConfig(\n            level=log_level,\n            format=\"%(asctime)s - %(name)s - %(levelname)s - %(message)s\",\n            handlers=[\n                logging.StreamHandler(sys.stdout)\n            ]\n        )\n    else:\n        # If handlers exist, just update the level\n        logging.root.setLevel(log_level)\n        for handler in logging.root.handlers:\n            handler.setLevel(log_level)\n\n```python\n# scripts/flip_case_entrypoint.py\n\"\"\"\nEntry point script for the 'flip-case' CLI tool.\nInvokes the CLIController to run the application.\n\"\"\"\nimport sys\nfrom string_utils.cli import CLIController\n\ndef main(argv=None) -> int:\n    \"\"\"\n    Main function for the CLI entry point.\n    Delegates execution to CLIController.\n    \"\"\"\n    return CLIController().run(argv)\n\nif __name__ == \"__main__\":\n    # Ensure this script is executable via `python -m scripts.flip_case_entrypoint`\n    # or `flip-case` after installation.\n    raise SystemExit(main())\n\n```\n```toml\n# pyproject.toml\n[tool.poetry]\nname = \"string-utils\"\nversion = \"0.1.0\"\ndescription = \"A Python library and service to flip character case in strings.\"\nauthors = [\"Your Name <you@example.com>\"]\nreadme = \"README.md\"\npackages = [{include = \"string_utils\", from = \"src\"}]\n\n[tool.poetry.dependencies]\npython = \"^3.9\"\nfastapi = \"^0.111.0\" # Updated to a recent stable version\nuvicorn = {extras = [\"standard\"], version = \"^0.29.0\"} # Updated to a recent stable version\npydantic = \"^2.0.0\" # Explicitly include pydantic as FastAPI dependency\n\n[tool.poetry.group.dev.dependencies]\npytest = \"^8.2.1\" # Updated to a recent stable version\nruff = \"^0.4.4\" # Optional linter\nmypy = \"^1.10.0\" # Optional type checker\n\n[tool.poetry.scripts]\nflip-case = \"scripts.flip_case_entrypoint:main\"\n\n[build-system]\nrequires = [\"poetry-core\"]\nbuild-backend = \"poetry.core.masonry.api\"\n\n```"}
