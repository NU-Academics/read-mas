{"task_id": "HumanEval/34", "solution": "```python\n# -- pyproject.toml --\n# [project]\n# name = \"listutils\"\n# version = \"0.1.0\"\n# description = \"A small Python library to return sorted unique elements from a list.\"\n# readme = \"README.md\"\n# requires-python = \">=3.8\"\n# license = {text = \"MIT\"}\n# authors = [\n#   {name = \"Your Name\", email = \"your.email@example.com\"},\n# ]\n# dependencies = [] # No external runtime dependencies\n\n# [project.optional-dependencies]\n# dev = [\"pytest>=7.0\"]\n\n# [project.scripts]\n# list-unique = \"listutils.cli:main\"\n\n# -- README.md --\n# # listutils\n#\n# A small Python library and CLI tool to deduplicate and sort lists.\n#\n# ## Installation\n#\n# ```bash\n# pip install listutils\n# ```\n#\n# ## Usage\n#\n# ### Library\n#\n# ```python\n# from listutils import unique\n#\n# my_list = [5, 3, 5, 2, 3, 3, 9, 0, 123]\n# result = unique(my_list)\n# print(result) # Output: [0, 2, 3, 5, 9, 123]\n# ```\n#\n# ### CLI\n#\n# ```bash\n# list-unique 5 3 5 2 3 3 9 0 123\n# # Output: [0, 2, 3, 5, 9, 123]\n#\n# echo '{\"items\": [10, 20, 10]}' | list-unique --json -\n# # Output: [10, 20]\n#\n# # With file input\n# # echo -e \"apple\\nbanana\\napple\" > items.txt\n# # list-unique --file items.txt\n# # Output: [\"apple\", \"banana\"]\n# ```\n#\n# ## HTTP Adapter (Optional)\n#\n# To run the lightweight HTTP server:\n#\n# ```bash\n# python -m listutils.http_adapter --port 8000\n# ```\n#\n# Then send a POST request:\n#\n# ```bash\n# curl -X POST -H \"Content-Type: application/json\" -d '{\"items\": [5, 3, 5, 2]}' http://localhost:8000/unique\n# # Output: {\"unique\": [2, 3, 5]}\n# ```\n\n# -- LICENSE --\n# MIT License\n#\n# Copyright (c) 2023 Your Name\n#\n# Permission is hereby granted, free of charge, to any person obtaining a copy\n# of this software and associated documentation files (the \"Software\"), to deal\n# in the Software without restriction, including without limitation the rights\n# to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n# copies of the Software, and to permit persons to whom the Software is\n# furnished to do so, subject to the following conditions:\n#\n# The above copyright notice and this permission notice shall be included in all\n# copies or substantial portions of the Software.\n#\n# THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n# IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n# FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n# AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n# LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n# OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n# SOFTWARE.\n\n# The code below implements the specified file structure within src/listutils/.\n\nimport functools\nimport json\nimport argparse\nimport sys\nimport os\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\nimport threading\nimport traceback\nfrom typing import List, Optional, Any, Dict, Callable\n\n# src/listutils/exceptions.py\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    pass\n\nclass InvalidElementTypeError(Exception):\n    \"\"\"Exception raised when elements are of an unsupported type.\"\"\"\n    pass\n\n# src/listutils/config.py\nclass Config:\n    \"\"\"Configuration for the listutils library.\"\"\"\n    def __init__(self, default_sort: bool = True, allow_unhashable_fallback: bool = True, max_cache_size: int = 1024) -> None:\n        self.default_sort = default_sort\n        self.allow_unhashable_fallback = allow_unhashable_fallback\n        self.max_cache_size = max_cache_size\n\n# src/listutils/dto.py\nclass UniqueRequest:\n    \"\"\"Data transfer object for input requests.\"\"\"\n    def __init__(self, items: List[Any], source: Optional[str] = None) -> None:\n        self.items = items\n        self.source = source\n\nclass UniqueResult:\n    \"\"\"Data transfer object for output results.\"\"\"\n    def __init__(self, unique_items: List[Any]) -> None:\n        self.unique_items = unique_items\n\n    def to_json(self) -> str:\n        \"\"\"Returns a JSON string representation of the unique items.\"\"\"\n        return json.dumps({\"unique\": self.unique_items})\n\n# src/listutils/utils.py\ndef validate_items(items: Any) -> None:\n    \"\"\"Validates that the input is a list-like iterable.\"\"\"\n    if not isinstance(items, (list, tuple)):\n        raise InvalidInputError(\"Input must be a list or tuple.\")\n\ndef serialize_result(result: UniqueResult) -> str:\n    \"\"\"Serializes a UniqueResult object to a JSON string.\"\"\"\n    return result.to_json()\n\ndef parse_json_file(path: str) -> Dict[str, Any]:\n    \"\"\"Parses a JSON file and returns its content.\"\"\"\n    try:\n        with open(path, 'r', encoding='utf-8') as f:\n            return json.load(f)\n    except FileNotFoundError:\n        raise InvalidInputError(f\"File not found: {path}\")\n    except json.JSONDecodeError:\n        raise InvalidInputError(f\"Invalid JSON format in file: {path}\")\n    except Exception as e:\n        raise InvalidInputError(f\"Error reading JSON file {path}: {e}\")\n\n# src/listutils/service.py\nclass UniqueService:\n    \"\"\"Core logic for deduplication, sorting, and caching.\"\"\"\n    def __init__(self, config: Optional[Config] = None) -> None:\n        self._config = config or Config()\n        self._deduplicate_and_sort_cached: Callable[[tuple], List[Any]] = functools.lru_cache(\n            maxsize=self._config.max_cache_size\n        )(self._deduplicate_and_sort_helper)\n\n    def compute_unique(self, request: UniqueRequest) -> UniqueResult:\n        \"\"\"Computes unique and sorted elements based on the request.\"\"\"\n        validate_items(request.items) # Ensure it's a list-like object\n        items = list(request.items) # Convert to list for consistency\n\n        try:\n            # Attempt to use the cached version for hashable items\n            deduped_and_sorted = self._deduplicate_and_sort_cached(tuple(items))\n            return UniqueResult(deduped_and_sorted)\n        except TypeError:\n            # If items are unhashable, lru_cache will raise TypeError.\n            # Fallback to direct computation without caching.\n            if not self._config.allow_unhashable_fallback:\n                raise InvalidElementTypeError(\"Unhashable elements detected and fallback is disabled.\")\n            \n            deduped = self._equality_dedup(items)\n            sorted_items = self._sort_items(deduped) if self._config.default_sort else deduped\n            return UniqueResult(sorted_items)\n        except Exception as e:\n            raise InvalidInputError(f\"An unexpected error occurred during processing: {e}\")\n\n    def _deduplicate_and_sort_helper(self, items_tuple: tuple) -> List[Any]:\n        \"\"\"Helper for caching, takes a tuple and returns unique sorted list.\"\"\"\n        deduped = self._hash_dedup(list(items_tuple))\n        sorted_items = self._sort_items(deduped) if self._config.default_sort else deduped\n        return sorted_items\n\n    def _hash_dedup(self, items: List[Any]) -> List[Any]:\n        \"\"\"Deduplicates items using a set for O(N) average performance.\"\"\"\n        return list(set(items))\n\n    def _equality_dedup(self, items: List[Any]) -> List[Any]:\n        \"\"\"Deduplicates items using equality checks for O(N^2) performance.\"\"\"\n        deduped = []\n        for item in items:\n            if item not in deduped:\n                deduped.append(item)\n        return deduped\n\n    def _sort_items(self, items: List[Any]) -> List[Any]:\n        \"\"\"Sorts items using Python's built-in sorted function.\"\"\"\n        try:\n            return sorted(items)\n        except TypeError as e:\n            raise InvalidElementTypeError(f\"Elements are not comparable for sorting: {e}\")\n\n    def clear_cache(self) -> None:\n        \"\"\"Clears the in-memory LRU cache.\"\"\"\n        self._deduplicate_and_sort_cached.cache_clear()\n\n\n# src/listutils/repository.py\nclass ListRepository:\n    \"\"\"Repository for loading list inputs from various sources.\"\"\"\n    SUPPORTED_FILE_EXTENSIONS: List[str] = ['.json', '.txt']\n\n    def load_from_memory(self, items: List[Any]) -> UniqueRequest:\n        \"\"\"Loads items directly from a Python list.\"\"\"\n        validate_items(items)\n        return UniqueRequest(items=items, source=\"memory\")\n\n    def load_from_file(self, path: str) -> UniqueRequest:\n        \"\"\"Loads items from a file, supporting JSON and plain text.\"\"\"\n        _, ext = os.path.splitext(path)\n        if ext not in self.SUPPORTED_FILE_EXTENSIONS:\n            raise InvalidInputError(f\"Unsupported file extension: {ext}. Supported: {self.SUPPORTED_FILE_EXTENSIONS}\")\n\n        if ext == '.json':\n            data = parse_json_file(path)\n            if \"items\" not in data or not isinstance(data[\"items\"], list):\n                raise InvalidInputError(f\"JSON file '{path}' must contain a 'items' key with a list.\")\n            return UniqueRequest(items=data[\"items\"], source=f\"file:{path}\")\n        elif ext == '.txt':\n            content = self._read_file(path)\n            items = [line.strip() for line in content.splitlines() if line.strip()]\n            return UniqueRequest(items=items, source=f\"file:{path}\")\n        \n        raise InvalidInputError(f\"Failed to process file {path} due to unknown type or parsing error.\")\n\n    def load_from_json_string(self, json_str: str) -> UniqueRequest:\n        \"\"\"Loads items from a JSON string.\"\"\"\n        if json_str.strip() == '-': # Read from stdin if '-' is passed\n            json_str = sys.stdin.read()\n        \n        try:\n            data = json.loads(json_str)\n            if isinstance(data, list): # Direct JSON array input\n                return UniqueRequest(items=data, source=\"json_string\")\n            elif isinstance(data, dict) and \"items\" in data and isinstance(data[\"items\"], list):\n                return UniqueRequest(items=data[\"items\"], source=\"json_string\")\n            else:\n                raise InvalidInputError(\"JSON string must be a list or an object with an 'items' key containing a list.\")\n        except json.JSONDecodeError:\n            raise InvalidInputError(\"Invalid JSON string provided.\")\n        except Exception as e:\n            raise InvalidInputError(f\"Error parsing JSON string: {e}\")\n\n    def _read_file(self, path: str) -> str:\n        \"\"\"Reads the content of a file.\"\"\"\n        try:\n            with open(path, 'r', encoding='utf-8') as f:\n                return f.read()\n        except FileNotFoundError:\n            raise InvalidInputError(f\"File not found: {path}\")\n        except PermissionError:\n            raise InvalidInputError(f\"Permission denied to read file: {path}\")\n        except Exception as e:\n            raise InvalidInputError(f\"Error reading file {path}: {e}\")\n\n# src/listutils/controller.py\nclass UniqueController:\n    \"\"\"Fa\u00e7ade for the listutils library, orchestrating repository and service.\"\"\"\n    def __init__(self, repo: Optional[ListRepository] = None, service: Optional[UniqueService] = None) -> None:\n        self._repo = repo or ListRepository()\n        self._service = service or UniqueService()\n\n    def unique_from_list(self, items: List[Any]) -> List[Any]:\n        \"\"\"Processes a raw Python list to return unique sorted elements.\"\"\"\n        request = self._repo.load_from_memory(items)\n        result = self._service.compute_unique(request)\n        return result.unique_items\n\n    def unique_from_file(self, path: str) -> List[Any]:\n        \"\"\"Processes a file to return unique sorted elements.\"\"\"\n        request = self._repo.load_from_file(path)\n        result = self._service.compute_unique(request)\n        return result.unique_items\n\n    def unique_from_json(self, json_str: str) -> List[Any]:\n        \"\"\"Processes a JSON string to return unique sorted elements.\"\"\"\n        request = self._repo.load_from_json_string(json_str)\n        result = self._service.compute_unique(request)\n        return result.unique_items\n\n# src/listutils/__init__.py\n# Primary responsibility: package public API. Exports unique function and version.\n__version__ = \"0.1.0\"\n\n_default_controller = UniqueController(repo=ListRepository(), service=UniqueService(Config()))\n\ndef unique(l: list) -> list:\n    \"\"\"Return sorted unique elements in a list.\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    return _default_controller.unique_from_list(l)\n\n# src/listutils/cli.py\ndef _parse_args(argv: Optional[List[str]]) -> argparse.Namespace:\n    \"\"\"Parses command-line arguments for the CLI tool.\"\"\"\n    parser = argparse.ArgumentParser(\n        description=\"Return sorted unique elements from input.\",\n        formatter_class=argparse.RawTextHelpFormatter\n    )\n    \n    input_group = parser.add_mutually_exclusive_group(required=False)\n    input_group.add_argument(\n        \"items\",\n        nargs=argparse.REMAINDER,\n        help=\"Positional items to process (e.g., list-unique 1 2 1)\"\n    )\n    input_group.add_argument(\n        \"--file\",\n        \"-f\",\n        type=str,\n        help=\"Path to a file containing items. Supports .json (with 'items' key or direct array) or .txt (one item per line).\"\n    )\n    input_group.add_argument(\n        \"--json\",\n        \"-j\",\n        type=str,\n        help=\"JSON string of items (e.g., --json '[1,2,1]'). Use '-' to read from stdin (e.g., echo '[1,2,1]' | list-unique -j -).\"\n    )\n\n    parser.add_argument(\n        \"--no-fallback\",\n        action=\"store_true\",\n        help=\"Disable fallback to equality-based deduplication for unhashable elements. Will raise an error instead.\"\n    )\n    parser.add_argument(\n        \"--no-sort\",\n        action=\"store_true\",\n        help=\"Do not sort the unique elements. Return in deduplication order.\"\n    )\n    parser.add_argument(\n        \"--version\",\n        action=\"version\",\n        version=f\"%(prog)s {__version__}\"\n    )\n\n    args = parser.parse_args(argv)\n\n    if not any([args.items, args.file, args.json]):\n        parser.error(\"No input provided. Use positional items, --file, or --json.\")\n\n    return args\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"Main entry point for the command-line interface.\"\"\"\n    args = _parse_args(argv)\n\n    # Configure the service based on CLI arguments\n    cli_config = Config(\n        default_sort=not args.no_sort,\n        allow_unhashable_fallback=not args.no_fallback\n    )\n    controller = UniqueController(service=UniqueService(config=cli_config))\n\n    try:\n        result_list: List[Any]\n        if args.file:\n            result_list = controller.unique_from_file(args.file)\n        elif args.json:\n            result_list = controller.unique_from_json(args.json)\n        else: # Positional arguments\n            processed_items = []\n            for item_str in args.items:\n                try: # Attempt to convert to int or float for numerical consistency\n                    processed_items.append(int(item_str))\n                except ValueError:\n                    try:\n                        processed_items.append(float(item_str))\n                    except ValueError:\n                        processed_items.append(item_str) # Keep as string if not a number\n            result_list = controller.unique_from_list(processed_items)\n            \n        print(json.dumps(result_list))\n        return 0\n    except (InvalidInputError, InvalidElementTypeError) as e:\n        print(f\"Error: {e}\", file=sys.stderr)\n        return 1\n    except Exception as e:\n        print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n        traceback.print_exc(file=sys.stderr) # For debugging unexpected errors\n        return 1\n\n\n# src/listutils/http_adapter.py\nclass RequestHandler(BaseHTTPRequestHandler):\n    \"\"\"Custom request handler for the HTTP server.\"\"\"\n    _controller: Optional[UniqueController] = None\n\n    @classmethod\n    def set_controller(cls, controller: UniqueController) -> None:\n        \"\"\"Sets the controller instance for all handlers.\"\"\"\n        cls._controller = controller\n\n    def do_POST(self) -> None:\n        \"\"\"Handles POST requests to /unique endpoint.\"\"\"\n        if self.path == '/unique':\n            self._handle_unique_post()\n        else:\n            self._send_error(404, \"Not Found\")\n\n    def _handle_unique_post(self) -> None:\n        \"\"\"Processes POST request for /unique endpoint.\"\"\"\n        content_length = int(self.headers.get('Content-Length', 0))\n        post_body = self.rfile.read(content_length).decode('utf-8')\n\n        if not self._controller:\n            self._send_error(500, \"Server not properly configured (Controller missing).\")\n            return\n\n        try:\n            data = json.loads(post_body)\n            if \"items\" not in data or not isinstance(data[\"items\"], list):\n                self._send_error(400, \"Invalid JSON payload: expected {'items': [...]}\")\n                return\n\n            items = data[\"items\"]\n            \n            # The HTTP adapter's UniqueService instance has a fixed Config set at startup.\n            # Per-request config overrides (e.g., 'no_fallback' in the request body)\n            # are not dynamically applied to the existing service instance for v1 simplicity\n            # to maintain cache effectiveness. The server's default behavior is set via CLI flags.\n\n            unique_items = self._controller.unique_from_list(items) # Use controller's configured service\n\n            response_payload = UniqueResult(unique_items).to_json()\n            self.send_response(200)\n            self.send_header(\"Content-Type\", \"application/json\")\n            self.end_headers()\n            self.wfile.write(response_payload.encode('utf-8'))\n\n        except json.JSONDecodeError:\n            self._send_error(400, \"Invalid JSON format.\")\n        except InvalidInputError as e:\n            self._send_error(400, f\"Invalid request input: {e}\")\n        except InvalidElementTypeError as e:\n            self._send_error(400, f\"Invalid element type: {e}\")\n        except Exception as e:\n            self._send_error(500, f\"Internal server error: {e}\")\n            traceback.print_exc(file=sys.stderr) # Log unexpected errors\n\n    def _send_error(self, code: int, message: str) -> None:\n        \"\"\"Sends an HTTP error response.\"\"\"\n        self.send_response(code)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.end_headers()\n        error_payload = json.dumps({\"error\": message})\n        self.wfile.write(error_payload.encode('utf-8'))\n\nclass HTTPServerAdapter:\n    \"\"\"Lightweight HTTP server exposing a /unique endpoint.\"\"\"\n    def __init__(self, host: str = \"0.0.0.0\", port: int = 8000, controller: Optional[UniqueController] = None) -> None:\n        self._host = host\n        self._port = port\n        self._controller = controller or UniqueController(service=UniqueService(Config()))\n        \n        RequestHandler.set_controller(self._controller)\n        self._server = HTTPServer((self._host, self._port), RequestHandler)\n        self._server_thread: Optional[threading.Thread] = None\n\n    def start(self) -> None:\n        \"\"\"Starts the HTTP server in a separate thread.\"\"\"\n        print(f\"Starting HTTP server on http://{self._host}:{self._port}\")\n        self._server_thread = threading.Thread(target=self._server.serve_forever)\n        self._server_thread.daemon = True # Allows main thread to exit gracefully\n        self._server_thread.start()\n        print(f\"HTTP server running. Use Ctrl+C to stop.\")\n\n    def stop(self) -> None:\n        \"\"\"Stops the HTTP server.\"\"\"\n        print(\"Stopping HTTP server...\")\n        self._server.shutdown()\n        self._server.server_close()\n        if self._server_thread and self._server_thread.is_alive():\n            self._server_thread.join(timeout=1) # Wait for thread to finish\n        print(\"HTTP server stopped.\")\n\nif __name__ == '__main__':\n    # This block allows running `python -m listutils.http_adapter`\n    parser = argparse.ArgumentParser(description=\"Run the list-unique HTTP server adapter.\")\n    parser.add_argument(\"--host\", type=str, default=\"0.0.0.0\", help=\"Host to bind the server to.\")\n    parser.add_argument(\"--port\", type=int, default=8000, help=\"Port to listen on.\")\n    parser.add_argument(\n        \"--no-fallback\",\n        action=\"store_true\",\n        help=\"Disable fallback to equality-based deduplication for unhashable elements. Server will respond with 400.\"\n    )\n    parser.add_argument(\n        \"--no-sort\",\n        action=\"store_true\",\n        help=\"Do not sort the unique elements in HTTP responses.\"\n    )\n    args = parser.parse_args()\n\n    server_config = Config(\n        default_sort=not args.no_sort,\n        allow_unhashable_fallback=not args.no_fallback\n    )\n    \n    server_controller = UniqueController(service=UniqueService(config=server_config))\n    adapter = HTTPServerAdapter(host=args.host, port=args.port, controller=server_controller)\n    try:\n        adapter.start()\n        # Keep the main thread alive to allow the server thread to run\n        while True:\n            import time\n            time.sleep(1) \n    except KeyboardInterrupt:\n        print(\"\\nKeyboardInterrupt received.\")\n    finally:\n        adapter.stop()\n```"}
{"task_id": "HumanEval/35", "solution": "```python\ndef max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    # Assumes 'l' is a non-empty list of mutually comparable elements.\n    candidate = l[0]\n    for v in l[1:]:\n        if v > candidate:\n            candidate = v\n    return candidate\n```"}
{"task_id": "HumanEval/36", "solution": "```python\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n\n    which are divisible by 11 or 13.\n    \"\"\"\n    total_sevens_count = 0\n    # Iterate through each integer x from 0 up to n-1.\n    for x in range(n):\n        # Check if x is divisible by 11 or 13.\n        if x % 11 == 0 or x % 13 == 0:\n            # Convert the number to its decimal string representation and count occurrences of '7'.\n            total_sevens_count += str(x).count('7')\n    return total_sevens_count\n```"}
{"task_id": "HumanEval/36", "solution": "```python\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_sevens_count = 0\n    # Iterate through each integer k from 0 up to, but not including, n.\n    for k in range(n):\n        # Check if k is divisible by 11 or 13 (inclusive OR).\n        if k % 11 == 0 or k % 13 == 0:\n            # Convert the number to its string representation to count occurrences of the digit '7'.\n            total_sevens_count += str(k).count('7')\n    return total_sevens_count\n```"}
{"task_id": "HumanEval/37", "solution": "```python\ndef sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    # Extract elements at even indices and sort them.\n    evens = [l[i] for i in range(0, len(l), 2)]\n    sorted_evens = sorted(evens)\n\n    # Reconstruct the list by placing sorted even elements back into their positions.\n    out = list(l)\n    even_iter = iter(sorted_evens)\n    for i in range(0, len(out), 2):\n        out[i] = next(even_iter)\n    return out\n```"}
{"task_id": "HumanEval/37", "solution": "```python\ndef sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    # Create a shallow copy of the list to modify.\n    result = list(l)\n\n    # Extract values from the even indices.\n    even_values = [l[i] for i in range(0, len(l), 2)]\n\n    # Sort the extracted even values.\n    sorted_even_values = sorted(even_values)\n\n    # Place the sorted values back into their original even indices in the result list.\n    for i, val in enumerate(sorted_even_values):\n        result[2 * i] = val\n\n    return result\n```"}
{"task_id": "HumanEval/38", "solution": "def encode_cyclic(s: str):\n    \"\"\"\n    returns encoded string by cycling groups of three characters.\n    \"\"\"\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    groups = [(group[1:] + group[0]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)\n\n\ndef decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    restored = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(restored)"}
{"task_id": "HumanEval/38", "solution": "```python\ndef encode_cyclic(s: str):\n    \"\"\"\n    returns encoded string by cycling groups of three characters.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[1:] + group[0]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)\n\n\ndef decode_cyclic(s: str):\n    \"\"\"\n    Takes an encoded string and returns the original string.\n    It reverses the cyclic-3 left rotation.\n    \"\"\"\n    # Split string to groups of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # Cycle elements in each group right by one. Groups with fewer than 3 elements remain unchanged.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)\n```"}
