{"task_id": "HumanEval/25", "solution": "```python\nfrom typing import List\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    # Handle n=1 as it has no prime factors.\n    if n == 1:\n        return []\n\n    factors = []\n\n    # Remove factors of 2.\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Remove factors of 3.\n    while n % 3 == 0:\n        factors.append(3)\n        n //= 3\n\n    # Trial division using 6k +/- 1 optimization for remaining factors.\n    # Checks prime candidates 5, 7, 11, 13, etc., up to sqrt(n).\n    f = 5\n    while f * f <= n:\n        while n % f == 0:\n            factors.append(f)\n            n //= f\n        while n % (f + 2) == 0:\n            factors.append(f + 2)\n            n //= (f + 2)\n        f += 6\n\n    # If n is still greater than 1, it must be the last prime factor.\n    if n > 1:\n        factors.append(n)\n\n    return factors\n```"}
{"task_id": "HumanEval/25", "solution": "from typing import List\nimport math\nimport random\n\ndef gcd(a: int, b: int) -> int:\n    \"\"\"Compute the greatest common divisor of two integers using Euclidean algorithm.\"\"\"\n    while b:\n        a, b = b, a % b\n    return a\n\ndef is_probable_prime(n: int, k: int = 5) -> bool:\n    \"\"\"\n    Performs Miller-Rabin primality test for n, testing k rounds.\n    Returns True if n is probably prime, False otherwise.\n    \"\"\"\n    if n <= 1: return False\n    if n == 2 or n == 3: return True\n    if n % 2 == 0: return False\n\n    d = n - 1\n    s = 0\n    while d % 2 == 0:\n        d //= 2\n        s += 1\n\n    for _ in range(k):\n        a = random.randint(2, n - 2)\n        x = pow(a, d, n)\n        if x == 1 or x == n - 1:\n            continue\n        for _ in range(s - 1):\n            x = pow(x, 2, n)\n            if x == n - 1:\n                break\n        else:\n            return False\n    return True\n\ndef pollard_rho_factor(n: int, seed: int = None) -> int:\n    \"\"\"\n    Attempts to find a non-trivial factor of n using Pollard's Rho algorithm.\n    Returns n if no factor is found, indicating n might be prime or the algorithm failed.\n    \"\"\"\n    if n % 2 == 0: return 2\n    \n    if seed is not None:\n        random.seed(seed)\n    \n    x = random.randint(2, n - 1)\n    y = x\n    c = random.randint(1, n - 1)\n    d = 1\n\n    f = lambda val: (val * val + c) % n\n\n    while d == 1:\n        x = f(x)\n        y = f(f(y))\n        d = gcd(abs(x - y), n)\n\n    return d # d will be a factor, or n if it gets stuck/n is prime\n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    if n <= 1:\n        return []\n\n    factors = []\n    \n    # Trial Division by 2\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Trial Division by odd numbers up to a practical limit\n    d = 3\n    trial_division_max_d_squared = 1_000_000 * 1_000_000 # Roughly for n up to 10^12\n\n    while d * d <= n and d * d <= trial_division_max_d_squared:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 2\n\n    # If n is still greater than 1, it's either a prime or a large composite.\n    # Use a stack-like list to process remaining composite numbers\n    numbers_to_factor = [n] if n > 1 else []\n    \n    while numbers_to_factor:\n        current_num = numbers_to_factor.pop()\n        \n        if current_num <= 1:\n            continue\n        \n        if is_probable_prime(current_num):\n            factors.append(current_num)\n        else:\n            # It's a large composite, try Pollard's Rho\n            factor = pollard_rho_factor(current_num)\n            if factor == current_num:\n                # Pollard Rho failed to find a non-trivial factor,\n                # or current_num is actually prime (unlikely if is_probable_prime was False)\n                # Fallback: add current_num itself as a factor.\n                factors.append(current_num)\n            else:\n                # Found a factor, decompose current_num further\n                numbers_to_factor.append(factor)\n                numbers_to_factor.append(current_num // factor)\n\n    factors.sort()\n    return factors"}
{"task_id": "HumanEval/26", "solution": "from typing import List\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n\n    return result"}
