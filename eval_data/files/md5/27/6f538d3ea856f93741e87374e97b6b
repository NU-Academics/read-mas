{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of student GPAs to letter grades based on a predefined grading table.\n    Assumes valid GPA inputs (0.0 to 4.0 inclusive) as per problem constraints.\n    \"\"\"\n    result_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            result_grades.append(\"A+\")\n        elif gpa > 3.7:\n            result_grades.append(\"A\")\n        elif gpa > 3.3:\n            result_grades.append(\"A-\")\n        elif gpa > 3.0:\n            result_grades.append(\"B+\")\n        elif gpa > 2.7:\n            result_grades.append(\"B\")\n        elif gpa > 2.3:\n            result_grades.append(\"B-\")\n        elif gpa > 2.0:\n            result_grades.append(\"C+\")\n        elif gpa > 1.7:\n            result_grades.append(\"C\")\n        elif gpa > 1.3:\n            result_grades.append(\"C-\")\n        elif gpa > 1.0:\n            result_grades.append(\"D+\")\n        elif gpa > 0.7:\n            result_grades.append(\"D\")\n        elif gpa > 0.0:\n            result_grades.append(\"D-\")\n        elif gpa == 0.0:\n            result_grades.append(\"E\")\n    return result_grades"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numeric GPAs to letter grades.\n    It applies a specific mapping table for conversion.\"\"\"\n\n    # Define the GPA to letter grade mapping thresholds in descending order.\n    # Each tuple contains (gpa_threshold, letter_grade_if_gpa_is_strictly_greater_than_threshold).\n    THRESHOLDS = [\n        (3.7, \"A\"),\n        (3.3, \"A-\"),\n        (3.0, \"B+\"),\n        (2.7, \"B\"),\n        (2.3, \"B-\"),\n        (2.0, \"C+\"),\n        (1.7, \"C\"),\n        (1.3, \"C-\"),\n        (1.0, \"D+\"),\n        (0.7, \"D\"),\n        (0.0, \"D-\"), # If GPA > 0.0, then D-\n    ]\n\n    result_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            result_grades.append(\"A+\")\n            continue\n        \n        # Default to 'E' for any GPA less than or equal to 0.0\n        assigned_letter = \"E\" \n        for threshold, letter in THRESHOLDS:\n            if gpa > threshold:\n                assigned_letter = letter\n                break # Found the appropriate grade, stop searching\n        result_grades.append(assigned_letter)\n        \n    return result_grades"}
{"task_id": "HumanEval/82", "solution": "```python\nimport math\n\ndef prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise.\"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Determines if an integer is a prime number. Handles small numbers and uses trial division.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        \n        i = 3\n        # Check for divisors up to the square root of n.\n        limit = int(math.isqrt(n))\n        while i <= limit:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    length = len(string)\n    return _is_prime(length)\n```"}
{"task_id": "HumanEval/82", "solution": "import math\n\ndef prime_length(string):\n    \"\"\"Checks if the string length is a prime number.\n    Returns True if length is prime, False otherwise.\n    \"\"\"\n\n    def _is_prime_internal(n: int) -> bool:\n        \"\"\"Determines if an integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        if n == 2 or n == 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    length = len(string)\n    return _is_prime_internal(length)"}
