{"task_id": "HumanEval/73", "solution": "```python\n# src/palindromizer/utils.py\nimport re\nfrom typing import Any, List\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for input validation errors.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return self.message\n\ndef validate_array(arr: Any) -> List[int]:\n    \"\"\"\n    Validates if the input is a list of integers and returns a normalized list.\n    Raises ValidationError if the input is invalid.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise ValidationError(\"Input must be a list.\")\n    \n    if arr is None: # Redundant check if not isinstance(arr, list) already caught, but explicit for clarity.\n        raise ValidationError(\"Input array cannot be None.\")\n\n    normalized_arr: List[int] = []\n    for item in arr:\n        if not isinstance(item, int):\n            try:\n                # Attempt to cast to int if not already\n                normalized_arr.append(int(item))\n            except (ValueError, TypeError):\n                raise ValidationError(f\"All elements in the array must be integers. Found: {item}\")\n        else:\n            normalized_arr.append(item)\n    return normalized_arr\n\ndef parse_cli_array(s: str) -> List[int]:\n    \"\"\"\n    Parses a comma-separated string of integers into a list of integers.\n    Raises ValidationError if parsing fails or elements are not integers.\n    \"\"\"\n    if not isinstance(s, str):\n        raise ValidationError(\"CLI array input must be a string.\")\n    \n    s = s.strip()\n    if not s:\n        return []\n\n    try:\n        # Use a regex to allow spaces around commas and numbers\n        str_elements = re.split(r',\\s*', s)\n        arr = [int(x.strip()) for x in str_elements if x.strip()]\n        return arr\n    except ValueError:\n        raise ValidationError(f\"Could not parse '{s}' as a comma-separated list of integers.\")\n\n```\n```python\n# src/palindromizer/models.py\nfrom datetime import datetime\nfrom uuid import UUID\n\nclass ArrayChangeResult:\n    \"\"\"DTO for the algorithm result with metadata.\"\"\"\n    def __init__(self, changes: int, length: int, timestamp: datetime, preview: str):\n        self.changes = changes\n        self.length = length\n        self.timestamp = timestamp\n        self.preview = preview\n\n    def to_dict(self) -> dict:\n        \"\"\"Returns a serializable dictionary representation.\"\"\"\n        return {\n            \"changes\": self.changes,\n            \"length\": self.length,\n            \"timestamp\": self.timestamp.isoformat(),\n            \"preview\": self.preview,\n        }\n\nclass ComputationRecord:\n    \"\"\"Persistent record wrapper with a stable ID and embedded result.\"\"\"\n    def __init__(self, id: UUID, result: ArrayChangeResult):\n        self.id = id\n        self.result = result\n\n    def to_json(self) -> str:\n        \"\"\"Returns a JSON string representation, suitable for JSON Lines.\"\"\"\n        record_dict = {\n            \"id\": str(self.id),\n            \"result\": self.result.to_dict(),\n        }\n        import json\n        return json.dumps(record_dict)\n\n```\n```python\n# src/palindromizer/config.py\nfrom dataclasses import dataclass\nfrom typing import Optional\n\nDEFAULT_MAX_IN_MEMORY = 1000\n\n@dataclass\nclass Config:\n    \"\"\"Application configuration container.\"\"\"\n    persist: bool = True\n    file_path: Optional[str] = None\n    max_in_memory: int = DEFAULT_MAX_IN_MEMORY\n\n```\n```python\n# src/palindromizer/algorithm.py\nfrom typing import List\n\nclass SmallestChangeAlgorithm:\n    \"\"\"Core algorithm to compute the minimal number of changes.\"\"\"\n    def compute(self, arr: List[int]) -> int:\n        \"\"\"\n        Calculates the minimum changes needed to make an array palindromic.\n        Uses a two-pointer approach, comparing elements from both ends.\n        \"\"\"\n        n = len(arr)\n        i, j = 0, n - 1\n        mismatches = 0\n        while i < j:\n            if arr[i] != arr[j]:\n                mismatches += 1\n            i += 1\n            j -= 1\n        return mismatches\n\n```\n```python\n# src/palindromizer/repository.py\nimport threading\nimport os\nfrom typing import List, Protocol, Optional\nfrom src.palindromizer.models import ComputationRecord, ArrayChangeResult\nfrom src.palindromizer.utils import ValidationError # For parsing records from file\nfrom uuid import UUID\nfrom datetime import datetime\nimport json\nimport logging\n\nlogger = logging.getLogger(__name__)\n\nDEFAULT_FILE_MODE = 'a'\nMAX_LINE_LENGTH = 1 << 20 # 1MB max line length for reading back, prevents OOM on corrupted files\n\nclass RepositoryInterface(Protocol):\n    \"\"\"Abstract persistence contract for computation records.\"\"\"\n    def save(self, record: ComputationRecord) -> None:\n        \"\"\"Saves a single computation record.\"\"\"\n        ...\n\n    def list_recent(self, limit: int) -> List[ComputationRecord]:\n        \"\"\"Retrieves the most recent computation records, up to a limit.\"\"\"\n        ...\n\nclass InMemoryRepository:\n    \"\"\"Keeps recent computation records in memory, acting as a ring buffer.\"\"\"\n    def __init__(self, max_in_memory: int):\n        self._records: List[ComputationRecord] = []\n        self._max_in_memory = max_in_memory\n        self._lock = threading.Lock() # Guard access to _records\n\n    def save(self, record: ComputationRecord) -> None:\n        \"\"\"Appends a record and trims the list to maintain max_in_memory.\"\"\"\n        with self._lock:\n            self._records.append(record)\n            if len(self._records) > self._max_in_memory:\n                self._records = self._records[-self._max_in_memory:] # Keep only the most recent\n\n    def list_recent(self, limit: int) -> List[ComputationRecord]:\n        \"\"\"Returns the last N records from memory.\"\"\"\n        with self._lock:\n            return self._records[-limit:]\n\nclass FileRepository:\n    \"\"\"Appends records to a newline-delimited JSON file and reads tail.\"\"\"\n    def __init__(self, file_path: str):\n        self._file_path = file_path\n        self._lock = threading.Lock() # Guards file writes\n\n    def save(self, record: ComputationRecord) -> None:\n        \"\"\"Appends a JSON string representation of the record to the file.\"\"\"\n        with self._lock:\n            try:\n                with open(self._file_path, DEFAULT_FILE_MODE, encoding='utf-8') as f:\n                    f.write(record.to_json() + '\\n')\n            except IOError as e:\n                logger.error(f\"Failed to save record to file {self._file_path}: {e}\")\n                raise PersistenceError(f\"File write failed: {e}\") from e\n\n    def list_recent(self, limit: int) -> List[ComputationRecord]:\n        \"\"\"\n        Reads the last N lines from the file, parsing them into ComputationRecord objects.\n        This is a best-effort approach for tail reading.\n        \"\"\"\n        records: List[ComputationRecord] = []\n        if not os.path.exists(self._file_path):\n            return []\n\n        # Read the file backwards to get recent lines efficiently\n        # This implementation reads the whole file into memory if it's small,\n        # or uses a limited buffer for larger files.\n        try:\n            with open(self._file_path, 'rb') as f:\n                f.seek(0, os.SEEK_END)\n                file_size = f.tell()\n                buffer_size = 4096 # Read in chunks\n                lines = []\n                # Max bytes to read for `limit` lines. Assuming average 200 chars/line * 2 bytes/char (utf-8)\n                # Max bytes is arbitrary, to prevent reading huge files into memory for very large limits.\n                max_bytes_to_read = max(file_size, limit * 400) # Read entire file if smaller than N lines * avg_line_size\n\n                read_size = 0\n                for i in range(1, int(file_size / buffer_size) + 2):\n                    offset = max(0, file_size - i * buffer_size)\n                    f.seek(offset)\n                    chunk = f.read(min(buffer_size, file_size - offset)).decode('utf-8', errors='ignore')\n\n                    lines_in_chunk = chunk.splitlines()\n                    # Add current chunk's lines in reverse order to `lines`\n                    lines.extend(reversed(lines_in_chunk))\n                    read_size += len(chunk)\n\n                    if len(lines) >= limit + 1 or read_size >= max_bytes_to_read: # +1 for potential partial line\n                        break\n                \n                # Filter out empty lines and take the most recent ones\n                parsed_lines = [line for line in reversed(lines) if line.strip()]\n                \n                for line in parsed_lines:\n                    if len(records) >= limit:\n                        break\n                    try:\n                        record_dict = json.loads(line)\n                        result_dict = record_dict.get('result', {})\n                        \n                        # Basic validation and reconstruction\n                        record_id = UUID(record_dict['id'])\n                        \n                        timestamp_str = result_dict['timestamp']\n                        timestamp = datetime.fromisoformat(timestamp_str) if isinstance(timestamp_str, str) else None\n                        if not timestamp: raise ValueError(\"Invalid timestamp format\")\n\n                        result = ArrayChangeResult(\n                            changes=result_dict['changes'],\n                            length=result_dict['length'],\n                            timestamp=timestamp,\n                            preview=result_dict['preview']\n                        )\n                        records.append(ComputationRecord(id=record_id, result=result))\n                    except (json.JSONDecodeError, KeyError, ValueError) as e:\n                        logger.warning(f\"Skipping corrupted or malformed record in file {self._file_path}: {line[:200]}... Error: {e}\")\n            return records[-limit:] # Ensure only the last `limit` are returned in correct order\n        except IOError as e:\n            logger.error(f\"Failed to read records from file {self._file_path}: {e}\")\n            return []\n        except Exception as e:\n            logger.error(f\"An unexpected error occurred while reading file {self._file_path}: {e}\")\n            return []\n\nclass PersistenceError(Exception):\n    \"\"\"Custom exception for repository persistence failures.\"\"\"\n    pass\n\n```\n```python\n# src/palindromizer/service.py\nimport logging\nfrom datetime import datetime\nfrom uuid import uuid4\nfrom typing import List, Any\n\nfrom src.palindromizer.algorithm import SmallestChangeAlgorithm\nfrom src.palindromizer.config import Config\nfrom src.palindromizer.models import ArrayChangeResult, ComputationRecord\nfrom src.palindromizer.repository import RepositoryInterface, PersistenceError\nfrom src.palindromizer.utils import validate_array, ValidationError\n\nlogger = logging.getLogger(__name__)\n\nclass PalindromeService:\n    \"\"\"\n    Orchestrates validation, algorithm invocation, and persistence of palindrome computations.\n    \"\"\"\n    def __init__(self, algorithm: SmallestChangeAlgorithm, repository: RepositoryInterface, config: Config):\n        self._algorithm = algorithm\n        self._repository = repository\n        self._config = config\n        self._logger = logger\n\n    def _make_preview(self, arr: List[int], max_len: int = 10) -> str:\n        \"\"\"Creates a string preview of the input array.\"\"\"\n        if not arr:\n            return \"[]\"\n        if len(arr) <= max_len * 2:\n            return str(arr)\n        return f\"[{arr[0]}, {arr[1]}, ..., {arr[-2]}, {arr[-1]}]\" # Simplified preview\n\n    def compute_and_persist(self, arr: Any) -> ArrayChangeResult:\n        \"\"\"\n        Validates the input, computes minimal changes, persists the result, and returns it.\n        \"\"\"\n        try:\n            arr_norm = validate_array(arr)\n        except ValidationError as e:\n            self._logger.error(f\"Validation error for input array: {e}\")\n            raise\n\n        changes = self._algorithm.compute(arr_norm)\n        \n        result = ArrayChangeResult(\n            changes=changes,\n            length=len(arr_norm),\n            timestamp=datetime.utcnow(),\n            preview=self._make_preview(arr_norm)\n        )\n        record = ComputationRecord(id=uuid4(), result=result)\n\n        if self._config.persist:\n            try:\n                self._repository.save(record)\n            except PersistenceError as e:\n                self._logger.error(f\"Failed to persist computation record (ID: {record.id}): {e}\")\n            except Exception as e: # Catch any other unexpected errors during persistence\n                self._logger.exception(f\"An unexpected error occurred during persistence for record (ID: {record.id})\")\n        \n        return result\n\n    def get_recent(self, limit: int = 100) -> List[ComputationRecord]:\n        \"\"\"\n        Retrieves recent computation records from the repository.\n        \"\"\"\n        try:\n            return self._repository.list_recent(limit)\n        except Exception as e:\n            self._logger.error(f\"Failed to retrieve recent records from repository: {e}\")\n            return []\n\n```\n```python\n# src/palindromizer/__init__.py\nimport sys\nimport os\nimport logging\nfrom typing import List\n\n# Setup basic logging for the package\nlogging.basicConfig(level=os.environ.get(\"PALINDROMIZER_LOGLEVEL\", \"INFO\").upper(),\n                    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n\n# Import core components to build the default service\nfrom src.palindromizer.algorithm import SmallestChangeAlgorithm\nfrom src.palindromizer.repository import InMemoryRepository, FileRepository\nfrom src.palindromizer.service import PalindromeService\nfrom src.palindromizer.config import Config, DEFAULT_MAX_IN_MEMORY\nfrom src.palindromizer.utils import ValidationError\n\n# Initialize a default configuration and service instance for the public API\n_default_config = Config(\n    persist=True,\n    file_path=os.environ.get(\"PALINDROMIZER_FILE_REPO_PATH\"),\n    max_in_memory=int(os.environ.get(\"PALINDROMIZER_MAX_MEMORY_RECORDS\", DEFAULT_MAX_IN_MEMORY))\n)\n\n_default_algorithm = SmallestChangeAlgorithm()\n\nif _default_config.file_path:\n    _default_repository = FileRepository(file_path=_default_config.file_path)\nelse:\n    _default_repository = InMemoryRepository(max_in_memory=_default_config.max_in_memory)\n\n_default_service = PalindromeService(\n    algorithm=_default_algorithm,\n    repository=_default_repository,\n    config=_default_config\n)\n\ndef smallest_change(arr: List[int]) -> int:\n    \"\"\"\n    Computes the minimum number of element changes required to make an integer array palindromic.\n    This function is the public API entry point and delegates to the PalindromeService.\n    \"\"\"\n    try:\n        result = _default_service.compute_and_persist(arr)\n        return result.changes\n    except ValidationError:\n        # Re-raise ValidationError as it's part of the public API contract for error handling\n        raise\n    except Exception as e:\n        # Catch any other unexpected errors and wrap them for clarity\n        logging.getLogger(__name__).error(f\"An unexpected error occurred during smallest_change computation: {e}\")\n        raise RuntimeError(\"An unexpected error occurred during computation.\") from e\n\n# Expose ValidationError\n__all__ = [\"smallest_change\", \"ValidationError\"]\n\n```\n```python\n# src/palindromizer/controllers/__init__.py\n# This file marks the controllers directory as a Python package.\n\n```\n```python\n# src/palindromizer/controllers/cli.py\nimport argparse\nimport json\nimport sys\nimport os\nimport logging\nfrom typing import List\n\nfrom src.palindromizer.config import Config, DEFAULT_MAX_IN_MEMORY\nfrom src.palindromizer.utils import parse_cli_array, ValidationError\nfrom src.palindromizer.algorithm import SmallestChangeAlgorithm\nfrom src.palindromizer.repository import InMemoryRepository, FileRepository\nfrom src.palindromizer.service import PalindromeService\nfrom src.palindromizer.models import ComputationRecord # For record listing\n\nlogger = logging.getLogger(__name__)\n\nclass CLIController:\n    \"\"\"CLI entrypoint for computing palindrome changes and managing records.\"\"\"\n    def __init__(self, service: PalindromeService):\n        self._service = service\n\n    def run_from_argv(self, argv: List[str]) -> int:\n        \"\"\"Parses CLI arguments, calls the service, prints results, and returns an exit code.\"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"palindromizer\",\n            description=\"Compute minimal changes to make an array palindromic.\"\n        )\n\n        subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\")\n\n        # Compute command\n        compute_parser = subparsers.add_parser(\"compute\", help=\"Compute changes for an array.\")\n        compute_parser.add_argument(\n            \"--arr\",\n            type=str,\n            required=True,\n            help=\"Comma-separated list of integers, e.g., '1,2,3,4,3,2,1'.\"\n        )\n\n        # Records command\n        records_parser = subparsers.add_parser(\"records\", help=\"List recent computation records.\")\n        records_parser.add_argument(\n            \"--limit\",\n            type=int,\n            default=10,\n            help=\"Number of recent records to retrieve (default: 10).\"\n        )\n\n        args = parser.parse_args(argv)\n\n        if args.command == \"compute\":\n            return self._handle_compute_command(args.arr)\n        elif args.command == \"records\":\n            return self._handle_records_command(args.limit)\n        else:\n            parser.print_help()\n            return 1 # No command given or unknown command\n\n    def _handle_compute_command(self, arr_str: str) -> int:\n        \"\"\"Handles the 'compute' command.\"\"\"\n        try:\n            arr = parse_cli_array(arr_str)\n            result = self._service.compute_and_persist(arr)\n            print(json.dumps(result.to_dict(), indent=2))\n            return 0\n        except ValidationError as e:\n            logger.error(f\"Input validation error: {e}\")\n            print(f\"Error: Invalid input: {e}\", file=sys.stderr)\n            return 2 # Specific exit code for input validation errors\n        except Exception as e:\n            logger.exception(\"An unexpected error occurred during computation.\")\n            print(f\"Error: An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n\n    def _handle_records_command(self, limit: int) -> int:\n        \"\"\"Handles the 'records' command.\"\"\"\n        try:\n            records: List[ComputationRecord] = self._service.get_recent(limit)\n            records_data = [\n                {\"id\": str(r.id), \"result\": r.result.to_dict()}\n                for r in records\n            ]\n            print(json.dumps(records_data, indent=2))\n            return 0\n        except Exception as e:\n            logger.exception(\"An unexpected error occurred while retrieving records.\")\n            print(f\"Error: Failed to retrieve records: {e}\", file=sys.stderr)\n            return 1\n\ndef main():\n    \"\"\"Main entry point for the CLI application.\"\"\"\n    # Configure logging for CLI\n    logging.basicConfig(level=os.environ.get(\"PALINDROMIZER_LOGLEVEL\", \"INFO\").upper(),\n                        format='%(asctime)s - CLI - %(levelname)s - %(message)s')\n\n    # Initialize dependencies for CLI\n    cli_config = Config(\n        persist=True, # CLI computations always persist by default\n        file_path=os.environ.get(\"PALINDROMIZER_FILE_REPO_PATH\"),\n        max_in_memory=int(os.environ.get(\"PALINDROMIZER_MAX_MEMORY_RECORDS\", DEFAULT_MAX_IN_MEMORY))\n    )\n    cli_algorithm = SmallestChangeAlgorithm()\n    cli_repository = (\n        FileRepository(file_path=cli_config.file_path)\n        if cli_config.file_path\n        else InMemoryRepository(max_in_memory=cli_config.max_in_memory)\n    )\n    cli_service = PalindromeService(\n        algorithm=cli_algorithm,\n        repository=cli_repository,\n        config=cli_config\n    )\n    controller = CLIController(service=cli_service)\n    sys.exit(controller.run_from_argv(sys.argv[1:]))\n\nif __name__ == \"__main__\":\n    main()\n\n```\n```python\n# src/palindromizer/controllers/rest.py\nimport os\nimport json\nimport logging\nfrom flask import Flask, request, jsonify\nfrom typing import Tuple, Dict, Any\n\nfrom src.palindromizer.config import Config, DEFAULT_MAX_IN_MEMORY\nfrom src.palindromizer.algorithm import SmallestChangeAlgorithm\nfrom src.palindromizer.repository import InMemoryRepository, FileRepository\nfrom src.palindromizer.service import PalindromeService\nfrom src.palindromizer.utils import ValidationError\nfrom src.palindromizer.models import ComputationRecord # For record listing\n\nlogger = logging.getLogger(__name__)\n\nclass RestController:\n    \"\"\"Factory for creating a Flask REST application.\"\"\"\n\n    @staticmethod\n    def create_app(config: Config, service: PalindromeService) -> Flask:\n        \"\"\"\n        Creates and configures a Flask application with the given service and config.\n        Exposes /compute and /records endpoints.\n        \"\"\"\n        app = Flask(__name__)\n        app.config[\"PALINDROMIZER_CONFIG\"] = config\n        app.config[\"PALINDROMIZER_SERVICE\"] = service\n\n        # Basic error handling for the app\n        @app.errorhandler(ValidationError)\n        def handle_validation_error(e: ValidationError) -> Tuple[Dict[str, str], int]:\n            logger.warning(f\"Validation error: {e.message}\")\n            return jsonify({\"error\": e.message}), 400\n\n        @app.errorhandler(Exception)\n        def handle_general_exception(e: Exception) -> Tuple[Dict[str, str], int]:\n            logger.exception(f\"An unhandled error occurred: {e}\")\n            return jsonify({\"error\": \"An internal server error occurred.\"}), 500\n\n        @app.route(\"/compute\", methods=[\"POST\"])\n        def compute_endpoint() -> Tuple[Dict[str, Any], int]:\n            \"\"\"\n            Handles POST requests to compute the minimal changes for an array.\n            Expects JSON body: {\"arr\": [int, ...]}\n            Returns JSON: {\"changes\": int, \"length\": int, \"timestamp\": str, \"preview\": str}\n            \"\"\"\n            service_instance: PalindromeService = app.config[\"PALINDROMIZER_SERVICE\"]\n            \n            if not request.is_json:\n                raise ValidationError(\"Request must be JSON with 'Content-Type: application/json'.\")\n            \n            payload = request.get_json()\n            if not payload or \"arr\" not in payload:\n                raise ValidationError(\"JSON body must contain an 'arr' field.\")\n\n            arr = payload.get(\"arr\")\n            result = service_instance.compute_and_persist(arr)\n            return jsonify(result.to_dict()), 200\n\n        @app.route(\"/records\", methods=[\"GET\"])\n        def get_records_endpoint() -> Tuple[Dict[str, Any], int]:\n            \"\"\"\n            Handles GET requests to retrieve recent computation records.\n            Query param: limit (int, optional, default: 10)\n            Returns JSON array of records.\n            \"\"\"\n            service_instance: PalindromeService = app.config[\"PALINDROMIZER_SERVICE\"]\n            \n            limit_str = request.args.get(\"limit\", \"10\")\n            try:\n                limit = int(limit_str)\n                if limit < 1:\n                    raise ValueError\n            except ValueError:\n                raise ValidationError(\"Limit must be a positive integer.\")\n\n            records = service_instance.get_recent(limit)\n            records_data = [\n                {\"id\": str(r.id), \"result\": r.result.to_dict()}\n                for r in records\n            ]\n            return jsonify(records_data), 200\n\n        return app\n\ndef create_rest_app():\n    \"\"\"\n    Convenience function to create a Flask app for WSGI servers.\n    Initializes dependencies based on environment variables.\n    \"\"\"\n    # Configure logging for REST app\n    logging.basicConfig(level=os.environ.get(\"PALINDROMIZER_LOGLEVEL\", \"INFO\").upper(),\n                        format='%(asctime)s - REST - %(levelname)s - %(message)s')\n\n    # Initialize dependencies for REST\n    rest_config = Config(\n        persist=True, # REST computations always persist by default\n        file_path=os.environ.get(\"PALINDROMIZER_FILE_REPO_PATH\"),\n        max_in_memory=int(os.environ.get(\"PALINDROMIZER_MAX_MEMORY_RECORDS\", DEFAULT_MAX_IN_MEMORY))\n    )\n    rest_algorithm = SmallestChangeAlgorithm()\n    rest_repository = (\n        FileRepository(file_path=rest_config.file_path)\n        if rest_config.file_path\n        else InMemoryRepository(max_in_memory=rest_config.max_in_memory)\n    )\n    rest_service = PalindromeService(\n        algorithm=rest_algorithm,\n        repository=rest_repository,\n        config=rest_config\n    )\n    return RestController.create_app(rest_config, rest_service)\n\nif __name__ == \"__main__\":\n    # Example for running locally directly (for development/testing)\n    app = create_rest_app()\n    app.run(debug=True, host=\"0.0.0.0\", port=5000)\n\n```\n```python\n# tests/test_algorithm.py\nimport pytest\nfrom src.palindromizer.algorithm import Sma