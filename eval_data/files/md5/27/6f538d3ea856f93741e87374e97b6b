st[int] = []\n    for token in tokens:\n        try:\n            parsed_list.append(int(token))\n        except ValueError:\n            raise ValidationError(f\"Invalid number format: '{token}'. All elements must be integers.\")\n    return parsed_list\n\ndef list_to_str(lst: Sequence[int]) -> str:\n    \"\"\"\n    Converts a sequence of integers into a comma-separated string representation.\n    \"\"\"\n    return '[' + ', '.join(map(str, lst)) + ']'\n\n```python\n# src/cli.py\nimport sys\nfrom typing import Optional, Sequence\nfrom sortedchecker.controllers import CLIController\nfrom sortedchecker.validators import InputValidator\nfrom sortedchecker.services import SortedCheckerService\n\ndef main(argv: Optional[Sequence[str]] = None) -> int:\n    \"\"\"\n    Console script entry point for the `sorted-checker` CLI tool.\n    Initializes dependencies and runs the CLI controller.\n    \"\"\"\n    actual_argv = argv if argv is not None else sys.argv[1:]\n\n    # Dependency injection setup\n    validator = InputValidator()\n    service = SortedCheckerService(validator)\n    controller = CLIController(service)\n\n    return controller.run(actual_argv)\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n\n```python\n# pyproject.toml\n[project]\nname = \"sorted-checker\"\nversion = \"0.1.0\"\ndescription = \"A Python library and CLI to check if a list of non-negative integers is sorted ascending with a duplicate rule.\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }] # Replace with actual author info\nlicense = { text = \"MIT\" }\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\nkeywords = [\"sort\", \"validation\", \"cli\"]\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n    \"Intended Audience :: Developers\",\n    \"Topic :: Utilities\",\n]\n\n[project.urls]\nHomepage = \"https://github.com/yourusername/sorted-checker\" # Replace with actual GitHub URL\n\"Bug Tracker\" = \"https://github.com/yourusername/sorted-checker/issues\"\n\n[project.scripts]\nsorted-checker = \"cli:main\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n```"}
{"task_id": "HumanEval/127", "solution": "import math\n\ndef intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two closed integer intervals is a prime number.\n    Returns \"YES\" if the length is prime, otherwise \"NO\".\n    \"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Checks if a non-negative integer n is a prime number.\n        This function handles small values and performs trial division for larger numbers.\n        \"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        # Check for odd divisors up to the square root of n.\n        i = 3\n        limit = int(math.isqrt(n))\n        while i <= limit:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    # Extract start and end values from the input intervals.\n    start1, end1 = interval1[0], interval1[1]\n    start2, end2 = interval2[0], interval2[1]\n\n    # Calculate the start and end of the intersection.\n    intersect_start = max(start1, start2)\n    intersect_end = min(end1, end2)\n\n    # If the intersection end is less than the start, there is no overlap.\n    if intersect_end < intersect_start:\n        return \"NO\"\n\n    # Calculate the length of the intersection.\n    length = intersect_end - intersect_start\n\n    # Determine if the intersection length is a prime number.\n    if _is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/126", "solution": "```python\ndef is_sorted(lst):\n    '''\n    Checks if a list of non-negative integers is sorted non-decreasingly\n    and if no number appears more than twice.\n    '''\n    # Check if the list is sorted in non-decreasing order.\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Count occurrences of each number and check the duplicate rule.\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:\n            return False\n\n    return True\n```"}
{"task_id": "HumanEval/128", "solution": "```python\ndef sign(n):\n    \"\"\"Returns the sign of an integer: 1 for positive, -1 for negative, 0 for zero.\"\"\"\n    if n > 0:\n        return 1\n    if n < 0:\n        return -1\n    return 0\n\ndef safe_product(values):\n    \"\"\"Computes the product of values, returning 0 immediately if any value is zero.\"\"\"\n    prod = 1\n    for v in values:\n        if v == 0:\n            return 0\n        prod *= v\n    return prod\n\ndef prod_signs(arr):\n    \"\"\"\n    Computes sum of magnitudes multiplied by product of signs for an array of integers.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_of_magnitudes = sum(abs(x) for x in arr)\n    signs_product = safe_product(sign(x) for x in arr)\n\n    return signs_product * sum_of_magnitudes\n```"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise.\"\"\"\n\n    def _is_prime(n):\n        \"\"\"Checks if a non-negative integer is a prime number.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    s1, e1 = interval1\n    s2, e2 = interval2\n\n    intersect_start = max(s1, s2)\n    intersect_end = min(e1, e2)\n\n    if intersect_start > intersect_end:\n        return \"NO\"\n\n    length = intersect_end - intersect_start\n\n    if _is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Computes the sum of magnitudes multiplied by the product of signs for integers in an array.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        if num > 0:\n            sign = 1\n        elif num < 0:\n            sign = -1\n        else:\n            sign = 0\n            # If any number is zero, the product of signs will be zero.\n            # We can short-circuit this calculation as the final result will be zero.\n            product_of_signs = 0\n            # Continue to sum magnitudes if needed, though product * sum will be 0.\n\n        if product_of_signs != 0: # Only update product if it hasn't become zero already\n            product_of_signs *= sign\n        \n        sum_of_magnitudes += abs(num)\n\n    return product_of_signs * sum_of_magnitudes"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Computes the lexicographically minimum path of length k on a square grid.\n    Moves are orthogonal, revisiting cells is allowed.\n    \"\"\"\n    N = len(grid)\n    \n    def get_neighbors(r, c, size):\n        neighbors_list = []\n        deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n        for dr, dc in deltas:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < size and 0 <= nc < size:\n                neighbors_list.append((nr, nc))\n        return neighbors_list\n\n    candidates = set()\n    for r_idx in range(N):\n        for c_idx in range(N):\n            candidates.add((r_idx, c_idx))\n\n    result = []\n\n    for _step in range(k):\n        min_val = float('inf')\n        for r, c in candidates:\n            current_val = grid[r][c]\n            if current_val < min_val:\n                min_val = current_val\n\n        result.append(min_val)\n\n        chosen_positions = set()\n        for r, c in candidates:\n            if grid[r][c] == min_val:\n                chosen_positions.add((r, c))\n        \n        next_candidates = set()\n        for r, c in chosen_positions:\n            for neighbor_r, neighbor_c in get_neighbors(r, c, N):\n                next_candidates.add((neighbor_r, neighbor_c))\n\n        candidates = next_candidates\n\n    return result"}
{"task_id": "HumanEval/129", "solution": "```python\nfrom typing import List, Dict, Tuple\n\n# Constant for 4-directional movement (up, down, left, right).\nDIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\nclass Position:\n    \"\"\"A lightweight immutable object representing a cell's row, column, and its value.\"\"\"\n    def __init__(self, row: int, col: int, value: int) -> None:\n        self.row = row\n        self.col = col\n        self.value = value\n\n    def tuple(self) -> Tuple[int, int]:\n        \"\"\"Returns the (row, col) coordinates of the position.\"\"\"\n        return (self.row, self.col)\n\nclass GridModel:\n    \"\"\"Encapsulates the grid data, providing efficient value-to-position mapping and neighbor lookups.\"\"\"\n    def __init__(self, grid: List[List[int]]) -> None:\n        self.grid = [list(row) for row in grid]\n        self.n = len(grid)\n        self.value_to_pos: Dict[int, Position] = {}\n        for r in range(self.n):\n            for c in range(self.n):\n                val = self.grid[r][c]\n                self.value_to_pos[val] = Position(r, c, val)\n\n    def get_position(self, value: int) -> Position:\n        \"\"\"Returns the Position object for a given cell value.\"\"\"\n        return self.value_to_pos[value]\n\n    def neighbors(self, pos: Position) -> List[Position]:\n        \"\"\"Returns a list of Position objects for all valid 4-neighbors of the given position.\"\"\"\n        out = []\n        for dr, dc in DIRECTIONS:\n            nr, nc = pos.row + dr, pos.col + dc\n            if 0 <= nr < self.n and 0 <= nc < self.n:\n                v = self.grid[nr][nc]\n                out.append(Position(nr, nc, v))\n        return out\n\ndef minPath(grid, k):\n    \"\"\"\n    Given a grid and k, finds the lexicographically minimum path of length k.\n    It starts from the value 1 and greedily picks the smallest valued neighbor at each step.\n    \"\"\"\n    grid_model = GridModel(grid)\n    \n    # The lexicographically minimum path must start with the smallest possible value, which is 1.\n    current_pos = grid_model.get_position(1) \n    path = [current_pos.value]\n\n    # For the remaining k-1 steps, find the neighbor with the minimum value and append it.\n    for _ in range(1, k):\n        nbrs = grid_model.neighbors(current_pos)\n        next_pos = min(nbrs, key=lambda p: p.value)\n        path.append(next_pos.value)\n        current_pos = next_pos\n        \n    return path\n```"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Computes the first n+1 Tribonacci numbers.\n    The sequence follows specific rules for even and odd indices.\n    \"\"\"\n    \n    # Based on the design, tri(0) = 1 is inferred from example, tri(1) = 3 is given.\n    BASE_TRI_0 = 1\n    BASE_TRI_1 = 3\n\n    # The recurrence for odd n depends on tri(n+1).\n    # If n is odd, we need to compute up to index n+1 to resolve tri(n).\n    # If n is even, we only need to compute up to n.\n    max_idx = n if n % 2 == 0 else n + 1\n    \n    # Initialize buffer for sequence values up to max_idx.\n    # We use a list and fill it directly.\n    buffer = [0] * (max_idx + 1)\n\n    # Set base cases for indices 0 and 1.\n    buffer[0] = BASE_TRI_0\n    if max_idx >= 1: # Ensure buffer[1] is a valid index before setting\n        buffer[1] = BASE_TRI_1\n\n    # First pass: Populate all even indices (i >= 2) using the direct formula.\n    for i in range(2, max_idx + 1):\n        if i % 2 == 0:\n            buffer[i] = 1 + i // 2 # Integer division as specified\n\n    # Second pass: Populate all odd indices (i >= 3) using the recurrence.\n    # At this point, even indices and base odd index (1) are already filled.\n    # The required tri(i+1) (which is an even index) will be available.\n    for i in range(3, max_idx + 1):\n        if i % 2 != 0: # If i is odd\n            buffer[i] = buffer[i - 1] + buffer[i - 2] + buffer[i + 1]\n\n    # Return the first n+1 numbers of the sequence.\n    return buffer[:n + 1]"}
{"task_id": "HumanEval/131", "solution": "```python\ndef digits(n):\n    \"\"\"Given a positive integer n, return the product of its odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product = 1\n    had_odd_digit = False\n    \n    for char_digit in str(n):\n        digit = int(char_digit)\n        if digit % 2 != 0:\n            product *= digit\n            had_odd_digit = True\n            \n    return product if had_odd_digit else 0\n```"}
{"task_id": "HumanEval/130", "solution": "```python\nfrom typing import List\n\ndef tri(n: int) -> List[int]:\n    \"\"\"\n    Computes the Tribonacci-like sequence up to index n.\n    Returns a list of the first n+1 values.\n    \"\"\"\n    memo = {}\n\n    def _get_tri_value(k: int) -> int:\n        \"\"\"Helper to compute and cache a single Tribonacci value.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            value = 1\n        elif k == 1:\n            value = 3\n        elif k % 2 == 0:  # Even k >= 2\n            value = 1 + k // 2\n        else:  # Odd k >= 1\n            # Recurrence tri(k) = tri(k-1) + tri(k-2) + tri(k+1)\n            # Note: tri(k+1) is always even, which is computed directly.\n            value = _get_tri_value(k - 1) + _get_tri_value(k - 2) + _get_tri_value(k + 1)\n        \n        memo[k] = value\n        return value\n\n    # Determine the maximum index required for internal calculations.\n    # If n is odd, tri(n+1) is needed to compute tri(n).\n    max_needed_index = n\n    if n % 2 != 0:\n        max_needed_index = n + 1\n\n    # Populate the memoization cache for all necessary values.\n    for i in range(max_needed_index + 1):\n        _get_tri_value(i)\n\n    # Construct the final list containing values from tri(0) to tri(n).\n    result_list = [memo[i] for i in range(n + 1)]\n    return result_list\n```"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\"\"\"\n    product = 1\n    has_odd_digit = False\n    for char_digit in str(n):\n        digit_value = int(char_digit)\n        if digit_value % 2 != 0:\n            product *= digit_value\n            has_odd_digit = True\n    return product if has_odd_digit else 0"}
{"task_id": "HumanEval/132", "solution": "```python\ndef is_nested(string):\n    '''\n    Checks if a string of brackets contains a nested subsequence \"[[ ]]\".\n    Returns True if such a subsequence exists, False otherwise.\n    '''\n    \n    # The algorithm finds the index of the second opening bracket and then counts\n    # at least two closing brackets occurring after it.\n    \n    first_open_idx = -1\n    second_open_idx = -1\n    \n    for i, char in enumerate(string):\n        if char == '[':\n            if first_open_idx == -1:\n                first_open_idx = i\n            else:\n                second_open_idx = i\n                break \n                \n    if second_open_idx == -1:\n        return False \n        \n    close_count = 0\n    for i in range(second_open_idx + 1, len(string)):\n        if string[i] == ']':\n            close_count += 1\n            if close_count >= 2:\n                return True \n                \n    return False \n```"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if a bracket-only string contains a valid nested subsequence of square brackets.\n    The function assumes the input string contains only '[' and ']' characters.\n    \"\"\"\n    opens = [i for i, ch in enumerate(string) if ch == '[']\n    closes = [i for i, ch in enumerate(string) if ch == ']']\n\n    if len(opens) < 2 or len(closes) < 2:\n        return False\n\n    k_closes_pointer = 0\n\n    # Iterate through each potential second opening bracket (opens[j_opens])\n    # The first opening bracket is implicitly opens[0], ensuring opens[0] < opens[j_opens]\n    for j_opens in range(1, len(opens)):\n        current_open_idx = opens[j_opens]\n\n        # Advance k_closes_pointer to find the first closing bracket (closes[k_closes_pointer])\n        # that appears strictly after current_open_idx\n        while k_closes_pointer < len(closes) and closes[k_closes_pointer] <= current_open_idx:\n            k_closes_pointer += 1\n\n        # If we found a closing bracket at closes[k_closes_pointer]\n        # AND there's at least one more closing bracket after it (closes[k_closes_pointer + 1]),\n        # then we have found a valid nested subsequence [ [ ] ]\n        if k_closes_pointer < len(closes) and (k_closes_pointer + 1) < len(closes):\n            return True\n\n    return False"}
{"task_id": "HumanEval/133", "solution": "import math\n\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    \"\"\"\n    total_sum = 0\n    for number in lst:\n        ceiled_number = math.ceil(number)\n        total_sum += ceiled_number * ceiled_number\n    return total_sum"}
{"task_id": "HumanEval/133", "solution": "from math import ceil\n\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    \"\"\"\n    # Computes the sum of squared ceil-rounded numbers for each element in the input list.\n    # The sum() function handles an empty list by correctly returning 0.\n    return sum(int(ceil(x))**2 for x in lst)"}
{"task_id": "HumanEval/135", "solution": "```python\ndef can_arrange(arr):\n    \"\"\"Returns the largest index of an element not greater than or equal to its predecessor.\n    Returns -1 if no such element exists.\n    \"\"\"\n    n = len(arr)\n    if n < 2:\n        return -1\n    for i in range(n - 1, 0, -1):\n        if arr[i] < arr[i - 1]:\n            return i\n    return -1\n```"}
{"task_id": "HumanEval/134", "solution": "```python\ndef check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the actual last character of a string is an alphabetic letter.\n    It returns True if this letter is a standalone one-character word, separated\n    by a space or by the beginning of the string, otherwise False.\n    \"\"\"\n    n = len(txt)\n    if n == 0:\n        return False\n\n    last_char = txt[n - 1]\n\n    is_ascii_letter = ('a' <= last_char <= 'z') or ('A' <= last_char <= 'Z')\n    if not is_ascii_letter:\n        return False\n\n    # Check if the letter is \"not part of a word\" (i.e., it's a standalone word of length 1).\n    # This is true if it's the only character in the string, or if the character\n    # immediately preceding it is a space.\n    if n == 1:\n        return True\n    \n    if txt[n - 2] == ' ':\n        return True\n    \n    return False\n```"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a given string is a standalone alphabetical character.\n    A standalone character is a single-letter token separated by spaces.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    is_alpha = ('a' <= last_char <= 'z') or ('A' <= last_char <= 'Z')\n\n    if not is_alpha:\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    preceding_char = txt[-2]\n    if preceding_char == ' ':\n        return True\n    else:\n        return False"}
