lf.result}\n\n@dataclass(frozen=True)\nclass HistoryEntry:\n    \"\"\"\n    Domain model for a processed history entry.\n    \"\"\"\n    id: str\n    original: str\n    result: str\n    timestamp: str\n\n    @classmethod\n    def create(cls, original: str, result: str, max_original_length: int) -> \"HistoryEntry\":\n        \"\"\"\n        Factory method to create a HistoryEntry with a new UUID and timestamp.\n        \"\"\"\n        return cls(\n            id=str(uuid.uuid4()),\n            original=original[:max_original_length], # Truncate original for history\n            result=result,\n            timestamp=datetime.datetime.utcnow().isoformat(timespec='seconds') + \"Z\"\n        )\n\n```\n```python\n# src/remove_vowels_app/utils.py\nfrom typing import Any\n\n# The bare remove_vowels function as per CRITICAL REQUIREMENTS.\n# This function is designed to be simple and directly implements the vowel removal.\n# It does NOT perform type checks or use configurable vowel sets, adhering strictly\n# to the specific \"CRITICAL REQUIREMENTS\" for this exact function signature.\ndef remove_vowels(text):\n    \"\"\"\n    remove_vowels is a function that takes string and returns string without vowels.\n    \"\"\"\n    vowels = \"aeiouAEIOU\"\n    return \"\".join(char for char in text if char not in vowels)\n\n\nDEFAULT_MAX_TEXT_LENGTH = 10000\n\ndef validate_text(text: Any) -> str:\n    \"\"\"\n    Validates that the input is a string and not excessively long.\n    Raises TypeError if not a string, ValueError if too long.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n    if len(text) > DEFAULT_MAX_TEXT_LENGTH:\n        raise ValueError(f\"Input text exceeds maximum allowed length of {DEFAULT_MAX_TEXT_LENGTH} characters.\")\n    return text\n\ndef truncate(text: str, max_len: int) -> str:\n    \"\"\"\n    Truncates a string to a maximum length if it exceeds it.\n    \"\"\"\n    return text[:max_len] if len(text) > max_len else text\n\n```\n```python\n# src/remove_vowels_app/services.py\nfrom typing import Iterable, Iterator, Optional, Set\nfrom remove_vowels_app.utils import validate_text\n\nDEFAULT_VOWELS = set(\"aeiouAEIOU\")\n\nclass VowelRemover:\n    \"\"\"\n    Core service for removing vowels from text.\n    It implements configurable vowel sets and input validation.\n    \"\"\"\n    def __init__(self, vowels: Optional[Iterable[str]] = None) -> None:\n        self._vowel_set: Set[str] = set(vowels) if vowels is not None else DEFAULT_VOWELS\n\n    def remove(self, text: str) -> str:\n        \"\"\"\n        Removes all characters from the input string that are in the configured vowel set.\n        Performs input validation as per FR1.\n        \"\"\"\n        # FR1: Error handling for non-str inputs.\n        validate_text(text) # This will raise TypeError or ValueError\n\n        # FR1: Iterate characters and filter those in _vowel_set.\n        # This implementation uses the class's _vowel_set, fulfilling the design's flexibility.\n        return \"\".join(self.remove_iter(text))\n\n    def remove_iter(self, text: str) -> Iterator[str]:\n        \"\"\"\n        Generator that yields characters from text, excluding those in the vowel set.\n        \"\"\"\n        for ch in text:\n            if ch not in self._vowel_set:\n                yield ch\n\n```\n```python\n# src/remove_vowels_app/repository.py\nimport json\nimport os\nimport fcntl # For file locking on Unix-like systems\nfrom collections import deque\nfrom typing import List, Optional\n\nfrom remove_vowels_app.models import HistoryEntry\nfrom remove_vowels_app.utils import truncate\nfrom remove_vowels_app.config import AppConfig\n\nimport logging\nlogger = logging.getLogger(__name__)\n\nclass InMemoryRepository:\n    \"\"\"\n    In-memory storage for a bounded recent history of processed items.\n    \"\"\"\n    def __init__(self, capacity: int, max_original_length: int) -> None:\n        self._capacity: int = capacity\n        self._entries: deque[HistoryEntry] = deque()\n        self._max_original_length = max_original_length\n\n    def save(self, original: str, result: str) -> str:\n        \"\"\"\n        Creates and stores a new history entry, truncating if capacity is exceeded.\n        \"\"\"\n        entry = HistoryEntry.create(original, result, self._max_original_length)\n        self._entries.append(entry)\n        while len(self._entries) > self._capacity:\n            self._entries.popleft()\n        return entry.id\n\n    def get_recent(self, n: int = 10) -> List[HistoryEntry]:\n        \"\"\"\n        Returns the last 'n' history entries in reverse chronological order.\n        \"\"\"\n        return list(self._entries)[-n:][::-1]\n\nclass FileRepository(InMemoryRepository):\n    \"\"\"\n    A repository that stores history in memory and optionally persists to a JSON file.\n    It supports atomic writes and basic file locking.\n    \"\"\"\n    def __init__(self, path: str, capacity: int, max_original_length: int) -> None:\n        super().__init__(capacity, max_original_length)\n        self._path: str = path\n        self._load_all() # Load existing history on startup\n\n    def save(self, original: str, result: str) -> str:\n        \"\"\"\n        Saves a new entry, persists to file, and returns the entry ID.\n        Handles I/O errors by logging and falling back to in-memory only.\n        \"\"\"\n        entry_id = super().save(original, result)\n        try:\n            self._persist_all(list(self._entries))\n        except IOError as e:\n            logger.warning(f\"Failed to persist history to file {self._path}: {e}. Falling back to in-memory only.\")\n        return entry_id\n\n    def _load_all(self) -> None:\n        \"\"\"\n        Loads all history entries from the JSON file, handling file locks and errors.\n        \"\"\"\n        if not os.path.exists(self._path):\n            return\n\n        try:\n            with open(self._path, 'r') as f:\n                fcntl.flock(f, fcntl.LOCK_SH) # Acquire shared lock\n                data = json.load(f)\n                fcntl.flock(f, fcntl.LOCK_UN) # Release lock\n            if not isinstance(data, list):\n                raise ValueError(\"History file content is not a JSON array.\")\n            self._entries.clear()\n            for item in data:\n                try:\n                    # Basic validation of history entry structure\n                    entry = HistoryEntry(\n                        id=item['id'],\n                        original=item['original'],\n                        result=item['result'],\n                        timestamp=item['timestamp']\n                    )\n                    self._entries.append(entry)\n                except KeyError as e:\n                    logger.warning(f\"Skipping malformed history entry in {self._path}: missing key {e}. Entry: {item}\")\n            # Ensure loaded entries respect capacity\n            while len(self._entries) > self._capacity:\n                self._entries.popleft()\n        except (IOError, json.JSONDecodeError, ValueError) as e:\n            logger.error(f\"Error loading history from {self._path}: {e}. Starting with empty history.\")\n            self._entries.clear()\n        except Exception as e:\n            logger.error(f\"An unexpected error occurred while loading history from {self._path}: {e}. Starting with empty history.\")\n            self._entries.clear()\n\n    def _persist_all(self, entries: List[HistoryEntry]) -> None:\n        \"\"\"\n        Persists all current history entries to the JSON file atomically using a temporary file.\n        \"\"\"\n        # Ensure directory exists\n        os.makedirs(os.path.dirname(self._path), exist_ok=True)\n\n        # Write to a temporary file first, then rename for atomicity\n        temp_path = self._path + \".tmp\"\n        try:\n            with open(temp_path, 'w') as f:\n                fcntl.flock(f, fcntl.LOCK_EX) # Acquire exclusive lock\n                json.dump([entry.__dict__ for entry in entries], f, indent=2)\n                fcntl.flock(f, fcntl.LOCK_UN) # Release lock\n            os.replace(temp_path, self._path) # Atomic rename\n        except Exception as e:\n            # Clean up temp file on error\n            if os.path.exists(temp_path):\n                os.remove(temp_path)\n            raise IOError(f\"Failed to write history to {self._path}\") from e\n\n```\n```python\n# src/remove_vowels_app/controllers.py\nimport argparse\nimport sys\nfrom typing import List, TextIO, Dict, Any, Optional\n\nfrom fastapi import FastAPI, Request, HTTPException, status, Depends\nfrom fastapi.responses import JSONResponse\n\nfrom remove_vowels_app.config import AppConfig\nfrom remove_vowels_app.models import TextDTO, ResultDTO\nfrom remove_vowels_app.services import VowelRemover\nfrom remove_vowels_app.repository import InMemoryRepository # FileRepository is a subclass, so this covers it.\nfrom remove_vowels_app.utils import validate_text\n\nimport logging\nlogger = logging.getLogger(__name__)\n\nclass CLIController:\n    \"\"\"\n    Controller for the command-line interface.\n    Handles argument parsing, input/output streams, and error reporting.\n    \"\"\"\n    def __init__(self, service: VowelRemover, repo: InMemoryRepository, config: AppConfig) -> None:\n        self._service = service\n        self._repo = repo\n        self._config = config\n\n    def run(self, args: List[str], input_stream: TextIO, output_stream: TextIO, err_stream: TextIO) -> int:\n        \"\"\"\n        Executes the CLI logic: parses args, reads input, processes it, writes output, and handles errors.\n        \"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"remove-vowels\",\n            description=\"Remove vowels from text provided via argument or stdin.\"\n        )\n        parser.add_argument(\n            \"text\",\n            nargs=\"?\", # Optional positional argument\n            help=\"Text to process. If not provided, reads from stdin.\"\n        )\n        parser.add_argument(\n            \"--history\",\n            action=\"store_true\",\n            help=\"Show recent processing history.\"\n        )\n        parser.add_argument(\n            \"--history-count\",\n            type=int,\n            default=10,\n            help=\"Number of history entries to show (default: 10).\"\n        )\n\n        parsed_args = parser.parse_args(args)\n\n        if parsed_args.history:\n            entries = self._repo.get_recent(parsed_args.history_count)\n            if not entries:\n                output_stream.write(\"No history entries found.\\n\")\n            for entry in entries:\n                output_stream.write(f\"[{entry.timestamp}] ID: {entry.id}\\n\")\n                output_stream.write(f\"  Original: '{entry.original}'\\n\")\n                output_stream.write(f\"  Result:   '{entry.result}'\\n\")\n                output_stream.write(\"---\\n\")\n            return 0\n\n        input_text: str\n        try:\n            if parsed_args.text:\n                input_text = parsed_args.text\n            else:\n                input_text = input_stream.read()\n                if not input_text:\n                    err_stream.write(\"Error: No input text provided via argument or stdin.\\n\")\n                    return 1\n\n            # Validate text against max length before processing\n            input_text = validate_text(input_text)\n            result = self._service.remove(input_text)\n            self._repo.save(input_text, result)\n            output_stream.write(result)\n            output_stream.write(\"\\n\") # Ensure a newline at the end for consistent CLI behavior\n            return 0\n        except (TypeError, ValueError) as e:\n            err_stream.write(f\"Input Error: {e}\\n\")\n            return 1\n        except Exception as e:\n            logger.exception(\"An unexpected error occurred in CLI.\")\n            err_stream.write(f\"An unexpected error occurred: {e}\\n\")\n            return 2\n\n\nclass APIController:\n    \"\"\"\n    Controller for the HTTP API endpoints using FastAPI.\n    Registers routes and handles request/response logic.\n    \"\"\"\n    def __init__(self, service: VowelRemover, repo: InMemoryRepository, config: AppConfig) -> None:\n        self._service = service\n        self._repo = repo\n        self._config = config\n\n    def _get_api_key(self, x_api_key: Optional[str] = Depends(lambda header: header(\"X-API-Key\", default=None))):\n        \"\"\"\n        Dependency for API key authentication, raising 401 if required and invalid.\n        \"\"\"\n        if self._config.api_key:\n            if not x_api_key or x_api_key != self._config.api_key:\n                raise HTTPException(\n                    status_code=status.HTTP_401_UNAUTHORIZED,\n                    detail=\"Invalid or missing API Key\"\n                )\n        return x_api_key # Return key if valid or not required\n\n    def register(self, fastapi_app: FastAPI) -> None:\n        \"\"\"\n        Registers the API routes with the given FastAPI application.\n        \"\"\"\n        @fastapi_app.post(\"/remove-vowels\", summary=\"Remove vowels from text\")\n        async def remove_vowels_endpoint(\n            request: Request,\n            payload: Dict[str, Any],\n            api_key_header: Optional[str] = Depends(self._get_api_key)\n        ) -> JSONResponse:\n            \"\"\"\n            Accepts JSON payload {\"text\": \"<string>\"} and returns {\"result\": \"<string>\"}.\n            \"\"\"\n            # Check Content-Type (FastAPI handles most of this, but explicit check for 415)\n            if request.headers.get(\"Content-Type\") != \"application/json\":\n                raise HTTPException(\n                    status_code=status.HTTP_415_UNSUPPORTED_MEDIA_TYPE,\n                    detail=\"Unsupported Media Type. Must be application/json.\"\n                )\n\n            try:\n                text_dto = TextDTO.from_dict(payload)\n                # Max text length is also validated in service.remove, but here we can\n                # give a more specific 400 error before hitting the service if it's too long.\n                if len(text_dto.text) > self._config.max_text_length:\n                    raise HTTPException(\n                        status_code=status.HTTP_400_BAD_REQUEST,\n                        detail=f\"Input text exceeds maximum allowed length of {self._config.max_text_length} characters.\"\n                    )\n\n                result_text = self._service.remove(text_dto.text)\n                self._repo.save(text_dto.text, result_text)\n                result_dto = ResultDTO(result=result_text)\n                return JSONResponse(content=result_dto.to_dict(), status_code=status.HTTP_200_OK)\n            except (ValueError, TypeError) as e:\n                raise HTTPException(\n                    status_code=status.HTTP_400_BAD_REQUEST,\n                    detail=str(e)\n                ) from e\n            except Exception as e:\n                logger.exception(\"An unexpected error occurred in API endpoint.\")\n                raise HTTPException(\n                    status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                    detail=\"An internal server error occurred.\"\n                ) from e\n\n        @fastapi_app.get(\"/history\", summary=\"Get recent processing history\")\n        async def get_history_endpoint(\n            count: int = 10,\n            api_key_header: Optional[str] = Depends(self._get_api_key)\n        ) -> List[Dict[str, str]]:\n            \"\"\"\n            Returns the recent processing history.\n            \"\"\"\n            if not (1 <= count <= self._config.history_capacity):\n                raise HTTPException(\n                    status_code=status.HTTP_400_BAD_REQUEST,\n                    detail=f\"History count must be between 1 and {self._config.history_capacity}.\"\n                )\n            entries = self._repo.get_recent(count)\n            return [e.__dict__ for e in entries]\n\n```\n```python\n# src/remove_vowels_app/api.py\nfrom fastapi import FastAPI, Depends\n\nfrom remove_vowels_app.config import AppConfig\nfrom remove_vowels_app.services import VowelRemover\nfrom remove_vowels_app.repository import InMemoryRepository, FileRepository\nfrom remove_vowels_app.controllers import APIController\n\nimport logging\nlogger = logging.getLogger(__name__)\n\n# FastAPI app metadata\nAPP_NAME = \"Vowel Remover API\"\nAPP_DESCRIPTION = \"A simple service to remove vowels from text.\"\nAPP_VERSION = \"0.1.0\" # Consistent with __version__ in __init__.py\n\ndef create_api(service: VowelRemover, repo: InMemoryRepository, config: AppConfig) -> FastAPI:\n    \"\"\"\n    Creates and configures the FastAPI application, registering API routes.\n    \"\"\"\n    app = FastAPI(\n        title=APP_NAME,\n        description=APP_DESCRIPTION,\n        version=APP_VERSION,\n        openapi_url=\"/openapi.json\",\n        docs_url=\"/docs\",\n        redoc_url=\"/redoc\"\n    )\n\n    api_controller = APIController(service, repo, config)\n    api_controller.register(app)\n\n    # Health check endpoint\n    @app.get(\"/health\", response_model=dict, summary=\"Health check endpoint\")\n    async def health_check():\n        return {\"status\": \"ok\", \"version\": APP_VERSION}\n\n    return app\n\n```\n```python\n# src/remove_vowels_app/app.py\nimport sys\nimport logging\nfrom typing import List, Tuple, Optional\n\nfrom remove_vowels_app.config import AppConfig, DEFAULT_CONFIG\nfrom remove_vowels_app.services import VowelRemover\nfrom remove_vowels_app.repository import InMemoryRepository, FileRepository\nfrom remove_vowels_app.controllers import CLIController\n\n# Configure basic logging for the application\nlogging.basicConfig(level=logging.INFO, stream=sys.stderr,\n                    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\nlogger = logging.getLogger(__name__)\n\nclass ApplicationFactory:\n    \"\"\"\n    Factory class to create and wire application components based on configuration.\n    \"\"\"\n    @staticmethod\n    def create(config: Optional[AppConfig] = None) -> Tuple[VowelRemover, InMemoryRepository, AppConfig]:\n        \"\"\"\n        Creates and wires the core application components.\n        Initializes VowelRemover and the appropriate repository (InMemory or File).\n        \"\"\"\n        if config is None:\n            config = DEFAULT_CONFIG\n\n        vowel_remover = VowelRemover() # Uses default vowels as per design\n\n        repository: InMemoryRepository\n        if config.json_store_path:\n            repository = FileRepository(\n                path=config.json_store_path,\n                capacity=config.history_capacity,\n                max_original_length=config.max_text_length\n            )\n            logger.info(f\"Using FileRepository with path: {config.json_store_path} and capacity: {config.history_capacity}\")\n        else:\n            repository = InMemoryRepository(\n                capacity=config.history_capacity,\n                max_original_length=config.max_text_length\n            )\n            logger.info(f\"Using InMemoryRepository with capacity: {config.history_capacity}\")\n\n        return vowel_remover, repository, config\n\ndef main_cli(argv: List[str]) -> int:\n    \"\"\"\n    Main entry point for the CLI application.\n    Initializes components and runs the CLI controller.\n    \"\"\"\n    logger.info(\"Starting CLI application.\")\n    service, repo, config = ApplicationFactory.create()\n    cli_controller = CLIController(service, repo, config)\n    return cli_controller.run(argv, sys.stdin, sys.stdout, sys.stderr)\n\n```\n```python\n# src/remove_vowels_app/__main__.py\nimport sys\nfrom remove_vowels_app.app import main_cli\n\nif __name__ == \"__main__\":\n    sys.exit(mai