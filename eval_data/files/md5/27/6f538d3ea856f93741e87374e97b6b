{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\n    The function ignores the sign of the input number for counting.\n    \"\"\"\n    s_num = str(abs(num))\n    even_count = 0\n    odd_count = 0\n    for digit_char in s_num:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a, b):\n    \"\"\"Determines if the second string or any of its rotations is a substring in the first string.\n    This includes specific business rules for empty strings and length mismatches.\"\"\"\n\n    # Business rule: Empty target string b is treated as False.\n    if not b:\n        return False\n\n    # Business rule: If b is longer than a, no rotation can be a substring.\n    if len(b) > len(a):\n        return False\n\n    # The concatenation trick from NFR2: All rotations of 'b' are substrings of 'b + b'.\n    # We check if any substring of 'a' (of length len(b)) is present within 'b + b'.\n    # If such a substring from 'a' exists in 'b + b', it means that substring is a rotation of 'b'.\n    b_doubled = b + b\n    \n    # Iterate through all possible substrings of 'a' that have the same length as 'b'.\n    for i in range(len(a) - len(b) + 1):\n        substring_of_a = a[i : i + len(b)]\n        \n        # Check if this substring of 'a' (which has length len(b)) is a rotation of 'b'.\n        # A string X is a rotation of Y if len(X) == len(Y) and X is a substring of Y+Y.\n        if substring_of_a in b_doubled:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/155", "solution": "```python\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Handle the special case for 0, which has one even digit.\n    if num == 0:\n        return (1, 0)\n\n    # Take the absolute value to ignore the sign of the number.\n    n = abs(num)\n\n    # Iterate through each digit of the number.\n    while n > 0:\n        digit = n % 10  # Get the last digit.\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n        n //= 10  # Remove the last digit.\n\n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    _MAP = [\n        (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"),\n        (100, \"C\"), (90, \"XC\"), (50, \"L\"), (40, \"XL\"),\n        (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"), (1, \"I\"),\n    ]\n    res = []\n    n = number\n    for value, symbol in _MAP:\n        while n >= value:\n            res.append(symbol)\n            n -= value\n    return \"\".join(res).lower()"}
{"task_id": "HumanEval/156", "solution": "```python\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    \"\"\"\n    ROMAN_MAPPINGS = [\n        (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"), (100, \"C\"),\n        (90, \"XC\"), (50, \"L\"), (40, \"XL\"), (10, \"X\"), (9, \"IX\"), (5, \"V\"),\n        (4, \"IV\"), (1, \"I\")\n    ]\n\n    result_parts = []\n    remaining_number = number\n    for value, symbol in ROMAN_MAPPINGS:\n        while remaining_number >= value:\n            result_parts.append(symbol)\n            remaining_number -= value\n        if remaining_number == 0:\n            break\n    return ''.join(result_parts).lower()\n```"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    '''\n    # Inline helper function for floating-point comparison, using the specified tolerance.\n    def _is_close(val1: float, val2: float, tol: float = 1e-9) -> bool:\n        return abs(val1 - val2) <= tol * max(1.0, abs(val1), abs(val2))\n\n    # Sort sides to easily identify the potential hypotenuse (the largest side).\n    sides = sorted([a, b, c])\n    x, y, z = sides[0], sides[1], sides[2]\n\n    # Apply the Pythagorean theorem (x^2 + y^2 == z^2) with floating-point tolerance.\n    return _is_close(x*x + y*y, z*z)"}
{"task_id": "HumanEval/157", "solution": "```python\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    '''\n    sides = sorted([a, b, c])\n    x, y, z = sides[0], sides[1], sides[2]\n    epsilon = 1e-9  # Using the default epsilon from the design specification.\n    return abs(x*x + y*y - z*z) <= epsilon\n```"}
{"task_id": "HumanEval/158", "solution": "```python\ndef find_max(words):\n    \"\"\"\n    Finds the word with the maximum number of unique characters.\n    Ties are broken by lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    def _count_unique_chars(word_str):\n        \"\"\"Calculates the number of unique characters in a given word.\"\"\"\n        return len(set(word_str))\n\n    max_unique_count = -1\n    best_word = \"\"\n\n    for word in words:\n        current_unique_count = _count_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            best_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: choose the lexicographically smallest word\n            if word < best_word:\n                best_word = word\n    \n    return best_word\n```"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Returns the word with the maximum number of unique characters from a list of strings.\n    If multiple words have the same maximum unique character count, the lexicographically smallest is returned.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # If counts are equal, choose the lexicographically smallest word.\n            if word < result_word:\n                result_word = word\n    \n    return result_word"}
