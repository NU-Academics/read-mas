{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\nclass ParenGroup:\n    \"\"\"Lightweight DTO for a top-level parenthesis group.\"\"\"\n    def __init__(self, content: str) -> None:\n        self.content = content\n\n    def to_str(self) -> str:\n        \"\"\"Returns the raw string content of the group.\"\"\"\n        return self.content\n\n\nclass Tokenizer:\n    \"\"\"Removes whitespace from the input string.\"\"\"\n    def compact_and_validate(self, input_str: str) -> str:\n        \"\"\"Strips all whitespace characters from the input string.\"\"\"\n        compacted = \"\".join(c for c in input_str if not c.isspace())\n        return compacted\n\n\nclass ParenthesisParser:\n    \"\"\"Scans a token string to extract top-level balanced groups.\"\"\"\n    def parse_groups(self, tokens: str) -> List[ParenGroup]:\n        \"\"\"Identifies and extracts top-level balanced parenthesis groups.\"\"\"\n        groups = []\n        depth = 0\n        start = -1\n        for i, ch in enumerate(tokens):\n            if ch == \"(\":\n                if depth == 0:\n                    start = i\n                depth += 1\n            else:  # ch == \")\"\n                depth -= 1\n                if depth == 0:\n                    groups.append(ParenGroup(tokens[start:i+1]))\n        return groups\n\n\nclass GroupSeparatorService:\n    \"\"\"Orchestrates tokenization and parsing to separate parenthesis groups.\"\"\"\n    def __init__(self) -> None:\n        \"\"\"Initializes the service with default tokenizer and parser.\"\"\"\n        self.tokenizer = Tokenizer()\n        self.parser = ParenthesisParser()\n\n    def separate_paren_groups(self, input_str: str) -> List[str]:\n        \"\"\"Processes the input string to find and return top-level groups.\"\"\"\n        tokens = self.tokenizer.compact_and_validate(input_str)\n        groups = self.parser.parse_groups(tokens)\n        return [g.to_str() for g in groups]\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    svc = GroupSeparatorService()\n    return svc.separate_paren_groups(paren_string)"}
{"task_id": "HumanEval/0", "solution": "```python\nfrom typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    \"\"\"\n    if len(numbers) < 2:  # No pairs can be formed if there are less than two numbers.\n        return False\n\n    # Sort the numbers to efficiently check adjacent pairs for closeness.\n    sorted_numbers = sorted(numbers)\n\n    for i in range(1, len(sorted_numbers)):\n        # Check if the absolute difference between adjacent elements is less than the threshold.\n        if sorted_numbers[i] - sorted_numbers[i-1] < threshold:\n            return True\n\n    return False\n```"}
{"task_id": "HumanEval/0", "solution": "from typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"Check if any two numbers in the list are closer to each other than the given threshold.\n    It sorts the numbers and checks adjacent elements for efficiency.\"\"\"\n    if len(numbers) < 2:\n        return False\n\n    sorted_numbers = sorted(numbers)\n    for i in range(len(sorted_numbers) - 1):\n        if (sorted_numbers[i+1] - sorted_numbers[i]) < threshold:\n            return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Input is a string with nested parentheses. Separate top-level balanced groups, ignoring spaces.\n    Returns a list of normalized, balanced parenthesis group strings.\n    \"\"\"\n    # Filter out non-parenthesis characters and whitespace from the input string.\n    # This implicitly handles character validation and whitespace normalization without raising exceptions.\n    normalized_input = \"\".join(ch for ch in paren_string if ch == '(' or ch == ')')\n\n    depth = 0\n    current_group_chars: List[str] = []\n    result_groups: List[str] = []\n\n    for char in normalized_input:\n        if char == '(':\n            current_group_chars.append(char)\n            depth += 1\n        elif char == ')':\n            # Only process ')' if there's an open parenthesis to match.\n            # This silently discards unmatched closing parentheses by not adding them.\n            if depth > 0:\n                current_group_chars.append(char)\n                depth -= 1\n                if depth == 0:\n                    # A balanced top-level group is found; add it to results and reset.\n                    result_groups.append(\"\".join(current_group_chars))\n                    current_group_chars = []\n\n    # Unclosed parentheses at the end are implicitly discarded as `depth` will be non-zero\n    # and `current_group_chars` won't be appended to `result_groups`.\n    return result_groups"}
{"task_id": "HumanEval/2", "solution": "```python\ndef truncate_number(number: float) -> float:\n    \"\"\"Return the decimal part of a positive floating-point number.\n    It computes number - floor(number) and normalizes small floating-point artifacts to 0.0.\n    \"\"\"\n    import math\n\n    whole = math.floor(number)\n    frac = number - whole\n\n    # Use a small epsilon to handle floating-point inaccuracies near integers.\n    if abs(frac) < 1e-12:\n        return 0.0\n    \n    return frac\n```"}
{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\"Given a positive floating point number, return its decimal part.\n    Handles tiny floating point inaccuracies by rounding near-zero results to 0.0.\n    \"\"\"\n    fractional_part = number - math.floor(number)\n\n    # Round very small positive fractional parts to 0.0 to account for floating precision.\n    tolerance = 1e-12\n    if 0 < fractional_part < tolerance:\n        return 0.0\n    return fractional_part"}
