{"task_id": "HumanEval/139", "solution": "```python\n# src/special_factorial/exceptions.py\nclass InvalidInputError(Exception):\n    \"\"\"Raised when input to a function is invalid.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass ComputationTimeoutError(Exception):\n    \"\"\"Raised when a computation exceeds its allowed time.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass PersistenceError(Exception):\n    \"\"\"Raised when an error occurs during data persistence.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\n# src/special_factorial/models.py\nfrom typing import Dict, Any\n\nclass SpecialFactorialResult:\n    \"\"\"DTO for the special factorial computation result.\"\"\"\n    def __init__(self, n: int, result: str, duration_ms: int, cached: bool):\n        self.n = n\n        self.result = result\n        self.duration_ms = duration_ms\n        self.cached = cached\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Convert the result to a dictionary for serialization.\"\"\"\n        return {\n            \"n\": self.n,\n            \"result\": self.result,\n            \"duration_ms\": self.duration_ms,\n            \"cached\": self.cached,\n        }\n\n# src/special_factorial/utils.py\nimport time\nimport logging\nfrom typing import Any, Callable, Tuple, TypeVar\n\n# Assuming exceptions.py is in the same package and accessible via relative import or path.\n# For single file output, we'll assume it's defined above.\n# from .exceptions import InvalidInputError\n\nlogger = logging.getLogger(__name__)\nT = TypeVar(\"T\")\n\ndef validate_positive_int(value: Any) -> int:\n    \"\"\"Validates if a value is a positive integer.\"\"\"\n    try:\n        n = int(value)\n        if n < 1:\n            raise InvalidInputError(\"Input 'n' must be a positive integer (n >= 1).\")\n        return n\n    except (ValueError, TypeError) as e:\n        raise InvalidInputError(f\"Input 'n' must be an integer. Got {type(value).__name__}.\") from e\n\ndef time_ms(func: Callable[..., T], *args, **kwargs) -> Tuple[T, int]:\n    \"\"\"Times the execution of a function in milliseconds.\"\"\"\n    start_time = time.perf_counter()\n    result = func(*args, **kwargs)\n    end_time = time.perf_counter()\n    duration_ms = int((end_time - start_time) * 1000)\n    return result, duration_ms\n\n# src/special_factorial/config.py\nimport os\nfrom typing import Optional\n\nDEFAULT_CACHE_SIZE: int = 1024\nDEFAULT_TIMEOUT_S: float = 30.0 # 30 seconds\n\nclass Config:\n    \"\"\"Configuration class for the application.\"\"\"\n    def __init__(\n        self,\n        cache_size: int = DEFAULT_CACHE_SIZE,\n        sqlite_dsn: Optional[str] = None,\n        timeout_s: float = DEFAULT_TIMEOUT_S,\n    ):\n        self.cache_size = cache_size\n        self.sqlite_dsn = sqlite_dsn\n        self.timeout_s = timeout_s\n\n    @classmethod\n    def from_env(cls) -> \"Config\":\n        \"\"\"Load configuration from environment variables.\"\"\"\n        cache_size = int(os.getenv(\"SPECIAL_FACTORIAL_CACHE_SIZE\", str(DEFAULT_CACHE_SIZE)))\n        sqlite_dsn = os.getenv(\"SPECIAL_FACTORIAL_SQLITE_DSN\")\n        timeout_s = float(os.getenv(\"SPECIAL_FACTORIAL_TIMEOUT_S\", str(DEFAULT_TIMEOUT_S)))\n        return cls(cache_size=cache_size, sqlite_dsn=sqlite_dsn, timeout_s=timeout_s)\n\n# src/special_factorial/calculator.py\nfrom typing import Callable, Optional\n\n# Assuming exceptions.py is in the same package and accessible via relative import or path.\n# from .exceptions import InvalidInputError\n\nclass FactorialCalculator:\n    \"\"\"Calculates standard and special factorials.\"\"\"\n    def factorial(self, n: int) -> int:\n        \"\"\"Computes n! iteratively.\"\"\"\n        if n < 1:\n            raise InvalidInputError(\"n must be >= 1 for factorial calculation.\")\n        result = 1\n        for i in range(2, n + 1):\n            result *= i\n        return result\n\n    def special_factorial(self, n: int, progress_callback: Optional[Callable[[int, int], None]] = None) -> int:\n        \"\"\"Computes the Brazilian factorial: n! * (n-1)! * ... * 1!.\"\"\"\n        if n < 1:\n            raise InvalidInputError(\"n must be >= 1 for special factorial calculation.\")\n        total = 1\n        current_factorial = 1\n        for k in range(1, n + 1):\n            current_factorial *= k\n            total *= current_factorial\n            if progress_callback:\n                progress_callback(k, n)\n        return total\n\n# src/special_factorial/repository.py\nimport sqlite3\nimport threading\nimport logging\nfrom collections import OrderedDict\nfrom typing import Optional\n\n# Assuming config.py and exceptions.py are in the same package.\n# from .config import Config\n# from .exceptions import PersistenceError\n\nlogger = logging.getLogger(__name__)\n\nclass SQLiteAdapter:\n    \"\"\"Adapter for SQLite database persistence.\"\"\"\n    def __init__(self, dsn: str):\n        self._dsn = dsn\n        self._conn: Optional[sqlite3.Connection] = None\n        self.ensure_schema()\n\n    def _get_connection(self) -> sqlite3.Connection:\n        \"\"\"Establishes and returns a SQLite connection.\"\"\"\n        if self._conn is None:\n            self._conn = sqlite3.connect(self._dsn, check_same_thread=False)\n        return self._conn\n\n    def ensure_schema(self) -> None:\n        \"\"\"Creates the cached_results table if it does not exist.\"\"\"\n        conn = self._get_connection()\n        try:\n            conn.execute(\n                \"\"\"\n                CREATE TABLE IF NOT EXISTS cached_results (\n                  n INTEGER PRIMARY KEY NOT NULL,\n                  result TEXT NOT NULL,\n                  computed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL\n                );\n                CREATE INDEX IF NOT EXISTS idx_cached_results_computed_at ON cached_results(computed_at);\n                \"\"\"\n            )\n            conn.commit()\n        except sqlite3.Error as e:\n            logger.error(f\"Error ensuring SQLite schema at {self._dsn}: {e}\")\n            raise PersistenceError(f\"Failed to ensure SQLite schema: {e}\") from e\n\n    def get(self, n: int) -> Optional[str]:\n        \"\"\"Retrieves a cached result from SQLite.\"\"\"\n        conn = self._get_connection()\n        try:\n            cursor = conn.execute(\"SELECT result FROM cached_results WHERE n = ?\", (n,))\n            row = cursor.fetchone()\n            return row[0] if row else None\n        except sqlite3.Error as e:\n            logger.warning(f\"Error retrieving from SQLite for n={n} at {self._dsn}: {e}\")\n            return None # Fail gracefully for cache reads\n\n    def set(self, n: int, value: str) -> None:\n        \"\"\"Stores a result in SQLite.\"\"\"\n        conn = self._get_connection()\n        try:\n            conn.execute(\n                \"INSERT OR REPLACE INTO cached_results (n, result, computed_at) VALUES (?, ?, CURRENT_TIMESTAMP)\",\n                (n, value),\n            )\n            conn.commit()\n        except sqlite3.Error as e:\n            logger.error(f\"Error persisting to SQLite for n={n} at {self._dsn}: {e}\")\n            raise PersistenceError(f\"Failed to persist result to SQLite: {e}\") from e # Raise for writes\n\n    def flush(self) -> None:\n        \"\"\"Clears all cached results from SQLite.\"\"\"\n        conn = self._get_connection()\n        try:\n            conn.execute(\"DELETE FROM cached_results\")\n            conn.commit()\n        except sqlite3.Error as e:\n            logger.error(f\"Error flushing SQLite cache at {self._dsn}: {e}\")\n            raise PersistenceError(f\"Failed to flush SQLite cache: {e}\") from e\n\nclass CacheRepository:\n    \"\"\"Manages in-memory LRU cache and optional SQLite persistence.\"\"\"\n    def __init__(self, config: Config):\n        self._cache: OrderedDict[int, str] = OrderedDict()\n        self._lock = threading.Lock()\n        self._config = config\n        self._sqlite: Optional[SQLiteAdapter] = None\n        if config.sqlite_dsn:\n            try:\n                self._sqlite = SQLiteAdapter(config.sqlite_dsn)\n            except PersistenceError:\n                logger.error(\"Failed to initialize SQLite adapter. Continuing without persistence.\")\n\n    def _evict_if_needed(self) -> None:\n        \"\"\"Evicts the least recently used item if cache size exceeds limit.\"\"\"\n        while len(self._cache) > self._config.cache_size:\n            self._cache.popitem(last=False)\n\n    def get(self, n: int) -> Optional[str]:\n        \"\"\"Retrieves a result from cache. Checks in-memory first, then SQLite if available.\"\"\"\n        with self._lock:\n            if n in self._cache:\n                val = self._cache.pop(n)  # Move to end for LRU\n                self._cache[n] = val\n                return val\n\n        if self._sqlite:\n            val = self._sqlite.get(n)\n            if val:\n                with self._lock:\n                    self._cache[n] = val\n                    self._evict_if_needed()\n                return val\n        return None\n\n    def set(self, n: int, value: str) -> None:\n        \"\"\"Stores a result in in-memory cache and optionally persists to SQLite.\"\"\"\n        with self._lock:\n            self._cache[n] = value  # Add or update\n            self._cache.move_to_end(n)\n            self._evict_if_needed()\n\n        if self._sqlite:\n            try:\n                self._sqlite.set(n, value)\n            except PersistenceError as e:\n                logger.warning(f\"Failed to persist result for n={n}: {e}\") # Log, but don't prevent in-memory cache\n\n    def flush(self) -> None:\n        \"\"\"Clears all cached results from both in-memory and SQLite.\"\"\"\n        with self._lock:\n            self._cache.clear()\n        if self._sqlite:\n            try:\n                self._sqlite.flush()\n            except PersistenceError as e:\n                logger.error(f\"Failed to flush SQLite cache: {e}\")\n\n# src/special_factorial/services.py\nimport logging\nfrom concurrent.futures import ThreadPoolExecutor, TimeoutError as FuturesTimeoutError\n\n# Assuming other components are defined above and accessible.\n# from .config import Config\n# from .exceptions import InvalidInputError, ComputationTimeoutError\n# from .models import SpecialFactorialResult\n# from .calculator import FactorialCalculator\n# from .repository import CacheRepository\n# from .utils import validate_positive_int, time_ms\n\nlogger = logging.getLogger(__name__)\n\nclass SpecialFactorialService:\n    \"\"\"Orchestrates computation, caching, and persistence of special factorials.\"\"\"\n    def __init__(self, calculator: FactorialCalculator, repository: CacheRepository, config: Config):\n        self._calculator = calculator\n        self._repository = repository\n        self._config = config\n        self._executor = ThreadPoolExecutor(max_workers=1) # For single computation timeout\n\n    def compute(self, n: int) -> SpecialFactorialResult:\n        \"\"\"Computes the special factorial, utilizing caching.\"\"\"\n        validate_positive_int(n)\n\n        start_time = time.perf_counter()\n        cached_result = self._repository.get(n)\n        end_time_cache_check = time.perf_counter()\n        cache_check_duration_ms = int((end_time_cache_check - start_time) * 1000)\n\n        if cached_result:\n            logger.info(f\"N={n}: Cache hit. Duration: {cache_check_duration_ms}ms\")\n            return SpecialFactorialResult(n=n, result=cached_result, duration_ms=cache_check_duration_ms, cached=True)\n\n        logger.info(f\"N={n}: Cache miss. Calculating...\")\n        # Compute the result\n        result_int, duration_ms = time_ms(self._calculator.special_factorial, n)\n        result_str = str(result_int)\n\n        # Store in cache (best effort)\n        self._repository.set(n, result_str)\n\n        logger.info(f\"N={n}: Computed result in {duration_ms}ms. Cached: False.\")\n        return SpecialFactorialResult(n=n, result=result_str, duration_ms=duration_ms, cached=False)\n\n    def compute_with_timeout(self, n: int, timeout_s: float) -> SpecialFactorialResult:\n        \"\"\"Computes special factorial with an enforced timeout.\"\"\"\n        future = self._executor.submit(self.compute, n)\n        try:\n            result = future.result(timeout=timeout_s)\n            return result\n        except FuturesTimeoutError:\n            future.cancel() # Attempt to cancel the running task\n            logger.warning(f\"Computation for n={n} timed out after {timeout_s} seconds.\")\n            raise ComputationTimeoutError(f\"Computation for n={n} exceeded timeout of {timeout_s} seconds.\")\n        except InvalidInputError:\n            # Re-raise validation errors directly\n            raise\n        except Exception as e:\n            logger.error(f\"Unexpected error during computation for n={n}: {e}\")\n            # Wrap other exceptions into a generic computation error or let them propagate if desired.\n            raise ComputationTimeoutError(f\"Computation for n={n} failed due to an unexpected error.\") from e\n\n# src/special_factorial/controllers/cli_controller.py\nimport argparse\nimport sys\nimport json\nimport logging\nfrom typing import List\n\n# Assuming other components are defined above and accessible.\n# from special_factorial.services import SpecialFactorialService\n# from special_factorial.exceptions import InvalidInputError, ComputationTimeoutError, PersistenceError\n# from special_factorial.config import Config\n\nlogger = logging.getLogger(__name__)\n\nclass CLIController:\n    \"\"\"Handles command-line interface interactions.\"\"\"\n    def __init__(self, service: SpecialFactorialService):\n        self._service = service\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Parses arguments and runs the CLI command.\"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Compute the Brazilian special factorial of N.\",\n            formatter_class=argparse.ArgumentDefaultsHelpFormatter\n        )\n        parser.add_argument(\n            \"n\", type=int, help=\"The integer N for which to compute the special factorial (N >= 1).\"\n        )\n        parser.add_argument(\n            \"--timeout\",\n            type=float,\n            default=None,\n            help=f\"Timeout for computation in seconds. Defaults to config ({self._service._config.timeout_s}s).\",\n        )\n        parser.add_argument(\n            \"--json\", action=\"store_true\", help=\"Output result in JSON format.\"\n        )\n\n        args = parser.parse_args(argv[1:])\n\n        try:\n            n = args.n # validate_positive_int will be called by service.compute\n            timeout = args.timeout if args.timeout is not None else self._service._config.timeout_s\n\n            result_dto = self._service.compute_with_timeout(n, timeout)\n\n            if args.json:\n                print(json.dumps(result_dto.to_dict()))\n            else:\n                print(f\"Special Factorial of {result_dto.n}: {result_dto.result}\")\n                print(f\"Duration: {result_dto.duration_ms}ms (Cached: {result_dto.cached})\")\n            return 0\n        except InvalidInputError as e:\n            logger.error(f\"Invalid input: {e}\")\n            print(f\"Error: {e}\", file=sys.stderr)\n            parser.print_help(sys.stderr)\n            return 2 # Exit code for invalid input\n        except ComputationTimeoutError as e:\n            logger.error(f\"Computation timeout: {e}\")\n            print(f\"Error: {e}\", file=sys.stderr)\n            return 3 # Exit code for timeout\n        except PersistenceError as e:\n            logger.error(f\"Persistence error: {e}\")\n            print(f\"Error: A database persistence error occurred: {e}\", file=sys.stderr)\n            return 4 # Exit code for persistence error\n        except Exception as e:\n            logger.exception(\"An unexpected error occurred:\")\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1 # Generic error code\n\n# src/special_factorial/controllers/api_controller.py\nimport logging\nfrom typing import Optional, Dict, Any\n\ntry:\n    from fastapi import FastAPI, HTTPException, status\n    from pydantic import BaseModel\nexcept ImportError:\n    # Provide dummy classes if FastAPI is not installed, so the file can still be parsed.\n    # A real application would require FastAPI to be installed as an optional dependency.\n    class FastAPI:\n        def __init__(self, *args, **kwargs): pass\n        def get(self, path: str): return lambda func: func\n    class HTTPException(Exception):\n        def __init__(self, status_code: int, detail: str):\n            self.status_code = status_code\n            self.detail = detail\n            super().__init__(detail)\n    class BaseModel: pass\n    class status:\n        HTTP_400_BAD_REQUEST = 400\n        HTTP_503_SERVICE_UNAVAILABLE = 503\n        HTTP_500_INTERNAL_SERVER_ERROR = 500\n\n# Assuming other components are defined above and accessible.\n# from special_factorial.services import SpecialFactorialService\n# from special_factorial.models import SpecialFactorialResult\n# from special_factorial.exceptions import InvalidInputError, ComputationTimeoutError, PersistenceError\n\nlogger = logging.getLogger(__name__)\n\nclass APIController:\n    \"\"\"FastAPI application factory for the special factorial service.\"\"\"\n    def __init__(self, service: SpecialFactorialService):\n        self._service = service\n\n    def create_app(self) -> FastAPI:\n        \"\"\"Creates and configures the FastAPI application.\"\"\"\n        app = FastAPI(\n            title=\"Special Factorial API\",\n            description=\"API for computing the Brazilian special factorial.\",\n            version=\"1.0.0\",\n        )\n\n        @app.get(\n            \"/special_factorial/{n}\",\n            response_model=dict, # SpecialFactorialResult.to_dict() schema\n            summary=\"Compute or retrieve the special factorial of N\",\n            tags=[\"Special Factorial\"],\n        )\n        async def get_special_factorial(\n            n: int,\n            timeout_s: Optional[float] = None\n        ) -> Dict[str, Any]:\n            \"\"\"\n            Compute the special factorial of a positive integer `n`.\n            Results are cached and optionally persisted.\n            \"\"\"\n            try:\n                # Use the service's configured timeout if not overridden by query parameter\n                actual_timeout = timeout_s if timeout_s is not None else self._service._config.timeout_s\n                result_dto = self._service.compute_with_timeout(n, actual_timeout)\n                return result_dto.to_dict()\n            except InvalidInputError as e:\n                logger.warning(f\"API Bad Request for n={n}: {e}\")\n                raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))\n            except ComputationTimeoutError as e:\n                logger.error(f\"API Service Unavailable for n={n}: {e}\")\n                raise HTTPException(status_code=status.HTTP_503_SERVICE_UNAVAILABLE, detail=str(e))\n            except PersistenceError as e:\n                logger.error(f\"API Internal Server Error (persistence) for n={n}: {e}\")\n                raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"A database error occurred during persistence.\")\n            except Exception as e:\n                logger.exception(f\"API Unexpected error for n={n}:\")\n                raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"An unexpected server error occurred.\")\n\n        @app.get(\"/health\", summary=\"Health check\", tags=[\"Monitoring\"])\n        async def health_check():\n            \"\"\"Simple health check endpoint.\"\"\"\n            return {\"status\": \"ok\", \"service\": \"special_factorial\"}\n\n        return app\n\n# src/special_factorial/main.py\nimport sys\nimport logging\nfrom typing import Optional, List\n\n# Configure basic logging for the entire application\nlogging.basicConfig(level=logging.INFO, format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\nlogger = logging.getLogger(\"special_factorial_app\")\n\n# Assuming all other components are defined above and accessible.\n# from special_factorial.config import Config\n# from special_factorial.calculator import FactorialCalculator\n# from special_factorial.repository import CacheRepository\n# from special_factorial.services import SpecialFactorialService\n# from special_factorial.controllers.cli_controller import CLIController\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"Main entry point for the CLI application.\"\"\"\n    if argv is None:\n        argv = sys.argv\n\n    config = Config.from_env()\n    logger.info(f\"Loaded configuration: cache_size={config.cache_size}, sqlite_dsn={config.sqlite_dsn or 'None'}, timeout_s={config.timeout_s}s\")\n\n    calculator = FactorialCalculator()\n    repository = CacheRepository(config)\n    service = SpecialFactorialService(calculator, repository, config)\n    cli_controller = CLIController(service)\n\n    return cli_controller.run(argv)\n\n# migrations/0001_create_cached_results.sql\n# This content would typically be in a separate file.\n\"\"\"\nCREATE TABLE IF NOT EXISTS cached_results (\n  n INTEGER PRIMARY KEY NOT NULL,\n  result TEXT NOT NULL,\n  computed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_cached_results_computed_at ON cached_results(computed_at);\n\"\"\"\n```"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    result = 1\n    current_factorial = 1\n    for k in range(1, n + 1):\n        current_factorial *= k\n        result *= current_factorial\n    return result"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Replaces single/double spaces with underscores and runs of 3+ spaces with a hyphen.\n    This process happens in a single pass over the input string.\n    \"\"\"\n    out_chars = []\n    current_space_run = 0\n    for char in text:\n        if char == ' ':\n            current_space_run += 1\n        else:\n            if current_space_run > 0:\n                if current_space_run >= 3:\n                    out_chars.append('-')\n                else:\n                    out_chars.append('_' * current_space_run)\n                current_space_run = 0\n            out_chars.append(char)\n    # Handle any trailing spaces at the end of the string\n    if current_space_run > 0:\n        if current_space_run >= 3:\n            out_chars.append('-')\n        else:\n            out_chars.append('_' * current_space_run)\n    return \"\".join(out_chars)"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    out = []\n    i = 0\n    n = len(text)\n    MIN_CONSECUTIVE_FOR_DASH = 3\n\n    while i < n:\n        ch = text[i]\n        if ch == ' ':\n            j = i\n            while j < n and text[j] == ' ':\n                j += 1\n            run = j - i\n            if run >= MIN_CONSECUTIVE_FOR_DASH:\n                out.append('-')\n            else:\n                out.append('_' * run)\n            i = j\n        else:\n            out.append(ch)\n            i += 1\n    return ''.join(out)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file's name is valid based on specific rules.\n    Returns 'Yes' for valid names, 'No' otherwise.\n    \"\"\"\n    def _is_ascii_letter(char):\n        \"\"\"Checks if a character is an ASCII letter.\"\"\"\n        return 'a' <= char <= 'z' or 'A' <= char <= 'Z'\n\n    def _is_digit(char):\n        \"\"\"Checks if a character is a digit.\"\"\"\n        return '0' <= char <= '9'\n\n    # Rule: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    name_part, ext_part = file_name.split('.')\n\n    # Rule: The substring before the dot should not be empty.\n    if not name_part:\n        return 'No'\n\n    # Rule: The substring before the dot starts with a letter from the latin alphabet.\n    if not _is_ascii_letter(name_part[0]):\n        return 'No'\n\n    # Rule: The substring after the dot should be one of these: ['txt', 'exe', 'dll'] (case-insensitive)\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if ext_part.lower() not in allowed_extensions:\n        return 'No'\n\n    # Rule: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = 0\n    for char in file_name:\n        if _is_digit(char):\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific rules.\n    Returns 'Yes' for valid names, 'No' otherwise.\"\"\"\n\n    s = file_name.strip()\n\n    # Rule: The file's name contains exactly one dot '.'\n    if s.count('.') != 1:\n        return 'No'\n\n    name_part, extension_part = s.split('.', 1)\n\n    # Rule: The substring before the dot should not be empty\n    if not name_part:\n        return 'No'\n\n    # Rule: The substring before the dot starts with a letter from the latin alphabet\n    first_char_of_name = name_part[0]\n    if not ('a' <= first_char_of_name <= 'z' or 'A' <= first_char_of_name <= 'Z'):\n        return 'No'\n\n    # Rule: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if extension_part not in allowed_extensions:\n        return 'No'\n\n    # Rule: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = 0\n    for char in s:\n        if '0' <= char <= '9':\n            digit_count += 1\n\n    if digit_count > 3:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Transforms list entries based on their index and returns the sum of transformed values.\n    Indexes divisible by 3 are squared; indexes divisible by 4 (but not 3) are cubed.\n    \"\"\"\n    transformed_values = []\n    for i, value in enumerate(lst):\n        if i % 3 == 0:\n            transformed_values.append(value ** 2)\n        elif i % 4 == 0:\n            transformed_values.append(value ** 3)\n        else:\n            transformed_values.append(value)\n    return sum(transformed_values)"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Transforms list elements based on index rules and returns their sum.\n    Indexes divisible by 3 are squared; by 4 (but not 3) are cubed; others remain unchanged.\n    \"\"\"\n    total_sum = 0\n    for i, v in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += v * v\n        elif i % 4 == 0:  # Implicitly, i % 3 != 0 due to 'elif' order\n            total_sum += v * v * v\n        else:\n            total_sum += v\n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "```python\ndef words_in_sentence(sentence):\n    \"\"\"\n    Filters words in a sentence, returning those with prime lengths.\n    Preserves original word order and joins results with spaces.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"\n        Checks if a number is prime. Optimized for numbers up to 100.\n        Returns True for prime numbers, False otherwise.\n        \"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    words = sentence.split()\n    prime_length_words = []\n\n    for word in words:\n        if word and is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return \" \".join(prime_length_words)\n```"}
{"task_id": "HumanEval/143", "solution": "import math\n\ndef words_in_sentence(sentence):\n    \"\"\"\n    Extracts words from a sentence whose lengths are prime numbers.\n    The order of words is preserved.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"\n        Checks if an integer n is a prime number.\n        Optimized for small n.\n        \"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        r = int(math.isqrt(n))\n        for i in range(3, r + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    # Tokenize the sentence, handling multiple spaces and stripping leading/trailing.\n    words = [word for word in sentence.strip().split(' ') if word]\n\n    # Filter words whose lengths are prime numbers.\n    prime_length_words = [word for word in words if is_prime(len(word))]\n\n    # Join the filtered words with a single space.\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"\n    Evaluates if the product of two rational numbers (x * n) is a whole number.\n    Inputs x and n are strings in \"numerator/denominator\" format with positive integers.\n    \"\"\"\n    x_parts = x.split('/')\n    num_x = int(x_parts[0])\n    den_x = int(x_parts[1])\n\n    n_parts = n.split('/')\n    num_n = int(n_parts[0])\n    den_n = int(n_parts[1])\n\n    product_numerator = num_x * num_n\n    product_denominator = den_x * den_n\n\n    return (product_numerator % product_denominator) == 0"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"\n    Determines if the product of two fractions, x and n, is a whole number.\n    Assumes valid fraction string inputs (numerator/denominator where both are positive integers).\n    \"\"\"\n\n    def _gcd(a, b):\n        \"\"\"Calculates the greatest common divisor of two positive integers.\"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\n    # Parse x\n    x_parts = x.split('/')\n    x_numerator = int(x_parts[0])\n    x_denominator = int(x_parts[1])\n\n    # Parse n\n    n_parts = n.split('/')\n    n_numerator = int(n_parts[0])\n    n_denominator = int(n_parts[1])\n\n    # Multiply the numerators and denominators\n    product_numerator = x_numerator * n_numerator\n    product_denominator = x_denominator * n_denominator\n\n    # Simplify the resulting fraction to its lowest terms\n    common_divisor = _gcd(product_numerator, product_denominator)\n    \n    reduced_denominator = product_denominator // common_divisor\n\n    # A fraction is a whole number if its simplified denominator is 1.\n    return reduced_denominator == 1"}
{"task_id": "HumanEval/145", "solution": "```python\ndef order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their absolute digits,\n    preserving original order for numbers with the same digit sum.\n    \"\"\"\n    items_with_points = []\n    for index, value in enumerate(nums):\n        n_abs = abs(value)\n        digit_sum = 0\n        temp_n = n_abs\n        while temp_n > 0:\n            digit_sum += temp_n % 10\n            temp_n //= 10\n        # Handle the case for 0 explicitly, as the loop won't run.\n        if n_abs == 0:\n            digit_sum = 0\n        items_with_points.append((digit_sum, index, value))\n\n    sorted_items = sorted(items_with_points, key=lambda item: (item[0], item[1]))\n    result = [item[2] for item in sorted_items]\n\n    return result\n```"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"Sorts a list of integers by the sum of their digits, preserving original order for ties.\"\"\"\n\n    def _get_digit_sum(n):\n        \"\"\"Calculates the sum of the absolute value's decimal digits.\"\"\"\n        n = abs(n)\n        s = 0\n        while n > 0:\n            s += n % 10\n            n //= 10\n        return s\n\n    if not nums:\n        return []\n\n    items_with_metadata = []\n    for i, num in enumerate(nums):\n        digit_sum_val = _get_digit_sum(num)\n        # Store (digit_sum, original_index, original_value) for stable sorting.\n        items_with_metadata.append((digit_sum_val, i, num))\n\n    # Sort primarily by digit_sum, secondarily by original_index to preserve stability.\n    sorted_items = sorted(items_with_metadata)\n\n    return [item[2] for item in sorted_items]"}
{"task_id": "HumanEval/146", "solution": "```python\ndef specialFilter(nums):\n    \"\"\"\n    Counts numbers in an array that are greater than 10 and have odd first and last digits.\n    Digits are extracted from the absolute integer part of the number.\n    \"\"\"\n\n    def _is_odd_digit(digit):\n        \"\"\"Checks if a single digit is odd.\"\"\"\n        return digit in {1, 3, 5, 7, 9}\n\n    def _get_first_digit(n):\n        \"\"\"Extracts the first digit of an integer (absolute value).\"\"\"\n        n = abs(int(n))\n        if n == 0:\n            return 0\n        while n >= 10:\n            n //= 10\n        return n\n\n    def _get_last_digit(n):\n        \"\"\"Extracts the last digit of an integer (absolute value).\"\"\"\n        return abs(int(n)) % 10\n\n    count = 0\n    for num in nums:\n        # Business rule: Only numbers strictly greater than 10 are eligible.\n        # This check uses the original numeric value.\n        if num > 10:\n            # Digits are extracted from the absolute integer part of the number.\n            abs_int_part = abs(int(num))\n\n            first_digit = _get_first_digit(abs_int_part)\n            last_digit = _get_last_digit(abs_int_part)\n\n            # Check if both first and last digits are odd.\n            if _is_odd_digit(first_digit) and _is_odd_digit(last_digit):\n                count += 1\n    return count\n```"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Counts numbers greater than 10 whose first and last digits are both odd.\n    Digit extraction ignores the sign of the number.\n    \"\"\"\n    count = 0\n    odd_digits = {1, 3, 5, 7, 9}\n\n    for num in nums:\n        if num <= 10:\n            continue\n\n        # Convert the absolute value of the number to a string for digit extraction.\n        abs_num_str = str(abs(num))\n\n        # Extract the first and last digits as integers.\n        first_digit = int(abs_num_str[0])\n        last_digit = int(abs_num_str[-1])\n\n        # Check if both extracted digits are present in the set of odd digits.\n        if first_digit in odd_digits and last_digit in odd_digits:\n            count += 1\n            \n    return count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Computes the number of triples (i < j < k) such that a[i]+a[j]+a[k] is divisible by 3,\n    where a[x] = x*x - x + 1.\n    \"\"\"\n\n    def comb(n_val, k_val):\n        \"\"\"Calculates n_val choose k_val (C(n_val, k_val)).\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n\n        res = 1\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    # Analyze a[i] % 3:\n    # a[i] % 3 == 0 when i % 3 == 2\n    # a[i] % 3 == 1 when i % 3 == 0 or i % 3 == 1\n\n    # Count of indices i (1 <= i <= n) where i % 3 == 2\n    r0_count = n // 3 + (1 if n % 3 == 2 else 0)\n    # Count of indices i (1 <= i <= n) where i % 3 == 0 or i % 3 == 1\n    r1_count = n - r0_count\n\n    # Triples (a[i], a[j], a[k]) sum to 0 mod 3 only if:\n    # 1. All three a values are 0 mod 3.\n    # 2. All three a values are 1 mod 3.\n    # (Other combinations like (0,1,2) are not possible as a[x]%3 is only 0 or 1.)\n    \n    # Calculate combinations for each case\n    triples_from_r0 = comb(r0_count, 3)\n    triples_from_r1 = comb(r1_count, 3)\n\n    return triples_from_r0 + triples_from_r1"}
{"task_id": "HumanEval/147", "solution": "```python\ndef get_max_triples(n):\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) with i < j < k where a[i] + a[j] + a[k] is divisible by 3.\n    a[i] is defined as i*i - i + 1 for 1-indexed i.\n    \"\"\"\n\n    def nCk(n_val, k_val):\n        \"\"\"Calculates n choose k for small k values up to 3.\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0:\n            return 1\n        if k_val == 1:\n            return n_val\n        if k_val == 2:\n            return n_val * (n_val - 1) // 2\n        if k_val == 3:\n            return n_val * (n_val - 1) * (n_val - 2) // 6\n        return 0 # Only k=3 is relevant for this problem\n\n    # Calculate counts of i (1-indexed) based on i % 3\n    # num_i_mod_r represents count of i in range [1, n] such that i % 3 == r\n    num_i_mod_0 = n // 3\n    num_i_mod_1 = n // 3\n    num_i_mod_2 = n // 3\n\n    remainder = n % 3\n    if remainder >= 1:\n        num_i_mod_1 += 1  # For i = 1, 4, 7, ...\n    if remainder >= 2:\n        num_i_mod_2 += 1  # For i = 2, 5, 8, ...\n\n    # Determine residue of a[i] = i*i - i + 1 modulo 3\n    # If i % 3 == 0, then a[i] % 3 = 0*0 - 0 + 1 = 1\n    # If i % 3 == 1, then a[i] % 3 = 1*1 - 1 + 1 = 1\n    # If i % 3 == 2, then a[i] % 3 = 2*2 - 2 + 1 = 3 = 0\n\n    # c0: count of a[i] such that a[i] % 3 == 0\n    # c1: count of a[i] such that a[i] % 3 == 1\n    # c2: count of a[i] such that a[i] % 3 == 2 (this will always be 0)\n\n    c0 = num_i_mod_2\n    c1 = num_i_mod_0 + num_i_mod_1\n    c2 = 0 # No a[i] value has a residue of 2 modulo 3\n\n    # Total triples with sum divisible by 3\n    # Combinations are (0,0,0), (1,1,1), (2,2,2), (0,1,2)\n    # Since c2 is 0, (2,2,2) and (0,1,2) combinations become 0.\n    total_triples = nCk(c0, 3) + nCk(c1, 3)\n\n    return total_triples\n```"}
{"task_id": "HumanEval/148", "solution": "```python\n_PLANETS_LIST = [\n    \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n]\n_PLANET_TO_INDEX = {name.lower(): i for i, name in enumerate(_PLANETS_LIST)}\n\ndef _normalize_planet_name_for_lookup(name: str) -> str:\n    \"\"\"Normalizes a planet name for case-insensitive lookup.\"\"\"\n    if not name:\n        return \"\"\n    return name.strip().lower()\n\ndef bf(planet1, planet2):\n    \"\"\"\n    Returns planets orbiting between planet1 and planet2, sorted by proximity to the Sun.\n    Returns an empty tuple if planet1 or planet2 are not valid names.\n    \"\"\"\n    normalized_p1 = _normalize_planet_name_for_lookup(planet1)\n    normalized_p2 = _normalize_planet_name_for_lookup(planet2)\n\n    idx1 = _PLANET_TO_INDEX.get(normalized_p1)\n    idx2 = _PLANET_TO_INDEX.get(normalized_p2)\n\n    if idx1 is None or idx2 is None:\n        return tuple()\n\n    start_idx = min(idx1, idx2) + 1\n    end_idx = max(idx1, idx2)\n\n    if start_idx >= end_idx:\n        return tuple()\n\n    between_planets = _PLANETS_LIST[start_idx:end_idx]\n    return tuple(between_planets)\n```"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    Returns planets whose orbits are between planet1 and planet2, sorted by proximity to the Sun.\n    Returns an empty tuple if planet names are invalid or adjacent.\n    '''\n    PLANETS = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n\n    p1_norm = planet1.strip().capitalize()\n    p2_norm = planet2.strip().capitalize()\n\n    try:\n        idx1 = PLANETS.index(p1_norm)\n        idx2 = PLANETS.index(p2_norm)\n    except ValueError:\n        return () # Return empty tuple for invalid planet names\n\n    if idx1 == idx2:\n        return ()\n\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    # Slice the list strictly between the two planets, excluding endpoints.\n    result_planets = PLANETS[start_idx + 1 : end_idx]\n    \n    return tuple(result_planets)"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings to remove odd-length words, then sorts the remaining even-length strings.\n    Sorting is done by length ascending, then alphabetically for ties.\"\"\"\n    \n    filtered_list = []\n    for s in lst:\n        if len(s) % 2 == 0:\n            filtered_list.append(s)\n            \n    # Sort by length first, then alphabetically for equal lengths.\n    filtered_list.sort(key=lambda x: (len(x), x))\n    \n    return filtered_list"}
{"task_id": "HumanEval/149", "solution": "```python\ndef sorted_list_sum(lst):\n    \"\"\"Write a function that accepts a list of strings as a parameter,\n    deletes the strings that have odd lengths from it,\n    and returns the resulted list with a sorted order,\n    The list is always a list of strings and never an array of numbers,\n    and it may contain duplicates.\n    The order of the list should be ascending by length of each word, and you\n    should return the list sorted by that rule.\n    If two words have the same length, sort the list alphabetically.\n    The function should return a list of strings in sorted order.\n    You may assume that all words will have the same length.\n    For example:\n    assert list_sort([\"aa\", \"a\", \"aaa\"]) => [\"aa\"]\n    assert list_sort([\"ab\", \"a\", \"aaa\", \"cd\"]) => [\"ab\", \"cd\"]\n    \"\"\"\n    filtered_list = [s for s in lst if len(s) % 2 == 0]\n    return sorted(filtered_list, key=lambda s: (len(s), s))\n\n```"}
{"task_id": "HumanEval/150", "solution": "```python\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n    \"\"\"\n    def is_prime_inline(num):\n        \"\"\"Checks if a number is prime using trial division up to its square root.\n        This helper is defined inline as required by the constraints.\n        \"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    if is_prime_inline(n):\n        return x\n    else:\n        return y\n```"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"Returns x if n is prime, y otherwise.\n    Applies a basic primality test without external dependencies.\n    \"\"\"\n\n    # Defines a helper function for primality check as required by constraints.\n    def _is_prime(num):\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        # Checks for odd divisors from 3 up to the square root of num.\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    if _is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/151", "solution": "```python\ndef double_the_difference(lst):\n    \"\"\"\n    Computes the sum of squares for odd, non-negative integers from a list.\n    Numbers that are not integers or are negative are ignored.\n    \"\"\"\n    total_sum_of_squares = 0\n    for n in lst:\n        # Filter for integers that are non-negative and odd, as per business rules.\n        if isinstance(n, int) and n >= 0 and n % 2 == 1:\n            total_sum_of_squares += n * n\n    return total_sum_of_squares\n```"}
{"task_id": "HumanEval/151", "solution": "```python\ndef double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    '''\n    total_sum = 0\n    for item in lst:\n        try:\n            num = float(item)\n        except (TypeError, ValueError):\n            continue\n\n        if num < 0:\n            continue\n\n        if not num.is_integer():\n            continue\n\n        int_num = int(num)\n        if int_num % 2 == 1:\n            total_sum += int_num * int_num\n            \n    return total_sum\n```"}
{"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"\n    Compares two lists of scores and guesses, returning the absolute difference for each match.\n    If a guess is correct, the difference is 0.\n    \"\"\"\n    return [0 if g_score == g_guess else abs(g_score - g_guess) for g_score, g_guess in zip(game, guess)]"}
{"task_id": "HumanEval/152", "solution": "```python\nimport os\nimport argparse\nimport json\nimport datetime\nimport uuid\nimport logging\nimport sys\nfrom typing import List, Any, Iterable, Optional, Dict\nfrom pathlib import Path\n\n# Set up basic logging for the application\nlogging.basicConfig(level=logging.INFO, stream=sys.stderr, format='%(asctime)s - %(levelname)s - %(message)s')\n\n# --- src/scorecompare/config.py ---\nclass Config:\n    \"\"\"Configuration constants for the scorecompare application.\"\"\"\n    DEFAULT_STORAGE_PATH: str = os.environ.get(\"SCORECOMPARE_STORAGE_PATH\", \"data/scorecompare_history.json\")\n    PERSISTENCE_ENABLED: bool = os.environ.get(\"SCORECOMPARE_PERSISTENCE_ENABLED\", \"False\").lower() == \"true\"\n    MAX_PAYLOAD_ITEMS: int = int(os.environ.get(\"SCORECOMPARE_MAX_PAYLOAD_ITEMS\", \"10000\"))\n\n# --- src/scorecompare/exceptions.py ---\nclass InvalidInputError(Exception):\n    \"\"\"Raised when input validation fails.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass PersistenceError(Exception):\n    \"\"\"Raised when persistence operations fail.\"\"\"\n    def __init__(self, message: str, original_exception: Optional[Exception]=None) -> None:\n        self.message = message\n        self.original_exception = original_exception\n        super().__init__(self.message)\n\n# --- src/scorecompare/models.py ---\nclass ScoreInput:\n    \"\"\"Data Transfer Object for validated game and guess scores.\"\"\"\n    def __init__(self, game: List[int], guess: List[int]) -> None:\n        self.game = game\n        self.guess = guess\n\nclass CompareResult:\n    \"\"\"Data Transfer Object for the comparison result.\"\"\"\n    def __init__(self, result: List[int]) -> None:\n        self.result = result\n\nclass RunRecord:\n    \"\"\"Represents a historical record of a comparison invocation.\"\"\"\n    def __init__(self, id: str, timestamp: str, game: List[int], guess: List[int], result: List[int]) -> None:\n        self.id = id\n        self.timestamp = timestamp\n        self.game = game\n        self.guess = guess\n        self.result = result\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Returns a serializable dictionary representation of the record.\"\"\"\n        return {\n            \"id\": self.id,\n            \"timestamp\": self.timestamp,\n            \"game\": self.game,\n            \"guess\": self.guess,\n            \"result\": self.result,\n        }\n\n# --- src/scorecompare/utils.py ---\ndef parse_csv_list(s: str) -> List[int]:\n    \"\"\"Parses a comma-separated string of numbers into a list of integers.\"\"\"\n    try:\n        return [int(x.strip()) for x in s.split(\",\") if x.strip() != \"\"]\n    except ValueError:\n        raise InvalidInputError(\"CSV elements must be integers or integer strings.\")\n\ndef to_json(o: Any) -> str:\n    \"\"\"Converts a Python object to a JSON string.\"\"\"\n    return json.dumps(o, indent=2)\n\n# --- src/scorecompare/validator.py ---\nclass Validator:\n    \"\"\"Validates and coerces raw inputs into a ScoreInput object.\"\"\"\n    def validate_and_coerce(self, game: Iterable[Any], guess: Iterable[Any]) -> ScoreInput:\n        \"\"\"Validates input iterables and coerces elements to integers.\"\"\"\n        g_list = self._coerce_list(game)\n        q_list = self._coerce_list(guess)\n\n        if len(g_list) != len(q_list):\n            raise InvalidInputError(\"game and guess lists must have the same length.\")\n        if len(g_list) > Config.MAX_PAYLOAD_ITEMS:\n            raise InvalidInputError(f\"Payload too large. Max allowed items: {Config.MAX_PAYLOAD_ITEMS}.\")\n        \n        return ScoreInput(game=g_list, guess=q_list)\n\n    def _coerce_list(self, seq: Iterable[Any]) -> List[int]:\n        \"\"\"Coerces elements of an iterable to integers.\"\"\"\n        try:\n            # Ensure the sequence is iterable and then convert each element\n            return [int(x) for x in list(seq)]\n        except Exception:\n            raise InvalidInputError(\"All elements must be integers or coercible to integers.\")\n\n# --- src/scorecompare/repository.py ---\nclass FileRepository:\n    \"\"\"Persists RunRecord objects to a local JSON file.\"\"\"\n    def __init__(self, path: str = Config.DEFAULT_STORAGE_PATH) -> None:\n        self.path = Path(path)\n        self._ensure_store()\n\n    def _ensure_store(self) -> None:\n        \"\"\"Ensures the data directory and the JSON file exist.\"\"\"\n        self.path.parent.mkdir(parents=True, exist_ok=True)\n        if not self.path.exists():\n            try:\n                with open(self.path, \"w\", encoding=\"utf-8\") as f:\n                    f.write(\"[]\") # Initialize with an empty JSON array\n            except IOError as e:\n                raise PersistenceError(f\"Could not initialize history file at {self.path}\", e)\n\n    def save(self, record: RunRecord) -> None:\n        \"\"\"Appends a RunRecord to the JSON file.\"\"\"\n        try:\n            # Read, append, and write back atomically\n            with open(self.path, \"r+\", encoding=\"utf-8\") as f:\n                f.seek(0)\n                try:\n                    data = json.load(f)\n                except json.JSONDecodeError:\n                    data = [] # Handle empty or malformed JSON\n                data.append(record.to_dict())\n                f.seek(0)\n                f.truncate() # Clear existing content\n                json.dump(data, f, indent=2)\n        except Exception as e:\n            raise PersistenceError(f\"Failed to save run record to {self.path}\", e)\n\n# --- src/scorecompare/compare_service.py ---\nclass CompareService:\n    \"\"\"Encapsulates the core score comparison logic and orchestrates persistence.\"\"\"\n    def __init__(self, repository: Optional[FileRepository] = None, validator: Optional[Validator] = None) -> None:\n        self.validator = validator or Validator()\n        if repository is None and Config.PERSISTENCE_ENABLED:\n            self.repository = FileRepository()\n        else:\n            self.repository = repository\n\n    def compute(self, game: Iterable[Any], guess: Iterable[Any]) -> CompareResult:\n        \"\"\"\n        Validates inputs, computes absolute differences, and optionally persists the run.\n        \"\"\"\n        score_input = self.validator.validate_and_coerce(game, guess)\n        \n        diffs = self._compute_differences(score_input.game, score_input.guess)\n        result = CompareResult(diffs)\n\n        if self.repository:\n            record = RunRecord(\n                id=str(uuid.uuid4()),\n                timestamp=datetime.datetime.utcnow().isoformat(timespec='seconds') + \"Z\",\n                game=score_input.game,\n                guess=score_input.guess,\n                result=result.result,\n            )\n            try:\n                self.repository.save(record)\n            except PersistenceError as e:\n                logging.warning(\"Persistence failed for record %s: %s\", record.id, e.message)\n                if e.original_exception:\n                    logging.debug(\"Original persistence exception: %s\", e.original_exception)\n        \n        return result\n\n    def _compute_differences(self, game: List[int], guess: List[int]) -> List[int]:\n        \"\"\"\n        Computes the element-wise absolute differences between game and guess scores.\n        Assumes inputs are lists of integers of equal length.\n        \"\"\"\n        return [abs(a - b) for a, b in zip(game, guess)]\n\n# --- src/scorecompare/cli_controller.py ---\nclass CLIController:\n    \"\"\"Handles command-line interface argument parsing and execution.\"\"\"\n    def __init__(self, service: CompareService) -> None:\n        self.service = service\n\n    def parse_args(self, argv: Optional[List[str]] = None) -> argparse.Namespace:\n        \"\"\"Parses command-line arguments.\"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"scorecompare\",\n            description=\"Compares two lists of match scores and returns absolute differences.\",\n            formatter_class=argparse.ArgumentDefaultsHelpFormatter\n        )\n        subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\", required=True)\n\n        compare_parser = subparsers.add_parser(\n            \"compare\",\n            help=\"Compare two lists of scores.\"\n        )\n        compare_parser.add_argument(\n            \"--game\",\n            type=str,\n            required=True,\n            help=\"Comma-separated list of actual game scores (e.g., '1,2,3').\"\n        )\n        compare_parser.add_argument(\n            \"--guess\",\n            type=str,\n            required=True,\n            help=\"Comma-separated list of guessed scores (e.g., '1,2,0').\"\n        )\n        compare_parser.add_argument(\n            \"--save\",\n            action=\"store_true\",\n            help=\"Enable persistence of the run record.\"\n        )\n\n        return parser.parse_args(argv)\n\n    def run(self, args: argparse.Namespace) -> int:\n        \"\"\"Executes the CLI command based on parsed arguments.\"\"\"\n        if args.command == \"compare\":\n            try:\n                game_list = parse_csv_list(args.game)\n                guess_list = parse_csv_list(args.guess)\n\n                # Temporarily override persistence for this specific call if --save is used\n                # or defer the decision to CompareService based on Config.PERSISTENCE_ENABLED\n                if args.save and not self.service.repository:\n                    self.service.repository = FileRepository()\n                elif not args.save and self.service.repository: # If --save not present, ensure service persistence is off *for this specific call* if it was default-on\n                    # This is tricky with a shared service instance. For simpl