{"task_id": "HumanEval/18", "solution": "```python\ndef how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlaping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n    n = len(string)\n    m = len(substring)\n\n    if m == 0:\n        return 0\n\n    count = 0\n    for i in range(0, n - m + 1):\n        if string[i:i+m] == substring:\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlaping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n    if len(string) < len(substring):\n        return 0\n    \n    count = 0\n    # Iterate through the string, checking for substring occurrences at each position.\n    # This approach correctly handles overlapping matches.\n    for i in range(len(string) - len(substring) + 1):\n        if string[i : i + len(substring)] == substring:\n            count += 1\n            \n    return count"}
{"task_id": "HumanEval/19", "solution": "from typing import List\n\n\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Return the string with numbers sorted from smallest to largest.\n    \"\"\"\n    word_to_int_map = {\n        \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n        \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n    }\n    int_to_word_map = {\n        0: \"zero\", 1: \"one\", 2: \"two\", 3: \"three\", 4: \"four\",\n        5: \"five\", 6: \"six\", 7: \"seven\", 8: \"eight\", 9: \"nine\"\n    }\n\n    numeral_words = numbers.lower().split()\n    integer_list = [word_to_int_map[word] for word in numeral_words]\n    integer_list.sort()\n    sorted_words = [int_to_word_map[num] for num in integer_list]\n    return \" \".join(sorted_words)"}
{"task_id": "HumanEval/19", "solution": "```python\nfrom typing import List\n\n\ndef sort_numbers(numbers: str) -> str:\n    \"\"\"Input is a space-delimited string of numerals. Returns the sorted string.\"\"\"\n    WORD_TO_VALUE = {\n        \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n        \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n    }\n    VALUE_TO_WORD = {\n        0: \"zero\", 1: \"one\", 2: \"two\", 3: \"three\", 4: \"four\",\n        5: \"five\", 6: \"six\", 7: \"seven\", 8: \"eight\", 9: \"nine\"\n    }\n\n    tokens = numbers.strip().split()\n    lower_tokens = [token.lower() for token in tokens]\n\n    values = [WORD_TO_VALUE[token] for token in lower_tokens]\n\n    sorted_values = sorted(values)\n    sorted_tokens = [VALUE_TO_WORD[value] for value in sorted_values]\n\n    return \" \".join(sorted_tokens)\n```"}
{"task_id": "HumanEval/20", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\"\n    From a supplied list of numbers, select and return two that are the closest.\n    The returned pair is in order (smaller number, larger number).\n    \"\"\"\n    nums = sorted(numbers)\n\n    min_diff = float('inf')\n    closest_pair = (nums[0], nums[1])\n\n    for i in range(len(nums) - 1):\n        diff = nums[i+1] - nums[i]\n        if diff < min_diff:\n            min_diff = diff\n            closest_pair = (nums[i], nums[i+1])\n\n    return closest_pair\n```"}
{"task_id": "HumanEval/20", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\" From a supplied list of numbers, select two that are closest to each other.\n    The result is returned as a tuple (smaller number, larger number).\n    \"\"\"\n    sorted_numbers = sorted(numbers)\n\n    closest_pair = (sorted_numbers[0], sorted_numbers[1])\n    min_diff = sorted_numbers[1] - sorted_numbers[0]\n\n    for i in range(1, len(sorted_numbers) - 1):\n        num1 = sorted_numbers[i]\n        num2 = sorted_numbers[i+1]\n        current_diff = num2 - num1\n\n        if current_diff < min_diff:\n            min_diff = current_diff\n            closest_pair = (num1, num2)\n\n    return closest_pair\n```"}
{"task_id": "HumanEval/21", "solution": "```python\nfrom typing import List\n\ndef rescale_to_unit(numbers: List[float]) -> List[float]:\n    \"\"\"Given a list of numbers, linearly transform them such that the minimum becomes 0 and the maximum becomes 1.\n    Input is assumed to be a list of at least two floats, where not all elements are equal.\n    \"\"\"\n    min_v = min(numbers)\n    max_v = max(numbers)\n    denom = max_v - min_v\n    return [(x - min_v) / denom for x in numbers]\n```"}
