al):\n        count += 1\n        if count == n:\n            _prime_fib_cache[n] = current_fib_val\n            return current_fib_val\n\n    # Check F_2 = 2 for primality.\n    current_fib_val = f_next\n    if _is_prime(current_fib_val):\n        count += 1\n        if count == n:\n            _prime_fib_cache[n] = current_fib_val\n            return current_fib_val\n    \n    # Generate subsequent Fibonacci numbers and check for primality.\n    while True:\n        f_current, f_next = f_next, f_current + f_next # Generate next Fibonacci number.\n        current_fib_val = f_next\n\n        if _is_prime(current_fib_val):\n            count += 1\n            if count == n:\n                _prime_fib_cache[n] = current_fib_val\n                return current_fib_val"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n\n    def is_prime(num: int) -> bool:\n        \"\"\"Checks if a number is prime using an optimized trial division algorithm.\"\"\"\n        if num < 2:\n            return False\n        if num <= 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    prime_count = 0\n    fib_prev, fib_curr = 0, 1  # Initialize with F_0 and F_1 to generate standard sequence.\n\n    while prime_count < n:\n        # Generate the next Fibonacci number in the sequence.\n        next_fib = fib_prev + fib_curr\n        fib_prev = fib_curr\n        fib_curr = next_fib\n\n        # Only consider numbers greater than or equal to 2 for primality, skipping F_1=1 and F_2=1.\n        if fib_curr >= 2 and is_prime(fib_curr):\n            prime_count += 1\n            if prime_count == n:\n                return fib_curr"}
{"task_id": "HumanEval/40", "solution": "```python\n# pyproject.toml\n# Build and packaging metadata\n[project]\nname = \"triples_zero\"\nversion = \"0.1.0\"\ndescription = \"A Python library to find if a list of integers contains three distinct elements that sum to zero.\"\nauthors = [\n    { name = \"Your Name\", email = \"your.email@example.com\" },\n]\ndependencies = [\n    # No heavy dependencies for core logic\n]\nrequires-python = \">=3.9\"\nreadme = \"README.md\"\nlicense = { text = \"MIT\" }\n\n[project.optional-dependencies]\nhttp = [\"Flask>=2.0.0\"]\n\n[project.scripts]\ntriples-cli = \"triples_zero.CLI:main\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n\n```\n\n```python\n# requirements.txt\n# Optional runtime dependencies for the HTTP adapter\nFlask>=2.0.0\n```\n\n```python\n# README.md\n# Triples Zero Library\n\nA Python library and service to determine if a list of integers contains three distinct elements that sum to zero.\n\n## Features\n\n- **Core Logic**: An optimized `O(n^2)` algorithm.\n- **CLI Tool**: A command-line interface for manual checks.\n- **HTTP API**: An optional Flask-based HTTP endpoint for service integration.\n- **Modular Design**: Suitable for inclusion in larger projects.\n\n## Installation\n\n```bash\n# Basic library installation\npip install triples_zero\n\n# For HTTP API support, install with the 'http' extra\npip install \"triples_zero[http]\"\n```\n\n## Usage\n\n### As a Library\n\n```python\nfrom triples_zero.TriplesService import TriplesService\nfrom triples_zero.Validator import InputValidator\nfrom triples_zero.TriplesController import TriplesController\nfrom triples_zero.ListRepository import ListRepository\nfrom triples_zero.Exceptions import InvalidInputError\n\n# Instantiate core components\nservice = TriplesService()\nvalidator = InputValidator()\nrepository = ListRepository() # Optional: for logging requests\ncontroller = TriplesController(service, validator, repository)\n\n# Example usage with a list of integers\nnumbers_list = [1, 3, -2, 1]\nresult_dto = controller.solve(numbers_list)\nprint(f\"Result for {numbers_list}: {result_dto.result}\") # Expected: True\n\n# Example usage with a comma-separated string\nnumbers_str = \"1, 2, 3, 7\"\nresult_dto = controller.solve(numbers_str)\nprint(f\"Result for '{numbers_str}': {result_dto.result}\") # Expected: False\n\n# Example of error handling\ntry:\n    controller.solve(\"1,a,3\") # Invalid input\nexcept InvalidInputError as e:\n    print(f\"Caught an error: {e.message}\")\n```\n\n### CLI\n\nThe CLI tool `triples-cli` is installed with the package.\n\n```bash\n# Check a comma-separated list\ntriples-cli --list \"1,3,-4,2\"\n# Output: True\n\n# Check a JSON array string\ntriples-cli --json '[1,3,5,0]'\n# Output: False\n\n# Handle invalid input\ntriples-cli --list \"1,a,3\"\n# Output: Error: Invalid input: string contains non-integers or is not a valid JSON array/comma-separated list\n# Exit code: 2\n```\n\n### HTTP API (Optional)\n\nFirst, make sure Flask is installed: `pip install \"triples_zero[http]\"`.\n\nTo run the Flask application, you can use a small script (e.g., `run_http_app.py`):\n\n```python\n# run_http_app.py\nfrom triples_zero.HTTPAdapter import create_app\nfrom triples_zero.TriplesController import TriplesController\nfrom triples_zero.TriplesService import TriplesService\nfrom triples_zero.Validator import InputValidator\nfrom triples_zero.ListRepository import ListRepository\nfrom triples_zero.Config import Config\n\n# Instantiate dependencies\nservice = TriplesService()\nvalidator = InputValidator()\nrepository = ListRepository()\ncontroller = TriplesController(service, validator, repository)\n\n# Create and run the Flask app\napp = create_app(controller)\n\nif __name__ == '__main__':\n    app.run(host=Config.HTTP_HOST, port=Config.HTTP_PORT, debug=Config.DEBUG)\n```\n\nThen run this script: `python run_http_app.py`\n\nYou can then make requests to `http://localhost:8000`:\n\n```bash\n# Example POST request for a zero-sum triplet\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"numbers\": [1, -1, 0]}' http://localhost:8000/triples/sum_zero\n# Output: {\"result\": true}\n\n# Example POST request with no zero-sum triplet\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"numbers\": [1, 2, 3]}' http://localhost:8000/triples/sum_zero\n# Output: {\"result\": false}\n\n# Example POST with invalid input\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"numbers\": [1, \"a\", 3]}' http://localhost:8000/triples/sum_zero\n# Output: {\"error\": \"Invalid input: list must contain integers\"} (HTTP 400)\n```\n\n## Development\n\n```bash\n# Clone the repository\n# git clone <repository-url>\n# cd triples-zero\n\n# Install dependencies (including optional HTTP dependencies)\npip install -e \".[http]\"\n\n# Run tests (assuming pytest is installed and tests are in the 'tests/' directory)\n# pytest\n```\n```\n\n```python\n# src/triples_zero/__init__.py\n\"\"\"\nA Python library and service to determine if a list of integers contains three distinct elements that sum to zero.\n\"\"\"\n\nfrom .Config import Config\nfrom .Exceptions import InvalidInputError, ServiceError\nfrom .Models import InputDTO, ResultDTO\nfrom .TriplesService import TriplesService\nfrom .Validator import InputValidator\nfrom .TriplesController import TriplesController\nfrom .ListRepository import ListRepository\n\n__all__ = [\n    \"Config\",\n    \"InvalidInputError\",\n    \"ServiceError\",\n    \"InputDTO\",\n    \"ResultDTO\",\n    \"TriplesService\",\n    \"InputValidator\",\n    \"TriplesController\",\n    \"ListRepository\",\n]\n```\n\n```python\n# src/triples_zero/Config.py\n\"\"\"\nConfiguration constants for the triples_zero package.\n\"\"\"\n\nclass Config:\n    \"\"\"\n    Central configuration for adapters and logging toggles.\n    \"\"\"\n    DEBUG: bool = False\n    HTTP_HOST: str = \"127.0.0.1\"\n    HTTP_PORT: int = 8000\n```\n\n```python\n# src/triples_zero/Models.py\n\"\"\"\nData Transfer Objects (DTOs) for input and result handling.\n\"\"\"\nfrom typing import List, Any\n\nclass InputDTO:\n    \"\"\"\n    Typed container for normalized input numbers.\n    \"\"\"\n    numbers: List[int]\n\n    def __init__(self, numbers: List[int]):\n        \"\"\"\n        Initializes the InputDTO with a list of integers.\n        \"\"\"\n        self.numbers = numbers\n\n    @classmethod\n    def from_any(cls, obj: Any) -> \"InputDTO\":\n        \"\"\"\n        Creates an InputDTO from a flexible input object.\n        Note: This method is a placeholder; actual validation and parsing\n        logic is handled by InputValidator before constructing this DTO.\n        \"\"\"\n        if isinstance(obj, list) and all(isinstance(x, int) for x in obj):\n            return cls(obj)\n        raise TypeError(\"from_any expects a list of integers after initial validation.\")\n\n\nclass ResultDTO:\n    \"\"\"\n    Container for the boolean result of the triplet sum check.\n    \"\"\"\n    result: bool\n\n    def __init__(self, result: bool):\n        \"\"\"\n        Initializes the ResultDTO with a boolean result.\n        \"\"\"\n        self.result = result\n```\n\n```python\n# src/triples_zero/Exceptions.py\n\"\"\"\nCustom exceptions for domain-specific errors.\n\"\"\"\n\nclass InvalidInputError(Exception):\n    \"\"\"\n    Exception raised for invalid or malformed input.\n    \"\"\"\n    def __init__(self, message: str):\n        \"\"\"\n        Initializes an InvalidInputError with a specific message.\n        \"\"\"\n        self.message = message\n        super().__init__(self.message)\n\nclass ServiceError(Exception):\n    \"\"\"\n    Exception raised for unexpected errors within the service logic.\n    \"\"\"\n    def __init__(self, message: str):\n        \"\"\"\n        Initializes a ServiceError with a specific message.\n        \"\"\"\n        self.message = message\n        super().__init__(self.message)\n```\n\n```python\n# src/triples_zero/Validator.py\n\"\"\"\nInput validation and normalization utility.\n\"\"\"\nimport json\nfrom typing import Any, List\nfrom .Exceptions import InvalidInputError\n\nclass InputValidator:\n    \"\"\"\n    Validates and normalizes various input formats into a list of integers.\n    \"\"\"\n    def validate(self, numbers: Any) -> List[int]:\n        \"\"\"\n        Accepts various input types (list, tuple, comma-separated string, JSON string)\n        and coerces them into a list of integers.\n\n        Raises InvalidInputError if input is malformed or contains non-integer values.\n        \"\"\"\n        nums: List[int] = []\n        \n        # If input is a string, try parsing as JSON or comma-separated\n        if isinstance(numbers, str):\n            try:\n                json_parsed = json.loads(numbers)\n                if isinstance(json_parsed, list):\n                    numbers = json_parsed # Treat as a list for further processing\n                else:\n                    raise ValueError(\"JSON string is not a list.\")\n            except (json.JSONDecodeError, ValueError):\n                # Fallback to comma-separated string parsing if not valid JSON array\n                try:\n                    parts = [p.strip() for p in numbers.strip().split(\",\")]\n                    nums = [int(p) for p in parts if p != \"\"]\n                except ValueError:\n                    raise InvalidInputError(\n                        \"string contains non-integers or is not a valid JSON array/comma-separated list\"\n                    )\n        \n        # If input is now a list/tuple (either originally or from JSON parsing)\n        if isinstance(numbers, (list, tuple)):\n            try:\n                # Ensure all elements can be converted to integers\n                nums = [int(x) for x in numbers]\n            except (TypeError, ValueError):\n                raise InvalidInputError(\"list must contain integers\")\n        elif not isinstance(numbers, (list, tuple)):\n            # If after all attempts, it's not a list/tuple, it's an invalid type\n            raise InvalidInputError(\"input must be list, tuple, or a string (comma-separated or JSON array)\")\n\n        return nums\n```\n\n```python\n# src/triples_zero/TriplesService.py\n\"\"\"\nCore business logic for detecting a triplet that sums to zero.\n\"\"\"\nfrom typing import List\nfrom .Exceptions import ServiceError # Can be used for unexpected internal issues\n\nclass TriplesService:\n    \"\"\"\n    Provides the core algorithm to detect if three distinct elements in a list sum to zero.\n    \"\"\"\n    def find_triplet_sum_zero(self, nums: List[int]) -> bool:\n        \"\"\"\n        Determines if any three distinct elements of an integer list sum to zero.\n        The algorithm is O(n^2) time complexity and O(n) space complexity (for sorting copy).\n        \"\"\"\n        n = len(nums)\n        if n < 3:\n            return False\n\n        # Sort the array to efficiently use the two-pointer approach.\n        # Sorting takes O(n log n).\n        # We sort a copy to avoid modifying the original list.\n        arr = sorted(nums)\n\n        for i in range(n - 2):\n            # Skip duplicate elements for 'i' to avoid checking redundant triplets\n            # when searching for existence.\n            if i > 0 and arr[i] == arr[i-1]:\n                continue\n\n            # Use two pointers on the rest of the array (arr[i+1:])\n            # to find two numbers that sum to -arr[i]\n            target = -arr[i]\n            if self._find_two_sum_sorted(arr, i + 1, target):\n                return True\n        return False\n\n    def _find_two_sum_sorted(self, nums: List[int], start: int, target: int) -> bool:\n        \"\"\"\n        Helper method to find if two elements in a sorted list segment (from 'start' index)\n        sum to a given target using the two-pointer technique.\n        \"\"\"\n        lo, hi = start, len(nums) - 1\n        while lo < hi:\n            current_sum = nums[lo] + nums[hi]\n            if current_sum == target:\n                return True\n            if current_sum < target:\n                lo += 1\n            else:\n                hi -= 1\n        return False\n```\n\n```python\n# src/triples_zero/TriplesController.py\n\"\"\"\nOrchestrates validation, service calls, and optional request logging.\n\"\"\"\nfrom typing import Any, Optional\nfrom .TriplesService import TriplesService\nfrom .Validator import InputValidator\nfrom .ListRepository import ListRepository\nfrom .Models import ResultDTO, InputDTO\nfrom .Exceptions import InvalidInputError, ServiceError\nfrom .Config import Config # To check for debug logging behavior\n\nclass TriplesController:\n    \"\"\"\n    Handles the overall flow: input validation, calling the core service,\n    and optionally logging requests.\n    \"\"\"\n    def __init__(self, service: TriplesService, validator: InputValidator,\n                 repo: Optional[ListRepository] = None) -> None:\n        \"\"\"\n        Initializes the controller with dependencies.\n        \"\"\"\n        self._service = service\n        self._validator = validator\n        self._repo = repo\n\n    def solve(self, numbers: Any) -> ResultDTO:\n        \"\"\"\n        Processes the input, determines if a zero-sum triplet exists,\n        and logs the request if a repository is provided.\n        \"\"\"\n        try:\n            validated_numbers = self._validator.validate(numbers)\n            input_dto = InputDTO(validated_numbers) # Create DTO after validation\n\n            result = self._service.find_triplet_sum_zero(input_dto.numbers)\n\n            if self._repo:\n                self._repo.log_request(input_dto.numbers, result)\n\n            return ResultDTO(result)\n        except InvalidInputError:\n            # Re-raise InvalidInputError to be handled by adapters\n            raise\n        except Exception as e:\n            # Wrap unexpected exceptions in ServiceError for consistent error handling\n            if Config.DEBUG:\n                import traceback\n                traceback.print_exc() # Print full stack trace in debug mode\n            raise ServiceError(f\"An unexpected error occurred during processing: {e}\") from e\n```\n\n```python\n# src/triples_zero/ListRepository.py\n\"\"\"\nSimple in-memory repository for ephemeral logging of requests.\n\"\"\"\nfrom typing import List, Dict, Any\nimport datetime\n\nclass ListRepository:\n    \"\"\"\n    Stores a history of requests and their results in memory.\n    Not intended for durable persistence.\n    \"\"\"\n    def __init__(self):\n        \"\"\"\n        Initializes the in-memory store.\n        \"\"\"\n        self._store: List[Dict[str, Any]] = []\n\n    def log_request(self, numbers: List[int], result: bool) -> None:\n        \"\"\"\n        Logs a processed request, including input numbers and the boolean result.\n        \"\"\"\n        timestamp = datetime.datetime.now(datetime.timezone.utc).isoformat()\n        self._store.append({\n            \"timestamp\": timestamp,\n            \"numbers\": list(numbers),  # Store a copy to prevent external modification\n            \"result\": result\n        })\n\n    def get_recent(self, n: int = 10) -> List[Dict[str, Any]]:\n        \"\"\"\n        Returns the 'n' most recent logged requests.\n        \"\"\"\n        return self._store[-n:]\n```\n\n```python\n# src/triples_zero/CLI.py\n\"\"\"\nCommand-line interface (CLI) adapter for the triples_zero package.\n\"\"\"\nimport argparse\nimport sys\nfrom typing import List\n\nfrom .TriplesController import TriplesController\nfrom .TriplesService import TriplesService\nfrom .Validator import InputValidator\nfrom .ListRepository import ListRepository\nfrom .Exceptions import InvalidInputError, ServiceError\n\nclass CLI:\n    \"\"\"\n    Provides the command-line interface for the Triples Zero application.\n    \"\"\"\n    @staticmethod\n    def run(argv: List[str]) -> int:\n        \"\"\"\n        Parses command-line arguments, invokes the controller, and prints the result.\n        Returns an exit code (0 for success, 2 for invalid input, 1 for other errors).\n        \"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Determine if a list of integers contains three distinct elements that sum to zero.\"\n        )\n        group = parser.add_mutually_exclusive_group(required=True)\n        group.add_argument(\"--list\", type=str,\n                           help=\"Comma-separated list of integers (e.g., '1,2,-3').\")\n        group.add_argument(\"--json\", type=str,\n                           help=\"JSON array string of integers (e.g., '[1,2,-3]').\")\n\n        args = parser.parse_args(argv[1:]) # argv[0] is the script name\n\n        raw_input = args.json if args.json is not None else args.list\n\n        # Instantiate dependencies\n        service = TriplesService()\n        validator = InputValidator()\n        repo = ListRepository() # Instantiate for optional logging\n        controller = TriplesController(service, validator, repo)\n\n        try:\n            result_dto = controller.solve(raw_input)\n            print(result_dto.result)\n            return 0  # Success\n        except InvalidInputError as e:\n            print(f\"Error: Invalid input: {e.message}\", file=sys.stderr)\n            return 2  # Invalid input error\n        except ServiceError as e:\n            print(f\"Error: Service fault: {e.message}\", file=sys.stderr)\n            return 1  # Internal service error\n        except Exception as e:\n            print(f\"Error: An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1  # Generic unexpected error\n\ndef main() -> int:\n    \"\"\"\n    Entry point for the CLI script.\n    \"\"\"\n    return CLI.run(sys.argv)\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n```\n\n```python\n# src/triples_zero/HTTPAdapter.py\n\"\"\"\nOptional Flask-based HTTP adapter exposing an endpoint for the Triples Zero service.\n\"\"\"\nfrom flask import Flask, request, jsonify\nfrom typing import TYPE_CHECKING\nfrom .TriplesController import TriplesController\nfrom .Exceptions import InvalidInputError, ServiceError\nfrom .Config import Config\n\nif TYPE_CHECKING:\n    from flask.typing import ResponseReturnValue\n\ndef create_app(controller: TriplesController) -> Flask:\n    \"\"\"\n    Creates and configures a Flask application with the Triples Zero endpoint.\n    \"\"\"\n    app = Flask(__name__)\n    app.config.from_object(Config)\n\n    @app.route(\"/triples/sum_zero\", methods=[\"POST\"])\n    def sum_zero_endpoint() -> \"ResponseReturnValue\":\n        \"\"\"\n        HTTP POST endpoint to check if three distinct elements sum to zero.\n        Expects a JSON body like {\"numbers\": [int, int, ...]}.\n        \"\"\"\n        if not request.is_json:\n            return jsonify({\"error\": \"Request must be JSON\"}), 400\n\n        data = request.get_json()\n        if data is None:\n            return jsonify({\"error\": \"Invalid JSON body\"}), 400\n            \n        numbers_raw = data.get(\"numbers\")\n\n        if numbers_raw is None:\n            return jsonify({\"error\": \"Missing 'numbers' field in JSON body\"}), 400\n\n        try:\n            result_dto = controller.solve(numbers_raw)\n            return jsonify({\"result\": result_dto.result}), 200\n        except InvalidInputError as e:\n            return jsonify({\"error\": f\"Invalid input: {e.message}\"}), 400\n        except ServiceError as e:\n            # Log full stack trace in debug mode, otherwise generic message\n            app.logger.error(f\"Service error: {e.message}\", exc_info=app.config.get('DEBUG', False))\n            return jsonify({\"error\": \"Internal server error\"}), 500\n        except Exception as e:\n            # Catch all other unexpected errors\n            app.logger.exception(f\"Unhandled exception: {e}\", exc_info=app.config.get('DEBUG', False))\n            return jsonify({\"error\": \"An unexpected error occurred\"}), 500\n\n    return app\n```"}
{"task_id": "HumanEval/40", "solution": "```python\ndef triples_sum_to_zero(l: list):\n    \"\"\"\n    Checks if there are three distinct elements in a list of integers that sum to zero.\n    Returns True if such a triple exists, False otherwise.\n\n    >>> triples_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> triples_sum_to_zero([1, 3, -2, 1])\n    True\n    >>> triples_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> triples_sum_to_zero([2, 4, -5, 3, 9, 7])\n    True\n    >>> triples_sum_to_zero([1])\n    False\n    \"\"\"\n    n = len(l)\n    nums = sorted(l)\n\n    for i in range(n - 2):\n        left = i + 1\n        right = n - 1\n\n        while left < right:\n            current_sum = nums[i] + nums[left] + nums[right]\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else: # current_sum > 0\n                right -= 1\n    return False\n```"}
