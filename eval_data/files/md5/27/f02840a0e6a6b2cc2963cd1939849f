{"task_id": "Mbpp/75", "solution": "from typing import List, Tuple, Sequence\n\nclass Validator:\n    \"\"\"Stateless utility to evaluate divisibility rules and minimal type expectations.\"\"\"\n    def tuple_all_divisible(self, t: Tuple[int, ...], k: int) -> bool:\n        \"\"\"Returns True if every element in the tuple 't' is divisible by 'k'.\"\"\"\n        if not t:\n            return True # An empty tuple vacuously satisfies the condition.\n        # Note: Behavior for k == 0 is unspecified in requirements; e % 0 would raise ZeroDivisionError.\n        return all(e % k == 0 for e in t)\n\n    # The design includes validate_input_types, but the top-level function does not\n    # explicitly require calling it, and the prompt asks not to add isinstance() checks.\n    # Therefore, this method is omitted from the implementation.\n\nclass Finder:\n    \"\"\"Core algorithm; iterates and filters tuples based on divisibility.\"\"\"\n    def __init__(self):\n        self._validator = Validator()\n\n    def find_tuples(self, list_of_tuples: Sequence[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n        \"\"\"Filters the input list of tuples, keeping only those where all elements are divisible by k.\"\"\"\n        result = []\n        for current_tuple in list_of_tuples:\n            if self._validator.tuple_all_divisible(current_tuple, k):\n                result.append(current_tuple)\n        return result\n\ndef find_tuples(list_of_tuples: Sequence[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    \"\"\"\n    Finds tuples from the given list where all elements are divisible by k.\n    Preserves order and returns a new list without modifying the input.\n    \"\"\"\n    finder = Finder()\n    return finder.find_tuples(list_of_tuples, k)"}
{"task_id": "Mbpp/85", "solution": "import math\n\ndef _compute_surface_area(radius: float) -> float:\n    \"\"\"Private helper that computes 4 * math.pi * radius**2 and returns float.\"\"\"\n    return 4 * math.pi * (radius ** 2)\n\ndef surfacearea_sphere(radius):\n    \"\"\"\n    Calculates the surface area of a sphere given its radius.\n    The input radius is converted to float before calculation.\n    \"\"\"\n    r = float(radius)\n    result = _compute_surface_area(r)\n    return float(result)"}
