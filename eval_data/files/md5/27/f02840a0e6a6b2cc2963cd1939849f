{"task_id": "Mbpp/93", "solution": "def _validate_numeric(value, name: str) -> float:\n    \"\"\"Validates if a value is numeric (int or float) and returns its float representation.\"\"\"\n    if not isinstance(value, (int, float)):\n        raise ValueError(f\"Invalid input: {name} is not numeric\")\n    return float(value)\n\ndef power(a, b) -> float:\n    \"\"\"Calculates 'a' to the power 'b' after validating inputs.\"\"\"\n    a_val = _validate_numeric(a, 'a')\n    b_val = _validate_numeric(b, 'b')\n    return a_val ** b_val"}
{"task_id": "Mbpp/92", "solution": "from typing import List\n\nclass DigitSequence:\n    \"\"\"Encapsulates an ordered sequence of digits.\"\"\"\n    def __init__(self, digits: List[int]):\n        self.digits = digits\n\n    def length(self) -> int:\n        \"\"\"Returns the total count of digits in the sequence.\"\"\"\n        return len(self.digits)\n\n    def digitAt(self, pos: int) -> int:\n        \"\"\"Returns the digit at the specified zero-based position.\"\"\"\n        return self.digits[pos]\n\nclass Number:\n    \"\"\"Represents an integer input for undulating checks.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def toDigitList(self) -> DigitSequence:\n        \"\"\"Converts the number's absolute value to a sequence of decimal digits.\"\"\"\n        abs_value = abs(self.value)\n        if abs_value == 0:\n            return DigitSequence([0])\n        \n        digits_list = []\n        temp_value = abs_value\n        while temp_value > 0:\n            digits_list.append(temp_value % 10)\n            temp_value //= 10\n        \n        return DigitSequence(digits_list[::-1])\n\nclass ValidationResult:\n    \"\"\"Stores the outcome and reason of an input validation.\"\"\"\n    def __init__(self, isValid: bool, reason: str = \"\"):\n        self.isValid = isValid\n        self.reason = reason\n\nclass UndulatingChecker:\n    \"\"\"Implements the business logic for checking if a number is undulating.\"\"\"\n    def validateInput(self, n: Number) -> ValidationResult:\n        \"\"\"Validates if the number has enough digits to be considered undulating.\"\"\"\n        digits = n.toDigitList()\n        if digits.length() < 2:\n            return ValidationResult(False, reason=\"Number must have at least two digits to be undulating.\")\n        return ValidationResult(True)\n\n    def is_undulating(self, n: Number) -> bool:\n        \"\"\"Determines if the number's digits strictly alternate between two distinct digits.\"\"\"\n        digits = n.toDigitList()\n        k = digits.length()\n\n        if k < 2:\n            return False\n\n        first_digit = digits.digitAt(0)\n        second_digit = digits.digitAt(1)\n\n        if first_digit == second_digit:\n            return False\n\n        for i in range(k):\n            current_digit = digits.digitAt(i)\n            if i % 2 == 0:\n                if current_digit != first_digit:\n                    return False\n            else:\n                if current_digit != second_digit:\n                    return False\n        \n        return True\n\ndef is_undulating(n: int) -> bool:\n    \"\"\"Checks if the given number is undulating, where digits strictly alternate between two distinct digits.\"\"\"\n    number = Number(n)\n    checker = UndulatingChecker()\n    \n    validation = checker.validateInput(number)\n    if not validation.isValid:\n        return False\n        \n    return checker.is_undulating(number)"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(items: list):\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple with the smallest second value.\n    If multiple tuples have the same smallest second value, the first encountered tuple's first value is returned.\n    \"\"\"\n    min_tuple = min(items, key=lambda item: item[1])\n    return min_tuple[0]"}
{"task_id": "Mbpp/95", "solution": "from typing import Any, List\n\ndef Find_Min_Length(input_list: List[List[Any]]) -> int:\n    \"\"\"Validates input and returns the minimum inner-list length as an integer.\"\"\"\n    class Validator:\n        def is_list_of_lists(self, obj: Any) -> bool:\n            \"\"\"Return True iff obj is a list and every element of obj is a list.\"\"\"\n            if not isinstance(obj, list):\n                return False\n            for item in obj:\n                if not isinstance(item, list):\n                    return False\n            return True\n\n    class Result:\n        def __init__(self, min_length: int) -> None:\n            self._min_length: int = int(min_length)\n        def as_int(self) -> int:\n            return self._min_length\n\n    validator = Validator()\n    if not validator.is_list_of_lists(input_list):\n        raise TypeError(\"input must be a list of lists\")\n\n    if not input_list:\n        raise ValueError(\"outer list must not be empty\")\n\n    lengths = [len(inner_list) for inner_list in input_list]\n    min_length_val = min(lengths)\n    result = Result(min_length_val)\n    return result.as_int()"}
{"task_id": "Mbpp/96", "solution": "import math\n\ndef divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer.\n    Handles negative inputs by using their absolute value.\n    \"\"\"\n    n_abs = abs(n)\n    count = 0\n\n    # Efficiently count divisors by iterating up to the square root of n_abs.\n    # Each divisor 'i' found also implies a divisor 'n_abs // i'.\n    limit = int(math.sqrt(n_abs))\n    for i in range(1, limit + 1):\n        if n_abs % i == 0:\n            if i * i == n_abs:\n                count += 1  # If i is the square root, it's a single divisor\n            else:\n                count += 2  # Otherwise, i and n_abs // i are two distinct divisors\n    return count"}
{"task_id": "Mbpp/97", "solution": "from typing import List, Any, Dict\n\nclass FrequencyMap:\n    \"\"\"Manages element counts in a dictionary.\"\"\"\n    def __init__(self) -> None:\n        self.counts = {}\n\n    def increment(self, key: Any) -> None:\n        \"\"\"Increments the count for a given element.\"\"\"\n        self.counts[key] = self.counts.get(key, 0) + 1\n\n    def to_dict(self) -> Dict[Any, int]:\n        \"\"\"Returns the current frequency map as a dictionary.\"\"\"\n        return self.counts\n\nclass FrequencyListsFunction:\n    \"\"\"Provides static methods for flattening lists and counting frequencies.\"\"\"\n    @staticmethod\n    def flatten(list_of_lists: List[List[Any]]) -> List[Any]:\n        \"\"\"Flattens a list of lists into a single list.\"\"\"\n        flat_list = []\n        for sublist in list_of_lists:\n            for item in sublist:\n                flat_list.append(item)\n        return flat_list\n\n    @staticmethod\n    def count(flat_list: List[Any]) -> Dict[Any, int]:\n        \"\"\"Counts the frequency of each element in a flat list.\"\"\"\n        freq_map = FrequencyMap()\n        for item in flat_list:\n            freq_map.increment(item)\n        return freq_map.to_dict()\n\ndef frequency_lists(list_of_lists: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists.\n    Returns a dictionary mapping elements to their counts.\n    \"\"\"\n    flat_list = FrequencyListsFunction.flatten(list_of_lists)\n    frequency_dict = FrequencyListsFunction.count(flat_list)\n    return frequency_dict"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(seq) -> float:\n    \"\"\"\n    Multiply all numbers in a sequence and divide by the sequence's length.\n    Raises ValueError for empty sequences, TypeError for non-numeric elements.\n    \"\"\"\n    if not seq:\n        raise ValueError(\"sequence must not be empty\")\n\n    product = 1.0\n    for item in seq:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"all elements must be int or float\")\n        product *= item\n\n    return product / len(seq)"}
{"task_id": "Mbpp/99", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass DecimalNumber:\n    \"\"\"Domain value object for a decimal integer.\"\"\"\n    value: int\n\n@dataclass\nclass BinaryString:\n    \"\"\"Domain value object for a binary string.\"\"\"\n    value: str\n\nclass InputValidator:\n    \"\"\"Validates if an input is a non-negative integer.\"\"\"\n    def is_non_negative_integer(self, input_val) -> bool:\n        \"\"\"Checks if the given input is an integer and non-negative.\"\"\"\n        return isinstance(input_val, int) and input_val >= 0\n\nclass DecimalToBinaryConverter:\n    \"\"\"Converts a validated non-negative integer to its binary string representation.\"\"\"\n    def decimal_to_binary(self, input_val: int) -> str:\n        \"\"\"Performs the conversion logic, handling the zero case and positive integers.\"\"\"\n        if input_val == 0:\n            return '0'\n        # Python's built-in bin() function returns a string prefixed with '0b'.\n        # Slicing [2:] removes this prefix.\n        return bin(input_val)[2:]\n\ndef decimal_to_binary(input) -> str:\n    \"\"\"\n    Converts a non-negative decimal number to its binary equivalent,\n    represented as a string with no leading zeros.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.is_non_negative_integer(input):\n        raise ValueError(\"input must be a non-negative integer\")\n\n    converter = DecimalToBinaryConverter()\n    return converter.decimal_to_binary(input)"}
