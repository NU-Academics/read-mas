{"task_id": "Mbpp/105", "solution": "def count(values: list[bool]) -> int:\n    \"\"\"Return the number of True values in values.\n\n    Parameters:\n    - values: list[bool]\n    Returns:\n    - int\n    \"\"\"\n    true_count = 0\n    for value in values:\n        if value:  # Booleans are truthy, so `if value:` is equivalent to `if value is True:`\n            true_count += 1\n    return true_count"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n, m):\n    \"\"\"\n    Computes the Eulerian number a(n, m) using recursion with memoization.\n    The function strictly adheres to the provided design context and explicit requirements.\n    \"\"\"\n    class EulerianCalculator:\n        def __init__(self):\n            # Internal memoization cache to store computed Eulerian numbers.\n            self._memo = {}\n\n        def compute_recurrence(self, n_val, m_val):\n            # Return memoized value if already computed.\n            if (n_val, m_val) in self._memo:\n                return self._memo[(n_val, m_val)]\n\n            # Base case: a(0,0) is defined as 1.\n            if n_val == 0 and m_val == 0:\n                self._memo[(n_val, m_val)] = 1\n                return 1\n\n            # Boundary conditions: a(n,m) is 0 if m is out of range [0, n-1].\n            if m_val < 0 or m_val >= n_val:\n                self._memo[(n_val, m_val)] = 0\n                return 0\n\n            # Apply the Eulerian number recurrence relation:\n            # a(n,m) = (n - m)*a(n-1,m-1) + (m + 1)*a(n-1,m)\n            term1_val = self.compute_recurrence(n_val - 1, m_val - 1)\n            term2_val = self.compute_recurrence(n_val - 1, m_val)\n\n            result = (n_val - m_val) * term1_val + (m_val + 1) * term2_val\n            self._memo[(n_val, m_val)] = result\n            return result\n\n        def eulerian_num(self, n_val, m_val):\n            # Delegates to the recursive computation.\n            return self.compute_recurrence(n_val, m_val)\n\n    # Instantiate the calculator and compute the Eulerian number.\n    calculator = EulerianCalculator()\n    return calculator.eulerian_num(n, m)"}
{"task_id": "Mbpp/104", "solution": "def _validate_input(input_collection) -> None:\n    \"\"\"Validates the outer collection type.\"\"\"\n    if not isinstance(input_collection, (list, tuple)):\n        raise TypeError(\"Input must be a list or tuple of sublists.\")\n\ndef _validate_sublist_items(sublist, index: int) -> None:\n    \"\"\"Validates that a sublist is iterable and contains only strings.\"\"\"\n    if not hasattr(sublist, '__iter__'):\n        raise TypeError(f\"Element at index {index} is not an iterable.\")\n    for item_idx, item in enumerate(sublist):\n        if not isinstance(item, str):\n            raise TypeError(f\"Element at outer index {index}, inner index {item_idx} must be a string, got {type(item).__name__}.\")\n\ndef _sort_sublist(sublist) -> list[str]:\n    \"\"\"Sorts a single sublist lexicographically and returns a new list.\"\"\"\n    return sorted(list(sublist))\n\ndef sort_sublists(input_collection: list | tuple) -> list[list[str]]:\n    \"\"\"Sorts each sublist of strings in a given list of lists.\"\"\"\n    _validate_input(input_collection)\n\n    result = []\n    for i, sublist in enumerate(input_collection):\n        _validate_sublist_items(sublist, i)\n        sorted_sub = _sort_sublist(sublist)\n        result.append(sorted_sub)\n    return result"}
