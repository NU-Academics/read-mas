{"task_id": "Mbpp/120", "solution": "from typing import List, Tuple, Union\nfrom dataclasses import dataclass\n\n@dataclass\nclass TuplePair:\n    a: Union[int, float]\n    b: Union[int, float]\n    def product(self) -> Union[int, float]:\n        return self.a * self.b\n\n@dataclass\nclass Product:\n    value: Union[int, float]\n    absolute_value: Union[int, float]\n\n@dataclass\nclass Result:\n    max_absolute_product: Union[int, float]\n\nclass InputList:\n    tuples: List[TuplePair]\n    def __init__(self, raw: List[Tuple[Union[int, float], Union[int, float]]]) -> None:\n        self.tuples = [TuplePair(a, b) for (a, b) in raw]\n\ndef max_product_tuple(input_list: List[Tuple[Union[int, float], Union[int, float]]]) -> Union[int, float]:\n    \"\"\"\n    Compute maximum absolute product from a list of 2-element numeric tuples and return numeric result.\n    \"\"\"\n    processed_input = InputList(input_list)\n\n    max_found_abs_product: Union[int, float] = 0.0\n\n    for tuple_pair in processed_input.tuples:\n        product_value = tuple_pair.product()\n        current_product = Product(value=product_value, absolute_value=abs(product_value))\n        if current_product.absolute_value > max_found_abs_product:\n            max_found_abs_product = current_product.absolute_value\n\n    final_result = Result(max_absolute_product=max_found_abs_product)\n    return final_result.max_absolute_product"}
{"task_id": "Mbpp/119", "solution": "def search(sorted_list: List) -> Any:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear twice.\n    Assumes the input list is sorted and has exactly one unique element.\n    \"\"\"\n    low = 0\n    high = len(sorted_list) - 1\n\n    while low < high:\n        mid = low + (high - low) // 2\n\n        if mid % 2 == 0:  # mid is even\n            if sorted_list[mid] == sorted_list[mid + 1]:\n                # The pair is on the left or at mid, unique element is to the right.\n                low = mid + 2\n            else:\n                # The unique element is either mid or to its left.\n                high = mid\n        else:  # mid is odd\n            if sorted_list[mid] == sorted_list[mid - 1]:\n                # The pair is on the left, unique element is to the right.\n                low = mid + 1\n            else:\n                # The unique element is either mid or to its left.\n                high = mid\n    \n    return sorted_list[low]"}
{"task_id": "Mbpp/124", "solution": "import math\nfrom typing import Any\n\ndef angle_complex(a: Any, b: Any) -> float:\n    \"\"\"\n    Calculates the argument (angle in radians) of a complex number formed from two inputs.\n    Handles coercion of inputs and validates for zero magnitude.\n    \"\"\"\n    def _coerce_to_complex(a: Any, b: Any) -> complex:\n        \"\"\"Coerces two inputs into a single complex number based on type rules.\"\"\"\n        if isinstance(a, complex) or isinstance(b, complex):\n            return complex(a) + complex(b)\n        return complex(float(a), float(b))\n\n    def _validate_nonzero(z: complex) -> None:\n        \"\"\"Raises a ValueError if the complex number has zero magnitude.\"\"\"\n        if abs(z) == 0.0:\n            raise ValueError(\"angle undefined for zero complex number\")\n\n    z = _coerce_to_complex(a, b)\n    _validate_nonzero(z)\n    return math.atan2(z.imag, z.real)"}
{"task_id": "Mbpp/123", "solution": "import math\n\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"\n    Sums all amicable numbers from 1 to a specified number n.\n    This function delegates core logic to nested helper classes (DivisorSum, AmicablePair)\n    and manages a cache to optimize divisor sum computations.\n    \"\"\"\n\n    class DivisorSum:\n        \"\"\"\n        Computes the sum of proper divisors for a given integer.\n        Proper divisors are positive divisors of a number, excluding the number itself.\n        \"\"\"\n        @staticmethod\n        def computeSum(num: int) -> int:\n            if num <= 1:\n                return 0 # 1 has no proper divisors other than itself, sum is 0.\n            \n            s = 1 # 1 is always a proper divisor for any number > 1\n            limit = int(math.sqrt(num))\n            for i in range(2, limit + 1):\n                if num % i == 0:\n                    s += i\n                    if i * i != num: # Add the other divisor only if it's not the same as i\n                        s += (num // i)\n            return s\n\n    class AmicablePair:\n        \"\"\"\n        Represents a candidate pair of numbers and determines if they are amicable.\n        An amicable pair (a, b) consists of two distinct positive integers\n        such that the sum of the proper divisors of 'a' is equal to 'b'\n        and the sum of the proper divisors of 'b' is equal to 'a'.\n        \"\"\"\n        def __init__(self, a: int, b: int):\n            self.a = a\n            self.b = b\n\n        def isAmicable(self) -> bool:\n            # An amicable pair must consist of distinct numbers\n            if self.a == self.b:\n                return False\n            \n            sum_a = DivisorSum.computeSum(self.a)\n            sum_b = DivisorSum.computeSum(self.b)\n            \n            return sum_a == self.b and sum_b == self.a\n\n    total_sum = 0\n    # Set to store numbers that have already been identified as amicable and added to the sum.\n    # This prevents double-counting elements of an amicable pair.\n    visited_amicable_numbers = set()\n\n    # Cache for computed divisor sums to avoid redundant calculations.\n    divisor_sums_cache = {}\n\n    def get_proper_divisor_sum(num: int) -> int:\n        \"\"\"Helper to get divisor sum, utilizing and updating the cache.\"\"\"\n        if num in divisor_sums_cache:\n            return divisor_sums_cache[num]\n        \n        computed_sum = DivisorSum.computeSum(num)\n        divisor_sums_cache[num] = computed_sum\n        return computed_sum\n    \n    # Iterate through numbers from 1 up to n (inclusive)\n    for i in range(1, n + 1):\n        # If 'i' has already been identified as part of an amicable pair and added, skip it.\n        if i in visited_amicable_numbers:\n            continue\n\n        sum_of_proper_divisors_i = get_proper_divisor_sum(i)\n\n        # Check conditions for a potential amicable pair partner:\n        # 1. The partner must be within the range [1, n].\n        # 2. The partner must be distinct from 'i'.\n        if 1 <= sum_of_proper_divisors_i <= n and sum_of_proper_divisors_i != i:\n            # Check if the sum of proper divisors of the potential partner\n            # points back to 'i'.\n            sum_of_proper_divisors_partner = get_proper_divisor_sum(sum_of_proper_divisors_i)\n\n            # If both conditions hold, we have found an amicable pair (i, sum_of_proper_divisors_i).\n            if sum_of_proper_divisors_partner == i:\n                # Add 'i' to the total sum if not already added.\n                if i not in visited_amicable_numbers:\n                    total_sum += i\n                    visited_amicable_numbers.add(i)\n                # Add the partner (sum_of_proper_divisors_i) to the total sum if not already added.\n                if sum_of_proper_divisors_i not in visited_amicable_numbers:\n                    total_sum += sum_of_proper_divisors_i\n                    visited_amicable_numbers.add(sum_of_proper_divisors_i)\n    \n    return total_sum"}
{"task_id": "Mbpp/125", "solution": "class BinaryString:\n    \"\"\"Represents a binary string and provides its length.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the binary string.\"\"\"\n        return len(self.value)\n\nclass Substring:\n    \"\"\"Represents a substring with its counts of zeros and ones, and their difference.\"\"\"\n    def __init__(self, startIndex: int, endIndex: int, content: str):\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n        self.content = content\n        self.zeros = 0\n        self.ones = 0\n        self.difference = 0\n\n    def compute_counts(self) -> None:\n        \"\"\"Computes and stores the counts of zeros, ones, and their difference.\"\"\"\n        self.zeros = self.content.count('0')\n        self.ones = self.content.count('1')\n        self.difference = self.zeros - self.ones\n\nclass Result:\n    \"\"\"Holds the maximum difference found across substrings.\"\"\"\n    def __init__(self):\n        # Initialize maxDifference to negative infinity to correctly handle all cases.\n        self.maxDifference = float('-inf')\n\n    def update(self, candidate: int) -> None:\n        \"\"\"Updates the maximum difference if the candidate is greater.\"\"\"\n        if candidate > self.maxDifference:\n            self.maxDifference = candidate\n\nclass FinderService:\n    \"\"\"Provides computation services for finding the maximum difference.\"\"\"\n    def find_length(self, s: str) -> int:\n        \"\"\"Finds the maximum difference between zeros and ones in any substring.\"\"\"\n        if not self.validate(s):\n            # For invalid input, return 0 as per design context's implicit behavior.\n            return 0\n        \n        # Handle empty string case explicitly, as it results in no substrings.\n        if not s:\n            return 0\n\n        result = Result()\n        substrings = self.enumerateSubstrings(s)\n\n        for sub in substrings:\n            diff = self.computeDifference(sub)\n            result.update(diff)\n        \n        # If no valid substrings were processed (e.g., empty string case after validation),\n        # maxDifference might still be -inf, so return 0.\n        if result.maxDifference == float('-inf'):\n            return 0\n\n        return result.maxDifference\n\n    def validate(self, s: str) -> bool:\n        \"\"\"Validates that the string contains only '0' or '1' characters.\"\"\"\n        return all(char in ('0', '1') for char in s)\n\n    def enumerateSubstrings(self, s: str) -> list[Substring]:\n        \"\"\"Enumerates all non-empty substrings of the given string.\"\"\"\n        binary_string = BinaryString(s)\n        substrings = []\n        n = binary_string.length()\n        for i in range(n):\n            for j in range(i, n):\n                content = s[i : j + 1]\n                substrings.append(Substring(i, j, content))\n        return substrings\n\n    def computeDifference(self, sub: Substring) -> int:\n        \"\"\"Ensures counts are computed and returns the difference for a substring.\"\"\"\n        sub.compute_counts()\n        return sub.difference\n\ndef find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and number of 1s\n    in any sub-string of the given binary string.\n    \"\"\"\n    return FinderService().find_length(s)"}
{"task_id": "Mbpp/126", "solution": "import math\n\nclass InputValidator:\n    \"\"\"Responsibility: Validate that provided inputs are positive integers.\"\"\"\n    def is_positive_integer(self, x) -> bool:\n        \"\"\"Return True if x is an int and x > 0, otherwise False.\"\"\"\n        return isinstance(x, int) and x > 0\n\nclass Divisor:\n    \"\"\"Responsibility: Represent a divisor value and provide divisibility check helper logic.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def divides(self, n: int) -> bool:\n        \"\"\"Return True if self.value divides n (n % self.value == 0).\"\"\"\n        return n % self.value == 0\n\nclass Number:\n    \"\"\"Responsibility: Hold an integer value and compute its list of positive divisors.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def divisors(self) -> list:\n        \"\"\"Return a list[int] of positive divisors of self.value (ascending-sorted).\"\"\"\n        divs = set()\n        for i in range(1, int(math.sqrt(self.value)) + 1):\n            if self.value % i == 0:\n                divs.add(i)\n                divs.add(self.value // i)\n        return sorted(list(divs))\n\nclass SumFunction:\n    \"\"\"Responsibility: Compute sum of common positive divisors of two validated integers.\"\"\"\n    def sum(self, a: int, b: int) -> int:\n        \"\"\"Given two positive integers, compute their common positive divisors and return the integer sum.\"\"\"\n        num_a = Number(a)\n        num_b = Number(b)\n\n        divisors_a = set(num_a.divisors())\n        divisors_b = set(num_b.divisors())\n\n        common_divisors = divisors_a.intersection(divisors_b)\n\n        return sum(common_divisors)\n\ndef sum(a, b):\n    \"\"\"Public API: Validate a and b are positive integers and return int sum of their common positive divisors.\"\"\"\n    validator = InputValidator()\n    if not (validator.is_positive_integer(a) and validator.is_positive_integer(b)):\n        raise ValueError('inputs must be positive integers')\n\n    sum_function = SumFunction()\n    return sum_function.sum(a, b)"}
{"task_id": "Mbpp/127", "solution": "class IntegerOperand:\n    \"\"\"Simple data holder for an integer operand.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass Product:\n    \"\"\"Simple data holder for the multiplication result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass MultiplyInt:\n    \"\"\"Encapsulates the multiplication operation.\"\"\"\n    def multiply(self, a: int, b: int) -> int:\n        # Use IntegerOperand wrappers as per design to represent operands.\n        operand_a = IntegerOperand(a)\n        operand_b = IntegerOperand(b)\n        # Perform the multiplication.\n        result_value = operand_a.value * operand_b.value\n        # Wrap the result in a Product object as per design.\n        product_obj = Product(result_value)\n        return product_obj.value\n\ndef multiply_int(a: int, b: int) -> int:\n    \"\"\"\n    Multiplies two integers using the internal MultiplyInt class.\n    This function acts as the public API.\n    \"\"\"\n    # Instantiate the MultiplyInt behavior class.\n    multiplier = MultiplyInt()\n    # Delegate the multiplication to the MultiplyInt instance.\n    product_result = multiplier.multiply(a, b)\n    return product_result"}
{"task_id": "Mbpp/128", "solution": "from typing import List, Optional\n\nclass TextInput:\n    \"\"\"Represents the input text for processing.\"\"\"\n    def __init__(self, content: str) -> None:\n        self.content = content\n\nclass Word:\n    \"\"\"Represents a single word and provides its length.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\nclass ResultList:\n    \"\"\"Container for the filtered words, preserving order.\"\"\"\n    def __init__(self, words: Optional[List[str]] = None) -> None:\n        self.words = [] if words is None else words\n\n    def append(self, word: str) -> None:\n        self.words.append(word)\n\n    def to_list(self) -> List[str]:\n        return self.words\n\n    def count(self) -> int:\n        return len(self.words)\n\nclass WordFilter:\n    \"\"\"Provides stateless filtering logic for words.\"\"\"\n    @staticmethod\n    def long_words(n: int, text_input: TextInput) -> List[str]:\n        tokens = text_input.content.split()\n        result_list = ResultList()\n        for token in tokens:\n            word = Word(token)\n            if word.length() > n:\n                result_list.append(word.value)\n        return result_list.to_list()\n\ndef long_words(n: int, text: str) -> List[str]:\n    \"\"\"\n    Finds words from a given text that are longer than n characters.\n    It tokenizes the text by whitespace and preserves original order and casing.\n    \"\"\"\n    text_input = TextInput(text)\n    return WordFilter.long_words(n, text_input)"}
{"task_id": "Mbpp/130", "solution": "class FrequencyMap:\n    \"\"\"Helper class to count frequencies and track first occurrence index for tie-breaking.\"\"\"\n    def __init__(self):\n        self._counts = {}\n        self._first_index = {}\n\n    def increment(self, item, index):\n        \"\"\"Increments the count for an item and records its first seen index.\"\"\"\n        self._counts[item] = self._counts.get(item, 0) + 1\n        if item not in self._first_index:\n            self._first_index[item] = index\n\n    def get_max(self):\n        \"\"\"Returns the item with the maximum frequency, using first occurrence as a tie-breaker.\"\"\"\n        max_item = None\n        max_count = -1\n        min_first_index = float('inf')\n\n        for item, count in self._counts.items():\n            if count > max_count:\n                max_count = count\n                max_item = item\n                min_first_index = self._first_index[item]\n            elif count == max_count:\n                current_first_index = self._first_index[item]\n                if current_first_index < min_first_index:\n                    max_item = item\n                    min_first_index = current_first_index\n        return max_item, max_count\n\n\ndef max_occurrences(input_list):\n    \"\"\"\n    Finds the item with maximum frequency in a given list.\n    Handles input validation and uses a stable tie-breaker.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list\")\n    if not input_list:\n        raise ValueError(\"input_list must not be empty\")\n\n    fm = FrequencyMap()\n    for index, item in enumerate(input_list):\n        fm.increment(item, index)\n\n    item_with_max_count, _ = fm.get_max()\n    return item_with_max_count"}
