{"task_id": "Mbpp/223", "solution": "def is_majority(sorted_array, n, element):\n    \"\"\"\n    Checks if an element is the majority element within the first 'n' items of a sorted array.\n    The majority element occurs more than n/2 times.\n    \"\"\"\n\n    class Element:\n        \"\"\"Wraps a queried element for centralized equality semantics.\"\"\"\n        def __init__(self, value):\n            self.value = value\n\n        def equals(self, other_value):\n            \"\"\"Performs equality comparison with another value.\"\"\"\n            return self.value == other_value\n\n    class SortedArray:\n        \"\"\"Encapsulates read-only access to an input list and provides slices.\"\"\"\n        def __init__(self, items):\n            self._items = items\n\n        def get_slice(self, count):\n            \"\"\"Returns a slice of the array from index 0 up to 'count'.\"\"\"\n            return self._items[0:count]\n\n        @property\n        def length(self):\n            \"\"\"Returns the total length of the wrapped array.\"\"\"\n            return len(self._items)\n\n    class MajorityChecker:\n        \"\"\"Provides operations to determine majority status.\"\"\"\n        def count_occurrences(self, arr_list, length_limit, elem_val):\n            \"\"\"Counts occurrences of an element within the first 'length_limit' items.\"\"\"\n            sa = SortedArray(arr_list)\n            element_to_check = Element(elem_val)\n            count = 0\n            for item in sa.get_slice(length_limit):\n                if element_to_check.equals(item):\n                    count += 1\n            return count\n\n        def is_majority(self, arr_list, length_limit, elem_val):\n            \"\"\"Determines if the element is a majority element.\"\"\"\n            occurrences = self.count_occurrences(arr_list, length_limit, elem_val)\n            return occurrences > length_limit / 2\n\n    # Delegate to MajorityChecker as per design\n    checker = MajorityChecker()\n    return checker.is_majority(sorted_array, n, element)"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(n: int) -> int:\n    \"\"\"Counts the number of set bits (1s) in a non-negative integer.\n    Assumes valid, non-negative integer input due to strict constraints.\n    \"\"\"\n    count = 0\n    while n > 0:\n        count += (n & 1)\n        n >>= 1\n    return count"}
{"task_id": "Mbpp/230", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised when replacement_char validation fails.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass InputString:\n    \"\"\"Value object for the input string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def is_empty(self) -> bool:\n        return len(self.value) == 0\n\nclass ReplacementChar:\n    \"\"\"Value object for the replacement character.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def is_single_char(self) -> bool:\n        return len(self.value) == 1\n\nclass ResultString:\n    \"\"\"Value object to carry the resulting string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass ReplaceBlankFunction:\n    \"\"\"Encapsulates validation logic and replacement algorithm.\"\"\"\n    @staticmethod\n    def validateReplacementChar(replacement_char_str: str) -> None:\n        \"\"\"Validates that replacement_char is exactly one character long.\"\"\"\n        replacement_char_obj = ReplacementChar(replacement_char_str)\n        if not replacement_char_obj.is_single_char():\n            raise ValidationError(\"replacement_char must be a single character\")\n\n    @staticmethod\n    def replace(input_string_str: str, replacement_char_str: str) -> str:\n        \"\"\"Replaces ASCII spaces in input_string_str with replacement_char_str.\"\"\"\n        return input_string_str.replace(' ', replacement_char_str)\n\ndef replace_blank(input_string: str, replacement_char: str) -> str:\n    \"\"\"\n    Replaces blank spaces in the input string with the given character.\n    Raises ValidationError if replacement_char is not a single character.\n    \"\"\"\n    ReplaceBlankFunction.validateReplacementChar(replacement_char)\n    return ReplaceBlankFunction.replace(input_string, replacement_char)"}
