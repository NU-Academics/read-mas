{"task_id": "Mbpp/739", "solution": "class InputValidator:\n    \"\"\"Validates input parameters.\"\"\"\n    def validate_positive_integer(self, n: int) -> None:\n        \"\"\"Raises ValueError if n is not a positive integer.\"\"\"\n        if not isinstance(n, int) or n < 1:\n            raise ValueError(\"Input 'n' must be a positive integer.\")\n\nclass TriangularNumber:\n    \"\"\"A data container for a triangular number's properties.\"\"\"\n    def __init__(self, index: int, value: int, digits: int) -> None:\n        self.index = index\n        self.value = value\n        self.digits = digits\n\nclass TriangularNumberCalculator:\n    \"\"\"Calculates triangular numbers, counts digits, and searches for indices.\"\"\"\n\n    def _triangular(self, k: int) -> int:\n        \"\"\"Computes the k-th triangular number.\"\"\"\n        return k * (k + 1) // 2\n\n    def _digits(self, x: int) -> int:\n        \"\"\"Counts the number of decimal digits in x.\"\"\"\n        if x == 0:\n            return 1\n        return len(str(x))\n\n    def _search_min_k_for_digits(self, n: int) -> int:\n        \"\"\"\n        Finds the smallest k such that T(k) has exactly n digits.\n        Uses exponential bounding and binary search.\n        \"\"\"\n        # Exponential bounding to find an initial upper limit for k\n        low = 1\n        high = 1\n        while self._digits(self._triangular(high)) < n:\n            low = high\n            high *= 2\n                \n        # Binary search for the smallest k such that T(k) has at least `n` digits\n        ans = high # Initialize `ans` with a value known to satisfy `digits >= n`\n\n        while low <= high:\n            mid = low + (high - low) // 2\n            if mid == 0: # Triangular numbers are defined for k >= 1\n                low = 1\n                continue\n            \n            triangular_val = self._triangular(mid)\n            num_digits = self._digits(triangular_val)\n\n            if num_digits >= n:\n                # `mid` satisfies the condition or is too large, try to find a smaller `k`.\n                ans = mid\n                high = mid - 1\n            else: # num_digits < n\n                # `mid` is too small, need a larger `k`.\n                low = mid + 1\n        \n        return ans\n\n    def find_Index(self, n: int) -> int:\n        \"\"\"\n        Public method to find the index of the smallest triangular number with n digits.\n        Delegates to the internal search logic.\n        \"\"\"\n        return self._search_min_k_for_digits(n)\n\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with exactly n digits.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate_positive_integer(n)\n    calculator = TriangularNumberCalculator()\n    return calculator.find_Index(n)"}
{"task_id": "Mbpp/740", "solution": "from typing import Tuple, Dict\n\ndef tuple_to_dict(t: tuple) -> dict:\n    \"\"\"\n    Converts a tuple to a key-value dictionary using adjacent elements.\n    Raises TypeError for non-tuple input or ValueError for odd-length tuples.\n    \"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    if len(t) % 2 != 0:\n        raise ValueError(\"Tuple must have an even number of elements.\")\n\n    result: Dict = {}\n    for i in range(0, len(t), 2):\n        result[t[i]] = t[i+1]\n    return result"}
{"task_id": "Mbpp/743", "solution": "from typing import List, Any\n\ndef rotate_right(lst: List[Any], n: int) -> List[Any]:\n    \"\"\"\n    Rotates a list to the right by a specified number of items.\n    The function returns a new list and does not modify the input list.\n    \"\"\"\n    list_len = len(lst)\n\n    if list_len == 0:\n        return []\n\n    effective_n = n % list_len\n\n    if effective_n == 0:\n        return lst[:]  # Return a copy if no effective rotation\n\n    # Slice the list into two parts and concatenate them\n    rotated_part = lst[-effective_n:]\n    remaining_part = lst[:-effective_n]\n    \n    return rotated_part + remaining_part"}
