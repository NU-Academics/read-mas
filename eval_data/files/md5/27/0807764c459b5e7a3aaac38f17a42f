{"task_id": "Mbpp/745", "solution": "class Digit:\n    def __init__(self, value: int) -> None:\n        \"\"\"Initializes a Digit object with its integer value.\"\"\"\n        self.value = value\n\nclass Number:\n    def __init__(self, value: int) -> None:\n        \"\"\"Initializes a Number object with its integer value.\"\"\"\n        self.value = value\n\n    def digits(self) -> list:\n        \"\"\"Returns a list of Digit objects representing the decimal digits of the number.\"\"\"\n        if self.value == 0:\n            return [Digit(0)]\n        temp_value = self.value\n        digit_objects = []\n        while temp_value > 0:\n            digit_objects.append(Digit(temp_value % 10))\n            temp_value //= 10\n        return digit_objects[::-1]\n\n    def has_zero(self) -> bool:\n        \"\"\"Returns True if the number contains the digit 0.\"\"\"\n        for digit_obj in self.digits():\n            if digit_obj.value == 0:\n                return True\n        return False\n\n    def divisible_by_all_digits(self) -> bool:\n        \"\"\"Returns True if the number is divisible by all its non-zero digits.\"\"\"\n        for digit_obj in self.digits():\n            digit_val = digit_obj.value\n            if digit_val == 0:\n                continue\n            if self.value % digit_val != 0:\n                return False\n        return True\n\nclass ResultList:\n    def __init__(self) -> None:\n        \"\"\"Initializes an empty list to collect numbers.\"\"\"\n        self.numbers: list[int] = []\n\n    def add(self, n: int) -> None:\n        \"\"\"Adds an integer to the collection.\"\"\"\n        self.numbers.append(n)\n\n    def to_list(self) -> list:\n        \"\"\"Returns the collected numbers as a list.\"\"\"\n        return self.numbers\n\ndef divisible_by_digits(startnum: int, endnum: int) -> list:\n    \"\"\"\n    Finds numbers within a given range (inclusive) where every number is divisible by every digit it contains.\n    Numbers containing the digit 0 are excluded.\n    \"\"\"\n    result_list = ResultList()\n    for num_val in range(startnum, endnum + 1):\n        number_obj = Number(num_val)\n        if number_obj.has_zero():\n            continue\n        if number_obj.divisible_by_all_digits():\n            result_list.add(num_val)\n    return result_list.to_list()"}
