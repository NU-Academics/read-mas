{"task_id": "Mbpp/137", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass Counts:\n    zeroCount: int\n    nonZeroCount: int\n\n    def to_ratio(self) -> float:\n        return self.zeroCount / self.nonZeroCount\n\ndef zero_count(arr: list[int]) -> float:\n    \"\"\"Compute ratio = number of zeros / number of non-zero elements and return as float.\n\n    Behavior for non_zero_count == 0 is not specified in the SRS; this implementation uses Python's division semantics and will raise ZeroDivisionError if nonZeroCount == 0.\n    \"\"\"\n    zero_elements = 0\n    non_zero_elements = 0\n\n    for element in arr:\n        if element == 0:\n            zero_elements += 1\n        else:\n            non_zero_elements += 1\n            \n    counts_obj = Counts(zeroCount=zero_elements, nonZeroCount=non_zero_elements)\n    return counts_obj.to_ratio()"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(n: int) -> bool:\n    \"\"\"Return True if integer n can be represented as a sum of non-zero powers of two.\n\n    Behavior:\n    - Raises TypeError if n is not an int.\n    - Returns True for n > 0.\n    - Returns False for n <= 0.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n > 0:\n        return True\n    else:\n        return False"}
{"task_id": "Mbpp/139", "solution": "import math\n\ndef circle_circumference(radius: float) -> float:\n    \"\"\"Compute circumference = 2 * PI * radius.\n    Validates input radius and raises ValueError for invalid types or negative values.\n    \"\"\"\n    if not isinstance(radius, (int, float)):\n        raise ValueError(\"Radius must be a numeric value (int or float).\")\n    if radius < 0:\n        raise ValueError(\"Radius cannot be negative.\")\n\n    return 2 * math.pi * radius"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(iterables):\n    \"\"\"\n    Flattens a list of lists/tuples into a single set of numbers.\n    Each numeric element from the inner iterables is added to a set, removing duplicates.\n    \"\"\"\n    result_set = set()\n    for inner_iterable in iterables:\n        for element in inner_iterable:\n            result_set.add(element)\n    return result_set"}
{"task_id": "Mbpp/142", "solution": "def compute_min_length(list1, list2, list3) -> int:\n    \"\"\"Calculates the minimum length among three given lists.\"\"\"\n    return min(len(list1), len(list2), len(list3))\n\ndef are_equal(a, b, c) -> bool:\n    \"\"\"Checks if three given items are identical.\"\"\"\n    return a == b and a == c\n\ndef count_samepair(list1, list2, list3) -> int:\n    \"\"\"\n    Counts items that are identical in the same position across three lists.\n    Compares elements up to the minimum length of the three lists.\n    \"\"\"\n    match_count = 0\n    min_len = compute_min_length(list1, list2, list3)\n\n    for i in range(min_len):\n        if are_equal(list1[i], list2[i], list3[i]):\n            match_count += 1\n    return match_count"}
{"task_id": "Mbpp/145", "solution": "from typing import Sequence\n\ndef _validate_sequence(seq: Sequence) -> None:\n    \"\"\"Validates the input sequence for type, non-emptiness, and numeric elements.\"\"\"\n    if not isinstance(seq, (list, tuple)):\n        raise ValueError(\"seq must be a list or tuple\")\n    if len(seq) == 0:\n        raise ValueError(\"seq must contain at least one numeric element\")\n    for element in seq:\n        if not isinstance(element, (int, float)):\n            raise ValueError(\"all elements must be int or float\")\n\ndef max_Abs_Diff(seq: Sequence) -> float:\n    \"\"\"\n    Finds the maximum difference between any two elements in a given numeric sequence.\n    Returns 0.0 for a single-element sequence and raises ValueError for invalid inputs.\n    \"\"\"\n    _validate_sequence(seq)\n\n    if len(seq) == 1:\n        return 0.0\n\n    min_val = min(seq)\n    max_val = max(seq)\n\n    return float(max_val - min_val)"}
{"task_id": "Mbpp/141", "solution": "class SortError(Exception):\n    \"\"\"Exception class representing comparability validation failures.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass ErrorHandler:\n    \"\"\"Centralized creation/raising of SortError with consistent message format.\"\"\"\n    @staticmethod\n    def raise_sort_error(message: str) -> None:\n        raise SortError(message)\n\nclass Validator:\n    \"\"\"Validate that input list elements are mutually comparable; raise SortError on failure.\"\"\"\n    @staticmethod\n    def validate_comparable(lst: list) -> None:\n        if len(lst) < 2:\n            return\n\n        # Attempt to compare two elements to check for basic comparability.\n        # This check is not exhaustive but catches common type mismatches early.\n        try:\n            # Try comparing the first two distinct elements if possible, or any two.\n            # This relies on Python's comparison operators raising TypeError for incompatible types.\n            if lst[0] is not None and lst[1] is not None:\n                _ = lst[0] < lst[1]\n                _ = lst[0] == lst[1]\n        except TypeError:\n            ErrorHandler.raise_sort_error(\"Elements in the list are not mutually comparable.\")\n        except Exception as e:\n            ErrorHandler.raise_sort_error(f\"Error during initial comparability check: {e}\")\n\nclass Element:\n    \"\"\"Per-element container for value and optional original_index (traceability).\"\"\"\n    def __init__(self, value, original_index=None):\n        self._value = value\n        self._original_index = original_index\n\n    def get_value(self):\n        return self._value\n\nclass InputList:\n    \"\"\"Conceptual wrapper for input collection; preserves multiplicity and optional original indices.\"\"\"\n    def __init__(self, elements: list):\n        self._elements = [Element(e, i) for i, e in enumerate(elements)]\n\n    def to_list(self) -> list:\n        return [e.get_value() for e in self._elements]\n\nclass SortResult:\n    \"\"\"Conceptual wrapper containing sorted_list and order metadata.\"\"\"\n    def __init__(self, sorted_list: list, order: str = \"ascending\"):\n        self._sorted_list = sorted_list\n        self._order = order\n\n    def get_sorted_list(self) -> list:\n        return self._sorted_list\n\nclass PancakeSorter:\n    \"\"\"Encapsulate pancake sort algorithm (find prefix maximum, flip prefix, repeat).\"\"\"\n\n    def pancake_sort(self, lst: list) -> list:\n        \"\"\"\n        Sorts a list using the pancake sort algorithm.\n        Operates on a copy of the input list.\n        \"\"\"\n        n = len(lst)\n        if n <= 1:\n            return list(lst)\n\n        arr = list(lst) # Work on a copy of the list\n\n        for curr_size in range(n, 1, -1):\n            try:\n                # Find the index of the maximum element in the current prefix arr[0...curr_size-1]\n                max_idx = self._find_max_index(arr, curr_size)\n\n                # If the maximum element is not already at its correct position\n                if max_idx != curr_size - 1:\n                    # Move the maximum element to the beginning\n                    self._flip(arr, max_idx)\n\n                    # Move the maximum element to its final position\n                    self._flip(arr, curr_size - 1)\n            except TypeError:\n                ErrorHandler.raise_sort_error(\"Elements in the list are not mutually comparable during sorting.\")\n            except Exception as e:\n                ErrorHandler.raise_sort_error(f\"An unexpected error occurred during sorting: {e}\")\n        return arr\n\n    def _flip(self, lst: list, k: int) -> None:\n        \"\"\"\n        Reverses the prefix of the list up to index k (inclusive) in-place.\n        \"\"\"\n        # Python's slice assignment is an efficient way to reverse a prefix.\n        lst[:k+1] = lst[:k+1][::-1]\n\n    def _find_max_index(self, lst: list, n: int) -> int:\n        \"\"\"\n        Finds the index of the maximum element in the prefix of the list of size n.\n        \"\"\"\n        if n <= 0:\n            raise ValueError(\"Prefix size n must be greater than 0\")\n\n        max_val = lst[0]\n        max_idx = 0\n        for i in range(1, n):\n            if lst[i] > max_val: # This comparison can raise TypeError if elements are not comparable.\n                max_val = lst[i]\n                max_idx = i\n        return max_idx\n\ndef pancake_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a list of elements using the pancake sort algorithm.\n    Raises SortError if elements are not mutually comparable.\n    \"\"\"\n    _ = InputList(input_list) # Conceptual wrapper for traceability, not directly used by algorithm.\n\n    # Validate comparability of elements before starting the sort.\n    Validator.validate_comparable(input_list)\n\n    # Delegate to PancakeSorter for the actual sorting logic.\n    sorter = PancakeSorter()\n    sorted_raw_list = sorter.pancake_sort(input_list)\n\n    # Wrap the result in SortResult for conceptual traceability and extract raw list.\n    sort_result = SortResult(sorted_raw_list)\n    return sort_result.get_sorted_list()"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(source_list, elements_to_remove):\n    \"\"\"\n    Returns a new list with elements from source_list, removing all occurrences of values found in elements_to_remove.\n    Preserves order of remaining elements and handles empty input lists as specified.\n    \"\"\"\n    if not source_list:\n        return []\n    if not elements_to_remove:\n        return source_list.copy()\n\n    result = []\n    for item in source_list:\n        include = True\n        for rem_item in elements_to_remove:\n            if item == rem_item:\n                include = False\n                break\n        if include:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/162", "solution": "class SeriesTerm:\n    \"\"\"Represents a term in the series with its index and calculated value.\"\"\"\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\n\nclass Result:\n    \"\"\"Container for the final integer sum of the series.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\ndef compute_terms(n: int) -> list:\n    \"\"\"Generates a list of SeriesTerm objects for the given n.\"\"\"\n    terms = []\n    # Loop from i = 0 up to n // 2, inclusive.\n    for i in range(n // 2 + 1):\n        value = n - 2 * i\n        terms.append(SeriesTerm(index=i, value=value))\n    return terms\n\nclass SumSeriesFunction:\n    \"\"\"Encapsulates the logic for computing the sum of the series.\"\"\"\n    def sum_series(self, n: int) -> int:\n        \"\"\"Computes the sum of the series (n - 2*i) for i=0 to n//2.\"\"\"\n        series_terms = self.compute_terms(n)\n        total_sum = 0\n        for term in series_terms:\n            total_sum += term.value\n        return Result(total_sum).value\n\n    def compute_terms(self, n: int) -> list:\n        \"\"\"Delegates to the module-level compute_terms function.\"\"\"\n        return compute_terms(n)\n\ndef sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) from i=0 to n // 2.\n    For instance n + (n-2) + (n-4)... (until n-x <= 0).\n    \"\"\"\n    # Delegate the computation to an instance of SumSeriesFunction.\n    return SumSeriesFunction().sum_series(n)"}
{"task_id": "Mbpp/160", "solution": "def gcd(a: int, b: int) -> int:\n    \"\"\"\n    Computes the greatest common divisor of two integers using the Euclidean algorithm.\n    Returns the non-negative gcd(|a|, |b|).\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n    while b:\n        a, b = b, a % b\n    return a\n\ndef extended_gcd(a: int, b: int) -> tuple[int, int, int]:\n    \"\"\"\n    Computes (g, x, y) such that a*x + b*y = g, where g is gcd(a, b).\n    This is based on the Extended Euclidean Algorithm.\n    \"\"\"\n    if b == 0:\n        # Base case: gcd(a, 0) = |a|.\n        # We need a*x + 0*y = |a|.\n        # If a is 0, (0, 0, 0) is returned.\n        # If a is non-zero, x is 1 if a > 0, -1 if a < 0. y can be 0.\n        return (abs(a), 1 if a > 0 else (-1 if a < 0 else 0), 0)\n    \n    g, x_prime, y_prime = extended_gcd(b, a % b)\n    x = y_prime\n    y = x_prime - (a // b) * y_prime\n    return (g, x, y)\n\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integer solutions (x, y) to the linear Diophantine equation ax + by = n.\n    Returns (x, y) as a tuple, or None if no solution exists.\n    \"\"\"\n    # Handle the special case where both a and b are zero.\n    # If a=0, b=0: 0*x + 0*y = n. This means n must be 0 for a solution to exist.\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    # Compute the greatest common divisor of a and b.\n    common_divisor = gcd(a, b)\n\n    # A solution exists if and only if n is divisible by gcd(a, b).\n    if n % common_divisor != 0:\n        return None\n\n    # Use the extended Euclidean algorithm to find a particular solution (x0, y0)\n    # for the equation a*x0 + b*y0 = common_divisor.\n    # The returned g from extended_gcd should be equal to common_divisor.\n    g, x0, y0 = extended_gcd(a, b)\n\n    # Scale the particular solution (x0, y0) to solve a*x + b*y = n.\n    scale_factor = n // g\n    x_particular = x0 * scale_factor\n    y_particular = y0 * scale_factor\n\n    # Normalize the solution to meet specific test case requirements if needed.\n    # The general solution is (x_p + k*(b/g), y_p - k*(a/g)).\n    # We aim to find k such that x is minimal non-negative (0 <= x < abs(b/g)).\n    if b != 0:\n        # Calculate the modulus for x normalization. Ensure it's non-zero.\n        # Python's % operator handles negative numbers consistently for this context.\n        b_prime = b // g\n        \n        # Calculate x_candidate, which is x_particular modulo b_prime.\n        # This gives a value in range (b_prime, 0] if b_prime is negative, or [0, b_prime-1] if b_prime is positive.\n        x_candidate = x_particular % b_prime\n        \n        # Ensure x_candidate is non-negative if b_prime is positive\n        # This handles cases where x_particular is negative, e.g., -7 % 3 = 2.\n        # If b_prime is negative, x_candidate will be negative or zero,\n        # which is correct for range [b_prime+1, 0].\n        if b_prime > 0 and x_candidate < 0:\n             x_candidate += b_prime # Adjust to be within [0, b_prime-1]\n\n        # Recalculate y based on the normalized x to maintain the equation.\n        y_candidate = (n - a * x_candidate) // b\n        return (x_candidate, y_candidate)\n    \n    # If b is 0, the equation is a*x = n. x is simply n/a.\n    # y can be any integer; the extended_gcd gives 0 for y_particular.\n    # The scaling already produced (n/a, 0), so no further normalization is needed.\n    return (x_particular, y_particular)"}
{"task_id": "Mbpp/165", "solution": "ALPHABET = \"abcdefghijklmnopqrstuvwxyz\"\n\ndef isLetter(c):\n    \"\"\"Return True if c is an ASCII English alphabet character (a\u2013z or A\u2013Z); otherwise False.\"\"\"\n    return 'a' <= c.lower() <= 'z'\n\ndef toLower(c):\n    \"\"\"Return the lowercase equivalent of a single character c (string).\"\"\"\n    return c.lower()\n\ndef count_char_position(input_string):\n    \"\"\"Return int: number of characters in input_string that match the English alphabet letter at the same 1-based position (case-insensitive).\"\"\"\n    match_count = 0\n    for i, char in enumerate(input_string):\n        pos = i + 1 # 1-based position for the current character\n\n        if not isLetter(char):\n            continue\n\n        if pos > 26: # Positions beyond 'z' (26) are not eligible for matching\n            continue\n\n        expected_char = ALPHABET[pos - 1]\n        \n        if toLower(char) == expected_char:\n            match_count += 1\n            \n    return match_count"}
{"task_id": "Mbpp/167", "solution": "class PowerOfTwoCalculator:\n    \"\"\"Helper class that computes next power-of-two values.\"\"\"\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Return the smallest power-of-two integer >= n.\n        If n == 0 this method returns 1 (caller may handle zero case earlier).\n        \"\"\"\n        if n == 0:\n            return 1\n        return 1 << (n - 1).bit_length()\n\ndef next_power_of_2(n) -> int:\n    \"\"\"\n    Returns the smallest power of two greater than or equal to n.\n    Returns 1 when n == 0, otherwise computes via PowerOfTwoCalculator.\n    \"\"\"\n    if n == 0:\n        return 1\n    return PowerOfTwoCalculator().compute(n)"}
{"task_id": "Mbpp/166", "solution": "from src.domain import IntegerList, IntegerElement\n\ndef find_even_pair(input_list: list[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list where their bitwise XOR is an even number.\n    Returns 0 for invalid input or if the list has fewer than two elements.\n    \"\"\"\n    ilist = IntegerList(input_list)\n\n    if not ilist.validate():\n        return 0\n\n    even_count = 0\n    odd_count = 0\n\n    for element in ilist.elements:\n        if element.isOdd():\n            odd_count += 1\n        else:\n            even_count += 1\n\n    # Calculate combinations C(n, 2) = n * (n - 1) // 2\n    # Even XOR Even = Even\n    # Odd XOR Odd = Even\n    # Even XOR Odd = Odd\n    # We sum the combinations of even numbers and combinations of odd numbers.\n    result = (even_count * (even_count - 1) // 2) + \\\n             (odd_count * (odd_count - 1) // 2)\n\n    return result"}
{"task_id": "Mbpp/170", "solution": "from dataclasses import dataclass\nfrom typing import List, Union\n\n@dataclass\nclass NumberList:\n    elements: List[Union[int, float]]\n\n@dataclass\nclass IndexRange:\n    start_index: int\n    end_index: int\n\n@dataclass\nclass SumResult:\n    value: Union[int, float]\n\nclass SumRangeFunction:\n    \"\"\"Encapsulates the summation operation for a given range.\"\"\"\n    def sum_range_list(self, list_elements: List[Union[int, float]], start_index: int, end_index: int) -> Union[int, float]:\n        \"\"\"\n        Computes the inclusive sum of numbers within a specified range.\n        Assumes valid zero-based indices within the list.\n        \"\"\"\n        current_sum = 0\n        for i in range(start_index, end_index + 1):\n            current_sum += list_elements[i]\n        return current_sum\n\ndef sum_range_list(list: List[Union[int, float]], start_index: int, end_index: int) -> Union[int, float]:\n    \"\"\"\n    Finds the sum of numbers in a list within a range specified by two indices.\n    Delegates the core computation to SumRangeFunction.\n    \"\"\"\n    calculator = SumRangeFunction()\n    return calculator.sum_range_list(list, start_index, end_index)"}
{"task_id": "Mbpp/168", "solution": "from typing import Sequence, Any\n\ndef frequency(list: Sequence[Any], value: Any) -> int:\n    \"\"\"\n    Counts the number of occurrences of a value in a given list.\n    Performs a single pass with O(n) time and O(1) extra space.\n    \"\"\"\n    count = 0\n    for element in list:\n        if element == value:\n            count += 1\n    return count"}
