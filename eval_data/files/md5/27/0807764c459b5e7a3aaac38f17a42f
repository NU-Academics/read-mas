{"task_id": "Mbpp/105", "solution": "class CountFunction:\n    \"\"\"Internal class to encapsulate counting logic and validation.\"\"\"\n\n    def validate_input(self, items: list) -> bool:\n        \"\"\"Validates input. Always returns True given current constraints.\"\"\"\n        # Per problem constraints, specific isinstance() checks for the input list 'items' are omitted.\n        return True\n\n    def iterate_and_count(self, items: list) -> int:\n        \"\"\"Iterates through the list and counts True boolean values.\"\"\"\n        true_count = 0\n        for elem in items:\n            # Count only elements that are of Python bool type and whose value is True.\n            if isinstance(elem, bool) and elem is True:\n                true_count += 1\n        return true_count\n\n    def count(self, items: list) -> int:\n        \"\"\"Orchestrates validation and counting for a given list.\"\"\"\n        self.validate_input(items)\n        return self.iterate_and_count(items)\n\ndef count(items: list) -> int:\n    \"\"\"Counts the number of True booleans in the given list.\"\"\"\n    return CountFunction().count(items)"}
{"task_id": "Mbpp/108", "solution": "import collections\nfrom typing import List\n\ndef merge_sorted_list(list1: List[int], list2: List[int], list3: List[int]) -> List[int]:\n    \"\"\"\n    Merges three lists into a single sorted list.\n    Validates inputs, combines elements, and sorts the result in non-decreasing order.\n    \"\"\"\n    _validate_inputs(list1, list2, list3)\n    merged = _merge_three_lists(list1, list2, list3)\n    sorted_merged = _sort_merged_list(merged)\n    return sorted_merged\n\ndef _validate_inputs(list1: List[int], list2: List[int], list3: List[int]) -> None:\n    \"\"\"\n    Validates that all inputs are lists and contain only integer elements.\n    Raises TypeError if any input is invalid.\n    \"\"\"\n    for i, lst in enumerate([list1, list2, list3]):\n        if not isinstance(lst, list):\n            raise TypeError(f\"Argument {i+1} must be a list, but received {type(lst)}\")\n        for j, item in enumerate(lst):\n            if not isinstance(item, int):\n                raise TypeError(f\"List {i+1} contains non-integer element at index {j}: {item} (type {type(item)})\")\n\ndef _merge_three_lists(list1: List[int], list2: List[int], list3: List[int]) -> List[int]:\n    \"\"\"\n    Combines elements from three input lists into a single new list, preserving duplicates.\n    \"\"\"\n    return list1 + list2 + list3\n\ndef _sort_merged_list(merged: List[int]) -> List[int]:\n    \"\"\"\n    Sorts the given list in non-decreasing (ascending) order.\n    Returns a new sorted list.\n    \"\"\"\n    return sorted(merged)"}
{"task_id": "Mbpp/111", "solution": "\"\"\"Implementation of common_in_nested_lists as specified in the SRS.\"\"\"\nfrom typing import List, Union, Iterable, Set, Any\n\nclass ResultCollection:\n    \"\"\"\n    A lightweight wrapper around a set to represent the collection of common elements.\n    Provides iteration and length checking, with order not significant.\n    \"\"\"\n    def __init__(self, elements: Set[Any]):\n        self._elements = elements\n\n    def __iter__(self) -> Iterable[Any]:\n        \"\"\"Allows iteration over the unique common elements.\"\"\"\n        return iter(self._elements)\n\n    def as_iterable(self) -> Iterable[Any]:\n        \"\"\"Returns an iterator over the unique common elements.\"\"\"\n        return iter(self._elements)\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of unique common elements.\"\"\"\n        return len(self._elements)\n\ndef _validate_input(nested_lists: Union[List, tuple]):\n    \"\"\"\n    Validates that the input is a list/tuple of lists/tuples.\n    Raises TypeError for invalid input.\n    \"\"\"\n    if not isinstance(nested_lists, (list, tuple)):\n        raise TypeError(\"Input 'nested_lists' must be a list or tuple.\")\n    for i, sublist in enumerate(nested_lists):\n        if not isinstance(sublist, (list, tuple)):\n            raise TypeError(f\"Element at index {i} of 'nested_lists' must be a list or tuple, got {type(sublist).__name__}.\")\n\ndef _normalize_to_sets(nested_lists: Union[List, tuple]) -> List[Set[Any]]:\n    \"\"\"\n    Converts each sublist within the nested_lists into a set.\n    \"\"\"\n    return [set(sublist) for sublist in nested_lists]\n\ndef common_in_nested_lists(nested_lists: Union[List, tuple]) -> ResultCollection:\n    \"\"\"\n    Finds the common elements in given nested lists.\n    Returns a ResultCollection containing exactly the elements present in every sublist.\n    \"\"\"\n    _validate_input(nested_lists)\n    \n    normalized_sets = _normalize_to_sets(nested_lists)\n\n    if not normalized_sets:\n        # If the input list of lists is empty, the intersection is an empty set.\n        common_elements = set()\n    else:\n        # Initialize common_elements with the first set and intersect with the rest.\n        common_elements = normalized_sets[0]\n        for s in normalized_sets[1:]:\n            common_elements.intersection_update(s)\n\n    return ResultCollection(common_elements)"}
{"task_id": "Mbpp/113", "solution": "import re\n\nclass DigitPattern:\n    \"\"\"Encapsulates the regex pattern for integer checking.\"\"\"\n    regex: str = \"^[0-9]+$\"\n\n    def matches(self, input_str: str) -> bool:\n        \"\"\"Checks if the input string fully matches the digit pattern.\"\"\"\n        return re.fullmatch(self.regex, input_str) is not None\n\nclass StringInput:\n    \"\"\"Data holder for the input string and its length.\"\"\"\n    def __init__(self, value: str):\n        self.value: str = value\n        self.length: int = len(value)\n\nclass ValidationResult:\n    \"\"\"Data holder for the integer validation result.\"\"\"\n    def __init__(self, is_integer: bool):\n        self.is_integer: bool = is_integer\n\nclass CheckIntegerFunction:\n    \"\"\"Encapsulates the core logic for integer string validation.\"\"\"\n    def check_integer(self, input_str: str) -> bool:\n        \"\"\"Public method to check if a string represents an integer.\"\"\"\n        validation_result = self.validate_input(input_str)\n        return validation_result.is_integer\n\n    def validate_input(self, input_str: str) -> ValidationResult:\n        \"\"\"Validates the input string against the integer rules.\"\"\"\n        _ = StringInput(input_str) # Create StringInput as per design, even if its properties aren't directly used here.\n        is_integer = self._is_all_digits(input_str)\n        return ValidationResult(is_integer)\n\n    def _is_all_digits(self, input_str: str) -> bool:\n        \"\"\"Helper to determine if the string consists solely of digits.\"\"\"\n        digit_pattern = DigitPattern()\n        return digit_pattern.matches(input_str)\n\ndef check_integer(input: str) -> bool:\n    \"\"\"\n    Checks if a string represents an integer (one or more ASCII digits).\n    Returns True if the string contains only digits, False otherwise.\n    \"\"\"\n    validator = CheckIntegerFunction()\n    return validator.check_integer(input)"}
