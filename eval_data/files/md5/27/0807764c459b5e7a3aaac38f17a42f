{"task_id": "Mbpp/454", "solution": "import string\nfrom typing import List\n\nPUNCTUATION_CHARS = set(string.punctuation)\n\ndef _strip_surrounding_punctuation(token: str) -> str:\n    \"\"\"\n    Removes leading/trailing punctuation characters from tokens.\n    Returns the normalized token (empty string if fully stripped).\n    \"\"\"\n    start = 0\n    while start < len(token) and token[start] in PUNCTUATION_CHARS:\n        start += 1\n\n    end = len(token) - 1\n    while end >= start and token[end] in PUNCTUATION_CHARS:\n        end -= 1\n\n    return token[start : end + 1]\n\ndef _word_contains_lowercase_z(token: str) -> bool:\n    \"\"\"\n    Inspects a normalized token for the presence of lowercase 'z'.\n    Returns True if 'z' is found, otherwise False.\n    \"\"\"\n    return 'z' in token\n\ndef _tokenize(text: str) -> List[str]:\n    \"\"\"\n    Splits input text into token strings, preserving surrounding punctuation.\n    Tokens are separated by whitespace.\n    \"\"\"\n    return text.split()\n\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Matches a word containing 'z' in the given text.\n    It returns True if at least one word, after stripping surrounding punctuation, contains 'z'.\n    \"\"\"\n    tokens = _tokenize(text)\n    for token in tokens:\n        normalized_token = _strip_surrounding_punctuation(token)\n        if _word_contains_lowercase_z(normalized_token):\n            return True\n    return False"}
{"task_id": "Mbpp/455", "solution": "from typing import Optional\n\nclass InputValidator:\n    \"\"\"Validates if a month number is within the valid range 1 to 12.\"\"\"\n    def is_valid_month(self, monthNumber: int) -> bool:\n        # Assumes monthNumber is an integer, as per prompt requirements.\n        return 1 <= monthNumber <= 12\n\nclass MonthCheckService:\n    \"\"\"Service to determine if a month has 31 days, using an input validator.\"\"\"\n    _thirty_one_day_months: set[int] = {1, 3, 5, 7, 8, 10, 12}\n    _validator: InputValidator\n\n    def __init__(self, validator: Optional[InputValidator] = None) -> None:\n        self._validator = validator if validator is not None else InputValidator()\n\n    def check_monthnumb_number(self, monthNumber: int) -> bool:\n        # If the month number is not valid, it does not have 31 days.\n        if not self._validator.is_valid_month(monthNumber):\n            return False\n        # Check if the valid month number is in the set of 31-day months.\n        return monthNumber in self._thirty_one_day_months\n\n# Instantiate the service at the module level for the public API function.\n_service = MonthCheckService()\n\ndef check_monthnumb_number(monthNumber: int) -> bool:\n    \"\"\"\n    Checks whether the given month number contains 31 days.\n    Input `monthNumber` is assumed to be an integer.\n    \"\"\"\n    return _service.check_monthnumb_number(monthNumber)"}
{"task_id": "Mbpp/456", "solution": "from typing import List\n\nclass StringListProcessor:\n    \"\"\"\n    Domain service implementing the core string list reversal operation.\n    It is stateless and uses built-in Python operations for efficiency.\n    \"\"\"\n    def reverse_string_list(self, inputList: List[str]) -> List[str]:\n        \"\"\"\n        Reverses each string in the input list, preserving order.\n        Handles empty strings and empty lists correctly.\n        \"\"\"\n        return [s[::-1] for s in inputList]\n\ndef reverse_string_list(inputList: List[str]) -> List[str]:\n    \"\"\"\n    Reverses each string in a given list of string values.\n    Delegates the core logic to a StringListProcessor instance.\n    \"\"\"\n    processor = StringListProcessor()\n    return processor.reverse_string_list(inputList)"}
{"task_id": "Mbpp/457", "solution": "class Sublist:\n    \"\"\"Wraps a sublist and its original position.\"\"\"\n    def __init__(self, items, position):\n        self.items = items\n        self.position = position\n\n    def length(self):\n        \"\"\"Returns the length of the sublist.\"\"\"\n        return len(self.items)\n\nclass InputList:\n    \"\"\"Helper class for validating and iterating the input list of sublists.\"\"\"\n    def __init__(self, raw_list):\n        self._sublists = raw_list\n\n    def is_valid(self):\n        \"\"\"Checks if every element of the internal list is itself a list.\"\"\"\n        return all(isinstance(sublist, list) for sublist in self._sublists)\n\n    def is_empty(self):\n        \"\"\"Checks if the internal list is empty.\"\"\"\n        return len(self._sublists) == 0\n\n    def iter_sublists(self):\n        \"\"\"Yields Sublist objects, preserving original order and position.\"\"\"\n        for i, sublist in enumerate(self._sublists):\n            yield Sublist(sublist, i)\n\ndef Find_Min(input_list):\n    \"\"\"Return one of the sublists in input_list that has minimum length.\n\n    Raises:\n      TypeError: if input_list is not a list or any element is not a list.\n      ValueError: if input_list is empty.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError('input_list must be a list of lists')\n\n    input_list_wrapper = InputList(input_list)\n\n    if input_list_wrapper.is_empty():\n        raise ValueError('input_list must contain at least one sublist')\n\n    if not input_list_wrapper.is_valid():\n        raise TypeError('every element of input_list must be a list')\n\n    min_length = float('inf')\n    min_sublist = None\n\n    for sublist_obj in input_list_wrapper.iter_sublists():\n        current_length = sublist_obj.length()\n        if current_length < min_length:\n            min_length = current_length\n            min_sublist = sublist_obj.items\n    \n    return min_sublist"}
{"task_id": "Mbpp/459", "solution": "class Character:\n    \"\"\"Represents a single character and provides a method to check if it's uppercase.\"\"\"\n    def __init__(self, char: str):\n        self.char = char\n\n    def isUppercase(self) -> bool:\n        \"\"\"Returns True if the character is an ASCII uppercase letter (A-Z), False otherwise.\"\"\"\n        return 'A' <= self.char <= 'Z'\n\nclass InputString:\n    \"\"\"A domain container for the input string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass OutputString:\n    \"\"\"A domain container for the resulting output string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass RemoveUppercaseFunction:\n    \"\"\"Implements the algorithm to remove uppercase ASCII characters from a string.\"\"\"\n    def remove_uppercase(self, input_string: InputString) -> OutputString:\n        \"\"\"Processes the input string to remove uppercase characters, preserving order.\"\"\"\n        result_chars = []\n        for char_str in input_string.value:\n            char_obj = Character(char_str)\n            if not char_obj.isUppercase():\n                result_chars.append(char_str)\n        return OutputString(\"\".join(result_chars))\n\ndef remove_uppercase(input_str: str) -> str:\n    \"\"\"\n    Removes uppercase ASCII letters (A-Z) from the given string, preserving the order\n    of all other characters.\n    \"\"\"\n    input_domain_obj = InputString(input_str)\n    remover = RemoveUppercaseFunction()\n    output_domain_obj = remover.remove_uppercase(input_domain_obj)\n    return output_domain_obj.value"}
{"task_id": "Mbpp/460", "solution": "def _validate_list_of_lists(list_of_lists) -> None:\n    \"\"\"\n    Validates that the input is a list, and each element is a non-empty list.\n    Raises ValueError on validation failure.\n    \"\"\"\n    if not isinstance(list_of_lists, list):\n        raise ValueError(\"Input must be a list.\")\n    for i, sublist in enumerate(list_of_lists):\n        if not isinstance(sublist, list):\n            raise ValueError(f\"Element at index {i} is not a list.\")\n        if not sublist:\n            raise ValueError(f\"Empty sublist detected at index {i}.\")\n\ndef Extract(list_of_lists) -> list:\n    \"\"\"\n    Extracts the first element from each sublist in the input list, preserving order.\n    Raises ValueError if the input is not a list of non-empty lists.\n    \"\"\"\n    _validate_list_of_lists(list_of_lists)\n    return [sublist[0] for sublist in list_of_lists]"}
{"task_id": "Mbpp/465", "solution": "def drop_empty(input_dict):\n    \"\"\"Validate and filter out None-valued entries from a dictionary.\n    Returns a new dictionary with items whose values are not None.\"\"\"\n    if not isinstance(input_dict, dict):\n        raise TypeError(\"drop_empty expects a dictionary input\")\n    return {k: v for k, v in input_dict.items() if v is not None}"}
{"task_id": "Mbpp/463", "solution": "from typing import Union\n\ndef max_subarray_product(values: list[int]) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray in the given list of integers.\n    Handles positive, negative, and zero values by tracking both maximum and minimum products ending at the current position.\n    \"\"\"\n    if not values:\n        raise ValueError(\"input list must contain at least one element\")\n\n    max_ending_here = values[0]\n    min_ending_here = values[0]\n    global_max = values[0]\n\n    for x in values[1:]:\n        if x < 0:\n            max_ending_here, min_ending_here = min_ending_here, max_ending_here\n\n        max_ending_here = max(x, max_ending_here * x)\n        min_ending_here = min(x, min_ending_here * x)\n\n        global_max = max(global_max, max_ending_here)\n\n    return global_max"}
{"task_id": "Mbpp/462", "solution": "from typing import List, Any\n\ndef _subset_for_mask(mask: int, input_list: List[Any], n: int) -> List[Any]:\n    \"\"\"\n    Constructs a single subset for a given mask, with elements ordered by descending original index.\n    \"\"\"\n    subset = []\n    # Iterate indices from n-1 down to 0 to ensure descending original index order\n    for i in range(n - 1, -1, -1):\n        # Check if the i-th bit in the mask is set\n        if (mask >> i) & 1:\n            subset.append(input_list[i])\n    return subset\n\ndef combinations_list(input_list: List[Any]) -> List[List[Any]]:\n    \"\"\"\n    Finds all possible combinations (power set) of the elements of a given list,\n    ordered by mask enumeration and descending original index within subsets.\n    \"\"\"\n    n = len(input_list)\n    result = []\n    # Iterate through all possible masks from 0 to 2^n - 1\n    for mask in range(0, 1 << n):\n        subset = _subset_for_mask(mask, input_list, n)\n        result.append(subset)\n    return result"}
{"task_id": "Mbpp/471", "solution": "from typing import List\n\ndef _compute_product(array: List[int]) -> int:\n    \"\"\"\n    Computes the product of all integer elements in the given array.\n    This helper assumes the array contains only integers.\n    \"\"\"\n    product = 1\n    for x in array:\n        product *= x\n    return product\n\ndef find_remainder(array: List[int], n: int) -> int:\n    \"\"\"\n    Finds the product of the array elements and then computes this product modulo n.\n    This function expects 'array' to be a list of integers and 'n' to be a non-zero integer.\n    \"\"\"\n    product = _compute_product(array)\n    remainder = product % n\n    return remainder"}
{"task_id": "Mbpp/468", "solution": "import math\n\ndef _find_increasing_runs(arr: list) -> list:\n    \"\"\"Scans the array and identifies all increasing contiguous runs.\"\"\"\n    if not arr:\n        return []\n\n    runs = []\n    current_run_start_index = 0\n    for i in range(1, len(arr)):\n        if arr[i] <= arr[i-1]:  # Current element is not strictly greater than previous\n            runs.append(arr[current_run_start_index:i])\n            current_run_start_index = i\n    # Add the last run\n    runs.append(arr[current_run_start_index:len(arr)])\n    return runs\n\ndef _product_of_sequence(seq: list) -> float:\n    \"\"\"Computes the product of elements in a given sequence.\"\"\"\n    product = 1.0\n    for x in seq:\n        product *= x\n    return product\n\ndef max_product(arr: list) -> float:\n    \"\"\"Finds the maximum product formed by multiplying numbers of an increasing contiguous subsequence.\"\"\"\n    if not arr:\n        return -math.inf\n\n    runs = _find_increasing_runs(arr)\n    \n    max_prod = -math.inf \n\n    for run in runs:\n        current_prod = _product_of_sequence(run)\n        if current_prod > max_prod:\n            max_prod = current_prod\n            \n    return max_prod"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(lst: list) -> bool:\n    \"\"\"Return True if lst is a strictly increasing consecutive integer list, else False.\n    An empty or single-element list is not considered to contain consecutive numbers.\n    \"\"\"\n    if len(lst) < 2:\n        return False\n\n    for i in range(1, len(lst)):\n        if lst[i] != lst[i-1] + 1:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/470", "solution": "def _validate_input(input: object) -> None:\n    \"\"\"\n    Validates that the input is a tuple and all its elements are numeric.\n    Raises TypeError for invalid input.\n    \"\"\"\n    if not isinstance(input, tuple):\n        raise TypeError(\"input must be a tuple of numeric elements\")\n    for element in input:\n        if not isinstance(element, (int, float)):\n            raise TypeError(\"all elements must be int or float\")\n\ndef _compute_pairwise(input: tuple[float | int, ...]) -> tuple[float | int, ...]:\n    \"\"\"\n    Computes pairwise sums of neighboring elements in the tuple.\n    Returns an empty tuple if the input has fewer than two elements.\n    \"\"\"\n    if len(input) < 2:\n        return ()\n    return tuple(a + b for a, b in zip(input, input[1:]))\n\ndef add_pairwise(input: tuple[float | int, ...]) -> tuple[float | int, ...]:\n    \"\"\"\n    Finds the pairwise addition of the neighboring elements of the given tuple.\n    This function validates the input and computes the sums.\n    \"\"\"\n    _validate_input(input)\n    return _compute_pairwise(input)"}
{"task_id": "Mbpp/473", "solution": "def tuple_intersection(list_a, list_b) -> set:\n    \"\"\"\n    Finds the order-insensitive intersection of tuples from list_a and list_b.\n    Returns a set of unique tuples from list_a that have matches in list_b, preserving their original form.\n    \"\"\"\n\n    def _normalize_to_key(t):\n        \"\"\"\n        Produces an order-insensitive canonical key for a 2-element tuple.\n        Raises ValueError if t is not a 2-element tuple.\n        \"\"\"\n        if not isinstance(t, tuple) or len(t) != 2:\n            raise ValueError(\"Elements must be 2-element tuples.\")\n        return tuple(sorted(t))\n\n    if not hasattr(list_a, '__iter__') or not hasattr(list_b, '__iter__'):\n        raise ValueError(\"Both inputs must be iterable.\")\n\n    processed_list_a = []\n    for i, item in enumerate(list_a):\n        try:\n            _normalize_to_key(item)\n            processed_list_a.append(item)\n        except ValueError:\n            raise ValueError(f\"Element at index {i} in list_a is not a 2-element tuple.\")\n\n    processed_list_b = []\n    for i, item in enumerate(list_b):\n        try:\n            _normalize_to_key(item)\n            processed_list_b.append(item)\n        except ValueError:\n            raise ValueError(f\"Element at index {i} in list_b is not a 2-element tuple.\")\n\n    _seen_keys = set()\n    _results_list = []\n\n    len_a = len(processed_list_a)\n    len_b = len(processed_list_b)\n\n    if len_a <= len_b:\n        lookup_a_map = {}\n        for original_tuple_a in processed_list_a:\n            normalized_key_a = _normalize_to_key(original_tuple_a)\n            if normalized_key_a not in lookup_a_map:\n                lookup_a_map[normalized_key_a] = original_tuple_a\n\n        for original_tuple_b in processed_list_b:\n            normalized_key_b = _normalize_to_key(original_tuple_b)\n            if normalized_key_b in lookup_a_map:\n                matching_tuple_from_a = lookup_a_map[normalized_key_b]\n                if normalized_key_b not in _seen_keys:\n                    _seen_keys.add(normalized_key_b)\n                    _results_list.append(matching_tuple_from_a)\n    else:\n        lookup_b_keys = set()\n        for original_tuple_b in processed_list_b:\n            normalized_key_b = _normalize_to_key(original_tuple_b)\n            lookup_b_keys.add(normalized_key_b)\n\n        for original_tuple_a in processed_list_a:\n            normalized_key_a = _normalize_to_key(original_tuple_a)\n            if normalized_key_a in lookup_b_keys:\n                if normalized_key_a not in _seen_keys:\n                    _seen_keys.add(normalized_key_a)\n                    _results_list.append(original_tuple_a)\n\n    return set(_results_list)"}
{"task_id": "Mbpp/477", "solution": "def is_lower(input_string: str) -> str:\n    \"\"\"Return the lowercase form of input_string.\n\n    Raises:\n        TypeError: if input_string is not a Python str.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"input_string must be a str\")\n    return input_string.lower()"}
{"task_id": "Mbpp/475", "solution": "def _validate_input(input_dict: dict) -> None:\n    \"\"\"Validates that the input is a dictionary.\"\"\"\n    if not isinstance(input_dict, dict):\n        raise TypeError(\"input must be a dict\")\n\ndef _pairs_from_dict(input_dict: dict) -> list[tuple]:\n    \"\"\"Extracts key-value pairs from the dictionary into a list of tuples.\"\"\"\n    return list(input_dict.items())\n\ndef _sort_pairs(pairs: list[tuple]) -> list[tuple]:\n    \"\"\"Sorts a list of (key, value) tuples by value in descending order.\"\"\"\n    return sorted(pairs, key=lambda kv: kv[1], reverse=True)\n\ndef sort_counter(input_dict: dict) -> list[tuple]:\n    \"\"\"\n    Sorts a dictionary by its values in descending order.\n    Returns a new list of (key, value) tuples without mutating the input dictionary.\n    \"\"\"\n    _validate_input(input_dict)\n    pairs = _pairs_from_dict(input_dict)\n    sorted_pairs = _sort_pairs(pairs)\n    return sorted_pairs"}
{"task_id": "Mbpp/474", "solution": "def replace_char(input: str, oldChar: str, newChar: str) -> str:\n    \"\"\"\n    Replaces all occurrences of oldChar with newChar in the input string.\n    Inputs oldChar and newChar must be single-character strings.\n    \"\"\"\n    # Validate oldChar and newChar as per design requirements.\n    # The design explicitly requires raising ValueError for invalid oldChar/newChar length.\n    if not (len(oldChar) == 1):\n        raise ValueError(\"oldChar must be a single character string.\")\n    if not (len(newChar) == 1):\n        raise ValueError(\"newChar must be a single character string.\")\n\n    if not input:\n        return \"\"\n\n    result_chars = []\n    for char in input:\n        if char == oldChar:\n            result_chars.append(newChar)\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/479", "solution": "def first_Digit(n):\n    \"\"\"\n    Return the most significant decimal digit of positive integer n.\n    Raises ValueError if n is not int or n <= 0.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an int\")\n    if n <= 0:\n        raise ValueError(\"n must be positive\")\n\n    while n >= 10:\n        n //= 10\n    return n"}
{"task_id": "Mbpp/478", "solution": "def remove_lowercase(input_str: str) -> str:\n    \"\"\"\n    Removes all contiguous ASCII lowercase substrings from the input string.\n    Preserves all other characters in their original order.\n    \"\"\"\n    def _is_ascii_lowercase(ch: str) -> bool:\n        \"\"\"Returns True if the character is an ASCII lowercase letter.\"\"\"\n        return 'a' <= ch <= 'z'\n\n    output_chars = []\n    for char in input_str:\n        if not _is_ascii_lowercase(char):\n            output_chars.append(char)\n    return ''.join(output_chars)"}
{"task_id": "Mbpp/554", "solution": "def Split(inputList: list[int]) -> list[int]:\n    \"\"\"Return a list of odd integers from inputList preserving original order.\n\n    Preconditions: inputList is expected to be a list of integers (per SRS).\n    \"\"\"\n    result = []\n    for x in inputList:\n        if x % 2 != 0:\n            result.append(x)\n    return result"}
{"task_id": "Mbpp/476", "solution": "class InputArray:\n    \"\"\"Encapsulates input validation and provides min/max queries.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self._elements = elements\n        self._has_float = False\n\n    def validate(self) -> bool:\n        \"\"\"Validates the input list: checks type, non-emptiness, and numeric elements. Raises TypeError or ValueError on invalid input.\"\"\"\n        if not isinstance(self._elements, list):\n            raise TypeError(\"Input must be a list.\")\n        if not self._elements:\n            raise ValueError(\"Input list cannot be empty.\")\n\n        for element in self._elements:\n            if not isinstance(element, (int, float)):\n                raise TypeError(\"All elements in the list must be numeric (int or float).\")\n            if isinstance(element, float):\n                self._has_float = True\n        return True\n\n    def get_min(self) -> float:\n        \"\"\"Returns the minimum value in the list.\"\"\"\n        return min(self._elements)\n\n    def get_max(self) -> float:\n        \"\"\"Returns the maximum value in the list.\"\"\"\n        return max(self._elements)\n\n    @property\n    def size(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self._elements)\n\nclass Result:\n    \"\"\"Value object holding the computed numeric result and its type.\"\"\"\n    def __init__(self, value: (int | float)) -> None:\n        self._value = value\n        self._type = 'int' if isinstance(value, int) else 'float'\n\n    def as_number(self) -> (int | float):\n        \"\"\"Returns the numeric value of the result.\"\"\"\n        return self._value\n\n    @property\n    def type(self) -> str:\n        \"\"\"Returns the string type of the result ('int' or 'float').\"\"\"\n        return self._type\n\nclass BigSumFunction:\n    \"\"\"Application service that computes the sum of min and max from a validated InputArray.\"\"\"\n    def compute(self, input_array: InputArray) -> (int | float):\n        \"\"\"Computes the sum of the minimum and maximum values from the InputArray, returning an int or float based on input types.\"\"\"\n        min_val = input_array.get_min()\n        max_val = input_array.get_max()\n        raw_sum = min_val + max_val\n\n        # Determine the final return type based on the original input elements\n        if input_array._has_float:\n            final_sum = float(raw_sum)\n        else:\n            final_sum = raw_sum # Will naturally be an int if all elements were ints\n\n        return Result(final_sum).as_number()\n\ndef big_sum(input_list: list) -> (int | float):\n    \"\"\"Public API. Accepts a single parameter representing a list/array of numeric values and returns numeric sum of min and max.\n\n    Raises:\n      TypeError: if input_list is not a list or contains non-numeric elements.\n      ValueError: if input_list is empty.\n    \"\"\"\n    input_array = InputArray(input_list)\n    input_array.validate()\n    \n    bs_function = BigSumFunction()\n    return bs_function.compute(input_array)"}
{"task_id": "Mbpp/555", "solution": "def validate_n(n: int) -> bool:\n    \"\"\"Checks if n is an integer and greater than or equal to 1.\"\"\"\n    return isinstance(n, int) and n >= 1\n\ndef compute_sum(n: int) -> int:\n    \"\"\"Calculates the sum of the first n natural numbers using a closed-form formula.\"\"\"\n    return n * (n + 1) // 2\n\ndef compute_sum_cubes(n: int) -> int:\n    \"\"\"Calculates the sum of the cubes of the first n natural numbers using a closed-form formula.\"\"\"\n    # This is equivalent to the square of the sum of the first n natural numbers.\n    sum_of_numbers = compute_sum(n)\n    return sum_of_numbers ** 2\n\ndef difference(n: int) -> int:\n    \"\"\"\n    Finds the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    if not validate_n(n):\n        raise ValueError(\"Input 'n' must be an integer and greater than or equal to 1.\")\n\n    sum_cubes = compute_sum_cubes(n)\n    sum_numbers = compute_sum(n)\n\n    return sum_cubes - sum_numbers"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n):\n    \"\"\"\n    Counts the number of unordered pairs from the first 'n' elements of 'arr'\n    whose XOR value is odd.\n    \"\"\"\n    # Validate input 'n'\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    if n < 0:\n        raise ValueError(\"n cannot be negative.\")\n\n    # Validate input 'arr'\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list.\")\n\n    # Determine the effective number of elements to consider\n    m = min(n, len(arr))\n\n    odd_count = 0\n    even_count = 0\n\n    # Iterate through the first 'm' elements to count odd and even numbers\n    for i in range(m):\n        element = arr[i]\n        # Validate each element\n        if not isinstance(element, int):\n            raise TypeError(\"Elements in the array must be integers.\")\n\n        if element % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # An XOR of two numbers is odd if and only if one number is odd and the other is even.\n    # The number of such pairs is the product of the count of odd numbers and the count of even numbers.\n    return odd_count * even_count"}
{"task_id": "Mbpp/557", "solution": "class Character:\n    \"\"\"Single-character operations and predicates.\"\"\"\n    def __init__(self, value: str):\n        self.value: str = value\n\n    def isAlphabetic(self) -> bool:\n        \"\"\"Returns True if the character is an ASCII alphabetic character.\"\"\"\n        return self.value.isascii() and self.value.isalpha()\n\n    def toUpper(self) -> str:\n        \"\"\"Returns the uppercase version of the character.\"\"\"\n        return self.value.upper()\n\n    def toLower(self) -> str:\n        \"\"\"Returns the lowercase version of the character.\"\"\"\n        return self.value.lower()\n\nclass InputString:\n    \"\"\"Simple value object for the input string.\"\"\"\n    def __init__(self, content: str):\n        self.content: str = content\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string content.\"\"\"\n        return len(self.content)\n\nclass ToggleService:\n    \"\"\"Core algorithm to iterate input_string and produce output_string.\"\"\"\n    def toggle_string(self, input_string: str) -> str:\n        \"\"\"Return new string with alphabetic characters' case toggled.\"\"\"\n        toggled_chars = []\n        for char_str in input_string:\n            char_obj = Character(char_str)\n            if char_obj.isAlphabetic():\n                if char_str.isupper():\n                    toggled_chars.append(char_obj.toLower())\n                else:\n                    toggled_chars.append(char_obj.toUpper())\n            else:\n                toggled_chars.append(char_str)\n        return \"\".join(toggled_chars)\n\n\ndef toggle_string(input_string: str) -> str:\n    \"\"\"Module-level API delegating to ToggleService().toggle_string(input_string).\"\"\"\n    return ToggleService().toggle_string(input_string)"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(list_of_sublists):\n    \"\"\"Return the maximum length (number of elements) among the provided sublists.\n\n    Args:\n        list_of_sublists: list of lists (each element is expected to be a list per SRS).\n\n    Returns:\n        int: maximum length among the provided sublists (an int).\n    \"\"\"\n    return max(len(sublist) for sublist in list_of_sublists)"}
{"task_id": "Mbpp/560", "solution": "from dataclasses import dataclass\nfrom typing import Iterable, Union\n\n@dataclass\nclass TupleInput:\n    elements: tuple\n\n@dataclass\nclass UnionResult:\n    elements: tuple\n\nclass SetOperation:\n    \"\"\"Encapsulates the set union logic.\"\"\"\n    def compute_union(self, a: tuple, b: tuple) -> set:\n        \"\"\"Computes the union of elements from two tuples.\"\"\"\n        return set(a) | set(b)\n\nclass SortOperation:\n    \"\"\"Encapsulates the sorting logic.\"\"\"\n    def sort_ascending(self, elems: Iterable) -> tuple:\n        \"\"\"Sorts elements in ascending order and returns a tuple.\"\"\"\n        return tuple(sorted(elems))\n\nclass UnionService:\n    \"\"\"Orchestrates the union and sorting operations.\"\"\"\n    def __init__(self, set_op: SetOperation = None, sort_op: SortOperation = None) -> None:\n        self._set_op = set_op if set_op is not None else SetOperation()\n        self._sort_op = sort_op if sort_op is not None else SortOperation()\n\n    def union_elements(self, a: tuple, b: tuple) -> tuple:\n        \"\"\"Computes the union of elements from two tuples, sorted ascending.\"\"\"\n        input_a_model = TupleInput(a)\n        input_b_model = TupleInput(b)\n\n        distinct_set = self._set_op.compute_union(input_a_model.elements, input_b_model.elements)\n        sorted_tuple_result = self._sort_op.sort_ascending(distinct_set)\n        \n        return sorted_tuple_result\n\ndef union_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Finds the union of elements from two tuples and outputs them in sorted order.\n    \"\"\"\n    service = UnionService()\n    return service.union_elements(a, b)"}
{"task_id": "Mbpp/558", "solution": "from typing import List\n\nclass DigitDistanceCalculator:\n    \"\"\"Encapsulates the algorithm for calculating the sum of per-digit differences.\"\"\"\n\n    @staticmethod\n    def digit_distance_nums(a: int, b: int) -> int:\n        \"\"\"Calculates the sum of per-digit absolute differences between two integers.\"\"\"\n        a_digits = DigitDistanceCalculator._split_digits(a)\n        b_digits = DigitDistanceCalculator._split_digits(b)\n\n        padded_a, padded_b = DigitDistanceCalculator._pad_digits(a_digits, b_digits)\n\n        return DigitDistanceCalculator._sum_abs_diffs(padded_a, padded_b)\n\n    @staticmethod\n    def _split_digits(n: int) -> List[int]:\n        \"\"\"Splits an integer into a list of its decimal digits, LSB first.\"\"\"\n        digits = []\n        if n == 0:\n            return [0]\n        \n        num = abs(n)\n        while num > 0:\n            digits.append(num % 10)\n            num //= 10\n        return digits\n\n    @staticmethod\n    def _pad_digits(a_digits: List[int], b_digits: List[int]) -> (List[int], List[int]):\n        \"\"\"Pads the shorter digit list with zeros to match the length of the longer list.\"\"\"\n        len_a = len(a_digits)\n        len_b = len(b_digits)\n        max_len = max(len_a, len_b)\n\n        padded_a = a_digits + [0] * (max_len - len_a)\n        padded_b = b_digits + [0] * (max_len - len_b)\n        return padded_a, padded_b\n\n    @staticmethod\n    def _sum_abs_diffs(a_digits: List[int], b_digits: List[int]) -> int:\n        \"\"\"Computes the sum of absolute differences between corresponding digits.\"\"\"\n        total_diff = 0\n        for i in range(len(a_digits)):\n            total_diff += abs(a_digits[i] - b_digits[i])\n        return total_diff\n\ndef digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"Finds the sum of the per-digit difference between two integers.\"\"\"\n    return DigitDistanceCalculator.digit_distance_nums(a, b)"}
{"task_id": "Mbpp/563", "solution": "from dataclasses import dataclass\nfrom typing import List\nimport re\n\n@dataclass\nclass InputString:\n    raw: str\n    length: int = 0\n    def __post_init__(self):\n        self.length = len(self.raw)\n\n@dataclass\nclass QuotedSubstring:\n    value: str\n    start_index: int\n    end_index: int\n\n@dataclass\nclass ExtractionResult:\n    values: List[str]\n    count: int\n\ndef _find_quoted_substrings(raw: str) -> List[QuotedSubstring]:\n    \"\"\"Internal: Returns QuotedSubstring list in left-to-right order with raw inner values.\"\"\"\n    matches = re.finditer(r'\"([^\"]*)\"', raw)\n    results = []\n    for match in matches:\n        results.append(QuotedSubstring(\n            value=match.group(1),\n            start_index=match.start(0),\n            end_index=match.end(0)\n        ))\n    return results\n\ndef extract_values(input: str) -> List[str]:\n    \"\"\"Public API: extracts and trims double-quoted substrings, preserving order.\"\"\"\n    quoted_substrings = _find_quoted_substrings(input)\n    extracted_and_trimmed_values = []\n    for qs in quoted_substrings:\n        extracted_and_trimmed_values.append(qs.value.strip())\n    return extracted_and_trimmed_values"}
{"task_id": "Mbpp/559", "solution": "class ValidationError(Exception):\n    \"\"\"Represents a validation failure with a specific code and message.\"\"\"\n    def __init__(self, code: int, message: str):\n        self.code = code\n        self.message = message\n        super().__init__(message)\n\n\ndef max_sub_array_sum(values, n):\n    \"\"\"\n    Finds the sum of the largest contiguous sublist in the given list, considering the first n elements.\n    \"\"\"\n    if not isinstance(values, list) or not all(isinstance(x, int) for x in values):\n        raise ValidationError(code=1, message=\"Invalid input types: 'values' must be a list of integers.\")\n    if not isinstance(n, int):\n        raise ValidationError(code=1, message=\"Invalid input types: 'n' must be an integer.\")\n\n    normalized_n = 0\n    if n > 0:\n        normalized_n = min(n, len(values))\n\n    if normalized_n == 0:\n        return 0\n\n    current_slice = values[:normalized_n]\n\n    def _compute_max_contiguous_sum(arr: list[int]) -> int:\n        \"\"\"Computes the maximum sum of a contiguous sublist using Kadane's algorithm.\"\"\"\n        max_so_far = arr[0]\n        current_max = arr[0]\n\n        for i in range(1, len(arr)):\n            current_max = max(arr[i], current_max + arr[i])\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    result_int = _compute_max_contiguous_sum(current_slice)\n    return result_int"}
{"task_id": "Mbpp/564", "solution": "from typing import List\n\nclass ArrayElement:\n    \"\"\"Value object holding index and value.\"\"\"\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\n\nclass InputArray:\n    \"\"\"Represents the input slice arr[0:n] as a collection of ArrayElement objects.\"\"\"\n    def __init__(self, arr: list, n: int):\n        self._elements: List[ArrayElement] = [ArrayElement(i, arr[i]) for i in range(n)]\n\n    def elements(self) -> List[ArrayElement]:\n        \"\"\"Returns list of ArrayElement objects.\"\"\"\n        return self._elements\n\n    def length(self) -> int:\n        \"\"\"Returns number of elements.\"\"\"\n        return len(self._elements)\n\nclass Pair:\n    \"\"\"Value/predicate object representing an unordered pair (i < j) with method to evaluate inequality.\"\"\"\n    def __init__(self, i: int, j: int):\n        self.i = i\n        self.j = j\n\n    def areUnequal(self, left_value: int, right_value: int) -> bool:\n        \"\"\"Returns True if values differ.\"\"\"\n        return left_value != right_value\n\nclass Result:\n    \"\"\"Simple container for the computed integer count.\"\"\"\n    def __init__(self, count: int):\n        self.count = count\n\nclass CountPairsFunction:\n    \"\"\"Encapsulates counting algorithm and orchestration to produce a Result.\"\"\"\n    def __init__(self, arr: list, n: int):\n        self._arr = arr\n        self._effective_n = min(n, len(arr))\n\n    def count(self) -> int:\n        \"\"\"Computes and returns integer count of unordered unequal pairs.\"\"\"\n        if self._effective_n < 2:\n            return 0\n\n        # InputArray is conceptually used, but for efficiency, iteration uses indices directly.\n        # InputArray(self._arr, self._effective_n) # Not explicitly iterated over here\n\n        count = 0\n        for i in range(self._effective_n - 1):\n            for j in range(i + 1, self._effective_n):\n                if self._arr[i] != self._arr[j]:\n                    count += 1\n        return count\n\ndef count_Pairs(arr: List[int], n: int) -> int:\n    \"\"\"\n    Counts the number of possible unordered pairs where both elements are unequal.\n    Considers only the first n elements of arr.\n    \"\"\"\n    cf = CountPairsFunction(arr, n)\n    return cf.count()"}
