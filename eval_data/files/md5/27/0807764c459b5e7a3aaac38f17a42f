{"task_id": "Mbpp/415", "solution": "from typing import List, Tuple, Iterator\n\ndef max_Product(input_list: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    Finds a pair with the highest product from a given array of integers.\n    Raises ValueError if input_list is invalid.\n    \"\"\"\n\n    def _validate_input(lst: List[int]) -> None:\n        \"\"\"Validates the input list against type, length, and element type constraints.\"\"\"\n        if not isinstance(lst, list):\n            raise ValueError(\"input_list must be a list.\")\n        if len(lst) < 2:\n            raise ValueError(\"input_list must contain at least two elements.\")\n        if not all(isinstance(x, int) for x in lst):\n            raise ValueError(\"All elements in input_list must be integers.\")\n\n    def _generate_unordered_pairs(lst: List[int]) -> Iterator[Tuple[int, int]]:\n        \"\"\"Yields all unordered pairs (a, b) from the list where a and b are at distinct indices.\"\"\"\n        n = len(lst)\n        for i in range(n - 1):\n            for j in range(i + 1, n):\n                yield (lst[i], lst[j])\n\n    _validate_input(input_list)\n\n    # Initialize with the product of the first pair, guaranteed to exist by validation\n    pair_gen = _generate_unordered_pairs(input_list)\n    \n    first_pair = next(pair_gen)\n    max_prod = first_pair[0] * first_pair[1]\n    result_pair = first_pair\n\n    # Iterate through the remaining pairs and update max_prod if a larger product is found\n    for a, b in pair_gen:\n        current_prod = a * b\n        if current_prod > max_prod:\n            max_prod = current_prod\n            result_pair = (a, b)\n            \n    return result_pair"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n):\n    \"\"\"Return int: sum of cubes of first n even natural numbers (2,4,...,2*n).\n    Raises ValueError for invalid input (non-int or n < 1).\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer >= 1\")\n    return sum((2 * i) ** 3 for i in range(1, n + 1))"}
{"task_id": "Mbpp/419", "solution": "class NumberList:\n    \"\"\"Represents an input sequence of numbers and provides access to elements and length.\"\"\"\n    def __init__(self, numbers: list):\n        self._numbers = numbers\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the number list.\"\"\"\n        return len(self._numbers)\n\n    def get(self, index: int) -> float:\n        \"\"\"Returns the number at the specified index.\"\"\"\n        return float(self._numbers[index])\n\nclass RoundedNumber:\n    \"\"\"Value object holding an integer result of rounding.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass Result:\n    \"\"\"Represents the final integer result and provides an accessor.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def asInt(self) -> int:\n        \"\"\"Returns the result as an integer.\"\"\"\n        return self._value\n\nclass Rounder:\n    \"\"\"Provides rounding behavior implementing round-half-to-even.\"\"\"\n    def roundHalfToEven(self, x: float) -> int:\n        \"\"\"Rounds a float to the nearest even integer (bankers' rounding).\"\"\"\n        return round(x)\n\nclass Calculator:\n    \"\"\"Aggregates rounded values and computes final multiplication.\"\"\"\n    def sumRounded(self, roundedNumbers: list) -> int:\n        \"\"\"Sums a list of RoundedNumber objects.\"\"\"\n        total_sum = 0\n        for rn in roundedNumbers:\n            total_sum += rn.value\n        return total_sum\n\n    def multiplyByLength(self, sum: int, length: int) -> int:\n        \"\"\"Multiplies a sum by a given length.\"\"\"\n        return sum * length\n\nclass Printer:\n    \"\"\"Prints an integer to standard output.\"\"\"\n    def print(self, value: int) -> None:\n        \"\"\"Prints the given integer value to stdout.\"\"\"\n        print(value)\n\ndef round_and_sum(numbers_list) -> int:\n    \"\"\"\n    Rounds every number in a list, calculates their sum, multiplies by the list's length,\n    prints the result, and returns it.\n    \"\"\"\n    number_list_obj = NumberList(numbers_list)\n    rounder = Rounder()\n    rounded_objs = []\n\n    for i in range(number_list_obj.length()):\n        value = number_list_obj.get(i)\n        rv = rounder.roundHalfToEven(value)\n        rounded_objs.append(RoundedNumber(rv))\n\n    calculator = Calculator()\n    s = calculator.sumRounded(rounded_objs)\n    product = calculator.multiplyByLength(s, number_list_obj.length())\n\n    result_obj = Result(product)\n    printer = Printer()\n    printer.print(result_obj.asInt())\n\n    return result_obj.asInt()"}
{"task_id": "Mbpp/421", "solution": "def concatenate_tuple(input_tuple, delimiter='-') -> str:\n    \"\"\"Concatenate each element of input_tuple by delimiter.\n\n    Converts each element to string and joins them using the specified delimiter.\n    \"\"\"\n    if not input_tuple:\n        return \"\"\n    return delimiter.join(str(x) for x in input_tuple)"}
{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n):\n    \"\"\"\n    Finds the average of cubes of the first n natural numbers.\n    Raises ValueError if n is not an integer or n < 1.\n    \"\"\"\n\n    def is_valid(num: int) -> bool:\n        \"\"\"Checks if the input n is a valid integer greater than or equal to 1.\"\"\"\n        return isinstance(num, int) and num >= 1\n\n    def compute_sum(num: int) -> int:\n        \"\"\"Computes the sum of cubes of the first num natural numbers.\"\"\"\n        # Using the formula: (n * (n + 1) / 2)^2\n        sum_of_natural_numbers = num * (num + 1) // 2\n        return sum_of_natural_numbers ** 2\n\n    def compute_average(sum_of_cubes: int, num: int) -> float:\n        \"\"\"Calculates the average given the sum of cubes and the count n.\"\"\"\n        return float(sum_of_cubes) / num\n\n    if not is_valid(n):\n        raise ValueError(\"n must be an integer >= 1\")\n\n    s = compute_sum(n)\n    return compute_average(s, n)"}
