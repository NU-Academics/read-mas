{"task_id": "Mbpp/809", "solution": "def check_smaller(first_tuple, second_tuple):\n    \"\"\"\n    Checks if each element of the second tuple is strictly smaller than its corresponding\n    element in the first tuple. Returns False if tuple lengths differ.\n    \"\"\"\n    if len(first_tuple) != len(second_tuple):\n        return False\n\n    for i in range(len(first_tuple)):\n        if not (second_tuple[i] < first_tuple[i]):\n            return False\n            \n    return True"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(ids: list, names: list, scores: list) -> list:\n    \"\"\"\n    Converts three lists into a list of nested dictionaries, validating lengths and key hashability.\n    Each resulting dictionary has the structure {id: {name: score}}.\n    \"\"\"\n\n    def _validate_lengths(ids_list: list, names_list: list, scores_list: list) -> None:\n        \"\"\"Ensures all input lists have the same length, raising ValueError if they differ.\"\"\"\n        if not (len(ids_list) == len(names_list) == len(scores_list)):\n            raise ValueError(\"Input lists must have the same length\")\n\n    def _validate_hashable(key_obj: object, param_name: str) -> None:\n        \"\"\"Checks if an object is hashable, raising TypeError if it is not.\"\"\"\n        try:\n            hash(key_obj)\n        except TypeError:\n            raise TypeError(f\"{param_name} contains unhashable element: {key_obj!r}\")\n\n    def _build_nested_dict(id_item: object, name_item: object, score_item: object) -> dict:\n        \"\"\"Constructs a single nested dictionary in the format {id: {name: score}}.\"\"\"\n        return {id_item: {name_item: score_item}}\n\n    _validate_lengths(ids, names, scores)\n\n    result = []\n    for id_val, name_val, score_val in zip(ids, names, scores):\n        _validate_hashable(id_val, \"ids\")\n        _validate_hashable(name_val, \"names\")\n        result.append(_build_nested_dict(id_val, name_val, score_val))\n\n    return result"}
{"task_id": "Mbpp/240", "solution": "from src.domain import List, ReplaceListFunction\n\ndef replace_list(list1, list2):\n    \"\"\"\n    Replaces the last element of the first list with the elements of the second list.\n    It adapts plain Python lists to domain objects, performs the operation, and converts the result back.\n    \"\"\"\n    # Adapt plain Python lists to domain.List objects as per design\n    domain_list1 = List(list1)\n    domain_list2 = List(list2)\n\n    # Instantiate the stateless domain service and execute the transformation\n    replacer = ReplaceListFunction()\n    result_domain_list = replacer.execute(domain_list1, domain_list2)\n\n    # Convert the domain.ResultList back to a plain Python list of values\n    plain_result = [element.value for element in result_domain_list.elements()]\n\n    return plain_result"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n):\n    \"\"\"Validate n and return the nth Bell number as a Python int.\n    Raises ValueError if n is negative or not an integer.\"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    if n == 0:\n        return 1\n\n    # Initialize a 2D list for the Bell triangle (B[i][j])\n    # B[i][0] will store the i-th Bell number\n    bell_triangle = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Base case: B(0) = 1\n    bell_triangle[0][0] = 1\n\n    # Fill the Bell triangle iteratively\n    for i in range(1, n + 1):\n        # The first element of row i is the last element of row i-1\n        bell_triangle[i][0] = bell_triangle[i-1][i-1]\n        for j in range(1, i + 1):\n            # Each subsequent element is the sum of the element to its left\n            # and the element diagonally up-left from it\n            bell_triangle[i][j] = bell_triangle[i][j-1] + bell_triangle[i-1][j-1]\n            \n    # The nth Bell number is the first element of the nth row (B[n][0])\n    return bell_triangle[n][0]"}
{"task_id": "Mbpp/239", "solution": "class Validator:\n    \"\"\"Validator component for input validation.\"\"\"\n    def validatePositiveInteger(self, x) -> bool:\n        \"\"\"Returns True if x is an integer and x > 0.\"\"\"\n        return isinstance(x, int) and x > 0\n\n    def validateInputs(self, m, n) -> bool:\n        \"\"\"Returns True if both m and n pass validatePositiveInteger.\"\"\"\n        return self.validatePositiveInteger(m) and self.validatePositiveInteger(n)\n\n\nclass SequenceCalculator:\n    \"\"\"Computes exact count of ordered sequences under constraints with memoization.\"\"\"\n    def __init__(self, m: int):\n        self.m = m\n        self.memo = {}\n\n    def countSequences(self, n: int) -> int:\n        \"\"\"Computes total count of sequences of length n, starting with a1 in [1..m].\"\"\"\n        if n == 0:\n            return 1\n        if n == 1:\n            return self.m\n\n        total_count = 0\n        for a1 in range(1, self.m + 1):\n            total_count += self.countFrom(a1, n - 1)\n        return total_count\n\n    def countFrom(self, startValue: int, remainingLength: int) -> int:\n        \"\"\"Memoized recursive helper to count extensions from startValue for remainingLength.\"\"\"\n        if (startValue, remainingLength) in self.memo:\n            return self.memo[(startValue, remainingLength)]\n\n        if remainingLength == 0:\n            return 1\n\n        current_count = 0\n        next_min = 2 * startValue\n        for next_val in range(next_min, self.m + 1):\n            current_count += self.countFrom(next_val, remainingLength - 1)\n\n        self.memo[(startValue, remainingLength)] = current_count\n        return current_count\n\n\nclass SequenceQuery:\n    \"\"\"Orchestrates validation and counting for a given (m, n) request.\"\"\"\n    def __init__(self, m: int, n: int):\n        self.m = m\n        self.n = n\n\n    def getTotalNumberOfSequences(self) -> int:\n        \"\"\"Validates inputs and computes the total number of sequences.\"\"\"\n        validator = Validator()\n        if not validator.validateInputs(self.m, self.n):\n            raise ValueError(\"Invalid inputs: m and n must be positive integers\")\n\n        calculator = SequenceCalculator(self.m)\n        count = calculator.countSequences(self.n)\n        return count\n\n\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Finds the number of sequences of length n, where elements are positive integers,\n    each >= twice the previous, and <= m.\n    \"\"\"\n    query = SequenceQuery(m, n)\n    return query.getTotalNumberOfSequences()"}
