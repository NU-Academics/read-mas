{"task_id": "Mbpp/79", "solution": "from typing import Any\n\ndef word_len(word: Any) -> bool:\n    \"\"\"Public function required by requirements: accepts a single parameter named word and returns True if its length is odd.\"\"\"\n\n    class Word:\n        \"\"\"Domain data holder for a word with text and length accessor.\"\"\"\n        def __init__(self, text: str):\n            self.text: str = text\n\n        def length(self) -> int:\n            \"\"\"Returns the character length of the word.\"\"\"\n            return len(self.text)\n\n    class WordLengthService:\n        \"\"\"Service for computing word length and parity.\"\"\"\n        def compute_length(self, word: Any) -> int:\n            \"\"\"Computes the length of the input using Python's len() function.\"\"\"\n            return len(word)\n\n        def word_len(self, word: Any) -> bool:\n            \"\"\"Checks if the length of the given word is odd using the Word domain object.\"\"\"\n            word_obj = Word(word)\n            length = word_obj.length()\n            return length % 2 != 0\n\n    service = WordLengthService()\n    return service.word_len(word)"}
{"task_id": "Mbpp/80", "solution": "class Formula:\n    def __init__(self, expression: str = \"n*(n+1)*(n+2)/6\") -> None:\n        self.expression = expression\n    def evaluate(self, n: int) -> int:\n        return (n * (n + 1) * (n + 2)) // 6\n\nclass Parameter:\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass Result:\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass TetrahedralFunction:\n    def __init__(self, n: int, formula: Formula) -> None:\n        self.name = \"tetrahedral_number\"\n        self.n = n\n        self.formula = formula\n    def compute(self) -> int:\n        return int(self.formula.evaluate(self.n))\n\ndef _compute_via_domain(n: int) -> int:\n    param = Parameter(n)\n    formula = Formula()\n    tf = TetrahedralFunction(param.value, formula)\n    value = tf.compute()\n    return value\n\ndef tetrahedral_number(n: int) -> int:\n    \"\"\"Public API: compute nth tetrahedral number as integer.\"\"\"\n    return _compute_via_domain(n)"}
{"task_id": "Mbpp/82", "solution": "import math\n\nclass MathLibrary:\n    \"\"\"Adapter for Python math constants.\"\"\"\n    pi: float = math.pi\n\nclass Sphere:\n    \"\"\"Domain entity representing a sphere.\"\"\"\n    def __init__(self, radius: float):\n        self.radius: float = radius\n\n    def compute_volume(self, pi: float) -> float:\n        \"\"\"Computes the volume of the sphere using the given pi value.\"\"\"\n        return (4.0 / 3.0) * pi * (self.radius ** 3)\n\ndef volume_sphere(radius):\n    \"\"\"Computes the volume of a sphere given its radius.\"\"\"\n    s = Sphere(float(radius))\n    return s.compute_volume(MathLibrary.pi)"}
{"task_id": "Mbpp/84", "solution": "from .sequence_calculator import SequenceCalculator\n\n_calculator = SequenceCalculator()\n\ndef sequence(n: int) -> int:\n    \"\"\"\n    Finds the nth number in the Newman-Conway sequence (1-based index).\n    Delegates the computation to a SequenceCalculator instance.\n    \"\"\"\n    return _calculator.sequence(n)"}
{"task_id": "Mbpp/86", "solution": "def centered_hexagonal_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth centered hexagonal number using the formula 3 * n * (n - 1) + 1.\n    Assumes n is an integer >= 1 based on design context.\n    \"\"\"\n    return 3 * n * (n - 1) + 1"}
{"task_id": "Mbpp/85", "solution": "import math\n\nclass MathConstant:\n    def __init__(self, name: str, value: float):\n        self.name = name\n        self._value = value\n\n    def get_value(self) -> float:\n        return self._value\n\nclass SurfaceAreaCalculator:\n    def __init__(self, pi_constant: MathConstant = None):\n        self.name = \"SurfaceAreaCalculator\"\n        if pi_constant is None:\n            self._pi_const = MathConstant(\"pi\", math.pi)\n        else:\n            self._pi_const = pi_constant\n\n    def surfacearea_sphere(self, radius: float) -> float:\n        \"\"\"Calculates the surface area of a sphere using the formula 4 * pi * radius^2.\"\"\"\n        pi_val = self._pi_const.get_value()\n        return 4 * pi_val * (radius ** 2)\n\ndef surfacearea_sphere(radius):\n    \"\"\"\n    Computes the surface area of a sphere given its radius.\n    Delegates the calculation to a SurfaceAreaCalculator instance.\n    \"\"\"\n    calculator = SurfaceAreaCalculator()\n    return calculator.surfacearea_sphere(radius)"}
{"task_id": "Mbpp/87", "solution": "def merge_dictionaries_three(dict1: dict, dict2: dict, dict3: dict) -> dict:\n    \"\"\"\n    Merges three dictionaries into a single dictionary, ensuring no conflicting values for common keys.\n    Raises ValueError if a key appears with different values in multiple input dictionaries.\n    \"\"\"\n    result_dict = {}\n\n    for d in [dict1, dict2, dict3]:\n        for key, value in d.items():\n            if key in result_dict:\n                if result_dict[key] != value:\n                    raise ValueError(f\"Conflicting values for key '{key}': existing '{result_dict[key]}', new '{value}'\")\n            else:\n                result_dict[key] = value\n\n    return result_dict"}
{"task_id": "Mbpp/88", "solution": "def freq_count(input_list: list) -> dict:\n    \"\"\"\n    Calculates the frequency of each element in a list, returned as a dictionary.\n    Raises TypeError if the input is not a list.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    counts = {}\n    for item in input_list:\n        counts[item] = counts.get(item, 0) + 1\n    return counts"}
