{"task_id": "Mbpp/446", "solution": "def count_Occurrence(tuple_input, list_input) -> int:\n    \"\"\"Returns the number of elements in tuple_input that are equal (==) to any element in list_input.\"\"\"\n    count = 0\n    for tuple_element in tuple_input:\n        for list_element in list_input:\n            if tuple_element == list_element:\n                count += 1\n                break  # Found a match for this tuple_element, move to the next one\n    return count"}
{"task_id": "Mbpp/450", "solution": "def extract_string(list_of_strings, size):\n    \"\"\"\n    Return a list of strings from list_of_strings whose len == size.\n\n    Raises:\n      TypeError: if list_of_strings is not a list/tuple or elements are not all str, or if size is not int.\n      ValueError: if size < 0.\n    \"\"\"\n    if not isinstance(list_of_strings, (list, tuple)):\n        raise TypeError(\"list_of_strings must be a list or tuple.\")\n    if not isinstance(size, int):\n        raise TypeError(\"size must be an integer.\")\n    if size < 0:\n        raise ValueError(\"size cannot be negative.\")\n\n    result = []\n    for item in list_of_strings:\n        if not isinstance(item, str):\n            raise TypeError(\"All elements in list_of_strings must be strings.\")\n        if len(item) == size:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/448", "solution": "def cal_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) to P(n) inclusive.\n    Validates input and uses dynamic programming for Perrin sequence calculation.\n    \"\"\"\n    # Input validation ensures 'n' is a non-negative integer as per design.\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return 3\n    if n == 1:\n        return 3\n    if n == 2:\n        return 5\n\n    perrin_sequence = [0] * (n + 1)\n    perrin_sequence[0] = 3\n    perrin_sequence[1] = 0\n    perrin_sequence[2] = 2\n\n    current_sum = perrin_sequence[0] + perrin_sequence[1] + perrin_sequence[2]\n\n    for i in range(3, n + 1):\n        perrin_sequence[i] = perrin_sequence[i - 2] + perrin_sequence[i - 3]\n        current_sum += perrin_sequence[i]\n\n    return current_sum"}
{"task_id": "Mbpp/451", "solution": "def remove_whitespaces(input: str) -> str:\n    \"\"\"Removes all defined whitespace characters from the given string.\"\"\"\n    whitespace_chars = {' ', '\\t', '\\n', '\\r', '\\f', '\\v'}\n    result_chars = []\n    for char in input:\n        if char not in whitespace_chars:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/453", "solution": "from math import isqrt\n\ndef sumofFactors(n: int) -> int:\n    \"\"\"\n    Calculates the sum of all even positive factors of a given number n.\n    Assumes n is a positive integer.\n    \"\"\"\n    even_factors_sum = 0\n    # Iterate up to the square root of n to find divisors efficiently\n    for i in range(1, isqrt(n) + 1):\n        if n % i == 0:\n            # i is a divisor\n            if i % 2 == 0:\n                even_factors_sum += i\n\n            # j is the complementary divisor\n            j = n // i\n            if i != j:  # Avoid double-counting for perfect squares\n                if j % 2 == 0:\n                    even_factors_sum += j\n    return even_factors_sum"}
