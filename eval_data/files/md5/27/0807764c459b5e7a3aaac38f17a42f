um_val = current_sum\n            result_list = current_list\n            \n    return result_list"}
{"task_id": "Mbpp/806", "solution": "from dataclasses import dataclass\nfrom typing import Any\n\n@dataclass\nclass InputString:\n    value: str\n    length: int\n\n@dataclass\nclass UppercaseRun:\n    start_index: int\n    length: int\n    value: str\n\n@dataclass\nclass Result:\n    max_length: int\n\ndef validate_input(input: Any) -> None:\n    \"\"\"Validates that the input is a string, raising TypeError if not.\"\"\"\n    if not isinstance(input, str):\n        raise TypeError('input must be a string')\n\ndef scan_for_runs(input_string: 'InputString') -> 'Result':\n    \"\"\"Scans the InputString for the maximum run of uppercase ASCII characters.\"\"\"\n    max_run = 0\n    current_run = 0\n    for char_code in input_string.value:\n        if 'A' <= char_code <= 'Z':\n            current_run += 1\n            if current_run > max_run:\n                max_run = current_run\n        else:\n            current_run = 0\n    return Result(max_length=max_run)\n\ndef max_run_uppercase(input: str) -> int:\n    \"\"\"\n    Finds the maximum run of uppercase characters in the given string.\n    The function validates input type, scans for runs, and returns the maximum length.\n    \"\"\"\n    validate_input(input)\n    input_obj = InputString(value=input, length=len(input))\n    result = scan_for_runs(input_obj)\n    return result.max_length"}
