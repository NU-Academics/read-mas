{"task_id": "Mbpp/623", "solution": "from typing import List, Union\n\ndef nth_nums(list_of_numbers: List[Union[int, float]], n: int) -> List[Union[int, float]]:\n    \"\"\"\n    Computes the n-th power of each number in a list.\n    Returns a new list with the results, preserving input order.\n    \"\"\"\n    result = []\n    for num in list_of_numbers:\n        result.append(num ** n)\n    return result"}
{"task_id": "Mbpp/629", "solution": "def Split(numbers):\n    \"\"\"Accepts a single argument 'numbers' (expected list). Returns a list of even numbers preserving original order.\"\"\"\n    result = []\n    for n in numbers:\n        if n % 2 == 0:\n            result.append(n)\n    return result"}
{"task_id": "Mbpp/628", "solution": "def replace_spaces(input: str) -> str:\n    \"\"\"Accept a single string and return a string where every ASCII space (U+0020) is replaced by '%20'.\n    \"\"\"\n    if not input:\n        return \"\"\n\n    result_chars = []\n    for char in input:\n        if char == ' ':\n            result_chars.append('%20')\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/626", "solution": "class Semicircle:\n    \"\"\"Semantic domain value-object holding radius.\"\"\"\n    def __init__(self, radius: float):\n        self.radius = radius\n\nclass Triangle:\n    \"\"\"Semantic domain value-object holding computed area.\"\"\"\n    def __init__(self, area: float):\n        self.area = area\n\nclass Result:\n    \"\"\"Conceptual wrapper for returned value (numeric or None).\"\"\"\n    def __init__(self, value):\n        self.value = value\n\nclass InputValidator:\n    \"\"\"Validates radius type and sign.\"\"\"\n    def validate_radius(self, radius):\n        \"\"\"\n        Validates if the radius is a numeric type and non-negative.\n        Raises TypeError for non-numeric input, returns None for negative,\n        and True for non-negative numeric input.\n        \"\"\"\n        if not isinstance(radius, (int, float)):\n            raise TypeError(\"Radius must be an int or a float.\")\n        if radius < 0:\n            return None\n        return True\n\nclass TriangleCalculator:\n    \"\"\"Computes the area of the largest triangle inscribed in a semicircle.\"\"\"\n    def triangle_area(self, radius):\n        \"\"\"Calculates radius squared for a given radius.\"\"\"\n        return radius * radius\n\ndef triangle_area(radius):\n    \"\"\"\n    Calculates the area of the largest triangle inscribed in a semicircle.\n    Returns None if radius is negative, otherwise returns radius squared.\n    \"\"\"\n    validator = InputValidator()\n    validation_result = validator.validate_radius(radius)\n\n    if validation_result is None:\n        return None\n    \n    calculator = TriangleCalculator()\n    return calculator.triangle_area(radius)"}
{"task_id": "Mbpp/630", "solution": "from typing import List, Tuple\n\ndef get_coordinates(coord: Tuple[int, int]) -> List[List[int]]:\n    \"\"\"Compute and return the 3x3 neighborhood centered at coord.\n\n    The coordinates are ordered by row (r-1 to r+1) then by column (c-1 to c+1).\n    \"\"\"\n    center_row, center_col = coord\n    adjacent_coords = []\n\n    for r_offset in [-1, 0, 1]:\n        for c_offset in [-1, 0, 1]:\n            adjacent_coords.append([center_row + r_offset, center_col + c_offset])\n\n    return adjacent_coords"}
{"task_id": "Mbpp/631", "solution": "from enum import Enum\n\nclass ReplacementMode(Enum):\n    \"\"\"\n    Enumerates the allowed directions for string replacement.\n    \"\"\"\n    TO_UNDERSCORE = 1\n    TO_SPACE = 2\n\nclass ValidationError(Exception):\n    \"\"\"\n    Custom exception for input validation failures.\n    \"\"\"\n    def __init__(self, message: str, type: str = 'ValidationError'):\n        super().__init__(message)\n        self.type = type\n\nclass ReplaceSpacesFunction:\n    \"\"\"\n    Encapsulates the core logic for replacing characters in a string.\n    It handles input validation and the actual character transformation.\n    \"\"\"\n    def _validate_input(self, input_str):\n        \"\"\"Validates that the provided input is a string.\"\"\"\n        if not isinstance(input_str, str):\n            raise ValidationError(\"Input must be a string.\")\n\n    def _perform_replacement(self, input_str: str, mode: ReplacementMode) -> str:\n        \"\"\"Executes the character replacement based on the specified mode.\"\"\"\n        output_chars = []\n        if mode == ReplacementMode.TO_UNDERSCORE:\n            for char in input_str:\n                if char.isspace():\n                    output_chars.append('_')\n                else:\n                    output_chars.append(char)\n        elif mode == ReplacementMode.TO_SPACE:\n            for char in input_str:\n                if char == '_':\n                    output_chars.append(' ')\n                else:\n                    output_chars.append(char)\n        return \"\".join(output_chars)\n\n    def replace_spaces_internal(self, input_str: str, mode: ReplacementMode = ReplacementMode.TO_UNDERSCORE) -> str:\n        \"\"\"\n        Validates input and delegates to the internal replacement method.\n        This method serves as the main entry point for the class's logic.\n        \"\"\"\n        self._validate_input(input_str)\n        return self._perform_replacement(input_str, mode)\n\n# Instantiate the implementation class once for the module's use.\n_replace_spaces_processor = ReplaceSpacesFunction()\n\ndef replace_spaces(input: str, mode: ReplacementMode = ReplacementMode.TO_UNDERSCORE) -> str:\n    \"\"\"\n    Replaces whitespace characters with an underscore, or underscores with spaces, in a string.\n    The default mode replaces whitespaces with underscores.\n    \"\"\"\n    return _replace_spaces_processor.replace_spaces_internal(input, mode)"}
{"task_id": "Mbpp/632", "solution": "from typing import List, Any\n\ndef move_zero(input_list: List[Any]) -> List[Any]:\n    \"\"\"Return a list with elements == 0 moved to the end.\n    Behavior follows SRS: uses Python equality (== 0) to test zero; preserves order of non-zero elements and preserves counts.\n    \"\"\"\n    nonzeros: List[Any] = []\n    zeros: List[Any] = []\n    for el in input_list:\n        if el == 0:\n            zeros.append(el)\n        else:\n            nonzeros.append(el)\n    return nonzeros + zeros"}
{"task_id": "Mbpp/637", "solution": "from decimal import Decimal\n\nclass MoneyAmount:\n    \"\"\"Represents a monetary amount with Decimal precision.\"\"\"\n    def __init__(self, value: Decimal | int | float) -> None:\n        # Convert value to string before passing to Decimal to handle floats accurately\n        self.value = Decimal(str(value))\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"Compares two MoneyAmount objects for exact equality.\"\"\"\n        if not isinstance(other, MoneyAmount):\n            return False\n        return self.value == other.value\n\nclass ProfitLossChecker:\n    \"\"\"Provides business logic to check for no profit and no loss.\"\"\"\n    @staticmethod\n    def noprofit_noloss(amount1: MoneyAmount, amount2: MoneyAmount) -> bool:\n        \"\"\"Checks if two monetary amounts are exactly equal.\"\"\"\n        return amount1 == amount2\n\ndef noprofit_noloss(amount1, amount2) -> bool:\n    \"\"\"Checks if two given amounts represent a no profit, no loss scenario.\"\"\"\n    m1 = MoneyAmount(amount1)\n    m2 = MoneyAmount(amount2)\n    return ProfitLossChecker.noprofit_noloss(m1, m2)"}
{"task_id": "Mbpp/633", "solution": "from typing import List\n\nclass Array:\n    \"\"\"A lightweight wrapper around a list of integers.\"\"\"\n    def __init__(self, elements: List[int]):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self.elements)\n\nclass Element:\n    \"\"\"Represents a single element with its index and value.\"\"\"\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\n\nclass XOROperation:\n    \"\"\"Encapsulates the bitwise XOR operation.\"\"\"\n    def compute(self, x: int, y: int) -> int:\n        \"\"\"Computes the bitwise XOR of two integers.\"\"\"\n        return x ^ y\n\nclass Pair:\n    \"\"\"Represents an unordered pair of elements and computes their XOR value.\"\"\"\n    def __init__(self, a: Element, b: Element):\n        self.a = a\n        self.b = b\n        self._xor_op = XOROperation()\n\n    def xorValue(self) -> int:\n        \"\"\"Computes the XOR value of the two elements in the pair.\"\"\"\n        return self._xor_op.compute(self.a.value, self.b.value)\n\nclass Result:\n    \"\"\"A Data Transfer Object (DTO) holding the aggregated XOR sum.\"\"\"\n    def __init__(self, initial_sum: int = 0):\n        self.sum = initial_sum\n\n    def add(self, value: int):\n        \"\"\"Adds a value to the accumulated sum.\"\"\"\n        self.sum += value\n\ndef pair_xor_Sum(arr: List[int], n: int) -> int:\n    \"\"\"\n    Finds the sum of XOR of all pairs of numbers in the given list up to n elements.\n    \"\"\"\n    result_aggregator = Result()\n    \n    # Consider only the first n elements\n    prefix_array = Array(arr[:n])\n    \n    # Iterate through all unordered pairs (i, j) where i < j\n    for i in range(prefix_array.length()):\n        for j in range(i + 1, prefix_array.length()):\n            element_a = Element(i, prefix_array.elements[i])\n            element_b = Element(j, prefix_array.elements[j])\n            \n            pair = Pair(element_a, element_b)\n            xor_val = pair.xorValue()\n            result_aggregator.add(xor_val)\n            \n    return result_aggregator.sum"}
{"task_id": "Mbpp/639", "solution": "from typing import List\n\ndef startsWithLowercase(name: str) -> bool:\n    \"\"\"Return True if the first character of 'name' is a lowercase letter.\n\n    Note: SRS does not define Unicode/locale rules; implementation uses the\n    language-native lower-case detection (e.g., str[0].islower() in Python).\n    Behavior for empty strings or non-string elements is unspecified in the SRS.\n    \"\"\"\n    if not name:\n        return False\n    return name[0].islower()\n\ndef sample_nam(names: List[str]) -> int:\n    \"\"\"Compute sum of lengths of names that do NOT start with a lowercase letter.\n\n    Precondition: names is a list of strings (BR1).\n    Postcondition: returns an int sum (BR5), 0 if no names remain (BR6).\n\n    SRS acceptance example:\n      sample_nam(['sally','Dylan','rebecca','Diana','Joanne','keith']) == 16\n    \"\"\"\n    total_length = 0\n    for name in names:\n        if not startsWithLowercase(name):\n            total_length += len(name)\n    return total_length"}
{"task_id": "Mbpp/635", "solution": "class Heap:\n    def __init__(self, elements: list):\n        self._elements = list(elements)\n        self._size = len(self._elements)\n\n    def _parent(self, i):\n        return (i - 1) // 2\n\n    def _left_child(self, i):\n        return 2 * i + 1\n\n    def _right_child(self, i):\n        return 2 * i + 2\n\n    def build_heap(self) -> None:\n        \"\"\"Builds a max-heap from the internal list.\"\"\"\n        for i in range(self._size // 2 - 1, -1, -1):\n            self.sift_down(i, self._size - 1)\n\n    def sift_down(self, index: int, end: int) -> None:\n        \"\"\"Restores the max-heap property for the subtree rooted at index.\"\"\"\n        largest = index\n        while True:\n            left = self._left_child(index)\n            right = self._right_child(index)\n\n            if left <= end and self._elements[left] > self._elements[largest]:\n                largest = left\n\n            if right <= end and self._elements[right] > self._elements[largest]:\n                largest = right\n\n            if largest != index:\n                self._elements[index], self._elements[largest] = self._elements[largest], self._elements[index]\n                index = largest\n            else:\n                break\n\n    def extract_max(self, end: int) -> None:\n        \"\"\"Swaps the root with end element and restores heap property.\"\"\"\n        self._elements[0], self._elements[end] = self._elements[end], self._elements[0]\n        self.sift_down(0, end - 1)\n\ndef heap_sort(list):\n    \"\"\"Sorts a list using the heap sort algorithm.\"\"\"\n    heap_obj = Heap(list)\n    heap_obj.build_heap()\n\n    for i in range(heap_obj._size - 1, 0, -1):\n        heap_obj.extract_max(i)\n        \n    return heap_obj._elements"}
{"task_id": "Mbpp/641", "solution": "def is_nonagonal(n: int) -> int:\n    \"\"\"Computes the nth nonagonal number using the formula (7*n^2 - 5*n) / 2.\"\"\"\n    numerator = 7 * n * n - 5 * n\n    return numerator // 2"}
{"task_id": "Mbpp/638", "solution": "import math\n\ndef wind_chill(velocity_kmh: float, temperature_c: float) -> int:\n    \"\"\"\n    Calculates the wind chill index given wind velocity in km/h and temperature in Celsius.\n    The result is rounded to the nearest integer.\n    \"\"\"\n    if not isinstance(velocity_kmh, (int, float)) or not isinstance(temperature_c, (int, float)):\n        raise ValueError(\"Inputs must be numeric (int or float).\")\n    \n    # Formula components\n    T = temperature_c\n    V = velocity_kmh\n\n    # Validate inputs as per design context for formula applicability\n    # The formula is typically valid for temperatures <= 10C and wind speeds >= 4.8 km/h (3 mph)\n    # However, the problem statement and given assertion (35C) do not specify these constraints\n    # and require calculation even for values outside the typical range.\n    # The design context mentions validation for 'missing or non-numeric' but not value ranges\n    # unless they cause mathematical errors (e.g., V <= 0 for V^0.16).\n\n    # Handle V=0 explicitly to avoid V**0.16 when V is 0, which would result in 0**0.16 being 0 for positive 0.16.\n    # The wind chill index is typically considered to be the air temperature when there is no wind.\n    if V < 0:\n        raise ValueError(\"Wind velocity cannot be negative.\")\n    if V == 0:\n        return round(T)\n    \n    # Formula: 13.12 + 0.6215*T - 11.37*V^0.16 + 0.3965*T*V^0.16\n    # Note: math.pow handles floats more explicitly than `**` for consistency, though `**` is fine.\n    \n    raw_wind_chill = 13.12 + (0.6215 * T) - (11.37 * math.pow(V, 0.16)) + (0.3965 * T * math.pow(V, 0.16))\n    \n    # Round to the nearest integer. Python's built-in round() uses round half to even for ties.\n    # The example assert wind_chill(120,35)==40 implies standard rounding (40.25 -> 40).\n    return round(raw_wind_chill)"}
{"task_id": "Mbpp/643", "solution": "class Word:\n    \"\"\"Represents an extracted word with its value and source indices.\"\"\"\n    def __init__(self, value: str, start_index: int, end_index: int):\n        self.value = value\n        self.start_index = start_index\n        self.end_index = end_index\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the word.\"\"\"\n        return len(self.value)\n\n    def char_at(self, i: int) -> str:\n        \"\"\"Returns the character at the specified index within the word.\"\"\"\n        return self.value[i]\n\ndef _tokenize_words(text: str) -> list[Word]:\n    \"\"\"Returns a list of Word instances by splitting on non-alphanumeric characters.\"\"\"\n    words = []\n    current_word_start = -1\n    \n    for i, char in enumerate(text):\n        if char.isalnum():\n            if current_word_start == -1:\n                current_word_start = i\n        else:\n            if current_word_start != -1:\n                word_value = text[current_word_start:i]\n                words.append(Word(word_value, current_word_start, i))\n                current_word_start = -1\n    \n    if current_word_start != -1:\n        word_value = text[current_word_start:len(text)]\n        words.append(Word(word_value, current_word_start, len(text)))\n        \n    return words\n\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"Checks if a string contains 'z' except at the start and end of a word.\"\"\"\n    tokenized_words = _tokenize_words(text)\n\n    for word in tokenized_words:\n        if word.length() < 3: # A word needs at least 3 chars for a middle 'z'\n            continue\n        \n        # Check for 'z' strictly between the first and last character (0 < i < length - 1)\n        for i in range(1, word.length() - 1):\n            if word.char_at(i) == 'z':\n                return True\n                \n    return False"}
