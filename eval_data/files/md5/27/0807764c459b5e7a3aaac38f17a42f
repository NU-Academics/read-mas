{"task_id": "Mbpp/723", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception to signal validation failures.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef validate_inputs(list1, list2) -> None:\n    \"\"\"\n    Validates that inputs are lists and have equal length.\n    Raises ValidationError on violations.\n    \"\"\"\n    if not isinstance(list1, list) or not isinstance(list2, list):\n        raise ValidationError(\"Both inputs must be lists.\")\n    if len(list1) != len(list2):\n        raise ValidationError(\"Lists must be of the same length.\")\n\ndef count_same_pair(list1, list2) -> int:\n    \"\"\"\n    Counts indices where two lists have the same values after validating inputs.\n    Raises ValidationError if inputs are not lists or have unequal lengths.\n    \"\"\"\n    validate_inputs(list1, list2)\n\n    matches = 0\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n            matches += 1\n    return matches"}
{"task_id": "Mbpp/722", "solution": "def filter_data(students_dict, minimal_height, minimal_weight):\n    \"\"\"\n    Filters students from a dictionary based on minimal height and weight.\n    Returns a new dictionary containing only students who meet both criteria.\n    \"\"\"\n    filtered_students = {}\n    for name, (height, weight) in students_dict.items():\n        if height >= minimal_height and weight >= minimal_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students"}
{"task_id": "Mbpp/721", "solution": "import collections\nfrom typing import List, Tuple, Optional, Iterator, Union, Set\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid matrix input.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass Cell:\n    \"\"\"Represents a single cell with its coordinates and value.\"\"\"\n    def __init__(self, row: int, col: int, value: Union[int, float]):\n        self.row = row\n        self.col = col\n        self.value = value\n\nclass Matrix:\n    \"\"\"Encapsulates the raw matrix data and provides accessors.\"\"\"\n    def __init__(self, cells: List[List[Union[int, float]]]):\n        self._cells = cells\n        self.size = len(cells)\n\n    def getCell(self, row: int, col: int) -> Union[int, float]:\n        \"\"\"Returns the value of the cell at the given row and column.\"\"\"\n        return self._cells[row][col]\n\nclass Path:\n    \"\"\"Represents an ordered sequence of Cells and computes its total cost and average.\"\"\"\n    def __init__(self, cells: Optional[List[Cell]] = None):\n        self._cells: List[Cell] = [] if cells is None else list(cells)\n        self._total_cost: Optional[Union[int, float]] = None\n        self.length: int = len(self._cells)\n\n    def append(self, cell: Cell) -> None:\n        \"\"\"Appends a cell to the path and invalidates cached total cost.\"\"\"\n        self._cells.append(cell)\n        self.length += 1\n        self._total_cost = None\n\n    def computeTotal(self) -> Union[int, float]:\n        \"\"\"Computes and returns the total cost of the path.\"\"\"\n        if self._total_cost is None:\n            self._total_cost = sum(cell.value for cell in self._cells)\n        return self._total_cost\n\n    def computeAverage(self) -> float:\n        \"\"\"Computes and returns the average cost per cell in the path.\"\"\"\n        if not self._cells:\n            return 0.0\n        return float(self.computeTotal()) / float(self.length)\n\nclass Validator:\n    \"\"\"Validates the raw input matrix for correctness.\"\"\"\n    def validateMatrix(self, raw_matrix: List[List[Union[int, float]]]) -> None:\n        \"\"\"\n        Validates if the input is a non-empty, square matrix with numeric entries.\n        Raises ValidationError if validation fails.\n        \"\"\"\n        if not raw_matrix:\n            raise ValidationError(\"Input matrix cannot be empty.\")\n\n        n = len(raw_matrix)\n        if n == 0:\n            raise ValidationError(\"Input matrix cannot be empty.\")\n\n        for i, row in enumerate(raw_matrix):\n            if not isinstance(row, list):\n                raise ValidationError(f\"Row {i} is not a list.\")\n            if len(row) != n:\n                raise ValidationError(f\"Matrix is not square. Row {i} has length {len(row)}, expected {n}.\")\n            for j, cell_value in enumerate(row):\n                if not isinstance(cell_value, (int, float)):\n                    raise ValidationError(f\"Cell [{i}][{j}] contains non-numeric value: {cell_value}.\")\n\nclass PathService:\n    \"\"\"Core algorithmic service to compute maximum total sum path using dynamic programming.\"\"\"\n\n    def maxAverageOfPath(self, matrix: Matrix) -> Tuple[Union[int, float], Optional[Path]]:\n        \"\"\"\n        Computes the maximum total sum of a path in the matrix.\n        Returns a tuple of (maximum_sum, optional_path).\n        \"\"\"\n        return self._compute_max_sum_dp(matrix)\n\n    def _compute_max_sum_dp(self, matrix: Matrix) -> Tuple[Union[int, float], Optional[Path]]:\n        \"\"\"\n        Computes the maximum total sum using dynamic programming.\n        Path reconstruction is optional; currently returns None for Path.\n        \"\"\"\n        n = matrix.size\n        \n        dp: List[List[Union[int, float]]] = [[0.0 for _ in range(n)] for _ in range(n)]\n\n        dp[0][0] = matrix.getCell(0, 0)\n\n        for j in range(1, n):\n            dp[0][j] = dp[0][j-1] + matrix.getCell(0, j)\n\n        for i in range(1, n):\n            dp[i][0] = dp[i-1][0] + matrix.getCell(i, 0)\n\n        for i in range(1, n):\n            for j in range(1, n):\n                current_value = matrix.getCell(i, j)\n                dp[i][j] = current_value + max(dp[i-1][j], dp[i][j-1])\n        \n        return dp[n-1][n-1], None\n\ndef maxAverageOfPath(matrix: List[List[Union[int, float]]]) -> float:\n    \"\"\"\n    Given a square matrix, finds a path from top-left to bottom-right\n    moving only right or down, that has the maximum average cost.\n    \"\"\"\n    validator = Validator()\n    validator.validateMatrix(matrix)\n\n    m = Matrix(matrix)\n    path_length = (2 * m.size) - 1\n\n    path_service = PathService()\n    max_sum, _ = path_service.maxAverageOfPath(m)\n\n    average = float(max_sum) / float(path_length)\n\n    return average"}
{"task_id": "Mbpp/724", "solution": "class IntegerInput:\n    \"\"\"Encapsulates an input value and provides a validation predicate.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def isValid(self) -> bool:\n        \"\"\"Checks if the encapsulated value is an integer.\"\"\"\n        return isinstance(self.value, int)\n\n\nclass PowerResult:\n    \"\"\"Holds a numeric result of exponentiation and provides its decimal string form.\"\"\"\n    def __init__(self, numeric_value: int) -> None:\n        self.numericValue = numeric_value\n\n    def decimalString(self) -> str:\n        \"\"\"Converts the numeric value to its decimal string representation.\"\"\"\n        return str(self.numericValue)\n\n\nclass DigitSum:\n    \"\"\"Computes the integer sum of decimal digits from a decimal string.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def compute(self, decimalString: str) -> int:\n        \"\"\"Calculates the sum of all digits in the given decimal string.\"\"\"\n        return sum(int(digit) for digit in decimalString)\n\n\nclass PowerBaseSum:\n    \"\"\"Orchestrates validation, exponentiation, decimal conversion, and digit-sum production.\"\"\"\n    def __init__(self, base: int, power: int) -> None:\n        self.base = base\n        self.power = power\n\n    def call(self) -> int:\n        \"\"\"Executes the full process from base and power to digit sum.\"\"\"\n        # IntegerInput is part of the design, but validation calls are omitted here\n        # to adhere to the prompt's instruction: \"DO NOT add isinstance() checks\".\n        \n        numeric_result = self.base ** self.power\n        \n        power_result = PowerResult(numeric_result)\n        decimal_string = power_result.decimalString()\n        \n        digit_sum_calculator = DigitSum()\n        final_digit_sum = digit_sum_calculator.compute(decimal_string)\n        \n        return final_digit_sum\n\n\ndef power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    This function acts as a facade, delegating the logic to domain-specific classes.\n    \"\"\"\n    processor = PowerBaseSum(base, power)\n    return processor.call()"}
{"task_id": "Mbpp/725", "solution": "from typing import List, Tuple\nfrom dataclasses import dataclass\n\n# Define QuoteMatcher class as specified in design (src/quote_matcher.py)\nclass QuoteMatcher:\n    \"\"\"\n    Identifies matched pairs of double quotation marks in content\n    and reports their start and end indices.\n    \"\"\"\n    def find_pairs(self, content: str) -> List[Tuple[int, int]]:\n        pairs = []\n        open_quote_index = -1\n        for i, char in enumerate(content):\n            if char == '\"':\n                if open_quote_index == -1:\n                    open_quote_index = i\n                else:\n                    pairs.append((open_quote_index, i))\n                    open_quote_index = -1\n        return pairs\n\n    def is_matched(self, index: int, content: str) -> bool:\n        \"\"\"\n        Returns True if the quote at index participates in a matched pair.\n        This method is not directly used by the current extraction logic.\n        \"\"\"\n        return False # Placeholder\n\n# Define dataclasses as specified in design (src/models.py)\n@dataclass\nclass InputString:\n    \"\"\"Represents the input string with its content and length.\"\"\"\n    content: str\n    length: int\n\n@dataclass\nclass QuotedSubstring:\n    \"\"\"Represents an extracted substring along with its order of appearance.\"\"\"\n    text: str\n    order: int # 1-based left-to-right occurrence\n\n@dataclass\nclass ExtractionResult:\n    \"\"\"Encapsulates a list of all extracted quoted substrings.\"\"\"\n    substrings: List[QuotedSubstring]\n\n# Define ExtractQuotationFunction class as specified in design (src/models.py)\nclass ExtractQuotationFunction:\n    \"\"\"\n    Orchestrates the extraction process, using QuoteMatcher\n    to find pairs and constructing QuotedSubstring objects.\n    \"\"\"\n    def __init__(self, matcher: QuoteMatcher = None):\n        \"\"\"Initializes with an optional QuoteMatcher, creating a default if none is provided.\"\"\"\n        self.matcher = matcher if matcher is not None else QuoteMatcher()\n\n    def extract(self, input_str: str) -> List[QuotedSubstring]:\n        \"\"\"\n        Extracts all substrings enclosed by matched double quotes\n        and returns them as a list of QuotedSubstring objects.\n        \"\"\"\n        input_obj = InputString(content=input_str, length=len(input_str))\n        pairs = self.matcher.find_pairs(input_obj.content)\n\n        quoted_substrings = []\n        for order, (start_index, end_index) in enumerate(pairs):\n            text = input_obj.content[start_index + 1 : end_index]\n            quoted_substrings.append(QuotedSubstring(text=text, order=order + 1))\n        return quoted_substrings\n\n\ndef extract_quotation(input: str) -> List[str]:\n    \"\"\"\n    Extracts values between double quotation marks \" \" from the given string.\n    \"\"\"\n    extractor = ExtractQuotationFunction(matcher=QuoteMatcher())\n    extracted_qs_list = extractor.extract(input)\n    return [qs.text for qs in extracted_qs_list]"}
{"task_id": "Mbpp/728", "solution": "def sum_list(a: list, b: list) -> list:\n    \"\"\"Calculates the element-wise sum of two lists.\n    Assumes input lists are of equal length.\"\"\"\n    return [a[i] + b[i] for i in range(len(a))]"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Computes the product of adjacent elements in a tuple of numbers.\n    The i-th element of the output tuple is t_i * t_{i+1}.\n    \"\"\"\n    # The output tuple will have length N where N = len(input_tuple) - 1.\n    # We iterate from the first element up to the second to last element.\n    return tuple(input_tuple[i] * input_tuple[i+1] for i in range(len(input_tuple) - 1))"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(lst: list) -> list:\n    \"\"\"\n    Removes consecutive duplicates from a list, preserving order of unique runs.\n    Returns an empty list if the input list is empty.\n    \"\"\"\n    if not lst:\n        return []\n\n    output_list = [lst[0]]\n    for i in range(1, len(lst)):\n        if lst[i] != output_list[-1]:\n            output_list.append(lst[i])\n    return output_list"}
{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n    Uses the formula: lateral = \u03c0 * r * sqrt(r^2 + h^2).\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    lateral_surface_area = math.pi * r * slant_height\n    return lateral_surface_area"}
{"task_id": "Mbpp/733", "solution": "def binarySearchFirst(array, target) -> int:\n    \"\"\"\n    Internal helper for finding the first occurrence of a target in a sorted array using binary search.\n    Returns the index of the first occurrence or -1 if not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1  # Sentinel for 'not found'\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            result = mid  # Found an occurrence, but keep searching left for an earlier one\n            high = mid - 1\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n            \n    return result\n\n\ndef find_first_occurrence(array, target) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array.\n    This function delegates to a binary search helper to efficiently locate the first instance.\n    \"\"\"\n    return binarySearchFirst(array, target)"}
{"task_id": "Mbpp/732", "solution": "import dataclasses\nfrom typing import List\n\n@dataclasses.dataclass\nclass SpecialCharacter:\n    \"\"\"Represents a character to be replaced and its replacement.\"\"\"\n    symbol: str\n    replacement: str = ':'\n\nclass ReplaceSpecialchar:\n    \"\"\"Encapsulates the logic for replacing special characters with a colon.\"\"\"\n    def __init__(self):\n        # Configure the special characters to be replaced with a colon\n        self._specials: List[SpecialCharacter] = [\n            SpecialCharacter(' '),\n            SpecialCharacter(','),\n            SpecialCharacter('.')\n        ]\n        # For efficient lookup, create a set of symbols to replace\n        self._special_symbols_set = {s.symbol for s in self._specials}\n\n    def replace(self, input_string: str) -> str:\n        \"\"\"\n        Replaces spaces, commas, and dots in the input string with colons.\n        Returns an empty string for empty input.\n        \"\"\"\n        if not input_string:\n            return \"\"\n\n        result_chars = []\n        for char in input_string:\n            if char in self._special_symbols_set:\n                result_chars.append(':')\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n\ndef replace_specialchar(input: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots with a colon.\n    \"\"\"\n    transformer = ReplaceSpecialchar()\n    return transformer.replace(input)"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(list_of_numbers):\n    \"\"\"\n    Calculates the sum of products of all contiguous sublists (subarrays) of a given list.\n    For each subarray, its elements are multiplied to get a product, and these products are summed.\n    \"\"\"\n    total_sum_of_products = 0\n    n = len(list_of_numbers)\n\n    # Iterate through all possible start indices\n    for start_index in range(n):\n        # Iterate through all possible end indices for the current start_index\n        for end_index in range(start_index, n):\n            current_product = 1\n            # Calculate the product of elements in the current subarray\n            for i in range(start_index, end_index + 1):\n                current_product *= list_of_numbers[i]\n            total_sum_of_products += current_product\n\n    return total_sum_of_products"}
{"task_id": "Mbpp/735", "solution": "class Number:\n    \"\"\"Encapsulates integer value and provides binary conversion utilities.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def to_binary(self) -> str:\n        \"\"\"Converts the integer to its binary string representation.\"\"\"\n        if self.value == 0:\n            return '0'\n        return bin(self.value)[2:]\n\n    def from_binary(self, b: str) -> int:\n        \"\"\"Converts a binary string to an integer.\"\"\"\n        return int(b, 2)\n\nclass BitManipulator:\n    \"\"\"Provides methods for bit-level manipulation on binary strings.\"\"\"\n    def toggle_middle_bits(self, binary: str) -> str:\n        \"\"\"Toggles bits of a binary string except the first and the last.\"\"\"\n        if len(binary) < 3:\n            return binary\n        \n        first_bit = binary[0]\n        middle_bits = binary[1:-1]\n        last_bit = binary[-1]\n        \n        toggled_middle = \"\".join('1' if bit == '0' else '0' for bit in middle_bits)\n        \n        return first_bit + toggled_middle + last_bit\n\nclass ToggleFunction:\n    \"\"\"Orchestrates the process of toggling middle bits of a number.\"\"\"\n    def execute(self, n: int) -> int:\n        \"\"\"Executes the bit toggling logic for the given number.\"\"\"\n        number_obj = Number(n)\n        binary_str = number_obj.to_binary()\n        \n        bit_manipulator = BitManipulator()\n        toggled_binary_str = bit_manipulator.toggle_middle_bits(binary_str)\n        \n        return number_obj.from_binary(toggled_binary_str)\n\ndef toggle_middle_bits(n: int) -> int:\n    \"\"\"\n    Toggles bits of the number except the first and the last bit.\n    For numbers with fewer than 3 bits, the number is returned unchanged.\n    \"\"\"\n    toggle_func = ToggleFunction()\n    return toggle_func.execute(n)"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sequence, value) -> int:\n    \"\"\"\n    Compute leftmost insertion index for value in ascending-sorted sequence.\n    This function uses iterative binary search to achieve O(log n) time complexity.\n    \"\"\"\n    low = 0\n    high = len(sequence)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sequence[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/737", "solution": "import re\n\n_VOWEL_PATTERN = re.compile(r'^[aeiouAEIOU]')\n\ndef check_str(s: str) -> bool:\n    \"\"\"Checks if the given string starts with a vowel using regex.\n    Returns True if the string starts with an ASCII vowel (case-insensitive), False otherwise (including empty strings).\"\"\"\n    if not s:\n        return False\n    return _VOWEL_PATTERN.match(s) is not None"}
