{"task_id": "Mbpp/599", "solution": "def sum_average(n) -> tuple[int, float]:\n    \"\"\"\n    Calculates the sum and average of the first n natural numbers.\n    Assumes n is a positive integer.\n    \"\"\"\n    # Use the closed-form formula for the sum of the first n natural numbers.\n    s = n * (n + 1) // 2\n    # Calculate the average, ensuring the result is a float.\n    avg = float(s) / n\n    return (s, avg)"}
{"task_id": "Mbpp/594", "solution": "from typing import List, Union\n\nclass InputList:\n    \"\"\"\n    A domain class to represent and validate the input list.\n    Ensures the input is a list/tuple of integers.\n    \"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n\n    def validate(self) -> bool:\n        \"\"\"\n        Validates that the input is a list/tuple and all its elements are integers.\n        Raises ValueError with a descriptive message on failure.\n        \"\"\"\n        if not isinstance(self.elements, (list, tuple)):\n            raise ValueError(\"input must be a list of integers\")\n        for element in self.elements:\n            if not isinstance(element, int):\n                raise ValueError(\"input must be a list of integers\")\n        return True\n\nclass IntegerElement:\n    \"\"\"\n    A domain class to wrap a single integer value with parity inspection helpers.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def isEven(self) -> bool:\n        \"\"\"Returns True if the stored integer value is even.\"\"\"\n        return self.value % 2 == 0\n\n    def isOdd(self) -> bool:\n        \"\"\"Returns True if the stored integer value is odd.\"\"\"\n        return self.value % 2 != 0\n\nclass DiffEvenOdd:\n    \"\"\"\n    Implements the core logic to find the first even and first odd numbers\n    and compute their difference.\n    \"\"\"\n    def __init__(self) -> None:\n        self.firstEven: Union[int, None] = None\n        self.firstOdd: Union[int, None] = None\n\n    def compute(self, input_list_obj: InputList) -> int:\n        \"\"\"\n        Scans elements left-to-right, identifies the first odd and first even numbers.\n        Returns their difference (first_even - first_odd) or raises ValueError if a parity is missing.\n        \"\"\"\n        for value in input_list_obj.elements:\n            elem = IntegerElement(value)\n            if self.firstOdd is None and elem.isOdd():\n                self.firstOdd = value\n            if self.firstEven is None and elem.isEven():\n                self.firstEven = value\n\n            if self.firstEven is not None and self.firstOdd is not None:\n                return self.firstEven - self.firstOdd\n        \n        raise ValueError(\"missing even or odd element\")\n\ndef diff_even_odd(input_list: list) -> int:\n    \"\"\"\n    Finds the difference of the first even and first odd number of a given list.\n    Validates input and raises ValueError on invalid input or missing parities.\n    \"\"\"\n    input_list_obj = InputList(input_list)\n    input_list_obj.validate()\n\n    diff_calculator = DiffEvenOdd()\n    return diff_calculator.compute(input_list_obj)"}
{"task_id": "Mbpp/597", "solution": "from typing import List, Union\n\n# Number type alias for clarity, as specified in design context (int/float).\nNumber = Union[int, float]\n\nclass Array:\n    \"\"\"\n    A wrapper for a list of numbers, providing read-only access and sortedness check.\n    It stores a shallow copy of the input list to ensure immutability relative to external changes.\n    \"\"\"\n    def __init__(self, elements: List[Number]):\n        if not isinstance(elements, list):\n            raise TypeError(\"Array elements must be a list.\")\n        self._elements = list(elements) # Store a shallow copy\n        self._is_sorted_cache = None # Cache sorted status for performance\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self._elements)\n\n    def isSorted(self) -> bool:\n        \"\"\"Checks if the elements in the array are sorted in ascending order.\"\"\"\n        if self._is_sorted_cache is not None:\n            return self._is_sorted_cache\n\n        if self.length() <= 1:\n            self._is_sorted_cache = True\n            return True\n\n        # Assumes elements are numeric and comparable; type validation is handled by validateInputs.\n        for i in range(self.length() - 1):\n            if self._elements[i] > self._elements[i+1]:\n                self._is_sorted_cache = False\n                return False\n        self._is_sorted_cache = True\n        return True\n\n    def getSlice(self, start: int, end: int) -> List[Number]:\n        \"\"\"Returns a shallow copy slice of the elements based on start and end indices.\"\"\"\n        if not (0 <= start <= end <= self.length()):\n            raise IndexError(f\"Slice indices out of range: start={start}, end={end}, length={self.length()}\")\n        return self._elements[start:end]\n\n    def __getitem__(self, index: int) -> Number:\n        \"\"\"Enables direct indexing of the array elements.\"\"\"\n        return self._elements[index]\n\n\ndef validateInputs(a1: Array, a2: Array, k: int) -> None:\n    \"\"\"\n    Validates inputs for find_kth: ensures arrays are Array instances, are sorted,\n    contain numeric elements, and k is within the valid 1-based range.\n    \"\"\"\n    if not isinstance(a1, Array) or not isinstance(a2, Array):\n        raise TypeError(\"Inputs a1 and a2 must be instances of the Array class.\")\n\n    if not isinstance(k, int):\n        raise TypeError(\"Input k must be an integer.\")\n\n    if k < 1:\n        raise ValueError(f\"k must be a positive integer (1-based), but got {k}.\")\n\n    total_length = a1.length() + a2.length()\n    if k > total_length:\n        raise ValueError(f\"k ({k}) is out of range for combined arrays of length {total_length}.\")\n\n    # Check for numeric types and sortedness for each array\n    for arr, name in [(a1, \"a1\"), (a2, \"a2\")]:\n        if not arr.isSorted():\n            raise ValueError(f\"Array {name} is not sorted.\")\n        for element in arr._elements:\n            if not isinstance(element, (int, float)):\n                raise TypeError(f\"Array {name} contains non-numeric elements.\")\n\n\ndef find_kth(a1: Array, a2: Array, k: int) -> Number:\n    \"\"\"\n    Finds the kth smallest element from two given sorted arrays (a1 and a2).\n    k is 1-based, meaning k=1 returns the smallest element.\n    \"\"\"\n    validateInputs(a1, a2, k)\n\n    ptr1, ptr2 = 0, 0\n    result = None\n\n    # Iterate k times to find the kth element using a two-pointer merge-like approach.\n    for _ in range(k):\n        # Determine current values, using float('inf') if an array is exhausted\n        val1 = a1[ptr1] if ptr1 < a1.length() else float('inf')\n        val2 = a2[ptr2] if ptr2 < a2.length() else float('inf')\n\n        if val1 <= val2:\n            result = val1\n            ptr1 += 1\n        else:\n            result = val2\n            ptr2 += 1\n\n    return result"}
{"task_id": "Mbpp/602", "solution": "def first_repeated_char(s: str) -> str:\n    \"\"\"Return the earliest character in s that has a later duplicate.\n\n    If no repeated character is found, returns None.\n    \"\"\"\n    for i in range(len(s)):\n        char = s[i]\n        if char in s[i+1:]:\n            return char\n    return None"}
{"task_id": "Mbpp/603", "solution": "from typing import List\n\nclass Request:\n    def __init__(self, n: int):\n        self.n: int = n\n\nclass LudicNumber:\n    def __init__(self, value: int):\n        self.value: int = value\n\nclass ResultList:\n    def __init__(self, numbers: List[int] = None):\n        self.numbers: List[int] = numbers or []\n\n    def sort(self) -> None:\n        \"\"\"Sorts the numbers in ascending order.\"\"\"\n        self.numbers.sort()\n\n    def deduplicate(self) -> None:\n        \"\"\"Removes duplicate numbers, preserving order from initial state.\"\"\"\n        self.numbers = list(dict.fromkeys(self.numbers))\n\nclass LudicCalculator:\n    def get_ludic(self, n: int) -> List[int]:\n        \"\"\"Validate input, compute ludic sequence <= n, sort and deduplicate, and return List[int].\"\"\"\n        self.validate_input(n)\n        \n        ludic_sequence = self.compute_ludic_sequence(n)\n        \n        result_list = ResultList(ludic_sequence)\n        # These operations are included to adhere to the design's data flow,\n        # though the sieve naturally produces sorted and unique numbers.\n        result_list.deduplicate() \n        result_list.sort()\n        \n        return result_list.numbers\n\n    def validate_input(self, n: int) -> bool:\n        \"\"\"Return True if n is an integer; raise TypeError on non-int.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        return True\n\n    def compute_ludic_sequence(self, n: int) -> List[int]:\n        \"\"\"Compute ludic numbers <= n using the ludic sieve algorithm.\"\"\"\n        if n < 1:\n            return []\n\n        numbers = list(range(1, n + 1))\n        ludic_numbers = []\n\n        while numbers:\n            ludic_candidate = numbers.pop(0)\n            ludic_numbers.append(ludic_candidate)\n\n            if ludic_candidate == 1:\n                continue\n\n            next_numbers = []\n            count = 0\n            for num in numbers:\n                count += 1\n                if count % ludic_candidate != 0:\n                    next_numbers.append(num)\n            numbers = next_numbers\n            \n        return ludic_numbers\n\ndef get_ludic(n: int) -> List[int]:\n    calculator = LudicCalculator()\n    return calculator.get_ludic(n)"}
{"task_id": "Mbpp/606", "solution": "from math import pi\n\ndef radian_degree(degrees: float) -> float:\n    \"\"\"\n    Converts an angle from degrees to radians.\n    Raises TypeError if the input is not numeric.\n    \"\"\"\n    if not isinstance(degrees, (int, float)):\n        raise TypeError(\"Input 'degrees' must be a numeric type (int or float).\")\n    return degrees * (pi / 180)"}
{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Optional\n\nclass MatchResult:\n    def __init__(self, substring: str, start_index: int, end_index: int) -> None:\n        self.substring = substring\n        self.start_index = start_index\n        self.end_index = end_index\n\nclass RegexEngine:\n    def search(self, source: str, pattern: str) -> Optional[MatchResult]:\n        \"\"\"Return MatchResult for first left-most match, or None if no match.\"\"\"\n        m = re.search(pattern, source)\n        if m:\n            substring = m.group(0)\n            start_index = m.start(0)\n            end_index = m.end(0)\n            return MatchResult(substring, start_index, end_index)\n        return None\n\ndef find_literals(source_string: str, pattern: str) -> Optional[tuple[str, int, int]]:\n    \"\"\"Public API per SRS. Delegates search to RegexEngine.search and returns (substring, start, end) or None.\"\"\"\n    engine = RegexEngine()\n    match_result = engine.search(source_string, pattern)\n    if match_result:\n        return (match_result.substring, match_result.start_index, match_result.end_index)\n    return None"}
{"task_id": "Mbpp/610", "solution": "from typing import List, Any\n\ndef remove_kth_element(lst: List[Any], k: int) -> List[Any]:\n    \"\"\"\n    Returns a new list with the k'th element removed, using 1-based indexing for k.\n    This function creates a new list without modifying the original.\n    \"\"\"\n    zero_based_index = k - 1\n    return lst[:zero_based_index] + lst[zero_based_index + 1:]"}
{"task_id": "Mbpp/604", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    \"\"\"A wrapper for the raw input string.\"\"\"\n    raw: str\n\n@dataclass\nclass Word:\n    \"\"\"Represents a single word token.\"\"\"\n    text: str\n\n@dataclass\nclass OutputString:\n    \"\"\"A wrapper for the reversed output string.\"\"\"\n    reversed: str\n\ndef _tokenize_by_space(raw: str) -> list[Word]:\n    \"\"\"\n    Splits a string by spaces, collapsing empty tokens, and returns a list of Word objects.\n    Empty strings are skipped to ensure proper tokenization.\n    \"\"\"\n    words = raw.split(' ')\n    return [Word(text=w) for w in words if w]\n\ndef _join_tokens(tokens: list[Word]) -> str:\n    \"\"\"\n    Joins a list of Word objects into a single string, separated by a single ASCII space.\n    This reconstructs the sentence from the tokenized words.\n    \"\"\"\n    return ' '.join([word.text for word in tokens])\n\ndef reverse_words(input: str) -> str:\n    \"\"\"\n    Reverses the order of words in a given string, treating spaces as delimiters.\n    Multiple spaces between words are collapsed to a single space in the output.\n    \"\"\"\n    tokens = _tokenize_by_space(raw=input)\n    reversed_tokens = list(reversed(tokens))\n    result = _join_tokens(reversed_tokens)\n    return result"}
{"task_id": "Mbpp/605", "solution": "import math\n\ndef prime_num(n: int) -> bool:\n    \"\"\"\n    Checks if the given integer is a prime number.\n    Applies trial division up to the square root for odd numbers greater than 2.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    # Check for odd divisors from 3 up to the square root of n\n    limit = math.isqrt(n)\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return False\n    return True"}
{"task_id": "Mbpp/611", "solution": "class ComputationException(Exception):\n    \"\"\"Exception to indicate validation or computation errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass Element:\n    \"\"\"Wrap a single element value.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\nclass Row:\n    \"\"\"Represent a single row; operations to check/get elements by index.\"\"\"\n    def __init__(self, elements):\n        # elements is expected to be a list of raw values\n        self.elements = [Element(e) for e in elements]\n\n    def has_index(self, n: int) -> bool:\n        \"\"\"Checks if the row contains an element at the given index n.\"\"\"\n        return 0 <= n < len(self.elements)\n\n    def get_element(self, n: int) -> Element:\n        \"\"\"Returns the Element at the specified index n.\"\"\"\n        return self.elements[n]\n\nclass Matrix:\n    \"\"\"Adapter representing matrix semantics; provides get_column_elements(n).\"\"\"\n    def __init__(self, raw_matrix_data):\n        if not isinstance(raw_matrix_data, list):\n            raise ComputationException(\"Matrix must be a list of lists.\")\n\n        self.rows = []\n        for i, row_data in enumerate(raw_matrix_data):\n            if not isinstance(row_data, list):\n                raise ComputationException(f\"Row at index {i} must be a list.\")\n            self.rows.append(Row(row_data))\n\n    def get_column_elements(self, n: int) -> list:\n        \"\"\"Returns a list of raw values for elements at index n across rows.\"\"\"\n        collected_values = []\n        for row in self.rows:\n            if row.has_index(n):\n                collected_values.append(row.get_element(n).value)\n        return collected_values\n\ndef max_of_nth(matrix, n):\n    \"\"\"\n    Public API per design: max_of_nth(matrix, n)\n    Computes the maximum value from the n'th column of a matrix.\n    \"\"\"\n    matrix_obj = Matrix(matrix)\n\n    collected_elements_values = matrix_obj.get_column_elements(n)\n\n    if not collected_elements_values:\n        raise ComputationException(f\"No element found at column index {n} or matrix is empty for this column.\")\n\n    return max(collected_elements_values)"}
{"task_id": "Mbpp/612", "solution": "def merge(input_list):\n    \"\"\"Return [first_list, second_list] extracted from input_list.\n\n    The first_list contains the first element of each sublist, and the second_list contains the second.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n    for sublist in input_list:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/615", "solution": "```python\ndef average_tuple(tuple_of_tuples):\n    \"\"\"Compute per-inner-tuple arithmetic means and return list of floats.\n\n    Args:\n        tuple_of_tuples: a tuple whose elements are tuples of numeric values (int/float).\n\n    Returns:\n        list of float: arithmetic mean for each inner tuple in the same order as input.\n    \"\"\"\n    result = []\n    for inner_tuple in tuple_of_tuples:\n        # Calculate sum and count for the inner tuple, ensuring float division.\n        # len() will be non-zero per design assumption (no empty inner tuples handling).\n        result.append(sum(inner_tuple) / len(inner_tuple))\n    return result\n```"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(tuple_list):\n    \"\"\"\n    Calculates the cumulative sum of all numeric values within a list of tuples.\n    Raises TypeError if input is not a list of tuples or contains non-numeric elements.\n    \"\"\"\n    if not isinstance(tuple_list, list):\n        raise TypeError(\"tuple_list must be a list of tuples\")\n\n    total = 0\n    seen_float = False\n\n    for t in tuple_list:\n        if not isinstance(t, tuple):\n            raise TypeError(\"each element of tuple_list must be a tuple\")\n        for v in t:\n            if not isinstance(v, (int, float)):\n                raise TypeError(\"tuple elements must be numeric\")\n            if isinstance(v, float):\n                seen_float = True\n            total += v\n\n    if seen_float:\n        return float(total)\n    else:\n        return int(total)"}
{"task_id": "Mbpp/619", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    value: str\n\n@dataclass\nclass OutputString:\n    value: str\n\n@dataclass\nclass Character:\n    value: str\n    position: int\n\n    def isDigit(self) -> bool:\n        \"\"\"Return True if character is ASCII '0'..'9'.\"\"\"\n        return self.value in '0123456789'\n\ndef move_num(input: str) -> str:\n    \"\"\"Return transformed string: non-digits in order followed by digits in order.\"\"\"\n    if not input:\n        return \"\"\n\n    non_digits_chars = []\n    digit_chars = []\n\n    for i, char_value in enumerate(input):\n        char_obj = Character(value=char_value, position=i)\n        if char_obj.isDigit():\n            digit_chars.append(char_value)\n        else:\n            non_digits_chars.append(char_value)\n\n    return \"\".join(non_digits_chars + digit_chars)"}
{"task_id": "Mbpp/616", "solution": "class InvalidInputError(Exception):\n    \"\"\"Raised when input validation fails (e.g., wrong type or length).\"\"\"\n    def __init__(self, message: str = \"Invalid input for tuple modulo operation.\"):\n        super().__init__(message)\n\nclass DivisionByZeroError(Exception):\n    \"\"\"Raised when an element in the divisor tuple is zero.\"\"\"\n    def __init__(self, message: str = \"Cannot perform modulo by zero.\"):\n        super().__init__(message)\n\ndef validate_inputs(a: tuple, b: tuple) -> None:\n    \"\"\"\n    Validates that inputs are tuples of equal length and the divisor tuple contains no zeros.\n    Raises InvalidInputError or DivisionByZeroError on failure.\n    \"\"\"\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise InvalidInputError(\"Both inputs must be tuples.\")\n    if len(a) != len(b):\n        raise InvalidInputError(\"Tuples must have the same length.\")\n    if any(val == 0 for val in b):\n        raise DivisionByZeroError(\"Cannot perform modulo by zero. Divisor tuple contains zero.\")\n\ndef compute_modulo(a: tuple, b: tuple) -> tuple:\n    \"\"\"Computes the element-wise modulo of two tuples.\"\"\"\n    return tuple(a[i] % b[i] for i in range(len(a)))\n\ndef tuple_modulo(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo operation on two tuples of the same length.\n    Raises InvalidInputError or DivisionByZeroError for invalid inputs.\n    \"\"\"\n    validate_inputs(a, b)\n    return compute_modulo(a, b)"}
{"task_id": "Mbpp/618", "solution": "import collections.abc\nfrom typing import List, Sequence, Union\nfrom dataclasses import dataclass\n\nclass DivisionByZeroError(ZeroDivisionError):\n    \"\"\"Raised when an attempt is made to divide by zero.\"\"\"\n    pass\n\n@dataclass\nclass InputList:\n    \"\"\"Wrapper for incoming sequences to provide uniform access and validation.\"\"\"\n    elements: List[Union[int, float]]\n\n    def __post_init__(self):\n        if not isinstance(self.elements, list):\n            raise TypeError(\"InputList must be initialized with a list.\")\n        for item in self.elements:\n            if not isinstance(item, (int, float)):\n                raise TypeError(\"All elements must be numeric (int or float).\")\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def __iter__(self):\n        return iter(self.elements)\n\n@dataclass\nclass ResultList:\n    \"\"\"Lightweight dataclass to hold results of the division operation.\"\"\"\n    results: List[float]\n\n    def length(self) -> int:\n        return len(self.results)\n\n    def to_list(self) -> List[float]:\n        return list(self.results)\n\ndef div_list(a: Sequence[Union[int, float]], b: Sequence[Union[int, float]]) -> List[float]:\n    \"\"\"\n    Divides two lists element-wise, returning a new list of floats.\n    Raises TypeError, ValueError, or DivisionByZeroError for invalid inputs.\n    \"\"\"\n    if not isinstance(a, collections.abc.Sequence) or isinstance(a, (str, bytes)):\n        raise TypeError(\"Input 'a' must be a list-like sequence of numbers.\")\n    if not isinstance(b, collections.abc.Sequence) or isinstance(b, (str, bytes)):\n        raise TypeError(\"Input 'b' must be a list-like sequence of numbers.\")\n\n    try:\n        wrapped_a = InputList(list(a))\n        wrapped_b = InputList(list(b))\n    except TypeError as e:\n        raise TypeError(f\"Invalid element type in input list: {e}\")\n\n    if wrapped_a.length() != wrapped_b.length():\n        raise ValueError(\"Input lists must have the same length.\")\n\n    result_elements: List[float] = []\n    for i in range(wrapped_a.length()):\n        numerator = wrapped_a.elements[i]\n        denominator = wrapped_b.elements[i]\n\n        if denominator == 0:\n            raise DivisionByZeroError(\"Cannot divide by zero.\")\n\n        result_elements.append(float(numerator / denominator))\n\n    return ResultList(result_elements).to_list()"}
{"task_id": "Mbpp/620", "solution": "import collections\n\n# Class: DivisibilityRelation\n# Purpose: Implement pairwise divisibility predicate with safe zero handling.\nclass DivisibilityRelation:\n    @staticmethod\n    def is_divisible(a: int, b: int) -> bool:\n        \"\"\"\n        Evaluates if 'a' and 'b' are divisible, handling zero operands safely.\n        (0, non-zero), (non-zero, 0), and (0, 0) are all treated as divisible.\n        \"\"\"\n        if a == 0 or b == 0:\n            return True # 0 is divisible by any integer, and any integer is considered divisible by 0 as 0 % any_int == 0.\n        \n        # Standard divisibility check for non-zero numbers\n        return (a % b == 0) or (b % a == 0)\n\n# Class: LargestSubsetService\n# Purpose: Encapsulate algorithm to compute the size of the largest pairwise-divisible subset.\nclass LargestSubsetService:\n    def largest_subset(self, values: list[int]) -> int:\n        \"\"\"\n        Computes the size of the largest subset where every pair is divisible.\n        It uses dynamic programming after sorting the input values.\n        \"\"\"\n        if not values:\n            return 0\n\n        # Sort values to ensure that when considering values[i], all potential divisors\n        # values[j] (j < i) have been processed.\n        sorted_values = sorted(values)\n        n = len(sorted_values)\n\n        # dp[i] stores the length of the largest divisible subset ending with sorted_values[i].\n        dp = [1] * n\n\n        for i in range(n):\n            for j in range(i):\n                if DivisibilityRelation.is_divisible(sorted_values[i], sorted_values[j]):\n                    dp[i] = max(dp[i], dp[j] + 1)\n        \n        return max(dp)\n\n# Public function: largest_subset(list_of_ints) -> int\n# Purpose: API entry point required by SRS; delegates to LargestSubsetService.\ndef largest_subset(list_of_ints: list[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible.\n    This public API function delegates the core logic to LargestSubsetService.\n    \"\"\"\n    service = LargestSubsetService()\n    return service.largest_subset(list_of_ints)"}
{"task_id": "Mbpp/622", "solution": "from typing import List\n\nclass ValidationException(Exception):\n    def __init__(self, code: str, message: str) -> None:\n        self.code = code\n        self.message = message\n        super().__init__(f\"[{code}] {message}\")\n\nclass ListInput:\n    def __init__(self, elements: List[int], n: int) -> None:\n        self.elements = elements\n        self.n = n\n\n    def isSorted(self) -> bool:\n        \"\"\"Checks if the list is sorted in non-decreasing order.\"\"\"\n        if len(self.elements) <= 1:\n            return True\n        for i in range(len(self.elements) - 1):\n            if self.elements[i] > self.elements[i+1]:\n                return False\n        return True\n\nclass MedianResult:\n    def __init__(self, value: float) -> None:\n        self.value = value\n\nclass MedianCalculator:\n    def get_median(self, a: 'ListInput', b: 'ListInput') -> float:\n        \"\"\"Validates inputs, merges lists, and computes the median.\"\"\"\n        self._validate_lengths(a, b)\n        self._validate_sorted(a, b)\n        merged = self._merge_sorted(a.elements, b.elements)\n        median_val = self.computeMedianOfMerged(merged)\n        return median_val\n\n    def computeMedianOfMerged(self, merged: List[int]) -> float:\n        \"\"\"Computes the median of a merged list of even length.\"\"\"\n        n_half = len(merged) // 2 # This `n_half` is the original 'n' value\n        mid1_index = n_half - 1\n        mid2_index = n_half\n        return (merged[mid1_index] + merged[mid2_index]) / 2.0\n\n    def _merge_sorted(self, a_elements: List[int], b_elements: List[int]) -> List[int]:\n        \"\"\"Performs a stable merge of two sorted integer lists.\"\"\"\n        merged = []\n        i, j = 0, 0\n        n1, n2 = len(a_elements), len(b_elements)\n\n        while i < n1 and j < n2:\n            if a_elements[i] <= b_elements[j]:\n                merged.append(a_elements[i])\n                i += 1\n            else:\n                merged.append(b_elements[j])\n                j += 1\n\n        while i < n1:\n            merged.append(a_elements[i])\n            i += 1\n        while j < n2:\n            merged.append(b_elements[j])\n            j += 1\n        return merged\n\n    def _validate_lengths(self, a: 'ListInput', b: 'ListInput') -> None:\n        \"\"\"Validates that input list lengths match 'n' and are equal.\"\"\"\n        if len(a.elements) != a.n or len(b.elements) != b.n or a.n != b.n:\n            raise ValidationException(\n                code='LENGTH_MISMATCH',\n                message=f\"Input list lengths must match 'n'. \"\n                        f\"List A has {len(a.elements)} (expected {a.n}), \"\n                        f\"List B has {len(b.elements)} (expected {b.n}).\"\n            )\n\n    def _validate_sorted(self, a: 'ListInput', b: 'ListInput') -> None:\n        \"\"\"Validates that both input lists are sorted.\"\"\"\n        if not a.isSorted() or not b.isSorted():\n            raise ValidationException(\n                code='UNSORTED_INPUT',\n                message=\"Both input lists must be sorted in non-decreasing order.\"\n            )\n\ndef get_median(list1: List[int], list2: List[int], n: int) -> float:\n    \"\"\"\n    Calculates the median of two sorted lists of the same size n.\n    Validates inputs for length and sorted order before computation.\n    \"\"\"\n    list_input_a = ListInput(list1, n)\n    list_input_b = ListInput(list2, n)\n    calculator = MedianCalculator()\n    median_value = calculator.get_median(list_input_a, list_input_b)\n    return median_value"}
