{"task_id": "Mbpp/566", "solution": "def sum_digits(n: int) -> int:\n    \"\"\"Return the sum of the decimal digits of non-negative integer n.\n\n    For n == 0, returns 0.\n    \"\"\"\n    total_sum = 0\n    if n == 0:\n        return 0\n    while n > 0:\n        total_sum += n % 10\n        n //= 10\n    return total_sum"}
{"task_id": "Mbpp/565", "solution": "def validateInput(s):\n    \"\"\"\n    Validates that the input is a string.\n    Raises TypeError if the input is not a str.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"split() expected a str\")\n\ndef split(s):\n    \"\"\"\n    Splits a string into a list of single-character strings.\n    Each element represents a Unicode code point from the input string.\n    \"\"\"\n    validateInput(s)\n    return [char for char in s]"}
{"task_id": "Mbpp/567", "solution": "def issort_list(input_list):\n    \"\"\"\n    Checks if a list is sorted in non-decreasing order.\n    Raises TypeError if input is not a list or elements are not comparable.\n    \"\"\"\n\n    def _validate_input(lst):\n        \"\"\"Ensures the input is a list, raising TypeError if not.\"\"\"\n        if not isinstance(lst, list):\n            raise TypeError('input_list must be a list')\n\n    def _iterate_and_check(lst):\n        \"\"\"Iterates through the list to check for non-decreasing order.\"\"\"\n        n = len(lst)\n        if n <= 1:\n            return True\n        \n        for i in range(1, n):\n            # Comparison will raise TypeError if elements are non-comparable\n            if lst[i] < lst[i-1]:\n                return False\n        return True\n\n    _validate_input(input_list)\n    return _iterate_and_check(input_list)"}
{"task_id": "Mbpp/569", "solution": "from typing import List, Any\n\nclass ValidationError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef validate_input(input: Any) -> None:\n    \"\"\"Raise ValidationError if input is malformed.\n\n    Requirements implemented: outer list whose elements are lists of strings; empty sublists and duplicates allowed.\n    \"\"\"\n    if not isinstance(input, list):\n        raise ValidationError(\"input must be a list of sublists of strings\")\n    for idx, sub in enumerate(input):\n        if not isinstance(sub, list):\n            raise ValidationError(f\"element at index {idx} is not a list\")\n        for jdx, elem in enumerate(sub):\n            if not isinstance(elem, str):\n                raise ValidationError(f\"element at index {idx}[{jdx}] is not a string\")\n    return None\n\ndef sort_sublists(input: List[List[str]]) -> List[List[str]]:\n    \"\"\"Validate input then return a new list-of-lists where each inner list is sorted.\n\n    Raises:\n        ValidationError: when input is not a list of lists of strings.\n    \"\"\"\n    validate_input(input)\n    # build new list of sorted sublists without mutating input\n    return [sorted(list(sublist)) for sublist in input]"}
{"task_id": "Mbpp/573", "solution": "from typing import List\nfrom numbers import Number\n\ndef unique_product(numbers: List[Number]) -> Number:\n    \"\"\"\n    Calculates the product of the unique numbers in a given list.\n    If the list is empty, returns 1.\n    \"\"\"\n    unique_numbers = set(numbers)\n    product = 1\n    for num in unique_numbers:\n        product *= num\n    return product"}
{"task_id": "Mbpp/572", "solution": "import collections\n\ndef two_unique_nums(input_list):\n    \"\"\"\n    Returns a list of numbers that appear exactly once in the input list, preserving original order.\n    Counts occurrences of each number and then filters the input list based on those counts.\n    \"\"\"\n    counts = collections.Counter(input_list)\n    \n    result = []\n    for num in input_list:\n        if counts[num] == 1:\n            result.append(num)\n            \n    return result"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list, sub_list):\n    \"\"\"\n    Return True if sub_list is a contiguous subsequence of main_list, else False.\n\n    Parameters:\n    - main_list: list\n    - sub_list: list\n    Returns:\n    - bool\n    \"\"\"\n    len_main = len(main_list)\n    len_sub = len(sub_list)\n\n    if len_sub == 0:\n        return True\n\n    if len_sub > len_main:\n        return False\n\n    for i in range(len_main - len_sub + 1):\n        if main_list[i : i + len_sub] == sub_list:\n            return True\n\n    return False"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(a: list, b: list, c: list) -> list:\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Raises ValueError if input lists have unequal lengths.\n    \"\"\"\n    len_a = len(a)\n    len_b = len(b)\n    len_c = len(c)\n\n    if not (len_a == len_b and len_b == len_c):\n        raise ValueError(\"input lists must have equal length\")\n\n    result = []\n    for i in range(len_a):\n        result.append(a[i])\n        result.append(b[i])\n        result.append(c[i])\n\n    return result"}
{"task_id": "Mbpp/577", "solution": "import dataclasses\n\n@dataclasses.dataclass\nclass FactorialRequest:\n    n: int\n\n@dataclasses.dataclass\nclass FactorialResult:\n    last_digit: int\n\nclass Validator:\n    def validate_type(self, n):\n        \"\"\"Validates that n is an integer.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n\n    def validate_non_negative(self, n):\n        \"\"\"Validates that n is non-negative.\"\"\"\n        if n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\nclass FactorialCalculator:\n    def compute_last_digit(self, n):\n        \"\"\"\n        Computes the last digit of n! based on specific rules.\n        For n >= 5, the last digit is always 0.\n        \"\"\"\n        if n == 0:\n            return 1\n        elif n == 1:\n            return 1\n        elif n == 2:\n            return 2\n        elif n == 3:\n            return 6\n        elif n == 4:\n            return 4\n        elif n >= 5:\n            return 0\n\ndef last_Digit_Factorial(n):\n    \"\"\"\n    Finds the last digit of the factorial of a given number.\n    Handles validation and computes the result based on specific rules.\n    \"\"\"\n    req = FactorialRequest(n)\n\n    validator = Validator()\n    validator.validate_type(req.n)\n    validator.validate_non_negative(req.n)\n\n    calculator = FactorialCalculator()\n    last_digit = calculator.compute_last_digit(req.n)\n\n    return last_digit"}
{"task_id": "Mbpp/581", "solution": "def surface_Area(base_edge, height):\n    \"\"\"Calculates the surface area of a square pyramid using the given formula.\n    The formula is base_edge**2 + 2 * base_edge * height.\"\"\"\n    return base_edge**2 + 2 * base_edge * height"}
{"task_id": "Mbpp/583", "solution": "import math\n\ndef catalan_number(n):\n    \"\"\"\n    Computes the nth Catalan number (0-indexed).\n    This implementation uses the formula C_n = C(2n, n) / (n + 1).\n    \"\"\"\n    binomial_coefficient = math.comb(2 * n, n)\n    result = binomial_coefficient // (n + 1)\n    return result"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"Removes odd integers from a nested mixed tuple, preserving structure and order.\"\"\"\n\n    def _process_tuple(tup: tuple) -> tuple:\n        \"\"\"Recursively processes tuple elements, keeping even integers and processed nested tuples.\"\"\"\n        result_elements = []\n        for element in tup:\n            if isinstance(element, int):\n                if element % 2 == 0:\n                    result_elements.append(element)\n            elif isinstance(element, tuple):\n                processed_nested = _process_tuple(element)\n                result_elements.append(processed_nested)\n            # Other types are implicitly excluded as they are neither even integers nor tuples to recurse into.\n        return tuple(result_elements)\n\n    return _process_tuple(input_tuple)"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1, tuple2):\n    \"\"\"Finds the dissimilar elements in two tuples, i.e., elements present in exactly one input tuple.\n    The result preserves original relative ordering and deduplicates elements.\"\"\"\n    result_list = []\n    seen_elements = []\n\n    # Process tuple1 for elements unique to it\n    for item1 in tuple1:\n        is_in_tuple2 = False\n        for item2 in tuple2:\n            if item1 == item2:\n                is_in_tuple2 = True\n                break\n        \n        if not is_in_tuple2:\n            is_already_seen = False\n            for seen_item in seen_elements:\n                if item1 == seen_item:\n                    is_already_seen = True\n                    break\n            \n            if not is_already_seen:\n                result_list.append(item1)\n                seen_elements.append(item1)\n\n    # Process tuple2 for elements unique to it\n    for item2 in tuple2:\n        is_in_tuple1 = False\n        for item1 in tuple1:\n            if item2 == item1:\n                is_in_tuple1 = True\n                break\n        \n        if not is_in_tuple1:\n            is_already_seen = False\n            for seen_item in seen_elements:\n                if item2 == seen_item:\n                    is_already_seen = True\n                    break\n            \n            if not is_already_seen:\n                result_list.append(item2)\n                seen_elements.append(item2)\n    \n    return tuple(result_list)"}
{"task_id": "Mbpp/585", "solution": "from typing import List, Dict, Any\n\ndef _validate_dataset(dataset: List[Dict[str, Any]]) -> None:\n    \"\"\"Validates the input dataset structure and item properties.\"\"\"\n    if not isinstance(dataset, list):\n        raise TypeError(\"Dataset must be a list.\")\n    for i, item in enumerate(dataset):\n        if not isinstance(item, dict):\n            raise TypeError(f\"Dataset item at index {i} must be a dictionary.\")\n        if 'name' not in item:\n            raise ValueError(f\"Dataset item at index {i} is missing 'name' key.\")\n        if 'price' not in item:\n            raise ValueError(f\"Dataset item at index {i} is missing 'price' key.\")\n        if not isinstance(item['price'], (int, float)):\n            raise TypeError(f\"Price for item at index {i} must be a number (int or float).\")\n\ndef _validate_n(n: int) -> None:\n    \"\"\"Validates the input n to be a non-negative integer.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer.\")\n\ndef _sorted_by_price_desc(dataset: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n    \"\"\"Returns a new list of items sorted by price in descending order.\"\"\"\n    return sorted(dataset, key=lambda item: item['price'], reverse=True)\n\ndef _copy_item(item: Dict[str, Any]) -> Dict[str, Any]:\n    \"\"\"Returns a shallow copy of the item dictionary.\"\"\"\n    return item.copy()\n\ndef expensive_items(dataset: List[Dict[str, Any]], n: int) -> List[Dict[str, Any]]:\n    \"\"\"Return a list of the n most expensive items from dataset.\n\n    Parameters:\n    - dataset: list of dict where each dict has at minimum keys 'name' and 'price'\n    - n: non-negative int\n\n    Returns:\n    - list of dict (each dict with at minimum keys 'name' and 'price') ordered by descending 'price'.\n    \"\"\"\n    _validate_dataset(dataset)\n    _validate_n(n)\n\n    if n == 0:\n        return []\n\n    sorted_list = _sorted_by_price_desc(dataset)\n    top_n = sorted_list[:min(n, len(sorted_list))]\n    return [_copy_item(item) for item in top_n]"}
{"task_id": "Mbpp/588", "solution": "def validate_input(numbers):\n    \"\"\"\n    Validates the input list for type, non-emptiness, and numeric elements.\n    Raises TypeError if not a list, ValueError if empty or contains non-numeric items.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    if not numbers:\n        raise ValueError(\"List cannot be empty.\")\n    for item in numbers:\n        if not isinstance(item, (int, float)):\n            raise ValueError(\"List must contain only numeric items (int or float).\")\n\ndef compute_difference(numbers):\n    \"\"\"\n    Computes the difference between the maximum and minimum values in a list.\n    Assumes the input list is already validated and contains only numeric items.\n    \"\"\"\n    return max(numbers) - min(numbers)\n\ndef big_diff(numbers):\n    \"\"\"\n    Finds the difference between the largest and smallest value in a given list.\n    Validates the input before performing the computation.\n    \"\"\"\n    validate_input(numbers)\n    return compute_difference(numbers)"}
