{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List\n\ndef heap_queue_largest(input_list: List[int], n: int) -> List[int]:\n    \"\"\"\n    Return the n largest integers from the provided list in descending order.\n\n    Parameters:\n      input_list: List[int] -- input list of numbers (integers implied by design)\n      n: int -- number of largest elements to return\n\n    Returns:\n      List[int] -- list of integers of length min(max(n,0), len(input_list)), ordered descending (largest to smallest)\n    \"\"\"\n    k = max(0, min(n, len(input_list)))\n    if k == 0:\n        return []\n    return heapq.nlargest(k, input_list)"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(seq1, seq2):\n    \"\"\"Compute unique elements present in both seq1 and seq2; does not modify inputs.\"\"\"\n    set1 = set(seq1)\n    set2 = set(seq2)\n    return list(set1.intersection(set2))"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(n: int) -> bool:\n    \"\"\"Return True if n is not prime, False if n is prime.\n\n    This function uses trial division up to the square root of n.\n    \"\"\"\n    if n < 2:\n        return True  # Numbers less than 2 are not prime\n    if n == 2:\n        return False # 2 is prime\n    if n % 2 == 0:\n        return True  # Even numbers greater than 2 are not prime\n\n    # Check for odd divisors from 3 up to sqrt(n)\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return True\n        i += 2\n    return False"}
{"task_id": "Mbpp/8", "solution": "from typing import List, Any\nfrom numbers import Number\n\ndef _is_numeric(value: Any) -> bool:\n    \"\"\"Checks if a given value is a numeric type.\"\"\"\n    return isinstance(value, Number)\n\ndef square_nums(input_list: List[Number]) -> List[Number]:\n    \"\"\"\n    Computes the square of each numeric element in a list, returning a new list.\n    Raises TypeError if any element is not numeric.\n    \"\"\"\n    for num in input_list:\n        if not _is_numeric(num):\n            raise TypeError(f\"All elements in the input list must be numeric. Found non-numeric element: {num}\")\n    return [x * x for x in input_list]"}
{"task_id": "Mbpp/9", "solution": "def rotate_left(s: str, k: int) -> str:\n    \"\"\"Rotates a string s to the left by k positions.\"\"\"\n    return s[k:] + s[:k]\n\ndef find_Rotations(s: str) -> int:\n    \"\"\"Finds the minimum number of rotations (greater than 0) required to get the same string.\"\"\"\n    n = len(s)\n    # Iterate k from 1 up to and including the length of the string.\n    # For any non-empty string, a rotation of length n will always yield the original string.\n    for k in range(1, n + 1):\n        if rotate_left(s, k) == s:\n            return k"}
{"task_id": "Mbpp/11", "solution": "class Occurrence:\n    def __init__(self, first_index: int, last_index: int, count: int) -> None:\n        self.first_index = first_index\n        self.last_index = last_index\n        self.count = count\n\ndef remove_Occ(input_string, character_to_remove):\n    \"\"\"Remove first and last occurrence of character_to_remove from input_string per SRS.\n\n    Preconditions:\n    - input_string: str\n    - character_to_remove: str of length 1\n\n    Returns:\n    - str: resulting string after applying SRS rules\n    \"\"\"\n    first_idx = -1\n    last_idx = -1\n    count = 0\n    \n    for i, char in enumerate(input_string):\n        if char == character_to_remove:\n            if first_idx == -1:\n                first_idx = i\n            last_idx = i\n            count += 1\n            \n    occurrence = Occurrence(first_idx, last_idx, count)\n    \n    if occurrence.count == 0:\n        return input_string\n    elif occurrence.count == 1:\n        # Remove the single occurrence\n        return input_string[:occurrence.first_index] + input_string[occurrence.first_index + 1:]\n    else: # count >= 2\n        # Remove first and last occurrences\n        # Build the string by skipping first_idx and last_idx\n        result = []\n        for i, char in enumerate(input_string):\n            if i != occurrence.first_index and i != occurrence.last_index:\n                result.append(char)\n        return \"\".join(result)"}
{"task_id": "Mbpp/6", "solution": "def _compute_xor(a: int, b: int) -> int:\n    \"\"\"Computes the bitwise XOR of two integers.\"\"\"\n    return a ^ b\n\ndef _is_single_bit_set(x: int) -> bool:\n    \"\"\"Checks if an integer has exactly one bit set (is a power of two and non-zero).\"\"\"\n    return x > 0 and (x & (x - 1)) == 0\n\ndef differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"Checks whether two numbers differ at one bit position only.\"\"\"\n    xor_value = _compute_xor(a, b)\n    return _is_single_bit_set(xor_value)"}
{"task_id": "Mbpp/7", "solution": "class InputString:\n    \"\"\"Represents the input string for processing.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the input string is empty.\"\"\"\n        return not self.value\n\nclass Word:\n    \"\"\"Represents a word token with its text and length.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n        self.originalCase = text # Preserve original casing as required.\n\n    def length(self) -> int:\n        \"\"\"Returns the character length of the word.\"\"\"\n        return len(self.text)\n\nclass ResultList:\n    \"\"\"A collection of processed Word objects.\"\"\"\n    def __init__(self, words: list):\n        self.words = words\n\n    def count(self) -> int:\n        \"\"\"Returns the number of words in the result list.\"\"\"\n        return len(self.words)\n\nclass FindCharLongFunction:\n    \"\"\"Orchestrates splitting and filtering words from an input string.\"\"\"\n    def execute(self, input_str: InputString) -> ResultList:\n        \"\"\"Executes the word finding pipeline with a minimum length of 4.\"\"\"\n        words = self.split(input_str)\n        filtered_words = self.filter(words, 4)\n        return ResultList(filtered_words)\n\n    def split(self, input_str: InputString) -> list:\n        \"\"\"Splits the input string into Word objects based on whitespace.\"\"\"\n        tokens = input_str.value.split()\n        return [Word(token) for token in tokens]\n\n    def filter(self, words: list, minLength: int) -> list:\n        \"\"\"Filters a list of Word objects, keeping only those meeting the minimum length.\"\"\"\n        return [word for word in words if word.length() >= minLength]\n\ndef find_char_long(input_string: str) -> list:\n    \"\"\"\n    Finds all words in a string that are at least 4 characters long.\n    Words are tokenized by whitespace, preserving original casing and order.\n    \"\"\"\n    input_obj = InputString(input_string)\n    finder = FindCharLongFunction()\n    result = finder.execute(input_obj)\n    return [word.text for word in result.words]"}
