{"task_id": "Mbpp/440", "solution": "import string\nfrom dataclasses import dataclass\nfrom abc import ABC, abstractmethod\n\n@dataclass\nclass Token:\n    text: str\n    start: int\n    end: int\n\n@dataclass\nclass Adverb:\n    text: str\n    start_index: int\n    end_index: int\n\ndef tokenize_preserve_indices(sentence: str) -> list[Token]:\n    \"\"\"\n    Tokenizes the input sentence while preserving original character indices.\n    Tokens are delimited by whitespace. Punctuation attached to words remains part of the token.\n    \"\"\"\n    tokens_found = []\n    current_token_start = -1\n    for i, char in enumerate(sentence):\n        if char.isspace():\n            if current_token_start != -1:\n                tokens_found.append(Token(sentence[current_token_start:i], current_token_start, i))\n                current_token_start = -1\n        elif current_token_start == -1:  # Start of a new token\n            current_token_start = i\n    \n    # Add the last token if it exists after the loop\n    if current_token_start != -1:\n        tokens_found.append(Token(sentence[current_token_start:len(sentence)], current_token_start, len(sentence)))\n    \n    return tokens_found\n\nclass POS_TaggerInterface(ABC):\n    \"\"\"\n    Abstract Base Class for POS Taggers.\n    Defines the interface expected by AdverbFinder to obtain POS tags for tokens.\n    \"\"\"\n    @abstractmethod\n    def tag_tokens(self, tokens: list[Token]) -> list[tuple[Token, str]]:\n        pass\n\nclass SimpleLexiconPosTagger(POS_TaggerInterface):\n    \"\"\"\n    A deterministic lexicon-based POS tagger stub for unit tests.\n    It identifies words based on a small predefined lexicon.\n    \"\"\"\n    def __init__(self):\n        self.lexicon = {\n            \"clearly\": \"ADV\",\n            \"we\": \"PRP\",\n            \"can\": \"MD\",\n            \"see\": \"VB\",\n            \"the\": \"DT\",\n            \"sky\": \"NN\"\n        }\n\n    def tag_tokens(self, tokens: list[Token]) -> list[tuple[Token, str]]:\n        \"\"\"\n        Tags a list of Token objects with their corresponding POS tags.\n        Punctuation is stripped from token text for lexicon lookup.\n        \"\"\"\n        tagged_tokens = []\n        for token in tokens:\n            # Clean text for lexicon lookup (strip punctuation and lowercase)\n            cleaned_text = token.text.strip(string.punctuation).lower()\n            tag = self.lexicon.get(cleaned_text, \"UNKNOWN\")\n            tagged_tokens.append((token, tag))\n        return tagged_tokens\n\nclass AdverbFinder:\n    \"\"\"\n    Encapsulates the core logic to identify the first adverb,\n    strip adjacent punctuation, and compose the result tuple.\n    \"\"\"\n    def __init__(self, pos_tagger: POS_TaggerInterface):\n        self.pos_tagger = pos_tagger\n\n    def strip_adjacent_punctuation(self, token_text: str) -> str:\n        \"\"\"Strips leading and trailing punctuation from a token's text.\"\"\"\n        return token_text.strip(string.punctuation)\n\n    def identify_first_adverb(self, tokens_with_tags: list[tuple[Token, str]]) -> Adverb | None:\n        \"\"\"Identifies the first token tagged as an adverb.\"\"\"\n        for token, tag in tokens_with_tags:\n            if tag == \"ADV\":\n                stripped_text = self.strip_adjacent_punctuation(token.text)\n                return Adverb(text=stripped_text, start_index=token.start, end_index=token.end)\n        return None\n\n    def find_adverb_position(self, sentence: str) -> tuple[int, int, str] | None:\n        \"\"\"\n        Finds the first adverb in a sentence, its start and end positions.\n        Returns (start_index, end_index, adverb_text) or None if no adverb is found.\n        \"\"\"\n        tokens = tokenize_preserve_indices(sentence)\n        tagged_tokens = self.pos_tagger.tag_tokens(tokens)\n        \n        first_adverb = self.identify_first_adverb(tagged_tokens)\n        \n        if first_adverb:\n            # The Adverb object already contains the stripped text and original indices\n            return (first_adverb.start_index, first_adverb.end_index, first_adverb.text)\n        else:\n            return None\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"\n    Public API to find the first adverb and its positions in a given sentence.\n    It delegates the work to AdverbFinder using a SimpleLexiconPosTagger by default.\n    \"\"\"\n    pos_tagger = SimpleLexiconPosTagger()\n    finder = AdverbFinder(pos_tagger=pos_tagger)\n    return finder.find_adverb_position(sentence)"}
{"task_id": "Mbpp/445", "solution": "def index_multiplication(a: tuple, b: tuple) -> tuple:\n    \"\"\"Validate inputs and return a tuple-of-tuples where each inner tuple is the element-wise product of the corresponding inner tuples of a and b.\n\n    Raises:\n        TypeError: if outer/inner container types or element types are invalid.\n        ValueError: if outer lengths or inner lengths mismatch.\n    \"\"\"\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise TypeError(\"outer inputs must be tuples of tuples\")\n\n    if len(a) != len(b):\n        raise ValueError('outer tuple length mismatch')\n\n    result_outer_tuple_elements = []\n    for i in range(len(a)):\n        inner_a = a[i]\n        inner_b = b[i]\n\n        if not isinstance(inner_a, tuple) or not isinstance(inner_b, tuple):\n            raise TypeError(\"outer inputs must be tuples of tuples\")\n\n        if len(inner_a) != len(inner_b):\n            raise ValueError(f'inner tuple length mismatch at index {i}')\n\n        result_inner_tuple_elements = []\n        for j in range(len(inner_a)):\n            elem_a = inner_a[j]\n            elem_b = inner_b[j]\n\n            if not isinstance(elem_a, (int, float)) or not isinstance(elem_b, (int, float)):\n                raise TypeError(\"inner elements must be numeric (int or float)\")\n\n            result_inner_tuple_elements.append(elem_a * elem_b)\n        result_outer_tuple_elements.append(tuple(result_inner_tuple_elements))\n\n    return tuple(result_outer_tuple_elements)"}
