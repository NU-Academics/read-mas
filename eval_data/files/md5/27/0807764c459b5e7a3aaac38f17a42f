{"task_id": "Mbpp/397", "solution": "def median_numbers(a, b, c) -> float:\n    \"\"\"Compute the median (middle) of three numeric inputs and return as float.\n    Deterministic, no side-effects, O(1) time/space.\n    \"\"\"\n    if (a <= b and a >= c) or (a >= b and a <= c):\n        return float(a)\n    elif (b <= a and b >= c) or (b >= a and b <= c):\n        return float(b)\n    else:\n        return float(c)"}
{"task_id": "Mbpp/409", "solution": "import math\nfrom typing import List, Iterator\n\nclass TuplePair:\n    \"\"\"Represents a 2-element numeric tuple and computes its product.\"\"\"\n    def __init__(self, a: float, b: float) -> None:\n        self.a = float(a)\n        self.b = float(b)\n\n    def product(self) -> float:\n        \"\"\"Computes the product of the two elements.\"\"\"\n        return self.a * self.b\n\nclass InputList:\n    \"\"\"Validates and stores a list of TuplePair instances.\"\"\"\n    def __init__(self, pairs: List[tuple]) -> None:\n        if not isinstance(pairs, list):\n            raise ValueError(\"Invalid input: expected a list.\")\n        if not pairs:\n            raise ValueError(\"Invalid input: list cannot be empty.\")\n\n        self.pairs: List[TuplePair] = []\n        for i, pair in enumerate(pairs):\n            if not isinstance(pair, tuple):\n                raise ValueError(f\"Invalid input at index {i}: expected a tuple, got {type(pair).__name__}.\")\n            if len(pair) != 2:\n                raise ValueError(f\"Invalid input at index {i}: expected a 2-element tuple, got {len(pair)} elements.\")\n            try:\n                self.pairs.append(TuplePair(pair[0], pair[1]))\n            except (TypeError, ValueError) as e:\n                raise ValueError(f\"Invalid input at index {i}: elements must be numeric. Details: {e}\")\n\n    def __iter__(self) -> Iterator[TuplePair]:\n        return iter(self.pairs)\n\n    def __len__(self) -> int:\n        return len(self.pairs)\n\nclass MinProduct:\n    \"\"\"Holds the computed minimum product value.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\nclass MinProductFunction:\n    \"\"\"Computes the minimum product from an InputList.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def compute(self, pairs: InputList) -> MinProduct:\n        \"\"\"Calculates the minimum product from the given InputList.\"\"\"\n        if not pairs:\n            # This case should ideally be caught by InputList validation,\n            # but as a safeguard, if an empty InputList were somehow passed\n            # without validation, there's no product to compute.\n            # Returning math.inf or raising an error could be options.\n            # Given the design context, InputList ensures it's not empty.\n            pass \n\n        min_product = math.inf\n        for pair in pairs:\n            current_product = pair.product()\n            if current_product < min_product:\n                min_product = current_product\n        return MinProduct(min_product)\n\ndef min_product_tuple(pairs: list[tuple]) -> float:\n    \"\"\"\n    Finds the minimum product from the pairs of tuples within a given list.\n    Raises ValueError on invalid input.\n    \"\"\"\n    input_list = InputList(pairs)\n    min_product_calculator = MinProductFunction()\n    result = min_product_calculator.compute(input_list)\n    return result.value"}
{"task_id": "Mbpp/410", "solution": "def _is_numeric(value) -> bool:\n    \"\"\"Checks if a value is an integer or a float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef _to_number(value) -> (int | float):\n    \"\"\"Returns the value as is, assuming it's already numeric.\"\"\"\n    return value\n\ndef min_val(input_list: list) -> (int | float | None):\n    \"\"\"\n    Finds the minimum numeric value in a heterogeneous list.\n    Non-numeric elements are ignored. Returns None if no numeric elements are found.\n    \"\"\"\n    numeric_values = []\n    for item in input_list:\n        if _is_numeric(item):\n            numeric_values.append(_to_number(item))\n\n    if not numeric_values:\n        return None\n    return min(numeric_values)"}
