{"task_id": "Mbpp/127", "solution": "from typing import Any\n\ndef _validate_inputs(a: Any, b: Any) -> None:\n    \"\"\"Raise TypeError if a or b is not an int.\"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(f\"multiply_int requires two integers: received types {type(a).__name__}, {type(b).__name__}\")\n\ndef multiply_int(a: int, b: int) -> int:\n    \"\"\"Multiply two integers and return the product.\n\n    Parameters:\n    - a: int\n    - b: int\n\n    Returns: int\n\n    Raises: TypeError if a or b is not an int.\n    \"\"\"\n    _validate_inputs(a, b)\n    return a * b"}
{"task_id": "Mbpp/124", "solution": "from typing import Any\nimport math\n\nclass ComplexNumber:\n    \"\"\"Represents a complex number with real and imaginary parts.\"\"\"\n    def __init__(self, real: float, imag: float) -> None:\n        self.real = float(real)\n        self.imag = float(imag)\n\n    def to_complex(self) -> complex:\n        \"\"\"Converts the ComplexNumber instance to a built-in Python complex type.\"\"\"\n        return complex(self.real, self.imag)\n\nclass AngleResult:\n    \"\"\"A value object for the computed angle in radians.\"\"\"\n    def __init__(self, radians: float) -> None:\n        self.radians = float(radians)\n\nclass AngleCalculator:\n    \"\"\"Performs the computation of a complex number's argument.\"\"\"\n    @staticmethod\n    def angle_complex(z: complex) -> float:\n        \"\"\"Calculates the angle of a complex number using math.atan2.\"\"\"\n        return math.atan2(z.imag, z.real)\n\ndef angle_complex(z: Any) -> float:\n    \"\"\"\n    Calculates the argument (angle) of a complex number in radians.\n    Input can be a Python complex, a ComplexNumber instance, or convertible to complex.\n    \"\"\"\n    c: complex\n    if isinstance(z, complex):\n        c = z\n    elif isinstance(z, ComplexNumber):\n        c = z.to_complex()\n    else:\n        try:\n            c = complex(z)\n        except (TypeError, ValueError):\n            raise TypeError(\"angle_complex: input must be a complex or convertible to complex\")\n\n    return AngleCalculator.angle_complex(c)"}
{"task_id": "Mbpp/126", "solution": "def _common_divisors(a: int, b: int) -> list[int]:\n    \"\"\"Finds all positive common divisors for two integers `a` and `b` within the range 1 to `min(abs(a), abs(b))` inclusive.\"\"\"\n    abs_a = abs(a)\n    abs_b = abs(b)\n    \n    limit = min(abs_a, abs_b)\n    \n    common = []\n    for d in range(1, limit + 1):\n        if abs_a % d == 0 and abs_b % d == 0:\n            common.append(d)\n    return common\n\ndef sum(a: int, b: int) -> int:\n    \"\"\"Return the sum of all positive integers that divide both a and b without remainder.\"\"\"\n    divisors = _common_divisors(a, b)\n    return __builtins__.sum(divisors)"}
{"task_id": "Mbpp/128", "solution": "from typing import List\n\ndef split(text: str) -> List[str]:\n    \"\"\"Splits the input text into a list of words using whitespace as a separator.\"\"\"\n    return text.split()\n\ndef filter(words: List[str], n: int) -> List[str]:\n    \"\"\"Filters a list of words, returning only those longer than n characters.\"\"\"\n    return [word for word in words if len(word) > n]\n\ndef long_words(n: int, text: str) -> List[str]:\n    \"\"\"\n    Finds words that are longer than n characters from a given list of words.\n    The function splits the text by whitespace and filters the resulting words.\n    \"\"\"\n    words = split(text)\n    filtered_words = filter(words, n)\n    return filtered_words"}
{"task_id": "Mbpp/130", "solution": "class FrequencyCounter:\n    \"\"\"Helper class to count frequencies of items and find the most frequent one.\n    It returns the first encountered maximum item in case of ties.\n    \"\"\"\n    def __init__(self):\n        self._counts = {}\n\n    def increment(self, item):\n        \"\"\"Increments the count for a given item.\"\"\"\n        self._counts[item] = self._counts.get(item, 0) + 1\n\n    def get_max_item(self):\n        \"\"\"Returns the item with the highest frequency.\n        If the counter is empty, it returns None.\n        \"\"\"\n        if not self._counts:\n            return None\n\n        max_item = None\n        max_count = -1\n\n        for item, count in self._counts.items():\n            if count > max_count:\n                max_count = count\n                max_item = item\n        return max_item\n\ndef max_occurrences(input_list):\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    If multiple items have the same maximum frequency, the first one encountered is returned.\n    \"\"\"\n    fc = FrequencyCounter()\n    for item in input_list:\n        fc.increment(item)\n    return fc.get_max_item()"}
{"task_id": "Mbpp/129", "solution": "from typing import List\n\nclass ValidationResult:\n    \"\"\"Simple container for validation result state and optional message.\"\"\"\n    def __init__(self, is_valid: bool, message: str = \"\") -> None:\n        self.is_valid = is_valid\n        self.message = message\n\nclass Matrix:\n    \"\"\"Represents an input matrix and provides shape and sum helper operations.\"\"\"\n    def __init__(self, rows: List[List[int]]) -> None:\n        self.rows = rows\n        self.size = len(rows) if rows else 0\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the matrix is empty.\"\"\"\n        return self.size == 0 or (self.size > 0 and len(self.rows[0]) == 0)\n\n    def is_square(self) -> bool:\n        \"\"\"Checks if the matrix is square (n x n).\"\"\"\n        if self.is_empty():\n            return False\n        for row in self.rows:\n            if len(row) != self.size:\n                return False\n        return True\n\n    def row_sum(self, i: int) -> int:\n        \"\"\"Calculates the sum of the i-th row.\"\"\"\n        return sum(self.rows[i])\n\n    def col_sum(self, j: int) -> int:\n        \"\"\"Calculates the sum of the j-th column.\"\"\"\n        col_sum_val = 0\n        for i in range(self.size):\n            col_sum_val += self.rows[i][j]\n        return col_sum_val\n\n    def diag_sum(self, primary: bool) -> int:\n        \"\"\"Calculates the sum of a diagonal (primary or secondary).\"\"\"\n        diag_sum_val = 0\n        if primary:\n            for i in range(self.size):\n                diag_sum_val += self.rows[i][i]\n        else: # secondary diagonal\n            for i in range(self.size):\n                diag_sum_val += self.rows[i][self.size - 1 - i]\n        return diag_sum_val\n\nclass MagicSquareChecker:\n    \"\"\"Validates and checks whether a Matrix is a magic square.\"\"\"\n    def magic_square_test(self, matrix: Matrix) -> bool:\n        \"\"\"Main method to check if a given Matrix is a magic square.\"\"\"\n        shape_validation = self.validate_shape(matrix)\n        if not shape_validation.is_valid:\n            return False\n\n        ref_sum = self.compute_reference_sum(matrix)\n        sums_validation = self.validate_sums(matrix, ref_sum)\n        return sums_validation.is_valid\n\n    def compute_reference_sum(self, matrix: Matrix) -> int:\n        \"\"\"Computes the reference sum from the first row of the matrix.\"\"\"\n        return matrix.row_sum(0)\n\n    def validate_shape(self, matrix: Matrix) -> ValidationResult:\n        \"\"\"Validates if the matrix is non-empty and square.\"\"\"\n        if matrix.is_empty():\n            return ValidationResult(False, \"Matrix is empty.\")\n        if not matrix.is_square():\n            return ValidationResult(False, \"Matrix is not square.\")\n        return ValidationResult(True)\n\n    def validate_sums(self, matrix: Matrix, ref_sum: int) -> ValidationResult:\n        \"\"\"Validates all row, column, and diagonal sums against the reference sum.\"\"\"\n        # Check row sums\n        for i in range(matrix.size):\n            if matrix.row_sum(i) != ref_sum:\n                return ValidationResult(False, f\"Row {i} sum mismatch.\")\n\n        # Check column sums\n        for j in range(matrix.size):\n            if matrix.col_sum(j) != ref_sum:\n                return ValidationResult(False, f\"Column {j} sum mismatch.\")\n\n        # Check primary diagonal sum\n        if matrix.diag_sum(primary=True) != ref_sum:\n            return ValidationResult(False, \"Primary diagonal sum mismatch.\")\n\n        # Check secondary diagonal sum\n        if matrix.diag_sum(primary=False) != ref_sum:\n            return ValidationResult(False, \"Secondary diagonal sum mismatch.\")\n\n        return ValidationResult(True)\n\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"\n    Calculates whether the input matrix is a magic square.\n    It checks if all row, column, and diagonal sums are equal.\n    \"\"\"\n    matrix_obj = Matrix(matrix)\n    checker = MagicSquareChecker()\n    return checker.magic_square_test(matrix_obj)"}
{"task_id": "Mbpp/131", "solution": "import dataclasses\n\nclass VowelSet:\n    \"\"\"Manages the set of vowel characters and provides a check method.\"\"\"\n    def __init__(self):\n        self.vowels = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    def is_vowel(self, c: str) -> bool:\n        \"\"\"Checks if a given character is a vowel (y is not a vowel).\"\"\"\n        return c in self.vowels\n\n@dataclasses.dataclass\nclass VowelOccurrence:\n    \"\"\"Holds a vowel character and its original index in the string.\"\"\"\n    char: str\n    index: int\n\nclass InputString:\n    \"\"\"A wrapper for the input string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated string.\"\"\"\n        return len(self.value)\n\nclass OutputString:\n    \"\"\"A wrapper for the output string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass ReverseVowelsFunction:\n    \"\"\"Implements the core logic to reverse only the vowels in a string.\"\"\"\n    def reverse_vowels(self, s: str) -> str:\n        \"\"\"Reverses only the vowels of the input string.\"\"\"\n        if not s:\n            return \"\"\n\n        input_str = InputString(s)\n        vowel_set = VowelSet()\n        vowel_occurrences: list[VowelOccurrence] = []\n\n        # Identify vowel occurrences and collect them\n        for i, char in enumerate(input_str.value):\n            if vowel_set.is_vowel(char):\n                vowel_occurrences.append(VowelOccurrence(char=char, index=i))\n\n        # If zero or one vowel, return the original string unchanged\n        if len(vowel_occurrences) <= 1:\n            return s\n\n        # Extract vowel characters and reverse their order\n        vowel_chars_to_reverse = [vo.char for vo in vowel_occurrences]\n        reversed_vowel_chars = vowel_chars_to_reverse[::-1]\n\n        # Create a mutable list of characters from the input string for modification\n        output_chars = list(input_str.value)\n\n        # Reinsert the reversed vowels into their original positions\n        for i, vo in enumerate(vowel_occurrences):\n            output_chars[vo.index] = reversed_vowel_chars[i]\n\n        # Join the characters to form the final string and encapsulate it\n        final_str_value = \"\".join(output_chars)\n        output_obj = OutputString(final_str_value)\n        return output_obj.value\n\ndef reverse_vowels(s: str) -> str:\n    \"\"\"Reverses only the vowels of a given string (where y is not a vowel).\"\"\"\n    return ReverseVowelsFunction().reverse_vowels(s)"}
