{"task_id": "Mbpp/591", "solution": "def swap_List(input_list):\n    \"\"\"Accepts a Python list and returns a list with first and last elements interchanged.\n    Returns a new list (does not modify input_list) and handles lists of length < 2 by returning the input list unchanged.\n    \"\"\"\n    list_len = len(input_list)\n    if list_len < 2:\n        return input_list\n    \n    first_element = input_list[0]\n    last_element = input_list[list_len - 1]\n    \n    # Get the middle part of the list using slicing.\n    # For lists of length 2, this will be an empty list, which is correct.\n    middle_elements = input_list[1:-1]\n    \n    # Construct the new list by combining the swapped elements with the middle part.\n    result_list = [last_element] + middle_elements + [first_element]\n    \n    return result_list"}
{"task_id": "Mbpp/589", "solution": "import math\n\ndef perfect_squares(start: int, end: int) -> list[int]:\n    \"\"\"\n    Computes and returns an ascending-ordered list of all perfect squares\n    within the inclusive range [start, end].\n    \"\"\"\n    if end < 0:\n        return []\n\n    # The effective start for finding perfect squares cannot be negative.\n    effective_start = max(0, start)\n\n    # Calculate the smallest integer k such that k*k >= effective_start.\n    lower_k = math.ceil(math.sqrt(effective_start))\n\n    # Calculate the largest integer k such that k*k <= end.\n    upper_k = math.floor(math.sqrt(end))\n\n    # If the range for k is empty, no perfect squares exist.\n    if lower_k > upper_k:\n        return []\n\n    # Generate the perfect squares by squaring each k in the valid range.\n    squares = [k * k for k in range(int(lower_k), int(upper_k) + 1)]\n\n    return squares"}
{"task_id": "Mbpp/592", "solution": "from math import comb as _math_comb\n\ndef _validate_n(n) -> None:\n    \"\"\"Validates that n is a non-negative integer.\"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\ndef C(n: int, k: int) -> int:\n    \"\"\"Computes the binomial coefficient 'n choose k' using exact integer arithmetic.\"\"\"\n    return _math_comb(n, k)\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients C(n,k) * C(n,k+1).\n    The sum is calculated for k from 0 to n-1.\n    \"\"\"\n    _validate_n(n)\n    \n    total_sum = 0\n    for k in range(n):\n        coeff1 = C(n, k)\n        coeff2 = C(n, k + 1)\n        total_sum += coeff1 * coeff2\n        \n    return total_sum"}
{"task_id": "Mbpp/590", "solution": "from math import cos, sin\n\nclass RectangularCoordinate:\n    def __init__(self, x: float, y: float):\n        self.x = x\n        self.y = y\n\n    def to_complex(self) -> complex:\n        \"\"\"Return complex(self.x, self.y).\"\"\"\n        return complex(self.x, self.y)\n\nclass Validator:\n    def validate_numeric(self, value) -> bool:\n        \"\"\"Return True if value is a numeric real (int or float and not bool).\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\nclass PolarConverter:\n    def __init__(self):\n        self._validator = Validator()\n\n    def polar_rect(self, r, theta) -> complex:\n        \"\"\"Validate r and theta and return complex(x, y) where x=r*cos(theta), y=r*sin(theta).\"\"\"\n        # Per prompt instructions, validation results do not raise exceptions directly here.\n        self._validator.validate_numeric(r)\n        self._validator.validate_numeric(theta)\n\n        x = r * cos(theta)\n        y = r * sin(theta)\n        rect_coord = RectangularCoordinate(x, y)\n        return rect_coord.to_complex()\n\ndef polar_rect(r, theta):\n    \"\"\"Public API. Accepts numeric r and theta (radians) and returns complex(x, y).\"\"\"\n    converter = PolarConverter()\n    return converter.polar_rect(r, theta)"}
{"task_id": "Mbpp/593", "solution": "from typing import List\n\nclass Octet:\n    \"\"\"Represents an octet of an IPv4 address and handles its normalization.\"\"\"\n    def __init__(self, raw_value: str, position: int):\n        self.rawValue = raw_value\n        self.normalizedValue = \"\"\n        self.position = position\n\n    def normalize(self) -> None:\n        \"\"\"Removes leading zeros from the raw value, handling all-zero octets.\"\"\"\n        stripped_value = self.rawValue.lstrip('0')\n        if not stripped_value:\n            self.normalizedValue = \"0\"\n        else:\n            self.normalizedValue = stripped_value\n\nclass IPv4Address:\n    \"\"\"Represents an IPv4 address, managing its raw and normalized forms.\"\"\"\n    def __init__(self, raw_address: str):\n        self.rawAddress = raw_address\n        self.normalizedAddress = \"\"\n        self.octets: List[Octet] = []\n\n    def parse(self) -> None:\n        \"\"\"Splits the raw address into Octet instances.\"\"\"\n        tokens = self.rawAddress.split('.')\n        for i, token in enumerate(tokens):\n            self.octets.append(Octet(token, i))\n\n    def normalize(self) -> None:\n        \"\"\"Normalizes each octet and reassembles them into the normalized address.\"\"\"\n        for octet in self.octets:\n            octet.normalize()\n        self.normalizedAddress = \".\".join([octet.normalizedValue for octet in self.octets])\n\n    def toString(self) -> str:\n        \"\"\"Returns the normalized IPv4 address string.\"\"\"\n        return self.normalizedAddress\n\nclass RemoveZeroService:\n    \"\"\"Orchestrates the process of removing leading zeros from an IPv4 address.\"\"\"\n    def removezero_ip(self, address: str) -> str:\n        \"\"\"Performs parsing, octet normalization, and reassembly for the given IPv4 address.\"\"\"\n        # The design specifies calling validateFormat, but constraints prevent error handling based on its return.\n        self.validateFormat(address)\n\n        addr = IPv4Address(raw_address=address)\n        addr.parse()\n        addr.normalize()\n        return addr.toString()\n\n    def validateFormat(self, address: str) -> bool:\n        \"\"\"Checks if the address string splits into exactly four tokens.\"\"\"\n        return len(address.split('.')) == 4\n\ndef removezero_ip(address: str) -> str:\n    \"\"\"Removes leading zeros from each octet of an IPv4 address string.\"\"\"\n    svc = RemoveZeroService()\n    return svc.removezero_ip(address)"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(n):\n    \"\"\"\n    Checks if a number is an Armstrong number.\n    An Armstrong number is a number that is the sum of its own digits each\n    raised to the power of the number of digits.\n    \"\"\"\n    if n < 0:\n        return False\n    if n == 0:\n        return True # 0 is considered an Armstrong number by some definitions, and the power of 0 to 1 is 0.\n\n    num_str = str(n)\n    num_digits = len(num_str)\n    sum_of_powers = 0\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        sum_of_powers += digit ** num_digits\n\n    return sum_of_powers == n"}
