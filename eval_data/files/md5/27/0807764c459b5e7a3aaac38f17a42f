{"task_id": "Mbpp/91", "solution": "from typing import List\n\nclass StringItem:\n    \"\"\"Encapsulates a single string value and provides case-sensitive substring checking.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def contains(self, substring: str) -> bool:\n        \"\"\"Checks if the item's value contains the given substring (case-sensitive).\"\"\"\n        return substring in self.value\n\nclass StringList:\n    \"\"\"Lightweight wrapper for a collection of StringItem objects.\"\"\"\n    def __init__(self, items: List[StringItem]):\n        self.items = items\n\n    def length(self) -> int:\n        \"\"\"Returns the number of items in the list.\"\"\"\n        return len(self.items)\n\nclass SearchResult:\n    \"\"\"Simple value object indicating whether a search was successful.\"\"\"\n    def __init__(self, found: bool):\n        self.found = found\n\ndef _to_string_list(list_of_strings: List[str]) -> StringList:\n    \"\"\"Converts a list of strings into a StringList of StringItem objects.\"\"\"\n    items = []\n    for s in list_of_strings:\n        items.append(StringItem(s))\n    return StringList(items)\n\nclass SubstringSearchService:\n    \"\"\"Encapsulates input validation and the core substring search algorithm.\"\"\"\n    def validate_inputs(self, list_of_strings: List[str], substring: str) -> bool:\n        \"\"\"Validates the input types for the search operation.\"\"\"\n        if not isinstance(list_of_strings, list):\n            return False\n        if not all(isinstance(item, str) for item in list_of_strings):\n            return False\n        if not isinstance(substring, str):\n            return False\n        return True\n\n    def find_substring(self, list_of_strings: List[str], substring: str) -> bool:\n        \"\"\"Performs the core substring search logic.\"\"\"\n        string_list = _to_string_list(list_of_strings)\n        for item in string_list.items:\n            if item.contains(substring):\n                return True\n        return False\n\ndef find_substring(list_of_strings: List[str], substring: str) -> bool:\n    \"\"\"\n    Checks if a string is present as a substring in any of the given list of string values.\n    Matching is case-sensitive.\n    \"\"\"\n    service = SubstringSearchService()\n    if not service.validate_inputs(list_of_strings, substring):\n        return False\n    \n    return service.find_substring(list_of_strings, substring)"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(n: int) -> bool:\n    \"\"\"\n    Checks if the given number's decimal digits alternate between two distinct digits.\n    \"\"\"\n    # Convert the absolute value of the number to a string to get its decimal digits.\n    s_n = str(abs(n))\n    digits = [int(digit_char) for digit_char in s_n]\n\n    num_digits = len(digits)\n\n    # A number must have at least two distinct digits to form an alternating pattern.\n    # Numbers with fewer than two digits or with identical first two digits are not undulating.\n    if num_digits < 2:\n        return False\n\n    first_alternating_digit = digits[0]\n    second_alternating_digit = digits[1]\n\n    if first_alternating_digit == second_alternating_digit:\n        return False\n\n    # Verify that all subsequent digits follow the established alternating pattern.\n    for i in range(2, num_digits):\n        if i % 2 == 0:  # Even index should match the first distinct digit\n            if digits[i] != first_alternating_digit:\n                return False\n        else:  # Odd index should match the second distinct digit\n            if digits[i] != second_alternating_digit:\n                return False\n\n    return True"}
{"task_id": "Mbpp/94", "solution": "from typing import Any, List, Tuple\n\ndef index_minimum(tuples: List[Tuple]) -> Any:\n    \"\"\"Return the first element of the tuple whose second element is smallest.\n\n    Behavior for empty or malformed inputs is unspecified in the SRS; relies on language runtime exceptions.\n    \"\"\"\n    selected = min(tuples, key=lambda t: t[1])\n    return selected[0]"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(input_lists):\n    \"\"\"Return the length of the shortest inner list in input_lists as a plain Python int.\n\n    Raises:\n        ValueError: if input_lists is empty (message: \"empty list of lists\").\n        TypeError: if any inner element does not support len() (message: \"invalid inner element type\").\n    \"\"\"\n    if not input_lists:\n        raise ValueError(\"empty list of lists\")\n\n    min_length = float('inf')\n\n    for inner_element in input_lists:\n        try:\n            current_length = len(inner_element)\n        except TypeError:\n            raise TypeError(\"invalid inner element type\")\n        \n        if current_length < min_length:\n            min_length = current_length\n            \n    return min_length"}
{"task_id": "Mbpp/96", "solution": "import math\n\ndef divisor(n):\n    \"\"\"\n    Return the number of positive divisors of n.\n    Precondition: n is expected to be a positive integer.\n    \"\"\"\n    count = 0\n    for d in range(1, int(math.sqrt(n)) + 1):\n        if n % d == 0:\n            if d * d == n:\n                count += 1\n            else:\n                count += 2\n    return count"}
{"task_id": "Mbpp/99", "solution": "from src.models import InputNumber, BinaryString\nfrom src.errors import ValidationError\n\ndef decimal_to_binary(n: int) -> str:\n    \"\"\"\n    Converts a non-negative integer to its binary string representation.\n    Delegates to DecimalToBinaryService for validation and conversion.\n    \"\"\"\n    service = DecimalToBinaryService()\n    return service.decimal_to_binary(n)\n\nclass DecimalToBinaryService:\n    \"\"\"\n    Encapsulates the logic for validating and converting decimal numbers to binary.\n    \"\"\"\n    def __init__(self):\n        self._name = \"DecimalToBinaryService\"\n\n    def decimal_to_binary(self, n: int) -> str:\n        \"\"\"\n        Validates the input and converts the decimal number to its binary equivalent.\n        Raises ValidationError if the input is not a non-negative integer.\n        \"\"\"\n        if not self._validate_input(n):\n            raise ValidationError(\"input must be a non-negative integer\")\n        return self._to_binary(n)\n\n    def _validate_input(self, n) -> bool:\n        \"\"\"\n        Checks if the input `n` is a non-negative integer.\n        \"\"\"\n        input_num = InputNumber(n)\n        return input_num.is_integer() and input_num.is_non_negative()\n\n    def _to_binary(self, n: int) -> str:\n        \"\"\"\n        Converts a non-negative integer to its binary string representation.\n        Handles the special case where n is 0.\n        \"\"\"\n        if n == 0:\n            return BinaryString(\"0\").value\n\n        binary_digits = []\n        temp_n = n\n        while temp_n > 0:\n            remainder = temp_n % 2\n            binary_digits.append(str(remainder))\n            temp_n //= 2\n        return BinaryString(\"\".join(reversed(binary_digits))).value"}
{"task_id": "Mbpp/97", "solution": "from typing import List, Dict, Any\n\ndef flatten(list_of_lists: List[List[Any]]) -> List[Any]:\n    \"\"\"Flattens a list of lists into a single list.\"\"\"\n    flat_list = []\n    for sublist in list_of_lists:\n        for element in sublist:\n            flat_list.append(element)\n    return flat_list\n\ndef count_elements(flat_list: List[Any]) -> Dict[Any, int]:\n    \"\"\"Counts the frequency of each element in a flat list.\"\"\"\n    counts = {}\n    for element in flat_list:\n        counts[element] = counts.get(element, 0) + 1\n    return counts\n\ndef frequency_lists(list_of_lists: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists.\n    Returns the frequencies in a dictionary.\n    \"\"\"\n    flat = flatten(list_of_lists)\n    freq = count_elements(flat)\n    return freq"}
{"task_id": "Mbpp/98", "solution": "from typing import Sequence\nfrom dataclasses import dataclass\n\n# --- src/validator.py ---\nclass Validator:\n    \"\"\"Provides utility methods for validating input sequences.\"\"\"\n    def is_sequence(self, obj) -> bool:\n        \"\"\"Checks if the object is a list or tuple.\"\"\"\n        return isinstance(obj, (list, tuple))\n\n    def not_empty(self, seq) -> bool:\n        \"\"\"Checks if the sequence is not empty.\"\"\"\n        return len(seq) > 0\n\n    def all_numeric(self, seq) -> bool:\n        \"\"\"Checks if all elements in the sequence are numeric (int or float).\"\"\"\n        return all(isinstance(x, (int, float)) for x in seq)\n\n# --- src/data_models.py ---\n@dataclass\nclass NumberSequence:\n    \"\"\"A data holder for a sequence of numbers.\"\"\"\n    values: list[float]\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the sequence.\"\"\"\n        return len(self.values)\n\n@dataclass\nclass CalculationResult:\n    \"\"\"Wraps the result of a calculation.\"\"\"\n    value: float\n\n    def as_float(self) -> float:\n        \"\"\"Returns the wrapped float value.\"\"\"\n        return self.value\n\n# --- src/multiply_num.py (internal class and then the public function) ---\nclass MultiplyNumFunction:\n    \"\"\"Orchestrates validation, product computation, and division for a number sequence.\"\"\"\n\n    def __init__(self):\n        self._validator = Validator()\n\n    def multiply_num(self, numbers: Sequence) -> float:\n        \"\"\"\n        Orchestrates validation, product computation, division,\n        and returns the final float result.\n        \"\"\"\n        self.validate_input(numbers)\n        \n        float_numbers = [float(x) for x in numbers] \n        number_sequence = NumberSequence(values=float_numbers)\n\n        product = self.compute_product(number_sequence.values)\n        division_result = self.divide_by_length(product, number_sequence.length())\n        \n        return CalculationResult(value=division_result).as_float()\n\n    def validate_input(self, numbers: Sequence) -> None:\n        \"\"\"Validates the input sequence based on business rules.\"\"\"\n        if not self._validator.is_sequence(numbers):\n            raise TypeError(\"Input must be a list or tuple.\")\n        if not self._validator.not_empty(numbers):\n            raise ValueError(\"Input sequence must not be empty.\")\n        if not self._validator.all_numeric(numbers):\n            raise TypeError(\"All elements in the sequence must be numeric (int or float).\")\n\n    def compute_product(self, numbers_values: list[float]) -> float:\n        \"\"\"Computes the product of all numbers in the sequence.\"\"\"\n        product = 1.0\n        for num in numbers_values:\n            product *= num\n        return product\n\n    def divide_by_length(self, product: float, length: int) -> float:\n        \"\"\"Divides the product by the length of the sequence using float division.\"\"\"\n        return product / float(length)\n\n\ndef multiply_num(numbers: Sequence) -> float:\n    \"\"\"\n    Multiplies all numbers in a list or tuple and divides by its length.\n    Raises TypeError for invalid input types or non-numeric elements.\n    Raises ValueError for an empty sequence.\n    \"\"\"\n    calculator = MultiplyNumFunction()\n    return calculator.multiply_num(numbers)"}
{"task_id": "Mbpp/101", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for validation errors in kth_element.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\ndef kth_element(array, k):\n    \"\"\"Finds the kth element in the given array using 1-based indexing.\"\"\"\n    if not isinstance(k, int):\n        raise ValidationError(\"k must be an integer\")\n    \n    if k < 1:\n        raise ValidationError(\"k must be >= 1\")\n    \n    if k > len(array):\n        raise ValidationError(\"k must be <= length of array\")\n    \n    return array[k - 1]"}
{"task_id": "Mbpp/102", "solution": "class Word:\n    \"\"\"Helper class representing a word fragment and providing capitalizeFirst behavior.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def capitalizeFirst(self) -> str:\n        \"\"\"Capitalizes the first character of the word, leaving the rest unchanged.\"\"\"\n        if not self.text:\n            return \"\"\n        return self.text[0].upper() + self.text[1:]\n\nclass SnakeToCamelConverter:\n    \"\"\"Encapsulates the conversion algorithm from snake_case to PascalCase.\"\"\"\n    def convert(self, input_string: str) -> str:\n        \"\"\"Converts a snake_case string to PascalCase.\"\"\"\n        words = self.splitOnUnderscore(input_string)\n        camel_cased_words = [self.capitalizeFirst(word) for word in words]\n        return \"\".join(camel_cased_words)\n\n    def splitOnUnderscore(self, input_string: str) -> list[str]:\n        \"\"\"Splits the input string into a list of words using '_' as a delimiter.\"\"\"\n        return input_string.split('_')\n\n    def capitalizeFirst(self, word: str) -> str:\n        \"\"\"Capitalizes the first character of a given word string by delegating to the Word helper.\"\"\"\n        word_obj = Word(word)\n        return word_obj.capitalizeFirst()\n\ndef snake_to_camel(input_string: str) -> str:\n    \"\"\"\n    Converts a snake case string to camel case (PascalCase) string.\n    Example: 'python_program' -> 'PythonProgram'\n    \"\"\"\n    converter = SnakeToCamelConverter()\n    return converter.convert(input_string)"}
{"task_id": "Mbpp/100", "solution": "class IntegerInput:\n    \"\"\"Represent a validated integer input.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass PalindromeResult:\n    \"\"\"Represent the computed palindrome integer result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass NextSmallestPalindromeFunction:\n    \"\"\"Encapsulate the algorithm to compute the smallest palindrome integer strictly greater than the provided IntegerInput.\"\"\"\n    def compute(self, input_obj: IntegerInput) -> int:\n        n = input_obj.value\n        s = str(n)\n        length = len(s)\n\n        # Step 1: Form a candidate palindrome P1 by mirroring the left half of the input number.\n        # The 'left_part_for_mirror' includes the middle digit if the original number's length is odd.\n        left_part_for_mirror = s[: (length + 1) // 2]\n        \n        # Determine the suffix to make it a palindrome based on length parity.\n        if length % 2 == 1:\n            # Odd length: suffix is the reverse of 'left_part_for_mirror' excluding its last character (the middle digit).\n            suffix = left_part_for_mirror[:-1][::-1]\n        else:\n            # Even length: suffix is simply the reverse of 'left_part_for_mirror'.\n            suffix = left_part_for_mirror[::-1]\n        \n        p1_str = left_part_for_mirror + suffix\n        p1 = int(p1_str)\n\n        # Step 2: If P1 is strictly greater than n, it is the answer.\n        if p1 > n:\n            return p1\n        \n        # Step 3: If P1 <= n, we need to increment the 'left_part' to find a larger palindrome.\n        # This incremented 'left_part' will form the first half of the new palindrome.\n        left_part_num = int(left_part_for_mirror)\n        \n        incremented_left_part_num = left_part_num + 1\n        incremented_left_part_str = str(incremented_left_part_num)\n\n        # Check for a carry-over that increases the total digit count of the palindrome (e.g., 9 -> 11, 99 -> 101).\n        if len(incremented_left_part_str) > len(left_part_for_mirror):\n            # If the incremented left part results in an extra digit, the new palindrome will have `length + 1` digits.\n            # It will be \"1\" followed by `new_length - 2` zeros, then \"1\".\n            new_length = length + 1\n            result_str = \"1\" + \"0\" * (new_length - 2) + \"1\"\n            return int(result_str)\n        \n        # No length increase in the 'left_part'. Reconstruct the palindrome with the incremented left part.\n        # Determine the new suffix based on the original length parity.\n        if length % 2 == 1:\n            # Odd length: suffix is the reverse of 'incremented_left_part_str' excluding its last char.\n            new_suffix = incremented_left_part_str[:-1][::-1]\n        else:\n            # Even length: suffix is the reverse of 'incremented_left_part_str'.\n            new_suffix = incremented_left_part_str[::-1]\n        \n        p2_str = incremented_left_part_str + new_suffix\n        return int(p2_str)\n\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"Public API: accept single integer n and return next smallest palindrome integer (> n).\"\"\"\n    input_obj = IntegerInput(n)\n    npf = NextSmallestPalindromeFunction()\n    result_int = npf.compute(input_obj)\n    return result_int"}
{"task_id": "Mbpp/103", "solution": "class Permutation:\n    \"\"\"Conceptual domain model for a permutation.\"\"\"\n    def __init__(self, n: int, ascents: int):\n        self.n = n\n        self.ascents = ascents\n\nclass EulerianNumber:\n    \"\"\"Value object encapsulating the computed Eulerian number.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def get_value(self) -> int:\n        \"\"\"Returns the integer value of the Eulerian number.\"\"\"\n        return self.value\n\nclass Parameters:\n    \"\"\"Holds n and m parameters and validates their types and domain constraints.\"\"\"\n    def __init__(self, n: int, m: int):\n        self.n = n\n        self.m = m\n\n    def validate(self):\n        \"\"\"Validates n and m, raising ValueError for invalid inputs.\"\"\"\n        if not isinstance(self.n, int):\n            raise ValueError(\"Parameter 'n' must be an integer.\")\n        if not isinstance(self.m, int):\n            raise ValueError(\"Parameter 'm' must be an integer.\")\n\n        if self.n < 0:\n            raise ValueError(\"n cannot be negative.\")\n\n        if self.n == 0:\n            if self.m != 0:\n                raise ValueError(\"For n=0, m must be 0 (a(0,0)=1).\")\n        else: # n > 0\n            if self.m < 0 or self.m >= self.n:\n                raise ValueError(f\"For n={self.n}, m must be in the range 0 <= m < n.\")\n\nclass EulerianCalculator:\n    \"\"\"Orchestrates validation and computation of Eulerian numbers.\"\"\"\n    def eulerian_num(self, n: int, m: int) -> int:\n        \"\"\"\n        Calculates the Eulerian number a(n, m) after validating inputs.\n        Delegates to compute_dp for calculation.\n        \"\"\"\n        params = Parameters(n, m)\n        params.validate()\n\n        result_value = self.compute_dp(n, m)\n        return EulerianNumber(result_value).get_value()\n\n    def compute_dp(self, n: int, m: int) -> int:\n        \"\"\"\n        Computes the Eulerian number a(n, m) using dynamic programming.\n        Assumes n and m are already validated.\n        \"\"\"\n        # dp[i][j] stores a(i, j)\n        dp = [[0 for _ in range(n + 1)] for _ in range(n + 1)]\n\n        # Base case: a(0, 0) = 1\n        dp[0][0] = 1\n\n        for i in range(1, n + 1):\n            for j in range(i): # m ranges from 0 to i-1\n                term1 = (j + 1) * dp[i-1][j]\n                term2 = (i - j) * (dp[i-1][j-1] if j > 0 else 0)\n                dp[i][j] = term1 + term2\n        \n        return dp[n][m]\n\n    def compute_recursive(self, n: int, m: int, memo: dict = None) -> int:\n        \"\"\"\n        Computes the Eulerian number a(n, m) using a recursive approach with memoization.\n        This method is provided as an alternative to compute_dp.\n        \"\"\"\n        if memo is None:\n            memo = {}\n        if (n, m) in memo:\n            return memo[(n, m)]\n\n        # Base cases\n        if m < 0 or m >= n:\n            return 0\n        if n == 0 and m == 0:\n            return 1\n        \n        # Recurrence relation: A(n, k) = (k+1) * A(n-1, k) + (n-k) * A(n-1, k-1)\n        res = (m + 1) * self.compute_recursive(n - 1, m, memo) + \\\n              (n - m) * self.compute_recursive(n - 1, m - 1, memo)\n        memo[(n, m)] = res\n        return res\n\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Finds the Eulerian number a(n, m), the number of permutations of {1..n}\n    with exactly m ascents.\n    \"\"\"\n    calculator = EulerianCalculator()\n    return calculator.eulerian_num(n, m)"}
{"task_id": "Mbpp/104", "solution": "from typing import Sequence, List\n\ndef sort_sublists(input_sequence: Sequence[Sequence[str]]) -> List[List[str]]:\n    \"\"\"Accepts a sequence of sublists of strings, returns a list of lists with each inner list sorted.\n\n    Args:\n        input_sequence: Sequence[Sequence[str]] -- e.g., tuple or list of sublists of strings\n\n    Returns:\n        List[List[str]] -- list of sorted inner lists with outer ordering preserved\n    \"\"\"\n    result: List[List[str]] = []\n    for sublist in input_sequence:\n        sorted_inner = sorted(sublist)\n        result.append(sorted_inner)\n    return result"}
