{"task_id": "Mbpp/801", "solution": "import collections\nfrom dataclasses import dataclass\nfrom typing import Any\n\n@dataclass\nclass InputTriple:\n  a: int\n  b: int\n  c: int\n\n@dataclass\nclass Result:\n  count: int\n\ndef test_three_equal(a: int, b: int, c: int) -> int:\n  \"\"\"\n  Counts the number of equal integers among the three inputs a, b, and c.\n  Returns 3 if all are equal, 2 if exactly two are equal, and 0 if all are different.\n  \"\"\"\n  if a == b and b == c:\n    return 3\n  elif a == b or b == c or a == c:\n    return 2\n  else:\n    return 0"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(n, d):\n    \"\"\"Return 32-bit left-rotation of integer n by d positions.\n    The number is treated as 32-bit, and rotation is done modulo 32.\n    \"\"\"\n    MASK = 0xFFFFFFFF\n    \n    n_masked = n & MASK\n    d_effective = d % 32\n    \n    if d_effective == 0:\n        return n_masked\n    else:\n        # Perform left rotation: shift left and OR with bits shifted from right\n        # Mask the result again to ensure it remains within 32 bits\n        result = ((n_masked << d_effective) | (n_masked >> (32 - d_effective))) & MASK\n        return result"}
{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(n) -> bool:\n    \"\"\"\n    Return True if exists integer k such that k*k == n; otherwise False.\n    Assumes caller provides numeric n.\n    \"\"\"\n    if n < 0:\n        return False\n    # For non-negative numbers, calculate the integer square root.\n    root = math.isqrt(n)\n    return root * root == n"}
{"task_id": "Mbpp/804", "solution": "from typing import List, Union, Iterator\n\nclass Number:\n    \"\"\"Represents a numeric value and provides an `is_even` helper.\"\"\"\n    def __init__(self, value: Union[int, float]):\n        self._value = value\n\n    @property\n    def value(self) -> Union[int, float]:\n        return self._value\n\n    def is_even(self) -> bool:\n        \"\"\"Checks if the number is even. Integral floats like 2.0 are considered even.\"\"\"\n        # Check if it's an integral number (e.g., 2, 3, 2.0, -4.0)\n        # and then check divisibility by 2.\n        if self._value == int(self._value):\n            return int(self._value) % 2 == 0\n        return False # Non-integral floats are not considered even\n\nclass NumberList:\n    \"\"\"Container for a list of Number instances, coercing primitives as needed.\"\"\"\n    def __init__(self, items: List[Union[Number, int, float]]):\n        self._numbers: List[Number] = []\n        for item in items:\n            if isinstance(item, Number):\n                self._numbers.append(item)\n            else:\n                self._numbers.append(Number(item))\n\n    def __iter__(self) -> Iterator[Number]:\n        return iter(self._numbers)\n\n    def any_is_even(self) -> bool:\n        \"\"\"Returns True if at least one number in the list is even; False otherwise.\"\"\"\n        for number in self._numbers:\n            if number.is_even():\n                return True\n        return False\n\nclass Result:\n    \"\"\"A simple holder for a boolean result value.\"\"\"\n    def __init__(self, value: bool):\n        self._value = value\n\n    @property\n    def value(self) -> bool:\n        return self._value\n\ndef is_product_even(numbers: List[Union[int, float, Number]]) -> bool:\n    \"\"\"Return True if the product of elements in `numbers` is even; False otherwise.\n\n    `numbers` may contain numeric primitives (int/float) or domain.Number instances.\n    Returns False for an empty list as there are no even factors.\n    \"\"\"\n    number_list = NumberList(numbers)\n    return number_list.any_is_even()"}
