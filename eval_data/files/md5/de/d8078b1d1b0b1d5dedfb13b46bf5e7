{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    This uses the fast doubling method for efficient computation.\n    \"\"\"\n\n    # Recursive helper for fast doubling, computes (F_k, F_{k+1}) for standard 0-indexed sequence.\n    def _fast_doubling(k: int) -> tuple[int, int]:\n        if k == 0:\n            return (0, 1)  # Base case: (F_0, F_1)\n        \n        a, b = _fast_doubling(k // 2)  # a=F_m, b=F_{m+1} where m=k//2\n        \n        c = a * (2 * b - a)  # F_{2m}\n        d = a * a + b * b    # F_{2m+1}\n        \n        if k % 2 == 0:\n            return (c, d)  # k=2m, return (F_{2m}, F_{2m+1})\n        else:\n            return (d, c + d)  # k=2m+1, return (F_{2m+1}, F_{2m+2} = F_{2m+1} + F_{2m})\n\n    # The function fib(n) maps directly to F_n in the standard 0-indexed Fibonacci sequence.\n    # We call _fast_doubling(n) to get (F_n, F_{n+1}) and return F_n.\n    f_n, _ = _fast_doubling(n)\n    return f_n"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\"\"\"\n    largest_factor = 1\n\n    # Divide by 2 until n is odd\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Check for odd factors from 3 up to sqrt(n)\n    f = 3\n    while f * f <= n:\n        while n % f == 0:\n            largest_factor = f\n            n //= f\n        f += 2\n\n    # If n is still greater than 1, the remaining n is the largest prime factor\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\"\"\"\n\n    class ListUtilsError(Exception):\n        \"\"\"Base exception for the listutils package.\"\"\"\n        def __init__(self, message: str, cause: Exception = None) -> None:\n            super().__init__(message)\n            self.message = message\n            self.cause = cause\n\n    class InvalidInputError(ListUtilsError):\n        \"\"\"Raised for invalid inputs or validation/sort errors.\"\"\"\n        def __init__(self, message: str, field: str = None, cause: Exception = None) -> None:\n            super().__init__(message, cause)\n            self.field = field\n\n    class ListDTO:\n        \"\"\"Encapsulates validated list data; provides utility to convert to set.\"\"\"\n        def __init__(self, elements) -> None:\n            self.elements = list(elements)\n\n        def to_set(self):\n            \"\"\"Returns a set of the encapsulated elements.\"\"\"\n            return set(self.elements)\n\n    class ListValidator:\n        \"\"\"Validates that a given object is list-like and its elements are hashable and comparable.\"\"\"\n        def validate_list(self, obj, field_name: str = \"list\") -> ListDTO:\n            \"\"\"Validates an object, returning a ListDTO or raising InvalidInputError.\"\"\"\n            if not isinstance(obj, list):\n                raise InvalidInputError(f\"{field_name} must be a list.\", field=field_name)\n\n            for e in obj:\n                try:\n                    hash(e)\n                except TypeError as exc:\n                    raise InvalidInputError(\n                        f\"Element in {field_name} is not hashable: {e!r}\", field=field_name, cause=exc\n                    )\n\n            dto = ListDTO(obj)\n\n            # Ensure all elements within the list are mutually comparable for sorting.\n            if len(dto.elements) > 1:\n                try:\n                    sorted(list(dto.elements))\n                except TypeError as exc:\n                    raise InvalidInputError(\n                        f\"Elements in {field_name} are not mutually comparable for sorting (e.g., mixed types within the list).\",\n                        field=field_name,\n                        cause=exc,\n                    )\n            return dto\n\n    class CommonFinder:\n        \"\"\"Computes sorted unique common elements between two input lists with validation.\"\"\"\n        def __init__(self, validator: ListValidator = None) -> None:\n            self._validator = validator or ListValidator()\n\n        def find_common(self, l1_raw, l2_raw) -> list:\n            \"\"\"Validates inputs, computes intersection set, sorts results, and returns a list.\"\"\"\n            dto1 = self._validator.validate_list(l1_raw, field_name=\"l1\")\n            dto2 = self._validator.validate_list(l2_raw, field_name=\"l2\")\n\n            s1 = dto1.to_set()\n            s2 = dto2.to_set()\n\n            inter = self._intersect_sets(s1, s2)\n\n            try:\n                result = sorted(inter)\n            except TypeError as exc:\n                raise InvalidInputError(\"Elements are not mutually comparable for sorting.\", cause=exc)\n            return result\n\n        def _intersect_sets(self, s1, s2) -> set:\n            \"\"\"Performs set intersection, iterating over the smaller set for efficiency.\"\"\"\n            if len(s1) <= len(s2):\n                return {x for x in s1 if x in s2}\n            return {x for x in s2 if x in s1}\n\n    # Main logic for the common function, acting as a convenience wrapper.\n    validator = ListValidator()\n    finder = CommonFinder(validator=validator)\n    return finder.find_common(l1, l2)"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\"\"\"\n    if len(l) < 2:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(1, len(l)):\n        if l[i] < l[i-1]:\n            is_increasing = False\n        if l[i] > l[i-1]:\n            is_decreasing = False\n        \n        # If it's neither increasing nor decreasing, it's not monotonic\n        if not (is_increasing or is_decreasing):\n            return False\n            \n    return True"}
