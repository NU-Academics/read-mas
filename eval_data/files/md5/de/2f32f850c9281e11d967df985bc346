{"task_id": "HumanEval/0", "solution": "```python\nfrom typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    # 1. Input Validation\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n    if not isinstance(threshold, (int, float)):\n        raise TypeError(\"Input 'threshold' must be a number (int or float).\")\n    if threshold < 0:\n        raise ValueError(\"Input 'threshold' must be a non-negative number.\")\n    \n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise TypeError(\"All elements in 'numbers' must be numbers (int or float).\")\n\n    # 2. Handle Edge Cases\n    if len(numbers) < 2:\n        return False\n\n    # 3. Sort the List\n    # Create a sorted copy to preserve the original list\n    sorted_numbers = sorted(numbers)\n\n    # 4. Iterate and Check Adjacent Elements\n    for i in range(len(sorted_numbers) - 1):\n        # Since the list is sorted, sorted_numbers[i+1] >= sorted_numbers[i],\n        # so abs() is not strictly needed for the difference.\n        diff = sorted_numbers[i+1] - sorted_numbers[i]\n        if diff < threshold:\n            return True  # Found a pair closer than the threshold\n\n    # 5. No Close Elements Found\n    return False\n```"}
{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    # Remove all spaces from the input string\n    cleaned_string = paren_string.replace(' ', '')\n\n    groups = []\n    current_group_chars = []  # To build the current group efficiently\n    balance = 0\n\n    for char in cleaned_string:\n        current_group_chars.append(char)\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        # If balance returns to 0, it means we have found a complete, balanced group\n        if balance == 0:\n            groups.append(\"\".join(current_group_chars))\n            current_group_chars = []  # Reset for the next group\n\n    return groups\n```"}
{"task_id": "HumanEval/2", "solution": "```python\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    # For a positive floating point number, the integer part is obtained\n    # by truncating towards zero, which is equivalent to taking the floor.\n    # The decimal part is then the original number minus its integer part.\n    return number - int(number)\n```"}
{"task_id": "HumanEval/3", "solution": "```python\ndef below_zero(operations: list[int]) -> bool:\n    \"\"\"\n    Simulates bank account operations and determines if the balance ever falls below zero.\n\n    The account starts with a zero balance. For each operation, the balance is updated.\n    If at any point the balance becomes less than zero, the function immediately returns True.\n    If all operations are processed and the balance never falls below zero, the function\n    returns False.\n\n    Args:\n        operations: A list of integers representing the bank account operations.\n                    Positive integers increase the balance, negative integers decrease it.\n\n    Returns:\n        True if the balance falls below zero at any point during the operations,\n        False otherwise.\n\n    Examples:\n        >>> below_zero([1, 2, 3])\n        False\n        # Balance sequence: 0 -> 1 -> 3 -> 6 (never below zero)\n\n        >>> below_zero([1, 2, -4, 5])\n        True\n        # Balance sequence: 0 -> 1 -> 3 -> -1 (at this point, it's below zero, so return True)\n\n        >>> below_zero([-10])\n        True\n        # Balance sequence: 0 -> -10 (below zero)\n\n        >>> below_zero([])\n        False\n        # No operations, balance remains 0 (never below zero)\n\n        >>> below_zero([5, -3, -3])\n        True\n        # Balance sequence: 0 -> 5 -> 2 -> -1 (below zero)\n\n        >>> below_zero([0, 0, 0])\n        False\n        # Balance sequence: 0 -> 0 -> 0 -> 0 (never below zero)\n    \"\"\"\n    balance = 0  # Initialize the account balance to zero\n\n    # Iterate through each operation in the provided list\n    for op in operations:\n        balance += op  # Update the balance with the current operation\n\n        # After each update, check if the balance has fallen below zero\n        if balance < 0:\n            return True  # If it has, immediately return True as per the requirement\n\n    # If the loop completes without the balance ever falling below zero,\n    # it means the account always maintained a non-negative balance.\n    return False\n```"}
{"task_id": "HumanEval/4", "solution": "```python\nfrom typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        # Mean Absolute Deviation is undefined for an empty dataset.\n        # Following the convention of functions like statistics.mean,\n        # we raise a ValueError for an empty input list.\n        raise ValueError(\"Input list cannot be empty for Mean Absolute Deviation calculation.\")\n\n    # Step 1: Calculate the mean of the dataset\n    data_mean = sum(numbers) / len(numbers)\n\n    # Step 2: Calculate the sum of absolute differences between each number and the mean\n    sum_of_abs_diffs = sum(abs(x - data_mean) for x in numbers)\n\n    # Step 3: Calculate the Mean Absolute Deviation by dividing the sum of absolute differences\n    # by the number of elements in the dataset.\n    mad = sum_of_abs_diffs / len(numbers)\n\n    return mad\n```"}
{"task_id": "HumanEval/5", "solution": "```python\nfrom typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    >>> intersperse([5], 0)\n    [5]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result\n```"}
{"task_id": "HumanEval/6", "solution": "```python\nimport collections\nfrom typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    results: List[int] = []\n\n    # FR.1: Split the input string into individual paren groups\n    # Using split() without arguments handles multiple spaces and leading/trailing spaces correctly\n    # by producing empty strings which are then filtered.\n    individual_groups = paren_string.split() # This is more robust than split(' ')\n\n    # Iterate through each identified paren group\n    for group_str in individual_groups:\n        current_depth = 0\n        max_depth_for_group = 0\n\n        # FR.2: Iterate through each character in the current group to calculate its max depth\n        for char in group_str:\n            if char == '(':\n                current_depth += 1\n                # Update the maximum depth found for this group\n                max_depth_for_group = max(max_depth_for_group, current_depth)\n            elif char == ')':\n                # Decrement current depth. Assumes well-formed parentheses for simple depth tracking.\n                current_depth -= 1\n            # Any other characters are ignored, as per problem context only '(' and ')' are expected.\n\n        # FR.3, FR.4: Add the maximum depth for the current group to the results list\n        results.append(max_depth_for_group)\n\n    # FR.3: Return the final list of maximum depths\n    return results\n```"}
{"task_id": "HumanEval/7", "solution": "```python\ndef filter_by_substring(strings: list[str], substring: str) -> list[str]:\n    \"\"\"\n    Filters a list of strings, returning only those that contain a specified substring.\n\n    Args:\n        strings: A list of strings to filter.\n        substring: The substring to search for within each string.\n\n    Returns:\n        A new list containing only the strings from the input `strings` list\n        that contain the `substring`.\n    \"\"\"\n    filtered_list = []\n    for s in strings:\n        if substring in s:\n            filtered_list.append(s)\n    return filtered_list\n```"}
{"task_id": "HumanEval/8", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n\n    for number in numbers:\n        total_sum += number\n        total_product *= number\n\n    return (total_sum, total_product)\n```"}
{"task_id": "HumanEval/9", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    # Initialize current_max with a very small number, or the first element,\n    # to ensure it correctly picks up the maximum from the sequence.\n    # Using float('-inf') is robust for any integer range.\n    current_max = float('-inf')\n\n    for number in numbers:\n        # Update current_max to be the maximum between its current value and the current number\n        current_max = max(current_max, number)\n        # Append the current maximum to the result list\n        result.append(current_max)\n\n    return result\n```"}
{"task_id": "HumanEval/10", "solution": "```python\ndef is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    n = len(string)\n\n    # Iterate through all possible starting positions for a postfix.\n    # When i=0, the postfix is the entire string.\n    # As i increases, the postfix (string[i:]) becomes shorter.\n    # The first palindromic postfix found will be the longest one.\n    for i in range(n + 1):\n        postfix = string[i:]\n        if is_palindrome(postfix):\n            # We found the longest palindromic postfix.\n            # The part of the string before this postfix is string[:i].\n            # This is the prefix we need to reverse and append.\n            prefix_to_reverse = string[:i]\n            reversed_prefix = prefix_to_reverse[::-1]\n            \n            # Concatenate the original string with the reversed prefix.\n            return string + reversed_prefix\n    \n    # This line should theoretically not be reached because an empty string\n    # (string[n:]) is always a palindrome, ensuring a return value when i=n.\n    # However, as a safeguard, an empty string is returned if no palindrome is found,\n    # though the algorithm guarantees one (at least the empty string postfix).\n    return \"\"\n```"}
{"task_id": "HumanEval/11", "solution": "```python\ndef string_xor(a: str, b: str) -> str:\n    # 7.1 Input Validation\n\n    # Ensure both inputs are strings\n    if not isinstance(a, str) or not isinstance(b, str):\n        raise TypeError(\"Both inputs 'a' and 'b' must be strings.\")\n\n    # Check if the strings have the same length\n    if len(a) != len(b):\n        raise ValueError(\"Input strings 'a' and 'b' must have the same length.\")\n\n    # Validate characters: ensure only '0' and '1' are present\n    valid_chars = {'0', '1'}\n    for char in a:\n        if char not in valid_chars:\n            raise ValueError(f\"Input string 'a' contains invalid character: '{char}'. Only '0' and '1' are allowed.\")\n    for char in b:\n        if char not in valid_chars:\n            raise ValueError(f\"Input string 'b' contains invalid character: '{char}'. Only '0' and '1' are allowed.\")\n\n    # 7.2 Core Logic\n\n    # Use a list to store resulting characters for efficient string building\n    result_chars = []\n\n    # Iterate through the strings simultaneously\n    for i in range(len(a)):\n        char_a = a[i]\n        char_b = b[i]\n\n        # Perform the XOR operation based on character values\n        if char_a == char_b:\n            # '0' XOR '0' = '0'\n            # '1' XOR '1' = '0'\n            result_chars.append('0')\n        else:\n            # '0' XOR '1' = '1'\n            # '1' XOR '0' = '1'\n            result_chars.append('1')\n\n    # 7.3 Return Result\n\n    # Join the list of characters to form the final result string\n    return \"\".join(result_chars)\n```"}
