{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Helper to calculate coefficients of the derivative polynomial.\n    def _poly_derivative_coeffs(coeffs: list) -> list:\n        if len(coeffs) <= 1:\n            return [0.0]\n        return [coeff * (i + 1) for i, coeff in enumerate(coeffs[1:])]\n\n    # Helper to evaluate the derivative of the polynomial.\n    def _poly_derivative(coeffs: list, val_x: float) -> float:\n        deriv_coeffs = _poly_derivative_coeffs(coeffs)\n        return poly(deriv_coeffs, val_x)\n\n    # Newton-Raphson method parameters\n    x = 0.0 # Initial guess\n    max_iterations = 1000\n    tolerance = 1e-7\n\n    for _ in range(max_iterations):\n        y = poly(xs, x)\n        y_prime = _poly_derivative(xs, x)\n\n        if abs(y) < tolerance:\n            return x\n\n        # If the derivative is too small, Newton-Raphson method struggles.\n        # Perturb x slightly to attempt to move out of a flat region or extremum.\n        if abs(y_prime) < tolerance:\n            x += 0.01\n            continue\n\n        x_new = x - y / y_prime\n\n        if abs(x_new - x) < tolerance:\n            return x_new\n\n        x = x_new\n\n    # If max_iterations reached, return the current best estimate.\n    return x"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if len(l) <= 1:\n        return l.copy()\n\n    # Create a copy to avoid mutating the original list.\n    result = l.copy()\n\n    # Extract even-indexed elements and their original indices.\n    even_indices = list(range(0, len(l), 2))\n    even_values = [l[i] for i in even_indices]\n\n    # Sort the collected even-indexed values.\n    even_values.sort()\n\n    # Place sorted values back into the result list at their original even positions.\n    for idx, val in zip(even_indices, even_values):\n        result[idx] = val\n\n    return result"}
{"task_id": "HumanEval/36", "solution": "class InputNumber:\n    \"\"\"Holds the raw input number.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass QualifiedNumber:\n    \"\"\"Encapsulates a candidate number and its divisibility flags.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n        self.divisibleBy11 = (value % 11 == 0)\n        self.divisibleBy13 = (value % 13 == 0)\n\nclass Digit7Counter:\n    \"\"\"Provides a static method to count digit '7' occurrences.\"\"\"\n    @staticmethod\n    def countOccurrences(number: int) -> int:\n        \"\"\"Counts the occurrences of the digit '7' in a number.\"\"\"\n        return str(number).count('7')\n\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    input_num = InputNumber(n)\n    total_count = 0\n\n    for value in range(1, input_num.value):\n        qnum = QualifiedNumber(value)\n        if qnum.divisibleBy11 or qnum.divisibleBy13:\n            total_count += Digit7Counter.countOccurrences(value)\n\n    return total_count"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # Split string into groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # Reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "import math\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    # Helper function to check for primality\n    def is_prime(num):\n        if num < 2:\n            return False\n        for i in range(2, int(math.sqrt(num)) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    count = 0\n    a, b = 0, 1\n    found_primes = []\n\n    while count < n:\n        fib_num = b\n        if is_prime(fib_num):\n            found_primes.append(fib_num)\n            count += 1\n        a, b = b, a + b\n    \n    return found_primes[n-1]"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    l.sort()  # Sort the list to enable the two-pointer approach\n\n    for i in range(n - 2):\n        left = i + 1\n        right = n - 1\n\n        while left < right:\n            current_sum = l[i] + l[left] + l[right]\n\n            if current_sum == 0:\n                return True  # Found a triplet that sums to zero\n            elif current_sum < 0:\n                left += 1  # Need a larger sum, move left pointer right\n            else: # current_sum > 0\n                right -= 1 # Need a smaller sum, move right pointer left\n    \n    return False # No such triplet found after checking all combinations"}
{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int):\n    \"\"\"\n    Imagine a road that's a perfectly straight infinitely long line.\n    n cars are driving left to right;  simultaneously, a different set of n cars\n    are driving right to left.   The two sets of cars start out being very far from\n    each other.  All cars move in the same speed.  Two cars are said to collide\n    when a car that's moving left to right hits a car that's moving right to left.\n    However, the cars are infinitely sturdy and strong; as a result, they continue moving\n    in their trajectory as if they did not collide.\n\n    This function outputs the number of such collisions.\n    \"\"\"\n    return n * n"}
{"task_id": "HumanEval/42", "solution": "def incr_list(l: list) -> list:\n    \"\"\"Return list with elements incremented by 1.\"\"\"\n    return [x + 1 for x in l]"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    Returns string representation after the conversion.\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    res = \"\"\n    while x > 0:\n        res = str(x % base) + res\n        x //= base\n    return res"}
