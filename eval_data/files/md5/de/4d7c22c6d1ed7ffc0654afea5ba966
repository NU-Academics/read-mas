{"task_id": "HumanEval/56", "solution": "class BracketString:\n    def __init__(self, content: str):\n        self.content = content\n        self.is_balanced = False\n\nclass BracketValidator:\n    @staticmethod\n    def validate(bs: BracketString) -> bool:\n        \"\"\"\n        Validates if the BracketString has correctly balanced brackets.\n        Uses a stack-like counter for validation.\n        \"\"\"\n        stack = 0\n        for ch in bs.content:\n            if ch == '<':\n                stack += 1\n            elif ch == '>':\n                if stack == 0:\n                    return False\n                stack -= 1\n            else:\n                return False\n        return stack == 0\n\ndef correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    bs = BracketString(brackets)\n    return BracketValidator.validate(bs)"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    increasing = False\n    decreasing = False\n\n    # Determine initial trend\n    i = 1\n    while i < len(l) and l[i] == l[i-1]:\n        i += 1\n    \n    if i == len(l): # All elements are the same\n        return True\n    \n    if l[i] > l[i-1]:\n        increasing = True\n    else:\n        decreasing = True\n\n    # Check for consistency\n    for j in range(i + 1, len(l)):\n        if l[j] > l[j-1]:\n            if decreasing:\n                return False\n        elif l[j] < l[j-1]:\n            if increasing:\n                return False\n    return True"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n\n    \"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_elements = list(set1.intersection(set2))\n    common_elements.sort()\n    return common_elements"}
