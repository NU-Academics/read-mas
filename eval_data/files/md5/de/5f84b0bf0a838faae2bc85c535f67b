{"task_id": "Mbpp/459", "solution": "def remove_uppercase(s: str) -> str:\n    \"\"\"\n    Removes all maximal contiguous substrings consisting solely of ASCII uppercase letters from the string.\n    \"\"\"\n    result_chars: list[str] = []\n    i = 0\n    n = len(s)\n\n    def _is_ascii_upper(char: str) -> bool:\n        \"\"\"Checks if a character is an ASCII uppercase letter (A-Z).\"\"\"\n        return 'A' <= char <= 'Z'\n\n    while i < n:\n        if _is_ascii_upper(s[i]):\n            # Skip the entire contiguous run of uppercase letters\n            j = i + 1\n            while j < n and _is_ascii_upper(s[j]):\n                j += 1\n            i = j\n        else:\n            # Append non-uppercase character to the result\n            result_chars.append(s[i])\n            i += 1\n    return ''.join(result_chars)"}
{"task_id": "Mbpp/458", "solution": "from typing import Any, Union\nclass RectangleError(Exception):\n    \"\"\"Base exception for rectangle area application.\"\"\"\n    pass\nclass InvalidTypeError(RectangleError):\n    \"\"\"Raised when an input is not of the expected numeric type.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass InvalidDimensionError(RectangleError):\n    \"\"\"Raised when a dimension (width or height) is invalid (e.g., non-positive).\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass Rectangle:\n    \"\"\"Represents a rectangle with width and height.\"\"\"\n    def __init__(self, width: float, height: float) -> None:\n        self._width: float = width\n        self._height: float = height\n\n    @property\n    def width(self) -> float:\n        return self._width\n\n    @property\n    def height(self) -> float:\n        return self._height\n\n    def area(self) -> float:\n        \"\"\"Calculates and returns the area of the rectangle.\"\"\"\n        return self._width * self._height\nclass Validator:\n    \"\"\"Provides validation logic for rectangle dimensions.\"\"\"\n    def validate_dimension(self, name: str, value: Any) -> float:\n        \"\"\"Validates a single dimension, ensuring it's numeric and positive.\"\"\"\n        try:\n            val = float(value)\n        except (TypeError, ValueError):\n            raise InvalidTypeError(f\"{name} must be a number; got {value!r}\")\n        if val <= 0:\n            raise InvalidDimensionError(f\"{name} must be > 0; got {val}\")\n        return val\n\n    def validate_rectangle(self, rect: Rectangle) -> None:\n        \"\"\"Validates both dimensions of a Rectangle object.\"\"\"\n        self.validate_dimension(\"width\", rect.width)\n        self.validate_dimension(\"height\", rect.height)\nclass RectangleCalculator:\n    \"\"\"Calculates the area of a rectangle and orchestrates optional persistence.\"\"\"\n    def __init__(self, validator: Validator) -> None:\n        self.validator = validator\n        self.repository = None # Persistence is not enabled for the public API call\n\n    def area(self, rect: Rectangle) -> float:\n        \"\"\"Validates the rectangle and computes its area.\"\"\"\n        self.validator.validate_rectangle(rect)\n        result = rect.area()\n        # Persistence logic is skipped because self.repository is None\n        return result\ndef rectangle_area(width: Union[int, float], height: Union[int, float]) -> float:\n    \"\"\"\n    Calculates the area of a rectangle given its width and height.\n    Validates that dimensions are numeric and positive.\n    \"\"\"\n    v = Validator()\n    w = v.validate_dimension(\"width\", width)\n    h = v.validate_dimension(\"height\", height)\n    rect = Rectangle(w, h)\n    calc = RectangleCalculator(v)\n    return calc.area(rect)"}
{"task_id": "Mbpp/460", "solution": "from typing import Any, List, Sequence\nclass ExtractFirstError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass InvalidInputError(ExtractFirstError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass EmptySublistError(ExtractFirstError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\ndef is_sequence(obj: Any) -> bool:\n    \"\"\"Checks if an object is a sequence (list/tuple) but not a string or bytes.\"\"\"\n    return isinstance(obj, (list, tuple)) and not isinstance(obj, (str, bytes))\nclass ListValidator:\n    def __init__(self) -> None:\n        pass\n\n    def validate_outer(self, lists: Any) -> None:\n        if not is_sequence(lists):\n            raise InvalidInputError(\"Outer input must be a sequence (list/tuple) of sequences.\")\n\n    def validate_sublist(self, sublist: Any, index: int) -> None:\n        if not is_sequence(sublist):\n            raise InvalidInputError(f\"Sublist at index {index} must be a sequence.\")\n        if len(sublist) == 0:\n            raise EmptySublistError(f\"Sublist at index {index} is empty.\")\nclass ExtractorService:\n    def __init__(self, validator: ListValidator) -> None:\n        self._validator = validator\n\n    def extract_first_elements(self, lists: Sequence[Sequence[Any]]) -> List[Any]:\n        self._validator.validate_outer(lists)\n        results: List[Any] = []\n        for idx, sub in enumerate(lists):\n            self._validator.validate_sublist(sub, idx)\n            results.append(self._extract_first(sub))\n        return results\n\n    def _extract_first(self, sublist: Sequence[Any]) -> Any:\n        return sublist[0]\ndef Extract(lists: Sequence[Sequence[Any]]) -> List[Any]:\n    \"\"\"Extracts the first element from each sublist in a list of lists.\"\"\"\n    validator = ListValidator()\n    service = ExtractorService(validator)\n    return service.extract_first_elements(lists)"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(values):\n    \"\"\"\n    Computes the pairwise sum of neighboring elements in the given tuple.\n    Returns an empty tuple if the input has fewer than two elements.\n    \"\"\"\n    if len(values) < 2:\n        return ()\n    \n    result_list = []\n    for i in range(len(values) - 1):\n        result_list.append(values[i] + values[i+1])\n        \n    return tuple(result_list)"}
{"task_id": "Mbpp/462", "solution": "def combinations_list(items: list) -> list:\n    \"\"\"\n    Finds all possible combinations (power set) of the elements of a given list,\n    maintaining a specific deterministic order.\n    \"\"\"\n    combos = [[]]\n    for item in items:\n        new_combos = [[item] + c for c in combos]\n        combos.extend(new_combos)\n    return combos"}
{"task_id": "Mbpp/465", "solution": "from typing import Any, Dict, Callable, Optional\ndef drop_empty(data: dict, *, empty_predicate: Optional[Callable[[Any], bool]] = None) -> dict:\n    \"\"\"\n    Returns a new dictionary with empty items removed.\n    Empty items are None, empty strings, and empty containers by default.\n    \"\"\"\n    # Inline custom exceptions as required\n    class ValidationError(Exception):\n        \"\"\"Exception raised for invalid input data.\"\"\"\n        pass\n\n    # Inline models as required\n    class DictModel:\n        \"\"\"A wrapper for dictionary data, ensuring valid input.\"\"\"\n        def __init__(self, data_input: Dict[str, Any]) -> None:\n            if not isinstance(data_input, dict):\n                raise ValidationError(\"Expected dict\")\n            self._data = data_input.copy()\n\n        def to_dict(self) -> Dict[str, Any]:\n            return self._data.copy()\n\n    # Inline core emptiness predicate logic\n    def _default_is_empty(value: Any) -> bool:\n        \"\"\"Determines if a value is considered empty by default rules.\"\"\"\n        if value is None:\n            return True\n        if isinstance(value, str) and value == \"\":\n            return True\n        if isinstance(value, (list, tuple, set, dict)) and len(value) == 0:\n            return True\n        return False\n\n    # Inline repositories (minimal, as per design's __init__.py example)\n    class InMemoryRepository:\n        \"\"\"An in-memory repository for storing data, primarily for testing.\"\"\"\n        def __init__(self):\n            self._store: Dict[str, Dict[str, Any]] = {}\n        def save(self, key: str, payload: Dict[str, Any]) -> None:\n            self._store[key] = payload\n        def get(self, key: str) -> Optional[Dict[str, Any]]:\n            return self._store.get(key)\n\n    # Inline services logic\n    class DropEmptyService:\n        \"\"\"Service to drop empty items from a dictionary, with optional persistence.\"\"\"\n        def __init__(self, repository=None, empty_predicate_param: Optional[Callable[[Any], bool]] = None):\n            self._repo = repository\n            self._pred = empty_predicate_param\n\n        def drop_empty(self, service_data: Dict[str, Any]) -> Dict[str, Any]:\n            model = DictModel(service_data)\n            pred_to_use = self._pred or _default_is_empty\n            cleaned = {k: v for k, v in model.to_dict().items() if not pred_to_use(v)}\n            # Persistence is optional and not required for this function's direct return value.\n            # The InMemoryRepository is passed but its save method is not invoked here\n            # as it's not a core requirement for the 'drop_empty' function's output.\n            return cleaned\n\n    # Main logic of the drop_empty function, delegating to the inline service\n    service = DropEmptyService(repository=InMemoryRepository(), empty_predicate_param=empty_predicate)\n    return service.drop_empty(data)"}
{"task_id": "Mbpp/468", "solution": "def max_product(arr: List[float]) -> float:\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of a strictly increasing contiguous subsequence.\n    Assumes `arr` is a non-empty list of floats.\n    \"\"\"\n    n = len(arr)\n    best_product = float(arr[0])  # Initialize with the first element, handles single-element array.\n    current_start = 0\n\n    for i in range(1, n):\n        if arr[i] > arr[i-1]:\n            # Current element extends the strictly increasing segment.\n            pass\n        else:\n            # The strictly increasing segment ends at arr[i-1]. Calculate its product.\n            current_product_segment = 1.0\n            for j in range(current_start, i):\n                current_product_segment *= arr[j]\n            \n            # Update best_product if the current segment's product is greater.\n            if current_product_segment > best_product:\n                best_product = current_product_segment\n            \n            # Start a new potential strictly increasing segment from arr[i].\n            current_start = i\n    \n    # After the loop, calculate the product for the very last segment in the array.\n    # This segment runs from 'current_start' up to the end of the array (index n-1).\n    current_product_segment = 1.0\n    for j in range(current_start, n):\n        current_product_segment *= arr[j]\n        \n    # Compare and update best_product one last time.\n    if current_product_segment > best_product:\n        best_product = current_product_segment\n\n    return best_product"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(numbers):\n    \"\"\"\n    Checks if a list of numbers contains a consecutive sequence.\n    Duplicates are ignored. An empty list is not considered consecutive.\n    \"\"\"\n    if not numbers:\n        return False\n\n    unique_numbers = set(numbers)\n\n    if not unique_numbers: # This case would only happen if original numbers was empty or contained only non-hashable/non-comparable items, but we assume list of ints.\n        return False\n\n    min_val = min(unique_numbers)\n    max_val = max(unique_numbers)\n\n    # A sequence is consecutive if all numbers from min_val to max_val are present once.\n    # The count of unique numbers should equal the range span (max - min + 1).\n    return len(unique_numbers) == (max_val - min_val + 1)"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(arr: List[int], n: int) -> int:\n    \"\"\"Calculates the product of array elements modulo n.\n\n    The result is always in the range [0, n-1].\n    \"\"\"\n    # Initialize the accumulator. The product of an empty set is 1.\n    # Take modulo n to ensure it stays in range [0, n-1] even for n=1.\n    acc = 1 % n\n    for x in arr:\n        # Multiply current accumulator with the element, taking modulo n at each step.\n        # This prevents intermediate overflow for large numbers and correctly handles\n        # negative array elements due to Python's % operator behavior for negative numbers.\n        acc = (acc * x) % n\n    return acc"}
{"task_id": "Mbpp/473", "solution": "from typing import Sequence, Iterable, Set, Tuple\nclass InvalidTupleError(Exception):\n    \"\"\"Custom exception for invalid tuple inputs.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass TupleNormalizer:\n    \"\"\"Validates and canonicalizes 2-element tuple-like sequences.\"\"\"\n    def validate_single(self, raw: Sequence[int]) -> Tuple[int, int]:\n        \"\"\"Validates a single tuple-like sequence and returns its canonical (sorted) form.\"\"\"\n        if not isinstance(raw, (list, tuple)) or len(raw) != 2:\n            raise InvalidTupleError(f\"Each tuple must be a sequence of length 2, got {raw}\")\n        try:\n            a, b = int(raw[0]), int(raw[1])\n        except (ValueError, TypeError):\n            raise InvalidTupleError(f\"Tuple elements must be integers, got {raw}\")\n        return (a, b) if a <= b else (b, a)\n\n    def validate_and_normalize_list(self, raw: Sequence[Sequence[int]]) -> list[Tuple[int, int]]:\n        \"\"\"Validates and normalizes a list of tuple-like sequences into canonical tuples.\"\"\"\n        if not isinstance(raw, (list, tuple)):\n            raise InvalidTupleError(f\"The input list itself must be a sequence, got {type(raw).__name__}\")\n        return [self.validate_single(item) for item in raw]\nclass IntersectionService:\n    \"\"\"Provides core business logic for computing tuple intersections.\"\"\"\n    def __init__(self, normalizer: TupleNormalizer) -> None:\n        self._normalizer = normalizer\n\n    def intersect(self, list_a: Sequence[Sequence[int]], list_b: Sequence[Sequence[int]]) -> Set[Tuple[int, int]]:\n        \"\"\"\n        Validates and normalizes input lists, then computes their tuple intersection.\n        Raises InvalidTupleError if any input tuple is malformed.\n        \"\"\"\n        norm_a = self._normalizer.validate_and_normalize_list(list_a)\n        norm_b = self._normalizer.validate_and_normalize_list(list_b)\n        return self.intersect_canonical(norm_a, norm_b)\n\n    def intersect_canonical(self, a: Iterable[Tuple[int, int]], b: Iterable[Tuple[int, int]]) -> Set[Tuple[int, int]]:\n        \"\"\"Computes the intersection of two iterables of already canonical tuples.\"\"\"\n        set_a = set(a)\n        set_b = set(b)\n        return set_a.intersection(set_b)\n_normalizer = TupleNormalizer()\n_service = IntersectionService(_normalizer)\ndef tuple_intersection(list1: Sequence[Tuple[int, int]], list2: Sequence[Tuple[int, int]]) -> Set[Tuple[int, int]]:\n    \"\"\"\n    Finds the intersection of 2-element tuples from two lists, treating (a,b) and (b,a) as equal.\n    Input tuples are validated and canonicalized (sorted) before intersection.\n    \"\"\"\n    return _service.intersect(list1, list2)"}
{"task_id": "Mbpp/476", "solution": "def big_sum(arr):\n    \"\"\"\n    Finds the sum of the largest and smallest value in a given array.\n    This function assumes the input array `arr` is a non-empty sequence of numbers.\n    \"\"\"\n    smallest = min(arr)\n    largest = max(arr)\n    return smallest + largest"}
