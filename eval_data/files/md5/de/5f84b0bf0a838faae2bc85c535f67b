{"task_id": "Mbpp/109", "solution": "import sqlite3\nimport datetime\nimport logging\nfrom typing import Optional, List\n_logger = logging.getLogger(__name__)\ndef odd_Equivalent(binary: str, rotations: int) -> int:\n    \"\"\"\n    Finds the number of times a binary string, when rotated, yields an odd integer.\n    \"\"\"\n\n    # --- Configuration (mimicking config.py) ---\n    _CACHE_ENABLED: bool = False\n    _CACHE_DB_PATH: str = \"odd_equivalent_cache.sqlite3\"\n\n    # --- Exceptions (mimicking exceptions.py) ---\n    class InvalidBinaryError(Exception):\n        \"\"\"Raised when the binary string input is invalid.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    class InvalidRotationError(Exception):\n        \"\"\"Raised when the rotation count input is invalid.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    class RepositoryError(Exception):\n        \"\"\"Raised for issues with the data repository operations.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    # --- Validators (mimicking validators.py) ---\n    def validate_binary(value: str) -> None:\n        \"\"\"Validates if a string is a non-empty binary string.\"\"\"\n        if not value:\n            raise InvalidBinaryError(\"Binary string cannot be empty.\")\n        if not all(char in '01' for char in value):\n            raise InvalidBinaryError(\"Binary string must contain only '0' or '1'.\")\n\n    def validate_rotations(value: int) -> None:\n        \"\"\"Validates if rotations is a non-negative integer.\"\"\"\n        if not isinstance(value, int) or value < 0:\n            raise InvalidRotationError(\"Rotations must be a non-negative integer.\")\n\n    # --- BinaryString (mimicking binary_string.py) ---\n    class BinaryString:\n        \"\"\"Encapsulates binary string operations related to rotations.\"\"\"\n        def __init__(self, value: str) -> None:\n            self.value: str = value\n            self.length: int = len(value)\n\n        def count_ones(self) -> int:\n            \"\"\"Counts occurrences of '1' in the binary string.\"\"\"\n            return self.value.count(\"1\")\n\n        def last_bit_for_rotation(self, shift: int) -> str:\n            \"\"\"Returns the last bit (rightmost character) of the string after 'shift' left rotations.\"\"\"\n            idx = (shift - 1 + self.length) % self.length\n            return self.value[idx]\n\n        def odd_count_for_prefix_rotations(self, rotations: int) -> int:\n            \"\"\"Counts how many of the first 'rotations' (0-indexed) result in an odd number.\"\"\"\n            n = self.length\n            ones = self.count_ones()\n            \n            full_cycles = rotations // n\n            remainder = rotations % n\n            \n            remainder_count = 0\n            for i in range(remainder):\n                if self.last_bit_for_rotation(i) == '1':\n                    remainder_count += 1\n            \n            return full_cycles * ones + remainder_count\n\n    # --- RotationRepository (mimicking rotation_repository.py) ---\n    class RotationRepository:\n        \"\"\"Handles caching of rotation counts using SQLite.\"\"\"\n        TABLE_NAME: str = \"rotations_cache\"\n        CREATE_TABLE_SQL: str = f\"\"\"\n            CREATE TABLE IF NOT EXISTS {TABLE_NAME} (\n                binary TEXT NOT NULL,\n                rotations INTEGER NOT NULL,\n                count INTEGER NOT NULL,\n                last_updated TIMESTAMP NOT NULL,\n                PRIMARY KEY(binary, rotations)\n            )\n        \"\"\"\n\n        def __init__(self, db_path: str) -> None:\n            self._db_path = db_path\n            self._conn: Optional[sqlite3.Connection] = None\n            try:\n                self._conn = sqlite3.connect(\n                    self._db_path,\n                    timeout=5,\n                    detect_types=sqlite3.PARSE_DECLTYPES|sqlite3.PARSE_COLNAMES\n                )\n                self._conn.row_factory = sqlite3.Row\n                self.initialize_schema()\n            except sqlite3.Error as e:\n                if self._conn:\n                    self._conn.close()\n                self._conn = None\n                raise RepositoryError(f\"Failed to open/initialize database: {e}\")\n\n        def initialize_schema(self) -> None:\n            \"\"\"Creates the cache table if it does not exist.\"\"\"\n            if not self._conn:\n                raise RepositoryError(\"Database connection not established.\")\n            try:\n                cursor = self._conn.cursor()\n                cursor.execute(self.CREATE_TABLE_SQL)\n                self._conn.commit()\n            except sqlite3.Error as e:\n                raise RepositoryError(f\"Failed to initialize schema: {e}\")\n\n        def get_cached(self, binary: str, rotations: int) -> Optional[int]:\n            \"\"\"Retrieves a cached count for the given binary string and rotations.\"\"\"\n            if not self._conn:\n                _logger.warning(\"Attempted to get cached data, but repository is not connected.\")\n                return None\n            try:\n                cursor = self._conn.cursor()\n                cursor.execute(\n                    f\"SELECT count FROM {self.TABLE_NAME} WHERE binary = ? AND rotations = ?\",\n                    (binary, rotations)\n                )\n                row = cursor.fetchone()\n                return row['count'] if row else None\n            except sqlite3.Error as e:\n                _logger.error(f\"Error retrieving from cache: {e}\")\n                raise RepositoryError(f\"Error retrieving from cache: {e}\")\n\n        def set_cached(self, binary: str, rotations: int, count: int) -> None:\n            \"\"\"Caches the computed count.\"\"\"\n            if not self._conn:\n                _logger.warning(\"Attempted to set cached data, but repository is not connected.\")\n                return\n            try:\n                cursor = self._conn.cursor()\n                cursor.execute(\n                    f\"\"\"\n                    INSERT OR REPLACE INTO {self.TABLE_NAME}(binary, rotations, count, last_updated)\n                    VALUES (?, ?, ?, ?)\n                    \"\"\",\n                    (binary, rotations, count, datetime.datetime.now())\n                )\n                self._conn.commit()\n            except sqlite3.Error as e:\n                _logger.error(f\"Error saving to cache: {e}\")\n                raise RepositoryError(f\"Error saving to cache: {e}\")\n\n        def close(self) -> None:\n            \"\"\"Closes the database connection.\"\"\"\n            if self._conn:\n                self._conn.close()\n                self._conn = None\n\n    # --- RotationService (mimicking rotation_service.py) ---\n    class RotationService:\n        \"\"\"Orchestrates validation, computation, and optional caching for odd-equivalent counts.\"\"\"\n        def __init__(self, repo: Optional[RotationRepository] = None) -> None:\n            self._repo = repo\n\n        def compute_count(self, binary: str, rotations: int) -> int:\n            \"\"\"Computes the number of odd-valued rotations, utilizing caching if available.\"\"\"\n            validate_binary(binary)\n            validate_rotations(rotations)\n\n            if self._repo:\n                try:\n                    cached = self._repo.get_cached(binary, rotations)\n                    if cached is not None:\n                        return cached\n                except RepositoryError as e:\n                    _logger.warning(f\"Failed to retrieve from cache: {e}. Proceeding with computation.\")\n\n            bs = BinaryString(binary)\n            count = bs.odd_count_for_prefix_rotations(rotations)\n\n            if self._repo:\n                try:\n                    self._repo.set_cached(binary, rotations, count)\n                except RepositoryError as e:\n                    _logger.warning(f\"Failed to save to cache: {e}. Returning computed value.\")\n            return count\n\n    # --- Main function logic (mimicking __init__.py's odd_equivalent wrapper) ---\n    repo_instance: Optional[RotationRepository] = None\n    if _CACHE_ENABLED:\n        try:\n            repo_instance = RotationRepository(_CACHE_DB_PATH)\n        except RepositoryError as e:\n            _logger.error(f\"Could not initialize cache repository: {e}. Running without caching.\")\n            repo_instance = None\n\n    service = RotationService(repo=repo_instance)\n    try:\n        return service.compute_count(binary, rotations)\n    finally:\n        if repo_instance:\n            repo_instance.close()"}
{"task_id": "Mbpp/116", "solution": "from typing import Tuple, Any\nclass TupleConversionError(Exception):\n    \"\"\"Custom exception for tuple conversion errors.\"\"\"\n    def __init__(self, message: str, error_code: int | None = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.error_code = error_code\n\n    def __str__(self) -> str:\n        if self.error_code is not None:\n            return f\"[{self.error_code}] {self.message}\"\n        return self.message\nclass InputValidator:\n    \"\"\"Validates the input collection and its elements.\"\"\"\n    def __init__(self, allow_empty: bool = False) -> None:\n        self._allow_empty = allow_empty\n\n    def validate(self, values: Tuple[int, ...]) -> None:\n        \"\"\"Ensures input is a valid tuple/list of positive integers.\"\"\"\n        if not isinstance(values, (tuple, list)):\n            raise TupleConversionError(\"Input must be a tuple or list of integers\", error_code=100)\n        if not values and not self._allow_empty:\n            raise TupleConversionError(\"Empty input is not allowed\", error_code=101)\n        for idx, el in enumerate(values):\n            self._validate_element(el, idx)\n\n    def _validate_element(self, el: Any, idx: int) -> None:\n        \"\"\"Validates a single element of the input tuple.\"\"\"\n        if not isinstance(el, int):\n            raise TupleConversionError(f\"Element at index {idx} is not int: {el!r}\", error_code=102)\n        if el < 0:\n            raise TupleConversionError(f\"Element at index {idx} is negative: {el}\", error_code=103)\nclass IntBuilder:\n    \"\"\"Builds a concatenated string and integer from validated input.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def build_str(self, values: Tuple[int, ...]) -> str:\n        \"\"\"Converts each integer to its string representation and concatenates them.\"\"\"\n        return \"\".join(str(el) for el in values)\n\n    def build_int(self, values: Tuple[int, ...]) -> int:\n        \"\"\"Builds the concatenated string and converts it to an integer.\"\"\"\n        s = self.build_str(values)\n        return int(s)\nclass TupleIntConverter:\n    \"\"\"Coordinates validation and building of the final integer.\"\"\"\n    def __init__(self, validator: InputValidator, builder: IntBuilder) -> None:\n        self.validator = validator\n        self.builder = builder\n\n    def convert(self, values: Tuple[int, ...]) -> int:\n        \"\"\"Validates the input and then converts it to a single integer.\"\"\"\n        self.validator.validate(values)\n        return self.builder.build_int(tuple(values))\nclass TupleToIntAPI:\n    \"\"\"Public facade for converting a tuple of integers to a single integer.\"\"\"\n    def __init__(self, validator: InputValidator, converter: TupleIntConverter) -> None:\n        self.validator = validator\n        self.converter = converter\n\n    def tuple_to_int(self, values: Tuple[int, ...]) -> int:\n        \"\"\"Converts the given tuple of positive integers into a single integer.\"\"\"\n        return self.converter.convert(values)\n_default_api = TupleToIntAPI(InputValidator(), TupleIntConverter(InputValidator(), IntBuilder()))\ndef tuple_to_int(values: Tuple[int, ...]) -> int:\n    \"\"\"Converts a tuple of positive integers into a single integer.\"\"\"\n    return _default_api.tuple_to_int(tuple(values))"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Sums all amicable numbers from 1 up to a specified limit.\n    Uses an inline cache for sums of proper divisors to optimize performance.\n    \"\"\"\n    _divisor_sums_cache = {}\n\n    def _proper_divisors(n: int) -> list[int]:\n        \"\"\"Calculates all proper divisors of a positive integer n.\"\"\"\n        divs = [1] if n > 1 else []\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                divs.append(i)\n                if i * i != n:\n                    divs.append(n // i)\n            i += 1\n        return divs\n\n    def _get_sum_proper_divisors(n: int) -> int:\n        \"\"\"Retrieves or calculates the sum of proper divisors for n, using cache.\"\"\"\n        if n in _divisor_sums_cache:\n            return _divisor_sums_cache[n]\n        \n        current_sum = sum(_proper_divisors(n))\n        _divisor_sums_cache[n] = current_sum\n        return current_sum\n\n    found_amicable_numbers: set[int] = set()\n\n    for a in range(2, limit + 1):\n        if a in found_amicable_numbers:\n            continue\n\n        s_a = _get_sum_proper_divisors(a)\n\n        # Perfect numbers are not amicable pairs\n        if s_a == a:\n            continue\n        \n        b = s_a\n        s_b = _get_sum_proper_divisors(b)\n\n        # Check for amicable pair condition\n        if s_b == a:\n            # Add 'a' to the set (it's always within [2, limit])\n            found_amicable_numbers.add(a)\n            # Add 'b' to the set only if it's within the specified limit\n            if 1 <= b <= limit:\n                found_amicable_numbers.add(b)\n                \n    return sum(found_amicable_numbers)"}
{"task_id": "Mbpp/120", "solution": "from typing import List, Tuple, Union\ndef max_product_tuple(pairs: List[Tuple[Union[int, float], Union[int, float]]]) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum absolute product between any two numbers selected from pairs of tuples.\n    \"\"\"\n    all_numbers: List[Union[int, float]] = []\n    for pair in pairs:\n        all_numbers.append(pair[0])\n        all_numbers.append(pair[1])\n\n    max_abs_product: Union[int, float] = 0\n\n    num_elements = len(all_numbers)\n    for i in range(num_elements):\n        for j in range(i + 1, num_elements):\n            num1 = all_numbers[i]\n            num2 = all_numbers[j]\n            current_abs_product = abs(num1 * num2)\n            if current_abs_product > max_abs_product:\n                max_abs_product = current_abs_product\n                \n    return max_abs_product"}
{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring.\n    Applies Kadane's algorithm by mapping '0' to +1 and '1' to -1.\n    \"\"\"\n    max_ending_here = 0\n    max_so_far = 0\n\n    for char in s:\n        value = 1 if char == '0' else -1\n        max_ending_here = max(value, max_ending_here + value)\n        max_so_far = max(max_so_far, max_ending_here)\n\n    return max_so_far"}
{"task_id": "Mbpp/124", "solution": "import math\nfrom typing import Optional, Any, Tuple, List\nclass InvalidComplexInputError(ValueError):\n    \"\"\"Raised when complex number input is invalid.\"\"\"\n    pass\nclass ComputationError(RuntimeError):\n    \"\"\"Raised when a computation within the service fails unexpectedly.\"\"\"\n    pass\ndef validate_numeric(value: Any) -> bool:\n    \"\"\"Returns True if value is an int or float and is finite.\"\"\"\n    if isinstance(value, (int, float)):\n        return math.isfinite(value)\n    return False\ndef to_float(value: Any) -> float:\n    \"\"\"Converts an int or float to a float; raises InvalidComplexInputError if impossible.\"\"\"\n    if isinstance(value, (int, float)):\n        return float(value)\n    raise InvalidComplexInputError(f\"Cannot convert '{value}' to float as it is not a valid numeric type (int or float).\")\nclass ComplexNumber:\n    \"\"\"Domain model representing a complex number with real and imaginary parts.\"\"\"\n    def __init__(self, real: float, imag: float):\n        self.real = real\n        self.imag = imag\n\n    def to_python_complex(self) -> complex:\n        \"\"\"Converts to built-in complex type for interoperability.\"\"\"\n        return complex(self.real, self.imag)\n\n    def __repr__(self) -> str:\n        \"\"\"Human-readable representation.\"\"\"\n        return f\"ComplexNumber(real={self.real}, imag={self.imag})\"\nclass ComplexFactory:\n    \"\"\"Factory to create ComplexNumber instances from various inputs.\"\"\"\n    def from_python_complex(self, c: complex) -> ComplexNumber:\n        \"\"\"Build ComplexNumber from a Python complex number.\"\"\"\n        return ComplexNumber(real=float(c.real), imag=float(c.imag))\n\n    def from_parts(self, real_part: Any, imag_part: Any) -> ComplexNumber:\n        \"\"\"Build ComplexNumber from two numbers, ensuring they are valid scalars.\"\"\"\n        if not validate_numeric(real_part) or not validate_numeric(imag_part):\n            raise InvalidComplexInputError(\n                f\"Real and imaginary parts must be numeric (int or float). Got real='{real_part}', imag='{imag_part}'.\"\n            )\n        return ComplexNumber(real=to_float(real_part), imag=to_float(imag_part))\n\n    def from_any(self, value: Any, imag_param: Optional[Any] = None) -> ComplexNumber:\n        \"\"\"Accepts various input shapes for creating a ComplexNumber.\"\"\"\n        if isinstance(value, complex) and imag_param is None:\n            return self.from_python_complex(value)\n        \n        if imag_param is not None:\n            real_input = value\n            imag_input = imag_param\n            \n            # Resolve potential complex inputs to their scalar components\n            if isinstance(real_input, complex):\n                real_part = real_input.real\n            else:\n                real_part = real_input\n            \n            if isinstance(imag_input, complex):\n                imag_part = imag_input.imag\n            else:\n                imag_part = imag_input\n            \n            return self.from_parts(real_part, imag_part)\n            \n        if isinstance(value, (tuple, list)) and len(value) == 2:\n            real_input = value[0]\n            imag_input = value[1]\n\n            if isinstance(real_input, complex):\n                real_part = real_input.real\n            else:\n                real_part = real_input\n            \n            if isinstance(imag_input, complex):\n                imag_part = imag_input.imag\n            else:\n                imag_part = imag_input\n            \n            return self.from_parts(real_part, imag_part)\n            \n        raise InvalidComplexInputError(f\"Unsupported input shape. Expected complex, (real, imag) pair, or a tuple/list of two numerics. Got value='{value}', imag='{imag_param}'.\")\nclass AngleService:\n    \"\"\"Encapsulates math logic to compute angle using math.atan2.\"\"\"\n    def angle(self, cn: ComplexNumber) -> float:\n        \"\"\"Compute angle for a ComplexNumber instance.\"\"\"\n        try:\n            return self.angle_safe(cn.real, cn.imag)\n        except Exception as e:\n            raise ComputationError(f\"Error computing angle for {cn.real}+{cn.imag}j: {e}\") from e\n\n    def angle_safe(self, real: float, imag: float) -> float:\n        \"\"\"Core computation using math.atan2(imag, real); returns 0.0 for (0,0).\"\"\"\n        if real == 0.0 and imag == 0.0:\n            return 0.0\n        return math.atan2(imag, real)\nclass AngleAPI:\n    \"\"\"Public API surface providing a convenience function for angle computation.\"\"\"\n    def __init__(self, factory: Optional[ComplexFactory] = None, service: Optional[AngleService] = None):\n        self._factory = factory or ComplexFactory()\n        self._service = service or AngleService()\n\n    def angle_complex(self, value: Any, imag: Optional[Any] = None) -> float:\n        \"\"\"\n        Validates and normalizes arguments, then computes and returns the angle in radians.\n        \"\"\"\n        cn = self._factory.from_any(value, imag)\n        return self._service.angle(cn)\n_api = AngleAPI()\ndef angle_complex(value: Any, imag: Optional[Any] = None) -> float:\n    \"\"\"\n    Get the angle (argument) of a complex number in radians.\n    Accepts a Python complex number, or separate real and imaginary parts.\n    \"\"\"\n    return _api.angle_complex(value, imag)"}
{"task_id": "Mbpp/119", "solution": "def search(arr: list[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear exactly twice.\n    Uses binary search by index parity for O(log n) efficiency.\n    \"\"\"\n    n = len(arr)\n    low, high = 0, n - 1\n\n    while low < high:\n        mid = (low + high) // 2\n        # Ensure mid is always an even index to compare arr[mid] with arr[mid+1] as a potential pair start.\n        if mid % 2 == 1:\n            mid -= 1\n\n        # If arr[mid] == arr[mid+1], the unique element is to the right.\n        # Advance low past this pair.\n        if arr[mid] == arr[mid + 1]:\n            low = mid + 2\n        # Otherwise, the unique element is at or to the left of arr[mid].\n        else:\n            high = mid\n\n    # When low == high, this index points to the single unique element.\n    return arr[low]"}
