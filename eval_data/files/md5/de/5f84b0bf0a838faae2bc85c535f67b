{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(n: int) -> bool:\n    \"\"\"\n    Checks if a number can be represented as a sum of powers of two with exponents strictly greater than zero.\n    This means the number must be positive and even (not using 2^0 = 1).\n    \"\"\"\n    # For a number to be a sum of powers of two with exponents k >= 1,\n    # it must be positive and its least significant bit (2^0) must be 0,\n    # effectively meaning the number must be even.\n    return n > 0 and (n & 1) == 0"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list_a, list_b, list_c):\n    \"\"\"\n    Counts the number of items that are identical in the same position of three given lists.\n    Comparison stops at the shortest of the three lists.\n    \"\"\"\n    count = 0\n    for x, y, z in zip(list_a, list_b, list_c):\n        if x == y == z:\n            count += 1\n    return count"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(items):\n    \"\"\"\n    Sorts a list of elements using the pancake sort algorithm.\n    Returns a new list with elements in ascending order.\n    \"\"\"\n    arr = list(items)\n    n = len(arr)\n\n    def _flip(current_arr, k):\n        \"\"\"Reverses the prefix of the list from index 0 to k (inclusive).\"\"\"\n        current_arr[:k + 1] = reversed(current_arr[:k + 1])\n\n    def _find_max_index(current_arr, current_n):\n        \"\"\"Finds the index of the largest element in current_arr[0...current_n-1].\"\"\"\n        max_idx = 0\n        for i in range(1, current_n):\n            if current_arr[i] > current_arr[max_idx]:\n                max_idx = i\n        return max_idx\n\n    for size in range(n, 1, -1):\n        max_idx = _find_max_index(arr, size)\n\n        if max_idx != size - 1:\n            _flip(arr, max_idx)\n            _flip(arr, size - 1)\n\n    return arr"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(data):\n    \"\"\"\n    Calculates the maximum difference between any two elements in a sequence.\n    This is equivalent to finding the difference between the maximum and minimum elements.\n    \"\"\"\n    min_val = min(data)\n    max_val = max(data)\n    return float(max_val - min_val)"}
{"task_id": "Mbpp/161", "solution": "from typing import List, Any\ndef _is_hashable(x: Any) -> bool:\n    \"\"\"Checks if an object is hashable.\"\"\"\n    try:\n        hash(x)\n        return True\n    except TypeError:\n        return False\ndef remove_elements(source: List[Any], to_remove: List[Any]) -> List[Any]:\n    \"\"\"\n    Removes all elements from the source list that are present in the to_remove list.\n    Preserves the order of remaining elements and handles hashable/unhashable types.\n    \"\"\"\n    all_hashable = True\n    for x in to_remove:\n        if not _is_hashable(x):\n            all_hashable = False\n            break\n\n    if all_hashable:\n        removal_set = set(to_remove)\n        return [x for x in source if x not in removal_set]\n    else:\n        return [x for x in source if not any(x == y for y in to_remove)]"}
{"task_id": "Mbpp/140", "solution": "from typing import Any, Iterable, Iterator, Set, Union, Tuple\nNumber = Union[int, float]\nclass InvalidInputError(Exception):\n    \"\"\"Raised when the outer input is not a valid iterable of iterables.\"\"\"\n    pass\nclass InvalidElementError(ValueError):\n    \"\"\"Raised when an element cannot be validated or coerced to a number.\"\"\"\n    def __init__(self, message: str, element: Any = None):\n        super().__init__(message)\n        self.element = element\nclass Validator:\n    NUMERIC_TYPES: Tuple[type, ...] = (int, float)\n\n    def __init__(self, allow_coerce: bool = False) -> None:\n        \"\"\"Initializes the Validator with an option to allow string coercion.\"\"\"\n        self.allow_coerce = allow_coerce\n\n    def validate_element(self, elem: Any) -> Number:\n        \"\"\"Validates an element to ensure it is a number or can be coerced.\"\"\"\n        if isinstance(elem, self.NUMERIC_TYPES):\n            return elem\n        if self.allow_coerce:\n            try:\n                # Attempt conversion for numeric strings\n                if isinstance(elem, str):\n                    if '.' in elem or 'e' in elem.lower():\n                        return float(elem)\n                    return int(elem)\n            except (ValueError, TypeError):\n                raise InvalidElementError(f\"Cannot coerce element to number: {elem!r}\", elem)\n        raise InvalidElementError(f\"Invalid non-numeric element: {elem!r}\", elem)\nclass IterableAdapter:\n    def adapt(self, obj: Any) -> Iterator[Iterator[Any]]:\n        \"\"\"Adapts a given object into an iterator of iterators, raising errors for invalid structures.\"\"\"\n        if not self._is_outer_iterable(obj):\n            raise InvalidInputError(f\"Outer object is not an iterable of iterables: {obj!r}\")\n        \n        try:\n            for inner in obj:\n                if not self._is_outer_iterable(inner):\n                    raise InvalidInputError(f\"Inner element is not iterable: {inner!r}\")\n                yield iter(inner)\n        except TypeError:\n            # This catches cases where obj itself might not be iterable,\n            # though _is_outer_iterable tries to prevent it.\n            raise InvalidInputError(f\"Provided object is not iterable as expected: {obj!r}\")\n\n    def _is_outer_iterable(self, obj: Any) -> bool:\n        \"\"\"Determines if an object is an iterable but not a string or bytes.\"\"\"\n        if isinstance(obj, (str, bytes)):\n            return False\n        try:\n            iter(obj)\n            return True\n        except TypeError:\n            return False\nclass Extractor:\n    def __init__(self, base_validator: Validator) -> None:\n        \"\"\"Initializes the Extractor with a base validator and an adapter.\"\"\"\n        self._base_validator = base_validator\n        self._adapter = IterableAdapter()\n\n    def extract_singly(self, iterables: Iterable[Iterable[Any]], *, strict: bool = False) -> Set[Number]:\n        \"\"\"Flattens a collection of iterables into a set of unique numbers, respecting strictness.\"\"\"\n        # 'strict=True' always prevents coercion, regardless of base_validator's allow_coerce.\n        # 'strict=False' means coercion depends on base_validator's allow_coerce.\n        effective_allow_coerce = self._base_validator.allow_coerce and not strict\n        current_validator = Validator(allow_coerce=effective_allow_coerce)\n        \n        result = set()\n        for num in self._flatten_and_validate(iterables, current_validator):\n            result.add(num)\n        return result\n\n    def _flatten_and_validate(self, iterables: Iterable[Iterable[Any]], validator: Validator) -> Iterator[Number]:\n        \"\"\"Internal generator to flatten iterables, validate elements, and yield numbers.\"\"\"\n        adapted = self._adapter.adapt(iterables)\n        for inner in adapted:\n            for elem in inner:\n                yield validator.validate_element(elem)\n_default_extractor = Extractor(Validator(allow_coerce=False))\ndef extract_singly(iterables: Iterable[Iterable[Any]], *, strict: bool = False) -> Set[Number]:\n    \"\"\"\n    Flattens a list of lists into a single set of numbers, removing duplicates.\n    By default, strings are not coerced; `strict=True` also disables coercion.\n    \"\"\"\n    return _default_extractor.extract_singly(iterables, strict=strict)"}
{"task_id": "Mbpp/160", "solution": "from typing import Tuple, Optional\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"\n    Finds integer solutions (x, y) to the linear Diophantine equation ax + by = n.\n    Returns (x, y) as a tuple, or None if no solution exists.\n    \"\"\"\n\n    def _extended_gcd(num1: int, num2: int) -> Tuple[int, int, int]:\n        \"\"\"\n        Computes g = gcd(num1, num2) and Bezout coefficients x, y such that num1*x + num2*y = g.\n        Adjusts coefficients' signs to correspond to the original num1 and num2.\n        \"\"\"\n        old_r, r = abs(num1), abs(num2)\n        old_s, s = 1, 0\n        old_t, t = 0, 1\n\n        while r != 0:\n            q = old_r // r\n            old_r, r = r, old_r - q * r\n            old_s, s = s, old_s - q * s\n            old_t, t = t, old_t - q * t\n\n        # old_r is gcd(|num1|, |num2|)\n        # old_s and old_t are Bezout coefficients for |num1| and |num2|\n        # Adjust signs of Bezout coefficients to work with original num1 and num2\n        if num1 < 0:\n            old_s = -old_s\n        if num2 < 0:\n            old_t = -old_t\n\n        return old_r, old_s, old_t\n\n    # Handle special case where both coefficients are zero\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    # Compute gcd(a, b) and Bezout coefficients (x0, y0) for ax0 + by0 = g\n    g, x0, y0 = _extended_gcd(a, b)\n\n    # If n is not divisible by g, no integer solution exists\n    if n % g != 0:\n        return None\n\n    # Scale Bezout coefficients to find a particular solution for ax + by = n\n    k = n // g\n    x_particular = x0 * k\n    y_particular = y0 * k\n\n    # Normalize the solution to produce a consistent result, often with x in a certain range.\n    # This helps match specific test cases like (2, 3, 7) -> (2, 1).\n    if b != 0:\n        b_over_g = b // g\n        x_canonical = x_particular % b_over_g\n        # Ensure x_canonical is in the correct positive range if b_over_g is positive\n        if b_over_g > 0 and x_canonical < 0:\n            x_canonical += b_over_g\n        # If b_over_g is negative, x_canonical should be in the range [b_over_g, 0)\n        # Python's % handles negative numbers: x % neg_val is in [neg_val, 0)\n        \n        y_canonical = (n - a * x_canonical) // b\n        return (x_canonical, y_canonical)\n    else: # If b is 0, then a*x = n. x_particular is already n/a.\n          # y can be any integer. We return (x_particular, 0) as a canonical choice.\n        return (x_particular, 0)"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Calculates the sum of the series n + (n-2) + (n-4)..., including only positive terms.\"\"\"\n    total = 0\n    current_term = n\n    while current_term > 0:\n        total += current_term\n        current_term -= 2\n    return total"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(text: str) -> int:\n    \"\"\"Counts characters matching their position in the English alphabet (case insensitive).\"\"\"\n    count = 0\n    alphabet = [chr(ord('a') + i) for i in range(26)]\n    alphabet_len = len(alphabet)\n\n    for i, char in enumerate(text):\n        position = i + 1\n\n        if position > alphabet_len:\n            break\n\n        normalized_char = char.lower()\n        if not ('a' <= normalized_char <= 'z'):\n            continue\n\n        expected_letter = alphabet[position - 1]\n\n        if normalized_char == expected_letter:\n            count += 1\n            \n    return count"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(nums):\n    \"\"\"\n    Counts the number of pairs of integers in a list that XOR to an even number.\n    Pairs XOR to an even number if and only if both integers have the same parity.\n    \"\"\"\n    evens_count = 0\n    odds_count = 0\n\n    for num in nums:\n        if num % 2 == 0:\n            evens_count += 1\n        else:\n            odds_count += 1\n\n    # Number of pairs from even numbers: C(evens_count, 2)\n    even_pairs = evens_count * (evens_count - 1) // 2\n    # Number of pairs from odd numbers: C(odds_count, 2)\n    odd_pairs = odds_count * (odds_count - 1) // 2\n\n    return even_pairs + odd_pairs"}
