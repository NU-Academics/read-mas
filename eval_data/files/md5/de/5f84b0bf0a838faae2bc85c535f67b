{"task_id": "Mbpp/415", "solution": "def max_Product(array: list[int]) -> tuple[int, int]:\n    # Finds the pair with the highest product in a list of integers using a single pass.\n    # It tracks the two largest and two smallest numbers to handle positive and negative products.\n\n    # Initialize variables to track the two largest and two smallest numbers.\n    # Using large/small integer limits to ensure any number in the array will be\n    # greater than max1/max2 initial values or smaller than min1/min2 initial values.\n    max1 = -2**63  # Largest number\n    max2 = -2**63  # Second largest number\n    min1 = 2**63 - 1  # Smallest number\n    min2 = 2**63 - 1  # Second smallest number\n\n    for x in array:\n        # Update largest and second largest numbers\n        if x > max1:\n            max2, max1 = max1, x\n        elif x > max2:\n            max2 = x\n\n        # Update smallest and second smallest numbers\n        if x < min1:\n            min2, min1 = min1, x\n        elif x < min2:\n            min2 = x\n\n    # Calculate the products of the two largest numbers and the two smallest numbers.\n    # The highest product can come from either (large_positive * large_positive)\n    # or (small_negative * small_negative).\n    prod1 = max1 * max2\n    prod2 = min1 * min2\n\n    # Compare the two candidate products and return the pair that yields the highest.\n    # The pair is sorted to ensure the smaller number comes first.\n    if prod1 >= prod2:\n        return (min(max1, max2), max(max1, max2))\n    else:\n        return (min(min1, min2), max(min1, min2))"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(sequences):\n    \"\"\"Finds the element in a list of sequences that has the maximum length.\n    If multiple elements have the same maximum length, the first encountered is returned.\n    \"\"\"\n    max_length = -1\n    max_element = None\n\n    for element in sequences:\n        current_length = len(element)\n        if current_length > max_length:\n            max_length = current_length\n            max_element = element\n            \n    return max_element"}
{"task_id": "Mbpp/414", "solution": "def overlapping(seq_a, seq_b) -> bool:\n    \"\"\"\n    Checks if any value in sequence `seq_a` exists in sequence `seq_b`.\n    Utilizes set intersection for hashable elements and falls back to nested iteration for unhashable elements.\n    \"\"\"\n    list_a = list(seq_a)\n    list_b = list(seq_b)\n\n    # Return False if either sequence is empty, as per design.\n    if not list_a or not list_b:\n        return False\n\n    try:\n        # Attempt to use a hash-based approach for efficiency (O(N+M) average case).\n        # Convert the potentially smaller list to a set to optimize lookup time.\n        # Iterating through the other list and checking membership in the set.\n        if len(list_a) <= len(list_b):\n            set_b = set(list_b)\n            for item in list_a:\n                if item in set_b:\n                    return True\n        else:\n            set_a = set(list_a)\n            for item in list_b:\n                if item in set_a:\n                    return True\n        return False\n    except TypeError:\n        # Fallback to an O(N*M) comparison if elements are unhashable.\n        # Iterate through the shorter list to minimize the outer loop iterations.\n        if len(list_a) <= len(list_b):\n            for item_a in list_a:\n                if item_a in list_b:  # 'in' operator on list is O(M) worst-case\n                    return True\n        else:\n            for item_b in list_b:\n                if item_b in list_a:  # 'in' operator on list is O(N) worst-case\n                    return True\n        return False"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n):\n    \"\"\"\n    Calculates the cube sum of the first n even natural numbers using a closed-form formula.\n    The formula for the sum of cubes of the first n even numbers is 2 * n^2 * (n+1)^2.\n    \"\"\"\n    return 2 * (n ** 2) * ((n + 1) ** 2)"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers: list[float]) -> int:\n    \"\"\"\n    Rounds every number in a given list, calculates their sum, and multiplies the sum by the list's length.\n    \"\"\"\n    list_length = len(numbers)\n    sum_of_rounded_numbers = sum(int(round(num)) for num in numbers)\n    return sum_of_rounded_numbers * list_length"}
