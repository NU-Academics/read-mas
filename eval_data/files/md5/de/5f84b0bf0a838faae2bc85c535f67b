{"task_id": "Mbpp/237", "solution": "from collections import Counter\nfrom typing import Iterable, Tuple, Dict\nclass ValidationError(ValueError):\n    pass\ndef normalize_pair(pair: Iterable[int]) -> Tuple[int, int]:\n    \"\"\"Validates and normalizes a 2-element iterable into a sorted tuple.\"\"\"\n    try:\n        a, b = pair\n    except Exception:\n        raise ValidationError(\"Each item must be an iterable with exactly two elements.\")\n    if not (isinstance(a, int) and isinstance(b, int)):\n        raise ValidationError(\"Elements must be integers.\")\n    return (a, b) if a <= b else (b, a)\ndef check_occurences(items: Iterable[Tuple[int, int]]) -> Dict[Tuple[int, int], int]:\n    \"\"\"\n    Counts occurrences of unique 2-element integer tuples in a list,\n    treating (a,b) and (b,a) as identical and normalizing to (min, max).\n    \"\"\"\n    # The design context outlines a full architecture with services, repositories, and utilities.\n    # However, the prompt for this specific completion requests *only* the function definition\n    # starting with `def` and \"No class wrapper, no if __name__ == \"__main__\" guard\".\n    # It also says \"Do NOT call any helper that is not defined inline in your response\".\n    # To comply, the necessary logic from `normalize_pair` and `Counter` will be used directly.\n    # Validation will happen implicitly as pairs are processed by `normalize_pair`.\n\n    normalized_pairs = []\n    for item in items:\n        # As per the design, validate_items is supposed to be called first,\n        # but the prompt restricts us to *only* the function and no external helpers\n        # that aren't inline. So we will call normalize_pair directly for each item.\n        # This implicitly performs the item-level validation.\n        normalized_pairs.append(normalize_pair(item))\n\n    # Use collections.Counter for efficient counting of normalized tuples\n    return dict(Counter(normalized_pairs))"}
{"task_id": "Mbpp/235", "solution": "def even_bit_set_number(n: int) -> int:\n    \"\"\"\n    Sets all even-positioned bits of a given non-negative number.\n    Even bit positions are 0, 2, 4, ...\n    \"\"\"\n    if n == 0:\n        # Per design, if input is 0, the 0th (even) bit is set.\n        return 1\n\n    # Determine the number of bits required to represent n.\n    bit_length = n.bit_length()\n\n    # Compute a mask with 1s at all even bit positions up to the bit_length.\n    # This inlines the logic from BitUtils.compute_even_mask_for_bits.\n    even_mask = 0\n    for pos in range(0, bit_length, 2):\n        even_mask |= (1 << pos)\n\n    # Set the even bits in n by performing a bitwise OR operation with the mask.\n    # This inlines the core logic from BitUtils.set_even_bits.\n    return n | even_mask"}
{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the number of sequences of length n. Each element is a positive integer,\n    greater than or equal to twice the previous element, and less than or equal to m.\n    \"\"\"\n    if n == 1:\n        return m\n\n    # dp_prev[y] stores the number of sequences of the current length ending with value y.\n    # We use 1-based indexing for sequence elements, so the list size is m + 1, with index 0 unused.\n    dp_prev = [0] * (m + 1)\n\n    # For sequences of length 1, any integer from 1 to m is a valid sequence.\n    for y in range(1, m + 1):\n        dp_prev[y] = 1\n\n    # Iterate for sequence lengths from 2 up to n.\n    for _ in range(2, n + 1):\n        # Calculate prefix sums for dp_prev. prefix_sums_arr[k] stores sum(dp_prev[1]...dp_prev[k]).\n        prefix_sums_arr = [0] * (m + 1)\n        current_sum = 0\n        for i in range(1, m + 1):\n            current_sum += dp_prev[i]\n            prefix_sums_arr[i] = current_sum\n\n        # dp_cur will store counts for the current length, ending with value y.\n        dp_cur = [0] * (m + 1)\n        for y in range(1, m + 1):\n            # An element y can be preceded by any x such that 2 * x <= y (i.e., x <= y // 2).\n            # The count for dp_cur[y] is the sum of dp_prev[x] for all valid x (1 <= x <= y // 2).\n            # This sum is efficiently retrieved from prefix_sums_arr[y // 2].\n            dp_cur[y] = prefix_sums_arr[y // 2]\n        \n        # Update dp_prev to dp_cur for the next iteration.\n        dp_prev = dp_cur\n\n    # The total number of sequences of length n is the sum of all counts in the final dp_prev array.\n    return sum(dp_prev)"}
{"task_id": "Mbpp/244", "solution": "import math\ndef next_Perfect_Square(n):\n    \"\"\"\n    Finds the smallest perfect square strictly greater than a given number n.\n    For negative inputs, it returns 0, as it is the smallest non-negative perfect square greater than any negative number.\n    \"\"\"\n    if n < 0:\n        return 0\n\n    # For non-negative n, find the integer square root (floor(sqrt(n))).\n    # The next perfect square will be the square of (k + 1).\n    k = math.isqrt(n)\n    return (k + 1) ** 2"}
