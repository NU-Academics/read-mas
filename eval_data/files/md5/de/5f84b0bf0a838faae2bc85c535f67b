{"task_id": "Mbpp/589", "solution": "from typing import List, Optional, Tuple, Dict, Protocol\ndef perfect_squares(start: int, end: int) -> List[int]:\n    \"\"\"\n    Finds perfect squares between two given numbers (inclusive).\n    \"\"\"\n    class ValidationError(Exception):\n        \"\"\"Exception raised for invalid input parameters.\"\"\"\n        pass\n\n    class RangeQuery:\n        \"\"\"Represents and validates a range query for perfect squares.\"\"\"\n        def __init__(self, start_val: int, end_val: int) -> None:\n            self.start = start_val\n            self.end = end_val\n            self._coerce_inputs()\n\n        def _coerce_inputs(self) -> None:\n            \"\"\"Coerce start and end to integers if they are not already.\"\"\"\n            try:\n                self.start = int(self.start)\n                self.end = int(self.end)\n            except (ValueError, TypeError) as e:\n                raise ValidationError(f\"Start and end values must be integers or convertible to integers: {e}\")\n\n        def validate(self) -> None:\n            \"\"\"Validates the range query, raising ValidationError for invalid bounds or types.\"\"\"\n            if not isinstance(self.start, int) or not isinstance(self.end, int):\n                 raise ValidationError(\"Start and end values must be integers.\")\n            if self.start > self.end:\n                raise ValidationError(\"Start value cannot be greater than end value.\")\n\n    class MathUtils:\n        \"\"\"Utility class for mathematical operations related to perfect squares.\"\"\"\n\n        @staticmethod\n        def integer_sqrt(n: int) -> int:\n            \"\"\"Returns the floor of the square root of n using integer math.\"\"\"\n            if n < 0:\n                raise ValidationError(\"n must be non-negative for integer_sqrt.\")\n            if n == 0:\n                return 0\n            \n            lo, hi = 0, n\n            while lo <= hi:\n                mid = (lo + hi) // 2\n                sq = mid * mid\n                if sq == n:\n                    return mid\n                if sq < n:\n                    lo = mid + 1\n                else:\n                    hi = mid - 1\n            return hi\n\n        @staticmethod\n        def is_perfect_square(n: int) -> bool:\n            \"\"\"Checks if n is a perfect square.\"\"\"\n            if n < 0:\n                return False\n            sqrt_n = MathUtils.integer_sqrt(n)\n            return sqrt_n * sqrt_n == n\n\n        @staticmethod\n        def first_square_ge(start_val: int) -> int:\n            \"\"\"Returns the smallest perfect square greater than or equal to start.\"\"\"\n            if start_val <= 0:\n                return 0\n            \n            sqrt_start_floor = MathUtils.integer_sqrt(start_val)\n            if sqrt_start_floor * sqrt_start_floor == start_val:\n                return start_val\n            else:\n                return (sqrt_start_floor + 1) * (sqrt_start_floor + 1)\n\n        @staticmethod\n        def squares_between(start_val: int, end_val: int) -> List[int]:\n            \"\"\"Generates perfect squares within the inclusive range [start, end].\"\"\"\n            if end_val < 0:\n                return []\n            \n            actual_start = max(0, start_val)\n            \n            first_sq = MathUtils.first_square_ge(actual_start)\n            \n            if first_sq > end_val:\n                return []\n\n            results = []\n            k = MathUtils.integer_sqrt(first_sq)\n            \n            while True:\n                current_square = k * k\n                if current_square > end_val:\n                    break\n                results.append(current_square)\n                k += 1\n            \n            return results\n\n    class CacheRepository(Protocol):\n        \"\"\"Protocol for a cache repository storing perfect square lists.\"\"\"\n        def get(self, key: Tuple[int, int]) -> Optional[List[int]]: ...\n        def put(self, key: Tuple[int, int], value: List[int]) -> None: ...\n\n    class InMemoryCacheRepository:\n        \"\"\"An in-memory implementation of CacheRepository.\"\"\"\n        def __init__(self) -> None:\n            self._store: Dict[Tuple[int, int], List[int]] = {}\n\n        def get(self, key: Tuple[int, int]) -> Optional[List[int]]:\n            \"\"\"Retrieves a cached list of squares.\"\"\"\n            return self._store.get(key)\n\n        def put(self, key: Tuple[int, int], value: List[int]) -> None:\n            \"\"\"Stores a list of squares in the cache.\"\"\"\n            self._store[key] = value\n\n    class PerfectSquareService:\n        \"\"\"Business logic service for finding perfect squares, using cache and math utilities.\"\"\"\n        def __init__(self, repository: CacheRepository, utils: MathUtils) -> None:\n            self.repository = repository\n            self.utils = utils\n\n        def find_squares(self, svc_start: int, svc_end: int) -> List[int]:\n            \"\"\"Finds perfect squares between start and end (inclusive), using cache.\"\"\"\n            rq = RangeQuery(svc_start, svc_end)\n            rq.validate()\n            \n            key = (rq.start, rq.end)\n            cached = self.repository.get(key)\n            if cached is not None:\n                return list(cached)\n            \n            result = self.utils.squares_between(rq.start, rq.end)\n            self.repository.put(key, result)\n            return result\n\n    class PerfectSquareController:\n        \"\"\"Controller exposing the perfect squares functionality for library integration.\"\"\"\n        def __init__(self, service: PerfectSquareService) -> None:\n            self.service = service\n\n        def handle_request(self, ctrl_start: int, ctrl_end: int) -> List[int]:\n            \"\"\"Handles a request to find perfect squares in a given range.\"\"\"\n            return self.service.find_squares(ctrl_start, ctrl_end)\n\n    repo = InMemoryCacheRepository()\n    utils = MathUtils()\n    svc = PerfectSquareService(repo, utils)\n    ctrl = PerfectSquareController(svc)\n    return ctrl.handle_request(start, end)"}
{"task_id": "Mbpp/588", "solution": "def big_diff(numbers):\n    \"\"\"Calculates the difference between the largest and smallest value in a list of numbers.\"\"\"\n    max_val = max(numbers)\n    min_val = min(numbers)\n    return max_val - min_val"}
{"task_id": "Mbpp/591", "solution": "from typing import List, Any\ndef swap_List(items: List[Any]) -> List[Any]:\n    \"\"\"\n    Interchanges the first and last elements in a list.\n    Returns a new list with the elements swapped, or a shallow copy if the list has fewer than two elements.\n    \"\"\"\n    if len(items) < 2:\n        return items.copy()\n\n    new_list = items.copy()\n    new_list[0], new_list[-1] = new_list[-1], new_list[0]\n    return new_list"}
{"task_id": "Mbpp/592", "solution": "import math\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients using the identity C(2n, n+1).\n    \"\"\"\n    return math.comb(2 * n, n + 1)"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(values: list[int]) -> int:\n    \"\"\"\n    Finds the difference of the first even and first odd number in a list.\n    Assumes the list contains at least one even and one odd number.\n    \"\"\"\n    first_odd = None\n    first_even = None\n\n    for v in values:\n        if first_odd is None and v % 2 != 0:\n            first_odd = v\n        if first_even is None and v % 2 == 0:\n            first_even = v\n        \n        if first_odd is not None and first_even is not None:\n            break\n            \n    return first_even - first_odd"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip: str) -> str:\n    \"\"\"Removes leading zeros from each octet of an IPv4 address string.\n    Raises ValueError for invalid IP address formats or out-of-range octet values.\n    \"\"\"\n\n    def _strip_leading_zeros(octet: str) -> str:\n        \"\"\"Removes leading zeros from an octet string, preserving '0'.\"\"\"\n        s = octet.lstrip('0')\n        return s if s else '0'\n\n    def _is_digits(s: str) -> bool:\n        \"\"\"Checks if a string consists only of digits.\"\"\"\n        return s.isdigit()\n\n    parts = ip.split('.')\n    if len(parts) != 4:\n        raise ValueError(\"IPv4 must have 4 octets.\")\n\n    normalized_octets = []\n    for octet_str in parts:\n        if not _is_digits(octet_str):\n            raise ValueError(f\"Non-digit characters or empty octet found: '{octet_str}'.\")\n\n        normalized_octet_str = _strip_leading_zeros(octet_str)\n        octet_value = int(normalized_octet_str)\n\n        if not (0 <= octet_value <= 255):\n            raise ValueError(f\"Octet value {octet_value} out of range (0-255).\")\n\n        normalized_octets.append(normalized_octet_str)\n\n    return \".\".join(normalized_octets)"}
{"task_id": "Mbpp/596", "solution": "import sys\nclass InvalidTupleError(ValueError):\n    \"\"\"Raised when the input object is not a tuple.\"\"\"\n    pass\nclass SizeComputationError(RuntimeError):\n    \"\"\"Raised when sys.getsizeof fails during computation.\"\"\"\n    pass\nclass SysAdapter:\n    \"\"\"Adapts sys.getsizeof for mockability and error handling.\"\"\"\n    def __init__(self, module_ref=None):\n        self._module_ref = module_ref or sys\n\n    def get_size(self, obj: object) -> int:\n        \"\"\"Returns the shallow size of an object in bytes using the system's sizeof.\"\"\"\n        try:\n            return int(self._module_ref.getsizeof(obj))\n        except Exception as exc:\n            raise SizeComputationError(f\"sys.getsizeof failed: {exc}\") from exc\nclass TupleSizeCalculator:\n    \"\"\"Calculates the size of a tuple, specifically its shallow size.\"\"\"\n    def compute_shallow(self, obj: tuple, adapter: SysAdapter) -> int:\n        \"\"\"Computes the shallow size of the tuple using the provided adapter.\"\"\"\n        return adapter.get_size(obj)\nclass ObjectSizeService:\n    \"\"\"Orchestrates size computation, validating input and delegating to a calculator.\"\"\"\n    def __init__(self, calculator: TupleSizeCalculator, adapter: SysAdapter):\n        self._calculator = calculator\n        self._adapter = adapter\n\n    def get_size(self, obj: object, deep: bool = False) -> int:\n        \"\"\"Retrieves the size of an object, validating it's a tuple for shallow computation.\"\"\"\n        if not isinstance(obj, tuple):\n            raise InvalidTupleError(\"Object must be a tuple\")\n        # 'deep' calculation is not required for the given problem's assertion.\n        return self._calculator.compute_shallow(obj, self._adapter)\nclass TupleSizeController:\n    \"\"\"Handles API requests, validates input, and delegates to the size service.\"\"\"\n    def __init__(self, service: ObjectSizeService):\n        self._service = service\n\n    def tuple_size(self, tpl: tuple) -> int:\n        \"\"\"Computes the shallow size of a tuple after validation.\"\"\"\n        validate_tuple(tpl)\n        return self._service.get_size(tpl, deep=False)\ndef tuple_size(t: tuple) -> int:\n    \"\"\"Calculates the shallow size of a tuple in bytes, matching sys.getsizeof.\"\"\"\n    calculator = TupleSizeCalculator()\n    adapter = SysAdapter()\n    service = ObjectSizeService(calculator=calculator, adapter=adapter)\n    controller = TupleSizeController(service=service)\n    return controller.tuple_size(t)"}
{"task_id": "Mbpp/590", "solution": "import math\nimport cmath\nimport datetime\nimport collections\nfrom typing import Any, Tuple, List, Optional\nfrom abc import ABC, abstractmethod\nfrom dataclasses import dataclass, field\nclass InvalidCoordinateError(ValueError):\n    \"\"\"Custom exception for invalid numeric coordinate inputs.\"\"\"\n    pass\ndef validate_numeric(value: Any) -> float:\n    \"\"\"Validate if a value is a finite number and return it as a float.\"\"\"\n    if not isinstance(value, (int, float)):\n        raise InvalidCoordinateError(f\"Coordinate must be a number, got {type(value).__name__}\")\n    if math.isinf(value) or math.isnan(value):\n        raise InvalidCoordinateError(f\"Coordinate cannot be infinite or NaN, got {value}\")\n    return float(value)\ndef normalize_angle(theta: float) -> float:\n    \"\"\"Normalize an angle to the range (-pi, pi].\"\"\"\n    theta = math.fmod(theta, 2 * math.pi)\n    if theta > math.pi:\n        theta -= 2 * math.pi\n    elif theta <= -math.pi:\n        theta += 2 * math.pi\n    return theta\ndef canonicalize_polar(r: float, theta: float) -> Tuple[float, float]:\n    \"\"\"Ensure radius is non-negative and angle is normalized to (-pi, pi].\"\"\"\n    if r < 0:\n        r = -r\n        theta += math.pi\n    return r, normalize_angle(theta)\nDEFAULT_HISTORY_SIZE: int = 100\nclass ConversionHistoryRepository(ABC):\n    \"\"\"Abstract base class for conversion history repositories.\"\"\"\n    @abstractmethod\n    def append(self, record: ConversionRecord) -> None:\n        pass\n\n    @abstractmethod\n    def get_recent(self, n: int = 10) -> List[ConversionRecord]:\n        pass\nclass InMemoryHistoryRepository(ConversionHistoryRepository):\n    \"\"\"In-memory ring buffer for storing conversion records.\"\"\"\n    _deque: collections.deque\n\n    def __init__(self, max_size: int = DEFAULT_HISTORY_SIZE):\n        self._deque = collections.deque(maxlen=max_size)\n\n    def append(self, record: ConversionRecord) -> None:\n        \"\"\"Appends a conversion record to the history.\"\"\"\n        self._deque.append(record)\n\n    def get_recent(self, n: int = 10) -> List[ConversionRecord]:\n        \"\"\"Returns the most recent n conversion records.\"\"\"\n        return list(self._deque)[-n:]\nclass ConverterService:\n    \"\"\"Service for converting between coordinate systems and recording history.\"\"\"\n    _history_repo: Optional[ConversionHistoryRepository]\n\n    def __init__(self, history_repo: Optional[ConversionHistoryRepository] = None):\n        self._history_repo = history_repo\n\n    def cartesian_to_polar(self, x: float, y: float) -> Polar:\n        \"\"\"Converts Cartesian (x, y) coordinates to Polar (r, theta) coordinates.\"\"\"\n        x = validate_numeric(x)\n        y = validate_numeric(y)\n        r = math.hypot(x, y)\n        theta = math.atan2(y, x)\n        r, theta = canonicalize_polar(r, theta)\n        return Polar(r=r, theta=theta)\n\n    def polar_to_rectangular(self, r: float, theta: float) -> complex:\n        \"\"\"Converts Polar (r, theta) coordinates to a complex rectangular number.\"\"\"\n        r = validate_numeric(r)\n        theta = validate_numeric(theta)\n        r, theta = canonicalize_polar(r, theta)\n        return complex(r * math.cos(theta), r * math.sin(theta))\n\n    def convert(self, a: float, b: float, mode: str = 'auto') -> Tuple[Polar, complex]:\n        \"\"\"Converts coordinates based on the specified mode.\n        mode='auto' or 'cartesian' treats (a,b) as Cartesian (x,y); 'polar' treats (a,b) as (r,theta).\n        \"\"\"\n        if mode not in {'auto', 'cartesian', 'polar'}:\n            raise ValueError(f\"Invalid mode: '{mode}'. Must be 'auto', 'cartesian', or 'polar'.\")\n\n        result_polar: Polar\n        result_rectangular: complex\n\n        if mode == 'polar':\n            input_r, input_theta = a, b\n            r, theta = canonicalize_polar(input_r, input_theta)\n            result_polar = Polar(r=r, theta=theta)\n            result_rectangular = self.polar_to_rectangular(input_r, input_theta)\n        else:  # 'auto' or 'cartesian'\n            input_x, input_y = a, b\n            result_polar = self.cartesian_to_polar(input_x, input_y)\n            result_rectangular = complex(validate_numeric(input_x), validate_numeric(input_y))\n\n        self.record_conversion((a, b), mode, result_polar, result_rectangular)\n        return result_polar, result_rectangular\n\n    def record_conversion(self, input_tuple: Tuple[float, float], mode: str, polar: Polar, rectangular: complex) -> None:\n        \"\"\"Records a conversion event to the history repository.\"\"\"\n        if self._history_repo:\n            timestamp = datetime.datetime.utcnow().isoformat() + \"Z\"\n            record = ConversionRecord(\n                timestamp=timestamp,\n                input=input_tuple,\n                mode=mode,\n                polar=polar,\n                rectangular=rectangular\n            )\n            try:\n                self._history_repo.append(record)\n            except Exception:\n                pass\n_DEFAULT_REPO_INSTANCE: Optional[InMemoryHistoryRepository] = None\ndef _build_default_repo() -> ConversionHistoryRepository:\n    \"\"\"Builds and returns the default in-memory history repository (singleton).\"\"\"\n    global _DEFAULT_REPO_INSTANCE\n    if _DEFAULT_REPO_INSTANCE is None:\n        _DEFAULT_REPO_INSTANCE = InMemoryHistoryRepository(max_size=DEFAULT_HISTORY_SIZE)\n    return _DEFAULT_REPO_INSTANCE\ndef polar_rect(a: float, b: float, mode: str = 'auto', repo: Optional[ConversionHistoryRepository] = None) -> Tuple[Polar, complex]:\n    \"\"\"Converts coordinates between polar and rectangular forms based on the specified mode.\"\"\"\n    service = ConverterService(history_repo=repo or _build_default_repo())\n    return service.convert(a, b, mode)"}
{"task_id": "Mbpp/597", "solution": "def find_kth(a: list[int], b: list[int], k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays using a binary search approach.\n    Assumes arrays 'a' and 'b' are sorted and 'k' is a valid 1-based index.\n    \"\"\"\n    m, n = len(a), len(b)\n    # Ensure a is the shorter array to optimize binary search range\n    if m > n:\n        return find_kth(b, a, k)\n\n    # Binary search range for elements taken from array 'a'\n    # 'low' can be 0 (take no elements from a)\n    # 'high' can be min(k, m) (take at most k elements from a, and at most m elements from a)\n    low, high = max(0, k - n), min(k, m)\n\n    while low <= high:\n        # Number of elements taken from array 'a'\n        mid_a = (low + high) // 2\n        # Number of elements taken from array 'b'\n        mid_b = k - mid_a\n\n        # Define border elements for partitioning\n        # If no elements are taken, left boundary is negative infinity\n        # If all elements are taken, right boundary is positive infinity\n        a_left = a[mid_a - 1] if mid_a > 0 else float('-inf')\n        a_right = a[mid_a] if mid_a < m else float('inf')\n        b_left = b[mid_b - 1] if mid_b > 0 else float('-inf')\n        b_right = b[mid_b] if mid_b < n else float('inf')\n\n        # Check if partitions are correct\n        if a_left <= b_right and b_left <= a_right:\n            return int(max(a_left, b_left))\n        elif a_left > b_right:\n            # Too many elements taken from 'a', move 'high' pointer left\n            high = mid_a - 1\n        else:\n            # Too few elements taken from 'a', move 'low' pointer right\n            low = mid_a + 1\n    # This point should not be reached with valid sorted inputs and k\n    return -1"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(n: int) -> bool:\n    \"\"\"Checks if a given number is an Armstrong number.\"\"\"\n    s_n = str(n)\n    digit_count = len(s_n)\n    digits = [int(digit_char) for digit_char in s_n]\n\n    total_sum = sum(digit ** digit_count for digit in digits)\n\n    return total_sum == n"}
{"task_id": "Mbpp/602", "solution": "from typing import Optional, Any\nfrom abc import ABC, abstractmethod\nfrom collections import Counter\nclass FirstRepeatError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass CharResult:\n    def __init__(self, character: Optional[str], index: Optional[int]) -> None:\n        self.character = character\n        self.index = index\n\n    def is_found(self) -> bool:\n        return self.character is not None\n\n    def __repr__(self) -> str:\n        return f\"CharResult(character={self.character!r}, index={self.index!r})\"\nclass Validator:\n    MAX_INPUT_LENGTH: int = 10_000_000\n\n    def validate_string(self, s: Any) -> str:\n        if not isinstance(s, str):\n            raise FirstRepeatError(\"Input must be a string\")\n        if len(s) > self.MAX_INPUT_LENGTH:\n            raise FirstRepeatError(f\"Input exceeds maximum length of {self.MAX_INPUT_LENGTH} characters\")\n        return s\nclass AlgorithmRepository(ABC):\n    @abstractmethod\n    def find_first_repeated(self, s: str) -> CharResult:\n        pass\nclass HashSetRepository(AlgorithmRepository):\n    def find_first_repeated(self, s: str) -> CharResult:\n        try:\n            counts = Counter(s)\n            for idx, ch in enumerate(s):\n                if counts[ch] >= 2:\n                    return CharResult(ch, idx)\n            return CharResult(None, None)\n        except Exception as e:\n            raise FirstRepeatError(f\"Algorithm failed: {e}\")\nclass FirstRepeatService:\n    def __init__(self, repo: AlgorithmRepository, validator: Validator) -> None:\n        self._repo = repo\n        self._validator = validator\n\n    def find_first_repeated(self, s: Any) -> Optional[str]:\n        valid_s = self._validator.validate_string(s)\n        result = self._repo.find_first_repeated(valid_s)\n        return result.character\ndef first_repeated_char(s: str) -> Optional[str]:\n    \"\"\"Finds the first repeated character in a string using a service-repository pattern.\"\"\"\n    validator = Validator()\n    repo = HashSetRepository()\n    service = FirstRepeatService(repo, validator)\n    return service.find_first_repeated(s)"}
