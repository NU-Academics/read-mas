{"task_id": "Mbpp/247", "solution": "import collections\nimport abc\nclass LPSValueError(Exception):\n    \"\"\"Exception for invalid LPS input.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\nclass LPSResult:\n    \"\"\"Data transfer object for LPS computation results.\"\"\"\n    def __init__(self, length: int, subsequence: str = None):\n        self.length = length\n        self.subsequence = subsequence\nDEFAULT_MAX_INPUT_LENGTH: int = 10000\nclass StringNormalizer:\n    \"\"\"Normalizes strings for consistent processing and cache keys.\"\"\"\n    def __init__(self, keep_case_default: bool = False):\n        self.keep_case_default = keep_case_default\n\n    def normalize(self, s: str, keep_case: bool = False) -> str:\n        text = s.strip()\n        if not (keep_case or self.keep_case_default):\n            text = text.lower()\n        return text\n\n    def key(self, s: str, keep_case: bool = False) -> str:\n        \"\"\"Generates a canonical cache key from the string.\"\"\"\n        return self.normalize(s, keep_case)\ndef default_normalizer() -> StringNormalizer:\n    \"\"\"Provides a default StringNormalizer instance.\"\"\"\n    return StringNormalizer()\nDEFAULT_CACHE_SIZE: int = 1024\nclass CacheRepository(abc.ABC):\n    \"\"\"Abstract base class for cache repositories.\"\"\"\n    @abc.abstractmethod\n    def get(self, key: str) -> int | None:\n        pass\n\n    @abc.abstractmethod\n    def set(self, key: str, value: int) -> None:\n        pass\n\n    @abc.abstractmethod\n    def clear(self) -> None:\n        pass\nclass InMemoryCache(CacheRepository):\n    \"\"\"An in-memory LRU cache implementation for LPS results.\"\"\"\n    def __init__(self, max_size: int = DEFAULT_CACHE_SIZE):\n        self._max_size = max_size\n        self._store = {}\n        self._order = collections.deque()\n\n    def get(self, key: str) -> int | None:\n        val = self._store.get(key)\n        if val is not None:\n            try:\n                self._order.remove(key)\n            except ValueError:\n                pass\n            self._order.append(key)\n        return val\n\n    def set(self, key: str, value: int) -> None:\n        if key in self._store:\n            try:\n                self._order.remove(key)\n            except ValueError:\n                pass\n        self._store[key] = value\n        self._order.append(key)\n        if len(self._order) > self._max_size:\n            oldest = self._order.popleft()\n            self._store.pop(oldest, None)\n\n    def clear(self) -> None:\n        \"\"\"Clears all entries from the cache.\"\"\"\n        self._store.clear()\n        self._order.clear()\nclass LPSService:\n    \"\"\"Manages LPS computation, including caching and normalization.\"\"\"\n    def __init__(self, cache: CacheRepository, normalizer: StringNormalizer, max_input_len: int = DEFAULT_MAX_INPUT_LENGTH):\n        self._cache = cache\n        self._normalizer = normalizer\n        self._max_input_len = max_input_len\n\n    def compute_lps(self, s: str) -> LPSResult:\n        \"\"\"Computes the length of the longest palindromic subsequence.\"\"\"\n        if len(s) > self._max_input_len:\n            raise LPSValueError(f\"Input string length exceeds maximum allowed ({self._max_input_len}).\")\n\n        normalized_key = self._normalizer.key(s)\n\n        cached_length = self._cache.get(normalized_key)\n        if cached_length is not None:\n            return LPSResult(length=cached_length)\n\n        length = self._compute_lps_dp(s)\n\n        try:\n            self._cache.set(normalized_key, length)\n        except Exception:\n            pass \n\n        return LPSResult(length=length)\n\n    def _compute_lps_dp(self, s: str) -> int:\n        \"\"\"Dynamic programming implementation to find LPS length.\"\"\"\n        n = len(s)\n        if n == 0:\n            return 0\n        dp = [[0]*n for _ in range(n)]\n        for i in range(n-1, -1, -1):\n            dp[i][i] = 1\n            for j in range(i+1, n):\n                if s[i] == s[j]:\n                    dp[i][j] = dp[i+1][j-1] + 2\n                else:\n                    dp[i][j] = max(dp[i+1][j], dp[i][j-1])\n        return dp[0][n-1]\nclass ServiceFactory:\n    \"\"\"Factory to create LPSService instances with default dependencies.\"\"\"\n    def create_lps_service(self, cache: CacheRepository | None = None, normalizer: StringNormalizer | None = None) -> LPSService:\n        cache = cache or InMemoryCache()\n        normalizer = normalizer or default_normalizer()\n        return LPSService(cache=cache, normalizer=normalizer)\ndef lps(s: str) -> int:\n    service = ServiceFactory().create_lps_service()\n    result = service.compute_lps(s)\n    return result.length"}
{"task_id": "Mbpp/256", "solution": "def count_Primes_nums(n: int) -> int:\n    \"\"\"\n    Counts the number of prime numbers less than a given non-negative integer n\n    using the Sieve of Eratosthenes algorithm.\n    \"\"\"\n    if n < 2:\n        return 0\n\n    sieve = [True] * n\n    sieve[0:2] = [False, False]  # 0 and 1 are not prime\n\n    import math\n    for p in range(2, int(math.isqrt(n)) + 1):\n        if sieve[p]:\n            # Mark multiples of p as not prime\n            for multiple in range(p * p, n, p):\n                sieve[multiple] = False\n\n    return sum(sieve)"}
