{"task_id": "Mbpp/569", "solution": "def sort_sublists(list_of_lists):\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists lexicographically.\n    Validation for input types and structure is performed.\n    \"\"\"\n    from typing import List, Dict, Any, Optional\n\n    class InvalidInputError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class SortError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class InputValidator:\n        @staticmethod\n        def is_string(value: Any) -> bool:\n            return isinstance(value, str)\n\n        @staticmethod\n        def validate_list_of_lists(data: Any) -> None:\n            if not isinstance(data, (list, tuple)):\n                raise InvalidInputError(\"Input must be a list of lists of strings.\")\n            for i, sub in enumerate(data):\n                if not isinstance(sub, (list, tuple)):\n                    raise InvalidInputError(f\"Element at index {i} is not a list.\")\n                for j, item in enumerate(sub):\n                    if not InputValidator.is_string(item):\n                        raise InvalidInputError(f\"Item at [{i}][{j}] is not a string.\")\n\n    class SublistSorterService:\n        def __init__(self, validator: InputValidator = None, repository=None) -> None:\n            self._validator = validator or InputValidator()\n            self._repository = repository\n\n        def sort(self, input_data: List[List[str]]) -> List[List[str]]:\n            self._validator.validate_list_of_lists(input_data)\n            try:\n                return [sorted(list(sub)) for sub in input_data]\n            except Exception as exc:\n                raise SortError(f\"Failed to sort sublists: {exc}\") from exc\n\n    class SortResult:\n        def __init__(self, input_data: List[List[str]], output_data: List[List[str]]) -> None:\n            self.input_data = input_data\n            self.output_data = output_data\n\n        def to_dict(self) -> Dict[str, Any]:\n            return {\"input\": self.input_data, \"output\": self.output_data}\n\n    class SublistSorterController:\n        def __init__(self, service: SublistSorterService):\n            self._service = service\n\n        def handle(self, input_data: Any) -> SortResult:\n            output = self._service.sort(input_data)\n            return SortResult(input_data=input_data, output_data=output)\n\n    service = SublistSorterService()\n    controller = SublistSorterController(service)\n    result = controller.handle(list_of_lists)\n    return result.output_data"}
{"task_id": "Mbpp/573", "solution": "def unique_product(numbers: list[float]) -> float:\n    \"\"\"\n    Calculates the product of the unique numbers in a given list.\n    Deduplicates and sorts the numbers before multiplication for deterministic results.\n    \"\"\"\n    unique_sorted_numbers = sorted(list(set(numbers)))\n\n    product_result = 1\n    for num in unique_sorted_numbers:\n        product_result *= num\n    \n    return product_result"}
{"task_id": "Mbpp/572", "solution": "from collections import Counter\nfrom typing import Iterable, List\ndef two_unique_nums(*lists: Iterable[int]) -> List[int]:\n    \"\"\"\n    Finds numbers that appear exactly once across all provided lists.\n    The result is sorted in ascending order.\n    \"\"\"\n    flat_list = []\n    # Flatten all input iterables into a single list.\n    for sub_list in lists:\n        for item in sub_list:\n            flat_list.append(item)\n\n    # Count occurrences of each number in the flattened list.\n    counts = Counter(flat_list)\n\n    # Collect numbers that appear exactly once.\n    unique_numbers = [num for num, count in counts.items() if count == 1]\n\n    # Return the unique numbers, sorted in ascending order.\n    return sorted(unique_numbers)"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(list1, list2):\n    \"\"\"\n    Checks if list2 is a contiguous sublist of list1 using the KMP algorithm.\n    This function efficiently finds sublists in O(N+M) time complexity.\n    \"\"\"\n\n    def build_lps(pattern):\n        \"\"\"Computes the Longest Proper Prefix which is also Suffix array for KMP.\"\"\"\n        m = len(pattern)\n        lps = [0] * m\n        length = 0\n        i = 1\n        while i < m:\n            if pattern[i] == pattern[length]:\n                length += 1\n                lps[i] = length\n                i += 1\n            else:\n                if length != 0:\n                    length = lps[length - 1]\n                else:\n                    lps[i] = 0\n                    i += 1\n        return lps\n\n    haystack = list1\n    needle = list2\n\n    if len(needle) == 0:\n        return True\n    if len(needle) > len(haystack):\n        return False\n\n    lps = build_lps(needle)\n    \n    i = 0  # index for haystack\n    j = 0  # index for needle\n\n    while i < len(haystack):\n        if haystack[i] == needle[j]:\n            i += 1\n            j += 1\n            if j == len(needle):\n                return True\n        else:\n            if j != 0:\n                j = lps[j - 1]\n            else:\n                i += 1\n    \n    return False"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(a: list, b: list, c: list) -> list:\n    \"\"\"Interleaves three lists of the same length into a single flat list.\n    Assumes inputs are lists of equal length based on context requirements.\"\"\"\n    n = len(a)\n    result: list = []\n    for i in range(n):\n        result.append(a[i])\n        result.append(b[i])\n        result.append(c[i])\n    return result"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Finds the last digit in the factorial of a given non-negative number.\n    For n >= 5, n! ends in 0; for smaller n, it computes the factorial directly.\n    \"\"\"\n    if n >= 5:\n        return 0\n    \n    if n == 0:\n        return 1 # 0! = 1\n    \n    factorial_val = 1\n    for i in range(1, n + 1):\n        factorial_val *= i\n    \n    return factorial_val % 10"}
{"task_id": "Mbpp/580", "solution": "from typing import Optional, Tuple\ndef is_int(obj: object) -> bool:\n    \"\"\"Checks if an object is an integer, excluding booleans.\"\"\"\n    return isinstance(obj, int) and not isinstance(obj, bool)\nclass TupleNode:\n    \"\"\"Represents a node in a nested tuple structure for processing.\"\"\"\n    def __init__(self, value: Optional[int] = None, children: Optional[Tuple[\"TupleNode\", ...]] = None):\n        self.value = value\n        self.children = children\n\n    def is_value(self) -> bool:\n        \"\"\"Returns True if this node holds an integer value.\"\"\"\n        return self.value is not None\n\n    def is_container(self) -> bool:\n        \"\"\"Returns True if this node holds child nodes.\"\"\"\n        return self.children is not None\n\n    def to_native(self):\n        \"\"\"Converts this TupleNode back to a native Python int or tuple.\"\"\"\n        if self.is_value():\n            return self.value\n        return tuple(child.to_native() for child in (self.children or ()))\n\n    @staticmethod\n    def from_native(obj: object) -> \"TupleNode\":\n        \"\"\"Factory method to create a TupleNode from a native Python int or tuple.\"\"\"\n        # This function assumes 'obj' is either an int or a tuple based on the problem description.\n        if is_int(obj):\n            return TupleNode(value=obj)\n        # If not an int, it must be a tuple for correct operation per problem description and example.\n        children = tuple(TupleNode.from_native(elem) for elem in obj)\n        return TupleNode(children=children)\nclass TupleExtractor:\n    \"\"\"Service to extract even numbers from a nested tuple structure recursively.\"\"\"\n    MAX_DEPTH = 1000\n\n    def extract_even(self, input_tuple: tuple) -> tuple:\n        \"\"\"\n        Processes the input tuple to remove odd integers, preserving structure.\n        Assumes input_tuple is a tuple and contains only integers or nested tuples.\n        \"\"\"\n        # Convert native tuple to TupleNode structure. Assumes input_tuple is indeed a tuple.\n        root = TupleNode.from_native(input_tuple)\n        \n        # Process the TupleNode structure recursively\n        processed_root = self._process_node(root, depth=0)\n        \n        # Convert the processed TupleNode structure back to a native tuple\n        return processed_root.to_native()\n\n    def _process_node(self, node: TupleNode, depth: int) -> Optional[TupleNode]:\n        \"\"\"\n        Recursively processes a TupleNode to filter out odd integers.\n        Returns None if an odd value node is encountered.\n        \"\"\"\n        if depth > self.MAX_DEPTH:\n            raise RuntimeError(f\"Maximum recursion depth ({self.MAX_DEPTH}) exceeded.\")\n\n        if node.is_value():\n            # If it's a value node, keep it only if it's even\n            if self._keep_value(node.value):\n                return node\n            return None # Odd value, so filter it out\n        elif node.is_container():\n            # If it's a container node, process its children\n            filtered_children = []\n            for child in (node.children or ()):\n                processed_child = self._process_node(child, depth + 1)\n                if processed_child is not None:\n                    filtered_children.append(processed_child)\n            # Create a new TupleNode for the container with filtered children\n            return TupleNode(children=tuple(filtered_children))\n        \n        return None # Should not be reached with typical TupleNode usage\n\n    def _keep_value(self, value: int) -> bool:\n        \"\"\"Returns True if the integer value is even.\"\"\"\n        return value % 2 == 0\ndef extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Removes odd integers from a nested tuple, preserving even numbers and structure.\n    Assumes input_tuple is a tuple and contains only integers or nested tuples.\n    \"\"\"\n    return TupleExtractor().extract_even(input_tuple)"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(a: tuple, b: tuple) -> tuple:\n    \"\"\"Finds elements present in one tuple but not in the other, preserving original order and unique occurrences.\n\n    The result contains unique elements from the first tuple, then unique elements from the second tuple.\n    \"\"\"\n    \n    # Calculate the intersection of elements present in both tuples.\n    # This identifies elements that are *not* dissimilar.\n    intersection = set(a) & set(b)\n\n    # Prepare lists to store unique dissimilar elements from each tuple,\n    # and sets to track seen elements within each tuple to preserve first occurrence.\n    first_unique = []\n    seen_in_a = set()\n\n    # Iterate through the first tuple to find elements dissimilar to the second.\n    for item in a:\n        if item not in intersection and item not in seen_in_a:\n            first_unique.append(item)\n            seen_in_a.add(item)\n\n    second_unique = []\n    seen_in_b = set()\n\n    # Iterate through the second tuple to find elements dissimilar to the first.\n    for item in b:\n        if item not in intersection and item not in seen_in_b:\n            second_unique.append(item)\n            seen_in_b.add(item)\n            \n    # Combine the unique dissimilar elements from both tuples and return as a new tuple.\n    return tuple(first_unique + second_unique)"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(arr, n):\n    \"\"\"\n    Splits a list at the nth element and moves the first part to the end.\n    The split index n is normalized using modulo arithmetic to handle negative or out-of-range values.\n    \"\"\"\n    if not arr:  # Handle empty list as a special case if not explicitly allowed to raise ZeroDivisionError\n        return [] # Returning an empty list, as per standard list behavior and avoiding division by zero.\n                  # The design context indicates ValidationError, but requirements prohibit explicit error raising.\n                  # Returning an empty list is a safe default for a simple function where no errors are allowed.\n\n    split_point = n % len(arr)\n    return arr[split_point:] + arr[:split_point]"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int, cache_path: str = None, max_n: int = 1000) -> int:\n    \"\"\"\n    Computes the nth Catalan number using the binomial coefficient formula.\n    It leverages an inline cache and input validation as per design.\n    \"\"\"\n    import os\n    import json\n    from typing import Optional, Any, Dict\n\n    class InvalidInputError(ValueError):\n        pass\n\n    class ComputationError(RuntimeError):\n        pass\n\n    class MathUtils:\n        @staticmethod\n        def binomial_coefficient(n_val: int, k_val: int) -> int:\n            \"\"\"Calculates binomial coefficient C(n_val, k_val) using iterative multiplication.\"\"\"\n            if k_val < 0 or k_val > n_val:\n                return 0\n            k_val = min(k_val, n_val - k_val)\n            result = 1\n            for i in range(1, k_val + 1):\n                result = result * (n_val - k_val + i) // i\n            return result\n\n    class InputValidator:\n        def __init__(self, max_n_val: int):\n            self._max_n = max_n_val\n\n        def validate_n(self, n_input: Any) -> int:\n            \"\"\"Validates if n_input is a non-negative integer within limits.\"\"\"\n            if not isinstance(n_input, int):\n                try:\n                    n_input = int(n_input)\n                except Exception:\n                    raise InvalidInputError(f\"n must be an integer, got {type(n_input)}\")\n            if n_input < 0:\n                raise InvalidInputError(\"n must be non-negative\")\n            if n_input > self._max_n:\n                raise InvalidInputError(f\"n must be <= {self._max_n}\")\n            return n_input\n\n    class CacheRepository:\n        DEFAULT_CACHE_PATH = \"./cache/catalan_cache.json\"\n\n        def __init__(self, path: Optional[str] = None):\n            self._path = path if path is not None else self.DEFAULT_CACHE_PATH\n            self._store: Dict[int, int] = {}\n            self.load()\n\n        def get(self, n_val: int) -> Optional[int]:\n            \"\"\"Retrieves a cached Catalan number by its index n_val.\"\"\"\n            return self._store.get(n_val)\n\n        def set(self, n_val: int, value: int) -> None:\n            \"\"\"Stores a Catalan number in the cache and attempts to save it.\"\"\"\n            self._store[n_val] = value\n            try:\n                self.save()\n            except Exception:\n                # best-effort persistence; do not break computation\n                pass\n\n        def load(self) -> None:\n            \"\"\"Loads cached data from the JSON file into the in-memory store.\"\"\"\n            try:\n                if os.path.exists(self._path):\n                    with open(self._path, \"r\", encoding=\"utf-8\") as f:\n                        data = json.load(f)\n                        data_map = data.get(\"data\", data) # Handle potential versioned format\n                        for k, v in data_map.items():\n                            self._store[int(k)] = int(v)\n            except Exception:\n                # ignore load errors\n                pass\n\n        def save(self) -> None:\n            \"\"\"Saves the in-memory cache to the JSON file using an atomic write.\"\"\"\n            os.makedirs(os.path.dirname(self._path), exist_ok=True)\n            tmp_path = self._path + \".tmp\"\n            with open(tmp_path, \"w\", encoding=\"utf-8\") as f:\n                json.dump(self._store, f)\n            os.replace(tmp_path, self._path)\n\n        def clear(self) -> None:\n            \"\"\"Clears the in-memory cache and persists the empty state.\"\"\"\n            self._store.clear()\n            try:\n                self.save()\n            except Exception:\n                pass\n\n    class CatalanCalculator:\n        def __init__(self, max_n_val: int, cache_repo: CacheRepository):\n            self._max_n = max_n_val\n            self._cache = cache_repo\n\n        def compute(self, n_val: int) -> int:\n            \"\"\"Computes the nth Catalan number, using cache or calculation.\"\"\"\n            val = self._cache.get(n_val)\n            if val is not None:\n                return val\n            try:\n                # Use binomial for efficiency\n                val = self.compute_binomial(n_val)\n                self._cache.set(n_val, val)\n                return val\n            except Exception as e:\n                raise ComputationError(f\"Failed computing Catalan({n_val})\") from e\n\n        def compute_binomial(self, n_val: int) -> int:\n            \"\"\"Calculates Catalan number C(n_val) using the binomial coefficient formula.\"\"\"\n            num = MathUtils.binomial_coefficient(2 * n_val, n_val)\n            return num // (n_val + 1)\n\n        def compute_dp(self, n_val: int) -> int:\n            \"\"\"Calculates Catalan number C(n_val) using dynamic programming recurrence.\"\"\"\n            if n_val <= 1:\n                return 1\n            C = [0] * (n_val + 1)\n            C[0] = 1\n            for i in range(1, n_val + 1):\n                total = 0\n                for j in range(i):\n                    total += C[j] * C[i - 1 - j]\n                C[i] = total\n            return C[n_val]\n\n        def is_cached(self, n_val: int) -> bool:\n            \"\"\"Checks if a Catalan number for n_val is present in the cache.\"\"\"\n            return self._cache.get(n_val) is not None\n\n    validator = InputValidator(max_n=max_n)\n    n_valid = validator.validate_n(n)\n    cache = CacheRepository(path=cache_path)\n    calc = CatalanCalculator(max_n=max_n, cache_repo=cache)\n    return calc.compute(n_valid)"}
{"task_id": "Mbpp/585", "solution": "import heapq\nfrom dataclasses import dataclass\nfrom typing import Any, List, Dict\nclass DatasetRepository:\n    \"\"\"Manages conversion between raw item dictionaries and Item domain objects.\"\"\"\n    def normalize(self, items: List[Dict]) -> List[Item]:\n        \"\"\"Converts a list of dicts to a list of Item objects, assigning original indices.\"\"\"\n        normalized_items = []\n        for i, item_dict in enumerate(items):\n            price = float(item_dict['price']) # Already validated by validate_items_schema\n            normalized_items.append(Item(name=item_dict['name'], price=price, index=i))\n        return normalized_items\n\n    def to_dicts(self, items: List[Item]) -> List[Dict]:\n        \"\"\"Converts a list of Item objects back to a list of dictionaries.\"\"\"\n        return [item.to_dict() for item in items]\nclass ExpensiveItemService:\n    \"\"\"Implements the core logic for finding the top N most expensive items.\"\"\"\n    def __init__(self, repo: DatasetRepository):\n        self._repo = repo\n\n    def _compute_top_n(self, items: List[Item], n: int) -> List[Item]:\n        \"\"\"Uses heapq.nlargest for efficient retrieval of top N items with stable tie-breaking.\"\"\"\n        if n == 0:\n            return []\n        if n >= len(items):\n            return sorted(items, key=lambda it: (it.price, -it.index), reverse=True)\n        # Use a tuple for the key: price (desc), then -index (asc, for stable tie-breaking)\n        return heapq.nlargest(n, items, key=lambda it: (it.price, -it.index))\n\n    def find_top_n(self, normalized_items: List[Item], n: int) -> List[Dict]:\n        \"\"\"Orchestrates the computation and conversion of top N items.\"\"\"\n        top_n_items = self._compute_top_n(normalized_items, n)\n        return self._repo.to_dicts(top_n_items)\nclass APIController:\n    \"\"\"Provides the public API interface, coordinating validation, service, and repository.\"\"\"\n    def __init__(self, service: ExpensiveItemService, repo: DatasetRepository):\n        self._service = service\n        self._repo = repo\n\n    def find_expensive_items(self, items: List[Dict], n: int) -> List[Dict]:\n        \"\"\"Validates input, normalizes items, and retrieves the n most expensive items.\"\"\"\n        validate_items_schema(items)\n        validate_n(n)\n        normalized_items = self._repo.normalize(items)\n        return self._service.find_top_n(normalized_items, n)\ndef expensive_items(items: list[dict], n: int) -> list[dict]:\n    \"\"\"\n    Finds the n most expensive items in a given dataset.\n    Items are sorted by price descending, then by original index for stability.\n    \"\"\"\n    _repo = DatasetRepository()\n    _service = ExpensiveItemService(_repo)\n    _controller = APIController(_service, _repo)\n\n    return _controller.find_expensive_items(items, n)"}
