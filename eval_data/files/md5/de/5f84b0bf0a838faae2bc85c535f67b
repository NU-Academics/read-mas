{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"Reverses only the vowels of a given string (where y is not a vowel).\"\"\"\n    VOWELS = set(\"aeiouAEIOU\")\n    \n    chars = list(s)\n    i, j = 0, len(chars) - 1\n    \n    while i < j:\n        if chars[i] not in VOWELS:\n            i += 1\n            continue\n        \n        if chars[j] not in VOWELS:\n            j -= 1\n            continue\n            \n        # Both chars[i] and chars[j] are vowels, swap them\n        chars[i], chars[j] = chars[j], chars[i]\n        i += 1\n        j -= 1\n        \n    return \"\".join(chars)"}
{"task_id": "Mbpp/130", "solution": "from typing import Sequence, Any, List\nfrom collections import Counter\nclass MaxFreqError(Exception):\n    \"\"\"Base exception for maximum frequency operations.\"\"\"\n    pass\nclass EmptyListError(MaxFreqError):\n    \"\"\"Raised when the input list is empty.\"\"\"\n    def __init__(self, message: str = \"Input list is empty\") -> None:\n        super().__init__(message)\nclass InvalidInputError(MaxFreqError):\n    \"\"\"Raised when the input is not a valid iterable or list.\"\"\"\n    def __init__(self, message: str = \"Invalid input: expected iterable/list\") -> None:\n        super().__init__(message)\nclass FrequencyResult:\n    \"\"\"Data transfer object for the frequency service result.\"\"\"\n    def __init__(self, result: Any, count: int) -> None:\n        self.result = result\n        self.count = count\nclass ListRepository:\n    \"\"\"Provides access to items, returning a concrete list.\"\"\"\n    def get_items(self, items: Sequence[Any]) -> List[Any]:\n        return list(items)\nclass Validator:\n    \"\"\"Utility for validating input lists.\"\"\"\n    @staticmethod\n    def validate_items(items: Any) -> Sequence[Any]:\n        if items is None:\n            raise InvalidInputError(\"Input is None\")\n        try:\n            seq = list(items)\n        except TypeError:\n            raise InvalidInputError(\"Provided input is not iterable\")\n        if len(seq) == 0:\n            raise EmptyListError()\n        return seq\nclass FrequencyService:\n    \"\"\"Core logic to determine the most frequent item with tie-breaking.\"\"\"\n    def __init__(self, repository: 'ListRepository') -> None:\n        self._repository = repository\n\n    def get_max_item(self, items: Sequence[Any]) -> 'FrequencyResult':\n        items_list = self._repository.get_items(items)\n\n        try:\n            counts = Counter(items_list)\n            # Validator should have ensured non-empty, but defensive check\n            if not counts:\n                raise MaxFreqError(\"Empty list provided to service (unexpected state)\")\n\n            max_count = max(counts.values())\n\n            # Apply tie-breaker: return the item whose first occurrence is earliest\n            for item in items_list:\n                if counts[item] == max_count:\n                    return FrequencyResult(item, max_count)\n        except TypeError:\n            # Fallback for unhashable items by manual iteration\n            uniques: List[Any] = []\n            item_counts: List[int] = []\n\n            for x in items_list:\n                found = False\n                for i, u in enumerate(uniques):\n                    if u == x: # Use equality comparison for unhashable types\n                        item_counts[i] += 1\n                        found = True\n                        break\n                if not found:\n                    uniques.append(x)\n                    item_counts.append(1)\n            \n            # Validator should have ensured non-empty\n            if not uniques:\n                 raise MaxFreqError(\"Could not determine max occurrence for empty or problematic list (unexpected state)\")\n\n            max_count = max(item_counts)\n\n            # Apply tie-breaker for unhashable: first occurrence among uniques\n            for u, c in zip(uniques, item_counts):\n                if c == max_count:\n                    return FrequencyResult(u, c)\n        \n        # This line should ideally not be reached under normal conditions\n        raise MaxFreqError(\"Could not determine max occurrence (unexpected logic path)\")\nclass CLIController:\n    \"\"\"Controller for processing requests and coordinating service calls.\"\"\"\n    def __init__(self, service: 'FrequencyService') -> None:\n        self._service = service\n\n    def max_occurrences(self, items_input: Any) -> 'FrequencyResult':\n        validated = Validator.validate_items(items_input)\n        return self._service.get_max_item(validated)\ndef max_occurrences(items: Sequence[Any]) -> Any:\n    \"\"\"\n    Finds the item with maximum frequency in a given list.\n    Handles tie-breaking by returning the item with the earliest first occurrence.\n    \"\"\"\n    repo = ListRepository()\n    service = FrequencyService(repo)\n    controller = CLIController(service)\n    return controller.max_occurrences(items).result"}
