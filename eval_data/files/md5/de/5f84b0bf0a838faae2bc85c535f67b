{"task_id": "Mbpp/758", "solution": "import collections\nfrom typing import List, Any, Tuple, Dict, Optional\nclass InvalidInputError(Exception):\n    \"\"\"Raised when the input list or its sub-elements are invalid.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass ConversionError(Exception):\n    \"\"\"Raised when an item cannot be converted to a hashable type.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass ListConverter:\n    \"\"\"Helper for converting nested lists to tuples for hashing.\"\"\"\n    def convert_to_tuple(self, item: Any) -> Any:\n        \"\"\"Recursively converts lists to tuples, leaving primitives intact.\"\"\"\n        if isinstance(item, list):\n            return tuple(self.convert_to_tuple(sub) for sub in item)\n        return item\n\n    def to_tuple_sublist(self, sublist: List[Any]) -> Tuple[Any, ...]:\n        \"\"\"Converts a top-level sublist to a tuple, handling potential conversion errors.\"\"\"\n        try:\n            converted = self.convert_to_tuple(sublist)\n            if not isinstance(converted, tuple):\n                raise ConversionError(f\"Expected a list to convert to tuple, but resulted in {type(converted)}\")\n            return converted\n        except TypeError as e:\n            raise ConversionError(f\"Failed to convert sublist to hashable tuple: {e}\")\n        except Exception as e:\n            raise ConversionError(f\"An unexpected error occurred during sublist conversion: {e}\")\nclass Validator:\n    \"\"\"Helper for validating input lists and sublists.\"\"\"\n    def validate_top_level_list(self, lst: Any, max_items: Optional[int] = None) -> None:\n        \"\"\"Validates the top-level input to ensure it's a list and respects max_items.\"\"\"\n        if not isinstance(lst, list):\n            raise InvalidInputError(f\"Input must be a list, but got {type(lst)}\")\n        if max_items is not None and len(lst) > max_items:\n            raise InvalidInputError(f\"Input list exceeds maximum allowed items of {max_items}\")\n\n    def validate_sublist(self, item: Any) -> None:\n        \"\"\"Validates a sub-item to ensure it's a list-like container.\"\"\"\n        if not isinstance(item, list):\n            raise InvalidInputError(f\"Sub-item must be a list, but got {type(item)}\")\nclass UniqueSublistService:\n    \"\"\"Core service for counting unique sublists.\"\"\"\n    def __init__(self, converter: ListConverter, validator: Validator) -> None:\n        self._converter = converter\n        self._validator = validator\n\n    def count_sublists(self, lst: List[List[Any]], max_items: Optional[int] = None) -> Dict[Tuple[Any, ...], int]:\n        \"\"\"Counts occurrences of sublists in a list, converting them to tuples.\"\"\"\n        self._validator.validate_top_level_list(lst, max_items)\n        counts = collections.Counter()\n        for item in lst:\n            self._validator.validate_sublist(item)\n            try:\n                key = self._converter.to_tuple_sublist(item)\n            except ConversionError:\n                raise\n            counts[key] += 1\n        return dict(counts)\ndef unique_sublists(lst: List[List[Any]]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"Counts unique sublists in a list, returning counts with tuple keys.\"\"\"\n    converter = ListConverter()\n    validator = Validator()\n    service = UniqueSublistService(converter, validator)\n    return service.count_sublists(lst)"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(arr, n):\n    \"\"\"\n    Finds the minimum difference between any two elements in the given array.\n    The algorithm sorts the array and then iterates through adjacent elements.\n    \"\"\"\n    if len(arr) < 2:\n        return None # Or raise an error, but instructions say not to. Based on assert, input will be valid.\n\n    sorted_arr = sorted(arr)\n    min_diff = float('inf')\n\n    for i in range(len(sorted_arr) - 1):\n        diff = abs(sorted_arr[i+1] - sorted_arr[i])\n        if diff < min_diff:\n            min_diff = diff\n            \n    return min_diff"}
