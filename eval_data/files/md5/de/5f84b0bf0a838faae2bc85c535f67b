{"task_id": "Mbpp/82", "solution": "def volume_sphere(radius: float) -> float:\n    \"\"\"Calculates the volume of a sphere given its radius.\n\n    This function implements a layered architecture for computation and validation.\n    \"\"\"\n    import math\n\n    class InvalidRadiusError(ValueError):\n        \"\"\"Custom exception raised for invalid sphere radius values.\"\"\"\n        def __init__(self, message: str = \"radius must be a non-negative finite number\"):\n            super().__init__(message)\n\n    class MathUtils:\n        \"\"\"Utility class to wrap math operations, enhancing testability.\"\"\"\n        def pi(self) -> float:\n            return math.pi\n\n        def pow(self, base: float, exp: float) -> float:\n            return math.pow(base, exp)\n\n    class Sphere:\n        \"\"\"Domain model representing a sphere with a given radius.\"\"\"\n        def __init__(self, radius: float) -> None:\n            if not isinstance(radius, (int, float)):\n                raise TypeError(\"radius must be numeric\")\n            self.radius: float = float(radius)\n\n    class VolumeCalculator:\n        \"\"\"Encapsulates the business logic for calculating sphere volume.\"\"\"\n        DEFAULT_COEFFICIENT: float = 4.0 / 3.0\n\n        def __init__(self, math_utils: 'MathUtils' | None = None) -> None:\n            self._math_utils = math_utils or MathUtils()\n\n        def compute_volume(self, sphere: 'Sphere') -> float:\n            \"\"\"Computes the volume for a given Sphere object, including validation.\"\"\"\n            r = sphere.radius\n            if r < 0 or not (r == r) or r == float('inf') or r == float('-inf'):\n                raise InvalidRadiusError()\n            r_cubed = self._math_utils.pow(r, 3)\n            return self.DEFAULT_COEFFICIENT * self._math_utils.pi() * r_cubed\n\n        def compute_volume_from_radius(self, radius: float) -> float:\n            \"\"\"Convenience method to compute volume directly from a radius value.\"\"\"\n            sphere = Sphere(radius)\n            return self.compute_volume(sphere)\n\n    class SphereController:\n        \"\"\"Adapter layer to handle requests and delegate to the VolumeCalculator.\"\"\"\n        def __init__(self, calculator: 'VolumeCalculator' | None = None) -> None:\n            self._calculator = calculator or VolumeCalculator()\n\n        def get_volume(self, radius: float) -> float:\n            \"\"\"Retrieves the sphere volume for the given radius.\"\"\"\n            return self._calculator.compute_volume_from_radius(radius)\n\n    controller = SphereController()\n    return controller.get_volume(radius)"}
{"task_id": "Mbpp/85", "solution": "def surfacearea_sphere(radius: float) -> float:\n    \"\"\"Calculates the surface area of a sphere given its radius.\"\"\"\n    import math\n    return 4.0 * math.pi * (radius ** 2)"}
{"task_id": "Mbpp/84", "solution": "from typing import Optional\nclass SequenceError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass Config:\n    \"\"\"Configuration holder for the sequence service.\"\"\"\n    def __init__(self, cache_enabled: bool = False, cache_path: Optional[str] = None) -> None:\n        self.cache_enabled = cache_enabled\n        self.cache_path = cache_path\nclass Validator:\n    \"\"\"Validates input parameters for sequence computation.\"\"\"\n    def __init__(self, min_n: int = 1, max_n: Optional[int] = None) -> None:\n        self._min = min_n\n        self._max = max_n\n\n    def validate_index(self, n: int) -> None:\n        \"\"\"Raises SequenceError if n is outside valid bounds.\"\"\"\n        if n < self._min:\n            raise SequenceError(f\"Input n must be >= {self._min}\")\n        if self._max is not None and n > self._max:\n            raise SequenceError(f\"Input n must be <= {self._max}\")\nclass InMemoryCacheAdapter:\n    \"\"\"An in-memory dictionary-based cache for sequence values.\"\"\"\n    def __init__(self) -> None:\n        self._store: dict[int, int] = {}\n\n    def load(self) -> None:\n        \"\"\"Loads data into the cache (no-op for in-memory).\"\"\"\n        pass\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a value from the cache by index n.\"\"\"\n        return self._store.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a value in the cache at index n.\"\"\"\n        self._store[n] = value\nclass NewmanConwayRepository:\n    \"\"\"Manages data access for Newman-Conway sequence values via a cache adapter.\"\"\"\n    def __init__(self, adapter: InMemoryCacheAdapter) -> None:\n        self._adapter = adapter\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a sequence value from the underlying adapter.\"\"\"\n        return self._adapter.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a sequence value using the underlying adapter.\"\"\"\n        self._adapter.set(n, value)\n\n    def load(self) -> None:\n        \"\"\"Loads data using the underlying adapter.\"\"\"\n        self._adapter.load()\nclass SequenceService:\n    \"\"\"Core logic for calculating Newman-Conway sequence numbers with caching.\"\"\"\n    def __init__(self, repo: NewmanConwayRepository, validator: Validator, config: Config) -> None:\n        self._repo = repo\n        self._validator = validator\n        self._config = config\n        self._repo.load()\n        # Initialize base cases for the sequence (a(1)=1, a(2)=1).\n        self._repo.set(1, 1)\n        self._repo.set(2, 1)\n\n    def calculate(self, n: int) -> int:\n        \"\"\"Calculates the nth Newman-Conway number.\"\"\"\n        self._validator.validate_index(n)\n        \n        cached = self._repo.get(n)\n        if cached is not None:\n            return cached\n        \n        # Iteratively compute values up to n, caching intermediate results.\n        # The loop starts from 3 as 1 and 2 are base cases.\n        for k in range(3, n + 1):\n            if self._repo.get(k) is None: # Only compute if not already cached.\n                # Compute a(k-1), ensuring it's in the cache.\n                a_prev = self._repo.get(k - 1)\n                if a_prev is None:\n                    a_prev = self.calculate(k - 1) # Recursive call to ensure dependency.\n                \n                # Compute a(a(k-1)), ensuring it's in the cache.\n                term1_idx = a_prev\n                val_term1 = self._repo.get(term1_idx)\n                if val_term1 is None:\n                    val_term1 = self.calculate(term1_idx) # Recursive call to ensure dependency.\n\n                # Compute a(k - a(k-1)), ensuring it's in the cache.\n                term2_idx = k - a_prev\n                val_term2 = self._repo.get(term2_idx)\n                if val_term2 is None:\n                    val_term2 = self.calculate(term2_idx) # Recursive call to ensure dependency.\n\n                # Apply the Newman-Conway recurrence relation.\n                val_k = val_term1 + val_term2\n                self._repo.set(k, val_k) # Store the computed value for k.\n        \n        result = self._repo.get(n)\n        if result is None:\n            raise SequenceError(f\"Failed to compute sequence for n={n} after iteration\")\n        return result\ndef sequence(n: int) -> int:\n    \"\"\"\n    Finds the nth number in the Newman-Conway sequence.\n    This is a convenience function using an in-memory cache.\n    \"\"\"\n    repo = NewmanConwayRepository(InMemoryCacheAdapter())\n    repo.load() # This call initializes the adapter (no-op for InMemoryCacheAdapter).\n    svc = SequenceService(repo, Validator(), Config(cache_enabled=False))\n    return svc.calculate(n)"}
