{"task_id": "Mbpp/603", "solution": "import os\nimport json\nimport tempfile\nfrom typing import Any\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input.\"\"\"\n    pass\nclass RepoError(Exception):\n    \"\"\"Exception raised for repository (data access) errors.\"\"\"\n    pass\nclass InputValidator:\n    \"\"\"Validates and normalizes input values.\"\"\"\n    def validate_n(self, n: Any) -> int:\n        \"\"\"Validates that n is an integer >= 1.\"\"\"\n        if isinstance(n, str):\n            if n.isdigit():\n                n = int(n)\n            else:\n                raise ValidationError(f\"Input must be an integer, got '{n}'.\")\n        if isinstance(n, float):\n            if n.is_integer():\n                n = int(n)\n            else:\n                raise ValidationError(f\"Input must be an integer, got '{n}'.\")\n        if not isinstance(n, int):\n            raise ValidationError(f\"Input must be an integer, got '{type(n).__name__}'.\")\n        if n < 1:\n            raise ValidationError(f\"Input must be an integer greater than or equal to 1, got {n}.\")\n        return n\nclass LudicSieve:\n    \"\"\"Implements the Ludic sieve algorithm to compute ludic numbers.\"\"\"\n    def compute_up_to(self, n: int) -> list[int]:\n        \"\"\"Computes ludic numbers up to n using the sieve method.\"\"\"\n        if n < 1:\n            return []\n        \n        # Start with a list of integers from 1 up to n\n        numbers = list(range(1, n + 1))\n        \n        # 'idx' points to the current ludic number that determines the step for removal.\n        # It starts at 1, so numbers[1] is 2, the second ludic number.\n        idx = 1 \n        \n        while idx < len(numbers):\n            step = numbers[idx] # The current ludic number is the step value\n            if step == 0: # Should not happen with positive integers\n                break\n            \n            # Create a new list, skipping elements based on the 'step'\n            new_numbers = []\n            for i, v in enumerate(numbers):\n                if i <= idx:\n                    # Keep elements up to and including the current ludic number\n                    new_numbers.append(v)\n                else:\n                    # For elements after the current ludic number, remove every 'step'-th element\n                    # 'pos_after' is the 1-based position relative to the elements *after* the current ludic number\n                    pos_after = i - idx\n                    if pos_after % step != 0:\n                        new_numbers.append(v)\n            numbers = new_numbers\n            \n            idx += 1 # Move to the next potential ludic number in the updated list\n            \n            # Stop if the index goes out of bounds or the next ludic number exceeds n\n            if idx >= len(numbers) or numbers[idx] > n:\n                break\n        \n        return numbers\nclass LudicRepository:\n    \"\"\"Handles persistence of ludic numbers to a JSON cache file.\"\"\"\n    def __init__(self, cache_path: str):\n        self.cache_path = cache_path\n\n    def load_cache(self) -> dict | None:\n        \"\"\"Loads cached ludic numbers from the JSON file.\"\"\"\n        if not os.path.exists(self.cache_path):\n            return None\n        try:\n            with open(self.cache_path, 'r', encoding='utf-8') as f:\n                return json.load(f)\n        except (json.JSONDecodeError, FileNotFoundError, IOError) as e:\n            # Log the error, but continue without cache\n            raise RepoError(f\"Failed to load cache from {self.cache_path}: {e}\")\n\n    def save_cache(self, max_computed: int, results: list[int]) -> None:\n        \"\"\"Saves ludic numbers to the JSON cache file atomically.\"\"\"\n        cache_dir = os.path.dirname(self.cache_path)\n        if cache_dir:\n            os.makedirs(cache_dir, exist_ok=True)\n            \n        data = {\"max_computed\": max_computed, \"results\": results}\n        \n        # Use a temporary file for atomic write\n        fd, temp_path = tempfile.mkstemp(dir=cache_dir, prefix=\"ludic_cache_\", suffix=\".json\")\n        try:\n            with os.fdopen(fd, 'w', encoding='utf-8') as temp_f:\n                json.dump(data, temp_f)\n            os.replace(temp_path, self.cache_path) # Atomic replacement\n        except IOError as e:\n            os.remove(temp_path) # Clean up temp file on error\n            raise RepoError(f\"Failed to save cache to {self.cache_path}: {e}\")\n        except Exception:\n            os.remove(temp_path) # Clean up temp file on any other error\n            raise # Re-raise other exceptions\n\n    def clear_cache(self) -> None:\n        \"\"\"Deletes the cache file.\"\"\"\n        if os.path.exists(self.cache_path):\n            try:\n                os.remove(self.cache_path)\n            except IOError as e:\n                raise RepoError(f\"Failed to clear cache file {self.cache_path}: {e}\")\nclass LudicService:\n    \"\"\"Orchestrates validation, caching, and computation of ludic numbers.\"\"\"\n    def __init__(self, validator: InputValidator, repo: LudicRepository, sieve: LudicSieve):\n        self.validator = validator\n        self.repo = repo\n        self.sieve = sieve\n\n    def get_ludic(self, n: int) -> list[int]:\n        \"\"\"Gets all ludic numbers up to a given integer, using cache if available.\"\"\"\n        n = self.validator.validate_n(n) # Validate input first\n\n        cached_data = None\n        try:\n            cached_data = self.repo.load_cache()\n        except RepoError:\n            pass # Continue without cache if loading fails\n\n        if cached_data and cached_data.get(\"max_computed\", 0) >= n:\n            # Cache hit: return a subset of cached results\n            return [x for x in cached_data[\"results\"] if x <= n]\n        \n        # Cache miss or insufficient cache: compute new results\n        results = self.sieve.compute_up_to(n)\n        \n        try:\n            # Attempt to save the newly computed results to cache\n            self.repo.save_cache(max_computed=n, results=results)\n        except RepoError:\n            pass # Log error but do not fail the request if saving fails\n\n        return results\ndef get_ludic(n: int) -> list[int]:\n    \"\"\"\n    Returns all ludic numbers smaller than or equal to a given integer.\n    The function initializes necessary components for validation, caching, and computation.\n    \"\"\"\n    # Instantiate dependencies directly as per the design context for this specific function.\n    validator = InputValidator()\n    # Hardcoded cache path as specified in the design for this convenience function.\n    repository = LudicRepository(\"src/ludic/cache/ludic_cache.json\")\n    sieve = LudicSieve()\n    \n    service = LudicService(validator, repository, sieve)\n    return service.get_ludic(n)"}
