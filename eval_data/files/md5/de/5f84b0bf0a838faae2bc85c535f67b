{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(s: str) -> int:\n    \"\"\"\n    Finds the maximum consecutive run of ASCII uppercase characters in the given string.\n    Non-uppercase characters break the run.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in s:\n        # Check if the character is an ASCII uppercase letter\n        if 'A' <= char <= 'Z':\n            current_run += 1\n            if current_run > max_run:\n                max_run = current_run\n        else:\n            current_run = 0\n    return max_run"}
{"task_id": "Mbpp/805", "solution": "import numbers\nfrom typing import List\ndef max_sum_list(lists: List[List[numbers.Number]]) -> List[numbers.Number]:\n    \"\"\"\n    Returns the sublist from a list of lists whose sum of elements is the highest.\n    Applies tie-breaking by returning the first encountered sublist with the maximum sum.\n    \"\"\"\n    if not lists:\n        return []\n\n    # Initialize with the first sublist and its sum.\n    highest_sum_list = lists[0]\n    max_found_sum = sum(highest_sum_list)\n\n    # Iterate through the rest of the sublists to find the one with the highest sum.\n    for sublist in lists[1:]:\n        current_sum = sum(sublist)\n        if current_sum > max_found_sum:\n            max_found_sum = current_sum\n            highest_sum_list = sublist\n    \n    return highest_sum_list"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(a: tuple, b: tuple) -> bool:\n    \"\"\"\n    Checks if each element of the second tuple is smaller than its corresponding\n    element in the first tuple.\n    \"\"\"\n    for first_element, second_element in zip(a, b):\n        if not (second_element < first_element):\n            return False\n    return True"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers):\n    \"\"\"\n    Finds the first odd number in a list of numbers.\n    Assumes input is a list of integers.\n    \"\"\"\n    for n in numbers:\n        if (n & 1) == 1:  # Check if the number is odd using bitwise AND\n            return n\n    return None"}
