{"task_id": "Mbpp/251", "solution": "def insert_element(items, element):\n    \"\"\"\n    Inserts an element before each item in a list and returns the new list.\n    The order of the original items is preserved.\n    \"\"\"\n    n = len(items)\n    if n == 0:\n        return []\n\n    result = [None] * (2 * n)\n    j = 0\n    for item in items:\n        result[j] = element\n        j += 1\n        result[j] = item\n        j += 1\n    return result"}
{"task_id": "Mbpp/252", "solution": "import math\nclass ConversionError(Exception):\n    \"\"\"Custom exception for conversion-related errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass InputValidator:\n    \"\"\"Validates and coerces inputs to complex numbers.\"\"\"\n    def to_complex(self, value: object) -> complex:\n        try:\n            z = complex(value)\n        except (ValueError, TypeError) as e:\n            raise ConversionError(f\"Invalid input type or format: {value}. Must be numeric or parsable string.\") from e\n\n        if math.isinf(z.real) or math.isinf(z.imag) or math.isnan(z.real) or math.isnan(z.imag):\n            raise ConversionError(f\"Complex number components cannot be NaN or infinite: {z}\")\n        return z\nclass AngleNormalizer:\n    \"\"\"Normalizes angles to the range (-pi, pi].\"\"\"\n    def normalize(self, angle: float) -> float:\n        two_pi = 2.0 * math.pi\n        normalized_angle = math.fmod(angle, two_pi)\n        if normalized_angle > math.pi:\n            normalized_angle -= two_pi\n        elif normalized_angle <= -math.pi:\n            normalized_angle += two_pi\n        return normalized_angle\nclass ComplexNumber:\n    \"\"\"Represents a complex number with real and imaginary components.\"\"\"\n    def __init__(self, real: float, imag: float) -> None:\n        self._real = float(real)\n        self._imag = float(imag)\n\n    @property\n    def real(self) -> float:\n        return self._real\n\n    @property\n    def imag(self) -> float:\n        return self._imag\nclass PolarCoordinate:\n    \"\"\"Represents polar coordinates (radius, angle).\"\"\"\n    def __init__(self, r: float, theta: float) -> None:\n        if r < 0:\n            raise ValueError(\"Radius (r) cannot be negative.\")\n        self._r = float(r)\n        self._theta = float(theta)\n\n    @property\n    def r(self) -> float:\n        return self._r\n\n    @property\n    def theta(self) -> float:\n        return self._theta\n\n    def to_tuple(self) -> tuple[float, float]:\n        return (self._r, self._theta)\nclass ConversionService:\n    \"\"\"Provides conversion from complex numbers to polar coordinates.\"\"\"\n    def __init__(self, validator: InputValidator=None, normalizer: AngleNormalizer=None) -> None:\n        self._validator = validator or InputValidator()\n        self._normalizer = normalizer or AngleNormalizer()\n\n    def convert(self, value: object) -> tuple[float, float]:\n        z = self._validator.to_complex(value)\n        c = ComplexNumber(z.real, z.imag)\n        return self._compute(c).to_tuple()\n\n    def _compute(self, cplx: ComplexNumber) -> PolarCoordinate:\n        r = math.hypot(cplx.real, cplx.imag)\n        theta = math.atan2(cplx.imag, cplx.real)\n        theta = self._normalizer.normalize(theta)\n        return PolarCoordinate(r, theta)\n_service = ConversionService()\ndef convert(value: object) -> tuple[float, float]:\n    \"\"\"\n    Converts a complex number to its polar coordinates (radius, angle).\n    The angle is in radians and normalized to (-pi, pi].\n    \"\"\"\n    return _service.convert(value)"}
{"task_id": "Mbpp/245", "solution": "from typing import List\ndef max_sum(arr: List[int]) -> int:\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence in the given array.\n    A bitonic subsequence is first strictly increasing and then strictly decreasing.\n    \"\"\"\n    if not arr:\n        return 0\n\n    n = len(arr)\n\n    def _msis(values: List[int]) -> List[int]:\n        \"\"\"\n        Computes the maximum sum increasing subsequence ending at each index.\n        msis[i] stores the max sum of an increasing subsequence ending with values[i].\n        \"\"\"\n        m = len(values)\n        msis_local = values[:]  # Initialize with individual element sums.\n        for i in range(m):\n            for j in range(i):\n                if values[j] < values[i]:\n                    msis_local[i] = max(msis_local[i], msis_local[j] + values[i])\n        return msis_local\n\n    def _msds(values: List[int]) -> List[int]:\n        \"\"\"\n        Computes the maximum sum decreasing subsequence starting at each index.\n        This is done by finding MSIS on the reversed array and then reversing the result.\n        \"\"\"\n        rev_values = values[::-1]\n        rev_msis_local = _msis(rev_values)\n        return rev_msis_local[::-1]\n\n    msis_sums = _msis(arr)\n    msds_sums = _msds(arr)\n\n    # The maximum sum bitonic subsequence is found by considering each element arr[i] as the peak.\n    # The sum is (max sum increasing ending at arr[i]) + (max sum decreasing starting at arr[i]) - arr[i],\n    # where arr[i] is subtracted because it's counted in both parts.\n    return max(msis_sums[i] + msds_sums[i] - arr[i] for i in range(n))"}
