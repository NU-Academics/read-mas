{"task_id": "Mbpp/281", "solution": "def all_unique(items, key=None, allow_unhashable=True):\n    \"\"\"\n    Checks if all elements in an iterable are unique, optionally using a key function.\n    Handles unhashable items by falling back to O(N^2) comparison if allowed.\n    \"\"\"\n    if key is None:\n        key_fn = lambda x: x\n    else:\n        # Assuming key is callable based on constraints.\n        key_fn = key\n\n    seen_hashable = set()\n    seen_unhashable = [] # Stores processed items for O(N^2) comparison\n\n    for item in items:\n        processed_item = key_fn(item)\n\n        try:\n            # Attempt to use the hashable path first (O(N) average)\n            if processed_item in seen_hashable:\n                return False # Duplicate found among hashable items\n            seen_hashable.add(processed_item)\n        except TypeError:\n            # processed_item is unhashable\n            if not allow_unhashable:\n                # Unhashable item found, but not allowed.\n                # Per constraint \"Do NOT raise exceptions for edge cases\",\n                # returning False to indicate a failure to meet uniqueness criteria.\n                return False\n\n            # Fallback to O(N^2) comparison for unhashable items if allowed\n            for existing_processed_item in seen_unhashable:\n                if processed_item == existing_processed_item:\n                    return False # Duplicate found among unhashable items\n            seen_unhashable.append(processed_item)\n\n    return True # No duplicates found"}
{"task_id": "Mbpp/282", "solution": "from typing import List, Any, Union\nNumber = Union[int, float]\nclass ListOpsError(Exception):\n    def __init__(self, message: str, error_code: str = \"listops.error\") -> None:\n        super().__init__(message)\n        self.message = message\n        self.error_code = error_code\nclass InvalidInputError(ListOpsError):\n    def __init__(self, message: str = \"Invalid input\", error_code: str = \"listops.invalid_input\") -> None:\n        super().__init__(message, error_code)\nclass LengthMismatchError(ListOpsError):\n    def __init__(self, message: str = \"List lengths differ\", error_code: str = \"listops.length_mismatch\") -> None:\n        super().__init__(message, error_code)\nclass ListValidator:\n    def is_numeric(self, value: Any) -> bool:\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    def validate_list(self, obj: Any, name: str = \"list\") -> None:\n        if not isinstance(obj, list):\n            raise InvalidInputError(f\"{name} must be a list.\")\n        for i, v in enumerate(obj):\n            if not self.is_numeric(v):\n                raise InvalidInputError(f\"{name}[{i}] is not numeric: {v!r}\")\n\n    def ensure_lists(self, a: Any, b: Any, require_equal_length: bool = True) -> None:\n        self.validate_list(a, \"a\")\n        self.validate_list(b, \"b\")\n        if require_equal_length and len(a) != len(b):\n            raise LengthMismatchError(f\"Lengths differ: len(a)={len(a)} len(b)={len(b)}\")\nclass ListMathService:\n    def __init__(self, validator: 'ListValidator' = None) -> None:\n        self.validator = validator or ListValidator()\n\n    def sub_list(self, a: List[Number], b: List[Number]) -> List[Number]:\n        self.validator.ensure_lists(a, b, require_equal_length=True)\n        return [self._element_sub(x, y) for x, y in zip(a, b)]\n\n    def _element_sub(self, a_val: Number, b_val: Number) -> Number:\n        return a_val - b_val\ndef sub_list(a: List[Number], b: List[Number]) -> List[Number]:\n    \"\"\"Subtracts two lists element-wise, returning a new list with the results.\"\"\"\n    validator = ListValidator()\n    service = ListMathService(validator=validator)\n    return service.sub_list(a, b)"}
{"task_id": "Mbpp/283", "solution": "def validate(number: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in the integer is less than or equal to the digit itself.\n    The absolute value of the number is used for validation.\n    \"\"\"\n    abs_number = abs(number)\n    \n    counts = {}\n    if abs_number == 0:\n        counts[0] = 1\n    else:\n        temp_num = abs_number\n        while temp_num > 0:\n            d = temp_num % 10\n            counts[d] = counts.get(d, 0) + 1\n            temp_num //= 10\n            \n    for digit, count in counts.items():\n        if count > digit:\n            return False\n            \n    return True"}
