{"task_id": "Mbpp/93", "solution": "def power(a, b):\n    \"\"\"\n    Calculates 'a' to the power 'b'.\n    Uses efficient exponentiation by squaring for integer exponents.\n    \"\"\"\n    \n    # Tolerance for checking if a float is effectively an integer.\n    _BASE_TOLERANCE = 1e-12\n\n    def _is_integer_value(x_val):\n        \"\"\"Checks if a float value is within tolerance of an integer.\"\"\"\n        return abs(x_val - round(x_val)) < _BASE_TOLERANCE\n\n    def _fast_pow_positive_int(base, exp_val):\n        \"\"\"\n        Computes base^exp_val using exponentiation by squaring,\n        where exp_val is a non-negative integer.\n        \"\"\"\n        res = 1.0\n        current_base = float(base)\n        current_exp = int(exp_val)\n        while current_exp > 0:\n            if current_exp % 2 == 1:\n                res *= current_base\n            current_base *= current_base\n            current_exp //= 2\n        return res\n\n    # Determine if the exponent 'b' should be treated as an integer\n    # This includes actual integers and float values that are integer-like (e.g., 4.0)\n    if isinstance(b, int) or (isinstance(b, float) and _is_integer_value(b)):\n        exp_int = int(round(b))\n        \n        if exp_int == 0:\n            # Special case: any_base^0 is 1.0\n            return 1.0\n        elif exp_int > 0:\n            return _fast_pow_positive_int(a, exp_int)\n        else: # exp_int < 0\n            # Handle negative integer exponents: a^(-n) = 1 / a^n\n            return 1.0 / _fast_pow_positive_int(a, -exp_int)\n    else:\n        # For non-integer float exponents, use Python's built-in power operator.\n        return a ** b"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(items):\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value.\n    Assumes `items` is a non-empty list of 2-item tuples with a comparable second element.\n    \"\"\"\n    min_tuple = min(items, key=lambda item: item[1])\n    return min_tuple[0]"}
{"task_id": "Mbpp/96", "solution": "import math\nfrom typing import Dict\ndef divisor(n: int) -> int:\n    \"\"\"Calculates the number of positive divisors for a given integer.\n    Handles negative numbers by taking their absolute value.\"\"\"\n\n    n_abs = abs(n)\n\n    # For n=1, there is only one divisor (1 itself).\n    if n_abs == 1:\n        return 1\n\n    # Compute prime factors and their exponents (inlined MathUtils.prime_factors logic).\n    factors: Dict[int, int] = {}\n    temp_n = n_abs\n    d = 2\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors[d] = factors.get(d, 0) + 1\n            temp_n //= d\n        d += 1 if d == 2 else 2  # Increment by 2 for odd divisors after checking 2\n    if temp_n > 1:  # If temp_n is still greater than 1, it is a prime factor itself\n        factors[temp_n] = factors.get(temp_n, 0) + 1\n\n    # Calculate the total number of divisors from prime factors (inlined DivisorService._count_from_factors logic).\n    count = 1\n    for exp in factors.values():\n        count *= (exp + 1)\n    return count"}
{"task_id": "Mbpp/95", "solution": "from typing import Any, List, Optional\nclass InvalidCollectionError(Exception):\n    \"\"\"Exception raised for invalid list collections.\"\"\"\n    def __init__(self, message: str, cause: Optional[Exception] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.cause = cause\nclass ListCollection:\n    \"\"\"Encapsulates a collection of lists and provides basic operations.\"\"\"\n    def __init__(self, lists: list):\n        self.lists = lists\n\n    def __iter__(self):\n        return iter(self.lists)\n\n    def __len__(self) -> int:\n        return len(self.lists)\n\n    def validate_inner_types(self):\n        \"\"\"Validates that all inner elements are list-like.\"\"\"\n        for i, inner in enumerate(self.lists):\n            if not isinstance(inner, (list, tuple)):\n                raise InvalidCollectionError(f\"Inner element at index {i} is not a list/tuple\")\nclass Validator:\n    \"\"\"Validates raw input and constructs a ListCollection.\"\"\"\n    def validate_collection_raw(self, raw: Any) -> ListCollection:\n        \"\"\"Ensures raw input is a valid non-empty list of lists.\"\"\"\n        if not isinstance(raw, (list, tuple)):\n            raise InvalidCollectionError(\"Top-level must be a list or tuple\")\n        if len(raw) == 0:\n            raise InvalidCollectionError(\"Collection must contain at least one inner list\")\n        collection = ListCollection(list(raw))\n        collection.validate_inner_types()\n        return collection\nclass MinLengthService:\n    \"\"\"Computes the minimum length of lists within a ListCollection.\"\"\"\n    def __init__(self, validator: Validator) -> None:\n        self.validator = validator\n\n    def find_min_length(self, collection: ListCollection) -> int:\n        \"\"\"Returns the length of the smallest inner list.\"\"\"\n        if len(collection) == 0:\n            raise InvalidCollectionError(\"Collection is empty\")\n        return min(len(inner) for inner in collection)\nclass MinLengthController:\n    \"\"\"Orchestrates validation and service calls to compute minimum length.\"\"\"\n    def __init__(self, service: MinLengthService, validator: Validator) -> None:\n        self.service = service\n        self.validator = validator\n\n    def compute_min_length(self, raw: Any) -> int:\n        \"\"\"Validates raw input and computes the minimum list length.\"\"\"\n        collection = self.validator.validate_collection_raw(raw)\n        return self.service.find_min_length(collection)\ndef Find_Min_Length(lists):\n    \"\"\"\n    Finds the length of the smallest list in a list of lists.\n    Raises InvalidCollectionError for invalid inputs.\n    \"\"\"\n    validator = Validator()\n    service = MinLengthService(validator=validator)\n    controller = MinLengthController(service=service, validator=validator)\n    return controller.compute_min_length(lists)"}
