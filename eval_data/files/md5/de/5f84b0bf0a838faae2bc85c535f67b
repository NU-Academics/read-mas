{"task_id": "Mbpp/222", "solution": "def check_type(t: tuple) -> bool:\n    \"\"\"\n    Checks if all elements in the tuple have the same data type.\n    An empty tuple is considered homogeneous.\n    \"\"\"\n    if not t:\n        return True\n    \n    first_type = type(t[0])\n    for item in t[1:]:\n        if type(item) is not first_type:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/223", "solution": "def is_majority(sorted_array: list, n: int, element: int) -> bool:\n    \"\"\"\n    Determines if an element is the majority element in a sorted array.\n    An element is a majority element if it occurs more than n/2 times.\n    \"\"\"\n\n    def get_first_occurrence(arr: list, target: int) -> Optional[int]:\n        \"\"\"Returns the index of the first occurrence of target in arr, or None if not found.\"\"\"\n        lo, hi = 0, len(arr) - 1\n        result = None\n        while lo <= hi:\n            mid = (lo + hi) // 2\n            if arr[mid] >= target:\n                if arr[mid] == target:\n                    result = mid\n                hi = mid - 1\n            else:\n                lo = mid + 1\n        return result\n\n    first_idx = get_first_occurrence(sorted_array, element)\n\n    if first_idx is None:\n        return False\n\n    # Calculate the index where the (n/2)-th occurrence *should* be if it were a majority.\n    # If the element at this index is still the target, then it is a majority element.\n    candidate_idx = first_idx + n // 2\n    return candidate_idx < n and sorted_array[candidate_idx] == element"}
