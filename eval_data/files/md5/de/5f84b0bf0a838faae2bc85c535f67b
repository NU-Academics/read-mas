{"task_id": "Mbpp/297", "solution": "import collections.abc\nfrom typing import Any, List, Tuple\ndef flatten_list(nested: Any) -> List[Any]:\n    \"\"\"\n    Flattens a nested list structure into a single flat list, preserving order.\n    Strings, bytes, and bytearrays are treated as atomic and not iterated.\n    \"\"\"\n    flattened: List[Any] = []\n    # Define atomic types explicitly to treat them as single elements, not iterables.\n    _atomic_types: Tuple[type, ...] = (str, bytes, bytearray)\n\n    # The stack will hold iterators. Initialize with an iterator over the input,\n    # wrapped in a list to handle cases where 'nested' itself is not a list/tuple.\n    stack = [iter([nested])]\n\n    while stack:\n        current_iter = stack[-1]\n        try:\n            item = next(current_iter)\n        except StopIteration:\n            # Current iterable is exhausted, remove it from the stack.\n            stack.pop()\n            continue\n\n        # If item is an iterable (list or tuple) and not one of the atomic types,\n        # push its iterator onto the stack to process its contents.\n        if isinstance(item, (list, tuple)) and not isinstance(item, _atomic_types):\n            stack.append(iter(item))\n        else:\n            # Otherwise, it's a scalar or an atomic iterable, so append it to the result.\n            flattened.append(item)\n\n    return flattened"}
{"task_id": "Mbpp/296", "solution": "from typing import List, Tuple, Optional\nclass MergeSortCounter:\n    \"\"\"Implements a merge sort algorithm to count inversions.\"\"\"\n    def count_and_sort(self, arr: List[int]) -> Tuple[List[int], int]:\n        \"\"\"Recursively sorts the array and counts inversions.\"\"\"\n        if len(arr) <= 1:\n            return list(arr), 0\n        mid = len(arr) // 2\n        left_sorted, left_count = self.count_and_sort(arr[:mid])\n        right_sorted, right_count = self.count_and_sort(arr[mid:])\n        merged, merge_count = self._merge_count(left_sorted, right_sorted)\n        return merged, left_count + right_count + merge_count\n\n    def _merge_count(self, left: List[int], right: List[int]) -> Tuple[List[int], int]:\n        \"\"\"Merges two sorted lists and counts cross inversions.\"\"\"\n        i = j = 0\n        merged = []\n        inv_count = 0\n        while i < len(left) and j < len(right):\n            if left[i] <= right[j]:\n                merged.append(left[i]); i += 1\n            else:\n                merged.append(right[j]); j += 1\n                inv_count += len(left) - i\n        merged.extend(left[i:])\n        merged.extend(right[j:])\n        return merged, inv_count\nclass InversionService:\n    \"\"\"Orchestrates inversion counting using MergeSortCounter.\"\"\"\n    def __init__(self, sorter: Optional[MergeSortCounter] = None) -> None:\n        self._sorter = sorter if sorter is not None else MergeSortCounter()\n\n    def get_inversion_count(self, arr: List[int]) -> int:\n        \"\"\"Delegates to MergeSortCounter to get the inversion count for an array.\"\"\"\n        # Create a copy of the input list to avoid modifying the original during sorting.\n        _sorted_arr, count = self._sorter.count_and_sort(list(arr))\n        return count\ndef get_Inv_Count(arr: List[int]) -> int:\n    \"\"\"\n    Counts inversions in an array using a merge sort based approach.\n    An inversion is a pair of indices (i, j) such that i < j and arr[i] > arr[j].\n    \"\"\"\n    service = InversionService()\n    return service.get_inversion_count(arr)"}
