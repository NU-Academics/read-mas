{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(items):\n    \"\"\"\n    Removes consecutive duplicates from a list, preserving order.\n    Returns a new list with adjacent identical elements collapsed.\n    \"\"\"\n    if not items:\n        return []\n\n    result = []\n    last_value = object()  # Use a sentinel value that won't equal any real item\n\n    for item in items:\n        if item != last_value:\n            result.append(item)\n            last_value = item\n            \n    return result"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(text: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots with a colon.\n    This function uses regular expressions for efficient character replacement.\n    \"\"\"\n    import re\n\n    # Define the characters to be replaced in a regex character set.\n    # The characters ' ', ',', and '.' are special in regex, but safe within a character class.\n    pattern = re.compile(r\"[ ,\\.]\")\n\n    # Perform the replacement using the compiled pattern.\n    return pattern.sub(':', text)"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr, target):\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array using binary search.\n    Returns -1 if the target is not found.\n    \"\"\"\n    lo = 0\n    hi = len(arr) - 1\n    result = -1\n\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        if arr[mid] == target:\n            result = mid\n            hi = mid - 1  # Found target, now try to find an earlier occurrence in the left half\n        elif arr[mid] < target:\n            lo = mid + 1\n        else:  # arr[mid] > target\n            hi = mid - 1\n    return result"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(arr):\n    \"\"\"\n    Calculates the sum of products of all contiguous sublists (subarrays) of the given list.\n    Uses an O(n) dynamic programming approach.\n    \"\"\"\n    total_sum = 0\n    # prev_contrib stores the sum of products of all subarrays ending at the previous element.\n    prev_contrib = 0\n\n    for x in arr:\n        # current_contrib is the sum of products of all subarrays ending at the current element 'x'.\n        # This includes 'x' itself and 'x' multiplied by all subarrays ending at the previous element.\n        current_contrib = x + prev_contrib * x\n        total_sum += current_contrib\n        prev_contrib = current_contrib\n\n    return total_sum"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"Toggles all bits of the number except the first (MSB) and the last (LSB) bit.\"\"\"\n    bit_length = number.bit_length()\n\n    # For numbers with less than 3 bits, there are no \"middle\" bits to toggle.\n    if bit_length < 3:\n        return number\n\n    # Create a mask with 1s in all middle bit positions (MSB and LSB are 0).\n    # This generates 011...110 pattern.\n    middle_mask = ((1 << (bit_length - 1)) - 1) ^ 1\n    \n    return number ^ middle_mask"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(seq, value):\n    \"\"\"\n    Locates the left insertion point for a value in a sorted sequence using binary search.\n    The returned index ensures the value is inserted before any existing equal elements.\n    \"\"\"\n    low = 0\n    high = len(seq)\n\n    while low < high:\n        mid = (low + high) // 2\n        if seq[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/737", "solution": "import re\nVOWEL_PATTERN: str = r'^[aeiouAEIOU]'\n_VOWEL_REGEX = re.compile(VOWEL_PATTERN)\ndef normalize_input(s: str) -> str:\n    \"\"\"Strips leading whitespace from the string.\"\"\"\n    return s.lstrip()\ndef is_empty_or_whitespace(s: str) -> bool:\n    \"\"\"Checks if the string is empty or contains only whitespace.\"\"\"\n    return not s or s.isspace()\ndef check_str(s: str) -> bool:\n    \"\"\"\n    Checks if the given string is starting with a vowel using regex.\n    Leading whitespace is ignored; empty or whitespace-only strings return False.\n    \"\"\"\n    if is_empty_or_whitespace(s):\n        return False\n\n    normalized_s = normalize_input(s)\n    return bool(_VOWEL_REGEX.match(normalized_s))"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple):\n    \"\"\"\n    Converts a tuple of adjacent key-value pairs into a dictionary.\n    Assumes the input tuple has an even length.\n    \"\"\"\n    result_dict = {}\n    for i in range(0, len(input_tuple), 2):\n        key = input_tuple[i]\n        value = input_tuple[i + 1]\n        result_dict[key] = value\n    return result_dict"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(s: str) -> bool:\n    \"\"\"\n    Checks if all characters in the given string are identical.\n    An empty string or a single-character string is considered to have all characters the same.\n    \"\"\"\n    if len(s) <= 1:\n        return True\n    first_char = s[0]\n    for char in s[1:]:\n        if char != first_char:\n            return False\n    return True"}
{"task_id": "Mbpp/739", "solution": "import math\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    This uses a closed-form quadratic solution for O(1) efficiency.\n    \"\"\"\n    # The smallest number with n digits is 10^(n-1).\n    # We need to find the smallest k such that T_k = k*(k+1)/2 >= 10^(n-1).\n    target = 10**(n - 1)\n\n    # Solve k*(k+1)/2 >= target, which is k^2 + k - 2*target >= 0.\n    # Using the quadratic formula k = (-1 +/- sqrt(1 - 4*1*(-2*target))) / 2\n    # k = (-1 + sqrt(1 + 8*target)) / 2 (we take the positive root)\n    # Since k must be an integer, we need to take the ceiling.\n    # math.isqrt returns floor(sqrt(x))\n\n    # Calculate s = floor(sqrt(1 + 8*target))\n    s = math.isqrt(1 + 8 * target)\n\n    # Calculate k using integer division. This is effectively floor((-1 + s) / 2)\n    k = (-1 + s) // 2\n\n    # A final check is needed because math.isqrt gives floor, and integer division\n    # also floors. If (-1 + sqrt(1 + 8*target)) / 2 was slightly above an integer,\n    # or if s was slightly less than the true sqrt due to rounding, k might be off by 1.\n    # We must ensure T_k >= target. If not, increment k.\n    # This check ensures we get the smallest k for which T_k >= target.\n    if k * (k + 1) // 2 < target:\n        k += 1\n\n    return k"}
{"task_id": "Mbpp/742", "solution": "def area_tetrahedron(edge_length: float) -> float:\n    \"\"\"Calculates the total surface area of a regular tetrahedron.\n    The formula used is sqrt(3) * edge_length^2.\n    \"\"\"\n    import math\n    SQRT_3 = math.sqrt(3.0)\n    return SQRT_3 * (edge_length ** 2)"}
