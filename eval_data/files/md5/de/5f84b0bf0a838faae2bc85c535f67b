{"task_id": "Mbpp/126", "solution": "def sum(a: int, b: int) -> int:\n    \"\"\"Finds the sum of common divisors of two numbers.\"\"\"\n\n    def _gcd(x: int, y: int) -> int:\n        while y:\n            x, y = y, x % y\n        return abs(x)\n\n    def _iter_divisors(n: int):\n        if n <= 0:\n            return []\n        divs = []\n        limit = int(n**0.5)\n        for i in range(1, limit + 1):\n            if n % i == 0:\n                divs.append(i)\n                j = n // i\n                if j != i:\n                    divs.append(j)\n        # Ensure divisors are returned in ascending order as in the design context's example.\n        return sorted(divs)\n\n    g = _gcd(abs(a), abs(b))\n\n    if g == 0:\n        return 0\n\n    total_sum = 0\n    for divisor in _iter_divisors(g):\n        total_sum += divisor\n    \n    return total_sum"}
{"task_id": "Mbpp/128", "solution": "import unicodedata\nimport string\ndef _strip_surrounding_punct(token: str) -> str:\n    \"\"\"Removes leading and trailing punctuation from a token.\"\"\"\n    return token.strip(string.punctuation)\ndef _normalize_token(token: str) -> str:\n    \"\"\"Normalizes token to NFC form and removes surrounding punctuation.\"\"\"\n    t = unicodedata.normalize(\"NFC\", token)\n    t = _strip_surrounding_punct(t)\n    return t\ndef _is_word(token: str) -> bool:\n    \"\"\"Checks if a token contains at least one alphanumeric character.\"\"\"\n    return any(ch.isalnum() for ch in token)\ndef long_words(n: int, text: str) -> list[str]:\n    \"\"\"\n    Finds words that are longer than n characters from a given string.\n    \"\"\"\n    raw_tokens = text.split()\n    result = []\n    for raw_token in raw_tokens:\n        normalized_token = _normalize_token(raw_token)\n        if _is_word(normalized_token) and len(normalized_token) > n:\n            result.append(normalized_token)\n    return result"}
{"task_id": "Mbpp/129", "solution": "from typing import List\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"\n    Checks if a given square matrix is a magic square.\n\n    A magic square is an n x n matrix where all rows, columns, and\n    both main diagonals sum to the same magic constant, and it contains\n    each integer from 1 to n^2 exactly once.\n    \"\"\"\n    if not matrix:\n        return False # An empty matrix cannot be a magic square.\n\n    n = len(matrix)\n    if n == 0:\n        return False # A matrix with no rows cannot be a magic square.\n\n    # Validate that it's a square matrix (all rows have n columns).\n    # Assumes elements are integers based on type hint and \"DO NOT add isinstance() checks\" constraint.\n    for row in matrix:\n        if len(row) != n:\n            return False # Not a square matrix.\n\n    # Calculate the magic constant for a square with numbers 1 to n^2.\n    magic_constant = n * (n*n + 1) // 2\n\n    # Flatten the matrix to check for unique numbers from 1 to n^2.\n    flattened_elements = [element for row in matrix for element in row]\n\n    # Check if the matrix contains each integer from 1 to n^2 exactly once.\n    expected_set = set(range(1, n * n + 1))\n    actual_set = set(flattened_elements)\n\n    if len(flattened_elements) != n * n or actual_set != expected_set:\n        return False # Numbers are not 1 to n^2, or they are not unique.\n\n    # Verify all row sums.\n    for row in matrix:\n        if sum(row) != magic_constant:\n            return False\n\n    # Verify all column sums.\n    for j in range(n):\n        col_sum = 0\n        for i in range(n):\n            col_sum += matrix[i][j]\n        if col_sum != magic_constant:\n            return False\n\n    # Verify the primary diagonal sum (top-left to bottom-right).\n    primary_diagonal_sum = 0\n    for i in range(n):\n        primary_diagonal_sum += matrix[i][i]\n    if primary_diagonal_sum != magic_constant:\n        return False\n\n    # Verify the secondary diagonal sum (top-right to bottom-left).\n    secondary_diagonal_sum = 0\n    for i in range(n):\n        secondary_diagonal_sum += matrix[i][n - 1 - i]\n    if secondary_diagonal_sum != magic_constant:\n        return False\n\n    # If all checks pass, it is a magic square.\n    return True"}
