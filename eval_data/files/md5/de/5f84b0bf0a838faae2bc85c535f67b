{"task_id": "Mbpp/566", "solution": "def sum_digits(n):\n    \"\"\"Calculates the sum of the digits of a non-negative integer.\"\"\"\n    if n == 0:\n        return 0\n    total = 0\n    while n > 0:\n        total += n % 10\n        n //= 10\n    return total"}
{"task_id": "Mbpp/567", "solution": "def issort_list(l):\n    \"\"\"\n    Checks if a list is sorted in non-decreasing order.\n    An empty list or a list with one element is considered sorted.\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    for i in range(1, len(l)):\n        if l[i] < l[i-1]:\n            return False\n    return True"}
{"task_id": "Mbpp/564", "solution": "from typing import List\nfrom collections import Counter\ndef count_Pairs(numbers: List[int]) -> int:\n    \"\"\"\n    Counts the number of possible unordered pairs from a list of integers where both elements are unequal.\n    This is calculated by subtracting pairs of identical values from the total possible pairs.\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return 0\n\n    # Calculate the total number of unique unordered pairs possible (n choose 2)\n    total_pairs = n * (n - 1) // 2\n\n    # Build a frequency map to count occurrences of each number\n    frequency = Counter(numbers)\n\n    # Calculate the number of pairs where both elements are identical\n    same_value_pairs = 0\n    for count in frequency.values():\n        if count >= 2:\n            same_value_pairs += count * (count - 1) // 2\n\n    # The result is the total pairs minus the pairs with identical values\n    return total_pairs - same_value_pairs"}
