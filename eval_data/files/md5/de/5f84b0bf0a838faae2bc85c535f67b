{"task_id": "Mbpp/445", "solution": "def index_multiplication(tuple1, tuple2):\n    \"\"\"\n    Performs index-wise multiplication of elements from two nested tuples.\n    Assumes inputs are tuples of tuples of integers with matching shapes.\n    \"\"\"\n    result = []\n    for inner_tuple1, inner_tuple2 in zip(tuple1, tuple2):\n        inner_result = tuple(x * y for x, y in zip(inner_tuple1, inner_tuple2))\n        result.append(inner_result)\n    return tuple(result)"}
{"task_id": "Mbpp/446", "solution": "def count_Occurrence(container: tuple, elements: list) -> int:\n    \"\"\"\n    Counts the total occurrences of all elements from a list within a tuple.\n    Validates inputs and aggregates counts using a service-oriented approach.\n    \"\"\"\n    from typing import Any, Tuple, List, Dict\n    from collections import Counter\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid input types or values.\"\"\"\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(message)\n\n    def validate_tuple(container_val: Any) -> None:\n        \"\"\"Ensures the container is a tuple, raising InvalidInputError if not.\"\"\"\n        if not isinstance(container_val, tuple):\n            raise InvalidInputError(\"Container must be a tuple.\")\n\n    def validate_list(elements_val: Any) -> None:\n        \"\"\"Ensures the elements list is a list, raising InvalidInputError if not.\"\"\"\n        if not isinstance(elements_val, list):\n            raise InvalidInputError(\"Elements must be a list.\")\n\n    class OccurrenceRequest:\n        \"\"\"Data transfer object for an occurrence counting request.\"\"\"\n        def __init__(self, container_req: Tuple[Any, ...], targets_req: List[Any]) -> None:\n            self.container = container_req\n            self.targets = targets_req\n\n    class OccurrenceResult:\n        \"\"\"Data transfer object for the result of an occurrence count.\"\"\"\n        def __init__(self, counts: Dict[Any, int]) -> None:\n            self.counts = dict(counts)\n            self.total = sum(self.counts.values())\n\n        def to_dict(self) -> Dict[str, Any]:\n            \"\"\"Returns a serializable dictionary representation of the result.\"\"\"\n            return {\"counts\": self.counts, \"total\": self.total}\n\n    class TupleRepository:\n        \"\"\"Provides low-level, performant counting operations on tuples.\"\"\"\n        def count(self, container_repo: Tuple[Any, ...]) -> Counter:\n            \"\"\"Returns a collections.Counter for all elements in the container.\"\"\"\n            return Counter(container_repo)\n\n        def count_many(self, container_repo: Tuple[Any, ...], elements_repo: List[Any]) -> Dict[Any, int]:\n            \"\"\"Efficiently computes counts for specific elements from a container.\"\"\"\n            counter = self.count(container_repo)\n            return {e: counter.get(e, 0) for e in elements_repo}\n\n    class OccurrenceService:\n        \"\"\"Encapsulates the business logic for counting occurrences.\"\"\"\n        def __init__(self, repo: 'TupleRepository') -> None:\n            self.repo = repo\n\n        def count_occurrences(self, request_svc: 'OccurrenceRequest') -> 'OccurrenceResult':\n            \"\"\"Uses the repository to count occurrences and constructs a result object.\"\"\"\n            counts = self.repo.count_many(request_svc.container, request_svc.targets)\n            return OccurrenceResult(counts)\n\n    validate_tuple(container)\n    validate_list(elements)\n\n    req = OccurrenceRequest(container_req=container, targets_req=elements)\n    service = OccurrenceService(repo=TupleRepository())\n    result = service.count_occurrences(request_svc=req)\n\n    return result.total"}
