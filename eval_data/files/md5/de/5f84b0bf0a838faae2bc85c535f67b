{"task_id": "Mbpp/790", "solution": "def even_position(lst):\n    \"\"\"\n    Checks if every even index in the list contains an even number.\n    Returns True if all numbers at even indices are even, otherwise False.\n    \"\"\"\n    for i in range(0, len(lst), 2):\n        if lst[i] % 2 != 0:\n            return False\n    return True"}
{"task_id": "Mbpp/787", "solution": "import re\nimport json\nfrom typing import Optional, List, Dict, Any, Callable\nfrom pathlib import Path\ndef text_match_three(text: str) -> bool:\n    \"\"\"\n    Checks if the input string contains the substring \"abbb\" using a MatchService.\n    All necessary helpers are defined inline as required.\n    \"\"\"\n    _DEFAULT_PATTERN: str = r\"abbb\"\n    _PATTERN_STORE_PATH: str = \"data/patterns.json\"\n    _PATTERN_ID_DEFAULT: str = \"default\"\n\n    class ValidationError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    class PersistenceError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    class MatchError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    class Pattern:\n        def __init__(self, id: str, regex: str, description: Optional[str]=None) -> None:\n            self.id = id\n            self.regex = regex\n            self.description = description\n\n    class InputValidator:\n        @staticmethod\n        def validate_text(text: str) -> None:\n            if not isinstance(text, str):\n                raise ValidationError(\"Input 'text' must be a string.\")\n\n        @staticmethod\n        def normalize_text(text: str) -> str:\n            return text.strip()\n\n    class RegexAdapter:\n        def __init__(self, pattern: str) -> None:\n            self._pattern = pattern\n            self._compiled = None\n\n        def compile(self) -> None:\n            try:\n                self._compiled = re.compile(self._pattern)\n            except re.error as e:\n                raise MatchError(f\"Invalid regex pattern: {self._pattern}. Error: {e}\") from e\n\n        def search(self, text: str) -> Optional[str]:\n            if self._compiled is None:\n                self.compile()\n            m = self._compiled.search(text)\n            return m.group(0) if m else None\n\n    class PatternRepository:\n        def __init__(self, store_path: str) -> None:\n            self._store_path = Path(store_path)\n            self._ensure_store_exists()\n\n        def _ensure_store_exists(self) -> None:\n            try:\n                self._store_path.parent.mkdir(parents=True, exist_ok=True)\n                if not self._store_path.exists():\n                    default_data = {\n                        _PATTERN_ID_DEFAULT: {\n                            \"id\": _PATTERN_ID_DEFAULT,\n                            \"regex\": _DEFAULT_PATTERN,\n                            \"description\": \"a followed by three b's\"\n                        }\n                    }\n                    with self._store_path.open('w') as f:\n                        json.dump(default_data, f, indent=2)\n            except Exception:\n                # If file system operations fail, get_default_pattern will handle fallback.\n                pass \n\n        def get_default_pattern(self) -> Pattern:\n            try:\n                if self._store_path.exists():\n                    with self._store_path.open('r') as f:\n                        data = json.load(f)\n                        if _PATTERN_ID_DEFAULT in data:\n                            p_data = data[_PATTERN_ID_DEFAULT]\n                            return Pattern(id=p_data[\"id\"], regex=p_data[\"regex\"], description=p_data.get(\"description\"))\n                return Pattern(id=_PATTERN_ID_DEFAULT, regex=_DEFAULT_PATTERN, description=\"a followed by three b's\")\n            except (json.JSONDecodeError, FileNotFoundError, KeyError):\n                return Pattern(id=_PATTERN_ID_DEFAULT, regex=_DEFAULT_PATTERN, description=\"a followed by three b's\")\n            except Exception as e:\n                raise PersistenceError(f\"Failed to retrieve default pattern: {e}\") from e\n\n    class MatchService:\n        def __init__(self, pattern_repo: PatternRepository, regex_adapter_factory: Callable[[str], RegexAdapter]) -> None:\n            self._pattern_repo = pattern_repo\n            self._adapter_factory = regex_adapter_factory\n\n        def text_match_three(self, text: str) -> bool:\n            InputValidator.validate_text(text)\n            normalized = InputValidator.normalize_text(text)\n            \n            pattern = self._pattern_repo.get_default_pattern()\n            \n            try:\n                adapter = self._adapter_factory(pattern.regex)\n                adapter.compile()\n                matched = adapter.search(normalized)\n                return bool(matched)\n            except Exception as ex:\n                raise MatchError(f\"Matching failed: {ex}\") from ex\n\n    repo = PatternRepository(_PATTERN_STORE_PATH)\n    service = MatchService(repo, lambda p: RegexAdapter(p))\n    return service.text_match_three(text)"}
{"task_id": "Mbpp/793", "solution": "def last(arr, target):\n    \"\"\"\n    Finds the last position of an element in a sorted array using binary search.\n    Returns the index of the last occurrence, or -1 if the element is not found.\n    \"\"\"\n    left, right = 0, len(arr) - 1\n    result = -1\n\n    while left <= right:\n        mid = (left + right) // 2\n        if arr[mid] == target:\n            result = mid\n            left = mid + 1  # Search in the right half for further occurrences\n        elif arr[mid] < target:\n            left = mid + 1\n        else:  # arr[mid] > target\n            right = mid - 1\n    return result"}
{"task_id": "Mbpp/792", "solution": "from typing import Any\nclass InvalidInputError(ValueError):\n    \"\"\"Specific exception for input validation failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\nclass ListCollection:\n    \"\"\"Lightweight DTO to hold validated list-of-items.\"\"\"\n    def __init__(self, data: list) -> None:\n        self.data = data\n\n    def __len__(self) -> int:\n        return len(self.data)\nclass InputValidator:\n    \"\"\"Validates and normalizes external inputs into ListCollection instances.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate(self, lists: Any) -> ListCollection:\n        if lists is None:\n            raise InvalidInputError(\"Input cannot be None\")\n        if isinstance(lists, str):\n            raise InvalidInputError(\"Input must be an iterable, not a string\")\n        try:\n            iter(lists)\n        except TypeError:\n            raise InvalidInputError(\"Input must be an iterable (e.g., a list)\")\n        # normalize to list\n        normalized = list(lists)\n        return ListCollection(normalized)\nclass CountService:\n    \"\"\"Core counting logic: count top-level elements that are instances of list.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def count_lists(self, collection: ListCollection) -> int:\n        return sum(1 for item in collection.data if isinstance(item, list))\nclass CountController:\n    \"\"\"Validates inputs and orchestrates call to CountService; public adapter for library.\"\"\"\n    def __init__(self, validator: InputValidator, service: CountService) -> None:\n        self._validator = validator\n        self._service = service\n\n    def count(self, lists: Any) -> int:\n        collection = self._validator.validate(lists)\n        return self._service.count_lists(collection)\ndef count_list(lists: Any) -> int:\n    \"\"\"Counts the number of lists in a given number of lists.\n    Validates input and delegates counting to internal services.\"\"\"\n    validator = InputValidator()\n    service = CountService()\n    controller = CountController(validator=validator, service=service)\n    return controller.count(lists)"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Uses an O(1) arithmetic formula: sum of first k odd numbers is k^2.\n    \"\"\"\n    def _sum_odds_up_to(n: int) -> int:\n        \"\"\"Helper to calculate the sum of odd natural numbers up to n (inclusive).\"\"\"\n        if n <= 0:\n            return 0\n        # Count of odd natural numbers up to n\n        count = (n + 1) // 2\n        # Sum of the first k odd numbers is k^2\n        return count * count\n\n    # The sum of odd numbers in [l, r] is the sum up to r minus the sum up to (l-1).\n    return _sum_odds_up_to(r) - _sum_odds_up_to(l - 1)"}
{"task_id": "Mbpp/796", "solution": "from decimal import Decimal\ndef return_sum(data_dict: dict) -> Decimal:\n    \"\"\"\n    Calculates the sum of all numeric values in the given dictionary.\n    Each value is converted to Decimal for precise aggregation.\n    \"\"\"\n    total = Decimal('0')\n    for value in data_dict.values():\n        total += Decimal(str(value))\n    return total"}
{"task_id": "Mbpp/798", "solution": "from typing import Sequence, Any\ndef _sum(values: Sequence[Any]) -> int:\n    \"\"\"Calculates the sum of elements in a sequence, with input validation.\"\"\"\n\n    class ValidationError(Exception):\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(message)\n\n    DEFAULT_MAX_LENGTH = 1_000_000\n\n    class ArrayValidator:\n        \"\"\"Validates input sequence for sum computation.\"\"\"\n        def __init__(self, max_length: int = DEFAULT_MAX_LENGTH) -> None:\n            self._max_length = max_length\n\n        def validate(self, values: Sequence[Any]) -> None:\n            if values is None:\n                raise ValidationError(\"Input is None\")\n            if not isinstance(values, (list, tuple)):\n                raise ValidationError(\"Input must be a list or tuple\")\n            if len(values) > self._max_length:\n                raise ValidationError(f\"Input length exceeds maximum {self._max_length}\")\n            for i, v in enumerate(values):\n                try:\n                    int(v)\n                except (TypeError, ValueError):\n                    raise ValidationError(f\"Element at index {i} is not integer-convertible: {v}\")\n\n    class SumService:\n        \"\"\"Performs the core summation algorithm.\"\"\"\n        def __init__(self) -> None:\n            pass\n\n        def sum_array(self, values: Sequence[Any]) -> int:\n            return sum(int(v) for v in values)\n\n    class SumController:\n        \"\"\"Orchestrates validation and summation logic.\"\"\"\n        def __init__(self, validator: ArrayValidator, service: SumService) -> None:\n            self._validator = validator\n            self._service = service\n\n        def compute_sum(self, values: Sequence[Any]) -> int:\n            self._validator.validate(values)\n            return self._service.sum_array(values)\n\n    class Api:\n        \"\"\"Public API wrapper for the sum function.\"\"\"\n        def __init__(self, controller: SumController = None) -> None:\n            if controller is None:\n                validator = ArrayValidator()\n                service = SumService()\n                controller = SumController(validator, service)\n            self._controller = controller\n\n        def _sum(self, values: Sequence[Any]) -> int:\n            return self._controller.compute_sum(values)\n\n    _api_instance = Api()\n    return _api_instance._sum(values)"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(text):\n    \"\"\"\n    Removes all whitespace characters from the input string.\n    Uses str.isspace() to identify all Unicode whitespace.\n    \"\"\"\n    return ''.join(ch for ch in text if not ch.isspace())"}
{"task_id": "Mbpp/794", "solution": "def text_starta_endb(text: str, persistence_enabled: bool = False) -> bool:\n    \"\"\"\n    Checks if a string starts with 'a' and ends with 'b'.\n    Optionally logs match attempts if persistence is enabled.\n    \"\"\"\n    import re\n    import datetime\n    import logging\n    import sqlite3\n    import os\n\n    class Config:\n        \"\"\"Manages application configuration, including default regex pattern and persistence settings.\"\"\"\n        def __init__(self, default_pattern: str = None, case_sensitive: bool = True, persistence_enabled: bool = False, db_path: str = None) -> None:\n            self.default_pattern = default_pattern if default_pattern is not None else \"^a.*b$\"\n            self.case_sensitive = case_sensitive\n            self.persistence_enabled = persistence_enabled\n            self.db_path = db_path if db_path is not None else \"data/match_history.db\"\n\n    class MatchError(Exception):\n        \"\"\"Custom exception for matching or repository operation errors.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    class Pattern:\n        \"\"\"Represents a regex pattern and its compilation flags.\"\"\"\n        def __init__(self, pattern: str, flags: int = 0) -> None:\n            self.pattern = pattern\n            self.flags = flags\n\n    class MatchResult:\n        \"\"\"DTO for the result of a match attempt, including metadata.\"\"\"\n        def __init__(self, success: bool, input_text: str, pattern: str, groups: dict | None = None, timestamp: datetime.datetime | None = None) -> None:\n            self.success = success\n            self.input_text = input_text\n            self.pattern = pattern\n            self.groups = groups\n            self.timestamp = timestamp if timestamp is not None else datetime.datetime.utcnow()\n\n        def to_dict(self) -> dict:\n            \"\"\"Converts the match result to a dictionary for serialization.\"\"\"\n            return {\n                \"success\": self.success,\n                \"input_text\": self.input_text,\n                \"pattern\": self.pattern,\n                \"groups\": self.groups,\n                \"timestamp\": self.timestamp.isoformat()\n            }\n\n    class Validator:\n        \"\"\"Utility for validating input text types.\"\"\"\n        @staticmethod\n        def validate_text(text: str) -> None:\n            \"\"\"Raises TypeError if the input is not a string.\"\"\"\n            if not isinstance(text, str):\n                raise TypeError(\"text must be str\")\n\n    class RegexRepository:\n        \"\"\"Handles regex matching operations using Python's re module.\"\"\"\n        def __init__(self, pattern: Pattern) -> None:\n            try:\n                self.pattern = pattern\n                self._compiled = re.compile(pattern.pattern, pattern.flags)\n            except re.error as e:\n                raise MatchError(f\"Invalid regex: {e}\") from e\n\n        def match(self, text: str) -> tuple[bool, dict | None]:\n            \"\"\"Performs a fullmatch against the compiled regex.\"\"\"\n            m = self._compiled.fullmatch(text)\n            if not m:\n                return False, None\n            return True, m.groupdict() or {}\n\n    class HistoryRepository:\n        \"\"\"Manages persistence of match results to a SQLite database.\"\"\"\n        def __init__(self, db_path: str) -> None:\n            self.db_path = db_path\n            self.init_db()\n\n        def init_db(self) -> None:\n            \"\"\"Initializes the SQLite database and creates the match_history table.\"\"\"\n            db_dir = os.path.dirname(self.db_path)\n            if db_dir and not os.path.exists(db_dir):\n                os.makedirs(db_dir, exist_ok=True)\n            conn = None\n            try:\n                conn = sqlite3.connect(self.db_path)\n                cursor = conn.cursor()\n                cursor.execute(\"\"\"\n                    CREATE TABLE IF NOT EXISTS match_history (\n                        id INTEGER PRIMARY KEY AUTOINCREMENT,\n                        timestamp TEXT NOT NULL,\n                        input_text TEXT NOT NULL,\n                        success INTEGER NOT NULL,\n                        pattern TEXT NOT NULL\n                    )\n                \"\"\")\n                conn.commit()\n            except sqlite3.Error as e:\n                raise MatchError(f\"Failed to initialize database: {e}\") from e\n            finally:\n                if conn:\n                    conn.close()\n\n        def save(self, result: MatchResult) -> None:\n            \"\"\"Saves a MatchResult object to the match history database.\"\"\"\n            conn = None\n            try:\n                conn = sqlite3.connect(self.db_path)\n                cursor = conn.cursor()\n                cursor.execute(\n                    \"INSERT INTO match_history (timestamp, input_text, success, pattern) VALUES (?, ?, ?, ?)\",\n                    (result.timestamp.isoformat(), result.input_text, 1 if result.success else 0, result.pattern)\n                )\n                conn.commit()\n            except sqlite3.Error as e:\n                raise MatchError(f\"Failed to save match result to database: {e}\") from e\n            finally:\n                if conn:\n                    conn.close()\n\n    class MatcherService:\n        \"\"\"Orchestrates validation, regex matching, and optional persistence of results.\"\"\"\n        def __init__(self, regex_repo: RegexRepository, history_repo: HistoryRepository | None, config: Config) -> None:\n            self.regex_repo = regex_repo\n            self.history_repo = history_repo\n            self.config = config\n\n        def match(self, text: str) -> MatchResult:\n            \"\"\"Performs a match operation on the given text and returns a MatchResult.\"\"\"\n            Validator.validate_text(text)\n            try:\n                success, groups = self.regex_repo.match(text)\n            except MatchError:\n                raise\n\n            result = MatchResult(\n                success=success,\n                input_text=text,\n                pattern=self.config.default_pattern,\n                groups=groups,\n                timestamp=datetime.datetime.utcnow()\n            )\n\n            if self.config.persistence_enabled and self.history_repo:\n                try:\n                    self.history_repo.save(result)\n                except MatchError:\n                    logging.getLogger(__name__).exception(\"Failed to persist match result\")\n            return result\n\n    class TextController:\n        \"\"\"Provides high-level API for text matching operations.\"\"\"\n        def __init__(self, service: MatcherService) -> None:\n            self.service = service\n\n        def text_starta_endb(self, text: str) -> bool:\n            \"\"\"Checks if the given text matches the configured pattern and returns a boolean.\"\"\"\n            result = self.service.match(text)\n            return result.success\n\n        def get_match_result(self, text: str) -> dict:\n            \"\"\"Returns the full match result as a dictionary.\"\"\"\n            result = self.service.match(text)\n            return result.to_dict()\n\n    def build_default_controller_internal(persistence_enabled: bool = False) -> TextController:\n        \"\"\"Builds and wires up the default TextController with its dependencies.\"\"\"\n        cfg = Config(persistence_enabled=persistence_enabled)\n        pattern = Pattern(cfg.default_pattern, flags=0 if cfg.case_sensitive else re.IGNORECASE)\n        regex_repo = RegexRepository(pattern)\n        history_repo = HistoryRepository(cfg.db_path) if cfg.persistence_enabled else None\n        service = MatcherService(regex_repo, history_repo, cfg)\n        return TextController(service)\n\n    controller = build_default_controller_internal(persistence_enabled=persistence_enabled)\n    return controller.text_starta_endb(text)"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(number, d):\n    \"\"\"\n    Rotates the bits of a 32-bit unsigned integer to the left by d positions.\n    The result is always masked to 32 bits.\n    \"\"\"\n    UINT32_BITS = 32\n    UINT32_MASK = 0xFFFFFFFF\n\n    # Ensure the number fits within 32 bits.\n    # The design context assumes `number` is already in [0, 2^32-1],\n    # but the utility snippet masks it again for safety.\n    number = number & UINT32_MASK\n\n    # Normalize the shift amount to be within [0, 31].\n    shift = d % UINT32_BITS\n\n    # If shift is 0, no rotation is needed.\n    if shift == 0:\n        return number\n\n    # Perform the left rotation:\n    # 1. Shift left: (number << shift)\n    # 2. Shift right: (number >> (UINT32_BITS - shift))\n    # 3. Combine with bitwise OR: (part1 | part2)\n    # 4. Mask the result to ensure it stays within 32 bits.\n    rotated_number = ((number << shift) | (number >> (UINT32_BITS - shift))) & UINT32_MASK\n    return rotated_number"}
{"task_id": "Mbpp/803", "solution": "import math\ndef is_perfect_square(n: int) -> bool:\n    \"\"\"Checks if the given number is a perfect square using integer square root.\"\"\"\n    if n < 0:\n        return False\n    root = math.isqrt(n)\n    return root * root == n"}
{"task_id": "Mbpp/801", "solution": "from dataclasses import dataclass\nimport json\nimport os\nimport datetime\nfrom typing import Any\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised when an input value is not valid.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\nclass RepositoryError(Exception):\n    \"\"\"Exception raised for issues encountered during repository operations.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\nclass InputValidator:\n    \"\"\"Utility class for validating and converting input values.\"\"\"\n    @staticmethod\n    def validate_int(value: Any, name: str) -> int:\n        \"\"\"Converts the given value to an integer, raising InvalidInputError on failure.\"\"\"\n        try:\n            if isinstance(value, float):\n                if not value.is_integer():\n                    raise InvalidInputError(f\"{name} must be an integer, got non-integer float\")\n            converted = int(value)\n            return converted\n        except (ValueError, TypeError):\n            raise InvalidInputError(f\"{name} must be an integer: {value!r}\")\nclass LogRepository:\n    \"\"\"Handles appending log entries to a file.\"\"\"\n    DEFAULT_LOG_PATH: str = \"logs/three_equal.log\"\n\n    def __init__(self, path: str = None) -> None:\n        self._path = path if path is not None else self.DEFAULT_LOG_PATH\n        os.makedirs(os.path.dirname(self._path), exist_ok=True)\n\n    def append(self, entry: dict) -> None:\n        \"\"\"Writes a dictionary as a JSON line to the configured log file.\"\"\"\n        try:\n            with open(self._path, 'a', encoding='utf-8') as f:\n                json.dump(entry, f)\n                f.write('\\n')\n        except IOError as e:\n            raise RepositoryError(f\"Failed to write to log file {self._path}: {e}\")\nclass LoggerAdapter:\n    \"\"\"Adapts logging calls to the LogRepository.\"\"\"\n    DEFAULT_LOG_PATH: str = \"logs/three_equal.log\"\n\n    def __init__(self, repository: LogRepository = None) -> None:\n        self._repository = repository if repository is not None else LogRepository(self.DEFAULT_LOG_PATH)\n\n    def log_call(self, triple: Triple, result: int) -> None:\n        \"\"\"Logs the input triple and the computed result.\"\"\"\n        log_entry = {\n            \"timestamp\": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds'),\n            \"a\": triple.a,\n            \"b\": triple.b,\n            \"c\": triple.c,\n            \"result\": result,\n            \"source\": \"api\"\n        }\n        try:\n            self._repository.append(log_entry)\n        except RepositoryError:\n            pass # Logging failures should not prevent the main operation.\nclass ThreeEqualService:\n    \"\"\"Core service for counting equal numbers among three integers.\"\"\"\n    def count_equal(self, a: int, b: int, c: int) -> int:\n        \"\"\"Determines how many of the three provided integers are equal.\"\"\"\n        triple = Triple(a, b, c)\n        return self._count_from_triple(triple)\n\n    def _count_from_triple(self, triple: Triple) -> int:\n        \"\"\"Calculates the equality count from a Triple object.\"\"\"\n        distinct_count = len(set(triple.as_tuple()))\n        if distinct_count == 1:\n            return 3\n        if distinct_count == 2:\n            return 2\n        return 0\ndef test_three_equal(a: Any, b: Any, c: Any) -> int:\n    \"\"\"\n    Counts the number of equal numbers from three given integers.\n    This function validates inputs, computes the equality count, and logs the operation.\n    \"\"\"\n    validator = InputValidator()\n    ia = validator.validate_int(a, \"a\")\n    ib = validator.validate_int(b, \"b\")\n    ic = validator.validate_int(c, \"c\")\n    service = ThreeEqualService()\n    result = service.count_equal(ia, ib, ic)\n    LoggerAdapter().log_call(Triple(ia, ib, ic), result)\n    return result"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers: list) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    Returns True if any number is even or zero, False otherwise (including for an empty list).\n    \"\"\"\n    for n in numbers:\n        if n % 2 == 0:\n            return True\n    return False"}
