{"task_id": "Mbpp/108", "solution": "from typing import Any, Sequence, List, Optional, Dict\nimport heapq\nfrom abc import ABC, abstractmethod\nclass MergeError(Exception):\n    \"\"\"Base exception for merge-related errors.\"\"\"\n    pass\nclass InvalidInputError(MergeError):\n    \"\"\"Raised when input lists or elements are invalid.\"\"\"\n    pass\nclass StrategyError(MergeError):\n    \"\"\"Raised when a merge strategy fails or is incorrectly chosen.\"\"\"\n    pass\ndef _coerce_to_int(value: Any) -> int:\n    \"\"\"Coerces a value to an integer, raising InvalidInputError if unsuccessful.\"\"\"\n    try:\n        if value is None:\n            raise InvalidInputError(\"Input list cannot contain None values.\")\n        return int(value)\n    except (ValueError, TypeError) as e:\n        raise InvalidInputError(f\"Could not convert '{value}' to an integer.\") from e\ndef _is_sorted(seq: Sequence[int]) -> bool:\n    \"\"\"Checks if a sequence of integers is sorted in non-decreasing order.\"\"\"\n    if not seq:\n        return True\n    return all(seq[i] <= seq[i+1] for i in range(len(seq) - 1))\nclass MergeRequest:\n    \"\"\"Data Transfer Object for merge requests.\"\"\"\n    def __init__(self, lists: List[List[Any]], strategy: Optional[str] = \"auto\", source_meta: Optional[Dict[str, Any]] = None):\n        self.lists = lists\n        self.strategy = strategy\n        self.source_meta = source_meta if source_meta is not None else {}\nclass MergeResult:\n    \"\"\"Data Transfer Object for merge results.\"\"\"\n    def __init__(self, merged: List[int], strategy_used: str, stats: Optional[Dict[str, Any]] = None):\n        self.merged = merged\n        self.strategy_used = strategy_used\n        self.stats = stats if stats is not None else {}\nclass MergeStrategy(ABC):\n    \"\"\"Abstract Base Class for merge strategies.\"\"\"\n    @abstractmethod\n    def merge(self, lists: List[List[int]]) -> List[int]:\n        pass\nclass SortFlattenStrategy(MergeStrategy):\n    \"\"\"A merge strategy that flattens all lists and then sorts the combined list.\"\"\"\n    def merge(self, lists: List[List[int]]) -> List[int]:\n        combined = []\n        for lst in lists:\n            combined.extend(lst)\n        combined.sort()\n        return combined\nclass HeapKWayStrategy(MergeStrategy):\n    \"\"\"A merge strategy that uses heapq.merge for k-way merging of already sorted lists.\"\"\"\n    def merge(self, lists: List[List[int]]) -> List[int]:\n        return list(heapq.merge(*lists))\nclass InputValidator:\n    \"\"\"Validates and coerces input sequences for the merge operation.\"\"\"\n    def validate_request(self, request: MergeRequest) -> None:\n        if not isinstance(request.lists, list) or len(request.lists) != 3:\n            raise InvalidInputError(\"MergeRequest must contain exactly three lists.\")\n\n    def coerce_and_validate_sequence(self, seq: Sequence[Any], seq_name: str = \"sequence\") -> List[int]:\n        if not isinstance(seq, (list, tuple)):\n            raise InvalidInputError(f\"Input '{seq_name}' must be a list or tuple.\")\n        \n        coerced_list = []\n        for item in seq:\n            coerced_list.append(_coerce_to_int(item))\n        return coerced_list\nclass ListMergerService:\n    \"\"\"Orchestrates the merging process including validation, strategy selection, and execution.\"\"\"\n    def __init__(self, validator: InputValidator):\n        self._validator = validator\n\n    def merge(self, request: MergeRequest) -> MergeResult:\n        self._validator.validate_request(request)\n\n        coerced_lists = []\n        for i, lst in enumerate(request.lists):\n            coerced_lists.append(self._validator.coerce_and_validate_sequence(lst, f\"list {i+1}\"))\n        \n        is_each_list_sorted = [_is_sorted(cl) for cl in coerced_lists]\n\n        chosen_strategy_name = request.strategy\n        strategy_instance: MergeStrategy\n\n        if chosen_strategy_name == \"auto\":\n            if all(is_each_list_sorted):\n                strategy_instance = HeapKWayStrategy()\n                chosen_strategy_name = \"heap\"\n            else:\n                strategy_instance = SortFlattenStrategy()\n                chosen_strategy_name = \"sort\"\n        elif chosen_strategy_name == \"heap\":\n            if all(is_each_list_sorted):\n                strategy_instance = HeapKWayStrategy()\n            else:\n                strategy_instance = SortFlattenStrategy()\n                chosen_strategy_name = \"sort\" # Fallback and update strategy name used\n        elif chosen_strategy_name == \"sort\":\n            strategy_instance = SortFlattenStrategy()\n        else:\n            raise StrategyError(f\"Unknown merge strategy requested: '{request.strategy}'. Must be 'auto', 'heap', or 'sort'.\")\n\n        merged_list = strategy_instance.merge(coerced_lists)\n\n        return MergeResult(merged=merged_list, strategy_used=chosen_strategy_name)\nclass _MergeController:\n    \"\"\"Internal controller that handles the high-level request processing for merging lists.\"\"\"\n    def __init__(self):\n        self.validator = InputValidator()\n        self.service = ListMergerService(validator=self.validator)\n\n    def merge_lists(self, a: Sequence[Any], b: Sequence[Any], c: Sequence[Any]) -> List[int]:\n        \"\"\"Merges three lists into a single sorted list using the configured service.\"\"\"\n        request = MergeRequest(lists=[a, b, c], strategy=\"auto\")\n        result = self.service.merge(request)\n        return result.merged\ndef merge_sorted_list(list_a, list_b, list_c):\n    \"\"\"\n    Merges three lists into a single sorted list.\n    Elements are coerced to integers, and an optimal merging strategy is automatically selected.\n    \"\"\"\n    controller = _MergeController()\n    return controller.merge_lists(list_a, list_b, list_c)"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists):\n    \"\"\"\n    Finds common elements across multiple nested lists.\n    Returns a sorted list of unique common elements.\n    \"\"\"\n    if not nested_lists:\n        return []\n\n    try:\n        # Attempt to convert all inner lists to sets for efficient intersection,\n        # which requires items to be hashable.\n        sets = [set(lst) for lst in nested_lists]\n\n        # Calculate the intersection of all sets\n        common_elements_set = set.intersection(*sets)\n\n        # Convert the set to a list\n        result = list(common_elements_set)\n        \n        # Sort the results for deterministic output.\n        # Fallback to sorting by type and string representation if items are not directly orderable.\n        try:\n            return sorted(result)\n        except TypeError:\n            return sorted(result, key=lambda v: (str(type(v)), str(v)))\n\n    except TypeError:\n        # Fallback for when inner list items are unhashable (e.g., dicts, lists)\n        # Perform iterative comparison.\n        \n        # If the first list is empty, no common elements are possible.\n        if not nested_lists[0]:\n            return []\n\n        first_list_elements = nested_lists[0]\n        \n        # Use a set to collect unique common elements, respecting \"presence/absence semantics\"\n        # and avoiding duplicates in the final result.\n        unique_common = set()\n\n        for item in first_list_elements:\n            # Check if 'item' exists (by equality) in all other lists.\n            is_common = True\n            for other_list in nested_lists[1:]:\n                if not any(item == y for y in other_list):\n                    is_common = False\n                    break\n            if is_common:\n                unique_common.add(item)\n        \n        result = list(unique_common)\n        \n        # Sort the results for deterministic output.\n        # Fallback to sorting by type and string representation if items are not directly orderable.\n        try:\n            return sorted(result)\n        except TypeError:\n            return sorted(result, key=lambda v: (str(type(v)), str(v)))"}
{"task_id": "Mbpp/113", "solution": "import re\ndef check_integer(s: str) -> bool:\n    \"\"\"\n    Checks if a string represents a valid integer, allowing optional leading signs and whitespace.\n    \"\"\"\n    integer_pattern = r'^[+-]?\\d+$'\n    trimmed_s = s.strip()\n    return re.fullmatch(integer_pattern, trimmed_s) is not None"}
