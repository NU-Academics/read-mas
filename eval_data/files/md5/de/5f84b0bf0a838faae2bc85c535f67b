{"task_id": "Mbpp/607", "solution": "import re\nclass InvalidPatternError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass PatternNotFoundError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass SearchResult:\n    def __init__(self, match: str, start: int, end: int) -> None:\n        if not isinstance(match, str) or not isinstance(start, int) or not isinstance(end, int):\n            raise ValueError(\"Invalid types for SearchResult\")\n        if start > end:\n            raise ValueError(\"start must be <= end\")\n        self.match = match\n        self.start = start\n        self.end = end\n\n    def to_tuple(self) -> tuple[str, int, int]:\n        return (self.match, self.start, self.end)\nDEFAULT_FLAGS: int = 0\nclass PatternValidator:\n    def __init__(self, flags: int = 0) -> None:\n        self._flags = flags\n\n    def validate(self, pattern: str) -> re.Pattern:\n        try:\n            return re.compile(pattern, self._flags)\n        except re.error as e:\n            raise InvalidPatternError(f\"Invalid regex pattern: {e}\") from e\nclass RegexRepository:\n    def search(self, text: str, compiled_pattern: re.Pattern) -> SearchResult:\n        m = compiled_pattern.search(text)\n        if not m:\n            raise PatternNotFoundError(\"No match found\")\n        return SearchResult(m.group(0), m.start(), m.end())\nclass SearchService:\n    def __init__(self, validator: PatternValidator, repo: RegexRepository) -> None:\n        self._validator = validator\n        self._repo = repo\n\n    def find(self, text: str, pattern: str) -> SearchResult:\n        compiled = self._validator.validate(pattern)\n        return self._repo.search(text, compiled)\nclass SearchController:\n    def __init__(self, service: SearchService) -> None:\n        self._service = service\n\n    def find_literals(self, text: str, pattern: str) -> tuple[str, int, int]:\n        result = self._service.find(text, pattern)\n        return result.to_tuple()\n_default_controller = SearchController(\n    SearchService(PatternValidator(DEFAULT_FLAGS), RegexRepository())\n)\ndef find_literals(text: str, pattern: str) -> tuple[str, int, int]:\n    \"\"\"Search a string for a regex pattern and return the matching substring, start, and end indices.\"\"\"\n    return _default_controller.find_literals(text, pattern)"}
{"task_id": "Mbpp/605", "solution": "def prime_num(num: int) -> bool:\n    \"\"\"\n    Checks if the given integer is a prime number using trial division.\n    Handles special cases for numbers less than or equal to 1, and the number 2.\n    \"\"\"\n    if num <= 1:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n\n    # Check for divisors from 3 up to the square root of num, only odd numbers.\n    i = 3\n    while i * i <= num:\n        if num % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(data: list, k: int) -> list:\n    \"\"\"\n    Returns a new list with the element at the k-th position (1-based index) removed.\n    This function assumes k is a valid 1-based index within the list bounds.\n    \"\"\"\n    # Adjust k from a 1-based position to a 0-based index for list access.\n    index_to_remove = k - 1\n    # Return a new list by concatenating the slice before the index\n    # and the slice after the index, effectively removing the element at that index.\n    return data[:index_to_remove] + data[index_to_remove + 1:]"}
{"task_id": "Mbpp/608", "solution": "import abc\nfrom typing import Any, Optional, Dict\nclass BellError(Exception):\n    \"\"\"Base exception for Bell number operations.\"\"\"\n    pass\nclass PersistenceError(BellError):\n    \"\"\"Raised for issues during cache persistence.\"\"\"\n    pass\nclass InvalidInputError(BellError):\n    \"\"\"Raised when input is invalid.\"\"\"\n    pass\ndef validate_non_negative_int(n: Any) -> int:\n    \"\"\"Validates if n is a non-negative integer.\"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise InvalidInputError(f\"n must be a non-negative integer, got {n!r}\")\n    return n\ndef bell_via_triangle(n: int) -> int:\n    \"\"\"Computes the nth Bell number using the Bell triangle algorithm.\"\"\"\n    validate_non_negative_int(n)\n    if n == 0:\n        return 1\n    prev = [1]\n    for k in range(1, n + 1):\n        row = [prev[-1]]\n        for j in range(1, k + 1):\n            row.append(row[j - 1] + (prev[j - 1] if j - 1 < len(prev) else 0))\n        prev = row\n    return prev[0]\nclass BellRepository(abc.ABC):\n    \"\"\"Abstract base class for Bell number repositories.\"\"\"\n    @abc.abstractmethod\n    def get(self, n: int) -> Optional[int]:\n        pass\n\n    @abc.abstractmethod\n    def set(self, n: int, value: int) -> None:\n        pass\n\n    @abc.abstractmethod\n    def load(self) -> None:\n        pass\n\n    @abc.abstractmethod\n    def persist(self) -> None:\n        pass\nclass InMemoryBellRepository(BellRepository):\n    \"\"\"An in-memory implementation of BellRepository.\"\"\"\n    def __init__(self):\n        self._cache: Dict[int, int] = {}\n\n    def get(self, n: int) -> Optional[int]:\n        return self._cache.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        self._cache[n] = value\n\n    def load(self) -> None:\n        pass\n\n    def persist(self) -> None:\n        pass\nclass BellService:\n    \"\"\"Manages Bell number computation and caching.\"\"\"\n    def __init__(self, repo: BellRepository, max_cached_n: int = 1000):\n        self.repo = repo\n        self.max_cached_n = max_cached_n\n        self.repo.load()\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes or retrieves the nth Bell number, utilizing caching.\"\"\"\n        validate_non_negative_int(n)\n        cached_value = self.repo.get(n)\n        if cached_value is not None:\n            return cached_value\n        return self._compute_and_cache(n)\n\n    def _compute_and_cache(self, n: int) -> int:\n        \"\"\"Computes the Bell number and stores it in the repository.\"\"\"\n        value = bell_via_triangle(n)\n        if n <= self.max_cached_n:\n            self.repo.set(n, value)\n            try:\n                self.repo.persist()\n            except PersistenceError:\n                pass\n        return value\nclass BellController:\n    \"\"\"Handles high-level requests for Bell numbers.\"\"\"\n    def __init__(self, service: BellService):\n        self.service = service\n\n    def get_bell_number(self, n: Any) -> int:\n        \"\"\"Retrieves the Bell number for n, delegating to the service.\"\"\"\n        return self.service.compute(n)\n_bell_repository = InMemoryBellRepository()\n_bell_service = BellService(repo=_bell_repository)\n_bell_controller = BellController(service=_bell_service)\ndef bell_Number(n: int) -> int:\n    \"\"\"Finds the nth Bell number using a cached in-memory repository.\"\"\"\n    return _bell_controller.get_bell_number(n)"}
{"task_id": "Mbpp/612", "solution": "def merge(list_of_lists):\n    \"\"\"\n    Splits a list of 2-element sublists into two separate lists.\n    The first output list contains all first elements, and the second contains all second elements.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n\n    for sublist in list_of_lists:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n        \n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(tuple_list):\n    \"\"\"\n    Calculates the cumulative sum of all numeric values across all tuples in the given list.\n    It iterates through each tuple and sums its elements to find the total.\n    \"\"\"\n    total_sum = 0\n    for inner_tuple in tuple_list:\n        for number in inner_tuple:\n            total_sum += number\n    return total_sum"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix: List[List[Union[int, float]]], n: int) -> Union[int, float]:\n    \"\"\"\n    Given a matrix (list of lists), returns the maximum value of the n'th column.\n    This implementation relies on built-in Python exceptions for invalid inputs.\n    \"\"\"\n    column_values = []\n    for row in matrix:\n        column_values.append(row[n])\n    return max(column_values)"}
{"task_id": "Mbpp/615", "solution": "class EmptyTupleError(Exception):\n    \"\"\"Raised when an empty tuple is encountered and fail_on_empty is True.\"\"\"\n    pass\ndef average_tuple(data: tuple[tuple[float, ...], ...], fail_on_empty: bool = False) -> list[float]:\n    \"\"\"\n    Calculates the average value for each inner tuple in a tuple of tuples.\n\n    For empty inner tuples, it returns float('nan') by default, or raises EmptyTupleError if fail_on_empty is True.\n    \"\"\"\n    averages: list[float] = []\n    for idx, inner_tuple in enumerate(data):\n        if len(inner_tuple) == 0:\n            if fail_on_empty:\n                raise EmptyTupleError(f\"Empty inner tuple found at position {idx}.\")\n            averages.append(float('nan'))\n        else:\n            averages.append(sum(inner_tuple) / len(inner_tuple))\n    return averages"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(left: tuple, right: tuple) -> tuple:\n    \"\"\"\n    Computes the element-wise modulo of two tuples of the same length.\n    Delegates input validation and modulo computation to internal classes.\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid input types or shapes.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class DivisionByZeroError(Exception):\n        \"\"\"Custom exception for division by zero during modulo operation.\"\"\"\n        def __init__(self, index: int, message: str | None = None) -> None:\n            super().__init__(message or f\"Division by zero at index {index}\")\n            self.index = index\n            self.message = message or f\"Division by zero at index {index}\"\n\n    class TuplePair:\n        \"\"\"Data Transfer Object for validated input tuples.\"\"\"\n        def __init__(self, left: tuple, right: tuple) -> None:\n            self._left: tuple[float | int] = left\n            self._right: tuple[float | int] = right\n\n        def __len__(self) -> int:\n            return len(self._left)\n\n        def as_pairs(self) -> list[tuple[float | int, float | int]]:\n            \"\"\"Returns a list of paired elements from the left and right tuples.\"\"\"\n            return list(zip(self._left, self._right))\n\n    class TupleValidator:\n        \"\"\"Validates the input tuples for type, length, and element types.\"\"\"\n        ALLOWED_NUMERIC = (int, float)\n\n        def _validate_element(self, e: object, index: int, name: str) -> float | int:\n            \"\"\"Ensures an element is a valid numeric type.\"\"\"\n            if not isinstance(e, self.ALLOWED_NUMERIC):\n                raise InvalidInputError(\n                    f\"Element at index {index} in {name} is not a number. Found type: {type(e).__name__}\"\n                )\n            return e\n\n        def validate(self, left: object, right: object) -> TuplePair:\n            \"\"\"Validates two objects are tuples of equal length with numeric elements.\"\"\"\n            if not isinstance(left, tuple) or not isinstance(right, tuple):\n                raise InvalidInputError(\"Both left and right inputs must be tuples.\")\n            if len(left) != len(right):\n                raise InvalidInputError(\"Input tuples must be the same length.\")\n\n            # Perform element-wise validation. If any element is invalid, an error is raised.\n            for i in range(len(left)):\n                self._validate_element(left[i], i, \"left\")\n                self._validate_element(right[i], i, \"right\")\n            \n            # If all validations pass, wrap the original (now confirmed valid) tuples in a TuplePair.\n            return TuplePair(left, right)\n\n    class TupleModuloService:\n        \"\"\"Performs the element-wise modulo computation.\"\"\"\n        def __init__(self, validator: TupleValidator | None = None) -> None:\n            # The validator is not directly used by compute if it receives a TuplePair,\n            # but is included as per design context for consistency.\n            self._validator = validator or TupleValidator()\n\n        def compute(self, pair: TuplePair) -> tuple[float | int]:\n            \"\"\"Calculates element-wise modulo, raising DivisionByZeroError if a divisor is zero.\"\"\"\n            results = []\n            for idx, (l, r) in enumerate(pair.as_pairs()):\n                if r == 0:\n                    raise DivisionByZeroError(idx)\n                results.append(l % r)\n            return tuple(results)\n\n    # Initialize validator and service components\n    validator = TupleValidator()\n    service = TupleModuloService(validator=validator)\n\n    # Validate inputs and receive a validated TuplePair DTO\n    validated_pair = validator.validate(left, right)\n\n    # Compute the element-wise modulo using the validated pair\n    return service.compute(validated_pair)"}
{"task_id": "Mbpp/618", "solution": "def div_list(a, b):\n    \"\"\"Divides two lists element-wise, converting results to floats.\n    Assumes inputs are lists of numeric values of equal length, with no division by zero.\n    \"\"\"\n    result = []\n    for i in range(len(a)):\n        result.append(float(a[i]) / float(b[i]))\n    return result"}
{"task_id": "Mbpp/619", "solution": "def move_num(s: str) -> str:\n    \"\"\"\n    Moves all digit characters to the end of the string, preserving relative order.\n    \"\"\"\n    non_digits = []\n    digits = []\n    for char in s:\n        if '0' <= char <= '9':\n            digits.append(char)\n        else:\n            non_digits.append(char)\n    return \"\".join(non_digits) + \"\".join(digits)"}
