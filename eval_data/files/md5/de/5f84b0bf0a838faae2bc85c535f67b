{"task_id": "Mbpp/8", "solution": "def square_nums(numbers):\n    \"\"\"\n    Computes the square of each element in a list of numbers.\n    Preserves int type for integer results, otherwise returns float.\n    \"\"\"\n    squares = []\n    for num in numbers:\n        squared_num = num * num\n        # Preserve int type if original number was int and result is whole\n        if isinstance(num, int) and not isinstance(num, bool):\n            squares.append(int(squared_num))\n        else:\n            squares.append(float(squared_num))\n    return squares"}
{"task_id": "Mbpp/2", "solution": "import collections.abc\nfrom typing import Any, Iterable, Set, Tuple, Hashable\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to the functions.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass Normalizer:\n    \"\"\"Normalizes elements to a hashable and comparable form.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def normalize_element(self, element: Any) -> Any:\n        \"\"\"Converts an element to a hashable representation.\"\"\"\n        try:\n            hash(element)\n            return element\n        except TypeError:\n            if isinstance(element, (list, set, tuple)):\n                return self._normalize_iterable(element)\n            if isinstance(element, dict):\n                # Normalize dictionary by converting to a sorted tuple of normalized key-value pairs\n                items = tuple(sorted((self.normalize_element(k), self.normalize_element(v)) for k,v in element.items()))\n                return items\n            raise InvalidInputError(f\"Cannot normalize element of type {type(element)}\")\n\n    def _normalize_iterable(self, element: Iterable[Any]) -> Tuple[Any, ...]:\n        \"\"\"Helper to normalize each item in an iterable and return a tuple.\"\"\"\n        return tuple(self.normalize_element(item) for item in element)\nclass CollectionModel:\n    \"\"\"Immutable domain model representing a collection of normalized, hashable elements.\"\"\"\n    def __init__(self, elements: Set[Any]) -> None:\n        self._elements = elements.copy()\n\n    @property\n    def elements(self) -> Set[Any]:\n        return self._elements\n\n    def size(self) -> int:\n        return len(self._elements)\nclass InputAdapter:\n    \"\"\"Validates input iterables and creates CollectionModel instances.\"\"\"\n    def __init__(self, normalizer: Normalizer) -> None:\n        self._normalizer = normalizer\n\n    def to_collection(self, iterable: Iterable[Any]) -> CollectionModel:\n        \"\"\"Converts an iterable into a CollectionModel, normalizing its elements.\"\"\"\n        if not isinstance(iterable, collections.abc.Iterable) or isinstance(iterable, str):\n            raise InvalidInputError(f\"Input must be an iterable (not a string), but received {type(iterable)}\")\n\n        normalized_elements = set()\n        for item in iterable:\n            normalized_elements.add(self._normalizer.normalize_element(item))\n        return CollectionModel(normalized_elements)\nclass SimilarityService:\n    \"\"\"Computes the set of shared elements between two CollectionModel instances.\"\"\"\n    def __init__(self, normalizer: Normalizer) -> None:\n        self._normalizer = normalizer # Injected for consistency, but primarily used by adapter\n\n    def find_shared(self, a: CollectionModel, b: CollectionModel) -> Set[Any]:\n        \"\"\"Efficiently computes intersection by iterating over the smaller set.\"\"\"\n        smaller, larger = self._choose_smaller_set(a.elements, b.elements)\n        return {e for e in smaller if e in larger}\n\n    def _choose_smaller_set(self, a_set: Set[Any], b_set: Set[Any]) -> Tuple[Set[Any], Set[Any]]:\n        \"\"\"Returns the tuple (smaller_set, larger_set).\"\"\"\n        if len(a_set) <= len(b_set):\n            return a_set, b_set\n        return b_set, a_set\nclass SimilarElementsController:\n    \"\"\"Orchestrates validation, normalization, and service calls for finding similar elements.\"\"\"\n    def __init__(self, service: SimilarityService, adapter: InputAdapter) -> None:\n        self._service = service\n        self._adapter = adapter\n\n    def similar_elements(self, a: Iterable[Any], b: Iterable[Any]) -> Set[Any]:\n        \"\"\"Finds shared elements by normalizing inputs and using the similarity service.\"\"\"\n        collection_a = self._adapter.to_collection(a)\n        collection_b = self._adapter.to_collection(b)\n        return self._service.find_shared(collection_a, collection_b)\ndef similar_elements(a: Iterable[Any], b: Iterable[Any]) -> Set[Any]:\n    \"\"\"Finds the shared elements from the given two lists or iterables.\"\"\"\n    normalizer = Normalizer()\n    adapter = InputAdapter(normalizer)\n    service = SimilarityService(normalizer)\n    controller = SimilarElementsController(service, adapter)\n    return controller.similar_elements(a, b)"}
{"task_id": "Mbpp/3", "solution": "import math\nimport threading\n_cache: dict[int, bool] = {}\n_cache_lock = threading.Lock()\ndef is_not_prime(n: int) -> bool:\n    \"\"\"\n    Identifies if a number is not prime (composite, 0, 1, or negative).\n    Uses a simple trial division algorithm with caching.\n    \"\"\"\n    \n    # Handle base cases and small primes/composites\n    if n <= 1:\n        # 0, 1, and negative numbers are considered non-prime\n        return True\n    if n == 2:\n        # 2 is prime, so it is not \"not prime\"\n        return False\n    if n % 2 == 0:\n        # Any even number greater than 2 is non-prime\n        return True\n\n    # Check cache for result\n    with _cache_lock:\n        cached_is_prime = _cache.get(n)\n\n    if cached_is_prime is not None:\n        # If found in cache, return its negation for is_not_prime\n        return not cached_is_prime\n\n    # Compute primality using trial division\n    # (n is odd and >= 3 at this point)\n    is_n_prime = True\n    limit = int(math.isqrt(n))\n    i = 3\n    while i <= limit:\n        if n % i == 0:\n            is_n_prime = False\n            break\n        i += 2\n\n    # Store result in cache\n    with _cache_lock:\n        _cache[n] = is_n_prime\n\n    # Return the negation of primality\n    return not is_n_prime"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(s: str, ch: str) -> str:\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    If the character appears once, that single occurrence is removed. If it does not\n    appear, the original string is returned unchanged.\n    \"\"\"\n    first_idx = s.find(ch)\n\n    if first_idx == -1:\n        # Character not found, return original string\n        return s\n    else:\n        last_idx = s.rfind(ch)\n\n        if first_idx == last_idx:\n            # Only one occurrence of the character\n            return s[:first_idx] + s[first_idx+1:]\n        else:\n            # Remove the first occurrence\n            s_without_first = s[:first_idx] + s[first_idx+1:]\n            \n            # The index of the last occurrence shifts if it was after the first one removed.\n            # Since first_idx < last_idx, all characters from first_idx + 1 onwards shift left by 1.\n            adjusted_last_idx = last_idx - 1\n            \n            # Remove the (now adjusted) last occurrence\n            return s_without_first[:adjusted_last_idx] + s_without_first[adjusted_last_idx+1:]"}
{"task_id": "Mbpp/4", "solution": "import heapq\ndef heap_queue_largest(numbers: list[int], n: int) -> list[int]:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n    It utilizes a heap-based algorithm for efficient selection.\n    \"\"\"\n    if not numbers:\n        return []\n\n    # Determine 'k', the actual number of largest elements to find.\n    # This handles cases where 'n' is greater than the list's length.\n    k = min(n, len(numbers))\n\n    # Use heapq.nlargest to efficiently find the k largest elements.\n    # The elements returned by heapq.nlargest are not guaranteed to be sorted.\n    top_k_elements = heapq.nlargest(k, numbers)\n\n    # Sort the result in descending order as required.\n    return sorted(top_k_elements, reverse=True)"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a, b):\n    \"\"\"\n    Checks if two integers differ at exactly one bit position.\n    This is true if their XOR sum is a power of two.\n    \"\"\"\n    xor_val = a ^ b\n    # A number is a power of two if it's greater than 0 and (x & (x - 1)) is 0.\n    # This also correctly handles cases where a == b (xor_val is 0), returning False.\n    return xor_val != 0 and (xor_val & (xor_val - 1)) == 0"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    Uses the Knuth-Morris-Pratt (KMP) algorithm's Longest Proper Prefix Suffix (LPS) array.\n    \"\"\"\n    n = len(s)\n    lps = [0] * n\n    length = 0\n    i = 1\n    while i < n:\n        if s[i] == s[length]:\n            length += 1\n            lps[i] = length\n            i += 1\n        else:\n            if length != 0:\n                length = lps[length - 1]\n            else:\n                lps[i] = 0\n                i += 1\n\n    # The period 'p' of the string is n - lps[n-1]\n    # If n is a multiple of p, then p is the minimum rotation.\n    # Otherwise, the string has no repeating pattern shorter than itself, so n rotations are needed.\n    period = n - lps[n - 1]\n    if n % period == 0:\n        return period\n    else:\n        return n"}
{"task_id": "Mbpp/7", "solution": "import re\nMIN_WORD_LENGTH: int = 4\nclass Word:\n    \"\"\"Represents a token found in text with its position.\"\"\"\n    def __init__(self, text: str, start: int, end: int):\n        self.text = text\n        self.start = start\n        self.end = end\n\n    def __repr__(self) -> str:\n        return f\"Word(text='{self.text}', start={self.start}, end={self.end})\"\nWORD_RE = re.compile(r\"[A-Za-z](?:[A-Za-z'\\-]*[A-Za-z])?\")\nclass Tokenizer:\n    \"\"\"Splits input text into Word objects based on a regex pattern.\"\"\"\n    def __init__(self, min_length: int = MIN_WORD_LENGTH):\n        self._min_length = min_length\n        self.WORD_RE = WORD_RE\n\n    def tokenize(self, text: str) -> list[Word]:\n        results = []\n        for m in self.WORD_RE.finditer(text):\n            w = Word(text=m.group(0), start=m.start(), end=m.end())\n            results.append(w)\n        return results\nclass WordFinderService:\n    \"\"\"Applies business rules to tokens to produce a filtered list of words.\"\"\"\n    def __init__(self, tokenizer: Tokenizer):\n        self._tokenizer = tokenizer\n\n    def find_words(self, text: str, unique: bool = False) -> list[str]:\n        tokens = self._tokenizer.tokenize(text)\n        results = [t.text for t in tokens if len(t.text) >= self._tokenizer._min_length]\n        if unique:\n            seen = set()\n            uniq = []\n            for w in results:\n                if w not in seen:\n                    seen.add(w)\n                    uniq.append(w)\n            return uniq\n        return results\n_default_tokenizer = Tokenizer()\n_default_service = WordFinderService(_default_tokenizer)\ndef find_char_long(text: str, unique: bool = False) -> list:\n    \"\"\"\n    Finds all words in a string that are at least 4 characters long.\n    Optionally returns only unique words.\n    \"\"\"\n    return _default_service.find_words(text, unique=unique)"}
{"task_id": "Mbpp/12", "solution": "from typing import List, Union\ndef sort_matrix(matrix: List[List[Union[int, float]]]) -> List[List[Union[int, float]]]:\n    \"\"\"Sorts a matrix by the sum of its rows in ascending order, maintaining stability for ties.\"\"\"\n    enumerated_rows = []\n    for idx, row in enumerate(matrix):\n        row_sum = sum(row)\n        enumerated_rows.append((row_sum, idx, list(row)))\n\n    enumerated_rows.sort(key=lambda t: (t[0], t[1]))\n\n    sorted_matrix = [row for (_, _, row) in enumerated_rows]\n    return sorted_matrix"}
{"task_id": "Mbpp/16", "solution": "import re\ndef text_lowercase_underscore(text: str) -> bool:\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters joined with a single underscore.\n    The string must match the pattern entirely: one or more lowercase letters, an underscore, then one or more lowercase letters.\n    \"\"\"\n    pattern = r\"^[a-z]+_[a-z]+$\"\n    return re.fullmatch(pattern, text) is not None"}
