{"task_id": "Mbpp/409", "solution": "def min_product_tuple(pairs: List[Tuple[float | int, float | int]]) -> float | int:\n    \"\"\"\n    Finds the minimum product from pairs of tuples within a given list.\n    Validates input and computes the minimum product using internal helper classes.\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        \"\"\"Raised when input data is malformed or contains non-numeric values.\"\"\"\n        pass\n\n    class EmptyInputError(Exception):\n        \"\"\"Raised when the input list of pairs is empty.\"\"\"\n        pass\n\n    @dataclass(frozen=True)\n    class Pair:\n        \"\"\"Represents a 2-element numeric pair with a product helper.\"\"\"\n        a: float\n        b: float\n\n        def product(self) -> float:\n            \"\"\"Returns the product of the two elements as a float.\"\"\"\n            return float(self.a * self.b)\n\n    class Validator:\n        \"\"\"Validates raw inputs and produces normalized Pair objects.\"\"\"\n        def is_number(self, value: Any) -> bool:\n            \"\"\"Checks if a value is an integer or float, excluding booleans.\"\"\"\n            return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n        def validate_and_normalize(self, raw_iterable: Iterable[Any]) -> Iterator[Pair]:\n            \"\"\"Validates each element in the iterable and yields Pair objects.\"\"\"\n            for idx, item in enumerate(raw_iterable):\n                if not hasattr(item, \"__len__\") or len(item) != 2:\n                    raise InvalidInputError(f\"Item at index {idx} is not a pair: {item!r}\")\n                a, b = item[0], item[1]\n                if not self.is_number(a) or not self.is_number(b):\n                    raise InvalidInputError(f\"Non-numeric element at index {idx}: {item!r}\")\n                yield Pair(float(a), float(b))\n\n    class MinProductService:\n        \"\"\"Computes the minimum product across an iterable of Pair objects.\"\"\"\n        def compute_min_product(self, pairs: Iterable[Pair]) -> float:\n            \"\"\"Iterates through pairs, computes their products, and returns the minimum.\"\"\"\n            iterator = iter(pairs)\n            try:\n                first = next(iterator)\n            except StopIteration:\n                raise EmptyInputError(\"No pairs provided\")\n            min_val = first.product()\n            for p in iterator:\n                prod = p.product()\n                if prod < min_val:\n                    min_val = prod\n            return min_val\n\n    # Main logic of min_product_tuple\n    validator = Validator()\n    normalized = validator.validate_and_normalize(pairs)\n    svc = MinProductService()\n    result = svc.compute_min_product(normalized)\n\n    # Return int if result is a whole number, otherwise float\n    if result.is_integer():\n        return int(result)\n    return result"}
{"task_id": "Mbpp/410", "solution": "import decimal\nfrom typing import Any, Sequence, Union, Iterator\nclass NoNumericValueError(ValueError):\n    \"\"\"Raised when no numeric values are found in the input sequence.\"\"\"\n    def __init__(self, message: str = \"No numeric values found\"):\n        super().__init__(message)\nclass InvalidInputError(TypeError):\n    \"\"\"Raised when the input is an invalid sequence type (e.g., a string instead of a list).\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nNUMERIC_TYPES = (int, float, decimal.Decimal)\nBOOLEAN_TYPES = (bool,)\ndef is_numeric(obj: Any) -> bool:\n    \"\"\"Checks if an object is a numeric type (int, float, Decimal) but not a boolean.\"\"\"\n    return isinstance(obj, NUMERIC_TYPES) and not isinstance(obj, BOOLEAN_TYPES)\ndef is_numeric_string(s: Any) -> bool:\n    \"\"\"Checks if an object is a string representing a valid number.\"\"\"\n    if not isinstance(s, str):\n        return False\n    try:\n        decimal.Decimal(s)\n        return True\n    except decimal.InvalidOperation:\n        return False\ndef coerce_to_number(obj: Any, allow_numeric_string: bool = False) -> Union[int, float, decimal.Decimal]:\n    \"\"\"Converts an object to a number, optionally handling numeric strings.\"\"\"\n    if is_numeric(obj):\n        return obj\n    if allow_numeric_string and is_numeric_string(obj):\n        text = str(obj).strip()\n        if text.isdigit() or (text.startswith('-') and text[1:].isdigit()):\n            return int(text)\n        return decimal.Decimal(text)\n    raise ValueError(\"Not numeric\")\nclass MinService:\n    \"\"\"Provides the core logic to find the minimum numeric value in a sequence.\"\"\"\n    DEFAULT_COERCE_NUMERIC_STRINGS = False\n\n    def __init__(self, coerce_numeric_strings: bool = DEFAULT_COERCE_NUMERIC_STRINGS) -> None:\n        self._coerce_numeric_strings = coerce_numeric_strings\n\n    def _candidates(self, values: Sequence[Any]) -> Iterator[Union[int, float, decimal.Decimal]]:\n        \"\"\"Yields only numeric values from the sequence, applying coercion if enabled.\"\"\"\n        for v in values:\n            try:\n                n = coerce_to_number(v, allow_numeric_string=self._coerce_numeric_strings)\n            except ValueError:\n                continue\n            yield n\n\n    def min_from_sequence(self, values: Sequence[Any]) -> Union[int, float, decimal.Decimal]:\n        \"\"\"Finds the minimum numeric value in the provided sequence.\"\"\"\n        if isinstance(values, (str, bytes)):\n            raise InvalidInputError(\"Expected a sequence/list, not a string or bytes object.\")\n\n        current_min = None\n        for num in self._candidates(values):\n            if current_min is None or num < current_min:\n                current_min = num\n\n        if current_min is None:\n            raise NoNumericValueError()\n        return current_min\ndef min_val(values: Sequence[Any], *, coerce_numeric_strings: bool = False) -> Union[int, float, decimal.Decimal]:\n    \"\"\"\n    Finds the minimum numeric value in a given heterogeneous list.\n    \"\"\"\n    service = MinService(coerce_numeric_strings=coerce_numeric_strings)\n    return service.min_from_sequence(values)"}
