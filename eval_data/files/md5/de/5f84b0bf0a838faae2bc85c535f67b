{"task_id": "Mbpp/97", "solution": "from typing import Iterable, Iterator, Any, Dict\ndef frequency_lists(lists: Iterable[Iterable[Any]]) -> Dict[Any, int]:\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists.\n    Returns a dictionary mapping each element to its count.\n    \"\"\"\n    class InvalidInputError(Exception):\n        \"\"\"Raised when the input to a function is invalid.\"\"\"\n        pass\n\n    class UnhashableElementError(InvalidInputError):\n        \"\"\"Raised when an unhashable element is encountered during counting.\"\"\"\n        def __init__(self, message: str, element: Any = None):\n            super().__init__(message)\n            self.element = element\n\n    class Utils:\n        @staticmethod\n        def is_iterable(obj: Any) -> bool:\n            \"\"\"Checks if an object is iterable but not a string.\"\"\"\n            return hasattr(obj, '__iter__') and not isinstance(obj, str)\n\n        @staticmethod\n        def ensure_iterable_of_iterables(obj: Any) -> None:\n            \"\"\"Ensures the given object is an iterable of iterables.\"\"\"\n            if not Utils.is_iterable(obj):\n                raise InvalidInputError(\"Input must be an iterable.\")\n            for i, inner in enumerate(obj):\n                if not Utils.is_iterable(inner):\n                    raise InvalidInputError(f\"Inner element at index {i} is not iterable.\")\n\n    class ListFlattener:\n        \"\"\"Flattens a shallow list of lists into an iterator of elements.\"\"\"\n        def flatten(self, lists: Iterable[Iterable[Any]]) -> Iterator[Any]:\n            Utils.ensure_iterable_of_iterables(lists)\n            for inner in lists:\n                for item in inner:\n                    yield item\n\n    class FrequencyResult:\n        \"\"\"Data transfer object for frequency counting results.\"\"\"\n        def __init__(self, frequencies: Dict[Any, int]):\n            self.frequencies = frequencies\n            self.total_elements = sum(frequencies.values())\n            self.unique_elements = len(frequencies)\n\n    class FrequencyService:\n        \"\"\"Orchestrates flattening and counting elements.\"\"\"\n        def __init__(self, flattener: ListFlattener, repository: Any = None):\n            self._flattener = flattener\n            self._repository = repository\n\n        def compute(self, lists: Iterable[Iterable[Any]]) -> FrequencyResult:\n            \"\"\"Flattens the input and computes the frequency of each element.\"\"\"\n            elems = self._flattener.flatten(lists)\n            counts = self._count(elems)\n            result = FrequencyResult(counts)\n            return result\n\n        def _count(self, iterable: Iterable[Any]) -> Dict[Any, int]:\n            \"\"\"Counts occurrences of each element, raising UnhashableElementError if needed.\"\"\"\n            counts = {}\n            for e in iterable:\n                try:\n                    counts[e] = counts.get(e, 0) + 1\n                except TypeError:\n                    raise UnhashableElementError(f\"Unhashable element: {e!r}\", element=e)\n            return counts\n\n    service = FrequencyService(ListFlattener())\n    return service.compute(lists).frequencies"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers):\n    \"\"\"\n    Multiplies all numbers in a list and divides the product by the list's length.\n    Assumes the input is a non-empty iterable of numbers.\n    \"\"\"\n    total_product = 1.0\n    list_length = 0\n\n    for num in numbers:\n        total_product *= num\n        list_length += 1\n    \n    return total_product / list_length"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal integer to its binary string representation.\n    Returns \"0\" for the input 0, and no leading zeros for other numbers.\n    \"\"\"\n    if n == 0:\n        return \"0\"\n\n    binary_digits = []\n    while n > 0:\n        binary_digits.append(str(n % 2))\n        n //= 2\n    return \"\".join(reversed(binary_digits))"}
