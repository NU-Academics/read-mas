{"task_id": "Mbpp/440", "solution": "def find_adverb_position(sentence):\n    \"\"\"\n    Finds the first adverb and its position in a given sentence.\n    Returns a tuple (start_index, end_index, adverb_text) or None if no adverb is found.\n    \"\"\"\n    import re\n    from typing import List, Tuple, Optional, Callable, Dict, Set, Iterable\n\n    class Token:\n        \"\"\"Represents a word token with its text and character offsets in the original sentence.\"\"\"\n        def __init__(self, text: str, start: int, end: int) -> None:\n            if not isinstance(text, str) or not text:\n                raise ValueError(\"Token text cannot be empty.\")\n            if not isinstance(start, int) or not isinstance(end, int) or not (0 <= start <= end):\n                raise ValueError(f\"Invalid token indices: start={start}, end={end}\")\n            self.text = text\n            self.start = start\n            self.end = end\n\n        def length(self) -> int:\n            return self.end - self.start\n\n        def __repr__(self) -> str:\n            return f\"Token(text='{self.text}', start={self.start}, end={self.end})\"\n\n    class IPOSTagger:\n        \"\"\"Interface contract for Part-Of-Speech taggers.\"\"\"\n        def tag(self, tokens: List[Token]) -> Dict[int, str]:\n            raise NotImplementedError(\"Subclasses must implement tag method.\")\n\n    class LexiconRepository:\n        \"\"\"Manages a small set of curated non-'ly' adverbs for lookup.\"\"\"\n        DEFAULT_ADVERBS: Set[str] = {\"very\", \"well\", \"often\", \"never\", \"always\", \"maybe\", \"now\", \"soon\", \"today\", \"yesterday\", \"here\", \"there\", \"again\"}\n\n        def __init__(self, extra_adverbs: Optional[Iterable[str]] = None) -> None:\n            self._adverbs = set(self.DEFAULT_ADVERBS)\n            if extra_adverbs:\n                self._adverbs.update(self._normalize_word(w) for w in extra_adverbs)\n\n        def is_adverb(self, word: str) -> bool:\n            \"\"\"Checks if a normalized word is present in the lexicon.\"\"\"\n            return self._normalize_word(word) in self._adverbs\n\n        def add(self, word: str) -> None:\n            \"\"\"Adds a word to the lexicon.\"\"\"\n            self._adverbs.add(self._normalize_word(word))\n\n        def _normalize_word(self, word: str) -> str:\n            \"\"\"Normalizes a word to lowercase.\"\"\"\n            return word.lower()\n\n    class RuleBasedPOSTagger(IPOSTagger):\n        \"\"\"A simple rule-based POS tagger using suffix heuristics and a lexicon.\"\"\"\n        SUFFIX = \"ly\"\n\n        def __init__(self, lexicon: LexiconRepository) -> None:\n            if not isinstance(lexicon, LexiconRepository) or not hasattr(lexicon, 'is_adverb'):\n                raise TypeError(\"Lexicon must be an instance of LexiconRepository.\")\n            self.lexicon = lexicon\n\n        def tag(self, tokens: List[Token]) -> Dict[int, str]:\n            \"\"\"Tags tokens as 'ADV' (adverb) or 'O' (other) based on rules.\"\"\"\n            tags = {}\n            for i, t in enumerate(tokens):\n                w = t.text.lower()\n                if self._is_adverb(w):\n                    tags[i] = \"ADV\"\n                else:\n                    tags[i] = \"O\"\n            return tags\n\n        def _is_adverb(self, word: str) -> bool:\n            \"\"\"Determines if a word is an adverb by checking its suffix or the lexicon.\"\"\"\n            return word.endswith(self.SUFFIX) or self.lexicon.is_adverb(word)\n\n    def tokenize_with_spans(text_sentence: str) -> List[Token]:\n        \"\"\"Tokenizes a sentence into Token objects, preserving original character offsets.\"\"\"\n        if not isinstance(text_sentence, str):\n            raise ValueError(\"Input for tokenization must be a string.\")\n            \n        pattern = re.compile(r\"\\b\\w+\\b\", flags=re.UNICODE)\n        return [Token(m.group(0), m.start(), m.end()) for m in pattern.finditer(text_sentence)]\n\n    class AdverbFinderService:\n        \"\"\"Orchestrates the process of finding the first adverb in a sentence.\"\"\"\n        def __init__(self, tagger: IPOSTagger, tokenizer: Callable[[str], List[Token]]) -> None:\n            if not isinstance(tagger, IPOSTagger) or not hasattr(tagger, 'tag'):\n                raise TypeError(\"Tagger must implement IPOSTagger interface with a 'tag' method.\")\n            if not callable(tokenizer):\n                raise TypeError(\"Tokenizer must be a callable function.\")\n            self.tagger = tagger\n            self.tokenizer = tokenizer\n\n        def find_first_adverb(self, sentence_text: str) -> Optional[Tuple[int, int, str]]:\n            \"\"\"Finds the first adverb in the given sentence and returns its position and text.\"\"\"\n            if not isinstance(sentence_text, str) or not sentence_text:\n                raise ValueError(\"Sentence must be a non-empty string.\")\n\n            tokens = self.tokenizer(sentence_text)\n            tags = self.tagger.tag(tokens)\n\n            for i, token in enumerate(tokens):\n                if tags.get(i) == \"ADV\":\n                    return (token.start, token.end, token.text.lower())\n            return None\n\n    # Main logic for find_adverb_position\n    if not isinstance(sentence, str):\n        raise ValueError(\"Input sentence must be a string.\")\n    \n    lexicon = LexiconRepository()\n    tagger = RuleBasedPOSTagger(lexicon)\n    service = AdverbFinderService(tagger, tokenize_with_spans)\n\n    return service.find_first_adverb(sentence)"}
