{"task_id": "Mbpp/721", "solution": "import numbers\nfrom typing import List, Tuple, Any, Optional\ndef maxAverageOfPath(grid: List[List[Any]]) -> float:\n    \"\"\"\n    Given a square matrix, find a path from top-left to bottom-right moving\n    only right or down, such that the average cost of cells in the path is maximized.\n    \"\"\"\n\n    class InvalidGridError(Exception):\n        \"\"\"Raised when the input grid is invalid.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    class Grid:\n        \"\"\"Represents the input matrix and provides safe accessors.\"\"\"\n        def __init__(self, cells_data: List[List[int]]) -> None:\n            self.cells = [list(row) for row in cells_data] # Ensure a copy\n            self.n = len(self.cells)\n\n        def get(self, r: int, c: int) -> int:\n            return self.cells[r][c]\n\n    def _validate_grid(cells_data: Any) -> None:\n        \"\"\"Validates that the input is a non-empty N*N list of lists of numbers.\"\"\"\n        if not isinstance(cells_data, list) or len(cells_data) == 0:\n            raise InvalidGridError(\"Grid must be a non-empty list of lists.\")\n        \n        n = len(cells_data)\n        for row in cells_data:\n            if not isinstance(row, list) or len(row) != n:\n                raise InvalidGridError(\"Grid must be square (N x N) and all rows must be lists.\")\n            for v in row:\n                if not isinstance(v, numbers.Number):\n                    raise InvalidGridError(\"All grid values must be numeric.\")\n        \n        # Grid must be N>=1. This is covered by len(cells_data) == 0 check.\n\n    def _compute_max_sum_dp(grid_instance: Grid) -> int:\n        \"\"\"Computes the maximum sum path from (0,0) to (N-1,N-1) using dynamic programming.\"\"\"\n        n = grid_instance.n\n        dp_table = [[0] * n for _ in range(n)]\n\n        for r in range(n):\n            for c in range(n):\n                current_val = grid_instance.get(r, c)\n\n                if r == 0 and c == 0:\n                    dp_table[r][c] = current_val\n                else:\n                    sum_from_top = dp_table[r - 1][c] if r > 0 else float(\"-inf\")\n                    sum_from_left = dp_table[r][c - 1] if c > 0 else float(\"-inf\")\n                    \n                    dp_table[r][c] = current_val + max(sum_from_top, sum_from_left)\n\n        return dp_table[n - 1][n - 1]\n\n    # Main function logic starts here\n    _validate_grid(grid)\n    grid_instance = Grid(grid)\n    n = grid_instance.n\n\n    total_sum = _compute_max_sum_dp(grid_instance)\n    \n    # For an N*N grid, any path from (0,0) to (N-1,N-1) moving only right/down\n    # will always have 2*N-1 cells. N is guaranteed >= 1.\n    path_length = (2 * n - 1)\n    \n    average = float(total_sum) / path_length\n\n    return average"}
{"task_id": "Mbpp/725", "solution": "def extract_quotation(text: str) -> list[str]:\n    \"\"\"\n    Extracts values enclosed in double quotation marks from a given string.\n    Handles escaped quotes and backslashes within the quoted content.\n    \"\"\"\n    # Regex pattern to match content between unescaped double quotes.\n    # It captures the content, handling escaped characters like \\\" and \\\\ inside.\n    pattern = r'(?<!\\\\)\"([^\"\\\\]*(?:\\\\.[^\"\\\\]*)*)\"'\n    \n    matches = re.findall(pattern, text)\n    \n    # Helper function to unescape specific sequences in the extracted strings.\n    def unescape(s: str) -> str:\n        return s.replace(r'\\\"', '\"').replace(r'\\\\', '\\\\')\n\n    extracted_values = [unescape(m) for m in matches]\n    \n    return extracted_values"}
