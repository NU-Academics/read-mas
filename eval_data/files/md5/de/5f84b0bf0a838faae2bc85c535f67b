{"task_id": "Mbpp/224", "solution": "import logging\nimport sqlite3\nfrom datetime import datetime\nfrom typing import Any, Dict, List, Optional, Protocol\nDEFAULT_STRATEGY = \"builtin\"\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    pass\ndef validate_int(value: Any) -> int:\n    \"\"\"Validates that the input is an integer.\"\"\"\n    if not isinstance(value, int):\n        raise InvalidInputError(\"Input must be an integer.\")\n    return value\ndef current_timestamp() -> datetime:\n    \"\"\"Returns the current UTC timestamp.\"\"\"\n    return datetime.utcnow()\nclass CountResult:\n    \"\"\"Data Transfer Object for bit count results.\"\"\"\n    def __init__(self, input_value: int, count: int, timestamp: datetime) -> None:\n        self.input_value = input_value\n        self.count = count\n        self.timestamp = timestamp\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Returns a JSON-serializable dictionary representation.\"\"\"\n        return {\n            \"input_value\": self.input_value,\n            \"count\": self.count,\n            \"timestamp\": self.timestamp.isoformat()\n        }\nclass AlgorithmStrategy(Protocol):\n    \"\"\"Interface for bit counting algorithms.\"\"\"\n    def count_bits(self, value: int) -> int:\n        \"\"\"Abstract method to count set bits in a number.\"\"\"\n        ...\nclass BuiltinStrategy:\n    \"\"\"Algorithm using Python's built-in bin() and count() methods.\"\"\"\n    def count_bits(self, value: int) -> int:\n        return bin(abs(value)).count(\"1\")\nclass KernighanStrategy:\n    \"\"\"Algorithm implementing Brian Kernighan's bit count method.\"\"\"\n    def count_bits(self, value: int) -> int:\n        n = abs(value)\n        count = 0\n        while n:\n            n &= n - 1\n            count += 1\n        return count\nclass StrategyFactory:\n    \"\"\"Factory to create AlgorithmStrategy instances.\"\"\"\n    def get_strategy(self, name: str) -> AlgorithmStrategy:\n        if name == \"builtin\":\n            return BuiltinStrategy()\n        elif name == \"kernighan\":\n            return KernighanStrategy()\n        else:\n            raise InvalidInputError(f\"Unknown strategy: {name}\")\nclass CountRepository:\n    \"\"\"Repository for persisting CountResult records to SQLite.\"\"\"\n    def __init__(self, db_path: str = \"bitcount.db\"):\n        self.db_path = db_path\n        self._conn = sqlite3.connect(self.db_path, check_same_thread=False)\n        self._ensure_schema()\n\n    def _ensure_schema(self) -> None:\n        \"\"\"Ensures the database schema exists.\"\"\"\n        cur = self._conn.cursor()\n        cur.execute(\"\"\"CREATE TABLE IF NOT EXISTS counts (\n                        id INTEGER PRIMARY KEY AUTOINCREMENT,\n                        input_value INTEGER NOT NULL,\n                        bit_count INTEGER NOT NULL,\n                        timestamp TEXT NOT NULL\n                       )\"\"\")\n        cur.execute(\"CREATE INDEX IF NOT EXISTS idx_counts_input_value ON counts (input_value)\")\n        self._conn.commit()\n\n    def save(self, record: CountResult) -> int:\n        \"\"\"Saves a CountResult record to the database.\"\"\"\n        cur = self._conn.cursor()\n        cur.execute(\n            \"INSERT INTO counts (input_value, bit_count, timestamp) VALUES (?, ?, ?)\",\n            (record.input_value, record.count, record.timestamp.isoformat())\n        )\n        self._conn.commit()\n        return cur.lastrowid\n\n    def query_by_value(self, value: int) -> List[CountResult]:\n        \"\"\"Queries records by input value.\"\"\"\n        cur = self._conn.cursor()\n        cur.execute(\"SELECT input_value, bit_count, timestamp FROM counts WHERE input_value = ?\", (value,))\n        results = []\n        for row in cur.fetchall():\n            input_value, count, timestamp_str = row\n            timestamp = datetime.fromisoformat(timestamp_str)\n            results.append(CountResult(input_value, count, timestamp))\n        return results\nclass BitCounter:\n    \"\"\"Orchestrates bit counting, validation, and optional persistence.\"\"\"\n    def __init__(self, strategy: AlgorithmStrategy, repo: Optional[CountRepository] = None) -> None:\n        self.strategy = strategy\n        self.repo = repo\n        self._logger = logging.getLogger(__name__)\n\n    def count(self, value: int) -> CountResult:\n        \"\"\"Counts set bits for a given value, validates, and optionally persists.\"\"\"\n        v = validate_int(value)\n        bit_count = self.strategy.count_bits(v)\n        result = CountResult(input_value=v, count=bit_count, timestamp=current_timestamp())\n        if self.repo:\n            try:\n                self.repo.save(result)\n            except Exception as e:\n                self._logger.warning(\"Failed to persist count: %s\", e)\n        return result\ndef count_Set_Bits(value: int) -> int:\n    \"\"\"Counts the number of set bits (binary digits with value 1) in a given number.\"\"\"\n    strategy = StrategyFactory().get_strategy(DEFAULT_STRATEGY)\n    repo = None  # Do not persist for lightweight call\n    counter = BitCounter(strategy, repo)\n    return counter.count(value).count"}
