{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n):\n    \"\"\"Calculates the average of cubes of the first n natural numbers using a closed-form formula.\n    Assumes n is a positive integer as per design context requirements for direct implementation.\"\"\"\n    sum_of_natural_numbers = n * (n + 1) // 2\n    sum_of_cubes = sum_of_natural_numbers * sum_of_natural_numbers\n    average = sum_of_cubes / n\n    return average"}
{"task_id": "Mbpp/421", "solution": "from typing import Any, Tuple, Optional\nDEFAULT_DELIMITER: str = \"-\"\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass ConcatenationError(Exception):\n    def __init__(self, message: str, original_exception: Optional[Exception] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.original_exception = original_exception\ndef validate_tuple_input(elements: Any) -> Tuple[Any, ...]:\n    if isinstance(elements, tuple):\n        return elements\n    if isinstance(elements, list):\n        return tuple(elements)\n    raise InvalidInputError(\"elements must be a tuple or list\")\ndef to_safe_str(element: Any) -> str:\n    try:\n        return str(element)\n    except Exception as exc:\n        raise ConcatenationError(\"Failed to convert element to str\", exc)\nclass TupleConcatRequest:\n    def __init__(self, elements: Tuple[Any, ...], delimiter: Optional[str] = None) -> None:\n        self.elements: Tuple[Any, ...] = elements\n        self.delimiter: Optional[str] = delimiter\nclass TupleConcatResult:\n    def __init__(self, result: str) -> None:\n        self.result: str = result\nclass TupleConcatenator:\n    def __init__(self, default_delimiter: Optional[str] = None) -> None:\n        self._default_delimiter: str = default_delimiter or DEFAULT_DELIMITER\n\n    def concatenate(self, elements: Tuple[Any, ...], delimiter: Optional[str] = None) -> str:\n        actual_delimiter = delimiter if delimiter is not None else self._default_delimiter\n        validated_elements = validate_tuple_input(elements)\n        string_parts = []\n        for e in validated_elements:\n            string_parts.append(to_safe_str(e))\n        return actual_delimiter.join(string_parts)\nclass TupleConcatController:\n    def __init__(self, concatenator: TupleConcatenator) -> None:\n        self._concatenator = concatenator\n\n    def concatenate_request(self, request: TupleConcatRequest) -> TupleConcatResult:\n        result_string = self._concatenator.concatenate(request.elements, request.delimiter)\n        return TupleConcatResult(result_string)\n_default_controller = TupleConcatController(TupleConcatenator())\ndef concatenate_tuple(elements: Tuple[Any, ...], delimiter: Optional[str] = None) -> str:\n    \"\"\"Concatenates elements of a tuple into a string using a delimiter, handling type conversions.\"\"\"\n    return _default_controller.concatenate_request(\n        TupleConcatRequest(elements, delimiter)\n    ).result"}
{"task_id": "Mbpp/426", "solution": "class InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\nclass OddFilterService:\n    def filter(self, numbers: list[int]) -> list[int]:\n        \"\"\"Filters a list of integers, returning only the odd numbers.\"\"\"\n        return [n for n in numbers if n % 2 != 0]\n\n    def filter_inplace(self, numbers: list[int]) -> list[int]:\n        \"\"\"Filters a list of integers in-place, returning the modified list.\"\"\"\n        write = 0\n        for read in range(len(numbers)):\n            if numbers[read] % 2 != 0:\n                numbers[write] = numbers[read]\n                write += 1\n        del numbers[write:]\n        return numbers\nclass InputValidator:\n    def validate(self, numbers: object) -> list[int]:\n        \"\"\"Validates input and converts it to a list of integers.\"\"\"\n        if numbers is None:\n            raise InvalidInputError(\"No input provided\")\n        if isinstance(numbers, str):\n            tokens = [t for part in numbers.split(\",\") for t in part.split()]\n            try:\n                return [int(t) for t in tokens if t != \"\"]\n            except ValueError as e:\n                raise InvalidInputError(\"String contains non-integer tokens\") from e\n        if isinstance(numbers, (list, tuple)):\n            result = []\n            for i, v in enumerate(numbers):\n                if not isinstance(v, int):\n                    raise InvalidInputError(f\"Element at index {i} is not an int\")\n                result.append(v)\n            return result\n        raise InvalidInputError(\"Unsupported input type\")\nclass FilterController:\n    def __init__(self, validator: InputValidator, service: OddFilterService) -> None:\n        \"\"\"Initializes the controller with a validator and a service.\"\"\"\n        self.validator = validator\n        self.service = service\n\n    def filter_numbers(self, raw_input: object) -> list[int]:\n        \"\"\"Validates raw input and filters odd numbers using the service.\"\"\"\n        validated_numbers = self.validator.validate(raw_input)\n        return self.service.filter(validated_numbers)\n_validator = InputValidator()\n_service = OddFilterService()\n_controller = FilterController(_validator, _service)\ndef filter_oddnumbers(numbers: list[int]) -> list[int]:\n    \"\"\"Filters a list of numbers to return only odd integers.\"\"\"\n    return _controller.filter_numbers(numbers)"}
{"task_id": "Mbpp/427", "solution": "import re\nfrom datetime import datetime\nclass InvalidDateFormatError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass DateString:\n    def __init__(self, year: str, month: str, day: str) -> None:\n        self.year = year\n        self.month = month\n        self.day = day\n\n    def as_tuple(self) -> tuple[str, str, str]:\n        return (self.year, self.month, self.day)\nclass DateParser:\n    DATE_REGEX = re.compile(r\"^(\\d{4})-(\\d{2})-(\\d{2})$\")\n\n    def parse(self, date_str: str) -> DateString:\n        m = self.DATE_REGEX.match(date_str)\n        if not m:\n            raise InvalidDateFormatError(\"Date must be in YYYY-MM-DD format\")\n        year, month, day = m.group(1), m.group(2), m.group(3)\n        self._validate_parts(year, month, day)\n        return DateString(year, month, day)\n\n    def _validate_parts(self, year: str, month: str, day: str) -> None:\n        try:\n            datetime(int(year), int(month), int(day))\n        except ValueError:\n            raise InvalidDateFormatError(\"Invalid date components\")\nclass DateFormatter:\n    def format(self, date: DateString) -> str:\n        return f\"{date.day.zfill(2)}-{date.month.zfill(2)}-{date.year.zfill(4)}\"\nclass ChangeDateService:\n    def __init__(self, parser: DateParser, formatter: DateFormatter) -> None:\n        self._parser = parser\n        self._formatter = formatter\n\n    def change_date_format(self, date_str: str) -> str:\n        parsed = self._parser.parse(date_str)\n        return self._formatter.format(parsed)\n_default_service = ChangeDateService(DateParser(), DateFormatter())\ndef change_date_format(date_str: str) -> str:\n    \"\"\"\n    Converts a date string from YYYY-MM-DD format to DD-MM-YYYY format.\n    Raises InvalidDateFormatError for invalid input formats or components.\n    \"\"\"\n    return _default_service.change_date_format(date_str)"}
