{"task_id": "Mbpp/259", "solution": "import ast\nfrom typing import Any, Tuple\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to the maximize_elements function.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\nclass TupleSequence:\n    \"\"\"A value object representing an immutable sequence of 2-int tuples.\"\"\"\n    def __init__(self, items: Tuple[Tuple[int, int], ...]) -> None:\n        self.items = items\n\n    def __len__(self) -> int:\n        return len(self.items)\n\n    def __getitem__(self, index: int) -> Tuple[int, int]:\n        return self.items[index]\n\n    def to_tuple(self) -> Tuple[Tuple[int, int], ...]:\n        return self.items\ndef is_two_int_tuple(obj: Any) -> bool:\n    \"\"\"Checks if an object is a tuple of length 2 with both elements being integers.\"\"\"\n    return (\n        isinstance(obj, tuple)\n        and len(obj) == 2\n        and isinstance(obj[0], int)\n        and isinstance(obj[1], int)\n    )\ndef pairwise_max(p: Tuple[int,int], q: Tuple[int,int]) -> Tuple[int,int]:\n    \"\"\"Computes the element-wise maximum of two 2-integer tuples.\"\"\"\n    return (max(p[0], q[0]), max(p[1], q[1]))\ndef normalize_to_tuple(obj: Any) -> Tuple[Tuple[int,int], ...]:\n    \"\"\"Converts various input types to a canonical tuple of 2-int tuples.\"\"\"\n    if isinstance(obj, str):\n        obj = ast.literal_eval(obj)\n    if isinstance(obj, list):\n        obj = tuple(obj)\n    return obj\nclass TupleValidator:\n    \"\"\"Validates and normalizes raw inputs into TupleSequence domain objects.\"\"\"\n    def parse_and_validate(self, obj: Any) -> TupleSequence:\n        normalized_obj = normalize_to_tuple(obj)\n\n        if not isinstance(normalized_obj, tuple):\n            raise InvalidInputError(f\"Input must be a sequence of 2-element tuples, got {type(normalized_obj).__name__}.\")\n\n        items = []\n        for item in normalized_obj:\n            if not is_two_int_tuple(item):\n                raise InvalidInputError(\n                    f\"All elements must be 2-element integer tuples, but found '{item}' of type {type(item).__name__} within the sequence.\"\n                )\n            items.append(item)\n        return TupleSequence(tuple(items))\n\n    def assert_same_length(self, a: TupleSequence, b: TupleSequence) -> None:\n        \"\"\"Asserts that two TupleSequence objects have the same length.\"\"\"\n        if len(a) != len(b):\n            raise InvalidInputError(\n                f\"Input sequences must have the same length, got {len(a)} and {len(b)}.\"\n            )\nclass TupleMaxService:\n    \"\"\"Provides the core algorithm to compute element-wise maxima of TupleSequence objects.\"\"\"\n    def maximize(self, a: TupleSequence, b: TupleSequence) -> TupleSequence:\n        if len(a) != len(b):\n            raise InvalidInputError(\"Internal Error: Tuple sequences passed to service have mismatched lengths.\")\n\n        result_items = tuple(pairwise_max(a[i], b[i]) for i in range(len(a)))\n        return TupleSequence(result_items)\ndef maximize_elements(a: Any, b: Any) -> Tuple[Tuple[int,int], ...]:\n    \"\"\"\n    Maximizes two sequences of 2-element tuples by taking element-wise maximums for each position.\n    Inputs are validated for type, shape, and matching lengths.\n    \"\"\"\n    validator = TupleValidator()\n    seq_a = validator.parse_and_validate(a)\n    seq_b = validator.parse_and_validate(b)\n    validator.assert_same_length(seq_a, seq_b)\n    service = TupleMaxService()\n    result_seq = service.maximize(seq_a, seq_b)\n    return result_seq.to_tuple()"}
{"task_id": "Mbpp/264", "solution": "def dog_age(years):\n    \"\"\"\n    Calculates a dog's age in dog years using a specific formula.\n    The first two human years count as 10.5 dog years each, and subsequent years count as 4 dog years each.\n    \"\"\"\n    FIRST_TWO_RATE = 10.5\n    AFTER_RATE = 4.0\n\n    first_part_contribution = min(years, 2) * FIRST_TWO_RATE\n    after_part_contribution = max(0.0, years - 2) * AFTER_RATE\n\n    calculated_dog_years = first_part_contribution + after_part_contribution\n\n    # Return as an integer if the result is a whole number, otherwise round to two decimal places.\n    if float(calculated_dog_years).is_integer():\n        return int(calculated_dog_years)\n    else:\n        return round(calculated_dog_years, 2)"}
{"task_id": "Mbpp/261", "solution": "def division_elements(a, b):\n    \"\"\"\n    Performs element-wise division on two tuples of numbers.\n    Results are cast to int if they are mathematically integral.\n    \"\"\"\n    results = []\n    for i in range(len(a)):\n        result = a[i] / b[i]\n        if result == int(result):\n            results.append(int(result))\n        else:\n            results.append(result)\n    return tuple(results)"}
{"task_id": "Mbpp/262", "solution": "def split_two_parts(input_list: list, L: int) -> tuple[list, list]:\n    \"\"\"\n    Splits a list into two parts based on the given length L for the first part.\n    Returns the two resulting lists as a tuple.\n    \"\"\"\n    first_part = input_list[:L]\n    second_part = input_list[L:]\n    return (first_part, second_part)"}
{"task_id": "Mbpp/265", "solution": "def list_split(items, n):\n    \"\"\"\n    Splits a list into n sublists, distributing elements by index modulo n.\n    Elements are distributed in a round-robin fashion into the n resulting lists.\n    \"\"\"\n    result = [[] for _ in range(n)]\n    for idx, item in enumerate(items):\n        result[idx % n].append(item)\n    return result"}
