{"task_id": "Mbpp/19", "solution": "def test_duplicate(array: list) -> bool:\n    \"\"\"\n    Checks if the given array of integers contains any duplicate element.\n    Uses a set to track seen elements for O(n) average time complexity.\n    \"\"\"\n    seen = set()\n    for element in array:\n        if element in seen:\n            return True\n        seen.add(element)\n    return False"}
{"task_id": "Mbpp/56", "solution": "def check(n: int) -> bool:\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    The reverse operation is performed on the absolute value of the number.\n    \"\"\"\n\n    def _reverse_int(num: int) -> int:\n        \"\"\"\n        Reverses the digits of a non-negative integer, dropping leading zeros.\n        \"\"\"\n        s = str(num)\n        rev_s = s[::-1]\n        return int(rev_s)\n\n    abs_n = abs(n)\n    reversed_abs_n = _reverse_int(abs_n)\n    \n    return n == (2 * reversed_abs_n - 1)"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base, height, length):\n    \"\"\"Calculates the volume of a triangular prism.\n    The volume is determined by the formula: V = (0.5 * base * height) * length.\n    \"\"\"\n    base_area = 0.5 * base * height\n    volume = base_area * length\n    return volume"}
{"task_id": "Mbpp/18", "solution": "import unicodedata\ndef remove_dirty_chars(input_text: str, filter_text: str, normalize: bool = False) -> str:\n    \"\"\"\n    Removes characters from the first string which are present in the second string.\n    If `normalize` is True, character comparison is done after Unicode NFKC normalization.\n    \"\"\"\n\n    # Helper function for Unicode NFKC normalization, as per utils.normalize_text in design.\n    def _normalize_text_inline(text: str) -> str:\n        return unicodedata.normalize(\"NFKC\", text)\n\n    # Build the set of characters to be removed from the filter_text.\n    # If normalization is requested, the filter_text is normalized before building the set.\n    removal_set_source = filter_text\n    if normalize:\n        removal_set_source = _normalize_text_inline(filter_text)\n    \n    # Use a set for efficient O(1) average time complexity lookups.\n    removal_set = set(removal_set_source)\n\n    # Iterate through the input_text and build the cleaned string.\n    out_chars = []\n    for char_from_input in input_text:\n        char_for_comparison = char_from_input\n        # If normalization is requested, normalize the current character from input_text\n        # for comparison with the removal set, but append the original character if it's kept.\n        if normalize:\n            char_for_comparison = _normalize_text_inline(char_from_input)\n        \n        # If the character (or its normalized form) is not in the removal set, keep it.\n        if char_for_comparison not in removal_set:\n            out_chars.append(char_from_input)\n            \n    return \"\".join(out_chars)"}
{"task_id": "Mbpp/20", "solution": "from typing import Optional\n_DEFAULT_MAX_N = 64\nclass _MathUtils:\n    \"\"\"Provides utility methods for mathematical operations.\"\"\"\n    @staticmethod\n    def compute_woodall(n: int) -> int:\n        \"\"\"Computes the Woodall number for a given positive integer n.\"\"\"\n        return n * (2 ** n) - 1\nclass _CacheRepository:\n    \"\"\"Manages an in-memory cache for Woodall numbers.\"\"\"\n    def __init__(self) -> None:\n        self._cache: dict[int, int] = {}\n\n    def get(self, value: int) -> Optional[int]:\n        \"\"\"Retrieves the 'n' for a given Woodall number from the cache.\"\"\"\n        return self._cache.get(value)\n\n    def set(self, value: int, n: int) -> None:\n        \"\"\"Stores a Woodall number and its 'n' in the cache.\"\"\"\n        self._cache[value] = n\nclass _WoodallService:\n    \"\"\"Encapsulates the core logic for determining Woodall numbers.\"\"\"\n    def __init__(self, cache_repo: '_CacheRepository', max_n: int) -> None:\n        self._cache_repo = cache_repo\n        self._max_n = max_n\n\n    def is_woodall(self, value: int) -> bool:\n        \"\"\"Checks if the given number is a Woodall number.\"\"\"\n        return self.find_n(value) is not None\n\n    def find_n(self, value: int) -> Optional[int]:\n        \"\"\"Searches for the 'n' corresponding to a Woodall number, using cache.\"\"\"\n        cached_n = self._cache_repo.get(value)\n        if cached_n is not None:\n            return cached_n\n\n        found_n = self._search(value)\n        if found_n is not None:\n            self._cache_repo.set(value, found_n)\n        return found_n\n\n    def _search(self, value: int) -> Optional[int]:\n        \"\"\"Performs a bounded search for 'n' that satisfies the Woodall number formula.\"\"\"\n        for n in range(1, self._max_n + 1):\n            computed_value = _MathUtils.compute_woodall(n)\n            if computed_value == value:\n                return n\n            if computed_value > value:\n                # Woodall numbers n * 2^n - 1 are strictly increasing for n >= 1.\n                break\n        return None\n_default_cache_repo = _CacheRepository()\n_default_woodall_service = _WoodallService(_default_cache_repo, _DEFAULT_MAX_N)\ndef is_woodall(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number.\n    A Woodall number is defined as n * 2^n - 1 for some positive integer n.\n    \"\"\"\n    return _default_woodall_service.is_woodall(number)"}
{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits):\n    \"\"\"Sorts digits in descending order and concatenates them to form the largest possible number.\"\"\"\n    sorted_digits = sorted(digits, reverse=True)\n    \n    result = 0\n    for digit in sorted_digits:\n        result = result * 10 + digit\n    \n    return result"}
{"task_id": "Mbpp/58", "solution": "def opposite_Signs(a, b):\n    \"\"\"Checks if two integers have opposite signs, treating zero as non-negative.\n    Returns True if exactly one of the numbers is negative.\n    \"\"\"\n    return (a < 0 and b >= 0) or (a >= 0 and b < 0)"}
{"task_id": "Mbpp/63", "solution": "from typing import Iterable, Tuple\ndef max_difference(pairs: Iterable[Tuple[int, int]]) -> int:\n    \"\"\"\n    Finds the maximum absolute difference between the elements within any single pair\n    in a list of 2-integer tuples.\n    \"\"\"\n    max_diff_overall = 0\n    for a, b in pairs:\n        current_diff = abs(a - b)\n        if current_diff > max_diff_overall:\n            max_diff_overall = current_diff\n    return max_diff_overall"}
