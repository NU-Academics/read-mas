{"task_id": "Mbpp/630", "solution": "def get_coordinates(coord: tuple[int, int]) -> list[list[int]]:\n    \"\"\"\n    Extracts all 9 adjacent coordinates of the given coordinate tuple, including itself.\n    Coordinates are returned in row-major order: x-1,x,x+1 then y-1,y,y+1.\n    \"\"\"\n    x, y = coord\n    adjacent_coords = []\n    for dx in range(-1, 2):  # -1, 0, 1\n        for dy in range(-1, 2):  # -1, 0, 1\n            adjacent_coords.append([x + dx, y + dy])\n    return adjacent_coords"}
{"task_id": "Mbpp/629", "solution": "def Split(numbers):\n    \"\"\"\n    Public API function to find even numbers from a list of numbers.\n    This function orchestrates validation, core logic, and query caching.\n    \"\"\"\n    import datetime\n    import json\n    import logging\n    import os\n    import uuid\n    from typing import Any, Iterable, List, Optional\n\n    # Configure basic logging for repository errors\n    logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid input.\"\"\"\n        def __init__(self, message: str, invalid_index: Optional[int] = None, invalid_value: Optional[Any] = None) -> None:\n            super().__init__(message)\n            self.message = message\n            self.invalid_index = invalid_index\n            self.invalid_value = invalid_value\n\n    class Utils:\n        \"\"\"Utility methods for number validation and evenness checking.\"\"\"\n        @staticmethod\n        def is_even(n: int) -> bool:\n            \"\"\"Checks if a number is even.\"\"\"\n            return (n % 2) == 0\n\n        @staticmethod\n        def validate_numbers(numbers: Iterable[Any]) -> List[int]:\n            \"\"\"\n            Validates if the input is an iterable of numbers (int or integral float)\n            and converts them to a list of integers.\n            \"\"\"\n            try:\n                # Attempt to iterate to check if it's iterable\n                list(iter(numbers))\n            except TypeError:\n                raise InvalidInputError(\"Input is not iterable\")\n\n            validated = []\n            for idx, v in enumerate(numbers):\n                if isinstance(v, float) and v.is_integer():\n                    validated.append(int(v))\n                elif isinstance(v, int):\n                    validated.append(v)\n                else:\n                    raise InvalidInputError(\n                        \"Invalid element\", invalid_index=idx, invalid_value=v\n                    )\n            return validated\n\n    class EvenFinderService:\n        \"\"\"Service layer to encapsulate the business logic for finding even numbers.\"\"\"\n        def __init__(self, utils_instance):\n            self._utils = utils_instance\n\n        def get_even_numbers(self, numbers: List[int]) -> List[int]:\n            \"\"\"Filters a list of integers to return only even numbers.\"\"\"\n            return [n for n in numbers if self._utils.is_even(n)]\n\n    class QueryCacheRepository:\n        \"\"\"\n        Repository for storing the last query in memory, with optional file persistence.\n        \"\"\"\n        _last_query: Optional[dict] = None\n\n        def __init__(self, enable_file_persist: bool = False, file_path: Optional[str] = None) -> None:\n            self._persist_enabled = enable_file_persist\n            self._file_path = file_path or \"evenfinder_cache.json\"\n            if self._persist_enabled and os.path.exists(self._file_path):\n                try:\n                    with open(self._file_path, 'r') as f:\n                        data = json.load(f)\n                        self._last_query = data.get(\"last_query\")\n                except Exception as e:\n                    logging.error(f\"Failed to load cache from {self._file_path}: {e}\")\n                    self._last_query = None\n\n        def save_query(self, query_id: str, input_numbers: List[int], result: List[int]) -> None:\n            \"\"\"Saves the current query details.\"\"\"\n            record = {\n                \"query_id\": query_id,\n                \"input\": input_numbers,\n                \"result\": result,\n                \"timestamp\": datetime.datetime.now(datetime.timezone.utc).isoformat()\n            }\n            QueryCacheRepository._last_query = record\n            if self._persist_enabled:\n                self._persist_to_file(record)\n\n        def get_last_query(self) -> Optional[dict]:\n            \"\"\"Retrieves the last saved query record.\"\"\"\n            return QueryCacheRepository._last_query\n\n        def _persist_to_file(self, record: dict) -> None:\n            \"\"\"Internal method to write the record to a JSON file.\"\"\"\n            try:\n                with open(self._file_path, 'w') as f:\n                    json.dump({\"last_query\": record}, f, indent=2)\n            except Exception as e:\n                logging.error(f\"Failed to persist cache to {self._file_path}: {e}\")\n\n    class ListSplitterController:\n        \"\"\"Controller to orchestrate the process of splitting a list.\"\"\"\n        def __init__(self, service_instance, repo_instance):\n            self._service = service_instance\n            self._repo = repo_instance\n            self._utils = Utils # Direct access for validation\n\n        def split(self, numbers: Any) -> List[int]:\n            \"\"\"\n            Validates input, finds even numbers, and saves the query.\n            Raises InvalidInputError for invalid inputs.\n            \"\"\"\n            validated_numbers = self._utils.validate_numbers(numbers)\n            even_numbers = self._service.get_even_numbers(validated_numbers)\n            \n            query_id = str(uuid.uuid4())\n            self._repo.save_query(query_id, validated_numbers, even_numbers)\n            \n            return even_numbers\n\n        def get_last_query(self) -> Optional[dict]:\n            \"\"\"Retrieves the last query from the repository.\"\"\"\n            return self._repo.get_last_query()\n\n    # --- Global/Module-level setup for the public Split function ---\n    # These instances are created once when the module is imported\n    _utils_instance = Utils()\n    _even_finder_service_instance = EvenFinderService(utils_instance=_utils_instance)\n    _query_cache_repo_instance = QueryCacheRepository(\n        enable_file_persist=False, # DEFAULT_CACHE_ENABLED from config.py is False\n        file_path=\"evenfinder_cache.json\" # CACHE_FILE_PATH from config.py\n    )\n    _list_splitter_controller_instance = ListSplitterController(\n        service_instance=_even_finder_service_instance,\n        repo_instance=_query_cache_repo_instance\n    )\n\n    # Call the controller's split method\n    return _list_splitter_controller_instance.split(numbers)"}
{"task_id": "Mbpp/631", "solution": "import re\ndef replace_spaces(text: str, collapse_multiple: bool = True) -> str:\n    \"\"\"\n    Replaces whitespace characters with an underscore.\n    If `collapse_multiple` is True, consecutive whitespaces are replaced by a single underscore.\n    \"\"\"\n    if collapse_multiple:\n        return re.sub(r'\\s+', '_', text)\n    else:\n        return \"\".join(\"_\" if ch.isspace() else ch for ch in text)"}
{"task_id": "Mbpp/632", "solution": "from typing import List\ndef move_zero(nums: List[int]) -> List[int]:\n    \"\"\"\n    Moves all zeroes to the end of the given list while preserving the relative order of non-zero elements.\n    Returns a new list with the modified order.\n    \"\"\"\n    arr = list(nums)\n    non_zero_ptr = 0\n\n    # Iterate through the array with 'current_ptr'\n    for current_ptr in range(len(arr)):\n        # If the element at 'current_ptr' is non-zero, swap it with the element at 'non_zero_ptr'\n        # and then increment 'non_zero_ptr'\n        if arr[current_ptr] != 0:\n            arr[non_zero_ptr], arr[current_ptr] = arr[current_ptr], arr[non_zero_ptr]\n            non_zero_ptr += 1\n\n    return arr"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(nums, n):\n    \"\"\"\n    Finds the sum of XOR of all unique pairs of numbers in the given list using a bitwise counting approach.\n    The optional 'n' parameter is ignored as the length of 'nums' is used directly for calculation.\n    \"\"\"\n    num_elements = len(nums)\n\n    if num_elements < 2:\n        return 0\n\n    total_xor_sum = 0\n\n    # Determine the maximum number of bits needed to represent any number's absolute value.\n    # This ensures all relevant bit positions are checked for both positive and negative integers.\n    max_val_abs = 0\n    if nums:\n        max_val_abs = max(abs(x) for x in nums)\n    \n    # We add 1 to bit_length to ensure we check all necessary bits, especially for\n    # numbers that are powers of 2 minus 1 (e.g., 7 needs 3 bits, but max for its bit_length is 3 for bit 2)\n    # or for robust handling of negative numbers where the sign bit might be effectively\n    # higher than magnitude's bit_length.\n    num_bits = max_val_abs.bit_length() + 1 \n\n    # Iterate through each bit position from 0 up to num_bits - 1\n    for b in range(num_bits):\n        # Calculate the mask for the current bit position (2^b)\n        mask = 1 << b\n        \n        # Count how many numbers in the list have the 'b'-th bit set\n        count_set_bit = 0\n        for num in nums:\n            if (num & mask) != 0:\n                count_set_bit += 1\n        \n        # The number of pairs where the 'b'-th bit will be 1 in their XOR sum is\n        # (count of numbers with 'b'-th bit set) * (count of numbers with 'b'-th bit unset)\n        # Each such pair contributes (1 << b) to the total XOR sum for this bit position.\n        count_unset_bit = num_elements - count_set_bit\n        total_xor_sum += count_set_bit * count_unset_bit * mask\n\n    return total_xor_sum"}
{"task_id": "Mbpp/635", "solution": "def sift_down(arr, start, end):\n    \"\"\"\n    Sifts an element down in a max-heap to maintain the heap property.\n    This helper is used by build_max_heap and the main heap_sort process.\n    \"\"\"\n    root = start\n    while True:\n        child = 2 * root + 1\n        if child > end:\n            break\n        swap = root\n        if arr[swap] < arr[child]:\n            swap = child\n        if child + 1 <= end and arr[swap] < arr[child + 1]:\n            swap = child + 1\n        if swap == root:\n            return\n        arr[root], arr[swap] = arr[swap], arr[root]\n        root = swap\ndef heap_sort(items):\n    \"\"\"\n    Sorts a list of comparable items using the heap sort algorithm.\n    Returns a new sorted list, leaving the original list unchanged.\n    \"\"\"\n    arr = list(items)\n    n = len(arr)\n\n    if n <= 1:\n        return arr\n\n    build_max_heap(arr)\n\n    end = n - 1\n    while end > 0:\n        arr[0], arr[end] = arr[end], arr[0]\n        end -= 1\n        sift_down(arr, 0, end)\n\n    return arr"}
{"task_id": "Mbpp/638", "solution": "class ValidationError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass _WindChillValidator:\n    \"\"\"Handles validation of wind velocity and temperature inputs.\"\"\"\n    def __init__(self, min_wind_kmh: float = 0.0):\n        self._min_wind_kmh = float(min_wind_kmh)\n\n    def validate_wind_and_temp(self, wind_kmh: float, temp_c: float) -> tuple[float, float]:\n        \"\"\"Validates inputs for numeric type and range.\"\"\"\n        try:\n            wind = float(wind_kmh)\n            temp = float(temp_c)\n        except (TypeError, ValueError):\n            raise ValidationError(\"wind_kmh and temp_c must be numeric\")\n        if wind < self._min_wind_kmh:\n            raise ValidationError(\"wind_kmh must be >= 0\")\n        return wind, temp\nclass _WindChillCalculator:\n    \"\"\"Computes the wind chill index using the standard formula.\"\"\"\n    def __init__(self, A: float = 13.12, B: float = 0.6215, C: float = -11.37, D: float = 0.3965):\n        self._A = A; self._B = B; self._C = C; self._D = D\n\n    def compute(self, wind_kmh: float, temp_c: float) -> float:\n        \"\"\"Applies the wind chill formula to calculate apparent temperature.\"\"\"\n        v_pow = wind_kmh ** 0.16\n        return self._A + self._B * temp_c + self._C * v_pow + self._D * temp_c * v_pow\ndef _round_int(value: float) -> int:\n    \"\"\"Rounds a float value to the nearest integer.\"\"\"\n    return int(round(value))\nclass _WindChillResult:\n    \"\"\"Stores the raw and rounded wind chill calculation results.\"\"\"\n    def __init__(self, app_temp: float, rounded: int):\n        self.app_temp = float(app_temp)\n        self.rounded = int(rounded)\n\n    def to_int(self) -> int:\n        \"\"\"Returns the rounded integer value.\"\"\"\n        return self.rounded\n_validator_instance = _WindChillValidator()\n_calculator_instance = _WindChillCalculator()\ndef wind_chill(wind_kmh: float, temp_c: float) -> int:\n    \"\"\"\n    Calculates the wind chill index rounded to the nearest integer.\n    Requires wind velocity in km/h and temperature in celsius.\n    \"\"\"\n    wind, temp = _validator_instance.validate_wind_and_temp(wind_kmh, temp_c)\n    raw_app_temp = _calculator_instance.compute(wind, temp)\n    rounded_app_temp = _round_int(raw_app_temp)\n    result = _WindChillResult(app_temp=raw_app_temp, rounded=rounded_app_temp)\n    return result.rounded"}
{"task_id": "Mbpp/637", "solution": "DEFAULT_TOLERANCE = 1e-9\ndef noprofit_noloss(cost_price: float, selling_price: float, tolerance: float = DEFAULT_TOLERANCE) -> bool:\n    \"\"\"\n    Checks if the selling price is equal to the cost price within a given tolerance.\n    This accounts for potential floating-point inaccuracies.\n    \"\"\"\n    return abs(cost_price - selling_price) <= float(tolerance)"}
{"task_id": "Mbpp/639", "solution": "from typing import List\nclass ProcessingError(Exception):\n    \"\"\"Exception raised for unexpected processing failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass NameModel:\n    \"\"\"Value object representing a name string.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value: str = value\n\n    def __str__(self) -> str:\n        return self.value\n\n    def __len__(self) -> int:\n        return len(self.value)\nclass NameFilter:\n    \"\"\"Encapsulates the rule for keeping or discarding a name.\"\"\"\n    def should_keep(self, name: NameModel) -> bool:\n        v = name.value\n        if not v:\n            return False\n        first = v[0]\n        return not self.is_start_lowercase(first)\n\n    def is_start_lowercase(self, ch: str) -> bool:\n        \"\"\"Checks if a character is an ASCII lowercase letter.\"\"\"\n        return 'a' <= ch <= 'z'\nclass NameRepository:\n    \"\"\"Provides methods to create NameModel lists from various sources.\"\"\"\n    @staticmethod\n    def from_list(names: List[str]) -> List[NameModel]:\n        \"\"\"Converts a list of strings into a list of NameModel objects.\"\"\"\n        models = []\n        for name_item in names:\n            models.append(NameModel(name_item))\n        return models\nclass NameSummator:\n    \"\"\"Business logic to filter names and sum their lengths.\"\"\"\n    def __init__(self, filter: NameFilter = None) -> None:\n        self._filter = filter or NameFilter()\n\n    def compute_sum_from_strings(self, names: List[str]) -> int:\n        \"\"\"Processes a list of raw name strings and sums lengths.\"\"\"\n        models = NameRepository.from_list(names)\n        return self.compute_sum_from_models(models)\n\n    def compute_sum_from_models(self, names: List[NameModel]) -> int:\n        \"\"\"Filters a list of NameModel objects and sums lengths.\"\"\"\n        try:\n            total = 0\n            for nm in names:\n                if self._filter.should_keep(nm):\n                    total += len(nm)\n            return total\n        except Exception as exc:\n            raise ProcessingError(str(exc)) from exc\n_default_summator = NameSummator()\ndef sample_nam(names: list) -> int:\n    \"\"\"\n    Public function: sums lengths after removing names starting with lowercase letter.\n    This function processes the input list and returns the total length.\n    \"\"\"\n    return _default_summator.compute_sum_from_strings(names)"}
{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(text: str) -> bool:\n    \"\"\"\n    Checks if a string contains 'z' (case-insensitive) in the middle of any word.\n    A 'z' is considered in the middle if its index is not 0 and not len(word)-1.\n    \"\"\"\n    import re\n    # The default token regex from AppConfig.DEFAULT_TOKEN_REGEX = r\"[^\\W_]+\"\n    # This matches sequences of Unicode letters and digits, effectively splitting words\n    # on whitespace, punctuation, hyphens, etc.\n    word_pattern = re.compile(r\"[^\\W_]+\", flags=re.UNICODE)\n\n    for match in word_pattern.finditer(text):\n        word = match.group(0)\n        # A word must be at least 3 characters long for a 'z' to be in the middle\n        if len(word) >= 3:\n            # Check characters from index 1 up to (but not including) len(word) - 1\n            for i in range(1, len(word) - 1):\n                if word[i].lower() == 'z':\n                    return True\n    return False"}
{"task_id": "Mbpp/641", "solution": "def is_nonagonal(x: int) -> bool:\n    \"\"\"\n    Checks if a given integer x is a nonagonal number.\n    Returns True if x is a nonagonal number, False otherwise.\n    \"\"\"\n    # For a nonagonal number N(n) = (7n^2 - 5n) / 2, we want to solve for n:\n    # 2x = 7n^2 - 5n\n    # 7n^2 - 5n - 2x = 0\n    # Using the quadratic formula n = (-b +/- sqrt(b^2 - 4ac)) / 2a\n    # Here, a=7, b=-5, c=-2x\n    # n = (5 +/- sqrt((-5)^2 - 4 * 7 * (-2x))) / (2 * 7)\n    # n = (5 +/- sqrt(25 + 56x)) / 14\n\n    discriminant = 25 + 56 * x\n\n    if discriminant < 0:\n        return False\n\n    import math\n    sqrt_discriminant = math.isqrt(discriminant)\n\n    if sqrt_discriminant * sqrt_discriminant != discriminant:\n        return False # Discriminant is not a perfect square\n\n    # We only care about the positive root for n >= 1\n    n_numerator = 5 + sqrt_discriminant\n\n    if n_numerator % 14 != 0:\n        return False\n\n    n = n_numerator // 14\n\n    return n >= 1"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(arr, k):\n    \"\"\"\n    Reverses the first 'k' elements of an array, returning a new list.\n    The original array remains unchanged.\n    \"\"\"\n    result = list(arr)\n    left, right = 0, k - 1\n    while left < right:\n        result[left], result[right] = result[right], result[left]\n        left += 1\n        right -= 1\n    return result"}
