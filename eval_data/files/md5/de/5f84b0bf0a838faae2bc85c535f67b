{"task_id": "Mbpp/267", "solution": "def square_Sum(n):\n    \"\"\"\n    Calculates the sum of the squares of the first n odd natural numbers.\n    Uses a closed-form formula for efficiency.\n    \"\"\"\n    # The sum of the squares of the first n odd numbers (1, 3, 5, ..., 2n-1)\n    # is given by the formula n * (2n - 1) * (2n + 1) / 3.\n    # This simplifies to n * (4n^2 - 1) / 3.\n    return n * (4 * n * n - 1) // 3"}
{"task_id": "Mbpp/260", "solution": "import os\nfrom datetime import datetime\nfrom typing import Optional, Tuple, Dict, Any, Iterator, List, Union\nclass NotPrimeError(Exception):\n    \"\"\"Raised when an NSW number at a given index is not prime.\"\"\"\n    pass\nclass LimitExceededError(Exception):\n    \"\"\"Raised when a search for an nth prime exceeds a configured maximum index.\"\"\"\n    pass\nclass NSWNumber:\n    \"\"\"Data model for a Newman\u2013Shanks\u2013Williams number with primality status.\"\"\"\n    def __init__(self, index: int, value: int, is_prime: bool, computed_at: datetime):\n        self.index = index\n        self.value = value\n        self.is_prime = is_prime\n        self.computed_at = computed_at\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Serializes the NSWNumber to a dictionary for storage or API response.\"\"\"\n        return {\n            \"index\": self.index,\n            \"value\": str(self.value),\n            \"is_prime\": self.is_prime,\n            \"computed_at\": self.computed_at.isoformat(),\n        }\ndef timestamputc() -> datetime:\n    \"\"\"Returns the current UTC datetime.\"\"\"\n    return datetime.utcnow()\nclass SQLiteAdapter:\n    \"\"\"A simplified in-memory adapter for caching, simulating SQLite persistence.\"\"\"\n    def __init__(self, db_path: str):\n        self.db_path = db_path\n        self._cache_data: Dict[int, NSWNumber] = {}\n\n    def ensure_schema(self) -> None:\n        \"\"\"Ensures the cache schema exists (no-op for in-memory).\"\"\"\n        pass\n\n    def fetch(self, index: int) -> Optional[Dict[str, Any]]:\n        \"\"\"Retrieves an NSWNumber from the in-memory cache by index.\"\"\"\n        nsw_num = self._cache_data.get(index)\n        return nsw_num.to_dict() if nsw_num else None\n\n    def upsert(self, nsw: NSWNumber) -> None:\n        \"\"\"Inserts or updates an NSWNumber in the in-memory cache.\"\"\"\n        self._cache_data[nsw.index] = nsw\n\n    def get_highest_index(self) -> int:\n        \"\"\"Returns the highest index currently stored in the cache, or -1 if empty.\"\"\"\n        return max(self._cache_data.keys()) if self._cache_data else -1\nclass CacheRepository:\n    \"\"\"High-level cache API for NSW numbers, delegating to a DB adapter.\"\"\"\n    def __init__(self, db_adapter: SQLiteAdapter):\n        self.db_adapter = db_adapter\n        self.db_adapter.ensure_schema()\n\n    def get_by_index(self, index: int) -> Optional[NSWNumber]:\n        \"\"\"Retrieves an NSW number from the cache by its index.\"\"\"\n        data = self.db_adapter.fetch(index)\n        if data:\n            return NSWNumber(\n                index=data['index'],\n                value=int(data['value']),\n                is_prime=data['is_prime'],\n                computed_at=datetime.fromisoformat(data['computed_at'])\n            )\n        return None\n\n    def insert(self, nsw: NSWNumber) -> None:\n        \"\"\"Inserts or updates an NSW number in the cache.\"\"\"\n        self.db_adapter.upsert(nsw)\n\n    def get_prime_indices(self, limit: int) -> Iterator[NSWNumber]:\n        \"\"\"Yields cached NSW prime numbers up to a given limit.\"\"\"\n        primes_found = 0\n        for index in sorted(self.db_adapter._cache_data.keys()):\n            nsw = self.db_adapter._cache_data[index]\n            if nsw.is_prime:\n                yield nsw\n                primes_found += 1\n                if primes_found >= limit:\n                    break\nclass PrimeService:\n    \"\"\"Provides primality testing for integers.\"\"\"\n    def __init__(self):\n        # Bases for deterministic Miller-Rabin for numbers < 3.4 * 10^15\n        self._deterministic_bases = [2, 3, 5, 7, 11, 13, 17]\n\n    def _miller_rabin(self, n: int) -> bool:\n        \"\"\"Performs a deterministic Miller-Rabin primality test for certain ranges.\"\"\"\n        if n < 2: return False\n        if n in (2, 3): return True\n        if n % 2 == 0: return False\n\n        s = 0\n        d = n - 1\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n\n        for a in self._deterministic_bases:\n            if a >= n:\n                continue\n            x = pow(a, d, n)\n            if x == 1 or x == n - 1:\n                continue\n            for _ in range(s - 1):\n                x = pow(x, 2, n)\n                if x == n - 1:\n                    break\n            else:\n                return False\n        return True\n\n    def is_prime(self, value: int) -> bool:\n        \"\"\"Checks if a given integer is prime.\"\"\"\n        return self._miller_rabin(value)\nclass NSWService:\n    \"\"\"Generates Newman\u2013Shanks\u2013Williams numbers and finds NSW primes.\"\"\"\n    def __init__(self, cache_repo: CacheRepository, prime_service: PrimeService, max_index: int = 100_000):\n        self.cache_repo = cache_repo\n        self.prime_service = prime_service\n        self.max_index = max_index\n\n    def nth_term(self, index: int) -> int:\n        \"\"\"Computes the n-th term of the Newman\u2013Shanks\u2013Williams sequence.\"\"\"\n        if not isinstance(index, int) or index < 0:\n            raise ValueError(\"index must be a non-negative integer.\")\n        if index in (0, 1):\n            return 1\n        a, b = 1, 1\n        for _ in range(2, index + 1):\n            a, b = b, 2 * b + a\n        return b\n\n    def newman_prime(self, index: int) -> int:\n        \"\"\"Returns the NSW number at index if it is prime, otherwise raises NotPrimeError.\"\"\"\n        if not isinstance(index, int) or index < 0:\n            raise ValueError(\"index must be a non-negative integer.\")\n\n        cached = self.cache_repo.get_by_index(index)\n        if cached:\n            if cached.is_prime:\n                return cached.value\n            raise NotPrimeError(f\"S({index}) is not prime\")\n\n        value = self.nth_term(index)\n        is_p = self.prime_service.is_prime(value)\n\n        self.cache_repo.insert(NSWNumber(index=index, value=value, is_prime=is_p, computed_at=timestamputc()))\n\n        if not is_p:\n            raise NotPrimeError(f\"S({index}) is not prime\")\n        return value\n\n    def nth_newman_prime(self, n: int, max_index: Optional[int] = None) -> int:\n        \"\"\"Finds the n-th NSW prime number (1-based).\"\"\"\n        if n < 1:\n            raise ValueError(\"n must be a positive integer (1-based).\")\n\n        current_max_index = max_index if max_index is not None else self.max_index\n        primes_found = 0\n        found_prime_value = None\n\n        for cached_nsw_prime in self.cache_repo.get_prime_indices(n):\n            primes_found += 1\n            if primes_found == n:\n                found_prime_value = cached_nsw_prime.value\n                break\n        \n        if found_prime_value:\n            return found_prime_value\n\n        start_idx = self.cache_repo.db_adapter.get_highest_index() + 1\n        if start_idx < 0:\n            start_idx = 0\n        \n        current_idx = start_idx\n        while primes_found < n:\n            if current_idx > current_max_index:\n                raise LimitExceededError(f\"Search for {n}-th prime exceeded max_index {current_max_index} at index {current_idx}.\")\n\n            cached_nsw = self.cache_repo.get_by_index(current_idx)\n            if cached_nsw:\n                if cached_nsw.is_prime:\n                    primes_found += 1\n                    if primes_found == n:\n                        return cached_nsw.value\n            else:\n                value = self.nth_term(current_idx)\n                is_p = self.prime_service.is_prime(value)\n                self.cache_repo.insert(NSWNumber(index=current_idx, value=value, is_prime=is_p, computed_at=timestamputc()))\n                if is_p:\n                    primes_found += 1\n                    if primes_found == n:\n                        return value\n            current_idx += 1\n        \n        raise LimitExceededError(f\"Could not find the {n}-th prime within the allowed search space.\")\n_nsw_service_instance: Optional[NSWService] = None\ndef _create_default_services(db_path: Optional[str] = None) -> Tuple[NSWService, PrimeService, CacheRepository]:\n    \"\"\"\n    Creates and returns default instances of NSWService, PrimeService, and CacheRepository.\n    Uses an in-memory adapter as a fallback for the provided context.\n    \"\"\"\n    actual_db_path = os.path.expanduser(db_path or \"~/.nswprime/cache.db\")\n    \n    db_adapter = SQLiteAdapter(actual_db_path)\n    \n    cache_repo = CacheRepository(db_adapter=db_adapter)\n    prime_service = PrimeService()\n    nsw_service = NSWService(cache_repo=cache_repo, prime_service=prime_service)\n    return nsw_service, prime_service, cache_repo\ndef newman_prime(index: int) -> int:\n    \"\"\"\n    Finds the Newman\u2013Shanks\u2013Williams number at the given index.\n    If the number is prime, it is returned; otherwise, NotPrimeError is raised.\n    \"\"\"\n    global _nsw_service_instance\n    if _nsw_service_instance is None:\n        _nsw_service_instance, _, _ = _create_default_services()\n    \n    return _nsw_service_instance.newman_prime(index)"}
