{"task_id": "Mbpp/62", "solution": "def smallest_num(numbers):\n    \"\"\"\n    Finds the smallest number in a list of numbers.\n\n    This function assumes valid, non-empty input as per design context.\n    \"\"\"\n    if not numbers:\n        # This case would be handled by a validator in a full system\n        # but for this specific function, we assume non-empty.\n        return None # Or raise an error if this function were standalone\n    \n    min_val = numbers[0]\n    all_ints = True\n\n    # Check if the initial element is an int to determine if we should attempt\n    # to return an int at the end.\n    if not isinstance(min_val, int):\n        all_ints = False\n\n    for num in numbers[1:]:\n        if num < min_val:\n            min_val = num\n        \n        # Track if all numbers are integers\n        if not isinstance(num, int):\n            all_ints = False\n    \n    # Preserve integer return if all original inputs were integers\n    # and the minimum value is also an integer (e.g., 5.0 should return 5)\n    if all_ints and isinstance(min_val, float) and min_val.is_integer():\n        return int(min_val)\n    \n    return min_val"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts substrings where the sum of digits equals the substring's length.\n    This uses a prefix sum technique with a hashmap for O(n) time complexity.\n    \"\"\"\n    if not s:\n        return 0\n\n    # We are looking for substrings where sum(digits) == length.\n    # This is equivalent to sum(digit - 1) == 0 for all digits in the substring.\n    # We can use a prefix sum approach on these adjusted values.\n    \n    prefix_sum = 0\n    # Stores the frequency of each prefix sum encountered.\n    # Initialize with {0: 1} to account for subarrays that start from index 0\n    # and have a sum of 0 (meaning their total sum equals their length).\n    prefix_counts = {0: 1}\n    count = 0\n\n    for char_digit in s:\n        digit = int(char_digit)\n        prefix_sum += (digit - 1)\n        \n        # If this prefix_sum has been seen before, it means there's a subarray\n        # between the previous occurrence and the current index that sums to 0.\n        count += prefix_counts.get(prefix_sum, 0)\n        prefix_counts[prefix_sum] = prefix_counts.get(prefix_sum, 0) + 1\n\n    return count"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(data):\n    \"\"\"\n    Flattens a list, summing all numeric (int or float) elements.\n    Nested lists and tuples are processed recursively; other types are ignored.\n    \"\"\"\n    total_sum = 0.0\n    \n    def _flatten_and_sum_recursive(current_list):\n        nonlocal total_sum\n        for item in current_list:\n            if isinstance(item, (int, float)):\n                total_sum += item\n            elif isinstance(item, (list, tuple)):\n                _flatten_and_sum_recursive(item)\n\n    _flatten_and_sum_recursive(data)\n    \n    return total_sum"}
{"task_id": "Mbpp/64", "solution": "import json\nimport os\nfrom dataclasses import dataclass\nfrom datetime import datetime\nfrom typing import Any, List, Optional, Sequence, Tuple\nclass SubjectSortError(Exception):\n    \"\"\"Custom exception for errors during subject sorting or validation.\"\"\"\n    def __init__(self, message: str, cause: Optional[Exception] = None):\n        super().__init__(message)\n        self.message = message\n        self.cause = cause\n\n    def __str__(self) -> str:\n        if self.cause:\n            return f\"{self.message}: {type(self.cause).__name__}({self.cause})\"\n        return self.message\nclass Validator:\n    \"\"\"Validates the shape and basic types of input items and lists.\"\"\"\n    def validate_item(self, item: Any) -> None:\n        \"\"\"Validates a single item's basic structure (list/tuple of 2, or dict with name/mark).\"\"\"\n        if isinstance(item, (list, tuple)) and len(item) == 2:\n            if not isinstance(item[0], str):\n                raise SubjectSortError(\"Subject name (first element) must be a string.\")\n            return\n        if isinstance(item, dict) and \"name\" in item and \"mark\" in item:\n            if not isinstance(item[\"name\"], str):\n                raise SubjectSortError(\"Subject name (from dict) must be a string.\")\n            return\n        raise SubjectSortError(f\"Invalid item shape: {item!r}. Expected a 2-element list/tuple or a dict with 'name' and 'mark'.\")\n\n    def validate_list(self, items: Sequence[Any]) -> None:\n        \"\"\"Validates that the input is a sequence and all its items are valid.\"\"\"\n        if not isinstance(items, Sequence):\n            raise SubjectSortError(\"Input must be a sequence (e.g., list or tuple).\")\n        for i, item in enumerate(items):\n            try:\n                self.validate_item(item)\n            except SubjectSortError as e:\n                raise SubjectSortError(f\"Validation failed for item at index {i}: {e.message}\", e)\nclass TupleAdapter:\n    \"\"\"Adapts various input formats (tuple, dict) to SubjectMark and back to tuple.\"\"\"\n    def to_domain(self, item: Any) -> SubjectMark:\n        \"\"\"Converts an input item (tuple/list or dict) to a SubjectMark domain object.\"\"\"\n        if isinstance(item, (list, tuple)):\n            return SubjectMark.from_tuple(item)\n        elif isinstance(item, dict):\n            return SubjectMark.from_dict(item)\n        raise SubjectSortError(f\"Unsupported item type for conversion to SubjectMark: {type(item).__name__} ({item!r}).\")\n\n    def to_tuple(self, subject: SubjectMark) -> Tuple[str, int]:\n        \"\"\"Converts a SubjectMark domain object back to a (name, mark) tuple.\"\"\"\n        return subject.to_tuple()\nclass Config:\n    \"\"\"Configuration settings for the subject sorter.\"\"\"\n    PERSISTENCE_PATH: str = \"runs.json\"\n    STRICT_PERSISTENCE: bool = False\nclass SortRepository:\n    \"\"\"Abstract base class for persistence of run metadata.\"\"\"\n    def save_run(self, metadata: dict) -> None:\n        raise NotImplementedError\nclass JSONFileSortRepository(SortRepository):\n    \"\"\"Repository implementation for persisting run metadata to a JSON file.\"\"\"\n    def __init__(self, file_path: str):\n        self.file_path = file_path\n\n    def _read_runs(self) -> List[dict]:\n        if not os.path.exists(self.file_path):\n            return []\n        try:\n            with open(self.file_path, 'r', encoding='utf-8') as f:\n                content = f.read()\n                if not content:\n                    return []\n                return json.loads(content)\n        except json.JSONDecodeError as e:\n            raise SubjectSortError(f\"Corrupted persistence file {self.file_path}: {e}\", e)\n        except Exception as e:\n            raise SubjectSortError(f\"Failed to read persistence file {self.file_path}: {e}\", e)\n\n    def _write_runs(self, runs: List[dict]):\n        temp_path = self.file_path + \".tmp\"\n        try:\n            with open(temp_path, 'w', encoding='utf-8') as f:\n                json.dump(runs, f, indent=2)\n            os.replace(temp_path, self.file_path) # Atomic replacement (POSIX)\n        except Exception as e:\n            if os.path.exists(temp_path):\n                os.remove(temp_path)\n            raise SubjectSortError(f\"Failed to write to persistence file {self.file_path}: {e}\", e)\n\n    def save_run(self, metadata: dict) -> None:\n        try:\n            runs = self._read_runs()\n            runs.append(metadata)\n            self._write_runs(runs)\n        except SubjectSortError as e:\n            if Config.STRICT_PERSISTENCE:\n                raise e\n            pass\n        except Exception as e:\n            if Config.STRICT_PERSISTENCE:\n                raise SubjectSortError(f\"Unexpected error during persistence: {e}\", e)\n            pass\nclass SortService:\n    \"\"\"Core service for sorting subject marks, handling validation and persistence.\"\"\"\n    def __init__(self, repository: SortRepository, adapter: TupleAdapter, validator: Validator):\n        self.repository = repository\n        self.adapter = adapter\n        self.validator = validator\n\n    def sort_subjects(self, items: Sequence[Any]) -> List[Tuple[str, int]]:\n        \"\"\"Validates, converts, sorts, persists metadata, and returns sorted subject tuples.\"\"\"\n        self.validator.validate_list(items)\n        \n        domain = []\n        for i, item in enumerate(items):\n            try:\n                domain.append(self.adapter.to_domain(item))\n            except SubjectSortError as e:\n                raise SubjectSortError(f\"Error converting item at index {i} ({item!r}) to domain object: {e.message}\", e)\n\n        domain_sorted = sorted(domain, key=lambda s: s.mark)\n        result = [self.adapter.to_tuple(s) for s in domain_sorted]\n        \n        metadata = {\n            \"timestamp\": datetime.utcnow().isoformat(timespec='seconds') + \"Z\",\n            \"input_count\": len(items),\n            \"status\": \"ok\"\n        }\n        try:\n            self.repository.save_run(metadata)\n        except SubjectSortError:\n            if Config.STRICT_PERSISTENCE:\n                raise\n        except Exception as e:\n            if Config.STRICT_PERSISTENCE:\n                raise SubjectSortError(f\"Unexpected error during persistence of run metadata: {e}\", e)\n\n        return result\ndef subject_marks(subjects: List[Tuple[str, int]], repo: Optional[SortRepository] = None) -> List[Tuple[str, int]]:\n    \"\"\"\n    Sorts a list of subject-mark tuples using the second value (mark) of each tuple.\n    Input can contain various forms like tuples, lists, or dictionaries with 'name' and 'mark'.\n    \"\"\"\n    validator = Validator()\n    adapter = TupleAdapter()\n\n    if repo is None:\n        repository_instance = JSONFileSortRepository(Config.PERSISTENCE_PATH)\n    else:\n        repository_instance = repo\n\n    service = SortService(repository=repository_instance, adapter=adapter, validator=validator)\n    \n    try:\n        sorted_result = service.sort_subjects(subjects)\n    except SubjectSortError:\n        raise\n    except Exception as e:\n        raise SubjectSortError(f\"An unexpected error occurred during subject sorting: {e}\", e)\n\n    return sorted_result"}
{"task_id": "Mbpp/66", "solution": "def pos_count(numbers):\n    \"\"\"Counts the number of positive numbers in a list.\"\"\"\n    count = 0\n    for number in numbers:\n        if number > 0:\n            count += 1\n    return count"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(subject, pattern):\n    \"\"\"\n    Checks if a list contains the given sublist contiguously.\n    \"\"\"\n    n = len(subject)\n    m = len(pattern)\n\n    if m == 0:\n        return True  # An empty pattern is always considered a sublist.\n    if m > n:\n        return False # A pattern longer than the subject cannot be a sublist.\n\n    for i in range(n - m + 1):\n        if subject[i : i + m] == pattern:\n            return True\n    return False"}
{"task_id": "Mbpp/67", "solution": "import os\nimport json\nimport tempfile\nimport time\nfrom dataclasses import dataclass\nclass PersistenceError(IOError):\n    \"\"\"Exception raised for errors during cache persistence.\"\"\"\n    pass\nclass Config:\n    \"\"\"Holds runtime configuration for cache settings and limits.\"\"\"\n    def __init__(self, cache_enabled: bool = True, cache_file: str | None = None, max_n: int = 1000) -> None:\n        self.cache_enabled = cache_enabled\n        if cache_file is None:\n            cache_dir = os.path.join(os.path.expanduser(\"~\"), \".cache\", \"bell\")\n            self.cache_file = os.path.join(cache_dir, \"bell_cache_v1.json\")\n        else:\n            self.cache_file = cache_file\n        self.max_n = max_n\nclass FileRepository:\n    \"\"\"Manages reading and writing cache data to a JSON file.\"\"\"\n    def __init__(self, file_path: str) -> None:\n        self.file_path = file_path\n        ensure_cache_dir(self.file_path)\n\n    def read(self) -> dict[str, int]:\n        \"\"\"Reads cache data from the specified JSON file.\"\"\"\n        if not os.path.exists(self.file_path):\n            return {}\n        try:\n            with open(self.file_path, \"r\", encoding=\"utf-8\") as f:\n                data = json.load(f)\n            if not isinstance(data, dict):\n                raise PersistenceError(f\"Cache file '{self.file_path}' contains invalid data format.\")\n            return data\n        except (IOError, json.JSONDecodeError) as e:\n            raise PersistenceError(f\"Failed to read cache from '{self.file_path}': {e}\") from e\n\n    def write(self, data: dict[str, int]) -> None:\n        \"\"\"Writes cache data atomically to the specified JSON file.\"\"\"\n        try:\n            tmp_fd, tmp_path = tempfile.mkstemp(dir=os.path.dirname(self.file_path))\n            with os.fdopen(tmp_fd, \"w\", encoding=\"utf-8\") as f:\n                json.dump(data, f, indent=2)\n            os.replace(tmp_path, self.file_path)\n        except (IOError, OSError) as e:\n            raise PersistenceError(f\"Failed to write cache to '{self.file_path}': {e}\") from e\n\n    def exists(self) -> bool:\n        \"\"\"Checks if the cache file exists.\"\"\"\n        return os.path.exists(self.file_path)\nclass MemoizationCache:\n    \"\"\"In-memory cache for Bell numbers with optional persistence via a FileRepository.\"\"\"\n    def __init__(self, repository: FileRepository | None = None) -> None:\n        self._data: dict[int, int] = {}\n        self._repo = repository\n        if self._repo:\n            self.load()\n\n    def get(self, n: int) -> int | None:\n        \"\"\"Retrieves a Bell number from the cache.\"\"\"\n        return self._data.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a Bell number in the cache.\"\"\"\n        self._data[n] = value\n\n    def load(self) -> None:\n        \"\"\"Loads cache data from the file repository into memory.\"\"\"\n        if not self._repo:\n            return\n        try:\n            raw_data = self._repo.read()\n            self._data = {int(k): v for k, v in raw_data.items() if k.isdigit() and isinstance(v, int)}\n        except PersistenceError:\n            self._data = {}\n\n    def save(self) -> None:\n        \"\"\"Saves current in-memory cache data to the file repository.\"\"\"\n        if not self._repo:\n            return\n        try:\n            data_to_save = {str(k): v for k, v in self._data.items()}\n            self._repo.write(data_to_save)\n        except PersistenceError:\n            pass\n\n    def clear(self) -> None:\n        \"\"\"Clears the in-memory cache.\"\"\"\n        self._data.clear()\nclass BellCalculator:\n    \"\"\"Computes Bell numbers using the Bell triangle algorithm.\"\"\"\n    def __init__(self, cache: MemoizationCache | None = None, max_n: int = 1000) -> None:\n        self._cache = cache\n        self._max_n = max_n\n\n    def bell(self, n: int) -> int:\n        \"\"\"Calculates the nth Bell number, utilizing the cache if available.\"\"\"\n        if self._cache:\n            val = self._cache.get(n)\n            if val is not None:\n                return val\n        \n        value = self._bell_triangle(n)\n        \n        if self._cache:\n            self._cache.set(n, value)\n        return value\n\n    def _bell_triangle(self, n: int) -> int:\n        \"\"\"Implements the Bell triangle method for computing Bell numbers.\"\"\"\n        if n == 0:\n            return 1\n        \n        triangle = [[1]]\n        for i in range(1, n + 1):\n            row = [triangle[i - 1][-1]]\n            for j in range(1, i + 1):\n                row.append(row[j - 1] + triangle[i - 1][j - 1])\n            triangle.append(row)\n        return triangle[n][0]\nclass BellController:\n    \"\"\"Orchestrates Bell number computation, including validation, caching, and result packaging.\"\"\"\n    def __init__(self, calculator: BellCalculator, config: Config) -> None:\n        self._calculator = calculator\n        self._config = config\n\n    def get_bell(self, n: int) -> BellResult:\n        \"\"\"Retrieves the Bell number for a given n, applying validation and cache persistence.\"\"\"\n        validate_n(n, self._config.max_n)\n        \n        start_time = time.time()\n        value = self._calculator.bell(n)\n        \n        if self._config.cache_enabled and self._calculator._cache:\n            self._calculator._cache.save()\n            \n        return BellResult(n=n, value=value, computed_at=time.time() - start_time)\n_default_config = Config()\ndef create_controller(config: Config | None = None) -> BellController:\n    \"\"\"Factory function to create a BellController instance with the given or default configuration.\"\"\"\n    cfg = config or _default_config\n    \n    repo = None\n    if cfg.cache_enabled:\n        repo = FileRepository(cfg.cache_file)\n    \n    cache = MemoizationCache(repo)\n    calc = BellCalculator(cache, max_n=cfg.max_n)\n    return BellController(calc, cfg)\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Finds the number of ways to partition a set of size n, also known as the nth Bell number.\n    It utilizes a cached and optimized computation strategy.\n    \"\"\"\n    controller = create_controller()\n    result = controller.get_bell(n)\n    return result.value"}
{"task_id": "Mbpp/70", "solution": "def get_equal(items):\n    \"\"\"\n    Checks if all tuples in the given sequence have equal length.\n    Returns True for an empty sequence.\n    \"\"\"\n    if not items:\n        return True\n\n    first_length = len(items[0])\n    for tpl in items:\n        if len(tpl) != first_length:\n            return False\n    return True"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array):\n    \"\"\"\n    Checks if an array is monotonic (non-increasing or non-decreasing) in a single pass.\n    Handles empty and single-element arrays as monotonic.\n    \"\"\"\n    n = len(array)\n    if n <= 1:\n        return True\n\n    seen_increasing = False\n    seen_decreasing = False\n\n    for i in range(1, n):\n        if array[i] > array[i-1]:\n            seen_increasing = True\n        elif array[i] < array[i-1]:\n            seen_decreasing = True\n\n        # If both increasing and decreasing trends are observed, it's not monotonic.\n        if seen_increasing and seen_decreasing:\n            return False\n\n    return True"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(n):\n    \"\"\"\n    Checks if a number can be represented as the difference of two squares.\n    Uses the mathematical property that n can be represented as a^2 - b^2 iff n % 4 != 2.\n    \"\"\"\n    return (n % 4) != 2"}
{"task_id": "Mbpp/71", "solution": "from typing import List, TypeVar\nT = TypeVar(\"T\")\ndef comb_sort(data: List[T]) -> List[T]:\n    \"\"\"Sorts a list of elements using the Comb Sort algorithm.\"\"\"\n    arr = list(data)  # Create a copy to avoid mutating the original list\n    n = len(arr)\n    if n < 2:\n        return arr\n\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = max(1, int(gap / shrink_factor))\n        swapped = False\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/74", "solution": "from typing import Sequence, Dict\ndef is_samepatterns(colors: Sequence[str], pattern: Sequence[str]) -> bool:\n    \"\"\"\n    Checks if two sequences follow the same pattern mapping.\n    This involves creating a bijective mapping between elements of 'colors' and 'pattern'.\n    \"\"\"\n    if len(colors) != len(pattern):\n        return False\n\n    map_pattern_to_colors: Dict[str, str] = {}\n    map_colors_to_pattern: Dict[str, str] = {}\n\n    for color_token, pattern_token in zip(colors, pattern):\n        # Check consistency for pattern_token -> color_token mapping\n        if pattern_token in map_pattern_to_colors:\n            if map_pattern_to_colors[pattern_token] != color_token:\n                return False\n        else:\n            map_pattern_to_colors[pattern_token] = color_token\n\n        # Check consistency for color_token -> pattern_token mapping\n        if color_token in map_colors_to_pattern:\n            if map_colors_to_pattern[color_token] != pattern_token:\n                return False\n        else:\n            map_colors_to_pattern[color_token] = pattern_token\n\n    return True"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(input_tuples: list, k: int) -> list:\n    filtered_tuples = []\n    divisor = abs(k)\n\n    for tup in input_tuples:\n        # As per design, empty tuples are considered not divisible (excluded).\n        if not tup:\n            continue\n\n        all_elements_divisible = True\n        for element in tup:\n            if element % divisor != 0:\n                all_elements_divisible = False\n                break\n        \n        if all_elements_divisible:\n            filtered_tuples.append(tup)\n            \n    return filtered_tuples"}
{"task_id": "Mbpp/77", "solution": "def is_Diff(n: int) -> bool:\n    \"\"\"\n    Checks if an integer is divisible by 11 using the alternating sum of its digits.\n    The rule applies to the absolute value of the number.\n    \"\"\"\n    abs_n = abs(n)\n    \n    if abs_n == 0:\n        return True\n\n    digits = []\n    temp_n = abs_n\n    while temp_n > 0:\n        digits.append(temp_n % 10)\n        temp_n //= 10\n\n    odd_sum = sum(digits[i] for i in range(0, len(digits), 2))\n    even_sum = sum(digits[i] for i in range(1, len(digits), 2))\n    \n    difference = odd_sum - even_sum\n    return difference % 11 == 0"}
