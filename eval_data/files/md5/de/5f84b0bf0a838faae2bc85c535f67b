{"task_id": "Mbpp/398", "solution": "from typing import Any, Iterable, List, Optional, Tuple\nclass InvalidNumberError(Exception):\n    \"\"\"Exception raised for invalid numbers in the input list.\"\"\"\n    def __init__(self, message: str, invalid_items: Optional[List[Tuple[int, object]]] = None):\n        super().__init__(message)\n        self.invalid_items = invalid_items or []\n    def __str__(self):\n        base = super().__str__()\n        if self.invalid_items:\n            return f\"{base}: {self.invalid_items}\"\n        return base\ndef digit_sum_of_int(n: int) -> int:\n    \"\"\"Calculates the sum of the absolute digits of an integer.\"\"\"\n    n = abs(int(n))\n    s = 0\n    while n:\n        s += n % 10\n        n //= 10\n    return s\nclass Validator:\n    \"\"\"Utility class for validating and converting input numbers.\"\"\"\n    @staticmethod\n    def validate_numbers(numbers: Iterable[Any]) -> List[int]:\n        if not hasattr(numbers, \"__iter__\"):\n            raise InvalidNumberError(\"Input is not iterable\")\n        result = []\n        invalid = []\n        for idx, v in enumerate(numbers):\n            try:\n                if isinstance(v, int):\n                    result.append(v)\n                elif isinstance(v, str) and v.strip().lstrip(\"+-\").isdigit():\n                    result.append(int(v))\n                else:\n                    raise ValueError()\n            except Exception:\n                invalid.append((idx, v))\n        if invalid:\n            raise InvalidNumberError(\"Invalid items in input\", invalid)\n        return result\nclass DigitSumService:\n    \"\"\"Service class for computing digit sums.\"\"\"\n    @staticmethod\n    def compute_total(numbers: Iterable[int]) -> int:\n        total = 0\n        for n in numbers:\n            total += digit_sum_of_int(n)\n        return total\ndef sum_of_digits(numbers: list) -> int:\n    \"\"\"\n    Computes the sum of digits for each number in a given list and returns their total sum.\n    Numbers are validated to be integers or convertible strings.\n    \"\"\"\n    validated_numbers = Validator.validate_numbers(numbers)\n    return DigitSumService.compute_total(validated_numbers)"}
{"task_id": "Mbpp/406", "solution": "class ParityError(Exception):\n    def __init__(self, message: str, value=None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.value = value\n\n    def __str__(self) -> str:\n        return f\"{self.message} (value={self.value})\"\nclass NumberModel:\n    def __init__(self, value: int) -> None:\n        self._value = value\n\n    def get_value(self) -> int:\n        return self._value\nclass ParityService:\n    DEFAULT_MODULUS: int = 2\n\n    def is_odd(self, number: NumberModel) -> bool:\n        return number.get_value() % self.DEFAULT_MODULUS != 0\n\n    def is_even(self, number: NumberModel) -> bool:\n        return not self.is_odd(number)\nclass Validator:\n    ACCEPT_FLOAT_INT: bool = True\n\n    def validate(self, n) -> NumberModel:\n        if isinstance(n, int):\n            return NumberModel(n)\n        if isinstance(n, float) and self.ACCEPT_FLOAT_INT and n.is_integer():\n            return NumberModel(int(n))\n        if isinstance(n, str):\n            s = n.strip()\n            try:\n                return NumberModel(int(s))\n            except ValueError:\n                pass\n        raise ParityError(\"Invalid numeric input\", value=n)\nclass ParityController:\n    def __init__(self, validator: Validator, service: ParityService) -> None:\n        self._validator = validator\n        self._service = service\n\n    def find_Parity(self, n) -> bool:\n        number = self._validator.validate(n)\n        return self._service.is_odd(number)\n_controller = ParityController(Validator(), ParityService())\ndef find_Parity(n) -> bool:\n    \"\"\"\n    Determines if the parity of a given number is odd.\n    This function delegates to a robust internal architecture.\n    \"\"\"\n    return _controller.find_Parity(n)"}
