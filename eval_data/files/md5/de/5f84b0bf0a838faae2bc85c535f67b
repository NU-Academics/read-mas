{"task_id": "Mbpp/389", "solution": "def find_lucas(n):\n    \"\"\"\n    Computes the n'th Lucas number using an iterative approach.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    a, b = 2, 1  # Initialize with L0 and L1\n    for _ in range(2, n + 1):\n        a, b = b, a + b  # Update a and b for the next Lucas number\n    return b"}
{"task_id": "Mbpp/391", "solution": "from typing import Sequence, Any, Dict, List, Union\ndef convert_list_dictionary(*lists: Sequence[Any], output_as: str = \"list\") -> Union[List[Dict[str, Any]], Dict[str, Any]]:\n    \"\"\"\n    Converts multiple parallel lists into a nested dictionary structure.\n    The first list provides top-level keys, and subsequent lists form nested mappings.\n    \"\"\"\n    def _build_nested_value_for_row(elements: Sequence[Any]) -> Any:\n        \"\"\"Helper to build the nested dictionary for a single row of non-key elements.\"\"\"\n        if not elements:\n            return None \n        if len(elements) == 1:\n            return elements[0]\n\n        nested_result = elements[-1]\n        for val in reversed(elements[:-1]):\n            nested_result = {val: nested_result}\n        return nested_result\n\n    # Per design, minimum of two lists is expected, and all lists should have equal length.\n    # The prompt explicitly forbids adding isinstance() checks or raising exceptions for edge cases.\n    # Therefore, we assume these preconditions are met and skip explicit validation.\n    \n    num_input_lists = len(lists)\n    if num_input_lists == 0:\n        return [] if output_as == \"list\" else {}\n    \n    # Assume all lists have the same length. Get length from the first list.\n    list_length = len(lists[0])\n\n    individual_dicts: List[Dict[str, Any]] = []\n\n    for i in range(list_length):\n        top_level_key = lists[0][i]\n        \n        # Elements for the nested part come from the second list onwards.\n        # If only one input list, elements_for_nesting will be empty, leading to None.\n        elements_for_nesting = [lst[i] for lst in lists[1:]]\n        \n        nested_structure = _build_nested_value_for_row(elements_for_nesting)\n        individual_dicts.append({top_level_key: nested_structure})\n\n    if output_as == \"list\":\n        return individual_dicts\n    elif output_as == \"dict\":\n        # Aggregate into a single dictionary.\n        # Assuming no duplicate keys in the first list when output_as is 'dict',\n        # as per the constraint on not raising exceptions for edge cases.\n        aggregated_result: Dict[str, Any] = {}\n        for item_dict in individual_dicts:\n            key = next(iter(item_dict)) # Extract the single key\n            aggregated_result[key] = item_dict[key]\n        return aggregated_result\n    else:\n        # If output_as is an unsupported value, default to \"list\" behavior\n        # as per interpretation of \"no exceptions for edge cases\" when design specified raising error.\n        return individual_dicts"}
{"task_id": "Mbpp/395", "solution": "def first_non_repeating_character(s: str) -> str | None:\n    \"\"\"\n    Finds the first non-repeated character in a given string.\n    Returns the character or None if no non-repeated character is found.\n    \"\"\"\n    counts = {}\n    for char in s:\n        counts[char] = counts.get(char, 0) + 1\n\n    for char in s:\n        if counts[char] == 1:\n            return char\n\n    return None"}
