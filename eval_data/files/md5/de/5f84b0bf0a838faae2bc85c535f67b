{"task_id": "Mbpp/474", "solution": "import enum\nclass ErrorCode(enum.Enum):\n    INVALID_TYPE = \"INVALID_TYPE\"\n    INVALID_CHAR_LENGTH = \"INVALID_CHAR_LENGTH\"\nclass StringReplaceError(Exception):\n    \"\"\"Custom exception for string replacement errors.\"\"\"\n    def __init__(self, code: ErrorCode, message: str) -> None:\n        self.code = code\n        self.message = message\n        super().__init__(f\"[{self.code.value}] {self.message}\")\nclass ReplaceRequest:\n    \"\"\"Data Transfer Object for replacement requests.\"\"\"\n    def __init__(self, s: str, old: str, new: str) -> None:\n        self.s = s\n        self.old = old\n        self.new = new\nclass ReplaceResponse:\n    \"\"\"Data Transfer Object for replacement responses.\"\"\"\n    def __init__(self, result: str) -> None:\n        self.result = result\nclass ValidationUtils:\n    \"\"\"Utility class for input validation.\"\"\"\n    @staticmethod\n    def validate_string(s: object) -> None:\n        if not isinstance(s, str):\n            raise StringReplaceError(ErrorCode.INVALID_TYPE, \"s must be a string\")\n\n    @staticmethod\n    def validate_char(c: object, name: str) -> None:\n        if not isinstance(c, str):\n            raise StringReplaceError(ErrorCode.INVALID_TYPE, f\"{name} must be a string\")\n        if len(c) != 1:\n            raise StringReplaceError(ErrorCode.INVALID_CHAR_LENGTH, f\"{name} must be a single character\")\nclass IStringReplacer:\n    \"\"\"Interface for string replacement implementations.\"\"\"\n    def replace(self, s: str, old: str, new: str) -> str:\n        raise NotImplementedError\nclass SimpleStringReplacer(IStringReplacer):\n    \"\"\"Concrete implementation using Python's built-in string replace.\"\"\"\n    def replace(self, s: str, old: str, new: str) -> str:\n        return s.replace(old, new)\nclass StringReplaceService:\n    \"\"\"Service layer for string replacement, orchestrates validation and actual replacement.\"\"\"\n    def __init__(self, replacer: IStringReplacer) -> None:\n        self._replacer = replacer\n\n    def replace(self, request: ReplaceRequest) -> ReplaceResponse:\n        ValidationUtils.validate_string(request.s)\n        ValidationUtils.validate_char(request.old, \"old\")\n        ValidationUtils.validate_char(request.new, \"new\")\n        \n        replaced_string = self._replacer.replace(request.s, request.old, request.new)\n        return ReplaceResponse(replaced_string)\nclass ReplaceController:\n    \"\"\"Controller to handle replacement requests and delegate to the service.\"\"\"\n    def __init__(self, service: StringReplaceService) -> None:\n        self._service = service\n\n    def handle(self, request: ReplaceRequest) -> ReplaceResponse:\n        return self._service.replace(request)\ndef replace_char(s: str, old: str, new: str) -> str:\n    \"\"\"Replaces all occurrences of a character in a string, with input validation.\"\"\"\n    request = ReplaceRequest(s, old, new)\n    replacer = SimpleStringReplacer()\n    service = StringReplaceService(replacer)\n    controller = ReplaceController(service)\n    response = controller.handle(request)\n    return response.result"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(nums):\n    \"\"\"\n    Finds the maximum product of any contiguous subarray of the given array.\n    \"\"\"\n    if not nums:\n        return 0\n\n    max_so_far = float(nums[0])\n    min_ending = float(nums[0])\n    max_ending = float(nums[0])\n    \n    # These indices are tracked to correctly apply tie-breaking rules,\n    # even if only the product is returned by this specific function.\n    start = 0\n    end = 0\n    temp_start_max = 0\n    temp_start_min = 0\n\n    for i in range(1, len(nums)):\n        n = float(nums[i])\n        \n        # If current number is negative, swap max_ending and min_ending.\n        # This is because a negative number multiplied by a negative can become a large positive.\n        # Also swap their respective start indices.\n        if n < 0:\n            max_ending, min_ending = min_ending, max_ending\n            temp_start_max, temp_start_min = temp_start_min, temp_start_max\n        \n        # Decide whether to extend the current 'max_ending' subarray or start a new one with 'n'.\n        # If 'n' itself is greater, it implies starting a new subarray.\n        if n > max_ending * n:\n            max_ending = n\n            temp_start_max = i\n        else:\n            max_ending = max_ending * n\n\n        # Decide whether to extend the current 'min_ending' subarray or start a new one with 'n'.\n        if n < min_ending * n:\n            min_ending = n\n            temp_start_min = i\n        else:\n            min_ending = min_ending * n\n\n        # Update overall max_so_far, applying tie-breaking rules.\n        current_max_ending_length = i - temp_start_max + 1\n        best_so_far_length = end - start + 1\n\n        if max_ending > max_so_far:\n            max_so_far = max_ending\n            start = temp_start_max\n            end = i\n        elif max_ending == max_so_far:\n            # Tie-breaking: prefer shorter length, then earlier start.\n            # If lengths are equal, the earlier start is implicitly kept by not updating.\n            if current_max_ending_length < best_so_far_length:\n                start = temp_start_max\n                end = i\n    \n    # The example asserts an integer result, so cast if possible.\n    return int(max_so_far) if max_so_far == int(max_so_far) else max_so_far"}
