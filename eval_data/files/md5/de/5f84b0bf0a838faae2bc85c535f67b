{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers.\n    Digits are aligned right-to-left, and missing digits are treated as zero.\n    \"\"\"\n\n    def _digits_of(n: int) -> list[int]:\n        \"\"\"Converts an integer to a list of its digits, least-significant first.\"\"\"\n        n = abs(n)\n        if n == 0:\n            return [0]\n        digits = []\n        while n:\n            digits.append(n % 10)\n            n //= 10\n        return digits\n\n    def _pad_digits(a_digits: list[int], b_digits: list[int]) -> tuple[list[int], list[int]]:\n        \"\"\"Pads the shorter digit list with zeros to match the length of the longer list.\"\"\"\n        max_len = max(len(a_digits), len(b_digits))\n        a_digits += [0] * (max_len - len(a_digits))\n        b_digits += [0] * (max_len - len(b_digits))\n        return a_digits, b_digits\n\n    a_digits = _digits_of(a)\n    b_digits = _digits_of(b)\n    \n    a_digits, b_digits = _pad_digits(a_digits, b_digits)\n    \n    total_distance = sum(abs(x - y) for x, y in zip(a_digits, b_digits))\n    \n    return total_distance"}
{"task_id": "Mbpp/556", "solution": "from dataclasses import dataclass\nfrom typing import Any, List, Tuple, Optional\ndef validate_nums(nums: Any) -> List[int]:\n    \"\"\"Normalizes input to a list of integers, raising ValueError on invalid types.\"\"\"\n    if isinstance(nums, str):\n        nums = nums.replace(\",\", \" \").split()\n    try:\n        return [int(x) for x in nums]\n    except Exception as ex:\n        raise ValueError(\"nums must be an iterable of integers\") from ex\nclass PairService:\n    \"\"\"Encapsulates the core logic for counting pairs with odd XOR.\"\"\"\n    def __init__(self, repo=None):\n        self._repo = repo\n\n    def _count_parities(self, nums: List[int]) -> Tuple[int, int]:\n        \"\"\"Counts the number of odd and even elements in the list.\"\"\"\n        odd = sum(1 for v in nums if (v & 1) == 1)\n        even = len(nums) - odd\n        return odd, even\n\n    def find_odd_pairs(self, nums: List[int], n: Optional[int] = None) -> PairResult:\n        \"\"\"Calculates the count of unordered pairs whose XOR is odd.\"\"\"\n        processed_nums = validate_nums(nums) # Use the inline defined helper\n        odd, even = self._count_parities(processed_nums)\n        result = PairResult(count=odd * even, odd_count=odd, even_count=even)\n        if self._repo:\n            self._repo.record_query(processed_nums, result)\n        return result\ndef find_Odd_Pair(nums: List[int], n: int) -> int:\n    \"\"\"Counts the number of unordered pairs in a list whose XOR value is odd.\"\"\"\n    service = PairService()\n    return service.find_odd_pairs(nums, n).count"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(s: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in a string.\"\"\"\n    return ''.join(c.lower() if c.isupper() else (c.upper() if c.islower() else c) for c in s)"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(nums: list[int], n: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist using Kadane's algorithm.\n    Assumes n is the length of nums and nums is not empty.\n    \"\"\"\n    max_ending_here = nums[0]\n    max_so_far = nums[0]\n\n    for i in range(1, n):\n        max_ending_here = max(nums[i], max_ending_here + nums[i])\n        max_so_far = max(max_so_far, max_ending_here)\n\n    return max_so_far"}
{"task_id": "Mbpp/560", "solution": "def union_elements(a, b):\n    \"\"\"\n    Finds the union of elements from two tuples and returns them in sorted order.\n    \"\"\"\n    merged = set(a) | set(b)\n    return tuple(sorted(merged))"}
{"task_id": "Mbpp/563", "solution": "import re\nimport typing\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass ParsingError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\ndef unescape_quotes(s: str) -> str:\n    \"\"\"Replace common escape sequences within a string.\"\"\"\n    return s.replace(r'\\\"', '\"').replace(r\"\\'\", \"'\").replace(r'\\\\', '\\\\')\nclass ParserStrategy:\n    def parse(self, s: str) -> typing.List[str]:\n        raise NotImplementedError\nclass RegexParser(ParserStrategy):\n    def __init__(self, pattern: typing.Optional[re.Pattern] = None) -> None:\n        self.pattern = pattern or re.compile(r'([\"\\'])(?P<content>(?:\\\\.|(?!\\1).)*)\\1', re.DOTALL)\n\n    def parse(self, s: str) -> typing.List[str]:\n        try:\n            matches = self.pattern.finditer(s)\n            results = []\n            for m in matches:\n                raw = m.group('content')\n                results.append(unescape_quotes(raw))\n            return results\n        except re.error as exc:\n            raise ParsingError(f\"Regex failure: {exc}\")\nclass ExtractorService:\n    def __init__(self, parser: typing.Optional[ParserStrategy] = None) -> None:\n        self.parser = parser or RegexParser()\n\n    def _validate_input(self, s: object) -> None:\n        if not isinstance(s, str):\n            raise InvalidInputError(\"Input must be a str\")\n\n    def extract(self, s: str) -> typing.List[str]:\n        self._validate_input(s)\n        return self.parser.parse(s)\n_default_service = ExtractorService()\ndef extract_values(s: str) -> list:\n    \"\"\"Public API: extract quoted values from s.\"\"\"\n    return _default_service.extract(s)"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers using mathematical formulas.\n    \"\"\"\n    sum_of_n = n * (n + 1) // 2\n    sum_of_cubes_of_n = sum_of_n * sum_of_n\n    return sum_of_cubes_of_n - sum_of_n"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(inputs):\n    \"\"\"\n    Finds the length of the longest sublist within a list of lists.\n    Raises ValidationError if the input structure is invalid.\n    \"\"\"\n    import collections.abc\n    from typing import Sequence, Any\n\n    class ValidationError(Exception):\n        \"\"\"Custom exception for input validation errors.\"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n    class SublistCollection:\n        \"\"\"A typed wrapper for a list of lists, providing iteration and length.\"\"\"\n        def __init__(self, sublists: Sequence[Sequence[Any]]) -> None:\n            self._sublists = [list(s) for s in sublists]\n\n        def __len__(self) -> int:\n            return len(self._sublists)\n\n        def __iter__(self):\n            return iter(self._sublists)\n\n    class Validators:\n        \"\"\"Utility class for validating input structures.\"\"\"\n        @staticmethod\n        def is_sequence(obj: Any) -> bool:\n            \"\"\"Checks if an object is a sequence but not a string or bytes.\"\"\"\n            return isinstance(obj, collections.abc.Sequence) and not isinstance(obj, (str, bytes))\n\n        def validate_list_of_lists(self, inputs: Any) -> SublistCollection:\n            \"\"\"Validates if the input is a sequence of sequences.\"\"\"\n            if not self.is_sequence(inputs):\n                raise ValidationError(\"Top-level input must be a sequence (list/tuple).\")\n            for idx, item in enumerate(inputs):\n                if not self.is_sequence(item):\n                    raise ValidationError(f\"Element at index {idx} is not a sequence.\")\n            return SublistCollection(inputs)\n\n    class LongestSublistService:\n        \"\"\"Service containing the core logic to find the maximum sublist length.\"\"\"\n        def find_max_length(self, collection: SublistCollection) -> int:\n            \"\"\"Iterates through the collection to find the maximum length among sublists.\"\"\"\n            max_len = 0\n            for sub in collection:\n                l = len(sub)\n                if l > max_len:\n                    max_len = l\n            return max_len\n\n    class FindMaxController:\n        \"\"\"Controller coordinating validation and service execution.\"\"\"\n        def __init__(self, service: LongestSublistService, validators: Validators):\n            self._service = service\n            self._validators = validators\n\n        def find_max(self, inputs: Any) -> int:\n            \"\"\"Validates inputs and delegates to the service to find max length.\"\"\"\n            collection = self._validators.validate_list_of_lists(inputs)\n            return self._service.find_max_length(collection)\n\n    # Instantiate and orchestrate the components as per the API wrapper design.\n    validators = Validators()\n    service = LongestSublistService()\n    controller = FindMaxController(service=service, validators=validators)\n    return controller.find_max(inputs)"}
