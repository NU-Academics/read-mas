{"task_id": "Mbpp/778", "solution": "from typing import Sequence, List, Any\ndef pack_consecutive_duplicates(items: Sequence[Any]) -> List[List[Any]]:\n    \"\"\"Packs consecutive duplicate elements of a list into sublists.\n    This function iterates through the input list, grouping identical,\n    consecutive elements into new sublists.\n    \"\"\"\n    if not items:\n        return []\n\n    packed_list: List[List[Any]] = []\n    current_group: List[Any] = []\n    \n    current_element: Any = items[0]\n    current_group.append(items[0])\n\n    for i in range(1, len(items)):\n        item = items[i]\n        if item == current_element:\n            current_group.append(item)\n        else:\n            packed_list.append(current_group)\n            current_element = item\n            current_group = [item]\n    \n    packed_list.append(current_group)\n\n    return packed_list"}
{"task_id": "Mbpp/781", "solution": "import math\ndef count_divisors(n):\n    \"\"\"\n    Checks if the count of positive divisors for an integer n is even.\n    Assumes n is a positive integer (n >= 1).\n    \"\"\"\n    count = 0\n    sqrt_n = math.isqrt(n)\n    \n    for i in range(1, sqrt_n + 1):\n        if n % i == 0:\n            count += 1\n            if i * i != n:\n                count += 1\n                \n    return count % 2 == 0"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of all odd-length subarrays using an O(n) approach.\n    Each element's contribution is determined by the number of odd-length subarrays it is part of.\n    \"\"\"\n    n = len(arr)\n    total_sum = 0\n    for i, val in enumerate(arr):\n        # Calculate total number of subarrays (odd and even length) that include arr[i]\n        # (i+1) is the number of possible starting positions for subarrays ending at or before i\n        # (n-i) is the number of possible ending positions for subarrays starting at or after i\n        total_subarrays_with_val = (i + 1) * (n - i)\n\n        # For any given element, roughly half of the subarrays it's part of will have an odd length.\n        # This formula calculates the exact number of odd-length subarrays containing arr[i].\n        odd_count = (total_subarrays_with_val + 1) // 2\n        \n        total_sum += val * odd_count\n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the product of the first odd and first even number in a list.\n    Assumes the input list contains at least one odd and one even integer.\n    \"\"\"\n    first_odd: int | None = None\n    first_even: int | None = None\n\n    for num in numbers:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is None and num % 2 == 0:\n            first_even = num\n\n        if first_odd is not None and first_even is not None:\n            break\n\n    return first_odd * first_even"}
{"task_id": "Mbpp/780", "solution": "import itertools\nfrom dataclasses import dataclass\nfrom typing import Iterable, List, Tuple, Any\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input data.\"\"\"\n    pass\ndef validate_tuple_list(raw: Iterable[Any]) -> List[Tuple[int,int]]:\n    \"\"\"Ensures each element is a 2-length sequence of ints.\"\"\"\n    out = []\n    for i, item in enumerate(raw):\n        if not (isinstance(item, (list, tuple)) and len(item) == 2):\n            raise InvalidInputError(f\"Item {i} is not a 2-tuple: {item}\")\n        x, y = item\n        if not (isinstance(x, int) and isinstance(y, int)):\n            raise InvalidInputError(f\"Item {i} elements must be int: {item}\")\n        out.append((x, y))\n    return out\nclass CombinationService:\n    \"\"\"Core algorithm to compute element-wise sums for combinations.\"\"\"\n    def __init__(self):\n        # The design context indicates no repository is passed for this use case.\n        pass\n\n    def find_combinations(self, items: List[Tuple2], k: int = 2) -> List[Tuple2]:\n        \"\"\"Computes element-wise sums for combinations of size k.\"\"\"\n        n = len(items)\n        if k < 2 or k > n:\n            raise ValueError(\"k must be between 2 and number of items\")\n        results = []\n        for indices in itertools.combinations(range(n), k):\n            results.append(self._combine_indices(indices, items))\n        return results\n\n    def _combine_indices(self, indices: Tuple[int, ...], items: List[Tuple2]) -> Tuple2:\n        \"\"\"Helper to compute element-wise sum for a given set of indices.\"\"\"\n        sum_x = sum(items[i].x for i in indices)\n        sum_y = sum(items[i].y for i in indices)\n        return Tuple2(sum_x, sum_y)\ndef find_combinations(items: Iterable[Tuple[int,int]], k: int = 2) -> List[Tuple[int,int]]:\n    \"\"\"\n    Finds combinations of sums with tuples in the given tuple list.\n    Computes element-wise sums for every unique unordered combination of k 2-element tuples.\n    \"\"\"\n    validated = [Tuple2.from_tuple(t) if not isinstance(t, Tuple2) else t for t in validate_tuple_list(items)]\n    svc = CombinationService()\n    result_objs = svc.find_combinations(validated, k=k)\n    return [r.to_tuple() for r in result_objs]"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(s: str) -> tuple[int, ...]:\n    import re\n\n    class ParseError(Exception):\n        \"\"\"Raised for syntax or format errors in the tuple string.\"\"\"\n        def __init__(self, message: str):\n            self.message = message\n            super().__init__(message)\n\n    class ValidationError(Exception):\n        \"\"\"Raised for semantic errors, such as non-integer elements.\"\"\"\n        def __init__(self, message: str):\n            self.message = message\n            super().__init__(message)\n\n    def _normalize_whitespace(text: str) -> str:\n        \"\"\"Removes leading/trailing whitespace from the entire string.\"\"\"\n        return text.strip()\n\n    def _strip_outer_parentheses(text: str) -> str:\n        \"\"\"Removes outer parentheses and validates their presence.\"\"\"\n        if not (text.startswith(\"(\") and text.endswith(\")\")):\n            raise ParseError(\"Tuple must start with '(' and end with ')'\")\n        return text[1:-1]\n\n    def _split_elements(text: str) -> list[str]:\n        \"\"\"Splits string by commas, strips whitespace from each part, and handles trailing commas.\"\"\"\n        parts = [p.strip() for p in text.split(',')]\n        # Handle a single trailing comma which results in an empty string at the end.\n        # e.g., \"7,\" -> [\"7\", \"\"], needs to become [\"7\"].\n        if len(parts) > 0 and parts[-1] == '':\n            parts = parts[:-1]\n        return parts\n\n    _INTEGER_TOKEN_REGEX = re.compile(r'^[+-]?\\d+$')\n\n    def _is_integer_token(token: str) -> bool:\n        \"\"\"Checks if a string token is a valid integer representation.\"\"\"\n        return bool(_INTEGER_TOKEN_REGEX.fullmatch(token))\n\n    def _validate_tokens(tokens_list: list[str]) -> None:\n        \"\"\"Ensures all tokens are valid integer representations.\"\"\"\n        for token in tokens_list:\n            if not _is_integer_token(token):\n                raise ValidationError(f\"Invalid integer token: '{token}'\")\n\n    def _convert_tokens_to_int_tuple(tokens_list: list[str]) -> tuple[int, ...]:\n        \"\"\"Converts a list of validated integer string tokens to a tuple of integers.\"\"\"\n        return tuple(int(token) for token in tokens_list)\n\n    if not isinstance(s, str):\n        raise ParseError(\"Input must be a string\")\n\n    normalized_s = _normalize_whitespace(s)\n    body_content = _strip_outer_parentheses(normalized_s)\n\n    if body_content == \"\":\n        return tuple()\n\n    tokens = _split_elements(body_content)\n    _validate_tokens(tokens)\n    result_tuple = _convert_tokens_to_int_tuple(tokens)\n\n    return result_tuple"}
{"task_id": "Mbpp/788", "solution": "def new_tuple(items: list[str], item: str) -> tuple[str, ...]:\n    \"\"\"\n    Creates a new tuple by appending a string to the elements of a list.\n    \"\"\"\n    return tuple(items) + (item,)"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(seq, value):\n    \"\"\"\n    Locates the right insertion point for a value in a sorted sequence.\n    This function implements a binary search to find the index where 'value'\n    should be inserted to maintain sorted order, placing duplicates to the right.\n    \"\"\"\n    left = 0\n    right = len(seq)\n\n    while left < right:\n        mid = (left + right) // 2\n        if seq[mid] <= value:\n            left = mid + 1\n        else:\n            right = mid\n    return left"}
