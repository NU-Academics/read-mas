{"task_id": "Mbpp/276", "solution": "import math\nclass InvalidParameterError(Exception):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    pass\nclass CalculationError(Exception):\n    \"\"\"Exception raised when a calculation fails.\"\"\"\n    pass\nclass CylinderModel:\n    \"\"\"Represents the dimensions of a cylinder.\"\"\"\n    def __init__(self, radius: float, height: float) -> None:\n        self._radius = radius\n        self._height = height\n\n    @property\n    def radius(self) -> float:\n        return self._radius\n\n    @property\n    def height(self) -> float:\n        return self._height\n\n    def area_base(self) -> float:\n        return math.pi * (self._radius ** 2)\nclass VolumeResult:\n    \"\"\"Data transfer object for the computed volume.\"\"\"\n    def __init__(self, volume: float) -> None:\n        self._volume = volume\n\n    @property\n    def volume(self) -> float:\n        return self._volume\nclass VolumeRepository:\n    \"\"\"Abstract base class for volume persistence.\"\"\"\n    def save(self, volume_result: VolumeResult) -> None:\n        raise NotImplementedError\nclass NoOpVolumeRepository(VolumeRepository):\n    \"\"\"A no-operation repository for volume results.\"\"\"\n    def save(self, volume_result: VolumeResult) -> None:\n        pass # No operation, does not persist anything\nclass InputValidator:\n    \"\"\"Validates the dimensions (radius and height) of a cylinder.\"\"\"\n    @staticmethod\n    def validate_dimensions(radius: float, height: float) -> None:\n        if not isinstance(radius, (int, float)) or not isinstance(height, (int, float)):\n            raise InvalidParameterError(\"radius and height must be numeric\")\n        \n        r = float(radius)\n        h = float(height)\n\n        if math.isnan(r) or math.isnan(h) or math.isinf(r) or math.isinf(h):\n            raise InvalidParameterError(\"radius and height must be finite numbers\")\n        if r < 0 or h < 0:\n            raise InvalidParameterError(\"radius and height must be non-negative\")\nclass VolumeService:\n    \"\"\"Calculates the volume of a cylinder and orchestrates persistence.\"\"\"\n    def __init__(self, repository: VolumeRepository = None) -> None:\n        self._repository = repository or NoOpVolumeRepository()\n\n    def compute_volume(self, cylinder: CylinderModel) -> VolumeResult:\n        try:\n            volume = math.pi * (cylinder.radius ** 2) * cylinder.height\n            result = VolumeResult(volume)\n            self._repository.save(result)\n            return result\n        except Exception as e:\n            raise CalculationError(\"Failed to compute volume\") from e\n\n    def compute_volume_values(self, radius: float, height: float) -> VolumeResult:\n        cylinder = CylinderModel(radius=radius, height=height)\n        return self.compute_volume(cylinder)\ndef volume_cylinder(radius: float, height: float) -> float:\n    \"\"\"\n    Calculates the volume of a right circular cylinder.\n    Requires radius and height to be non-negative numeric values.\n    \"\"\"\n    InputValidator.validate_dimensions(radius, height)\n    service = VolumeService()\n    result = service.compute_volume_values(radius, height)\n    return result.volume"}
{"task_id": "Mbpp/274", "solution": "def even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of binomial coefficients at even indices for a given non-negative integer n.\n    Uses the closed-form identity: 2^(n-1) for n >= 1, and 1 for n = 0.\n    \"\"\"\n    if n == 0:\n        return 1\n    else:\n        return 2 ** (n - 1)"}
