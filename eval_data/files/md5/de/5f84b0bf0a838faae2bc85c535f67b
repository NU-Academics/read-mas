{"task_id": "Mbpp/233", "solution": "import math\nclass InvalidDimensionError(Exception):\n    \"\"\"Custom exception for invalid geometric dimensions.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass Cylinder:\n    \"\"\"Represents a cylinder with given height and radius.\"\"\"\n    def __init__(self, height: float, radius: float) -> None:\n        self.height: float = float(height)\n        self.radius: float = float(radius)\n\n    def lateral_surface_area(self, pi_value: float) -> float:\n        \"\"\"Calculates the lateral surface area using the provided pi value.\"\"\"\n        return 2.0 * pi_value * self.radius * self.height\nclass ValidationService:\n    \"\"\"Service to validate geometric dimensions.\"\"\"\n    def validate_dimension(self, name: str, value: float) -> None:\n        if not isinstance(value, (int, float)):\n            raise TypeError(f\"{name} must be numeric\")\n        v = float(value)\n        if math.isinf(v) or math.isnan(v) or v <= 0:\n            raise InvalidDimensionError(f\"{name} must be > 0 and finite\")\n    def validate_cylinder(self, cylinder: Cylinder) -> None:\n        self.validate_dimension(\"height\", cylinder.height)\n        self.validate_dimension(\"radius\", cylinder.radius)\nclass Config:\n    \"\"\"Configuration for precision settings.\"\"\"\n    def __init__(self, use_high_precision_pi: bool = False) -> None:\n        self.use_high_precision_pi: bool = use_high_precision_pi\nDEFAULT_PI: float = 3.1415\nclass GeometryService:\n    \"\"\"Service to perform geometric computations.\"\"\"\n    def __init__(self, config: Config) -> None:\n        self._config = config\n\n    def lateral_surface_area(self, height: float, radius: float, use_high_precision: bool = None) -> float:\n        pi = math.pi if (use_high_precision is True or (use_high_precision is None and self._config.use_high_precision_pi)) else DEFAULT_PI\n        return 2.0 * pi * radius * height\n\n    def lateral_surface_area_cylinder(self, cylinder: Cylinder, use_high_precision: bool = None) -> float:\n        pi = math.pi if (use_high_precision is True or (use_high_precision is None and self._config.use_high_precision_pi)) else DEFAULT_PI\n        return cylinder.lateral_surface_area(pi)\nclass APIController:\n    \"\"\"Controller for the public API, coordinating validation and geometry services.\"\"\"\n    def __init__(self, validation_service: ValidationService, geometry_service: GeometryService) -> None:\n        self._validation = validation_service\n        self._geometry = geometry_service\n\n    def lateralsuface_cylinder(self, height: float, radius: float) -> float:\n        cylinder = Cylinder(height=height, radius=radius)\n        self._validation.validate_cylinder(cylinder)\n        return self._geometry.lateral_surface_area_cylinder(cylinder)\n_default_config = Config(use_high_precision_pi=False)\n_validation = ValidationService()\n_geometry = GeometryService(_default_config)\n_api_controller = APIController(_validation, _geometry)\ndef lateralsuface_cylinder(height: float, radius: float) -> float:\n    \"\"\"Calculates the lateral surface area of a cylinder using validated inputs.\"\"\"\n    return _api_controller.lateralsuface_cylinder(height, radius)"}
{"task_id": "Mbpp/232", "solution": "def larg_nnum(items, n):\n    \"\"\"\n    Returns a list containing the n largest unique items from the input list.\n    The result is sorted in descending order.\n    \"\"\"\n    if n <= 0:\n        return []\n\n    unique_items = set(items)\n    if not unique_items:\n        return []\n\n    import heapq\n    # heapq.nlargest returns elements in descending order\n    result = heapq.nlargest(n, unique_items)\n    return result"}
