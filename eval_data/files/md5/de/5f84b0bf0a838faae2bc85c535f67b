{"task_id": "Mbpp/301", "solution": "def dict_depth(d):\n    \"\"\"\n    Calculates the maximum depth of a nested dictionary.\n    An empty dictionary has a depth of 1, and non-dictionary values have a depth of 0.\n    \"\"\"\n    if not isinstance(d, dict):\n        return 0\n\n    max_nested_depth = 0\n    for value in d.values():\n        if isinstance(value, dict):\n            max_nested_depth = max(max_nested_depth, dict_depth(value))\n\n    return 1 + max_nested_depth"}
{"task_id": "Mbpp/305", "solution": "import string\nclass StartWithPError(Exception):\n    \"\"\"Base exception for errors in start_withp function.\"\"\"\n    pass\nclass NotEnoughMatchesError(StartWithPError):\n    \"\"\"Raised when fewer than the required number of matches are found.\"\"\"\n    def __init__(self, required: int, found: int):\n        self.required = required\n        self.found = found\n        super().__init__(f\"Expected {required} matches, but found only {found}.\")\n_PUNCTUATION_CHARS = string.punctuation\ndef _strip_punctuation(token: str) -> str:\n    \"\"\"Removes leading and trailing punctuation from a string.\"\"\"\n    return token.strip(_PUNCTUATION_CHARS)\ndef start_withp(words: list[str]) -> tuple[str, str]:\n    \"\"\"\n    Returns two words from a list of strings that start with 'p' (case-insensitive).\n    Raises NotEnoughMatchesError if fewer than two words are found.\n    \"\"\"\n    matches = []\n    for row in words:\n        for token in row.split():\n            cleaned_token = _strip_punctuation(token)\n            if cleaned_token and cleaned_token[0].lower() == 'p':\n                matches.append(token)\n                if len(matches) == 2:\n                    return (matches[0], matches[1])\n    raise NotEnoughMatchesError(required=2, found=len(matches))"}
