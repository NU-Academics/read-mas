{"task_id": "Mbpp/294", "solution": "import re\nfrom typing import Any, Iterable, Iterator, Optional, Union\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\nclass NumericCandidate:\n    def __init__(self, value: Union[int, float], original: Any) -> None:\n        self.value: Union[int, float] = value\n        self.original: Any = original\n\n    def is_integer(self) -> bool:\n        return isinstance(self.value, int) or (isinstance(self.value, float) and self.value.is_integer())\n_NUMERIC_INT_RE = re.compile(r\"^[+-]?\\d+$\")\n_NUMERIC_FLOAT_RE = re.compile(r\"^[+-]?\\d+\\.\\d+$\")\ndef is_numeric_type(value: Any) -> bool:\n    \"\"\"Checks if a value is a numeric type (int, float) but not a boolean.\"\"\"\n    return (isinstance(value, (int, float)) and not isinstance(value, bool))\ndef safe_parse_number(value: Any) -> Optional[Union[int, float]]:\n    \"\"\"Attempts to convert a value to an int or float, returning None on failure.\"\"\"\n    if is_numeric_type(value):\n        return int(value) if isinstance(value, int) or (isinstance(value, float) and float(value).is_integer()) else float(value)\n    if isinstance(value, str):\n        s = value.strip()\n        if _NUMERIC_INT_RE.match(s):\n            try:\n                return int(s)\n            except ValueError:\n                return None\n        if _NUMERIC_FLOAT_RE.match(s):\n            try:\n                return float(s)\n            except ValueError:\n                return None\n    return None\ndef compare_numeric(a: Union[int, float], b: Union[int, float]) -> Union[int, float]:\n    \"\"\"Returns the larger of two numeric values.\"\"\"\n    return a if a >= b else b\nclass TypeAdapter:\n    def __init__(self, allow_bool: bool = False) -> None:\n        self._allow_bool = allow_bool\n\n    def parse(self, value: Any) -> Optional[NumericCandidate]:\n        \"\"\"Parses an item into a NumericCandidate if it's a valid number.\"\"\"\n        if isinstance(value, bool) and not self._allow_bool:\n            return None\n        num = safe_parse_number(value)\n        if num is None:\n            return None\n        return NumericCandidate(num, value)\nclass ListRepository:\n    def validate(self, items: Any) -> None:\n        \"\"\"Validates if the input is an iterable, raising InvalidInputError if not.\"\"\"\n        if isinstance(items, str):\n            raise InvalidInputError(\"String is not a valid list input. Provide a list or JSON array.\")\n        try:\n            iter(items)\n        except TypeError:\n            raise InvalidInputError(\"Provided items is not iterable\")\n\n    def iter_items(self, items: Iterable[Any]) -> Iterator[Any]:\n        \"\"\"Yields items from the iterable.\"\"\"\n        for el in items:\n            yield el\nclass MaxService:\n    def __init__(self, adapter: TypeAdapter, repo: ListRepository) -> None:\n        self._adapter = adapter\n        self._repo = repo\n\n    def find_max(self, items: Any) -> Optional[Union[int, float]]:\n        \"\"\"Finds the maximum numeric value in a heterogeneous list.\"\"\"\n        self._repo.validate(items)\n        current_max: Optional[Union[int, float]] = None\n        for el in self._repo.iter_items(items):\n            candidate = self._adapter.parse(el)\n            if candidate is None:\n                continue\n            if current_max is None:\n                current_max = candidate.value\n            else:\n                current_max = compare_numeric(current_max, candidate.value)\n        \n        if current_max is None:\n            return None\n        # Normalize return type: int if the max value is an integer (e.g., 5.0 -> 5)\n        return int(current_max) if isinstance(current_max, float) and current_max.is_integer() else current_max\nclass MaxController:\n    def __init__(self, service: Optional[MaxService] = None) -> None:\n        if service is None:\n            adapter = TypeAdapter()\n            repo = ListRepository()\n            service = MaxService(adapter, repo)\n        self._service = service\n\n    def max_val(self, items: Any) -> Optional[Union[int, float]]:\n        \"\"\"Public API method to find the maximum numeric value.\"\"\"\n        return self._service.find_max(items)\n_default_controller = MaxController()\ndef max_val(items: Any) -> Optional[Union[int, float]]:\n    \"\"\"\n    Finds the maximum numeric value in a given heterogeneous list.\n    assert max_val(['Python', 3, 2, 4, 5, 'version'])==5\n    \"\"\"\n    return _default_controller.max_val(items)"}
