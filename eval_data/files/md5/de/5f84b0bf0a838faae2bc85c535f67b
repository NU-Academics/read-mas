{"task_id": "Mbpp/308", "solution": "import heapq\nfrom typing import List, Tuple, Set\ndef large_product(a: list, b: list, k: int) -> list:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list using a heap-based approach.\n    \"\"\"\n    if k <= 0 or not a or not b:\n        return []\n\n    # Sort lists in descending order to easily access largest elements for the heap.\n    a_sorted = sorted(a, reverse=True)\n    b_sorted = sorted(b, reverse=True)\n\n    # Min-heap to store (-product, index_a, index_b).\n    # Using negative product simulates a max-heap for finding the largest products.\n    heap: List[Tuple[int, int, int]] = []\n    \n    # Set to keep track of visited (index_a, index_b) pairs to avoid duplicates and redundant calculations.\n    visited: Set[Tuple[int, int]] = set()\n\n    # Start with the product of the largest elements from each list.\n    initial_product = a_sorted[0] * b_sorted[0]\n    heapq.heappush(heap, (-initial_product, 0, 0))\n    visited.add((0, 0))\n\n    result: List[int] = []\n\n    while heap and len(result) < k:\n        # Pop the element with the smallest negative product (which means the largest actual product).\n        neg_p, i, j = heapq.heappop(heap)\n        result.append(-neg_p)\n\n        # Explore the next possible product by advancing in list 'a'.\n        if i + 1 < len(a_sorted) and (i + 1, j) not in visited:\n            next_product_a = a_sorted[i + 1] * b_sorted[j]\n            heapq.heappush(heap, (-next_product_a, i + 1, j))\n            visited.add((i + 1, j))\n\n        # Explore the next possible product by advancing in list 'b'.\n        if j + 1 < len(b_sorted) and (i, j + 1) not in visited:\n            next_product_b = a_sorted[i] * b_sorted[j + 1]\n            heapq.heappush(heap, (-next_product_b, i, j + 1))\n            visited.add((i, j + 1))\n            \n    return result"}
{"task_id": "Mbpp/299", "solution": "from typing import List, Tuple, Any, Union, Dict, Iterable\ndef max_aggregate(records: List[Tuple[str, int]]) -> Tuple[str, int]:\n    \"\"\"\n    Calculates the maximum aggregate from a list of tuples (name, value).\n    \"\"\"\n\n    Number = Union[int, float]\n\n    class InputRecord:\n        def __init__(self, name: str, value: Number) -> None:\n            self.name: str = name\n            self.value: float = float(value)\n\n    class AggregateResult:\n        def __init__(self, name: str, total: Number) -> None:\n            self.name: str = name\n            self.total: float = float(total)\n\n    class InMemoryRepository:\n        def __init__(self) -> None:\n            self._store: Dict[str, float] = {}\n        def save(self, name: str, delta: float) -> None:\n            self._store[name] = self._store.get(name, 0.0) + delta\n        def get_all(self) -> Dict[str, float]:\n            return dict(self._store)\n        def clear(self) -> None:\n            self._store.clear()\n\n    class TupleAdapter:\n        def parse(self, record: Any, index: int = 0) -> InputRecord:\n            # Assuming record is a sequence of (str, Number) structure due to constraints.\n            name, value = record[0], record[1]\n            return InputRecord(name.strip(), value)\n\n    class AggregatorService:\n        def __init__(self, repository: InMemoryRepository, adapter: TupleAdapter) -> None:\n            self._repo = repository\n            self._adapter = adapter\n\n        def aggregate(self, records: Iterable[Any]) -> AggregateResult:\n            self._repo.clear()\n            for idx, raw in enumerate(records):\n                rec = self._adapter.parse(raw, index=idx)\n                self._repo.save(rec.name, rec.value)\n            \n            agg_map = self._repo.get_all()\n            if not agg_map:\n                # Return a default result for empty input without raising an exception.\n                return AggregateResult(\"\", 0.0) \n            return self.compute_max_from_map(agg_map)\n\n        def compute_max_from_map(self, agg_map: Dict[str, float]) -> AggregateResult:\n            # Find the name with the maximum aggregated total; dict preserves insertion order for tie-breaking.\n            max_name, max_total = max(agg_map.items(), key=lambda kv: kv[1])\n            return AggregateResult(max_name, max_total)\n\n    class AggregationController:\n        def __init__(self, service: AggregatorService) -> None:\n            self._service = service\n        def compute(self, records: Iterable[Any]) -> Tuple[str, float]:\n            result = self._service.aggregate(records)\n            return (result.name, result.total)\n\n    # Initialize components and run the aggregation process.\n    repo = InMemoryRepository()\n    adapter = TupleAdapter()\n    service = AggregatorService(repo, adapter)\n    controller = AggregationController(service)\n\n    name, total = controller.compute(records)\n    \n    # Cast the total to an integer to match the expected output format in the assert.\n    return (name, int(total))"}
