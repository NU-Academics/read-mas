{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number, which is a positive integer that is not a power of two.\n    The first polite number is 3.\n    \"\"\"\n    \n    # Helper function to check if a number is a power of two.\n    # This uses a bitwise trick, valid for positive integers.\n    def _is_power_of_two(num: int) -> bool:\n        return num > 0 and (num & (num - 1)) == 0\n\n    polite_numbers = []\n    candidate = 3  # Start checking from 3; 1 and 2 are powers of two.\n\n    # Generate polite numbers until 'n' numbers are collected.\n    while len(polite_numbers) < n:\n        if not _is_power_of_two(candidate):\n            polite_numbers.append(candidate)\n        candidate += 1\n\n    return polite_numbers[n - 1]"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list[int], sum: int) -> int:\n    # Counts pairs in a list whose sum equals the target sum.\n    # Uses a hash map to achieve O(n) time complexity.\n    counts = {}\n    pair_count = 0\n    for num in numbers:\n        complement = sum - num\n        pair_count += counts.get(complement, 0)\n        counts[num] = counts.get(num, 0) + 1\n    return pair_count"}
{"task_id": "Mbpp/766", "solution": "from typing import Iterable, List, Tuple, TypeVar\nT = TypeVar(\"T\")\ndef pair_wise(seq: Iterable[T]) -> List[Tuple[T, T]]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in a given iterable sequence.\n    \"\"\"\n    pairs: List[Tuple[T, T]] = []\n    iterator = iter(seq)\n\n    try:\n        prev_item = next(iterator)\n    except StopIteration:\n        # Sequence is empty, no pairs possible.\n        return pairs\n\n    for current_item in iterator:\n        pairs.append((prev_item, current_item))\n        prev_item = current_item\n\n    return pairs"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"Finds the sum of the fourth power of the first n odd natural numbers.\n    This function delegates the computation to an internal service with caching.\n    \"\"\"\n\n    def generate_first_n_odds(count: int):\n        \"\"\"Generates the first 'count' odd natural numbers.\"\"\"\n        for k in range(1, count + 1):\n            yield 2 * k - 1\n\n    def pow4(x: int) -> int:\n        \"\"\"Computes the fourth power of an integer.\"\"\"\n        return x * x * x * x\n\n    def sum_of_fourth_powers_of_first_n_odds_impl(count: int) -> int:\n        \"\"\"Computes the sum of fourth powers of the first 'count' odd natural numbers.\"\"\"\n        total = 0\n        for odd in generate_first_n_odds(count):\n            total += pow4(odd)\n        return total\n\n    class OddSumRepository:\n        \"\"\"An in-memory cache for computed sums of fourth powers.\"\"\"\n        def __init__(self, initial: dict[int, int] | None = None) -> None:\n            self._store = initial if initial is not None else {}\n\n        def get(self, key: int) -> int | None:\n            \"\"\"Retrieves a cached sum for a given key 'n'.\"\"\"\n            return self._store.get(key)\n\n        def set(self, key: int, value: int) -> None:\n            \"\"\"Caches a computed sum for a given key 'n'.\"\"\"\n            self._store[key] = value\n\n    class OddNumberService:\n        \"\"\"Provides the business logic for computing sums of fourth powers, with optional caching.\"\"\"\n        def __init__(self, repo: OddSumRepository | None = None) -> None:\n            self._repo = repo or OddSumRepository()\n\n        def compute_sum(self, count: int) -> int:\n            \"\"\"Computes the sum of fourth powers of first 'count' odd natural numbers, using cache if available.\"\"\"\n            cached = self._repo.get(count)\n            if cached is not None:\n                return cached\n            value = sum_of_fourth_powers_of_first_n_odds_impl(count)\n            self._repo.set(count, value)\n            return value\n\n    service = OddNumberService()\n    return service.compute_sum(n)"}
{"task_id": "Mbpp/771", "solution": "from dataclasses import dataclass\nfrom typing import Optional, Set, Dict\nDEFAULT_BRACKET_MAP: Dict[str, str] = {\"(\": \")\", \"[\": \"]\", \"{\": \"}\", \"<\": \">\"}\ndef check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets.\n    Non-bracket characters are ignored.\n    \"\"\"\n    open_set: Set[str] = set(DEFAULT_BRACKET_MAP.keys())\n    close_set: Set[str] = set(DEFAULT_BRACKET_MAP.values())\n    \n    stack: list[str] = []\n    \n    for ch in expression:\n        if ch in open_set:\n            stack.append(ch)\n        elif ch in close_set:\n            if not stack:\n                return False\n            \n            open_ch = stack.pop()\n            if DEFAULT_BRACKET_MAP[open_ch] != ch:\n                return False\n    \n    return not stack"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text, k):\n    \"\"\"\n    Removes all words of a specified length k from the input string.\n    Whitespace is normalized to single spaces in the output.\n    \"\"\"\n    words = text.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return \" \".join(filtered_words)"}
{"task_id": "Mbpp/769", "solution": "from typing import List, Any\nfrom abc import ABC, abstractmethod\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\nclass Validator:\n    \"\"\"Provides static methods for validating input types.\"\"\"\n    @staticmethod\n    def validate_int_list(name: str, value: Any) -> None:\n        if not isinstance(value, list):\n            raise ValidationError(f\"{name} must be a list.\")\n        for item in value:\n            if not isinstance(item, int):\n                raise ValidationError(f\"All elements in {name} must be integers, but found {type(item).__name__}.\")\nclass OrderStrategy(ABC):\n    \"\"\"Abstract base class for defining list ordering strategies.\"\"\"\n    @abstractmethod\n    def order(self, items: List[int]) -> List[int]:\n        pass\nclass EvenOddOrderStrategy(OrderStrategy):\n    \"\"\"Orders items by placing even numbers first, then odd numbers, preserving relative order within each group.\"\"\"\n    def order(self, items: List[int]) -> List[int]:\n        evens: List[int] = []\n        odds: List[int] = []\n        for x in items:\n            (evens if x % 2 == 0 else odds).append(x)\n        return evens + odds\nclass DiffService:\n    \"\"\"Handles the core business logic of computing list differences.\"\"\"\n    def __init__(self, repository=None) -> None:\n        self.repository = repository # Optional persistence, not utilized in this function's scope.\n\n    def compute_difference(self, list_a: List[int], list_b: List[int], strategy: OrderStrategy) -> List[int]:\n        \"\"\"Computes the raw difference and applies the specified ordering strategy.\"\"\"\n        Validator.validate_int_list(\"list_a\", list_a)\n        Validator.validate_int_list(\"list_b\", list_b)\n\n        raw_difference = self._raw_difference(list_a, list_b)\n        ordered_result = strategy.order(raw_difference)\n        return ordered_result\n\n    def _raw_difference(self, list_a: List[int], list_b: List[int]) -> List[int]:\n        \"\"\"Calculates elements present in list_a but not in list_b, preserving their original order.\"\"\"\n        set_b = set(list_b)\n        return [x for x in list_a if x not in set_b]\nclass DiffController:\n    \"\"\"Manages the public API for the difference calculation, coordinating services and strategies.\"\"\"\n    def __init__(self, service: DiffService) -> None:\n        self.service = service\n        self.default_strategy = EvenOddOrderStrategy()\n\n    def diff(self, list_a: List[int], list_b: List[int]) -> List[int]:\n        \"\"\"Delegates to the DiffService to compute the difference using the default ordering strategy.\"\"\"\n        Validator.validate_int_list(\"list_a\", list_a)\n        Validator.validate_int_list(\"list_b\", list_b)\n        return self.service.compute_difference(list_a, list_b, self.default_strategy)\ndef Diff(list_a: List[int], list_b: List[int]) -> List[int]:\n    \"\"\"\n    Calculates the difference between two lists, returning elements from list_a that are not in list_b.\n    The result is ordered with even numbers first, then odd numbers, preserving their relative order.\n    \"\"\"\n    _diff_service = DiffService()\n    _diff_controller = DiffController(service=_diff_service)\n    return _diff_controller.diff(list_a, list_b)"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(text: str, pattern: str, case_sensitive: bool = True, find_all: bool = False):\n    \"\"\"\n    Finds the occurrence and position of substrings within a string.\n    Returns None if there is no match for the first occurrence, or an empty list for all occurrences.\n    \"\"\"\n    class OccurrenceError(Exception):\n        \"\"\"Custom exception for domain-specific errors.\"\"\"\n        def __init__(self, message: str):\n            self.message = message\n            super().__init__(self.message)\n\n        def __str__(self):\n            return self.message\n\n    class OccurrenceResult:\n        \"\"\"Data Transfer Object representing a single substring occurrence.\"\"\"\n        def __init__(self, pattern: str, start: int, end: int):\n            self.pattern = pattern\n            self.start = start\n            self.end = end\n\n        def to_tuple(self) -> tuple:\n            \"\"\"Converts the result object to a (pattern, start, end) tuple.\"\"\"\n            return (self.pattern, self.start, self.end)\n\n    class InputValidator:\n        \"\"\"Validates input types and content for string search operations.\"\"\"\n        def validate_text_and_pattern(self, text, pattern) -> None:\n            if not isinstance(text, str):\n                raise OccurrenceError(\"text must be a string\")\n            if not isinstance(pattern, str):\n                raise OccurrenceError(\"pattern must be a string\")\n            if len(pattern) == 0:\n                raise OccurrenceError(\"pattern must not be empty\")\n\n    class SearchRepository:\n        \"\"\"Encapsulates low-level string search operations.\"\"\"\n        def find(self, text: str, pattern: str, start_pos: int = 0) -> int:\n            return text.find(pattern, start_pos)\n\n    class OccurrenceService:\n        \"\"\"Core business logic to find first/all occurrences of a pattern in text.\"\"\"\n        def __init__(self, repo: SearchRepository, validator: InputValidator):\n            self._repo = repo\n            self._validator = validator\n\n        def find_first(self, text: str, pattern: str, case_sensitive: bool = True):\n            self._validator.validate_text_and_pattern(text, pattern)\n            \n            search_text = text\n            search_pattern = pattern\n            if not case_sensitive:\n                search_text = text.lower()\n                search_pattern = pattern.lower()\n\n            idx = self._repo.find(search_text, search_pattern, 0)\n            if idx == -1:\n                return None\n            return OccurrenceResult(pattern, idx, idx + len(pattern))\n\n        def find_all(self, text: str, pattern: str, case_sensitive: bool = True):\n            self._validator.validate_text_and_pattern(text, pattern)\n\n            search_text = text\n            search_pattern = pattern\n            if not case_sensitive:\n                search_text = text.lower()\n                search_pattern = pattern.lower()\n            \n            results = []\n            start = 0\n            while True:\n                idx = self._repo.find(search_text, search_pattern, start)\n                if idx == -1:\n                    break\n                results.append(OccurrenceResult(pattern, idx, idx + len(pattern)))\n                start = idx + 1  # Allow overlapping matches\n            return results\n\n    repo = SearchRepository()\n    validator = InputValidator()\n    service = OccurrenceService(repo, validator)\n\n    if find_all:\n        res = service.find_all(text, pattern, case_sensitive=case_sensitive)\n        return [r.to_tuple() for r in res]\n    \n    first = service.find_first(text, pattern, case_sensitive=case_sensitive)\n    return first.to_tuple() if first is not None else None"}
