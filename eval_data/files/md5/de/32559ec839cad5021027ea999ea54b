{"task_id": "Mbpp/256", "solution": "import math\n\ndef count_Primes_nums(number: int) -> int:\n    \"\"\"\n    Counts the number of prime numbers strictly less than the given non-negative number.\n    \"\"\"\n    def is_prime(num: int) -> bool:\n        \"\"\"\n        Helper function to determine if a number is prime.\n        \"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        # Check for factors from 3 up to sqrt(num), stepping by 2\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    prime_count = 0\n    if number < 2:\n        return 0\n\n    for num in range(2, number):\n        if is_prime(num):\n            prime_count += 1\n\n    return prime_count"}
{"task_id": "Mbpp/262", "solution": "def split_two_parts(input_list: list, L: int) -> tuple[list, list]:\n    \"\"\"\n    Splits a given list into two parts based on a specified length L.\n    It returns a tuple containing the first L elements and the rest of the list.\n    \"\"\"\n    first_part = input_list[:L]\n    second_part = input_list[L:]\n    return (first_part, second_part)"}
{"task_id": "Mbpp/261", "solution": "class TupleLengthMismatchError(Exception):\n    \"\"\"Custom exception for when input tuples have different lengths.\"\"\"\n    def __init__(self, message: str = \"Input tuples must have the same length.\") -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass ZeroDivisorError(Exception):\n    \"\"\"Custom exception for when a divisor element is zero.\"\"\"\n    def __init__(self, message: str = \"Cannot divide by zero.\") -> None:\n        self.message = message\n        super().__init__(self.message)\n\ndef division_elements(dividendTuple: tuple, divisorTuple: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise division of two tuples, validating lengths and divisors.\n    Raises custom exceptions for mismatching lengths or division by zero.\n    \"\"\"\n    if len(dividendTuple) != len(divisorTuple):\n        raise TupleLengthMismatchError()\n\n    results = []\n    for i in range(len(dividendTuple)):\n        divisor_val = divisorTuple[i]\n        if divisor_val == 0:\n            raise ZeroDivisorError()\n        results.append(dividendTuple[i] / divisor_val)\n\n    return tuple(results)"}
{"task_id": "Mbpp/259", "solution": "def maximize_elements(\n    tuple1: tuple[tuple[int, int], ...],\n    tuple2: tuple[tuple[int, int], ...]\n) -> tuple[tuple[int, int], ...]:\n    \"\"\"\n    Maximizes elements of two input tuples, where each input tuple consists\n    of an ordered sequence of two-element tuples.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    result = []\n    for (a, b), (c, d) in zip(tuple1, tuple2):\n        max_first = max(a, c)\n        max_second = max(b, d)\n        result.append((max_first, max_second))\n\n    return tuple(result)"}
{"task_id": "Mbpp/260", "solution": "def newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman-Shanks-Williams (NSW) prime number.\n    It iteratively generates NSW numbers and checks their primality until the nth prime is found.\n    \"\"\"\n\n    def _is_prime(num: int) -> bool:\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        if num < 2:\n            return False\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    def _get_nsw_number(k: int) -> int:\n        \"\"\"Calculates the kth Newman-Shanks-Williams number.\"\"\"\n        if k == 0:\n            return 1\n        elif k == 1:\n            return 1\n        \n        # NSW numbers are defined by the recurrence relation NSW_k = 2 * NSW_{k-1} + NSW_{k-2}\n        nsw_prev = 1 # NSW_0\n        nsw_curr = 1 # NSW_1\n        for _ in range(2, k + 1):\n            nsw_next = 2 * nsw_curr + nsw_prev\n            nsw_prev = nsw_curr\n            nsw_curr = nsw_next\n        return nsw_curr\n\n    found_primes_count = 0\n    k = 0\n    while True:\n        nsw_num = _get_nsw_number(k)\n        if _is_prime(nsw_num):\n            found_primes_count += 1\n            if found_primes_count == n:\n                return nsw_num\n        k += 1"}
{"task_id": "Mbpp/264", "solution": "def dog_age(human_age):\n    \"\"\"Calculates a dog's age in dog years based on a specific formula.\"\"\"\n    if human_age <= 2:\n        return int(human_age * 10.5)\n    else:\n        return int(2 * 10.5 + (human_age - 2) * 4)"}
{"task_id": "Mbpp/265", "solution": "def list_split(input_list: list, n: int) -> list[list]:\n    \"\"\"\n    Splits an input list into n sublists, distributing elements by their index modulo n.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    result = [[] for _ in range(n)]\n    for i, item in enumerate(input_list):\n        target_sublist_index = i % n\n        result[target_sublist_index].append(item)\n\n    return result"}
{"task_id": "Mbpp/266", "solution": "class Cube:\n    \"\"\"Represents a cube and provides methods to calculate its lateral surface area.\"\"\"\n    def __init__(self, side_length: float):\n        \"\"\"Initializes a Cube object with a given side length.\"\"\"\n        self._side_length = side_length\n\n    def calculate_lateral_surface_area(self) -> float:\n        \"\"\"Computes the lateral surface area using the formula 4 * side_length^2.\"\"\"\n        return 4 * self._side_length ** 2\n\ndef lateralsurface_cube(side_length: float) -> float:\n    \"\"\"Calculates the lateral surface area of a cube given its side length.\"\"\"\n    cube = Cube(side_length)\n    return cube.calculate_lateral_surface_area()"}
{"task_id": "Mbpp/267", "solution": "def square_Sum(n):\n    \"\"\"\n    Calculates the sum of the squares of the first n odd natural numbers.\n\n    Args:\n        n (int): The number of odd natural numbers to consider.\n\n    Returns:\n        int: The sum of the squares of the first n odd natural numbers.\n    \"\"\"\n    if n < 0:\n        # For n < 0, it's undefined in this context, returning 0 as a safe default.\n        return 0\n\n    total_sum = 0\n    current_odd_number = 1\n    count = 0\n\n    while count < n:\n        square = current_odd_number * current_odd_number\n        total_sum += square\n        current_odd_number += 2\n        count += 1\n\n    return total_sum"}
{"task_id": "Mbpp/268", "solution": "def find_star_num(n):\n    \"\"\"\n    Calculates the n'th star number using the formula 6n(n-1) + 1.\n    \"\"\"\n    return 6 * n * (n - 1) + 1"}
{"task_id": "Mbpp/272", "solution": "def rear_extract(list_of_tuples: list) -> list:\n    \"\"\"\n    Extracts the rear element from each tuple in a list.\n\n    Args:\n        list_of_tuples: A list where each item is expected to be a tuple.\n\n    Returns:\n        A new list containing the rear element of each input tuple.\n    \"\"\"\n    return [t[-1] for t in list_of_tuples]"}
{"task_id": "Mbpp/269", "solution": "class Character:\n    \"\"\"Represents a single character input.\"\"\"\n    def __init__(self, symbol: str):\n        if not isinstance(symbol, str) or len(symbol) != 1:\n            raise ValueError(\"Input must be a single character string.\")\n        self.symbol = symbol\n\nclass AsciiValue:\n    \"\"\"Represents the integer ASCII value of a character.\"\"\"\n    def __init__(self, value: int):\n        if not isinstance(value, int):\n            raise ValueError(\"ASCII value must be an integer.\")\n        self.value = value\n\nclass AsciiConverter:\n    \"\"\"Provides the core logic to convert a Character to its AsciiValue.\"\"\"\n    def get_ascii_value(self, char_obj: Character) -> AsciiValue:\n        \"\"\"Converts a Character object to its ASCII integer value.\"\"\"\n        return AsciiValue(ord(char_obj.symbol))\n\ndef ascii_value(char: str) -> int:\n    \"\"\"Public API function to find the ASCII value of a character.\"\"\"\n    char_obj = Character(char)\n    converter = AsciiConverter()\n    ascii_val_obj = converter.get_ascii_value(char_obj)\n    return ascii_val_obj.value"}
{"task_id": "Mbpp/270", "solution": "def sum_even_and_even_index(input_list: list) -> int:\n    \"\"\"Calculates the sum of all even numbers located at even positions (0-based index)\n    within an input list.\"\"\"\n    total_sum = 0\n    for index, value in enumerate(input_list):\n        if index % 2 == 0:  # Check if the index is even\n            if value % 2 == 0:  # Check if the value at the even index is even\n                total_sum += int(value)\n    return total_sum"}
{"task_id": "Mbpp/271", "solution": "def even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the first 'n' even natural numbers,\n    where each number is raised to the fifth power.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        current_even_number = 2 * i\n        powered_value = current_even_number ** 5\n        total_sum += powered_value\n    return total_sum"}
{"task_id": "Mbpp/273", "solution": "def substract_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Subtracts elements of the second tuple from the first tuple element-wise.\n    Raises ValueError if tuples have different lengths.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Both tuples must have the same number of elements for element-wise subtraction.\")\n\n    return tuple(t1 - t2 for t1, t2 in zip(tuple1, tuple2))"}
{"task_id": "Mbpp/274", "solution": "def _factorial(n: int) -> int:\n    \"\"\"Calculates the factorial of n.\n    Assumes n is a non-negative integer.\"\"\"\n    res = 1\n    for i in range(1, n + 1):\n        res *= i\n    return res\n\ndef _combinations(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\n    Assumes 0 <= k <= n.\"\"\"\n    num = _factorial(n)\n    den = _factorial(k) * _factorial(n - k)\n    return num // den\n\ndef even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of C(n, k) for even k.\n    This function expects n to be a positive integer.\"\"\"\n    total_sum = 0\n    for k in range(0, n + 1, 2):\n        total_sum += _combinations(n, k)\n    return total_sum"}
{"task_id": "Mbpp/276", "solution": "import math\n\ndef volume_cylinder(radius: float, height: float) -> float:\n    \"\"\"\n    Calculates the volume of a cylinder given its radius and height.\n    \"\"\"\n    return math.pi * (radius ** 2) * height"}
