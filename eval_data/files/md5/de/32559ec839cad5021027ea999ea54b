{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a min heap.\n    An empty or single-element array is considered a min heap.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    # Iterate only through non-leaf nodes\n    for i in range(n // 2):\n        parent_value = arr[i]\n\n        left_child_idx = 2 * i + 1\n        if left_child_idx < n:  # Check if left child exists\n            if parent_value > arr[left_child_idx]:\n                return False\n\n        right_child_idx = 2 * i + 2\n        if right_child_idx < n:  # Check if right child exists\n            if parent_value > arr[right_child_idx]:\n                return False\n\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number using an iterative approach.\n    Raises ValueError for negative input n.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    a, b = 0, 1  # Represents J(n-2) and J(n-1) respectively\n    for _ in range(2, n + 1):\n        a, b = b, b + 2 * a\n    return b"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(list_of_numbers: list):\n    \"\"\"\n    Finds the second smallest distinct number in a list of numeric values.\n    Raises ValueError if the list has fewer than two distinct numbers.\n    \"\"\"\n    if not isinstance(list_of_numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    distinct_numbers = set()\n    for item in list_of_numbers:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"List elements must be numbers (int or float).\")\n        distinct_numbers.add(item)\n\n    if len(distinct_numbers) < 2:\n        raise ValueError(\"The list must contain at least two distinct numeric values.\")\n\n    sorted_distinct = sorted(list(distinct_numbers))\n    return sorted_distinct[1]"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Finds elements that are common across three lists at the same index.\n    Returns a list of these common elements in ascending index order.\n    \"\"\"\n    common_elements = []\n    min_length = min(len(list1), len(list2), len(list3))\n\n    for i in range(min_length):\n        if list1[i] == list2[i] and list2[i] == list3[i]:\n            common_elements.append(list1[i])\n\n    return common_elements"}
{"task_id": "Mbpp/759", "solution": "import re\n\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input string is a valid decimal number with exactly two decimal places.\n    This includes optional signs and one or more digits.\n    \"\"\"\n    # Regex pattern to match an optional sign, one or more digits,\n    # and optionally a decimal point followed by exactly two digits.\n    # ^[+-]? matches an optional plus or minus sign.\n    # \\d+ matches one or more digits before the decimal point.\n    # (?:\\.\\d{2})? matches an optional non-capturing group for the decimal part:\n    # \\. matches the literal dot.\n    # \\d{2} matches exactly two digits after the decimal point.\n    # $ asserts the position at the end of the string.\n    pattern = r\"^[+-]?\\d+(?:\\.\\d{2})?$\"\n    return re.fullmatch(pattern, input_string) is not None"}
{"task_id": "Mbpp/757", "solution": "from collections import Counter\n\ndef count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"Counts pairs of reverse strings in the given list.\n\n    A 'reverse pair' consists of two distinct strings (s1, s2) from the input list\n    such that s1 is the reverse of s2. Each string can be part of at most one pair.\n    \"\"\"\n    pair_count = 0\n    available_strings = Counter(string_list)\n\n    # Iterate over a copy of the keys to avoid issues when modifying the Counter\n    for s1 in list(available_strings.keys()):\n        if available_strings[s1] > 0:\n            reverse_s1 = s1[::-1]\n\n            if s1 == reverse_s1: # Palindrome case\n                if available_strings[s1] >= 2:\n                    pair_count += 1\n                    available_strings[s1] -= 2\n            else: # Non-palindrome case\n                if available_strings[reverse_s1] > 0:\n                    pair_count += 1\n                    available_strings[s1] -= 1\n                    available_strings[reverse_s1] -= 1\n    return pair_count"}
{"task_id": "Mbpp/758", "solution": "from collections import Counter\nfrom typing import List, Any, Dict, Tuple\n\ndef unique_sublists(input_list: List[List[Any]]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"\n    Counts lists within a list, returning a dictionary where every list is converted to a tuple\n    and the value of such tuple is the number of its occurrences in the original list.\n    \"\"\"\n    tuple_list = [tuple(sublist) for sublist in input_list]\n    return dict(Counter(tuple_list))"}
