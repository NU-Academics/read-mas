{"task_id": "Mbpp/126", "solution": "def sum_common_divisors(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of common divisors for two given integers.\n    Iterates up to the minimum of the two numbers to find all common divisors.\n    \"\"\"\n    common_divisors_sum = 0\n    # Iterate from 1 up to the minimum of the two numbers, inclusive\n    for i in range(1, min(num1, num2) + 1):\n        # Check if 'i' divides both num1 and num2\n        if num1 % i == 0 and num2 % i == 0:\n            common_divisors_sum += i\n    return common_divisors_sum"}
{"task_id": "Mbpp/123", "solution": "def _sum_proper_divisors(n: int) -> int:\n    \"\"\"Calculates the sum of proper divisors for a given number n.\"\"\"\n    if n == 1:\n        return 0\n    s = 1  # 1 is always a proper divisor for n > 1\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            s += i\n            if i * i != n:\n                s += n // i\n    return s\n\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"Calculates the sum of all amicable numbers from 1 up to a specified limit.\"\"\"\n    total_sum = 0\n    found_amicable_numbers = set()\n\n    for a in range(1, limit + 1):\n        if a not in found_amicable_numbers:\n            sum_div_a = _sum_proper_divisors(a)\n\n            # Check if sum_div_a is a distinct number greater than 'a'\n            # (to form an amicable pair (a, b) where a < b and avoid redundant checks)\n            if sum_div_a > a:\n                sum_div_b = _sum_proper_divisors(sum_div_a)\n\n                if sum_div_b == a:\n                    # Found an amicable pair (a, sum_div_a)\n                    total_sum += a\n                    total_sum += sum_div_a\n                    found_amicable_numbers.add(a)\n                    found_amicable_numbers.add(sum_div_a)\n    return total_sum"}
{"task_id": "Mbpp/125", "solution": "def _validate_binary_string(s: str) -> None:\n    \"\"\"\n    Validates that the input string contains only '0' or '1' characters.\n    Raises ValueError if the string is invalid.\n    \"\"\"\n    if not all(c in '01' for c in s):\n        raise ValueError(\"Input string must contain only '0' or '1'.\")\n\ndef find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring of the given binary string.\n    \"\"\"\n    _validate_binary_string(binary_string)\n\n    # Transform the binary string: '0' becomes 1, '1' becomes -1.\n    # We are looking for the maximum sum subarray using Kadane's algorithm.\n    transformed_arr = [1 if char == '0' else -1 for char in binary_string]\n\n    max_so_far = 0  # Initialize to 0 to handle cases where all differences are negative (e.g., \"111\")\n                    # or an empty string, implying a difference of 0.\n    current_max = 0\n\n    for num in transformed_arr:\n        current_max += num\n        # Update max_so_far with the maximum sum found so far.\n        max_so_far = max(max_so_far, current_max)\n        # If current_max becomes negative, reset it to 0. This means we start a new subarray\n        # because a negative sum would only decrease the overall maximum.\n        if current_max < 0:\n            current_max = 0\n\n    return max_so_far"}
{"task_id": "Mbpp/130", "solution": "import collections\n\ndef max_occurrences(input_list: list) -> any:\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Raises ValueError if the input_list is empty.\n    \"\"\"\n    if not input_list:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    item_counts = collections.Counter(input_list)\n    max_item, _ = item_counts.most_common(1)[0]\n    return max_item"}
{"task_id": "Mbpp/128", "solution": "class Word:\n    \"\"\"Represents a single word and provides its character length.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the character length of the word.\"\"\"\n        return len(self._value)\n\n    def get_value(self) -> str:\n        \"\"\"Returns the string value of the word.\"\"\"\n        return self._value\n\nclass TextInput:\n    \"\"\"Encapsulates the input text and provides methods to parse it into Word objects.\"\"\"\n    def __init__(self, text: str):\n        self._raw_text = text\n\n    def parse_words(self) -> list[Word]:\n        \"\"\"Splits the raw text into individual words, creating Word objects.\"\"\"\n        words_str = self._raw_text.split(' ')\n        parsed_word_objects = []\n        for word_str in words_str:\n            if word_str: # Filter out empty strings from multiple spaces\n                parsed_word_objects.append(Word(word_str))\n        return parsed_word_objects\n\ndef long_words(n: int, text: str) -> list[str]:\n    \"\"\"\n    Finds words that are longer than n characters from a given list of words.\n    \"\"\"\n    text_input = TextInput(text)\n    parsed_words = text_input.parse_words()\n\n    result = []\n    for word_obj in parsed_words:\n        if word_obj.length() > n:\n            result.append(word_obj.get_value())\n    return result"}
