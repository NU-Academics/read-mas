{"task_id": "Mbpp/605", "solution": "def prime_num(n: int) -> bool:\n    \"\"\"Checks if the given integer is a prime number.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "Mbpp/603", "solution": "import math\n\ndef get_ludic(n: int) -> list[int]:\n    \"\"\"\n    Calculates and returns a sorted list of lucid numbers up to a given integer n.\n    Lucid numbers are defined as 1 and all prime numbers.\n    \"\"\"\n    def _is_prime(num: int) -> bool:\n        \"\"\"\n        Determines if a given integer is a prime number.\n        Returns True if prime, False otherwise.\n        \"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        for i in range(3, int(math.isqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    lucid_numbers = []\n    if n >= 1:\n        lucid_numbers.append(1)\n\n    for i in range(2, n + 1):\n        if _is_prime(i):\n            lucid_numbers.append(i)\n\n    return lucid_numbers"}
