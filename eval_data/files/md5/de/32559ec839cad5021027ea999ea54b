{"task_id": "Mbpp/418", "solution": "def Find_Max(input_list: list) -> any:\n    \"\"\"\n    Finds the element with the maximum length in a given list.\n    Returns None if the input list is empty.\n    \"\"\"\n    if not input_list:\n        return None\n    \n    max_element = input_list[0]\n    max_length = len(input_list[0])\n    \n    for element in input_list[1:]:\n        current_length = len(element)\n        if current_length > max_length:\n            max_length = current_length\n            max_element = element\n            \n    return max_element"}
{"task_id": "Mbpp/415", "solution": "def max_Product(arr: list[int]) -> tuple[int, int]:\n    \"\"\"\n    Finds the pair of integers with the highest product from a given array.\n    Raises ValueError if the input array contains fewer than two elements.\n    \"\"\"\n    if len(arr) < 2:\n        raise ValueError(\"Input array must contain at least two elements to form a pair.\")\n\n    max1 = float('-inf')\n    max2 = float('-inf')\n    min1 = float('inf')\n    min2 = float('inf')\n\n    for x in arr:\n        if x > max1:\n            max2 = max1\n            max1 = x\n        elif x > max2:\n            max2 = x\n\n        if x < min1:\n            min2 = min1\n            min1 = x\n        elif x < min2:\n            min2 = x\n\n    if max1 * max2 >= min1 * min2:\n        return (max1, max2)\n    else:\n        return (min1, min2)"}
{"task_id": "Mbpp/419", "solution": "from typing import List\n\nclass Number:\n    \"\"\"Represents a single numerical value with rounding capability.\"\"\"\n    def __init__(self, value: float):\n        if not isinstance(value, (int, float)):\n            raise TypeError(\"Value must be an int or float\")\n        self._value: float = float(value)\n\n    def get_value(self) -> float:\n        \"\"\"Returns the raw float value.\"\"\"\n        return self._value\n\n    def round(self) -> int:\n        \"\"\"Rounds the number to the nearest integer.\"\"\"\n        return round(self._value)\n\nclass ListOfNumbers:\n    \"\"\"Manages a collection of Number objects.\"\"\"\n    def __init__(self, numbers: List[float]):\n        if not isinstance(numbers, list):\n            raise TypeError(\"Input must be a list of numbers\")\n        self._numbers: List[Number] = [Number(n) for n in numbers]\n\n    def get_numbers(self) -> List[Number]:\n        \"\"\"Returns the list of Number objects.\"\"\"\n        return self._numbers\n\n    def get_count(self) -> int:\n        \"\"\"Returns the count of numbers in the list.\"\"\"\n        return len(self._numbers)\n\nclass Calculator:\n    \"\"\"Performs the core business logic: rounding, summing, and multiplying.\"\"\"\n    def process(self, list_of_numbers: ListOfNumbers) -> int:\n        \"\"\"\n        Rounds each number in the list, sums them, and multiplies by the count.\n        Returns the final calculated integer result.\n        \"\"\"\n        if not isinstance(list_of_numbers, ListOfNumbers):\n            raise TypeError(\"Input must be an instance of ListOfNumbers\")\n\n        rounded_sum = 0\n        for num_obj in list_of_numbers.get_numbers():\n            rounded_sum += num_obj.round()\n\n        count = list_of_numbers.get_count()\n\n        final_result = rounded_sum * count\n        return final_result\n\ndef round_and_sum(numbers: List[float]) -> int:\n    \"\"\"\n    Rounds every number of a given list of numbers and returns the total sum\n    multiplied by the length of the list.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list\")\n    if not all(isinstance(n, (int, float)) for n in numbers):\n        raise TypeError(\"All elements in the list must be numbers\")\n\n    list_of_numbers_obj = ListOfNumbers(numbers)\n    calculator_obj = Calculator()\n    final_result = calculator_obj.process(list_of_numbers_obj)\n    return final_result"}
