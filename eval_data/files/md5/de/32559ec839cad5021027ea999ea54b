{"task_id": "Mbpp/772", "solution": "def remove_length(input_string: str, k: int) -> str:\n    \"\"\"Removes all words of length k from the given string.\"\"\"\n\n    def _split_string_into_words(text: str) -> list[str]:\n        \"\"\"Splits an input string into a list of individual words based on spaces.\"\"\"\n        return text.split(' ')\n\n    def _filter_words_by_length(words: list[str], k: int) -> list[str]:\n        \"\"\"Filters a list of words, retaining only those whose length is not equal to k.\"\"\"\n        return [word for word in words if len(word) != k]\n\n    def _join_words(words: list[str]) -> str:\n        \"\"\"Joins a list of words back into a single space-separated string.\"\"\"\n        return ' '.join(words)\n\n    words_list = _split_string_into_words(input_string)\n    filtered_words_list = _filter_words_by_length(words_list, k)\n    output_string = _join_words(filtered_words_list)\n    return output_string"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth powers of the first 'n' odd natural numbers.\n\n    Args:\n        n: A positive integer representing the count of odd natural numbers.\n\n    Returns:\n        The total sum of their fourth powers.\n\n    Raises:\n        ValueError: If 'n' is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"'n' must be a positive integer\")\n\n    total_sum = 0\n    # The k-th odd natural number is 2*k - 1\n    for k in range(1, n + 1):\n        current_odd = 2 * k - 1\n        fourth_power = current_odd ** 4\n        total_sum += fourth_power\n\n    return total_sum"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1: list, list2: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists, preserving relative order from list1.\n    Returns a new list containing elements from list1 that are not present in list2.\n    \"\"\"\n    result = []\n    set2 = set(list2)\n    for item in list1:\n        if item not in set2:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/775", "solution": "def _is_odd_index(index: int) -> bool:\n    \"\"\"Checks if a given index is an odd number.\"\"\"\n    return index % 2 != 0\n\ndef _is_odd_number(number: int) -> bool:\n    \"\"\"Checks if a given number is an odd integer.\"\"\"\n    return number % 2 != 0\n\ndef odd_position(input_list: list) -> bool:\n    \"\"\"\n    Checks whether every odd index contains an odd number in the given list.\n    Returns True if all odd-indexed elements are odd, False otherwise.\n    \"\"\"\n    for index, element in enumerate(input_list):\n        if _is_odd_index(index):\n            if not _is_odd_number(element):\n                return False\n    return True"}
