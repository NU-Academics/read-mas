{"task_id": "Mbpp/166", "solution": "from typing import List\n\ndef _is_even(number: int) -> bool:\n    \"\"\"\n    Checks if an integer is even.\n    \"\"\"\n    return number % 2 == 0\n\ndef find_even_pair(integer_list: List[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list that XOR to an even number.\n    This occurs when both integers in a pair have the same parity.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for number in integer_list:\n        if _is_even(number):\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # Calculate pairs of (even, even) and (odd, odd) using combinations formula n * (n - 1) / 2.\n    even_even_pairs = even_count * (even_count - 1) // 2\n    odd_odd_pairs = odd_count * (odd_count - 1) // 2\n\n    total_count = even_even_pairs + odd_odd_pairs\n    return total_count"}
