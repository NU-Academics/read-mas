{"task_id": "Mbpp/74", "solution": "class ElementMapping:\n    \"\"\"Manages the consistent one-to-one, bidirectional mapping between string elements from two lists.\"\"\"\n    def __init__(self):\n        \"\"\"Initializes empty bidirectional maps.\"\"\"\n        self._map1_to_2 = {}\n        self._map2_to_1 = {}\n\n    def add_mapping(self, val1: str, val2: str) -> bool:\n        \"\"\"Attempts to establish or verify a mapping between val1 and val2, returning True if consistent.\"\"\"\n        # Check mapping from list1 to list2\n        if val1 in self._map1_to_2:\n            if self._map1_to_2[val1] != val2:\n                return False  # Existing mapping for val1 conflicts with val2\n        \n        # Check mapping from list2 to list1\n        if val2 in self._map2_to_1:\n            if self._map2_to_1[val2] != val1:\n                return False  # Existing mapping for val2 conflicts with val1\n        \n        # If no conflicts, establish the mapping\n        self._map1_to_2[val1] = val2\n        self._map2_to_1[val2] = val1\n        return True\n\ndef is_samepatterns(list1: list[str], list2: list[str]) -> bool:\n    \"\"\"\n    Checks if list1 follows the sequence given by the pattern in list2 based on a consistent one-to-one mapping.\n    It returns True if patterns match, False otherwise.\n    \"\"\"\n    if len(list1) != len(list2):\n        return False\n\n    element_mapper = ElementMapping()\n\n    for val1, val2 in zip(list1, list2):\n        if not element_mapper.add_mapping(val1, val2):\n            return False\n            \n    return True"}
{"task_id": "Mbpp/77", "solution": "def is_Diff(number: int) -> bool:\n    \"\"\"\n    Checks if a number is divisible by 11 using the alternating sum of its digits.\n    The alternating sum (digit - digit + digit - ...) must be divisible by 11.\n    \"\"\"\n    s = str(number)\n    alternating_sum = 0\n    for i, digit_char in enumerate(s):\n        digit = int(digit_char)\n        if i % 2 == 0:\n            alternating_sum += digit\n        else:\n            alternating_sum -= digit\n    return alternating_sum % 11 == 0"}
