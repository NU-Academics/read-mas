{"task_id": "Mbpp/638", "solution": "import math\n\nclass Temperature:\n    def __init__(self, value: float):\n        self.value = value\n        self.unit = \"Celsius\"\n\nclass WindVelocity:\n    def __init__(self, value: float):\n        self.value = value\n        self.unit = \"km/h\"\n\nclass WindChillCalculator:\n    def calculate_wind_chill(self, temperature: Temperature, velocity: WindVelocity) -> int:\n        # BR1: WCI = 13.12 + 0.6215 * T - 11.37 * V^0.16 + 0.3965 * T * V^0.16\n        # T is temperature in Celsius, V is wind velocity in km/h\n        T = temperature.value\n        V = velocity.value\n\n        V_pow_0_16 = 0.0 if V == 0 else math.pow(V, 0.16)\n\n        wci_raw = 13.12 + (0.6215 * T) - (11.37 * V_pow_0_16) + (0.3965 * T * V_pow_0_16)\n\n        # BR2: Round to the nearest integer\n        return round(wci_raw)\n\ndef wind_chill(velocity_kmh: float, temperature_celsius: float) -> int:\n    \"\"\"\n    Calculates the wind chill index rounded to the nearest integer.\n    \"\"\"\n    temp_obj = Temperature(temperature_celsius)\n    vel_obj = WindVelocity(velocity_kmh)\n    calculator = WindChillCalculator()\n    return calculator.calculate_wind_chill(temp_obj, vel_obj)"}
