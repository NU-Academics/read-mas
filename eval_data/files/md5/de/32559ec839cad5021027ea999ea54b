{"task_id": "Mbpp/608", "solution": "def _validate_input(n: int) -> None:\n    \"\"\"\n    Validates if the input 'n' is a non-negative integer.\n    Raises ValueError if 'n' is invalid.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\ndef bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number.\n    The Bell number B_n is the number of ways to partition a set of n elements into non-empty subsets.\n    \"\"\"\n    _validate_input(n)\n\n    if n == 0:\n        return 1\n\n    # Using dynamic programming to calculate Bell numbers via Stirling numbers of the second kind.\n    # S(i, j) = S(i-1, j-1) + j * S(i-1, j)\n    stirling = [[0] * (n + 1) for _ in range(n + 1)]\n\n    stirling[0][0] = 1\n\n    for i in range(1, n + 1):\n        for j in range(1, i + 1):\n            stirling[i][j] = stirling[i - 1][j - 1] + j * stirling[i - 1][j]\n\n    # The nth Bell number is the sum of stirling[n][j] for j from 0 to n.\n    bell_n = sum(stirling[n][j] for j in range(n + 1))\n\n    return bell_n"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"Removes the k-th element (1-based index) from a list and returns a new list.\n    Raises IndexError if 'k' is out of bounds.\n    \"\"\"\n    idx = k - 1\n    if not (0 <= idx < len(input_list)):\n        raise IndexError(f\"k (1-based index) is out of bounds for list of length {len(input_list)}: {k}\")\n    return input_list[:idx] + input_list[idx+1:]"}
{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Optional\n\nclass MatchResult:\n    \"\"\"\n    Encapsulates the matching substring, its start index, and end index.\n    \"\"\"\n    def __init__(self, matching_substring: str, start_index: int, end_index: int):\n        self.matching_substring = matching_substring\n        self.start_index = start_index\n        self.end_index = end_index\n\n    def __eq__(self, other):\n        if not isinstance(other, MatchResult):\n            return NotImplemented\n        return (self.matching_substring == other.matching_substring and\n                self.start_index == other.start_index and\n                self.end_index == other.end_index)\n\n    def __repr__(self):\n        return f\"MatchResult(matching_substring='{self.matching_substring}', start_index={self.start_index}, end_index={self.end_index})\"\n\ndef find_literals(target_string: str, pattern: str) -> Optional[MatchResult]:\n    \"\"\"\n    Searches a target string for a regex pattern and returns the first matching substring, its start, and end index.\n    \"\"\"\n    match = re.search(pattern, target_string)\n    if match:\n        return MatchResult(match.group(0), match.start(), match.end())\n    return None"}
{"task_id": "Mbpp/612", "solution": "def merge(list_of_lists: list[list[any]]) -> list[list[any]]:\n    \"\"\"\n    Takes a list of lists, where each sublist has two elements, and returns\n    a list of two lists where the first list has the first element of each\n    sublist and the second one has the second.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n    for sublist in list_of_lists:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix: list[list[int]], n: int) -> int:\n    \"\"\"\n    Calculates the maximum value in the n-th column of a matrix.\n\n    Args:\n        matrix: A list of lists representing the matrix.\n        n: The zero-based index of the column to process.\n\n    Returns:\n        The maximum integer value found in the specified column.\n\n    Raises:\n        ValueError: If the input matrix is empty.\n        IndexError: If 'n' is out of bounds for the matrix rows.\n    \"\"\"\n    if not matrix:\n        raise ValueError(\"Input matrix cannot be empty.\")\n\n    # Validate 'n' against the first row's length, assuming a non-jagged or at least consistent structure\n    if n < 0 or n >= len(matrix[0]):\n        raise IndexError(\"Column index 'n' is out of bounds for the matrix rows.\")\n\n    max_value = float('-inf')\n\n    for row in matrix:\n        # Accessing row[n] may raise an IndexError if rows are jagged and 'n' is out of bounds\n        # for a subsequent row. The design specifies to let this IndexError propagate.\n        current_element = row[n]\n        if current_element > max_value:\n            max_value = current_element\n\n    return int(max_value)"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(tuple_list: list[tuple]) -> int | float:\n    \"\"\"\n    Calculates the cumulative sum of all numeric values present in a given list of tuples.\n    Non-numeric elements within tuples are ignored.\n    \"\"\"\n    total_sum = 0\n    for tpl in tuple_list:\n        for item in tpl:\n            if isinstance(item, (int, float)):\n                total_sum += item\n    return total_sum"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the size of the largest divisible subset from a given list of numbers.\n    A subset is divisible if every pair (a, b) within it satisfies a % b == 0 or b % a == 0.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    # Sort the numbers to ensure that if a number is divisible by another,\n    # the divisor will appear before the dividend in the sorted list.\n    nums = sorted(numbers)\n    n = len(nums)\n\n    # dp[i] will store the size of the largest divisible subset ending with nums[i].\n    dp = [1] * n\n\n    # Iterate through each number to build up the DP array.\n    for i in range(n):\n        for j in range(i):\n            # If nums[i] is divisible by nums[j], it means nums[i] can extend\n            # the divisible subset ending at nums[j].\n            if nums[i] % nums[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n\n    # The result is the maximum value found in the dp array.\n    return max(dp)"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(input_data: tuple[tuple[int | float, ...], ...]) -> list[float]:\n    \"\"\"Calculates the average value for each inner tuple in a tuple of tuples.\n    Returns a list of floats, where each float is the average of the corresponding inner tuple.\n    \"\"\"\n    results = []\n    for inner_tuple in input_data:\n        # Calculate sum and length to avoid issues with empty tuples if they were allowed\n        current_sum = sum(inner_tuple)\n        current_count = len(inner_tuple)\n        average = current_sum / current_count\n        results.append(average)\n    return results"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple[int, ...], tuple2: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"\n    Performs element-wise modulo on two tuples of integers.\n    Raises ValueError if tuple lengths differ.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must be of the same length.\")\n\n    result = []\n    for i in range(len(tuple1)):\n        result.append(tuple1[i] % tuple2[i])\n    \n    return tuple(result)"}
{"task_id": "Mbpp/618", "solution": "from typing import List, Union\n\ndef div_list(list1: List[Union[float, int]], list2: List[Union[float, int]]) -> List[float]:\n    \"\"\"\n    Performs element-wise division of two lists.\n    Returns a new list containing the floating-point results.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise ValueError(\"Input lists must be of equal length.\")\n\n    result_list: List[float] = []\n    for i in range(len(list1)):\n        try:\n            numerator = float(list1[i])\n            denominator = float(list2[i])\n            result_list.append(numerator / denominator)\n        except (TypeError, ValueError) as e:\n            raise TypeError(f\"Non-numerical element found at index {i}: {e}\") from e\n        except ZeroDivisionError:\n            raise # Re-raise ZeroDivisionError as per design\n\n    return result_list"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"\n    Moves all numeric characters to the end of the given string,\n    preserving relative order of both non-numeric and numeric characters.\n    \"\"\"\n    non_numeric_chars = []\n    numeric_chars = []\n\n    for char in input_string:\n        if char.isdigit():\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n\n    return \"\".join(non_numeric_chars) + \"\".join(numeric_chars)"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1: list[float], list2: list[float], size: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size.\n    Uses a two-pointer approach to efficiently find the two middle elements.\n    \"\"\"\n    if len(list1) != size or len(list2) != size:\n        raise ValueError(\"Input lists must be of the specified 'size'.\")\n\n    i = 0\n    j = 0\n    m1 = 0.0  # Stores the (size-1)-th element\n    m2 = 0.0  # Stores the size-th element\n\n    # Iterate up to 'size' to find the (size-1)-th and size-th elements\n    for count in range(size + 1):\n        m1 = m2\n        if i == size:\n            m2 = float(list2[j])\n            j += 1\n        elif j == size:\n            m2 = float(list1[i])\n            i += 1\n        elif list1[i] < list2[j]:\n            m2 = float(list1[i])\n            i += 1\n        else:\n            m2 = float(list2[j])\n            j += 1\n    \n    return (m1 + m2) / 2.0"}
