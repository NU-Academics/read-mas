{"task_id": "Mbpp/98", "solution": "import math\nfrom typing import Iterable, Union\n\ndef multiply_num(numbers: Iterable[Union[float, int]]) -> float:\n    \"\"\"\n    Multiplies all numbers in a list/tuple and divides the product by the list's length.\n    Assumes valid input: non-empty iterable of numeric values.\n    \"\"\"\n    product = 1.0\n    count = 0\n\n    for num in numbers:\n        product *= num\n        count += 1\n\n    return product / count"}
{"task_id": "Mbpp/97", "solution": "from typing import Any\n\ndef frequency_lists(list_of_lists: list[list[Any]]) -> dict[Any, int]:\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n\n    Args:\n        list_of_lists: A list where each element is itself a list of any type of elements.\n\n    Returns:\n        A dictionary where keys are the unique elements and values are their frequencies.\n    \"\"\"\n    element_counts = {}\n    for sub_list in list_of_lists:\n        for element in sub_list:\n            element_counts[element] = element_counts.get(element, 0) + 1\n    return element_counts"}
{"task_id": "Mbpp/100", "solution": "def _is_palindrome(num: int) -> bool:\n    \"\"\"Checks if a given integer is a palindrome by converting it to a string.\"\"\"\n    s_num = str(num)\n    return s_num == s_num[::-1]\n\ndef next_smallest_palindrome(input_integer: int) -> int:\n    \"\"\"Finds the smallest palindrome strictly greater than the input integer.\"\"\"\n    current_num = input_integer + 1\n    while True:\n        if _is_palindrome(current_num):\n            return current_num\n        current_num += 1"}
{"task_id": "Mbpp/101", "solution": "def kth_element(array: list, k: int) -> any:\n    \"\"\"\n    Finds the k-th element in the given array using 1-based indexing.\n    Handles input validation for k and array bounds.\n    \"\"\"\n    if not isinstance(k, int) or k <= 0:\n        raise ValueError(\"Index 'k' must be a positive integer.\")\n    if not array or k > len(array):\n        raise IndexError(\"Index 'k' is out of bounds for the given array.\")\n\n    return array[k - 1]"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(snake_case_string: str) -> str:\n    \"\"\"Converts a snake_case string to a CamelCase string.\n\n    Splits the input string by underscores, capitalizes the first letter of each word,\n    and concatenates them to form a CamelCase string.\n    \"\"\"\n    words = snake_case_string.split('_')\n    camel_case_words = [word.capitalize() for word in words]\n    return ''.join(camel_case_words)"}
