{"task_id": "Mbpp/397", "solution": "class NumberInput:\n    \"\"\"Represents the three numerical inputs for median calculation.\"\"\"\n    def __init__(self, value1: float, value2: float, value3: float):\n        self.value1 = value1\n        self.value2 = value2\n        self.value3 = value3\n\nclass MedianCalculator:\n    \"\"\"Calculates the median of three numbers.\"\"\"\n    def calculate(self, input: NumberInput) -> float:\n        \"\"\"Determines the middle value among the three inputs.\"\"\"\n        numbers = sorted([input.value1, input.value2, input.value3])\n        return float(numbers[1])\n\ndef median_numbers(num1: float, num2: float, num3: float) -> float:\n    \"\"\"Public API function to find the median of three numbers.\"\"\"\n    number_input = NumberInput(num1, num2, num3)\n    calculator = MedianCalculator()\n    return calculator.calculate(number_input)"}
{"task_id": "Mbpp/392", "solution": "_memo: dict[int, int] = {}\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Calculates the maximum sum for a given integer n using a recursive equation with memoization.\n    The equation is f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n), using integer division.\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    if n in _memo:\n        return _memo[n]\n\n    n_div_2 = n // 2\n    n_div_3 = n // 3\n    n_div_4 = n // 4\n    n_div_5 = n // 5\n\n    sum_of_parts = get_max_sum(n_div_2) + \\\n                   get_max_sum(n_div_3) + \\\n                   get_max_sum(n_div_4) + \\\n                   get_max_sum(n_div_5)\n\n    result = max(sum_of_parts, n)\n\n    _memo[n] = result\n    return result"}
{"task_id": "Mbpp/395", "solution": "class CharacterOccurrence:\n    \"\"\"\n    Encapsulates the tracking of a character's count and its first encountered index within a string.\n    \"\"\"\n    def __init__(self, character: str, first_index: int):\n        self._character = character\n        self._count = 1\n        self._first_index = first_index\n\n    def increment_count(self) -> None:\n        \"\"\"Increments the occurrence count for the character.\"\"\"\n        self._count += 1\n\n    def is_non_repeating(self) -> bool:\n        \"\"\"Returns True if the character has occurred exactly once, False otherwise.\"\"\"\n        return self._count == 1\n\n    def get_first_index(self) -> int:\n        \"\"\"Returns the index of the character's first occurrence.\"\"\"\n        return self._first_index\n\n    def get_character(self) -> str:\n        \"\"\"Returns the character being tracked.\"\"\"\n        return self._character\n\ndef first_non_repeating_character(input_string: str) -> str | None:\n    \"\"\"\n    Finds the first non-repeating character in a given string.\n    Returns the character (as a string) or None if no such character exists or the string is empty.\n    \"\"\"\n    if not input_string:\n        return None\n\n    char_occurrences_map = {}\n\n    for index, char in enumerate(input_string):\n        if char in char_occurrences_map:\n            char_occurrences_map[char].increment_count()\n        else:\n            char_occurrences_map[char] = CharacterOccurrence(char, index)\n\n    non_repeating_chars = []\n    for char_occurrence in char_occurrences_map.values():\n        if char_occurrence.is_non_repeating():\n            non_repeating_chars.append(char_occurrence)\n\n    if not non_repeating_chars:\n        return None\n\n    # Sort by first_index to find the earliest non-repeating character\n    non_repeating_chars.sort(key=lambda x: x.get_first_index())\n\n    return non_repeating_chars[0].get_character()"}
{"task_id": "Mbpp/398", "solution": "from typing import List\n\ndef _sum_digits_of_single_number(number: int) -> int:\n    \"\"\"Calculates the sum of digits for a single non-negative integer.\"\"\"\n    current_sum = 0\n    while number > 0:\n        current_sum += number % 10\n        number //= 10\n    return current_sum\n\ndef sum_of_digits(number_list: List[int]) -> int:\n    \"\"\"Computes the total sum of digits for all numbers in the given list.\"\"\"\n    total_sum = 0\n    for number in number_list:\n        total_sum += _sum_digits_of_single_number(number)\n    return total_sum"}
{"task_id": "Mbpp/409", "solution": "def min_product_tuple(input_list: list[tuple[float | int, float | int]]) -> float | int:\n    \"\"\"\n    Calculates the minimum product from a list of two-element numerical tuples.\n    It iterates through the list, multiplies elements within each tuple, and returns the smallest product found.\n    \"\"\"\n    min_prod = float('inf')\n\n    for tpl in input_list:\n        current_product = tpl[0] * tpl[1]\n        if current_product < min_prod:\n            min_prod = current_product\n\n    return min_prod"}
