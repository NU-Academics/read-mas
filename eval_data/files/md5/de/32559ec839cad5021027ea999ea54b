{"task_id": "Mbpp/286", "solution": "# Helper function: Kadane's algorithm to find the maximum contiguous subarray sum in a single array.\ndef _kadane(arr: list[int]) -> int:\n    if not arr:\n        return 0 \n\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, len(arr)):\n        num = arr[i]\n        current_max = max(num, current_max + num)\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far\n\n# Helper function: Calculates the total sum of all elements in an array.\ndef _total_sum(arr: list[int]) -> int:\n    return sum(arr)\n\n# Helper function: Finds the maximum sum of any prefix subarray.\ndef _max_prefix_sum(arr: list[int]) -> int:\n    if not arr:\n        return 0 \n\n    max_prefix = arr[0]\n    current_sum = arr[0]\n\n    for i in range(1, len(arr)):\n        current_sum += arr[i]\n        max_prefix = max(max_prefix, current_sum)\n\n    return max_prefix\n\n# Helper function: Finds the maximum sum of any suffix subarray.\ndef _max_suffix_sum(arr: list[int]) -> int:\n    if not arr:\n        return 0 \n\n    max_suffix = arr[-1]\n    current_sum = arr[-1]\n\n    for i in range(len(arr) - 2, -1, -1):\n        current_sum += arr[i]\n        max_suffix = max(max_suffix, current_sum)\n\n    return max_suffix\n\ndef max_sub_array_sum_repeated(arr: list[int], k: int) -> int:\n    # If k is 1, the problem reduces to finding the maximum subarray sum in the original array.\n    if k == 1:\n        return _kadane(arr)\n\n    # Initialize the answer with the maximum sum found within a single repetition.\n    ans = _kadane(arr)\n\n    # Consider the sum spanning across the boundary of two concatenated arrays.\n    # This covers cases where the maximum sum involves parts of two adjacent arrays.\n    ans = max(ans, _kadane(arr + arr))\n\n    total_arr_sum = _total_sum(arr)\n\n    # If the total sum of the array is positive, it's beneficial to include full repetitions.\n    # The maximum sum could be a suffix of the first array, plus (k-2) full arrays, plus a prefix of the last array.\n    if total_arr_sum > 0:\n        max_prefix = _max_prefix_sum(arr)\n        max_suffix = _max_suffix_sum(arr)\n        ans = max(ans, max_prefix + (k - 2) * total_arr_sum + max_suffix)\n\n    return ans"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: list[int]) -> int:\n    \"\"\"Counts the total number of inversions in a given array of integers.\n    An inversion is a pair of indices (i, j) such that i < j and arr[i] > arr[j].\n    \"\"\"\n    inv_count = 0\n    n = len(arr)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if arr[i] > arr[j]:\n                inv_count += 1\n    return inv_count"}
{"task_id": "Mbpp/293", "solution": "import math\n\ndef otherside_rightangle(leg1, leg2):\n    \"\"\"\n    Calculates the length of the hypotenuse of a right-angled triangle.\n    Uses the Pythagorean theorem: a^2 + b^2 = c^2.\n    \"\"\"\n    hypotenuse_squared = leg1**2 + leg2**2\n    hypotenuse = math.sqrt(hypotenuse_squared)\n    return hypotenuse"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list: list) -> list:\n    \"\"\"\n    Flattens a given nested list structure into a single-level list.\n    Elements are processed recursively, preserving their original order.\n    \"\"\"\n    flattened = []\n    for item in nested_list:\n        if isinstance(item, list):\n            flattened.extend(flatten_list(item))\n        else:\n            flattened.append(item)\n    return flattened"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Calculates the count of all binary sequences of length 2n such that\n    the sum of the first n bits is the same as the sum of the last n bits.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    # The problem reduces to finding the sum of (C(n, k))^2 for k from 0 to n,\n    # which is a known identity equal to C(2n, n).\n    return math.comb(2 * n, n)"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(data: list[tuple[str, int]]) -> tuple[str, int]:\n    \"\"\"\n    Calculates the maximum aggregate score from a list of name-score tuples.\n    Returns the name with the highest total score and their corresponding total score.\n    \"\"\"\n    aggregated_scores = {}\n    for name, score in data:\n        aggregated_scores[name] = aggregated_scores.get(name, 0) + score\n\n    max_name = None\n    max_score = 0\n\n    # Handle the case of an empty input list, returning default as per design context\n    if not aggregated_scores:\n        return (None, 0)\n\n    for name, total_score in aggregated_scores.items():\n        if total_score > max_score:\n            max_score = total_score\n            max_name = name\n\n    return (max_name, max_score)"}
