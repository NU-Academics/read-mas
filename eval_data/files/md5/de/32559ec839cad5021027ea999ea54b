{"task_id": "Mbpp/639", "solution": "class Name:\n    \"\"\"Represents a single name string with methods for its length and case.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the character length of the name.\"\"\"\n        return len(self.value)\n\n    def starts_with_lowercase(self) -> bool:\n        \"\"\"Checks if the name's first character is a lowercase letter.\"\"\"\n        return self.value and self.value[0].islower()\n\nclass NameList:\n    \"\"\"Manages a collection of Name objects, filters them, and calculates total length.\"\"\"\n    def __init__(self, name_strings: list[str]):\n        self._names: list[Name] = [Name(s) for s in name_strings]\n\n    def get_valid_names(self) -> list[Name]:\n        \"\"\"Filters and returns a list of Name objects that do not start with a lowercase letter.\"\"\"\n        return [name for name in self._names if not name.starts_with_lowercase()]\n\n    def calculate_total_length(self) -> int:\n        \"\"\"Computes the sum of the lengths of all valid names within the list.\"\"\"\n        valid_names = self.get_valid_names()\n        return sum(name.length() for name in valid_names)\n\ndef sample_nam(name_list_strings: list[str]) -> int:\n    \"\"\"\n    Sums the length of names from a list, excluding those starting with a lowercase letter.\n    Orchestrates NameList to process input and return the total length.\n    \"\"\"\n    name_list = NameList(name_list_strings)\n    return name_list.calculate_total_length()"}
