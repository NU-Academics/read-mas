{"task_id": "Mbpp/247", "solution": "def lps(input_string: str) -> int:\n    \"\"\"\n    Calculates the length of the longest palindromic subsequence in the given string.\n    This function implements a dynamic programming approach.\n    \"\"\"\n    n = len(input_string)\n\n    dp = [[0 for _ in range(n)] for _ in range(n)]\n\n    for i in range(n):\n        dp[i][i] = 1\n\n    for L in range(2, n + 1):\n        for i in range(n - L + 1):\n            j = i + L - 1\n            if input_string[i] == input_string[j] and L == 2:\n                dp[i][j] = 2\n            elif input_string[i] == input_string[j]:\n                dp[i][j] = 2 + dp[i + 1][j - 1]\n            else:\n                dp[i][j] = max(dp[i][j - 1], dp[i + 1][j])\n\n    return dp[0][n - 1]"}
{"task_id": "Mbpp/245", "solution": "def _calculate_lis_sum(arr: list[int]) -> list[int]:\n    \"\"\"\n    Calculates the maximum sum of an increasing subsequence ending at each position.\n    Dependencies: None\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n\n    lis_sum = list(arr) # Initialize with element itself\n\n    for i in range(1, n):\n        for j in range(i):\n            if arr[i] > arr[j]:\n                lis_sum[i] = max(lis_sum[i], lis_sum[j] + arr[i])\n    return lis_sum\n\n\ndef _calculate_lds_sum(arr: list[int]) -> list[int]:\n    \"\"\"\n    Calculates the maximum sum of a decreasing subsequence starting at each position.\n    Dependencies: None\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n\n    lds_sum = list(arr) # Initialize with element itself\n\n    for i in range(n - 2, -1, -1):\n        for j in range(n - 1, i, -1):\n            if arr[i] > arr[j]:\n                lds_sum[i] = max(lds_sum[i], lds_sum[j] + arr[i])\n    return lds_sum\n\n\ndef max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence for the given array.\n    A sequence is bitonic if it is first strictly increasing and then strictly decreasing.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    lis_sums = _calculate_lis_sum(arr)\n    lds_sums = _calculate_lds_sum(arr)\n\n    max_bitonic_sum = 0\n    \n    for i in range(n):\n        # Subtract arr[i] once because it's included in both LIS ending at i and LDS starting at i.\n        current_bitonic_sum = lis_sums[i] + lds_sums[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n\n    return max_bitonic_sum"}
{"task_id": "Mbpp/239", "solution": "def _find_sequences_recursive(current_length: int, last_element: int, m: int, n: int) -> int:\n    \"\"\"Counts valid sequences from current state to target length n.\"\"\"\n    count = 0\n    min_next_element = 2 * last_element\n    \n    # If the smallest possible next element exceeds m, no valid sequence can be formed.\n    if min_next_element > m:\n        return 0\n\n    for next_element in range(min_next_element, m + 1):\n        # If adding this next_element completes the sequence to length n, count it.\n        if current_length + 1 == n:\n            count += 1\n        else:\n            # Otherwise, recurse to find the remaining elements.\n            count += _find_sequences_recursive(current_length + 1, next_element, m, n)\n\n    return count\n\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"Calculates the total number of valid sequences of length n.\"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return m\n\n    total_sequences = 0\n    \n    # The first element 'x' must be small enough to allow for n-1 subsequent elements: x * (2^(n-1)) <= m.\n    # This implies x <= m / (2^(n-1)).\n    max_first_element = m // (2**(n-1))\n\n    for first_element in range(1, max_first_element + 1):\n        # Start recursion to find sequences. `current_length=1` for the first_element.\n        total_sequences += _find_sequences_recursive(1, first_element, m, n)\n\n    return total_sequences"}
