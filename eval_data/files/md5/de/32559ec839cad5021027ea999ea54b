{"task_id": "Mbpp/644", "solution": "import copy\nfrom typing import List, Any\n\ndef reverse_Array_Upto_K(array: List[Any], k: int) -> List[Any]:\n    \"\"\"\n    Reverses the elements of an array up to a given position k (0-indexed).\n    Returns a new list with elements reversed up to position k, or the original\n    list/empty list if validation fails or k is 0/1.\n    \"\"\"\n    if not array:\n        return []\n\n    if k <= 1:\n        return array[:] # Return a shallow copy of the original array\n\n    # Adjust k if it's greater than the array length\n    effective_k = min(k, len(array))\n\n    # Create a new list to store the result\n    result = array[:]\n\n    # Reverse the sub-array from 0 up to effective_k-1\n    # This involves slicing the part to be reversed and reversing it\n    # Then combining it with the rest of the array.\n    \n    # Slice the part to be reversed\n    part_to_reverse = result[0:effective_k]\n    \n    # Reverse the sliced part\n    part_to_reverse.reverse()\n    \n    # Combine the reversed part with the rest of the array\n    # The rest of the array starts from effective_k\n    result = part_to_reverse + result[effective_k:]\n    \n    return result"}
{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"\n    Checks if the lowercase character 'z' is present in the input string\n    at any position other than its first or last character.\n    \"\"\"\n    if len(input_string) < 3:\n        return False\n    \n    for i in range(1, len(input_string) - 1):\n        if input_string[i] == 'z':\n            return True\n            \n    return False"}
{"task_id": "Mbpp/722", "solution": "def filter_data(students_data: dict[str, tuple[float, float]], minimal_height: float, minimal_weight: float) -> dict[str, tuple[float, float]]:\n    \"\"\"\n    Filters a dictionary of students based on minimal height and weight criteria.\n\n    Returns a new dictionary containing only the students who meet both height and weight criteria.\n    \"\"\"\n    filtered_students = {}\n    for name, (height, weight) in students_data.items():\n        if height >= minimal_height and weight >= minimal_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students"}
{"task_id": "Mbpp/721", "solution": "import math\n\nclass Cell:\n    def __init__(self, row: int, column: int, cost: int):\n        self.row = row\n        self.column = column\n        self.cost = cost\n\nclass Path:\n    def __init__(self, cells: list[Cell]):\n        self.cells = list(cells)\n        self.total_cost = sum(cell.cost for cell in cells)\n        self.number_of_cells = len(cells)\n        self.average_cost = self.total_cost / self.number_of_cells if self.number_of_cells > 0 else 0.0\n\nclass Matrix:\n    def __init__(self, matrix_data: list[list[int]]):\n        self.N = len(matrix_data)\n        self.cells: list[list[Cell]] = []\n        for r in range(self.N):\n            row_cells = []\n            for c in range(self.N):\n                row_cells.append(Cell(r, c, matrix_data[r][c]))\n            self.cells.append(row_cells)\n\ndef _find_all_paths_recursive(matrix: Matrix, current_row: int, current_col: int, current_path_cells: list[Cell], all_paths: list[Path]) -> None:\n    \"\"\"Recursively explores all valid paths from a given cell to the bottom-right.\"\"\"\n    N = matrix.N\n\n    current_path_cells.append(matrix.cells[current_row][current_col])\n\n    if current_row == N - 1 and current_col == N - 1:\n        all_paths.append(Path(current_path_cells))\n        current_path_cells.pop()\n        return\n\n    if current_col + 1 < N:\n        _find_all_paths_recursive(matrix, current_row, current_col + 1, current_path_cells, all_paths)\n\n    if current_row + 1 < N:\n        _find_all_paths_recursive(matrix, current_row + 1, current_path_cells, all_paths)\n\n    current_path_cells.pop()\n\ndef find_max_average_path(matrix_data: list[list[int]]) -> float:\n    \"\"\"Orchestrates finding all paths, calculating their averages, and determining the maximum average.\"\"\"\n    matrix_obj = Matrix(matrix_data)\n    all_paths: list[Path] = []\n    \n    _find_all_paths_recursive(matrix_obj, 0, 0, [], all_paths)\n\n    if not all_paths:\n        return 0.0\n\n    max_average_cost = -math.inf\n    for path in all_paths:\n        if path.average_cost > max_average_cost:\n            max_average_cost = path.average_cost\n\n    return max_average_cost\n\ndef maxAverageOfPath(matrix_data: list[list[int]]) -> float:\n    \"\"\"The main entry point function to initiate the calculation of the maximum average path.\"\"\"\n    return find_max_average_path(matrix_data)"}
{"task_id": "Mbpp/724", "solution": "def _calculate_power_as_string(base: int, power: int) -> str:\n    \"\"\"\n    Computes base raised to power and returns the result as a string.\n    Handles potentially very large numbers.\n    \"\"\"\n    return str(base ** power)\n\ndef _sum_digits_of_string(number_str: str) -> int:\n    \"\"\"\n    Calculates the sum of individual digits from a string representation of a number.\n    \"\"\"\n    return sum(int(digit) for digit in number_str)\n\ndef power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    \"\"\"\n    if not isinstance(base, int) or not isinstance(power, int):\n        raise ValueError(\"Base and power must be integers.\")\n\n    power_result_str = _calculate_power_as_string(base, power)\n    sum_of_digits = _sum_digits_of_string(power_result_str)\n    return sum_of_digits"}
{"task_id": "Mbpp/723", "solution": "def count_same_pair(list1: list, list2: list) -> int:\n    \"\"\"\n    Counts indices where two lists have the same values.\n\n    Raises:\n        ValueError: If the input lists are not of equal length.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise ValueError(\"Input lists must be of equal length.\")\n\n    count = 0\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n            count += 1\n    return count"}
