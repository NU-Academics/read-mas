{"task_id": "Mbpp/572", "solution": "from collections import Counter\n\ndef two_unique_nums(numbers: list) -> list:\n    \"\"\"\n    Identifies numbers that appear exactly once in the input list\n    and returns them in a new list, preserving their relative order\n    of first occurrence.\n    \"\"\"\n    counts = Counter(numbers)\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n    return result"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if sub_list is a contiguous sublist of main_list.\n    Handles empty sub_list and cases where sub_list is longer than main_list.\n    \"\"\"\n    # BR2: An empty list is considered a sublist of any list.\n    if not sub_list:\n        return True\n\n    # BR3: If the sublist is longer than the main list, it cannot be a sublist.\n    if len(sub_list) > len(main_list):\n        return False\n\n    # BR1: Iterate through main_list with a sliding window to find a match.\n    for i in range(len(main_list) - len(sub_list) + 1):\n        if main_list[i : i + len(sub_list)] == sub_list:\n            return True\n\n    return False"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(number):\n    \"\"\"\n    Finds the last digit of the factorial for a given non-negative number.\n    This function uses precomputed results for small numbers and a property of factorials for larger ones.\n    \"\"\"\n    if number == 0 or number == 1:\n        return 1\n    elif number == 2:\n        return 2\n    elif number == 3:\n        return 6\n    elif number == 4:\n        return 4\n    else:  # For number >= 5, N! will always end in 0\n        return 0"}
{"task_id": "Mbpp/573", "solution": "def unique_product(input_list: list) -> [int | float]:\n    \"\"\"\n    Calculates the product of unique numbers in a given list.\n    Returns 1 for an empty list, and 0 if 0 is among the unique numbers.\n    \"\"\"\n    if not input_list:\n        return 1\n\n    unique_numbers = set(input_list)\n\n    if 0 in unique_numbers:\n        return 0\n\n    product = 1\n    for num in unique_numbers:\n        product *= num\n\n    return product"}
{"task_id": "Mbpp/581", "solution": "import math\n\ndef surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"\n    Calculates the total surface area of a square pyramid.\n\n    Raises ValueError if base_edge or height are negative.\n    \"\"\"\n    if base_edge < 0 or height < 0:\n        raise ValueError(\"Base edge and height must be non-negative numerical values.\")\n\n    base_area = base_edge * base_edge\n    slant_height = math.sqrt(height**2 + (base_edge / 2)**2)\n    lateral_surface_area = 2 * base_edge * slant_height\n    total_surface_area = base_area + lateral_surface_area\n\n    return total_surface_area"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Identifies and returns elements present in one input tuple but not the other,\n    maintaining their original relative order.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n\n    unique_to_tuple1 = []\n    for item in tuple1:\n        if item not in set2:\n            unique_to_tuple1.append(item)\n\n    unique_to_tuple2 = []\n    for item in tuple2:\n        if item not in set1:\n            unique_to_tuple2.append(item)\n\n    return tuple(unique_to_tuple1 + unique_to_tuple2)"}
{"task_id": "Mbpp/578", "solution": "from typing import Any, List\n\ndef interleave_lists(list1: List[Any], list2: List[Any], list3: List[Any]) -> List[Any]:\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Assumes all input lists are of the same length.\n    \"\"\"\n    result = []\n    for i in range(len(list1)):\n        result.append(list1[i])\n        result.append(list2[i])\n        result.append(list3[i])\n    return result"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(dataset: list[dict], n: int) -> list[dict]:\n    \"\"\"\n    Finds the n most expensive items in a given dataset.\n    Returns the top 'n' items, sorted by price in descending order.\n    \"\"\"\n    if n == 0:\n        return []\n\n    sorted_items = sorted(dataset, key=lambda item: item.get('price', 0), reverse=True)\n\n    if n >= len(sorted_items):\n        return sorted_items\n    else:\n        return sorted_items[:n]"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Recursively extracts even integer elements from a nested tuple,\n    preserving the original nesting structure.\n    \"\"\"\n    result_list = []\n    for element in input_tuple:\n        if isinstance(element, int):\n            if element % 2 == 0:\n                result_list.append(element)\n        elif isinstance(element, tuple):\n            extracted_nested = extract_even(element)\n            result_list.append(extracted_nested)\n    return tuple(result_list)"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Catalan number.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if n == 0:\n        return 1\n\n    def factorial(k):\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    numerator = factorial(2 * n)\n    denominator = factorial(n + 1) * factorial(n)\n\n    return numerator // denominator"}
