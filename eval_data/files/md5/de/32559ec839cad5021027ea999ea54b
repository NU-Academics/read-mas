{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number a(n, m) using a recursive approach.\n    This implementation uses the standard recurrence relation.\n    \"\"\"\n    if m < 0 or m >= n:\n        return 0\n    if n == 0:\n        return 1 if m == 0 else 0\n    \n    # Recurrence relation: A(n, m) = (m + 1) * A(n - 1, m) + (n - m) * A(n - 1, m - 1)\n    return (m + 1) * eulerian_num(n - 1, m) + (n - m) * eulerian_num(n - 1, m - 1)"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(tuples_list: list[tuple[int | float, int | float]]) -> int | float:\n    \"\"\"\n    Calculates the maximum absolute product from a list of two-number tuples.\n    Returns the maximum absolute product found, or 0.0 if the input list is empty.\n    \"\"\"\n    if not tuples_list:\n        return 0.0\n\n    max_abs_product = 0.0\n    for num1, num2 in tuples_list:\n        product = num1 * num2\n        abs_product = abs(product)\n        if abs_product > max_abs_product:\n            max_abs_product = abs_product\n    return max_abs_product"}
