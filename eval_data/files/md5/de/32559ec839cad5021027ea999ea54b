{"task_id": "Mbpp/129", "solution": "class Matrix:\n    \"\"\"Encapsulates matrix data and provides methods for matrix-specific calculations.\"\"\"\n    def __init__(self, elements: list[list[int]]) -> None:\n        # Input validation for non-empty matrix and consistent row lengths.\n        if not elements or not all(isinstance(row, list) for row in elements):\n            raise ValueError(\"Input must be a non-empty 2D array.\")\n        if not all(isinstance(item, int) for row in elements for item in row):\n            raise ValueError(\"All matrix elements must be integers.\")\n\n        self._elements = elements\n        self.numRows = len(elements)\n        self.numColumns = len(elements[0]) if self.numRows > 0 else 0\n\n        # Ensure all rows have the same number of columns\n        if not all(len(row) == self.numColumns for row in elements):\n            raise ValueError(\"All rows in the matrix must have the same number of columns.\")\n\n    def isSquare(self) -> bool:\n        \"\"\"Determines if the matrix is square.\"\"\"\n        return self.numRows > 0 and self.numRows == self.numColumns\n\n    def calculateRowSum(self, rowIndex: int) -> int:\n        \"\"\"Calculates the sum of elements in a specific row.\"\"\"\n        if not (0 <= rowIndex < self.numRows):\n            raise IndexError(\"Row index out of bounds.\")\n        return sum(self._elements[rowIndex])\n\n    def calculateColumnSum(self, colIndex: int) -> int:\n        \"\"\"Calculates the sum of elements in a specific column.\"\"\"\n        if not (0 <= colIndex < self.numColumns):\n            raise IndexError(\"Column index out of bounds.\")\n        return sum(self._elements[row][colIndex] for row in range(self.numRows))\n\n    def calculateMainDiagonalSum(self) -> int:\n        \"\"\"Calculates the sum of elements in the main diagonal.\"\"\"\n        return sum(self._elements[i][i] for i in range(self.numRows))\n\n    def calculateAntiDiagonalSum(self) -> int:\n        \"\"\"Calculates the sum of elements in the anti-diagonal.\"\"\"\n        return sum(self._elements[i][self.numRows - 1 - i] for i in range(self.numRows))\n\n\ndef magic_square_test(matrix_data: list[list[int]]) -> bool:\n    \"\"\"Determines if a given 2D array represents a magic square.\"\"\"\n    try:\n        matrix = Matrix(matrix_data)\n    except ValueError:\n        # Handles cases like empty matrix, inconsistent rows, non-integer elements.\n        return False\n\n    if not matrix.isSquare():\n        return False\n\n    n = matrix.numRows\n\n    row_sums = [matrix.calculateRowSum(i) for i in range(n)]\n    col_sums = [matrix.calculateColumnSum(i) for i in range(n)]\n    main_diag_sum = matrix.calculateMainDiagonalSum()\n    anti_diag_sum = matrix.calculateAntiDiagonalSum()\n\n    # Verify sums.\n    if not all(s == row_sums[0] for s in row_sums):\n        return False\n\n    common_sum = row_sums[0]\n\n    if not all(s == common_sum for s in col_sums):\n        return False\n\n    if main_diag_sum != common_sum:\n        return False\n\n    if anti_diag_sum != common_sum:\n        return False\n\n    return True"}
