{"task_id": "Mbpp/453", "solution": "class InputNumber:\n    \"\"\"Encapsulates the integer input value.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def get_value(self) -> int:\n        \"\"\"Returns the encapsulated integer value.\"\"\"\n        return self._value\n\nclass Factor:\n    \"\"\"Represents a factor of a number and determines its evenness.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def get_value(self) -> int:\n        \"\"\"Returns the factor's integer value.\"\"\"\n        return self._value\n\n    def is_even(self) -> bool:\n        \"\"\"Checks if the factor's value is an even number.\"\"\"\n        return self._value % 2 == 0\n\nclass SumOfEvenFactors:\n    \"\"\"Accumulates and stores the total sum of even factors found.\"\"\"\n    def __init__(self):\n        self._total = 0\n\n    def add_factor(self, factor: Factor):\n        \"\"\"Adds the factor's value to the total if the factor is even.\"\"\"\n        if factor.is_even():\n            self._total += factor.get_value()\n\n    def get_total(self) -> int:\n        \"\"\"Returns the current accumulated sum.\"\"\"\n        return self._total\n\ndef sumofFactors(number: int) -> int:\n    \"\"\"Calculates the sum of all even factors for a given integer input.\"\"\"\n    input_num = InputNumber(number)\n    sum_even_factors_accumulator = SumOfEvenFactors()\n\n    for i in range(1, input_num.get_value() + 1):\n        if input_num.get_value() % i == 0:\n            current_factor = Factor(i)\n            sum_even_factors_accumulator.add_factor(current_factor)\n\n    return sum_even_factors_accumulator.get_total()"}
{"task_id": "Mbpp/448", "solution": "def cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers up to a given non-negative integer 'n'.\"\"\"\n    # Perrin numbers: P(0)=3, P(1)=0, P(2)=2. P(n) = P(n-2) + P(n-3) for n > 2.\n\n    if n == 0:\n        return 3\n    if n == 1:\n        return 3  # Sum P(0) + P(1) = 3 + 0\n    if n == 2:\n        return 5  # Sum P(0) + P(1) + P(2) = 3 + 0 + 2\n\n    perrin_sequence = [3, 0, 2]\n    for i in range(3, n + 1):\n        next_perrin = perrin_sequence[i - 2] + perrin_sequence[i - 3]\n        perrin_sequence.append(next_perrin)\n\n    return sum(perrin_sequence)"}
