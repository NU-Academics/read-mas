{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string, char_to_remove):\n    \"\"\"\n    Removes the first and last occurrences of a given character from the string.\n    Returns the modified string or the original string if the character is not found.\n    \"\"\"\n    first_idx = input_string.find(char_to_remove)\n    last_idx = input_string.rfind(char_to_remove)\n\n    if first_idx == -1:\n        # Character not found\n        return input_string\n    elif first_idx == last_idx:\n        # Character found only once\n        return input_string[:first_idx] + input_string[first_idx+1:]\n    else:\n        # Character found multiple times\n        # Remove the first occurrence\n        temp_string = input_string[:first_idx] + input_string[first_idx+1:]\n        \n        # Adjust last_idx for the new temp_string (one character shorter before last_idx)\n        adjusted_last_idx = last_idx - 1 \n        \n        # Remove the last occurrence from the temp_string\n        return temp_string[:adjusted_last_idx] + temp_string[adjusted_last_idx+1:]"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(input_string: str) -> int:\n    \"\"\"\n    Determines the minimum number of rotations (greater than 0) required\n    to get the same string.\n    \"\"\"\n    n = len(input_string)\n    if n == 0:\n        return 0  # Or handle as per specific requirement for empty string\n    \n    # Check if all characters are identical (FR4)\n    if len(set(input_string)) == 1:\n        return 1\n\n    # Iterate through possible rotations (1 to n-1)\n    for rotations in range(1, n):\n        rotated_string = input_string[rotations:] + input_string[:rotations]\n        if rotated_string == input_string:\n            return rotations\n            \n    # If no smaller rotation brings it back, it takes 'n' rotations\n    # to return to the original string.\n    return n"}
{"task_id": "Mbpp/3", "solution": "import math\n\ndef is_not_prime(number: int) -> bool:\n    \"\"\"\n    Checks if a given integer is a non-prime number.\n    Returns True if non-prime, False otherwise.\n    \"\"\"\n    if number <= 1:\n        return True  # Numbers <= 1 are not prime (and thus considered non-prime in this context)\n    if number == 2:\n        return False # 2 is prime\n    if number % 2 == 0:\n        return True  # Even numbers greater than 2 are non-prime\n\n    # Check for odd divisors from 3 up to the square root of the number\n    for i in range(3, int(math.sqrt(number)) + 1, 2):\n        if number % i == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two integers differ at exactly one bit position.\n    Returns True if they do, False otherwise.\n    \"\"\"\n    xor_result = num1 ^ num2\n    if xor_result == 0:\n        return False  # Numbers are identical, no bit difference\n    # Check if xor_result is a power of two, which means it has exactly one set bit\n    return (xor_result & (xor_result - 1)) == 0"}
{"task_id": "Mbpp/7", "solution": "def find_char_long(text: str) -> set[str]:\n    \"\"\"\n    Extracts all unique words from a string that are at least 4 characters long.\n    Words are split by whitespace.\n    \"\"\"\n    result_set = set()\n    words = text.split()\n    for word in words:\n        if len(word) >= 4:\n            result_set.add(word)\n    return result_set"}
{"task_id": "Mbpp/2", "solution": "from typing import Iterable, Any, Set\n\ndef similar_elements(list1: Iterable[Any], list2: Iterable[Any]) -> Set[Any]:\n    \"\"\"\n    Finds the shared elements from two given iterable collections.\n\n    Args:\n        list1: The first iterable collection.\n        list2: The second iterable collection.\n\n    Returns:\n        A set containing unique elements present in both list1 and list2.\n    \"\"\"\n    set1 = set(list1)\n    set2 = set(list2)\n    return set1.intersection(set2)"}
