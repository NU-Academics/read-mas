{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Removes consecutive duplicate elements from an input list, returning a new list.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n    for i in range(1, len(input_list)):\n        if input_list[i] != result[-1]:\n            result.append(input_list[i])\n    return result"}
{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r, h):\n    \"\"\"Calculates the lateral surface area of a cone given radius r and height h.\n    The formula used is L = \u03c0 * r * sqrt(r^2 + h^2).\n    \"\"\"\n    slant_height_squared = r**2 + h**2\n    slant_height = math.sqrt(slant_height_squared)\n    lateral_area = math.pi * r * slant_height\n    return lateral_area"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array.\n    Returns the index if found, otherwise returns -1.\n    \"\"\"\n    low, high = 0, len(arr) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == target:\n            result = mid  # Potential first occurrence, try to find an earlier one\n            high = mid - 1\n        elif arr[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list: list) -> int:\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists of a given list.\n    Args:\n        input_list (list): A list of numbers (integers or floats).\n    \"\"\"\n    total_sum_of_products = 0\n    n = len(input_list)\n\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= input_list[j]\n            total_sum_of_products += current_product\n\n    return total_sum_of_products"}
{"task_id": "Mbpp/739", "solution": "def find_Index(n: int) -> int:\n    \"\"\"\n    Finds the smallest positive integer index k such that the k-th triangular number has exactly n digits.\n    This function orchestrates the search process and uses helper functions for calculations and digit counting.\n    \"\"\"\n    def _calculate_triangular_number(k: int) -> int:\n        \"\"\"Calculates the k-th triangular number.\"\"\"\n        return k * (k + 1) // 2\n\n    def _count_digits(number: int) -> int:\n        \"\"\"Counts the number of digits in a given integer.\"\"\"\n        if number == 0:\n            return 1\n        return len(str(number))\n\n    k = 1\n    # The smallest n-digit number is 10^(n-1), the largest is 10^n - 1.\n    # We are looking for T_k such that 10^(n-1) <= T_k < 10^n.\n    lower_bound = 10**(n - 1)\n    upper_bound = 10**n\n\n    while True:\n        triangular_number = _calculate_triangular_number(k)\n        if triangular_number >= lower_bound:\n            # Check if the number of digits is exactly n\n            if triangular_number < upper_bound:\n                return k\n        k += 1"}
{"task_id": "Mbpp/736", "solution": "from typing import List, Union\n\ndef left_insertion(arr: List[Union[int, float]], x: Union[int, float]) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list.\n    It returns the index `i` such that all `arr[k] < x` for `k < i`, and `arr[k] >= x` for `k >= i`.\n    \"\"\"\n    low = 0\n    high = len(arr)\n\n    while low < high:\n        mid = (low + high) // 2\n        if arr[mid] < x:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
