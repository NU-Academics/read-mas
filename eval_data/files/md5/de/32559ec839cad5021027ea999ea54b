{"task_id": "Mbpp/567", "solution": "def issort_list(input_list: list) -> bool:\n    \"\"\"\n    Checks if a given list is sorted in ascending order.\n    Returns True for empty or single-element lists.\n    \"\"\"\n    if len(input_list) <= 1:\n        return True\n    \n    for i in range(len(input_list) - 1):\n        if input_list[i] > input_list[i+1]:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/564", "solution": "def count_Pairs(input_list: list[int]) -> int:\n    \"\"\"Counts the number of possible unordered pairs where both elements are unequal.\n\n    Args:\n        input_list: A list of integers.\n\n    Returns:\n        The total count of valid unequal unordered pairs.\n    \"\"\"\n    count = 0\n    n = len(input_list)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if input_list[i] != input_list[j]:\n                count += 1\n    return count"}
{"task_id": "Mbpp/569", "solution": "def sort_sublists(list_of_lists: list[list[str]]) -> list[list[str]]:\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists alphabetically in ascending order.\n    Returns a new list of lists with each sublist sorted.\n    \"\"\"\n    sorted_outer_list = []\n    for sublist in list_of_lists:\n        sorted_sublist = sorted(sublist)\n        sorted_outer_list.append(sorted_sublist)\n    return sorted_outer_list"}
