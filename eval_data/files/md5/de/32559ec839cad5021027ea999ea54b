{"task_id": "Mbpp/626", "solution": "def triangle_area(radius: float) -> float | None:\n    \"\"\"\n    Calculates the area of the largest triangle inscribed in a semicircle.\n    Returns None if the input radius is negative.\n    \"\"\"\n    if radius < 0:\n        return None\n    # The largest triangle has its base as the diameter (2*r) and height as the radius (r).\n    # Area = 0.5 * base * height = 0.5 * (2*r) * r = r*r.\n    return radius * radius"}
{"task_id": "Mbpp/629", "solution": "def Split(numbers_list: list) -> list:\n    \"\"\"\n    Filters a list of numbers, returning a new list containing only the even numbers.\n    A number is considered even if it is divisible by 2 with no remainder.\n    \"\"\"\n    even_numbers = []\n    for number in numbers_list:\n        if number % 2 == 0:\n            even_numbers.append(number)\n    return even_numbers"}
{"task_id": "Mbpp/630", "solution": "class Coordinate:\n    \"\"\"Represents a 2D point with integer x and y coordinates.\"\"\"\n    def __init__(self, x: int, y: int):\n        self.x = x\n        self.y = y\n\n    def to_list(self) -> list[int]:\n        \"\"\"Converts the coordinate to a [x, y] list format.\"\"\"\n        return [self.x, self.y]\n\n    def __eq__(self, other):\n        if not isinstance(other, Coordinate):\n            return NotImplemented\n        return self.x == other.x and self.y == other.y\n\n    def __repr__(self):\n        return f\"Coordinate({self.x}, {self.y})\"\n\ndef get_coordinates(center_coord: tuple[int, int]) -> list[list[int]]:\n    \"\"\"\n    Calculates and returns a list of 9 coordinates forming a 3x3 grid centered on\n    a given 2D coordinate, including the given coordinate itself.\n    \"\"\"\n    center_x, center_y = center_coord\n    result_coords: list[list[int]] = []\n\n    for dx in [-1, 0, 1]:\n        for dy in [-1, 0, 1]:\n            new_x = center_x + dx\n            new_y = center_y + dy\n            coord_obj = Coordinate(new_x, new_y)\n            result_coords.append(coord_obj.to_list())\n\n    return result_coords"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of XOR of all unique pairs of numbers in the given list.\n    Iterates through all distinct pairs, performs a bitwise XOR, and accumulates the results.\n    \"\"\"\n    total_sum = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            total_sum += numbers[i] ^ numbers[j]\n    return total_sum"}
{"task_id": "Mbpp/631", "solution": "def replace_spaces(input_string: str) -> str:\n    \"\"\"\n    Replaces whitespaces with underscores and vice versa in a given string.\n    Other characters remain unchanged.\n    \"\"\"\n    result_chars = []\n    for char in input_string:\n        if char == ' ':\n            result_chars.append('_')\n        elif char == '_':\n            result_chars.append(' ')\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/632", "solution": "def move_zero(input_list: list) -> list:\n    \"\"\"Moves all zero elements to the end of the given list.\n\n    Preserves the relative order of non-zero elements.\n    \"\"\"\n    non_zero_elements = [x for x in input_list if x != 0]\n    zero_count = len(input_list) - len(non_zero_elements)\n    return non_zero_elements + [0] * zero_count"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a given list of numbers in ascending order using the heap sort algorithm.\n    This function orchestrates the overall sorting process by calling helper functions.\n    \"\"\"\n\n    def _heapify(arr: list, n: int, i: int) -> None:\n        \"\"\"\n        Maintains the max-heap property for a subtree rooted at a given index i.\n        It ensures that the largest element is at the root of the subtree.\n        \"\"\"\n        largest = i\n        l = 2 * i + 1\n        r = 2 * i + 2\n\n        if l < n and arr[l] > arr[largest]:\n            largest = l\n\n        if r < n and arr[r] > arr[largest]:\n            largest = r\n\n        if largest != i:\n            arr[i], arr[largest] = arr[largest], arr[i]\n            _heapify(arr, n, largest)\n\n    def _build_max_heap(arr: list) -> None:\n        \"\"\"\n        Transforms an array into a max-heap by applying _heapify to all non-leaf nodes.\n        \"\"\"\n        n = len(arr)\n        # Build a maxheap.\n        # Iterate from the last non-leaf node up to the root.\n        for i in range(n // 2 - 1, -1, -1):\n            _heapify(arr, n, i)\n\n    arr = list(input_list)\n    n = len(arr)\n\n    _build_max_heap(arr)\n\n    # One by one extract elements\n    for i in range(n - 1, 0, -1):\n        # Move current root to end\n        arr[i], arr[0] = arr[0], arr[i]\n        # call max heapify on the reduced heap\n        _heapify(arr, i, 0)\n\n    return arr"}
