{"task_id": "Mbpp/558", "solution": "def _int_to_digit_list(number: int) -> list[int]:\n    \"\"\"Converts a non-negative integer into a list of its individual digits.\n    Handles the special case where the input number is 0.\n    \"\"\"\n    if number == 0:\n        return [0]\n    return [int(d) for d in str(number)]\n\ndef _pad_digit_lists(digits1: list[int], digits2: list[int]) -> tuple[list[int], list[int]]:\n    \"\"\"Pads the shorter of two digit lists with leading zeros to match the length of the longer list.\n    This ensures both lists have the same number of elements for digit-wise comparison.\n    \"\"\"\n    max_len = max(len(digits1), len(digits2))\n    padded_digits1 = [0] * (max_len - len(digits1)) + digits1\n    padded_digits2 = [0] * (max_len - len(digits2)) + digits2\n    return padded_digits1, padded_digits2\n\ndef _calculate_digit_differences(digits1: list[int], digits2: list[int]) -> int:\n    \"\"\"Calculates the sum of absolute differences between corresponding digits in two equally-sized digit lists.\n    It iterates through the lists and accumulates the absolute difference for each digit pair.\n    \"\"\"\n    total_difference_sum = 0\n    # Assuming digits1 and digits2 are of equal length after padding\n    for i in range(len(digits1)):\n        total_difference_sum += abs(digits1[i] - digits2[i])\n    return total_difference_sum\n\ndef digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"Calculates the sum of per-digit differences between two integers.\n\n    Args:\n        num1: The first integer.\n        num2: The second integer.\n\n    Returns:\n        The sum of the absolute per-digit differences.\n    \"\"\"\n    # Convert numbers to digit lists\n    digits1_list = _int_to_digit_list(num1)\n    digits2_list = _int_to_digit_list(num2)\n\n    # Pad digit lists to equal length\n    padded_digits1, padded_digits2 = _pad_digit_lists(digits1_list, digits2_list)\n\n    # Calculate sum of differences\n    total_difference_sum = _calculate_digit_differences(padded_digits1, padded_digits2)\n\n    return total_difference_sum"}
{"task_id": "Mbpp/559", "solution": "import math\n\ndef max_sub_array_sum(list_of_numbers: list[int]) -> int:\n    \"\"\"Calculates the sum of the largest contiguous sublist.\n    Uses Kadane's algorithm to efficiently find the maximum subarray sum.\n    \"\"\"\n    if not list_of_numbers:\n        return 0\n\n    current_max = 0\n    global_max = -math.inf\n\n    for x in list_of_numbers:\n        current_max += x\n        if current_max > global_max:\n            global_max = current_max\n        if current_max < 0:\n            current_max = 0\n\n    return int(global_max)"}
