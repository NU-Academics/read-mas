{"task_id": "Mbpp/63", "solution": "import math\nfrom typing import List, Union, Tuple as NativeTuple\n\nNumber = Union[int, float]\n\nclass Tuple:\n    _value1: Number\n    _value2: Number\n\n    def __init__(self, val1: Number, val2: Number):\n        self._value1 = val1\n        self._value2 = val2\n\n    def getAbsoluteDifference(self) -> Number:\n        return math.fabs(self._value1 - self._value2)\n\ndef max_difference(tuple_list: List[NativeTuple[Number, Number]]) -> Number:\n    if not tuple_list:\n        return 0.0\n\n    differences = []\n    for native_tuple in tuple_list:\n        custom_tuple = Tuple(native_tuple[0], native_tuple[1])\n        differences.append(custom_tuple.getAbsoluteDifference())\n\n    return max(differences)"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list: list) -> int | float:\n    \"\"\"\n    Recursively flattens a list and sums all numerical elements.\n    \"\"\"\n    total_sum = 0\n    for element in input_list:\n        if isinstance(element, (int, float)):\n            total_sum += element\n        elif isinstance(element, list):\n            total_sum += recursive_list_sum(element)\n    return total_sum"}
{"task_id": "Mbpp/68", "solution": "from typing import List, Union\n\ndef is_Monotonic(array: List[Union[int, float]]) -> bool:\n    \"\"\"\n    Checks if an array is monotonic (either entirely non-decreasing or entirely non-increasing).\n    Empty arrays or single-element arrays are considered monotonic.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    is_non_decreasing = True\n    is_non_increasing = True\n\n    for i in range(1, len(array)):\n        if array[i] < array[i-1]:\n            is_non_decreasing = False\n        if array[i] > array[i-1]:\n            is_non_increasing = False\n    \n    return is_non_decreasing or is_non_increasing"}
{"task_id": "Mbpp/70", "solution": "from typing import List, Tuple\n\ndef get_equal(tuple_list: List[Tuple]) -> bool:\n    \"\"\"Checks if all tuples in the input list have equal length.\"\"\"\n    if not isinstance(tuple_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not tuple_list:\n        return True\n\n    if not isinstance(tuple_list[0], tuple):\n        raise TypeError(\"All elements in the list must be tuples.\")\n    first_tuple_length = len(tuple_list[0])\n\n    for i in range(1, len(tuple_list)):\n        current_item = tuple_list[i]\n        if not isinstance(current_item, tuple):\n            raise TypeError(\"All elements in the list must be tuples.\")\n        if len(current_item) != first_tuple_length:\n            return False\n\n    return True"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"Calculates the Bell number for a non-negative integer n using dynamic programming for Stirling numbers.\"\"\"\n    if n == 0:\n        return 1\n\n    # Create a 2D DP table for Stirling numbers of the second kind, S(i, j)\n    # stirling[i][j] stores S(i, j), the number of ways to partition a set of i elements into j non-empty subsets.\n    stirling = [[0 for _ in range(n + 1)] for _ in range(n + 1)]\n\n    # Base case for Stirling numbers: S(0, 0) = 1 (empty set into empty set of subsets)\n    stirling[0][0] = 1\n\n    # Fill the DP table using the recurrence relation: S(i, j) = S(i-1, j-1) + j * S(i-1, j)\n    for i in range(1, n + 1):\n        for j in range(1, i + 1):\n            stirling[i][j] = stirling[i-1][j-1] + j * stirling[i-1][j]\n\n    # The Bell number B(n) is the sum of S(n, k) for k from 0 to n.\n    # S(n, 0) for n > 0 is 0, so we can sum from k=1 to n.\n    # The stirling[n][0] will correctly be 0 for n>0, and stirling[0][0] is 1, so the sum works for all n.\n    bell_n = sum(stirling[n])\n    \n    return bell_n"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(elements: list) -> list:\n    \"\"\"Sorts a list of comparable elements in ascending order using the Comb Sort algorithm.\"\"\"\n    n = len(elements)\n    if n <= 1:\n        return elements[:] # Return a copy to avoid modifying the original for small lists\n\n    arr = elements[:]  # Work on a copy of the list\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if a sub_list is present contiguously and in the same order within a main_list.\n    \"\"\"\n    if not sub_list:\n        return True\n\n    len_main = len(main_list)\n    len_sub = len(sub_list)\n\n    if len_sub > len_main:\n        return False\n\n    for i in range(len_main - len_sub + 1):\n        if main_list[i:i + len_sub] == sub_list:\n            return True\n\n    return False"}
