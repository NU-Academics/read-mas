{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"Checks if a string represents an integer, optionally with a leading sign.\n    The string must not be empty or contain non-digit characters after an optional sign.\"\"\"\n    if not input_string:\n        return False\n\n    start_index = 0\n    if input_string[0] in ('-', '+'):\n        start_index = 1\n        # If there's only a sign and no digits after it, it's not a valid integer.\n        if len(input_string) == 1:\n            return False\n\n    # The remaining part of the string must consist entirely of digits.\n    return input_string[start_index:].isdigit()"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(list_of_lists: list[list[any]]) -> set[any]:\n    \"\"\"\n    Finds common elements in a given list of lists.\n    Returns a set of elements that are present in every sub-list.\n    \"\"\"\n    if not list_of_lists:\n        return set()\n\n    # Convert the first sub-list to a set to initialize the common elements\n    common_elements = set(list_of_lists[0])\n\n    # Iterate through the rest of the sub-lists and find the intersection\n    for sub_list in list_of_lists[1:]:\n        common_elements.intersection_update(set(sub_list))\n\n    return common_elements"}
{"task_id": "Mbpp/109", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef odd_Equivalent(s: str, r: int) -> int:\n    \"\"\"\n    Finds the number of numbers with an odd value when rotating a binary string.\n    It performs rotations and counts how many resulting decimal values are odd.\n    \"\"\"\n\n    # Helper functions and classes are defined inline to meet strict response constraints.\n\n    def _validate_binary_string(s_param: str) -> None:\n        \"\"\"Validates if a string contains only '0' and '1' characters.\"\"\"\n        if not s_param or not all(c in '01' for c in s_param):\n            raise InvalidInputError(f\"Invalid binary string: '{s_param}'\")\n\n    def _validate_rotation_count(r_param: int) -> None:\n        \"\"\"Validates if an integer is non-negative.\"\"\"\n        if r_param < 0:\n            raise InvalidInputError(f\"Rotation count must be a non-negative integer: {r_param}\")\n\n    def _rotate_left(s_param: str) -> str:\n        \"\"\"Performs a single left rotation on a binary string.\"\"\"\n        if not s_param:\n            return \"\"\n        return s_param[1:] + s_param[0]\n\n    def _to_decimal(s_param: str) -> int:\n        \"\"\"Converts a binary string to its decimal integer equivalent.\"\"\"\n        # _validate_binary_string ensures s_param is a valid, non-empty binary string.\n        return int(s_param, 2)\n\n    def _is_odd(decimal_value: int) -> bool:\n        \"\"\"Determines if a decimal integer is odd.\"\"\"\n        return decimal_value % 2 != 0\n\n    # Main orchestration logic\n    _validate_binary_string(s)\n    _validate_rotation_count(r)\n\n    odd_count = 0\n    current_s = s\n\n    # If the string is empty after validation, it cannot produce any decimal equivalents.\n    if not current_s:\n        return 0\n\n    for _ in range(r):\n        current_s = _rotate_left(current_s)\n        decimal_value = _to_decimal(current_s)\n        if _is_odd(decimal_value):\n            odd_count += 1\n\n    return odd_count"}
{"task_id": "Mbpp/119", "solution": "def search(arr: list[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear exactly twice.\n    Assumes the input array is sorted and all elements except one appear exactly twice.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n\n        # If mid is odd, make it even to ensure we're always comparing (mid, mid+1)\n        # or (mid-1, mid) consistently from an even index perspective.\n        if mid % 2 == 1:\n            mid -= 1\n\n        # Check if arr[mid] is part of a pair\n        if arr[mid] == arr[mid + 1]:\n            # The pair is on the left, so the unique element must be on the right\n            low = mid + 2\n        else:\n            # arr[mid] is either the unique element or the unique element is on the left\n            high = mid\n\n    return arr[low]"}
