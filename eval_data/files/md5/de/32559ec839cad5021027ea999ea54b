{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"\n    Determines if the given number is a Woodall number.\n    A Woodall number is of the form n * 2^n - 1 for a non-negative integer n.\n    \"\"\"\n    if number < -1:\n        return False\n\n    n = 0\n    while True:\n        woodall_candidate = n * (2**n) - 1\n        if woodall_candidate == number:\n            return True\n        if woodall_candidate > number and n > 0:\n            return False\n        if n > 63 and number > 0:\n            return False\n        n += 1"}
{"task_id": "Mbpp/56", "solution": "def check(num: int) -> bool:\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    The number is converted to a string, reversed, and then checked against the condition.\n    \"\"\"\n    num_str = str(num)\n    reversed_num_str = num_str[::-1]\n    reversed_num = int(reversed_num_str)\n    \n    return num == (2 * reversed_num) - 1"}
{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits: list[int]) -> int:\n    \"\"\"\n    Forms the largest possible number from a given list of digits.\n    Uses custom string comparison to sort digits for concatenation.\n    \"\"\"\n    if not digits:\n        return 0\n\n    # Convert digits to strings for custom sorting\n    str_digits = [str(d) for d in digits]\n\n    # Custom sort: a comes before b if a+b > b+a\n    # This greedy approach ensures the largest number is formed\n    str_digits.sort(key=lambda x: x * 10, reverse=True) # Optimized key for single/double digit comparison\n\n    # Special handling for all zeros case, e.g., [0, 0, 0] should be 0\n    if str_digits[0] == '0':\n        return 0\n\n    # Join sorted strings and convert to integer\n    return int(\"\".join(str_digits))"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(input_string: str) -> int:\n    \"\"\"\n    Counts the number of substrings in the input_string where the sum of digits\n    in the substring equals its length.\n    \"\"\"\n    n = len(input_string)\n    valid_substring_count = 0\n\n    for i in range(n):\n        current_sum = 0\n        for j in range(i, n):\n            # Length of current substring is (j - i) + 1\n            substring_length = (j - i) + 1\n\n            # Add the current digit to the sum\n            current_sum += int(input_string[j])\n\n            # Check if sum of digits equals length\n            if current_sum == substring_length:\n                valid_substring_count += 1\n    return valid_substring_count"}
