{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) from i=0 to n // 2,\n    including only terms strictly greater than 0.\n    \"\"\"\n    total = 0\n    # Iterate from i=0 up to n // 2 (inclusive)\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        if term > 0:\n            total += term\n    return total"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integer solutions (x, y) for the equation ax + by = n.\n    Returns a tuple (x, y) if a solution exists, otherwise returns None.\n    \"\"\"\n    def gcd(num1: int, num2: int) -> int:\n        \"\"\"Calculates the greatest common divisor of two integers.\"\"\"\n        while num2:\n            num1, num2 = num2, num1 % num2\n        return num1\n\n    def extended_gcd(num1: int, num2: int) -> tuple[int, int, int]:\n        \"\"\"\n        Implements the Extended Euclidean Algorithm.\n        Returns (gcd_val, x, y) such that num1*x + num2*y = gcd_val.\n        \"\"\"\n        if num1 == 0:\n            return num2, 0, 1\n        gcd_val, x1, y1 = extended_gcd(num2 % num1, num1)\n        x = y1 - (num2 // num1) * x1\n        y = x1\n        return gcd_val, x, y\n\n    common_divisor = gcd(a, b)\n\n    if n % common_divisor != 0:\n        return None  # No integer solution exists\n\n    # Scale the equation by dividing by common_divisor\n    # a'x + b'y = n' where a' = a/d, b' = b/d, n' = n/d\n    # This ensures a' and b' are coprime.\n    \n    # Use extended_gcd for the original a, b to find initial x0, y0\n    # such that a*x0 + b*y0 = common_divisor\n    _, x0, y0 = extended_gcd(a, b)\n\n    # Scale x0, y0 to find a particular solution for ax + by = n\n    # Multiply x0 and y0 by (n / common_divisor)\n    k = n // common_divisor\n    x = x0 * k\n    y = y0 * k\n\n    return x, y"}
{"task_id": "Mbpp/161", "solution": "from typing import Any\n\ndef remove_elements(primary_list: list[Any], secondary_list: list[Any]) -> list[Any]:\n    \"\"\"\n    Removes all elements from primary_list that are present in secondary_list.\n    Returns a new list without modifying the original lists.\n    \"\"\"\n    secondary_set = set(secondary_list)\n    result_list = []\n    for item in primary_list:\n        if item not in secondary_set:\n            result_list.append(item)\n    return result_list"}
{"task_id": "Mbpp/165", "solution": "def _get_alphabetical_position(char: str) -> int | None:\n    \"\"\"\n    Determines the 0-indexed alphabetical position of a character (a=0, b=1, ..., z=25).\n    Case-insensitive.\n    \"\"\"\n    lower_char = char.lower()\n    if 'a' <= lower_char <= 'z':\n        return ord(lower_char) - ord('a')\n    return None\n\ndef count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in an input string where the character's 0-indexed string position\n    matches its 0-indexed alphabetical position (case-insensitive).\n    \"\"\"\n    count = 0\n    for index, char in enumerate(input_string):\n        string_pos = index\n        alphabetical_pos = _get_alphabetical_position(char)\n\n        if alphabetical_pos is not None and string_pos == alphabetical_pos:\n            count += 1\n    return count"}
