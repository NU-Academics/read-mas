{"task_id": "Mbpp/282", "solution": "def sub_list(list1: list[int | float], list2: list[int | float]) -> list[int | float]:\n    \"\"\"\n    Subtracts elements of the second list from the corresponding elements of the first list.\n    Performs element-wise subtraction after validating list lengths and element types.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise ValueError(\"Input lists must have the same length for element-wise subtraction.\")\n\n    result_list = []\n    for i in range(len(list1)):\n        val1 = list1[i]\n        val2 = list2[i]\n\n        if not isinstance(val1, (int, float)) or not isinstance(val2, (int, float)):\n            raise TypeError(\"Both lists must contain only numeric (int or float) elements.\")\n\n        result_list.append(val1 - val2)\n\n    return result_list"}
{"task_id": "Mbpp/283", "solution": "import collections\n\ndef validate(integer: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in the integer is less than or equal to the digit itself.\n    Handles negative integers by converting them to their absolute value.\n    \"\"\"\n    s_integer = str(abs(integer))\n    digit_counts = collections.Counter(s_integer)\n\n    for char_digit, frequency in digit_counts.items():\n        digit = int(char_digit)\n        if digit == 0:\n            # According to the problem statement, a digit's frequency must be <= the digit itself.\n            # If the digit is 0, its frequency can only be <= 0 if it doesn't appear, or if it appears 0 times.\n            # However, if it appears, its frequency will be >= 1, making the condition 1 <= 0 false.\n            # Therefore, if '0' appears, this condition is violated.\n            if frequency > 0:\n                return False\n        elif frequency > digit:\n            return False\n            \n    return True"}
