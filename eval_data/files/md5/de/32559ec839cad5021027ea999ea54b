{"task_id": "Mbpp/410", "solution": "from typing import Any, Union\n\ndef _is_numerical(element: Any) -> bool:\n    \"\"\"\n    Checks if an element is an integer or a float.\n    \"\"\"\n    return isinstance(element, (int, float))\n\ndef min_val(input_list: list) -> Union[int, float]:\n    \"\"\"\n    Finds the minimum numerical value in a heterogeneous list.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    numerical_elements = []\n    for element in input_list:\n        if _is_numerical(element):\n            numerical_elements.append(element)\n\n    if not numerical_elements:\n        raise ValueError(\"No numerical elements found in the list.\")\n\n    minimum_value = numerical_elements[0]\n    for num in numerical_elements[1:]:\n        if num < minimum_value:\n            minimum_value = num\n\n    return minimum_value"}
{"task_id": "Mbpp/414", "solution": "from typing import Iterable, Any\n\ndef overlapping(sequence1: Iterable[Any], sequence2: Iterable[Any]) -> bool:\n    \"\"\"\n    Determines if any value from sequence1 exists within sequence2.\n    Optimizes performance by converting the smaller sequence to a set for efficient lookups.\n    \"\"\"\n    # Convert the smaller sequence to a set for efficient O(1) average time complexity lookups.\n    # This optimizes for performance, achieving O(min(N, M) + max(N, M)) or O(N+M) average.\n    \n    # Handle the case where sequences might be generators or very long, by first trying to determine length.\n    # For common sequence types like list, tuple, set, len() works directly.\n    # For generic iterables where len() might not be supported, we need a safer approach.\n    # The design context implies that `len()` will be used, so we assume sequences allow `len()`.\n    \n    # Create temporary lists to ensure len() and iteration are safe, especially if inputs are generators\n    # and need to be iterated multiple times or require len().\n    # However, the design context implies direct use of sequence1 and sequence2 for len().\n    # Let's stick to the design's explicit use of len() directly on sequence1 and sequence2.\n    \n    # Cast to list for consistent length check and iteration, preventing potential exhaustion of generators\n    # if `len()` were not supported or if the original iterables were consumed in a prior step not shown.\n    # The problem asks for minimal changes from the design, so direct len() and set() conversion is assumed valid.\n    \n    s1_list = list(sequence1)\n    s2_list = list(sequence2)\n\n    if len(s1_list) <= len(s2_list):\n        set_for_lookup = set(s1_list)\n        iterable_to_check = s2_list\n    else:\n        set_for_lookup = set(s2_list)\n        iterable_to_check = s1_list\n\n    for item in iterable_to_check:\n        if item in set_for_lookup:\n            return True\n    return False"}
{"task_id": "Mbpp/412", "solution": "def _is_even(number: int) -> bool:\n    \"\"\"Determines if a given integer is an even number.\"\"\"\n    return number % 2 == 0\n\ndef remove_odd(input_list: list[int]) -> list[int]:\n    \"\"\"Removes odd numbers from a list of integers, returning a new list containing only the even numbers.\"\"\"\n    filtered_list = []\n    for number in input_list:\n        if _is_even(number):\n            filtered_list.append(number)\n    return filtered_list"}
