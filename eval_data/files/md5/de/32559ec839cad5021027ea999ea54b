{"task_id": "Mbpp/4", "solution": "import heapq\ndef heap_queue_largest(list_of_numbers: list[int], n: int) -> list[int]:\n    \"\"\"Finds the n largest integers from a list, returned in descending order.\n    Uses heapq.nlargest for efficiency.\n    \"\"\"\n    if not list_of_numbers:\n        raise ValueError(\"Input list cannot be empty.\")\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n    if n > len(list_of_numbers):\n        raise ValueError(\"n cannot exceed the length of the list.\")\n\n    return heapq.nlargest(n, list_of_numbers)"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base_triangle_base: float, base_triangle_height: float, prism_length: float) -> float:\n    \"\"\"Calculates the volume of a triangular prism.\n    Raises ValueError if any input dimension is not positive.\n    \"\"\"\n    if not (base_triangle_base > 0 and base_triangle_height > 0 and prism_length > 0):\n        raise ValueError(\"All dimensions (base, height, length) must be positive numerical values.\")\n\n    base_area = 0.5 * base_triangle_base * base_triangle_height\n    volume = base_area * prism_length\n    return volume"}
