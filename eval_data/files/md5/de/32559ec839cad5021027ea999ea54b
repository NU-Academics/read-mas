{"task_id": "Mbpp/780", "solution": "import itertools\nfrom typing import List, Tuple\n\ndef find_combinations(tuple_list: List[Tuple[int, int]]) -> List[Tuple[int, int]]:\n    \"\"\"\n    Calculates unique sum combinations of two-element numerical tuples.\n    \"\"\"\n    results_list = []\n    for t1, t2 in itertools.combinations(tuple_list, 2):\n        sum_tuple = (t1[0] + t2[0], t1[1] + t2[1])\n        results_list.append(sum_tuple)\n    return results_list"}
{"task_id": "Mbpp/784", "solution": "def is_even(number: int) -> bool:\n    \"\"\"Checks if a given integer is even.\"\"\"\n    return number % 2 == 0\n\ndef is_odd(number: int) -> bool:\n    \"\"\"Checks if a given integer is odd.\"\"\"\n    return number % 2 != 0\n\ndef find_first_even(numbers: list[int]) -> int | None:\n    \"\"\"Finds the first even number in a list.\"\"\"\n    for num in numbers:\n        if is_even(num):\n            return num\n    return None\n\ndef find_first_odd(numbers: list[int]) -> int | None:\n    \"\"\"Finds the first odd number in a list.\"\"\"\n    for num in numbers:\n        if is_odd(num):\n            return num\n    return None\n\ndef mul_even_odd(numbers: list[int]) -> int | None:\n    \"\"\"\n    Finds the product of the first even and first odd number in a given list.\n    Returns None if either the first even or first odd number is not found.\n    \"\"\"\n    first_odd = find_first_odd(numbers)\n    first_even = find_first_even(numbers)\n\n    if first_odd is None or first_even is None:\n        return None\n    else:\n        return first_odd * first_even"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the total sum of all elements across all odd-length subarrays\n    of a given list of numbers.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        for j in range(i, n):\n            subarray = arr[i : j + 1]\n            if len(subarray) % 2 == 1:\n                total_sum += sum(subarray)\n\n    return total_sum"}
{"task_id": "Mbpp/787", "solution": "import re\n\ndef text_match_three(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input string contains the pattern 'a' followed by exactly three 'b's.\n    \"\"\"\n    pattern = r'abbb'\n    return bool(re.search(pattern, input_string))"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_str: str) -> tuple[int, ...]:\n    \"\"\"Converts a string representation of a tuple of integers into an actual tuple of integers.\n    This function parses the string by removing parentheses, splitting by commas, and converting elements to integers.\n    \"\"\"\n    content = tuple_str[1:-1].strip()\n    if not content:\n        return ()\n\n    elements_str = content.split(',')\n    integer_elements = []\n    for element_str in elements_str:\n        integer_elements.append(int(element_str.strip()))\n\n    return tuple(integer_elements)"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list: list, value: object) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in a sorted list.\n    This implementation uses a binary search algorithm.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if value < sorted_list[mid]:\n            high = mid\n        else: # value >= sorted_list[mid]\n            low = mid + 1\n    return low"}
{"task_id": "Mbpp/790", "solution": "def even_position(list_of_numbers: list[int]) -> bool:\n    \"\"\"\n    Checks whether every even index in the given list contains an even number.\n    Returns True for an empty list.\n    \"\"\"\n    for i in range(0, len(list_of_numbers), 2):\n        if list_of_numbers[i] % 2 != 0:\n            return False\n    return True"}
{"task_id": "Mbpp/794", "solution": "import re\n\ndef text_starta_endb(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input string starts with 'a', is followed by any characters,\n    and ends with 'b'.\n    \"\"\"\n    pattern = r'^a.*b$'\n    return bool(re.fullmatch(pattern, input_string))"}
{"task_id": "Mbpp/788", "solution": "def new_tuple(input_list: list, input_string: str) -> tuple:\n    \"\"\"\n    Creates a new tuple by combining elements from a list and a string.\n    The string is appended as the last element of the new tuple.\n    \"\"\"\n    return tuple(input_list) + (input_string,)"}
{"task_id": "Mbpp/791", "solution": "def remove_nested(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Removes nested tuples from the given tuple.\n    Returns a new tuple containing only the non-tuple elements, maintaining their original order.\n    \"\"\"\n    filtered_elements = []\n    for element in input_tuple:\n        if not isinstance(element, tuple):\n            filtered_elements.append(element)\n    return tuple(filtered_elements)"}
{"task_id": "Mbpp/792", "solution": "def count_list(input_list: list) -> int:\n    \"\"\"\n    Counts the number of elements in the input_list that are themselves lists.\n    \"\"\"\n    count = 0\n    for element in input_list:\n        if isinstance(element, list):\n            count += 1\n    return count"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l: int, r: int) -> int:\n    \"\"\"Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Natural numbers start from 1.\n    \"\"\"\n    total_sum = 0\n    # Natural numbers start from 1, so the lower bound for iteration is at least 1.\n    start = max(1, l) \n    \n    for num in range(start, r + 1):\n        if num % 2 != 0:  # Check if the number is odd\n            total_sum += num\n            \n    return total_sum"}
{"task_id": "Mbpp/793", "solution": "from typing import List, Any\n\ndef last(arr: List[Any], element: Any) -> int:\n    \"\"\"\n    Finds the last (highest) position of an element in a sorted array.\n\n    Args:\n        arr (List[Any]): The sorted input array.\n        element (Any): The element to search for.\n\n    Returns:\n        int: The highest index at which the element is present, or -1 if not found.\n    \"\"\"\n    for i in range(len(arr) - 1, -1, -1):\n        if arr[i] == element:\n            return i\n    return -1"}
{"task_id": "Mbpp/796", "solution": "def return_sum(input_dict: dict) -> (int | float):\n    \"\"\"\n    Calculates the sum of all numeric values in the given dictionary.\n    Non-numeric values are ignored.\n    \"\"\"\n    total_sum = 0\n    for value in input_dict.values():\n        if isinstance(value, (int, float)):\n            total_sum += value\n    return total_sum"}
{"task_id": "Mbpp/798", "solution": "def _sum(array: list) -> (int | float):\n    \"\"\"Calculates the sum of numerical elements in a list.\n    Ignores non-numerical elements and returns 0 for an empty list.\"\"\"\n    total = 0\n    for element in array:\n        if isinstance(element, (int, float)):\n            total += element\n    return total"}
{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(number: int) -> bool:\n    \"\"\"Checks if a given integer is a perfect square.\"\"\"\n    if number < 0:\n        return False\n    sqrt_num = math.isqrt(number)\n    return sqrt_num * sqrt_num == number"}
{"task_id": "Mbpp/804", "solution": "from typing import List, Union\nimport math\n\ndef is_product_even(numbers: List[Union[int, float]]) -> bool:\n    \"\"\"\n    Determines if the product of numbers in a list is even.\n    \"\"\"\n    def _is_number_even(number: Union[int, float]) -> bool:\n        \"\"\"Checks if a single number is even.\"\"\"\n        if isinstance(number, float):\n            return number == int(number) and int(number) % 2 == 0\n        return number % 2 == 0\n\n    def _calculate_product(numbers: List[Union[int, float]]) -> Union[int, float]:\n        \"\"\"Calculates the product of numbers in a list.\"\"\"\n        if not numbers:\n            return 1\n        return math.prod(numbers)\n\n    if not numbers:\n        return False # 1 is odd\n\n    for num in numbers:\n        if _is_number_even(num):\n            return True\n\n    product = _calculate_product(numbers)\n    return _is_number_even(product)"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(number: int, d_bits: int) -> int:\n    \"\"\"\n    Rotates the bits of a 32-bit integer to the left by d_bits.\n    \"\"\"\n    NUM_BITS = 32\n    effective_shift = d_bits % NUM_BITS\n    \n    # Perform the left shift and capture the bits that wrap around\n    rotated_value = (number << effective_shift) | (number >> (NUM_BITS - effective_shift))\n    \n    # Mask the result to ensure it remains within 32 bits\n    return rotated_value & 0xFFFFFFFF"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(input_string: str) -> str:\n    \"\"\"\n    Removes all whitespace characters from the input string.\n    \"\"\"\n    return \"\".join(input_string.split())"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"Counts the number of equal numbers from three given integers.\n    Returns 3 if all are equal, 2 if exactly two are equal, or 0 if none are equal.\n    \"\"\"\n    unique_numbers = len({a, b, c})\n    if unique_numbers == 1:\n        return 3\n    elif unique_numbers == 2:\n        return 2\n    else:  # unique_numbers == 3\n        return 0"}
{"task_id": "Mbpp/805", "solution": "```python\ndef max_sum_list(list_of_lists: list[list[int]]) -> list[int]:\n    \"\"\"\n    Returns the sub-list with the highest sum of elements from a given list of lists.\n    Returns an empty list if the input list is empty.\n    \"\"\"\n    if not list_of_lists:\n        return []\n\n    max_sum = float('-inf')\n    max_sublist = []\n\n    for sublist in list_of_lists:\n        current_sum = sum(sublist)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            max_sublist = sublist\n\n    return max_sublist\n```"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"Finds the maximum run of uppercase characters in the given string.\n\n    Args:\n        input_string: The string to analyze.\n\n    Returns:\n        The length of the maximum contiguous run of uppercase characters.\n    \"\"\"\n    current_max_run = 0\n    current_run = 0\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n        else:\n            current_run = 0\n        current_max_run = max(current_max_run, current_run)\n    return current_max_run"}
