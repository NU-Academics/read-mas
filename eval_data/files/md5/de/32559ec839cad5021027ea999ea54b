{"task_id": "Mbpp/765", "solution": "def find_nth_polite_number(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number.\n    A polite number is a positive integer that is not a power of 2.\n    \"\"\"\n\n    def is_power_of_two(num: int) -> bool:\n        \"\"\"Checks if a positive integer is a power of two.\"\"\"\n        return num > 0 and (num & (num - 1)) == 0\n\n    def is_polite(num: int) -> bool:\n        \"\"\"Checks if a positive integer is a polite number.\"\"\"\n        return num > 0 and not is_power_of_two(num)\n\n    polite_count = 0\n    num = 0\n    while polite_count < n:\n        num += 1\n        if is_polite(num):\n            polite_count += 1\n    return num"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list[int], target_sum: int) -> int:\n    \"\"\"\n    Counts the number of pairs in a list whose sum equals a target value.\n    This function iterates through all unique pairs of numbers and increments a counter if their sum matches the target.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
