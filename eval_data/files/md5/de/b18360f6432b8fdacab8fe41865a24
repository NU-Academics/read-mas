{"task_id": "HumanEval/65", "solution": "def circular_shift(x: int, shift: int) -> str:\n    \"\"\"Circularly shifts digits of x right by shift. Reverses digits if shift exceeds number of digits.\"\"\"\n    s_x = str(x)\n    num_digits = len(s_x)\n\n    if shift > num_digits:\n        return s_x[::-1]\n    else:\n        effective_shift = shift % num_digits\n        if effective_shift == 0:\n            return s_x\n        shifted_part = s_x[-effective_shift:]\n        remaining_part = s_x[:-effective_shift]\n        return shifted_part + remaining_part"}
{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s,n):\n    \"\"\"\n    Parses a string for apple and orange counts, then calculates the number of mangoes.\n    It subtracts the sum of known fruits from the total number of fruits.\n    \"\"\"\n\n    # Extract apple count from the string\n    parts = s.split(\" apples and \")\n    apple_count = int(parts[0])\n\n    # Extract orange count from the remaining part of the string\n    orange_part = parts[1]\n    orange_count = int(orange_part.split(\" oranges\")[0])\n\n    # Calculate the total number of apples and oranges\n    total_known_fruits = apple_count + orange_count\n\n    # Calculate the number of mango fruits\n    mango_count = n - total_known_fruits\n\n    return mango_count"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    >>> vowels_count(\"hello\")\n    2\n    >>> vowels_count(\"rhythm\")\n    0\n    >>> vowels_count(\"sky\")\n    1\n    >>> vowels_count(\"fly\")\n    1\n    >>> vowels_count(\"gym\")\n    0\n    >>> vowels_count(\"myth\")\n    0\n    >>> vowels_count(\"why\")\n    1\n    >>> vowels_count(\"\")\n    0\n    >>> vowels_count(\"b\")\n    0\n    >>> vowels_count(\"a\")\n    1\n    >>> vowels_count(\"aeiou\")\n    5\n    >>> vowels_count(\"bcdfgh\")\n    0\n    >>> vowels_count(\"AaEeIiOoUu\")\n    10\n    >>> vowels_count(\"PYTHON\")\n    1\n    >>> vowels_count(\"happy\")\n    2\n    >>> vowels_count(\"funny\")\n    2\n    >>> vowels_count(\"xylophone\")\n    4\n    >>> vowels_count(\"EGYPT\")\n    1\n    >>> vowels_count(\"lovely\")\n    3\n    >>> vowels_count(\"syzygy\")\n    1\n    \"\"\"\n    count = 0\n    s_lower = s.lower()\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    for i, char in enumerate(s_lower):\n        if char in standard_vowels:\n            count += 1\n        elif char == 'y' and i == len(s_lower) - 1:\n            count += 1\n    return count"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket.\n    It parses apple and orange counts from the string and subtracts them from the total.\n    \"\"\"\n    apple_match = re.search(r'(\\d+)\\s*apples', s)\n    orange_match = re.search(r'(\\d+)\\s*oranges', s)\n\n    apples = int(apple_match.group(1))\n    oranges = int(orange_match.group(1))\n\n    mangoes = n - apples - oranges\n\n    return mangoes"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Identifies the smallest even-valued node and its index from an array of non-negative integers.\n    It applies tie-breaking by choosing the node with the smallest index if values are equal.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            elif value == smallest_even_value:\n                # Apply tie-breaking: select the node with the smallest index\n                if index < smallest_even_index:\n                    smallest_even_index = index\n\n    if smallest_even_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr: list[int]) -> list[int]:\n    \"\"\"\n    Identifies the node with the smallest even value in an array, prioritizing\n    the smallest index for ties, or returns an empty list if none are found.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            elif value == smallest_even_value:\n                # If values are equal, prioritize the smallest index\n                if index < smallest_even_index:\n                    smallest_even_index = index\n\n    if smallest_even_value == float('inf'):\n        return []  # No even values were found\n    else:\n        return [int(smallest_even_value), smallest_even_index]"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\ndef search(lst):\n    \"\"\"\n    Finds the greatest integer 'x' in the list where its frequency is greater than or equal to 'x'.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    frequencies = Counter(lst)\n    max_candidate = -1\n\n    for number, freq in frequencies.items():\n        if freq >= number:\n            max_candidate = max(max_candidate, number)\n\n    return max_candidate"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given a list of integers, this function sorts it in a strange order\n    by alternately selecting the minimum and maximum remaining elements.\n    '''\n    if not lst:\n        return []\n\n    working_list = list(lst)\n    result_list = []\n    is_min_turn = True\n\n    while working_list:\n        if is_min_turn:\n            element = min(working_list)\n        else:\n            element = max(working_list)\n\n        result_list.append(element)\n        working_list.remove(element)\n        is_min_turn = not is_min_turn\n\n    return result_list"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers into a strange order, alternating minimum and maximum values.\n    It handles empty input lists by returning an empty list.\n    \"\"\"\n    if not lst:\n        return []\n\n    # Create a sorted copy of the input list.\n    working_list = sorted(list(lst))\n    result = []\n    is_min_turn = True\n\n    while working_list:\n        if is_min_turn:\n            # Select the minimum element (first in the sorted list)\n            result.append(working_list.pop(0))\n        else:\n            # Select the maximum element (last in the sorted list)\n            result.append(working_list.pop())\n        is_min_turn = not is_min_turn\n\n    return result"}
