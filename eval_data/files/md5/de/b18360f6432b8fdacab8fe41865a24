{"task_id": "HumanEval/47", "solution": "class NumberList:\n    \"\"\"Manages a collection of numbers, providing sorted access and size information.\"\"\"\n    def __init__(self, numbers: list[int | float]):\n        self._elements = [float(n) for n in numbers]\n\n    def get_sorted_elements(self) -> list[float]:\n        \"\"\"Returns a new list containing the elements sorted in ascending order.\"\"\"\n        return sorted(self._elements)\n\n    def size(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self._elements)\nclass MedianResult:\n    \"\"\"Encapsulates the calculated median value and provides type-aware retrieval.\"\"\"\n    def __init__(self, value: float):\n        self._value = value\n\n    def is_integer(self) -> bool:\n        \"\"\"Checks if the median value is an integer (i.e., has no fractional part).\"\"\"\n        return self._value % 1 == 0\n\n    def get_integer_value(self) -> int:\n        \"\"\"Returns the median value as an integer.\"\"\"\n        return int(self._value)\n\n    def get_float_value(self) -> float:\n        \"\"\"Returns the median value as a float.\"\"\"\n        return self._value\nclass MedianCalculator:\n    \"\"\"Implements the core logic for calculating the median from a NumberList.\"\"\"\n    def calculate_median(self, number_list: NumberList) -> MedianResult:\n        \"\"\"Calculates the median of the numbers in the number_list.\"\"\"\n        sorted_elements = number_list.get_sorted_elements()\n        list_size = number_list.size()\n\n        if list_size % 2 == 1:\n            # Odd number of elements, median is the middle element\n            median_value = sorted_elements[list_size // 2]\n        else:\n            # Even number of elements, median is the average of the two middle elements\n            mid1 = sorted_elements[list_size // 2 - 1]\n            mid2 = sorted_elements[list_size // 2]\n            median_value = (mid1 + mid2) / 2.0\n\n        return MedianResult(median_value)\ndef median(l: list[int | float]) -> int | float:\n    \"\"\"Return median of elements in the list l. The result is an int if the median is whole, otherwise a float.\"\"\"\n    number_list = NumberList(l)\n    calculator = MedianCalculator()\n    result = calculator.calculate_median(number_list)\n\n    if result.is_integer():\n        return result.get_integer_value()\n    else:\n        return result.get_float_value()"}
