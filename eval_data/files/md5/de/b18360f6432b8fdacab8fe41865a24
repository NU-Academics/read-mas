{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\"Decomposes a positive floating-point number into its integer and decimal parts, returning only the decimal.\n    \"\"\"\n    integer_part = int(number) # Get the integer portion of the number.\n    decimal_part = number - integer_part # Subtract the integer part to obtain the decimal part.\n    return decimal_part"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    \"\"\"\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"\n    Separates multiple groups of nested parentheses into separate strings.\n    Each group should be balanced and not nested within other groups.\n    \"\"\"\n    cleaned_string = paren_string.replace(' ', '')\n    result_groups = []\n    balance_counter = 0\n    current_group_start_index = -1\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            if balance_counter == 0:\n                # Start of a new top-level group\n                current_group_start_index = i\n            balance_counter += 1\n        elif char == ')':\n            balance_counter -= 1\n\n            if balance_counter == 0 and current_group_start_index != -1:\n                # End of a balanced, top-level group\n                group = cleaned_string[current_group_start_index : i + 1]\n                result_groups.append(group)\n                current_group_start_index = -1 # Reset for next group\n\n    return result_groups"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    def _remove_spaces(s: str) -> str:\n        \"\"\"Removes all space characters from the input string.\"\"\"\n        return s.replace(\" \", \"\")\n\n    def _is_balanced(s: str) -> bool:\n        \"\"\"Checks if the parentheses in a string are balanced.\n        It ignores non-parenthesis characters for balance counting.\"\"\"\n        count = 0\n        for char in s:\n            if char == '(':\n                count += 1\n            elif char == ')':\n                count -= 1\n            if count < 0:\n                return False\n        return count == 0\n\n    def _find_top_level_groups(s: str) -> List[str]:\n        \"\"\"Identifies potential top-level parenthesis groups based on parenthesis balance.\n        It returns segments that start and end with a balance of zero, or trailing unclosed segments.\"\"\"\n        groups = []\n        balance = 0\n        current_group_start_index = 0\n\n        for i, char in enumerate(s):\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n\n            if balance == 0:\n                # A potential top-level group has closed.\n                if i >= current_group_start_index:\n                    groups.append(s[current_group_start_index : i + 1])\n                current_group_start_index = i + 1\n            elif balance < 0:\n                # Malformed sequence (e.g., starts with ')' or ')(a)').\n                # Reset balance and start index to look for a new group from this point.\n                balance = 0\n                current_group_start_index = i + 1\n\n        # After the loop, if there's any remaining part of the string that was being tracked\n        # (i.e., balance never returned to zero for it), add it as a potential group.\n        if current_group_start_index < len(s):\n            groups.append(s[current_group_start_index:])\n\n        return groups\n\n\n    cleaned_string = _remove_spaces(paren_string)\n\n    potential_groups = _find_top_level_groups(cleaned_string)\n\n    result = []\n    for group in potential_groups:\n        if _is_balanced(group):\n            result.append(group)\n\n    return result"}
{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"Detects if an account balance, starting at zero, ever falls below zero after operations.\n    Returns True if balance dips below zero, False otherwise.\n    \"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    balance = 0\n    for operation in operations:\n        balance += operation\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"Checks if any two distinct numbers in the list are closer than the given threshold.\n    Returns True if a close pair is found, False otherwise.\"\"\"\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    integer_part = int(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\"\"\"\n\n    mean_value = sum(numbers) / len(numbers)\n    absolute_differences_sum = sum(abs(number - mean_value) for number in numbers)\n    mad = absolute_differences_sum / len(numbers)\n    return mad"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'.\n    Returns a new list with the delimiter interspersed.\n    \"\"\"\n    if not numbers:\n        return []\n\n    result_list = []\n    for i in range(len(numbers) - 1):\n        result_list.append(numbers[i])\n        result_list.append(delimeter)\n    result_list.append(numbers[-1])\n\n    return result_list"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    MAD = average | x - x_mean |\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    x_mean = sum(numbers) / len(numbers)\n\n    sum_abs_diff = 0.0\n    for x in numbers:\n        sum_abs_diff += abs(x - x_mean)\n\n    mad = sum_abs_diff / len(numbers)\n    return mad"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Parses a string of parentheses groups separated by spaces.\n    It returns a list where each integer represents the deepest nesting level for its corresponding group.\n    \"\"\"\n    groups = paren_string.split(' ')\n    results = []\n    for group in groups:\n        # Calculate the deepest level of nesting for a single group.\n        current_depth = 0\n        max_depth = 0\n        stripped_group = group.strip()\n        if stripped_group:\n            for char in stripped_group:\n                if char == '(':\n                    current_depth += 1\n                    max_depth = max(max_depth, current_depth)\n                elif char == ')':\n                    current_depth -= 1\n            results.append(max_depth)\n    return results"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef _calculate_single_group_nesting(group_string: str) -> int:\n    \"\"\"Calculates the deepest nesting level for a single group of parentheses.\n    It tracks the current and maximum nesting levels during iteration.\n    \"\"\"\n    current_level = 0\n    max_level = 0\n    for char in group_string:\n        if char == '(':\n            current_level += 1\n            max_level = max(max_level, current_level)\n        elif char == ')':\n            current_level -= 1\n    return max_level\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    results = []\n    groups = paren_string.split(' ')\n    for group_string in groups:\n        if group_string: # Process only non-empty group strings\n            deepest_level = _calculate_single_group_nesting(group_string)\n            results.append(deepest_level)\n    return results"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"Calculates the sum and product of a list of integers.\n    Handles an empty list by returning a sum of 0 and a product of 1.\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    for num in numbers:\n        current_sum += num\n        current_product *= num\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/9", "solution": "from typing import List\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"\n    From a given list of integers, generate a list of rolling maximum elements found until the given moment\n    in the sequence.\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    current_max = float('-inf') # Initialize with negative infinity to handle any first integer\n\n    for num in numbers:\n        current_max = max(current_max, num)\n        result.append(current_max)\n\n    return result"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\"Test if given string is a palindrome.\n    Compares the string with its reversed version.\"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\"Find the shortest palindrome that begins with a supplied string.\n    Identifies the longest palindromic postfix and appends the reversed prefix.\"\"\"\n    if not string:\n        return \"\"\n\n    longest_palindromic_postfix = \"\"\n    prefix_before_postfix = string\n\n    # Iterate through all possible postfixes, from longest to shortest.\n    # 'i' represents the starting index of the postfix within the original string.\n    for i in range(len(string) + 1):\n        current_postfix = string[i:]\n        if is_palindrome(current_postfix):\n            longest_palindromic_postfix = current_postfix\n            prefix_before_postfix = string[:i]\n            break  # Found the longest palindromic postfix, so break.\n\n    reversed_prefix = prefix_before_postfix[::-1]\n    return string + reversed_prefix"}
{"task_id": "HumanEval/11", "solution": "from typing import List\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    # The design's validation and length checks are omitted due to critical requirements.\n    # This function trusts inputs are binary strings of equal length for direct XOR.\n    result_chars = []\n    for i in range(len(a)):\n        xor_val = int(a[i]) ^ int(b[i])\n        result_chars.append(str(xor_val))\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome. \"\"\"\n    return string == string[::-1]\ndef _find_longest_palindromic_postfix(s: str) -> str:\n    \"\"\" Identifies the longest postfix of a string that is a palindrome. \"\"\"\n    for i in range(len(s)):\n        postfix = s[i:]\n        if is_palindrome(postfix):\n            return postfix\n    return \"\"\ndef _get_prefix_before_postfix(s: str, postfix: str) -> str:\n    \"\"\" Extracts the prefix of a string that comes before a specified postfix. \"\"\"\n    return s[:len(s) - len(postfix)]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string. \"\"\"\n    if not string:\n        return \"\"\n\n    longest_palindromic_postfix = _find_longest_palindromic_postfix(string)\n    prefix_before_postfix = _get_prefix_before_postfix(string, longest_palindromic_postfix)\n\n    reversed_prefix = prefix_before_postfix[::-1]\n    return string + reversed_prefix"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"\n    Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_so_far = strings[0]\n    for s in strings:\n        if len(s) > len(longest_so_far):\n            longest_so_far = s\n    return longest_so_far"}
{"task_id": "HumanEval/11", "solution": "from typing import List\ndef string_xor(a: str, b: str) -> str:\n    \"\"\"Performs character-by-character binary XOR on two input binary strings.\n    Returns the result as a new binary string.\n    \"\"\"\n\n    def _perform_char_xor(char_a: str, char_b: str) -> str:\n        \"\"\"Helper to perform XOR on two binary characters.\"\"\"\n        return str(int(char_a) ^ int(char_b))\n\n    result_chars: List[str] = []\n    for char_a, char_b in zip(a, b):\n        result_chars.append(_perform_char_xor(char_a, char_b))\n\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Returns the longest string from a list, choosing the first encountered in case of ties.\n    If the input list is empty, it returns None.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_so_far: Optional[str] = None\n    max_length: int = -1\n\n    for current_string in strings:\n        current_string_length = len(current_string)\n        if current_string_length > max_length:\n            longest_so_far = current_string\n            max_length = current_string_length\n\n    return longest_so_far"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b.\n    This implementation uses the Euclidean algorithm.\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    while b:\n        a, b = b, a % b\n    return abs(a)"}
