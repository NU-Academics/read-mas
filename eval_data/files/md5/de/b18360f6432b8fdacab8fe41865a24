{"task_id": "HumanEval/123", "solution": "from typing import List\ndef _calculate_next_collatz_term(current_term: int) -> int:\n    \"\"\"Calculates the next term in the Collatz sequence.\n    Applies the Collatz rules: even numbers are halved, odd numbers become 3n+1.\n    \"\"\"\n    if current_term % 2 == 0:\n        return current_term // 2\n    else:\n        return (3 * current_term) + 1\ndef generate_collatz_sequence(n: int) -> List[int]:\n    \"\"\"Generates the Collatz sequence starting from n.\n    The sequence continues until it reaches 1.\n    \"\"\"\n    sequence = [n]\n    current = n\n    while current != 1:\n        current = _calculate_next_collatz_term(current)\n        sequence.append(current)\n    return sequence\ndef get_odd_numbers_from_sequence(sequence: List[int]) -> List[int]:\n    \"\"\"Identifies and sorts odd numbers from a Collatz sequence.\n    Returns a new list containing only the odd numbers, sorted in increasing order.\n    \"\"\"\n    odd_numbers = []\n    for num in sequence:\n        if num % 2 != 0:\n            odd_numbers.append(num)\n    odd_numbers.sort()\n    return odd_numbers\ndef get_odd_collatz(n: int) -> List[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    Handles the special case where n=1 by returning [1].\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    collatz_sequence = generate_collatz_sequence(n)\n    odd_numbers = get_odd_numbers_from_sequence(collatz_sequence)\n\n    return odd_numbers"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date: str) -> bool:\n    \"\"\"Validates a given date string according to specified rules.\n    Returns True if the date is valid, False otherwise.\n    \"\"\"\n\n    # Helper class to store parsed date components.\n    class DateComponents:\n        def __init__(self, month: int, day: int, year: int):\n            self.month = month\n            self.day = day\n            self.year = year\n\n    # Checks if the date string is empty.\n    def _is_empty(date_string: str) -> bool:\n        return len(date_string) == 0\n\n    # Checks if the date string adheres to 'mm-dd-yyyy' format structure.\n    def _is_format_valid(date_string: str) -> bool:\n        if len(date_string) != 10:\n            return False\n        if date_string[2] != '-' or date_string[5] != '-':\n            return False\n        return True\n\n    # Parses month, day, year from the date string.\n    # Returns DateComponents object or None if parsing fails.\n    def _parse_date_components(date_string: str) -> DateComponents | None:\n        try:\n            month = int(date_string[0:2])\n            day = int(date_string[3:5])\n            year = int(date_string[6:10])\n            return DateComponents(month, day, year)\n        except ValueError:\n            return None\n\n    # Checks if the month is within the valid range (1-12).\n    def _is_month_valid(month: int) -> bool:\n        return 1 <= month <= 12\n\n    # Checks if the day is valid for the given month.\n    def _is_day_valid(day: int, month: int) -> bool:\n        if month in {1, 3, 5, 7, 8, 10, 12}:\n            return 1 <= day <= 31\n        elif month in {4, 6, 9, 11}:\n            return 1 <= day <= 30\n        elif month == 2:\n            return 1 <= day <= 29\n        return False\n\n    # Perform validation checks in sequence.\n\n    # 1. Check if the date string is empty.\n    if _is_empty(date):\n        return False\n\n    # 2. Check if the date string adheres to the 'mm-dd-yyyy' format.\n    if not _is_format_valid(date):\n        return False\n\n    # 3. Parse the date components.\n    components = _parse_date_components(date)\n    if components is None:  # Parsing failed (e.g., non-numeric parts).\n        return False\n\n    # 4. Validate the month component.\n    if not _is_month_valid(components.month):\n        return False\n\n    # 5. Validate the day component based on the month.\n    if not _is_day_valid(components.day, components.month):\n        return False\n\n    # If all checks pass, the date is valid.\n    return True"}
{"task_id": "HumanEval/125", "solution": "from typing import List, Union\ndef _contains_whitespace(text: str) -> bool:\n    \"\"\"Checks if the given text string contains any whitespace characters.\n    Returns True if whitespace is found, False otherwise.\"\"\"\n    return any(char.isspace() for char in text)\ndef _contains_comma(text: str) -> bool:\n    \"\"\"Checks if the given text string contains any comma characters.\n    Returns True if a comma is found, False otherwise.\"\"\"\n    return ',' in text\ndef _count_odd_ordered_lowercase_letters(text: str) -> int:\n    \"\"\"Counts lowercase letters with an odd 0-indexed alphabetical order.\n    For example, 'a' is 0 (even), 'b' is 1 (odd), 'c' is 2 (even), etc.\"\"\"\n    count = 0\n    for char in text:\n        if char.islower():\n            # Calculate 0-indexed alphabetical order (e.g., 'a'=0, 'b'=1)\n            order = ord(char) - ord('a')\n            if order % 2 != 0: # Check if the order is odd\n                count += 1\n    return count\ndef split_words(txt: str) -> Union[List[str], int]:\n    \"\"\"Processes an input string based on a hierarchical set of rules.\n    It prioritizes splitting by whitespace, then by commas, otherwise counts specific lowercase letters.\"\"\"\n    if _contains_whitespace(txt):\n        return txt.split()\n    elif _contains_comma(txt):\n        return txt.split(',')\n    else:\n        return _count_odd_ordered_lowercase_letters(txt)"}
{"task_id": "HumanEval/115", "solution": "import math\ndef _calculate_total_water(grid: list[list[int]]) -> int:\n    \"\"\"Calculates the total amount of water present in all wells.\n    It sums all '1's found across the grid.\n    \"\"\"\n    total_water = 0\n    for row in grid:\n        total_water += sum(row)\n    return total_water\ndef _calculate_bucket_operations(total_water: int, capacity: int) -> int:\n    \"\"\"Calculates the number of bucket operations using ceiling division.\n    It returns 0 if no water is present, otherwise applies math.ceil.\n    \"\"\"\n    if total_water == 0:\n        return 0\n    return int(math.ceil(total_water / capacity))\ndef max_fill(grid: list[list[int]], capacity: int) -> int:\n    \"\"\"Calculates the total number of bucket operations required to empty all wells.\n    It validates inputs, sums water, and applies ceiling division for operations.\n    \"\"\"\n    _validate_inputs(grid, capacity)\n    total_water = _calculate_total_water(grid)\n    num_operations = _calculate_bucket_operations(total_water, capacity)\n    return num_operations"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Processes a string by splitting on whitespace, then commas, or counting odd-ordered lowercase letters.\n    \"\"\"\n\n    # Check for Whitespace (FR2, FR3)\n    has_whitespace = False\n    for char in txt:\n        if char.isspace():\n            has_whitespace = True\n            break\n\n    if has_whitespace:\n        # Split by whitespace\n        return txt.split()\n\n    # Check for Comma (FR4, FR5)\n    has_comma = False\n    for char in txt:\n        if char == ',':\n            has_comma = True\n            break\n\n    if has_comma:\n        # Split by comma\n        return txt.split(',')\n\n    # Count Odd-Ordered Lowercase Letters (FR6, FR7)\n    # This logic determines alphabetical order and checks if it's odd.\n    count = 0\n    for char in txt:\n        if 'a' <= char <= 'z': # Check if character is a lowercase letter\n            # Calculate 0-indexed alphabetical order (e.g., 'a' is 0, 'b' is 1)\n            order = ord(char) - ord('a')\n\n            # Check if the alphabetical order is odd\n            if order % 2 != 0:\n                count += 1\n\n    return count"}
{"task_id": "HumanEval/126", "solution": "import collections\ndef is_sorted(lst):\n    '''\n    Checks if a list is sorted in ascending order with no more than one duplicate of any number.\n    Assumes the input list contains only non-negative integers as per critical requirements.\n    '''\n    # Handle edge cases for empty or single-element lists.\n    if len(lst) <= 1:\n        return True\n\n    # Check for ascending order.\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i-1]:\n            return False\n\n    # Check for duplicate count constraint (no more than one duplicate of any number).\n    counts = collections.Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    # If all checks pass, the list is valid.\n    return True"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two\n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n    \"\"\"\n\n    def _calculate_intersection(interval1, interval2):\n        \"\"\"Determines the intersection of two intervals.\"\"\"\n        start1, end1 = interval1\n        start2, end2 = interval2\n\n        intersection_start = max(start1, start2)\n        intersection_end = min(end1, end2)\n\n        if intersection_start > intersection_end:\n            return None\n        else:\n            return (intersection_start, intersection_end)\n\n    def _calculate_length(interval):\n        \"\"\"Calculates the length of a given interval.\"\"\"\n        start, end = interval\n        return end - start + 1\n\n    def _is_prime(number):\n        \"\"\"Checks if a given number is a prime number.\"\"\"\n        if number <= 1:\n            return False\n        i = 2\n        while i * i <= number:\n            if number % i == 0:\n                return False\n            i += 1\n        return True\n\n    intersection_interval = _calculate_intersection(interval1, interval2)\n\n    if intersection_interval is None:\n        return \"NO\"\n    else:\n        length = _calculate_length(intersection_interval)\n        if _is_prime(length):\n            return \"YES\"\n        else:\n            return \"NO\""}
{"task_id": "HumanEval/126", "solution": "class ValidationHelpers:\n    \"\"\"Helper class for validating list elements and checking sorting rules.\"\"\"\n\n    @staticmethod\n    def validate_input_elements(lst: list[int]) -> bool:\n        \"\"\"Ensures all elements are non-negative integers.\n        Per problem statement, inputs are trusted to meet this.\"\"\"\n        # Critical Requirement: \"Assume no negative numbers and only integers.\" and \"Trust the caller's inputs\".\n        # This function effectively passes as inputs are guaranteed by the problem statement.\n        return True\n\n    @staticmethod\n    def check_excessive_duplicates(lst: list[int]) -> bool:\n        \"\"\"Checks if any number appears three or more times.\"\"\"\n        counts = {}\n        for num in lst:\n            counts[num] = counts.get(num, 0) + 1\n\n        for count in counts.values():\n            if count >= 3:\n                return False\n        return True\n\n    @staticmethod\n    def check_ascending_order(lst: list[int]) -> bool:\n        \"\"\"Verifies if the list is sorted in non-decreasing order.\"\"\"\n        # An empty or single-element list is considered sorted.\n        if len(lst) < 2:\n            return True\n        for i in range(len(lst) - 1):\n            if lst[i] > lst[i+1]:\n                return False\n        return True\ndef is_sorted(lst):\n    \"\"\"\n    Given a list of numbers, return whether or not they are sorted in ascending order.\n    Returns False if any number appears three or more times.\n    \"\"\"\n    helpers = ValidationHelpers()\n\n    # Data flow sequence as per design specification\n    # 1. Validate List Elements (NFR: non-negative integers)\n    if not helpers.validate_input_elements(lst):\n        return False\n\n    # 2. Check for Duplicates (FR: no more than 1 duplicate)\n    if not helpers.check_excessive_duplicates(lst):\n        return False\n\n    # 3. Check if Sorted Ascending (FR: ascending order)\n    if not helpers.check_ascending_order(lst):\n        return False\n\n    # If all checks pass\n    return True"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes multiplied by the product of signs for an array of integers.\n    Returns None if the input array is empty.\n    \"\"\"\n\n    # Helper function to determine the sign of a number.\n    def _get_sign(number):\n        if number > 0:\n            return 1\n        elif number < 0:\n            return -1\n        else:\n            return 0\n\n    # Helper function to determine the magnitude (absolute value) of a number.\n    def _get_magnitude(number):\n        return abs(number)\n\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for number in arr:\n        product_of_signs *= _get_sign(number)\n        sum_of_magnitudes += _get_magnitude(number)\n\n    return sum_of_magnitudes * product_of_signs"}
{"task_id": "HumanEval/128", "solution": "def _get_magnitude(number: int) -> int:\n    \"\"\"Calculates the absolute value of an integer.\"\"\"\n    return abs(number)\ndef _get_sign(number: int) -> int:\n    \"\"\"Determines the sign of an integer (1, -1, or 0).\"\"\"\n    if number > 0:\n        return 1\n    elif number < 0:\n        return -1\n    else:\n        return 0\ndef prod_signs(arr: list[int]) -> int | None:\n    \"\"\"\n    Calculates the sum of magnitudes multiplied by the product of signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = 0\n    product_of_signs = 1\n\n    for number in arr:\n        sum_magnitudes += _get_magnitude(number)\n        product_of_signs *= _get_sign(number)\n\n    return sum_magnitudes * product_of_signs"}
{"task_id": "HumanEval/130", "solution": "def tri(n: int) -> list[int]:\n    \"\"\"\n    Computes and returns a list of the first n+1 Tribonacci numbers.\n    It applies specific recurrence relations for even and odd indices.\n    \"\"\"\n    if n == 0:\n        return [1]\n\n    trib_numbers = [0] * (n + 1)\n\n    trib_numbers[0] = 1\n    if n >= 1:\n        trib_numbers[1] = 3\n\n    for i in range(2, n + 1):\n        if i % 2 == 0:\n            trib_numbers[i] = 1 + i // 2\n        else:\n            # tri(i+1) is calculated using the even rule\n            trib_numbers[i] = trib_numbers[i - 1] + trib_numbers[i - 2] + (1 + (i + 1) // 2)\n\n    return trib_numbers"}
{"task_id": "HumanEval/129", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid grid or k inputs.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass Cell:\n    \"\"\"Represents a single cell in the grid with its value and coordinates.\"\"\"\n\n    def __init__(self, value: int, row: int, col: int):\n        \"\"\"Initializes a Cell with its value, row, and column.\"\"\"\n        self._value = value\n        self._row = row\n        self._col = col\n\n    def getValue(self) -> int:\n        \"\"\"Returns the cell's value.\"\"\"\n        return self._value\n\n    def getRow(self) -> int:\n        \"\"\"Returns the cell's row index.\"\"\"\n        return self._row\n\n    def getCol(self) -> int:\n        \"\"\"Returns the cell's column index.\"\"\"\n        return self._col\n\n    def __eq__(self, other):\n        \"\"\"Compares two Cell objects for equality based on their attributes.\"\"\"\n        if not isinstance(other, Cell):\n            return NotImplemented\n        return self._row == other._row and self._col == other._col and self._value == other._value\n\n    def __hash__(self):\n        \"\"\"Returns a hash value for the Cell object.\"\"\"\n        return hash((self._row, self._col, self._value))\nclass Grid:\n    \"\"\"Manages the 2D grid of cells and provides access to cells and their neighbors.\"\"\"\n\n    def __init__(self, grid_values: list[list[int]]):\n        \"\"\"Initializes the grid from input values, creating Cell objects.\"\"\"\n        if not grid_values or not isinstance(grid_values, list) or not all(isinstance(row, list) for row in grid_values):\n            raise InvalidInputError(\"Grid must be a non-empty list of lists.\")\n        N = len(grid_values)\n        if N < 2 or not all(len(row) == N for row in grid_values):\n            raise InvalidInputError(\"Grid must be an N x N square grid with N >= 2.\")\n\n        self._N = N\n        self._cells: list[list[Cell]] = [[None for _ in range(N)] for _ in range(N)]\n        all_values = set()\n        for r in range(N):\n            for c in range(N):\n                value = grid_values[r][c]\n                if not isinstance(value, int):\n                    raise InvalidInputError(\"Grid cells must contain integers.\")\n                if not (1 <= value <= N * N):\n                    raise InvalidInputError(f\"Grid cell value {value} is out of range [1, {N*N}].\")\n                if value in all_values:\n                    raise InvalidInputError(f\"Duplicate value {value} found in grid.\")\n                all_values.add(value)\n                self._cells[r][c] = Cell(value, r, c)\n\n    def getN(self) -> int:\n        \"\"\"Returns the grid dimension N.\"\"\"\n        return self._N\n\n    def getCell(self, row: int, col: int) -> Cell:\n        \"\"\"Returns the Cell object at the specified coordinates.\"\"\"\n        # No boundary check needed here as this is an internal helper,\n        # and callers (getNeighbors, PathFinder) should ensure valid coords.\n        return self._cells[row][col]\n\n    def getNeighbors(self, cell: Cell) -> list[Cell]:\n        \"\"\"Returns a list of valid direct neighbor Cell objects for a given cell.\"\"\"\n        neighbors = []\n        row, col = cell.getRow(), cell.getCol()\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # Up, Down, Left, Right\n\n        for dr, dc in directions:\n            new_row, new_col = row + dr, col + dc\n            if 0 <= new_row < self._N and 0 <= new_col < self._N:\n                neighbors.append(self._cells[new_row][new_col])\n        return neighbors\nclass Path:\n    \"\"\"Represents an ordered sequence of visited cells and provides lexicographical comparison.\"\"\"\n\n    def __init__(self, initial_cell: Cell = None):\n        \"\"\"Initializes a path, optionally starting with an initial cell.\"\"\"\n        self._visited_cells: list[Cell] = []\n        self._length: int = 0\n        if initial_cell:\n            self.addCell(initial_cell)\n\n    def addCell(self, cell: Cell) -> None:\n        \"\"\"Adds a cell to the end of the path.\"\"\"\n        self._visited_cells.append(cell)\n        self._length += 1\n\n    def remove_last_cell(self) -> None:\n        \"\"\"Removes the last cell from the path (for backtracking).\"\"\"\n        if self._length > 0:\n            self._visited_cells.pop()\n            self._length -= 1\n\n    def getValues(self) -> list[int]:\n        \"\"\"Returns an ordered list of integer values from the visited cells.\"\"\"\n        return [cell.getValue() for cell in self._visited_cells]\n\n    def getLength(self) -> int:\n        \"\"\"Returns the current length of the path.\"\"\"\n        return self._length\n\n    def get_last_cell(self) -> Cell:\n        \"\"\"Returns the last cell added to the path.\"\"\"\n        if self._length > 0:\n            return self._visited_cells[-1]\n        return None\n\n    def __lt__(self, other: 'Path') -> bool:\n        \"\"\"Compares this path lexicographically with another path.\"\"\"\n        if not isinstance(other, Path):\n            return NotImplemented\n        # Lexicographical comparison for lists of values\n        return self.getValues() < other.getValues()\nclass PathFinder:\n    \"\"\"Orchestrates the search for the minimum lexicographical path of length k using DFS.\"\"\"\n\n    def __init__(self, grid: Grid, k: int):\n        \"\"\"Initializes the PathFinder with the grid and target path length.\"\"\"\n        self._grid: Grid = grid\n        self._k: int = k\n        self._min_path: Path = None\n\n        self._validate_inputs()\n\n    def _validate_inputs(self):\n        \"\"\"Validates the input parameter k.\"\"\"\n        if not isinstance(self._k, int) or self._k <= 0:\n            raise InvalidInputError(\"k must be a positive integer.\")\n\n    def _dfs(self, current_path: Path):\n        \"\"\"Performs a Depth-First Search to explore paths.\"\"\"\n        if current_path.getLength() == self._k:\n            if self._min_path is None or current_path < self._min_path:\n                # Create a new Path object and copy cells to store the winning path's state\n                self._min_path = Path()\n                for cell in current_path._visited_cells:\n                    self._min_path.addCell(cell)\n            return\n\n        if current_path.getLength() < self._k:\n            last_cell = current_path.get_last_cell()\n            neighbors = self._grid.getNeighbors(last_cell)\n\n            # Optimization: sort neighbors to try smaller values first for potential lexicographical advantage\n            neighbors.sort(key=lambda cell: cell.getValue())\n\n            for neighbor in neighbors:\n                current_path.addCell(neighbor)\n                self._dfs(current_path)\n                current_path.remove_last_cell()  # Backtrack\n\n    def find_min_path(self) -> list[int]:\n        \"\"\"Initiates the pathfinding process and returns the values of the minimum path.\"\"\"\n        N = self._grid.getN()\n        for r in range(N):\n            for c in range(N):\n                initial_cell = self._grid.getCell(r, c)\n                self._dfs(Path(initial_cell))\n\n        if self._min_path: # Should always be found as per problem guarantee\n            return self._min_path.getValues()\n        return [] # Fallback, though unreachable if guarantees hold\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k,\n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n    grid_obj = Grid(grid)\n    path_finder = PathFinder(grid_obj, k)\n    return path_finder.find_min_path()"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product = 1\n    found_odd_digit = False\n\n    if n == 0:  # Handle the specific case of n=0 (although problem says positive integer)\n        return 0\n\n    temp_n = n\n    while temp_n > 0:\n        digit = temp_n % 10\n        if digit % 2 != 0:  # Check if the digit is odd\n            product *= digit\n            found_odd_digit = True\n        temp_n //= 10\n\n    if found_odd_digit:\n        return product\n    else:\n        return 0"}
{"task_id": "HumanEval/129", "solution": "from typing import List, Optional\nclass Cell:\n    \"\"\"Represents a single cell in the grid with its value and coordinates.\"\"\"\n    def __init__(self, row: int, col: int, value: int):\n        self.row = row\n        self.col = col\n        self.value = value\nclass Grid:\n    \"\"\"Manages the N x N grid of cells and provides access to them.\"\"\"\n    def __init__(self, N: int, values: List[int]):\n        self.N = N\n        self.cells: List[List[Cell]] = []\n        for r in range(N):\n            row_cells = []\n            for c in range(N):\n                flat_idx = r * N + c\n                row_cells.append(Cell(r, c, values[flat_idx]))\n            self.cells.append(row_cells)\n\n    def get_cell(self, r: int, c: int) -> Cell:\n        \"\"\"Returns the Cell object at (r, c).\"\"\"\n        return self.cells[r][c]\n\n    def is_valid_coord(self, r: int, c: int) -> bool:\n        \"\"\"Checks if (r, c) is within grid boundaries.\"\"\"\n        return 0 <= r < self.N and 0 <= c < self.N\nclass PathComparator:\n    \"\"\"Provides a static method for comparing two lists of integers lexicographically.\"\"\"\n    @staticmethod\n    def compare_lexicographically(list_a: List[int], list_b: List[int]) -> int:\n        \"\"\"Returns -1 if A < B, 1 if A > B, 0 if A == B.\"\"\"\n        for i in range(min(len(list_a), len(list_b))):\n            if list_a[i] < list_b[i]:\n                return -1\n            if list_a[i] > list_b[i]:\n                return 1\n        # If one list is a prefix of the other, the shorter one is lexicographically smaller.\n        if len(list_a) < len(list_b):\n            return -1\n        if len(list_a) > len(list_b):\n            return 1\n        return 0\nclass Path:\n    \"\"\"Represents a path of length k as a sequence of cells and provides lexicographical comparison.\"\"\"\n    def __init__(self, sequence_of_cells: List[Cell], length_k: int):\n        self.sequence_of_cells = sequence_of_cells\n        self.length_k = length_k\n        self._values: List[int] = [cell.value for cell in sequence_of_cells]\n\n    def get_values(self) -> List[int]:\n        \"\"\"Returns the ordered list of values in the path.\"\"\"\n        return self._values\n\n    def is_lexicographically_less_than(self, other_path: 'Path') -> bool:\n        \"\"\"Compares this path with another lexicographically.\"\"\"\n        return PathComparator.compare_lexicographically(self.get_values(), other_path.get_values()) == -1\nclass PathFinder:\n    \"\"\"Implements the core algorithm to find the lexicographically minimum path of length k.\"\"\"\n    def __init__(self, grid: Grid, k: int):\n        self._grid = grid\n        self._k = k\n        self._min_path: Optional[Path] = None\n        self._directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n\n    def _dfs(self, current_cell: Cell, current_path_cells: List[Cell]) -> None:\n        \"\"\"Recursively explores paths using Depth-First Search with pruning.\"\"\"\n        # Pruning: if current path values already exceed the minimum path found, stop exploring this branch.\n        if self._min_path is not None:\n            current_path_values = [cell.value for cell in current_path_cells]\n            # Compare only up to the current path length\n            if PathComparator.compare_lexicographically(current_path_values, self._min_path.get_values()[:len(current_path_cells)]) == 1:\n                return\n\n        # Base case: path length k reached\n        if len(current_path_cells) == self._k:\n            current_path = Path(current_path_cells, self._k)\n            if self._min_path is None or current_path.is_lexicographically_less_than(self._min_path):\n                self._min_path = current_path\n            return\n\n        # Recursive step: explore neighbors\n        r, c = current_cell.row, current_cell.col\n        for dr, dc in self._directions:\n            next_r, next_c = r + dr, c + dc\n            if self._grid.is_valid_coord(next_r, next_c):\n                next_cell = self._grid.get_cell(next_r, next_c)\n                self._dfs(next_cell, current_path_cells + [next_cell])\n\n    def find_minimum_path(self) -> Path:\n        \"\"\"Initiates the search and returns the minimum path.\"\"\"\n        for r in range(self._grid.N):\n            for c in range(self._grid.N):\n                start_cell = self._grid.get_cell(r, c)\n                self._dfs(start_cell, [start_cell])\n        return self._min_path\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Given a grid with N rows and N columns and a positive integer k,\n    find the lexicographically smallest path of length k in the grid.\n    \"\"\"\n    N = len(grid)\n    flat_grid_values = [value for row in grid for value in row]\n\n    grid_obj = Grid(N, flat_grid_values)\n    path_finder = PathFinder(grid_obj, k)\n    minimum_path = path_finder.find_minimum_path()\n\n    return minimum_path.get_values()"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    odd_digits = []\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:\n            odd_digits.append(digit)\n\n    if not odd_digits:\n        return 0\n\n    product = 1\n    for d in odd_digits:\n        product *= d\n    return product"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n + 1 numbers of a specific Tribonacci sequence.\n    It uses memoization to efficiently compute values based on defined recurrence relations.\n    \"\"\"\n    memo = {}\n\n    def _calculate_tri_value(k):\n        \"\"\"Recursively calculates tri(k) using memoization and defined rules.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            result = 1.0\n        elif k == 1:\n            result = 3.0\n        elif k % 2 == 0:\n            result = 1.0 + (k / 2.0)\n        else:  # k is odd\n            # Resolve circular dependency by calculating tri(k+1) first\n            tri_k_plus_1 = _calculate_tri_value(k + 1)\n            tri_k_minus_1 = _calculate_tri_value(k - 1)\n            tri_k_minus_2 = _calculate_tri_value(k - 2)\n            result = tri_k_minus_1 + tri_k_minus_2 + tri_k_plus_1\n\n        memo[k] = result\n        return result\n\n    # Determine the maximum index needed for calculation, accounting for tri(n+1) for odd n.\n    max_idx_to_calc = n\n    if n % 2 != 0 and n > 0:\n        max_idx_to_calc = n + 1\n\n    # Pre-calculate all necessary Tribonacci values and store them in memo.\n    for i in range(max_idx_to_calc + 1):\n        _calculate_tri_value(i)\n\n    # Construct the result list from tri(0) to tri(n).\n    sequence = [memo[i] for i in range(n + 1)]\n    return sequence"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date: str) -> bool:\n    \"\"\"Validates a date string in 'mm-dd-yyyy' format against specific rules.\n    Returns True if valid, False otherwise.\n    \"\"\"\n\n    def _parse_date_components(date_string: str):\n        \"\"\"Attempts to parse the date string into month, day, year integers.\"\"\"\n        if len(date_string) != 10 or date_string[2] != '-' or date_string[5] != '-':\n            return None, None, None\n\n        parts = date_string.split('-')\n        try:\n            month = int(parts[0])\n            day = int(parts[1])\n            year = int(parts[2])\n            return month, day, year\n        except ValueError:\n            return None, None, None\n\n    def _is_valid_month_range(month: int):\n        \"\"\"Checks if the month is between 1 and 12, inclusive.\"\"\"\n        return 1 <= month <= 12\n\n    def _is_valid_day_range(day: int, month: int):\n        \"\"\"Checks if the day is valid for the given month, assuming non-leap year February.\"\"\"\n        if month in {1, 3, 5, 7, 8, 10, 12}:\n            return 1 <= day <= 31\n        elif month in {4, 6, 9, 11}:\n            return 1 <= day <= 30\n        elif month == 2:\n            return 1 <= day <= 29\n        return False\n\n    # 1. Validate that the input date string is not empty.\n    if not date:\n        return False\n\n    # 2. Validate that the input date string adheres to the 'mm-dd-yyyy' format and parse components.\n    month, day, year = _parse_date_components(date)\n    if month is None or day is None or year is None:\n        return False\n\n    # 3. Validate that the month component is between 1 and 12, inclusive.\n    if not _is_valid_month_range(month):\n        return False\n\n    # 4. Validate the day component based on the month.\n    if not _is_valid_day_range(day, month):\n        return False\n\n    # If all validation rules are satisfied, return True.\n    return True"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string: str) -> bool:\n    \"\"\"\n    Checks if the input string contains a subsequence of '[', '[', ']', ']'.\n    Returns True if found, False otherwise.\n    \"\"\"\n    target_subsequence = ['[', '[', ']', ']']\n    subsequence_index = 0\n\n    for char in string:\n        if subsequence_index < len(target_subsequence):\n            if char == target_subsequence[subsequence_index]:\n                subsequence_index += 1\n\n        if subsequence_index == len(target_subsequence):\n            return True\n\n    return False"}
{"task_id": "HumanEval/133", "solution": "import math\nfrom typing import List\ndef sum_squares(lst: List[float]) -> int:\n    \"\"\"Calculates the sum of squared numbers in the given list, after rounding each element to its ceiling.\n    The function returns the final sum as an integer.\n    \"\"\"\n    squared_ceil_numbers = []\n    for num in lst:\n        ceiling_value = math.ceil(num)\n        squared_value = int(ceiling_value * ceiling_value)\n        squared_ceil_numbers.append(squared_value)\n\n    final_sum = sum(squared_ceil_numbers)\n    return final_sum"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Returns the largest index where an element is less than its predecessor, or -1.\n    The array is iterated from right to left to find the largest such index efficiently.\"\"\"\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i-1]:\n            return i\n    return -1"}
{"task_id": "HumanEval/134", "solution": "def _is_alphabetical(char: str) -> bool:\n    \"\"\"Checks if a character is alphabetical.\"\"\"\n    return char.isalpha()\ndef _is_space(char: str) -> bool:\n    \"\"\"Checks if a character is a space.\"\"\"\n    return char.isspace()\ndef check_if_last_char_is_a_letter(txt: str) -> bool:\n    \"\"\"\n    Checks if the last character is an isolated alphabetical character.\n    Returns True if the last character is an alphabetical character and not part of a word.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not _is_alphabetical(last_char):\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    char_before_last = txt[-2]\n\n    if _is_space(char_before_last):\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Determines if the last character of a string is an alphabetical character\n    that is considered \"not part of a word\" based on specific rules.\n    \"\"\"\n    # FR3: Return False if the input string txt is empty.\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    # FR4: Return False if the last character of txt is not an alphabetical character.\n    if not last_char.isalpha():\n        return False\n\n    # FR5: Return True if the last character of txt is an alphabetical character and txt contains only one character.\n    if len(txt) == 1:\n        return True\n\n    # If len(txt) > 1, check the character before the last.\n    char_before_last = txt[-2]\n\n    # FR6: Return True if the last character of txt is an alphabetical character and is preceded by a space.\n    if char_before_last == ' ':\n        return True\n\n    # FR7: Return False if the last character of txt is an alphabetical character\n    # and is not preceded by a space, given the string length is greater than 1.\n    return False"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if the input string contains a valid subsequence of brackets with at least one nested bracket.\n    Non-bracket characters are ignored during evaluation.\n    \"\"\"\n    cleaned_s = \"\"\n    for char in string:\n        if char == '[' or char == ']':\n            cleaned_s += char\n\n    n = len(cleaned_s)\n\n    # Helper function to check if a bracket string is valid and its maximum nesting depth.\n    # This function is defined inline as required by the design.\n    def _check_validity_and_depth(s_sub):\n        stack = []\n        max_depth = 0\n        current_depth = 0\n        for char_sub in s_sub:\n            if char_sub == '[':\n                stack.append(char_sub)\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char_sub == ']':\n                if not stack:\n                    return False, 0  # Invalid: closing bracket with no open\n                stack.pop()\n                current_depth -= 1\n        return len(stack) == 0, max_depth  # Returns (is_valid, max_depth)\n\n    # Iterate through all possible contiguous substrings of the cleaned bracket string.\n    for i in range(n):\n        for j in range(i + 1, n + 1):\n            sub = cleaned_s[i:j]\n\n            # A nested sequence requires at least 4 brackets, e.g., '[[]]'.\n            if len(sub) < 4:\n                continue\n\n            is_valid, max_d = _check_validity_and_depth(sub)\n\n            # If a valid substring with a nesting depth of 2 or more is found,\n            # then a valid nested subsequence exists.\n            if is_valid and max_d >= 2:\n                return True\n\n    return False"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr: list) -> int:\n    \"\"\"Create a function which returns the largest index of an element which\n    is not greater than or equal to the element immediately preceding it. If\n    no such element exists then return -1.\n    \"\"\"\n    largest_index = -1\n    # Iterate through the array starting from the second element.\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            largest_index = i\n    return largest_index"}
{"task_id": "HumanEval/127", "solution": "def _calculate_intersection(i1: tuple[int, int], i2: tuple[int, int]) -> tuple[int, int] | None:\n    \"\"\"Calculates the intersection of two closed intervals. Returns None if they don't intersect.\"\"\"\n    start1, end1 = i1\n    start2, end2 = i2\n\n    intersection_start = max(start1, start2)\n    intersection_end = min(end1, end2)\n\n    if intersection_start > intersection_end:\n        return None\n    else:\n        return (intersection_start, intersection_end)\ndef _calculate_length(interval: tuple[int, int]) -> int:\n    \"\"\"Calculates the length of a closed interval (start, end).\"\"\"\n    start, end = interval\n    return end - start + 1\ndef _is_prime(number: int) -> bool:\n    \"\"\"Determines if a given integer is a prime number.\"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\ndef intersection(interval1: tuple[int, int], interval2: tuple[int, int]) -> str:\n    \"\"\"Checks if the length of the intersection of two intervals is a prime number.\"\"\"\n    intersection_interval = _calculate_intersection(interval1, interval2)\n\n    if intersection_interval is None:\n        return \"NO\"\n\n    length = _calculate_length(intersection_interval)\n\n    if _is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Finds the largest negative and smallest positive integers in a list.\n    Returns a tuple (largest_negative, smallest_positive), or None for missing types.\n    \"\"\"\n    largest_negative = None\n    smallest_positive = None\n\n    for num in lst:\n        if num < 0:\n            if largest_negative is None or num > largest_negative:\n                largest_negative = num\n        elif num > 0:\n            if smallest_positive is None or num < smallest_positive:\n                smallest_positive = num\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst: list[int]) -> tuple[int | None, int | None]:\n    \"\"\"\n    Identifies the largest negative integer and the smallest positive integer.\n    Returns (largest_negative, smallest_positive), or None for missing types.\n    \"\"\"\n    largest_neg = None\n    smallest_pos = None\n\n    for num in lst:\n        if num < 0:\n            if largest_neg is None or num > largest_neg:\n                largest_neg = num\n        elif num > 0:\n            if smallest_pos is None or num < smallest_pos:\n                smallest_pos = num\n\n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/137", "solution": "def _parse_value(value):\n    \"\"\"\n    Parses an input value (int, float, or string) into a float for comparison\n    while retaining the original value for potential return.\n    \"\"\"\n    if isinstance(value, (int, float)):\n        return float(value), value\n    elif isinstance(value, str):\n        # Standardize decimal separator from ',' to '.' for string parsing.\n        processed_s = value.replace(',', '.')\n        return float(processed_s), value\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n\n    compare_one(1, 2.5) \u279e 2.5\n    compare_one(1, \"2,3\") \u279e \"2,3\"\n    compare_one(\"5,1\", \"6\") \u279e \"6\"\n    compare_one(\"1\", 1) \u279e None\n    \"\"\"\n    parsed_a, original_a = _parse_value(a)\n    parsed_b, original_b = _parse_value(b)\n\n    if parsed_a == parsed_b:\n        return None\n    elif parsed_a > parsed_b:\n        return original_a\n    else: # parsed_b > parsed_a\n        return original_b"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n: int) -> bool:\n    \"\"\"Evaluate whether n can be written as the sum of exactly 4 positive even numbers.\n    For example, is_equal_to_sum_even(8) is True, while is_equal_to_sum_even(6) is False.\n    \"\"\"\n    return n >= 8 and n % 2 == 0"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether n can be written as the sum of exactly 4 positive even numbers.\n    This includes checks for n being less than 8 or an odd number.\n    \"\"\"\n    if n < 8:\n        return False\n    if n % 2 != 0:\n        return False\n    # If n is even and >= 8, it can always be expressed as a sum of four positive even numbers.\n    # For example, n = 2 + 2 + 2 + (n-6), where (n-6) is an even positive number (>= 2).\n    return True"}
{"task_id": "HumanEval/137", "solution": "def _convert_to_float(val):\n    \"\"\"\n    Converts a value (int, float, or string) to its float representation.\n    Handles string numbers with comma or dot as decimal separators.\n    \"\"\"\n    str_val = str(val)\n    normalized_str_val = str_val.replace(',', '.')\n    return float(normalized_str_val)\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n\n    compare_one(1, 2.5) \u279e 2.5\n    compare_one(1, \"2,3\") \u279e \"2,3\"\n    compare_one(\"5,1\", \"6\") \u279e \"6\"\n    compare_one(\"1\", 1) \u279e None\n    \"\"\"\n    float_a = _convert_to_float(a)\n    float_b = _convert_to_float(b)\n\n    if float_a > float_b:\n        return a\n    elif float_b > float_a:\n        return b"}
{"task_id": "HumanEval/139", "solution": "def _factorial(k: int) -> int:\n    \"\"\"Computes the standard factorial for a given positive integer k.\n    This helper function calculates k! iteratively.\n    \"\"\"\n    res = 1\n    for i in range(1, k + 1):\n        res *= i\n    return res\ndef special_factorial(n: int) -> int:\n    \"\"\"Calculates the special factorial for a positive integer n.\n    This is the product of k! for all integers k from 1 to n.\n    \"\"\"\n    special_fact_result = 1\n    for k in range(1, n + 1):\n        special_fact_result *= _factorial(k)\n    return special_fact_result"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text: str) -> str:\n    \"\"\"Processes a string, replacing space sequences with underscores or hyphens.\"\"\"\n    result = []\n    i = 0\n    n = len(text)\n\n    while i < n:\n        if text[i] != ' ':\n            result.append(text[i])\n            i += 1\n        else:\n            space_count = 0\n            j = i\n            while j < n and text[j] == ' ':\n                space_count += 1\n                j += 1\n\n            if space_count == 1:\n                result.append('_')\n            elif space_count == 2:\n                result.append('__')\n            else: # space_count > 2\n                result.append('-')\n\n            i += space_count # Advance index past the processed spaces\n    return \"\".join(result)"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text: str) -> str:\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n\n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    # First, replace sequences of 3 or more spaces with a temporary marker.\n    # This ensures FR1 takes precedence over FR2.\n    temp_text = re.sub(r'   +', '###TEMP_HYPHEN###', text)\n    # Then, replace any remaining single spaces with underscores.\n    final_text = temp_text.replace(' ', '_')\n    # Finally, replace the temporary marker with a hyphen.\n    return final_text.replace('###TEMP_HYPHEN###', '-')"}
{"task_id": "HumanEval/141", "solution": "class FileName:\n    \"\"\"Manages parsing and validation logic for a file name's structure.\"\"\"\n    def __init__(self, name_string: str):\n        \"\"\"Initializes with the file name string and parses prefix/suffix.\"\"\"\n        self._name_string = name_string\n        dot_index = name_string.rfind('.')\n        if dot_index != -1:\n            self._prefix = name_string[:dot_index]\n            self._suffix = name_string[dot_index + 1:]\n        else:\n            self._prefix = name_string\n            self._suffix = \"\"\n\n    def has_exactly_one_dot(self) -> bool:\n        \"\"\"Checks if the file name contains exactly one dot.\"\"\"\n        return self._name_string.count('.') == 1\n\n    def prefix_is_not_empty(self) -> bool:\n        \"\"\"Checks if the substring before the dot is not empty.\"\"\"\n        return bool(self._prefix)\n\n    def prefix_starts_with_latin_letter(self) -> bool:\n        \"\"\"Checks if the prefix starts with a letter from the latin alphabet.\"\"\"\n        return self._prefix and self._prefix[0].isalpha()\n\n    def count_digits(self) -> int:\n        \"\"\"Counts the total number of digits in the file name string.\"\"\"\n        return sum(1 for char in self._name_string if char.isdigit())\n\n    def get_suffix(self) -> str:\n        \"\"\"Returns the substring after the dot.\"\"\"\n        return self._suffix\nclass FileExtension:\n    \"\"\"Manages and validates file extensions against a predefined set.\"\"\"\n    def __init__(self):\n        \"\"\"Initializes with the set of allowed file extensions.\"\"\"\n        self._allowed_extensions = {'txt', 'exe', 'dll'}\n\n    def is_valid(self, extension: str) -> bool:\n        \"\"\"Checks if the given extension is one of the allowed extensions.\"\"\"\n        return extension in self._allowed_extensions\ndef file_name_check(file_name: str) -> str:\n    \"\"\"Checks if a file name is valid according to a set of rules.\"\"\"\n    fn_obj = FileName(file_name)\n\n    if not fn_obj.has_exactly_one_dot():\n        return 'No'\n\n    if not fn_obj.prefix_is_not_empty():\n        return 'No'\n\n    if not fn_obj.prefix_starts_with_latin_letter():\n        return 'No'\n\n    if fn_obj.count_digits() > 3:\n        return 'No'\n\n    fe_obj = FileExtension()\n    suffix = fn_obj.get_suffix()\n    if not fe_obj.is_valid(suffix):\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/141", "solution": "from abc import ABC, abstractmethod\nclass IValidationRule(ABC):\n    \"\"\"Interface for file name validation rules.\"\"\"\n    @abstractmethod\n    def validate(self, file_name: str) -> bool:\n        \"\"\"Validates the given file name.\"\"\"\n        pass\nclass NoMoreThanThreeDigitsRule(IValidationRule):\n    \"\"\"Rule to check if file name has no more than three digits.\"\"\"\n    def validate(self, file_name: str) -> bool:\n        digit_count = sum(1 for char in file_name if char.isdigit())\n        return digit_count <= 3\nclass ExactlyOneDotRule(IValidationRule):\n    \"\"\"Rule to check for exactly one dot in the file name.\"\"\"\n    def validate(self, file_name: str) -> bool:\n        return file_name.count('.') == 1\nclass NonEmptyPrefixRule(IValidationRule):\n    \"\"\"Rule to check if the prefix before the dot is not empty.\"\"\"\n    def validate(self, file_name: str) -> bool:\n        # This rule assumes ExactlyOneDotRule has already passed, guaranteeing exactly one dot.\n        if '.' not in file_name: # Handle cases where ExactlyOneDotRule might not have been run or failed\n            return False\n        prefix = file_name.split('.', 1)[0]\n        return bool(prefix)\nclass PrefixStartsWithLetterRule(IValidationRule):\n    \"\"\"Rule to check if the prefix before the dot starts with a latin letter.\"\"\"\n    def validate(self, file_name: str) -> bool:\n        # This rule assumes ExactlyOneDotRule and NonEmptyPrefixRule have passed.\n        if '.' not in file_name:\n            return False\n        prefix = file_name.split('.', 1)[0]\n        if not prefix: # Handle cases where NonEmptyPrefixRule might not have been run or failed\n            return False\n        return prefix[0].isalpha()\nclass ValidExtensionRule(IValidationRule):\n    \"\"\"Rule to check if the file extension is one of the allowed types.\"\"\"\n    ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n\n    def validate(self, file_name: str) -> bool:\n        # This rule assumes ExactlyOneDotRule has passed, guaranteeing exactly one dot.\n        if '.' not in file_name:\n            return False\n        extension = file_name.split('.', 1)[1]\n        return extension in self.ALLOWED_EXTENSIONS\nclass FileNameValidator:\n    \"\"\"Orchestrates the application of individual validation rules.\"\"\"\n    def __init__(self):\n        self.rules = [\n            ExactlyOneDotRule(), # Order matters for some rules, e.g., split('.')\n            NoMoreThanThreeDigitsRule(),\n            NonEmptyPrefixRule(),\n            PrefixStartsWithLetterRule(),\n            ValidExtensionRule()\n        ]\n\n    def is_valid(self, file_name: str) -> bool:\n        \"\"\"Checks if a file name is valid against all predefined rules.\"\"\"\n        for rule in self.rules:\n            if not rule.validate(file_name):\n                return False\n        return True\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions\n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from\n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    validator = FileNameValidator()\n    if validator.is_valid(file_name):\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n\n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    if not lst:\n        return 0\n\n    running_sum = 0\n    for i, value in enumerate(lst):\n        if i % 3 == 0:\n            modified_value = value ** 2\n        elif i % 4 == 0: # Implies i % 3 != 0 due to 'elif' and the previous condition\n            modified_value = value ** 3\n        else:\n            modified_value = value\n        running_sum += modified_value\n    return running_sum"}
{"task_id": "HumanEval/133", "solution": "def sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    \"\"\"\n    import math # Import math module for the ceiling operation.\n\n    total_sum = 0\n    for num in lst:\n        rounded_num = math.ceil(num)\n        total_sum += rounded_num * rounded_num\n    return total_sum"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Processes a list of integers, applying transformations based on index.\n    Returns the sum of all processed entries.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for i, entry in enumerate(lst):\n        processed_value = entry\n        if i % 3 == 0:\n            processed_value = entry * entry\n        elif i % 4 == 0:  # This implicitly means i % 3 != 0 because of the 'elif'\n            processed_value = entry * entry * entry\n\n        total_sum += processed_value\n\n    return total_sum"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Encapsulates a fraction, providing methods for parsing, multiplication, and simplification.\"\"\"\n\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    @classmethod\n    def from_string(cls, fraction_string: str) -> 'Fraction':\n        \"\"\"Parses a string into a Fraction object.\"\"\"\n        num_str, den_str = fraction_string.split('/')\n        return cls(int(num_str), int(den_str))\n\n    def _gcd(self, a: int, b: int) -> int:\n        \"\"\"Calculates the greatest common divisor using the Euclidean algorithm.\"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\n    def _simplify_fraction(self):\n        \"\"\"Reduces the fraction to its lowest terms by dividing by the GCD.\"\"\"\n        common_divisor = self._gcd(self.numerator, self.denominator)\n        self.numerator //= common_divisor\n        self.denominator //= common_divisor\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another and returns a new simplified product fraction.\"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        product_fraction = Fraction(new_numerator, new_denominator)\n        product_fraction._simplify_fraction()\n        return product_fraction\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Checks if the simplified fraction represents a whole number.\"\"\"\n        return self.denominator == 1\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"Evaluates the product of two fractions and determines if the result is a whole number.\"\"\"\n    fraction_x = Fraction.from_string(x)\n    fraction_n = Fraction.from_string(n)\n    product_fraction = fraction_x.multiply(fraction_n)\n    return product_fraction.is_whole_number()"}
{"task_id": "HumanEval/143", "solution": "import math\ndef is_prime(n):\n    \"\"\"\n    Determines if a given integer n is a prime number.\n    Returns True if n is prime, False otherwise.\n    \"\"\"\n    if n <= 1:\n        return False\n    for i in range(2, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            return False\n    return True\ndef words_in_sentence(sentence):\n    \"\"\"\n    Extracts words from the sentence whose lengths are prime numbers.\n    The order of the words in the new string is preserved.\n    \"\"\"\n    prime_words = []\n    words = sentence.split(' ')\n    for word in words:\n        if is_prime(len(word)):\n            prime_words.append(word)\n    return ' '.join(prime_words)"}
{"task_id": "HumanEval/143", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Checks if a given integer n is a prime number.\n    Returns False if n is less than 2, True if n is 2, otherwise checks for divisibility up to n-1.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    for i in range(2, n):\n        if n % i == 0:\n            return False\n    return True\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"Extracts words from the input sentence whose lengths are prime numbers.\n    It splits the sentence, checks each word's length for primality, and returns prime-length words as a space-separated string.\n    \"\"\"\n    prime_words = []\n    words = sentence.split()\n    for word in words:\n        length = len(word)\n        if is_prime(length):\n            prime_words.append(word)\n    return ' '.join(prime_words)"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    x_parts = x.split('/')\n    x_numerator = int(x_parts[0])\n    x_denominator = int(x_parts[1])\n\n    n_parts = n.split('/')\n    n_numerator = int(n_parts[0])\n    n_denominator = int(n_parts[1])\n\n    result_numerator = x_numerator * n_numerator\n    result_denominator = x_denominator * n_denominator\n\n    return result_numerator % result_denominator == 0"}
{"task_id": "HumanEval/145", "solution": "def _calculate_digit_sum(num: int) -> int:\n    \"\"\"Calculates the sum of digits for a number, using absolute values.\"\"\"\n    abs_num = abs(num)\n    digit_sum = 0\n    for digit_char in str(abs_num):\n        digit_sum += int(digit_char)\n    return digit_sum\ndef order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits,\n    preserving original order for ties.\n    \"\"\"\n    if not nums:\n        return []\n\n    # Prepare data for sorting: (digit_sum, original_index, value)\n    decorated_nums = []\n    for original_index, value in enumerate(nums):\n        digit_sum = _calculate_digit_sum(value)\n        decorated_nums.append((digit_sum, original_index, value))\n\n    # Sort based on digit_sum (primary) and original_index (secondary for ties)\n    sorted_decorated_nums = sorted(decorated_nums)\n\n    # Extract the original numbers in their sorted order\n    result = [value for digit_sum, original_index, value in sorted_decorated_nums]\n\n    return result"}
{"task_id": "HumanEval/146", "solution": "def _is_odd(digit: int) -> bool:\n    \"\"\"Checks if a single digit is odd.\"\"\"\n    return digit % 2 != 0\ndef _get_last_digit(number: int) -> int:\n    \"\"\"Extracts the last digit of a number using its absolute value.\"\"\"\n    return abs(number) % 10\ndef _get_first_digit(number: int) -> int:\n    \"\"\"Extracts the first digit of a number using its absolute value and string conversion.\"\"\"\n    return int(str(abs(number))[0])\ndef specialFilter(nums: list[int]) -> int:\n    \"\"\"\n    Counts numbers in a list that are greater than 10 and have both odd first and last digits.\n    This function orchestrates checks using helper functions for clarity.\n    \"\"\"\n    count = 0\n    for number in nums:\n        if number > 10:\n            first_digit = _get_first_digit(number)\n            if _is_odd(first_digit):\n                last_digit = _get_last_digit(number)\n                if _is_odd(last_digit):\n                    count += 1\n    return count"}
{"task_id": "HumanEval/145", "solution": "from typing import List\nfrom dataclasses import dataclass\ndef _calculate_sum_of_digits(number: int) -> int:\n    \"\"\"Calculates the sum of the absolute values of digits for a given integer.\"\"\"\n    s = 0\n    n = abs(number)\n    # The loop handles n=0 correctly by returning 0.\n    while n > 0:\n        s += n % 10\n        n //= 10\n    return s\ndef order_by_points(nums: List[int]) -> List[int]:\n    \"\"\"Sorts a list of integers based on the sum of their digits, maintaining original order for ties.\"\"\"\n    if not nums:\n        return []\n\n    sortable_items: List[_SortableInteger] = []\n    for index, num in enumerate(nums):\n        sum_of_digits = _calculate_sum_of_digits(num)\n        sortable_items.append(_SortableInteger(num, sum_of_digits, index))\n\n    sortable_items.sort()\n\n    return [item.value for item in sortable_items]"}
{"task_id": "HumanEval/139", "solution": "def _factorial(k: int) -> int:\n    \"\"\"Computes the factorial of a non-negative integer k.\n    This helper function is used by special_factorial.\n    \"\"\"\n    if k == 0:\n        return 1\n    result = 1\n    for i in range(1, k + 1):\n        result *= i\n    return result\ndef special_factorial(n):\n    \"\"\"Computes the special factorial of n, which is the product of factorials from n! down to 1!.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    special_fact_result = 1\n    for i in range(n, 0, -1):\n        current_factorial = _factorial(i)\n        special_fact_result *= current_factorial\n\n    return special_fact_result"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts unique triples (a[i], a[j], a[k]) from array 'a' where their sum is a multiple of 3.\n    Array 'a' is constructed such that a[i] = i*i - i + 1 for i from 1 to n.\n    \"\"\"\n    a = []\n    # Populate array 'a' based on the formula a[i] = i*i - i + 1\n    for i in range(1, n + 1):\n        value = i * i - i + 1\n        a.append(value)\n\n    count = 0\n    # Iterate through all combinations of three distinct indices i, j, k such that i < j < k\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                # Calculate the sum of the triple's elements\n                current_sum = a[i] + a[j] + a[k]\n                # Check if the sum is a multiple of 3\n                if current_sum % 3 == 0:\n                    count += 1\n    return count"}
{"task_id": "HumanEval/148", "solution": "PLANETS_ORDER = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\nPLANET_TO_INDEX = {planet: i for i, planet in enumerate(PLANETS_ORDER)}\ndef _get_planet_index(planet_name: str):\n    \"\"\"Retrieves the index of a planet from PLANET_TO_INDEX. Returns None if not found.\"\"\"\n    return PLANET_TO_INDEX.get(planet_name)\ndef bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets located between planet1 and planet2, sorted by proximity to the Sun.\n    Returns an empty tuple if either input planet name is invalid or no planets are between them.\n    \"\"\"\n    index1 = _get_planet_index(planet1)\n    index2 = _get_planet_index(planet2)\n\n    if index1 is None or index2 is None:\n        return ()\n\n    # Determine the effective start and end indices for slicing, ensuring ascending order.\n    # The slice is exclusive of start and end planets.\n    start_slice_index = min(index1, index2) + 1\n    end_slice_index = max(index1, index2)\n\n    # If the start index is greater than or equal to the end index, there are no planets between them.\n    if start_slice_index >= end_slice_index:\n        return ()\n\n    return tuple(PLANETS_ORDER[start_slice_index:end_slice_index])"}
{"task_id": "HumanEval/146", "solution": "def _is_odd(digit):\n    \"\"\"Checks if a single digit is odd.\"\"\"\n    return digit % 2 != 0\ndef _get_last_digit(num):\n    \"\"\"Extracts the last digit from a number's absolute value.\"\"\"\n    return abs(num) % 10\ndef _get_first_digit(num):\n    \"\"\"Extracts the first digit from a number's absolute value.\"\"\"\n    # Convert the absolute number to a string and take its first character.\n    return int(str(abs(num))[0])\ndef _is_greater_than_10(num):\n    \"\"\"Checks if a number is strictly greater than 10.\"\"\"\n    return num > 10\ndef _is_special_number(num):\n    \"\"\"Determines if a number meets all special criteria: >10, odd first and last digits.\"\"\"\n    if not _is_greater_than_10(num):\n        return False\n\n    first_digit = _get_first_digit(num)\n    last_digit = _get_last_digit(num)\n\n    return _is_odd(first_digit) and _is_odd(last_digit)\ndef specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns\n    the number of elements in the array that are greater than 10 and both\n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    For example:\n    specialFilter([15, -73, 14, -15]) => 1\n    specialFilter([33, -2, -3, 45, 21, 109]) => 2\n    \"\"\"\n    special_count = 0\n    for num in nums:\n        if _is_special_number(num):\n            special_count += 1\n    return special_count"}
{"task_id": "HumanEval/149", "solution": "class _String:\n    \"\"\"Represents a string with its length and provides comparison logic.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n        self._length = len(value)\n\n    def get_length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return self._length\n\n    def is_length_odd(self) -> bool:\n        \"\"\"Checks if the string's length is odd.\"\"\"\n        return self._length % 2 != 0\n\n    def get_value(self) -> str:\n        \"\"\"Returns the original string value.\"\"\"\n        return self._value\n\n    def __lt__(self, other: '_String') -> bool:\n        \"\"\"Compares two _String objects first by length, then alphabetically.\"\"\"\n        if self._length != other._length:\n            return self._length < other._length\n        return self._value < other._value\nclass _StringList:\n    \"\"\"Manages a list of _String objects, providing filtering and sorting.\"\"\"\n    def __init__(self, initial_strings: list[str]):\n        self._strings: list[_String] = [_String(s) for s in initial_strings]\n\n    def remove_odd_length_strings(self):\n        \"\"\"Removes all _String objects with odd lengths from the internal list.\"\"\"\n        self._strings = [s for s in self._strings if not s.is_length_odd()]\n\n    def sort_strings_by_length_and_alphabetically(self):\n        \"\"\"Sorts the internal list of _String objects using their custom comparison.\"\"\"\n        self._strings.sort()\n\n    def get_processed_list(self) -> list[str]:\n        \"\"\"Extracts the string values from the processed _String objects.\"\"\"\n        return [s.get_value() for s in self._strings]\ndef sorted_list_sum(lst: list[str]) -> list[str]:\n    \"\"\"Processes a list of strings by removing odd length strings and then sorting.\"\"\"\n    string_list_manager = _StringList(lst)\n    string_list_manager.remove_odd_length_strings()\n    string_list_manager.sort_strings_by_length_and_alphabetically()\n    return string_list_manager.get_processed_list()"}
{"task_id": "HumanEval/148", "solution": "_PLANETS_ORDER = [\n    \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n]\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun\n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn,\n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2.\n    The function should return a tuple containing all planets whose orbits are\n    located between the orbit of planet1 and the orbit of planet2, sorted by\n    the proximity to the sun.\n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names.\n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    try:\n        idx1 = _PLANETS_ORDER.index(planet1)\n        idx2 = _PLANETS_ORDER.index(planet2)\n    except ValueError:\n        # If either planet name is not found, return an empty tuple.\n        return ()\n\n    start_idx = min(idx1, idx2) + 1\n    end_idx = max(idx1, idx2)\n\n    intermediate_planets = _PLANETS_ORDER[start_idx:end_idx]\n    return tuple(intermediate_planets)"}
{"task_id": "HumanEval/147", "solution": "def _calculate_a_values(n: int) -> list[int]:\n    \"\"\"Calculates array 'a' where a[i] = i * i - i + 1 for 1 <= i <= n.\n    Returns a 0-indexed list containing these calculated values.\"\"\"\n    a_values = [0] * (n + 1)\n    for i in range(1, n + 1):\n        a_values[i] = i * i - i + 1\n    return a_values[1:]\ndef _count_triples_optimized(a_values: list[int]) -> int:\n    \"\"\"Counts triples (a[i], a[j], a[k]) from a_values such that their sum is divisible by 3.\n    It categorizes numbers by their remainder modulo 3 and uses combinatorial logic.\"\"\"\n    rem_counts = [0, 0, 0]\n    for val in a_values:\n        rem_counts[val % 3] += 1\n\n    total_count = 0\n    c0, c1, c2 = rem_counts[0], rem_counts[1], rem_counts[2]\n\n    # Combinations whose sum is 0 mod 3:\n    # (0, 0, 0)\n    total_count += (c0 * (c0 - 1) * (c0 - 2)) // 6\n    # (1, 1, 1)\n    total_count += (c1 * (c1 - 1) * (c1 - 2)) // 6\n    # (2, 2, 2)\n    total_count += (c2 * (c2 - 1) * (c2 - 2)) // 6\n    # (0, 1, 2)\n    total_count += c0 * c1 * c2\n\n    return total_count\ndef get_max_triples(n: int) -> int:\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    a_values = _calculate_a_values(n)\n    count = _count_triples_optimized(a_values)\n    return count"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings to include only even-length strings, then sorts them.\n    Sorting is primarily by length ascending, and secondarily alphabetically for equal lengths.\"\"\"\n    filtered_strings = [s for s in lst if len(s) % 2 == 0]\n    sorted_strings = sorted(filtered_strings, key=lambda s: (len(s), s))\n    return sorted_strings"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n\n    \"\"\"\n    def is_prime(num):\n        \"\"\"Checks if an integer num is a prime number.\"\"\"\n        if num <= 1:\n            return False\n        if num <= 3:  # 2 and 3 are prime\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        # Check for factors from 5 up to sqrt(num) in steps of 6.\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/152", "solution": "class MismatchedLengthError(Exception):\n    \"\"\"Raised when the input game and guess arrays have different lengths.\n    It indicates a fundamental mismatch in the data provided for comparison.\n    \"\"\"\n    def __init__(self, message=\"Input arrays must have the same length.\"):\n        self.message = message\n        super().__init__(self.message)\ndef compare(game, guess):\n    \"\"\"Compares actual game scores to player guesses and calculates differences.\n    Returns an array of absolute differences for each corresponding pair.\n    \"\"\"\n    if len(game) != len(guess):\n        raise MismatchedLengthError(\"Actual scores and guesses arrays must have the same length.\")\n\n    differences = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            differences.append(0)\n        else:\n            differences.append(abs(game[i] - guess[i]))\n    return differences"}
{"task_id": "HumanEval/151", "solution": "def _is_integer(num: any) -> bool:\n    \"\"\"Determines if a given value is an integer.\"\"\"\n    return isinstance(num, int)\ndef _is_non_negative(num: int) -> bool:\n    \"\"\"Determines if a given number is non-negative.\"\"\"\n    return num >= 0\ndef _is_odd(num: int) -> bool:\n    \"\"\"Determines if a given integer is odd.\"\"\"\n    return num % 2 != 0\ndef double_the_difference(lst: list) -> int:\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n\n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0\n\n    If the input list is empty, return 0.\n    '''\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for num in lst:\n        # Filtering conditions based on helper functions\n        if _is_integer(num) and _is_non_negative(num) and _is_odd(num):\n            total_sum += num * num\n\n    return total_sum"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Calculates the sum of squares of positive odd integers from a list.\n    Ignores negative numbers and non-integers, returning 0 for an empty list.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for item in lst:\n        # Check if item is an integer (whole number) and positive and odd.\n        # This implicitly filters out non-numeric types if they cause an error on arithmetic operations,\n        # and explicitly filters float values that are not whole numbers (e.g., 2.5),\n        # negative numbers, and even numbers.\n        if (item % 1 == 0) and (item > 0) and (item % 2 != 0):\n            total_sum += int(item) * int(item)\n\n    return total_sum"}
{"task_id": "HumanEval/153", "solution": "def _calculate_strength(extension_name: str) -> int:\n    \"\"\"Calculates the strength of an extension name.\n    Strength is CAP - SM.\"\"\"\n    cap_count = 0\n    sm_count = 0\n    for char in extension_name:\n        if char.isupper():\n            cap_count += 1\n        elif char.islower():\n            sm_count += 1\n    return cap_count - sm_count\nclass Extension:\n    \"\"\"Represents an extension with its name and calculated strength.\"\"\"\n    def __init__(self, name: str):\n        self._name = name\n        self._strength = _calculate_strength(name)\n\n    def get_name(self) -> str:\n        \"\"\"Returns the name of the extension.\"\"\"\n        return self._name\n\n    def get_strength(self) -> int:\n        \"\"\"Returns the calculated strength of the extension.\"\"\"\n        return self._strength\ndef Strongest_Extension(class_name: str, extensions: list[str]) -> str:\n    \"\"\"Finds the strongest extension from a list based on (uppercase - lowercase) letter count.\n    Returns the class name concatenated with the strongest extension, prioritizing earlier occurrences in case of a tie.\"\"\"\n    strongest_ext_obj = None\n    max_strength = float('-inf')\n\n    for ext_name in extensions:\n        current_ext_obj = Extension(ext_name)\n        current_strength = current_ext_obj.get_strength()\n\n        # If current strength is greater, update. For ties, the first one encountered is kept.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_obj = current_ext_obj\n\n    # Assuming 'extensions' list is non-empty as per \"Trust the caller's inputs\"\n    return f\"{class_name}.{strongest_ext_obj.get_name()}\""}
{"task_id": "HumanEval/150", "solution": "def is_prime(number):\n    \"\"\"Checks if a given number is prime. A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself.\"\"\"\n    if number < 2:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n    \"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/154", "solution": "def _generate_rotations(s: str) -> list[str]:\n    \"\"\"Generates all cyclic rotations of a string.\n    Each rotation is created by shifting the characters.\n    \"\"\"\n    rotations = []\n    n = len(s)\n    if n == 0:\n        return []\n    for i in range(n):\n        rotated_s = s[i:] + s[:i]\n        rotations.append(rotated_s)\n    return rotations\ndef cycpattern_check(a: str, b: str) -> bool:\n    \"\"\"Checks if any cyclic rotation of 'b' is a substring of 'a'.\n    It generates rotations of 'b' and searches them in 'a'.\n    \"\"\"\n    if not b:\n        return True\n\n    rotations_of_b = _generate_rotations(b)\n\n    for rotation in rotations_of_b:\n        if rotation in a:\n            return True\n\n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\n    This handles negative integers by considering the absolute value of their digits.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    # Handle negative integers by taking the absolute value (FR5)\n    abs_num = abs(num)\n\n    # Convert the absolute number to a string to easily extract digits\n    num_str = str(abs_num)\n\n    # Iterate through each digit in the string\n    for digit_char in num_str:\n        digit = int(digit_char)  # Convert char digit back to integer\n        if digit % 2 == 0:  # Check if digit is even (FR2)\n            even_count += 1\n        else:  # Digit is odd (FR3)\n            odd_count += 1\n\n    return (even_count, odd_count)  # Return counts as a tuple (FR4)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    \"\"\"\n    # Define mappings for Roman numerals.\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    roman_numerals = []\n    num = number\n    for value, symbol in roman_map:\n        while num >= value:\n            roman_numerals.append(symbol)\n            num -= value\n    return \"\".join(roman_numerals).lower()"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    abs_num = abs(num)\n    abs_num_str = str(abs_num)\n\n    even_count = 0\n    odd_count = 0\n\n    for char_digit in abs_num_str:\n        digit = int(char_digit)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "_ROMAN_MAP = [\n    (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n    (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n    (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'),\n    (1, 'i')\n]\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase. Restrictions: 1 <= num <= 1000.\n    \"\"\"\n    result = []\n    for value, symbol in _ROMAN_MAP:\n        while number >= value:\n            result.append(symbol)\n            number -= value\n    return \"\".join(result)"}
{"task_id": "HumanEval/157", "solution": "def _is_pythagorean_triple(x, y, z):\n    \"\"\"\n    Checks if x^2 + y^2 = z^2, accounting for floating-point inaccuracies.\n    Compares the sum of squares to the square of the third side within a small epsilon.\n    \"\"\"\n    epsilon = 1e-9\n    return abs(x*x + y*y - z*z) < epsilon\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Check all three permutations to see if any satisfy the Pythagorean theorem.\n    return _is_pythagorean_triple(a, b, c) or \\\n           _is_pythagorean_triple(a, c, b) or \\\n           _is_pythagorean_triple(b, c, a)"}
{"task_id": "HumanEval/158", "solution": "def _get_unique_char_count(s: str) -> int:\n    \"\"\"Calculates the number of unique characters in a string.\n    It uses a set to count distinct characters.\"\"\"\n    return len(set(s))\ndef find_max(words: list[str]) -> str:\n    \"\"\"Returns the word with the maximum number of unique characters.\n    Ties are resolved by selecting the string that comes first lexicographically.\"\"\"\n    if not words:\n        return \"\"\n    if len(words) == 1:\n        return words[0]\n\n    best_string = \"\"\n    max_unique_chars = -1\n\n    for current_string in words:\n        unique_count = _get_unique_char_count(current_string)\n\n        if unique_count > max_unique_chars:\n            max_unique_chars = unique_count\n            best_string = current_string\n        elif unique_count == max_unique_chars:\n            # Resolve tie by lexicographical order\n            if current_string < best_string:\n                best_string = current_string\n\n    return best_string"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a: float, b: float, c: float) -> bool:\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    \"\"\"\n    sides = sorted([a, b, c])\n    x, y, z = sides[0], sides[1], sides[2] # x, y are legs, z is hypotenuse\n\n    # Pythagorean theorem: a^2 + b^2 = c^2.\n    # Use a small epsilon for robust floating-point comparison.\n    epsilon = 1e-9\n    return abs((x * x + y * y) - (z * z)) < epsilon"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates total carrots eaten and remaining stock after a rabbit's meal.\n    Determines if enough carrots are available and adjusts consumption accordingly.\n    \"\"\"\n\n    total_eaten_carrots = 0\n    carrots_left_after_meal = 0\n\n    if remaining >= need:\n        total_eaten_carrots = number + need\n        carrots_left_after_meal = remaining - need\n    else: # remaining < need\n        total_eaten_carrots = number + remaining\n        carrots_left_after_meal = 0\n\n    return [total_eaten_carrots, carrots_left_after_meal]"}
{"task_id": "HumanEval/158", "solution": "from typing import List\ndef _calculate_unique_chars(word: str) -> int:\n    \"\"\"Calculates the number of unique characters in a given string.\"\"\"\n    return len(set(word))\ndef _compare_words_lexicographically(word1: str, word2: str) -> int:\n    \"\"\"Compares two words lexicographically and returns -1 if word1 < word2, 0 if equal, 1 if word1 > word2.\"\"\"\n    if word1 < word2:\n        return -1\n    elif word1 == word2:\n        return 0\n    else:\n        return 1\ndef find_max(words: List[str]) -> str:\n    \"\"\"\n    Finds the word with the maximum number of unique characters from a list of strings.\n    If multiple strings have the same maximum unique character count, the lexicographically smallest one is returned.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_word = \"\"\n    max_unique_count = -1 # Initialize with a value less than any possible unique char count\n\n    for i, current_word in enumerate(words):\n        current_unique_count = _calculate_unique_chars(current_word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            max_word = current_word\n        elif current_unique_count == max_unique_count:\n            # If counts are equal, apply lexicographical tie-breaking\n            if _compare_words_lexicographically(current_word, max_word) < 0:\n                max_word = current_word\n\n    return max_word"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates total carrots eaten and remaining carrots after a meal.\n    Ensures consumption does not exceed available stock.\n    \"\"\"\n\n    eatenInCurrentMeal = min(need, remaining)\n    totalCarrotsEaten = number + eatenInCurrentMeal\n    carrotsLeftInStock = remaining - eatenInCurrentMeal\n\n    return [totalCarrotsEaten, carrotsLeftInStock]"}
{"task_id": "HumanEval/161", "solution": "def _is_letter(char: str) -> bool:\n    \"\"\"Checks if a character is an alphabetic letter.\"\"\"\n    return char.isalpha()\ndef _reverse_case(char: str) -> str:\n    \"\"\"Reverses the case of an alphabetic character.\"\"\"\n    if char.islower():\n        return char.upper()\n    elif char.isupper():\n        return char.lower()\n    return char\ndef _has_letters(s: str) -> bool:\n    \"\"\"Checks if the string contains any alphabetic letters.\"\"\"\n    for char in s:\n        if _is_letter(char):\n            return True\n    return False\ndef solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa,\n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    if _has_letters(s):\n        transformed_chars = []\n        for char in s:\n            if _is_letter(char):\n                transformed_chars.append(_reverse_case(char))\n            else:\n                transformed_chars.append(char)\n        return \"\".join(transformed_chars)\n    else:\n        return s[::-1]"}
{"task_id": "HumanEval/161", "solution": "def _has_letters(s: str) -> bool:\n    \"\"\"Checks if the string contains any alphabetic characters.\"\"\"\n    for char in s:\n        if 'a' <= char <= 'z' or 'A' <= char <= 'Z':\n            return True\n    return False\ndef _reverse_case_char(char_val: str) -> str:\n    \"\"\"Reverses the case of a letter or returns the character unchanged.\"\"\"\n    if 'a' <= char_val <= 'z':\n        return chr(ord(char_val) - ord('a') + ord('A'))\n    elif 'A' <= char_val <= 'Z':\n        return chr(ord(char_val) - ord('A') + ord('a'))\n    return char_val\ndef _reverse_string(s: str) -> str:\n    \"\"\"Reverses the entire input string.\"\"\"\n    return s[::-1]\ndef solve(s):\n    \"\"\"Reverses letter cases or reverses the whole string if no letters are present.\"\"\"\n    if not _has_letters(s):\n        return _reverse_string(s)\n\n    result_chars = []\n    for char in s:\n        result_chars.append(_reverse_case_char(char))\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/160", "solution": "def _build_expression_string(operators: list[str], operands: list[int]) -> str:\n    # Constructs an algebraic expression string by interleaving operands and operators.\n    expression_parts = []\n    for i in range(len(operators)):\n        expression_parts.append(str(operands[i]))\n        expression_parts.append(operators[i])\n    expression_parts.append(str(operands[-1]))\n    return \" \".join(expression_parts)\ndef _evaluate_expression_string(expression_string: str) -> int:\n    # Evaluates the given algebraic expression string, adhering to standard operator precedence.\n    return int(eval(expression_string))\ndef do_algebra(operator: list[str], operand: list[int]) -> int:\n    \"\"\"\n    Given operator and operand lists, this function builds an algebraic expression and returns its evaluated integer result.\n    \"\"\"\n    _validate_inputs(operator, operand)\n    expression_string = _build_expression_string(operator, operand)\n    result = _evaluate_expression_string(expression_string)\n    return result"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + )\n    Subtraction ( - )\n    Multiplication ( * )\n    Floor division ( // )\n    Exponentiation ( ** )\n\n    Example:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n\n    \"\"\"\n    # 1. Input Validation\n    valid_operators = {'+', '-', '*', '//', '**'}\n\n    # Check length constraint\n    if not (len(operator) == len(operand) - 1 and len(operator) >= 1):\n        raise ValueError(\n            \"The length of operator list must be equal to the length of operand list minus one, \"\n            \"and operator list must have at least one operator, and operand list at least two operands.\"\n        )\n\n    # Check operand types and non-negativity\n    for op_val in operand:\n        if not isinstance(op_val, int) or op_val < 0:\n            raise ValueError(\"All operands must be non-negative integers.\")\n\n    # Check operator validity\n    for op_str in operator:\n        if op_str not in valid_operators:\n            raise ValueError(f\"Invalid operator found: '{op_str}'. Allowed operators are {', '.join(valid_operators)}.\")\n\n    # 2. Expression Construction\n    expression_parts = [str(operand[0])]\n    for i in range(len(operator)):\n        expression_parts.append(operator[i])\n        expression_parts.append(str(operand[i + 1]))\n\n    expression_string = \" \".join(expression_parts)\n\n    # 3. Evaluation\n    try:\n        # Using eval() is generally unsafe for untrusted input, but here the operators and operands\n        # are controlled by the function's input validation to form a simple arithmetic expression.\n        result = eval(expression_string)\n        return float(result)\n    except Exception as e:\n        # This catches any potential errors during evaluation, though with valid inputs,\n        # it should ideally not be reached.\n        raise ValueError(f\"Error evaluating expression '{expression_string}': {e}\")"}
{"task_id": "HumanEval/153", "solution": "def _calculate_extension_strength(extension_name: str) -> int:\n    \"\"\"Calculates the strength of an extension name.\n    Strength is defined as (number of uppercase letters - number of lowercase letters).\n    \"\"\"\n    cap_count = sum(1 for char in extension_name if char.isupper())\n    sm_count = sum(1 for char in extension_name if char.islower())\n    return cap_count - sm_count\ndef Strongest_Extension(class_name: str, extensions: list[str]) -> str:\n    \"\"\"You will be given the name of a class (a string) and a list of extensions.\n    The extensions are to be used to load additional classes to the class. The\n    strength of the extension is as follows: Let CAP be the number of the uppercase\n    letters in the extension's name, and let SM be the number of lowercase letters\n    in the extension's name, the strength is given by the fraction CAP - SM.\n    You should find the strongest extension and return a string in this\n    format: ClassName.StrongestExtensionName.\n    If there are two or more extensions with the same strength, you should\n    choose the one that comes first in the list.\n    For example, if you are given \"Slices\" as the class and a list of the\n    extensions: ['SErviNGSliCes', 'Cheese', 'StuFfed'] then you should\n    return 'Slices.SErviNGSliCes' since 'SErviNGSliCes' is the strongest extension\n    (its strength is -1).\n    Example:\n    for Strongest_Extension('my_class', ['AA', 'Be', 'CC']) == 'my_class.AA'\n    \"\"\"\n    strongest_extension_name = \"\"\n    max_strength = -float('inf')\n\n    for ext_name in extensions:\n        current_strength = _calculate_extension_strength(ext_name)\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = ext_name\n        # For ties (current_strength == max_strength), the existing strongest_extension_name\n        # is kept, implicitly choosing the one that came first in the list.\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text: str) -> str | None:\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n\n    # Encode the string to bytes and compute MD5 hash.\n    md5_hash = hashlib.md5(text.encode('utf-8')).hexdigest()\n    return md5_hash"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n    result_list = []\n\n    # Iterate through potential even, single-digit numbers.\n    candidate_digits = [0, 2, 4, 6, 8]\n\n    for digit in candidate_digits:\n        if min_val <= digit <= max_val:\n            result_list.append(digit)\n\n    return result_list"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    else:\n        return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n    even_numbers = []\n\n    for num in range(min_val, max_val + 1):\n        if num % 2 == 0:\n            even_numbers.append(num)\n\n    return even_numbers"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\n    It iterates through all rotations of b and checks for their presence in a.\n    \"\"\"\n    n = len(b)\n    for i in range(n):\n        rotated_b = b[i:] + b[:i]\n        if rotated_b in a:\n            return True\n    return False"}
{"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"\n    Compares two lists of scores and guesses, calculating the absolute difference for each pair.\n    Returns a new list containing these absolute differences.\n    \"\"\"\n    differences = []\n    for i in range(len(game)):\n        differences.append(abs(game[i] - guess[i]))\n    return differences"}
