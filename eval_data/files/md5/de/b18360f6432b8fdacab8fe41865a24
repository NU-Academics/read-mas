{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\"Checks if parentheses in a string are correctly matched and nested.\n    Ignores non-parenthesis characters.\n    \"\"\"\n    stack = []\n    for char in brackets:\n        if char == '(':\n            stack.append(char)\n        elif char == ')':\n            if not stack:\n                return False  # Unmatched closing bracket\n            stack.pop()\n        # Other characters are ignored as per FR5.\n\n    return not stack # True if stack is empty, False otherwise"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list) -> list:\n    \"\"\"\n    Computes the derivative of a polynomial given its coefficients.\n    Each term xs[i]*x^i becomes (xs[i]*i)*x^(i-1) in the derivative.\n    \"\"\"\n    derivative_coeffs = []\n    # Iterate from index 1 (coefficient of x^1) to calculate derivatives.\n    for i in range(1, len(xs)):\n        new_coefficient = xs[i] * i\n        derivative_coeffs.append(new_coefficient)\n    return derivative_coeffs"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int, _memo: dict[int, int] = None) -> int:\n    \"\"\"Computes the n-th element of the FibFib number sequence efficiently using memoization.\n    The sequence is defined by fibfib(0)=0, fibfib(1)=0, fibfib(2)=1, and fibfib(n)=fibfib(n-1)+fibfib(n-2)+fibfib(n-3) for n > 2.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if _memo is None:\n        _memo = {}\n\n    if n in _memo:\n        return _memo[n]\n\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 1\n\n    # For n > 2, apply the recursive definition\n    result = fibfib(n - 1, _memo) + fibfib(n - 2, _memo) + fibfib(n - 3, _memo)\n    _memo[n] = result\n    return result"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list) -> list:\n    \"\"\"\n    Calculates the derivative of a polynomial represented by a list of coefficients.\n    Returns derivative of this polynomial in the same form.\n    \"\"\"\n    derived_coefficients = []\n    for i in range(1, len(xs)):\n        derived_coefficients.append(xs[i] * i)\n    return derived_coefficients"}
{"task_id": "HumanEval/63", "solution": "_memoization_cache = {}\ndef fibfib(n: int):\n    \"\"\"Computes the n-th FibFib number using memoization.\n    The function handles base cases and recursively calculates higher numbers, storing results in a cache.\n    \"\"\"\n    if n in _memoization_cache:\n        return _memoization_cache[n]\n\n    if n == 0 or n == 1:\n        result = 0\n    elif n == 2:\n        result = 1\n    else:  # n > 2\n        result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n\n    _memoization_cache[n] = result\n    return result"}
