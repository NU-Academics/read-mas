{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_sevens_count = 0\n    for x in range(1, n):\n        is_divisible_by_11 = (x % 11 == 0)\n        is_divisible_by_13 = (x % 13 == 0)\n\n        if is_divisible_by_11 or is_divisible_by_13:\n            digit_count = str(x).count('7')\n            total_sevens_count += digit_count\n    return total_sevens_count"}
{"task_id": "HumanEval/36", "solution": "def _is_divisible_by_11_or_13(number: int) -> bool:\n    \"\"\"Checks if a number is divisible by 11 or 13.\n    Returns True if divisible, False otherwise.\"\"\"\n    return number % 11 == 0 or number % 13 == 0\ndef _count_digit_occurrences(number: int, digit: int) -> int:\n    \"\"\"Counts how many times a specific digit appears in a number.\n    Converts both to strings for counting.\"\"\"\n    return str(number).count(str(digit))\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n\n    which are divisible by 11 or 13.\"\"\"\n    total_sevens_count = 0\n    for number in range(1, n):\n        if _is_divisible_by_11_or_13(number):\n            total_sevens_count += _count_digit_occurrences(number, 7)\n    return total_sevens_count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    # Extract all elements from even indices and sort them.\n    even_indexed_values = [l[i] for i in range(0, len(l), 2)]\n    even_indexed_values.sort()\n\n    # Create a new list, copying the original to preserve odd-indexed elements.\n    result_list = list(l)\n\n    # Replace the even-indexed elements in the new list with the sorted values.\n    sorted_even_value_idx = 0\n    for i in range(0, len(l), 2):\n        result_list[i] = even_indexed_values[sorted_even_value_idx]\n        sorted_even_value_idx += 1\n\n    return result_list"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    output_list = list(l) # Create a copy of the input list.\n\n    even_indexed_values = [l[i] for i in range(0, len(l), 2)]\n    even_indexed_values.sort() # Sort the collected even-indexed values.\n\n    sorted_even_ptr = 0\n    for i in range(len(output_list)):\n        if i % 2 == 0:  # If the current index is even\n            output_list[i] = even_indexed_values[sorted_even_ptr]\n            sorted_even_ptr += 1\n        # Elements at odd indices remain unchanged from the initial copy.\n\n    return output_list"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    Takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # Split the encoded string into groups of three characters.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # Reverse the cyclic shift for groups of three characters, leaving smaller groups unchanged.\n    decoded_groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(decoded_groups)"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    unshifted_groups = []\n    for group in groups:\n        if len(group) == 3:\n            # Reverse shift: last character becomes first, first two characters shift right.\n            unshifted_groups.append(group[2] + group[:2])\n        else:\n            unshifted_groups.append(group)\n    return \"\".join(unshifted_groups)"}
{"task_id": "HumanEval/39", "solution": "def _is_perfect_square(num: int) -> bool:\n    \"\"\"Checks if a number is a perfect square without using math.sqrt.\n    It returns True if num is a perfect square, False otherwise.\"\"\"\n    if num < 0:\n        return False\n    if num == 0 or num == 1:\n        return True\n\n    # Use binary search to find the integer square root.\n    low, high = 1, num\n    ans = 1\n    while low <= high:\n        mid = (low + high) // 2\n        if mid * mid == num:\n            return True\n        if mid * mid < num:\n            ans = mid\n            low = mid + 1\n        else:\n            high = mid - 1\n    return ans * ans == num\ndef is_fibonacci(num: int) -> bool:\n    \"\"\"Checks if num is a Fibonacci number using a mathematical property.\n    A number x is Fibonacci if 5*x^2 + 4 or 5*x^2 - 4 is a perfect square.\"\"\"\n    if num < 0:\n        return False\n    return _is_perfect_square(5 * num * num + 4) or _is_perfect_square(5 * num * num - 4)\ndef is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime using trial division up to its square root.\n    It efficiently handles small numbers and even numbers.\"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    # Iterate only over odd divisors from 3 up to sqrt(num)\n    i = 3\n    while i * i <= num:\n        if num % i == 0:\n            return False\n        i += 2\n    return True\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    It iteratively finds numbers that are both Fibonacci and prime.\n    \"\"\"\n    found_count = 0\n    current_number = 2  # Start checking from 2, which is the 1st prime Fibonacci number\n\n    while True:\n        if is_fibonacci(current_number) and is_prime(current_number):\n            found_count += 1\n            if found_count == n:\n                return current_number\n        current_number += 1"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    It returns True if three distinct elements in the list sum to zero, False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n    return False"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    \"\"\"\n    n = len(l)\n    l_prime = list(l)  # Create a shallow copy to preserve non-divisible elements\n    temp_divisible_values = []\n\n    # Extract elements at indices divisible by three\n    for i in range(n):\n        if i % 3 == 0:\n            temp_divisible_values.append(l[i])\n\n    # Sort the extracted elements\n    temp_divisible_values.sort()\n\n    # Place sorted elements back into l_prime at corresponding indices\n    sorted_idx = 0\n    for i in range(n):\n        if i % 3 == 0:\n            l_prime[i] = temp_divisible_values[sorted_idx]\n            sorted_idx += 1\n\n    return l_prime"}
{"task_id": "HumanEval/40", "solution": "class TripletSumChecker:\n    \"\"\"\n    Encapsulates the core algorithm for finding three distinct elements that sum to zero.\n    It performs the search for a triplet summing to zero in the provided list.\n    \"\"\"\n    def check_triples_sum_to_zero(self, elements: list[int]) -> bool:\n        \"\"\"\n        Performs the search for a triplet summing to zero in the provided list.\n        It iterates through all unique combinations of three distinct elements.\n        \"\"\"\n        n = len(elements)\n        for i in range(n):\n            for j in range(i + 1, n):\n                for k in range(j + 1, n):\n                    if elements[i] + elements[j] + elements[k] == 0:\n                        return True\n        return False\ndef triples_sum_to_zero(l: list[int]) -> bool:\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    It returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    if len(l) < 3:\n        return False\n\n    checker = TripletSumChecker()\n    return checker.check_triples_sum_to_zero(l)"}
