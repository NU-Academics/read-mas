{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    An empty or single-element list is considered monotonic.\n    \"\"\"\n    n = len(l)\n    if n <= 1:\n        return True\n\n    # Check if the list is monotonically increasing\n    is_increasing = True\n    for i in range(1, n):\n        if l[i] < l[i-1]:\n            is_increasing = False\n            break\n\n    if is_increasing:\n        return True\n\n    # If not increasing, check if the list is monotonically decreasing\n    is_decreasing = True\n    for i in range(1, n):\n        if l[i] > l[i-1]:\n            is_decreasing = False\n            break\n\n    return is_decreasing"}
{"task_id": "HumanEval/57", "solution": "def _is_increasing(l: list) -> bool:\n    \"\"\"\n    Checks if a list of numbers is monotonically increasing.\n    Empty or single-element lists are considered increasing.\n    \"\"\"\n    if len(l) <= 1:\n        return True\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            return False\n    return True\ndef _is_decreasing(l: list) -> bool:\n    \"\"\"\n    Checks if a list of numbers is monotonically decreasing.\n    Empty or single-element lists are considered decreasing.\n    \"\"\"\n    if len(l) <= 1:\n        return True\n    for i in range(len(l) - 1):\n        if l[i] < l[i+1]:\n            return False\n    return True\ndef monotonic(l: list):\n    \"\"\"\n    Checks if a list of numbers is monotonically increasing or decreasing.\n\n    >>> monotonic([1, 2, 3, 4])\n    True\n    >>> monotonic([1, 1, 2, 3])\n    True\n    >>> monotonic([])\n    True\n    >>> monotonic([5])\n    True\n    >>> monotonic([4, 3, 2, 1])\n    True\n    >>> monotonic([3, 2, 2, 1])\n    True\n    >>> monotonic([1, 3, 2, 4])\n    False\n    >>> monotonic([1, 2, 1, 3])\n    False\n    >>> monotonic([5, 1, 5])\n    False\n    \"\"\"\n    return _is_increasing(l) or _is_decreasing(l)"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    result = 1\n    base = 2 % p\n    while n > 0:\n        if n % 2 == 1:\n            result = (result * base) % p\n        base = (base * base) % p\n        n //= 2\n    return result"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n\n    \"\"\"\n    # Convert lists to sets to efficiently find unique common elements.\n    set_l1 = set(l1)\n    set_l2 = set(l2)\n\n    # Find the intersection of the two sets.\n    common_elements_set = set_l1 & set_l2\n\n    # Convert the set of common elements to a list and sort it.\n    sorted_common_list = sorted(list(common_elements_set))\n    return sorted_common_list"}
