{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    This function checks for integer divisors from 2 up to the square root of n.\n    \"\"\"\n    if n <= 1:\n        return False\n\n    i = 2\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 1\n    return True"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    \"\"\"\n\n    result_list = [None] * len(l)\n    elements_to_sort = []\n    indices_to_sort = []\n\n    # First pass: segregate elements and copy non-third-index elements\n    for i in range(len(l)):\n        if i % 3 == 0:\n            elements_to_sort.append(l[i])\n            indices_to_sort.append(i)\n        else:\n            result_list[i] = l[i]\n\n    # Sort the collected elements\n    elements_to_sort.sort()\n\n    # Second pass: reintegrate sorted elements into their original positions\n    sorted_idx = 0\n    for original_index in indices_to_sort:\n        result_list[original_index] = elements_to_sort[sorted_idx]\n        sorted_idx += 1\n\n    return result_list"}
{"task_id": "HumanEval/32", "solution": "import math\nclass Polynomial:\n    \"\"\"\n    Encapsulates polynomial coefficients and provides evaluation and root-finding.\n    \"\"\"\n    def __init__(self, coefficients: list[float]):\n        \"\"\"\n        Initializes the Polynomial with a list of coefficients.\n        \"\"\"\n        self.coefficients = coefficients\n\n    def evaluate(self, x: float) -> float:\n        \"\"\"\n        Calculates the value of the polynomial at a given x.\n        \"\"\"\n        return sum([coeff * math.pow(x, i) for i, coeff in enumerate(self.coefficients)])\n\n    def _get_derivative_coefficients(self) -> list[float]:\n        \"\"\"\n        Computes the coefficients of the polynomial's derivative.\n        \"\"\"\n        # The derivative of sum(c_i * x^i) is sum(i * c_i * x^(i-1)).\n        return [i * self.coefficients[i] for i in range(1, len(self.coefficients))]\n\n    def find_zero_root(self) -> float:\n        \"\"\"\n        Finds a single zero point (root) for the polynomial using Newton's method.\n        \"\"\"\n        derivative_coeffs = self._get_derivative_coefficients()\n        derivative_poly = Polynomial(derivative_coeffs) # Polynomial object for the derivative\n\n        x_current = 0.5  # Initial guess for Newton's method\n        tolerance = 1e-6\n        max_iterations = 100\n\n        for _ in range(max_iterations):\n            f_x = self.evaluate(x_current)\n            f_prime_x = derivative_poly.evaluate(x_current)\n\n            if abs(f_x) < tolerance:\n                return x_current # Root found within tolerance\n\n            # If derivative is near zero, Newton's method might fail; nudge x_current.\n            if abs(f_prime_x) < 1e-9:\n                x_current += 0.01\n                continue\n\n            x_next = x_current - f_x / f_prime_x\n\n            if abs(x_next - x_current) < tolerance:\n                return x_next # Converged\n\n            x_current = x_next\n\n        return x_current # Return best approximation if max iterations reached\ndef find_zero(xs: list) -> float:\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Preconditions: even number of coefficients, largest coefficient non-zero.\n    if not (len(xs) % 2 == 0 and xs and xs[-1] != 0):\n        raise ValueError(\"Polynomial must have an even number of coefficients and a non-zero largest coefficient.\")\n\n    polynomial_obj = Polynomial(xs)\n    return polynomial_obj.find_zero_root()"}
{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero finds x such that poly(x) = 0, returning one zero point.\n    \"\"\"\n    low = -1000.0  # A sufficiently wide range to bracket a root.\n    high = 1000.0\n    epsilon = 1e-7 # Desired precision for the root.\n\n    # Bisection method to find a root.\n    for _ in range(100): # Fixed number of iterations for convergence.\n        mid = (low + high) / 2\n        val_mid = poly(xs, mid)\n\n        if abs(val_mid) < epsilon:\n            return mid\n\n        # Determine which half of the interval contains the root.\n        if poly(xs, low) * val_mid < 0:\n            high = mid\n        else:\n            low = mid\n\n    return (low + high) / 2 # Return the midpoint of the final interval."}
