{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"Computes the n-th element of the Fib4 number sequence iteratively.\n    It follows the recurrence fib4(n) = fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the internal state with the first four Fib4 numbers.\n    # This stores [fib4(0), fib4(1), fib4(2), fib4(3)] initially.\n    last_four = [0, 0, 2, 0]\n\n    # Iterate from i = 4 up to n to calculate subsequent Fib4 numbers.\n    for i in range(4, n + 1):\n        # Calculate the next Fib4 number as the sum of the last four values.\n        next_fib4 = last_four[0] + last_four[1] + last_four[2] + last_four[3]\n        # Update the state by removing the oldest value and adding the new one.\n        last_four.pop(0)\n        last_four.append(next_fib4)\n\n    # After the loop, the last element in 'last_four' is fib4(n).\n    return last_four[-1]"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    The median is the middle element for odd-length lists or the average of the two middle elements for even-length lists.\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # For odd-length lists, the median is the middle element.\n        return sorted_l[n // 2]\n    else:\n        # For even-length lists, the median is the average of the two middle elements.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"Computes the n-th element of the Fib4 number sequence iteratively.\n    This implementation avoids recursion for efficiency and adheres to specific base cases.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # For n > 3, use an iterative approach with constant space.\n    # Initialize the last four values as fib4(0), fib4(1), fib4(2), fib4(3).\n    f_n_minus_4, f_n_minus_3, f_n_minus_2, f_n_minus_1 = 0, 0, 2, 0\n\n    for _ in range(4, n + 1):\n        current_fib = f_n_minus_1 + f_n_minus_2 + f_n_minus_3 + f_n_minus_4\n        # Shift values for the next iteration\n        f_n_minus_4 = f_n_minus_3\n        f_n_minus_3 = f_n_minus_2\n        f_n_minus_2 = f_n_minus_1\n        f_n_minus_1 = current_fib\n\n    return f_n_minus_1"}
