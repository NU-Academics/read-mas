{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    \"\"\"\n    Calculates the area of a triangle given its three side lengths.\n    Returns the area rounded to 2 decimal points if valid, otherwise -1.0.\n    \"\"\"\n    # Check for triangle inequality: sum of any two sides must be greater than the third.\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1.0\n\n    s = (a + b + c) / 2\n\n    # Calculate the expression under the square root for Heron's formula.\n    area_squared = s * (s - a) * (s - b) * (s - c)\n\n    # Handle floating point inaccuracies that might result in a tiny negative area_squared.\n    if area_squared < 0:\n        area_squared = 0.0\n\n    area = math.sqrt(area_squared)\n    return round(area, 2)"}
{"task_id": "HumanEval/71", "solution": "import math\nclass Triangle:\n    \"\"\"Encapsulates triangle properties and logic for validation, semi-perimeter, and area calculation.\"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        self._side_a = a\n        self._side_b = b\n        self._side_c = c\n        self._semi_perimeter: float | None = None\n        self._area: float | None = None\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the current side lengths form a valid triangle using the triangle inequality theorem.\"\"\"\n        # Sum of any two sides must be strictly greater than the third side.\n        return (self._side_a + self._side_b > self._side_c and\n                self._side_a + self._side_c > self._side_b and\n                self._side_b + self._side_c > self._side_a)\n\n    def calculate_semi_perimeter(self) -> float:\n        \"\"\"Calculates and stores the semi-perimeter of the triangle.\"\"\"\n        self._semi_perimeter = (self._side_a + self._side_b + self._side_c) / 2\n        return self._semi_perimeter\n\n    def calculate_area(self) -> float:\n        \"\"\"Calculates and stores the area of the triangle using Heron's formula.\"\"\"\n        s = self._semi_perimeter # Assumes semi-perimeter has been calculated.\n\n        term = s * (s - self._side_a) * (s - self._side_b) * (s - self._side_c)\n        self._area = math.sqrt(term)\n        return self._area\n\n    def get_rounded_area(self) -> float:\n        \"\"\"Returns the calculated area rounded to two decimal places.\"\"\"\n        return round(self._area, 2)\ndef triangle_area(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Calculates the area of a triangle given its three side lengths.\n    Returns the rounded area or -1 if the sides do not form a valid triangle.\n    \"\"\"\n    triangle = Triangle(a, b, c)\n\n    if not triangle.is_valid():\n        return -1.0\n\n    triangle.calculate_semi_perimeter()\n    triangle.calculate_area()\n    return triangle.get_rounded_area()"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q, w):\n    \"\"\"\n    Determines if an object q will fly based on palindromic nature and weight.\n    It flies if q is a palindrome AND the sum of its elements is less than or equal to w.\n    \"\"\"\n\n    def _is_palindromic(lst):\n        \"\"\"Checks if a list is palindromic.\"\"\"\n        return lst == lst[::-1]\n\n    def _calculate_sum(lst):\n        \"\"\"Calculates the sum of elements in a list.\"\"\"\n        return sum(lst)\n\n    is_balanced = _is_palindromic(q)\n    total_weight = _calculate_sum(q)\n\n    return is_balanced and total_weight <= w"}
