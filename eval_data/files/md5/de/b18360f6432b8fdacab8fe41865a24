{"task_id": "HumanEval/39", "solution": "import math\ndef is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime. It uses an optimized trial division method.\"\"\"\n    if num <= 1:\n        return False\n    if num <= 3:\n        return True\n    if num % 2 == 0 or num % 3 == 0:\n        return False\n    i = 5\n    while i * i <= num:\n        if num % i == 0 or num % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef is_fibonacci(num: int) -> bool:\n    \"\"\"Checks if a number is a Fibonacci number using a mathematical property.\"\"\"\n    if num < 0:\n        return False\n    if num == 0 or num == 1:\n        return True\n\n    def is_perfect_square(n: int) -> bool:\n        s = int(math.isqrt(n))\n        return s * s == n\n\n    return is_perfect_square(5 * num * num + 4) or is_perfect_square(5 * num * num - 4)\ndef prime_fib(n: int) -> int:\n    \"\"\"Returns the n-th number that is both a Fibonacci number and a prime number.\"\"\"\n    count = 0\n    current_candidate = 2\n    while True:\n        if is_fibonacci(current_candidate) and is_prime(current_candidate):\n            count += 1\n            if count == n:\n                return current_candidate\n        current_candidate += 1"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int) -> int:\n    \"\"\"Calculates 2^n modulo p using modular exponentiation. This handles large values of n accurately.\"\"\"\n    res = 1\n    base = 2 % p\n\n    while n > 0:\n        if n % 2 == 1:\n            res = (res * base) % p\n        base = (base * base) % p\n        n //= 2\n\n    return res"}
