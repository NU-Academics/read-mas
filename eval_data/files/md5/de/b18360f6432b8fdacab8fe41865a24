{"task_id": "HumanEval/74", "solution": "def _calculate_total_char_count(string_list):\n    \"\"\"Calculates the sum of lengths of all strings in the provided list.\n    This helper function is used to determine the total character count.\"\"\"\n    total_count = 0\n    for s in string_list:\n        total_count += len(s)\n    return total_count\ndef total_match(lst1, lst2):\n    \"\"\"Compares two lists of strings based on their total character counts and returns the list with the lower count.\n    If counts are equal, the first list is returned.\"\"\"\n    count1 = _calculate_total_char_count(lst1)\n    count2 = _calculate_total_char_count(lst2)\n\n    if count1 < count2:\n        return lst1\n    elif count2 < count1:\n        return lst2\n    else: # count1 == count2\n        return lst1"}
{"task_id": "HumanEval/75", "solution": "def get_prime_factors(n: int) -> list[int]:\n    \"\"\"Finds all prime factors of n, including duplicates. Returns an empty list for n <= 1.\"\"\"\n    factors = []\n\n    if n <= 1:\n        return []\n\n    # Count the number of 2s that divide n\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # n must be odd at this point, so we can skip even numbers\n    # We only need to check factors up to sqrt(n)\n    i = 3\n    while i * i <= n:\n        # While i divides n, add i to factors and divide n\n        while n % i == 0:\n            factors.append(i)\n            n //= i\n        i += 2  # Move to the next odd number\n\n    # If n is still greater than 2, it must be a prime factor itself\n    if n > 2:\n        factors.append(n)\n\n    return factors\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    # The input integer 'a' must be less than 100 and greater than 1 for valid prime factorization.\n    if a <= 1 or a >= 100:\n        return False\n\n    prime_factors = get_prime_factors(a)\n\n    # Return True if the number of prime factors is exactly three, False otherwise.\n    return len(prime_factors) == 3"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Determines if an integer `a` is a perfect cube.\n    This function returns True if `a` is the cube of some integer, False otherwise.\n    '''\n    if a == 0:\n        return True\n\n    # Calculate the integer cube root of the absolute value.\n    # We use float exponentiation and then round to the nearest integer.\n    root = round(abs(a)**(1/3))\n\n    if a > 0:\n        return root * root * root == a\n    else: # a < 0\n        # For negative inputs, the perfect cube root must also be negative.\n        return (-root) * (-root) * (-root) == a"}
{"task_id": "HumanEval/76", "solution": "import math\ndef is_simple_power(x, n):\n    \"\"\"Checks if x is n to the power of some integer i (n**i = x).\n    Handles edge cases like x=1, n=1, n=0, and negative inputs.\"\"\"\n\n    TOLERANCE = 1e-9 # A small tolerance for floating point comparisons\n\n    # Case 1: x = 1\n    # 1 is n**0 for any n != 0. Python's 0**0 is 1.\n    if abs(x - 1.0) < TOLERANCE:\n        return True\n\n    # Case 2: n = 1 (and x != 1, handled by previous check)\n    # If n is 1, 1**i is always 1. Since x != 1, it cannot be a simple power of 1.\n    if abs(n - 1.0) < TOLERANCE:\n        return False\n\n    # Case 3: x = 0 (and x != 1)\n    # If x is 0, n**i = 0 is only true if n = 0 and i > 0.\n    if abs(x) < TOLERANCE:\n        return abs(n) < TOLERANCE\n\n    # Case 4: n = 0 (and x != 0, 1)\n    # If n is 0, and x is not 0 or 1, then 0**i cannot be x for any integer i.\n    if abs(n) < TOLERANCE:\n        return False\n\n    # At this point: x is not 0 or 1, and n is not 0 or 1.\n\n    # If x is negative and n is positive:\n    # A positive number raised to any integer power will always be positive.\n    if x < -TOLERANCE and n > TOLERANCE:\n        return False\n\n    # Logic for n > 0 (and n != 1)\n    if n > TOLERANCE:\n        # Since n > 0 and n != 1, and we handled x <= 0 (x=0 returns false; x<0 returns false)\n        # We know x > 0 here. So both x and n are positive and n != 1.\n        try:\n            i_float = math.log(x, n)\n        except ValueError: # Catches cases like log(negative) or log(0) if edge cases missed\n            return False\n\n        # Check if the calculated exponent is an integer within tolerance.\n        i_int = round(i_float)\n        return abs(i_float - i_int) < TOLERANCE\n\n    # Logic for n < 0 (and n != -1, implicit as abs(n) is used)\n    # We already handled n=0, n=1. So n is negative and not 0, 1.\n    # n**i = x implies (abs(n))**i = abs(x).\n    # Additionally, if i is even, n**i > 0. If i is odd, n**i < 0.\n\n    abs_n = abs(n)\n    abs_x = abs(x)\n\n    # Calculate i using absolute values. abs_n is positive and not 1. abs_x is positive.\n    try:\n        i_float = math.log(abs_x, abs_n)\n    except ValueError:\n        return False\n\n    # Check if the calculated exponent is an integer within tolerance.\n    i_int = round(i_float)\n    if abs(i_float - i_int) < TOLERANCE:\n        # We found an integer exponent `i_int` such that (abs(n))**i_int = abs(x).\n        # Now, verify the sign based on the parity of the exponent.\n        if i_int % 2 == 0: # Even exponent, result must be positive\n            return x > TOLERANCE\n        else: # Odd exponent, result must be negative\n            return x < -TOLERANCE\n    else:\n        return False"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Checks if an integer 'a' is the cube of another integer.\n    Handles positive, negative, and zero inputs.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Calculate the cube root of the absolute value, then round to the nearest integer.\n    # Taking abs() first avoids complex numbers when handling negative bases with fractional exponents.\n    root = round(abs(a)**(1/3))\n\n    # If the original number 'a' was negative, the true cube root must also be negative.\n    if a < 0:\n        root = -root\n\n    # Cube the resulting root and compare it to the original number.\n    return root * root * root == a"}
{"task_id": "HumanEval/69", "solution": "import collections\ndef search(lst):\n    \"\"\"\n    Finds the greatest integer x such that x > 0 and its frequency in lst\n    is greater than or equal to x. Returns -1 if no such integer exists.\n    \"\"\"\n    frequency_map = collections.Counter(lst)\n\n    # Collect unique positive integers and sort them in descending order.\n    # This allows returning the greatest qualifying integer x as soon as it's found.\n    unique_positive_integers = sorted([num for num in frequency_map if num > 0], reverse=True)\n\n    for x in unique_positive_integers:\n        frequency = frequency_map[x]\n        if frequency >= x:\n            return x\n\n    return -1"}
{"task_id": "HumanEval/78", "solution": "PRIME_HEX_DIGITS = {'2', '3', '5', '7', 'B', 'D'}\ndef hex_key(num: str) -> int:\n    \"\"\"Counts prime hexadecimal digits in a given string.\n    It iterates through the input and increments a counter for each prime digit found.\"\"\"\n    prime_count = 0\n    for char in num:\n        if char in PRIME_HEX_DIGITS:\n            prime_count += 1\n    return prime_count"}
{"task_id": "HumanEval/76", "solution": "import math\ndef is_simple_power(x, n):\n    \"\"\"Checks if x is n raised to an integer power. Handles various edge cases for x and n.\"\"\"\n\n    # Handle the specific edge case for x = 1 as per design (n^0 = 1).\n    if x == 1:\n        return True\n\n    # Handle n = 1; if x is not 1, it cannot be a simple power of 1.\n    if n == 1:\n        return False\n\n    # Handle n = 0; only x = 0 can be a simple power (0^i = 0 for i > 0).\n    if n == 0:\n        return x == 0\n\n    # Apply the specific design rule for negative n with positive x.\n    if n < 0 and x > 0:\n        return False\n\n    # Prevent math.log from raising ValueError for non-positive x (except x=1, already handled).\n    # Also implicitly covers cases where n is negative and x is non-positive (e.g., -8 = (-2)^3),\n    # which would otherwise lead to a ValueError from math.log, thus returning False to avoid exceptions.\n    if x <= 0:\n        return False\n\n    # At this point, x > 0 and n > 0 (and n != 1). Calculate the potential exponent using logarithms.\n    exponent_float = math.log(x, n)\n\n    # Check if the exponent is an integer within a small tolerance.\n    TOLERANCE = 1e-9\n    exponent_int = round(exponent_float)\n    is_integer = math.isclose(exponent_float, exponent_int, abs_tol=TOLERANCE)\n\n    # If it's an integer, verify n raised to that integer power closely equals x.\n    if is_integer:\n        return math.isclose(n ** exponent_int, x, rel_tol=TOLERANCE)\n    else:\n        return False"}
