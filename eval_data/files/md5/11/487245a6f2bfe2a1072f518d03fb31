{"task_id": "Mbpp/807", "solution": "def first_odd(numbers: list) -> int | None:\n    \"\"\"Validate input and return the first odd integer left-to-right; raise TypeError if numbers is not a list; raise ValueError if any element is not an int; return None if no odd integer is found.\"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for number in numbers:\n        if not isinstance(number, int):\n            raise ValueError(\"All elements in the list must be integers.\")\n        if number % 2 != 0:\n            return number\n    return None"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"Return count of equal numbers among a, b, c.\n    Preconditions: a, b, c are integers.\n    \"\"\"\n    if a == b and b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/809", "solution": "class TupleInput:\n    \"\"\"A value object wrapping a tuple and exposing its length.\"\"\"\n    def __init__(self, elements: tuple):\n        self._elements = elements\n        self._length = len(elements)\n\n    @property\n    def elements(self) -> tuple:\n        return self._elements\n\n    @property\n    def length(self) -> int:\n        return self._length\n\nclass ValidationService:\n    \"\"\"Provides methods for validating input preconditions.\"\"\"\n    def validate_types(self, a: any, b: any) -> bool:\n        return isinstance(a, tuple) and isinstance(b, tuple)\n\n    def validate_length(self, a: TupleInput, b: TupleInput) -> bool:\n        return a.length == b.length\n\nclass ElementComparison:\n    \"\"\"Represents and computes a single element-wise comparison.\"\"\"\n    def __init__(self, index: int, first_value: any, second_value: any):\n        self._index = index\n        self._first_value = first_value\n        self._second_value = second_value\n        self._result = False\n\n    def compare(self) -> bool:\n        self._result = self._second_value < self._first_value\n        return self._result\n\nclass Result:\n    \"\"\"An aggregation wrapper for the final boolean 'allSmaller' result.\"\"\"\n    def __init__(self, value: bool):\n        self._value = value\n\n    @property\n    def value(self) -> bool:\n        return self._value\n\nclass CheckSmallerFunction:\n    \"\"\"Orchestrates validation, comparisons, and result aggregation.\"\"\"\n    def execute(self, first_input: TupleInput, second_input: TupleInput) -> bool:\n        validation_service = ValidationService()\n\n        # Validate types using the raw elements from the TupleInput wrappers\n        if not validation_service.validate_types(first_input.elements, second_input.elements):\n            raise ValueError(\"Inputs must be tuples\")\n\n        # Validate lengths of the wrapped TupleInput objects\n        if not validation_service.validate_length(first_input, second_input):\n            raise ValueError(\"Input tuples must have the same length\")\n\n        all_elements_smaller = True\n        for i in range(first_input.length):\n            first_value = first_input.elements[i]\n            second_value = second_input.elements[i]\n            comparison = ElementComparison(i, first_value, second_value)\n            if not comparison.compare():\n                all_elements_smaller = False\n                break # Short-circuit on the first False comparison\n\n        final_result = Result(all_elements_smaller)\n        return final_result.value\n\ndef check_smaller(first: tuple, second: tuple) -> bool:\n    \"\"\"\n    Checks if each element of the second tuple is smaller than its corresponding element in the first tuple.\n    Raises ValueError if inputs are not tuples or have different lengths.\n    \"\"\"\n    first_tuple_input = TupleInput(first)\n    second_tuple_input = TupleInput(second)\n\n    checker_function = CheckSmallerFunction()\n    return checker_function.execute(first_tuple_input, second_tuple_input)"}
