{"task_id": "Mbpp/793", "solution": "def last(array: list, target: any) -> int:\n    \"\"\"Finds the last position of an element in a sorted array using binary search.\n    Returns -1 if the target is not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            result = mid\n            low = mid + 1  # Try to find further occurrences in the right half\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/794", "solution": "class InputString:\n    \"\"\"Wraps a raw input string and provides length accessor.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\nclass Pattern:\n    \"\"\"Represents matching pattern parameters for start and end characters.\"\"\"\n    def __init__(self, start_char: str, end_char: str, wildcard_between_description: str) -> None:\n        self.start_char = start_char\n        self.end_char = end_char\n        self.wildcard_between_description = wildcard_between_description\n\nclass MatchResult:\n    \"\"\"Data carrier for a match outcome, including a boolean and optional reason.\"\"\"\n    def __init__(self, matched: bool, reason: str = \"\") -> None:\n        self.matched = matched\n        self.reason = reason\n\nclass TextMatcher:\n    \"\"\"Evaluates an InputString against a configured Pattern.\"\"\"\n    def __init__(self, name: str, pattern: Pattern) -> None:\n        self.name = name\n        self.pattern = pattern\n\n    def match(self, input_string: InputString) -> bool:\n        \"\"\"Checks if the input string starts with the pattern's start_char and ends with its end_char.\"\"\"\n        if input_string.length() < 2:\n            return False\n\n        starts_with_expected = input_string.value[0] == self.pattern.start_char\n        ends_with_expected = input_string.value[-1] == self.pattern.end_char\n\n        return starts_with_expected and ends_with_expected\n\ndef text_starta_endb(text: str) -> bool:\n    \"\"\"Matches a string that has an 'a' followed by anything, ending in 'b'.\"\"\"\n    pattern_to_match = Pattern(start_char='a', end_char='b', wildcard_between_description='any sequence including empty')\n    matcher = TextMatcher(name='StartAEndBMatcher', pattern=pattern_to_match)\n    input_str_obj = InputString(value=text)\n    return matcher.match(input_str_obj)"}
{"task_id": "Mbpp/796", "solution": "from typing import Mapping, Any\nimport numbers\n\ndef return_sum(dictionary: Mapping[str, numbers.Number]) -> numbers.Number:\n    \"\"\"Compute the sum of numeric values in the provided mapping.\n\n    Raises TypeError if input is not a mapping or any value is not numeric.\n    \"\"\"\n    if not isinstance(dictionary, Mapping):\n        raise TypeError(\"Input must be a mapping\")\n\n    total: numbers.Number = 0\n    for value in dictionary.values():\n        if not isinstance(value, numbers.Number):\n            raise TypeError(\"All mapping values must be numeric\")\n        total += value\n    return total"}
{"task_id": "Mbpp/792", "solution": "def count_list(collection):\n    \"\"\"Return the number of elements in 'collection' whose Python type is list.\n\n    Args:\n        collection: an iterable/sequence containing elements to inspect.\n\n    Returns:\n        int: count of elements where type(element) == list.\n    \"\"\"\n    count = 0\n    for element in collection:\n        if type(element) == list:\n            count += 1\n    return count"}
{"task_id": "Mbpp/798", "solution": "def _sum(array):\n    \"\"\"\n    Calculates the sum of numeric elements in a list, with type validation.\n    Raises TypeError for invalid input types or non-numeric elements.\n    \"\"\"\n    if not isinstance(array, list):\n        raise TypeError(\"_sum requires a list as input\")\n\n    if not array:\n        return 0\n\n    total_sum = 0\n\n    for element in array:\n        if not isinstance(element, (int, float)):\n            raise TypeError(\"_sum requires all elements to be int or float\")\n        total_sum += element\n\n    return total_sum"}
{"task_id": "Mbpp/797", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass Range:\n    \"\"\"Holds inclusive bounds l and r.\"\"\"\n    l: int\n    r: int\n\n@dataclass\nclass OddNumber:\n    \"\"\"Wraps an integer value and provides checks for odd and natural status.\"\"\"\n    value: int\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the wrapped value is odd.\"\"\"\n        return (self.value % 2) == 1\n\n    def is_natural(self) -> bool:\n        \"\"\"Checks if the wrapped value is a natural number (positive integer >= 1).\"\"\"\n        return self.value >= 1\n\n@dataclass\nclass SumResult:\n    \"\"\"Holds an integer sum result.\"\"\"\n    value: int\n\ndef _validate_integers(l, r) -> None:\n    \"\"\"Ensures both inputs are integers, raising TypeError if not.\"\"\"\n    if not isinstance(l, int) or not isinstance(r, int):\n        raise TypeError(\"Inputs l and r must be integers.\")\n\ndef sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Finds the sum of all odd natural numbers within the inclusive range [l, r].\n    Odd natural numbers are positive odd integers (1, 3, 5, ...).\n    \"\"\"\n    _validate_integers(l, r)\n\n    if l > r:\n        return 0\n\n    current_sum = 0\n    for num in range(l, r + 1):\n        odd_num_obj = OddNumber(num)\n        if odd_num_obj.is_natural() and odd_num_obj.is_odd():\n            current_sum += num\n\n    return current_sum"}
