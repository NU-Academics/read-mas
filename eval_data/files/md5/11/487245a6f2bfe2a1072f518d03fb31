{"task_id": "Mbpp/566", "solution": "def sum_digits(n: int) -> int:\n    \"\"\"Compute and return the sum of base-10 digits of n.\n\n    Raises:\n      TypeError: if n is not an int.\n      ValueError: if n is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    if n == 0:\n        return 0\n\n    digit_sum = 0\n    while n > 0:\n        digit_sum += n % 10\n        n //= 10\n    return digit_sum"}
{"task_id": "Mbpp/568", "solution": "def empty_list(N):\n    \"\"\"\n    Create and return a list of N distinct empty dictionaries.\n    Raises TypeError if N is not an int, and ValueError if N < 0.\n    \"\"\"\n    if not isinstance(N, int):\n        raise TypeError(\"N must be an int\")\n    if N < 0:\n        raise ValueError(\"N must be >= 0\")\n    return [dict() for _ in range(N)]"}
{"task_id": "Mbpp/567", "solution": "class Element:\n    def __init__(self, value: object) -> None:\n        self.value = value\n    def compareTo(self, other: 'Element') -> int:\n        # Compares values; will raise TypeError if non-comparable.\n        if self.value < other.value:\n            return -1\n        elif self.value == other.value:\n            return 0\n        else:\n            return 1\n\nclass List:\n    def __init__(self, elements: list) -> None:\n        # Wraps each value in an Element, or uses existing Element instances.\n        self.elements = [Element(val) if not isinstance(val, Element) else val for val in elements]\n    def length(self) -> int:\n        return len(self.elements)\n    def get(self, index: int) -> 'Element':\n        return self.elements[index]\n\nclass SortResult:\n    def __init__(self, is_sorted: bool) -> None:\n        self.is_sorted = is_sorted\n\nclass SortChecker:\n    def issort_list(self, lst: 'List') -> bool:\n        \"\"\"Checks if a domain.List is sorted in non-decreasing order.\"\"\"\n        if lst.length() <= 1:\n            return True\n        \n        for i in range(lst.length() - 1):\n            if lst.get(i).compareTo(lst.get(i+1)) > 0:\n                return False\n        return True\n\ndef issort_list(seq_or_list: object) -> bool:\n    \"\"\"\n    Checks if a sequence is sorted in non-decreasing order using domain objects.\n    Propagates TypeError if elements are not comparable.\n    \"\"\"\n    if isinstance(seq_or_list, List):\n        domain_list = seq_or_list\n    else:\n        # Convert native sequences (list/tuple) to a domain.List.\n        domain_list = List(list(seq_or_list))\n\n    checker = SortChecker()\n    return checker.issort_list(domain_list)"}
{"task_id": "Mbpp/569", "solution": "def sort_sublists(list_of_lists):\n    \"\"\"Return a new list where each sublist (list of str) is sorted ascending using Python's default string ordering.\"\"\"\n    return [sorted(sublist) for sublist in list_of_lists]"}
{"task_id": "Mbpp/572", "solution": "def two_unique_nums(numbers: list) -> list:\n    # Helper class for counting element occurrences within a list.\n    class FrequencyCounter:\n        def __init__(self) -> None:\n            self.counts: dict = {}\n\n        def count_occurrences(self, numbers: list) -> dict:\n            # Iterates through the list to build a frequency map of its elements.\n            for x in numbers:\n                self.counts[x] = self.counts.get(x, 0) + 1\n            return self.counts\n\n    # Compute the frequency of each number in the input list.\n    fc = FrequencyCounter()\n    counts = fc.count_occurrences(numbers)\n\n    # Build the result list, including only numbers that appeared exactly once,\n    # while preserving their original relative order.\n    result = []\n    for x in numbers:\n        if counts.get(x, 0) == 1:\n            result.append(x)\n            \n    return result"}
{"task_id": "Mbpp/573", "solution": "def unique_product(numbers):\n    # Helper function to validate all items in the iterable are numeric.\n    def _validate_numbers(numbers_list):\n        for item in numbers_list:\n            if not isinstance(item, (int, float)):\n                raise TypeError(\"All elements in the list must be numeric (int or float).\")\n\n    # Helper function to convert an iterable to a set of unique values.\n    def _to_unique_set(numbers_list):\n        return set(numbers_list)\n\n    # Helper function to check if all original input elements are integers.\n    def _all_inputs_int(numbers_list):\n        return all(isinstance(item, int) for item in numbers_list)\n\n    _validate_numbers(numbers)\n\n    all_inputs_were_int = _all_inputs_int(numbers)\n    unique_values = _to_unique_set(numbers)\n\n    if not unique_values:\n        return 1\n\n    if 0 in unique_values:\n        # If any unique number is 0, the product is 0.\n        return 0 if all_inputs_were_int else 0.0\n\n    product = 1\n    for num in unique_values:\n        product *= num\n\n    # Ensure integer return if all original inputs were ints, otherwise return as determined by Python numeric rules.\n    if all_inputs_were_int:\n        return int(product)\n    else:\n        return product"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(haystack, needle):\n    \"\"\"Return True if needle is a contiguous sublist of haystack.\n\n    Raises TypeError if haystack or needle are not lists.\n    \"\"\"\n    if not isinstance(haystack, list) or not isinstance(needle, list):\n        raise TypeError(\"haystack and needle must be lists\")\n\n    len_haystack = len(haystack)\n    len_needle = len(needle)\n\n    if len_needle > len_haystack:\n        return False\n\n    for i in range(len_haystack - len_needle + 1):\n        if haystack[i : i + len_needle] == needle:\n            return True\n\n    return False"}
{"task_id": "Mbpp/577", "solution": "class Result:\n    \"\"\"Encapsulates the numeric result value and provides accessor.\"\"\"\n    def __init__(self, value: int):\n        if not (0 <= value <= 9):\n            raise ValueError(\"Result value must be between 0 and 9.\")\n        self._value = value\n\n    def get_value(self) -> int:\n        \"\"\"Returns the stored integer value.\"\"\"\n        return self._value\n\nclass Calculator:\n    \"\"\"Computes factorial for small n and extracts last digit.\"\"\"\n    def compute_factorial(self, n: int) -> int:\n        \"\"\"Computes n! for n in 1..4.\"\"\"\n        factorial_result = 1\n        for i in range(1, n + 1):\n            factorial_result *= i\n        return factorial_result\n\n    def extract_last_digit(self, factorial_value: int) -> int:\n        \"\"\"Returns the last decimal digit of factorial_value.\"\"\"\n        return factorial_value % 10\n\nclass InputValidator:\n    \"\"\"Checks that input is a non-negative integer.\"\"\"\n    def is_non_negative_integer(self, n) -> bool:\n        \"\"\"Returns True if n is a non-negative integer, False otherwise.\"\"\"\n        return isinstance(n, int) and n >= 0\n\nclass FactorialService:\n    \"\"\"Orchestrates validation, decision rules, calculation and result creation.\"\"\"\n    def __init__(self):\n        self.validator = InputValidator()\n        self.calculator = Calculator()\n\n    def last_Digit_Factorial(self, n: int) -> int:\n        \"\"\"Orchestrates finding the last digit of n! based on business rules.\"\"\"\n        if not self.validator.is_non_negative_integer(n):\n            raise Exception(\"Invalid input: n must be a non-negative integer.\")\n\n        if n == 0:\n            result_obj = Result(1)\n            return result_obj.get_value()\n        elif n >= 5:\n            result_obj = Result(0)\n            return result_obj.get_value()\n        else:  # 1 <= n <= 4\n            factorial_value = self.calculator.compute_factorial(n)\n            digit = self.calculator.extract_last_digit(factorial_value)\n            result_obj = Result(digit)\n            return result_obj.get_value()\n\ndef last_Digit_Factorial(n: int) -> int:\n    \"\"\"Finds the last digit in factorial of a given number.\"\"\"\n    service = FactorialService()\n    return service.last_Digit_Factorial(n)"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1, list2, list3):\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Raises ValueError if the input lists do not have equal length.\n    \"\"\"\n    len1 = len(list1)\n    len2 = len(list2)\n    len3 = len(list3)\n\n    # Simulate Validator.validate_equal_length\n    if not (len1 == len2 and len2 == len3):\n        raise ValueError(\"Input lists must have equal length\")\n\n    n = len1  # All lists have the same length n\n    result = [None] * (3 * n) # Pre-allocate memory for efficiency\n\n    # Simulate Interleaver.interleave\n    for i in range(n):\n        result[i * 3] = list1[i]\n        result[i * 3 + 1] = list2[i]\n        result[i * 3 + 2] = list3[i]\n\n    # Return the result, simulating ResultList.as_list()\n    return result"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Compute symmetric difference with ordering and deduplication as specified in the SRS.\"\"\"\n    membership1 = set(tuple1)\n    membership2 = set(tuple2)\n\n    exclusive1 = membership1 - membership2\n    exclusive2 = membership2 - membership1\n\n    emitted_list = []\n    emitted_set = set()\n\n    for element in tuple1:\n        if element in exclusive1 and element not in emitted_set:\n            emitted_list.append(element)\n            emitted_set.add(element)\n\n    for element in tuple2:\n        if element in exclusive2 and element not in emitted_set:\n            emitted_list.append(element)\n            emitted_set.add(element)\n\n    return tuple(emitted_list)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"Removes odd integers from a nested mixed tuple, preserving structure and order.\n    Raises TypeError if input is not a tuple or contains non-int/non-tuple elements.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    result = []\n    for item in input_tuple:\n        if isinstance(item, int):\n            if item % 2 == 0:\n                result.append(item)\n        elif isinstance(item, tuple):\n            processed_nested_tuple = extract_even(item)\n            result.append(processed_nested_tuple)\n        else:\n            raise TypeError(\"Elements must be integers or tuples.\")\n    return tuple(result)"}
{"task_id": "Mbpp/581", "solution": "def surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the surface area of a square pyramid given its base edge and slant height.\n    Raises TypeError if inputs are not numeric.\n    \"\"\"\n\n    def _validate_inputs(base_edge_val, height_val):\n        \"\"\"Returns True if both base_edge_val and height_val are numeric (int or float).\"\"\"\n        return isinstance(base_edge_val, (int, float)) and isinstance(height_val, (int, float))\n\n    def _compute_surface_area(base_edge_val, height_val):\n        \"\"\"Computes the surface area of a square pyramid using the given formula.\"\"\"\n        return base_edge_val**2 + 2 * base_edge_val * height_val\n\n    if not _validate_inputs(base_edge, height):\n        raise TypeError(\"Inputs 'base_edge' and 'height' must be numeric (int or float).\")\n\n    return _compute_surface_area(base_edge, height)"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(items, n):\n    \"\"\"\n    Finds the n most expensive items in a dataset, excluding invalid entries and preserving tie order.\n    Returns a list of dictionaries, sorted by price descending.\n    \"\"\"\n    if n <= 0:\n        return []\n\n    def _is_number(value):\n        \"\"\"Checks if a value is an int or float, excluding booleans.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    def _validate_items(input_items):\n        \"\"\"Filters input items, keeping only valid dictionaries with 'name' and numeric 'price'.\"\"\"\n        valid_items_list = []\n        if not isinstance(input_items, list):\n            return [] # Design choice: if input is not a list, treat as no valid items\n\n        for item in input_items:\n            if isinstance(item, dict) and 'name' in item and 'price' in item and _is_number(item['price']):\n                valid_items_list.append(item)\n        return valid_items_list\n\n    def _stable_sort_by_price(items_to_sort):\n        \"\"\"Sorts a list of item dictionaries by 'price' in descending order, maintaining stability.\"\"\"\n        return sorted(items_to_sort, key=lambda x: x['price'], reverse=True)\n\n    valid_items = _validate_items(items)\n    sorted_items = _stable_sort_by_price(valid_items)\n\n    return sorted_items[:n]"}
{"task_id": "Mbpp/583", "solution": "class InputValidation:\n    \"\"\"Validates if input n is a non-negative integer.\"\"\"\n    def validate(self, n) -> None:\n        if not isinstance(n, int) or n < 0:\n            raise ValueError(\"n must be a non-negative integer\")\n\nclass ExactIntegerArithmetic:\n    \"\"\"Computes Catalan numbers using integer-only arithmetic.\"\"\"\n    def compute_catalan(self, n: int) -> int:\n        if n == 0:\n            return 1\n        \n        # Compute binomial(2n, n) using iterative multiplicative integer algorithm.\n        # This formula (Product (n+k)/k for k=1 to n) directly calculates C(2n, n).\n        binomial_2n_n = 1\n        for k in range(1, n + 1):\n            binomial_2n_n = binomial_2n_n * (n + k) // k\n\n        # Cn = binomial(2n, n) // (n + 1)\n        catalan = binomial_2n_n // (n + 1)\n        return catalan\n\nclass CatalanFunction:\n    \"\"\"Orchestrates validation and computation for Catalan numbers.\"\"\"\n    def __init__(self):\n        self._validator = InputValidation()\n        self._calculator = ExactIntegerArithmetic()\n\n    def catalan_number(self, n: int) -> int:\n        self._validator.validate(n)\n        return self._calculator.compute_catalan(n)\n\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Catalan number using integer-only arithmetic.\n    Delegates to internal classes for input validation and computation.\n    \"\"\"\n    cf = CatalanFunction()\n    return cf.catalan_number(n)"}
{"task_id": "Mbpp/587", "solution": "def list_tuple(input_list):\n    \"\"\"Converts a list to a tuple, preserving element order.\n\n    Raises TypeError if the input is not a list.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n    return tuple(input_list)"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(list_input, n):\n    \"\"\"Splits a list at the nth element and moves the first part to the end.\n    Handles empty lists, modulo `n` for `n > len` or negative `n`, and returns a shallow copy if effective split point is 0.\n    \"\"\"\n    if not list_input:\n        return []\n\n    length = len(list_input)\n    effective_n = n % length\n\n    if effective_n == 0:\n        return list_input[:]\n\n    first_part = list_input[0:effective_n]\n    second_part = list_input[effective_n:]\n    return second_part + first_part"}
{"task_id": "Mbpp/589", "solution": "from typing import List\nimport math\n\nclass Range:\n    \"\"\"Data holder representing an inclusive integer interval.\"\"\"\n    def __init__(self, start: int, end: int) -> None:\n        self.start = start\n        self.end = end\n\nclass IntegerValue:\n    \"\"\"Primitive wrapper representing a single integer value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass ResultList:\n    \"\"\"Data holder for a list of perfect squares.\"\"\"\n    def __init__(self, squares: List[int]) -> None:\n        self.squares = squares\n\nclass PerfectSquaresFunction:\n    \"\"\"\n    Service class responsible for finding perfect squares within a given range.\n    It computes the list of perfect squares.\n    \"\"\"\n    def find(self, start: int, end: int) -> List[int]:\n        \"\"\"\n        Computes and returns all perfect square integers between start and end inclusive.\n        The returned list is sorted in ascending order.\n        \"\"\"\n        if end < 0 or start > end:\n            return []\n\n        found_squares = []\n\n        # Determine the starting integer for k such that k*k >= start\n        # Handles negative 'start' by effectively considering 0 as the lower bound for squares.\n        start_k = math.ceil(math.sqrt(max(0, start)))\n\n        # Determine the ending integer for k such that k*k <= end\n        end_k = math.floor(math.sqrt(end))\n\n        # Iterate through possible integer roots 'k'\n        for k in range(int(start_k), int(end_k) + 1):\n            square = k * k\n            # Add the square if it falls within the specified inclusive range\n            if start <= square <= end:\n                found_squares.append(square)\n        \n        # Use the ResultList data holder before returning\n        result_list = ResultList(found_squares)\n        return result_list.squares\n\ndef perfect_squares(start: int, end: int) -> List[int]:\n    \"\"\"\n    Finds perfect squares between two given numbers, inclusive.\n    Delegates the computation to PerfectSquaresFunction and returns a sorted list.\n    \"\"\"\n    service = PerfectSquaresFunction()\n    return service.find(start, end)"}
{"task_id": "Mbpp/588", "solution": "def big_diff(values):\n    \"\"\"Calculates the difference between the largest and smallest value in a numeric list or sequence.\n    Raises TypeError for non-list/non-numeric input, and ValueError for empty sequences, with specific messages.\n    \"\"\"\n    if not isinstance(values, (list, tuple, range)):\n        raise TypeError(\"big_diff() expects a list or sequence of numeric values\")\n\n    if not values:\n        raise ValueError(\"big_diff() requires a non-empty list of numeric values\")\n\n    non_numeric_elements = []\n    for x in values:\n        if not isinstance(x, (int, float)):\n            non_numeric_elements.append(x)\n\n    if non_numeric_elements:\n        raise TypeError(f\"big_diff() found non-numeric element(s): {repr(non_numeric_elements)}\")\n\n    return max(values) - min(values)"}
{"task_id": "Mbpp/591", "solution": "def swap_List(lst: list) -> list:\n    \"\"\"Return a list with the first and last elements interchanged.\n\n    For lists with length less than 2, the input list is returned unchanged.\n    \"\"\"\n    if len(lst) < 2:\n        return lst\n    \n    result = lst[:]  # Create a copy to avoid modifying the original list\n    result[0], result[-1] = result[-1], result[0]\n    return result"}
{"task_id": "Mbpp/592", "solution": "def sum_Of_product(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the product of consecutive binomial coefficients C(n,k) * C(n,k+1).\n    Raises ValueError if n is not an integer or is negative.\n    \"\"\"\n\n    def _validate_input(val):\n        \"\"\"Validates that n is a non-negative integer.\"\"\"\n        if not isinstance(val, int) or val < 0:\n            raise ValueError(\"n must be an integer >= 0\")\n\n    def _compute_binomials(val: int) -> list[int]:\n        \"\"\"Generates all binomial coefficients C(val, k) for k=0 to val using a recurrence relation.\"\"\"\n        if val == 0:\n            return [1]\n        \n        coefficients = [1]  # C(val, 0)\n        current_coeff = 1\n        for k in range(val):\n            # C(n, k+1) = C(n, k) * (n - k) // (k + 1)\n            next_coeff = current_coeff * (val - k) // (k + 1)\n            coefficients.append(next_coeff)\n            current_coeff = next_coeff\n        return coefficients\n\n    def _compute_sum_of_products(coeffs: list[int]) -> int:\n        \"\"\"Computes the sum of products of consecutive elements in a list of coefficients.\"\"\"\n        total_sum = 0\n        for k in range(len(coeffs) - 1):\n            total_sum += coeffs[k] * coeffs[k+1]\n        return total_sum\n\n    _validate_input(n)\n    \n    binomial_coefficients = _compute_binomials(n)\n    result = _compute_sum_of_products(binomial_coefficients)\n    \n    return result"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(values: list[int]) -> int:\n    \"\"\"\n    Finds the difference of the first even and first odd number of a given list.\n    Computes first_even - first_odd.\n    \"\"\"\n    def is_odd(value: int) -> bool:\n        \"\"\"Checks if a number is odd.\"\"\"\n        return value % 2 != 0\n\n    def is_even(value: int) -> bool:\n        \"\"\"Checks if a number is even.\"\"\"\n        return value % 2 == 0\n\n    def scan_for_first_odd(values: list[int]) -> int:\n        \"\"\"Scans the list from left-to-right to find the first odd number.\"\"\"\n        for value in values:\n            if is_odd(value):\n                return value\n        # Error-handling for missing odd element is intentionally unspecified.\n        # Based on example, assume an odd number will always be found.\n\n    def scan_for_first_even(values: list[int]) -> int:\n        \"\"\"Scans the list from left-to-right to find the first even number.\"\"\"\n        for value in values:\n            if is_even(value):\n                return value\n        # Error-handling for missing even element is intentionally unspecified.\n        # Based on example, assume an even number will always be found.\n\n    first_even = scan_for_first_even(values)\n    first_odd = scan_for_first_odd(values)\n    return first_even - first_odd"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(raw: str) -> str:\n    \"\"\"\n    Removes leading zeros from each octet of an IPv4 address string,\n    representing all-zero octets as \"0\".\n    \"\"\"\n    def _normalize_octet(octet: str) -> str:\n        \"\"\"Converts an octet string to an integer and back to a string, removing leading zeros.\"\"\"\n        return str(int(octet))\n\n    octets = raw.split('.')\n    normalized_octets = [_normalize_octet(octet) for octet in octets]\n    return '.'.join(normalized_octets)"}
{"task_id": "Mbpp/596", "solution": "import sys\n\ndef tuple_size(t: tuple) -> int:\n    \"\"\"Return size in bytes of the provided tuple as sys.getsizeof(t).\n\n    Raises TypeError if t is not a tuple.\n    \"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(\"tuple_size expects a tuple\")\n    return sys.getsizeof(t)"}
{"task_id": "Mbpp/590", "solution": "import math\n\ndef polar_rect(arg1: float, arg2: float) -> tuple[tuple[float, float], complex]:\n    \"\"\"\n    Converts rectangular coordinates (arg1, arg2) to polar, and also\n    provides a complex number from a fixed polar-to-rectangular conversion.\n    \"\"\"\n    # Calculate the polar representation (r, theta) from input (arg1, arg2) treated as (x, y)\n    r_from_rect = math.sqrt(arg1**2 + arg2**2)\n    theta_from_rect = math.atan2(arg2, arg1)\n    polar_output = (r_from_rect, theta_from_rect)\n\n    # Calculate x, y from fixed polar coordinates (2, pi) and convert to complex\n    r_fixed = 2.0\n    theta_fixed = math.pi\n    x_from_polar = r_fixed * math.cos(theta_fixed)\n    y_from_polar = r_fixed * math.sin(theta_fixed)\n    complex_output = complex(x_from_polar, y_from_polar)\n\n    return (polar_output, complex_output)"}
{"task_id": "Mbpp/598", "solution": "from typing import List\n\nclass InputNumber:\n    \"\"\"Domain model for input integer handling: stores value, computes digit count, and extracts digits.\"\"\"\n    def __init__(self, value: int) -> None:\n        \"\"\"Store value; digit_count and digits are computed upon initialization.\"\"\"\n        self._value = value\n        abs_value_str = str(abs(value))\n        self._digit_count = len(abs_value_str)\n        self._digits = [int(d) for d in abs_value_str]\n\n    def count_digits(self) -> int:\n        \"\"\"Return the number of digits in the absolute value of the stored integer.\"\"\"\n        return self._digit_count\n\n    def get_digits(self) -> List[int]:\n        \"\"\"Return a list of digits (most-significant-first) from the absolute value.\"\"\"\n        return self._digits\n\nclass EvaluationResult:\n    \"\"\"Encapsulates the computed sum and boolean evaluation; exposes to_bool().\"\"\"\n    def __init__(self, sum_val: int, is_armstrong: bool) -> None:\n        \"\"\"Construct the evaluation result.\"\"\"\n        self._sum = sum_val\n        self._is_armstrong = is_armstrong\n\n    def to_bool(self) -> bool:\n        \"\"\"Return the boolean outcome of the Armstrong number evaluation.\"\"\"\n        return self._is_armstrong\n\nclass ArmstrongEvaluator:\n    \"\"\"Implements Armstrong evaluation logic, uses InputNumber, produces EvaluationResult.\"\"\"\n    def armstrong_number(self, n: int) -> bool:\n        \"\"\"Compute whether n is an an Armstrong number and return boolean.\"\"\"\n        input_num = InputNumber(n)\n        digit_count = input_num.count_digits()\n        digits = input_num.get_digits()\n\n        powered_digit_sum = self.compute_digit_power_sum(digits, digit_count)\n\n        is_armstrong_number = (powered_digit_sum == n)\n\n        result = EvaluationResult(powered_digit_sum, is_armstrong_number)\n        return result.to_bool()\n\n    def compute_digit_power_sum(self, digits: List[int], power: int) -> int:\n        \"\"\"Compute the sum of each digit raised to the given power.\"\"\"\n        return sum(d ** power for d in digits)\n\ndef armstrong_number(n: int) -> bool:\n    \"\"\"Public API: checks whether the given number is an Armstrong number.\"\"\"\n    evaluator = ArmstrongEvaluator()\n    return evaluator.armstrong_number(n)"}
{"task_id": "Mbpp/597", "solution": "from typing import List, Any\n\n# --- src/domain.py (defined inline as helpers) ---\nclass Array:\n    \"\"\"Represents a sorted array of elements.\"\"\"\n    def __init__(self, elements: List[Any]):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self.elements)\n\nclass FindKthRequest:\n    \"\"\"Encapsulates input for finding the k-th element and provides validation.\"\"\"\n    def __init__(self, array1: Array, array2: Array, k: int):\n        self.array1 = array1\n        self.array2 = array2\n        self.k = k\n\n    def validate(self) -> None:\n        \"\"\"Validates k is within bounds of the combined array length.\"\"\"\n        total_length = self.array1.length() + self.array2.length()\n        if not (1 <= self.k <= total_length):\n            raise ValueError(f\"k ({self.k}) is out of bounds for total length {total_length}.\")\n\nclass FindKthResponse:\n    \"\"\"Encapsulates the result of finding the k-th element.\"\"\"\n    def __init__(self, value: Any):\n        self.value = value\n\n# --- src/find_kth.py (FindKthService defined inline as a helper) ---\nclass FindKthService:\n    \"\"\"Provides the core logic for finding the k-th element.\"\"\"\n    def find_kth(self, req: FindKthRequest) -> FindKthResponse:\n        \"\"\"Finds the k-th element from two sorted arrays based on the request.\"\"\"\n        req.validate() # Re-validate request inputs before processing\n        result = self._select_kth_without_merging(req.array1.elements, req.array2.elements, req.k)\n        return FindKthResponse(result)\n\n    def _select_kth_without_merging(self, a: List[Any], b: List[Any], k: int) -> Any:\n        \"\"\"Recursively finds the k-th element without explicit merging, using a binary-search-like approach.\"\"\"\n        m, n = len(a), len(b)\n\n        # Ensure array 'a' is always the shorter or equal length for efficiency\n        if m > n:\n            return self._select_kth_without_merging(b, a, k)\n\n        # Base cases:\n        # If 'a' is empty, the k-th element must be in 'b'.\n        if m == 0:\n            return b[k - 1]\n        # If k is 1, return the minimum of the first elements of 'a' and 'b'.\n        if k == 1:\n            return min(a[0], b[0])\n\n        # Divide k into two parts: pa elements from 'a', pb elements from 'b'\n        # Try to take k/2 elements from 'a' if possible\n        pa = min(k // 2, m)\n        pb = k - pa\n\n        # Compare elements at the partition points\n        if a[pa - 1] < b[pb - 1]:\n            # The k-th element is in the remaining parts of 'a' (from index pa) or 'b'.\n            # Discard a[0...pa-1] and search for the (k-pa)-th element.\n            return self._select_kth_without_merging(a[pa:], b, k - pa)\n        elif a[pa - 1] > b[pb - 1]:\n            # The k-th element is in 'a' or the remaining parts of 'b' (from index pb).\n            # Discard b[0...pb-1] and search for the (k-pb)-th element.\n            return self._select_kth_without_merging(a, b[pb:], k - pb)\n        else:\n            # If elements are equal, we found the k-th element.\n            return a[pa - 1]\n\n\ndef find_kth(array1: list, array2: list, k: int) -> Any:\n    \"\"\"\n    Finds the k-th element from two sorted arrays.\n\n    This function acts as the public API entry point, encapsulating domain\n    objects and service logic.\n    \"\"\"\n    arr1_obj = Array(array1)\n    arr2_obj = Array(array2)\n\n    request = FindKthRequest(arr1_obj, arr2_obj, k)\n    request.validate()\n\n    service = FindKthService()\n    response = service.find_kth(request)\n\n    return response.value"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n: int) -> (int, float):\n    \"\"\"\n    Calculates the sum and average of the first n natural numbers.\n    Raises ValueError for invalid input n (must be an integer >= 1).\n    \"\"\"\n\n    class NaturalNumberInput:\n        \"\"\"Encapsulates and validates the input n.\"\"\"\n        def __init__(self, value: int):\n            self.value = value\n\n        def isValid(self) -> bool:\n            \"\"\"Checks if the input value is an integer and greater than or equal to 1.\"\"\"\n            return isinstance(self.value, int) and self.value >= 1\n\n    class SumAverageFunction:\n        \"\"\"Performs the calculations for sum and average.\"\"\"\n        def computeSum(self, n: int) -> int:\n            \"\"\"Computes the sum of the first n natural numbers.\"\"\"\n            return n * (n + 1) // 2\n\n        def computeAverage(self, sum_val: int, n: int) -> float:\n            \"\"\"Computes the average of the given sum and n.\"\"\"\n            return sum_val / n\n\n        def execute(self, n: int) -> (int, float):\n            \"\"\"Orchestrates the sum and average calculation for n.\"\"\"\n            sum_result = self.computeSum(n)\n            average_result = self.computeAverage(sum_result, n)\n            return sum_result, average_result\n\n    class CalculationResult:\n        \"\"\"Holds the calculated sum and average.\"\"\"\n        def __init__(self, sum_val: int, average_val: float):\n            self.sum = sum_val\n            self.average = average_val\n\n        def to_tuple(self) -> (int, float):\n            \"\"\"Returns the stored sum and average as a tuple.\"\"\"\n            return self.sum, self.average\n\n    # Main logic\n    input_obj = NaturalNumberInput(n)\n    if not input_obj.isValid():\n        raise ValueError(\"n must be an integer >= 1\")\n\n    calculator = SumAverageFunction()\n    sum_value, avg_value = calculator.execute(n)\n\n    result = CalculationResult(sum_value, avg_value)\n    return result.to_tuple()"}
{"task_id": "Mbpp/600", "solution": "def is_Even(number):\n    \"\"\"\n    Determine parity for integer inputs.\n\n    Raises TypeError for non-int numeric inputs, as per design decision.\n    \"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"Input must be an integer.\")\n    return number % 2 == 0"}
{"task_id": "Mbpp/602", "solution": "class CharacterCounter:\n    \"\"\"Provides functionality to count characters and find the first repeated character.\"\"\"\n    def __init__(self) -> None:\n        self._counts: dict = {}\n\n    def count_chars(self, s: str) -> dict:\n        \"\"\"Count occurrences of each character in s and return mapping char->count.\"\"\"\n        char_counts = {}\n        for char in s:\n            char_counts[char] = char_counts.get(char, 0) + 1\n        return char_counts\n\n    def first_repeated(self, counts: dict, s: str) -> str:\n        \"\"\"Scan s in order and return first char with counts[char] > 1.\"\"\"\n        for char in s:\n            if counts.get(char, 0) > 1:\n                return char\n        return \"\" # Return empty string if no character repeats\n\ndef first_repeated_char(input: str) -> str:\n    \"\"\"Public API: returns first repeated character as a single-character string.\"\"\"\n    counter = CharacterCounter()\n    counts = counter.count_chars(input)\n    return counter.first_repeated(counts, input)"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(n: int) -> list[int]:\n    \"\"\"Return all ludic numbers <= n, sorted ascending, unique. If n < 1 return [].\"\"\"\n    if n < 1:\n        return []\n\n    numbers = list(range(1, n + 1))\n    ludic_numbers = []\n\n    current_idx = 0\n    while current_idx < len(numbers):\n        ludic = numbers[current_idx]\n        ludic_numbers.append(ludic)\n\n        if ludic == 1:\n            current_idx += 1\n            continue\n\n        new_numbers = []\n        skip_relative_pos = 0 \n        \n        for i in range(current_idx + 1, len(numbers)):\n            if (skip_relative_pos + 1) % ludic != 0:\n                new_numbers.append(numbers[i])\n            skip_relative_pos += 1 \n\n        numbers = new_numbers\n        current_idx = 0\n    \n    return ludic_numbers"}
{"task_id": "Mbpp/604", "solution": "def reverse_words(input: str) -> str:\n    \"\"\"Reverses the order of words in a string, separated by spaces.\"\"\"\n    from typing import List\n\n    class InputString:\n        def __init__(self, value: str):\n            self.value = value\n\n        def length(self) -> int:\n            return len(self.value)\n\n    class Word:\n        def __init__(self, text: str, position: int):\n            self.text = text\n            self.position = position\n\n    class OutputString:\n        def __init__(self, value: str):\n            self.value = value\n\n    class Tokenizer:\n        def tokenize(self, input_string_obj: InputString) -> List[Word]:\n            words = []\n            tokens = input_string_obj.value.split(' ')\n            for i, text in enumerate(tokens):\n                words.append(Word(text, i))\n            return words\n\n    class Reverser:\n        def reverseOrder(self, words: List[Word]) -> List[Word]:\n            return words[::-1]\n\n    class Joiner:\n        def join(self, words: List[Word]) -> OutputString:\n            if not words:\n                return OutputString(\"\")\n            joined_text = \" \".join([word.text for word in words])\n            return OutputString(joined_text)\n\n    class ReverseWordsFunction:\n        def __init__(self, tokenizer: Tokenizer, reverser: Reverser, joiner: Joiner):\n            self.tokenizer = tokenizer\n            self.reverser = reverser\n            self.joiner = joiner\n\n        def reverse(self, input_string_obj: InputString) -> OutputString:\n            words = self.tokenizer.tokenize(input_string_obj)\n            reversed_words = self.reverser.reverseOrder(words)\n            output_string_obj = self.joiner.join(reversed_words)\n            return output_string_obj\n\n    input_obj = InputString(input)\n    tokenizer_obj = Tokenizer()\n    reverser_obj = Reverser()\n    joiner_obj = Joiner()\n    orchestrator = ReverseWordsFunction(tokenizer_obj, reverser_obj, joiner_obj)\n    output_obj = orchestrator.reverse(input_obj)\n    return output_obj.value"}
{"task_id": "Mbpp/605", "solution": "from dataclasses import dataclass\nimport math\n\n@dataclass\nclass IntegerInput:\n    value: int\n\n@dataclass\nclass PrimeCheckResult:\n    is_prime: bool\n    reason: str = \"\"\n\nclass PrimeChecker:\n    def prime_num(self, n: int) -> bool:\n        \"\"\"Return True if n is prime, False otherwise. Implements BR-4.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        \n        # Test divisibility by integers from 2 up to floor(sqrt(n)).\n        limit = math.isqrt(n)\n        for d in range(2, limit + 1):\n            if self._is_divisible(d, n):\n                return False\n        return True\n\n    def _is_divisible(self, divisor: int, n: int) -> bool:\n        \"\"\"Return True if divisor divides n evenly.\"\"\"\n        return n % divisor == 0\n\ndef prime_num(n: int) -> bool:\n    \"\"\"Module-level API function: delegates to PrimeChecker.prime_num.\"\"\"\n    checker = PrimeChecker()\n    return checker.prime_num(n)"}
