{"task_id": "Mbpp/638", "solution": "import math\n\ndef wind_chill(velocity_kmh, temperature_celsius):\n    \"\"\"\n    Calculates the wind chill index rounded to the nearest integer.\n    The calculation uses the specified formula and rounds the result to the nearest integer following standard arithmetic rules (half away from zero).\n    \"\"\"\n    v = velocity_kmh\n    T = temperature_celsius\n\n    # Apply the wind chill formula:\n    # T_wc = 13.12 + 0.6215 * T - 11.37 * v**0.16 + 0.3965 * T * v**0.16\n    v_power_0_16 = math.pow(v, 0.16)\n\n    wind_chill_raw = (\n        13.12\n        + 0.6215 * T\n        - 11.37 * v_power_0_16\n        + 0.3965 * T * v_power_0_16\n    )\n\n    # Round to the nearest integer using \"round half away from zero\" logic.\n    # This addresses the design's note about Python's built-in round() behavior for .5 values.\n    if wind_chill_raw >= 0:\n        rounded_wind_chill = math.floor(wind_chill_raw + 0.5)\n    else:\n        rounded_wind_chill = math.ceil(wind_chill_raw - 0.5)\n\n    return int(rounded_wind_chill)"}
{"task_id": "Mbpp/720", "solution": "class Validator:\n    \"\"\"Stateless helper for validating function preconditions.\"\"\"\n    def is_tuple(self, obj) -> bool:\n        return isinstance(obj, tuple)\n    def is_dict(self, obj) -> bool:\n        return isinstance(obj, dict)\n\ndef add_dict_to_tuple(tuple_input, dict_input) -> tuple:\n    \"\"\"Validate inputs and return a new tuple equal to tuple_input + (dict_input,).\n\n    Raises:\n        TypeError: if tuple_input is not a tuple or dict_input is not a dict.\n    \"\"\"\n    validator = Validator()\n    if not validator.is_tuple(tuple_input):\n        raise TypeError(\"add_dict_to_tuple: first argument must be a tuple\")\n    if not validator.is_dict(dict_input):\n        raise TypeError(\"add_dict_to_tuple: second argument must be a dict\")\n    return tuple_input + (dict_input,)"}
{"task_id": "Mbpp/721", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for input validation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass Cell:\n    \"\"\"Represents a cell in the matrix with its coordinates and cost.\"\"\"\n    def __init__(self, row: int, col: int, cost: float) -> None:\n        self.row = row\n        self.col = col\n        self.cost = cost\n\nclass Path:\n    \"\"\"Represents a path as a sequence of cells.\"\"\"\n    def __init__(self, cells: list[Cell]) -> None:\n        self._cells = cells\n\n    def totalCost(self) -> float:\n        \"\"\"Calculates the total cost of the path.\"\"\"\n        return sum(c.cost for c in self._cells)\n\n    def length(self) -> int:\n        \"\"\"Returns the number of cells in the path.\"\"\"\n        return len(self._cells)\n\n    def average(self) -> float:\n        \"\"\"Calculates the average cost of the path.\"\"\"\n        path_length = self.length()\n        if path_length == 0:\n            return 0.0 # Should not happen for valid paths in this problem\n        return self.totalCost() / path_length\n\nclass Matrix:\n    \"\"\"Represents the square matrix and provides helpers.\"\"\"\n    def __init__(self, cells: list[list[float]]) -> None:\n        self.cells = cells\n        self.N = len(cells) if cells else 0\n\n    def isSquare(self) -> bool:\n        \"\"\"Checks if the matrix is square.\"\"\"\n        if not self.cells:\n            return True # An empty matrix (N=0) is vacuously square for N=0 check, validation handles empty case.\n        \n        N = len(self.cells)\n        for row in self.cells:\n            # Ensure row is a list and its length matches N\n            if not isinstance(row, list) or len(row) != N:\n                return False\n        return True\n\nclass Result:\n    \"\"\"Encapsulates the calculated average for formatting.\"\"\"\n    def __init__(self, average: float) -> None:\n        self._average = average\n\n    def format(self) -> float:\n        \"\"\"Returns the average as a float, ensuring precision if needed.\"\"\"\n        return float(self._average)\n\nclass Validator:\n    \"\"\"Validates the input matrix according to specified rules.\"\"\"\n    def validate(self, matrix: Matrix) -> None:\n        \"\"\"Performs all input validation checks, raising ValidationError on failure.\"\"\"\n        if not matrix.cells:\n            raise ValidationError(\"matrix is empty\")\n\n        if not matrix.isSquare():\n            raise ValidationError(\"matrix is not square\")\n\n        N = matrix.N\n        for r in range(N):\n            for c in range(N):\n                val = matrix.cells[r][c]\n                if not isinstance(val, (int, float)):\n                    raise ValidationError(f\"matrix contains non-numeric element at row={r}, col={c}\")\n\nclass PathCalculator:\n    \"\"\"Calculates the maximum average path cost using dynamic programming.\"\"\"\n    def maxAverageOfPath(self, matrix: Matrix) -> float:\n        N = matrix.N\n\n        # dp[r][c] will store the maximum sum to reach cell (r, c) from (0, 0)\n        dp = [[0.0 for _ in range(N)] for _ in range(N)]\n\n        # Base case: top-left cell\n        dp[0][0] = float(matrix.cells[0][0])\n\n        # Fill first row (only reachable from the left)\n        for c in range(1, N):\n            dp[0][c] = dp[0][c-1] + float(matrix.cells[0][c])\n\n        # Fill first column (only reachable from above)\n        for r in range(1, N):\n            dp[r][0] = dp[r-1][0] + float(matrix.cells[r][0])\n\n        # Fill the rest of the DP table\n        for r in range(1, N):\n            for c in range(1, N):\n                dp[r][c] = max(dp[r-1][c], dp[r][c-1]) + float(matrix.cells[r][c])\n\n        max_total_cost = dp[N-1][N-1]\n        \n        # All valid paths from (0,0) to (N-1, N-1) using only right/down moves\n        # have a fixed length of (N-1) rows + (N-1) columns + 1 (start cell) = 2*N - 1 cells.\n        path_length = (2 * N) - 1\n        \n        return max_total_cost / path_length\n\ndef maxAverageOfPath(matrix: list[list[float]]) -> float:\n    \"\"\"\n    Given a square matrix, finds a path from top-left to bottom-right (right or down moves only)\n    with the maximum average over all existing paths.\n    \"\"\"\n    matrix_obj = Matrix(matrix)\n\n    validator = Validator()\n    validator.validate(matrix_obj)\n\n    calculator = PathCalculator()\n    max_avg_value = calculator.maxAverageOfPath(matrix_obj)\n\n    result = Result(max_avg_value)\n    return result.format()"}
{"task_id": "Mbpp/722", "solution": "def filter_data(students_dict, min_height, min_weight):\n    \"\"\"\n    Filter students by minimum height and weight.\n    Returns a dict of selected students where height >= min_height and weight >= min_weight.\n    \"\"\"\n    filtered_students = {}\n    for name, (height, weight) in students_dict.items():\n        if height >= min_height and weight >= min_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students"}
{"task_id": "Mbpp/723", "solution": "def count_same_pair(list_a, list_b):\n    \"\"\"\n    Counts indices where elements in two lists of the same length are equal.\n    Raises ValueError if the input lists do not have the same length.\n    \"\"\"\n    if len(list_a) != len(list_b):\n        raise ValueError(\"Input lists must have the same length\")\n\n    count = 0\n    for i in range(len(list_a)):\n        if list_a[i] == list_b[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    It uses Python's arbitrary-precision integers and sums the absolute value's digits.\n    \"\"\"\n    # Computes base^power, corresponding to BigIntegerResult.computePower\n    big_int_value = base ** power\n\n    # Converts the big integer to its decimal string representation,\n    # using absolute value as per DecimalRepresentation.toString design.\n    digits_string = str(abs(big_int_value))\n\n    # Sums the numeric value of each digit character, corresponding to DigitSum.sumDigits.\n    total_digit_sum = sum(int(digit) for digit in digits_string)\n\n    return total_digit_sum"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple):\n    \"\"\"\n    Takes a tuple of numbers (t_1,...,t_{N+1}) and returns a tuple of length N\n    where the i-th element of the tuple is equal to t_i * t_{i+1}.\n    \"\"\"\n    def _validate_input(input_tuple):\n        \"\"\"Validates the input tuple for type, length, and element types.\"\"\"\n        if not isinstance(input_tuple, tuple):\n            raise ValueError(\"input must be a tuple\")\n        if len(input_tuple) < 2:\n            raise ValueError(\"input tuple must have at least two elements\")\n        for idx, el in enumerate(input_tuple):\n            if not isinstance(el, (int, float, complex)):\n                raise TypeError(f\"element at index {idx} is not numeric\")\n\n    def _compute_pairwise_products(input_tuple):\n        \"\"\"Computes pairwise products of adjacent elements in the input tuple.\"\"\"\n        products = tuple(input_tuple[i] * input_tuple[i+1] for i in range(len(input_tuple)-1))\n        return products\n\n    _validate_input(input_tuple)\n    return _compute_pairwise_products(input_tuple)"}
{"task_id": "Mbpp/725", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass InputString:\n    content: str\n    length: int\n\n@dataclass\nclass QuotedSubstring:\n    value: str\n    start_index: int\n    end_index: int\n    order: int\n\n@dataclass\nclass ResultList:\n    items: List[str]\n    def count(self) -> int:\n        return len(self.items)\n\ndef _validate_input(input) -> InputString:\n    \"\"\"Validates the input type and wraps it in an InputString dataclass.\"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"input must be a string\")\n    return InputString(content=input, length=len(input))\n\ndef _parse_quoted_substrings(content: str) -> List[QuotedSubstring]:\n    \"\"\"Scans the string for double-quoted substrings, handling escapes.\"\"\"\n    results: List[QuotedSubstring] = []\n    in_quote = False\n    current_substring_buffer: List[str] = []\n    current_content_start_idx = -1\n    order = 0\n    i = 0\n    while i < len(content):\n        char = content[i]\n\n        if char == '\"':\n            if not in_quote:\n                # Found an opening quote\n                in_quote = True\n                current_content_start_idx = i + 1\n                current_substring_buffer = []\n            else:\n                # Found a closing quote\n                in_quote = False\n                value = \"\".join(current_substring_buffer)\n                current_content_end_idx = i\n                results.append(QuotedSubstring(\n                    value=value,\n                    start_index=current_content_start_idx,\n                    end_index=current_content_end_idx,\n                    order=order\n                ))\n                order += 1\n        elif in_quote:\n            # Inside a quote, handle content and backslash escapes\n            if char == '\\\\' and i + 1 < len(content) and content[i+1] == '\"':\n                current_substring_buffer.append('\"')\n                i += 1  # Consume the next char (escaped quote)\n            else:\n                current_substring_buffer.append(char)\n        i += 1\n    return results\n\ndef _build_result_list(substrings: List[QuotedSubstring]) -> ResultList:\n    \"\"\"Extracts values from QuotedSubstring objects and forms a ResultList.\"\"\"\n    items = [s.value for s in substrings]\n    return ResultList(items=items)\n\ndef extract_quotation(input) -> List[str]:\n    \"\"\"\n    Extracts values between quotation marks \" \" from the given string.\n    Supports backslash-escaped double quotes inside quoted content.\n    \"\"\"\n    validated_input = _validate_input(input)\n    parsed_substrings = _parse_quoted_substrings(validated_input.content)\n    result_list = _build_result_list(parsed_substrings)\n    return result_list.items"}
{"task_id": "Mbpp/728", "solution": "def sum_list(a, b):\n    \"\"\"Initializes a new list with element-wise sums of the input lists.\n    Assumes inputs are lists of equal length containing numbers.\"\"\"\n    return [x + y for x, y in zip(a, b)]"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list):\n    \"\"\"Return a new list with consecutive duplicate elements removed, preserving order.\n    Each contiguous run of identical elements is represented by a single occurrence.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n    for i in range(1, len(input_list)):\n        if input_list[i] != result[-1]:\n            result.append(input_list[i])\n    return result"}
{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r, h):\n    # Calculate the slant height 's' of the cone.\n    slant_height = math.sqrt(r**2 + h**2)\n    \n    # Calculate the lateral surface area 'A' of the cone.\n    lateral_surface_area = math.pi * r * slant_height\n    \n    return lateral_surface_area"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(input: str) -> str:\n    \"\"\"Replaces spaces, commas, or dots with a colon in the input string.\"\"\"\n    output_chars = []\n    for char in input:\n        if char in (' ', ',', '.'):\n            output_chars.append(':')\n        else:\n            output_chars.append(char)\n    return ''.join(output_chars)"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array, target):\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array.\n    Returns the zero-based index of the first occurrence, or -1 if not found or array is empty.\n    \"\"\"\n    if not array:\n        return -1\n\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            result = mid\n            high = mid - 1  # Try to find an earlier occurrence in the left half\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n\n    return result"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list):\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists (subarrays) of a given list.\n    \"\"\"\n    total = 0\n    n = len(input_list)\n\n    for start in range(n):\n        for end in range(start, n):\n            # Extract the current subarray\n            subarray = input_list[start:end+1]\n\n            # Calculate the product of elements in the subarray\n            product = 1\n            for element in subarray:\n                product *= element\n\n            # Add the product to the total sum\n            total += product\n            \n    return total"}
{"task_id": "Mbpp/735", "solution": "def to_bits(n: int) -> str:\n    \"\"\"Returns the minimal binary string representation of a non-negative integer.\"\"\"\n    if n == 0:\n        return '0'\n    return bin(n)[2:]\n\ndef create_mask(length: int) -> int:\n    \"\"\"Creates an integer mask with 1s at middle bit positions (excluding MSB and LSB).\"\"\"\n    if length < 3:\n        return 0\n    # Creates a sequence of 'length - 2' ones, then shifts left by 1 to exclude the LSB.\n    return ((1 << (length - 2)) - 1) << 1\n\ndef toggle(value: int, mask: int) -> int:\n    \"\"\"Applies an XOR toggle operation to value with the given mask.\"\"\"\n    return value ^ mask\n\ndef toggle_middle_bits(n: int) -> int:\n    \"\"\"Toggles bits of the number except the first (MSB) and the last (LSB) bit.\"\"\"\n    bits = to_bits(n)\n    if len(bits) < 3:\n        return n\n    mask = create_mask(len(bits))\n    return toggle(n, mask)"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sequence, value) -> int:\n    \"\"\"Compute leftmost insertion index for `value` into sorted (non-decreasing) `sequence`.\n    The algorithm used is a binary-search leftmost variant.\n    \"\"\"\n    if not isinstance(sequence, list):\n        # Unwrap Sequence dataclass if provided\n        sequence = sequence.elements\n\n    if not isinstance(value, (int, float, str)):\n        # Unwrap Value dataclass if provided\n        value = value.value\n\n    low = 0\n    high = len(sequence)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sequence[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/737", "solution": "import re\n\nclass RegexPattern:\n    \"\"\"Domain holder for the regex pattern string.\"\"\"\n    def __init__(self, pattern: str):\n        self.pattern = pattern\n\nclass CheckResult:\n    \"\"\"Encapsulate boolean result.\"\"\"\n    def __init__(self, is_vowel: bool):\n        self.is_vowel = is_vowel\n\nclass StringChecker:\n    \"\"\"Encapsulate regex-based check logic and hold the anchored pattern.\"\"\"\n    _pattern: str = \"^[aeiou]\"\n\n    def __init__(self):\n        self._regex_pattern = RegexPattern(self._pattern)\n\n    def check_str(self, input: str) -> bool:\n        \"\"\"Evaluate input against anchored pattern and return boolean.\"\"\"\n        match = re.match(self._regex_pattern.pattern, input)\n        is_vowel = bool(match)\n        result = CheckResult(is_vowel)\n        return result.is_vowel\n\ndef check_str(input: str) -> bool:\n    \"\"\"\n    Public API. Returns whether the provided string starts with a vowel using a regex.\n    \"\"\"\n    checker = StringChecker()\n    return checker.check_str(input)"}
{"task_id": "Mbpp/739", "solution": "def find_Index(n):\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    The function iterates through k, calculating T_k until it finds one with n digits.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    lower_bound = 10**(n - 1)\n    upper_bound = 10**n\n    k = 1\n    while True:\n        triangular_number = k * (k + 1) // 2\n        if triangular_number >= lower_bound:\n            # We found a triangular number with at least n digits.\n            # Now check if it has exactly n digits.\n            if triangular_number < upper_bound:\n                # T_k has exactly n digits.\n                # We also need to ensure that T_{k-1} had fewer than n digits\n                # to guarantee this is the *smallest* k.\n                # For k=1, T_0 = 0, which has 1 digit if n=1, or 0 digits otherwise (depending on definition).\n                # But for n=1, T_1=1 already satisfies.\n                # Since we increment k, the first T_k that hits lower_bound and is less than upper_bound\n                # guarantees minimality for k (because T_k is strictly increasing).\n                return k\n        k += 1"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple: tuple) -> dict:\n    \"\"\"\n    Convert an input tuple to a dict using adjacent elements as key/value pairs.\n    Keys inserted into the resulting dict must be hashable; if a prospective key is unhashable, Python will raise TypeError.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError('input must be a tuple')\n\n    if len(input_tuple) % 2 != 0:\n        raise ValueError('tuple length must be even')\n\n    result_dict = {}\n    for i in range(0, len(input_tuple), 2):\n        key = input_tuple[i]\n        value = input_tuple[i+1]\n        result_dict[key] = value\n\n    return result_dict"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(input: str) -> bool:\n    \"\"\"\n    Checks if all characters in the input string are identical.\n    Returns True for empty or single-character strings.\n    \"\"\"\n    if len(input) <= 1:\n        return True\n    \n    first_char = input[0]\n    for char in input:\n        if char != first_char:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/743", "solution": "def rotate_right(lst, k):\n    \"\"\"\n    Rotates a list to the right by k positions.\n    Handles empty lists and effective rotation count using modulo.\n    \"\"\"\n    if not lst:\n        return []\n\n    n = len(lst)\n    effective_k = k % n\n\n    if effective_k == 0:\n        return lst[:]  # Return a shallow copy if no effective rotation\n    \n    return lst[-effective_k:] + lst[:-effective_k]"}
{"task_id": "Mbpp/742", "solution": "import math\n\nclass NumericPrecision:\n    \"\"\"Provides numeric precision metadata.\"\"\"\n    def __init__(self, standard: str) -> None:\n        self.standard = standard\n\nDEFAULT_PRECISION: str = \"IEEE-754 double precision\"\n\nclass CalculationEngine:\n    \"\"\"Engine to compute surface area of a regular tetrahedron.\"\"\"\n    def __init__(self, precision: str = None) -> None:\n        self.precision = precision if precision is not None else DEFAULT_PRECISION\n\n    def computeSurfaceArea(self, edge: float) -> float:\n        \"\"\"Computes sqrt(3) * edge * edge and returns as float.\"\"\"\n        return math.sqrt(3) * edge * edge\n\nclass Tetrahedron:\n    \"\"\"Domain model for a regular tetrahedron.\"\"\"\n    def __init__(self, edgeLength: float) -> None:\n        self.edgeLength = edgeLength\n        self.surfaceArea = None\n\n    def computeSurfaceArea(self) -> float:\n        \"\"\"Uses CalculationEngine to compute surface area.\"\"\"\n        engine = CalculationEngine()\n        self.surfaceArea = engine.computeSurfaceArea(self.edgeLength)\n        return self.surfaceArea\n\ndef area_tetrahedron(edge):\n    \"\"\"Calculates the surface area of a regular tetrahedron by delegation.\"\"\"\n    engine = CalculationEngine()\n    tetra = Tetrahedron(edge)\n    surface = engine.computeSurfaceArea(edge)\n    tetra.surfaceArea = surface\n    return surface"}
