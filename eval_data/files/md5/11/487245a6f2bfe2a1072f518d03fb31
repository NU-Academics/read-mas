{"task_id": "Mbpp/749", "solution": "import re\nfrom typing import List\n\nclass InputString:\n    \"\"\"Holds the original string for one input element; provides validation and parsing.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def is_valid_base10(self) -> bool:\n        \"\"\"Returns True if the stored value matches r\"^-?[0-9]+$\".\"\"\"\n        return re.fullmatch(r\"^-?[0-9]+$\", self._value) is not None\n\n    def to_integer(self) -> int:\n        \"\"\"Returns int(self._value), assuming valid. Raises ValueError if parsing fails.\"\"\"\n        try:\n            return int(self._value)\n        except ValueError:\n            # This case should ideally be caught by is_valid_base10, but provides a fallback.\n            raise ValueError(\"Input string is not a valid base-10 integer.\")\n\nclass SortedIntegerList:\n    \"\"\"Container for sorted integers; ensures a new list instance is returned.\"\"\"\n    def __init__(self, values: List[int]):\n        self.values = values\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns a shallow copy of the internal list of integers.\"\"\"\n        return self.values[:]\n\ndef sort_numeric_strings(list_of_strings: List[str]) -> List[int]:\n    \"\"\"Sorts a list of strings of numbers numerically, returning a new list of integers.\"\"\"\n    parsed_numbers: List[int] = []\n    for s in list_of_strings:\n        input_str_obj = InputString(s)\n        if not input_str_obj.is_valid_base10():\n            raise ValueError(f\"Input string '{s}' is not a valid base-10 integer.\")\n        parsed_numbers.append(input_str_obj.to_integer())\n\n    sorted_numbers = sorted(parsed_numbers)\n    sorted_list_obj = SortedIntegerList(sorted_numbers)\n    return sorted_list_obj.to_list()"}
{"task_id": "Mbpp/745", "solution": "from typing import List\n\nclass ResultList:\n    \"\"\"Collects and manages the list of numbers satisfying the criteria.\"\"\"\n    def __init__(self) -> None:\n        self.values: List[int] = []\n\n    def add(self, n: int) -> None:\n        \"\"\"Adds a number to the list of results.\"\"\"\n        self.values.append(n)\n\n    def sort(self) -> None:\n        \"\"\"Sorts the collected numbers in ascending order.\"\"\"\n        self.values.sort()\n\n    def as_list(self) -> List[int]:\n        \"\"\"Returns the current list of results.\"\"\"\n        return self.values\n\nclass Digit:\n    \"\"\"Represents a single decimal digit, used conceptually.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass Number:\n    \"\"\"Encapsulates a number and provides methods to extract its digits and check divisibility.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n        abs_value = abs(value)\n        if abs_value == 0:\n            self.digits: List[int] = [0]\n        else:\n            self.digits = [int(d) for d in str(abs_value)]\n\n    def hasZero(self) -> bool:\n        \"\"\"Checks if any digit in the number is zero.\"\"\"\n        return 0 in self.digits\n\n    def divisibleByAllDigits(self) -> bool:\n        \"\"\"Checks if the number is divisible by all its non-zero digits.\"\"\"\n        for d in self.digits:\n            if d == 0:\n                # Numbers containing digit 0 should have been filtered by hasZero,\n                # but an extra check here ensures robustness if hasZero is skipped.\n                return False\n            if self.value % d != 0:\n                return False\n        return True\n\nclass Range:\n    \"\"\"Represents an inclusive numerical range.\"\"\"\n    def __init__(self, start: int, end: int) -> None:\n        self.start = start\n        self.end = end\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the range is empty (start > end).\"\"\"\n        return self.start > self.end\n\nclass DivisibleByDigitsFunction:\n    \"\"\"Orchestrates the process of finding numbers divisible by their digits within a given range.\"\"\"\n    def __init__(self, startnum: int, endnum: int) -> None:\n        self.startnum = startnum\n        self.endnum = endnum\n        self.range = Range(startnum, endnum)\n        self.result = ResultList()\n\n    def checkNumber(self, n: int) -> bool:\n        \"\"\"Validates if a single number satisfies the divisibility criteria.\"\"\"\n        number_obj = Number(n)\n        return not number_obj.hasZero() and number_obj.divisibleByAllDigits()\n\n    def execute(self) -> List[int]:\n        \"\"\"Iterates through the range, checks each number, and collects valid results.\"\"\"\n        if self.range.is_empty():\n            return []\n\n        for n in range(self.startnum, self.endnum + 1):\n            if self.checkNumber(n):\n                self.result.add(n)\n\n        self.result.sort()\n        return self.result.as_list()\n\ndef divisible_by_digits(startnum: int, endnum: int) -> List[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing the digit 0 are excluded. Digits for negative numbers are derived from their absolute value.\n    \"\"\"\n    func = DivisibleByDigitsFunction(startnum, endnum)\n    return func.execute()"}
