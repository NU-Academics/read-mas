{"task_id": "Mbpp/273", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass TupleInput:\n    elements: tuple\n\n    def length(self) -> int:\n        return len(self.elements)\n\n@dataclass\nclass ResultTuple:\n    elements: tuple\n\n    def length(self) -> int:\n        return len(self.elements)\n\nclass Validator:\n    def is_tuple(self, x) -> bool:\n        return isinstance(x, tuple)\n\n    def validate(self, a: tuple, b: tuple) -> bool:\n        if not self.is_tuple(a) or not self.is_tuple(b):\n            raise TypeError(\"Both inputs must be tuples\")\n        return True\n\nclass SubstractElements:\n    def __init__(self, validator: Validator = None):\n        self.validator = validator or Validator()\n\n    def compute_element(self, a_i, b_i):\n        return a_i - b_i\n\n    def execute(self, a: tuple, b: tuple) -> tuple:\n        self.validator.validate(a, b)\n        n = min(len(a), len(b))\n        results = []\n        for i in range(n):\n            results.append(self.compute_element(a[i], b[i]))\n        return tuple(results)\n\ndef substract_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Public API: element-wise subtraction result tuple where result[i] = a[i] - b[i]\n    for i in range(min(len(a),len(b))).\n    \"\"\"\n    engine = SubstractElements()\n    return engine.execute(a, b)"}
{"task_id": "Mbpp/274", "solution": "def even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of even-indexed binomial coefficients C(n, k) for a positive integer n.\n    This implementation adheres to the provided design context by using internal helper classes.\n    \"\"\"\n    import math\n\n    class IntegerParameter:\n        def __init__(self, value: int):\n            self.value = value\n\n        def is_positive(self) -> bool:\n            return self.value > 0\n\n    class Validator:\n        def validate_integer(self, n: object) -> bool:\n            return isinstance(n, int)\n\n        def validate_positive(self, n: int) -> bool:\n            return n > 0\n\n    class BinomialCoefficient:\n        def compute(self, n: int, k: int) -> int:\n            return math.comb(n, k)\n\n    class Result:\n        def __init__(self, value: int):\n            self._value = value\n\n        @property\n        def value(self) -> int:\n            return self._value\n\n    validator = Validator()\n    param = IntegerParameter(n)\n\n    if not validator.validate_integer(param.value) or not validator.validate_positive(param.value):\n        raise ValueError(\"n must be a positive integer\")\n\n    bc = BinomialCoefficient()\n    total_sum = 0\n    for k in range(0, n + 1, 2):  # Iterate through even indices k\n        total_sum += bc.compute(n, k)\n\n    return Result(total_sum).value"}
{"task_id": "Mbpp/276", "solution": "import math\n\ndef _to_float(value, name):\n    \"\"\"Converts a value to float, raising TypeError for non-convertible types or ValueError for negative values.\"\"\"\n    try:\n        f_value = float(value)\n    except (TypeError, ValueError):\n        raise TypeError(f\"'{name}' must be a numeric type convertible to float.\")\n    if f_value < 0:\n        raise ValueError(f\"'{name}' cannot be negative.\")\n    return f_value\n\ndef volume_cylinder(radius, height):\n    \"\"\"\n    Calculates the volume of a cylinder given its radius and height, with input validation.\n    The inputs are validated to be non-negative numeric types.\n    \"\"\"\n    validated_radius = _to_float(radius, \"radius\")\n    validated_height = _to_float(height, \"height\")\n\n    volume = math.pi * validated_radius**2 * validated_height\n    return volume"}
{"task_id": "Mbpp/278", "solution": "def count_first_elements(tuple_input):\n    \"\"\"Validate tuple_input is a tuple; iterate elements from index 0 and return the number of elements before the first element that is itself a tuple.\n\n    Args:\n        tuple_input: expected Python tuple value\n\n    Returns:\n        int: number of elements before the first tuple element (0 if input[0] is tuple)\n\n    Raises:\n        TypeError: if tuple_input is not of Python tuple type\n    \"\"\"\n    if not isinstance(tuple_input, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    for index, elem in enumerate(tuple_input):\n        if isinstance(elem, tuple):\n            return index\n    return len(tuple_input)"}
{"task_id": "Mbpp/279", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid input to the decagonal number calculation.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass DecagonalCalculator:\n    \"\"\"Handles validation and computation of decagonal numbers.\"\"\"\n    def validate(self, n) -> None:\n        \"\"\"Raises ValidationError if n is not an integer or n < 1.\"\"\"\n        if not isinstance(n, int):\n            raise ValidationError(\"Input must be an integer.\")\n        if n < 1:\n            raise ValidationError(\"Input must be a positive integer (n >= 1).\")\n\n    def compute(self, n: int) -> int:\n        \"\"\"Returns the nth decagonal number using the formula 4*n*n - 3*n.\"\"\"\n        return 4 * n * n - 3 * n\n\ndef is_num_decagonal(n) -> int:\n    \"\"\"Public API for calculating the nth decagonal number, with input validation.\"\"\"\n    calculator = DecagonalCalculator()\n    calculator.validate(n)\n    return calculator.compute(n)"}
