{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number.\n    A number N is Woodall if N = n * 2^n - 1 for some integer n >= 1.\n    \"\"\"\n    import math\n\n    if number < 1:\n        return False\n\n    # Calculate the upper bound for n using the recommended formula: floor(log2(number + 1))\n    n_max = math.floor(math.log2(number + 1))\n\n    for n in range(1, n_max + 1):\n        woodall_candidate = n * (2**n) - 1\n        if woodall_candidate == number:\n            return True\n        elif woodall_candidate > number:\n            # Since n * 2^n - 1 is an increasing function for n >= 1,\n            # if we've exceeded the target number, further increments of n will yield larger values.\n            return False\n\n    return False"}
{"task_id": "Mbpp/16", "solution": "import re\nfrom typing import Optional\n\nPATTERN: str = \"[a-z]+_[a-z]+\"\n\nclass Pattern:\n    \"\"\"Encapsulates regex compilation and matching.\"\"\"\n    def __init__(self, regex: str) -> None:\n        self.regex = regex\n        self._compiled = re.compile(regex)\n\n    def matches(self, s: str) -> Optional[str]:\n        \"\"\"Returns the first matched substring or None.\"\"\"\n        match = self._compiled.search(s)\n        if match:\n            return match.group(0)\n        return None\n\nclass MatchResult:\n    \"\"\"Data holder for pattern evaluation result.\"\"\"\n    def __init__(self, matched: bool, matched_substring: str) -> None:\n        self.matched = matched\n        self.matched_substring = matched_substring\n\ndef text_lowercase_underscore(input: str) -> bool:\n    \"\"\"Return True if input contains a substring matching PATTERN else False.\"\"\"\n    pattern_matcher = Pattern(PATTERN)\n    match_found_str = pattern_matcher.matches(input)\n\n    if match_found_str is not None:\n        result = MatchResult(True, match_found_str)\n    else:\n        result = MatchResult(False, \"\")\n    \n    return result.matched"}
{"task_id": "Mbpp/56", "solution": "def check(n: int) -> bool:\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    \"\"\"\n    class Number:\n        \"\"\"Represents an integer and provides its digit reversal.\"\"\"\n        def __init__(self, value: int) -> None:\n            self.value = value\n\n        def reverse(self) -> int:\n            \"\"\"Reverses the base-10 digits of the number, dropping leading zeros.\"\"\"\n            s = str(self.value)\n            reversed_s = s[::-1]\n            stripped_s = reversed_s.lstrip('0')\n            if not stripped_s:\n                return 0\n            return int(stripped_s)\n\n    class ReverseOperation:\n        \"\"\"Provides a reusable operation to reverse an integer.\"\"\"\n        def execute(self, value: int) -> int:\n            \"\"\"Executes the reversal operation on the given integer.\"\"\"\n            return Number(value).reverse()\n\n    class Result:\n        \"\"\"Value object encapsulating a boolean outcome.\"\"\"\n        def __init__(self, is_match: bool) -> None:\n            self.is_match = is_match\n\n    class CheckFunction:\n        \"\"\"Coordinates reversal and comparison for the check operation.\"\"\"\n        def evaluate(self, n: int) -> 'Result':\n            \"\"\"Evaluates if n is one less than twice its reverse.\"\"\"\n            num = Number(n)\n            rev = ReverseOperation().execute(num.value)\n            is_match = (n == 2 * rev - 1)\n            return Result(is_match)\n\n    checker = CheckFunction()\n    result = checker.evaluate(n)\n    return result.is_match"}
