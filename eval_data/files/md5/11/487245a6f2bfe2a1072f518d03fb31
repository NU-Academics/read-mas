{"task_id": "Mbpp/465", "solution": "def drop_empty(inputDict: dict) -> dict:\n    \"\"\"\n    Returns a new dictionary with items whose values are None dropped.\n    Preserves falsy values like '', 0, False, and [].\n    \"\"\"\n    if not isinstance(inputDict, dict):\n        raise TypeError(\"Input must be a dictionary.\")\n\n    result_dict = {}\n    for key, value in inputDict.items():\n        if value is not None:\n            result_dict[key] = value\n    return result_dict"}
{"task_id": "Mbpp/463", "solution": "from typing import List\n\ndef max_subarray_product(arr: List[int]) -> int:\n    \"\"\"Compute maximum product among all contiguous non-empty subarrays.\"\"\"\n    max_so_far = arr[0]\n    current_max = arr[0]\n    current_min = arr[0]\n\n    for i in range(1, len(arr)):\n        num = arr[i]\n        \n        # Store current_max before it's updated, as it's needed for calculating current_min\n        temp_max_val = current_max\n        \n        current_max = max(num, num * temp_max_val, num * current_min)\n        current_min = min(num, num * temp_max_val, num * current_min)\n        \n        max_so_far = max(max_so_far, current_max)\n        \n    return max_so_far"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(t: tuple) -> tuple:\n    \"\"\"Compute pairwise sums of neighboring elements.\n    Does not modify t.\n    \"\"\"\n    n = len(t)\n    if n < 2:\n        return ()\n    return tuple(t[i] + t[i + 1] for i in range(n - 1))"}
{"task_id": "Mbpp/462", "solution": "def combinations_list(input_list: list) -> list:\n    \"\"\"\n    Generates all possible combinations (subsets) of elements from the input list.\n    Combinations are ordered by iterating binary masks from 0 to 2^n-1,\n    and elements within each combination are appended in descending index order.\n    \"\"\"\n    n = len(input_list)\n    num_combinations = 1 << n  # Calculate 2^n\n    result = []\n\n    for mask_index in range(num_combinations):\n        current_combination = []\n        # Iterate through input_list elements from highest index down to lowest (n-1 to 0).\n        # This ensures elements are appended to current_combination in descending order of their original index.\n        for element_index in range(n - 1, -1, -1):\n            # Check if the bit corresponding to the current element_index is set in the mask_index.\n            if (mask_index >> element_index) & 1:\n                current_combination.append(input_list[element_index])\n        result.append(current_combination)\n\n    return result"}
{"task_id": "Mbpp/468", "solution": "def max_product(array: List[float]) -> float:\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of a strictly increasing subsequence.\n    This function uses dynamic programming to find the maximum product of any increasing subsequence.\n    \"\"\"\n    if not array:\n        return 0.0\n\n    n = len(array)\n    # dp[i] stores the maximum product of an increasing subsequence ending at array[i].\n    dp = [0.0] * n\n\n    # Initialize max_overall_product with the maximum of single-element subsequences.\n    # This covers cases where only single-element subsequences are possible (e.g., [5, 4, 3])\n    # or if the array contains negative numbers. For an empty array, 0.0 is returned above.\n    max_overall_product = -float('inf')\n    if array: \n        max_overall_product = max(array)\n\n    for i in range(n):\n        # The element array[i] itself forms an increasing subsequence of length 1.\n        dp[i] = array[i]\n\n        # Check all previous elements array[j] (where j < i)\n        # to potentially extend an increasing subsequence ending at array[j].\n        for j in range(i):\n            if array[j] < array[i]:\n                # If array[j] can precede array[i] in a strictly increasing subsequence,\n                # update dp[i] by considering the product formed by extending\n                # the subsequence ending at array[j] with array[i].\n                dp[i] = max(dp[i], dp[j] * array[i])\n        \n        # After calculating dp[i], update the overall maximum product found so far.\n        max_overall_product = max(max_overall_product, dp[i])\n\n    return max_overall_product"}
{"task_id": "Mbpp/472", "solution": "from typing import List\n\ndef check_Consecutive(input_list: List[int]) -> bool:\n    \"\"\"\n    Checks if the given list contains strictly ascending consecutive numbers with a step of 1.\n    Raises TypeError or ValueError for invalid input types.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for item in input_list:\n        if not isinstance(item, int):\n            raise ValueError(\"All elements in the list must be integers.\")\n\n    if len(input_list) < 2:\n        return False\n\n    for i in range(len(input_list) - 1):\n        if input_list[i+1] - input_list[i] != 1:\n            return False\n\n    return True"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(array, n) -> int:\n    \"\"\"Finds the product of array elements modulo n using iterative multiplication.\"\"\"\n\n    def _iterative_modular_product(elements: list[int], modulus: int) -> int:\n        \"\"\"Helper to compute the product of elements modulo modulus, avoiding large intermediate numbers.\"\"\"\n        product = 1\n        for x in elements:\n            product = (product * x) % modulus\n        return product\n\n    # The design specifies delegation via RemainderCalculator, but given the constraints\n    # (no class wrapper, helper defined inline), we directly call the inlined helper.\n    return _iterative_modular_product(array, n)"}
{"task_id": "Mbpp/473", "solution": "def tuple_intersection(list1, list2):\n    # Helper classes for domain modeling and collection management, defined inline.\n\n    class Tuple:\n        \"\"\"Represents a tuple with a method to return its normalized (unordered) form.\"\"\"\n        def __init__(self, elements: tuple):\n            self.elements = elements\n\n        def normalized(self) -> frozenset:\n            \"\"\"Returns a frozenset of elements for unordered comparison.\"\"\"\n            return frozenset(self.elements)\n\n    class TupleList:\n        \"\"\"Manages a list of Tuple objects and provides an index for normalized lookups.\"\"\"\n        def __init__(self, tuples: list):\n            self.tuples = [Tuple(t) for t in tuples]\n\n        def unique_normalized_index(self) -> dict:\n            \"\"\"Builds an index mapping frozenset keys to a list of matching Tuple objects.\"\"\"\n            index = {}\n            for t_obj in self.tuples:\n                normalized_key = t_obj.normalized()\n                # Append the tuple object to the list associated with its normalized key.\n                index.setdefault(normalized_key, []).append(t_obj)\n            return index\n\n    class ResultSet:\n        \"\"\"Collects unique matched tuples, preserving their original element order.\"\"\"\n        def __init__(self):\n            self.matches = set()\n\n        def add(self, match: tuple) -> None:\n            \"\"\"Adds a matched tuple to the internal set.\"\"\"\n            self.matches.add(match)\n\n        def as_set(self) -> set:\n            \"\"\"Returns the collected set of unique matches.\"\"\"\n            return self.matches\n\n    # If either input list is empty, return an empty set as there can be no intersection.\n    if not list1 or not list2:\n        return set()\n\n    # Build a normalized index from list2 for efficient lookup of matching tuples.\n    list2_tuple_list = TupleList(list2)\n    normalized_index_list2 = list2_tuple_list.unique_normalized_index()\n\n    # Prepare to collect matched tuples from list1.\n    list1_tuple_list = TupleList(list1)\n    result_set = ResultSet()\n\n    # Iterate through each tuple in list1.\n    for t_obj_list1 in list1_tuple_list.tuples:\n        # If the normalized form of a tuple from list1 exists in list2's index, it's a match.\n        if t_obj_list1.normalized() in normalized_index_list2:\n            result_set.add(t_obj_list1.elements)\n\n    # Return the set of unique matches found, preserving original tuple order from list1.\n    return result_set.as_set()"}
{"task_id": "Mbpp/474", "solution": "class ValidationError(Exception):\n    \"\"\"Exception type for validation failures.\n    Contains a human-readable message and an optional machine-readable code.\"\"\"\n    def __init__(self, message: str, code: str = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\n    def __str__(self) -> str:\n        if self.code:\n            return f\"[{self.code}] {self.message}\"\n        return self.message\n\ndef _validate_chars(old_char: str, new_char: str) -> None:\n    \"\"\"Raise ValidationError if either parameter is not a single-character string.\"\"\"\n    if len(old_char) != 1:\n        raise ValidationError(\"old_char must be a single character string.\", code=\"INVALID_OLD_CHAR\")\n    if len(new_char) != 1:\n        raise ValidationError(\"new_char must be a single character string.\", code=\"INVALID_NEW_CHAR\")\n\ndef _process_replacement(input_string: str, old_char: str, new_char: str) -> str:\n    \"\"\"Perform a single-pass O(n) replacement building and returning a new string.\"\"\"\n    result_chars = []\n    for char in input_string:\n        if char == old_char:\n            result_chars.append(new_char)\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)\n\ndef replace_char(input_string: str, old_char: str, new_char: str) -> str:\n    \"\"\"Public API. Validate parameters then return a new string where every occurrence of old_char\n    is replaced with new_char. Raises ValidationError when old_char or new_char are not single chars.\n    \"\"\"\n    _validate_chars(old_char, new_char)\n    return _process_replacement(input_string, old_char, new_char)"}
{"task_id": "Mbpp/475", "solution": "def sort_counter(mapping: dict) -> list[tuple]:\n    \"\"\"Return a list of (key, value) tuples containing all entries of 'mapping' ordered by value descending.\n\n    Args:\n        mapping: dict - mapping of string keys to numeric values (as per SRS).\n\n    Returns:\n        list of tuples (key, value) ordered by value descending.\n    \"\"\"\n    items = list(mapping.items())\n    items.sort(key=lambda kv: kv[1], reverse=True)\n    return items"}
