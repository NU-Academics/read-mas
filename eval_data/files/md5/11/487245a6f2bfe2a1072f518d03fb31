{"task_id": "Mbpp/451", "solution": "def remove_whitespaces(input: str) -> str:\n    \"\"\"Removes all whitespace characters from the given string.\n    Uses str.isspace() for Unicode-aware whitespace detection.\"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"input must be a string\")\n    \n    # Use a list to build the new string efficiently\n    result_chars = []\n    for char in input:\n        if not char.isspace():\n            result_chars.append(char)\n            \n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/453", "solution": "def sumofFactors(n):\n    \"\"\"Calculates the sum of even positive factors of a number n.\n    Handles n <= 0 by considering factors of abs(n).\n    \"\"\"\n    total_sum = 0\n    num = abs(n)\n\n    for i in range(1, num + 1):\n        if num % i == 0 and i % 2 == 0:\n            total_sum += i\n    return total_sum"}
{"task_id": "Mbpp/454", "solution": "import re\n\nWORD_REGEX_PATTERN = r\"[A-Za-z]+\"\n\ndef _contains_lowercase_z(word) -> bool:\n    \"\"\"Checks if a word contains the literal lowercase character 'z'.\"\"\"\n    return 'z' in word\n\ndef _extract_words(input_text) -> list:\n    \"\"\"Extracts all words from the input text using the predefined word regex pattern.\"\"\"\n    return re.findall(WORD_REGEX_PATTERN, input_text)\n\ndef text_match_wordz(input_text) -> bool:\n    \"\"\"\n    Checks if any word in the input_text contains the lowercase character 'z'.\n    Words are defined as contiguous ASCII alphabetic sequences.\n    \"\"\"\n    words = _extract_words(input_text)\n    for word in words:\n        if _contains_lowercase_z(word):\n            return True\n    return False"}
{"task_id": "Mbpp/457", "solution": "def Find_Min(input_list):\n    \"\"\"\n    Return one sublist from input_list that has the smallest length.\n\n    Returns None if input_list is empty. Returns the first-occurrence minimal-length sublist for ties.\n    \"\"\"\n    if not input_list:\n        return None\n\n    min_length = float('inf')\n    min_sublist = None\n\n    for sublist in input_list:\n        current_length = len(sublist)\n        if current_length < min_length:\n            min_length = current_length\n            min_sublist = sublist\n    \n    return min_sublist"}
{"task_id": "Mbpp/455", "solution": "class Month:\n    \"\"\"Represents a month and determines if it has 31 days.\"\"\"\n    _MONTHS_WITH_31_DAYS = {1, 3, 5, 7, 8, 10, 12}\n\n    def __init__(self, number: int, days: int = None) -> None:\n        self.number = number\n        self.days = days\n\n    def has31Days(self) -> bool:\n        \"\"\"Checks if the month number corresponds to a month with 31 days.\"\"\"\n        return self.number in self._MONTHS_WITH_31_DAYS\n\nclass MonthChecker:\n    \"\"\"Provides operational logic to check if a month has 31 days.\"\"\"\n    def check_monthnumb_number(self, month: int) -> bool:\n        \"\"\"Delegates to a Month entity to check if the given month has 31 days.\"\"\"\n        month_entity = Month(month)\n        return month_entity.has31Days()\n\ndef check_monthnumb_number(month: int) -> bool:\n    \"\"\"\n    Checks whether the given month number contains 31 days.\n    This function delegates to a MonthChecker instance for the actual logic.\n    \"\"\"\n    checker = MonthChecker()\n    return checker.check_monthnumb_number(month)"}
{"task_id": "Mbpp/456", "solution": "from typing import List\n\ndef reverse_string_list(input_list: List[str]) -> List[str]:\n    \"\"\"\n    Reverses each string in a given list of string values.\n    Assumes all elements in the input list are strings.\n    \"\"\"\n    if len(input_list) == 0:\n        return []\n\n    reversed_list = [s[::-1] for s in input_list]\n\n    return reversed_list"}
{"task_id": "Mbpp/458", "solution": "class NumericValidator:\n    @staticmethod\n    def isNumeric(value) -> bool:\n        \"\"\"Returns True to satisfy structural design, skipping actual validation per prompt.\"\"\"\n        return True\n\nclass Rectangle:\n    def __init__(self, length: float, width: float):\n        self._length = length\n        self._width = width\n\n    def getArea(self) -> float:\n        \"\"\"Computes and returns the area of the rectangle.\"\"\"\n        return self._length * self._width\n\nclass RectangleAreaService:\n    def __init__(self, validator: NumericValidator = None):\n        # Use provided validator or instantiate a default one.\n        self._validator = validator if validator is not None else NumericValidator()\n\n    def rectangle_area(self, length, width) -> float:\n        \"\"\"\n        Validates inputs, constructs a Rectangle, and computes its area.\n        Delegates to NumericValidator and Rectangle as per design.\n        \"\"\"\n        self._validator.isNumeric(length) # Calls validator but actual check is skipped per prompt\n        self._validator.isNumeric(width)  # Calls validator but actual check is skipped per prompt\n\n        rectangle = Rectangle(length, width)\n        return rectangle.getArea()\n\ndef rectangle_area(length, width) -> float:\n    \"\"\"\n    Calculates the area of a rectangle given its length and width.\n    This function delegates the computation to an internal RectangleAreaService.\n    \"\"\"\n    service = RectangleAreaService()\n    return service.rectangle_area(length, width)"}
