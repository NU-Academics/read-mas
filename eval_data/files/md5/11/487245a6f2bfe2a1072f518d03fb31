{"task_id": "Mbpp/440", "solution": "import unicodedata\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Helper classes are nested within this function as per design.\n    \"\"\"\n\n    class Punctuation:\n        \"\"\"Utility for Unicode-aware punctuation classification.\"\"\"\n        @staticmethod\n        def is_punctuation(ch: str) -> bool:\n            return unicodedata.category(ch).startswith('P')\n\n    class Sentence:\n        \"\"\"Lightweight wrapper for the input sentence text.\"\"\"\n        def __init__(self, text: str):\n            self.text = text\n            self._length = len(text)\n\n        def length(self) -> int:\n            return self._length\n\n    class Token:\n        \"\"\"Represents a substring (token) with its raw text, original indices, and normalized form.\"\"\"\n        def __init__(self, raw: str, start: int, end: int):\n            self.raw = raw\n            self.start = start\n            self.end = end\n            self._normalized_text = None\n            self._alphabetic_start_offset = -1\n            self._alphabetic_end_offset = -1 # exclusive offset within self.raw\n\n        def _compute_normalized_and_offsets(self):\n            if self._normalized_text is not None:\n                return\n\n            current_text = self.raw\n            start_offset = 0\n            end_offset = len(current_text) - 1\n\n            # Trim leading punctuation\n            while start_offset <= end_offset and Punctuation.is_punctuation(current_text[start_offset]):\n                start_offset += 1\n\n            # Trim trailing punctuation\n            while end_offset >= start_offset and Punctuation.is_punctuation(current_text[end_offset]):\n                end_offset -= 1\n            \n            if start_offset > end_offset: # No alphabetic characters left after trimming\n                self._normalized_text = \"\"\n                self._alphabetic_start_offset = -1\n                self._alphabetic_end_offset = -1\n            else:\n                self._normalized_text = current_text[start_offset : end_offset + 1]\n                self._alphabetic_start_offset = start_offset\n                self._alphabetic_end_offset = end_offset + 1 # exclusive\n\n        def normalized(self) -> str:\n            \"\"\"Returns the alphabetic-only core of the token after stripping leading/trailing punctuation.\"\"\"\n            self._compute_normalized_and_offsets()\n            return self._normalized_text\n\n        def isAlphabeticSequence(self) -> bool:\n            \"\"\"Checks if the normalized token is non-empty and consists purely of alphabetic characters.\"\"\"\n            self._compute_normalized_and_offsets()\n            return bool(self._normalized_text) and self._normalized_text.isalpha()\n\n        def get_alphabetic_indices(self) -> tuple[int, int]:\n            \"\"\"Returns the start and exclusive end indices of the alphabetic core within the original sentence.\"\"\"\n            self._compute_normalized_and_offsets()\n            if self._alphabetic_start_offset == -1: # Indicates no alphabetic core\n                return -1, -1\n\n            original_start = self.start + self._alphabetic_start_offset\n            original_end = self.start + self._alphabetic_end_offset\n            return original_start, original_end\n\n    class Tokenizer:\n        \"\"\"Scans the input string in a single pass to produce Token objects.\"\"\"\n        def tokenize(self, text: str) -> \"list[Token]\":\n            tokens = []\n            n = len(text)\n            i = 0\n            while i < n:\n                # Skip leading whitespace\n                while i < n and text[i].isspace():\n                    i += 1\n                \n                if i == n: # Reached end of string\n                    break\n\n                token_start = i\n                \n                # Find the end of the current word-like sequence (non-whitespace characters)\n                while i < n and not text[i].isspace():\n                    i += 1\n                token_end = i # exclusive\n\n                raw_token_text = text[token_start:token_end]\n                token = Token(raw_token_text, token_start, token_end)\n                tokens.append(token)\n            return tokens\n\n    class AdverbResult:\n        \"\"\"Data Transfer Object for a detected adverb's details.\"\"\"\n        def __init__(self, start_index: int, end_index: int, adverb_text: str):\n            self.start_index = start_index\n            self.end_index = end_index\n            self.adverb_text = adverb_text\n\n    class AdverbDetector:\n        \"\"\"Detects the first adverb among a stream of tokens.\"\"\"\n        _ADVERB_SET = frozenset([\n            \"clearly\", \"quickly\", \"slowly\", \"very\", \"always\", \"never\",\n            \"often\", \"rarely\", \"sometimes\", \"usually\", \"almost\", \"soon\",\n            \"early\", \"late\", \"here\", \"there\", \"everywhere\", \"anywhere\",\n            \"hard\", \"well\", \"badly\", \"extremely\", \"really\", \"quite\",\n            \"only\", \"just\", \"ago\", \"yet\", \"still\", \"already\", \"ever\"\n        ]) # A constant-size, case-folded set of common adverbs for O(1) lookup.\n\n        def find_first_adverb(self, tokens: \"list[Token]\") -> AdverbResult | None:\n            for token in tokens:\n                if token.isAlphabeticSequence():\n                    normalized_casefolded = token.normalized().casefold()\n                    if normalized_casefolded in self._ADVERB_SET:\n                        start_idx, end_idx = token.get_alphabetic_indices()\n                        return AdverbResult(start_idx, end_idx, token.normalized())\n            return None\n\n    # Main orchestration logic\n    _ = Sentence(sentence) # Sentence wrapper not strictly needed with current Token implementation but kept for design consistency\n    tokenizer = Tokenizer()\n    tokens = tokenizer.tokenize(sentence)\n    detector = AdverbDetector()\n    result = detector.find_first_adverb(tokens)\n\n    if result is not None:\n        return (result.start_index, result.end_index, result.adverb_text)\n    else:\n        return None"}
{"task_id": "Mbpp/448", "solution": "def cal_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) to P(n) inclusive.\n    Perrin numbers are defined by P(0)=3, P(1)=0, P(2)=2, and P(n)=P(n-2)+P(n-3) for n >= 3.\n    \"\"\"\n    # Input validation is omitted based on prompt's explicit instruction\n    # \"Do NOT add isinstance() checks or raise exceptions for edge cases\".\n\n    if n == 0:\n        return 3\n\n    if n == 1:\n        return 3\n\n    if n == 2:\n        return 5\n\n    # For n >= 3, use iterative memoization\n    perrin_values = [0] * (n + 1)\n    perrin_values[0] = 3\n    perrin_values[1] = 0\n    perrin_values[2] = 2\n\n    total_sum = 5 # Sum of P(0), P(1), P(2)\n\n    for i in range(3, n + 1):\n        perrin_values[i] = perrin_values[i - 2] + perrin_values[i - 3]\n        total_sum += perrin_values[i]\n\n    return total_sum"}
