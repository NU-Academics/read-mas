{"task_id": "Mbpp/632", "solution": "def move_zero(input_list: list) -> list:\n    \"\"\"\n    Moves all zeroes to the end of the given list, preserving the relative order of non-zero elements.\n    Returns a new list without modifying the input list.\n    \"\"\"\n    non_zeros = []\n    zero_count = 0\n    for element in input_list:\n        if element != 0:\n            non_zeros.append(element)\n        else:\n            zero_count += 1\n    return non_zeros + [0] * zero_count"}
{"task_id": "Mbpp/629", "solution": "from dataclasses import dataclass\nfrom typing import List, Any\n\n@dataclass\nclass NumberList:\n    values: List[Any]\n\n@dataclass\nclass EvenNumber:\n    value: Any\n    position: int\n\ndef Split(numbers: List[Any]) -> list:\n    \"\"\"\n    Accepts a single parameter 'numbers' (a list of numbers) and returns a list\n    containing only even numbers from 'numbers' preserving input order.\n    Raises:\n        TypeError: if 'numbers' is not a list of numeric values.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n\n    input_list_container = NumberList(values=numbers)\n    even_numbers_found = []\n\n    for index, num_candidate in enumerate(input_list_container.values):\n        if not isinstance(num_candidate, (int, float)):\n            raise TypeError(f\"All elements in 'numbers' must be numeric. Found non-numeric type '{type(num_candidate).__name__}' at index {index}.\")\n\n        if num_candidate % 2 == 0:\n            even_num_obj = EvenNumber(value=num_candidate, position=index)\n            even_numbers_found.append(even_num_obj.value)\n\n    return even_numbers_found"}
{"task_id": "Mbpp/635", "solution": "from typing import List\nimport heapq\n\ndef heap_sort(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Sorts a list of integers using the heap sort algorithm.\n    Returns a new list containing the sorted elements without modifying the original.\n    \"\"\"\n    if not input_list:\n        return []\n\n    # Create a mutable copy to build the heap\n    heap = input_list[:]\n    heapq.heapify(heap)\n\n    sorted_list = []\n    while heap:\n        sorted_list.append(heapq.heappop(heap))\n\n    return sorted_list"}
{"task_id": "Mbpp/633", "solution": "class NumbersList:\n    \"\"\"A lightweight data holder for a list of numbers and its length.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n        self.length = len(elements)\n\nclass Result:\n    \"\"\"A lightweight data holder for the computed sum.\"\"\"\n    def __init__(self, sum_val: int):\n        self.sum = sum_val\n\n    def get(self) -> int:\n        return self.sum\n\ndef validate_types(numbers, n):\n    \"\"\"Ensures n is an int and all elements in numbers are ints, raising TypeError if not.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    if not isinstance(numbers, list):\n        raise TypeError(\"numbers must be a list.\")\n    for num in numbers:\n        if not isinstance(num, int):\n            raise TypeError(\"All elements in numbers must be integers.\")\n\ndef validate_length(numbers, n):\n    \"\"\"Ensures n matches the actual length of numbers, raising ValueError if not.\"\"\"\n    if n != len(numbers):\n        raise ValueError(\"n must be equal to the length of the numbers list.\")\n\ndef pair_xor_Sum(numbers, n):\n    \"\"\"\n    Computes the sum of XORs of all unique pairs of numbers in the given list.\n    Validates input types and length before computation.\n    \"\"\"\n    validate_types(numbers, n)\n    validate_length(numbers, n)\n\n    nums_obj = NumbersList(numbers)\n    running_sum = 0\n\n    # Handle empty list case explicitly, though the loops naturally handle it.\n    if nums_obj.length == 0:\n        return Result(0).get()\n\n    for i in range(nums_obj.length):\n        for j in range(i + 1, nums_obj.length):\n            running_sum += nums_obj.elements[i] ^ nums_obj.elements[j]\n\n    res = Result(running_sum)\n    return res.get()"}
{"task_id": "Mbpp/631", "solution": "def replace_spaces(input, mode='space_to_underscore'):\n    \"\"\"Replaces whitespaces with an underscore and vice versa in a given string.\n    Supports 'space_to_underscore' (default) and 'underscore_to_space' modes.\"\"\"\n\n    def validateInput(input_val):\n        \"\"\"Ensures the input is a string, raising TypeError if not.\"\"\"\n        if not isinstance(input_val, str):\n            raise TypeError(\"Input must be a string.\")\n\n    def mapSpaceToUnderscore(s):\n        \"\"\"Replaces all Unicode whitespace characters in a string with underscores.\"\"\"\n        result_chars = []\n        for char in s:\n            if char.isspace():  # Uses Unicode White_Space property\n                result_chars.append('_')\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n\n    def mapUnderscoreToSpace(s):\n        \"\"\"Replaces all underscore characters in a string with spaces.\"\"\"\n        result_chars = []\n        for char in s:\n            if char == '_':\n                result_chars.append(' ')\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n\n    validateInput(input)\n\n    if mode == 'space_to_underscore':\n        return mapSpaceToUnderscore(input)\n    elif mode == 'underscore_to_space':\n        return mapUnderscoreToSpace(input)\n    else:\n        # If an unrecognized mode is provided, fallback to the default behavior\n        # as specified in the design context (space_to_underscore).\n        return mapSpaceToUnderscore(input)"}
{"task_id": "Mbpp/639", "solution": "class Name:\n    def __init__(self, value: str):\n        self.value = value\n\n    def starts_with_lowercase(self) -> bool:\n        # Return True if first character of value is ASCII 'a'..'z', False otherwise.\n        return bool(self.value) and 'a' <= self.value[0] <= 'z'\n\n    def length(self) -> int:\n        # Return len(value).\n        return len(self.value)\n\n\nclass NameList:\n    def __init__(self, names: list) -> None:\n        # Normalize input iterable of strings (assumes strings per BR7) into Name instances.\n        self.names = [Name(name) for name in names]\n\n    def filter_lowercase(self) -> list[Name]:\n        # Return a list of Name objects excluding those where starts_with_lowercase() is True.\n        return [name for name in self.names if not name.starts_with_lowercase()]\n\n    def total_length(self) -> int:\n        # Compute integer sum of lengths of names returned by filter_lowercase().\n        filtered_names = self.filter_lowercase()\n        return sum(name.length() for name in filtered_names)\n\n\ndef sample_nam(names: list[str]) -> int:\n    \"\"\"Public API per SRS.\n    Returns the sum of lengths of names not starting with lowercase ASCII letters 'a'..'z'.\n    \"\"\"\n    name_list_obj = NameList(names)\n    return name_list_obj.total_length()"}
{"task_id": "Mbpp/641", "solution": "from typing import Optional\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str, code: Optional[int] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\nclass InputParameter:\n    \"\"\"Encapsulates and validates the input parameter n.\"\"\"\n    def __init__(self, n: int) -> None:\n        self._n = n\n\n    def isValid(self) -> bool:\n        \"\"\"Returns True if _n is an integer and _n is greater than or equal to 1.\"\"\"\n        return isinstance(self._n, int) and self._n >= 1\n\nclass NonagonalNumber:\n    \"\"\"A data holder for the n and its computed nonagonal value.\"\"\"\n    def __init__(self, n: int, value: int) -> None:\n        self.n = n\n        self.value = value\n\nclass NonagonalCalculator:\n    \"\"\"Orchestrates input validation and computation of nonagonal numbers.\"\"\"\n    def is_nonagonal(self, n: int) -> int:\n        \"\"\"Validates input, computes, and returns the nth nonagonal number.\"\"\"\n        input_param = InputParameter(n)\n        if not input_param.isValid():\n            raise ValidationError(\"Input 'n' must be a positive integer (n >= 1).\")\n        \n        computed_value = self._computeFormula(n)\n        # As per design, NonagonalNumber is an internal data holder.\n        # NonagonalNumber(n, computed_value)\n        return computed_value\n\n    def _computeFormula(self, n: int) -> int:\n        \"\"\"Computes N(n) = n * (7*n - 5) / 2 using integer arithmetic.\"\"\"\n        return n * (7*n - 5) // 2\n\ndef is_nonagonal(n: int) -> int:\n    \"\"\"\n    Finds the nth nonagonal number.\n    The input 'n' must be a positive integer (n >= 1).\n    \"\"\"\n    calculator = NonagonalCalculator()\n    return calculator.is_nonagonal(n)"}
{"task_id": "Mbpp/643", "solution": "import string\nfrom typing import List, Optional\n\nclass Word:\n    \"\"\"Represents a token with its value and original text indices.\"\"\"\n    def __init__(self, value: str, start_index: int, end_index: int):\n        self.value = value\n        self.start_index = start_index\n        self.end_index = end_index\n\n    def hasZInMiddle(self) -> bool:\n        \"\"\"Checks if the word contains 'z' not at the first or last position.\"\"\"\n        if len(self.value) < 3:\n            return False\n        for i in range(1, len(self.value) - 1):\n            if self.value[i] == 'z':\n                return True\n        return False\n\nclass MatchResult:\n    \"\"\"DTO for the detection outcome, including optional indices.\"\"\"\n    def __init__(self, containsZMiddle: bool, matched_word_index: Optional[int] = None, matched_char_index: Optional[int] = None):\n        self.containsZMiddle = containsZMiddle\n        self.matched_word_index = matched_word_index\n        self.matched_char_index = matched_char_index\n\nclass Text:\n    \"\"\"Represents input string and tokenization logic.\"\"\"\n    def __init__(self, content: str):\n        self.content = content\n\n    def length(self) -> int:\n        return len(self.content)\n\n    def tokenize(self, is_word_char_func) -> List[Word]:\n        \"\"\"Tokenizes the content into words using the provided word character check.\"\"\"\n        words: List[Word] = []\n        current_word_start_index = -1\n        current_word_buffer: List[str] = []\n\n        for i, char in enumerate(self.content):\n            if is_word_char_func(char):\n                if current_word_start_index == -1:\n                    current_word_start_index = i\n                current_word_buffer.append(char)\n            else:\n                if current_word_start_index != -1:\n                    word_value = \"\".join(current_word_buffer)\n                    if word_value:\n                        words.append(Word(word_value, current_word_start_index, i - 1))\n                    current_word_start_index = -1\n                    current_word_buffer = []\n\n        if current_word_start_index != -1:\n            word_value = \"\".join(current_word_buffer)\n            if word_value:\n                words.append(Word(word_value, current_word_start_index, len(self.content) - 1))\n\n        return words\n\nclass TextMatcher:\n    \"\"\"Encapsulates tokenization choices and the 'z' detection algorithm.\"\"\"\n    _punctuation: set = set(string.punctuation)\n\n    def isWordCharacter(self, c: str) -> bool:\n        \"\"\"Returns True if the character is not whitespace and not punctuation.\"\"\"\n        return not c.isspace() and c not in self._punctuation\n\n    def text_match_wordz_middle(self, text: str) -> bool:\n        \"\"\"Detects if any word in the text contains 'z' not at the start or end.\"\"\"\n        text_obj = Text(text)\n        words = text_obj.tokenize(self.isWordCharacter)\n\n        for word in words:\n            if word.hasZInMiddle():\n                return True\n        return False\n\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"\n    Checks if a string contains 'z' within any word, excluding the first and last characters.\n    Uses string.punctuation for tokenization and considers only lowercase 'z'.\n    \"\"\"\n    matcher = TextMatcher()\n    return matcher.text_match_wordz_middle(text)"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(array, k):\n    \"\"\"\n    Reverses the first k elements of a list, returning a new list.\n    Handles type validation and various k-value scenarios.\n    \"\"\"\n    if not isinstance(array, list):\n        raise TypeError(\"array must be a list\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an int\")\n\n    if k <= 0:\n        return array[:]  # Return a shallow copy of the original array\n\n    if k >= len(array):\n        return array[::-1]  # Reverse the entire array\n\n    # Reverse the first k elements and concatenate with the rest\n    prefix_reversed = array[:k][::-1]\n    remainder = array[k:]\n    return prefix_reversed + remainder"}
