{"task_id": "Mbpp/61", "solution": "from collections import Counter\nfrom typing import List\n\ndef count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of substrings where the sum of digits equals the substring length.\n    Raises ValueError if the input string contains non-digit characters.\n    \"\"\"\n    def _validate_digits(s_to_validate: str) -> bool:\n        \"\"\"Internal helper to check if the string contains only digit characters.\"\"\"\n        return s_to_validate.isdigit()\n\n    def _count_zero_sum_subarrays(values: List[int]) -> int:\n        \"\"\"Internal helper to count contiguous subarrays that sum to zero using prefix sums.\"\"\"\n        count = 0\n        current_sum = 0\n        prefix_sum_freq = Counter()\n        prefix_sum_freq[0] = 1 # Initialize for subarrays starting from index 0\n\n        for val in values:\n            current_sum += val\n            count += prefix_sum_freq[current_sum]\n            prefix_sum_freq[current_sum] += 1\n        return count\n\n    if not _validate_digits(s):\n        raise ValueError(\"Input string must contain only digits.\")\n\n    # Transform the problem: for each digit 'd', replace it with (int(d) - 1).\n    # Now, we need to find subarrays in this new list that sum to zero.\n    transformed_values = [int(char) - 1 for char in s]\n\n    return _count_zero_sum_subarrays(transformed_values)"}
{"task_id": "Mbpp/63", "solution": "def max_difference(pairs: list[tuple[float, float]]) -> float:\n    \"\"\"\n    Finds the maximum absolute difference between available pairs in the given tuple list.\n    Propagates ValueError if the input list is empty.\n    \"\"\"\n\n    class Pair:\n        \"\"\"Represents a pair of numbers and computes their absolute difference.\"\"\"\n        def __init__(self, a: float, b: float) -> None:\n            self.a = a\n            self.b = b\n\n        def get_difference(self) -> float:\n            \"\"\"Returns the absolute difference between the two numbers.\"\"\"\n            return abs(self.a - self.b)\n\n    class PairList:\n        \"\"\"Maintains a collection of Pair objects and computes the maximum absolute difference.\"\"\"\n        def __init__(self) -> None:\n            self._pairs: list[Pair] = []\n\n        def add_pair(self, a: float, b: float) -> None:\n            \"\"\"Adds a new pair to the list.\"\"\"\n            self._pairs.append(Pair(a, b))\n\n        def get_max_difference(self) -> float:\n            \"\"\"Computes and returns the maximum absolute difference among all pairs.\"\"\"\n            if not self._pairs:\n                raise ValueError(\"Cannot compute max difference for an empty list of pairs.\")\n\n            max_diff = 0.0\n            for pair in self._pairs:\n                diff = pair.get_difference()\n                if diff > max_diff:\n                    max_diff = diff\n            return max_diff\n\n    pair_list = PairList()\n    for x, y in pairs:\n        pair_list.add_pair(x, y)\n    \n    return pair_list.get_max_difference()"}
