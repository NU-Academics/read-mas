{"task_id": "Mbpp/3", "solution": "import math\n\ndef is_not_prime(n: int) -> bool:\n    \"\"\"Public API. Raises TypeError if n is not an int. Returns True if n is not prime, False if n is prime.\"\"\"\n    _validate_integer(n)\n\n    if n < 2:\n        return True\n\n    return not _is_prime(n)\n\ndef _is_prime(n: int) -> bool:\n    \"\"\"Private helper. Assumes n is int and n >= 2. Returns True if n is prime.\"\"\"\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    for i in range(3, math.isqrt(n) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\n\ndef _validate_integer(n) -> None:\n    \"\"\"Private helper. Raises TypeError if not isinstance(n, int).\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")"}
{"task_id": "Mbpp/7", "solution": "from typing import Set, List\n\nclass InputString:\n    \"\"\"Represents the raw input text string.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\nclass Word:\n    \"\"\"Represents a word token from the input string.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n    def length(self) -> int:\n        return len(self.text)\n\nclass Tokenizer:\n    \"\"\"Splits an input string into tokens based on whitespace.\"\"\"\n    def tokenize(self, text: str) -> List[str]:\n        return text.split()\n\nDEFAULT_MIN_LEN: int = 4\n\nclass Filter:\n    \"\"\"Filters a list of words by a minimum length threshold.\"\"\"\n    def __init__(self, min_len: int = DEFAULT_MIN_LEN):\n        self.min_len = min_len\n    def filter_by_length(self, words: List[str]) -> List[str]:\n        return [w for w in words if len(w) >= self.min_len]\n\nclass ResultSet:\n    \"\"\"Collects unique words and provides them as a set.\"\"\"\n    def __init__(self):\n        self._words: Set[str] = set()\n    def add(self, word: str) -> None:\n        self._words.add(word)\n    def to_set(self) -> Set[str]:\n        return self._words\n\ndef find_char_long(text: str) -> Set[str]:\n    \"\"\"\n    Public API. Orchestrates Tokenizer -> Filter -> ResultSet and returns Set[str].\n    Must not modify 'text'.\n    \"\"\"\n    tokenizer = Tokenizer()\n    tokens = tokenizer.tokenize(text)\n    flt = Filter(DEFAULT_MIN_LEN)\n    filtered = flt.filter_by_length(tokens)\n    rs = ResultSet()\n    for w in filtered:\n        rs.add(w)\n    return rs.to_set()"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"Checks if two numbers differ at exactly one bit position.\"\"\"\n    xor_result = a ^ b\n    # A number has exactly one set bit if it's not zero and (number & (number - 1)) is zero.\n    return xor_result != 0 and (xor_result & (xor_result - 1)) == 0"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(s: str, ch: str) -> str:\n    \"\"\"Remove first and last occurrence of ch from s and return result.\n    Preconditions: s is a str; ch is a str of length 1.\n    \"\"\"\n    if s == \"\":\n        return \"\"\n    count = s.count(ch)\n    if count == 0:\n        return s\n    if count == 1:\n        i = s.find(ch)\n        return s[:i] + s[i+1:]\n    # count >= 2\n    i_first = s.find(ch)\n    i_last = s.rfind(ch)\n    return s[:i_first] + s[i_first+1:i_last] + s[i_last+1:]"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum positive number of rotations required to get the same string.\n    A rotation moves a prefix of k characters to the end.\n    \"\"\"\n    n = len(s)\n\n    # For an empty string, no rotations are possible or needed; return 0 as per returning n.\n    if n == 0:\n        return 0\n\n    def rotate(s_val: str, k_val: int) -> str:\n        \"\"\"Rotates a string by moving the first k characters to the end.\"\"\"\n        return s_val[k_val:] + s_val[:k_val]\n\n    # Iterate through possible rotation values k, from 1 up to n-1.\n    for k in range(1, n):\n        if rotate(s, k) == s:\n            return k\n    \n    # If no rotation 0 < k < n transforms the string into itself,\n    # the minimum positive rotation required is a full rotation, which is n.\n    return n"}
{"task_id": "Mbpp/4", "solution": "class IntegerElement:\n    def __init__(self, value: int):\n        self.value = value\n\nclass InputList:\n    def __init__(self, elements: list[int]):\n        self.elements = [IntegerElement(e) for e in elements]\n\n    def length(self) -> int:\n        return len(self.elements)\n\nclass ResultList:\n    def __init__(self, elements: list[int]):\n        self.elements = [IntegerElement(e) for e in elements]\n\n    def get_raw_elements(self) -> list[int]:\n        return [e.value for e in self.elements]\n\nclass HeapQueueLargest:\n    name: str = \"heap_queue_largest\"\n\n    def execute(self, list_of_integers: list[int], n: int) -> ResultList:\n        # Sort the list in descending order and take the first n elements.\n        sorted_elements = sorted(list_of_integers, reverse=True)\n        top_n_elements = sorted_elements[:n]\n        return ResultList(top_n_elements)\n\ndef heap_queue_largest(list_of_integers: list[int], n: int) -> list[int]:\n    \"\"\"\n    Finds the n largest integers from a given list, returned in descending order.\n    \"\"\"\n    selector = HeapQueueLargest()\n    result_list_obj = selector.execute(list_of_integers, n)\n    return result_list_obj.get_raw_elements()"}
