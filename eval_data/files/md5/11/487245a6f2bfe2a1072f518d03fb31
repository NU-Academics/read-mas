{"task_id": "Mbpp/265", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception raised when validation of n fails.\"\"\"\n    def __init__(self, message: str):\n        \"\"\"Construct ValidationError with message.\"\"\"\n        super().__init__(message)\n\nclass Validator:\n    \"\"\"Utility class to validate input 'n'.\"\"\"\n    def validate_n(self, n):\n        \"\"\"Validate that n is an integer > 0, raising ValidationError if invalid.\"\"\"\n        if not isinstance(n, int):\n            raise ValidationError(\"Input 'n' must be an integer.\")\n        if n <= 0:\n            raise ValidationError(\"Input 'n' must be a positive integer.\")\n\nclass ListSplitter:\n    \"\"\"Handles the core logic of splitting a list into n sublists.\"\"\"\n    def split(self, input_list, n):\n        \"\"\"Return a list of exactly n sublists based on element index modulo n.\"\"\"\n        result = [[] for _ in range(n)]\n        for i, item in enumerate(input_list):\n            result[i % n].append(item)\n        return result\n\ndef list_split(input_list, n):\n    \"\"\"\n    Splits a list into n sublists, placing elements into result[i % n].\n    Validates n and delegates splitting to internal components.\n    \"\"\"\n    validator = Validator()\n    validator.validate_n(n)\n\n    splitter = ListSplitter()\n    return splitter.split(input_list, n)"}
{"task_id": "Mbpp/267", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of the squares of the first n odd natural numbers.\n    Helper classes are nested to satisfy output formatting requirements.\n    \"\"\"\n\n    class OddNumberSequence:\n        \"\"\"Generates sequences of odd natural numbers.\"\"\"\n        def kth(self, k: int) -> int:\n            \"\"\"Returns the k-th odd natural number.\"\"\"\n            return 2 * k - 1\n\n        def generateFirst(self, n_val: int) -> list[int]:\n            \"\"\"Generates a list of the first n_val odd natural numbers.\"\"\"\n            if n_val == 0:\n                return []\n            return [self.kth(i + 1) for i in range(n_val)]\n\n    class Result:\n        \"\"\"A value object to encapsulate an integer result.\"\"\"\n        def __init__(self, value: int) -> None:\n            \"\"\"Initializes the Result object with an integer value.\"\"\"\n            self.value = value\n\n    class SquareSum:\n        \"\"\"Encapsulates the computation of the sum of squares of odd numbers.\"\"\"\n        def compute(self, n_val: int) -> int:\n            \"\"\"Computes the sum of squares of the first n_val odd natural numbers.\"\"\"\n            odd_sequence_gen = OddNumberSequence()\n            odd_numbers = odd_sequence_gen.generateFirst(n_val)\n            sum_of_squares = sum(x**2 for x in odd_numbers)\n            result = Result(sum_of_squares)\n            return result.value\n\n    # No input validation (isinstance/ValueError) as per explicit constraint.\n    # Handles n=0 as specified in the design.\n    if n == 0:\n        return 0\n    \n    calculator = SquareSum()\n    return calculator.compute(n)"}
{"task_id": "Mbpp/261", "solution": "def division_elements(tuple1, tuple2):\n    \"\"\"\n    Performs element-wise division of two tuples after comprehensive validation.\n    \"\"\"\n\n    class LengthMismatchError(Exception):\n        \"\"\"Raised when input tuples have different lengths.\"\"\"\n        pass\n\n    class DivisionByZeroError(Exception):\n        \"\"\"Raised when an element in the divisor tuple is zero.\"\"\"\n        pass\n\n    class TupleInput:\n        \"\"\"A container for an input tuple, as defined in the design.\"\"\"\n        def __init__(self, elements):\n            self.elements = elements\n            self.length = len(elements)\n\n    class TupleElement:\n        \"\"\"A container holding an index and a numeric value.\"\"\"\n        def __init__(self, index, value):\n            self.index = index\n            self.value = value\n\n    class DivisionResult:\n        \"\"\"Stores computed division results and provides a method to return them as a tuple.\"\"\"\n        def __init__(self):\n            self._elements = []\n\n        def append(self, value):\n            self._elements.append(value)\n\n        def as_tuple(self):\n            return tuple(self._elements)\n\n    class DivisionService:\n        \"\"\"Encapsulates validation and computation logic for element-wise tuple division.\"\"\"\n\n        def validate_types(self, t1, t2):\n            if not isinstance(t1, tuple):\n                raise TypeError(\"Input 'tuple1' must be a tuple.\")\n            if not isinstance(t2, tuple):\n                raise TypeError(\"Input 'tuple2' must be a tuple.\")\n\n        def validate_numeric_elements(self, t1, t2):\n            for i, val in enumerate(t1):\n                if not isinstance(val, (int, float)):\n                    raise TypeError(f\"Element at index {i} of 'tuple1' must be numeric (int or float).\")\n            for i, val in enumerate(t2):\n                if not isinstance(val, (int, float)):\n                    raise TypeError(f\"Element at index {i} of 'tuple2' must be numeric (int or float).\")\n\n        def validate_lengths(self, t1, t2):\n            if len(t1) != len(t2):\n                raise LengthMismatchError(\"Input tuples must have the same length.\")\n\n        def validate_no_zero(self, t2):\n            for i, val in enumerate(t2):\n                if val == 0:\n                    raise DivisionByZeroError(f\"Element at index {i} of 'tuple2' is zero, cannot divide by zero.\")\n\n        def division_elements(self, t1, t2) -> tuple:\n            # Perform all validations atomically before any division.\n            self.validate_types(t1, t2)\n            self.validate_numeric_elements(t1, t2)\n            self.validate_lengths(t1, t2)\n            self.validate_no_zero(t2)\n\n            result = DivisionResult()\n            for i in range(len(t1)):\n                result.append(t1[i] / t2[i])\n            return result.as_tuple()\n\n    # Delegate the operation to an instance of the inline-defined DivisionService.\n    return DivisionService().division_elements(tuple1, tuple2)"}
