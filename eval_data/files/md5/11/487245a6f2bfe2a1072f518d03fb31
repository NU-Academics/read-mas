{"task_id": "Mbpp/476", "solution": "def big_sum(values: list) -> Union[int, float]:\n    \"\"\"\n    Calculates the sum of the largest and smallest values in a given array.\n    If the array contains a single element, it returns twice that element.\n    \"\"\"\n    if len(values) == 1:\n        return 2 * values[0]\n    else:\n        smallest = min(values)\n        largest = max(values)\n        return smallest + largest"}
{"task_id": "Mbpp/478", "solution": "def remove_lowercase(input: str) -> str:\n    \"\"\"Removes ASCII lowercase letters 'a'..'z' from the input string.\n    Non-string inputs will raise a TypeError.\n    \"\"\"\n\n    def validate_input(input_val) -> None:\n        \"\"\"Validates that the input is a string.\"\"\"\n        if not isinstance(input_val, str):\n            raise TypeError(\"remove_lowercase expects a str\")\n\n    def is_lowercase_ascii(ch: str) -> bool:\n        \"\"\"Checks if a character is an ASCII lowercase letter.\"\"\"\n        return len(ch) == 1 and 'a' <= ch <= 'z'\n\n    validate_input(input)\n    result_chars = [ch for ch in input if not is_lowercase_ascii(ch)]\n    return ''.join(result_chars)"}
{"task_id": "Mbpp/554", "solution": "def Split(input_list: List[int]) -> List[int]:\n    \"\"\"Return a list of odd integers from input_list, preserving order and duplicates.\n    Precondition: input_list is a list of integers (per SRS). Behavior for non-integers or None is unspecified.\n    \"\"\"\n    result: List[int] = []\n    for n in input_list:\n        if n % 2 != 0:\n            result.append(n)\n    return result"}
{"task_id": "Mbpp/479", "solution": "def first_Digit(n: int) -> int:\n    \"\"\"\n    Finds the first (most significant) digit of a given non-negative number.\n    Raises ValueError if the input number is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n == 0:\n        return 0\n    while n >= 10:\n        n //= 10\n    return n"}
{"task_id": "Mbpp/555", "solution": "def validate_n(n: object) -> None:\n    \"\"\"Validates that n is a positive integer greater than or equal to 1.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be a positive integer >= 1\")\n\ndef compute_sum(n: int) -> int:\n    \"\"\"Calculates the sum of the first n natural numbers using the closed-form formula.\"\"\"\n    return n * (n + 1) // 2\n\ndef compute_sum_cubes(n: int) -> int:\n    \"\"\"Calculates the sum of cubes of the first n natural numbers using the closed-form formula.\"\"\"\n    sum_natural_numbers = n * (n + 1) // 2\n    return sum_natural_numbers ** 2\n\ndef difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    validate_n(n)\n    sum_n = compute_sum(n)\n    sum_cubes_n = compute_sum_cubes(n)\n    return sum_cubes_n - sum_n"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input: str) -> str:\n    \"\"\"\n    Accepts a single argument of type string and returns a new string with each alphabetic character's case toggled.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n    output_chars = []\n    for char in input:\n        if char.isalpha():\n            if char.islower():\n                output_chars.append(char.upper())\n            else:\n                output_chars.append(char.lower())\n        else:\n            output_chars.append(char)\n    return \"\".join(output_chars)"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(array: list[int], n: int) -> int:\n    \"\"\"\n    Counts pairs in the first n elements of an array whose XOR sum is odd.\n    An XOR sum is odd if and only if the two numbers have different parities.\n    \"\"\"\n    def _is_odd(value: int) -> bool:\n        \"\"\"Determines if an integer is odd.\"\"\"\n        return (value & 1) != 0\n\n    def _count_odd_even(arr: list[int], count_n: int) -> tuple[int, int]:\n        \"\"\"Counts odd and even elements in the first count_n elements of an array.\"\"\"\n        odd_count = 0\n        even_count = 0\n        for i in range(count_n):\n            if _is_odd(arr[i]):\n                odd_count += 1\n            else:\n                even_count += 1\n        return odd_count, even_count\n\n    if n < 2:\n        return 0\n\n    n_eff = min(n, len(array))\n    odd_count, even_count = _count_odd_even(array, n_eff)\n    \n    # An XOR sum is odd if one number is odd and the other is even.\n    # The total number of such pairs is odd_count * even_count.\n    return odd_count * even_count"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(input_list):\n    \"\"\"Return an int equal to the maximum len(sublist) for sublist in input_list.\n\n    Args:\n        input_list: list of sublists (each sublist is a list).\n    \"\"\"\n    max_len = 0\n    for sublist in input_list:\n        if len(sublist) > max_len:\n            max_len = len(sublist)\n    return max_len"}
{"task_id": "Mbpp/560", "solution": "def union_elements(t1: tuple, t2: tuple) -> tuple:\n    \"\"\"Compute the set union of elements from two input tuples and return a new tuple with unique elements in ascending order.\n    Returns: tuple of sorted unique elements present in t1 or t2.\n    \"\"\"\n    combined_elements = set(t1).union(set(t2))\n    sorted_elements = sorted(list(combined_elements))\n    return tuple(sorted_elements)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"Calculates the sum of per-digit absolute differences between two integers.\n    Digits are aligned by place value, and missing higher-order digits are treated as 0.\n    Handles negative inputs by operating on their absolute values, achieving O(N) time and O(1) auxiliary space.\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n    total_distance = 0\n\n    while a > 0 or b > 0:\n        digit_a = a % 10\n        digit_b = b % 10\n        total_distance += abs(digit_a - digit_b)\n        a //= 10\n        b //= 10\n\n    return total_distance"}
{"task_id": "Mbpp/559", "solution": "from typing import List\n\ndef max_sub_array_sum(elements: List[int], count: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist in the given list, validating inputs as specified.\n    It uses Kadane's algorithm to compute the maximum subarray sum.\n    \"\"\"\n\n    class InputList:\n        \"\"\"Container for input elements and their expected length.\"\"\"\n        def __init__(self, elements_param: List[int], length_param: int) -> None:\n            self.elements: List[int] = elements_param\n            self.length: int = length_param\n\n    class Subarray:\n        \"\"\"Represents a contiguous subarray with its sum and indices.\"\"\"\n        def __init__(self, start_index: int, end_index: int, total_sum: int) -> None:\n            self.start_index: int = start_index\n            self.end_index: int = end_index\n            self.sum: int = total_sum\n\n    class Result:\n        \"\"\"Holds the computed maximum contiguous subarray sum.\"\"\"\n        def __init__(self, max_sum_val: int) -> None:\n            self.max_sum: int = max_sum_val\n\n    def _validate_input_list(input_list_obj: InputList) -> None:\n        \"\"\"\n        Validates the properties of the InputList instance, raising exceptions for invalid inputs.\n        Checks for non-None list, correct types, non-negative count, matching lengths, and integer elements.\n        \"\"\"\n        if input_list_obj.elements is None:\n            raise TypeError(\"Input 'elements' cannot be None.\")\n        if not isinstance(input_list_obj.elements, list):\n            raise TypeError(\"Input 'elements' must be a list.\")\n        if not isinstance(input_list_obj.length, int):\n            raise TypeError(\"Input 'count' must be an integer.\")\n        if input_list_obj.length < 0:\n            raise ValueError(\"Input 'count' cannot be negative.\")\n        if len(input_list_obj.elements) != input_list_obj.length:\n            raise ValueError(f\"Input 'count' ({input_list_obj.length}) does not match \"\n                             f\"the length of 'elements' ({len(input_list_obj.elements)}).\")\n        for i, element in enumerate(input_list_obj.elements):\n            if not isinstance(element, int):\n                raise TypeError(f\"All elements in 'elements' must be integers. \"\n                                f\"Element at index {i} is of type {type(element).__name__}.\")\n\n    def _compute_max_subarray(input_list_obj: InputList) -> Result:\n        \"\"\"\n        Computes the maximum contiguous subarray sum using Kadane's algorithm, returning a Result object.\n        This handles lists with negative, zero, and positive integers, including all-negative lists.\n        \"\"\"\n        if not input_list_obj.elements:\n            # According to design, count 0 for an empty list means max sum is 0.\n            return Result(0)\n\n        max_so_far = input_list_obj.elements[0]\n        current_max = input_list_obj.elements[0]\n\n        for i in range(1, input_list_obj.length):\n            current_max = max(input_list_obj.elements[i], current_max + input_list_obj.elements[i])\n            max_so_far = max(max_so_far, current_max)\n\n        return Result(max_so_far)\n\n    # Main logic of the max_sub_array_sum function\n    input_list = InputList(elements, count)\n    _validate_input_list(input_list)\n    result = _compute_max_subarray(input_list)\n    return result.max_sum"}
{"task_id": "Mbpp/563", "solution": "import re\nfrom typing import List\n\ndef _find_quoted(input_string: str) -> List[str]:\n    \"\"\"\n    Locates and captures the inner text of double-quoted substrings.\n    Returns a list of captured inner texts in left-to-right order.\n    \"\"\"\n    return re.findall(r'\"([^\"]*)\"', input_string)\n\ndef extract_values(input: str) -> List[str]:\n    \"\"\"\n    Extracts values between quotation marks from a string.\n    Returns an ordered list of the extracted values, or an empty list if none are found.\n    \"\"\"\n    return _find_quoted(input)"}
{"task_id": "Mbpp/564", "solution": "def count_Pairs(arr, n) -> int:\n    \"\"\"Compute count of unordered index pairs (i, j) with 0 <= i < j < n and arr[i] != arr[j].\n    Preconditions: arr is a list-like of ints, and caller ensures 0 <= n <= len(arr).\n    \"\"\"\n    count = 0\n    for i in range(n):\n        for j in range(i + 1, n):\n            if arr[i] != arr[j]:\n                count += 1\n    return count"}
