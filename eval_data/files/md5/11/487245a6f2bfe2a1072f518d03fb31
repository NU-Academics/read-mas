{"task_id": "Mbpp/799", "solution": "def left_rotate(n: int, d: int) -> int:\n    \"\"\"Return n left-rotated by d bits within the 32-bit unsigned domain.\"\"\"\n\n    # Define MASK and helper functions inline as required by the design context.\n    MASK = 0xFFFFFFFF\n\n    def normalize(d_val: int) -> int:\n        \"\"\"Returns d_val modulo 32.\"\"\"\n        return d_val % 32\n\n    def toUint32(n_val: int) -> int:\n        \"\"\"Applies a 32-bit mask to n_val.\"\"\"\n        return n_val & MASK\n\n    def shiftLeft(n_val: int, d_val: int) -> int:\n        \"\"\"Performs a left bit shift.\"\"\"\n        return n_val << d_val\n\n    def shiftRight(n_val: int, d_val: int) -> int:\n        \"\"\"Performs a right bit shift.\"\"\"\n        return n_val >> d_val\n\n    def or_(a_val: int, b_val: int) -> int:\n        \"\"\"Performs a bitwise OR operation.\"\"\"\n        return a_val | b_val\n\n    # Apply core logic from the design steps.\n    d_mod = normalize(d)\n    n_masked = toUint32(n)\n\n    if d_mod == 0:\n        return n_masked\n\n    left_part = shiftLeft(n_masked, d_mod)\n    right_part = shiftRight(n_masked, 32 - d_mod)\n    combined = or_(left_part, right_part)\n\n    return toUint32(combined)"}
{"task_id": "Mbpp/805", "solution": "def computeSum(sublist):\n    \"\"\"Return numeric sum of elements in sublist. Expects iterable of numbers.\"\"\"\n    return sum(sublist)\n\ndef max_sum_list(lists):\n    \"\"\"Return the sublist from input lists whose sum is strictly greater than all others.\"\"\"\n    if not lists:\n        return []\n\n    max_sum = None\n    max_sublist = None\n\n    for sublist in lists:\n        current_sum = computeSum(sublist)\n        if max_sum is None or current_sum > max_sum:\n            max_sum = current_sum\n            max_sublist = sublist\n            \n    return max_sublist"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers: list) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    The product is even if any number in the list is an even integer (including zero).\n    \"\"\"\n    for num in numbers:\n        # A number makes the product even if it's an integer (or integer-like float) and is even.\n        if num == int(num) and int(num) % 2 == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(n) -> bool:\n    \"\"\"Checks if the given number is a perfect square.\n    Returns True if an integer k exists such that k*k == n.\"\"\"\n    if n < 0:\n        return False\n\n    # Convert n to an integer for square root calculation.\n    # This correctly handles integer values of floats (e.g., 16.0 -> 16).\n    # Non-integer floats (e.g., 10.5 -> 10) are handled by the final comparison.\n    n_as_int = int(n)\n\n    # Calculate the integer square root.\n    # math.isqrt is preferred for performance and correctness with large integers.\n    candidate_root = math.isqrt(n_as_int)\n\n    # Check if the square of the candidate root equals the original number.\n    # This comparison handles both integer and float inputs correctly (e.g., 16 == 16.0 is True).\n    return candidate_root * candidate_root == n"}
