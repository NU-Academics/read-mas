{"task_id": "Mbpp/441", "solution": "class Cube:\n    \"\"\"Represents a cube with a side length and computes its surface area.\"\"\"\n    def __init__(self, size: float) -> None:\n        self.size = size\n\n    def calculateSurfaceArea(self) -> float:\n        \"\"\"Computes the surface area of the cube.\"\"\"\n        return 6 * self.size * self.size\n\nclass SurfaceAreaResult:\n    \"\"\"Holds the computed surface area numeric value.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\ndef surfacearea_cube(size: float) -> float:\n    \"\"\"\n    Calculates the surface area of a cube given its side length.\n    It uses helper classes Cube and SurfaceAreaResult internally.\n    \"\"\"\n    cube = Cube(size)\n    area = cube.calculateSurfaceArea()\n    result = SurfaceAreaResult(area)\n    return result.value"}
{"task_id": "Mbpp/437", "solution": "def remove_odd(input_str: str) -> str:\n    \"\"\"Remove characters at odd positions (1-based) and return string of characters at even positions.\n    Handles empty and single-character inputs by returning an empty string.\n    \"\"\"\n    def _extract_even_positions(value: str) -> str:\n        \"\"\"Return characters at even 1-based indices from value.\"\"\"\n        # 1-based even positions (2, 4, 6, ...) correspond to 0-based indices (1, 3, 5, ...)\n        return value[1::2]\n\n    if len(input_str) < 2:\n        return \"\"\n    return _extract_even_positions(input_str)"}
