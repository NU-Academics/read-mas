{"task_id": "Mbpp/172", "solution": "def count_occurance(input: str) -> int:\n    \"\"\"Return number of non-overlapping occurrences of 'std' in input (case-sensitive).\"\"\"\n    TARGET: str = \"std\" # Defined inline to satisfy helper visibility and 'def' first line.\n\n    class InputString: # Defined inline to satisfy helper visibility and 'def' first line.\n        \"\"\"Lightweight wrapper for input string.\"\"\"\n        def __init__(self, value: str) -> None:\n            self.value = value\n        def length(self) -> int:\n            \"\"\"Returns the length of the wrapped string.\"\"\"\n            return len(self.value)\n\n    class OccurrenceResult: # Defined inline to satisfy helper visibility and 'def' first line.\n        \"\"\"Encapsulates the count of occurrences.\"\"\"\n        def __init__(self, count: int) -> None:\n            self.count = count\n\n    input_obj = InputString(input)\n    count = 0\n    target_len = len(TARGET)\n    i = 0\n    while i <= input_obj.length() - target_len:\n        if input_obj.value[i:i + target_len] == TARGET:\n            count += 1\n            i += target_len  # Advance past the found occurrence for non-overlapping search.\n        else:\n            i += 1\n    \n    result_obj = OccurrenceResult(count)\n    return result_obj.count"}
{"task_id": "Mbpp/170", "solution": "class Element:\n    def __init__(self, value):\n        self.value = value\n\n    def isNumeric(self) -> bool:\n        \"\"\"Returns True if the element's value is an int or float.\"\"\"\n        return isinstance(self.value, (int, float))\n\nclass List:\n    def __init__(self, raw_list):\n        \"\"\"Wraps raw values into Element objects.\"\"\"\n        self.elements = [Element(item) for item in raw_list]\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\n    def __getitem__(self, index) -> Element:\n        \"\"\"Provides indexed access to wrapped Element objects.\"\"\"\n        return self.elements[index]\n\nclass IndexRange:\n    def __init__(self, start_index, end_index):\n        \"\"\"Initializes the index range.\"\"\"\n        self.start_index = start_index\n        self.end_index = end_index\n\n    def isValid(self, listLength) -> bool:\n        \"\"\"Checks if indices are valid integers and within bounds.\"\"\"\n        if not isinstance(self.start_index, int) or not isinstance(self.end_index, int):\n            return False\n        if not (0 <= self.start_index <= self.end_index < listLength):\n            return False\n        return True\n\n    def validate_or_raise(self, listLength) -> None:\n        \"\"\"Raises IndexError if indices are invalid.\"\"\"\n        if not self.isValid(listLength):\n            raise IndexError(\"Indices are out of bounds or invalid.\")\n\nclass Result:\n    def __init__(self, sum_value):\n        \"\"\"A lightweight container for a numeric sum.\"\"\"\n        self.sum = sum_value\n\ndef sum_range_list(list, start_index, end_index):\n    \"\"\"\n    Sums numbers in a list within a specified inclusive index range.\n    Validates indices and element types, raising IndexError or TypeError.\n    \"\"\"\n    wrapped_list = List(list)\n    list_length = len(wrapped_list)\n\n    idx_range = IndexRange(start_index, end_index)\n    idx_range.validate_or_raise(list_length)\n\n    total_sum = 0\n    for i in range(idx_range.start_index, idx_range.end_index + 1):\n        element = wrapped_list[i]\n        if not element.isNumeric():\n            raise TypeError(\"Non-numeric element found in the specified range.\")\n        total_sum += element.value\n    \n    return total_sum"}
{"task_id": "Mbpp/222", "solution": "from typing import Any\n\ndef validate_input(input_tuple) -> None:\n    \"\"\"Validates that the input is a tuple. Raises TypeError if not.\"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"check_type expects a tuple as input\")\n\ndef check_type(input_tuple) -> bool:\n    \"\"\"Checks if all elements in the input tuple have the same data type.\"\"\"\n    validate_input(input_tuple)\n    if len(input_tuple) == 0:\n        return True\n    reference_type = type(input_tuple[0])\n    for elem in input_tuple[1:]:\n        if type(elem) != reference_type:\n            return False\n    return True"}
