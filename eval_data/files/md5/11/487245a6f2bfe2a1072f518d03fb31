{"task_id": "Mbpp/409", "solution": "def min_product_tuple(pairs: list) -> float | int:\n    \"\"\"\n    Calculates the minimum product from pairs of tuples in a given list.\n    Validates input and computes the minimum (a * b) for each (a, b) tuple.\n    \"\"\"\n    class ValidationError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    class TuplePair:\n        def __init__(self, a: float | int, b: float | int) -> None:\n            self.a = a\n            self.b = b\n\n        def product(self) -> float | int:\n            return self.a * self.b\n\n    class TupleList:\n        def __init__(self, raw_pairs: list) -> None:\n            self._raw_pairs = raw_pairs\n            self.pairs: list[TuplePair] = []\n\n        def add(self, pair: TuplePair) -> None:\n            self.pairs.append(pair)\n\n        def validate(self) -> None:\n            if not self._raw_pairs:\n                raise ValidationError(\"Input list cannot be empty.\")\n\n            temp_pairs: list[TuplePair] = []\n            for i, item in enumerate(self._raw_pairs):\n                if not (isinstance(item, tuple) and len(item) == 2):\n                    raise ValidationError(f\"Element at index {i} is not a 2-element tuple.\")\n                \n                a, b = item\n                if not (isinstance(a, (int, float)) and isinstance(b, (int, float))):\n                    raise ValidationError(f\"Elements of tuple at index {i} must be numeric.\")\n                \n                temp_pairs.append(TuplePair(a, b))\n            \n            self.pairs = temp_pairs\n\n    class Result:\n        def __init__(self, min_product: float | int) -> None:\n            self.min_product = min_product\n\n    import math\n\n    class MinProductCalculator:\n        def compute(self, tuple_list: TupleList) -> Result:\n            min_prod = math.inf\n            for pair in tuple_list.pairs:\n                current_product = pair.product()\n                if current_product < min_prod:\n                    min_prod = current_product\n            \n            return Result(min_prod)\n\n    tuple_list = TupleList(pairs)\n    tuple_list.validate()\n\n    calculator = MinProductCalculator()\n    result = calculator.compute(tuple_list)\n\n    return result.min_product"}
{"task_id": "Mbpp/410", "solution": "def min_val(list):\n    \"\"\"\n    Finds the minimum numeric value in a heterogeneous list, ignoring non-numeric elements.\n    Returns None if no numeric elements are present.\n    \"\"\"\n    def _is_numeric(value) -> bool:\n        \"\"\"Returns True if the value is an int or float, but not a bool.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    def _filter_numeric_elements(elements):\n        \"\"\"Yields numeric values from an iterable.\"\"\"\n        for element in elements:\n            if _is_numeric(element):\n                yield element\n\n    numeric_values = list(_filter_numeric_elements(list))\n    if numeric_values:\n        return min(numeric_values)\n    return None"}
