{"task_id": "Mbpp/294", "solution": "import numbers\nfrom typing import Any, List, Union\n\nclass InputList:\n    \"\"\"Wrapper around a Python list.\"\"\"\n    def __init__(self, items: List[Any]):\n        self.items = list(items)\n\nclass Element:\n    \"\"\"Base class for list elements, providing numeric classification.\"\"\"\n    def __init__(self, value: Any):\n        self.value = value\n        self.type_name = type(value).__name__\n\n    def is_numeric(self) -> bool:\n        \"\"\"Checks if the element's value is a number.\"\"\"\n        return isinstance(self.value, numbers.Number)\n\nclass NumericElement(Element):\n    \"\"\"Represents a numeric element from the input list.\"\"\"\n    def __init__(self, value: Union[int, float]):\n        super().__init__(value)\n        self.numeric_value = value\n        self.numeric_type = type(value).__name__\n\n# NonNumericElement is not directly used by max_val, but is part of the domain design\nclass NonNumericElement(Element):\n    \"\"\"Represents a non-numeric element from the input list.\"\"\"\n    def __init__(self, value: Any):\n        super().__init__(value)\n\ndef _filter_numeric(items: InputList) -> List[NumericElement]:\n    \"\"\"Filters an InputList to return only NumericElement instances.\"\"\"\n    numeric_elements = []\n    for item in items.items:\n        element = Element(item)\n        if element.is_numeric():\n            numeric_elements.append(NumericElement(item))\n    return numeric_elements\n\ndef max_val(items: InputList) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list, ignoring non-numeric elements.\n    Raises ValueError if no numeric elements are found.\n    \"\"\"\n    numeric_elements = _filter_numeric(items)\n\n    if not numeric_elements:\n        raise ValueError(\"No numeric elements found in the list.\")\n\n    max_numeric_value = numeric_elements[0].numeric_value\n    for ne in numeric_elements[1:]:\n        if ne.numeric_value > max_numeric_value:\n            max_numeric_value = ne.numeric_value\n\n    return max_numeric_value"}
{"task_id": "Mbpp/296", "solution": "class InversionCounter:\n    \"\"\"\n    Encapsulates the logic for validating input and counting inversions in a list.\n    Uses a merge-sort based approach for efficiency.\n    \"\"\"\n    def get_Inv_Count(self, arr: list) -> int:\n        \"\"\"\n        Validates the input list and delegates to the internal merge-sort\n        function to count inversions.\n        \"\"\"\n        if not isinstance(arr, list):\n            raise TypeError(\"Input must be a list.\")\n        for item in arr:\n            if not isinstance(item, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n\n        # Create a shallow copy to prevent mutation of the original input list.\n        arr_copy = list(arr)\n        \n        _, count = self._merge_sort_and_count(arr_copy)\n        return count\n\n    def _merge_sort_and_count(self, arr_slice: list) -> (list, int):\n        \"\"\"\n        Recursively sorts a slice of the array and counts inversions during the merge step.\n        Returns the sorted slice and the number of inversions within it.\n        \"\"\"\n        n = len(arr_slice)\n        if n <= 1:\n            return arr_slice, 0\n\n        mid = n // 2\n        left_slice, left_inv_count = self._merge_sort_and_count(arr_slice[:mid])\n        right_slice, right_inv_count = self._merge_sort_and_count(arr_slice[mid:])\n\n        merged_arr = []\n        i = j = 0\n        split_inv_count = 0\n\n        while i < len(left_slice) and j < len(right_slice):\n            if left_slice[i] <= right_slice[j]:\n                merged_arr.append(left_slice[i])\n                i += 1\n            else:\n                # If left_slice[i] > right_slice[j], then left_slice[i] forms an inversion\n                # with right_slice[j] and all remaining elements in left_slice.\n                merged_arr.append(right_slice[j])\n                split_inv_count += len(left_slice) - i\n                j += 1\n\n        merged_arr.extend(left_slice[i:])\n        merged_arr.extend(right_slice[j:])\n\n        total_inv_count = left_inv_count + right_inv_count + split_inv_count\n        return merged_arr, total_inv_count\n\n\ndef get_Inv_Count(arr: list) -> int:\n    \"\"\"\n    Counts inversions in an array. An inversion is a pair (i, j) such that i < j and arr[i] > arr[j].\n    Input validation ensures `arr` is a list of integers, raising TypeError otherwise.\n    \"\"\"\n    counter = InversionCounter()\n    return counter.get_Inv_Count(arr)"}
{"task_id": "Mbpp/297", "solution": "from typing import Any, List\n\nclass InputList:\n    def __init__(self, items: List[Any]) -> None:\n        self._items = items\n    def get_items(self) -> List[Any]:\n        return self._items\n\nclass Element:\n    def __init__(self, value: Any) -> None:\n        self.value = value\n    def is_list(self) -> bool:\n        return isinstance(self.value, list)\n\nclass OutputList:\n    def __init__(self) -> None:\n        self.items: List[Any] = []\n    def append(self, element: Any) -> None:\n        self.items.append(element)\n    def extend(self, elements: List[Any]) -> None:\n        self.items.extend(elements)\n    def to_list(self) -> List[Any]:\n        return self.items\n\ndef flatten_list(input_list: List[Any]) -> List[Any]:\n    \"\"\"Flatten nested Python list structures and return a new flat list.\n    This function traverses the input list and recursively flattens nested lists.\n    \"\"\"\n    _input = InputList(input_list)\n    _output = OutputList()\n\n    def _recurse(items: List[Any]) -> None:\n        for it in items:\n            elem = Element(it)\n            if elem.is_list():\n                _recurse(elem.value)\n            else:\n                _output.append(elem.value)\n\n    _recurse(_input.get_items())\n    return _output.to_list()"}
{"task_id": "Mbpp/299", "solution": "class Record:\n    \"\"\"Lightweight data holder representing one validated input tuple (name, value).\"\"\"\n    def __init__(self, name: str, value: int):\n        self.name = name\n        self.value = value\n\nclass AggregateResult:\n    \"\"\"Data holder for output (identifier with highest total and its total).\"\"\"\n    def __init__(self, name: str, total: int):\n        self.name = name\n        self.total = total\n\n    def as_tuple(self) -> tuple:\n        \"\"\"Returns the result as a 2-element tuple.\"\"\"\n        return (self.name, self.total)\n\nclass Aggregator:\n    \"\"\"Encapsulates validation, aggregation-by-name, and selection of the maximum aggregate.\"\"\"\n\n    def _validate_records(self, records: list):\n        \"\"\"Validates the input records list and each record within it.\"\"\"\n        if not records:\n            raise ValueError(\"Input records list cannot be empty.\")\n        \n        for i, record in enumerate(records):\n            if not isinstance(record, (list, tuple)) or len(record) != 2:\n                raise ValueError(f\"Record at index {i} must be a 2-element sequence.\")\n            \n            if not isinstance(record[0], str):\n                raise ValueError(f\"Record name at index {i} must be a string.\")\n            \n            if not isinstance(record[1], int):\n                raise ValueError(f\"Record value at index {i} must be an integer.\")\n\n    def aggregate_by_name(self, records: list) -> dict:\n        \"\"\"Aggregates integer values grouped by name and returns a dictionary.\"\"\"\n        aggregates = {}\n        for name, value in records:\n            aggregates[name] = aggregates.get(name, 0) + value\n        return aggregates\n\n    def find_max(self, aggregates: dict) -> tuple:\n        \"\"\"Finds the name with the highest aggregate total from the given dictionary.\"\"\"\n        if not aggregates:\n            # This case should ideally be caught by _validate_records if initial input was empty.\n            # But for robustness, if somehow aggregate_by_name returns empty.\n            raise ValueError(\"No aggregates to find maximum from.\")\n\n        max_name = max(aggregates, key=aggregates.get)\n        max_total = aggregates[max_name]\n        return (max_name, max_total)\n\n    def max_aggregate(self, records: list) -> tuple:\n        \"\"\"Validates input list and each record, aggregates values, finds the maximum, and returns the result.\"\"\"\n        self._validate_records(records)\n        \n        # At this point, records are validated. We can construct Records if needed, \n        # but for aggregation, direct use is efficient.\n        # Design mentioned Record as a data holder, not strictly required for this path, \n        # but could be used to encapsulate validation results if needed later.\n        \n        aggregated_data = self.aggregate_by_name(records)\n        \n        max_name, max_total = self.find_max(aggregated_data)\n        \n        result_object = AggregateResult(max_name, max_total)\n        return result_object.as_tuple()\n\ndef max_aggregate(records: list) -> tuple:\n    \"\"\"\n    Calculates the maximum aggregate from a list of tuples.\n    Each tuple should be (name: str, value: int).\n    \"\"\"\n    aggregator = Aggregator()\n    return aggregator.max_aggregate(records)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(d: dict) -> int:\n    \"\"\"Compute dictionary depth recursively.\n    Raises TypeError if input is not a dictionary.\n    \"\"\"\n    if not isinstance(d, dict):\n        raise TypeError(\"dict_depth expects a dict input\")\n\n    if not d:\n        return 1\n\n    child_depths = [dict_depth(v) for v in d.values() if isinstance(v, dict)]\n\n    if not child_depths:\n        return 1\n    return 1 + max(child_depths)"}
{"task_id": "Mbpp/305", "solution": "```python\ndef start_withp(input_list):\n    \"\"\"\n    Scans a list of strings for the first two words starting with 'p' or 'P'.\n    Assumes at least two such words are present in the input.\n    \"\"\"\n    matches = []\n    for line_text in input_list:\n        for word_text in line_text.split():\n            if len(word_text) > 0 and word_text[0].lower() == 'p':\n                matches.append(word_text)\n                if len(matches) == 2:\n                    return (matches[0], matches[1])\n```"}
{"task_id": "Mbpp/300", "solution": "def count_binary_seq(n) -> int:\n    \"\"\"Validate n and return C(2n, n) as int.\n    Raises TypeError if n is not an integer, or ValueError if n < 0.\n    \"\"\"\n\n    class ValidationService:\n        @staticmethod\n        def validateInteger(value) -> None:\n            if not isinstance(value, int):\n                raise TypeError(\"Input must be an integer.\")\n\n        @staticmethod\n        def validateNonNegative(value) -> None:\n            if value < 0:\n                raise ValueError(\"Input must be non-negative.\")\n\n    class CombinatoricsCalculator:\n        @staticmethod\n        def centralBinomialCoefficient(value) -> int:\n            \"\"\"Compute and return C(2n, n) exactly using integer arithmetic.\"\"\"\n            if value == 0:\n                return 1\n            result = 1\n            for k in range(1, value + 1):\n                result = result * (value + k) // k\n            return result\n\n    ValidationService.validateInteger(n)\n    ValidationService.validateNonNegative(n)\n    \n    return CombinatoricsCalculator.centralBinomialCoefficient(n)"}
{"task_id": "Mbpp/309", "solution": "from typing import Union\n\ndef maximum(a: Union[int, float], b: Union[int, float]) -> Union[int, float]:\n    \"\"\"Finds the maximum of two numbers.\n    Assumes inputs are numeric (int or float).\"\"\"\n    return a if a >= b else b"}
{"task_id": "Mbpp/310", "solution": "def string_to_tuple(s: str) -> tuple:\n    \"\"\"Return a tuple of single-character strings derived from s, excluding ASCII space ' '.\n    The function iterates through the input string, filtering out ASCII space characters and preserving order.\"\"\"\n    return tuple(char for char in s if char != ' ')"}
{"task_id": "Mbpp/306", "solution": "from typing import List\n\nclass ArrayInput:\n    \"\"\"Data holder for input array and indices.\"\"\"\n    def __init__(self, arr: List[int], n: int, i: int, k: int) -> None:\n        self.arr = arr\n        self.n = n\n        self.i = i\n        self.k = k\n\nclass SubsequenceCandidate:\n    \"\"\"Represents a potential increasing subsequence with its elements, indices, and sum.\"\"\"\n    def __init__(self, elements: List[int], indices: List[int]) -> None:\n        self.elements = elements\n        self.indices = indices\n        self.sum = sum(elements)\n\nclass Result:\n    \"\"\"Container for the final integer result value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass Validator:\n    \"\"\"Enforces input preconditions for the max_sum_increasing_subseq function.\"\"\"\n    @staticmethod\n    def validate(arr: List[int], n: int, i: int, k: int) -> None:\n        \"\"\"Raises ValueError if inputs are invalid according to specified rules.\"\"\"\n        if not (0 <= i < n and 0 <= k < n and k > i and len(arr) == n):\n            raise ValueError(\"Invalid input parameters: n must match len(arr), 0 <= i < n, 0 <= k < n, and k > i.\")\n\n\ndef max_sum_increasing_subseq(arr, n, i, k):\n    \"\"\"\n    Return int: maximum sum of strictly increasing subsequence composed only of arr[0..i] and arr[k], including arr[k].\n    \"\"\"\n    Validator.validate(arr, n, i, k)\n\n    # dp[j] stores the maximum sum of an increasing subsequence ending at index j\n    # using elements from arr[0...j]. We only consider the prefix arr[0...i].\n    dp = [0] * (i + 1)\n\n    # Compute dp sums for the prefix arr[0...i]\n    for j in range(i + 1):\n        dp[j] = arr[j]  # An element itself forms an increasing subsequence of sum arr[j]\n        for p in range(j):\n            if arr[j] > arr[p]:\n                dp[j] = max(dp[j], dp[p] + arr[j])\n\n    # Find the maximum sum from dp[0...i] such that arr[j] < arr[k]\n    max_prefix_sum_ending_before_k = 0\n    found_eligible_prefix_element = False\n\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            max_prefix_sum_ending_before_k = max(max_prefix_sum_ending_before_k, dp[j])\n            found_eligible_prefix_element = True\n\n    # Calculate the final result value\n    if found_eligible_prefix_element:\n        final_sum = max_prefix_sum_ending_before_k + arr[k]\n    else:\n        # If no element in arr[0...i] is smaller than arr[k],\n        # then the subsequence can only include arr[k] itself.\n        final_sum = arr[k]\n\n    # The design specifies \"MaxSumFunction ... produces a Result.\"\n    # and \"Result -> Caller: return int value\".\n    return Result(final_sum).value"}
{"task_id": "Mbpp/308", "solution": "import collections.abc\nimport numbers\n\nclass ValidationException(Exception):\n    \"\"\"Exception raised for invalid inputs during validation.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass Validator:\n    \"\"\"Validates inputs for the large_product function according to design.\"\"\"\n    def validateLists(self, list1, list2) -> None:\n        if not isinstance(list1, collections.abc.Iterable):\n            raise ValidationException(\"Input list1 must be an iterable.\")\n        if not isinstance(list2, collections.abc.Iterable):\n            raise ValidationException(\"Input list2 must be an iterable.\")\n        \n        for i, item in enumerate(list1):\n            if not isinstance(item, numbers.Number):\n                raise ValidationException(f\"Element at index {i} in list1 is not a number.\")\n        for i, item in enumerate(list2):\n            if not isinstance(item, numbers.Number):\n                raise ValidationException(f\"Element at index {i} in list2 is not a number.\")\n\n    def validateK(self, k) -> None:\n        if not isinstance(k, int):\n            raise ValidationException(\"k must be an integer.\")\n        if k < 0:\n            raise ValidationException(\"k must be a non-negative integer.\")\n\ndef large_product(list1, list2, k):\n    \"\"\"\n    Finds the specified number of largest products from two lists, selecting one factor from each.\n    Validates inputs and returns a sorted list of products.\n    \"\"\"\n    validator = Validator()\n    validator.validateLists(list1, list2)\n    validator.validateK(k)\n\n    if k == 0 or not list1 or not list2:\n        return []\n\n    products = []\n    for a in list1:\n        for b in list2:\n            products.append(a * b)\n\n    products.sort(reverse=True)\n    return products[:k]"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n) -> int:\n    \"\"\"Sets the most significant unset bit in n's binary representation.\"\"\"\n    highest_bit = n.bit_length()\n    mask = (1 << highest_bit) - 1\n    unset = (~n) & mask\n\n    if unset != 0:\n        pos = unset.bit_length() - 1\n    else:\n        pos = highest_bit\n    \n    return n | (1 << pos)"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"Finds the highest power of 2 that is less than or equal to n, for n >= 1.\"\"\"\n    return 1 << (n.bit_length() - 1)"}
{"task_id": "Mbpp/312", "solution": "import math\n\ndef volume_cone(radius, height):\n    \"\"\"Calculate the volume of a cone given its radius and height.\n    The volume is computed using the formula (1/3) * \u03c0 * radius^2 * height.\n    \"\"\"\n    volume = (1/3) * math.pi * (radius ** 2) * height\n    return float(volume)"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n):\n    \"\"\"\n    Compute and return the nth Lucas number (L(n)) as an int.\n    Raises ValueError for invalid input (non-integer or negative).\n    \"\"\"\n    # Validate input as per the design context.\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    # Handle base cases for Lucas numbers.\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    # Compute Lucas numbers iteratively for n >= 2 to avoid recursion.\n    a, b = 2, 1  # Initialize with L(0) and L(1)\n    for _ in range(2, n + 1):\n        a, b = b, a + b  # Calculate the next Lucas number in the sequence\n    return b"}
{"task_id": "Mbpp/390", "solution": "from typing import List, Any\n\ndef _validate_input_types(input_list: Any, format_string: Any) -> None:\n    \"\"\"Validates the types of the input list and format string.\n    Raises TypeError if types are invalid.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list.\")\n    if not isinstance(format_string, str):\n        raise TypeError(\"format_string must be a string.\")\n\ndef _stringify_element(element: Any) -> str:\n    \"\"\"Converts any element to its string representation.\"\"\"\n    return str(element)\n\ndef _apply_format(template: str, element_str: str) -> str:\n    \"\"\"Applies the format string template to a stringified element.\"\"\"\n    return template.format(element_str)\n\ndef add_string(input_list: List[Any], format_string: str) -> List[str]:\n    \"\"\"Applies a format string to each element in a list, returning a new list of formatted strings.\n    The original input_list is not mutated, and a TypeError is raised for invalid input types.\n    Example: add_string([1,2,3,4], 'temp{0}') returns ['temp1', 'temp2', 'temp3', 'temp4'].\n    \"\"\"\n    _validate_input_types(input_list, format_string)\n\n    formatted_elements = []\n    for element in input_list:\n        element_str = _stringify_element(element)\n        formatted_str = _apply_format(format_string, element_str)\n        formatted_elements.append(formatted_str)\n\n    return formatted_elements"}
{"task_id": "Mbpp/394", "solution": "def check_distinct(input_tuple: tuple) -> bool:\n    \"\"\"Return True if input_tuple contains no duplicates, otherwise False. Does not mutate input_tuple.\n    This implementation relies on elements being hashable; unhashable elements will raise a TypeError.\"\"\"\n    seen = set()\n    for element in input_tuple:\n        if element in seen:\n            return False\n        seen.add(element)\n    return True"}
{"task_id": "Mbpp/392", "solution": "class ValidationError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass MemoizationCache:\n    def __init__(self) -> None:\n        self._entries: dict[int, int] = {}\n\n    def contains(self, key: int) -> bool:\n        return key in self._entries\n\n    def get(self, key: int) -> int:\n        return self._entries[key]\n\n    def set(self, key: int, value: int) -> None:\n        self._entries[key] = value\n\nclass GetMaxSum:\n    def __init__(self, cache: MemoizationCache) -> None:\n        self._cache = cache\n\n    def get_max_sum(self, n: int) -> int:\n        if n == 0:\n            return 0  # Base case for the recurrence relation.\n        if self._cache.contains(n):\n            return self._cache.get(n)\n\n        # Compute arguments for recursive calls using integer floor division.\n        sum_f_parts = (self.get_max_sum(n // 2) +\n                       self.get_max_sum(n // 3) +\n                       self.get_max_sum(n // 4) +\n                       self.get_max_sum(n // 5))\n        \n        result = max(sum_f_parts, n)\n        self._cache.set(n, result)\n        return result\n\n_MODULE_CACHE = MemoizationCache()\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Computes the maximum sum f(n) based on the given recurrence relation f(n) = max(sum, n).\n    The function uses memoization and validates that n is a non-negative integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValidationError(\"n must be an integer\")\n    if n < 0:\n        raise ValidationError(\"n must be non-negative\")\n\n    # Delegates the actual computation to an instance of GetMaxSum, using the module-scoped cache.\n    return GetMaxSum(_MODULE_CACHE).get_max_sum(n)"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(*lists) -> list:\n    \"\"\"\n    Converts multiple lists into a list of nested dictionaries.\n    The first list provides top-level keys, intermediate lists provide nested keys, and the last list provides values.\n    \"\"\"\n    all_lists = list(lists)\n\n    # Validate that all input lists have identical length.\n    # The design assumes at least two lists are provided and raises ValueError for length mismatch.\n    first_list_length = len(all_lists[0])\n    for lst in all_lists:\n        if len(lst) != first_list_length:\n            raise ValueError(\"Input lists must all have the same length.\")\n\n    # If the first list is empty (and others are empty due to validation), return an empty list.\n    if first_list_length == 0:\n        return []\n\n    result = []\n    num_lists = len(all_lists)\n\n    for i in range(first_list_length):\n        top_key = all_lists[0][i]\n        \n        # Initialize the innermost value of the nested structure from the last list.\n        current_nested_structure = all_lists[num_lists - 1][i]\n        \n        # Iterate from the second-to-last list down to the second list (index 1).\n        # These lists provide the keys to build the nested dictionary structure outwards.\n        for k_idx in range(num_lists - 2, 0, -1):\n            key_for_level = all_lists[k_idx][i]\n            current_nested_structure = {key_for_level: current_nested_structure}\n            \n        # Append the top-level dictionary for the current index.\n        result.append({top_key: current_nested_structure})\n\n    return result"}
{"task_id": "Mbpp/397", "solution": "class InputValidationError(Exception):\n    \"\"\"Exception raised for invalid input types.\"\"\"\n    pass\n\ndef median_numbers(a, b, c) -> float:\n    \"\"\"Compute the median of three numeric values and return it as a float.\n\n    Raises:\n        InputValidationError: if any of a, b, or c is not an int or float.\n    \"\"\"\n    for arg in [a, b, c]:\n        if not isinstance(arg, (int, float)):\n            raise InputValidationError(f\"All inputs must be numeric (int or float), but got {type(arg).__name__}.\")\n\n    numbers = [float(a), float(b), float(c)]\n    numbers.sort()\n    return numbers[1]"}
{"task_id": "Mbpp/398", "solution": "from typing import List\n\nclass Digit:\n    \"\"\"Value object for a single decimal digit (0-9).\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass NumberItem:\n    \"\"\"Represents a single integer and provides digit decomposition/absolute value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def abs_value(self) -> int:\n        \"\"\"Returns the absolute value of the number.\"\"\"\n        return abs(self.value)\n\n    def digits(self) -> List[int]:\n        \"\"\"Returns a list of base-10 digits of the absolute value.\"\"\"\n        if self.abs_value() == 0:\n            return [0]\n        return [int(d) for d in str(self.abs_value())]\n\nclass InputList:\n    \"\"\"Wraps a provided list of numbers and validates its collection.\"\"\"\n    def __init__(self, numbers: List[int]) -> None:\n        self.numbers = numbers\n\n    def validate(self) -> bool:\n        \"\"\"Validates the input list, raising TypeError on invalid input.\"\"\"\n        if not isinstance(self.numbers, list):\n            raise TypeError(\"Input must be a list.\")\n        for item in self.numbers:\n            if not isinstance(item, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n        return True\n\nclass SumResult:\n    \"\"\"Container for the resulting total sum of digits.\"\"\"\n    def __init__(self, total: int) -> None:\n        self.total = total\n\nclass SumOperation:\n    \"\"\"Stateless compute operation to sum digits from an InputList.\"\"\"\n    def compute(self, input_list_obj: InputList) -> int:\n        \"\"\"Computes the total sum of digits for all numbers in the InputList.\"\"\"\n        total_sum = 0\n        for number_value in input_list_obj.numbers:\n            number_item = NumberItem(number_value)\n            total_sum += sum(number_item.digits())\n        return total_sum\n\ndef sum_of_digits(input_list: List[int]) -> int:\n    \"\"\"\n    Computes the sum of digits of each number of a given list.\n    Negative numbers' digits are summed based on their absolute value.\n    \"\"\"\n    input_list_obj = InputList(input_list)\n    input_list_obj.validate()\n\n    sum_op = SumOperation()\n    computed_total = sum_op.compute(input_list_obj)\n\n    sum_result = SumResult(computed_total)\n    return sum_result.total"}
{"task_id": "Mbpp/404", "solution": "def minimum(a, b):\n    \"\"\"\n    Return the smaller of two numeric inputs (int or float). If equal, return the equal value.\n    \"\"\"\n    return a if a <= b else b"}
{"task_id": "Mbpp/395", "solution": "from typing import Optional, Dict\n\nclass InputString:\n    \"\"\"Domain value object representing the provided input string.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n        self.length = len(value)\n\nclass CharacterFrequencyMap:\n    \"\"\"Builds and holds character frequency counts and provides lookup for first non-repeating character.\"\"\"\n    def __init__(self) -> None:\n        self.frequencies: Dict[str, int] = {}\n        self.first_positions: Dict[str, int] = {}\n\n    def build(self, input_str: str) -> None:\n        \"\"\"Populates frequency and first position maps for the given string.\"\"\"\n        for i, char in enumerate(input_str):\n            self.frequencies[char] = self.frequencies.get(char, 0) + 1\n            if char not in self.first_positions:\n                self.first_positions[char] = i\n\n    def getFirstNonRepeating(self, input_str: str) -> Optional[str]:\n        \"\"\"Returns the first non-repeating character from the original input string order.\"\"\"\n        for char in input_str:\n            if self.frequencies[char] == 1:\n                return char\n        return None\n\nclass Result:\n    \"\"\"Domain value object encapsulating the return result.\"\"\"\n    def __init__(self, value: Optional[str]) -> None:\n        self.value = value\n\nclass FirstNonRepeatingFunction:\n    \"\"\"Orchestrates computing the first non-repeating character.\"\"\"\n    def execute(self, input_str: str) -> Optional[str]:\n        \"\"\"Executes the logic to find the first non-repeating character in the input string.\"\"\"\n        input_obj = InputString(input_str)\n        freq_map = CharacterFrequencyMap()\n        freq_map.build(input_str)\n        char_or_none = freq_map.getFirstNonRepeating(input_str)\n        result_obj = Result(char_or_none)\n        return result_obj.value\n\ndef first_non_repeating_character(input: str) -> Optional[str]:\n    \"\"\"Finds the first non-repeated character in a given string.\"\"\"\n    return FirstNonRepeatingFunction().execute(input)"}
