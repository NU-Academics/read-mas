{"task_id": "Mbpp/751", "solution": "class Array:\n    \"\"\"Wrapper around a list to provide read-only access.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self._elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self._elements)\n\n    def get(self, index: int):\n        \"\"\"Returns the element at the specified index.\"\"\"\n        return self._elements[index]\n\nclass Node:\n    \"\"\"Represents a heap node, providing index and child index calculations.\"\"\"\n    def __init__(self, index: int, array: Array) -> None:\n        self.index = index\n        self.value = array.get(index)\n\n    def left_index(self) -> int:\n        \"\"\"Computes the index of the left child.\"\"\"\n        return 2 * self.index + 1\n\n    def right_index(self) -> int:\n        \"\"\"Computes the index of the right child.\"\"\"\n        return 2 * self.index + 2\n\nclass HeapCheck:\n    \"\"\"Stateless service for validating min-heap property.\"\"\"\n    @staticmethod\n    def check_min_heap(array: list) -> bool:\n        \"\"\"\n        Checks if the given list represents a min-heap by iterating through parent nodes\n        and comparing their values with their children's.\n        \"\"\"\n        wrapped_array = Array(array)\n        n = wrapped_array.length()\n\n        if n <= 1:\n            return True\n\n        # Iterate only through parent nodes. The last parent is at index floor(n/2) - 1.\n        for i in range(n // 2):\n            parent_node = Node(i, wrapped_array)\n            parent_value = parent_node.value\n\n            left_child_idx = parent_node.left_index()\n            if left_child_idx < n:\n                left_child_value = wrapped_array.get(left_child_idx)\n                if parent_value > left_child_value:\n                    return False\n\n            right_child_idx = parent_node.right_index()\n            if right_child_idx < n:\n                right_child_value = wrapped_array.get(right_child_idx)\n                if parent_value > right_child_value:\n                    return False\n        \n        return True\n\ndef check_min_heap(array) -> bool:\n    \"\"\"\n    Checks if the given array (list) represents a min-heap.\n    Delegates the actual check to the HeapCheck component.\n    \"\"\"\n    return HeapCheck.check_min_heap(array)"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Inserts spaces between words starting with capital letters in the given string.\n    A space is inserted if an uppercase letter is preceded by a lowercase letter,\n    or if an uppercase letter is preceded by another uppercase letter and followed by a lowercase letter.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    output_parts = []\n    \n    for i, char in enumerate(input_string):\n        insert_space = False\n        \n        if i == 0:\n            output_parts.append(char)\n            continue\n            \n        prev_char = input_string[i-1]\n        \n        # Rule (a): uppercase letter immediately preceded by a lowercase letter\n        if char.isupper() and prev_char.islower():\n            insert_space = True\n        # Rule (b): uppercase letter immediately preceded by another uppercase letter\n        # AND immediately followed by a lowercase letter.\n        elif char.isupper() and prev_char.isupper():\n            if i + 1 < len(input_string): # Check if next_char exists\n                next_char = input_string[i+1]\n                if next_char.islower():\n                    insert_space = True\n                    \n        if insert_space:\n            output_parts.append(' ')\n        output_parts.append(char)\n            \n    return \"\".join(output_parts)"}
{"task_id": "Mbpp/754", "solution": "from typing import Any, List\n\ndef extract_index_list(l1: List[Any], l2: List[Any], l3: List[Any]) -> List[Any]:\n    \"\"\"Finds elements common to three lists at the same index.\"\"\"\n    min_length = min(len(l1), len(l2), len(l3))\n    common_elements = []\n\n    for i in range(min_length):\n        if l1[i] == l2[i] == l3[i]:\n            common_elements.append(l1[i])\n            \n    return common_elements"}
{"task_id": "Mbpp/753", "solution": "def _validate_input(input_list, k):\n    \"\"\"Validates the input_list and k parameters according to design specifications.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input 'input_list' must be a list.\")\n    if not isinstance(k, int):\n        raise TypeError(\"Input 'k' must be an integer.\")\n\n    for i, item in enumerate(input_list):\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise TypeError(f\"List element at index {i} must be a 2-element tuple.\")\n        if not isinstance(item[1], (int, float)):\n            raise TypeError(f\"Second element of tuple at index {i} must be numeric.\")\n\ndef min_k(input_list, k):\n    \"\"\"\n    Finds the minimum k records from a list of tuples, sorted by the second tuple element.\n    It returns up to k records sorted ascending by numeric value.\n    \"\"\"\n    _validate_input(input_list, k)\n\n    if not input_list or k <= 0:\n        return []\n\n    # Sort the list stably by the second element of each tuple\n    sorted_list = sorted(input_list, key=lambda t: t[1])\n\n    # Return the full sorted list if k is greater than or equal to its length\n    if k >= len(sorted_list):\n        return sorted_list\n    else:\n        # Otherwise, return the first k elements\n        return sorted_list[:k]"}
{"task_id": "Mbpp/752", "solution": "class InvalidInputError(Exception):\n    \"\"\"Exception for invalid input values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self) -> str:\n        return self.message\n\n\nclass InputValidator:\n    \"\"\"Validates input to ensure it is a non-negative integer.\"\"\"\n    def validate(self, n: int) -> None:\n        if not isinstance(n, int):\n            raise InvalidInputError(\"Input must be an integer.\")\n        if n < 0:\n            raise InvalidInputError(\"Input must be a non-negative integer.\")\n\n\nclass JacobsthalSequence:\n    \"\"\"Computes Jacobsthal numbers using an iterative method with memoization.\"\"\"\n    def __init__(self) -> None:\n        self._cache: dict[int, int] = {0: 0, 1: 1}\n\n    def compute(self, n: int) -> int:\n        if n in self._cache:\n            return self._cache[n]\n\n        # Iteratively compute values from the largest cached index up to n.\n        max_cached_idx = max(self._cache.keys())\n        for i in range(max_cached_idx + 1, n + 1):\n            j_i_minus_1 = self._cache[i - 1]\n            j_i_minus_2 = self._cache[i - 2]\n            self._cache[i] = j_i_minus_1 + 2 * j_i_minus_2\n            \n        return self._cache[n]\n\n\ndef jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Computes the nth Jacobsthal number.\n    Validates input and uses a memoized sequence calculation.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate(n)\n    \n    seq = JacobsthalSequence()\n    return seq.compute(n)"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(input_list):\n    \"\"\"Convert each sublist in input_list to a tuple, count occurrences, and return dict mapping tuple->int.\n\n    Preconditions: input_list is a Python list whose elements are lists (per SRS).\n    Postconditions: Returns a dict with keys of type tuple and values of type int.\n    \"\"\"\n    counts = {}\n    for sublist in input_list:\n        key = tuple(sublist)\n        counts[key] = counts.get(key, 0) + 1\n    return counts"}
