{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list):\n    \"\"\"Flattens a list recursively and sums all its numeric elements.\"\"\"\n\n    def accumulate_sum(current_list, current_accumulator):\n        \"\"\"Recursively adds non-list elements to an accumulator.\"\"\"\n        for item in current_list:\n            if isinstance(item, list):\n                current_accumulator = accumulate_sum(item, current_accumulator)\n            else:\n                current_accumulator += item\n        return current_accumulator\n\n    return accumulate_sum(input_list, 0)"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(arr: list) -> bool:\n    \"\"\"Return True if arr is monotonic (non-increasing or non-decreasing). Does not modify arr.\"\"\"\n    is_non_decreasing = True\n    is_non_increasing = True\n\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            is_non_decreasing = False\n        if arr[i] > arr[i-1]:\n            is_non_increasing = False\n        \n        # Optimization: if both flags become False, we can exit early\n        if not is_non_decreasing and not is_non_increasing:\n            return False\n\n    return is_non_decreasing or is_non_increasing"}
{"task_id": "Mbpp/70", "solution": "def _is_list_of_tuples(obj) -> bool:\n    \"\"\"Checks if the given object is a list where every element is a tuple.\"\"\"\n    if not isinstance(obj, list):\n        return False\n    for elem in obj:\n        if not isinstance(elem, tuple):\n            return False\n    return True\n\ndef get_equal(tuple_list: list[tuple]) -> bool:\n    \"\"\"\n    Checks if all tuples in the given list have equal length.\n    Raises TypeError if the input is not a list of tuples.\n    \"\"\"\n    if not _is_list_of_tuples(tuple_list):\n        raise TypeError(\"Input must be a list where every element is a tuple.\")\n\n    if not tuple_list:\n        return True  # An empty list vacuously has all tuples of equal length\n\n    first_length = len(tuple_list[0])\n    for tup in tuple_list:\n        if len(tup) != first_length:\n            return False\n    return True"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(container: list, sublist: list) -> bool:\n    \"\"\"Checks if a list contains the given sublist as a contiguous subsequence.\n    Returns True if found, False otherwise.\"\"\"\n    n = len(container)\n    m = len(sublist)\n\n    for i in range(n - m + 1):\n        if container[i : i + m] == sublist:\n            return True\n    return False"}
