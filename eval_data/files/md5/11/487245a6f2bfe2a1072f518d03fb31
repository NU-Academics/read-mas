{"task_id": "Mbpp/414", "solution": "```python\nfrom typing import Iterable, Any, Optional, Tuple\n\ndef _is_hashable(obj) -> bool:\n    \"\"\"Return True if obj is hashable, False otherwise.\"\"\"\n    try:\n        hash(obj)\n        return True\n    except TypeError:\n        return False\n\ndef _convert_to_set_if_safe(iterable) -> Optional[set]:\n    \"\"\"Return a set copy of iterable if conversion is safe (elements hashable); return None if not safe. Does not mutate input.\"\"\"\n    temp_list = list(iterable) # Convert to list to iterate multiple times if needed and check hashability\n    if not all(_is_hashable(item) for item in temp_list):\n        return None\n    return set(temp_list)\n\ndef _iterative_overlap_check(iter1, iter2) -> bool:\n    \"\"\"Fallback overlap check performing iteration and equality checks when set-based optimization is not possible.\"\"\"\n    # Convert iterators to lists to allow multiple passes for the nested loop if inputs are true iterators\n    list1 = list(iter1)\n    list2 = list(iter2)\n    for item1 in list1:\n        for item2 in list2:\n            if item1 == item2:\n                return True\n    return False\n\ndef overlapping(seq1, seq2) -> bool:\n    \"\"\"Public API per SRS: overlapping(seq1, seq2) -> bool\n    Accepts iterables (list/tuple/set or other iterable). Returns True if any element from seq1 equals any element from seq2 using == semantics; otherwise False. Does not mutate inputs.\"\"\"\n    \n    set1 = _convert_to_set_if_safe(seq1)\n    set2 = _convert_to_set_if_safe(seq2)\n\n    if set1 is not None and set2 is not None:\n        return bool(set1.intersection(set2))\n    elif set1 is not None:\n        # Iterate through seq2, check membership in set1\n        for item2 in seq2:\n            if item2 in set1:\n                return True\n        return False\n    elif set2 is not None:\n        # Iterate through seq1, check membership in set2\n        for item1 in seq1:\n            if item1 in set2:\n                return True\n        return False\n    else:\n        # Neither sequence can be safely converted to a set\n        return _iterative_overlap_check(seq1, seq2)\n```"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(input_list):\n    \"\"\"\n    Finds the element in a list that has the maximum length.\n    Raises TypeError if input is not a list or elements are not len-compatible; raises ValueError if list is empty.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Find_Max: input must be a list\")\n\n    if not input_list:\n        raise ValueError(\"Find_Max: input list must not be empty\")\n\n    max_element = input_list[0]\n    max_len = len(max_element)  # This will raise TypeError if the first element is not len()-compatible\n\n    for element in input_list[1:]:\n        current_len = len(element)  # This will raise TypeError if an element is not len()-compatible\n        if current_len > max_len:\n            max_len = current_len\n            max_element = element\n\n    return max_element"}
{"task_id": "Mbpp/415", "solution": "from typing import List, Tuple\n\ndef max_Product(nums: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    Finds a pair of numbers from the input list with the highest product.\n    The two numbers must come from distinct indices in the list.\n    \"\"\"\n\n    def _validate_input(nums_list: List[int]) -> None:\n        \"\"\"Ensures the input list contains at least two integers.\"\"\"\n        if len(nums_list) < 2:\n            raise ValueError(\"nums must contain at least two integers\")\n\n    def _find_max_pair(nums_list: List[int]) -> Tuple[int, int]:\n        \"\"\"\n        Identifies the pair of numbers with the maximum product, ensuring distinct indices.\n        It tracks the two largest and two smallest numbers in a single pass.\n        \"\"\"\n        # Track the two largest numbers and their indices (value, index)\n        max1_val, max1_idx = float('-inf'), -1\n        max2_val, max2_idx = float('-inf'), -1\n\n        # Track the two smallest numbers and their indices (value, index)\n        min1_val, min1_idx = float('inf'), -1\n        min2_val, min2_idx = float('inf'), -1\n\n        for i, num in enumerate(nums_list):\n            # Update largest values\n            if num > max1_val:\n                max2_val, max2_idx = max1_val, max1_idx\n                max1_val, max1_idx = num, i\n            elif num > max2_val and i != max1_idx: # num is not greater than max1_val, but is greater than max2_val and has a distinct index\n                max2_val, max2_idx = num, i\n            \n            # Update smallest values\n            if num < min1_val:\n                min2_val, min2_idx = min1_val, min1_idx\n                min1_val, min1_idx = num, i\n            elif num < min2_val and i != min1_idx: # num is not smaller than min1_val, but is smaller than min2_val and has a distinct index\n                min2_val, min2_idx = num, i\n\n        # Calculate products of candidate pairs\n        # The two largest positives will always yield a positive product.\n        # The two smallest (most negative) numbers will yield a positive product.\n        product_positives = max1_val * max2_val\n        product_negatives = min1_val * min2_val\n\n        if product_positives >= product_negatives:\n            return (max1_val, max2_val)\n        else:\n            return (min1_val, min2_val)\n\n    _validate_input(nums)\n    return _find_max_pair(nums)"}
{"task_id": "Mbpp/420", "solution": "from typing import List\n\nclass EvenNumberSequence:\n    \"\"\"Generates a sequence of the first n even natural numbers.\"\"\"\n    def __init__(self, n: int) -> None:\n        self._n = n\n\n    def generate(self) -> List[int]:\n        \"\"\"Returns a list of the first n even natural numbers.\"\"\"\n        return [2 * i for i in range(1, self._n + 1)]\n\nclass Calculation:\n    \"\"\"Computes cubes of numbers and their sum.\"\"\"\n    def __init__(self, numbers: List[int]) -> None:\n        self._numbers = numbers\n        self._cubes: List[int] = []\n\n    def compute_cubes(self) -> List[int]:\n        \"\"\"Computes the cube of each number in the sequence.\"\"\"\n        self._cubes = [num ** 3 for num in self._numbers]\n        return self._cubes\n\n    def sum(self) -> int:\n        \"\"\"Returns the sum of the computed cubes.\"\"\"\n        return sum(self._cubes)\n\nclass CalculationResult:\n    \"\"\"Holds the resulting integer value of a calculation.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\ndef cube_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of cubes of the first n even natural numbers.\"\"\"\n    if n == 0:\n        return 0\n\n    sequence_generator = EvenNumberSequence(n)\n    numbers = sequence_generator.generate()\n\n    calculator = Calculation(numbers)\n    calculator.compute_cubes()\n    total_sum = calculator.sum()\n\n    result_holder = CalculationResult(total_sum)\n    return result_holder.value"}
