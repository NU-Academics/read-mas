{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists):\n    \"\"\"\n    Finds common elements in a list of nested lists, returning them as a set.\n    Validates input and handles empty lists as specified in the design.\n    \"\"\"\n    if not isinstance(nested_lists, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not nested_lists:\n        # BR5: If top-level list is empty, return an empty collection.\n        return set()\n\n    # Initialize common_elements with the set of the first list after validation.\n    if not isinstance(nested_lists[0], list):\n        raise TypeError(\"All inner elements must be lists.\")\n    \n    if not nested_lists[0]:\n        # BR6: If the first inner list is empty, the intersection is empty.\n        return set()\n\n    common_elements = set(nested_lists[0])\n\n    # Iterate through the rest of the nested lists to find the intersection.\n    for i in range(1, len(nested_lists)):\n        sublist = nested_lists[i]\n        \n        # Validate each inner list.\n        if not isinstance(sublist, list):\n            raise TypeError(\"All inner elements must be lists.\")\n        \n        # BR6: If any inner list is empty, the intersection will be empty.\n        if not sublist:\n            return set()\n\n        # Compute the intersection with the current sublist.\n        # This updates common_elements in place and handles deduplication (FR2).\n        common_elements.intersection_update(set(sublist))\n\n        # Optimization: if common_elements becomes empty, no further elements can be common.\n        if not common_elements:\n            return set()\n            \n    # The result is a set, naturally deduplicated and without guaranteed order (FR3).\n    return common_elements"}
{"task_id": "Mbpp/109", "solution": "def _validate_string(s: str) -> None:\n    \"\"\"Ensures the input string 's' is non-empty and contains only '0' or '1'.\"\"\"\n    if not isinstance(s, str) or not s:\n        raise ValueError(\"Input string 's' must be a non-empty string.\")\n    if not all(char in '01' for char in s):\n        raise ValueError(\"Input string 's' must contain only '0' or '1'.\")\n\ndef _validate_count(n: int) -> None:\n    \"\"\"Ensures the input 'n' is a non-negative integer.\"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\ndef _effective_count(s_len: int, n: int) -> int:\n    \"\"\"Calculates the effective number of rotations, limited by string length.\"\"\"\n    return min(n, s_len)\n\ndef _rotate_left_once(s: str) -> str:\n    \"\"\"Performs a single cyclic left rotation on the string 's'.\"\"\"\n    return s[1:] + s[0]\n\ndef _lsb_is_one(s: str) -> bool:\n    \"\"\"Checks if the least significant bit (last character) of the binary string is '1'.\"\"\"\n    return s[-1] == '1'\n\ndef odd_Equivalent(s: str, n: int) -> int:\n    \"\"\"\n    Finds the number of numbers with an odd value when rotating a binary string\n    the given number of times.\n\n    This function validates inputs, evaluates a limited number of rotations,\n    and determines oddness by checking the last character of the binary string.\n    \"\"\"\n    _validate_string(s)\n    _validate_count(n)\n\n    odd_count = 0\n    current_s = s\n    s_len = len(s)\n    \n    k = _effective_count(s_len, n)\n\n    if k == 0:\n        return 0\n\n    for i in range(k):\n        if _lsb_is_one(current_s):\n            odd_count += 1\n        \n        # Rotate for the next iteration if more rotations are required.\n        if i < k - 1:\n            current_s = _rotate_left_once(current_s)\n            \n    return odd_count"}
{"task_id": "Mbpp/116", "solution": "from dataclasses import dataclass\nfrom typing import List, Tuple\n\n@dataclass\nclass TupleInput:\n    \"\"\"Encapsulates the input tuple elements for processing.\"\"\"\n    elements: List[int]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the input.\"\"\"\n        return len(self.elements)\n\n@dataclass\nclass TupleElement:\n    \"\"\"Represents a single element from the input tuple with its position.\"\"\"\n    value: int\n    position: int\n\n@dataclass\nclass ResultInteger:\n    \"\"\"Encapsulates the final converted integer result.\"\"\"\n    value: int\n\nclass TupleToIntFunction:\n    \"\"\"Application service for converting TupleInput to ResultInteger.\"\"\"\n    def execute(self, tuple_input: TupleInput) -> ResultInteger:\n        \"\"\"Converts a TupleInput into a single concatenated integer.\"\"\"\n        concatenated_string_parts = []\n        for element_value in tuple_input.elements:\n            # According to design, convert element value to string and append.\n            concatenated_string_parts.append(str(element_value))\n        \n        final_int_value = int(\"\".join(concatenated_string_parts))\n        return ResultInteger(value=final_int_value)\n\ndef tuple_to_int(tuple_of_positive_integers: tuple) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer.\n    The function validates input and uses an application service for conversion.\n    \"\"\"\n    # Validate input is a tuple.\n    if not isinstance(tuple_of_positive_integers, tuple):\n        raise ValueError(\"Input must be a tuple.\")\n\n    # Validate tuple is not empty.\n    if len(tuple_of_positive_integers) == 0:\n        raise ValueError(\"Input tuple cannot be empty.\")\n\n    # Validate each element is a positive integer.\n    for element in tuple_of_positive_integers:\n        if not isinstance(element, int):\n            raise ValueError(f\"All tuple elements must be integers, but found {type(element).__name__}.\")\n        if element <= 0:\n            raise ValueError(f\"All tuple elements must be positive, but found {element}.\")\n\n    # Adapt caller input to the domain model.\n    tuple_input = TupleInput(elements=list(tuple_of_positive_integers))\n\n    # Use the application service to perform the conversion.\n    converter = TupleToIntFunction()\n    result_obj = converter.execute(tuple_input)\n\n    # Return the primitive integer result.\n    return result_obj.value"}
