{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Tuple\n\ndef find_literals(text: str, pattern: str) -> tuple[str, int, int] | None:\n    \"\"\"Search text for the first occurrence of pattern (interpreted as a regex).\n    Return (matched_substring, start_index, end_index) where indices are 0-based and end is exclusive.\n    Return None if no match is found.\n    \"\"\"\n    match = re.search(pattern, text)\n    if match:\n        return (match.group(0), match.start(), match.end())\n    return None"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Computes the nth Bell number (0-based indexing) using the Bell triangle.\n    Raises TypeError if n is not an integer or ValueError if n is negative.\n    \"\"\"\n\n    def _validate_n(val) -> None:\n        \"\"\"Validates that 'val' is a non-negative integer.\"\"\"\n        if not isinstance(val, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if val < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    def _compute_bell(val: int) -> int:\n        \"\"\"Computes the nth Bell number using the Bell triangle algorithm.\"\"\"\n        if val == 0:\n            return 1\n\n        # `prev_row` stores the elements of the (i-1)-th row of the Bell triangle.\n        # Initialize with B0 = 1, representing the conceptual row 0.\n        prev_row = [1]\n\n        # Iterate from row 1 up to n (to compute Bn)\n        for i in range(1, val + 1):\n            current_row = [0] * (i + 1)\n            # The first element of the current row is the last element of the previous row.\n            current_row[0] = prev_row[i - 1]\n\n            # Fill the rest of the current row based on the recurrence relation.\n            for j in range(1, i + 1):\n                # Each subsequent element is the sum of the element to its left\n                # (in the current row) and the element above and to its left\n                # (in the previous row).\n                current_row[j] = current_row[j - 1] + prev_row[j - 1]\n            \n            # The current_row becomes the prev_row for the next iteration.\n            prev_row = current_row\n\n        # The nth Bell number is the first element of the nth row computed.\n        return prev_row[0]\n\n    _validate_n(n)\n    return _compute_bell(n)"}
{"task_id": "Mbpp/612", "solution": "def merge(input_list: list) -> list:\n    \"\"\"\n    Merges a list of 2-element sublists into a list of two lists,\n    collecting the first and second elements respectively.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n\n    for sublist in input_list:\n        if not isinstance(sublist, list) or len(sublist) != 2:\n            raise ValueError(\"Each sublist must contain exactly two elements.\")\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"\n    Remove the k'th element from input_list where k is 1-based.\n    Raises IndexError if k is out of range.\n    \"\"\"\n    if k < 1 or k > len(input_list):\n        raise IndexError(\"k out of range\")\n    \n    removed_index = k - 1\n    return input_list[:removed_index] + input_list[removed_index+1:]"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(input_list: list[tuple[int, ...]]) -> int:\n    \"\"\"Calculates the cumulative sum of all integers across a list of tuples.\n    Returns 0 for an empty list.\n    \"\"\"\n    total = 0\n    for tpl in input_list:\n        for num in tpl:\n            total += num\n    return total"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix, n):\n    \"\"\"Return the maximum numeric value found in the nth column across all rows.\n\n    Assumes all rows contain an element at index n and that elements are numeric.\n    \"\"\"\n    max_value = matrix[0][n]\n    for row in matrix[1:]:\n        value = row[n]\n        if value > max_value:\n            max_value = value\n    return max_value"}
{"task_id": "Mbpp/615", "solution": "from typing import Tuple, List, Iterator\n\nclass InnerTuple:\n    \"\"\"Encapsulates a single inner tuple, validates its content, and computes its mean.\"\"\"\n    def __init__(self, values: Tuple) -> None:\n        if not isinstance(values, tuple):\n            raise TypeError(\"Inner element must be a tuple.\")\n        if not values:\n            raise ValueError(\"Inner tuple cannot be empty.\")\n        for val in values:\n            if not isinstance(val, (int, float)):\n                raise TypeError(\"Inner tuple elements must be numeric (int or float).\")\n        self._values = values\n\n    def sum(self) -> float:\n        \"\"\"Returns the sum of the inner tuple's values.\"\"\"\n        return float(sum(self._values))\n\n    def count(self) -> int:\n        \"\"\"Returns the number of elements in the inner tuple.\"\"\"\n        return len(self._values)\n\n    def mean(self) -> float:\n        \"\"\"Computes the arithmetic mean of the inner tuple's values.\"\"\"\n        return self.sum() / self.count()\n\nclass InputTupleCollection:\n    \"\"\"Encapsulates the outer tuple, performs structural validation, and iterates yielding InnerTuple instances.\"\"\"\n    def __init__(self, tuples: Tuple) -> None:\n        if not isinstance(tuples, tuple):\n            raise TypeError(\"Top-level input must be a tuple.\")\n        self._tuples = tuples\n\n    def validate(self) -> None:\n        \"\"\"Validates that all inner elements are tuples.\"\"\"\n        for item in self._tuples:\n            if not isinstance(item, tuple):\n                raise TypeError(\"All elements within the top-level tuple must be tuples.\")\n\n    def __iter__(self) -> Iterator[InnerTuple]:\n        \"\"\"Yields InnerTuple objects for each inner tuple in the collection.\"\"\"\n        for inner_tuple_values in self._tuples:\n            yield InnerTuple(inner_tuple_values)\n\nclass AverageResult:\n    \"\"\"A container for computed means, providing them as a Python list.\"\"\"\n    def __init__(self, averages: List[float]) -> None:\n        self._averages = averages\n\n    def as_list(self) -> List[float]:\n        \"\"\"Returns the list of computed averages.\"\"\"\n        return self._averages\n\nclass AverageCalculator:\n    \"\"\"Orchestrates validation and mean computation over an InputTupleCollection.\"\"\"\n    def average_tuple(self, input: Tuple) -> List[float]:\n        \"\"\"Processes the input tuple of tuples to compute per-inner-tuple averages.\"\"\"\n        collection = InputTupleCollection(input)\n        collection.validate()\n        result = self._compute_means(collection)\n        return result.as_list()\n\n    def _compute_means(self, collection: InputTupleCollection) -> AverageResult:\n        \"\"\"Computes the mean for each inner tuple in the collection.\"\"\"\n        means = []\n        for inner_tuple_obj in collection:\n            means.append(inner_tuple_obj.mean())\n        return AverageResult(means)\n\ndef average_tuple(input: tuple) -> list:\n    \"\"\"\n    Public function: validate input and return list of floats.\n    Raises: TypeError, ValueError per validation rules.\n    \"\"\"\n    calculator = AverageCalculator()\n    return calculator.average_tuple(input)"}
{"task_id": "Mbpp/616", "solution": "from typing import List, Tuple, Union\n\nclass TupleElement:\n    \"\"\"Represents a single tuple element with its value and index.\"\"\"\n    def __init__(self, value: int, index: int) -> None:\n        self.value = value\n        self.index = index\n\n    def __repr__(self) -> str:\n        return f\"TupleElement(value={self.value}, index={self.index})\"\n\nclass TupleOperand:\n    \"\"\"Represents an ordered collection of TupleElement and provides conversions.\"\"\"\n    def __init__(self, elements: List[TupleElement]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def to_tuple(self) -> Tuple[int, ...]:\n        return tuple(element.value for element in self.elements)\n\n    @staticmethod\n    def from_tuple(data: Tuple[int, ...]) -> 'TupleOperand':\n        return TupleOperand([TupleElement(value, i) for i, value in enumerate(data)])\n\nclass Validator:\n    \"\"\"Validates business rules for tuple operations, raising exceptions on failure.\"\"\"\n    def check_length(self, a: 'TupleOperand', b: 'TupleOperand') -> bool:\n        if a.length() != b.length():\n            raise ValueError(\"Input tuples must have the same length.\")\n        return True\n\n    def check_non_zero(self, b: 'TupleOperand') -> bool:\n        for element in b.elements:\n            if element.value == 0:\n                raise ZeroDivisionError(f\"Divisor at index {element.index} is zero.\")\n        return True\n\nclass ModuloOperation:\n    \"\"\"Computes element-wise modulo using TupleOperand inputs and an injected Validator.\"\"\"\n    def __init__(self, validator: Union['Validator', None] = None) -> None:\n        self.validator = validator if validator is not None else Validator()\n\n    def tuple_modulo(self, a: 'TupleOperand', b: 'TupleOperand') -> 'TupleOperand':\n        self.validator.check_length(a, b)\n        self.validator.check_non_zero(b)\n\n        result_elements = []\n        for i in range(a.length()):\n            result_value = a.elements[i].value % b.elements[i].value\n            result_elements.append(TupleElement(result_value, i))\n        return TupleOperand(result_elements)\n\ndef tuple_modulo(a: Tuple[int, ...], b: Tuple[int, ...]) -> Tuple[int, ...]:\n    \"\"\"\n    Performs element-wise modulo operation on two tuples of integers.\n    The function validates inputs for equal length and non-zero divisors.\n    \"\"\"\n    a_op = TupleOperand.from_tuple(a)\n    b_op = TupleOperand.from_tuple(b)\n    op = ModuloOperation(validator=Validator())\n    result_op = op.tuple_modulo(a_op, b_op)\n    return result_op.to_tuple()"}
{"task_id": "Mbpp/618", "solution": "def div_list(listA, listB):\n    \"\"\"Performs element-wise division of two lists, returning a list of floats.\"\"\"\n    return [float(a / b) for a, b in zip(listA, listB)]"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"Moves all digit characters to the end of the given string, preserving relative order.\"\"\"\n    non_digits = []\n    digits = []\n    for char in input_string:\n        if '0' <= char <= '9':  # Check if character is a digit\n            digits.append(char)\n        else:\n            non_digits.append(char)\n    return \"\".join(non_digits) + \"\".join(digits)"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: list) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible.\n    The divisibility means one number divides the other.\n    \"\"\"\n    def _divisible(a: int, b: int) -> bool:\n        \"\"\"\n        Checks if one number divides the other, safely handling zero values.\n        A non-zero number divides zero (0 % N == 0). Zero divides zero.\n        \"\"\"\n        if a == 0:\n            return True\n        if b == 0:\n            return True\n        return a % b == 0 or b % a == 0\n\n    def _longest_divisible_chain(nums: list) -> int:\n        \"\"\"\n        Computes the length of the largest divisible subset using dynamic programming.\n        Assumes nums is already sorted in non-decreasing order.\n        \"\"\"\n        n = len(nums)\n        if n == 0:\n            return 0\n\n        # dp[i] stores the length of the largest divisible subset ending with nums[i]\n        dp = [1] * n\n\n        for i in range(1, n):\n            for j in range(i):\n                if _divisible(nums[i], nums[j]):\n                    dp[i] = max(dp[i], 1 + dp[j])\n\n        return max(dp)\n\n    if not numbers:\n        return 0\n    if len(numbers) == 1:\n        return 1\n\n    # Sort the numbers to apply dynamic programming efficiently.\n    # This also helps with the _divisible check as nums[j] will always be <= nums[i] when j < i.\n    sorted_numbers = sorted(numbers)\n\n    return _longest_divisible_chain(sorted_numbers)"}
{"task_id": "Mbpp/623", "solution": "from typing import List, Union, Any\n\ndef _validate_input(input_list: Any, n: Any) -> None:\n    \"\"\"\n    Validates that input_list is a list of integers and n is an integer.\n    Raises TypeError if any validation fails.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input list must be a list.\")\n    for item in input_list:\n        if not isinstance(item, int):\n            raise TypeError(\"All elements in the input list must be integers.\")\n    if not isinstance(n, int):\n        raise TypeError(\"The exponent n must be an integer.\")\n\ndef nth_nums(input_list: List[int], n: int) -> List[Union[int, float]]:\n    \"\"\"\n    Computes the n-th power of each number in the input list.\n    Returns a new list with results, preserving order and length.\n    \"\"\"\n    _validate_input(input_list, n)\n\n    if not input_list:\n        return []\n\n    result = []\n    for num in input_list:\n        # Python's ** operator naturally handles the numeric return-type policy\n        # (int for non-negative powers resulting in integers, float otherwise).\n        power = num ** n\n        result.append(power)\n    return result"}
{"task_id": "Mbpp/622", "solution": "from dataclasses import dataclass\nfrom typing import List\n\nclass LengthError(Exception):\n    \"\"\"Custom exception raised when input list lengths do not match n.\"\"\"\n    def __init__(self, message: str, code: str = \"LengthError\") -> None:\n        super().__init__(message)\n        self.code = code\n\n@dataclass\nclass InputList:\n    \"\"\"Represents an input list with its properties.\"\"\"\n    elements: List[int]\n    length: int\n    sorted: bool\n\n@dataclass\nclass ValidationResult:\n    \"\"\"Stores the outcome of an input validation check.\"\"\"\n    is_valid: bool\n    error_message: str = \"\"\n\n@dataclass\nclass MedianResult:\n    \"\"\"Holds the computed median value.\"\"\"\n    value: float\n\ndef validate_lengths(arr1: list, arr2: list, n: int) -> ValidationResult:\n    \"\"\"Checks if both input arrays have a length equal to n.\"\"\"\n    if len(arr1) == n and len(arr2) == n:\n        return ValidationResult(is_valid=True)\n    else:\n        msg = f\"Array lengths must both be equal to n. Got len(arr1)={len(arr1)}, len(arr2)={len(arr2)}, n={n}.\"\n        return ValidationResult(is_valid=False, error_message=msg)\n\ndef compute_median(arr1: list, arr2: list, n: int) -> MedianResult:\n    \"\"\"Computes the median of two sorted lists of equal size n.\"\"\"\n    i = 0  # Current index for arr1\n    j = 0  # Current index for arr2\n    m1 = -1  # Stores the (n-1)-th element in the combined sorted list\n    m2 = -1  # Stores the n-th element in the combined sorted list\n\n    # Iterate n+1 times to find the n-th and (n+1)-th elements (0-indexed).\n    for _ in range(n + 1):\n        if i == n:\n            m1 = m2\n            m2 = arr2[j]\n            j += 1\n        elif j == n:\n            m1 = m2\n            m2 = arr1[i]\n            i += 1\n        elif arr1[i] <= arr2[j]:\n            m1 = m2\n            m2 = arr1[i]\n            i += 1\n        else:\n            m1 = m2\n            m2 = arr2[j]\n            j += 1\n\n    return MedianResult(value=(float(m1) + float(m2)) / 2.0)\n\ndef get_median(arr1: list, arr2: list, n: int) -> float:\n    \"\"\"Finds the median of two sorted lists of the same size n.\"\"\"\n    validation_result = validate_lengths(arr1, arr2, n)\n    if not validation_result.is_valid:\n        raise LengthError(validation_result.error_message)\n\n    median_result = compute_median(arr1, arr2, n)\n    return median_result.value"}
