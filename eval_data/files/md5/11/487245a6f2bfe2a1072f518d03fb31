{"task_id": "Mbpp/269", "solution": "class Character:\n    \"\"\"Represents a character input and provides validation.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def isSingleChar(self) -> bool:\n        \"\"\"Checks if the stored value is a single character string.\"\"\"\n        return len(self._value) == 1\n\nclass AsciiCode:\n    \"\"\"Represents an ASCII integer code.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def toInt(self) -> int:\n        \"\"\"Returns the integer value of the ASCII code.\"\"\"\n        return self._value\n\nclass AsciiValueFunction:\n    \"\"\"Encapsulates the logic for validating input and computing ASCII code.\"\"\"\n    def validateInput(self, char: str) -> None:\n        \"\"\"Validates if the input is a single character string, raising ValueError if not.\"\"\"\n        character_obj = Character(char)\n        if not character_obj.isSingleChar():\n            raise ValueError(\"ascii_value expects exactly one character\")\n\n    def getAscii(self, char: str) -> int:\n        \"\"\"Computes the ASCII value for a single character after validation.\"\"\"\n        self.validateInput(char)\n        ascii_val = ord(char)\n        ascii_code_obj = AsciiCode(ascii_val)\n        return ascii_code_obj.toInt()\n\ndef ascii_value(character: str) -> int:\n    \"\"\"\n    Finds the ASCII value of a character.\n    Raises ValueError if the input is not a single character string.\n    \"\"\"\n    ascii_func = AsciiValueFunction()\n    return ascii_func.getAscii(character)"}
{"task_id": "Mbpp/270", "solution": "def sum_even_and_even_index(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of even numbers found at even (zero-based) positions in a list.\n    The input list is not modified.\n    \"\"\"\n    total_sum = 0\n    for idx, num in enumerate(numbers):\n        if idx % 2 == 0 and num % 2 == 0:\n            total_sum += num\n    return total_sum"}
