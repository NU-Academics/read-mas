{"task_id": "Mbpp/256", "solution": "import math\n\ndef count_Primes_nums(n):\n    \"\"\"\n    Counts the number of prime numbers less than a given non-negative number n.\n    Primes must be >= 2.\n    \"\"\"\n    if n <= 2:\n        return 0\n\n    count = 0\n    p = 2 \n\n    # Iterate through numbers p while p is strictly less than n.\n    while p < n:\n        is_prime_candidate = True\n        \n        # 2 is the first and only even prime number.\n        if p == 2:\n            is_prime_candidate = True\n        else:\n            # For numbers greater than 2, an even number cannot be prime.\n            if p % 2 == 0:\n                is_prime_candidate = False\n            else:\n                # Check for odd divisors from 3 up to the square root of p.\n                # If any divisor is found, p is not prime.\n                for i in range(3, int(math.sqrt(p)) + 1, 2):\n                    if p % i == 0:\n                        is_prime_candidate = False\n                        break\n        \n        if is_prime_candidate:\n            count += 1\n        \n        p += 1 # Move to the next integer candidate.\n            \n    return count"}
{"task_id": "Mbpp/259", "solution": "def maximize_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Maximizes elements of two input tuples element-wise.\n    Ensures inputs are valid and returns a new tuple with maximized pairs.\n    \"\"\"\n\n    def raise_value_error(msg: str) -> None:\n        \"\"\"Raises a ValueError with the given message.\"\"\"\n        raise ValueError(msg)\n\n    def raise_type_error(msg: str) -> None:\n        \"\"\"Raises a TypeError with the given message.\"\"\"\n        raise TypeError(msg)\n\n    def validate_lengths(a_in: tuple, b_in: tuple) -> None:\n        \"\"\"Validates that input tuples have equal lengths.\"\"\"\n        if len(a_in) != len(b_in):\n            raise_value_error(\"Input tuples must be of equal length.\")\n\n    def validate_element_shapes(a_in: tuple, b_in: tuple) -> None:\n        \"\"\"Validates that all elements in input tuples are 2-tuples.\"\"\"\n        for i in range(len(a_in)):\n            if not (isinstance(a_in[i], tuple) and len(a_in[i]) == 2):\n                raise_type_error(f\"Element at index {i} in tuple 'a' is not a 2-tuple.\")\n            if not (isinstance(b_in[i], tuple) and len(b_in[i]) == 2):\n                raise_type_error(f\"Element at index {i} in tuple 'b' is not a 2-tuple.\")\n\n    def max_pair(a_pair: tuple, b_pair: tuple) -> tuple:\n        \"\"\"Returns a new 2-tuple with the maximum of corresponding elements.\"\"\"\n        return (max(a_pair[0], b_pair[0]), max(a_pair[1], b_pair[1]))\n\n    def assemble_output(pairs_list: list) -> tuple:\n        \"\"\"Assembles a list of 2-tuples into a final output tuple.\"\"\"\n        return tuple(pairs_list)\n\n    validate_lengths(a, b)\n    validate_element_shapes(a, b)\n\n    maxima_pairs = []\n    for i in range(len(a)):\n        maxima_pairs.append(max_pair(a[i], b[i]))\n\n    return assemble_output(maxima_pairs)"}
{"task_id": "Mbpp/260", "solution": "import math\n\nclass SequenceTerm:\n    \"\"\"Data carrier for a sequence term, including its index, value, and primality status.\"\"\"\n    def __init__(self, index: int, value: int, is_prime: bool):\n        self.index = index\n        self.value = value\n        self.is_prime = is_prime\n\nclass PrimeTester:\n    \"\"\"Encapsulates logic for testing if a number is prime.\"\"\"\n    def isPrime(self, value: int) -> bool:\n        if value < 2:\n            return False\n        if value == 2:\n            return True\n        if value % 2 == 0:\n            return False\n        # Check for odd divisors up to the square root of the value.\n        for i in range(3, int(math.sqrt(value)) + 1, 2):\n            if value % i == 0:\n                return False\n        return True\n\nclass SequenceGenerator:\n    \"\"\"Generates terms of the Newman\u2013Shanks\u2013Williams sequence with memoization.\"\"\"\n    def __init__(self, prime_tester: PrimeTester):\n        self._memo = {0: 1, 1: 1}\n        self._current_index = 0\n        self._prime_tester = prime_tester\n\n    def getTerm(self, index: int) -> int:\n        \"\"\"Computes and returns the NSW term at a specific index, using memoization.\"\"\"\n        if index not in self._memo:\n            # Recursively compute terms up to the requested index if not memoized.\n            # This loop ensures all intermediate terms are computed and stored.\n            for i in range(max(2, len(self._memo)), index + 1):\n                self._memo[i] = 2 * self._memo[i-1] + self._memo[i-2]\n        return self._memo[index]\n\n    def next(self) -> SequenceTerm:\n        \"\"\"Produces the next Newman\u2013Shanks\u2013Williams sequence term and determines its primality.\"\"\"\n        current_value = self.getTerm(self._current_index)\n        is_p = self._prime_tester.isPrime(current_value)\n        term = SequenceTerm(self._current_index, current_value, is_p)\n        self._current_index += 1\n        return term\n\nclass NewmanPrimeService:\n    \"\"\"Orchestrates sequence generation and primality testing to find NSW primes.\"\"\"\n    def __init__(self):\n        self._prime_tester = PrimeTester()\n        # SequenceGenerator is initialized with a PrimeTester instance to allow it to determine primality.\n        self._sequence_generator = SequenceGenerator(self._prime_tester)\n        self._primes_found = 0\n\n    def validateInput(self, n) -> None:\n        \"\"\"\n        Per design, this method exists for input validation.\n        However, per strict output requirements (\"Do NOT add isinstance() checks or raise exceptions\"),\n        it does not perform actual checks or raise exceptions.\n        \"\"\"\n        pass\n\n    def newman_prime(self, n: int) -> int:\n        \"\"\"Finds the nth Newman\u2013Shanks\u2013Williams prime number.\"\"\"\n        self.validateInput(n) # Call validation method (no-op as per prompt constraints)\n        self._primes_found = 0\n        # Reset the sequence generator for a fresh search for this request.\n        self._sequence_generator._current_index = 0\n        # Clear memo for fresh start and to avoid memory bloat from previous large computations.\n        # Although not explicitly in design, clearing is good practice for a service method.\n        # self._sequence_generator._memo = {0: 1, 1: 1} # Design says reset _current_index. Memo can grow.\n\n        while True:\n            term = self._sequence_generator.next()\n            if term.is_prime:\n                self._primes_found += 1\n            if self._primes_found == n:\n                return term.value\n\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman\u2013Shanks\u2013Williams prime number.\n    \"\"\"\n    service = NewmanPrimeService()\n    return service.newman_prime(n)"}
{"task_id": "Mbpp/264", "solution": "def dog_age(humanYears: float) -> float:\n    \"\"\"Calculate a dog's age in dog years based on the standard formula.\n    The result is rounded to two decimal places.\"\"\"\n    if humanYears <= 2:\n        dog_years = humanYears * 10.5\n    else:\n        dog_years = (2 * 10.5) + ((humanYears - 2) * 4)\n    return round(dog_years, 2)"}
{"task_id": "Mbpp/262", "solution": "def split_two_parts(input_list, L):\n    \"\"\"Public API: split_two_parts(input_list, L) -> tuple\n    Splits a list into two parts: the first L elements and the rest.\n    \"\"\"\n    class SplitError(Exception):\n        def __init__(self, message: str):\n            self.message = message\n            super().__init__(message)\n        def __str__(self):\n            return self.message\n\n    class ListSplitter:\n        def split_two_parts(self, input_list, L):\n            \"\"\"Validate inputs and perform the list splitting operation.\"\"\"\n            self.validate(input_list, L)\n            return self.perform_split(input_list, L)\n\n        def validate(self, input_list, L):\n            \"\"\"Checks input types and raises TypeError if invalid.\"\"\"\n            if not isinstance(input_list, list):\n                raise TypeError(\"input_list must be a list-like sequence\")\n            if not isinstance(L, int):\n                raise TypeError(\"L must be an integer\")\n\n        def perform_split(self, input_list, L):\n            \"\"\"Splits the list using slicing, returning two new lists.\"\"\"\n            first_part = input_list[:L]\n            second_part = input_list[L:]\n            return (first_part, second_part)\n\n    splitter = ListSplitter()\n    return splitter.split_two_parts(input_list, L)"}
