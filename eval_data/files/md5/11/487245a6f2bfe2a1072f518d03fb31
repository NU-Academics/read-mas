{"task_id": "Mbpp/626", "solution": "def triangle_area(radius):\n    \"\"\"\n    Calculates the area of the largest triangle inscribed in a semicircle.\n    Returns None for negative radius, 0 for zero radius, and radius**2 for positive radius.\n    \"\"\"\n\n    class InputValidator:\n        \"\"\"Helper for validating input types and values.\"\"\"\n        @staticmethod\n        def is_numeric(value) -> bool:\n            return isinstance(value, (int, float))\n\n        @staticmethod\n        def is_non_negative(value) -> bool:\n            return value >= 0\n\n    class Radius:\n        \"\"\"Represents the radius value with validation capabilities.\"\"\"\n        def __init__(self, value):\n            self.value = float(value)\n\n        def is_valid(self) -> bool:\n            return InputValidator.is_numeric(self.value)\n\n    class Result:\n        \"\"\"Encapsulates a result value and its status for traceability.\"\"\"\n        def __init__(self, value, status: str):\n            self.value = value\n            self.status = status\n\n    class Semicircle:\n        \"\"\"Represents a semicircle, composing a Radius object.\"\"\"\n        def __init__(self, radius_obj: Radius):\n            self.radius = radius_obj\n\n    def compute_area(r) -> float:\n        \"\"\"Calculates the area as r^2 for a given radius r.\"\"\"\n        return r ** 2\n\n    # Validate numeric type and raise TypeError if not numeric, as per design.\n    if not InputValidator.is_numeric(radius):\n        raise TypeError(\"radius must be int or float\")\n\n    # Instantiate Radius and Semicircle objects for domain model reflection.\n    radius_obj = Radius(radius)\n    semicircle_obj = Semicircle(radius_obj)\n\n    # Handle different radius conditions as per functional requirements.\n    if not InputValidator.is_non_negative(radius):\n        return Result(None, \"Negative radius\").value\n    elif radius == 0:\n        return Result(0, \"Zero radius\").value\n    else: # radius > 0\n        area = compute_area(radius)\n        return Result(area, \"Positive radius\").value"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(coord_tuple):\n    \"\"\"\n    Extracts all adjacent coordinates of the given coordinate tuple in row-major order.\n    The output includes the central coordinate itself.\n    \"\"\"\n    x, y = coord_tuple\n    result = []\n    for dx in (-1, 0, 1):\n        for dy in (-1, 0, 1):\n            result.append([x + dx, y + dy])\n    return result"}
