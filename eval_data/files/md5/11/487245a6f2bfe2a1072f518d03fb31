{"task_id": "Mbpp/282", "solution": "def sub_list(a: list, b: list) -> list:\n    \"\"\"Validate inputs and return element-wise difference list c where c[i] = a[i] - b[i].\n\n    Raises:\n      ValueError: if inputs are not numeric lists or lengths differ (signals error per BR6).\n    \"\"\"\n\n    def validateNumeric(a_list: list, b_list: list) -> bool:\n        \"\"\"Return True if every element in a_list and b_list is an int or float.\"\"\"\n        for lst in (a_list, b_list):\n            for element in lst:\n                if not isinstance(element, (int, float)):\n                    return False\n        return True\n\n    def validateEqualLength(a_list: list, b_list: list) -> bool:\n        \"\"\"Return True if len(a_list) == len(b_list).\"\"\"\n        return len(a_list) == len(b_list)\n\n    if not validateNumeric(a, b):\n        raise ValueError(\"Input lists must contain only numeric values (int or float).\")\n\n    if not validateEqualLength(a, b):\n        raise ValueError(\"Input lists must be of equal length.\")\n\n    result = [a[i] - b[i] for i in range(len(a))]\n    return result"}
{"task_id": "Mbpp/285", "solution": "class MatchResult:\n    \"\"\"Represents the result of a pattern match, including details.\"\"\"\n    def __init__(self, is_match: bool, matched_substring: str = \"\", start_index: int = -1):\n        self.is_match = is_match\n        self.matched_substring = matched_substring\n        self.start_index = start_index\n\nclass Text:\n    \"\"\"Wraps an input string and provides its length.\"\"\"\n    def __init__(self, content: str):\n        self.content = content\n\n    def length(self) -> int:\n        return len(self.content)\n\nclass PatternMatcher:\n    \"\"\"Encapsulates logic for detecting specific 'a' followed by 'b' patterns.\"\"\"\n\n    def containsExactSequence(self, text_content: str, pattern: str) -> bool:\n        \"\"\"Checks if the exact pattern string is present as a substring.\"\"\"\n        return pattern in text_content\n\n    def text_match_two_three(self, text: str) -> bool:\n        \"\"\"Checks if the text contains 'abb' or 'abbb' using exact sequence checks.\"\"\"\n        if self.containsExactSequence(text, \"abb\"):\n            return True\n        if self.containsExactSequence(text, \"abbb\"):\n            return True\n        return False\n\ndef text_match_two_three(text: str) -> bool:\n    \"\"\"\n    Checks if a string contains 'a' followed by two or three 'b' characters.\n    Returns True if 'abb' or 'abbb' is found, otherwise False.\n    \"\"\"\n    matcher = PatternMatcher()\n    return matcher.text_match_two_three(text)"}
