{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits: list) -> int:\n    \"\"\"Public API. Validate input, return 0 for empty list, else return largest integer formed by digits in descending order.\"\"\"\n\n    class InputValidator:\n        \"\"\"Validate argument is a list and each element is an integer in 0..9.\"\"\"\n        def validate(self, digits: list) -> None:\n            \"\"\"Raise TypeError if digits is not a list; raise ValueError if any element is not int or not in 0..9.\"\"\"\n            if not isinstance(digits, list):\n                raise TypeError(\"Input must be a list.\")\n            for digit in digits:\n                if not isinstance(digit, int):\n                    raise ValueError(\"All elements must be integers.\")\n                if not (0 <= digit <= 9):\n                    raise ValueError(\"All elements must be digits between 0 and 9.\")\n\n    class DigitList:\n        \"\"\"Lightweight wrapper around the input list providing inspectors.\"\"\"\n        def __init__(self, digits: list) -> None:\n            self._digits = digits\n\n        def is_empty(self) -> bool:\n            \"\"\"Return True if the digit list is empty.\"\"\"\n            return not self._digits\n\n        def to_list(self) -> list:\n            \"\"\"Return the underlying list of digits.\"\"\"\n            return list(self._digits)\n\n    class Sorter:\n        \"\"\"Sort digits in descending order while preserving duplicates.\"\"\"\n        def sort_desc(self, digits: list) -> list:\n            \"\"\"Return new list with elements sorted descending (duplicates preserved).\"\"\"\n            return sorted(digits, reverse=True)\n\n    class ResultNumber:\n        \"\"\"Assemble a descending-order digit list into a Python int value.\"\"\"\n        def __init__(self) -> None:\n            self._value: int = 0\n\n        def assemble_from_digits(self, digits: list) -> None:\n            \"\"\"Assemble a list of digits into an integer.\"\"\"\n            if not digits:\n                self._value = 0\n                return\n            s_digits = [str(d) for d in digits]\n            self._value = int(\"\".join(s_digits))\n\n        def to_int(self) -> int:\n            \"\"\"Return the assembled integer value.\"\"\"\n            return self._value\n\n    class FindMaxNumFunction:\n        \"\"\"Encapsulate orchestration logic; delegates validation, sorting and assembly.\"\"\"\n        def __init__(self) -> None:\n            self._validator = InputValidator()\n            self._sorter = Sorter()\n\n        def find_Max_Num(self, digits: list) -> int:\n            \"\"\"Orchestrates finding the largest number from digits.\"\"\"\n            self._validator.validate(digits)\n\n            digit_list_wrapper = DigitList(digits)\n\n            if digit_list_wrapper.is_empty():\n                return 0\n            \n            sorted_digits = self._sorter.sort_desc(digit_list_wrapper.to_list())\n            \n            result_number = ResultNumber()\n            result_number.assemble_from_digits(sorted_digits)\n            \n            return result_number.to_int()\n\n    orchestrator = FindMaxNumFunction()\n    return orchestrator.find_Max_Num(digits)"}
