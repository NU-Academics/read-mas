{"task_id": "Mbpp/283", "solution": "def validate(value: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in the integer is less than or equal to the digit itself.\n    Handles negative integers by considering their absolute value for digit extraction.\n    \"\"\"\n\n    class IntegerInput:\n        \"\"\"Encapsulates integer input and provides its absolute decimal string.\"\"\"\n        def __init__(self, value: int) -> None:\n            self.value = value\n\n        def to_decimal_string(self) -> str:\n            \"\"\"Returns the absolute decimal string representation of the integer.\"\"\"\n            return str(abs(self.value))\n\n    class DigitCounter:\n        \"\"\"Counts the frequency of each digit (0-9) in a given string.\"\"\"\n        def __init__(self) -> None:\n            self.counts = [0] * 10\n\n        def countDigits(self, s: str) -> None:\n            \"\"\"Populates counts by iterating through the digit characters in the string.\"\"\"\n            for ch in s:\n                # Assumes 's' contains only digit characters '0'-'9'\n                self.counts[int(ch)] += 1\n\n    class Validator:\n        \"\"\"Performs the core validation logic on digit frequencies.\"\"\"\n        def validate(self, value: int) -> bool:\n            \"\"\"Orchestrates digit counting and frequency validation.\"\"\"\n            input_obj = IntegerInput(value)\n            s = input_obj.to_decimal_string()\n            counter = DigitCounter()\n            counter.countDigits(s)\n            return self.checkCounts(counter.counts)\n\n        def checkCounts(self, counts: list[int]) -> bool:\n            \"\"\"Verifies if frequency of each digit d is less than or equal to d.\"\"\"\n            for d in range(10):\n                # The rule is counts[d] <= d. If counts[d] > d, it's a violation.\n                # The explicit condition `counts[d] > 0` ensures we only check digits that are present.\n                # For d=0, counts[0] > 0 and counts[0] > 0 will be true if '0' is present, correctly failing validation.\n                if counts[d] > 0 and counts[d] > d:\n                    return False\n            return True\n\n    # Public entry point. Delegates to a new instance of the Validator class.\n    return Validator().validate(value)"}
{"task_id": "Mbpp/286", "solution": "```python\nimport math\n\nclass ArrayStatistics:\n    \"\"\"Holds various sum statistics for an array.\"\"\"\n    def __init__(self, totalSum: int, maxPrefixSum: int, maxSuffixSum: int, maxSubarraySumSingle: int):\n        self.totalSum = totalSum\n        self.maxPrefixSum = maxPrefixSum\n        self.maxSuffixSum = maxSuffixSum\n        self.maxSubarraySumSingle = maxSubarraySumSingle\n\nclass ComputationEngine:\n    \"\"\"Computes various sums and statistics for arrays.\"\"\"\n    @staticmethod\n    def compute_single_kadane(arr: list[int]) -> int:\n        \"\"\"Applies Kadane's algorithm to find the maximum subarray sum in a single array.\"\"\"\n        if not arr:\n            # For an empty array, the sum is typically 0, but if we need to return\n            # the maximum element, this case requires clarification.\n            # Assuming array is non-empty as per typical Kadane context.\n            return 0 \n        \n        max_so_far = -math.inf # Initialize with negative infinity for all-negative arrays\n        current_max = 0\n\n        for x in arr:\n            current_max += x\n            if current_max > max_so_far:\n                max_so_far = current_max\n            if current_max < 0:\n                current_max = 0\n        \n        # If all numbers are negative, Kadane's standard algorithm returns 0.\n        # However, the requirement for all-negative arrays is to return the single largest element.\n        # Adjust for this specific requirement.\n        if max_so_far == 0 and any(x < 0 for x in arr):\n            return max(arr)\n            \n        return max_so_far\n\n    @staticmethod\n    def compute_prefix_suffix(arr: list[int]) -> ArrayStatistics:\n        \"\"\"Computes total sum, max prefix sum, max suffix sum, and max single subarray sum.\"\"\"\n        if not arr:\n            return ArrayStatistics(0, 0, 0, 0) # Handle empty array case\n\n        total_sum = 0\n        max_prefix_sum = 0\n        current_prefix_sum = 0\n        \n        max_suffix_sum = 0\n        current_suffix_sum = 0\n\n        # Kadane's for maxSubarraySumSingle\n        max_sub_array_sum_single = -math.inf\n        current_max_kadane = 0\n\n        for i in range(len(arr)):\n            x = arr[i]\n            total_sum += x\n\n            # Max prefix sum\n            current_prefix_sum += x\n            if current_prefix_sum > max_prefix_sum:\n                max_prefix_sum = current_prefix_sum\n\n            # Max suffix sum (iterating from end for conceptual simplicity, but done in one pass)\n            # This requires a separate loop or careful state management in one pass.\n            # Let's do it in one pass by summing from both ends (conceptually).\n            # For actual suffix, we need to iterate backward or use a separate variable.\n\n            # Kadane's algorithm\n            current_max_kadane += x\n            if current_max_kadane > max_sub_array_sum_single:\n                max_sub_array_sum_single = current_max_kadane\n            if current_max_kadane < 0:\n                current_max_kadane = 0\n\n        # Compute max suffix sum separately\n        for i in range(len(arr) - 1, -1, -1):\n            x = arr[i]\n            current_suffix_sum += x\n            if current_suffix_sum > max_suffix_sum:\n                max_suffix_sum = current_suffix_sum\n        \n        # Handle case where all elements are negative for maxSubarraySumSingle\n        if max_sub_array_sum_single == 0 and any(x < 0 for x in arr):\n             max_sub_array_sum_single = max(arr)\n\n\n        return ArrayStatistics(total_sum, max_prefix_sum, max_suffix_sum, max_sub_array_sum_single)\n\n    @staticmethod\n    def compute_for_k(stats: ArrayStatistics, k: int) -> int:\n        \"\"\"Calculates the maximum subarray sum for an array repeated k times.\"\"\"\n        if k == 1:\n            return stats.maxSubarraySumSingle\n\n        # Case 1: The max subarray is fully contained within a single original array (e.g., in the first or last copy).\n        # This is already captured by stats.maxSubarraySumSingle.\n        \n        # Case 2: The max subarray spans across the boundary of two copies.\n        # This would be max suffix sum of the first copy + max prefix sum of the next copy.\n        candidate_cross_two_arrays = stats.maxSuffixSum + stats.maxPrefixSum\n        \n        # Case 3: The max subarray spans across multiple copies,\n        # including full copies of the array in the middle.\n        # This is only beneficial if the total sum of the array is positive.\n        if stats.totalSum > 0:\n            candidate_with_middle_arrays = stats.maxSuffixSum + (k - 2) * stats.totalSum + stats.maxPrefixSum\n            return max(stats.maxSubarraySumSingle, candidate_cross_two_arrays, candidate_with_middle_arrays)\n        else:\n            # If totalSum is not positive, repeating the array multiple times\n            # by adding full copies will only decrease or keep the sum same.\n            # So, the maximum sum will either be within a single array, or span at most two arrays.\n            return max(stats.maxSubarraySumSingle, candidate_cross_two_arrays)\n\n\ndef max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in the modified array formed by\n    repeating the given array k times.\n    \"\"\"\n    if not isinstance(k, int) or k < 1:\n        raise ValueError(\"k must be an integer >= 1\")\n    if n != len(arr):\n        raise ValueError(\"n must be equal to len(arr)\")\n\n    if not arr: # Handle empty array case. Max sum for an empty array is 0.\n        return 0\n\n    if k == 1:\n        return ComputationEngine.compute_single_kadane(arr)\n    else:\n        stats = ComputationEngine.compute_prefix_suffix(arr)\n        return ComputationEngine.compute_for_k(stats, k)\n```"}
