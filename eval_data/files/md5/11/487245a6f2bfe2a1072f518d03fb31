{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"Calculates the nth Bell number, which is the number of partitions of a set with n elements.\n    This implementation uses the Bell triangle method for computation.\"\"\"\n    if n == 0:\n        return 1\n    if n == 1:\n        return 1\n\n    # Initialize a list of lists to store the Bell triangle.\n    # Each row `i` will have `i+1` elements.\n    bell_triangle = [[0] * (i + 1) for i in range(n + 1)]\n\n    # The first element of the first row (B(0)) is 1.\n    bell_triangle[0][0] = 1\n\n    # Fill the Bell triangle row by row.\n    for i in range(1, n + 1):\n        # The first element of the current row is the last element of the previous row.\n        bell_triangle[i][0] = bell_triangle[i-1][i-1]\n        # Fill the remaining elements of the current row using the recurrence relation.\n        for j in range(1, i + 1):\n            bell_triangle[i][j] = bell_triangle[i-1][j-1] + bell_triangle[i][j-1]\n\n    # The nth Bell number is the first element of the nth row of the triangle.\n    return bell_triangle[n][0]"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(n) -> bool:\n    \"\"\"Return True iff n is representable as difference of two integer squares.\n\n    Raises:\n        TypeError: if n is not an int.\n    \"\"\"\n    def _validate_integer(val) -> None:\n        \"\"\"Internal: raise TypeError if val is not int.\"\"\"\n        if not isinstance(val, int):\n            raise TypeError(\"n must be an integer\")\n\n    _validate_integer(n)\n    return n % 4 != 2"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(lst: list) -> list:\n    \"\"\"\n    Sorts a list of elements using the Comb Sort algorithm.\n    Returns a new list with elements sorted in non-decreasing order.\n    \"\"\"\n    def _compute_next_gap(current_gap: int) -> int:\n        \"\"\"Applies the shrink factor to compute the next gap.\"\"\"\n        current_gap = int(current_gap / 1.3)\n        if current_gap < 1:\n            return 1\n        return current_gap\n\n    def _compare_and_swap(inner_lst: list, i: int, j: int) -> None:\n        \"\"\"Compares elements at indices i and j and swaps them if out of order.\"\"\"\n        if inner_lst[i] > inner_lst[j]:\n            inner_lst[i], inner_lst[j] = inner_lst[j], inner_lst[i]\n\n    n = len(lst)\n    arr = list(lst)  # Create a mutable copy to sort\n    gap = n\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = _compute_next_gap(gap)\n        swapped = False\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                _compare_and_swap(arr, i, i + gap)\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(patterns, items):\n    \"\"\"\n    Checks if the items sequence follows the pattern sequence with a one-to-one mapping.\n    Returns True if a bijection exists, False otherwise.\n    \"\"\"\n    if len(patterns) != len(items):\n        return False\n\n    if not patterns:  # Both must be empty due to previous length check\n        return True\n\n    pattern_to_item = {}\n    item_to_pattern = {}\n\n    for i in range(len(patterns)):\n        pattern_element = patterns[i]\n        item_element = items[i]\n\n        # Check mapping from pattern to item\n        if pattern_element in pattern_to_item:\n            if pattern_to_item[pattern_element] != item_element:\n                return False  # Existing pattern maps to a different item\n        else:\n            pattern_to_item[pattern_element] = item_element\n\n        # Check mapping from item to pattern\n        if item_element in item_to_pattern:\n            if item_to_pattern[item_element] != pattern_element:\n                return False  # Existing item maps to a different pattern\n        else:\n            item_to_pattern[item_element] = pattern_element\n\n    return True"}
