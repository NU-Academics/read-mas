{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix):\n    \"\"\"\n    Checks if a given matrix is a magic square according to defined rules.\n    This includes validating shape, element types, uniqueness, and constant sums across rows, columns, and diagonals.\n    \"\"\"\n\n    class Matrix:\n        \"\"\"Represents the input matrix with its dimension and grid data.\"\"\"\n        def __init__(self, grid):\n            self.grid = grid\n            self.n = len(grid) if grid else 0\n\n        def get_dimension(self):\n            return self.n\n\n        def is_square(self):\n            if not self.grid:\n                return False\n            n = self.get_dimension()\n            for row in self.grid:\n                if not isinstance(row, list) or len(row) != n:\n                    return False\n            return True\n\n    class MagicSquareTest:\n        \"\"\"Orchestrates the complete validation process for determining a magic square.\"\"\"\n        def __init__(self):\n            self.matrix_obj = None\n            self.n = 0\n            self.magic_constant = 0\n            self.seen = set()\n\n        def magic_square_test(self, matrix_list):\n            \"\"\"Performs all checks to determine if the input matrix is a magic square.\"\"\"\n            self.matrix_obj = Matrix(matrix_list)\n            self.n = self.matrix_obj.get_dimension()\n\n            if not self.validate_shape():\n                return False\n            if not self.validate_elements():\n                return False\n            if not self.check_uniqueness():\n                return False\n\n            self.compute_magic_constant()\n\n            if not self.check_rows():\n                return False\n            if not self.check_columns():\n                return False\n            if not self.check_diagonals():\n                return False\n\n            return True\n\n        def validate_shape(self):\n            \"\"\"Ensures the matrix is non-empty and has a square (n x n) shape.\"\"\"\n            if not self.matrix_obj.grid:\n                return False\n            return self.matrix_obj.is_square()\n\n        def validate_elements(self):\n            \"\"\"Confirms all elements within the matrix are integers.\"\"\"\n            for row in self.matrix_obj.grid:\n                for val in row:\n                    if not isinstance(val, int):\n                        return False\n            return True\n\n        def check_uniqueness(self):\n            \"\"\"Verifies all elements are unique and fall within the range from 1 to n*n.\"\"\"\n            expected_max_val = self.n * self.n\n            \n            for row in self.matrix_obj.grid:\n                for val in row:\n                    if not (1 <= val <= expected_max_val):\n                        return False\n                    if val in self.seen:\n                        return False\n                    self.seen.add(val)\n            \n            return len(self.seen) == expected_max_val\n\n        def compute_magic_constant(self):\n            \"\"\"Calculates the target sum (magic constant) that all rows, columns, and diagonals must equal.\"\"\"\n            self.magic_constant = self.n * (self.n * self.n + 1) // 2\n\n        def check_rows(self):\n            \"\"\"Checks if the sum of each row matches the calculated magic constant.\"\"\"\n            for row in self.matrix_obj.grid:\n                if sum(row) != self.magic_constant:\n                    return False\n            return True\n\n        def check_columns(self):\n            \"\"\"Checks if the sum of each column matches the calculated magic constant.\"\"\"\n            col_sums = [0] * self.n\n            for r_idx in range(self.n):\n                for c_idx in range(self.n):\n                    col_sums[c_idx] += self.matrix_obj.grid[r_idx][c_idx]\n            for col_sum in col_sums:\n                if col_sum != self.magic_constant:\n                    return False\n            return True\n\n        def check_diagonals(self):\n            \"\"\"Checks if the sums of both main diagonals match the calculated magic constant.\"\"\"\n            primary_diag_sum = 0\n            secondary_diag_sum = 0\n            for i in range(self.n):\n                primary_diag_sum += self.matrix_obj.grid[i][i]\n                secondary_diag_sum += self.matrix_obj.grid[i][self.n - 1 - i]\n\n            if primary_diag_sum != self.magic_constant:\n                return False\n            if secondary_diag_sum != self.magic_constant:\n                return False\n            return True\n\n    return MagicSquareTest().magic_square_test(matrix)"}
{"task_id": "Mbpp/131", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\ndef is_vowel(c: str) -> bool:\n    \"\"\"Checks if a character is considered a vowel.\"\"\"\n    return c in VOWELS\n\ndef collect_vowels(s: str) -> tuple[list[int], list[str]]:\n    \"\"\"Gathers the indices and characters of all vowels in the string.\"\"\"\n    vowel_positions = []\n    vowel_chars = []\n    for i, char in enumerate(s):\n        if is_vowel(char):\n            vowel_positions.append(i)\n            vowel_chars.append(char)\n    return vowel_positions, vowel_chars\n\ndef reinsert_vowels(s: str, positions: list[int], chars: list[str]) -> str:\n    \"\"\"Constructs a new string by replacing characters at specified positions.\"\"\"\n    s_list = list(s)\n    for i, pos in enumerate(positions):\n        s_list[pos] = chars[i]\n    return \"\".join(s_list)\n\ndef reverse_vowels(s: str) -> str:\n    \"\"\"Reverses only the vowels in a given string, keeping non-vowels in place.\"\"\"\n    if not s:\n        return \"\"\n\n    vowel_positions, vowel_chars = collect_vowels(s)\n\n    if not vowel_chars:\n        return s\n\n    vowel_chars.reverse()\n    return reinsert_vowels(s, vowel_positions, vowel_chars)"}
{"task_id": "Mbpp/133", "solution": "def sum_negativenum(numbers: list) -> float:\n    \"\"\"Calculates the sum of negative numbers in a list using a layered architecture.\"\"\"\n\n    from typing import List, Any\n\n    # --- Domain classes (equivalent to src/domain.py) ---\n    class Number:\n        \"\"\"Represents a single numeric value.\"\"\"\n        def __init__(self, value: float) -> None:\n            self.value = value\n\n        def is_negative(self) -> bool:\n            \"\"\"Checks if the number is strictly negative.\"\"\"\n            return self.value < 0\n\n    class NumberList:\n        \"\"\"A container for a list of Number objects.\"\"\"\n        def __init__(self, elements: List[Number]) -> None:\n            self._elements = elements\n\n        @property\n        def elements(self) -> List[Number]:\n            \"\"\"Returns the internal list of Number objects.\"\"\"\n            return self._elements\n\n        def is_empty(self) -> bool:\n            \"\"\"Checks if the NumberList contains any elements.\"\"\"\n            return not self._elements\n\n        def has_negative(self) -> bool:\n            \"\"\"Checks if any element in the list is negative.\"\"\"\n            return any(num.is_negative() for num in self._elements)\n\n    class SumResult:\n        \"\"\"Holds the calculated sum total.\"\"\"\n        def __init__(self, total: float) -> None:\n            self.total = total\n\n    # --- Validator module (equivalent to src/validator.py) ---\n    def _is_numeric(value: Any) -> bool:\n        \"\"\"Determines if a given value is an integer or float.\"\"\"\n        return isinstance(value, (int, float))\n\n    class Validator:\n        \"\"\"Validates input data and converts it into a structured NumberList.\"\"\"\n        @staticmethod\n        def validate(input_value: object) -> NumberList:\n            \"\"\"Validates that input is a list of numeric values.\"\"\"\n            if not isinstance(input_value, list):\n                raise TypeError(\"input must be a list of numeric values\")\n\n            numeric_elements: List[Number] = []\n            for item in input_value:\n                if not _is_numeric(item):\n                    raise TypeError(\"input must be a list of numeric values\")\n                numeric_elements.append(Number(float(item)))\n            return NumberList(numeric_elements)\n\n    # --- Calculator module (equivalent to src/calculator.py) ---\n    class Calculator:\n        \"\"\"Performs the core computation of summing negative numbers.\"\"\"\n        @staticmethod\n        def sum_negatives(number_list: NumberList) -> SumResult:\n            \"\"\"Sums all strictly negative numbers found within the NumberList.\"\"\"\n            total = 0.0\n            for num in number_list.elements:\n                if num.is_negative():\n                    total += num.value\n            return SumResult(total=total)\n\n    # --- Service module (equivalent to src/sum_negative_num_service.py) ---\n    class SumNegativeNumService:\n        \"\"\"Orchestrates the validation and calculation steps.\"\"\"\n        def __init__(self, validator: Validator = None, calculator: Calculator = None) -> None:\n            self.validator = validator if validator is not None else Validator()\n            self.calculator = calculator if calculator is not None else Calculator()\n\n        def sum_negativenum(self, number_list: NumberList) -> SumResult:\n            \"\"\"Delegates the summation task to the Calculator component.\"\"\"\n            return self.calculator.sum_negatives(number_list)\n\n    # --- Public API implementation logic ---\n    # Instantiate the necessary components for orchestration.\n    validator_instance = Validator()\n    calculator_instance = Calculator()\n    service_instance = SumNegativeNumService(validator=validator_instance, calculator=calculator_instance)\n\n    # Validate the input list and transform it into a NumberList object.\n    number_list_obj = validator_instance.validate(numbers)\n\n    # Use the service to calculate the sum of negative numbers from the validated list.\n    result = service_instance.sum_negativenum(number_list_obj)\n\n    # Return the final sum from the SumResult object.\n    return result.total"}
{"task_id": "Mbpp/137", "solution": "def zero_count(arr: list[int]) -> float:\n    \"\"\"Calculates the ratio of zeroes to non-zeroes in an array of integers.\n    Raises ValueError if the count of non-zeroes is zero.\"\"\"\n    num_zeros = 0\n    num_non_zeros = 0\n\n    for x in arr:\n        if x == 0:\n            num_zeros += 1\n        else:\n            num_non_zeros += 1\n\n    if num_non_zeros == 0:\n        raise ValueError(\"non-zero count is zero; cannot divide\")\n\n    return float(num_zeros) / num_non_zeros"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(n) -> bool:\n    \"\"\"\n    Return True if n (int) can be expressed as a sum of distinct non-zero powers of two (2^k for k>=1).\n    If n < 2, return False; otherwise, return True if n is even, based on the SRS interpretation.\n    \"\"\"\n    if n < 2:\n        return False\n    return n % 2 == 0"}
{"task_id": "Mbpp/139", "solution": "import math\n\nclass Circle:\n    \"\"\"Represents a circle with a given radius and can compute its circumference.\"\"\"\n    def __init__(self, radius: float) -> None:\n        self.radius = float(radius)\n        self.circumference: float | None = None\n\n    def compute_circumference(self) -> float:\n        \"\"\"Computes the circumference using 2 * pi * radius.\"\"\"\n        self.circumference = 2 * math.pi * self.radius\n        return self.circumference\n\nclass CircleCircumferenceFunction:\n    \"\"\"Coordinates the circumference computation using a Circle object.\"\"\"\n    name: str = \"circle_circumference\"\n\n    def compute(self, radius: float) -> float:\n        \"\"\"Accepts a radius and returns the computed circumference.\"\"\"\n        circle = Circle(radius)\n        return circle.compute_circumference()\n\ndef circle_circumference(radius: float) -> float:\n    \"\"\"\n    Calculates the circumference of a circle given its radius.\n    Delegates the computation to an internal coordinator class.\n    \"\"\"\n    calculator = CircleCircumferenceFunction()\n    return calculator.compute(radius)"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(a, b, c):\n    \"\"\"\n    Counts items that are identical in the same position across three lists.\n    Compares elements up to the length of the shortest input list.\n    \"\"\"\n    min_len = min(len(a), len(b), len(c))\n    matched_count = 0\n    for i in range(min_len):\n        if a[i] == b[i] == c[i]:\n            matched_count += 1\n    return matched_count"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(input_list: List[Union[list, tuple]]) -> List[float]:\n    \"\"\"\n    Returns a deterministic sorted list of unique numeric values found in the provided inner iterables.\n    This function does not modify the input_list or any inner iterables.\n    \"\"\"\n    unique_numbers = set()\n    for inner_iterable in input_list:\n        for number in inner_iterable:\n            unique_numbers.add(number)\n    return sorted(list(unique_numbers))"}
{"task_id": "Mbpp/141", "solution": "class ComparisonError(TypeError):\n    \"\"\"Raised when elements in a list are not mutually comparable.\"\"\"\n    pass\n\nclass Element:\n    \"\"\"Wraps a value, providing a comparison method.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def compareTo(self, other_element):\n        \"\"\"Compares this element to another, returning -1, 0, or 1.\"\"\"\n        other_value = other_element.value if isinstance(other_element, Element) else other_element\n\n        try:\n            if self.value < other_value:\n                return -1\n            elif self.value > other_value:\n                return 1\n            else:\n                return 0\n        except TypeError:\n            raise ComparisonError(f\"Elements '{self.value}' and '{other_value}' are not comparable.\")\n\nclass List:\n    \"\"\"A domain wrapper for a list of elements.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n        self._element_wrappers = [Element(e) for e in elements]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\n    def get(self, index: int) -> Element:\n        \"\"\"Returns the Element wrapper at the specified index.\"\"\"\n        return self._element_wrappers[index]\n\nclass InputValidator:\n    \"\"\"Validates the comparability of elements in a List.\"\"\"\n    def assert_comparable(self, list_wrapper: List) -> None:\n        \"\"\"Raises ComparisonError if elements are not mutually comparable.\"\"\"\n        if list_wrapper.length() <= 1:\n            return\n\n        for i in range(list_wrapper.length()):\n            for j in range(i + 1, list_wrapper.length()):\n                list_wrapper.get(i).compareTo(list_wrapper.get(j))\n                list_wrapper.get(j).compareTo(list_wrapper.get(i))\n\n    def validate(self, list_wrapper: List) -> bool:\n        \"\"\"Returns True if elements are mutually comparable, False otherwise.\"\"\"\n        try:\n            self.assert_comparable(list_wrapper)\n            return True\n        except ComparisonError:\n            return False\n\nclass PancakeFlipSortEngine:\n    \"\"\"Sorts a list using the pancake flip algorithm.\"\"\"\n    def sort(self, list_wrapper: List) -> List:\n        \"\"\"Sorts the elements of the List wrapper and returns a new sorted List wrapper.\"\"\"\n        elements_to_sort = list_wrapper._element_wrappers[:]\n        n = len(elements_to_sort)\n\n        for curr_size in range(n, 1, -1):\n            max_idx = self._find_max_index(elements_to_sort, curr_size)\n\n            if max_idx != curr_size - 1:\n                self._flip(elements_to_sort, max_idx + 1)\n                self._flip(elements_to_sort, curr_size)\n        \n        sorted_values = [e.value for e in elements_to_sort]\n        return List(sorted_values)\n\n    def _find_max_index(self, arr: list, n: int) -> int:\n        \"\"\"Finds the index of the maximum element in arr[0...n-1].\"\"\"\n        mi = 0\n        for i in range(n):\n            if arr[i].compareTo(arr[mi]) > 0:\n                mi = i\n        return mi\n\n    def _flip(self, arr: list, k: int) -> None:\n        \"\"\"Reverses the prefix arr[0...k-1] in place.\"\"\"\n        start = 0\n        end = k - 1\n        while start < end:\n            arr[start], arr[end] = arr[end], arr[start]\n            start += 1\n            end -= 1\n\nclass PancakeSorter:\n    \"\"\"Orchestrates validation and sorting using the pancake flip algorithm.\"\"\"\n    def __init__(self):\n        self.validator = InputValidator()\n        self.sort_engine = PancakeFlipSortEngine()\n\n    def pancake_sort(self, input_list_native: list) -> List:\n        \"\"\"Validates a native Python list and sorts its elements.\"\"\"\n        list_wrapper = List(input_list_native[:])\n\n        self.validator.assert_comparable(list_wrapper)\n\n        sorted_list_wrapper = self.sort_engine.sort(list_wrapper)\n\n        return sorted_list_wrapper\n\ndef pancake_sort(list_to_sort: list) -> list:\n    \"\"\"\n    Sorts a list of elements using the pancake flip algorithm.\n    Validates elements for mutual comparability and returns a new sorted list.\n    \"\"\"\n    sorter = PancakeSorter()\n    sorted_list_wrapper = sorter.pancake_sort(list_to_sort)\n    return sorted_list_wrapper.elements"}
{"task_id": "Mbpp/145", "solution": "from typing import Iterable, List, Union\nfrom datetime import datetime\n\nNumber = Union[int, float]\n\nclass Sequence:\n    \"\"\"Represents an input ordered collection, providing validation helpers.\"\"\"\n    def __init__(self, elements: Iterable[Number]) -> None:\n        self.elements: List[Number] = list(elements)\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the sequence.\"\"\"\n        return len(self.elements)\n\n    def is_numeric(self) -> bool:\n        \"\"\"Checks if all elements in the sequence are numeric (int or float).\"\"\"\n        return all(isinstance(item, (int, float)) for item in self.elements)\n\nclass Element:\n    \"\"\"Simple value container representing a single numeric element.\"\"\"\n    def __init__(self, value: Number) -> None:\n        self.value: Number = value\n\nclass Result:\n    \"\"\"Data container holding a computed result and an optional timestamp.\"\"\"\n    def __init__(self, value: Number, computed_at: datetime | None = None) -> None:\n        self.value: Number = value\n        self.computed_at: datetime | None = computed_at\n\nclass MaxAbsDiffFunction:\n    \"\"\"Encapsulates validation orchestration and the core difference computation.\"\"\"\n    name: str = \"max_Abs_Diff\"\n\n    def execute(self, seq: Sequence) -> Number:\n        \"\"\"Executes the computation for maximum absolute difference.\"\"\"\n        if seq.length() < 2:\n            raise ValueError(\"sequence requires >= 2 elements\")\n        if not seq.is_numeric():\n            raise TypeError(\"sequence must contain only numeric elements\")\n\n        values = seq.elements\n        min_val = min(values)\n        max_val = max(values)\n        return abs(max_val - min_val)\n\ndef max_Abs_Diff(seq: (list | tuple)) -> Number:\n    \"\"\"\n    Finds the maximum absolute difference between any two elements in a given sequence.\n    This function validates input and delegates computation to domain objects.\n    \"\"\"\n    if not isinstance(seq, (list, tuple)):\n        raise TypeError(\"input must be list or tuple\")\n    \n    seq_obj = Sequence(seq)\n    func = MaxAbsDiffFunction()\n    return func.execute(seq_obj)"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(source: list, removal: list) -> list:\n    \"\"\"\n    Removes all elements from the source list that are present in the removal list.\n    Preserves the relative order of the remaining elements.\n    \"\"\"\n    removal_set = set(removal)\n    result = []\n    for item in source:\n        if item not in removal_set:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/160", "solution": "from typing import Optional, Tuple\n\ndef _gcd(a: int, b: int) -> int:\n    \"\"\"Return gcd(a, b). It computes the greatest common divisor using the Euclidean algorithm.\"\"\"\n    a = abs(a)\n    b = abs(b)\n    while b:\n        a, b = b, a % b\n    return a\n\ndef extended_gcd(a: int, b: int) -> Tuple[int, int, int]:\n    \"\"\"Return (g, x, y) where g == gcd(a, b) and a*x + b*y == g.\n    The algorithm ensures g is non-negative and computes a particular set of Bezout coefficients.\"\"\"\n    # Standard iterative extended Euclidean algorithm\n    x1, y1 = 0, 1\n    x2, y2 = 1, 0\n    a_temp, b_temp = a, b\n\n    while b_temp != 0:\n        q = a_temp // b_temp\n        a_temp, b_temp = b_temp, a_temp % b_temp\n        x_temp, y_temp = x2 - q * x1, y2 - q * y1\n        x2, y2 = x1, y1\n        x1, y1 = x_temp, y_temp\n\n    # Ensure g (a_temp) is non-negative. If g is negative, flip signs of g, x, y.\n    if a_temp < 0:\n        a_temp = -a_temp\n        x2 = -x2\n        y2 = -y2\n    return a_temp, x2, y2\n\ndef _handle_zero_coefficients(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"Handle cases where a == 0 or b == 0. Returns a particular solution or None.\"\"\"\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n    elif a == 0:  # b != 0\n        return (0, n // b) if n % b == 0 else None\n    elif b == 0:  # a != 0\n        return (n // a, 0) if n % a == 0 else None\n    return None # This line should not be reached if called correctly from find_solution\n\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"Return integers (x, y) satisfying a*x + b*y == n, or None if no solution exists.\n    Deterministic: uses extended_gcd to return a consistent particular solution.\"\"\"\n    \n    # Handle cases where a or b is zero first\n    if a == 0 or b == 0:\n        return _handle_zero_coefficients(a, b, n)\n\n    # Both a and b are non-zero\n    g, x0, y0 = extended_gcd(a, b)\n\n    # Check if n is divisible by gcd(a, b)\n    if n % g != 0:\n        return None # No integer solution exists\n\n    # Scale the particular solution from extended_gcd to match n\n    k = n // g\n    x_particular = x0 * k\n    y_particular = y0 * k\n\n    # Adjust the particular solution (x_particular, y_particular) to satisfy\n    # implicit requirements from examples (e.g., specific solution rather than any valid one).\n    # The general solution is x = x_particular + (b/g)*t, y = y_particular - (a/g)*t.\n    # We choose t to bring x_particular into a canonical range.\n    \n    # Calculate the shift values for x and y\n    b_over_g = b // g\n    a_over_g = a // g\n\n    # Determine t: This logic finds a 't' that shifts x_particular towards zero.\n    # It ensures a consistent particular solution for various inputs, matching expected outputs.\n    t = -(x_particular // b_over_g)\n    \n    x_final = x_particular + b_over_g * t\n    y_final = y_particular - a_over_g * t\n\n    return (x_final, y_final)"}
{"task_id": "Mbpp/162", "solution": "from dataclasses import dataclass\nfrom typing import Optional\n\n@dataclass\nclass IntegerParameter:\n    \"\"\"Encapsulates an integer input value.\"\"\"\n    value: int\n\n@dataclass\nclass SequenceTerm:\n    \"\"\"Represents a term in the series with its index and value.\"\"\"\n    index: int\n    value: int\n\n@dataclass\nclass Result:\n    \"\"\"Holds the final accumulated integer result.\"\"\"\n    value: int\n\nclass SumSeriesFunction:\n    \"\"\"Encapsulates the computation and validation logic for the series sum.\"\"\"\n\n    def validate(self, n) -> bool:\n        \"\"\"Validates that n is an integer, raising TypeError if not.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        return True\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Computes the sum of the series (n - 2*i) for i from 0 to n // 2.\n        Returns 0 for negative input 'n'.\n        \"\"\"\n        if n < 0:\n            return 0\n\n        m = n // 2\n        total = 0\n        for i in range(0, m + 1):\n            term_value = n - 2 * i\n            total += term_value\n        return total\n\ndef sum_series(n) -> int:\n    \"\"\"\n    Calculates the sum (n - 2*i) from i=0 to n // 2.\n    For instance n + (n-2) + (n-4)... (until n-x <= 0).\n    \"\"\"\n    processor = SumSeriesFunction()\n    processor.validate(n)\n    return processor.compute(n)"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"Return smallest power of two (2**k) such that result >= n. For n == 0 returns 1.\"\"\"\n    if n == 0:\n        return 1\n\n    power = 1\n    while power < n:\n        power *= 2\n    return power"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input: str) -> int:\n    from typing import Optional\n\n    # Helper class: InputString represents the provided input string.\n    class InputString:\n        def __init__(self, value: str):\n            self.value = value\n        def length(self) -> int:\n            return len(self.value)\n\n    # Helper class: Character represents a single character with its 1-based index.\n    class Character:\n        def __init__(self, value: str, index: int):\n            self.value = value\n            self.index = index\n        def is_alphabetic(self) -> bool:\n            # Checks if the character is an ASCII English letter (A-Z or a-z).\n            return 'a' <= self.value <= 'z' or 'A' <= self.value <= 'Z'\n\n    # Helper class: AlphabetLetter provides mapping from ASCII letter to alphabet position.\n    class AlphabetLetter:\n        @staticmethod\n        def position_for(letter: str) -> Optional[int]:\n            # Maps an ASCII English letter to its 1-based alphabet position, or None if not an English letter.\n            if 'a' <= letter <= 'z':\n                return ord(letter) - ord('a') + 1\n            return None\n\n    # Helper class: PositionChecker iterates and counts matches.\n    class PositionChecker:\n        def count(self, input_string_obj: InputString) -> int:\n            match_count = 0\n            # Iterate through the string using 0-based index `i`, converting to 1-based position `one_based_index`.\n            for i in range(input_string_obj.length()):\n                char_value = input_string_obj.value[i]\n                one_based_index = i + 1\n\n                # Use the Character helper to check if the current character is an ASCII alphabetic letter.\n                if not Character(char_value, one_based_index).is_alphabetic():\n                    continue\n\n                # Normalize the character to lowercase for alphabet position lookup.\n                normalized_char = char_value.lower()\n                alphabet_position = AlphabetLetter.position_for(normalized_char)\n\n                # Increment count if the character's alphabet position matches its 1-based string index.\n                if alphabet_position is not None and alphabet_position == one_based_index:\n                    match_count += 1\n            return match_count\n\n    # The public function orchestrates the process using the helper classes.\n    input_string_obj = InputString(value=input)\n    position_checker = PositionChecker()\n    final_count = position_checker.count(input_string_obj)\n    return final_count"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(input_list):\n    \"\"\"Counts pairs of integers in a list whose bitwise XOR is an even number.\"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for element in input_list:\n        if element % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # Number of ways to choose 2 items from N is N * (N - 1) // 2\n    pairs_from_evens = even_count * (even_count - 1) // 2\n    pairs_from_odds = odd_count * (odd_count - 1) // 2\n\n    return pairs_from_evens + pairs_from_odds"}
