{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    indices_to_sort = [i for i in range(len(l)) if i % 3 == 0]\n    elements_to_sort = [l[i] for i in indices_to_sort]\n    sorted_elements = sorted(elements_to_sort)\n\n    result = list(l) # Create a shallow copy of the list\n    \n    for i, original_index in enumerate(indices_to_sort):\n        result[original_index] = sorted_elements[i]\n        \n    return result"}
{"task_id": "HumanEval/36", "solution": "from __future__ import annotations\n\nclass DigitCounter:\n    \"\"\"Utility to count occurrences of digit 7 in an integer.\"\"\"\n    @staticmethod\n    def count_digit7(number: int) -> int:\n        return str(number).count('7')\n\n\nclass Number:\n    \"\"\"Represents an integer with divisibility flags and digit count.\"\"\"\n    def __init__(self, value: int):\n        self.value: int = value\n        self.div_by_11: bool = (value % 11 == 0)\n        self.div_by_13: bool = (value % 13 == 0)\n        self.digit7_count: int = 0\n\n    def evaluate(self, counter: DigitCounter) -> None:\n        if self.div_by_11 or self.div_by_13:\n            self.digit7_count = counter.count_digit7(self.value)\n\n\nclass Result:\n    \"\"\"Aggregates digit7 counts from a list of Number objects.\"\"\"\n    def __init__(self):\n        self.total_count: int = 0\n\n    def add(self, number: Number) -> None:\n        self.total_count += number.digit7_count\n\n    def get_total(self) -> int:\n        return self.total_count\n\n\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    counter = DigitCounter()\n    result = Result()\n\n    for i in range(1, n):\n        num = Number(i)\n        num.evaluate(counter)\n        result.add(num)\n\n    return result.get_total()"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # Split string to groups of length 3, same as encoding.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # Reverse the cyclic shift: move the last character to the front for groups of 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    n = len(xs)\n\n    # Validate inputs based on design context: even number of coefficients and non-zero leading coefficient.\n    if n % 2 != 0:\n        raise ValueError(\"Number of coefficients must be even.\")\n    if n == 0 or xs[n - 1] == 0:\n        raise ValueError(\"Leading coefficient cannot be zero.\")\n\n    # Handle the linear case (n=2 coefficients) directly.\n    if n == 2:\n        # For f(x) = c0 + c1*x = 0, the root is x = -c0 / c1.\n        return -float(xs[0]) / xs[1]\n\n    # For higher-degree odd polynomials, use a bisection method to find a root.\n    # An odd-degree polynomial is guaranteed to have at least one real root.\n    # We choose a sufficiently large initial interval for the search.\n    low, high = -1000.0, 1000.0\n    \n    # Check if the root happens to be exactly at the initial bounds (rare but good for robustness).\n    tolerance = 1e-7\n    if abs(poly(xs, low)) < tolerance:\n        return low\n    if abs(poly(xs, high)) < tolerance:\n        return high\n\n    # Perform bisection for a fixed number of iterations to achieve desired precision.\n    for _ in range(100): # 100 iterations provide high precision for typical float ranges.\n        mid = (low + high) / 2.0\n        val_mid = poly(xs, mid)\n\n        if abs(val_mid) < tolerance: # Found a root within the specified tolerance.\n            return mid\n\n        # Narrow down the interval based on the sign of poly(mid).\n        if poly(xs, low) * val_mid < 0:\n            high = mid\n        else:\n            low = mid\n            \n    # After iterations, 'low' and 'high' will be very close to a root; return their average.\n    return (low + high) / 2.0"}
