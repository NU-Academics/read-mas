hile x:\n                s += x % 10\n                x //= 10\n            return s\n\n        def sum_digits_to_binary(self, n: int) -> str:\n            total = self.sum_digits(n)\n            return \"0\" if total == 0 else bin(total)[2:]\n\n        def compute(self, n: int) -> DigitSumResult:\n            total = self.sum_digits(n)\n            result = DigitSumResult(total)\n            if self._repository:\n                self._repository.save(result)\n            return result\n\n    class CLIController:\n        def __init__(self, parser: ParserAdapter, validator: Validator, service: DigitSumService) -> None:\n            self._parser = parser\n            self._validator = validator\n            self._service = service\n\n        # The run method is not directly used by solve, but is part of the class definition.\n        # It relies on `sys` which is not imported for the `solve` function's direct use.\n        # This method is included for completeness based on the design, but won't be executed by solve.\n        def run(self, argv: List[str]) -> int:\n            import sys # Import sys locally here to avoid global import if not strictly needed by solve\n            try:\n                raw = argv[0] if len(argv) >= 1 else sys.stdin.readline()\n                binary = self.solve_and_print(raw)\n                print(binary)\n                return 0\n            except InvalidInputError as e:\n                print(f\"Error: {e}\", file=sys.stderr)\n                return 2\n\n        def solve_and_print(self, input_value: Union[str, int]) -> str:\n            n = self._parser.parse_input(input_value)\n            self._validator.validate(n)\n            result = self._service.compute(n)\n            return result.to_binary()\n\n    def create_default() -> Tuple[ParserAdapter, Validator, DigitSumService, CLIController]:\n        parser = ParserAdapter()\n        validator = Validator(min_value=0, max_value=10000)\n        repository = NoOpRepository()\n        service = DigitSumService(repository=repository)\n        controller = CLIController(parser=parser, validator=validator, service=service)\n        return parser, validator, service, controller\n\n    parser, validator, service, controller = create_default()\n    return controller.solve_and_print(N)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/85": [{"task_id": "HumanEval/85", "solution": "from typing import List\nclass ValidationError(Exception):\n    \"\"\"Domain exception for validation-related errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass InputListDTO:\n    \"\"\"Lightweight DTO holding the list of integers.\"\"\"\n    def __init__(self, lst: List[int]) -> None:\n        self._lst = lst\n\n    def lst(self) -> List[int]:\n        return self._lst\nclass Validator:\n    \"\"\"Validates InputListDTO follows business rules.\"\"\"\n    def validate(self, dto: InputListDTO) -> None:\n        lst = dto.lst()\n        if not isinstance(lst, list) or len(lst) == 0:\n            raise ValidationError(\"Input must be a non-empty list of integers.\")\n        for i, v in enumerate(lst):\n            if not isinstance(v, int):\n                raise ValidationError(f\"Element at index {i} is not an integer: {v!r}\")\nclass Adder:\n    \"\"\"Computes the sum of even elements located at odd indices.\"\"\"\n    def add(self, lst: List[int]) -> int:\n        total = 0\n        for i, v in enumerate(lst):\n            if i % 2 == 1 and v % 2 == 0:\n                total += v\n        return total\nclass AddService:\n    \"\"\"Orchestrates validation and computation.\"\"\"\n    def __init__(self, adder: Adder, validator: Validator) -> None:\n        self._adder = adder\n        self._validator = validator\n\n    def compute(self, input_dto: InputListDTO) -> int:\n        self._validator.validate(input_dto)\n        return self._adder.add(input_dto.lst())\ndef add(lst: List[int]) -> int:\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n\n    Examples:\n        add([4, 2, 6, 7]) ==> 2 \n    \"\"\"\n    dto = InputListDTO(lst)\n    service = AddService(adder=Adder(), validator=Validator())\n    return service.compute(dto)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices.\n    \"\"\"\n    total = 0\n    for idx, val in enumerate(lst):\n        if idx % 2 == 1 and val % 2 == 0:\n            total += val\n    return total", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/86": [{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n    import re\n\n    # Tokenize the string into sequences of non-whitespace characters (words)\n    # and sequences of whitespace characters (spaces).\n    # This regex ensures that both words and contiguous blocks of spaces are\n    # extracted as separate tokens, preserving their original order.\n    tokens = re.findall(r'\\s+|\\S+', s)\n\n    processed_tokens = []\n    for token in tokens:\n        # Check if the token consists entirely of whitespace characters.\n        # If it is, it should be kept unchanged as per the requirement.\n        if token.isspace():\n            processed_tokens.append(token)\n        else:\n            # If the token is a word (non-whitespace), sort its characters\n            # in ascending order based on their ASCII values and rejoin them.\n            processed_tokens.append(''.join(sorted(token)))\n\n    # Join all the processed tokens back together to form the final string.\n    return ''.join(processed_tokens)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\n\n123 456\n789\n"]]}, {"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n    from typing import List\n\n    class Token:\n        def __init__(self, text: str) -> None:\n            self._text = text\n\n        @property\n        def text(self) -> str:\n            return self._text\n\n        def __repr__(self) -> str:\n            return f\"{self.__class__.__name__}(text='{self._text}')\"\n\n    class WordToken(Token):\n        def __init__(self, text: str) -> None:\n            super().__init__(text)\n\n    class SpaceToken(Token):\n        def __init__(self, text: str) -> None:\n            super().__init__(text)\n\n    class CharSorter:\n        @staticmethod\n        def sort_ascii(s: str) -> str:\n            return \"\".join(sorted(s))\n\n        @staticmethod\n        def is_space_char(ch: str) -> bool:\n            return ch == ' '\n\n    class Tokenizer:\n        def __init__(self) -> None:\n            pass\n\n        def tokenize(self, text: str) -> List[Token]:\n            if not text:\n                return []\n            \n            tokens = []\n            current_idx = 0\n            n = len(text)\n\n            while current_idx < n:\n                if CharSorter.is_space_char(text[current_idx]):\n                    start_space = current_idx\n                    while current_idx < n and CharSorter.is_space_char(text[current_idx]):\n                        current_idx += 1\n                    tokens.append(SpaceToken(text[start_space:current_idx]))\n                else:\n                    start_word = current_idx\n                    while current_idx < n and not CharSorter.is_space_char(text[current_idx]):\n                        current_idx += 1\n                    tokens.append(WordToken(text[start_word:current_idx]))\n            return tokens\n\n    class Transformer:\n        def __init__(self, char_sorter: CharSorter) -> None:\n            self._char_sorter = char_sorter\n\n        def transform_tokens(self, tokens: List[Token]) -> List[Token]:\n            transformed_tokens = []\n            for token in tokens:\n                if isinstance(token, WordToken):\n                    sorted_text = self._char_sorter.sort_ascii(token.text)\n                    transformed_tokens.append(WordToken(sorted_text))\n                else:\n                    transformed_tokens.append(token)\n            return transformed_tokens\n\n    class AntiShuffleService:\n        def __init__(self, tokenizer: Tokenizer, transformer: Transformer) -> None:\n            self._tokenizer = tokenizer\n            self._transformer = transformer\n\n        def anti_shuffle(self, text: str) -> str:\n            tokens = self._tokenizer.tokenize(text)\n            transformed_tokens = self._transformer.transform_tokens(tokens)\n            return \"\".join(token.text for token in transformed_tokens)\n\n    char_sorter = CharSorter()\n    tokenizer = Tokenizer()\n    transformer = Transformer(char_sorter)\n    service = AntiShuffleService(tokenizer, transformer)\n    return service.anti_shuffle(s)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/87": [{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds occurrences of x in a ragged 2D list and returns their coordinates.\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    \n    # Inner helper function for sorting.\n    # It receives a list of tuples (row, col) and sorts them as specified.\n    def sort_coordinates(coords):\n        # Sort by row ascending (primary key), then by column descending (secondary key)\n        return sorted(coords, key=lambda coord: (coord[0], -coord[1]))\n\n    found_coordinates = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                found_coordinates.append((r_idx, c_idx))\n\n    return sort_coordinates(found_coordinates)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/87", "solution": "from typing import Any, List, Tuple\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass Coordinate:\n    def __init__(self, row: int, col: int) -> None:\n        if not isinstance(row, int) or not isinstance(col, int):\n            raise InvalidInputError(\"Coordinate indices must be ints\")\n        if row < 0 or col < 0:\n            raise InvalidInputError(\"Coordinate indices must be non-negative\")\n        self.row = row\n        self.col = col\n\n    def tuple(self) -> Tuple[int, int]:\n        return (self.row, self.col)\n\n    def __repr__(self) -> str:\n        return f\"Coordinate(row={self.row}, col={self.col})\"\ndef validate_nested_list(lst: Any) -> List[List[int]]:\n    \"\"\"\n    Validates that the input is a list of lists of integers.\n    Raises InvalidInputError if validation fails.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise InvalidInputError(\"Input 'lst' must be a list.\")\n    \n    normalized_list = []\n    for i, row in enumerate(lst):\n        if not isinstance(row, list):\n            raise InvalidInputError(f\"Row {i} must be a list.\")\n        normalized_row = []\n        for j, elem in enumerate(row):\n            if not isinstance(elem, int):\n                raise InvalidInputError(f\"Element at ({i}, {j}) must be an integer.\")\n            normalized_row.append(elem)\n        normalized_list.append(normalized_row)\n    return normalized_list\nclass MatrixScanner:\n    def scan(self, lst: Any, x: int) -> List[Coordinate]:\n        \"\"\"\n        Scans a 2D list for occurrences of x and returns sorted coordinates.\n        Coordinates are sorted by row ascending, then by column descending.\n        \"\"\"\n        if not isinstance(x, int):\n            raise InvalidInputError(\"Search value 'x' must be an integer.\")\n        \n        matrix = validate_nested_list(lst)\n        \n        coords_by_row = {}\n        for i, row in enumerate(matrix):\n            for j, val in enumerate(row):\n                if val == x:\n                    coords_by_row.setdefault(i, []).append(j)\n        \n        result = []\n        for i in sorted(coords_by_row.keys()):\n            cols_desc = sorted(coords_by_row[i], reverse=True)\n            for j in cols_desc:\n                result.append(Coordinate(i, j))\n        return result\ndef get_row(lst, x):\n    \"\"\"\n    Finds occurrences of x in a nested list and returns their coordinates.\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    scanner = MatrixScanner()\n    coordinates = scanner.scan(lst, x)\n    \n    return [coord.tuple() for coord in coordinates]", "base_status": "pass", "plus_status": "fail", "base_fa