fies to 18 * 10^(n-2).\n        return 18 * (10 ** (n - 2))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/137": [{"task_id": "HumanEval/137", "solution": "from typing import Any, Optional\nclass CompareError(Exception):\n    \"\"\"Base exception for comparison errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass ParseError(CompareError):\n    \"\"\"Raised when an input string cannot be parsed to a number.\"\"\"\n    pass\nclass TypeUtils:\n    \"\"\"Utility class for type detection and string normalization.\"\"\"\n\n    @staticmethod\n    def is_int(value: Any) -> bool:\n        \"\"\"Checks if the value is an integer (but not a boolean).\"\"\"\n        return isinstance(value, int) and not isinstance(value, bool)\n\n    @staticmethod\n    def is_float(value: Any) -> bool:\n        \"\"\"Checks if the value is a float.\"\"\"\n        return isinstance(value, float)\n\n    @staticmethod\n    def is_str(value: Any) -> bool:\n        \"\"\"Checks if the value is a string.\"\"\"\n        return isinstance(value, str)\n\n    @staticmethod\n    def normalize_decimal_string(s: str) -> str:\n        \"\"\"Normalizes a string by replacing comma decimal separators with dots and stripping spaces.\"\"\"\n        return s.replace(',', '.').strip()\nclass NumberValue:\n    \"\"\"Encapsulates an input value with its parsed numeric representation and original type metadata.\"\"\"\n    def __init__(self, original: Any, parsed: float, original_type: str) -> None:\n        self.original = original\n        self.parsed = parsed\n        self.original_type = original_type\nclass StringNumberParser:\n    \"\"\"Converts inputs into NumberValue instances preserving original input format.\"\"\"\n    DECIMAL_COMMA: str = ','\n    DECIMAL_DOT: str = '.'\n\n    def parse(self, value: Any) -> NumberValue:\n        \"\"\"Parses an input value (int, float, or string) into a NumberValue object.\"\"\"\n        if TypeUtils.is_int(value):\n            return NumberValue(original=value, parsed=float(value), original_type=\"int\")\n        if TypeUtils.is_float(value):\n            return NumberValue(original=value, parsed=float(value), original_type=\"float\")\n        if TypeUtils.is_str(value):\n            s = TypeUtils.normalize_decimal_string(value)\n            try:\n                parsed = float(s)\n            except ValueError:\n                raise ParseError(f\"Cannot parse string to number: {value!r}\")\n            return NumberValue(original=value, parsed=parsed, original_type=\"str\")\n        raise ParseError(f\"Unsupported type for comparison: {type(value)}\")\nclass NumberComparerService:\n    \"\"\"Compares two NumberValue instances and selects the larger original input or None if equal.\"\"\"\n\n    def compare(self, n1: NumberValue, n2: NumberValue) -> Optional[Any]:\n        \"\"\"Compares two NumberValue objects and returns the original of the larger value, or None if equal.\"\"\"\n        if self._is_equal(n1.parsed, n2.parsed):\n            return None\n        return n1.original if n1.parsed > n2.parsed else n2.original\n\n    def _is_equal(self, val1: float, val2: float) -> bool:\n        \"\"\"Encapsulates the exact float equality rule.\"\"\"\n        return val1 == val2\nclass CompareController:\n    \"\"\"High-level orchestration of parsing and comparison.\"\"\"\n\n    def __init__(self, parser: Optional[StringNumberParser]=None, service: Optional[NumberComparerService]=None) -> None:\n        self.parser = parser if parser is not None else StringNumberParser()\n        self.service = service if service is not None else NumberComparerService()\n\n    def compare(self, a: Any, b: Any) -> Optional[Any]:\n        \"\"\"Parses both values and returns the larger original value or None.\"\"\"\n        n1 = self.parser.parse(a)\n        n2 = self.parser.parse(b)\n        return self.service.compare(n1, n2)\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n    \"\"\"\n    controller = CompareController()\n    return controller.compare(a, b)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/137", "solution": "import re\nfrom typing import Union, Optional, Any\nclass ParseError(Exception):\n    \"\"\"Custom exception for parsing errors.\"\"\"\n    pass\nclass NumericValue:\n    \"\"\"Represents a parsed numeric operand, preserving original value and type.\"\"\"\n    def __init__(self, original: Any, value: float, type_name: str):\n        self.original = original\n        self.value = value\n        self.type_name = type_name\n\n    def is_equal(self, other: 'NumericValue') -> bool:\n        \"\"\"Compares numeric values for equality.\"\"\"\n        return self.value == other.value\n\n    def compare_to(self, other: 'NumericValue') -> int:\n        \"\"\"Compares numeric values and returns -1, 0, or 1.\"\"\"\n        if self.value < other.value:\n            return -1\n        if self.value > other.value:\n            return 1\n        return 0\n_FLOAT_RE = re.compile(r'^[+-]?\\d+(\\.\\d+)?$')\ndef normalize_decimal_separator(s: str) -> str:\n    \"\"\"Replaces comma with dot and strips whitespace for parsing.\"\"\"\n    return s.strip().replace(',', '.')\ndef is_numeric_string(s: str) -> bool:\n    \"\"\"Validates if a string is a legal numeric representation.\"\"\"\n    return bool(_FLOAT_RE.match(s))\nclass ValueParser:\n    \"\"\"Parses various input types into NumericValue objects.\"\"\"\n    DECIMAL_SEPARATORS = {'.', ','}\n\n    def parse(self, value: Union[int, float, str]) -> NumericValue:\n        \"\"\"Dispatches