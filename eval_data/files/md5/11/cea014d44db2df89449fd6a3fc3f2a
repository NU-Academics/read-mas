_vowel(\"ab\") ==> \"\"\n    \"\"\"\n    VOWELS = set(\"aeiouAEIOU\")\n\n    def _is_vowel(char):\n        return char in VOWELS\n\n    def _is_letter(char):\n        return 'a' <= char <= 'z' or 'A' <= char <= 'Z'\n\n    def _is_consonant(char):\n        return _is_letter(char) and not _is_vowel(char)\n\n    n = len(word)\n\n    if n < 3:\n        return \"\"\n\n    for i in range(n - 2, 0, -1):\n        char_at_i = word[i]\n        char_at_i_minus_1 = word[i-1]\n        char_at_i_plus_1 = word[i+1]\n\n        if _is_vowel(char_at_i) and \\\n           _is_consonant(char_at_i_minus_1) and \\\n           _is_consonant(char_at_i_plus_1):\n            return char_at_i\n\n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/119": [{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if two given parentheses strings can be concatenated in any order to form a balanced string.\n    Uses an integer counter to efficiently determine if a string is balanced.\n    \"\"\"\n    s1, s2 = lst\n\n    def is_balanced(s):\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    if is_balanced(s1 + s2) or is_balanced(s2 + s1):\n        return 'Yes'\n    else:\n        return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    '''\n    You are given a list of two strings, both strings consist of open\n    parentheses '(' or close parentheses ')' only.\n    Your job is to check if it is possible to concatenate the two strings in\n    some order, that the resulting string will be good.\n    A string S is considered to be good if and only if all parentheses in S\n    are balanced. For example: the string '(())()' is good, while the string\n    '())' is not.\n    Return 'Yes' if there's a way to make a good string, and return 'No' otherwise.\n    '''\n    from typing import List, Tuple, Optional\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid input parameters.\"\"\"\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(self.message)\n\n    class Validators:\n        \"\"\"Utility class for validating input parameters.\"\"\"\n        @staticmethod\n        def validate_two_strings(list_input: List[str]) -> None:\n            if not (isinstance(list_input, list) and len(list_input) == 2):\n                raise InvalidInputError(\"Input must be a list of two strings\")\n            \n            for s in list_input:\n                if not isinstance(s, str):\n                    raise InvalidInputError(\"All elements in the list must be strings\")\n                if not all(c in '()' for c in s):\n                    raise InvalidInputError(\"Strings must contain only '(' or ')' characters\")\n\n    class ParenString:\n        \"\"\"Represents a string consisting of parentheses and provides balance computations.\"\"\"\n        def __init__(self, content: str) -> None:\n            self.content = content\n\n        def compute_net_balance(self) -> int:\n            \"\"\"Calculates the net balance of parentheses (open - close).\"\"\"\n            balance = 0\n            for ch in self.content:\n                balance += 1 if ch == \"(\" else -1\n            return balance\n\n        def compute_min_prefix_balance(self) -> int:\n            \"\"\"Calculates the minimum prefix balance of the string.\"\"\"\n            balance = 0\n            min_balance = 0\n            for ch in self.content:\n                balance += 1 if ch == \"(\" else -1\n                if balance < min_balance:\n                    min_balance = balance\n            return min_balance\n        \n        def length(self) -> int:\n            \"\"\"Returns the length of the string content.\"\"\"\n            return len(self.content)\n\n    class MatchResult:\n        \"\"\"Encapsulates the result of a parenthesis matching operation.\"\"\"\n        def __init__(self, can_be_good: bool, order: Optional[Tuple[str, str]]) -> None:\n            self.can_be_good = can_be_good\n            self.order = order\n\n        def as_output(self) -> str:\n            \"\"\"Returns 'Yes' if a good string can be formed, 'No' otherwise.\"\"\"\n            return 'Yes' if self.can_be_good else 'No'\n\n    class InputAdapter:\n        \"\"\"Converts raw list of strings into ParenString objects.\"\"\"\n        @staticmethod\n        def parse(list_input: List[str]) -> Tuple[ParenString, ParenString]:\n            return ParenString(list_input[0]), ParenString(list_input[1])\n\n    class MatcherService:\n        \"\"\"Provides the core logic for checking if two strings can form a good parenthesis string.\"\"\"\n        def __init__(self) -> None:\n            pass\n\n        def can_concatenate_good(self, a: ParenString, b: ParenString) -> MatchResult:\n            \"\"\"Checks both possible concatenations (a+b and b+a) for goodness.\"\"\"\n            if self._is_good_concatenation(a, b):\n                return MatchResult(True, (a.content, b.content))\n            if self._is_good_concatenation(b, a):\n                return MatchResult(True, (b.content, a.content))\n            return MatchResult(False, None)\n\n        def _is_good_concatenation(self, first: ParenString, second: ParenString) -> bool:\n            \"\"\"Determines if the concatenation of two ParenString objects is a good string.\"\"\"\n            net1 = first.compute_net_balance()\n            min1 = first.compute_min_prefix_balance()\n            \n            net2 = second.compute_net_balance()\n            min2 = second.compute_min_prefix_balance()\n            \n            total_net = net1 + net2\n            \n            # A concatenated string (first + second) is \"good\" if:\n            # 1. The total net balance of (first + second) is zero.\n            # 2. The minimum prefix balance of 'first' is non-negative.\n            # 3. The minimum prefix balance of 'second', when its balance values are shifted by 'first's net balance, is non-negative.\n            return total_net == 0 and min1 >= 0 and (net1 + min2) >= 0\n\n    Validators.validate_two_strings(lst)\n    a_paren, b_paren = InputAdapter.parse(lst)\n    result = MatcherService().can_concatenate_good(a_paren, b_paren)\n    return result.as_output()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/120": [{"task_id": "HumanEval/120", "solution": "import heapq\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Use a min-heap to keep track of the k largest elements seen so far.\n    # The heap will maintain at most k elements.\n    min_heap = []\n    for x in arr:\n        if len(min_heap) < k:\n            heapq.heappush(min_heap, x)\n        elif x > min_heap[0]:\n            heapq.heapreplace(min_heap, x)\n\n    # The min_heap now contains the k largest elements, but it is not necessarily sorted.\n    # The requirement is to return a sorted list in non-decreasing order.\n    min_heap.sort()\n    return min_heap", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/120", "solution": "import heapq\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid inputs.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass InputValidator:\n    \"\"\"Validates input array and k value.\"\"\"\n    def validate_array(self, arr: list) -> list[int]:\n        if not isinstance(arr, list):\n            raise InvalidInputError(\"Input 'arr' must be a list.\")\n        for item in arr:\n            if not isinstance(item, int):\n                raise InvalidInputError(\"All elements in 'arr' must be integers.\")\n        return arr\n    \n    def validate_k(self, k: object, arr_len: int) -> int:\n        try:\n            k_int = int(k)\n        except (TypeError, ValueError):\n            raise InvalidInputError(\"'k' must be an integer.\")\n        if k_int < 0 or k_int > arr_len:\n            raise InvalidInputError(f\"'k' must be between 0 and the length of 'arr' ({arr_len}).\")\n        return k_int\nclass ArrayRepository:\n    \"\"\"Manages array data access.\"\"\"\n    def from_list(self, arr: list[int]) -> list[int]:\n        return list(arr)\nclass MaxKService:\n    \"\"\"Service to compute the top-k maximum numbers.\"\"\"\n    DEFAULT_STRATEGY = \"heap\"\n\n    def __init__(self, validator: InputValidator, repository: ArrayRepository, strategy: str = DEFAULT_STRATEGY):\n        self.validator = validator\n        self.repository = repository\n        self.strategy = strategy\n\n    def get_top_k(self, arr: list[int], k: int) -> list[int]:\n        validated_arr = self.validator.validate_array(arr)\n        validated_k = self.validator.validate_k(k, len(validated_arr))\n\n        if self.strategy == \"heap\":\n            result = self._compute_top_k_heap(validated_arr, validated_k)\n        else: # Default or fallback to heap if strategy is invalid/unspecified\n            result = self._compute_top_k_heap(validated_arr, validated_k)\n        \n        result.sort()\n        return result\n\n    def _compute_top_k_heap(self, arr: list[int], k: int) -> list[int]:\n        if k == 0:\n            return []\n        return heapq.nlargest(k, arr)\nclass ServiceFactory:\n    \"\"\"Factory to create MaxKService instances with default dependencies.\"\"\"\n    @staticmethod\n    def create_default_service(strategy: str = MaxKService.DEFAULT_STRATEGY) -> MaxKService:\n        validator = InputValidator()\n        repository = ArrayRepository()\n        return MaxKService(validator, repository, strategy)\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    svc = ServiceFactory.create_default_service()\n    return svc.get_top_k(arr, k)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/122": [{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    total_sum = 0\n    # Iterate through the first k elements of the array\n    for i in range(k):\n        element = arr[i]\n        # Check if the absolute value of the element has at most two digits\n        if -99 <= element <= 99:\n            total_sum += element\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n\n    # Constants from config.py\n    MAX_ARRAY_LEN = 100\n    MIN_K = 1\n\n    # Custom exception for invalid input\n    class InvalidInputError(Exception):\n        def __init__(self, message: str, code: int = 400) -> None:\n            super().__init__(message)\n            self.message = message\n            self.code = code\n        def __str__(self) -> str:\n            return f\"{self.message} (code={self.code})\"\n\n    # Numeric utility functions\n    class Utils:\n        @staticmethod\n        def is_at_most_two_digits(n: int) -> bool:\n            # Returns True if the absolute value of n is at most 99.\n            return abs(n) <= 99\n\n    # Input validation class\n    class ArrayValidator:\n        def validate(self, arr: list[int], k: int) -> None:\n            # Validates the array and k against defined constraints.\n            if not isinstance(arr, list):\n                raise InvalidInputError(\"arr must be a list of integers\")\n            if len(arr) < 1:\n                raise InvalidInputError(\"arr must be non-empty\")\n            if len(arr) > MAX_ARRAY_LEN:\n                raise InvalidInputError(f\"arr length must be <= {MAX_ARRAY_LEN}\")\n            if not isinstance(k, int):\n                raise InvalidInputError(\"k must be an int\")\n            if k < MIN_K or k > len(arr):\n                raise InvalidInputError(f\"k must be an int between {MIN_K} and len(arr)\")\n            for i, v in enumerate(arr):\n                if not isinstance(v, int):\n                    raise InvalidInputError(f\"arr[{i}] is not an int\")\n\n    # Core service logic\n    class AddElementsService:\n        def __init__(self, validator: ArrayValidator) -> None:\n            self._validator = validator\n\n        def get_qualifying_elements(self, arr: list[int], k: int) -> list[int]:\n            # Extracts elements from the first k that have at most two digits.\n            subset = arr[:k]\n            return [x for x in subset if Utils.is_at_most_two_digits(x)]\n\n        def add_elements(self, arr: list[int], k: int) -> int:\n            # Validates inputs, then sums the qualifying elements.\n            self._validator.validate(arr, k)\n            elements = self.get_qualifying_elements(arr, k)\n            return sum(elements)\n\n    # Instantiate the service and perform the calculation.\n    service = AddElementsService(ArrayValidator())\n    return service.add_elements(arr, k)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/121": [{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 2 == 0 and num % 2 != 0:\n            total_sum += num\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    \"\"\"\n    total = 0\n    for i in range(0, len(lst), 2):\n        if lst[i] % 2 != 0:\n            total += lst[i]\n    return total", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/123": [{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    odd_numbers = set()\n    current_n = n\n\n    while True:\n        if current_n % 2 == 1:\n            odd_numbers.add(current_n)\n\n        if current_n == 1:\n            break\n        \n        if current_n % 2 == 0:\n            current_n = current_n // 2\n        else:\n            current_n = 3 * current_n + 1\n\n    return sorted(list(odd_numbers))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/123", "solution": "import os\nimport json\nimport logging\nimport threading\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom dataclasses import dataclass\nfrom typing import List, Optional, Any, Iterable, Dict\n_logger = logging.getLogger(__name__)\nclass CollatzError(Exception):\n    \"\"\"Base exception for Collatz related errors.\"\"\"\n    pass\nclass InvalidInputError(CollatzError):\n    \"\"\"Raised when input is invalid.\"\"\"\n    pass\nclass PersistenceError(CollatzError):\n    \"\"\"Raised when there's an issue with data persistence.\"\"\"\n    pass\nclass Validator:\n    \"\"\"Provides validation methods for Collatz inputs.\"\"\"\n    def is_positive_int(self, value: Any) -> bool:\n        \"\"\"Returns True if the value is a positive integer, False otherwise.\"\"\"\n        return isinstance(value, int) and value > 0\n\n    def validate_positive_int(self, value: Any) -> None:\n        \"\"\"Validates that the given value is a positive integer, raising an error if not.\"\"\"\n        if not self.is_positive_int(value):\n            raise InvalidInputError(f\"Input must be a positive integer, but received: {value}\")\ndef sorted_unique(items: Iterable[int]) -> List[int]:\n    \"\"\"Returns a sorted list of unique integers from the given iterable.\"\"\"\n    return sorted(list(set(items)))\n_file_lock = threading.Lock()\nclass FileCacheAdapter:\n    \"\"\"Handles reading from and writing to JSON cache files with basic locking.\"\"\"\n    @staticmethod\n    def read_json(path: Path) -> Dict[str, Any]:\n        \"\"\"Reads JSON data from the specified path with a file lock.\"\"\"\n        with _file_lock:\n            if not path.exists():\n                return {}\n            try:\n                with open(path, 'r', encoding='utf-8') as f:\n                    return json.load(f)\n            except (IOError, json.JSONDecodeError) as e:\n                _logger.warning(f\"Failed to read cache from {path}: {e}\")\n                return {}\n\n    @staticmethod\n    def write_json(path: Path, data: Dict[str, Any]) -> None:\n        \"\"\"Writes JSON data to the specified path with a file lock, using a temp file for atomicity.\"\"\"\n        with _file_lock:\n            path.parent.mkdir(parents=True, exist_ok=True)\n            temp_path = path.with_suffix(path.suffix + '.tmp')\n            try:\n                with open(temp_path, 'w', encoding='utf-8') as f:\n                    json.dump(data, f, indent=2)\n                os.replace(temp_path, path) # Atomic replacement\n            except IOError as e:\n                _logger.error(f\"Failed to write cache to {path}: {e}\")\n                if temp_path.exists():\n                    try:\n                        os.remove(temp_path)\n                    except OSError as remove_e:\n                        _logger.error(f\"Failed to remove temporary cache file {temp_path}: {remove_e}\")\n                raise PersistenceError(f\"Failed to save cache to disk: {e}\")\nclass InMemoryCacheRepository:\n    \"\"\"Manages an in-memory cache for Collatz sequences, with optional disk persistence.\"\"\"\n    def __init__(self, persist_path: Optional[Path] = None) -> None:\n        self._cache: Dict[str, Dict[str, Any]] = {} # Storing dicts to avoid re-serialization\n        self._persist_path = persist_path\n        if self._persist_path:\n            self.load_from_disk()\n\n    def _get_cache_key(self, n: int) -> str:\n        \"\"\"Generates a string key for caching based on the input integer n.\"\"\"\n        return str(n)\n\n    def get(self, n: int) -> Optional[CollatzSequence]:\n        \"\"\"Retrieves a CollatzSequence from the cache by n.\"\"\"\n        key = self._get_cache_key(n)\n        if key in self._cache:\n            try:\n                return CollatzSequence.from_dict(self._cache[key])\n            except Exception as e:\n                _logger.error(f\"Error deserializing cached item for n={n}: {e}\")\n                del self._cache[key] # Remove corrupted entry\n        return None\n\n    def set(self, n: int, seq: CollatzSequence) -> None:\n        \"\"\"Stores a CollatzSequence in the cache and attempts to save to disk.\"\"\"\n        key = self._get_cache_key(n)\n        self._cache[key] = seq.to_dict()\n        if self._persist_path:\n            try:\n                self.save_to_disk()\n            except PersistenceError as e:\n                _logger.warning(f\"Cache save failed for n={n}: {e}\") # Log, but don't re-raise for set\n\n    def save_to_disk(self) -> None:\n        \"\"\"Saves the current in-memory cache to the disk file.\"\"\"\n        if self._persist_path:\n            FileCacheAdapter.write_json(self._persist_path, self._cache)\n\n    def load_from_disk(self) -> None:\n        \"\"\"Loads the cache from the disk file into memory.\"\"\"\n        if self._persist_path:\n            self._cache = FileCacheAdapter.read_json(self._persist_path)\n            # Filter out non-numeric keys from loaded cache for robustness\n            self._cache = {k: v for k, v in self._cache.items() if k.isdigit()}\n            _logger.info(f\"Loaded {len(self._cache)} items from cache at {self._persist_path}\")\nclass CollatzService:\n    \"\"\"Handles the core Collatz sequence computation and extraction of odd numbers.\"\"\"\n    def __init__(self, repository: InMemoryCacheRepository, validator: Validator) -> None:\n        self._repository = repository\n        self._validator = validator\n\n    def _compute_sequence_iterative(self, n: int) -> List[int]:\n        \"\"\"Computes the Collatz sequence iteratively from n down to 1.\"\"\"\n        seq: List[int] = []\n        cur = n\n        while True:\n            seq.append(cur)\n            if cur == 1:\n                break\n            if cur % 2 == 0:\n                cur = cur // 2\n            else:\n                cur = 3 * cur + 1\n        return seq\n\n    def compute_sequence(self, n: int) -> CollatzSequence:\n        \"\"\"Computes the Collatz sequence for n, extracts odd numbers, and caches the result.\"\"\"\n        self._validator.validate_positive_int(n)\n\n        cached_seq = self._repository.get(n)\n        if cached_seq:\n            return cached_seq\n\n        sequence = self._compute_sequence_iterative(n)\n        odd_numbers = sorted_unique([x for x in sequence if x % 2 != 0])\n        computed_at 