          break # Found two opening brackets\n\n    # If we didn't find at least two opening brackets, a nested structure with depth >= 2 is impossible.\n    if second_open_idx is None:\n        return False\n\n    # Now search for at least two closing brackets after the second opening bracket.\n    closing_brackets_count = 0\n    # Start searching from the character immediately after the second opening bracket\n    for char in string[second_open_idx + 1:]:\n        if char == ']':\n            closing_brackets_count += 1\n            if closing_brackets_count >= 2:\n                # We found a pattern like s[first_open_idx]...s[second_open_idx]...s[k]...s[l]\n                # where s[first_open_idx] = '[', s[second_open_idx] = '[', s[k] = ']', s[l] = ']'\n                # This forms a valid nested subsequence \"[[]]\".\n                return True\n\n    # No such pattern of two opening and two subsequent closing brackets found.\n    return False", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["[][][]"]]}, {"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets \n    where at least one bracket in the subsequence is nested.\n    '''\n    n = len(string)\n    # A nested subsequence like \"[[]]\" requires at least 4 characters.\n    if n < 4:\n        return False\n\n    # Precompute suffix counts of ']' characters.\n    # suffix_counts[i] stores the number of ']' in string[i:].\n    suffix_counts = [0] * (n + 1)\n    for i in range(n - 1, -1, -1):\n        suffix_counts[i] = suffix_counts[i + 1] + (1 if string[i] == ']' else 0)\n\n    open_seen = 0\n    for i in range(n):\n        if string[i] == '[':\n            open_seen += 1\n        # If at least two '[' have been seen so far,\n        # and at least two ']' are availab