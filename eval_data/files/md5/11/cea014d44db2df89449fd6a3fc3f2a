t correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    CANONICAL_PLANETS = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n    # Create a mapping for case-insensitive lookup of planet names to their orbital index.\n    name_to_index = {name.lower(): i for i, name in enumerate(CANONICAL_PLANETS)}\n\n    # Helper function to get the 0-based orbital index of a planet.\n    def get_planet_index(planet_name_str):\n        return name_to_index.get(planet_name_str.lower())\n\n    # Get the indices for the two input planets.\n    idx1 = get_planet_index(planet1)\n    idx2 = get_planet_index(planet2)\n\n    # If either planet name is not found, return an empty tuple.\n    if idx1 is None or idx2 is None:\n        return ()\n\n    # Determine the lower and higher indices to define the range.\n    low_idx, high_idx = sorted((idx1, idx2))\n\n    # If the planets are adjacent or the same, there are no planets strictly between them.\n    if high_idx - low_idx <= 1:\n        return ()\n\n    # Extract the names of planets within the calculated range (exclusive of the endpoints).\n    between_planets_names = CANONICAL_PLANETS[low_idx + 1:high_idx]\n\n    # Return the list of planet names as a tuple.\n    return tuple(between_planets_names)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/149": [{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters out strings with odd lengths and returns the remaining\n    strings sorted by length then alphabetically.\n    \"\"\"\n    even_length_strings = []\n    for s in lst:\n        if len(s) % 2 == 0:\n            even_length_strings.append(s)\n\n    # Sort by length first, then alphabetically for ties\n  