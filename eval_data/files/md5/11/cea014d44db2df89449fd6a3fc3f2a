and ignore this sequence.\n                    depth = 0\n                    start = -1\n                    continue\n\n                if depth == 0 and start != -1:\n                    # Found a complete, balanced top-level group.\n                    groups.append(text[start:i+1])\n                    start = -1  # Reset for the next group.\n        \n        # Incomplete groups (where depth != 0 at end) are implicitly not added to results.\n        return groups\nclass SplitService:\n    \"\"\"Orchestrates input sanitization, validation, and parsing.\"\"\"\n    def __init__(self, parser: Optional[ParenParser] = None, validator: Optional[InputValidator] = None) -> None:\n        self.parser = parser if parser is not None else ParenParser()\n        self.validator = validator if validator is not None else InputValidator()\n\n    def separate_groups(self, text: str) -> List[str]:\n        # Sanitize the input according to rules (remove spaces, invalid chars).\n        sanitized = self.validator.sanitize(text)\n        # Per instruction \"DO NOT add ... raise exceptions\", validation logic for errors is bypassed.\n        # self.validator.validate(sanitized) \n        return self.parser.parse(sanitized)\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Separates a string of nested parentheses into a list of balanced top-level groups.\n    Ignores any spaces and other non-parenthesis characters in the input string.\n    \"\"\"\n    service = SplitService()\n    return service.separate_groups(paren_string)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/1", "solution": "from typing import List, Iterator, Tuple\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input characters or length.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\nclass ParseError(Exception):\n    \"\"\"Exception raised for parsing errors, e.g., unbalanced parentheses.\"\"\"\n    def __init__(self, position: int, fragment: str, message: str):\n        self.position = position\n        self.fragment = fragment\n        super().__init__(f\"{message} at position {position}. Fragment: '{fragment}'\")\nclass ParenthesisGroup:\n    \"\"\"Immutable model representing one balanced parentheses group.\"\"\"\n    def __init__(self, text: str):\n        self._text = text\n\n    @property\n    def text(self) -> str:\n        return self._text\n\n    def to_compact(self) -> str:\n        \"\"\"Returns the compact string representation of the group.\"\"\"\n        return self._text\nclass ParenthesisTokenizer:\n    \"\"\"Converts input string to a stream of (index, char) tokens for parentheses, ignoring whitespace.\"\"\"\n    VALID_CHARS = {\"(\", \")\", \" \"}\n\n    def tokenize(self, s: str) -> Iterator[Tuple[int, str]]:\n        \"\"\"Yields (index, char) for '(' and ')' only; ignores spaces. Raises InvalidInputError for other chars.\"\"\"\n        for i, ch in enumerate(s):\n            if ch == \" \":\n                continue\n            if ch not in self.VALID_CHARS:\n                raise InvalidInputError(f\"Invalid character {ch!r} at position {i}\")\n            yield (i, ch)\nclass ParenthesisParser:\n    \"\"\"Parses a token stream and produces ParenthesisGroup objects, ensuring correct nesting.\"\"\"\n    def parse(self, tokens: Iterator[Tuple[int, str]]) -> List[ParenthesisGroup]:\n        stack = []  # Stores original positions of open parentheses\n        groups = []\n        \n        # Buffer to accumulate characters for the current top-level group being processed.\n        buffer_chars_for_group = [] \n        \n        for pos, ch in tokens:\n            buffer_chars_for_group.append(ch) # Append only the character for the group text\n            \n            if ch == \"(\":\n                stack.append(pos)\n            else:  # ch == \")\"\n                if not stack:\n                    # Unmatched closing parenthesis. Fragment is recent characters from the buffer.\n                    fragment = \"\".join(buffer_chars_for_group[-5:]) \n                    raise ParseError(pos, fragment, \"Unmatched closing parenthesis\")\n                stack.pop() # Match with an open parenthesis\n                if not stack:\n                    # A top-level group is complete.\n                    group_text = \"\".join(buffer_chars_for_group)\n                    groups.append(ParenthesisGroup(group_text))\n                    buffer_chars_for_group = [] # Reset buffer for the next top-level group\n\n        if stack:\n            # Unclosed parentheses at the end of input. Fragment is an empty string as per design snippet.\n            raise ParseError(stack[-1], \"\", \"Unclosed parenthesis at end of input\")\n\n        return groups\nclass ParenthesisFormatter:\n    \"\"\"Converts ParenthesisGroup objects to string representations.\"\"\"\n    def format(self, groups: List[ParenthesisGroup]) -> List[str]:\n        \"\"\"Returns a list of compact string representations for the given groups.\"\"\"\n        return [g.to_compact() for g in groups]\nclass ParenthesisService:\n    \"\"\"Orchestrates tokenization, parsing, and formatting of parenthesis strings.\"\"\"\n    def __init__(self, tokenizer: ParenthesisTokenizer, parser: ParenthesisParser, formatter: ParenthesisFormatter, max_input_length: int = 1_000_000):\n        self.tokenizer = tokenizer\n        self.parser = parser\n        self.formatter = formatter\n        self.max_input_length = max_input_length\n\n    def separate(self, paren_string: str) -> List[str]:\n        \"\"\"Validates, tokenizes, parses, and formats a string into separate parenthesis groups.\"\"\"\n        if len(paren_string) > self.max_input_length:\n            raise InvalidInputError(f\"Input string length ({len(paren_string)}) exceeds maximum allowed ({self.max_input_length})\")\n        \n        tokens = self.tokenizer.tokenize(paren_string)\n        groups = self.parser.parse(tokens)\n        return self.formatter.format(groups)\n_default_service = ParenthesisService(ParenthesisTokenizer(), ParenthesisParser(), ParenthesisFormatter())\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    return _default_service.separate(paren_string)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/2": [{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    import math\n    return math.modf(number)[0]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/2", "solution": "import math\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    DEFAULT_PRECISION: int = 10\n    EPSILON: float = 1e-12\n\n    integer_part = math.floor(number)\n    raw_decimal = number - integer_part\n    rounded = round(raw_decimal, DEFAULT_PRECISION)\n    if rounded + EPSILON >= 1.0:\n        return 0.0\n    return rounded", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[4.999999999999999]]}], "HumanEval/5": [{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = []\n    # Append the first number directly.\n    result.append(numbers[0])\n\n    # For each subsequent number, append the delimiter then the number.\n    for i in range(1, len(numbers)):\n        result.append(delimeter)\n        result.append(numbers[i])\n\n    return result", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    n = len(numbers)\n    if n == 0:\n        return []\n    \n    result: List[int] = []\n    for i, val in enumerate(numbers):\n        result.append(val)\n        if i != n - 1:\n            result.append(delimeter)\n    return result", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/4": [{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    n = len(numbers)\n    # The design context indicates validation should happen externally or\n    # that an empty list should raise ValidationError.\n    # However, the completion instructions prohibit raising exceptions for edge cases\n    # and calling non-inline helpers (ValidationError is external).\n    # Thus, we assume a non-empty list for the calculation.\n    mean = sum(numbers) / n\n    total_abs_deviation = sum(abs(x - mean) for x in numbers)\n    return total_abs_deviation / n", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    class InvalidInputError(ValueError):\n        \"\"\"Raised when input data is invalid for MAD calculation.\"\"\"\n        pass\n\n    if not numbers:\n        raise InvalidInputError(\"Input list cannot be empty.\")\n\n    mean_value = sum(numbers) / len(numbers)\n    total_absolute_difference = sum(abs(x - mean_value) for x in numbers)\n    mad_value = total_absolute_difference / len(numbers)\n\n    return mad_value", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/7": [{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring.\n    The filtering is case-sensitive and maintains the original order.\n    \"\"\"\n    return [s for s in strings if substring in s]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring.\n    If the substring is empty, all original strings are returned.\n    \"\"\"\n    if substring == \"\":\n        return list(strings)\n    return [s for s in strings if substring in s]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/6": [{"task_id": "HumanEval/6", "solution": "from typing import List\nclass ParenParsingError(Exception):\n    \"\"\"\n    Structured exception to surface validation and parsing errors with context.\n    \"\"\"\n    def __init__(self, message: str, group_index: int = None, position: int = None):\n        self.message = message\n        self.group_index = group_index\n        self.position = position\n        super().__init__(message)\n\n    def __str__(self) -> str:\n        loc = f\" group={self.group_index}\" if self.group_index is not None else \"\"\n        pos = f\" pos={self.position}\" if self.position is not None else \"\"\n        return f\"{self.message}{loc}{pos}\"\nclass Tokenizer:\n    \"\"\"\n    Splits input string into groups based on whitespace, ignoring empty groups.\n    \"\"\"\n    def tokenize(self, input_str: str) -> List[str]:\n        if input_str is None:\n            return []\n        return [g for g in input_str.strip().split() if g]\nclass Validator:\n    \"\"\"\n    Validates individual group strings for allowed characters and balanced parentheses.\n    \"\"\"\n    def validate_group(self, group: str, index: int) -> None:\n        for pos, ch in enumerate(group):\n            if ch not in (\"(\", \")\"):\n                raise ParenParsingError(\"Invalid character\", group_index=index, position=pos)\n\n        depth = 0\n        for pos, ch in enumerate(group):\n            if ch == \"(\":\n                depth += 1\n            else:  # ch == \")\"\n                depth -= 1\n            if depth < 0:\n                raise ParenParsingError(\"Unmatched closing parenthesis\", group_index=index, position=pos)\n\n        if depth != 0:\n            raise ParenParsingError(\"Unmatched opening parenthesis(s)\", group_index=index, position=None)\nclass ParserService:\n    \"\"\"\n    Computes the maximum nesting depth for a single group.\n    \"\"\"\n    def compute_depth(self, group: str) -> int:\n        max_depth = 0\n        depth = 0\n        for ch in group:\n            if ch == \"(\":\n                depth += 1\n                if depth > max_depth:\n                    max_depth = depth\n            else:  # ch == \")\"\n                depth -= 1\n                # This check is technically redundant if Validator is always called first,\n                # but adds robustness against unexpected input.\n                if depth < 0:\n                    raise ParenParsingError(\"Unbalanced parentheses during parse\")\n        \n        # This check is also redundant if Validator is always called first.\n        if depth != 0:\n            raise ParenParsingError(\"Unbalanced parentheses after parse\")\n            \n        return max_depth\n\n    def parse_all(self, groups: List[str]) -> List[int]:\n        return [self.compute_depth(g) for g in groups]\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    tokenizer = Tokenizer()\n    validator = Validator()\n    parser = ParserService()\n\n    groups = tokenizer.tokenize(paren_string)\n    \n    # Validate each group before parsing depths\n    for i, g in enumerate(groups):\n        validator.validate_group(g, i)\n        \n    return parser.parse_all(groups)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/6", "solution": "from typing import List, Optional\nimport re\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Parses a string of multiple groups for nested parentheses separated by spaces.\n    For each group, it outputs the deepest level of nesting of parentheses.\n    \"\"\"\n\n    class ParseError(Exception):\n        \"\"\"Custom exception for parsing errors encountered during validation or depth calculation.\"\"\"\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(self.message)\n\n    class GroupParseResult:\n        \"\"\"Represents the parsing outcome for a single group of parentheses.\"\"\"\n        def __init__(self, index: int, raw: str, max_depth: Optional[int] = None, error: Optional[str] = None) -> None:\n            self.index = index\n            self.raw = raw\n            self.max_depth = max_depth\n            self.error = error\n\n    class ParseResult:\n        \"\"\"Aggregates results from parsing all groups in the input string.\"\"\"\n        def __init__(self, groups: List[GroupParseResult], overall_success: bool) -> None:\n            self.groups = groups\n            self.overall_success = overall_success\n\n        def get_depths(self) -> List[int]:\n            \"\"\"Returns a list of maximum depths for successfully parsed groups.\"\"\"\n            return [g.max_depth for g in self.groups if g.max_depth is not None]\n\n    class Tokenizer:\n        \"\"\"Splits the raw input string into individual group strings based on whitespace.\"\"\"\n        DEFAULT_SPLIT_PATTERN = r'\\s+'\n\n        def tokenize(self, input_str: str) -> List[str]:\n            if not input_str:\n                return []\n            parts = re.split(self.DEFAULT_SPLIT_PATTERN, input_str.strip())\n            return [p for p in parts if p]\n\n    class Validator:\n        \"\"\"Ensures that a group string contains only valid parenthesis characters.\"\"\"\n        def validate_group(self, group: str) -> None:\n            for i, c in enumerate(group):\n                if c not in (\"(\", \")\"):\n                    raise ParseError(f\"Invalid character at index {i}: '{c}'\")\n\n    class DepthCalculator:\n        \"\"\"Computes the maximum nesting depth for a given valid parenthesis group.\"\"\"\n        def compute_max_depth(self, group: str) -> int:\n            current_depth = 0\n            max_depth = 0\n            for i, c in enumerate(group):\n                if c == \"(\":\n                    current_depth += 1\n                    max_depth = max(max_depth, current_depth)\n                elif c == \")\":\n                    if current_depth == 0:\n                        raise ParseError(f\"Unmatched closing paren at index {i}\")\n                    current_depth -= 1\n            if current_depth != 0:\n                raise ParseError(\"Unbalanced parentheses: too many opening parens\")\n            return max_depth\n\n    class OutputRepository:\n        \"\"\"A minimal placeholder for a repository, not directly utilized by this function's return value.\"\"\"\n        def __init__(self):\n            pass\n\n    class ParserService:\n        \"\"\"Orchestrates the parsing process: tokenizing, validating, and calculating depth for each group.\"\"\"\n        def __init__(self, tokenizer: Tokenizer, validator: Validator,\n                     calculator: DepthCalculator, repository: OutputRepository):\n            self.tokenizer = tokenizer\n            self.validator = validator\n            self.calculator = calculator\n            self.repository = repository\n\n        def parse(self, input_str: str, tolerant: bool = False) -> ParseResult:\n            \"\"\"Parses the input string and returns a ParseResult containing all group outcomes.\"\"\"\n            groups = self.tokenizer.tokenize(input_str)\n            results = []\n            overall_success = True\n\n            for idx, g in enumerate(groups):\n                try:\n                    self.validator.validate_group(g)\n                    depth = self.calculator.compute_max_depth(g)\n                    results.append(GroupParseResult(idx, g, max_depth=depth, error=None))\n                except ParseError as e:\n                    overall_success = False\n                    if not tolerant:\n                        raise\n                    results.append(GroupParseResult(idx, g, max_depth=None, error=str(e)))\n            return ParseResult(results, overall_success)\n\n    # Instantiate the service with its dependencies and execute the parsing logic.\n    service = ParserService(Tokenizer(), Validator(), DepthCalculator(), OutputRepository())\n    # As per the function signature, 'tolerant' is implicitly False.\n    result = service.parse(paren_string, tolerant=False)\n    return result.get_depths()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/8": [{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple, Any\nfrom dataclasses import dataclass\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input types or values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass InputValidator:\n    \"\"\"Validates and normalizes input for sum/product computation.\"\"\"\n    @staticmethod\n    def validate_numbers(numbers: Any) -> List[int]:\n        if numbers is None:\n            raise InvalidInputError(\"numbers must be an iterable of ints, got None\")\n        try:\n            iterator = iter(numbers)\n        except TypeError:\n            raise InvalidInputError(\"numbers must be an iterable (e.g., list or tuple) of ints\")\n\n        result: List[int] = []\n        for idx, v in enumerate(iterator):\n            if not isinstance(v, int):\n                raise InvalidInputError(f\"element at index {idx} is not int: {v!r} (type={type(v).__name__})\")\n            result.append(v)\n        return result\nclass SumProductCalculator:\n    \"\"\"Performs the core computation of sum and product.\"\"\"\n    @staticmethod\n    def compute(numbers: List[int]) -> SumProductResult:\n        sum_acc = 0\n        product_acc = 1\n        for n in numbers:\n            sum_acc += n\n            product_acc *= n\n        return SumProductResult(sum=sum_acc, product=product_acc)\n\n    @staticmethod\n    def sum_product(numbers: List[int]) -> Tuple[int, int]:\n        return SumProductCalculator.compute(numbers).to_tuple()\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    validated = InputValidator.validate_numbers(numbers)\n    return SumProductCalculator.sum_product(validated)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n\n    if not numbers:\n        return (total_sum, total_product)\n\n    total_sum = sum(numbers)\n    for nu