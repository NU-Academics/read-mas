(word_unique_counts.values())\n\n    # Collect all words that have this maximum unique character count\n    candidates = [word for word, count in word_unique_counts.items() if count == max_count]\n\n    # Return the word that comes first in lexicographical order among the candidates\n    return min(candidates)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \n    Example:\n    * eat(5, 6, 10) -> [11, 4]\n    * eat(4, 8, 9) -> [12, 1]\n    * eat(1, 10, 10) -> [11, 0]\n    * eat(2, 11, 5) -> [7, 0]\n    \n    Variables:\n    @number : integer\n        the number of carrots that you have eaten.\n    @need : integer\n        the number of carrots that you need to eat.\n    @remaining : integer\n        the number of remaining carrots thet exist in stock\n    \n    Constrain:\n    * 0 <= number <= 1000\n    * 0 <= need <= 1000\n    * 0 <= remaining <= 1000\n\n    Have fun :)\n    \"\"\"\n    carrots_eaten_now = min(need, remaining)\n    total_eaten = number + carrots_eaten_now\n    carrots_left = remaining - carrots_eaten_now\n    return [total_eaten, carrots_left]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Computes the total carrots eaten and remaining after a rabbit's meal.\n    The rabbit eats as many carrots as needed, up to the remaining amount.\n    \"\"\"\n    \n    carrots_consumed = min(need, remaining)\n    total_eaten = number + carrots_consumed\n    carrots_left = remaining - carrots_consumed\n    \n    return [total_eaten, carrots_left]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "class AlgebraEvaluationError(Exception):\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\nclass NumberNode:\n    def __init__(self, value: int):\n        self.value = value\n    def __repr__(self):\n        return f\"NumberNode({self.value})\"\nclass BinaryOpNode:\n    def __init__(self, op: str, left, right):\n        self.op = op\n        self.left = left\n        self.right = right\n    def __repr__(self):\n        return f\"BinaryOpNode('{self.op}', {self.left}, {self.right})\"\nclass Token:\n    def __init__(self, token_type: str, value):\n        self.token_type = token_type\n        self.value = value\n    def __repr__(self):\n        return f\"Token(type='{self.token_type}', value={self.value})\"\nclass InfixParser:\n    OP_PRECEDENCE = {\"**\": 4, \"*\": 3, \"//\": 3, \"+\": 2, \"-\": 2}\n    RIGHT_ASSOC = {\"**\"}\n\n    def parse(self, operators: list, operands: list):\n        validate_input(operators, operands)\n\n        tokens = []\n        for i, num in enumerate(operands):\n            tokens.append(Token(\"NUM\", num))\n            if i < len(operators):\n                tokens.append(Token(\"OP\", operators[i]))\n        \n        rpn = self._shunting_yard(tokens)\n        ast = self._tokens_to_ast(rpn)\n        return ast\n\n    def _shunting_yard(self, tokens: list) -> list:\n        output_queue = []\n        operator_stack = []\n\n        for token in tokens:\n            if token.token_type == \"NUM\":\n                output_queue.append(token)\n            elif token.token_type == \"OP\":\n                op1 = token.value\n                while operator_stack:\n                    op2_token = operator_stack[-1]\n                    op2 = op2_token.value\n                    \n                    if op2_token.token_type != \"OP\": # Sanity check\n                        break\n\n                    prec1 = self.OP_PRECEDENCE.get(op1, 0)\n                    prec2 = self.OP_PRECEDENCE.get(op2, 0)\n                    \n                    if (prec1 < prec2) or (prec1 == prec2 and op1 not in self.RIGHT_ASSOC):\n                        output_queue.append(operator_stack.pop())\n                    else:\n                        break\n                operator_stack.append(token)\n        \n        while operator_stack:\n            output_queue.append(operator_stack.pop())\n        \n        return output_queue\n\n    def _tokens_to_ast(self, rpn_tokens: list):\n        stack = []\n        for token in rpn_tokens:\n            if token.token_type == \"NUM\":\n                stack.append(NumberNode(token.value))\n            elif token.token_type == \"OP\":\n                if len(stack) < 2:\n                    raise AlgebraEvaluationError(\"Syntax error: not enough operands for operator.\")\n                right = stack.pop()\n                left = stack.pop()\n                stack.append(BinaryOpNode(token.value, left, right))\n        \n        if len(stack) != 1:\n            raise AlgebraEvaluationError(\"Syntax error: too many operands or operators left.\")\n        \n        return stack[0]\nclass ExpressionEvaluator:\n    def evaluate(self, node) -> int:\n        if isinstance(node, NumberNode):\n            return self._eval_number(node)\n        elif isinstance(node, BinaryOpNode):\n            return self._eval_binary(node)\n        else:\n            raise AlgebraEvaluationError(\"Unknown node type during evaluation.\")\n\n    def _eval_number(self, node: NumberNode) -> int:\n        return node.value\n\n    def _eval_binary(self, node: BinaryOpNode) -> int:\n        left_val = self.evaluate(node.left)\n        right_val = self.evaluate(node.right)\n\n        if node.op == \"+\":\n            return left_val + right_val\n        elif node.op == \"-\":\n            return left_val - right_val\n        elif node.op == \"*\":\n            return left_val * right_val\n        elif node.op == \"//\":\n            if right_val == 0:\n                raise AlgebraEvaluationError(\"Division by zero.\")\n            return left_val // right_val\n        elif node.op == \"**\":\n            return left_val ** right_val\n        else:\n            raise AlgebraEvaluationError(f\"Unsupported operator: {node.op}\")\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n    parser = InfixParser()\n    evaluator = ExpressionEvaluator()\n    ast = parser.parse(operator, operand)\n    return evaluator.evaluate(ast)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[["**", "*", "+"], [2, 3, 4, 5]]], "plus_fail_tests": [[["+", "-", "*", "//"], [5, 2, 3, 4, 7]]]}, {"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n    PRECEDENCE = {\n        \"**\": 4,\n        \"*\": 3,\n        \"//\": 3,\n        \"+\": 2,\n        \"-\": 2,\n    }\n\n    ASSOCIATIVITY = {\n        \"**\": \"right\",\n        \"*\": \"left\",\n        \"//\": \"left\",\n        \"+\": \"left\",\n        \"-\": \"left\",\n    }\n\n    def _apply_op(lhs, rhs, op_symbol):\n        if op_symbol == \"+\":\n            return lhs + rhs\n        elif op_symbol == \"-\":\n            return lhs - rhs\n        elif op_symbol == \"*\":\n            return lhs * rhs\n        elif op_symbol == \"//\":\n            return lhs // rhs\n        elif op_symbol == \"**\":\n            return lhs ** rhs\n\n    tokens = []\n    for i in range(len(operand)):\n        tokens.append(operand[i])\n        if i < len(operator):\n            tokens.append(operator[i])\n\n    value_stack = []\n    operator_stack = []\n\n    for token in tokens:\n        if isinstance(token, int):\n            value_stack.append(token)\n        else:\n            current_op_symbol = token\n            current_op_precedence = PRECEDENCE[current_op_symbol]\n            current_op_associativity = ASSOCIATIVITY[current_op_symbol]\n\n            while (operator_stack and\n                   (PRECEDENCE[operator_stack[-1]] > current_op_precedence or\n                    (PRECEDENCE[operator_stack[-1]] == current_op_precedence and\n                     ASSOCIATIVITY[operator_stack[-1]] == \"left\"))):\n                \n                op = operator_stack.pop()\n                rhs = value_stack.pop()\n                lhs = value_stack.pop()\n                result = _apply_op(lhs, rhs, op)\n                value_stack.append(result)\n            \n            operator_stack.append(current_op_symbol)\n\n    while operator_stack:\n        op = operator_stack.pop()\n        rhs = value_stack.pop()\n        lhs = value_stack.pop()\n        result = _apply_op(lhs, rhs, op)\n        value_stack.append(result)\n\n    return value_stack[0]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return