e second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    if not b:\n        # As per design, if the pattern is empty, return False.\n        return False\n    if len(b) > len(a):\n        # As per design, if the pattern is longer than the text, return False.\n        return False\n\n    b_len = len(b)\n    unique_rotations = set()\n\n    # Generate all cyclic rotations of string 'b' and store them to ensure uniqueness.\n    for i in range(b_len):\n        rotation = b[i:] + b[:i]\n        unique_rotations.add(rotation)\n\n    # Check if any of the unique rotations are a substring of string 'a'.\n    for rotation in unique_rotations:\n        if rotation in a:\n            return True\n\n    # If no rotation is found as a substring, return False.\n    return False", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["", ""]]}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM calculation, returning 'ClassName.StrongestExtensionName'.\n    Ties are broken by choosing the extension that appears first in the list.\n    \"\"\"\n    max_strength = -float('inf')\n    strongest_extension_name = \"\"\n\n    for ext_name in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in ext_name:\n            if char.isupper():\n                cap_count += 1\n            elif char.islower():\n                sm_count += 1\n        \n        current_strength = cap_count - sm_count\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = ext_name\n\n    return f\"{class_name}.{strongest_extension_name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Calculates the strength of each extension (CAP - SM) and finds the strongest one.\n    If there's a tie in strength, the extension appearing first in the list is chosen.\n    \"\"\"\n    max_strength = -float('inf')  # Initialize with a very low number\n    strongest_extension_name = \"\"\n\n    for i, extension_name in enumerate(extensions):\n        cap_count = 0\n        sm_count = 0\n        for char in extension_name:\n            if 'A' <= char <= 'Z':\n                cap_count += 1\n            elif 'a' <= char <= 'z':\n                sm_count += 1\n        \n        current_strength = cap_count - sm_count\n        \n        # If the current extension is stronger, update the max strength and name.\n        # The \"first in the list\" tie-breaking rule is implicitly handled here,\n        # as we only update if `current_strength` is strictly greater.\n        # If an equally strong extension is found later, it won't replace the\n        # one already stored.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension_name\n\n    return f\"{class_name}.{strongest_extension_name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/156": [{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    _ROMAN_MAP = [\n        (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"),\n        (100, \"C\"), (90, \"XC\"), (50, \"L\"), (40, \"XL\"),