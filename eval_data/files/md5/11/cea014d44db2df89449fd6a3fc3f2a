):\n    \"\"\"Raised when an error occurs during persistence operations.\"\"\"\n    pass\ndef iso_timestamp() -> str:\n    \"\"\"Returns the current UTC time as an ISO8601 string.\"\"\"\n    return datetime.utcnow().isoformat(timespec='seconds') + 'Z'\ndef generate_uuid() -> str:\n    \"\"\"Generates a UUID4 string.\"\"\"\n    return str(uuid.uuid4())\nclass Config:\n    \"\"\"Central configuration for the xory service, with environment variable overrides.\"\"\"\n    DEFAULT_USAGE_LOG_PATH = \"./data/usage.log\"\n\n    def __init__(self, usage_log_path: str):\n        self.USAGE_LOG_PATH = usage_log_path\n\n    @classmethod\n    def from_env(cls) -> 'Config':\n        \"\"\"Creates a Config instance, reading configuration from environment variables.\"\"\"\n        usage_log_path = os.environ.get(\"XORY_USAGE_LOG_PATH\", cls.DEFAULT_USAGE_LOG_PATH)\n        return cls(usage_log_path=usage_log_path)\nclass PrimeChecker:\n    \"\"\"Provides methods for primality testing for integers.\"\"\"\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Checks if a given integer n is a prime number, following the classic definition.\"\"\"\n        if not isinstance(n, int):\n            raise InvalidInputError(\"n must be an integer\")\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0:\n            return False\n        r = int(n**0.5)\n        i = 3\n        while i <= r:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\nclass UsageRepository:\n    \"\"\"Manages persistence of usage records to a JSON-lines log file.\"\"\"\n    def __init__(self, log_path: str):\n        self._log_path = log_path\n\n    def append(self, record: dict) -> None:\n        \"\"\"Appends a usage record as a JSON line to the configured log file.\"\"\"\n        safe_write_jsonl(self._log_path, record)\nclass XorYService:\n    \"\"\"Orchestrates the business logic for checking primality and logging usage.\"\"\"\n    def __init__(self, prime_checker: PrimeChecker, usage_repo: UsageRepository, config: Config):\n        self._prime_checker = prime_checker\n        self._usage_repo = usage_repo\n        self._config = config\n\n    def compute(self, n: int, x: Any, y: Any, request_id: Optional[str]=None) -> Any:\n        \"\"\"Determines if n is prime and returns x or y accordingly, logging the action.\"\"\"\n        request_id = request_id or generate_uuid()\n        is_prime = self._prime_checker.is_prime(n)\n        result = x if is_prime else y\n        record = {\n            \"timestamp\": iso_timestamp(),\n            \"request_id\": request_id,\n            \"n\": n,\n            \"x\": x,\n            \"y\": y,\n            \"result\": result,\n            \"source\": \"library\"\n        }\n        try:\n            self._usage_repo.append(record)\n        except PersistenceError:\n            # As per design, the computation should not fail if logging fails.\n            pass\n        return result\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n    \"\"\"\n    config = Config.from_env()\n    prime_checker = PrimeChecker()\n    usage_repo = UsageRepository(config.USAGE_LOG_PATH)\n    service = XorYService(prime_checker, usage_repo, config)\n    return service.compute(n, x, y)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[7, 34, 12]], "plus_fail_tests": [[-2, 0, 1]]}], "HumanEval/151": [{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    '''\n    total_sum_of_squares = 0\n    for num in lst:\n        # Check if the number is an integer\n        if isinstance(num, int):\n            # Check if the integer is non-negative\n         