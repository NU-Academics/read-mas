iven array.\n    \"\"\"\n    arr_copy = list(array)\n\n    if not arr_copy:\n        return []\n\n    first_val = arr_copy[0]\n    last_val = arr_copy[-1]\n\n    if (first_val + last_val) % 2 == 1:  # Odd sum: sort ascending\n        return sorted(arr_copy)\n    else:  # Even sum: sort descending\n        return sorted(arr_copy, reverse=True)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/89": [{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating alphabetic characters by 4 positions.\"\"\"\n    ALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\n    ALPHABET_UPPER = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n    SHIFT = 4\n\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            idx = ALPHABET_LOWER.index(char)\n            encrypted_chars.append(ALPHABET_LOWER[(idx + SHIFT) % 26])\n        elif 'A' <= char <= 'Z':\n            idx = ALPHABET_UPPER.index(char)\n            encrypted_chars.append(ALPHABET_UPPER[(idx + SHIFT) % 26])\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated. \n    The alphabet should be rotated in a manner such that the letters \n    shift down by two multiplied to two places.\n    For example:\n    encrypt('hi') returns 'lm'\n    encrypt('asdfghjkl') returns 'ewhjklnop'\n    encrypt('gf') returns 'kj'\n    encrypt('et') returns 'ix'\n    \"\"\"\n\n    class ValidationError(ValueError):\n        \"\"\"Exception raised for invalid input to the encryption process.\"\"\"\n        pass\n\n    class EncryptionError(RuntimeError):\n        \"\"\"Exception raised for unexpected errors during encryption.\"\"\"\n        pass\n\n    class Config:\n        \"\"\"Manages configuration parameters for the encryption.\"\"\"\n        def __init__(self, rotation: int = 4, max_length: int = 10000) -> None:\n            self._rotation = rotation\n            self._max_length = max_length\n\n        def get_rotation(self) -> int:\n            \"\"\"Returns the alphabet rotation amount.\"\"\"\n            return self._rotation\n\n        def get_max_length(self) -> int:\n            \"\"\"Returns the maximum allowed input string length.\"\"\"\n            return self._max_length\n\n    class Validator:\n        \"\"\"Validates input strings based on configuration.\"\"\"\n        def __init__(self, config: Config) -> None:\n            self._config = config\n\n        def validate(self, value: str) -> bool:\n            \"\"\"Checks if the input value is a string and within length limits.\"\"\"\n            if not isinstance(value, str):\n                raise ValidationError(\"Input must be a string.\")\n            if len(value) > self._config.get_max_length():\n                raise ValidationError(f\"Input string exceeds maximum length of {self._config.get_max_length()} characters.\")\n            return True\n\n    class Encryptor:\n        \"\"\"Implements the core alphabet rotation encryption logic.\"\"\"\n        def __init__(self, config: Config) -> None:\n            self._config = config\n\n        def encrypt(self, s: str) -> str:\n            \"\"\"Encrypts the given string by rotating alphabetical characters.\"\"\"\n            try:\n                return ''.join(self._rotate_char(ch) for ch in s)\n            except Exception as exc:\n                raise EncryptionError(f\"Failed to encrypt due to an internal error: {exc}\") from exc\n\n        def _rotate_char(self, ch: str) -> str:\n            \"\"\"Rotates a single alphabetical character, preserving case.\"\"\"\n            rot = self._config.get_rotation()\n            if 'a' <= ch <= 'z':\n       