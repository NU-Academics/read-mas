idates list is already sorted, so the filtered result will also be in ascending order.\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n+1 numbers of the Tribonacci sequence.\n    The sequence is defined by tri(0)=1, tri(1)=3, tri(k)=1+k/2 for even k,\n    and tri(k)=tri(k-1)+tri(k-2)+tri(k+1) for odd k.\n    \"\"\"\n    if n == 0:\n        return [1]\n\n    # Determine the maximum index we need to compute.\n    # If n is odd, we need tri(n+1) to calculate tri(n).\n    max_idx_for_calc = n if n % 2 == 0 else n + 1\n    \n    # Initialize a list to store computed values (memoization).\n    memo = [0] * (max_idx_for_calc + 1)\n\n    # Apply base cases\n    memo[0] = 1\n    if max_idx_for_calc >= 1:\n        memo[1] = 3\n\n    # Compute values iteratively up to max_idx_for_calc\n    for i in range(2, max_idx_for_calc + 1):\n        if i % 2 == 0:  # If i is even\n            memo[i] = 1 + i // 2\n        else:  # If i is odd\n            # tri(i) = tri(i-1) + tri(i-2) + tri(i+1)\n            # tri(i-1) and tri(i-2) are already computed.\n            # tri(i+1) is an even index, so it can be calculated directly.\n            tri_i_plus_1 = 1 + (i + 1) // 2\n            memo[i] = memo[i-1] + memo[i-2] + tri_i_plus_1\n            \n    # Return the first n+1 numbers of the sequence (indices 0 to n)\n    return memo[:n+1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Computes the first n+1 numbers of the Tribonacci sequence.\n    The sequence is defined by tri(0)=1, tri(1)=3, tri(n)=1+n//2 for even n,\n    and tri(n)=tri(n-1)+tri(n-2)+tri(n+1) for odd n.\n    \"\"\"\n    if n == 0:\n        return [1]\n    \n    # Initialize the sequence with base values tri(0) and tri(1)\n    result = [1, 3]\n    \n    # Iterate from k = 2 up to n to compute subsequent Tribonacci numbers\n    for k in range(2, n + 1):\n        if k % 2 == 0:  # k is even\n            # Apply the formula for even numbers\n            result.append(1 + k // 2)\n        else:  # k is odd\n            # Calculate tri(k+1) using the even formula, as (k+1) will be even\n            tri_k_plus_1 = 1 + (k + 1) // 2\n            \n            # Apply the recurrence relation for odd numbers\n            tri_k = result[k - 1] + result[k - 2] + tri_k_plus_1\n            result.append(tri_k)\n            \n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Calculates the Brazilian factorial, which is the product of factorials from 1! up to n!.\n    This is efficiently computed by iteratively calculating each factorial and multiplying it into the running total.\n    \"\"\"\n    total_product = 1\n    current_factorial = 1\n    for i in range(1, n + 1):\n        current_factorial *= i  # current_factorial becomes i!\n        total_product *= current_factorial\n    return total_product", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/139", "solution": "_factorial_cache = {0: 1, 1: 1}\ndef _compute_factorial(n: int) -> int:\n    \"\"\"Computes factorial n! using memoization to avoid re-computation.\"\"\"\n    if n in _factorial_cache:\n        return _factorial_cache[n]\n\n    last_cached_n = max(_factorial_cache.keys())\n    result = _factorial_cache[last_cached_n]\n\n    for k in range(last_cached_n + 1, n + 1):\n        result *= k\n        _factorial_cache[k] = result\n    \n    return _factorial_cache[n]\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    total_brazilian_factorial = 1\n    for k in range(1, n + 1):\n        total_brazilian_factorial *= _compute_factorial(k)\n    return total_brazilian_factorial", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}