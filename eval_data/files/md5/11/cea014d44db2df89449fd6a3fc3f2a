.makedirs(temp_dir, exist_ok=True)\n        fd, temp_path = tempfile.mkstemp(dir=temp_dir, prefix=os.path.basename(path) + '.tmp', suffix='.json')\n        with os.fdopen(fd, 'w') as f:\n            json.dump(data, f)\n        os.replace(temp_path, path)\n\n    def safe_load_json(path: str) -> dict:\n        \"\"\"Loads JSON from a file, returning empty dict on errors or if not found.\"\"\"\n        try:\n            with open(path, 'r') as f:\n                return json.load(f)\n        except (FileNotFoundError, json.JSONDecodeError):\n            return {}\n\n    # --- FibonacciGenerator ---\n    class FibonacciGenerator:\n        def fib(self, n: int) -> int:\n            \"\"\"Returns the n-th Fibonacci number (F1=1, F2=1).\"\"\"\n            if n < 1:\n                raise InvalidInputError(\"n must be >= 1\")\n            f, _ = self._fast_doubling(n)\n            return f\n\n        def iter_from(self, k: int = 1):\n            \"\"\"Generates Fibonacci numbers starting from F_k.\"\"\"\n            if k < 1:\n                raise InvalidInputError(\"k must be >= 1\")\n            \n            a, b = self._fast_doubling(k)\n            # a is F_k, b is F_{k+1}\n            yield a\n\n            while True:\n                a, b = b, a + b\n                yield a\n\n        def _fast_doubling(self, n: int) -> tuple[int, int]:\n            \"\"\"Calculates F(n) and F(n+1) using fast doubling.\"\"\"\n            if n == 0:\n                return (0, 1) # (F0, F1)\n            \n            a, b = self._fast_doubling(n // 2)\n            \n            c = a * (2 * b - a) # F(2k) = F(k) * (2*F(k+1) - F(k))\n            d = a * a + b * b   # F(2k+1) = F(k)^2 + F(k+1)^2\n            \n            if n % 2 == 0:\n                return (c, d) # (F(2k), F(2k+1))\n            else:\n                return (d, c + d) # (F(2k+1), F(2k+2))\n\n    # --- PrimalityTester ---\n    class PrimalityTester:\n        def __init__(self, rounds: int = DEFAULT_MR_ROUNDS):\n            self.rounds = rounds\n\n        def is_prime(self, num: int) -> bool:\n            \"\"\"Checks if a number is prime using small prime tests and Miller-Rabin.\"\"\"\n            if num < 2:\n                return False\n            if num in {2, 3}:\n                return True\n            if num % 2 == 0 or num % 3 == 0:\n                return False\n\n            for p in [5, 7, 11, 13, 17, 19, 23, 29]:\n                if num == p:\n                    return True\n                if num % p == 0:\n                    return False\n            \n            return self._miller_rabin(num, self.rounds)\n\n        def _miller_rabin(self, num: int, rounds: int) -> bool:\n            \"\"\"Performs Miller-Rabin primality test.\"\"\"\n            s = 0\n            d = num - 1\n            while d % 2 == 0:\n                d //= 2\n                s += 1\n\n            for _ in range(rounds):\n                a = random.randrange(2, num - 1)\n                x = pow(a, d, num)\n\n                if x == 1 or x == num - 1:\n                    continue\n\n                for _ in range(s - 1):\n                    x = pow(x, 2, num)\n                    if x == num - 1:\n                        break\n                else:\n                    return False\n\n            return True\n\n    # --- CacheRepository ---\n    class CacheRepository:\n        def __init__(self, cache_path: str = DEFAULT_CACHE_PATH):\n            self.cache_path = expand_path(cache_path)\n            self._cache: dict[str, int] = self.load()\n\n        def load(self) -> dict[str, int]:\n            \"\"\"Loads cache from JSON file.\"\"\"\n            loaded_cache = safe_load_json(self.cache_path)\n            clean_cache = {}\n            for k_str, v in loaded_cache.items():\n                try:\n                    k_int = int(k_str)\n                    if isinstance(v, int):\n                        clean_cache[str(k_int)] = v\n                except ValueError:\n                    pass\n            return clean_cache\n\n        def save(self) -> None:\n            \"\"\"Saves current in-memory cache to JSON file atomically.\"\"\"\n            serializable_cache = {str(k): v for k, v in self._cache.items()}\n            atomic_write_json(self.cache_path, serializable_cache)\n\n        def get(self, index: int) -> int | None:\n            \"\"\"Retrieves a cached Fibonacci prime by its index.\"\"\"\n            return self._cache.get(str(index))\n\n        def set(self, index: int, value: int) -> None:\n            \"\"\"Stores a Fibonacci prime in the cache and saves it.\"\"\"\n            self._cache[str(index)] = value\n            self.save()\n\n    # --- PrimeFibService ---\n    class PrimeFibService:\n        def __init__(\n            self,\n            generator: FibonacciGenerator,\n            tester: PrimalityTester,\n            cache: CacheRepository,\n            max_n: int = DEFAULT_MAX_N,\n        ):\n            self.generator = generator\n            self.tester = tester\n            self.cache = cache\n            self.max_n = max_n\n\n        def get_nth_fibonacci_prime(self, n: int) -> int:\n            \"\"\"\n            Returns the n-th Fibonacci number that is also prime.\n            \"\"\"\n            if not isinstance(n, int) or n < 1:\n                raise InvalidInputError(\"n must be an integer >= 1\")\n            if n > self.max_n:\n                raise ComputationError(f\"n > max_n ({self.max_n}) to prevent unbounded computation.\")\n\n            cached = self.cache.get(n)\n            if cached is not None:\n                return cached\n            \n            value = self._compute_nth(n)\n            self.cache.set(n, value)\n            return value\n\n        def _compute_nth(self, target_n: int) -> int:\n            \"\"\"Computes the n-th Fibonacci prime by iterating and testing.\"\"\"\n            fib_prime_count = 0\n            fib_gen = self.generator.iter_from(1)\n            \n            fib_index = 0\n            while True:\n                current_fib = next(fib_gen)\n                fib_index += 1\n\n                if current_fib > 1 and self.tester.is_prime(current_fib):\n                    fib_prime_count += 1\n                    if fib_prime_count == target_n:\n                        return current_fib\n\n                if fib_index > 2000: # Safeguard for very large N, though max_n should usually prevent this.\n                    raise ComputationError(\"Exceeded iteration limit searching for Fibonacci prime.\")\n\n    # --- Wiring and execution for the prime_fib function ---\n    generator = FibonacciGenerator()\n    tester = PrimalityTester(rounds=DEFAULT_MR_ROUNDS)\n    cache = CacheRepository(cache_path=DEFAULT_CACHE_PATH)\n    service = PrimeFibService(generator, tester, cache, max_n=DEFAULT_MAX_N)\n\n    return service.get_nth_fibonacci_prime(n)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[1]], "plus_fail_tests": [[11]]}, {"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    # Initialize cache and state attributes on the function object if they don't exist.\n    # This acts as a persistent memoization cache across calls to prime_fib.\n    if not hasattr(prime_fib, '_cache'):\n        prime_fib._cache = {}  # Stores n (ordinal) -> fib_prime_value\n        prime_fib._fib_primes_list = [] # Stores [2, 3, 5, 13, 89, ...] in order of finding\n        \n        # Initialize Fibonacci sequence to start from F(3)=2, as 1 (F(1) and F(2)) is not prime.\n        # _f_prev holds F(k-1) and _f_curr holds F(k).\n        # We start with _f_prev = F(2) = 1 and _f_curr = F(3) = 2.\n        prime_fib._f_prev = 1  \n        prime_fib._f_curr = 2  \n\n    # If the n-th Fibonacci prime is already found and cached, return it.\n    if n in prime_fib._cache:\n        return prime_fib._cache[n]\n    \n    # If n is greater than the number of primes found so far, continue computation.\n    target_ordinal = n\n    current_ordinal_found = len(prime_fib._fib_primes_list)\n\n    def is_prime(num: int) -> bool:\n        \"\"\"\n        Checks if a number is prime using optimized trial division.\n        This covers all necessary primality checks for the problem's expected range.\n        \"\"\"\n        if num < 2:\n            return False\n        if num == 2 or num == 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        \n        # Trial division: check divisors of form 6k +/- 1 up to sqrt(num).\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    # Continue finding Fibonacci primes until the target n-th one is found.\n    while current_ordinal_found < target_ordinal:\n        # Get the current Fibonacci number to check for primality\n        fib_val = prime_fib._f_curr\n        \n        # Calculate the next Fibonacci number in the sequence\n        # Move forward in the Fibonacci sequence: F(k-1), F(k) -> F(k), F(k+1)\n        prime_fib._f_prev, prime_fib._f_curr = prime_fib._f_curr, prime_fib._f_prev + prime_fib._f_curr\n        \n        # Check if the current Fibonacci number is prime. Fibonacci numbers less than 2 are not prime.\n        if is_prime(fib_val):\n            current_ordinal_found += 1\n            prime_fib._fib_primes_list.append(fib_val)\n            prime_fib._cache[current_ordinal_found] = fib_val\n\n    return prime_fib._cache[n]", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[12]]}], "HumanEval/41": [{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int):\n    \"\"\"\n    Imagine a road that's a perfectly straight infinitely long line.\n    n cars are driving left to right;  simultaneously, a different set of n cars\n    are driving right to left.   The two sets of cars start out being very far from\n    each other.  All cars move in the same speed.  Two cars are said to collide\n    when a car that's moving left to right hits a car that's moving right to left.\n    However, the cars are infinitely sturdy and strong; as a result, they continue moving\n    in their trajectory as if they did not collide.\n\n    This function outputs the number of such collisions.\n    \"\"\"\n    # Each of the 'n' cars moving left-to-right will collide with each of the 'n'\n    # cars moving right-to-left exactly once.\n    return n * n", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int):\n    \"\"\"\n    Calculates the number of collisions between two sets of cars.\n    Each of the n cars moving left-to-right collides with each of the n cars moving right-to-left.\n    \"\"\"\n    return n * n", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/40": [{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    arr = sorted(l)\n\n    for i in range(n - 2):\n        # Fix the first element\n        a = arr[i]\n        left, right = i + 1, n - 1\n\n        while left < right:\n            # Calculate the sum of the triplet\n            total = a + arr[left] + arr[right]\n\n            if total == 0:\n                # Triplet found\n                return True\n            elif total < 0:\n                # Sum is too