       except (TypeError, ValueError) as e:\n                raise RescaleError(f\"Input contains non-numeric value at index {i}: {val}\", code=\"NON_NUMERIC_INPUT\") from e\n        return float_list\n\n    @staticmethod\n    def min_max(values: List[float]) -> tuple[float, float]:\n        if not values:\n            raise RescaleError(\"Cannot compute min/max for an empty list.\", code=\"EMPTY_LIST\")\n        min_val = values[0]\n        max_val = values[0]\n        for x in values:\n            if x < min_val:\n                min_val = x\n            if x > max_val:\n                max_val = x\n        return min_val, max_val\n\n    @staticmethod\n    def safe_range(min_v: float, max_v: float, epsilon: float) -> float:\n        delta = max_v - min_v\n        if abs(delta) <= epsilon:\n            raise RescaleError(\"Input numbers have zero range (all values are identical). Cannot rescale.\", code=\"ZERO_RANGE\")\n        return delta\nclass LinearRescaler:\n    def rescale(self, values: List[float], min_v: float, max_v: float) -> List[float]:\n        denom = max_v - min_v # Already validated to be non-zero by safe_range\n        return [(v - min_v) / denom for v in values]\nclass ScalerService:\n    def __init__(self, rescaler: Optional[LinearRescaler] = None, epsilon: Optional[float] = None) -> None:\n        self.rescaler = rescaler if rescaler is not None else LinearRescaler()\n        self.epsilon = epsilon if epsilon is not None else EPSILON\n\n    def rescale_series(self, values: List[object]) -> List[float]:\n        if len(values) < 2:\n            raise RescaleError(\"Input list must contain at least two elements for rescaling.\", code=\"TOO_SHORT_LIST\")\n\n        float_list = StatsUtils.to_float_list(values)\n        min_v, max_v = StatsUtils.min_max(float_list)\n        \n        # This call validates the range and raises RescaleError if it's too small\n        StatsUtils.safe_range(min_v, max_v, self.epsilon) \n\n        return self.rescaler.r