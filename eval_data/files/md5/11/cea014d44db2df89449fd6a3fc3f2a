\n        \"\"\"Raised when an unknown music token is encountered.\"\"\"\n        pass\n\n    class MappingLoadError(Exception):\n        \"\"\"Raised when there's an issue loading a mapping file.\"\"\"\n        pass\n\n    class InvalidInputError(Exception):\n        \"\"\"Raised when input validation fails.\"\"\"\n        pass\n\n    def normalize_whitespace(s: str) -> str:\n        \"\"\"Replaces multiple whitespace characters with a single space and trims leading/trailing whitespace.\"\"\"\n        return re.sub(r\"\\s+\", \" \", s).strip()\n\n    def load_json_file(path: str) -> Dict[str, int]:\n        \"\"\"Loads a JSON file and validates its content for mapping.\"\"\"\n        try:\n            with open(path, 'r', encoding='utf-8') as f:\n                mapping = json.load(f)\n            if not isinstance(mapping, dict):\n                raise MappingLoadError(f\"Mapping file '{path}' must contain a JSON object (dictionary).\")\n            for key, value in mapping.items():\n                if not isinstance(key, str):\n                    raise MappingLoadError(f\"Mapping key '{key}' in '{path}' must be a string.\")\n                if not isinstance(value, int) or value < 1:\n                    raise MappingLoadError(f\"Mapping value for '{key}' in '{path}' must be an integer >= 1.\")\n            return mapping\n        except FileNotFoundError:\n            raise MappingLoadError(f\"Mapping file not found at '{path}'.\")\n        except json.JSONDecodeError as e:\n            raise MappingLoadError(f\"Invalid JSON format in mapping file '{path}': {e}.\")\n        except Exception as e:\n            raise MappingLoadError(f\"An unexpected error occurred loading mapping file '{path}': {e}.\")\n\n    class Note:\n        \"\"\"Represents a musical note with its token and beat duration.\"\"\"\n        def __init__(self, token: str, beats: int) -> None:\n            self.token = token\n            self.beats = beats\n\n        def to_dict(self) -> Dict[str, int]:\n            return {\"token\": self.token, \"beats\": self.beats}\n\n    class Tokenizer:\n        \"\"\"Converts raw music string into a list of normalized tokens.\"\"\"\n        DEFAULT_SPLIT_REGEX = r\"\\s+\"\n\n        def tokenize(self, music_string: str) -> List[str]:\n            normalized = normalize_whitespace(music_string)\n            if not normalized:\n                return []\n            return re.split(self.DEFAULT_SPLIT_REGEX, normalized)\n\n    class MappingRepository(abc.ABC):\n        \"\"\"Abstract base class for token-to-beat mapping repositories.\"\"\"\n        @abc.abstractmethod\n        def get(self, token: str) -> Optional[int]:\n            pass\n\n        @abc.abstractmethod\n        def has(self, token: str) -> bool:\n            pass\n\n        @abc.abstractmethod\n        def all(self) -> Dict[str, int]:\n            pass\n\n    class InMemoryMappingRepository(MappingRepository):\n        \"\"\"An in-memory implementation of MappingRepository using a dictionary.\"\"\"\n        def __init__(self, mapping: Dict[str, int]) -> None:\n            self._mapping = mapping\n\n        def get(self, token: str) -> Optional[int]:\n            return self._mapping.get(token)\n\n        def has(self, token: str) -> bool:\n            return token in self._mapping\n\n        def all(self) -> Dict[str, int]:\n            return self._mapping.copy()\n\n    class FileMappingRepository(MappingRepository):\n        \"\"\"A file-backed implementation of MappingRepository, loading from JSON.\"\"\"\n        def __init__(self, path: str) -> None:\n            self._path = path\n            self._mapping: Dict[str, int] = {}\n\n        def load(self) -> None:\n            \"\"\"Loads the mapping from the specified JSON file.\"\"\"\n            self._mapping = load_json_file(self._path)\n\n        def get(self, token: str) -> Optional[int]:\n            return self._mapping.get(token)\n\n        def has(self, token: str) -> bool:\n            return token in self._mapping\n\n        def all(self) -> Dict[str, int]:\n            return self._mapping.copy()\n\n    class MusicParser:\n        \"\"\"Orchestrates tokenization and mapping to convert a music string into beats.\"\"\"\n        def __init__(self, tokenizer: Tokenizer, repository: MappingRepository, ignore_unknown: bool = False) -> None:\n            self._tokenizer = tokenizer\n            self._repository = repository\n            self._ignore_unknown = ignore_unknown\n\n        def parse(self, music_string: str) -> List[int]:\n            if not isinstance(music_string, str):\n                raise InvalidInputError(\"music_string must be a string\")\n            tokens = self._tokenizer.tokenize(music_string)\n            beats = []\n            for t in tokens:\n                val = self._repository.get(t)\n                if val is None:\n                    if self._ignore_unknown:\n                        continue\n                    raise ParsingError(f\"Unknown token: {t}\")\n                note = Note(t, val)\n                beats.append(note.beats)\n            return beats\n            \n    DEFAULT_MAPPING = {\"o\": 4, \"o|\": 2, \".|\": 1}\n\n    tokenizer = Tokenizer()\n    repo = InMemoryMappingRepository(DEFAULT_MAPPING)\n    parser = MusicParser(tokenizer=tokenizer, repository=repo, ignore_unknown=False) \n    \n    return parser.parse(music_string)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/19": [{"task_id": "HumanEval/19", "solution": "def sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    import string\n    from typing import List\n\n    # Numeral mapping constants\n    WORD_TO_INT = {\n        \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n        \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9,\n    }\n    INT_TO_WORD = {v: k for k, v in WORD_TO_INT.items()}\n\n    # Helper functions for numeral mapping\n    def _word_to_int(word: str) -> int:\n        return WORD_TO_INT[word]\n\n    def _int_to_word(num: int) -> str:\n        return INT_TO_WORD[num]\n\n    def _is_valid_word(word: str) -> bool:\n        return word in WORD_TO_INT\n\n    # Helper for token normalization (from utils.py)\n    def _normalize_token(token: str) -> str:\n        if not token:\n            return \"\"\n        # Lowercases the token and strips common punctuation from its ends.\n        return token.strip(string.punctuation).lower()\n\n    # Custom exception for invalid numeral words (from exceptions.py)\n    class InvalidNumeralError(Exception):\n        def __init__(self, invalid_tokens: List[str]):\n            self.invalid_tokens = invalid_tokens\n            super().__init__(f\"Invalid numeral words: {', '.join(sorted(invalid_tokens))}\")\n        \n        def __str__(self) -> str:\n            return f\"Invalid numeral words: {', '.join(sorted(self.invalid_tokens))}\"\n\n    # Helper for parsing input string into normalized tokens (from parser.py)\n    def _parse_input(input_str: str) -> List[str]:\n        if not input_str:\n            return []\n        raw_tokens = input_str.strip().split()\n        # Normalize each token and filter out any that become empty after normalization.\n        normalized_tokens = [_normalize_token(t) for t in raw_tokens if _normalize_token(t)]\n        return normalized_tokens\n\n    # Core logic combining parsing, validation, mapping, sorting, and formatting\n    tokens = _parse_input(numbers)\n\n    # Validate all tokens against the known numeral words.\n    invalid_tokens_found = [t for t in tokens if not _is_valid_word(t)]\n    if invalid_tokens_found:\n   