{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_string: str, rotation_count: int) -> int:\n    \"\"\"\n    Finds the number of odd decimal values when rotating a binary string a given number of times.\n    Performs left rotations on the binary string and converts each rotated string to decimal.\n    \"\"\"\n\n    def _rotate_left(s: str) -> str:\n        \"\"\"Rotates a string left by one position.\"\"\"\n        if not s:\n            return s\n        return s[1:] + s[0]\n\n    def _binary_to_decimal(s: str) -> int:\n        \"\"\"Converts a binary string to its decimal integer equivalent.\"\"\"\n        return int(s, 2)\n\n    def _is_odd(n: int) -> bool:\n        \"\"\"Checks if a number is odd.\"\"\"\n        return n % 2 != 0\n\n    odd_count = 0\n    current_string = binary_string\n\n    for _ in range(rotation_count):\n        current_string = _rotate_left(current_string)\n        decimal_value = _binary_to_decimal(current_string)\n        if _is_odd(decimal_value):\n            odd_count += 1\n\n    return odd_count"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists: list) -> list:\n    \"\"\"Find common elements across all sublists in nested_lists.\"\"\"\n    # Filter out empty sublists as per design guidance.\n    non_empty_lists = [sublist for sublist in nested_lists if sublist]\n\n    # If no non-empty sublists remain, there are no common elements.\n    if not non_empty_lists:\n        return []\n\n    # Initialize the set of common elements with the first non-empty sublist.\n    common_elements_set = set(non_empty_lists[0])\n\n    # Iterate through the remaining non-empty sublists to find the intersection.\n    for i in range(1, len(non_empty_lists)):\n        current_sublist_set = set(non_empty_lists[i])\n        common_elements_set = common_elements_set.intersection(current_sublist_set)\n        \n        # Optimization: If the common set becomes empty, no further elements can be common.\n        if not common_elements_set:\n            break\n            \n    return list(common_elements_set)"}
{"task_id": "Mbpp/116", "solution": "def tuple_to_int(input_tuple: tuple) -> int:\n    \"\"\"Converts a tuple of positive integers into a single integer by concatenating their digits.\n    Handles empty tuples by returning 0 and assumes valid input as per design context.\"\"\"\n    if not input_tuple:\n        return 0\n    \n    # The design context explicitly avoids input validation within the main function\n    # and assumes helper functions handle it.\n    # For this completion, we'll inline the logic based on the design context's intent.\n\n    # Concatenate digits by converting each integer to a string and joining them.\n    # Then convert the resulting string back to an integer.\n    concatenated_string = \"\".join(str(digit) for digit in input_tuple)\n    return int(concatenated_string)"}
