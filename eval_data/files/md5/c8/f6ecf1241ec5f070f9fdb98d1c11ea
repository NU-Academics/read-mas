{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(source_string: str, filter_string: str) -> str:\n    \"\"\"\n    Remove characters from source_string that are present in filter_string.\n\n    Args:\n        source_string: The string to filter characters from\n        filter_string: String containing characters to remove\n\n    Returns:\n        New string with filtered characters removed\n\n    Example:\n        remove_dirty_chars(\"probasscurve\", \"pros\") == \"bacuve\"\n    \"\"\"\n    chars_to_remove = set(filter_string)\n    result_chars = []\n    for char in source_string:\n        if char not in chars_to_remove:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/12", "solution": "import math\n\ndef sort_matrix(matrix):\n    \"\"\"\n    Sorts a matrix by the ascending sum of its rows.\n    Returns a new matrix with rows sorted based on their sums.\n    \"\"\"\n\n    # Calculate row sums and store original rows with their sums\n    rows_with_sums = []\n    for row in matrix:\n        row_sum = sum(row)\n        rows_with_sums.append((row_sum, row))\n\n    # Sort the list of (sum, row) tuples based on the sum\n    # Python's `sorted` is stable, fulfilling the requirement for equal sums\n    sorted_rows_with_sums = sorted(rows_with_sums, key=lambda x: x[0])\n\n    # Extract the sorted rows to form the new matrix\n    sorted_matrix = [row for row_sum, row in sorted_rows_with_sums]\n\n    return sorted_matrix"}
{"task_id": "Mbpp/16", "solution": "import re\n\ndef text_lowercase_underscore(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input string consists of sequences of lowercase letters\n    joined by single underscores.\n    \"\"\"\n    # The regex pattern ensures the string starts with one or more lowercase letters,\n    # and is optionally followed by groups of an underscore and one or more lowercase letters,\n    # matching the entire string.\n    pattern = r\"^[a-z]+(_[a-z]+)*$\"\n    return bool(re.fullmatch(pattern, input_string))"}
{"task_id": "Mbpp/56", "solution": "def reverse_digits(number: int) -> int:\n    \"\"\"Helper function to reverse the digits of a given number.\"\"\"\n    reversed_num = 0\n    num_copy = abs(number) # Handle negative numbers by reversing absolute value, then reapply sign if needed. For this problem, numbers are likely positive.\n    while num_copy > 0:\n        digit = num_copy % 10\n        reversed_num = reversed_num * 10 + digit\n        num_copy //= 10\n    return reversed_num * (-1 if number < 0 else 1)\n\ndef check(number: int) -> bool:\n    \"\"\"Checks if a given number is one less than twice its reverse.\"\"\"\n    reversed_val = reverse_digits(number)\n    return number == (2 * reversed_val) - 1"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"\n    Checks if a given number is a Woodall number using the formula n * 2^n - 1.\n    It iterates through positive integers n, calculating the Woodall number until it matches or exceeds the input.\n    \"\"\"\n    if number <= 0:\n        return False\n\n    n = 1\n    while True:\n        woodall_candidate = n * (2**n) - 1\n        if woodall_candidate == number:\n            return True\n        elif woodall_candidate > number:\n            return False\n        n += 1"}
{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits: list) -> int:\n    \"\"\"\n    Finds the largest number that can be formed with the given list of digits.\n    The digits are converted to strings, sorted in descending order, joined, and converted back to an integer.\n    \"\"\"\n    # Convert digits to strings for sorting\n    digit_strings = [str(d) for d in digits]\n    # Sort the digit strings in descending order\n    digit_strings.sort(reverse=True)\n    # Join the sorted digit strings to form the largest number string\n    max_num_str = \"\".join(digit_strings)\n    # Convert the resulting string back to an integer\n    return int(max_num_str)"}
