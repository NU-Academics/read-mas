{"task_id": "Mbpp/137", "solution": "def _count_zeros(array: list[int]) -> int:\n    \"\"\"Counts the number of zero elements in an array.\"\"\"\n    count = 0\n    for x in array:\n        if x == 0:\n            count += 1\n    return count\n\ndef _count_non_zeros(array: list[int]) -> int:\n    \"\"\"Counts the number of non-zero elements in an array.\"\"\"\n    count = 0\n    for x in array:\n        if x != 0:\n            count += 1\n    return count\n\ndef _calculate_ratio(zero_count: int, non_zero_count: int) -> float:\n    \"\"\"Calculates the ratio of zeros to non-zeros, handling division by zero.\"\"\"\n    if non_zero_count == 0:\n        return 0.0\n    return float(zero_count) / non_zero_count\n\ndef zero_count(array: list[int]) -> float:\n    \"\"\"\n    Calculates the ratio of zero elements to non-zero elements in an array of integers.\n    Returns 0.0 if there are no non-zero elements.\n    \"\"\"\n    num_zeros = _count_zeros(array)\n    num_non_zeros = _count_non_zeros(array)\n    ratio = _calculate_ratio(num_zeros, num_non_zeros)\n    return ratio"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(input_list):\n    \"\"\"\n    Flatten a list of tuples into a single set of unique numbers.\n\n    Args:\n        input_list: List of tuples containing numeric values\n\n    Returns:\n        set: Set of unique numbers from all tuples\n    \"\"\"\n    unique_numbers = set()\n    for tpl in input_list:\n        for number in tpl:\n            unique_numbers.add(number)\n    return unique_numbers"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(number: int) -> bool:\n    \"\"\"\n    Checks if the given number can be represented as a sum of distinct non-zero powers of 2.\n    This is equivalent to checking if the number's binary representation has at least one '1' bit\n    and that the number is positive.\n    \"\"\"\n    if number <= 0:\n        return False\n    # A number is a sum of distinct non-zero powers of two if and only if\n    # its binary representation has at least one '1' bit, and the powers are distinct.\n    # Since the problem statement specifically asks for non-zero powers of 2,\n    # it implies that 2^0 (which is 1) is not included in the sum.\n    # However, if the problem means \"powers of 2 that are not 1\", this logic holds.\n    # If a number can be represented as a sum of distinct non-zero powers of two,\n    # its binary representation will have '1's at positions corresponding to those powers.\n    # For example, 10 is 1010 in binary (2^3 + 2^1).\n    # Any positive integer can be uniquely represented as a sum of distinct powers of 2.\n    # The requirement \"non-zero powers of 2\" means powers like 2^1, 2^2, 2^3, etc.,\n    # excluding 2^0 = 1.\n    # If number has its LSB set (number & 1 == 1), it means 2^0 is part of the sum.\n    # So, if number is odd, it includes 2^0.\n    # If the number is odd, it *must* include 2^0. If we are restricted to non-zero powers (2^1, 2^2, ...),\n    # then an odd number cannot be formed by summing only non-zero powers of 2.\n    # All sums of non-zero powers of 2 must be even numbers.\n    # Example: 10 (even) = 2^1 + 2^3. 6 (even) = 2^1 + 2^2.\n    # Example: 7 (odd) = 2^0 + 2^1 + 2^2. This includes 2^0.\n    # So, if the number is odd, and we must only use non-zero powers of 2, it's impossible.\n    return number % 2 == 0 and bin(number).count('1') >= 1"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(arr: list) -> list:\n    \"\"\"\n    Sorts a list of elements in ascending order using the pancake sort algorithm.\n    \"\"\"\n    def flip(sub_arr: list, k: int):\n        \"\"\"Reverses elements from index 0 to k (inclusive) in the given sub_arr.\"\"\"\n        start = 0\n        while start < k:\n            sub_arr[start], sub_arr[k] = sub_arr[k], sub_arr[start]\n            start += 1\n            k -= 1\n\n    def find_max_index(sub_arr: list, n: int) -> int:\n        \"\"\"Finds the index of the maximum element in the first 'n' elements of sub_arr.\"\"\"\n        max_val = sub_arr[0]\n        max_idx = 0\n        for i in range(1, n):\n            if sub_arr[i] > max_val:\n                max_val = sub_arr[i]\n                max_idx = i\n        return max_idx\n\n    n = len(arr)\n    # Create a mutable copy of the input list to perform sorting operations\n    sorted_arr = arr[:]\n\n    # Start from the current size of the unsorted part of the array\n    # and gradually reduce it\n    for curr_size in range(n, 1, -1):\n        # Find the index of the maximum element in the current unsorted part\n        max_idx = find_max_index(sorted_arr, curr_size)\n\n        # If the maximum element is not already at its correct sorted position\n        if max_idx != curr_size - 1:\n            # If the maximum element is not at the beginning, flip it to the beginning\n            if max_idx != 0:\n                flip(sorted_arr, max_idx)\n            # Flip the maximum element from the beginning to its correct sorted position\n            flip(sorted_arr, curr_size - 1)\n\n    return sorted_arr"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(arr):\n    \"\"\"\n    Finds the maximum difference between any two elements in a given array.\n    Assumes the input array contains at least two numeric elements.\n    \"\"\"\n    if len(arr) < 2:\n        # According to design, this scenario should ideally raise an error/exception.\n        # However, per current instructions, we are not to raise exceptions for edge cases\n        # and not to add isinstance() checks. For the problem definition with assert,\n        # it implies valid inputs, so a simplified behavior is to return 0 or handle\n        # based on explicit requirement which is missing for this specific edge case.\n        # Given the example (2,1,5,3) implies positive numbers, a simple difference\n        # logic without explicit error handling for < 2 elements will be applied.\n        # If an explicit error or value was required for < 2 elements, it would be specified.\n        # Assuming the problem context ensures valid inputs for the main logic.\n        return 0 # This is a placeholder; behavior for <2 elements not explicitly defined for return value.\n\n    max_val = arr[0]\n    min_val = arr[0]\n\n    for x in arr:\n        if x > max_val:\n            max_val = x\n        if x < min_val:\n            min_val = x\n\n    return max_val - min_val"}
{"task_id": "Mbpp/142", "solution": "def _get_minimum_length(list1, list2, list3):\n    \"\"\"\n    Determines the length of the shortest input list.\n    \"\"\"\n    return min(len(list1), len(list2), len(list3))\n\ndef _compare_elements_at_position(pos, list1, list2, list3):\n    \"\"\"\n    Compares elements at a specific position across all three lists.\n    \"\"\"\n    return list1[pos] == list2[pos] and list2[pos] == list3[pos]\n\ndef count_samepair(list1, list2, list3):\n    \"\"\"\n    Counts number items that are identical in the same position of three given lists.\n    \"\"\"\n    match_count = 0\n    min_length = _get_minimum_length(list1, list2, list3)\n\n    for i in range(min_length):\n        if _compare_elements_at_position(i, list1, list2, list3):\n            match_count += 1\n            \n    return match_count"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(source_list: list, removal_list: list) -> list:\n    \"\"\"\n    Removes all elements from the source list that are present in the removal list,\n    preserving the original order of the remaining elements.\n    \"\"\"\n    removal_set = set(removal_list)\n    filtered_list = []\n    for element in source_list:\n        if element not in removal_set:\n            filtered_list.append(element)\n    return filtered_list"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Calculates the sum of the series (n - 2*i) from i=0 to n//2, including only positive terms.\"\"\"\n    total_sum = 0\n    for i in range(n // 2 + 1):  # Iterate i from 0 up to n // 2 (inclusive)\n        term = n - 2 * i\n        if term > 0:  # Only add terms strictly greater than 0\n            total_sum += term\n    return total_sum"}
{"task_id": "Mbpp/160", "solution": "def gcd(a, b):\n    \"\"\"\n    Calculate the greatest common divisor using the Euclidean algorithm.\n    GCD is always non-negative.\n    \"\"\"\n    a_abs, b_abs = abs(a), abs(b)\n    while b_abs:\n        a_abs, b_abs = b_abs, a_abs % b_abs\n    return a_abs\n\ndef extended_gcd(a, b):\n    \"\"\"\n    Extended Euclidean algorithm to find gcd and B\u00e9zout coefficients.\n    Returns (g, x, y) such that ax + by = g, where g = gcd(|a|, |b|).\n    \"\"\"\n    sign_a = 1 if a >= 0 else -1\n    sign_b = 1 if b >= 0 else -1\n\n    a_abs, b_abs = abs(a), abs(b)\n\n    s0, s1 = 1, 0\n    t0, t1 = 0, 1\n    r0, r1 = a_abs, b_abs\n\n    while r1 != 0:\n        q = r0 // r1\n        r0, r1 = r1, r0 - q * r1\n        s0, s1 = s1, s0 - q * s1\n        t0, t1 = t1, t0 - q * t1\n    \n    # r0 is gcd(|a|, |b|)\n    # s0 and t0 are Bezout coefficients for |a|*s0 + |b|*t0 = r0\n    # Adjust signs of s0 and t0 for the original a and b\n    x = s0 * sign_a\n    y = t0 * sign_b\n    \n    return r0, x, y\n\ndef validate_solution(a, b, n, x, y):\n    \"\"\"\n    Validate that solution (x, y) satisfies the equation ax + by = n.\n    \"\"\"\n    return a * x + b * y == n\n\ndef find_solution(a, b, n):\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple,\n    or returns None if no solution exists.\n    \"\"\"\n    # Special case: a=0, b=0\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    # Calculate g = gcd(|a|, |b|) and x0, y0 such that a*x0 + b*y0 = g\n    g, x0, y0 = extended_gcd(a, b)\n\n    # If n is not divisible by g, no integer solution exists\n    if n % g != 0:\n        return None\n\n    # Calculate particular solution for ax + by = n\n    k = n // g\n    xp = x0 * k\n    yp = y0 * k\n\n    # Adjust (xp, yp) to find a particular solution, often with x being the\n    # smallest non-negative value within the general solution set.\n    # General solution: x = xp + (b/g)*t, y = yp - (a/g)*t\n    b_prime = b // g\n    a_prime = a // g\n\n    # Only adjust if b_prime is not zero, otherwise x is fixed.\n    if b_prime != 0:\n        # Calculate `t` such that `xp + b_prime * t` results in the smallest\n        # non-negative x, or an x within [0, abs(b_prime)-1].\n        # Python's `%` operator aligns the result with the divisor's sign.\n        # This gives remainder in [0, abs(b_prime)-1] if b_prime > 0,\n        # or [-abs(b_prime)+1, 0] if b_prime < 0. We want [0, abs(b_prime)-1].\n        rem_x = xp % b_prime\n        if rem_x < 0:\n            rem_x += b_prime\n        \n        # Calculate `t` to shift `xp` to `rem_x`\n        t = (rem_x - xp) // b_prime\n\n        xp += b_prime * t\n        yp -= a_prime * t\n    \n    return (xp, yp)"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Returns 1 for n=0.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    power = 1\n    # Double the power until it is greater than or equal to n.\n    # This loop runs ceil(log2(n)) times, providing O(log n) complexity.\n    while power < n:\n        power <<= 1  # Equivalent to power = power * 2\n    return power"}
