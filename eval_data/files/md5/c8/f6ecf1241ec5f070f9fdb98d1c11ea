{"task_id": "Mbpp/129", "solution": "from typing import List, Tuple\n\ndef validate_square_matrix(matrix: List[List[int]]) -> bool:\n    \"\"\"\n    Validates if the input is a non-empty square matrix.\n    \"\"\"\n    if not matrix or not matrix[0]:\n        return False\n\n    n = len(matrix)\n    for row in matrix:\n        if len(row) != n:\n            return False\n    return True\n\ndef calculate_row_sums(matrix: List[List[int]]) -> List[int]:\n    \"\"\"\n    Calculates the sum of elements for each row in the matrix.\n    \"\"\"\n    return [sum(row) for row in matrix]\n\ndef calculate_column_sums(matrix: List[List[int]]) -> List[int]:\n    \"\"\"\n    Calculates the sum of elements for each column in the matrix.\n    \"\"\"\n    n = len(matrix)\n    col_sums = [0] * n\n    for i in range(n):\n        for j in range(n):\n            col_sums[j] += matrix[i][j]\n    return col_sums\n\ndef calculate_diagonal_sums(matrix: List[List[int]]) -> Tuple[int, int]:\n    \"\"\"\n    Calculates the sum of elements for both main diagonals.\n    \"\"\"\n    n = len(matrix)\n    main_diag_sum = 0\n    anti_diag_sum = 0\n    for i in range(n):\n        main_diag_sum += matrix[i][i]\n        anti_diag_sum += matrix[i][n - 1 - i]\n    return (main_diag_sum, anti_diag_sum)\n\ndef validate_equal_sums(sums: List[int]) -> bool:\n    \"\"\"\n    Checks if all sums in the provided list are equal.\n    \"\"\"\n    first_sum = sums[0]\n    for s in sums:\n        if s != first_sum:\n            return False\n    return True\n\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"\n    Validates whether a given matrix is a magic square.\n    \"\"\"\n    if not validate_square_matrix(matrix):\n        return False\n\n    row_sums = calculate_row_sums(matrix)\n    col_sums = calculate_column_sums(matrix)\n    main_diag_sum, anti_diag_sum = calculate_diagonal_sums(matrix)\n\n    all_sums = row_sums + col_sums + [main_diag_sum, anti_diag_sum]\n\n    return validate_equal_sums(all_sums)"}
{"task_id": "Mbpp/133", "solution": "from typing import List, Union\n\ndef is_negative(value: Union[int, float]) -> bool:\n    \"\"\"Check if a number is negative (< 0).\"\"\"\n    return value < 0\n\ndef filter_negatives(numbers: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"Filter list to contain only negative numbers.\"\"\"\n    return [num for num in numbers if is_negative(num)]\n\ndef calculate_sum(numbers: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Calculate sum of numbers in a list.\"\"\"\n    return sum(numbers)\n\ndef sum_negativenum(numbers: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Calculate sum of negative numbers in a list.\"\"\"\n    negative_numbers = filter_negatives(numbers)\n    return calculate_sum(negative_numbers)"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(input_string: str) -> str:\n    \"\"\"\n    Reverses only the vowels in a given string, treating 'y' as a consonant.\n    Vowels are a, e, i, o, u (case-insensitive).\n    \"\"\"\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Determines if a character is a vowel (a,e,i,o,u, case-insensitive).\"\"\"\n        return char.lower() in 'aeiou'\n\n    def _preserve_case(original_char: str, replacement_char: str) -> str:\n        \"\"\"Applies original character's case to replacement character.\"\"\"\n        if original_char.isupper():\n            return replacement_char.upper()\n        return replacement_char.lower()\n\n    vowel_positions = []\n    vowels_found = []\n    \n    for i, char in enumerate(input_string):\n        if _is_vowel(char):\n            vowel_positions.append(i)\n            vowels_found.append(char)\n            \n    if not vowels_found:\n        return input_string\n\n    reversed_vowels = vowels_found[::-1]\n    \n    result_list = list(input_string)\n    for i, pos in enumerate(vowel_positions):\n        original_char_at_pos = input_string[pos]\n        replacement_char_from_reversed = reversed_vowels[i]\n        result_list[pos] = _preserve_case(original_char_at_pos, replacement_char_from_reversed)\n        \n    return \"\".join(result_list)"}
