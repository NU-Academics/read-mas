{"task_id": "Mbpp/6", "solution": "def _is_power_of_two(n: int) -> bool:\n    \"\"\"\n    Checks if a number is a power of two.\n    Returns True for positive integers that are powers of 2, False otherwise (including for 0 or negative numbers).\n    \"\"\"\n    return n > 0 and (n & (n - 1)) == 0\n\ndef differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks whether two numbers differ at exactly one bit position.\n    This is true if their XOR result is a power of two.\n    \"\"\"\n    xor_result = num1 ^ num2\n    return _is_power_of_two(xor_result)"}
{"task_id": "Mbpp/3", "solution": "def _is_prime_helper(number: int) -> bool:\n    \"\"\"Checks if a number is prime.\"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\n\ndef is_not_prime(number: int) -> bool:\n    \"\"\"\n    Identifies non-prime numbers.\n\n    Args:\n        number (int): Integer to check for non-prime status\n\n    Returns:\n        bool: False if number is prime, True if number is not prime\n    \"\"\"\n    return not _is_prime_helper(number)"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(collection1, collection2):\n    \"\"\"\n    Finds the shared elements between two collections using set intersection.\n    Converts inputs to sets for efficiency and returns results as a tuple.\n    \"\"\"\n    set1 = set(collection1)\n    set2 = set(collection2)\n    shared = set1.intersection(set2)\n    return tuple(shared)"}
{"task_id": "Mbpp/7", "solution": "def find_char_long(input_string: str) -> list:\n    \"\"\"\n    Finds all words in a string that are at least 4 characters long.\n    Words are separated by whitespace.\n    \"\"\"\n    words = input_string.split()\n    long_words = [word for word in words if len(word) >= 4]\n    return long_words"}
{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef heap_queue_largest(numbers, n):\n    \"\"\"\n    Finds the n largest integers from a list of numbers and returns them in descending order.\n    Uses a heap-based algorithm for efficient computation.\n    \"\"\"\n    if n <= 0 or not numbers:\n        return []\n    \n    return heapq.nlargest(n, numbers)"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, character: str) -> str:\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    \"\"\"\n\n    def _find_first_occurrence(s: str, char: str) -> int:\n        \"\"\"Locates the first occurrence position of character in string.\"\"\"\n        return s.find(char)\n\n    def _find_last_occurrence(s: str, char: str) -> int:\n        \"\"\"Locates the last occurrence position of character in string.\"\"\"\n        return s.rfind(char)\n\n    def _remove_characters_at_positions(s: str, positions: list) -> str:\n        \"\"\"Removes characters at specified positions from string.\"\"\"\n        if not positions:\n            return s\n        \n        # Sort positions in descending order to handle removals without affecting subsequent indices\n        # However, it's easier to build a new string by skipping indices.\n        # Ensure positions are unique for correct removal count.\n        unique_positions = sorted(list(set(positions)))\n\n        result_chars = []\n        skip_indices = set(unique_positions)\n        for i, char_in_s in enumerate(s):\n            if i not in skip_indices:\n                result_chars.append(char_in_s)\n        return \"\".join(result_chars)\n\n    first_idx = _find_first_occurrence(input_string, character)\n\n    if first_idx == -1:\n        # Character not found at all\n        return input_string\n\n    last_idx = _find_last_occurrence(input_string, character)\n\n    positions_to_remove = [first_idx]\n    if first_idx != last_idx:\n        positions_to_remove.append(last_idx)\n    \n    return _remove_characters_at_positions(input_string, positions_to_remove)"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Find minimum number of rotations (greater than 0) required to get the same string.\n    \"\"\"\n    # The problem asks for the minimum positive number of rotations to\n    # return a string to its original form, which is equivalent to finding\n    # the length of the string's smallest repeating unit (its period).\n    # The \"string concatenation method\" finds this by searching for the\n    # original string 's' within 's + s', starting the search from index 1\n    # to ensure that the match is a true rotation, not the original string itself.\n    return (s + s).find(s, 1)"}
