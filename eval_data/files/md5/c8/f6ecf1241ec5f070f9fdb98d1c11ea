{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum absolute difference between the count of 0s and 1s in any substring.\n    Analyzes all substrings and returns the greatest difference between 0s and 1s.\n    \"\"\"\n    \n    def _count_chars_in_substring(sub: str) -> tuple[int, int]:\n        \"\"\"Counts the occurrences of '0' and '1' in a given substring.\"\"\"\n        count_0 = sub.count('0')\n        count_1 = sub.count('1')\n        return count_0, count_1\n\n    def _calculate_abs_difference(zero_count: int, one_count: int) -> int:\n        \"\"\"Calculates the absolute difference between two character counts.\"\"\"\n        return abs(zero_count - one_count)\n\n    max_overall_diff = 0\n    n = len(binary_string)\n\n    # Iterate through all possible start indices for substrings\n    for i in range(n):\n        # Iterate through all possible end indices for substrings\n        for j in range(i, n):\n            current_substring = binary_string[i : j + 1]\n            \n            # Count '0's and '1's in the current substring\n            zeros, ones = _count_chars_in_substring(current_substring)\n            \n            # Calculate the absolute difference for the current substring\n            current_substring_diff = _calculate_abs_difference(zeros, ones)\n            \n            # Update the maximum difference found so far\n            if current_substring_diff > max_overall_diff:\n                max_overall_diff = current_substring_diff\n                \n    return max_overall_diff"}
{"task_id": "Mbpp/126", "solution": "import builtins\n\ndef get_divisors(number: int) -> list[int]:\n    \"\"\"Calculate all divisors of a given number.\"\"\"\n    divs = []\n    for i in range(1, number + 1):\n        if number % i == 0:\n            divs.append(i)\n    return divs\n\ndef find_common_divisors(num1: int, num2: int) -> list[int]:\n    \"\"\"Find divisors common to both input numbers.\"\"\"\n    divisors1 = get_divisors(num1)\n    divisors2 = get_divisors(num2)\n    common = set(divisors1).intersection(set(divisors2))\n    return list(common)\n\ndef sum(num1: int, num2: int) -> int:\n    \"\"\"Main API function that calculates sum of common divisors.\"\"\"\n    common_divs = find_common_divisors(num1, num2)\n    return builtins.sum(common_divs)"}
