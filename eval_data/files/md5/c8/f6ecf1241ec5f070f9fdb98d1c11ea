{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"Check if a string represents a valid integer.\"\"\"\n\n    def _is_empty(s: str) -> bool:\n        \"\"\"Check if string is empty or whitespace-only.\"\"\"\n        return not s.strip()\n\n    def _has_valid_sign(s: str) -> bool:\n        \"\"\"Check if string has a valid leading sign or starts with a digit.\"\"\"\n        if not s:\n            return False\n        first_char = s[0]\n        if first_char.isdigit():\n            return True\n        if first_char == '-' or first_char == '+':\n            # A sign must be followed by at least one digit\n            return len(s) > 1\n        return False\n\n    def _has_only_digits(s: str) -> bool:\n        \"\"\"Check if string contains only numeric digits.\"\"\"\n        return s.isdigit()\n\n    if _is_empty(input_string):\n        return False\n\n    if not _has_valid_sign(input_string):\n        return False\n\n    # Determine the part of the string that should contain only digits\n    digits_part = input_string\n    if input_string[0] == '-' or input_string[0] == '+':\n        digits_part = input_string[1:]\n\n    return _has_only_digits(digits_part)"}
{"task_id": "Mbpp/119", "solution": "def _is_pair_start(array: list, index: int) -> bool:\n    \"\"\"Check if element at index starts a pair.\"\"\"\n    return index + 1 < len(array) and array[index] == array[index + 1]\n\ndef _find_unique_binary(array: list, left: int, right: int) -> int:\n    \"\"\"Binary search helper for finding unique element.\"\"\"\n    if left == right:\n        return array[left]\n\n    mid = (left + right) // 2\n\n    # If mid is an even index\n    if mid % 2 == 0:\n        # If array[mid] is the start of a pair (i.e., array[mid] == array[mid+1])\n        # This pair is correctly aligned; the unique element is to the right.\n        if _is_pair_start(array, mid):\n            return _find_unique_binary(array, mid + 2, right)\n        # Otherwise, array[mid] is either the unique element or there's a shift.\n        # The unique element is in the left half (including mid).\n        else:\n            return _find_unique_binary(array, left, mid)\n    # If mid is an odd index\n    else: # mid % 2 == 1\n        # If array[mid] is the end of a pair (i.e., array[mid-1] == array[mid])\n        # This pair is correctly aligned; the unique element is to the right.\n        if mid - 1 >= 0 and array[mid] == array[mid - 1]:\n            return _find_unique_binary(array, mid + 1, right)\n        # Otherwise, array[mid] is either the unique element or there's a shift.\n        # The unique element is in the left half (including mid-1).\n        else:\n            return _find_unique_binary(array, left, mid - 1)\n\ndef search(array: list) -> int:\n    \"\"\"Find element that appears only once in sorted array.\"\"\"\n    # Assuming the array is non-empty and has an odd number of elements.\n    return _find_unique_binary(array, 0, len(array) - 1)"}
{"task_id": "Mbpp/123", "solution": "import math\n\ndef sum_of_divisors(n):\n    \"\"\"Calculates the sum of proper divisors of a number.\"\"\"\n    if n <= 1:\n        return 0\n    \n    divisors_sum = 1 \n    \n    for i in range(2, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            divisors_sum += i\n            if i * i != n:\n                divisors_sum += (n // i)\n    return divisors_sum\n\ndef is_amicable_pair(a, b):\n    \"\"\"Checks if two numbers form an amicable pair.\"\"\"\n    if a == b:\n        return False\n    \n    sum_a_div = sum_of_divisors(a)\n    sum_b_div = sum_of_divisors(b)\n    \n    return sum_a_div == b and sum_b_div == a\n\ndef find_amicable_numbers(limit):\n    \"\"\"Finds all amicable numbers up to the specified limit.\"\"\"\n    amicable_set = set()\n    \n    for n in range(1, limit + 1):\n        m = sum_of_divisors(n)\n        \n        # Check if m is a valid candidate for an amicable pair within the limit.\n        # We ensure n < m to avoid redundant checks and adding pairs twice.\n        if m > n and m <= limit:\n            if is_amicable_pair(n, m):\n                amicable_set.add(n)\n                amicable_set.add(m)\n                \n    return amicable_set\n\ndef amicable_numbers_sum(limit):\n    \"\"\"Sums all amicable numbers up to the specified limit.\"\"\"\n    amicable_nums = find_amicable_numbers(limit)\n    return sum(amicable_nums)"}
