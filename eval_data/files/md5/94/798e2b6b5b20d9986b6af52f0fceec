{"task_id": "Mbpp/409", "solution": "def min_product_tuple(list_of_tuples: list[tuple[int | float, int | float]]) -> int | float:\n    \"\"\"\n    Finds the minimum product from pairs of numbers within a given list of tuples.\n\n    Args:\n        list_of_tuples: A list where each element is a tuple containing two numerical elements.\n\n    Returns:\n        The minimum product found among all tuples.\n\n    Raises:\n        ValueError: If the input list is empty or contains tuples with non-numerical elements.\n    \"\"\"\n    if not list_of_tuples:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    # Initialize min_product with the product of the first tuple\n    try:\n        first_element1, first_element2 = list_of_tuples[0]\n        min_product = first_element1 * first_element2\n    except (TypeError, ValueError) as e:\n        raise ValueError(f\"Invalid tuple format or non-numerical elements in first tuple: {e}\")\n    except IndexError: # Should not happen if not list_of_tuples check passes, but for robustness\n        raise ValueError(\"Input list is unexpectedly empty after initial check.\")\n\n    # Iterate through the rest of the tuples\n    for i in range(1, len(list_of_tuples)):\n        try:\n            element1, element2 = list_of_tuples[i]\n            current_product = element1 * element2\n            if current_product < min_product:\n                min_product = current_product\n        except (TypeError, ValueError) as e:\n            raise ValueError(f\"Invalid tuple format or non-numerical elements in tuple at index {i}: {e}\")\n\n    return min_product"}
{"task_id": "Mbpp/414", "solution": "def overlapping(sequence1: list, sequence2: list) -> bool:\n    \"\"\"\n    Checks if any value in sequence1 exists in sequence2.\n    For efficiency, converts sequence2 to a set for faster lookups.\n    \"\"\"\n    set_sequence2 = set(sequence2)\n    for item in sequence1:\n        if item in set_sequence2:\n            return True\n    return False"}
{"task_id": "Mbpp/412", "solution": "def remove_odd(numbers: list) -> list:\n    \"\"\"\n    Removes odd numbers from a list, returning a new list with only even numbers.\n    Maintains the original relative order of elements.\n    \"\"\"\n    even_numbers = []\n    for number in numbers:\n        if number % 2 == 0:\n            even_numbers.append(number)\n    return even_numbers"}
{"task_id": "Mbpp/415", "solution": "def max_Product(numbers: list[int]) -> tuple[int, int] | None:\n    \"\"\"\n    Finds the pair of integers with the highest product from a given list.\n    Returns a tuple containing the two integers with the maximum product,\n    or None if the input list has fewer than two elements.\n    \"\"\"\n    if len(numbers) < 2:\n        return None\n\n    max_product = -float('inf')\n    result_pair = None\n\n    for i in range(len(numbers)):\n        for j in range(i + 1, len(numbers)):\n            num1 = numbers[i]\n            num2 = numbers[j]\n            current_product = num1 * num2\n\n            if current_product > max_product:\n                max_product = current_product\n                result_pair = (num1, num2)\n\n    return result_pair"}
