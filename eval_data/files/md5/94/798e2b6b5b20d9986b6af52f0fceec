{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip_address_str: str) -> str:\n    \"\"\"Removes leading zeros from each octet of an IP address string.\n\n    Args:\n        ip_address_str: The input IP address string (e.g., '216.08.094.196').\n\n    Returns:\n        A string representing the IP address with leading zeros removed (e.g., '216.8.94.196').\n    \"\"\"\n\n    class Octet:\n        \"\"\"Represents a single IP address octet and provides its string representation with leading zeros removed.\"\"\"\n        def __init__(self, raw_octet_str: str):\n            self._raw_value = raw_octet_str\n            self._numeric_value = int(raw_octet_str)\n\n        def get_cleaned_value(self) -> str:\n            \"\"\"Returns the string representation of the octet with leading zeros removed.\"\"\"\n            return str(self._numeric_value)\n\n    class IPAddress:\n        \"\"\"Encapsulates an IP address, handles parsing into Octet objects, and reconstructs the cleaned IP string.\"\"\"\n        def __init__(self, raw_ip_address: str):\n            self._raw_value = raw_ip_address\n            self._octets: list[Octet] = []\n            for octet_str in raw_ip_address.split('.'):\n                self._octets.append(Octet(octet_str))\n\n        def get_cleaned_ip(self) -> str:\n            \"\"\"Returns the IP address string with leading zeros removed from its octets.\"\"\"\n            return \".\".join([octet.get_cleaned_value() for octet in self._octets])\n\n    ip_address_obj = IPAddress(ip_address_str)\n    return ip_address_obj.get_cleaned_ip()"}
{"task_id": "Mbpp/590", "solution": "import math\nclass RectangularCoordinate:\n    \"\"\"Represents rectangular coordinates (x, y).\"\"\"\n    def __init__(self, x: float, y: float):\n        self.x = x\n        self.y = y\n\n    def __repr__(self) -> str:\n        return f\"RectangularCoordinate(x={self.x}, y={self.y})\"\n\n    def __eq__(self, other) -> bool:\n        if not isinstance(other, RectangularCoordinate):\n            return NotImplemented\n        # Using math.isclose for float comparison to handle precision issues.\n        return math.isclose(self.x, other.x) and math.isclose(self.y, other.y)\ndef polar_rect(r: float, theta: float) -> RectangularCoordinate:\n    \"\"\"\n    Converts polar coordinates (r, theta) to rectangular coordinates (x, y).\n    Calculates x = r * cos(theta) and y = r * sin(theta).\n    \"\"\"\n    x = r * math.cos(theta)\n    y = r * math.sin(theta)\n    return RectangularCoordinate(x, y)"}
{"task_id": "Mbpp/594", "solution": "def _find_first_even(numbers: list) -> int | None:\n    \"\"\"Finds the first even number in a list.\"\"\"\n    for number in numbers:\n        if number % 2 == 0:\n            return number\n    return None\ndef _find_first_odd(numbers: list) -> int | None:\n    \"\"\"Finds the first odd number in a list.\"\"\"\n    for number in numbers:\n        if number % 2 != 0:\n            return number\n    return None\ndef diff_even_odd(numbers: list) -> int:\n    \"\"\"\n    Calculates the difference between the first even and first odd number in a list.\n    Raises ValueError if either number type is not found.\n    \"\"\"\n    first_even = _find_first_even(numbers)\n    first_odd = _find_first_odd(numbers)\n\n    if first_even is None:\n        raise ValueError(\"No even number found in the list.\")\n    if first_odd is None:\n        raise ValueError(\"No odd number found in the list.\")\n\n    return first_even - first_odd"}
{"task_id": "Mbpp/592", "solution": "def sum_Of_product(n: int) -> int:\n    \"\"\"Calculates the sum of C(n, k) * C(n, k+1) for k from 0 to n-1.\n    This involves calculating factorials and binomial coefficients using helper functions.\"\"\"\n\n    def _factorial(num: int) -> int:\n        \"\"\"Computes num! for a non-negative integer.\"\"\"\n        if num == 0:\n            return 1\n        res = 1\n        for i in range(1, num + 1):\n            res *= i\n        return res\n\n    def _calculate_binomial_coefficient(n_val: int, k_val: int) -> int:\n        \"\"\"Computes the binomial coefficient n_val! / (k_val! * (n_val - k_val)!).\"\"\"\n        numerator = _factorial(n_val)\n        denominator = _factorial(k_val) * _factorial(n_val - k_val)\n        return numerator // denominator\n\n    total_sum = 0\n    for k in range(n):  # k from 0 to n-1\n        C_nk = _calculate_binomial_coefficient(n, k)\n        C_nk1 = _calculate_binomial_coefficient(n, k + 1)\n        total_sum += C_nk * C_nk1\n    return total_sum"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"Checks if the given number is an Armstrong number.\"\"\"\n    if number < 0:\n        return False # Armstrong numbers are typically defined for non-negative integers.\n\n    num_str = str(number)\n    num_digits = len(num_str)\n    sum_of_powers = 0\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        sum_of_powers += digit ** num_digits\n\n    return sum_of_powers == number"}
{"task_id": "Mbpp/597", "solution": "from typing import List\nclass KthElementFinder:\n    \"\"\"Encapsulates the algorithm for finding the k-th smallest element from two sorted arrays.\"\"\"\n\n    def find_kth_internal(self, array1: List[int], array2: List[int], k: int) -> int:\n        \"\"\"\n        Finds the k-th smallest element from two sorted arrays using a merge-like approach.\n        Assumes array1 and array2 are sorted and k is within the valid range.\n        \"\"\"\n        len1, len2 = len(array1), len(array2)\n        # This check is technically redundant if `find_kth` validates k first, but kept as per design.\n        if k < 1 or k > (len1 + len2):\n            raise ValueError(\"k is out of bounds\")\n\n        ptr1, ptr2 = 0, 0\n        current_k = 0\n        result = -1\n\n        while ptr1 < len1 and ptr2 < len2:\n            current_k += 1\n            if array1[ptr1] < array2[ptr2]:\n                if current_k == k:\n                    result = array1[ptr1]\n                    break\n                ptr1 += 1\n            else:\n                if current_k == k:\n                    result = array2[ptr2]\n                    break\n                ptr2 += 1\n\n        if result == -1:\n            while ptr1 < len1:\n                current_k += 1\n                if current_k == k:\n                    result = array1[ptr1]\n                    break\n                ptr1 += 1\n\n            while ptr2 < len2:\n                current_k += 1\n                if current_k == k:\n                    result = array2[ptr2]\n                    break\n                ptr2 += 1\n\n        return result\ndef find_kth(array1: List[int], array2: List[int], k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays.\n\n    This function validates k and delegates the core logic to a KthElementFinder instance.\n    \"\"\"\n    total_elements = len(array1) + len(array2)\n    if k < 1 or k > total_elements:\n        raise ValueError(f\"Invalid k value. k must be between 1 and {total_elements} (inclusive).\")\n\n    finder = KthElementFinder()\n    return finder.find_kth_internal(array1, array2, k)"}
