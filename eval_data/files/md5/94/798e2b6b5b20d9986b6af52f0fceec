{"task_id": "Mbpp/308", "solution": "import heapq\ndef _compute_all_products(list1: list[int], list2: list[int]) -> list[int]:\n    \"\"\"\n    Computes all possible products from two input lists.\n    Generates a flat list of all pairwise products.\n    \"\"\"\n    all_products = []\n    for num1 in list1:\n        for num2 in list2:\n            all_products.append(num1 * num2)\n    return all_products\ndef _find_k_largest(all_products: list[int], k: int) -> list[int]:\n    \"\"\"\n    Identifies the k largest products from a given list of products.\n    Selects the top k elements using a min-heap, without guaranteeing their sorted order.\n    \"\"\"\n    if not all_products or k <= 0:\n        return []\n\n    # Use a min-heap to keep track of the k largest elements.\n    # The heap will store at most k elements.\n    min_heap = []\n    for product in all_products:\n        if len(min_heap) < k:\n            heapq.heappush(min_heap, product)\n        elif product > min_heap[0]:\n            # If current product is larger than the smallest in the heap,\n            # remove the smallest and add the current product.\n            heapq.heapreplace(min_heap, product)\n            \n    # The elements in min_heap are the k largest values, but their order is not guaranteed.\n    return min_heap\ndef _sort_descending(products: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of products in descending order.\n    Returns a new list with elements sorted from largest to smallest.\n    \"\"\"\n    return sorted(products, reverse=True)\ndef large_product(list1: list[int], list2: list[int], k: int) -> list[int]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    all_products = _compute_all_products(list1, list2)\n    k_largest_unsorted = _find_k_largest(all_products, k)\n    k_largest_sorted = _sort_descending(k_largest_unsorted)\n    return k_largest_sorted"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Calculates the maximum sum of an increasing subsequence from arr[0...i]\n    where all elements are strictly less than arr[k], then adds arr[k] to this sum.\n    \"\"\"\n    threshold_value = arr[k]\n    \n    # dp[j] stores the maximum sum of an increasing subsequence ending at arr[j],\n    # where all elements in the subsequence are strictly less than threshold_value.\n    dp = [0] * (i + 1)\n    \n    max_prefix_sum = 0\n\n    for j in range(i + 1):\n        current_val = arr[j]\n        \n        # An element can only be part of the valid subsequence if it's less than threshold_value.\n        if current_val < threshold_value:\n            # Base case: subsequence containing only current_val\n            current_max_sum_ending_at_j = current_val\n            \n            # Find previous elements that can extend the increasing subsequence\n            for p in range(j):\n                if arr[p] < current_val:\n                    # If arr[p] was eligible (i.e., dp[p] > 0), consider extending its subsequence\n                    current_max_sum_ending_at_j = max(current_max_sum_ending_at_j, dp[p] + current_val)\n            \n            dp[j] = current_max_sum_ending_at_j\n            max_prefix_sum = max(max_prefix_sum, dp[j])\n        else:\n            # If current_val >= threshold_value, it cannot be the ending element of a valid subsequence.\n            # So dp[j] remains 0 (or explicitly set to 0).\n            dp[j] = 0 \n\n    final_sum = max_prefix_sum + threshold_value\n    return final_sum"}
{"task_id": "Mbpp/312", "solution": "import math\ndef volume_cone(radius: float, height: float) -> float:\n    \"\"\"\n    Calculates the volume of a cone given its radius and height.\n    The formula used is V = (1/3) * \u03c0 * r^2 * h.\n    \"\"\"\n    volume = (1/3) * math.pi * (radius ** 2) * height\n    return volume"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(number: int) -> int:\n    \"\"\"Sets the left-most (highest-order) unset bit in an integer.\n    For positive numbers, it finds the highest unset bit within its representation, extending if all lower bits are set.\n    For negative numbers, it finds the highest unset bit within a practical fixed-bit range.\n    \"\"\"\n    if number >= 0:\n        if number == 0:\n            return 1\n\n        num_bits = number.bit_length()\n        # Search for the highest unset bit from bit_length()-1 down to 0.\n        for i in range(num_bits - 1, -1, -1):\n            if not (number & (1 << i)):\n                return number | (1 << i)\n\n        # If all bits from 0 to num_bits-1 are set, the next bit (at num_bits) is the left-most unset bit.\n        return number | (1 << num_bits)\n    else:  # Negative numbers\n        # For negative numbers, find the highest 0-bit within a practical range (e.g., 128 bits).\n        # Python's arbitrary precision for negative numbers means conceptual infinite 1s to the left.\n        for i in range(127, -1, -1):\n            if not (number & (1 << i)):\n                return number | (1 << i)\n        # If no unset bit is found up to position 127 (e.g., if number is -1), return the original.\n        return number"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"\n    Identifies the highest power of 2 that is less than or equal to n.\n    It iterates by doubling the power until it exceeds n.\n    \"\"\"\n    power = 1\n    while power * 2 <= n:\n        power *= 2\n    return power"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"\n    Calculates the n'th Lucas number.\n    L(0) = 2, L(1) = 1, and L(n) = L(n-1) + L(n-2) for n > 1.\n    \"\"\"\n    if n == 0:\n        return 2\n    elif n == 1:\n        return 1\n    else:\n        a, b = 2, 1\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b"}
{"task_id": "Mbpp/392", "solution": "_memo = {}\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Calculates the maximum sum for a given integer n recursively with memoization.\n    The function follows the rule: f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    \"\"\"\n    if n <= 1:\n        return n\n    if n in _memo:\n        return _memo[n]\n\n    sum_of_parts = get_max_sum(n // 2) + \\\n                   get_max_sum(n // 3) + \\\n                   get_max_sum(n // 4) + \\\n                   get_max_sum(n // 5)\n\n    result = max(sum_of_parts, n)\n    _memo[n] = result\n    return result"}
