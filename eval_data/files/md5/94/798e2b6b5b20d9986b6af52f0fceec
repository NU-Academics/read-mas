{"task_id": "Mbpp/290", "solution": "def max_length(list_of_lists):\n    \"\"\"\n    Finds the list of maximum length in a list of lists and returns its length and the list itself.\n    If multiple lists have the same maximum length, the first one encountered is returned.\n    \"\"\"\n    max_len = 0\n    max_list_found = None\n\n    for inner_list in list_of_lists:\n        current_len = len(inner_list)\n        if current_len > max_len:\n            max_len = current_len\n            max_list_found = inner_list\n            \n    return (max_len, max_list_found)"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers.\n    Raises ValueError if n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input n must be a non-negative integer\")\n\n    total_sum = 0\n    for i in range(1, n + 1):\n        even_number = 2 * i\n        total_sum += even_number ** 2\n    return total_sum"}
{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in the modified array\n    formed by repeating the given array 'arr' 'k' times.\n    \"\"\"\n    def _kadane(arr: list[int]) -> int:\n        \"\"\"Calculates the maximum sum of a contiguous subarray using Kadane's algorithm.\"\"\"\n        max_so_far = float('-inf')\n        current_max = 0\n        max_val = float('-inf') # To handle cases where all numbers are negative\n\n        for x in arr:\n            max_val = max(max_val, x) # Keep track of the largest single element\n            current_max += x\n            max_so_far = max(max_so_far, current_max)\n            if current_max < 0:\n                current_max = 0\n        return max(max_so_far, max_val) if max_so_far > 0 or max_val < 0 else max_so_far\n\n    def _max_prefix_sum(arr: list[int]) -> int:\n        \"\"\"Computes the maximum sum of any prefix subarray.\"\"\"\n        max_prefix = float('-inf')\n        current_sum = 0\n        for x in arr:\n            current_sum += x\n            max_prefix = max(max_prefix, current_sum)\n        return max_prefix\n\n    def _max_suffix_sum(arr: list[int]) -> int:\n        \"\"\"Computes the maximum sum of any suffix subarray.\"\"\"\n        max_suffix = float('-inf')\n        current_sum = 0\n        for x in reversed(arr):\n            current_sum += x\n            max_suffix = max(max_suffix, current_sum)\n        return max_suffix\n\n    if not arr:\n        return 0\n\n    max_sum_single_pass = _kadane(arr)\n\n    if k == 1:\n        return max_sum_single_pass\n\n    total_sum = sum(arr)\n    max_prefix = _max_prefix_sum(arr)\n    max_suffix = _max_suffix_sum(arr)\n\n    # The maximum sum could span across multiple repetitions.\n    # This involves a suffix of the first array, (k-2) full arrays, and a prefix of the last array.\n    max_sum_multi_pass = max_suffix + max_prefix\n    if total_sum > 0:\n        max_sum_multi_pass += (k - 2) * total_sum\n\n    return max(max_sum_single_pass, max_sum_multi_pass)"}
