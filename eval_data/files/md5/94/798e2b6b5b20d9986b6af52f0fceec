{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is undulating. An undulating number has at least three digits\n    and its digits strictly alternate between two distinct digits.\n    \"\"\"\n    s_num = str(number)\n\n    if len(s_num) < 3:\n        return False\n\n    # Find the first two distinct digits.\n    # If all digits are the same up to the second digit, it cannot be undulating.\n    # E.g., 112 is not undulating because the first two digits are not distinct.\n    first_digit = s_num[0]\n    second_digit = ''\n    \n    # Find the first digit that is different from the first_digit\n    for i in range(1, len(s_num)):\n        if s_num[i] != first_digit:\n            second_digit = s_num[i]\n            break\n    \n    # If no second distinct digit is found (e.g., 111, 2222), it's not undulating.\n    if second_digit == '':\n        return False\n\n    # Check for alternating pattern\n    for i in range(len(s_num)):\n        if i % 2 == 0:  # Even index should match the first distinct digit\n            if s_num[i] != first_digit:\n                return False\n        else:  # Odd index should match the second distinct digit\n            if s_num[i] != second_digit:\n                return False\n\n    return True"}
{"task_id": "Mbpp/96", "solution": "def divisor(n):\n    \"\"\"\n    Counts the number of positive divisors for a given integer n.\n    It efficiently iterates up to the square root of n.\n    \"\"\"\n    count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(list_of_numbers):\n    \"\"\"Calculates the product of all numbers in a list and divides by the list's length.\n    Returns 0.0 if the input list is empty to handle division by zero.\n    \"\"\"\n    length = len(list_of_numbers)\n    if length == 0:\n        return 0.0\n\n    product = 1.0\n    for num in list_of_numbers:\n        product *= num\n\n    return product / length"}
{"task_id": "Mbpp/97", "solution": "def frequency_lists(nested_list: list[list[any]]) -> dict[any, int]:\n    \"\"\"Calculates the frequency of each element in a flattened list of lists.\n    Returns a dictionary where keys are unique elements and values are their counts.\n    \"\"\"\n\n    def _flatten_list(nested_list: list[list[any]]) -> list[any]:\n        \"\"\"Flattens a list of lists into a single list.\n        It iterates through sublists and appends each element to a new flat list.\n        \"\"\"\n        flat_list = []\n        for sublist in nested_list:\n            for item in sublist:\n                flat_list.append(item)\n        return flat_list\n\n    def _count_frequencies(flat_list: list[any]) -> dict[any, int]:\n        \"\"\"Counts the frequency of each element in a flat list.\n        It uses a dictionary to store and increment counts for each unique element.\n        \"\"\"\n        frequency_map = {}\n        for item in flat_list:\n            frequency_map[item] = frequency_map.get(item, 0) + 1\n        return frequency_map\n\n    flat_list = _flatten_list(nested_list)\n    frequency_map = _count_frequencies(flat_list)\n    return frequency_map"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_num: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal integer to its binary string equivalent.\n    Ensures no leading zeros, except for decimal_num = 0 which returns '0'.\n    \"\"\"\n    if decimal_num == 0:\n        return '0'\n\n    binary_str = []\n    temp_num = decimal_num\n    while temp_num > 0:\n        binary_str.append(str(temp_num % 2))\n        temp_num //= 2\n\n    return ''.join(binary_str[::-1])"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(snake_case_string: str) -> str:\n    \"\"\"\n    Converts a snake_case string to a CamelCase string.\n    This function capitalizes the first letter of each word and removes all underscores.\n    \"\"\"\n    words = snake_case_string.split('_')\n    camel_case_words = [word.capitalize() for word in words]\n    return ''.join(camel_case_words)"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"Calculates the Eulerian number a(n, m) using its explicit formula.\"\"\"\n\n    def combinations(N, K):\n        \"\"\"Calculates the binomial coefficient C(N, K).\"\"\"\n        if K < 0 or K > N:\n            return 0\n        if K == 0 or K == N:\n            return 1\n        if K > N // 2:\n            K = N - K\n        \n        res = 1\n        for i in range(K):\n            res = res * (N - i) // (i + 1)\n        return res\n\n    eulerian_sum = 0\n    for k in range(m + 1):\n        term = ((-1)**k) * combinations(n + 1, k) * ((m - k + 1)**n)\n        eulerian_sum += term\n        \n    return eulerian_sum"}
