{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: list) -> int:\n    \"\"\"\n    Counts inversions in an array using a merge sort-based approach.\n    This function modifies the input array in place during the sorting process.\n    \"\"\"\n    n = len(arr)\n    # Create a temporary array for merging, required for merge sort.\n    temp_arr = [0] * n\n\n    def _merge(arr_local, temp_arr_local, left_local, mid_local, right_local):\n        i = left_local     # Starting index for left subarray\n        j = mid_local + 1  # Starting index for right subarray\n        k = left_local     # Starting index to store merged result in temp_arr\n        inv_count_local = 0\n\n        while i <= mid_local and j <= right_local:\n            if arr_local[i] <= arr_local[j]:\n                temp_arr_local[k] = arr_local[i]\n                i += 1\n            else:\n                # An inversion occurs: arr_local[i] > arr_local[j].\n                # All remaining elements in the left subarray (from i to mid_local)\n                # will also be greater than arr_local[j].\n                inv_count_local += (mid_local - i + 1)\n                temp_arr_local[k] = arr_local[j]\n                j += 1\n            k += 1\n\n        # Copy the remaining elements of the left subarray, if any.\n        while i <= mid_local:\n            temp_arr_local[k] = arr_local[i]\n            i += 1\n            k += 1\n\n        # Copy the remaining elements of the right subarray, if any.\n        while j <= right_local:\n            temp_arr_local[k] = arr_local[j]\n            j += 1\n            k += 1\n\n        # Copy the merged elements back to the original array segment.\n        for idx in range(left_local, right_local + 1):\n            arr_local[idx] = temp_arr_local[idx]\n\n        return inv_count_local\n\n    def _mergeSort(arr_local, temp_arr_local, left_local, right_local):\n        inv_count_local = 0\n        # Base case: if the subarray has more than one element.\n        if left_local < right_local:\n            mid_local = (left_local + right_local) // 2\n\n            # Recursively count inversions in left and right halves.\n            inv_count_local += _mergeSort(arr_local, temp_arr_local, left_local, mid_local)\n            inv_count_local += _mergeSort(arr_local, temp_arr_local, mid_local + 1, right_local)\n\n            # Count inversions during the merge step.\n            inv_count_local += _merge(arr_local, temp_arr_local, left_local, mid_local, right_local)\n        return inv_count_local\n\n    # Initiate the merge sort process on the entire array.\n    return _mergeSort(arr, temp_arr, 0, n - 1)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(input_dict: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary.\n\n    Args:\n        input_dict: The dictionary for which to calculate the depth.\n\n    Returns:\n        An integer representing the maximum nesting depth.\n    \"\"\"\n    if not isinstance(input_dict, dict):\n        return 0\n\n    if not input_dict:\n        return 1\n\n    max_nested_depth = 0\n    for value in input_dict.values():\n        if isinstance(value, dict):\n            max_nested_depth = max(max_nested_depth, dict_depth(value))\n\n    return 1 + max_nested_depth"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(data: list[tuple[str, int]]) -> tuple[str, int]:\n    \"\"\"\n    Calculates the maximum aggregate sum from a list of name-value tuples.\n    Returns (None, 0) if the input list is empty.\n    \"\"\"\n    aggregated_sums = {}\n    for name, value in data:\n        aggregated_sums[name] = aggregated_sums.get(name, 0) + value\n\n    if not aggregated_sums:\n        return (None, 0)\n\n    max_name = None\n    max_value = -float('inf')\n\n    for name, total_value in aggregated_sums.items():\n        if total_value > max_value:\n            max_value = total_value\n            max_name = name\n\n    return (max_name, max_value)"}
{"task_id": "Mbpp/305", "solution": "def start_withp(words_list: list[str]) -> tuple[str, str]:\n    \"\"\"Returns the first two words from a list of strings that start with 'p' or 'P'.\"\"\"\n    found_p_words = []\n    for s in words_list:\n        words_in_string = s.split()\n        for word in words_in_string:\n            if word.lower().startswith('p'):\n                found_p_words.append(word)\n                if len(found_p_words) == 2:\n                    return (found_p_words[0], found_p_words[1])\n    return (found_p_words[0], found_p_words[1]) # This line assumes exactly two words will always be found per the problem statement's guarantee."}
