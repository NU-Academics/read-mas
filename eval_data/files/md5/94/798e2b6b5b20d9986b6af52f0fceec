{"task_id": "Mbpp/419", "solution": "class Number:\n    \"\"\"Holds an original float value and provides a method to round it to the nearest integer (half up).\"\"\"\n    def __init__(self, original_value: float):\n        self._original_value = original_value\n        self.rounded_value: int = 0\n\n    def round_half_up(self) -> int:\n        \"\"\"Rounds the original_value to the nearest integer using 'round half up' rule and sets rounded_value.\"\"\"\n        self.rounded_value = int(round(self._original_value))\n        return self.rounded_value\nclass NumberList:\n    \"\"\"Manages a collection of Number objects and provides methods to access its length and the sum of its rounded numbers.\"\"\"\n    def __init__(self, original_float_list: list[float]):\n        self._numbers: list[Number] = []\n        for original_float in original_float_list:\n            num = Number(original_float)\n            num.round_half_up()\n            self._numbers.append(num)\n\n    def get_length(self) -> int:\n        \"\"\"Returns the count of numbers in the list.\"\"\"\n        return len(self._numbers)\n\n    def get_rounded_sum(self) -> int:\n        \"\"\"Calculates and returns the sum of all rounded_value's from its contained Number objects.\"\"\"\n        return sum(num.rounded_value for num in self._numbers)\nclass CalculationResult:\n    \"\"\"Stores the intermediate and final calculated values.\"\"\"\n    def __init__(self, rounded_sum: int, list_length: int, final_value: int):\n        self.rounded_sum = rounded_sum\n        self.list_length = list_length\n        self.final_value = final_value\ndef round_and_sum(numbers: list[float]) -> int:\n    \"\"\"\n    Orchestrates the entire process of rounding, summing, determining list length, multiplying,\n    and returning the final value.\n    \"\"\"\n    number_list_manager = NumberList(numbers)\n    list_length = number_list_manager.get_length()\n    rounded_sum = number_list_manager.get_rounded_sum()\n    \n    final_value = rounded_sum * list_length\n    \n    # The CalculationResult class is instantiated as per design, but its state is not directly returned.\n    # The final_value is directly returned as specified by the function's return type.\n    _result = CalculationResult(rounded_sum, list_length, final_value) \n    \n    return final_value"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the cubes of the first 'n' even natural numbers.\n    Raises ValueError if n is not a natural number (n < 1).\n    \"\"\"\n    if n < 1:\n        raise ValueError(\"n must be a natural number (n >= 1)\")\n\n    total_sum = 0\n    for i in range(1, n + 1):\n        current_even_number = 2 * i\n        cubed_value = current_even_number ** 3\n        total_sum += cubed_value\n    return total_sum"}
