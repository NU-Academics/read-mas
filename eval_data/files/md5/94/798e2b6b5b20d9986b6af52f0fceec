{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"\n    Checks if the given string represents an integer.\n    \"\"\"\n    # BR2: An empty string does not represent an integer.\n    if not input_string:\n        return False\n\n    start_index = 0\n    # BR1: Optionally preceded by a single '+' or '-' sign.\n    # BR4: If a string starts with a '+' or '-' sign, it must be followed by at least one digit.\n    if input_string[0] == '+' or input_string[0] == '-':\n        start_index = 1\n        # If only a sign is present, it's not an integer (BR4)\n        if len(input_string) == 1:\n            return False\n\n    # BR3: A string containing any non-digit characters (other than an initial sign) does not represent an integer.\n    # Check if all remaining characters are digits.\n    return input_string[start_index:].isdigit()"}
{"task_id": "Mbpp/108", "solution": "def merge_sorted_list(list1: list, list2: list, list3: list) -> list:\n    \"\"\"Merges three lists into a single sorted list.\n\n    Returns a new list containing all elements from the input lists, sorted in ascending order.\n    \"\"\"\n    combined_list = []\n    combined_list.extend(list1)\n    combined_list.extend(list2)\n    combined_list.extend(list3)\n\n    combined_list.sort()\n\n    return combined_list"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_list: list[list[int]]) -> set[int]:\n    \"\"\"\n    Finds elements common to all sub-lists within a given nested list.\n    Returns a set of integers present in every inner list.\n    \"\"\"\n    if not nested_list:\n        return set()\n\n    # Initialize common_set with elements from the first sub-list\n    first_sub_list = nested_list[0]\n    if not first_sub_list:\n        return set()\n\n    common_set = set(first_sub_list)\n\n    # Iterate through the remaining sub-lists and find intersections\n    for sub_list in nested_list[1:]:\n        current_sub_set = set(sub_list)\n        common_set = common_set.intersection(current_sub_set)\n        \n        # Optimization: if common_set becomes empty, no further common elements exist\n        if not common_set:\n            return set()\n\n    return common_set"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"Counts numbers with an odd value when rotating a binary string.\n\n    Args:\n        binary_string: The input binary string.\n        rotations: The number of rotations to perform.\n\n    Returns:\n        The total count of odd decimal integer equivalents.\n    \"\"\"\n\n    def rotate_string(s: str, num_rotations: int) -> str:\n        \"\"\"Rotates a binary string by a given number of positions.\"\"\"\n        length = len(s)\n        if length == 0:\n            return \"\"\n        actual_rotations = num_rotations % length\n        return s[actual_rotations:] + s[:actual_rotations]\n\n    def binary_to_decimal(binary_str: str) -> int:\n        \"\"\"Converts a binary string to its decimal integer equivalent.\"\"\"\n        return int(binary_str, 2)\n\n    def is_odd(number: int) -> bool:\n        \"\"\"Checks if a given integer is an odd number.\"\"\"\n        return number % 2 != 0\n\n    odd_count = 0\n\n    # Loop for the specified number of rotations\n    for i in range(rotations):\n        # Rotate the original binary string 'i' times for the current iteration.\n        rotated_str = rotate_string(binary_string, i)\n\n        decimal_value = binary_to_decimal(rotated_str)\n\n        if is_odd(decimal_value):\n            odd_count += 1\n\n    return odd_count"}
{"task_id": "Mbpp/116", "solution": "def tuple_to_int(input_tuple: tuple) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer by concatenating their string representations.\n    Returns 0 for an empty tuple.\n    \"\"\"\n    if not input_tuple:\n        return 0\n\n    string_elements = []\n    for element in input_tuple:\n        string_elements.append(str(element))\n\n    concatenated_string = \"\".join(string_elements)\n    return int(concatenated_string)"}
