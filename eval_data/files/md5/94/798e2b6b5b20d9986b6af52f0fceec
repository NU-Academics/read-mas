{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(upper_limit: int) -> int:\n    \"\"\"\n    Calculates the sum of all amicable numbers up to a specified upper limit.\n    It identifies amicable pairs by checking the sum of proper divisors.\n    \"\"\"\n    def calculate_sum_of_proper_divisors(n: int) -> int:\n        \"\"\"Calculates the sum of proper divisors for a given positive integer n.\"\"\"\n        if n < 2:\n            return 0\n        s = 1  # 1 is always a proper divisor\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                s += i\n                if i * i != n:\n                    s += n // i\n        return s\n\n    def is_amicable_pair(a: int, b: int) -> bool:\n        \"\"\"Determines if two distinct positive integers form an amicable pair.\"\"\"\n        return a != b and calculate_sum_of_proper_divisors(a) == b and calculate_sum_of_proper_divisors(b) == a\n\n    amicable_numbers = set()\n    for n in range(1, upper_limit + 1):\n        if n in amicable_numbers:\n            continue\n        sum_div_n = calculate_sum_of_proper_divisors(n)\n        if sum_div_n > n and sum_div_n <= upper_limit: # Optimization: check only if potential pair is within range and avoids duplicates by ensuring sum_div_n is larger\n            if is_amicable_pair(n, sum_div_n):\n                amicable_numbers.add(n)\n                amicable_numbers.add(sum_div_n)\n    \n    return sum(amicable_numbers)"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Calculates the maximum difference between the count of '0's and '1's in any substring of the given binary string.\n    Uses Kadane's algorithm by transforming '0's to 1 and '1's to -1 and finding the maximum subarray sum.\n    \"\"\"\n    if not binary_string:\n        return 0\n\n    # Transform the binary string: '0' becomes 1, '1' becomes -1\n    transformed_array = []\n    for char in binary_string:\n        if char == '0':\n            transformed_array.append(1)\n        else:  # char == '1'\n            transformed_array.append(-1)\n\n    # Apply Kadane's algorithm to find the maximum subarray sum\n    max_so_far = transformed_array[0]\n    current_max = transformed_array[0]\n\n    for i in range(1, len(transformed_array)):\n        current_max = max(transformed_array[i], current_max + transformed_array[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(list_of_tuples: list[tuple[int | float, int | float]]) -> int | float:\n    \"\"\"\n    Calculates the maximum absolute product from a list of tuples.\n    Each tuple contains two numbers whose product is considered.\n    \"\"\"\n    def _calculate_tuple_product(t: tuple[int | float, int | float]) -> int | float:\n        return t[0] * t[1]\n\n    def _calculate_absolute_product(product: int | float) -> int | float:\n        return abs(product)\n\n    max_absolute_product = float('-inf')\n\n    for current_tuple in list_of_tuples:\n        product = _calculate_tuple_product(current_tuple)\n        absolute_product = _calculate_absolute_product(product)\n        max_absolute_product = max(max_absolute_product, absolute_product)\n\n    return max_absolute_product"}
{"task_id": "Mbpp/119", "solution": "def search(sortedArray: list) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array.\n    This function assumes the input array is sorted and contains exactly one element that appears only once.\n    \"\"\"\n    n = len(sortedArray)\n    if n == 0:\n        raise ValueError(\"Input array cannot be empty.\")\n    if n == 1:\n        return sortedArray[0]\n\n    low = 0\n    high = n - 1\n\n    while low <= high:\n        mid = (low + high) // 2\n\n        if mid % 2 == 0:  # mid is at an even index\n            if mid + 1 < n and sortedArray[mid] == sortedArray[mid + 1]:\n                # Pair found, unique element is to the right\n                low = mid + 2\n            else:\n                # Pair not found or mid is the last element, unique element is at or to the left\n                high = mid - 1\n        else:  # mid is at an odd index\n            if mid - 1 >= 0 and sortedArray[mid] == sortedArray[mid - 1]:\n                # Pair found, unique element is to the right\n                low = mid + 1\n            else:\n                # Pair not found, unique element is at or to the left\n                high = mid - 1\n\n    return sortedArray[low]"}
