{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(arr: tuple | list) -> int | float:\n    \"\"\"Calculates the maximum absolute difference between any two elements in a given numerical array.\n\n    Args:\n        arr: A collection (e.g., list, tuple) of numerical elements.\n\n    Returns:\n        The maximum absolute difference (int or float), or 0 if the collection has fewer than two elements.\n    \"\"\"\n    if len(arr) < 2:\n        return 0\n    \n    min_element = min(arr)\n    max_element = max(arr)\n    \n    return abs(max_element - min_element)"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(items: list) -> set:\n    \"\"\"\n    Flattens a list of iterable objects into a single set of unique numbers.\n    \"\"\"\n    unique_numbers = set()\n    for iterable_item in items:\n        for number in iterable_item:\n            unique_numbers.add(number)\n    return unique_numbers"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a list of comparable elements in ascending order using the Pancake Sort algorithm.\n    The original input list is not modified.\n    \"\"\"\n    n = len(input_list)\n    if n <= 1:\n        return list(input_list)\n\n    arr = list(input_list)\n\n    for curr_size in range(n, 1, -1):\n        # Find index of the maximum element in arr[0...curr_size-1]\n        max_val = arr[0]\n        max_idx = 0\n        for i in range(1, curr_size):\n            if arr[i] > max_val:\n                max_val = arr[i]\n                max_idx = i\n\n        # Move the maximum element to the beginning of the current sublist if it's not already there\n        if max_idx != curr_size - 1:\n            # Flip from 0 to max_idx to bring max element to front\n            arr[:max_idx+1] = arr[:max_idx+1][::-1]\n\n            # Flip from 0 to curr_size-1 to move max element to its correct sorted position\n            arr[:curr_size] = arr[:curr_size][::-1]\n    return arr"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1: list, list2: list, list3: list) -> int:\n    \"\"\"\n    Counts the number of items that are identical in the same position across three given lists.\n    The comparison iterates up to the length of the shortest list.\n    \"\"\"\n    min_length = min(len(list1), len(list2), len(list3))\n    identical_count = 0\n    for i in range(min_length):\n        if list1[i] == list2[i] and list2[i] == list3[i]:\n            identical_count += 1\n    return identical_count"}
