{"task_id": "Mbpp/638", "solution": "def wind_chill(temperature_celsius: float, velocity_kmh: float) -> int:\n    \"\"\"\n    Calculates the wind chill index using a specific formula and rounds it to the nearest integer.\n    The formula is Twc = 13.12 + 0.6215Ta - 11.37V^0.16 + 0.3965TaV^0.16.\n    \"\"\"\n    Ta = temperature_celsius\n    V = velocity_kmh\n\n    # Calculate the wind chill index using the given formula.\n    # V^0.16 can be computed using the ** operator for exponentiation.\n    Twc = 13.12 + (0.6215 * Ta) - (11.37 * (V ** 0.16)) + (0.3965 * Ta * (V ** 0.16))\n\n    # Round the result to the nearest integer.\n    return round(Twc)"}
{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"\n    Checks if 'z' is present in the string, excluding the first and last characters.\n    Handles strings of any length.\n    \"\"\"\n    length = len(input_string)\n\n    if length <= 2:\n        return False\n\n    # Iterate from the second character (index 1) up to the second to last character (index length - 2)\n    for i in range(1, length - 1):\n        if input_string[i] == 'z':\n            return True\n\n    return False"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(arr: list, k: int) -> list:\n    \"\"\"\n    Reverses the order of the first 'k' elements of the input array in-place.\n    The function handles edge cases for 'k' to ensure valid slicing and reversal.\n    \"\"\"\n    if k <= 0:\n        return arr\n    if k >= len(arr):\n        k = len(arr)\n\n    arr[:k] = arr[:k][::-1]\n\n    return arr"}
{"task_id": "Mbpp/639", "solution": "class Name:\n    \"\"\"Encapsulates a single name string and provides methods to check its case and length.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def get_length(self) -> int:\n        \"\"\"Returns the length of the name string.\"\"\"\n        return len(self._value)\n\n    def starts_with_uppercase(self) -> bool:\n        \"\"\"Checks if the name string starts with an uppercase letter.\"\"\"\n        return bool(self._value) and self._value[0].isupper()\nclass NameList:\n    \"\"\"Manages a collection of Name objects, filters them, and calculates the sum of their lengths.\"\"\"\n    def __init__(self, raw_names: list[str]):\n        self._names = [Name(name) for name in raw_names]\n\n    def get_valid_names_sum_length(self) -> int:\n        \"\"\"Iterates, filters, calculates lengths, and sums them for valid names.\"\"\"\n        total_sum = 0\n        for name_obj in self._names:\n            if name_obj.starts_with_uppercase():\n                total_sum += name_obj.get_length()\n        return total_sum\ndef sample_nam(names_list: list[str]) -> int:\n    \"\"\"\n    Calculates the sum of lengths of names starting with an uppercase letter from the input list.\n    Removes names that start with a lowercase letter before summing.\n    \"\"\"\n    name_list_obj = NameList(names_list)\n    return name_list_obj.get_valid_names_sum_length()"}
{"task_id": "Mbpp/731", "solution": "import math\ndef lateralsurface_cone(r,h):\n    # Calculate the slant height of the cone\n    slant_height = math.sqrt(r**2 + h**2)\n    # Calculate the lateral surface area using the formula pi * r * slant_height\n    lateral_surface_area = math.pi * r * slant_height\n    return lateral_surface_area"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(input_string: str) -> str:\n    \"\"\"Replaces all occurrences of spaces, commas, or dots with a colon in the input string.\n    This function processes the input string according to the predefined target characters and replacement character.\n    \"\"\"\n    TARGET_CHARS = [' ', ',', '.']\n    REPLACEMENT_CHAR = ':'\n\n    transformed_string = input_string\n    for char_to_replace in TARGET_CHARS:\n        transformed_string = transformed_string.replace(char_to_replace, REPLACEMENT_CHAR)\n\n    return transformed_string"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(sorted_array: list[int], target_number: int) -> int:\n    \"\"\"Finds the index of the first occurrence of a given number in a sorted array.\n    Uses a binary search approach to efficiently locate the first matching element.\n    \"\"\"\n    low = 0\n    high = len(sorted_array) - 1\n    result_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if sorted_array[mid] == target_number:\n            result_index = mid  # Store this potential first occurrence\n            high = mid - 1      # Try to find an even earlier occurrence in the left half\n        elif sorted_array[mid] < target_number:\n            low = mid + 1\n        else:  # sorted_array[mid] > target_number\n            high = mid - 1\n            \n    return result_index"}
{"task_id": "Mbpp/739", "solution": "def find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    This function iteratively checks triangular numbers until one with n digits is found.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    def _calculate_triangular_number(k: int) -> int:\n        \"\"\"Calculates the k-th triangular number.\"\"\"\n        return k * (k + 1) // 2\n\n    def _has_n_digits(number: int, n: int) -> bool:\n        \"\"\"Checks if a number has exactly n digits.\"\"\"\n        return 10**(n - 1) <= number < 10**n\n\n    k = 1\n    while True:\n        triangular_number = _calculate_triangular_number(k)\n        if _has_n_digits(triangular_number, n):\n            return k\n        k += 1"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list: list) -> (int | float):\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists of a given list.\n    \"\"\"\n    total_sum_of_products = 0\n    n = len(input_list)\n\n    for i in range(n):\n        current_product = 1  # Initialize product for the current starting point\n        for j in range(i, n):\n            # The sublist is input_list[i : j + 1]\n            # Instead of slicing and then iterating, we can update the product iteratively.\n            current_product *= input_list[j]\n            total_sum_of_products += current_product\n\n    return total_sum_of_products"}
{"task_id": "Mbpp/737", "solution": "import re\ndef check_str(input_string):\n    \"\"\"\n    Checks if the given string starts with a vowel (a, e, i, o, u), case-insensitively, using regex.\n    \"\"\"\n    vowel_pattern = re.compile(r'^[aeiou]', re.IGNORECASE)\n    return bool(vowel_pattern.match(input_string))"}
{"task_id": "Mbpp/736", "solution": "from typing import List, Union\ndef left_insertion(arr: List[Union[int, float]], value: Union[int, float]) -> int:\n    \"\"\"\n    Determines the 0-based leftmost index `i` in `arr` where `value` can be inserted such that\n    `arr[j] < value` for `j < i` and `arr[k] >= value` for `k >= i`.\n    \"\"\"\n    low = 0\n    high = len(arr)\n    # 'result' stores the potential insertion point, initialized to the end of the array.\n    result = high\n\n    while low < high:\n        mid = (low + high) // 2\n        if arr[mid] >= value:\n            # If arr[mid] is greater than or equal to 'value',\n            # then 'mid' is a potential insertion point, or the point is further left.\n            result = mid\n            high = mid\n        else:\n            # If arr[mid] is less than 'value',\n            # the insertion point must be to the right of 'mid'.\n            low = mid + 1\n    return result"}
{"task_id": "Mbpp/735", "solution": "def _get_binary_length(number: int) -> int:\n    \"\"\"Calculates the number of bits required to represent the given non-negative integer.\"\"\"\n    if number == 0:\n        return 1\n    return number.bit_length()\ndef _get_msb_position(number: int) -> int:\n    \"\"\"Determines the 0-indexed position of the Most Significant Bit (MSB).\"\"\"\n    if number == 0:\n        return 0\n    return number.bit_length() - 1\ndef _get_lsb_position(number: int) -> int:\n    \"\"\"Determines the 0-indexed position of the Least Significant Bit (LSB).\"\"\"\n    if number == 0:\n        return 0\n    return (number & -number).bit_length() - 1\ndef _toggle_bits_in_range(number: int, start_pos: int, end_pos: int) -> int:\n    \"\"\"Toggles bits within a specified 0-indexed range (inclusive) of a number.\"\"\"\n    if start_pos > end_pos:\n        return number\n\n    num_bits_to_toggle = end_pos - start_pos + 1\n    mask = ((1 << num_bits_to_toggle) - 1) << start_pos\n    \n    return number ^ mask\ndef toggle_middle_bits(number: int) -> int:\n    \"\"\"Toggles bits of the number except the first and the last bit.\"\"\"\n    if number == 0:\n        return 0\n\n    binary_length = _get_binary_length(number)\n    \n    # If there are less than 3 bits, no middle bits exist to toggle.\n    if binary_length < 3:\n        return number\n\n    msb_pos = _get_msb_position(number)\n    lsb_pos = _get_lsb_position(number)\n\n    # Bits to toggle are exclusively between the LSB and MSB.\n    start_toggle_pos = lsb_pos + 1\n    end_toggle_pos = msb_pos - 1\n\n    # If the calculated range is invalid (no middle bits), return the original number.\n    if start_toggle_pos > end_toggle_pos:\n        return number\n\n    return _toggle_bits_in_range(number, start_toggle_pos, end_toggle_pos)"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(input_string: str) -> bool:\n    \"\"\"Checks if all characters in the given string are identical.\"\"\"\n    if len(input_string) <= 1:\n        return True\n    \n    first_char = input_string[0]\n    for char in input_string[1:]:\n        if char != first_char:\n            return False\n            \n    return True"}
