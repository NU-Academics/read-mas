{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number using an iterative approach.\n    J(n) = J(n-1) + 2 * J(n-2) with J(0)=0 and J(1)=1.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    j_n_minus_2 = 0  # Represents J(0)\n    j_n_minus_1 = 1  # Represents J(1)\n\n    for _ in range(2, n + 1):\n        current_j = j_n_minus_1 + 2 * j_n_minus_2\n        j_n_minus_2 = j_n_minus_1\n        j_n_minus_1 = current_j\n\n    return j_n_minus_1"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1: list, l2: list, l3: list) -> list:\n    \"\"\"\n    Finds elements that appear at the same index in all three input lists.\n    Returns a new list containing these common elements.\n    \"\"\"\n    common_elements_list = []\n    min_length = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_length):\n        if l1[i] == l2[i] and l2[i] == l3[i]:\n            common_elements_list.append(l1[i])\n            \n    return common_elements_list"}
{"task_id": "Mbpp/759", "solution": "def is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Checks if a given string represents a decimal number with a precision of exactly 2 decimal places.\n    \"\"\"\n    import re\n    if not isinstance(input_string, str):\n        return False\n    if not input_string:\n        return False\n\n    pattern = r\"^[+-]?\\d+\\.\\d{2}$\"\n    return bool(re.fullmatch(pattern, input_string))"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"\n    Counts the number of unique reverse string pairs in the given list.\n    A canonical representation ensures each distinct pair is counted only once.\n    \"\"\"\n    def _reverse_string(s: str) -> str:\n        \"\"\"\n        Reverses the input string.\n        This uses Python's slicing feature for efficient reversal.\n        \"\"\"\n        return s[::-1]\n\n    unique_pairs_set = set()\n    unique_input_strings = set(string_list)\n\n    for s in unique_input_strings:\n        reversed_s = _reverse_string(s)\n\n        # Check if the reversed string exists and is different from the original string\n        # to form a pair. Palindromes (s == reversed_s) do not form a 'pair' with another string.\n        if reversed_s in unique_input_strings and s != reversed_s:\n            # Add a canonical representation of the pair to ensure uniqueness,\n            # e.g., always store (smaller_string, larger_string) lexicographically.\n            if s < reversed_s:\n                unique_pairs_set.add((s, reversed_s))\n            else:\n                unique_pairs_set.add((reversed_s, s))\n\n    return len(unique_pairs_set)"}
