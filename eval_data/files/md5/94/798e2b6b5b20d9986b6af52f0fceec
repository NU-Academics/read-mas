{"task_id": "Mbpp/631", "solution": "def replace_spaces(input_string: str) -> str:\n    \"\"\"Replaces space characters with underscores and vice versa in a string.\"\"\"\n    # A unique placeholder is used to manage bidirectional replacement without conflicts.\n    TEMP_PLACEHOLDER = '\\u0001'\n\n    # First, replace all original spaces with the temporary placeholder.\n    working_string = input_string.replace(' ', TEMP_PLACEHOLDER)\n\n    # Next, replace all original underscores with spaces.\n    working_string = working_string.replace('_', ' ')\n\n    # Finally, replace the temporary placeholders with underscores.\n    modified_string = working_string.replace(TEMP_PLACEHOLDER, '_')\n\n    return modified_string"}
