{"task_id": "Mbpp/160", "solution": "def find_solution(a, b, n):\n    \"\"\"\n    Computes a particular integer solution (x, y) for the linear Diophantine equation ax + by = n.\n    Returns (x, y) as a tuple if a solution exists, otherwise returns None.\n    \"\"\"\n    def extended_gcd(num1, num2):\n        \"\"\"\n        Implements the Extended Euclidean Algorithm to find g = gcd(num1, num2)\n        and integers x, y such that num1*x + num2*y = g. Returns (g, x, y).\n        \"\"\"\n        if num2 == 0:\n            return num1, 1, 0\n        else:\n            g, x1, y1 = extended_gcd(num2, num1 % num2)\n            x = y1\n            y = x1 - (num1 // num2) * y1\n            return g, x, y\n\n    # Calculate g = gcd(a, b) and Bezout coefficients x_g, y_g such that a*x_g + b*y_g = g\n    g, x_g, y_g = extended_gcd(a, b)\n\n    # Special handling for the case where a and b are both zero\n    if g == 0:\n        if n == 0:\n            # If 0x + 0y = 0, any integers x, y are solutions. Return (0, 0) as a simple one.\n            return (0, 0)\n        else:\n            # If 0x + 0y = n (where n != 0), no solution exists.\n            return None\n\n    # If n is not divisible by g, no integer solution exists for ax + by = n\n    if n % g != 0:\n        return None\n\n    # Calculate the scaling factor k\n    k = n // g\n\n    # A particular solution (x, y) can be found by scaling the Bezout coefficients\n    x = x_g * k\n    y = y_g * k\n\n    return (x, y)"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string where their 1-based string index matches their 1-based alphabetical position (case-insensitive).\n    \"\"\"\n    def _get_alphabet_position(char_code: int) -> int:\n        \"\"\"\n        Calculates the 1-based alphabetical position for a given lowercase character's ordinal value.\n        \"\"\"\n        # ord('a') is 97, so 'a' is 1st position\n        return char_code - ord('a') + 1\n\n    count = 0\n    for i, char in enumerate(input_string):\n        string_position = i + 1  # 1-based index\n        \n        if 'a' <= char.lower() <= 'z':\n            alphabet_position = _get_alphabet_position(ord(char.lower()))\n            if string_position == alphabet_position:\n                count += 1\n    return count"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"Finds the smallest power of 2 greater than or equal to n.\"\"\"\n    if n == 0:\n        return 1\n    # For positive n, calculate 2 raised to the power of the number of bits needed for n-1.\n    return 1 << (n - 1).bit_length()"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers: list[int]) -> int:\n    \"\"\"Counts pairs of integers in a list that XOR to an even number.\n    Pairs (a, b) XOR to an even number if 'a' and 'b' have the same parity.\n    \"\"\"\n    def _is_even(number: int) -> bool:\n        \"\"\"Determines if an integer is even.\"\"\"\n        return number % 2 == 0\n\n    if len(numbers) < 2:\n        return 0\n\n    count_even = 0\n    count_odd = 0\n\n    for number in numbers:\n        if _is_even(number):\n            count_even += 1\n        else:\n            count_odd += 1\n\n    even_pairs = (count_even * (count_even - 1)) // 2\n    odd_pairs = (count_odd * (count_odd - 1)) // 2\n\n    return even_pairs + odd_pairs"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Calculates the sum of the series (n - 2*i) from i=0 to n // 2.\n\n    The series includes terms like n, n-2, n-4, and so on, until the term becomes 0 or less.\n    \"\"\"\n    total_sum = 0\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        total_sum += term\n    return total_sum"}
