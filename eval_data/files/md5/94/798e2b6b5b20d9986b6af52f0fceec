{"task_id": "Mbpp/61", "solution": "def count_Substrings(input_string: str) -> int:\n    \"\"\"\n    Counts the number of substrings in an input string where the sum of digits equals the substring's length.\n    \"\"\"\n    def _calculate_sum_of_digits(s: str) -> int:\n        \"\"\"Calculates the sum of integer values of characters in a given digit string.\"\"\"\n        total_sum = 0\n        for char_digit in s:\n            total_sum += int(char_digit)\n        return total_sum\n\n    count = 0\n    n = len(input_string)\n\n    for i in range(n):\n        for j in range(i + 1, n + 1):\n            substring_value = input_string[i:j]\n            substring_length = len(substring_value)\n            sum_of_digits = _calculate_sum_of_digits(substring_value)\n\n            if sum_of_digits == substring_length:\n                count += 1\n    return count"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sublist: list) -> bool:\n    \"\"\"\n    Checks if 'sublist' is present contiguously and in the same order within 'main_list'.\n    \"\"\"\n    if not sublist:\n        return True\n    if not main_list or len(sublist) > len(main_list):\n        return False\n\n    for i in range(len(main_list) - len(sublist) + 1):\n        if main_list[i:i+len(sublist)] == sublist:\n            return True\n\n    return False"}
