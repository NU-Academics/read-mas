{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic (either non-decreasing or non-increasing).\n    Handles edge cases for empty or single-element arrays by returning True.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    def _is_non_decreasing(arr: list) -> bool:\n        \"\"\"Checks if the array is non-decreasing.\"\"\"\n        for i in range(1, len(arr)):\n            if arr[i] < arr[i - 1]:\n                return False\n        return True\n\n    def _is_non_increasing(arr: list) -> bool:\n        \"\"\"Checks if the array is non-increasing.\"\"\"\n        for i in range(1, len(arr)):\n            if arr[i] > arr[i - 1]:\n                return False\n        return True\n\n    return _is_non_decreasing(array) or _is_non_increasing(array)"}
{"task_id": "Mbpp/67", "solution": "_bell_cache = {}\n_combinations_cache = {}\ndef combinations(n, k):\n    \"\"\"\n    Calculates the binomial coefficient C(n, k).\n    Utilizes memoization to store previously computed values.\n    \"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n\n    if (n, k) in _combinations_cache:\n        return _combinations_cache[(n, k)]\n\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    \n    _combinations_cache[(n, k)] = res\n    return res\ndef bell_number(n):\n    \"\"\"\n    Calculates the nth Bell number using a recursive formula with memoization.\n    This function finds the number of ways to partition a set of 'n' distinct elements.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Bell number is not defined for negative inputs\")\n    if n == 0 or n == 1:\n        return 1\n\n    if n in _bell_cache:\n        return _bell_cache[n]\n\n    total_sum = 0\n    # B_{n+1} = sum(k=0 to n) C(n, k) * B_k\n    # We are calculating B_n, so the formula is B_n = sum(k=0 to n-1) C(n-1, k) * B_k\n    for k in range(n):\n        term = combinations(n - 1, k) * bell_number(k)\n        total_sum += term\n    \n    _bell_cache[n] = total_sum\n    return total_sum"}
{"task_id": "Mbpp/70", "solution": "def get_equal(tuples_collection: list[tuple]) -> bool:\n    \"\"\"\n    Checks if all tuples in the given collection have equal length.\n    Returns True if all tuples have equal length (including empty or single-tuple collections), False otherwise.\n    \"\"\"\n    if not tuples_collection or len(tuples_collection) == 1:\n        return True\n\n    first_tuple_length = len(tuples_collection[0])\n    for tpl in tuples_collection[1:]:\n        if len(tpl) != first_tuple_length:\n            return False\n    return True"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(items_list: list, pattern_list: list) -> bool:\n    \"\"\"\n    Checks if a sequence of items adheres to a given pattern list's sequence mapping.\n    It verifies a consistent one-to-one mapping between elements of both lists.\n    \"\"\"\n    if len(items_list) != len(pattern_list):\n        return False\n\n    item_to_pattern_map = {}\n    pattern_to_item_map = {}\n\n    for i in range(len(items_list)):\n        current_item = items_list[i]\n        current_pattern = pattern_list[i]\n\n        # Check item_to_pattern_map consistency\n        if current_item in item_to_pattern_map:\n            if item_to_pattern_map[current_item] != current_pattern:\n                return False\n        else:\n            item_to_pattern_map[current_item] = current_pattern\n\n        # Check pattern_to_item_map consistency\n        if current_pattern in pattern_to_item_map:\n            if pattern_to_item_map[current_pattern] != current_item:\n                return False\n        else:\n            pattern_to_item_map[current_pattern] = current_item\n\n    return True"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(list_of_elements: list) -> list:\n    \"\"\"Sorts a list of numerical elements in ascending order using the Comb Sort algorithm.\"\"\"\n    arr = list_of_elements[:]  # Create a mutable copy to avoid modifying the original list.\n    n = len(arr)\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        # Update the gap value\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n        # Perform a modified bubble sort pass for the current gap\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
