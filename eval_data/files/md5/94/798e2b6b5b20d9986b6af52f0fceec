{"task_id": "Mbpp/3", "solution": "import math\ndef is_not_prime(n: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a non-prime number.\n    Returns True if n is non-prime, False otherwise.\n    \"\"\"\n    if n <= 1:\n        return True  # Numbers less than or equal to 1 are considered non-prime.\n\n    # Check for divisors from 2 up to the square root of n.\n    for i in range(2, math.isqrt(n) + 1):\n        if n % i == 0:\n            return True  # Found a divisor, so n is non-prime.\n\n    return False # No divisors found, so n is prime."}
{"task_id": "Mbpp/2", "solution": "def similar_elements(list1: 'Iterable[Any]', list2: 'Iterable[Any]') -> 'Set[Any]':\n    \"\"\"\n    Finds elements common to both list1 and list2.\n    Converts inputs to sets for efficient intersection and to handle duplicates.\n    \"\"\"\n    set1 = set(list1)\n    set2 = set(list2)\n    return set1.intersection(set2)"}
{"task_id": "Mbpp/8", "solution": "def square_nums(input_list: list) -> list:\n    \"\"\"\n    Calculates the square of each element in a list of numbers.\n    Returns a new list containing the square of each corresponding element.\n    \"\"\"\n    return [element * element for element in input_list]"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if the binary representations of two integers differ at exactly one bit position.\n\n    Args:\n        num1 (int): The first integer.\n        num2 (int): The second integer.\n\n    Returns:\n        bool: True if the binary representations differ at exactly one bit position,\n              False otherwise.\n    \"\"\"\n    xor_result = num1 ^ num2\n    set_bits_count = 0\n    while xor_result > 0:\n        xor_result &= (xor_result - 1)\n        set_bits_count += 1\n    return set_bits_count == 1"}
{"task_id": "Mbpp/4", "solution": "import heapq\ndef heap_queue_largest(numbers: list[int], n: int) -> list[int]:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers,\n    returned in descending order using a min-heap.\n    \"\"\"\n    if not numbers or n <= 0:\n        return []\n\n    min_heap = []\n    for num in numbers:\n        if len(min_heap) < n:\n            heapq.heappush(min_heap, num)\n        elif num > min_heap[0]:\n            heapq.heapreplace(min_heap, num)\n\n    result = sorted(min_heap, reverse=True)\n    return result"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, char_to_remove: str) -> str:\n    first_occurrence_index = input_string.find(char_to_remove)\n    last_occurrence_index = input_string.rfind(char_to_remove)\n\n    if first_occurrence_index == -1:\n        return input_string\n\n    if first_occurrence_index == last_occurrence_index:\n        return input_string[:first_occurrence_index] + input_string[first_occurrence_index + 1:]\n\n    return (\n        input_string[:first_occurrence_index] +\n        input_string[first_occurrence_index + 1:last_occurrence_index] +\n        input_string[last_occurrence_index + 1:]\n    )"}
{"task_id": "Mbpp/7", "solution": "def find_char_long(input_string: str) -> set[str]:\n    \"\"\"\n    Finds all words in a string that are at least 4 characters long.\n    Splits the string by whitespace and filters words based on length.\n    \"\"\"\n    long_words = set()\n    words = input_string.split()\n    for word in words:\n        if len(word) >= 4:\n            long_words.add(word)\n    return long_words"}
{"task_id": "Mbpp/9", "solution": "def _rotate_string(s: str) -> str:\n    \"\"\"\n    Performs a single cyclic rotation on the input string.\n    Shifts the first character to the end.\n    \"\"\"\n    if not s:\n        return \"\"\n    return s[1:] + s[0]\ndef find_Rotations(input_string: str) -> int:\n    \"\"\"\n    Calculates the minimum positive number of rotations (greater than 0) required\n    for a string to return to its original form.\n    \"\"\"\n    if not input_string:\n        return 0\n\n    original_string = input_string\n    current_string = input_string\n    rotations_count = 0\n\n    for _ in range(len(input_string)):\n        current_string = _rotate_string(current_string)\n        rotations_count += 1\n        if current_string == original_string:\n            return rotations_count\n            \n    return len(input_string)"}
