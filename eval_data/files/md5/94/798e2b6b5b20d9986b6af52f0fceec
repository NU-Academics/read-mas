{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple: tuple) -> dict:\n    \"\"\"\n    Converts a tuple to a key-value dictionary using adjacent elements.\n    Raises ValueError if the input tuple has an odd number of elements.\n    \"\"\"\n    if len(input_tuple) % 2 != 0:\n        raise ValueError(\"Input tuple must have an even number of elements to form complete key-value pairs.\")\n\n    result_dict = {}\n    for i in range(0, len(input_tuple), 2):\n        key = input_tuple[i]\n        value = input_tuple[i+1]\n        result_dict[key] = value\n    return result_dict"}
{"task_id": "Mbpp/743", "solution": "def rotate_right(input_list: list, rotation_count: int) -> list:\n    \"\"\"\n    Rotates a list to the right by the specified number of items.\n    \"\"\"\n    if not input_list:\n        return []\n\n    n = len(input_list)\n    effective_rotation_count = rotation_count % n\n\n    if effective_rotation_count == 0:\n        return list(input_list)\n\n    # Slice the list and concatenate to achieve rotation.\n    rotated_part = input_list[n - effective_rotation_count:]\n    remaining_part = input_list[:n - effective_rotation_count]\n\n    return rotated_part + remaining_part"}
{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    \"\"\"\n\n    def _extract_digits(n: int) -> list[int]:\n        \"\"\"\n        Extracts individual digits from an integer.\n        \"\"\"\n        if n == 0:\n            return [0]\n        digits = []\n        temp_n = abs(n)\n        while temp_n > 0:\n            digits.append(temp_n % 10)\n            temp_n //= 10\n        return digits[::-1] # Reverse to get digits in order\n\n    def _is_divisible_by_all_digits(n: int, digits: list[int]) -> bool:\n        \"\"\"\n        Checks if a given number is divisible by all its non-zero digits.\n        \"\"\"\n        for digit in digits:\n            if digit == 0:\n                continue\n            if n % digit != 0:\n                return False\n        return True\n\n    result_list = []\n    for num in range(startnum, endnum + 1):\n        digits_list = _extract_digits(num)\n        if _is_divisible_by_all_digits(num, digits_list):\n            result_list.append(num)\n    return result_list"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Inserts spaces into a string before words starting with capital letters\n    according to specific rules.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    result = [input_string[0]]\n\n    for i in range(1, len(input_string)):\n        current_char = input_string[i]\n        prev_char = input_string[i - 1]\n\n        # FR3: Insert space if current is uppercase and preceding is lowercase\n        if current_char.isupper() and prev_char.islower():\n            result.append(' ')\n        # FR4: Insert space if current is uppercase, preceding is uppercase, and following is lowercase\n        elif current_char.isupper() and prev_char.isupper():\n            if i + 1 < len(input_string) and input_string[i + 1].islower():\n                result.append(' ')\n        \n        result.append(current_char)\n\n    return \"\".join(result)"}
