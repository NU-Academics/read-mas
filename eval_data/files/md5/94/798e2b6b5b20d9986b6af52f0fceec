{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix: list[list[int | float]], n: int) -> int | float:\n    \"\"\"Calculates the maximum value in the Nth column of a matrix. It validates inputs and elements, raising errors for invalid data.\"\"\"\n    if not matrix:\n        raise ValueError(\"Input matrix cannot be empty.\")\n\n    if not matrix[0]:\n        raise IndexError(\"Matrix rows cannot be empty for column access.\")\n\n    num_cols = len(matrix[0])\n\n    if not (0 <= n < num_cols):\n        if n < 0:\n            raise IndexError(f\"Column index 'n' ({n}) cannot be negative.\")\n        else:\n            raise IndexError(f\"Column index 'n' ({n}) is out of bounds for a matrix with {num_cols} columns.\")\n\n    max_val = None\n\n    for row_idx, row in enumerate(matrix):\n        if n >= len(row):\n            raise IndexError(f\"Row {row_idx} is too short to contain column {n}. Matrix is jagged or column index is invalid.\")\n\n        element = row[n]\n        if not isinstance(element, (int, float)):\n            raise TypeError(f\"Element at row {row_idx}, column {n} is not a number (found type {type(element).__name__}).\")\n\n        if max_val is None or element > max_val:\n            max_val = element\n\n    if max_val is None:\n        raise ValueError(\"Could not find any numerical elements in the specified column.\")\n\n    return max_val"}
{"task_id": "Mbpp/612", "solution": "def merge(input_list: list) -> list:\n    \"\"\"\n    Transforms a list of two-element sublists into a list of two separate lists.\n    The first output list contains the first element of each sublist, and the second contains the second.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n\n    for sublist in input_list:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"\n    Moves all numeric characters to the end of the given string, preserving the relative order of both character types.\n    \"\"\"\n    non_numeric_chars = []\n    numeric_chars = []\n\n    for char in input_string:\n        if char.isdigit():\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n\n    return \"\".join(non_numeric_chars) + \"\".join(numeric_chars)"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple[int | float, ...], tuple2: tuple[int | float, ...]) -> tuple[int | float, ...]:\n    \"\"\"\n    Performs element-wise modulo operation on two tuples of the same length.\n    Raises ValueError if input tuples are not of the same length.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must be of the same length.\")\n\n    result = tuple(t1 % t2 for t1, t2 in zip(tuple1, tuple2))\n    return result"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(input_data: tuple[tuple[int | float, ...], ...]) -> list[float]:\n    \"\"\"\n    Calculates the average value for each inner tuple in a tuple of tuples.\n    Returns a list of floating-point numbers, each representing an inner tuple's average.\n    \"\"\"\n    averages = []\n    for inner_tuple in input_data:\n        # No error handling for empty inner tuples or non-numerical values as per instructions.\n        current_sum = sum(inner_tuple)\n        count = len(inner_tuple)\n        average = current_sum / count\n        averages.append(average)\n    return averages"}
{"task_id": "Mbpp/618", "solution": "def div_list(list1: list, list2: list) -> list:\n    \"\"\"Divides elements of list1 by corresponding elements of list2, handling errors.\n    Returns a new list of floats with the results.\"\"\"\n    if len(list1) != len(list2):\n        raise ValueError(\"Lists must have the same length\")\n\n    results = []\n    for i in range(len(list1)):\n        num1 = list1[i]\n        num2 = list2[i]\n\n        if not isinstance(num1, (int, float)) or not isinstance(num2, (int, float)):\n            raise TypeError(\"List elements must be numeric\")\n\n        if num2 == 0:\n            raise ZeroDivisionError(\"Division by zero encountered\")\n\n        results.append(float(num1) / num2)\n    return results"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the size of the largest subset of numbers where every pair in the subset is mutually divisible.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    # Sort the numbers to ensure that if a divides b, a comes before b.\n    sorted_numbers = sorted(numbers)\n    n = len(sorted_numbers)\n    \n    # dp[i] will store the size of the largest divisible subset ending with sorted_numbers[i].\n    # Each number itself forms a divisible subset of size 1.\n    dp = [1] * n\n\n    # Iterate through each number to build up the DP table.\n    for i in range(n):\n        # For each number, check previous numbers to find potential divisors.\n        for j in range(i):\n            # If sorted_numbers[i] is divisible by sorted_numbers[j],\n            # then sorted_numbers[i] can extend the subset ending at sorted_numbers[j].\n            if sorted_numbers[i] % sorted_numbers[j] == 0:\n                dp[i] = max(dp[i], 1 + dp[j])\n\n    # The maximum value in the dp array is the size of the largest divisible subset found.\n    return max(dp)"}
