{"task_id": "Mbpp/765", "solution": "def find_nth_polite_number(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number.\n    A polite number is a positive integer that is not a power of 2.\n    \"\"\"\n    def _is_power_of_two(num: int) -> bool:\n        \"\"\"Checks if a number is a power of two.\"\"\"\n        return num > 0 and (num & (num - 1) == 0)\n\n    count = 0\n    num = 1\n    while True:\n        if not _is_power_of_two(num):\n            count += 1\n            if count == n:\n                return num\n        num += 1"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(array, size):\n    \"\"\"\n    Finds the minimum absolute difference between any two elements in an array.\n    The function sorts the array and then compares adjacent elements.\n    \"\"\"\n    n = len(array)\n    if n < 2:\n        raise ValueError(\"Input array must contain at least two elements.\")\n\n    sorted_array = sorted(array)\n    min_diff = float('inf')\n\n    for i in range(n - 1):\n        current_diff = abs(sorted_array[i + 1] - sorted_array[i])\n        if current_diff < min_diff:\n            min_diff = current_diff\n            \n    return min_diff"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list: list) -> list[tuple]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in a given list.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n\n    result_pairs = []\n\n    for i in range(len(input_list) - 1):\n        pair = (input_list[i], input_list[i+1])\n        result_pairs.append(pair)\n\n    return result_pairs"}
