{"task_id": "Mbpp/603", "solution": "def _is_prime(n: int) -> bool:\n    \"\"\"Checks if a number 'n' is prime.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\ndef get_ludic(limit: int) -> list[int]:\n    \"\"\"Generates a list of 1 and all prime numbers up to 'limit'.\"\"\"\n    result = [1]\n    for num in range(2, limit + 1):\n        if _is_prime(num):\n            result.append(num)\n    return result"}
{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix_data: List[List[int]]) -> float:\n    \"\"\"\n    Finds the path with the maximum average cost in a square matrix.\n    A path starts from top-left, moves only right or down, and ends at bottom-right.\n    \"\"\"\n    from typing import List\n\n    class Cell:\n        \"\"\"Represents a cell in the matrix with its coordinates and cost.\"\"\"\n        def __init__(self, row: int, col: int, cost: int) -> None:\n            self.row = row\n            self.col = col\n            self.cost = cost\n\n    class Path:\n        \"\"\"Represents a path as a sequence of cells, with calculated metrics.\"\"\"\n        def __init__(self, sequence_of_cells: List['Cell']) -> None:\n            self.sequenceOfCells: List['Cell'] = sequence_of_cells\n            self.totalCost: float = 0.0\n            self.numCells: int = len(sequence_of_cells)\n            self.averageCost: float = 0.0\n\n    class Matrix:\n        \"\"\"Represents the input square matrix, composed of Cell objects.\"\"\"\n        def __init__(self, matrix_data: List[List[int]]) -> None:\n            self.N = len(matrix_data)\n            self.cells: List[List['Cell']] = []\n            for r in range(self.N):\n                row_cells = []\n                for c in range(self.N):\n                    row_cells.append(Cell(r, c, matrix_data[r][c]))\n                self.cells.append(row_cells)\n\n        def get_cell(self, row: int, col: int) -> 'Cell':\n            return self.cells[row][col]\n\n    def _calculate_path_metrics(path: Path) -> None:\n        \"\"\"Calculates total cost, number of cells, and average cost for a given path.\"\"\"\n        path.totalCost = sum(cell.cost for cell in path.sequenceOfCells)\n        path.numCells = len(path.sequenceOfCells)\n        if path.numCells > 0:\n            path.averageCost = path.totalCost / path.numCells\n        else:\n            path.averageCost = 0.0\n\n    def _find_all_paths_dfs(\n        matrix: Matrix,\n        current_row: int,\n        current_col: int,\n        current_path_cells: List[Cell],\n        all_paths: List[Path]\n    ) -> None:\n        \"\"\"Recursively finds all valid paths from (current_row, current_col) to (N-1, N-1) using DFS.\"\"\"\n        current_path_cells.append(matrix.get_cell(current_row, current_col))\n\n        if current_row == matrix.N - 1 and current_col == matrix.N - 1:\n            new_path = Path(list(current_path_cells))\n            _calculate_path_metrics(new_path)\n            all_paths.append(new_path)\n        else:\n            if current_col + 1 < matrix.N:\n                _find_all_paths_dfs(matrix, current_row, current_col + 1, current_path_cells, all_paths)\n            if current_row + 1 < matrix.N:\n                _find_all_paths_dfs(matrix, current_row + 1, current_col, current_path_cells, all_paths)\n\n        current_path_cells.pop()\n\n    matrix = Matrix(matrix_data)\n    all_paths: List[Path] = []\n    current_path_cells: List[Cell] = []\n\n    _find_all_paths_dfs(matrix, 0, 0, current_path_cells, all_paths)\n\n    if not all_paths:\n        return 0.0\n\n    max_average = max(path.averageCost for path in all_paths)\n\n    return max_average"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base, power):\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    This uses an internal Number class to manage the large integer arithmetic and digit extraction.\n    \"\"\"\n    class Number:\n        \"\"\"\n        Encapsulates an integer value and provides methods for exponentiation,\n        digit extraction, and digit summation.\n        \"\"\"\n        def __init__(self, initial_value: int):\n            self._value = initial_value\n\n        def raise_to_power(self, power: int) -> 'Number':\n            self._value = self._value ** power\n            return self\n\n        def get_digits(self) -> list[int]:\n            return [int(digit) for digit in str(self._value)]\n\n        def sum_digits(self) -> int:\n            return sum(self.get_digits())\n\n    number_obj = Number(base)\n    number_obj.raise_to_power(power)\n    return number_obj.sum_digits()"}
{"task_id": "Mbpp/725", "solution": "import re\ndef extract_quotation(input_string: str) -> list[str]:\n    \"\"\"\n    Extracts all substrings enclosed by double quotation marks from a given input string.\n    The regular expression `r'\"([^\"]*)\"'` captures content between quotes.\n    \"\"\"\n    return re.findall(r'\"([^\"]*)\"', input_string)"}
{"task_id": "Mbpp/723", "solution": "def count_same_pair(list1: list, list2: list) -> int:\n    \"\"\"\n    Counts the number of indices where elements in two lists are identical.\n    It is assumed that the input lists are of the same length.\n    \"\"\"\n    identical_pair_count = 0\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n            identical_pair_count += 1\n    return identical_pair_count"}
{"task_id": "Mbpp/722", "solution": "def filter_data(student_data: dict[str, tuple[float, float]], min_height: float, min_weight: float) -> dict[str, tuple[float, float]]:\n    \"\"\"\n    Filters student data based on minimum height and weight criteria.\n    Returns a new dictionary with students satisfying both conditions.\n    \"\"\"\n    filtered_students = {}\n    for name, (height, weight) in student_data.items():\n        if height >= min_height and weight >= min_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"Calculates the product of adjacent elements in a tuple. Returns a new tuple with these products.\"\"\"\n    products = []\n    for i in range(len(input_tuple) - 1):\n        products.append(input_tuple[i] * input_tuple[i+1])\n    return tuple(products)"}
{"task_id": "Mbpp/728", "solution": "def sum_list(list_A: list[float | int], list_B: list[float | int]) -> list[float | int]:\n    \"\"\"\n    Calculates the element-wise sum of two lists of numbers.\n    Raises ValueError if lists are not of equal length.\n    \"\"\"\n    if len(list_A) != len(list_B):\n        raise ValueError(\"Input lists must be of equal length.\")\n\n    result_list: list[float | int] = []\n    for i in range(len(list_A)):\n        result_list.append(list_A[i] + list_B[i])\n\n    return result_list"}
{"task_id": "Mbpp/730", "solution": "from typing import List, Any\ndef consecutive_duplicates(input_list: List[Any]) -> List[Any]:\n    \"\"\"\n    Removes consecutive duplicate elements from a list.\n    Returns a new list with consecutive duplicates removed, preserving the order.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result: List[Any] = []\n    result.append(input_list[0])\n    for i in range(1, len(input_list)):\n        if input_list[i] != result[-1]:\n            result.append(input_list[i])\n\n    return result"}
{"task_id": "Mbpp/753", "solution": "def min_k(records, k):\n    \"\"\"\n    Sorts the records by the second element (value) and returns the first k elements.\n    If k is greater than the list length, all records are returned.\n    \"\"\"\n    sorted_records = sorted(records, key=lambda x: x[1])\n    return sorted_records[:k]"}
