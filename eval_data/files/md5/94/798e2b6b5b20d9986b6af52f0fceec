{"task_id": "Mbpp/445", "solution": "def index_multiplication(tuple1: tuple[tuple[int, ...], ...], tuple2: tuple[tuple[int, ...], ...]) -> tuple[tuple[int, ...], ...]:\n    \"\"\"\n    Performs index-wise multiplication of elements from two input tuples of tuples.\n    Raises ValueError if input tuples or their inner tuples have different lengths.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same number of inner tuples.\")\n\n    results = []\n    for inner_tuple1, inner_tuple2 in zip(tuple1, tuple2):\n        if len(inner_tuple1) != len(inner_tuple2):\n            raise ValueError(\"Inner tuples must have the same number of elements at corresponding positions.\")\n\n        inner_results = []\n        for elem1, elem2 in zip(inner_tuple1, inner_tuple2):\n            inner_results.append(elem1 * elem2)\n        results.append(tuple(inner_results))\n\n    return tuple(results)"}
{"task_id": "Mbpp/450", "solution": "def extract_string(input_list: list[str], target_size: int) -> list[str]:\n    \"\"\"\n    Extracts strings of a specified size from a given list of string values.\n    Returns a new list containing strings whose length is exactly target_size.\n    \"\"\"\n    filtered_list = []\n    for s in input_list:\n        if len(s) == target_size:\n            filtered_list.append(s)\n    return filtered_list"}
{"task_id": "Mbpp/446", "solution": "def count_Occurrence(target_tuple: tuple, search_list: list) -> int:\n    \"\"\"\n    Counts the total occurrences of elements from search_list within target_tuple.\n    \"\"\"\n    total_count = 0\n    for element_in_tuple in target_tuple:\n        if element_in_tuple in search_list:\n            total_count += 1\n    return total_count"}
{"task_id": "Mbpp/440", "solution": "import string\ndef _clean_word(word: str) -> str:\n    \"\"\"Removes trailing punctuation from a word.\n    It iterates from the end, stripping punctuation characters.\"\"\"\n    while word and word[-1] in string.punctuation:\n        word = word[:-1]\n    return word\ndef _is_adverb(word: str) -> bool:\n    \"\"\"Determines if a word is an adverb using a simple '-ly' suffix rule.\n    It checks if the word ends with 'ly' and has more than two characters.\"\"\"\n    return word.lower().endswith('ly') and len(word) > 2\ndef find_adverb_position(sentence: str) -> tuple[int, int, str | None]:\n    \"\"\"Finds the first adverb and its positions in a given sentence.\n    Returns a tuple (start_position, end_position, cleaned_adverb_string) or (-1, -1, None) if not found.\"\"\"\n    current_char_pos = 0\n    sentence_len = len(sentence)\n\n    while current_char_pos < sentence_len:\n        # Skip leading spaces to find the start of the next word\n        while current_char_pos < sentence_len and sentence[current_char_pos].isspace():\n            current_char_pos += 1\n        \n        if current_char_pos >= sentence_len:\n            break # End of sentence, no more words\n\n        word_start = current_char_pos\n        word_end = current_char_pos\n        # Find the end of the current word (until a space or end of sentence)\n        while word_end < sentence_len and not sentence[word_end].isspace():\n            word_end += 1\n        \n        raw_word = sentence[word_start:word_end]\n        cleaned_word = _clean_word(raw_word)\n\n        if _is_adverb(cleaned_word):\n            # Calculate the exclusive end position of the cleaned adverb within the original sentence\n            return (word_start, word_start + len(cleaned_word), cleaned_word)\n        \n        # Move current_char_pos to the end of the current word to continue search\n        current_char_pos = word_end \n\n    return (-1, -1, None)"}
{"task_id": "Mbpp/448", "solution": "def cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from P(0) to P(n).\n    It uses a PerrinSequence class for calculation with memoization.\"\"\"\n    \n    class PerrinSequence:\n        def __init__(self):\n            self._memo = {0: 3, 1: 0, 2: 2}\n\n        def calculate_perrin(self, k: int) -> int:\n            if k in self._memo:\n                return self._memo[k]\n            \n            if k < 0: # Should not be reached with non-negative 'n'\n                return 0\n\n            # For k > 2, P(k) = P(k-2) + P(k-3)\n            self._memo[k] = self.calculate_perrin(k - 2) + self.calculate_perrin(k - 3)\n            return self._memo[k]\n\n        def calculate_sum(self, k: int) -> int:\n            total_sum = 0\n            for i in range(k + 1):\n                total_sum += self.calculate_perrin(i)\n            return total_sum\n\n    perrin_seq_calculator = PerrinSequence()\n    return perrin_seq_calculator.calculate_sum(n)"}
