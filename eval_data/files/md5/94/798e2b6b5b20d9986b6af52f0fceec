{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    Iterates from 0 to n-1, finding the (i+1)-th odd number and adding its fourth power to the sum.\n    \"\"\"\n    total_sum = 0\n    for i in range(n):\n        odd_number = 2 * i + 1\n        total_sum += odd_number ** 4\n    return total_sum"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1: list, list2: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists.\n\n    Returns a new list containing elements present in list1 but not in list2,\n    preserving their original order from list1.\n    \"\"\"\n    set_list2 = set(list2)\n    result = []\n    for item in list1:\n        if item not in set_list2:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list[int], target_sum: int) -> int:\n    \"\"\"\n    Counts the number of pairs in a list whose sum equals a target value.\n    This implementation uses nested loops to check all unique pairs.\n    \"\"\"\n    pair_count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                pair_count += 1\n    return pair_count"}
{"task_id": "Mbpp/775", "solution": "def odd_position(input_list):\n    \"\"\"Checks if every odd index in the list contains an odd number.\"\"\"\n    def _is_odd(number):\n        \"\"\"Helper function to check if a number is odd.\"\"\"\n        return number % 2 != 0\n\n    for i in range(len(input_list)):\n        if (i + 1) % 2 != 0:  # Check if index (1-based) is odd, which means 0-based index is even\n            continue\n        # If 0-based index is odd, we need to check the number\n        if not _is_odd(input_list[i]):\n            return False\n    return True"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(main_string: str, target_substring: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence and position of a target substring within a main string.\n    Returns a tuple (matched_text, start_position, length) if found, otherwise None.\n    \"\"\"\n    index = main_string.find(target_substring)\n\n    if index == -1:\n        return None\n    else:\n        return (target_substring, index, len(target_substring))"}
{"task_id": "Mbpp/771", "solution": "_BRACKET_PAIRS = {'(': ')', '[': ']', '{': '}'}\n_OPENING_BRACKETS = set(_BRACKET_PAIRS.keys())\n_CLOSING_BRACKETS = set(_BRACKET_PAIRS.values())\ndef check_expression(expression_string: str) -> bool:\n    \"\"\"Checks if the given expression string has balanced brackets using a stack.\"\"\"\n    stack = []\n    \n    for char in expression_string:\n        if char in _OPENING_BRACKETS:\n            stack.append(char)\n        elif char in _CLOSING_BRACKETS:\n            if not stack:\n                return False # Closing bracket without a matching opening bracket\n            \n            last_open = stack.pop()\n            if _BRACKET_PAIRS[last_open] != char:\n                return False # Mismatch between opening and closing bracket types\n            \n    return not stack # True if stack is empty (all brackets matched), False otherwise"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: List[Any]) -> List[List[Any]]:\n    \"\"\"\n    Packs consecutive duplicates of list elements into sublists.\n    Each sublist contains consecutive identical elements from the input list.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    i = 0\n    while i < len(input_list):\n        current_element = input_list[i]\n        sublist = [current_element]\n        j = i + 1\n        while j < len(input_list) and input_list[j] == current_element:\n            sublist.append(input_list[j])\n            j += 1\n        packed_list.append(sublist)\n        i = j\n    return packed_list"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(tuple_list: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    \"\"\"\n    Finds combinations of sums with tuples in the given tuple list.\n    Computes element-wise sums of all unique pairs of 2-element tuples.\n    \"\"\"\n    import itertools\n\n    def _validate_input_tuples(tuple_list: list) -> None:\n        \"\"\"\n        Ensures the input is a list of 2-element integer tuples.\n        Raises ValueError if the input format is incorrect.\n        \"\"\"\n        if not isinstance(tuple_list, list):\n            raise ValueError(\"Input must be a list.\")\n        for item in tuple_list:\n            if not isinstance(item, tuple) or len(item) != 2:\n                raise ValueError(\"Each item in the list must be a 2-element tuple.\")\n            if not all(isinstance(x, int) for x in item):\n                raise ValueError(\"Each element within tuples must be an integer.\")\n\n    def _sum_two_tuples(tuple1: tuple[int, int], tuple2: tuple[int, int]) -> tuple[int, int]:\n        \"\"\"\n        Computes the element-wise sum of two given 2-element tuples.\n        \"\"\"\n        return (tuple1[0] + tuple2[0], tuple1[1] + tuple2[1])\n\n    _validate_input_tuples(tuple_list)\n\n    result_sums = []\n    # Generate unique pairs of tuples\n    for t1, t2 in itertools.combinations(tuple_list, 2):\n        sum_tuple = _sum_two_tuples(t1, t2)\n        result_sums.append(sum_tuple)\n\n    return result_sums"}
{"task_id": "Mbpp/777", "solution": "def find_sum(input_list):\n    \"\"\"Calculates the sum of non-repeated elements in a given list.\"\"\"\n    counts = {}\n    for item in input_list:\n        counts[item] = counts.get(item, 0) + 1\n\n    total_sum = 0\n    for item, count in counts.items():\n        if count == 1:\n            total_sum += item\n            \n    return total_sum"}
