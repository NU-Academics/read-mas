{"task_id": "Mbpp/472", "solution": "def check_Consecutive(numbers: list) -> bool:\n    \"\"\"\n    Checks if a given list of integers contains consecutive numbers.\n    Empty lists or lists with a single element are considered consecutive.\n    \"\"\"\n    n = len(numbers)\n\n    if n <= 1:\n        return True\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(1, n):\n        if sorted_numbers[i] != sorted_numbers[i-1] + 1:\n            return False\n\n    return True"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(nums: list[float]) -> float:\n    # Handles an empty list as per typical behavior for products (or problem constraints if specified).\n    if not nums:\n        return 0\n\n    max_so_far = nums[0]\n    min_so_far = nums[0]\n    result = nums[0]\n\n    for i in range(1, len(nums)):\n        current_num = nums[i]\n\n        # If current number is negative, swap max_so_far and min_so_far\n        # because multiplying by a negative number reverses their roles.\n        if current_num < 0:\n            max_so_far, min_so_far = min_so_far, max_so_far\n\n        # Update max_so_far and min_so_far\n        max_so_far = max(current_num, max_so_far * current_num)\n        min_so_far = min(current_num, min_so_far * current_num)\n\n        # Update the overall maximum product found so far\n        result = max(result, max_so_far)\n\n    return result"}
{"task_id": "Mbpp/462", "solution": "def combinations_list(input_list: list) -> list[list]:\n    \"\"\"\n    Generates all possible combinations of elements from the input list, maintaining a specific order of combinations and elements within them.\n    The function starts with an empty list and iteratively adds each input element by prepending it to existing combinations.\n    \"\"\"\n    # Initialize the list of all combinations with an empty list.\n    all_combinations = [[]]\n\n    # Process each element from the input list to generate new combinations.\n    for current_element in input_list:\n        # Get the current number of combinations before extending the list.\n        current_combinations_count = len(all_combinations)\n\n        # For each existing combination, create a new one by prepending the current element.\n        for i in range(current_combinations_count):\n            existing_combination = all_combinations[i]\n            new_combination = [current_element] + existing_combination\n            all_combinations.append(new_combination)\n\n    return all_combinations"}
{"task_id": "Mbpp/468", "solution": "def max_product(arr: list[int]) -> int:\n    \"\"\"Calculates the maximum product of an increasing subsequence.\n\n    Uses dynamic programming to find the maximum product.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n\n    # dp[i] stores the maximum product of an increasing subsequence ending at index i\n    dp = [0] * n\n\n    # Initialize dp array. Each element itself is an increasing subsequence.\n    for i in range(n):\n        dp[i] = arr[i]\n\n    # Iterate through the array to build up products\n    for i in range(n):\n        for j in range(i):\n            # If current element arr[i] can extend the subsequence ending at arr[j]\n            if arr[i] > arr[j]:\n                # Update dp[i] with the maximum product\n                dp[i] = max(dp[i], dp[j] * arr[i])\n\n    # The maximum product is the maximum value in the dp array\n    return max(dp)"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"Calculates pairwise sums of neighboring elements in an input tuple.\"\"\"\n    sums = []\n    for i in range(len(input_tuple) - 1):\n        sums.append(input_tuple[i] + input_tuple[i+1])\n    return tuple(sums)"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(arr: list[int], n: int) -> int:\n    \"\"\"Calculates the product of array elements modulo n.\n\n    Applies the modulo operation at each step to prevent integer overflow.\n    \"\"\"\n    product = 1\n    for x in arr:\n        product = (product * (x % n)) % n\n    return product"}
{"task_id": "Mbpp/473", "solution": "def _get_canonical_tuple(t: tuple) -> tuple:\n    \"\"\"Converts a tuple into its canonical form by sorting its elements.\n    This ensures (a, b) and (b, a) are treated as equivalent.\"\"\"\n    return tuple(sorted(t))\ndef tuple_intersection(list1: list[tuple], list2: list[tuple]) -> set[tuple]:\n    \"\"\"Finds the intersection of two lists of tuples, considering order-agnostic equivalence.\n    Returns a set of unique, canonical tuples.\"\"\"\n    canonical_set1 = {_get_canonical_tuple(t) for t in list1}\n    intersection_result = set()\n\n    for t2 in list2:\n        canonical_t2 = _get_canonical_tuple(t2)\n        if canonical_t2 in canonical_set1:\n            intersection_result.add(canonical_t2)\n\n    return intersection_result"}
{"task_id": "Mbpp/476", "solution": "def big_sum(array: list) -> float:\n  \"\"\"Calculates the sum of the largest and smallest numerical values in a given array.\n\n  Handles empty arrays by returning 0.0 and single-element arrays by returning twice the element's value.\n  \"\"\"\n  if not array:\n    return 0.0\n  elif len(array) == 1:\n    return float(array[0] * 2)\n  else:\n    max_val = max(array)\n    min_val = min(array)\n    return float(max_val + min_val)"}
