{"task_id": "Mbpp/572", "solution": "def two_unique_nums(numbers: list[int]) -> list[int]:\n    \"\"\"\n    Removes duplicate numbers from a list, returning only those that appear exactly once,\n    preserving the order of their first occurrence.\n    \"\"\"\n    counts = {}\n    ordered_first_occurrence = []\n    seen_for_order = set()\n\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n        if num not in seen_for_order:\n            ordered_first_occurrence.append(num)\n            seen_for_order.add(num)\n\n    result = []\n    for num in ordered_first_occurrence:\n        if counts[num] == 1:\n            result.append(num)\n\n    return result"}
{"task_id": "Mbpp/569", "solution": "def sort_sublists(list_of_lists: list[list[str]]) -> list[list[str]]:\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists alphabetically in ascending order.\n    Returns a new list of lists with each sublist sorted.\n    \"\"\"\n    sorted_list_of_lists = [list(sublist) for sublist in list_of_lists]\n    for sublist in sorted_list_of_lists:\n        sublist.sort()\n    return sorted_list_of_lists"}
{"task_id": "Mbpp/564", "solution": "from typing import List\nfrom collections import Counter\ndef count_Pairs(input_list: List[int]) -> int:\n    \"\"\"\n    Counts the number of possible unordered pairs where both elements are unequal.\n    This is calculated by subtracting pairs of identical elements from the total possible pairs of indices.\n    \"\"\"\n    n = len(input_list)\n    if n < 2:\n        return 0\n\n    # Calculate total possible pairs of indices (unordered)\n    # This is n * (n - 1) / 2\n    total_pairs_of_indices = n * (n - 1) // 2\n\n    # Use a frequency map to count occurrences of each number\n    counts = Counter(input_list)\n\n    # Calculate pairs formed by identical elements (e.g., (1,1) from [1,1,2])\n    # For each number 'x' appearing 'k' times, it forms k * (k-1) / 2 pairs of (x,x).\n    pairs_with_equal_elements = 0\n    for count in counts.values():\n        if count >= 2:\n            pairs_with_equal_elements += count * (count - 1) // 2\n\n    # The number of unordered pairs with unequal elements is:\n    # (Total pairs of indices) - (Pairs with equal elements)\n    return total_pairs_of_indices - pairs_with_equal_elements"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if sub_list is a contiguous sublist of main_list.\n    \"\"\"\n    if len(sub_list) > len(main_list):\n        return False\n    for i in range(len(main_list) - len(sub_list) + 1):\n        if main_list[i:i+len(sub_list)] == sub_list:\n            return True\n    return False"}
{"task_id": "Mbpp/573", "solution": "def unique_product(numbers):\n    \"\"\"\n    Calculates the product of the unique numbers in a given list.\n    Returns 1 if the list is empty or contains no unique numerical values.\n    \"\"\"\n    unique_nums = set()\n    for num in numbers:\n        if isinstance(num, (int, float)):\n            unique_nums.add(num)\n\n    if not unique_nums:\n        return 1\n\n    product_result = 1\n    for num in unique_nums:\n        product_result *= num\n\n    return product_result"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Raises ValueError if the input lists do not have the same length.\n    \"\"\"\n    len1 = len(list1)\n    len2 = len(list2)\n    len3 = len(list3)\n\n    if not (len1 == len2 == len3):\n        raise ValueError(\"All input lists must have the same length.\")\n\n    result = []\n    for i in range(len1):\n        result.append(list1[i])\n        result.append(list2[i])\n        result.append(list3[i])\n    return result"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Finds dissimilar elements between two given tuples, preserving original order for each group.\n    Elements unique to tuple1 appear first, followed by elements unique to tuple2.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n\n    unique_to_tuple1 = [x for x in tuple1 if x not in set2]\n    unique_to_tuple2 = [x for x in tuple2 if x not in set1]\n\n    return tuple(unique_to_tuple1 + unique_to_tuple2)"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Calculates the last digit of the factorial of a given non-negative integer.\n    Applies specific rules to avoid computing large factorials directly.\n    \"\"\"\n    if n >= 5:\n        return 0\n    elif n == 0 or n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4"}
{"task_id": "Mbpp/581", "solution": "def surface_Area(base_edge: float, slant_height: float) -> float:\n    \"\"\"Calculates the total surface area of a square pyramid given its base edge and slant height.\"\"\"\n    base_area = base_edge * base_edge\n    lateral_surface_area = 2 * base_edge * slant_height\n    total_surface_area = base_area + lateral_surface_area\n    return total_surface_area"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Recursively processes a nested tuple, extracting only even integer elements\n    and preserving the original nesting structure.\n    \"\"\"\n    results = []\n    for element in input_tuple:\n        if isinstance(element, int):\n            if element % 2 == 0:\n                results.append(element)\n        elif isinstance(element, tuple):\n            processed_nested_tuple = extract_even(element)\n            if processed_nested_tuple: # Only add if not empty\n                results.append(processed_nested_tuple)\n    return tuple(results)"}
