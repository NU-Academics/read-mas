{"task_id": "Mbpp/129", "solution": "class Matrix:\n    \"\"\"Encapsulates a 2D list, validates its square property, and calculates various sums.\"\"\"\n    def __init__(self, elements):\n        self._elements = elements\n        self._size = 0\n        if elements:\n            self._size = len(elements)\n        \n    def is_square(self):\n        \"\"\"Verifies if the encapsulated 2D list forms a square matrix.\"\"\"\n        if self._size == 0:\n            return False # An empty matrix or matrix with no rows cannot be a magic square.\n        \n        # All rows must have the same length as the number of rows (self._size)\n        for row in self._elements:\n            if len(row) != self._size:\n                return False\n        return True\n\n    def get_size(self):\n        \"\"\"Returns the dimension (N) of the square matrix.\"\"\"\n        return self._size\n\n    def get_row_sum(self, row_index):\n        \"\"\"Calculates the sum of elements in the specified row.\"\"\"\n        return sum(self._elements[row_index])\n\n    def get_col_sum(self, col_index):\n        \"\"\"Calculates the sum of elements in the specified column.\"\"\"\n        col_sum = 0\n        for i in range(self._size):\n            col_sum += self._elements[i][col_index]\n        return col_sum\n\n    def get_main_diagonal_sum(self):\n        \"\"\"Calculates the sum of elements along the main diagonal.\"\"\"\n        diag_sum = 0\n        for i in range(self._size):\n            diag_sum += self._elements[i][i]\n        return diag_sum\n\n    def get_anti_diagonal_sum(self):\n        \"\"\"Calculates the sum of elements along the anti-diagonal.\"\"\"\n        diag_sum = 0\n        for i in range(self._size):\n            diag_sum += self._elements[i][self._size - 1 - i]\n        return diag_sum\ndef magic_square_test(matrix_data):\n    \"\"\"\n    Checks if a given 2D list of integers is a magic square.\n    It verifies if all row, column, and diagonal sums are equal.\n    \"\"\"\n    matrix = Matrix(matrix_data)\n\n    if not matrix.is_square():\n        return False\n\n    size = matrix.get_size()\n    if size == 0: # Handle [[], []] or similar after is_square implies squareness for non-zero size\n        return False\n\n    magic_sum = matrix.get_row_sum(0)\n\n    # Check all row sums\n    for i in range(size):\n        if matrix.get_row_sum(i) != magic_sum:\n            return False\n\n    # Check all column sums\n    for i in range(size):\n        if matrix.get_col_sum(i) != magic_sum:\n            return False\n\n    # Check main diagonal sum\n    if matrix.get_main_diagonal_sum() != magic_sum:\n        return False\n\n    # Check anti-diagonal sum\n    if matrix.get_anti_diagonal_sum() != magic_sum:\n        return False\n\n    return True"}
{"task_id": "Mbpp/137", "solution": "def zero_count(numbers: list[int]) -> float:\n    \"\"\"Calculates the ratio of zero elements to non-zero elements in a list of integers.\"\"\"\n    zeroes = 0\n    non_zeroes = 0\n\n    for num in numbers:\n        if num == 0:\n            zeroes += 1\n        else:\n            non_zeroes += 1\n\n    if non_zeroes == 0:\n        if zeroes == 0:\n            return 0.0  # Empty array\n        else:\n            return float('inf')  # Array with only zeroes\n    else:\n        return zeroes / non_zeroes"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(number: int) -> bool:\n    \"\"\"\n    Checks if the given number can be represented as a sum of non-zero powers of 2.\n    This is equivalent to checking if the number is a positive even integer.\n    \"\"\"\n    is_positive = number > 0\n    is_even = number % 2 == 0\n    return is_positive and is_even"}
