{"task_id": "Mbpp/255", "solution": "def combinations_colors(input_list: list, n: int) -> list[tuple]:\n    \"\"\"\n    Generates all combinations with repetition (cartesian product) from input_list of length n.\n    Returns a list of tuples, where each tuple is a combination.\n    \"\"\"\n    if n == 0:\n        return [()]\n    if not input_list: # If the list is empty and n > 0, no combinations are possible.\n        return []\n\n    result = []\n    elements = tuple(input_list) # Convert to tuple for immutability and efficiency\n\n    def generate_recursive(current_combination):\n        if len(current_combination) == n:\n            result.append(tuple(current_combination))\n            return\n        for element in elements:\n            current_combination.append(element)\n            generate_recursive(current_combination)\n            current_combination.pop()\n\n    generate_recursive([])\n    return result"}
{"task_id": "Mbpp/259", "solution": "def maximize_elements(tuple_of_tuples_1: tuple[tuple[int, int], ...], tuple_of_tuples_2: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:\n    \"\"\"\n    Returns a new tuple of tuples where each element is the maximum of the corresponding\n    elements from the two input tuples of tuples.\n    \"\"\"\n    result_inner_tuples = []\n    for inner_tuple_1, inner_tuple_2 in zip(tuple_of_tuples_1, tuple_of_tuples_2):\n        max_element1 = max(inner_tuple_1[0], inner_tuple_2[0])\n        max_element2 = max(inner_tuple_1[1], inner_tuple_2[1])\n        result_inner_tuples.append((max_element1, max_element2))\n    return tuple(result_inner_tuples)"}
{"task_id": "Mbpp/260", "solution": "from typing import Optional\ndef is_prime(num: int) -> bool:\n    \"\"\"Determines if a given integer is a prime number efficiently.\n    This implementation uses an optimized trial division method.\n    \"\"\"\n    if num < 2:\n        return False\n    if num == 2 or num == 3:\n        return True\n    if num % 2 == 0 or num % 3 == 0:\n        return False\n\n    i = 5\n    while i * i <= num:\n        if num % i == 0 or num % (i + 2) == 0:\n            return False\n        i += 6\n    return True\nclass NSWNumberCalculator:\n    \"\"\"Calculates Newman-Shanks-Williams numbers.\"\"\"\n\n    def calculate_nsw_number(self, n: int) -> int:\n        \"\"\"Computes S_n using the recurrence relation S_0 = 1, S_1 = 1, S_k = 2S_{k-1} + S_{k-2}.\"\"\"\n        if n == 0:\n            return 1\n        if n == 1:\n            return 1\n\n        s_prev_prev = 1  # S_0\n        s_prev = 1       # S_1\n\n        for k in range(2, n + 1):\n            s_current = 2 * s_prev + s_prev_prev\n            s_prev_prev = s_prev\n            s_prev = s_current\n        return s_prev\ndef newman_prime(n: int) -> Optional[int]:\n    \"\"\"Calculates the nth NSW number and returns it if it's prime, otherwise None.\"\"\"\n    calculator = NSWNumberCalculator()\n    s_n_value = calculator.calculate_nsw_number(n)\n\n    if is_prime(s_n_value):\n        return s_n_value\n    return None"}
{"task_id": "Mbpp/266", "solution": "def lateralsurface_cube(side_length):\n    \"\"\"\n    Calculates the lateral surface area of a cube given its side length.\n    It uses the formula: 4 * (side_length)^2.\n    \"\"\"\n    class Cube:\n        def __init__(self, side_length: float):\n            self._side_length = side_length\n\n        def calculateLateralSurfaceArea(self) -> float:\n            return 4 * (self._side_length ** 2)\n\n    cube_obj = Cube(side_length)\n    return cube_obj.calculateLateralSurfaceArea()"}
{"task_id": "Mbpp/261", "solution": "def division_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise mathematical division on two input tuples.\n    Raises errors for type mismatches, length mismatches, invalid element types, and division by zero.\n    \"\"\"\n    class TupleLengthMismatchError(Exception):\n        \"\"\"Raised when input tuples have different lengths.\"\"\"\n        pass\n\n    class DivisionByZeroError(Exception):\n        \"\"\"Raised when an element in the divisor tuple is zero.\"\"\"\n        pass\n\n    class InvalidElementTypeError(Exception):\n        \"\"\"Raised when a tuple element is not a number.\"\"\"\n        pass\n\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n\n    if len(tuple1) != len(tuple2):\n        raise TupleLengthMismatchError(\"Input tuples must have the same length.\")\n\n    results = []\n    for i in range(len(tuple1)):\n        dividend = tuple1[i]\n        divisor = tuple2[i]\n\n        if not isinstance(dividend, (int, float)) or not isinstance(divisor, (int, float)):\n            raise InvalidElementTypeError(\"Tuple elements must be numbers (int or float).\")\n\n        if divisor == 0:\n            raise DivisionByZeroError(\"Cannot divide by zero.\")\n\n        results.append(dividend / divisor)\n\n    return tuple(results)"}
{"task_id": "Mbpp/262", "solution": "def split_two_parts(input_list: list, L: int) -> tuple[list, list]:\n    \"\"\"\n    Splits the given list into two parts where the length of the first part is L.\n    Returns the resulting lists in a tuple.\n    \"\"\"\n    first_part = input_list[:L]\n    second_part = input_list[L:]\n    return (first_part, second_part)"}
{"task_id": "Mbpp/264", "solution": "def dog_age(human_years: int) -> int:\n    \"\"\"Calculates a dog's age in dog years based on human years input.\n    The first two human years are 10.5 dog years each; subsequent years are 4 dog years each.\n    \"\"\"\n    if human_years <= 2:\n        dog_years = human_years * 10.5\n    else:\n        dog_years = (2 * 10.5) + ((human_years - 2) * 4)\n    return int(dog_years)"}
{"task_id": "Mbpp/265", "solution": "def list_split(input_list: list, n: int) -> list[list]:\n    \"\"\"\n    Splits an input list into 'n' sub-lists, distributing elements based on their original index modulo 'n'.\n    Each sub-list contains elements from the original list taken at an 'n'-stride, preserving their relative order.\n    \"\"\"\n    result = [[] for _ in range(n)]\n\n    for i, item in enumerate(input_list):\n        result[i % n].append(item)\n\n    return result"}
