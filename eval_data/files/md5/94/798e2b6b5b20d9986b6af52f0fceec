{"task_id": "Mbpp/172", "solution": "def count_occurance(input_string: str) -> int:\n    \"\"\"\n    Counts the number of non-overlapping occurrences of 'std' in the input_string.\n    The search is case-sensitive and non-overlapping.\n    \"\"\"\n    target_substring = 'std'\n    count = 0\n    start_index = 0\n    while True:\n        index = input_string.find(target_substring, start_index)\n        if index == -1:\n            break\n        count += 1\n        start_index = index + len(target_substring)\n    return count"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(number: int) -> int:\n    \"\"\"\n    Counts the number of set bits (1s) in the binary representation of a given integer.\n    Handles both positive and negative integers, assuming a 32-bit two's complement representation for negative numbers.\n    \"\"\"\n    if number < 0:\n        # For negative numbers, convert to their 32-bit two's complement unsigned equivalent.\n        number = (1 << 32) + number\n    \n    # Convert the number to its binary string representation and count '1's.\n    # The '0b' prefix generated by bin() is automatically ignored by .count('1').\n    return bin(number).count('1')"}
{"task_id": "Mbpp/223", "solution": "import bisect\ndef is_majority(array: list[int], n: int, element: int) -> bool:\n    \"\"\"\n    Determines if a given element is the majority element in a sorted array.\n    This function leverages the sorted property for efficient counting using binary search.\n    \"\"\"\n    first_occurrence_idx = bisect.bisect_left(array, element)\n    last_occurrence_idx = bisect.bisect_right(array, element) - 1\n\n    if first_occurrence_idx > last_occurrence_idx:\n        element_count = 0\n    else:\n        element_count = last_occurrence_idx - first_occurrence_idx + 1\n\n    majority_threshold = n / 2.0\n    return element_count > majority_threshold"}
