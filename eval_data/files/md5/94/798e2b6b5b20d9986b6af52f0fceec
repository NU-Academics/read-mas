{"task_id": "Mbpp/14", "solution": "def find_Volume(base, height, length):\n    \"\"\"\n    Calculates the volume of a triangular prism.\n    Raises ValueError if any input dimension is non-positive.\n    \"\"\"\n    if base <= 0 or height <= 0 or length <= 0:\n        raise ValueError(\"All dimensions (base, height, length) must be positive.\")\n    volume = 0.5 * base * height * length\n    return volume"}
{"task_id": "Mbpp/56", "solution": "def _reverse_number(num: int) -> int:\n    \"\"\"\n    Determines the reverse of a given integer.\n    Handles positive numbers. For example, reverse of 70 is 7.\n    \"\"\"\n    s = str(abs(num))\n    reversed_s = s[::-1]\n    return int(reversed_s)\ndef check(number: int) -> bool:\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    \"\"\"\n    reversed_num = _reverse_number(number)\n    twice_reverse_minus_one = (2 * reversed_num) - 1\n    return number == twice_reverse_minus_one"}
{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits: list[int]) -> int:\n    \"\"\"\n    Finds the largest number that can be formed with the given list of digits.\n    \"\"\"\n    sorted_digits = sorted(digits, reverse=True)\n    str_digits = [str(d) for d in sorted_digits]\n    concatenated_string = \"\".join(str_digits)\n    largest_number = int(concatenated_string)\n    return largest_number"}
{"task_id": "Mbpp/63", "solution": "def max_difference(list_of_tuples: list[tuple[int | float, int | float]]) -> int | float:\n    \"\"\"\n    Finds the maximum absolute difference between elements in available pairs in the given tuple list.\n    Returns the maximum absolute difference found, or 0 if the list is empty.\n    \"\"\"\n    max_diff = 0\n    for e1, e2 in list_of_tuples:\n        current_diff = abs(e1 - e2)\n        if current_diff > max_diff:\n            max_diff = current_diff\n    return max_diff"}
{"task_id": "Mbpp/62", "solution": "def smallest_num(numbers):\n    \"\"\"\n    Finds the smallest number in a list of numbers.\n\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty\")\n\n    smallest_value = numbers[0]\n    for number in numbers[1:]:\n        if number < smallest_value:\n            smallest_value = number\n    return smallest_value"}
