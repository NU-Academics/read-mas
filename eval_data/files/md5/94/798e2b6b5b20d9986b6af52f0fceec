{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(\n    list_ids: list[str],\n    list_names: list[str],\n    list_scores: list[int]\n) -> list[dict[str, dict[str, int]]]:\n    \"\"\"\n    Converts three equally sized input lists (student identifiers, names, and scores)\n    into a list of nested dictionaries.\n    Each dictionary in the output list will have the format: {'ID': {'Name': Score}}.\n    \"\"\"\n    if not (len(list_ids) == len(list_names) == len(list_scores)):\n        raise ValueError(\"Input lists must have equal lengths.\")\n\n    result = []\n    for student_id, student_name, student_score in zip(list_ids, list_names, list_scores):\n        inner_dict = {student_name: student_score}\n        nested_dict = {student_id: inner_dict}\n        result.append(nested_dict)\n\n    return result"}
{"task_id": "Mbpp/395", "solution": "def first_non_repeating_character(input_string: str) -> Optional[str]:\n    \"\"\"Finds the first non-repeated character in a given string.\n\n    Args:\n        input_string: The string to analyze.\n\n    Returns:\n        The first non-repeated character as a string, or None if no such character exists.\n    \"\"\"\n    char_counts = {}\n\n    # First pass: Populate character counts\n    for char in input_string:\n        char_counts[char] = char_counts.get(char, 0) + 1\n\n    # Second pass: Find the first character with a count of 1\n    for char in input_string:\n        if char_counts[char] == 1:\n            return char\n\n    # If no non-repeating character is found\n    return None"}
{"task_id": "Mbpp/398", "solution": "def sum_of_digits(numbers):\n    \"\"\"\n    Computes the sum of digits for each number in a list and returns their aggregated sum.\n    Handles negative numbers by summing the digits of their absolute value.\n    \"\"\"\n    def _calculate_digit_sum(number: int) -> int:\n        # Calculates the sum of digits for a single number using its absolute value.\n        return sum(int(digit) for digit in str(abs(number)))\n\n    total_aggregated_sum = 0\n    for num in numbers:\n        total_aggregated_sum += _calculate_digit_sum(num)\n    return total_aggregated_sum"}
