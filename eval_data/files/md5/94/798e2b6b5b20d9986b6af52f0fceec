{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers: list, length: int) -> int:\n    \"\"\"\n    Calculates the sum of XOR of all unique pairs in the given list.\n\n    Args:\n        numbers (list): A list of integer numbers.\n        length (int): The number of elements in the 'numbers' list.\n\n    Returns:\n        int: The total sum of XORs of all unique pairs.\n    \"\"\"\n    total_xor_sum = 0\n    if not numbers or length == 0:\n        return 0\n\n    for i in range(length):\n        for j in range(i + 1, length):\n            xor_result = numbers[i] ^ numbers[j]\n            total_xor_sum += xor_result\n\n    return total_xor_sum"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(items_list: list[dict], n: int) -> list[dict]:\n    \"\"\"\n    Finds the n most expensive items from items_list, sorted by price descending.\n    Handles edge cases like empty list or n=0 by returning an empty list.\n    \"\"\"\n    if not items_list or n == 0:\n        return []\n\n    # Sort the items by 'price' in descending order\n    sorted_items = sorted(items_list, key=lambda item: item['price'], reverse=True)\n\n    # Return the first n items from the sorted list\n    return sorted_items[:n]"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a given list using the heap sort algorithm and returns a new sorted list.\n    \"\"\"\n    working_list = list(input_list)\n    n = len(working_list)\n\n    # Helper function to maintain the max-heap property\n    def _heapify(arr: list, heap_size: int, i: int) -> None:\n        largest = i\n        left_child = 2 * i + 1\n        right_child = 2 * i + 2\n\n        if left_child < heap_size and arr[left_child] > arr[largest]:\n            largest = left_child\n\n        if right_child < heap_size and arr[right_child] > arr[largest]:\n            largest = right_child\n\n        if largest != i:\n            arr[i], arr[largest] = arr[largest], arr[i]\n            _heapify(arr, heap_size, largest)\n\n    # Helper function to build a max-heap from an array\n    def _build_max_heap(arr: list) -> None:\n        current_n = len(arr)\n        # Start from the last non-leaf node and heapify upwards\n        for i in range(current_n // 2 - 1, -1, -1):\n            _heapify(arr, current_n, i)\n\n    # Build a max-heap from the working list\n    _build_max_heap(working_list)\n\n    # Extract elements one by one from the heap\n    for i in range(n - 1, 0, -1):\n        # Move current root (largest element) to end\n        working_list[i], working_list[0] = working_list[0], working_list[i]\n        # Call _heapify on the reduced heap\n        _heapify(working_list, i, 0)\n\n    return working_list"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"Calculates the nth Catalan number using the formula Cn = (2n)! / ((n+1)! * n!).\"\"\"\n\n    def factorial(k: int) -> int:\n        \"\"\"Calculates the factorial of a non-negative integer k.\"\"\"\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    fact_2n = factorial(2 * n)\n    fact_n_plus_1 = factorial(n + 1)\n    fact_n = factorial(n)\n\n    return fact_2n // (fact_n_plus_1 * fact_n)"}
