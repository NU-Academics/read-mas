],\n    all_paths: List[Path]\n) -> None:\n    \"\"\"Recursively explores all valid paths from a given cell to the bottom-right.\"\"\"\n    if r == N - 1 and c == N - 1:\n        all_paths.append(Path(list(current_path_cells)))\n        return\n\n    # Move right\n    if c + 1 < N:\n        _find_paths_recursive(\n            matrix_data, N, r, c + 1,\n            current_path_cells + [Cell(r, c + 1, matrix_data[r][c + 1])],\n            all_paths\n        )\n\n    # Move down\n    if r + 1 < N:\n        _find_paths_recursive(\n            matrix_data, N, r + 1, c,\n            current_path_cells + [Cell(r + 1, c, matrix_data[r + 1][c])],\n            all_paths\n        )\ndef maxAverageOfPath(matrix: List[List[Union[int, float]]]) -> float:\n    \"\"\"\n    Orchestrates input validation, path generation, and finding the maximum average path.\n    Returns the maximum average path value found in the input matrix.\n    \"\"\"\n    N = _validate_matrix(matrix)\n    \n    if N == 0:\n        return 0.0\n\n    all_paths: List[Path] = []\n    \n    # Start path from the top-left cell (0,0)\n    start_cell = Cell(0, 0, matrix[0][0])\n    _find_paths_recursive(matrix, N, 0, 0, [start_cell], all_paths)\n\n    if not all_paths:\n        return 0.0 # Should not happen for valid N > 0, but as a safeguard.\n\n    max_average = -math.inf\n    for path in all_paths:\n        if path.average > max_average:\n            max_average = path.average\n            \n    return max_average", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/739": [{"task_id": "Mbpp/739", "solution": "import math\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    This function iteratively calculates triangular numbers until one with n digits is found.\n    \"\"\"\n    lower_bound = 10**(n - 1)\n    upper_bound_exclusive = 10**n\n\n    # Estimate initial k. k*(k+1)/2 approx k^2/2, so k approx sqrt(2 * lower_bound)\n    k = int(math.sqrt(2 * lower_bound))\n\n    # Ensure k starts from at least 1, as math.sqrt might return 0 for lower_bound=1\n    if k == 0 and lower_bound == 1:\n        k = 1\n    elif k == 0: # Should not happen for lower_bound > 1\n        k = 1 \n    \n    # Iterate and find the smallest k\n    while True:\n        triangular_number = k * (k + 1) // 2 # Use integer division as triangular numbers are integers\n        if triangular_number >= lower_bound and triangular_number < upper_bound_exclusive:\n            return k\n        k += 1", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[99]]}], "Mbpp/271": [{"task_id": "Mbpp/271", "solution": "def even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the first n even natural numbers, each raised to the fifth power.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        even_number = 2 * i\n        total_sum += even_number ** 5\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/592": [{"task_id": "Mbpp/592", "solution": "import math\ndef binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n    return math.factorial(n) // (math.factorial(k) * math.factorial(n - k))\ndef sum_Of_product(n: int) -> int:\n    \"\"\"Calculates the sum of the product of consecutive binomial coefficients for a given 'n'.\"\"\"\n    if n == 0:\n        return 0\n\n    total_sum = 0\n    for k in range(n):\n        term1 = binomial_coefficient(n, k)\n        term2 = binomial_coefficient(n, k + 1)\n        total_sum += term1 * term2\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/765": [{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number.\n    A polite number is a positive integer not expressible as a power of two.\n    \"\"\"\n    polite_count = 0\n    num = 0\n    while polite_count < n:\n        num += 1\n        # Check if 'num' is not a power of two using bitwise operations.\n        # Powers of two have only one bit set: x & (x-1) == 0.\n        if (num & (num - 1)) != 0:\n            polite_count += 1\n    return num", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[1000000000]]}], "Mbpp/255": [{"task_id": "Mbpp/255", "solution": "import itertools\nfrom typing import List, Tuple, Any\ndef combinations_colors(elements: List[Any], n: int) -> List[Tuple[Any, ...]]:\n    \"\"\"\n    Generates all combinations with repetition of the elements of the list\n    and returns a list with a tuple for each combination.\n    \"\"\"\n    return list(itertools.combinations_with_replacement(elements, n))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}