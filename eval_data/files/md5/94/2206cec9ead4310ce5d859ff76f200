{"task_id": "Mbpp/69", "solution": "def _validate_inputs(main_list, sub_list):\n    \"\"\"Raise TypeError if main_list or sub_list is not an instance of list.\"\"\"\n    if not isinstance(main_list, list):\n        raise TypeError(\"main_list must be a list\")\n    if not isinstance(sub_list, list):\n        raise TypeError(\"sub_list must be a list\")\n\ndef _match_contiguous(main_list, sub_list):\n    \"\"\"Assumes both arguments are lists; returns True if sub_list appears contiguously within main_list.\"\"\"\n    n = len(main_list)\n    m = len(sub_list)\n\n    if m == 0:\n        return True\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        if main_list[i : i + m] == sub_list:\n            return True\n    return False\n\ndef is_sublist(main_list, sub_list):\n    \"\"\"Return True if sub_list is a contiguous subsequence of main_list; raise TypeError if inputs are not lists.\"\"\"\n    _validate_inputs(main_list, sub_list)\n    return _match_contiguous(main_list, sub_list)"}
{"task_id": "Mbpp/68", "solution": "from typing import List, Any\n\ndef is_Monotonic(array: List[Any]) -> bool:\n    \"\"\"Public API. Returns True if array is entirely non-increasing OR entirely non-decreasing. Assumes elements are comparable.\"\"\"\n    n = len(array)\n    if n <= 1:\n        return True\n\n    is_non_decreasing = True\n    is_non_increasing = True\n\n    for i in range(n - 1):\n        if array[i] > array[i+1]:\n            is_non_decreasing = False\n        if array[i] < array[i+1]:\n            is_non_increasing = False\n        \n        if not is_non_decreasing and not is_non_increasing:\n            return False\n\n    return is_non_decreasing or is_non_increasing"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(elements):\n    \"\"\"Sorts a list of elements using the Comb Sort algorithm, returning a new sorted list.\"\"\"\n    n = len(elements)\n    if n <= 1:\n        return list(elements)\n\n    arr = list(elements)  # Create a mutable copy of the input list\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        if gap > 1:\n            gap = int(gap / shrink_factor)\n            if gap < 1:  # Ensure gap does not drop to 0 prematurely\n                gap = 1\n\n        swapped = False\n\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/74", "solution": "from typing import List, Dict, Optional\n\nclass PatternList:\n    \"\"\"Wraps an ordered list of pattern strings and provides access operations.\"\"\"\n    def __init__(self, items: List[str]):\n        self.items: List[str] = items\n    def length(self) -> int:\n        \"\"\"Returns the number of items in the list.\"\"\"\n        return len(self.items)\n    def get(self, i: int) -> str:\n        \"\"\"Returns the item at the given index.\"\"\"\n        return self.items[i]\n\nclass SequenceList:\n    \"\"\"Wraps an ordered list of sequence strings and provides access operations.\"\"\"\n    def __init__(self, items: List[str]):\n        self.items: List[str] = items\n    def length(self) -> int:\n        \"\"\"Returns the number of items in the list.\"\"\"\n        return len(self.items)\n    def get(self, i: int) -> str:\n        \"\"\"Returns the item at the given index.\"\"\"\n        return self.items[i]\n\nclass PatternMapping:\n    \"\"\"Maintains an in-memory mapping from pattern values to sequence values and detects conflicts.\"\"\"\n    def __init__(self):\n        self.map: Dict[str, str] = {}\n    def add(self, pattern: str, value: str) -> bool:\n        \"\"\"Adds a new mapping or checks consistency for an existing one.\"\"\"\n        if pattern not in self.map:\n            self.map[pattern] = value\n            return True\n        return self.map[pattern] == value\n    def get(self, pattern: str) -> Optional[str]:\n        \"\"\"Retrieves the mapped value for a given pattern.\"\"\"\n        return self.map.get(pattern)\n    def consistent(self, pattern: str, value: str) -> bool:\n        \"\"\"Checks if a given pattern-value pair is consistent with existing mappings.\"\"\"\n        return pattern not in self.map or self.map[pattern] == value\n\nclass IsSamePatternsFunction:\n    \"\"\"Encapsulates the algorithm to check the iff equality relation using domain objects.\"\"\"\n    def is_samepatterns(self, patterns: PatternList, sequence: SequenceList) -> bool:\n        \"\"\"Checks if the pattern list matches the sequence list according to the mapping rules.\"\"\"\n        if patterns.length() != sequence.length():\n            return False\n\n        mapping = PatternMapping()\n        for i in range(patterns.length()):\n            current_pattern = patterns.get(i)\n            current_sequence_value = sequence.get(i)\n            if not mapping.add(current_pattern, current_sequence_value):\n                return False\n        return True\n\ndef is_samepatterns(patterns: List[str], sequence: List[str]) -> bool:\n    \"\"\"Checks whether a sequence follows the pattern given in the patterns array.\"\"\"\n    pattern_list = PatternList(patterns)\n    sequence_list = SequenceList(sequence)\n    func = IsSamePatternsFunction()\n    return func.is_samepatterns(pattern_list, sequence_list)"}
