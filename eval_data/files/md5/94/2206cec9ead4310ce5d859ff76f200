{"task_id": "Mbpp/448", "solution": "class InputValidator:\n    \"\"\"Utility class for validating input parameters.\"\"\"\n    def isNonNegativeInteger(self, n) -> bool:\n        \"\"\"Checks if n is a non-negative integer.\"\"\"\n        return isinstance(n, int) and n >= 0\n\nclass PerrinNumber:\n    \"\"\"Represents a single Perrin number with its index and value.\"\"\"\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\n\nclass PerrinSequence:\n    \"\"\"Generates and stores a sequence of Perrin numbers, and can compute their sum.\"\"\"\n    def __init__(self):\n        self.sequence = []\n        self.max_index = -1\n\n    def generateUpTo(self, n: int) -> None:\n        \"\"\"Generates Perrin numbers up to index n using the recurrence relation.\"\"\"\n        if n < 0:\n            return\n\n        self.sequence = [] # Ensure sequence is reset for a fresh generation\n\n        # Base cases: P(0)=3, P(1)=0, P(2)=2\n        if n >= 0:\n            self.sequence.append(PerrinNumber(0, 3))\n        if n >= 1:\n            self.sequence.append(PerrinNumber(1, 0))\n        if n >= 2:\n            self.sequence.append(PerrinNumber(2, 2))\n\n        # Recurrence relation: P(i) = P(i-2) + P(i-3) for i >= 3\n        for i in range(3, n + 1):\n            p_i = self.sequence[i-2].value + self.sequence[i-3].value\n            self.sequence.append(PerrinNumber(i, p_i))\n        \n        self.max_index = n\n\n    def sumUpTo(self, n: int) -> int:\n        \"\"\"Calculates the sum of Perrin numbers from P(0) to P(n).\"\"\"\n        current_sum = 0\n        for i in range(n + 1):\n            # Assumes generateUpTo(n) has been called and the sequence is populated\n            if i < len(self.sequence):\n                current_sum += self.sequence[i].value\n        return current_sum\n\nclass CalSum:\n    \"\"\"Orchestrates validation, Perrin sequence generation, and summation.\"\"\"\n    def __init__(self):\n        self._validator = InputValidator()\n\n    def cal_sum(self, n: int) -> int:\n        \"\"\"Calculates the sum of Perrin numbers up to index n.\"\"\"\n        if not self._validator.isNonNegativeInteger(n):\n            raise ValueError(\"n must be a non-negative integer\")\n        \n        seq = PerrinSequence()\n        seq.generateUpTo(n)\n        return seq.sumUpTo(n)\n\ndef cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from P(0) to P(n).\"\"\"\n    return CalSum().cal_sum(n)"}
{"task_id": "Mbpp/450", "solution": "class StringItem:\n    \"\"\"Represents a string value with a method to get its length.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\nclass ResultList:\n    \"\"\"A list-like container that preserves insertion order.\"\"\"\n    def __init__(self):\n        self.items = []\n\n    def add(self, item: str):\n        self.items.append(item)\n\n    def as_list(self) -> list[str]:\n        return self.items\n\nclass ExtractStringFunction:\n    \"\"\"Encapsulates the logic for filtering strings by length.\"\"\"\n    def __init__(self, inputList: list[str], size: int):\n        self.inputList = inputList\n        self.size = size\n\n    def execute(self) -> list[str]:\n        result_list = ResultList()\n        for item_value in self.inputList:\n            string_item = StringItem(item_value)\n            if string_item.length() == self.size:\n                result_list.add(item_value)\n        return result_list.as_list()\n\ndef extract_string(input_list, size):\n    \"\"\"\n    Extracts strings of a specified length from a list.\n    Returns a new list containing only strings whose length equals 'size', preserving original order.\n    \"\"\"\n    # Input validation (e.g., using Validator) is omitted here based on the specific requirements\n    # \"DO NOT add isinstance() checks or raise exceptions for edge cases\".\n    f = ExtractStringFunction(input_list, size)\n    return f.execute()"}
