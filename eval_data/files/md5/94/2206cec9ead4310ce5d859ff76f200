{"task_id": "Mbpp/66", "solution": "def _validate_input(numbers: list) -> None:\n    \"\"\"Validate that 'numbers' is a list of int or float; raise TypeError on invalid input.\"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"'numbers' must be a list\")\n    for item in numbers:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"All items in 'numbers' must be numeric (int or float)\")\n\ndef pos_count(numbers: list) -> int:\n    \"\"\"Return the count of items in 'numbers' strictly greater than 0.\n\n    Raises:\n        TypeError: if 'numbers' is not a list or contains non-numeric items.\n    \"\"\"\n    _validate_input(numbers)\n    count = 0\n    for num in numbers:\n        if num > 0:\n            count += 1\n    return count"}
{"task_id": "Mbpp/70", "solution": "from typing import List, Tuple, Any\n\ndef get_equal(list_of_tuples: List[Tuple[Any, ...]]) -> bool:\n    \"\"\"Checks if all tuples in the given list have the same length.\n    Returns True if all tuple lengths are identical, False otherwise.\n    \"\"\"\n    if not list_of_tuples:\n        return True\n\n    first_tuple_length = len(list_of_tuples[0])\n    for i in range(1, len(list_of_tuples)):\n        if len(list_of_tuples[i]) != first_tuple_length:\n            return False\n    return True"}
{"task_id": "Mbpp/67", "solution": "class ValidationError(ValueError):\n    \"\"\"Domain-specific validation exception; subclass of ValueError.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass InputParameter:\n    \"\"\"Encapsulate the input value n and provide a convenience method for non-negativity check.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_non_negative(self) -> bool:\n        return self.value >= 0\n\nclass BellNumberResult:\n    \"\"\"Encapsulate the computed integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass BellNumberCalculator:\n    \"\"\"Validate input and compute exact Bell numbers using a deterministic table-based algorithm.\"\"\"\n    def bell_number(self, n: int) -> int:\n        \"\"\"Validate n and return the nth Bell number as int; raises ValidationError for invalid input.\"\"\"\n        self.validate_input(n)\n        result_value = self.compute_table(n)\n        return BellNumberResult(result_value).value\n\n    def compute_table(self, n: int) -> int:\n        \"\"\"Compute Bell triangle rows up to n and return the nth Bell number.\"\"\"\n        if n == 0:\n            return 1\n\n        # The Bell triangle method:\n        # triangle[i][0] = triangle[i-1][i-1] (first element of new row is last of previous row)\n        # triangle[i][j] = triangle[i][j-1] + triangle[i-1][j-1] for j > 0\n        # The Bell number B_n is triangle[n][0].\n        \n        triangle = [[0] * (i + 1) for i in range(n + 1)]\n        triangle[0][0] = 1\n\n        for i in range(1, n + 1):\n            triangle[i][0] = triangle[i-1][i-1]\n            for j in range(1, i + 1):\n                triangle[i][j] = triangle[i][j-1] + triangle[i-1][j-1]\n        \n        return triangle[n][0]\n\n    def validate_input(self, n: int) -> None:\n        \"\"\"Validate that n is an integer and non-negative; raises ValidationError if invalid.\"\"\"\n        # Type checking for 'n: int' is handled by static analysis/runtime,\n        # but the non-negativity check is explicit.\n        param = InputParameter(n)\n        if not param.is_non_negative():\n            raise ValidationError(f\"Input n must be a non-negative integer, but got {n}.\")\n\ndef bell_number(n: int) -> int:\n    \"\"\"Public API facade; delegates validation and computation to BellNumberCalculator.\"\"\"\n    return BellNumberCalculator().bell_number(n)"}
