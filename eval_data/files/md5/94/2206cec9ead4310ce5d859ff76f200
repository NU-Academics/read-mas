{"task_id": "Mbpp/445", "solution": "from typing import Tuple, Union\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation failures in tuple operations.\"\"\"\n    pass\n\nNumeric = Union[int, float]\nInnerTuple = Tuple[Numeric, Numeric]\nOuterTuple = Tuple[InnerTuple, ...]\nResultTuple = Tuple[InnerTuple, ...]\n\ndef _validate_outer_lengths(a: OuterTuple, b: OuterTuple) -> None:\n    \"\"\"Validates that the two outer tuples have the same length.\"\"\"\n    if len(a) != len(b):\n        raise ValidationError(\n            f\"Outer tuple lengths differ: len(a) is {len(a)}, len(b) is {len(b)}. \"\n            \"Both outer tuples must have the same number of inner tuples.\"\n        )\n\ndef _validate_inner_tuple(t: InnerTuple, position: int, side: str) -> None:\n    \"\"\"Validates that an inner tuple has exactly two numeric elements.\"\"\"\n    if not isinstance(t, tuple):\n        raise ValidationError(\n            f\"Invalid element at index {position} in tuple '{side}'. Expected a tuple, got {type(t)}.\"\n        )\n    if len(t) != 2:\n        raise ValidationError(\n            f\"Inner tuple at index {position} in tuple '{side}' must have exactly two elements, \"\n            f\"but found {len(t)} elements: {t}.\"\n        )\n    if not isinstance(t[0], (int, float)) or not isinstance(t[1], (int, float)):\n        raise ValidationError(\n            f\"Elements of inner tuple at index {position} in tuple '{side}' must be numeric (int or float). \"\n            f\"Found types {type(t[0])} and {type(t[1])} for elements {t[0]} and {t[1]}.\"\n        )\n\ndef _compute_products(a: OuterTuple, b: OuterTuple) -> ResultTuple:\n    \"\"\"Computes the element-wise product of corresponding inner tuples.\"\"\"\n    results = []\n    for i in range(len(a)):\n        product_x = a[i][0] * b[i][0]\n        product_y = a[i][1] * b[i][1]\n        results.append((product_x, product_y))\n    return tuple(results)\n\ndef index_multiplication(a: OuterTuple, b: OuterTuple) -> ResultTuple:\n    \"\"\"\n    Performs index-wise multiplication of tuple elements in two given tuples.\n    Validates inputs and returns a new tuple with the results.\n    \"\"\"\n    _validate_outer_lengths(a, b)\n\n    for i in range(len(a)):\n        _validate_inner_tuple(a[i], i, 'a')\n        _validate_inner_tuple(b[i], i, 'b')\n\n    return _compute_products(a, b)"}
{"task_id": "Mbpp/440", "solution": "import string\nimport re\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    An adverb is defined as a token whose core (after stripping leading/trailing punctuation) ends with \"ly\" (case-insensitive).\n    \"\"\"\n    _punctuation_chars = string.punctuation\n\n    def _strip_punctuation(raw_str: str) -> tuple[str, str, str]:\n        \"\"\"\n        Strips leading and trailing punctuation from a string.\n        Returns a tuple: (leading_punctuation, stripped_core, trailing_punctuation).\n        \"\"\"\n        leading_punct_len = 0\n        for char in raw_str:\n            if char in _punctuation_chars:\n                leading_punct_len += 1\n            else:\n                break\n        \n        temp_stripped = raw_str[leading_punct_len:]\n        \n        trailing_punct_len = 0\n        for i in range(len(temp_stripped) - 1, -1, -1):\n            if temp_stripped[i] in _punctuation_chars:\n                trailing_punct_len += 1\n            else:\n                break\n\n        leading_punct = raw_str[:leading_punct_len]\n        stripped_core = temp_stripped[:len(temp_stripped) - trailing_punct_len]\n        trailing_punct = temp_stripped[len(temp_stripped) - trailing_punct_len:]\n        \n        return leading_punct, stripped_core, trailing_punct\n\n    def _is_adverb(core: str) -> bool:\n        \"\"\"\n        Checks if a stripped core string is an adverb.\n        An adverb is a non-empty string ending with \"ly\" case-insensitively.\n        \"\"\"\n        return bool(core) and core.lower().endswith(\"ly\")\n\n    # Iterate through non-whitespace tokens to find the first adverb\n    for match in re.finditer(r'\\S+', sentence):\n        raw_token = match.group(0)\n        token_start_in_sentence = match.start()\n        \n        leading_punct, stripped_core, _ = _strip_punctuation(raw_token)\n        \n        if _is_adverb(stripped_core):\n            # Calculate the start and end indices of the adverb within the original sentence.\n            # start_index is the token's start plus the length of leading punctuation.\n            adverb_start_index = token_start_in_sentence + len(leading_punct)\n            # end_index is the adverb's start index plus its own length.\n            adverb_end_index = adverb_start_index + len(stripped_core)\n            \n            return (adverb_start_index, adverb_end_index, stripped_core)\n\n    return None"}
