{"task_id": "Mbpp/427", "solution": "import re\n\nclass Validator:\n    \"\"\"Validates date string format.\"\"\"\n    @staticmethod\n    def is_valid_format(input: str) -> bool:\n        \"\"\"Returns True if input matches yyyy-mm-dd pattern.\"\"\"\n        pattern = r\"^\\d{4}-\\d{2}-\\d{2}$\"\n        return re.match(pattern, input) is not None\n\nclass DateString:\n    \"\"\"Represents a date string and handles parsing and formatting.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n        self.year = \"\"\n        self.month = \"\"\n        self.day = \"\"\n\n    def parse(self) -> bool:\n        \"\"\"Parses the yyyy-mm-dd value into year, month, and day components.\"\"\"\n        parts = self.value.split('-')\n        self.year = parts[0]\n        self.month = parts[1]\n        self.day = parts[2]\n        return True\n\n    def to_dd_mm_yyyy(self) -> str:\n        \"\"\"Returns the date in dd-mm-yyyy format.\"\"\"\n        return f\"{self.day}-{self.month}-{self.year}\"\n\nclass DateConverter:\n    \"\"\"Orchestrates date format conversion.\"\"\"\n    def change_date_format(self, input: str) -> str:\n        \"\"\"Converts date from yyyy-mm-dd to dd-mm-yyyy.\"\"\"\n        # Validator is used per design, but error handling by raising exceptions is forbidden by requirements.\n        _ = Validator.is_valid_format(input)\n        \n        ds = DateString(input)\n        ds.parse()\n        \n        return ds.to_dd_mm_yyyy()\n\ndef change_date_format(input: str) -> str:\n    \"\"\"\n    Converts a date from yyyy-mm-dd format to dd-mm-yyyy format.\n    \"\"\"\n    return DateConverter().change_date_format(input)"}
{"task_id": "Mbpp/429", "solution": "class TupleElement:\n    \"\"\"Represents an individual element from a tuple.\"\"\"\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\n\nclass InputTuple:\n    \"\"\"A wrapper for input tuples.\"\"\"\n    def __init__(self, elements: tuple):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the tuple.\"\"\"\n        return len(self.elements)\n\nclass ResultTuple:\n    \"\"\"A wrapper for computed result tuples.\"\"\"\n    def __init__(self, elements: tuple):\n        self.elements = elements\n\nclass AndTuplesFunction:\n    \"\"\"Encapsulates validation and computation logic for element-wise bitwise AND.\"\"\"\n\n    def validateTypes(self, a: tuple, b: tuple) -> None:\n        \"\"\"Validates that inputs are tuples and their elements are integers.\"\"\"\n        if not isinstance(a, tuple) or not isinstance(b, tuple):\n            raise TypeError(\"Both inputs must be tuples.\")\n        \n        for element in a:\n            if not isinstance(element, int):\n                raise ValueError(\"All elements in the first tuple must be integers.\")\n        \n        for element in b:\n            if not isinstance(element, int):\n                raise ValueError(\"All elements in the second tuple must be integers.\")\n\n    def validateLengths(self, a: tuple, b: tuple) -> None:\n        \"\"\"Validates that both input tuples have the same length.\"\"\"\n        if len(a) != len(b):\n            raise ValueError(\"tuple lengths differ\")\n\n    def execute(self, a: tuple, b: tuple) -> tuple:\n        \"\"\"Orchestrates validation and computes element-wise bitwise AND.\"\"\"\n        self.validateTypes(a, b)\n        self.validateLengths(a, b)\n        \n        results = []\n        for i in range(len(a)):\n            results.append(a[i] & b[i])\n        \n        return tuple(results)\n\ndef and_tuples(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Computes the element-wise bitwise AND of two input tuples.\n    This function delegates to AndTuplesFunction for validation and computation.\n    \"\"\"\n    executor = AndTuplesFunction()\n    return executor.execute(a, b)"}
