{"task_id": "Mbpp/456", "solution": "from typing import List\n\nclass StringItem:\n    \"\"\"Encapsulates a string value and its reversed form.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n        self.reversedValue = \"\"\n\n    def reverse(self) -> str:\n        \"\"\"Computes, stores, and returns the character-wise reversal of the string.\"\"\"\n        self.reversedValue = self.value[::-1]\n        return self.reversedValue\n\nclass ReverseStringFunction:\n    \"\"\"Orchestrates the reversal of a list of strings using StringItem.\"\"\"\n    def __init__(self, input_list: List[str]) -> None:\n        self.inputList = input_list\n        self.outputList: List[str] = []\n\n    def execute(self) -> List[str]:\n        \"\"\"Iterates through input strings, reverses each, and collects results.\"\"\"\n        for value in self.inputList:\n            item = StringItem(value)\n            self.outputList.append(item.reverse())\n        return self.outputList\n\ndef reverse_string_list(input_list: List[str]) -> List[str]:\n    \"\"\"\n    Reverses each string in the given list of string values.\n    Delegates the processing to an internal ReverseStringFunction.\n    \"\"\"\n    processor = ReverseStringFunction(input_list)\n    return processor.execute()"}
{"task_id": "Mbpp/455", "solution": "class MonthChecker:\n    \"\"\"Encapsulates business logic to determine 31-day months based on the SRS.\"\"\"\n\n    _MONTH_DB: dict[int, bool] = {\n        1: True,\n        2: False,\n        3: True,\n        4: False,\n        5: True,\n        6: False,\n        7: True,\n        8: True,\n        9: False,\n        10: True,\n        11: False,\n        12: True\n    }\n\n    def check_monthnumb_number(self, month: int) -> bool:\n        \"\"\"Checks if the given month number has 31 days using the internal month database.\"\"\"\n        return self._MONTH_DB.get(month, False)\n\ndef check_monthnumb_number(month: int) -> bool:\n    \"\"\"\n    Checks whether the given month number contains 31 days or not.\n    This function delegates the actual logic to an internal MonthChecker instance.\n    \"\"\"\n    checker = MonthChecker()\n    return checker.check_monthnumb_number(month)"}
{"task_id": "Mbpp/454", "solution": "import string\nfrom typing import List\n\nclass Word:\n    \"\"\"Represents a word with its raw and cleaned text, and checks for 'z'.\"\"\"\n    def __init__(self, rawText: str) -> None:\n        self.rawText: str = rawText\n        self.cleanedText: str = \"\"\n\n    def stripPunctuation(self) -> str:\n        \"\"\"Removes leading/trailing punctuation from the raw text and stores it in cleanedText.\"\"\"\n        self.cleanedText = self.rawText.strip(string.punctuation)\n        return self.cleanedText\n\n    def hasZ(self) -> bool:\n        \"\"\"Checks if the cleaned text contains the lowercase letter 'z'.\"\"\"\n        return 'z' in self.cleanedText\n\nclass TextInput:\n    \"\"\"Holds the original input string and tokenizes it into Word objects.\"\"\"\n    def __init__(self, original: str) -> None:\n        self.original: str = original\n        self.tokens: List[Word] = []\n\n    def tokenize(self) -> List[Word]:\n        \"\"\"Tokenizes the original string into a list of Word objects.\"\"\"\n        self.tokens = _tokenize_text_internal(self.original)\n        return self.tokens\n\nclass MatchResult:\n    \"\"\"Data transfer object (DTO) for the result of a match operation.\"\"\"\n    def __init__(self, matched: bool, matchedWords: List[str]) -> None:\n        self.matched: bool = matched\n        self.matchedWords: List[str] = matchedWords\n\ndef _tokenize_text_internal(input_str: str) -> List[Word]:\n    \"\"\"Splits input into words, creates Word objects, and strips punctuation.\"\"\"\n    words: List[Word] = []\n    raw_tokens = input_str.split()\n    for raw_token in raw_tokens:\n        word = Word(raw_token)\n        word.stripPunctuation()\n        words.append(word)\n    return words\n\ndef findWords(input_str: str) -> List[Word]:\n    \"\"\"Returns a list of Word objects from the input string using TextInput.\"\"\"\n    text_input = TextInput(original=input_str)\n    return text_input.tokenize()\n\ndef text_match_wordz(input: str) -> bool:\n    \"\"\"\n    Checks if any word in the input string contains the lowercase letter 'z'.\n    Punctuation adjacent to words is ignored.\n    \"\"\"\n    words = findWords(input)\n    for word in words:\n        if word.hasZ():\n            return True\n    return False"}
