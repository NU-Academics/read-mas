{"task_id": "Mbpp/463", "solution": "def _validate_input(arr) -> None:\n    \"\"\"\n    Validates if the input is a non-empty list of integers.\n    Raises ValueError for invalid or empty input.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise ValueError(\"arr must be a list of integers\")\n    if not arr:\n        raise ValueError(\"arr must be a non-empty list of integers\")\n    for item in arr:\n        if not isinstance(item, int):\n            raise ValueError(\"arr must contain only integers\")\n\ndef _compute_max_product(arr: list[int]) -> int:\n    \"\"\"\n    Computes the maximum product of a contiguous subarray using a scanning algorithm.\n    It tracks current maximum and minimum products to correctly handle negative numbers.\n    \"\"\"\n    global_max = arr[0]\n    current_max = arr[0]\n    current_min = arr[0]\n\n    for x in arr[1:]:\n        # If the current number is negative, multiplying it with current_min might yield a new maximum,\n        # and with current_max a new minimum. So, we swap current_max and current_min before updates.\n        if x < 0:\n            current_max, current_min = current_min, current_max\n\n        # Update the maximum product ending at the current position.\n        # It's either the number itself, or the current_max product multiplied by the number.\n        current_max = max(x, current_max * x)\n        # Update the minimum product ending at the current position.\n        # It's either the number itself, or the current_min product multiplied by the number.\n        current_min = min(x, current_min * x)\n\n        # Update the overall maximum product found so far.\n        global_max = max(global_max, current_max)\n\n    return global_max\n\ndef max_subarray_product(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum product of any contiguous subarray within the given array.\n    This function handles positive, negative numbers, and zeros by tracking current max and min products.\n    \"\"\"\n    _validate_input(arr)\n    return _compute_max_product(arr)"}
{"task_id": "Mbpp/468", "solution": "import math\nfrom typing import List, Optional, Union\n\nclass Element:\n    \"\"\"Represents a single element with its value and position.\"\"\"\n    def __init__(self, value: Union[int, float], position: int):\n        self.value = float(value)\n        self.position = position\n\nclass ArrayInput:\n    \"\"\"Holds input array values.\"\"\"\n    def __init__(self, values: List[Union[int, float]]):\n        self.values = values\n\nclass Subsequence:\n    \"\"\"Represent contiguous subsequence and compute product / check rules.\"\"\"\n    def __init__(self, elements: List[Element]):\n        self.elements = elements\n\n    def isStrictlyIncreasing(self) -> bool:\n        if len(self.elements) <= 1:\n            return True\n        for i in range(len(self.elements) - 1):\n            if self.elements[i].value >= self.elements[i+1].value:\n                return False\n        return True\n\n    def isContiguous(self) -> bool:\n        if len(self.elements) <= 1:\n            return True\n        for i in range(len(self.elements) - 1):\n            if self.elements[i].position + 1 != self.elements[i+1].position:\n                return False\n        return True\n\n    def product(self) -> float:\n        if not self.elements:\n            return 0.0 # Define product of empty sequence as 0.0\n        res_product = 1.0\n        for element in self.elements:\n            res_product *= element.value\n        return res_product\n\nclass Result:\n    \"\"\"Domain holder for maximum product and producing subsequence.\"\"\"\n    def __init__(self, value: float, subsequence: Optional[Subsequence] = None):\n        self.value = value\n        self.subsequence = subsequence\n\nclass Validator:\n    \"\"\"Validate arr is numeric and non-empty.\"\"\"\n    def isNumericArray(self, arr_input: ArrayInput) -> bool:\n        if not isinstance(arr_input.values, list):\n            return False\n        return all(isinstance(v, (int, float)) for v in arr_input.values)\n\n    def isEmpty(self, arr_input: ArrayInput) -> bool:\n        return len(arr_input.values) == 0\n\nclass ProductCalculator:\n    \"\"\"Identify strictly increasing contiguous subsequences, compute products, select maximum product.\"\"\"\n    def __init__(self, arr_input: ArrayInput):\n        self._input_elements: List[Element] = [\n            Element(arr_input.values[i], i) for i in range(len(arr_input.values))\n        ]\n\n    def maxProduct(self) -> float:\n        max_prod = -math.inf\n        \n        all_subsequences = self.findSubsequences()\n\n        # If no subsequences were found (e.g., empty _input_elements),\n        # this path will result in -inf, which is correct for an empty set of products.\n        # However, the Validator should prevent empty array from reaching here.\n        \n        for sub_seq in all_subsequences:\n            # `findSubsequences` ensures contiguity and strict increase by its construction logic.\n            current_product = self.computeProduct(sub_seq)\n            if current_product > max_prod:\n                max_prod = current_product\n        \n        return max_prod\n\n    def findSubsequences(self) -> List[Subsequence]:\n        all_subsequences: List[Subsequence] = []\n        n = len(self._input_elements)\n        if n == 0:\n            return all_subsequences\n\n        start_index = 0\n        while start_index < n:\n            end_index = start_index\n            # Find the end of the current strictly increasing run\n            while end_index + 1 < n and self._input_elements[end_index + 1].value > self._input_elements[end_index].value:\n                end_index += 1\n\n            # The current run is from start_index to end_index (inclusive)\n            # Now, generate all contiguous slices (subsequences) within this run\n            for i in range(start_index, end_index + 1):\n                for j in range(i, end_index + 1):\n                    elements_in_slice = [\n                        self._input_elements[k] for k in range(i, j + 1)\n                    ]\n                    all_subsequences.append(Subsequence(elements_in_slice))\n\n            # Move to the next start_index (after the current run)\n            start_index = end_index + 1\n        return all_subsequences\n\n    def computeProduct(self, s: Subsequence) -> float:\n        return s.product()\n\ndef max_product(arr: List[Union[int, float]]) -> float:\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing\n    subsequence of that array.\n    \"\"\"\n    ai = ArrayInput(arr)\n    validator = Validator()\n\n    if not validator.isNumericArray(ai) or validator.isEmpty(ai):\n        raise ValueError(\"Input must be a non-empty numeric array\")\n\n    calc = ProductCalculator(ai)\n    return calc.maxProduct()"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    # This function computes the pairwise sum of neighboring elements in the input tuple.\n    # It returns a new tuple with the sums.\n    if len(input_tuple) < 2:\n        return ()\n\n    result_list = []\n    for i in range(len(input_tuple) - 1):\n        result_list.append(input_tuple[i] + input_tuple[i+1])\n    return tuple(result_list)"}
{"task_id": "Mbpp/471", "solution": "from typing import List\n\ndef _multiply(elements: List[int]) -> int:\n    \"\"\"Multiply integer elements and return product. Returns 1 for empty list.\"\"\"\n    product = 1\n    for x in elements:\n        product *= x\n    return product\n\ndef find_remainder(array: List[int], n: int) -> int:\n    \"\"\"Compute product of array elements and return product % n.\"\"\"\n    product = _multiply(array)\n    return product % n"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(input_list) -> bool:\n    \"\"\"Return True if input_list elements are consecutive integers with step=1 when interpreted as integers, else False.\n    Signature and name required by SRS (FR1).\"\"\"\n    if not input_list:\n        return False  # An empty list cannot contain consecutive numbers.\n    \n    # Interpret list elements as integers and sort them to check for consecutiveness.\n    # This handles lists that might be unordered or contain non-integer types that can be cast.\n    try:\n        sorted_list = sorted([int(x) for x in input_list])\n    except (ValueError, TypeError):\n        # If elements cannot be interpreted as integers, they cannot be consecutive integers.\n        return False\n\n    if len(sorted_list) <= 1:\n        return True # A list with 0 or 1 element is considered consecutive.\n\n    for i in range(len(sorted_list) - 1):\n        if sorted_list[i+1] - sorted_list[i] != 1:\n            return False\n    return True"}
{"task_id": "Mbpp/474", "solution": "class ValidationError(Exception):\n    \"\"\"Validation error for replace_char input checks.\"\"\"\n    def __init__(self, message: str):\n        self.message: str = message\n        super().__init__(message)\n    def __str__(self) -> str:\n        return self.message\n\ndef _validate_inputs(input, target, replacement) -> None:\n    \"\"\"Raises ValidationError if any argument violates BR5 (type/length checks).\"\"\"\n    if not isinstance(input, str):\n        raise ValidationError(\"input must be a string\")\n    if not isinstance(target, str) or len(target) != 1:\n        raise ValidationError(\"target must be a single-character string\")\n    if not isinstance(replacement, str) or len(replacement) != 1:\n        raise ValidationError(\"replacement must be a single-character string\")\n\ndef _perform_replacement(input, target, replacement) -> str:\n    \"\"\"Return a new string with all occurrences of target replaced by replacement.\"\"\"\n    return input.replace(target, replacement)\n\ndef replace_char(input, target, replacement) -> str:\n    \"\"\"Public API. Validates inputs and returns a new string with occurrences of target replaced by replacement.\"\"\"\n    _validate_inputs(input, target, replacement)\n    return _perform_replacement(input, target, replacement)"}
{"task_id": "Mbpp/473", "solution": "from typing import List, Set, Iterable, Any, Optional\n\ndef _normalize_tuple_key(elements: tuple) -> Any:\n    \"\"\"Produces a stable, order-insensitive key for a tuple, including its length.\"\"\"\n    return (len(elements), tuple(sorted(elements)))\n\nclass Tuple:\n    \"\"\"Represents an input tuple instance and provides a stable normalization key.\"\"\"\n    def __init__(self, elements: tuple) -> None:\n        self.elements = elements\n\n    def normalized_key(self) -> Any:\n        \"\"\"Returns the normalized key for the tuple.\"\"\"\n        return _normalize_tuple_key(self.elements)\n\nclass TupleList:\n    \"\"\"Wraps an iterable of tuple instances, preserving input order.\"\"\"\n    def __init__(self, items: Iterable[tuple], source: Optional[str] = None) -> None:\n        self.tuples: List[Tuple] = [Tuple(item) for item in items]\n        self.source = source\n\n    def unique_normalized_keys(self) -> Set[Any]:\n        \"\"\"Returns a set of unique normalized keys from the wrapped tuples.\"\"\"\n        return {t.normalized_key() for t in self.tuples}\n\nclass IntersectionResult:\n    \"\"\"Represents the returned set of tuples (tuple instances from list1).\"\"\"\n    def __init__(self) -> None:\n        self._tuples: Set[tuple] = set()\n        self._accepted_normalized_keys: Set[Any] = set()\n\n    def add(self, original_tuple: tuple, normalized_key: Any) -> None:\n        \"\"\"Adds a tuple to the result if its normalized key has not been accepted yet.\"\"\"\n        if normalized_key not in self._accepted_normalized_keys:\n            self._tuples.add(original_tuple)\n            self._accepted_normalized_keys.add(normalized_key)\n\n    def as_set(self) -> Set[tuple]:\n        \"\"\"Returns the underlying set of tuple instances.\"\"\"\n        return self._tuples\n\nclass TupleIntersectionService:\n    \"\"\"Orchestrates finding the intersection of two lists of tuples.\"\"\"\n    def tuple_intersection(self, list1: Iterable[tuple], list2: Iterable[tuple]) -> Set[tuple]:\n        \"\"\"Finds the tuple intersection based on normalized keys.\"\"\"\n        tuple_list1 = TupleList(list1, source=\"first\")\n        tuple_list2 = TupleList(list2, source=\"second\")\n\n        list2_normalized_keys_set = tuple_list2.unique_normalized_keys()\n        result = IntersectionResult()\n\n        for t_obj in tuple_list1.tuples:\n            current_normalized_key = t_obj.normalized_key()\n            if current_normalized_key in list2_normalized_keys_set:\n                result.add(t_obj.elements, current_normalized_key)\n\n        return result.as_set()\n\ndef tuple_intersection(list1: List[tuple], list2: List[tuple]) -> Set[tuple]:\n    \"\"\"\n    Finds the tuple intersection of elements in the given tuple list irrespective of their order.\n    assert tuple_intersection([(3, 4), (5, 6), (9, 10), (4, 5)] , [(5, 4), (3, 4), (6, 5), (9, 11)]) == {(4, 5), (3, 4), (5, 6)}\n    \"\"\"\n    service = TupleIntersectionService()\n    return service.tuple_intersection(list1, list2)"}
