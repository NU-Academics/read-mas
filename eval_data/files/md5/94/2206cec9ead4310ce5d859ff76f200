{"task_id": "Mbpp/588", "solution": "class ErrorHandler:\n    \"\"\"Helper class to handle validation errors.\"\"\"\n    @staticmethod\n    def handle_empty_list(values):\n        \"\"\"Raises ValueError for an empty input list.\"\"\"\n        raise ValueError(\"Input list must contain at least one numeric value\")\n\n    @staticmethod\n    def handle_non_numeric(values):\n        \"\"\"Raises TypeError if any element in the list is not numeric.\"\"\"\n        raise TypeError(\"All elements of input list must be numeric (int or float)\")\n\ndef big_diff(values: list[float | int]) -> float | int:\n    \"\"\"\n    Finds the difference between the largest and smallest value in a given list.\n    Validates input for non-empty and numeric-only elements.\n    \"\"\"\n    if not values:\n        ErrorHandler.handle_empty_list(values)\n\n    for item in values:\n        if not isinstance(item, (int, float)):\n            ErrorHandler.handle_non_numeric(values)\n\n    return max(values) - min(values)"}
{"task_id": "Mbpp/589", "solution": "import math\nfrom typing import List\n\nclass Validator:\n    \"\"\"Encapsulates input validation logic for a range.\"\"\"\n    def validateRange(self, start: int, end: int) -> None:\n        if not isinstance(start, int) or not isinstance(end, int):\n            raise ValueError(\"Start and end must be integers.\")\n        if start > end:\n            raise ValueError(\"Start must be less than or equal to end.\")\n\nclass ResultList:\n    \"\"\"Collects and provides ordered perfect squares.\"\"\"\n    def __init__(self):\n        self._items: List[int] = []\n\n    def add(self, n: int) -> None:\n        self._items.append(n)\n\n    def toList(self) -> List[int]:\n        return self._items\n\nclass PerfectSquaresService:\n    \"\"\"Orchestrates the finding of perfect squares within a range.\"\"\"\n    def perfect_squares(self, start: int, end: int) -> List[int]:\n        validator = Validator()\n        validator.validateRange(start, end)\n\n        result_list = ResultList()\n\n        # Determine effective start for sqrt calculation, ensuring non-negativity\n        effective_start_for_sqrt = max(0, start)\n\n        # Calculate the integer square root bounds\n        k_start = math.ceil(math.sqrt(effective_start_for_sqrt))\n        k_end = math.floor(math.sqrt(end))\n\n        # Iterate through possible integer roots and add their squares if within the original range\n        for k in range(k_start, k_end + 1):\n            square = k * k\n            if start <= square <= end:\n                result_list.add(square)\n        \n        return result_list.toList()\n\ndef perfect_squares(start: int, end: int) -> List[int]:\n    \"\"\"\n    Finds perfect squares between two given numbers, inclusive.\n    Raises ValueError for invalid inputs (non-integers or start > end).\n    \"\"\"\n    service = PerfectSquaresService()\n    return service.perfect_squares(start, end)"}
{"task_id": "Mbpp/591", "solution": "def swap_List(input: list) -> list:\n    \"Swap first and last elements of input list per SRS.\"\n    if not isinstance(input, list):\n        raise TypeError(\"input must be a list\")\n    if len(input) < 2:\n        return input\n    \n    # Create a new list with the last element first,\n    # followed by the middle elements, and then the first element last.\n    return [input[-1]] + input[1:-1] + [input[0]]"}
{"task_id": "Mbpp/590", "solution": "import math\n\ndef polar_rect(a: float, b: float, mode: str = \"auto\") -> tuple:\n    \"\"\"\n    Converts between polar and rectangular coordinates based on the specified mode.\n    Raises ValueError if 'auto' mode is used without an explicit conversion.\n    \"\"\"\n    if mode == \"polar_to_rect\":\n        r = a\n        theta = b\n        x = r * math.cos(theta)\n        y = r * math.sin(theta)\n        # Returns a tuple of (polar coordinates, complex rectangular representation)\n        return ((r, theta), complex(x, y))\n    elif mode == \"rect_to_polar\":\n        x = a\n        y = b\n        r = math.sqrt(x*x + y*y)\n        theta = math.atan2(y, x)\n        # Returns a tuple of (polar coordinates, rectangular coordinates)\n        return ((r, theta), (x, y))\n    elif mode == \"auto\":\n        raise ValueError(\"Mode 'auto' is ambiguous; please specify 'polar_to_rect' or 'rect_to_polar'.\")\n    else:\n        raise ValueError(f\"Invalid mode '{mode}'. Expected 'polar_to_rect', 'rect_to_polar', or 'auto'.\")"}
{"task_id": "Mbpp/592", "solution": "try:\n    from math import comb as _math_comb\nexcept ImportError:\n    _math_comb = None\n\nimport math\n\ndef C(n: int, k: int) -> int:\n    \"Return exact integer binomial coefficient C(n, k).\"\n    if _math_comb:\n        return _math_comb(n, k)\n    else:\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        return math.factorial(n) // (math.factorial(k) * math.factorial(n - k))\n\ndef sum_Of_product(n: int) -> int:\n    \"Validate n and return S(n) = sum_{k=0}^{n-1} C(n,k) * C(n,k+1).\"\n    if n < 0:\n        raise ValueError(\"n must be non-negative.\")\n    if n == 0:\n        return 0\n\n    total_sum = 0\n    for k in range(n):\n        total_sum += C(n, k) * C(n, k + 1)\n    return total_sum"}
{"task_id": "Mbpp/593", "solution": "class Octet:\n    \"\"\"Represents a single octet of an IP address and provides leading-zero stripping logic.\"\"\"\n    def __init__(self, text: str, position: int):\n        self.text = text\n        self.position = position\n\n    def stripLeadingZeros(self) -> str:\n        \"\"\"Returns the normalized octet string with leading zeros removed, returning '0' for zero-only octets.\"\"\"\n        stripped = self.text.lstrip('0')\n        if not stripped:\n            return '0'\n        return stripped\n\nclass IPAddress:\n    \"\"\"Parses a dotted string into Octet objects and produces a normalized dotted string.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n        self.octets: list[Octet] = []\n        self.normalized: str = \"\"\n\n    def parse(self) -> list[Octet]:\n        \"\"\"Splits the raw IP string by '.' and constructs Octet instances.\"\"\"\n        parts = self.raw.split('.')\n        self.octets = [Octet(part, i + 1) for i, part in enumerate(parts)]\n        return self.octets\n\n    def normalize(self) -> str:\n        \"\"\"Calls stripLeadingZeros() on each Octet and joins results with '.'.\"\"\"\n        normalized_parts = [octet.stripLeadingZeros() for octet in self.octets]\n        self.normalized = \".\".join(normalized_parts)\n        return self.normalized\n\ndef removezero_ip(ip_address: str) -> str:\n    \"\"\"Removes leading zeros from each octet in a dotted-decimal IPv4 address.\"\"\"\n    ip = IPAddress(ip_address)\n    ip.parse()\n    return ip.normalize()"}
{"task_id": "Mbpp/594", "solution": "def _find_first_even(nums: list[int]) -> int | None:\n    \"\"\"Finds the first even number in a list of integers, scanning left-to-right.\"\"\"\n    for num in nums:\n        if num % 2 == 0:\n            return num\n    return None\n\ndef _find_first_odd(nums: list[int]) -> int | None:\n    \"\"\"Finds the first odd number in a list of integers, scanning left-to-right.\"\"\"\n    for num in nums:\n        if num % 2 != 0:\n            return num\n    return None\n\ndef diff_even_odd(nums: list[int]) -> int:\n    \"\"\"\n    Finds the difference between the first even and first odd number of a given list.\n    It scans the list left-to-right to locate both numbers.\n    \"\"\"\n    first_even = _find_first_even(nums)\n    first_odd = _find_first_odd(nums)\n    return first_even - first_odd"}
