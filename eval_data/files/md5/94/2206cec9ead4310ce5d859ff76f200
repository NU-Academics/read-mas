{"task_id": "Mbpp/608", "solution": "class InputValidator:\n    \"\"\"Checks if n is a non-negative integer.\"\"\"\n    def is_non_negative_integer(self, n) -> bool:\n        return isinstance(n, int) and n >= 0\n\nclass BellNumberCalculator:\n    \"\"\"Computes the nth Bell number using the Bell triangle method.\"\"\"\n    def bell_Number(self, n: int) -> int:\n        if n == 0:\n            return 1\n\n        bell_triangle = [[0] * (n + 1) for _ in range(n + 1)]\n        bell_triangle[0][0] = 1 # B_0\n\n        for i in range(1, n + 1):\n            # The first element of row i is the last element of row i-1\n            bell_triangle[i][0] = bell_triangle[i-1][i-1]\n            for j in range(1, i + 1):\n                # Subsequent elements in row i\n                bell_triangle[i][j] = bell_triangle[i][j-1] + bell_triangle[i-1][j-1]\n\n        return bell_triangle[n][0]\n\ndef bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number.\n    Raises ValueError if n is not a non-negative integer.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.is_non_negative_integer(n):\n        raise ValueError(\"n must be a non-negative integer\")\n\n    calculator = BellNumberCalculator()\n    return calculator.bell_Number(n)"}
{"task_id": "Mbpp/612", "solution": "def merge(input_list: list) -> list:\n    \"\"\"\n    Splits a list of 2-element sublists into two separate lists.\n    The first output list contains all first elements, and the second contains all second elements.\n    \"\"\"\n    first_elements = [pair[0] for pair in input_list]\n    second_elements = [pair[1] for pair in input_list]\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix, n):\n    \"\"\"\n    Returns the maximum value in the nth column of a matrix.\n    Raises TypeError for invalid input types and ValueError for an empty column.\n    \"\"\"\n    def _validate_inputs(matrix, n):\n        \"\"\"Validates that matrix is a list of lists and n is an integer.\"\"\"\n        if not isinstance(matrix, list):\n            raise TypeError(\"matrix must be a list\")\n        for i, row in enumerate(matrix):\n            if not isinstance(row, list):\n                raise TypeError(f\"matrix row {i} must be a list\")\n        if not isinstance(n, int):\n            raise TypeError(\"n must be an integer\")\n\n    def _extract_nth_column(matrix, n):\n        \"\"\"Extracts values from the nth column, skipping rows that don't have it.\"\"\"\n        column_values = []\n        for row in matrix:\n            if len(row) > n:\n                column_values.append(row[n])\n        return column_values\n\n    def _compute_max(values):\n        \"\"\"Computes the maximum of a list of values, raising ValueError if empty.\"\"\"\n        if not values:\n            raise ValueError(\"No values found in the specified column to compute maximum.\")\n        return max(values)\n\n    _validate_inputs(matrix, n)\n    column_values = _extract_nth_column(matrix, n)\n    return _compute_max(column_values)"}
{"task_id": "Mbpp/614", "solution": "def _validate_list_of_tuples(list_of_tuples):\n    \"\"\"\n    Internal helper. Validates that the input is a list of tuples containing numeric values.\n    Raises TypeError or ValueError on validation failure.\n    \"\"\"\n    if not isinstance(list_of_tuples, list):\n        raise TypeError('Input must be a list of tuples per BR2')\n    for idx, element in enumerate(list_of_tuples):\n        if not isinstance(element, tuple):\n            raise TypeError(f'Element at index {idx} is not a tuple')\n        for jdx, value in enumerate(element):\n            if not isinstance(value, (int, float)):\n                raise ValueError(f'Value at index {idx},{jdx} is not numeric')\n    return True\n\ndef cummulative_sum(list_of_tuples):\n    \"\"\"\n    Computes and returns the numeric sum of every numeric value contained in all tuples.\n    This function validates its input before computation.\n    \"\"\"\n    _validate_list_of_tuples(list_of_tuples)\n    total = 0\n    for tup in list_of_tuples:\n        for v in tup:\n            total += v\n    return total"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(tuple_of_tuples):\n    \"\"\"\n    Computes the average value for each column across the inner tuples.\n    Returns a list of floating-point averages, preserving column order.\n    \"\"\"\n    num_rows = len(tuple_of_tuples)\n    num_cols = len(tuple_of_tuples[0])\n\n    averages = []\n\n    for col_idx in range(num_cols):\n        column_sum = 0\n        for row_idx in range(num_rows):\n            column_sum += tuple_of_tuples[row_idx][col_idx]\n        \n        average = float(column_sum) / num_rows\n        averages.append(average)\n        \n    return averages"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(left: tuple, right: tuple) -> tuple:\n    \"\"\"Compute element-wise modulo of two tuples.\n\n    Validation order:\n      1) Validate both left and right are instances of built-in tuple -> otherwise raise TypeError\n      2) Validate len(left) == len(right) -> otherwise raise ValueError\n      3) Validate every element of left and right is an int (isinstance(elem, int)) -> otherwise raise TypeError\n      4) Validate no element in right is zero -> otherwise raise ZeroDivisionError\n      5) Compute result tuple: tuple(left[i] % right[i] for i in range(len(left))) using Python's % semantics\n\n    Returns:\n      tuple of ints with same length as inputs\n\n    Raises:\n      TypeError, ValueError, ZeroDivisionError as specified.\n    \"\"\"\n    if not isinstance(left, tuple) or not isinstance(right, tuple):\n        raise TypeError(\"Inputs must be tuples.\")\n\n    if len(left) != len(right):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    for i in range(len(left)):\n        if not isinstance(left[i], int) or not isinstance(right[i], int):\n            raise TypeError(\"All elements in both tuples must be integers.\")\n        if right[i] == 0:\n            raise ZeroDivisionError(\"Divisor tuple 'right' cannot contain zero.\")\n\n    return tuple(left[i] % right[i] for i in range(len(left)))"}
{"task_id": "Mbpp/618", "solution": "from typing import List, Union\n\nNumber = Union[int, float]\nInputList = List[Number]\nResultList = List[float]\n\ndef div_list(a: InputList, b: InputList) -> ResultList:\n    \"\"\"Compute element-wise true (floating-point) division per SRS.\n\n    Raises ValueError if lengths differ.\n    \"\"\"\n    if len(a) != len(b):\n        raise ValueError(\"input lists must have equal length\")\n    \n    return [float(x) / float(y) for x, y in zip(a, b)]"}
{"task_id": "Mbpp/620", "solution": "def _build_divisibility_graph(sorted_numbers: list[int]) -> dict[int, list[int]]:\n    \"\"\"Builds an adjacency map where keys are indices and values are lists of earlier indices that divide the number at the key index.\"\"\"\n    n = len(sorted_numbers)\n    adjacency_map: dict[int, list[int]] = {i: [] for i in range(n)}\n\n    for i in range(n):\n        for j in range(i):\n            if sorted_numbers[j] != 0 and sorted_numbers[i] % sorted_numbers[j] == 0:\n                adjacency_map[i].append(j)\n    return adjacency_map\n\ndef _longest_chain_dp(sorted_numbers: list[int]) -> int:\n    \"\"\"Computes the maximum chain length using dynamic programming, where each element in a chain divides the next.\"\"\"\n    if not sorted_numbers:\n        return 0\n    if len(sorted_numbers) == 1:\n        return 1\n\n    n = len(sorted_numbers)\n    # dp[i] stores the length of the longest divisible subset ending with sorted_numbers[i]\n    dp = [1] * n\n\n    for i in range(1, n):\n        for j in range(i):\n            if sorted_numbers[j] != 0 and sorted_numbers[i] % sorted_numbers[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n    \n    return max(dp)\n\ndef largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers so that every pair is divisible.\n    The implementation sorts the numbers and uses dynamic programming.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    sorted_numbers = sorted(numbers)\n\n    # As per the design, _build_divisibility_graph is called, but its result is not used by _longest_chain_dp\n    # due to the specified signature of _longest_chain_dp which does not accept an adjacency map.\n    # _longest_chain_dp calculates divisibility relationships internally.\n    _ = _build_divisibility_graph(sorted_numbers)\n\n    return _longest_chain_dp(sorted_numbers)"}
{"task_id": "Mbpp/619", "solution": "class InputString:\n    \"\"\"Represents the input string value.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input string.\"\"\"\n        return len(self.value)\n\nclass NonDigitCollection:\n    \"\"\"Collects non-digit characters while preserving order.\"\"\"\n    def __init__(self):\n        self._chars = []\n\n    def append(self, c: str) -> None:\n        \"\"\"Appends a character to the collection.\"\"\"\n        self._chars.append(c)\n\n    def as_string(self) -> str:\n        \"\"\"Returns the collected characters as a single string.\"\"\"\n        return \"\".join(self._chars)\n\nclass DigitCollection:\n    \"\"\"Collects digit characters while preserving order.\"\"\"\n    def __init__(self):\n        self._digits = []\n\n    def append(self, d: str) -> None:\n        \"\"\"Appends a digit character to the collection.\"\"\"\n        self._digits.append(d)\n\n    def as_string(self) -> str:\n        \"\"\"Returns the collected digits as a single string.\"\"\"\n        return \"\".join(self._digits)\n\nclass OutputString:\n    \"\"\"Represents the resulting output string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass MoveNumFunction:\n    \"\"\"Encapsulates the algorithm to separate non-digits and digits.\"\"\"\n    def execute(self, input_obj: InputString) -> OutputString:\n        \"\"\"Processes the input string to move digits to the end.\"\"\"\n        non_digits = NonDigitCollection()\n        digits = DigitCollection()\n\n        for char in input_obj.value:\n            if char.isdigit():\n                digits.append(char)\n            else:\n                non_digits.append(char)\n\n        result_string = non_digits.as_string() + digits.as_string()\n        return OutputString(result_string)\n\ndef move_num(input_string: str) -> str:\n    \"\"\"\n    Moves all digit characters to the end of the given string, preserving\n    the relative order of both non-digits and digits.\n    \"\"\"\n    input_obj = InputString(input_string)\n    move_func = MoveNumFunction()\n    output_obj = move_func.execute(input_obj)\n    return output_obj.value"}
{"task_id": "Mbpp/623", "solution": "class ValidationError(Exception):\n    pass\n\nclass ErrorHandler:\n    def raise_type_error(self, message):\n        raise ValidationError(message)\n\nclass MathEngine:\n    def pow(self, value, exponent):\n        return pow(value, exponent)\n\nclass NumbersList:\n    def __init__(self, numbers):\n        self.numbers = numbers\n\n    def is_empty(self):\n        return len(self.numbers) == 0\n\n    # This method is part of the design but not explicitly called in the final orchestration flow.\n    def validate_elements_are_numeric(self, error_handler):\n        for element in self.numbers:\n            if not isinstance(element, (int, float)):\n                error_handler.raise_type_error(\"numbers must contain only numeric elements\")\n\nclass Exponent:\n    def __init__(self, n):\n        self.n = n\n\n    # This method is part of the design but not explicitly called in the final orchestration flow.\n    def validate_is_integer(self, error_handler):\n        if not isinstance(self.n, int):\n            error_handler.raise_type_error(\"n must be an integer\")\n\nclass ResultList:\n    def __init__(self):\n        self.results = []\n\n    def append(self, value):\n        self.results.append(value)\n\nclass Validator:\n    def __init__(self, error_handler: ErrorHandler = None):\n        self.error_handler = error_handler or ErrorHandler()\n\n    def validate(self, numbers, n):\n        if not isinstance(numbers, list):\n            self.error_handler.raise_type_error(\"numbers must be a list\")\n        \n        if not isinstance(n, int):\n            self.error_handler.raise_type_error(\"n must be an integer\")\n\n        for element in numbers:\n            if not isinstance(element, (int, float)):\n                self.error_handler.raise_type_error(\"numbers must contain only numeric elements\")\n\ndef nth_nums(numbers, n):\n    error_handler = ErrorHandler()\n    validator = Validator(error_handler)\n    \n    validator.validate(numbers, n)\n\n    numbers_list = NumbersList(numbers)\n    exponent_obj = Exponent(n)\n\n    if numbers_list.is_empty():\n        return []\n\n    math_engine = MathEngine()\n    result_list = ResultList()\n\n    for x in numbers_list.numbers:\n        result_list.append(math_engine.pow(x, exponent_obj.n))\n    \n    return result_list.results"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1, list2, n):\n    \"\"\"\n    Finds the median of two sorted lists of the same size n.\n    Assumes lists are sorted, contain n numeric elements, and n > 0.\n    \"\"\"\n    i = 0  # Pointer for list1\n    j = 0  # Pointer for list2\n\n    m1 = -1  # Stores the element at combined index n-1\n    m2 = -1  # Stores the element at combined index n\n\n    # Iterate n+1 times to find the elements at indices n-1 and n (0-indexed)\n    # in the conceptually merged sorted list of 2n elements.\n    for count in range(n + 1):\n        if i == n: # list1 is exhausted\n            m1 = m2\n            m2 = list2[j]\n            j += 1\n        elif j == n: # list2 is exhausted\n            m1 = m2\n            m2 = list1[i]\n            i += 1\n        elif list1[i] <= list2[j]:\n            m1 = m2\n            m2 = list1[i]\n            i += 1\n        else: # list2[j] is smaller\n            m1 = m2\n            m2 = list2[j]\n            j += 1\n    \n    # The median for an even number of elements (2n) is the average\n    # of the two middle elements (at combined indices n-1 and n).\n    return float(m1 + m2) / 2.0"}
