{"task_id": "Mbpp/598", "solution": "from typing import List\n\ndef armstrong_number(n: int) -> bool:\n    \"\"\"\n    Checks whether the given number is an Armstrong number.\n    An Armstrong number equals the sum of its digits each raised to the power of the count of digits.\n    \"\"\"\n    if n < 0:\n        return False\n\n    def digits(num: int) -> List[int]:\n        \"\"\"\n        Extracts decimal digits of num as a list of ints (most-significant to least-significant).\n        \"\"\"\n        return [int(d) for d in str(num)]\n\n    def compute_sum_of_powers(num: int) -> int:\n        \"\"\"\n        Returns sum(digit ** digit_count for each decimal digit of num).\n        \"\"\"\n        digit_list = digits(num)\n        digit_count = len(digit_list)\n        total_sum = 0\n        for digit in digit_list:\n            total_sum += digit ** digit_count\n        return total_sum\n\n    return n == compute_sum_of_powers(n)"}
{"task_id": "Mbpp/597", "solution": "from typing import List, Any, TypeVar\n\nElement = TypeVar('Element')\n\nclass InvalidKException(Exception):\n    \"\"\"Domain-specific exception for invalid k.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef validateInputs(arrA: List, arrB: List, k: int) -> None:\n    \"\"\"\n    Validates the input k against the combined length of the arrays.\n    Raises InvalidKException if k is out of bounds.\n    \"\"\"\n    m = len(arrA)\n    n = len(arrB)\n    if k < 1 or k > m + n:\n        raise InvalidKException(f\"k ({k}) must be between 1 and {m + n} (inclusive).\")\n\ndef computeKth(arrA: List[Element], arrB: List[Element], k: int) -> Element:\n    \"\"\"\n    Computes the kth smallest element from two sorted arrays using a merge-like approach.\n    It assumes k is valid (1-based) and accesses arrays in a read-only manner.\n    \"\"\"\n    m, n = len(arrA), len(arrB)\n    ptr_a, ptr_b = 0, 0\n    kth_element = None\n\n    # Iterate k times to find the kth smallest element\n    for _ in range(k):\n        # Case 1: arrA is exhausted or current element in arrB is smaller (if arrB has elements)\n        if ptr_a == m:\n            kth_element = arrB[ptr_b]\n            ptr_b += 1\n        # Case 2: arrB is exhausted or current element in arrA is smaller (if arrA has elements)\n        elif ptr_b == n:\n            kth_element = arrA[ptr_a]\n            ptr_a += 1\n        # Case 3: Both arrays have elements, compare them\n        elif arrA[ptr_a] <= arrB[ptr_b]:\n            kth_element = arrA[ptr_a]\n            ptr_a += 1\n        else: # arrB[ptr_b] < arrA[ptr_a]\n            kth_element = arrB[ptr_b]\n            ptr_b += 1\n            \n    return kth_element\n\ndef find_kth(arrA: List[Element], arrB: List[Element], k: int) -> Element:\n    \"\"\"\n    Finds the kth smallest element from two given sorted arrays.\n    It validates inputs and then computes the kth element using a merge-like strategy.\n    \"\"\"\n    validateInputs(arrA, arrB, k)\n    return computeKth(arrA, arrB, k)"}
{"task_id": "Mbpp/599", "solution": "from dataclasses import dataclass\nfrom typing import Tuple\n\n@dataclass\nclass Result:\n    \"\"\"Internal dataclass to hold sum and average values.\"\"\"\n    sum: int\n    average: float\n\ndef _validate_n(n) -> None:\n    \"\"\"Checks if n is a positive integer. Raises ValueError if validation fails.\"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\ndef _compute_sum(n) -> int:\n    \"\"\"Computes the sum of the first n natural numbers using the formula.\"\"\"\n    return n * (n + 1) // 2\n\ndef sum_average(n) -> Tuple[int, float]:\n    \"\"\"Calculates the sum and average of the first n natural numbers.\"\"\"\n    _validate_n(n)\n    total_sum = _compute_sum(n)\n    average = total_sum / n\n    return (total_sum, average)"}
