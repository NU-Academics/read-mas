{"task_id": "Mbpp/94", "solution": "def index_minimum(list_of_tuples):\n    \"\"\"\n    Precondition: list_of_tuples is a non-empty list of 2-element tuples (first, second)\n    and all second elements are mutually comparable by natural ordering.\n    Returns: the first element of the tuple whose second element is minimal.\n    \"\"\"\n    min_tuple = min(list_of_tuples, key=lambda x: x[1])\n    return min_tuple[0]"}
{"task_id": "Mbpp/93", "solution": "def validate_inputs(a, b):\n    \"\"\"Checks if both inputs are numeric (int or float).\"\"\"\n    return isinstance(a, (int, float)) and isinstance(b, (int, float))\n\ndef compute(a, b):\n    \"\"\"Performs the exponentiation a to the power of b.\"\"\"\n    return a ** b\n\ndef power(a, b):\n    \"\"\"\n    Calculates the value of 'a' to the power 'b'.\n    Raises ValueError if inputs are not numeric.\n    \"\"\"\n    if not validate_inputs(a, b):\n        raise ValueError(\"Parameters a and b must be numeric (int or float)\")\n    return compute(a, b)"}
{"task_id": "Mbpp/92", "solution": "from typing import List, Set, Union, Any, Optional\n\nclass NumberInput:\n    \"\"\"Encapsulates raw input and provides digit extraction, preserving leading zeros for strings.\"\"\"\n    def __init__(self, raw_input: Any):\n        self.raw = raw_input\n        self.converted_abs_int: Optional[int] = None\n        try:\n            if isinstance(raw_input, str):\n                self.converted_abs_int = abs(int(raw_input))\n            elif isinstance(raw_input, int):\n                self.converted_abs_int = abs(raw_input)\n        except (ValueError, TypeError):\n            self.converted_abs_int = None\n\n    def getDigits(self) -> List[int]:\n        \"\"\"Returns ordered digits, preserving leading zeros for string inputs.\"\"\"\n        # If conversion to int failed, there are no valid digits to extract.\n        if self.converted_abs_int is None:\n            return []\n\n        if isinstance(self.raw, str):\n            # Preserve leading zeros from string representation.\n            # Remove any potential leading negative sign before converting to digits.\n            num_str = self.raw.lstrip('-')\n            # This safeguard handles cases where a string might contain non-digits\n            # after the sign, though UndulatingChecker.validate should catch it first.\n            if not num_str.isdigit():\n                return []\n            return [int(d) for d in num_str]\n        elif isinstance(self.raw, int):\n            # For integer inputs, leading zeros are not applicable.\n            if self.raw == 0:\n                return [0]\n            return [int(d) for d in str(abs(self.raw))]\n        return [] # Should not be reached if validation is performed correctly\n\nclass DigitSequence:\n    \"\"\"Holds an ordered list of digits and provides queries.\"\"\"\n    def __init__(self, digits: List[int]):\n        self.digits = digits\n        self.length = len(digits)\n\n    def distinctDigits(self) -> Set[int]:\n        \"\"\"Returns a set of distinct digit values in the sequence.\"\"\"\n        return set(self.digits)\n\nclass UndulatingChecker:\n    \"\"\"Validates NumberInput and evaluates the undulating condition.\"\"\"\n    def validate(self, number_input: NumberInput) -> bool:\n        \"\"\"Returns True if the input is convertible to an integer and formatted correctly.\"\"\"\n        # An input is invalid if it could not be converted to an absolute integer.\n        if number_input.converted_abs_int is None:\n            return False\n\n        # For string inputs, ensure that after stripping a potential sign, it consists only of digits.\n        if isinstance(number_input.raw, str):\n            processed_str = number_input.raw.lstrip('-')\n            if not processed_str.isdigit():\n                return False\n        return True\n\n    def isUndulating(self, number_input: NumberInput) -> bool:\n        \"\"\"Evaluates if the given NumberInput's digits form an undulating sequence.\"\"\"\n        digits = number_input.getDigits()\n        \n        digit_sequence = DigitSequence(digits)\n\n        # BR4: Single-digit numbers are not undulating.\n        if digit_sequence.length < 2:\n            return False\n\n        distinct_digits = digit_sequence.distinctDigits()\n        # BR4: Numbers without exactly two distinct digits are not undulating.\n        if len(distinct_digits) != 2:\n            return False\n\n        # Get the two distinct digits from the set. Their initial order is arbitrary.\n        distinct_list = list(distinct_digits)\n        d1 = distinct_list[0]\n        d2 = distinct_list[1]\n\n        # Determine the expected alternating pattern based on the first digit of the sequence.\n        first_pattern_digit = digits[0]\n        second_pattern_digit: int\n        if first_pattern_digit == d1:\n            second_pattern_digit = d2\n        elif first_pattern_digit == d2:\n            second_pattern_digit = d1\n        else:\n            # This case should ideally not be reachable if len(distinct_digits) == 2 and digits is not empty,\n            # as digits[0] must be one of the two distinct digits. Included for robustness.\n            return False\n\n        # Verify the alternation pattern throughout the entire sequence.\n        for i in range(digit_sequence.length):\n            if i % 2 == 0: # Even indices should match the first pattern digit\n                if digit_sequence.digits[i] != first_pattern_digit:\n                    return False\n            else: # Odd indices should match the second pattern digit\n                if digit_sequence.digits[i] != second_pattern_digit:\n                    return False\n        \n        return True\n\nclass CheckResult:\n    \"\"\"A simple DTO for carrying evaluation results and reasons.\"\"\"\n    def __init__(self, isUndulating: bool, reason: str = \"\"):\n        self.isUndulating = isUndulating\n        self.reason = reason\n\ndef is_undulating(number: Union[int, str]) -> bool:\n    \"\"\"\n    Checks whether the given number is undulating.\n    A number is undulating if its digits alternate between exactly two distinct digits for the entire length.\n    \"\"\"\n    number_input = NumberInput(number)\n    checker = UndulatingChecker()\n\n    # Per design, invalid or non-conforming inputs return False.\n    if not checker.validate(number_input):\n        return False\n    \n    return checker.isUndulating(number_input)"}
