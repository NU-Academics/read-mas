{"task_id": "Mbpp/3", "solution": "def is_not_prime(n: int) -> bool:\n    \"\"\"Return True if n is NOT a prime, False if n is prime.\n\n    Behavior per SRS/BR5: integers <= 1 are considered non-prime; primes (including 2) return False.\n    \"\"\"\n    def _is_prime(num: int) -> bool:\n        \"\"\"Internal helper implementing prime test per BR5.\n        Returns True if num is prime, else False.\n        \"\"\"\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    return not _is_prime(n)"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List\n\nclass NumberList:\n    \"\"\"Container representing the input list of integers.\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self.values = values\n\n    def as_list(self) -> List[int]:\n        return self.values\n\nclass ResultList:\n    \"\"\"Container representing the output list of integers.\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self.values = values\n\n    def as_list(self) -> List[int]:\n        return self.values\n\nclass InputValidator:\n    \"\"\"Validates input types for numbers and n, raising TypeError on invalid types.\"\"\"\n    def validate_numbers(self, numbers) -> None:\n        if not (isinstance(numbers, list) and all(isinstance(x, int) for x in numbers)):\n            raise TypeError(\"numbers must be a list of integers\")\n\n    def validate_n(self, n) -> None:\n        if not isinstance(n, int):\n            raise TypeError(\"n must be an integer\")\n\nclass HeapQueueLargest:\n    \"\"\"Computes the top-n largest integers using heapq.nlargest or sorted.\"\"\"\n    def heap_queue_largest(self, numbers: List[int], n: int) -> List[int]:\n        if n <= 0:\n            return ResultList([]).as_list()\n        \n        if n >= len(numbers):\n            # If n is greater than or equal to the list length, return all elements sorted descending.\n            return ResultList(sorted(numbers, reverse=True)).as_list()\n        \n        # Use heapq.nlargest for the general case.\n        # heapq.nlargest returns elements in descending order by default.\n        return ResultList(heapq.nlargest(n, numbers)).as_list()\n\ndef heap_queue_largest(numbers: List[int], n: int) -> List[int]:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n    Delegates validation to InputValidator and processing to HeapQueueLargest.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate_numbers(numbers)\n    validator.validate_n(n)\n    \n    processor = HeapQueueLargest()\n    return processor.heap_queue_largest(numbers, n)"}
{"task_id": "Mbpp/2", "solution": "```python\ndef similar_elements(a, b):\n    \"\"\"Compute unique shared elements between two input sequences (list or tuple).\n\n    Returns a list of unique elements that appear in both inputs (order unspecified).\n    \"\"\"\n    if not a or not b:\n        return []\n\n    try:\n        # Fast path for hashable elements using sets\n        set_a = set(a)\n        set_b = set(b)\n        intersection = set_a.intersection(set_b)\n        return list(intersection)\n    except TypeError:\n        # Fallback path for non-hashable elements\n        shared_elements = []\n        for elem_a in a:\n            for elem_b in b:\n                if elem_a == elem_b:\n                    # Check if element already added to avoid duplicates\n                    if elem_a not in shared_elements:\n                        shared_elements.append(elem_a)\n                    break  # Move to the next element in 'a' once a match is found\n        return shared_elements\n\n```"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string, target_char):\n    \"\"\"Return a new string with the first and last occurrences of target_char removed.\n    Matching is case-sensitive.\n    \"\"\"\n    if target_char == \"\":\n        return input_string\n\n    first_idx = input_string.find(target_char)\n    if first_idx == -1:\n        return input_string\n\n    last_idx = input_string.rfind(target_char)\n\n    if first_idx == last_idx:\n        return input_string[:first_idx] + input_string[first_idx + len(target_char):]\n    else:\n        return (input_string[:first_idx]\n                + input_string[first_idx + len(target_char):last_idx]\n                + input_string[last_idx + len(target_char):])"}
{"task_id": "Mbpp/6", "solution": "class BitDifferenceResult:\n    \"\"\"Holds the XOR value and the count of differing bits.\"\"\"\n    def __init__(self, xor_value: int, differing_bit_count: int):\n        self._xor_value = xor_value\n        self._differing_bit_count = differing_bit_count\n\n    def isOneBitDiff(self) -> bool:\n        \"\"\"Returns True if exactly one bit differs.\"\"\"\n        return self._differing_bit_count == 1\n\nclass BitDifferenceCalculator:\n    \"\"\"Calculates bit differences between two integers.\"\"\"\n    @staticmethod\n    def _count_set_bits(n: int) -> int:\n        \"\"\"Counts the number of set bits in the absolute value of an integer.\"\"\"\n        count = 0\n        n = abs(n) # Ensure non-negative for bit counting loop using Brian Kernighan's algorithm.\n        while n > 0:\n            n &= (n - 1)\n            count += 1\n        return count\n\n    @staticmethod\n    def compute(a: int, b: int) -> 'BitDifferenceResult':\n        \"\"\"Computes the XOR value and the count of differing bits.\"\"\"\n        xor_value = a ^ b\n        differing_bit_count = BitDifferenceCalculator._count_set_bits(xor_value)\n        return BitDifferenceResult(xor_value, differing_bit_count)\n\n    @staticmethod\n    def differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n        \"\"\"Determines if two integers differ at exactly one bit position.\"\"\"\n        result = BitDifferenceCalculator.compute(a, b)\n        return result.isOneBitDiff()\n\ndef differ_At_One_Bit_Pos(a, b) -> bool:\n    \"\"\"\n    Checks whether the two numbers differ at one bit position only.\n    This function validates inputs are integers and delegates the computation to BitDifferenceCalculator.\n    \"\"\"\n    return BitDifferenceCalculator.differ_At_One_Bit_Pos(a, b)"}
{"task_id": "Mbpp/7", "solution": "from typing import List\n\nclass InputString:\n    \"\"\"Value holder for input text.\"\"\"\n    def __init__(self, text: str):\n        self.text: str = text\n\nclass Word:\n    \"\"\"Value holder for a token with length().\"\"\"\n    def __init__(self, text: str):\n        self.text: str = text\n\n    def length(self) -> int:\n        return len(self.text)\n\nclass ResultList:\n    \"\"\"Accumulator for resulting words.\"\"\"\n    def __init__(self):\n        self.words: List[str] = []\n\n    def add(self, word: str) -> None:\n        self.words.append(word)\n\nclass FindCharLong:\n    \"\"\"Processing class to find words meeting length criteria.\"\"\"\n    def execute(self, input: str) -> List[str]:\n        input_string = InputString(input)\n        result_list = ResultList()\n\n        tokens = input_string.text.split()\n\n        for token_text in tokens:\n            word = Word(token_text)\n            if word.length() >= 4:\n                result_list.add(word.text)\n\n        return result_list.words\n\ndef find_char_long(input: str) -> List[str]:\n    \"\"\"Public API: return list of tokens with length >= 4 from input (preserve original casing).\"\"\"\n    processor = FindCharLong()\n    return processor.execute(input)"}
{"task_id": "Mbpp/9", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass InputString:\n    value: str\n    def length(self) -> int:\n        return len(self.value)\n\n@dataclass\nclass RotationCandidate:\n    k: int\n    rotated_value: str\n\n@dataclass\nclass RotationResult:\n    k: int\n    is_minimal: bool\n\nclass RotationOperation:\n    \"\"\"RotationOperation implements rotation helpers and search logic.\n    Rotation direction convention: left rotation by k positions is used when generating candidates.\n    \"\"\"\n\n    @staticmethod\n    def rotate_left(s: str, k: int) -> str:\n        # Returns s left-rotated by k positions (cyclic shift).\n        n = len(s)\n        if n == 0:\n            return s\n        actual_k = k % n\n        return s[actual_k:] + s[:actual_k]\n\n    @staticmethod\n    def rotate_right(s: str, k: int) -> str:\n        # Returns s right-rotated by k positions (cyclic shift).\n        n = len(s)\n        if n == 0:\n            return s\n        actual_k = k % n\n        return RotationOperation.rotate_left(s, n - actual_k)\n\n    @staticmethod\n    def generate_candidates(s: str) -> List[RotationCandidate]:\n        # Generates RotationCandidate for k in 1..len(s)-1 using rotate_left.\n        candidates = []\n        n = len(s)\n        if n <= 1:\n            return candidates\n        for k in range(1, n):\n            rotated_value = RotationOperation.rotate_left(s, k)\n            candidates.append(RotationCandidate(k=k, rotated_value=rotated_value))\n        return candidates\n\n    @staticmethod\n    def find_minimal_rotation(s: str) -> RotationResult:\n        # Evaluates candidates, returns minimal k where rotated_value == s; if none, returns k = len(s).\n        n = len(s)\n        minimal_k = n # Default if no match is found in 1..n-1\n        found_match = False\n\n        for k in range(1, n):\n            rotated_s = RotationOperation.rotate_left(s, k)\n            if rotated_s == s:\n                minimal_k = k\n                found_match = True\n                break # Found the minimal positive rotation\n\n        return RotationResult(k=minimal_k, is_minimal=found_match)\n\ndef find_Rotations(s: str) -> int:\n    # Public API: delegates to RotationOperation.find_minimal_rotation to find the result.\n    result = RotationOperation.find_minimal_rotation(s)\n    return result.k"}
