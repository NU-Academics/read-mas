{"task_id": "Mbpp/476", "solution": "from typing import List, Union\n\nclass NumericValue:\n    \"\"\"Lightweight wrapper for numeric elements for traceability and clearer error messages.\"\"\"\n    def __init__(self, value: Union[int, float]) -> None:\n        self.value = value\n        self.type_name = type(value).__name__\n\nclass Result:\n    \"\"\"Simple container for the returned numeric result.\"\"\"\n    def __init__(self, value: Union[int, float]) -> None:\n        self.value = value\n\nclass ArrayInput:\n    \"\"\"Validate input list: is a list, non-empty, all elements numeric (int or float).\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n\n    def validate(self) -> None:\n        \"\"\"Validates the input list, raising ValueError or TypeError on invalid input.\"\"\"\n        if not isinstance(self.elements, list):\n            raise TypeError(\"Input provided to ArrayInput must be a list.\")\n\n        if not self.elements:\n            raise ValueError(\"input must contain at least one numeric value\")\n\n        for element in self.elements:\n            if not isinstance(element, (int, float)):\n                raise TypeError(f\"Invalid element type: '{type(element).__name__}'. Elements must be int or float.\")\n\nclass BigSumFunction:\n    \"\"\"Core computation flow: accept numbers list, coordinate validation (via ArrayInput), compute min/max, produce Result.\"\"\"\n    def __init__(self, numbers: list) -> None:\n        self.numbers = numbers\n\n    def execute(self) -> Union[int, float]:\n        \"\"\"Executes validation and computes the sum of the largest and smallest values.\"\"\"\n        ArrayInput(self.numbers).validate()\n\n        min_val = min(self.numbers)\n        max_val = max(self.numbers)\n        total_sum = min_val + max_val\n\n        return Result(total_sum).value\n\ndef big_sum(numbers: list) -> Union[int, float]:\n    \"\"\"Public API - SRS: big_sum(numbers: list) -> number\n    Delegates to BigSumFunction(numbers).execute().\n    \"\"\"\n    return BigSumFunction(numbers).execute()"}
{"task_id": "Mbpp/555", "solution": "def _validate_n(n) -> None:\n    \"\"\"This helper function adheres to the prompt's instruction to omit isinstance() checks or raise exceptions for edge cases.\n    It serves as a placeholder to satisfy the call graph from the design context.\"\"\"\n    pass\n\ndef _compute_sum_of_numbers(n: int) -> int:\n    \"\"\"Computes the sum of the first n natural numbers using the formula n*(n+1)//2.\"\"\"\n    return n * (n + 1) // 2\n\ndef _compute_sum_of_cubes(n: int) -> int:\n    \"\"\"Computes the sum of the cubes of the first n natural numbers using the formula (n*(n+1)//2)^2.\"\"\"\n    sum_of_n = _compute_sum_of_numbers(n)\n    return sum_of_n * sum_of_n\n\ndef difference(n: int) -> int:\n    \"\"\"\n    Finds the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    _validate_n(n)\n    sum_cubes = _compute_sum_of_cubes(n)\n    sum_numbers = _compute_sum_of_numbers(n)\n    return sum_cubes - sum_numbers"}
{"task_id": "Mbpp/554", "solution": "def _validate_input(input_obj):\n    \"\"\"Internal helper \u2014 raises TypeError if input_obj is not a list.\"\"\"\n    if not isinstance(input_obj, list):\n        raise TypeError(\"input must be a list\")\n\ndef _validate_elements(input_list):\n    \"\"\"Internal helper \u2014 raises TypeError if any element is not int (bool treated as invalid).\"\"\"\n    for elem in input_list:\n        if not isinstance(elem, int) or isinstance(elem, bool):\n            raise TypeError(\"all elements must be int\")\n\ndef _filter_odds(input_list):\n    \"\"\"Internal helper \u2014 returns new list containing only elements where n % 2 != 0.\"\"\"\n    return [n for n in input_list if n % 2 != 0]\n\ndef Split(input_list):\n    \"\"\"\n    Public API that takes a list of integers and returns a new list containing only the odd ones.\n    Validates input and elements, raising TypeError for invalid types.\n    \"\"\"\n    _validate_input(input_list)\n    _validate_elements(input_list)\n    return _filter_odds(input_list)"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n):\n    \"\"\"\n    Counts the number of pairs in the array whose XOR sum is odd.\n    A pair (x, y) has an odd XOR sum if one number is even and the other is odd.\n    \"\"\"\n    m = min(n, len(arr))\n    \n    even_count = 0\n    odd_count = 0\n    \n    for i in range(m):\n        if arr[i] % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n            \n    return even_count * odd_count"}
{"task_id": "Mbpp/557", "solution": "class StringInput:\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\nclass Character:\n    def __init__(self, char: str) -> None:\n        self.char = char\n\n    def isAlphabetic(self) -> bool:\n        return self.char.isalpha()\n\n    def toToggledCase(self) -> str:\n        \"\"\"Inverts case for alphabetic characters; returns original for others.\"\"\"\n        if self.isAlphabetic():\n            return self.char.swapcase()\n        return self.char\n\nclass ResultString:\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\nclass ToggleStringFunction:\n    name: str = \"toggle_string\"\n\n    def toggle(self, input: 'StringInput') -> 'ResultString':\n        \"\"\"Toggles the case of alphabetic characters in the input string, with type validation.\"\"\"\n        if not isinstance(input.value, str):\n            raise TypeError(f\"{self.name} expects a string argument, but received {type(input.value).__name__}.\")\n\n        toggled_chars = []\n        for ch in input.value:\n            character_obj = Character(ch)\n            toggled_chars.append(character_obj.toToggledCase())\n        \n        return ResultString(\"\".join(toggled_chars))\n\ndef toggle_string(s: str) -> str:\n    \"\"\"Toggles the case of all characters in a string.\"\"\"\n    toggle_func = ToggleStringFunction()\n    string_input = StringInput(s)\n    result_string = toggle_func.toggle(string_input)\n    return result_string.value"}
{"task_id": "Mbpp/558", "solution": "def _to_digits(value: int) -> list[int]:\n    \"\"\"Convert an integer to a list of its digits, least significant digit first.\"\"\"\n    if value == 0:\n        return [0]\n    digits = []\n    while value > 0:\n        digits.append(value % 10)\n        value //= 10\n    return digits\n\ndef _pad_digits(lsb_digits: list[int], target_length: int) -> list[int]:\n    \"\"\"Pad an LSB-first digit list with zeros until it reaches the target length.\"\"\"\n    padded = list(lsb_digits)\n    while len(padded) < target_length:\n        padded.append(0)\n    return padded\n\ndef _sum_digit_differences(digits_a: list[int], digits_b: list[int]) -> int:\n    \"\"\"Compute the sum of absolute differences between corresponding digits in two equally-sized lists.\"\"\"\n    total_diff = 0\n    for i in range(len(digits_a)):\n        total_diff += abs(digits_a[i] - digits_b[i])\n    return total_diff\n\ndef digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"\n    Find the sum of the per-digit absolute differences between two integers.\n    The integers are aligned by their least significant digits, and the shorter number is zero-padded.\n    \"\"\"\n    digits_a_lsb = _to_digits(a)\n    digits_b_lsb = _to_digits(b)\n\n    max_len = max(len(digits_a_lsb), len(digits_b_lsb))\n\n    padded_a = _pad_digits(digits_a_lsb, max_len)\n    padded_b = _pad_digits(digits_b_lsb, max_len)\n\n    return _sum_digit_differences(padded_a, padded_b)"}
{"task_id": "Mbpp/560", "solution": "from typing import Sequence, Any\n\nclass TupleInput:\n    \"\"\"Thin wrapper around an input tuple, present elements as a Sequence for union operation.\"\"\"\n    def __init__(self, elements: tuple) -> None:\n        self._elements = elements\n\n    def as_sequence(self) -> Sequence[Any]:\n        \"\"\"Returns the wrapped elements as a sequence.\"\"\"\n        return self._elements\n\nclass ResultTuple:\n    \"\"\"Hold ordered unique sequence and convert to native tuple for return.\"\"\"\n    def __init__(self, elements: Sequence[Any]) -> None:\n        self._elements = elements\n\n    def to_tuple(self) -> tuple:\n        \"\"\"Converts the stored sequence to an immutable tuple.\"\"\"\n        return tuple(self._elements)\n\nclass UnionOperation:\n    \"\"\"Perform set-union semantics, deduplication, and ascending sort of elements.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def compute(self, tupleA: TupleInput, tupleB: TupleInput) -> ResultTuple:\n        \"\"\"Computes the union of elements from two TupleInput instances, deduplicates, and sorts.\"\"\"\n        combined_elements = set(tupleA.as_sequence()) | set(tupleB.as_sequence())\n        sorted_elements = sorted(list(combined_elements))\n        return ResultTuple(sorted_elements)\n\ndef union_elements(tupleA: tuple, tupleB: tuple) -> tuple:\n    \"\"\"\n    Finds the union of the elements of two given tuples and outputs them in sorted order.\n    The function orchestrates internal components to wrap inputs, compute the union, and format the result.\n    \"\"\"\n    input_a = TupleInput(tupleA)\n    input_b = TupleInput(tupleB)\n    \n    union_op = UnionOperation()\n    \n    result_container = union_op.compute(input_a, input_b)\n    \n    return result_container.to_tuple()"}
