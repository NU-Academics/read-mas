{"task_id": "Mbpp/638", "solution": "class InputParameters:\n    \"\"\"A data holder for input wind velocity and temperature.\"\"\"\n    def __init__(self, wind_velocity_kmh: float, temperature_celsius: float):\n        self.wind_velocity_kmh = wind_velocity_kmh\n        self.temperature_celsius = temperature_celsius\n\nclass WindChillResult:\n    \"\"\"A data holder for raw and rounded wind chill values.\"\"\"\n    def __init__(self, raw_value: float, rounded_value: int):\n        self.raw_value = raw_value\n        self.rounded_value = rounded_value\n\nclass InputValidator:\n    \"\"\"Validates that supplied inputs are numeric.\"\"\"\n    def isNumeric(self, value) -> bool:\n        \"\"\"Returns True if value is an int or float.\"\"\"\n        return isinstance(value, (int, float))\n\n    def validateInputs(self, v_kmh, T_c) -> None:\n        \"\"\"Validates both inputs; raises TypeError for non-numeric inputs.\"\"\"\n        if not self.isNumeric(v_kmh):\n            raise TypeError(f\"Wind velocity must be numeric, got {type(v_kmh).__name__}.\")\n        if not self.isNumeric(T_c):\n            raise TypeError(f\"Temperature must be numeric, got {type(T_c).__name__}.\")\n\nclass WindChillCalculator:\n    \"\"\"Computes raw wind chill and provides rounding.\"\"\"\n    def computeRawWindChill(self, v_kmh: float, T_c: float) -> float:\n        \"\"\"Computes raw wind chill using the specified meteorological formula.\"\"\"\n        # Formula: 13.12 + 0.6215 * T - 11.37 * v^0.16 + 0.3965 * T * v^0.16\n        # The design context assumes valid numerical inputs for computation.\n        v_pow_0_16 = v_kmh**0.16\n        raw_value = 13.12 + (0.6215 * T_c) - (11.37 * v_pow_0_16) + (0.3965 * T_c * v_pow_0_16)\n        return raw_value\n\n    def wind_chill(self, v_kmh: float, T_c: float) -> int:\n        \"\"\"Computes raw wind chill and rounds it to the nearest integer.\"\"\"\n        raw_value = self.computeRawWindChill(v_kmh, T_c)\n        rounded_value = round(raw_value)\n        return rounded_value\n\ndef wind_chill(wind_velocity_kmh, temperature_celsius):\n    \"\"\"\n    Calculates the wind chill index rounded to the nearest integer.\n    Input values are validated to be numeric.\n    \"\"\"\n    # Orchestrates validation and computation as per design.\n    InputValidator().validateInputs(wind_velocity_kmh, temperature_celsius)\n    result_int = WindChillCalculator().wind_chill(wind_velocity_kmh, temperature_celsius)\n    return result_int"}
{"task_id": "Mbpp/639", "solution": "from typing import List, Optional\n\nclass Name:\n    \"\"\"Represents a single name string and offers operations to inspect its first character and length.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Return the number of characters in the name's value.\"\"\"\n        return len(self.value)\n\n    def startsWithLowercase(self) -> bool:\n        \"\"\"Return True if the first character of the name is a lowercase letter.\"\"\"\n        if not self.value:\n            return False\n        return self.value[0].islower()\n\nclass NameList:\n    \"\"\"Holds a collection of Name instances and provides filtering and aggregation operations.\"\"\"\n    def __init__(self, names: List[Name]) -> None:\n        self.names = names\n\n    def filterUppercase(self) -> List[Name]:\n        \"\"\"Return names whose first character is NOT a lowercase a..z.\"\"\"\n        return [name for name in self.names if not name.startsWithLowercase()]\n\n    def totalLength(self, filtered_names: Optional[List[Name]] = None) -> int:\n        \"\"\"Sum the lengths of provided names or self.names if none are provided.\"\"\"\n        names_to_sum = filtered_names if filtered_names is not None else self.names\n        return sum(name.length() for name in names_to_sum)\n\nclass Result:\n    \"\"\"A simple DTO carrying the integer total result.\"\"\"\n    def __init__(self, total: int) -> None:\n        self.total = total\n\nclass SampleNamFunction:\n    \"\"\"Encapsulates the primary algorithm: filter names, compute aggregate, and produce result.\"\"\"\n    def execute(self, names: List[Name]) -> int:\n        \"\"\"Filters names starting with lowercase, computes sum of lengths of remaining names, returns integer total.\"\"\"\n        name_list = NameList(names)\n        filtered = name_list.filterUppercase()\n        total = name_list.totalLength(filtered)\n        return total\n\ndef sample_nam(names) -> int:\n    \"\"\"\n    Sums the length of names after removing those that start with a lowercase letter.\n    Delegates the core logic to SampleNamFunction.\n    \"\"\"\n    name_objects = [Name(n) for n in names]\n    calculator = SampleNamFunction()\n    return calculator.execute(name_objects)"}
{"task_id": "Mbpp/641", "solution": "class InputParameter:\n    \"\"\"A lightweight container for the input parameter n.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\nclass NonagonalNumber:\n    \"\"\"A lightweight container for the computed nonagonal number.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass Validator:\n    \"\"\"Validates input n according to requirement (n >= 1).\"\"\"\n    def validate_n(self, n: int) -> bool:\n        return n >= 1\n\nclass NonagonalFunction:\n    \"\"\"Encapsulates the formula computation logic for nonagonal numbers.\"\"\"\n    def is_nonagonal(self, n: int) -> int:\n        # Compute value = (7*n^2 - 5*n) / 2 using integer division\n        return (7 * n * n - 5 * n) // 2\n\ndef is_nonagonal(n: int) -> int:\n    \"\"\"\n    Computes the nth nonagonal number using the formula (7*n^2 - 5*n) / 2.\n    Assumes n is an integer and n >= 1 as per design requirements.\n    \"\"\"\n    _input_param = InputParameter(n) # Create InputParameter object as per design\n    \n    validator = Validator()\n    # As per design, if validation fails, the behavior for the top-level function\n    # is not explicitly defined and exceptions are forbidden.\n    # For the problem context, we proceed assuming valid input n (n >= 1).\n    if not validator.validate_n(n):\n        pass # No explicit handling for invalid n based on constraints.\n\n    nonagonal_calculator = NonagonalFunction()\n    computed_value = nonagonal_calculator.is_nonagonal(n)\n\n    nonagonal_result = NonagonalNumber(computed_value)\n    return nonagonal_result.value"}
{"task_id": "Mbpp/643", "solution": "import re\nfrom typing import List\n\nclass FunctionResult:\n    \"\"\"Wrapper/DTO for the boolean result.\"\"\"\n    def __init__(self, result: bool):\n        self.result = result\n\nclass Word:\n    \"\"\"Represents a contiguous sequence of characters treated as a word.\"\"\"\n    def __init__(self, value: str, startIndex: int, endIndex: int):\n        self.value = value\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the word value.\"\"\"\n        return len(self.value)\n\nclass CharacterOccurrence:\n    \"\"\"Represents an occurrence of a single character within a Word.\"\"\"\n    def __init__(self, character: str, index: int):\n        self.character = character\n        self.index = index\n\n    def isFirst(self) -> bool:\n        \"\"\"Checks if the character is the first in its word.\"\"\"\n        return self.index == 0\n\n    def isLast(self, word: 'Word') -> bool:\n        \"\"\"Checks if the character is the last in its word.\"\"\"\n        return self.index == word.length() - 1\n\nclass TextProcessor:\n    \"\"\"Parses input text into Word tokens and evaluates each for 'z' in the middle.\"\"\"\n    _text: str\n    _words: List['Word']\n\n    def text_match_wordz_middle(self, text: str) -> bool:\n        \"\"\"Implements the core logic to find 'z' in the middle of words.\"\"\"\n        self._text = text\n        self._words = self.parseWords(text)\n\n        for word in self._words:\n            if self.isZInMiddle(word):\n                return FunctionResult(True).result\n        return FunctionResult(False).result\n\n    def parseWords(self, text: str) -> List['Word']:\n        \"\"\"Tokenizes text into Word objects using contiguous alphabetic sequences.\"\"\"\n        words: List[Word] = []\n        for match in re.finditer(r\"[A-Za-z]+\", text):\n            value = match.group(0)\n            start_index = match.start()\n            end_index = match.end()\n            words.append(Word(value, start_index, end_index))\n        return words\n\n    def isZInMiddle(self, word: 'Word') -> bool:\n        \"\"\"Determines if a given Word contains a lowercase 'z' at an interior position.\"\"\"\n        if word.length() < 3: # A 'z' in the middle requires at least 3 characters\n            return False\n\n        for i, char in enumerate(word.value):\n            if char == 'z': # Check for lowercase 'z' only\n                occurrence = CharacterOccurrence(char, i)\n                if not occurrence.isFirst() and not occurrence.isLast(word):\n                    return True\n        return False\n\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"Checks if any word in the given text contains 'z' not at its start or end.\"\"\"\n    processor = TextProcessor()\n    return processor.text_match_wordz_middle(text)"}
{"task_id": "Mbpp/720", "solution": "from typing import Tuple as TypeTuple, Dict as TypeDict\n\n# Define type aliases as per design document\nTuple = TypeTuple\nDictionary = TypeDict\nResultTuple = TypeTuple\n\ndef add_dict_to_tuple(inputTuple: Tuple, inputDict: Dictionary) -> ResultTuple:\n    \"\"\"\n    Appends a dictionary as a single element to the end of a tuple.\n    Returns a new tuple with the original tuple's elements followed by the dictionary.\n    \"\"\"\n    return inputTuple + (inputDict,)"}
{"task_id": "Mbpp/644", "solution": "class ValidationError(ValueError):\n    \"\"\"Custom exception for invalid K parameter.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass Array:\n    \"\"\"Lightweight wrapper around an input list.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the wrapped list.\"\"\"\n        return len(self.elements)\n\nclass ParameterK:\n    \"\"\"Encapsulates the K parameter and provides validation.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_valid(self, arr: Array) -> bool:\n        \"\"\"Validates if K is in the inclusive range 0 to array length.\"\"\"\n        return 0 <= self.value <= arr.length()\n\nclass Result:\n    \"\"\"Holds the resulting list from the reversal operation.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n\nclass ReverseFunction:\n    \"\"\"Encapsulates the array reversal use-case logic.\"\"\"\n    name: str = \"reverse_Array_Upto_K\"\n\n    def execute(self, arr: Array, k: ParameterK) -> Result:\n        \"\"\"Performs the reversal after validating the K parameter.\"\"\"\n        if not k.is_valid(arr):\n            raise ValidationError(f\"Invalid K value: {k.value}. K must be between 0 and {arr.length()} (inclusive).\")\n\n        # Reverse the first K elements and concatenate with the rest\n        reversed_part = arr.elements[:k.value][::-1]\n        remaining_part = arr.elements[k.value:]\n        new_list = reversed_part + remaining_part\n        return Result(new_list)\n\ndef reverse_Array_Upto_K(arr, k):\n    \"\"\"\n    Reverses the order of the first K elements in a list, returning a new list.\n\n    Raises ValidationError if K is outside the range [0, len(arr)].\n    \"\"\"\n    array_obj = Array(elements=list(arr)) # Create a copy to ensure input is not mutated even if Array was mutable\n    param_k_obj = ParameterK(value=k)\n    reverse_func = ReverseFunction()\n    result = reverse_func.execute(array_obj, param_k_obj)\n    return result.elements"}
{"task_id": "Mbpp/722", "solution": "from typing import Dict, Tuple\n\ndef filter_data(students: Dict[str, Tuple[float, float]], min_height: float, min_weight: float) -> Dict[str, Tuple[float, float]]:\n    \"\"\"\n    Filters a dictionary of students based on minimum height and weight criteria.\n    Includes students whose height is strictly greater than min_height AND weight is greater than or equal to min_weight.\n    \"\"\"\n    filtered_students = {}\n    for name, (height, weight) in students.items():\n        if height > min_height and weight >= min_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students"}
{"task_id": "Mbpp/721", "solution": "from typing import List\n\nfrom src.matrix import Matrix, matrix_from_list\nfrom src.validator import Validator, InvalidMatrixError\nfrom src.path_evaluator import PathEvaluator\n\n\ndef maxAverageOfPath(matrix_list: List[List[float]]) -> float:\n    \"\"\"\n    Computes the maximum average cost of a path from the top-left to the bottom-right\n    of a square matrix, moving only right or down.\n    \"\"\"\n    matrix = matrix_from_list(matrix_list)\n\n    validator = Validator()\n    validator.assertValid(matrix)\n\n    path_evaluator = PathEvaluator()\n    max_average = path_evaluator.computeMaxAverage(matrix)\n\n    return max_average"}
{"task_id": "Mbpp/723", "solution": "class ComparisonResult:\n    \"\"\"A value object holding the integer count of matches.\"\"\"\n    def __init__(self, matches: int):\n        self.matches = matches\n\nclass CountSamePair:\n    \"\"\"Encapsulates the algorithm and input validation for counting same pairs.\"\"\"\n    def validate_inputs(self, listA, listB) -> bool:\n        \"\"\"Returns True if inputs are list-like and have equal length.\"\"\"\n        if not isinstance(listA, list) or not isinstance(listB, list):\n            return False\n        return len(listA) == len(listB)\n\n    def count_same_pair(self, listA, listB) -> ComparisonResult:\n        \"\"\"Performs element-wise comparison and returns the count of matches.\"\"\"\n        if not listA and not listB:\n            return ComparisonResult(matches=0) # FR-4\n        \n        counter = 0\n        for i in range(len(listA)):\n            if listA[i] == listB[i]: # FR-3\n                counter += 1\n        return ComparisonResult(matches=counter) # FR-2\n\ndef count_same_pair(listA, listB) -> int:\n    \"\"\"Counts indices where two lists of the same length have equal values.\"\"\"\n    interactor = CountSamePair()\n    if not interactor.validate_inputs(listA, listB):\n        raise ValueError('Inputs must be lists of equal length')\n\n    if len(listA) == 0 and len(listB) == 0: # FR-4\n        return 0\n\n    result = interactor.count_same_pair(listA, listB)\n    return result.matches"}
{"task_id": "Mbpp/724", "solution": "class InputValidator:\n    \"\"\"Validates that base and power are non-negative integers.\"\"\"\n    def validate(self, base: int, power: int) -> bool:\n        \"\"\"Returns True if base and power are non-negative integers, False otherwise.\"\"\"\n        if not isinstance(base, int) or not isinstance(power, int):\n            return False\n        if base < 0 or power < 0:\n            return False\n        return True\n\nclass BigInteger:\n    \"\"\"A minimal wrapper representing an arbitrary-precision integer.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def toDecimalString(self) -> str:\n        \"\"\"Returns the decimal string representation of the stored integer value.\"\"\"\n        return str(self.value)\n\nclass ExponentiationEngine:\n    \"\"\"Computes base^power using arbitrary-precision integer arithmetic.\"\"\"\n    def pow(self, base: int, power: int) -> BigInteger:\n        \"\"\"Calculates base to the power of power and returns it as a BigInteger.\"\"\"\n        result = base ** power\n        return BigInteger(result)\n\nclass DigitSumCalculator:\n    \"\"\"Calculates the sum of decimal digits of a BigInteger's decimal representation.\"\"\"\n    def sumDigits(self, value: BigInteger) -> int:\n        \"\"\"Converts the BigInteger to a decimal string and sums its digits.\"\"\"\n        decimal_string = value.toDecimalString()\n        total_sum = 0\n        for char_digit in decimal_string:\n            total_sum += int(char_digit)\n        return total_sum\n\nclass DigitSumResult:\n    \"\"\"A simple data holder for the integer digit-sum result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass PowerBaseSumFunction:\n    \"\"\"Coordinates the computation of the sum of digits of base to the power.\"\"\"\n    def __init__(self, validator: InputValidator, engine: ExponentiationEngine, digit_calculator: DigitSumCalculator) -> None:\n        self.validator = validator\n        self.engine = engine\n        self.digit_calculator = digit_calculator\n\n    def power_base_sum(self, base: int, power: int) -> int:\n        \"\"\"Validates inputs, computes base^power, and sums the digits of the result.\"\"\"\n        if not self.validator.validate(base, power):\n            raise ValueError(\"Inputs 'base' and 'power' must be non-negative integers.\")\n\n        big_int_result = self.engine.pow(base, power)\n        digit_sum = self.digit_calculator.sumDigits(big_int_result)\n        return digit_sum\n\n# Instantiate stateless components once at module level for reuse.\n_input_validator = InputValidator()\n_exponentiation_engine = ExponentiationEngine()\n_digit_sum_calculator = DigitSumCalculator()\n_power_base_sum_coordinator = PowerBaseSumFunction(\n    _input_validator,\n    _exponentiation_engine,\n    _digit_sum_calculator\n)\n\ndef power_base_sum(base, power) -> int:\n    \"\"\"\n    Calculates the sum of all digits of 'base' to the specified 'power'.\n    Delegates to a module-level coordinator for processing.\n    \"\"\"\n    return _power_base_sum_coordinator.power_base_sum(base, power)"}
{"task_id": "Mbpp/725", "solution": "import re\nfrom typing import List\n\ndef extract_quotation(input_string: str) -> List[str]:\n    \"\"\"\n    Extracts all substrings enclosed in double quotation marks from the input string.\n    Returns an ordered list of the extracted substrings.\n    \"\"\"\n    return re.findall(r'\"(.*?)\"', input_string)"}
{"task_id": "Mbpp/726", "solution": "from typing import Tuple, Any\n\ndef multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Computes the product of adjacent elements in a tuple of numbers.\n    Returns a new tuple where the i-th element is the product of input_tuple[i] and input_tuple[i+1].\n    \"\"\"\n    products = tuple(input_tuple[i] * input_tuple[i+1] for i in range(len(input_tuple) - 1))\n    return products"}
{"task_id": "Mbpp/728", "solution": "class LengthMismatchError(Exception):\n    \"\"\"Custom exception raised when input lists lengths differ.\"\"\"\n    pass\n\ndef _validate_same_length(a: list, b: list) -> None:\n    \"\"\"Checks if the input lists have the same length, raising LengthMismatchError if not.\"\"\"\n    if len(a) != len(b):\n        raise LengthMismatchError(f\"Input lists must have the same length, but got {len(a)} and {len(b)}.\")\n\ndef _validate_numeric_elements(a: list, b: list) -> None:\n    \"\"\"Verifies all elements in both input lists are numeric (int or float), raising TypeError otherwise.\"\"\"\n    for i, (val_a, val_b) in enumerate(zip(a, b)):\n        if not isinstance(val_a, (int, float)):\n            raise TypeError(f\"Element at index {i} in list 'a' is not numeric: {val_a} (type: {type(val_a)})\")\n        if not isinstance(val_b, (int, float)):\n            raise TypeError(f\"Element at index {i} in list 'b' is not numeric: {val_b} (type: {type(val_b)})\")\n\ndef sum_list(a: list, b: list) -> list:\n    \"\"\"\n    Takes two lists of numbers and returns a new list containing their element-wise sums.\n    Raises LengthMismatchError if lists have different lengths or TypeError if elements are not numeric.\n    \"\"\"\n    _validate_same_length(a, b)\n    _validate_numeric_elements(a, b)\n    return [x + y for x, y in zip(a, b)]"}
{"task_id": "Mbpp/730", "solution": "from typing import List, Any\n\ndef consecutive_duplicates(input_list: list) -> list:\n    \"\"\"Accept a single list argument (input_list) and return a new list with\n    consecutive (adjacent) duplicates collapsed to single occurrences.\"\"\"\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n    for item in input_list[1:]:\n        if item != result[-1]:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/731", "solution": "import math\n\nclass Cone:\n    def __init__(self, r: float, h: float):\n        self.r = r\n        self.h = h\n\n    def getSlantHeight(self) -> float:\n        \"\"\"Calculates the slant height of the cone.\"\"\"\n        return math.sqrt(self.r**2 + self.h**2)\n\nclass LateralSurfaceCalculator:\n    formula: str = \"pi * r * sqrt(r^2 + h^2)\"\n\n    def computeLateralSurface(self, cone: Cone) -> float:\n        \"\"\"Computes the lateral surface area of a given cone.\"\"\"\n        slant = cone.getSlantHeight()\n        return math.pi * cone.r * slant\n\nclass Measurement:\n    def __init__(self, value: float, unit: str = \"square units\"):\n        self.value = value\n        self.unit = unit\n\ndef lateralsurface_cone(r, h) -> float:\n    \"\"\"Return lateral surface area as float using pi * r * sqrt(r^2 + h^2).\"\"\"\n    cone = Cone(float(r), float(h))\n    calculator = LateralSurfaceCalculator()\n    lateral = calculator.computeLateralSurface(cone)\n    return lateral"}
{"task_id": "Mbpp/732", "solution": "_MAPPING_RULES = {' ': ':', ',': ':', '.': ':'}\n\ndef replace_specialchar(input_string: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots with a colon.\n    All other characters in the string are preserved.\n    \"\"\"\n    return ''.join(_MAPPING_RULES.get(char, char) for char in input_string)"}
{"task_id": "Mbpp/733", "solution": "from typing import List\n\ndef find_first_occurrence(array: List[int], value: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array.\n    Uses a binary search variant to efficiently locate the left-most index.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result_index = -1  # Initialize result to -1 (not found)\n\n    while low <= high:\n        mid = low + (high - low) // 2\n\n        if array[mid] == value:\n            result_index = mid  # Found an occurrence, store its index\n            high = mid - 1      # Try to find an even earlier occurrence in the left half\n        elif array[mid] < value:\n            low = mid + 1       # Value must be in the right half\n        else:  # array[mid] > value\n            high = mid - 1      # Value must be in the left half\n\n    return result_index"}
{"task_id": "Mbpp/734", "solution": "from typing import Union\n\ndef sum_Of_Subarray_Prod(input_list: list[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the sum of products of all contiguous subarrays within the given list.\n    Returns an int if all input elements are integers and the sum is integral, otherwise returns a float.\n    \"\"\"\n    n = len(input_list)\n    total_sum = 0.0\n    all_inputs_are_integers = True\n\n    for i in range(n):\n        if isinstance(input_list[i], float):\n            all_inputs_are_integers = False\n        \n        current_product = 1.0 if isinstance(input_list[i], float) else 1 # Start product as float if first element is float, else int\n        \n        for j in range(i, n):\n            if isinstance(input_list[j], float):\n                all_inputs_are_integers = False\n                current_product *= input_list[j] # Multiply by float, current_product becomes float\n            else:\n                current_product *= input_list[j] # Keep current_product type or promote to float if already float\n            \n            total_sum += current_product\n\n    if all_inputs_are_integers and total_sum == int(total_sum):\n        return int(total_sum)\n    return total_sum"}
{"task_id": "Mbpp/735", "solution": "def generate_mask(middle_length: int) -> int:\n    \"\"\"Computes an integer mask with `middle_length` low-order 1-bits.\n    Returns 0 if middle_length is not positive.\n    \"\"\"\n    if middle_length <= 0:\n        return 0\n    return (1 << middle_length) - 1\n\ndef toggle_middle_bits(n: int) -> int:\n    \"\"\"Toggles all bits of the number n except the most-significant bit (MSB) and the least-significant bit (LSB).\n    If n has fewer than three bits, it returns n unchanged.\n    \"\"\"\n    L = n.bit_length()\n\n    if L < 3:\n        return n\n\n    middle_length = L - 2\n    mask = generate_mask(middle_length)\n    shifted_mask = mask << 1\n    result = n ^ shifted_mask\n    return result"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list, value):\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list.\n    It implements a binary search to find the index where the value can be inserted to maintain order.\n    \"\"\"\n\n    # Helper class for read-only list access, encapsulating list operations.\n    class _SortedList:\n        def __init__(self, elements):\n            self.elements = elements\n\n        def length(self):\n            return len(self.elements)\n\n        def get(self, index):\n            return self.elements[index]\n\n        def is_empty(self):\n            return self.length() == 0\n\n    # Helper class for robust comparison, raising TypeError for incomparable types.\n    class _ComparisonEngine:\n        def compare(self, a, b):\n            try:\n                if a < b:\n                    return -1\n                elif a == b:\n                    return 0\n                else:  # a > b\n                    return 1\n            except TypeError:\n                # Raise TypeError as specified by the design context for incomparable types.\n                raise TypeError(f\"Incomparable types: cannot compare {type(a).__name__} with {type(b).__name__}\")\n\n    sl = _SortedList(sorted_list)\n    if sl.is_empty():\n        return 0\n\n    ce = _ComparisonEngine()\n    low = 0\n    high = sl.length()\n\n    # Perform a binary search to find the leftmost index `i` such that `sorted_list[i] >= value`.\n    while low < high:\n        mid = (low + high) // 2\n        mid_val = sl.get(mid)\n        cmp_result = ce.compare(mid_val, value)\n        if cmp_result < 0:  # mid_val < value, so search in the right half\n            low = mid + 1\n        else:  # mid_val >= value, so mid could be the insertion point or one to its left\n            high = mid\n    return low"}
{"task_id": "Mbpp/737", "solution": "import re\n\nVOWEL_PATTERN: str = r'^[aeiou]'\n\nclass RegexPattern:\n    \"\"\"Encapsulates the regex pattern and matching operation.\"\"\"\n    def __init__(self, pattern: str):\n        \"\"\"Create RegexPattern with a pattern string.\"\"\"\n        self.pattern: str = pattern\n        self._compiled = re.compile(pattern, re.IGNORECASE)\n    def apply(self, input: str) -> bool:\n        \"\"\"Return True if pattern matches the first character of input according to compiled regex.\"\"\"\n        if not isinstance(input, str):\n            raise TypeError('input must be a string')\n        return bool(self._compiled.match(input))\n\ndef check_str(input: str) -> bool:\n    \"\"\"\n    Public API: return boolean indicating whether input starts with a vowel using RegexPattern.apply.\n    Uses a regex pattern anchored at the start to match vowels, ignoring case.\n    \"\"\"\n    rp = RegexPattern(VOWEL_PATTERN)\n    return rp.apply(input)"}
{"task_id": "Mbpp/739", "solution": "class InputParameter:\n    \"\"\"Encapsulates input value and provides validation.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def is_positive(self):\n        \"\"\"Checks if the input parameter n is positive.\"\"\"\n        return self.n >= 1\n\nclass TriangularNumber:\n    \"\"\"Utility class for computing triangular numbers and their digit counts.\"\"\"\n    @staticmethod\n    def compute(k):\n        \"\"\"Computes the k-th triangular number.\"\"\"\n        return k * (k + 1) // 2\n\n    @staticmethod\n    def digit_count(value):\n        \"\"\"Returns the number of decimal digits in a given value.\"\"\"\n        # Using len(str(value)) is acceptable per design notes\n        if value == 0:\n            return 1\n        return len(str(value))\n\nclass Result:\n    \"\"\"Encapsulates a potential result (k) and provides validation methods.\"\"\"\n    def __init__(self, k):\n        self.k = k\n\n    def _T_k(self):\n        \"\"\"Computes the triangular number for the encapsulated k.\"\"\"\n        return TriangularNumber.compute(self.k)\n\n    def is_valid_for_n(self, n):\n        \"\"\"Verifies if the triangular number T_k has exactly n digits.\"\"\"\n        t_k = self._T_k()\n        return TriangularNumber.digit_count(t_k) == n\n\n\nclass FindIndexFunction:\n    \"\"\"Orchestrates validation and search for the index of the smallest triangular number with n digits.\"\"\"\n    @staticmethod\n    def validate_input(n):\n        \"\"\"Validates the input 'n' to ensure it's a positive integer.\"\"\"\n        if not isinstance(n, int) or not InputParameter(n).is_positive():\n            raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n    @staticmethod\n    def search_index(n):\n        \"\"\"Performs a monotonic search for the smallest k where T_k has n digits.\"\"\"\n        k = 1\n        while True:\n            t_k = TriangularNumber.compute(k)\n            if TriangularNumber.digit_count(t_k) == n:\n                return k\n            k += 1\n\n    @staticmethod\n    def find_Index(n):\n        \"\"\"\n        Orchestrates finding the index of the smallest triangular number with 'n' digits.\n        It validates input and performs the search.\n        \"\"\"\n        FindIndexFunction.validate_input(n)\n        return FindIndexFunction.search_index(n)\n\ndef find_Index(n):\n    \"\"\"\n    Finds the index of the smallest triangular number with exactly n digits.\n    This function delegates to an internal class for validation and search logic.\n    \"\"\"\n    return FindIndexFunction.find_Index(n)"}
{"task_id": "Mbpp/740", "solution": "from dataclasses import dataclass\n\n\nclass ValidationError(Exception):\n    \"\"\"Domain-specific exception for invalid inputs to tuple_to_dict.\"\"\"\n    pass\n\n\n@dataclass\nclass KeyValuePair:\n    \"\"\"A simple container for a key-value pair.\"\"\"\n    key: any\n    value: any\n\n\ndef validate_even_length(t: tuple) -> bool:\n    \"\"\"Validates that the input is a tuple and has an even number of elements.\"\"\"\n    if not isinstance(t, tuple):\n        raise ValidationError(\"Input must be a tuple.\")\n    if len(t) % 2 != 0:\n        raise ValidationError(\"Input tuple must have an even number of elements.\")\n    return True\n\n\ndef pair_elements(t: tuple) -> list[KeyValuePair]:\n    \"\"\"Pairs adjacent elements of a tuple into a list of KeyValuePair objects.\"\"\"\n    pairs = []\n    for i in range(0, len(t), 2):\n        pairs.append(KeyValuePair(key=t[i], value=t[i+1]))\n    return pairs\n\n\ndef tuple_to_dict(t: tuple) -> dict:\n    \"\"\"\n    Converts a tuple of adjacent elements into a key-value dictionary.\n    Raises ValidationError if the input is not a tuple or has an odd number of elements.\n    \"\"\"\n    validate_even_length(t)\n    key_value_pairs = pair_elements(t)\n    return {pair.key: pair.value for pair in key_value_pairs}"}
