{"task_id": "Mbpp/102", "solution": "def snake_to_camel(input_string: str) -> str:\n    \"\"\"Converts a snake_case string to CamelCase by capitalizing each segment and joining them.\"\"\"\n    segments = input_string.split('_')\n    camel_segments = []\n    for segment in segments:\n        if segment:  # Ignore empty segments\n            camel_segments.append(segment[0].upper() + segment[1:])\n    return ''.join(camel_segments)"}
{"task_id": "Mbpp/104", "solution": "def _validate_outer_type(input_collection):\n    \"\"\"\n    Validates that the input collection is either a list or a tuple.\n    Raises TypeError if validation fails.\n    \"\"\"\n    if not isinstance(input_collection, (list, tuple)):\n        raise TypeError(\"input_collection must be a list or tuple\")\n\ndef _validate_and_sort_sublist(sublist):\n    \"\"\"\n    Validates a sublist and its elements, then returns a sorted version.\n    Raises TypeError if the sublist or its elements are invalid.\n    \"\"\"\n    if not isinstance(sublist, (list, tuple)):\n        raise TypeError(\"each sublist must be a list or tuple of str\")\n    for item in sublist:\n        if not isinstance(item, str):\n            raise TypeError(\"each sublist must be a list or tuple of str\")\n    return sorted(sublist)\n\ndef sort_sublists(input_collection):\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists,\n    returning a new list of lists with sorted sublists.\n    \"\"\"\n    _validate_outer_type(input_collection)\n    \n    result = []\n    for sublist in input_collection:\n        result.append(_validate_and_sort_sublist(sublist))\n    \n    return result"}
{"task_id": "Mbpp/103", "solution": "import math\n\nclass BinomialCoefficient:\n    \"\"\"\n    Helper class for computing binomial coefficients C(n, k).\n    \"\"\"\n    @staticmethod\n    def C(n: int, k: int) -> int:\n        \"\"\"\n        Computes the exact integer binomial coefficient \"n choose k\" for 0 <= k <= n.\n        \"\"\"\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        if k > n // 2:\n            k = n - k\n        \n        return math.factorial(n) // (math.factorial(k) * math.factorial(n - k))\n\n\nclass EulerianFunction:\n    \"\"\"\n    Helper class encapsulating the core Eulerian number computation logic.\n    \"\"\"\n    def computeTerm(self, n: int, m: int, k: int) -> int:\n        \"\"\"\n        Computes a single term of the Eulerian number summation: (-1)^k * C(n+1, k) * (m+1-k)^n.\n        \"\"\"\n        sign = (-1)**k\n        binom_coeff = BinomialCoefficient.C(n + 1, k)\n        power_term = (m + 1 - k)**n\n        return sign * binom_coeff * power_term\n\n    def computeSum(self, n: int, m: int) -> int:\n        \"\"\"\n        Aggregates all terms to compute the final Eulerian number a(n, m).\n        \"\"\"\n        total_sum = 0\n        for k in range(m + 1):  # k from 0 to m inclusive\n            total_sum += self.computeTerm(n, m, k)\n        return total_sum\n\n\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Computes the Eulerian number a(n, m) using the summation formula.\n    a(n,m) = sum_{k=0}^{m} (-1)^k * C(n+1, k) * (m+1-k)^n\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if not (0 <= m < n):\n        raise ValueError(\"Input 'm' must be an integer such that 0 <= m < n.\")\n\n    eulerian_func_instance = EulerianFunction()\n    result = eulerian_func_instance.computeSum(n, m)\n    return result"}
{"task_id": "Mbpp/106", "solution": "def add_lists(list, tuple):\n    \"\"\"\n    Appends the elements of the given list to the given tuple, returning a new tuple.\n    The order of elements is preserved, and input sequences are not modified.\n    \"\"\"\n    return tuple + tuple(list)"}
{"task_id": "Mbpp/105", "solution": "def count(input_list):\n    \"\"\"Return the number of elements in `input_list` that are exactly the boolean True.\n\n    Raises:\n        TypeError: if `input_list` is not of type list.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"count: input_list must be a list\")\n    total = 0\n    for item in input_list:\n        if isinstance(item, bool) and item is True:\n            total += 1\n    return total"}
{"task_id": "Mbpp/108", "solution": "class Validator:\n    \"\"\"Validates input lists to ensure they are lists of integers.\"\"\"\n    def validate(self, lst: list) -> bool:\n        if not isinstance(lst, list):\n            return False\n        for item in lst:\n            if not isinstance(item, int):\n                return False\n        return True\n\nclass Merger:\n    \"\"\"Merges multiple lists into a single list.\"\"\"\n    def merge(self, l1: list, l2: list, l3: list) -> list:\n        return l1 + l2 + l3\n\nclass Sorter:\n    \"\"\"Sorts a list in ascending order.\"\"\"\n    def sortAscending(self, lst: list) -> list:\n        return sorted(lst)\n\nclass MergeSortedListFunction:\n    \"\"\"Orchestrates the validation, merging, and sorting process.\"\"\"\n    def __init__(self):\n        self.validator = Validator()\n        self.merger = Merger()\n        self.sorter = Sorter()\n\n    def merge(self, list1: list, list2: list, list3: list) -> list:\n        if not self.validator.validate(list1):\n            raise ValueError(\"Input list1 must be a list of integers.\")\n        if not self.validator.validate(list2):\n            raise ValueError(\"Input list2 must be a list of integers.\")\n        if not self.validator.validate(list3):\n            raise ValueError(\"Input list3 must be a list of integers.\")\n\n        merged_list = self.merger.merge(list1, list2, list3)\n        sorted_list = self.sorter.sortAscending(merged_list)\n        return sorted_list\n\ndef merge_sorted_list(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Merges three input lists into a single sorted list.\n    It validates inputs, merges them, and sorts in ascending order.\n    \"\"\"\n    orchestrator = MergeSortedListFunction()\n    return orchestrator.merge(list1, list2, list3)"}
{"task_id": "Mbpp/113", "solution": "def check_integer(s):\n    \"\"\"Return True if s is a str representing an integer; raise TypeError if s is not a str.\"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if not s:\n        return False\n\n    start_index = 0\n    if s[0] == '+' or s[0] == '-':\n        start_index = 1\n\n    # An integer must have at least one digit\n    if start_index == len(s):\n        return False\n\n    for i in range(start_index, len(s)):\n        if not ('0' <= s[i] <= '9'):\n            return False\n\n    return True"}
{"task_id": "Mbpp/109", "solution": "from typing import Iterator\n\nclass Rotation:\n    \"\"\"Represents a single rotation of a binary string.\n    It stores the rotation's index and its string value.\"\"\"\n    def __init__(self, index: int, value: str):\n        self.index = index\n        self.value = value\n\n    def isOdd(self) -> bool:\n        \"\"\"Checks if the rotation's binary value is odd.\n        A binary string is considered odd if its rightmost character is '1'.\"\"\"\n        return self.value[-1] == '1'\n\ndef generate(binary_string: str, k: int) -> Iterator[Rotation]:\n    \"\"\"Generates k cyclic left rotations of the binary string.\n    Each rotation is yielded as a Rotation object.\"\"\"\n    n = len(binary_string)\n    # Assumes binary_string is a non-empty string of '0's and '1's, and k is a non-negative integer.\n    # Input validation, as specified in the design, is omitted per explicit instruction.\n    if n == 0:\n        return # Cannot rotate an empty string; yield no rotations.\n\n    for i in range(k):\n        idx = i % n\n        rotated_value = binary_string[idx:] + binary_string[:idx]\n        yield Rotation(index=i, value=rotated_value)\n\ndef count_odd(rotations: Iterator[Rotation]) -> int:\n    \"\"\"Counts how many generated rotations are odd.\n    It iterates through the provided rotations and checks their oddness.\"\"\"\n    count = 0\n    for rotation in rotations:\n        if rotation.isOdd():\n            count += 1\n    return count\n\ndef odd_Equivalent(binary_string: str, k: int) -> int:\n    \"\"\"\n    Finds the number of numbers with an odd value when rotating a binary string k times.\n    This function counts odd-valued cyclic left rotations among the first k rotations of the given binary string.\n    \"\"\"\n    # Input validation (e.g., for string content, k type, and non-negativity)\n    # is explicitly omitted as per the instruction \"DO NOT add isinstance() checks or raise exceptions for edge cases\".\n    # It is assumed that `binary_string` is a non-empty string containing only '0's and '1's, and `k` is a non-negative integer.\n\n    rotations_iterator = generate(binary_string, k)\n    result = count_odd(rotations_iterator)\n    return result"}
{"task_id": "Mbpp/111", "solution": "def validate_nested_lists(nested_lists) -> bool:\n    \"\"\"\n    Validates if the input is a list or tuple containing at least two list-like elements.\n    Returns True if valid, False otherwise.\n    \"\"\"\n    if not isinstance(nested_lists, (list, tuple)):\n        return False\n    if len(nested_lists) < 2:\n        return False\n    for inner_list in nested_lists:\n        if not isinstance(inner_list, (list, tuple)):\n            return False\n    return True\n\ndef common_in_nested_lists(nested_lists):\n    \"\"\"\n    Finds common elements in given nested lists by performing successive set intersections.\n    Raises ValueError for invalid input, as specified in the design.\n    \"\"\"\n    if not validate_nested_lists(nested_lists):\n        raise ValueError(\"nested_lists must be a list of 2+ inner lists\")\n\n    # Initialize common_elements with a set from the first inner list\n    common_elements = set(nested_lists[0])\n\n    # Iteratively intersect with sets converted from the remaining inner lists\n    for i in range(1, len(nested_lists)):\n        current_list_set = set(nested_lists[i])\n        common_elements.intersection_update(current_list_set)\n        # Optimization: if the set becomes empty, no further common elements exist\n        if not common_elements:\n            break\n\n    return common_elements"}
{"task_id": "Mbpp/118", "solution": "def string_to_list(input: str) -> list[str]:\n    \"\"\"\n    SRS-traceable function: string_to_list(input: String) -> List<String>\n    Splits on the ASCII space character (U+0020) only: input.split(' ').\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"string_to_list expects a str input\")\n    return input.split(' ')"}
{"task_id": "Mbpp/116", "solution": "def tuple_to_int(input_tuple: tuple) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer.\n\n    Raises TypeError or ValueError for invalid input, as specified in design.\n    \"\"\"\n    _validate_tuple(input_tuple)\n    return _concatenate_elements(input_tuple)\n\ndef _validate_tuple(input_tuple: tuple) -> None:\n    \"\"\"\n    Validates that the input is a tuple and contains only positive integers.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"tuple_to_int expects a tuple as its single argument\")\n    if not input_tuple: # Empty tuple check here, or in _concatenate_elements per design. Design implies checking here.\n        raise ValueError(\"tuple_to_int requires a non-empty tuple of positive integers\")\n\n    for i, e in enumerate(input_tuple):\n        if not isinstance(e, int):\n            raise TypeError(f\"element at index {i} is not an int: {type(e).__name__}\")\n        if e <= 0:\n            raise ValueError(f\"element at index {i} is not a positive integer: {e}\")\n\ndef _concatenate_elements(elements: tuple) -> int:\n    \"\"\"\n    Concatenates the string representations of tuple elements and converts to an integer.\n    \"\"\"\n    # The _validate_tuple function already handles the empty tuple check.\n    # However, to explicitly match the _concatenate_elements internal helper design note:\n    # If len(elements) == 0: raise ValueError(\"tuple_to_int requires a non-empty tuple of positive integers\")\n    # This check is redundant if _validate_tuple is always called first and handles it.\n    # Sticking to the design document for _concatenate_elements:\n    if len(elements) == 0:\n        raise ValueError(\"tuple_to_int requires a non-empty tuple of positive integers\")\n\n    s = \"\".join(str(e) for e in elements)\n    return int(s)"}
{"task_id": "Mbpp/119", "solution": "from typing import List\n\ndef search(nums: List[int]) -> int:\n    \"\"\"Return the integer that appears only once in a sorted list where every other integer appears exactly twice.\n\n    Precondition: nums is sorted and contains exactly one unique element while all others appear in pairs.\n    \"\"\"\n    low = 0\n    high = len(nums) - 1\n\n    while low < high:\n        mid = low + (high - low) // 2\n\n        # Ensure mid always points to an even index for consistent pair checking\n        if mid % 2 == 1:\n            mid -= 1\n\n        # If nums[mid] and nums[mid+1] are a pair, the unique element is to the right\n        if nums[mid] == nums[mid + 1]:\n            low = mid + 2\n        # Otherwise, the unique element is at or to the left of mid\n        else:\n            high = mid\n\n    return nums[low]"}
{"task_id": "Mbpp/120", "solution": "from typing import List, Tuple, Union\n\nNumber = Union[int, float]\n\nclass TuplePair:\n    \"\"\"Holds a pair of numbers and provides their product.\"\"\"\n    def __init__(self, a: Number, b: Number) -> None:\n        self.a = a\n        self.b = b\n\n    def product(self) -> Number:\n        \"\"\"Returns the product of a and b.\"\"\"\n        return self.a * self.b\n\nclass ProductMetric:\n    \"\"\"Computes and stores the product and its absolute value.\"\"\"\n    def __init__(self, product_value: Number) -> None:\n        self.product_value = product_value\n        self.absolute_value = abs(product_value)\n\ndef max_product_tuple(input_list: List[Tuple[Number, Number]]) -> Number:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    \"\"\"\n    if not input_list:\n        raise ValueError(\"input_list must be non-empty\")\n\n    max_abs_value: Number = float('-inf')\n\n    for a, b in input_list:\n        tp = TuplePair(a, b)\n        prod = tp.product()\n        pm = ProductMetric(prod)\n        max_abs_value = max(max_abs_value, pm.absolute_value)\n\n    return max_abs_value"}
{"task_id": "Mbpp/123", "solution": "from amicable.calculator import AmicableCalculator\n\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of all amicable numbers up to a specified number n.\n    This function acts as the public API entry point.\n    \"\"\"\n    calculator = AmicableCalculator()\n    return calculator.amicable_numbers_sum(n)"}
{"task_id": "Mbpp/125", "solution": "import math\nfrom typing import List\n\nclass BinaryString:\n    \"\"\"Encapsulates a binary string and provides validation.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def validate(self) -> None:\n        \"\"\"Raises ValueError if the string contains non-binary characters.\"\"\"\n        if not all(char in ('0', '1') for char in self.value):\n            raise ValueError(\"Input string must contain only '0' or '1' characters.\")\n\nclass Substring:\n    \"\"\"Represents a contiguous substring with counts of zeros and ones.\"\"\"\n    def __init__(self, start_index: int, end_index: int, zeros_count: int, ones_count: int) -> None:\n        self.start_index = start_index\n        self.end_index = end_index\n        self.zeros_count = zeros_count\n        self.ones_count = ones_count\n\n    def diff(self) -> int:\n        \"\"\"Returns the difference (zeros_count - ones_count).\"\"\"\n        return self.zeros_count - self.ones_count\n\nclass Result:\n    \"\"\"Holds the integer result of the maximum difference calculation.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\ndef _kadane_transformed(values: List[int]) -> int:\n    \"\"\"Computes the maximum subarray sum using Kadane's algorithm.\"\"\"\n    if not values:\n        return 0\n\n    max_so_far = -math.inf\n    current_max = 0\n\n    for x in values:\n        current_max += x\n        if current_max > max_so_far:\n            max_so_far = current_max\n        if current_max < 0:\n            current_max = 0\n            \n    # Handle the case where all numbers are negative, Kadane's default returns 0.\n    # We need to return the largest single element in such a case.\n    if max_so_far == 0 and any(v < 0 for v in values):\n        return max(values)\n        \n    return max_so_far if max_so_far != -math.inf else 0\n\n\ndef find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring.\n    Applies Kadane's algorithm on a transformed array ('0' -> +1, '1' -> -1).\n    \"\"\"\n    binary_string = BinaryString(s)\n    binary_string.validate()\n\n    if not s:\n        return 0\n\n    transformed_values = []\n    for char in s:\n        if char == '0':\n            transformed_values.append(1)\n        else: # char == '1'\n            transformed_values.append(-1)\n\n    max_diff = _kadane_transformed(transformed_values)\n    return Result(max_diff).value"}
{"task_id": "Mbpp/124", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import Any\n\n@dataclass\nclass ComplexNumber:\n    \"\"\"\n    Represents a complex number with real and imaginary parts.\n    Provides a method to calculate its magnitude.\n    \"\"\"\n    real: float\n    imag: float\n\n    def magnitude(self) -> float:\n        \"\"\"Calculates the magnitude of the complex number.\"\"\"\n        return math.sqrt(self.real**2 + self.imag**2)\n\n@dataclass\nclass AngleResult:\n    \"\"\"Simple dataclass wrapper for the resulting angle in radians.\"\"\"\n    radians: float\n\ndef _parse_input(*args: Any) -> ComplexNumber:\n    \"\"\"Normalizes various input patterns into a ComplexNumber object.\"\"\"\n    if len(args) == 1:\n        arg = args[0]\n        if isinstance(arg, complex):\n            return ComplexNumber(float(arg.real), float(arg.imag))\n        raise TypeError(f\"Single argument must be a complex number, got {type(arg)}\")\n    elif len(args) == 2:\n        real_part_arg = args[0]\n        imag_part_arg = args[1]\n\n        real: float\n        imag: float\n\n        try:\n            real = float(real_part_arg)\n        except (TypeError, ValueError):\n            raise TypeError(f\"Real part must be a numeric type, got {type(real_part_arg)}\")\n\n        if isinstance(imag_part_arg, complex):\n            imag = float(imag_part_arg.imag)\n            if imag_part_arg.real != 0.0:\n                raise ValueError(\n                    f\"When the second argument is complex, it must represent only the imaginary part (e.g., 1j), got {imag_part_arg}\"\n                )\n        else:\n            try:\n                imag = float(imag_part_arg)\n            except (TypeError, ValueError):\n                raise TypeError(\n                    f\"Imaginary part must be a numeric type or a purely imaginary complex number (e.g., 1j), got {type(imag_part_arg)}\"\n                )\n        return ComplexNumber(real, imag)\n    else:\n        raise TypeError(f\"Expected 1 or 2 arguments, got {len(args)}\")\n\ndef _validate_complex(z: ComplexNumber) -> None:\n    \"\"\"Validates the complex number, ensuring non-zero magnitude.\"\"\"\n    if z.magnitude() == 0.0:\n        raise ValueError(\"Cannot calculate angle for a complex number with zero magnitude (0 + 0j).\")\n\ndef _compute_angle(z: ComplexNumber) -> float:\n    \"\"\"Computes the angle using math.atan2.\"\"\"\n    return math.atan2(z.imag, z.real)\n\ndef angle_complex(*args: Any) -> float:\n    \"\"\"\n    Calculates the angle (argument) of a complex number in radians.\n    Accepts a complex number as a single argument or its real and imaginary parts as two arguments.\n    \"\"\"\n    complex_num = _parse_input(*args)\n    _validate_complex(complex_num)\n    angle = _compute_angle(complex_num)\n    return angle"}
{"task_id": "Mbpp/126", "solution": "import math\n\ndef _positive_divisors(n: int) -> list[int]:\n    \"\"\"Return a list of all positive divisors for a given integer n.\n    Handles n=0 by returning an empty list.\"\"\"\n    if n == 0:\n        return []\n    \n    n_abs = abs(n)\n    divs = set()\n    for i in range(1, int(math.sqrt(n_abs)) + 1):\n        if n_abs % i == 0:\n            divs.add(i)\n            divs.add(n_abs // i)\n    return sorted(list(divs))\n\ndef _positive_common_divisors(a: int, b: int) -> list[int]:\n    \"\"\"Compute and return a list of positive integers dividing both operands.\"\"\"\n    divisors_a = set(_positive_divisors(a))\n    divisors_b = set(_positive_divisors(b))\n    return sorted(list(divisors_a.intersection(divisors_b)))\n\ndef sum(a: int, b: int) -> int:\n    \"\"\"Return the sum of all positive integers that divide both a and b.\"\"\"\n    common_divs = _positive_common_divisors(a, b)\n    return sum(common_divs)"}
{"task_id": "Mbpp/127", "solution": "def _ensure_int(x: object, name: str) -> None:\n    \"\"\"Raise TypeError if x is not int.\"\"\"\n    if not isinstance(x, int):\n        raise TypeError(f\"{name} must be int\")\n\ndef multiply_int(a: int, b: int) -> int:\n    \"\"\"Return integer product of a and b. Enforces that inputs are ints.\"\"\"\n    _ensure_int(a, 'a')\n    _ensure_int(b, 'b')\n    return a * b"}
{"task_id": "Mbpp/128", "solution": "def long_words(n, s) -> list:\n    \"\"\"\n    Finds words from a string that are longer than n characters.\n    Splits the string by spaces, filters words by length, and preserves original order.\n    \"\"\"\n    tokens = s.split(' ')\n    result = []\n    for token in tokens:\n        if len(token) > n:\n            result.append(token)\n    return result"}
{"task_id": "Mbpp/129", "solution": "from typing import List\n\nclass ValidationResult:\n    \"\"\"Simple data holder representing the result of validating matrix squareness.\"\"\"\n    def __init__(self, is_square: bool, reason: str = \"\") -> None:\n        self.is_square = is_square\n        self.reason = reason\n\nclass Matrix:\n    \"\"\"Domain wrapper for a two-dimensional integer matrix, providing accessors and sum computations.\"\"\"\n    def __init__(self, data: List[List[int]]) -> None:\n        self._data = data\n        self._n = len(data) if data else 0\n\n    def is_square(self) -> bool:\n        \"\"\"Returns True if the matrix is non-empty and square (n x n); False otherwise.\"\"\"\n        if not self._data:\n            return False\n        # Check if _data is actually a list and not empty\n        if not isinstance(self._data, list):\n            return False\n\n        for row_list in self._data:\n            if not isinstance(row_list, list) or len(row_list) != self._n:\n                return False\n        return True\n\n    def row(self, i: int) -> List[int]:\n        \"\"\"Returns the list of elements for the specified row index.\"\"\"\n        return self._data[i]\n\n    def column(self, j: int) -> List[int]:\n        \"\"\"Returns the list of elements for the specified column index.\"\"\"\n        return [self._data[i][j] for i in range(self._n)]\n\n    def row_sum(self, i: int) -> int:\n        \"\"\"Returns the integer sum of the elements in the specified row.\"\"\"\n        return sum(self._data[i])\n\n    def col_sum(self, j: int) -> int:\n        \"\"\"Returns the integer sum of the elements in the specified column.\"\"\"\n        return sum(self.column(j))\n\n    def diag_lr_sum(self) -> int:\n        \"\"\"Returns the sum of elements along the left-to-right main diagonal.\"\"\"\n        return sum(self._data[i][i] for i in range(self._n))\n\n    def diag_rl_sum(self) -> int:\n        \"\"\"Returns the sum of elements along the right-to-left main diagonal.\"\"\"\n        return sum(self._data[i][self._n - 1 - i] for i in range(self._n))\n\nclass MagicSquareChecker:\n    \"\"\"Implements the core verification logic for magic squares.\"\"\"\n    def magic_square_test(self, matrix: Matrix) -> bool:\n        \"\"\"Verifies if the given Matrix object represents a magic square.\"\"\"\n        if not matrix.is_square():\n            return False\n\n        target = self._compute_target_sum(matrix)\n        \n        if not self._verify_rows(matrix, target):\n            return False\n        if not self._verify_columns(matrix, target):\n            return False\n        if not self._verify_diagonals(matrix, target):\n            return False\n        \n        return True\n\n    def _compute_target_sum(self, matrix: Matrix) -> int:\n        \"\"\"Computes the target sum based on the first row of the matrix.\"\"\"\n        return matrix.row_sum(0)\n\n    def _verify_rows(self, matrix: Matrix, target: int) -> bool:\n        \"\"\"Verifies that all row sums equal the target sum.\"\"\"\n        n = matrix._n\n        for i in range(n):\n            if matrix.row_sum(i) != target:\n                return False\n        return True\n\n    def _verify_columns(self, matrix: Matrix, target: int) -> bool:\n        \"\"\"Verifies that all column sums equal the target sum.\"\"\"\n        n = matrix._n\n        for j in range(n):\n            if matrix.col_sum(j) != target:\n                return False\n        return True\n\n    def _verify_diagonals(self, matrix: Matrix, target: int) -> bool:\n        \"\"\"Verifies that both main diagonal sums equal the target sum.\"\"\"\n        if matrix.diag_lr_sum() != target:\n            return False\n        if matrix.diag_rl_sum() != target:\n            return False\n        return True\n\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"\n    Calculates whether the input matrix is a magic square.\n\n    Returns True if the matrix is a non-empty square and all rows, columns,\n    and both main diagonals sum to the same target value (first row's sum); False otherwise.\n    \"\"\"\n    if not isinstance(matrix, list) or not matrix:\n        return False\n\n    # The Matrix constructor and is_square method handle detailed structural validation.\n    # Per design, specific element type checks (e.g., if a list contains non-ints) are\n    # implicitly handled by sum operations or not explicitly checked at this layer.\n    matrix_obj = Matrix(matrix)\n    checker = MagicSquareChecker()\n    return checker.magic_square_test(matrix_obj)"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(lst):\n    # Counts the frequency of each item in the list.\n    counts = {}\n    for item in lst:\n        counts[item] = counts.get(item, 0) + 1\n\n    # Finds the item with the highest frequency.\n    max_item = None\n    max_count = -1\n\n    for item, count in counts.items():\n        if count > max_count:\n            max_count = count\n            max_item = item\n\n    return max_item"}
{"task_id": "Mbpp/133", "solution": "from typing import List, Union\n\nNumber = Union[int, float]\n\nclass InputValidator:\n    def validate(self, numbers) -> bool:\n        \"\"\"Validates that the input is a list of numbers, raising ValueError if invalid.\"\"\"\n        if not isinstance(numbers, list):\n            raise ValueError(\"Input must be a list.\")\n        for item in numbers:\n            if not isinstance(item, (int, float)):\n                raise ValueError(\"All elements in the list must be numbers (int or float).\")\n        return True\n\nclass NegativeNumber:\n    def __init__(self, value: Number):\n        \"\"\"Initializes a NegativeNumber with a numeric value.\"\"\"\n        self.value = value\n\n    def is_negative(self) -> bool:\n        \"\"\"Checks if the stored value is strictly negative.\"\"\"\n        return self.value < 0\n\nclass NumberList:\n    def __init__(self, numbers: List[Number]):\n        \"\"\"Initializes a NumberList with a list of numbers.\"\"\"\n        self.numbers = numbers\n\n    def get_negative_numbers(self) -> List[Number]:\n        \"\"\"Filters and returns a list of strictly negative numbers.\"\"\"\n        negative_values = []\n        for num in self.numbers:\n            if NegativeNumber(num).is_negative():\n                negative_values.append(num)\n        return negative_values\n\nclass Result:\n    def __init__(self, value: Number):\n        \"\"\"Stores the final numeric result.\"\"\"\n        self.value = value\n\nclass SumNegativeNumFunction:\n    def sum_negativenum(self, numbers: List[Number]) -> Number:\n        \"\"\"Orchestrates validation, filtering, and summation of negative numbers.\"\"\"\n        InputValidator().validate(numbers)\n        \n        number_list_obj = NumberList(numbers)\n        negative_numbers = number_list_obj.get_negative_numbers()\n        \n        total_sum = sum(negative_numbers)\n        \n        return Result(total_sum).value\n\ndef sum_negativenum(numbers: List[Number]) -> Number:\n    \"\"\"Calculates the sum of negative numbers in the given list.\"\"\"\n    return SumNegativeNumFunction().sum_negativenum(numbers)"}
{"task_id": "Mbpp/131", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\ndef is_vowel(c: str) -> bool:\n    \"\"\"Checks if a character is a vowel (a, e, i, o, u, case-insensitive).\"\"\"\n    return c in VOWELS\n\ndef reverse_vowels(s: str) -> str:\n    \"\"\"Reverses only the vowels in a given string, preserving non-vowel positions and character case.\"\"\"\n    if not s or len(s) == 1:\n        return s\n\n    chars = list(s)\n    vowel_indices = []\n    vowel_chars = []\n\n    for i, char in enumerate(chars):\n        if is_vowel(char):\n            vowel_indices.append(i)\n            vowel_chars.append(char)\n\n    vowel_chars.reverse()\n\n    for idx, char_to_place in zip(vowel_indices, vowel_chars):\n        chars[idx] = char_to_place\n\n    return ''.join(chars)"}
{"task_id": "Mbpp/135", "solution": "class ValidationError(Exception):\n    \"\"\"Exception type representing validation errors for input.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n\nclass HexagonalNumberFunction:\n    \"\"\"Encapsulates logic for validating input and computing hexagonal numbers.\"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"Validate n and compute H_n = n * (2 * n - 1).\n           Raises ValidationError for invalid input.\n        \"\"\"\n        if not isinstance(n, int):\n            raise ValidationError(\"input must be an integer\")\n        if n < 1:\n            raise ValidationError(\"n must be >= 1\")\n        return n * (2 * n - 1)\n\ndef hexagonal_num(n: int) -> int:\n    \"\"\"Calculates the nth hexagonal number using the formula H_n = n * (2 * n - 1).\"\"\"\n    func = HexagonalNumberFunction()\n    return func.compute(n)"}
{"task_id": "Mbpp/132", "solution": "class TupleInput:\n    \"\"\"Wraps a Python tuple to provide convenience accessors.\"\"\"\n    def __init__(self, elements: tuple):\n        self.elements = elements\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the tuple is empty.\"\"\"\n        return not self.elements\n\n    def element_count(self) -> int:\n        \"\"\"Returns the number of elements in the tuple.\"\"\"\n        return len(self.elements)\n\n    def get_elements(self) -> tuple:\n        \"\"\"Returns the wrapped tuple elements.\"\"\"\n        return self.elements\n\nclass StringOutput:\n    \"\"\"Wraps a string result and provides accessors.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self.value)\n\n    def as_str(self) -> str:\n        \"\"\"Returns the wrapped string value.\"\"\"\n        return self.value\n\nclass Validator:\n    \"\"\"Performs validation checks on input data.\"\"\"\n    def validate_is_tuple(self, value) -> None:\n        \"\"\"Raises TypeError if the value is not a tuple.\"\"\"\n        if not isinstance(value, tuple):\n            raise TypeError(\"Input must be a tuple.\")\n\n    def validate_elements_are_single_char_strings(self, elements: tuple) -> None:\n        \"\"\"Raises ValueError if any element is not a single-character string.\"\"\"\n        for element in elements:\n            if not isinstance(element, str) or len(element) != 1:\n                raise ValueError(\"All tuple elements must be single-character strings.\")\n\ndef tup_string(input_tuple: tuple) -> str:\n    \"\"\"\n    Converts a tuple of single-character strings into a concatenated string.\n    Raises TypeError for non-tuple input or ValueError for invalid elements.\n    \"\"\"\n    Validator().validate_is_tuple(input_tuple)\n    tuple_input = TupleInput(input_tuple)\n    Validator().validate_elements_are_single_char_strings(tuple_input.get_elements())\n    result = ''.join(tuple_input.get_elements())\n    return StringOutput(result).as_str()"}
{"task_id": "Mbpp/137", "solution": "from typing import List\n\ndef zero_count(values: List[int]) -> float:\n    \"\"\"\n    Calculates the ratio of zero elements to non-zero elements in a list of integers.\n    Raises ZeroDivisionError if there are no non-zero elements.\n    \"\"\"\n    num_zeros = sum(1 for v in values if v == 0)\n    num_non_zeros = sum(1 for v in values if v != 0)\n\n    if num_non_zeros == 0:\n        raise ZeroDivisionError(\"Cannot calculate ratio: no non-zero elements found.\")\n\n    return num_zeros / num_non_zeros"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(n):\n    \"\"\"\n    Checks if the given number can be represented as a sum of distinct non-zero powers of 2.\n    Returns False for non-integer inputs or numbers less than 1.\n    \"\"\"\n    # Validate type: n must be an integer and not a boolean.\n    if not isinstance(n, int) or isinstance(n, bool):\n        return False\n\n    # Validate range: n must be greater than or equal to 1.\n    if n < 1:\n        return False\n\n    # Any positive integer can be uniquely represented as a sum of distinct powers of two\n    # (its canonical binary decomposition).\n    return True"}
{"task_id": "Mbpp/139", "solution": "import math\nfrom typing import Any\n\nclass MathConstants:\n    PI: float = math.pi\nPI = MathConstants.PI\n\nclass Validator:\n    @staticmethod\n    def isNumeric(v: Any) -> bool:\n        # Accept int or float; ensure finiteness (not NaN/Inf).\n        return isinstance(v, (int, float)) and not (math.isinf(v) or math.isnan(v))\n\nclass Result:\n    def __init__(self, value: float, units: str = \"\") -> None:\n        self._value = float(value)\n        self._units = units\n    def asFloat(self) -> float:\n        return self._value\n\nclass Circle:\n    def __init__(self, radius: float = 0.0) -> None:\n        self._radius = float(radius)\n    def setRadius(self, r: float) -> None:\n        self._radius = float(r)\n    def getRadius(self) -> float:\n        return self._radius\n    def getCircumference(self) -> float:\n        return 2 * PI * self._radius\n\ndef circle_circumference(radius):\n    if not Validator.isNumeric(radius):\n        raise TypeError(\"radius must be numeric\")\n    c = Circle(float(radius))\n    return Result(c.getCircumference()).asFloat()"}
{"task_id": "Mbpp/140", "solution": "from typing import Iterable, Any\nfrom collections.abc import Iterable as IterableABC\n\ndef extract_singly(iterable: Iterable[Iterable[Any]]) -> set:\n    \"\"\"Flatten an iterable of iterables into a set of unique numeric values.\n\n    Raises:\n        TypeError: if top-level is not iterable, if any inner element is not iterable, or if any inner item is not numeric.\n    \"\"\"\n    if not isinstance(iterable, IterableABC):\n        raise TypeError(\"input must be an iterable of iterables of numbers\")\n\n    result = set()\n    for inner in iterable:\n        if not isinstance(inner, IterableABC):\n            raise TypeError(\"each element of input must be an iterable of numbers\")\n        for item in inner:\n            if not isinstance(item, (int, float)):\n                raise TypeError(\"inner iterable elements must be numeric\")\n            result.add(item)\n    return result"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(seq):\n    \"\"\"Return the maximum absolute difference between any two numeric elements in seq.\n\n    If len(seq) < 2, return 0. Handles type and value validation.\n    \"\"\"\n    if not isinstance(seq, (list, tuple)):\n        raise TypeError(\"seq must be a list or tuple\")\n\n    if len(seq) < 2:\n        return 0\n\n    # Initialize min_val and max_val with the first element\n    first_element = seq[0]\n    if not isinstance(first_element, (int, float)):\n        raise ValueError(\"all elements must be int or float\")\n    min_val = first_element\n    max_val = first_element\n\n    # Iterate through the remaining elements to find the true min and max\n    for e in seq[1:]:\n        if not isinstance(e, (int, float)):\n            raise ValueError(\"all elements must be int or float\")\n        if e < min_val:\n            min_val = e\n        if e > max_val:\n            max_val = e\n\n    return max_val - min_val"}
{"task_id": "Mbpp/141", "solution": "class SortingError(Exception):\n    \"\"\"Exception raised for errors during sorting due to non-comparable elements.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self):\n        return self.message\n\ndef _are_elements_mutually_comparable(arr):\n    \"\"\"Checks if all elements in the array are mutually comparable.\"\"\"\n    if len(arr) <= 1:\n        return True\n    try:\n        # Attempt to sort a small sample or the whole array to check comparability.\n        # This will raise TypeError if elements are not mutually comparable.\n        # Using sorted(arr) is the most robust way to check all necessary comparisons.\n        _ = sorted(arr)\n        return True\n    except TypeError:\n        return False\n\ndef _index_of_max(arr, n):\n    \"\"\"Finds the index of the maximum element in the prefix arr[0...n-1].\"\"\"\n    max_idx = 0\n    for i in range(1, n):\n        if arr[i] > arr[max_idx]:\n            max_idx = i\n    return max_idx\n\ndef _flip_prefix(arr, k):\n    \"\"\"Reverses the prefix arr[0...k-1] in-place.\"\"\"\n    start = 0\n    end = k - 1\n    while start < end:\n        arr[start], arr[end] = arr[end], arr[start]\n        start += 1\n        end -= 1\n\ndef pancake_sort(list):\n    \"\"\"Sorts a list of elements using the Pancake Sort algorithm.\"\"\"\n    if not list:\n        return []\n\n    arr = list[:] # Create a copy to perform in-place sorting and preserve original list.\n\n    if not _are_elements_mutually_comparable(arr):\n        raise SortingError(\"Elements in the list are not mutually comparable.\")\n\n    n = len(arr)\n    # Start from the largest element and move it to its correct position.\n    for curr_size in range(n, 1, -1):\n        # Find the index of the maximum element in the current sub-array arr[0...curr_size-1].\n        max_idx = _index_of_max(arr, curr_size)\n\n        # If the maximum element is not already at its correct position (end of current sub-array).\n        if max_idx != curr_size - 1:\n            # Flip the prefix from 0 to max_idx to bring the maximum element to the front.\n            _flip_prefix(arr, max_idx + 1)\n            # Flip the entire current sub-array to move the maximum element to its sorted position.\n            _flip_prefix(arr, curr_size)\n            \n    return arr"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(a: list, b: list, c: list) -> int:\n    \"\"\"Counts items identical in the same position across three lists, up to the shortest list's length.\"\"\"\n    if not isinstance(a, list) or not isinstance(b, list) or not isinstance(c, list):\n        raise TypeError(\"count_samepair requires three list arguments\")\n\n    minlen = min(len(a), len(b), len(c))\n    count = 0\n\n    for i in range(minlen):\n        if a[i] == b[i] == c[i]:\n            count += 1\n\n    return count"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(source, to_remove):\n    \"\"\"Return a new list with elements from source not present in to_remove.\n    The function will not modify the input lists in-place and will preserve relative order.\n    \"\"\"\n    elements_to_remove_set = set(to_remove)\n    result = []\n    for item in source:\n        if item not in elements_to_remove_set:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of (n - 2*i) for i from 0 to n // 2.\n    Includes zero-valued terms if produced.\n    \"\"\"\n    total_sum = 0\n    # The loop runs for i from 0 up to n // 2 (inclusive)\n    for i in range(0, n // 2 + 1):\n        term = n - (2 * i)\n        total_sum += term\n    return total_sum"}
{"task_id": "Mbpp/160", "solution": "from dataclasses import dataclass\nfrom typing import Tuple, Optional\n\n@dataclass\nclass ExtendedEuclidResult:\n    x0: int\n    y0: int\n    g: int\n\n@dataclass\nclass Solution:\n    x: int\n    y: int\n\ndef gcd(a: int, b: int) -> int:\n    \"\"\"\n    Computes the greatest common divisor of a and b using the iterative Euclidean algorithm.\n    Returns a non-negative integer.\n    \"\"\"\n    while b != 0:\n        a, b = b, a % b\n    return abs(a)\n\ndef extended_gcd(a: int, b: int) -> ExtendedEuclidResult:\n    \"\"\"\n    Computes x0, y0, g such that a*x0 + b*y0 = g via extended Euclidean algorithm.\n    Returns ExtendedEuclidResult(x0, y0, g) with g non-negative.\n    \"\"\"\n    if a == 0:\n        # For a=0, g = abs(b). The equation 0*x0 + b*y0 = abs(b) implies y0 = sign(b)\n        return ExtendedEuclidResult(0, 1 if b >= 0 else -1, abs(b))\n    if b == 0:\n        # For b=0, g = abs(a). The equation a*x0 + 0*y0 = abs(a) implies x0 = sign(a)\n        return ExtendedEuclidResult(1 if a >= 0 else -1, 0, abs(a))\n\n    # Standard iterative extended Euclidean algorithm\n    x0, y0 = 1, 0  # Coefficients for a\n    x1, y1 = 0, 1  # Coefficients for b\n\n    current_a, current_b = a, b\n\n    while current_b != 0:\n        q = current_a // current_b\n        \n        current_a, current_b = current_b, current_a % current_b\n        \n        x0_temp, y0_temp = x0, y0\n        x0, y0 = x1, y1\n        x1 = x0_temp - q * x1\n        y1 = y0_temp - q * y1\n    \n    # At this point, current_a holds the GCD (g), and x0, y0 are its coefficients\n    # a*x0 + b*y0 = g\n    \n    # Ensure g is non-negative. If current_a is negative, negate coefficients too.\n    g_val = current_a\n    if g_val < 0:\n        g_val = -g_val\n        x0 = -x0\n        y0 = -y0\n\n    return ExtendedEuclidResult(x0, y0, g_val)\n\ndef _canonicalize_solution(x_part: int, y_part: int, a: int, b: int, g: int) -> Solution:\n    \"\"\"\n    Canonicalizes a particular solution (x_part, y_part) to a solution (x, y)\n    such that 0 <= x < abs(b // g).\n    This function is called only when a != 0 and b != 0, and g is positive.\n    \"\"\"\n    # General solution form: x = x_part + (b/g)*t, y = y_part - (a/g)*t\n    b_coeff = b // g  # This is the 'step' for x in the general solution\n    a_coeff = a // g  # This is the 'step' for y in the general solution\n\n    # The modulus for x is abs(b_coeff). It's always positive since b != 0.\n    modulus = abs(b_coeff)\n\n    # We want x_final = x_part + b_coeff * t such that 0 <= x_final < modulus.\n    # Python's % operator behaves such that for `x % m` where `m > 0`, the result is in `[0, m-1]`.\n    # This matches our desired `[0, modulus)` range for `x`.\n    rem_x = x_part % modulus\n    \n    # Calculate t. We know `rem_x - x_part` is a multiple of `modulus`.\n    # Since `modulus = abs(b_coeff)`, `rem_x - x_part` is a multiple of `b_coeff`.\n    t = (rem_x - x_part) // b_coeff\n    \n    x_final = x_part + b_coeff * t\n    y_final = y_part - a_coeff * t\n    \n    return Solution(x_final, y_final)\n\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple,\n    or returns None if no solution exists.\n    \"\"\"\n    # Handle degenerate cases first (BR6/BR7)\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n    \n    if a == 0:  # and b != 0\n        return (0, n // b) if n % b == 0 else None\n\n    if b == 0:  # and a != 0\n        return (n // a, 0) if n % a == 0 else None\n\n    # Compute g = gcd(a, b) (BR3)\n    g = gcd(a, b)\n\n    # If n is not divisible by g, no integer solution exists (BR3)\n    if n % g != 0:\n        return None\n\n    # Compute x0, y0 for a*x0 + b*y0 = g using extended Euclidean algorithm (BR4)\n    extended_result = extended_gcd(a, b)\n    x0, y0 = extended_result.x0, extended_result.y0\n    \n    # Scale x0, y0 to find a particular solution for a*x + b*y = n (BR4)\n    k = n // g\n    x_part = x0 * k\n    y_part = y0 * k\n\n    # Canonicalize the particular solution (x_part, y_part) (BR5)\n    canonical_solution = _canonicalize_solution(x_part, y_part, a, b, g)\n\n    return (canonical_solution.x, canonical_solution.y)"}
{"task_id": "Mbpp/168", "solution": "from typing import Any, Iterable\n\ndef frequency(list: Iterable[Any], value: Any) -> int:\n    \"\"\"\n    Counts the number of occurrences of a number in a given list.\n    Compares elements using equality (==).\n    \"\"\"\n    count = 0\n    for item in list:\n        if item == value:\n            count += 1\n    return count"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(elements: list[int]) -> int:\n    \"\"\"Return the count of unordered pairs (i < j) whose bitwise XOR is even.\n    The XOR of two numbers is even if and only if both numbers have the same parity.\n    \"\"\"\n    if len(elements) < 2:\n        return 0\n\n    even_count = 0\n    odd_count = 0\n\n    for num in elements:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # The number of pairs with an even XOR is the sum of pairs of even numbers\n    # and pairs of odd numbers, as even ^ even = even, and odd ^ odd = even.\n    pairs_with_even_xor = (even_count * (even_count - 1) // 2) + \\\n                          (odd_count * (odd_count - 1) // 2)\n\n    return pairs_with_even_xor"}
{"task_id": "Mbpp/165", "solution": "from typing import Optional\n\nclass AlphabetLetter:\n    \"\"\"Container mapping position to letter.\"\"\"\n    def __init__(self, position: int, letter: str):\n        self.position = position\n        self.letter = letter\n\nclass Alphabet:\n    \"\"\"Provide mapping from 1-based positions to alphabet letters a..z.\"\"\"\n    def __init__(self):\n        self.letters: list[AlphabetLetter] = []\n        for i in range(26):\n            self.letters.append(AlphabetLetter(i + 1, chr(ord('a') + i)))\n\n    def letterAtPosition(self, pos: int) -> Optional[str]:\n        \"\"\"Return the letter at the given 1-based position, or None if out of range.\"\"\"\n        if 1 <= pos <= 26:\n            return self.letters[pos - 1].letter\n        return None\n\nclass Character:\n    \"\"\"Represent a single character plus normalization and position metadata.\"\"\"\n    def __init__(self, value: str, positionInString: int):\n        self.value = value\n        self.positionInString = positionInString\n\n    def normalize(self) -> str:\n        \"\"\"Return the lowercase version of the character.\"\"\"\n        return self.value.lower()\n\nclass InputString:\n    \"\"\"Represent the input string and provide length and character access.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Return the length of the string.\"\"\"\n        return len(self.value)\n\n    def char_at(self, index_1_based: int) -> 'Character':\n        \"\"\"Return a Character object at the given 1-based index.\"\"\"\n        return Character(self.value[index_1_based - 1], index_1_based)\n\nclass ComparisonResult:\n    \"\"\"Represent per-character comparison result.\"\"\"\n    def __init__(self, position: int, isMatch: bool):\n        self.position = position\n        self.isMatch = isMatch\n\nclass MatchCounter:\n    \"\"\"Accumulate total matches.\"\"\"\n    def __init__(self):\n        self.count = 0\n\n    def increment(self) -> None:\n        \"\"\"Increment the match count.\"\"\"\n        self.count += 1\n\n    def value(self) -> int:\n        \"\"\"Return the current match count.\"\"\"\n        return self.count\n\nclass CountCharPositionFunction:\n    \"\"\"Encapsulate the algorithm to count matching characters.\"\"\"\n    @staticmethod\n    def count_char_position(input_string: 'InputString') -> int:\n        \"\"\"\n        Iterate characters, normalize, compare to alphabet (1-based),\n        and aggregate count.\n        \"\"\"\n        alphabet = Alphabet()\n        match_counter = MatchCounter()\n        \n        for i in range(1, input_string.length() + 1):\n            char_obj = input_string.char_at(i)\n            normalized_char = char_obj.normalize()\n            alphabet_letter = alphabet.letterAtPosition(i)\n\n            if alphabet_letter is not None and normalized_char == alphabet_letter:\n                match_counter.increment()\n                \n        return match_counter.value()\n\ndef count_char_position(input: str) -> int:\n    \"\"\"\n    Count the number of characters in a string that occur at the same position\n    in the string as in the English alphabet (case insensitive).\n    \"\"\"\n    input_string_obj = InputString(value=input)\n    return CountCharPositionFunction.count_char_position(input_string_obj)"}
{"task_id": "Mbpp/167", "solution": "def validate_input(n: int) -> None:\n    \"\"\"Validates that the input n is a non-negative integer.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\ndef _is_power_of_two(n: int) -> bool:\n    \"\"\"Checks if n is a power of two for n > 0.\"\"\"\n    return n > 0 and (n & (n - 1) == 0)\n\ndef _compute_next_power(n: int) -> int:\n    \"\"\"Computes the smallest power of two greater than or equal to n, for n > 0 and not a power of two.\"\"\"\n    power = 1\n    while power < n:\n        power *= 2\n    return power\n\ndef next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Returns 1 for n == 0.\n    \"\"\"\n    validate_input(n)\n\n    if n == 0:\n        return 1\n\n    if _is_power_of_two(n):\n        return n\n    else:\n        return _compute_next_power(n)"}
{"task_id": "Mbpp/171", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass Pentagon:\n    side_length: float\n\n    def perimeter(self) -> float:\n        \"\"\"Return numeric perimeter computed as 5 * side_length.\"\"\"\n        return 5 * self.side_length\n\ndef perimeter_pentagon(side_length):\n    \"\"\"Compute and return the perimeter of a regular pentagon equal to 5 * side_length.\"\"\"\n    p = Pentagon(side_length)\n    return p.perimeter()"}
{"task_id": "Mbpp/170", "solution": "def sum_range_list(list, start_index, end_index):\n    \"\"\"\n    Calculates the sum of numbers in a list within a specified inclusive range.\n    \"\"\"\n    return sum(list[start_index : end_index + 1])"}
{"task_id": "Mbpp/172", "solution": "class InputString:\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\nclass Substring:\n    def __init__(self, value: str = 'std'):\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\nclass MatchResult:\n    def __init__(self, count: int):\n        self.count = count\n\nclass CountOccuranceFunction:\n    def __init__(self, pattern: Substring = None):\n        self._pattern = pattern if pattern is not None else Substring('std')\n\n    def count(self, input_string: InputString) -> MatchResult:\n        \"\"\"Counts non-overlapping occurrences of the substring in the input string.\"\"\"\n        count = input_string.value.count(self._pattern.value)\n        return MatchResult(count)\n\ndef count_occurance(input: str) -> int:\n    \"\"\"\n    Counts the number of occurrences of the substring 'std' in a given string.\n    \"\"\"\n    input_str_obj = InputString(input)\n    counter = CountOccuranceFunction()\n    result = counter.count(input_str_obj)\n    return result.count"}
{"task_id": "Mbpp/222", "solution": "def _is_homogeneous(t: tuple) -> bool:\n    \"\"\"Return True if all element types are equal; empty tuple returns True.\"\"\"\n    if not t:\n        return True\n    first_type = type(t[0])\n    for item in t[1:]:\n        if type(item) is not first_type:\n            return False\n    return True\n\ndef check_type(t: tuple) -> bool:\n    \"\"\"Validate input is tuple, raise TypeError otherwise; return boolean result.\"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(\"input must be tuple\")\n    return _is_homogeneous(t)"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(n):\n    \"\"\"Counts the number of set bits (1s) in the binary representation of a given integer.\n    The function operates on the absolute value of the input number.\n    \"\"\"\n    x = abs(int(n))\n    count = 0\n    while x:\n        x &= (x - 1)\n        count += 1\n    return count"}
{"task_id": "Mbpp/223", "solution": "from typing import List, Any\n\ndef _first_occurrence(arr: List[Any], n: int, x: Any) -> int:\n    \"\"\"Finds the first occurrence of x in arr[0:n] using binary search.\"\"\"\n    low = 0\n    high = n - 1\n    result = -1\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            result = mid\n            high = mid - 1  # Look for an earlier occurrence\n        elif arr[mid] < x:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result\n\ndef _last_occurrence(arr: List[Any], n: int, x: Any) -> int:\n    \"\"\"Finds the last occurrence of x in arr[0:n] using binary search.\"\"\"\n    low = 0\n    high = n - 1\n    result = -1\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            result = mid\n            low = mid + 1  # Look for a later occurrence\n        elif arr[mid] < x:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result\n\ndef is_majority(arr: List[Any], n: int, x: Any) -> bool:\n    \"\"\"\n    Determines if an element x is the majority element in a sorted array arr of length n.\n    An element is a majority element if it occurs more than n/2 times.\n    \"\"\"\n    first_idx = _first_occurrence(arr, n, x)\n    if first_idx == -1:\n        return False  # Element not found\n    \n    last_idx = _last_occurrence(arr, n, x)\n    \n    occurrences = last_idx - first_idx + 1\n    return occurrences > n / 2"}
