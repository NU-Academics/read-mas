{"task_id": "Mbpp/763", "solution": "class InputValidationError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message):\n        super().__init__(message)\n        self.message = message\n\ndef find_min_diff(array, n):\n    \"\"\"\n    Finds the minimum absolute difference between any two distinct elements in a given array.\n    This function validates inputs and computes the minimum difference using a sort-and-scan approach.\n    \"\"\"\n    if not isinstance(n, int) or n != len(array):\n        raise InputValidationError(\"n does not equal len(array)\")\n\n    if len(array) < 2:\n        raise InputValidationError(\"insufficient elements: require at least 2\")\n\n    for i, item in enumerate(array):\n        if not isinstance(item, (int, float)):\n            raise InputValidationError(f\"non-numeric element at index {i}: {item}\")\n\n    numbers = list(array)\n    numbers.sort()\n\n    min_diff = float('inf')\n    for i in range(len(numbers) - 1):\n        diff = abs(numbers[i] - numbers[i+1])\n        min_diff = min(min_diff, diff)\n\n    return min_diff"}
{"task_id": "Mbpp/764", "solution": "class DigitCharacter:\n    \"\"\"Represents a character and can test if it's an ASCII digit.\"\"\"\n    def __init__(self, char: str):\n        self.char = char\n\n    def is_ascii_digit(self) -> bool:\n        \"\"\"Checks if the character is an ASCII digit ('0'-'9').\"\"\"\n        return '0' <= self.char <= '9'\n\nclass InputString:\n    \"\"\"Simple data holder for the input string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass NumberCounter:\n    \"\"\"Scans an input string and produces an integer count of ASCII digits.\"\"\"\n    name: str = \"number_ctr\"\n\n    def count_digits(self, input_str: str) -> int:\n        \"\"\"Counts ASCII digits in the provided string.\"\"\"\n        count = 0\n        for char in input_str:\n            digit_char = DigitCharacter(char)\n            if digit_char.is_ascii_digit():\n                count += 1\n        return count\n\ndef number_ctr(input_string: str) -> int:\n    \"\"\"Counts the number of ASCII digits in a given string.\"\"\"\n    counter = NumberCounter()\n    return counter.count_digits(input_string)"}
{"task_id": "Mbpp/765", "solution": "import math\n\nclass InputValidator:\n    \"\"\"Validates input to ensure it's a positive integer.\"\"\"\n    def validate_positive_integer(self, n: int) -> bool:\n        return isinstance(n, int) and n >= 1\n\nclass PowerOfTwoChecker:\n    \"\"\"Determines if a given integer is a power of two.\"\"\"\n    def is_power_of_two(self, x: int) -> bool:\n        if x <= 0:\n            return False\n        return (x & (x - 1)) == 0\n\nclass NumberSequence:\n    \"\"\"Maintains an ordered list of polite numbers.\"\"\"\n    def __init__(self):\n        self.sequence: list[int] = []\n\n    def append(self, x: int) -> None:\n        self.sequence.append(x)\n\n    def get(self, n: int) -> int:\n        # n is 1-based index\n        return self.sequence[n - 1]\n\nclass PoliteNumberGenerator:\n    \"\"\"Generates and retrieves nth polite numbers.\"\"\"\n    def __init__(self):\n        self.validator = InputValidator()\n        self.pow_checker = PowerOfTwoChecker()\n        self.sequence = NumberSequence()\n\n    def is_polite(self, n: int) -> int:\n        if not self.validator.validate_positive_integer(n):\n            raise ValueError(\"n must be a positive integer (n >= 1)\")\n        self.generate_until(n)\n        return self.sequence.get(n)\n\n    def generate_until(self, n: int) -> list[int]:\n        current_num = 1\n        while len(self.sequence.sequence) < n:\n            if not self.pow_checker.is_power_of_two(current_num):\n                self.sequence.append(current_num)\n            current_num += 1\n        return self.sequence.sequence\n\ndef is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number.\n    Polite numbers are positive integers that are not powers of two.\n    \"\"\"\n    return PoliteNumberGenerator().is_polite(n)"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(items: list) -> list:\n    \"\"\"Return a list of consecutive 2-element tuples from items without mutating items.\n    Returns an empty list if the input list has fewer than two elements.\n    \"\"\"\n    if len(items) < 2:\n        return []\n    \n    return [(items[i], items[i+1]) for i in range(len(items) - 1)]"}
{"task_id": "Mbpp/767", "solution": "import collections\nimport itertools\n\n\ndef get_pairs_count(list_of_numbers, target_sum):\n    \"\"\"\n    Counts pairs in list_of_numbers that sum to target_sum.\n    Returns 0 for lists with fewer than two elements.\n    \"\"\"\n    if len(list_of_numbers) < 2:\n        return 0\n\n    count = 0\n    num_map = collections.defaultdict(int)\n\n    for num in list_of_numbers:\n        complement = target_sum - num\n        count += num_map[complement]\n        num_map[num] += 1\n\n    return count"}
{"task_id": "Mbpp/769", "solution": "from typing import List, Any\n\ndef validate_inputs(list1: List[Any], list2: List[Any]) -> None:\n    \"\"\"Raises TypeError if inputs are not instances of Python's list type.\"\"\"\n    if not isinstance(list1, list) or not isinstance(list2, list):\n        raise TypeError(\"Both inputs must be lists.\")\n\ndef compute_difference(list1: List[Any], list2: List[Any]) -> List[Any]:\n    \"\"\"\n    Returns a new list with elements from list1 that are not present in list2,\n    preserving the original order of list1.\n    \"\"\"\n    result_list = []\n    # Convert list2 to a set for efficient lookup\n    set2 = set(list2)\n    for item in list1:\n        if item not in set2:\n            result_list.append(item)\n    return result_list\n\ndef Diff(list1: List[Any], list2: List[Any]) -> List[Any]:\n    \"\"\"\n    Returns a new list containing elements from list1 that are not present in list2.\n    Input lists are validated and not mutated.\n    \"\"\"\n    validate_inputs(list1, list2)\n    return compute_difference(list1, list2)"}
{"task_id": "Mbpp/770", "solution": "def _fourth_power(x: int) -> int:\n    \"\"\"Returns the fourth power of an integer.\"\"\"\n    return x ** 4\n\ndef _generate_odd_sequence(n: int) -> list[int]:\n    \"\"\"Generates a list of the first n odd natural numbers.\"\"\"\n    return [2 * i - 1 for i in range(1, n + 1)]\n\ndef odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    Returns 0 if n is 0.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    odd_numbers = _generate_odd_sequence(n)\n    sum_of_powers = 0\n    for num in odd_numbers:\n        sum_of_powers += _fourth_power(num)\n    return sum_of_powers"}
{"task_id": "Mbpp/771", "solution": "class BracketType:\n    \"\"\"Provides mappings for bracket pairs.\"\"\"\n    def __init__(self):\n        self.pairs = {'(': ')', '[': ']', '{': '}'}\n\n    def get_closing(self, opening: str) -> str | None:\n        \"\"\"Returns the matching closing bracket for an opening bracket.\"\"\"\n        return self.pairs.get(opening)\n\nclass Stack:\n    \"\"\"A LIFO stack implementation.\"\"\"\n    def __init__(self):\n        self._items = []\n\n    def push(self, item):\n        \"\"\"Adds an item to the top of the stack.\"\"\"\n        self._items.append(item)\n\n    def pop(self):\n        \"\"\"Removes and returns the item from the top of the stack.\"\"\"\n        if not self.isEmpty():\n            return self._items.pop()\n        return None\n\n    def peek(self):\n        \"\"\"Returns the item at the top of the stack without removing it.\"\"\"\n        if not self.isEmpty():\n            return self._items[-1]\n        return None\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the stack is empty.\"\"\"\n        return len(self._items) == 0\n\nclass Bracket:\n    \"\"\"Represents a bracket character with its properties.\"\"\"\n    def __init__(self, symbol: str, position: int):\n        self.symbol = symbol\n        self.position = position\n        self.opening_brackets = '({['\n        self.closing_brackets = ')}]'\n\n    def isOpening(self) -> bool:\n        \"\"\"Checks if the bracket is an opening type.\"\"\"\n        return self.symbol in self.opening_brackets\n\n    def isClosing(self) -> bool:\n        \"\"\"Checks if the bracket is a closing type.\"\"\"\n        return self.symbol in self.closing_brackets\n\nclass Expression:\n    \"\"\"Encapsulates the input string for bracket checking.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def getCharacters(self) -> list[str]:\n        \"\"\"Returns a list of characters from the expression string.\"\"\"\n        return list(self.text)\n\nclass Validator:\n    \"\"\"Core logic for validating bracket balance and nesting.\"\"\"\n    def __init__(self):\n        self.bracket_type = BracketType()\n        self.stack = Stack()\n        self.all_brackets = '(){}[]'\n\n    def check_expression(self, expr: Expression) -> bool:\n        \"\"\"Checks if the brackets in the given expression are balanced.\"\"\"\n        for char in expr.getCharacters():\n            if char not in self.all_brackets:\n                continue\n\n            bracket = Bracket(char, 0)\n\n            if bracket.isOpening():\n                self.stack.push(bracket)\n            elif bracket.isClosing():\n                if self.stack.isEmpty():\n                    return False\n                \n                top_opening_bracket = self.stack.peek()\n                \n                if not self.matches(top_opening_bracket.symbol, char):\n                    return False\n                \n                self.stack.pop()\n\n        return self.stack.isEmpty()\n\n    def matches(self, opening: str, closing: str) -> bool:\n        \"\"\"Checks if a closing bracket matches a given opening bracket.\"\"\"\n        return closing == self.bracket_type.get_closing(opening)\n\ndef check_expression(input_string: str) -> bool:\n    \"\"\"\n    Checks if the given expression's brackets are balanced and properly nested.\n    Returns True if balanced, False otherwise.\n    \"\"\"\n    expr = Expression(input_string)\n    validator = Validator()\n    return validator.check_expression(expr)"}
{"task_id": "Mbpp/773", "solution": "from typing import Optional, Tuple\n\ndef occurance_substring(source: str, substring: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Finds the first occurrence and position of a substring within a string.\n    Returns None if there is no match.\n    \"\"\"\n    start_index = source.find(substring)\n    if start_index == -1:\n        return None\n    else:\n        end_index = start_index + len(substring)\n        return (substring, start_index, end_index)"}
{"task_id": "Mbpp/772", "solution": "from typing import List\n\nclass InputString:\n    \"\"\"Holds the raw input string.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n\nclass Word:\n    \"\"\"Represents a token and provides its length.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the word (code points).\"\"\"\n        return len(self.text)\n\nclass OutputString:\n    \"\"\"Encapsulates the resulting normalized string.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\nclass Tokenizer:\n    \"\"\"Tokenizes input string into Word objects using whitespace separators.\"\"\"\n    def tokenize(self, s: str) -> List[Word]:\n        \"\"\"Splits the string by whitespace into Word objects.\"\"\"\n        if not s:\n            return []\n        return [Word(token) for token in s.split()]\n\nclass Filter:\n    \"\"\"Removes Word objects whose length equals k.\"\"\"\n    def filterWords(self, words: List[Word], k: int) -> List[Word]:\n        \"\"\"Returns a new list with Word objects whose length is not k.\"\"\"\n        return [word for word in words if word.length() != k]\n\nclass Joiner:\n    \"\"\"Joins Word objects into a normalized string with single spaces and trimmed edges.\"\"\"\n    def join(self, words: List[Word]) -> str:\n        \"\"\"Concatenates Word.text values with ' ' and returns the trimmed result.\"\"\"\n        return \" \".join([word.text for word in words])\n\ndef remove_length(input: str, k: int) -> str:\n    \"\"\"\n    Removes all words with k length from the given string.\n    The process involves tokenization, filtering, and rejoining words.\n    \"\"\"\n    input_obj = InputString(raw=input)\n    \n    tokenizer = Tokenizer()\n    words = tokenizer.tokenize(input_obj.raw)\n    \n    flt = Filter()\n    filtered_words = flt.filterWords(words, k)\n    \n    joiner = Joiner()\n    result_text = joiner.join(filtered_words)\n    \n    return result_text"}
{"task_id": "Mbpp/775", "solution": "from typing import List\n\ndef odd_position(items: List[int]) -> bool:\n    \"\"\"\n    Checks if every odd-indexed element in the list is an odd number.\n    Returns True if all elements at odd indices are odd, or if there are no odd indices.\n    \"\"\"\n    for i in range(1, len(items), 2):\n        if items[i] % 2 == 0:\n            return False\n    return True"}
{"task_id": "Mbpp/777", "solution": "def find_sum(input_list):\n    \"\"\"\n    Calculates the sum of unique elements in a list.\n    Duplicates are counted only once for the sum.\n    \"\"\"\n    unique_elements = set(input_list)\n    total_sum = sum(unique_elements)\n    return total_sum"}
{"task_id": "Mbpp/778", "solution": "def _equals(a, b):\n    \"\"\"\n    Compares two elements for equality using the language's == operator.\n    \"\"\"\n    return a == b\n\ndef pack_consecutive_duplicates(input_list):\n    \"\"\"\n    Packs consecutive duplicate elements of a list into sublists.\n    Returns a new list of sublists, preserving order and not modifying the input.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_run = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if _equals(input_list[i], current_run[-1]):\n            current_run.append(input_list[i])\n        else:\n            packed_list.append(current_run)\n            current_run = [input_list[i]]\n    \n    # Append the last run\n    packed_list.append(current_run)\n    \n    return packed_list"}
{"task_id": "Mbpp/780", "solution": "class InputTuple:\n    \"\"\"Represents a single input 2-element integer tuple with positional index.\"\"\"\n    def __init__(self, first: int, second: int, index: int):\n        self.first = first\n        self.second = second\n        self.index = index\n\n    def is_valid(self) -> bool:\n        \"\"\"Returns True, assuming valid input types per problem constraints.\"\"\"\n        return True\n\nclass TupleSum:\n    \"\"\"Represents an output element-wise sum and pair_index.\"\"\"\n    def __init__(self, sum_first: int, sum_second: int, pair_index: int):\n        self.sum_first = sum_first\n        self.sum_second = sum_second\n        self.pair_index = pair_index\n\nclass OutputList:\n    \"\"\"Container for TupleSum objects, enforcing ordering by pair_index.\"\"\"\n    def __init__(self, results: list[TupleSum]):\n        self.results = results\n\n    def order_results(self) -> None:\n        \"\"\"Sorts the contained TupleSum objects by their pair_index.\"\"\"\n        self.results.sort(key=lambda ts: ts.pair_index)\n\nclass CombinationGenerator:\n    \"\"\"Generates combinations of sums from a list of InputTuple objects.\"\"\"\n    def validate_input(self, inputs: list) -> bool:\n        \"\"\"Returns True, assuming valid input types per problem constraints.\"\"\"\n        return True\n\n    def generate_pairs(self, inputs: list[InputTuple]) -> list[tuple[int, int]]:\n        \"\"\"Generates all unique ordered pairs of indices (i, j) where i < j.\"\"\"\n        n = len(inputs)\n        pairs = []\n        for i in range(0, n - 1):\n            for j in range(i + 1, n):\n                pairs.append((i, j))\n        return pairs\n\n    def sum_pairs(self, pairs: list[tuple[int, int]], inputs: list[InputTuple]) -> list[TupleSum]:\n        \"\"\"Computes element-wise sums for each pair of input tuples.\"\"\"\n        results = []\n        for pair_index, (i, j) in enumerate(pairs):\n            first_sum = inputs[i].first + inputs[j].first\n            second_sum = inputs[i].second + inputs[j].second\n            results.append(TupleSum(first_sum, second_sum, pair_index))\n        return results\n\n    def find_combinations(self, inputs: list[InputTuple]) -> list[TupleSum]:\n        \"\"\"Orchestrates pair generation and summation to find all combinations.\"\"\"\n        # No internal validation call due to prompt constraints regarding type checks and exceptions.\n        pairs = self.generate_pairs(inputs)\n        tuple_sums = self.sum_pairs(pairs, inputs)\n        output_list = OutputList(tuple_sums)\n        output_list.order_results()\n        return output_list.results\n\ndef find_combinations(input_list):\n    \"\"\"\n    Finds combinations of sums with tuples in the given tuple list.\n    Assumes input_list is a list of 2-element integer tuples as per problem constraints.\n    \"\"\"\n    inputs = [InputTuple(first=tpl[0], second=tpl[1], index=i) for i, tpl in enumerate(input_list)]\n\n    generator = CombinationGenerator()\n    # No validation call or error raising due to prompt constraints.\n\n    ordered_tuple_sums = generator.find_combinations(inputs)\n\n    return [(ts.sum_first, ts.sum_second) for ts in ordered_tuple_sums]"}
{"task_id": "Mbpp/781", "solution": "def count_positive_divisors(n: int) -> int:\n    \"\"\"\n    Counts the number of positive divisors for a given integer n.\n    It iterates from 1 to n to find all divisors.\n    \"\"\"\n    count = 0\n    for i in range(1, n + 1):\n        if n % i == 0:\n            count += 1\n    return count\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks whether the count of positive divisors for a given integer n is even.\n    It uses a helper function to determine the total number of divisors.\n    \"\"\"\n    num_divs = count_positive_divisors(n)\n    return num_divs % 2 == 0"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"\n    Finds the sum of all odd length subarrays by summing the contributions of each element.\n    \"\"\"\n    _validate_input(arr)\n    return _odd_length_sum_linear(arr)\n\ndef _validate_input(arr: list):\n    \"\"\"\n    Validates that the input is a list of integers, raising TypeError or ValueError if not.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n    for i, x in enumerate(arr):\n        if not isinstance(x, int):\n            raise ValueError(f\"List elements must be integers. Element at index {i} is of type {type(x).__name__}.\")\n\ndef _odd_length_sum_linear(arr: list[int]) -> int:\n    \"\"\"\n    Computes the sum of all odd-length subarrays using a per-element contribution approach.\n    \"\"\"\n    n = len(arr)\n    total_sum = 0\n    for i in range(n):\n        left_count = i + 1\n        right_count = n - i\n        # The number of odd-length subarrays containing arr[i]\n        num_odd_subarrays_containing_i = (left_count * right_count + 1) // 2\n        total_sum += arr[i] * num_odd_subarrays_containing_i\n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(list: list) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd number in the given list.\n\n    Raises TypeError or ValueError for invalid input or missing elements.\n    \"\"\"\n\n    def _validate_input(list: list) -> None:\n        \"\"\"\n        Validates that the input is a list and contains only integers.\n        \"\"\"\n        if not isinstance(list, list):\n            raise TypeError(\"input must be a list\")\n        for element in list:\n            if not isinstance(element, int):\n                raise ValueError(\"list contains non-integer element\")\n\n    def _find_first_odd(list: list) -> int:\n        \"\"\"\n        Finds the first odd integer in the list, scanning left-to-right.\n        \"\"\"\n        for element in list:\n            if element % 2 != 0:\n                return element\n        raise ValueError(\"no odd element found\")\n\n    def _find_first_even(list: list) -> int:\n        \"\"\"\n        Finds the first even integer in the list, scanning left-to-right.\n        \"\"\"\n        for element in list:\n            if element % 2 == 0:\n                return element\n        raise ValueError(\"no even element found\")\n\n    _validate_input(list)\n    first_odd = _find_first_odd(list)\n    first_even = _find_first_even(list)\n\n    return first_odd * first_even"}
{"task_id": "Mbpp/785", "solution": "import collections\n\nclass Token:\n    \"\"\"Represents a numeric token extracted from the tuple string.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def to_int(self) -> int:\n        \"\"\"Converts the token text to an integer, raising ValueError on failure.\"\"\"\n        try:\n            return int(self.text)\n        except ValueError:\n            raise ValueError(f\"Invalid numeric token: '{self.text}'\")\n\nclass IntegerTuple:\n    \"\"\"Encapsulates a list of integers before final conversion to a tuple.\"\"\"\n    def __init__(self, elements: list[int]):\n        self.elements = elements\n\n    def as_tuple(self) -> tuple:\n        \"\"\"Returns the stored integers as a native Python tuple.\"\"\"\n        return tuple(self.elements)\n\nclass TupleParser:\n    \"\"\"Handles format validation and tokenization of the input string.\"\"\"\n    @staticmethod\n    def validate_format(raw: str) -> bool:\n        \"\"\"Checks for surrounding parentheses and non-empty content.\"\"\"\n        if not raw or not raw.strip():\n            return False\n        trimmed_raw = raw.strip()\n        if not (trimmed_raw.startswith('(') and trimmed_raw.endswith(')')):\n            return False\n        # Allow empty tuple () but disallow (   ) or just ( or )\n        if len(trimmed_raw) > 2 and trimmed_raw[1:-1].strip() == '':\n            return False\n        return True\n\n    @staticmethod\n    def tokenize(inner: str) -> list[Token]:\n        \"\"\"Splits the inner string by commas, trims tokens, and returns Token objects.\"\"\"\n        if not inner.strip(): # Handles empty inner content like \"()\"\n            return []\n        \n        token_texts = inner.split(',')\n        tokens = []\n        for text in token_texts:\n            trimmed_text = text.strip()\n            if not trimmed_text and len(token_texts) > 1: # Disallow empty tokens in multi-element tuples (e.g., \"1,,2\")\n                raise ValueError(\"Malformed tuple string: empty element found.\")\n            if trimmed_text: # Only add if not entirely empty string (handles single empty string case for \"()\")\n                tokens.append(Token(trimmed_text))\n        return tokens\n\nclass Converter:\n    \"\"\"Converts a list of Token objects into an IntegerTuple.\"\"\"\n    @staticmethod\n    def tokens_to_integers(tokens: list[Token]) -> IntegerTuple:\n        \"\"\"Converts each token to an int and collects them into an IntegerTuple.\"\"\"\n        elements = [token.to_int() for token in tokens]\n        return IntegerTuple(elements)\n\ndef tuple_str_int(input_str: str) -> tuple:\n    \"\"\"\n    Converts a string representation of an integer tuple (e.g., \"(7, 8, 9)\")\n    into a native Python tuple of integers.\n    Raises TypeError if input is not a string, or ValueError for malformed input.\n    \"\"\"\n    if not isinstance(input_str, str):\n        raise TypeError(\"Input must be a string.\")\n\n    trimmed_input = input_str.strip()\n\n    if not TupleParser.validate_format(trimmed_input):\n        raise ValueError(\"Input must be a parenthesized, comma-separated sequence of integers.\")\n\n    # Extract inner content, removing leading/trailing parentheses\n    inner_content = trimmed_input[1:-1]\n\n    tokens = TupleParser.tokenize(inner_content)\n    integer_tuple = Converter.tokens_to_integers(tokens)\n    return integer_tuple.as_tuple()"}
