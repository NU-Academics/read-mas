{"task_id": "Mbpp/602", "solution": "from typing import Optional\n\nclass InputString:\n    \"\"\"Wraps the raw input string and provides length accessors.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self.value)\n\nclass CharacterTracker:\n    \"\"\"Maintains seen set, counts map, and firstIndexes map for characters.\"\"\"\n    def __init__(self) -> None:\n        self.seen: set[str] = set()\n        self.counts: dict[str, int] = {}\n        self.firstIndexes: dict[str, int] = {}\n\n    def increment(self, ch: str, index: int) -> None:\n        \"\"\"Updates counts and records first index if ch is newly seen.\"\"\"\n        if ch not in self.seen:\n            self.seen.add(ch)\n            self.firstIndexes[ch] = index\n            self.counts[ch] = 1\n        else:\n            self.counts[ch] += 1\n\n    def first_repeated(self) -> Optional[str]:\n        \"\"\"Returns the earliest character whose count > 1, or None if none exist.\"\"\"\n        # This method is designed but not used by the primary first_repeated_char logic\n        # which checks counts directly during iteration.\n        # However, it is defined as per the design context.\n        min_index = float('inf')\n        repeated_char = None\n        for char, count in self.counts.items():\n            if count > 1:\n                if self.firstIndexes[char] < min_index:\n                    min_index = self.firstIndexes[char]\n                    repeated_char = char\n        return repeated_char\n\ndef first_repeated_char(s: str) -> Optional[str]:\n    \"\"\"\n    Finds the first repeated character in a given string.\n    Scans left-to-right, returning the first character whose count becomes > 1.\n    \"\"\"\n    input_obj = InputString(s)\n    tracker = CharacterTracker()\n\n    for idx, ch in enumerate(input_obj.value):\n        tracker.increment(ch, idx)\n        if tracker.counts.get(ch, 0) > 1:\n            return ch\n            \n    return None"}
{"task_id": "Mbpp/603", "solution": "import math\nfrom typing import List\n\nclass LudicNumber:\n    \"\"\"Represents an individual ludic number value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass InputParameter:\n    \"\"\"Encapsulates input integer n and validates type/boundary rules.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if n is an integer.\"\"\"\n        return isinstance(self.n, int)\n\nclass LudicSequence:\n    \"\"\"Holds and manipulates working list of ludic numbers; provides final distinct_sorted result.\"\"\"\n    def __init__(self):\n        self.numbers: List[int] = []\n\n    def append(self, value: int) -> None:\n        \"\"\"Appends a value to the internal list.\"\"\"\n        self.numbers.append(value)\n\n    def distinct_sorted(self) -> List[int]:\n        \"\"\"Returns a sorted list of unique numbers from the sequence.\"\"\"\n        return sorted(list(set(self.numbers)))\n\nclass LudicCalculator:\n    \"\"\"Generates ludic numbers up to a validated integer limit.\"\"\"\n    def get_ludic(self, n: int) -> List[int]:\n        \"\"\"Delegates to generate_sequence to get ludic numbers up to n.\"\"\"\n        return self.generate_sequence(n)\n\n    def generate_sequence(self, limit: int) -> List[int]:\n        \"\"\"Algorithmic generation of ludic numbers using a sieve process.\"\"\"\n        ludic_seq = LudicSequence()\n        if limit < 1:\n            return ludic_seq.distinct_sorted()\n\n        ludic_seq.append(1)  # 1 is the first ludic number\n        # Initialize candidates from 2 up to the limit for the sieve\n        current_numbers = list(range(2, limit + 1))\n\n        while current_numbers:\n            # The first number in the current list of candidates is the next ludic number\n            p = current_numbers.pop(0)\n            ludic_seq.append(p)\n\n            next_numbers = []\n            count = 0  # Position counter for elements in the *remaining* `current_numbers` list\n            for num in current_numbers:\n                count += 1\n                if count % p != 0:  # If its position is not a multiple of p, it survives\n                    next_numbers.append(num)\n            current_numbers = next_numbers\n        \n        return ludic_seq.distinct_sorted()\n\n    def is_ludic(self, candidate: int, sequence: List[int]) -> bool:\n        \"\"\"\n        A predicate for ludic numbers.\n        This method is complex to implement efficiently without generating the sequence itself.\n        As the primary generation is handled by `generate_sequence`, this serves as a placeholder.\n        \"\"\"\n        return candidate == 1 if candidate >= 1 else False\n\nclass TestCase:\n    \"\"\"Encapsulates a verification scenario with expected list.\"\"\"\n    def __init__(self, input_n: int, expected: List[int]):\n        self.input_n = input_n\n        self.expected = expected\n\n    def run(self) -> bool:\n        \"\"\"Invokes get_ludic and compares to expected output.\"\"\"\n        actual = get_ludic(self.input_n)\n        return actual == self.expected\n\n\ndef get_ludic(n: int) -> List[int]:\n    \"\"\"\n    Gets all lucid numbers smaller than or equal to a given integer.\n    Validates input and delegates generation to a LudicCalculator.\n    \"\"\"\n    param = InputParameter(n)\n    if not param.is_valid():\n        raise TypeError(\"Input must be an integer.\")\n\n    if n < 1:\n        return []\n\n    calculator = LudicCalculator()\n    return calculator.get_ludic(n)"}
{"task_id": "Mbpp/604", "solution": "def reverse_words(input_string: str) -> str:\n    \"\"\"\n    Reverses the order of words in a string, separated by single spaces.\n    This preserves word characters and capitalization.\n    \"\"\"\n    words = input_string.split()\n    reversed_words = words[::-1]\n    return ' '.join(reversed_words)"}
{"task_id": "Mbpp/605", "solution": "from math import isqrt\n\nclass IntegerInput:\n    \"\"\"Models an integer input for primality checks and validates its type.\"\"\"\n    def __init__(self, value: object) -> None:\n        self.value = value\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the stored value is an integer.\"\"\"\n        return isinstance(self.value, int)\n\nclass PrimeResult:\n    \"\"\"Encapsulates the result of a primality check.\"\"\"\n    def __init__(self, is_prime: bool) -> None:\n        self.is_prime = is_prime\n\nclass PrimeChecker:\n    \"\"\"Performs the core primality testing logic.\"\"\"\n    def prime_num(self, n: int) -> bool:\n        \"\"\"Entry point for checking primality, delegates to is_prime.\"\"\"\n        return self.is_prime(n)\n\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Determines if an integer is a prime number using trial division.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0:\n            return False\n\n        # Optimized trial division: check divisors of the form 6k \u00b1 1\n        limit = isqrt(n)\n        i = 5\n        while i <= limit:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\ndef prime_num(n: int) -> bool:\n    \"\"\"\n    Checks if the given integer is a prime number.\n    Returns False for non-integer inputs, negatives, 0, and 1.\n    \"\"\"\n    input_obj = IntegerInput(n)\n    if not input_obj.is_valid():\n        return False\n\n    checker = PrimeChecker()\n    return checker.prime_num(input_obj.value)"}
{"task_id": "Mbpp/606", "solution": "PI = 3.141592653589793\n\ndef radian_degree(degrees: float) -> float:\n    \"\"\"Converts an angle from degrees to radians using the specified PI constant.\"\"\"\n    return degrees * PI / 180.0"}
{"task_id": "Mbpp/607", "solution": "import re\n\ndef find_literals(source: str, pattern: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Search source for first regex match of pattern and return (substring, start, end)\n    or None if no match.\n    \"\"\"\n    match = re.search(pattern, source)\n    if match:\n        start_index = match.start()\n        end_index = match.end()\n        matching_substring = source[start_index:end_index]\n        return (matching_substring, start_index, end_index)\n    return None"}
