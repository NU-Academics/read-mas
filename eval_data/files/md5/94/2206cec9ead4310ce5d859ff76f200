{"task_id": "Mbpp/569", "solution": "from typing import List\n\ndef sort_sublists(input_list: List[List[str]]) -> List[List[str]]:\n    \"\"\"Accepts and returns List[List[str]]; sorts each sublist ascending lexicographically.\"\"\"\n    sorted_outer_list = []\n    for sublist in input_list:\n        sorted_outer_list.append(sorted(sublist))\n    return sorted_outer_list"}
{"task_id": "Mbpp/572", "solution": "from typing import List\n\ndef two_unique_nums(input_list: List[int]) -> List[int]:\n    # Calculate the frequency of each number in the input list.\n    counts = {}\n    for num in input_list:\n        counts[num] = counts.get(num, 0) + 1\n    \n    # Collect numbers that appear exactly once, preserving original order.\n    result = []\n    for num in input_list:\n        if counts[num] == 1:\n            result.append(num)\n            \n    return result"}
{"task_id": "Mbpp/573", "solution": "def unique_product(input_list):\n    \"\"\"\n    Calculates the product of unique numeric elements in a list.\n    Orchestrates the extraction of unique numbers and their product computation.\n    \"\"\"\n    def _extract_unique_numeric(lst):\n        \"\"\"\n        Examines the input list, extracts numeric values, and returns a deduplicated set of them.\n        \"\"\"\n        unique_numbers = set()\n        for item in lst:\n            if isinstance(item, (int, float)):\n                unique_numbers.add(item)\n        return unique_numbers\n\n    def _compute_product(iterable_values):\n        \"\"\"\n        Computes and returns the product of values in an iterable.\n        Returns 1 for an empty iterable.\n        \"\"\"\n        product = 1\n        for num in iterable_values:\n            product *= num\n        return product\n\n    unique_nums = _extract_unique_numeric(input_list)\n    result_product = _compute_product(unique_nums)\n    return result_product"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(list_a, list_b):\n    \"\"\"\n    Checks if list_b is a contiguous sublist of list_a.\n    The function does not modify the input lists.\n    \"\"\"\n    len_a = len(list_a)\n    len_b = len(list_b)\n\n    if len_b > len_a:\n        return False\n\n    if len_b == 0:\n        return True\n\n    for i in range(len_a - len_b + 1):\n        if list_a[i : i + len_b] == list_b:\n            return True\n\n    return False"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n):\n    \"\"\"\n    Calculates the last decimal digit of n!.\n    Raises ValueError if n is not a non-negative integer.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    # For n >= 5, n! will always end in 0 because it includes factors of 5 and 2.\n    if n >= 5:\n        return 0\n    elif n == 0:\n        return 1  # 0! = 1\n    elif n == 1:\n        return 1  # 1! = 1\n    elif n == 2:\n        return 2  # 2! = 2\n    elif n == 3:\n        return 6  # 3! = 6\n    elif n == 4:\n        return 4  # 4! = 24"}
{"task_id": "Mbpp/578", "solution": "from typing import List, Any\n\ndef validate_lengths(list1: List[Any], list2: List[Any], list3: List[Any]) -> None:\n    \"\"\"\n    Validates that three input lists have equal length, raising a ValueError if they do not.\n    \"\"\"\n    if not (len(list1) == len(list2) == len(list3)):\n        raise ValueError(\"input lists must have equal length\")\n\ndef interleave_lists(list1: List[Any], list2: List[Any], list3: List[Any]) -> List[Any]:\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Raises ValueError if input lists do not have equal length.\n    \"\"\"\n    validate_lengths(list1, list2, list3)\n\n    interleaved_result: List[Any] = []\n    num_elements = len(list1)\n\n    for i in range(num_elements):\n        interleaved_result.append(list1[i])\n        interleaved_result.append(list2[i])\n        interleaved_result.append(list3[i])\n\n    return interleaved_result"}
{"task_id": "Mbpp/579", "solution": "from typing import Any, Tuple, Iterable\n\nclass TupleInput:\n    \"\"\"Encapsulates an input tuple value.\"\"\"\n    def __init__(self, values: Tuple) -> None:\n        self.values = values\n\nclass TupleValidator:\n    \"\"\"Validates that provided inputs are tuples.\"\"\"\n    def validate(self, input_val: Any) -> bool:\n        \"\"\"Returns True if input is of type tuple, else False.\"\"\"\n        return isinstance(input_val, Tuple)\n\nclass DissimilarResult:\n    \"\"\"Represents the computed result as a tuple container.\"\"\"\n    def __init__(self, elements: Tuple) -> None:\n        self.elements = elements\n\nclass TupleComparator:\n    \"\"\"Orchestrates validation and computation of dissimilar elements.\"\"\"\n    def __init__(self, validator: TupleValidator) -> None:\n        self._validator = validator\n\n    def find_dissimilar(self, t1: Any, t2: Any) -> Tuple:\n        \"\"\"\n        Validates inputs, computes ordered unique dissimilar elements,\n        and returns them as a tuple.\n        \"\"\"\n        if not self._validator.validate(t1):\n            raise TypeError(\"Input t1 must be a tuple.\")\n        if not self._validator.validate(t2):\n            raise TypeError(\"Input t2 must be a tuple.\")\n\n        result_elements = []\n        # Use a list for seen_elements to support non-hashable types and maintain order for deduplication.\n        seen_elements = []\n\n        # Process t1: elements in t1 but not in t2\n        for element_t1 in t1:\n            if element_t1 not in t2:\n                if element_t1 not in seen_elements:\n                    result_elements.append(element_t1)\n                    seen_elements.append(element_t1)\n\n        # Process t2: elements in t2 but not in t1\n        for element_t2 in t2:\n            if element_t2 not in t1:\n                if element_t2 not in seen_elements:\n                    result_elements.append(element_t2)\n                    seen_elements.append(element_t2)\n\n        return tuple(result_elements)\n\ndef find_dissimilar(t1: Tuple, t2: Tuple) -> Tuple:\n    \"\"\"\n    Finds the dissimilar elements in two tuples, returning them in\n    a new, ordered, and deduplicated tuple.\n    \"\"\"\n    validator = TupleValidator()\n    comparator = TupleComparator(validator)\n    return comparator.find_dissimilar(t1, t2)"}
{"task_id": "Mbpp/580", "solution": "def _extract_even_recursive(elem: object) -> object:\n    \"\"\"\n    Recursively processes an element, returning even integers or tuples of processed elements.\n    Returns None for odd integers or elements to be omitted.\n    \"\"\"\n    if isinstance(elem, int):\n        if elem % 2 == 0:\n            return elem\n        else:\n            return None\n    elif isinstance(elem, tuple):\n        processed_children = []\n        for child in elem:\n            processed_child = _extract_even_recursive(child)\n            if processed_child is not None:\n                processed_children.append(processed_child)\n        return tuple(processed_children)\n    else:\n        # Elements that are neither int nor tuple are implicitly removed.\n        return None\n\n\ndef extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Removes odd integers from a nested mixed tuple, preserving ordering and nesting.\n    \"\"\"\n    return _extract_even_recursive(input_tuple)"}
{"task_id": "Mbpp/581", "solution": "class SquarePyramid:\n    \"\"\"Domain model for a square pyramid to compute its surface area.\"\"\"\n    def __init__(self, base_edge: float, height: float) -> None:\n        self.base_edge = base_edge\n        self.height = height\n        self.surface_area = None\n\n    def computeSurfaceArea(self) -> float:\n        \"\"\"Computes the surface area of the square pyramid.\"\"\"\n        base_area = self.base_edge ** 2\n        lateral_area = 2 * self.base_edge * self.height\n        self.surface_area = base_area + lateral_area\n        return self.surface_area\n\nclass SurfaceAreaCalculator:\n    \"\"\"Orchestrates input validation and delegates surface area computation to SquarePyramid.\"\"\"\n    def surface_Area(self, base_edge, height):\n        if not isinstance(base_edge, (int, float)) or not isinstance(height, (int, float)):\n            raise TypeError(\"base_edge and height must be numeric (int or float)\")\n        \n        pyramid = SquarePyramid(base_edge, height)\n        return pyramid.computeSurfaceArea()\n\ndef surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the surface area of a square pyramid.\n    This function delegates to a SurfaceAreaCalculator instance for computation and validation.\n    \"\"\"\n    return SurfaceAreaCalculator().surface_Area(base_edge, height)"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Catalan number using dynamic programming.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    catalan = [0] * (n + 1)\n    catalan[0] = 1\n\n    for i in range(1, n + 1):\n        for j in range(i):\n            catalan[i] += catalan[j] * catalan[i - 1 - j]\n\n    return catalan[n]"}
