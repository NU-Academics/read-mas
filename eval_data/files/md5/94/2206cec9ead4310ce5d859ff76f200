{"task_id": "Mbpp/80", "solution": "class ValidationError(Exception):\n    \"\"\"Domain-specific exception used to signal validation failures.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\ndef validate(n):\n    \"\"\"Validate that n is an int and n >= 1; raise ValidationError on failure.\"\"\"\n    if not isinstance(n, int):\n        raise ValidationError(\"Input must be an integer\")\n    if n < 1:\n        raise ValidationError(\"Input must be >= 1\")\n\ndef _compute_tetrahedral(n):\n    \"\"\"Return (n * (n + 1) * (n + 2)) // 6 as int.\"\"\"\n    return (n * (n + 1) * (n + 2)) // 6\n\ndef tetrahedral_number(n):\n    \"\"\"Public API: validate n and return the nth tetrahedral number as int.\n\n    Raises:\n        ValidationError: if input is not integer or n < 1\n    \"\"\"\n    validate(n)\n    return _compute_tetrahedral(n)"}
{"task_id": "Mbpp/84", "solution": "def sequence(n):\n    \"\"\"\n    Computes the nth number in the Newman-Conway sequence using memoization.\n    Assumes n is a positive integer (n >= 1) based on design context constraints.\n    \"\"\"\n    memo = {}\n\n    def _get_sequence(k):\n        \"\"\"Helper to calculate sequence terms and store them in memo.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k == 1 or k == 2:\n            memo[k] = 1\n            return 1\n        \n        # Calculate sequence(sequence(n-1)) + sequence(n - sequence(n-1))\n        s_n_minus_1 = _get_sequence(k - 1)\n        \n        # Ensure arguments to recursive calls are valid.\n        # Design context implies valid n >= 1 and intermediate values will also be positive.\n        term1 = _get_sequence(s_n_minus_1)\n        term2 = _get_sequence(k - s_n_minus_1)\n        \n        result = term1 + term2\n        memo[k] = result\n        return result\n\n    # The design context specified throwing std::invalid_argument for n < 1.\n    # However, the prompt explicitly states \"DO NOT ... raise exceptions for edge cases\".\n    # Therefore, we proceed assuming n is valid (n >= 1) as per problem statement and design for valid cases.\n    return _get_sequence(n)"}
{"task_id": "Mbpp/86", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str, code: int = 0) -> None:\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\nclass InputValidator:\n    \"\"\"Validates input for centered hexagonal number calculation.\"\"\"\n    def is_positive_integer(self, n) -> bool:\n        \"\"\"Returns True if n is an integer and n >= 1.\"\"\"\n        return isinstance(n, int) and n >= 1\n\n    def validate(self, n) -> None:\n        \"\"\"Raises ValidationError if n is not a positive integer.\"\"\"\n        if not self.is_positive_integer(n):\n            raise ValidationError(\"Input 'n' must be a positive integer (>= 1).\")\n\nclass CenteredHexagonalCalculator:\n    \"\"\"Calculates centered hexagonal numbers.\"\"\"\n    def centered_hexagonal_number(self, n: int) -> int:\n        \"\"\"Validates input and computes the nth centered hexagonal number.\"\"\"\n        validator = InputValidator()\n        validator.validate(n)\n        return self.compute(n)\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the nth centered hexagonal number using the formula.\"\"\"\n        return 3 * n * (n - 1) + 1\n\ndef centered_hexagonal_number(n):\n    \"\"\"\n    Calculates the nth centered hexagonal number.\n    Raises ValidationError if n is not a positive integer.\n    \"\"\"\n    calculator = CenteredHexagonalCalculator()\n    return calculator.centered_hexagonal_number(n)"}
{"task_id": "Mbpp/87", "solution": "from typing import Dict, Any\n\ndef merge_dictionaries_three(dict1: Dict[Any, Any], dict2: Dict[Any, Any], dict3: Dict[Any, Any]) -> Dict[Any, Any]:\n    \"\"\"Merge three dictionaries into a single dictionary.\n    Conflict behavior (same key, different values) is unspecified by SRS; this implementation keeps the first-seen value.\n    \"\"\"\n    merged = {}\n    for source in (dict1, dict2, dict3):\n        for k, v in source.items():\n            if k in merged:\n                if merged[k] == v:\n                    continue\n                # Values differ, preserve existing merged[k] (first-seen precedence).\n                continue\n            merged[k] = v\n    return merged"}
