{"task_id": "Mbpp/240", "solution": "```python\n#!/usr/bin/env python3\n\"\"\"replace_list module\n\nExports:\n    replace_list(list1, list2) -> list\n\nUsage (import):\n    from src.replace_list import replace_list\n    result = replace_list([1,2,3], [4,5])\n\"\"\"\n\nfrom typing import Any, List as TypingList\n\ndef replace_list(list1: TypingList[Any], list2: TypingList[Any]) -> TypingList[Any]:\n    \"\"\"Return list1 without its last element concatenated with list2.\n\n    Precondition: inputs are lists.\n    \"\"\"\n    trimmed = list1[:-1]\n    result = list(trimmed) + list(list2)\n    return result\n```"}
{"task_id": "Mbpp/238", "solution": "class StringInput:\n    \"\"\"Encapsulates the input string and provides its length.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated string.\"\"\"\n        return len(self.value)\n\nclass SubstringCounter:\n    \"\"\"Computes the number of non-empty substrings using a closed-form formula.\"\"\"\n    def number_of_substrings(self, s: str) -> int:\n        \"\"\"Calculates substrings by obtaining string length and applying the formula.\"\"\"\n        n = len(s)\n        return self.compute_by_formula(n)\n\n    def compute_by_formula(self, n: int) -> int:\n        \"\"\"Applies the formula n * (n + 1) // 2 to count substrings.\"\"\"\n        return n * (n + 1) // 2\n\ndef number_of_substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of non-empty substrings of a given string.\n    The count is calculated using the formula n * (n + 1) // 2 where n is the string length.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a str\")\n\n    si = StringInput(s)\n    sc = SubstringCounter()\n    count = sc.number_of_substrings(si.value)\n    return int(count)"}
{"task_id": "Mbpp/242", "solution": "class StringInput:\n    \"\"\"Holds the input string and provides its length.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self.value)\n\nclass CountResult:\n    \"\"\"Holds the integer character count result.\"\"\"\n    def __init__(self, total: int) -> None:\n        self.total = total\n\nclass CharacterCounter:\n    \"\"\"Provides the character counting logic.\"\"\"\n    def count_charac(self, input_obj: \"StringInput\") -> \"CountResult\":\n        \"\"\"Counts characters in a StringInput object and returns a CountResult.\"\"\"\n        total_chars = input_obj.length()\n        return CountResult(total_chars)\n\ndef count_charac(input_string) -> int:\n    \"\"\"Counts the total number of characters in a string, including whitespace.\"\"\"\n    string_input_obj = StringInput(input_string)\n    counter = CharacterCounter()\n    result = counter.count_charac(string_input_obj)\n    return result.total"}
{"task_id": "Mbpp/245", "solution": "from typing import List\n\ndef compute_lis_sums(arr: List[int]) -> List[int]:\n    \"\"\"Compute per-index maximum-sum increasing subsequence ending at each index.\"\"\"\n    n = len(arr)\n    lis_sums = [0] * n\n    for i in range(n):\n        lis_sums[i] = arr[i]\n        for j in range(i):\n            if arr[j] < arr[i]:\n                lis_sums[i] = max(lis_sums[i], arr[i] + lis_sums[j])\n    return lis_sums\n\ndef compute_lds_sums(arr: List[int]) -> List[int]:\n    \"\"\"Compute per-index maximum-sum decreasing subsequence starting at each index.\"\"\"\n    n = len(arr)\n    lds_sums = [0] * n\n    for i in range(n - 1, -1, -1):\n        lds_sums[i] = arr[i]\n        for j in range(i + 1, n):\n            if arr[j] < arr[i]:\n                lds_sums[i] = max(lds_sums[i], arr[i] + lds_sums[j])\n    return lds_sums\n\ndef combine_sums(arr: List[int], lis_sums: List[int], lds_sums: List[int]) -> int:\n    \"\"\"Return max over i of (lis_sums[i] + lds_sums[i] - arr[i]).\"\"\"\n    n = len(arr)\n    max_bitonic_sum = float('-inf') # Initialize to negative infinity to handle arrays with negative sums.\n    for i in range(n):\n        max_bitonic_sum = max(max_bitonic_sum, lis_sums[i] + lds_sums[i] - arr[i])\n    return int(max_bitonic_sum)\n\ndef max_sum(arr: List[int]) -> int:\n    \"\"\"Finds the maximum sum of a bitonic subsequence for the given array.\n    Returns 0 for an empty array as per design.\n    \"\"\"\n    if not arr:\n        return 0\n\n    lis_sums = compute_lis_sums(arr)\n    lds_sums = compute_lds_sums(arr)\n    \n    return combine_sums(arr, lis_sums, lds_sums)"}
{"task_id": "Mbpp/251", "solution": "def validate_inputs(input_list):\n    \"\"\"Return True if input_list is a list (minimal validation).\"\"\"\n    return isinstance(input_list, list)\n\ndef insert_element(input_list, element):\n    \"\"\"Return a new list where 'element' is inserted immediately before each item of input_list.\n    If input_list is empty or invalid, an empty list is returned.\n    \"\"\"\n    if not validate_inputs(input_list):\n        return []\n\n    if len(input_list) == 0:\n        return []\n\n    result = []\n    for item in input_list:\n        result.append(element)\n        result.append(item)\n    return result"}
{"task_id": "Mbpp/253", "solution": "def count_integer(input_list):\n    \"\"\"\n    Counts the number of integer elements in a given list.\n    Raises TypeError if the input is not a list.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError('input_list must be a list')\n\n    counter = 0\n    for element in input_list:\n        if type(element) is int:\n            counter += 1\n    return int(counter)"}
{"task_id": "Mbpp/247", "solution": "class InputString:\n    \"\"\"Encapsulates the raw input string and derived length.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n        self.length = len(value)\n\nclass LPSResult:\n    \"\"\"Encapsulates the integer length result of an LPS computation.\"\"\"\n    def __init__(self, length: int) -> None:\n        self.length = length\n\nclass LPSService:\n    \"\"\"Computes the length of the Longest Palindromic Subsequence using dynamic programming.\"\"\"\n    def lps(self, s: str) -> int:\n        n = len(s)\n\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n\n        # dp[i][j] stores the length of the longest palindromic subsequence of s[i...j].\n        dp = [[0] * n for _ in range(n)]\n\n        # All single characters are palindromes of length 1.\n        for i in range(n):\n            dp[i][i] = 1\n\n        # Fill the DP table for lengths from 2 to n.\n        for current_len in range(2, n + 1):\n            for i in range(n - current_len + 1):\n                j = i + current_len - 1\n                if s[i] == s[j]:\n                    # If characters match, they form a palindrome with the inner subsequence.\n                    # dp[i+1][j-1] is 0 if i+1 > j-1 (i.e., when current_len is 2).\n                    dp[i][j] = 2 + dp[i + 1][j - 1]\n                else:\n                    # If characters don't match, take the maximum of excluding s[i] or s[j].\n                    dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n        return dp[0][n - 1]\n\n_lps_service_instance = LPSService()\n\ndef lps(s: str) -> int:\n    \"\"\"\n    Finds the length of the longest palindromic subsequence in the given string.\n    This module-level function delegates the computation to an LPSService instance.\n    \"\"\"\n    return _lps_service_instance.lps(s)"}
