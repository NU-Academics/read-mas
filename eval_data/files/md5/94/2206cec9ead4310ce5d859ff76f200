{"task_id": "Mbpp/280", "solution": "def sequential_search(array, element):\n    \"\"\"\n    Perform a sequential (linear) search over 'array' for 'element'.\n    Returns: (found: bool, index: int) where index is zero-based position or -1 when not found.\n    \"\"\"\n    for i in range(len(array)):\n        if array[i] == element:\n            return (True, i)\n    return (False, -1)"}
{"task_id": "Mbpp/282", "solution": "class Validator:\n    @staticmethod\n    def validate_lengths(a: list, b: list) -> bool:\n        \"Return True when lengths match.\"\n        return len(a) == len(b)\n\n    @staticmethod\n    def validate_numeric(lst: list) -> bool:\n        \"Return True when all elements are int or float.\"\n        return all(isinstance(x, (int, float)) for x in lst)\n\ndef sub_list(a: list, b: list) -> list:\n    \"Public API: compute element-wise subtraction.\"\n    if not Validator.validate_lengths(a, b):\n        raise ValueError(\"length mismatch\")\n    if not Validator.validate_numeric(a) or not Validator.validate_numeric(b):\n        raise ValueError(\"non-numeric element\")\n\n    result = []\n    for i in range(len(a)):\n        result.append(a[i] - b[i])\n    return result"}
{"task_id": "Mbpp/283", "solution": "import collections\nfrom typing import List\n\nclass IntegerInput:\n    \"\"\"\n    Encapsulates an integer value and provides a method to extract its base-10 digits.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def getDigits(self) -> List[int]:\n        \"\"\"\n        Returns a list of base-10 digits from the absolute value of the integer.\n        \"\"\"\n        abs_value_str = str(abs(self.value))\n        if abs_value_str == '0':\n            return [0]\n        return [int(d) for d in abs_value_str]\n\nclass Validator:\n    \"\"\"\n    Stateless service that performs the digit frequency validation logic.\n    \"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate(self, integer_input: IntegerInput) -> bool:\n        \"\"\"\n        Checks if the frequency of each digit in the integer_input is less than or equal to the digit itself.\n        \"\"\"\n        digits = integer_input.getDigits()\n        digit_counts = collections.Counter(digits)\n\n        for digit, count in digit_counts.items():\n            if count > digit:\n                return False\n        return True\n\ndef validate(value: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in the integer is less than or equal to the digit itself.\n    \"\"\"\n    integer_input = IntegerInput(value)\n    validator = Validator()\n    return validator.validate(integer_input)"}
{"task_id": "Mbpp/284", "solution": "def check_element(list, element) -> bool:\n    \"\"\"\n    Checks if all items in the given list are equal to the provided element.\n    Returns True if all items match, False otherwise (early exit on first mismatch).\n    \"\"\"\n    for item in list:\n        if item != element:\n            return False\n    return True"}
{"task_id": "Mbpp/285", "solution": "class Pattern:\n    \"\"\"Represents a literal pattern value and its length.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n        self.length = len(value)\n\nclass TextMatcher:\n    \"\"\"Encapsulates the matching logic and pattern set.\"\"\"\n    _PATTERNS = [Pattern(\"abb\"), Pattern(\"abbb\")]\n\n    def text_match_two_three(self, text: str) -> bool:\n        \"\"\"Checks if the input text contains 'abb' or 'abbb'.\"\"\"\n        for pattern_obj in self._PATTERNS:\n            if pattern_obj.value in text:\n                return True\n        return False\n\ndef text_match_two_three(text: str) -> bool:\n    \"\"\"\n    Checks whether a string contains the 'a' character followed by two or three 'b' characters.\n    Delegates to an internal TextMatcher instance for the actual matching logic.\n    \"\"\"\n    matcher = TextMatcher()\n    return matcher.text_match_two_three(text)"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of squares of the first n even natural numbers.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    total_sum = 0\n    for i in range(1, n + 1):\n        even_natural_number = 2 * i\n        total_sum += even_natural_number ** 2\n    return total_sum"}
{"task_id": "Mbpp/292", "solution": "import math\n\ndef find(a, b):\n    \"\"\"\n    Finds the quotient of two numbers, rounded down to the nearest integer.\n    \"\"\"\n    return int(math.floor(a / b))"}
{"task_id": "Mbpp/290", "solution": "class InputList:\n    \"\"\"Typed wrapper for raw input list-of-lists.\"\"\"\n    def __init__(self, sublists: list) -> None:\n        self.sublists = sublists\n\nclass Sublist:\n    \"\"\"Wrap an individual sublist and provide length computation.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the wrapped sublist.\"\"\"\n        return len(self.elements)\n\nclass ResultTuple:\n    \"\"\"Hold algorithm result and convert to a Python tuple.\"\"\"\n    def __init__(self, max_length: int, sublist: list) -> None:\n        self.max_length = max_length\n        self.sublist = sublist\n\n    def to_tuple(self) -> tuple[int, list]:\n        \"\"\"Converts the result to a standard Python tuple.\"\"\"\n        return (self.max_length, self.sublist)\n\nclass MaxLength:\n    \"\"\"Stateless service that computes the maximum sublist length.\"\"\"\n    def execute(self, input: InputList) -> ResultTuple:\n        \"\"\"Iterates sublists, finds the max length, and returns a representative sublist.\"\"\"\n        current_max_length = 0\n        representative_sublist = [] # Initialize for the case of an empty input list.\n\n        for raw_sublist in input.sublists:\n            sub = Sublist(elements=raw_sublist)\n            length = sub.length()\n\n            if length > current_max_length:\n                current_max_length = length\n                representative_sublist = raw_sublist\n            # Tie-breaking: the first encountered sublist with maximum length is retained.\n\n        return ResultTuple(current_max_length, representative_sublist)\n\ndef max_length(input_list: list) -> tuple[int, list]:\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns a tuple (max_length, sublist) where sublist is the first encountered\n    sublist with the maximum length.\n    \"\"\"\n    input_wrapper = InputList(sublists=input_list)\n    service = MaxLength()\n    result_wrapper = service.execute(input_wrapper)\n    return result_wrapper.to_tuple()"}
{"task_id": "Mbpp/293", "solution": "from dataclasses import dataclass\nimport math\nfrom typing import Optional\n\nclass NumericValue:\n    \"\"\"Wraps a numeric value and provides type checks.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def is_integer(self) -> bool:\n        \"\"\"Returns True if the value is an integer (including floats representing integers).\"\"\"\n        return isinstance(self.value, int) or (isinstance(self.value, float) and self.value.is_integer())\n\n    def is_float(self) -> bool:\n        \"\"\"Returns True if the value is a float instance.\"\"\"\n        return isinstance(self.value, float)\n\n@dataclass\nclass RightAngledTriangle:\n    \"\"\"Dataclass to encapsulate triangle sides and calculate hypotenuse.\"\"\"\n    a: float\n    b: float\n    hypotenuse: Optional[float] = None\n\n    def calculate_hypotenuse(self) -> float:\n        \"\"\"Calculates the hypotenuse using the Pythagorean theorem.\"\"\"\n        self.hypotenuse = math.sqrt(self.a**2 + self.b**2)\n        return self.hypotenuse\n\ndef validate_numeric(a, b) -> bool:\n    \"\"\"Validates if both inputs are numeric (int or float) and raises TypeError if not.\"\"\"\n    if not isinstance(a, (int, float)):\n        raise TypeError(f\"Side 'a' must be a numeric value (int or float), but got {type(a).__name__}\")\n    if not isinstance(b, (int, float)):\n        raise TypeError(f\"Side 'b' must be a numeric value (int or float), but got {type(b).__name__}\")\n    return True\n\ndef otherside_rightangle(a, b) -> float:\n    \"\"\"Calculates the hypotenuse of a right-angled triangle given two sides.\"\"\"\n    validate_numeric(a, b)\n    triangle = RightAngledTriangle(a, b)\n    return triangle.calculate_hypotenuse()"}
{"task_id": "Mbpp/286", "solution": "class ValidationError(Exception):\n    def __init__(self, message: str, code: int) -> None:\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\n    def __str__(self) -> str:\n        return f\"Error {self.code}: {self.message}\"\n\nclass InputValidator:\n    def _raise_error(self, message: str, code: int) -> None:\n        raise ValidationError(message, code)\n\n    def validate_length(self, arr: list[int], n: int) -> bool:\n        if not isinstance(arr, list):\n            self._raise_error(\"Input 'arr' must be a list.\", 101)\n        if n != len(arr):\n            self._raise_error(f\"Parameter 'n' ({n}) does not equal the length of 'arr' ({len(arr)}).\", 102)\n        \n        for x in arr:\n            if not isinstance(x, int):\n                self._raise_error(\"All elements in 'arr' must be integers.\", 103)\n        return True\n\n    def validate_k(self, k: int) -> bool:\n        if not isinstance(k, int) or k < 1:\n            self._raise_error(\"Parameter 'k' must be a positive integer.\", 104)\n        return True\n\nclass Array:\n    def __init__(self, elements: list[int]) -> None:\n        self.elements = elements\n        self.length = len(elements)\n        self._sum = sum(elements)\n        self.maxElement = max(elements) if elements else 0\n\n    def get_length(self) -> int:\n        return self.length\n\n    def get_sum(self) -> int:\n        return self._sum\n\nclass Result:\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def format(self) -> str:\n        return str(self.value)\n\ndef _kadane(arr: list[int]) -> int:\n    \"\"\"\n    Implements Kadane's algorithm to find the maximum contiguous subarray sum.\n    Handles arrays with all negative numbers by returning the largest element,\n    and returns 0 for an empty array.\n    \"\"\"\n    if not arr:\n        return 0 \n    \n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, len(arr)):\n        x = arr[i]\n        current_max = max(x, current_max + x)\n        max_so_far = max(max_so_far, current_max)\n        \n    return max_so_far\n\ndef _kadane_on_repeated(arr: list[int], k: int) -> int:\n    \"\"\"\n    Calculates the maximum subarray sum in an array logically repeated k times,\n    optimizing to avoid full concatenation for large k.\n    \"\"\"\n    if k == 1:\n        return _kadane(arr)\n\n    # For k >= 2, consider subarrays that cross the boundary between original arrays.\n    # This involves finding the max subarray sum in 'arr' concatenated with itself once.\n    max_sum_double_arr = _kadane(arr + arr)\n    \n    total_sum_single_arr = sum(arr)\n    \n    # If the total sum of the original array is positive and k is large enough (>=3),\n    # the optimal subarray may involve adding (k-2) times the total sum of the original array\n    # to the max sum found within two logical copies.\n    if total_sum_single_arr > 0 and k >= 3:\n        return max_sum_double_arr + (k - 2) * total_sum_single_arr\n    else:\n        # If total sum is not positive, or k is 2, the max sum is found\n        # within the first two logical copies.\n        return max_sum_double_arr\n\ndef max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in the array formed\n    by repeating the given array `arr` `k` times.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate_length(arr, n)\n    validator.validate_k(k)\n\n    array_obj = Array(arr)\n    \n    result_value = _kadane_on_repeated(array_obj.elements, k)\n    \n    result = Result(result_value)\n    \n    return result.value"}
{"task_id": "Mbpp/294", "solution": "def max_val(input_list):\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list.\n    Raises ValueError if no numeric elements are found.\n    \"\"\"\n    def _is_numeric(value):\n        \"\"\"\n        Determines if a value is numeric (int or float, but not bool).\n        \"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    numeric_values = [item for item in input_list if _is_numeric(item)]\n\n    if not numeric_values:\n        raise ValueError('no numeric elements found')\n\n    return max(numeric_values)"}
{"task_id": "Mbpp/296", "solution": "from typing import Any, List\n\n# Module: src/get_inv_count.py -- provides get_Inv_Count(arr: list) -> int and domain classes Array, InversionPair, InversionResult, InversionCounter\n\nclass Array:\n    \"\"\"Represent the input ordered sequence and provide length/access convenience.\"\"\"\n    def __init__(self, elements: List[Any]):\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def __getitem__(self, idx: int) -> Any:\n        return self.elements[idx]\n\nclass InversionPair:\n    \"\"\"Represent one inversion pair of indices (i, j).\"\"\"\n    def __init__(self, i: int, j: int):\n        self.i = i\n        self.j = j\n\nclass InversionResult:\n    \"\"\"Hold the integer result count of inversions.\"\"\"\n    def __init__(self, count: int):\n        self.count = count\n\nclass InversionCounter:\n    \"\"\"Implement inversion-counting algorithm and provide get_Inv_Count(arr: list) -> int.\"\"\"\n    def get_Inv_Count(self, arr: List[Any]) -> int:\n        \"\"\"Count inversions per inversion definition and return integer count.\"\"\"\n        n = len(arr)\n        count = 0\n        for i in range(n - 1):\n            for j in range(i + 1, n):\n                if arr[i] > arr[j]:\n                    count += 1\n        return count\n\ndef get_Inv_Count(arr: List[Any]) -> int:\n    \"\"\"Validate arr is a list and elements are comparable; return inversion count as int.\"\"\"\n    # Input validation (e.g., isinstance checks) is omitted per prompt instructions.\n    counter = InversionCounter()\n    return counter.get_Inv_Count(arr)"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(lst):\n    \"\"\"\n    Flattens a nested list structure into a single list.\n    Handles arbitrary nesting depth and preserves depth-first, left-to-right order.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n\n    def _flatten_generator(current_list):\n        for item in current_list:\n            if isinstance(item, list):\n                yield from _flatten_generator(item)\n            else:\n                yield item\n\n    return list(_flatten_generator(lst))"}
{"task_id": "Mbpp/299", "solution": "from dataclasses import dataclass\nfrom typing import List, Tuple, Optional, Dict, Any\n\n@dataclass\nclass NameValuePair:\n    \"\"\"Represents an input pair of a name and an integer value.\"\"\"\n    name: str\n    value: int\n\n@dataclass\nclass AggregatedRecord:\n    \"\"\"Represents an aggregated result: a name and its total sum.\"\"\"\n    name: str\n    total: int\n\nclass AggregatorService:\n    \"\"\"\n    Encapsulates the logic for validating input, aggregating values,\n    and selecting the maximum aggregate with tie-breaking.\n    \"\"\"\n    def validate_input(self, pairs: Any) -> None:\n        \"\"\"\n        Validates the input 'pairs' to ensure it's a list of 2-element tuples (str, int).\n        Raises TypeError if the input does not conform to the expected structure.\n        \"\"\"\n        if not isinstance(pairs, list):\n            raise TypeError(\"Input must be a list.\")\n        for i, item in enumerate(pairs):\n            if not isinstance(item, tuple) or len(item) != 2:\n                raise TypeError(f\"Element at index {i} must be a 2-element tuple.\")\n            if not isinstance(item[0], str):\n                raise TypeError(f\"Name at index {i} must be a string.\")\n            if not isinstance(item[1], int):\n                raise TypeError(f\"Value at index {i} must be an integer.\")\n\n    def compute_aggregates(self, pairs: List[Tuple[str, int]]) -> Dict[str, int]:\n        \"\"\"\n        Computes the sum of integer values for each distinct name in the input list.\n        Returns a dictionary mapping each name to its total aggregated value.\n        \"\"\"\n        aggregate_map: Dict[str, int] = {}\n        for name, value in pairs:\n            aggregate_map[name] = aggregate_map.get(name, 0) + value\n        return aggregate_map\n\n    def select_max(self, aggregate_map: Dict[str, int]) -> Optional[AggregatedRecord]:\n        \"\"\"\n        Selects the AggregatedRecord with the highest total from the aggregate map.\n        In case of ties, the name that is lexicographically smallest is chosen.\n        \"\"\"\n        if not aggregate_map:\n            return None\n\n        max_total = max(aggregate_map.values())\n        \n        # Find all names that have the maximum total\n        candidates = [name for name, total in aggregate_map.items() if total == max_total]\n        \n        # Select the lexicographically smallest name among candidates\n        selected_name = min(candidates)\n\n        return AggregatedRecord(selected_name, max_total)\n\n    def max_aggregate(self, pairs: Any) -> Optional[AggregatedRecord]:\n        \"\"\"\n        The service's main method to process pairs, validate, aggregate, and select the max.\n        Returns an AggregatedRecord if successful, None if input is empty.\n        \"\"\"\n        self.validate_input(pairs)\n\n        if not pairs:\n            return None\n\n        aggregates = self.compute_aggregates(pairs)\n        record = self.select_max(aggregates)\n        return record\n\ndef max_aggregate(pairs: Any) -> Optional[Tuple[str, int]]:\n    \"\"\"\n    Calculates the maximum aggregate total from a list of (name, value) tuples.\n    Returns the (name, total) tuple corresponding to the highest aggregate sum,\n    or None if the input list is empty. Raises TypeError for invalid input format.\n    \"\"\"\n    service = AggregatorService()\n    result = service.max_aggregate(pairs)\n    if result is None:\n        return None\n    return (result.name, result.total)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(d: dict) -> int:\n    \"\"\"Recursively computes the nesting depth of a dictionary.\n\n    Depth is 1 + the maximum depth among any dictionary-valued children; non-dict values contribute 0.\n    \"\"\"\n    max_child_depth = 0\n    for value in d.values():\n        if isinstance(value, dict):\n            max_child_depth = max(max_child_depth, dict_depth(value))\n    return 1 + max_child_depth"}
{"task_id": "Mbpp/300", "solution": "import math\nimport sys\n\nclass InvalidInputException(Exception):\n    \"\"\"Documented exception for invalid inputs.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InputValidator:\n    \"\"\"Encapsulates input validation logic for n (non-negative integer requirement).\"\"\"\n    def validate_non_negative_integer(self, n):\n        \"\"\"Raise InvalidInputException if n is not a non-negative integer.\"\"\"\n        if not isinstance(n, int):\n            raise InvalidInputException(f\"Input n must be an integer, but got {type(n).__name__}.\")\n        if n < 0:\n            raise InvalidInputException(f\"Input n must be non-negative, but got {n}.\")\n\nif sys.version_info < (3, 8):\n    def _comb_fallback(n, k):\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        if k > n // 2:\n            k = n - k\n        res = 1\n        for i in range(k):\n            res = res * (n - i) // (i + 1)\n        return res\n    _combinatorics_comb = _comb_fallback\nelse:\n    _combinatorics_comb = math.comb\n\nclass BinarySequenceCalculator:\n    \"\"\"Encapsulates the computation of the count of length-2n binary sequences.\"\"\"\n    def count_binary_seq(self, n: int) -> int:\n        \"\"\"Public facade returning numeric count (int) for n.\"\"\"\n        return self._compute_equal_sum_count(n)\n\n    def _compute_equal_sum_count(self, n: int) -> int:\n        \"\"\"Return int C(2n, n) using math.comb or fallback.\"\"\"\n        return _combinatorics_comb(2 * n, n)\n\n_input_validator = InputValidator()\n_calculator = BinarySequenceCalculator()\n\ndef count_binary_seq(n):\n    \"\"\"Validate n and return numeric count. Raises InvalidInputException for invalid input.\"\"\"\n    _input_validator.validate_non_negative_integer(n)\n    return _calculator.count_binary_seq(n)"}
{"task_id": "Mbpp/305", "solution": "def start_withp(inputs: list[str]) -> tuple[str, str]:\n    \"\"\"\n    Returns two words from a list of words starting with letter 'p' (case-insensitive).\n    Raises ValueError if fewer than two such words are found.\n    \"\"\"\n    p_words = []\n    for s in inputs:\n        words = s.split()\n        for word in words:\n            if word and word[0].lower() == 'p':\n                p_words.append(word)\n                if len(p_words) == 2:\n                    return (p_words[0], p_words[1])\n\n    # As per design, raise ValueError if fewer than two matches are found.\n    raise ValueError(\"Fewer than two words starting with 'p' were found.\")"}
{"task_id": "Mbpp/309", "solution": "from typing import Union\n\nNumber = Union[int, float]\n\ndef maximum(a, b):\n    \"\"\"Return the greater of two numeric values a and b.\n\n    Raises TypeError if a or b is not int or float.\n    \"\"\"\n    if not isinstance(a, (int, float)):\n        raise TypeError(\"maximum: first argument must be an int or float\")\n    if not isinstance(b, (int, float)):\n        raise TypeError(\"maximum: second argument must be an int or float\")\n    return a if a >= b else b"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    # Validate array length.\n    if n != len(arr):\n        raise ValueError(\"Array length n does not match actual length.\")\n    \n    # Validate indices: 0 <= i < k < n.\n    if not (0 <= i < k < n):\n        raise ValueError(\"Invalid indices: must satisfy 0 <= i < k < n.\")\n\n    target = arr[k]\n\n    def compute_best_prefix_sum(arr_prefix: list[int], prefix_end_idx: int, target_val: int) -> int:\n        \"\"\"\n        Computes the maximum sum of a strictly increasing subsequence from arr_prefix[0..prefix_end_idx]\n        whose last element is strictly less than target_val. Returns 0 if no such subsequence exists.\n        \"\"\"\n        \n        # dp[j] stores the maximum sum of an increasing subsequence ending at arr_prefix[j].\n        dp = [0] * (prefix_end_idx + 1)\n\n        for j in range(prefix_end_idx + 1):\n            dp[j] = arr_prefix[j]  # Initialize dp[j] with the element itself (subsequence of length 1).\n            for prev in range(j):\n                # If the previous element is smaller, we can potentially extend its subsequence.\n                if arr_prefix[prev] < arr_prefix[j]:\n                    dp[j] = max(dp[j], dp[prev] + arr_prefix[j])\n        \n        # Find the maximum sum among all such subsequences whose last element is less than target_val.\n        max_prefix_sum_eligible = 0\n        for j in range(prefix_end_idx + 1):\n            if arr_prefix[j] < target_val:\n                max_prefix_sum_eligible = max(max_prefix_sum_eligible, dp[j])\n        \n        return max_prefix_sum_eligible\n\n    best_prefix_sum = compute_best_prefix_sum(arr, i, target)\n\n    # If no eligible prefix elements were found (best_prefix_sum is 0),\n    # the subsequence is just arr[k]. Otherwise, sum the best prefix with arr[k].\n    if best_prefix_sum == 0:\n        return target\n    else:\n        return best_prefix_sum + target"}
{"task_id": "Mbpp/308", "solution": "class Product:\n    \"\"\"\n    Immutable value object holding a pair of factors and their product.\n    The product value is computed upon initialization.\n    \"\"\"\n    def __init__(self, left, right):\n        self.left = left\n        self.right = right\n        self.value = left * right\n\nclass ProductGenerator:\n    \"\"\"\n    Generates all pairwise product objects from two input lists.\n    Ensures deterministic generation order.\n    \"\"\"\n    @staticmethod\n    def generate(list_a, list_b):\n        \"\"\"\n        Creates a list of Product objects for all combinations of elements\n        from list_a and list_b.\n        \"\"\"\n        products = []\n        for a in list_a:\n            for b in list_b:\n                products.append(Product(a, b))\n        return products\n\nclass ResultList:\n    \"\"\"\n    Manages a list of numeric products for sorting and truncation.\n    Allows extracting values from Product objects, sorting, and taking the top-k results.\n    \"\"\"\n    def __init__(self, product_values):\n        self._products = product_values\n\n    @classmethod\n    def from_products(cls, products_obj_list):\n        \"\"\"\n        Converts a list of Product objects into a ResultList instance\n        containing their numeric values.\n        \"\"\"\n        values = [p.value for p in products_obj_list]\n        return cls(values)\n\n    def sort_desc(self):\n        \"\"\"Sorts the internal list of products in descending order.\"\"\"\n        self._products.sort(reverse=True)\n\n    def truncate(self, k):\n        \"\"\"\n        Returns the first k products from the sorted list,\n        or fewer if there are not enough products.\n        \"\"\"\n        return self._products[:min(k, len(self._products))]\n\ndef large_product(list_a, list_b, k):\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    products_objects = ProductGenerator.generate(list_a, list_b)\n    result_list_instance = ResultList.from_products(products_objects)\n    result_list_instance.sort_desc()\n    return result_list_instance.truncate(k)"}
{"task_id": "Mbpp/310", "solution": "def string_to_tuple(s: str) -> tuple:\n    \"\"\"\n    Converts a string to a tuple of characters, excluding space characters.\n    Preserves order and includes digits/punctuation.\n    \"\"\"\n    return tuple(char for char in s if char != ' ')"}
{"task_id": "Mbpp/311", "solution": "from typing import Optional\n\ndef _compute_msb(n: int) -> int:\n    \"\"\"Computes the most significant bit position for a non-negative integer.\"\"\"\n    if n == 0:\n        return 0\n    return n.bit_length() - 1\n\ndef _find_most_significant_unset_bit(n: int, msb: int) -> Optional[int]:\n    \"\"\"Scans from msb down to 0 to find the highest unset bit.\"\"\"\n    for pos in range(msb, -1, -1):\n        if ((n >> pos) & 1) == 0:\n            return pos\n    return None\n\ndef _set_bit(n: int, pos: int) -> int:\n    \"\"\"Sets a specific bit position in an integer.\"\"\"\n    return n | (1 << pos)\n\ndef set_left_most_unset_bit(n: int) -> int:\n    msb = _compute_msb(n)\n    unset_pos = _find_most_significant_unset_bit(n, msb)\n    \n    if unset_pos is not None:\n        return _set_bit(n, unset_pos)\n    else:\n        # All bits up to MSB are set, so set the next higher bit\n        return _set_bit(n, msb + 1)"}
{"task_id": "Mbpp/312", "solution": "import math\nfrom dataclasses import dataclass\nimport datetime\n\n@dataclass\nclass ConeInput:\n    radius: float\n    height: float\n\n@dataclass\nclass VolumeResult:\n    volume: float\n    computed_at: datetime.datetime\n\n@dataclass\nclass FunctionSpec:\n    name: str = \"volume_cone\"\n    language: str = \"Python\"\n\nclass MathConstant:\n    pi: float = math.pi\n\nclass InputValidator:\n    def is_numeric(self, value) -> bool:\n        \"\"\"Return True if value is int or float (exclude bool).\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\nclass VolumeCalculator:\n    def compute(self, radius, height) -> float:\n        \"\"\"Compute cone volume using (1/3) * MathConstant.pi * radius**2 * height and return float.\"\"\"\n        result = (1.0/3.0) * MathConstant.pi * (float(radius) ** 2) * float(height)\n        return float(result)\n\ndef volume_cone(radius, height):\n    \"\"\"Validate radius and height are numeric (int/float) and compute cone volume.\n\n    Returns: float\n    Raises: TypeError on non-numeric inputs (BR-8 recommendation).\n    \"\"\"\n    validator = InputValidator()\n    if not validator.is_numeric(radius):\n        raise TypeError(\"radius must be a numeric type (int or float)\")\n    if not validator.is_numeric(height):\n        raise TypeError(\"height must be a numeric type (int or float)\")\n    calculator = VolumeCalculator()\n    result = calculator.compute(radius, height)\n    return result"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n):\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    Raises TypeError if n is not an integer, or ValueError if n is less than 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 1:\n        raise ValueError(\"Input 'n' must be greater than or equal to 1.\")\n\n    return 1 << (n.bit_length() - 1)"}
{"task_id": "Mbpp/390", "solution": "def add_string(input_list, format_string):\n    \"\"\"Apply format_string to each element of input_list replacing '{0}' with element's string representation.\n\n    Returns: list of strings\n    \"\"\"\n    output_list = []\n    for element in input_list:\n        # Use str(element) for substitution and format_string.replace to handle '{0}' occurrences.\n        formatted_element = format_string.replace('{0}', str(element))\n        output_list.append(formatted_element)\n    return output_list"}
{"task_id": "Mbpp/389", "solution": "class InputParameter:\n    def __init__(self, n: int):\n        self.n = n\n\nclass ValidationService:\n    def is_non_negative_integer(self, n) -> bool:\n        \"\"\"\n        Validates if the input n is a non-negative integer.\n        \"\"\"\n        return isinstance(n, int) and n >= 0\n\nclass LucasSequence:\n    L0: int = 2\n    L1: int = 1\n\n    def recurrence(self, a: int, b: int) -> int:\n        \"\"\"\n        Calculates the next Lucas number based on the previous two.\n        \"\"\"\n        return a + b\n\nclass Result:\n    def __init__(self, value: int):\n        self.value = value\n\nclass LucasCalculator:\n    def __init__(self):\n        self._sequence = LucasSequence()\n\n    def find_lucas(self, n: int) -> Result:\n        \"\"\"\n        Computes the nth Lucas number and returns it wrapped in a Result object.\n        \"\"\"\n        computed_value = self.compute_iterative(n)\n        return Result(computed_value)\n\n    def compute_iterative(self, n: int) -> int:\n        \"\"\"\n        Calculates the nth Lucas number using an iterative approach.\n        \"\"\"\n        if n == 0:\n            return self._sequence.L0\n        if n == 1:\n            return self._sequence.L1\n\n        prev_prev = self._sequence.L0\n        prev = self._sequence.L1\n\n        for _ in range(2, n + 1):\n            current = self._sequence.recurrence(prev_prev, prev)\n            prev_prev = prev\n            prev = current\n        return prev\n\ndef find_lucas(n: int) -> int:\n    \"\"\"\n    Finds the n'th Lucas number using 0-based indexing.\n    Raises ValueError if n is not a non-negative integer.\n    \"\"\"\n    param = InputParameter(n)\n    validator = ValidationService()\n\n    if not validator.is_non_negative_integer(param.n):\n        raise ValueError(\"n must be a non-negative integer\")\n\n    calculator = LucasCalculator()\n    result_obj = calculator.find_lucas(param.n)\n    return result_obj.value"}
{"task_id": "Mbpp/394", "solution": "def _has_duplicates_iterative(t: tuple) -> bool:\n    \"\"\"Return True if duplicates exist in tuple t, else False.\n    Uses a set to track seen elements for O(n) average time complexity.\n    \"\"\"\n    seen = set()\n    for item in t:\n        if item in seen:\n            return True\n        seen.add(item)\n    return False\n\ndef check_distinct(t: tuple) -> bool:\n    \"\"\"Return True iff tuple t contains no duplicates.\n    This function delegates to an internal helper for duplicate detection.\n    \"\"\"\n    return not _has_duplicates_iterative(t)"}
{"task_id": "Mbpp/391", "solution": "from typing import Any, Dict, List\n\nclass ConvertListDictionary:\n    \"\"\"Encapsulates validation and nested-mapping construction logic.\"\"\"\n\n    def convert(self, *lists) -> List[Dict]:\n        \"\"\"Orchestrates validation and construction, returning the list-of-dictionaries.\"\"\"\n        self.validate_count(*lists)\n        self.validate_lengths(*lists)\n\n        result_list: List[Dict] = []\n        length = len(lists[0])\n        first_list = lists[0]\n        remaining_lists = lists[1:]\n\n        for i in range(length):\n            top_key = first_list[i]\n            nested_values = [lst[i] for lst in remaining_lists]\n            nested_dict = self._build_nested_mapping(nested_values)\n            result_list.append({top_key: nested_dict})\n        return result_list\n\n    def validate_count(self, *lists) -> None:\n        \"\"\"Raises ValueError if fewer than two lists are provided.\"\"\"\n        if len(lists) < 2:\n            raise ValueError(\"At least two lists are required for conversion.\")\n\n    def validate_lengths(self, *lists) -> None:\n        \"\"\"Raises ValueError if input lists do not all have identical length.\"\"\"\n        if not lists:\n            return # Handled by validate_count for < 2 lists, but good for robustness.\n        \n        first_len = len(lists[0])\n        for lst in lists[1:]:\n            if len(lst) != first_len:\n                raise ValueError(\"All input lists must have the same length.\")\n\n    def _build_nested_mapping(self, values: List[Any]) -> Dict:\n        \"\"\"Given a list of values, constructs a nested dictionary from them.\"\"\"\n        if not values:\n            return {} # Or raise an error based on deeper requirements, but for nesting, empty seems reasonable for zero remaining lists.\n            \n        current: Any = values[-1]\n        for v in reversed(values[:-1]):\n            current = {v: current}\n        return current\n\n\ndef convert_list_dictionary(*lists) -> List[Dict]:\n    \"\"\"Converts two or more lists to a list of nested dictionaries.\n    Raises ValueError for invalid inputs (fewer than two lists or unequal lengths).\"\"\"\n    impl = ConvertListDictionary()\n    return impl.convert(*lists)"}
{"task_id": "Mbpp/392", "solution": "class RecurrenceCalculator:\n    \"\"\"\n    Encapsulates the recursive computation and memoization for f(n).\n    Uses a dictionary to cache results of previously computed f(k) values.\n    \"\"\"\n    def __init__(self):\n        self._cache = {}\n\n    def compute_recursive(self, n: int) -> int:\n        \"\"\"\n        Computes f(n) using the given recurrence relation and memoization.\n        f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n        \"\"\"\n        # Base case: for n <= 1, f(n) = n.\n        if n <= 1:\n            self._cache[n] = n\n            return n\n\n        # Check cache for memoized result\n        if n in self._cache:\n            return self._cache[n]\n\n        # Compute sub-problems using integer (floor) division\n        f_n_div_2 = self.compute_recursive(n // 2)\n        f_n_div_3 = self.compute_recursive(n // 3)\n        f_n_div_4 = self.compute_recursive(n // 4)\n        f_n_div_5 = self.compute_recursive(n // 5)\n\n        # Apply the recurrence relation\n        sum_of_parts = f_n_div_2 + f_n_div_3 + f_n_div_4 + f_n_div_5\n        result = max(sum_of_parts, n)\n\n        # Store result in cache before returning\n        self._cache[n] = result\n        return result\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Finds the maximum sum possible by using the given equation\n    f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    \"\"\"\n    calculator = RecurrenceCalculator()\n    return calculator.compute_recursive(n)"}
