{"task_id": "Mbpp/563", "solution": "import re\nfrom typing import List\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    raw: str\n\n@dataclass\nclass ExtractedValue:\n    value: str\n    position: int\n\nclass Extractor:\n    def extract_values(self, input_str: str) -> List[ExtractedValue]:\n        \"\"\"\n        Parses the input string to find double-quoted substrings,\n        strips quotes, trims whitespace, and records position.\n        \"\"\"\n        # Use regex to find all substrings enclosed in double quotes.\n        # The non-greedy quantifier (.*?) ensures it matches up to the next double quote.\n        matches = re.findall(r'\"(.*?)\"', input_str)\n\n        extracted_values_objects = []\n        for i, match_content in enumerate(matches):\n            # Trim leading and trailing whitespace from each extracted value.\n            trimmed_value = match_content.strip()\n            extracted_values_objects.append(ExtractedValue(value=trimmed_value, position=i))\n\n        return extracted_values_objects\n\ndef extract_values(input: str) -> List[str]:\n    \"\"\"\n    Extracts values between double quotation marks from a string,\n    removing quotes and trimming whitespace from each extracted value.\n    \"\"\"\n    input_obj = InputString(raw=input)\n    extractor = Extractor()\n    extracted_value_objects = extractor.extract_values(input_obj.raw)\n\n    return [ev.value for ev in extracted_value_objects]"}
{"task_id": "Mbpp/559", "solution": "from typing import List\n\nclass Validator:\n    \"\"\"\n    Input validation utilities for arr and n.\n    Checks types and element types, raising ValueError on invalid inputs.\n    \"\"\"\n    def validate_input(self, arr: List[int], n: int) -> bool:\n        \"\"\"\n        Validates the input array and its length.\n        \"\"\"\n        if not isinstance(arr, list):\n            raise ValueError('Invalid input: arr must be a list.')\n        if not isinstance(n, int):\n            raise ValueError('Invalid input: n must be an int.')\n        if not all(isinstance(x, int) for x in arr):\n            raise ValueError('Invalid input: all elements of arr must be integers.')\n        if n != len(arr):\n            raise ValueError('Invalid input: n must be equal to the length of arr.')\n        return True\n\nclass Array:\n    \"\"\"Represents input array metadata.\"\"\"\n    def __init__(self, elements: List[int]):\n        self.elements = elements\n        self.length = len(elements)\n\nclass Subarray:\n    \"\"\"Represents a contiguous subarray region and its sum.\"\"\"\n    def __init__(self, start: int, end: int, sum: int):\n        self.start = start\n        self.end = end\n        self.sum = sum\n\nclass RESULT:\n    \"\"\"Represents the computed result value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass MaxSubarraySolver:\n    \"\"\"Computes the maximum contiguous subarray sum using Kadane's algorithm.\"\"\"\n    def max_sub_array_sum(self, arr: List[int], n: int) -> int:\n        \"\"\"\n        Public method to compute the maximum contiguous subarray sum.\n        Delegates core computation to _kadane.\n        \"\"\"\n        # The 'n' parameter is part of the public API signature but not directly used in Kadane's core logic.\n        return self._kadane(arr)\n\n    def _kadane(self, arr: List[int]) -> int:\n        \"\"\"\n        Implements Kadane's algorithm to find the maximum sum of a contiguous subarray.\n        Handles empty arrays and arrays with all negative numbers.\n        \"\"\"\n        if not arr:\n            return 0  # Max sum of an empty array is 0\n\n        max_so_far = arr[0]\n        current_max = arr[0]\n\n        for i in range(1, len(arr)):\n            current_max = max(arr[i], current_max + arr[i])\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\ndef max_sub_array_sum(arr: List[int], n: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist in the given list.\n    Validates inputs and delegates computation to an internal solver.\n    \"\"\"\n    # Validate inputs using the Validator class\n    validator = Validator()\n    validator.validate_input(arr, n) # This will raise ValueError on invalid input as per design\n\n    # Compute the result using the MaxSubarraySolver\n    solver = MaxSubarraySolver()\n    result = solver.max_sub_array_sum(arr, n)\n\n    return result"}
