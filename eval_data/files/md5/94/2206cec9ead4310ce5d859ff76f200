{"task_id": "Mbpp/564", "solution": "def count_Pairs(arr, n):\n    \"\"\"\n    Counts the number of possible unordered pairs where both elements are unequal.\n    Assumes valid input types and n == len(arr).\n    \"\"\"\n    if n < 2:\n        return 0\n\n    # Manually compute value frequencies\n    value_frequency = {}\n    for x in arr:\n        value_frequency[x] = value_frequency.get(x, 0) + 1\n\n    total_pairs = n * (n - 1) // 2\n    equal_pairs = 0\n    for freq in value_frequency.values():\n        equal_pairs += freq * (freq - 1) // 2\n\n    return total_pairs - equal_pairs"}
{"task_id": "Mbpp/566", "solution": "def sum_digits(n):\n    \"\"\"Calculates the sum of the digits of a non-negative integer.\n    Returns 0 if the input integer is 0.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    total_sum = 0\n    while n > 0:\n        digit = n % 10\n        total_sum += digit\n        n //= 10\n    return total_sum"}
{"task_id": "Mbpp/567", "solution": "class ListInput:\n    \"\"\"Minimal domain representation of an input list.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self._elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated list.\"\"\"\n        return len(self._elements)\n\nclass Result:\n    \"\"\"Value object encapsulating the boolean outcome.\"\"\"\n    def __init__(self, is_sorted: bool) -> None:\n        self._is_sorted = is_sorted\n\n    def value(self) -> bool:\n        \"\"\"Returns the boolean sorted status.\"\"\"\n        return self._is_sorted\n\nclass SortChecker:\n    \"\"\"Encapsulates the single-pass adjacent comparison algorithm.\"\"\"\n    @staticmethod\n    def _check_adjacent_pairs(elements: list) -> bool:\n        \"\"\"Performs a single-pass check for non-decreasing order.\"\"\"\n        if len(elements) <= 1:\n            return True\n\n        for i in range(len(elements) - 1):\n            if elements[i] > elements[i+1]:\n                return False\n        return True\n\n    @classmethod\n    def issort_list(cls, elements: list) -> bool:\n        \"\"\"Delegates to adjacent-pair comparison and wraps result.\"\"\"\n        list_input_obj = ListInput(elements) # 'Reads' the list\n        \n        is_sorted_value = cls._check_adjacent_pairs(elements)\n        \n        result_obj = Result(is_sorted_value) # 'Produces' the Result\n        return result_obj.value()\n\ndef issort_list(list: list) -> bool:\n    \"\"\"Checks whether a specified list is sorted in non-decreasing order.\"\"\"\n    return SortChecker.issort_list(list)"}
