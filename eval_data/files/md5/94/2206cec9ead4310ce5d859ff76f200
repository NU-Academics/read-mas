{"task_id": "Mbpp/232", "solution": "def _deduplicate(values):\n    \"\"\"Returns a set of unique numeric values from the input list.\"\"\"\n    return set(values)\n\ndef _select_n_largest(unique_values, n):\n    \"\"\"Selects up to n largest values from a set and returns them as a list.\"\"\"\n    # Convert set to list for sorting, then sort in descending order.\n    sorted_values = sorted(list(unique_values), reverse=True)\n    # Return the first n elements; slicing handles cases where len(sorted_values) < n.\n    return sorted_values[:n]\n\ndef larg_nnum(values, n):\n    \"\"\"\n    Returns a list containing the n largest unique items from the input list.\n    The order of items in the returned list is not guaranteed.\n    \"\"\"\n    unique_items = _deduplicate(values)\n    largest_n_items = _select_n_largest(unique_items, n)\n    return largest_n_items"}
{"task_id": "Mbpp/233", "solution": "import math\n\nclass MathConstant:\n    \"\"\"Provides access to mathematical constants.\"\"\"\n    pi = math.pi\n\nclass LateralSurfaceCalculator:\n    \"\"\"Calculates the lateral surface area of a cylinder.\"\"\"\n    def compute(self, radius: float, height: float) -> float:\n        \"\"\"\n        Computes the lateral surface area using the formula 2 * pi * radius * height.\n        \"\"\"\n        return 2 * MathConstant.pi * radius * height\n\ndef lateralsuface_cylinder(radius, height) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cylinder given its radius and height.\n    \"\"\"\n    calculator = LateralSurfaceCalculator()\n    return calculator.compute(float(radius), float(height))"}
{"task_id": "Mbpp/235", "solution": "class IntegerValue:\n    value: int\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass BitMask:\n    mask: int\n    def __init__(self, mask: int = 0) -> None:\n        self.mask = mask\n\n    def generateMask(self, numBits: int) -> int:\n        \"\"\"Generate mask with 1s at 1-based even positions up to numBits.\"\"\"\n        generated_mask = 0\n        for p in range(1, numBits + 1):\n            if p % 2 == 0:\n                generated_mask |= (1 << (p - 1))\n        return generated_mask\n\nclass EvenBitSetter:\n    def even_bit_set_number(self, n: int) -> int:\n        \"\"\"Return integer with 1-based even-position bits set while preserving odd bits.\"\"\"\n        # Determine the effective number of bits for the mask based on input 'n'.\n        # This aligns with the unit test even_bit_set_number(10) == 10 by not\n        # setting bits beyond n's current magnitude if they were originally zero.\n        num_bits = n.bit_length()\n\n        bit_mask_generator = BitMask()\n        mask = bit_mask_generator.generateMask(num_bits)\n\n        # Apply the mask using bitwise OR to set specified even bits and preserve odd bits.\n        result = n | mask\n        return result\n\n# Instantiate EvenBitSetter once for the module-level API delegation.\n_even_bit_setter_instance = EvenBitSetter()\n\ndef even_bit_set_number(n: int) -> int:\n    \"\"\"Module-level API required by FR1. Delegates to EvenBitSetter.even_bit_set_number.\"\"\"\n    return _even_bit_setter_instance.even_bit_set_number(n)"}
{"task_id": "Mbpp/237", "solution": "from typing import Dict, List, Tuple\n\nclass TupleNormalizer:\n    \"\"\"Normalizes and validates 2-element tuples into a canonical form.\"\"\"\n    def normalize(self, t: Tuple) -> Tuple:\n        \"\"\"\n        Validates the input is a 2-element tuple with comparable elements,\n        then returns its canonical form (sorted tuple).\n        \"\"\"\n        if not isinstance(t, tuple):\n            raise ValueError(f\"Input item '{t}' is not a tuple.\")\n        if len(t) != 2:\n            raise ValueError(f\"Tuple '{t}' does not have exactly 2 elements.\")\n        try:\n            return tuple(sorted(t))\n        except TypeError as e:\n            raise ValueError(f\"Elements in tuple '{t}' are not comparable.\") from e\n\nclass OccurrenceDictionary:\n    \"\"\"Stores and manages the counts of canonical tuples.\"\"\"\n    def __init__(self):\n        self._mapping: Dict[Tuple, int] = {}\n\n    def increment(self, key: Tuple) -> None:\n        \"\"\"Increments the count for a given tuple key.\"\"\"\n        self._mapping[key] = self._mapping.get(key, 0) + 1\n\n    def get_mapping(self) -> Dict[Tuple, int]:\n        \"\"\"Returns a shallow copy of the internal mapping.\"\"\"\n        return self._mapping.copy()\n\nclass TupleOccurrenceCounter:\n    \"\"\"Orchestrates the process of normalizing tuples and counting their occurrences.\"\"\"\n    def __init__(self):\n        self._normalizer = TupleNormalizer()\n        self._occurrence_dict = OccurrenceDictionary()\n\n    def check_occurences(self, input_list: List[Tuple]) -> Dict[Tuple, int]:\n        \"\"\"\n        Processes a list of tuples, normalizes them, and counts their occurrences.\n        Returns a dictionary mapping canonical tuples to their counts.\n        \"\"\"\n        if not input_list:\n            return {}\n\n        for item in input_list:\n            canonical = self._normalizer.normalize(item)\n            self._occurrence_dict.increment(canonical)\n\n        return self._occurrence_dict.get_mapping()\n\ndef check_occurences(input_list: List[Tuple]) -> Dict[Tuple, int]:\n    \"\"\"\n    Takes a list of tuples and returns a dictionary mapping each unique\n    canonical tuple to its occurrence count.\n    \"\"\"\n    counter = TupleOccurrenceCounter()\n    return counter.check_occurences(input_list)"}
{"task_id": "Mbpp/239", "solution": "class InvalidParameterError(ValueError):\n    \"\"\"Exception raised for invalid parameters to the sequence generation function.\"\"\"\n    pass\n\nclass Validator:\n    \"\"\"Validates input parameters m and n.\"\"\"\n    def validatePositiveIntegers(self, m: int, n: int) -> None:\n        \"\"\"\n        Ensures m and n are positive integers, raising InvalidParameterError if not.\n        \"\"\"\n        if not isinstance(m, int) or not isinstance(n, int):\n            raise InvalidParameterError(\"Input m and n must be integers.\")\n        if m <= 0 or n <= 0:\n            raise InvalidParameterError(\"Input m and n must be positive integers.\")\n\nclass Counter:\n    \"\"\"Computes the number of valid sequences using dynamic programming.\"\"\"\n    def compute(self, m: int, n: int) -> int:\n        \"\"\"\n        Calculates the total number of sequences of length n with elements up to m,\n        where each element is at least twice the previous one.\n        \"\"\"\n        if n == 1:\n            return m\n\n        # dp_prev[v] stores the number of sequences of length (current_length - 1) ending with value v\n        dp_prev = [0] * (m + 1)\n        # Base case: For length 1, any value from 1 to m is a valid sequence\n        for v in range(1, m + 1):\n            dp_prev[v] = 1\n\n        # Iterate for lengths from 2 up to n\n        for _ in range(n - 1):\n            dp_current = [0] * (m + 1)\n            prefix_sum = [0] * (m + 1)\n\n            # Compute prefix sums for dp_prev for O(1) sum queries\n            for v_idx in range(1, m + 1):\n                prefix_sum[v_idx] = prefix_sum[v_idx - 1] + dp_prev[v_idx]\n\n            # Compute dp_current based on dp_prev\n            for current_val in range(1, m + 1):\n                # The previous element must be less than or equal to current_val // 2\n                max_prev_val = current_val // 2\n                if max_prev_val >= 1:\n                    # Sum counts for all valid previous elements\n                    dp_current[current_val] = prefix_sum[max_prev_val]\n            dp_prev = dp_current\n\n        return sum(dp_prev)\n\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Finds the number of possible sequences of length n, such that each element is a positive integer\n    and is greater than or equal to twice the previous element but less than or equal to m.\n    \"\"\"\n    validator = Validator()\n    validator.validatePositiveIntegers(m, n)\n\n    counter = Counter()\n    return counter.compute(m, n)"}
