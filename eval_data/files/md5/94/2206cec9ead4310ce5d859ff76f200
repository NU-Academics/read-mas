{"task_id": "Mbpp/12", "solution": "from typing import Any, List\n\nclass Row:\n    \"\"\"Represents a single row of integers with its original index for stable sorting.\"\"\"\n    def __init__(self, values: List[int], original_index: int) -> None:\n        self.values = values\n        self.original_index = original_index\n\n    def sum(self) -> int:\n        \"\"\"Calculates the sum of the row's values.\"\"\"\n        return sum(self.values)\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns the row's values as a new list.\"\"\"\n        return list(self.values)\n\nclass Matrix:\n    \"\"\"Represents a collection of Row objects and provides methods to access them.\"\"\"\n    def __init__(self, rows: List[Row]) -> None:\n        self.rows = rows\n\n    def get_row_sums(self) -> List[int]:\n        \"\"\"Returns a list of sums for each row in the matrix.\"\"\"\n        return [r.sum() for r in self.rows]\n\n    def to_list(self) -> List[List[int]]:\n        \"\"\"Converts the Matrix object back to a list of lists of integers.\"\"\"\n        return [r.to_list() for r in self.rows]\n\ndef _validate_input(matrix: Any) -> None:\n    \"\"\"Validates that the input matrix is a list/tuple of lists/tuples of integers.\"\"\"\n    if not isinstance(matrix, (list, tuple)):\n        raise TypeError(\"Input 'matrix' must be a list or tuple.\")\n    \n    for i, row in enumerate(matrix):\n        if not isinstance(row, (list, tuple)):\n            raise ValueError(f\"Row at index {i} must be a list or tuple.\")\n        for j, item in enumerate(row):\n            if not isinstance(item, int):\n                raise ValueError(f\"Element at [{i}][{j}] must be an integer.\")\n\ndef _to_matrix(matrix: List[List[int]]) -> Matrix:\n    \"\"\"Converts a native list-of-lists into a custom Matrix object with Row objects.\"\"\"\n    rows = [Row(list(row), idx) for idx, row in enumerate(matrix)]\n    return Matrix(rows)\n\ndef sort_matrix(matrix: List[List[int]]) -> List[List[int]]:\n    \"\"\"\n    Sorts a given matrix in ascending order according to the sum of its rows.\n    Rows with equal sums maintain their original relative order.\n    \"\"\"\n    _validate_input(matrix)\n    m = _to_matrix(matrix)\n    sorted_rows = sorted(m.rows, key=lambda r: (r.sum(), r.original_index))\n    result_matrix = Matrix(sorted_rows)\n    return result_matrix.to_list()"}
{"task_id": "Mbpp/14", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass TriangularPrism:\n    \"\"\"A data container for triangular prism dimensions and volume.\"\"\"\n    base: float\n    height: float\n    length: float\n    volume: float = 0.0\n\nclass InputValidator:\n    \"\"\"Validates input types for numeric values.\"\"\"\n    def is_numeric(self, value) -> bool:\n        # Per prompt requirements: \"DO NOT add isinstance() checks\"\n        # This method, therefore, cannot perform actual type validation.\n        return True\n\nclass VolumeCalculator:\n    \"\"\"Calculates the volume of a triangular prism.\"\"\"\n    def compute(self, base: float, height: float, length: float) -> float:\n        return 0.5 * base * height * length\n\ndef find_Volume(base, height, length):\n    \"\"\"\n    Calculates the volume of a triangular prism using the formula 0.5 * base * height * length.\n    This function omits input validation and error raising as per prompt instructions.\n    \"\"\"\n    # Instantiate InputValidator and call its methods as per design,\n    # but actual validation is bypassed due to prompt constraints (\"DO NOT add isinstance() checks\").\n    validator = InputValidator()\n    _ = validator.is_numeric(base)\n    _ = validator.is_numeric(height)\n    _ = validator.is_numeric(length)\n\n    # Instantiate VolumeCalculator and compute the volume.\n    calculator = VolumeCalculator()\n    return calculator.compute(base, height, length)"}
{"task_id": "Mbpp/16", "solution": "import re\n\nPATTERN: str = r'^[a-z]+(_[a-z]+)+$'\n\nclass RegexPattern:\n    \"\"\"Encapsulates the exact regex PATTERN and exposes a match operation.\"\"\"\n    def __init__(self, pattern: str = None) -> None:\n        self.pattern = pattern if pattern is not None else PATTERN\n        self._compiled = re.compile(self.pattern)\n\n    def match(self, s: str) -> bool:\n        \"\"\"Returns True if s matches the pattern exactly, else False.\"\"\"\n        return bool(self._compiled.fullmatch(s))\n\ndef text_lowercase_underscore(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters \n    joined with an underscore using a specific regex pattern.\n    \"\"\"\n    rp = RegexPattern()\n    matched = rp.match(input_string)\n    return bool(matched)"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(n: int) -> bool:\n    \"\"\"Return True iff there exists integer k >= 1 with n == k * 2**k - 1.\"\"\"\n    k = 1\n    while True:\n        candidate = k * (2**k) - 1\n        if candidate == n:\n            return True\n        if candidate > n:\n            return False\n        k += 1"}
{"task_id": "Mbpp/18", "solution": "from typing import Set\n\nclass CharacterSet:\n    \"\"\"Helper class to efficiently check for character membership.\"\"\"\n    def __init__(self, chars: str) -> None:\n        self._chars: Set[str] = set(chars)\n\n    def contains(self, ch: str) -> bool:\n        \"\"\"Checks if a character is present in the set.\"\"\"\n        return ch in self._chars\n\ndef remove_dirty_chars(source: str, filter: str) -> str:\n    if source == \"\":\n        return \"\"\n    if filter == \"\":\n        return source\n\n    filter_set = CharacterSet(filter)\n    result_chars: list[str] = []\n    for ch in source:\n        if not filter_set.contains(ch):\n            result_chars.append(ch)\n    return ''.join(result_chars)"}
{"task_id": "Mbpp/56", "solution": "class ReverseCalculator:\n    def reverse(self, n: int) -> int:\n        \"\"\"\n        Returns the integer obtained by reversing the decimal digits of n.\n        Leading zeros in the reversed string are dropped when converted to int (e.g., reverse(70) -> 7).\n        \"\"\"\n        s = str(n)\n        reversed_s = s[::-1]\n        return int(reversed_s)\n\nclass CheckFunction:\n    def __init__(self, reverse_calculator: ReverseCalculator):\n        \"\"\"Initializes CheckFunction with a ReverseCalculator instance.\"\"\"\n        self._reverse_calculator = reverse_calculator\n\n    def check(self, n: int) -> bool:\n        \"\"\"\n        Checks if n is one less than twice its reverse.\n        \"\"\"\n        reversed_n = self._reverse_calculator.reverse(n)\n        return n == (2 * reversed_n) - 1\n\ndef check(n: int) -> bool:\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    \"\"\"\n    # Instantiate the dependency for digit reversal\n    reverse_calculator = ReverseCalculator()\n    # Instantiate the checker, injecting the dependency\n    checker = CheckFunction(reverse_calculator)\n    # Delegate the check to the checker instance\n    return checker.check(n)"}
{"task_id": "Mbpp/58", "solution": "class IntegerValue:\n    \"\"\"Value-object representing an integer input with sign checks.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_positive(self) -> bool:\n        \"\"\"Returns True if the value is positive.\"\"\"\n        return self.value > 0\n\n    def is_negative(self) -> bool:\n        \"\"\"Returns True if the value is negative.\"\"\"\n        return self.value < 0\n\nclass OppositeSigns:\n    \"\"\"Encapsulates evaluation logic for opposite signs.\"\"\"\n    def opposite_Signs(self, a: int, b: int) -> bool:\n        \"\"\"Returns True if the two integers have opposite signs.\"\"\"\n        a_val = IntegerValue(a)\n        b_val = IntegerValue(b)\n        return (a_val.is_positive() and b_val.is_negative()) or \\\n               (a_val.is_negative() and b_val.is_positive())\n\ndef opposite_Signs(a: int, b: int) -> bool:\n    \"\"\"Public API: return True if (a > 0 and b < 0) or (a < 0 and b > 0).\"\"\"\n    checker = OppositeSigns()\n    return checker.opposite_Signs(a, b)"}
{"task_id": "Mbpp/59", "solution": "class InputValidator:\n    \"\"\"Helper class for input validation.\"\"\"\n    def is_valid(self, n: object) -> bool:\n        \"\"\"Returns True if n is an integer and n >= 1, otherwise False.\"\"\"\n        return isinstance(n, int) and n >= 1\n\n    def raise_error(self, message: str) -> None:\n        \"\"\"Raises a ValueError with the given message.\"\"\"\n        raise ValueError(message)\n\nclass OctagonalNumber:\n    \"\"\"Helper class for octagonal number computation.\"\"\"\n    formula_description: str = \"O_n = n * (3*n - 2)\"\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the nth octagonal number using the formula O_n = n * (3*n - 2).\"\"\"\n        return n * (3 * n - 2)\n\ndef is_octagonal(n: int) -> int:\n    \"\"\"\n    Validates input n and returns the nth octagonal number.\n    Raises ValueError on invalid input.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.is_valid(n):\n        validator.raise_error(\"n must be integer >= 1\")\n    \n    calculator = OctagonalNumber()\n    return calculator.compute(n)"}
{"task_id": "Mbpp/57", "solution": "from src.digit_list import DigitList\nfrom src.digit_validator import DigitValidator\nfrom src.number_builder import NumberBuilder\n\ndef find_Max_Num(digits):\n    \"\"\"Finds the largest number formed by arranging given digits. Returns 0 for empty or all-zero lists, and raises ValueError if elements are not 0-9 integers.\"\"\"\n    validator = DigitValidator()\n    validator.validate_all(digits)\n\n    if not digits:\n        return 0\n\n    digit_list_obj = DigitList(digits)\n    sorted_digits = digit_list_obj.get_sorted_desc()\n\n    number_builder = NumberBuilder()\n    result_int = number_builder.concatenate(sorted_digits)\n\n    return result_int"}
{"task_id": "Mbpp/61", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass Substring:\n    value: str\n    start_index: int\n    end_index: int\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the substring.\"\"\"\n        return len(self.value)\n\n    def sum_digits(self) -> int:\n        \"\"\"Calculates the sum of digits in the substring.\"\"\"\n        return sum(int(digit) for digit in self.value)\n\n@dataclass\nclass InputString:\n    value: str\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input string.\"\"\"\n        return len(self.value)\n\n    def substrings(self) -> List[Substring]:\n        \"\"\"Enumerates all contiguous substrings of the input string.\"\"\"\n        substring_list: List[Substring] = []\n        n = self.length()\n        for i in range(n):\n            for j in range(i, n):\n                substring_list.append(Substring(self.value[i : j + 1], i, j + 1))\n        return substring_list\n\n@dataclass\nclass Result:\n    count: int\n\nclass SubstringCalculator:\n    def count_Substrings(self, s: str) -> int:\n        \"\"\"Counts substrings where sum of digits equals substring length.\"\"\"\n        input_str = InputString(s)\n        substrings = input_str.substrings()\n        \n        count = 0\n        for sub in substrings:\n            if sub.sum_digits() == sub.length():\n                count += 1\n        return count\n\n    def getSubstrings(self, s: str) -> List[Substring]:\n        \"\"\"Returns a list of all substrings.\"\"\"\n        return InputString(s).substrings()\n\n    def sumDigits(self, sub: Substring) -> int:\n        \"\"\"Calculates the sum of digits for a given substring.\"\"\"\n        return sub.sum_digits()\n\ndef count_Substrings(s: str) -> int:\n    \"\"\"Public API. Accepts digit-only string s and returns integer count of matching substrings.\"\"\"\n    calculator = SubstringCalculator()\n    return calculator.count_Substrings(s)"}
{"task_id": "Mbpp/63", "solution": "from typing import Iterable, List\nimport numbers\n\ndef _compute_differences(input_list: Iterable[tuple[numbers.Number, numbers.Number]]) -> List[numbers.Number]:\n    \"\"\"Compute absolute differences for each pair and return a list of these differences.\"\"\"\n    differences = []\n    for a, b in input_list:\n        differences.append(abs(a - b))\n    return differences\n\ndef max_difference(input_list: Iterable[tuple[numbers.Number, numbers.Number]]) -> numbers.Number:\n    \"\"\"Find the maximum difference between available pairs in the given tuple list.\"\"\"\n    # Per prompt requirements, this function assumes valid input for its core logic.\n    # If input_list is empty, max([]) will naturally raise a ValueError.\n    differences = _compute_differences(input_list)\n    return max(differences)"}
{"task_id": "Mbpp/64", "solution": "def validate_input(list_of_tuples: list) -> None:\n    \"\"\"\n    Validates that the input is a list of 2-element tuples with numeric second elements.\n    Raises ValueError on validation failure.\n    \"\"\"\n    if not isinstance(list_of_tuples, list):\n        raise ValueError(\"Input must be a list.\")\n    for i, item in enumerate(list_of_tuples):\n        if not isinstance(item, tuple):\n            raise ValueError(f\"Element at index {i} is not a tuple: {item}\")\n        if len(item) != 2:\n            raise ValueError(f\"Tuple at index {i} does not have length 2: {item}\")\n        if not isinstance(item[1], (int, float)):\n            raise ValueError(f\"Second element of tuple at index {i} is not a number: {item}\")\n\ndef sort_by_mark(list_of_tuples: list) -> list:\n    \"\"\"\n    Returns a new list sorted by the second element of each tuple in ascending order.\n    Assumes input has already been validated.\n    \"\"\"\n    return sorted(list_of_tuples, key=lambda t: t[1])\n\ndef subject_marks(list_of_tuples: list) -> list:\n    \"\"\"\n    Sorts a list of tuples using the second value of each tuple in ascending order.\n    Raises ValueError for invalid input (e.g., not a list, non-tuple elements, non-numeric marks).\n    \"\"\"\n    validate_input(list_of_tuples)\n    return sort_by_mark(list_of_tuples)"}
{"task_id": "Mbpp/65", "solution": "def _is_number(value) -> bool:\n    \"\"\"Returns True if value is a numeric type (int or float), False otherwise.\"\"\"\n    return isinstance(value, (int, float))\n\ndef _flatten(item):\n    \"\"\"Internal generator: yields atomic items from nested list structures.\"\"\"\n    if isinstance(item, list):\n        for sub_item in item:\n            yield from _flatten(sub_item)\n    else:\n        yield item\n\ndef recursive_list_sum(input_list):\n    \"\"\"Accepts a single argument input_list (a list possibly containing nested lists) and returns a numeric total (int or float).\"\"\"\n    total = 0\n    for element in _flatten(input_list):\n        if _is_number(element):\n            total += element\n    return total"}
