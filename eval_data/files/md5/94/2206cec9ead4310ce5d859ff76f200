{"task_id": "Mbpp/420", "solution": "def generate(n: int) -> list:\n    \"\"\"Return list of first n even numbers [2,4,...,2n]. For n==0 returns [].\"\"\"\n    return [2 * k for k in range(1, n + 1)]\n\ndef sumOfCubes(numbers: list) -> int:\n    \"\"\"Return integer sum of cubes of 'numbers'.\"\"\"\n    return sum(x**3 for x in numbers)\n\ndef cube_Sum(n: int) -> int:\n    \"\"\"Calculates the cube sum of the first n even natural numbers.\"\"\"\n    # Input validation, including isinstance() checks and raising ValueError, is omitted\n    # per the explicit prompt constraint: \"Do NOT add isinstance() checks or raise exceptions for edge cases\".\n    \n    even_numbers = generate(n)\n    result = sumOfCubes(even_numbers)\n    return result"}
{"task_id": "Mbpp/419", "solution": "from typing import Iterable\nimport numbers\nimport math\nimport sys\n\ndef _validate_input(numbers: Iterable[float]) -> None:\n    \"\"\"Validates that the input is an iterable and contains only numeric items.\"\"\"\n    if not isinstance(numbers, Iterable):\n        raise TypeError(\"Input must be an iterable of numbers.\")\n    for item in numbers:\n        if not isinstance(item, numbers.Number):\n            raise TypeError(\"All elements in the input iterable must be numeric.\")\n\ndef _round_half_up(x: float) -> int:\n    \"\"\"Implements conventional half-up rounding (e.g., 17.50 -> 18).\"\"\"\n    return int(math.floor(x + 0.5))\n\ndef round_and_sum(numbers: Iterable[float]) -> int:\n    \"\"\"\n    Rounds every number of a given list of numbers using half-up tie-breaking,\n    then prints the total sum multiplied by the length of the list and returns it.\n    \"\"\"\n    _validate_input(numbers)\n\n    num_list = list(numbers)\n    original_length = len(num_list)\n\n    if original_length == 0:\n        sys.stdout.write(str(0) + '\\n')\n        return 0\n\n    rounded_sum = 0\n    for num in num_list:\n        rounded_sum += _round_half_up(float(num))\n\n    final_result = rounded_sum * original_length\n    sys.stdout.write(str(final_result) + '\\n')\n    return final_result"}
{"task_id": "Mbpp/422", "solution": "class Cube:\n    \"\"\"Represents an integer and computes its cube.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def cube(self) -> int:\n        \"\"\"Returns the cube of the value.\"\"\"\n        return self.value ** 3\n\nclass NaturalNumberSeries:\n    \"\"\"Represents the first n natural numbers and generates their cubes.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n        self.cubes = []\n\n    def generate(self) -> list[int]:\n        \"\"\"Generates a list of cubes for the first n natural numbers.\"\"\"\n        self.cubes = []\n        for i in range(1, self.n + 1):\n            cube_obj = Cube(i)\n            self.cubes.append(cube_obj.cube())\n        return self.cubes\n\nclass AverageResult:\n    \"\"\"Encapsulates a computed average value.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n\n    def format(self) -> float:\n        \"\"\"Returns the float value of the average.\"\"\"\n        return self.value\n\ndef find_Average_Of_Cube(n: int) -> float:\n    \"\"\"\n    Computes the average of the cubes of the first n natural numbers.\n    The average is calculated as (1^3 + 2^3 + ... + n^3) / n.\n    \"\"\"\n    series = NaturalNumberSeries(n)\n    cubes_list = series.generate()\n\n    # Sum of an empty list is 0. For n=0, this will lead to a ZeroDivisionError (0/0),\n    # which is allowed by the design context. For n < 0, it will return 0.0.\n    total_sum_cubes = sum(cubes_list)\n    average_value = total_sum_cubes / n\n\n    result_obj = AverageResult(average_value)\n    return result_obj.format()"}
