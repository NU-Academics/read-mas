{"task_id": "Mbpp/626", "solution": "class NumericType:\n    def is_numeric(self, value) -> bool:\n        \"\"\"Return True if value is int or float.\"\"\"\n        return isinstance(value, (int, float))\n\nclass InputValidator:\n    def validate_radius(self, radius) -> bool:\n        \"\"\"Return True if numeric and radius >= 0; else False.\"\"\"\n        numeric = NumericType().is_numeric(radius)\n        if not numeric:\n            return False\n        return radius >= 0\n\nclass Semicircle:\n    def __init__(self, radius):\n        self._radius = radius\n    def radius(self):\n        return self._radius\n\nclass Triangle:\n    def compute_max_area(self, radius) -> float:\n        \"\"\"Return radius * radius (r**2) as specified by requirement.\"\"\"\n        return radius * radius\n\nclass TriangleAreaService:\n    def triangle_area(self, radius):\n        \"\"\"Orchestrate validation and computation; returns None for invalid input, else numeric area.\"\"\"\n        validator = InputValidator()\n        if not validator.validate_radius(radius):\n            return None\n        semicircle = Semicircle(radius)\n        triangle = Triangle()\n        return triangle.compute_max_area(semicircle.radius())\n\ndef triangle_area(radius):\n    \"\"\"Public API required by FR1: triangle_area(radius)\"\"\"\n    service = TriangleAreaService()\n    return service.triangle_area(radius)"}
{"task_id": "Mbpp/628", "solution": "def replace_spaces(input_string: str) -> str:\n    \"\"\"\n    Replaces all space characters (U+0020) in the input string with '%20'.\n    Other characters are preserved, and order is maintained.\n    \"\"\"\n    result_chars = []\n    for char in input_string:\n        if char == ' ':\n            result_chars.append('%20')\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/629", "solution": "from typing import List\n\ndef Split(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Finds even numbers from a list of integers, preserving their order.\n    The input list is not modified.\n    \"\"\"\n    return [number for number in input_list if number % 2 == 0]"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(coordinate):\n    \"\"\"\n    Extracts all 3x3 adjacent coordinates including the given coordinate.\n    The coordinates are ordered row-major (x then y).\n    \"\"\"\n    x, y = coordinate\n    adjacent_coords = []\n\n    for dx in [-1, 0, 1]:\n        for dy in [-1, 0, 1]:\n            new_x = x + dx\n            new_y = y + dy\n            adjacent_coords.append([new_x, new_y])\n\n    return adjacent_coords"}
{"task_id": "Mbpp/631", "solution": "class ConversionDirection:\n    SPACES_TO_UNDERSCORES = 'SPACES_TO_UNDERSCORES'\n    UNDERSCORES_TO_SPACES = 'UNDERSCORES_TO_SPACES'\n\nclass Error(Exception):\n    def __init__(self, type: str, message: str):\n        self.type = type\n        self.message = message\n        super().__init__(message)\n\ndef replace_spaces(input, direction=None) -> str:\n    \"\"\"\n    Replaces whitespaces with underscores or vice versa in a string.\n    Default direction is SPACES_TO_UNDERSCORES.\n    \"\"\"\n    if not isinstance(input, str):\n        raise Error(type='InvalidInputType', message='Input must be a string')\n\n    if direction is None:\n        direction = ConversionDirection.SPACES_TO_UNDERSCORES\n\n    result_chars = [] # Use a list to build the result efficiently.\n\n    if direction == ConversionDirection.SPACES_TO_UNDERSCORES:\n        for char in input:\n            if char.isspace():\n                result_chars.append('_')\n            else:\n                result_chars.append(char)\n    elif direction == ConversionDirection.UNDERSCORES_TO_SPACES:\n        for char in input:\n            if char == '_':\n                result_chars.append(' ')\n            else:\n                result_chars.append(char)\n    \n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/632", "solution": "def move_zero(inputList: list) -> list:\n    \"\"\"Return a list where non-zero elements from inputList are in the same relative order and all zeros are appended at the end.\"\"\"\n    non_zeros = []\n    zero_count = 0\n    for item in inputList:\n        if item == 0:\n            zero_count += 1\n        else:\n            non_zeros.append(item)\n    return non_zeros + [0] * zero_count"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(list_of_ints, n):\n    \"\"\"\n    Finds the sum of XOR of all pairs of numbers in the given list, considering the first n elements.\n    It considers unique unordered pairs from the selected portion of the list.\n    \"\"\"\n    m = min(n, len(list_of_ints))\n    \n    # Select the first m elements from the list.\n    selected_elements = list_of_ints[:m]\n    \n    total_xor_sum = 0\n    num_selected = len(selected_elements)\n    \n    # Iterate through all unique unordered pairs (i, j) where i < j.\n    for i in range(num_selected):\n        for j in range(i + 1, num_selected):\n            total_xor_sum += selected_elements[i] ^ selected_elements[j]\n            \n    return total_xor_sum"}
{"task_id": "Mbpp/635", "solution": "def _validate_input(input_list):\n    \"\"\"Raise TypeError if input_list is not a list or contains non-integers.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError('heap_sort expects a list of integers')\n    for item in input_list:\n        if not isinstance(item, int):\n            raise TypeError('heap_sort expects a list of integers')\n\ndef sift_down(lst, start, end):\n    \"\"\"Sift element at index start down while end is exclusive bound.\"\"\"\n    root = start\n    while True:\n        child = 2 * root + 1  # Left child\n        if child >= end:\n            break\n        # Find the larger child\n        if child + 1 < end and lst[child] < lst[child + 1]:\n            child += 1\n        # If root is smaller than largest child, swap them\n        if lst[root] < lst[child]:\n            lst[root], lst[child] = lst[child], lst[root]\n            root = child\n        else:\n            break\n\ndef build_heap(lst):\n    \"\"\"Build a max-heap in-place using sift_down.\"\"\"\n    n = len(lst)\n    # Start from the last non-leaf node and sift down\n    for i in range(n // 2 - 1, -1, -1):\n        sift_down(lst, i, n)\n\ndef heapify(lst):\n    \"\"\"Alias to build_heap(lst) to match domain naming.\"\"\"\n    build_heap(lst)\n\ndef heap_sort(input_list):\n    \"\"\"Return a new list with elements sorted in non-decreasing order using heap sort.\n    Raises TypeError if input_list is not a list of integers.\"\"\"\n    _validate_input(input_list)\n    \n    lst = list(input_list)  # Shallow copy to avoid mutating original\n    n = len(lst)\n\n    if n == 0:\n        return []\n\n    # Build a max-heap from the list\n    build_heap(lst)\n\n    # One by one extract elements from heap\n    for i in range(n - 1, 0, -1):\n        # Move current root to end\n        lst[i], lst[0] = lst[0], lst[i]\n        # Call sift_down on the reduced heap\n        sift_down(lst, 0, i)\n        \n    return lst"}
