{"task_id": "Mbpp/409", "solution": "class TuplePair:\n    \"\"\"Represents a two-element numeric tuple and computes its product.\"\"\"\n    def __init__(self, a, b):\n        self.a = a\n        self.b = b\n    def product(self):\n        return self.a * self.b\n\nclass ProductResult:\n    \"\"\"Simple data holder for a numeric result.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\nclass InputList:\n    \"\"\"Logical representation of a collection of TuplePair instances.\"\"\"\n    def __init__(self, tuples: list):\n        self.tuples = tuples\n\nclass MinProductFunction:\n    \"\"\"Core algorithm to compute products and find the smallest product.\"\"\"\n    def compute(self, inputList):\n        products = []\n        for a, b in inputList:\n            tuple_pair = TuplePair(a, b)\n            products.append(tuple_pair.product())\n        \n        if not products:\n            # As per design, inputList is assumed non-empty and valid.\n            # Returning None or raising an error would be options for empty list,\n            # but design doesn't specify. Returning float('inf') is also common.\n            # For simplicity, based on design, we assume products won't be empty.\n            return None # Or raise an error as per unspecified behavior.\n        \n        return min(products)\n\ndef min_product_tuple(input_list):\n    \"\"\"\n    Finds the minimum product from the pairs of tuples within a given list.\n    \"\"\"\n    min_func = MinProductFunction()\n    return min_func.compute(input_list)"}
{"task_id": "Mbpp/398", "solution": "def digit_sum(value: int) -> int:\n    \"\"\"\n    Computes the sum of the absolute base-10 digits of an integer.\n    \"\"\"\n    s = 0\n    abs_value = abs(value)\n    for digit_char in str(abs_value):\n        s += int(digit_char)\n    return s\n\ndef sum_of_digits(integers: list[int]) -> int:\n    \"\"\"\n    Computes the sum of digits for each number in a list and returns their aggregate sum.\n    \"\"\"\n    if not isinstance(integers, list):\n        raise TypeError(\"sum_of_digits expects a list of integers\")\n    \n    if not all(isinstance(x, int) for x in integers):\n        raise TypeError(\"sum_of_digits expects a list of integers\")\n\n    total_aggregate_sum = 0\n    for num in integers:\n        total_aggregate_sum += digit_sum(num)\n        \n    return total_aggregate_sum"}
{"task_id": "Mbpp/410", "solution": "from typing import Any, List\nimport numbers\n\ndef _is_numeric(value: Any) -> bool:\n    \"\"\"Return True if value is considered numeric by this implementation.\"\"\"\n    return isinstance(value, numbers.Real) and not isinstance(value, bool)\n\ndef min_val(input_list: List[Any]):\n    \"\"\"Return the minimum numeric value found in input_list by ignoring non-numeric elements.\"\"\"\n    numeric_values = [x for x in input_list if _is_numeric(x)]\n    return min(numeric_values)"}
