{"task_id": "Mbpp/252", "solution": "import math\n\nclass NumericInput:\n    \"\"\"Parses and holds the real and imaginary numeric components.\"\"\"\n    def __init__(self, real: float, imag: float) -> None:\n        self.real = real\n        self.imag = imag\n\n    @staticmethod\n    def from_value(value) -> 'NumericInput':\n        \"\"\"Parse a Python value (int, float, complex) into a NumericInput.\"\"\"\n        if isinstance(value, (int, float)):\n            return NumericInput(float(value), 0.0)\n        elif isinstance(value, complex):\n            return NumericInput(value.real, value.imag)\n        else:\n            # The design context implicitly assumes valid numeric input types.\n            # No isinstance() checks or exception raising required per instructions.\n            # Convert to complex and rely on its parsing for other types.\n            complex_val = complex(value)\n            return NumericInput(complex_val.real, complex_val.imag)\n\nclass PolarCoordinate:\n    \"\"\"Data holder for polar coordinates (r, theta) as floats.\"\"\"\n    def __init__(self, r: float, theta: float) -> None:\n        self.r = r\n        self.theta = theta\n\n    def to_tuple(self) -> tuple[float, float]:\n        \"\"\"Return the polar coordinates as a tuple (r, theta).\"\"\"\n        return (self.r, self.theta)\n\ndef convert(input) -> tuple[float, float]:\n    \"\"\"\n    Converts a complex number (or real number) to polar coordinates (r, theta).\n    r is the magnitude, theta is the angle in radians.\n    \"\"\"\n    ni = NumericInput.from_value(input)\n    r = math.sqrt(ni.real * ni.real + ni.imag * ni.imag)\n    theta = math.atan2(ni.imag, ni.real)\n    pc = PolarCoordinate(float(r), float(theta))\n    return pc.to_tuple()"}
{"task_id": "Mbpp/255", "solution": "import itertools\nimport collections.abc\n\nclass Element:\n    \"\"\"Wrapper for input element values.\"\"\"\n    def __init__(self, value: object) -> None:\n        self.value = value\n\nclass Combination:\n    \"\"\"Represents a produced combination and can convert to a tuple.\"\"\"\n    def __init__(self, items: tuple) -> None:\n        self.items = items\n\n    def to_tuple(self) -> tuple:\n        \"\"\"Returns the combination as a tuple.\"\"\"\n        return self.items\n\nclass ResultCollection:\n    \"\"\"Collects produced Combination instances and generates a list of tuples.\"\"\"\n    def __init__(self) -> None:\n        self.combinations = []\n\n    def append(self, combination: Combination) -> None:\n        \"\"\"Adds a Combination instance to the collection.\"\"\"\n        self.combinations.append(combination)\n\n    def to_list(self) -> list:\n        \"\"\"Returns the collected combinations as a list of tuples.\"\"\"\n        return [combination.to_tuple() for combination in self.combinations]\n\nclass CombinationGenerator:\n    \"\"\"Coordinates validation and generation of combinations.\"\"\"\n    def combinations_colors(self, elements: list, n: int) -> list:\n        \"\"\"\n        Public entrypoint: validates inputs and returns a list of tuples\n        representing combinations.\n        \"\"\"\n        self._validate_input(elements, n)\n        result_collection = ResultCollection()\n        self._generate_combinations(elements, n, result_collection)\n        return result_collection.to_list()\n\n    def _validate_input(self, elements: list, n: int) -> None:\n        \"\"\"Validates input parameters and raises appropriate exceptions.\"\"\"\n        if not isinstance(elements, (list, collections.abc.Sequence)):\n            raise TypeError(\"elements must be a sequence or list\")\n        if not isinstance(n, int):\n            raise TypeError(\"n must be an integer\")\n        if n < 0:\n            raise ValueError(\"n must be a non-negative integer\")\n\n    def _generate_combinations(self, elements: list, n: int, result_collection: ResultCollection) -> None:\n        \"\"\"\n        Generates combinations with repetition using Cartesian-product semantics\n        and populates the given ResultCollection.\n        \"\"\"\n        for combination_tuple in itertools.product(elements, repeat=n):\n            result_collection.append(Combination(combination_tuple))\n\ndef combinations_colors(elements, n):\n    \"\"\"\n    Generates all combinations (with repetition) of the elements of the list\n    and returns a list with a tuple for each combination.\n    \"\"\"\n    generator = CombinationGenerator()\n    return generator.combinations_colors(elements, n)"}
{"task_id": "Mbpp/257", "solution": "class NumericArgument:\n    \"\"\"A simple wrapper for a numeric value.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\nclass TupleResult:\n    \"\"\"Holds two floats and provides a method to convert to a tuple.\"\"\"\n    def __init__(self, first: float, second: float) -> None:\n        self.first = first\n        self.second = second\n\n    def as_tuple(self) -> tuple:\n        \"\"\"Returns the stored values as a tuple (first, second).\"\"\"\n        return (self.first, self.second)\n\nclass SwapNumbersFunction:\n    \"\"\"Encapsulates the swap operation for two numbers.\"\"\"\n    name: str = \"swap_numbers\"\n\n    def swap(self, a: float, b: float) -> TupleResult:\n        \"\"\"Takes two numbers, wraps them, and returns a TupleResult with values swapped.\"\"\"\n        arg_a = NumericArgument(a)\n        arg_b = NumericArgument(b)\n        return TupleResult(first=arg_b.value, second=arg_a.value)\n\ndef swap_numbers(a: float, b: float) -> tuple:\n    \"\"\"\n    Takes two numbers and returns a tuple with the second number\n    followed by the first number.\n    \"\"\"\n    func = SwapNumbersFunction()\n    result = func.swap(a, b)\n    return result.as_tuple()"}
{"task_id": "Mbpp/256", "solution": "from typing import List\nfrom math import isqrt\n\nclass Result:\n    def __init__(self, count: int):\n        self.count = count\n\nclass PrimeChecker:\n    def is_prime(self, x: int) -> bool:\n        if x < 2:\n            return False\n        if x == 2:\n            return True\n        if x % 2 == 0:\n            return False\n        for i in range(3, isqrt(x) + 1, 2):\n            if x % i == 0:\n                return False\n        return True\n\nclass PrimeList:\n    def __init__(self):\n        self.primes = []\n\n    def generate_primes_less_than(self, n: int, checker: PrimeChecker) -> List[int]:\n        for x in range(2, n):\n            if checker.is_prime(x):\n                self.primes.append(x)\n        return self.primes\n\nclass InputParameter:\n    def __init__(self, value):\n        self.value = value\n\n    def validate_numeric(self) -> None:\n        if not isinstance(self.value, (int, float)):\n            raise TypeError(\"Input must be a numeric type.\")\n\n    def validate_non_negative(self) -> None:\n        if self.value < 0:\n            raise ValueError(\"Input must be a non-negative number.\")\n\nclass CountPrimesFunction:\n    def count_Primes_nums(self, n) -> int:\n        param = InputParameter(n)\n        param.validate_numeric()\n        param.validate_non_negative()\n\n        if n < 2:\n            return 0\n\n        checker = PrimeChecker()\n        generator = PrimeList()\n        primes = generator.generate_primes_less_than(int(n), checker)\n        return Result(len(primes)).count\n\ndef count_Primes_nums(n) -> int:\n    orchestrator = CountPrimesFunction()\n    return orchestrator.count_Primes_nums(n)"}
{"task_id": "Mbpp/259", "solution": "```python\nclass ValidationException(Exception):\n    \"\"\"Exception raised for validation errors in input tuples.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n\nclass MaximizeElements:\n    \"\"\"Encapsulates validation and element-wise comparison logic.\"\"\"\n\n    def execute(self, input1: tuple, input2: tuple) -> tuple:\n        \"\"\"\n        Orchestrates validation and comparison; returns final result or raises ValidationException.\n        \"\"\"\n        self.validateOuterLengths(input1, input2)\n\n        if not input1 and not input2:\n            return ()\n\n        result_outer_tuple = []\n        for i in range(len(input1)):\n            inner1 = input1[i]\n            inner2 = input2[i]\n\n            if not isinstance(inner1, tuple) or not isinstance(inner2, tuple):\n                raise ValidationException(f\"Non-tuple inner element at index {i}\")\n\n            self.validateInnerLengths(inner1, inner2, i)\n            result_outer_tuple.append(self.compareAndBuild(inner1, inner2, i))\n\n        return tuple(result_outer_tuple)\n\n    def validateOuterLengths(self, input1, input2) -> None:\n        \"\"\"Raises ValidationException if outer tuple lengths differ.\"\"\"\n        if len(input1) != len(input2):\n            raise ValidationException(f\"Outer lengths differ: len(input1)={len(input1)}, len(input2)={len(input2)}\")\n\n    def validateInnerLengths(self, inner1, inner2, index: int) -> None:\n        \"\"\"Raises ValidationException if inner tuple lengths at 'index' differ.\"\"\"\n        if len(inner1) != len(inner2):\n            raise ValidationException(f\"Inner lengths differ at index {index}: len(inner1)={len(inner1)}, len(inner2)={len(inner2)}\")\n\n    def compareAndBuild(self, inner1, inner2, outer_index: int) -> tuple:\n        \"\"\"\n        Performs element-wise numeric comparisons for a pair of inner tuples,\n        returning a new inner tuple with maxima.\n        \"\"\"\n        result_inner_tuple = []\n        for j in range(len(inner1)):\n            elem1 = inner1[j]\n            elem2 = inner2[j]\n\n            if not isinstance(elem1, (int, float)) or not isinstance(elem2, (int, float)):\n                raise ValidationException(f\"Non-numeric element at index ({outer_index},{j}): elem1={elem1}, elem2={elem2}\")\n\n            result_inner_tuple.append(max(elem1, elem2))\n        return tuple(result_inner_tuple)\n\ndef maximize_elements(input1: tuple, input2: tuple) -> tuple:\n    \"\"\"\n    Computes element-wise numeric maxima between corresponding inner tuples of two outer tuples.\n    Delegates validation and processing to MaximizeElements.\n    \"\"\"\n    maximizer = MaximizeElements()\n    return maximizer.execute(input1, input2)\n```"}
{"task_id": "Mbpp/262", "solution": "def validateInputs(list_input, L):\n    \"\"\"\n    Validates input types as per design.\n    Returns True, as explicit type checks or exceptions are constrained.\n    \"\"\"\n    return True\n\ndef performSplit(list_input, L):\n    \"\"\"\n    Splits the list into two parts based on L, applying defined boundary rules.\n    If L is non-positive, the first part is empty; otherwise, standard slicing is used.\n    \"\"\"\n    if L <= 0:\n        first_part = []\n        second_part = list_input[:]\n    else:\n        first_part = list_input[:L]\n        second_part = list_input[L:]\n    return (first_part, second_part)\n\ndef split_two_parts(list_input, L):\n    \"\"\"\n    Splits a given list into two parts: the first of length L, and the remainder.\n    Returns the two resulting lists in a tuple, handling specified boundary conditions.\n    \"\"\"\n    validateInputs(list_input, L)\n    return performSplit(list_input, L)"}
{"task_id": "Mbpp/264", "solution": "def dog_age(human_years):\n    \"\"\"Calculates a dog's age in dog years based on human years.\n    The first two human years count as 10.5 dog years each, and subsequent years count as 4 dog years each.\n    \"\"\"\n    if human_years <= 2:\n        dog_years = human_years * 10.5\n    else:\n        dog_years = 2 * 10.5 + (human_years - 2) * 4\n    return dog_years"}
{"task_id": "Mbpp/261", "solution": "class TupleOperand:\n    \"\"\"Represents an input tuple operand and provides accessors.\"\"\"\n    def __init__(self, elements: tuple) -> None:\n        self._elements = elements\n        self._length = len(elements)\n\n    def get_element(self, index: int):\n        \"\"\"Returns the element at the specified index.\"\"\"\n        return self._elements[index]\n\n    def to_tuple(self) -> tuple:\n        \"\"\"Returns the internal tuple.\"\"\"\n        return self._elements\n\n    @property\n    def length(self) -> int:\n        \"\"\"Read-only property for the tuple length.\"\"\"\n        return self._length\n\nclass DivisionResult:\n    \"\"\"Holds computed result elements and provides tuple representation.\"\"\"\n    def __init__(self, elements: tuple) -> None:\n        self._elements = elements\n        self._length = len(elements)\n\n    def to_tuple(self) -> tuple:\n        \"\"\"Converts the computed elements to a tuple.\"\"\"\n        return self._elements\n\n    @property\n    def length(self) -> int:\n        \"\"\"Read-only property for the result tuple length.\"\"\"\n        return self._length\n\nclass Validator:\n    \"\"\"Provides stateless validation methods executed in deterministic order.\"\"\"\n    @staticmethod\n    def validate_is_tuple(input_obj) -> None:\n        \"\"\"Raises TypeError if input is not a tuple.\"\"\"\n        if not isinstance(input_obj, tuple):\n            raise TypeError(\"Inputs must be tuples.\")\n\n    @staticmethod\n    def validate_equal_length(a: tuple, b: tuple) -> None:\n        \"\"\"Raises ValueError if tuples a and b have different lengths.\"\"\"\n        if len(a) != len(b):\n            raise ValueError(\"Tuples must have equal length.\")\n\n    @staticmethod\n    def validate_no_zero_in_second(b: tuple) -> None:\n        \"\"\"Raises ZeroDivisionError if any element in tuple b is zero.\"\"\"\n        if any(element == 0 for element in b):\n            raise ZeroDivisionError(\"Cannot divide by zero. Second tuple contains zero elements.\")\n\nclass DivisionFunction:\n    \"\"\"Encapsulates element-wise division logic.\"\"\"\n    @staticmethod\n    def division_elements(tupleA: TupleOperand, tupleB: TupleOperand) -> DivisionResult:\n        \"\"\"Performs element-wise division of TupleOperand instances.\"\"\"\n        result_elements = []\n        for i in range(tupleA.length):\n            result_elements.append(tupleA.get_element(i) / tupleB.get_element(i))\n        return DivisionResult(tuple(result_elements))\n\ndef division_elements(tuple_a, tuple_b):\n    \"\"\"\n    Performs element-wise mathematical division operation across two tuples.\n    Validates inputs and delegates computation to domain operations.\n    \"\"\"\n    Validator.validate_is_tuple(tuple_a)\n    Validator.validate_is_tuple(tuple_b)\n    Validator.validate_equal_length(tuple_a, tuple_b)\n    Validator.validate_no_zero_in_second(tuple_b)\n\n    operand_a = TupleOperand(tuple_a)\n    operand_b = TupleOperand(tuple_b)\n\n    division_function_result = DivisionFunction.division_elements(operand_a, operand_b)\n    return division_function_result.to_tuple()"}
{"task_id": "Mbpp/267", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"Compute and return the sum of the squares of the first n odd natural numbers.\n\n    Args:\n        n (int): number of first odd natural numbers to include (n terms).\n\n    Returns:\n        int: sum_{i=1..n} (2*i - 1)**2\n    \"\"\"\n    return sum((2 * i - 1)**2 for i in range(1, n + 1))"}
{"task_id": "Mbpp/266", "solution": "def _validate_numeric(value):\n    \"\"\"Validate that value is int or float; return as float; raise TypeError otherwise.\"\"\"\n    if not isinstance(value, (int, float)):\n        raise TypeError(\"Input 'side' must be a numeric type (int or float).\")\n    return float(value)\n\nclass LateralSurfaceComputation:\n    \"\"\"Encapsulates the formula for lateral surface area and computes it.\"\"\"\n    formula = \"4 * side * side\"\n\n    def compute(self, side: float) -> float:\n        \"\"\"Compute the lateral surface area of a cube.\"\"\"\n        return 4 * side * side\n\ndef lateralsurface_cube(side):\n    \"\"\"\n    Calculates the lateral surface area of a cube given its side length.\n\n    Validates input and computes the area using the formula: 4 * side * side.\n    \"\"\"\n    validated_side = _validate_numeric(side)\n    calculator = LateralSurfaceComputation()\n    return calculator.compute(validated_side)"}
{"task_id": "Mbpp/265", "solution": "def list_split(list, n):\n    \"\"\"\n    Splits a list into n sublists, distributing elements based on their index modulo n.\n    Each sublist i contains elements at indices i, i+n, i+2n, ... from the original list.\n    \"\"\"\n    result = [[] for _ in range(n)]\n\n    for index, element in enumerate(list):\n        sublist_index = index % n\n        result[sublist_index].append(element)\n\n    return result"}
{"task_id": "Mbpp/260", "solution": "import math\n\nclass InvalidInputException(Exception):\n    \"\"\"Domain exception for invalid input errors.\"\"\"\n    pass\n\nclass InputValidator:\n    \"\"\"Validates input n is a positive integer.\"\"\"\n    def validate(self, n):\n        \"\"\"Validates that n is an integer and n > 0; raises InvalidInputException on failure.\"\"\"\n        if not isinstance(n, int):\n            raise InvalidInputException(\"Input must be an integer.\")\n        if n <= 0:\n            raise InvalidInputException(\"Input must be a positive integer.\")\n\nclass NSWSequenceGenerator:\n    \"\"\"Generates Newman-Shanks-Williams sequence values.\"\"\"\n    def compute_nth(self, n: int) -> int:\n        \"\"\"Returns nth NSW term (S_n) as an integer. S_0=1, S_1=1, S_k=2*S_{k-1}+S_{k-2}.\"\"\"\n        if n == 0:\n            return 1\n        if n == 1:\n            return 1\n        \n        # S_prev2 stores S_{k-2}, S_prev1 stores S_{k-1}\n        s_prev2 = 1 # Corresponds to S_0\n        s_prev1 = 1 # Corresponds to S_1\n        \n        # We start computing from S_2 up to S_n\n        for _ in range(2, n + 1):\n            current_s = 2 * s_prev1 + s_prev2\n            s_prev2 = s_prev1\n            s_prev1 = current_s\n        return s_prev1\n\nclass PrimeTester:\n    \"\"\"Determines primality of integer values.\"\"\"\n    def isPrime(self, x: int) -> bool:\n        \"\"\"Returns True if x is prime, False otherwise.\"\"\"\n        if x < 2:\n            return False\n        if x == 2 or x == 3:\n            return True\n        if x % 2 == 0 or x % 3 == 0:\n            return False\n        \n        # Optimized trial division for numbers > 3\n        # Checks divisors of form 6k +/- 1\n        i = 5\n        while i * i <= x:\n            if x % i == 0 or x % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\nclass NewmanPrimeService:\n    \"\"\"Orchestrates validation, NSW sequence generation, and primality testing to find nth NSW prime.\"\"\"\n    def __init__(self):\n        self._validator = InputValidator()\n        self._generator = NSWSequenceGenerator()\n        self._tester = PrimeTester()\n\n    def newman_prime(self, n: int) -> int:\n        \"\"\"\n        Finds the nth Newman-Shanks-Williams prime number by iterating the sequence from S_1.\n        This implementation strictly adheres to the detailed 'Behavior' section in the design document,\n        which for newman_prime(3) will return 17, conflicting with the 'FR-5' example (newman_prime(3) == 7).\n        \"\"\"\n        self._validator.validate(n)\n\n        found_primes_count = 0\n        # Start iteration from index 1 (S_1) as per \"Example behavior for NewmanPrimeService.newman_prime\" in design.\n        current_nsw_idx = 1 \n\n        while True:\n            nsw_value = self._generator.compute_nth(current_nsw_idx)\n            \n            if self._tester.isPrime(nsw_value):\n                found_primes_count += 1\n                if found_primes_count == n:\n                    return nsw_value\n            \n            current_nsw_idx += 1\n\n# Instantiate the service globally for reuse as per design context (module-level function)\n_newman_prime_service = NewmanPrimeService()\n\n# Public API function definition\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Write a function to find the nth newman\u2013shanks\u2013williams prime number.\n    assert newman_prime(3) == 7\n    \"\"\"\n    return _newman_prime_service.newman_prime(n)"}
{"task_id": "Mbpp/268", "solution": "def _validate_integer_like(n_raw) -> int:\n    \"\"\"Validates if n_raw is an integer and returns it, otherwise raises ValueError.\"\"\"\n    if not isinstance(n_raw, int):\n        raise ValueError(\"n must be integer >= 1\")\n    return n_raw\n\nclass InputParameter:\n    \"\"\"Encapsulates and validates the input parameter n.\"\"\"\n    def __init__(self, n_raw) -> None:\n        self.n = _validate_integer_like(n_raw)\n\n    def validate(self) -> bool:\n        \"\"\"Validates that n is greater than or equal to 1, raising ValueError if not.\"\"\"\n        if self.n < 1:\n            raise ValueError(\"n must be integer >= 1\")\n        return True\n\nclass Formula:\n    \"\"\"Computes the star number using the formula S(n) = 6 * n * (n - 1) + 1.\"\"\"\n    def compute(self, n: int) -> int:\n        return 6 * n * (n - 1) + 1\n\nclass CalculationResult:\n    \"\"\"Wraps the integer result of the computation.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = int(value)\n\nclass StarNumberFunction:\n    \"\"\"Orchestrates the validation and computation of the n'th star number.\"\"\"\n    def __init__(self) -> None:\n        self._formula = Formula()\n\n    def find_star_num(self, n: int) -> int:\n        \"\"\"Finds the n'th star number after validating the input.\"\"\"\n        input_param = InputParameter(n)\n        input_param.validate()\n        value = self._formula.compute(input_param.n)\n        return CalculationResult(value).value\n\ndef find_star_num(n: int) -> int:\n    \"\"\"Finds the n'th star number, delegating to internal components.\"\"\"\n    return StarNumberFunction().find_star_num(n)"}
{"task_id": "Mbpp/269", "solution": "from typing import Any\n\nclass InvalidInputError(Exception):\n    \"\"\"Domain-specific exception raised when input validation fails.\"\"\"\n    def __init__(self, message: str = \"Invalid input: expected a single-character string\") -> None:\n        super().__init__(message)\n\nclass CharacterInput:\n    \"\"\"Encapsulates input value and provides helper for single-character validation.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def is_single_char(self) -> bool:\n        return isinstance(self.value, str) and len(self.value) == 1\n\nclass AsciiResult:\n    \"\"\"Represents the integer ASCII result value.\"\"\"\n    def __init__(self, code: int) -> None:\n        self.code = code\n\ndef validate_character_input(value: Any) -> CharacterInput:\n    \"\"\"Validate given value meets CharacterInput single-character requirement, returning CharacterInput or raising InvalidInputError.\"\"\"\n    if isinstance(value, str) and len(value) == 1:\n        return CharacterInput(value)\n    else:\n        raise InvalidInputError()\n\ndef char_to_ascii(char: str) -> int:\n    \"\"\"Convert a validated single-character string to its ASCII integer code.\"\"\"\n    return ord(char)\n\ndef ascii_value(char: str) -> int:\n    \"\"\"Validate input and return ASCII integer code. Raises InvalidInputError for invalid inputs.\"\"\"\n    char_input = validate_character_input(char)\n    code = char_to_ascii(char_input.value)\n    result = AsciiResult(code)\n    return result.code"}
{"task_id": "Mbpp/270", "solution": "def sum_even_and_even_index(lst):\n    \"\"\"\n    Calculates the sum of even numbers found at even positions (0-based index) in a list.\n    \"\"\"\n    total_sum = 0\n    for index, value in enumerate(lst):\n        if index % 2 == 0 and value % 2 == 0:\n            total_sum += value\n    return total_sum"}
{"task_id": "Mbpp/272", "solution": "from typing import List, Any\n\ndef extractLast(t: Any) -> Any:\n    \"\"\"Returns the last element of a tuple-like object.\"\"\"\n    return t[-1]\n\ndef rear_extract(input_list: List[Any]) -> List[Any]:\n    \"\"\"\n    Extracts the rear element from each tuple in a list.\n    Returns a new list containing these extracted elements.\n    \"\"\"\n    return [extractLast(t) for t in input_list]"}
{"task_id": "Mbpp/271", "solution": "def even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the first n even natural numbers raised to the fifth power.\n    Returns 0 if n is 0.\n    \"\"\"\n    if n == 0:\n        return 0\n    \n    # Generate the first n even natural numbers\n    even_numbers = [2 * i for i in range(1, n + 1)]\n    \n    # Raise each number to the fifth power\n    powered_numbers = [x ** 5 for x in even_numbers]\n    \n    # Sum the powered numbers\n    total_sum = sum(powered_numbers)\n    \n    return total_sum"}
{"task_id": "Mbpp/273", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for validation errors in element subtraction.\n    Carries a message detailing the validation failure.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self):\n        return f\"ValidationError: {self.message}\"\n\ndef _validate_is_tuple(obj, name: str) -> None:\n    \"\"\"Validates if the given object is a tuple.\n    Raises ValidationError if the object is not a tuple.\"\"\"\n    if not isinstance(obj, tuple):\n        raise ValidationError(f\"{name} must be a tuple\")\n\ndef _validate_equal_length(a: tuple, b: tuple) -> None:\n    \"\"\"Validates if two tuples have the same length.\n    Raises ValidationError if their lengths differ.\"\"\"\n    if len(a) != len(b):\n        raise ValidationError(\"Tuples must have the same length\")\n\ndef _validate_elements_numeric(a: tuple, b: tuple) -> None:\n    \"\"\"Validates if corresponding elements in tuples are numeric (int or float).\n    Raises ValidationError if any pair of elements is not numeric.\"\"\"\n    for i in range(len(a)):\n        if not isinstance(a[i], (int, float)) or not isinstance(b[i], (int, float)):\n            raise ValidationError(f\"Elements at index {i} are not numeric or do not support subtraction\")\n\ndef substract_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Subtracts elements of the second tuple from the first tuple element-wise.\n    Performs input validation and returns a new tuple with the results.\n    \"\"\"\n    _validate_is_tuple(a, 'a')\n    _validate_is_tuple(b, 'b')\n    _validate_equal_length(a, b)\n    _validate_elements_numeric(a, b)\n\n    result_list = []\n    for i in range(len(a)):\n        result_list.append(a[i] - b[i])\n\n    return tuple(result_list)"}
{"task_id": "Mbpp/276", "solution": "import math\n\nclass InputValidator:\n    \"\"\"Validates if a value is numeric.\"\"\"\n    def isNumeric(self, value) -> bool:\n        return isinstance(value, (int, float))\n\nclass VolumeCalculator:\n    \"\"\"Calculates the volume of a cylinder.\"\"\"\n    def computeVolume(self, radius: float, height: float) -> float:\n        return math.pi * (radius ** 2) * height\n\ndef volume_cylinder(radius, height) -> float:\n    \"\"\"\n    Calculates the volume of a cylinder given its radius and height.\n    Raises TypeError if inputs are not numeric.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.isNumeric(radius) or not validator.isNumeric(height):\n        raise TypeError(\"radius and height must be numeric\")\n    \n    calculator = VolumeCalculator()\n    return calculator.computeVolume(radius, height)"}
{"task_id": "Mbpp/274", "solution": "def validate_n(n) -> None:\n    \"\"\"Raise ValueError if n is not an int or n < 1.\"\"\"\n    if not isinstance(n, int) or isinstance(n, bool):\n        raise ValueError(\"n must be an integer >= 1\")\n    if n < 1:\n        raise ValueError(\"n must be an integer >= 1\")\n\ndef _compute_sum_via_identity(n) -> int:\n    \"\"\"Return 2 ** (n-1) as Python int. Called only for n >= 1.\"\"\"\n    return 1 << (n - 1)\n\ndef even_binomial_Coeff_Sum(n) -> int:\n    \"\"\"Public API: validate n, compute the sum for even indices, and return Python int.\"\"\"\n    validate_n(n)\n    result = _compute_sum_via_identity(n)\n    return int(result)"}
{"task_id": "Mbpp/277", "solution": "def dict_filter(dictionary, n):\n    \"\"\"Filter a dictionary to include only entries whose values are >= n.\n\n    Returns a new dictionary containing only key-value pairs from 'dictionary' where value >= n.\n    \"\"\"\n    filtered_dict = {}\n    for key, value in dictionary.items():\n        if value >= n:\n            filtered_dict[key] = value\n    return filtered_dict"}
{"task_id": "Mbpp/278", "solution": "def count_first_elements(input_tuple: tuple) -> int:\n    \"\"\"\n    Counts the number of elements before the first tuple element in the given tuple.\n    Returns the index of the first tuple element, or the length of the tuple if no tuple element is found.\n    \"\"\"\n    for i, element in enumerate(input_tuple):\n        if isinstance(element, tuple):\n            return i\n    return len(input_tuple)"}
{"task_id": "Mbpp/279", "solution": "class Validation:\n    @staticmethod\n    def is_positive_integer(n) -> bool:\n        \"\"\"Checks if n is a positive integer.\"\"\"\n        return isinstance(n, int) and n > 0\n\nclass DecagonalCalculator:\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the nth decagonal number using the formula n * (4*n - 3).\"\"\"\n        return n * (4 * n - 3)\n\ndef is_num_decagonal(n) -> int:\n    \"\"\"\n    Finds the nth decagonal number after validating the input.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    if not Validation.is_positive_integer(n):\n        raise ValueError(\"n must be a positive integer\")\n    calc = DecagonalCalculator()\n    return calc.compute(n)"}
