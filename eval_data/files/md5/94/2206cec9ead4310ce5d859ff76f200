{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input: str) -> str:\n    \"\"\"Inserts spaces before words starting with capital letters, excluding the first character.\n    Preserves all other characters and their order, limited to ASCII uppercase detection.\n    \"\"\"\n    if not input:\n        return \"\"\n\n    result_chars = []\n    for i, char in enumerate(input):\n        # Insert a space before an uppercase ASCII letter if it's not the first character.\n        # Adheres to BR6: uppercase detection is ASCII A-Z only.\n        if i > 0 and 'A' <= char <= 'Z':\n            result_chars.append(' ')\n        result_chars.append(char)\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum, endnum):\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing the digit 0 are excluded.\n    \"\"\"\n    result_numbers = []\n    for num in range(startnum, endnum + 1):\n        is_candidate_valid = True\n        num_str = str(num)\n        for char_digit in num_str:\n            digit = int(char_digit)\n            if digit == 0:\n                is_candidate_valid = False\n                break\n            if num % digit != 0:\n                is_candidate_valid = False\n                break\n        if is_candidate_valid:\n            result_numbers.append(num)\n    return result_numbers"}
{"task_id": "Mbpp/750", "solution": "def validate_inputs(list_arg, tuple_arg) -> None:\n    \"\"\"Validates that the first argument is a list and the second is a tuple.\"\"\"\n    if not isinstance(list_arg, list):\n        raise TypeError(\"First argument must be list.\")\n    if not isinstance(tuple_arg, tuple):\n        raise TypeError(\"Second argument must be tuple.\")\n\ndef concatenate(list_arg, tuple_arg) -> list:\n    \"\"\"Combines a list and a tuple into a new list, preserving order.\"\"\"\n    return list_arg + list(tuple_arg)\n\ndef add_tuple(list_arg, tuple_arg) -> list:\n    \"\"\"\n    Adds the given tuple to the given list, returning a new list.\n    Raises TypeError if input types are incorrect.\n    \"\"\"\n    validate_inputs(list_arg, tuple_arg)\n    return concatenate(list_arg, tuple_arg)"}
{"task_id": "Mbpp/749", "solution": "from typing import List\n\ndef sort_numeric_strings(input_list: List[str]) -> List[int]:\n    \"\"\"\n    Converts a list of numeric strings to integers, sorts them numerically,\n    and returns a new list of sorted integers.\n    \"\"\"\n    integer_list = [int(s) for s in input_list]\n    sorted_integers = sorted(integer_list)\n    return sorted_integers"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Finds the nth Jacobsthal number.\n    Uses base cases J(0)=0, J(1)=1 and recurrence J(n)=J(n-1)+2*J(n-2).\n    \"\"\"\n    def validate_input(val):\n        \"\"\"Validates input n to be a non-negative integer.\"\"\"\n        if not isinstance(val, int):\n            raise TypeError(\"n must be an integer\")\n        if val < 0:\n            raise ValueError(\"n must be non-negative\")\n\n    class SequenceGenerator:\n        \"\"\"Computes Jacobsthal numbers iteratively.\"\"\"\n        def compute(self, val: int) -> int:\n            if val == 0:\n                return 0\n            if val == 1:\n                return 1\n            a, b = 0, 1  # Represents J(k-2) and J(k-1)\n            for _ in range(2, val + 1):\n                a, b = b, b + 2 * a\n            return b\n\n    validate_input(n)\n    generator = SequenceGenerator()\n    return generator.compute(n)"}
{"task_id": "Mbpp/751", "solution": "class TypeValidator:\n    def validate(self, array) -> None:\n        \"\"\"\n        Validates that the input is a list or tuple.\n        Raises TypeError if the input is not of the expected types.\n        \"\"\"\n        if not isinstance(array, (list, tuple)):\n            raise TypeError(\"Input 'array' must be a list or tuple.\")\n\nclass ArrayInput:\n    def __init__(self, elements):\n        \"\"\"Initializes the adapter with the input array.\"\"\"\n        self._elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the array.\"\"\"\n        return len(self._elements)\n\n    def get(self, index):\n        \"\"\"Returns the element at the specified index.\"\"\"\n        return self._elements[index]\n\nclass MinHeapChecker:\n    def check_min_heap(self, array_input_adapter: ArrayInput) -> bool:\n        \"\"\"\n        Checks if the given array (via ArrayInput adapter) represents a min-heap.\n        It uses zero-indexed binary heap rules for parent-child relationships.\n        \"\"\"\n        n = array_input_adapter.length()\n\n        if n <= 1:\n            return True\n\n        for i in range(n // 2):\n            parent_value = array_input_adapter.get(i)\n\n            left_child_idx = 2 * i + 1\n            right_child_idx = 2 * i + 2\n\n            if left_child_idx < n:\n                if parent_value > array_input_adapter.get(left_child_idx):\n                    return False\n\n            if right_child_idx < n:\n                if parent_value > array_input_adapter.get(right_child_idx):\n                    return False\n        \n        return True\n\ndef check_min_heap(array) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    Returns True if every parent value is less than or equal to its children; False otherwise.\n    \"\"\"\n    TypeValidator().validate(array)\n    \n    array_input_adapter = ArrayInput(array)\n    checker = MinHeapChecker()\n    return checker.check_min_heap(array_input_adapter)"}
{"task_id": "Mbpp/753", "solution": "def min_k(records, k):\n    \"\"\"\n    Finds the minimum k records from a list of tuples based on their second element.\n    The records are sorted by the second element in ascending order.\n    \"\"\"\n    # Sort the records by the second element (numeric value) in ascending order.\n    sorted_records = sorted(records, key=lambda x: x[1])\n\n    # Return the first k elements from the sorted list.\n    return sorted_records[:k]"}
{"task_id": "Mbpp/754", "solution": "class _InputList:\n    \"\"\"Lightweight wrapper representing an input list; provides length and element access.\"\"\"\n    def __init__(self, elements: list):\n        self._elements = elements\n        self._length = len(elements)\n\n    @property\n    def length(self) -> int:\n        return self._length\n\n    def get(self, index: int):\n        return self._elements[index]\n\nclass _ResultList:\n    \"\"\"Accumulates matched values preserving insertion order; returns final list representation.\"\"\"\n    def __init__(self):\n        self._elements = []\n\n    def append(self, value) -> None:\n        self._elements.append(value)\n\n    def to_list(self) -> list:\n        return list(self._elements) # Return a copy\n\nclass _ExtractIndexListFunction:\n    \"\"\"Orchestrates reading InputList objects, iterating indices, comparing values, and appending matches.\"\"\"\n    def __init__(self):\n        self._l1: _InputList = None\n        self._l2: _InputList = None\n        self._l3: _InputList = None\n        self._result: _ResultList = None\n\n    def extract_index_list(self, l1_raw: list, l2_raw: list, l3_raw: list) -> list:\n        self._l1 = _InputList(l1_raw)\n        self._l2 = _InputList(l2_raw)\n        self._l3 = _InputList(l3_raw)\n        self._result = _ResultList()\n\n        min_length = min(self._l1.length, self._l2.length, self._l3.length)\n\n        for i in range(min_length):\n            if self._compare_at_index(i):\n                self._result.append(self._l1.get(i)) # Append value from any of the lists\n\n        return self._result.to_list()\n\n    def _compare_at_index(self, i: int) -> bool:\n        v1 = self._l1.get(i)\n        v2 = self._l2.get(i)\n        v3 = self._l3.get(i)\n        return v1 == v2 == v3\n\ndef extract_index_list(l1: list, l2: list, l3: list) -> list:\n    \"\"\"\n    Finds elements common to three lists at the same index.\n    Returns a list of such elements, preserving their order by index.\n    \"\"\"\n    extractor = _ExtractIndexListFunction()\n    return extractor.extract_index_list(l1, l2, l3)"}
{"task_id": "Mbpp/755", "solution": "import collections.abc\n\nclass NumberList:\n    \"\"\"Encapsulates the input iterable and provides validation and extraction of distinct, sorted numeric values.\"\"\"\n    def __init__(self, numbers):\n        # Copy input iterable into internal list to avoid mutating caller's list.\n        if not isinstance(numbers, collections.abc.Iterable):\n            raise TypeError(\"input must be an iterable of numeric types\")\n        self._numbers = list(numbers)\n\n    def validate(self):\n        # Validate that all elements in the internal list are numeric.\n        for item in self._numbers:\n            if not isinstance(item, (int, float)):\n                raise TypeError(\"input must be an iterable of numeric types\")\n\n    def getDistinctSorted(self):\n        # Return a new sorted list of distinct numeric values (ascending).\n        distinct_numbers = sorted(list(set(self._numbers)))\n        return distinct_numbers\n\nclass Result:\n    \"\"\"Simple domain wrapper representing a successful computation result.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\nclass Error:\n    \"\"\"Domain error wrapper; models SRS domain class Error.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n\nclass SecondSmallestService:\n    \"\"\"Implements orchestration for computing the second smallest distinct numeric value.\"\"\"\n    def second_smallest(self, numbers):\n        number_list_instance = NumberList(numbers)\n        number_list_instance.validate()\n        \n        distinct_sorted_values = number_list_instance.getDistinctSorted()\n\n        if len(distinct_sorted_values) < 2:\n            raise ValueError('fewer than two distinct values')\n        \n        return distinct_sorted_values[1]\n\ndef second_smallest(numbers):\n    \"\"\"\n    Finds the second smallest distinct number in a list.\n    Delegates to SecondSmallestService for core logic.\n    \"\"\"\n    service = SecondSmallestService()\n    return service.second_smallest(numbers)"}
{"task_id": "Mbpp/757", "solution": "from typing import List\n\ndef _is_reverse(a: str, b: str) -> bool:\n    \"\"\"Return True if a equals the character-reverse of b (case-sensitive, exact match).\"\"\"\n    return a == b[::-1]\n\ndef count_reverse_pairs(strings: List[str]) -> int:\n    \"\"\"Return the number of unordered index pairs (i < j) where strings[i] == reverse(strings[j]).\n    The function must not mutate the input list.\n    \"\"\"\n    pair_count = 0\n    n = len(strings)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if _is_reverse(strings[i], strings[j]):\n                pair_count += 1\n    return pair_count"}
{"task_id": "Mbpp/758", "solution": "class SubList:\n    \"\"\"Represents a single sublist and provides conversion to tuple.\"\"\"\n    def __init__(self, elements: list):\n        self.elements: list = elements\n\n    def to_tuple(self) -> tuple:\n        \"\"\"Return tuple(self.elements) preserving order.\"\"\"\n        return tuple(self.elements)\n\nclass CountDictionary:\n    \"\"\"Maintains mapping from tuple keys to integer counts.\"\"\"\n    def __init__(self):\n        self.counts: dict = {}\n\n    def increment(self, key: tuple) -> None:\n        \"\"\"Increment count for key (set to 1 if absent).\"\"\"\n        self.counts[key] = self.counts.get(key, 0) + 1\n\n    def get(self, key: tuple) -> int:\n        \"\"\"Return count for key or 0 if missing.\"\"\"\n        return self.counts.get(key, 0)\n\n    def to_dict(self) -> dict:\n        \"\"\"Return underlying standard Python dict mapping tuple->int.\"\"\"\n        return self.counts\n\ndef unique_sublists(sublists: list) -> dict:\n    \"\"\"Public API: accepts a list of sublists and returns dict[tuple,int] counting occurrences.\n    Each sublist is converted to a tuple before counting.\"\"\"\n    counter = CountDictionary()\n    for sublist_elements in sublists:\n        sublist_obj = SubList(sublist_elements)\n        key = sublist_obj.to_tuple()\n        counter.increment(key)\n    return counter.to_dict()"}
{"task_id": "Mbpp/759", "solution": "import re\n\ndef is_decimal(s: str) -> bool:\n    \"\"\"\n    Checks if the given string is a decimal number with exactly two digits of precision.\n    The string must consist of one or more digits, a decimal point, and exactly two digits.\n    \"\"\"\n    pattern = r'^[0-9]+\\.[0-9]{2}$'\n    return re.match(pattern, s) is not None"}
