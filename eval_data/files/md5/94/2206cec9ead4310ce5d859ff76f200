{"task_id": "Mbpp/453", "solution": "import math\n\nclass SumCalculator:\n    \"\"\"Encapsulates factorization and summation logic.\"\"\"\n\n    def sumofFactors(self, n: int) -> int:\n        \"\"\"Compute and return the sum of even positive divisors.\"\"\"\n        num_abs = abs(n)\n        factors = self._factorize(num_abs)\n        even_factor_sum = 0\n        for factor in factors:\n            if factor % 2 == 0:\n                even_factor_sum += factor\n        return even_factor_sum\n\n    def _factorize(self, n: int) -> list:\n        \"\"\"Internal helper to enumerate positive divisors using O(sqrt(n)) algorithm.\"\"\"\n        if n == 0:\n            return []\n        factors = set()\n        for i in range(1, int(math.sqrt(n)) + 1):\n            if n % i == 0:\n                factors.add(i)\n                factors.add(n // i)\n        return sorted(list(factors))\n\ndef sumofFactors(n):\n    \"\"\"Public API: compute sum of even positive divisors of n. Raises TypeError if n is not int.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError('n must be an integer')\n    calc = SumCalculator()\n    return calc.sumofFactors(n)"}
