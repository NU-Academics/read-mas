{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"Calculates the number of positive divisors for a given integer n.\n    Handles type and value validation as per design.\"\"\"\n\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    if n == 0:\n        raise ValueError(\"Input cannot be zero.\")\n\n    m = abs(n)\n    count = 0\n    i = 1\n    while i * i <= m:\n        if m % i == 0:\n            if i * i == m:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count\n\nassert divisor(15) == 4"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n: int) -> str:\n    \"\"\"Convert non-negative integer n to binary string with no leading zeros.\n    Returns \"0\" when n == 0.\n    \"\"\"\n    if n == 0:\n        return '0'\n\n    binary_string = []\n    while n > 0:\n        binary_string.append(str(n % 2))\n        n //= 2\n    return \"\".join(reversed(binary_string))"}
{"task_id": "Mbpp/97", "solution": "from typing import Any, Dict, List\n\ndef validate_input(list_of_lists: List[List[Any]]) -> None:\n    \"\"\"Raise TypeError if input is not a list of lists or if any sublist is not a list.\"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Input must be a list of lists.\")\n    for i, sublist in enumerate(list_of_lists):\n        if not isinstance(sublist, list):\n            raise TypeError(f\"Element at index {i} is not a list. Input must be a list of lists.\")\n\ndef flatten(list_of_lists: List[List[Any]]) -> List[Any]:\n    \"\"\"Perform one-level flattening of list_of_lists into a list of elements.\"\"\"\n    flat_list = []\n    for sublist in list_of_lists:\n        for item in sublist:\n            flat_list.append(item)\n    return flat_list\n\nclass FrequencyCounter:\n    \"\"\"Maintains internal mapping of element -> count and exposes operations.\"\"\"\n    def __init__(self) -> None:\n        self._counts: Dict[Any, int] = {}\n\n    def increment(self, element: Any) -> None:\n        \"\"\"Increments the count for an element; raises TypeError if element is not hashable.\"\"\"\n        self._counts[element] = self._counts.get(element, 0) + 1\n\n    def getCount(self, element: Any) -> int:\n        \"\"\"Returns the count for a given element, or 0 if not present.\"\"\"\n        return self._counts.get(element, 0)\n\n    def as_dict(self) -> Dict[Any, int]:\n        \"\"\"Returns a shallow copy of the internal counts dictionary.\"\"\"\n        return self._counts.copy()\n\ndef frequency_lists(list_of_lists: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"Public API. Validates input, flattens one level, counts elements, returns dict.\"\"\"\n    validate_input(list_of_lists)\n    flat = flatten(list_of_lists)\n    counter = FrequencyCounter()\n    for e in flat:\n        counter.increment(e)\n    return counter.as_dict()"}
{"task_id": "Mbpp/98", "solution": "def is_numeric(value) -> bool:\n    \"\"\"Checks if a value is an instance of int or float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef compute_product(sequence) -> float:\n    \"\"\"Computes the product of all numbers in a sequence.\"\"\"\n    product = 1.0\n    for num in sequence:\n        product *= num\n    return product\n\ndef divide_by_length(product, length) -> float:\n    \"\"\"Divides a product by a given length.\"\"\"\n    return product / length\n\ndef multiply_num(sequence) -> float:\n    \"\"\"\n    Multiplies all numbers in a sequence and divides the product by the sequence's length.\n\n    Raises ValueError if the input sequence is empty.\n    Raises TypeError if any element in the sequence is not an int or float.\n    \"\"\"\n    if not sequence:\n        raise ValueError(\"empty input sequence\")\n\n    for item in sequence:\n        if not is_numeric(item):\n            raise TypeError(\"non-numeric element\")\n\n    product = compute_product(sequence)\n    length = len(sequence)\n    return divide_by_length(product, length)"}
{"task_id": "Mbpp/100", "solution": "def is_palindrome(n: int) -> bool:\n    \"\"\"Checks if an integer's decimal representation is a palindrome.\"\"\"\n    s = str(n)\n    return s == s[::-1]\n\ndef generate_next_candidate(n: int) -> int:\n    \"\"\"Deterministically returns the next integer candidate (n + 1).\"\"\"\n    return n + 1\n\ndef next_smallest_palindrome(input: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome of a specified integer, returned as an integer.\n    assert next_smallest_palindrome(99)==101\n    \"\"\"\n    current_candidate = generate_next_candidate(input)\n    while True:\n        if is_palindrome(current_candidate):\n            return current_candidate\n        current_candidate = generate_next_candidate(current_candidate)"}
