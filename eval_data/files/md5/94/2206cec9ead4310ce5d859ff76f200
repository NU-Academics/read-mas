{"task_id": "Mbpp/793", "solution": "def binarySearchRightmost(array: list[int], value: int) -> int:\n    \"\"\"\n    Finds the rightmost (last) index of an element in a sorted array using binary search.\n    Returns the index or -1 if the value is not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == value:\n            result = mid\n            low = mid + 1  # Try to find a further occurrence in the right half\n        elif array[mid] < value:\n            low = mid + 1\n        else:  # array[mid] > value\n            high = mid - 1\n    return result\n\ndef last(array: list[int], value: int) -> int:\n    \"\"\"\n    Finds the last position of an element in a sorted array.\n    Returns the rightmost index or -1 if the array is empty or the element is not found.\n    \"\"\"\n    if not array:\n        return -1\n    return binarySearchRightmost(array, value)"}
{"task_id": "Mbpp/794", "solution": "import re\n\n_PATTERN = \"a.*b$\"\n\ndef text_starta_endb(input: str) -> bool:\n    \"\"\"\n    Checks if a string has an 'a' followed by anything, ending in 'b'.\n    Uses the regex pattern 'a.*b$'.\n    \"\"\"\n    match = re.search(_PATTERN, input)\n    return bool(match is not None)"}
{"task_id": "Mbpp/796", "solution": "def _validate_input(arg):\n    \"\"\"Validates if the provided argument is a dictionary.\"\"\"\n    if not isinstance(arg, dict):\n        raise TypeError(\"Input must be a dictionary.\")\n\ndef _is_numeric(value):\n    \"\"\"Checks if a value is numeric (int or float).\"\"\"\n    return isinstance(value, (int, float))\n\ndef _accumulate(data_collection):\n    \"\"\"Accumulates numeric values from the dictionary, raising TypeError for non-numeric ones.\"\"\"\n    total_sum = 0\n    for value in data_collection.values():\n        if not _is_numeric(value):\n            raise TypeError(\"All dictionary values must be numeric (int or float).\")\n        total_sum += value\n    return total_sum\n\ndef return_sum(dict):\n    \"\"\"\n    Calculates the sum of all numeric values in the given dictionary.\n    Raises TypeError if input is not a dict or contains non-numeric values.\n    \"\"\"\n    _validate_input(dict)\n    return _accumulate(dict)"}
{"task_id": "Mbpp/797", "solution": "class InputParameters:\n    \"\"\"Represents the two input integer parameters l and r.\"\"\"\n    def __init__(self, l: int, r: int):\n        self.l = l\n        self.r = r\n\nclass Validator:\n    \"\"\"Validates input types and natural-number constraints.\"\"\"\n    def is_integer(self, value) -> bool:\n        \"\"\"Assumes value is an integer as per design constraints.\"\"\"\n        return True\n\n    def is_natural(self, n: int) -> bool:\n        \"\"\"Checks if a number is a natural number (n >= 1).\"\"\"\n        return n >= 1\n\n    def validate_range(self, l: int, r: int) -> bool:\n        \"\"\"Validates if both l and r are integers.\"\"\"\n        return self.is_integer(l) and self.is_integer(r)\n\nclass Range:\n    \"\"\"Represents an inclusive integer range [l, r].\"\"\"\n    def __init__(self, l: int, r: int):\n        self.l = l\n        self.r = r\n\n    def contains(self, n: int) -> bool:\n        \"\"\"Checks if a number is within the inclusive range [l, r].\"\"\"\n        return self.l <= n <= self.r\n\n    def to_list(self) -> list:\n        \"\"\"Returns a list of integers within the inclusive range [l, r].\"\"\"\n        return list(range(self.l, self.r + 1))\n\nclass OddNumber:\n    \"\"\"Represents a single integer and provides oddness query.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the number is odd.\"\"\"\n        return self.value % 2 == 1\n\nclass SumResult:\n    \"\"\"Container for the resulting sum.\"\"\"\n    def __init__(self, sum: int):\n        self.sum = sum\n\nclass Processor:\n    \"\"\"Filters eligible numbers and computes the sum of odd natural numbers within a Range.\"\"\"\n    def __init__(self):\n        self._validator = Validator()\n\n    def compute_sum(self, r: Range) -> int:\n        \"\"\"Computes the sum of odd natural numbers within the given Range.\"\"\"\n        current_sum = 0\n        for n in r.to_list():\n            if self._validator.is_natural(n):\n                odd_num = OddNumber(n)\n                if odd_num.is_odd():\n                    current_sum += n\n        return SumResult(current_sum).sum\n\ndef sum_in_range(l: int, r: int) -> int:\n    \"\"\"Finds the sum of all odd natural numbers within the range l and r.\"\"\"\n    validator = Validator()\n    if not validator.validate_range(l, r):\n        # As error handling is unspecified for invalid inputs, we proceed assuming valid types\n        # given the `is_integer` implementation.\n        pass\n\n    range_obj = Range(l, r)\n    processor = Processor()\n    result_sum = processor.compute_sum(range_obj)\n    \n    return result_sum"}
{"task_id": "Mbpp/798", "solution": "def _sum(list):\n    \"\"\"\n    Calculates the sum of numeric elements in a list.\n    Returns 0 for an empty list.\n    \"\"\"\n    total = 0\n    for item in list:\n        total += item\n    return total"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(number, d):\n    \"\"\"\n    Rotates the bits of a 32-bit number to the left by d positions.\n    Handles the number as an unsigned 32-bit integer.\n    \"\"\"\n    # Helper to ensure the value remains within a 32-bit unsigned range.\n    def _mask32(value):\n        return value & 0xFFFFFFFF\n\n    # Helper to normalize the rotation count to be between 0 and 31.\n    def _normalize_count(count):\n        return count % 32\n\n    # Mask the input number to ensure it's treated as a 32-bit unsigned integer.\n    masked_number = _mask32(number)\n    # Normalize the rotation amount.\n    normalized_d = _normalize_count(d)\n\n    # If the normalized rotation amount is 0, the number remains unchanged.\n    if normalized_d == 0:\n        return masked_number\n\n    # Perform the left rotation.\n    # The left part shifts bits to the left, potentially moving some bits beyond the 32-bit boundary.\n    left_part = masked_number << normalized_d\n    # The right part shifts the original number to the right by (32 - normalized_d),\n    # bringing back the bits that \"overflowed\" from the left shift.\n    right_part = masked_number >> (32 - normalized_d)\n\n    # Combine the two parts and ensure the final result is masked to 32 bits.\n    rotated_value = left_part | right_part\n    return _mask32(rotated_value)"}
{"task_id": "Mbpp/800", "solution": "WHITESPACE_CHARS = {' ', '\\t', '\\n', '\\r', '\\f', '\\v'}\n\ndef remove_all_spaces(input_string: str) -> str:\n    \"\"\"Removes all standard ASCII whitespace characters from a string.\"\"\"\n    return ''.join(char for char in input_string if char not in WHITESPACE_CHARS)"}
{"task_id": "Mbpp/801", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass InputTriplet:\n    a: int\n    b: int\n    c: int\n\n@dataclass\nclass Result:\n    equal_count: int\n\nclass EqualityCounter:\n    @staticmethod\n    def test_three_equal(a: int, b: int, c: int) -> int:\n        \"\"\"Evaluate equality and return 3, 2, or 0.\"\"\"\n        unique_numbers = len(set([a, b, c]))\n        if unique_numbers == 1:\n            return 3\n        elif unique_numbers == 2:\n            return 2\n        else: # unique_numbers == 3\n            return 0\n\ndef test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"Public API: returns the count of equal numbers (3, 2, or 0). Delegates to EqualityCounter.\"\"\"\n    return EqualityCounter.test_three_equal(a, b, c)"}
{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(n) -> bool:\n    \"\"\"Checks if a given number is a perfect square.\n    Negative numbers are not considered perfect squares.\"\"\"\n    if n < 0:\n        return False\n\n    # Calculate the square root. For a perfect square, its square root will be an integer.\n    sqrt_n = math.sqrt(n)\n    \n    # Check if the square root is equal to its integer part.\n    # This handles both integer inputs and float inputs like 4.0 correctly.\n    return sqrt_n == int(sqrt_n)"}
{"task_id": "Mbpp/804", "solution": "# Public API: is_product_even(numbers: list) -> bool\n\ndef _contains_even_integer(numbers: list) -> bool:\n    \"\"\"\n    Checks if any number in the list is an even integer.\n    This helper is used for short-circuiting per BR-6.\n    \"\"\"\n    for number in numbers:\n        if isinstance(number, int) and number % 2 == 0:\n            return True\n    return False\n\ndef is_product_even(numbers: list) -> bool:\n    \"\"\"\n    Determines if the product of numbers in a list is even.\n    Leverages BR-6 to short-circuit if an even integer is found.\n    \"\"\"\n    if _contains_even_integer(numbers):\n        return True\n    \n    # If no even integer is present, the product is even only if there are floats that result in an even product.\n    # Per BR-7, float parity semantics are unspecified. For integers, if no even integer, product is odd.\n    # The current implementation handles integers. If all integers are odd, product is odd.\n    # For a list with floats and no even integers, this simplified logic returns False,\n    # aligning with the assumption that if all integers are odd, the product is odd.\n    \n    product = 1\n    for number in numbers:\n        product *= number\n    \n    # For integer inputs, if we reach here, _contains_even_integer was False,\n    # meaning all integers are odd, thus their product is odd.\n    # If floats are involved, their parity semantics are unspecified (BR-7).\n    # This check primarily covers integer products: if the product is an integer, check its parity.\n    if isinstance(product, int):\n        return product % 2 == 0\n    else:\n        # For float results, per BR-7, behavior is unspecified.\n        # A common interpretation for \"even\" in general numbers is divisibility by 2.\n        # This will return True for 2.0, 4.0, etc., and False for 1.0, 3.0, 2.5, etc.\n        # This is a reasonable default interpretation for float parity.\n        return product % 2 == 0"}
{"task_id": "Mbpp/805", "solution": "def _validate_input(input_list: list) -> None:\n    \"\"\"Internal: verify input is list of lists of numeric items; raises TypeError or ValueError on invalid input.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n    if not input_list:\n        raise ValueError(\"Input list cannot be empty.\")\n    for sublist in input_list:\n        if not isinstance(sublist, list):\n            raise TypeError(\"All elements in the input list must be lists.\")\n        for element in sublist:\n            if not isinstance(element, (int, float)):\n                raise TypeError(\"All elements in sublists must be numbers (int or float).\")\n\ndef _sum_sublist(sublist: list) -> float:\n    \"\"\"Internal: compute numeric sum of elements in one sublist and return as float.\"\"\"\n    return float(sum(sublist))\n\ndef max_sum_list(input_list: list) -> list:\n    \"\"\"SRS-mandated function. Accepts one argument (list of lists of numbers) and returns the sublist with the highest sum as a list.\"\"\"\n    _validate_input(input_list)\n\n    max_current_sum = -float('inf')\n    max_sublist = None\n\n    for sublist in input_list:\n        current_sum = _sum_sublist(sublist)\n        if current_sum > max_current_sum:\n            max_current_sum = current_sum\n            max_sublist = sublist\n\n    return max_sublist"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"Compute the length of the longest contiguous run of uppercase characters.\n\n    Args:\n      input_string (str): input text per SRS precondition.\n\n    Returns:\n      int: length of longest contiguous run of characters for which c.isupper() is True.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n        else:\n            max_run = max(max_run, current_run)\n            current_run = 0\n    return max(max_run, current_run)"}
