{"task_id": "Mbpp/140", "solution": "```python\ndef extract_singly(list_of_iterables: list) -> set:\n    \"\"\"\n    Flattens a list of iterables into a single set of unique numerical elements.\n    It extracts only numerical elements (int or float) from the iterables.\n    \"\"\"\n    result_set = set()\n    for iterable_item in list_of_iterables:\n        # Check if the item is an iterable before processing its elements.\n        if isinstance(iterable_item, (list, tuple, set)):\n            for element in iterable_item:\n                if isinstance(element, (int, float)):\n                    result_set.add(element)\n    return result_set\n```"}
{"task_id": "Mbpp/131", "solution": "```python\ndef reverse_vowels(s: str) -> str:\n    \"\"\"Reverses only the vowels in the input string, preserving non-vowel positions.\n    Vowels are 'a', 'e', 'i', 'o', 'u' (case-insensitive); 'y' is not a vowel.\n    \"\"\"\n    char_list = list(s)\n    vowels = {'a', 'e', 'i', 'o', 'u'}\n    left, right = 0, len(char_list) - 1\n\n    while left < right:\n        # Move left pointer until a vowel is found\n        while left < right and char_list[left].lower() not in vowels:\n            left += 1\n\n        # Move right pointer until a vowel is found\n        while left < right and char_list[right].lower() not in vowels:\n            right -= 1\n\n        # If pointers haven't crossed, swap the vowels\n        if left < right:\n            char_list[left], char_list[right] = char_list[right], char_list[left]\n            left += 1\n            right -= 1\n\n    return \"\".join(char_list)\n```"}
{"task_id": "Mbpp/141", "solution": "```python\ndef _flip(arr: list, i: int) -> None:\n    \"\"\"Reverses the order of elements from index 0 up to index i (inclusive) in the given list.\"\"\"\n    start = 0\n    while start < i:\n        arr[start], arr[i] = arr[i], arr[start]\n        start += 1\n        i -= 1\n\ndef _find_max_index(arr: list, n: int) -> int:\n    \"\"\"Finds the index of the maximum element within the first n elements of the given list.\"\"\"\n    max_val = arr[0]\n    max_idx = 0\n    for i in range(1, n):\n        if arr[i] > max_val:\n            max_val = arr[i]\n            max_idx = i\n    return max_idx\n\ndef pancake_sort(input_list: list) -> list:\n    \"\"\"Sorts a list of comparable elements in ascending order using the pancake sort algorithm.\"\"\"\n    arr = list(input_list)\n    n = len(arr)\n\n    for curr_size in range(n, 1, -1):\n        max_idx = _find_max_index(arr, curr_size)\n\n        if max_idx != curr_size - 1:\n            _flip(arr, max_idx)\n            _flip(arr, curr_size - 1)\n    return arr\n```\n"}
{"task_id": "Mbpp/140", "solution": "```python\nfrom typing import List, Union, Tuple, Any, Set\n\ndef extract_singly(nested_collection: List[Union[List[Any], Tuple[Any]]]) -> Set[Union[int, float]]:\n    \"\"\"\n    Extracts unique numerical elements from a nested list or tuple structure.\n    It flattens all integers and floats into a single set, ignoring non-numerical types.\n    \"\"\"\n    unique_numbers = set()\n    for inner_collection in nested_collection:\n        for element in inner_collection:\n            if isinstance(element, (int, float)):\n                unique_numbers.add(element)\n    return unique_numbers\n```"}
