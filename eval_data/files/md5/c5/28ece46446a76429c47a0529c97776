{"task_id": "Mbpp/793", "solution": "def last(array: list, element) -> int:\n    \"\"\"\n    Finds the 0-based index of the last occurrence of an element in a sorted array.\n    Returns -1 if the element is not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == element:\n            result = mid  # Found a potential last occurrence.\n            low = mid + 1 # Search in the right half for a later occurrence.\n        elif array[mid] < element:\n            low = mid + 1\n        else: # array[mid] > element\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/793", "solution": "def last(array: list, element: any) -> int:\n    \"\"\"\n    Finds the 0-based index of the last occurrence of an element in a sorted array.\n    Returns -1 if the element is not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    last_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == element:\n            last_index = mid\n            low = mid + 1  # Search in the right half for a later occurrence\n        elif array[mid] < element:\n            low = mid + 1\n        else:  # array[mid] > element\n            high = mid - 1\n    return last_index"}
