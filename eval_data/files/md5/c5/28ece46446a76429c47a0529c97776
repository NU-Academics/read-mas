{"task_id": "Mbpp/440", "solution": "import re\nimport string\n\n# Predefined set of common adverbs for efficient lookup.\n_ADVERB_LIST = {\n    \"always\", \"usually\", \"often\", \"sometimes\", \"rarely\", \"never\",\n    \"quickly\", \"slowly\", \"carefully\", \"loudly\", \"softly\", \"easily\",\n    \"really\", \"very\", \"quite\", \"extremely\", \"hardly\", \"almost\", \"just\",\n    \"already\", \"still\", \"yet\", \"ever\", \"soon\", \"today\", \"tomorrow\",\n    \"yesterday\", \"early\", \"late\", \"here\", \"there\", \"everywhere\", \"anywhere\",\n    \"now\", \"then\", \"ago\", \"well\", \"much\", \"too\", \"enough\", \"clearly\",\n    \"bravely\", \"happily\", \"sadly\", \"finally\", \"currently\", \"eventually\",\n    \"simply\", \"completely\", \"directly\", \"mostly\", \"nearly\", \"only\",\n    \"perhaps\", \"probably\", \"actually\", \"indeed\", \"therefore\", \"however\"\n}\n\ndef _clean_word(word: str) -> str:\n    \"\"\"Removes leading and trailing punctuation from a word.\"\"\"\n    return word.strip(string.punctuation).lower()\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"\n    Finds the first adverb and its original positions in a given sentence.\n    Returns (startIndex, endIndex, adverbWord) or None if no adverb is found.\n    \"\"\"\n    # Use regex to find all sequences of non-whitespace characters along with their spans.\n    for match in re.finditer(r'\\S+', sentence):\n        original_word_start_index = match.start()\n        original_word = match.group(0)\n\n        cleaned_word = _clean_word(original_word)\n\n        if cleaned_word in _ADVERB_LIST:\n            # Calculate endIndex based on the original start index and the length of the cleaned adverb.\n            # This accounts for the actual characters of the adverb in the original string,\n            # not including any trailing punctuation that was stripped.\n            adverb_end_index = original_word_start_index + len(cleaned_word)\n            return (original_word_start_index, adverb_end_index, cleaned_word)\n\n    return None"}
{"task_id": "Mbpp/440", "solution": "```python\nimport re\nimport string\nfrom typing import Optional, Tuple\n\ndef find_adverb_position(sentence: str) -> Optional[Tuple[int, int, str]]:\n    \"\"\"\n    Identifies the first adverb in a sentence and returns its position and value.\n    Adverbs are identified by ending with 'ly' after punctuation is stripped.\n    \"\"\"\n    punctuation = string.punctuation\n\n    def _strip_punctuation_and_count(word: str) -> Tuple[str, int, int]:\n        \"\"\"Strips leading/trailing punctuation from a word and counts removed characters.\"\"\"\n        leading_punct_count = 0\n        for char in word:\n            if char in punctuation:\n                leading_punct_count += 1\n            else:\n                break\n\n        trailing_punct_count = 0\n        for char in reversed(word):\n            if char in punctuation:\n                trailing_punct_count += 1\n            else:\n                break\n\n        if leading_punct_count == len(word): # The word is entirely punctuation\n            return \"\", leading_punct_count, trailing_punct_count\n\n        stripped_word = word[leading_punct_count : len(word) - trailing_punct_count]\n        return stripped_word, leading_punct_count, trailing_punct_count\n\n    for match in re.finditer(r'\\S+', sentence):\n        token = match.group(0)\n        original_token_start_index = match.start()\n\n        clean_token, leading_punct_removed, _ = _strip_punctuation_and_count(token)\n\n        # Identify adverbs by the common '-ly' suffix after stripping punctuation.\n        # Ensure the cleaned token is long enough to avoid false positives like \"fly\".\n        if len(clean_token) > 2 and clean_token.lower().endswith('ly'):\n            adverb_start_index = original_token_start_index + leading_punct_removed\n            adverb_end_index_exclusive = adverb_start_index + len(clean_token)\n\n            return (adverb_start_index, adverb_end_index_exclusive, clean_token)\n\n    return None\n```"}
