{"task_id": "Mbpp/125", "solution": "```python\ndef find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and number of 1s\n    in any sub-string of the given binary string.\n\n    Args:\n        binary_string: The input binary string.\n\n    Returns:\n        The maximum difference between the count of 0s and 1s in any substring.\n\n    Raises:\n        TypeError: If the input is not a string.\n        ValueError: If the input string contains characters other than '0' or '1'.\n    \"\"\"\n    if not isinstance(binary_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # Validate binary string characters\n    for char in binary_string:\n        if char not in ('0', '1'):\n            raise ValueError(\"Input string must contain only '0's and '1's.\")\n\n    if not binary_string:\n        return 0\n\n    max_difference = float('-inf')\n\n    n = len(binary_string)\n    for i in range(n):\n        count_zeros = 0\n        count_ones = 0\n        for j in range(i, n):\n            if binary_string[j] == '0':\n                count_zeros += 1\n            else: # binary_string[j] == '1'\n                count_ones += 1\n\n            current_difference = count_zeros - count_ones\n            if current_difference > max_difference:\n                max_difference = current_difference\n\n    return max_difference\n\n```"}
{"task_id": "Mbpp/130", "solution": "```python\ndef max_occurrences(items: list) -> any:\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    If multiple items have the same maximum frequency, the one encountered first is returned.\n    \"\"\"\n    frequency_map = {}\n    for item in items:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n\n    max_freq = -1\n    most_frequent_item = None\n\n    for item, count in frequency_map.items():\n        if count > max_freq:\n            max_freq = count\n            most_frequent_item = item\n\n    return most_frequent_item\n```"}
{"task_id": "Mbpp/130", "solution": "```python\nimport collections\nfrom typing import Any\n\ndef max_occurrences(input_list: list) -> Any | None:\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Returns None if the input list is empty.\n    \"\"\"\n    if not input_list:\n        return None\n\n    # Use collections.Counter to efficiently count item frequencies.\n    counts = collections.Counter(input_list)\n    # most_common(1) returns a list containing a single (item, count) tuple.\n    return counts.most_common(1)[0][0]\n```"}
{"task_id": "Mbpp/129", "solution": "```python\ndef magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"Determines if a given matrix is a magic square.\n    Checks for square shape, non-empty status, and equal sums across rows, columns, and diagonals.\"\"\"\n\n    # 1. Input Validation and Size Check\n    if not matrix:\n        return False\n\n    n = len(matrix)\n    for row in matrix:\n        if len(row) != n:\n            return False\n\n    # 2. Calculate Expected Sum from the first row\n    expected_sum = sum(matrix[0])\n\n    # 3. Check Row Sums\n    for row in matrix:\n        if sum(row) != expected_sum:\n            return False\n\n    # 4. Check Column Sums\n    for col_index in range(n):\n        current_col_sum = 0\n        for row_index in range(n):\n            current_col_sum += matrix[row_index][col_index]\n        if current_col_sum != expected_sum:\n            return False\n\n    # 5. Check Main Diagonal Sums\n    # Primary Diagonal (top-left to bottom-right)\n    primary_diag_sum = 0\n    for i in range(n):\n        primary_diag_sum += matrix[i][i]\n    if primary_diag_sum != expected_sum:\n        return False\n\n    # Secondary Diagonal (top-right to bottom-left)\n    secondary_diag_sum = 0\n    for i in range(n):\n        secondary_diag_sum += matrix[i][n - 1 - i]\n    if secondary_diag_sum != expected_sum:\n        return False\n\n    # 6. Return True if all checks pass\n    return True\n```\n"}
{"task_id": "Mbpp/131", "solution": "```python\ndef _is_vowel(char: str) -> bool:\n    \"\"\"\n    Checks if a character is a vowel (a, e, i, o, u), case-insensitive.\n    'y' is not considered a vowel.\n    \"\"\"\n    return char.lower() in ('a', 'e', 'i', 'o', 'u')\n\ndef reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels within a given input string, maintaining non-vowel positions.\n    Vowels are defined as a, e, i, o, u (case-insensitive), excluding 'y'.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    char_list = list(s)\n    vowels_found = []\n    vowel_indices = []\n\n    for i, char in enumerate(char_list):\n        if _is_vowel(char):\n            vowels_found.append(char)\n            vowel_indices.append(i)\n\n    vowels_found.reverse()\n\n    for i, index in enumerate(vowel_indices):\n        char_list[index] = vowels_found[i]\n\n    return \"\".join(char_list)\n```\n"}
{"task_id": "Mbpp/129", "solution": "from typing import List\n\nclass Matrix:\n    \"\"\"\n    A helper class to encapsulate matrix operations.\n    It provides methods to check squareness and calculate various sums.\n    \"\"\"\n    def __init__(self, elements: List[List[int]]):\n        self._elements = elements\n        self._num_rows = len(elements)\n        self._num_columns = len(elements[0]) if elements and elements[0] else 0\n\n    def is_square(self) -> bool:\n        \"\"\"Checks if the matrix is square and non-empty.\"\"\"\n        # Check if the matrix is empty or if it's not a rectangle.\n        if self._num_rows == 0:\n            return False\n        if any(len(row) != self._num_columns for row in self._elements):\n            return False\n        return self._num_rows == self._num_columns\n\n    def get_num_rows(self) -> int:\n        \"\"\"Returns the number of rows in the matrix.\"\"\"\n        return self._num_rows\n\n    def get_num_columns(self) -> int:\n        \"\"\"Returns the number of columns in the matrix.\"\"\"\n        return self._num_columns\n\n    def get_row_sum(self, rowIndex: int) -> int:\n        \"\"\"Calculates the sum of a specific row.\"\"\"\n        return sum(self._elements[rowIndex])\n\n    def get_column_sum(self, colIndex: int) -> int:\n        \"\"\"Calculates the sum of a specific column.\"\"\"\n        return sum(self._elements[i][colIndex] for i in range(self._num_rows))\n\n    def get_main_diagonal_sum(self) -> int:\n        \"\"\"Calculates the sum of the main diagonal.\"\"\"\n        return sum(self._elements[i][i] for i in range(self._num_rows))\n\n    def get_anti_diagonal_sum(self) -> int:\n        \"\"\"Calculates the sum of the anti-diagonal.\"\"\"\n        return sum(self._elements[i][self._num_rows - 1 - i] for i in range(self._num_rows))\n\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"\n    Determines if a given 2D list of integers (matrix) is a magic square.\n    A magic square has equal sums for all rows, columns, and both main diagonals.\n    \"\"\"\n    matrix_obj = Matrix(matrix)\n\n    if not matrix_obj.is_square():\n        return False\n\n    n = matrix_obj.get_num_rows()\n\n    # Calculate and validate row sums\n    row_sums = [matrix_obj.get_row_sum(i) for i in range(n)]\n    if not row_sums: # Handle empty matrix or single element cases\n        return False # An empty matrix cannot be a magic square.\n\n    common_sum = row_sums[0]\n    if any(s != common_sum for s in row_sums):\n        return False\n\n    # Calculate and validate column sums\n    col_sums = [matrix_obj.get_column_sum(i) for i in range(n)]\n    if any(s != common_sum for s in col_sums):\n        return False\n\n    # Calculate and validate main diagonal sum\n    main_diag_sum = matrix_obj.get_main_diagonal_sum()\n    if main_diag_sum != common_sum:\n        return False\n\n    # Calculate and validate anti-diagonal sum\n    anti_diag_sum = matrix_obj.get_anti_diagonal_sum()\n    if anti_diag_sum != common_sum:\n        return False\n\n    return True"}
