{"task_id": "Mbpp/223", "solution": "def is_majority(sorted_array: list[int], n: int, element: int) -> bool:\n    \"\"\"\n    Determines if an element is a majority element in a sorted array.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n\n    def find_first_occurrence(arr: list[int], length: int, target: int) -> int:\n        \"\"\"Finds the index of the first occurrence of a target in a sorted array.\"\"\"\n        low, high = 0, length - 1\n        first_idx = -1\n        while low <= high:\n            mid = low + (high - low) // 2\n            if arr[mid] == target:\n                first_idx = mid\n                high = mid - 1  # Continue searching in the left half\n            elif arr[mid] < target:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return first_idx\n\n    def find_last_occurrence(arr: list[int], length: int, target: int) -> int:\n        \"\"\"Finds the index of the last occurrence of a target in a sorted array.\"\"\"\n        low, high = 0, length - 1\n        last_idx = -1\n        while low <= high:\n            mid = low + (high - low) // 2\n            if arr[mid] == target:\n                last_idx = mid\n                low = mid + 1  # Continue searching in the right half\n            elif arr[mid] < target:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return last_idx\n\n    if n == 0:\n        return False\n\n    first_index = find_first_occurrence(sorted_array, n, element)\n\n    # If the element is not found, it cannot be a majority element.\n    if first_index == -1:\n        return False\n\n    last_index = find_last_occurrence(sorted_array, n, element)\n\n    # Calculate the total count of the element in the array.\n    count = last_index - first_index + 1\n\n    # Check if the count is greater than n / 2.\n    return count > (n / 2)"}
{"task_id": "Mbpp/223", "solution": "```python\ndef find_first_occurrence(array: list[int], n: int, element: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of an element in a sorted array using binary search.\n    Returns -1 if the element is not found.\n    \"\"\"\n    low = 0\n    high = n - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == element:\n            result = mid\n            high = mid - 1\n        elif array[mid] < element:\n            low = mid + 1\n        else:  # array[mid] > element\n            high = mid - 1\n    return result\n\ndef find_last_occurrence(array: list[int], n: int, element: int) -> int:\n    \"\"\"\n    Finds the index of the last occurrence of an element in a sorted array using binary search.\n    Returns -1 if the element is not found.\n    \"\"\"\n    low = 0\n    high = n - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == element:\n            result = mid\n            low = mid + 1\n        elif array[mid] < element:\n            low = mid + 1\n        else:  # array[mid] > element\n            high = mid - 1\n    return result\n\ndef is_majority(array: list[int], n: int, element: int) -> bool:\n    \"\"\"\n    Determines if a given element is the majority element in a sorted array.\n    A majority element occurs strictly more than n/2 times.\n    \"\"\"\n    if n == 0:\n        return False\n    if n == 1:\n        return array[0] == element\n\n    first_idx = find_first_occurrence(array, n, element)\n\n    if first_idx == -1:\n        return False\n\n    last_idx = find_last_occurrence(array, n, element)\n\n    frequency = last_idx - first_idx + 1\n    majority_threshold = n / 2.0\n\n    return frequency > majority_threshold\n```"}
{"task_id": "Mbpp/224", "solution": "```python\ndef count_Set_Bits(num: int) -> int:\n    \"\"\"Counts the number of set bits (1s) in the binary representation of an integer.\n\n    Utilizes Brian Kernighan's algorithm for efficient counting.\n    \"\"\"\n    count = 0\n    while num != 0:\n        num &= (num - 1)\n        count += 1\n    return count\n```"}
{"task_id": "Mbpp/224", "solution": "```python\ndef count_Set_Bits(number: int) -> int:\n    \"\"\"\n    Counts the number of set bits (1s) in the binary representation of a number.\n    Handles both positive and negative integers by considering their absolute value.\n    \"\"\"\n    count = 0\n    # Use absolute value to handle negative numbers consistently without a fixed bit width.\n    num = abs(number)\n\n    # Brian Kernighan's algorithm to count set bits\n    while num > 0:\n        num &= (num - 1)  # Clears the least significant set bit\n        count += 1\n    return count\n```"}
