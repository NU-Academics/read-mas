{"task_id": "Mbpp/4", "solution": "```python\nimport heapq\n\ndef heap_queue_largest(numbers: list[int | float], n: int) -> list[int | float]:\n    \"\"\"\n    Finds the n largest numbers from a list, returning them in descending order.\n    It handles cases where n is negative or larger than the list size.\n    \"\"\"\n    # Use heapq.nlargest to efficiently find the n largest elements.\n    # It returns elements in descending order and handles n > len(numbers) naturally.\n    return heapq.nlargest(n, numbers)\n```"}
{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef heap_queue_largest(numbers: list[int], n: int) -> list[int]:\n    \"\"\"\n    Identifies the 'n' largest integers from a list and returns them in descending order.\n    This handles various edge cases including n=0, empty lists, and n > list length.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"'n' must be a non-negative integer\")\n    if n == 0 or not numbers:\n        return []\n\n    # Use heapq.nlargest for efficient finding of n largest elements.\n    # This returns elements in descending order by default.\n    # If len(numbers) < n, it returns all elements.\n    result = heapq.nlargest(n, numbers)\n    return result"}
{"task_id": "Mbpp/7", "solution": "PUNCTUATION_CHARS = '!\\\"#$%&\\'()*+,-./:;<=>?@[\\\\]^_`{|}~'\n\ndef _remove_punctuation(word: str) -> str:\n    \"\"\"Removes all punctuation characters from a word.\"\"\"\n    translator = str.maketrans('', '', PUNCTUATION_CHARS)\n    return word.translate(translator)\n\ndef find_char_long(input_string: str) -> set[str]:\n    \"\"\"\n    Identifies unique words of at least 4 characters, after removing punctuation.\n    Words are case-sensitive and separated by spaces.\n    \"\"\"\n    result_set = set()\n    raw_words = input_string.split(' ')\n\n    for raw_word in raw_words:\n        processed_word = _remove_punctuation(raw_word)\n        if len(processed_word) >= 4:\n            result_set.add(processed_word)\n\n    return result_set"}
