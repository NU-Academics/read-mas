{"task_id": "Mbpp/733", "solution": "```python\ndef find_first_occurrence(sortedArray: list, targetNumber: int) -> int:\n    \"\"\"Finds the index of the first occurrence of a target number in a sorted array.\"\"\"\n    if not sortedArray:\n        return -1\n\n    low = 0\n    high = len(sortedArray) - 1\n    result_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n\n        if sortedArray[mid] == targetNumber:\n            result_index = mid\n            high = mid - 1  # Search for an earlier occurrence in the left half\n        elif sortedArray[mid] > targetNumber:\n            high = mid - 1\n        else: # sortedArray[mid] < targetNumber\n            low = mid + 1\n\n    return result_index\n```"}
{"task_id": "Mbpp/732", "solution": "```python\ndef replace_specialchar(input_string: str) -> str:\n    \"\"\"Replaces spaces, commas, or dots with a colon in the given string.\n    It iterates through the input, substituting target characters with a colon.\"\"\"\n    _TARGET_CHARS = {' ', ',', '.'}\n    _REPLACEMENT_CHAR = ':'\n    result_chars = []\n    for char in input_string:\n        if char in _TARGET_CHARS:\n            result_chars.append(_REPLACEMENT_CHAR)\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)\n```"}
{"task_id": "Mbpp/733", "solution": "```python\ndef find_first_occurrence(arr: list[int | float], num: int | float) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array.\n    This function implements a modified binary search algorithm to achieve O(log N) time complexity.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    result_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2 # Prevents potential overflow for very large low/high\n        if arr[mid] == num:\n            result_index = mid\n            high = mid - 1  # Found 'num', but try to find an earlier occurrence in the left half\n        elif arr[mid] < num:\n            low = mid + 1   # 'num' must be in the right half\n        else: # arr[mid] > num\n            high = mid - 1  # 'num' must be in the left half\n    return result_index\n```"}
{"task_id": "Mbpp/734", "solution": "```python\ndef sum_Of_Subarray_Prod(numbers_list):\n    \"\"\"\n    Calculates the sum of products for all possible contiguous sublists of the input list.\n    It iterates through all sublists, computes their product, and sums them up.\n    \"\"\"\n    total_sum_of_products = 0\n\n    # Iterate through all possible starting indices\n    for start_index in range(len(numbers_list)):\n        # Iterate through all possible ending indices for the current start_index\n        for end_index in range(start_index, len(numbers_list)):\n            current_product = 1\n            # Iterate through the elements of the current sublist\n            for i in range(start_index, end_index + 1):\n                current_product *= numbers_list[i]\n            total_sum_of_products += current_product\n\n    return total_sum_of_products\n```"}
{"task_id": "Mbpp/734", "solution": "```python\ndef sum_Of_Subarray_Prod(input_list: list) -> int:\n    \"\"\"Calculates the sum of products of all possible sublists of a given list.\n    It iterates through all sublists, computes their products, and sums them up.\n    \"\"\"\n    total_sum = 0\n\n    for i in range(len(input_list)):\n        for j in range(i, len(input_list)):\n            current_product = 1\n            for k in range(i, j + 1):\n                current_product *= input_list[k]\n            total_sum += current_product\n\n    return int(total_sum)\n```"}
{"task_id": "Mbpp/735", "solution": "```python\n# src/bit_toggler.py\ndef toggle_middle_bits(number: int) -> int:\n    \"\"\"Toggles bits of a number, excluding the first (MSB) and last (LSB) bits.\n    If the number has two or fewer bits, no bits are toggled.\"\"\"\n    # Convert number to binary string, removing the '0b' prefix.\n    binary_str = bin(number)[2:]\n    n = len(binary_str)\n\n    # Business rule: if a number has two or fewer bits, no bits shall be toggled.\n    if n <= 2:\n        return number\n\n    # Build the new binary string by toggling intermediate bits.\n    # The MSB (first bit) and LSB (last bit) remain unchanged.\n    new_binary_list = list(binary_str)\n    for i in range(1, n - 1): # Iterate from the second bit to the second-to-last bit.\n        new_binary_list[i] = '1' if new_binary_list[i] == '0' else '0'\n\n    # Convert the modified binary string back to an integer.\n    return int(\"\".join(new_binary_list), 2)\n\n```\n```python\n# src/main.py\nimport argparse\nimport sys\nimport os\n\n# Add the directory containing this script to sys.path\n# This allows importing sibling modules like bit_toggler.py\nscript_dir = os.path.dirname(__file__)\nif script_dir not in sys.path:\n    sys.path.insert(0, script_dir)\n\nfrom bit_toggler import toggle_middle_bits\n\ndef main():\n    \"\"\"Handles command-line arguments, calls the bit toggling function, and displays the result.\"\"\"\n    parser = argparse.ArgumentParser(description=\"Toggle middle bits of an integer number.\")\n    parser.add_argument(\"--number\", type=int, required=True,\n                        help=\"The integer number whose middle bits (excluding MSB and LSB) are to be toggled.\")\n\n    args = parser.parse_args()\n    input_number = args.number\n\n    toggled_number = toggle_middle_bits(input_number)\n\n    print(f\"Original number: {input_number} (binary: {bin(input_number)})\")\n    print(f\"Toggled number: {toggled_number} (binary: {bin(toggled_number)})\")\n\nif __name__ == \"__main__\":\n    main()\n\n```"}
{"task_id": "Mbpp/736", "solution": "```python\ndef left_insertion(sorted_list: list, value) -> int:\n    \"\"\"\n    Locates the leftmost index to insert a value into a sorted list, maintaining ascending order.\n    It returns the list's length if the value is greater than all existing elements.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n    ans = high\n\n    while low < high:\n        mid = low + (high - low) // 2\n        if sorted_list[mid] >= value:\n            ans = mid\n            high = mid\n        else:\n            low = mid + 1\n    return ans\n```"}
