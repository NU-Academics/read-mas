{"task_id": "Mbpp/605", "solution": "```python\ndef prime_num(number: int) -> bool:\n    # Numbers less than 2 are not prime by definition.\n    if number < 2:\n        return False\n    # The number 2 is the only even prime number.\n    if number == 2:\n        return True\n    # All other even numbers are not prime.\n    if number % 2 == 0:\n        return False\n\n    # Check for odd divisors starting from 3 up to the square root of the number.\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n\n    # If no divisors were found, the number is prime.\n    return True\n```"}
{"task_id": "Mbpp/603", "solution": "```python\nimport math\n\ndef is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime. Optimizes by checking divisibility up to its square root.\"\"\"\n    if num < 2:\n        return False\n    for j in range(2, int(math.sqrt(num)) + 1):\n        if num % j == 0:\n            return False\n    return True\n\ndef get_ludic(n: int) -> list[int]:\n    \"\"\"Identifies all lucid numbers up to a given integer n. Includes 1 and all prime numbers.\"\"\"\n    lucid_numbers = []\n    if n >= 1:\n        lucid_numbers.append(1)\n    for i in range(2, n + 1):\n        if is_prime(i):\n            lucid_numbers.append(i)\n    return lucid_numbers\n```"}
{"task_id": "Mbpp/605", "solution": "```python\ndef prime_num(integer: int) -> bool:\n    \"\"\"\n    Checks if the given integer is a prime number.\n    Returns True if prime, False otherwise.\n    \"\"\"\n    if integer <= 1:\n        return False\n    if integer == 2:\n        return True\n    if integer % 2 == 0:\n        return False\n\n    # Iterate through odd divisors from 3 up to the square root of the integer.\n    limit = int(integer**0.5)\n    for divisor in range(3, limit + 1, 2):\n        if integer % divisor == 0:\n            return False\n\n    return True\n```"}
{"task_id": "Mbpp/604", "solution": "```python\ndef reverse_words(input_string: str) -> str:\n    \"\"\"\n    Reverses the order of words in an input string, handling various spacing scenarios.\n    Words are delimited by spaces, and the output uses single spaces between words.\n    \"\"\"\n    stripped_string = input_string.strip()\n    words_list = stripped_string.split()\n    reversed_words_list = words_list[::-1]\n    output_string = \" \".join(reversed_words_list)\n    return output_string\n```"}
{"task_id": "Mbpp/603", "solution": "```python\nfrom typing import List\n\ndef get_ludic(limit: int) -> List[int]:\n    \"\"\"\n    Generates an ordered list of Ludic numbers up to the specified limit.\n\n    Args:\n        limit: A positive integer representing the upper bound (N).\n\n    Returns:\n        An ordered list of integers representing the Ludic numbers.\n\n    Raises:\n        ValueError: If the limit is not a positive integer.\n    \"\"\"\n    if not isinstance(limit, int) or limit <= 0:\n        raise ValueError(\"Limit must be a positive integer.\")\n\n    if limit == 1:\n        return [1]\n\n    ludic_list = [1]\n    current_sequence = list(range(2, limit + 1))\n\n    while current_sequence:\n        l = current_sequence[0]\n        ludic_list.append(l)\n        current_sequence.pop(0)\n\n        new_sequence = []\n        skip_count = 0\n        for i, num in enumerate(current_sequence):\n            if (i + 1 - skip_count) % l == 0:\n                skip_count += 1\n            else:\n                new_sequence.append(num)\n        current_sequence = new_sequence\n\n    return ludic_list\n```\n"}
