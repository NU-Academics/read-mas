{"task_id": "Mbpp/247", "solution": "```python\ndef lps(s: str) -> int:\n    \"\"\"\n    Calculates the length of the longest palindromic subsequence in the given string.\n\n    Args:\n        s: The input string.\n\n    Returns:\n        An integer representing the length of the longest palindromic subsequence.\n    \"\"\"\n    n = len(s)\n\n    # Create a 2D DP table to store results of subproblems\n    # dp[i][j] stores the length of the LPS for substring s[i..j]\n    dp = [[0 for _ in range(n)] for _ in range(n)]\n\n    # All substrings of length 1 have LPS length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the table for lengths from 2 to n\n    for current_len in range(2, n + 1):\n        for i in range(n - current_len + 1):\n            j = i + current_len - 1\n            if s[i] == s[j] and current_len == 2:\n                dp[i][j] = 2\n            elif s[i] == s[j]:\n                dp[i][j] = 2 + dp[i + 1][j - 1]\n            else:\n                dp[i][j] = max(dp[i][j - 1], dp[i + 1][j])\n\n    return dp[0][n - 1]\n```"}
{"task_id": "Mbpp/245", "solution": "```python\ndef _calculate_lis_sums(arr):\n    \"\"\"\n    Calculates the maximum sum of an increasing subsequence ending at each position.\n    Returns a list where lis_sums[i] is the max sum ending at arr[i].\n    \"\"\"\n    n = len(arr)\n    lis_sums = list(arr)\n    for i in range(1, n):\n        for j in range(i):\n            if arr[i] > arr[j]:\n                lis_sums[i] = max(lis_sums[i], lis_sums[j] + arr[i])\n    return lis_sums\n\ndef _calculate_lds_sums(arr):\n    \"\"\"\n    Calculates the maximum sum of a decreasing subsequence starting at each position.\n    Returns a list where lds_sums[i] is the max sum starting at arr[i].\n    \"\"\"\n    n = len(arr)\n    lds_sums = list(arr)\n    for i in range(n - 2, -1, -1):\n        for j in range(n - 1, i, -1):\n            if arr[i] > arr[j]:\n                lds_sums[i] = max(lds_sums[i], lds_sums[j] + arr[i])\n    return lds_sums\n\ndef max_bitonic_sum(arr):\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence within the given array.\n    A bitonic subsequence is first strictly increasing and then strictly decreasing.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    lis_sums = _calculate_lis_sums(arr)\n    lds_sums = _calculate_lds_sums(arr)\n\n    max_sum = 0\n    for i in range(n):\n        # The current element arr[i] is the peak, counted in both LIS and LDS, so subtract it once.\n        current_bitonic_sum = lis_sums[i] + lds_sums[i] - arr[i]\n        max_sum = max(max_sum, current_bitonic_sum)\n\n    return max_sum\n```"}
{"task_id": "Mbpp/245", "solution": "```python\ndef _calculate_lis_sums(arr: list[int]) -> list[int]:\n    \"\"\"Computes max sum of increasing subsequence ending at each position. Uses dynamic programming.\"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n\n    lis_sums = list(arr)\n\n    for i in range(1, n):\n        for j in range(i):\n            if arr[i] > arr[j]:\n                lis_sums[i] = max(lis_sums[i], lis_sums[j] + arr[i])\n    return lis_sums\n\ndef _calculate_lds_sums(arr: list[int]) -> list[int]:\n    \"\"\"Computes max sum of decreasing subsequence starting at each position. Iterates right-to-left.\"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n\n    lds_sums = list(arr)\n\n    for i in range(n - 2, -1, -1):\n        for j in range(n - 1, i, -1):\n            if arr[i] > arr[j]:\n                lds_sums[i] = max(lds_sums[i], lds_sums[j] + arr[i])\n    return lds_sums\n\ndef max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence in the given array.\n    A bitonic sequence is first strictly increasing and then strictly decreasing.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    lis_sums = _calculate_lis_sums(arr)\n    lds_sums = _calculate_lds_sums(arr)\n\n    # Initialize max_bitonic_sum to handle potentially negative numbers.\n    max_bitonic_sum = -float('inf')\n\n    for i in range(n):\n        # Current element arr[i] acts as the peak of the bitonic subsequence.\n        # Its sum is (LIS ending at i) + (LDS starting at i) - (arr[i] counted twice).\n        current_bitonic_sum = lis_sums[i] + lds_sums[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n\n    return max_bitonic_sum\n```\n"}
