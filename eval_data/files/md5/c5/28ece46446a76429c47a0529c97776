{"task_id": "Mbpp/780", "solution": "```python\ndef find_combinations(tuple_list: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    \"\"\"\n    Calculates element-wise sums of all unique pairs of distinct tuples from the input list.\n    Uses nested loops to ensure all combinations are processed as specified.\n    \"\"\"\n    results_list = []\n\n    for i in range(len(tuple_list) - 1):\n        for j in range(i + 1, len(tuple_list)):\n            tuple1 = tuple_list[i]\n            tuple2 = tuple_list[j]\n            sum_tuple = (tuple1[0] + tuple2[0], tuple1[1] + tuple2[1])\n            results_list.append(sum_tuple)\n\n    return results_list\n```"}
{"task_id": "Mbpp/782", "solution": "```python\ndef odd_length_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of all elements across all contiguous subarrays\n    of the input list that have an odd length.\n\n    Args:\n        arr: A list of integers.\n\n    Returns:\n        An integer representing the total sum of all odd-length subarrays.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n    for i in range(n):\n        for j in range(i, n):\n            subarray = arr[i : j + 1]\n            if len(subarray) % 2 == 1:\n                total_sum += sum(subarray)\n    return total_sum\n```"}
{"task_id": "Mbpp/782", "solution": "```python\ndef odd_length_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of all elements across all contiguous subarrays that have an odd length.\n    It iterates through all possible subarrays, checking their length and summing elements if odd.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for start_index in range(n):\n        for end_index in range(start_index, n):\n            # Extract the current subarray\n            current_subarray = arr[start_index : end_index + 1]\n            length = len(current_subarray)\n\n            # Check if the subarray length is odd\n            if length % 2 != 0:\n                total_sum += sum(current_subarray)\n\n    return total_sum\n```"}
{"task_id": "Mbpp/781", "solution": "```python\nimport math\n\ndef _calculate_positive_divisors_count(n: int) -> int:\n    \"\"\"Calculates the total number of positive divisors for an integer n.\n    It considers the absolute value of n for the calculation.\"\"\"\n    val = abs(n)\n    if val == 0:\n        return 0\n\n    count = 0\n    i = 1\n    while i * i <= val:\n        if val % i == 0:\n            if i * i == val:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count\n\ndef _is_divisor_count_even(count: int) -> bool:\n    \"\"\"Determines if the given count is an even number.\"\"\"\n    return count % 2 == 0\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if the count of positive divisors for an integer n is even.\n    Returns True if the count is even, False otherwise.\n    \"\"\"\n    divisor_count = _calculate_positive_divisors_count(n)\n    return _is_divisor_count_even(divisor_count)\n```"}
{"task_id": "Mbpp/785", "solution": "```python\ndef tuple_str_int(input_string: str) -> tuple[int, ...]:\n    \"\"\"Converts a string representation of a tuple of integers to an actual tuple of integers.\n    It handles empty tuples and whitespace around elements.\"\"\"\n\n    # Remove leading and trailing parentheses from the input string.\n    content = input_string.strip('()')\n\n    # If the resulting content string is empty, return an empty tuple.\n    if not content:\n        return ()\n\n    # Split the content by commas and convert each element to an integer.\n    # Whitespace is stripped from each element before conversion, which naturally handles ValueError for invalid numbers.\n    integer_elements = [int(element.strip()) for element in content.split(',')]\n\n    # Convert the list of integers into a tuple and return it.\n    return tuple(integer_elements)\n```"}
{"task_id": "Mbpp/784", "solution": "```python\ndef find_first_even(numbers: list[int]) -> int | None:\n    \"\"\"Identifies the first even number in a given list.\n    Returns None if no even number is found.\n    \"\"\"\n    for num in numbers:\n        if num % 2 == 0:\n            return num\n    return None\n\ndef find_first_odd(numbers: list[int]) -> int | None:\n    \"\"\"Identifies the first odd number in a given list.\n    Returns None if no odd number is found.\n    \"\"\"\n    for num in numbers:\n        if num % 2 != 0:\n            return num\n    return None\n\ndef mul_even_odd(numbers: list[int]) -> int | None:\n    \"\"\"\n    Finds the product of the first even and first odd number in a list.\n    Returns None if the list is empty, or if either an even or an odd number is not found.\n    \"\"\"\n    if not numbers:\n        return None\n\n    first_even = find_first_even(numbers)\n    first_odd = find_first_odd(numbers)\n\n    if first_even is not None and first_odd is not None:\n        return first_even * first_odd\n    else:\n        return None\n```"}
{"task_id": "Mbpp/784", "solution": "```python\ndef mul_even_odd(numbers: list) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd numbers in a list.\n    It iterates through the list to identify the numbers and then returns their product.\n    \"\"\"\n    first_odd = None\n    first_even = None\n\n    def _is_even(number: int) -> bool:\n        \"\"\"Checks if a given number is even.\"\"\"\n        return number % 2 == 0\n\n    def _is_odd(number: int) -> bool:\n        \"\"\"Checks if a given number is odd.\"\"\"\n        return number % 2 != 0\n\n    for num in numbers:\n        if first_odd is None and _is_odd(num):\n            first_odd = num\n        if first_even is None and _is_even(num):\n            first_even = num\n\n        if first_odd is not None and first_even is not None:\n            break\n\n    return first_odd * first_even\n```"}
