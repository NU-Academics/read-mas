{"task_id": "Mbpp/419", "solution": "```python\nfrom typing import List\n\nclass Number:\n    \"\"\"Encapsulates a single floating-point value and provides rounding functionality.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n\n    def round_to_nearest_integer(self) -> int:\n        \"\"\"Rounds the encapsulated value to the nearest integer.\"\"\"\n        return round(self.value)\n\nclass NumberList:\n    \"\"\"Manages a collection of Number objects.\"\"\"\n    def __init__(self, numbers: List[float]):\n        self.numbers: List[Number] = [Number(num) for num in numbers]\n\n    def get_length(self) -> int:\n        \"\"\"Returns the count of numbers in the list.\"\"\"\n        return len(self.numbers)\n\n    def get_numbers(self) -> List[Number]:\n        \"\"\"Returns the internal list of Number objects.\"\"\"\n        return self.numbers\n\nclass Calculator:\n    \"\"\"Performs calculations on a NumberList object.\"\"\"\n    def __init__(self):\n        self.input_list: NumberList = None\n        self.rounded_numbers: List[int] = []\n        self.sum_of_rounded_numbers: int = 0\n        self.list_length: int = 0\n        self.final_product: int = 0\n\n    def _round_numbers(self):\n        \"\"\"Rounds each number in the input list to its nearest integer.\"\"\"\n        for number_obj in self.input_list.get_numbers():\n            self.rounded_numbers.append(number_obj.round_to_nearest_integer())\n\n    def _sum_numbers(self):\n        \"\"\"Calculates the sum of the rounded numbers.\"\"\"\n        self.sum_of_rounded_numbers = sum(self.rounded_numbers)\n\n    def _calculate_length(self):\n        \"\"\"Retrieves the length of the input list.\"\"\"\n        self.list_length = self.input_list.get_length()\n\n    def _multiply_sum_by_length(self):\n        \"\"\"Multiplies the sum of rounded numbers by the list's length.\"\"\"\n        self.final_product = self.sum_of_rounded_numbers * self.list_length\n\n    def process_list(self, number_list: NumberList) -> int:\n        \"\"\"Orchestrates the rounding, summing, length calculation, and final multiplication.\"\"\"\n        self.input_list = number_list\n        self._round_numbers()\n        self._sum_numbers()\n        self._calculate_length()\n        self._multiply_sum_by_length()\n        return self.final_product\n\ndef round_and_sum(numbers: List[float]) -> int:\n    \"\"\"Rounds numbers, sums them, and multiplies by the list's length.\"\"\"\n    number_list_obj = NumberList(numbers)\n    calculator_obj = Calculator()\n    return calculator_obj.process_list(number_list_obj)\n```\n"}
