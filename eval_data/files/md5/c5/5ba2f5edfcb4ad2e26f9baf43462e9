\"\"\"\n        for x in arr:\n            if not (-1000 <= x <= 1000):\n                raise ValueError(\"Array elements must be between -1000 and 1000.\")\n\n    def validate_k_value(self, arr: List[int], k: int):\n        \"\"\"Checks if k is within the allowed range [0, len(arr)].\"\"\"\n        if not (0 <= k <= len(arr)):\n            raise ValueError(\"k must be between 0 and the length of the array.\")\nclass KNumbersFinder:\n    \"\"\"Finds and sorts the k largest numbers from an array.\"\"\"\n\n    def find_and_sort_k_largest(self, arr: List[int], k: int) -> List[int]:\n        \"\"\"Identifies the k largest numbers and returns them sorted ascendingly.\"\"\"\n        if k == 0:\n            return []\n\n        # Sort the array in ascending order.\n        # The k largest numbers will then be the last k elements.\n        arr.sort()\n        return arr[len(arr) - k:]\ndef maximum(arr: List[int], k: int) -> List[int]:\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    validator = InputValidator()\n    finder = KNumbersFinder()\n\n    validator.validate_arr_length(arr)\n    validator.validate_arr_elements(arr)\n    validator.validate_k_value(arr, k)\n\n    return finder.find_and_sort_k_largest(arr, k)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/123": [{"task_id": "HumanEval/123", "solution": "def _generate_collatz_sequence(start_n: int) -> list[int]:\n    \"\"\"Generates the Collatz sequence for a given positive integer.\n    The sequence follows the rules: n/2 for even, 3n+1 for odd, until 1 is reached.\n    \"\"\"\n    sequence = [start_n]\n    current = start_n\n    while current != 1:\n        if current % 2 == 0:\n            current = current // 2\n        else:\n            current = 3 * current + 1\n        sequence.append(current)\n    return sequence\ndef _filter_and_collect_odd_numbers(sequence: list[int]) -> list[int]:\n    \"\"\"Filters a sequence to collect all odd numbers.\n    It returns a new list containing only the odd numbers from the input sequence.\n    \"\"\"\n    return [num for num in sequence if num % 2 != 0]\ndef _sort_numbers_ascending(numbers: list[int]) -> list[int]:\n    \"\"\"Sorts a list of numbers in increasing order.\n    This helper function ensures the final output list is correctly ordered.\n    \"\"\"\n    return sorted(numbers)\ndef get_odd_collatz(n: int) -> list[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    This function orchestrates generating the sequence, filtering odd numbers, and sorting them.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    sequence = _generate_collatz_sequence(n)\n    odd_numbers = _filter_and_collect_odd_numbers(sequence)\n    sorted_odd_numbers = _sort_numbers_ascending(odd_numbers)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[14]], "plus_fail_tests": [[2]]}, {"task_id": "HumanEval/123", "solution": "from typing import List, Optional\ndef _is_positive(n: int) -> bool:\n    \"\"\"Checks if an integer is positive.\"\"\"\n    return n > 0\ndef _is_even(n: int) -> bool:\n    \"\"\"Checks if an integer is even.\"\"\"\n    return n % 2 == 0\ndef _is_odd(n: int) -> bool:\n    \"\"\"Checks if an integer is odd.\"\"\"\n    return n % 2 != 0\nclass CollatzSequence:\n    \"\"\"Generates the Collatz sequence from an initial value.\"\"\"\n    def __init__(self, initial_value: int):\n        \"\"\"Initializes the sequence with the starting number.\"\"\"\n        self._initial_value = initial_value\n        self._terms: List[int] = [initial_value]\n\n    def generate_sequence(self) -> None:\n        \"\"\"Generates the Collatz sequence until it reaches 1.\"\"\"\n        current_term = self._initial_value\n        while current_term != 1:\n            if _is_even(current_term):\n                current_term //= 2\n            else:\n                current_term = (3 * current_term) + 1\n            self._terms.append(current_term)\n\n    def get_terms(self) -> List[int]:\n        \"\"\"Returns the complete generated Collatz sequence.\"\"\"\n        return self._terms\n\n    def get_odd_numbers(self) -> List[int]:\n        \"\"\"Extracts and returns all odd numbers from the generated sequence.\"\"\"\n        return [term for term in self._terms if _is_odd(term)]\nclass OddNumberList:\n    \"\"\"Manages a collection of odd numbers, including adding and sorting them.\"\"\"\n    def __init__(self, numbers: Optional[List[int]] = None):\n        \"\"\"Initializes the list, optionally with an initial set of numbers.\"\"\"\n        self._numbers: List[int] = numbers if numbers is not None else []\n\n    def add_number(self, number: int) -> None:\n        \"\"\"Adds a single number to the list.\"\"\"\n        self._numbers.append(number)\n\n    def sort(self) -> None:\n        \"\"\"Sorts the internal list of numbers in increasing order.\"\"\"\n        self._numbers.sort()\n\n    def get_numbers(self) -> List[int]:\n        \"\"\"Returns the current list of odd numbers.\"\"\"\n        return self._numbers\ndef get_odd_collatz(n: int) -> List[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    This function orchestrates sequence generation, odd number extraction, and sorting.\n    \"\"\"\n    _is_positive(n) # Called as per design's sequence diagram.\n\n    if n == 1:\n        return [1]\n\n    collatz_sequence_generator = CollatzSequence(n)\n    collatz_sequence_generator.generate_sequence()\n\n    odd_numbers_from_sequence = collatz_sequence_generator.get_odd_numbers()\n\n    odd_number_list_manager = OddNumberList(odd_numbers_from_sequence)\n    odd_number_list_manager.sort()\n\n    return odd_number_list_manager.get_numbers()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/124": [{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n\n    for example:\n    valid_date('03-11-2000') => True\n\n    valid_date('15-01-2012') => False\n\n    valid_date('04-0-2040') => False\n\n    valid_date('06-04-2020') => True\n\n    valid_date('06/04/2020') => False\n    \"\"\"\n    import re\n\n    class DateString:\n        \"\"\"Encapsulates date components (month, day, year) and validates their ranges.\n        It provides methods to check the validity of the month and day parts.\n        \"\"\"\n        def __init__(self, month: int, day: int, year: int):\n            self.month = month\n            self.day = day\n            self.year = year # The year component is stored but not used for validation in this system.\n\n        def _is_month_valid(self) -> bool:\n            \"\"\"Checks if the month is between 1 and 12, inclusive.\"\"\"\n            return 1 <= self.month <= 12\n\n        def _is_day_valid(self) -> bool:\n            \"\"\"Checks if the day is valid for the given month, handling month-specific day limits.\"\"\"\n            days_31_months = {1, 3, 5, 7, 8, 10, 12}\n            days_30_months = {4, 6, 9, 11}\n\n            if self.month in days_31_months:\n                return 1 <= self.day <= 31\n            elif self.month in days_30_months:\n                return 1 <= self.day <= 30\n            elif self.month == 2:\n                return 1 <= self.day <= 29\n            return False\n\n        def is_valid(self) -> bool:\n            \"\"\"Determines if the encapsulated date is valid based on month and day ranges.\"\"\"\n            if not self._is_month_valid():\n                return False\n            if not self._is_day_valid():\n                return False\n            return True\n\n    if not date:\n        return False\n\n    # Regex for 'mm-dd-yyyy' format. This strictly checks for 2-digit month/day/4-digit year.\n    match = re.fullmatch(r\"(\\d{2})-(\\d{2})-(\\d{4})\", date)\n    if not match:\n        return False\n\n    # int() conversion is safe here as regex already ensured digit strings.\n    month = int(match.group(1))\n    day = int(match.group(2))\n    year = int(match.group(3))\n\n    date_obj = DateString(month, day, year)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["03-11-2000"]], "plus_fail_tests": [["12-31-1999"]]}, {"task_id": "HumanEval/124", "solution": "def valid_date(date: str) -> bool:\n    \"\"\"Validates a date string in 'mm-dd-yyyy' format against specific rules.\n    Returns True if valid, False otherwise.\"\"\"\n\n    # 1. Empty String Check (FR1)\n    if not date:\n        return False\n\n    # 2. Format Check 'mm-dd-yyyy' (FR6)\n    parts = date.split('-')\n    if len(parts) != 3:\n        return False\n\n    try:\n        month_str, day_str, year_str = parts\n        # Ensure parts have correct length as per format 'mm-dd-yyyy'\n        if not (len(month_str) == 2 and len(day_str) == 2 and len(year_str) == 4):\n            return False\n\n        month = int(month_str)\n        day = int(day_str)\n        _ = int(year_str) # Year value is not used for validation, but must be parsable\n    except ValueError:\n        # Parsing failed if any part is not a valid integer\n        return False\n\n    # 3. Month Range Check (FR5)\n    if not (1 <= month <= 12):\n        return False\n\n    # 4. Day Range Check based on month (FR2, FR3, FR4)\n    # Months with 31 days\n    if month in {1, 3, 5, 7, 8, 10, 12}:\n        if not (1 <= day <= 31):\n            return False\n    # Months with 30 days\n    elif month in {4, 6, 9, 11}:\n        if not (1 <= day <= 30):\n            return False\n    # February (max 29 days as per requirement, ignoring leap year complexity)\n    elif month == 2:\n        if not (1 <= day <= 29):\n            return False\n    # This 'else' should logically not be reached if month range check passed.\n    else:\n        return False\n\n    # 5. All checks passed (FR7)\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "from typing import List, Union\ndef _contains_whitespace(text: str) -> bool:\n    \"\"\"Checks if the given text contains any whitespace characters.\"\"\"\n    return any(char.isspace() for char in text)\ndef _contains_comma(text: str) -> bool:\n    \"\"\"Checks if the given text contains a comma character.\"\"\"\n    return ',' in text\ndef _split_by_whitespace(text: str) -> List[str]:\n    \"\"\"Splits the text into a list of words based on whitespace.\"\"\"\n    return text.split()\ndef _split_by_comma(text: str) -> List[str]:\n    \"\"\"Splits the text into a list of words based on commas.\"\"\"\n    return text.split(',')\ndef _get_alphabetical_order(char: str) -> int:\n    \"\"\"Calculates the alphabetical order of a lowercase character ('a'=0, 'b'=1, etc.).\"\"\"\n    return ord(char) - ord('a')\ndef _is_odd_ordered(order: int) -> bool:\n    \"\"\"Checks if a given alphabetical order is an odd number.\"\"\"\n    return order % 2 != 0\ndef _count_odd_ordered_lowercase_letters(text: str) -> int:\n    \"\"\"Counts lowercase letters in the text that have an odd alphabetical order.\"\"\"\n    count = 0\n    for char in text:\n        if 'a' <= char <= 'z': # Ensure