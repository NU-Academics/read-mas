d digits in a given positive integer n.\"\"\"\n        integer_input = IntegerInput(n)\n        all_digits = integer_input.get_digits()\n\n        odd_digits_values = [digit.value for digit in all_digits if digit.is_odd()]\n\n        if not odd_digits_values:\n            return 0\n\n        product = 1\n        for value in odd_digits_values:\n            product *= value\n\n        return product\ndef digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    calculator = OddDigitsProductCalculator()\n    return calculator.calculate_odd_digits_product(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/132": [{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if a string of square brackets contains at least one nested bracket subsequence.\n    Nesting is determined by a maximum depth greater than 1.\n    \"\"\"\n    current_depth = 0\n    max_depth = 0\n    for char in string:\n        if char == '[':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ']':\n            current_depth -= 1\n    return max_depth > 1", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["[[]"]], "plus_fail_tests": [["[[][]["]]}, {"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if the input string contains the subsequence '[[' followed by ']]'.\n    The function returns True if the pattern '[[]]' is found, False otherwise.\n    \"\"\"\n    state = 0  # 0: initial, 1: found first '[', 2: found second '[', 3: found first ']'\n\n    for char in string:\n        if state == 0:\n            if char == '[':\n                state = 1\n        elif state == 1:\n            if char == '[':\n                state = 2\n       