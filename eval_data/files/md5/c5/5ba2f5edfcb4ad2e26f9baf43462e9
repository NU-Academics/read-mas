ail_tests": []}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    class SideLength:\n        def __init__(self, value: float):\n            self._value = value\n\n        def get_value(self) -> float:\n            return self._value\n\n    class Triangle:\n        # Epsilon for robust floating-point comparisons.\n        _EPSILON = 1e-9\n\n        def __init__(self, side_a: SideLength, side_b: SideLength, side_c: SideLength):\n            self._side_a = side_a\n            self._side_b = side_b\n            self._side_c = side_c\n\n        def is_right_angled(self) -> bool:\n            s1 = self._side_a.get_value()\n            s2 = self._side_b.get_value()\n            s3 = self._side_c.get_value()\n\n            # Sort sides to identify potential legs and hypotenuse.\n            sides = sorted([s1, s2, s3])\n\n            # Check Pythagorean theorem (a^2 + b^2 == c^2).\n            return abs(sides[0]**2 + sides[1]**2 - sides[2]**2) < self._EPSILON\n\n    side_len_a = SideLength(a)\n    side_len_b = SideLength(b)\n    side_len_c = SideLength(c)\n\n    triangle = Triangle(side_len_a, side_len_b, side_len_c)\n    return triangle.is_right_angled()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a: float, b: float, c: float) -> bool:\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle