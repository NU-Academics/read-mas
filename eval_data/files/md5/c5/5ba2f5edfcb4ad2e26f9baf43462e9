rn 0\n\n    sum_aggregator = SumOfSquares()\n\n    for item in lst:\n        element = NumberElement(item)\n        if element.is_integer():\n            if not element.is_negative():\n                if element.is_odd():\n                    squared_value = element.square()\n                    sum_aggregator.add_square(squared_value)\n\n    return sum_aggregator.get_total()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/151", "solution": "def double_the_difference(lst: list) -> int:\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \"\"\"\n    # Initialize a variable to store the sum of squares.\n    total_sum = 0\n\n    # Iterate through each number in the input list.\n    for num in lst:\n        # Check if the number is an integer, positive, and odd.\n        if isinstance(num, int) and num > 0 and num % 2 != 0:\n            # If all conditions are true, square the number and add it to the sum.\n            total_sum += num * num\n\n    # Return the total sum.\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/152": [{"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"Compares actual game scores against player guesses.\n    Returns an array of absolute differences, where 0 indicates a correct guess.\"\"\"\n\n    differences = []\n    for i in range(len(game)):\n        diff = abs(game[i] - guess[i])\n        differences.append(diff)\n    return differences", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/152", "solution": "from match_comparison import compare", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "def _calculate_strength(extension_name: str) -> int:\n    \"\"\"Calculates the strength of an extension name.\n    Strength is defined as uppercase count minus lowercase count.\"\"\"\n    uppercase_count = 0\n    lowercase_count = 0\n    for char in extension_name:\n        if char.isupper():\n            uppercase_count += 1\n        elif char.islower():\n            lowercase_count += 1\n    return uppercase_count - lowercase_count\ndef Strongest_Extension(class_name: str, extensions: list[str]) -> str:\n    \"\"\"Identifies the strongest extension based on character counts and returns a formatted string.\n    Ties are broken by selecting the extension that appears first in the input list.\"\"\"\n    max_strength = float('-inf')\n    strongest_extension_name = \"\"\n\n    for extension in extensions:\n        current_strength = _calculate_strength(extension)\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension\n\n    return f\"{class_name}.{strongest_extension_name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/153", "solution": "class Extension:\n    \"\"\"Represents an extension and calculates its strength based on character case.\"\"\"\n\n    def __init__(self, name):\n        self.name = name\n        self._uppercase_count = 0\n        self._lowercase_count = 0\n        self._calculate_counts()\n        self.strength = self._uppercase_count - self._lowercase_count\n\n    def _calculate_counts(self):\n        \"\"\"Calculates the number of uppercase and lowercase letters in the extension name.\"\"\"\n        for char in self.name:\n            if 'A' <= char <= 'Z': # Equivalent to char.isupper()\n                self._uppercase_count += 1\n            elif 'a' <= char <= 'z': # Equivalent to char.islower()\n                self._lowercase_count += 1\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension from a list based on CAP - SM strength calculation.\n    If multiple extensions have the same strength, the first one in the list is chosen.\n    \"\"\"\n    strongest_ext_obj = None\n    max_strength = -float('inf')\n\n    for ext_name in extensions:\n        current_ext_obj = Extension(ext_name)\n\n        if current_ext_obj.strength > max_strength:\n            max_strength = current_ext_obj.strength\n            strongest_ext_obj = current_ext_obj\n        # Tie-breaking: first encountered extension is kept by comparing with strict greater than.\n\n    return f\"{class_name}.{strongest_ext_obj.name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "def _generate_rotations(s):\n    \"\"\"Generates all unique cyclic rotations of a string.\n    Returns a set containing these rotations.\"\"\"\n    rotations = set()\n    n = len(s)\n    for i in range(n):\n        rotated_s = s[i:] + s[:i]\n        rotations.add(rotated_s)\n    return rotations\ndef cycpattern_check(a, b):\n    \"\"\"Checks if the second word or any of its cyclic rotations is a substring in the first word.\n    Returns True if a match is found, False otherwise.\"\"\"\n\n    # Handle empty string 'b' case where it's considered a substring of any 'a'\n    # or if 'b' is empty, its only rotation is empty, and \"\" is a substring of \"a\"\n    if not b:\n        return True # As per typical substring behavior where \"\" is a substring of any string.\n\n    # Handle the case where 'a' is empty but 'b' is not. No non-empty rotation can be a substring.\n    if not a:\n        return False\n\n    rotations_b = _generate_rotations(b)\n\n    for rotation in rotations_b:\n        if rotation in a:  # Python's 'in' operator is a simple way to check for substrings\n            return True\n\n    return False", "base_status": "pass", "plus_status": "pass",