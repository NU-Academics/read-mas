   for digit_char in str_num:\n            total_sum += int(digit_char)\n    return total_sum\ndef count_nums(arr: List[int]) -> int:\n    \"\"\"Counts numbers in an array where the sum of digits (with special negative rule) is > 0.\n    Handles an empty input array by returning 0.\n    \"\"\"\n    if not arr:\n        return 0\n\n    count = 0\n    for number in arr:\n        sum_of_digits = _calculate_signed_digit_sum(number)\n        if sum_of_digits > 0:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/109": [{"task_id": "HumanEval/109", "solution": "def _is_sorted_non_decreasingly(arr: list[int]) -> bool:\n    \"\"\"Checks if an array is sorted in non-decreasing order.\"\"\"\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            return False\n    return True\ndef _perform_right_shift(arr: list[int]) -> list[int]:\n    \"\"\"Performs a single right shift operation on the array.\"\"\"\n    if not arr:\n        return []\n    last_element = arr[-1]\n    return [last_element] + arr[:-1]\ndef move_one_ball(arr: list[int]) -> bool:\n    \"\"\"Determines if an array can be sorted into non-decreasing order by right shift operations.\"\"\"\n    if not arr:\n        return True\n\n    n = len(arr)\n    current_arr = list(arr) # Use a mutable copy for shifting\n\n    for _ in range(n):\n        if _is_sorted_non_decreasingly(current_arr):\n            return True\n        current_arr = _perform_right_shift(current_arr)\n\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/109", "solution": "def _is_sorted_non_decreasing(arr: list[int]) -> bool:\n    \"\"\"\n    Checks if the given array is sorted in non-decreasing order.\n    Assumes unique elements.\n    \"\"\"\n    if not arr or len(arr) == 1:\n        return True\n    for i in range(len(arr) - 1):\n        if arr[i] > arr[i+1]:\n            return False\n    return True\ndef _perform_right_shift(arr: list[int]) -> list[int]:\n    \"\"\"\n    Performs a single right shift operation on the array.\n    The last element moves to the 0th index.\n    \"\"\"\n    if not arr:\n        return []\n    return [arr[-1]] + arr[:-1]\ndef move_one_ball(arr):\n    \"\"\"\n    Determines if an array can be sorted in non-decreasing order\n    by performing right shift operations. Returns True if sorted, False otherwise.\n    \"\"\"\n    if not arr:\n        return True\n\n    n = len(arr)\n    current_arr = list(arr)\n\n    for _ in range(n):\n        if _is_sorted_non_decreasing(current_arr):\n            return True\n        current_arr = _perform_right_shift(current_arr)\n\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/110": [{"task_id": "HumanEval/110", "solution": "class Number:\n    \"\"\"Encapsulates an integer value and provides parity checking.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def is_even(self) -> bool:\n        \"\"\"Checks if the number is even.\"\"\"\n        return self._value % 2 == 0\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the number is odd.\"\"\"\n        return self._value % 2 != 0\nclass NumberList:\n    \"\"\"Manages a collection of Number objects and provides list-specific analytical methods.\"\"\"\n    def __init__(self, numbers: list[int]):\n        self._numbers = [Number(num) for num in numbers]\n\n    def is_non_empty(self) -> bool:\n        \"\"\"Checks if the list is non-empty.\"\"\"\n        return bool(self._numbers)\n\n    def count_odd_elements(self) -> int:\n        \"\"\"Counts the number of odd elements in the list.\"\"\"\n        return sum(1 for num in self._numbers if num.is_odd())\n\n    def count_even_elements(self) -> int:\n        \"\"\"Counts the number of even elements in the list.\"\"\"\n        return sum(1 for num in self._numbers if num.is_even())\nclass ExchangeEvaluator:\n    \"\"\"Implements the core business logic to determine if lst1 can be made all even.\"\"\"\n    def evaluate(self, lst1: NumberList, lst2: NumberList) -> str:\n        \"\"\"Determines if lst1 can be made all even by exchanging elements with lst2.\n        It compares the count of odd numbers in lst1 with even numbers in lst2.\"\"\"\n        odds_in_lst1 = lst1.count_odd_elements()\n        evens_in_lst2 = lst2.count_even_elements()\n\n        if odds_in_lst1 <= evens_in_lst2:\n            return \"YES\"\n        else:\n            return \"NO\"\ndef exchange(lst1: list[int], lst2: list[int]) -> str:\n    \"\"\"Determines if lst1 can be made all even by exchanging elements with lst2.\n    It orchestrates the evaluation process using domain objects and services.\"\"\"\n    number_list1 = NumberList(lst1)\n    number_list2 = NumberList(lst2)\n\n    evaluator = ExchangeEvaluator()\n    result = evaluator.evaluate(number_list1, number_list2)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/110", "solution": "from typing import List\ndef is_even(number: int) -> bool:\n    \"\"\"Checks if a given number is even.\"\"\"\n    return number % 2 == 0\ndef exchange(lst1: List[int], lst2: List[int]) -> str:\n    \"\"\"Determines if it's possible to make `lst1` all even by exchanging elements with `lst2`. Returns 'YES' if possible, 'NO' otherwise.\"\"\"\n    odds_in_lst1 = 0\n    evens_in_lst2 = 0\n\n    for number in lst1:\n        if not is_even(number):\n            odds_in_lst1 += 1\n\n    for number in lst2:\n        if is_even(number):\n            evens_in_lst2 += 1\n\n    if odds_in_lst1 <= evens_in_lst2:\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/111": [{"task_id": "HumanEval/111", "solution": "def histogram(test):\n    \"\"\"Counts lowercase letter occurrences and returns a dictionary of letters with the highest frequency and their counts. If multiple letters share the highest count, all are included.\"\"\"\n    if not test:\n        return {}\n\n    # Parse letters, filtering out empty strings from multiple spaces\n    letters = [char for char in test.split(' ') if char and char.islower()]\n\n    if not letters:\n        return {}\n\n    # Count occurrences of each letter\n    letter_counts = {}\n    for letter in letters:\n        letter_counts[letter] = letter_counts.get(letter, 0) + 1\n\n    # Find the highest occurrence count\n    max_count = max(letter_counts.values())\n\n    # Collect all letters that have the highest occurrence count\n    result = {}\n    for letter, count in letter_counts.items():\n        if count == max_count:\n            result[letter] = count\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/111", "solution": "def _parse_input(input_str: str) -> list[str]:\n    \"\"\"Splits the input string into a list of individual lowercase letters, handling multiple spaces.\"\"\"\n    return [char for char in input_str.split(' ') if char]\ndef _count_frequencies(letters: list[str]) -> dict[str, int]:\n    \"\"\"Calculates the frequency of each unique letter in the provided list.\"\"\"\n    frequencies = {}\n    for letter in letters:\n        frequencies[letter] = frequencies.get(letter, 0) + 1\n    return frequencies\ndef _determine_highest_frequency(frequencies: dict[str, int]) -> int:\n    \"\"\"Finds the maximum frequency count from a dictionary of letter frequencies.\"\"\"\n    if not frequencies:\n        return 0\n    return max(frequencies.values())\ndef _filter_by_highest_frequency(frequencies: dict[str, int], highest_freq: int) -> dict[str, int]:\n    \"\"\"Filters the letter frequencies, keeping only those letters whose counts match the highest frequency.\"\"\"\n    return {letter: count for letter, count in frequencies.items() if count == highest_freq}\ndef histogram(test: str) -> dict[str, int]:\n    \"\"\"Given a string representing a space separated lowercase letters, return a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\n\n    Example:\n    histogram('a b c') == {'a': 1, 'b': 1, 'c': 1}\n    histogram('a b b a') == {'a': 2, 'b': 2}\n    histogram('a b c a b') == {'a': 2, 'b': 2}\n    histogram('b b b b a') == {'b': 4}\n    histogram('') == {}\n\n    \"\"\"\n    if not test:\n        return {}\n\n    parsed_letters = _parse_input(test)\n    frequencies = _count_frequencies(parsed_letters)\n    highest_freq = _determine_highest_frequency(frequencies)\n    result = _filter_by_highest_frequency(frequencies, highest_freq)\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/112": [{"task_id": "HumanEval/112", "solution": "def _remove_characters(s: str, chars_to_remove: str) -> str:\n    \"\"\"Filters characters from a string based on a set of characters to be removed.\"\"\"\n    chars_to_remove_set = set(chars_to_remove)\n    result_chars = [char for char in s if char not in chars_to_remove_set]\n    return \"\".join(result_chars)\ndef _is_palindrome(s: str) -> bool:\n    \"\"\"Determines if a given string is a palindrome by comparing it to its reverse.\"\"\"\n    return s == s[::-1]\ndef reverse_delete(s,c):\n    \"\"\"Task\n    We are given two strings s and c, you have to deleted all the characters in s that are equal to any character in c\n    then check if the result string is palindrome.\n    A string is called palindrome if it reads the same backward as forward.\n    You should return a tuple containing the result string and True/False for the check.\n    Example\n    For s = \"abcde\", c = \"ae\", the r