sitive integers x. return a sorted list of all\n    elements that hasn't any even digit.\n\n    Note: Returned list should be sorted in increasing order.\n\n    For example:\n    >>> unique_digits([15, 33, 1422, 1])\n    [1, 15, 33]\n    >>> unique_digits([152, 323, 1422, 10])\n    []\n    \"\"\"\n    result_list = []\n    for num in x:\n        if not has_even_digit(num):\n            result_list.append(num)\n    result_list.sort()\n    return result_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/106": [{"task_id": "HumanEval/106", "solution": "class FactorialCalculator:\n    @staticmethod\n    def calculate(i: int) -> int:\n        \"\"\"Calculates the factorial of i (i!).\"\"\"\n        result = 1\n        for num in range(1, i + 1):\n            result *= num\n        return result\nclass SumCalculator:\n    @staticmethod\n    def calculate(i: int) -> int:\n        \"\"\"Calculates the sum of numbers from 1 to i.\"\"\"\n        return i * (i + 1) // 2\ndef f(n):\n    \"\"\" Implement the function f that takes n as a parameter,\n    and returns a list of size n, such that the value of the element at index i is the factorial of i if i is even\n    or the sum of numbers from 1 to i otherwise.\n    i starts from 1.\n    the factorial of i is the multiplication of the numbers from 1 to i (1 * 2 * ... * i).\n    Example:\n    f(5) == [1, 2, 6, 24, 15]\n    \"\"\"\n    result_list = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # i is even\n            result_list.append(FactorialCalculator.calculate(i))\n        else:  # i is odd\n            result_list.append(SumCalculator.calculate(i))\n    return result_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/106", "solution": "def calculate_factorial(num: int) -> int:\n    \"\"\"Calculates the factorial of a non-negative integer.\n    It multiplies numbers from 1 up to num.\n    \"\"\"\n    if num == 0:\n        return 1\n    result = 1\n    for i in range(1, num + 1):\n        result *= i\n    return result\ndef calculate_sum_up_to_n(num: int) -> int:\n    \"\"\"Calculates the sum of integers from 1 up to the given positive integer.\n    It sums numbers from 1 to num.\n    \"\"\"\n    return num * (num + 1) // 2\ndef f(n: int) -> list[int]:\n    \"\"\"Generates a list of n elements based on specific rules.\n    Elements are i! for even i, and sum(1 to i) for odd i.\n    \"\"\"\n    result_list = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:\n            element_value = calculate_factorial(i)\n        else:\n            element_value = calculate_sum_up_to_n(i)\n        result_list.append(element_value)\n    return result_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/105": [{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Processes an array of integers: filters 1-9, sorts ascending, reverses, and converts to word names.\n    Returns an empty array if the input is empty.\n    \"\"\"\n    digit_names_map = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    if not arr:\n        return []\n\n    filtered_arr = [x for x in arr if 1 <= x <= 9]\n    filtered_arr.sort()\n    filtered_arr.reverse()\n\n    result = [digit_names_map[x] for x in filtered_arr]\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/105", "solution": "DIGIT_NAMES = {\n    1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n    6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n}\ndef _filter_valid_integers(arr: list[int]) -> list[int]:\n    \"\"\"\n    Filters an array to include only integers between 1 and 9.\n    \"\"\"\n    return [n for n in arr if 1 <= n <= 9]\n