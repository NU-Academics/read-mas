{"task_id": "Mbpp/259", "solution": "from typing import Any, Tuple\ndef maximize_elements(tuple1: Tuple[Tuple[Any, ...], ...], tuple2: Tuple[Tuple[Any, ...], ...]) -> Tuple[Tuple[Any, ...], ...]:\n    \"\"\"\n    Maximizes elements of two input tuples of tuples element-wise.\n    It returns a new tuple of tuples where each element is the maximum of corresponding input elements.\n    \"\"\"\n    result_inner_tuples = []\n    for inner_tuple1, inner_tuple2 in zip(tuple1, tuple2):\n        maximized_inner_elements = []\n        for elem1, elem2 in zip(inner_tuple1, inner_tuple2):\n            maximized_inner_elements.append(max(elem1, elem2))\n        result_inner_tuples.append(tuple(maximized_inner_elements))\n    return tuple(result_inner_tuples)"}
{"task_id": "Mbpp/259", "solution": "from typing import Any\ndef maximize_elements(\n    tuple1: tuple[tuple[int | float, int | float], ...],\n    tuple2: tuple[tuple[int | float, int | float], ...],\n) -> tuple[tuple[int | float, int | float], ...]:\n    \"\"\"\n    Performs element-wise maximization of two structured data sets.\n\n    Takes two tuples of tuples as input, where each inner tuple contains two numbers.\n    It returns a new tuple of tuples where each inner tuple's elements are the\n    maximum of the corresponding elements from the input tuples.\n\n    Args:\n        tuple1: The first input tuple of tuples.\n        tuple2: The second input tuple of tuples.\n\n    Returns:\n        A new tuple of tuples with the element-wise maximums.\n\n    Raises:\n        MaximizerError: If inputs are invalid (e.g., wrong type, wrong length, non-numeric elements).\n    \"\"\"\n    validate_tuple_of_tuples(tuple1, \"tuple1\")\n    validate_tuple_of_tuples(tuple2, \"tuple2\")\n    validate_tuple_lengths(tuple1, tuple2)\n\n    maximized_result = []\n    for i in range(len(tuple1)):\n        inner_tuple1 = tuple1[i]\n        inner_tuple2 = tuple2[i]\n\n        validate_inner_tuple(inner_tuple1, i)\n        validate_inner_tuple(inner_tuple2, i)\n\n        max_first = max(inner_tuple1[0], inner_tuple2[0])\n        max_second = max(inner_tuple1[1], inner_tuple2[1])\n        maximized_result.append((max_first, max_second))\n\n    return tuple(maximized_result)"}
{"task_id": "Mbpp/260", "solution": "def newman_prime(n: int) -> int:\n    \"\"\"Finds the first Newman-Shanks-Williams prime number S_k such that k >= n.\"\"\"\n\n    def generate_nsw_number_inline(m: int) -> int:\n        \"\"\"Calculates the m-th NSW number S_m using its recurrence relation.\"\"\"\n        if m == 0:\n            return 1\n        if m == 1:\n            return 1\n        s_prev_prev = 1\n        s_prev = 1\n        for _ in range(2, m + 1):\n            s_current = 2 * s_prev + s_prev_prev\n            s_prev_prev = s_prev\n            s_prev = s_current\n        return s_prev\n\n    def is_prime_inline(num: int) -> bool:\n        \"\"\"Checks if a given positive integer is prime using trial division.\"\"\"\n        if num <= 1:\n            return False\n        if num == 2 or num == 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    current_m = n\n    while True:\n        nsw_number = generate_nsw_number_inline(current_m)\n        if is_prime_inline(nsw_number):\n            return nsw_number\n        current_m += 1"}
