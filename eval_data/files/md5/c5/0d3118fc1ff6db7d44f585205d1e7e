{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"Moves all numeric characters to the end of the string.\n    Preserves the relative order of both non-numeric and numeric characters.\n    \"\"\"\n    non_numeric_chars = []\n    numeric_chars = []\n\n    for char in input_string:\n        if char.isdigit():\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n\n    return \"\".join(non_numeric_chars) + \"\".join(numeric_chars)"}
{"task_id": "Mbpp/619", "solution": "def move_num(s: str) -> str:\n    \"\"\"\n    Moves all numeric characters to the end of the input string.\n    The relative order of non-numeric and numeric characters is preserved.\n    \"\"\"\n    non_numeric_chars = []\n    numeric_chars = []\n\n    for char in s:\n        if char.isdigit():\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n\n    return \"\".join(non_numeric_chars) + \"\".join(numeric_chars)"}
{"task_id": "Mbpp/618", "solution": "from typing import Union\nclass ListOperationError(Exception):\n    \"\"\"Base exception for errors in list operations.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass UnequalListLengthError(ListOperationError):\n    \"\"\"Raised when two lists have different lengths for an element-wise operation.\"\"\"\n    pass\nclass DivisionByZeroError(ListOperationError):\n    \"\"\"Raised when an attempt is made to divide by zero in an element-wise operation.\"\"\"\n    pass\ndef div_list(list_a: list[Union[int, float]], list_b: list[Union[int, float]]) -> list[float]:\n    \"\"\"\n    Divides two lists element-wise, returning a new list of float results.\n    Handles type, length, and division-by-zero errors.\n    \"\"\"\n    if not isinstance(list_a, list) or not isinstance(list_b, list):\n        raise TypeError(\"Both inputs must be lists.\")\n\n    if len(list_a) != len(list_b):\n        raise UnequalListLengthError(\"Input lists must have the same length.\")\n\n    result: list[float] = []\n    for i in range(len(list_a)):\n        if not isinstance(list_a[i], (int, float)) or not isinstance(list_b[i], (int, float)):\n            raise TypeError(\"Both lists must contain only numeric elements.\")\n        if list_b[i] == 0:\n            raise DivisionByZeroError(f\"Division by zero at index {i}.\")\n        result.append(float(list_a[i]) / list_b[i])\n    return result"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1: list[int], list2: list[int], n: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size.\n    This method calculates the median of the combined elements as a float.\n    \"\"\"\n    i = 0\n    j = 0\n    m1 = -1\n    m2 = -1\n\n    for count in range(n + 1):\n        if i == n:\n            m1 = m2\n            m2 = list2[j]\n            j += 1\n        elif j == n:\n            m1 = m2\n            m2 = list1[i]\n            i += 1\n        elif list1[i] <= list2[j]:\n            m1 = m2\n            m2 = list1[i]\n            i += 1\n        else:\n            m1 = m2\n            m2 = list2[j]\n            j += 1\n    return (m1 + m2) / 2.0"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the size of the largest subset of numbers where every pair is mutually divisible.\n    This function treats zero as a special case, not extending other numbers.\n    \"\"\"\n    n = len(numbers)\n    if n == 0:\n        return 0\n\n    # Filter out zeros and handle them separately; sort positive numbers for DP.\n    positive_numbers = sorted([num for num in numbers if num > 0])\n    has_zero = any(num == 0 for num in numbers)\n\n    n_pos = len(positive_numbers)\n    if n_pos == 0:\n        # If no positive numbers, but zeros were present, [0] forms a subset of size 1.\n        return 1 if has_zero else 0\n\n    # dp[i] stores the size of the largest divisible subset ending with positive_numbers[i].\n    dp = [1] * n_pos\n\n    for i in range(n_pos):\n        for j in range(i):\n            # Since numbers are sorted and positive, only check if positive_numbers[i] is divisible by positive_numbers[j].\n            if positive_numbers[i] % positive_numbers[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n\n    max_len_pos = max(dp)\n\n    # If zero was present, it can form a subset of size 1. It cannot combine with positive numbers.\n    return max(max_len_pos, 1) if has_zero else max_len_pos"}
