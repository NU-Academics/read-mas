{"task_id": "Mbpp/261", "solution": "from typing import Tuple, Union\ndef division_elements(tuple1: Tuple[Union[int, float]], tuple2: Tuple[Union[int, float]]) -> Tuple[float]:\n    \"\"\"\n    Performs element-wise division of two tuples, dividing elements of the first by the second.\n    It returns a new tuple containing the float results.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise TupleLengthMismatchError(\"Input tuples must have the same length.\")\n\n    results = []\n    for i in range(len(tuple1)):\n        val1 = tuple1[i]\n        val2 = tuple2[i]\n\n        if not isinstance(val1, (int, float)):\n            raise NonNumericTupleElementError(f\"Non-numeric element in first tuple\", i, val1)\n        if not isinstance(val2, (int, float)):\n            raise NonNumericTupleElementError(f\"Non-numeric element in second tuple\", i, val2)\n\n        if val2 == 0:\n            raise DivisionByZeroError(\"Division by zero encountered\", i)\n\n        results.append(float(val1) / val2)\n\n    return tuple(results)\nclass TupleMathError(Exception):\n    \"\"\"Base exception for errors in tuple_math operations.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\nclass TupleLengthMismatchError(TupleMathError):\n    \"\"\"Raised when input tuples have different lengths.\"\"\"\n    pass\nclass NonNumericTupleElementError(TupleMathError):\n    \"\"\"Raised when a tuple contains a non-numeric element.\"\"\"\n    def __init__(self, message: str, index: int, value: object):\n        self.index = index\n        self.value = value\n        super().__init__(f\"{message} at index {index}: {value}\")\nclass DivisionByZeroError(TupleMathError):\n    \"\"\"Raised when an attempt is made to divide by zero.\"\"\"\n    def __init__(self, message: str, index: int):\n        self.index = index\n        super().__init__(f\"{message} at index {index}\")"}
{"task_id": "Mbpp/260", "solution": "def newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the Newman-Shanks-Williams prime number corresponding to the input `n`.\n    Calculates S_n and returns it if S_n is prime.\n    \"\"\"\n\n    def calculate_Sn(n_val: int) -> int:\n        \"\"\"Computes the nth term of the Newman-Shanks-Williams sequence iteratively.\"\"\"\n        if n_val == 0:\n            return 1\n        if n_val == 1:\n            return 1\n\n        s_prev_prev = 1\n        s_prev = 1\n        s_current = 0\n        for _ in range(2, n_val + 1):\n            s_current = 2 * s_prev + s_prev_prev\n            s_prev_prev = s_prev\n            s_prev = s_current\n        return s_current\n\n    def is_prime(num: int) -> bool:\n        \"\"\"Determines if a given integer 'num' is a prime number.\"\"\"\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    s_n_value = calculate_Sn(n)\n    if is_prime(s_n_value):\n        return s_n_value\n    else:\n        raise ValueError(f\"S_{n} = {s_n_value} is not a Newman-Shanks-Williams prime number.\")"}
{"task_id": "Mbpp/261", "solution": "def division_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise integer division operation across the given tuples.\n\n    Args:\n        tuple1: The first tuple (numerator).\n        tuple2: The second tuple (denominator).\n\n    Returns:\n        A new tuple with the integer results of the element-wise division.\n    \"\"\"\n    results = []\n    for i in range(len(tuple1)):\n        results.append(tuple1[i] // tuple2[i])\n    return tuple(results)"}
