{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(arr: list[int], n: int) -> int:\n    \"\"\"Calculates the sum of XOR of all unique pairs in the input list.\n    Assumes valid input types and length matching.\n    \"\"\"\n    total_xor_sum = 0\n    for i in range(n):\n        for j in range(i + 1, n):\n            total_xor_sum += (arr[i] ^ arr[j])\n    return total_xor_sum"}
{"task_id": "Mbpp/635", "solution": "def _heapify(arr: list, n: int, i: int) -> None:\n    \"\"\"\n    Heapifies a subtree rooted with node i to maintain the max-heap property.\n    n is the size of the heap.\n    \"\"\"\n    largest = i\n    l = 2 * i + 1\n    r = 2 * i + 2\n\n    if l < n and arr[l] > arr[largest]:\n        largest = l\n\n    if r < n and arr[r] > arr[largest]:\n        largest = r\n\n    if largest != i:\n        arr[i], arr[largest] = arr[largest], arr[i]\n        _heapify(arr, n, largest)\n\ndef heap_sort(arr: list) -> None:\n    \"\"\"\n    Sorts a list in-place using the heap sort algorithm.\n    The list is modified to be in ascending order.\n    \"\"\"\n    n = len(arr)\n\n    for i in range(n // 2 - 1, -1, -1):\n        _heapify(arr, n, i)\n\n    for i in range(n - 1, 0, -1):\n        arr[i], arr[0] = arr[0], arr[i]\n        _heapify(arr, i, 0)"}
{"task_id": "Mbpp/632", "solution": "def move_zero(input_list: list) -> list:\n    \"\"\"\n    Moves all zero elements to the end of the given list.\n    Preserves the relative order of non-zero elements.\n    \"\"\"\n    non_zeros = []\n    zero_count = 0\n    for element in input_list:\n        if element == 0:\n            zero_count += 1\n        else:\n            non_zeros.append(element)\n    \n    non_zeros.extend([0] * zero_count)\n    return non_zeros"}
