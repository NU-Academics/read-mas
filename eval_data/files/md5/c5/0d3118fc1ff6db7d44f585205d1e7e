{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list[list]:\n    \"\"\"Groups consecutive identical elements in a list into sublists.\n    Returns a new list containing these sublists.\"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_sublist = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_sublist[0]:\n            current_sublist.append(input_list[i])\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [input_list[i]]\n    \n    packed_list.append(current_sublist)\n    return packed_list"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list):\n    \"\"\"Groups consecutive identical elements in a list into sublists.\n    This function processes the input in linear time complexity O(N).\n    \"\"\"\n    packed_list = []\n    current_sublist = []\n\n    for item in input_list:\n        if not current_sublist or item == current_sublist[-1]:\n            current_sublist.append(item)\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [item]\n    \n    if current_sublist: # Append the last collected sublist if it's not empty.\n        packed_list.append(current_sublist)\n\n    return packed_list"}
{"task_id": "Mbpp/777", "solution": "from typing import Union\ndef find_sum(data_list: list) -> Union[int, float]:\n    \"\"\"\n    Calculates the sum of non-repeated elements in a given list.\n    \"Non-repeated\" is interpreted as unique elements, where each distinct\n    element is added to the sum exactly once, consistent with the provided assertion.\n    \n    Args:\n        data_list: The input list of elements.\n\n    Returns:\n        The sum of the unique elements in the list.\n    \"\"\"\n    return sum(set(data_list))"}
{"task_id": "Mbpp/780", "solution": "import itertools\ndef find_combinations(tuple_list: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    \"\"\"Calculates element-wise sums of all unique pairs of 2-element tuples.\n    Returns a list of 2-element tuples, each the sum of a unique pair.\n    \"\"\"\n    results = []\n    for t1, t2 in itertools.combinations(tuple_list, 2):\n        sum_tuple = (t1[0] + t2[0], t1[1] + t2[1])\n        results.append(sum_tuple)\n    return results"}
{"task_id": "Mbpp/777", "solution": "def find_sum(numbers):\n    \"\"\"Calculates the sum of elements that appear exactly once in the list.\n    Returns 0 if no unique elements are found.\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    total_sum = 0\n    for num, count in counts.items():\n        if count == 1:\n            total_sum += num\n            \n    return total_sum"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of all elements across all possible odd-length subarrays.\n    It iterates through all subarrays, checks their length, and sums elements if the length is odd.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        for j in range(i, n):\n            # The current subarray is arr[i:j+1].\n            subarray_length = j - i + 1\n            if subarray_length % 2 != 0:\n                # Sum elements of this odd-length subarray.\n                for k in range(i, j + 1):\n                    total_sum += arr[k]\n    return total_sum"}
