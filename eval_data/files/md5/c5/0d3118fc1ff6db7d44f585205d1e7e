{"task_id": "Mbpp/392", "solution": "_memoization_cache = {}\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Calculates the maximum sum for n using a recursive formula with memoization.\n    f(n) = max((f(n/2) + f(n/3) + f(n/4) + f(n/5)), n)\n    \"\"\"\n    if n in _memoization_cache:\n        return _memoization_cache[n]\n\n    if n == 0:\n        result = 0\n    else:\n        sum_of_parts = (\n            get_max_sum(n // 2) +\n            get_max_sum(n // 3) +\n            get_max_sum(n // 4) +\n            get_max_sum(n // 5)\n        )\n        result = max(sum_of_parts, n)\n\n    _memoization_cache[n] = result\n    return result"}
