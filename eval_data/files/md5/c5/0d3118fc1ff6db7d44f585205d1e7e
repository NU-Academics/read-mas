{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"\n    Counts the number of equal numbers from three given integers.\n\n    Args:\n        a: The first integer.\n        b: The second integer.\n        c: The third integer.\n\n    Returns:\n        An integer representing the count of equal numbers (3 if all are equal,\n        2 if exactly two are equal, and 1 if none are equal).\n\n    Raises:\n        TypeError: If any of the inputs are not integers.\n    \"\"\"\n    if not all(isinstance(arg, int) for arg in [a, b, c]):\n        raise TypeError(\"All inputs must be integers.\")\n\n    if a == b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 1"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(num1, num2, num3):\n    \"\"\"\n    Counts how many of three given numbers are equal.\n    Returns 3 if all are equal, 2 if exactly two are equal, and 0 if none are equal.\n    \"\"\"\n    unique_numbers = {num1, num2, num3}\n    if len(unique_numbers) == 1:\n        return 3\n    elif len(unique_numbers) == 2:\n        return 2\n    else:  # len(unique_numbers) == 3\n        return 0"}
{"task_id": "Mbpp/803", "solution": "def is_perfect_square(number):\n    \"\"\"Checks if a given number is a perfect square.\n    Negative numbers are not considered perfect squares.\"\"\"\n\n    # Handle negative numbers as they are not perfect squares in this context.\n    if number < 0:\n        return False\n\n    # Zero is considered a perfect square (0 * 0 = 0).\n    if number == 0:\n        return True\n\n    # Calculate the integer square root of the number.\n    # Python's arbitrary precision integers handle large numbers gracefully.\n    root = int(number**0.5)\n\n    # Check if squaring the integer root yields the original number.\n    return root * root == number"}
{"task_id": "Mbpp/803", "solution": "import math\ndef is_perfect_square(n: int) -> bool:\n    \"\"\"Checks if a given integer is a perfect square.\n    Negative numbers are not considered perfect squares according to business rules.\n    \"\"\"\n    if n < 0:\n        return False\n    if n == 0:\n        return True\n\n    sqrt_n = math.isqrt(n)\n    return sqrt_n * sqrt_n == n"}
{"task_id": "Mbpp/796", "solution": "def return_sum(data: dict):\n    \"\"\"\n    Calculates the sum of all numeric values (integers and floats) in the input dictionary.\n    Non-numeric values are ignored.\n    \"\"\"\n    total_sum = 0\n    for value in data.values():\n        if isinstance(value, (int, float)):\n            total_sum += value\n    return total_sum"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers):\n    \"\"\"\n    Checks whether the product of numbers in a list is even or not.\n\n    Args:\n        numbers: A list of integers.\n\n    Returns:\n        True if the product of the numbers is even, False otherwise.\n\n    Raises:\n        TypeError: If the input 'numbers' is not a list.\n        ValueError: If any element in 'numbers' is not an integer.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not numbers:\n        # The product of an empty list is conventionally 1, which is odd.\n        return False\n\n    for num in numbers:\n        if not isinstance(num, int):\n            raise ValueError(f\"All elements in the list must be integers. Found: {type(num).__name__}\")\n        # If any number is 0, the product is 0, which is even.\n        # If any number is even, the product will be even.\n        if num == 0 or num % 2 == 0:\n            return True\n    \n    # If we reach here, no even numbers or zeros were found.\n    # This means all numbers were odd, making their product odd.\n    return False"}
{"task_id": "Mbpp/781", "solution": "import math\ndef count_divisors(number: int) -> bool:\n    \"\"\"\n    Checks if the count of positive divisors for a given number is an even number.\n    A number has an odd number of divisors if and only if it is a perfect square.\n    \"\"\"\n    # Determine if the number is a perfect square using its integer square root.\n    # Perfect squares have an odd number of divisors, non-perfect squares have an even number.\n    sqrt_num = int(math.isqrt(number))\n    return not (sqrt_num * sqrt_num == number)"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(string: str) -> int:\n    \"\"\"Finds the maximum consecutive run of uppercase characters in a string.\n    Returns 0 if no uppercase characters are found or the string is empty.\"\"\"\n    max_run = 0\n    current_run = 0\n    for char in string:\n        if char.isupper():\n            current_run += 1\n        else:\n            max_run = max(max_run, current_run)\n            current_run = 0\n    max_run = max(max_run, current_run)\n    return max_run"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"Calculates the maximum length of a consecutive run of uppercase characters in the given string. Returns 0 if no uppercase characters are found or the string is empty.\"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n        else:\n            max_run = max(max_run, current_run)\n            current_run = 0\n    return max(max_run, current_run)"}
{"task_id": "Mbpp/807", "solution": "from typing import List, Optional\ndef first_odd(numbers: List[int]) -> Optional[int]:\n    \"\"\"\n    Finds the first odd number in a list of integers.\n    Returns the odd number or None if none are found.\n    \"\"\"\n    for number in numbers:\n        if number % 2 != 0:\n            return number\n    return None"}
{"task_id": "Mbpp/805", "solution": "from typing import List, Union\ndef max_sum_list(list_of_lists: List[List[Union[int, float]]]) -> List[Union[int, float]]:\n    \"\"\"\n    Identifies and returns the sublist from a given list of lists whose\n    sum of elements is the highest.\n\n    Args:\n        list_of_lists: A list of lists, where each inner list contains\n                       integers or floats.\n\n    Returns:\n        The sublist with the highest sum. Returns an empty list if\n        the input list_of_lists is empty.\n\n    Raises:\n        TypeError: If the input is not a list of lists of numbers.\n    \"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Input must be a list of lists.\")\n\n    if not list_of_lists:\n        return []\n\n    max_sum = float('-inf')\n    max_list: List[Union[int, float]] = []\n\n    for i, inner_list in enumerate(list_of_lists):\n        if not isinstance(inner_list, list):\n            raise TypeError(f\"Element at index {i} is not a list.\")\n\n        current_sum = 0\n        for j, element in enumerate(inner_list):\n            if not isinstance(element, (int, float)):\n                raise TypeError(f\"Element at index [{i}][{j}] is not a number.\")\n            current_sum += element\n\n        if current_sum > max_sum:\n            max_sum = current_sum\n            max_list = inner_list\n        elif current_sum == max_sum and not max_list and not inner_list:\n            # Special case for all empty lists: if max_list is still empty (initial state\n            # or only empty lists processed) and current inner_list is also empty,\n            # this handles returning the first empty list encountered as per tie-breaking.\n            # However, the `current_sum > max_sum` logic already handles this correctly,\n            # so this branch is effectively a no-op but kept for consistency with design example.\n            pass\n\n    return max_list"}
