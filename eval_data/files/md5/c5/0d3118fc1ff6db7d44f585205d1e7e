{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the first even and first odd number in the given list and returns their product.\n    If either an even or an odd number is not found, the function returns 0.\n    \"\"\"\n    first_odd = None\n    first_even = None\n\n    for num in numbers:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is None and num % 2 == 0:\n            first_even = num\n            \n        # If both have been found, we can stop early and return the product\n        if first_odd is not None and first_even is not None:\n            return first_odd * first_even\n    \n    # If the loop completes and either first_odd or first_even (or both) are still None,\n    # it means one or both types of numbers were not found.\n    return 0"}
{"task_id": "Mbpp/782", "solution": "from typing import List\ndef odd_length_sum(arr: List[int]) -> int:\n    \"\"\"Calculates the sum of all odd-length subarrays within the given integer array.\n    This function uses an O(N) approach by summing each element's contribution to the total.\"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        # For each element arr[i], calculate how many odd-length subarrays it is part of.\n        # The number of such occurrences is given by the formula: ((i + 1) * (n - i) + 1) // 2.\n        occurrences = ((i + 1) * (n - i) + 1) // 2\n        total_sum += arr[i] * occurrences\n            \n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the product of the first encountered even and odd numbers in a list.\n    It assumes the input list contains at least one even and one odd integer.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n\n        if first_even is not None and first_odd is not None:\n            break\n\n    return first_even * first_odd"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_str: str) -> tuple[int, ...]:\n    \"\"\"Converts a string representation of an integer tuple into an integer tuple.\n    Assumes valid input format, letting Python's built-in errors propagate for malformed inputs.\n    \"\"\"\n    # Remove leading/trailing whitespace and the outer parentheses.\n    # This step implicitly relies on the input string being correctly formatted with parentheses.\n    content = tuple_str.strip()[1:-1].strip()\n\n    # Handle the case of an empty tuple string, e.g., \"()\" or \"( )\".\n    if not content:\n        return ()\n\n    # Split the content by commas, filter out any empty string elements, and convert to integers.\n    # The list comprehension processes each non-empty, stripped element and converts it to an integer.\n    elements = [int(s.strip()) for s in content.split(',') if s.strip()]\n\n    # Collect all converted integers into a new tuple and return it.\n    return tuple(elements)"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(nums: list[int], target: int) -> int:\n    \"\"\"\n    Locates the rightmost insertion point for a specified value in a sorted list.\n    It returns an index `i` such that elements before `i` are less than or equal to `target`, and elements at or after `i` are strictly greater than `target`.\n    \"\"\"\n    low, high = 0, len(nums)\n\n    while low < high:\n        mid = low + (high - low) // 2\n        if nums[mid] <= target:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_string: str) -> tuple[int, ...]:\n    \"\"\"Converts a string representation of an integer tuple to a Python tuple.\n    Assumes valid input: parenthesized string with comma-separated integers.\n    \"\"\"\n    s = tuple_string.strip()\n    content = s[1:-1].strip()\n\n    if not content:\n        return ()\n\n    elements_str = content.split(',')\n    result = [int(element.strip()) for element in elements_str]\n    \n    return tuple(result)"}
