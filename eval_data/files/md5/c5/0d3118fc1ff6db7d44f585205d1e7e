{"task_id": "Mbpp/759", "solution": "import re\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string represents a decimal number with at most two decimal places.\n    The function returns True for valid formats, False otherwise.\n    \"\"\"\n    # Regex matches an optional sign, one or more digits, then an optional decimal part with 1 or 2 digits.\n    pattern = r\"^[+-]?\\d+(\\.\\d{1,2})?$\"\n    return bool(re.fullmatch(pattern, input_string))"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"\n    Counts the number of unique reverse string pairs in the given list.\n    A pair is counted only once, and comparison is case-sensitive.\n    \"\"\"\n    pair_count = 0\n    seen_strings = set()\n    processed_pairs = set()\n\n    for s in string_list:\n        reversed_s = s[::-1]\n        \n        # If the reverse of 's' has been seen, a potential pair is found.\n        if reversed_s in seen_strings:\n            # Use a canonical representation to count each unique pair exactly once.\n            canonical_pair = tuple(sorted((s, reversed_s)))\n            if canonical_pair not in processed_pairs:\n                pair_count += 1\n                processed_pairs.add(canonical_pair)\n        \n        seen_strings.add(s)\n    \n    return pair_count"}
{"task_id": "Mbpp/759", "solution": "import re\ndef is_decimal(s: str) -> bool:\n    \"\"\"Checks if the given string represents a decimal number with exactly two digits after the decimal point.\n    Returns True if valid, False otherwise.\"\"\"\n    \n    # Regular expression to match a decimal number with an optional sign, at least one digit\n    # before the decimal point, a decimal point, and exactly two digits after it.\n    pattern = re.compile(r\"^[+-]?\\d+\\.\\d{2}$\")\n    \n    if pattern.match(s):\n        try:\n            # Confirm numerical validity, catching any non-standard float representations.\n            float(s)\n            return True\n        except ValueError:\n            return False\n    return False"}
