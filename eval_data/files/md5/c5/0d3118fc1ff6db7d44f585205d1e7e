{"task_id": "Mbpp/223", "solution": "def is_majority(arr: list[int], n: int, x: int) -> bool:\n    \"\"\"Determines if an element is a majority element in a sorted array.\n    A majority element occurs strictly more than n/2 times.\"\"\"\n\n    # Find the first occurrence of x using binary search\n    low, high = 0, n - 1\n    first_idx = -1\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            first_idx = mid\n            high = mid - 1  # Look for an earlier occurrence\n        elif arr[mid] < x:\n            low = mid + 1\n        else:\n            high = mid - 1\n\n    # If x is not found, it cannot be a majority element\n    if first_idx == -1:\n        return False\n\n    # Find the last occurrence of x using binary search\n    low, high = 0, n - 1\n    last_idx = -1\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            last_idx = mid\n            low = mid + 1  # Look for a later occurrence\n        elif arr[mid] < x:\n            low = mid + 1\n        else:\n            high = mid - 1\n\n    # Calculate the count and check if it's a majority\n    count = last_idx - first_idx + 1\n    return count > n / 2"}
{"task_id": "Mbpp/223", "solution": "def is_majority(sorted_array: list[int], n: int, element: int) -> bool:\n    \"\"\"\n    Determines if an element is a majority element in a sorted array.\n    A majority element occurs strictly more than n/2 times.\n    \"\"\"\n\n    if n < 0 or n != len(sorted_array):\n        raise ValueError(\"Invalid 'n': must be non-negative and match array length.\")\n\n    if n == 0:\n        return False\n\n    # Inlined logic to find the first occurrence of the element using binary search.\n    low, high = 0, n - 1\n    first_idx = -1\n    while low <= high:\n        mid = low + (high - low) // 2\n        if sorted_array[mid] == element:\n            first_idx = mid\n            high = mid - 1  # Try to find an earlier occurrence\n        elif sorted_array[mid] < element:\n            low = mid + 1\n        else:\n            high = mid - 1\n\n    if first_idx == -1:\n        return False  # Element not found in the array\n\n    # Inlined logic to find the last occurrence of the element using binary search.\n    low, high = 0, n - 1\n    last_idx = -1\n    while low <= high:\n        mid = low + (high - low) // 2\n        if sorted_array[mid] == element:\n            last_idx = mid\n            low = mid + 1  # Try to find a later occurrence\n        elif sorted_array[mid] < element:\n            low = mid + 1\n        else:\n            high = mid - 1\n            \n    # Calculate the total count of the element.\n    count = last_idx - first_idx + 1\n    \n    # Check if the element's count is strictly greater than n/2.\n    return count > n / 2"}
