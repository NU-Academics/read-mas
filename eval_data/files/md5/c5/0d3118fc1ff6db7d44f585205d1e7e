{"task_id": "Mbpp/125", "solution": "class InvalidBinaryStringError(ValueError):\n    \"\"\"Custom exception for invalid binary string inputs.\"\"\"\n    ERROR_INVALID_BINARY_STRING = \"Input string must contain only '0' or '1'.\"\n    ERROR_EMPTY_STRING = \"Input string cannot be empty.\"\n\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef find_length(binary_string: str) -> int:\n    \"\"\"\n    Calculates the maximum difference between the count of '0's and '1's in any substring\n    of the given binary string.\n\n    Args:\n        binary_string: The input binary string.\n\n    Returns:\n        The maximum difference found.\n\n    Raises:\n        TypeError: If the input is not a string.\n        InvalidBinaryStringError: If the string is empty or contains non-binary characters.\n    \"\"\"\n    if not isinstance(binary_string, str):\n        raise TypeError(\"Input must be a string.\")\n    if not binary_string:\n        raise InvalidBinaryStringError(InvalidBinaryStringError.ERROR_EMPTY_STRING)\n    if not all(char in '01' for char in binary_string):\n        raise InvalidBinaryStringError(InvalidBinaryStringError.ERROR_INVALID_BINARY_STRING)\n\n    # Transform '0' to 1 and '1' to -1\n    transformed_array = [1 if char == '0' else -1 for char in binary_string]\n\n    max_so_far = 0\n    current_max = 0\n\n    for num in transformed_array:\n        current_max += num\n        if current_max < 0:\n            current_max = 0\n        if current_max > max_so_far:\n            max_so_far = current_max\n            \n    return max_so_far"}
{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    \"\"\"\n    Calculates the maximum difference between '0's and '1's in any substring of a binary string.\n    '0's contribute +1 and '1's contribute -1 to the difference.\n    \"\"\"\n    if not s:\n        return 0\n\n    # Transform '0' to 1 and '1' to -1\n    transformed_array = [1 if char == '0' else -1 for char in s]\n\n    max_so_far = 0\n    current_max = 0\n\n    # Apply a variation of Kadane's algorithm\n    for num in transformed_array:\n        current_max += num\n        if current_max < 0:\n            current_max = 0\n        max_so_far = max(max_so_far, current_max)\n    \n    return max_so_far"}
