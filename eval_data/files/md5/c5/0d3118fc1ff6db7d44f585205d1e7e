{"task_id": "Mbpp/604", "solution": "def reverse_words(input_string: str) -> str:\n    \"\"\"\n    Reverses the order of words in a string, delimited by spaces.\n    Handles multiple internal spaces and leading/trailing spaces gracefully.\n    \"\"\"\n    words = [word for word in input_string.split(' ') if word]\n    words.reverse()\n    return ' '.join(words)"}
{"task_id": "Mbpp/604", "solution": "def reverse_words(input_string: str) -> str:\n    \"\"\"Reverses the order of words in a string, using spaces as delimiters.\n    Handles multiple spaces and leading/trailing spaces correctly.\n    \"\"\"\n    words = input_string.split()\n    reversed_words = words[::-1]\n    return \" \".join(reversed_words)"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(limit: int) -> list[int]:\n    \"\"\"Calculates all lucid numbers up to a specified integer limit.\"\"\"\n    lucid_numbers = []\n\n    if limit >= 1:\n        lucid_numbers.append(1)\n\n    if limit < 2:\n        return lucid_numbers\n\n    # Sieve of Eratosthenes to find prime numbers\n    is_prime = [True] * (limit + 1)\n    is_prime[0] = is_prime[1] = False\n    for p in range(2, int(limit**0.5) + 1):\n        if is_prime[p]:\n            for multiple in range(p * p, limit + 1, p):\n                is_prime[multiple] = False\n    \n    primes = [num for num, prime in enumerate(is_prime) if prime]\n    \n    lucid_numbers.extend(primes)\n    \n    return sorted(list(set(lucid_numbers)))"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(n: int) -> list[int]:\n    \"\"\"\n    Calculates all Ludic numbers smaller than or equal to the given integer n.\n\n    Args:\n        n: An integer representing the upper limit for Ludic numbers.\n\n    Returns:\n        A list of integers representing all Ludic numbers less than or equal to n.\n\n    Raises:\n        ValueError: If n is not a positive integer (n < 1).\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"Input must be a positive integer (n >= 1).\")\n\n    if n == 1:\n        return [1]\n\n    # Initialize a list of numbers from 1 to n\n    numbers = list(range(1, n + 1))\n    ludic_list = []\n\n    # The first Ludic number is always 1.\n    # We remove it from 'numbers' and add it to 'ludic_list'.\n    # This also means the actual numbers list starts from 2 for sieving.\n    if numbers:\n        ludic_list.append(numbers.pop(0))\n\n    # Continue the sieve process as long as there are numbers to process\n    while numbers:\n        # The next Ludic number is the first remaining number in the 'numbers' list\n        current_ludic = numbers.pop(0)\n        ludic_list.append(current_ludic)\n\n        # Apply the sieve: remove every current_ludic-th element\n        # from the *current* 'numbers' list.\n        sieved_numbers = []\n        count = 0\n        for num in numbers:\n            count += 1\n            if count % current_ludic != 0:\n                sieved_numbers.append(num)\n        numbers = sieved_numbers\n\n    return ludic_list"}
{"task_id": "Mbpp/605", "solution": "def prime_num(number: int) -> bool:\n    \"\"\"\n    Determines if the input number is a prime number.\n    It returns True for prime numbers and False otherwise.\n    \"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True"}
