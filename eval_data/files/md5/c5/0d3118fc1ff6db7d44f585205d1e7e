{"task_id": "Mbpp/67", "solution": "from typing import List\n_stirling_cache: List[List[int]] = []\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using dynamic programming for Stirling numbers of the second kind.\n    It builds a cache of Stirling numbers to compute the sum for B_n.\n    \"\"\"\n    # Input 'n' is trusted to be a non-negative integer as per critical requirements.\n    if n == 0:\n        return 1\n\n    global _stirling_cache\n    # Ensure _stirling_cache has enough rows (n+1 for indices 0 to n).\n    while len(_stirling_cache) <= n:\n        _stirling_cache.append([])\n\n    # Ensure each row i has enough columns (i+1 for indices 0 to i).\n    # This loop initializes or extends rows with zeroes if needed.\n    for i in range(len(_stirling_cache)):\n        while len(_stirling_cache[i]) <= i:\n            _stirling_cache[i].append(0)\n\n    # Base case for Stirling numbers of the second kind: S(0, 0) = 1.\n    _stirling_cache[0][0] = 1\n\n    # Compute Stirling numbers S(i, k) for i from 1 to n using recurrence.\n    # This fills the _stirling_cache table up to row 'n'.\n    for i in range(1, n + 1):\n        # Base case: S(i, 0) = 0 for i > 0.\n        _stirling_cache[i][0] = 0\n        for k in range(1, i + 1):\n            if k == i:\n                # Base case: S(i, i) = 1.\n                _stirling_cache[i][k] = 1\n            else:\n                # Recurrence: S(i, k) = S(i-1, k-1) + k * S(i-1, k).\n                _stirling_cache[i][k] = _stirling_cache[i-1][k-1] + k * _stirling_cache[i-1][k]\n\n    # Calculate the nth Bell number as the sum of S(n, k) for k from 0 to n.\n    bell_n = sum(_stirling_cache[n][k] for k in range(n + 1))\n    return bell_n"}
{"task_id": "Mbpp/67", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values in Bell number calculations.\"\"\"\n    pass\nclass BellNumberCalculator:\n    \"\"\"Manages the computation and memoization of Bell and Stirling numbers.\"\"\"\n    _BELL_CACHE: dict[int, int] = {0: 1}  # Cache for Bell numbers, initialized with B(0)\n    _STIRLING_CACHE: dict[tuple[int, int], int] = {} # Cache for Stirling numbers\n\n    def _stirling_number_second_kind(self, n: int, k: int) -> int:\n        \"\"\"Calculates Stirling number S(n, k) using its recurrence relation and memoization.\"\"\"\n        if k < 0 or k > n:\n            return 0\n        if (n, k) in self._STIRLING_CACHE:\n            return self._STIRLING_CACHE[(n, k)]\n\n        # Base cases: S(0,0)=1, S(n,0)=0 for n>0, S(n,n)=1\n        if k == 0:\n            result = 1 if n == 0 else 0\n        elif k == n:\n            result = 1\n        else:\n            # S(n, k) = k * S(n-1, k) + S(n-1, k-1)\n            result = k * self._stirling_number_second_kind(n - 1, k) + \\\n                     self._stirling_number_second_kind(n - 1, k - 1)\n        \n        self._STIRLING_CACHE[(n, k)] = result\n        return result\n\n    def _calculate_bell_number(self, n: int) -> int:\n        \"\"\"Computes the nth Bell number by summing Stirling numbers, leveraging memoization.\"\"\"\n        if n in self._BELL_CACHE:\n            return self._BELL_CACHE[n]\n\n        bell_n = 0\n        for k in range(n + 1):\n            bell_n += self._stirling_number_second_kind(n, k)\n        self._BELL_CACHE[n] = bell_n\n        return bell_n\n_calculator_instance = BellNumberCalculator()\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number.\n\n    Args:\n        n: A non-negative integer.\n\n    Returns:\n        The nth Bell number.\n\n    Raises:\n        InvalidInputError: If n is not a non-negative integer.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n    return _calculator_instance._calculate_bell_number(n)"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Determines if sub_list is a contiguous sublist of main_list.\n    Returns True if sub_list is found, False otherwise.\n    \"\"\"\n    if not sub_list:\n        return True\n    if not main_list or len(sub_list) > len(main_list):\n        return False\n\n    n = len(main_list)\n    m = len(sub_list)\n\n    for i in range(n - m + 1):\n        if main_list[i : i + m] == sub_list:\n            return True\n    return False"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(arr: list[int | float]) -> bool:\n    \"\"\"\n    Determines if an array is monotonic (entirely non-increasing or non-decreasing).\n    Returns True for empty or single-element arrays.\n    \"\"\"\n    if len(arr) <= 1:\n        return True\n\n    is_non_decreasing = True\n    is_non_increasing = True\n\n    for i in range(len(arr) - 1):\n        if arr[i] > arr[i+1]:\n            is_non_decreasing = False\n        if arr[i] < arr[i+1]:\n            is_non_increasing = False\n\n    return is_non_decreasing or is_non_increasing"}
