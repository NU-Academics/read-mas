{"task_id": "Mbpp/809", "solution": "def check_smaller(tuple1: tuple, tuple2: tuple) -> bool:\n    \"\"\"\n    Checks if each element of the second tuple is strictly smaller than its\n    corresponding element in the first tuple.\n\n    Args:\n        tuple1: The first tuple.\n        tuple2: The second tuple.\n\n    Returns:\n        True if all elements in tuple2 are strictly smaller than their\n        corresponding elements in tuple1, otherwise False.\n\n    Raises:\n        ValueError: If the tuples have different lengths.\n        TypeError: If elements are not comparable.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Tuples must have the same length for element-wise comparison.\")\n\n    for i in range(len(tuple1)):\n        if not (tuple2[i] < tuple1[i]):\n            return False\n    return True"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(tuple1: tuple, tuple2: tuple) -> bool:\n    \"\"\"\n    Checks if each element of the second tuple is strictly smaller than its\n    corresponding element in the first tuple.\n    Returns True if every element of tuple2 is smaller, False otherwise.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        return False\n\n    for i in range(len(tuple1)):\n        if not (tuple2[i] < tuple1[i]):\n            return False\n    return True"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers: list[int]) -> int | None:\n    \"\"\"\n    Finds the first odd number in a given list of integers.\n\n    Args:\n        numbers: A list of integers.\n\n    Returns:\n        The first odd number found, or None if no odd numbers are present.\n\n    Raises:\n        TypeError: If the input is not a list or contains non-integer elements.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    \n    for number in numbers:\n        if not isinstance(number, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n        if number % 2 != 0:\n            return number\n    return None"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers_list):\n    \"\"\"\n    Determines if the product of numbers in a list is even.\n    Returns True if an even number or zero is present, False otherwise.\n    \"\"\"\n    if not numbers_list:\n        return False  # Product of an empty list is 1 (odd).\n\n    for number in numbers_list:\n        if number == 0:\n            return True  # If 0 is present, the product is 0, which is even.\n\n        # Check if the number is an integer or an integer-like float and is even.\n        if number == int(number) and int(number) % 2 == 0:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Natural numbers are positive integers (1, 2, 3...).\n    \"\"\"\n    total_sum = 0\n    \n    # Adjust lower bound to ensure only natural numbers (>= 1) are considered.\n    start = max(1, l)\n\n    # Iterate through the numbers in the adjusted range.\n    for num in range(start, r + 1):\n        if num % 2 != 0:  # Check if the number is odd.\n            total_sum += num\n    \n    return total_sum"}
