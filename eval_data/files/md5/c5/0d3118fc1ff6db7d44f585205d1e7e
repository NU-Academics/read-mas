{"task_id": "Mbpp/293", "solution": "import math\nclass InvalidSideError(ValueError):\n    \"\"\"Custom exception for invalid triangle side inputs.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef otherside_rightangle(side1: float, side2: float) -> float:\n    \"\"\"\n    Calculates the length of the third side of a right-angled triangle.\n    It determines if the known sides are two legs or a leg and the hypotenuse.\n\n    Args:\n        side1: The length of the first known side.\n        side2: The length of the second known side.\n\n    Returns:\n        The length of the third side as a float.\n\n    Raises:\n        InvalidSideError: If side lengths are non-positive, non-numerical,\n                          or geometrically impossible.\n    \"\"\"\n    if not (isinstance(side1, (int, float)) and isinstance(side2, (int, float))):\n        raise InvalidSideError(\"Side lengths must be numerical.\")\n    if side1 <= 0 or side2 <= 0:\n        raise InvalidSideError(\"Side lengths must be positive numbers.\")\n\n    # Assume the largest side is potentially the hypotenuse\n    if side1 == side2:\n        # Could be two legs of an isosceles right triangle, calculate hypotenuse\n        return math.sqrt(side1**2 + side2**2)\n    elif side1 > side2:\n        # Assume side1 is hypotenuse, side2 is a leg\n        if side1**2 - side2**2 <= 0: # Check for impossible triangle (leg >= hypotenuse)\n            raise InvalidSideError(\"Cannot calculate a real leg: hypotenuse must be strictly greater than leg.\")\n        return math.sqrt(side1**2 - side2**2)\n    else: # side2 > side1\n        # Assume side2 is hypotenuse, side1 is a leg\n        if side2**2 - side1**2 <= 0: # Check for impossible triangle (leg >= hypotenuse)\n            raise InvalidSideError(\"Cannot calculate a real leg: hypotenuse must be strictly greater than leg.\")\n        return math.sqrt(side2**2 - side1**2)"}
{"task_id": "Mbpp/294", "solution": "from typing import Any, Union\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input type.\"\"\"\n    def __init__(self, message: str = \"Input must be a list.\"):\n        super().__init__(message)\nclass NoNumericValueError(ValueError):\n    \"\"\"Custom exception for no numeric values found in the list.\"\"\"\n    def __init__(self, message: str = \"No numeric values found in the list.\"):\n        super().__init__(message)\ndef max_val(input_list: list) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list.\n\n    Args:\n        input_list: The list to search through.\n\n    Returns:\n        The maximum numeric value found.\n\n    Raises:\n        InvalidInputError: If input_list is not a list.\n        NoNumericValueError: If no numeric values are found in the list.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise InvalidInputError()\n\n    def _is_numeric(value: Any) -> bool:\n        \"\"\"Checks if a value is an integer or a float, explicitly excluding booleans.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    numeric_values = [\n        value for value in input_list if _is_numeric(value)\n    ]\n\n    if not numeric_values:\n        raise NoNumericValueError()\n\n    return max(numeric_values)"}
{"task_id": "Mbpp/294", "solution": "from typing import List, Union, Any\ndef max_val(input_list: List[Any]) -> Union[int, float, None]:\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list.\n    Returns None if the list is empty or contains no numeric values.\n    \"\"\"\n    max_numeric_value: Union[int, float, None] = None\n\n    for item in input_list:\n        if isinstance(item, (int, float)):\n            if max_numeric_value is None or item > max_numeric_value:\n                max_numeric_value = item\n    return max_numeric_value"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: list[int | float]) -> int:\n    \"\"\"\n    Calculates the number of inversions in an array using a modified merge sort.\n    An inversion is a pair (i, j) such that i < j and arr[i] > arr[j].\n    \"\"\"\n\n    def _merge_and_count(current_arr: list[int | float], left: int, mid: int, right: int) -> int:\n        \"\"\"Merges two sorted sub-arrays and counts inversions between them.\"\"\"\n        temp = []\n        i = left\n        j = mid + 1\n        inversions = 0\n\n        while i <= mid and j <= right:\n            if current_arr[i] <= current_arr[j]:\n                temp.append(current_arr[i])\n                i += 1\n            else:\n                temp.append(current_arr[j])\n                inversions += (mid - i + 1)\n                j += 1\n\n        while i <= mid:\n            temp.append(current_arr[i])\n            i += 1\n\n        while j <= right:\n            temp.append(current_arr[j])\n            j += 1\n\n        for k in range(len(temp)):\n            current_arr[left + k] = temp[k]\n\n        return inversions\n\n    def _merge_sort_and_count(current_arr: list[int | float], left: int, right: int) -> int:\n        \"\"\"Recursively sorts a sub-array and counts total inversions within it.\"\"\"\n        inversions = 0\n        if left < right:\n            mid = (left + right) // 2\n            inversions += _merge_sort_and_count(current_arr, left, mid)\n            inversions += _merge_sort_and_count(current_arr, mid + 1, right)\n            inversions += _merge_and_count(current_arr, left, mid, right)\n        return inversions\n\n    # Create a copy to avoid modifying the original input array.\n    arr_copy = arr[:]\n    \n    # Handle base cases for empty or single-element arrays.\n    if len(arr_copy) < 2:\n        return 0\n\n    return _merge_sort_and_count(arr_copy, 0, len(arr_copy) - 1)"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: list[int]) -> int:\n    \"\"\"Counts inversions in an array using a modified merge sort.\n    An inversion is a pair of indices (i, j) where i < j and arr[i] > arr[j].\n    \"\"\"\n\n    def _merge_sort_and_count(current_arr: list[int]) -> tuple[list[int], int]:\n        n = len(current_arr)\n        if n <= 1:\n            return current_arr, 0\n\n        mid = n // 2\n        left_half, left_inversions = _merge_sort_and_count(current_arr[:mid])\n        right_half, right_inversions = _merge_sort_and_count(current_arr[mid:])\n\n        merged_array, split_inversions = _merge_and_count(left_half, right_half)\n\n        total_inversions = left_inversions + right_inversions + split_inversions\n        return merged_array, total_inversions\n\n    def _merge_and_count(left: list[int], right: list[int]) -> tuple[list[int], int]:\n        merged = []\n        inversions = 0\n        i, j = 0, 0\n        len_left, len_right = len(left), len(right)\n\n        while i < len_left and j < len_right:\n            if left[i] <= right[j]:\n                merged.append(left[i])\n                i += 1\n            else:\n                merged.append(right[j])\n                inversions += (len_left - i)\n                j += 1\n\n        merged.extend(left[i:])\n        merged.extend(right[j:])\n        return merged, inversions\n\n    _, count = _merge_sort_and_count(arr)\n    return count"}
{"task_id": "Mbpp/297", "solution": "from typing import Any\ndef flatten_list(nested_list: list[Any]) -> list[Any]:\n    \"\"\"\n    Flattens a nested list into a single-level list recursively.\n    Elements that are not lists are added directly to the result.\n    \"\"\"\n    result = []\n    for element in nested_list:\n        if isinstance(element, list):\n            result.extend(flatten_list(element))\n        else:\n            result.append(element)\n    return result"}
{"task_id": "Mbpp/299", "solution": "from collections import defaultdict\nfrom typing import List, Tuple, Optional\ndef max_aggregate(data: List[Tuple[str, int]]) -> Tuple[Optional[str], int]:\n    \"\"\"\n    Aggregates scores by name and finds the name with the highest total score.\n    Returns (None, 0) if the input list is empty.\n    \"\"\"\n    if not data:\n        return (None, 0)\n\n    name_scores: defaultdict[str, int] = defaultdict(int)\n    for name, score in data:\n        name_scores[name] += score\n\n    # Find the name with the highest aggregate score.\n    highest_name, highest_score = max(name_scores.items(), key=lambda item: item[1])\n\n    return (highest_name, highest_score)"}
{"task_id": "Mbpp/299", "solution": "import collections\ndef max_aggregate(list_of_tuples: list[tuple[str, int]]) -> tuple[str, int] | None:\n    \"\"\"\n    Calculates the maximum aggregate score from a list of (name, score) tuples.\n    Returns the individual with the highest total score, or None if the input is empty.\n    \"\"\"\n    aggregates = collections.defaultdict(int)\n\n    for name, score in list_of_tuples:\n        aggregates[name] += score\n\n    if not aggregates:\n        return None\n\n    max_name = None\n    max_score = -1 \n\n    for name, total_score in aggregates.items():\n        if total_score > max_score:\n            max_score = total_score\n            max_name = name\n    \n    return (max_name, max_score)"}
{"task_id": "Mbpp/300", "solution": "import math\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Calculates the count of binary sequences of length 2n where the sum of the first n bits\n    is the same as the sum of the last n bits. This is equivalent to C(2n, n).\n    \"\"\"\n    return math.comb(2 * n, n)"}
{"task_id": "Mbpp/297", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the list flattener.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef flatten_list(nested_list: list) -> list:\n    \"\"\"\n    Flattens a given nested list of integers into a single, flat list.\n\n    Args:\n        nested_list: A list that may contain integers or other lists of integers.\n\n    Returns:\n        A new list containing all integer elements from the original nested structure.\n\n    Raises:\n        InvalidInputError: If the input is not a list, or contains elements\n                           that are neither integers nor lists.\n    \"\"\"\n    if not isinstance(nested_list, list):\n        raise InvalidInputError(\"Input must be a list.\")\n\n    result = []\n    for item in nested_list:\n        if isinstance(item, int):\n            result.append(item)\n        elif isinstance(item, list):\n            result.extend(flatten_list(item))  # Recursive call\n        else:\n            raise InvalidInputError(\n                f\"List elements must be integers or lists, but found type {type(item).__name__}.\"\n            )\n    return result"}
{"task_id": "Mbpp/300", "solution": "import math\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Calculates the number of binary sequences of length 2n such that the sum of the first n bits\n    is the same as the sum of the last n bits.\n    This problem is mathematically equivalent to finding the central binomial coefficient C(2n, n).\n\n    Args:\n        n: A non-negative integer representing half the total length of the binary sequence.\n\n    Returns:\n        The total count of such binary sequences.\n\n    Raises:\n        TypeError: If n is not an integer.\n        ValueError: If n is a negative integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer.\")\n\n    # The problem is equivalent to finding the number of ways to choose n items from 2n items,\n    # which is the central binomial coefficient C(2n, n).\n    # This is because for each sequence, if k is the sum of the first n bits,\n    # then k must also be the sum of the last n bits.\n    # The number of ways to get k ones in n bits is C(n, k).\n    # So, we sum (C(n, k) * C(n, k)) for k from 0 to n,\n    # which is a known identity equal to C(2n, n).\n    return math.comb(2 * n, n)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(data: dict) -> int:\n    \"\"\"Calculates the maximum nesting depth of a dictionary. The outermost dictionary is considered depth 1.\"\"\"\n    max_current_depth = 1\n    for value in data.values():\n        if isinstance(value, dict):\n            max_current_depth = max(max_current_depth, 1 + dict_depth(value))\n    return max_current_depth"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(d: dict) -> int:\n    \"\"\"Calculates the maximum nesting depth of a dictionary.\n    The depth of an empty or flat dictionary is 1.\n    \"\"\"\n    if not isinstance(d, dict):\n        raise TypeError(\"Input must be a dictionary.\")\n\n    if not d:\n        return 1\n\n    max_current_depth = 1\n    for value in d.values():\n        if isinstance(value, dict):\n            # Recursively calculate depth of sub-dictionary and add 1 for the current level.\n            current_nested_depth = 1 + dict_depth(value)\n            if current_nested_depth > max_current_depth:\n                max_current_depth = current_nested_depth\n    return max_current_depth"}
{"task_id": "Mbpp/305", "solution": "def start_withp(words_list: list[str]) -> tuple[str | None, str | None]:\n    \"\"\"\n    Extracts the first two words starting with 'p' (case-insensitive)\n    from a given list of strings.\n    \"\"\"\n    p_words_found: list[str] = []\n    for sentence in words_list:\n        words = sentence.split()\n        for word in words:\n            if word.lower().startswith('p'):\n                p_words_found.append(word)\n                if len(p_words_found) == 2:\n                    return (p_words_found[0], p_words_found[1])\n    \n    if len(p_words_found) == 0:\n        return (None, None)\n    # If the loop completes and only one word was found, return it with None.\n    return (p_words_found[0], None)"}
{"task_id": "Mbpp/305", "solution": "def start_withp(words_list: list[str]) -> tuple[str | None, str | None]:\n    \"\"\"\n    Returns the first two words from a list that start with the letter 'p' (case-insensitive).\n    If fewer than two words are found, None fills the missing positions.\n    \"\"\"\n    p_words = []\n    for word in words_list:\n        if word and word[0].lower() == 'p':\n            p_words.append(word)\n        if len(p_words) == 2:\n            break\n    \n    first_word = p_words[0] if len(p_words) > 0 else None\n    second_word = p_words[1] if len(p_words) > 1 else None\n    \n    return (first_word, second_word)"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from arr[0...i] that includes arr[k].\n    All elements from arr[0...i] in the subsequence must be less than arr[k].\n    \"\"\"\n    \n    dp = [0] * (i + 1)\n    max_sum_from_prefix = 0\n\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            dp[j] = arr[j]\n            for x in range(j):\n                if arr[j] > arr[x] and arr[x] < arr[k]:\n                    dp[j] = max(dp[j], arr[j] + dp[x])\n            max_sum_from_prefix = max(max_sum_from_prefix, dp[j])\n    \n    return max_sum_from_prefix + arr[k]"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr, n, i, k):\n    # dp[j] stores the maximum sum of an increasing subsequence ending at arr[j] for j <= i.\n    # This array is calculated based on elements up to index i.\n    dp = [0.0] * (i + 1)\n\n    for j in range(i + 1):\n        dp[j] = float(arr[j]) # Initialize with the element itself.\n        for p in range(j):\n            if arr[j] > arr[p]:\n                dp[j] = max(dp[j], dp[p] + float(arr[j]))\n\n    max_prefix_sum = 0.0\n    # Find the maximum sum from dp[0...i] that can precede arr[k].\n    for j in range(i + 1):\n        if arr[k] > arr[j]:\n            max_prefix_sum = max(max_prefix_sum, dp[j])\n    \n    # The final sum includes max_prefix_sum and arr[k].\n    return max_prefix_sum + float(arr[k])"}
{"task_id": "Mbpp/308", "solution": "def large_product(list1, list2, n):\n    \"\"\"\n    Finds the specified number of largest products from two given lists.\n    This function generates all products, sorts them, and returns the top 'n'.\n    \"\"\"\n    products = []\n    for x in list1:\n        for y in list2:\n            products.append(x * y)\n\n    products.sort(reverse=True)\n    return products[:n]"}
