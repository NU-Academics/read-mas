{"task_id": "Mbpp/128", "solution": "def long_words(n: int, text: str) -> list[str]:\n    \"\"\"\n    Filters a string of words, returning only those words whose length is strictly greater than n.\n    Words are delimited by whitespace, and punctuation is considered part of the word for length calculation.\n\n    Args:\n        n: The minimum length a word must exceed. Must be a non-negative integer.\n        text: The input string containing words, typically space-separated.\n\n    Returns:\n        A list of words from the text that are longer than n characters.\n\n    Raises:\n        TypeError: If n is not an integer or text is not a string.\n        ValueError: If n is a negative integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    if n < 0:\n        raise ValueError(\"n cannot be negative.\")\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a string.\")\n\n    words = text.split()\n    return [word for word in words if len(word) > n]"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"\n    Determines if the given matrix is a magic square.\n\n    A magic square is a square matrix where the sum of the numbers in each row,\n    each column, and both main diagonals are the same.\n\n    Args:\n        matrix: A 2D list of integers representing the square matrix.\n\n    Returns:\n        True if the matrix is a magic square, False otherwise.\n\n    Raises:\n        ValueError: If the input is not a square matrix or contains non-integer elements.\n    \"\"\"\n    # Input Validation: Check if matrix is a list and not empty\n    if not isinstance(matrix, list) or not matrix:\n        raise ValueError(\"Matrix cannot be empty or non-list.\")\n\n    n = len(matrix)\n\n    # Input Validation: Check if it's a square matrix and contains only integers\n    for row in matrix:\n        if not isinstance(row, list) or len(row) != n:\n            raise ValueError(\"Matrix must be square and contain lists as rows.\")\n        for element in row:\n            if not isinstance(element, int):\n                raise ValueError(\"Matrix elements must be integers.\")\n\n    # Calculate the expected sum using the first row's sum\n    expected_sum = sum(matrix[0])\n\n    # Check row sums\n    for row in matrix:\n        if sum(row) != expected_sum:\n            return False\n\n    # Check column sums\n    for c in range(n):\n        col_sum = 0\n        for r in range(n):\n            col_sum += matrix[r][c]\n        if col_sum != expected_sum:\n            return False\n\n    # Check main diagonal sum (top-left to bottom-right)\n    main_diag_sum = 0\n    for i in range(n):\n        main_diag_sum += matrix[i][i]\n    if main_diag_sum != expected_sum:\n        return False\n\n    # Check anti-diagonal sum (top-right to bottom-left)\n    anti_diag_sum = 0\n    for i in range(n):\n        anti_diag_sum += matrix[i][n - 1 - i]\n    if anti_diag_sum != expected_sum:\n        return False\n\n    return True"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(input_list):\n    \"\"\"Finds the item with the maximum frequency in a given list. Returns None if the list is empty, otherwise the first item encountered with max frequency.\"\"\"\n    if not input_list:\n        return None\n\n    counts = {}\n    for item in input_list:\n        counts[item] = counts.get(item, 0) + 1\n\n    max_item = None\n    max_count = -1\n\n    for item in input_list:\n        current_count = counts[item]\n        if current_count > max_count:\n            max_count = current_count\n            max_item = item\n    \n    return max_item"}
{"task_id": "Mbpp/130", "solution": "from collections import Counter\ndef max_occurrences(data_list):\n    \"\"\"\n    Finds and returns the item with the highest frequency in the given list.\n\n    Args:\n        data_list: A list of items (can be of any hashable type).\n\n    Returns:\n        The item from data_list that appears most frequently.\n        If there's a tie, the item encountered first during frequency counting is returned.\n\n    Raises:\n        ValueError: If the input list is empty.\n    \"\"\"\n    if not data_list:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    # Use collections.Counter for efficient frequency counting\n    counts = Counter(data_list)\n\n    # Find the item(s) with the maximum frequency\n    max_count = 0\n    max_item = None\n\n    # Iterate through items and their counts to find the max_item\n    # This implicitly handles ties by returning the first item encountered\n    # with the maximum count.\n    for item, count in counts.items():\n        if count > max_count:\n            max_count = count\n            max_item = item\n    \n    return max_item"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    # Reverses the order of vowels in the input string s while keeping consonants and their positions unchanged.\n    # 'y' is treated as a consonant; only 'a', 'e', 'i', 'o', 'u' (case-insensitive) are considered vowels.\n    vowels_set = {'a', 'e', 'i', 'o', 'u'}\n    s_list = list(s)\n    vowel_indices = []\n    vowels_found = []\n\n    for i, char in enumerate(s_list):\n        if char.lower() in vowels_set:\n            vowel_indices.append(i)\n            vowels_found.append(char)\n\n    vowels_found.reverse()\n\n    for i, original_index in enumerate(vowel_indices):\n        s_list[original_index] = vowels_found[i]\n\n    return \"\".join(s_list)"}
{"task_id": "Mbpp/131", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u'}\ndef reverse_vowels(s: str) -> str:\n    \"\"\"Reverses only the vowels in the input string, treating 'y' as a consonant.\"\"\"\n    s_list = list(s)\n    vowel_indices = []\n    vowels_found = []\n\n    for i, char in enumerate(s_list):\n        if char.lower() in VOWELS:\n            vowel_indices.append(i)\n            vowels_found.append(char)\n\n    vowels_found.reverse()\n\n    for i, vowel_char in zip(vowel_indices, vowels_found):\n        s_list[i] = vowel_char\n\n    return \"\".join(s_list)"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"Checks if a given 2D list represents a magic square.\n    A magic square has equal sums for all rows, columns, and both main diagonals.\n    \"\"\"\n    if not matrix:\n        return False\n\n    size = len(matrix)\n    \n    # Check if matrix is square and not ragged.\n    # If not square or ragged, it cannot be a magic square.\n    for row in matrix:\n        if len(row) != size:\n            return False\n\n    magic_sum = sum(matrix[0])\n\n    # Check row sums\n    for row in matrix:\n        if sum(row) != magic_sum:\n            return False\n\n    # Check column sums\n    for col_idx in range(size):\n        col_sum = 0\n        for row_idx in range(size):\n            col_sum += matrix[row_idx][col_idx]\n        if col_sum != magic_sum:\n            return False\n\n    # Check main diagonal sum (top-left to bottom-right)\n    diag1_sum = 0\n    for i in range(size):\n        diag1_sum += matrix[i][i]\n    if diag1_sum != magic_sum:\n        return False\n\n    # Check anti-diagonal sum (top-right to bottom-left)\n    diag2_sum = 0\n    for i in range(size):\n        diag2_sum += matrix[i][size - 1 - i]\n    if diag2_sum != magic_sum:\n        return False\n\n    return True"}
