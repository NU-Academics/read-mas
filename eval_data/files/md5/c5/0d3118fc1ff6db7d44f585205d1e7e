{"task_id": "Mbpp/468", "solution": "def max_product(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum product of an increasing subsequence within the array.\n    Uses dynamic programming to handle both positive and negative numbers effectively.\n    \"\"\"\n    # Input Validation\n    if not isinstance(arr, list):\n        raise ValueError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise ValueError(\"All elements in the input list must be integers.\")\n\n    n = len(arr)\n    if n == 0:\n        return 0\n\n    # max_ending_here[i] stores the max product of an increasing subsequence ending with arr[i].\n    max_ending_here = [0] * n\n    # min_ending_here[i] stores the min product, important for negative numbers.\n    min_ending_here = [0] * n\n    max_overall_product = float('-inf')\n\n    for i in range(n):\n        max_ending_here[i] = arr[i]\n        min_ending_here[i] = arr[i]\n\n        for j in range(i):\n            if arr[i] > arr[j]:\n                if arr[i] >= 0:\n                    max_ending_here[i] = max(max_ending_here[i], max_ending_here[j] * arr[i])\n                    min_ending_here[i] = min(min_ending_here[i], min_ending_here[j] * arr[i])\n                else:  # arr[i] < 0\n                    max_ending_here[i] = max(max_ending_here[i], min_ending_here[j] * arr[i])\n                    min_ending_here[i] = min(min_ending_here[i], max_ending_here[j] * arr[i])\n        \n        max_overall_product = max(max_overall_product, max_ending_here[i])\n\n    return max_overall_product"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(numbers):\n    \"\"\"\n    Checks if a list of numbers contains consecutive integers.\n    Assumes input is a list of integers and does not perform validation.\n    \"\"\"\n    if not numbers or len(numbers) == 1:\n        return True\n\n    # If the list contains duplicates, it's not strictly consecutive as per design.\n    if len(numbers) != len(set(numbers)):\n        return False\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(len(sorted_numbers) - 1):\n        if sorted_numbers[i+1] != sorted_numbers[i] + 1:\n            return False\n    return True"}
{"task_id": "Mbpp/473", "solution": "def normalize_tuple(t: tuple) -> tuple:\n    \"\"\"\n    Sorts elements within a tuple to create a canonical representation.\n    Assumes all elements in the tuple are comparable.\n    \"\"\"\n    return tuple(sorted(t))\ndef tuple_intersection(list1: list[tuple], list2: list[tuple]) -> set[tuple]:\n    \"\"\"\n    Finds the intersection of two lists of tuples, ignoring the order of elements within each tuple.\n    Tuples are normalized by sorting their elements before comparison.\n    \"\"\"\n    normalized_set1 = set()\n    for t in list1:\n        normalized_set1.add(normalize_tuple(t))\n\n    normalized_set2 = set()\n    for t in list2:\n        normalized_set2.add(normalize_tuple(t))\n\n    return normalized_set1.intersection(normalized_set2)"}
{"task_id": "Mbpp/473", "solution": "def tuple_intersection(list1, list2):\n    \"\"\"\n    Finds the intersection of two lists of 2-element tuples,\n    treating tuples as equivalent if their elements are the same regardless of order.\n    \"\"\"\n    normalized_set1 = set()\n    for tup in list1:\n        normalized_set1.add(tuple(sorted(tup)))\n\n    normalized_set2 = set()\n    for tup in list2:\n        normalized_set2.add(tuple(sorted(tup)))\n\n    return normalized_set1.intersection(normalized_set2)"}
