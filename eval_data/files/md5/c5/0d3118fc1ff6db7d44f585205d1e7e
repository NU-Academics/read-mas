{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Calculates the maximum contiguous subarray sum in an array repeated k times.\n    This function efficiently handles repetitions without constructing the full array.\n    \"\"\"\n\n    def _kadane(local_arr: list[int]) -> int:\n        \"\"\"Applies Kadane's algorithm to find the maximum subarray sum in a single array.\"\"\"\n        max_so_far = float('-inf')\n        current_max = 0\n        for x in local_arr:\n            current_max += x\n            max_so_far = max(max_so_far, current_max)\n            if current_max < 0:\n                current_max = 0\n        # If all numbers are negative, current_max would reset to 0,\n        # and max_so_far would be 0 if all sums were negative.\n        # In this scenario, the largest sum is the single largest negative number.\n        # Kadane's with float('-inf') handles this if max_so_far is updated properly.\n        # If all elements are negative and max_so_far is still -inf or 0 (if initialized to 0),\n        # then we need to ensure the max element is returned.\n        # The design's example Kadane handles this more robustly with the `if max_so_far == 0 and any(x < 0 for x in arr): return max(arr)` part.\n        # Re-implementing _kadane to be more robust for all negative numbers.\n        if not local_arr:\n            return 0 # Or a sentinel for error, but problem implies non-empty.\n\n        max_so_far = local_arr[0]\n        current_max = local_arr[0]\n\n        for i in range(1, len(local_arr)):\n            current_max = max(local_arr[i], current_max + local_arr[i])\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n\n    def _max_prefix_sum(local_arr: list[int]) -> int:\n        \"\"\"Calculates the maximum prefix sum of the given array.\"\"\"\n        if not local_arr:\n            return 0 # Should not happen based on constraints\n\n        max_prefix = local_arr[0]\n        current_sum = local_arr[0]\n        for i in range(1, len(local_arr)):\n            current_sum += local_arr[i]\n            max_prefix = max(max_prefix, current_sum)\n        return max_prefix\n\n    def _max_suffix_sum(local_arr: list[int]) -> int:\n        \"\"\"Calculates the maximum suffix sum of the given array.\"\"\"\n        if not local_arr:\n            return 0 # Should not happen based on constraints\n\n        max_suffix = local_arr[-1]\n        current_sum = local_arr[-1]\n        for i in range(len(local_arr) - 2, -1, -1):\n            current_sum += local_arr[i]\n            max_suffix = max(max_suffix, current_sum)\n        return max_suffix\n\n    def _total_sum(local_arr: list[int]) -> int:\n        \"\"\"Calculates the total sum of all elements in the given array.\"\"\"\n        return sum(local_arr)\n\n    # Trust caller's inputs: arr is non-empty, k >= 1.\n    # The design document suggested input validation (empty arr or k < 1),\n    # but for a bare function, and based on the problem's assert, we assume valid inputs.\n    \n    # Case 1: k = 1 (standard Kadane's algorithm on the original array)\n    if k == 1:\n        return _kadane(arr)\n\n    # Case 2: k > 1\n    # Max sum can be within a single repetition, or span across repetitions.\n    kadane_sum = _kadane(arr)\n    prefix_sum = _max_prefix_sum(arr)\n    suffix_sum = _max_suffix_sum(arr)\n    total_arr_sum = _total_sum(arr)\n\n    if total_arr_sum < 0:\n        # If the total sum is negative, repeating the array further won't increase the sum.\n        # Max sum comes from either a single array (kadane_sum) or spanning two repetitions (prefix + suffix).\n        return max(kadane_sum, prefix_sum + suffix_sum)\n    else:\n        # If total sum is non-negative, repeating the array adds to the sum.\n        # Max sum can be a single array, or prefix + (k-2)*total + suffix.\n        # (k-2) is used because prefix_sum and suffix_sum account for parts of two arrays,\n        # and total_arr_sum represents the sum of the full arrays in between.\n        return max(kadane_sum, prefix_sum + suffix_sum + (k - 2) * total_arr_sum)"}
