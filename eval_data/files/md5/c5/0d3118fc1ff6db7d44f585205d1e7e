{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two integer numbers differ by exactly one bit.\n    This is determined by checking if their XOR result is a power of two.\n    \"\"\"\n    xor_result = num1 ^ num2\n    return xor_result > 0 and (xor_result & (xor_result - 1)) == 0"}
{"task_id": "Mbpp/4", "solution": "import heapq\ndef heap_queue_largest(data_list: list[int | float], n: int) -> list[int | float]:\n    \"\"\"Finds the n largest numbers from a list using a min-heap. Returns them in descending order.\"\"\"\n    if n == 0 or not data_list:\n        return []\n\n    if n >= len(data_list):\n        # If n is greater than or equal to the list length, return all elements sorted descending.\n        return sorted(data_list, reverse=True)\n\n    # Use a min-heap to keep track of the n largest elements.\n    min_heap = []\n    for item in data_list:\n        if len(min_heap) < n:\n            heapq.heappush(min_heap, item)\n        elif item > min_heap[0]:\n            heapq.heapreplace(min_heap, item)\n\n    # The heap now contains the n largest elements.\n    # Pop them all and sort in descending order.\n    result = [heapq.heappop(min_heap) for _ in range(len(min_heap))]\n    return sorted(result, reverse=True)"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"Checks if two integer numbers differ by exactly one bit position.\"\"\"\n    xor_result = num1 ^ num2\n    if xor_result == 0:\n        return False\n\n    return (xor_result & (xor_result - 1)) == 0"}
