{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers: list[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list whose bitwise XOR sum is even.\n    An XOR sum (a ^ b) is even if 'a' and 'b' have the same parity.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for num in numbers:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # Calculate pairs from even numbers (C(n, 2) = n * (n - 1) / 2)\n    count = (even_count * (even_count - 1)) // 2\n    # Add pairs from odd numbers\n    count += (odd_count * (odd_count - 1)) // 2\n\n    return count"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    This method uses a fast bitwise algorithm.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    n -= 1\n    n |= n >> 1\n    n |= n >> 2\n    n |= n >> 4\n    n |= n >> 8\n    n |= n >> 16\n    return n + 1"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(data: list[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list that XOR to an even number.\n    This occurs when both integers have the same parity.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for num in data:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    pairs_even_even = even_count * (even_count - 1) // 2\n    pairs_odd_odd = odd_count * (odd_count - 1) // 2\n\n    return pairs_even_even + pairs_odd_odd"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n using bitwise operations.\n    This algorithm executes in O(1) time complexity.\n    \"\"\"\n    if n <= 0:\n        return 1\n\n    # Decrement n by 1 to correctly handle cases where n is already a power of 2.\n    n -= 1\n\n    # Set all bits to the right of the most significant bit.\n    # This transforms n into the largest number with all bits set, smaller than the actual power of 2.\n    n |= n >> 1\n    n |= n >> 2\n    n |= n >> 4\n    n |= n >> 8\n    n |= n >> 16\n    n |= n >> 32 # Covers up to 64-bit integers.\n\n    # Add 1 to get the next power of 2.\n    return n + 1"}
