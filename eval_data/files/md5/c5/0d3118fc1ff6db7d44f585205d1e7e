{"task_id": "Mbpp/607", "solution": "import re\ndef find_literals(text: str, pattern: str) -> tuple[str | None, int, int]:\n    \"\"\"\n    Searches for the first occurrence of a regex pattern in a string.\n    Returns the match, its start, and end indices, or (None, -1, -1) if no match.\n    \"\"\"\n    compiled_pattern = re.compile(pattern)\n    match = compiled_pattern.search(text)\n\n    if match:\n        return match.group(0), match.start(), match.end()\n    else:\n        return None, -1, -1"}
{"task_id": "Mbpp/607", "solution": "import re\nclass PatternNotFoundError(Exception):\n    \"\"\"\n    Custom exception raised when a specified pattern is not found in the text.\n    \"\"\"\n    def __init__(self, message: str = \"Pattern not found in the text.\"):\n        super().__init__(message)\ndef find_literals(text: str, pattern: str) -> tuple[str, int, int]:\n    \"\"\"\n    Public API function to search a string for a literal pattern.\n\n    Args:\n        text: The string to search within.\n        pattern: The literal string pattern to search for.\n\n    Returns:\n        A tuple containing the matched substring, its start index, and its end index (exclusive).\n\n    Raises:\n        PatternNotFoundError: If the pattern is not found in the text.\n    \"\"\"\n    escaped_pattern = re.escape(pattern)\n    match = re.search(escaped_pattern, text)\n    if match:\n        return match.group(0), match.start(), match.end()\n    raise PatternNotFoundError(f\"Literal pattern '{pattern}' not found in the text.\")"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"Calculates the nth Bell number using dynamic programming. Assumes n is a non-negative integer.\"\"\"\n    if n == 0:\n        return 1\n\n    # Create a DP table to store Stirling numbers of the second kind S(i, j).\n    # S(i, j) counts partitions of i elements into j non-empty subsets.\n    bell_dp = [[0 for _ in range(n + 1)] for _ in range(n + 1)]\n\n    # Fill the DP table using the recurrence S(i, j) = S(i-1, j-1) + j * S(i-1, j).\n    for i in range(1, n + 1):\n        bell_dp[i][i] = 1  # Base case: S(i, i) = 1.\n        for j in range(1, i):\n            bell_dp[i][j] = bell_dp[i-1][j-1] + j * bell_dp[i-1][j]\n\n    # The nth Bell number is the sum of S(n, k) for k from 1 to n.\n    total_bell_number = 0\n    for k in range(1, n + 1):\n        total_bell_number += bell_dp[n][k]\n\n    return total_bell_number"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"Calculates the nth Bell number using dynamic programming.\n    This implementation assumes 'n' is a non-negative integer.\"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize a 2D array for Stirling numbers of the second kind (Bell triangle).\n    # bell_triangle[i][j] stores S(i, j).\n    bell_triangle = [[0 for _ in range(n + 1)] for _ in range(n + 1)]\n\n    # Base case for Stirling numbers of the second kind: S(0, 0) = 1.\n    bell_triangle[0][0] = 1\n\n    for i in range(1, n + 1):\n        # S(i, 0) is 0 for i > 0.\n        bell_triangle[i][0] = 0\n        for j in range(1, i + 1):\n            # Recurrence relation: S(i, j) = S(i-1, j-1) + j * S(i-1, j).\n            bell_triangle[i][j] = bell_triangle[i-1][j-1] + j * bell_triangle[i-1][j]\n\n    # The nth Bell number is the sum of S(n, k) for k from 0 to n.\n    nth_bell_number = sum(bell_triangle[n][k] for k in range(n + 1))\n    return nth_bell_number"}
{"task_id": "Mbpp/610", "solution": "from typing import List\nclass ListUtilsError(Exception):\n    \"\"\"Base exception for list_utils errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass InvalidInputTypeError(ListUtilsError):\n    \"\"\"Raised when an input argument has an incorrect type.\"\"\"\n    pass\nclass IndexOutOfBoundsError(ListUtilsError):\n    \"\"\"Raised when an index is out of bounds for the list.\"\"\"\n    pass\ndef remove_kth_element(input_list: List, k: int) -> List:\n    \"\"\"\n    Returns a new list with the k'th element removed (1-based indexing for k).\n    The original list remains unchanged.\n\n    Args:\n        input_list: The original list.\n        k: The 1-based index of the element to remove.\n\n    Returns:\n        A new list with the k'th element removed.\n\n    Raises:\n        InvalidInputTypeError: If input_list is not a list or k is not an integer.\n        IndexOutOfBoundsError: If k is out of bounds for the input_list (1-based).\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise InvalidInputTypeError(\"input_list must be a list.\")\n    if not isinstance(k, int):\n        raise InvalidInputTypeError(\"k must be an integer.\")\n\n    # Adjust k for 0-based indexing from the problem's 1-based indexing\n    k_0_based = k - 1\n\n    if not (0 <= k_0_based < len(input_list)):\n        raise IndexOutOfBoundsError(f\"Index {k} (1-based) is out of bounds for list of length {len(input_list)}.\")\n\n    return input_list[:k_0_based] + input_list[k_0_based+1:]"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"\n    Removes the k'th element (1-indexed) from a list and returns a new list.\n    The original list is not modified.\n    \"\"\"\n    index_to_remove = k - 1\n    new_list = input_list[:index_to_remove] + input_list[index_to_remove + 1:]\n    return new_list"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix: list[list[float]], n: int) -> float:\n    \"\"\"Finds the maximum value in the specified column of the input matrix.\n    Assumes valid, non-empty, rectangular matrix with numeric elements and an in-bounds index.\n    \"\"\"\n    max_value = float('-inf')\n    for row in matrix:\n        value = row[n]\n        if value > max_value:\n            max_value = value\n    return max_value"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix, n):\n    \"\"\"\n    Finds the maximum value in the specified Nth column of a matrix.\n    Assumes valid matrix and column index N are provided by the caller.\n    \"\"\"\n    max_val = float('-inf')\n    for row in matrix:\n        # Trusting the caller's input, so no explicit bounds check for 'n'.\n        max_val = max(max_val, row[n])\n    return max_val"}
{"task_id": "Mbpp/612", "solution": "from typing import Any\ndef merge(data: list[list[Any]]) -> list[list[Any]]:\n    \"\"\"\n    Separates paired data elements into two distinct collections.\n    The first list contains all first elements, the second all second elements.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n\n    for sublist in data:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n\n    return [first_elements, second_elements]"}
