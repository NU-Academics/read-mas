{"task_id": "Mbpp/119", "solution": "def search(arr: list[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array.\n    All other elements appear exactly twice.\n    \"\"\"\n    low, high = 0, len(arr) - 1\n    while low < high:\n        mid = (low + high) // 2\n        \n        # If mid is even, compare with next element.\n        # If mid is odd, compare with previous element.\n        if (mid % 2 == 0 and arr[mid] == arr[mid + 1]) or \\\n           (mid % 2 == 1 and arr[mid] == arr[mid - 1]):\n            low = mid + 1 # Unique element is to the right.\n        else:\n            high = mid    # Unique element is at mid or to the left.\n\n    return arr[low]"}
{"task_id": "Mbpp/119", "solution": "def search(arr: list[int]) -> int:\n    \"\"\"\n    Finds the single unique element in a sorted array where all other elements appear twice.\n    Assumes the input array adheres strictly to the problem's constraints.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n\n    while low <= high:\n        mid = (low + high) // 2\n\n        # If mid is not the first or last element, and its value is different from its neighbors,\n        # it is the unique element. This check is primarily for the final convergence.\n        if (mid == 0 or arr[mid] != arr[mid - 1]) and \\\n           (mid == len(arr) - 1 or arr[mid] != arr[mid + 1]):\n            return arr[mid]\n\n        # Use XOR to find the paired index (mid^1 gives mid+1 if mid is even, mid-1 if mid is odd)\n        # If arr[mid] matches its paired element arr[mid^1], it means the unique element\n        # is to the right of this pair.\n        if arr[mid] == arr[mid ^ 1]:\n            low = max(mid, mid ^ 1) + 1\n        else:\n            # If arr[mid] does not match its paired element, the unique element is at or\n            # to the left of the current 'mid'.\n            high = mid - 1\n\n    # This line should ideally not be reached if the input array always contains a unique element\n    # and strictly follows the specified pattern.\n    return -1 # Fallback, though problem constraints imply a unique element is always found."}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(data: list[tuple[int | float, int | float]]) -> int | float:\n    \"\"\"Calculates the maximum absolute product of numbers within tuples in a given list.\n    Returns 0 if the input list is empty.\n    \"\"\"\n    if not data:\n        return 0\n\n    max_abs_product = 0.0\n\n    for item_tuple in data:\n        # Trusting caller's input: item_tuple is a tuple of exactly two numbers (int or float).\n        num1, num2 = item_tuple\n        \n        product = num1 * num2\n        abs_product = abs(product)\n        \n        if abs_product > max_abs_product:\n            max_abs_product = abs_product\n    \n    return max_abs_product"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(data: list[tuple[int | float, int | float]]) -> int | float:\n    \"\"\"\n    Calculates the maximum absolute product from pairs of numbers within a list of tuples.\n    Returns 0 if the input list is empty.\n    \"\"\"\n    if not data:\n        return 0\n\n    max_abs_product = 0.0\n    for item in data:\n        num1, num2 = item\n        current_product = num1 * num2\n        max_abs_product = max(max_abs_product, abs(current_product))\n    \n    if max_abs_product == int(max_abs_product):\n        return int(max_abs_product)\n    return max_abs_product"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(limit: int) -> int:\n    \"\"\"Calculates the sum of all amicable numbers up to the specified limit.\"\"\"\n\n    def sum_proper_divisors(n: int) -> int:\n        \"\"\"Calculates the sum of proper divisors for a given number.\"\"\"\n        if n == 1:\n            return 0\n        \n        s = 1 # 1 is always a proper divisor\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                s += i\n                if i * i != n:\n                    s += n // i\n        return s\n\n    total_amicable_sum = 0\n    found_amicable_numbers = set()\n\n    for a in range(1, limit + 1):\n        if a in found_amicable_numbers:\n            continue\n\n        sum_div_a = sum_proper_divisors(a)\n\n        if sum_div_a > a and sum_div_a <= limit:\n            sum_div_b = sum_proper_divisors(sum_div_a)\n            if sum_div_b == a:\n                # Found an amicable pair (a, sum_div_a)\n                total_amicable_sum += a\n                total_amicable_sum += sum_div_a\n                found_amicable_numbers.add(a)\n                found_amicable_numbers.add(sum_div_a)\n    return total_amicable_sum"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(number: int) -> int:\n    \"\"\"\n    Sums all amicable numbers from 1 up to the specified limit.\n    It uses a helper function to find proper divisors efficiently.\n    \"\"\"\n\n    def _sum_proper_divisors(n: int) -> int:\n        \"\"\"Calculates the sum of proper divisors for a given positive integer.\"\"\"\n        total = 1  # 1 is always a proper divisor\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                total += i\n                if i * i != n:\n                    total += n // i\n        return total\n\n    total_amicable_sum = 0\n    found_amicable_numbers = set()\n\n    for num in range(1, number + 1):\n        if num in found_amicable_numbers:\n            continue\n\n        sum_divisors_num = _sum_proper_divisors(num)\n\n        # To find amicable pairs (a, b), we look for b = sum_proper_divisors(a)\n        # and a = sum_proper_divisors(b).\n        # We only consider cases where sum_divisors_num > num to avoid redundant checks\n        # and to ensure num is not a perfect number (sum_divisors_num == num).\n        # Also, sum_divisors_num must be within the limit for the pair to be fully considered.\n        if sum_divisors_num > num and sum_divisors_num <= number:\n            sum_divisors_of_sum = _sum_proper_divisors(sum_divisors_num)\n\n            if sum_divisors_of_sum == num:\n                # Found an amicable pair (num, sum_divisors_num)\n                total_amicable_sum += num\n                total_amicable_sum += sum_divisors_num\n                found_amicable_numbers.add(num)\n                found_amicable_numbers.add(sum_divisors_num)\n    \n    return total_amicable_sum"}
{"task_id": "Mbpp/124", "solution": "import cmath\ndef angle_complex(real: float, imag: complex) -> float:\n    \"\"\"\n    Calculates the argument (angle) of a complex number given its real and imaginary parts.\n\n    Args:\n        real: The real part of the complex number.\n        imag: The imaginary part of the complex number (can be a complex number like 1j).\n\n    Returns:\n        The angle of the complex number in radians, in the range (-pi, pi].\n    \"\"\"\n    # Ensure imag is treated as a numeric value for constructing the complex number\n    if isinstance(imag, complex):\n        z = complex(real, imag.imag)\n    else:\n        z = complex(real, imag)\n    return cmath.phase(z)"}
