{"task_id": "Mbpp/93", "solution": "def power(a, b):\n    \"\"\"\n    Calculates 'a' raised to the power of 'b'.\n    Handles non-negative and negative integer exponents.\n    \"\"\"\n    if b == 0:\n        return 1\n\n    is_negative_exponent = False\n    if b < 0:\n        is_negative_exponent = True\n        b = -b\n\n    result = 1\n    for _ in range(b):\n        result *= a\n    \n    if is_negative_exponent:\n        return 1 / result\n    else:\n        return result"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if a number is undulating, meaning it has at least three digits\n    and strictly alternates between two distinct digits.\n    \"\"\"\n    s_number = str(number)\n    n = len(s_number)\n\n    if n < 3:\n        return False\n\n    # Identify the first two distinct digits.\n    digit1 = s_number[0]\n    digit2 = None\n    for i in range(1, n):\n        if s_number[i] != digit1:\n            digit2 = s_number[i]\n            break\n    \n    # If only one distinct digit or less than two distinct digits found, it's not undulating.\n    if digit2 is None:\n        return False\n\n    # Check for the alternating pattern using the identified two digits.\n    for i in range(n):\n        if i % 2 == 0:  # Even index should match digit1\n            if s_number[i] != digit1:\n                return False\n        else:  # Odd index should match digit2\n            if s_number[i] != digit2:\n                return False\n    \n    return True"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(data_list: list[tuple]) -> any:\n    \"\"\"\n    Finds the first element of the tuple with the smallest second value in a list of tuples.\n    Assumes `data_list` is a non-empty list of tuples, each with at least two comparable elements.\n    \"\"\"\n    min_val = float('inf')\n    result = None\n\n    for item in data_list:\n        current_second_val = item[1]\n        if current_second_val < min_val:\n            min_val = current_second_val\n            result = item[0]\n    return result"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(data: list[tuple]) -> any:\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple\n    with the smallest second value.\n\n    Args:\n        data: A list of tuples. Each tuple must contain at least two elements,\n              and the second element must be comparable.\n\n    Returns:\n        The first value (index 0) of the tuple with the smallest second value.\n\n    Raises:\n        TypeError: If input is not a list, or elements are not tuples,\n                   or second elements are not comparable.\n        ValueError: If the list is empty, or tuples have fewer than two elements.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input must be a list.\")\n    if not data:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    min_val = None\n    result_first_val = None\n\n    for i, item in enumerate(data):\n        if not isinstance(item, tuple):\n            raise TypeError(f\"Element at index {i} is not a tuple.\")\n        if len(item) < 2:\n            raise ValueError(f\"Tuple at index {i} must contain at least two elements.\")\n\n        current_second_val = item[1]\n        current_first_val = item[0]\n\n        if min_val is None:\n            min_val = current_second_val\n            result_first_val = current_first_val\n        else:\n            try:\n                if current_second_val < min_val:\n                    min_val = current_second_val\n                    result_first_val = current_first_val\n            except TypeError:\n                raise TypeError(\"Second element of tuples must be comparable.\")\n\n    return result_first_val"}
