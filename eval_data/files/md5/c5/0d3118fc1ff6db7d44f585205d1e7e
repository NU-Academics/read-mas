{"task_id": "Mbpp/590", "solution": "import math\ndef polar_rect(r: float, theta: float) -> tuple[float, float]:\n    \"\"\"\n    Converts polar coordinates (radius, angle) to rectangular coordinates (x, y).\n\n    Args:\n        r: The radial distance from the origin (radius).\n        theta: The angle in radians from the positive x-axis.\n\n    Returns:\n        A tuple (x, y) representing the rectangular coordinates.\n    \"\"\"\n    x = r * math.cos(theta)\n    y = r * math.sin(theta)\n    return (x, y)"}
{"task_id": "Mbpp/592", "solution": "import math\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the product of consecutive binomial coefficients C(n, k) * C(n, k+1) for k from 0 to n-1.\n    This is efficiently computed using the identity C(2n, n+1).\n\n    Args:\n        n (int): The 'n' value for the binomial coefficients.\n\n    Returns:\n        int: The sum of the products.\n\n    Raises:\n        TypeError: If n is not an integer.\n        ValueError: If n is a negative integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer.\")\n\n    # The sum of C(n, k) * C(n, k+1) for k from 0 to n-1\n    # is equal to C(2n, n+1).\n    # math.comb handles the binomial coefficient calculation, returning 0 if the combination is invalid.\n    return math.comb(2 * n, n + 1)"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip_address_str: str) -> str:\n    \"\"\"Removes leading zeros from each octet of an IP address string.\n    This function processes each octet by converting it to an integer and back to a string.\n    \"\"\"\n    octets = ip_address_str.split('.')\n    normalized_octets = []\n    for octet_str in octets:\n        normalized_octets.append(str(int(octet_str)))\n    return \".\".join(normalized_octets)"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers: list[int | float]) -> int | float:\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if num % 2 == 0 and first_even is None:\n            first_even = num\n        elif num % 2 != 0 and first_odd is None:\n            first_odd = num\n            \n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is None or first_odd is None:\n        return 0\n    else:\n        return abs(first_even - first_odd)"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip_address):\n    \"\"\"\n    Normalizes an IP address string by removing leading zeros from each octet.\n    Each octet is converted to an integer and back to a string, then re-joined.\n    \"\"\"\n    octets = ip_address.split('.')\n    processed_octets = [str(int(octet_str)) for octet_str in octets]\n    return \".\".join(processed_octets)"}
