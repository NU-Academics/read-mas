{"task_id": "Mbpp/460", "solution": "from typing import Any, List\ndef Extract(data: List[List[Any]]) -> List[Any]:\n    \"\"\"\n    Extracts the first element from each sublist within the input data.\n\n    Args:\n        data: A list where each element is expected to be another list.\n\n    Returns:\n        A new list containing the first elements of each sublist.\n\n    Raises:\n        TypeError: If data is not a list or if any element within data is not a list.\n        ValueError: If any sublist within data is empty.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input 'data' must be a list.\")\n\n    result = []\n    for i, sublist in enumerate(data):\n        if not isinstance(sublist, list):\n            raise TypeError(f\"Element at index {i} is not a list: {type(sublist)}\")\n        if not sublist:\n            raise ValueError(f\"Sublist at index {i} is empty, cannot extract first element.\")\n        result.append(sublist[0])\n    return result"}
{"task_id": "Mbpp/462", "solution": "def combinations_list(items: list) -> list[list]:\n    \"\"\"\n    Generates all possible combinations (subsets) of elements from the input list.\n    The empty list `[]` is always included, and combinations are returned in a specific order.\n    \"\"\"\n    all_combinations = [[]]\n\n    for item in items:\n        new_combinations = []\n        for combo in all_combinations:\n            new_combinations.append([item] + combo)\n        all_combinations.extend(new_combinations)\n    \n    return all_combinations"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(nums: list[int]) -> int:\n    \"\"\"Calculates the maximum product of a contiguous subarray.\n    Handles empty arrays, single elements, negative numbers, and zeros efficiently.\n    \"\"\"\n    if not nums:\n        return 0\n    \n    # Handle the case where the array contains only one element.\n    if len(nums) == 1:\n        return nums[0]\n\n    max_so_far = nums[0]\n    min_so_far = nums[0]\n    result = nums[0]\n\n    for i in range(1, len(nums)):\n        curr = nums[i]\n        \n        # If current number is negative, swap max_so_far and min_so_far.\n        # This is because a negative number can turn a minimum product into a maximum product.\n        if curr < 0:\n            max_so_far, min_so_far = min_so_far, max_so_far\n        \n        max_so_far = max(curr, max_so_far * curr)\n        min_so_far = min(curr, min_so_far * curr)\n        \n        # The overall result is the maximum product found so far.\n        result = max(result, max_so_far)\n            \n    return result"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(arr: list[int]) -> int:\n    \"\"\"Calculates the maximum product of a contiguous subarray within a given array of integers.\n    Handles positive, negative, and zero values, returning 0 for an empty array.\"\"\"\n\n    if not arr:\n        return 0\n\n    max_so_far = arr[0]\n    min_so_far = arr[0]\n    result = max_so_far\n\n    for i in range(1, len(arr)):\n        curr = arr[i]\n        # Temporarily store max_so_far before it's updated for correct min_so_far calculation.\n        temp_max = max(curr, max_so_far * curr, min_so_far * curr)\n        min_so_far = min(curr, max_so_far * curr, min_so_far * curr)\n\n        max_so_far = temp_max\n\n        result = max(max_so_far, result)\n\n    return result"}
