{"task_id": "Mbpp/597", "solution": "def find_kth(arr1: list[int], arr2: list[int], k: int) -> int:\n    \"\"\"Finds the kth smallest element from two sorted arrays.\n    This function uses a recursive binary search approach for O(log(min(m, n))) comparison complexity.\"\"\"\n    m, n = len(arr1), len(arr2)\n\n    # Ensure arr1 is the shorter array to optimize partition calculation.\n    if m > n:\n        return find_kth(arr2, arr1, k)\n\n    # Base case: if arr1 is empty, the kth element must be in arr2.\n    if m == 0:\n        return arr2[k - 1]\n\n    # Base case: if k is 1, return the minimum of the first elements.\n    if k == 1:\n        return min(arr1[0], arr2[0])\n\n    # Divide k into two parts.\n    # pa is the partition point in arr1, at most k/2 elements.\n    pa = min(k // 2, m)\n    # pb is the partition point in arr2.\n    pb = k - pa\n\n    # Compare elements at the partition points.\n    if arr1[pa - 1] < arr2[pb - 1]:\n        # Discard pa elements from arr1 and search for the (k - pa)th element.\n        return find_kth(arr1[pa:], arr2, k - pa)\n    elif arr1[pa - 1] > arr2[pb - 1]:\n        # Discard pb elements from arr2 and search for the (k - pb)th element.\n        return find_kth(arr1, arr2[pb:], k - pb)\n    else:\n        # If elements are equal, we found the kth element.\n        return arr1[pa - 1]"}
{"task_id": "Mbpp/597", "solution": "def find_kth(arr1: list[int], arr2: list[int], k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays.\n    Assumes valid input for k and sorted arrays as per requirements.\n    \"\"\"\n    n1, n2 = len(arr1), len(arr2)\n\n    # Ensure arr1 is the shorter array for optimized binary search.\n    if n1 > n2:\n        arr1, arr2 = arr2, arr1\n        n1, n2 = n2, n1\n\n    # Binary search for the number of elements to take from arr1.\n    # low is the minimum possible elements from arr1, high is the maximum.\n    low = max(0, k - n2)\n    high = min(n1, k)\n\n    while low <= high:\n        # mid1 is the count of elements taken from arr1.\n        mid1 = (low + high) // 2\n        # mid2 is the count of elements taken from arr2 to reach k.\n        mid2 = k - mid1\n\n        # Determine the four partition elements.\n        L1 = arr1[mid1 - 1] if mid1 > 0 else float('-inf')\n        R1 = arr1[mid1] if mid1 < n1 else float('inf')\n        L2 = arr2[mid2 - 1] if mid2 > 0 else float('-inf')\n        R2 = arr2[mid2] if mid2 < n2 else float('inf')\n\n        if L1 <= R2 and L2 <= R1:\n            # The partition is correct, the k-th element is max(L1, L2).\n            return max(L1, L2)\n        elif L1 > R2:\n            # Too many elements taken from arr1, reduce mid1.\n            high = mid1 - 1\n        else:  # L2 > R1\n            # Too few elements taken from arr1, increase mid1.\n            low = mid1 + 1\n\n    # This line should not be reached given the problem's valid input constraints.\n    return -1"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(number):\n    \"\"\"\n    Checks if an integer is an Armstrong number. Returns True for 0 and negative numbers as False.\n    \"\"\"\n    if number < 0:\n        return False\n    if number == 0:\n        return True\n\n    num_str = str(number)\n    num_digits = len(num_str)\n    sum_of_powers = 0\n    for digit_char in num_str:\n        digit = int(digit_char)\n        sum_of_powers += digit ** num_digits\n    \n    return sum_of_powers == number"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"\n    Checks if an integer is an Armstrong number.\n    An Armstrong number is the sum of its own digits each raised to the power of the number of digits.\n    \"\"\"\n    \n    if number < 0:\n        return False\n    \n    if number == 0:\n        return True\n\n    # Get the number of digits.\n    # We take the absolute value for consistency in digit extraction,\n    # though for positive numbers it's not strictly necessary.\n    num_digits = len(str(number))\n\n    # Extract digits.\n    digits = [int(d) for d in str(number)]\n    \n    sum_of_powers = 0\n    for digit in digits:\n        sum_of_powers += digit ** num_digits\n            \n    return sum_of_powers == number"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n):\n    \"\"\"\n    Calculates the sum and average of the first 'n' natural numbers.\n    It returns a tuple (sum, average) where sum is an int and average is a float.\n    \"\"\"\n    total_sum = n * (n + 1) // 2\n    average = total_sum / n\n    return total_sum, average"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n: int) -> tuple[int, float]:\n    \"\"\"Calculates the sum and average of the first 'n' natural numbers.\"\"\"\n    total_sum = n * (n + 1) // 2\n    average = total_sum / n\n    return (total_sum, average)"}
