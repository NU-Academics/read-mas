{"task_id": "Mbpp/763", "solution": "def find_min_diff(arr: tuple, n: int) -> int:\n    \"\"\"\n    Calculates the minimum absolute difference between any two elements in a given array.\n    Assumes valid input types and that 'n' accurately represents the length of 'arr'.\n    \"\"\"\n    if n < 2:\n        return 0\n\n    sorted_arr = sorted(arr)\n    min_diff = float('inf')\n\n    for i in range(n - 1):\n        diff = abs(sorted_arr[i+1] - sorted_arr[i])\n        if diff < min_diff:\n            min_diff = diff\n    \n    return int(min_diff)"}
{"task_id": "Mbpp/765", "solution": "def is_power_of_two(num: int) -> bool:\n    \"\"\"\n    Checks if a given positive integer is a power of two.\n    Returns True if num is a power of two, False otherwise.\n    \"\"\"\n    if num <= 0:\n        return False\n    return (num & (num - 1)) == 0\ndef is_polite(n: int) -> int:\n    \"\"\"\n    Finds the Nth polite number.\n    A polite number is a positive integer that is not a power of two.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    polite_count = 0\n    current_num = 1\n    while True:\n        if not is_power_of_two(current_num):\n            polite_count += 1\n            if polite_count == n:\n                return current_num\n        current_num += 1"}
{"task_id": "Mbpp/763", "solution": "import math\ndef find_min_diff(arr: tuple[int, ...], n: int) -> int:\n    \"\"\"\n    Calculates the minimum absolute difference between any two elements in a given array.\n\n    Args:\n        arr: The input array of integers (tuple or list).\n        n: The number of elements in the array arr.\n\n    Returns:\n        The minimum absolute difference between any two elements in the array.\n\n    Raises:\n        TypeError: If 'arr' is not a tuple/list or contains non-integer elements,\n                   or if 'n' is not an integer.\n        ValueError: If 'n' does not match the length of 'arr', or if the array\n                    contains fewer than two elements.\n    \"\"\"\n    if not isinstance(arr, (tuple, list)):\n        raise TypeError(\"Input 'arr' must be a tuple or list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise TypeError(\"All elements in 'arr' must be integers.\")\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if len(arr) != n:\n        raise ValueError(\"Input 'n' must match the length of 'arr'.\")\n\n    if n < 2:\n        raise ValueError(\"Cannot find minimum difference for arrays with less than two elements.\")\n\n    sorted_arr = sorted(arr)\n    min_diff = math.inf\n\n    for i in range(n - 1):\n        min_diff = min(min_diff, abs(sorted_arr[i+1] - sorted_arr[i]))\n\n    return int(min_diff)"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(items: list) -> list[tuple]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in a given list.\n\n    Args:\n        items: The list from which to extract consecutive pairs.\n\n    Returns:\n        A list of tuples, where each tuple contains two consecutive items\n        from the input list. Returns an empty list if the input list\n        has fewer than two elements.\n    \"\"\"\n    if len(items) < 2:\n        return []\n    \n    pairs = []\n    for i in range(len(items) - 1):\n        pairs.append((items[i], items[i+1]))\n    return pairs"}
{"task_id": "Mbpp/765", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    pass\ndef is_power_of_two(num: int) -> bool:\n    \"\"\"Checks if a given positive integer num is a power of two.\"\"\"\n    if not isinstance(num, int) or num <= 0:\n        raise InvalidInputError(\"Input 'num' must be a positive integer.\")\n    return (num & (num - 1) == 0)\ndef is_polite(n: int) -> int:\n    \"\"\"Finds the nth polite number.\"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n    polite_count = 0\n    current_num = 1\n    while True:\n        if not is_power_of_two(current_num):\n            polite_count += 1\n            if polite_count == n:\n                return current_num\n        current_num += 1"}
