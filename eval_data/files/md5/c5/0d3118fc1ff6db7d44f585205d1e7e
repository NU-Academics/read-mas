{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix: list[list[int]]) -> float:\n    # Get the size of the square matrix.\n    n = len(matrix)\n\n    # For an empty matrix or invalid input, raise an error or return 0.0 based on specification.\n    # Given the problem constraints, n is expected to be >= 1.\n    # If n=0, the following operations would lead to an IndexError.\n    # For a robust solution, input validation would be performed here.\n    # The design document suggested raising ValueError for invalid input,\n    # but the current request is for the bare function logic.\n    if n == 0:\n        return 0.0\n\n    # dp[i][j] stores the maximum sum to reach cell (i, j) from (0,0).\n    dp = [[0] * n for _ in range(n)]\n\n    # Base case: The top-left cell's cost is itself.\n    dp[0][0] = matrix[0][0]\n\n    # Fill the first row: Only right moves are possible.\n    for j in range(1, n):\n        dp[0][j] = dp[0][j-1] + matrix[0][j]\n\n    # Fill the first column: Only down moves are possible.\n    for i in range(1, n):\n        dp[i][0] = dp[i-1][0] + matrix[i][0]\n\n    # Fill the rest of the dp table: Take the maximum sum from either above or left.\n    for i in range(1, n):\n        for j in range(1, n):\n            dp[i][j] = max(dp[i-1][j], dp[i][j-1]) + matrix[i][j]\n\n    # The maximum total cost to reach the bottom-right cell.\n    max_total_cost = dp[n-1][n-1]\n    \n    # The number of cells in any valid path from (0,0) to (N-1, N-1) is (N + N - 1).\n    num_cells_in_path = (2 * n) - 1\n    \n    # Calculate the average cost.\n    # As per the design, for n=0, num_cells_in_path would be -1.\n    # However, since n >= 1 for valid inputs per problem description, num_cells_in_path will be >= 1.\n    return max_total_cost / num_cells_in_path"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(arr: list, k: int) -> list:\n    \"\"\"\n    Reverses the first 'k' elements of a list, returning a new list.\n    The original list remains unchanged.\n\n    Args:\n        arr (list): The input list.\n        k (int): The number of elements from the beginning to reverse.\n\n    Returns:\n        list: A new list with the first 'k' elements reversed.\n\n    Raises:\n        TypeError: If 'arr' is not a list or 'k' is not an integer.\n        ValueError: If 'arr' is empty and 'k' is greater than 0.\n        IndexError: If 'k' is out of bounds (k < 0 or k > len(arr)).\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    if not isinstance(k, int):\n        raise TypeError(\"Input 'k' must be an integer.\")\n\n    if k < 0 or k > len(arr):\n        raise IndexError(f\"Count 'k' ({k}) is out of bounds for array of length {len(arr)}. Must be between 0 and {len(arr)} (inclusive).\")\n    \n    # If arr is empty and k > 0, it's an invalid request as we can't reverse elements that don't exist.\n    # If arr is empty and k == 0, it means reverse 0 elements, which is an empty list, so it's valid.\n    if not arr and k > 0:\n        raise ValueError(\"Input 'arr' cannot be empty if 'k' is greater than 0.\")\n\n    reversed_part = arr[:k][::-1]\n    remaining_part = arr[k:]\n    return reversed_part + remaining_part"}
{"task_id": "Mbpp/721", "solution": "from typing import List, Tuple\nclass Matrix:\n    \"\"\"Represents a square cost matrix and provides coordinate access.\"\"\"\n    def __init__(self, grid: List[List[int]]):\n        self._grid = grid\n        self.N = len(grid)\n\n    def get_cost(self, row: int, col: int) -> int:\n        \"\"\"Returns the cost of the cell at (row, col).\"\"\"\n        return self._grid[row][col]\n\n    def is_valid_coordinate(self, row: int, col: int) -> bool:\n        \"\"\"Checks if (row, col) is within the matrix bounds.\"\"\"\n        return 0 <= row < self.N and 0 <= col < self.N\nclass Path:\n    \"\"\"Represents a path through the matrix, tracking cells, total cost, and count.\"\"\"\n    def __init__(self):\n        self._cells: List[Tuple[int, int]] = []\n        self._total_cost: int = 0\n        self._num_cells: int = 0\n\n    def add_cell(self, row: int, col: int, cost: int) -> None:\n        \"\"\"Adds a cell to the path and updates its cost and count.\"\"\"\n        self._cells.append((row, col))\n        self._total_cost += cost\n        self._num_cells += 1\n\n    def get_average(self) -> float:\n        \"\"\"Calculates and returns the average cost of the path.\"\"\"\n        return self._total_cost / self._num_cells\n\n    def get_last_cell(self) -> Tuple[int, int]:\n        \"\"\"Returns the coordinates of the last cell added.\"\"\"\n        return self._cells[-1]\n\n    def get_num_cells(self) -> int:\n        \"\"\"Returns the number of cells in the path.\"\"\"\n        return self._num_cells\n\n    def get_total_cost(self) -> int:\n        \"\"\"Returns the total cost of the path.\"\"\"\n        return self._total_cost\n\n    def copy(self) -> 'Path':\n        \"\"\"Returns a deep copy of the current path.\"\"\"\n        new_path = Path()\n        new_path._cells = list(self._cells)\n        new_path._total_cost = self._total_cost\n        new_path._num_cells = self._num_cells\n        return new_path\nclass PathFinderService:\n    \"\"\"Orchestrates pathfinding and manages the maximum average cost found.\"\"\"\n    def __init__(self, matrix: 'Matrix'):\n        self._matrix = matrix\n        self._max_average: float = float('-inf')\n\n    def _find_paths_recursive(self, row: int, col: int, current_path: 'Path') -> None:\n        \"\"\"Recursively explores paths, updating max_average upon reaching the destination.\"\"\"\n        cost = self._matrix.get_cost(row, col)\n        current_path.add_cell(row, col, cost)\n\n        if row == self._matrix.N - 1 and col == self._matrix.N - 1:\n            current_average = current_path.get_average()\n            if current_average > self._max_average:\n                self._max_average = current_average\n            return\n\n        if self._matrix.is_valid_coordinate(row + 1, col):\n            self._find_paths_recursive(row + 1, col, current_path.copy())\n\n        if self._matrix.is_valid_coordinate(row, col + 1):\n            self._find_paths_recursive(row, col + 1, current_path.copy())\n\n    def find_max_average_path(self) -> float:\n        \"\"\"Starts the pathfinding process and returns the maximum average cost.\"\"\"\n        initial_path = Path()\n        self._find_paths_recursive(0, 0, initial_path)\n        return self._max_average\ndef maxAverageOfPath(matrix_data: List[List[int]]) -> float:\n    \"\"\"Finds the path with the maximum average cost in a square matrix.\"\"\"\n    # Basic input validation to ensure the matrix is not empty, which would cause N=0 for Matrix class.\n    if not matrix_data or not matrix_data[0]:\n        # Based on the problem description, a square matrix N*N implies N >= 1.\n        # However, for robustness, if an empty matrix is passed, return 0.0 as per the design's consideration for N=0.\n        return 0.0\n    \n    # The Matrix class handles more detailed validation (e.g., square, integer elements).\n    # If invalid, it will raise an InvalidMatrixError, which is appropriate.\n    matrix = Matrix(matrix_data)\n    service = PathFinderService(matrix)\n    return service.find_max_average_path()"}
