{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(start_num: int, end_num: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range (inclusive) where every number is divisible\n    by every non-zero digit it contains.\n    \"\"\"\n\n    def _get_digits(number: int) -> list[int]:\n        \"\"\"\n        Extracts individual digits from an integer.\n        \"\"\"\n        if number == 0:\n            return [0]\n        digits = []\n        temp_num = abs(number)\n        while temp_num > 0:\n            digits.append(temp_num % 10)\n            temp_num //= 10\n        return digits[::-1]\n\n    def _is_divisible_by_its_digits(number: int) -> bool:\n        \"\"\"\n        Checks if a given number is divisible by all its non-zero digits.\n        \"\"\"\n        if number == 0:\n            return True\n\n        digits = _get_digits(number)\n        for digit in digits:\n            if digit == 0:\n                continue\n            if number % digit != 0:\n                return False\n        return True\n\n    result = []\n    for num in range(start_num, end_num + 1):\n        if _is_divisible_by_its_digits(num):\n            result.append(num)\n    return result"}
{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a range that are divisible by each of their non-zero digits.\n    Numbers containing the digit 0 are excluded from the result based on specified examples.\n    \"\"\"\n    result = []\n\n    for num in range(startnum, endnum + 1):\n        if num == 0:\n            # According to common interpretations and given examples, 0 itself is not a valid candidate.\n            continue\n\n        is_current_num_valid = True\n        temp_num_for_digit_extraction = num \n\n        # Extract digits and check divisibility\n        while temp_num_for_digit_extraction > 0:\n            digit = temp_num_for_digit_extraction % 10\n            if digit == 0:\n                is_current_num_valid = False # Numbers containing digit 0 are excluded.\n                break\n            \n            if num % digit != 0:\n                is_current_num_valid = False\n                break\n            \n            temp_num_for_digit_extraction //= 10\n        \n        if is_current_num_valid:\n            result.append(num)\n            \n    return result"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap, where each parent node's value is less than or equal to its children's values.\n    An empty or single-element array is considered a valid min-heap.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the Nth Jacobsthal number.\n    Uses the recurrence J(n) = J(n-1) + 2 * J(n-2).\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    elif n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        a, b = 0, 1  # Corresponds to J(0), J(1)\n        for _ in range(2, n + 1):\n            next_jacobsthal = b + 2 * a\n            a, b = b, next_jacobsthal\n        return b"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"Calculates the nth Jacobsthal number using an iterative approach.\n    The sequence is defined by J(0)=0, J(1)=1, and J(n) = J(n-1) + 2 * J(n-2) for n > 1.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    # Initialize with J(0) and J(1)\n    # 'a' will hold J(k-2), 'b' will hold J(k-1)\n    a, b = 0, 1\n\n    # Iterate from k=2 up to n to calculate J(n)\n    for _ in range(2, n + 1):\n        # Calculate the next Jacobsthal number J(k)\n        # Then update 'a' and 'b' for the next iteration\n        a, b = b, a + 2 * b\n    return b"}
