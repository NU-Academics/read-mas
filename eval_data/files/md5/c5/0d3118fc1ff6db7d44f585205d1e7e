{"task_id": "Mbpp/245", "solution": "def max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence in the given array.\n    A bitonic sequence is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n\n    # Handle edge cases for empty or single-element arrays as per requirements.\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    # lis_sum[i] stores the maximum sum of an increasing subsequence ending at index i.\n    lis_sum = list(arr)\n    for i in range(1, n):\n        for j in range(i):\n            if arr[i] > arr[j]:\n                lis_sum[i] = max(lis_sum[i], lis_sum[j] + arr[i])\n\n    # lds_sum[i] stores the maximum sum of a decreasing subsequence starting at index i.\n    lds_sum = list(arr)\n    for i in range(n - 2, -1, -1):\n        for j in range(n - 1, i, -1):\n            if arr[i] > arr[j]:\n                lds_sum[i] = max(lds_sum[i], lds_sum[j] + arr[i])\n\n    # Combine LIS and LDS sums to find the maximum bitonic sum.\n    # arr[i] is subtracted because it is counted in both lis_sum[i] and lds_sum[i].\n    max_bitonic_sum = 0\n    for i in range(n):\n        current_bitonic_sum = lis_sum[i] + lds_sum[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n\n    return max_bitonic_sum"}
{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Calculates the length of the longest palindromic subsequence in the given string.\n    Uses a dynamic programming approach with O(n^2) time and space complexity.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the longest palindromic subsequence of the substring s[i...j].\n    dp = [[0 for _ in range(n)] for _ in range(n)]\n\n    # Every single character is a palindrome of length 1.\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the dp table. L is the length of the current substring.\n    for L in range(2, n + 1):\n        for i in range(n - L + 1):\n            j = i + L - 1\n            if s[i] == s[j]:\n                # If outer characters match, include them and add LPS of inner substring.\n                # If L=2, it's 2 characters matching, so LPS is 2.\n                dp[i][j] = 2 + dp[i + 1][j - 1] if L > 2 else 2\n            else:\n                # If outer characters don't match, take the maximum of excluding s[i] or s[j].\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    return dp[0][n - 1]"}
{"task_id": "Mbpp/245", "solution": "def max_sum(arr: list[int]) -> int:\n    \"\"\"Calculates the maximum sum of a bitonic subsequence for the given array.\"\"\"\n    n = len(arr)\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    # Calculate LIS (Longest Increasing Subsequence) sums\n    # lis_sums[i] stores the maximum sum of an increasing subsequence ending at arr[i].\n    lis_sums = list(arr)\n    for i in range(n):\n        for j in range(i):\n            if arr[i] > arr[j]:\n                lis_sums[i] = max(lis_sums[i], lis_sums[j] + arr[i])\n\n    # Calculate LDS (Longest Decreasing Subsequence) sums from right to left\n    # lds_sums[i] stores the maximum sum of a decreasing subsequence starting at arr[i].\n    lds_sums = list(arr)\n    for i in range(n - 1, -1, -1):\n        for j in range(n - 1, i, -1):\n            if arr[i] > arr[j]:\n                lds_sums[i] = max(lds_sums[i], lds_sums[j] + arr[i])\n\n    # Combine LIS and LDS sums to find the maximum bitonic subsequence sum.\n    # Initialize max_sum with the sum of a bitonic sequence centered at the first element.\n    max_sum_val = lis_sums[0] + lds_sums[0] - arr[0] \n    for i in range(1, n):\n        # Subtract arr[i] once as it's included in both LIS and LDS sums.\n        current_bitonic_sum = lis_sums[i] + lds_sums[i] - arr[i]\n        max_sum_val = max(max_sum_val, current_bitonic_sum)\n\n    return max_sum_val"}
