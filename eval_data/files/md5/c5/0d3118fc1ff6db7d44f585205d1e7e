{"task_id": "Mbpp/615", "solution": "from typing import Union\ndef average_tuple(data: tuple[tuple[Union[int, float], ...], ...]) -> list[float]:\n    \"\"\"\n    Calculates the average for each inner tuple in a tuple of tuples.\n    Returns 0.0 for empty inner tuples and an empty list for an empty input tuple.\n    \"\"\"\n    if not data:\n        return []\n\n    averages = []\n    for inner_tuple in data:\n        if not inner_tuple:\n            averages.append(0.0)\n        else:\n            averages.append(sum(inner_tuple) / len(inner_tuple))\n    return averages"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Performs element-wise modulo operation on two tuples of the same length.\n    It returns a new tuple containing the results.\"\"\"\n    results = []\n    for i in range(len(tuple1)):\n        results.append(tuple1[i] % tuple2[i])\n    return tuple(results)"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple[int | float, ...], tuple2: tuple[int | float, ...]) -> tuple[int | float, ...]:\n    \"\"\"\n    Performs element-wise modulo operation on two tuples.\n    Assumes inputs are valid tuples of the same length with numeric elements.\n    \"\"\"\n    return tuple(a % b for a, b in zip(tuple1, tuple2))"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(data: tuple[tuple[int | float, ...], ...]) -> list[float]:\n    \"\"\"\n    Calculates the average value for each inner tuple in a tuple of tuples.\n    Returns 0.0 for empty inner tuples and an empty list for an empty input tuple.\n    \"\"\"\n    if not data:\n        return []\n\n    results: list[float] = []\n    for inner_tuple in data:\n        if not inner_tuple:\n            results.append(0.0)\n        else:\n            results.append(sum(inner_tuple) / len(inner_tuple))\n    return results"}
