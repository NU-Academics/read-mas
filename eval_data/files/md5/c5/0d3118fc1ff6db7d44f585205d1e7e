{"task_id": "Mbpp/440", "solution": "import string\nADVERB_SUFFIX = \"ly\"\ndef _strip_punctuation(word: str) -> str:\n    \"\"\"Removes leading and trailing punctuation from a word.\n    Uses string.punctuation for character set.\"\"\"\n    return word.strip(string.punctuation)\ndef _is_adverb(word: str) -> bool:\n    \"\"\"Checks if a word (after stripping punctuation) ends with the adverb suffix.\n    Ensures the cleaned word is longer than just the suffix.\"\"\"\n    cleaned_word = _strip_punctuation(word)\n    return cleaned_word.lower().endswith(ADVERB_SUFFIX) and len(cleaned_word) > len(ADVERB_SUFFIX)\ndef find_adverb_position(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    The adverb is identified by ending in \"ly\" (case-insensitive) after stripping punctuation.\n\n    Args:\n        sentence: The input sentence string.\n\n    Returns:\n        A tuple (start_position, end_position, adverb_text) if an adverb is found,\n        otherwise None.\n    \"\"\"\n    if not isinstance(sentence, str):\n        raise TypeError(\"Input 'sentence' must be a string.\")\n    if not sentence:\n        return None\n\n    words = sentence.split()\n    current_search_start_index = 0\n\n    for word in words:\n        # Locate the exact start position of the current word in the original sentence.\n        start_pos = sentence.find(word, current_search_start_index)\n        \n        # Safeguard for cases where a word might not be found from the current index.\n        if start_pos == -1:\n            current_search_start_index += len(word) + 1 \n            continue\n\n        if _is_adverb(word):\n            # Calculate end_pos and return adverb text as per the critical requirement's example.\n            stripped_adverb = _strip_punctuation(word)\n            end_pos = start_pos + len(stripped_adverb)\n            return (start_pos, end_pos, stripped_adverb)\n        \n        # Update the search index to look for the next word after the current one.\n        current_search_start_index = start_pos + len(word)\n\n        # Increment index to skip the space character if one exists after the current word.\n        if current_search_start_index < len(sentence) and sentence[current_search_start_index] == ' ':\n            current_search_start_index += 1\n\n    return None"}
