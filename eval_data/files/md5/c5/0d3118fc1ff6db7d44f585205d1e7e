{"task_id": "Mbpp/440", "solution": "import string\nfrom typing import Optional, Tuple\nCOMMON_ADVERBS = [\"clearly\", \"quickly\", \"slowly\", \"happily\", \"sadly\", \"very\", \"really\", \"always\", \"never\", \"often\", \"seldom\", \"soon\", \"now\", \"then\", \"here\", \"there\", \"everywhere\"]\nPUNCTUATION_CHARS = string.punctuation\ndef _strip_punctuation(word: str) -> str:\n    \"\"\"Removes leading and trailing punctuation from a word.\"\"\"\n    return word.strip(PUNCTUATION_CHARS)\ndef _is_adverb(word: str) -> bool:\n    \"\"\"Checks if a word is an adverb (case-insensitive).\"\"\"\n    return word.lower() in COMMON_ADVERBS\ndef find_adverb_position(sentence: str) -> Optional[Tuple[int, int, str]]:\n    \"\"\"\n    Finds the first adverb and its position in a given sentence.\n    Returns (start_index, end_index, adverb_string) or None if not found.\n    \"\"\"\n    current_index = 0\n    words = sentence.split()\n\n    for word_with_punct in words:\n        start_index_of_word = sentence.find(word_with_punct, current_index)\n        if start_index_of_word == -1:\n            current_index += len(word_with_punct) + 1\n            continue\n\n        cleaned_word = _strip_punctuation(word_with_punct)\n\n        if _is_adverb(cleaned_word):\n            end_index = start_index_of_word + len(cleaned_word)\n            return (start_index_of_word, end_index, cleaned_word)\n\n        current_index = start_index_of_word + len(word_with_punct)\n        if current_index < len(sentence) and sentence[current_index] == ' ':\n            current_index += 1\n\n    return None"}
