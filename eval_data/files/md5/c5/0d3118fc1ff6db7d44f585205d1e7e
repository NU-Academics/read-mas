{"task_id": "Mbpp/409", "solution": "import math\nfrom typing import List, Tuple, Union, Optional\ndef min_product_tuple(data: List[Tuple[Union[int, float], ...]]) -> Optional[Union[int, float]]:\n    \"\"\"\n    Calculates the minimum product from a list of tuples.\n\n    Args:\n        data: A list where each element is a tuple containing numeric values.\n\n    Returns:\n        The minimum product found, or None if the input list is empty.\n\n    Raises:\n        TypeError: If the input is not a list, or if a tuple contains non-numeric elements.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input must be a list.\")\n    if not data:\n        return None\n\n    products = []\n    for tpl in data:\n        if not isinstance(tpl, tuple):\n            raise TypeError(f\"All elements in the list must be tuples, but found: {type(tpl)}\")\n        try:\n            # Use math.prod for Python 3.8+, otherwise manual multiplication\n            current_product = math.prod(tpl)\n        except TypeError as e:\n            raise TypeError(f\"Tuple elements must be numeric for multiplication: {e}\") from e\n        products.append(current_product)\n\n    return min(products)"}
{"task_id": "Mbpp/409", "solution": "from typing import List, Tuple, Union\ndef min_product_tuple(input_list: List[Tuple[Union[int, float], Union[int, float]]]) -> Union[int, float]:\n    \"\"\"\n    Finds the minimum product from the pairs of tuples within a given list.\n\n    Args:\n        input_list: A list of tuples, where each tuple contains two numeric values (int or float).\n\n    Returns:\n        The minimum product found among all pairs.\n\n    Raises:\n        TypeError: If the input is not a list, or if any element in the list is not a tuple.\n        ValueError: If the input list is empty, if any tuple does not contain exactly two numbers,\n                    or if any element within a tuple is not an int or float.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input 'input_list' must be a list.\")\n    if not input_list:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    min_product = float('inf')\n\n    for item in input_list:\n        if not isinstance(item, tuple):\n            raise TypeError(f\"List element '{item}' must be a tuple.\")\n        if len(item) != 2:\n            raise ValueError(f\"Tuple '{item}' must contain exactly two numbers.\")\n        if not all(isinstance(x, (int, float)) for x in item):\n            raise ValueError(f\"Tuple '{item}' must contain only numeric values.\")\n\n        product = item[0] * item[1]\n        if product < min_product:\n            min_product = product\n    return min_product"}
