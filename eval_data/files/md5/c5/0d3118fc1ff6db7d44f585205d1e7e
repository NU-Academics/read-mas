{"task_id": "Mbpp/9", "solution": "def find_Rotations(input_string: str) -> int:\n    \"\"\"\n    Calculates the minimum non-zero rotations for a string to return to its original form.\n    Handles empty strings and single-character strings as per specification.\n    \"\"\"\n    n = len(input_string)\n    if n == 0:\n        return 1\n\n    temp = input_string + input_string\n    \n    for k in range(1, n + 1):\n        if temp[k:k+n] == input_string:\n            return k\n    \n    return n"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s):\n    \"\"\"\n    Finds the minimum positive rotations for a string `s` to return to its original state.\n    Returns 0 for an empty string, otherwise a value `k` where `1 <= k <= len(s)`.\n    \"\"\"\n    if not s:\n        return 0\n\n    n = len(s)\n    if n == 1:\n        return 1\n\n    temp = s + s\n\n    for k in range(1, n + 1):\n        if temp[k:k+n] == s:\n            return k\n\n    return n"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, char_to_remove: str) -> str:\n    \"\"\"Removes the first and last occurrences of a specified character from a string.\n    If the character appears only once, that single occurrence is removed.\n\n    Args:\n        input_string: The string to modify.\n        char_to_remove: The single character to be removed.\n\n    Returns:\n        The modified string.\n\n    Raises:\n        ValueError: If char_to_remove is not a single character string.\n    \"\"\"\n    if not isinstance(char_to_remove, str) or len(char_to_remove) != 1:\n        raise ValueError(\"char_to_remove must be a single character string.\")\n\n    first_idx = input_string.find(char_to_remove)\n\n    if first_idx == -1:\n        return input_string\n\n    last_idx = input_string.rfind(char_to_remove)\n\n    if first_idx == last_idx:\n        # Only one occurrence, remove it.\n        return input_string[:first_idx] + input_string[first_idx + 1:]\n    else:\n        # First and last occurrences are distinct; remove both.\n        # This is more efficient than creating an intermediate string.\n        return input_string[:first_idx] + input_string[first_idx + 1:last_idx] + input_string[last_idx + 1:]"}
{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix):\n    \"\"\"\n    Sorts a given matrix in ascending order based on the sum of its rows.\n    Returns a new list of lists with rows sorted by their sums.\n    \"\"\"\n    rows_with_sums = [(sum(row), row) for row in matrix]\n    rows_with_sums.sort(key=lambda x: x[0])\n    sorted_matrix = [row for _, row in rows_with_sums]\n    return sorted_matrix"}
{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix):\n    \"\"\"Sorts a matrix by the sum of its rows in ascending order.\n    It returns a new list of lists with rows reordered.\n    \"\"\"\n    rows_with_sums = []\n    for row in matrix:\n        row_sum = sum(row)\n        rows_with_sums.append((row_sum, row))\n\n    rows_with_sums.sort(key=lambda x: x[0])\n\n    sorted_matrix = [row for _, row in rows_with_sums]\n    return sorted_matrix"}
