{"task_id": "Mbpp/17", "solution": "def square_perimeter(side_length: float) -> float:\n    \"\"\"Calculates the perimeter of a square given its side length.\n\n    Args:\n        side_length: The length of one side of the square.\n\n    Returns:\n        The perimeter of the square.\n\n    Raises:\n        ValueError: If side_length is not a non-negative number.\n    \"\"\"\n    if not isinstance(side_length, (int, float)):\n        raise ValueError(\"Invalid input: side_length must be a number.\")\n    if side_length < 0:\n        raise ValueError(\"Invalid input: side_length must be a non-negative number.\")\n    return side_length * 4"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(n: int) -> bool:\n    \"\"\"Checks if a given number is a Woodall number.\n\n    A Woodall number is defined as W_k = k * (2^k) - 1 for some non-negative integer k.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < -1:  # W_0 = -1, so numbers less than -1 cannot be Woodall numbers\n        return False\n    \n    k = 0\n    while True:\n        woodall_candidate = k * (2**k) - 1\n        if woodall_candidate == n:\n            return True\n        # Optimization: if the candidate exceeds n, and n has not been found yet,\n        # then n cannot be a Woodall number as W_k increases with k (for k >= 1).\n        # For k=0, W_0 = -1. If n is between -1 and 1 (i.e. n=0), then W_k will eventually exceed n.\n        if woodall_candidate > n:\n            return False\n        k += 1"}
{"task_id": "Mbpp/56", "solution": "def _reverse_number_helper(num: int) -> int:\n    \"\"\"Reverses the digits of an integer.\n    Handles negative numbers by reversing the absolute value.\"\"\"\n    if num < 0:\n        return -_reverse_number_helper(abs(num))\n    \n    s = str(num)\n    reversed_s = s[::-1]\n    return int(reversed_s)\ndef check(num: int) -> bool:\n    \"\"\"Checks if a given number is one less than twice its reverse.\n    Delegates number reversal to an internal helper function.\"\"\"\n    reversed_num = _reverse_number_helper(num)\n    return num == (2 * reversed_num) - 1"}
{"task_id": "Mbpp/56", "solution": "def check(num):\n    \"\"\"Determines if num is one less than twice its reverse.\n    This function relies on an inline helper for number reversal.\n    \"\"\"\n    def _reverse_number(n: int) -> int:\n        \"\"\"Reverses an integer, preserving its sign.\n        For example, reverse(123) is 321, reverse(-45) is -54, reverse(120) is 21.\n        \"\"\"\n        if n == 0:\n            return 0\n        \n        sign = -1 if n < 0 else 1\n        abs_n_str = str(abs(n))\n        reversed_abs_n_str = abs_n_str[::-1]\n        return sign * int(reversed_abs_n_str)\n\n    reversed_num = _reverse_number(num)\n    return num == (2 * reversed_num) - 1"}
{"task_id": "Mbpp/57", "solution": "import functools\nclass CustomDigitComparator:\n    \"\"\"Provides custom comparison logic for sorting digit strings.\n    It determines order by comparing concatenated strings.\n    \"\"\"\n    def __call__(self, item1: str, item2: str) -> int:\n        \"\"\"Compares two digit strings to determine their relative order.\n        Returns -1 if item1 should precede item2, 1 if item1 should follow item2.\n        \"\"\"\n        if item1 + item2 > item2 + item1:\n            return -1\n        elif item1 + item2 < item2 + item1:\n            return 1\n        else:\n            return 0\ndef find_Max_Num(digits: list[int]) -> int:\n    \"\"\"Finds the largest number formable from a list of digits.\n    The function sorts digits using a custom comparison and concatenates them.\n    \"\"\"\n    if not digits:\n        return 0\n\n    str_digits = [str(d) for d in digits]\n    str_digits.sort(key=functools.cmp_to_key(CustomDigitComparator()))\n    largest_num_str = \"\".join(str_digits)\n\n    return int(largest_num_str)"}
