{"task_id": "Mbpp/71", "solution": "def comb_sort(data):\n    \"\"\"\n    Sorts a list of elements in ascending order using the Comb Sort algorithm.\n    It returns a new list with the sorted elements.\n    \"\"\"\n    n = len(data)\n    if n <= 1:\n        return list(data)\n\n    arr = list(data)\n    gap = n\n    swapped = True\n    \n    SHRINK_FACTOR = 1.3\n\n    while gap > 1 or swapped:\n        if gap > 1:\n            gap = int(gap / SHRINK_FACTOR)\n            if gap < 1:\n                gap = 1\n\n        swapped = False\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(num: int) -> bool:\n    \"\"\"\n    Checks if an integer can be represented as the difference of two squares (a^2 - b^2).\n    A number N can be represented as such if and only if abs(N) is odd or a multiple of 4.\n    \"\"\"\n    if num == 0:\n        return True\n\n    abs_num = abs(num)\n\n    # N can be represented if it's odd or a multiple of 4.\n    if abs_num % 2 != 0:  # Check if odd\n        return True\n    elif abs_num % 4 == 0:  # Check if a multiple of 4 (implies even)\n        return True\n    else:  # Even but not a multiple of 4\n        return False"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(patterns, arr):\n    \"\"\"\n    Checks if a sequence of strings follows the same structural pattern as another list.\n    Returns True if a consistent one-to-one mapping exists, False otherwise.\n    \"\"\"\n    if len(patterns) != len(arr):\n        return False\n    if not patterns:\n        return True\n\n    seq_to_pattern_map = {}\n    pattern_to_seq_map = {}\n\n    for i in range(len(patterns)):\n        seq_element = patterns[i]\n        pattern_element = arr[i]\n\n        if seq_element in seq_to_pattern_map:\n            if seq_to_pattern_map[seq_element] != pattern_element:\n                return False\n        else:\n            seq_to_pattern_map[seq_element] = pattern_element\n\n        if pattern_element in pattern_to_seq_map:\n            if pattern_to_seq_map[pattern_element] != seq_element:\n                return False\n        else:\n            pattern_to_seq_map[pattern_element] = seq_element\n\n    return True"}
{"task_id": "Mbpp/75", "solution": "from typing import List, Tuple\ndef find_tuples(data: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    \"\"\"\n    Filters a list of tuples, returning only those where every element is divisible by k.\n    This function trusts the caller's inputs and performs the divisibility check directly.\n    \"\"\"\n    filtered_tuples: List[Tuple[int, ...]] = []\n    for tpl in data:\n        if all(element % k == 0 for element in tpl):\n            filtered_tuples.append(tpl)\n    return filtered_tuples"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(words: list[str], patterns: list[str]) -> bool:\n    \"\"\"\n    Checks if a list of words follows the sequence given in the patterns list.\n    Ensures a consistent one-to-one mapping between unique words and unique pattern characters.\n    \"\"\"\n    if len(words) != len(patterns):\n        return False\n\n    word_to_pattern_map: dict[str, str] = {}\n    pattern_to_word_map: dict[str, str] = {}\n\n    for word, pattern_char in zip(words, patterns):\n        # Check word to pattern mapping consistency\n        if word in word_to_pattern_map:\n            if word_to_pattern_map[word] != pattern_char:\n                return False\n        else:\n            word_to_pattern_map[word] = pattern_char\n\n        # Check pattern to word mapping consistency\n        if pattern_char in pattern_to_word_map:\n            if pattern_to_word_map[pattern_char] != word:\n                return False\n        else:\n            pattern_to_word_map[pattern_char] = word\n\n    return True"}
{"task_id": "Mbpp/75", "solution": "from typing import List, Tuple\ndef find_tuples(data: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    \"\"\"\n    Finds tuples where all elements are divisible by k.\n    This function assumes valid integer inputs and allows Python to handle type errors.\n    \"\"\"\n    result_tuples: List[Tuple[int, ...]] = []\n    for current_tuple in data:\n        if all(elem % k == 0 for elem in current_tuple):\n            result_tuples.append(current_tuple)\n    return result_tuples"}
