{"task_id": "Mbpp/799", "solution": "BITS_IN_INT = 32\nMAX_32_BIT_VALUE = 0xFFFFFFFF\ndef left_rotate(n: int, d: int) -> int:\n    \"\"\"\n    Rotates the bits of a 32-bit unsigned integer 'n' to the left by 'd' positions.\n    The result is a 32-bit unsigned integer.\n    \"\"\"\n    n &= MAX_32_BIT_VALUE # Ensure n is treated as a 32-bit unsigned integer\n    d %= BITS_IN_INT     # Normalize d to be within [0, BITS_IN_INT - 1]\n\n    # Perform the left rotation\n    return ((n << d) | (n >> (BITS_IN_INT - d))) & MAX_32_BIT_VALUE"}
{"task_id": "Mbpp/799", "solution": "BITS_IN_INT = 32\nBIT_MASK_32_BIT = 0xFFFFFFFF\ndef left_rotate(number: int, d: int) -> int:\n    \"\"\"\n    Performs a left bit rotation on a 32-bit unsigned integer by 'd' bits.\n    Assumes 'number' is a valid 32-bit unsigned integer and 'd' is a valid shift amount.\n    \"\"\"\n    rotated_value = ((number << d) | (number >> (BITS_IN_INT - d))) & BIT_MASK_32_BIT\n    return rotated_value"}
