{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts substrings where the sum of digits equals their length.\n    All helper functions are defined inline.\n    \"\"\"\n\n    def _is_valid_digit_string(sub: str) -> bool:\n        \"\"\"Checks if the given string consists only of digit characters.\"\"\"\n        return sub.isdigit()\n\n    def _calculate_digit_sum(sub: str) -> int:\n        \"\"\"Calculates the sum of integer values of characters in a digit string.\"\"\"\n        return sum(int(digit) for digit in sub)\n\n    count = 0\n    n = len(s)\n    for i in range(n):\n        for j in range(i, n):\n            substring = s[i : j + 1]\n            if _is_valid_digit_string(substring):\n                digit_sum = _calculate_digit_sum(substring)\n                if digit_sum == len(substring):\n                    count += 1\n    return count"}
