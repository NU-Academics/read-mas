{"task_id": "Mbpp/580", "solution": "from typing import Any, Tuple\ndef extract_even(input_tuple: Tuple[Any, ...]) -> Tuple[Any, ...]:\n    \"\"\"\n    Recursively extracts even integers from a nested tuple, preserving its structure.\n    Only even integers and their containing tuples are retained.\n    \"\"\"\n    # Adhering to CRITICAL REQUIREMENT: Do NOT add isinstance() checks or raise exceptions for edge cases.\n    # The input_tuple is assumed to be a tuple.\n\n    result_elements = []\n    for item in input_tuple:\n        if isinstance(item, int):\n            if item % 2 == 0:\n                result_elements.append(item)\n        elif isinstance(item, tuple):\n            # Recursively process sub-tuples.\n            processed_sub_tuple = extract_even(item)\n            if processed_sub_tuple:  # Only add non-empty sub-tuples to preserve structure for relevant data.\n                result_elements.append(processed_sub_tuple)\n        # Elements that are neither int nor tuple are ignored as per FR8.\n    return tuple(result_elements)"}
{"task_id": "Mbpp/581", "solution": "def surface_Area(base_edge, height):\n    \"\"\"Calculates the total surface area of a square pyramid.\n    'height' is assumed to be the slant height based on the provided assertion.\n    \"\"\"\n    base_area = base_edge * base_edge\n    lateral_surface_area = 2 * base_edge * height\n    total_surface_area = base_area + lateral_surface_area\n    return total_surface_area"}
{"task_id": "Mbpp/580", "solution": "def extract_even(data: tuple) -> tuple:\n    \"\"\"\n    Recursively extracts even numbers from a nested tuple,\n    maintaining the original nested structure and ignoring non-even integers and other types.\n    \"\"\"\n    result = []\n    for item in data:\n        if isinstance(item, int):\n            if item % 2 == 0:\n                result.append(item)\n        elif isinstance(item, tuple):\n            nested_result = extract_even(item)\n            if nested_result:\n                result.append(nested_result)\n    return tuple(result)"}
{"task_id": "Mbpp/581", "solution": "import math\ndef surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"Calculates the total surface area of a square pyramid.\n    It sums the base area and the lateral surface area.\n    \"\"\"\n    # Calculate the slant height using the perpendicular height and half the base edge.\n    slant_height = math.sqrt(height**2 + (base_edge / 2)**2)\n\n    # Calculate the area of the square base.\n    base_area = base_edge**2\n\n    # Calculate the lateral surface area from the base edge and slant height.\n    lateral_surface_area = 2 * base_edge * slant_height\n\n    # The total surface area is the sum of the base and lateral areas.\n    total_surface_area = base_area + lateral_surface_area\n\n    return total_surface_area"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"Computes the nth Catalan number using dynamic programming.\n    C_n = sum(C_i * C_{n-1-i}).\"\"\"\n    if n == 0:\n        return 1\n\n    catalan = [0] * (n + 1)\n    catalan[0] = 1\n\n    for i in range(1, n + 1):\n        for j in range(i):\n            catalan[i] += catalan[j] * catalan[i - 1 - j]\n\n    return catalan[n]"}
