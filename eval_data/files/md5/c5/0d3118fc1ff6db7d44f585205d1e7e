{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(numbers: list[int], n: int) -> int:\n    \"\"\"Counts pairs of numbers in a list whose bitwise XOR sum is odd.\n    An odd XOR sum occurs when one number is odd and the other is even.\n    \"\"\"\n    odd_count = 0\n    even_count = 0\n\n    for number in numbers:\n        if number % 2 != 0:\n            odd_count += 1\n        else:\n            even_count += 1\n    \n    return odd_count * even_count"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"Toggles the case of alphabetic characters in a string.\n    Uppercase characters become lowercase, and vice-versa, while non-alphabetic characters are unchanged.\n    \"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if char.islower():\n            toggled_chars.append(char.upper())\n        elif char.isupper():\n            toggled_chars.append(char.lower())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr: list[int], n: int) -> int:\n    \"\"\"\n    Counts the number of pairs (a, b) in the input list arr such that a XOR b is odd.\n    A XOR B is odd if and only if one number is odd and the other is even.\n    \"\"\"\n    odd_count = 0\n    even_count = 0\n\n    for x in arr:\n        if x % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    \n    return odd_count * even_count"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr, n):\n    \"\"\"\n    Finds the maximum sum of a contiguous sublist using Kadane's algorithm.\n    Assumes the input list `arr` is not empty.\n    \"\"\"\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, n):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/559", "solution": "from typing import List\ndef max_sub_array_sum(numbers: List[int], n: int) -> int:\n    \"\"\"\n    Calculates the maximum sum of a contiguous sublist using Kadane's algorithm.\n    It processes the list efficiently to find the greatest possible sum.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    max_so_far = numbers[0]\n    current_max = numbers[0]\n\n    for i in range(1, n):\n        current_max = max(numbers[i], current_max + numbers[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/560", "solution": "def union_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Finds the union of elements from two tuples, returning unique elements in sorted order.\n    Elements must be hashable and comparable.\"\"\"\n\n    # Use a set to efficiently get unique elements\n    combined_set = set(tuple1).union(set(tuple2))\n\n    # Convert to list, sort, and then convert back to tuple\n    sorted_list = sorted(list(combined_set))\n\n    return tuple(sorted_list)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of absolute per-digit differences between two integers.\n    Shorter numbers are implicitly padded with leading zeros for comparison.\n    \"\"\"\n    \n    # Extract digits for num1 (least significant to most significant)\n    abs_num1 = abs(num1)\n    digits1 = []\n    if abs_num1 == 0:\n        digits1.append(0)\n    else:\n        while abs_num1 > 0:\n            digits1.append(abs_num1 % 10)\n            abs_num1 //= 10\n\n    # Extract digits for num2 (least significant to most significant)\n    abs_num2 = abs(num2)\n    digits2 = []\n    if abs_num2 == 0:\n        digits2.append(0)\n    else:\n        while abs_num2 > 0:\n            digits2.append(abs_num2 % 10)\n            abs_num2 //= 10\n\n    max_len = max(len(digits1), len(digits2))\n    total_diff = 0\n\n    for i in range(max_len):\n        digit1 = digits1[i] if i < len(digits1) else 0\n        digit2 = digits2[i] if i < len(digits2) else 0\n        total_diff += abs(digit1 - digit2)\n\n    return total_diff"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of absolute per-digit differences between two integers.\n    The shorter number is conceptually padded with leading zeros for comparison.\n    \"\"\"\n    abs_num1_str = str(abs(num1))\n    abs_num2_str = str(abs(num2))\n\n    max_len = max(len(abs_num1_str), len(abs_num2_str))\n\n    padded_num1_str = abs_num1_str.zfill(max_len)\n    padded_num2_str = abs_num2_str.zfill(max_len)\n\n    total_difference = 0\n    for i in range(max_len):\n        digit1 = int(padded_num1_str[i])\n        digit2 = int(padded_num2_str[i])\n        total_difference += abs(digit1 - digit2)\n\n    return total_difference"}
{"task_id": "Mbpp/560", "solution": "def union_elements(tuple1, tuple2):\n    \"\"\"\n    Computes the union of unique elements from two tuples and returns them in sorted order.\n    The function assumes valid tuple inputs containing sortable elements.\n    \"\"\"\n    combined_set = set(tuple1).union(set(tuple2))\n    sorted_elements = sorted(list(combined_set))\n    return tuple(sorted_elements)"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(list_of_lists: list[list]) -> int:\n    \"\"\"\n    Finds the length of the longest sublist within a list of lists.\n    Returns 0 if the input list is empty or contains only empty sublists.\n    \"\"\"\n    if not list_of_lists:\n        return 0\n\n    max_length = 0\n    for sublist in list_of_lists:\n        current_length = len(sublist)\n        if current_length > max_length:\n            max_length = current_length\n    return max_length"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(list_of_lists: list[list[Any]]) -> int:\n    \"\"\"\n    Finds the length of the longest sublist in a list of lists.\n    Returns 0 for an empty input list.\n    \"\"\"\n    if not list_of_lists:\n        return 0\n    \n    lengths = [len(sublist) for sublist in list_of_lists]\n    return max(lengths)"}
{"task_id": "Mbpp/563", "solution": "import re\ndef extract_values(text: str) -> list[str]:\n    \"\"\"Extracts double-quoted substrings from a text, handling escaped quotes.\n    Escaped quotes within a value are unescaped in the final output.\"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n    # Regex to find content within double quotes, handling escaped quotes.\n    # It matches a double quote, then a non-greedy group of:\n    #   - any character that is not a double quote or backslash\n    #   - OR a backslash followed by any character (to handle escaped quotes)\n    # until a closing double quote.\n    matches = re.findall(r'\"((?:[^\"\\\\]|\\\\.)*)\"', text)\n    return [match.replace('\\\\\"', '\"') for match in matches]"}
{"task_id": "Mbpp/563", "solution": "import re\ndef extract_values(text: str) -> list[str]:\n    \"\"\"\n    Extracts all substrings enclosed within double quotation marks from the input text.\n    Returns an empty list if no values are found.\n    \"\"\"\n    return re.findall(r'\\\"([^\\\"]*)\\\"', text)"}
{"task_id": "Mbpp/564", "solution": "def count_Pairs(data_list: list[int], n: int) -> int:\n    \"\"\"\n    Counts unique, unordered pairs of unequal integers from a given list.\n    Elements are treated as distinct based on their position.\n    \"\"\"\n    count = 0\n    # Iterate through all possible unique unordered pairs of indices (i, j) where i < j.\n    for i in range(len(data_list)):\n        for j in range(i + 1, len(data_list)):\n            # If elements at these distinct positions are unequal, increment the count.\n            if data_list[i] != data_list[j]:\n                count += 1\n    return count"}
