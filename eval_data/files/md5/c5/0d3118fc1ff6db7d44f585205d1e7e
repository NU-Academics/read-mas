{"task_id": "Mbpp/427", "solution": "import re\ndef change_date_format(date_string: str) -> str:\n    \"\"\"\n    Converts a date string from 'yyyy-mm-dd' to 'dd-mm-yyyy' format.\n\n    Args:\n        date_string: The date string in 'yyyy-mm-dd' format.\n\n    Returns:\n        The date string in 'dd-mm-yyyy' format.\n\n    Raises:\n        ValueError: If the input date_string is not in the expected 'yyyy-mm-dd' format.\n    \"\"\"\n    date_regex = r\"^\\d{4}-\\d{2}-\\d{2}$\"\n    if not re.match(date_regex, date_string):\n        raise ValueError(\"Invalid date format. Expected YYYY-MM-DD.\")\n\n    year, month, day = date_string.split('-')\n    return f\"{day}-{month}-{year}\""}
{"task_id": "Mbpp/428", "solution": "def shell_sort(arr):\n    \"\"\"\n    Sorts a list in ascending order using the Shell Sort algorithm.\n    It modifies the list in-place and returns the sorted list.\n    \"\"\"\n    n = len(arr)\n    gap = n // 2\n\n    while gap > 0:\n        for i in range(gap, n):\n            temp = arr[i]\n            j = i\n            while j >= gap and arr[j - gap] > temp:\n                arr[j] = arr[j - gap]\n                j -= gap\n            arr[j] = temp\n        gap //= 2\n    return arr"}
