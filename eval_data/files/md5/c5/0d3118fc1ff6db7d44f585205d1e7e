{"task_id": "Mbpp/731", "solution": "import math\ndef lateralsurface_cone(r: float, h: float) -> float:\n    \"\"\"Calculates the lateral surface area of a cone.\n    Assumes positive numerical inputs for radius and height.\"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    area = math.pi * r * slant_height\n    return area"}
{"task_id": "Mbpp/728", "solution": "def sum_list(list_a, list_b):\n    \"\"\"\n    Calculates the element-wise sum of two input lists.\n\n    Args:\n        list_a: The first list of numbers (int or float).\n        list_b: The second list of numbers (int or float).\n\n    Returns:\n        A new list containing the sums of corresponding elements.\n\n    Raises:\n        ValueError: If list_a and list_b have different lengths.\n        TypeError: If any element in list_a or list_b is not a number.\n    \"\"\"\n    if len(list_a) != len(list_b):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    result_list = []\n    for i in range(len(list_a)):\n        val_a = list_a[i]\n        val_b = list_b[i]\n\n        if not isinstance(val_a, (int, float)) or not isinstance(val_b, (int, float)):\n            raise TypeError(\"All elements in input lists must be numbers (int or float).\")\n\n        result_list.append(val_a + val_b)\n\n    return result_list"}
{"task_id": "Mbpp/731", "solution": "import math\ndef lateralsurface_cone(r: float, h: float) -> float:\n    \"\"\"Calculates the lateral surface area of a cone.\n    It uses the radius (r) and height (h) to compute the slant height and then the area.\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    lateral_area = math.pi * r * slant_height\n    return lateral_area"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(input_string: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, and dots with colons in the input string.\n    It trusts the caller to provide a string input.\n    \"\"\"\n    modified_string = input_string.replace(' ', ':')\n    modified_string = modified_string.replace(',', ':')\n    modified_string = modified_string.replace('.', ':')\n    return modified_string"}
{"task_id": "Mbpp/732", "solution": "CHARS_TO_REPLACE = (' ', ',', '.')\ndef replace_specialchar(input_string: str) -> str:\n    \"\"\"Replaces spaces, commas, and dots with colons in the input string.\"\"\"\n    modified_string = input_string\n    for char in CHARS_TO_REPLACE:\n        modified_string = modified_string.replace(char, ':')\n    return modified_string"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array.\n    Returns the index, or -1 if the target is not found or the array is empty.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == target:\n            result = mid\n            high = mid - 1\n        elif arr[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(sorted_array: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array.\n    Returns its lowest index or -1 if the target is not found.\n    \"\"\"\n    low = 0\n    high = len(sorted_array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if sorted_array[mid] == target:\n            result = mid\n            high = mid - 1  # Continue searching in the left half for the first occurrence\n        elif sorted_array[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(numbers):\n    \"\"\"\n    Calculates the sum of products of all contiguous sublists within the input list.\n    For example, for [1, 2, 3], the sum of products is 20.\n    \"\"\"\n    total_sum = 0\n    n = len(numbers)\n\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= numbers[j]\n            total_sum += current_product\n    return total_sum"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"Toggles all bits of an integer except the most significant and least significant bits.\n    If the number has 1 or 2 bits in its binary representation, it is returned unchanged.\n    \"\"\"\n    binary_str = bin(number)[2:]  # Convert to binary string and remove '0b' prefix\n\n    if len(binary_str) <= 2:\n        return number  # No middle bits to toggle if length is 1 or 2\n\n    msb = binary_str[0]\n    lsb = binary_str[-1]\n    middle_bits = binary_str[1:-1]\n\n    # Toggle each bit in the middle section\n    toggled_middle_bits = \"\".join(['1' if bit == '0' else '0' for bit in middle_bits])\n\n    # Reconstruct the binary string and convert back to an integer\n    result_binary_str = msb + toggled_middle_bits + lsb\n    return int(result_binary_str, 2)"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of products of all possible sublists of a given list of integers.\n    The function assumes valid input as per critical requirements.\n    \"\"\"\n    total_sum = 0\n    n = len(numbers)\n\n    # Iterate through all possible sublists to calculate their products and sum them.\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= numbers[j]\n            total_sum += current_product\n    return total_sum"}
{"task_id": "Mbpp/735", "solution": "def _get_msb_pos(number: int) -> int:\n    \"\"\"Finds the 0-indexed position of the most significant set bit (MSB).\n    Returns -1 if the number is 0.\n    \"\"\"\n    if number == 0:\n        return -1\n    return number.bit_length() - 1\ndef _get_lsb_pos(number: int) -> int:\n    \"\"\"Finds the 0-indexed position of the least significant set bit (LSB).\n    Returns -1 if the number is 0.\n    \"\"\"\n    if number == 0:\n        return -1\n    pos = 0\n    while (number >> pos) & 1 == 0:\n        pos += 1\n    return pos\ndef _create_middle_mask(msb_pos: int, lsb_pos: int) -> int:\n    \"\"\"Generates a bitmask with bits set between lsb_pos and msb_pos (exclusive).\n    Returns 0 if there are no middle bits to toggle.\n    \"\"\"\n    if msb_pos <= lsb_pos + 1:\n        return 0\n    \n    mask = 0\n    for i in range(lsb_pos + 1, msb_pos):\n        mask |= (1 << i)\n    return mask\ndef toggle_middle_bits(number: int) -> int:\n    \"\"\"Toggles all bits strictly between the most significant and least significant set bits of a number.\n    Returns the original number if it has zero, one, or two set bits.\n    \"\"\"\n    if number == 0:\n        return 0\n\n    msb_pos = _get_msb_pos(number)\n    lsb_pos = _get_lsb_pos(number)\n    \n    mask = _create_middle_mask(msb_pos, lsb_pos)\n    \n    return number ^ mask"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list: list, value: object) -> int:\n    \"\"\"\n    Finds the leftmost insertion point for 'value' in 'sorted_list' using binary search.\n    Returns index 'i' such that all elements before 'i' are less than 'value', and all at or after 'i' are >= 'value'.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/736", "solution": "from typing import Any\ndef left_insertion(sorted_list: list, value: Any) -> int:\n    \"\"\"\n    Locates the leftmost insertion point for a value in a sorted list.\n    This function implements a binary search to find the correct index.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
