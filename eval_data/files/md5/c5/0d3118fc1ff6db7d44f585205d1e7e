{"task_id": "Mbpp/255", "solution": "from typing import List, Tuple, Any\ndef combinations_colors(elements: List[Any], n: int) -> List[Tuple[Any, ...]]:\n    \"\"\"\n    Generates all combinations with repetition of length n from the given elements.\n    Returns a list of tuples, where each tuple is a unique combination.\n    \"\"\"\n    if n < 0:\n        return []\n    if not elements:\n        return [()] if n == 0 else []\n\n    result: List[Tuple[Any, ...]] = []\n    current_combination: List[Any] = []\n\n    def _recursive_generate(start_index: int, current_length: int):\n        if current_length == n:\n            result.append(tuple(current_combination))\n            return\n\n        for i in range(start_index, len(elements)):\n            current_combination.append(elements[i])\n            _recursive_generate(i, current_length + 1)\n            current_combination.pop()\n\n    _recursive_generate(0, 0)\n    return result"}
{"task_id": "Mbpp/255", "solution": "def combinations_colors(elements: list, n: int) -> list[tuple]:\n    \"\"\"Generates all combinations with repetition from a list of elements for a specified length.\"\"\"\n    if n == 0:\n        return [()]\n    if not elements and n > 0:\n        return []\n\n    result = []\n    \n    def _generate_recursive_internal(current_combination: list) -> None:\n        \"\"\"Recursive helper to build combinations incrementally.\"\"\"\n        if len(current_combination) == n:\n            result.append(tuple(current_combination))\n            return\n\n        for element in elements:\n            current_combination.append(element)\n            _generate_recursive_internal(current_combination)\n            current_combination.pop()\n\n    _generate_recursive_internal([])\n    return result"}
{"task_id": "Mbpp/256", "solution": "def count_Primes_nums(num: int) -> int:\n    \"\"\"\n    Counts the number of prime numbers strictly less than the given non-negative integer.\n    This function implements the Sieve of Eratosthenes algorithm.\n    \"\"\"\n    if num <= 2:\n        return 0\n\n    # Initialize a boolean array 'is_prime' where is_prime[i] is true if i is potentially prime.\n    # The sieve runs up to num-1, so we create an array of size 'num'.\n    is_prime = [True] * num\n    is_prime[0] = is_prime[1] = False  # 0 and 1 are not considered prime numbers.\n\n    # Apply the Sieve of Eratosthenes algorithm.\n    p = 2\n    # Iterate from p=2 up to the square root of num-1.\n    while (p * p) < num:\n        if is_prime[p]:\n            # Mark all multiples of p (starting from p*p) as not prime.\n            for multiple in range(p * p, num, p):\n                is_prime[multiple] = False\n        p += 1\n\n    # Count all true values in 'is_prime' from index 2 up to num-1.\n    count = 0\n    for i in range(2, num):\n        if is_prime[i]:\n            count += 1\n            \n    return count"}
{"task_id": "Mbpp/256", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Checks if a number is prime.\n    Assumes positive integer input for n.\"\"\"\n    if n < 2:\n        return False\n    i = 2\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 1\n    return True\ndef count_Primes_nums(num: int) -> int:\n    \"\"\"Counts prime numbers strictly less than num.\n    Assumes num is a non-negative integer.\"\"\"\n    if num <= 2:\n        return 0\n\n    count = 0\n    for i in range(2, num):\n        if is_prime(i):\n            count += 1\n    return count"}
