{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_num: int) -> str:\n    \"\"\"Converts a non-negative integer to its binary string representation.\n    Returns \"0\" for input 0, otherwise converts by repeated division and remainder collection.\n    \"\"\"\n    if decimal_num == 0:\n        return \"0\"\n\n    binary_digits = []\n    temp_num = decimal_num\n    while temp_num > 0:\n        remainder = temp_num % 2\n        binary_digits.append(str(remainder))\n        temp_num //= 2\n\n    return \"\".join(binary_digits[::-1])"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"Converts a non-negative decimal integer to its binary string representation.\n    This function assumes the input is a valid non-negative integer.\n    \"\"\"\n    if decimal_number == 0:\n        return \"0\"\n\n    binary_digits = []\n    temp_number = decimal_number\n    while temp_number > 0:\n        binary_digits.append(str(temp_number % 2))\n        temp_number //= 2\n    return \"\".join(binary_digits[::-1])"}
{"task_id": "Mbpp/98", "solution": "from typing import Union, Tuple\ndef multiply_num(numbers: Tuple[Union[int, float], ...]) -> float:\n    \"\"\"\n    Multiplies all numbers in an iterable and divides by its length.\n    Returns 0.0 if the input iterable is empty, as per specification.\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    product = 1.0\n    for num in numbers:\n        product *= num\n\n    return product / len(numbers)"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers):\n    \"\"\"\n    Multiplies all numbers in an iterable and divides the product by the iterable's length.\n\n    Args:\n        numbers: An iterable (e.g., list or tuple) of numbers (int or float).\n\n    Returns:\n        A float representing the product of all numbers divided by the count of numbers.\n        Returns 0.0 if the input iterable is empty.\n\n    Raises:\n        TypeError: If the input 'numbers' is not an iterable or contains non-numeric elements.\n    \"\"\"\n    if not isinstance(numbers, (list, tuple)):\n        raise TypeError(\"Input 'numbers' must be an iterable (e.g., list or tuple).\")\n\n    if not numbers:\n        return 0.0\n\n    product = 1.0\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise TypeError(\"Iterable elements must be numbers (int or float).\")\n        product *= num\n\n    return product / len(numbers)"}
