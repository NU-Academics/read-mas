{"task_id": "Mbpp/737", "solution": "import re\ndef check_str(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string starts with a vowel (a, e, i, o, u), case-insensitively.\n    This is achieved by applying a regular expression to the input.\n    \"\"\"\n    VOWEL_START_PATTERN = r\"^[aeiou]\"\n    match = re.match(VOWEL_START_PATTERN, input_string, re.IGNORECASE)\n    return match is not None"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple: tuple) -> dict:\n    \"\"\"\n    Converts a tuple into a dictionary where adjacent elements form key-value pairs.\n\n    Args:\n        input_tuple: The input tuple to be converted. Must have an even number of elements.\n\n    Returns:\n        A dictionary formed from the tuple's key-value pairs.\n\n    Raises:\n        ValueError: If the input tuple has an odd number of elements.\n    \"\"\"\n    if len(input_tuple) % 2 != 0:\n        raise ValueError(\"Input tuple must have an even number of elements.\")\n\n    return dict(zip(input_tuple[::2], input_tuple[1::2]))"}
{"task_id": "Mbpp/739", "solution": "def find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index k of the smallest triangular number T_k that has exactly n digits.\n    It iteratively checks triangular numbers until one meets the digit count requirement.\n    \"\"\"\n    lower_bound = 10**(n - 1)\n    k = 1\n    while True:\n        triangular_number = k * (k + 1) // 2\n        if triangular_number >= lower_bound:\n            return k\n        k += 1"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(text):\n    \"\"\"Checks if all characters in the string are identical.\n    Returns True for empty or single-character strings.\"\"\"\n    if len(text) <= 1:\n        return True\n    \n    first_char = text[0]\n    for char in text[1:]:\n        if char != first_char:\n            return False\n    return True"}
{"task_id": "Mbpp/739", "solution": "import math\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Calculates the index k of the smallest triangular number T_k that has at least n digits.\n    This is derived by solving T_k = k * (k + 1) / 2 >= 10^(n-1) for k.\n    \"\"\"\n    min_n_digit = 10**(n - 1)\n    discriminant = 1 + 8 * min_n_digit\n    k_float = (-1 + math.sqrt(discriminant)) / 2\n    return math.ceil(k_float)"}
