{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(mainlist, sublist):\n    \"\"\"Checks if 'sublist' is a contiguous sublist of 'mainlist'.\n    An empty list is considered a sublist of any list.\"\"\"\n    if not sublist:\n        return True\n\n    n = len(mainlist)\n    m = len(sublist)\n\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        if mainlist[i:i + m] == sublist:\n            return True\n    return False"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"Calculates the last digit of the factorial of a given number n.\n    Returns 0 for n >= 5, otherwise calculates the last digit directly.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n    if n >= 5:\n        return 0\n\n    # Handle cases for n < 5 directly.\n    if n == 0:\n        return 1\n    elif n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4 # Last digit of 4! (24) is 4"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list: list, sub_list: list) -> bool:\n    \"\"\"Checks if sub_list is a contiguous sublist of main_list.\n    An empty list is considered a sublist of any list.\"\"\"\n    if not sub_list:\n        return True\n\n    n = len(main_list)\n    m = len(sub_list)\n\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        if main_list[i:i+m] == sub_list:\n            return True\n    return False"}
