{"task_id": "HumanEval/3", "solution": "from typing import List\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" Detects if the account balance falls below zero at any point.\n    The account starts with a zero balance.\n    \"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/0", "solution": "from typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    for i in range(len(numbers)):\n        for j in range(i + 1, len(numbers)):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n\n    class _ParenString:\n        \"\"\"Encapsulates the raw and cleaned input string, handling space removal.\"\"\"\n        def __init__(self, raw_string: str):\n            self._raw_value = raw_string\n            self.cleaned_value = raw_string.replace(' ', '')\n\n    class _ParenGroup:\n        \"\"\"Represents a single balanced parenthesis group, storing its value and original indices.\"\"\"\n        def __init__(self, value: str, start: int, end: int):\n            self.value = value\n            self.start_index = start\n            self.end_index = end\n\n        def is_balanced(self) -> bool:\n            \"\"\"Checks if the group's value is balanced.\"\"\"\n            balance = 0\n            for char in self.value:\n                if char == '(':\n                    balance += 1\n                elif char == ')':\n                    balance -= 1\n                if balance < 0:\n                    return False\n            return balance == 0\n\n    class _SeparatedGroups:\n        \"\"\"Manages a collection of _ParenGroup objects, providing methods to add and retrieve them.\"\"\"\n        def __init__(self):\n            self._groups: List[_ParenGroup] = []\n\n        def add_group(self, group: _ParenGroup):\n            \"\"\"Adds a ParenGroup to the collection.\"\"\"\n            self._groups.append(group)\n\n        def get_groups(self) -> List[_ParenGroup]:\n            \"\"\"Returns the list of contained ParenGroup objects.\"\"\"\n            return self._groups\n\n    paren_str = _ParenString(paren_string)\n    cleaned_s = paren_str.cleaned_value\n    \n    potential_groups = _SeparatedGroups()\n    \n    # Identify all balanced groups\n    # This approach finds all possible balanced groups, even nested ones.\n    # The filtering step will then select only the top-level ones.\n    for i in range(len(cleaned_s)):\n        balance = 0\n        for j in range(i, len(cleaned_s)):\n            char = cleaned_s[j]\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            \n            if balance == 0 and char == ')':\n                group_value = cleaned_s[i : j+1]\n                group = _ParenGroup(group_value, i, j)\n                if group.is_balanced():\n                    potential_groups.add_group(group)\n\n    all_potential_groups = potential_groups.get_groups()\n    final_groups: List[_ParenGroup] = []\n\n    # Filter non-nested groups (top-level only)\n    # A group is top-level if it is not fully contained within another, larger top-level group.\n    # We sort by length to process larger groups first, or by start index for stable processing.\n    # Sorting by length helps identify outer groups, then we check for containment.\n    # A simpler approach for non-nested: a group is top-level if it is not contained by *any* other group found.\n    \n    # For this problem, 'separate groups are ... not nested within each other' implies top-level.\n    # This means if we find '(()())', we want that, not '()' and '()' inside.\n    # The example `'( ) (( )) (( )( ))'` -> `['()', '(())', '(()())']` confirms this.\n    # The groups `()`, `(())`, and `(()())` are all top-level in their respective contexts.\n\n    # A more robust filtering for non-nested:\n    # After finding all balanced groups, iterate through them.\n    # A group is considered \"final\" if no other \"final\" group fully contains it.\n    \n    # Sort groups by their starting index and then by length (descending)\n    # This ensures that larger, outer groups appear before smaller, inner ones starting at the same point.\n    all_potential_groups.sort(key=lambda g: (g.start_index, -(g.end_index - g.start_index)))\n\n    \n    # This approach correctly handles non-nested top-level groups\n    # by ensuring that once a group is added to final_groups,\n    # no subsequent group (which would either start later or be shorter\n    # if it started at the same point) can overlap it from inside.\n    \n    \n    # The problem statement says \"separate groups are ... not nested within each other\".\n    # This implies that the output groups should be distinct segments of the *cleaned_s* string.\n    # For example, if cleaned_s is \"()()\", the groups are \"()\" and \"()\".\n    # If cleaned_s is \"(())\", the group is \"(())\".\n    # If cleaned_s is \"((()))\", the group is \"((()))\".\n    \n    # Re-evaluating the filtering:\n    # The example `'( ) (( )) (( )( ))'` -> `['()', '(())', '(()())']`\n    # The cleaned string is `()(())(()())`.\n    # The groups `()` and `(())` and `(()())` are indeed non-overlapping in the cleaned string.\n    \n    # This means we should find groups that are non-overlapping in the input string `cleaned_s`.\n    \n    last_end_index = -1\n    for group in all_potential_groups:\n        # Check if the group starts after the last accepted group's end index.\n        # This ensures we pick non-overlapping, sequential top-level groups.\n        if group.start_index > last_end_index:\n            final_groups.append(group)\n            last_end_index = group.end_index\n\n    # The above filter still does not guarantee the correct result for `((()))` if `()` is also found.\n    # Let's consider `((()))`. Potential groups could be `()`, `(())`, `((()))`.\n    # Using the above filtering:\n    # if `()` is found at 1,2: last_end_index = 2.\n    # if `(())` is found at 0,3: not > 2.\n    # if `((()))` is found at 0,5: not > 2.\n    # This would yield `()`, which is wrong. We want the outermost balanced group for a segment.\n\n    # A better approach for finding top-level non-overlapping groups:\n    # Iterate through the cleaned string. Maintain a balance counter.\n    # When balance returns to 0 after being positive, a top-level group has ended.\n    \n    result_strings: List[str] = []\n    current_group_start = 0\n    balance = 0\n\n    for i, char in enumerate(cleaned_s):\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        # If balance returns to 0, we've found a top-level, balanced group.\n        # This group spans from `current_group_start` to `i`.\n        if balance == 0:\n            result_strings.append(cleaned_s[current_group_start : i+1])\n            # The next top-level group will start immediately after this one.\n            current_group_start = i + 1\n        # If balance goes negative, it's an unmatched closing parenthesis.\n        # Since the problem implies balanced input, this shouldn't happen for *groups*.\n        # For overall balance, it can. But for separating groups, we assume individual groups are balanced.\n        # We implicitly handle only properly balanced structures.\n\n    return result_strings\n```"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    # Calculate the mean of the input numbers.\n    mean_val = sum(numbers) / len(numbers)\n\n    # Calculate the absolute difference between each number and the mean.\n    abs_diffs = [abs(num - mean_val) for num in numbers]\n\n    # Calculate the average of these absolute differences.\n    mad_val = sum(abs_diffs) / len(abs_diffs)\n\n    return mad_val"}
{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    integer_part = math.floor(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    def _calculate_group_nesting(group_string: str) -> int:\n        \"\"\"\n        Calculates the deepest nesting level for a single group of parentheses.\n        Iterates through characters to track current and maximum nesting.\n        \"\"\"\n        current_nesting = 0\n        max_nesting = 0\n        for char in group_string:\n            if char == '(':\n                current_nesting += 1\n                max_nesting = max(max_nesting, current_nesting)\n            elif char == ')':\n                current_nesting -= 1\n        return max_nesting\n\n    groups = paren_string.split(' ')\n    results = []\n    for group_string in groups:\n        if group_string:  # Handle potential empty strings from multiple spaces\n            results.append(_calculate_group_nesting(group_string))\n    return results"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n    for number in numbers:\n        total_sum += number\n        total_product *= number\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_maximums = []\n    current_max = numbers[0]\n\n    for number in numbers:\n        if number > current_max:\n            current_max = number\n        rolling_maximums.append(current_max)\n\n    return rolling_maximums"}
{"task_id": "HumanEval/11", "solution": "def _validate_binary_string(s: str, name: str) -> None:\n    \"\"\"Validates if a string consists only of '0's and '1's.\"\"\"\n    if not s.strip():\n        raise ValueError(f\"Input string '{name}' cannot be empty or whitespace.\")\n    if not all(char in ('0', '1') for char in s):\n        raise ValueError(f\"Input string '{name}' must consist only of '0's and '1's.\")\n\ndef _validate_equal_length(a: str, b: str) -> None:\n    \"\"\"Validates if two strings have equal length.\"\"\"\n    if len(a) != len(b):\n        raise ValueError(\"Input strings 'a' and 'b' must have equal length.\")\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    _validate_binary_string(a, \"a\")\n    _validate_binary_string(b, \"b\")\n    _validate_equal_length(a, b)\n\n    result_chars = []\n    for i in range(len(a)):\n        if a[i] == b[i]:\n            result_chars.append('0')\n        else:\n            result_chars.append('1')\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_string = strings[0]\n    for s in strings[1:]:\n        if len(s) > len(longest_string):\n            longest_string = s\n    return longest_string"}
{"task_id": "HumanEval/14", "solution": "def all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\"\"\"\n    prefixes = []\n    for i in range(1, len(string) + 1):\n        prefixes.append(string[0:i])\n    return prefixes"}
