{"task_id": "Mbpp/7", "solution": "def find_char_long(input_string: str) -> list[str]:\n    \"\"\"\n    Finds all words in a string that are at least 4 characters long, preserving original case.\n    Words are separated by whitespace.\n    \"\"\"\n    words = input_string.split()\n    long_words = [word for word in words if len(word) >= 4]\n    return long_words"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(number: int) -> bool:\n    \"\"\"\n    Identifies if a given number is not a prime number.\n    Returns True for non-prime numbers, False for prime numbers.\n    \"\"\"\n    if number <= 1:\n        return True  # Numbers less than or equal to 1 are not prime\n    if number == 2:\n        return False  # 2 is a prime number\n    if number % 2 == 0:\n        return True  # Even numbers greater than 2 are not prime\n\n    # Check for odd divisors from 3 up to the square root of the number\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return True  # Found a divisor, so it's not prime\n        i += 2\n    return False  # No divisors found, so it's prime"}
