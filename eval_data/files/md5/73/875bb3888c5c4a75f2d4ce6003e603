{"task_id": "Mbpp/635", "solution": "from typing import List\n\ndef _heapify(arr: List[int], n: int, i: int) -> None:\n    # Maintain the max-heap property for a subtree rooted at index i.\n    # `n` is the current size of the heap.\n    largest = i\n    left = 2 * i + 1\n    right = 2 * i + 2\n\n    if left < n and arr[left] > arr[largest]:\n        largest = left\n\n    if right < n and arr[right] > arr[largest]:\n        largest = right\n\n    if largest != i:\n        arr[i], arr[largest] = arr[largest], arr[i]\n        _heapify(arr, n, largest)\n\ndef _build_max_heap(arr: List[int]) -> None:\n    # Build a max-heap from an unsorted array by heapifying all non-leaf nodes.\n    n = len(arr)\n    for i in range(n // 2 - 1, -1, -1):\n        _heapify(arr, n, i)\n\ndef _extract_elements(arr: List[int]) -> List[int]:\n    # Extract elements from the heap one by one to sort the array in place.\n    n = len(arr)\n    for i in range(n - 1, 0, -1):\n        arr[i], arr[0] = arr[0], arr[i]  # Move current root (largest) to end\n        _heapify(arr, i, 0)  # Re-heapify the reduced heap\n    return arr\n\ndef heap_sort(input_list: List[int]) -> List[int]:\n    # Sorts a list of integers using the heap sort algorithm.\n    # Returns a new sorted list without modifying the original input.\n    arr = list(input_list)\n\n    if len(arr) <= 1:\n        return arr\n\n    _build_max_heap(arr)\n    _extract_elements(arr)\n\n    return arr"}
{"task_id": "Mbpp/638", "solution": "def wind_chill(wind_velocity: float, temperature: float) -> int:\n    \"\"\"\n    Calculates the wind chill index given wind velocity (km/h) and temperature (Celsius).\n    The result is rounded to the nearest integer as indicated by the test case.\n    \"\"\"\n    # Formula for wind chill index using temperature in Celsius and wind velocity in km/h.\n    # WC = 13.12 + 0.6215T - 11.37V^0.16 + 0.3965T V^0.16\n    # where T is temperature and V is wind velocity.\n\n    v_to_power_0_16 = wind_velocity ** 0.16\n\n    wind_chill_value = (13.12 +\n                        (0.6215 * temperature) -\n                        (11.37 * v_to_power_0_16) +\n                        (0.3965 * temperature * v_to_power_0_16))\n    \n    # Round the calculated wind chill value to the nearest integer.\n    return round(wind_chill_value)"}
{"task_id": "Mbpp/639", "solution": "def sample_nam(names):\n    \"\"\"\n    Calculates the sum of lengths of names that start with an uppercase letter.\n    Filters the input list and then sums the lengths of the valid names.\n    \"\"\"\n    filtered_names = []\n    for name in names:\n        if name and name[0].isupper():\n            filtered_names.append(name)\n\n    total_length = 0\n    for name in filtered_names:\n        total_length += len(name)\n\n    return total_length"}
