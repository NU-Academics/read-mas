{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix: list[list[float]]) -> float:\n    \"\"\"\n    Finds a path from the top-left to the bottom-right cell in a square matrix\n    with the maximum average cost, moving only right or down.\n    \"\"\"\n    N = len(matrix)\n\n    if N == 1:\n        return float(matrix[0][0])\n\n    max_average = -float('inf')\n    # All valid paths from (0,0) to (N-1,N-1) in an N*N grid\n    # moving only right or down have a fixed length of 2*N - 1 cells.\n    path_length = 2 * N - 1\n\n    def dfs(r, c, current_sum):\n        nonlocal max_average\n\n        # Base case: Reached the bottom-right cell\n        if r == N - 1 and c == N - 1:\n            max_average = max(max_average, current_sum / path_length)\n            return\n\n        # Move right\n        if c + 1 < N:\n            dfs(r, c + 1, current_sum + matrix[r][c+1])\n\n        # Move down\n        if r + 1 < N:\n            dfs(r + 1, c, current_sum + matrix[r+1][c])\n\n    # Start DFS from the top-left cell with its initial cost\n    dfs(0, 0, matrix[0][0])\n\n    return max_average"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base, power):\n    \"\"\"\n    Calculates the sum of all digits of the base raised to the specified power.\n    Handles large numbers by converting the result to a string for digit extraction.\n    \"\"\"\n    # Calculate base raised to power, which can result in a very large integer.\n    calculated_power_result = pow(base, power)\n\n    # Convert the large number to a string to easily iterate over its digits.\n    # Then, convert each character digit back to an integer and sum them up.\n    digit_sum = sum(int(digit_char) for digit_char in str(calculated_power_result))\n\n    return digit_sum"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple):\n    \"\"\"\n    Calculates the product of adjacent elements in an input tuple of numbers.\n    Returns a new tuple where the i-th element is the product of input_tuple[i] and input_tuple[i+1].\n    \"\"\"\n    products = []\n    for i in range(len(input_tuple) - 1):\n        products.append(input_tuple[i] * input_tuple[i+1])\n    return tuple(products)"}
{"task_id": "Mbpp/725", "solution": "def extract_quotation(input_string: str) -> list[str]:\n    \"\"\"\n    Extracts all text values enclosed within double quotation marks from the input string.\n    Returns a list of extracted quoted content in their original order.\n    \"\"\"\n    extracted_quotes = []\n    in_quote = False\n    current_quote_content = []\n\n    for char in input_string:\n        if char == '\"':\n            if in_quote:  # Found a closing quote\n                extracted_quotes.append(\"\".join(current_quote_content))\n                current_quote_content = []  # Reset for next quote\n            in_quote = not in_quote  # Toggle quote state\n        elif in_quote:  # If inside a quote and not a quote character itself\n            current_quote_content.append(char)\n\n    return extracted_quotes"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list: list) -> list:\n    \"\"\"Removes consecutive duplicate elements from a list, preserving order and non-consecutive duplicates.\n    Returns a new list without modifying the original input list.\"\"\"\n    if not input_list:\n        return []\n\n    result = []\n    for item in input_list:\n        if not result or item != result[-1]:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/728", "solution": "def _is_numeric(value):\n    \"\"\"Checks if a value is numeric (int or float).\"\"\"\n    return isinstance(value, (int, float))\n\ndef validate_equal_length(list1, list2):\n    \"\"\"Ensures both input lists have the same length, raising ValueError if not.\"\"\"\n    if len(list1) != len(list2):\n        raise ValueError(\"Lists must have equal length\")\n\ndef validate_numeric_lists(list1, list2):\n    \"\"\"Checks if all elements in both lists are numeric, raising TypeError if not.\"\"\"\n    for val1, val2 in zip(list1, list2):\n        if not _is_numeric(val1) or not _is_numeric(val2):\n            raise TypeError(\"All elements must be numeric\")\n\ndef perform_element_addition(list1, list2):\n    \"\"\"Performs element-wise addition of two lists.\"\"\"\n    return [a + b for a, b in zip(list1, list2)]\n\ndef sum_list(list1, list2):\n    \"\"\"\n    Computes the element-wise sum of two numeric lists.\n    Raises ValueError if lists have unequal length, TypeError if elements are non-numeric.\n    \"\"\"\n    validate_equal_length(list1, list2)\n    validate_numeric_lists(list1, list2)\n    return perform_element_addition(list1, list2)"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(input_string):\n    \"\"\"\n    Replaces spaces, commas, or dots in the input string with colons.\n    Processes the string character by character to build the modified result.\n    \"\"\"\n    result = []\n    for char in input_string:\n        if char == ' ' or char == ',' or char == '.':\n            result.append(':')\n        else:\n            result.append(char)\n    return \"\".join(result)"}
{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(radius: float, height: float) -> float:\n    \"\"\"\n    Calculate the lateral surface area of a cone.\n\n    Args:\n        radius (float): The radius of the cone's base\n        height (float): The height of the cone\n\n    Returns:\n        float: The lateral surface area\n\n    Formula: \u03c0 \u00d7 r \u00d7 \u221a(r\u00b2 + h\u00b2)\n    \"\"\"\n    slant_height = math.sqrt(radius**2 + height**2)\n    lateral_surface_area = math.pi * radius * slant_height\n    return lateral_surface_area"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array, target):\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array using binary search.\n    Returns -1 if the target is not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            result = mid\n            high = mid - 1  # Try to find an earlier occurrence in the left half\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n            \n    return result"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"\n    Toggles all bits of the number except the first (MSB) and the last (LSB).\n    Assumes positive integers.\n    \"\"\"\n    if number == 0:\n        return 0\n\n    # Calculate the bit length of the number\n    # For number=9 (1001), bit_length = 4\n    bit_length = number.bit_length()\n\n    # Handle numbers with 1 or 2 bits where there are no \"middle\" bits to toggle.\n    # e.g., 1 (01), 2 (10), 3 (11)\n    if bit_length <= 2:\n        return number\n\n    # Create a mask to toggle the middle bits.\n    # For bit_length=4, we want to toggle bits at positions 1 and 2 (0-indexed).\n    # Mask should be 0110 (6).\n    # A full mask of `bit_length` bits is `(1 << bit_length) - 1`.\n    # To remove the MSB, XOR with `(1 << (bit_length - 1))`.\n    # To remove the LSB, XOR with `1`.\n    # So the toggle mask is `((1 << bit_length) - 1) ^ (1 << (bit_length - 1)) ^ 1`.\n    full_mask = (1 << bit_length) - 1\n    msb_mask = (1 << (bit_length - 1))\n    lsb_mask = 1\n    \n    toggle_mask = full_mask ^ msb_mask ^ lsb_mask\n    \n    return number ^ toggle_mask"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list: list) -> int:\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists of a given list.\n    \"\"\"\n\n    def generate_sublists(input_list: list) -> list:\n        \"\"\"Generates all possible contiguous sublists from the input list.\"\"\"\n        all_sublists = []\n        n = len(input_list)\n        for i in range(n):\n            for j in range(i + 1, n + 1):\n                all_sublists.append(input_list[i:j])\n        return all_sublists\n\n    def calculate_product(sublist: list) -> int:\n        \"\"\"Calculates the product of all elements in a sublist.\"\"\"\n        if not sublist:\n            return 0\n        product = 1\n        for x in sublist:\n            product *= x\n        return product\n\n    def sum_products(products: list) -> int:\n        \"\"\"Sums all product values from a list of products.\"\"\"\n        return sum(products)\n\n    all_sublists = generate_sublists(input_list)\n    \n    products = []\n    for sublist in all_sublists:\n        products.append(calculate_product(sublist))\n        \n    return sum_products(products)"}
{"task_id": "Mbpp/737", "solution": "import re\n\ndef check_str(input_string):\n    \"\"\"\n    Checks if the given string starts with a vowel using regex.\n    The check is case-insensitive for 'a', 'e', 'i', 'o', 'u'.\n    \"\"\"\n    pattern = r'^[aeiouAEIOU]'\n    return re.match(pattern, input_string) is not None"}
{"task_id": "Mbpp/739", "solution": "def find_Index(n):\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    Iteratively calculates triangular numbers and checks their digit count.\n    \"\"\"\n    k = 1\n    while True:\n        # Calculate triangular number T(k) = k * (k + 1) / 2\n        # Use integer division as k*(k+1) is always even\n        triangular_number = (k * (k + 1)) // 2\n\n        # Count digits of the triangular number\n        # Convert to string and get length for digit count\n        digit_count = len(str(triangular_number))\n\n        if digit_count == n:\n            return k\n        k += 1"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(array: list[int], target: int) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted array using binary search.\n    Returns the index where the target should be inserted to maintain sorted order.\n    \"\"\"\n    low = 0\n    high = len(array)\n\n    while low < high:\n        mid = low + (high - low) // 2\n        if array[mid] < target:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple: tuple) -> dict:\n    \"\"\"Convert tuple to dictionary using adjacent elements as key-value pairs.\n    It pairs elements (key, value) from the input tuple, ignoring the last element if the tuple has an odd length.\n    \"\"\"\n    return dict(zip(input_tuple[::2], input_tuple[1::2]))"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(input_string: str) -> bool:\n    \"\"\"\n    Check whether all characters in a string are the same.\n    \"\"\"\n    if len(input_string) <= 1:\n        return True\n    first_char = input_string[0]\n    for char in input_string[1:]:\n        if char != first_char:\n            return False\n    return True"}
{"task_id": "Mbpp/742", "solution": "import math\n\ndef area_tetrahedron(edge_length):\n    \"\"\"\n    Calculates the surface area of a regular tetrahedron given its edge length.\n    Assumes valid (positive numeric) input for edge_length.\n    \"\"\"\n    # The surface area of a regular tetrahedron is sqrt(3) * a^2, where 'a' is the edge length.\n    surface_area = math.sqrt(3) * (edge_length ** 2)\n    return surface_area"}
{"task_id": "Mbpp/743", "solution": "def rotate_right(lst, positions):\n    \"\"\"\n    Rotates a list to the right by a specified number of items.\n    Handles empty lists and rotations greater than the list length.\n    \"\"\"\n    n = len(lst)\n    if n == 0:\n        return []\n\n    # Calculate effective rotation count (modulo list length)\n    k = positions % n\n\n    # Perform the rotation using list slicing and concatenation\n    return lst[n - k:] + lst[:n - k]"}
