{"task_id": "Mbpp/59", "solution": "def validate_positive_integer(n: int) -> bool:\n    \"\"\"Validate that input is a positive integer.\n    Returns True if n is a positive integer, False otherwise.\n    \"\"\"\n    return isinstance(n, int) and n > 0\n\ndef _calculate_octagonal_number(n: int) -> int:\n    \"\"\"Internal calculation using formula n(3n-2).\"\"\"\n    return n * (3 * n - 2)\n\ndef is_octagonal(n: int) -> int:\n    \"\"\"Calculate the nth octagonal number.\n\n    Raises:\n        ValueError: If n is not a positive integer.\n    \"\"\"\n    if not validate_positive_integer(n):\n        raise ValueError(\"Input must be a positive integer.\")\n    return _calculate_octagonal_number(n)"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(input_string: str) -> int:\n    \"\"\"\n    Counts the number of substrings where the sum of digits equals the substring length.\n    \"\"\"\n    def generate_substrings(s: str) -> list[str]:\n        \"\"\"Generates all contiguous substrings from an input string.\"\"\"\n        substrings = []\n        n = len(s)\n        for i in range(n):\n            for j in range(i, n):\n                substrings.append(s[i:j+1])\n        return substrings\n\n    def calculate_digit_sum(substring: str) -> int:\n        \"\"\"Calculates the sum of digit characters in a substring.\"\"\"\n        digit_sum = 0\n        for char in substring:\n            digit_sum += int(char)\n        return digit_sum\n\n    count = 0\n    all_substrings = generate_substrings(input_string)\n\n    for substring in all_substrings:\n        current_sum = calculate_digit_sum(substring)\n        if current_sum == len(substring):\n            count += 1\n    return count"}
