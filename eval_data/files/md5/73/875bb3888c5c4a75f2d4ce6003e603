{"task_id": "Mbpp/598", "solution": "def count_digits(number: int) -> int:\n    \"\"\"Counts the total number of digits in an integer.\"\"\"\n    if number == 0:\n        return 1\n    return len(str(abs(number)))\n\ndef extract_digits(number: int) -> list:\n    \"\"\"Extracts individual digits from an integer into a list.\"\"\"\n    return [int(d) for d in str(abs(number))]\n\ndef calculate_digit_sum(digits: list, power: int) -> int:\n    \"\"\"Calculates the sum of each digit raised to the specified power.\"\"\"\n    return sum(digit ** power for digit in digits)\n\ndef armstrong_number(number: int) -> bool:\n    \"\"\"Checks if a given number is an Armstrong number.\"\"\"\n    if number < 0: # Armstrong numbers are typically defined for non-negative integers\n        return False\n    \n    num_digits = count_digits(number)\n    digits = extract_digits(number)\n    calculated_sum = calculate_digit_sum(digits, num_digits)\n    \n    return calculated_sum == number"}
{"task_id": "Mbpp/597", "solution": "from typing import List\n\ndef find_kth(array1: List[int], array2: List[int], k: int) -> int:\n    \"\"\"\n    Finds the kth smallest element from two sorted arrays using a binary search approach.\n    \"\"\"\n\n    def _validate_inputs(arr1: List[int], arr2: List[int], k_val: int) -> None:\n        \"\"\"Validates input parameters: k must be within the total length of the arrays.\"\"\"\n        m, n = len(arr1), len(arr2)\n        total_len = m + n\n        if not (1 <= k_val <= total_len):\n            raise ValueError(f\"Invalid k value: {k_val}. Must be between 1 and {total_len} (inclusive).\")\n\n    def _binary_search_kth(arr1: List[int], arr2: List[int], k_val: int) -> int:\n        \"\"\"Implements the core binary search algorithm to find the kth element efficiently.\"\"\"\n        m, n = len(arr1), len(arr2)\n\n        # Ensure arr1 is the shorter array to optimize binary search range.\n        if m > n:\n            arr1, arr2 = arr2, arr1\n            m, n = n, m\n\n        # Binary search for 'i', the number of elements taken from arr1's left partition.\n        # 'j' is derived as k_val - i, being the elements from arr2's left partition.\n        low = max(0, k_val - n)  # Min possible 'i'\n        high = min(m, k_val)     # Max possible 'i'\n\n        while low <= high:\n            i = (low + high) // 2\n            j = k_val - i\n\n            # L1, R1 are the elements immediately before and after the partition point in arr1.\n            # L2, R2 are the elements immediately before and after the partition point in arr2.\n            L1 = arr1[i-1] if i > 0 else float('-inf')\n            R1 = arr1[i] if i < m else float('inf')\n            L2 = arr2[j-1] if j > 0 else float('-inf')\n            R2 = arr2[j] if j < n else float('inf')\n\n            if L1 <= R2 and L2 <= R1:\n                # Correct partition found where max of left parts is less than min of right parts.\n                return max(L1, L2)\n            elif L1 > R2:\n                # L1 is too large, meaning 'i' (elements from arr1) needs to be reduced.\n                high = i - 1\n            else: # L2 > R1\n                # L2 is too large, meaning 'i' (elements from arr1) needs to be increased.\n                low = i + 1\n        \n        # This point should theoretically not be reached if inputs are valid and arrays are sorted.\n        # Given _validate_inputs ensures a valid k, a return value will always be found.\n        return -1 # Fallback, though should be unreachable.\n\n    # Execute validation and then the core binary search algorithm.\n    _validate_inputs(array1, array2, k)\n    return _binary_search_kth(array1, array2, k)"}
{"task_id": "Mbpp/600", "solution": "def is_Even(number):\n    \"\"\"\n    Checks if a given number is even using the modulo operator.\n    An even number has a remainder of 0 when divided by 2.\n    \"\"\"\n    return number % 2 == 0"}
{"task_id": "Mbpp/602", "solution": "def first_repeated_char(input_string: str) -> str:\n    \"\"\"\n    Find the first repeated character in a string.\n\n    Args:\n        input_string (str): The string to analyze\n\n    Returns:\n        str: The first character that appears more than once\n    \"\"\"\n    seen_chars = set()\n    for char in input_string:\n        if char in seen_chars:\n            return char\n        seen_chars.add(char)"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n: int) -> tuple[int, float]:\n    \"\"\"\n    Calculate sum and average of first n natural numbers.\n\n    Args:\n        n (int): Number of natural numbers to process\n\n    Returns:\n        tuple[int, float]: (sum, average) where sum is int and average is float\n    \"\"\"\n    total_sum = (n * (n + 1)) // 2\n    average = total_sum / n\n    return (total_sum, average)"}
