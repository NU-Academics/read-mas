{"task_id": "Mbpp/123", "solution": "def calculate_proper_divisors_sum(number: int) -> int:\n    \"\"\"Calculates the sum of proper divisors for a given number.\n    Proper divisors include all positive divisors except the number itself.\n    \"\"\"\n    if number <= 1:\n        return 0\n\n    divisors_sum = 1  # 1 is always a proper divisor for numbers greater than 1\n    for i in range(2, int(number**0.5) + 1):\n        if number % i == 0:\n            divisors_sum += i\n            if i * i != number:\n                divisors_sum += number // i\n    return divisors_sum\n\ndef is_amicable_number(number: int) -> bool:\n    \"\"\"Determines if a number is part of an amicable pair.\n    An amicable number 'a' has a sum of proper divisors 'b' such that the sum of proper divisors of 'b' is 'a', where a != b.\n    \"\"\"\n    if number <= 1:\n        return False\n\n    sum_div_a = calculate_proper_divisors_sum(number)\n\n    # A number cannot be amicable with itself (perfect number case)\n    if sum_div_a == number:\n        return False\n\n    # The sum of divisors must be a positive integer > 1 to potentially form a pair\n    if sum_div_a <= 1:\n        return False\n\n    sum_div_b = calculate_proper_divisors_sum(sum_div_a)\n\n    return sum_div_b == number\n\ndef amicable_numbers_sum(upper_limit: int) -> int:\n    \"\"\"Calculates the sum of all amicable numbers from 1 up to a specified number.\n    Uses helper functions to identify and sum amicable pairs efficiently within the given range.\n    \"\"\"\n    total_sum = 0\n    processed_numbers = set() # Keeps track of numbers already added to avoid duplicates and re-computation\n\n    for num in range(1, upper_limit + 1):\n        if num in processed_numbers:\n            continue\n\n        if is_amicable_number(num):\n            # If 'num' is an amicable number, find its partner\n            partner = calculate_proper_divisors_sum(num)\n\n            # Add 'num' to the total sum and mark as processed\n            total_sum += num\n            processed_numbers.add(num)\n\n            # If the partner is within the upper_limit and not yet processed, add it\n            if partner <= upper_limit and partner not in processed_numbers:\n                total_sum += partner\n                processed_numbers.add(partner)\n\n    return total_sum"}
{"task_id": "Mbpp/125", "solution": "def validate_input(binary_string: str) -> bool:\n    \"\"\"Validates that input contains only '0' and '1' characters.\"\"\"\n    if not all(char in ('0', '1') for char in binary_string):\n        raise ValueError(\"Input string must contain only '0' and '1' characters.\")\n    return True\n\ndef count_chars(substring: str) -> tuple[int, int]:\n    \"\"\"Counts occurrences of '0' and '1' in a substring.\"\"\"\n    zero_count = substring.count('0')\n    one_count = substring.count('1')\n    return zero_count, one_count\n\ndef calculate_difference(zero_count: int, one_count: int) -> int:\n    \"\"\"Calculates absolute difference between zero and one counts.\"\"\"\n    return abs(zero_count - one_count)\n\ndef find_max_difference(differences: list) -> int:\n    \"\"\"Finds maximum value from a list of differences.\"\"\"\n    if not differences:\n        return 0\n    return max(differences)\n\ndef generate_substrings_and_analyze(binary_string: str) -> int:\n    \"\"\"Generates all substrings, calculates their differences, and finds the maximum.\"\"\"\n    n = len(binary_string)\n    all_differences = []\n\n    for i in range(n):\n        for j in range(i, n):\n            substring = binary_string[i : j + 1]\n            zero_count, one_count = count_chars(substring)\n            difference = calculate_difference(zero_count, one_count)\n            all_differences.append(difference)\n\n    return find_max_difference(all_differences)\n\ndef find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any sub-string of the given binary string.\n    Orchestrates the validation, substring generation, and difference calculation.\n    \"\"\"\n    validate_input(binary_string)\n    max_diff = generate_substrings_and_analyze(binary_string)\n    return max_diff"}
{"task_id": "Mbpp/126", "solution": "def _find_divisors(number: int) -> list[int]:\n    \"\"\"Find all divisors of a given number.\"\"\"\n    divs = []\n    for i in range(1, number + 1):\n        if number % i == 0:\n            divs.append(i)\n    return divs\n\ndef _find_common_divisors(divisors1: list[int], divisors2: list[int]) -> list[int]:\n    \"\"\"Find common divisors between two divisor lists.\"\"\"\n    set1 = set(divisors1)\n    common_divs = [d for d in divisors2 if d in set1]\n    return common_divs\n\ndef sum(num1: int, num2: int) -> int:\n    \"\"\"Calculate sum of common divisors between two numbers.\"\"\"\n    divs1 = _find_divisors(num1)\n    divs2 = _find_divisors(num2)\n    common_divs = _find_common_divisors(divs1, divs2)\n    return builtins.sum(common_divs)"}
