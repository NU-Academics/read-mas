{"task_id": "Mbpp/607", "solution": "import re\n\ndef find_literals(input_string: str, pattern: str) -> tuple[str, int, int] | tuple[None, None, None]:\n    \"\"\"\n    Searches a string for the first occurrence of a regex pattern.\n    Returns the matching substring, its start index, and its end index as a tuple, or (None, None, None) if no match.\n    \"\"\"\n    compiled_pattern = re.compile(pattern)\n    match = compiled_pattern.search(input_string)\n\n    if match:\n        return (match.group(0), match.start(), match.end())\n    else:\n        return (None, None, None)"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"\n    Returns a new list with the k'th element removed, treating k as 1-indexed.\n    If k is out of valid bounds, the original list is returned.\n    \"\"\"\n    idx_to_remove = k - 1\n\n    if 0 <= idx_to_remove < len(input_list):\n        return input_list[:idx_to_remove] + input_list[idx_to_remove + 1:]\n    else:\n        return input_list"}
{"task_id": "Mbpp/612", "solution": "from typing import List\n\ndef merge(input_list: List[List]) -> List[List]:\n    \"\"\"\n    Transposes a list of two-element sublists into two separate lists.\n    The first returned list contains all first elements, and the second contains all second elements.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n    for sublist in input_list:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/614", "solution": "from typing import Union\n\ndef cummulative_sum(tuple_list: list) -> Union[int, float]:\n    \"\"\"Calculate the cumulative sum of all numeric values within a list of tuples.\n    The function sums all elements by iterating through the nested structure.\"\"\"\n    total_sum = 0\n    for tpl in tuple_list:\n        for item in tpl:\n            total_sum += item\n    return total_sum"}
