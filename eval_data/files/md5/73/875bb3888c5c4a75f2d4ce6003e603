{"task_id": "Mbpp/130", "solution": "def max_occurrences(input_list: list) -> any:\n    \"\"\"\n    Finds and returns the item with maximum frequency in the given list.\n\n    Args:\n        input_list (list): The input list to analyze\n\n    Returns:\n        any: The item that appears most frequently in the list\n    \"\"\"\n    frequency_map = {}\n    for item in input_list:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n\n    max_item = None\n    max_count = -1\n\n    for item, count in frequency_map.items():\n        if count > max_count:\n            max_count = count\n            max_item = item\n    \n    return max_item"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"\n    Checks if a given matrix is a magic square.\n    A magic square has all rows, columns, and main diagonals summing to the same value.\n    \"\"\"\n\n    def _is_square_matrix(mat: list[list[int]]) -> bool:\n        \"\"\"\n        Validates if the matrix is square (equal number of rows and columns).\n        Also checks if it's not empty and rows have consistent length.\n        \"\"\"\n        if not mat or not mat[0]:\n            return False\n        n = len(mat)\n        for row in mat:\n            if len(row) != n:\n                return False\n        return True\n\n    def _calculate_row_sums(mat: list[list[int]]) -> list[int]:\n        \"\"\"Calculates the sum of each row in the matrix.\"\"\"\n        return [sum(row) for row in mat]\n\n    def _calculate_column_sums(mat: list[list[int]]) -> list[int]:\n        \"\"\"Calculates the sum of each column in the matrix.\"\"\"\n        n = len(mat)\n        column_sums = [0] * n\n        for i in range(n):\n            for j in range(n):\n                column_sums[j] += mat[i][j]\n        return column_sums\n\n    def _calculate_diagonal_sums(mat: list[list[int]]) -> tuple[int, int]:\n        \"\"\"Calculates the sums of the main diagonal and the anti-diagonal.\"\"\"\n        n = len(mat)\n        main_diag_sum = 0\n        anti_diag_sum = 0\n        for i in range(n):\n            main_diag_sum += mat[i][i]\n            anti_diag_sum += mat[i][n - 1 - i]\n        return main_diag_sum, anti_diag_sum\n\n    def _all_sums_equal(sums_list: list[int]) -> bool:\n        \"\"\"Checks if all sums in a list are equal.\"\"\"\n        if not sums_list:\n            return True # Or handle as error depending on requirements for empty sums. Here, assuming non-empty sums will be passed.\n        first_sum = sums_list[0]\n        return all(s == first_sum for s in sums_list)\n\n    if not _is_square_matrix(matrix):\n        return False\n\n    row_sums = _calculate_row_sums(matrix)\n    col_sums = _calculate_column_sums(matrix)\n    main_diag_sum, anti_diag_sum = _calculate_diagonal_sums(matrix)\n\n    all_sums = row_sums + col_sums + [main_diag_sum, anti_diag_sum]\n\n    return _all_sums_equal(all_sums)"}
