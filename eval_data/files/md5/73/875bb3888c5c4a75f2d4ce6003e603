{"task_id": "Mbpp/453", "solution": "def _calculate_factors(number: int) -> list:\n    \"\"\"Calculates all factors of the input number.\"\"\"\n    if number <= 0:\n        return []\n    \n    factors = set()\n    for i in range(1, int(number**0.5) + 1):\n        if number % i == 0:\n            factors.add(i)\n            factors.add(number // i)\n    return sorted(list(factors))\n\ndef _filter_even_factors(factors: list) -> list:\n    \"\"\"Filters a list of factors to include only even numbers.\"\"\"\n    return [factor for factor in factors if factor % 2 == 0]\n\ndef _sum_factors(factors: list) -> int:\n    \"\"\"Calculates the sum of all numbers in a list.\"\"\"\n    return sum(factors)\n\ndef sumofFactors(number: int) -> int:\n    \"\"\"\n    Finds the sum of even factors of a given number.\n    It calculates all factors, filters out the even ones, and then sums them.\n    \"\"\"\n    all_factors = _calculate_factors(number)\n    even_factors = _filter_even_factors(all_factors)\n    return _sum_factors(even_factors)"}
{"task_id": "Mbpp/455", "solution": "MONTHS_WITH_31_DAYS = {1, 3, 5, 7, 8, 10, 12}\n\ndef _is_valid_month(month_number: int) -> bool:\n    \"\"\"Validate month number is in range 1-12.\"\"\"\n    return 1 <= month_number <= 12\n\ndef _has_31_days(month_number: int) -> bool:\n    \"\"\"Check if month has 31 days using lookup.\"\"\"\n    return month_number in MONTHS_WITH_31_DAYS\n\ndef check_monthnumb_number(month_number: int) -> bool:\n    \"\"\"\n    Check whether the given month number contains 31 days.\n\n    Args:\n        month_number (int): Month number (1-12)\n\n    Returns:\n        bool: True if month has 31 days, False otherwise\n    \"\"\"\n    if not _is_valid_month(month_number):\n        return False\n    return _has_31_days(month_number)"}
{"task_id": "Mbpp/454", "solution": "import re\n\ndef _parse_words(text: str) -> list[str]:\n    \"\"\"\n    Splits the input text into a list of words, treating non-alphanumeric\n    characters as word boundaries and filtering out empty strings.\n    \"\"\"\n    words = re.split(r'\\W+', text)\n    return [word for word in words if word]\n\ndef _contains_z(word: str) -> bool:\n    \"\"\"\n    Checks if a given word contains the lowercase character 'z'.\n    This check is case-sensitive.\n    \"\"\"\n    return 'z' in word\n\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Determines if the input string contains any word that includes\n    the lowercase character 'z'. Words are delimited by non-alphanumeric characters.\n    \"\"\"\n    words = _parse_words(text)\n    for word in words:\n        if _contains_z(word):\n            return True\n    return False"}
{"task_id": "Mbpp/457", "solution": "def Find_Min(input_list):\n    \"\"\"\n    Finds the sublist with the minimum length from a given list of sublists.\n    Iterates through the list, keeping track of the shortest sublist found so far.\n    \"\"\"\n    if not input_list:\n        return []\n\n    min_length = float('inf')\n    min_sublist = None\n\n    for sublist in input_list:\n        current_length = len(sublist)\n        if current_length < min_length:\n            min_length = current_length\n            min_sublist = sublist\n    \n    return min_sublist"}
{"task_id": "Mbpp/456", "solution": "from typing import List\n\ndef _reverse_single_string(s: str) -> str:\n    \"\"\"Helper function to reverse a single string character by character.\"\"\"\n    return s[::-1]\n\ndef reverse_string_list(input_list: List[str]) -> List[str]:\n    \"\"\"\n    Reverses each string in a given list of string values.\n    Returns a new list with each individual string reversed.\n    \"\"\"\n    reversed_list = []\n    for s in input_list:\n        reversed_list.append(_reverse_single_string(s))\n    return reversed_list"}
