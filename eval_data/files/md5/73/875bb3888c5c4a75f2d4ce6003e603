{"task_id": "Mbpp/594", "solution": "from typing import List, Optional\n\ndef _find_first_even(lst: List[int]) -> Optional[int]:\n    \"\"\"Finds the first even number in a list, returning None if not found.\"\"\"\n    for num in lst:\n        if num % 2 == 0:\n            return num\n    return None\n\ndef _find_first_odd(lst: List[int]) -> Optional[int]:\n    \"\"\"Finds the first odd number in a list, returning None if not found.\"\"\"\n    for num in lst:\n        if num % 2 != 0:\n            return num\n    return None\n\ndef _calculate_difference(even: int, odd: int) -> int:\n    \"\"\"Calculates the absolute difference between two integers.\"\"\"\n    return abs(even - odd)\n\ndef diff_even_odd(input_list: List[int]) -> int:\n    \"\"\"\n    Finds the absolute difference between the first even and first odd number in a list.\n    Assumes both an even and an odd number will be present in the list.\n    \"\"\"\n    first_even = _find_first_even(input_list)\n    first_odd = _find_first_odd(input_list)\n\n    # Based on the problem description and assert, we expect both to be found.\n    return _calculate_difference(first_even, first_odd)"}
