{"task_id": "Mbpp/131", "solution": "def reverse_vowels(input_string: str) -> str:\n    \"\"\"\n    Reverses only the vowels in the given string, preserving consonant positions and case.\n    'y' is treated as a consonant.\n    \"\"\"\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Determines if a character is a vowel (a, e, i, o, u, case-insensitive).\"\"\"\n        return char.lower() in 'aeiou'\n\n    def _extract_vowels_and_positions(s: str) -> tuple[list[str], list[int]]:\n        \"\"\"Extracts vowels and their positions from the input string.\"\"\"\n        vowels = []\n        positions = []\n        for i, char in enumerate(s):\n            if _is_vowel(char):\n                vowels.append(char)\n                positions.append(i)\n        return vowels, positions\n\n    def _reverse_vowels_list(vowels: list[str]) -> list[str]:\n        \"\"\"Reverses the order of vowels in the list.\"\"\"\n        return vowels[::-1]\n\n    def _reconstruct_string(original: str, reversed_vowels: list[str], positions: list[int]) -> str:\n        \"\"\"Reconstructs the string with reversed vowels in their original positions.\"\"\"\n        result_list = list(original)\n        for i, pos in enumerate(positions):\n            result_list[pos] = reversed_vowels[i]\n        return \"\".join(result_list)\n\n    if not input_string:\n        return \"\"\n\n    extracted_vowels, vowel_positions = _extract_vowels_and_positions(input_string)\n    \n    if not extracted_vowels: # No vowels found or only one vowel\n        return input_string\n\n    reversed_vowels = _reverse_vowels_list(extracted_vowels)\n    \n    return _reconstruct_string(input_string, reversed_vowels, vowel_positions)"}
{"task_id": "Mbpp/139", "solution": "import math\n\ndef circle_circumference(radius: float) -> float:\n    \"\"\"\n    Calculates the circumference of a circle given its radius.\n    Uses the formula 2 * pi * radius.\n    \"\"\"\n    return 2 * math.pi * radius"}
{"task_id": "Mbpp/137", "solution": "def _count_zeros(array: list[int]) -> int:\n    \"\"\"Counts the number of zero values in an array.\"\"\"\n    count = 0\n    for x in array:\n        if x == 0:\n            count += 1\n    return count\n\ndef _count_non_zeros(array: list[int]) -> int:\n    \"\"\"Counts the number of non-zero values in an array.\"\"\"\n    count = 0\n    for x in array:\n        if x != 0:\n            count += 1\n    return count\n\ndef _calculate_ratio(zero_count: int, non_zero_count: int) -> float:\n    \"\"\"Calculates the ratio of zeroes to non-zeroes, handling division by zero.\"\"\"\n    if non_zero_count == 0:\n        return 0.0\n    return float(zero_count) / non_zero_count\n\ndef zero_count(array: list[int]) -> float:\n    \"\"\"\n    Calculates the ratio of zeroes to non-zeroes in an array of integers.\n    Handles empty arrays and cases with no non-zeroes gracefully.\n    \"\"\"\n    num_zeros = _count_zeros(array)\n    num_non_zeros = _count_non_zeros(array)\n    ratio = _calculate_ratio(num_zeros, num_non_zeros)\n    return ratio"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(input_collections: list) -> set:\n    \"\"\"\n    Flattens a list of lists or tuples into a single set of unique numbers.\n    Assumes valid input containing only numeric elements within nested collections.\n    \"\"\"\n    result_set = set()\n    for collection in input_collections:\n        for item in collection:\n            result_set.add(item)\n    return result_set"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(number: int) -> bool:\n    \"\"\"\n    Check if number can be represented as sum of non-zero powers of 2.\n\n    Args:\n        number: Positive integer to check\n\n    Returns:\n        bool: True if number can be represented as sum of distinct non-zero powers of 2\n    \"\"\"\n    # The number must be positive and even (cannot use 2^0).\n    # Its binary representation must not contain consecutive 1s for distinct powers.\n    return number > 0 and (number % 2 == 0) and ((number & (number >> 1)) == 0)"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1, list2, list3):\n    \"\"\"\n    Counts the number of items that are identical in the same position of three given lists.\n    Compares elements up to the length of the shortest list.\n    \"\"\"\n    min_length = min(len(list1), len(list2), len(list3))\n    count = 0\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(arr):\n    \"\"\"\n    Sorts a list of elements using the pancake sort algorithm.\n    Returns a new sorted list.\n    \"\"\"\n    def flip(sub_arr, i):\n        \"\"\"\n        Reverses elements in sub_arr from index 0 to i (inclusive).\n        \"\"\"\n        start = 0\n        while start < i:\n            sub_arr[start], sub_arr[i] = sub_arr[i], sub_arr[start]\n            start += 1\n            i -= 1\n\n    def find_max_index(sub_arr, n):\n        \"\"\"\n        Finds the index of the maximum element in sub_arr up to n (exclusive).\n        \"\"\"\n        max_val = sub_arr[0]\n        max_idx = 0\n        for i in range(1, n):\n            if sub_arr[i] > max_val:\n                max_val = sub_arr[i]\n                max_idx = i\n        return max_idx\n\n    n = len(arr)\n    if n <= 1:\n        return list(arr) # Return a copy for consistency\n\n    # Create a mutable copy of the input list to perform in-place operations\n    working_arr = list(arr)\n\n    # Start from the last element and reduce the size of the unsorted part\n    for current_size in range(n, 1, -1):\n        # Find the index of the maximum element in the current unsorted part\n        max_idx = find_max_index(working_arr, current_size)\n\n        # If the maximum element is not already at its correct position\n        if max_idx != current_size - 1:\n            # Move the maximum element to the front if it's not already there\n            if max_idx != 0:\n                flip(working_arr, max_idx)\n\n            # Move the maximum element from the front to its correct sorted position\n            flip(working_arr, current_size - 1)\n\n    return working_arr"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(array):\n    \"\"\"\n    Finds the maximum difference between any two elements in a given array.\n    This is achieved by finding the minimum and maximum values and calculating their absolute difference.\n    \"\"\"\n    min_val = min(array)\n    max_val = max(array)\n    return max_val - min_val"}
