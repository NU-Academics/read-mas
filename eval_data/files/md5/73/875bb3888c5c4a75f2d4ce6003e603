{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers):\n    \"\"\"\n    Calculates the product of all numbers in a collection and divides by its length.\n    Returns the result as a float.\n    \"\"\"\n    if not numbers:\n        # This will naturally raise a ZeroDivisionError during the division step,\n        # which is consistent with the design context for error handling.\n        pass\n\n    product = 1.0\n    for num in numbers:\n        product *= num\n    \n    return product / len(numbers)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal: int) -> str:\n    \"\"\"\n    Converts a decimal number to its binary equivalent as a string.\n    The output string will not have leading zeros, except for the number 0 itself.\n    \"\"\"\n    if decimal == 0:\n        return '0'\n\n    binary_string = ''\n    temp_decimal = decimal\n    while temp_decimal > 0:\n        remainder = temp_decimal % 2\n        binary_string = str(remainder) + binary_string\n        temp_decimal //= 2\n\n    return binary_string"}
