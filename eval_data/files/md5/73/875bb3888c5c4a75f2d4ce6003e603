{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list, sub_list):\n    \"\"\"\n    Checks if `sub_list` is a contiguous sublist of `main_list`.\n    Returns True if found, False otherwise.\n    \"\"\"\n    if not sub_list:\n        return True\n    if len(sub_list) > len(main_list):\n        return False\n\n    for i in range(len(main_list) - len(sub_list) + 1):\n        match = True\n        for j in range(len(sub_list)):\n            if main_list[i + j] != sub_list[j]:\n                match = False\n                break\n        if match:\n            return True\n    return False"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(number: int) -> int:\n    \"\"\"\n    Calculates the last digit of the factorial of a given non-negative number.\n    The last digit is 0 for factorials of numbers 5 or greater.\n    \"\"\"\n    if number == 0:\n        return 1\n    elif number == 1:\n        return 1\n    elif number == 2:\n        return 2\n    elif number == 3:\n        return 6\n    elif number == 4:\n        return 4\n    else:  # For number >= 5, the last digit is always 0\n        return 0"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Finds elements that exist in only one of the two input tuples, maintaining original order.\n    Elements from the first tuple are returned first, followed by elements from the second tuple.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n\n    unique_to_tuple1 = set1 - set2\n    unique_to_tuple2 = set2 - set1\n\n    result = []\n    for item in tuple1:\n        if item in unique_to_tuple1:\n            result.append(item)\n\n    for item in tuple2:\n        if item in unique_to_tuple2:\n            result.append(item)\n\n    return tuple(result)"}
{"task_id": "Mbpp/580", "solution": "```python\ndef extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Recursively filters a nested tuple, removing odd integer elements while preserving the structure.\n    Non-integer elements are kept as is.\n    \"\"\"\n    result = []\n    for item in input_tuple:\n        if isinstance(item, tuple):\n            processed_nested = extract_even(item)\n            if processed_nested:  # Only add non-empty nested tuples\n                result.append(processed_nested)\n        elif isinstance(item, int):\n            if item % 2 == 0:\n                result.append(item)\n        else:\n            # For other types, keep them as is based on the problem statement context\n            # (e.g., if it was a string or float, it would be included)\n            result.append(item)\n    return tuple(result)\n```"}
{"task_id": "Mbpp/581", "solution": "import math\n\ndef surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"\n    Calculate the surface area of a square pyramid.\n\n    Args:\n        base_edge: Length of the base edge\n        height: Height of the pyramid\n    \"\"\"\n    base_area = base_edge * base_edge\n    slant_height = math.sqrt(height**2 + (base_edge / 2)**2)\n    face_area = 0.5 * base_edge * slant_height\n    total_area = base_area + 4 * face_area\n    return total_area"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1, list2, list3):\n    \"\"\"Interleaves three lists of the same length into a single flat list.\"\"\"\n    interleaved_result = []\n    # Iterate through the lists, assuming they are of equal length.\n    for i in range(len(list1)):\n        interleaved_result.append(list1[i])\n        interleaved_result.append(list2[i])\n        interleaved_result.append(list3[i])\n    return interleaved_result"}
{"task_id": "Mbpp/583", "solution": "import math\n\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Catalan number C_n using the formula C_n = (2n)! / (n! * (n+1)!).\n    It uses math.factorial for calculating factorials and integer division for the result.\n    \"\"\"\n    numerator = math.factorial(2 * n)\n    denominator = math.factorial(n) * math.factorial(n + 1)\n    return numerator // denominator"}
