{"task_id": "Mbpp/463", "solution": "def max_subarray_product(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray within a given array.\n    This algorithm handles positive, negative, and zero values efficiently.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_so_far = arr[0]\n    min_so_far = arr[0]\n    result = arr[0]\n\n    for i in range(1, len(arr)):\n        current_num = arr[i]\n        \n        # Store max_so_far before it's updated, as it's needed for min_so_far calculation\n        temp_max_so_far = max_so_far\n\n        # The maximum product ending at current_num could be current_num itself,\n        # or current_num multiplied by the maximum product ending at previous index,\n        # or current_num multiplied by the minimum product ending at previous index (if current_num is negative)\n        max_so_far = max(current_num, temp_max_so_far * current_num, min_so_far * current_num)\n        \n        # Similarly for the minimum product ending at current_num\n        min_so_far = min(current_num, temp_max_so_far * current_num, min_so_far * current_num)\n\n        result = max(result, max_so_far)\n\n    return result"}
{"task_id": "Mbpp/462", "solution": "from typing import List\n\ndef combinations_list(input_list: List) -> List[List]:\n    \"\"\"\n    Generate all possible combinations (the power set) of the elements of a given list.\n    The combinations are generated in a specific order matching the provided assertion.\n    \"\"\"\n    result: List[List] = []\n    current_subset: List = []\n    # Reverse the input list to achieve the specific output order for combinations\n    # when using the standard include/exclude recursive generation.\n    reversed_elements = input_list[::-1]\n    _generate_subsets(reversed_elements, 0, current_subset, result)\n    return result\n\ndef _generate_subsets(elements: List, index: int, current: List, result: List) -> None:\n    \"\"\"\n    Recursive helper to generate all subsets using an include/exclude approach.\n    Elements are processed from 'index' onwards, building 'current' subset,\n    and accumulating final subsets in 'result'.\n    \"\"\"\n    # Base case: When all elements have been considered\n    if index == len(elements):\n        result.append(list(current))  # Add a copy of the current subset to results\n        return\n\n    # Option 1: Exclude the current element (elements[index])\n    _generate_subsets(elements, index + 1, current, result)\n\n    # Option 2: Include the current element (elements[index])\n    current.append(elements[index])\n    _generate_subsets(elements, index + 1, current, result)\n    current.pop()  # Backtrack: remove the element for other combinations"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(numbers: list) -> bool:\n    \"\"\"\n    Checks if a given list of numbers contains consecutive integers.\n    Assumes the input 'numbers' is a list of numerical values, as per design constraints\n    prohibiting explicit type checking or exception raising for edge cases.\n    \"\"\"\n\n    # If the list is empty or has only one element, it cannot form a consecutive sequence.\n    # This acts as an initial check for list length.\n    if len(numbers) < 2:\n        return False\n\n    # Helper function to sort numbers and check for a consecutive sequence.\n    def process_numbers(nums: list) -> bool:\n        # Sort the list to arrange numbers in ascending order.\n        sorted_nums = sorted(nums)\n\n        # Iterate through the sorted list, checking if each number is one greater than the previous.\n        for i in range(len(sorted_nums) - 1):\n            if sorted_nums[i] + 1 != sorted_nums[i+1]:\n                return False  # Non-consecutive sequence found.\n        return True  # All numbers are consecutive.\n\n    # Call the helper function to perform the core logic.\n    return process_numbers(numbers)"}
{"task_id": "Mbpp/468", "solution": "def max_product(array: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum product formed by multiplying numbers of an increasing subsequence.\n    Uses dynamic programming to find the maximum product ending at each position.\n    \"\"\"\n    # Handle edge cases as per ArrayValidator component\n    if not array:\n        return 0\n    if len(array) == 1:\n        return array[0]\n\n    # Initialize dp array where dp[i] stores the maximum product of an\n    # increasing subsequence ending with array[i].\n    # Each element array[i] itself can be an increasing subsequence of length 1.\n    dp = list(array)\n\n    # Algorithm Layer: Subsequence Generator and Product Calculator logic\n    # Iterate through the array to build up dp values\n    for i in range(len(array)):\n        # For each element array[i], check all previous elements array[j]\n        for j in range(i):\n            # If array[i] can extend an increasing subsequence ending at array[j]\n            if array[i] > array[j]:\n                # Update dp[i] with the maximum product.\n                # This considers extending the subsequence ending at array[j]\n                # by multiplying its maximum product (dp[j]) with array[i].\n                dp[i] = max(dp[i], dp[j] * array[i])\n\n    # Maximum Finder: Find the overall maximum product\n    # The result is the maximum value found in the dp array,\n    # which represents the maximum product among all increasing subsequences.\n    return max(dp)"}
{"task_id": "Mbpp/473", "solution": "import collections\nfrom typing import List, Tuple, Set\n\ndef tuple_intersection(list1: List[Tuple], list2: List[Tuple]) -> Set[Tuple]:\n    \"\"\"\n    Finds the intersection of two lists of tuples, treating tuples as equivalent\n    regardless of element order.\n    \"\"\"\n    \n    def _normalize_tuple(t: Tuple) -> Tuple:\n        \"\"\"\n        Sorts elements within a tuple to create a canonical representation.\n        Assumes tuples contain comparable elements.\n        \"\"\"\n        return tuple(sorted(t))\n\n    # Map normalized tuples from list1 to their original forms in list1\n    # This allows us to retrieve an original tuple for the result set\n    # if its normalized form is found in list2.\n    normalized_to_original_map1 = {}\n    for t in list1:\n        normalized_to_original_map1[_normalize_tuple(t)] = t\n\n    # Create a set of normalized tuples from list2 for efficient lookup\n    normalized_set2 = {_normalize_tuple(t) for t in list2}\n\n    # Find the intersection of normalized tuples\n    # Use keys from map1 to ensure we only consider tuples present in list1\n    common_normalized_tuples = set(normalized_to_original_map1.keys()) & normalized_set2\n\n    # Reconstruct the result set using original tuples from list1\n    result_set = {normalized_to_original_map1[norm_tup] for norm_tup in common_normalized_tuples}\n\n    return result_set"}
