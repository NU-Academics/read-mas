{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Insert spaces before capital letters that follow lowercase letters.\n\n    Args:\n        input_string (str): The string to process\n\n    Returns:\n        str: String with spaces inserted between words\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    result_chars = [input_string[0]]\n    for i in range(1, len(input_string)):\n        current_char = input_string[i]\n        prev_char = input_string[i - 1]\n\n        if current_char.isupper() and prev_char.islower():\n            result_chars.append(\" \")\n        result_chars.append(current_char)\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/745", "solution": "from typing import List\n\ndef contains_zero(number: int) -> bool:\n    \"\"\"Checks if a number contains the digit 0.\"\"\"\n    return '0' in str(number)\n\ndef extract_digits(number: int) -> List[int]:\n    \"\"\"Extracts individual digits from a number.\"\"\"\n    digits = []\n    if number == 0:\n        return [0]\n    temp_num = number\n    while temp_num > 0:\n        digits.append(temp_num % 10)\n        temp_num //= 10\n    return digits[::-1]\n\ndef is_divisible_by_all_digits(number: int) -> bool:\n    \"\"\"Verifies if a number is divisible by all its constituent digits.\"\"\"\n    digits = extract_digits(number)\n    for digit in digits:\n        # Per design, numbers containing '0' are excluded before this check.\n        if number % digit != 0:\n            return False\n    return True\n\ndef divisible_by_digits(startnum: int, endnum: int) -> List[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing the digit 0 are excluded from consideration.\n    \"\"\"\n    result = []\n    for num in range(startnum, endnum + 1):\n        if not contains_zero(num):\n            if is_divisible_by_all_digits(num):\n                result.append(num)\n    return result"}
{"task_id": "Mbpp/749", "solution": "def sort_numeric_strings(string_list: list[str]) -> list[int]:\n    \"\"\"\n    Converts a list of numeric strings to integers and sorts them numerically.\n    Raises ValueError if any string cannot be converted to an integer.\n    \"\"\"\n    int_list = [int(s) for s in string_list]\n    sorted_int_list = sorted(int_list)\n    return sorted_int_list"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n):\n    \"\"\"\n    Calculates the nth Jacobsthal number using an iterative approach.\n    The sequence starts with J(0)=0, J(1)=1, and J(n) = J(n-1) + 2*J(n-2) for n >= 2.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    a, b = 0, 1  # Represents J(k-2) and J(k-1) respectively.\n    for _ in range(2, n + 1):\n        a, b = b, b + 2 * a\n    return b"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(array: list[int]) -> bool:\n    \"\"\"\n    Checks if the given array represents a valid min heap.\n    Iterates through parent nodes and validates the min-heap property against its children.\n    \"\"\"\n    n = len(array)\n\n    if n <= 1:\n        return True\n\n    # Only need to check nodes that have at least one child, i.e., up to n/2 - 1\n    # because nodes from n/2 to n-1 are leaf nodes and have no children.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and array[i] > array[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and array[i] > array[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(list1, list2, list3):\n    \"\"\"\n    Find common elements at matching indices across three lists.\n    Compares elements at each index up to the minimum length of the three lists.\n    \"\"\"\n    min_length = min(len(list1), len(list2), len(list3))\n    result = []\n\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            result.append(list1[i])\n    \n    return result"}
{"task_id": "Mbpp/753", "solution": "import collections\n\n\ndef min_k(tuple_list, k):\n    \"\"\"\n    Finds the k smallest records from a list of tuples based on their second (numeric) element.\n    The result is sorted in ascending order of the second element.\n    \"\"\"\n    if not tuple_list:\n        return []\n    \n    # Sort the list of tuples based on the second element\n    sorted_list = sorted(tuple_list, key=lambda x: x[1])\n\n    # Return the first k elements from the sorted list\n    return sorted_list[:k]"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers: list):\n    \"\"\"\n    Finds the second smallest unique number in a list.\n    Handles duplicates, negative numbers, and zero by first extracting unique elements.\n    \"\"\"\n    if not numbers:\n        # Per design, no explicit error handling for invalid input like empty list.\n        # This case is implicitly handled by the subsequent sorting and indexing.\n        # If there are fewer than two unique elements, an IndexError will occur.\n        # The design context indicates \"Return -2 when given the input [1, 2, -8, -2, 0, -2]\"\n        # and \"no isinstance() checks or raise exceptions for edge cases\".\n        # Therefore, we will let Python's built-in exceptions handle these cases.\n        pass\n\n    unique_numbers = sorted(list(set(numbers)))\n\n    # The design states to \"access index [1] for second element\"\n    # and \"Error Handling: Manages edge cases like insufficient unique values\".\n    # The current requirements specify \"DO NOT add isinstance() checks or raise exceptions for edge cases\".\n    # This implies we should allow an IndexError if there are fewer than two unique elements.\n    return unique_numbers[1]"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"\n    Counts pairs of reverse strings in the given list, excluding palindromes.\n    Uses helper functions to reverse strings, find pairs, and count them uniquely.\n    \"\"\"\n    def reverse_string(s: str) -> str:\n        \"\"\"Reverses the input string.\"\"\"\n        return s[::-1]\n\n    def find_pairs(string_list: list[str]) -> list[tuple[str, str]]:\n        \"\"\"Identifies all reverse pairs in the list, ensuring original and reversed strings are distinct.\"\"\"\n        found_pairs = []\n        n = len(string_list)\n        for i in range(n):\n            current_string = string_list[i]\n            reversed_current = reverse_string(current_string)\n\n            if current_string == reversed_current:  # Exclude palindromes\n                continue\n\n            for j in range(i + 1, n):\n                if string_list[j] == reversed_current:\n                    found_pairs.append((current_string, string_list[j]))\n        return found_pairs\n\n    def count_unique_pairs(pairs: list[tuple[str, str]]) -> int:\n        \"\"\"Counts unique pairs, treating (a,b) and (b,a) as the same pair.\"\"\"\n        unique_pairs = set()\n        for s1, s2 in pairs:\n            # Ensure consistent order for set addition\n            ordered_pair = tuple(sorted((s1, s2)))\n            unique_pairs.add(ordered_pair)\n        return len(unique_pairs)\n\n    all_pairs = find_pairs(string_list)\n    return count_unique_pairs(all_pairs)"}
{"task_id": "Mbpp/758", "solution": "import collections\n\ndef _convert_to_tuple(sublist: list) -> tuple:\n    \"\"\"Converts a given list to a tuple.\"\"\"\n    return tuple(sublist)\n\ndef _count_occurrences(tuples: list) -> dict:\n    \"\"\"Counts occurrences of hashable items in a list, returning a dictionary of counts.\"\"\"\n    return dict(collections.Counter(tuples))\n\ndef unique_sublists(input_list: list) -> dict:\n    \"\"\"\n    Counts lists within a list, converting each sublist to a tuple and counting its occurrences.\n    Returns a dictionary where tuple keys map to their counts.\n    \"\"\"\n    converted_tuples = []\n    for sublist in input_list:\n        converted_tuples.append(_convert_to_tuple(sublist))\n    \n    return _count_occurrences(converted_tuples)"}
