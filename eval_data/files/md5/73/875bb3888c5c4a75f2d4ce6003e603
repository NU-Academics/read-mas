{"task_id": "Mbpp/763", "solution": "def find_min_diff(array, length):\n    \"\"\"\n    Finds the minimum absolute difference between any two elements in the given array.\n    The array is assumed to have at least two elements.\n    \"\"\"\n    sorted_array = sorted(list(array))\n    min_diff = float('inf')\n\n    for i in range(1, length):\n        min_diff = min(min_diff, sorted_array[i] - sorted_array[i-1])\n            \n    return min_diff"}
{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number.\n    A polite number is a positive integer that is not a power of two.\n    \"\"\"\n    def is_power_of_two(num: int) -> bool:\n        \"\"\"Checks if a number is a power of two.\"\"\"\n        return num > 0 and (num & (num - 1)) == 0\n\n    def is_polite_number(num: int) -> bool:\n        \"\"\"Determines if a number is polite (not a power of two).\"\"\"\n        return not is_power_of_two(num)\n\n    polite_count = 0\n    current_num = 1\n    while polite_count < n:\n        if is_polite_number(current_num):\n            polite_count += 1\n        if polite_count == n:\n            return current_num\n        current_num += 1\n    return 0 # Should not be reached for valid n >= 1"}
{"task_id": "Mbpp/769", "solution": "def Diff(first_list: list[int], second_list: list[int]) -> list[int]:\n    \"\"\"\n    Returns elements from first_list that are not present in second_list,\n    preserving the original order from first_list.\n    \"\"\"\n    second_list_set = set(second_list)\n    result = []\n    for item in first_list:\n        if item not in second_list_set:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/766", "solution": "from typing import List, Tuple, Any\n\ndef pair_wise(input_list: List[Any]) -> List[Tuple[Any, Any]]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in a given list.\n    Each pair is a tuple (item, next_item).\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n\n    result = []\n    for i in range(len(input_list) - 1):\n        result.append((input_list[i], input_list[i+1]))\n    return result"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list, target_sum: int) -> int:\n    \"\"\"\n    Count pairs of numbers whose sum equals target_sum.\n    The implementation uses a nested loop to check all unique pairs by index.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n):\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    Iterates through the first n odd numbers, computes their fourth power, and accumulates the sum.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        odd_num = 2 * i - 1\n        total_sum += odd_num ** 4\n    return total_sum"}
{"task_id": "Mbpp/772", "solution": "def remove_length(input_string: str, k: int) -> str:\n    # Remove all words with k length from the given string.\n    # Handles empty strings and ensures single spaces between remaining words.\n\n    # Helper function for parameter validation\n    def _validate_parameters(s: str, length: int) -> bool:\n        if not isinstance(s, str):\n            raise TypeError(\"Input string must be a string.\")\n        if not isinstance(length, int):\n            raise TypeError(\"k must be an integer.\")\n        if length < 0:\n            raise ValueError(\"k must be a non-negative integer.\")\n        if len(s) > 10000:\n            raise ValueError(\"Input string length exceeds 10,000 characters.\")\n        return True\n\n    # Helper function to split string into words\n    def _split_words(s: str) -> list[str]:\n        # Split by whitespace and filter out empty strings resulting from multiple spaces\n        return [word for word in s.split() if word]\n\n    # Helper function to filter words by length\n    def _filter_words(words: list[str], length: int) -> list[str]:\n        return [word for word in words if len(word) != length]\n\n    # Helper function to normalize spacing in the output\n    def _normalize_spaces(text: str) -> str:\n        # Join words with a single space and strip leading/trailing whitespace\n        return ' '.join(text.split())\n\n    _validate_parameters(input_string, k)\n\n    if not input_string:\n        return \"\"\n\n    words = _split_words(input_string)\n    filtered_words = _filter_words(words, k)\n    \n    # Reconstruct the string from filtered words, ensuring single spaces.\n    # The _normalize_spaces helper is effectively ` ' '.join(filtered_words) `\n    # as split() and join(' ') naturally handle multiple spaces.\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(source_string: str, search_substring: str) -> tuple | None:\n    \"\"\"\n    Finds the first occurrence of a substring within a string and returns its position information.\n    Returns None if no match is found.\n    \"\"\"\n    if not source_string or not search_substring:\n        return None\n\n    start_index = source_string.find(search_substring)\n\n    if start_index != -1:\n        end_index = start_index + len(search_substring)\n        return (search_substring, start_index, end_index)\n    else:\n        return None"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets.\n    Supports '()', '[]', and '{}' bracket types.\n    \"\"\"\n\n    class BracketType:\n        \"\"\"Defines bracket types and their matching pairs.\"\"\"\n        OPENING_BRACKETS = {'(', '[', '{'}\n        CLOSING_BRACKETS = {')', ']', '}'}\n        BRACKET_PAIRS = {'(': ')', '[': ']', '{': '}'}\n\n    class BracketStack:\n        \"\"\"A LIFO stack for tracking unmatched opening brackets.\"\"\"\n        def __init__(self):\n            self._items = []\n\n        def push(self, item: str) -> None:\n            self._items.append(item)\n\n        def pop(self) -> str:\n            # Assumes pop is only called when stack is not empty, as per validator logic.\n            return self._items.pop()\n\n        def is_empty(self) -> bool:\n            return len(self._items) == 0\n\n        def peek(self) -> str:\n            if not self.is_empty():\n                return self._items[-1]\n            return None\n\n    class BracketMatcher:\n        \"\"\"Determines bracket types and validates matching pairs.\"\"\"\n        def is_opening_bracket(self, char: str) -> bool:\n            return char in BracketType.OPENING_BRACKETS\n\n        def is_closing_bracket(self, char: str) -> bool:\n            return char in BracketType.CLOSING_BRACKETS\n\n        def matches(self, opening: str, closing: str) -> bool:\n            return BracketType.BRACKET_PAIRS.get(opening) == closing\n\n    class BracketValidator:\n        \"\"\"Orchestrates the validation process using a stack and matcher.\"\"\"\n        def __init__(self):\n            self._matcher = BracketMatcher()\n            self._stack = BracketStack()\n\n        def validate(self, expression: str) -> bool:\n            for char in expression:\n                if not self._process_character(char):\n                    return False\n            return self._stack.is_empty()\n\n        def _process_character(self, char: str) -> bool:\n            if self._matcher.is_opening_bracket(char):\n                self._stack.push(char)\n            elif self._matcher.is_closing_bracket(char):\n                if self._stack.is_empty():\n                    return False\n                \n                top_bracket = self._stack.peek()\n                if not self._matcher.matches(top_bracket, char):\n                    return False\n                \n                self._stack.pop()\n            # Non-bracket characters are ignored.\n            return True\n\n    validator = BracketValidator()\n    return validator.validate(expression)"}
{"task_id": "Mbpp/775", "solution": "def odd_position(input_list: list) -> bool:\n    \"\"\"Checks if every number at an odd index in the list is an odd number.\"\"\"\n    for index, num in enumerate(input_list):\n        if index % 2 != 0:  # Check if the current index is odd\n            if num % 2 == 0:  # If the index is odd, check if the number at that index is even\n                return False\n    return True"}
{"task_id": "Mbpp/777", "solution": "def find_sum(input_list):\n    \"\"\"\n    Calculates the sum of elements that appear exactly once in the input list.\n    Uses a frequency counter to identify unique elements and then sums them.\n    \"\"\"\n    element_counts = {}\n    for element in input_list:\n        element_counts[element] = element_counts.get(element, 0) + 1\n\n    non_repeated_elements = []\n    for element, count in element_counts.items():\n        if count == 1:\n            non_repeated_elements.append(element)\n\n    return sum(non_repeated_elements)"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list):\n    \"\"\"\n    Packs consecutive duplicates of list elements into sublists.\n    Iterates through the list, grouping identical consecutive elements.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_group = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_group[0]:\n            current_group.append(input_list[i])\n        else:\n            packed_list.append(current_group)\n            current_group = [input_list[i]]\n\n    # Append the last group\n    packed_list.append(current_group)\n\n    return packed_list"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(tuple_list):\n    \"\"\"\n    Calculates element-wise sums for all unique pairs of tuples in the input list.\n    Each pair (t1, t2) results in a new tuple (t1[0]+t2[0], t1[1]+t2[1]).\n    \"\"\"\n    results = []\n    n = len(tuple_list)\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            tuple1 = tuple_list[i]\n            tuple2 = tuple_list[j]\n            sum_tuple = (tuple1[0] + tuple2[0], tuple1[1] + tuple2[1])\n            results.append(sum_tuple)\n\n    return results"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if the count of divisors for a given positive integer is even.\n    A number has an even count of divisors if it is not a perfect square.\n    \"\"\"\n    root = int(n**0.5)\n    is_perfect_square = (root * root == n)\n    return not is_perfect_square"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(input_list: list) -> int:\n    \"\"\"\n    Finds the first even and first odd number in a list and returns their product.\n    If either number is not found, it defaults to 1 for the multiplication.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in input_list:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        \n        # Optimization: if both are found, we can stop early\n        if first_even is not None and first_odd is not None:\n            break\n\n    # Default to 1 if a number was not found, as per design context for multiplication identity\n    product_even = first_even if first_even is not None else 1\n    product_odd = first_odd if first_odd is not None else 1\n\n    return product_even * product_odd"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(array: list) -> int:\n    \"\"\"\n    Calculate the sum of all odd-length subarrays.\n    \"\"\"\n    total_sum = 0\n    n = len(array)\n\n    for i in range(n):\n        for j in range(i, n):\n            subarray = array[i : j + 1]\n            if len(subarray) % 2 != 0:\n                total_sum += sum(subarray)\n    return total_sum"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(input_string: str) -> tuple:\n    \"\"\"Converts a string representation of an integer tuple to an actual integer tuple.\"\"\"\n    if not (input_string.startswith('(') and input_string.endswith(')')):\n        raise ValueError(\"Invalid tuple format: Must start and end with parentheses.\")\n    \n    content = input_string[1:-1]\n\n    if not content.strip():\n        return ()\n\n    element_strings = [e.strip() for e in content.split(',')]\n\n    integer_list = []\n    for s in element_strings:\n        if not s: \n            raise ValueError(\"Invalid tuple format: Contains empty element or malformed comma.\")\n        try:\n            integer_list.append(int(s))\n        except ValueError:\n            raise ValueError(f\"Invalid tuple format: Element '{s}' is not a valid integer.\")\n            \n    return tuple(integer_list)"}
{"task_id": "Mbpp/787", "solution": "import re\n\ndef text_match_three(input_string: str) -> bool:\n    \"\"\"\n    Validates if input string contains 'a' followed by exactly three 'b' characters.\n    It uses regular expressions for pattern matching.\n    \"\"\"\n    pattern = 'abbb'\n    if re.search(pattern, input_string):\n        return True\n    else:\n        return False"}
{"task_id": "Mbpp/788", "solution": "def new_tuple(input_list: list, input_string: str) -> tuple:\n    \"\"\"\n    Creates a new tuple by combining elements from a list and a string.\n    The string is appended as the last element.\n    \"\"\"\n    return tuple(input_list) + (input_string,)"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(array: list, value: any) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in a sorted array using binary search.\n    This function returns an index 'i' such that all 'e' in array[:i] have e <= value,\n    and all 'e' in array[i:] have e > value.\n    \"\"\"\n    low = 0\n    high = len(array)\n\n    while low < high:\n        mid = low + (high - low) // 2\n        if array[mid] <= value:\n            low = mid + 1\n        else:\n            high = mid\n            \n    return low"}
{"task_id": "Mbpp/790", "solution": "def even_position(input_list: list) -> bool:\n    \"\"\"\n    Checks if every number at an even index in the list is an even number.\n    Returns True if all elements at even indices are even, False otherwise.\n    \"\"\"\n    for i in range(0, len(input_list), 2):\n        if input_list[i] % 2 != 0:\n            return False\n    return True"}
{"task_id": "Mbpp/791", "solution": "def remove_nested(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Filters out nested tuple elements from the input tuple, preserving the order of non-tuple elements.\n    \"\"\"\n    result = []\n    for element in input_tuple:\n        if not isinstance(element, tuple):\n            result.append(element)\n    return tuple(result)"}
