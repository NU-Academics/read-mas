{"task_id": "Mbpp/283", "solution": "import collections\n\ndef validate(integer):\n    \"\"\"\n    Checks if the frequency of each digit in the integer is less than or equal to the digit itself.\n    \"\"\"\n\n    def _extract_digits(num: int) -> list[int]:\n        \"\"\"Converts an integer to a list of its individual digits.\"\"\"\n        return [int(d) for d in str(abs(num))]\n\n    def _count_frequencies(digits_list: list[int]) -> dict[int, int]:\n        \"\"\"Counts the occurrences of each digit in the provided list.\"\"\"\n        return collections.Counter(digits_list)\n\n    def _validate_frequencies(freq_dict: dict[int, int]) -> bool:\n        \"\"\"Compares each digit's frequency to its value, returning False if any frequency exceeds its digit.\"\"\"\n        for digit_value, frequency in freq_dict.items():\n            if frequency > digit_value:\n                return False\n        return True\n\n    # Orchestrate the validation process by calling helper functions in sequence.\n    digits = _extract_digits(integer)\n    frequencies = _count_frequencies(digits)\n    return _validate_frequencies(frequencies)"}
{"task_id": "Mbpp/282", "solution": "def _validate_lists(list1: list, list2: list) -> bool:\n    \"\"\"\n    Validate that input lists are compatible for element-wise subtraction.\n    Raises ValueError if lists have different lengths.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise ValueError(\"Input lists must have the same length.\")\n    return True\n\ndef _calculate_differences(list1: list, list2: list) -> list:\n    \"\"\"\n    Calculate element-wise differences between two lists.\n    Returns a new list with calculated differences.\n    \"\"\"\n    result = []\n    for i in range(len(list1)):\n        result.append(list1[i] - list2[i])\n    return result\n\ndef sub_list(list1: list, list2: list) -> list:\n    \"\"\"\n    Subtract corresponding elements from two lists element-wise.\n    Returns a new list containing element-wise subtraction results.\n    \"\"\"\n    _validate_lists(list1, list2)\n    return _calculate_differences(list1, list2)"}
