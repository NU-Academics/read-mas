{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) from i=0 up to n // 2,\n    stopping when terms become non-positive.\n    \"\"\"\n    current_sum = 0\n    i = 0\n    while True:\n        term = n - 2 * i\n        if term <= 0:\n            break\n        current_sum += term\n        i += 1\n    return current_sum"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integer solutions (x, y) for the linear Diophantine equation ax + by = n.\n    Returns (x, y) if a solution exists, otherwise returns None.\n    \"\"\"\n\n    def _extended_gcd(num1: int, num2: int) -> tuple[int, int, int]:\n        \"\"\"\n        Implements the Extended Euclidean Algorithm to find gcd(num1, num2)\n        and coefficients s, t such that gcd = num1*s + num2*t.\n        \"\"\"\n        if num1 == 0:\n            return num2, 0, 1\n        gcd_val, s1, t1 = _extended_gcd(num2 % num1, num1)\n        s = t1 - (num2 // num1) * s1\n        t = s1\n        return gcd_val, s, t\n\n    # Handle cases where one or both coefficients are zero\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n    if a == 0: # Equation is by = n\n        if n % b == 0:\n            return (0, n // b)\n        else:\n            return None\n    if b == 0: # Equation is ax = n\n        if n % a == 0:\n            return (n // a, 0)\n        else:\n            return None\n\n    # Use Extended Euclidean Algorithm to find gcd and initial coefficients\n    gcd_val, s, t = _extended_gcd(a, b)\n\n    # Check if a solution exists (n must be divisible by gcd(a, b))\n    if n % gcd_val != 0:\n        return None\n\n    # Calculate the particular solution\n    factor = n // gcd_val\n    x_particular = s * factor\n    y_particular = t * factor\n\n    return (x_particular, y_particular)"}
{"task_id": "Mbpp/166", "solution": "from typing import List, Tuple\n\ndef _is_even(value: int) -> bool:\n    \"\"\"Determine if a number is even.\"\"\"\n    return value % 2 == 0\n\ndef _calculate_xor(a: int, b: int) -> int:\n    \"\"\"Calculate XOR of two integers.\"\"\"\n    return a ^ b\n\ndef _generate_pairs(numbers: List[int]) -> List[Tuple[int, int]]:\n    \"\"\"Generate all unique pairs from input list.\"\"\"\n    pairs = []\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            pairs.append((numbers[i], numbers[j]))\n    return pairs\n\ndef find_even_pair(numbers: List[int]) -> int:\n    \"\"\"Counts pairs of integers in a list that xor to an even number.\"\"\"\n    if len(numbers) < 2:\n        return 0\n\n    even_pair_count = 0\n    pairs = _generate_pairs(numbers)\n\n    for a, b in pairs:\n        xor_result = _calculate_xor(a, b)\n        if _is_even(xor_result):\n            even_pair_count += 1\n            \n    return even_pair_count"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string that occur at the same position as in the English alphabet.\n    The comparison is case-insensitive, and only the first 26 positions are considered.\n    \"\"\"\n    count = 0\n    # Iterate through the string, but only up to 26 characters as there are 26 alphabet positions.\n    for i in range(min(len(input_string), 26)):\n        char_at_pos = input_string[i].lower()\n        # Calculate the expected character for the current position i.\n        expected_char = chr(ord('a') + i)\n        if char_at_pos == expected_char:\n            count += 1\n    return count"}
