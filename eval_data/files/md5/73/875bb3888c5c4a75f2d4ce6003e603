{"task_id": "Mbpp/415", "solution": "from typing import List, Tuple\nimport math\n\nclass Array:\n    \"\"\"Represents and validates an input integer array.\"\"\"\n    def __init__(self, integers: List[int]) -> None:\n        self._integers = integers\n        self._length = len(integers)\n\n    def validate(self) -> bool:\n        \"\"\"Validates if the array contains at least 2 elements.\"\"\"\n        return self._length >= 2\n\n    def get_elements(self) -> List[int]:\n        \"\"\"Returns the stored list of integers.\"\"\"\n        return self._integers\n\n    def get_length(self) -> int:\n        \"\"\"Returns the length of the array.\"\"\"\n        return self._length\n\nclass Pair:\n    \"\"\"Represents a pair of integers and calculates their product.\"\"\"\n    def __init__(self, first: int, second: int, pos1: int, pos2: int) -> None:\n        self._first_element = first\n        self._second_element = second\n        self._first_position = pos1 # Stored for potential future use, not directly used in product/tuple\n        self._second_position = pos2 # Stored for potential future use, not directly used in product/tuple\n        self._product = self.calculate_product() # Calculate product on initialization\n\n    def calculate_product(self) -> int:\n        \"\"\"Calculates and returns the product of the two elements.\"\"\"\n        return self._first_element * self._second_element\n\n    def get_product(self) -> int:\n        \"\"\"Returns the pre-calculated product of the pair.\"\"\"\n        return self._product\n\n    def get_tuple(self) -> Tuple[int, int]:\n        \"\"\"Returns the pair as a tuple, sorted ascendingly.\"\"\"\n        return (min(self._first_element, self._second_element), max(self._first_element, self._second_element))\n\ndef max_Product(arr: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    Finds a pair with the highest product from a given array of integers.\n    Returns the pair as a tuple (min_val, max_val).\n    \"\"\"\n    array_obj = Array(arr)\n\n    if not array_obj.validate():\n        raise ValueError(\"Array must contain at least 2 elements.\")\n\n    elements = array_obj.get_elements()\n    n = array_obj.get_length()\n\n    max_product_val = -math.inf\n    max_pair_tuple = (0, 0) # Placeholder, will be updated with the actual maximum pair\n\n    # Iterate through all unique pairs of elements\n    for i in range(n):\n        for j in range(i + 1, n):\n            current_pair = Pair(elements[i], elements[j], i, j)\n            current_product = current_pair.get_product()\n\n            if current_product > max_product_val:\n                max_product_val = current_product\n                max_pair_tuple = current_pair.get_tuple()\n\n    return max_pair_tuple"}
