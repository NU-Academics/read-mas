{"task_id": "Mbpp/592", "solution": "def sum_Of_product(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the product of consecutive binomial coefficients C(n,k) * C(n,k+1) for k from 0 to n-1.\n    \"\"\"\n\n    def _calculate_binomial_coefficient(n_val: int, k_val: int) -> int:\n        \"\"\"\n        Computes the binomial coefficient C(n_val, k_val).\n        \"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        # Optimization: C(n, k) = C(n, n-k)\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n\n        res = 1\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    total_sum = 0\n    for k in range(n):\n        coeff_k = _calculate_binomial_coefficient(n, k)\n        coeff_k_plus_1 = _calculate_binomial_coefficient(n, k + 1)\n        total_sum += coeff_k * coeff_k_plus_1\n\n    return total_sum"}
{"task_id": "Mbpp/590", "solution": "import math\n\ndef polar_rect(radius: float, angle: float) -> tuple[tuple[float, float], complex]:\n    \"\"\"\n    Convert polar coordinates to rectangular coordinates.\n\n    Args:\n        radius: Distance from origin\n        angle: Angle in radians\n\n    Returns:\n        Tuple containing ((magnitude, angle), complex_number)\n    \"\"\"\n    x = radius * math.cos(angle)\n    y = radius * math.sin(angle)\n\n    magnitude = math.sqrt(x * x + y * y)\n    output_angle = math.atan2(y, x)\n\n    complex_number = complex(x, y)\n\n    return ((magnitude, output_angle), complex_number)"}
{"task_id": "Mbpp/589", "solution": "import math\n\ndef _calculate_first_square(start: int) -> int:\n    \"\"\"\n    Calculates the smallest non-negative integer root whose square is greater than or equal to 'start'.\n    This handles cases where 'start' is not itself a perfect square.\n    \"\"\"\n    if start <= 0:\n        return 0\n    \n    root = math.isqrt(start)\n    # If root*root is less than start, we need to increment the root to find the next square.\n    if root * root < start:\n        root += 1\n    return root\n\ndef _generate_squares(first_root: int, end: int) -> list[int]:\n    \"\"\"\n    Generates a list of perfect squares starting from first_root**2, up to and including 'end'.\n    The squares are added to the list in ascending order.\n    \"\"\"\n    perfect_squares_list = []\n    current_root = first_root\n    while True:\n        square = current_root * current_root\n        if square > end:\n            break\n        perfect_squares_list.append(square)\n        current_root += 1\n    return perfect_squares_list\n\ndef perfect_squares(start: int, end: int) -> list[int]:\n    \"\"\"\n    Finds all perfect squares within the inclusive range [start, end].\n    Returns an empty list if no perfect squares are found or if the range is invalid.\n    \"\"\"\n    # Adjust start to be at least 0, as perfect squares are non-negative.\n    effective_start = max(0, start)\n    \n    # If the effective range is invalid (end is less than effective_start), return an empty list.\n    if end < effective_start:\n        return []\n\n    first_root = _calculate_first_square(effective_start)\n    \n    # If the square of the first_root already exceeds 'end', there are no perfect squares in the range.\n    if first_root * first_root > end:\n        return []\n        \n    return _generate_squares(first_root, end)"}
