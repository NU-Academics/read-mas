{"task_id": "Mbpp/809", "solution": "def check_smaller(tuple1: tuple, tuple2: tuple) -> bool:\n    \"\"\"\n    Check if each element of second tuple is smaller than its corresponding element in the first tuple.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        return False\n    \n    for i in range(len(tuple1)):\n        if not (tuple2[i] < tuple1[i]):\n            return False\n            \n    return True"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Find the maximum run of consecutive uppercase characters in a string.\n\n    Args:\n        input_string (str): The input string to analyze\n\n    Returns:\n        int: Length of the longest consecutive uppercase character sequence\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if 'A' <= char <= 'Z':  # Check if the character is an uppercase letter\n            current_run += 1\n            if current_run > max_run:\n                max_run = current_run\n        else:\n            current_run = 0\n    return max_run"}
{"task_id": "Mbpp/805", "solution": "from typing import List, Union\n\ndef max_sum_list(lists: List[List[Union[int, float]]]) -> List[Union[int, float]]:\n    \"\"\"\n    Returns the list with the highest sum of elements.\n    Iterates through the input lists, calculates their sums, and tracks the list with the maximum sum found.\n    \"\"\"\n    max_sum = float('-inf')\n    max_list = None\n\n    for inner_list in lists:\n        current_sum = sum(inner_list)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            max_list = inner_list\n            \n    return max_list"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers: list) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    Returns True if the product is even, False otherwise.\n    \"\"\"\n    if not numbers:\n        # An empty list's product is conventionally 1, which is not even.\n        return False\n\n    product = 1\n    for num in numbers:\n        product *= num\n\n    # Check if the final product is even. This handles integers and floats correctly.\n    # For example, 4.0 % 2 will be 0.0, 4.5 % 2 will be 0.5.\n    return product % 2 == 0"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(number: int, distance: int) -> int:\n    \"\"\"\n    Rotates the bits of a 32-bit number left by a specified distance.\n    The rotation wraps bits from the most significant bit to the least significant bit.\n    \"\"\"\n    NUM_BITS = 32\n    normalized_distance = distance % NUM_BITS\n    # Perform the left rotation: (bits shifted left | bits that wrapped around)\n    # The final mask ensures the result remains within 32 bits.\n    return ((number << normalized_distance) | (number >> (NUM_BITS - normalized_distance))) & 0xFFFFFFFF"}
