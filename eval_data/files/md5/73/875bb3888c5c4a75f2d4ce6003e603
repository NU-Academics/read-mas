{"task_id": "Mbpp/615", "solution": "def average_tuple(tuples: tuple) -> list[float]:\n    \"\"\"\n    Calculate the average value for each inner tuple and return as a list.\n    Handles division by zero for empty inner tuples, returning 0.0 for such cases.\n    \"\"\"\n    averages = []\n    for inner_tuple in tuples:\n        if inner_tuple: # Check if the inner tuple is not empty to avoid division by zero\n            averages.append(sum(inner_tuple) / len(inner_tuple))\n        else:\n            averages.append(0.0) # Append 0.0 for empty inner tuples\n    return averages"}
{"task_id": "Mbpp/616", "solution": "def _validate_input_length(tuple1: tuple, tuple2: tuple) -> None:\n    \"\"\"Validate that both tuples have the same length.\"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Tuples must have the same length.\")\n\ndef _handle_division_by_zero(dividend: int | float, divisor: int | float) -> int | float:\n    \"\"\"Handle division by zero cases gracefully.\"\"\"\n    if divisor == 0:\n        raise ZeroDivisionError(\"Division by zero\")\n    return divisor\n\ndef tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Perform element-wise modulo operation on two tuples.\"\"\"\n    _validate_input_length(tuple1, tuple2)\n\n    results = []\n    for i in range(len(tuple1)):\n        dividend = tuple1[i]\n        divisor = tuple2[i]\n        \n        _handle_division_by_zero(dividend, divisor) # This call handles error raising for divisor == 0\n\n        results.append(dividend % divisor)\n    \n    return tuple(results)"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    # Separates a string into non-numeric and numeric parts, then concatenates them.\n    non_numeric_chars = []\n    numeric_chars = []\n    for char in input_string:\n        if '0' <= char <= '9':  # Check if the character is a digit\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n    return \"\".join(non_numeric_chars) + \"\".join(numeric_chars)"}
{"task_id": "Mbpp/620", "solution": "import itertools\n\ndef largest_subset(numbers):\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible.\n    A pair (a, b) is valid if a % b == 0 or b % a == 0.\n    \"\"\"\n\n    if not numbers:\n        return 0\n    if len(numbers) == 1:\n        return 1\n\n    def is_divisible(a, b):\n        if b == 0:  # Avoid division by zero, though problem implies positive integers usually\n            return False # Or handle as per specific problem constraints for 0. Assuming 0 cannot divide others.\n        return a % b == 0\n\n    def is_pair_valid(a, b):\n        return is_divisible(a, b) or is_divisible(b, a)\n\n    def is_valid_subset(subset):\n        if len(subset) <= 1:\n            return True\n        for i in range(len(subset)):\n            for j in range(i + 1, len(subset)):\n                if not is_pair_valid(subset[i], subset[j]):\n                    return False\n        return True\n\n    max_size = 0\n    # Sort the numbers to potentially optimize, though not strictly required for correctness\n    # If the problem statement implied a strictly increasing chain, sorting would be crucial.\n    # For any pair divisibility, sorting might help with some DP approaches, but not brute-force subset generation.\n    # For this approach, sorting doesn't change correctness or complexity significantly.\n    \n    # The design context implies generate_all_subsets and then validate.\n    # This can be inefficient for large inputs. A more efficient approach for this problem\n    # usually involves dynamic programming after sorting the input list.\n    # However, strictly following the design context for \"generate_all_subsets\" and \"find_largest_valid_subset\"\n    # means iterating through all combinations.\n\n    # Generate all possible subsets and check for validity\n    for i in range(len(numbers) + 1):\n        for subset_tuple in itertools.combinations(numbers, i):\n            current_subset = list(subset_tuple)\n            if is_valid_subset(current_subset):\n                max_size = max(max_size, len(current_subset))\n    \n    return max_size"}
