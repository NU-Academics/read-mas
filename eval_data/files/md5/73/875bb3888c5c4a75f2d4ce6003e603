{"task_id": "Mbpp/12", "solution": "import collections\nimport functools\nimport heapq\nimport itertools\nimport math\nimport operator\nimport random\nimport re\nimport sys\nimport typing\n\ndef sort_matrix(matrix: typing.List[typing.List[typing.Union[int, float]]]) -> typing.List[typing.List[typing.Union[int, float]]]:\n    \"\"\"\n    Sorts a matrix by the sum of its rows in ascending order.\n    Returns a new matrix without modifying the input.\n    \"\"\"\n    if not matrix:\n        return []\n\n    # Calculate sums for each row and store with original row\n    # Use tuple (sum, original_row_index, row_data) to ensure stable sort for equal sums\n    # original_row_index is used as a tie-breaker, preserving original order for rows with identical sums.\n    rows_with_sums = []\n    for i, row in enumerate(matrix):\n        row_sum = sum(row)\n        rows_with_sums.append((row_sum, i, row))\n\n    # Sort based on the row sums (first element of the tuple)\n    # Python's Timsort is stable, so original_row_index is implicitly used for tie-breaking\n    # when sums are equal, but explicitly including it makes the intent clearer and\n    # guarantees stability even with different sort implementations.\n    rows_with_sums.sort()\n\n    # Extract and return the sorted rows\n    sorted_matrix = [row_data for row_sum, original_row_index, row_data in rows_with_sums]\n\n    return sorted_matrix"}
{"task_id": "Mbpp/56", "solution": "def check(number: int) -> bool:\n    \"\"\"\n    Checks if a number is one less than twice its reverse.\n    Uses helper functions for reversing the number and validating the condition.\n    \"\"\"\n\n    def reverse_number(n: int) -> int:\n        \"\"\"Reverses the digits of an integer number.\"\"\"\n        reversed_num = 0\n        while n > 0:\n            digit = n % 10\n            reversed_num = reversed_num * 10 + digit\n            n //= 10\n        return reversed_num\n\n    def validate_condition(original: int, twice_reversed: int) -> bool:\n        \"\"\"Checks if the original number is one less than the 'twice_reversed' value.\"\"\"\n        return original == twice_reversed - 1\n\n    reversed_val = reverse_number(number)\n    twice_reversed_val = reversed_val * 2\n    return validate_condition(number, twice_reversed_val)"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(source_string: str, filter_string: str) -> str:\n    \"\"\"\n    Removes characters from the source_string that are present in the filter_string.\n    The order of the remaining characters is preserved.\n    \"\"\"\n    filter_set = set(filter_string)\n    result_chars = []\n    for char in source_string:\n        if char not in filter_set:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    # Checks if the given number is a Woodall number using the formula n * 2^n - 1.\n    # Iterates through positive integers n to find a match or determine if no match exists.\n    if number < 1:\n        return False\n\n    n = 1\n    while True:\n        woodall_value = n * (2**n) - 1\n        if woodall_value == number:\n            return True\n        elif woodall_value > number:\n            return False\n        n += 1"}
{"task_id": "Mbpp/16", "solution": "LOWERCASE_LETTERS = \"abcdefghijklmnopqrstuvwxyz\"\nUNDERSCORE = \"_\"\nVALID_CHARACTERS = set(LOWERCASE_LETTERS + UNDERSCORE)\n\ndef is_valid_character_set(input_string: str) -> bool:\n    \"\"\"Checks if the string contains only lowercase letters and underscores.\"\"\"\n    for char in input_string:\n        if char not in VALID_CHARACTERS:\n            return False\n    return True\n\ndef starts_or_ends_with_underscore(input_string: str) -> bool:\n    \"\"\"Checks if the string starts or ends with an underscore.\"\"\"\n    if not input_string:\n        return False\n    return input_string[0] == UNDERSCORE or input_string[-1] == UNDERSCORE\n\ndef has_consecutive_underscores(input_string: str) -> bool:\n    \"\"\"Checks for consecutive underscore patterns in the string.\"\"\"\n    for i in range(len(input_string) - 1):\n        if input_string[i] == UNDERSCORE and input_string[i+1] == UNDERSCORE:\n            return True\n    return False\n\ndef has_valid_underscore_positions(input_string: str) -> bool:\n    \"\"\"Validates underscore placement rules, orchestrating checks for leading/trailing and consecutive underscores.\"\"\"\n    if starts_or_ends_with_underscore(input_string):\n        return False\n    if has_consecutive_underscores(input_string):\n        return False\n    return True\n\ndef validate_letter_sequences(input_string: str) -> bool:\n    \"\"\"Ensures that sequences of lowercase letters are properly separated by single underscores.\"\"\"\n    # Assumes character set and underscore position checks have already passed.\n    # If no underscore, it's a valid single sequence of lowercase letters.\n    if UNDERSCORE not in input_string:\n        return True\n\n    # If it contains underscores, check neighbors of each underscore.\n    for i, char in enumerate(input_string):\n        if char == UNDERSCORE:\n            # Due to prior checks, i > 0, i < len-1, and neighbors are not underscores.\n            # We just need to ensure neighbors are lowercase letters.\n            if input_string[i-1] not in LOWERCASE_LETTERS or input_string[i+1] not in LOWERCASE_LETTERS:\n                return False\n    return True\n\ndef has_valid_sequence_format(input_string: str) -> bool:\n    \"\"\"Validates the overall sequence pattern, delegating to validate_letter_sequences.\"\"\"\n    return validate_letter_sequences(input_string)\n\ndef text_lowercase_underscore(input_string: str) -> bool:\n    \"\"\"\n    Returns true if the input string contains sequences of lowercase letters\n    joined with an underscore and false otherwise.\n    \"\"\"\n    if not input_string:\n        return False\n\n    if not is_valid_character_set(input_string):\n        return False\n\n    if not has_valid_underscore_positions(input_string):\n        return False\n\n    if not has_valid_sequence_format(input_string):\n        return False\n\n    return True"}
