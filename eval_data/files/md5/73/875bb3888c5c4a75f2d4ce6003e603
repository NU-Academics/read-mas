ins at least one numeric value\n        # that will be filtered. If not, the behavior for an empty filtered list is undefined\n        # by the example and constraints, but `max()` would raise an error.\n        # Let's consider the strictest interpretation: max() will always be called on a non-empty list.\n        # If the problem truly expects an int return even for no numeric values, then a default\n        # integer like 0 or None (which would break type hint) would be needed.\n        # Given the direct example `assert max_val(...) == 5`, this suggests `numeric_values` will not be empty.\n        pass # The subsequent `max` call would raise an error here if uncommented.\n    return max(numeric_values)"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(tuple_list):\n    \"\"\"\n    Calculates the maximum aggregate sum for names from a list of (name, value) tuples.\n    It groups values by name, sums them, and finds the name with the highest total.\n    \"\"\"\n    # Grouping Stage: Aggregate all values for each name\n    name_aggregates = {}\n    for name, value in tuple_list:\n        name_aggregates[name] = name_aggregates.get(name, 0) + value\n\n    # Maximum Finding Stage: Identify the name with the highest aggregate sum\n    if not name_aggregates:\n        return None  # Or raise an error, or return a default empty tuple based on specification\n\n    max_name = None\n    max_sum = -float('inf')  # Initialize with negative infinity for robust comparison\n\n    for name, total_sum in name_aggregates.items():\n        if total_sum > max_sum:\n            max_sum = total_sum\n            max_name = name\n            \n    # Result Formation\n    return (max_name, max_sum)"}
{"task_id": "Mbpp/297", "solution": "from typing import List, Any\n\ndef flatten_list(nested_list: List[Any]) -> List[Any]:\n    \"\"\"\n    Flattens a nested list structure into a single-level list.\n    Elements are extracted recursively, preserving their original order.\n    \"\"\"\n    result = []\n    for item in nested_list:\n        if isinstance(item, list):\n            result.extend(flatten_list(item))\n        else:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef count_binary_seq(n: int) -> float:\n    \"\"\"Count binary sequences of length 2n with equal half-sums.\"\"\"\n\n    def binomial_coefficient(bc_n: int, bc_k: int) -> int:\n        \"\"\"Calculate binomial coefficient C(n,k).\"\"\"\n        if bc_k < 0 or bc_k > bc_n:\n            return 0\n        return math.factorial(bc_n) // (math.factorial(bc_k) * math.factorial(bc_n - bc_k))\n\n    def sequence_count_calculator(scc_n: int) -> float:\n        \"\"\"Calculate sequence count using mathematical formula.\"\"\"\n        total_count = 0.0\n        for k_val in range(scc_n + 1):\n            coeff = binomial_coefficient(scc_n, k_val)\n            total_count += float(coeff * coeff)\n        return total_count\n\n    def validate_positive_integer(val_n: int) -> bool:\n        \"\"\"Validate that input is a positive integer.\"\"\"\n        return val_n > 0\n\n    def _validate_input(input_n: int) -> bool:\n        \"\"\"Validate input parameter.\"\"\"\n        return validate_positive_integer(input_n)\n\n    def _compute_sequence_count(compute_n: int) -> float:\n        \"\"\"Compute the actual sequence count.\"\"\"\n        return sequence_count_calculator(compute_n)\n\n    # Adhering to the design, validation is called,\n    # but \"Do NOT add isinstance() checks or raise exceptions\" implies 'n' is always a valid positive int.\n    # Therefore, no explicit error handling for a 'False' result from _validate_input.\n    _validate_input(n)\n    return _compute_sequence_count(n)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(input_dict: dict) -> int:\n    \"\"\"\n    Calculate the maximum depth of nested dictionaries.\n\n    Args:\n        input_dict (dict): Dictionary to analyze for depth\n\n    Returns:\n        int: Maximum depth count starting from 1 for outermost level\n    \"\"\"\n    max_depth = 1\n    for key, value in input_dict.items():\n        if isinstance(value, dict) and value:  # Check if value is a non-empty dictionary\n            max_depth = max(max_depth, 1 + dict_depth(value))\n        elif isinstance(value, dict) and not value: # Empty dictionary still counts as a level\n            max_depth = max(max_depth, 2) # An empty dict nested one level deep means depth 2 (outer + empty)\n    return max_depth"}
