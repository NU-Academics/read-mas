{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(array, size):\n    \"\"\"\n    Counts the number of pairs in an array whose XOR value is odd.\n    Iterates through all unique pairs, computes their XOR, and increments a counter if the result is odd.\n    \"\"\"\n    odd_xor_pairs_count = 0\n    for i in range(size):\n        for j in range(i + 1, size):\n            # Calculate the XOR of the pair\n            xor_value = array[i] ^ array[j]\n            # Check if the XOR value is odd (last bit is 1)\n            if (xor_value & 1) == 1:\n                odd_xor_pairs_count += 1\n    return odd_xor_pairs_count"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1, num2):\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers.\n    Handles integers of different lengths by treating missing digits as zero.\n    \"\"\"\n    def extract_digits(number):\n        \"\"\"Extracts digits from an integer, returning them in a list from least significant to most significant.\"\"\"\n        number = abs(number)\n        if number == 0:\n            return [0]\n        digits = []\n        while number > 0:\n            digits.append(number % 10)\n            number //= 10\n        return digits\n\n    def calculate_differences(digits1, digits2):\n        \"\"\"Calculates per-digit absolute differences between two lists of digits, padding the shorter list with zeros.\"\"\"\n        max_len = max(len(digits1), len(digits2))\n        differences = []\n        for i in range(max_len):\n            d1 = digits1[i] if i < len(digits1) else 0\n            d2 = digits2[i] if i < len(digits2) else 0\n            differences.append(abs(d1 - d2))\n        return differences\n\n    def sum_differences(differences):\n        \"\"\"Sums all differences in a list.\"\"\"\n        return sum(differences)\n\n    digits1 = extract_digits(num1)\n    digits2 = extract_digits(num2)\n\n    differences = calculate_differences(digits1, digits2)\n    total_sum = sum_differences(differences)\n\n    return total_sum"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr: list, length: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist using Kadane's algorithm.\n    It iterates through the list, maintaining the maximum sum found so far and the maximum sum ending at the current position.\n    \"\"\"\n    if not arr: # Handles an empty list if it's a possibility, though problem implies non-empty.\n        return 0 # Or raise an error, but problem context suggests valid input.\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, length):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
