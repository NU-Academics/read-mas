{"task_id": "Mbpp/9", "solution": "def _validate_input(s: str) -> bool:\n    \"\"\"\n    Validate input string parameter.\n    Given problem constraints, this function assumes 's' is always a non-empty string.\n    \"\"\"\n    return True\n\ndef _find_period(s: str) -> int:\n    \"\"\"\n    Find the period (shortest repeating unit length) of the string.\n    This is the smallest positive integer k such that s can be formed by repeating s[:k].\n    \"\"\"\n    n = len(s)\n    for k in range(1, n + 1):\n        if n % k == 0 and s == s[:k] * (n // k):\n            return k\n    return n # Should be covered by k=n in the loop, but included for completeness.\n\ndef find_Rotations(s: str) -> int:\n    \"\"\"\n    Find minimum number of rotations greater than 0 to get same string.\n\n    Args:\n        s: Input string to analyze\n\n    Returns:\n        int: Minimum rotations needed (> 0)\n    \"\"\"\n    _validate_input(s) # Call to helper as per design.\n\n    # The minimum number of rotations to get the same string is its shortest period.\n    return _find_period(s)"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string, target_char):\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    Returns the original string if the character is not found.\n    \"\"\"\n    first_idx = input_string.find(target_char)\n    if first_idx == -1:\n        return input_string\n\n    last_idx = input_string.rfind(target_char)\n\n    if first_idx == last_idx:\n        # Character appears only once\n        return input_string[:first_idx] + input_string[first_idx + 1:]\n    else:\n        # Character appears multiple times\n        # Remove first occurrence\n        temp_string = input_string[:first_idx] + input_string[first_idx + 1:]\n        # Adjust last_idx for the new string\n        # If the original last_idx was after the removed first_idx, it shifts left by 1\n        adjusted_last_idx = last_idx - 1 if last_idx > first_idx else last_idx\n        # Remove last occurrence from the temp_string\n        return temp_string[:adjusted_last_idx] + temp_string[adjusted_last_idx + 1:]"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two integers differ at exactly one bit position.\n    This is true if their XOR result is a positive power of two.\n    \"\"\"\n    xor_result = num1 ^ num2\n    # A number is a power of two (and positive) if it's greater than 0\n    # and has only one bit set, which is checked by (xor_result & (xor_result - 1)) == 0.\n    return xor_result > 0 and (xor_result & (xor_result - 1)) == 0"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List, Union\n\ndef _validate_inputs(numbers: List[Union[int, float]], n: int) -> bool:\n    \"\"\"Validates input parameters. Ensures `n` is non-negative for proper heap processing.\"\"\"\n    return n >= 0\n\ndef _process_with_heap(numbers: List[Union[int, float]], n: int) -> List[Union[int, float]]:\n    \"\"\"Uses a heap algorithm to find the `n` largest elements. Delegates to `heapq.nlargest` for efficiency and descending order.\"\"\"\n    return heapq.nlargest(n, numbers)\n\ndef heap_queue_largest(numbers: List[Union[int, float]], n: int) -> List[Union[int, float]]:\n    \"\"\"Finds the `n` largest integers from a list, returned in descending order.\"\"\"\n    if not _validate_inputs(numbers, n):\n        # If n is negative, return an empty list as per graceful handling.\n        return []\n    \n    result = _process_with_heap(numbers, n)\n    \n    # heapq.nlargest already returns elements in descending order, fulfilling the sorting requirement.\n    return result"}
