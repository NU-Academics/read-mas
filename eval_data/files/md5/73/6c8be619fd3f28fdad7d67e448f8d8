* previous, and current <= m.\n    \"\"\"\n    # dp[i][j] stores the count of sequences of length i ending with value j.\n    # Dimensions are (n + 1) x (m + 1) to use 1-based indexing for length and element values.\n    dp = [[0] * (m + 1) for _ in range(n + 1)]\n\n    # Base case: sequences of length 1. Any positive integer from 1 to m is a valid sequence.\n    for j in range(1, m + 1):\n        dp[1][j] = 1\n\n    # Fill the DP table for lengths 2 to n.\n    for i in range(2, n + 1):\n        for j in range(1, m + 1):  # Iterate through all possible values for the current element (j)\n            # The previous element (k) must satisfy k * 2 <= j.\n            # This means k can range from 1 up to j // 2.\n            for k in range(1, j // 2 + 1):\n                dp[i][j] += dp[i - 1][k]\n\n    # The total number of sequences of length n is the sum of counts for all possible ending elements.\n    total_sequences = sum(dp[n][j] for j in range(1, m + 1))\n    return total_sequences", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the number of possible sequences of length n, where each element\n    is a positive integer, greater than or equal to twice the previous element,\n    but less than or equal to m.\n\n    Args:\n        m: A positive integer representing the maximum allowed value for any element in the sequence.\n        n: A positive integer representing the desired length of the sequence.\n\n    Returns:\n        The total count of valid sequences.\n\n    Raises:\n        ValueError: If m or n are not positive integers.\n    \"\"\"\n    if not isinstance(m, int) or not isinstance(n, int):\n        raise ValueError(\"Inputs m and n must be integers.\")\n    if m <= 0 or n <= 0:\n        raise ValueError(\"Inputs m and n must be positive integers.\")\n\n    # dp[k][val] stores the number of sequences of length k ending with val.\n    # prefix_sum_dp[k][val] stores the sum of dp[k][i] for i from 1 to val.\n    dp = [[0] * (m + 1) for _ in range(n + 1)]\n    prefix_sum_dp = [[0] * (m + 1) for _ in range(n + 1)]\n\n    # Base case: sequences of length 1.\n    # Any positive integer up to m can be the first element.\n    for val in range(1, m + 1):\n        dp[1][val] = 1\n        prefix_sum_dp[1][val] = prefix_sum_dp[1][val - 1] + dp[1][val]\n\n    # Fill the DP table for lengths from 2 to n.\n    for k in range(2, n + 1):\n        for current_val in range(1, m + 1):\n            # A sequence of length k ending with current_val can be formed\n            # by appending current_val to a sequence of length k-1 ending with prev_val,\n            # where prev_val * 2 <= current_val.\n            # This means prev_val can be any value from 1 up to current_val // 2.\n            max_prev_val = current_val // 2\n            if max_prev_val > 0:\n                dp[k][current_val] = prefix_sum_dp[k - 1][max_prev_val]\n            else:\n                # No previous element can satisfy prev_val * 2 <= current_val if current_val is 0 or 1.\n                dp[k][current_val] = 0\n\n            # Update the prefix sum for the current length k.\n            prefix_sum_dp[k][current_val] = prefix_sum_dp[k][current_val - 1] + dp[k][current_val]\n\n    # The total number of sequences of length n is the sum of dp[n][val] for all possible val.\n    # This is conveniently stored in prefix_sum_dp[n][m].\n    return prefix_sum_dp[n][m]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/123": [{"task_id": "Mbpp/123", "solution": "def sum_proper_divisors(n: int) -> int:\n    \"\"\"Calculates the sum of proper divisors for a given positive integer n.\n    This function efficiently finds divisors by iterating up to the square root of n.\"\"\"\n    if n == 1:\n        return 0\n\n    total_sum = 1\n    for i in range(2, int(n*