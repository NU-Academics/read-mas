ow_sum = sum(row)\n        # Append a copy of the row to ensure the original matrix isn't modified\n        # if the original rows are mutable and later changed.\n        rows_with_sums.append((row_sum, row[:]))\n\n    # Sort based on the row_sum (the first element of the tuple).\n    # Python's built-in sorted() is stable, preserving the relative order of\n    # rows with equal sums, which aligns with the design's business rule BR2.\n    sorted_rows_with_sums = sorted(rows_with_sums, key=lambda x: x[0])\n\n    # Extract only the sorted rows from the tuples\n    sorted_matrix_list = [row for _, row in sorted_rows_with_sums]\n\n    return sorted_matrix_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/17": [{"task_id": "Mbpp/17", "solution": "def square_perimeter(side_length: float) -> float:\n    \"\"\"Calculates the perimeter of a square.\n    It multiplies the side length by 4.\n    \"\"\"\n    return 4 * side_length", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/17", "solution": "def square_perimeter(side_length: float) -> float:\n    \"\"\"Calculates the perimeter of a square given its side length.\n    It multiplies the provided side_length by 4.\n    \"\"\"\n    return 4 * side_length", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/20": [{"task_id": "Mbpp/20", "solution": "def is_woodall(num: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number (n * 2^n - 1 for n >= 1).\n    Returns True if it is, False otherwise.\n    \"\"\"\n    if num <= 0:\n        return False\n\n    n = 1\n    while True:\n        woodall_candidate = n * (2**n) - 1\n        if woodall_candidate == num:\n            return True\n        if woodall_candidate > num:\n            return False\n        n += 1", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_test