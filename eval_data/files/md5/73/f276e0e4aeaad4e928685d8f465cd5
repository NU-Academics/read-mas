{"task_id": "HumanEval/22", "solution": "def filter_integers(values: List[Any]) -> List[int]:\n    \"\"\" Filter given list of any python values only for integers\n    >>> filter_integers(['a', 3.14, 5])\n    [5]\n    >>> filter_integers([1, 2, 3, 'abc', {}, []])\n    [1, 2, 3]\n    \"\"\"\n    result: List[int] = []\n    for v in values:\n        # Exclude booleans, which are a subclass of int, by checking the exact type.\n        if type(v) is int:\n            result.append(v)\n    return result"}
{"task_id": "HumanEval/19", "solution": "def sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    import re\n    from typing import Dict, Set, List # List is already imported in the stub\n\n    # --- Constants ---\n    WORD_TO_INT: Dict[str, int] = {\n        'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n        'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n    }\n    INT_TO_WORD: Dict[int, str] = {\n        0: 'zero', 1: 'one', 2: 'two', 3: 'three', 4: 'four',\n        5: 'five', 6: 'six', 7: 'seven', 8: 'eight', 9: 'nine'\n    }\n    ALLOWED_WORDS: Set[str] = set(WORD_TO_INT.keys())\n\n    # --- Errors ---\n    class InvalidTokenError(Exception):\n        \"\"\"Raised when an invalid token is encountered.\"\"\"\n        pass\n\n    class SorterError(Exception):\n        \"\"\"Raised for unexpected errors during sorting.\"\"\"\n        pass\n\n    # --- Parser ---\n    class Parser:\n        _split_pattern: str = r\"\\s+\"\n\n        def parse(self, input_str: str) -> List[str]:\n            if not input_str.strip():\n                return []\n            return re.split(self._split_pattern, input_str.strip())\n\n    # --- Validator ---\n    class Validator:\n        def __init__(self, allowed_words: Set[str] = ALLOWED_WORDS) -> None:\n            self.allowed = allowed_words\n\n        def validate_tokens(self, tokens: List[str]) -> None:\n            invalid_tokens = [token for token in tokens if token not in self.allowed]\n            if invalid_tokens:\n                raise InvalidTokenError(f\"Invalid tokens: {', '.join(invalid_tokens)}\")\n\n    # --- Sorter ---\n    class Sorter:\n        def __init__(self, word_to_int: Dict[str, int] = WORD_TO_INT,\n                     int_to_word: Dict[int, str] = INT_TO_WORD) -> None:\n            self.word_to_int = word_to_int\n            self.int_to_word = int_to_word\n\n        def sort_tokens(self, tokens: List[str]) -> List[str]:\n            try:\n                numeric_values = [self.word_to_int[token] for token in tokens]\n                numeric_values.sort()\n                sorted_words = [self.int_to_word[value] for value in numeric_values]\n                return sorted_words\n            except KeyError as e:\n                # This error indicates a programming error or a bypass of validation.\n                raise SorterError(f\"Internal sorting error: unknown token encountered {e}\") from e\n\n    # --- Formatter ---\n    class Formatter:\n        def format_tokens(self, tokens: List[str]) -> str:\n            return \" \".join(tokens)\n\n    # --- SortAPI (main orchestrator) ---\n    class SortAPI:\n        def __init__(self, parser: Parser = None, validator: Validator = None,\n                     sorter: Sorter = None, formatter: Formatter = None) -> None:\n            self.parser = parser if parser is not None else Parser()\n            self.validator = validator if validator is not None else Validator()\n            self.sorter = sorter if sorter is not None else Sorter()\n            self.formatter = formatter if formatter is not None else Formatter()\n\n        def sort(self, numbers_input_str: str) -> str:\n            if not numbers_input_str.strip():\n                return \"\"\n\n            tokens = self.parser.parse(numbers_input_str)\n            self.validator.validate_tokens(tokens)\n            sorted_tokens = self.sorter.sort_tokens(tokens)\n            return self.formatter.format_tokens(sorted_tokens)\n\n    # Instantiate the API and call its sort method using the input 'numbers'.\n    api = SortAPI()\n    return api.sort(numbers)"}
{"task_id": "HumanEval/17", "solution": "from typing import List, Optional\nimport hashlib\nimport json\nfrom pathlib import Path\nfrom datetime import datetime\n\n\nclass InvalidTokenError(ValueError):\n    \"\"\"Raised when an unknown musical token is encountered.\"\"\"\n    def __init__(self, token: str, message: str = None):\n        super().__init__(message or f\"Invalid token: {token}\")\n        self.token = token\n\n\nclass Tokenizer:\n    \"\"\"Splits an input string into a list of individual note tokens.\"\"\"\n    WHITESPACE_SEPARATORS = (' ', '\\t', '\\n')\n\n    def tokenize(self, text: str) -> List[str]:\n        if text is None:\n            return []\n        return [tok for tok in text.strip().split() if tok]\n\n\nclass NoteMapper:\n    \"\"\"Maps note tokens to their corresponding beat durations.\"\"\"\n    TOKEN_TO_BEATS = {'o': 4, 'o|': 2, '.|': 1}\n\n    def map_token(self, token: str) -> int:\n        try:\n            return self.TOKEN_TO_BEATS[token]\n        except KeyError:\n            raise InvalidTokenError(token)\n\n    def map_tokens(self, tokens: List[str]) -> List[int]:\n        return [self.map_token(t) for t in tokens]\n\n\nclass MusicParser:\n    \"\"\"Parses a music string by tokenizing and mapping notes to beats.\"\"\"\n    def __init__(self, tokenizer: Tokenizer, note_mapper: NoteMapper):\n        self._tokenizer = tokenizer\n        self._note_mapper = note_mapper\n\n    def parse(self, text: str) -> List[int]:\n        tokens = self._tokenizer.tokenize(text)\n        if not tokens:\n            return []\n        return self._note_mapper.map_tokens(tokens)\n\n\ndef safe_hash(text: str) -> str:\n    \"\"\"Generates a deterministic, short hash for a given text string.\"\"\"\n    return hashlib.sha256(text.encode(\"utf-8\")).hexdigest()[:16]\n\n\nclass CacheRepository:\n    \"\"\"Manages a JSON file-based cache for parsed music results.\"\"\"\n    def __init__(self, path: str | Path, ttl_seconds: Optional[int] = None):\n        self._path = Path(path).expanduser()\n        self._ttl_seconds = ttl_seconds\n        self._path.parent.mkdir(parents=True, exist_ok=True)\n\n    def _load(self) -> dict:\n        if not self._path.exists():\n            return {}\n        try:\n            return json.loads(self._path.read_text())\n        except (json.JSONDecodeError, FileNotFoundError):\n            return {}\n\n    def get(self, key: str) -> Optional[List[int]]:\n        try:\n            data = self._load()\n            item = data.get(key)\n            if not item:\n                return None\n            return item[\"value\"]\n        except Exception:\n            return None\n\n    def set(self, key: str, value: List[int]) -> None:\n        try:\n            data = self._load()\n            data[key] = {\"created_at\": datetime.utcnow().isoformat(), \"value\": value}\n            self._path.write_text(json.dumps(data))\n        except Exception:\n            pass\n\n\nclass MusicService:\n    \"\"\"Provides the main API for parsing music, including optional caching.\"\"\"\n    def __init__(self, parser: MusicParser, cache: Optional[CacheRepository] = None):\n        self._parser = parser\n        self._cache = cache\n\n    def parse(self, music_text: str, use_cache: bool = False) -> List[int]:\n        key = safe_hash(music_text)\n        if use_cache and self._cache:\n            cached = self._cache.get(key)\n            if cached is not None:\n                return cached\n        result = self._parser.parse(music_text)\n        if use_cache and self._cache:\n            self._cache.set(key, result)\n        return result\n\n\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"Parses a musical note string into a list of beat durations.\n\n    It uses an internal pipeline to tokenize, map, and process the notes.\n    \"\"\"\n    parser = MusicParser(Tokenizer(), NoteMapper())\n    service = MusicService(parser)\n    return service.parse(music_string, use_cache=False)"}
{"task_id": "HumanEval/20", "solution": "def find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\" From a supplied list of numbers (of length at least two) select and return two that are the closest to each\n    other and return them in order (smaller number, larger number).\n    \"\"\"\n    sorted_numbers = sorted(numbers)\n\n    min_distance = float('inf')\n    # Initialize with the first pair from the sorted list.\n    closest_pair: Tuple[float, float] = (sorted_numbers[0], sorted_numbers[1])\n\n    # Iterate through adjacent pairs in the sorted list.\n    for i in range(len(sorted_numbers) - 1):\n        num1 = sorted_numbers[i]\n        num2 = sorted_numbers[i+1]\n        current_distance = abs(num2 - num1)\n\n        # Apply tie-breaking rules:\n        # 1. Prioritize smaller distance.\n        # 2. If distances are equal, prioritize the pair with the smaller first element.\n        if current_distance < min_distance:\n            min_distance = current_distance\n            closest_pair = (num1, num2)\n        elif current_distance == min_distance:\n            # If distances are equal, choose the pair with the smaller first element.\n            # (num1, num2) vs (closest_pair[0], closest_pair[1])\n            if num1 < closest_pair[0]:\n                closest_pair = (num1, num2)\n            # The rule \"if tied, choose smallest second element\" is implicitly handled:\n            # if num1 == closest_pair[0] and current_distance == min_distance,\n            # then num2 must also be equal to closest_pair[1] (as they are from a sorted list),\n            # making the pairs identical, so no update is necessary.\n\n    return closest_pair"}
{"task_id": "HumanEval/26", "solution": "from typing import List\nfrom collections import Counter\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    counts = Counter(numbers)\n    return [x for x in numbers if counts[x] == 1]"}
{"task_id": "HumanEval/24", "solution": "import math\n\ndef largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    if n % 2 == 0:\n        return n // 2\n    for i in range(3, int(math.isqrt(n)) + 1, 2):\n        if n % i == 0:\n            return n // i\n    return 1"}
{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    flipped_chars = []\n    for char in string:\n        if char.isalpha():\n            if char.islower():\n                flipped_chars.append(char.upper())\n            else:\n                flipped_chars.append(char.lower())\n        else:\n            flipped_chars.append(char)\n    return \"\".join(flipped_chars)"}
{"task_id": "HumanEval/25", "solution": "def factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    if n == 1:\n        return []\n\n    factors: List[int] = []\n\n    # Handle factor 2\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Handle odd factors\n    i = 3\n    # Iterate from 3 up to sqrt(n)\n    while i * i <= n:\n        while n % i == 0:\n            factors.append(i)\n            n //= i\n        i += 2  # Increment by 2 to check only odd numbers\n\n    # If n is still greater than 1, it must be a prime factor itself\n    if n > 1:\n        factors.append(n)\n\n    return factors"}
