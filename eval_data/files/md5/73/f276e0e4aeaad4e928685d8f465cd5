{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    An empty list or a single-element list is considered monotonic.\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    increasing = True\n    decreasing = True\n\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            increasing = False\n        if l[i] < l[i+1]:\n            decreasing = False\n        \n        # Optimization: if neither increasing nor decreasing, it's not monotonic\n        if not increasing and not decreasing:\n            return False\n\n    return increasing or decreasing"}
{"task_id": "HumanEval/59", "solution": "from math import isqrt\n\n\ndef largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    max_prime_factor = 1\n\n    # Handle factor 2: divide n by 2 until it's odd.\n    # If 2 is a factor, it's the current largest prime factor found.\n    while n % 2 == 0:\n        max_prime_factor = 2\n        n //= 2\n\n    # Check for odd factors starting from 3 up to the square root of n.\n    # The loop condition must dynamically update the limit as n decreases.\n    factor = 3\n    while factor <= isqrt(n):\n        if n % factor == 0:\n            max_prime_factor = factor\n            # Remove all occurrences of this factor\n            while n % factor == 0:\n                n //= factor\n        factor += 2\n\n    # If n is still greater than 1, it means the remaining n is a prime number\n    # and must be the largest prime factor.\n    if n > 1:\n        max_prime_factor = n\n\n    return max_prime_factor"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == \"(\":\n            balance += 1\n        elif char == \")\":\n            balance -= 1\n            if balance < 0:\n                return False\n    return balance == 0"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts the number of vowels in a string, including 'y' if it's at the end.\n    Vowels are 'a', 'e', 'i', 'o', 'u', case-insensitive.\n    \"\"\"\n    if s is None:\n        return 0\n\n    normalized_s = str(s).strip().lower()\n\n    if not normalized_s:\n        return 0\n\n    vowels = {'a', 'e', 'i', 'o', 'u'}\n    count = 0\n\n    for char in normalized_s:\n        if char in vowels:\n            count += 1\n\n    if normalized_s[-1] == 'y':\n        count += 1\n\n    return count"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    \"\"\"\n    if not xs or len(xs) == 1:\n        return []\n\n    # The derivative of (c * x^n) is (c * n * x^(n-1)).\n    # The new coefficient for x^(i-1) is i * xs[i].\n    # The constant term (xs[0]) has a derivative of 0 and is dropped.\n    # So we iterate from the second coefficient (xs[1]) onwards.\n    # For a polynomial a0 + a1*x + a2*x^2 + ...,\n    # the derivative is 0 + 1*a1 + 2*a2*x + 3*a3*x^2 + ...\n    # The resulting list will contain [1*a1, 2*a2, 3*a3, ...].\n    \n    # Iterate from the coefficient of x^1 (index 1) up to the last coefficient.\n    # 'i' represents the power of x for the current coefficient xs[i].\n    return [i * xs[i] for i in range(1, len(xs))]"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"Computes the n-th FibFib number using an iterative dynamic programming approach.\n    Handles base cases and iteratively calculates subsequent numbers, maintaining O(1) space complexity.\n    \"\"\"\n    if n == 0 or n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    # Initialize a, b, c to represent fibfib(0), fibfib(1), fibfib(2) respectively\n    a, b, c = 0, 0, 1\n\n    # Iterate from n=3 up to the requested n\n    for _ in range(3, n + 1):\n        # Calculate the next FibFib number based on the previous three\n        next_fib = a + b + c\n        # Shift the values: a becomes b, b becomes c, and c becomes next_fib\n        a, b, c = b, c, next_fib\n    \n    return c"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    x_str = str(x)\n    n = len(x_str)\n\n    if n == 0:\n        return \"\"\n\n    def _reverse_string(s: str) -> str:\n        return s[::-1]\n\n    def _rotate_right_string(s: str, r: int) -> str:\n        # Rotate string s right by r positions: last r characters move to the front.\n        return s[-r:] + s[:-r]\n\n    # Rule: If shift > number of digits, return digits reversed.\n    if shift > n:\n        return _reverse_string(x_str)\n\n    # Calculate effective shift for rotation, handling cases where shift is 0 or a multiple of n.\n    effective_shift = shift % n\n\n    if effective_shift == 0:\n        return x_str\n\n    return _rotate_right_string(x_str, effective_shift)"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Returns the sum of ASCII codes of uppercase characters (A-Z) in the input string.\"\"\"\n    total_sum = 0\n    for char_code in s:\n        if 'A' <= char_code <= 'Z':\n            total_sum += ord(char_code)\n    return total_sum"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even non-negative integer and its index in the given array.\n    If multiple such values exist, the one with the smallest index is chosen.\n    \"\"\"\n    smallest_even_value = None\n    smallest_even_index = None\n\n    for i, value in enumerate(arr):\n        # Check if the value is even\n        if value % 2 == 0:\n            # If it's the first even value found, or a smaller even value is found\n            if smallest_even_value is None or value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            # If an equal even value is found, we keep the one with the smallest index (already set)\n            # This is implicitly handled by not updating if value == smallest_even_value\n\n    if smallest_even_value is None:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/67", "solution": "import re\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits given a string of apples and oranges and a total fruit count.\n    \"\"\"\n    # Extract all integer numbers from the input string.\n    numbers_str = re.findall(r'\\d+', s)\n    \n    # Based on examples, assume the first extracted number is apples and the second is oranges.\n    apples = int(numbers_str[0])\n    oranges = int(numbers_str[1])\n    \n    # Calculate the number of mangoes by subtracting apples and oranges from the total.\n    mangoes = n - apples - oranges\n    \n    return mangoes"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    \"\"\"\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    \"\"\"\n    if not lst:\n        return -1\n\n    freq_map = {}\n    for num in lst:\n        freq_map[num] = freq_map.get(num, 0) + 1\n\n    candidates = []\n    for num, count in freq_map.items():\n        if num > 0 and count >= num:\n            candidates.append(num)\n\n    if candidates:\n        return max(candidates)\n    else:\n        return -1"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    sorted_lst = sorted(lst)\n    result = []\n    left, right = 0, len(sorted_lst) - 1\n\n    while left <= right:\n        result.append(sorted_lst[left])\n        left += 1\n        if left <= right:\n            result.append(sorted_lst[right])\n            right -= 1\n            \n    return result"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n    '''\n    is_palindromic = (q == q[::-1])\n    total_weight = sum(q)\n    is_within_weight_limit = (total_weight <= w)\n    \n    return is_palindromic and is_within_weight_limit"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic.\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes"}
{"task_id": "HumanEval/71", "solution": "import math\nfrom decimal import Decimal, ROUND_HALF_UP\n\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    # Validate that all sides are positive numbers.\n    if not (a > 0 and b > 0 and c > 0):\n        return -1\n\n    # Validate the triangle inequality: the sum of any two sides must be greater than the third side.\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1\n\n    # Calculate the semi-perimeter.\n    s = (a + b + c) / 2\n\n    # Calculate the area using Heron's formula.\n    # The term inside the square root can sometimes be slightly negative due to floating-point inaccuracies\n    # for degenerate triangles, so we clamp it to 0.\n    term_for_sqrt = s * (s - a) * (s - b) * (s - c)\n    if term_for_sqrt < 0:\n        term_for_sqrt = 0\n\n    area = math.sqrt(term_for_sqrt)\n\n    # Round the area to 2 decimal points using Decimal for precise half-up rounding.\n    rounded_area = float(Decimal(str(area)).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP))\n    \n    return rounded_area"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    '''\n    Write a function that accepts two lists of strings and returns the list that has \n    total number of chars in the all strings of the list less than the other list.\n\n    if the two lists have the same number of chars, return the first list.\n    '''\n    def _get_total_chars(s_list):\n        return sum(len(s) for s in s_list)\n\n    total_chars_lst1 = _get_total_chars(lst1)\n    total_chars_lst2 = _get_total_chars(lst2)\n\n    if total_chars_lst1 < total_chars_lst2:\n        return lst1\n    elif total_chars_lst2 < total_chars_lst1:\n        return lst2\n    else:\n        return lst1"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Checks if the given number is the product of exactly three prime numbers, counting multiplicity.\"\"\"\n    \n    factors = []\n    if a <= 1:\n        return False\n\n    n = a\n    d = 2\n    while d * d <= n:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 1 if d == 2 else 2\n    \n    if n > 1:\n        factors.append(n)\n        \n    return len(factors) == 3"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n (n**k = x for integer k >= 0).\n    Assumes x >= 1 and n >= 1, with validation handled externally if needed.\n    \"\"\"\n    if x == 1:\n        return True\n    if n == 1:\n        return x == 1\n    while x % n == 0:\n        x //= n\n    return x == 1"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Write a function that takes an integer a and returns True\n    if this ingeger is a cube of some integer number.\n    '''\n    def _integer_cube_root_floor(n: int) -> int:\n        # Helper function to find the integer cube root (floor) of n, preserving its sign.\n        if n == 0:\n            return 0\n        \n        sign = 1 if n > 0 else -1\n        x = abs(n)\n\n        # Binary search to find the largest integer 'r' such that r*r*r <= x.\n        # The upper bound is chosen to be greater than the largest possible cube root for x.\n        lo, hi = 0, 1 << ((x.bit_length() + 2) // 3 + 1)\n        \n        while lo <= hi:\n            mid = (lo + hi) // 2\n            cube = mid * mid * mid\n            if cube == x:\n                return sign * mid\n            if cube < x:\n                lo = mid + 1\n            else:\n                hi = mid - 1\n        \n        # After the loop, 'hi' will hold the floor of the cube root.\n        return sign * hi\n\n    root_candidate = _integer_cube_root_floor(a)\n    return root_candidate * root_candidate * root_candidate == a"}
