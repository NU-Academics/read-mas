{"task_id": "HumanEval/3", "solution": "def below_zero(operations: List[int]) -> bool:\n    \"\"\"Detects if a bank account balance, starting at zero, ever falls below zero given a list of operations.\n    Returns True if the balance goes below zero at any point, False otherwise.\n    \"\"\"\n    balance: int = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    SAFE_EPS = 1e-12 # Epsilon for floating point comparisons to handle precision issues.\n\n    frac, _ = math.modf(number)\n\n    # Normalize values very close to 1.0 or 0.0 due to floating point inaccuracies.\n    if abs(frac - 1.0) <= SAFE_EPS:\n        return 0.0\n    if abs(frac) <= SAFE_EPS:\n        return 0.0\n    \n    return float(frac)"}
{"task_id": "HumanEval/4", "solution": "from typing import List, Iterable, Any\nimport math\n\nclass StatsError(Exception):\n    \"\"\"Base exception for statistical errors.\"\"\"\n    def __init__(self, message: str = \"\") -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InvalidInputError(StatsError):\n    \"\"\"Raised when input data is invalid.\"\"\"\n    pass\n\nclass EmptyDatasetError(StatsError):\n    \"\"\"Raised when the dataset is empty.\"\"\"\n    pass\n\nclass NumericOverflowError(StatsError):\n    \"\"\"Raised when numeric computation results in overflow or non-finite values.\"\"\"\n    pass\n\nclass NumberSeries:\n    \"\"\"A DTO for normalized numeric datasets.\"\"\"\n    def __init__(self, numbers: List[float]) -> None:\n        self.numbers: List[float] = list(numbers)\n\n    def as_list(self) -> List[float]:\n        \"\"\"Returns a shallow copy of the numbers list.\"\"\"\n        return list(self.numbers)\n\nclass NumericUtils:\n    \"\"\"Utility methods for numeric operations.\"\"\"\n    EPSILON: float = 1e-12\n\n    @staticmethod\n    def is_finite_number(value: float) -> bool:\n        \"\"\"Checks if a value is a finite number.\"\"\"\n        return math.isfinite(value)\n\n    @staticmethod\n    def safe_mean(numbers: List[float]) -> float:\n        \"\"\"Computes the arithmetic mean using Kahan summation for accuracy.\"\"\"\n        if not numbers:\n            raise NumericOverflowError(\"Cannot compute mean of an empty list\")\n\n        total = 0.0\n        c = 0.0\n        for x in numbers:\n            y = x - c\n            t = total + y\n            c = (t - total) - y\n            total = t\n\n        mean = total / len(numbers)\n        if not math.isfinite(mean):\n            raise NumericOverflowError(\"Mean computed is not finite\")\n        return mean\n\nclass InputValidator:\n    \"\"\"Validates and normalizes input data into a NumberSeries.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate(self, numbers: Iterable[Any]) -> NumberSeries:\n        \"\"\"Validates an iterable of numbers and returns a NumberSeries.\"\"\"\n        if numbers is None:\n            raise InvalidInputError(\"Input is None\")\n        \n        float_list = self._to_float_list(numbers)\n        if len(float_list) == 0:\n            raise EmptyDatasetError(\"Dataset is empty\")\n        \n        self._check_finite(float_list)\n        return NumberSeries(float_list)\n\n    def _to_float_list(self, numbers: Iterable[Any]) -> List[float]:\n        \"\"\"Converts an iterable to a list of floats, raising an error for non-numeric items.\"\"\"\n        result = []\n        for idx, v in enumerate(numbers):\n            try:\n                result.append(float(v))\n            except (TypeError, ValueError):\n                raise InvalidInputError(f\"Item at index {idx} not numeric: {v!r}\")\n        return result\n\n    def _check_finite(self, numbers: List[float]) -> None:\n        \"\"\"Ensures all numbers in the list are finite.\"\"\"\n        for idx, v in enumerate(numbers):\n            if not NumericUtils.is_finite_number(v):\n                raise InvalidInputError(f\"Non-finite value at index {idx}: {v!r}\")\n\nclass MADCalculator:\n    \"\"\"Calculates the Mean Absolute Deviation.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def compute(self, numbers: List[float]) -> float:\n        \"\"\"Computes the Mean Absolute Deviation around the mean for a list of floats.\"\"\"\n        if not numbers:\n            raise EmptyDatasetError(\"Cannot compute MAD of an empty list\")\n        \n        mean = NumericUtils.safe_mean(numbers)\n        \n        # Compute sum of absolute deviations using Kahan-like summation\n        total_abs_dev = 0.0\n        c_abs_dev = 0.0\n        for x in numbers:\n            d = abs(x - mean)\n            y = d - c_abs_dev\n            t = total_abs_dev + y\n            c_abs_dev = (t - total_abs_dev) - y\n            total_abs_dev = t\n            \n        mad = total_abs_dev / len(numbers)\n        \n        if not math.isfinite(mad):\n            raise NumericOverflowError(\"MAD computed is not finite\")\n        return mad\n\nclass StatisticsService:\n    \"\"\"Orchestrates validation and calculation of statistics.\"\"\"\n    def __init__(self, validator: InputValidator, calculator: MADCalculator) -> None:\n        self.validator = validator\n        self.calculator = calculator\n\n    def compute_mad(self, numbers: Iterable) -> float:\n        \"\"\"Validates input and computes the Mean Absolute Deviation.\"\"\"\n        series = self.validator.validate(numbers)\n        return self.calculator.compute(series.as_list())\n\nclass StatisticsController:\n    \"\"\"Provides the public API for statistical computations.\"\"\"\n    def __init__(self, service: StatisticsService) -> None:\n        self.service = service\n\n    def mean_absolute_deviation(self, numbers: Iterable) -> float:\n        \"\"\"Calculates the Mean Absolute Deviation for the given numbers.\"\"\"\n        return self.service.compute_mad(numbers)\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    _validator = InputValidator()\n    _calculator = MADCalculator()\n    _service = StatisticsService(_validator, _calculator)\n    _controller = StatisticsController(_service)\n    return _controller.mean_absolute_deviation(numbers)"}
{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    # Sort the numbers to efficiently check adjacent pairs for closeness.\n    sorted_nums = sorted(numbers)\n\n    # Iterate through adjacent elements and check their absolute difference.\n    for i in range(len(sorted_nums) - 1):\n        if abs(sorted_nums[i+1] - sorted_nums[i]) < threshold:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    def _intersperse_generator(nums: List[int], delim: int) -> 'Iterator[int]':\n        \"\"\"Yields elements from nums, interspersed with delim.\"\"\"\n        it = iter(nums)\n        try:\n            first = next(it)\n        except StopIteration:\n            return  # Empty list, nothing to yield.\n        \n        yield first\n        for x in it:\n            yield delim\n            yield x\n\n    return list(_intersperse_generator(numbers, delimeter))"}
{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n\n    def _process_single_group(group_str: str) -> int:\n        \"\"\"\n        Validates a single parentheses group and computes its maximum nesting depth.\n        Returns 0 if the group is invalid (contains non-parenthesis characters or is unbalanced).\n        \"\"\"\n        current_balance = 0\n        current_max_depth = 0\n        \n        # First pass: Validate characters and initial balance\n        for char in group_str:\n            if char == '(':\n                current_balance += 1\n            elif char == ')':\n                current_balance -= 1\n            else:\n                # Invalid character, treat as 0 depth\n                return 0\n            \n            if current_balance < 0:\n                # Unbalanced: ')' without a preceding '('\n                return 0\n        \n        if current_balance != 0:\n            # Unbalanced: unmatched '(' at the end\n            return 0\n\n        # Second pass: Compute maximum depth (only if validated as balanced and valid chars)\n        current_balance = 0 # Reset for depth calculation\n        for char in group_str:\n            if char == '(':\n                current_balance += 1\n                if current_balance > current_max_depth:\n                    current_max_depth = current_balance\n            elif char == ')':\n                current_balance -= 1\n        \n        return current_max_depth\n\n    # Tokenize the input string into groups, splitting by whitespace and filtering out empty strings.\n    groups = [g for g in paren_string.strip().split() if g]\n\n    # Process each group and collect the results.\n    result_depths = []\n    for group in groups:\n        result_depths.append(_process_single_group(group))\n\n    return result_depths"}
{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    \n    # Remove all whitespace characters from the input string to get a compact representation.\n    compact_string = \"\".join(ch for ch in paren_string if not ch.isspace())\n\n    if not compact_string:\n        return []\n\n    results = []\n    depth = 0\n    current_group_buffer = []\n\n    for char in compact_string:\n        current_group_buffer.append(char)\n        if char == '(':\n            depth += 1\n        elif char == ')':\n            depth -= 1\n        \n        # When the depth returns to 0, it signifies that a complete, balanced group has been found.\n        if depth == 0:\n            results.append(\"\".join(current_group_buffer))\n            current_group_buffer = [] # Reset the buffer for the next potential group\n            \n    return results"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = []\n    current_max = numbers[0]\n\n    for n in numbers:\n        if n > current_max:\n            current_max = n\n        result.append(current_max)\n\n    return result"}
