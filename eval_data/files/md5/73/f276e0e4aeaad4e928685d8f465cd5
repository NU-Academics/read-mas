{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    max_len = -1\n    max_item: Optional[str] = None\n\n    for s in strings:\n        if len(s) > max_len:\n            max_len = len(s)\n            max_item = s\n    return max_item"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    n = len(string)\n    \n    # Iterate from the start to find the longest palindromic suffix.\n    # The first 'i' for which string[i:] is a palindrome gives the longest such suffix.\n    for i in range(n + 1):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            # The prefix to reverse is string[:i]\n            prefix_to_reverse = string[:i]\n            reversed_prefix = prefix_to_reverse[::-1]\n            return string + reversed_prefix"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n\n    class BitStringError(ValueError):\n        \"\"\"Base exception for bit string related errors.\"\"\"\n        pass\n\n    class InvalidBitStringError(BitStringError):\n        \"\"\"Raised when a bit string contains characters other than '0' or '1'.\"\"\"\n        pass\n\n    class LengthMismatchError(BitStringError):\n        \"\"\"Raised when bit strings have different lengths for XOR operation.\"\"\"\n        pass\n\n    if not all(char in '01' for char in a):\n        raise InvalidBitStringError(f\"Invalid bit string 'a': {a!r}. Must contain only '0' or '1'.\")\n    if not all(char in '01' for char in b):\n        raise InvalidBitStringError(f\"Invalid bit string 'b': {b!r}. Must contain only '0' or '1'.\")\n\n    if len(a) != len(b):\n        raise LengthMismatchError(f\"Bit strings must be of the same length: len(a)={len(a)}, len(b)={len(b)}.\")\n\n    result_chars = []\n    for char_a, char_b in zip(a, b):\n        if char_a == char_b:\n            result_chars.append('0')\n        else:\n            result_chars.append('1')\n            \n    return ''.join(result_chars)"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    a, b = abs(a), abs(b)\n    if a == 0 and b == 0:\n        return 0\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/14", "solution": "```python\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    prefixes = []\n    for i in range(1, len(string) + 1):\n        prefixes.append(string[:i])\n    return prefixes\n```"}
{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of.\n    This uses Unicode NFKC normalization and casefolding to determine distinctness.\n    \"\"\"\n    import unicodedata\n\n    # Apply Unicode NFKC normalization and then casefold for case-insensitive comparison.\n    normalized_string = unicodedata.normalize(\"NFKC\", string).casefold()\n\n    # Create a set of characters to find unique ones.\n    distinct_characters = set(normalized_string)\n\n    return len(distinct_characters)"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlaping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n    count = 0\n    len_s = len(string)\n    len_sub = len(substring)\n\n    if len_sub == 0:\n        # As per Python's str.count() behavior for an empty substring,\n        # it counts positions between characters and at the start/end.\n        return len_s + 1\n\n    for i in range(len_s - len_sub + 1):\n        if string[i : i + len_sub] == substring:\n            count += 1\n    return count"}
{"task_id": "HumanEval/21", "solution": "def rescale_to_unit(numbers: List[float]) -> List[float]:\n    \"\"\" Given list of numbers (of at least two elements), apply a linear transform to that list,\n    such that the smallest number will become 0 and the largest will become 1\n    \"\"\"\n    min_v = min(numbers)\n    max_v = max(numbers)\n    span = max_v - min_v\n\n    # Handle the case where all numbers are identical (zero range).\n    # Per design context, map them all to 0.0.\n    FLOAT_TOLERANCE = 1e-12\n    if abs(span) <= FLOAT_TOLERANCE:\n        return [0.0 for _ in numbers]\n\n    # Apply the linear transformation: (x - min) / (max - min)\n    inv_span = 1.0 / span\n    return [(x - min_v) * inv_span for x in numbers]"}
