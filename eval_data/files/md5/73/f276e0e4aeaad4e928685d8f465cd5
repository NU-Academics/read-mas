{"task_id": "HumanEval/54", "solution": "def same_chars(s0: str, s1: str):\n    \"\"\"\n    Check if two words have the same characters.\n    \"\"\"\n    class AppConfig:\n        MAX_INPUT_LENGTH: int = 100000\n        DEBUG: bool = False\n        _instance = None\n\n        @classmethod\n        def get(cls):\n            if cls._instance is None:\n                cls._instance = cls()\n            return cls._instance\n\n    class ValidationError(ValueError):\n        pass\n\n    class InvalidInputError(TypeError):\n        pass\n\n    class InputValidator:\n        def __init__(self, config: AppConfig | None = None):\n            self._config = AppConfig.get() if config is None else config\n\n        def validate_string(self, value: object, name: str) -> str:\n            if not isinstance(value, str):\n                raise InvalidInputError(f\"Input '{name}' must be a string, but got {type(value).__name__}\")\n            if len(value) > self._config.MAX_INPUT_LENGTH:\n                raise ValidationError(\n                    f\"Input '{name}' length ({len(value)}) exceeds maximum allowed length \"\n                    f\"({self._config.MAX_INPUT_LENGTH} characters).\"\n                )\n            return value\n\n        def validate_pair(self, s0: object, s1: object) -> tuple[str, str]:\n            s0_validated = self.validate_string(s0, \"s0\")\n            s1_validated = self.validate_string(s1, \"s1\")\n            return s0_validated, s1_validated\n\n    class ResultDTO:\n        def __init__(self, same: bool, s0_chars: list[str], s1_chars: list[str]):\n            self.same = same\n            self.s0_chars = s0_chars\n            self.s1_chars = s1_chars\n\n        def to_dict(self) -> dict:\n            return {\n                \"same\": self.same,\n                \"s0_chars\": self.s0_chars,\n                \"s1_chars\": self.s1_chars,\n            }\n\n    class SameCharsService:\n        def __init__(self, validator: InputValidator):\n            self._validator = validator\n\n        def compare(self, s0: str, s1: str) -> ResultDTO:\n            s0v, s1v = self._validator.validate_pair(s0, s1)\n            set0 = set(s0v)\n            set1 = set(s1v)\n            s0_chars = sorted(list(set0))\n            s1_chars = sorted(list(set1))\n            same = set0 == set1\n            return ResultDTO(same=same, s0_chars=s0_chars, s1_chars=s1_chars)\n\n        def same_chars_bool(self, s0: str, s1: str) -> bool:\n            return self.compare(s0, s1).same\n\n    config = AppConfig.get()\n    validator = InputValidator(config)\n    service = SameCharsService(validator)\n    return service.same_chars_bool(s0, s1)"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    a, b = 0, 1\n    for _ in range(n):\n        a, b = b, a + b\n    return a"}
