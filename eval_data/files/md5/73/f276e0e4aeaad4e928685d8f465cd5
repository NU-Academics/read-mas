{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compares two numbers (int, float, or string) and returns the larger in its original type,\n    or None if they are equal. Handles ',' as a decimal separator in strings.\n    \"\"\"\n    import re\n\n    class ParseError(Exception):\n        \"\"\"Exception for failed numeric parsing.\"\"\"\n        def __init__(self, value: object, message: str | None = None) -> None:\n            super().__init__(message or f\"Could not parse '{value}' into a number.\")\n            self.value = value\n\n        def __str__(self) -> str:\n            return f\"Invalid numeric input: {self.value}\"\n\n    class NumericValue:\n        \"\"\"Represents a parsed numeric value.\"\"\"\n        def __init__(self, original: object, normalized: float, is_string: bool) -> None:\n            self.original = original\n            self.normalized = normalized\n            self.is_string = is_string\n\n        def as_original(self) -> object:\n            \"\"\"Returns the original input value.\"\"\"\n            return self.original\n\n    class StringNormalizer:\n        \"\"\"Utility for normalizing and validating numeric strings.\"\"\"\n        DECIMAL_TOKENS = {'.', ','}\n\n        def normalize_decimal(self, s: str) -> str:\n            s = s.strip()\n            # If a string contains a comma but no dot, replace the comma with a dot.\n            if ',' in s and '.' not in s:\n                return s.replace(',', '.')\n            return s\n\n        def looks_like_number(self, s: str) -> bool:\n            # Validates if a string matches an optional sign, digits, and an optional decimal part.\n            return bool(re.fullmatch(r'[+-]?\\d+(\\.\\d+)?', s))\n\n    class NumericParser:\n        \"\"\"Parses raw input into NumericValue objects.\"\"\"\n        def __init__(self, normalizer: 'StringNormalizer | None' = None) -> None:\n            self._normalizer = normalizer or StringNormalizer()\n\n        def parse(self, value: object) -> 'NumericValue':\n            if isinstance(value, (int, float)):\n                return NumericValue(original=value, normalized=float(value), is_string=False)\n            if isinstance(value, str):\n                s = value.strip()\n                s_norm = self._normalizer.normalize_decimal(s)\n                if not self._normalizer.looks_like_number(s_norm):\n                    raise ParseError(value)\n                try:\n                    num = float(s_norm)\n                except ValueError:\n                    raise ParseError(value)\n                return NumericValue(original=value, normalized=num, is_string=True)\n            raise ParseError(value)\n\n    class Comparator:\n        \"\"\"Compares two numeric inputs by parsing them and using a tolerance for equality.\"\"\"\n        DEFAULT_TOLERANCE = 1e-12\n\n        def __init__(self, numeric_parser: 'NumericParser | None' = None) -> None:\n            self._numeric_parser = numeric_parser or NumericParser()\n\n        def compare(self, a: object, b: object, tol: float | None = None) -> object | None:\n            tol = tol if tol is not None else self.DEFAULT_TOLERANCE\n            na = self._numeric_parser.parse(a)\n            nb = self._numeric_parser.parse(b)\n            da = na.normalized\n            db = nb.normalized\n\n            if abs(da - db) <= tol:\n                return None\n            return a if da > db else b\n\n    comparator_instance = Comparator()\n    try:\n        return comparator_instance.compare(a, b)\n    except ParseError as e:\n        # Wrap ParseError in ValueError for the public API as per design.\n        raise ValueError(f\"Invalid numeric input: {e.value}\") from e"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    result = []\n    space_count = 0\n\n    for char in text:\n        if char == ' ':\n            space_count += 1\n        else:\n            # Process accumulated spaces if a non-space character is encountered\n            if space_count > 0:\n                if space_count <= 2:\n                    result.extend(['_'] * space_count)\n                else:\n                    result.append('-')\n                space_count = 0 # Reset space count\n            \n            result.append(char) # Append the current non-space character\n    \n    # Process any trailing spaces after the loop ends\n    if space_count > 0:\n        if space_count <= 2:\n            result.extend(['_'] * space_count)\n        else:\n            result.append('-')\n            \n    return \"\".join(result)"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    total_product = 1\n    current_factorial_value = 1\n    for i in range(1, n + 1):\n        # Calculate the factorial for the current number 'i'\n        current_factorial_value *= i\n        # Multiply this factorial into the overall total product\n        total_product *= current_factorial_value\n    return total_product"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += num ** 2\n        elif i % 4 == 0:\n            total_sum += num ** 3\n        else:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions \n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from \n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    \n    # Condition 1: No more than three digits\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # Condition 2: Exactly one dot '.'\n    parts = file_name.split('.')\n    if len(parts) != 2:\n        return 'No'\n    \n    basename = parts[0]\n    extension = parts[1]\n\n    # Condition 3: Substring before the dot (basename)\n    # - Should not be empty\n    # - Should start with a latin alphabet letter\n    if not basename:\n        return 'No'\n    \n    first_char = basename[0]\n    if not ('a' <= first_char <= 'z' or 'A' <= first_char <= 'Z'):\n        return 'No'\n\n    # Condition 4: Substring after the dot (extension)\n    # - Should be one of: ['txt', 'exe', 'dll']\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if extension not in allowed_extensions:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    You are given a string representing a sentence,\n    the sentence contains some words separated by a space,\n    and you have to return a string that contains the words from the original sentence,\n    whose lengths are prime numbers,\n    the order of the words in the new string should be the same as the original one.\n    \"\"\"\n    def _is_prime(n: int) -> bool:\n        \"\"\"Checks if a number n is prime.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3: # 2 and 3 are prime numbers\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    filtered_words = []\n    words = sentence.split()\n    for word in words:\n        if _is_prime(len(word)):\n            filtered_words.append(word)\n\n    return \" \".join(filtered_words)"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Checks if the product of two fractions x and n is a whole number.\n    Fractions are given as strings \"numerator/denominator\".\n    \"\"\"\n\n    def _gcd(a, b):\n        \"\"\"Calculates the greatest common divisor of two non-negative integers.\"\"\"\n        a, b = abs(a), abs(b)\n        while b:\n            a, b = b, a % b\n        return a\n\n    def _parse_fraction(fraction_str):\n        \"\"\"Parses a fraction string into (numerator, denominator) integers.\"\"\"\n        parts = fraction_str.strip().split('/')\n        return int(parts[0]), int(parts[1])\n\n    # Parse the input fractions x and n\n    num_x, den_x = _parse_fraction(x)\n    num_n, den_n = _parse_fraction(n)\n\n    # Apply cancellation to simplify the product before multiplication\n    # Fraction x is num_x / den_x\n    # Fraction n is num_n / den_n\n    # The product is (num_x * num_n) / (den_x * den_n)\n\n    # Cancel num_x with den_n\n    common_divisor1 = _gcd(num_x, den_n)\n    num_x_after_cancel = num_x // common_divisor1\n    den_n_after_cancel = den_n // common_divisor1\n\n    # Cancel num_n with den_x\n    common_divisor2 = _gcd(num_n, den_x)\n    num_n_after_cancel = num_n // common_divisor2\n    den_x_after_cancel = den_x // common_divisor2\n\n    # Calculate the final numerator and denominator of the product after all cancellations\n    final_numerator = num_x_after_cancel * num_n_after_cancel\n    final_denominator = den_x_after_cancel * den_n_after_cancel\n\n    # The product is a whole number if the final denominator divides the final numerator evenly.\n    return final_numerator % final_denominator == 0"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets whose orbits are between planet1 and planet2, \n    sorted by proximity to the sun. Returns an empty tuple for invalid planet names.\n    \"\"\"\n    planets_order = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n\n    try:\n        idx1 = planets_order.index(planet1)\n        idx2 = planets_order.index(planet2)\n    except ValueError:\n        # If either planet1 or planet2 is not a correct planet name\n        return ()\n\n    # Determine the start and end indices for slicing, ensuring correct order\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    # Slice the list to get planets between the two input planets (exclusive)\n    # Convert the result to a tuple\n    return tuple(planets_order[start_idx + 1:end_idx])"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers in an array that are greater than 10 and have both \n    first and last digits odd (1, 3, 5, 7, 9).\n    \"\"\"\n    count = 0\n    for num in nums:\n        # Condition 1: Number must be greater than 10\n        if num <= 10:\n            continue\n\n        # For digit inspection, consider the absolute integer part of the number.\n        abs_int_val = int(abs(num))\n\n        # Numbers less than 1 (e.g., 0.5, 0.0) would become 0 after int(abs()),\n        # their digits are 0 (even), so they don't qualify.\n        if abs_int_val == 0:\n            continue\n\n        # Get the last digit\n        last_digit = abs_int_val % 10\n\n        # Get the first digit\n        first_digit = abs_int_val\n        while first_digit >= 10:\n            first_digit //= 10\n\n        # Condition 2: Both first and last digits must be odd\n        is_first_digit_odd = first_digit % 2 != 0\n        is_last_digit_odd = last_digit % 2 != 0\n\n        if is_first_digit_odd and is_last_digit_odd:\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"\n    Accepts a list of strings, removes odd-length strings, and returns the\n    remaining strings sorted by length (ascending) then alphabetically.\n    \"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    sorted_result = sorted(even_length_strings, key=lambda s: (len(s), s))\n    return sorted_result"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    Items with similar digit sums are ordered based on their original index.\n    \"\"\"\n\n    def _compute_digit_sum(value: int) -> int:\n        \"\"\"Calculates the sum of the absolute value's digits.\"\"\"\n        n = abs(value)\n        if n == 0:\n            return 0\n        s = 0\n        while n > 0:\n            s += n % 10\n            n //= 10\n        return s\n\n    if not nums:\n        return []\n\n    # Create a list of tuples: (digit_sum, original_index, original_value)\n    # The original_index serves as a tie-breaker for stable sorting.\n    decorated_nums = []\n    for index, value in enumerate(nums):\n        digit_sum = _compute_digit_sum(value)\n        decorated_nums.append((digit_sum, index, value))\n\n    # Sort the list based on digit_sum primarily and original_index secondarily.\n    # Python's list.sort() is stable, but explicit secondary key ensures tie-breaking.\n    decorated_nums.sort(key=lambda x: (x[0], x[1]))\n\n    # Extract the original values from the sorted list\n    result = [item[2] for item in decorated_nums]\n\n    return result"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Calculates the absolute difference between game scores and guesses for each match.\n    Returns a list of these differences, where 0 indicates a correct guess.\n    \"\"\"\n    results = []\n    for g_score, q_score in zip(game, guess):\n        results.append(abs(g_score - q_score))\n    return results"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from the sequence a where i < j < k\n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    def combinations3(count):\n        \"\"\"Calculates nC3 (n choose 3) for a given count.\"\"\"\n        if count < 3:\n            return 0\n        return count * (count - 1) * (count - 2) // 6\n\n    if n < 3:\n        return 0\n\n    # Determine a[i] % 3 based on i % 3:\n    # a[i] = i*i - i + 1\n    # If i % 3 == 0 (e.g., i=3): a[i] % 3 == 1\n    # If i % 3 == 1 (e.g., i=1): a[i] % 3 == 1\n    # If i % 3 == 2 (e.g., i=2): a[i] % 3 == 0\n\n    # Count occurrences of i % 3 for i from 1 to n\n    count_i_mod_0 = n // 3\n    count_i_mod_1 = (n // 3) + (1 if n % 3 >= 1 else 0)\n    count_i_mod_2 = (n // 3) + (1 if n % 3 >= 2 else 0)\n\n    # Map i-mod-3 counts to a[i]-mod-3 counts\n    # c_a_mod_0: number of a[i] such that a[i] % 3 == 0 (occurs when i % 3 == 2)\n    # c_a_mod_1: number of a[i] such that a[i] % 3 == 1 (occurs when i % 3 == 0 or i % 3 == 1)\n    # c_a_mod_2: number of a[i] such that a[i] % 3 == 2 (never occurs based on derivation)\n    c_a_mod_0 = count_i_mod_2\n    c_a_mod_1 = count_i_mod_0 + count_i_mod_1\n    c_a_mod_2 = 0 # As a[i] % 3 is never 2\n\n    # A sum of three numbers is a multiple of 3 if their residues sum to a multiple of 3.\n    # Possible combinations of residues (r1, r2, r3) that sum to 0 mod 3:\n    # 1. (0, 0, 0)\n    # 2. (1, 1, 1)\n    # 3. (2, 2, 2) - not possible since c_a_mod_2 is 0\n    # 4. (0, 1, 2) - not possible since c_a_mod_2 is 0\n\n    # So, we only need to count combinations of three 0s or three 1s.\n    total_triples = combinations3(c_a_mod_0) + combinations3(c_a_mod_1)\n\n    return total_triples"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid function inputs.\"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n\n    class PrimalityChecker:\n        \"\"\"Determines if a given integer n is a prime number.\"\"\"\n        def is_prime(self, n: int) -> bool:\n            if not isinstance(n, int):\n                raise InvalidInputError(\"n must be an integer\")\n            if n < 2:\n                return False\n            if n == 2 or n == 3:\n                return True\n            if n % 2 == 0 or n % 3 == 0:\n                return False\n            i = 5\n            while i * i <= n:\n                if n % i == 0 or n % (i + 2) == 0:\n                    return False\n                i += 6\n            return True\n\n    class InMemoryCacheRepository:\n        \"\"\"A simple in-memory cache for primality results.\"\"\"\n        def __init__(self):\n            self._store: dict[int, bool] = {}\n\n        def get(self, n: int):\n            return self._store.get(n)\n\n        def set(self, n: int, is_prime: bool) -> None:\n            self._store[n] = is_prime\n\n        def clear(self) -> None:\n            self._store.clear()\n\n    class PrimeService:\n        \"\"\"Orchestrates primality checks, using a cache and a checker.\"\"\"\n        def __init__(self, checker: PrimalityChecker, cache: InMemoryCacheRepository):\n            self.checker = checker\n            self.cache = cache\n\n        def _validate_input(self, n: int) -> None:\n            \"\"\"Ensures n is an integer and non-negative, raising an error otherwise.\"\"\"\n            if not isinstance(n, int):\n                raise InvalidInputError(\"n must be an integer\")\n            if n < 0:\n                raise InvalidInputError(\"n must be a non-negative integer\")\n\n        def x_or_y_internal(self, n: int, x, y):\n            \"\"\"Returns x if n is prime, otherwise returns y, leveraging caching.\"\"\"\n            self._validate_input(n)\n            cached_result = self.cache.get(n)\n\n            if cached_result is not None:\n                return x if cached_result else y\n\n            is_prime_result = self.checker.is_prime(n)\n            self.cache.set(n, is_prime_result)\n            return x if is_prime_result else y\n\n    if not hasattr(x_or_y, '_prime_service_instance'):\n        checker_instance = PrimalityChecker()\n        cache_instance = InMemoryCacheRepository()\n        x_or_y._prime_service_instance = PrimeService(checker_instance, cache_instance)\n\n    return x_or_y._prime_service_instance.x_or_y_internal(n, x, y)"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0  \n   \n    If the input list is empty, return 0.\n    '''\n    total_sum_of_squares = 0\n\n    for item in lst:\n        num_candidate = None\n\n        if isinstance(item, int):\n            num_candidate = item\n        elif isinstance(item, str):\n            try:\n                # Attempt to convert string to an integer, stripping whitespace\n                num_candidate = int(item.strip())\n            except ValueError:\n                # If conversion fails (e.g., \"abc\", \"4.0\"), it's not a valid integer.\n                continue\n        # If item is a float, or any other type not explicitly handled (like bool, None, etc.),\n        # num_candidate remains None, effectively ignoring these items as \"not integers\".\n\n        if num_candidate is not None:\n            # Check if the number is non-negative and odd.\n            if num_candidate >= 0 and num_candidate % 2 == 1:\n                total_sum_of_squares += (num_candidate * num_candidate)\n\n    return total_sum_of_squares"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM strength and returns it in ClassName.StrongestExtensionName format.\"\"\"\n    \n    if not extensions:\n        # Based on prompt, assume valid non-empty list.\n        # If an empty list was possible, a default or error handling would be needed.\n        # For simplicity and adherence to \"DO NOT add isinstance() checks or raise exceptions\",\n        # this path implies the input list will always have at least one element.\n        return f\"{class_name}.\" # Or some default/error if specified\n\n    strongest_extension_name = \"\"\n    max_strength = -float('inf') # Initialize with a very low value\n\n    for extension_name in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in extension_name:\n            if char.isupper():\n                cap_count += 1\n            elif char.islower():\n                sm_count += 1\n        \n        current_strength = cap_count - sm_count\n        \n        # If current strength is strictly greater, update the strongest\n        # This handles the tie-breaking: first one encountered with max strength wins.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension_name\n            \n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/155", "solution": "class InvalidNumberError(Exception):\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self):\n        return self.message\n\nclass NumberParser:\n    @staticmethod\n    def parse_number(value: object) -> int:\n        if isinstance(value, int):\n            return value\n        if isinstance(value, str):\n            s = value.strip()\n            try:\n                return int(s, 10)\n            except ValueError:\n                raise InvalidNumberError(f\"Invalid integer string: {value}\")\n        raise InvalidNumberError(f\"Unsupported type for number: {type(value).__name__}\")\n\nclass EvenOddResult:\n    def __init__(self, even: int, odd: int) -> None:\n        self.even = even\n        self.odd = odd\n\n    def to_tuple(self) -> tuple[int, int]:\n        return (self.even, self.odd)\n\n    def to_dict(self) -> dict[str, int]:\n        return {\"even\": self.even, \"odd\": self.odd}\n\ndef to_digits(n: int) -> list[int]:\n    \"\"\"Converts an integer to a list of its decimal digits.\"\"\"\n    if n == 0:\n        return [0]\n    digits = []\n    while n > 0:\n        digits.append(n % 10)\n        n //= 10\n    return digits[::-1]\n\nclass DigitCounterService:\n    def count_digits(self, n: int) -> EvenOddResult:\n        \"\"\"Counts even and odd digits in an integer's absolute value.\"\"\"\n        if n == 0:\n            return EvenOddResult(even=1, odd=0)\n        n = abs(n)\n        even = odd = 0\n        for d in to_digits(n):\n            if d % 2 == 0:\n                even += 1\n            else:\n                odd += 1\n        return EvenOddResult(even=even, odd=odd)\n\ndef even_odd_count(num):\n    parser = NumberParser()\n    n = parser.parse_number(num)\n    svc = DigitCounterService()\n    result = svc.count_digits(n)\n    return result.to_tuple()"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    n = len(b)\n    for i in range(n):\n        # Generate a cyclic rotation of pattern b.\n        rotated_b = b[i:] + b[:i]\n        # Check if the rotated pattern is a substring of text a.\n        if rotated_b in a:\n            return True\n    return False"}
{"task_id": "HumanEval/156", "solution": "class Constants:\n    \"\"\"Stores numeric limits and Roman numeral mappings for conversion.\"\"\"\n    MIN_NUM: int = 1\n    MAX_NUM: int = 1000\n    SYMBOLS = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I'),\n    ]\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InputValidator:\n    \"\"\"Validates and normalizes input to an integer within the allowed range.\"\"\"\n    def __init__(self, min_value: int = Constants.MIN_NUM, max_value: int = Constants.MAX_NUM):\n        self._min = min_value\n        self._max = max_value\n\n    def validate(self, number: int | str) -> int:\n        \"\"\"Parses the input to an integer and checks if it's within bounds.\"\"\"\n        try:\n            value = int(number)\n        except (TypeError, ValueError):\n            raise InvalidInputError(f\"Invalid integer: {number!r}\")\n        if value < self._min or value > self._max:\n            raise InvalidInputError(f\"Number out of range [{self._min}, {self._max}]: {value}\")\n        return value\n\nclass RomanConverter:\n    \"\"\"Converts an integer to its Roman numeral string representation.\"\"\"\n    def __init__(self, symbols=None):\n        self._symbols = symbols if symbols is not None else Constants.SYMBOLS\n\n    def convert(self, number: int) -> str:\n        \"\"\"Uses a greedy algorithm to convert the integer to Roman numerals.\"\"\"\n        if number < Constants.MIN_NUM or number > Constants.MAX_NUM:\n            raise InvalidInputError(\"Number out of range for Roman conversion.\")\n\n        result = []\n        n = number\n        for value, symbol in self._symbols:\n            while n >= value:\n                result.append(symbol)\n                n -= value\n            if n == 0: # Optimization: stop if the number has been fully converted\n                break\n        return ''.join(result).lower()\n\nclass ConversionService:\n    \"\"\"Orchestrates validation and conversion of an integer to a Roman numeral.\"\"\"\n    def __init__(self, validator: InputValidator, converter: RomanConverter) -> None:\n        self._validator = validator\n        self._converter = converter\n\n    def to_mini_roman(self, number: int | str) -> str:\n        \"\"\"Validates the input and then converts it to a lowercase Roman numeral.\"\"\"\n        int_value = self._validator.validate(number)\n        return self._converter.convert(int_value)\n\nclass PackageAPI:\n    \"\"\"Provides the public API surface for integer to mini-roman conversion.\"\"\"\n    def __init__(self):\n        self.service = ConversionService(InputValidator(), RomanConverter())\n\n    def int_to_mini_roman(self, number: int | str) -> str:\n        \"\"\"Converts a positive integer (1-1000) to its lowercase Roman numeral equivalent.\"\"\"\n        return self.service.to_mini_roman(number)\n\n# Instantiate the PackageAPI globally to be used by the public function\n_package_api_instance = PackageAPI()\n\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    return _package_api_instance.int_to_mini_roman(number)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    \n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # If unique character counts are equal, choose the lexicographically smaller word.\n            if word < result_word:\n                result_word = word\n                \n    return result_word"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Use a numerical tolerance for floating-point comparisons as per design context.\n    tolerance = 1e-9\n\n    # Sort sides to identify the two shorter sides (x, y) and the longest side (z).\n    sides = sorted([a, b, c])\n    x, y, z = sides[0], sides[1], sides[2]\n\n    # Check the Pythagorean theorem: z^2 \u2248 x^2 + y^2, using the specified tolerance comparison logic.\n    sum_of_squares_of_shorter_sides = x*x + y*y\n    square_of_longest_side = z*z\n    \n    return abs(square_of_longest_side - sum_of_squares_of_shorter_sides) <= tolerance * max(1.0, abs(square_of_longest_side), abs(sum_of_squares_of_shorter_sides))"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Computes the total carrots eaten and the carrots left after a meal.\n    The rabbit eats the minimum of carrots needed and carrots remaining in stock.\n    \"\"\"\n    \n    eaten_this_meal = min(need, remaining)\n    total_eaten = number + eaten_this_meal\n    carrots_left = remaining - eaten_this_meal\n    \n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    \"\"\"\n    def _has_letter(input_str: str) -> bool:\n        \"\"\"Checks if the input string contains any alphabetic characters.\"\"\"\n        for char_s in input_str:\n            if char_s.isalpha():\n                return True\n        return False\n\n    if _has_letter(s):\n        result_chars = []\n        for char_s in s:\n            if char_s.isalpha():\n                if char_s.islower():\n                    result_chars.append(char_s.upper())\n                else:\n                    result_chars.append(char_s.lower())\n            else:\n                result_chars.append(char_s)\n        return ''.join(result_chars)\n    else:\n        return s[::-1]"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n\n    # --- 1. Define configuration constants (from config.py in design) ---\n    VALID_OPERATORS = {'+', '-', '*', '//', '**'}\n    PRECEDENCE = {'+': 1, '-': 1, '*': 2, '//': 2, '**': 3}\n    ASSOCIATIVITY = {'+': 'left', '-': 'left', '*': 'left', '//': 'left', '**': 'right'}\n\n    # --- 2. Define custom exception (from exceptions.py in design) ---\n    class AlgebraError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    # --- 3. Define Token class (from token.py in design) ---\n    class Token:\n        def __init__(self, token_type: str, value, pos: int) -> None:\n            self.token_type = token_type\n            self.value = value\n            self.pos = pos\n\n        def __repr__(self) -> str:\n            return f\"Token({self.token_type}, {self.value}, pos={self.pos})\"\n\n    # --- 4. Define Tokenizer class (from tokenizer.py in design) ---\n    class Tokenizer:\n        def tokenize(self, operators: list[str], operands: list[int]) -> list[Token]:\n            if len(operators) != len(operands) - 1:\n                raise AlgebraError(\"operator and operand lengths mismatch\")\n            \n            tokens: list[Token] = []\n            for i, val in enumerate(operands):\n                # Assuming `operand` is List[int], so `val` is already an int. Check non-negative.\n                if val < 0:\n                    raise AlgebraError(f\"invalid operand at index {i}: {val}\")\n                tokens.append(Token('NUMBER', val, pos=len(tokens)))\n                \n                if i < len(operators):\n                    op = operators[i]\n                    # Assuming `operator` is List[str], so `op` is already a str. Check validity.\n                    if op not in VALID_OPERATORS:\n                        raise AlgebraError(f\"invalid operator: {op}\")\n                    tokens.append(Token('OP', op, pos=len(tokens)))\n            return tokens\n\n    # --- 5. Define Parser class (from parser.py in design) ---\n    class Parser:\n        def to_rpn(self, tokens: list[Token]) -> list[Token]:\n            output: list[Token] = []\n            op_stack: list[Token] = []\n\n            for token in tokens:\n                if token.token_type == 'NUMBER':\n                    output.append(token)\n                elif token.token_type == 'OP':\n                    while op_stack:\n                        top = op_stack[-1]\n                        \n                        cur_prec = PRECEDENCE[token.value]\n                        top_prec = PRECEDENCE[top.value]\n                        \n                        # Shunting-yard algorithm logic for precedence and associativity\n                        if (ASSOCIATIVITY[token.value] == 'left' and cur_prec <= top_prec) or \\\n                           (ASSOCIATIVITY[token.value] == 'right' and cur_prec < top_prec):\n                            output.append(op_stack.pop())\n                        else:\n                            break\n                    op_stack.append(token)\n                else:\n                    raise AlgebraError(\"unknown token type encountered during parsing\")\n            \n            while op_stack:\n                output.append(op_stack.pop())\n            return output\n\n    # --- 6. Define RPNEvaluator class (from rpn_evaluator.py in design) ---\n    class RPNEvaluator:\n        def evaluate(self, rpn_tokens: list[Token]) -> int:\n            stack: list[int] = []\n            for t in rpn_tokens:\n                if t.token_type == 'NUMBER':\n                    stack.append(int(t.value))\n                elif t.token_type == 'OP':\n                    if len(stack) < 2:\n                        raise AlgebraError(\"stack underflow during RPN evaluation\")\n                    b = stack.pop()\n                    a = stack.pop()\n                    try:\n                        if t.value == '+':\n                            res = a + b\n                        elif t.value == '-':\n                            res = a - b\n                        elif t.value == '*':\n                            res = a * b\n                        elif t.value == '//':\n                            if b == 0:\n                                raise AlgebraError(\"division by zero\")\n                            res = a // b\n                        elif t.value == '**':\n                            res = pow(a, b)\n                        else:\n                            raise AlgebraError(f\"unsupported operator '{t.value}' in RPN evaluator\")\n                    except OverflowError as e:\n                        raise AlgebraError(\"arithmetic overflow\") from e\n                    stack.append(res)\n                else:\n                    raise AlgebraError(\"invalid token type in RPN sequence\")\n            \n            if len(stack) != 1:\n                raise AlgebraError(\"invalid RPN expression or evaluation error\")\n            return stack[0]\n\n    # --- 7. Orchestration logic (equivalent to AlgebraService.do_algebra in design) ---\n    tokenizer_instance = Tokenizer()\n    parser_instance = Parser()\n    evaluator_instance = RPNEvaluator()\n\n    tokens = tokenizer_instance.tokenize(operator, operand)\n    rpn_tokens = parser_instance.to_rpn(tokens)\n    result = evaluator_instance.evaluate(rpn_tokens)\n\n    return result"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    from collections import OrderedDict\n    from typing import Optional, List, Any, Dict, Tuple\n\n    # --- src/evenints/models.py ---\n    class InputValidationError(Exception):\n        def __init__(self, message: str):\n            self.message = message\n            super().__init__(message)\n\n    # --- src/evenints/validators.py ---\n    class InputValidator:\n        def __init__(self, allow_zero: bool = True):\n            self._allow_zero = allow_zero\n\n        def parse_int(self, value: int | str) -> int:\n            try:\n                parsed_value = int(value)\n            except (ValueError, TypeError):\n                raise InputValidationError(f\"Input '{value}' is not a valid integer.\")\n            return parsed_value\n\n        def validate_non_negative(self, value: int) -> None:\n            if value < 0:\n                raise InputValidationError(f\"Input {value} must be non-negative.\")\n            if value == 0 and not self._allow_zero:\n                raise InputValidationError(\"Input 0 is not allowed.\")\n\n    # --- src/evenints/calculator.py ---\n    class EvenDigitCalculator:\n        def get_even_in_range(self, start: int, end: int) -> List[int]:\n            if start > end:\n                start, end = end, start\n            \n            # Find the first even number in the range [start, end]\n            first_even = start if start % 2 == 0 else start + 1\n            \n            # If the first even number is greater than end, there are no even numbers in the range\n            if first_even > end:\n                return []\n            \n            return list(range(first_even, end + 1, 2))\n\n    # --- src/evenints/repository.py ---\n    class CacheRepository:\n        def __init__(self, max_size: int = 1024):\n            self._cache: OrderedDict[str, List[int]] = OrderedDict()\n            self._max_size = max_size\n\n        def get(self, key: str) -> Optional[List[int]]:\n            if key in self._cache:\n                value = self._cache.pop(key)  # Move to end of LRU\n                self._cache[key] = value\n                return value\n            return None\n\n        def set(self, key: str, value: List[int]) -> None:\n            if key in self._cache:\n                self._cache.pop(key)\n            elif len(self._cache) >= self._max_size:\n                self._cache.popitem(last=False)  # Remove LRU item\n            self._cache[key] = value\n\n        def clear(self) -> None:\n            self._cache.clear()\n\n    # --- src/evenints/services.py ---\n    class IntegerGeneratorService:\n        def __init__(self, calculator: EvenDigitCalculator, cache: Optional[CacheRepository] = None, validator: Optional[InputValidator] = None):\n            self._calculator = calculator\n            self._cache = cache\n            self._validator = validator or InputValidator()\n\n        def generate(self, a: int | str, b: int | str) -> List[int]:\n            a_i = self._validator.parse_int(a)\n            b_i = self._validator.parse_int(b)\n            \n            self._validator.validate_non_negative(a_i)\n            self._validator.validate_non_negative(b_i)\n            \n            start, end = (a_i, b_i) if a_i <= b_i else (b_i, a_i)\n            \n            key = f\"{start}:{end}\"\n            if self._cache:\n                cached = self._cache.get(key)\n                if cached is not None:\n                    return cached\n            \n            out = self._calculator.get_even_in_range(start, end)\n            \n            if self._cache:\n                self._cache.set(key, out)\n            \n            return out\n\n    # --- Default service initialization as per src/evenints/__init__.py design ---\n    _default_service = IntegerGeneratorService(\n        calculator=EvenDigitCalculator(),\n        cache=CacheRepository(max_size=1024),\n        validator=InputValidator(allow_zero=True),\n    )\n\n    # --- Delegate to the default service ---\n    return _default_service.generate(a, b)"}
{"task_id": "HumanEval/162", "solution": "def string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    import hashlib\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
