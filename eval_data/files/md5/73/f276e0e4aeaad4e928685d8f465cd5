{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    The algorithm handles edge cases for small numbers and uses trial division up to sqrt(n) with a 6-step wheel.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    \n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "HumanEval/29", "solution": "from typing import List, Optional\nfrom abc import ABC, abstractmethod\n\n\nclass StringUtils:\n    \"\"\"Provides utility methods for string operations.\"\"\"\n    @staticmethod\n    def starts_with(s: str, prefix: str, case_insensitive: bool = False) -> bool:\n        \"\"\"Checks if a string starts with a prefix, optionally case-insensitively.\"\"\"\n        if case_insensitive:\n            return s.lower().startswith(prefix.lower())\n        return s.startswith(prefix)\n\n\nclass StringRepository(ABC):\n    \"\"\"Abstract base class for string repositories, defining the interface for retrieving strings.\"\"\"\n    @abstractmethod\n    def get_strings(self) -> List[str]:\n        pass\n\n\nclass PrefixFilterService:\n    \"\"\"Encapsulates the core business logic for filtering strings by prefix.\"\"\"\n    def __init__(self, repository: Optional[StringRepository] = None):\n        self._repository = repository\n\n    def filter_by_prefix(self, strings: List[str], prefix: str, case_insensitive: bool = False) -> List[str]:\n        \"\"\"Filters a list of strings to return only those that start with the given prefix.\"\"\"\n        # According to constraints, assume inputs are valid and do not add isinstance checks or raise exceptions.\n        if prefix == \"\":\n            return list(strings)  # Return shallow copy if prefix is empty.\n\n        result: List[str] = []\n        for s in strings:\n            if StringUtils.starts_with(s, prefix, case_insensitive=case_insensitive):\n                result.append(s)\n        return result\n\n\ndef filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    # Delegates to the PrefixFilterService, using case-sensitive matching by default as per design.\n    service = PrefixFilterService()\n    return service.filter_by_prefix(strings, prefix, case_insensitive=False)"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    \"\"\"\n    result = list(l)\n    third_indices = []\n    values_at_third_indices = []\n\n    for i in range(len(l)):\n        if i % 3 == 0:\n            third_indices.append(i)\n            values_at_third_indices.append(l[i])\n\n    values_at_third_indices.sort()\n\n    for i, idx in enumerate(third_indices):\n        result[idx] = values_at_third_indices[i]\n\n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group to the right, unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
