{"task_id": "Mbpp/428", "solution": "def shell_sort(arr: list[int]) -> list[int]:\n    \"\"\"Sorts an array of integers in ascending order using Shell Sort.\"\"\"\n    n = len(arr)\n    gap = 1\n    # Generate initial gap sequence (Knuth's formula)\n    while gap < n // 3:\n        gap = gap * 3 + 1\n\n    # Start with the largest gap and work down to a gap of 1\n    while gap > 0:\n        # Perform insertion sort for elements at current gap\n        for i in range(gap, n):\n            temp = arr[i]\n            j = i\n            # Shift earlier gap-sorted elements up until the correct position for arr[i] is found\n            while j >= gap and arr[j - gap] > temp:\n                arr[j] = arr[j - gap]\n                j -= gap\n            arr[j] = temp\n        # Reduce the gap for the next pass\n        gap //= 3\n    return arr"}
{"task_id": "Mbpp/429", "solution": "import collections.abc\n\ndef and_tuples(tuple1: collections.abc.Tuple[int], tuple2: collections.abc.Tuple[int]) -> collections.abc.Tuple[int]:\n    \"\"\"\n    Extracts the element-wise bitwise AND of two given tuples.\n    \"\"\"\n\n    class IntegerTuple:\n        \"\"\"An immutable domain entity representing a tuple of integers.\"\"\"\n        def __init__(self, elements: collections.abc.Tuple[int]):\n            self.elements = elements\n\n        def __iter__(self):\n            return iter(self.elements)\n\n        def __len__(self):\n            return len(self.elements)\n\n        def __getitem__(self, index: int):\n            return self.elements[index]\n\n    class BitwiseAndOperation:\n        \"\"\"A stateless domain service for applying element-wise bitwise AND.\"\"\"\n        def apply(self, tuple1_obj: IntegerTuple, tuple2_obj: IntegerTuple) -> IntegerTuple:\n            result_elements = []\n            for i in range(len(tuple1_obj)):\n                result_elements.append(tuple1_obj[i] & tuple2_obj[i])\n            return IntegerTuple(collections.abc.Tuple(result_elements))\n\n    int_tuple1 = IntegerTuple(tuple1)\n    int_tuple2 = IntegerTuple(tuple2)\n\n    bitwise_and_service = BitwiseAndOperation()\n    result_int_tuple = bitwise_and_service.apply(int_tuple1, int_tuple2)\n\n    return result_int_tuple.elements"}
