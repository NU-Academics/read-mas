{"task_id": "Mbpp/256", "solution": "def count_Primes_nums(num):\n    \"\"\"\n    Counts the number of prime numbers less than the given non-negative number.\n    Uses a simple trial division method for primality testing.\n    \"\"\"\n    if num <= 2:\n        return 0\n\n    count = 0\n    # Create a list to track primality up to num-1\n    # is_prime[i] will be true if i is prime, false otherwise\n    is_prime = [True] * num\n    is_prime[0] = is_prime[1] = False  # 0 and 1 are not prime\n\n    for p in range(2, num):\n        if is_prime[p]:\n            count += 1\n            # Mark multiples of p as not prime (Sieve of Eratosthenes)\n            for multiple in range(p * p, num, p):\n                is_prime[multiple] = False\n    return count"}
{"task_id": "Mbpp/259", "solution": "def maximize_elements(\n    tuple1: Tuple[Tuple[int, int], ...],\n    tuple2: Tuple[Tuple[int, int], ...]\n) -> Tuple[Tuple[int, int], ...]:\n    \"\"\"\n    Return a tuple of tuples containing the element\u2011wise maximum of two input tuples.\n    Raises ValueError if the input tuples have different lengths.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    result = []\n    for a, b in zip(tuple1, tuple2):\n        max_first = max(a[0], b[0])\n        max_second = max(a[1], b[1])\n        result.append((max_first, max_second))\n\n    return tuple(result)"}
{"task_id": "Mbpp/260", "solution": "def newman_prime(n: int) -> int:\n    \"\"\"\n    Calculates the nth Newman\u2013Shanks\u2013Williams number (P_n), assuming P_n is prime for the given n.\n    The sequence is defined by P_0=1, P_1=1, and P_k = 2*P_{k-1} + P_{k-2} for k >= 2.\n    \"\"\"\n    if n == 1:\n        return 1\n\n    # For n >= 2, use the recurrence relation.\n    # 'a' stores P_{k-2}, 'b' stores P_{k-1}.\n    a = 1  # Represents P_0\n    b = 1  # Represents P_1\n\n    # Iterate from P_2 up to P_n\n    for _ in range(2, n + 1):\n        next_p = 2 * b + a\n        a = b\n        b = next_p\n    \n    return b"}
{"task_id": "Mbpp/261", "solution": "from typing import Tuple, Union\n\ndef division_elements(tuple1: Tuple[Union[int, float]], tuple2: Tuple[Union[int, float]]) -> Tuple[float]:\n    \"\"\"Performs element-wise division of two numeric tuples of equal length.\"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    results = []\n    for a, b in zip(tuple1, tuple2):\n        results.append(a / b)\n\n    return tuple(results)"}
