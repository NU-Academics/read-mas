{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers):\n    \"\"\"\n    Finds the difference of the first even and first odd number in a list.\n    Returns None if either an even or odd number is not found.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        elif first_odd is None and num % 2 != 0:\n            first_odd = num\n        \n        # If both are found, we can stop early\n        if first_even is not None and first_odd is not None:\n            break\n            \n    if first_even is not None and first_odd is not None:\n        return first_even - first_odd\n    else:\n        return None"}
{"task_id": "Mbpp/597", "solution": "import math\n\ndef find_kth(array1: list[int], array2: list[int], k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays.\n    It uses a binary search approach on the shorter array's partition.\n    \"\"\"\n    m, n = len(array1), len(array2)\n\n    # Ensure array1 (a) is the shorter array to optimize binary search range.\n    if m > n:\n        array1, array2 = array2, array1\n        m, n = n, m\n\n    # Define the search space for the partition point in array1.\n    # 'low' is the minimum possible number of elements taken from array1.\n    # 'high' is the maximum possible number of elements taken from array1.\n    low = max(0, k - n)\n    high = min(k, m)\n\n    while low <= high:\n        # partition_a is the number of elements taken from array1.\n        partition_a = (low + high) // 2\n        # partition_b is the number of elements taken from array2.\n        partition_b = k - partition_a\n\n        # Determine elements at the boundaries of the partitions.\n        # Use -math.inf for empty left partitions and math.inf for empty right partitions.\n        max_left_a = array1[partition_a - 1] if partition_a > 0 else -math.inf\n        min_right_a = array1[partition_a] if partition_a < m else math.inf\n\n        max_left_b = array2[partition_b - 1] if partition_b > 0 else -math.inf\n        min_right_b = array2[partition_b] if partition_b < n else math.inf\n\n        # Check if the partition is valid (elements in left half <= elements in right half).\n        if max_left_a <= min_right_b and max_left_b <= min_right_a:\n            # The k-th element is the maximum of the left partition's boundary elements.\n            return max(max_left_a, max_left_b)\n        elif max_left_a > min_right_b:\n            # We took too many elements from array1, so reduce partition_a.\n            high = partition_a - 1\n        else: # max_left_b > min_right_a\n            # We took too few elements from array1, so increase partition_a.\n            low = partition_a + 1\n    \n    # This point should not be reached if k is guaranteed to be a valid index."}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(value):\n    \"\"\"Checks if the given number is an Armstrong number.\"\"\"\n    str_value = str(value)\n    num_digits = len(str_value)\n    sum_of_powers = 0\n    for digit_char in str_value:\n        digit = int(digit_char)\n        sum_of_powers += digit ** num_digits\n    return sum_of_powers == value"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n):\n    \"\"\"Calculates the sum and average of the first n natural numbers.\n    Raises ValueError if n is not a positive integer.\"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    total_sum = n * (n + 1) // 2\n    average = total_sum / n\n    return (total_sum, average)"}
{"task_id": "Mbpp/600", "solution": "def is_Even(number: int) -> bool:\n    \"\"\"Checks if a given number is even using internal domain classes as per design.\"\"\"\n\n    class Number:\n        \"\"\"Represents a number and provides evenness check.\"\"\"\n        def __init__(self, value: int):\n            self._value = value\n\n        def isEven(self) -> bool:\n            \"\"\"Determines if the number is even.\"\"\"\n            return self._value % 2 == 0\n\n    class EvenChecker:\n        \"\"\"Provides an interface to check for evenness.\"\"\"\n        def is_Even(self, num_val: int) -> bool:\n            \"\"\"Checks if a number is even by delegating to a Number instance.\"\"\"\n            num = Number(num_val)\n            return num.isEven()\n\n    checker = EvenChecker()\n    return checker.is_Even(number)"}
