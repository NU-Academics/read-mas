{"task_id": "Mbpp/573", "solution": "def unique_product(numbers):\n    \"\"\"\n    Calculates the product of unique numbers in a given list.\n    Handles an empty list by returning 1 (multiplicative identity).\n    \"\"\"\n    if not numbers:\n        return 1\n\n    unique_nums = set(numbers)\n    product = 1\n    for num in unique_nums:\n        product *= num\n    return product"}
{"task_id": "Mbpp/572", "solution": "def two_unique_nums(numbers):\n    \"\"\"\n    Removes duplicate numbers from a list, returning only those that appear exactly once.\n    The order of the unique numbers in the output list is preserved from the input.\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n            \n    return result"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main, sub):\n    \"\"\"Checks if a list is a contiguous sublist of another list.\n    Returns False if 'sub' is empty, as per design constraints.\"\"\"\n\n    if not sub:\n        return False\n\n    n = len(main)\n    m = len(sub)\n\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        if main[i : i + m] == sub:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1, list2, list3):\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Raises ValueError if the input lists do not have the same length.\n    \"\"\"\n    n = len(list1)\n    if not (len(list2) == n and len(list3) == n):\n        raise ValueError(\"All input lists must have the same length.\")\n\n    result = []\n    for i in range(n):\n        result.append(list1[i])\n        result.append(list2[i])\n        result.append(list3[i])\n    return result"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    # Validates input: n must be a non-negative integer.\n    if not (isinstance(n, int) and n >= 0):\n        raise ValueError(\"Input must be a non\u2011negative integer.\")\n\n    # Calculates the last digit of n!\n    if n >= 5:\n        return 0  # For n >= 5, n! ends in 0.\n    \n    # Compute factorial for n < 5 and return its last digit.\n    # 0! = 1, 1! = 1, 2! = 2, 3! = 6, 4! = 24\n    fact = 1\n    for i in range(2, n + 1):\n        fact *= i\n    return fact % 10"}
{"task_id": "Mbpp/580", "solution": "def extract_even(nested_tuple):\n    \"\"\"\n    Recursively removes odd integers and non-integer elements from a nested tuple,\n    preserving the original structure.\n    \"\"\"\n    result = []\n    for item in nested_tuple:\n        if isinstance(item, tuple):\n            # Recursively process nested tuples\n            sub_tuple_result = extract_even(item)\n            if sub_tuple_result:  # Only add if the sub-tuple is not empty after filtering\n                result.append(sub_tuple_result)\n        elif isinstance(item, int) and item % 2 == 0:\n            # Keep even integers\n            result.append(item)\n    return tuple(result)"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Return a tuple of elements that appear in exactly one of the input tuples.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    dissimilar_elements = set1.symmetric_difference(set2)\n    return tuple(dissimilar_elements)"}
{"task_id": "Mbpp/583", "solution": "import math\n\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Catalan number using the formula C_n = (1 / (n + 1)) * comb(2n, n).\n    Raises ValueError for negative inputs.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Catalan numbers are not defined for negative n.\")\n    \n    # C_n = (1 / (n + 1)) * C(2n, n)\n    # Using integer division, the calculation can be C(2n, n) // (n + 1)\n    # math.comb(N, K) computes \"N choose K\"\n    return math.comb(2 * n, n) // (n + 1)"}
