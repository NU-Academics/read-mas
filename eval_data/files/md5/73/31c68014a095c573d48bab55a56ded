{"task_id": "Mbpp/557", "solution": "def toggle_string(input: str) -> str:\n    \"\"\"\n    Toggle the case of all alphabetic characters in the input string.\n    Non\u2011alphabetic characters are left unchanged.\n    \"\"\"\n    result = []\n    for ch in input:\n        if 'a' <= ch <= 'z':\n            result.append(chr(ord(ch) - 32))  # to uppercase\n        elif 'A' <= ch <= 'Z':\n            result.append(chr(ord(ch) + 32))  # to lowercase\n        else:\n            result.append(ch)\n    return ''.join(result)"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(lst: List[int], n: int) -> int:\n    \"\"\"\n    Counts pairs from the first 'n' elements of 'lst' whose XOR value is odd.\n    A pair's XOR is odd if one element is even and the other is odd.\n    \"\"\"\n    # The design context specified validation, but the general instructions\n    # say \"Do NOT add isinstance() checks or raise exceptions for edge cases\".\n    # I will follow the general instruction to not raise exceptions, but for\n    # correctness, the loop bounds will implicitly handle n <= 0 and n > len(lst)\n    # by iterating 0 times or up to the valid length.\n    # Given the assertion `find_Odd_Pair([5,4,7,2,1],5) == 6`,\n    # `n` is expected to be within valid bounds relative to `len(lst)`.\n\n    # The problem description is for counting pairs, and typically N refers to the list length\n    # but in this case, N is the number of elements from the list to consider.\n    # The assertion `assert find_Odd_Pair([5,4,7,2,1],5) == 6` implies n could be len(lst).\n\n    count = 0\n    # Iterate through all unique pairs of elements from the first n elements\n    for i in range(min(n, len(lst))): # Ensure i does not go out of bounds for lst\n        for j in range(i + 1, min(n, len(lst))): # Ensure j does not go out of bounds for lst\n            # If the XOR of two numbers is odd, one must be odd and the other even.\n            # This is equivalent to checking if the least significant bit is 1.\n            if (lst[i] ^ lst[j]) & 1:\n                count += 1\n    return count"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers.\n    The shorter number is padded with leading zeros to match length before comparison.\n    \"\"\"\n    # Take absolute values of the input integers.\n    abs_a = abs(a)\n    abs_b = abs(b)\n\n    # Convert the absolute values to strings to access digits.\n    str_a = str(abs_a)\n    str_b = str(abs_b)\n\n    # Pad the shorter string with leading zeros to match the length of the longer string.\n    max_len = max(len(str_a), len(str_b))\n    padded_a = str_a.zfill(max_len)\n    padded_b = str_b.zfill(max_len)\n\n    # Iterate through the padded digit strings, calculate absolute differences, and sum them.\n    total_diff = 0\n    for i in range(max_len):\n        digit_a = int(padded_a[i])\n        digit_b = int(padded_b[i])\n        total_diff += abs(digit_a - digit_b)\n\n    return total_diff"}
{"task_id": "Mbpp/562", "solution": "```python\ndef Find_Max_Length(input_list):\n    \"\"\"\n    Finds the length of the longest sublist in a given list of lists.\n    Returns 0 if the input list or any sublist is empty.\n    \"\"\"\n    max_length = 0\n    for sublist in input_list:\n        if len(sublist) > max_length:\n            max_length = len(sublist)\n    return max_length\n```"}
{"task_id": "Mbpp/560", "solution": "def union_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Computes the sorted union of elements from two given tuples.\n    This function combines elements, removes duplicates, and sorts them.\n    \"\"\"\n    combined_elements = set(tuple1) | set(tuple2)\n    sorted_unique_elements = sorted(combined_elements)\n    return tuple(sorted_unique_elements)"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(nums, _):\n    \"\"\"\n    Finds the sum of the largest contiguous sublist using Kadane's algorithm.\n    Handles empty lists and lists with all negative numbers.\n    \"\"\"\n    if not nums:\n        return 0\n\n    max_so_far = nums[0]\n    current_max = nums[0]\n\n    for i in range(1, len(nums)):\n        num = nums[i]\n        current_max = max(num, current_max + num)\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
