{"task_id": "Mbpp/463", "solution": "def max_subarray_product(array: list[int]) -> int:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray in the given array.\n    Uses dynamic programming to track maximum and minimum products ending at the current position.\n    \"\"\"\n    max_so_far = array[0]\n    max_ending_here = array[0]\n    min_ending_here = array[0]\n\n    for i in range(1, len(array)):\n        num = array[i]\n        \n        # Store max_ending_here before updating, as it's needed for min_ending_here calculation\n        temp_max_ending_here = max_ending_here\n\n        # Update max_ending_here: it's the maximum of current number,\n        # current number multiplied by previous max_ending_here,\n        # or current number multiplied by previous min_ending_here.\n        max_ending_here = max(num, max(temp_max_ending_here * num, min_ending_here * num))\n        \n        # Update min_ending_here: similarly, it's the minimum of current number,\n        # current number multiplied by previous max_ending_here,\n        # or current number multiplied by previous min_ending_here.\n        min_ending_here = min(num, min(temp_max_ending_here * num, min_ending_here * num))\n        \n        # The overall maximum product is the maximum seen so far.\n        max_so_far = max(max_so_far, max_ending_here)\n\n    return max_so_far"}
{"task_id": "Mbpp/468", "solution": "def max_product(values: list[int]) -> int:\n    \"\"\"\n    Computes the maximum product of an increasing subsequence within a list of integers.\n    Uses dynamic programming with O(n^2) time complexity and O(n) space complexity.\n    \"\"\"\n    n = len(values)\n    if n == 0:\n        return 0\n\n    # dp[i] stores the maximum product of an increasing subsequence ending at index i.\n    # Initialize dp[i] with the element itself, representing a subsequence of length one.\n    dp = list(values)\n\n    for i in range(n):\n        for j in range(i):\n            # If values[j] is less than values[i], values[i] can extend an increasing subsequence ending at values[j].\n            if values[j] < values[i]:\n                # Update dp[i] with the maximum product found so far,\n                # considering the product formed by appending values[i] to a subsequence ending at values[j].\n                dp[i] = max(dp[i], dp[j] * values[i])\n    \n    # The maximum product is the largest value found anywhere in the dp array.\n    return max(dp)"}
{"task_id": "Mbpp/470", "solution": "from typing import Tuple, Union\n\nNumber = Union[int, float]\n\ndef add_pairwise(input_tuple: Tuple[Number, ...]) -> Tuple[Number, ...]:\n    \"\"\"\n    Return a tuple containing the sums of each pair of consecutive elements\n    from the input tuple. If the input tuple has fewer than two elements,\n    an empty tuple is returned.\n    \"\"\"\n    if len(input_tuple) < 2:\n        return ()\n    return tuple(input_tuple[i] + input_tuple[i + 1] for i in range(len(input_tuple) - 1))"}
