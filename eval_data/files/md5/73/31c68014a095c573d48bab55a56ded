{"task_id": "Mbpp/777", "solution": "def find_sum(numbers: List[int]) -> int:\n    \"\"\"\n    Return the sum of all integers that appear exactly once in the input list.\n    Returns 0 for an empty list.\n    \"\"\"\n    from collections import Counter\n    from typing import List\n\n    if not numbers:\n        return 0\n\n    freq = Counter(numbers)\n    unique_values = [num for num, count in freq.items() if count == 1]\n    return sum(unique_values)"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list[Any]) -> list[list[Any]]:\n    \"\"\"\n    Packs consecutive duplicate elements of a list into sublists.\n    Preserves the original order of elements and sublists.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_sublist = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_sublist[-1]:\n            current_sublist.append(input_list[i])\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [input_list[i]]\n    \n    # Append the last sublist after the loop finishes\n    packed_list.append(current_sublist)\n    \n    return packed_list"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(tuple_list):\n    \"\"\"\n    Finds combinations of element-wise sums of unique unordered pairs of tuples from the input list.\n    Returns an empty list if there are fewer than two tuples in the input.\n    \"\"\"\n    if len(tuple_list) < 2:\n        return []\n\n    result_sums = []\n    for i in range(len(tuple_list)):\n        for j in range(i + 1, len(tuple_list)):\n            t1 = tuple_list[i]\n            t2 = tuple_list[j]\n            sum_tuple = (t1[0] + t2[0], t1[1] + t2[1])\n            result_sums.append(sum_tuple)\n\n    return result_sums"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if the count of positive divisors for a given integer n is even.\n    A number is even if it is not a perfect square.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n    if n == 0:\n        return True  # 0 has infinite divisors, which can be considered even\n    \n    # A number has an odd number of divisors if and only if it is a perfect square.\n    # Otherwise, it has an even number of divisors.\n    \n    # Calculate the integer square root\n    sqrt_n = int(n**0.5)\n    \n    # Check if n is a perfect square\n    is_perfect_square = (sqrt_n * sqrt_n == n)\n    \n    # If it's a perfect square, divisor count is odd. If not, it's even.\n    return not is_perfect_square"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"Calculates the sum of all subarrays with an odd length.\"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        current_subarray_sum = 0\n        for j in range(i, n):\n            current_subarray_sum += arr[j]\n            # Check if the length of the current subarray (from i to j) is odd.\n            # Length is j - i + 1\n            if (j - i + 1) % 2 == 1:\n                total_sum += current_subarray_sum\n    return total_sum"}
{"task_id": "Mbpp/785", "solution": "import re\nfrom typing import Tuple\n\ndef tuple_str_int(input: str) -> Tuple[int, ...]:\n    \"\"\"Parse *input* and return a tuple of integers.\n    Raises ValueError if *input* does not match the expected pattern.\n    \"\"\"\n    pattern = r'^\\s*\\((?:\\s*-?\\d+\\s*,\\s*)*-?\\d+\\s*\\)\\s*$'\n    if not re.match(pattern, input):\n        raise ValueError(f\"Invalid tuple string: {input!r}\")\n    # Strip parentheses and split by comma\n    inner = input.strip()[1:-1]\n    parts = [p.strip() for p in inner.split(',')]\n    return tuple(int(p) for p in parts)"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(list_of_nums: List[int]) -> int:\n    \"\"\"\n    Find the product of the first even and first odd number in the given list.\n    Raises ValueError if the list does not contain at least one even and one odd integer.\n    \"\"\"\n    first_even = None\n    first_odd = None\n    for n in list_of_nums:\n        if first_even is None and n % 2 == 0:\n            first_even = n\n        elif first_odd is None and n % 2 != 0:\n            first_odd = n\n        if first_even is not None and first_odd is not None:\n            return first_even * first_odd\n    raise ValueError(\"List must contain at least one even and one odd integer.\")"}
{"task_id": "Mbpp/786", "solution": "from typing import List\n\ndef right_insertion(lst: List[int], value: int) -> int:\n    \"\"\"\n    Return the index at which `value` should be inserted into `lst`\n    to maintain ascending order, placing it after any existing duplicates.\n    \"\"\"\n    lo, hi = 0, len(lst)\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if lst[mid] <= value:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo"}
