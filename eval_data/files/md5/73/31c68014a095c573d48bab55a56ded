{"task_id": "Mbpp/453", "solution": "def sumofFactors(n: int) -> int:\n    \"\"\"Calculates the sum of even factors of a given number.\"\"\"\n    import math\n    from typing import List\n\n    class Factor:\n        def __init__(self, value: int):\n            self.value = value\n\n    class Number:\n        def __init__(self, value: int):\n            self.value = value\n\n        def get_factors(self) -> List[int]:\n            if self.value == 0:\n                return []\n            factors = set()\n            limit = int(math.isqrt(self.value))\n            for i in range(1, limit + 1):\n                if self.value % i == 0:\n                    factors.add(i)\n                    factors.add(self.value // i)\n            return sorted(list(factors))\n\n        def get_even_factors(self) -> List[int]:\n            all_factors = self.get_factors()\n            return [f for f in all_factors if f % 2 == 0]\n\n        def sum_even_factors(self) -> int:\n            return sum(self.get_even_factors())\n\n    if n == 0:\n        return 0\n\n    abs_n = abs(n)\n    number_instance = Number(abs_n)\n    return number_instance.sum_even_factors()"}
{"task_id": "Mbpp/454", "solution": "def text_match_wordz(text):\n    \"\"\"\n    Checks if the input string contains at least one word that includes the letter 'z'.\n    Words are defined as contiguous alphabetic sequences; non-alphabetic characters are delimiters.\n    \"\"\"\n    current_word_chars = []\n    \n    for char in text:\n        if char.isalpha():\n            current_word_chars.append(char)\n        else:\n            if current_word_chars:\n                word_str = \"\".join(current_word_chars)\n                if 'z' in word_str.lower():\n                    return True\n                current_word_chars = []\n    \n    # After the loop, check the last word if the string ended with alphabetic characters\n    if current_word_chars:\n        word_str = \"\".join(current_word_chars)\n        if 'z' in word_str.lower():\n            return True\n            \n    return False"}
