{"task_id": "Mbpp/797", "solution": "def sum_in_range(l, r):\n    \"\"\"\n    Calculates the sum of all odd natural numbers within an inclusive range [l, r].\n    Natural numbers are positive integers (1, 2, 3, ...).\n    \"\"\"\n    if l > r:\n        return 0\n\n    total = 0\n    for n in range(l, r + 1):\n        if n > 0 and n % 2 != 0:  # Check if n is a positive odd number\n            total += n\n    return total"}
{"task_id": "Mbpp/798", "solution": "def _sum(array: list) -> int:\n    \"\"\"\n    Calculates the sum of all elements in the input list.\n    Handles empty lists by returning 0.\n    \"\"\"\n    return sum(array)"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(text):\n    \"\"\"\n    Removes all whitespace characters from the input string.\n    It iterates through the string and filters out characters for which str.isspace() is true.\n    \"\"\"\n    return \"\".join(char for char in text if not char.isspace())"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a, b, c):\n    \"\"\"\n    Counts the number of equal numbers from three given integers.\n    Returns 3 if all are equal, 2 if exactly two are equal, and 0 otherwise.\n    \"\"\"\n    if a == b == c:\n        return 3\n    if a == b or a == c or b == c:\n        return 2\n    return 0"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(number, d):\n    \"\"\"\n    Rotates the bits of a 32-bit number to the left by d positions.\n    The input number is treated as a 32-bit unsigned integer, and the shift amount is modulo 32.\n    \"\"\"\n    # Ensure the number is treated as a 32-bit unsigned integer\n    number = number & 0xFFFFFFFF\n    # Normalize the shift amount d to be within 0-31\n    d = d % 32\n    # Perform the left rotation\n    rotated_number = ((number << d) | (number >> (32 - d)))\n    # Mask the result to ensure it remains a 32-bit unsigned integer\n    return rotated_number & 0xFFFFFFFF"}
{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(number):\n    \"\"\"\n    Checks if the given number is a perfect square.\n    Returns True if the number is a perfect square, False otherwise.\n    \"\"\"\n    if number < 0:\n        return False\n    # Calculate the integer square root.\n    root = math.isqrt(number)\n    # Check if the square of the integer root equals the original number.\n    return root * root == number"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers):\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    Returns True if any number in the list is even, False otherwise.\n    \"\"\"\n    for number in numbers:\n        if number % 2 == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/808", "solution": "def check_K(t: tuple, k: int) -> bool:\n    \"\"\"\n    Checks if the integer `k` is present in the tuple `t`.\n    Returns True if `k` is found, False otherwise.\n    \"\"\"\n    return k in t"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(lists):\n    \"\"\"\n    Returns the sublist from a list of lists whose sum of elements is the highest.\n    If multiple lists have the same highest sum, the first encountered is returned; returns an empty list for empty input.\n    \"\"\"\n    max_current_sum = float('-inf')\n    result_list = []\n\n    for sublist in lists:\n        current_sum = sum(sublist)\n        if current_sum > max_current_sum:\n            max_current_sum = current_sum\n            result_list = sublist\n            \n    return result_list"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(first, second):\n    \"\"\"\n    Checks if each element of the second tuple is strictly smaller than its corresponding element in the first tuple.\n    Assumes tuples are of the same length and contain comparable elements.\n    \"\"\"\n    return all(s_elem < f_elem for f_elem, s_elem in zip(first, second))"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(value: str) -> int:\n    \"\"\"\n    Finds the maximum run of uppercase characters in the given string.\n    Returns 0 if the string is empty or contains no uppercase characters.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in value:\n        if 'A' <= char <= 'Z':  # Check if the character is an uppercase ASCII letter\n            current_run += 1\n        else:\n            max_run = max(max_run, current_run)\n            current_run = 0\n    max_run = max(max_run, current_run)  # Check for a run at the end of the string\n    return max_run"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers):\n    \"\"\"\n    Finds the first odd number in a given list of numbers.\n    Returns the first odd number found, or None if no odd numbers are present.\n    \"\"\"\n    for number in numbers:\n        if number % 2 != 0:\n            return number\n    return None"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(s, char):\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    If the character occurs fewer than two times, the original string is returned.\n    \"\"\"\n    first_idx = s.find(char)\n    last_idx = s.rfind(char)\n\n    # If the character is not found, or found only once, return the original string.\n    if first_idx == -1 or first_idx == last_idx:\n        return s\n    \n    return s[:first_idx] + s[first_idx+1:last_idx] + s[last_idx+1:]"}
