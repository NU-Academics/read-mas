{"task_id": "Mbpp/751", "solution": "def check_min_heap(array):\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    A min-heap property ensures that every parent node's value is less than or equal to its children's values.\n    \"\"\"\n    n = len(array)\n    # An empty array or an array with one element is a valid min-heap.\n    if n <= 1:\n        return True\n\n    # Iterate through all parent nodes (nodes with at least one child).\n    # In a 0-indexed array, parent nodes are from index 0 up to (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check against the left child\n        if array[i] > array[left_child_idx]:\n            return False\n\n        # Check against the right child, if it exists\n        if right_child_idx < n and array[i] > array[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n):\n    \"\"\"\n    Computes the nth Jacobsthal number iteratively.\n    Uses the recurrence J(n) = J(n-1) + 2 * J(n-2) with base cases J(0)=0 and J(1)=1.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    # Initialize with J(0) and J(1)\n    j_k_minus_2 = 0  # Represents J(k-2)\n    j_k_minus_1 = 1  # Represents J(k-1)\n\n    # Iterate from J(2) up to J(n)\n    for _ in range(2, n + 1):\n        j_k = j_k_minus_1 + 2 * j_k_minus_2\n        j_k_minus_2 = j_k_minus_1\n        j_k_minus_1 = j_k\n        \n    return j_k_minus_1"}
{"task_id": "Mbpp/753", "solution": "import heapq\nfrom typing import List, Tuple\n\nclass Record:\n    \"\"\"Domain entity representing a record with a name and a value.\"\"\"\n    def __init__(self, name: str, value: int):\n        self.name = name\n        self.value = value\n\n    def __lt__(self, other):\n        \"\"\"Enables comparison of Record objects based on their value.\"\"\"\n        if not isinstance(other, Record):\n            return NotImplemented\n        return self.value < other.value\n\nclass MinKService:\n    \"\"\"Domain service to find the k smallest records.\"\"\"\n    def min_k(self, records: List[Record], k: int) -> List[Record]:\n        \"\"\"\n        Uses a min-heap to find the k smallest Record objects.\n        Returns the result sorted by value.\n        \"\"\"\n        return heapq.nsmallest(k, records, key=lambda record: record.value)\n\ndef min_k(records: List[Tuple[str, int]], k: int) -> List[Tuple[str, int]]:\n    \"\"\"\n    Finds the minimum k records from a list of (name, value) tuples.\n    The records are sorted by their integer value.\n    \"\"\"\n    if not isinstance(k, int) or k < 0:\n        raise ValueError(\"k must be a non-negative integer.\")\n    if k > len(records):\n        raise ValueError(\"k cannot be greater than the number of records.\")\n\n    if k == 0:\n        return []\n\n    domain_records = [Record(name, value) for name, value in records]\n\n    service = MinKService()\n    smallest_domain_records = service.min_k(domain_records, k)\n\n    result_tuples = [(record.name, record.value) for record in smallest_domain_records]\n    return result_tuples"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that are common across three lists at the same index.\n    Raises ValueError if input lists have different lengths.\n    \"\"\"\n    if not (len(l1) == len(l2) == len(l3)):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    common_elements = []\n    for i in range(len(l1)):\n        if l1[i] == l2[i] and l2[i] == l3[i]:\n            common_elements.append(l1[i])\n    return common_elements"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"\n    Counts the number of unordered pairs of reverse strings in the given list.\n    Handles palindromes and duplicate occurrences as per design rules.\n    \"\"\"\n    counts = collections.Counter(string_list)\n    total_pairs = 0\n\n    # Iterate over a copy of keys because we modify counts during iteration\n    for s in list(counts.keys()):\n        if counts[s] == 0:\n            continue\n\n        rev_s = s[::-1]\n\n        if s == rev_s:  # String is a palindrome\n            # Palindromic strings form a pair only when at least two identical palindrome strings are present.\n            # If 'k' identical palindromes are present, they form k*(k-1)/2 pairs.\n            k = counts[s]\n            if k >= 2:\n                total_pairs += k * (k - 1) // 2\n            counts[s] = 0 # Mark as processed\n        else:  # String is not a palindrome\n            # Check if its reverse exists and hasn't been processed yet.\n            if rev_s in counts and counts[rev_s] > 0:\n                # If 'k1' occurrences of 's' and 'k2' occurrences of 'rev_s' exist,\n                # they form k1 * k2 pairs.\n                total_pairs += counts[s] * counts[rev_s]\n                counts[s] = 0  # Mark both as processed to avoid double counting\n                counts[rev_s] = 0\n\n    return total_pairs"}
{"task_id": "Mbpp/755", "solution": "class InsufficientDistinctIntegersError(Exception):\n    \"\"\"Raised when there are fewer than two distinct integers in the input list.\"\"\"\n    pass\n\ndef second_smallest(list: list) -> int:\n    \"\"\"\n    Finds the second smallest distinct number in a list of integers.\n    Raises InsufficientDistinctIntegersError if fewer than two distinct integers exist.\n    \"\"\"\n    distinct_numbers = set(list)\n\n    if len(distinct_numbers) < 2:\n        raise InsufficientDistinctIntegersError(\"The list must contain at least two distinct integers.\")\n\n    sorted_distinct = sorted(list(distinct_numbers))\n    return sorted_distinct[1]"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(input_list: list[list[Any]]) -> dict[tuple[Any, ...], int]:\n    \"\"\"\n    Count unique sublists in input_list, returning a dictionary of tuple-counts.\n    Each sublist is converted to a tuple to serve as a hashable key for counting its occurrences.\n    \"\"\"\n    counts: dict[tuple[Any, ...], int] = {}\n\n    for sublist in input_list:\n        key: tuple[Any, ...] = tuple(sublist)\n        counts[key] = counts.get(key, 0) + 1\n\n    return counts"}
