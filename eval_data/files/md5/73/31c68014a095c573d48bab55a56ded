{"task_id": "Mbpp/274", "solution": "import math\nfrom dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass BinomialCoefficient:\n    n: int\n    k: int\n    value: int\n\nclass InputValidator:\n    @staticmethod\n    def is_positive_integer(n: int) -> bool:\n        return isinstance(n, int) and n > 0\n\nclass BinomialCoefficientCalculator:\n    @staticmethod\n    def compute_sum_even_indices(n: int) -> int:\n        total = 0\n        for k in range(0, n + 1, 2):  # Iterate through even indices only.\n            coeff = BinomialCoefficient(n, k, math.comb(n, k))\n            total += coeff.value\n        return total\n\ndef even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"\n    Compute the sum of binomial coefficients C(n, k) for all even k.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    if not InputValidator.is_positive_integer(n):\n        raise ValueError(\"n must be a positive integer\")\n    return BinomialCoefficientCalculator.compute_sum_even_indices(n)"}
