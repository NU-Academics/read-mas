{"task_id": "Mbpp/731", "solution": "def lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone given radius r and height h.\n    The formula used is pi * r * sqrt(r^2 + h^2).\n    \"\"\"\n    import math\n    if r <= 0 or h <= 0:\n        raise ValueError(\"Radius and height must be positive.\")\n    slant_height = math.sqrt(r**2 + h**2)\n    area = math.pi * r * slant_height\n    return area"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array, target):\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array.\n    Uses a modified binary search to locate the leftmost target.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            result = mid  # Store potential first occurrence\n            high = mid - 1  # Look for an even earlier occurrence in the left half\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n            \n    return result"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(numbers: List[int]) -> int:\n    \"\"\"Calculates the sum of products of all contiguous sublists.\"\"\"\n    total_sum_of_all_sublist_products = 0\n    sum_of_products_ending_at_current_index = 0\n\n    for num in numbers:\n        # The sum of products of sublists ending at the current 'num' is\n        # num itself (for the sublist [num]) plus num multiplied by\n        # the sum of products of all sublists ending at the previous index.\n        sum_of_products_ending_at_current_index = num * (1 + sum_of_products_ending_at_current_index)\n        total_sum_of_all_sublist_products += sum_of_products_ending_at_current_index\n    \n    return total_sum_of_all_sublist_products"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(value: int) -> int:\n    \"\"\"Toggle all bits of a non-negative integer except the most significant and least significant bits.\n    Returns the integer with middle bits inverted, with MSB and LSB preserved.\"\"\"\n    \n    bit_len = value.bit_length()\n\n    if bit_len <= 2:\n        # If there are 0, 1, or 2 bits, there are no middle bits to toggle.\n        return value\n\n    # Create a mask with 1s in the positions of the middle bits.\n    # This involves (bit_len - 2) number of 1s, shifted left by 1 (to skip the LSB).\n    middle_mask = ((1 << (bit_len - 2)) - 1) << 1\n    \n    # XOR the value with the mask to toggle only the middle bits.\n    return value ^ middle_mask"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list, value):\n    \"\"\"Return the leftmost index where value can be inserted.\"\"\"\n    low, high = 0, len(sorted_list)\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
