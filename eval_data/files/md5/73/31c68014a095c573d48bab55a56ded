{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"\n    Calculates whether the matrix is a magic square.\n    A magic square is a square matrix where the sum of the numbers in each row,\n    each column, and both main diagonals is the same.\n    \"\"\"\n    n = len(matrix)\n\n    if n == 0:\n        return False  # An empty matrix cannot be a magic square\n\n    # Validate that the input is a square matrix (FR4)\n    for row in matrix:\n        if len(row) != n:\n            return False  # Not a square matrix\n\n    # Calculate the sum that all rows, columns, and diagonals must equal\n    # (using the first row sum as the reference magic_sum)\n    magic_sum = sum(matrix[0])\n\n    # Check row sums (FR2)\n    for row in matrix:\n        if sum(row) != magic_sum:\n            return False\n\n    # Check column sums (FR2)\n    for j in range(n):\n        current_col_sum = 0\n        for i in range(n):\n            current_col_sum += matrix[i][j]\n        if current_col_sum != magic_sum:\n            return False\n\n    # Check main diagonal sum (top-left to bottom-right) (FR2)\n    main_diag_sum = 0\n    for i in range(n):\n        main_diag_sum += matrix[i][i]\n    if main_diag_sum != magic_sum:\n        return False\n\n    # Check anti-diagonal sum (top-right to bottom-left) (FR2)\n    anti_diag_sum = 0\n    for i in range(n):\n        anti_diag_sum += matrix[i][n - 1 - i]\n    if anti_diag_sum != magic_sum:\n        return False\n\n    # If all checks pass, it is a magic square (FR3)\n    return True"}
{"task_id": "Mbpp/131", "solution": "class VowelSet:\n    \"\"\"Utility class to determine if a character is a vowel.\"\"\"\n    _vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    @staticmethod\n    def is_vowel(ch: str) -> bool:\n        return ch.lower() in VowelSet._vowels\n\n\ndef reverse_vowels(input_str: str) -> str:\n    \"\"\"\n    Reverse only the vowels in the input string.\n    \"\"\"\n    chars = list(input_str)\n    vowel_indices = [i for i, ch in enumerate(chars) if VowelSet.is_vowel(ch)]\n\n    left, right = 0, len(vowel_indices) - 1\n    while left < right:\n        i, j = vowel_indices[left], vowel_indices[right]\n        chars[i], chars[j] = chars[j], chars[i]\n        left += 1\n        right -= 1\n\n    return ''.join(chars)"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(items: List[Any]) -> Any:\n    \"\"\"\n    Finds the item with the maximum frequency in a list.\n    Returns the first such item encountered if there are ties.\n    \"\"\"\n    from typing import Any, List, Dict\n\n    class ItemWrapper:\n        def __init__(self, value: Any) -> None:\n            self.value = value\n\n        def __hash__(self) -> int:\n            return hash(self.value)\n\n        def __eq__(self, other: object) -> bool:\n            return isinstance(other, ItemWrapper) and self.value == other.value\n\n    wrapped_items = [ItemWrapper(v) for v in items]\n\n    frequency_counts: Dict[ItemWrapper, int] = {}\n    for item_obj in wrapped_items:\n        frequency_counts[item_obj] = frequency_counts.get(item_obj, 0) + 1\n\n    max_frequency = max(frequency_counts.values())\n\n    for item_key, count_val in frequency_counts.items():\n        if count_val == max_frequency:\n            return item_key.value"}
