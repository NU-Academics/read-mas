{"task_id": "Mbpp/608", "solution": "import math\n\ndef bell_Number(n: int) -> int:\n    \"\"\"Calculates the nth Bell number using a dynamic programming approach.\"\"\"\n    if n == 0:\n        return 1\n\n    bell = [0] * (n + 1)\n    bell[0] = 1\n\n    for i in range(1, n + 1):\n        current_bell_number = 0\n        for j in range(i):\n            current_bell_number += bell[j] * math.comb(i - 1, j)\n        bell[i] = current_bell_number\n        \n    return bell[n]"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list, k):\n    \"\"\"\n    Returns a new list with the k-th element removed, preserving the original list.\n    k is a 1-based index.\n    \"\"\"\n    new_list = list(input_list)\n    # k is 1-based, so for 0-based indexing, we use k-1\n    del new_list[k - 1]\n    return new_list"}
{"task_id": "Mbpp/612", "solution": "def merge(list_of_lists):\n    \"\"\"\n    Splits a list of two-element sublists into two separate lists of first and second elements.\n    Raises ValueError if any sublist does not contain exactly two elements.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n    for sublist in list_of_lists:\n        if len(sublist) != 2:\n            raise ValueError(\"Each sublist must contain exactly two elements.\")\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n    return [first_elements, second_elements]"}
