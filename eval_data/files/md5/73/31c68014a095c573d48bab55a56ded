{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array):\n    \"\"\"\n    Checks if the given array is monotonic (either non-increasing or non-decreasing).\n    An empty or single-element array is considered monotonic.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(1, len(array)):\n        if array[i] > array[i - 1]:\n            is_decreasing = False\n        elif array[i] < array[i - 1]:\n            is_increasing = False\n\n    return is_increasing or is_decreasing"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(list, sublist):\n    \"\"\"Checks if a sublist is contiguously present within a larger list.\n    An empty sublist is always considered contained.\"\"\"\n    if not sublist:\n        return True\n\n    len_sub = len(sublist)\n    len_list = len(list)\n\n    # If the sublist is longer than the main list, it cannot be a sublist.\n    if len_sub > len_list:\n        return False\n\n    # Iterate through the main list with a sliding window.\n    for i in range(len_list - len_sub + 1):\n        # Compare the current window (slice) of the main list with the sublist.\n        if list[i : i + len_sub] == sublist:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(input_list):\n    \"\"\"\n    Sort a list of comparable elements in ascending order using Comb Sort.\n\n    The original list is not modified.\n    \"\"\"\n    if len(input_list) <= 1:\n        return input_list.copy()\n\n    gap = len(input_list)\n    shrink = 1.3\n    sorted_flag = False\n    result = input_list.copy()\n\n    while not sorted_flag:\n        gap = int(gap / shrink)\n        if gap <= 1:\n            gap = 1\n            sorted_flag = True\n\n        i = 0\n        while i + gap < len(result):\n            if result[i] > result[i + gap]:\n                result[i], result[i + gap] = result[i + gap], result[i]\n                sorted_flag = False\n            i += 1\n\n    return result"}
