{"task_id": "Mbpp/590", "solution": "import math\n\ndef polar_rect(radius: float, angle: float) -> tuple[float, float]:\n    \"\"\"\n    Converts polar coordinates (radius, angle) to rectangular coordinates (x, y).\n    Angle is interpreted in radians.\n    \"\"\"\n    if radius < 0:\n        raise ValueError(\"Radius must be non-negative.\")\n\n    x = radius * math.cos(angle)\n    y = radius * math.sin(angle)\n    return (x, y)"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip_address: str) -> tuple:\n    \"\"\"\n    Removes leading zeroes from each octet of an IPv4 address string.\n    Returns the cleaned IP address as a tuple of strings.\n    \"\"\"\n\n    class Octet:\n        \"\"\"\n        Represents an individual octet of an IP address and provides\n        functionality to remove leading zeroes.\n        \"\"\"\n        def __init__(self, value: str):\n            self.value = value\n\n        def cleanedValue(self) -> str:\n            \"\"\"\n            Returns the octet's value with leading zeroes removed,\n            while preserving '0' if it's the only digit.\n            \"\"\"\n            return str(int(self.value))\n\n    class IPAddress:\n        \"\"\"\n        Encapsulates an IPv4 address, providing methods to parse and\n        clean its octets.\n        \"\"\"\n        def __init__(self, original_ip: str):\n            self.original = original_ip\n            self.octets = []\n\n        def removeLeadingZeroes(self) -> tuple:\n            \"\"\"\n            Parses the original IP, cleans each octet, and returns\n            the result as a tuple of cleaned octet strings.\n            \"\"\"\n            octet_strings = self.original.split('.')\n            cleaned_octet_values = []\n            for octet_str in octet_strings:\n                octet = Octet(octet_str)\n                cleaned_octet_values.append(octet.cleanedValue())\n            return tuple(cleaned_octet_values)\n\n    ip_obj = IPAddress(ip_address)\n    cleaned_ip_tuple = ip_obj.removeLeadingZeroes()\n    return cleaned_ip_tuple"}
{"task_id": "Mbpp/592", "solution": "def sum_Of_product(n):\n    \"\"\"\n    Calculates the sum of products of consecutive binomial coefficients C(n,k) * C(n,k+1).\n    The sum runs from k=0 to n-1.\n    \"\"\"\n    import math\n\n    def _binomial_coefficient(n_val, k_val):\n        \"\"\"Computes the binomial coefficient C(n_val, k_val).\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        # math.comb handles cases like k=0 or k=n efficiently.\n        return math.comb(n_val, k_val)\n\n    total_sum = 0\n    for k in range(n):\n        coeff1 = _binomial_coefficient(n, k)\n        coeff2 = _binomial_coefficient(n, k + 1)\n        total_sum += coeff1 * coeff2\n\n    return total_sum"}
