{"task_id": "Mbpp/160", "solution": "def find_solution(a, b, n):\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple (x, y),\n    or returns None if no solution exists.\n    \"\"\"\n    # Extended Euclidean Algorithm to find g = gcd(a, b) and x_g, y_g such that a*x_g + b*y_g = g.\n    def _extended_gcd(a_val, b_val):\n        if b_val == 0:\n            return a_val, 1, 0\n        else:\n            g, x, y = _extended_gcd(b_val, a_val % b_val)\n            return g, y, x - (a_val // b_val) * y\n\n    # Calculate gcd(a, b) and an initial particular solution (x_g, y_g) for a*x_g + b*y_g = g\n    g, x_g, y_g = _extended_gcd(a, b)\n\n    # Ensure g is positive to simplify divisibility checks and scaling.\n    # Adjust x_g, y_g accordingly if g was negative.\n    if g < 0:\n        g = -g\n        x_g = -x_g\n        y_g = -y_g\n\n    # If n is not divisible by g, no integer solution exists.\n    if n % g != 0:\n        return None\n    \n    # Scale the particular solution from a*x_g + b*y_g = g to a*x_p + b*y_p = n.\n    scale_factor = n // g\n    x_particular = x_g * scale_factor\n    y_particular = y_g * scale_factor\n\n    # Normalize the solution (x, y) to find a specific one among infinite possibilities.\n    # The general solution is (x_p + t * (b/g), y_p - t * (a/g)) for any integer t.\n    # We choose t such that x is in a canonical range (e.g., smallest non-negative x).\n\n    b_over_g = b // g\n    a_over_g = a // g\n\n    # If b_over_g is 0, then a*x = n. x is uniquely determined, and y can be arbitrary.\n    # Our _extended_gcd with b=0 gives y_g=0, leading to y_particular=0.\n    # This (x_particular, 0) is a valid solution and needs no further adjustment.\n    if b_over_g == 0:\n        return (x_particular, y_particular)\n\n    # Calculate t to adjust x_particular into a canonical range using Python's modulo behavior.\n    # x_canonical = x_particular % b_over_g is the target x value within a period.\n    # The difference (x_canonical - x_particular) must be t * b_over_g.\n    # So t = (x_canonical - x_particular) // b_over_g.\n    t = (x_particular % b_over_g - x_particular) // b_over_g\n\n    x_final = x_particular + t * b_over_g\n    y_final = y_particular - t * a_over_g\n    \n    return (x_final, y_final)"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n):\n    \"\"\"\n    Calculates the sum (n - 2*i) for i from 0 to n // 2.\n    \"\"\"\n    total = 0\n    # Iterate from i=0 up to n // 2 (inclusive)\n    for i in range(n // 2 + 1):\n        total += (n - 2 * i)\n    return total"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(text: str) -> int:\n    \"\"\"\n    Counts characters whose 1-based position in the string matches their 1-based alphabetical position (case-insensitive).\n    Non-alphabetic characters are ignored.\n    \"\"\"\n    count = 0\n    for i, char in enumerate(text):\n        if 'a' <= char.lower() <= 'z':\n            # Calculate 1-based alphabetical position\n            alpha_pos = ord(char.lower()) - ord('a') + 1\n            # Compare with 1-based string position\n            if alpha_pos == i + 1:\n                count += 1\n    return count"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n):\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Returns 1 if n is less than or equal to 0.\n    \"\"\"\n    if n <= 0:\n        return 1\n\n    n -= 1\n    # Fill all bits to the right of the most significant bit.\n    n |= n >> 1\n    n |= n >> 2\n    n |= n >> 4\n    n |= n >> 8\n    n |= n >> 16\n    n |= n >> 32 # Covers up to 64-bit integers.\n\n    return n + 1"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(items: list[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list whose bitwise XOR is an even number.\n    The algorithm uses nested loops, resulting in O(n^2) time complexity.\n    \"\"\"\n    count = 0\n    n = len(items)\n    for i in range(n):\n        for j in range(i + 1, n):\n            # The XOR of two numbers is even if both numbers have the same parity (both even or both odd).\n            # This can be checked by comparing the LSB of each number, or by checking if (num ^ num2) % 2 == 0.\n            # (num % 2) == 0 for even, (num % 2) == 1 for odd.\n            # If items[i] % 2 == items[j] % 2, then their XOR will be even.\n            if (items[i] % 2) == (items[j] % 2):\n                count += 1\n    return count"}
