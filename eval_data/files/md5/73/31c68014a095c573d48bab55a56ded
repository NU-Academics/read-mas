{"task_id": "Mbpp/119", "solution": "from typing import List, Optional\nfrom collections import Counter\n\ndef search(arr: List[int]) -> Optional[int]:\n    \"\"\"\n    Find the element that appears only once in a sorted array where\n    all other elements appear exactly twice. Returns None if input is invalid.\n    \"\"\"\n\n    def _is_sorted(arr_param: List[int]) -> bool:\n        \"\"\"Return True if arr_param is sorted in non-decreasing order.\"\"\"\n        return all(arr_param[i] <= arr_param[i + 1] for i in range(len(arr_param) - 1))\n\n    def _validate_counts(arr_param: List[int]) -> bool:\n        \"\"\"Verify that exactly one element appears once and all others appear twice.\"\"\"\n        counts = Counter(arr_param)\n        unique = [v for v, c in counts.items() if c == 1]\n        duplicates = [v for v, c in counts.items() if c == 2]\n        return len(unique) == 1 and len(duplicates) == len(counts) - 1\n\n    def _find_unique(arr_param: List[int]) -> Optional[int]:\n        \"\"\"Binary search to locate the unique element in O(log n) time.\"\"\"\n        left, right = 0, len(arr_param) - 1\n        while left < right:\n            mid = (left + right) // 2\n            # Ensure mid is at the start of a potential pair (even index)\n            if mid % 2 == 1:\n                mid -= 1\n            if arr_param[mid] == arr_param[mid + 1]:\n                # The pair is at mid and mid+1, so the unique element is to the right.\n                left = mid + 2\n            else:\n                # The unique element is at or before mid.\n                right = mid\n        return arr_param[left]\n\n    if not arr:\n        return None\n    if not _is_sorted(arr):\n        return None\n    if not _validate_counts(arr):\n        return None\n    \n    return _find_unique(arr)"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(upper_bound: int) -> int:\n    \"\"\"\n    Computes the sum of all amicable numbers less than or equal to `upper_bound`.\n    Assumes `upper_bound` is a positive integer for performance.\n    \"\"\"\n    divisor_sum: list[int] = [0] * (upper_bound + 1)\n    for i in range(1, upper_bound // 2 + 1):\n        for j in range(2 * i, upper_bound + 1, i):\n            divisor_sum[j] += i\n\n    amicable_numbers: set[int] = set()\n    for a in range(2, upper_bound + 1):\n        b = divisor_sum[a]\n        if b > a and b <= upper_bound and divisor_sum[b] == a:\n            amicable_numbers.add(a)\n            amicable_numbers.add(b)\n\n    return sum(amicable_numbers)"}
