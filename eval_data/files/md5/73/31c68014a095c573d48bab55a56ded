{"task_id": "Mbpp/96", "solution": "from math import isqrt\n\ndef divisor(n: int) -> int:\n    \"\"\"Calculates the number of positive divisors for a given integer.\n    Handles zero input by raising ValueError and processes absolute values.\n    \"\"\"\n    if n == 0:\n        raise ValueError(\"Input must be non\u2011zero.\")\n\n    n = abs(n)\n    count: int = 0\n    limit: int = isqrt(n)\n\n    for i in range(1, limit + 1):\n        if n % i == 0:\n            count += 2  # Each divisor 'i' has a corresponding divisor 'n // i'\n    if limit * limit == n:\n        count -= 1  # If 'n' is a perfect square, its square root was counted twice\n\n    return count"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers):\n    \"\"\"\n    Multiplies all numbers in a list and divides the product by the length of the list.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input sequence cannot be empty.\")\n\n    product = 1\n    for num in numbers:\n        product *= num\n    \n    return product / len(numbers)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(value: int) -> str:\n    \"\"\"Converts a non-negative decimal integer to its binary string representation without leading zeros.\"\"\"\n    if value == 0:\n        return '0'\n\n    binary_string = ''\n    while value > 0:\n        remainder = value % 2\n        binary_string = str(remainder) + binary_string\n        value //= 2\n    return binary_string"}
{"task_id": "Mbpp/101", "solution": "def kth_element(array: List[Any], k: int) -> Any:\n    \"\"\"\n    Return the element at the k-th position (1\u2011based) from the given array.\n    \"\"\"\n    if not array:\n        raise ValueError(\"Array must contain at least one element.\")\n\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer.\")\n\n    if k < 1 or k > len(array):\n        raise IndexError(f\"k={k} is out of bounds for array of length {len(array)}.\")\n\n    return array[k - 1]"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome greater than the input integer.\n    Delegates the core logic to an internal PalindromeService.\n    \"\"\"\n    class PalindromeService:\n        \"\"\"\n        Internal service containing the core logic for finding the next smallest palindrome.\n        \"\"\"\n        def _is_palindrome(self, num: int) -> bool:\n            \"\"\"Checks if an integer is a palindrome.\"\"\"\n            s = str(num)\n            return s == s[::-1]\n\n        def next_smallest_palindrome(self, input_num: int) -> int:\n            \"\"\"\n            Calculates the next smallest palindrome strictly greater than input_num.\n            It increments from input_num + 1 until a palindrome is found.\n            \"\"\"\n            current_number = input_num + 1\n            while True:\n                if self._is_palindrome(current_number):\n                    return current_number\n                current_number += 1\n    \n    service = PalindromeService()\n    return service.next_smallest_palindrome(n)"}
