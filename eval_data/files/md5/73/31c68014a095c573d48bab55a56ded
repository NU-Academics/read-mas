{"task_id": "Mbpp/635", "solution": "def heap_sort(input_list):\n    class Heap:\n        def __init__(self, data=None):\n            self.heap = []\n            if data is not None:\n                self.build_heap(data)\n\n        def _heapify_down(self, i):\n            n = len(self.heap)\n            smallest = i\n            left_child = 2 * i + 1\n            right_child = 2 * i + 2\n\n            if left_child < n and self.heap[left_child] < self.heap[smallest]:\n                smallest = left_child\n            if right_child < n and self.heap[right_child] < self.heap[smallest]:\n                smallest = right_child\n\n            if smallest != i:\n                self.heap[i], self.heap[smallest] = self.heap[smallest], self.heap[i]\n                self._heapify_down(smallest)\n\n        def _heapify_up(self, i):\n            parent = (i - 1) // 2\n            while i > 0 and self.heap[i] < self.heap[parent]:\n                self.heap[i], self.heap[parent] = self.heap[parent], self.heap[i]\n                i = parent\n                parent = (i - 1) // 2\n\n        def build_heap(self, data):\n            self.heap = list(data)\n            n = len(self.heap)\n            for i in range(n // 2 - 1, -1, -1):\n                self._heapify_down(i)\n\n        def extract_min(self):\n            if not self.heap:\n                return None\n\n            min_val = self.heap[0]\n            self.heap[0] = self.heap[-1]\n            self.heap.pop()\n            if self.heap:\n                self._heapify_down(0)\n            return min_val\n\n        def insert(self, item):\n            self.heap.append(item)\n            self._heapify_up(len(self.heap) - 1)\n\n        def __len__(self):\n            return len(self.heap)\n\n    if not input_list:\n        return []\n\n    heap_instance = Heap(input_list)\n\n    sorted_result = []\n    while len(heap_instance) > 0:\n        sorted_result.append(heap_instance.extract_min())\n\n    return sorted_result"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers, n):\n    \"\"\"\n    Calculates the sum of XORs of all unique unordered pairs of numbers in a list.\n    Handles validation of input length and returns 0 for lists with fewer than two elements.\n    \"\"\"\n    if n != len(numbers):\n        raise ValueError(\"Input 'n' must be equal to the length of the 'numbers' list.\")\n\n    if len(numbers) < 2:\n        return 0\n\n    total_xor_sum = 0\n    for i in range(len(numbers)):\n        for j in range(i + 1, len(numbers)):\n            total_xor_sum += (numbers[i] ^ numbers[j])\n\n    return total_xor_sum"}
