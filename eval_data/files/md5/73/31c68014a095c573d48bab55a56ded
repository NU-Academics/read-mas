{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr):\n    \"\"\"\n    Counts the number of inversions in the given array using a modified merge sort algorithm.\n    An inversion is a pair (arr[i], arr[j]) such that i < j and arr[i] > arr[j].\n    \"\"\"\n\n    def merge_sort_and_count(sub_arr):\n        # Base case: an array with 0 or 1 element has no inversions and is already sorted.\n        if len(sub_arr) <= 1:\n            return sub_arr, 0\n\n        mid = len(sub_arr) // 2\n        left_half, inv_left = merge_sort_and_count(sub_arr[:mid])\n        right_half, inv_right = merge_sort_and_count(sub_arr[mid:])\n\n        merged_arr = []\n        inv_merge = 0\n        i = j = 0\n\n        # Merge the two sorted halves and count inversions during merging\n        while i < len(left_half) and j < len(right_half):\n            if left_half[i] <= right_half[j]:\n                merged_arr.append(left_half[i])\n                i += 1\n            else:\n                # If an element from the right half is smaller, it forms inversions\n                # with all remaining elements in the left_half\n                merged_arr.append(right_half[j])\n                inv_merge += len(left_half) - i\n                j += 1\n\n        # Add any remaining elements\n        merged_arr.extend(left_half[i:])\n        merged_arr.extend(right_half[j:])\n\n        total_inversions = inv_left + inv_right + inv_merge\n        return merged_arr, total_inversions\n\n    _, inversion_count = merge_sort_and_count(arr)\n    return inversion_count"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list):\n    \"\"\"\n    Flattens an arbitrarily nested list into a single, one-dimensional list.\n    Preserves the order of elements from the original nested structure.\n    \"\"\"\n    flattened = []\n    \n    def _flatten_recursive(current_list):\n        for item in current_list:\n            if isinstance(item, list):\n                _flatten_recursive(item)\n            else:\n                flattened.append(item)\n\n    _flatten_recursive(nested_list)\n    return flattened"}
{"task_id": "Mbpp/299", "solution": "from typing import List, Tuple\n\ndef max_aggregate(input_list: List[Tuple[str, int]]) -> Tuple[str, int]:\n    \"\"\"\n    Calculate the maximum aggregate score per name from a list of tuples.\n    Returns the name with the highest aggregate score and that aggregate.\n    \"\"\"\n    score_map = {}\n    for name, score in input_list:\n        score_map[name] = score_map.get(name, 0) + score\n\n    max_name = max(score_map, key=score_map.get)\n    max_score = score_map[max_name]\n\n    return max_name, max_score"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(data):\n    \"\"\"\n    Calculates the maximum depth of a nested dictionary.\n    Returns 1 for an empty dictionary or a dictionary with no nested dictionaries.\n    \"\"\"\n    if not data:\n        return 1\n\n    child_depths = [dict_depth(v) for v in data.values() if isinstance(v, dict)]\n\n    return 1 + (max(child_depths) if child_depths else 0)"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Calculates the count of binary sequences of length 2n where the sum of\n    the first n bits equals the sum of the last n bits.\n    \"\"\"\n    if n == 0:\n        return 1\n    \n    total_count = 0\n    for k in range(n + 1):\n        # Calculate C(n, k)\n        combinations_nk = math.comb(n, k)\n        # Add C(n, k)^2 to the total count\n        total_count += combinations_nk * combinations_nk\n        \n    return total_count"}
