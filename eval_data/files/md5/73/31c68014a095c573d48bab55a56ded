{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers, target_sum):\n    \"\"\"Counts unordered pairs in a list whose sum equals a target value.\"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    The sum is for (2k-1)^4 where k ranges from 1 to n.\n    \"\"\"\n    total_sum = 0\n    for k in range(1, n + 1):\n        odd_num = 2 * k - 1\n        total_sum += odd_num ** 4\n    return total_sum"}
{"task_id": "Mbpp/765", "solution": "import math\n\ndef get_nth_polite_number(n: int) -> int:\n    \"\"\"\n    Computes the nth polite number using the formula n + floor(log2(n)).\n    A polite number is a positive integer that is not a power of two.\n    \"\"\"\n    if n < 1:\n        raise ValueError(\"n must be a positive integer.\")\n    \n    # The nth polite number is n plus the count of powers of two less than or equal to n.\n    # This count is floor(log2(n)).\n    return n + math.floor(math.log2(n))"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced parentheses, brackets, and braces.\n    Uses a stack to track opening symbols and match them with closing symbols.\n    \"\"\"\n    stack = []\n    mapping = {\")\": \"(\", \"}\": \"{\", \"]\": \"[\"}\n    opening_brackets = set(\"([{\")\n\n    for char in expression:\n        if char in opening_brackets:\n            stack.append(char)\n        elif char in mapping:\n            if not stack or stack.pop() != mapping[char]:\n                return False\n    \n    return not stack"}
{"task_id": "Mbpp/769", "solution": "def Diff(firstList: List[int], secondList: List[int]) -> List[int]:\n    \"\"\"\n    Calculates the difference between two lists, preserving order and applying a special re-ordering rule.\n    The element at index 1 of the original first list, if present in the difference, is moved to the end.\n    \"\"\"\n    \n    # Manually create a frequency map for elements in secondList to handle duplicates during subtraction.\n    second_list_counts = {}\n    for item in secondList:\n        second_list_counts[item] = second_list_counts.get(item, 0) + 1\n\n    pre_ordered_result = []\n    \n    # Variables to track the value of the element originally at firstList[1]\n    # and its index in the `pre_ordered_result` list if it is included in the difference.\n    element_at_original_index_1_val = None\n    index_of_original_first_list_item_1_in_pre_result = -1 \n\n    # If firstList has at least two elements, store the value at its second position (index 1).\n    if len(firstList) > 1:\n        element_at_original_index_1_val = firstList[1]\n\n    # Iterate through the first list to build the difference, preserving relative order.\n    for i, item in enumerate(firstList):\n        if second_list_counts.get(item, 0) > 0:\n            # If the current item is in secondList and its occurrences still need to be subtracted,\n            # decrement its count and do not add it to the result.\n            second_list_counts[item] -= 1\n        else:\n            # If the item is not in secondList, or all its corresponding occurrences have been subtracted,\n            # add it to the temporary result list.\n            pre_ordered_result.append(item)\n            \n            # If this item is the specific one that was originally at firstList[1]\n            # and it has been kept (not subtracted), record its new position in `pre_ordered_result`.\n            if i == 1 and item == element_at_original_index_1_val:\n                index_of_original_first_list_item_1_in_pre_result = len(pre_ordered_result) - 1\n\n    # Apply the special re-ordering rule: move the element that was originally at firstList[1] to the end.\n    # This happens only if that specific element was present in firstList[1] and was kept in the difference.\n    if index_of_original_first_list_item_1_in_pre_result != -1:\n        moved_item = pre_ordered_result.pop(index_of_original_first_list_item_1_in_pre_result)\n        pre_ordered_result.append(moved_item)\n        \n    return pre_ordered_result"}
