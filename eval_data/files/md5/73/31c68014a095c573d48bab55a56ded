{"task_id": "Mbpp/141", "solution": "from copy import deepcopy\nfrom typing import List, TypeVar\n\nT = TypeVar('T')\n\nclass PancakeSortService:\n    \"\"\"\n    Encapsulates the pancake sorting algorithm.\n    \"\"\"\n    def sort(self, lst: List[T]) -> List[T]:\n        \"\"\"\n        Returns a new list containing all elements of `lst` sorted in ascending order.\n        The original list is not modified.\n        \"\"\"\n        arr = deepcopy(lst)\n        n = len(arr)\n        for curr_size in range(n, 1, -1):\n            max_index = max(range(curr_size), key=arr.__getitem__)\n            if max_index != curr_size - 1:\n                self._flip(arr, max_index)\n                self._flip(arr, curr_size - 1)\n        return arr\n\n    @staticmethod\n    def _flip(arr: List[T], k: int) -> None:\n        \"\"\"\n        Reverses the sublist arr[0..k] in place.\n        \"\"\"\n        left, right = 0, k\n        while left < right:\n            arr[left], arr[right] = arr[right], arr[left]\n            left += 1\n            right -= 1\n\ndef pancake_sort(lst: List[T]) -> List[T]:\n    \"\"\"\n    Public API that creates a service instance and returns a sorted copy of the input list.\n    \"\"\"\n    service = PancakeSortService()\n    return service.sort(lst)"}
