{"task_id": "HumanEval/3", "solution": "def below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    balance = 0\n    for operation in operations:\n        balance += operation\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    if number <= 0:\n        raise ValueError(\"Input number must be positive.\")\n\n    # Internal helper class to encapsulate number decomposition logic.\n    class Number:\n        def __init__(self, value: float):\n            self._value = value\n            self._integer_part = int(value)\n            self._decimal_part = value - self._integer_part\n\n        def get_decimal_part(self) -> float:\n            return self._decimal_part\n\n    num_obj = Number(number)\n    return num_obj.get_decimal_part()"}
{"task_id": "HumanEval/3", "solution": "from typing import List\n\n\nclass Account:\n    \"\"\"Manages the current account balance and determines if it has fallen below zero.\"\"\"\n    def __init__(self):\n        self._balance: int = 0\n\n    def apply_operation(self, operation_value: int) -> None:\n        \"\"\"Adds the operation_value to the current balance.\"\"\"\n        self._balance += operation_value\n\n    def is_below_zero(self) -> bool:\n        \"\"\"Returns True if the current balance is less than zero, False otherwise.\"\"\"\n        return self._balance < 0\n\n\nclass Operation:\n    \"\"\"Encapsulates a single financial operation's value.\"\"\"\n    def __init__(self, value: int):\n        self._value: int = value\n\n    def get_value(self) -> int:\n        \"\"\"Returns the integer value of the operation.\"\"\"\n        return self._value\n\n\nclass BalanceChecker:\n    \"\"\"Iterates through a list of operations, applying them to an Account, and detects if the balance ever falls below zero.\"\"\"\n    def check(self, operations_list: List[int]) -> bool:\n        \"\"\"Processes the list of integer operations and returns True if the account balance falls below zero at any point.\"\"\"\n        account = Account()\n        for op_value in operations_list:\n            operation = Operation(op_value)\n            account.apply_operation(operation.get_value())\n            if account.is_below_zero():\n                return True\n        return False\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    checker = BalanceChecker()\n    return checker.check(operations)"}
