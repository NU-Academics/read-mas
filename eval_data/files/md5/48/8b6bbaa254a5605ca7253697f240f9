{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\"\"\"\n\n    def _is_increasing(l: list) -> bool:\n        \"\"\"Checks if a list is monotonically increasing (non-decreasing).\"\"\"\n        for i in range(1, len(l)):\n            if l[i] < l[i-1]:\n                return False\n        return True\n\n    def _is_decreasing(l: list) -> bool:\n        \"\"\"Checks if a list is monotonically decreasing (non-increasing).\"\"\"\n        for i in range(1, len(l)):\n            if l[i] > l[i-1]:\n                return False\n        return True\n\n    return _is_increasing(l) or _is_decreasing(l)"}
{"task_id": "HumanEval/57", "solution": "def _is_monotonically_increasing(l: list) -> bool:\n    \"\"\"Helper to check if a list is monotonically increasing (non-decreasing).\"\"\"\n    for i in range(1, len(l)):\n        if l[i] < l[i-1]:\n            return False\n    return True\n\ndef _is_monotonically_decreasing(l: list) -> bool:\n    \"\"\"Helper to check if a list is monotonically decreasing (non-increasing).\"\"\"\n    for i in range(1, len(l)):\n        if l[i] > l[i-1]:\n            return False\n    return True\n\ndef monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\"\"\"\n    return _is_monotonically_increasing(l) or _is_monotonically_decreasing(l)"}
