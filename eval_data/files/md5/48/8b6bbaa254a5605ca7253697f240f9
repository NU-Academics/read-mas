{"task_id": "HumanEval/59", "solution": "import math\n\ndef largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n\n    # Handle factor 2.\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Iterate odd factors from 3 up to sqrt(n).\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n\n    # If n is still greater than 1, it must be the largest prime factor itself.\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    \"\"\"\n    if not xs:\n        return []\n    \n    # The derivative of a constant term (xs[0]) is 0.\n    # For xs[i] * x^i, the derivative is xs[i] * i * x^(i-1).\n    # So, the new coefficients start from the original xs[1] term.\n    \n    # Skip the constant term (index 0).\n    # Iterate from index 1 up to the end of the list.\n    # The new coefficient for x^(i-1) will be xs[i] * i.\n    \n    result = []\n    for i in range(1, len(xs)):\n        result.append(xs[i] * i)\n        \n    return result"}
{"task_id": "HumanEval/63", "solution": "_fibfib_memo = {}\n\ndef fibfib(n: int):\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if n in _fibfib_memo:\n        return _fibfib_memo[n]\n\n    if n == 0:\n        result = 0\n    elif n == 1:\n        result = 0\n    elif n == 2:\n        result = 1\n    else:\n        result = fibfib(n-1) + fibfib(n-2) + fibfib(n-3)\n    \n    _fibfib_memo[n] = result\n    return result"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    \"\"\"\n    if len(xs) <= 1:\n        return []\n\n    derived_coefficients = []\n    for i in range(1, len(xs)):\n        derived_coefficients.append(xs[i] * i)\n    return derived_coefficients"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    \"\"\"\n    count = 0\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n    \n    s_lower = s.lower()\n    \n    for char in s_lower:\n        if char in standard_vowels:\n            count += 1\n            \n    if len(s) > 0 and s_lower.endswith('y'):\n        count += 1\n            \n    return count"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n    \"\"\"\n    count = 0\n    s_lower = s.lower()\n    n = len(s_lower)\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    for i, char in enumerate(s_lower):\n        if char in standard_vowels:\n            count += 1\n        elif char == 'y' and i == n - 1:\n            count += 1\n    return count"}
{"task_id": "HumanEval/63", "solution": "_memo = {}\n\ndef fibfib(n: int):\n    \"\"\"Computes the n-th element of the fibfib number sequence efficiently using memoization.\n    Raises ValueError if n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input n must be a non-negative integer.\")\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    if n in _memo:\n        return _memo[n]\n\n    result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n    _memo[n] = result\n    return result"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    \n    # Determine if the number is negative and get its absolute string representation for digit manipulation.\n    is_negative = x < 0\n    s_x_abs = str(abs(x))\n    num_digits = len(s_x_abs)\n\n    if shift > num_digits:\n        # If shift is greater than the number of digits, reverse the digits.\n        result_digits = s_x_abs[::-1]\n    else:\n        # Perform a circular right shift by calculating the effective shift.\n        # A shift of `num_digits` positions results in the original sequence (effective_shift = 0).\n        effective_shift = shift % num_digits\n        result_digits = s_x_abs[num_digits - effective_shift:] + s_x_abs[:num_digits - effective_shift]\n    \n    # Prepend the sign if the original number was negative.\n    if is_negative:\n        return \"-\" + result_digits\n    else:\n        return result_digits"}
{"task_id": "HumanEval/65", "solution": "class Digits:\n    \"\"\"Encapsulates the string representation of an integer's digits and provides methods for digit manipulation.\"\"\"\n    def __init__(self, x: int):\n        self._sequence = str(x)\n        self._length = len(self._sequence)\n\n    def get_sequence(self) -> str:\n        \"\"\"Returns the current digit sequence as a string.\"\"\"\n        return self._sequence\n\n    def get_length(self) -> int:\n        \"\"\"Returns the number of digits.\"\"\"\n        return self._length\n\n    def perform_circular_right_shift(self, shift_value: int) -> None:\n        \"\"\"Performs a circular right shift on the digits by shift_value positions.\"\"\"\n        if self._length == 0: return\n        effective_shift = shift_value % self._length\n        self._sequence = self._sequence[-effective_shift:] + self._sequence[:-effective_shift]\n\n    def reverse_order(self) -> None:\n        \"\"\"Reverses the order of the digits.\"\"\"\n        self._sequence = self._sequence[::-1]\n\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    digits_obj = Digits(x)\n    num_digits = digits_obj.get_length()\n\n    if shift > num_digits:\n        digits_obj.reverse_order()\n    else:\n        digits_obj.perform_circular_right_shift(shift)\n\n    return digits_obj.get_sequence()"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII codes of only the uppercase characters in the input string.\n    Returns 0 if no uppercase characters are found or if the string is empty.\"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
