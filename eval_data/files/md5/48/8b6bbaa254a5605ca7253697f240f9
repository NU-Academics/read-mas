{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    longest_palindromic_postfix_len = 0\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            longest_palindromic_postfix_len = len(suffix)\n            break\n\n    prefix_to_reverse = string[:-longest_palindromic_postfix_len]\n    return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/11", "solution": "class BinaryString:\n    \"\"\"Encapsulates a binary string, ensuring its validity and providing XOR logic.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n        if not self.isValidBinaryContent():\n            raise ValueError(\"Input string must contain only '0's and '1's.\")\n\n    def isValidBinaryContent(self) -> bool:\n        \"\"\"Checks if the string consists only of '0's and '1's.\"\"\"\n        return all(c in '01' for c in self._value)\n\n    def getLength(self) -> int:\n        \"\"\"Returns the length of the binary string.\"\"\"\n        return len(self._value)\n\n    def performXOR(self, other: 'BinaryString') -> 'BinaryString':\n        \"\"\"Performs a bitwise XOR operation with another BinaryString object.\"\"\"\n        result_chars = []\n        for char_a, char_b in zip(self._value, other._value):\n            if char_a == char_b:\n                result_chars.append('0')\n            else:\n                result_chars.append('1')\n        return BinaryString(\"\".join(result_chars))\n\n    def getValue(self) -> str:\n        \"\"\"Returns the raw string value of the BinaryString.\"\"\"\n        return self._value\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    bin_a = BinaryString(a)\n    bin_b = BinaryString(b)\n\n    if bin_a.getLength() != bin_b.getLength():\n        raise ValueError(\"Input strings must be of equal length.\")\n\n    result_bin_string = bin_a.performXOR(bin_b)\n    return result_bin_string.getValue()"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result = []\n    # Iterate through the strings, assuming they are of equal length and valid characters ('0', '1').\n    for i in range(len(a)):\n        if a[i] != b[i]:\n            result.append('1')\n        else:\n            result.append('0')\n    return \"\".join(result)"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n    None\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    max_length = -1\n    longest_string = None\n\n    for s in strings:\n        current_length = len(s)\n        if current_length > max_length:\n            max_length = current_length\n            longest_string = s\n\n    return longest_string"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_found: Optional[str] = None\n    max_length: int = -1\n\n    for s in strings:\n        current_length = len(s)\n        if current_length > max_length:\n            max_length = current_length\n            longest_found = s\n\n    return longest_found"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    # Implements the Euclidean algorithm to find the greatest common divisor.\n    # It ensures the result is always non-negative, as per the conventional definition.\n    while b != 0:\n        a, b = b, a % b\n    return abs(a)"}
