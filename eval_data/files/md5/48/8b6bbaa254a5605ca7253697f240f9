{"task_id": "HumanEval/101", "solution": "def words_string(s):\n    \"\"\"\n    Splits a string into words, using commas or spaces as delimiters.\n    Handles multiple consecutive delimiters and trims leading/trailing delimiters.\n    \"\"\"\n    # Replace all commas with spaces to unify delimiters\n    s_processed = s.replace(\",\", \" \")\n    # Split the string by spaces, and then filter out any empty strings\n    words = [word for word in s_processed.split(\" \") if word]\n    return words"}
{"task_id": "HumanEval/99", "solution": "import math\n\ndef closest_integer(value):\n    '''\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n    '''\n    numeric_value = float(value)\n\n    floor_val = math.floor(numeric_value)\n    ceil_val = math.ceil(numeric_value)\n\n    dist_to_floor = abs(numeric_value - floor_val)\n    dist_to_ceil = abs(numeric_value - ceil_val)\n\n    if dist_to_floor < dist_to_ceil:\n        return int(floor_val)\n    elif dist_to_ceil < dist_to_floor:\n        return int(ceil_val)\n    else: # Equidistant, apply round away from zero rule.\n        if numeric_value >= 0:\n            return int(ceil_val)\n        else:\n            return int(floor_val)"}
{"task_id": "HumanEval/101", "solution": "def words_string(s):\n    \"\"\"\n    Splits a string into words, using commas or spaces as delimiters.\n    Returns a list of extracted words.\n    \"\"\"\n    # Replace all commas with spaces, then split by whitespace\n    # Using split() without arguments handles multiple spaces and removes empty strings.\n    return s.replace(',', ' ').split()"}
