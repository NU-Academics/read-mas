{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x == 0:\n        return '0'\n\n    res = \"\"\n    while x > 0:\n        res = str(x % base) + res\n        x //= base\n    return res"}
{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    class Triangle:\n        \"\"\"Represents a triangle and encapsulates its dimensions and area calculation.\"\"\"\n        def __init__(self, side_length: float, height: float):\n            self.side_length = side_length\n            self.height = height\n\n        def calculate_area(self) -> float:\n            \"\"\"Calculates the area of the triangle.\"\"\"\n            return (self.side_length * self.height) / 2\n\n    triangle = Triangle(a, h)\n    return triangle.calculate_area()"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    This function computes the n-th element of the fib4 number sequence efficiently using an iterative approach.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # Initialize the four previous values for fib4(0), fib4(1), fib4(2), fib4(3)\n    # a = fib4(i-4), b = fib4(i-3), c = fib4(i-2), d = fib4(i-1)\n    a, b, c, d = 0, 0, 2, 0\n\n    for _ in range(4, n + 1):\n        next_fib4 = a + b + c + d\n        # Shift values for the next iteration\n        a = b\n        b = c\n        c = d\n        d = next_fib4\n    \n    return d"}
{"task_id": "HumanEval/47", "solution": "```python\ndef median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        median_value = sorted_l[n // 2]\n    else:\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        median_value = (mid1 + mid2) / 2\n\n    # Return integer if median is a whole number, else float.\n    if median_value == int(median_value):\n        return int(median_value)\n    else:\n        return float(median_value)\n```"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"Computes the n-th element of the Fib4 number sequence iteratively.\n    Handles base cases and efficiently calculates terms using a rolling window.\"\"\"\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer.\")\n    elif n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n    \n    # Initialize the four preceding values for n=4.\n    # f_n_minus_4 = fib4(0)\n    # f_n_minus_3 = fib4(1)\n    # f_n_minus_2 = fib4(2)\n    # f_n_minus_1 = fib4(3)\n    f_n_minus_4, f_n_minus_3, f_n_minus_2, f_n_minus_1 = 0, 0, 2, 0\n\n    # Iterate from n=4 up to the desired n.\n    for _ in range(4, n + 1):\n        current_fib4 = f_n_minus_4 + f_n_minus_3 + f_n_minus_2 + f_n_minus_1\n        # Shift the values to prepare for the next iteration.\n        f_n_minus_4 = f_n_minus_3\n        f_n_minus_3 = f_n_minus_2\n        f_n_minus_2 = f_n_minus_1\n        f_n_minus_1 = current_fib4\n    \n    return f_n_minus_1"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    This uses exponentiation by squaring to handle large n efficiently.\n    \"\"\"\n    result = 1\n    base = 2 % p # Initialize base and ensure it's within modulo range\n    \n    # Handle the case where n is 0 directly, result is 1 for any p > 0\n    if n == 0:\n        return 1\n\n    # Main loop for exponentiation by squaring\n    while n > 0:\n        if n % 2 == 1: # If n is odd, multiply result by current base\n            result = (result * base) % p\n        base = (base * base) % p # Square the base\n        n //= 2 # Halve n\n\n    return result"}
