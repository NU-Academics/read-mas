{"task_id": "HumanEval/98", "solution": "def count_upper(s):\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n    \n    For example:\n    count_upper('aBCdEf') returns 1\n    count_upper('abcdefg') returns 0\n    count_upper('dBBE') returns 0\n    \"\"\"\n    def _is_uppercase_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is an uppercase vowel (A, E, I, O, U).\"\"\"\n        return char in ('A', 'E', 'I', 'O', 'U')\n\n    count = 0\n    for index, char in enumerate(s):\n        if index % 2 == 0:\n            if _is_uppercase_vowel(char):\n                count += 1\n    return count"}
{"task_id": "HumanEval/96", "solution": "import math\n\ndef _is_prime(number: int) -> bool:\n    \"\"\"Checks if a given integer is a prime number.\"\"\"\n    if number < 2:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    # Check for divisors from 3 up to the square root of the number, only odd numbers.\n    for i in range(3, int(math.sqrt(number)) + 1, 2):\n        if number % i == 0:\n            return False\n    return True\n\ndef count_up_to(n: int) -> list[int]:\n    \"\"\"Returns a list of prime numbers strictly less than n.\"\"\"\n    primes = []\n    if n <= 2:  # No primes less than or equal to 2\n        return primes\n    \n    # Iterate from 2 up to n-1 to find primes\n    for i in range(2, n):\n        if _is_prime(i):\n            primes.append(i)\n    return primes"}
{"task_id": "HumanEval/98", "solution": "def count_upper(s):\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n    \n    For example:\n    count_upper('aBCdEf') returns 1\n    count_upper('abcdefg') returns 0\n    count_upper('dBBE') returns 0\n    \"\"\"\n    count = 0\n    uppercase_vowels = {'A', 'E', 'I', 'O', 'U'}\n\n    for i in range(len(s)):\n        if i % 2 == 0:\n            char = s[i]\n            if char in uppercase_vowels:\n                count += 1\n    return count"}
