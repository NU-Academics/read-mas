t_group)\n                start_index = -1\n        return groups\n\n    cleaned_string = _clean_string(paren_string)\n    separated_groups = _find_top_level_groups(cleaned_string)\n    return separated_groups"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    data_mean = sum(numbers) / len(numbers)\n    absolute_differences = [abs(x - data_mean) for x in numbers]\n    mad = sum(absolute_differences) / len(absolute_differences)\n    return mad"}
{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = [numbers[0]]\n    for i in range(1, len(numbers)):\n        result.append(delimeter)\n        result.append(numbers[i])\n    return result"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef _calculate_single_group_nesting(group_expression: str) -> int:\n    \"\"\"Calculates the maximum nesting level for a single string of parentheses.\"\"\"\n    current_level = 0\n    max_level = 0\n    for char in group_expression:\n        if char == '(':\n            current_level += 1\n            max_level = max(max_level, current_level)\n        elif char == ')':\n            current_level -= 1\n    return max_level\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    groups = [group for group in paren_string.split(' ') if group]\n\n    results = []\n    for group_expression in groups:\n        nesting_level = _calculate_single_group_nesting(group_expression)\n        results.append(nesting_level)\n\n    return results"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n\n    class _NumberListProcessor:\n        \"\"\"Helper class to encapsulate the state and logic for Mean Absolute Deviation calculation.\"\"\"\n\n        def __init__(self, numbers_list: List[float]):\n            \"\"\"Initializes the processor with the list of numbers.\"\"\"\n            self._numbers: List[float] = numbers_list\n            self._mean: float = 0.0\n            self._absolute_differences: List[float] = []\n\n        def _calculate_mean(self) -> float:\n            \"\"\"Calculates the mean of the input numbers and stores it.\"\"\"\n            if not self._numbers:\n                self._mean = 0.0\n            else:\n                self._mean = sum(self._numbers) / len(self._numbers)\n            return self._mean\n\n        def _calculate_absolute_differences(self) -> List[float]:\n            \"\"\"Calculates absolute differences from the stored mean and stores them.\"\"\"\n            self._absolute_differences = [abs(number - self._mean) for number in self._numbers]\n            return self._absolute_differences\n\n        def calculate_mad(self) -> float:\n            \"\"\"Orchestrates the calculation steps and returns the final Mean Absolute Deviation.\"\"\"\n            if not self._numbers:\n                return 0.0  # Returns 0.0 for an empty list.\n\n            self._calculate_mean()\n            self._calculate_absolute_differences()\n\n            return sum(self._absolute_differences) / len(self._absolute_differences)\n\n    processor = _NumberListProcessor(numbers)\n    return processor.calculate_mad()"}
{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
