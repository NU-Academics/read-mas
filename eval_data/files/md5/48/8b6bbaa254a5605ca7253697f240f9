{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\"\"\"\n\n    def _is_divisible_by_11_or_13(num: int) -> bool:\n        \"\"\"Checks if a number is divisible by 11 or 13.\"\"\"\n        return (num % 11 == 0) or (num % 13 == 0)\n\n    def _count_digit_seven(num: int) -> int:\n        \"\"\"Counts the occurrences of the digit '7' in a number.\"\"\"\n        return str(num).count('7')\n\n    total_count = 0\n    for i in range(1, n):\n        if _is_divisible_by_11_or_13(i):\n            total_count += _count_digit_seven(i)\n\n    return total_count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    # Extract values from even indices\n    even_indexed_values = [l[i] for i in range(0, len(l), 2)]\n    # Sort the extracted even values\n    even_indexed_values.sort()\n\n    # Create a new list to store the result\n    result_list = [None] * len(l)\n    even_val_idx = 0\n\n    # Populate the result list, preserving odd indices and inserting sorted even values\n    for i in range(len(l)):\n        if i % 2 == 0:  # Even index\n            result_list[i] = even_indexed_values[even_val_idx]\n            even_val_idx += 1\n        else:  # Odd index\n            result_list[i] = l[i]\n\n    return result_list"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    # Create a shallow copy of the input list to serve as the base for the result.\n    result_list = list(l)\n    \n    # Collect all elements from even indices of the original list.\n    even_elements_values = []\n    for i in range(len(l)):\n        if i % 2 == 0:\n            even_elements_values.append(l[i])\n            \n    # Sort the collected even-indexed values in ascending order.\n    even_elements_values.sort()\n    \n    # Replace the elements at even indices in the result list with the sorted values.\n    sorted_idx_pointer = 0\n    for i in range(len(result_list)):\n        if i % 2 == 0:\n            result_list[i] = even_elements_values[sorted_idx_pointer]\n            sorted_idx_pointer += 1\n            \n    return result_list"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n\n    def _is_divisible_by_11(num: int) -> bool:\n        \"\"\"Checks if num is divisible by 11.\"\"\"\n        return num % 11 == 0\n\n    def _is_divisible_by_13(num: int) -> bool:\n        \"\"\"Checks if num is divisible by 13.\"\"\"\n        return num % 13 == 0\n\n    def _count_digit_7(num: int) -> int:\n        \"\"\"Counts how many times the digit '7' appears in num.\"\"\"\n        return str(num).count('7')\n\n    total_count = 0\n    for i in range(1, n):\n        if _is_divisible_by_11(i) or _is_divisible_by_13(i):\n            total_count += _count_digit_7(i)\n    return total_count"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # Split the string into groups of three characters.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # Reverse the cyclic shift for groups of three, otherwise keep them as is.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    class FibonacciSequenceGenerator:\n        def __init__(self):\n            self._a = 0\n            self._b = 1\n\n        def generate_next(self) -> int:\n            current_fib = self._a\n            self._a, self._b = self._b, self._a + self._b\n            return current_fib\n\n    class PrimeChecker:\n        def is_prime(self, number: int) -> bool:\n            if number < 2:\n                return False\n            if number == 2:\n                return True\n            if number % 2 == 0:\n                return False\n            i = 3\n            while i * i <= number:\n                if number % i == 0:\n                    return False\n                i += 2\n            return True\n\n    class PrimeFibonacciFinder:\n        def __init__(self, fib_generator: FibonacciSequenceGenerator, prime_checker: PrimeChecker):\n            self._fib_generator = fib_generator\n            self._prime_checker = prime_checker\n\n        def find_nth(self, n: int) -> int:\n            prime_fib_count = 0\n            while True:\n                fib_number = self._fib_generator.generate_next()\n                if fib_number < 2:\n                    continue\n                if self._prime_checker.is_prime(fib_number):\n                    prime_fib_count += 1\n                    if prime_fib_count == n:\n                        return fib_number\n\n    fib_generator = FibonacciSequenceGenerator()\n    prime_checker = PrimeChecker()\n    finder = PrimeFibonacciFinder(fib_generator, prime_checker)\n    return finder.find_nth(n)"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    import math\n\n    def _is_prime(num: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    def _generate_fibonacci_numbers():\n        \"\"\"Generates an infinite sequence of Fibonacci numbers.\"\"\"\n        a, b = 0, 1\n        while True:\n            yield a\n            a, b = b, a + b\n\n    found_primes_count = 0\n    for fib_num in _generate_fibonacci_numbers():\n        if fib_num < 2: # Skip 0 and 1, as they are not prime\n            continue\n        \n        if _is_prime(fib_num):\n            found_primes_count += 1\n            if found_primes_count == n:\n                return fib_num"}
