{"task_id": "HumanEval/3", "solution": "class Account:\n    \"\"\"Manages the current balance of a bank account.\"\"\"\n    def __init__(self) -> None:\n        self._balance: int = 0\n\n    def update_balance(self, amount: int) -> None:\n        \"\"\"Adds the given amount to the current balance.\"\"\"\n        self._balance += amount\n\n    def get_balance(self) -> int:\n        \"\"\"Returns the current balance.\"\"\"\n        return self._balance\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"Detects if at any point the bank account balance falls below zero.\n    The account starts with a zero balance.\"\"\"\n    account = Account()\n    for op_value in operations:\n        account.update_balance(op_value)\n        if account.get_balance() < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    result = []\n    if not numbers:\n        return result\n\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    \"\"\"\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    # Helper to calculate the arithmetic mean of a list of numbers.\n    def _calculate_mean(nums: List[float]) -> float:\n        return sum(nums) / len(nums)\n\n    # Helper to calculate absolute differences from the mean for each number.\n    def _calculate_absolute_differences(nums: List[float], mean: float) -> List[float]:\n        return [abs(x - mean) for x in nums]\n\n    # Calculate the mean of the input numbers.\n    data_mean = _calculate_mean(numbers)\n\n    # Calculate the absolute differences between each number and the mean.\n    abs_diffs = _calculate_absolute_differences(numbers, data_mean)\n\n    # Calculate the mean of these absolute differences to get the MAD.\n    mad_value = sum(abs_diffs) / len(abs_diffs)\n    return mad_value"}
{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/1", "solution": "```python\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    def _clean_input_string(s: str) -> str:\n        \"\"\"Removes all space characters from the input string.\"\"\"\n        return s.replace(' ', '')\n\n    cleaned_string = _clean_input_string(paren_string)\n    result = []\n    balance_count = 0\n    current_group_start = -1\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            if balance_count == 0:\n                current_group_start = i\n            balance_count += 1\n        elif char == ')':\n            balance_count -= 1\n            if balance_count == 0 and current_group_start != -1:\n                result.append(cleaned_string[current_group_start : i + 1])\n                current_group_start = -1 # Reset for the next group\n    return result\n```"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef _calculate_group_nesting(group_string: str) -> int:\n    \"\"\"\n    Calculates the deepest level of nesting for a single group of parentheses.\n    E.g. '(()())' -> 2, '((()))' -> 3, '()' -> 1\n    \"\"\"\n    current_nesting = 0\n    max_nesting = 0\n    for char in group_string:\n        if char == '(':\n            current_nesting += 1\n            max_nesting = max(max_nesting, current_nesting)\n        elif char == ')':\n            current_nesting -= 1\n    return max_nesting\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    groups = paren_string.split(' ')\n\n    results: List[int] = []\n    for group_string in groups:\n        if not group_string:\n            continue\n        nesting_level = _calculate_group_nesting(group_string)\n        results.append(nesting_level)\n\n    return results"}
{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    import math\n\n    def _validate_positive(number: float) -> None:\n        \"\"\"Validates if the given number is positive. Raises ValueError if not.\"\"\"\n        if number <= 0:\n            raise ValueError(\"Input must be a positive number.\")\n\n    def _get_integer_part(number: float) -> int:\n        \"\"\"Calculates the integer part of a positive floating-point number.\"\"\"\n        return math.floor(number)\n\n    _validate_positive(number)\n    integer_part = _get_integer_part(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    longest_palindromic_postfix_len = 0\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            longest_palindromic_postfix_len = len(suffix)\n            break\n\n    prefix_to_reverse = string[:len(string) - longest_palindromic_postfix_len]\n    return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    def _validate_binary_string(s: str) -> None:\n        \"\"\"Ensures the string consists only of '0's and '1's.\"\"\"\n        for char in s:\n            if char not in ('0', '1'):\n                raise ValueError(\"Input strings must consist only of '0's and '1's.\")\n\n    def _xor_char(char_a: str, char_b: str) -> str:\n        \"\"\"Performs XOR on two single binary characters.\"\"\"\n        return '0' if char_a == char_b else '1'\n\n    _validate_binary_string(a)\n    _validate_binary_string(b)\n\n    if len(a) != len(b):\n        raise ValueError(\"Input strings must be of equal length.\")\n\n    result_chars = []\n    for i in range(len(a)):\n        result_chars.append(_xor_char(a[i], b[i]))\n\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_max_list: List[int] = []\n    current_max = float('-inf')\n\n    for number in numbers:\n        if number > current_max:\n            current_max = number\n        rolling_max_list.append(current_max)\n\n    return rolling_max_list"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_so_far: Optional[str] = None\n    max_length: int = -1\n\n    for s in strings:\n        current_length = len(s)\n        if current_length > max_length:\n            max_length = current_length\n            longest_so_far = s\n\n    return longest_so_far"}
{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    # Generate a list of strings for numbers from 0 to n.\n    # Join these strings with a space delimiter.\n    return ' '.join(str(i) for i in range(n + 1))"}
{"task_id": "HumanEval/14", "solution": "def all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string \"\"\"\n    prefixes = []\n    for i in range(1, len(string) + 1):\n        prefixes.append(string[:i])\n    return prefixes"}
{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    distinct_chars = set()\n    for char in string:\n        distinct_chars.add(char.lower())\n    return len(distinct_chars)"}
{"task_id": "HumanEval/17", "solution": "def parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n    \"\"\"\n    NOTE_BEAT_MAPPING = {\n        'o': 4,\n        'o|': 2,\n        '.|': 1\n    }\n    \n    # Split the music string into individual note symbols.\n    note_symbols = music_string.split(' ')\n    \n    # Map each symbol to its corresponding beat duration.\n    beat_durations = [NOTE_BEAT_MAPPING[symbol] for symbol in note_symbols]\n    \n    return beat_durations"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlaping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n    if not string:\n        return 0\n    if not substring:\n        return len(string) + 1\n\n    count = 0\n    for i in range(len(string) - len(substring) + 1):\n        if string[i:i+len(substring)] == substring:\n            count += 1\n    return count"}
{"task_id": "HumanEval/19", "solution": "from typing import List, Dict, Tuple\n\n\n_NUMERAL_WORD_MAP: Dict[str, int] = {\n    'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n    'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n}\n\n_VALUE_WORD_MAP: Dict[int, str] = {\n    0: 'zero', 1: 'one', 2: 'two', 3: 'three', 4: 'four',\n    5: 'five', 6: 'six', 7: 'seven', 8: 'eight', 9: 'nine'\n}\n\ndef _split_words(numbers_string: str) -> List[str]:\n    \"\"\"Splits the input string into a list of individual words.\"\"\"\n    return numbers_string.split(' ')\n\ndef _map_words_to_values(words: List[str], word_map: Dict[str, int]) -> List[Tuple[int, str]]:\n    \"\"\"Maps valid words to (numerical_value, original_word) tuples.\"\"\"\n    mapped_list = []\n    for word in words:\n        value = word_map[word]\n        mapped_list.append((value, word))\n    return mapped_list\n\ndef _sort_values(mapped_words: List[Tuple[int, str]]) -> List[Tuple[int, str]]:\n    \"\"\"Sorts a list of (numerical_value, original_word) tuples based on numerical value.\"\"\"\n    return sorted(mapped_words)\n\ndef _join_words(sorted_mapped_words: List[Tuple[int, str]], value_map: Dict[int, str]) -> str:\n    \"\"\"Converts sorted (numerical_value, original_word) tuples back to words and joins them.\"\"\"\n    result_words = []\n    for value, _original_word in sorted_mapped_words:\n        result_words.append(value_map[value])\n    return ' '.join(result_words)\n\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    words = _split_words(numbers)\n    mapped_values = _map_words_to_values(words, _NUMERAL_WORD_MAP)\n    sorted_values = _sort_values(mapped_values)\n    sorted_words_string = _join_words(sorted_values, _VALUE_WORD_MAP)\n    return sorted_words_string"}
{"task_id": "HumanEval/22", "solution": "def filter_integers(values: List[Any]) -> List[int]:\n    \"\"\" Filter given list of any python values only for integers\n    >>> filter_integers(['a', 3.14, 5])\n    [5]\n    >>> filter_integers([1, 2, 3, 'abc', {}, []])\n    [1, 2, 3]\n    \"\"\"\n    result_integers: List[int] = []\n    for element in values:\n        if isinstance(element, int):\n            result_integers.append(element)\n    return result_integers"}
