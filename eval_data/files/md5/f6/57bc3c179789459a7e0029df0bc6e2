{"task_id": "HumanEval/3", "solution": "from typing import List\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates a string of multiple balanced parenthesis groups into a list of individual group strings.\n    Spaces are ignored, and groups are not nested within each other.\n    \"\"\"\n    cleaned_string = paren_string.replace(\" \", \"\")\n    result = []\n    current_group_start_index = 0\n    balance = 0\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        if balance == 0 and i >= current_group_start_index:\n            result.append(cleaned_string[current_group_start_index : i + 1])\n            current_group_start_index = i + 1\n\n    return result"}
{"task_id": "HumanEval/3", "solution": "from typing import List\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"Detects if a bank account balance, starting at zero, ever falls below zero.\n    Returns True if balance ever drops below zero, False otherwise.\"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\"Given a non-negative floating point number, return its fractional part.\n\n    Examples:\n    >>> truncate_number(3.5)\n    0.5\n    >>> truncate_number(2.0)\n    0.0\n    \"\"\"\n    if not isinstance(number, (int, float)):\n        raise TypeError(\"number must be an int or float\")\n    if number < 0:\n        raise ValueError(\"number must be non-negative\")\n\n    import math\n    frac, _ = math.modf(float(number))\n    # Normalize negative zero to positive zero\n    return 0.0 if frac == 0.0 else frac"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    if paren_string is None:\n        raise TypeError(\"Input cannot be None\")\n\n    groups: List[str] = []\n    current: List[str] = []\n    balance: int = 0\n\n    for ch in paren_string:\n        if ch == ' ':\n            continue\n        if ch == '(':\n            current.append(ch)\n            balance += 1\n        elif ch == ')':\n            if balance == 0:\n                raise ValueError(\"Unbalanced parentheses: closing without matching opening\")\n            current.append(ch)\n            balance -= 1\n            if balance == 0:\n                groups.append(\"\".join(current))\n                current = []\n        else:\n            # invalid character encountered\n            raise ValueError(f\"Invalid character encountered: {ch!r}\")\n\n    if balance != 0:\n        raise ValueError(\"Unbalanced parentheses: some openings are not closed\")\n\n    return groups"}
{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    # Validate threshold\n    if not isinstance(threshold, (int, float)):\n        raise TypeError(\"threshold must be a number\")\n    if threshold < 0:\n        raise ValueError(\"threshold must be non-negative\")\n\n    # Ensure numbers is iterable and convert to list\n    try:\n        nums = list(numbers)\n    except TypeError:\n        raise TypeError(\"numbers must be an iterable of numeric values\")\n\n    if len(nums) < 2:\n        return False\n\n    # Ensure elements are numeric\n    for x in nums:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"elements of numbers must be int or float\")\n\n    # Sort a copy to avoid mutating input\n    try:\n        nums_sorted = sorted(nums)\n    except TypeError as e:\n        raise TypeError(\"elements of numbers must be mutually comparable numeric types\") from e\n\n    # Check adjacent differences\n    for a, b in zip(nums_sorted, nums_sorted[1:]):\n        if abs(b - a) < threshold:\n            return True\n\n    return False"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"numbers must be a non-empty list\")\n\n    mean = sum(numbers) / len(numbers)\n    absolute_differences = [abs(x - mean) for x in numbers]\n    mad = sum(absolute_differences) / len(numbers)\n    return mad"}
{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Input is a string containing multiple groups of parentheses separated by whitespace.\n    For each group, return the maximum nesting depth of parentheses.\n\n    Raises:\n        ValueError: If any group contains invalid characters or has unbalanced parentheses.\n    \"\"\"\n    if not paren_string or paren_string.strip() == \"\":\n        return []\n\n    result: List[int] = []\n    groups = paren_string.split()  # splits on any whitespace, ignores extra spaces\n\n    for group in groups:\n        current_depth = 0\n        max_depth = 0\n        for ch in group:\n            if ch == \"(\":\n                current_depth += 1\n                if current_depth > max_depth:\n                    max_depth = current_depth\n            elif ch == \")\":\n                current_depth -= 1\n                if current_depth < 0:\n                    raise ValueError(f\"Unbalanced parentheses in group: {group!r} (too many ')').\")\n            else:\n                raise ValueError(f\"Invalid character {ch!r} in group: {group!r}; expected only '(' or ')'.\")\n        if current_depth != 0:\n            raise ValueError(f\"Unbalanced parentheses in group: {group!r} (mismatched '(').\")\n        result.append(max_depth)\n\n    return result"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"numbers must contain at least one element\")\n\n    import math\n\n    n = len(numbers)\n    mean = math.fsum(float(x) for x in numbers) / n\n    sum_abs_diff = math.fsum(abs(float(x) - mean) for x in numbers)\n    return sum_abs_diff / n"}
{"task_id": "HumanEval/7", "solution": "from typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Parses a string of parenthetical groups, computing the maximum nesting depth for each.\n    Raises ValueError for invalid characters or mismatched parentheses.\n    \"\"\"\n    if not paren_string.strip():\n        return []\n\n    groups = paren_string.split()\n    result = []\n\n    for group in groups:\n        current_depth = 0\n        max_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n                if current_depth < 0:\n                    raise ValueError(f\"Mismatched parentheses: Too many closing parentheses in group '{group}'\")\n            else:\n                raise ValueError(f\"Invalid character '{char}' found in group '{group}'. Only '(' and ')' are allowed.\")\n\n        if current_depth != 0:\n            raise ValueError(f\"Mismatched parentheses: Unmatched opening parentheses in group '{group}'\")\n\n        result.append(max_depth)\n\n    return result"}
{"task_id": "HumanEval/7", "solution": "from typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/9", "solution": "from typing import List\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    result: List[int] = []\n    current_max = float('-inf')\n    for n in numbers:\n        if n > current_max:\n            current_max = n\n        result.append(current_max)\n    return result"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"For a given list of integers, return a tuple consisting of a sum and a product.\n    Empty sum is 0 and empty product is 1.\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n    return total_sum, total_product"}
{"task_id": "HumanEval/9", "solution": "from typing import List\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = []\n    current_max = numbers[0]\n    for n in numbers:\n        if n > current_max:\n            current_max = n\n        result.append(current_max)\n    return result"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\"Find the shortest palindrome that begins with a supplied string.\n    Algorithm: find the smallest k (0..n) such that string[k:] is a palindrome,\n    then append the reverse of string[:k] to the end of string.\n    \"\"\"\n    n = len(string)\n    for k in range(n + 1):\n        suffix = string[k:]\n        if suffix == suffix[::-1]:\n            return string + string[:k][::-1]\n    return string  # fallback (unreachable)"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\"Perform binary XOR on two equal-length binary strings.\n    Returns the result as a string, assuming inputs consist only of '0's and '1's.\n    \"\"\"\n    return ''.join('0' if x == y else '1' for x, y in zip(a, b))"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\"Find the shortest palindrome that begins with a supplied string.\n\n    The function appends the minimum number of characters to the end of the\n    input so that the resulting string is a palindrome that starts with the\n    original string.\n\n    Approach: Let rev be the reverse of string. Compute the LPS (longest proper\n    prefix which is also a suffix) array for the concatenation rev + '#' + string.\n    The last value of that LPS gives the length of the longest palindromic\n    suffix of the original string. Append the reverse of the remaining prefix.\n\n    Examples:\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    n = len(string)\n    if n <= 1:\n        return string\n\n    rev = string[::-1]\n    concat = rev + \"#\" + string\n\n    # Compute LPS (prefix function) for concat\n    lps = [0] * len(concat)\n    for i in range(1, len(concat)):\n        j = lps[i - 1]\n        while j > 0 and concat[i] != concat[j]:\n            j = lps[j - 1]\n        if concat[i] == concat[j]:\n            j += 1\n        lps[i] = j\n\n    longest_palindromic_suffix_len = lps[-1]\n    prefix_to_add = string[: n - longest_palindromic_suffix_len]\n    return string + prefix_to_add[::-1]"}
