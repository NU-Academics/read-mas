{"task_id": "HumanEval/25", "solution": "def factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each factor is listed as many times as it appears in the factorization.\n    The product of returned factors equals the input n. For n == 1 returns an empty list.\n    Raises:\n        TypeError: if n is not an int\n        ValueError: if n < 1\n    Examples:\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n\n    factors: List[int] = []\n    if n == 1:\n        return factors\n\n    # Extract factors of 2\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Extract odd factors\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            factors.append(i)\n            n //= i\n        i += 2\n\n    # If remainder is >1, it's a prime\n    if n > 1:\n        factors.append(n)\n\n    return factors"}
{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n <= 1:\n        raise ValueError(\"n must be greater than 1\")\n\n    import math\n\n    if n % 2 == 0:\n        return n // 2\n\n    limit = math.isqrt(n)\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return n // i\n\n    return 1"}
{"task_id": "HumanEval/25", "solution": "from typing import List\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\"Return prime factors of n in ascending order, with multiplicity.\n\n    For n == 1 returns an empty list.\n\n    Raises:\n        TypeError: if n is not an int.\n        ValueError: if n <= 0.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n    if n == 1:\n        return []\n\n    factors: List[int] = []\n\n    # Handle factor 2 separately to allow skipping even numbers later\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Test odd factors from 3 upwards\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            factors.append(i)\n            n //= i\n        i += 2\n\n    # If remaining n is > 1, it's prime\n    if n > 1:\n        factors.append(n)\n\n    return factors"}
{"task_id": "HumanEval/26", "solution": "from typing import List\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    result: List[int] = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n    return result"}
{"task_id": "HumanEval/26", "solution": "def remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\"From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    if numbers is None:\n        return []\n\n    try:\n        from collections import Counter\n        counts = Counter(numbers)\n        return [x for x in numbers if counts[x] == 1]\n    except TypeError:\n        # Fallback for unhashable elements\n        result = []\n        for item in numbers:\n            count = 0\n            for y in numbers:\n                if item == y:\n                    count += 1\n                    if count > 1:\n                        break\n            if count == 1:\n                result.append(item)\n        return result"}
