{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum number of elements to change to make the array palindromic.\n    It counts mismatched pairs from the start and end of the array.\n    \"\"\"\n    changes = 0\n    n = len(arr)\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes"}
{"task_id": "HumanEval/71", "solution": "def triangle_area(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle, return the area rounded\n    to 2 decimal points if they form a valid triangle. Otherwise return -1.\n    \"\"\"\n    # Validate types (reject bool) and positivity\n    for side in (a, b, c):\n        if isinstance(side, bool) or not isinstance(side, (int, float)):\n            return -1\n        if side <= 0:\n            return -1\n\n    # Triangle inequality: sum of any two sides must be greater than the third\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1\n\n    # Heron's formula\n    s = (a + b + c) / 2.0\n    area_sq = s * (s - a) * (s - b) * (s - c)\n\n    # Numerical stability: clamp tiny negative values caused by floating point errors\n    if area_sq < 0:\n        if area_sq > -1e-12:\n            area_sq = 0.0\n        else:\n            return -1\n\n    import math\n    area = math.sqrt(area_sq)\n    return round(area, 2)"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Return True if a is the product of exactly three prime factors (counting multiplicity).\"\"\"\n    if not isinstance(a, int) or a < 2:\n        return False\n\n    count = 0\n    n = a\n\n    d = 2\n    while d * d <= n:\n        while n % d == 0:\n            count += 1\n            n //= d\n            if count > 3:\n                return False\n        d = 3 if d == 2 else d + 2  # after 2, test only odd divisors\n\n    if n > 1:\n        count += 1\n\n    return count == 3"}
