{"task_id": "HumanEval/99", "solution": "def closest_integer(value):\n    \"\"\"\n    Creates a function that takes a string representing a number and returns the closest integer.\n    Ties are rounded away from zero.\n    \"\"\"\n    def _custom_floor(x):\n        # int() truncates toward zero. For positives it's floor, for negatives it is ceil.\n        res = int(x)\n        return res if res == x or x >= 0 else res - 1\n\n    float_val = float(value)\n    abs_float_val = abs(float_val)\n\n    # Implement rounding half away from zero by rounding the absolute value,\n    # then reapplying the original sign.\n    rounded_abs_val = _custom_floor(abs_float_val + 0.5)\n\n    return rounded_abs_val if float_val >= 0 else -rounded_abs_val"}
{"task_id": "HumanEval/101", "solution": "def words_string(s):\n    \"\"\"\n    Splits a string of words separated by commas or spaces into a list of words.\n    First, replaces commas with spaces, then splits by whitespace.\n    \"\"\"\n    s_modified = s.replace(',', ' ')\n    words = s_modified.split()\n    return words"}
{"task_id": "HumanEval/102", "solution": "def choose_num(x, y):\n    \"\"\"This function finds the biggest even integer in the range [x, y] inclusive.\n    Returns -1 if no such number exists.\n    \"\"\"\n    # Ensure we handle cases where x > y\n    if x > y:\n        return -1\n\n    # Start from y and move down to x, returning the first even number found\n    for num in range(y, x - 1, -1):\n        if num % 2 == 0:\n            return num\n    return -1"}
{"task_id": "HumanEval/102", "solution": "def choose_num(x, y):\n    \"\"\"Return the biggest even integer in the inclusive range [x, y], or -1 if none exists.\"\"\"\n    import math\n\n    if not isinstance(x, (int, float)) or not isinstance(y, (int, float)):\n        raise TypeError(\"x and y must be int or float\")\n    if not (math.isfinite(x) and math.isfinite(y)):\n        raise ValueError(\"x and y must be finite numbers\")\n\n    if x > y:\n        return -1\n\n    upper = math.floor(y)\n    if upper % 2 != 0:\n        upper -= 1\n\n    if upper < x:\n        return -1\n\n    return int(upper)"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"Computes the rounded average of integers from n to m, returns as a binary string.\n    Returns -1 if n > m.\"\"\"\n    if n > m:\n        return -1\n\n    s = n + m\n    quotient, remainder = divmod(s, 2)\n\n    if remainder == 0:\n        # Average is an exact integer\n        result = quotient\n    else:\n        # Average is X.5, apply ties-to-nearest-even rule\n        if quotient % 2 == 0:\n            result = quotient\n        else:\n            result = quotient + 1\n\n    return bin(result)"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all\n    elements that hasn't any even digit.\n    \"\"\"\n\n    result = []\n    for num in x:\n        has_even = False\n        # Convert number to string to easily check each digit\n        s_num = str(num)\n        for char_digit in s_num:\n            digit = int(char_digit)\n            if digit % 2 == 0:\n                has_even = True\n                break  # Found an even digit, no need to check further for this number\n\n        if not has_even:\n            result.append(num)\n\n    result.sort()  # Sort the qualifying numbers in increasing order\n    return result"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"Computes the bankers-rounded average of integers from n to m, then returns its binary string.\n    If n is greater than m, it returns -1.\"\"\"\n    if n > m:\n        return -1\n\n    s = n + m\n    if s % 2 == 0:\n        avg = s // 2\n    else:\n        k = s // 2  # This is the integer part before .5\n        if k % 2 == 0:\n            avg = k  # Round down if integer part is even (bankers rounding)\n        else:\n            avg = k + 1  # Round up if integer part is odd (bankers rounding)\n\n    return bin(avg)"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x, return a sorted list of all\n    elements that have no even digits.\n    \"\"\"\n    result = []\n    for num in x:\n        n = abs(num)\n        # Treat 0 as having an even digit (0)\n        if n == 0:\n            continue\n        has_even_digit = False\n        while n > 0:\n            if (n % 10) % 2 == 0:\n                has_even_digit = True\n                break\n            n //= 10\n        if not has_even_digit:\n            result.append(num)\n    return sorted(result)"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Filters integers 1-9, sorts descending, then maps to names.\n    Handles None input and ignores invalid types or out-of-range numbers.\n    \"\"\"\n    if arr is None:\n        return []\n\n    # 2. Filter: keep only integers between 1 and 9 (inclusive), excluding booleans.\n    filtered_numbers = []\n    for x in arr:\n        if isinstance(x, int) and not isinstance(x, bool) and 1 <= x <= 9:\n            filtered_numbers.append(x)\n\n    # 3. Sort the filtered list in ascending order.\n    filtered_numbers.sort()\n\n    # 4. Reverse the sorted list to obtain descending order.\n    filtered_numbers.reverse()\n\n    # 5. Map each integer to its corresponding name.\n    name_map = {\n        1: 'One', 2: 'Two', 3: 'Three', 4: 'Four', 5: 'Five',\n        6: 'Six', 7: 'Seven', 8: 'Eight', 9: 'Nine'\n    }\n\n    result_names = []\n    for num in filtered_numbers:\n        result_names.append(name_map[num])\n\n    # 6. Return the list of mapped names, preserving duplicates.\n    return result_names"}
{"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\"\n    Implements the function f that takes n and returns a list of size n.\n    Elements are factorial(i) if i is even, or sum(1..i) if i is odd (1-based index).\n    \"\"\"\n    result = []\n    current_sum = 0\n    current_factorial = 1\n    for i in range(1, n + 1):\n        current_sum += i\n        current_factorial *= i\n\n        if i % 2 == 0:  # i is even\n            result.append(current_factorial)\n        else:  # i is odd\n            result.append(current_sum)\n    return result"}
{"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\"\n    Generates a list of size n, where elements are factorials for even 1-based indices\n    and sums of numbers from 1 to i for odd 1-based indices.\n    \"\"\"\n    def _factorial(k):\n        \"\"\"Calculates the factorial of k iteratively.\"\"\"\n        res = 1\n        for j in range(1, k + 1):\n            res *= j\n        return res\n\n    def _sum_up_to(k):\n        \"\"\"Calculates the sum of numbers from 1 to k using a formula.\"\"\"\n        return k * (k + 1) // 2\n\n    result = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:\n            result.append(_factorial(i))\n        else:\n            result.append(_sum_up_to(i))\n    return result"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Counts even and odd integer palindromes within the range 1..n (inclusive).\n    Returns a tuple (even_count, odd_count).\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    for i in range(1, n + 1):\n        s = str(i)\n        if s == s[::-1]:  # Check if the number is a palindrome\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Counts even and odd integer palindromes within the range [1, n].\n    Returns a tuple (even_count, odd_count).\n    \"\"\"\n    even_palindromes = 0\n    odd_palindromes = 0\n\n    for i in range(1, n + 1):\n        s = str(i)\n        if s == s[::-1]:  # Check if the number is a palindrome\n            if i % 2 == 0:\n                even_palindromes += 1\n            else:\n                odd_palindromes += 1\n\n    return (even_palindromes, odd_palindromes)"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts elements in an array where the sum of signed digits is greater than 0.\n    For negative numbers, the most significant digit is negative; others are positive.\n    \"\"\"\n    count = 0\n    for n in arr:\n        current_sum = 0\n        is_negative = n < 0\n        s = str(abs(n))\n\n        if not s:  # robustness, though str(abs(int)) is never empty\n            continue\n\n        # Handle the most significant digit\n        first_digit_val = int(s[0])\n        if is_negative:\n            current_sum -= first_digit_val\n        else:\n            current_sum += first_digit_val\n\n        # Sum remaining digits (always positive)\n        for char_digit in s[1:]:\n            current_sum += int(char_digit)\n\n        if current_sum > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Return True if arr can be sorted in non-decreasing order by any number of right cyclic shifts.\"\"\"\n    if not arr:\n        return True\n\n    n = len(arr)\n    descent_count = 0\n    for i in range(n):\n        if arr[i] > arr[(i + 1) % n]:\n            descent_count += 1\n            if descent_count > 1:\n                return False\n    return True"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Determines if an array can be made non-decreasing by right circular shifts.\n    The list is guaranteed to have unique elements.\n    \"\"\"\n    n = len(arr)\n\n    if n == 0:\n        return True\n\n    disorder_count = 0\n    # Count the number of times arr[i] > arr[i+1]\n    for i in range(n - 1):\n        if arr[i] > arr[i+1]:\n            disorder_count += 1\n            # If more than one such point is found, it's not cyclically sorted\n            if disorder_count > 1:\n                return False\n\n    # If disorder_count is 0, the array is already sorted.\n    if disorder_count == 0:\n        return True\n\n    # If disorder_count is 1, check the wrap-around condition:\n    # The last element must be less than or equal to the first element\n    # for a single rotation to sort the array.\n    if arr[n-1] <= arr[0]:\n        return True\n\n    # If disorder_count is 1 but arr[n-1] > arr[0], it's not possible.\n    return False"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if lst1 can be made entirely of even numbers by exchanging elements with lst2.\n    It checks if the total count of even numbers across both lists is sufficient to fill lst1.\"\"\"\n\n    total_even_count = 0\n    for num in lst1:\n        if num % 2 == 0:\n            total_even_count += 1\n    for num in lst2:\n        if num % 2 == 0:\n            total_even_count += 1\n\n    if total_even_count >= len(lst1):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/111", "solution": "def histogram(test):\n    \"\"\"Compute frequencies of space-separated lowercase letters and return a dictionary of letters with the maximum count. If multiple letters tie for the maximum count, all are included.\"\"\"\n    tokens = test.split()\n\n    if not tokens:\n        return {}\n\n    counts = {}\n    for token in tokens:\n        counts[token] = counts.get(token, 0) + 1\n\n    if not counts:  # Should be covered by `if not tokens`, but safe guard.\n        return {}\n\n    max_count = 0\n    for count in counts.values():\n        if count > max_count:\n            max_count = count\n\n    # Alternatively: max_count = max(counts.values())\n\n    result = {}\n    for letter, count in counts.items():\n        if count == max_count:\n            result[letter] = count\n\n    return result"}
{"task_id": "HumanEval/111", "solution": "import collections\n\ndef histogram(test):\n    \"\"\"Given a string of space-separated lowercase letters, returns a dictionary\n    mapping the letter(s) with the highest occurrence to their counts.\n    If multiple letters tie for the highest count, all are returned.\n    \"\"\"\n    tokens = test.split()\n\n    if not tokens:\n        return {}\n\n    counter = collections.Counter(tokens)\n    max_count = max(counter.values())\n\n    result = {letter: count for letter, count in counter.items() if count == max_count}\n    return result"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if lst1 can be made all even by exchanging elements with lst2.\n    It checks if there are enough even numbers in the combined lists to fill lst1.\n    \"\"\"\n    total_even = sum(1 for x in lst1 if x % 2 == 0) + sum(1 for x in lst2 if x % 2 == 0)\n\n    if total_even >= len(lst1):\n        return \"YES\"\n    else:\n        return \"NO\""}
