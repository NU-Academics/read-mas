{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Calculates the special factorial: product of factorials from 1! to n!.\n    n must be a positive integer.\n    \"\"\"\n    special_fact = 1\n    current_factorial = 1\n    for i in range(1, n + 1):\n        current_factorial *= i\n        special_fact *= current_factorial\n    return special_fact"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    from decimal import Decimal, InvalidOperation\n\n    def _to_decimal(value):\n        if isinstance(value, int):\n            return Decimal(value)\n        if isinstance(value, float):\n            # Use string conversion to avoid binary floating artifacts\n            return Decimal(str(value))\n        if isinstance(value, str):\n            s = value.strip()\n            if not s:\n                raise ValueError(f\"Cannot parse empty string as number: {value!r}\")\n\n            # Handle sign\n            sign = ''\n            if s[0] in '+-':\n                sign = s[0]\n                s = s[1:]\n                if not s:\n                    raise ValueError(f\"Invalid numeric string: {value!r}\")\n\n            has_dot = '.' in s\n            has_comma = ',' in s\n            normalized = s\n\n            if has_dot and has_comma:\n                # Rightmost of '.' or ',' is decimal separator; the other(s) are thousands separators\n                if s.rfind('.') > s.rfind(','):\n                    # dot is decimal, remove commas\n                    normalized = s.replace(',', '')\n                else:\n                    # comma is decimal, remove dots and replace comma with dot\n                    normalized = s.replace('.', '').replace(',', '.')\n            elif has_dot or has_comma:\n                sep = '.' if has_dot else ','\n                count = s.count(sep)\n                if count > 1:\n                    # Multiple occurrences -> treat as thousands separators\n                    normalized = s.replace(sep, '')\n                else:\n                    before, after = s.split(sep)\n                    # Heuristic: if exactly 3 digits after and there are digits before, treat as thousands sep\n                    if len(after) == 3 and before:\n                        normalized = s.replace(sep, '')\n                    else:\n                        # Treat as decimal separator; if comma convert to dot\n                        if sep == ',':\n                            normalized = s.replace(',', '.')\n                        else:\n                            normalized = s\n            # Remove spaces that might be used as thousands separators\n            normalized = normalized.replace(' ', '')\n            normalized = sign + normalized\n            try:\n                return Decimal(normalized)\n            except InvalidOperation:\n                raise ValueError(f\"Cannot parse string to number: {value!r}\")\n        raise TypeError(f\"Unsupported type: {type(value).__name__}\")\n\n    dec_a = _to_decimal(a)\n    dec_b = _to_decimal(b)\n\n    if dec_a == dec_b:\n        return None\n    return a if dec_a > dec_b else b"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer (n > 0)\")\n\n    result = 1\n    curr_fact = 1\n    for i in range(1, n + 1):\n        curr_fact *= i\n        result *= curr_fact\n    return result"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces (i.e., 3 or more),\n    then replace all consecutive spaces in that run with a single hyphen.\n\n    Examples:\n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    import re\n\n    if not text:\n        return text\n\n    # Replace runs of 3 or more spaces with a single hyphen\n    text = re.sub(r' {3,}', '-', text)\n    # Replace any remaining single (or double) spaces with underscores\n    return text.replace(' ', '_')"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific rules.\n    Returns 'Yes' if valid, 'No' otherwise.\"\"\"\n\n    # Rule 2: Exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    prefix, suffix = file_name.split('.', 1)\n\n    # Rule 3: Substring before the dot non-empty and starts with an ASCII letter\n    if not prefix or not (('a' <= prefix[0] <= 'z') or ('A' <= prefix[0] <= 'Z')):\n        return 'No'\n\n    # Rule 4: Substring after the dot is one of ['txt', 'exe', 'dll']\n    if suffix not in ('txt', 'exe', 'dll'):\n        return 'No'\n\n    # Rule 1: No more than three digits in the entire file name\n    digit_count = sum(1 for ch in file_name if '0' <= ch <= '9')\n    if digit_count > 3:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Replaces spaces in text: single spaces become underscores,\n    and runs of 3 or more consecutive spaces become a single hyphen.\n    \"\"\"\n    result = []\n    space_count = 0\n    i = 0\n    while i < len(text):\n        if text[i] == ' ':\n            space_count += 1\n        else:\n            # Process any accumulated spaces before adding the current non-space character\n            if space_count > 0:\n                if space_count >= 3:\n                    result.append('-')\n                else:  # space_count is 1 or 2\n                    result.extend(['_'] * space_count)\n            result.append(text[i])\n            space_count = 0  # Reset space counter for non-space character\n        i += 1\n\n    # Process any trailing spaces at the end of the string\n    if space_count > 0:\n        if space_count >= 3:\n            result.append('-')\n        else:  # space_count is 1 or 2\n            result.extend(['_'] * space_count)\n\n    return \"\".join(result)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"\n    Checks if a file name is valid based on specific rules.\n    Returns 'Yes' if valid, 'No' otherwise.\n    \"\"\"\n    # Condition 1: There should not be more than three digits\n    digit_count = sum(1 for char in file_name if '0' <= char <= '9')\n    if digit_count > 3:\n        return 'No'\n\n    # Condition 2: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.split('.')\n    prefix = parts[0]\n    suffix = parts[1]\n\n    # Condition 3: The substring before the dot\n    # Should not be empty\n    if not prefix:\n        return 'No'\n    # Should start with a letter from the latin alphabet\n    if not ('a' <= prefix[0] <= 'z' or 'A' <= prefix[0] <= 'Z'):\n        return 'No'\n\n    # Condition 4: The substring after the dot should be one of these\n    valid_suffixes = ['txt', 'exe', 'dll']\n    if suffix not in valid_suffixes:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Applies transformations to list entries based on their index and returns the sum of the modified entries.\n    Indexes that are multiples of 3 result in squaring, while indexes that are multiples of 4 but not 3 result in cubing.\n    \"\"\"\n    total_sum = 0\n    for i, x in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += x * x\n        elif i % 4 == 0:  # This condition implies i % 3 != 0 due to the 'elif'\n            total_sum += x * x * x\n        else:\n            total_sum += x\n    return total_sum"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n    \"\"\"\n    total = 0\n    for i, v in enumerate(lst):\n        if i % 3 == 0:\n            transformed = v ** 2\n        elif i % 4 == 0:\n            transformed = v ** 3\n        else:\n            transformed = v\n        total += transformed\n    return total"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Returns a string of words from the sentence whose lengths are prime numbers.\n    The order of words is preserved.\n    \"\"\"\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    words = sentence.split()\n    prime_length_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    def is_prime(n):\n        if n < 2:\n            return False\n        if n % 2 == 0:\n            return n == 2\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split()\n    return \" \".join(w for w in words if is_prime(len(w)))"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"\n    Simplifies the expression x * n, returning True if the product is a whole number, False otherwise.\n    Both x and n are string representations of fractions.\n    \"\"\"\n    x_parts = x.split('/')\n    x_num = int(x_parts[0])\n    x_den = int(x_parts[1])\n\n    n_parts = n.split('/')\n    n_num = int(n_parts[0])\n    n_den = int(n_parts[1])\n\n    # Multiply the numerators and denominators\n    product_numerator = x_num * n_num\n    product_denominator = x_den * n_den\n\n    # Check if the resulting fraction is a whole number\n    return product_numerator % product_denominator == 0"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits (absolute value),\n    then by their original index for tie-breaking.\n    \"\"\"\n\n    def _sum_digits(n):\n        # Calculates the sum of digits for a number, treating negative numbers\n        # by their absolute value. Returns 0 for 0.\n        s = 0\n        n_abs = abs(n)\n        if n_abs == 0:\n            return 0\n        while n_abs > 0:\n            s += n_abs % 10\n            n_abs //= 10\n        return s\n\n    # Pair each number with its original index to use as a tie-breaker.\n    indexed_nums = [(num, i) for i, num in enumerate(nums)]\n\n    # Sort the indexed numbers. The primary key is the sum of digits (ascending).\n    # The secondary key is the original index (ascending) to handle ties.\n    indexed_nums.sort(key=lambda item: (_sum_digits(item[0]), item[1]))\n\n    # Extract and return the sorted numbers.\n    return [num for num, _ in indexed_nums]"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Checks if the product of two fraction strings is a whole number.\n    Fractions are given as \"numerator/denominator\" strings.\"\"\"\n    x_parts = x.split('/')\n    x_num = int(x_parts[0])\n    x_den = int(x_parts[1])\n\n    n_parts = n.split('/')\n    n_num = int(n_parts[0])\n    n_den = int(n_parts[1])\n\n    result_num = x_num * n_num\n    result_den = x_den * n_den\n\n    return result_num % result_den == 0"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Write a function which sorts the given list of integers\n    in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their index in original list.\n    \"\"\"\n    # Decorate with (digit_sum, original_index, value), sort, then extract values.\n    decorated = (\n        (sum(int(d) for d in str(abs(n))), i, n)\n        for i, n in enumerate(nums)\n    )\n    return [value for _, _, value in sorted(decorated)]"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts triples (i<j<k) where a[i]+a[j]+a[k] is a multiple of 3.\n    a[i] = i*i - i + 1.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    def combinations_3(x):  # Helper function for C(x, 3).\n        return x * (x - 1) * (x - 2) // 6 if x >= 3 else 0\n\n    # Count of a[i] % 3 == 0, which occurs when i % 3 == 2.\n    c0 = (n + 1) // 3\n\n    # Count of a[i] % 3 == 1, which occurs when i % 3 == 0 or i % 3 == 1.\n    c1 = n - c0\n\n    return combinations_3(c0) + combinations_3(c1)"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Return the number of triples (a[i], a[j], a[k]) with 1<=i<j<k<=n where\n    a[i] = i*i - i + 1 and a[i] + a[j] + a[k] is divisible by 3.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    q = n // 3\n    r = n % 3\n\n    # For i mod 3:\n    # i % 3 == 2 -> a[i] % 3 == 0\n    # i % 3 == 0 or 1 -> a[i] % 3 == 1\n    c0 = q + (1 if r >= 2 else 0)           # count of a-values \u2261 0 (from i \u2261 2)\n    c1 = 2 * q + (1 if r >= 1 else 0)       # count of a-values \u2261 1\n    # c2 is always 0\n\n    def comb3(x):\n        return x * (x - 1) * (x - 2) // 6 if x >= 3 else 0\n\n    return comb3(c0) + comb3(c1)"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets between planet1 and planet2, sorted by proximity to the sun.\n    Returns an empty tuple if planet1 or planet2 are not valid planet names.\n    \"\"\"\n    planets = (\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\")\n\n    if planet1 not in planets or planet2 not in planets:\n        return ()\n\n    index1 = planets.index(planet1)\n    index2 = planets.index(planet2)\n\n    if index1 < index2:\n        return planets[index1 + 1 : index2]\n    else:\n        return planets[index2 + 1 : index1]"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    Returns a tuple of planets between planet1 and planet2, sorted by proximity to the sun.\n    Returns an empty tuple if either input planet name is incorrect.\n    '''\n    planets = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n\n    if planet1 not in planets or planet2 not in planets:\n        return ()\n\n    idx1 = planets.index(planet1)\n    idx2 = planets.index(planet2)\n\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    result_list = planets[start_idx + 1:end_idx]\n    return tuple(result_list)"}
