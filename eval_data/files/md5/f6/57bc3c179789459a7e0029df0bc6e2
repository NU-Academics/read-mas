{"task_id": "HumanEval/115", "solution": "def max_fill(grid, capacity):\n    \"\"\"\n    You are given a rectangular grid of wells. Each row represents a single well,\n    and each 1 in a row represents a single unit of water.\n    Each well has a corresponding bucket that can be used to extract water from it,\n    and all buckets have the same capacity.\n    Your task is to use the buckets to empty the wells.\n    Output the number of times you need to lower the buckets.\n    \"\"\"\n    if not grid or capacity <= 0:\n        return 0\n\n    total_lowerings = 0\n    for well_row in grid:\n        water_in_well = sum(well_row)\n        if water_in_well > 0:\n            # ceil division without importing math\n            lowerings_for_well = (water_in_well + capacity - 1) // capacity\n            total_lowerings += lowerings_for_well\n    return total_lowerings"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n    \"\"\"\n    template = \"the number of odd elements in the string i of the input.\"\n    result = []\n    for s in lst:\n        count = sum(1 for ch in s if ch in \"13579\")\n        result.append(template.replace(\"i\", str(count)))\n    return result"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Given a list of digit strings, this function counts odd digits in each string.\n    It returns a list of transformed strings based on a specific template.\n    \"\"\"\n    template = \"the number of odd elements in the string i of the input.\"\n    out = []\n    for s in lst:\n        count = sum(1 for ch in s if ch in '13579')\n        count_str = str(count)\n        transformed = template.replace('i', count_str)\n        out.append(transformed)\n    return out"}
{"task_id": "HumanEval/115", "solution": "def max_fill(grid, capacity):\n    \"\"\"Calculates the total bucket lowers needed to empty wells.\n    Each row is a well; lowering a bucket extracts up to `capacity` water.\n    \"\"\"\n    if capacity < 1:\n        raise ValueError(\"capacity must be >= 1\")\n\n    total_lowers = 0\n\n    # Iterate through each well (row) in the grid.\n    for row in grid:\n        # Count the units of water (1s) in the current well.\n        units_in_well = sum(1 for cell in row if cell)\n\n        # If there's water, calculate lowers needed using integer ceiling division.\n        if units_in_well > 0:\n            lowers_for_well = (units_in_well + capacity - 1) // capacity\n            total_lowers += lowers_for_well\n\n    return total_lowers"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums.\n    \"\"\"\n    if not nums:\n        raise ValueError(\"Input list 'nums' cannot be empty.\")\n\n    current_min = nums[0]\n    global_min = nums[0]\n\n    for x in nums[1:]:\n        current_min = min(x, current_min + x)\n        global_min = min(global_min, current_min)\n\n    return global_min"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Returns words from string s that contain exactly n consonants.\n    Words are returned in their original order.\n    \"\"\"\n    result = []\n    vowels = {'a', 'e', 'i', 'o', 'u'}\n    words = s.split()\n\n    for word in words:\n        consonant_count = 0\n        for char in word:\n            # Assuming input string contains only letters and spaces,\n            # so every char in a word is a letter.\n            if char.lower() not in vowels:\n                consonant_count += 1\n\n        if consonant_count == n:\n            result.append(word)\n\n    return result"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, returns a list of words from s\n    that contain exactly n consonants, preserving their original order.\n    \"\"\"\n    if not s or not s.strip():\n        return []\n\n    words = s.split()\n    vowels = {'a', 'e', 'i', 'o', 'u'}\n    result = []\n\n    for word in words:\n        consonant_count = 0\n        for char in word:\n            char_lower = char.lower()\n            if char_lower.isalpha() and char_lower not in vowels:\n                consonant_count += 1\n\n        if consonant_count == n:\n            result.append(word)\n\n    return result"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    Sorts an array of integers by the number of set bits in ascending order.\n    Ties are broken by the numeric value of the integers in ascending order.\n    \"\"\"\n    return sorted(arr, key=lambda x: (x.bit_count(), x))"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    def is_balanced(s):\n        bal = 0\n        for ch in s:\n            if ch == '(':\n                bal += 1\n            else:\n                bal -= 1\n            if bal < 0:\n                return False\n        return bal == 0\n\n    s1, s2 = lst[0], lst[1]\n    if is_balanced(s1 + s2) or is_balanced(s2 + s1):\n        return 'Yes'\n    return 'No'"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if two strings of parentheses can be concatenated to form a balanced string.\n    A string is balanced if all parentheses match and balance never drops below zero.\n    \"\"\"\n    def is_good(s):\n        \"\"\"Checks if a given string of parentheses is balanced.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    s1 = lst[0]\n    s2 = lst[1]\n\n    if is_good(s1 + s2):\n        return 'Yes'\n    if is_good(s2 + s1):\n        return 'Yes'\n\n    return 'No'"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel from the right that is surrounded by two consonants.\n    Returns the vowel preserving its original case, or an empty string if none is found.\n    \"\"\"\n    if len(word) < 3:\n        return \"\"\n\n    vowels = set(\"aeiouAEIOU\")\n\n    # Iterate from len(word) - 2 down to 1 (inclusive)\n    for i in range(len(word) - 2, 0, -1):\n        char = word[i]\n\n        # Check if current character is a vowel\n        if char in vowels:\n            left_neighbor = word[i-1]\n            right_neighbor = word[i+1]\n\n            # Check if both neighbors are consonants\n            if left_neighbor not in vowels and right_neighbor not in vowels:\n                return char\n\n    return \"\""}
