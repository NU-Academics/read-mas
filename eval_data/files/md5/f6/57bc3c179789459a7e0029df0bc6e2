{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating the alphabet 4 positions forward.\n    Non-alphabetic characters remain unchanged, and case is preserved.\"\"\"\n    result = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            shifted_char = chr(((ord(char) - ord('a') + 4) % 26) + ord('a'))\n            result.append(shifted_char)\n        elif 'A' <= char <= 'Z':\n            shifted_char = chr(((ord(char) - ord('A') + 4) % 26) + ord('A'))\n            result.append(shifted_char)\n        else:\n            result.append(char)\n    return \"\".join(result)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the array based on the sum of its first and last elements.\n    If the sum is odd, it sorts in ascending order; if even, in descending order.\n    \"\"\"\n    copied_array = list(array)\n\n    if len(copied_array) <= 1:\n        return copied_array\n\n    first_val = copied_array[0]\n    last_val = copied_array[-1]\n\n    if (first_val + last_val) % 2 == 1:  # Odd sum, sort ascending\n        copied_array.sort()\n    else:  # Even sum, sort descending\n        copied_array.sort(reverse=True)\n\n    return copied_array"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the array based on the parity of the sum of its first and last elements.\n    Ascending if the sum is odd, descending if the sum is even.\n    \"\"\"\n    if not array:\n        return []\n\n    # Create a copy of the array to ensure the original is not modified.\n    copied_array = list(array)\n\n    if len(copied_array) < 2:\n        return copied_array\n\n    first_val = copied_array[0]\n    last_val = copied_array[-1]\n    total_sum = first_val + last_val\n\n    if total_sum % 2 == 1:  # Sum is odd, sort in ascending order\n        return sorted(copied_array)\n    else:  # Sum is even, sort in descending order\n        return sorted(copied_array, reverse=True)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypt a string by rotating alphabetic characters forward by 4 places.\n    Lowercase and uppercase letters preserve case. Non-letter characters are unchanged.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a string\")\n\n    shift = 4\n    result = []\n    for ch in s:\n        if 'a' <= ch <= 'z':\n            result.append(chr((ord(ch) - ord('a') + shift) % 26 + ord('a')))\n        elif 'A' <= ch <= 'Z':\n            result.append(chr((ord(ch) - ord('A') + shift) % 26 + ord('A')))\n        else:\n            result.append(ch)\n    return ''.join(result)"}
