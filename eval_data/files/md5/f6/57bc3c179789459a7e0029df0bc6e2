{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Returns an ordered version of the string where words are character-sorted by ASCII value.\n    Preserves word order and all original spacing (leading, trailing, and consecutive spaces).\n    \"\"\"\n    if not s:\n        return s\n\n    tokens = s.split(' ')\n    processed_tokens = []\n\n    for token in tokens:\n        if token == '':\n            processed_tokens.append('')\n        else:\n            sorted_chars = sorted(list(token))\n            processed_tokens.append(''.join(sorted_chars))\n\n    return ' '.join(processed_tokens)"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Takes a string and returns an ordered version where characters within each word are sorted by ASCII value.\n    Preserves word order and spaces.\n    \"\"\"\n    result_parts = []\n    current_word_chars = []\n\n    for char in s:\n        if char == ' ':\n            # If we were building a word, sort its characters and add to results\n            if current_word_chars:\n                current_word_chars.sort()\n                result_parts.append(\"\".join(current_word_chars))\n                current_word_chars = []  # Reset for the next word\n            # Add the space character itself to preserve its position\n            result_parts.append(char)\n        else:\n            # Add non-space character to the current word builder\n            current_word_chars.append(char)\n\n    # After the loop, check if there's an unfinished word at the end of the string\n    if current_word_chars:\n        current_word_chars.sort()\n        result_parts.append(\"\".join(current_word_chars))\n\n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds all occurrences of x in a nested list and returns their coordinates.\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    results = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                results.append((r_idx, c_idx))\n\n    results.sort(key=lambda coord: (coord[0], -coord[1]))\n    return results"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds occurrences of x in a nested list, returning coordinates (row, column).\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    all_coordinates = []\n    for row_index, row in enumerate(lst):\n        for col_index, value in enumerate(row):\n            if value == x:\n                all_coordinates.append((row_index, col_index))\n\n    # Sort coordinates: first by row in ascending order, then by column in descending order.\n    all_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    return all_coordinates"}
