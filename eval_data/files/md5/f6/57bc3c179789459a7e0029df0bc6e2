{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"Return a greatest common divisor of two integers a and b. Uses the Euclidean algorithm.\"\"\"\n    a = abs(a)\n    b = abs(b)\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    current_longest = strings[0]\n    for s in strings[1:]:\n        if len(s) > len(current_longest):\n            current_longest = s\n    return current_longest"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"Return the greatest common divisor of two integers a and b using the Euclidean algorithm.\n\n    The result is always non-negative. gcd(0, 0) is defined as 0.\n\n    Examples:\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    >>> greatest_common_divisor(-6, 9)\n    3\n    >>> greatest_common_divisor(0, 0)\n    0\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"a and b must be integers\")\n\n    a, b = abs(a), abs(b)\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    if not isinstance(a, str) or not isinstance(b, str):\n        raise TypeError(\"Both inputs must be strings.\")\n\n    if any(c not in \"01\" for c in a) or any(c not in \"01\" for c in b):\n        raise ValueError(\"Inputs must contain only '0' and '1' characters.\")\n\n    max_len = max(len(a), len(b))\n    a_padded = a.rjust(max_len, \"0\")\n    b_padded = b.rjust(max_len, \"0\")\n\n    return \"\".join(\"1\" if x != y else \"0\" for x, y in zip(a_padded, b_padded))"}
