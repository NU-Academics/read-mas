{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # Initialize the first four values required for iteration.\n    f0, f1, f2, f3 = 0, 0, 2, 0 # These represent fib4(0), fib4(1), fib4(2), fib4(3)\n\n    # Iteratively compute fib4(i) from i=4 up to n.\n    for _ in range(4, n + 1):\n        current_fib = f3 + f2 + f1 + f0\n        f0, f1, f2, f3 = f1, f2, f3, current_fib\n\n    return f3"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a str\")\n    left, right = 0, len(text) - 1\n    while left < right:\n        if text[left] != text[right]:\n            return False\n        left += 1\n        right -= 1\n    return True"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base and return its string representation.\n    base must be an integer in the range [2, 9].\n    \"\"\"\n    if not isinstance(base, int):\n        raise TypeError(\"base must be an integer\")\n    if base < 2 or base >= 10:\n        raise ValueError(\"base must be >= 2 and < 10\")\n    if not isinstance(x, int):\n        raise TypeError(\"x must be an integer\")\n\n    if x == 0:\n        return \"0\"\n\n    negative = x < 0\n    x_abs = -x if negative else x\n\n    digits = []\n    while x_abs > 0:\n        x_abs, rem = divmod(x_abs, base)\n        digits.append(str(rem))\n\n    result = \"\".join(reversed(digits))\n    if negative:\n        result = \"-\" + result\n    return result"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"Compute the n-th element of the Fib4 sequence iteratively.\n\n    The sequence:\n      fib4(0) -> 0\n      fib4(1) -> 0\n      fib4(2) -> 2\n      fib4(3) -> 0\n      fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4) for n > 3\n\n    Args:\n        n (int): index (must be a non-negative integer)\n\n    Returns:\n        int: the n-th Fib4 number\n\n    Raises:\n        TypeError: if n is not an int\n        ValueError: if n is negative\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # f0 = fib4(0), f1 = fib4(1), f2 = fib4(2), f3 = fib4(3)\n    f0, f1, f2, f3 = 0, 0, 2, 0\n\n    for _ in range(4, n + 1):\n        nxt = f3 + f2 + f1 + f0\n        f0, f1, f2, f3 = f1, f2, f3, nxt\n\n    return f3"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    Raises ValueError for empty lists or TypeError for non-numeric elements.\n\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    8.0\n    \"\"\"\n    if not l:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    # Validate elements are numeric and build a clean list of numbers.\n    # Exclude bool as it's a subclass of int but not desired here.\n    numeric_list = []\n    for x in l:\n        if isinstance(x, (int, float)) and not isinstance(x, bool):\n            numeric_list.append(x)\n        else:\n            raise TypeError(\"All elements in the list must be numeric (int or float). Booleans are not allowed.\")\n\n    s = sorted(numeric_list)\n    n = len(s)\n\n    if n % 2 == 1:\n        return s[n // 2]\n    else:\n        mid = n // 2\n        return (s[mid - 1] + s[mid]) / 2"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    if not l:\n        raise ValueError(\"median() arg is an empty list\")\n\n    try:\n        sorted_l = sorted(l)\n    except TypeError as e:\n        raise TypeError(\"Elements of the list are not mutually comparable\") from e\n\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        return sorted_l[n // 2]\n    else:\n        a = sorted_l[n // 2 - 1]\n        b = sorted_l[n // 2]\n        try:\n            return (a + b) / 2\n        except TypeError as e:\n            raise TypeError(\"median requires numeric types for even-length list\") from e"}
