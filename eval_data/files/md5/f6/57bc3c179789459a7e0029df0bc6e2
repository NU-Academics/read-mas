{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Create a function that takes a string as input which contains only square brackets.\n    The function returns True iff there is a valid subsequence of brackets\n    where at least one bracket in the subsequence is nested.\n    \"\"\"\n    state = 0  # 0: no '[' seen, 1: seen first '[', 2: seen second '[', 3: seen first ']' after inner '['\n\n    for char in string:\n        if char == '[':\n            if state == 0:\n                state = 1\n            elif state == 1:\n                state = 2\n            # if state is 2 or 3, additional '[' don't change progress toward completing \"[[]]\"\n        elif char == ']':\n            if state == 2:\n                state = 3\n            elif state == 3:\n                return True  # completed the pattern \"[[]]\"\n\n    return False"}
{"task_id": "HumanEval/133", "solution": "def sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    Examples:\n    For lst = [1,2,3] the output should be 14\n    For lst = [1,4,9] the output should be 98\n    For lst = [1,3,5,7] the output should be 84\n    For lst = [1.4,4.2,0] the output should be 29\n    For lst = [-2.4,1,1] the output should be 6\n    \"\"\"\n    import math\n\n    if lst is None:\n        raise TypeError(\"lst must be an iterable of numbers\")\n\n    total = 0\n    for idx, x in enumerate(lst):\n        try:\n            ceiled = math.ceil(x)\n        except TypeError:\n            raise TypeError(f\"Element at index {idx} is not a number: {x!r}\")\n        total += ceiled * ceiled\n\n    return total"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    '''\n    Checks if the last character of a string is an alphabetical character that is not part of a larger word.\n    A 'word' is a group of characters separated by space.\n    '''\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    # The last character is an alphabetical letter.\n    # Check if it's not part of a word (i.e., it's an isolated character word).\n    if len(txt) == 1 or txt[-2] == ' ':\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Returns the largest index i such that arr[i] < arr[i-1].\n    Returns -1 if no such index exists or if the array is too short.\"\"\"\n    if arr is None or len(arr) < 2:\n        return -1\n\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i - 1]:\n            return i\n\n    return -1"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Finds the largest index of an element not greater than or equal to its predecessor.\n    Returns -1 if no such element exists.\"\"\"\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i-1]:\n            return i\n    return -1"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Determines if the string contains a subsequence of brackets where at least one is nested.\n    This is true if the pattern `[[]]` can be found as a subsequence.\n    \"\"\"\n    state = 0  # 0: initial, 1: found one '[', 2: found '[[', 3: found '[[]'\n\n    for char in string:\n        if char == '[':\n            # Progress to finding the first two opening brackets.\n            if state < 2:\n                state += 1\n        elif char == ']':\n            # If '[[', this ']' completes '[[]'.\n            if state == 2:\n                state = 3\n            # If '[[]', this ']' completes the `[[]]` pattern.\n            elif state == 3:\n                return True\n    return False"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Finds the largest negative and smallest positive integers in a list.\n    Returns a tuple (largest_negative, smallest_positive), using None if not found.\n    \"\"\"\n    largest_neg = None\n    smallest_pos = None\n\n    for num in lst:\n        if num < 0:\n            if largest_neg is None or num > largest_neg:\n                largest_neg = num\n        elif num > 0:\n            if smallest_pos is None or num < smallest_pos:\n                smallest_pos = num\n\n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Finds the largest negative integer and the smallest positive integer in a list.\n    Returns (None, None) if no such integers are found.\n    \"\"\"\n    largest_negative = None\n    smallest_positive = None\n\n    for num in lst:\n        if num < 0:\n            if largest_negative is None or num > largest_negative:\n                largest_negative = num\n        elif num > 0:\n            if smallest_positive is None or num < smallest_positive:\n                smallest_positive = num\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compare two values (int, float, or string representing a real number with '.' or ','\n    as decimal separator) and return the larger value in its original type.\n    Return None if numerically equal.\n    \"\"\"\n    def _to_float(x):\n        if isinstance(x, str):\n            s = x.strip().replace(',', '.')\n            return float(s)\n        return float(x)\n\n    val_a = _to_float(a)\n    val_b = _to_float(b)\n\n    if val_a > val_b:\n        return a\n    if val_b > val_a:\n        return b\n    return None"}
