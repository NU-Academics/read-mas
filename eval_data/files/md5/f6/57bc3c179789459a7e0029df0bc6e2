{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, any two numbers are closer to each other than\n    given threshold.\n\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    import math\n\n    # Validate threshold: must be a finite positive number; non-positive cannot have strictly\n    # smaller positive distance between distinct elements.\n    if not math.isfinite(threshold):\n        raise ValueError(\"threshold must be a finite number\")\n    if threshold <= 0:\n        return False\n\n    if len(numbers) < 2:\n        return False\n\n    sorted_numbers = sorted(numbers)\n\n    prev = sorted_numbers[0]\n    for curr in sorted_numbers[1:]:\n        # skip comparisons involving non-finite values (NaN/inf)\n        if not (math.isfinite(prev) and math.isfinite(curr)):\n            prev = curr\n            continue\n        if curr - prev < threshold:\n            return True\n        prev = curr\n\n    return False"}
{"task_id": "HumanEval/32", "solution": "import math\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Tolerances and limits\n    tol_x = 1e-12\n    tol_f = 1e-14\n    max_bisect_iter = 200\n    max_expand_iter = 200\n\n    # Input validation\n    if not isinstance(xs, list) or len(xs) == 0:\n        raise ValueError(\"xs must be a non-empty list of coefficients\")\n\n    # Strip trailing zeros\n    while len(xs) > 1 and xs[-1] == 0:\n        xs = xs[:-1]\n\n    if len(xs) % 2 != 0:\n        raise ValueError(\"xs must have even length so the polynomial degree is odd\")\n\n    # Quick check\n    f0 = poly(xs, 0.0)\n    if f0 == 0.0:\n        return 0.0\n\n    # Bracketing\n    left, right = -1.0, 1.0\n    f_left = poly(xs, left)\n    f_right = poly(xs, right)\n\n    for _ in range(max_expand_iter):\n        if math.isnan(f_left) or math.isnan(f_right) or math.isinf(f_left) or math.isinf(f_right):\n            raise RuntimeError(\"Numerical issues during bracketing\")\n        if f_left * f_right < 0:\n            break\n        left *= 2.0\n        right *= 2.0\n        f_left = poly(xs, left)\n        f_right = poly(xs, right)\n    else:\n        raise RuntimeError(\"Failed to find a sign change bracket for the root\")\n\n    # Bisection\n    for _ in range(max_bisect_iter):\n        mid = (left + right) / 2.0\n        f_mid = poly(xs, mid)\n\n        if math.isnan(f_mid) or math.isinf(f_mid):\n            raise RuntimeError(\"Numerical issues during bisection\")\n\n        if abs(right - left) < tol_x or abs(f_mid) < tol_f:\n            return mid\n\n        if f_left * f_mid < 0:\n            right = mid\n            f_right = f_mid\n        else:\n            left = mid\n            f_left = f_mid\n\n    return (left + right) / 2.0"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\"Find a single real root of an odd-degree polynomial.\n\n    xs: list of coefficients in increasing order (constant term first).\n    Requirements/behavior:\n      - Trims trailing zeros.\n      - If polynomial is identically zero returns 0.0.\n      - Requires an even number of coefficients after trimming (odd degree).\n      - Uses Horner's method to evaluate the polynomial.\n      - Brackets a root by expanding a symmetric interval around 0 until a sign change.\n      - Refines the root by bisection to tolerance 1e-12.\n    \"\"\"\n    def _horner_eval(coeffs, x):\n        # Horner's method: evaluate c0 + c1*x + ... + cn*x^n\n        if not coeffs:\n            return 0.0\n        res = float(coeffs[-1])\n        for c in reversed(coeffs[:-1]):\n            res = res * x + float(c)\n        return res\n\n    # Defensive copy so we don't mutate the caller's list\n    coeffs = list(xs)\n\n    if not coeffs:\n        raise ValueError(\"Polynomial must have at least one coefficient\")\n\n    # Trim trailing zeros (high-degree zero coefficients)\n    while len(coeffs) > 1 and coeffs[-1] == 0:\n        coeffs.pop()\n\n    # If all coefficients are zero, every x is a root; return 0.0\n    if all(c == 0 for c in coeffs):\n        return 0.0\n\n    # After trimming, require even number of coefficients => odd degree\n    if len(coeffs) % 2 != 0:\n        raise ValueError(\"Function requires an odd-degree polynomial (even number of coefficients)\")\n\n    # Constants\n    TOL = 1e-12\n    INITIAL_HALF = 1.0\n    MAX_BOUND = 1e12\n\n    a = -INITIAL_HALF\n    b = INITIAL_HALF\n    f_a = _horner_eval(coeffs, a)\n    f_b = _horner_eval(coeffs, b)\n\n    # If either endpoint is (near) a root, return it\n    if abs(f_a) <= TOL:\n        return a\n    if abs(f_b) <= TOL:\n        return b\n\n    # Expand interval symmetrically until sign change or max bound reached\n    while f_a * f_b > 0 and abs(a) < MAX_BOUND and abs(b) < MAX_BOUND:\n        a *= 2.0\n        b *= 2.0\n        f_a = _horner_eval(coeffs, a)\n        f_b = _horner_eval(coeffs, b)\n        if abs(f_a) <= TOL:\n            return a\n        if abs(f_b) <= TOL:\n            return b\n\n    if f_a * f_b > 0:\n        raise RuntimeError(\"Failed to bracket a root within bounds; numerical issues or polynomial assumptions violated\")\n\n    # Bisection refinement\n    while (b - a) / 2.0 > TOL:\n        mid = (a + b) / 2.0\n        f_mid = _horner_eval(coeffs, mid)\n        if abs(f_mid) <= TOL:\n            return mid\n        if f_a * f_mid < 0:\n            b = mid\n            f_b = f_mid\n        else:\n            a = mid\n            f_a = f_mid\n\n    return (a + b) / 2.0"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic.\n    \"\"\"\n    n = len(arr)\n    count = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            count += 1\n    return count"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit '7' appears in integers strictly less than n\n    that are divisible by 11 or 13.\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    nums = set()\n    for k in range(11, n, 11):\n        nums.add(k)\n    for k in range(13, n, 13):\n        nums.add(k)\n\n    total_sevens = 0\n    for num in nums:\n        total_sevens += str(num).count('7')\n\n    return total_sevens"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string. If shift > number of digits, return digits reversed.\n    \"\"\"\n    # Input validation\n    if not isinstance(x, int):\n        raise TypeError(\"x must be an integer\")\n    if not isinstance(shift, int):\n        raise TypeError(\"shift must be an integer\")\n    if shift < 0:\n        raise ValueError(\"shift must be non-negative\")\n\n    # Extract sign and digit string\n    sign = '-' if x < 0 else ''\n    digits = str(abs(x))\n\n    n = len(digits)\n\n    # Handle trivial cases and special rules\n    if n == 0:\n        result_digits = digits\n    elif shift == 0 or shift == n:\n        result_digits = digits\n    elif shift > n:\n        result_digits = digits[::-1]  # Reverse digits\n    else:  # 1 <= shift < n: Perform circular shift\n        result_digits = digits[-shift:] + digits[:-shift]\n\n    return sign + result_digits"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts the number of prime hexadecimal digits in the input string.\n    Prime hexadecimal digits: 2, 3, 5, 7, B (11), D (13).\n    \"\"\"\n    prime_hex_digits = {'2', '3', '5', '7', 'B', 'D'}\n    return sum(1 for ch in num if ch in prime_hex_digits)"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    Duplicates within l1 or l2 are handled by set conversion.\n    \"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_elements = list(set1.intersection(set2))\n    return sorted(common_elements)"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Checks if an integer 'a' is the product of exactly three prime numbers, counting multiplicity. Returns True if so, False otherwise.\"\"\"\n    if not isinstance(a, int):\n        return False\n    if a < 2:\n        return False\n\n    count = 0\n    n = a\n\n    # Factor out 2s\n    while n % 2 == 0:\n        n //= 2\n        count += 1\n        if count > 3:\n            return False\n\n    # Factor out odd numbers starting from 3\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            n //= d\n            count += 1\n            if count > 3:\n                return False\n        d += 2\n\n    # If n is still greater than 1, it must be a prime factor itself\n    if n > 1:\n        count += 1\n\n    return count == 3"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    The sum is first calculated in base 10, then converted to a binary string.\"\"\"\n    digit_sum = sum(int(digit_char) for digit_char in str(N))\n    return bin(digit_sum)[2:]"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a non-negative decimal integer to its binary string representation,\n    wrapped with 'db' at the start and end.\n    \"\"\"\n    # Validate input type and value\n    if isinstance(decimal, bool):\n        # bool is subclass of int, but likely not intended input\n        raise TypeError(\"Input must be an integer (bool is not allowed).\")\n    if isinstance(decimal, float):\n        if not decimal.is_integer():\n            raise TypeError(\"Input must be an integer or a float representing an integer.\")\n        decimal = int(decimal)\n    elif not isinstance(decimal, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    if decimal < 0:\n        raise ValueError(\"Negative numbers are not supported.\")\n\n    # Handle zero explicitly\n    if decimal == 0:\n        return \"db0db\"\n\n    binary_representation = bin(decimal)[2:]\n    return \"db\" + binary_representation + \"db\""}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n    if n == 1:\n        return 1\n    return 18 * 10**(n - 2)"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"\n    Checks if the length of a string is a prime number.\n    Returns True if the length is prime, False otherwise.\n    \"\"\"\n    length = len(string)\n\n    def is_prime(n):\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    return is_prime(length)"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"Checks if a string is 'happy': length at least 3 and every window of 3 consecutive characters contains three distinct characters.\"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        # Check if s[i], s[i+1], s[i+2] are all distinct\n        if s[i] == s[i+1] or s[i] == s[i+2] or s[i+1] == s[i+2]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts elements in an array where the sum of digits is greater than 0.\n    Handles negative numbers by making the most significant digit negative.\n    \"\"\"\n    count = 0\n    for num in arr:\n        digit_sum = 0\n        if num == 0:\n            digit_sum = 0\n        elif num > 0:\n            s_num = str(num)\n            for digit_char in s_num:\n                digit_sum += int(digit_char)\n        else:  # num < 0\n            s_num = str(abs(num))\n            # The first digit of the absolute value is treated as negative.\n            digit_sum += -int(s_num[0])\n            # Add remaining digits as positive.\n            for digit_char in s_num[1:]:\n                digit_sum += int(digit_char)\n\n        if digit_sum > 0:\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name\n    from \"One\"..\"Nine\". Ignores non-integers and booleans.\n    \"\"\"\n    digit_names = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    if not arr:\n        return []\n\n    # Keep only values that are strictly ints (exclude bool) and in range 1..9\n    filtered = [x for x in arr if type(x) is int and 1 <= x <= 9]\n\n    if not filtered:\n        return []\n\n    # Sort ascending then reverse (equivalently sort descending)\n    sorted_desc = sorted(filtered, reverse=True)\n\n    return [digit_names[x] for x in sorted_desc]"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = 0\n    neg_count = 0\n\n    for num in arr:\n        if num == 0:\n            return 0  # If any element is zero, the final product is zero.\n        sum_magnitudes += abs(num)\n        if num < 0:\n            neg_count += 1\n\n    product_signs = -1 if neg_count % 2 != 0 else 1\n\n    return sum_magnitudes * product_signs"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel from the right, surrounded by consonants.\n    Returns an empty string if no such vowel is found.\"\"\"\n    vowels_set = \"aeiouAEIOU\"\n\n    if len(word) < 3:\n        return \"\"\n\n    # Iterate from the second to last character down to the second character (index 1).\n    # This ensures word[i] is always preceded and followed by another character.\n    for i in range(len(word) - 2, 0, -1):\n        char = word[i]\n        prev_char = word[i - 1]\n        next_char = word[i + 1]\n\n        # Check if the current character is a vowel.\n        if char in vowels_set:\n            # Check if both surrounding characters are consonants (not vowels).\n            if prev_char not in vowels_set and next_char not in vowels_set:\n                return char\n\n    return \"\""}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer, return a tuple with the count of even and odd digits.\n    Handles negative numbers by counting digits of their absolute value.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    if num == 0:\n        return (1, 0)  # Zero has one even digit: 0 itself.\n\n    # Convert to absolute value to handle negative numbers\n    abs_num_str = str(abs(num))\n\n    for digit_char in abs_num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    count = 0\n    odd_digits = {1, 3, 5, 7, 9}\n    for num in nums:\n        try:\n            if not (num > 10):\n                continue\n        except TypeError:\n            continue\n        n = abs(int(num))\n        last = n % 10\n        first = n\n        while first >= 10:\n            first //= 10\n        if first in odd_digits and last in odd_digits:\n            count += 1\n    return count"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    \"\"\"\n    import math\n\n    # Reject boolean inputs which are subclasses of int\n    if isinstance(a, bool) or isinstance(b, bool) or isinstance(c, bool):\n        return False\n\n    # Validate finiteness and positivity\n    try:\n        if not (math.isfinite(a) and math.isfinite(b) and math.isfinite(c)):\n            return False\n    except TypeError:\n        # Non-numeric types\n        return False\n\n    try:\n        a_f, b_f, c_f = float(a), float(b), float(c)\n    except (TypeError, ValueError):\n        return False\n\n    if a_f <= 0 or b_f <= 0 or c_f <= 0:\n        return False\n\n    # Sort sides so that x <= y <= z (z is the hypotenuse candidate)\n    x, y, z = sorted((a_f, b_f, c_f))\n\n    # Triangle inequality: x + y must be greater than z (treat near-degenerate as invalid)\n    # Use a tight tolerance for degeneracy check\n    if x + y < z or math.isclose(x + y, z, rel_tol=1e-12, abs_tol=1e-12):\n        return False\n\n    # Check Pythagorean theorem with tolerances\n    # rel_tol handles relative floating error; abs_tol guards very small values\n    if math.isclose(x * x + y * y, z * z, rel_tol=1e-9, abs_tol=1e-12):\n        return True\n\n    return False"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + )\n    Subtraction ( - )\n    Multiplication ( * )\n    Floor division ( // )\n    Exponentiation ( ** )\n    \"\"\"\n    PRECEDENCE = {\n        '+': 1, '-': 1,\n        '*': 2, '//': 2,\n        '**': 3\n    }\n    ASSOCIATIVITY = {\n        '+': 'left', '-': 'left',\n        '*': 'left', '//': 'left',\n        '**': 'right'\n    }\n    OP_SET = set(PRECEDENCE.keys())\n\n    # Input validation\n    if not isinstance(operator, (list, tuple)):\n        raise ValueError(\"operator must be a list or tuple of operator strings\")\n    if not isinstance(operand, (list, tuple)):\n        raise ValueError(\"operand must be a list or tuple of integers\")\n    if len(operator) != len(operand) - 1:\n        raise ValueError(\"length of operator list must be one less than length of operand list\")\n    if len(operator) < 1:\n        raise ValueError(\"operator list must contain at least one operator\")\n    if len(operand) < 2:\n        raise ValueError(\"operand list must contain at least two operands\")\n\n    for op in operator:\n        if not isinstance(op, str) or op not in OP_SET:\n            raise ValueError(f\"unsupported operator: {op}\")\n    for val in operand:\n        if not isinstance(val, int) or val < 0:\n            raise ValueError(\"operands must be non-negative integers\")\n\n    # Tokenization: interleave operands and operators\n    tokens = []\n    for i in range(len(operand)):\n        tokens.append(operand[i])\n        if i < len(operator):\n            tokens.append(operator[i])\n\n    # Shunting-yard: convert to RPN\n    output_queue = []\n    op_stack = []\n\n    for token in tokens:\n        if token not in OP_SET:  # number\n            output_queue.append(token)\n        else:\n            o1 = token\n            while op_stack and op_stack[-1] in OP_SET:\n                o2 = op_stack[-1]\n                if (ASSOCIATIVITY[o1] == 'left' and PRECEDENCE[o1] <= PRECEDENCE[o2]) or \\\n                   (ASSOCIATIVITY[o1] == 'right' and PRECEDENCE[o1] < PRECEDENCE[o2]):\n                    output_queue.append(op_stack.pop())\n                else:\n                    break\n            op_stack.append(o1)\n\n    while op_stack:\n        output_queue.append(op_stack.pop())\n\n    # Evaluate RPN\n    value_stack = []\n    for token in output_queue:\n        if token not in OP_SET:\n            value_stack.append(token)\n        else:\n            if len(value_stack) < 2:\n                raise ValueError(\"invalid expression\")\n            b = value_stack.pop()\n            a = value_stack.pop()\n            if token == '+':\n                value_stack.append(a + b)\n            elif token == '-':\n                value_stack.append(a - b)\n            elif token == '*':\n                value_stack.append(a * b)\n            elif token == '//':\n                if b == 0:\n                    raise ZeroDivisionError(\"division by zero\")\n                value_stack.append(a // b)\n            elif token == '**':\n                value_stack.append(a ** b)\n\n    if len(value_stack) != 1:\n        raise ValueError(\"invalid expression evaluation\")\n    return value_stack[0]"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers greater than 10 whose first and last digits are odd.\n    It iterates through the array, checking each number against the criteria.\"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            # Convert the absolute value of the number to a string to extract digits.\n            s_num = str(abs(num))\n            first_digit = int(s_num[0])\n            last_digit = int(s_num[-1])\n\n            # Check if both the first and last digits are odd.\n            if first_digit % 2 != 0 and last_digit % 2 != 0:\n                count += 1\n    return count"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Finds the minimum sum of any non-empty sub-array using Kadane's algorithm variant.\n    It tracks the minimum sum ending at the current position and the overall minimum sum.\n    \"\"\"\n    min_so_far = nums[0]\n    min_ending_here = nums[0]\n\n    for i in range(1, len(nums)):\n        min_ending_here = min(nums[i], min_ending_here + nums[i])\n        min_so_far = min(min_so_far, min_ending_here)\n\n    return min_so_far"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    Sorts a list of integers by:\n      1) number of '1' bits in their binary representation (ascending)\n      2) numeric value (ascending) as a tie-breaker\n\n    Negative numbers use the bit-count of their absolute value.\n    The input list is not modified; a new sorted list is returned.\n    \"\"\"\n    if arr is None:\n        return []\n    return sorted(arr, key=lambda x: (bin(x if x >= 0 else -x).count('1'), x))"}
