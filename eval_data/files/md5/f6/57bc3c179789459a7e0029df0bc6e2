p_stack:\n        output_queue.append(op_stack.pop())\n\n    # Evaluate RPN\n    stack = []\n    for token in output_queue:\n        if isinstance(token, str) and token in precedence:\n            if len(stack) < 2:\n                raise ValueError(\"Invalid expression\")\n            b = stack.pop()\n            a = stack.pop()\n            if token == '+':\n                res = a + b\n            elif token == '-':\n                res = a - b\n            elif token == '*':\n                res = a * b\n            elif token == '//':\n                if b == 0:\n                    raise ZeroDivisionError(\"integer division by zero\")\n                res = a // b\n            elif token == '**':\n                res = a ** b\n            stack.append(res)\n        else:\n            stack.append(token)\n\n    if len(stack) != 1:\n        raise ValueError(\"Invalid expression evaluation\")\n    return stack[0]"}
{"task_id": "HumanEval/162", "solution": "def string_to_md5(text):\n    \"\"\"\n    Computes the MD5 hash of a string, returning None for an empty string.\n\n    >>> string_to_md5('Hello world') == '3e25960a79dbc69b674cd4ec67a72c62'\n    \"\"\"\n    import hashlib\n\n    if text == \"\":\n        return None\n\n    md5_hash = hashlib.md5(text.encode('utf-8')).hexdigest()\n    return md5_hash"}
