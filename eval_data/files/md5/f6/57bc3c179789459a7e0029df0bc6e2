{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    The function checks for divisors up to the square root of n.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/31", "solution": "import math\n\ndef is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    # Handle base cases and small primes as per design document.\n    if not isinstance(n, int):\n        return False\n    if n <= 1:\n        return False\n    if n in (2, 3):\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n\n    # Optimized trial division using the 6k \u00b1 1 method.\n    i = 5\n    limit = math.isqrt(n)\n    while i <= limit:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n\n    return True"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function sorts elements at indices divisible by three while preserving others.\n    It returns a new list with these sorted elements.\n    \"\"\"\n    third_elements = []\n    third_indices = []\n    for i, x in enumerate(l):\n        if i % 3 == 0:\n            third_elements.append(x)\n            third_indices.append(i)\n\n    third_elements.sort()\n\n    result_list = list(l)  # Create a mutable copy of the input list\n\n    for i in range(len(third_indices)):\n        result_list[third_indices[i]] = third_elements[i]\n\n    return result_list"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    # Collect indices divisible by 3 and their corresponding values.\n    indices_to_sort = [i for i, _ in enumerate(l) if i % 3 == 0]\n    values_to_sort = [l[i] for i in indices_to_sort]\n\n    # Sort the collected values.\n    sorted_values = sorted(values_to_sort)\n\n    # Make a shallow copy of the input list.\n    result_list = list(l)\n\n    # Replace elements at the collected indices with the sorted values.\n    for original_index, sorted_value in zip(indices_to_sort, sorted_values):\n        result_list[original_index] = sorted_value\n\n    return result_list"}
