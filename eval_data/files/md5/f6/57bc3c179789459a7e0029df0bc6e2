{"task_id": "HumanEval/120", "solution": "import heapq\nfrom typing import List\n\ndef maximum(arr: List[int], k: int) -> List[int]:\n    \"\"\"\n    Returns a sorted list of length k containing the k largest numbers from arr.\n    Handles various k values including 0 and len(arr).\n    \"\"\"\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n    if k < 0 or k > len(arr):\n        raise ValueError(\"k must be between 0 and len(arr) inclusive\")\n    if k == 0:\n        return []\n    if k == len(arr):\n        return sorted(arr)\n    # Use heapq.nlargest to get k largest elements in descending order.\n    largest_elements_desc = heapq.nlargest(k, arr)\n    # Sort them in ascending order as required.\n    return sorted(largest_elements_desc)"}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a list of integers, return the sum of all odd elements that are in even positions.\n    Iterates through even indices and accumulates odd values.\n    \"\"\"\n    total = 0\n    for i in range(0, len(lst), 2):\n        if lst[i] % 2 != 0:\n            total += lst[i]\n    return total"}
{"task_id": "HumanEval/120", "solution": "import heapq\n\ndef maximum(arr, k):\n    \"\"\"\n    Returns a sorted list of length k containing the k largest numbers from arr.\n    It uses heapq.nlargest for efficiency and sorts the result ascending.\n    \"\"\"\n    if k <= 0:\n        return []\n\n    if k >= len(arr):\n        # If k is greater than or equal to array length, return the entire array sorted.\n        return sorted(arr)\n\n    # Use heapq.nlargest to find the k largest elements.\n    k_largest_elements = heapq.nlargest(k, arr)\n\n    # Sort the k largest elements in ascending order as required by the problem.\n    return sorted(k_largest_elements)"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list of odd numbers in its Collatz sequence.\n    The sequence is generated by halving even numbers and applying (3n + 1) to odd numbers until 1 is reached.\n    \"\"\"\n    odd_numbers = set()\n    current_n = n\n    while current_n != 1:\n        if current_n % 2 != 0:\n            odd_numbers.add(current_n)\n        if current_n % 2 == 0:\n            current_n //= 2\n        else:\n            current_n = 3 * current_n + 1\n    odd_numbers.add(1) # 1 is always part of the sequence and is odd.\n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Sums elements with at most two digits from the first k elements of arr.\n    It iterates through the first k numbers, adding only those between -99 and 99 (inclusive).\n    \"\"\"\n    total_sum = 0\n    for i in range(k):\n        num = arr[i]\n        if -99 <= num <= 99:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array (list/tuple) of integers `arr` and an integer `k`,\n    return the sum of the elements with at most two digits from the first k elements of arr.\n\n    At most two digits means abs(value) <= 99 (includes 0 and negative values whose absolute value is <= 99).\n\n    Raises:\n        TypeError: if arr is not a list/tuple or k is not an int.\n        ValueError: if arr is empty, length of arr is out of allowed bounds, k is out of range,\n                    or any of the first k elements are not integers.\n    \"\"\"\n    # Validate types\n    if not isinstance(arr, (list, tuple)):\n        raise TypeError(\"arr must be a list or tuple of integers\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n\n    n = len(arr)\n    if n == 0 or n > 100:\n        raise ValueError(\"arr must have length between 1 and 100 inclusive\")\n    if not (1 <= k <= n):\n        raise ValueError(\"k must satisfy 1 <= k <= len(arr)\")\n\n    total = 0\n    for i in range(k):\n        val = arr[i]\n        # Reject non-int values (and booleans)\n        if not isinstance(val, int) or isinstance(val, bool):\n            raise ValueError(f\"arr[{i}] is not an integer\")\n        if abs(val) <= 99:\n            total += val\n\n    return total"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list of the distinct odd numbers\n    that appear in the Collatz sequence starting from n and ending at 1.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    odd_values = set()\n    current = n\n\n    while True:\n        if current % 2 != 0:\n            odd_values.add(current)\n\n        if current == 1:\n            break\n\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n\n    return sorted(odd_values)"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"\n    Validates a date string based on specific rules for format, month, and day ranges.\n    Returns True if valid, False otherwise.\n    \"\"\"\n    if not date:  # Rule 1: The date string is not empty.\n        return False\n\n    parts = date.split('-')\n    if len(parts) != 3:  # Rule 4: The date should be in mm-dd-yyyy format.\n        return False\n\n    # Check if each part has correct length and consists only of digits.\n    if not (len(parts[0]) == 2 and parts[0].isdigit() and\n            len(parts[1]) == 2 and parts[1].isdigit() and\n            len(parts[2]) == 4 and parts[2].isdigit()):\n        return False\n\n    month = int(parts[0])\n    day = int(parts[1])\n    year = int(parts[2])\n\n    # Rule 3: Months should be between 1 and 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # Days in month for non-leap years (index 0 unused for convenience).\n    days_in_month = [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]\n\n    # Determine if it's a leap year.\n    is_leap = (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)\n\n    # Adjust maximum days for February in a leap year.\n    max_days = days_in_month[month]\n    if month == 2 and is_leap:\n        max_days = 29\n\n    # Rule 2: Validate the number of days based on the month.\n    if not (1 <= day <= max_days):\n        return False\n\n    return True"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"Validates a date string in 'mm-dd-yyyy' format.\n    Returns True if valid according to specified rules, otherwise False.\n    \"\"\"\n    # Trim whitespace\n    try:\n        date = date.strip()\n    except Exception:\n        return False\n\n    # Non-empty\n    if not date:\n        return False\n\n    # Exact length mm-dd-yyyy -> 10 chars\n    if len(date) != 10:\n        return False\n\n    # Correct separators\n    if date[2] != '-' or date[5] != '-':\n        return False\n\n    # Extract parts\n    mm_str = date[0:2]\n    dd_str = date[3:5]\n    yyyy_str = date[6:10]\n\n    # All parts must be numeric\n    if not (mm_str.isdigit() and dd_str.isdigit() and yyyy_str.isdigit()):\n        return False\n\n    m = int(mm_str)\n    d = int(dd_str)\n    # y = int(yyyy_str)  # Year not used for validation per spec\n\n    # Month range\n    if not (1 <= m <= 12):\n        return False\n\n    # Day lower bound\n    if d < 1:\n        return False\n\n    # Determine max day for month\n    if m in {1, 3, 5, 7, 8, 10, 12}:\n        max_day = 31\n    elif m in {4, 6, 9, 11}:\n        max_day = 30\n    else:  # m == 2\n        max_day = 29\n\n    if d > max_day:\n        return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"Splits a string by whitespace or commas, or counts odd-indexed lowercase letters.\n    Examples:\n      split_words(\"Hello world!\") -> ['Hello', 'world!']\n      split_words(\"Hello,world!\") -> ['Hello', 'world!']\n      split_words(\"abcdef\") -> 3\n    \"\"\"\n    if any(c.isspace() for c in txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        ord_a = ord('a')\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z' and ((ord(char) - ord_a) % 2 == 1):\n                count += 1\n        return count"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits words based on whitespace, then commas if no whitespace.\n    Otherwise, counts lowercase letters with odd alphabetical order.\n    \"\"\"\n    if any(c.isspace() for c in txt):\n        return txt.split()\n\n    if ',' in txt:\n        return txt.split(',')\n\n    count = 0\n    for char in txt:\n        if 'a' <= char <= 'z':\n            if (ord(char) - ord('a')) % 2 != 0:\n                count += 1\n    return count"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"\n    Checks if a list is sorted in non-decreasing order and no number appears more than twice.\n    Assumes valid input types (list of non-negative integers).\n    \"\"\"\n    prev = None\n    counts = {}\n\n    for element in lst:\n        if prev is not None and element < prev:\n            return False\n\n        counts[element] = counts.get(element, 0) + 1\n        if counts[element] > 2:\n            return False\n\n        prev = element\n\n    return True"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two closed integer intervals is a prime number.\n    The length of an interval (start, end) is defined as end - start, consistent with the problem examples.\n    Returns \"YES\" if that length is prime, otherwise \"NO\".\n    \"\"\"\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    # Intersection interval\n    intersect_start = max(start1, start2)\n    intersect_end = min(end1, end2)\n\n    # Length as per examples: end - start\n    length = intersect_end - intersect_start\n\n    # Primes are integers > 1\n    if length <= 1:\n        return \"NO\"\n    if length == 2:\n        return \"YES\"\n    if length % 2 == 0:\n        return \"NO\"\n\n    # Check odd divisors up to sqrt(length)\n    i = 3\n    while i * i <= length:\n        if length % i == 0:\n            return \"NO\"\n        i += 2\n    return \"YES\""}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"\n    Given a list of non-negative integers, return True if the list is sorted\n    in non-decreasing (ascending with equals allowed) order and no number\n    appears more than twice. Return False otherwise.\n\n    Examples:\n    is_sorted([5]) -> True\n    is_sorted([1, 2, 3, 4, 5]) -> True\n    is_sorted([1, 3, 2, 4, 5]) -> False\n    is_sorted([1, 2, 2, 3, 3, 4]) -> True\n    is_sorted([1, 2, 2, 2, 3, 4]) -> False\n    \"\"\"\n    if not lst:\n        return True\n\n    # Check non-decreasing order\n    for a, b in zip(lst, lst[1:]):\n        if a > b:\n            return False\n\n    # Check that no number appears more than twice\n    from collections import Counter\n    counts = Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    return True"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = 0\n    product_signs = 1\n\n    for num in arr:\n        sum_magnitudes += abs(num)\n        if num > 0:\n            product_signs *= 1\n        elif num < 0:\n            product_signs *= -1\n        else:\n            product_signs *= 0  # If any number is 0, the total sign product becomes 0.\n\n    return sum_magnitudes * product_signs"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the grid.\n    Starts at the cell containing 1 and greedily picks the smallest neighbor at each step.\n    \"\"\"\n    # Basic validations\n    if not isinstance(grid, list) or not grid or not all(isinstance(row, list) for row in grid):\n        raise ValueError(\"grid must be a non-empty list of lists\")\n    N = len(grid)\n    if any(len(row) != N for row in grid):\n        raise ValueError(\"grid must be square (N x N)\")\n    if not isinstance(k, int) or k < 1:\n        raise ValueError(\"k must be a positive integer\")\n\n    # Locate the starting cell containing value 1\n    r_curr, c_curr = -1, -1\n    for r in range(N):\n        for c in range(N):\n            if grid[r][c] == 1:\n                r_curr, c_curr = r, c\n                break\n        if r_curr != -1:\n            break\n    if r_curr == -1:\n        raise ValueError(\"value 1 not found in grid\")\n\n    path = [1]\n    if k == 1:\n        return path\n\n    # Neighbor directions: up, down, left, right\n    dr = [-1, 1, 0, 0]\n    dc = [0, 0, -1, 1]\n\n    # Greedily choose the smallest neighbor for each subsequent step\n    for _ in range(k - 1):\n        min_val = float('inf')\n        next_r = next_c = -1\n        for i in range(4):\n            nr, nc = r_curr + dr[i], c_curr + dc[i]\n            if 0 <= nr < N and 0 <= nc < N:\n                val = grid[nr][nc]\n                if val < min_val:\n                    min_val = val\n                    next_r, next_c = nr, nc\n        # Update position and append chosen value\n        r_curr, c_curr = next_r, next_c\n        path.append(min_val)\n\n    return path"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two closed intervals is a prime number.\n    Length is defined as inter_end - inter_start (i.e., the standard real interval length).\n    Returns \"YES\" if the length is prime, otherwise \"NO\".\"\"\"\n    def is_prime(n: int) -> bool:\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    inter_start = max(start1, start2)\n    inter_end = min(end1, end2)\n\n    length = inter_end - inter_start\n    if length <= 0:\n        length = 0\n\n    return \"YES\" if is_prime(length) else \"NO\""}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the grid.\n    The path starts at the cell containing value 1 and greedily moves to the smallest neighbor.\n    \"\"\"\n    N = len(grid)\n\n    # 1. Find the coordinates (r,c) of the global minimum value (1)\n    start_r, start_c = -1, -1\n    for r_idx in range(N):\n        for c_idx in range(N):\n            if grid[r_idx][c_idx] == 1:\n                start_r, start_c = r_idx, c_idx\n                break\n        if start_r != -1:\n            break\n\n    # Initialize result list and current position\n    res = []\n    current_r, current_c = start_r, start_c\n\n    # Repeat k times to build the path\n    for _ in range(k):\n        # Append current cell's value to the result\n        res.append(grid[current_r][current_c])\n\n        # If k elements have been appended, stop\n        if len(res) == k:\n            break\n\n        # Consider all orthogonal neighbors and pick the one with the minimal value\n        min_neighbor_value = float('inf')\n        next_r, next_c = -1, -1\n\n        # Define possible movements: up, down, left, right\n        moves = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n\n        for dr, dc in moves:\n            nr, nc = current_r + dr, current_c + dc\n\n            # Check if neighbor is within grid bounds\n            if 0 <= nr < N and 0 <= nc < N:\n                neighbor_value = grid[nr][nc]\n                if neighbor_value < min_neighbor_value:\n                    min_neighbor_value = neighbor_value\n                    next_r, next_c = nr, nc\n\n        # Set current to the chosen minimal neighbor for the next iteration\n        current_r, current_c = next_r, next_c\n\n    return res"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in\n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8\n    You are given a non-negative integer number n, you have to a return a list of the\n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    # Validate input\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    result = []\n    for k in range(n + 1):\n        if k == 0:\n            result.append(1)\n        elif k == 1:\n            result.append(3)\n        elif k % 2 == 0:  # even\n            # Use integer division for k/2 as per examples\n            result.append(1 + k // 2)\n        else:  # odd\n            # tri(k) = tri(k-1) + tri(k-2) + tri(k+1)\n            # tri(k+1) exists and is even, so use its closed form: 1 + (k+1)/2\n            tri_k_plus_1 = 1 + (k + 1) // 2\n            result.append(result[k - 1] + result[k - 2] + tri_k_plus_1)\n    return result"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of its odd digits.\n    Returns 0 if all digits are even or if n is 0.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    product = 1\n    found_odd = False\n\n    # Defensive step as per design, though original problem assumes positive n.\n    n = abs(n)\n\n    while n > 0:\n        digit = n % 10\n        if digit % 2 == 1:\n            product *= digit\n            found_odd = True\n        n //= 10\n\n    if found_odd:\n        return product\n    else:\n        return 0"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Return a list of the first n+1 Tribonacci numbers (indices 0..n).\n\n    Definition:\n      - tri(1) = 3\n      - tri(n) = 1 + n//2  if n is even\n      - tri(n) = tri(n-1) + tri(n-2) + tri(n+1)  if n is odd\n\n    Notes:\n      - For odd n, tri(n+1) is even, so its value is computed by the even rule\n        (1 + (n+1)//2) and does not require further forward recursion.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    res = [0] * (n + 1)\n    for i in range(n + 1):\n        if i == 1:\n            res[i] = 3\n        elif i % 2 == 0:\n            # even indices (including 0)\n            res[i] = 1 + i // 2\n        else:\n            # odd index > 1: tri(i) = tri(i-1) + tri(i-2) + tri(i+1)\n            # tri(i+1) is even so use the even rule directly\n            res[i] = res[i - 1] + res[i - 2] + (1 + (i + 1) // 2)\n    return res"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n\n    n = abs(n)\n    product = 1\n    found_odd = False\n\n    if n == 0:\n        return 0\n\n    while n:\n        digit = n % 10\n        if digit % 2 == 1:\n            product *= digit\n            found_odd = True\n        n //= 10\n\n    return product if found_odd else 0"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an alphabetical character\n    and is not part of a word, returning True if both conditions are met.\n    \"\"\"\n    n = len(txt)\n    if n == 0:\n        return False\n\n    last_char = txt[n - 1]\n    if not last_char.isalpha():\n        return False\n\n    # If it's a single alphabetical character, it's not part of a word.\n    if n == 1:\n        return True\n\n    # Check the character preceding the last one.\n    second_to_last_char = txt[n - 2]\n    return second_to_last_char == ' '"}
