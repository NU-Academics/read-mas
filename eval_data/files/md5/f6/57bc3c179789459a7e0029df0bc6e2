{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\"Checks if a string of '<' and '>' brackets is correctly balanced.\n    Returns True if every opening bracket has a corresponding closing bracket in correct order.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        else:\n            # If invalid characters are present, consider the string invalid\n            return False\n\n        # If balance drops below zero, a closing bracket appeared without a matching open bracket\n        if balance < 0:\n            return False\n\n    # For a correctly balanced string, the final balance must be zero\n    return balance == 0"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    if n < 1:\n        raise ValueError(\"n must be a positive integer (1-based indexing).\")\n\n    def _fib_doubling_helper(k: int):\n        # This helper computes (F_k, F_{k+1}) for the 0-based Fibonacci sequence\n        # where F_0 = 0, F_1 = 1, F_2 = 1, F_3 = 2, ...\n        if k == 0:\n            return (0, 1)\n\n        F_half_k, F_half_k_plus_1 = _fib_doubling_helper(k // 2)\n\n        a = F_half_k\n        b = F_half_k_plus_1\n\n        F_2m = a * (2 * b - a)\n        F_2m_plus_1 = a * a + b * b\n\n        if k % 2 == 0:\n            return (F_2m, F_2m_plus_1)\n        else:\n            return (F_2m_plus_1, F_2m + F_2m_plus_1)\n\n    result, _ = _fib_doubling_helper(n)\n    return result"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    An empty list or a single-element list is considered monotonic.\n    \"\"\"\n    if len(l) < 2:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(1, len(l)):\n        if l[i] > l[i-1]:\n            is_decreasing = False\n        elif l[i] < l[i-1]:\n            is_increasing = False\n\n        if not is_increasing and not is_decreasing:\n            return False\n\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\"Return True if every opening '<' has a corresponding closing '>' and brackets are properly nested.\"\"\"\n    open_count = 0\n    for ch in brackets:\n        if ch == '<':\n            open_count += 1\n        elif ch == '>':\n            open_count -= 1\n            if open_count < 0:\n                return False\n        else:\n            # Ignore any other characters (input is expected to contain only '<' and '>')\n            continue\n    return open_count == 0"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int) -> int:\n    \"\"\"Return the n-th Fibonacci number using 1-based indexing.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    def _fib_pair(k: int) -> tuple[int, int]:\n        if k == 0:\n            return (0, 1)\n\n        a, b = _fib_pair(k // 2)\n        c = a * (2 * b - a)  # F(2m)\n        d = a * a + b * b    # F(2m + 1)\n\n        if k % 2 == 0:\n            return (c, d)\n        else:\n            return (d, c + d)\n\n    return _fib_pair(n)[0]"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for a, b in zip(l, l[1:]):\n        try:\n            if a < b:\n                is_decreasing = False\n            elif a > b:\n                is_increasing = False\n        except TypeError:\n            raise TypeError(\"List contains non-comparable elements\")\n        if not is_increasing and not is_decreasing:\n            return False\n\n    return True"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\"\"\"\n    largest_factor = 1\n\n    # Divide by 2 until n is odd\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Check for odd factors from 3 up to sqrt(n)\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n        i += 2\n\n    # If n is still greater than 1, it must be a prime factor itself\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
