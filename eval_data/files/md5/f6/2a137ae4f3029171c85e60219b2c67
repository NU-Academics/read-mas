{"task_id": "Mbpp/273", "solution": "def substract_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Subtracts elements of the second tuple from the first tuple at corresponding indices.\n    Validates input tuple lengths and element types, raising errors on mismatch.\n    \"\"\"\n    _validate_equal_length(a, b)\n    _validate_numeric_elements(a, 'a')\n    _validate_numeric_elements(b, 'b')\n\n    result_elements = (x - y for x, y in zip(a, b))\n    return tuple(result_elements)"}
{"task_id": "Mbpp/276", "solution": "import math\nclass Cylinder:\n    \"\"\"Represents a cylinder and computes its volume.\"\"\"\n    def __init__(self, radius, height) -> None:\n        self.radius: float = radius\n        self.height: float = height\n        self.volume: float = 0.0\n\n    def computeVolume(self) -> float:\n        \"\"\"Computes the volume of the cylinder.\"\"\"\n        self.volume = math.pi * self.radius ** 2 * self.height\n        return self.volume\nclass VolumeCalculator:\n    \"\"\"Orchestrates volume calculation.\"\"\"\n    def volume_cylinder(self, radius, height) -> float:\n        # The validation step is omitted as per the constraint:\n        # \"Do NOT add isinstance() checks or raise exceptions for edge cases\".\n        cylinder = Cylinder(radius, height)\n        return cylinder.computeVolume()\ndef volume_cylinder(radius, height) -> float:\n    \"\"\"\n    Calculates the volume of a cylinder given its radius and height.\n    \"\"\"\n    return VolumeCalculator().volume_cylinder(radius, height)"}
{"task_id": "Mbpp/274", "solution": "class Input:\n    \"\"\"Validates the input integer n.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def validate(self):\n        \"\"\"Checks if n is a positive integer.\"\"\"\n        if not isinstance(self.n, int):\n            return False, \"Input n must be an integer.\"\n        if self.n <= 0:\n            return False, \"Input n must be a positive integer.\"\n        return True, \"\"\nclass Output:\n    \"\"\"Represents the output value and its type.\"\"\"\n    def __init__(self, value, value_type=\"int\"):\n        self.value = value\n        self.type = value_type\nclass BinomialCoefficient:\n    \"\"\"Computes C(n,k) using an iterative multiplicative approach.\"\"\"\n    def __init__(self, n, k):\n        self.n = n\n        self.k = k\n\n    def compute(self):\n        \"\"\"Calculates nCk efficiently for 0 <= k <= n.\"\"\"\n        k = min(self.k, self.n - self.k)\n\n        if k < 0 or k > self.n:\n             return 0\n        if k == 0 or self.n == k:\n            return 1\n        \n        res = 1\n        for i in range(k):\n            res = res * (self.n - i) // (i + 1)\n        return res\nclass SummationEngine:\n    \"\"\"Computes the sum of even-indexed binomial coefficients.\"\"\"\n    def compute_even_index_sum(self, n):\n        \"\"\"Calculates sum_{k even, 0<=k<=n} C(n,k) iteratively.\"\"\"\n        total_sum = 0\n        for k in range(0, n + 1, 2):\n            bc = BinomialCoefficient(n, k)\n            total_sum += bc.compute()\n        return total_sum\ndef even_binomial_Coeff_Sum(n):\n    \"\"\"\n    Takes in a positive integer n and finds the sum of even index binomial coefficients.\n    e.g., C(n,0) + C(n,2) + C(n,4) + ...\n    \"\"\"\n    input_validator = Input(n)\n    is_valid, error_message = input_validator.validate()\n\n    if not is_valid:\n        if \"integer\" in error_message:\n            raise TypeError(error_message)\n        else:\n            raise ValueError(error_message)\n\n    summation_engine = SummationEngine()\n    calculated_sum = summation_engine.compute_even_index_sum(n)\n\n    output_obj = Output(calculated_sum)\n    return output_obj.value"}
{"task_id": "Mbpp/277", "solution": "def dict_filter(input_dict: dict, n: int) -> dict:\n    \"\"\"Return a new dict containing only entries from input_dict where value >= n.\n\n    Preconditions (per SRS):\n    - input_dict: mapping of string keys to int values (caller responsibility).\n    - n: int threshold.\n    \"\"\"\n    filtered_dict = {}\n    for key, value in input_dict.items():\n        if value >= n:\n            filtered_dict[key] = value\n    return filtered_dict"}
