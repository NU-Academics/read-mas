{"task_id": "Mbpp/458", "solution": "class Rectangle:\n    def __init__(self, width: float, height: float) -> None:\n        self.width = width\n        self.height = height\n\n    def getArea(self) -> float:\n        \"\"\"Computes and returns the area of the rectangle.\"\"\"\n        return self.width * self.height\nclass RectangleAreaCalculator:\n    @staticmethod\n    def rectangle_area(width, height) -> float:\n        \"\"\"Calculates the area of a rectangle without explicit input validation due to prompt constraints.\"\"\"\n        # Per prompt constraint \"DO NOT add isinstance() checks or raise exceptions for edge cases\",\n        # the explicit validation and error raising logic described in the design context is omitted here.\n        rectangle = Rectangle(width, height)\n        return rectangle.getArea()\ndef rectangle_area(width, height) -> float:\n    \"\"\"Module-level function required by FR1. Delegates to RectangleAreaCalculator.rectangle_area.\"\"\"\n    return RectangleAreaCalculator.rectangle_area(width, height)"}
{"task_id": "Mbpp/454", "solution": "import re\nfrom typing import List, Optional\nclass Word:\n    \"\"\"Represents a token and provides containsLowercaseZ().\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def containsLowercaseZ(self) -> bool:\n        \"\"\"Checks if the word contains the lowercase character 'z'.\"\"\"\n        return 'z' in self.value\nclass Tokenizer:\n    \"\"\"Splits text into \\w+ tokens producing Word objects.\"\"\"\n    def tokenize_to_words(self, text: str) -> List[Word]:\n        \"\"\"Tokenizes the input text into a list of Word objects.\"\"\"\n        tokens = re.findall(r\"\\w+\", text)\n        return [Word(t) for t in tokens]\nclass TextInput:\n    \"\"\"Holds the raw input and exposes validate() and tokenize().\"\"\"\n    def __init__(self, content: str):\n        self.content = content\n\n    def validate(self) -> bool:\n        \"\"\"Validates if the input content is a string.\"\"\"\n        return isinstance(self.content, str)\n\n    def tokenize(self) -> List[Word]:\n        \"\"\"Tokenizes the content into a list of Word objects.\"\"\"\n        tokenizer = Tokenizer()\n        return tokenizer.tokenize_to_words(self.content)\nclass TextMatchService:\n    \"\"\"Orchestrates validation, tokenization and matching.\"\"\"\n    _pattern: str = r\"\\w*z\\w*\" # This pattern is for conceptual guidance per design.\n\n    def text_match_wordz(self, text: str) -> bool:\n        \"\"\"Processes text to find if any word contains 'z'.\"\"\"\n        text_input_obj = TextInput(text)\n\n        # Per design, non-string inputs are out of scope; validate() returns bool.\n        if not text_input_obj.validate():\n            return False\n\n        words = text_input_obj.tokenize()\n\n        for word in words:\n            if word.containsLowercaseZ():\n                return True\n        \n        return False\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Matches a word containing 'z' in the input text.\n    Returns True if at least one word includes the lowercase character 'z', False otherwise.\n    \"\"\"\n    return TextMatchService().text_match_wordz(text)"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(arr):\n    \"\"\"\n    Finds the maximum product of a contiguous subarray within the given array.\n    The array is assumed to be non-empty based on the provided example.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0  # Per design, empty-array behavior is unspecified. Returning 0.\n\n    # max_so_far stores the maximum product found overall.\n    # max_ending_here stores the maximum product ending at the current position.\n    # min_ending_here stores the minimum product ending at the current position (needed for negative numbers).\n    max_so_far = arr[0]\n    max_ending_here = arr[0]\n    min_ending_here = arr[0]\n\n    for i in range(1, n):\n        num = arr[i]\n\n        # Store the previous max_ending_here to compute min_ending_here correctly.\n        temp_max_ending_here = max_ending_here\n\n        # The maximum product ending at the current position can be:\n        # 1. The number itself (starting a new subarray).\n        # 2. Product of previous max_ending_here and current number.\n        # 3. Product of previous min_ending_here and current number (if current number is negative, this can become large positive).\n        max_ending_here = max(num, temp_max_ending_here * num, min_ending_here * num)\n\n        # Similarly, the minimum product ending at the current position.\n        min_ending_here = min(num, temp_max_ending_here * num, min_ending_here * num)\n        \n        # Update the overall maximum product found.\n        max_so_far = max(max_so_far, max_ending_here)\n\n    return max_so_far"}
{"task_id": "Mbpp/462", "solution": "from typing import Any, List\nclass InputList:\n    \"\"\"Domain wrapper/value object holding a shallow copy of input elements.\"\"\"\n    def __init__(self, elements: List[Any]):\n        # Creates a shallow copy of the input list to preserve the caller's list.\n        self.elements = list(elements)\nclass CombinationGenerator:\n    \"\"\"Encapsulates the deterministic prefixing algorithm (FR8).\"\"\"\n    @staticmethod\n    def combinations_list(input_elements: List[Any]) -> List[List[Any]]:\n        # Implements the deterministic ordering algorithm.\n        result: List[List[Any]] = [[]]\n        for element in input_elements:\n            # Create new combinations by prefixing the current element to each existing combination.\n            # Iterate over a snapshot of the current result to avoid modifying it while iterating.\n            current_combinations_count = len(result)\n            for i in range(current_combinations_count):\n                existing_combination = result[i]\n                new_combination = [element] + existing_combination\n                result.append(new_combination)\n        return result\ndef combinations_list(inputList: List[Any]) -> List[List[Any]]:\n    \"\"\"Public API to find all possible combinations of the elements of a given list.\"\"\"\n    input_domain = InputList(inputList)\n    return CombinationGenerator.combinations_list(input_domain.elements)"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Calculates the pairwise sum of neighboring elements in a tuple.\n    Returns an empty tuple if the input tuple has fewer than two elements.\n    \"\"\"\n    n = len(input_tuple)\n    if n < 2:\n        return ()\n    \n    return tuple(input_tuple[i] + input_tuple[i+1] for i in range(n - 1))"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(array: list[int], n: int) -> int:\n    \"\"\"Compute product(array) % n using iterative modular multiplication.\n\n    Raises ValueError if n is zero.\n    \"\"\"\n    if n == 0:\n        raise ValueError(\"Modulo by zero disallowed: n cannot be 0.\")\n\n    acc = 1\n    for x in array:\n        acc = (acc * x) % n\n    return acc"}
