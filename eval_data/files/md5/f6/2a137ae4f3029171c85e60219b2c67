{"task_id": "Mbpp/108", "solution": "from typing import List\nfrom dataclasses import dataclass\ndef mergeArrays(a: List[int], b: List[int], c: List[int]) -> List[int]:\n    \"\"\"Merges three lists into a single flat list by concatenation.\"\"\"\n    return a + b + c\ndef sort(elements: List[int]) -> List[int]:\n    \"\"\"Sorts a list of elements in non-decreasing order.\"\"\"\n    return sorted(elements)\ndef merge_sorted_list(list1: List[int], list2: List[int], list3: List[int]) -> List[int]:\n    \"\"\"Merges three lists into a single list and sorts it in ascending order.\"\"\"\n    merged = mergeArrays(list1, list2, list3)\n    sorted_list = sort(merged)\n    return sorted_list"}
{"task_id": "Mbpp/109", "solution": "class BinaryString:\n    \"\"\"Represents and validates an input binary string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\n        self.validate()\n\n    def validate(self) -> bool:\n        \"\"\"Validates that value is non-empty and contains only '0' and '1', raising ValueError on invalid input.\"\"\"\n        if not self.value:\n            raise ValueError(\"Binary string cannot be empty.\")\n        if not all(c in '01' for c in self.value):\n            raise ValueError(\"Binary string must contain only '0' or '1' characters.\")\n        return True\n\n    def charAt(self, idx: int) -> str:\n        \"\"\"Returns the character at the specified index.\"\"\"\n        return self.value[idx]\nclass RotatedString:\n    \"\"\"Represents a rotated string value with its rotation index and provides an oddness check.\"\"\"\n    def __init__(self, value: str, rotationIndex: int):\n        self.value = value\n        self.rotationIndex = rotationIndex\n\n    def isOdd(self) -> bool:\n        \"\"\"Determines if the rotated string represents an odd number (LSB is '1').\"\"\"\n        return self.value[-1] == '1'\nclass RotationOperation:\n    \"\"\"Coordinates the rotation evaluation process and generates RotatedString instances.\"\"\"\n    def __init__(self, rotationsRequested: int):\n        self.rotationsRequested = rotationsRequested\n        self.rotationsPerformed = 0\n        self._last_value: str = \"\" # Stores the string from the previous rotation step.\n\n    def performRotation(self, s: BinaryString) -> RotatedString:\n        \"\"\"Produces the next RotatedString in the sequence, performing a right cyclic rotation if needed.\"\"\"\n        self.rotationsPerformed += 1\n        current_rotation_index = self.rotationsPerformed - 1\n\n        if current_rotation_index == 0:\n            current_value = s.value\n        else:\n            current_value = self._last_value[-1] + self._last_value[:-1]\n        \n        self._last_value = current_value\n        return RotatedString(current_value, current_rotation_index)\nclass ResultCount:\n    \"\"\"Accumulates the count of odd rotated strings and tracks total evaluations.\"\"\"\n    def __init__(self):\n        self.oddCount: int = 0\n        self.totalEvaluated: int = 0\n\n    def toInt(self) -> int:\n        \"\"\"Returns the total count of odd rotated strings.\"\"\"\n        return self.oddCount\ndef odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"\n    Calculates the number of times a binary string, when rotated a given number of times,\n    results in an odd number (LSB == '1').\n    \"\"\"\n    if not isinstance(binary_string, str):\n        raise ValueError(\"binary_string must be a string.\")\n    if not isinstance(rotations, int) or rotations < 1:\n        raise ValueError(\"rotations must be an integer and greater than or equal to 1.\")\n\n    binary_string_obj = BinaryString(binary_string)\n    rotation_op = RotationOperation(rotations)\n    result_count = ResultCount()\n\n    for _ in range(rotations):\n        rotated_str_obj = rotation_op.performRotation(binary_string_obj)\n        if rotated_str_obj.isOdd():\n            result_count.oddCount += 1\n        result_count.totalEvaluated += 1\n\n    return result_count.toInt()"}
{"task_id": "Mbpp/111", "solution": "from typing import List, Set, Any\ndef validate_input(nested: Any) -> bool:\n    \"\"\"\n    Validates if the input is a list of lists of integers.\n    \"\"\"\n    if not isinstance(nested, list):\n        return False\n    for sublist in nested:\n        if not isinstance(sublist, list):\n            return False\n        for item in sublist:\n            if not isinstance(item, int):\n                return False\n    return True\ndef compute_intersection(nested: List[List[int]]) -> Set[int]:\n    \"\"\"\n    Computes the set intersection across provided sublists.\n    Returns an empty set if the input list is empty, any sublist is empty, or no common elements.\n    \"\"\"\n    if not nested:\n        return set()\n\n    # If any sublist is empty, their intersection must be empty\n    if any(not sublist for sublist in nested):\n        return set()\n\n    common_elements = set(nested[0])\n\n    for i in range(1, len(nested)):\n        common_elements = common_elements.intersection(set(nested[i]))\n        # Optimization: if at any point the intersection becomes empty, no further elements can be common.\n        if not common_elements:\n            return set()\n            \n    return common_elements\ndef common_in_nested_lists(list_of_sublists: List[List[int]]) -> List[int]:\n    \"\"\"\n    Finds the common elements in given nested lists, returning them as a list.\n    \"\"\"\n    if not validate_input(list_of_sublists):\n        return []\n\n    # Handle an empty top-level list as per requirements\n    if not list_of_sublists:\n        return []\n\n    common_set = compute_intersection(list_of_sublists)\n    return list(common_set)"}
{"task_id": "Mbpp/113", "solution": "import re\nPATTERN: str = r'^[+-]?\\d+$'\ndef check_integer(input: str) -> bool:\n    \"\"\"\n    Return True if input is a non-empty string that fully matches PATTERN; otherwise return False.\n    Must not raise exceptions for invalid inputs (assumes input is a str).\n    \"\"\"\n    if input == \"\":\n        return False\n    return re.fullmatch(PATTERN, input) is not None"}
{"task_id": "Mbpp/116", "solution": "class Validator:\n    # Validates that the input is a tuple of positive integers.\n    def validate(self, input: tuple) -> bool:\n        if not isinstance(input, tuple):\n            raise TypeError(\"Input must be a tuple.\")\n        if len(input) == 0:\n            raise ValueError(\"Input tuple cannot be empty.\")\n        for element in input:\n            if not isinstance(element, int):\n                raise ValueError(\"All elements in the tuple must be integers.\")\n            if element <= 0:\n                raise ValueError(\"All elements in the tuple must be positive integers (> 0).\")\n        return True\ndef _concatenate_digits(elements: tuple) -> str:\n    # Converts each element to its string representation and concatenates them.\n    return \"\".join(str(e) for e in elements)\ndef tuple_to_int(input: tuple) -> int:\n    # Converts a tuple of positive integers into a single integer by concatenation.\n    validator = Validator()\n    validator.validate(input)\n    concatenated_str = _concatenate_digits(input)\n    return int(concatenated_str)"}
