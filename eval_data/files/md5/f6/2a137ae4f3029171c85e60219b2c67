{"task_id": "Mbpp/589", "solution": "import math\nfrom typing import List, Optional\nclass Range:\n    \"\"\"Holder for start and end integer inputs.\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\nclass InputValidator:\n    \"\"\"Validates that inputs are integers.\"\"\"\n    def isInteger(self, value) -> bool:\n        return isinstance(value, int)\n\n    def validRange(self, range_obj: Range) -> bool:\n        \"\"\"Documents semantic constraints, actual check for start > end is outside.\"\"\"\n        return True\nclass ResultList:\n    \"\"\"Container for computed perfect-square values.\"\"\"\n    def __init__(self, values: Optional[List[int]] = None):\n        self.values = values if values is not None else []\n\n    def count(self) -> int:\n        return len(self.values)\nclass PerfectSquaresFunction:\n    \"\"\"Stateless service to compute all perfect squares in a Range.\"\"\"\n    def compute(self, range_obj: Range) -> ResultList:\n        perfect_squares_found: List[int] = []\n\n        if range_obj.end < 0:\n            return ResultList([])\n\n        # Determine the minimum possible integer root whose square could be in the range.\n        # Squares are non-negative, so lower bound for square is max(0, range_obj.start).\n        min_root = math.ceil(math.sqrt(max(0, range_obj.start)))\n\n        # Determine the maximum possible integer root whose square could be in the range.\n        max_root = math.floor(math.sqrt(range_obj.end))\n\n        for n in range(int(min_root), int(max_root) + 1):\n            square = n * n\n            # Add to list only if the square is within the *original* inclusive range.\n            if range_obj.start <= square <= range_obj.end:\n                perfect_squares_found.append(square)\n        \n        return ResultList(perfect_squares_found)\ndef perfect_squares(start: int, end: int) -> List[int]:\n    \"\"\"\n    Finds perfect squares between two given numbers (inclusive).\n    Raises ValueError if start or end are not integers.\n    \"\"\"\n    validator = InputValidator()\n\n    if not validator.isInteger(start) or not validator.isInteger(end):\n        raise ValueError(\"start and end must be integers\")\n\n    if start > end:\n        return []\n\n    range_obj = Range(start, end)\n    squares_function = PerfectSquaresFunction()\n    result_list = squares_function.compute(range_obj)\n\n    return result_list.values"}
{"task_id": "Mbpp/591", "solution": "def swap_List(input_list):\n    \"\"\"\n    Interchanges the first and last elements in a list.\n    Handles type validation and short lists as specified in the design.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list\")\n\n    list_length = len(input_list)\n\n    if list_length < 2:\n        return input_list\n    else:\n        # Create a new list with the first and last elements swapped\n        # and intermediate elements preserved.\n        return [input_list[-1]] + input_list[1:-1] + [input_list[0]]"}
{"task_id": "Mbpp/590", "solution": "from dataclasses import dataclass\nimport math\nfrom typing import Tuple\nclass PolarRectFunction:\n    def computePolar(self, x: float, y: float) -> PolarCoordinate:\n        \"\"\"Computes r and theta from Cartesian coordinates.\"\"\"\n        r = math.sqrt(x*x + y*y)\n        theta = math.atan2(y, x)\n        return PolarCoordinate(r, theta)\n\n    def computeComplex(self, x: float, y: float) -> RectComplex:\n        \"\"\"Computes the derived complex value based on x and r.\"\"\"\n        polar_coords = self.computePolar(x, y)\n        r = polar_coords.r\n        value = complex(x - r, 0)\n        return RectComplex(value)\ndef polar_rect(x, y) -> Tuple[Tuple[float, float], complex]:\n    \"\"\"Converts Cartesian coordinates to polar coordinates and a derived complex value.\"\"\"\n    converter = PolarRectFunction()\n\n    # Ensure inputs are floats for consistent processing by math functions and internal methods.\n    x_float = float(x)\n    y_float = float(y)\n\n    polar_result = converter.computePolar(x_float, y_float)\n    complex_result = converter.computeComplex(x_float, y_float)\n\n    return ((polar_result.r, polar_result.theta), complex_result.value)"}
{"task_id": "Mbpp/593", "solution": "from typing import List\nclass Octet:\n    \"\"\"Represents an individual octet of an IP address, providing numeric interpretation and normalization.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw: str = raw\n        self.numeric_value: int = int(raw)\n        self.normalized: str = \"\"\n\n    def normalize(self) -> str:\n        \"\"\"Removes leading zeros from the raw octet string and sets the normalized value.\"\"\"\n        self.normalized = str(self.numeric_value)\n        return self.normalized\nclass IPAddress:\n    \"\"\"Represents an IPv4 address, handling parsing, normalization, and reassembly.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw: str = raw\n        self._octets: List[Octet] = []\n        self.normalized: str = \"\"\n\n    def parse(self) -> None:\n        \"\"\"Parses the raw IP string into individual Octet objects.\"\"\"\n        parts = self.raw.split('.')\n        self._octets = [Octet(part) for part in parts]\n\n    def normalize(self) -> None:\n        \"\"\"Calls normalize on each contained Octet and then reassembles the full normalized IP string.\"\"\"\n        for octet in self._octets:\n            octet.normalize()\n        self.normalized = \".\".join([octet.normalized for octet in self._octets])\n\n    def toString(self) -> str:\n        \"\"\"Returns the normalized IP address string.\"\"\"\n        return self.normalized\ndef removezero_ip(ip: str) -> str:\n    \"\"\"\n    Removes leading zeros from each octet of an IP address string.\n    e.g., \"216.08.094.196\" becomes \"216.8.94.196\".\n    \"\"\"\n    ip_addr = IPAddress(ip)\n    ip_addr.parse()\n    ip_addr.normalize()\n    return ip_addr.toString()"}
{"task_id": "Mbpp/594", "solution": "def find_first_even(numbers: list[int]) -> int:\n    \"\"\"Returns the first even number from the list.\"\"\"\n    for num in numbers:\n        if num % 2 == 0:\n            return num\ndef find_first_odd(numbers: list[int]) -> int:\n    \"\"\"Returns the first odd number from the list.\"\"\"\n    for num in numbers:\n        if num % 2 != 0:\n            return num\ndef diff_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the difference of the first even and first odd number of a given list.\n    Assumes the list contains at least one even and one odd number.\n    \"\"\"\n    first_even = find_first_even(numbers)\n    first_odd = find_first_odd(numbers)\n    return first_even - first_odd"}
{"task_id": "Mbpp/592", "solution": "def C(n, k):\n    \"\"\"\n    Computes the binomial coefficient C(n, k) using a multiplicative integer-safe algorithm.\n    Returns 0 if k is out of range (k < 0 or k > n).\n    \"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the product of consecutive binomial coefficients.\n    Computes S = \u03a3_{k=0..n-1} C(n,k) * C(n,k+1).\n    \"\"\"\n    total_sum = 0\n    for k in range(n):\n        term = C(n, k) * C(n, k + 1)\n        total_sum += term\n    return total_sum"}
{"task_id": "Mbpp/596", "solution": "import sys\ndef tuple_size(t) -> int:\n    \"\"\"Return the size in bytes of the tuple t using CPython sys.getsizeof semantics.\n\n    Raises:\n        TypeError: if t is not an instance of tuple.\n    \"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(\"tuple_size requires a tuple instance as input\")\n    return sys.getsizeof(t)"}
{"task_id": "Mbpp/597", "solution": "def find_kth(A, B, k):\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays using a merge-scan approach.\n    This implementation assumes inputs A and B are sorted lists of integers and k is a valid 1-based index within the combined length.\n    \"\"\"\n    len_A = len(A)\n    len_B = len(B)\n    i = 0  # Pointer for array A\n    j = 0  # Pointer for array B\n\n    # Iterate until the k-th element is found\n    while True:\n        # If array A is exhausted, all remaining elements must come from B\n        if i == len_A:\n            return B[j + k - 1]\n        # If array B is exhausted, all remaining elements must come from A\n        if j == len_B:\n            return A[i + k - 1]\n        # If k is 1, the smaller of the current elements is the k-th smallest\n        if k == 1:\n            return min(A[i], B[j])\n\n        # Move the pointer of the smaller element forward and decrement k\n        if A[i] < B[j]:\n            i += 1\n        else:\n            j += 1\n        k -= 1"}
{"task_id": "Mbpp/598", "solution": "class Digit:\n    \"\"\"Represents a single base-10 digit and provides a power operation.\"\"\"\n    def __init__(self, value: int, position: int = None):\n        self.value = value\n        self.position = position\n\n    def pow(self, exponent: int) -> int:\n        \"\"\"Raises the digit's value to the given exponent.\"\"\"\n        return self.value ** exponent\nclass Number:\n    \"\"\"Encapsulates an integer value and provides digit extraction utilities.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def digitCount(self) -> int:\n        \"\"\"Returns the count of base-10 digits in the number.\"\"\"\n        # Use absolute value to correctly count digits for negative numbers.\n        return len(str(abs(self.value)))\n\n    def digits(self) -> list[int]:\n        \"\"\"Returns a list of base-10 digits in the number.\"\"\"\n        # Use absolute value to extract digits for negative numbers.\n        return [int(d) for d in str(abs(self.value))]\nclass ArmstrongChecker:\n    \"\"\"Domain service for checking Armstrong numbers.\"\"\"\n    def isArmstrong(self, n: Number) -> bool:\n        \"\"\"Determines if the given Number is an Armstrong number.\"\"\"\n        computed_sum = self._powerSum(n)\n        # An Armstrong number is typically defined for non-negative integers.\n        # Negative numbers will yield a positive sum of powers, so they won't match the negative original value.\n        return computed_sum == n.value\n\n    def _powerSum(self, n: Number) -> int:\n        \"\"\"Calculates the sum of each digit raised to the power of the digit count.\"\"\"\n        digit_count = n.digitCount()\n        digits_list = n.digits()\n        \n        total_sum = 0\n        for digit_value in digits_list:\n            # Position is not used in the calculation of the power sum.\n            digit_obj = Digit(digit_value) \n            total_sum += digit_obj.pow(digit_count)\n        return total_sum\ndef armstrong_number(n: int) -> bool:\n    \"\"\"Checks whether the given number is an Armstrong number.\"\"\"\n    number_obj = Number(n)\n    checker = ArmstrongChecker()\n    # The ArmstrongChecker.isArmstrong method already returns a boolean.\n    return checker.isArmstrong(number_obj)"}
{"task_id": "Mbpp/599", "solution": "class ValidationError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self) -> str:\n        return f\"ValidationError: {self.message}\"\ndef compute_sum(n: int) -> int:\n    \"\"\"Calculates the sum of the first n natural numbers using the formula.\"\"\"\n    return n * (n + 1) // 2\ndef compute_average(total: int, n: int) -> float:\n    \"\"\"Calculates the average from a given total sum and count.\"\"\"\n    return float(total) / n\ndef sum_average(n):\n    \"\"\"\n    Computes the sum and average of the first n natural numbers.\n    Validates input 'n' and raises ValidationError for invalid inputs.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValidationError(\"Input 'n' must be an integer greater than or equal to 1.\")\n\n    total_sum = compute_sum(n)\n    average = compute_average(total_sum, n)\n\n    return (total_sum, average)"}
