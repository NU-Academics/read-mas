{"task_id": "Mbpp/123", "solution": "class DivisorCalculator:\n    \"\"\"Calculates the sum of proper divisors for a given positive integer.\"\"\"\n    def sum_proper_divisors(self, k: int) -> int:\n        if k <= 1:\n            return 0\n        \n        div_sum = 1  # 1 is always a proper divisor for k > 1\n        i = 2\n        while i * i <= k:\n            if k % i == 0:\n                div_sum += i\n                if i * i != k:\n                    div_sum += k // i\n            i += 1\n        return div_sum\nclass AmicableService:\n    \"\"\"Orchestrates amicable number discovery and sum accumulation.\"\"\"\n    def __init__(self, divisor_calc: DivisorCalculator | None = None) -> None:\n        self._divisor_calc = divisor_calc if divisor_calc is not None else DivisorCalculator()\n        self._seen: set[int] = set()\n\n    def amicable_numbers_sum(self, n: int) -> int:\n        total_amicable_sum = 0\n        for k in range(1, n + 1):\n            if k in self._seen:\n                continue\n\n            partner = self._divisor_calc.sum_proper_divisors(k)\n\n            # Check if partner is a potential candidate (within range and not k itself)\n            if partner != k and 1 <= partner <= n:\n                back = self._divisor_calc.sum_proper_divisors(partner)\n\n                # If back calculation returns k, we found an amicable pair\n                if back == k:\n                    # Add k if not already seen\n                    if k not in self._seen:\n                        total_amicable_sum += k\n                        self._seen.add(k)\n                    # Add partner if not already seen\n                    if partner not in self._seen:\n                        total_amicable_sum += partner\n                        self._seen.add(partner)\n        return total_amicable_sum\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"Sums all amicable numbers from 1 to a specified number n.\"\"\"\n    service = AmicableService(divisor_calc=DivisorCalculator())\n    return service.amicable_numbers_sum(n)"}
