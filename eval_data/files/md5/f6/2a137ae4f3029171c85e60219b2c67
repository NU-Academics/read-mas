{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list:\n    \"\"\"Return a list of sublists grouping adjacent equal elements from input_list.\"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_group = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_group[-1]:\n            current_group.append(input_list[i])\n        else:\n            packed_list.append(current_group)\n            current_group = [input_list[i]]\n\n    packed_list.append(current_group)  # Add the last group\n\n    return packed_list"}
{"task_id": "Mbpp/780", "solution": "from typing import List, Tuple\ndef find_combinations(input_list: List[Tuple[int, int]]) -> List[Tuple[int, int]]:\n    \"\"\"\n    Finds combinations of sums with tuples in the given tuple list.\n    Returns element-wise sums for each unique unordered pair of distinct input tuples, ordered by input index pairs.\n    \"\"\"\n    n = len(input_list)\n    result: List[Tuple[int, int]] = []\n\n    for i in range(n - 1):\n        a1, b1 = input_list[i]\n        for j in range(i + 1, n):\n            a2, b2 = input_list[j]\n            result.append((a1 + a2, b1 + b2))\n            \n    return result"}
{"task_id": "Mbpp/781", "solution": "from dataclasses import dataclass\nfrom typing import List\nimport math\nclass DivisorCalculator:\n    def _validate_input(self, n) -> None:\n        \"\"\"Validates input n for type and value.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input must be an integer.\")\n        if n == 0:\n            raise ValueError(\"Input cannot be zero.\")\n\n    def _compute_divisors(self, n: int) -> List[int]:\n        \"\"\"Computes all positive divisors of |n|.\"\"\"\n        abs_n = abs(n)\n        if abs_n == 1:\n            return [1]\n\n        divisors = set()\n        for i in range(1, int(math.sqrt(abs_n)) + 1):\n            if abs_n % i == 0:\n                divisors.add(i)\n                divisors.add(abs_n // i)\n        return sorted(list(divisors))\n\n    def count_divisors(self, n: int) -> bool:\n        \"\"\"Orchestrates validation, divisor computation, and parity decision.\"\"\"\n        self._validate_input(n)\n        divisors = self._compute_divisors(n)\n        count = len(divisors)\n        is_even = (count % 2 == 0)\n        result = DivisorCountResult(count=count, is_even=is_even)\n        return result.is_even\ndef count_divisors(n) -> bool:\n    \"\"\"Checks whether the count of positive divisors of |n| is even.\"\"\"\n    calculator = DivisorCalculator()\n    return calculator.count_divisors(n)"}
