{"task_id": "Mbpp/90", "solution": "def _compute_length(s: str) -> int:\n    \"\"\"Computes the character count of a given string.\n    This is a module-private helper function.\n    \"\"\"\n    return len(s)\ndef len_log(words: list[str]) -> int:\n    \"\"\"\n    Finds the length of the longest word in a list of strings.\n    Returns 0 if the input list is empty.\n    \"\"\"\n    max_length = 0\n    for word in words:\n        current_length = _compute_length(word)\n        max_length = max(max_length, current_length)\n    return max_length"}
{"task_id": "Mbpp/93", "solution": "from typing import Union\nclass InputValidationError(Exception):\n    def __init__(self, message: str = \"InputValidationError\") -> None:\n        super().__init__(message)\ndef power(a: Union[int, float], b: Union[int, float]) -> float:\n    \"\"\"Calculates 'a' to the power 'b', validating inputs are numeric.\"\"\"\n    if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n        raise InputValidationError(\"Inputs 'a' and 'b' must be numeric (int or float).\")\n    return float(a ** b)"}
{"task_id": "Mbpp/92", "solution": "from typing import List\nclass Number:\n    \"\"\"Represents an integer input and provides digit extraction.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def getDigits(self) -> 'DigitSequence':\n        \"\"\"Extracts decimal digits from self.value as an ordered DigitSequence.\"\"\"\n        # Operates on absolute value to handle negative integers per design context\n        s_value = str(abs(self.value))\n        digits = [int(digit_char) for digit_char in s_value]\n        return DigitSequence(digits)\nclass DigitSequence:\n    \"\"\"Holds an ordered list of decimal digits and provides accessors.\"\"\"\n    def __init__(self, digits: List[int]):\n        self.digits = digits\n\n    def length(self) -> int:\n        \"\"\"Returns the number of digits in the sequence.\"\"\"\n        return len(self.digits)\n\n    def get(self, index: int) -> int:\n        \"\"\"Returns the digit at the specified zero-based index.\"\"\"\n        return self.digits[index]\nclass UndulatingResult:\n    \"\"\"Represents the outcome of an undulating number evaluation.\"\"\"\n    def __init__(self, isUndulating: bool, message: str = \"\"):\n        self.isUndulating = isUndulating\n        self.message = message\nclass UndulatingChecker:\n    \"\"\"Performs the core undulating determination logic.\"\"\"\n    def is_undulating(self, number: Number) -> UndulatingResult:\n        \"\"\"Evaluates if the given number's digits are undulating.\"\"\"\n        seq = number.getDigits()\n        is_undulating_bool = self._checkAlternation(seq)\n        return UndulatingResult(is_undulating_bool)\n\n    def _checkAlternation(self, seq: DigitSequence) -> bool:\n        \"\"\"Private implementation of the digit alternation rule.\"\"\"\n        if seq.length() < 2:\n            return False\n\n        d0 = seq.get(0)\n        d1 = seq.get(1)\n\n        if d0 == d1:\n            return False\n\n        for i in range(seq.length()):\n            expected = d0 if i % 2 == 0 else d1\n            if seq.get(i) != expected:\n                return False\n        \n        return True\ndef is_undulating(n: int) -> bool:\n    \"\"\"\n    Checks whether the given number is undulating.\n    An undulating number strictly alternates between two distinct digits.\n    \"\"\"\n    number_obj = Number(n)\n    checker = UndulatingChecker()\n    result = checker.is_undulating(number_obj)\n    return result.isUndulating"}
{"task_id": "Mbpp/94", "solution": "from typing import Any\nclass TuplePair:\n    \"\"\"Represents a single 2-tuple with fields first and second.\"\"\"\n    def __init__(self, first: Any, second: Any) -> None:\n        self.first = first\n        self.second = second\n\n    def as_tuple(self) -> tuple:\n        \"\"\"Returns the TuplePair as a standard Python tuple.\"\"\"\n        return (self.first, self.second)\nclass TupleList:\n    \"\"\"Container for TuplePair items; provides validation and emptiness checks.\"\"\"\n    def __init__(self, items: list) -> None:\n        self._raw_items = items\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the list is empty.\"\"\"\n        return not bool(self._raw_items)\n\n    def validateAllAre2Tuples(self) -> bool:\n        \"\"\"Validates that all items in the list are 2-tuples or TuplePair instances.\"\"\"\n        if not isinstance(self._raw_items, list):\n            return False\n        for item in self._raw_items:\n            if not (isinstance(item, tuple) and len(item) == 2):\n                if not isinstance(item, TuplePair):\n                    return False\n        return True\n\n    def to_tuples(self) -> list[TuplePair]:\n        \"\"\"Normalizes items to TuplePair instances, preserving input order.\"\"\"\n        converted_items = []\n        for item in self._raw_items:\n            if isinstance(item, TuplePair):\n                converted_items.append(item)\n            else: # Due to prior validation, this must be a 2-tuple\n                converted_items.append(TuplePair(item[0], item[1]))\n        return converted_items\nclass Comparator:\n    \"\"\"Compares TuplePair.second values using natural ordering.\"\"\"\n    def compare(self, a: TuplePair, b: TuplePair) -> int:\n        \"\"\"Compares the 'second' attribute of two TuplePair instances.\"\"\"\n        if a.second < b.second:\n            return -1\n        elif a.second == b.second:\n            return 0\n        else:\n            return 1\ndef index_minimum(list_of_tuples) -> Any:\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple with the smallest second value.\n    Raises ValueError if input is empty or invalid.\n    \"\"\"\n    tuple_list = TupleList(list_of_tuples)\n\n    if not tuple_list.validateAllAre2Tuples():\n        raise ValueError(\"invalid input: expected list of 2-tuples\")\n\n    if tuple_list.isEmpty():\n        raise ValueError(\"input list is empty\")\n\n    items = tuple_list.to_tuples()\n    \n    min_tuple_pair = items[0]\n    comparator = Comparator()\n\n    for i in range(1, len(items)):\n        current_tuple_pair = items[i]\n        if comparator.compare(current_tuple_pair, min_tuple_pair) < 0:\n            min_tuple_pair = current_tuple_pair\n            \n    return min_tuple_pair.first"}
{"task_id": "Mbpp/96", "solution": "from math import isqrt\ndef count_divisors(n_abs):\n    \"\"\"Return count of positive divisors for n_abs >= 1, counting divisor pairs efficiently.\"\"\"\n    count = 0\n    for i in range(1, isqrt(n_abs) + 1):\n        if n_abs % i == 0:\n            if i * i == n_abs:\n                count += 1\n            else:\n                count += 2\n    return count\ndef divisor(n):\n    \"\"\"Returns number of positive divisors of integer n.\"\"\"\n    validate_input(n)\n    n_abs = abs(n)\n    return count_divisors(n_abs)"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists) -> int:\n    \"\"\"Return the length of the shortest inner list in a list of lists.\n    If any inner list has a length of 0, it returns 0 immediately.\n    \"\"\"\n    lengths = []\n    for inner_list in list_of_lists:\n        current_length = len(inner_list)\n        if current_length == 0:\n            return 0\n        lengths.append(current_length)\n\n    return min(lengths)"}
{"task_id": "Mbpp/97", "solution": "from typing import Any, List, Dict\nclass InputValidationError(Exception):\n    \"\"\"Exception raised for invalid input to frequency_lists function.\"\"\"\n    pass\ndef flatten(list_of_lists: List[List[Any]]) -> List[Any]:\n    \"\"\"Flattens a list of lists into a single list.\"\"\"\n    return [item for sublist in list_of_lists for item in sublist]\ndef compute_frequency(flat_list: List[Any]) -> Dict[Any, int]:\n    \"\"\"Computes the frequency of each element in a flat list.\"\"\"\n    frequency_dict = {}\n    for item in flat_list:\n        frequency_dict[item] = frequency_dict.get(item, 0) + 1\n    return frequency_dict\ndef frequency_lists(list_of_lists: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists,\n    returned in a dictionary.\n    \"\"\"\n    if not isinstance(list_of_lists, list):\n        raise InputValidationError(\"Input must be a list.\")\n    for sublist in list_of_lists:\n        if not isinstance(sublist, list):\n            raise InputValidationError(\"All elements of the input list must be lists.\")\n\n    flat_list = flatten(list_of_lists)\n    frequency_dict = compute_frequency(flat_list)\n    return frequency_dict"}
{"task_id": "Mbpp/99", "solution": "class DecimalToBinaryConverter:\n    \"\"\"A stateless component to convert a validated non-negative integer to its binary string representation.\"\"\"\n    def decimal_to_binary(self, n: int) -> str:\n        \"\"\"Converts a non-negative integer to its binary equivalent as a string.\"\"\"\n        if n == 0:\n            return \"0\"\n\n        binary_digits = []\n        while n > 0:\n            binary_digits.append(str(n % 2))\n            n //= 2\n        return \"\".join(reversed(binary_digits))\ndef decimal_to_binary(n: int) -> str:\n    \"\"\"\n    Converts a decimal number to its binary equivalent, represented as a string with no leading zeros.\n    Input must be a non-negative integer.\n    \"\"\"\n    validate_input(n)\n    converter = DecimalToBinaryConverter()\n    return converter.decimal_to_binary(n)"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(sequence):\n    \"\"\"\n    Multiply all numbers in a sequence and divide by its length.\n    Handles validation, product computation, and division.\n    \"\"\"\n    if not sequence:\n        raise ValueError(\"input sequence is empty\")\n\n    for element in sequence:\n        if not isinstance(element, (int, float)):\n            raise TypeError(\"non-numeric element encountered\")\n\n    product = 1.0\n    for num in sequence:\n        product *= num\n\n    return product / len(sequence)"}
{"task_id": "Mbpp/100", "solution": "import math\nclass IntegerInput:\n    def __init__(self, value: int):\n        self.value = value\n\n    def toDigitSequence(self) -> str:\n        return str(self.value)\nclass PalindromeResult:\n    def __init__(self, value: int):\n        self.value = value\nclass PalindromeChecker:\n    def isPalindrome(self, digitSequence: str) -> bool:\n        \"\"\"Checks if a string is a palindrome.\"\"\"\n        return digitSequence == digitSequence[::-1]\n\n    def findNextPalindrome(self, input: int) -> int:\n        \"\"\"Finds the smallest integer strictly greater than input that is a palindrome.\"\"\"\n        candidate = input + 1\n        while True:\n            integer_input = IntegerInput(value=candidate)\n            if self.isPalindrome(integer_input.toDigitSequence()):\n                return candidate\n            candidate += 1\nclass NextSmallestPalindromeService:\n    def __init__(self, checker: PalindromeChecker = None):\n        self._checker = checker or PalindromeChecker()\n\n    def next_smallest_palindrome(self, input: int) -> int:\n        \"\"\"Orchestrates finding the next smallest palindrome and returns the result.\"\"\"\n        next_pal_value = self._checker.findNextPalindrome(input)\n        return PalindromeResult(value=next_pal_value).value\ndef next_smallest_palindrome(input: int) -> int:\n    svc = NextSmallestPalindromeService()\n    return svc.next_smallest_palindrome(input)"}
{"task_id": "Mbpp/101", "solution": "class Error(Exception):\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\nclass Validator:\n    @staticmethod\n    def validate_array(array) -> bool:\n        \"\"\"Return True if array is of an accepted list/sequence type; otherwise False.\"\"\"\n        return isinstance(array, (list, tuple))\n\n    @staticmethod\n    def validate_k(k, length) -> bool:\n        \"\"\"Return True if k is integer and 1 <= k <= length; otherwise False.\"\"\"\n        return isinstance(k, int) and 1 <= k <= length\ndef kth_element(array, k):\n    \"\"\"Validate inputs and return the k-th element using 1-based indexing.\"\"\"\n    if not Validator.validate_array(array):\n        raise Error('array must be a list/sequence')\n\n    if not Validator.validate_k(k, len(array)):\n        raise Error('k must be an integer within 1..len(array)')\n\n    return array[k - 1]"}
{"task_id": "Mbpp/102", "solution": "class Segment:\n    \"\"\"Represents a segment of the split input and provides capitalization operation.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n    def capitalize(self) -> str:\n        return self.text.capitalize()\ndef split_on_underscore(input_str: str) -> list[str]:\n    \"\"\"Split input string on '_' and return list[str].\"\"\"\n    return input_str.split('_')\ndef capitalize_segment(segment_str: str) -> str:\n    \"\"\"Capitalize the first character of a segment; preserve remainder of the segment as-is.\"\"\"\n    segment_obj = Segment(segment_str)\n    return segment_obj.capitalize()\ndef snake_to_camel(input: str) -> str:\n    \"\"\"Convert snake_case string to CamelCase. Parameter 'input' is expected to be a str per SRS.\"\"\"\n    segments = split_on_underscore(input)\n    camel_segments = []\n    for segment_str in segments:\n        capitalized_str = capitalize_segment(segment_str)\n        camel_segments.append(capitalized_str)\n    return \"\".join(camel_segments)"}
