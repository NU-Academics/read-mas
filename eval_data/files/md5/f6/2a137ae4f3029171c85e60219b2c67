{"task_id": "Mbpp/103", "solution": "class ComputationMethod:\n    \"\"\"\n    Computes the Eulerian number using dynamic programming.\n    \"\"\"\n    def __init__(self):\n        self._memo = {}\n\n    def compute(self, n: int, m: int) -> int:\n        \"\"\"\n        Calculates a(n, m) using the recurrence relation with memoization.\n        \"\"\"\n        return self._compute_recursive(n, m)\n\n    def _compute_recursive(self, n: int, m: int) -> int:\n        \"\"\"\n        Recursive helper with memoization for Eulerian number calculation.\n        \"\"\"\n        if (n, m) in self._memo:\n            return self._memo[(n, m)]\n\n        # Base cases\n        if m < 0 or m >= n:\n            self._memo[(n, m)] = 0\n            return 0\n        if n == 1 and m == 0:\n            self._memo[(n, m)] = 1\n            return 1\n        if m == 0:  # A(n,0) = 1 for n >= 1\n            self._memo[(n, m)] = 1\n            return 1\n        if m == n - 1:  # A(n, n-1) = 1 for n >= 1\n            self._memo[(n, m)] = 1\n            return 1\n        \n        # Recurrence relation: A(n, m) = (m + 1) * A(n-1, m) + (n - m) * A(n-1, m-1)\n        result = (m + 1) * self._compute_recursive(n - 1, m) + \\\n                 (n - m) * self._compute_recursive(n - 1, m - 1)\n\n        self._memo[(n, m)] = result\n        return result\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number a(n, m).\n    This function validates inputs and delegates computation.\n    \"\"\"\n    validate_params(n, m)\n    return ComputationMethod().compute(n, m)"}
{"task_id": "Mbpp/104", "solution": "from typing import Sequence, List\ndef sort_sublists(input_sequence: Sequence[Sequence[str]]) -> List[List[str]]:\n    \"\"\"Validates input and returns a new list of lists with each sublist sorted.\n\n    Each sublist's strings are sorted ascending (lexicographic), preserving sublist order.\n    \"\"\"\n    _validate_input(input_sequence)\n\n    result = []\n    for sublist in input_sequence:\n        sorted_sublist = sorted(sublist)\n        result.append(sorted_sublist)\n    return result"}
