{"task_id": "Mbpp/745", "solution": "from typing import List\nclass NumberRange:\n    \"\"\"Represents and validates an inclusive integer range.\"\"\"\n    def __init__(self, startnum: int, endnum: int) -> None:\n        self.startnum = startnum\n        self.endnum = endnum\n\n    def validate(self) -> None:\n        \"\"\"Validates that startnum and endnum are integers, raising ValueError if not.\"\"\"\n        if not isinstance(self.startnum, int) or not isinstance(self.endnum, int):\n            raise ValueError(\"Inputs startnum and endnum must be integers.\")\nclass Digit:\n    \"\"\"Represents a single decimal digit and provides divisibility checks.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def isZero(self) -> bool:\n        \"\"\"Checks if the digit's value is zero.\"\"\"\n        return self.value == 0\n\n    def divides(self, number: int) -> bool:\n        \"\"\"Checks if the digit evenly divides the given number.\"\"\"\n        return number % self.value == 0\nclass Number:\n    \"\"\"Represents a candidate integer and provides digit-based checks.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n        self.digits: List[Digit] = []\n        # Extract digits from absolute value\n        temp_value = abs(value)\n        if temp_value == 0:\n            self.digits.append(Digit(0))\n        else:\n            s_value = str(temp_value)\n            for char_digit in s_value:\n                self.digits.append(Digit(int(char_digit)))\n\n    def allDigitsNonZero(self) -> bool:\n        \"\"\"Checks if all digits in the number are non-zero.\"\"\"\n        for digit_obj in self.digits:\n            if digit_obj.isZero():\n                return False\n        return True\n\n    def eachDigitDividesValue(self) -> bool:\n        \"\"\"Checks if each digit evenly divides the number's value.\"\"\"\n        for digit_obj in self.digits:\n            if not digit_obj.divides(self.value):\n                return False\n        return True\nclass ResultList:\n    \"\"\"Collects qualifying integers and produces a sorted ascending list.\"\"\"\n    def __init__(self) -> None:\n        self.values: List[int] = []\n\n    def add(self, n: int) -> None:\n        \"\"\"Adds a qualifying integer to the list.\"\"\"\n        self.values.append(n)\n\n    def sortAscending(self) -> None:\n        \"\"\"Sorts the collected integers in ascending order.\"\"\"\n        self.values.sort()\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns the collected and sorted integers as a list.\"\"\"\n        return self.values\nclass DivisibleByDigitsFunction:\n    \"\"\"Encapsulates the algorithm to find numbers divisible by their digits.\"\"\"\n    @staticmethod\n    def divisible_by_digits(startnum: int, endnum: int) -> List[int]:\n        \"\"\"\n        Finds numbers within a given range where every number is divisible by every digit it contains.\n        This method delegates the core logic from the module-level function.\n        \"\"\"\n        number_range = NumberRange(startnum, endnum)\n        number_range.validate()\n\n        if startnum > endnum:\n            return []\n\n        result_list = ResultList()\n\n        for n in range(startnum, endnum + 1):\n            number_obj = Number(n)\n\n            if not number_obj.allDigitsNonZero():\n                continue\n\n            if number_obj.eachDigitDividesValue():\n                result_list.add(n)\n\n        result_list.sortAscending()\n        return result_list.to_list()\ndef divisible_by_digits(startnum: int, endnum: int) -> List[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Validates inputs, handles edge cases, and returns a sorted list of qualifying numbers.\n    \"\"\"\n    return DivisibleByDigitsFunction.divisible_by_digits(startnum, endnum)"}
{"task_id": "Mbpp/748", "solution": "from dataclasses import dataclass\nclass Character:\n    \"\"\"Encapsulates single character classification helpers.\"\"\"\n    def __init__(self, char: str):\n        self.char = char\n\n    def is_upper(self) -> bool:\n        \"\"\"Checks if the character is an uppercase letter.\"\"\"\n        return self.char.isupper()\n\n    def is_lower(self) -> bool:\n        \"\"\"Checks if the character is a lowercase letter.\"\"\"\n        return self.char.islower()\n\n    def is_digit(self) -> bool:\n        \"\"\"Checks if the character is a digit.\"\"\"\n        return self.char.isdigit()\nclass CapitalWordsSpacesFunction:\n    \"\"\"Implements the logic to insert spaces before capital letters.\"\"\"\n    def _should_insert_space(self, prev_char: str, curr_char: str) -> bool:\n        \"\"\"Determines if a space should be inserted between two characters.\"\"\"\n        prev_char_obj = Character(prev_char)\n        curr_char_obj = Character(curr_char)\n        return (prev_char_obj.is_lower() or prev_char_obj.is_digit()) and curr_char_obj.is_upper()\n\n    def transform(self, input_str_obj: InputString) -> OutputString:\n        \"\"\"Transforms the input string by inserting spaces as per rules.\"\"\"\n        input_value = input_str_obj.value\n        if not input_value:\n            return OutputString(value=\"\")\n\n        result_chars = []\n        result_chars.append(input_value[0])\n\n        for i in range(1, len(input_value)):\n            prev_char = input_value[i-1]\n            curr_char = input_value[i]\n            if self._should_insert_space(prev_char, curr_char):\n                result_chars.append(' ')\n            result_chars.append(curr_char)\n\n        return OutputString(value=\"\".join(result_chars))\ndef capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Inserts spaces between words starting with capital letters in a given string.\n    This function delegates the transformation to a domain service.\n    \"\"\"\n    input_obj = InputString(input_string)\n    transformer = CapitalWordsSpacesFunction()\n    output_obj = transformer.transform(input_obj)\n    return output_obj.value"}
{"task_id": "Mbpp/749", "solution": "from typing import List\nclass NumericString:\n    \"\"\"Represent an input string that encodes an integer and provide conversion utility.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def toInteger(self) -> int:\n        \"\"\"Converts the string value to an integer.\"\"\"\n        return int(self.value)\nclass OutputList:\n    \"\"\"Domain holder for output items (list of integers).\"\"\"\n    def __init__(self, items: List[int]):\n        self.items = items\nclass Sorter:\n    \"\"\"Coordinates validation, parsing, and numeric sorting of string lists.\"\"\"\n\n    def _validate_input(self, list_of_strings: List[str]) -> bool:\n        \"\"\"Validates that each string in the list represents an integer. Always returns True as per design notes.\"\"\"\n        return True\n\n    def _parse_to_ints(self, list_of_strings: List[str]) -> List[int]:\n        \"\"\"Converts each numeric string in the input list to an integer.\"\"\"\n        integer_values = []\n        for s in list_of_strings:\n            numeric_string_obj = NumericString(s)\n            integer_values.append(numeric_string_obj.toInteger())\n        return integer_values\n\n    def sort_numeric_strings(self, list_of_strings: List[str]) -> List[int]:\n        \"\"\"Parses, validates, and sorts a list of numeric strings numerically.\"\"\"\n        self._validate_input(list_of_strings)\n        parsed_ints = self._parse_to_ints(list_of_strings)\n        parsed_ints.sort()\n        output_list_obj = OutputList(parsed_ints)\n        return output_list_obj.items\ndef sort_numeric_strings(list_of_strings: List[str]) -> List[int]:\n    \"\"\"Sorts a list of strings of numbers numerically, returning a list of integers.\"\"\"\n    sorter = Sorter()\n    return sorter.sort_numeric_strings(list_of_strings)"}
