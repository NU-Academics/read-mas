{"task_id": "Mbpp/569", "solution": "from typing import List\ndef _sort_sublist(sublist: List[str]) -> List[str]:\n    \"\"\"Returns a sorted (lexicographically ascending) copy of sublist.\"\"\"\n    return sorted(sublist)\ndef sort_sublists(inputList: List[List[str]]) -> List[List[str]]:\n    \"\"\"Public API: returns a new List[List[str]] where each sublist is sorted lexicographically ascending and outer list order is preserved.\"\"\"\n    result = []\n    for sublist in inputList:\n        sorted_sub = _sort_sublist(sublist)\n        result.append(sorted_sub)\n    return result"}
{"task_id": "Mbpp/572", "solution": "class FrequencyMap:\n    \"\"\"Helper class to count frequencies of numbers.\"\"\"\n    def __init__(self):\n        self._counts = {}\n\n    def increment(self, value):\n        \"\"\"Increments the count for a given value.\"\"\"\n        self._counts[value] = self._counts.get(value, 0) + 1\n\n    def get_count(self, value) -> int:\n        \"\"\"Returns the count for a given value, or 0 if not present.\"\"\"\n        return self._counts.get(value, 0)\ndef two_unique_nums(input_list):\n    \"\"\"\n    Removes duplicate numbers from a list, returning only numbers that appear exactly once,\n    while preserving their original order.\n    \"\"\"\n    frequency_map = FrequencyMap()\n    for number in input_list:\n        frequency_map.increment(number)\n\n    result_list = []\n    for number in input_list:\n        if frequency_map.get_count(number) == 1:\n            result_list.append(number)\n\n    return result_list"}
{"task_id": "Mbpp/573", "solution": "def unique_product(numbers):\n    \"\"\"\n    unique_product(numbers)\n\n    Parameters:\n    - numbers: list of numeric values (int|float)\n\n    Returns:\n    - numeric result (int or float) which is the product of unique numeric values from the input list\n    \"\"\"\n    unique_nums = set(numbers)\n\n    product = 1\n    for num in unique_nums:\n        product *= num\n\n    return product"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list, sub_list) -> bool:\n    \"\"\"Return True iff sub_list appears as a contiguous subarray within main_list.\n\n    Args:\n        main_list (list): list in which to search\n        sub_list (list): list pattern to search for\n\n    Returns:\n        bool: True if sub_list is a contiguous subarray of main_list; False otherwise\n    \"\"\"\n    if len(sub_list) > len(main_list):\n        # If sub_list is longer than main_list, it cannot be a sub-array.\n        return False\n\n    # Iterate through main_list using a sliding window.\n    # Compare each window slice with sub_list for an exact match.\n    for i in range(len(main_list) - len(sub_list) + 1):\n        if main_list[i : i + len(sub_list)] == sub_list:\n            return True\n\n    # If no contiguous sub-array match is found after checking all windows, return False.\n    return False"}
{"task_id": "Mbpp/577", "solution": "class InputParameter:\n    \"\"\"Encapsulates input validation for n.\"\"\"\n    def __init__(self, n):\n        self._n = n\n\n    def isNonNegative(self) -> bool:\n        \"\"\"Checks if n is a non-negative integer.\"\"\"\n        return isinstance(self._n, int) and self._n >= 0\nclass FactorialComputation:\n    \"\"\"Computes the last digit of n! with optimization.\"\"\"\n    def computeLastDigit(self, n: int) -> int:\n        \"\"\"\n        Computes the last decimal digit of n!.\n        Applies optimization for n >= 5.\n        \"\"\"\n        if n >= 5: # Factorials from 5! onwards end in 0\n            return 0\n        elif n == 0 or n == 1:\n            return 1\n        elif n == 2:\n            return 2\n        elif n == 3:\n            return 6\n        elif n == 4:\n            return 4 # 4! = 24\n        return 0 # Should not be reached given input validation\ndef last_Digit_Factorial(n) -> int:\n    \"\"\"\n    Finds the last digit in factorial of a given number.\n    Validates input and applies optimization for n >= 10.\n    \"\"\"\n    input_param = InputParameter(n)\n    if not input_param.isNonNegative():\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    computation = FactorialComputation()\n    result_digit = computation.computeLastDigit(n)\n\n    return result_digit"}
{"task_id": "Mbpp/578", "solution": "class ListInput:\n    \"\"\"Represents an input list as a domain object.\"\"\"\n    def __init__(self, items: list) -> None:\n        self.items = items\n\n    def get_item(self, index: int) -> object:\n        \"\"\"Retrieves an item by index.\"\"\"\n        return self.items[index]\n\n    @property\n    def length(self) -> int:\n        \"\"\"Returns the length of the list.\"\"\"\n        return len(self.items)\nclass OutputList:\n    \"\"\"Represents the produced flat interleaved output list.\"\"\"\n    def __init__(self, items: list) -> None:\n        self.items = items\n\n    @property\n    def length(self) -> int:\n        \"\"\"Returns the length of the output list.\"\"\"\n        return len(self.items)\nclass Interleaver:\n    \"\"\"Encapsulates the interleaving algorithm and validation logic.\"\"\"\n    def interleave(self, listA: ListInput, listB: ListInput, listC: ListInput) -> OutputList:\n        \"\"\"Interleaves three equal-length lists into a single flat list.\"\"\"\n        if not self.validate_equal_length(listA, listB, listC):\n            raise ValueError(\"Input lists must have equal length.\")\n\n        result_items = []\n        for i in range(listA.length):\n            result_items.append(listA.get_item(i))\n            result_items.append(listB.get_item(i))\n            result_items.append(listC.get_item(i))\n        \n        return OutputList(result_items)\n\n    def validate_equal_length(self, listA: ListInput, listB: ListInput, listC: ListInput) -> bool:\n        \"\"\"Validates that all three input lists have the same length.\"\"\"\n        return listA.length == listB.length == listC.length\ndef interleave_lists(listA, listB, listC):\n    \"\"\"Public API: Accepts three lists and returns a flat interleaved list.\"\"\"\n    list_input_a = ListInput(listA)\n    list_input_b = ListInput(listB)\n    list_input_c = ListInput(listC)\n\n    interleaver = Interleaver()\n    output_list = interleaver.interleave(list_input_a, list_input_b, list_input_c)\n    \n    return output_list.items"}
{"task_id": "Mbpp/579", "solution": "def _select_from_first(a: tuple, set_b: set) -> list:\n    \"\"\"Collects elements from tuple 'a' that are not present in set 'set_b'.\"\"\"\n    result = []\n    for item_a in a:\n        if item_a not in set_b:\n            result.append(item_a)\n    return result\ndef _select_from_second(b: tuple, set_a: set) -> list:\n    \"\"\"Collects elements from tuple 'b' that are not present in set 'set_a'.\"\"\"\n    result = []\n    for item_b in b:\n        if item_b not in set_a:\n            result.append(item_b)\n    return result\ndef find_dissimilar(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Finds dissimilar elements between two tuples, preserving order and duplicates.\n    Elements from 'a' not in 'b' come first, then elements from 'b' not in 'a'.\n    \"\"\"\n    _validate_inputs(a, b)\n\n    set_a = set(a)\n    set_b = set(b)\n\n    selected_from_a = _select_from_first(a, set_b)\n    selected_from_b = _select_from_second(b, set_a)\n\n    return tuple(selected_from_a + selected_from_b)"}
{"task_id": "Mbpp/580", "solution": "from typing import Tuple, Any\ndef _is_even(n: int) -> bool:\n    \"\"\"Return True if n is even.\"\"\"\n    return n % 2 == 0\ndef _process_tuple(input_tuple: tuple) -> tuple:\n    \"\"\"Internal recursive helper returning a new tuple (never returns lists).\"\"\"\n    result_elements = []\n    for item in input_tuple:\n        if isinstance(item, int):\n            if _is_even(item):\n                result_elements.append(item)\n        elif isinstance(item, tuple):\n            processed_nested_tuple = _process_tuple(item)\n            result_elements.append(processed_nested_tuple)\n        else:\n            raise TypeError(\"Tuple elements must be integers or tuples.\")\n    return tuple(result_elements)\ndef extract_even(input: tuple) -> tuple:\n    \"\"\"Public API. Accepts nested tuple composed of ints and tuples and returns tuple.\"\"\"\n    if not isinstance(input, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n    return _process_tuple(input)"}
{"task_id": "Mbpp/581", "solution": "import math\nclass SquarePyramid:\n    \"\"\"\n    A class to represent a square pyramid and compute its geometric properties.\n    \"\"\"\n    def __init__(self, base_edge: float, height: float):\n        self.base_edge: float = base_edge\n        self.height: float = height\n        self.slant_height: float = 0.0\n        self.base_area: float = 0.0\n        self.lateral_area: float = 0.0\n\n    def compute_slant_height(self) -> float:\n        \"\"\"\n        Computes the slant height of the pyramid.\n        \"\"\"\n        self.slant_height = math.sqrt((self.base_edge / 2) ** 2 + (self.height) ** 2)\n        return self.slant_height\n\n    def compute_areas(self) -> None:\n        \"\"\"\n        Computes the base area and lateral area of the pyramid.\n        Requires slant_height to be computed first.\n        \"\"\"\n        self.base_area = self.base_edge ** 2\n        self.lateral_area = 2 * self.base_edge * self.slant_height\n\n    def total_surface_area(self) -> float:\n        \"\"\"\n        Returns the total surface area of the pyramid.\n        \"\"\"\n        return self.base_area + self.lateral_area\ndef surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the total surface area of a square pyramid given its base edge and height.\n    \"\"\"\n    if not isinstance(base_edge, (int, float)):\n        raise TypeError(\"base_edge must be numeric (int or float)\")\n    if not isinstance(height, (int, float)):\n        raise TypeError(\"height must be numeric (int or float)\")\n\n    sp = SquarePyramid(float(base_edge), float(height))\n    sp.compute_slant_height()\n    sp.compute_areas()\n    return sp.total_surface_area()"}
{"task_id": "Mbpp/583", "solution": "def _fallback_binomial(n: int, k: int) -> int:\n    \"\"\"\n    Computes binomial coefficient C(n, k) using integer arithmetic.\n    \"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\nclass Validator:\n    \"\"\"\n    Validates input parameters for Catalan number computation.\n    \"\"\"\n    def isInteger(self, value) -> bool:\n        return isinstance(value, int)\n\n    def isNonNegative(self, n: int) -> bool:\n        return n >= 0\nclass CatalanFunction:\n    \"\"\"\n    Provides methods to compute Catalan numbers using different strategies.\n    \"\"\"\n    def catalan_number(self, n: int) -> int:\n        \"\"\"Delegates to the preferred computation strategy.\"\"\"\n        return self.compute_binomial(n)\n\n    def compute_binomial(self, n: int) -> int:\n        \"\"\"\n        Computes C_n = C(2n, n) / (n + 1) using binomial coefficients.\n        \"\"\"\n        if _has_math_comb:\n            binom = _math_comb(2 * n, n)\n        else:\n            binom = _fallback_binomial(2 * n, n)\n        \n        return binom // (n + 1)\n\n    def compute_recurrence(self, n: int) -> int:\n        \"\"\"\n        Computes Catalan numbers using the recurrence relation C_n = sum(Ci * C_{n-1-i}).\n        \"\"\"\n        if n == 0:\n            return 1\n        \n        catalan = [0] * (n + 1)\n        catalan[0] = 1\n\n        for i in range(1, n + 1):\n            for j in range(i):\n                catalan[i] += catalan[j] * catalan[i - 1 - j]\n        \n        return catalan[n]\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Returns the nth Catalan number.\n    Input n must be an integer >= 0.\n    \"\"\"\n    validator = Validator()\n    if not validator.isInteger(n):\n        raise ValueError(\"n must be an integer.\")\n    if not validator.isNonNegative(n):\n        raise ValueError(\"n must be a non-negative integer (n >= 0).\")\n\n    catalan_calc = CatalanFunction()\n    return catalan_calc.catalan_number(n)"}
{"task_id": "Mbpp/585", "solution": "import copy\nfrom typing import List, Mapping, Any\ndef expensive_items(dataset: List[Mapping[str, Any]], n: int) -> List[Mapping[str, Any]]:\n    \"\"\"\n    Finds the n most expensive items in a given dataset, preserving the original dataset.\n    Items are sorted by price in descending order.\n    \"\"\"\n    _validate_inputs(dataset, n)\n    copied_dataset = _make_shallow_copy(dataset)\n    sorted_items = _sort_by_price_desc(copied_dataset)\n    return _select_top_n(sorted_items, n)\ndef _make_shallow_copy(dataset: List[Mapping[str, Any]]) -> List[Mapping[str, Any]]:\n    \"\"\"\n    Returns a shallow copy of the input dataset list.\n    \"\"\"\n    return list(dataset)\ndef _sort_by_price_desc(items: List[Mapping[str, Any]]) -> List[Mapping[str, Any]]:\n    \"\"\"\n    Sorts a list of items by their 'price' in descending order (stable sort).\n    \"\"\"\n    return sorted(items, key=lambda x: x['price'], reverse=True)\ndef _select_top_n(sorted_items: List[Mapping[str, Any]], n: int) -> List[Mapping[str, Any]]:\n    \"\"\"\n    Selects the first n elements from a sorted list, or all elements if n is larger than the list's length.\n    \"\"\"\n    return sorted_items[:n]"}
{"task_id": "Mbpp/586", "solution": "def validate_n(n: int, length: int) -> int:\n    \"\"\"Normalize split count n based on list length.\"\"\"\n    if length == 0:\n        return 0\n    return n % length\ndef perform_split(list_input: list, n: int) -> list:\n    \"\"\"Perform the list rotation: if n is 0 or list length, return a copy; otherwise, slice and concatenate.\"\"\"\n    if not list_input or n == 0:\n        return list_input[:]\n    return list_input[n:] + list_input[:n]\ndef split_Arr(list_input: list, n: int) -> list:\n    \"\"\"Splits a list at the nth element and adds the first part to the end.\"\"\"\n    effective_n = validate_n(n, len(list_input))\n    return perform_split(list_input, effective_n)"}
