{"task_id": "Mbpp/607", "solution": "import re\ndef find_literals(source_string, pattern_string):\n    \"\"\"\n    Searches a string for a regex pattern and returns the matched substring, start index, and end index.\n    The end index is exclusive.\n    \"\"\"\n    match = re.search(pattern_string, source_string)\n    if match:\n        return (match.group(0), match.start(), match.end())\n    return None # Behavior for no match is unspecified; returning None is a reasonable default."}
{"task_id": "Mbpp/608", "solution": "class InputParameter:\n    \"\"\"Encapsulates input n and validation logic.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def validate(self) -> bool:\n        \"\"\"Validates if n is a non-negative integer.\"\"\"\n        return isinstance(self.n, int) and self.n >= 0\nclass BellNumber:\n    \"\"\"Value object for computed Bell number.\"\"\"\n    def __init__(self, n: int, value: int):\n        self.n = n\n        self.value = value\nclass CalculationEngine:\n    \"\"\"Computes nth Bell number deterministically using dynamic programming (Stirling numbers).\"\"\"\n    def __init__(self):\n        self._use_dp = True\n\n    def use_dynamic_programming(self):\n        \"\"\"Configures or indicates dynamic programming usage.\"\"\"\n        self._use_dp = True\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Computes the nth Bell number using Stirling numbers of the second kind.\n        B_n = sum_{k=0 to n} S(n, k)\n        S(n, k) = S(n-1, k-1) + k * S(n-1, k)\n        \"\"\"\n        if n == 0:\n            return BellNumber(0, 1).value\n        \n        # stirling[i][k] will store S(i, k)\n        # Dimensions: (n+1) rows, (n+1) columns (0 to n for both i and k)\n        stirling = [[0] * (n + 1) for _ in range(n + 1)]\n        \n        # Base case for Stirling numbers of the second kind: S(0, 0) = 1\n        stirling[0][0] = 1\n\n        for i in range(1, n + 1):\n            # S(i, 0) = 0 for i > 0\n            stirling[i][0] = 0\n            for k in range(1, i + 1):\n                # S(i, k) = S(i-1, k-1) + k * S(i-1, k)\n                stirling[i][k] = stirling[i-1][k-1] + k * stirling[i-1][k]\n        \n        # The nth Bell number is the sum of S(n, k) for k from 0 to n\n        nth_bell_number = sum(stirling[n][k] for k in range(n + 1))\n        \n        return BellNumber(n, nth_bell_number).value\ndef bell_Number(n):\n    \"\"\"\n    Calculates the nth Bell number.\n    Raises ValueError if n is not a non-negative integer.\n    \"\"\"\n    input_param = InputParameter(n)\n    if not input_param.validate():\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    \n    engine = CalculationEngine()\n    \n    return engine.compute(n)"}
{"task_id": "Mbpp/610", "solution": "def _create_result(input_list, k) -> list:\n    \"\"\"Creates a new list with the k'th (1-based) element removed.\"\"\"\n    index_to_remove = k - 1\n    return input_list[:index_to_remove] + input_list[index_to_remove+1:]\ndef remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"\n    Returns a new list with the k'th (1-based) element removed from input_list.\n    Raises TypeError if k is not an int, or ValueError if k is out of range.\n    \"\"\"\n    _validate_k(k, input_list)\n    return _create_result(input_list, k)"}
{"task_id": "Mbpp/611", "solution": "class ValidationError(Exception):\n    \"\"\"Error type raised when input validation fails.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass Row:\n    \"\"\"Represents a row and provides element access.\"\"\"\n    def __init__(self, values: list):\n        self.values = values\n\n    def get(self, n: int):\n        \"\"\"Returns the value at index n.\"\"\"\n        return self.values[n]\nclass Matrix:\n    \"\"\"Represents a matrix (rows) and provides methods to check emptiness and get columns.\"\"\"\n    def __init__(self, rows: list[list]):\n        self.rows = rows\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the matrix has no rows.\"\"\"\n        return not self.rows\n\n    def get_column(self, n: int) -> list:\n        \"\"\"Returns a list of values at column index n from each row.\"\"\"\n        column_values = []\n        for row_list in self.rows:\n            row = Row(row_list)\n            column_values.append(row.get(n))\n        return column_values\nclass Column:\n    \"\"\"Represents a logical column with its index and values, and computes aggregates.\"\"\"\n    def __init__(self, index: int, values: list):\n        self.index = index\n        self.values = values\n\n    def max(self):\n        \"\"\"Returns the maximum numeric value within the column.\"\"\"\n        return max(self.values)\ndef max_of_nth(matrix: list[list], n: int):\n    \"\"\"\n    Returns the maximum value found in the n-th column of a matrix.\n    Raises ValidationError for an empty matrix or if any row does not contain an element at index n.\n    \"\"\"\n    # Validate that the matrix is not empty.\n    if not matrix:\n        raise ValidationError(\"Matrix cannot be empty.\")\n\n    # Validate that each row has an element at the specified column index n.\n    for i, row_list in enumerate(matrix):\n        try:\n            # Attempt to access the element to check if 'n' is a valid index for the row.\n            _ = row_list[n]\n        except IndexError:\n            raise ValidationError(f\"Row at index {i} does not have an element at column {n}.\")\n\n    # Use domain objects to perform the extraction and computation.\n    matrix_obj = Matrix(matrix)\n    column_values = matrix_obj.get_column(n)\n    column_obj = Column(index=n, values=column_values)\n    max_value = column_obj.max()\n\n    return max_value"}
{"task_id": "Mbpp/612", "solution": "from typing import List, Any\ndef merge(input_list: List[List[Any]]) -> List[List[Any]]:\n    \"\"\"\n    Splits a list of 2-element sublists into two separate lists.\n    The first output list contains all first elements, and the second contains all second elements, preserving order.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n\n    for sublist in input_list:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n\n    return [first_elements, second_elements]"}
