{"task_id": "Mbpp/119", "solution": "from typing import List\ndef search(items: List[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear twice.\n    The function assumes the input list adheres to the preconditions: it's sorted,\n    contains integers, and exactly one element appears once while others appear twice.\n    \"\"\"\n    for i in range(0, len(items) - 1, 2):\n        if items[i] != items[i+1]:\n            # If the current element does not match the next, it must be the unique element.\n            return items[i]\n    \n    # If the loop completes, the unique element must be the last one in the array.\n    return items[-1]"}
{"task_id": "Mbpp/120", "solution": "from typing import List, Tuple, Union\nimport math\nclass Result:\n    \"\"\"Holds the final maximum absolute product.\"\"\"\n    def __init__(self, max_abs_product: float):\n        self.max_abs_product = max_abs_product\nclass Product:\n    \"\"\"Holds a numeric product value and provides its absolute value.\"\"\"\n    def __init__(self, value: Union[int, float]):\n        self.value = float(value)\n\n    def abs_value(self) -> float:\n        return abs(self.value)\nclass TuplePair:\n    \"\"\"Represents a two-element numeric pair and provides product computation.\"\"\"\n    def __init__(self, a: Union[int, float], b: Union[int, float]):\n        if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n            raise ValueError(\"Tuple elements must be numeric (int or float).\")\n        self.a = float(a)\n        self.b = float(b)\n\n    def product(self) -> float:\n        return self.a * self.b\nclass MaxProductFunction:\n    \"\"\"Coordinates processing of a list of TuplePair instances and computes the maximum absolute product.\"\"\"\n    def compute(self, input_pairs: List[Tuple[Union[int, float], Union[int, float]]]) -> Result:\n        max_abs_prod = -math.inf # Initialize with negative infinity for correct max comparison\n\n        for pair_tuple in input_pairs:\n            try:\n                tuple_pair = TuplePair(pair_tuple[0], pair_tuple[1])\n            except ValueError as e:\n                # Re-raise with context if TuplePair validation fails due to non-numeric elements.\n                raise ValueError(f\"Invalid numeric element in tuple {pair_tuple}: {e}\") from e\n            \n            prod_value = tuple_pair.product()\n            prod_obj = Product(prod_value)\n            \n            abs_prod = prod_obj.abs_value()\n            \n            if abs_prod > max_abs_prod:\n                max_abs_prod = abs_prod\n        \n        return Result(max_abs_prod)\ndef max_product_tuple(input_list: list) -> float:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    Raises ValueError for invalid inputs (empty list, non-tuple items, incorrect tuple length, non-numeric elements).\n    \"\"\"\n    if not input_list:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    validated_raw_tuples: List[Tuple[Union[int, float], Union[int, float]]] = []\n    for i, item in enumerate(input_list):\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise ValueError(\n                f\"Item at index {i} is not a two-element tuple. \"\n                f\"Found: {item} of type {type(item)} and length {len(item) if isinstance(item, tuple) else 'N/A'}.\"\n            )\n        # Type validation for elements will happen inside TuplePair constructor called by MaxProductFunction.\n        validated_raw_tuples.append(item)\n    \n    max_product_func = MaxProductFunction()\n    result_obj = max_product_func.compute(validated_raw_tuples)\n    return result_obj.max_abs_product"}
