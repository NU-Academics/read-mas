{"task_id": "Mbpp/602", "solution": "def first_repeated_char(input: str) -> str:\n    \"\"\"\n    Finds the first character that repeats in the given string.\n    Raises TypeError if input is not a string, ValueError if no character repeats.\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"input must be a str\")\n    seen = set()\n    for ch in input:\n        if ch in seen:\n            return ch\n        seen.add(ch)\n    raise ValueError(\"no repeated character found\")"}
{"task_id": "Mbpp/603", "solution": "class Validator:\n    @staticmethod\n    def validate_integer(value) -> None:\n        \"\"\"Raises TypeError if value is not an int.\"\"\"\n        if not isinstance(value, int):\n            raise TypeError('n must be an integer')\nclass Result:\n    def __init__(self, numbers: list[int]) -> None:\n        self._numbers = list(numbers)\n\n    def to_list(self) -> list:\n        \"\"\"Returns a shallow copy of internal numbers as a Python list.\"\"\"\n        return list(self._numbers)\nclass LudicNumberSequence:\n    def __init__(self) -> None:\n        self._ludic_numbers = []\n\n    def append(self, v: int) -> None:\n        \"\"\"Appends a number to the internal list of ludic numbers.\"\"\"\n        self._ludic_numbers.append(v)\n\n    def is_ludic(self, v: int) -> bool:\n        \"\"\"Checks if a number is already identified as ludic.\"\"\"\n        return v in self._ludic_numbers\n\n    def compute_up_to(self, n: int) -> Result:\n        \"\"\"Deterministically computes ludic numbers up to n using a sieve and returns a Result.\"\"\"\n        if n < 1:\n            return Result([])\n\n        candidates = list(range(1, n + 1))\n        self._ludic_numbers = []\n\n        if not candidates:\n            return Result([])\n\n        self.append(1)\n        candidates.remove(1)\n\n        temp_candidates = candidates\n\n        while temp_candidates and temp_candidates[0] <= n:\n            current_ludic = temp_candidates[0]\n            self.append(current_ludic)\n            temp_candidates.pop(0)\n\n            p = current_ludic\n            if p == 0: # Should not happen with current ludic numbers, but defensive.\n                continue\n\n            to_remove_indices = []\n            for i in range(p - 1, len(temp_candidates), p):\n                to_remove_indices.append(i)\n\n            new_temp_candidates = []\n            for i, val in enumerate(temp_candidates):\n                if i not in to_remove_indices:\n                    new_temp_candidates.append(val)\n            temp_candidates = new_temp_candidates\n\n        return Result(self._ludic_numbers)\ndef get_ludic(n: int) -> list:\n    \"\"\"\n    Public API that validates input and returns ludic numbers <= n as a standard list.\n    Raises TypeError for non-integer inputs.\n    \"\"\"\n    Validator.validate_integer(n)\n\n    if n < 1:\n        return []\n\n    ludic_generator = LudicNumberSequence()\n    result_obj = ludic_generator.compute_up_to(n)\n    return result_obj.to_list()"}
