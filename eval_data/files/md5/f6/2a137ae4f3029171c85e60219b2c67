{"task_id": "Mbpp/261", "solution": "class Validator:\n    @staticmethod\n    def validate_length(tuple1, tuple2) -> None:\n        if len(tuple1) != len(tuple2):\n            raise ValueError(\"Input tuples must have the same length\")\n    @staticmethod\n    def validate_no_zero_denominator(tuple2) -> None:\n        for v in tuple2:\n            if v == 0:\n                raise ZeroDivisionError(\"Denominator contains zero\")\ndef division_elements(tuple1, tuple2) -> tuple:\n    \"\"\"\n    Performs element-wise division of two tuples, coercing mathematically integer floats to ints.\n    Raises TypeError, ValueError, or ZeroDivisionError for invalid inputs.\n    \"\"\"\n    # Parameter type enforcement\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples\")\n    # Validations\n    Validator.validate_length(tuple1, tuple2)\n    Validator.validate_no_zero_denominator(tuple2)\n    # Division and coercion\n    results = []\n    for a, b in zip(tuple1, tuple2):\n        q = a / b  # Python 3 numeric division\n        # If q is float and mathematically integer, coerce to int\n        if isinstance(q, float) and q.is_integer():\n            results.append(int(q))\n        else:\n            results.append(q)\n    return tuple(results)"}
{"task_id": "Mbpp/266", "solution": "class Cube:\n    \"\"\"Represents a cube and provides methods for its geometric calculations.\"\"\"\n    def __init__(self, side: float):\n        self.side: float = side\n\n    def lateralSurface(self) -> float:\n        \"\"\"Calculates the lateral surface area of the cube.\"\"\"\n        return 4 * (self.side ** 2)\nclass LateralSurfaceService:\n    \"\"\"Service class for calculating the lateral surface area of a cube.\"\"\"\n    def lateralsurface_cube(self, side: float) -> float:\n        \"\"\"Calculates the lateral surface area of a cube using an instance method.\"\"\"\n        cube = Cube(side)\n        return cube.lateralSurface()\n\n    @staticmethod\n    def lateralsurface_cube_static(side: float) -> float:\n        \"\"\"Calculates the lateral surface area of a cube using a static method.\"\"\"\n        cube = Cube(side)\n        return cube.lateralSurface()\ndef lateralsurface_cube(side: float) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cube given its side length.\n    Delegates the calculation to a service class.\n    \"\"\"\n    return LateralSurfaceService.lateralsurface_cube_static(side)"}
{"task_id": "Mbpp/260", "solution": "class NewmanShanksWilliamsSequence:\n    \"\"\"\n    Generates Newman\u2013Shanks\u2013Williams (NSW) sequence values using recurrence.\n    S0 = 1, S1 = 1, S_n = 2*S_{n-1} + S_{n-2}.\n    \"\"\"\n    def __init__(self):\n        # Initialize cache with S0 and S1 (0-based indexing)\n        self._sequence_cache = [1, 1] \n\n    def generate_up_to_index(self, target_index: int) -> None:\n        \"\"\"\n        Generates and caches NSW sequence values up to the given target_index (0-based).\n        \"\"\"\n        # Target index must be non-negative for internal consistency; \n        # external validation handles n < 1 for 1-based input.\n        while len(self._sequence_cache) <= target_index:\n            s_prev_prev = self._sequence_cache[-2]\n            s_prev = self._sequence_cache[-1]\n            s_curr = 2 * s_prev + s_prev_prev\n            self._sequence_cache.append(s_curr)\n\n    def get(self, index: int) -> int:\n        \"\"\"\n        Returns the NSW sequence value at the given 0-based index.\n        For newman_prime(n) (1-based n), this retrieves S_n (cache[n]).\n        \"\"\"\n        if index >= len(self._sequence_cache):\n            self.generate_up_to_index(index)\n        return self._sequence_cache[index]\nclass NewmanPrimeFunction:\n    \"\"\"\n    Helper class for Newman\u2013Shanks\u2013Williams prime number related utilities.\n    Encapsulates input validation logic for the newman_prime function.\n    \"\"\"\n    @staticmethod\n    def validate_input(n) -> None:\n        \"\"\"\n        Validates the input n for the newman_prime function.\n        Raises TypeError if n is not an integer, ValueError if n < 1.\n        \"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if n < 1:\n            raise ValueError(\"Input 'n' must be a positive integer (1-based index).\")\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman\u2013Shanks\u2013Williams (NSW) number S_n.\n    'n' is a 1-based index, so newman_prime(3) returns S_3 (which is 7).\n    \"\"\"\n    NewmanPrimeFunction.validate_input(n)\n    \n    sequence_generator = NewmanShanksWilliamsSequence()\n    value = sequence_generator.get(n)\n    \n    return value"}
{"task_id": "Mbpp/265", "solution": "from typing import List, Any, Iterable\nclass Element:\n    \"\"\"Represents a single input element and its original index.\"\"\"\n    def __init__(self, value: Any, index: int) -> None:\n        self.value = value\n        self.index = index\nclass ListInput:\n    \"\"\"Encapsulates the input iterable/list as Element instances.\"\"\"\n    def __init__(self, elements_iterable: Iterable) -> None:\n        self.elements: List[Element] = []\n        for i, value in enumerate(elements_iterable):\n            self.elements.append(Element(value, i))\n\n    def __len__(self) -> int:\n        return len(self.elements)\nclass Sublist:\n    \"\"\"Collects Element instances assigned to this sublist.\"\"\"\n    def __init__(self) -> None:\n        self.elements: List[Element] = []\n\n    def append(self, element: Element) -> None:\n        self.elements.append(element)\n\n    def size(self) -> int:\n        return len(self.elements)\n\n    def to_list(self) -> List[Any]:\n        \"\"\"Converts collected elements to a plain Python list of values.\"\"\"\n        return [e.value for e in self.elements]\nclass ListSplitter:\n    \"\"\"Implements validation and distribution logic.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate_n(self, n: int) -> None:\n        \"\"\"Validates the integer n. (Validation logic skipped due to prompt constraints).\"\"\"\n        pass\n\n    def distribute(self, input_list_obj: ListInput, n: int) -> List[Sublist]:\n        \"\"\"Distributes elements into n sublists based on (index mod n).\"\"\"\n        sublists: List[Sublist] = [Sublist() for _ in range(n)]\n\n        for element in input_list_obj.elements:\n            target_sublist_index = element.index % n\n            sublists[target_sublist_index].append(element)\n\n        return sublists\n\n    def list_split(self, input_list_obj: ListInput, n: int) -> List[Sublist]:\n        \"\"\"Orchestrates validation and distribution.\"\"\"\n        self.validate_n(n)\n        return self.distribute(input_list_obj, n)\ndef list_split(input_list, n):\n    \"\"\"Splits a list into n sublists based on element index modulo n.\"\"\"\n    list_input_obj = ListInput(input_list)\n    splitter = ListSplitter()\n    sublists = splitter.list_split(list_input_obj, n)\n\n    return [s.to_list() for s in sublists]"}
{"task_id": "Mbpp/268", "solution": "class FindStarFunction:\n    \"\"\"Encapsulates the logic for computing star numbers.\"\"\"\n\n    def _compute_formula(self, n: int) -> int:\n        \"\"\"Computes the n-th star number using the mathematical formula.\"\"\"\n        return 6 * n * (n - 1) + 1\n\n    def find_star_num(self, n: int) -> int:\n        \"\"\"Internal method to find the n-th star number, without external validation.\"\"\"\n        return self._compute_formula(n)\ndef find_star_num(n: int) -> int:\n    \"\"\"Finds the n'th star number (1-based indexing).\"\"\"\n    finder = FindStarFunction()\n    return finder.find_star_num(n)"}
{"task_id": "Mbpp/267", "solution": "class OddNumber:\n    \"\"\"Helper class to get the k-th odd natural number.\"\"\"\n    @staticmethod\n    def kth(k: int) -> int:\n        return 2 * k - 1\nclass Sequence:\n    \"\"\"Helper class to generate a sequence of odd numbers.\"\"\"\n    @staticmethod\n    def generate(n: int):\n        for k in range(1, n + 1):\n            yield OddNumber.kth(k)\ndef square_Sum(n):\n    \"\"\"\n    Calculates the sum of the squares of the first n odd natural numbers.\n    Handles n=0 by returning 0, and assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    total_sum = 0\n    for odd_num in Sequence.generate(n):\n        total_sum += odd_num * odd_num\n\n    return total_sum"}
