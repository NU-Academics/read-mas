{"task_id": "Mbpp/286", "solution": "class InvalidTypeError(Exception):\n    \"\"\"Raised when an input has an invalid type.\"\"\"\n    pass\nclass LengthMismatchError(Exception):\n    \"\"\"Raised when the provided length n does not match len(arr).\"\"\"\n    pass\nclass InvalidKError(Exception):\n    \"\"\"Raised when k is not an integer or is less than 1.\"\"\"\n    pass\nclass Result:\n    \"\"\"Holds the maximum sum of a subarray and its optional indices.\"\"\"\n    def __init__(self, maxSum: int, startIndex: int | None = None, endIndex: int | None = None):\n        self.maxSum = maxSum\n        self.startIndex = startIndex\n        self.endIndex = endIndex\nclass InputValidator:\n    \"\"\"Validates input types and array length.\"\"\"\n    def validateTypes(self, arr, n, k) -> None:\n        if not isinstance(arr, list) or not all(isinstance(x, int) for x in arr):\n            raise InvalidTypeError(\"arr must be a list of integers.\")\n        if not isinstance(n, int):\n            raise InvalidTypeError(\"n must be an integer.\")\n        if not isinstance(k, int): \n            raise InvalidTypeError(\"k must be an integer.\")\n\n    def validateLength(self, arr, n) -> None:\n        if n != len(arr):\n            raise LengthMismatchError(f\"Length n ({n}) does not match array length ({len(arr)}).\")\nclass KadaneAlgorithm:\n    \"\"\"Computes the maximum contiguous subarray sum using Kadane's algorithm.\"\"\"\n    def computeMaxSubarray(self, arr: list[int]) -> Result:\n        # Assuming arr is a non-empty list of integers due to prior validation.\n        max_so_far = arr[0]\n        current_max = arr[0]\n\n        for i in range(1, len(arr)):\n            current_max = max(arr[i], current_max + arr[i])\n            max_so_far = max(max_so_far, current_max)\n        \n        return Result(max_so_far)\ndef max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in the array formed by\n    repeating the given array k times.\n    \"\"\"\n    validator = InputValidator()\n    validator.validateTypes(arr, n, k)\n    validator.validateLength(arr, n)\n\n    if not isinstance(k, int) or k < 1:\n        raise InvalidKError(\"k must be an integer greater than or equal to 1.\")\n\n    kadane_algo = KadaneAlgorithm()\n\n    if k == 1:\n        result = kadane_algo.computeMaxSubarray(arr)\n        return result.maxSum\n    else:\n        base_sum = sum(arr)\n        # Compute max subarray for up to two concatenated copies to capture wrapping subarrays.\n        double_arr = arr + arr\n        double_result = kadane_algo.computeMaxSubarray(double_arr)\n        \n        if base_sum > 0:\n            # If the base array's sum is positive, consider extending the max subarray\n            # with (k-2) full repetitions of the array.\n            final_max = max(double_result.maxSum, double_result.maxSum + (k - 2) * base_sum)\n        else:\n            # If the base array's sum is not positive, adding more full arrays won't increase the sum.\n            # The maximum subarray must be contained within `arr + arr`.\n            final_max = double_result.maxSum\n            \n        return final_max"}
{"task_id": "Mbpp/293", "solution": "import math\ndef otherside_rightangle(a, b):\n    \"\"\"\n    Calculates the hypotenuse of a right-angled triangle given the lengths of the two legs.\n    Raises TypeError if inputs are not numeric.\n    \"\"\"\n    if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n        raise TypeError(\"a and b must be numeric\")\n\n    # Use math.hypot for numerically stable computation of sqrt(a^2 + b^2).\n    return math.hypot(float(a), float(b))"}
{"task_id": "Mbpp/294", "solution": "from typing import Union\ndef filter_numeric(items: list) -> list:\n    \"\"\"Filters a list to include only numeric (int or float) elements.\"\"\"\n    numeric_elements = []\n    for item in items:\n        if isinstance(item, (int, float)):\n            numeric_elements.append(item)\n    return numeric_elements\ndef compute_max(numeric_items: list) -> Union[int, float]:\n    \"\"\"Computes the maximum value from a list of numeric elements.\"\"\"\n    return max(numeric_items)\ndef max_val(items: list) -> Union[int, float]:\n    \"\"\"Finds the maximum numeric value in a given heterogeneous list.\"\"\"\n    numeric_elements = filter_numeric(items)\n    return compute_max(numeric_elements)"}
{"task_id": "Mbpp/296", "solution": "from typing import List\ndef get_Inv_Count(arr: List[int]) -> int:\n    \"\"\"Public API: returns inversion count for arr.\"\"\"\n    n = len(arr)\n    if n <= 1:\n        return 0\n    # Pass a copy to countDuringMerge to avoid modifying the original list.\n    temp_arr = list(arr)\n    return countDuringMerge(temp_arr)\ndef countDuringMerge(arr: List[int]) -> int:\n    \"\"\"Helper implementing merge-sort-based inversion counting; returns integer count.\"\"\"\n    n = len(arr)\n    temp = [0] * n  # Auxiliary array for merging.\n\n    def _merge_sort_and_count_recursive(arr_orig: List[int], temp_aux: List[int], low: int, high: int) -> int:\n        \"\"\"Recursively sorts arr_orig[low...high] and counts inversions using temp_aux.\"\"\"\n        inv_count = 0\n        if low < high:\n            mid = (low + high) // 2\n            inv_count += _merge_sort_and_count_recursive(arr_orig, temp_aux, low, mid)\n            inv_count += _merge_sort_and_count_recursive(arr_orig, temp_aux, mid + 1, high)\n            inv_count += _merge_and_count_inversions(arr_orig, temp_aux, low, mid, high)\n        return inv_count\n\n    def _merge_and_count_inversions(arr_orig: List[int], temp_aux: List[int], low: int, mid: int, high: int) -> int:\n        \"\"\"Merges two sorted sub-arrays and counts inversions between them.\"\"\"\n        i = low      # Starting index for left sub-array\n        j = mid + 1  # Starting index for right sub-array\n        k = low      # Starting index for merged array in temp_aux\n        inv_count = 0\n\n        while i <= mid and j <= high:\n            if arr_orig[i] <= arr_orig[j]:\n                temp_aux[k] = arr_orig[i]\n                i += 1\n            else:\n                temp_aux[k] = arr_orig[j]\n                j += 1\n                # If arr_orig[i] > arr_orig[j], then arr_orig[j] forms an inversion\n                # with all remaining elements in the left sub-array (from i to mid).\n                inv_count += (mid - i + 1)\n            k += 1\n\n        # Copy the remaining elements of the left sub-array, if any\n        while i <= mid:\n            temp_aux[k] = arr_orig[i]\n            i += 1\n            k += 1\n\n        # Copy the remaining elements of the right sub-array, if any\n        while j <= high:\n            temp_aux[k] = arr_orig[j]\n            j += 1\n            k += 1\n\n        # Copy the merged elements back to the original array\n        for idx in range(low, high + 1):\n            arr_orig[idx] = temp_aux[idx]\n        \n        return inv_count\n\n    return _merge_sort_and_count_recursive(arr, temp, 0, n - 1)"}
{"task_id": "Mbpp/299", "solution": "import collections\ndef max_aggregate(list_of_name_value_pairs) -> tuple:\n    \"\"\"\n    Calculates the maximum aggregate from a list of (name, value) tuples.\n    Aggregates values by name and returns the (name, total) tuple with the highest sum.\n    \"\"\"\n    if not list_of_name_value_pairs:\n        # As per design, for empty input, an Error would be raised by InputValidator.\n        # For this standalone completion, we follow the common Python behavior for max() on empty sequence\n        # or handle it deterministically for the aggregate map.\n        # Given the example, we'll return a default 'empty' aggregate if no valid data.\n        # The design states \"implementer may document an alternative behavior (e.g., return None)\n        # but must update tests accordingly.\" Let's return a sensible default for an empty list\n        # rather than raising an IndexError from max() if the map is empty.\n        return (\"\", 0) \n\n    aggregates = collections.defaultdict(int)\n    for name, value in list_of_name_value_pairs:\n        # Assuming input is already validated per design context, we directly process.\n        aggregates[name] += value\n\n    if not aggregates:\n        # This case could happen if list_of_name_value_pairs was not truly empty\n        # but contained only invalid items that were filtered out during validation.\n        # For this completion, assuming valid inputs per design's validator.\n        return (\"\", 0) \n\n    # Find the name with the maximum aggregate.\n    # Tie-breaking: If multiple names have the same maximum aggregate, `max` will return\n    # the first one encountered based on the dictionary's iteration order (which is\n    # insertion order in Python 3.7+ for dict, or arbitrary for defaultdict before Python 3.7).\n    # The design states \"first-occurring name with the max total\" as an example rule.\n    max_name = None\n    max_total = -float('inf')\n\n    for name, total in aggregates.items():\n        if total > max_total:\n            max_total = total\n            max_name = name\n    \n    return (max_name, max_total)"}
{"task_id": "Mbpp/297", "solution": "class Validator:\n    def validate(self, input):\n        \"\"\"\n        Raise TypeError if input is not a list.\n        \"\"\"\n        if not isinstance(input, list):\n            raise TypeError('flatten_list requires a list input')\nclass Flattener:\n    def flatten(self, inputList, outputList):\n        \"\"\"\n        Append atomic elements found in inputList (and nested lists) into outputList,\n        preserving left-to-right order. Does not mutate inputList.\n        \"\"\"\n        for item in inputList:\n            if isinstance(item, list):\n                self.flatten(item, outputList)\n            else:\n                outputList.append(item)\nvalidator = Validator()\nflattener = Flattener()\ndef flatten_list(inputList):\n    \"\"\"\n    Validate inputList and return a new flattened list.\n    Raises TypeError if inputList is not a list.\n    \"\"\"\n    validator.validate(inputList)\n    output = []\n    flattener.flatten(inputList, output)\n    return output"}
{"task_id": "Mbpp/301", "solution": "def _compute_depth(d: dict, current: int) -> int:\n    \"\"\"\n    Recursively computes the maximum depth of nested dictionaries.\n    The current argument tracks the depth of the current dictionary.\n    \"\"\"\n    max_depth = current\n    for value in d.values():\n        if isinstance(value, dict):\n            max_depth = max(max_depth, _compute_depth(value, current + 1))\n    return max_depth\ndef dict_depth(d: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary.\n    The outermost dictionary is considered depth 1.\n    \"\"\"\n    return _compute_depth(d, 1)"}
{"task_id": "Mbpp/300", "solution": "def _binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Compute exact integer C(n,k) using a multiplicative algorithm.\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    # Take advantage of symmetry C(n, k) = C(n, n-k)\n    if k > n // 2:\n        k = n - k\n    \n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\ndef count_binary_seq(n):\n    \"\"\"Return count of binary sequences of length 2n where first-half sum equals second-half sum.\n    This is equivalent to the central binomial coefficient C(2n, n).\n    \"\"\"\n    return _binomial_coefficient(2 * n, n)"}
{"task_id": "Mbpp/305", "solution": "class Word:\n    \"\"\"Represents a token with positional metadata and a match predicate.\"\"\"\n    def __init__(self, text: str, position_in_string: int) -> None:\n        self.text = text\n        self.position_in_string = position_in_string\n\n    def starts_with_p(self) -> bool:\n        \"\"\"Checks if the word starts with 'p' or 'P'.\"\"\"\n        if not self.text:\n            return False\n        return self.text[0].lower() == 'p'\nclass InputString:\n    \"\"\"Lightweight holder for a single input string and its tokenized words.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n        self.words: list[Word] = []\n\n    def tokenize(self) -> None:\n        \"\"\"Populates the words list by splitting the value on whitespace.\"\"\"\n        tokens = self.value.split()\n        for i, token in enumerate(tokens):\n            self.words.append(Word(token, i))\nclass MatchResult:\n    \"\"\"DTO representing the pair of matches.\"\"\"\n    def __init__(self, first_match: str, second_match: str) -> None:\n        self.first_match = first_match\n        self.second_match = second_match\n\n    def as_tuple(self) -> tuple[str, str]:\n        \"\"\"Returns the matches as a tuple.\"\"\"\n        return (self.first_match, self.second_match)\nclass StartWithPFunction:\n    \"\"\"Implements the algorithm to find the first two words starting with 'p'.\"\"\"\n    def __init__(self, input_list: list[str]) -> None:\n        self._input = input_list\n        self._matches: list[str] = []\n\n    def execute(self) -> tuple[str, str]:\n        \"\"\"Performs scanning, collects matches, and returns the result.\"\"\"\n        for s_value in self._input:\n            input_str_obj = InputString(s_value)\n            input_str_obj.tokenize()\n            for word_obj in input_str_obj.words:\n                if word_obj.starts_with_p():\n                    self._matches.append(word_obj.text)\n                    if len(self._matches) == 2:\n                        break\n            if len(self._matches) == 2:\n                break\n\n        result_dto = MatchResult(self._matches[0], self._matches[1])\n        return result_dto.as_tuple()\n\n    def split(self, s: str) -> list[str]:\n        \"\"\"Splits a string on whitespace.\"\"\"\n        return s.split()\n\n    def is_match(self, w: str) -> bool:\n        \"\"\"Returns True if a word starts with 'p' or 'P'.\"\"\"\n        if not w:\n            return False\n        return w[0].lower() == 'p'\ndef start_withp(input_list: list[str]) -> tuple[str, str]:\n    \"\"\"\n    Returns two words from a list of words starting with letter 'p'.\n    The function scans input_list left-to-right and words within each string left-to-right,\n    preserving original case.\n    \"\"\"\n    spf = StartWithPFunction(input_list)\n    return spf.execute()"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from arr[0..i] followed by arr[k].\n    \"\"\"\n    class ValidationError(Exception):\n        \"\"\"Custom exception for input validation errors.\"\"\"\n        def __init__(self, message: str):\n            self.message = message\n            super().__init__(self.message)\n\n        def __str__(self) -> str:\n            return f\"ValidationError: {self.message}\"\n\n    # Validate inputs as per design\n    if n != len(arr):\n        raise ValidationError(f\"n ({n}) must be equal to len(arr) ({len(arr)})\")\n    if not (0 <= i < n):\n        raise ValidationError(f\"Index i ({i}) must be within bounds [0, n-1]\")\n    if not (0 <= k < n):\n        raise ValidationError(f\"Index k ({k}) must be within bounds [0, n-1]\")\n    if not (k > i):\n        raise ValidationError(f\"Index k ({k}) must be greater than index i ({i})\")\n\n    # Compute msis[j] for elements up to index i.\n    # msis[j] stores the maximum sum of a strictly increasing subsequence\n    # that ends at arr[j] using elements from arr[0...j].\n    msis = [0] * (i + 1)\n    \n    for j in range(i + 1):\n        msis[j] = arr[j]  # Each element is an increasing subsequence of length 1\n        for t in range(j):\n            if arr[t] < arr[j]:\n                # If arr[j] can extend a previous increasing subsequence\n                msis[j] = max(msis[j], msis[t] + arr[j])\n\n    # Calculate the final maximum sum, including arr[k].\n    # Initialize with arr[k] itself (representing an empty prefix subsequence).\n    max_total_sum = arr[k]\n\n    # Iterate through all possible ending points 'j' for the prefix subsequence (0 to i).\n    for j in range(i + 1):\n        # If arr[j] is strictly less than arr[k], then arr[k] can extend the subsequence ending at arr[j].\n        if arr[j] < arr[k]:\n            max_total_sum = max(max_total_sum, msis[j] + arr[k])\n    \n    return max_total_sum"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Sets the left-most (most significant) unset bit in the binary representation of n.\n    If all bits up to the most significant bit of n are set, the next higher bit is set.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    num_bits = n.bit_length()\n\n    # Iterate from the most significant bit position down to 0\n    for i in range(num_bits - 1, -1, -1):\n        mask = 1 << i\n        if (n & mask) == 0:\n            # If the bit at position i is 0, set it and return\n            return n | mask\n    \n    # If all bits up to num_bits-1 are already set, set the bit at position num_bits\n    return n | (1 << num_bits)"}
{"task_id": "Mbpp/309", "solution": "from dataclasses import dataclass\nfrom typing import Tuple, Union\ndef validate_inputs(a: Union[int, float], b: Union[int, float]) -> Tuple[NumericInput, NumericInput]:\n    \"\"\"\n    Validates if both inputs are numeric (int or float).\n    Raises TypeError if either input is not an int or float.\n    \"\"\"\n    if not isinstance(a, (int, float)):\n        raise TypeError(f\"Input 'a' must be an int or float, but got {type(a).__name__}\")\n    if not isinstance(b, (int, float)):\n        raise TypeError(f\"Input 'b' must be an int or float, but got {type(b).__name__}\")\n    return (NumericInput(a, type(a).__name__), NumericInput(b, type(b).__name__))\ndef maximum(a: Union[int, float], b: Union[int, float]) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum of two numbers.\n    Validates inputs and returns the larger of the two values.\n    \"\"\"\n    validate_inputs(a, b)\n    return max(a, b)"}
{"task_id": "Mbpp/308", "solution": "from typing import Sequence, List\ndef _validate_inputs(list1: Sequence[float], list2: Sequence[float], k: int) -> tuple[bool, List[float]]:\n    \"\"\"Checks for invalid k or empty lists, returning (True, []) for early exit.\"\"\"\n    if k <= 0 or not list1 or not list2:\n        return True, []\n    return False, []\ndef _compute_pairwise_products(list1: Sequence[float], list2: Sequence[float]) -> List[dict]:\n    \"\"\"Computes all pairwise products with source indices for deterministic sorting.\"\"\"\n    products_with_meta = []\n    for i, factor1 in enumerate(list1):\n        for j, factor2 in enumerate(list2):\n            products_with_meta.append({\n                'product': factor1 * factor2,\n                'index1': i,\n                'index2': j,\n                'factor1': factor1,\n                'factor2': factor2\n            })\n    return products_with_meta\ndef _select_top_k(products_with_meta: List[dict], k: int) -> List[float]:\n    \"\"\"Sorts products deterministically and returns the top k numeric values.\"\"\"\n    # Sort by product descending, then index1 ascending, then index2 ascending for deterministic tie-breaking.\n    products_with_meta.sort(key=lambda x: (-x['product'], x['index1'], x['index2']))\n    return [item['product'] for item in products_with_meta[:k]]\ndef large_product(list1: Sequence[float], list2: Sequence[float], k: int) -> List[float]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    should_return_early, early_result = _validate_inputs(list1, list2, k)\n    if should_return_early:\n        return early_result\n\n    products_with_meta = _compute_pairwise_products(list1, list2)\n    top_k_products = _select_top_k(products_with_meta, k)\n\n    return top_k_products"}
{"task_id": "Mbpp/310", "solution": "class InputString:\n    \"\"\"Holds input string value for conversion.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value: str = value\nclass CharacterTuple:\n    \"\"\"Immutable container for the resulting tuple of characters.\"\"\"\n    def __init__(self, elements: tuple) -> None:\n        self.elements: tuple = elements\nclass StringConverter:\n    \"\"\"\n    Performs conversion of InputString to CharacterTuple and returns a tuple.\n    \"\"\"\n    def string_to_tuple(self, s: str) -> tuple:\n        \"\"\"Convert s to tuple of single-character strings, excluding spaces.\"\"\"\n        input_string_obj = InputString(s)\n        collected_chars_list = []\n        \n        for char_value in input_string_obj.value:\n            if char_value != ' ':\n                collected_chars_list.append(char_value)\n        \n        result_tuple = tuple(collected_chars_list)\n        character_tuple_obj = CharacterTuple(result_tuple)\n        \n        return character_tuple_obj.elements\ndef string_to_tuple(s: str) -> tuple:\n    \"\"\"Converts a string to a tuple of characters, excluding spaces and preserving order.\"\"\"\n    return StringConverter().string_to_tuple(s)"}
{"task_id": "Mbpp/312", "solution": "import math\nclass MathConstants:\n    \"\"\"Provides mathematical constants.\"\"\"\n    PI: float = math.pi\nclass VolumeCalculator:\n    \"\"\"Encapsulates the computation logic for volumes.\"\"\"\n    @staticmethod\n    def volume_cone(radius: float, height: float) -> float:\n        \"\"\"\n        Calculates the volume of a cone using the formula V = (1/3) * pi * radius^2 * height.\n        \"\"\"\n        return (1.0 / 3.0) * MathConstants.PI * (radius**2) * height\ndef volume_cone(radius: float, height: float) -> float:\n    \"\"\"\n    Calculates the volume of a cone given its radius and height.\n    It delegates the actual computation to a VolumeCalculator static method.\n    \"\"\"\n    return VolumeCalculator.volume_cone(radius, height)"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n):\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    Precondition: n is an integer.\n    \"\"\"\n    power = 1\n    while power * 2 <= n:\n        power *= 2\n    return power"}
{"task_id": "Mbpp/389", "solution": "class LucasCalculator:\n    \"\"\"Calculates Lucas numbers using an iterative approach.\n    It implements L0=2, L1=1, Ln=L(n-1)+L(n-2) for n>=2.\n    \"\"\"\n    def find_lucas(self, n: int) -> int:\n        \"\"\"Delegates to the iterative computation method.\"\"\"\n        return self.computeIterative(n)\n\n    def computeIterative(self, n: int) -> int:\n        \"\"\"Computes the n'th Lucas number iteratively.\"\"\"\n        if n == 0:\n            return 2\n        elif n == 1:\n            return 1\n        \n        # Initialize with L0 and L1\n        a, b = 2, 1 \n        # Iterate from L2 up to Ln\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b\ndef find_lucas(n: int) -> int:\n    \"\"\"Finds the n'th Lucas number using a LucasCalculator instance.\"\"\"\n    calculator = LucasCalculator()\n    return calculator.find_lucas(n)"}
{"task_id": "Mbpp/390", "solution": "def add_string(elements: list, format: str) -> list:\n    \"\"\"\n    Apply 'format' to each element in 'elements' by replacing '{0}' with str(element).\n    Returns a list of strings with '{0}' replaced by each element's string representation.\n    \"\"\"\n    return [format.replace('{0}', str(element)) for element in elements]"}
{"task_id": "Mbpp/394", "solution": "def check_distinct(input: tuple) -> bool:\n    \"\"\"\n    Checks if the given tuple contains no duplicate elements.\n    Uses a hash-based set for efficiency, falling back to O(n^2) comparison for unhashable items.\n    \"\"\"\n    if not isinstance(input, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    seen_hashable = set()\n    unhashable_elements = []\n\n    for item in input:\n        try:\n            if item in seen_hashable:\n                return False\n            seen_hashable.add(item)\n        except TypeError:\n            # Handle unhashable items\n            for existing_unhashable in unhashable_elements:\n                if item == existing_unhashable:\n                    return False\n            unhashable_elements.append(item)\n\n    return True"}
{"task_id": "Mbpp/391", "solution": "from typing import List, Any, Dict\ndef convert_list_dictionary(ids: List[str], names: List[str], values: List[Any]) -> List[Dict[str, Dict[str, Any]]]:\n    \"\"\"\n    Validate inputs and convert three parallel lists into a list of per-index nested dictionaries.\n\n    Raises:\n        ValueError: If inputs are not list instances or lengths differ.\n    \"\"\"\n    if not isinstance(ids, list) or not isinstance(names, list) or not isinstance(values, list):\n        raise ValueError(\"All inputs (ids, names, values) must be list instances.\")\n\n    if not (len(ids) == len(names) == len(values)):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    result = []\n    for i in range(len(ids)):\n        result.append({ids[i]: {names[i]: values[i]}})\n    return result"}
{"task_id": "Mbpp/395", "solution": "from dataclasses import dataclass\nfrom typing import Optional, Dict\nclass FrequencyMap:\n    counts: Dict[str, int]\n    first_indexes: Dict[str, int]\n\n    def __init__(self) -> None:\n        self.counts = {}\n        self.first_indexes = {}\n\n    def build(self, input: InputString) -> None:\n        \"\"\"Builds character frequency and first index maps from the input string.\"\"\"\n        for i, char in enumerate(input.value):\n            self.counts[char] = self.counts.get(char, 0) + 1\n            if char not in self.first_indexes:\n                self.first_indexes[char] = i\n\n    def get_first_unique(self, input: InputString) -> Optional[str]:\n        \"\"\"Returns the first non-repeating character based on input order, or None.\"\"\"\n        for char in input.value:\n            if self.counts[char] == 1:\n                return char\n        return None\ndef first_non_repeating_character(s: str) -> Optional[str]:\n    \"\"\"\n    Finds the first non-repeated character in a given string.\n    Returns None if no non-repeated character is found.\n    \"\"\"\n    input_string = InputString(value=s)\n    freq_map = FrequencyMap()\n    freq_map.build(input_string)\n    return freq_map.get_first_unique(input_string)"}
{"task_id": "Mbpp/397", "solution": "def median_numbers(a, b, c):\n    \"\"\"\n    Computes the median of three numbers.\n    The result is always returned as a float.\n    \"\"\"\n    validate_inputs(a, b, c)\n    numbers = sorted([a, b, c])\n    return float(numbers[1])"}
{"task_id": "Mbpp/398", "solution": "from typing import List\nclass NumberList:\n    def __init__(self, items: list) -> None:\n        \"\"\"Initializes NumberList with a list of items.\"\"\"\n        self.items = items\n\n    def isValid(self) -> bool:\n        \"\"\"Checks if the stored items constitute a valid list of integers.\"\"\"\n        if not isinstance(self.items, list):\n            return False\n        for item in self.items:\n            if not isinstance(item, int):\n                return False\n        return True\n\n    def validate_or_raise(self) -> None:\n        \"\"\"Validates the list; raises ValueError if invalid.\"\"\"\n        if not self.isValid():\n            raise ValueError(\"Input must be a list containing only integers.\")\nclass IntegerNumber:\n    def __init__(self, value: int) -> None:\n        \"\"\"Initializes IntegerNumber with an integer value.\"\"\"\n        self.value = value\n\n    def digitSum(self) -> int:\n        \"\"\"Computes the sum of the absolute digits of the number.\"\"\"\n        num = abs(self.value)\n        total_sum = 0\n        if num == 0:\n            return 0\n        while num > 0:\n            total_sum += num % 10\n            num //= 10\n        return total_sum\nclass Result:\n    def __init__(self, total: int) -> None:\n        \"\"\"Initializes Result with the aggregated total.\"\"\"\n        self.total = total\nclass DigitSumCalculator:\n    @staticmethod\n    def sum_of_digits(numbers: List[int]) -> int:\n        \"\"\"Calculates the sum of digits for each number in a list and returns their aggregate total.\"\"\"\n        aggregate_total = 0\n        for n in numbers:\n            integer_num = IntegerNumber(n)\n            aggregate_total += integer_num.digitSum()\n        return Result(aggregate_total).total\ndef sum_of_digits(numbers: list) -> int:\n    \"\"\"Validate input and return aggregated digit sum.\n    On invalid input raise ValueError.\n    \"\"\"\n    number_list_obj = NumberList(numbers)\n    number_list_obj.validate_or_raise()\n    return DigitSumCalculator.sum_of_digits(number_list_obj.items)"}
{"task_id": "Mbpp/404", "solution": "def minimum(a, b):\n    \"\"\"Minimum function implementation (SRS-specified).\n\n    Provides:\n    - minimum(a, b): returns the numerically smaller of a and b.\n    \"\"\"\n    return a if a <= b else b"}
{"task_id": "Mbpp/392", "solution": "from typing import Optional\nclass Cache:\n    \"\"\"In-memory cache for memoization.\"\"\"\n    def __init__(self):\n        self.entries: dict[int, int] = {}\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a value from the cache, or None if not found.\"\"\"\n        return self.entries.get(n)\n\n    def put(self, n: int, value: int) -> None:\n        \"\"\"Stores a value in the cache for a given key.\"\"\"\n        self.entries[n] = value\nclass GetMaxSum:\n    \"\"\"Computes the maximum sum using the given recurrence relation with memoization.\"\"\"\n    def __init__(self):\n        self.cache = Cache()\n\n    def get_max_sum(self, n: int) -> int:\n        \"\"\"\n        Validates input and delegates the computation of f(n).\n        Raises ValueError if n is not a non-negative integer.\n        \"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise ValueError(\"Input n must be a non-negative integer.\")\n        return self.compute(n)\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Recursive computation of f(n) with memoization.\n        f(0) = 0; f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n) for n > 0.\n        \"\"\"\n        if n == 0:\n            return 0\n\n        cached_value = self.cache.get(n)\n        if cached_value is not None:\n            return cached_value\n\n        # Calculate sub-results using integer (floor) division\n        r_n2 = self.compute(n // 2)\n        r_n3 = self.compute(n // 3)\n        r_n4 = self.compute(n // 4)\n        r_n5 = self.compute(n // 5)\n\n        sum_subresults = r_n2 + r_n3 + r_n4 + r_n5\n        result = max(sum_subresults, n)\n\n        self.cache.put(n, result)\n        return result\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Finds the maximum sum possible by using the equation f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    The function uses memoization to optimize recursive calls.\n    \"\"\"\n    # Create a new GetMaxSum instance for each call to ensure an isolated cache.\n    calculator = GetMaxSum()\n    return calculator.get_max_sum(n)"}
{"task_id": "Mbpp/409", "solution": "from typing import List, Tuple\nclass TuplePair:\n    \"\"\"Represents a pair of numeric values and computes their product.\"\"\"\n    def __init__(self, a: int, b: int):\n        self.a = a\n        self.b = b\n        self.product = 0 # Initialize product, will be computed later\n\n    def computeProduct(self) -> int:\n        \"\"\"Computes the product of a and b, stores it, and returns the value.\"\"\"\n        self.product = self.a * self.b\n        return self.product\nclass TupleList:\n    \"\"\"Container for TuplePair instances.\"\"\"\n    def __init__(self):\n        self.items: List[TuplePair] = []\n\n    def add(self, tuple_pair: TuplePair):\n        \"\"\"Adds a TuplePair to the list.\"\"\"\n        self.items.append(tuple_pair)\n\n    def iterate(self) -> List[TuplePair]:\n        \"\"\"Returns the list of TuplePair instances.\"\"\"\n        return self.items\nclass Result:\n    \"\"\"Data transfer object holding the minimum product.\"\"\"\n    def __init__(self, min_product: int):\n        self.minProduct = min_product\nclass MinProductFunction:\n    \"\"\"Encapsulates the algorithm to compute per-tuple products and select minimum.\"\"\"\n    def min_product_tuple(self, tuple_list_input: List[Tuple[int, int]]) -> int:\n        \"\"\"\n        Computes the products for all tuples in the input list\n        and returns the smallest product.\n        \"\"\"\n        min_product_found = float('inf')\n        \n        tuple_list_obj = TupleList()\n        for val1, val2 in tuple_list_input:\n            tuple_pair = TuplePair(val1, val2)\n            tuple_list_obj.add(tuple_pair)\n        \n        for tuple_pair in tuple_list_obj.iterate():\n            current_product = tuple_pair.computeProduct()\n            if current_product < min_product_found:\n                min_product_found = current_product\n        \n        result_obj = Result(int(min_product_found)) # Ensure integer type for result\n        return result_obj.minProduct\ndef min_product_tuple(tuple_list: List[Tuple[int, int]]) -> int:\n    \"\"\"\n    Finds the minimum product from the pairs of tuples within a given list.\n    Delegates the core logic to MinProductFunction.\n    \"\"\"\n    processor = MinProductFunction()\n    return processor.min_product_tuple(tuple_list)"}
