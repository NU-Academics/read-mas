{"task_id": "Mbpp/165", "solution": "from src.domain import InputString, Character, Result\nfrom src.alphabet_mapper import AlphabetMapper\ndef count_char_position(s: str) -> int:\n    \"\"\"\n    Counts characters in a string that match their 1-based position in the English alphabet.\n    Handles case-insensitivity and ignores non-alphabetic characters for counting.\n    \"\"\"\n    count = 0\n    input_string = InputString(s)\n\n    # Iterate through the string, obtaining characters and their 0-based indices.\n    for i, char_val in enumerate(input_string.value):\n        one_based_index = i + 1  # Convert to 1-based index for comparison as per requirement.\n\n        # Create a Character domain object to encapsulate character-specific logic.\n        character_obj = Character(char_val, one_based_index)\n\n        # Only process alphabetic characters for position matching.\n        if character_obj.isAlphabetic():\n            alphabet_pos = character_obj.alphabetPosition()\n            \n            # Compare the character's alphabet position with its 1-based index in the string.\n            if alphabet_pos == one_based_index:\n                count += 1\n    \n    # Return the final count of characters whose alphabet position matches their string position.\n    return count"}
{"task_id": "Mbpp/167", "solution": "class Validation:\n    \"\"\"Provides input validation utilities for functions.\"\"\"\n\n    @staticmethod\n    def is_integer(n) -> bool:\n        \"\"\"Returns True if n is a standard Python int; otherwise False.\"\"\"\n        return isinstance(n, int)\ndef next_power_of_2(n) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Returns 1 if n is 0.\n    \"\"\"\n    if not Validation.is_integer(n):\n        raise TypeError(\"n must be an int\")\n\n    if n == 0:\n        return 1\n\n    power = 1\n    while power < n:\n        power *= 2\n    return power"}
{"task_id": "Mbpp/170", "solution": "def sum_range_list(number_list: \"NumberList\", start: int, end: int) -> float:\n    \"\"\"\n    Calculates the sum of numbers in a NumberList instance within an inclusive range.\n    Accesses the 'elements' attribute of the NumberList object for computation.\n    \"\"\"\n    elements = number_list.elements\n    return float(sum(elements[start : end + 1]))"}
{"task_id": "Mbpp/171", "solution": "class RegularPentagon:\n    \"\"\"Represents a regular pentagon with a given side length.\"\"\"\n    def __init__(self, side_length):\n        self.side_length = side_length\n\n    def perimeter(self):\n        \"\"\"Calculates the perimeter of the pentagon.\"\"\"\n        return 5 * self.side_length\ndef perimeter_pentagon(side_length):\n    \"\"\"\n    Calculates the perimeter of a regular pentagon given its side length.\n    \"\"\"\n    pentagon = RegularPentagon(side_length)\n    return pentagon.perimeter()"}
{"task_id": "Mbpp/172", "solution": "def count_occurance(input: str) -> int:\n    \"\"\"Count literal occurrences of 'std' in input (case-sensitive).\"\"\"\n    if input == \"\":\n        return 0\n    count = 0\n    # The loop should go up to len(input) - 3 to allow a 3-char slice ending at len(input) - 1.\n    # range(len(input) - 2) will go up to len(input) - 3.\n    # Example: len(input) = 3, range(1) -> i=0, input[0:3]\n    # Example: len(input) = 2, range(0) -> loop does not run, count=0\n    for i in range(len(input) - 2):\n        if input[i:i+3] == \"std\":\n            count += 1\n    return count"}
{"task_id": "Mbpp/222", "solution": "from dataclasses import dataclass\nfrom typing import Tuple\nclass TypeChecker:\n    \"\"\"Encapsulates the algorithm to check homogeneity of element types.\"\"\"\n\n    def check_type(self, t: TupleInput) -> bool:\n        \"\"\"\n        Determines whether all elements in the input TupleInput share the same data type.\n        Empty and single-element tuples are considered homogeneous.\n        \"\"\"\n        if t.length() <= 1:\n            return True\n\n        first_element_type = type(t.elements[0])\n        for element in t.elements[1:]:\n            if type(element) is not first_element_type:\n                return False\n        return True\ndef check_type(t: tuple) -> bool:\n    \"\"\"\n    Checks if all elements in the input tuple have the same data type.\n    Empty and single-element tuples are considered homogeneous.\n    \"\"\"\n    tuple_input = TupleInput(elements=t)\n    checker = TypeChecker()\n    return checker.check_type(tuple_input)"}
{"task_id": "Mbpp/223", "solution": "import collections\ndef is_majority(array, n, element):\n    \"\"\"\n    Checks if the given element is a majority element in the sorted array.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n    if not array:\n        return False\n\n    # BR-9: Validate consistency between n and len(array)\n    if n != len(array):\n        # The design document does not prescribe error handling for this specific BR\n        # beyond \"validate consistency\". Given the prompt's instruction to \"DO NOT\n        # raise exceptions for edge cases\" and \"DO NOT add isinstance() checks\",\n        # returning False seems the most compliant default if n is inconsistent\n        # with the actual array length, treating it as an invalid input state\n        # rather than an error to be raised.\n        return False\n\n    def findFirstOccurrence(arr, x):\n        low = 0\n        high = len(arr) - 1\n        result = -1\n        while low <= high:\n            mid = (low + high) // 2\n            if arr[mid] == x:\n                result = mid\n                high = mid - 1  # Look for an even earlier occurrence\n            elif arr[mid] < x:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return result\n\n    def findLastOccurrence(arr, x):\n        low = 0\n        high = len(arr) - 1\n        result = -1\n        while low <= high:\n            mid = (low + high) // 2\n            if arr[mid] == x:\n                result = mid\n                low = mid + 1  # Look for an even later occurrence\n            elif arr[mid] < x:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return result\n\n    first_index = findFirstOccurrence(array, element)\n    last_index = findLastOccurrence(array, element)\n\n    # BR-8: If element not present, return False.\n    if first_index == -1:\n        return False\n\n    count = last_index - first_index + 1\n\n    return count > n / 2"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(n):\n    \"\"\"\n    Counts the number of set bits (binary digits with value 1) in a given non-negative integer.\n    This function assumes `n` is a non-negative integer as per requirements.\n    \"\"\"\n    def _count_ones(val):\n        \"\"\"Helper to compute the number of 1-bits in a non-negative integer.\"\"\"\n        # Python's bin() returns a string like '0b101'; counting '1's works directly.\n        return bin(val).count('1')\n\n    return _count_ones(n)"}
