{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(list_input):\n    \"\"\"\n    Recursively flattens a list and sums all of its integer elements.\n    Assumes elements are either integers or lists of integers/nested lists.\n    \"\"\"\n    total_sum = 0\n    for element in list_input:\n        if isinstance(element, list):\n            total_sum += recursive_list_sum(element)\n        else:\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/66", "solution": "def pos_count(list) -> int:\n    \"\"\"Count elements strictly greater than 0.\n\n    Non-numeric element comparisons will raise TypeError, which is allowed to propagate.\n    \"\"\"\n    count = 0\n    for item in list:\n        try:\n            if item > 0:\n                count += 1\n        except TypeError:\n            raise\n    return int(count)"}
{"task_id": "Mbpp/67", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass InputParameter:\n    \"\"\"Encapsulates and validates an input parameter n.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def isInteger(self) -> bool:\n        \"\"\"Checks if n is an integer and not a boolean.\"\"\"\n        return isinstance(self.n, int) and not isinstance(self.n, bool)\n\n    def isNonNegative(self) -> bool:\n        \"\"\"Checks if n is a non-negative number.\"\"\"\n        return self.n >= 0\nclass BellNumberResult:\n    \"\"\"A value object to encapsulate the computed Bell number.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass BellNumberCalculator:\n    \"\"\"Calculates Bell numbers and orchestrates input validation.\"\"\"\n    def bell_number(self, n) -> int:\n        \"\"\"Validates input n and delegates to compute the Bell number.\"\"\"\n        param = InputParameter(n)\n        if not param.isInteger() or not param.isNonNegative():\n            raise ValidationError(\"n must be a non-negative integer\")\n        \n        value = self.computeBellNumber(n)\n        return BellNumberResult(value).value\n\n    def computeBellNumber(self, n: int) -> int:\n        \"\"\"Computes the Bell number B_n using the Bell triangle algorithm.\"\"\"\n        if n == 0:\n            return 1\n\n        # Initialize a 2D list for the Bell triangle\n        bell_triangle = [[0] * (n + 1) for _ in range(n + 1)]\n\n        # Base case: B_0 = 1\n        bell_triangle[0][0] = 1\n\n        for i in range(1, n + 1):\n            # The first element of each row is the last element of the previous row (which is B_{i-1})\n            bell_triangle[i][0] = bell_triangle[i-1][i-1]\n            for j in range(1, i + 1):\n                # Subsequent elements are the sum of the element above and the element to the left\n                bell_triangle[i][j] = bell_triangle[i-1][j-1] + bell_triangle[i][j-1]\n        \n        # The Bell number B_n is the first element of the nth row\n        return bell_triangle[n][0]\ndef bell_number(n) -> int:\n    \"\"\"\n    Computes the Bell number B_n, the number of partitions of a set of size n.\n    Validates input and raises ValidationError for invalid n.\n    \"\"\"\n    calculator = BellNumberCalculator()\n    return calculator.bell_number(n)"}
{"task_id": "Mbpp/69", "solution": "from typing import List\ndef is_sublist(main_list: List, sublist: List) -> bool:\n    \"\"\"\n    Checks if a sublist appears as a contiguous subsequence of a main list.\n    Raises TypeError if inputs are not lists; an empty sublist is considered present.\n    \"\"\"\n    if not isinstance(main_list, list) or not isinstance(sublist, list):\n        raise TypeError('main_list and sublist must be lists')\n    if len(sublist) == 0:\n        return True\n    if len(sublist) > len(main_list):\n        return False\n    max_start = len(main_list) - len(sublist)\n    for i in range(0, max_start + 1):\n        if main_list[i:i+len(sublist)] == sublist:\n            return True\n    return False"}
{"task_id": "Mbpp/68", "solution": "class MonotonicChecker:\n    \"\"\"Helper class to encapsulate monotonicity checks.\"\"\"\n\n    def is_non_increasing(self, arr):\n        \"\"\"Checks if the array is non-increasing (each element is less than or equal to the previous).\"\"\"\n        if len(arr) <= 1:\n            return True\n        for i in range(1, len(arr)):\n            if arr[i] > arr[i-1]:\n                return False\n        return True\n\n    def is_non_decreasing(self, arr):\n        \"\"\"Checks if the array is non-decreasing (each element is greater than or equal to the previous).\"\"\"\n        if len(arr) <= 1:\n            return True\n        for i in range(1, len(arr)):\n            if arr[i] < arr[i-1]:\n                return False\n        return True\n\n    def is_Monotonic(self, arr):\n        \"\"\"Checks if the array is monotonic, i.e., either non-increasing or non-decreasing.\"\"\"\n        return self.is_non_increasing(arr) or self.is_non_decreasing(arr)\ndef is_Monotonic(arr):\n    \"\"\"\n    Checks whether the given array is monotonic or not.\n    An array is monotonic if it is either entirely non-increasing or entirely non-decreasing.\n    \"\"\"\n    checker = MonotonicChecker()\n    return checker.is_Monotonic(arr)"}
{"task_id": "Mbpp/70", "solution": "from typing import List\nclass TupleCollection:\n    def __init__(self, tuples: List[tuple]) -> None:\n        self._tuples = tuples\n    def all_lengths_equal(self) -> bool:\n        lengths = [len(t) for t in self._tuples]\n        return all(l == lengths[0] for l in lengths) if lengths else True\ndef get_equal(tuples: List[tuple]) -> bool:\n    \"\"\"\n    Checks if all given tuples have equal length.\n    Delegates evaluation to TupleCollection.\n    \"\"\"\n    collection = TupleCollection(tuples)\n    return collection.all_lengths_equal()"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(list):\n    \"\"\"\n    Sorts a list of elements using the comb sort algorithm.\n    Returns a new list containing the same elements sorted in ascending order.\n    \"\"\"\n\n    def _next_gap(gap):\n        \"\"\"Computes the next gap value for the comb sort algorithm.\"\"\"\n        gap = int(gap / 1.3)\n        if gap < 1:\n            return 1\n        return gap\n\n    def _comb_sort_inplace(arr):\n        \"\"\"Performs the comb sort algorithm in-place on the given list.\"\"\"\n        n = len(arr)\n        gap = n\n        swapped = True\n\n        while gap > 1 or swapped:\n            gap = _next_gap(gap)\n            swapped = False\n\n            for i in range(n - gap):\n                if arr[i] > arr[i + gap]:\n                    arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                    swapped = True\n\n    n = len(list)\n    if n == 0:\n        return []\n    if n == 1:\n        return list[:]\n\n    arr = list[:]  # Create a shallow copy to avoid mutating the original list\n    _comb_sort_inplace(arr)\n    return arr"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(n):\n    \"\"\"Return True if integer n can be represented as a difference of two integer squares.\n\n    Behavior: Implements BR-MATH: n is representable iff n % 4 != 2.\n    Input: n (expected int). Behavior for non-int inputs is unspecified in SRS; the function will evaluate using Python's % operator semantics and will surface Python exceptions for unsupported types.\n    Returns: bool\n    \"\"\"\n    return (n % 4) != 2"}
{"task_id": "Mbpp/74", "solution": "import collections.abc\nclass Validator:\n    \"\"\"\n    Validates if an object is sequence-like.\n    \"\"\"\n    @staticmethod\n    def validate_sequence_like(obj) -> None:\n        if not isinstance(obj, collections.abc.Sequence):\n            raise TypeError(f\"Expected a sequence-like object, but got {type(obj)}\")\nclass PatternMapper:\n    \"\"\"\n    Builds and checks bidirectional maps to enforce bijection semantics.\n    \"\"\"\n    def __init__(self):\n        self.seqToPatternMap = {}\n        self.patternToSeqMap = {}\n\n    def matches(self, seq, pattern) -> bool:\n        \"\"\"\n        Performs a single-pass mapping and consistency check.\n        \"\"\"\n        self.seqToPatternMap = {}\n        self.patternToSeqMap = {}\n\n        for i in range(len(seq)):\n            s_elem = seq[i]\n            p_token = pattern[i]\n\n            # Check seq_element -> pattern_token mapping\n            if s_elem in self.seqToPatternMap:\n                if self.seqToPatternMap[s_elem] != p_token:\n                    return False\n            else:\n                self.seqToPatternMap[s_elem] = p_token\n\n            # Check pattern_token -> seq_element mapping\n            if p_token in self.patternToSeqMap:\n                if self.patternToSeqMap[p_token] != s_elem:\n                    return False\n            else:\n                self.patternToSeqMap[p_token] = s_elem\n        \n        return True\ndef is_samepatterns(seq, pattern) -> bool:\n    \"\"\"\n    Checks if a sequence follows the structural pattern defined by another sequence.\n    \"\"\"\n    Validator.validate_sequence_like(seq)\n    Validator.validate_sequence_like(pattern)\n\n    if len(seq) != len(pattern):\n        return False\n\n    if len(seq) == 0:\n        return True\n\n    mapper = PatternMapper()\n    return mapper.matches(seq, pattern)"}
