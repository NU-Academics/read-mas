{"task_id": "Mbpp/75", "solution": "class Validator:\n    \"\"\"\n    Validates the input list and the divisor k according to specified rules.\n    Raises TypeError or ValueError for invalid inputs.\n    \"\"\"\n    def validate_input(self, input_list, k):\n        if not isinstance(input_list, list):\n            raise TypeError(\"Input must be a list.\")\n        if not isinstance(k, int):\n            raise TypeError(\"k must be an integer.\")\n        if k == 0:\n            raise ValueError(\"k cannot be zero for divisibility.\")\n\n        for item_index, item in enumerate(input_list):\n            if not isinstance(item, tuple):\n                raise TypeError(f\"List item at index {item_index} is not a tuple.\")\n            for element_index, element in enumerate(item):\n                if not isinstance(element, int):\n                    raise TypeError(f\"Tuple element at index {item_index},{element_index} is not an integer.\")\nclass Tuple:\n    \"\"\"\n    A helper class to wrap a tuple and provide divisibility check.\n    \"\"\"\n    def __init__(self, elements: tuple):\n        self.elements = elements\n\n    def is_all_divisible(self, k: int) -> bool:\n        \"\"\"Checks if all elements in the tuple are divisible by k.\"\"\"\n        for element in self.elements:\n            if element % k != 0:\n                return False\n        return True\nclass ResultList:\n    \"\"\"\n    Accumulates qualifying tuples and provides them as a standard list.\n    \"\"\"\n    def __init__(self):\n        self._tuples = []\n\n    def add(self, t: tuple) -> None:\n        \"\"\"Adds a tuple to the internal list.\"\"\"\n        self._tuples.append(t)\n\n    def as_list(self) -> list:\n        \"\"\"Returns the accumulated list of tuples.\"\"\"\n        return self._tuples\ndef find_tuples(input_list, k):\n    \"\"\"\n    Finds tuples from the given list where all elements are divisible by k.\n    \"\"\"\n    validator = Validator()\n    validator.validate_input(input_list, k)\n\n    result_list = ResultList()\n    for original_tuple in input_list:\n        tuple_helper = Tuple(original_tuple)\n        if tuple_helper.is_all_divisible(k):\n            result_list.add(original_tuple)\n\n    return result_list.as_list()"}
{"task_id": "Mbpp/79", "solution": "class Word:\n    def __init__(self, text: str) -> None:\n        self._text = text\n    def length(self) -> int:\n        return len(self._text)\nclass Result:\n    def __init__(self, is_odd: bool) -> None:\n        self._is_odd = is_odd\n    def as_bool(self) -> bool:\n        return self._is_odd\ndef word_len(word: str) -> bool:\n    \"\"\"Return True if len(word) is odd, False otherwise. Raises TypeError if word is not a str.\"\"\"\n    if not isinstance(word, str):\n        raise TypeError(\"word must be a str\")\n    w = Word(word)\n    length = w.length()\n    result = Result(is_odd=(length % 2 == 1))\n    return result.as_bool()"}
{"task_id": "Mbpp/84", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid input parameters to the sequence function.\"\"\"\n    def __init__(self, message: str, code: int | None = None):\n        super().__init__(message)\n        self.message = message\n        self.code = code\nclass MemoizationCache:\n    \"\"\"Stores and retrieves computed Newman-Conway sequence values by index.\"\"\"\n    def __init__(self):\n        self._store: dict[int, int] = {}\n\n    def get(self, n: int) -> int | None:\n        \"\"\"Retrieves a value from the cache for a given index n.\"\"\"\n        return self._store.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a value in the cache for a given index n.\"\"\"\n        self._store[n] = value\nclass NewmanConwaySequence:\n    \"\"\"Encapsulates the Newman-Conway recurrence logic and uses memoization.\"\"\"\n    def __init__(self, cache: MemoizationCache = None):\n        self._cache = cache if cache is not None else MemoizationCache()\n\n    def _base_cases(self, n: int) -> int:\n        \"\"\"Handles the base cases P(1)=1 and P(2)=1.\"\"\"\n        return 1\n\n    def compute(self, n: int) -> int:\n        \"\"\"Recursively computes the nth Newman-Conway number with memoization.\"\"\"\n        cached_value = self._cache.get(n)\n        if cached_value is not None:\n            return cached_value\n\n        if n == 1 or n == 2:\n            value = self._base_cases(n)\n        else:\n            # P(n) = P(P(n-1)) + P(n - P(n-1))\n            p_n_minus_1 = self.compute(n - 1)\n            term1 = self.compute(p_n_minus_1)\n            term2 = self.compute(n - p_n_minus_1)\n            value = term1 + term2\n        \n        self._cache.set(n, value)\n        return value\ndef sequence(n: int) -> int:\n    \"\"\"\n    Finds the nth number in the Newman-Conway sequence.\n    Validates input n and uses a memoized recursive computation.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValidationError(\"n must be an integer\")\n    if n <= 0:\n        raise ValidationError(\"n must be > 0\")\n\n    calculator = NewmanConwaySequence()\n    return calculator.compute(n)"}
