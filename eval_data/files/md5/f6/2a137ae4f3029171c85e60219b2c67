{"task_id": "Mbpp/82", "solution": "import math\nclass MathConstant:\n    \"\"\"Holds mathematical constants used in calculations.\"\"\"\n    PI = math.pi\nclass Radius:\n    \"\"\"Represents and validates the raw radius input.\"\"\"\n    def __init__(self, raw_value):\n        \"\"\"Initializes a Radius object with a raw value.\"\"\"\n        self._raw_value = raw_value\n\n    def is_numeric(self) -> bool:\n        \"\"\"Checks if the raw value is an integer or a float.\"\"\"\n        return isinstance(self._raw_value, (int, float))\n\n    @property\n    def value(self) -> float:\n        \"\"\"Returns the radius value as a float, assuming it is numeric.\"\"\"\n        return float(self._raw_value)\nclass VolumeResult:\n    \"\"\"Container for the computed volume value.\"\"\"\n    def __init__(self, value: float) -> None:\n        \"\"\"Initializes a VolumeResult object with a computed volume value.\"\"\"\n        self._value = value\n\n    @property\n    def value(self) -> float:\n        \"\"\"Returns the stored volume value.\"\"\"\n        return self._value\nclass SphereFunction:\n    \"\"\"Encapsulates sphere volume calculation and input validation logic.\"\"\"\n    def __init__(self, pi: float) -> None:\n        \"\"\"Initializes SphereFunction with the PI constant.\"\"\"\n        self._pi = pi\n\n    def validate_radius(self, radius_input) -> bool:\n        \"\"\"Validates if the given radius input is numeric.\"\"\"\n        radius_obj = Radius(radius_input)\n        return radius_obj.is_numeric()\n\n    def volume(self, radius: float) -> float:\n        \"\"\"Computes the volume of a sphere given its radius.\"\"\"\n        # Ensure radius is float for calculation, as it's validated to be numeric.\n        r_val = float(radius)\n        return (4.0 / 3.0) * self._pi * (r_val ** 3)\ndef volume_sphere(radius) -> float:\n    \"\"\"\n    Calculates the volume of a sphere given its radius.\n    Raises TypeError if the radius is not a numeric type.\n    \"\"\"\n    sphere_calculator = SphereFunction(MathConstant.PI)\n\n    if not sphere_calculator.validate_radius(radius):\n        raise TypeError(\"Radius must be a numeric type (int or float).\")\n\n    computed_volume = sphere_calculator.volume(radius)\n    result_container = VolumeResult(computed_volume)\n\n    return result_container.value"}
