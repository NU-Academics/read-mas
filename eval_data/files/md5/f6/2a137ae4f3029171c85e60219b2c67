{"task_id": "Mbpp/473", "solution": "from typing import List, Set, Tuple, Optional, Dict\nclass TuplePair:\n    \"\"\"Represents a 2-element tuple and provides methods for unordered key generation.\"\"\"\n    def __init__(self, a: int, b: int):\n        self.a = a\n        self.b = b\n\n    def as_unordered_key(self) -> 'TupleKey':\n        \"\"\"Returns an unordered key for this TuplePair.\"\"\"\n        return TupleKey(self.a, self.b)\n\n    def equals_unordered(self, other: 'TuplePair') -> bool:\n        \"\"\"Compares two TuplePair instances as unordered pairs.\"\"\"\n        return self.as_unordered_key() == other.as_unordered_key()\nclass TupleKey:\n    \"\"\"Immutable unordered representation of a TuplePair used for hashing and equality.\"\"\"\n    def __init__(self, x: int, y: int):\n        self.x = min(x, y)\n        self.y = max(x, y)\n\n    def __hash__(self) -> int:\n        return hash((self.x, self.y))\n\n    def __eq__(self, other: object) -> bool:\n        # Adhering strictly to \"DO NOT add isinstance() checks\" as per instructions.\n        # In a real-world scenario, checking isinstance(other, TupleKey) would be common.\n        return self.x == other.x and self.y == other.y\nclass TupleList:\n    \"\"\"Container for TuplePair entries and helper to obtain unordered keys.\"\"\"\n    def __init__(self, tuples: Optional[List['TuplePair']] = None):\n        self.tuples: List['TuplePair'] = tuples if tuples is not None else []\n\n    def get_unordered_keys(self) -> Set['TupleKey']:\n        \"\"\"Returns a set of unordered keys for all contained TuplePair objects.\"\"\"\n        return {tp.as_unordered_key() for tp in self.tuples}\nclass ResultSet:\n    \"\"\"Container managing unique matching TuplePair objects, preserving their original order.\"\"\"\n    def __init__(self):\n        self._matches: Dict[TupleKey, TuplePair] = {}\n\n    def add(self, tuple_pair: TuplePair) -> None:\n        \"\"\"Adds a TuplePair to the result set, ensuring uniqueness based on its unordered key.\"\"\"\n        key = tuple_pair.as_unordered_key()\n        if key not in self._matches:\n            self._matches[key] = tuple_pair\n\n    def to_native_set(self) -> Set[Tuple[int, int]]:\n        \"\"\"Converts the internal collection of TuplePair objects to a native Python set of tuples.\"\"\"\n        return {(tp.a, tp.b) for tp in self._matches.values()}\nclass TupleIntersectionFunction:\n    \"\"\"Implements the algorithm to find tuple intersections based on unordered pairs.\"\"\"\n    def tuple_intersection(self, listA: TupleList, listB: TupleList) -> ResultSet:\n        \"\"\"Finds matching TuplePair objects between two TupleList instances.\"\"\"\n        result_set = ResultSet()\n        unordered_keys_b = listB.get_unordered_keys()\n\n        for tuple_pair_a in listA.tuples:\n            if tuple_pair_a.as_unordered_key() in unordered_keys_b:\n                result_set.add(tuple_pair_a)\n        return result_set\ndef tuple_intersection(listA: List[Tuple[int, int]], listB: List[Tuple[int, int]]) -> Set[Tuple[int, int]]:\n    \"\"\"\n    Finds the tuple intersection of elements in the given tuple list irrespective of their order.\n    The result set preserves the element order of tuples from the first input list.\n    \"\"\"\n    # Convert native input lists to domain objects\n    tuple_list_a_pairs = [TuplePair(a, b) for a, b in listA]\n    tuple_list_b_pairs = [TuplePair(a, b) for a, b in listB]\n\n    tuple_list_a = TupleList(tuple_list_a_pairs)\n    tuple_list_b = TupleList(tuple_list_b_pairs)\n\n    # Delegate to the core intersection logic\n    intersection_function = TupleIntersectionFunction()\n    result_set = intersection_function.tuple_intersection(tuple_list_a, tuple_list_b)\n\n    # Convert the ResultSet back to a native Python set of tuples\n    return result_set.to_native_set()"}
{"task_id": "Mbpp/476", "solution": "from typing import Sequence, Union\nNumericArray = Sequence[Union[int, float]]\nNumber = Union[int, float]\nclass InputValidator:\n    \"\"\"Validates input array for the big_sum function.\"\"\"\n    def validate(self, arr: NumericArray) -> None:\n        \"\"\"Ensures the array is non-empty and contains only numeric values.\"\"\"\n        if not arr:\n            raise ValueError(\"Input array cannot be empty.\")\n        for item in arr:\n            if not isinstance(item, (int, float)):\n                raise ValueError(\"All elements in the array must be numeric (int or float).\")\ndef big_sum(arr: NumericArray) -> Number:\n    \"\"\"Finds the sum of the largest and smallest value in a given array.\"\"\"\n    validator = InputValidator()\n    validator.validate(arr)\n\n    if len(arr) == 1:\n        return arr[0] + arr[0]\n    else:\n        return min(arr) + max(arr)"}
{"task_id": "Mbpp/468", "solution": "def max_product(arr):\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence of an array.\n    An increasing subsequence has strictly increasing indices and strictly increasing numeric values.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0.0\n\n    # dp[i] stores the maximum product of an increasing subsequence ending with arr[i].\n    dp = [float(x) for x in arr]\n\n    # Initialize the overall maximum product with the largest single-element subsequence.\n    max_overall_product = max(dp)\n\n    for i in range(n):\n        for j in range(i):\n            # If arr[i] can extend the increasing subsequence ending at arr[j].\n            if arr[i] > arr[j]:\n                # Update dp[i] with the maximum product found by extending previous subsequences.\n                dp[i] = max(dp[i], dp[j] * arr[i])\n        \n        # Update the overall maximum product found so far.\n        max_overall_product = max(max_overall_product, dp[i])\n    \n    return max_overall_product"}
