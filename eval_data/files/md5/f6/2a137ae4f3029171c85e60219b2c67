{"task_id": "Mbpp/9", "solution": "def rotate_left(s: str, k: int) -> str:\n    \"\"\"Rotates string s to the left by k positions.\"\"\"\n    return s[k:] + s[:k]\ndef find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of positive rotations (k > 0) required to get the same string.\n    The rotation is a left cyclic shift.\n    \"\"\"\n    n = len(s)\n    for k in range(1, n + 1):\n        if rotate_left(s, k) == s:\n            return k\n    return n # Should not be reached if k=n is always a match, but included for completeness"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(n: int) -> bool:\n    \"\"\"Checks if a number is non-prime. Returns True for non-prime, False for prime.\"\"\"\n    if n <= 1:\n        return True\n    if n == 2:\n        return False\n    if n % 2 == 0:\n        return True\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return True\n        i += 2\n    return False"}
{"task_id": "Mbpp/6", "solution": "class ComparisonResult:\n    \"\"\"Holds the boolean outcome and differing-bits count.\"\"\"\n    def __init__(self, is_one_bit_diff: bool, differing_bits_count: int) -> None:\n        self.is_one_bit_diff: bool = is_one_bit_diff\n        self.differing_bits_count: int = differing_bits_count\nclass BitComparator:\n    \"\"\"Performs XOR-and-count algorithm; produces ComparisonResult.\"\"\"\n    def differ_At_One_Bit_Pos(self, a: int, b: int) -> ComparisonResult:\n        xor = a ^ b\n        count = self._count_set_bits(xor)\n        return ComparisonResult(is_one_bit_diff=(count == 1), differing_bits_count=count)\n\n    def _count_set_bits(self, n: int) -> int:\n        \"\"\"Counts set bits in a non-negative integer using Kernighan's algorithm.\"\"\"\n        c = 0\n        while n:\n            n &= (n - 1)\n            c += 1\n        return c\ndef differ_At_One_Bit_Pos(a, b) -> bool:\n    \"\"\"Checks if two numbers differ at exactly one bit position.\"\"\"\n    comparator = BitComparator()\n    result = comparator.differ_At_One_Bit_Pos(a, b)\n    return result.is_one_bit_diff"}
{"task_id": "Mbpp/11", "solution": "class InputString:\n    \"\"\"Represent input string data and provide derived length.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input string.\"\"\"\n        return len(self.value)\nclass Character:\n    \"\"\"Represent the target character.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\nclass Occurrence:\n    \"\"\"Hold computed indices for first and last occurrence of target_char.\"\"\"\n    def __init__(self, first_index: int | None, last_index: int | None) -> None:\n        self.first_index = first_index\n        self.last_index = last_index\nclass Remove_Occ:\n    \"\"\"Encapsulates core algorithm: compute first and last occurrence indices and construct the output string.\"\"\"\n    def __init__(self, input_string: str, target_char: str) -> None:\n        self.input_string = input_string\n        self.target_char = target_char\n\n    def execute(self) -> str:\n        \"\"\"Computes occurrences, removes characters per business rules, and returns resulting string.\"\"\"\n        first_idx = self.input_string.find(self.target_char)\n        \n        if first_idx == -1:\n            return self.input_string\n\n        last_idx = self.input_string.rfind(self.target_char)\n        \n        occurrence = Occurrence(first_idx, last_idx)\n        \n        result_chars = []\n        for i, char in enumerate(self.input_string):\n            if i == occurrence.first_index or i == occurrence.last_index:\n                continue\n            result_chars.append(char)\n        \n        return \"\".join(result_chars)\ndef remove_Occ(input_string, target_char) -> str:\n    \"\"\"Removes the first and last occurrence of a given character from the string.\"\"\"\n    _ = InputString(input_string)\n    _ = Character(target_char)\n    \n    controller = Remove_Occ(input_string, target_char)\n    result = controller.execute()\n    \n    return result"}
{"task_id": "Mbpp/4", "solution": "import heapq\ndef heap_queue_largest(input_list: list[int], n: int) -> list[int]:\n    \"\"\"\n    Finds the n largest integers from a given list, returned in descending order.\n    Handles edge cases for n <= 0 and n >= list length.\n    \"\"\"\n    if n <= 0:\n        return []\n\n    # If n is greater than or equal to the list length, return all elements sorted descending.\n    if n >= len(input_list):\n        return sorted(input_list, reverse=True)\n\n    # Otherwise, use heapq.nlargest to find the n largest elements.\n    # heapq.nlargest returns elements in descending order by default.\n    return heapq.nlargest(n, input_list)"}
