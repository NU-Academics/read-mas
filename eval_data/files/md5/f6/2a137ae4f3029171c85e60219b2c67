{"task_id": "Mbpp/784", "solution": "def mul_even_odd(list_of_ints):\n    \"\"\"Return the product (int) of the first odd and first even integers found scanning list_of_ints from start to end.\n\n    Raises ValueError if first odd or first even not found.\n    \"\"\"\n    first_odd = None\n    first_even = None\n\n    for num in list_of_ints:\n        if num % 2 != 0:  # It's odd\n            if first_odd is None:\n                first_odd = num\n        else:  # It's even\n            if first_even is None:\n                first_even = num\n\n        if first_odd is not None and first_even is not None:\n            return first_odd * first_even\n\n    if first_odd is None or first_even is None:\n        raise ValueError(\"The list must contain at least one odd and one even number.\")"}
{"task_id": "Mbpp/785", "solution": "from dataclasses import dataclass\nfrom typing import List\nclass TupleStringConverter:\n    \"\"\"Orchestrates parsing and conversion of a tuple string into an integer tuple.\"\"\"\n\n    def tuple_str_int(self, input: str) -> tuple:\n        \"\"\"Delegates parsing and conversion, then assembles the final integer tuple.\"\"\"\n        ts = TupleString(input)\n        ints = self._parse(ts.raw)\n        it = IntegerTuple(ints)\n        return it.to_tuple()\n\n    def _parse(self, input: str) -> List[int]:\n        \"\"\"Parses the raw string, extracts integer tokens, and converts them to integers.\"\"\"\n        # Remove surrounding parentheses and strip any leading/trailing whitespace\n        content = input.strip()[1:-1]\n\n        # Handle an empty tuple string \"()\" which results in an empty content string\n        if not content.strip():\n            return []\n\n        # Split by comma, strip whitespace from each part, and convert to integer\n        parts = content.split(',')\n        integers = [int(part.strip()) for part in parts]\n        return integers\ndef tuple_str_int(input: str) -> tuple:\n    \"\"\"\n    Converts a string representation of an integer tuple (e.g., \"(7, 8, 9)\")\n    into an actual Python tuple of integers (e.g., (7, 8, 9)).\n    \"\"\"\n    converter = TupleStringConverter()\n    return converter.tuple_str_int(input)"}
{"task_id": "Mbpp/787", "solution": "from dataclasses import dataclass\ndef _contains_abbb(s: str) -> bool:\n    \"\"\"Checks if the string 's' contains the substring 'abbb'.\"\"\"\n    return \"abbb\" in s\ndef text_match_three(input: str) -> bool:\n    \"\"\"\n    Matches a string that has an 'a' followed by three 'b' characters (\"abbb\").\n    Returns True if \"abbb\" is found, False otherwise.\n    \"\"\"\n    inp = InputString(value=input)\n    matches = _contains_abbb(inp.value)\n    result = MatchResult(matches=matches)\n    return result.matches"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list, value):\n    \"\"\"Return integer insertion index i in range [0, len(sorted_list)] such that inserting value at i preserves ascending order and places duplicates to the right.\n\n    Args:\n        sorted_list (list): list assumed sorted in ascending order\n        value (any): value comparable to list elements\n\n    Returns:\n        int: insertion index\n    \"\"\"\n    lo = 0\n    hi = len(sorted_list)\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if sorted_list[mid] <= value:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo"}
