{"task_id": "Mbpp/799", "solution": "def _mask_to_32(number: int) -> int:\n    \"\"\"Masks an integer to its unsigned 32-bit representation.\"\"\"\n    return number & 0xFFFFFFFF\ndef _effective_rotation(d: int) -> int:\n    \"\"\"Computes the effective rotation count by taking modulo 32.\"\"\"\n    return d % 32\ndef left_rotate(number: int, d: int) -> int:\n    \"\"\"\n    Rotates the bits of a 32-bit number to the left by d positions.\n    The number is treated as an unsigned 32-bit integer.\n    \"\"\"\n    value = _mask_to_32(number)\n    effective = _effective_rotation(d)\n\n    if effective == 0:\n        return value\n\n    left_part = (value << effective) & 0xFFFFFFFF\n    right_part = (value >> (32 - effective)) & 0xFFFFFFFF\n    \n    result = (left_part | right_part) & 0xFFFFFFFF\n    return result"}
{"task_id": "Mbpp/800", "solution": "_WHITESPACE_CHARS = {' ', '\\t', '\\n', '\\r', '\\v', '\\f'}\ndef is_whitespace(c: str) -> bool:\n    \"\"\"Checks if a character is one of the explicitly defined whitespace characters.\"\"\"\n    return c in _WHITESPACE_CHARS\ndef remove_all_spaces(input: str) -> str:\n    \"\"\"Removes all defined whitespace characters from the input string.\"\"\"\n    result_chars = []\n    for char in input:\n        if not is_whitespace(char):\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/801", "solution": "from src.input_validator import InputValidator\nfrom src.domain import IntegerParameter, Result\ndef test_three_equal(a, b, c) -> int:\n    \"\"\"Validate inputs and return equality count: 3, 2, or 0.\"\"\"\n    validator = InputValidator()\n    validator.raise_error_if_invalid(a)\n    validator.raise_error_if_invalid(b)\n    validator.raise_error_if_invalid(c)\n\n    if a == b == c:\n        return 3\n    if a == b or a == c or b == c:\n        return 2\n    return 0"}
{"task_id": "Mbpp/803", "solution": "from math import sqrt, isfinite, floor\ndef is_perfect_square(n) -> bool:\n    \"\"\"Checks if a given number is a perfect square.\n    Returns False for non-finite, negative, or non-integer-like numbers.\"\"\"\n\n    if not isfinite(n):\n        return False\n\n    if n < 0:\n        return False\n\n    # Treat floats with no fractional part as integers.\n    # If n is not equal to its floor, it has a fractional part.\n    if n != floor(n):\n        return False\n\n    # At this point, n is a finite, non-negative, integer-like number.\n    # Compute the integer square root candidate.\n    k = floor(sqrt(n))\n\n    # Check if k*k equals n.\n    return k * k == n"}
{"task_id": "Mbpp/804", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the is_product_even function.\"\"\"\n    pass\ndef is_product_even(numbers: list) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    The product is even if at least one number in the list is an even integer.\n    \"\"\"\n    if not isinstance(numbers, (list, tuple)):\n        raise InvalidInputError(\"Input must be a list or tuple of numbers.\")\n\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise InvalidInputError(\"All elements in the list must be numbers.\")\n\n        # Check for integer evenness, including float representations of integers.\n        if isinstance(num, int):\n            if num % 2 == 0:\n                return True\n        elif isinstance(num, float):\n            # Only consider floats that are effectively integers (e.g., 2.0) for parity.\n            if num == int(num) and int(num) % 2 == 0:\n                return True\n\n    # If no even integer was found, the product is odd (or list was empty, product is 1).\n    return False"}
{"task_id": "Mbpp/805", "solution": "from typing import List\ndef _compute_inner_list_sum(inner: List[float]) -> float:\n    \"\"\"Computes arithmetic sum of inner list elements.\n    Returns 0.0 for empty inner list.\"\"\"\n    return sum(inner)\ndef _select_max_inner_list(input_lists: List[List[float]], sums: List[float]) -> List[float]:\n    \"\"\"Selects the inner list corresponding to the maximum value in sums.\n    Tie-breaking: return first inner list with the maximum sum.\"\"\"\n    max_sum = max(sums)\n    max_sum_index = sums.index(max_sum)\n    return input_lists[max_sum_index]\ndef max_sum_list(input_lists: List[List[float]]) -> List[float]:\n    \"\"\"Public API: returns the inner list with maximum arithmetic sum.\n    Orchestrates sum computation and selection.\"\"\"\n    list_sums = []\n    for inner_list in input_lists:\n        list_sums.append(_compute_inner_list_sum(inner_list))\n\n    return _select_max_inner_list(input_lists, list_sums)"}
{"task_id": "Mbpp/806", "solution": "class InputValidator:\n    def is_valid_string(self, s: str) -> bool:\n        \"\"\"Checks if the input is a string.\"\"\"\n        return isinstance(s, str)\nclass UppercaseRunCalculator:\n    def is_upper(self, c: str) -> bool:\n        \"\"\"Checks if a character is an ASCII uppercase letter.\"\"\"\n        return len(c) == 1 and 'A' <= c <= 'Z'\n\n    def compute_max_run(self, s: str) -> int:\n        \"\"\"Computes the length of the longest consecutive run of ASCII uppercase letters.\"\"\"\n        current_run = 0\n        max_run = 0\n        for char in s:\n            if self.is_upper(char):\n                current_run += 1\n                if current_run > max_run:\n                    max_run = current_run\n            else:\n                current_run = 0\n        return max_run\ndef max_run_uppercase(s: str) -> int:\n    \"\"\"Finds the maximum run of uppercase characters in the given string.\"\"\"\n    validator = InputValidator()\n    if not validator.is_valid_string(s):\n        raise TypeError(\"Input must be a str\")\n\n    calculator = UppercaseRunCalculator()\n    result = calculator.compute_max_run(s)\n    return result"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers: list) -> int | None:\n    \"\"\"\n    Finds the first odd number in a list of numbers.\n\n    Validates input and returns the first odd integer or None if none are found.\n    \"\"\"\n    _validate_is_list(numbers)\n    _validate_elements_are_integers(numbers)\n\n    for number in numbers:\n        if number % 2 != 0: # An integer is odd if its remainder when divided by 2 is not 0 (i.e., 1 or -1)\n            return number\n    return None"}
