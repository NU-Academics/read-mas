{"task_id": "Mbpp/629", "solution": "def Split(input_list):\n    \"\"\"Accepts a list of integers and returns a new list containing only the even integers, preserving order.\n       Precondition: input_list is a list of integers.\"\"\"\n    even_numbers = []\n    for number in input_list:\n        if number % 2 == 0:\n            even_numbers.append(number)\n    return even_numbers"}
{"task_id": "Mbpp/630", "solution": "class Coordinate:\n    \"\"\"Represents a 2D coordinate.\"\"\"\n    def __init__(self, x: int, y: int) -> None:\n        self.x = x\n        self.y = y\n\n    def to_list(self) -> list:\n        \"\"\"Returns the coordinate as a two-element list [x, y].\"\"\"\n        return [self.x, self.y]\nclass CoordinateList:\n    \"\"\"A collection of Coordinate objects.\"\"\"\n    def __init__(self, coordinates: list[Coordinate]) -> None:\n        self.coordinates = coordinates\n\n    def size(self) -> int:\n        \"\"\"Returns the number of coordinates in the list.\"\"\"\n        return len(self.coordinates)\n\n    def to_list(self) -> list:\n        \"\"\"Converts the list of Coordinate objects to a list of [x, y] lists.\"\"\"\n        return [coord.to_list() for coord in self.coordinates]\nclass GetCoordinatesFunction:\n    \"\"\"Handles the logic for extracting adjacent coordinates.\"\"\"\n    def get_coordinates(self, coord_tuple: tuple) -> list:\n        \"\"\"\n        Computes the 3x3 neighborhood centered on the given coordinate, returning it in row-major order.\n        Assumes coord_tuple is a tuple of two integers.\n        \"\"\"\n        x_center, y_center = coord_tuple\n        adjacent_coords = []\n\n        # Iterate through x values (rows)\n        for i in range(x_center - 1, x_center + 2):\n            # Iterate through y values (columns)\n            for j in range(y_center - 1, y_center + 2):\n                adjacent_coords.append(Coordinate(i, j))\n        \n        coord_list_obj = CoordinateList(adjacent_coords)\n        return coord_list_obj.to_list()\ndef get_coordinates(coord_tuple: tuple) -> list:\n    \"\"\"\n    Extracts all adjacent coordinates (3x3 neighborhood) of the given coordinate tuple.\n    The result is ordered row-major and includes the original coordinate.\n    \"\"\"\n    calculator = GetCoordinatesFunction()\n    return calculator.get_coordinates(coord_tuple)"}
{"task_id": "Mbpp/631", "solution": "from enum import Enum\nclass ConversionDirection(Enum):\n    SPACES_TO_UNDERSCORES = 'SPACES_TO_UNDERSCORES'\n    UNDERSCORES_TO_SPACES = 'UNDERSCORES_TO_SPACES'\ndef replace_spaces(input: str, direction: ConversionDirection = ConversionDirection.SPACES_TO_UNDERSCORES) -> str:\n    \"\"\"Convert whitespace<->underscores according to direction and return new string.\"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"input must be a string\")\n\n    if direction == ConversionDirection.SPACES_TO_UNDERSCORES:\n        return ''.join(['_' if char.isspace() else char for char in input])\n    elif direction == ConversionDirection.UNDERSCORES_TO_SPACES:\n        return ''.join([' ' if char == '_' else char for char in input])\n    else:\n        # This case should ideally not be reached if direction is a strict Enum\n        raise ValueError(\"Invalid conversion direction specified.\")"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(arr, n):\n    \"\"\"\n    Calculates the sum of XOR of all unique pairs of numbers from the first n elements of the given list.\n    \"\"\"\n    total_xor_sum = 0\n    for i in range(n):\n        for j in range(i + 1, n):\n            total_xor_sum += arr[i] ^ arr[j]\n    return total_xor_sum"}
{"task_id": "Mbpp/635", "solution": "from typing import List\ndef heap_sort(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Sorts a list of integers in ascending order using the heap sort algorithm.\n    Returns a new list containing the sorted elements.\n    \"\"\"\n    arr = list(input_list)  # Create a mutable copy of the input list\n    n = len(arr)\n\n    # Phase 1: Build a max-heap from the input array\n    _build_max_heap(arr)\n\n    # Phase 2: Extract elements one by one from the heap\n    for i in range(n - 1, 0, -1):\n        # Move current root (max element) to end of current heap portion\n        arr[0], arr[i] = arr[i], arr[0]\n        # Call sift_down on the reduced heap (elements from 0 to i-1)\n        _sift_down(arr, 0, i - 1)\n\n    return arr"}
