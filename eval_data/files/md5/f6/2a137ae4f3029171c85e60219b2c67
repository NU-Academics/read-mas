{"task_id": "Mbpp/415", "solution": "from typing import List, Tuple\nclass Pair:\n    \"\"\"Value object holding two integers and computing their product.\"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n\n    def product(self) -> int:\n        \"\"\"Returns the product of the two integers.\"\"\"\n        return self.a * self.b\nclass Validator:\n    \"\"\"Stateless validator for input arguments.\"\"\"\n    @staticmethod\n    def validate(arr: any) -> None:\n        \"\"\"\n        Validates the input array for type and length constraints.\n        Raises TypeError or ValueError for invalid inputs.\n        \"\"\"\n        if not isinstance(arr, list):\n            raise TypeError(\"arr must be a list of integers\")\n        if len(arr) < 2:\n            raise ValueError(\"arr must contain at least two integers\")\n        for x in arr:\n            if not isinstance(x, int):\n                raise TypeError(\"arr elements must be ints\")\ndef max_Product(arr: list[int]) -> tuple[int, int]:\n    \"\"\"\n    Finds a pair with the highest product from a given array of integers.\n    The function validates input, computes the pair whose product is maximal,\n    and returns the pair as a deterministic tuple (smaller first, larger second).\n    \"\"\"\n    Validator.validate(arr)\n\n    max1 = float('-inf')\n    max2 = float('-inf')\n    min1 = float('inf')\n    min2 = float('inf')\n\n    for v in arr:\n        # Update two largest numbers\n        if v > max1:\n            max2 = max1\n            max1 = v\n        elif v > max2:\n            max2 = v\n\n        # Update two smallest numbers\n        if v < min1:\n            min2 = min1\n            min1 = v\n        elif v < min2:\n            min2 = v\n\n    # Create candidate pairs\n    candidate1_pair = Pair(int(max1), int(max2))\n    candidate2_pair = Pair(int(min1), int(min2))\n\n    prod1 = candidate1_pair.product()\n    prod2 = candidate2_pair.product()\n\n    selected_a: int\n    selected_b: int\n\n    if prod1 > prod2:\n        selected_a, selected_b = int(max1), int(max2)\n    elif prod2 > prod1:\n        selected_a, selected_b = int(min1), int(min2)\n    else: # prod1 == prod2, apply deterministic tie-breaker\n        # Sort candidates for comparison: (smaller, larger)\n        c1_sorted_tuple = (min(int(max1), int(max2)), max(int(max1), int(max2)))\n        c2_sorted_tuple = (min(int(min1), int(min2)), max(int(min1), int(min2)))\n\n        # Tie-breaker: choose pair with larger maximum element\n        if c1_sorted_tuple[1] > c2_sorted_tuple[1]:\n            selected_a, selected_b = int(max1), int(max2)\n        elif c2_sorted_tuple[1] > c1_sorted_tuple[1]:\n            selected_a, selected_b = int(min1), int(min2)\n        else: # Max elements are equal, tie-breaker: choose pair with larger minimum element\n            if c1_sorted_tuple[0] > c2_sorted_tuple[0]:\n                selected_a, selected_b = int(max1), int(max2)\n            else:\n                selected_a, selected_b = int(min1), int(min2)\n\n    # Return the selected pair, ordered ascending\n    return (min(selected_a, selected_b), max(selected_a, selected_b))"}
{"task_id": "Mbpp/413", "solution": "def extract_nth_element(list_of_tuples, n):\n    \"\"\"Return list of nth elements from each tuple in list_of_tuples.\n\n    Parameters:\n      list_of_tuples: list -- each element must be a tuple (TypeError otherwise)\n      n: int -- zero-based index into tuples (TypeError if not int)\n\n    Returns:\n      list -- elements at index n from each tuple in input order\n\n    Raises:\n      TypeError -- if list_of_tuples is not a list, any element is not a tuple, or n is not an int\n      IndexError -- if any tuple does not contain index n (no partial result)\n    \"\"\"\n    _validate_inputs(list_of_tuples, n)\n\n    result = []\n    for tpl in list_of_tuples:\n        try:\n            result.append(tpl[n])\n        except IndexError:\n            raise # Re-raise IndexError if any tuple is too short\n    return result"}
{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n):\n    \"\"\"Compute the average of the cubes of the first n natural numbers.\"\"\"\n    if n <= 0:\n        return 0.0 # Or handle as an error if problem statement allows, but 0.0 for average of no numbers is reasonable.\n    \n    sum_of_cubes = sum(i**3 for i in range(1, n + 1))\n    return sum_of_cubes / n"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(input_list):\n    \"\"\"Return the element of input_list with the maximum len().\n\n    Validates input_list and handles empty input or elements lacking len() support.\n    On ties, returns the first element with maximum length.\n    \"\"\"\n    _validate_input(input_list)\n\n    if not input_list:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    max_element = None\n    max_length = -1\n\n    for element in input_list:\n        current_length = len(element)\n        if current_length > max_length:\n            max_length = current_length\n            max_element = element\n\n    return max_element"}
{"task_id": "Mbpp/421", "solution": "def concatenate_tuple(input_tuple, delimiter='-'):\n    \"\"\"\n    Concatenates each element of a tuple into a single string using a specified delimiter.\n    Each element is converted to its string representation before joining.\n    \"\"\"\n    return delimiter.join(str(item) for item in input_tuple)"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n):\n    \"\"\"Validate n and return sum of cubes of first n even natural numbers.\n\n    Raises:\n        TypeError: if n is not an int\n        ValueError: if n < 0\n\n    Returns:\n        int: result (0 for n == 0, or 2 * n**2 * (n + 1)**2 for n > 0)\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' cannot be negative.\")\n    if n == 0:\n        return 0\n    else: # n > 0\n        return 2 * n**2 * (n + 1)**2"}
