{"task_id": "Mbpp/605", "solution": "import math\nclass PrimeChecker:\n    \"\"\"\n    Encapsulates the logic for checking primality.\n    \"\"\"\n    def _is_prime(self, n: int) -> bool:\n        \"\"\"\n        Private helper method to perform the primality test using trial division.\n        Assumes n >= 2 based on public method's handling.\n        \"\"\"\n        if n % 2 == 0:\n            return False\n        # Only check odd divisors up to the square root of n\n        for i in range(3, int(math.isqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    def prime_num(self, n: int) -> bool:\n        \"\"\"\n        Checks if an integer is a prime number.\n        Handles edge cases for numbers less than 2.\n        \"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        return self._is_prime(n)\n_prime_checker_instance = PrimeChecker()\ndef prime_num(n: int) -> bool:\n    \"\"\"\n    Checks if the given integer is a prime number.\n    Returns True for prime numbers, False otherwise.\n    \"\"\"\n    return _prime_checker_instance.prime_num(n)"}
