{"task_id": "Mbpp/615", "solution": "from typing import Tuple, List, Union, Any\ndef _compute_average(inner_tuple: Tuple[Union[int, float], ...]) -> float:\n    \"\"\"Computes the arithmetic mean of a tuple of numbers.\"\"\"\n    return sum(inner_tuple) / len(inner_tuple)\ndef average_tuple(tuple_of_tuples: Tuple[Tuple[Union[int, float], ...], ...]) -> List[float]:\n    \"\"\"\n    Calculates the average value for each inner tuple in a tuple of tuples.\n    Performs comprehensive validation before computing averages.\n    \"\"\"\n    _validate_top_level(tuple_of_tuples)\n\n    # All inner tuple validations must pass before any averages are computed.\n    for idx, inner in enumerate(tuple_of_tuples):\n        _validate_inner_tuple(inner, idx)\n\n    result: List[float] = []\n    for inner in tuple_of_tuples:\n        avg = _compute_average(inner)\n        result.append(avg)\n\n    return result"}
{"task_id": "Mbpp/616", "solution": "def _compute_elementwise_modulo(a: tuple[int], b: tuple[int]) -> tuple[int]:\n    \"\"\"Computes the element-wise modulo of two tuples.\"\"\"\n    return tuple(a[i] % b[i] for i in range(len(a)))\ndef tuple_modulo(a: tuple[int], b: tuple[int]) -> tuple[int]:\n    \"\"\"\n    Performs element-wise modulo on two tuples of the same length.\n    Input validation (type, length, zero divisors) is not performed per requirements.\n    \"\"\"\n    return _compute_elementwise_modulo(a, b)"}
{"task_id": "Mbpp/618", "solution": "class LengthMismatchError(Exception):\n    def __init__(self, message: str = \"Input lists must have the same length\"):\n        super().__init__(message)\nclass NumericElement:\n    def __init__(self, value):\n        self._value = value\n\n    def is_numeric(self) -> bool:\n        return isinstance(self._value, (int, float))\n\n    def to_float(self) -> float:\n        if not self.is_numeric():\n            raise ValueError(f\"Element '{self._value}' is not numeric.\")\n        return float(self._value)\nclass InputList:\n    def __init__(self, elements):\n        self._elements = [NumericElement(e) for e in elements]\n\n    @property\n    def length(self) -> int:\n        return len(self._elements)\n\n    def validate_all_numeric(self) -> None:\n        for i, element in enumerate(self._elements):\n            if not element.is_numeric():\n                raise ValueError(f\"Non-numeric value '{element._value}' found at index {i}.\")\n\n    def numeric_elements(self) -> list:\n        return self._elements\nclass ResultList:\n    def __init__(self, elements: list):\n        self._elements = elements\n\n    @property\n    def length(self) -> int:\n        return len(self._elements)\n\n    @property\n    def elements(self) -> list:\n        return self._elements\nclass DivListFunction:\n    name = \"div_list\"\n\n    def execute(self, listA, listB) -> list[float]:\n        input_list_a = InputList(listA)\n        input_list_a.validate_all_numeric()\n\n        input_list_b = InputList(listB)\n        input_list_b.validate_all_numeric()\n\n        if input_list_a.length != input_list_b.length:\n            raise LengthMismatchError()\n\n        results = []\n        for i in range(input_list_a.length):\n            numerator = input_list_a.numeric_elements()[i].to_float()\n            denominator = input_list_b.numeric_elements()[i].to_float()\n            results.append(numerator / denominator)\n\n        result_list = ResultList(results)\n        return result_list.elements\ndef div_list(listA, listB) -> list[float]:\n    \"\"\"Public API for element-wise division of two numeric lists.\"\"\"\n    function_executor = DivListFunction()\n    return function_executor.execute(listA, listB)"}
{"task_id": "Mbpp/619", "solution": "from typing import List\nclass MoveNumFunction:\n    \"\"\"Helper class encapsulating the logic to move numbers to the end of a string.\"\"\"\n\n    def move_num(self, s: str) -> str:\n        \"\"\"\n        Orchestrates the extraction of digits and non-digits,\n        then builds the final output string.\n        \"\"\"\n        digit_chars: List[str] = self.extractDigits(s)\n        non_digits_chars: List[str] = [char for char in s if not char.isdigit()]\n        return self.buildOutput(non_digits_chars, digit_chars)\n\n    def extractDigits(self, s: str) -> List[str]:\n        \"\"\"Extracts and returns an ordered list of digit characters from the input string.\"\"\"\n        return [char for char in s if char.isdigit()]\n\n    def buildOutput(self, non_digits: List[str], digits: List[str]) -> str:\n        \"\"\"Concatenates non-digit characters followed by digit characters.\"\"\"\n        return \"\".join(non_digits) + \"\".join(digits)\ndef move_num(s: str) -> str:\n    \"\"\"\n    Moves all digit characters in the input string to the end,\n    preserving their relative order and the order of non-digit characters.\n    \"\"\"\n    return MoveNumFunction().move_num(s)"}
{"task_id": "Mbpp/620", "solution": "from typing import List, Any, Set, Tuple\nclass Number:\n    \"\"\"Domain class representing an individual integer and divisibility test.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isDivisibleBy(self, other: 'Number') -> bool:\n        \"\"\"Checks if this number or the other number is divisible by the other.\"\"\"\n        # For non-zero numbers a, b: a % b == 0 or b % a == 0\n        # The design explicitly forbids zero in input, so no division by zero here.\n        return self.value % other.value == 0 or other.value % self.value == 0\n\n    def __eq__(self, other: Any) -> bool:\n        if not isinstance(other, Number):\n            return NotImplemented\n        return self.value == other.value\n\n    def __hash__(self) -> int:\n        return hash(self.value)\nclass InputList:\n    \"\"\"Encapsulates raw input and performs validation.\"\"\"\n    def __init__(self, raw: List[Any]):\n        self.raw = raw\n        self.numbers: List[Number] = []\n\n    def validate(self) -> None:\n        \"\"\"Validates raw input and populates self.numbers.\"\"\"\n        # Per prompt instructions (\"DO NOT add isinstance() checks or raise exceptions for edge cases\"),\n        # specific validation for type and zero values is omitted here,\n        # assuming valid input for the purpose of this completion.\n        self.numbers = [Number(x) for x in self.raw]\nclass DivisibilityGraph:\n    \"\"\"Builds pairwise divisibility adjacency among Number nodes.\"\"\"\n    def __init__(self):\n        self.nodes: List[Number] = []\n        self.edges: Set[Tuple[int, int]] = set() # Stores indices of nodes\n\n    def build(self, numbers: List[Number]) -> None:\n        \"\"\"Constructs nodes and edges based on pairwise divisibility.\"\"\"\n        self.nodes = numbers\n        n = len(numbers)\n        for i in range(n):\n            for j in range(i + 1, n):\n                if numbers[i].isDivisibleBy(numbers[j]):\n                    self.edges.add((i, j))\n                    self.edges.add((j, i)) # Undirected edge for pairwise divisibility\n\n    def areAdjacent(self, a_idx: int, b_idx: int) -> bool:\n        \"\"\"Checks if two nodes (by index) are adjacent in the graph.\"\"\"\n        return (a_idx, b_idx) in self.edges\nclass Subset:\n    \"\"\"Represents a candidate subset of Number instances and verifies pairwise divisibility and size.\"\"\"\n    def __init__(self, members: List[Number]):\n        self.members = members\n\n    def isPairwiseDivisible(self) -> bool:\n        \"\"\"Checks if all pairs within the subset are divisible by each other.\"\"\"\n        n = len(self.members)\n        for i in range(n):\n            for j in range(i + 1, n):\n                if not self.members[i].isDivisibleBy(self.members[j]):\n                    return False\n        return True\n\n    def size(self) -> int:\n        \"\"\"Returns the number of members in the subset.\"\"\"\n        return len(self.members)\nclass Result:\n    \"\"\"Container for computed result size.\"\"\"\n    def __init__(self, size: int):\n        self.size = size\nclass LargestSubsetCalculator:\n    \"\"\"Computes the largest pairwise-divisible subset using the DivisibilityGraph.\"\"\"\n    def computeLongestPairwiseDivisibleSubset(self, graph: DivisibilityGraph) -> Subset:\n        \"\"\"Computes the largest divisible subset (longest chain) from the graph's nodes.\"\"\"\n        if not graph.nodes:\n            return Subset([])\n\n        # Sort numbers by value to apply dynamic programming for longest divisible chain.\n        sorted_nodes = sorted(graph.nodes, key=lambda n: n.value)\n        n = len(sorted_nodes)\n\n        dp = [1] * n # dp[i] is the length of the longest divisible subset ending with sorted_nodes[i]\n        parent = [-1] * n # parent[i] stores the index of the previous node in the longest chain\n\n        max_len = 1 # Smallest possible chain length for a non-empty list is 1\n        last_idx = 0 # Default to the first element's index if nothing longer is found\n\n        for i in range(n):\n            for j in range(i):\n                # If sorted_nodes[i] is divisible by sorted_nodes[j],\n                # then sorted_nodes[j] can precede sorted_nodes[i] in a chain.\n                if sorted_nodes[i].value % sorted_nodes[j].value == 0:\n                    if dp[j] + 1 > dp[i]:\n                        dp[i] = dp[j] + 1\n                        parent[i] = j\n            \n            # Update the overall maximum length and its ending index\n            if dp[i] > max_len:\n                max_len = dp[i]\n                last_idx = i\n        \n        # Reconstruct the longest subset\n        current_idx = last_idx\n        longest_members: List[Number] = []\n        while current_idx != -1:\n            longest_members.append(sorted_nodes[current_idx])\n            current_idx = parent[current_idx]\n        \n        longest_members.reverse() # Reconstruct in ascending order\n        return Subset(longest_members)\ndef largest_subset(nums: List[int]) -> int:\n    \"\"\"Entry point per FR1; validates, computes, and returns size or raises InvalidInputError.\"\"\"\n    # BR7: Empty input returns 0.\n    if not nums:\n        return 0\n\n    il = InputList(nums)\n    # il.validate() would typically raise InvalidInputError for invalid types or zeros.\n    # Per prompt instructions, specific `isinstance` checks and `raise exceptions for edge cases` are omitted.\n    il.validate()\n\n    graph = DivisibilityGraph()\n    graph.build(il.numbers)\n    \n    calc = LargestSubsetCalculator()\n    subset = calc.computeLongestPairwiseDivisibleSubset(graph)\n    \n    result = Result(subset.size())\n    return result.size"}
{"task_id": "Mbpp/622", "solution": "from typing import List\nclass SortedList:\n    \"\"\"\n    Typed wrapper around input list with is_sorted() check.\n    \"\"\"\n    def __init__(self, elements: List[float]):\n        self.elements = elements\n\n    @property\n    def length(self) -> int:\n        return len(self.elements)\n\n    def is_sorted(self) -> bool:\n        \"\"\"\n        Checks if the list elements are in non-decreasing order.\n        \"\"\"\n        if not self.elements:\n            return True\n        for i in range(len(self.elements) - 1):\n            if self.elements[i] > self.elements[i+1]:\n                return False\n        return True\nclass ValidationResult:\n    \"\"\"\n    Outcome of input validation.\n    \"\"\"\n    def __init__(self, is_valid: bool, errors: List[str]):\n        self.is_valid = is_valid\n        self.errors = errors\nclass MedianResult:\n    \"\"\"\n    Represent computed median float value.\n    \"\"\"\n    def __init__(self, value: float):\n        self.value = value\nclass MedianCalculator:\n    \"\"\"\n    Validates inputs and computes the median of two sorted lists.\n    \"\"\"\n    def get_median(self, arr1: List[float], arr2: List[float], n: int) -> float:\n        \"\"\"\n        Computes the median of two sorted lists of equal size n.\n        \"\"\"\n        validation_result = self.validate_inputs(arr1, arr2, n)\n        # Per constraints (\"DO NOT add isinstance() checks or raise exceptions for edge cases\"),\n        # we assume valid inputs for the main computation path as per the example test.\n        # The validation_result is computed but its failure branch leading to an error\n        # or different return type is not implemented here to adhere to output constraints.\n\n        # The median of 2n elements is the average of the n-th and (n+1)-th elements\n        # (1-indexed for kth element) in the combined sorted list.\n        kth_n = self.find_kth(arr1, arr2, n)\n        kth_n_plus_1 = self.find_kth(arr1, arr2, n + 1)\n\n        median_value = (kth_n + kth_n_plus_1) / 2.0\n        return MedianResult(value=median_value).value\n\n    def validate_inputs(self, arr1: List[float], arr2: List[float], n: int) -> ValidationResult:\n        \"\"\"\n        Validates properties of input lists and size n.\n        \"\"\"\n        errors = []\n\n        if n <= 0:\n            errors.append(\"n must be a positive integer.\")\n            # Early exit if n is invalid as subsequent length checks would be problematic\n            return ValidationResult(is_valid=False, errors=errors)\n\n        sl1 = SortedList(arr1)\n        sl2 = SortedList(arr2)\n\n        if sl1.length != n:\n            errors.append(f\"Length of first list ({sl1.length}) does not match n ({n}).\")\n        if sl2.length != n:\n            errors.append(f\"Length of second list ({sl2.length}) does not match n ({n}).\")\n\n        if not sl1.is_sorted():\n            errors.append(\"First list is not sorted in non-decreasing order.\")\n        if not sl2.is_sorted():\n            errors.append(\"Second list is not sorted in non-decreasing order.\")\n\n        # Per \"DO NOT add isinstance() checks or raise exceptions for edge cases\",\n        # explicit checks for numeric elements within the lists are omitted.\n\n        if errors:\n            return ValidationResult(is_valid=False, errors=errors)\n        return ValidationResult(is_valid=True, errors=[])\n\n    def find_kth(self, arr1: List[float], arr2: List[float], k: int) -> float:\n        \"\"\"\n        Finds the k-th smallest element in the merged sorted list of arr1 and arr2.\n        k is 1-indexed.\n        \"\"\"\n        i = 0  # Pointer for arr1\n        j = 0  # Pointer for arr2\n        count = 0\n        kth_element = 0.0 # Initialize as a float\n\n        # Iterate until k-th element is found or one list is exhausted\n        while i < len(arr1) and j < len(arr2):\n            count += 1\n            if arr1[i] < arr2[j]:\n                kth_element = arr1[i]\n                i += 1\n            else:\n                kth_element = arr2[j]\n                j += 1\n\n            if count == k:\n                return float(kth_element)\n\n        # If elements remain in arr1 after arr2 is exhausted\n        while i < len(arr1):\n            count += 1\n            kth_element = arr1[i]\n            i += 1\n            if count == k:\n                return float(kth_element)\n\n        # If elements remain in arr2 after arr1 is exhausted\n        while j < len(arr2):\n            count += 1\n            kth_element = arr2[j]\n            j += 1\n            if count == k:\n                return float(kth_element)\n\n        # This point should not be reached if k is within the valid range (1 to 2*n).\n        # We return the last element found, assuming k is always valid as per context.\n        return float(kth_element)\ndef get_median(arr1, arr2, n):\n    \"\"\"\n    Finds the median of two sorted lists of the same size.\n    \"\"\"\n    calculator = MedianCalculator()\n    return calculator.get_median(arr1, arr2, n)"}
{"task_id": "Mbpp/623", "solution": "class Number:\n    \"\"\"Represents a single numeric element and provides power computation.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n    def power(self, n: int) -> float:\n        \"\"\"Computes the n-th power of the number's value.\"\"\"\n        return self.value ** n\nclass NumberList:\n    \"\"\"Wraps an input list of floats into Number objects for read-only access.\"\"\"\n    def __init__(self, elements: list[float]):\n        self.elements = [Number(v) for v in elements]\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n    def get(self, index: int) -> Number:\n        \"\"\"Retrieves a Number object at the specified index.\"\"\"\n        return self.elements[index]\n    def as_list(self) -> list[float]:\n        \"\"\"Converts the wrapped Number objects back to a plain list of floats.\"\"\"\n        return [n.value for n in self.elements]\nclass ResultList:\n    \"\"\"Collects output Number objects and exposes results as a plain list.\"\"\"\n    def __init__(self):\n        self.elements = []\n    def append(self, number: Number) -> None:\n        \"\"\"Adds a Number object to the list.\"\"\"\n        self.elements.append(number)\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the result list.\"\"\"\n        return len(self.elements)\n    def as_list(self) -> list[float]:\n        \"\"\"Converts the collected Number objects back to a plain list of floats.\"\"\"\n        return [n.value for n in self.elements]\ndef nth_nums(input_list: list[float], n: int) -> list[float]:\n    \"\"\"\n    Computes the n-th power of each number in a list.\n    Raises ValidationError if n is not an integer.\n    \"\"\"\n    validate_n(n)\n    numbers = NumberList(input_list)\n    if numbers.length() == 0:\n        return []\n    results = ResultList()\n    for i in range(numbers.length()):\n        num = numbers.get(i)\n        powered = num.power(n)\n        results.append(Number(powered))\n    return results.as_list()"}
