{"task_id": "Mbpp/251", "solution": "from typing import Any, List\nclass Item:\n    \"\"\"Represent a single item value and its original index in an input list.\"\"\"\n    def __init__(self, value: Any, index: int) -> None:\n        self.value = value\n        self.index = index\n\n    def __repr__(self) -> str:\n        return f\"Item(value={self.value!r}, index={self.index})\"\nclass InputList:\n    \"\"\"Encapsulate a sequence of Item instances representing the caller-supplied input list.\"\"\"\n    def __init__(self, items: List[Any]) -> None:\n        \"\"\"Constructs Item objects with indices from primitive list values.\"\"\"\n        self.items: List[Item] = [Item(value, i) for i, value in enumerate(items)]\n\n    def __iter__(self):\n        return iter(self.items)\n\n    def __len__(self) -> int:\n        return len(self.items)\nclass Element:\n    \"\"\"Represent the element value to be inserted before each item.\"\"\"\n    def __init__(self, value: Any) -> None:\n        self.value = value\nclass OutputList:\n    \"\"\"Encapsulate resulting list of interleaved element and original item values.\"\"\"\n    def __init__(self) -> None:\n        self.items: List[Any] = []\n\n    def append(self, value: Any) -> None:\n        self.items.append(value)\n\n    def to_primitive_list(self) -> List[Any]:\n        return self.items\nclass InsertElementFunction:\n    \"\"\"Implement the insertion algorithm that builds an OutputList.\"\"\"\n    def insert(self, inputList: InputList, element: Element) -> OutputList:\n        \"\"\"For each Item in inputList, append element.value then item.value into OutputList and return it.\"\"\"\n        output_list = OutputList()\n        for item in inputList:\n            output_list.append(element.value)\n            output_list.append(item.value)\n        return output_list\ndef insert_element(input_list, element):\n    \"\"\"Public API that converts primitives to domain objects, delegates, and returns a primitive list.\"\"\"\n    domain_input_list = InputList(input_list)\n    domain_element = Element(element)\n    \n    insert_service = InsertElementFunction()\n    result_output_list = insert_service.insert(domain_input_list, domain_element)\n    \n    return result_output_list.to_primitive_list()"}
{"task_id": "Mbpp/245", "solution": "class Validation:\n    \"\"\"Helper for input validation.\"\"\"\n    @staticmethod\n    def validate_array_of_ints(arr):\n        \"\"\"Validates that the input is a list or tuple of integers.\"\"\"\n        if not isinstance(arr, (list, tuple)):\n            raise ValueError(\"Input must be a list or tuple.\")\n        for item in arr:\n            if not isinstance(item, int):\n                raise ValueError(\"All elements in the array must be integers.\")\nclass MaxSumCalculator:\n    \"\"\"Calculates the maximum sum of a bitonic subsequence.\"\"\"\n\n    def computeLISsum(self, arr):\n        \"\"\"Computes the maximum sum of an increasing subsequence ending at each index.\"\"\"\n        n = len(arr)\n        if n == 0:\n            return []\n        lis_sum = list(arr)\n\n        for i in range(1, n):\n            for j in range(i):\n                if arr[i] > arr[j]:\n                    lis_sum[i] = max(lis_sum[i], lis_sum[j] + arr[i])\n        return lis_sum\n\n    def computeLDSsum(self, arr):\n        \"\"\"Computes the maximum sum of a decreasing subsequence starting at each index.\"\"\"\n        n = len(arr)\n        if n == 0:\n            return []\n        lds_sum = list(arr)\n\n        for i in range(n - 2, -1, -1):\n            for j in range(n - 1, i, -1):\n                if arr[i] > arr[j]:\n                    lds_sum[i] = max(lds_sum[i], lds_sum[j] + arr[i])\n        return lds_sum\n\n    def max_sum(self, arr):\n        \"\"\"\n        Calculates the maximum sum of a bitonic subsequence in the given array.\n        A bitonic subsequence is first increasing and then decreasing.\n        \"\"\"\n        n = len(arr)\n        if n == 0:\n            return 0\n        if n == 1:\n            return arr[0]\n\n        lis_sums = self.computeLISsum(arr)\n        lds_sums = self.computeLDSsum(arr)\n\n        max_bitonic_sum = float('-inf')\n\n        for i in range(n):\n            # Combine LIS ending at i and LDS starting at i, subtracting arr[i] to avoid double-counting the peak\n            current_bitonic_sum = lis_sums[i] + lds_sums[i] - arr[i]\n            if current_bitonic_sum > max_bitonic_sum:\n                max_bitonic_sum = current_bitonic_sum\n\n        return max_bitonic_sum\ndef max_sum(arr):\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence for the given array.\n    A sequence is bitonic if it is first increasing and then decreasing.\n    \"\"\"\n    Validation.validate_array_of_ints(arr)\n    calculator = MaxSumCalculator()\n    return calculator.max_sum(arr)"}
{"task_id": "Mbpp/255", "solution": "def _product_iter(elements, n):\n    \"\"\"\n    Internal generator that yields n-length combinations with repetition.\n    Preserves the order of input elements.\n    \"\"\"\n    if n == 0:\n        yield ()\n        return\n\n    # Start with a list containing an empty prefix (list)\n    current_combinations_lists = [[]]\n\n    # For each position in the n-length combination\n    for _ in range(n):\n        next_combinations_lists = []\n        for prefix in current_combinations_lists:\n            for item in elements:\n                next_combinations_lists.append(prefix + [item])\n        current_combinations_lists = next_combinations_lists\n    \n    # Convert lists of items to tuples before yielding\n    for combination_list in current_combinations_lists:\n        yield tuple(combination_list)\ndef combinations_colors(elements,n):\n    \"\"\"\n    Generates all combinations (with repetition) of elements of a list,\n    returning a list of tuples for each combination.\n    \"\"\"\n    return list(_product_iter(elements, n))"}
{"task_id": "Mbpp/252", "solution": "from typing import Tuple, Any\nimport math\ndef sqrt(x: float) -> float:\n    \"\"\"Computes the square root of x.\"\"\"\n    return math.sqrt(x)\ndef atan2(y: float, x: float) -> float:\n    \"\"\"Computes the arctangent of y/x.\"\"\"\n    return math.atan2(y, x)\nclass ComplexNumber:\n    \"\"\"Represents a complex number with real and imaginary parts.\"\"\"\n    def __init__(self, real: float, imag: float) -> None:\n        self.real = real\n        self.imag = imag\nclass Converter:\n    \"\"\"Converts ComplexNumber to PolarCoordinates.\"\"\"\n    def convert(self, input_val: Any) -> Tuple[float, float]:\n        \"\"\"Performs the conversion from a numeric or complex input to polar coordinates.\"\"\"\n        if isinstance(input_val, (int, float)):\n            # Normalize real numbers to complex(real, 0.0)\n            complex_num = ComplexNumber(float(input_val), 0.0)\n        else: # The design implies input will be complex if not int/float.\n            complex_num = ComplexNumber(input_val.real, input_val.imag)\n\n        r_val = sqrt(complex_num.real**2 + complex_num.imag**2)\n        theta_val = atan2(complex_num.imag, complex_num.real)\n\n        return (float(r_val), float(theta_val))\ndef convert(input: Any) -> Tuple[float, float]:\n    \"\"\"Converts a complex number or real number to polar coordinates (r, theta).\"\"\"\n    return Converter().convert(input)"}
{"task_id": "Mbpp/247", "solution": "from dataclasses import dataclass\nclass LPSFunction:\n    \"\"\"\n    Encapsulates the dynamic programming algorithm for LPS computation.\n    Uses a DP table (_dp) to store intermediate results.\n    \"\"\"\n    _s: str\n    _dp: list[list[int]]\n\n    def lps(self, input_str: str) -> int:\n        \"\"\"\n        Computes and returns the length of the longest palindromic subsequence\n        for the given input string using dynamic programming.\n        \"\"\"\n        string_input = StringInput(value=input_str)\n        self._s = string_input.value\n        n = len(self._s)\n\n        if n == 0:\n            return 0\n        \n        # Initialize DP table: dp[i][j] stores the LPS length for substring s[i..j]\n        self._dp = [[0] * n for _ in range(n)]\n\n        # Base case: All substrings of length 1 have LPS length 1\n        for i in range(n):\n            self._dp[i][i] = 1\n\n        # Fill the DP table for lengths from 2 to n\n        for current_length in range(2, n + 1):\n            for i in range(n - current_length + 1):\n                j = i + current_length - 1\n                if self._s[i] == self._s[j]:\n                    # If characters match, add 2 to LPS of inner substring\n                    # Handle length 2 case explicitly (inner substring is empty, so add 0)\n                    self._dp[i][j] = 2 + (self._dp[i + 1][j - 1] if current_length > 2 else 0)\n                else:\n                    # If characters don't match, take max of removing left or right char\n                    self._dp[i][j] = max(self._dp[i + 1][j], self._dp[i][j - 1])\n\n        final_length = self._dp[0][n - 1]\n        \n        # As per design, LPSResult object is created for traceability, but its length field is returned.\n        _ = LPSResult(length=final_length) \n        return final_length\ndef lps(input: str) -> int:\n    \"\"\"\n    Computes the length of the longest palindromic subsequence in the given string.\n    \"\"\"\n    lps_calculator = LPSFunction()\n    return lps_calculator.lps(input)"}
{"task_id": "Mbpp/256", "solution": "def _is_prime(x: int) -> bool:\n    \"\"\"Returns True if x is a prime number, False otherwise.\n    This is an internal helper function for primality testing.\n    \"\"\"\n    if x < 2:\n        return False\n    if x == 2:\n        return True\n    if x % 2 == 0:\n        return False\n    i = 3\n    while i * i <= x:\n        if x % i == 0:\n            return False\n        i += 2\n    return True\ndef count_Primes_nums(n: int) -> int:\n    \"\"\"Returns the number of prime numbers strictly less than n.\n    Assumes n is a non-negative integer as per the problem description.\n    \"\"\"\n    if n < 2:\n        return 0\n\n    count = 0\n    for num in range(2, n):\n        if _is_prime(num):\n            count += 1\n    return count"}
{"task_id": "Mbpp/257", "solution": "def validate_numeric(a, b) -> bool:\n    \"\"\"Return True iff both a and b are instances of int or float.\"\"\"\n    return isinstance(a, (int, float)) and isinstance(b, (int, float))\ndef swap_numbers(a, b) -> tuple:\n    \"\"\"Return a tuple (b, a) if validate_numeric(a, b) is True; raise TypeError otherwise.\"\"\"\n    if not validate_numeric(a, b):\n        raise TypeError(\"swap_numbers expects two numeric inputs (int or float)\")\n    return (b, a)"}
{"task_id": "Mbpp/259", "solution": "from typing import Tuple, Union\nInputElementType = Tuple[Union[int, float], Union[int, float]]\nInputTupleType = Tuple[InputElementType, ...]\nclass Validator:\n    \"\"\"\n    Validates inputs for equal lengths and correct element shapes as per design.\n    \"\"\"\n    def validateLengths(self, a: InputTupleType, b: InputTupleType) -> None:\n        if len(a) != len(b):\n            raise ValueError(\"Input tuples must have equal length.\")\n\n    def validateElementShape(self, elem: Union[InputElementType, object]) -> None:\n        if not isinstance(elem, tuple) or len(elem) != 2:\n            raise TypeError(\"Each element in the input tuples must be a two-element tuple.\")\nclass MaximizeFunction:\n    \"\"\"\n    Orchestrates validation and computes element-wise maxima to produce a new result tuple.\n    \"\"\"\n    def __init__(self, a: InputTupleType, b: InputTupleType, validator: 'Validator' = None) -> None:\n        self.a = a\n        self.b = b\n        self.validator = validator if validator is not None else Validator()\n\n    def execute(self) -> InputTupleType:\n        self.validator.validateLengths(self.a, self.b)\n\n        result_elements_list = []\n        for i in range(len(self.a)):\n            elem_a = self.a[i]\n            elem_b = self.b[i]\n\n            self.validator.validateElementShape(elem_a)\n            self.validator.validateElementShape(elem_b)\n\n            first_max = max(elem_a[0], elem_b[0])\n            second_max = max(elem_a[1], elem_b[1])\n            result_elements_list.append((first_max, second_max))\n\n        return tuple(result_elements_list)\ndef maximize_elements(a: InputTupleType, b: InputTupleType) -> InputTupleType:\n    \"\"\"\n    Maximizes elements of two tuples of equal length whose elements are two-element tuples.\n    Returns a new tuple whose elements are the component-wise maxima of the inputs.\n    \"\"\"\n    validator = Validator()\n    runner = MaximizeFunction(a, b, validator=validator)\n    return runner.execute()"}
{"task_id": "Mbpp/264", "solution": "class DogAgeCalculator:\n    def dog_age(self, human_years: int) -> int:\n        \"\"\"Return 5 * human_years + 1\"\"\"\n        return 5 * human_years + 1\ndef dog_age(human_years: int) -> int:\n    \"\"\"Compute dog years given human_years using formula defined in SRS: 5 * human_years + 1.\"\"\"\n    calculator = DogAgeCalculator()\n    return calculator.dog_age(human_years)"}
