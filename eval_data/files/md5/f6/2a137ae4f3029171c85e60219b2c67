{"task_id": "Mbpp/472", "solution": "class IntegerList:\n    \"\"\"Encapsulates a list of elements, providing validation and introspection.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the list is empty.\"\"\"\n        return self.length() == 0\n\n    def containsOnlyIntegers(self) -> bool:\n        \"\"\"Verifies if all elements in the list are integers.\"\"\"\n        return all(isinstance(elem, int) for elem in self.elements)\nclass ConsecutiveCheckResult:\n    \"\"\"Represents the result of a consecutiveness check, including a boolean and message.\"\"\"\n    def __init__(self, isConsecutive: bool, message: str = \"\") -> None:\n        self.isConsecutive = isConsecutive\n        self.message = message\nclass CheckConsecutive:\n    \"\"\"Service to determine if a list of integers represents a consecutive sequence.\"\"\"\n    name: str = \"check_Consecutive\"\n\n    def check(self, list_obj: IntegerList) -> ConsecutiveCheckResult:\n        \"\"\"Performs the consecutiveness check on an IntegerList object.\"\"\"\n        elems = list_obj.elements\n\n        if list_obj.isEmpty():\n            return ConsecutiveCheckResult(False, \"Not consecutive: empty list\")\n\n        unique_count = len(set(elems))\n        min_v = min(elems)\n        max_v = max(elems)\n\n        # Consecutiveness requires all elements to be unique and the range to match the count.\n        consecutiveness = (unique_count == len(elems)) and (max_v - min_v + 1 == len(elems))\n\n        if consecutiveness:\n            return ConsecutiveCheckResult(True, \"Consecutive\")\n        else:\n            return ConsecutiveCheckResult(False, \"Not consecutive\")\ndef check_Consecutive(list_of_integers: list) -> bool:\n    \"\"\"Checks whether the given list contains consecutive numbers.\"\"\"\n    il = IntegerList(list_of_integers)\n\n    if not isinstance(list_of_integers, list) or not il.containsOnlyIntegers():\n        raise TypeError(\"Input must be a list of integers\")\n\n    svc = CheckConsecutive()\n    result = svc.check(il)\n    return result.isConsecutive"}
