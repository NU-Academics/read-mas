{"task_id": "Mbpp/564", "solution": "from dataclasses import dataclass\nfrom typing import List, Iterator\nclass PairCounter:\n    \"\"\"Encapsulates validation and counting logic for unequal pairs.\"\"\"\n\n    def validate_inputs(self, values: List[int], n: int) -> None:\n        \"\"\"Validates input parameters n against values list.\"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"n must be an integer\")\n        if n < 0 or n > len(values):\n            raise ValueError(\"n must satisfy 0 <= n <= len(values)\")\n\n    def generate_pairs(self, values: List[int], n: int) -> Iterator[Pair]:\n        \"\"\"Yields Pair objects for all unordered index pairs within the specified range.\"\"\"\n        for i in range(n - 1):\n            for j in range(i + 1, n):\n                yield Pair(i=i, j=j, val_i=values[i], val_j=values[j])\n\n    def count_pairs(self, values: List[int], n: int) -> int:\n        \"\"\"Counts unordered pairs where elements are unequal, after validating inputs.\"\"\"\n        self.validate_inputs(values, n)\n        count = 0\n        for pair in self.generate_pairs(values, n):\n            if pair.unequal():\n                count += 1\n        return int(count)\ndef count_Pairs(values: list[int], n: int) -> int:\n    \"\"\"Counts the number of possible unordered pairs where both elements are unequal.\"\"\"\n    pc = PairCounter()\n    return pc.count_pairs(values, n)"}
