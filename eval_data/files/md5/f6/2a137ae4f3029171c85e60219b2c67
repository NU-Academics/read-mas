{"task_id": "Mbpp/555", "solution": "class Result:\n    \"\"\"Holds the computed numeric result value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass NaturalNumberSequence:\n    \"\"\"Holder for input n and validator behavior.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def validate(self) -> None:\n        \"\"\"Raises ValueError if n is not an int or n < 1.\"\"\"\n        if not isinstance(self.n, int) or self.n < 1:\n            raise ValueError(\"Input 'n' must be a positive integer.\")\nclass Summation:\n    \"\"\"Encapsulates computation of sum_linear and sum_cubes.\"\"\"\n    def computeSums(self, n: int) -> Result:\n        \"\"\"Computes sums using closed-form formulas and returns the difference as a Result.\"\"\"\n        sum_linear = n * (n + 1) // 2\n        sum_cubes = sum_linear ** 2\n        return Result(value = sum_cubes - sum_linear)\ndef difference(n: int) -> int:\n    \"\"\"\n    Finds the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    seq = NaturalNumberSequence(n)\n    seq.validate()\n    \n    sum_calculator = Summation()\n    result_obj = sum_calculator.computeSums(n)\n    \n    return result_obj.value"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n):\n    \"\"\"\n    Counts the number of unordered pairs (i, j) with 0 <= i < j < n_used\n    such that arr[i] XOR arr[j] is odd.\n    \"\"\"\n    n_used = min(n, len(arr))\n\n    if n_used < 2:\n        return 0\n\n    count_odd = 0\n    for i in range(n_used):\n        if arr[i] % 2 != 0:\n            count_odd += 1\n\n    count_even = n_used - count_odd\n    return count_odd * count_even"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_str: str) -> str:\n    \"\"\"\n    Toggles the case of all alphabetic characters in a string, leaving non-alphabetic characters unchanged.\n    Iterates through the input string, applying case toggling or copying as appropriate.\n    \"\"\"\n    \n    # Helper function to check if a character is alphabetic.\n    # Uses built-in str.isalpha() behavior.\n    def is_alphabetic(ch: str) -> bool:\n        return ch.isalpha()\n\n    # Helper function to toggle the case of a single character.\n    # If alphabetic, it inverts its case; otherwise, it returns the character unchanged.\n    def toggle_character(ch: str) -> str:\n        if is_alphabetic(ch):\n            if ch.isupper():\n                return ch.lower()\n            else:\n                return ch.upper()\n        else:\n            return ch\n\n    toggled_chars = []\n    for char in input_str:\n        toggled_chars.append(toggle_character(char))\n    \n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a, b) -> int:\n    \"\"\"Calculates the sum of per-digit absolute differences between two integers.\n    Digits are right-aligned, padding with zeros for shorter numbers.\n    \"\"\"\n    def _get_digits_lsb_first(n: int) -> list[int]:\n        \"\"\"Extracts digits from an integer in least-significant-first order.\"\"\"\n        if n == 0:\n            return [0]\n        return [int(d) for d in str(abs(n))[::-1]]\n\n    digits_a = _get_digits_lsb_first(a)\n    digits_b = _get_digits_lsb_first(b)\n\n    max_len = max(len(digits_a), len(digits_b))\n\n    while len(digits_a) < max_len:\n        digits_a.append(0)\n    while len(digits_b) < max_len:\n        digits_b.append(0)\n\n    total_distance = 0\n    for da, db in zip(digits_a, digits_b):\n        total_distance += abs(da - db)\n\n    return total_distance"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(items: list[int], length: int) -> int:\n    \"\"\"Computes the maximum contiguous subarray sum using Kadane's algorithm.\n    It considers elements up to 'length', treating 'length' as a precondition matching `len(items)`.\n    \"\"\"\n    sub_array = items[:length]\n\n    if not sub_array:\n        return 0\n\n    max_so_far = sub_array[0]\n    current_max = sub_array[0]\n\n    for i in range(1, len(sub_array)):\n        current_max = max(sub_array[i], current_max + sub_array[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/560", "solution": "class TupleInput:\n    \"\"\"Holds an input tuple of integers.\"\"\"\n    def __init__(self, elements: tuple[int, ...]) -> None:\n        self.elements = elements\n\n    def is_valid(self) -> bool:\n        \"\"\"Confirms the instance's elements are a tuple of ints.\"\"\"\n        return isinstance(self.elements, tuple) and all(isinstance(e, int) for e in self.elements)\nclass ResultTuple:\n    \"\"\"Holds ordered, unique result elements and converts to tuple.\"\"\"\n    def __init__(self, elements: list[int]) -> None:\n        self._elements = elements\n\n    def to_tuple(self) -> tuple[int, ...] :\n        \"\"\"Returns the ordered unique elements as a tuple.\"\"\"\n        return tuple(self._elements)\nclass UnionFunction:\n    \"\"\"Performs the union, deduplication, sorting and produces a ResultTuple.\"\"\"\n    name: str = \"union_elements\"\n\n    def compute(self, input1: TupleInput, input2: TupleInput) -> ResultTuple:\n        \"\"\"Collects, deduplicates, and sorts elements from two TupleInput instances.\"\"\"\n        combined_elements = set(input1.elements)\n        combined_elements.update(input2.elements)\n        sorted_elements = sorted(list(combined_elements))\n        return ResultTuple(sorted_elements)\nclass InputValidator:\n    \"\"\"Validates raw inputs and returns TupleInput or raises a clear error.\"\"\"\n    @staticmethod\n    def validate_tuple_input(value, role: str = \"input\") -> TupleInput:\n        \"\"\"Validates that value is a tuple of integers, raising an error on failure.\"\"\"\n        if not isinstance(value, tuple):\n            raise TypeError(f\"{role} must be a tuple, but received {type(value).__name__}.\")\n        for i, element in enumerate(value):\n            if not isinstance(element, int):\n                raise ValueError(f\"{role} contains non-integer element at index {i}: {element} (type {type(element).__name__}).\")\n        return TupleInput(value)\ndef union_elements(input1: tuple[int, ...], input2: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"\n    Finds the union of the elements of two given tuples and outputs them in sorted order.\n    Input validation ensures both inputs are tuples containing only integers.\n    \"\"\"\n    validated_input1 = InputValidator.validate_tuple_input(input1, \"input1\")\n    validated_input2 = InputValidator.validate_tuple_input(input2, \"input2\")\n\n    union_computer = UnionFunction()\n    result_container = union_computer.compute(validated_input1, validated_input2)\n\n    return result_container.to_tuple()"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(sublists):\n    \"\"\"Return the maximum length among list elements present in sublists.\n    If sublists is empty or contains no list instances, returns 0; non-list top-level elements are ignored.\n    \"\"\"\n    max_length = 0\n    for element in sublists:\n        if isinstance(element, list):\n            max_length = max(max_length, len(element))\n    return max_length"}
