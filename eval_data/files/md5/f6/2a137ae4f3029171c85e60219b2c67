{"task_id": "Mbpp/235", "solution": "class IntegerInput:\n    \"\"\"Encapsulates an integer input and provides utility to determine MSB position.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def get_value(self) -> int:\n        return self.value\n\n    def most_significant_bit_position(self) -> int:\n        \"\"\"\n        Returns the 1-based position of the most significant bit.\n        For value == 0, MSB is considered 0.\n        \"\"\"\n        return self.value.bit_length()\nclass BitMaskGenerator:\n    \"\"\"Generates a mask with all even-position bits (2,4,6,...) set to 1.\"\"\"\n    def generate_mask(self, msb: int) -> int:\n        \"\"\"\n        Generates a mask where even-position bits up to the given MSB are set to 1.\n        msb is 1-based; if msb < 2, returns 0.\n        \"\"\"\n        mask = 0\n        # Iterate through even bit positions (1-based: 2, 4, 6, ...)\n        for bit_pos in range(2, msb + 1, 2):\n            # Set the corresponding bit (0-based: 1, 3, 5, ...)\n            mask |= (1 << (bit_pos - 1))\n        return mask\nclass BitManipulator:\n    \"\"\"Applies a given mask to an input value.\"\"\"\n    def apply_mask(self, value: int, mask: int) -> int:\n        \"\"\"Applies the mask to the value using a bitwise OR operation.\"\"\"\n        return value | mask\ndef even_bit_set_number(value: int) -> int:\n    \"\"\"\n    Sets all even-position bits (2,4,6,...) of a given number up to its most significant bit.\n    Odd-position bits are preserved.\n    \"\"\"\n    input_obj = IntegerInput(value)\n    msb = input_obj.most_significant_bit_position()\n\n    # Per BR10: if value is 0, MSB is undefined and the function returns 0.\n    if msb == 0:\n        return 0\n\n    mask = BitMaskGenerator().generate_mask(msb)\n    result_value = BitManipulator().apply_mask(value, mask)\n\n    return result_value"}
{"task_id": "Mbpp/239", "solution": "from typing import List\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Finds the number of possible sequences of length n, such that each element is a positive integer\n    and is greater than or equal to twice the previous element but less than or equal to m.\n    \"\"\"\n\n    class Element:\n        def __init__(self, value: int):\n            self.value = value\n\n    class Sequence:\n        def __init__(self, elements: List[int]):\n            self.elements = elements\n            self.length = len(elements)\n\n        def isValid(self, m: int) -> bool:\n            # This method verifies the sequence against the constraints: 1 <= e_i <= m and e_i >= 2 * e_{i-1}.\n            # The SequenceGenerator already builds sequences satisfying these, so this method would return True for them.\n            if not self.elements:\n                return True\n            \n            if not (1 <= self.elements[0] <= m):\n                return False\n\n            for i in range(1, self.length):\n                prev_e = self.elements[i-1]\n                curr_e = self.elements[i]\n\n                if not (1 <= curr_e <= m):\n                    return False\n                \n                if not (curr_e >= 2 * prev_e):\n                    return False\n            return True\n\n    class Validator:\n        def validate(self, m: int, n: int) -> None:\n            # Enforces m and n are positive integers, raising ValueError on failure.\n            if m <= 0 or n <= 0:\n                raise ValueError(\"m and n must be positive integers.\")\n\n    class InputParameters:\n        def __init__(self, m: int, n: int):\n            self.m = m\n            self.n = n\n\n        def validate(self) -> None:\n            # Delegates validation to the Validator class.\n            Validator().validate(self.m, self.n)\n\n    class SequenceGenerator:\n        def generate(self, m: int, n: int) -> List['Sequence']:\n            # Generates all valid sequences of length n given m, using a backtracking approach.\n            all_sequences: List[Sequence] = []\n\n            def _generate_recursive(current_sequence: List[int]):\n                if len(current_sequence) == n:\n                    all_sequences.append(Sequence(current_sequence[:]))\n                    return\n\n                start_next_val: int\n                if not current_sequence:\n                    start_next_val = 1\n                else:\n                    start_next_val = current_sequence[-1] * 2\n                \n                for next_val in range(start_next_val, m + 1):\n                    current_sequence.append(next_val)\n                    _generate_recursive(current_sequence)\n                    current_sequence.pop() # Backtrack\n\n            _generate_recursive([])\n            return all_sequences\n\n    class Counter:\n        def count(self, sequences: List['Sequence']) -> int:\n            # Returns the total number of sequences in the provided list.\n            return len(sequences)\n\n    class Result:\n        def __init__(self, count: int):\n            self.count = count\n\n        def toInt(self) -> int:\n            # Returns the encapsulated integer count.\n            return self.count\n\n    # --- Orchestration logic for get_total_number_of_sequences ---\n\n    # 1. Validate inputs using InputParameters and Validator.\n    params = InputParameters(m, n)\n    params.validate()\n\n    # 2. Handle the special case where n is 1.\n    if n == 1:\n        return m\n\n    # 3. Generate all possible valid sequences.\n    generator = SequenceGenerator()\n    sequences = generator.generate(m, n)\n\n    # 4. Count the generated sequences.\n    counter = Counter()\n    count = counter.count(sequences)\n\n    # 5. Return the final count.\n    result_obj = Result(count)\n    return result_obj.toInt()"}
{"task_id": "Mbpp/244", "solution": "import math\ndef next_Perfect_Square(n):\n    \"\"\"\n    Finds the smallest perfect square strictly greater than a given number n.\n    \"\"\"\n    m = math.isqrt(n)\n    if m * m > n:\n        k = m * m\n    else:\n        k = (m + 1) * (m + 1)\n    return k"}
