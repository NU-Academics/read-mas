{"task_id": "Mbpp/102", "solution": "class SnakeCaseString:\n    \"\"\"Represents a snake_case string input.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass CamelCaseString:\n    \"\"\"Represents an UpperCamelCase string output.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass SnakeToCamelConverter:\n    \"\"\"Converts a SnakeCaseString to a CamelCaseString.\"\"\"\n    def snake_to_camel(self, input: 'SnakeCaseString') -> 'CamelCaseString':\n        # Splits the snake_case string by underscores and capitalizes each word.\n        words = input.value.split('_')\n        camel_case_words = [word.capitalize() for word in words]\n        result_string = \"\".join(camel_case_words)\n        return CamelCaseString(result_string)\n\ndef snake_to_camel(input: str) -> str:\n    \"\"\"Converts a snake_case string to an UpperCamelCase string.\"\"\"\n    # Delegates the conversion to the SnakeToCamelConverter using domain objects.\n    input_obj = SnakeCaseString(input)\n    converter = SnakeToCamelConverter()\n    output_obj = converter.snake_to_camel(input_obj)\n    return output_obj.value"}
{"task_id": "Mbpp/103", "solution": "_memo = {} # Module-level memoization cache.\n\nclass Parameters:\n    \"\"\"Encapsulates the n and m parameters.\"\"\"\n    def __init__(self, n: int, m: int) -> None:\n        self.n = n\n        self.m = m\n    # The design specifies an optional validate() for type checks,\n    # but the problem constraints disallow `isinstance` checks.\n\nclass ValidationService:\n    \"\"\"Provides methods to validate input parameters.\"\"\"\n    def checkBounds(self, n: int, m: int) -> bool:\n        \"\"\"Checks if n >= 1 and 0 <= m < n.\"\"\"\n        return n >= 1 and 0 <= m < n\n\nclass EulerianResult:\n    \"\"\"A simple wrapper for the integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass EulerianFunction:\n    \"\"\"Computes the Eulerian number using recurrence with memoization.\"\"\"\n    name: str = 'eulerian_num'\n\n    def compute(self, n: int, m: int) -> int:\n        \"\"\"Computes a(n, m) using recursion and memoization.\"\"\"\n        if (n, m) in _memo:\n            return _memo[(n, m)]\n\n        # Base cases and out-of-bounds for 'm'\n        if m < 0 or m >= n:\n            return 0\n        if n == 1 and m == 0:\n            return 1\n\n        # Recurrence relation: a(n, m) = (n - m)*a(n-1, m-1) + (m+1)*a(n-1, m)\n        result = (n - m) * self.compute(n - 1, m - 1) + \\\n                 (m + 1) * self.compute(n - 1, m)\n\n        _memo[(n, m)] = result\n        return result\n\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Finds the Eulerian number a(n, m), representing the number of permutations\n    of n elements with exactly m ascents.\n    \"\"\"\n    # Validate input parameters using ValidationService.\n    validator = ValidationService()\n    if not validator.checkBounds(n, m):\n        raise ValueError(\"invalid input\")\n\n    # Compute the Eulerian number using EulerianFunction.\n    eulerian_func_calculator = EulerianFunction()\n    value = eulerian_func_calculator.compute(n, m)\n\n    return value\n\n__all__ = ['eulerian_num', 'EulerianFunction', 'ValidationService', 'Parameters', 'EulerianResult']"}
{"task_id": "Mbpp/105", "solution": "def count(input_list: list) -> int:\n    \"\"\"Counts boolean True values in a list, ignoring non-boolean truthy values.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError('count: expected a list as the single argument')\n\n    total = 0\n    for element in input_list:\n        if isinstance(element, bool) and element is True:\n            total += 1\n    return total"}
