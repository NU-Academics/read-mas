{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits: list) -> int:\n    \"\"\"\n    Finds the largest number that can be formed by concatenating the given list of digits.\n    Assumes input consists of single-digit integers.\n    \"\"\"\n    # Convert each digit to its string representation.\n    str_digits = [str(digit) for digit in digits]\n\n    # Sort the string representations in descending order.\n    # For single-digit numbers, this lexicographical sort correctly orders them\n    # to form the largest possible number when concatenated.\n    str_digits.sort(reverse=True)\n\n    # Join the sorted string digits to form a single string.\n    largest_num_str = \"\".join(str_digits)\n\n    # Convert the resulting string back to an integer and return it.\n    # Handles cases like [0,0,0] correctly returning 0.\n    return int(largest_num_str)"}
{"task_id": "Mbpp/63", "solution": "def max_difference(tuple_list):\n    \"\"\"\n    Finds the maximum absolute difference between elements of available pairs in a list of tuples.\n    Computes |a - b| for each (a, b) tuple and returns the largest result.\n    \"\"\"\n    differences = [abs(pair[0] - pair[1]) for pair in tuple_list]\n    return max(differences)"}
{"task_id": "Mbpp/61", "solution": "from typing import Iterator, Tuple\n\ndef _digit_sum(sub: str) -> int:\n    \"\"\"Compute integer sum of ASCII digit characters in a substring.\"\"\"\n    return sum(int(char) for char in sub)\n\ndef _enumerate_substrings(s: str) -> Iterator[Tuple[int, int, str]]:\n    \"\"\"Yield all contiguous substrings of s as (start_index, end_index, substring) tuples.\"\"\"\n    n = len(s)\n    for i in range(n):\n        for j in range(i + 1, n + 1):\n            yield (i, j, s[i:j])\n\ndef count_Substrings(s: str) -> int:\n    \"\"\"Count substrings where the sum of digits equals their length.\"\"\"\n    if not s:\n        return 0\n\n    count = 0\n    for start, end, substring in _enumerate_substrings(s):\n        substring_length = end - start\n        digits_sum = _digit_sum(substring)\n        if digits_sum == substring_length:\n            count += 1\n    return count"}
{"task_id": "Mbpp/64", "solution": "from typing import Any, Iterable, List, Tuple\n\ndef _validate_input(input_list: List[Tuple[Any, Any]]) -> None:\n    \"\"\"\n    Internal helper that enforces SRS business rules BR1/BR2/BR5/BR7.\n    Raises TypeError or ValueError on violations; returns None on success.\n    \"\"\"\n    second_elements = []\n    for i, item in enumerate(input_list):\n        if not isinstance(item, tuple):\n            raise TypeError(f\"Element at index {i} is not a tuple.\")\n        if len(item) < 2:\n            raise ValueError(f\"Tuple at index {i} has fewer than two elements.\")\n        second_elements.append(item[1])\n\n    # Verify mutual comparability of second elements by attempting to sort them.\n    try:\n        sorted(second_elements)\n    except TypeError as e:\n        raise ValueError(f\"Second elements in tuples are not mutually comparable: {e}\") from e\n\ndef subject_marks(input_list: Iterable[Tuple[str, Any]]) -> List[Tuple[str, Any]]:\n    \"\"\"\n    Validate input_list and return a new list of tuples sorted by second element.\n    Raises TypeError or ValueError on invalid input.\n    \"\"\"\n    if input_list is None:\n        raise TypeError(\"Input must be an iterable, not None.\")\n\n    # Materialize the input_list to ensure it can be iterated multiple times\n    # by _validate_input and sorted().\n    try:\n        materialized_list = list(input_list)\n    except TypeError as e:\n        raise TypeError(f\"Input is not an iterable: {e}\") from e\n\n    _validate_input(materialized_list)\n    return sorted(materialized_list, key=lambda x: x[1])"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list):\n    \"\"\"\n    Recursively flattens a list and sums all of its numeric elements.\n    Non-numeric and non-list elements are ignored.\n    \"\"\"\n    total_sum = 0\n\n    for element in input_list:\n        if isinstance(element, (int, float)):\n            total_sum += element\n        elif isinstance(element, (list, tuple)):\n            total_sum += recursive_list_sum(element)\n        # Else, ignore non-numeric, non-list elements as per design.\n    return total_sum"}
{"task_id": "Mbpp/66", "solution": "def pos_count(numbers) -> int:\n    \"\"\"Counts the number of positive numbers in a list.\n    Returns the count of elements strictly greater than zero.\"\"\"\n    count = 0\n    for num in numbers:\n        if num > 0:\n            count += 1\n    return count"}
{"task_id": "Mbpp/67", "solution": "from typing import Dict\n\nclass Error(Exception):\n    \"\"\"Custom exception for invalid inputs.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message: str = message\n\nclass InputParameter:\n    \"\"\"DTO for input n.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n: int = n\n\nclass BellNumber:\n    \"\"\"DTO wrapping computed Bell number value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value: int = value\n\nclass BellNumberCalculator:\n    \"\"\"Encapsulates validation and Bell-number computation logic.\"\"\"\n    def __init__(self) -> None:\n        self._memo: Dict[int, int] = {0: 1} # Initialize with B_0 = 1\n\n    def _combinations(self, n, k):\n        \"\"\"Calculates binomial coefficient C(n, k).\"\"\"\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        if k > n // 2:\n            k = n - k\n        \n        res = 1\n        for i in range(k):\n            res = res * (n - i) // (i + 1)\n        return res\n\n    def validateInput(self, n) -> None:\n        \"\"\"Validate that n is a non-negative integer, raising Error on failure.\"\"\"\n        if not isinstance(n, int):\n            raise Error(\"Input must be an integer.\")\n        if n < 0:\n            raise Error(\"Input must be a non-negative integer.\")\n\n    def bell_number(self, n: int) -> int:\n        \"\"\"Compute and return nth Bell number using recurrence and memoization.\"\"\"\n        if n in self._memo:\n            return self._memo[n]\n\n        # Bell numbers follow the recurrence B_n = sum_{k=0}^{n-1} C(n-1, k) * B_k\n        result = 0\n        for k in range(n):\n            result += self._combinations(n - 1, k) * self.bell_number(k)\n        \n        self._memo[n] = result\n        return result\n\ndef bell_number(n: int) -> int:\n    \"\"\"Public API. Validates n and returns the nth Bell number (int).\n    Raises Error on invalid input.\n    \"\"\"\n    calculator = BellNumberCalculator()\n    calculator.validateInput(n)\n    return calculator.bell_number(n)"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic (either non-increasing or non-decreasing).\n    Empty and single-element arrays are considered monotonic.\n    \"\"\"\n    n = len(array)\n\n    if n <= 1:\n        return True\n\n    is_non_decreasing = True\n    is_non_increasing = True\n\n    for i in range(n - 1):\n        if array[i] > array[i+1]:\n            is_non_decreasing = False\n        if array[i] < array[i+1]:\n            is_non_increasing = False\n\n    return is_non_decreasing or is_non_increasing"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list, sublist) -> bool:\n    \"\"\"Checks if a list contains the given sublist as a contiguous subsequence.\"\"\"\n    if len(sublist) == 0:\n        return True\n    \n    if len(sublist) > len(main_list):\n        return False\n        \n    for i in range(len(main_list) - len(sublist) + 1):\n        if main_list[i : i + len(sublist)] == sublist:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/70", "solution": "class Tuple:\n    \"\"\"Domain model for a single tuple.\"\"\"\n    def __init__(self, elements):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the tuple's elements.\"\"\"\n        return len(self.elements)\n\nclass TupleList:\n    \"\"\"Domain model for a list of tuples.\"\"\"\n    def __init__(self, tuples: list[tuple]):\n        self.tuples = [Tuple(t) for t in tuples]\n\n    def count(self) -> int:\n        \"\"\"Returns the number of tuples in the list.\"\"\"\n        return len(self.tuples)\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the tuple list is empty.\"\"\"\n        return self.count() == 0\n\nclass LengthChecker:\n    \"\"\"Component to check if all tuples in a list have equal length.\"\"\"\n    def all_equal_length(self, tuples: TupleList) -> bool:\n        \"\"\"Determines if all tuples in the given TupleList have the same length.\"\"\"\n        if tuples.is_empty():\n            return True\n\n        first_tuple_length = tuples.tuples[0].length()\n        for i in range(1, tuples.count()):\n            if tuples.tuples[i].length() != first_tuple_length:\n                return False\n        return True\n\nclass GetEqual:\n    \"\"\"Orchestration component to determine if a list of tuples has equal lengths.\"\"\"\n    def __init__(self, length_checker: LengthChecker = None):\n        self.length_checker = length_checker if length_checker is not None else LengthChecker()\n\n    def get_equal(self, tuples: TupleList) -> bool:\n        \"\"\"Delegates to LengthChecker to find if all tuple lengths are equal.\"\"\"\n        return self.length_checker.all_equal_length(tuples)\n\ndef get_equal(tuples: list[tuple]) -> bool:\n    \"\"\"\n    Checks if all given tuples have equal length.\n    \"\"\"\n    tuple_list = TupleList(tuples)\n    return GetEqual().get_equal(tuple_list)"}
{"task_id": "Mbpp/72", "solution": "def isRepresentableByParity(n: int) -> bool:\n    \"\"\"Return True iff n % 4 != 2 (parity theorem).\"\"\"\n    return (n % 4) != 2\n\ndef dif_Square(n: int) -> bool:\n    \"\"\"Validate input and return True iff n can be written as a^2 - b^2 (integers a,b).\n    Raises TypeError if n is not int.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"dif_Square: input must be int\")\n    return isRepresentableByParity(n)"}
{"task_id": "Mbpp/74", "solution": "from typing import List, Any\n\nclass Sequence:\n    \"\"\"Encapsulates a sequence list and provides helper methods.\"\"\"\n    def __init__(self, elements: List[Any]):\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def get(self, i: int) -> Any:\n        return self.elements[i]\n\nclass Pattern:\n    \"\"\"Encapsulates a pattern list and provides helper methods.\"\"\"\n    def __init__(self, tokens: List[Any]):\n        self.tokens = tokens\n\n    def length(self) -> int:\n        return len(self.tokens)\n\n    def get(self, i: int) -> Any:\n        return self.tokens[i]\n\nclass Mapping:\n    \"\"\"Handles the equivalence checking logic between sequence and pattern.\"\"\"\n    def validate_equivalence(self, seq: Sequence, pat: Pattern) -> bool:\n        n = seq.length()\n        for i in range(n):\n            for j in range(n):\n                # Checks if sequence[i] == sequence[j] exactly when pattern[i] == pattern[j].\n                if (seq.get(i) == seq.get(j)) != (pat.get(i) == pat.get(j)):\n                    return False\n        return True\n\ndef is_samepatterns(sequence: List, pattern: List) -> bool:\n    \"\"\"Checks if a sequence follows the given pattern based on the equivalence rule.\"\"\"\n    if len(sequence) != len(pattern):\n        return False\n\n    seq_obj = Sequence(sequence)\n    pat_obj = Pattern(pattern)\n    mapping = Mapping()\n    return mapping.validate_equivalence(seq_obj, pat_obj)"}
{"task_id": "Mbpp/71", "solution": "import math\n\nclass Error(Exception):\n    \"\"\"\n    Deterministic exception type for non-mutually-comparable inputs.\n    \"\"\"\n    pass\n\nDEFAULT_SHRINK_FACTOR = 1.3\n\nclass CombSortFunction:\n    \"\"\"\n    Encapsulates the comb sort algorithm and its internal parameters.\n    \"\"\"\n    def __init__(self, shrink_factor: float = DEFAULT_SHRINK_FACTOR) -> None:\n        self.__shrink_factor = shrink_factor\n        self.__list_ref = [] # Working reference for the list during sort\n\n    def _reduce_gap(self, current_gap: int) -> int:\n        \"\"\"\n        Computes the next gap size based on the shrink factor.\n        \"\"\"\n        new_gap = math.floor(current_gap / self.__shrink_factor)\n        return max(1, int(new_gap))\n\n    def comb_sort(self, input_list: list) -> list:\n        \"\"\"\n        Sorts a list using the comb sort algorithm.\n        Raises Error if elements are not mutually comparable.\n        \"\"\"\n        self.__list_ref = list(input_list) # Work on a shallow copy\n\n        n = len(self.__list_ref)\n\n        if n <= 1:\n            return self.__list_ref\n\n        gap = n\n        swapped = True\n\n        while gap != 1 or swapped:\n            gap = self._reduce_gap(gap)\n            swapped = False\n\n            for i in range(n - gap):\n                try:\n                    if self.__list_ref[i] > self.__list_ref[i + gap]:\n                        self.__list_ref[i], self.__list_ref[i + gap] = self.__list_ref[i + gap], self.__list_ref[i]\n                        swapped = True\n                except TypeError:\n                    raise Error(\"Non-comparable elements detected\")\n\n        return self.__list_ref\n\ndef comb_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a list of elements in ascending order using the comb sort algorithm.\n    \"\"\"\n    sorter = CombSortFunction()\n    return sorter.comb_sort(input_list)"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(tuples_list, k):\n    \"\"\"\n    Finds tuples where all elements are divisible by k from the given list of tuples.\n    Raises TypeError or ValueError for invalid inputs as per design.\n    \"\"\"\n\n    def _validate_inputs(tuples_list, k):\n        \"\"\"Validates input types and values for tuples_list and k.\"\"\"\n        if not isinstance(tuples_list, (list, tuple)):\n            raise TypeError(\"tuples_list must be an iterable (list or tuple).\")\n        for item in tuples_list:\n            if not isinstance(item, tuple):\n                raise TypeError(\"All items in tuples_list must be tuples.\")\n            for element in item:\n                if not isinstance(element, int):\n                    raise TypeError(\"All elements within tuples must be integers.\")\n        if not isinstance(k, int):\n            raise TypeError(\"k must be an integer.\")\n        if k == 0:\n            raise ValueError(\"k cannot be zero.\")\n\n    def matches(t, k):\n        \"\"\"Checks if all elements in tuple t are divisible by k.\"\"\"\n        if not t:  # Vacuously true for empty tuples\n            return True\n        for element in t:\n            if element % k != 0:\n                return False\n        return True\n\n    _validate_inputs(tuples_list, k)\n\n    result_list = []\n    for t in tuples_list:\n        if matches(t, k):\n            result_list.append(t)\n    return result_list"}
