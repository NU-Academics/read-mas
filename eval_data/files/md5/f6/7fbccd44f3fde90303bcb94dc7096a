{"task_id": "Mbpp/641", "solution": "def is_nonagonal(n: int) -> int:\n    \"\"\"\n    Calculates the nth nonagonal number using the formula (7 * n * n - 5 * n) / 2.\n    \"\"\"\n    return (7 * n * n - 5 * n) // 2"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(array, k):\n    \"\"\"\n    Reverses the first k elements of an array, leaving the rest unchanged.\n    Returns a new list without modifying the input array.\n    \"\"\"\n    n = len(array)\n    # Normalize k to be within the valid range [0, n].\n    # If k is less than 0, it's treated as 0. If k is greater than n, it's treated as n.\n    normalized_k = max(0, min(k, n))\n\n    # If normalized_k is 0, return a shallow copy of the original array.\n    # This handles empty arrays, k <= 0, and cases where k is positive but normalized to 0 (e.g., k=1 for empty array).\n    if normalized_k == 0:\n        return array[:]\n\n    # Reverse the first normalized_k elements using slicing and concatenate with the remaining suffix.\n    reversed_prefix = array[:normalized_k][::-1]\n    suffix = array[normalized_k:]\n    return reversed_prefix + suffix"}
{"task_id": "Mbpp/643", "solution": "import re\nimport string\nfrom typing import List\n\nclass Word:\n    \"\"\"Represents a token with its value and position in the original text.\"\"\"\n    def __init__(self, value: str, startIndex: int, endIndex: int):\n        self.value = value\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the word's value.\"\"\"\n        return len(self.value)\n\n    def hasMiddleZ(self) -> bool:\n        \"\"\"Checks if the word contains 'z' at any position other than the first or last.\"\"\"\n        if self.length() < 3:\n            return False\n        for i in range(1, self.length() - 1):\n            if self.value[i] == 'z':\n                return True\n        return False\n\nclass MatchResult:\n    \"\"\"Encapsulates the result of a matching operation, including whether a match was found and which words matched.\"\"\"\n    def __init__(self, hasMatch: bool, matchingWords: List[Word]):\n        self.hasMatch = hasMatch\n        self.matchingWords = matchingWords\n\ndef tokenize(text: str) -> List[Word]:\n    \"\"\"Splits text into Word tokens, treating whitespace and punctuation as separators.\"\"\"\n    words = []\n    # Combine whitespace and punctuation for separator definition\n    separators = string.whitespace + string.punctuation\n    # Regex to match sequences of characters that are NOT separators\n    # This naturally extracts words without leading/trailing separators.\n    pattern = r'[^' + re.escape(separators) + r']+'\n    \n    for match in re.finditer(pattern, text):\n        value = match.group(0)\n        start_index = match.start()\n        end_index = match.end()\n        words.append(Word(value, start_index, end_index))\n    return words\n\ndef _check_words_for_middle_z(words: List[Word]) -> MatchResult:\n    \"\"\"Inspects a list of Word objects for the 'z' middle condition.\"\"\"\n    matched_words = []\n    for word in words:\n        if word.hasMiddleZ():\n            matched_words.append(word)\n    \n    return MatchResult(len(matched_words) > 0, matched_words)\n\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"Checks if a string contains 'z', except at the start and end of any word.\"\"\"\n    word_tokens = tokenize(text)\n    \n    result = _check_words_for_middle_z(word_tokens)\n    \n    return result.hasMatch"}
{"task_id": "Mbpp/721", "solution": "from typing import List, Any, Optional\nimport math\n\nclass Cell:\n    \"\"\"Lightweight holder for (row, col, value).\"\"\"\n    def __init__(self, row: int, col: int, value: float) -> None:\n        self.row = row\n        self.col = col\n        self.value = float(value)\n\nclass Matrix:\n    \"\"\"Represents N x N matrix and provides basic accessors.\"\"\"\n    def __init__(self, cells: List[List[Any]]) -> None:\n        self.N = len(cells)\n        # Assuming input is already validated by Validator and is square, non-empty, numeric.\n        self.cells: List[List[float]] = [[float(val) for val in row_list] for row_list in cells]\n\n    def getCell(self, row: int, col: int) -> float:\n        return self.cells[row][col]\n\n    def isSquare(self) -> bool:\n        return True\n\nclass Path:\n    \"\"\"Represents ordered visited cells and computes aggregates.\"\"\"\n    def __init__(self, visitedCells: Optional[List[Cell]] = None) -> None:\n        self.visitedCells: List[Cell] = visitedCells if visitedCells is not None else []\n\n    def sum(self) -> float:\n        return sum(cell.value for cell in self.visitedCells)\n\n    def length(self) -> int:\n        return len(self.visitedCells)\n\nclass Validator:\n    \"\"\"Validates input matrix structure and numeric content.\"\"\"\n    def validateMatrix(self, matrix: Any) -> None:\n        if not isinstance(matrix, list) or not matrix:\n            raise ValueError(\"Input matrix must be a non-empty list of lists.\")\n\n        N = len(matrix)\n        for r_idx, row in enumerate(matrix):\n            if not isinstance(row, list):\n                raise ValueError(f\"Matrix row {r_idx} is not a list.\")\n            if len(row) != N:\n                raise ValueError(\"Matrix must be square (N x N).\")\n            for c_idx, val in enumerate(row):\n                if not isinstance(val, (int, float)):\n                    raise ValueError(f\"Matrix cell [{r_idx}][{c_idx}] contains non-numeric value: {val}\")\n\nclass PathCalculator:\n    \"\"\"Computes maximum-sum path using DP and computes average.\"\"\"\n    def computeMaxSumPath(self, matrix_obj: Matrix) -> Path:\n        N = matrix_obj.N\n        if N == 1:\n            return Path([Cell(0, 0, matrix_obj.getCell(0, 0))])\n\n        dp = [[-math.inf for _ in range(N)] for _ in range(N)]\n        \n        dp[0][0] = matrix_obj.getCell(0, 0)\n\n        for c in range(1, N):\n            dp[0][c] = dp[0][c-1] + matrix_obj.getCell(0, c)\n\n        for r in range(1, N):\n            dp[r][0] = dp[r-1][0] + matrix_obj.getCell(r, 0)\n\n        for r in range(1, N):\n            for c in range(1, N):\n                dp[r][c] = matrix_obj.getCell(r, c) + max(dp[r-1][c], dp[r][c-1])\n        \n        path_cells: List[Cell] = []\n        r, c = N - 1, N - 1\n        \n        while r >= 0 and c >= 0:\n            path_cells.append(Cell(r, c, matrix_obj.getCell(r, c)))\n\n            if r == 0 and c == 0:\n                break\n            elif r == 0:\n                c -= 1\n            elif c == 0:\n                r -= 1\n            else:\n                if dp[r-1][c] > dp[r][c-1]:\n                    r -= 1\n                else:\n                    c -= 1\n        \n        path_cells.reverse()\n        return Path(path_cells)\n\n    def computeAverage(self, sum_value: float, N: int) -> float:\n        \"\"\"Computes the average path cost.\"\"\"\n        num_cells = (2 * N - 1)\n        return sum_value / num_cells\n\n\ndef maxAverageOfPath(matrix: List[List[Any]]) -> float:\n    \"\"\"\n    Given a square matrix, finds a path from top-left to bottom-right \n    moving only right or down, with the maximum average cost.\n    \"\"\"\n    Validator().validateMatrix(matrix)\n    matrix_obj = Matrix(matrix)\n    path = PathCalculator().computeMaxSumPath(matrix_obj)\n    total = path.sum()\n    avg = PathCalculator().computeAverage(total, matrix_obj.N)\n    return float(avg)"}
{"task_id": "Mbpp/723", "solution": "def count_same_pair(list1, list2) -> int:\n    \"\"\"\n    Counts indices where two lists of the same length have equal values.\n    Raises ValueError if inputs are not lists or have different lengths.\n    \"\"\"\n    if not isinstance(list1, list) or not isinstance(list2, list):\n        raise ValueError(\"Both inputs must be lists.\")\n    if len(list1) != len(list2):\n        raise ValueError(\"Inputs must be lists of equal length.\")\n\n    count = 0\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/722", "solution": "def filter_data(students: dict, minHeight: float, minWeight: float) -> dict:\n    \"\"\"Return a new dict with only students where height > minHeight and weight >= minWeight. Do not mutate input dict.\"\"\"\n    filtered_students = {}\n    for name, (height, weight) in students.items():\n        if height > minHeight and weight >= minWeight:\n            filtered_students[name] = (height, weight)\n    return filtered_students"}
{"task_id": "Mbpp/724", "solution": "from typing import Sequence\n\nclass Digit:\n    \"\"\"Value object representing a single decimal digit (0..9).\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass DigitSum:\n    \"\"\"Aggregates and exposes the sum of digits.\"\"\"\n    def __init__(self, digits: Sequence[Digit]) -> None:\n        self.sum = sum(d.value for d in digits)\n\nclass BigIntegerResult:\n    \"\"\"Encapsulates canonical decimal string representation of an integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.decimalString = str(value)\n\n    def numDigits(self) -> int:\n        \"\"\"Returns count of digit characters in decimalString (ignoring sign).\"\"\"\n        return len(self.decimalString.lstrip('-'))\n\nclass PowerBaseSum:\n    \"\"\"Orchestrates validation, exponentiation, decimal conversion, digit extraction, and summation.\"\"\"\n    def __init__(self, base: int, power: int) -> None:\n        self.base = base\n        self.power = power\n\n    def execute(self) -> int:\n        \"\"\"Performs the pipeline to compute base**power and sum its digits.\"\"\"\n        power_value = self.base ** self.power\n        big_int_result = BigIntegerResult(power_value)\n\n        digits_as_objects = []\n        for char_digit in big_int_result.decimalString:\n            if char_digit.isdigit():\n                digits_as_objects.append(Digit(int(char_digit)))\n\n        digit_sum_obj = DigitSum(digits_as_objects)\n        return digit_sum_obj.sum\n\ndef power_base_sum(base, power) -> int:\n    \"\"\"Calculates the sum of all digits of the base to the specified power.\"\"\"\n    orchestrator = PowerBaseSum(base, power)\n    return orchestrator.execute()"}
{"task_id": "Mbpp/726", "solution": "def _is_numeric(value) -> bool:\n    \"\"\"Return True if value is an int or float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef _validate_input(input_tuple: tuple) -> None:\n    \"\"\"Raise TypeError or ValueError if input invalid per SRS.\"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n    if len(input_tuple) < 2:\n        raise ValueError(\"Input tuple must have at least two elements.\")\n    for element in input_tuple:\n        if not _is_numeric(element):\n            raise ValueError(\"All elements in the input tuple must be numeric (int or float).\")\n\ndef multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"Validate input per SRS and return a new tuple of adjacent products.\n\n    Args:\n        input_tuple: tuple of numeric elements (len >= 2)\n\n    Returns:\n        tuple: length len(input_tuple) - 1 where element i is input_tuple[i] * input_tuple[i+1]\n\n    Raises:\n        TypeError: if input_tuple is not a tuple\n        ValueError: if len(input_tuple) < 2 or if any element is not numeric\n    \"\"\"\n    _validate_input(input_tuple)\n    \n    result = []\n    for i in range(len(input_tuple) - 1):\n        result.append(input_tuple[i] * input_tuple[i+1])\n    return tuple(result)"}
{"task_id": "Mbpp/728", "solution": "class Validator:\n    \"\"\"\n    Validates input lists for length equality and numeric elements.\n    Raises ValueError on validation failure.\n    \"\"\"\n    def __init__(self, error_type: type = ValueError):\n        self._error_type = error_type\n\n    def validate_length(self, a, b) -> None:\n        \"\"\"\n        Checks if inputs are lists and have equal length.\n        \"\"\"\n        if not isinstance(a, list) or not isinstance(b, list):\n            raise self._error_type(\"Inputs must be lists.\")\n        if len(a) != len(b):\n            raise self._error_type(\"Input lists must have equal length.\")\n\n    def validate_numeric(self, a, b) -> None:\n        \"\"\"\n        Checks if all elements in both lists are numeric (int or float).\n        \"\"\"\n        for lst in [a, b]:\n            for element in lst:\n                if not isinstance(element, (int, float)):\n                    raise self._error_type(\"All elements in lists must be numeric (int or float).\")\n\nclass Adder:\n    \"\"\"\n    Performs element-wise addition of two lists.\n    \"\"\"\n    def compute(self, a, b) -> list:\n        \"\"\"\n        Returns a new list with element-wise sums.\n        Assumes inputs are valid (equal length, numeric).\n        \"\"\"\n        return [a[i] + b[i] for i in range(len(a))]\n\ndef sum_list(a, b) -> list:\n    \"\"\"\n    Public API per SRS: sum_list(list a, list b) -> list\n    Takes two lists and returns a new list of element-wise sums.\n    \"\"\"\n    validator = Validator()\n    validator.validate_length(a, b)\n    validator.validate_numeric(a, b)\n    adder = Adder()\n    return adder.compute(a, b)"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list):\n    \"\"\"\n    Removes consecutive duplicates from a list, preserving order and returning a new list.\n    The input list is not modified by this function.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = []\n    last_added_element = None\n\n    for current_element in input_list:\n        if not result:  # This is the first element to be added\n            result.append(current_element)\n            last_added_element = current_element\n        elif current_element != last_added_element:\n            result.append(current_element)\n            last_added_element = current_element\n    return result"}
{"task_id": "Mbpp/731", "solution": "import math\nfrom typing import Any\n\nclass Cone:\n    def __init__(self, radius: float, height: float) -> None:\n        self.radius = radius\n        self.height = height\n\nclass NumericValidator:\n    @staticmethod\n    def isNumeric(value: Any) -> bool:\n        \"\"\"Checks if a value is an instance of int or float.\"\"\"\n        return isinstance(value, (int, float))\n\nclass LateralSurfaceCalculator:\n    def calculateLateralSurface(self, cone: Cone) -> float:\n        \"\"\"Calculates the lateral surface area of a cone.\"\"\"\n        slant_height = math.sqrt(cone.radius ** 2 + cone.height ** 2)\n        lateral_surface = math.pi * cone.radius * slant_height\n        return lateral_surface\n\ndef lateralsurface_cone(r, h) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cone given radius r and height h.\n    Raises ValueError if r or h are not numeric.\n    \"\"\"\n    if not NumericValidator.isNumeric(r) or not NumericValidator.isNumeric(h):\n        raise ValueError(\"r and h must be numeric\")\n\n    cone = Cone(float(r), float(h))\n    return LateralSurfaceCalculator().calculateLateralSurface(cone)"}
{"task_id": "Mbpp/725", "solution": "class InputString:\n    \"\"\"Wrapper for input string value.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\nclass QuotePair:\n    \"\"\"Value object representing indices of a matched quote pair.\"\"\"\n    def __init__(self, start_index: int, end_index: int) -> None:\n        self.start_index = start_index\n        self.end_index = end_index\n\nclass QuotedSubstring:\n    \"\"\"Value object holding extracted substring text (without quotes) and discovery order.\"\"\"\n    def __init__(self, text: str, order: int) -> None:\n        self.text = text\n        self.order = order\n\nclass ResultList:\n    \"\"\"Aggregates extracted substrings in discovery order and exposes items as a list[str].\"\"\"\n    def __init__(self) -> None:\n        self.items: list[str] = []\n\n    def append(self, item: str) -> None:\n        self.items.append(item)\n\nclass QuoteScanner:\n    \"\"\"Scans input left-to-right to locate matching pairs of double-quote characters.\"\"\"\n    def scan(self, input_str: str) -> list[QuotePair]:\n        quote_pairs = []\n        i = 0\n        while i < len(input_str):\n            if input_str[i] == '\"':\n                start_index = i\n                j = i + 1\n                while j < len(input_str) and input_str[j] != '\"':\n                    j += 1\n                \n                if j < len(input_str) and input_str[j] == '\"':\n                    end_index = j\n                    quote_pairs.append(QuotePair(start_index, end_index))\n                    i = end_index + 1 # Continue scanning after the closing quote\n                else:\n                    # Unmatched opening quote, ignore and continue scanning from next character\n                    i += 1 \n            else:\n                i += 1\n        return quote_pairs\n\nclass ExtractQuotation:\n    \"\"\"Orchestrates scanning and extraction per SRS business rules.\"\"\"\n    def __init__(self) -> None:\n        self._scanner = QuoteScanner()\n\n    def extract(self, input_str: str) -> list[str]:\n        input_obj = InputString(input_str) # Create InputString instance\n        \n        quote_pairs = self._scanner.scan(input_obj.value)\n        result_list = ResultList()\n        \n        for pair in quote_pairs:\n            extracted_text = input_obj.value[pair.start_index + 1 : pair.end_index]\n            result_list.append(extracted_text)\n            \n        return result_list.items\n\ndef extract_quotation(input: str) -> list[str]:\n    \"\"\"\n    Extracts values between quotation marks \" \" of the given string.\n    Delegates to ExtractQuotation for orchestration.\n    \"\"\"\n    extractor = ExtractQuotation()\n    return extractor.extract(input)"}
{"task_id": "Mbpp/732", "solution": "REPLACEMENT_TARGETS = (' ', ',', '.')\nREPLACEMENT_CHAR = ':'\n\ndef replace_specialchar(input: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots with a colon.\n    \"\"\"\n    from_chars = ''.join(REPLACEMENT_TARGETS)\n    to_chars = REPLACEMENT_CHAR * len(REPLACEMENT_TARGETS)\n    translation_table = str.maketrans(from_chars, to_chars)\n    return input.translate(translation_table)"}
{"task_id": "Mbpp/733", "solution": "from typing import List\n\ndef find_first_occurrence(array: List[int], target: int) -> int:\n    \"\"\"\n    Find the zero-based index of the first occurrence of target in array.\n\n    Preconditions (per SRS):\n    - `array` is a list of integers sorted in non-decreasing order.\n    - `target` is an integer.\n    - The SRS-provided unit test assumes target is present in the array.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    first_occurrence_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            first_occurrence_index = mid\n            high = mid - 1  # Try to find an earlier occurrence in the left half\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n            \n    return first_occurrence_index"}
{"task_id": "Mbpp/734", "solution": "from typing import List, Union, Iterator\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputList:\n    \"\"\"Represents the validated input list.\"\"\"\n    elements: List[Union[int, float]]\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the input list is empty.\"\"\"\n        return not self.elements\n\n@dataclass\nclass Subarray:\n    \"\"\"Represents a contiguous subarray, identified by indices and the original list.\"\"\"\n    start_index: int\n    end_index: int # inclusive\n    elements: List[Union[int, float]]\n\n    def product(self) -> Union[int, float]:\n        \"\"\"Calculates the product of elements within this subarray.\"\"\"\n        return _product_of_slice(self.elements, self.start_index, self.end_index)\n\n@dataclass\nclass Product:\n    \"\"\"Represents the numerical product of a subarray.\"\"\"\n    value: Union[int, float]\n\n@dataclass\nclass Result:\n    \"\"\"Represents the final numerical sum of all subarray products.\"\"\"\n    value: Union[int, float]\n\ndef _validate_input(input_list: List) -> InputList:\n    \"\"\"\n    Validates that the input is a list and all its elements are numeric.\n    Raises TypeError if validation fails.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n    for element in input_list:\n        if not isinstance(element, (int, float)):\n            raise TypeError(\"All elements in the list must be numeric (int or float).\")\n    return InputList(elements=input_list)\n\ndef _product_of_slice(elements: List[Union[int, float]], start: int, end: int) -> Union[int, float]:\n    \"\"\"\n    Computes the product of elements in the specified slice [start:end+1].\n    \"\"\"\n    current_product = 1\n    for i in range(start, end + 1):\n        current_product *= elements[i]\n    return current_product\n\ndef _enumerate_subarrays(elements: List[Union[int, float]]) -> Iterator[Subarray]:\n    \"\"\"\n    Generates all contiguous subarrays from the given list of elements.\n    Yields Subarray objects for each found subarray.\n    \"\"\"\n    n = len(elements)\n    for i in range(n):\n        for j in range(i, n):\n            yield Subarray(i, j, elements)\n\ndef sum_Of_Subarray_Prod(input_list: List) -> Union[int, float]:\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists of a given list.\n    Handles input validation and returns 0 for an empty list.\n    \"\"\"\n    validated_input = _validate_input(input_list)\n\n    if validated_input.is_empty():\n        return 0\n\n    total_sum_of_products = 0\n    for subarray in _enumerate_subarrays(validated_input.elements):\n        total_sum_of_products += subarray.product()\n    \n    return Result(value=total_sum_of_products).value"}
{"task_id": "Mbpp/736", "solution": "from typing import List, Any\nfrom dataclasses import dataclass\n\nclass SequenceWrapper:\n    \"\"\"Minimal wrapper providing size and indexed access to a Python sequence.\"\"\"\n    def __init__(self, elements: List[Any]) -> None:\n        self.elements = elements\n\n    def len(self) -> int:\n        \"\"\"Returns the length of the wrapped sequence.\"\"\"\n        return len(self.elements)\n\n    def get(self, i: int) -> Any:\n        \"\"\"Returns the element at the specified index.\"\"\"\n        return self.elements[i]\n\nclass Value:\n    \"\"\"Simple data holder for the target value.\"\"\"\n    def __init__(self, value: Any) -> None:\n        self.value = value\n\n@dataclass\nclass InsertionResult:\n    \"\"\"Container for the computed insertion index.\"\"\"\n    index: int\n\nclass BinarySearchAlgorithm:\n    \"\"\"Provides an iterative binary search to compute the leftmost insertion index.\"\"\"\n    def search_left(self, sequence: SequenceWrapper, value: Value) -> int:\n        \"\"\"\n        Returns the smallest index i in [0, len(sequence)] such that sequence.get(i) >= value.value.\n        Returns len(sequence) if no such index exists (value is greater than all elements).\n        \"\"\"\n        low = 0\n        high = sequence.len()\n        result_index = sequence.len() # Default to len() if value is greater than all elements\n\n        while low < high:\n            mid = low + (high - low) // 2\n            if sequence.get(mid) >= value.value:\n                result_index = mid\n                high = mid # Try to find an even smaller index on the left\n            else:\n                low = mid + 1 # Value is greater, search in the right half\n\n        return result_index\n\ndef left_insertion(sequence, value) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted sequence.\n    This function uses an iterative binary search for O(log n) time and O(1) space.\n    \"\"\"\n    seq_wrapper = SequenceWrapper(sequence)\n    val_obj = Value(value)\n    binary_search = BinarySearchAlgorithm()\n    return binary_search.search_left(seq_wrapper, val_obj)"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(n: int) -> int:\n    \"\"\"\n    Toggles bits of the number except the first and the last bit.\n    Preserves the number if its binary representation has fewer than 3 bits.\n    \"\"\"\n\n    def _validate_input(val: int) -> None:\n        \"\"\"Validates that the input is a non-negative integer.\"\"\"\n        if not isinstance(val, int):\n            raise ValueError(\"Input must be an integer.\")\n        if val < 0:\n            raise ValueError(\"Input must be a non-negative integer.\")\n\n    def _int_to_bits(val: int) -> str:\n        \"\"\"Converts an integer to its minimal binary string representation.\"\"\"\n        if val == 0:\n            return \"0\"\n        return bin(val)[2:]\n\n    def _toggle_middle_bits_str(bits_str: str) -> str:\n        \"\"\"Toggles middle bits of a binary string, preserving first and last.\"\"\"\n        if len(bits_str) < 3:\n            return bits_str\n\n        first_bit = bits_str[0]\n        last_bit = bits_str[-1]\n        middle_bits = bits_str[1:-1]\n\n        toggled_middle = \"\".join('1' if bit == '0' else '0' for bit in middle_bits)\n        return first_bit + toggled_middle + last_bit\n\n    def _bits_to_int(bits_str: str) -> int:\n        \"\"\"Converts a binary string back to an integer.\"\"\"\n        return int(bits_str, 2)\n\n    _validate_input(n)\n    bits_representation = _int_to_bits(n)\n    toggled_bits = _toggle_middle_bits_str(bits_representation)\n    result = _bits_to_int(toggled_bits)\n    return result"}
{"task_id": "Mbpp/741", "solution": "class CharacterComparer:\n    \"\"\"Helper class encapsulating character comparison logic.\"\"\"\n    def all_equal(self, s: str) -> bool:\n        \"\"\"Return True if all characters in s are identical, else False.\"\"\"\n        if not s:\n            return True\n        first_char = s[0]\n        for char in s:\n            if char != first_char:\n                return False\n        return True\n\ndef all_Characters_Same(input_string: str) -> bool:\n    \"\"\"Return True iff every character in input_string is identical to every other character.\n    Returns True for empty string.\n    \"\"\"\n    comparer = CharacterComparer()\n    return comparer.all_equal(input_string)"}
{"task_id": "Mbpp/739", "solution": "class TriangularNumber:\n    \"\"\"Computes triangular number values T_k = k*(k+1)/2.\"\"\"\n    def compute(self, index: int) -> int:\n        return index * (index + 1) // 2\n\nclass DigitCounter:\n    \"\"\"Counts base-10 digits of arbitrary-size integers.\"\"\"\n    def count_digits(self, value: int) -> int:\n        return len(str(value))\n\nclass IndexFinder:\n    \"\"\"Orchestrates finding the smallest index k for a triangular number with n digits.\"\"\"\n    def __init__(self):\n        self._triangular_number_calculator = TriangularNumber()\n        self._digit_counter = DigitCounter()\n\n    def validate_input(self, n: int) -> bool:\n        \"\"\"Validates if n is a positive integer.\"\"\"\n        return n >= 1\n\n    def find_Index(self, n: int) -> int:\n        \"\"\"Finds the smallest index k such that T_k has exactly n digits.\"\"\"\n        # Adhering to \"DO NOT add isinstance() checks or raise exceptions for edge cases\",\n        # we assume n is a valid positive integer based on type hint and problem description.\n        # The validate_input method is kept as per design but its failure does not raise an error here.\n        if not self.validate_input(n):\n            # This branch would imply invalid input, but no exception is raised as per constraints.\n            pass\n\n        k = 1\n        while True:\n            t_k = self._triangular_number_calculator.compute(k)\n            digits = self._digit_counter.count_digits(t_k)\n\n            if digits == n:\n                return k\n            k += 1\n\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    This function delegates the task to an internal IndexFinder class.\n    \"\"\"\n    finder = IndexFinder()\n    return finder.find_Index(n)"}
{"task_id": "Mbpp/737", "solution": "import re\n\nVOWEL_REGEX: str = r'^[aeiou]'\nVOWEL_REGEX_FLAGS: int = re.IGNORECASE\n\ndef check_str(input: str) -> bool:\n    \"\"\"Return True if input starts with a vowel (a,e,i,o,u) using regex '^[aeiou]' with case-insensitive flag; return False for empty string.\"\"\"\n    if not input:\n        return False\n    match = re.search(VOWEL_REGEX, input, VOWEL_REGEX_FLAGS)\n    return bool(match)"}
{"task_id": "Mbpp/740", "solution": "class Validator:\n    def ensure_is_tuple(self, t: any) -> None:\n        \"\"\"Raise TypeError if t is not an instance of tuple.\"\"\"\n        if not isinstance(t, tuple):\n            raise TypeError(\"Input must be a tuple.\")\n\n    def ensure_even_length(self, t: tuple) -> None:\n        \"\"\"Raise ValueError if len(t) % 2 != 0.\"\"\"\n        if len(t) % 2 != 0:\n            raise ValueError(\"Tuple length must be even to form key-value pairs.\")\n\n_validator_instance = Validator()\n\ndef validate_input(t: any) -> None:\n    \"\"\"Validate type and parity of t; raise TypeError or ValueError as required.\"\"\"\n    _validator_instance.ensure_is_tuple(t)\n    _validator_instance.ensure_even_length(t)\n\ndef convert_pairs(t: tuple) -> dict:\n    \"\"\"Build and return a dict mapping t[2n] -> t[2n+1] for n=0..(k-1).\"\"\"\n    result = {}\n    for i in range(0, len(t), 2):\n        key = t[i]\n        value = t[i+1]\n        result[key] = value\n    return result\n\ndef tuple_to_dict(t: tuple) -> dict:\n    \"\"\"Convert adjacent elements of tuple t into a dict mapping keys -> values.\n\n    Raises:\n      TypeError: if t is not a tuple or if insertion of unhashable key fails.\n      ValueError: if len(t) is odd.\n    \"\"\"\n    validate_input(t)\n    return convert_pairs(t)"}
{"task_id": "Mbpp/742", "solution": "import math\n\ndef area_tetrahedron(edge_length) -> float:\n    \"\"\"\n    Calculates the surface area of a regular tetrahedron given its edge length.\n    Uses the formula: Area = sqrt(3) * edge_length^2.\n    \"\"\"\n    return math.sqrt(3) * (edge_length ** 2)"}
{"task_id": "Mbpp/743", "solution": "def rotate_right(input_list, k):\n    \"\"\"\n    Rotates a list to the right by a specified number of items.\n    Handles empty lists, zero rotation, and rotation amounts greater than list length.\n    \"\"\"\n    n = len(input_list)\n\n    # Handle the case of an empty list as per FR5.\n    if n == 0:\n        return []\n\n    # Normalize k to be within the bounds of the list length as per FR6.\n    # This also naturally handles k=0 (effective_k becomes 0) as per FR4.\n    effective_k = k % n\n\n    # Slice the list into two parts:\n    # The last 'effective_k' elements (which will move to the front).\n    # The remaining 'n - effective_k' elements (which stay at the back).\n    # This preserves the relative order of elements as per FR2.\n    suffix_part = input_list[n - effective_k:]\n    prefix_part = input_list[:n - effective_k]\n\n    # Combine the parts to form the rotated list as a new object.\n    return suffix_part + prefix_part"}
{"task_id": "Mbpp/744", "solution": "def check_none(input_tuple: tuple) -> bool:\n    \"\"\"\n    Checks if the given tuple contains any None values.\n    Raises TypeError if the input is not a tuple.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    for element in input_tuple:\n        if element is None:\n            return True\n    return False"}
{"task_id": "Mbpp/750", "solution": "def add_tuple(list_input, tuple_input):\n    \"\"\"Return a new list containing elements of list_input followed by elements of tuple_input.\n    This implementation returns a new list and does not mutate list_input.\n    \"\"\"\n    return list_input + list(tuple_input)"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"Inserts spaces before words starting with capital letters, preserving the first character.\n    input_string must be a str; behavior for non-str inputs is undefined per SRS.\"\"\"\n    result = []\n    for i, char in enumerate(input_string):\n        if i > 0 and char.isupper():\n            result.append(' ')\n        result.append(char)\n    return \"\".join(result)"}
{"task_id": "Mbpp/749", "solution": "def sort_numeric_strings(input_list: list[str]) -> list[int]:\n    \"\"\"\n    Parses a list of numeric strings into integers and sorts them numerically.\n    Returns a new list containing the sorted integers.\n    \"\"\"\n    parsed_numbers = []\n    for s in input_list:\n        # Converts string to integer, supporting negative integers and zero.\n        parsed_numbers.append(int(s))\n    \n    # Sorts the list of integers in ascending order.\n    sorted_numbers = sorted(parsed_numbers)\n    \n    return sorted_numbers"}
{"task_id": "Mbpp/745", "solution": "from typing import List\n\nclass Digit:\n    \"\"\"Represents a single decimal digit value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_zero(self) -> bool:\n        \"\"\"Checks if the digit's value is zero.\"\"\"\n        return self.value == 0\n\nclass Number:\n    \"\"\"Represents a candidate integer, its digits, and provides evaluation helpers.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n        self.digits: List[Digit] = [Digit(int(d)) for d in str(value)]\n\n    def contains_zero(self) -> bool:\n        \"\"\"Checks if any digit in the number is zero.\"\"\"\n        return any(digit.is_zero() for digit in self.digits)\n\n    def divisible_by_all_digits(self) -> bool:\n        \"\"\"Checks if the number is divisible by all its non-zero digits.\"\"\"\n        for digit in self.digits:\n            if not digit.is_zero():\n                if self.value % digit.value != 0:\n                    return False\n        return True\n\nclass ResultList:\n    \"\"\"Collects qualifying integers and provides an ordered list.\"\"\"\n    def __init__(self) -> None:\n        self.values: List[int] = []\n\n    def add(self, n: int) -> None:\n        \"\"\"Adds an integer to the list of results.\"\"\"\n        self.values.append(n)\n\n    def as_list(self) -> List[int]:\n        \"\"\"Returns the collected integers as a list.\"\"\"\n        return list(self.values)\n\nclass DivisibleByDigitsFunction:\n    \"\"\"Coordinates the evaluation of numbers in a range to find those divisible by their digits.\"\"\"\n    def execute(self, startnum: int, endnum: int) -> List[int]:\n        result = ResultList()\n        for n in range(startnum, endnum + 1):\n            number = Number(n)\n            if number.contains_zero():\n                continue\n            if number.divisible_by_all_digits():\n                result.add(n)\n        return result.as_list()\n\ndef divisible_by_digits(startnum, endnum) -> List[int]:\n    \"\"\"\n    Finds numbers within a given range (startnum to endnum inclusive) where every number\n    is divisible by every digit it contains, excluding numbers with the digit 0.\n    \"\"\"\n    svc = DivisibleByDigitsFunction()\n    return svc.execute(startnum, endnum)"}
{"task_id": "Mbpp/751", "solution": "from typing import Any, List\nimport math\n\ndef _is_numeric(value: Any) -> bool:\n    \"\"\"Returns True if the value is an int or float, False otherwise.\"\"\"\n    return isinstance(value, (int, float))\n\nclass Validator:\n    \"\"\"Input validation logic for arrays.\"\"\"\n    def validate_array(self, arr: Any) -> None:\n        \"\"\"Raises TypeError if arr is not list/tuple or contains non-numeric elements.\"\"\"\n        if not isinstance(arr, (list, tuple)):\n            raise TypeError(\"Input must be a list or tuple.\")\n        for i, item in enumerate(arr):\n            if not _is_numeric(item):\n                raise TypeError(f\"Array element at index {i} is not numeric.\")\n\nclass MinHeapChecker:\n    \"\"\"Evaluates the min-heap property for an array.\"\"\"\n    def left_index(self, i: int) -> int:\n        \"\"\"Returns the 0-based index of the left child.\"\"\"\n        return 2 * i + 1\n\n    def right_index(self, i: int) -> int:\n        \"\"\"Returns the 0-based index of the right child.\"\"\"\n        return 2 * i + 2\n\n    def is_parent_valid(self, arr: List[Any], i: int) -> bool:\n        \"\"\"Checks if a parent node satisfies the min-heap property with its children.\"\"\"\n        n = len(arr)\n        left = self.left_index(i)\n        right = self.right_index(i)\n\n        if left < n and arr[i] > arr[left]:\n            return False\n        if right < n and arr[i] > arr[right]:\n            return False\n        return True\n\n    def check_min_heap(self, arr: List[Any]) -> bool:\n        \"\"\"Evaluates if the given array represents a min-heap.\"\"\"\n        n = len(arr)\n        if n <= 1:\n            return True # Empty or single-element arrays are valid min-heaps.\n\n        # Iterate only through parent nodes, from 0 to floor(n/2) - 1\n        for i in range(math.floor(n / 2)):\n            if not self.is_parent_valid(arr, i):\n                return False\n        return True\n\ndef check_min_heap(arr: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    Delegates validation to Validator and heap property check to MinHeapChecker.\n    \"\"\"\n    validator = Validator()\n    validator.validate_array(arr)\n\n    heap_checker = MinHeapChecker()\n    return heap_checker.check_min_heap(arr)"}
{"task_id": "Mbpp/752", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass InputParameter:\n    \"\"\"Encapsulates and validates the provided input n.\"\"\"\n    def __init__(self, n):\n        self._n = n\n\n    def is_integer(self) -> bool:\n        \"\"\"Checks if the input is an integer.\"\"\"\n        return isinstance(self._n, int)\n\n    def is_non_negative(self) -> bool:\n        \"\"\"Checks if the input is non-negative.\"\"\"\n        return self._n >= 0\n\n    def validate(self) -> None:\n        \"\"\"Validates the input n, raising ValidationError if invalid.\"\"\"\n        if not self.is_integer():\n            raise ValidationError(\"Input must be an integer.\")\n        if not self.is_non_negative():\n            raise ValidationError(\"Input must be a non-negative integer.\")\n\nclass JacobsthalNumber:\n    \"\"\"Value object holding the computed Jacobsthal result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass JacobsthalFunction:\n    \"\"\"Encapsulates the domain computation for Jacobsthal numbers.\"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the nth Jacobsthal number using base cases and recurrence.\"\"\"\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n\n        j0, j1 = 0, 1\n        for _ in range(2, n + 1):\n            next_j = j1 + 2 * j0\n            j0 = j1\n            j1 = next_j\n        return j1\n\ndef jacobsthal_num(n):\n    \"\"\"Public API: validates n and returns the nth Jacobsthal number or raises ValidationError.\"\"\"\n    InputParameter(n).validate()\n    return JacobsthalFunction().compute(int(n))"}
{"task_id": "Mbpp/753", "solution": "def min_k(records, k):\n    \"\"\"\n    Finds the minimum k records from a list of tuples, sorted by the second element.\n    Assumes valid input types and structure as per requirements.\n    \"\"\"\n    records_list = list(records)\n    n = len(records_list)\n\n    # Sort the records stably by their second element (value) in ascending order.\n    sorted_records = sorted(records_list, key=lambda x: x[1])\n\n    # Select the first k records based on k's value relative to n.\n    if k <= 0:\n        return []\n    elif k > n:\n        return sorted_records\n    else: # 0 < k <= n\n        return sorted_records[:k]"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"Return a list of elements equal at the same index in l1, l2, and l3.\n\n    Matches only for indices i where 0 <= i < min(len(l1), len(l2), len(l3)).\n    \"\"\"\n    min_len = min(len(l1), len(l2), len(l3))\n    result = []\n    for i in range(min_len):\n        if l1[i] == l2[i] == l3[i]:\n            result.append(l1[i])\n    return result"}
