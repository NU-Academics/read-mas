{"task_id": "Mbpp/581", "solution": "class SquarePyramid:\n    \"\"\"Internal class to encapsulate square pyramid properties and area computations.\"\"\"\n    def __init__(self, base_edge: float, height: float):\n        self.base_edge = float(base_edge)\n        self.height = float(height)\n\n    def base_area(self) -> float:\n        \"\"\"Computes the area of the square base.\"\"\"\n        return self.base_edge ** 2\n\n    def lateral_area(self) -> float:\n        \"\"\"Computes the lateral surface area based on the simplified business rule.\"\"\"\n        return 2 * self.base_edge * self.height\n\n    def surface_area(self) -> float:\n        \"\"\"Computes the total surface area as the sum of base and lateral areas.\"\"\"\n        return self.base_area() + self.lateral_area()\n\ndef surface_Area(base_edge, height):\n    \"\"\"Accept numeric base_edge and height and return numeric surface area.\"\"\"\n    pyramid = SquarePyramid(base_edge, height)\n    return pyramid.surface_area()"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"Removes odd integers from a nested mixed tuple, preserving structure and returning new tuples.\"\"\"\n\n    def _is_even(value: int) -> bool:\n        \"\"\"Determines if an integer value is even.\"\"\"\n        return value % 2 == 0\n\n    def _filter_tuple(current_tuple: tuple) -> tuple:\n        \"\"\"Recursively filters odd integers from a tuple and its nested tuples.\"\"\"\n        result_elements = []\n        for item in current_tuple:\n            if isinstance(item, int):\n                if _is_even(item):\n                    result_elements.append(item)\n            elif isinstance(item, tuple):\n                nested_filtered = _filter_tuple(item)\n                result_elements.append(nested_filtered)\n        return tuple(result_elements)\n\n    return _filter_tuple(input_tuple)"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1, tuple2) -> tuple:\n    \"\"\"Compute and return the ordered, unique symmetric difference of two tuples.\"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n\n    result_list = []\n    seen_in_result = set()\n\n    # Add elements from tuple1 that are not in tuple2\n    for item in tuple1:\n        if item not in set2 and item not in seen_in_result:\n            result_list.append(item)\n            seen_in_result.add(item)\n\n    # Add elements from tuple2 that are not in tuple1\n    for item in tuple2:\n        if item not in set1 and item not in seen_in_result:\n            result_list.append(item)\n            seen_in_result.add(item)\n\n    return tuple(result_list)"}
{"task_id": "Mbpp/578", "solution": "import collections.abc\n\nclass LengthMismatchError(Exception):\n    \"\"\"Exception raised when input list lengths differ.\"\"\"\n    def __init__(self, message: str = \"Input lists must have the same length.\"):\n        self.message = message\n        super().__init__(self.message)\n\nclass InputList:\n    \"\"\"Lightweight read-only wrapper around an input list-like iterable.\"\"\"\n    def __init__(self, elements):\n        # Validate that elements are a Sequence as expected by this wrapper.\n        if not isinstance(elements, collections.abc.Sequence):\n            raise ValueError(f\"Input for InputList must be a Sequence, got {type(elements).__name__}\")\n        self._elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements.\"\"\"\n        return len(self._elements)\n\n    def get_item(self, index: int) -> object:\n        \"\"\"Returns the element at the given index.\"\"\"\n        return self._elements[index]\n\nclass OutputList:\n    \"\"\"Container for the interleaver result.\"\"\"\n    def __init__(self):\n        self._elements = []\n\n    def append(self, value: object) -> None:\n        \"\"\"Appends an element to the internal list.\"\"\"\n        self._elements.append(value)\n\n    def to_list(self) -> list:\n        \"\"\"Returns the internal flat Python list.\"\"\"\n        return self._elements\n\nclass Interleaver:\n    \"\"\"Encapsulates the interleaving engine.\"\"\"\n    def interleave_lists(self, list1: InputList, list2: InputList, list3: InputList) -> OutputList:\n        \"\"\"\n        Reads InputList instances, validates lengths, and produces an OutputList.\n        Raises LengthMismatchError if lengths differ.\n        \"\"\"\n        len1 = list1.length()\n        len2 = list2.length()\n        len3 = list3.length()\n\n        if not (len1 == len2 == len3):\n            raise LengthMismatchError(f\"Input lists have unequal lengths: {len1}, {len2}, {len3}\")\n\n        output_list = OutputList()\n        for i in range(len1):\n            output_list.append(list1.get_item(i))\n            output_list.append(list2.get_item(i))\n            output_list.append(list3.get_item(i))\n        return output_list\n\ndef interleave_lists(list1, list2, list3) -> list:\n    \"\"\"\n    Public API. Accepts exactly three list-like iterables and returns a flat Python list\n    containing elements in the order list1[i], list2[i], list3[i] for each index i.\n    \"\"\"\n    def _validate_input_for_public_api(obj, name: str):\n        \"\"\"Validates if an object is a list-like iterable (Sequence), raising ValueError if not.\"\"\"\n        if not isinstance(obj, collections.abc.Sequence):\n            raise ValueError(f\"Input '{name}' must be a list-like iterable (e.g., list, tuple), got {type(obj).__name__}\")\n        return obj\n\n    _validate_input_for_public_api(list1, \"list1\")\n    _validate_input_for_public_api(list2, \"list2\")\n    _validate_input_for_public_api(list3, \"list3\")\n\n    input1 = InputList(list1)\n    input2 = InputList(list2)\n    input3 = InputList(list3)\n\n    interleaver = Interleaver()\n    output = interleaver.interleave_lists(input1, input2, input3)\n    return output.to_list()"}
{"task_id": "Mbpp/583", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid input to the catalan_number function.\"\"\"\n    pass\n\ndef _validate_n(n):\n    \"\"\"\n    Validates if n is a non-negative integer.\n    Raises ValidationError if n is invalid.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValidationError(\"n must be an integer and n >= 0\")\n\ndef _binomial_coefficient(n, k):\n    \"\"\"\n    Computes the binomial coefficient C(n, k) using integer arithmetic.\n    Returns 0 if k < 0 or k > n.\n    \"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    # Optimization: C(n, k) = C(n, n-k)\n    if k > n // 2:\n        k = n - k\n\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\n\nclass BinomialCoefficient:\n    \"\"\"\n    Helper class to compute binomial coefficients.\n    Delegates to the module-private _binomial_coefficient function.\n    \"\"\"\n    @staticmethod\n    def compute(n, k):\n        return _binomial_coefficient(n, k)\n\ndef catalan_number(n):\n    \"\"\"\n    Calculates the nth Catalan number.\n    Input n must be a non-negative integer.\n    \"\"\"\n    _validate_n(n)\n\n    # C_n = (1/(n+1)) * C(2n, n)\n    # The formula works for n=0 as well: C(0,0)/(0+1) = 1/1 = 1\n    binom_2n_n = BinomialCoefficient.compute(2 * n, n)\n    return binom_2n_n // (n + 1)"}
{"task_id": "Mbpp/586", "solution": "def validate_index(n, length):\n    \"\"\"\n    Validates if the given index n is within the valid range [0, length].\n    Raises ValueError if n is out of bounds.\n    \"\"\"\n    if not (0 <= n <= length):\n        raise ValueError(\"Index n is out of bounds for the list length.\")\n    return None\n\ndef split_Arr(input_list, n):\n    \"\"\"\n    Splits a list at the nth element and adds the first part to the end.\n    Returns a new list without modifying the input_list.\n    \"\"\"\n    validate_index(n, len(input_list))\n    prefix = input_list[0:n]\n    suffix = input_list[n:]\n    return suffix + prefix"}
{"task_id": "Mbpp/585", "solution": "from typing import List, Dict, Union\n\nclass Item:\n    \"\"\"Represents an item with a name and a price.\"\"\"\n    def __init__(self, name: str, price: Union[int, float, str]):\n        self.name = name\n        self.price = float(price)\n\n    def to_dict(self) -> Dict[str, Union[str, float]]:\n        \"\"\"Converts the Item object back to a dictionary.\"\"\"\n        return {'name': self.name, 'price': self.price}\n\nclass ItemsCollection:\n    \"\"\"Manages a collection of Item objects.\"\"\"\n    def __init__(self, items_list: List[Dict[str, Union[str, float, int]]]):\n        self.items: List[Item] = [Item(item_data['name'], item_data['price']) for item_data in items_list]\n\n    def size(self) -> int:\n        \"\"\"Returns the number of items in the collection.\"\"\"\n        return len(self.items)\n\n    def sort_desc_by_price(self) -> None:\n        \"\"\"Sorts the items in descending order by price, in-place.\"\"\"\n        self.items.sort(key=lambda item: item.price, reverse=True)\n\n    def to_list_of_dicts(self) -> List[Dict[str, Union[str, float]]]:\n        \"\"\"Converts the collection of Item objects to a list of dictionaries.\"\"\"\n        return [item.to_dict() for item in self.items]\n\nclass ExpensiveItemsService:\n    \"\"\"Provides the core logic for finding expensive items.\"\"\"\n    @staticmethod\n    def expensive_items(items: List[Dict[str, Union[str, float, int]]], n: int) -> List[Dict[str, Union[str, float]]]:\n        \"\"\"\n        Finds the n most expensive items from a list of dictionaries.\n        This method handles sorting and selecting the top N items.\n        \"\"\"\n        if n == 0:\n            return []\n\n        collection = ItemsCollection(items)\n        collection.sort_desc_by_price()\n\n        selected_items = collection.items[:n]\n        return [item.to_dict() for item in selected_items]\n\ndef expensive_items(items: List[Dict[str, Union[str, float, int]]], n: int) -> List[Dict[str, Union[str, float]]]:\n    \"\"\"\n    Finds the n most expensive items in a given dataset.\n    This is the public API entry point.\n    \"\"\"\n    return ExpensiveItemsService.expensive_items(items, n)"}
{"task_id": "Mbpp/588", "solution": "def validate(nums):\n    \"\"\"\n    Validates the input list: ensures it's non-empty and contains only numeric elements.\n    Raises ValueError for empty lists or TypeError for non-numeric elements.\n    \"\"\"\n    if not nums:\n        raise ValueError('nums must be non-empty')\n    for x in nums:\n        if not isinstance(x, (int, float)):\n            raise TypeError('all elements must be numeric (int or float)')\n\ndef compute_max(nums):\n    \"\"\"\n    Computes and returns the maximum numeric value from the list.\n    Assumes input `nums` has already been validated.\n    \"\"\"\n    return max(nums)\n\ndef compute_min(nums):\n    \"\"\"\n    Computes and returns the minimum numeric value from the list.\n    Assumes input `nums` has already been validated.\n    \"\"\"\n    return min(nums)\n\ndef big_diff(nums):\n    \"\"\"\n    Finds the difference between the largest and smallest value in a given list.\n    It validates the input and delegates computation to helper functions.\n    \"\"\"\n    validate(nums)\n    max_val = compute_max(nums)\n    min_val = compute_min(nums)\n    return max_val - min_val"}
{"task_id": "Mbpp/591", "solution": "def swap_List(input_list: list) -> list:\n    \"\"\"Return a new list with first and last elements swapped.\"\"\"\n    if len(input_list) < 2:\n        return input_list.copy()\n    return [input_list[-1]] + input_list[1:-1] + [input_list[0]]"}
{"task_id": "Mbpp/589", "solution": "import math\nfrom typing import List\n\ndef perfect_squares(start: int, end: int) -> List[int]:\n    \"\"\"\n    Finds perfect squares within an inclusive integer range [start, end].\n    Returns an ascending list of perfect squares.\n    \"\"\"\n    squares = []\n\n    # Calculate the minimum k whose square might be in the range [start, end].\n    # max(start, 0) ensures k*k is non-negative and avoids math domain errors for negative start.\n    k_min = math.ceil(math.sqrt(max(start, 0)))\n\n    # Calculate the maximum k whose square might be in the range [start, end].\n    # max(0, end) ensures k*k is non-negative and avoids math domain errors for negative end.\n    k_max = math.floor(math.sqrt(max(0, end)))\n\n    # Iterate k from k_min to k_max (inclusive) and collect squares that fall within [start, end].\n    for k in range(int(k_min), int(k_max) + 1):\n        square = k * k\n        if start <= square <= end:\n            squares.append(square)\n\n    return squares"}
{"task_id": "Mbpp/590", "solution": "import math\nfrom typing import Union\n\nNumeric = Union[int, float]\n\nclass PolarCoordinate:\n    \"\"\"Represents polar coordinate values r and theta.\"\"\"\n    def __init__(self, r: float, theta: float) -> None:\n        self.r = r\n        self.theta = theta\n\nclass RectangularCoordinate:\n    \"\"\"Represents computed rectangular components and assembled complex value.\"\"\"\n    def __init__(self, x: float, y: float) -> None:\n        self.x = x\n        self.y = y\n\n    @property\n    def value(self) -> complex:\n        \"\"\"Returns the rectangular coordinate as a complex number.\"\"\"\n        return complex(self.x, self.y)\n\nclass PolarConverter:\n    \"\"\"Validates inputs and computes rectangular coordinates from polar.\"\"\"\n    def polar_rect(self, r: Numeric, theta: Numeric) -> complex:\n        \"\"\"\n        Converts polar coordinates to rectangular coordinates (complex number).\n        Validates r and theta are numeric and raises TypeError for invalid inputs.\n        \"\"\"\n        if not isinstance(r, (int, float)) or not isinstance(theta, (int, float)):\n            raise TypeError(\"r and theta must be numeric (int or float)\")\n\n        x = self._compute_x(float(r), float(theta))\n        y = self._compute_y(float(r), float(theta))\n        return complex(x, y)\n\n    def _compute_x(self, r: float, theta: float) -> float:\n        \"\"\"Computes the x-component of the rectangular coordinate.\"\"\"\n        return r * math.cos(theta)\n\n    def _compute_y(self, r: float, theta: float) -> float:\n        \"\"\"Computes the y-component of the rectangular coordinate.\"\"\"\n        return r * math.sin(theta)\n\ndef polar_rect(r: Numeric, theta: Numeric) -> complex:\n    \"\"\"\n    Converts polar coordinates (r, theta) to rectangular coordinates (x + yj).\n    Delegates to PolarConverter for validation and computation.\n    \"\"\"\n    converter = PolarConverter()\n    return converter.polar_rect(r, theta)"}
{"task_id": "Mbpp/593", "solution": "def _normalize_octet(raw_octet: str) -> str:\n    \"\"\"Removes leading zeros from an octet string, preserving '0' for zero values.\"\"\"\n    return str(int(raw_octet))\n\ndef removezero_ip(ip: str) -> str:\n    \"\"\"Removes leading zeros from each octet of an IPv4 address string.\"\"\"\n    octets = ip.split('.')\n    normalized_octets = [_normalize_octet(octet) for octet in octets]\n    return \".\".join(normalized_octets)"}
{"task_id": "Mbpp/592", "solution": "try:\n    from math import comb as _math_comb\nexcept ImportError:\n    # Python version < 3.8, math.comb is not available\n    _math_comb = None\n\ndef binomial(n: int, k: int) -> int:\n    \"\"\"\n    Calculates the binomial coefficient C(n, k) using exact integer arithmetic.\n    Delegates to math.comb if available, otherwise uses a multiplicative algorithm.\n    \"\"\"\n    if _math_comb is not None:\n        return _math_comb(n, k)\n    else:\n        # Fallback multiplicative integer algorithm\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        \n        # Optimization: C(n, k) == C(n, n-k)\n        if k > n // 2:\n            k = n - k\n\n        res = 1\n        for i in range(1, k + 1):\n            res = res * (n - k + i) // i\n        return res\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients C(n,k) * C(n,k+1).\n    The sum is calculated for k from 0 to n-1.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    total_sum = 0\n    # Iterate k from 0 to n-1 as per the sum definition\n    for k in range(n):\n        # Calculate C(n, k) and C(n, k+1) using the helper function\n        c_nk = binomial(n, k)\n        c_nk_plus_1 = binomial(n, k + 1)\n        \n        total_sum += c_nk * c_nk_plus_1\n        \n    return total_sum"}
{"task_id": "Mbpp/596", "solution": "import sys\n\ndef tuple_size(t):\n    \"\"\"\n    Calculates the size in bytes of the given tuple using sys.getsizeof.\n    Raises TypeError if the input is not a tuple.\n    \"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(\"tuple_size: argument must be a tuple\")\n    return sys.getsizeof(t)"}
{"task_id": "Mbpp/594", "solution": "def _find_first_even(lst):\n    \"\"\"Finds the first even number and its value in the list.\"\"\"\n    for i, num in enumerate(lst):\n        if num % 2 == 0:\n            return (i, num)\n    return None\n\ndef _find_first_odd(lst):\n    \"\"\"Finds the first odd number and its value in the list.\"\"\"\n    for i, num in enumerate(lst):\n        if num % 2 != 0:\n            return (i, num)\n    return None\n\ndef diff_even_odd(lst):\n    \"\"\"\n    Finds the difference of the first even and first odd number of a given list.\n    Input validation for type and empty list is omitted per specific instructions.\n    \"\"\"\n    first_odd_result = _find_first_odd(lst)\n    first_even_result = _find_first_even(lst)\n\n    if first_odd_result is None:\n        raise ValueError(\"no odd number found\")\n\n    if first_even_result is None:\n        raise ValueError(\"no even number found\")\n\n    first_odd_value = first_odd_result[1]\n    first_even_value = first_even_result[1]\n\n    return first_even_value - first_odd_value"}
{"task_id": "Mbpp/598", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass Number:\n    value: int\n    digitCount: int\n    digits: List[int]\n\n@dataclass\nclass Result:\n    isArmstrong: bool\n\nclass ArmstrongChecker:\n    def countDigits(self, n: int) -> int:\n        \"\"\"Counts the number of digits in a non-negative integer.\"\"\"\n        if n == 0:\n            return 1\n        return len(str(n))\n\n    def extractDigits(self, n: int) -> List[int]:\n        \"\"\"Extracts individual digits from a non-negative integer.\"\"\"\n        if n == 0:\n            return [0]\n        return [int(d) for d in str(n)]\n\n    def computePowerSum(self, digits: List[int], power: int) -> int:\n        \"\"\"Computes the sum of each digit raised to the given power.\"\"\"\n        return sum(d ** power for d in digits)\n\n    def armstrong_number(self, n: int) -> bool:\n        \"\"\"Determines if the given number is an Armstrong number.\"\"\"\n        if n < 0:\n            return False\n\n        num_obj = Number(value=n, digitCount=0, digits=[])\n        num_obj.digitCount = self.countDigits(n)\n        num_obj.digits = self.extractDigits(n)\n\n        power_sum = self.computePowerSum(num_obj.digits, num_obj.digitCount)\n\n        evaluation_result = Result(isArmstrong=(power_sum == n))\n        return evaluation_result.isArmstrong\n\ndef armstrong_number(n: int) -> bool:\n    \"\"\"Public API: evaluates n and returns True if Armstrong, else False.\"\"\"\n    checker = ArmstrongChecker()\n    return checker.armstrong_number(n)"}
{"task_id": "Mbpp/597", "solution": "from typing import List, Any\n\nclass Element:\n    \"\"\"Represents an element with a comparable value.\"\"\"\n    def __init__(self, value: Any) -> None:\n        self.value = value\n\n    def __lt__(self, other: 'Element') -> bool:\n        return self.value < other.value\n\n    def __le__(self, other: 'Element') -> bool:\n        return self.value <= other.value\n\n    def __gt__(self, other: 'Element') -> bool:\n        return self.value > other.value\n\n    def __ge__(self, other: 'Element') -> bool:\n        return self.value >= other.value\n\n    def __eq__(self, other: Any) -> bool:\n        if isinstance(other, Element):\n            return self.value == other.value\n        return NotImplemented\n\n    def __hash__(self) -> int:\n        return hash(self.value)\n\n    def __repr__(self) -> str:\n        return f\"Element({self.value})\"\n\nclass Array:\n    \"\"\"Wrapper over a list of elements with helpers for length and sorted status.\"\"\"\n    def __init__(self, elements: List[Any]) -> None:\n        self.elements = [Element(e) for e in elements]\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def is_sorted(self) -> bool:\n        if not self.elements:\n            return True\n        for i in range(1, len(self.elements)):\n            if self.elements[i] < self.elements[i-1]:\n                return False\n        return True\n\nclass Validator:\n    \"\"\"Validates array sortedness and k-range.\"\"\"\n    def validate_sorted(self, arr: Array) -> bool:\n        if not arr.is_sorted():\n            raise ValueError(\"Array not sorted\")\n        return True\n\n    def validate_k_range(self, arr1: Array, arr2: Array, k: int) -> bool:\n        total_length = arr1.length() + arr2.length()\n        if not (1 <= k <= total_length):\n            raise ValueError(f\"k ({k}) out of range [1, {total_length}]\")\n        return True\n\nclass FindKth:\n    \"\"\"Algorithm to find the k-th smallest element from two sorted arrays.\"\"\"\n    def find_kth(self, arr1: Array, arr2: Array, k: int) -> Element:\n        elements1 = arr1.elements\n        elements2 = arr2.elements\n        m, n = len(elements1), len(elements2)\n\n        # Ensure elements1 is the smaller array to simplify binary search range\n        if m > n:\n            return self.find_kth(Array([e.value for e in elements2]), Array([e.value for e in elements1]), k)\n\n        # Binary search for partitionX in elements1\n        low = max(0, k - n)\n        high = min(k, m)\n\n        while low <= high:\n            partitionX = (low + high) // 2\n            partitionY = k - partitionX\n\n            # Determine boundary elements, using Element wrappers for -inf and +inf sentinels\n            maxLeftX = elements1[partitionX - 1] if partitionX != 0 else Element(float('-inf'))\n            minRightX = elements1[partitionX] if partitionX != m else Element(float('inf'))\n\n            maxLeftY = elements2[partitionY - 1] if partitionY != 0 else Element(float('-inf'))\n            minRightY = elements2[partitionY] if partitionY != n else Element(float('inf'))\n\n            # Check if partitions are correct\n            if maxLeftX <= minRightY and maxLeftY <= minRightX:\n                # k-th element is the maximum of the elements at the left partitions\n                return max(maxLeftX, maxLeftY)\n            elif maxLeftX > minRightY:\n                # We took too many elements from elements1; need to reduce partitionX\n                high = partitionX - 1\n            else: # maxLeftY > minRightX\n                # We took too few elements from elements1; need to increase partitionX\n                low = partitionX + 1\n\ndef find_kth(arr1: List[Any], arr2: List[Any], k: int) -> Any:\n    \"\"\"Accepts two sorted arrays and integer k (1-based). Validates inputs using Validator and returns the k-th smallest element originating from the inputs or raises ValueError on invalid input.\"\"\"\n    \n    array1_obj = Array(arr1)\n    array2_obj = Array(arr2)\n\n    validator = Validator()\n    validator.validate_sorted(array1_obj)\n    validator.validate_sorted(array2_obj)\n    validator.validate_k_range(array1_obj, array2_obj, k)\n\n    find_kth_algo = FindKth()\n    result_element = find_kth_algo.find_kth(array1_obj, array2_obj, k)\n    \n    return result_element.value"}
{"task_id": "Mbpp/599", "solution": "from __future__ import annotations\n\ndef sum_average(n: int) -> tuple[int, float]:\n    \"\"\"Compute and return (sum, average) for first n natural numbers.\"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    s = n * (n + 1) // 2\n    a = float(s) / n\n    return (s, a)"}
