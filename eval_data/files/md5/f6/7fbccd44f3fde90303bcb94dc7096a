{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(n: int) -> int:\n    \"\"\"Return the number of set bits (1s) in the binary representation of n.\n\n    Args:\n        n (int): integer input as specified by design.\n\n    Returns:\n        int: number of set bits (>= 0).\n    \"\"\"\n    count = 0\n    while n > 0:\n        n &= (n - 1)\n        count += 1\n    return count"}
{"task_id": "Mbpp/223", "solution": "def _find_first(arr, x):\n    \"\"\"Finds the index of the first occurrence of x in arr using binary search.\"\"\"\n    low = 0\n    high = len(arr) - 1\n    result = -1\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            result = mid\n            high = mid - 1\n        elif arr[mid] < x:\n            low = mid + 1\n        else: # arr[mid] > x\n            high = mid - 1\n    return result\n\ndef _find_last(arr, x):\n    \"\"\"Finds the index of the last occurrence of x in arr using binary search.\"\"\"\n    low = 0\n    high = len(arr) - 1\n    result = -1\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            result = mid\n            low = mid + 1\n        elif arr[mid] < x:\n            low = mid + 1\n        else: # arr[mid] > x\n            high = mid - 1\n    return result\n\ndef _countOccurrences(arr, x):\n    \"\"\"Counts occurrences of x in arr using binary search for first and last indices.\"\"\"\n    first_idx = _find_first(arr, x)\n    if first_idx == -1:\n        return 0\n    last_idx = _find_last(arr, x)\n    return last_idx - first_idx + 1\n\ndef is_majority(array, n, element):\n    \"\"\"\n    Checks if an element is the majority element in a sorted array.\n    The majority element occurs more than n/2 times.\n    \"\"\"\n    if n != len(array):\n        raise ValueError(\"Provided length n does not match array's actual length.\")\n\n    occurrence_count = _countOccurrences(array, element)\n    return occurrence_count > n / 2"}
