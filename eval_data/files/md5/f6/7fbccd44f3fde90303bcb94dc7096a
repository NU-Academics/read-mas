{"task_id": "Mbpp/629", "solution": "def isEven(n) -> bool:\n    \"\"\"Return True when n % 2 == 0, else False.\"\"\"\n    return n % 2 == 0\n\ndef Split(inputList: list) -> list:\n    \"\"\"Return a list containing only the even numbers from inputList in original order.\"\"\"\n    even_numbers = []\n    for n in inputList:\n        if isEven(n):\n            even_numbers.append(n)\n    return even_numbers"}
{"task_id": "Mbpp/630", "solution": "from typing import List, Tuple\n\nclass Coordinate:\n    \"\"\"Lightweight data holder for integer x, y and conversion to list.\"\"\"\n    def __init__(self, x: int, y: int) -> None:\n        self.x = x\n        self.y = y\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns the coordinate as a list [x, y].\"\"\"\n        return [self.x, self.y]\n\nclass CoordinateList:\n    \"\"\"Typed wrapper around a Python list to represent an ordered collection of Coordinates.\"\"\"\n    def __init__(self, items: List['Coordinate'] | None = None) -> None:\n        self.items = items if items is not None else []\n\n    def length(self) -> int:\n        \"\"\"Returns the number of coordinates in the list.\"\"\"\n        return len(self.items)\n\n    def to_nested_list(self) -> List[List[int]]:\n        \"\"\"Converts contained Coordinates to a list of lists [[x1, y1], ...].\"\"\"\n        return [item.to_list() for item in self.items]\n\nclass CoordinateGrid:\n    \"\"\"Generates the 3x3 neighborhood as a CoordinateList in row-major order.\"\"\"\n    def __init__(self, center: 'Coordinate') -> None:\n        self.center = center\n        self.cells: CoordinateList = CoordinateList()\n\n    def generate(self) -> 'CoordinateList':\n        \"\"\"Computes the 3x3 Cartesian product centered on the input coordinate.\"\"\"\n        x_start, y_start = self.center.x - 1, self.center.y - 1\n        x_end, y_end = self.center.x + 1, self.center.y + 1\n\n        generated_coordinates = []\n        for x in range(x_start, x_end + 1):\n            for y in range(y_start, y_end + 1):\n                generated_coordinates.append(Coordinate(x, y))\n        self.cells = CoordinateList(generated_coordinates)\n        return self.cells\n\ndef get_coordinates(coord: Tuple[int, int]) -> List[List[int]]:\n    \"\"\"\n    Return list[list[int,int]]: nine coordinates in row-major order.\n    Assumes coord is a 2-tuple of integers.\n    \"\"\"\n    input_x, input_y = coord\n    center = Coordinate(input_x, input_y)\n    grid = CoordinateGrid(center)\n    coord_list = grid.generate()\n    return coord_list.to_nested_list()"}
{"task_id": "Mbpp/632", "solution": "def _is_zero(value):\n    \"\"\"Returns True if value is considered zero by this implementation (value == 0).\"\"\"\n    return value == 0\n\ndef move_zero(input_list):\n    \"\"\"Accepts a single list argument and returns a reordered list per SRS.\"\"\"\n    non_zero_elements = []\n    zero_count = 0\n    for element in input_list:\n        if _is_zero(element):\n            zero_count += 1\n        else:\n            non_zero_elements.append(element)\n    non_zero_elements.extend([0] * zero_count)\n    return non_zero_elements"}
{"task_id": "Mbpp/631", "solution": "def replace_spaces_to_underscores(input: str) -> str:\n    \"\"\"Converts ASCII space characters to underscores.\"\"\"\n    result_chars = []\n    for char in input:\n        if char == ' ':\n            result_chars.append('_')\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)\n\ndef replace_underscores_to_spaces(input: str) -> str:\n    \"\"\"Converts underscore characters to ASCII spaces.\"\"\"\n    result_chars = []\n    for char in input:\n        if char == '_':\n            result_chars.append(' ')\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)\n\ndef replace_spaces(input: str, mode: str = 'ws_to_us') -> str:\n    \"\"\"Replaces spaces with underscores or vice versa based on the mode.\"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if mode == 'ws_to_us':\n        return replace_spaces_to_underscores(input)\n    elif mode == 'us_to_ws':\n        return replace_underscores_to_spaces(input)\n    else:\n        raise ValueError(\"Invalid mode. Must be 'ws_to_us' or 'us_to_ws'.\")"}
{"task_id": "Mbpp/633", "solution": "from typing import List\n\ndef select_first_n(nums: List[int], n: int) -> List[int]:\n    \"\"\"Returns the list of first m elements where m = min(n, len(nums)).\"\"\"\n    m = min(n, len(nums))\n    return nums[:m]\n\ndef compute_xor(a: int, b: int) -> int:\n    \"\"\"Returns the bitwise XOR of two integers.\"\"\"\n    return a ^ b\n\ndef pair_xor_Sum(nums: List[int], n: int) -> int:\n    \"\"\"\n    Finds the sum of XORs of all unique pairs of numbers\n    in the first n elements of the given list.\n    \"\"\"\n    if n < 2:\n        return 0\n\n    first_m_list = select_first_n(nums, n)\n    m = len(first_m_list)\n    total_xor_sum = 0\n\n    for i in range(m - 1):\n        for j in range(i + 1, m):\n            total_xor_sum += compute_xor(first_m_list[i], first_m_list[j])\n\n    return total_xor_sum"}
{"task_id": "Mbpp/635", "solution": "class Heap:\n    def __init__(self, nodes: list):\n        \"\"\"Initializes the Heap with a list of nodes and its size.\"\"\"\n        self._nodes = nodes\n        self._size = len(nodes)\n\n    def _swap(self, i: int, j: int):\n        \"\"\"Swaps elements at indices i and j in the internal nodes list.\"\"\"\n        self._nodes[i], self._nodes[j] = self._nodes[j], self._nodes[i]\n\n    def _left_child(self, i: int) -> int:\n        \"\"\"Returns the index of the left child.\"\"\"\n        return 2 * i + 1\n\n    def _right_child(self, i: int) -> int:\n        \"\"\"Returns the index of the right child.\"\"\"\n        return 2 * i + 2\n\n    def sift_down(self, index: int):\n        \"\"\"Restores the max-heap property by sifting down from the given index.\"\"\"\n        largest = index\n        left = self._left_child(index)\n        right = self._right_child(index)\n\n        if left < self._size and self._nodes[left] > self._nodes[largest]:\n            largest = left\n\n        if right < self._size and self._nodes[right] > self._nodes[largest]:\n            largest = right\n\n        if largest != index:\n            self._swap(index, largest)\n            self.sift_down(largest)\n\n    def build_max_heap(self):\n        \"\"\"Builds a max-heap from the current _nodes list.\"\"\"\n        for i in range(self._size // 2 - 1, -1, -1):\n            self.sift_down(i)\n\ndef heap_sort(input_list):\n    \"\"\"Sorts the given list using the heap sort algorithm.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"heap_sort expects a list argument\")\n\n    nodes_copy = list(input_list)\n    \n    heap = Heap(nodes_copy)\n    heap.build_max_heap()\n\n    original_heap_size = heap._size \n\n    for i in range(original_heap_size - 1, 0, -1):\n        heap._swap(0, i)\n        heap._size = heap._size - 1\n        heap.sift_down(0)\n\n    return heap._nodes"}
{"task_id": "Mbpp/637", "solution": "from typing import Any\n\nclass NumericInputValidator:\n    def is_numeric(self, x: Any) -> bool:\n        \"\"\"Return True if x is an int or float; numeric-like strings are treated as non-numeric per FR4.\"\"\"\n        return isinstance(x, (int, float))\n\ndef noprofit_noloss(amount1, amount2) -> bool:\n    \"\"\"Validate numeric inputs and return True if amount1 == amount2 else False.\n    Accepts int or float; raises TypeError for non-numeric inputs.\n    \"\"\"\n    validator = NumericInputValidator()\n    if not validator.is_numeric(amount1) or not validator.is_numeric(amount2):\n        raise TypeError(\"noprofit_noloss: amount1 and amount2 must be numeric (int or float)\")\n    \n    result_bool = float(amount1) == float(amount2)\n    return result_bool"}
{"task_id": "Mbpp/638", "solution": "import math\nfrom dataclasses import dataclass\n\n@dataclass\nclass Measurement:\n    wind_kmh: float\n    temp_c: float\n\n@dataclass\nclass WindChillResult:\n    raw_index: float\n    rounded_index: int\n\nclass WindChillCalculator:\n    \"\"\"\n    Encapsulates the calculation logic for the wind chill index.\n    \"\"\"\n    def calculateIndex(self, wind_kmh: float, temp_c: float) -> float:\n        \"\"\"\n        Calculates the raw wind chill index using the standard formula for\n        wind velocity in km/h and temperature in Celsius.\n        \"\"\"\n        # The standard formula (ISO 11079) for wind chill with T in Celsius and V in km/h.\n        # WC = 13.12 + 0.6215*T - 11.37*V^0.16 + 0.3965*T*V^0.16\n        wind_component = wind_kmh**0.16\n        raw_index = (13.12 +\n                     0.6215 * temp_c -\n                     11.37 * wind_component +\n                     0.3965 * temp_c * wind_component)\n        return raw_index\n\n    def wind_chill(self, wind_kmh: float, temp_c: float) -> int:\n        \"\"\"\n        Calculates the wind chill index from inputs, applying ceiling rounding.\n        \"\"\"\n        raw_index = self.calculateIndex(wind_kmh, temp_c)\n        rounded_index = math.ceil(raw_index)\n        _ = WindChillResult(raw_index=raw_index, rounded_index=int(rounded_index))\n        return int(rounded_index)\n\ndef wind_chill(wind_kmh: float, temp_c: float) -> int:\n    \"\"\"\n    Calculates the wind chill index rounded to the next integer given\n    wind velocity in km/h and temperature in Celsius.\n    \"\"\"\n    calculator = WindChillCalculator()\n    return calculator.wind_chill(wind_kmh, temp_c)"}
{"task_id": "Mbpp/639", "solution": "from typing import List\n\nclass Name:\n    \"\"\"Encapsulates a name string and provides methods for length and character checks.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the name string.\"\"\"\n        return len(self.value)\n\n    def startsWithLowercaseAscii(self) -> bool:\n        \"\"\"Checks if the name starts with an ASCII lowercase letter (a-z).\"\"\"\n        if not self.value:\n            return False\n        first_char = self.value[0]\n        return 'a' <= first_char <= 'z'\n\nclass SampleNamFunction:\n    \"\"\"Orchestrates the filtering and summation logic for names.\"\"\"\n    def sample_nam(self, names: List[str]) -> int:\n        \"\"\"Processes a list of names to sum lengths of filtered names.\"\"\"\n        name_objects = [Name(name_str) for name_str in names]\n        \n        filtered_names = [\n            name_obj for name_obj in name_objects\n            if not name_obj.startsWithLowercaseAscii()\n        ]\n        \n        total_length = sum(name_obj.length() for name_obj in filtered_names)\n        return total_length\n\ndef sample_nam(names: List[str]) -> int:\n    \"\"\"\n    Sums the length of names after removing those that start with a lowercase letter.\n    Names starting with 'a'-'z' are excluded.\n    \"\"\"\n    sf = SampleNamFunction()\n    return sf.sample_nam(names)"}
