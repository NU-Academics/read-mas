{"task_id": "Mbpp/259", "solution": "class Validator:\n    \"\"\"\n    Validates input tuple lengths and element shape/type, raising exceptions on failures.\n    \"\"\"\n    def validate_length(self, tuple1, tuple2) -> bool:\n        \"\"\"\n        Checks if the two input tuples have the same length.\n        \"\"\"\n        if len(tuple1) != len(tuple2):\n            raise ValueError(\"Input tuples must have the same length\")\n        return True\n\n    def validate_element_shape_and_types(self, input_tuple) -> bool:\n        \"\"\"\n        Checks if each element is a 2-tuple of numeric types (int or float).\n        \"\"\"\n        for element in input_tuple:\n            if not isinstance(element, tuple) or len(element) != 2:\n                raise TypeError(\"Each element must be a 2-tuple of numeric types\")\n            for component in element:\n                if not isinstance(component, (int, float)):\n                    raise TypeError(\"Each element must be a 2-tuple of numeric types\")\n        return True\n\nclass MaximizerFunction:\n    \"\"\"\n    Computes per-index maxima for two validated input tuples and assembles the output.\n    \"\"\"\n    def __init__(self, validator: Validator):\n        # The validator is passed but its methods are assumed to be called by the orchestrator.\n        self._validator = validator \n\n    def maximize(self, tuple1, tuple2) -> tuple:\n        \"\"\"\n        Assumes inputs are validated and computes component-wise maxima.\n        \"\"\"\n        result = []\n        for i in range(len(tuple1)):\n            max_first = max(tuple1[i][0], tuple2[i][0])\n            max_second = max(tuple1[i][1], tuple2[i][1])\n            result.append((max_first, max_second))\n        return tuple(result)\n\ndef maximize_elements(tuple1, tuple2) -> tuple:\n    \"\"\"\n    Orchestrates validation and computation to maximize elements of two tuples.\n    \"\"\"\n    validator = Validator()\n    validator.validate_length(tuple1, tuple2)\n    validator.validate_element_shape_and_types(tuple1)\n    validator.validate_element_shape_and_types(tuple2)\n    \n    maximizer = MaximizerFunction(validator)\n    return maximizer.maximize(tuple1, tuple2)"}
{"task_id": "Mbpp/264", "solution": "class DogAgeService:\n    \"\"\"Service to convert human years to dog years using a specific conversion factor.\"\"\"\n    _conversion_factor: float = 61 / 12\n\n    def dog_age(self, humanYears: float) -> int:\n        \"\"\"Converts human years to dog years, rounding the result to the nearest integer.\"\"\"\n        dog_years_float = humanYears * self._conversion_factor\n        return int(round(dog_years_float))\n\ndef dog_age(humanYears: float) -> int:\n    \"\"\"Calculates a dog's age in dog years from human years.\"\"\"\n    service = DogAgeService()\n    return service.dog_age(humanYears)"}
{"task_id": "Mbpp/261", "solution": "from typing import Tuple, List, Union, Any\nfrom dataclasses import dataclass\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for validation failures in the division_elements function.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass TupleInput:\n    \"\"\"Adapts an input for tuple-like access and validation.\"\"\"\n    def __init__(self, data: Any):\n        self.elements = data\n        self.is_tuple = isinstance(data, tuple)\n        self.length = len(data) if self.is_tuple else 0\n\n    def get_element(self, pos: int) -> Union[int, float]:\n        \"\"\"Returns the element at the specified position.\"\"\"\n        return self.elements[pos]\n\n@dataclass\nclass TupleElement:\n    \"\"\"Represents an element from a tuple with its value and position.\"\"\"\n    value: Union[int, float]\n    position: int\n\nclass QuotientResult:\n    \"\"\"Collects individual division quotients and can convert them to a tuple.\"\"\"\n    def __init__(self):\n        self._elements: List[Union[int, float]] = []\n\n    def append(self, value: Union[int, float]):\n        \"\"\"Adds a quotient value to the internal list.\"\"\"\n        self._elements.append(value)\n\n    def to_tuple(self) -> Tuple[Union[int, float], ...]:\n        \"\"\"Converts the collected quotients into an immutable tuple.\"\"\"\n        return tuple(self._elements)\n\nclass DivisionElementsFunction:\n    \"\"\"Orchestrates the validation and element-wise division of two tuples.\"\"\"\n    def __init__(self, first_raw: Tuple[Union[int, float], ...], second_raw: Tuple[Union[int, float], ...]):\n        self.first_input = TupleInput(first_raw)\n        self.second_input = TupleInput(second_raw)\n        self.result = QuotientResult()\n\n    def validate(self) -> None:\n        \"\"\"Validates input tuples for type, length, and zero divisors.\"\"\"\n        if not self.first_input.is_tuple or not self.second_input.is_tuple:\n            raise ValidationError(\"Inputs must be tuples.\")\n\n        if self.first_input.length != self.second_input.length:\n            raise ValidationError(\"Tuple lengths must be equal.\")\n\n        for i in range(self.second_input.length):\n            if self.second_input.get_element(i) == 0:\n                raise ValidationError(\"Divisor tuple cannot contain zero elements.\")\n\n    def compute(self) -> QuotientResult:\n        \"\"\"Performs element-wise division and stores results.\"\"\"\n        for i in range(self.first_input.length):\n            first_val = self.first_input.get_element(i)\n            second_val = self.second_input.get_element(i)\n            \n            raw_quotient = first_val / second_val\n\n            if raw_quotient % 1 == 0:\n                self.result.append(int(raw_quotient))\n            else:\n                self.result.append(raw_quotient)\n        \n        return self.result\n\ndef division_elements(first: Tuple[Union[int, float], ...], second: Tuple[Union[int, float], ...]) -> Tuple[Union[int, float], ...]:\n    \"\"\"\n    Performs element-wise division on two tuples, returning quotients as a tuple.\n    Quotients are integers if exact, otherwise floats.\n    \"\"\"\n    division_processor = DivisionElementsFunction(first, second)\n    division_processor.validate()\n    result = division_processor.compute()\n    return result.to_tuple()"}
{"task_id": "Mbpp/260", "solution": "import math\n\nclass PrimalityTester:\n    \"\"\"\n    Deterministically tests integers for primality using trial division.\n    \"\"\"\n    def is_prime(self, value: int) -> bool:\n        \"\"\"\n        Returns True if the value is prime, False otherwise.\n        \"\"\"\n        if value < 2:\n            return False\n        if value == 2:\n            return True\n        if value % 2 == 0:\n            return False\n        for i in range(3, int(math.isqrt(value)) + 1, 2):\n            if value % i == 0:\n                return False\n        return True\n\nclass InputValidator:\n    \"\"\"\n    Validates input parameters for the Newman\u2013Shanks\u2013Williams prime finder.\n    \"\"\"\n    def validate_positive_integer(self, n: int) -> None:\n        \"\"\"\n        Ensures n is a positive integer (n >= 1), raising a ValueError if invalid.\n        \"\"\"\n        if not isinstance(n, int) or n < 1:\n            raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\nclass SequenceTerm:\n    \"\"\"\n    A value object to hold a term of the Newman\u2013Shanks\u2013Williams sequence.\n    \"\"\"\n    def __init__(self, index: int, value: int, isPrime: bool = False):\n        self.index = index\n        self.value = value\n        self.isPrime = isPrime\n\nclass NSWSequence:\n    \"\"\"\n    Generates terms of the Newman\u2013Shanks\u2013Williams (NSW) sequence.\n    The sequence is defined by S(0)=1, S(1)=1, and S(k)=2*S(k-1)+S(k-2).\n    \"\"\"\n    S0 = 1\n    S1 = 1\n\n    def __init__(self):\n        # State for iterative generation\n        self._prev_val = self.S0 # Corresponds to S(k-2)\n        self._curr_val = self.S1 # Corresponds to S(k-1)\n        self._current_index = 0  # Current index k for S(k)\n\n    def generate_until_primes(self, count=None, primality_tester=None):\n        \"\"\"\n        An infinite generator yielding SequenceTerm objects for the NSW sequence.\n        The 'count' and 'primality_tester' parameters are unused by this generator,\n        as primality testing and counting are handled by the NewmanPrimeService.\n        \"\"\"\n        # Yield initial terms S(0) and S(1)\n        yield SequenceTerm(0, self.S0, False)\n        yield SequenceTerm(1, self.S1, False)\n\n        k = 2\n        while True:\n            next_val = 2 * self._curr_val + self._prev_val\n            yield SequenceTerm(k, next_val, False)\n            \n            self._prev_val = self._curr_val\n            self._curr_val = next_val\n            k += 1\n\nclass NewmanPrimeService:\n    \"\"\"\n    Orchestrates finding the nth Newman\u2013Shanks\u2013Williams prime number.\n    It coordinates input validation, sequence generation, and primality testing.\n    \"\"\"\n    def __init__(self, validator: InputValidator = None, generator: NSWSequence = None, tester: PrimalityTester = None):\n        self._validator = validator if validator is not None else InputValidator()\n        self._generator = generator if generator is not None else NSWSequence()\n        self._tester = tester if tester is not None else PrimalityTester()\n\n    def newman_prime(self, n: int) -> int:\n        \"\"\"\n        Finds the nth Newman\u2013Shanks\u2013Williams prime number.\n        \"\"\"\n        self._validator.validate_positive_integer(n)\n\n        primes_found_count = 0\n        for term in self._generator.generate_until_primes():\n            if self._tester.is_prime(term.value):\n                primes_found_count += 1\n                if primes_found_count == n:\n                    return term.value\n        \n        # This line should theoretically not be reached as there are infinitely many NSW numbers\n        # and likely infinitely many NSW primes, for practical n.\n        raise RuntimeError(\"Could not find the nth Newman-Shanks-Williams prime.\")\n\n# Create a global instance of the service to manage state and dependencies\n_nps_service = NewmanPrimeService()\n\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman\u2013Shanks\u2013Williams prime number.\n    \"\"\"\n    return _nps_service.newman_prime(n)"}
{"task_id": "Mbpp/262", "solution": "from typing import List, Tuple, Any\n\ndef split_two_parts(input_list: List[Any], L: int) -> Tuple[List[Any], List[Any]]:\n    \"\"\"Splits a list into two parts: the first of length L, and the remainder.\n    Returns the parts as a tuple of lists, preserving original order.\"\"\"\n    first_part = input_list[:L]\n    second_part = input_list[L:]\n    return (first_part, second_part)"}
{"task_id": "Mbpp/265", "solution": "```python\ndef list_split(input_list, n):\n    \"\"\"Splits a list into n sublists based on element index modulo n.\n\n    Each sublist i contains elements from the original list at indices i, i+n, i+2n, etc.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    result = [[] for _ in range(n)]\n    for p in range(len(input_list)):\n        i = p % n\n        result[i].append(input_list[p])\n    return result\n```"}
{"task_id": "Mbpp/266", "solution": "class InputValidator:\n    \"\"\"Provides utility methods for validating input values.\"\"\"\n    @staticmethod\n    def is_numeric(value) -> bool:\n        \"\"\"Returns True if the value is an int or float.\"\"\"\n        return isinstance(value, (int, float))\n\n    @staticmethod\n    def is_non_negative(value) -> bool:\n        \"\"\"Returns True if the numeric value is non-negative.\"\"\"\n        return InputValidator.is_numeric(value) and value >= 0\n\nclass Cube:\n    \"\"\"A simple domain DTO representing a cube.\"\"\"\n    def __init__(self, side: float):\n        self.side = side\n\nclass CalculationResult:\n    \"\"\"A domain DTO holding the computed lateral_area.\"\"\"\n    def __init__(self, lateral_area: float):\n        self.lateral_area = lateral_area\n\nclass LateralSurfaceCalculator:\n    \"\"\"Encapsulates the computation of a cube's lateral surface area.\"\"\"\n    @staticmethod\n    def compute_lateral_area(side: float) -> CalculationResult:\n        \"\"\"Computes the lateral surface area as 4 * side * side and wraps it in a CalculationResult DTO.\"\"\"\n        area = 4 * side * side\n        return CalculationResult(lateral_area=area)\n\ndef lateralsurface_cube(side):\n    \"\"\"\n    Public API: validate and compute lateral surface area for cube side.\n    Raises TypeError if side is not numeric.\n    \"\"\"\n    if not InputValidator.is_numeric(side):\n        raise TypeError(\"Side length must be a numeric value (int or float).\")\n    \n    calculation_result_dto = LateralSurfaceCalculator.compute_lateral_area(side)\n    return calculation_result_dto.lateral_area"}
{"task_id": "Mbpp/267", "solution": "def compute_by_formula(n: int) -> int:\n    \"\"\"\n    Computes the sum of squares of the first n odd natural numbers using a closed-form formula.\n    \"\"\"\n    return (n * (4*n*n - 1)) // 3\n\ndef square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the squares of the first n odd natural numbers.\n    Returns 0 if n is less than or equal to 0.\n    \"\"\"\n    if n <= 0:\n        return 0\n    return compute_by_formula(n)\n\nassert square_Sum(2) == 10"}
{"task_id": "Mbpp/269", "solution": "class InputError(Exception):\n    \"\"\"Exception raised for invalid input to ascii_value function.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass CharacterInput:\n    \"\"\"Encapsulates input validation for a single-character string.\"\"\"\n    def __init__(self, value: object):\n        self.value = value\n\n    def validate(self) -> None:\n        \"\"\"Validates that the input is a single-character string, raising InputError if not.\"\"\"\n        if not isinstance(self.value, str) or len(self.value) != 1:\n            raise InputError(\"input must be a single-character string\")\n\ndef ascii_value(char) -> int:\n    \"\"\"\n    Returns the Unicode code point of a single-character string.\n    For ASCII characters (0-127), this corresponds to the ASCII value.\n    \"\"\"\n    character_input = CharacterInput(char)\n    character_input.validate()\n    return ord(char)"}
{"task_id": "Mbpp/268", "solution": "from typing import Optional\n\nclass InputParameter:\n    \"\"\"Data holder for the integer input n.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\nclass CalculationResult:\n    \"\"\"Data holder for computed star number value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass Validator:\n    \"\"\"Stateless validator enforcing n is integer and n >= 1.\"\"\"\n    def isPositiveInteger(self, n: int) -> bool:\n        \"\"\"Returns True if n is a positive integer (n >= 1), else False.\"\"\"\n        return isinstance(n, int) and n >= 1\n\nclass StarNumberCalculator:\n    \"\"\"Validates input via Validator and computes S(n) using formula.\"\"\"\n    def __init__(self, validator: Optional[Validator] = None):\n        self._validator = validator if validator is not None else Validator()\n\n    def find_star_num(self, n: int) -> int:\n        \"\"\"Delegates validation and computation of the nth star number.\"\"\"\n        if not self._validator.isPositiveInteger(n):\n            raise ValueError(\"invalid input: n must be integer >= 1\")\n        return self._computeUsingFormula(n)\n\n    def _computeUsingFormula(self, n: int) -> int:\n        \"\"\"Computes the star number S(n) = 6 * n * (n - 1) + 1.\"\"\"\n        return 6 * n * (n - 1) + 1\n\n_default_calculator = StarNumberCalculator()\n\ndef find_star_num(n: int) -> int:\n    \"\"\"\n    Finds the n'th star number.\n    Delegates to an internal calculator instance for validation and computation.\n    \"\"\"\n    return _default_calculator.find_star_num(n)"}
