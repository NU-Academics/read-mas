{"task_id": "Mbpp/560", "solution": "from typing import List\n\nclass TupleInput:\n    \"\"\"Wraps an input tuple and stores its elements as a list.\"\"\"\n    def __init__(self, data: tuple):\n        self.elements: List[int] = list(data)\n\nclass SetOperator:\n    \"\"\"Provides a method to remove duplicate elements from a list.\"\"\"\n    def removeDuplicates(self, elements: List[int]) -> List[int]:\n        return list(set(elements))\n\nclass Sorter:\n    \"\"\"Provides a method to sort a list in ascending order.\"\"\"\n    def sortAsc(self, elements: List[int]) -> List[int]:\n        return sorted(elements)\n\nclass TupleResult:\n    \"\"\"Holds a list of elements and provides a method to convert it to a tuple.\"\"\"\n    def __init__(self, elements: List[int]):\n        self.elements: List[int] = elements\n\n    def toTuple(self) -> tuple:\n        return tuple(self.elements)\n\nclass UnionFunction:\n    \"\"\"Orchestrates the process of computing the union of two TupleInput instances.\"\"\"\n    def computeUnion(self, t1: TupleInput, t2: TupleInput) -> TupleResult:\n        combined_list = t1.elements + t2.elements\n        \n        set_operator = SetOperator()\n        unique_list = set_operator.removeDuplicates(combined_list)\n        \n        sorter = Sorter()\n        sorted_list = sorter.sortAsc(unique_list)\n        \n        return TupleResult(sorted_list)\n\ndef union_elements(t1, t2) -> tuple:\n    \"\"\"\n    Finds the union of elements from two given tuples and outputs them in sorted order.\n    Assumes valid tuple inputs containing comparable elements.\n    \"\"\"\n    t1_input = TupleInput(t1)\n    t2_input = TupleInput(t2)\n    \n    union_func = UnionFunction()\n    result_obj = union_func.computeUnion(t1_input, t2_input)\n    \n    return result_obj.toTuple()"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(list_a, list_b) -> bool:\n    \"\"\"Return True if list_b is a contiguous sublist of list_a, else False.\n    Comparison uses Python's == operator for elements.\n    \"\"\"\n    len_a = len(list_a)\n    len_b = len(list_b)\n\n    if len_b == 0:\n        return True\n    if len_b > len_a:\n        return False\n\n    for i in range(len_a - len_b + 1):\n        if list_a[i : i + len_b] == list_b:\n            return True\n    return False"}
{"task_id": "Mbpp/577", "solution": "def validate_type(n):\n    \"\"\"Raises TypeError if n is not an integer.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n\ndef validate_non_negative(n):\n    \"\"\"Raises ValueError if n is negative.\"\"\"\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\ndef compute_small_factorial_last_digit(n):\n    \"\"\"Computes the last digit of n! for 1 <= n <= 9.\"\"\"\n    product = 1\n    for i in range(1, n + 1):\n        product *= i\n    return product % 10\n\ndef last_Digit_Factorial(n):\n    \"\"\"\n    Finds the last decimal digit of n!.\n    Validates input and optimizes for n >= 10.\n    \"\"\"\n    validate_type(n)\n    validate_non_negative(n)\n\n    if n == 0:\n        return 1\n    elif n >= 10:\n        return 0\n    else: # 1 <= n <= 9\n        return compute_small_factorial_last_digit(n)"}
{"task_id": "Mbpp/563", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass InputString:\n    \"\"\"Holds the raw input string and its length.\"\"\"\n    raw: str\n    length: int\n\n@dataclass\nclass QuotedValue:\n    \"\"\"Represents an extracted quoted value along with its positions.\"\"\"\n    value: str\n    start_pos: int\n    end_pos: int\n\n@dataclass\nclass ResultList:\n    \"\"\"Aggregates extracted string values.\"\"\"\n    values: List[str]\n\n    def count(self) -> int:\n        return len(self.values)\n\ndef _parse_quoted_substrings(raw: str) -> List[QuotedValue]:\n    \"\"\"\n    Scans the raw string for substrings enclosed in double quotes.\n    Creates QuotedValue objects for each found, ignoring unmatched quotes.\n    \"\"\"\n    quoted_values = []\n    in_quote = False\n    start_index = -1\n    \n    i = 0\n    while i < len(raw):\n        if raw[i] == '\"':\n            if not in_quote:\n                # Found opening quote\n                start_index = i + 1\n                in_quote = True\n            else:\n                # Found closing quote\n                value = raw[start_index:i]\n                quoted_values.append(QuotedValue(value=value, start_pos=start_index, end_pos=i))\n                in_quote = False\n                start_index = -1\n        i += 1\n    \n    return quoted_values\n\ndef extract_values(input: str) -> List[str]:\n    \"\"\"\n    Extracts values between double quotation marks from a string.\n    Returns them in a list, preserving order and stripping the quotes.\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"Input must be a string.\")\n\n    input_str_obj = InputString(raw=input, length=len(input))\n    \n    quoted_values_objects = _parse_quoted_substrings(input_str_obj.raw)\n    \n    result_list = ResultList(values=[q.value for q in quoted_values_objects])\n    \n    return result_list.values"}
