{"task_id": "Mbpp/130", "solution": "from typing import Any, List, Dict, Optional\n\nclass Element:\n    \"\"\"Wraps a raw value and provides equality/hash semantics for frequency mapping.\"\"\"\n    def __init__(self, value: Any):\n        self._value = value\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, Element):\n            return NotImplemented\n        return self._value == other._value\n\n    def __hash__(self) -> int:\n        return hash(self._value)\n\n    @property\n    def value(self) -> Any:\n        return self._value\n\nclass InputList:\n    \"\"\"Represents the input sequence of elements as a domain object.\"\"\"\n    def __init__(self, raw_list: List[Any]):\n        self._elements: List[Element] = [Element(item) for item in raw_list]\n\n    def size(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self._elements)\n\n    def get(self, index: int) -> Element:\n        \"\"\"Returns the element at the specified index.\"\"\"\n        return self._elements[index]\n\nclass FrequencyCounter:\n    \"\"\"Builds frequency mapping and selects the element with maximum occurrences.\"\"\"\n\n    def buildFrequency(self, input: InputList) -> Dict[Element, int]:\n        \"\"\"Builds and returns a map of Element -> count for the input list.\"\"\"\n        freq_map: Dict[Element, int] = {}\n        for i in range(input.size()):\n            element = input.get(i)\n            freq_map[element] = freq_map.get(element, 0) + 1\n        return freq_map\n\n    def maxOccurrence(self, input: InputList) -> Optional[Element]:\n        \"\"\"\n        Returns a single Element that has the highest frequency in the input list.\n        If the input list is empty, returns None. For ties, it returns the element\n        encountered first in the frequency map iteration.\n        \"\"\"\n        freq_map = self.buildFrequency(input)\n        if not freq_map:\n            return None\n\n        # Find the element with the maximum frequency based on its count.\n        # Python's max() on a dict (keys) with a key function for values will return\n        # the key corresponding to the maximum value, resolving ties based on\n        # insertion order (or the first encountered for pre-3.7 dicts).\n        max_element = max(freq_map, key=freq_map.get)\n        return max_element\n\nclass Result:\n    \"\"\"Encapsulates the Element chosen as the result of FrequencyCounter.maxOccurrence.\"\"\"\n    def __init__(self, element: Element):\n        self._element = element\n\n    def get(self) -> Element:\n        \"\"\"Returns the encapsulated Element.\"\"\"\n        return self._element\n\ndef max_occurrences(input_list: list) -> Any:\n    \"\"\"\n    Finds the item with maximum frequency in a given list.\n    \"\"\"\n    input_domain = InputList(input_list)\n    counter = FrequencyCounter()\n    result_element = counter.maxOccurrence(input_domain)\n\n    if result_element is None:\n        return None\n    return result_element.value"}
{"task_id": "Mbpp/131", "solution": "from dataclasses import dataclass\nfrom typing import Tuple\n\n@dataclass\nclass InputString:\n    \"\"\"Lightweight data holder for the input string and derived length.\"\"\"\n    value: str\n\n    def __post_init__(self):\n        self.length = len(self.value)\n\n@dataclass\nclass OutputString:\n    \"\"\"Lightweight data holder for the output string value.\"\"\"\n    value: str\n\nclass VowelSet:\n    \"\"\"Encapsulates the set of recognized vowels and membership test.\"\"\"\n    vowels: Tuple[str, ...] = ('a','e','i','o','u','A','E','I','O','U')\n\n    def is_vowel(self, ch: str) -> bool:\n        \"\"\"Checks if a character is a vowel.\"\"\"\n        return ch in self.vowels\n\n    def __contains__(self, ch: str) -> bool:\n        \"\"\"Allows 'in' operator for vowel checking.\"\"\"\n        return self.is_vowel(ch)\n\nclass ReverseVowelsFunction:\n    \"\"\"Implements the vowel-reversal algorithm, consuming InputString and producing OutputString.\"\"\"\n    vowel_set = VowelSet() # A class-level instance for efficient reuse.\n\n    @staticmethod\n    def reverse_vowels(input: str) -> str:\n        \"\"\"\n        Reverses only the vowels of the given string, where 'y' is not a vowel.\n        Preserves case and character values of vowels.\n        \"\"\"\n        if not input:\n            return \"\"\n\n        vowels_in_order = []\n        original_vowel_indices = []\n        for i, char in enumerate(input):\n            if ReverseVowelsFunction.vowel_set.is_vowel(char):\n                vowels_in_order.append(char)\n                original_vowel_indices.append(i)\n\n        if not vowels_in_order:\n            return input\n\n        output_chars = list(input)\n        reversed_vowels_iter = iter(vowels_in_order[::-1])\n\n        for idx in original_vowel_indices:\n            output_chars[idx] = next(reversed_vowels_iter)\n            \n        return \"\".join(output_chars)\n\ndef reverse_vowels(input: str) -> str:\n    \"\"\"\n    Reverses only the vowels of a given string (where y is not a vowel).\n    assert reverse_vowels(\"Python\") == \"Python\"\n    \"\"\"\n    return ReverseVowelsFunction.reverse_vowels(input)"}
{"task_id": "Mbpp/135", "solution": "def hexagonal_num(n: int) -> int:\n    \"\"\"Compute the nth hexagonal number using the formula H(n) = n * (2 * n - 1).\n    Assumes n is an integer and n >= 1.\n    \"\"\"\n    return n * (2 * n - 1)"}
{"task_id": "Mbpp/133", "solution": "class NegativeNumber:\n    \"\"\"Represents a single numeric value with a check for negativity.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def is_negative(self) -> bool:\n        \"\"\"Checks if the value is strictly less than zero.\"\"\"\n        return self.value < 0\n\nclass NumberList:\n    \"\"\"Encapsulates a list of numbers and provides filtering capabilities.\"\"\"\n    def __init__(self, numbers: list) -> None:\n        self.numbers = numbers\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the list of numbers is empty.\"\"\"\n        return not self.numbers\n\n    def get_negative_numbers(self) -> list:\n        \"\"\"Returns a list of numbers that are strictly negative.\"\"\"\n        return [num for num in self.numbers if NegativeNumber(num).is_negative()]\n\nclass SumResult:\n    \"\"\"A value object representing a computed sum.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def as_int(self) -> int:\n        \"\"\"Returns the sum as an integer.\"\"\"\n        return int(self.value)\n\n    def as_float(self) -> float:\n        \"\"\"Returns the sum as a float.\"\"\"\n        return float(self.value)\n\ndef sum_negativenum(numbers: list) -> float:\n    \"\"\"\n    Calculates the sum of the negative numbers of a given list of numbers.\n    Returns 0.0 if the list is empty or contains no negative numbers.\n    \"\"\"\n    number_list_obj = NumberList(numbers)\n    negative_values = number_list_obj.get_negative_numbers()\n\n    if not negative_values:\n        return 0.0\n\n    total_sum = sum(negative_values)\n    # The design suggests an internal SumResult object, but the public API returns a numeric value.\n    # sum_result_obj = SumResult(total_sum)\n    return float(total_sum)"}
{"task_id": "Mbpp/137", "solution": "from typing import List\n\nclass ValidationError(Exception):\n    \"\"\"Raised when the input array or its elements are invalid.\"\"\"\n    pass\n\nclass DivisionByZeroError(Exception):\n    \"\"\"Raised when the count of non-zero elements is zero, preventing division.\"\"\"\n    pass\n\nclass ArrayInput:\n    \"\"\"Encapsulates and validates the input list of integers.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self.elements = elements\n\n    def validate(self) -> None:\n        \"\"\"Validates that the input is a list of integers, raising ValidationError if not.\"\"\"\n        if not isinstance(self.elements, list):\n            raise ValidationError(\"Input must be a list.\")\n        for element in self.elements:\n            if not isinstance(element, int):\n                raise ValidationError(\"All elements in the list must be integers.\")\n\nclass ZeroCountResult:\n    \"\"\"Holds the computed counts of zeros, non-zeros, and their ratio.\"\"\"\n    def __init__(self, zeros: int, nonZeros: int, ratio: float) -> None:\n        self.zeros = zeros\n        self.nonZeros = nonZeros\n        self.ratio = ratio\n\ndef zero_count(elements: List[int]) -> float:\n    \"\"\"\n    Calculates the ratio of zeroes to non-zeroes in a list of integers.\n\n    Validates the input, counts zeroes and non-zeroes, then returns their ratio as a float.\n    \"\"\"\n    array_input = ArrayInput(elements)\n    array_input.validate()\n\n    zeros = 0\n    nonZeros = 0\n\n    for element in elements:\n        if element == 0:\n            zeros += 1\n        else:\n            nonZeros += 1\n\n    if nonZeros == 0:\n        raise DivisionByZeroError(\"Cannot compute ratio: no non-zero elements to divide by.\")\n\n    ratio = float(zeros) / nonZeros\n    # The design mentioned instantiating ZeroCountResult for clarity/traceability, but it's not strictly\n    # necessary for the return value and could be omitted for simplicity. Keeping it for design adherence.\n    _ = ZeroCountResult(zeros, nonZeros, ratio) \n    \n    return ratio"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(n) -> bool:\n    \"\"\"Return True if integer n can be represented as a sum of one or more non-zero powers of two (2^k where k >= 1); otherwise False.\"\"\"\n    if n < 2:\n        return False\n    return n % 2 == 0"}
{"task_id": "Mbpp/140", "solution": "from typing import Sequence, Iterable, Set\n\ndef extract_singly(input_list: Iterable[Sequence[int]]) -> Set[int]:\n    \"\"\"\n    Flattens a list of inner sequences (lists or tuples) of integers into a single set of distinct integers.\n    Returns an empty set if the input list is empty.\n    \"\"\"\n    output_set: Set[int] = set()\n    for inner_sequence in input_list:\n        for item in inner_sequence:\n            output_set.add(item)\n    return output_set"}
{"task_id": "Mbpp/139", "solution": "import math\n\nPI = math.pi\n\ndef circle_circumference(radius):\n    \"\"\"Compute the circumference of a circle.\n\n    Parameters:\n    - radius (int | float): The circle radius.\n\n    Returns:\n    - float: circumference computed as 2 * PI * radius\n    \"\"\"\n    result = 2 * PI * radius\n    return float(result)"}
{"task_id": "Mbpp/141", "solution": "class PancakeSorter:\n    \"\"\"Helper class to encapsulate the pancake sort algorithm's operations.\"\"\"\n\n    def find_max_index(self, lst: list, n: int) -> int:\n        \"\"\"Returns the index of the maximum element in the prefix lst[0:n].\"\"\"\n        max_idx = 0\n        for i in range(1, n):\n            if lst[i] > lst[max_idx]:\n                max_idx = i\n        return max_idx\n\n    def flip(self, lst: list, k: int) -> None:\n        \"\"\"Reverses the prefix lst[0:k] in-place.\"\"\"\n        start = 0\n        end = k - 1\n        while start < end:\n            lst[start], lst[end] = lst[end], lst[start]\n            start += 1\n            end -= 1\n\n    def pancake_sort(self, lst: list) -> list:\n        \"\"\"Sorts the given list in-place using pancake sort algorithm and returns it.\"\"\"\n        n = len(lst)\n\n        if n <= 1:\n            return lst\n\n        for current_size in range(n, 1, -1):\n            max_idx = self.find_max_index(lst, current_size)\n\n            if max_idx != current_size - 1:\n                if max_idx != 0:\n                    self.flip(lst, max_idx + 1)\n                self.flip(lst, current_size)\n        \n        return lst\n\ndef pancake_sort(lst: list) -> list:\n    \"\"\"Sorts a list of elements using the pancake sort algorithm.\"\"\"\n    temp_lst = list(lst)\n    sorter = PancakeSorter()\n    return sorter.pancake_sort(temp_lst)"}
{"task_id": "Mbpp/142", "solution": "from typing import List, Any\n\nclass InputList:\n    \"\"\"Wraps a list to provide length and indexed access.\"\"\"\n    def __init__(self, items: List[Any]) -> None:\n        self._items = items\n\n    def length(self) -> int:\n        return len(self._items)\n\n    def get(self, index: int) -> Any:\n        return self._items[index]\n\nclass Result:\n    \"\"\"Holds the integer count of identical positions.\"\"\"\n    def __init__(self, count: int) -> None:\n        self._count = count\n\n    def to_int(self) -> int:\n        return self._count\n\nclass CountSamePair:\n    \"\"\"Encapsulates the algorithm for counting identical items.\"\"\"\n    def computeMinLength(self, list1: InputList, list2: InputList, list3: InputList) -> int:\n        return min(list1.length(), list2.length(), list3.length())\n\n    def compareAtIndex(self, a: InputList, b: InputList, c: InputList, index: int) -> bool:\n        return a.get(index) == b.get(index) == c.get(index)\n\n    def count_samepair(self, list1: InputList, list2: InputList, list3: InputList) -> Result:\n        match_count = 0\n        min_length = self.computeMinLength(list1, list2, list3)\n\n        for i in range(min_length):\n            if self.compareAtIndex(list1, list2, list3, i):\n                match_count += 1\n        \n        return Result(match_count)\n\ndef count_samepair(list1: List[Any], list2: List[Any], list3: List[Any]) -> int:\n    \"\"\"\n    Counts the number of items that are identical in the same position\n    across three given lists.\n    \"\"\"\n    il1 = InputList(list1)\n    il2 = InputList(list2)\n    il3 = InputList(list3)\n\n    csp_calculator = CountSamePair()\n    result = csp_calculator.count_samepair(il1, il2, il3)\n\n    return result.to_int()"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(source: list, removal: list) -> list:\n    \"\"\"Return a new list containing elements from 'source' not present in 'removal'.\n    The relative order of elements from the source list is preserved.\n    \"\"\"\n    removal_set = set(removal)\n    result_list = []\n    for item in source:\n        if item not in removal_set:\n            result_list.append(item)\n    return result_list"}
{"task_id": "Mbpp/145", "solution": "from numbers import Real\n\ndef max_Abs_Diff(sequence):\n    \"\"\"Validate sequence and return maximum absolute difference between any two elements.\n\n    Raises:\n        ValueError: if sequence has fewer than two elements.\n        TypeError: if any element is not numeric.\n    \"\"\"\n    class Validator:\n        def check_length(self, sequence):\n            if len(sequence) < 2:\n                raise ValueError(\"sequence must contain at least two elements\")\n\n        def check_numeric(self, sequence):\n            for x in sequence:\n                if not isinstance(x, Real):\n                    raise TypeError(\"all elements must be numeric\")\n\n    class MinMaxCalculator:\n        def compute(self, sequence):\n            # Single-pass O(n) / O(1) extra space algorithm.\n            it = iter(sequence)\n            first = next(it)\n            current_min = current_max = first\n            for x in it:\n                if x < current_min:\n                    current_min = x\n                if x > current_max:\n                    current_max = x\n            return current_max - current_min\n\n    validator = Validator()\n    validator.check_length(sequence)\n    validator.check_numeric(sequence)\n    return MinMaxCalculator().compute(sequence)"}
{"task_id": "Mbpp/162", "solution": "def generate_terms(n: int) -> list[int]:\n    \"\"\"\n    Produces a list of positive terms for the series (n - 2*i).\n    Terms are generated for i from 0 up to n // 2.\n    \"\"\"\n    terms = []\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        if term > 0:\n            terms.append(term)\n        else:\n            # Since terms are decreasing, any subsequent terms will also not be positive.\n            break\n    return terms\n\n\ndef sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) for i=0 to n//2,\n    including only terms greater than zero. Returns 0 if n is not positive.\n    \"\"\"\n    if n <= 0:\n        return 0\n    \n    terms = generate_terms(n)\n    return sum(terms)"}
{"task_id": "Mbpp/166", "solution": "class Element:\n    \"\"\"Represents an individual element and exposes type/parity checks.\"\"\"\n    def __init__(self, value: int):\n        self.value: int = value\n    def isInteger(self) -> bool:\n        \"\"\"Checks if the element's value is a strict integer.\"\"\"\n        return isinstance(self.value, int)\n    def isEven(self) -> bool:\n        \"\"\"Checks if the element's value is even.\"\"\"\n        return (self.value % 2) == 0\n\nclass InputList:\n    \"\"\"Encapsulates the input list, providing validation and length.\"\"\"\n    def __init__(self, values: list):\n        self.values: list[int] = values\n    def validate(self) -> None:\n        \"\"\"Validates that all elements in the list are integers.\"\"\"\n        for val in self.values:\n            element = Element(val)\n            if not element.isInteger():\n                raise TypeError(f\"List element '{val}' is not an integer.\")\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.values)\n\nclass PairCounter:\n    \"\"\"Counts unordered index pairs in an InputList for which XOR is even.\"\"\"\n    def countPairs(self, input_list: InputList) -> int:\n        \"\"\"Counts pairs of elements whose XOR is even using parity counts.\"\"\"\n        even_count = 0\n        odd_count = 0\n        for val in input_list.values:\n            element = Element(val)\n            if element.isEven():\n                even_count += 1\n            else:\n                odd_count += 1\n        \n        pairs = 0\n        if even_count >= 2:\n            pairs += even_count * (even_count - 1) // 2\n        if odd_count >= 2:\n            pairs += odd_count * (odd_count - 1) // 2\n        \n        return pairs\n\n    def xorIsEven(self, a: int, b: int) -> bool:\n        \"\"\"Checks if the XOR of two integers is even.\"\"\"\n        return (a % 2) == (b % 2)\n\nclass Result:\n    \"\"\"Value object encapsulating the resulting count.\"\"\"\n    def __init__(self, count: int):\n        self.count: int = count\n\ndef find_even_pair(list_of_integers) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that xor to an even number.\n    assert find_even_pair([5, 4, 7, 2, 1]) == 4\n    \"\"\"\n    input_list = InputList(values=list_of_integers)\n    input_list.validate()\n    \n    if input_list.length() < 2:\n        return 0\n    \n    pair_counter = PairCounter()\n    count = pair_counter.countPairs(input_list)\n    \n    return count"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a, b, n):\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple,\n    or returns None if no solution exists.\n    \"\"\"\n\n    # Helper function for Euclidean algorithm (always returns non-negative gcd)\n    def _gcd(num1, num2):\n        while num2:\n            num1, num2 = num2, num1 % num2\n        return abs(num1)\n\n    # Helper function for extended Euclidean algorithm\n    # Returns (g, x, y) such that a*x + b*y = g, where g is gcd(a, b) and g >= 0.\n    def _extended_gcd(num1, num2):\n        if num1 == 0:\n            # Base case: gcd(0, num2) = abs(num2).\n            # Equation: 0*x + num2*y = abs(num2).\n            # x can be anything, choose 0. y is 1 if num2>0, -1 if num2<0. If num2=0, y=1 (or any value).\n            if num2 == 0:\n                return 0, 0, 1 # gcd(0,0)=0, 0*0 + 0*1 = 0\n            return abs(num2), 0, (1 if num2 >= 0 else -1)\n\n        g, x, y = _extended_gcd(num2 % num1, num1)\n        # g = gcd(num2 % num1, num1)\n        # From recursive call: (num2 % num1)*x + num1*y = g\n        # Substitute num2 % num1 = num2 - (num2 // num1)*num1:\n        # (num2 - (num2 // num1)*num1)*x + num1*y = g\n        # num2*x + num1*(y - (num2 // num1)*x) = g\n        # So for num1*X + num2*Y = g, we have X = y - (num2 // num1)*x, Y = x\n        return g, y - (num2 // num1) * x, x\n\n    # --- Handle Zero Coefficients Special Cases ---\n    if a == 0 and b == 0:\n        if n == 0:\n            return (0, 0) # 0*x + 0*y = 0, (0,0) is a valid solution\n        else:\n            return None # 0*x + 0*y = n (n != 0) has no solution\n\n    if a == 0: # Equation is b*y = n\n        if n % b == 0:\n            return (0, n // b) # x can be any integer, choose 0\n        else:\n            return None\n\n    if b == 0: # Equation is a*x = n\n        if n % a == 0:\n            return (n // a, 0) # y can be any integer, choose 0\n        else:\n            return None\n\n    # --- General Case: a != 0 and b != 0 ---\n    g, x0, y0 = _extended_gcd(a, b)\n\n    # Check for solvability (n must be divisible by g)\n    if n % g != 0:\n        return None\n\n    # Scale the particular solution (x0, y0) to match n\n    k = n // g\n    x_p = x0 * k\n    y_p = y0 * k\n\n    # Normalize the solution to a canonical form.\n    # The general solution is x = x_p + (b//g)*t, y = y_p - (a//g)*t for integer t.\n    # We want x in the range [0, abs(b//g) - 1].\n    \n    B_eff = b // g # Coefficient for t in the x equation\n    \n    # The period for x values is abs(B_eff). Since b != 0, B_eff cannot be 0 here.\n    period_x = abs(B_eff)\n\n    # Calculate t to shift x_p into the target range [0, period_x - 1].\n    # x_p + B_eff * t should be equivalent to x_p % period_x (non-negative remainder).\n    # t = ( (x_p % period_x) - x_p ) // B_eff\n    x_target_remainder = x_p % period_x\n    t = (x_target_remainder - x_p) // B_eff\n    \n    x = x_p + B_eff * t\n    y = y_p - (a // g) * t\n\n    return (x, y)"}
{"task_id": "Mbpp/165", "solution": "import typing\n\nclass InputString:\n    def __init__(self, raw: str):\n        self.raw = raw\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the raw string.\"\"\"\n        return len(self.raw)\n\n    def char_at(self, position: int) -> str:\n        \"\"\"Returns the character at the 1-based position.\"\"\"\n        return self.raw[position - 1]\n\nclass Alphabet:\n    def __init__(self):\n        # Create a mapping from 'a' through 'z' to 1 through 26.\n        self.index_map = {chr(ord('a') + i): i + 1 for i in range(26)}\n\n    def index_of(self, c: str) -> typing.Optional[int]:\n        \"\"\"Returns the 1-based alphabet index of a lowercase letter, or None if not found.\"\"\"\n        return self.index_map.get(c)\n\nclass Character:\n    def __init__(self, value: str):\n        self.value = value\n\n    def is_alpha(self) -> bool:\n        \"\"\"Checks if the character is a single ASCII alphabetic letter.\"\"\"\n        return len(self.value) == 1 and self.value.isalpha() and self.value.isascii()\n\n    def to_lower(self) -> str:\n        \"\"\"Returns the lowercase version of the character.\"\"\"\n        return self.value.lower()\n\n    def alphabet_index(self) -> typing.Optional[int]:\n        \"\"\"Returns the 1-based alphabet index if it's an ASCII letter, otherwise None.\"\"\"\n        if not self.is_alpha():\n            return None\n        return ord(self.to_lower()) - ord('a') + 1\n\nclass Result:\n    def __init__(self, count: int = 0):\n        self.count = count\n\nclass PositionCalculator:\n    def __init__(self, alphabet: Alphabet = None):\n        self.alphabet = alphabet if alphabet is not None else Alphabet()\n\n    def matches(self, character: Character, position: int) -> bool:\n        \"\"\"Determines if a character matches its 1-based alphabet position.\"\"\"\n        if not character.is_alpha():\n            return False\n        char_alphabet_index = self.alphabet.index_of(character.to_lower())\n        return char_alphabet_index == position\n\n    def char_matches_at_position(self, input_string: InputString) -> int:\n        \"\"\"Counts characters that match their 1-based alphabet position within the specified range.\"\"\"\n        match_count = 0\n        max_pos_to_check = min(26, input_string.length())\n        for position in range(1, max_pos_to_check + 1):\n            char_str = input_string.char_at(position)\n            character_obj = Character(char_str)\n            if self.matches(character_obj, position):\n                match_count += 1\n        return match_count\n\nclass CountFunction:\n    def __init__(self, position_calculator: PositionCalculator = None):\n        self.position_calculator = position_calculator if position_calculator is not None else PositionCalculator()\n\n    def count_char_position(self, input_string: InputString) -> Result:\n        \"\"\"Orchestrates counting character position matches using PositionCalculator and returns a Result object.\"\"\"\n        count = self.position_calculator.char_matches_at_position(input_string)\n        return Result(count)\n\ndef count_char_position(s: str) -> int:\n    \"\"\"\n    Counts characters in a string that occur at the same position in the string\n    as in the English alphabet (case insensitive).\n    \"\"\"\n    input_string = InputString(s)\n    \n    alphabet_instance = Alphabet()\n    position_calculator_instance = PositionCalculator(alphabet_instance)\n    count_function_instance = CountFunction(position_calculator_instance)\n\n    result = count_function_instance.count_char_position(input_string)\n    return result.count"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n):\n    \"\"\"\n    Finds the smallest power of two greater than or equal to n.\n    Handles arbitrary-precision integers and raises TypeError for non-integer input.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be int\")\n\n    if n <= 1:\n        return 1\n\n    # Check if n is already a power of two\n    if (n & (n - 1)) == 0:\n        return n\n\n    # Find the number of bits required to represent n, then left shift 1 by that amount\n    # This gives the smallest power of 2 strictly greater than n-1 (and thus >= n)\n    k = n.bit_length()\n    return 1 << k"}
