{"task_id": "Mbpp/6", "solution": "def count_set_bits(value: int) -> int:\n    \"\"\"Return number of set bits in non-negative int value (used internally).\"\"\"\n    count = 0\n    while value > 0:\n        value &= (value - 1)\n        count += 1\n    return count\n\ndef differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"Return True iff integers a and b differ in exactly one bit position.\"\"\"\n    xor_result = a ^ b\n\n    # Determine the maximum bit length needed to cover both numbers'\n    # absolute values, ensuring the mask captures all relevant differences.\n    # The max(..., 1) ensures at least one bit for cases like (0,0).\n    max_bit_len = max(a.bit_length(), b.bit_length(), 1)\n\n    # Create a mask to consider only the bits up to max_bit_len.\n    # This is crucial for consistent behavior with negative numbers,\n    # as Python's bitwise ops for negative numbers effectively have infinite leading 1s.\n    mask = (1 << max_bit_len) - 1\n\n    # Apply the mask to normalize the XOR result to a fixed width\n    # before counting set bits, treating it as an unsigned value.\n    masked_xor_result = xor_result & mask\n\n    return count_set_bits(masked_xor_result) == 1"}
{"task_id": "Mbpp/7", "solution": "from typing import List\n\ndef _split_by_whitespace(input_string: str) -> List[str]:\n    \"\"\"Internal helper: Splits input_string into tokens at whitespace (space, tab, newline).\"\"\"\n    return input_string.split()\n\ndef find_char_long(input_string: str) -> List[str]:\n    \"\"\"Public API: Accepts one string argument and returns a list of qualifying words (len >= 4).\"\"\"\n    tokens = _split_by_whitespace(input_string)\n    result = [token for token in tokens if len(token) >= 4]\n    return result"}
{"task_id": "Mbpp/9", "solution": "def is_same(s1: str, s2: str) -> bool:\n    \"\"\"Checks if two strings are identical.\"\"\"\n    return s1 == s2\n\ndef rotate(s: str, k: int) -> str:\n    \"\"\"Performs a cyclic right rotation of string s by k positions.\"\"\"\n    n = len(s)\n    if n == 0:\n        return \"\"\n    actual_k = k % n # Ensure k is effectively within [0, n-1] for rotation logic.\n    return s[n - actual_k:] + s[:n - actual_k]\n\ndef find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum positive number of rotations required to get the same string.\n    The rotation is a cyclic right shift.\n    \"\"\"\n    n = len(s)\n    for k in range(1, n + 1): # Iterate k from 1 to n (inclusive).\n        rotated_s = rotate(s, k)\n        if is_same(rotated_s, s):\n            return k"}
{"task_id": "Mbpp/3", "solution": "class IntegerValue:\n    \"\"\"A simple data holder for an integer value.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    @property\n    def value(self) -> int:\n        return self._value\n\nclass PrimalityResult:\n    \"\"\"A simple data holder for a boolean primality result.\"\"\"\n    def __init__(self, is_not_prime: bool):\n        self._is_not_prime = is_not_prime\n\n    @property\n    def is_not_prime(self) -> bool:\n        return self._is_not_prime\n\nclass InputValidator:\n    \"\"\"Validates that an input is an integer.\"\"\"\n    def validate_integer(self, n):\n        if not isinstance(n, int):\n            raise TypeError(\"Input must be an integer.\")\n        return IntegerValue(value=n)\n\nclass PrimeChecker:\n    \"\"\"Performs primality analysis on an integer.\"\"\"\n    def is_not_prime(self, n: int) -> bool:\n        if n < 2:\n            return True # Numbers less than 2 (0, 1, negatives) are not prime.\n        if n == 2:\n            return False # 2 is the only even prime number.\n        if n % 2 == 0:\n            return True # Even numbers greater than 2 are not prime.\n\n        # Check for odd divisors from 3 up to the square root of n.\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return True # Found a divisor, so n is not prime.\n            i += 2\n        return False # No divisors found, so n is prime.\n\ndef is_not_prime(n):\n    \"\"\"Identifies whether a given number is not prime.\"\"\"\n    # Validate the input to ensure it's an integer.\n    validator = InputValidator()\n    integer_value = validator.validate_integer(n)\n\n    # Delegate primality check to the PrimeChecker.\n    checker = PrimeChecker()\n    result = checker.is_not_prime(integer_value.value)\n    return result"}
{"task_id": "Mbpp/8", "solution": "def square_nums(inputList):\n    \"\"\"Compute squares for each numeric element in inputList and return a new list.\n\n    Args:\n        inputList: list of numbers (int or float).\n\n    Returns:\n        list: new list where each element is element * element for the corresponding element in inputList.\n    \"\"\"\n    return [num * num for num in inputList]"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input: str, ch: str) -> str:\n    \"\"\"Return input with the first and last occurrences of ch removed.\n\n    If ch does not occur, the original string is returned.\n    \"\"\"\n    first_idx = input.find(ch)\n\n    if first_idx == -1:\n        return input\n\n    last_idx = input.rfind(ch)\n\n    if first_idx == last_idx:\n        # Character occurs only once\n        return input[:first_idx] + input[first_idx+1:]\n    else:\n        # Character occurs two or more times\n        return input[:first_idx] + input[first_idx+1 : last_idx] + input[last_idx+1:]"}
{"task_id": "Mbpp/2", "solution": "from typing import Iterable, Any, List\n\ndef similar_elements(seq1: Iterable[Any], seq2: Iterable[Any]) -> List[Any]:\n    \"\"\"Validates inputs and returns a list of elements that appear in both seq1 and seq2 at least once.\n    Raises TypeError if either seq1 or seq2 is not iterable.\n    \"\"\"\n    _validate_inputs(seq1, seq2)\n    return _compute_intersection(seq1, seq2)\n\ndef _validate_inputs(seq1: Any, seq2: Any) -> None:\n    \"\"\"Checks if both inputs are iterable; raises TypeError if not.\"\"\"\n    try:\n        iter(seq1)\n    except TypeError:\n        raise TypeError(\"Input 'seq1' must be an iterable.\")\n    try:\n        iter(seq2)\n    except TypeError:\n        raise TypeError(\"Input 'seq2' must be an iterable.\")\n\ndef _compute_intersection(seq1: Iterable[Any], seq2: Iterable[Any]) -> List[Any]:\n    \"\"\"Computes shared elements, preferring set-based approach and falling back for unhashable elements.\"\"\"\n    list1 = list(seq1)\n    list2 = list(seq2)\n\n    try:\n        set1 = set(list1)\n        set2 = set(list2)\n        return list(set1.intersection(set2))\n    except TypeError:\n        # Fallback for unhashable elements\n        return _compute_intersection_unhashable(list1, list2)\n\ndef _compute_intersection_unhashable(seq1_list: List[Any], seq2_list: List[Any]) -> List[Any]:\n    \"\"\"Internal fallback for unhashable elements, performing equality-based comparison and deduplication.\"\"\"\n    shared_elements: List[Any] = []\n    already_added_to_result: List[Any] = []\n\n    for item1 in seq1_list:\n        is_already_added = False\n        for added_item in already_added_to_result:\n            if item1 == added_item:\n                is_already_added = True\n                break\n        \n        if not is_already_added:\n            is_in_seq2 = False\n            for item2 in seq2_list:\n                if item1 == item2:\n                    is_in_seq2 = True\n                    break\n            \n            if is_in_seq2:\n                shared_elements.append(item1)\n                already_added_to_result.append(item1)\n\n    return shared_elements"}
{"task_id": "Mbpp/4", "solution": "import heapq\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    pass\n\nclass ErrorHandler:\n    \"\"\"Handles raising validation errors.\"\"\"\n    def raise_validation_error(self, message: str) -> None:\n        raise ValidationError(message)\n\nclass InputValidator:\n    \"\"\"Validates input list and integer n.\"\"\"\n    def __init__(self):\n        self._error_handler = ErrorHandler()\n\n    def validate_list(self, numbers: list) -> bool:\n        \"\"\"Validates that 'numbers' is a list and contains only numeric items.\"\"\"\n        if not isinstance(numbers, list):\n            self._error_handler.raise_validation_error(\"Input 'numbers' must be a list.\")\n        for item in numbers:\n            if not isinstance(item, (int, float)):\n                self._error_handler.raise_validation_error(\"All items in 'numbers' must be numeric (int or float).\")\n        return True\n\n    def validate_n(self, n) -> bool:\n        \"\"\"Validates that 'n' is an integer.\"\"\"\n        if not isinstance(n, int):\n            self._error_handler.raise_validation_error(\"Input 'n' must be an integer.\")\n        return True\n\nclass HeapProcessor:\n    \"\"\"Computes the top k largest values using a min-heap.\"\"\"\n    def compute_top_k(self, numbers: list, k: int) -> list:\n        \"\"\"Returns a list of up to k largest numbers, not necessarily sorted.\"\"\"\n        if k <= 0:\n            return []\n        \n        if k >= len(numbers):\n            return list(numbers) # Return all values if k is larger than list size\n\n        min_heap = []\n        for number in numbers:\n            if len(min_heap) < k:\n                heapq.heappush(min_heap, number)\n            elif number > min_heap[0]:\n                heapq.heappushpop(min_heap, number)\n        \n        return min_heap\n\nclass Sorter:\n    \"\"\"Provides descending ordering for numeric lists.\"\"\"\n    def sort_desc(self, values: list) -> list:\n        \"\"\"Sorts a list of numeric values in descending order.\"\"\"\n        return sorted(values, reverse=True)\n\nclass ResultList:\n    \"\"\"Encapsulates the final ordered list.\"\"\"\n    def __init__(self, values: list):\n        self._values = values\n\n    def as_list(self) -> list:\n        \"\"\"Returns the encapsulated list of values.\"\"\"\n        return self._values\n\nclass HeapQueueLargest:\n    \"\"\"Orchestrates the workflow to find the n largest numbers.\"\"\"\n    def __init__(self, numbers: list, n: int):\n        self.numbers = numbers\n        self.n = n\n        self._validator = InputValidator()\n        self._processor = HeapProcessor()\n        self._sorter = Sorter()\n\n    def execute(self) -> list:\n        \"\"\"Performs validation, computation, and sorting to return the result.\"\"\"\n        self._validator.validate_list(self.numbers)\n        self._validator.validate_n(self.n)\n\n        if self.n <= 0:\n            return []\n        \n        top_values = self._processor.compute_top_k(self.numbers, self.n)\n        sorted_values_desc = self._sorter.sort_desc(top_values)\n        \n        result_list = ResultList(sorted_values_desc)\n        return result_list.as_list()\n\ndef heap_queue_largest(numbers, n):\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n    Handles validation, computes top-n values efficiently, and sorts the result.\n    \"\"\"\n    orchestrator = HeapQueueLargest(numbers, n)\n    return orchestrator.execute()"}
{"task_id": "Mbpp/18", "solution": "from dataclasses import dataclass\nfrom typing import Set\n\n@dataclass\nclass StringInput:\n    value: str\n\n@dataclass\nclass FilterString:\n    value: str\n\n@dataclass\nclass OutputString:\n    value: str\n\nclass CharacterSet:\n    def __init__(self, filter_string: FilterString) -> None:\n        \"\"\"Initializes the character set from a FilterString's value.\"\"\"\n        self.chars: Set[str] = set(filter_string.value)\n\n    def contains(self, ch: str) -> bool:\n        \"\"\"Checks if a character is present in the set.\"\"\"\n        return ch in self.chars\n\nclass RemoveDirtyChars:\n    def remove(self, first: 'StringInput', second: 'FilterString') -> 'OutputString':\n        \"\"\"Removes characters from the first string that are present in the second string.\"\"\"\n        char_set = CharacterSet(second)\n        output_buffer = []\n        for char in first.value:\n            if not char_set.contains(char):\n                output_buffer.append(char)\n        return OutputString(\"\".join(output_buffer))\n\ndef remove_dirty_chars(first: str, second: str) -> str:\n    \"\"\"\n    Removes characters from the first string which are present in the second string.\n    The relative order of the remaining characters from the first string is preserved.\n    \"\"\"\n    si = StringInput(first)\n    fs = FilterString(second)\n    out = RemoveDirtyChars().remove(si, fs)\n    return out.value"}
