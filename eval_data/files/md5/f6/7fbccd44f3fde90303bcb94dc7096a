{"task_id": "Mbpp/16", "solution": "import re\nfrom typing import Optional\n\nclass InputString:\n    \"\"\"Holds the input string value.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass MatchResult:\n    \"\"\"Holds the result of a pattern match.\"\"\"\n    def __init__(self, isMatch: bool, matchedSubstring: Optional[str]):\n        self.isMatch = isMatch\n        self.matchedSubstring = matchedSubstring\n\nclass LowercaseUnderscorePattern:\n    \"\"\"Encapsulates the regex pattern and matching logic.\"\"\"\n    regex: str = \"[a-z]+_[a-z]+\"\n    _compiled_pattern: re.Pattern\n\n    def __init__(self):\n        self._compiled_pattern = re.compile(self.regex)\n\n    def matches(self, s: str) -> bool:\n        \"\"\"Checks if the string contains a match for the pattern.\"\"\"\n        return self._compiled_pattern.search(s) is not None\n\n    def find_match(self, s: str) -> Optional[str]:\n        \"\"\"Finds and returns the first matched substring.\"\"\"\n        match = self._compiled_pattern.search(s)\n        if match:\n            return match.group(0)\n        return None\n\nclass TextLowercaseUnderscoreFunction:\n    \"\"\"Orchestrates pattern matching for the input string.\"\"\"\n    _pattern: LowercaseUnderscorePattern\n\n    def __init__(self):\n        self._pattern = LowercaseUnderscorePattern()\n\n    def analyze(self, input_obj: InputString) -> MatchResult:\n        \"\"\"Analyzes the input string for the lowercase-underscore pattern.\"\"\"\n        matched_substring = self._pattern.find_match(input_obj.value)\n        is_match = matched_substring is not None\n        return MatchResult(is_match, matched_substring)\n\ndef text_lowercase_underscore(input_string: str) -> bool:\n    \"\"\"\n    Returns true if the input string contains sequences of lowercase letters\n    joined with an underscore and false otherwise.\n    \"\"\"\n    input_obj = InputString(input_string)\n    analyzer = TextLowercaseUnderscoreFunction()\n    result = analyzer.analyze(input_obj)\n    return result.isMatch"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base, triangle_height, length):\n    \"\"\"Calculates the volume of a triangular prism.\n    The volume is determined by the area of the triangular base times its length.\"\"\"\n    volume = (base * triangle_height / 2) * length\n    return volume"}
{"task_id": "Mbpp/12", "solution": "from typing import List, Union\n\nNumeric = Union[int, float]\n\nclass Row:\n    \"\"\"Represents a single row within a matrix, with elements and an optional original index.\"\"\"\n    def __init__(self, elements: List[Numeric], position_index: int = None):\n        self.elements = elements\n        self.position_index = position_index\n\n    def sum(self) -> float:\n        \"\"\"Calculates the arithmetic sum of the elements in the row.\"\"\"\n        return float(sum(self.elements))\n\nclass Matrix:\n    \"\"\"Represents a matrix as a collection of Row objects and provides sorting capabilities.\"\"\"\n    def __init__(self, rows: List[Row]):\n        self.rows = rows\n\n    def sort_by_row_sum(self) -> \"Matrix\":\n        \"\"\"\n        Returns a new Matrix with rows sorted in ascending order by their sums.\n        Ties are broken by the original row index for stable sorting.\n        \"\"\"\n        rows_with_sums = []\n        for row in self.rows:\n            rows_with_sums.append((row.sum(), row.position_index, row))\n\n        rows_with_sums.sort()\n\n        sorted_rows = [item[2] for item in rows_with_sums]\n        \n        return Matrix(sorted_rows)\n\ndef sort_matrix(matrix: List[List[Numeric]]) -> List[List[Numeric]]:\n    \"\"\"\n    Sorts a given matrix in ascending order according to the sum of its rows.\n    \"\"\"\n    rows_domain_objects = [Row(elements=row_list, position_index=i) for i, row_list in enumerate(matrix)]\n\n    matrix_domain_object = Matrix(rows_domain_objects)\n\n    sorted_matrix_domain_object = matrix_domain_object.sort_by_row_sum()\n\n    sorted_list_of_lists = [row_obj.elements for row_obj in sorted_matrix_domain_object.rows]\n\n    return sorted_list_of_lists"}
{"task_id": "Mbpp/56", "solution": "def check(n: int) -> bool:\n    \"\"\"\n    Checks if n is one less than twice its decimal reverse.\n    The reverse operation drops leading zeros from the reversed number.\n    \"\"\"\n    def reverse_decimal(number: int) -> int:\n        \"\"\"\n        Reverses the decimal digits of an integer, dropping leading zeros\n        from the reversed value (e.g., 120 -> 21, 70 -> 7).\n        \"\"\"\n        s = str(number)\n        reversed_s = s[::-1]\n        return int(reversed_s)\n\n    reversed_n = reverse_decimal(n)\n    return n == (2 * reversed_n - 1)"}
{"task_id": "Mbpp/19", "solution": "def test_duplicate(arr: list[int]) -> bool:\n    \"\"\"\n    Checks if an array of integers contains any duplicate element.\n    Uses a set for efficient tracking of seen elements.\n    \"\"\"\n    seen = set()\n    for num in arr:\n        if num in seen:\n            return True\n        seen.add(num)\n    return False"}
{"task_id": "Mbpp/20", "solution": "class WoodallChecker:\n    \"\"\"Implements is_woodall and compute_k per SRS.\n\n    compute_k is a helper that searches for k >= 0 satisfying k * 2^k - 1 == n.\n    \"\"\"\n\n    def is_woodall(self, n: int) -> bool:\n        \"\"\"Return True if n is a Woodall number.\n\n        Raises:\n            TypeError: if n is not an int.\n        Returns:\n            bool: True if exists k >= 0 such that k * 2^k - 1 == n; False otherwise.\n        Behavior:\n            - If n < 0: return False.\n            - If arithmetic errors occur (OverflowError, ValueError), return False.\n        \"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input must be an integer.\")\n\n        if n < 0:\n            return False\n\n        # Delegate to the private helper to find k\n        found_k = self._compute_k(n)\n        return found_k != -1\n\n    def _compute_k(self, n: int) -> int:\n        \"\"\"Search for k >= 0 satisfying k * 2^k - 1 == n.\n        Returns k if found, otherwise -1.\n        \"\"\"\n        k = 0\n        while True:\n            try:\n                # Compute k * 2^k - 1. Using 1 << k for 2^k is often optimized.\n                val = k * (1 << k) - 1\n            except (OverflowError, ValueError, MemoryError):\n                # Catches potential arithmetic/resource errors as per design.\n                return -1\n\n            if val == n:\n                return k\n            if val > n:\n                # If current value exceeds n, subsequent values will also be greater.\n                return -1\n            \n            k += 1\n\ndef is_woodall(n: int) -> bool:\n    \"\"\"Module-level API delegating to WoodallChecker.is_woodall.\"\"\"\n    checker = WoodallChecker()\n    return checker.is_woodall(n)"}
{"task_id": "Mbpp/58", "solution": "def opposite_Signs(a, b):\n    \"\"\"Return True iff exactly one of a or b is > 0 and the other is < 0.\n\n    Returns True if signs are opposite; False otherwise.\n    \"\"\"\n    return (a > 0 and b < 0) or (a < 0 and b > 0)"}
{"task_id": "Mbpp/59", "solution": "class OctagonalNumber:\n    \"\"\"A simple container for an octagonal number's value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass Formula:\n    \"\"\"Encapsulates the octagonal number formula and its evaluation.\"\"\"\n    def __init__(self, expression: str) -> None:\n        self.expression = expression\n\n    def evaluate(self, n: int) -> int:\n        \"\"\"Evaluates the octagonal number formula for a given n.\"\"\"\n        return 3 * n * n - 2 * n\n\nclass IsOctagonalFunction:\n    \"\"\"Handles the computation of the nth octagonal number using a Formula.\"\"\"\n    def __init__(self, formula_expression: str = \"3*n^2 - 2*n\") -> None:\n        self.formula = Formula(formula_expression)\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the nth octagonal number and returns its integer value.\"\"\"\n        result = self.formula.evaluate(n)\n        oct_num = OctagonalNumber(result)\n        return oct_num.value\n\ndef is_octagonal(n: int) -> int:\n    \"\"\"\n    Computes the nth octagonal number.\n    Delegates the computation to internal classes as per design.\n    \"\"\"\n    octagonal_calculator = IsOctagonalFunction()\n    return octagonal_calculator.compute(n)"}
