{"task_id": "Mbpp/758", "solution": "import collections\nfrom typing import Any, List, Tuple, Dict\n\nclass Sublist:\n    def __init__(self, elements: list):\n        self.elements = elements\n\n    def to_tuple(self) -> tuple:\n        # Convert the contained sublist to a tuple preserving order\n        return tuple(self.elements)\n\nclass ResultDictionary:\n    def __init__(self):\n        self._map: Dict[Tuple[Any, ...], int] = {}\n\n    def increment(self, key: tuple) -> None:\n        if key in self._map:\n            self._map[key] += 1\n        else:\n            self._map[key] = 1\n\n    def to_dict(self) -> dict:\n        return dict(self._map) # shallow copy of internal map\n\ndef unique_sublists(input_list):\n    \"\"\"Counts occurrences of sublists, converting them to tuples as dictionary keys.\n    Returns a dictionary mapping unique sublist tuples to their counts.\"\"\"\n    if input_list == []:\n        return {}\n    result = ResultDictionary()\n    for sub in input_list:\n        sub_obj = Sublist(sub)\n        key = sub_obj.to_tuple()\n        result.increment(key)\n    return result.to_dict()"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(input_list):\n    \"\"\"Accepts a single argument input_list (a Python list or sequence of numbers).\n    Returns True iff the set of distinct values in input_list has cardinality 1; otherwise returns False.\n    \"\"\"\n    distinct_elements = set(input_list)\n    return len(distinct_elements) == 1"}
{"task_id": "Mbpp/759", "solution": "import re\n\n_PATTERN = r\"^\\d+\\.\\d{2}$\"\n_COMPILED = re.compile(_PATTERN)\n\nclass DecimalValidator:\n    \"\"\"Encapsulates the regex pattern and provides a method for decimal validation.\"\"\"\n    pattern: str = _PATTERN\n\n    def is_decimal(self, input_string: str) -> bool:\n        \"\"\"Return True iff input_string matches pattern ^\\d+\\.\\d{2}$.\"\"\"\n        return bool(_COMPILED.fullmatch(input_string))\n\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"Checks if a string is a decimal number with a precision of 2.\"\"\"\n    return DecimalValidator().is_decimal(input_string)"}
{"task_id": "Mbpp/757", "solution": "from typing import List\n\nclass StringItem:\n    def __init__(self, value: str, index: int):\n        self.value: str = value\n        self.index: int = index\n\n    def reverse(self) -> str:\n        \"\"\"Returns the reversed string value.\"\"\"\n        return self.value[::-1]\n\nclass StringList:\n    def __init__(self, items: List[StringItem]):\n        self.items: List[StringItem] = items\n\n    def size(self) -> int:\n        \"\"\"Returns the number of items in the list.\"\"\"\n        return len(self.items)\n\nclass ReversePair:\n    def __init__(self, a: StringItem, b: StringItem):\n        self.a: StringItem = a\n        self.b: StringItem = b\n\nclass ReversePairCounter:\n    def count_reverse_pairs(self, items: List[StringItem]) -> int:\n        \"\"\"Return the number of unordered reverse-string pairs among items.\n        This method uses a frequency map and lexicographical comparison to count pairs once.\n        \"\"\"\n        str_counts = {}\n        for item in items:\n            str_counts[item.value] = str_counts.get(item.value, 0) + 1\n\n        total_pairs = 0\n        for s, s_count in str_counts.items():\n            rev_s = s[::-1]\n\n            if s == rev_s:\n                # Palindromic/self-reverse case: n*(n-1)//2 pairs\n                total_pairs += s_count * (s_count - 1) // 2\n            elif s < rev_s:\n                # Count (s, rev_s) once when s is lexicographically smaller than rev_s\n                if rev_s in str_counts:\n                    rev_s_count = str_counts[rev_s]\n                    total_pairs += s_count * rev_s_count\n        return total_pairs\n\ndef count_reverse_pairs(input_list: List[str]) -> int:\n    \"\"\"Public API required by FR1.\n    Converts input list to StringItem objects and delegates counting to ReversePairCounter.\n    \"\"\"\n    string_items = [StringItem(value, i) for i, value in enumerate(input_list)]\n    counter = ReversePairCounter()\n    return counter.count_reverse_pairs(string_items)"}
{"task_id": "Mbpp/762", "solution": "def check_monthnumber_number(month: int) -> bool:\n    \"\"\"\n    Checks if the given month number (1-12) has 30 days.\n    Returns False for out-of-range month numbers.\n    \"\"\"\n    months_with_30_days = {4, 6, 9, 11}\n\n    if not (1 <= month <= 12):\n        return False\n\n    return month in months_with_30_days"}
{"task_id": "Mbpp/763", "solution": "def _is_numeric_sequence(array):\n    \"\"\"Checks if all elements in the array are numeric (int or float).\"\"\"\n    return all(isinstance(x, (int, float)) for x in array)\n\ndef _validate_input(array, n):\n    \"\"\"Validates array length, n value, and element types.\"\"\"\n    if len(array) != n:\n        raise ValueError(\"Length of array must be equal to n.\")\n    if n < 2:\n        raise ValueError(\"n must be greater than or equal to 2.\")\n    if not _is_numeric_sequence(array):\n        raise TypeError(\"All elements in the array must be numeric (int or float).\")\n\ndef _compute_min_adjacent(sorted_array):\n    \"\"\"Computes the minimum absolute difference between adjacent elements in a sorted array.\"\"\"\n    min_diff = float('inf')\n    for i in range(1, len(sorted_array)):\n        min_diff = min(min_diff, abs(sorted_array[i] - sorted_array[i-1]))\n    return int(min_diff)\n\ndef find_min_diff(array, n):\n    \"\"\"\n    Finds the minimum difference between any two elements in a given array.\n    The function validates inputs and returns the minimum absolute difference.\n    \"\"\"\n    _validate_input(array, n)\n    \n    sorted_array = sorted(list(array))\n    \n    return _compute_min_adjacent(sorted_array)"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(input_string):\n    \"\"\"\n    Count ASCII decimal digit characters ('0'..'9') in input_string and return the integer count.\n    \"\"\"\n    count = 0\n    for char in input_string:\n        if '0' <= char <= '9':  # Check for ASCII digits '0' through '9'\n            count += 1\n    return count"}
{"task_id": "Mbpp/765", "solution": "import math\n\ndef is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number (1-based).\n    Polite numbers are positive integers that are not powers of two.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    count = 0\n    num = 1\n    while True:\n        # Check if num is a power of two\n        # A number x is a power of two if x > 0 and (x & (x - 1)) == 0\n        if num > 0 and (num & (num - 1)) == 0:\n            # It's a power of two, so skip it\n            pass\n        else:\n            # Not a power of two, so it's a polite number\n            count += 1\n            if count == n:\n                return num\n        num += 1"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(nums, target_sum):\n    \"\"\"Return int: number of unordered index-distinct pairs (i<j) where nums[i] + nums[j] == target_sum.\"\"\"\n    n = len(nums)\n    if n < 2:\n        return 0\n\n    count = 0\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            if nums[i] + nums[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/769", "solution": "from typing import List\n\ndef Diff(listA: List, listB: List) -> List:\n    \"\"\"Public function to get the difference between two lists.\n    Returns elements from listA not in listB, maintaining a specific order derived from original indices.\n    \"\"\"\n    set_b = set(listB)\n    even_indexed_diff = []\n    odd_indexed_diff = []\n\n    # Collect elements from listA not present in listB,\n    # separating them based on whether their original index in listA was even or odd.\n    for i, item in enumerate(listA):\n        if item not in set_b:\n            if i % 2 == 0:\n                even_indexed_diff.append(item)\n            else:\n                odd_indexed_diff.append(item)\n\n    # Concatenate the even-indexed differences followed by the odd-indexed differences\n    # to achieve the specific output order required by the design examples.\n    return even_indexed_diff + odd_indexed_diff"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list):\n  \"\"\"Returns a list of all pairs of consecutive items in a given list.\n  Preserves element types and adjacent duplicates; does not modify the input list.\n  \"\"\"\n  if len(input_list) <= 1:\n    return []\n\n  output_pairs = []\n  for i in range(len(input_list) - 1):\n    output_pairs.append((input_list[i], input_list[i+1]))\n\n  return output_pairs"}
{"task_id": "Mbpp/770", "solution": "class OddNumberSequence:\n    \"\"\"Generates a sequence of the first n odd natural numbers.\"\"\"\n    def generate(self, n: int) -> list[int]:\n        if n == 0:\n            return []\n        return [2 * i + 1 for i in range(n)]\n\nclass PowerComputation:\n    \"\"\"Computes fourth powers for single values and lists of integers.\"\"\"\n    def computeFourth(self, value: int) -> int:\n        return value ** 4\n\n    def computeListFourth(self, numbers: list[int]) -> list[int]:\n        return [self.computeFourth(num) for num in numbers]\n\nclass Result:\n    \"\"\"Simple container for an integer result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\ndef odd_num_sum(n: int) -> int:\n    \"\"\"\n    Finds the sum of the fourth power of the first n odd natural numbers.\n    Assumes n is a non-negative integer based on project constraints.\n    \"\"\"\n    odd_seq_gen = OddNumberSequence()\n    list_of_odds = odd_seq_gen.generate(n)\n\n    power_comp = PowerComputation()\n    list_of_fourths = power_comp.computeListFourth(list_of_odds)\n\n    total = sum(list_of_fourths)\n    return Result(total).value"}
{"task_id": "Mbpp/771", "solution": "class Expression:\n    \"\"\"Holds the input expression string as a typed container.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass Bracket:\n    \"\"\"Represents a bracket symbol and provides helpers for matching.\"\"\"\n    _open_brackets = {'(': 'parenthesis', '[': 'square', '{': 'curly'}\n    _close_brackets = {')': 'parenthesis', ']': 'square', '}': 'curly'}\n    _matching_brackets = {'(': ')', '[': ']', '{': '}'}\n\n    def __init__(self, symbol: str):\n        self.symbol = symbol\n        # The design implies bracket_type might be useful, though not strictly used in current logic.\n        self.bracket_type = self._open_brackets.get(symbol) or self._close_brackets.get(symbol)\n\n    def is_open(self) -> bool:\n        \"\"\"Checks if the bracket is an opening bracket.\"\"\"\n        return self.symbol in Bracket._open_brackets\n\n    def matches(self, other_symbol: str) -> bool:\n        \"\"\"Checks if this opening bracket matches the given closing symbol.\"\"\"\n        # Assumes 'self' is an opening bracket from the stack.\n        return Bracket._matching_brackets.get(self.symbol) == other_symbol\n\nclass Stack:\n    \"\"\"Provides a LIFO container for items.\"\"\"\n    def __init__(self):\n        self._items = []\n\n    def push(self, item) -> None:\n        \"\"\"Adds an item to the top of the stack.\"\"\"\n        self._items.append(item)\n\n    def pop(self):\n        \"\"\"Removes and returns the item from the top of the stack.\"\"\"\n        if not self.is_empty():\n            return self._items.pop()\n        return None\n\n    def peek(self):\n        \"\"\"Returns the item at the top of the stack without removing it.\"\"\"\n        if not self.is_empty():\n            return self._items[-1]\n        return None\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the stack is empty.\"\"\"\n        return len(self._items) == 0\n\nclass Validator:\n    \"\"\"Performs bracket validation logic using Stack and Bracket domain types.\"\"\"\n    def check_expression(self, expression_str: str) -> bool:\n        \"\"\"Validates if the brackets in the given expression are balanced.\"\"\"\n        stack = Stack()\n        \n        # Compile a set of all valid bracket symbols for quick lookups\n        all_bracket_symbols = set(Bracket._open_brackets.keys()).union(Bracket._close_brackets.keys())\n\n        for char in expression_str:\n            if char not in all_bracket_symbols:\n                # Ignore characters that are not defined as brackets.\n                continue\n\n            bracket = Bracket(char)\n            if bracket.is_open():\n                stack.push(bracket)\n            else: # It's a closing bracket\n                if stack.is_empty():\n                    return False # Unmatched closing bracket\n\n                top_bracket = stack.peek()\n                if top_bracket.matches(bracket.symbol):\n                    stack.pop()\n                else:\n                    return False # Mismatched closing bracket\n\n        return stack.is_empty()\n\ndef check_expression(expression: str) -> bool:\n    \"\"\"Checks if the given expression's brackets are balanced.\"\"\"\n    validator = Validator()\n    return validator.check_expression(expression)"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(source: str, substring: str) -> tuple[str, int, int] | None:\n    \"\"\"Return (matched_substring, start_index, end_index) for first occurrence or None if not found.\"\"\"\n    idx = source.find(substring)\n    if idx == -1:\n        return None\n    return (substring, idx, idx + len(substring))"}
{"task_id": "Mbpp/772", "solution": "import re\n\ndef remove_length(input_string: str, k: int) -> str:\n    \"\"\"Removes all words of length k from the input string.\"\"\"\n\n    class Word:\n        def __init__(self, text: str):\n            self.text = text\n            self.length = len(text)\n\n    def _tokenize(text: str) -> list[Word]:\n        if not text.strip():\n            return []\n        tokens_str = re.split(r\"\\s+\", text)\n        return [Word(t) for t in tokens_str if t]\n\n    def _filter_by_length(words: list[Word], k_val: int) -> list[Word]:\n        return [word for word in words if word.length != k_val]\n\n    def _join(words: list[Word]) -> str:\n        if not words:\n            return ''\n        return ' '.join([word.text for word in words])\n\n    tokens = _tokenize(input_string)\n    filtered_tokens = _filter_by_length(tokens, k)\n    result = _join(filtered_tokens)\n    return result"}
{"task_id": "Mbpp/775", "solution": "from typing import List\n\nclass InputList:\n    \"\"\"Wrapper for caller-supplied ordered collection.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n        self.length = len(elements)\n\nclass Element:\n    \"\"\"Represents a single element with index and value, providing an isOdd method.\"\"\"\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\n\n    def isOdd(self) -> bool:\n        return (self.value % 2) != 0\n\nclass Result:\n    \"\"\"Container for the boolean result returned by evaluation.\"\"\"\n    def __init__(self, value: bool):\n        self.value = value\n\nclass OddPositionFunction:\n    \"\"\"Encapsulates validation and evaluation logic for odd positions.\"\"\"\n    def validate_input(self, inputList: InputList) -> bool:\n        # Verifies inputList.elements is a list and all its elements are integers.\n        if not isinstance(inputList.elements, list):\n            return False\n        for element in inputList.elements:\n            if not isinstance(element, int):\n                return False\n        return True\n\n    def evaluate(self, inputList: InputList) -> Result:\n        # Iterates through odd indices; if any value at an odd index is even, returns False.\n        if not self.validate_input(inputList):\n            return Result(False)\n\n        for i in range(inputList.length):\n            if (i % 2) != 0:  # Check if index is odd\n                element = Element(i, inputList.elements[i])\n                if not element.isOdd():\n                    return Result(False)\n        return Result(True)\n\ndef odd_position(input_list: List[int]) -> bool:\n    \"\"\"\n    Checks whether every odd index contains odd numbers of a given list.\n    Returns True if all elements at odd indices are odd, False otherwise.\n    \"\"\"\n    input_obj = InputList(input_list)\n    function_logic = OddPositionFunction()\n    result = function_logic.evaluate(input_obj)\n    return result.value"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input):\n    \"\"\"Return a list of sublists where each sublist is a run of consecutive equal elements.\n\n    Parameter: input -- a list-like collection of elements (InputList)\n    Returns: a list-of-lists (PackedList)\n    \"\"\"\n    if not input:\n        return []\n\n    packed_list = []\n    current_run = [input[0]]\n\n    for i in range(1, len(input)):\n        if input[i] == current_run[0]:\n            current_run.append(input[i])\n        else:\n            packed_list.append(current_run)\n            current_run = [input[i]]\n    \n    packed_list.append(current_run) # Append the last run\n\n    return packed_list"}
{"task_id": "Mbpp/777", "solution": "def find_sum(input_list):\n    \"\"\"\n    Calculates the sum of unique elements in a list.\n    Raises TypeError if the input is not a list.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    unique_elements = set(input_list)\n    return sum(unique_elements)"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n):\n    \"\"\"\n    Computes the number of positive divisors for n and returns True if the count is even, else False.\n    Assumes n is a positive integer.\n    \"\"\"\n    divisor_count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                divisor_count += 1\n            else:\n                divisor_count += 2\n        i += 1\n    \n    return divisor_count % 2 == 0"}
{"task_id": "Mbpp/780", "solution": "import collections\n\ndef find_combinations(input_list):\n    \"\"\"\n    Finds combinations of sums with tuples in the given tuple list.\n    Returns a list of 2-element tuples, where each tuple is the sum of corresponding elements from two distinct input tuples.\n    \"\"\"\n    \n    # Validator._is_numeric helper from design, inline for this completion.\n    def _is_numeric(value):\n        \"\"\"Returns True if the value is an int or float, but not bool.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    # Validator.validate logic from design, inline for this completion.\n    # Raises TypeError if input_list is invalid.\n    if not isinstance(input_list, (list, collections.abc.Sequence)):\n        raise TypeError(\"Input must be a list or sequence.\")\n    for i, item in enumerate(input_list):\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise TypeError(f\"Element at index {i} must be a 2-element tuple.\")\n        if not _is_numeric(item[0]) or not _is_numeric(item[1]):\n            raise TypeError(f\"Elements of tuple at index {i} must be numeric.\")\n\n    if len(input_list) < 2:\n        return []\n\n    output_list = []\n    n = len(input_list)\n    for i in range(n):\n        for j in range(i + 1, n):\n            tuple1 = input_list[i]\n            tuple2 = input_list[j]\n            sum_tuple = (tuple1[0] + tuple2[0], tuple1[1] + tuple2[1])\n            output_list.append(sum_tuple)\n\n    return output_list"}
{"task_id": "Mbpp/782", "solution": "from typing import List\n\nclass IntegerList:\n    \"\"\"Lightweight container representing the input list of integers.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self.elements = elements\n\nclass Subarray:\n    \"\"\"Represents a contiguous slice of IntegerList; provides a sum() helper.\"\"\"\n    def __init__(self, start_index: int, elements: List[int]) -> None:\n        self.start_index = start_index\n        self.elements = elements  # This 'elements' is the actual subarray slice\n        self.length = len(elements)\n\n    def sum(self) -> int:\n        \"\"\"Calculates the sum of the subarray's elements.\"\"\"\n        return sum(self.elements)\n\nclass OddLengthSumFunction:\n    \"\"\"Encapsulates computation of the aggregated sum of sums of odd-length contiguous subarrays.\"\"\"\n    name: str = \"odd_length_sum\"\n\n    def __init__(self, elements: List[int]) -> None:\n        self.input = IntegerList(elements)\n        self.output: int = 0\n\n    def compute(self) -> int:\n        \"\"\"Computes and returns the aggregated sum of sums of all odd-length contiguous subarrays.\"\"\"\n        total_sum = 0\n        n = len(self.input.elements)\n\n        # Iterate over all possible starting indices\n        for i in range(n):\n            # Iterate over all possible odd lengths\n            # Length 'l' must be odd (1, 3, 5, ...) and the subarray must fit within the list.\n            for l in range(1, n - i + 1, 2):\n                # Extract the subarray slice\n                current_subarray_elements = self.input.elements[i : i + l]\n                # Create a Subarray object and add its sum to the total\n                subarray = Subarray(i, current_subarray_elements)\n                total_sum += subarray.sum()\n        \n        self.output = total_sum\n        return total_sum\n\ndef odd_length_sum(list_of_ints: List[int]) -> int:\n    \"\"\"Public function (FR1). Accepts list_of_ints and returns aggregated int result (FR2).\n    Delegates to OddLengthSumFunction.compute and returns the integer result.\n    \"\"\"\n    function_instance = OddLengthSumFunction(list_of_ints)\n    return function_instance.compute()"}
{"task_id": "Mbpp/784", "solution": "class Number:\n    def __init__(self, value: int, index: int):\n        self.value = value\n        self.index = index\n\n    def is_even(self) -> bool:\n        return self.value % 2 == 0\n\n    def is_odd(self) -> bool:\n        return not self.is_even()\n\nclass OddNumber(Number):\n    pass\n\nclass EvenNumber(Number):\n    pass\n\nclass InputList:\n    def __init__(self, items: list[int]) -> None:\n        # Validate that items is a list/iterable and contains only integers.\n        if not isinstance(items, (list, tuple)):\n            raise TypeError(\"Input 'items' must be a list or iterable.\")\n        \n        for i, item in enumerate(items):\n            if not isinstance(item, int):\n                raise TypeError(f\"Element at index {i} is not an integer.\")\n        \n        self.items = items\n\n    def get_first_odd(self) -> Number:\n        # Scans for the first odd number, returning it as an OddNumber.\n        for i, value in enumerate(self.items):\n            if value % 2 != 0:\n                return OddNumber(value, i)\n        raise ValueError(\"no odd number found\")\n\n    def get_first_even(self) -> Number:\n        # Scans for the first even number, returning it as an EvenNumber.\n        for i, value in enumerate(self.items):\n            if value % 2 == 0:\n                return EvenNumber(value, i)\n        raise ValueError(\"no even number found\")\n\nclass Result:\n    def __init__(self, first_odd: Number, first_even: Number) -> None:\n        # Computes and stores the product of the first odd and even numbers.\n        self.product = first_odd.value * first_even.value\n        self.first_odd = first_odd\n        self.first_even = first_even\n\ndef mul_even_odd(items: list[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd number in a given list.\n    Raises TypeError for invalid input types or ValueError if parity numbers are missing.\n    \"\"\"\n    input_list = InputList(items)\n    \n    first_odd = input_list.get_first_odd()\n    first_even = input_list.get_first_even()\n    \n    result = Result(first_odd, first_even)\n    return result.product"}
{"task_id": "Mbpp/785", "solution": "class IntegerTuple:\n    \"\"\"\n    Container for parsed integer values, convertible to a Python tuple.\n    \"\"\"\n    def __init__(self, values: list[int]) -> None:\n        self.values = values\n\n    def to_tuple(self) -> tuple[int, ...]:\n        \"\"\"\n        Converts the stored list of integers to an immutable tuple.\n        \"\"\"\n        return tuple(self.values)\n\nclass TupleParser:\n    \"\"\"\n    Parses a tuple-formatted raw string into an IntegerTuple.\n    \"\"\"\n    def parse(self, raw: str) -> IntegerTuple:\n        # Trim surrounding whitespace from the whole string\n        trimmed_raw = raw.strip()\n\n        # Remove outer parentheses and strip any internal whitespace\n        # Assumes `raw` is always correctly formatted with outer parentheses\n        content = trimmed_raw[1:-1].strip()\n\n        # Handle cases like \"()\" or \"( )\" which should result in an empty tuple\n        if not content:\n            return IntegerTuple([])\n\n        # Split the content by comma and process each item\n        int_values = []\n        for item_str in content.split(','):\n            # Strip whitespace from each item string and convert to integer\n            int_values.append(int(item_str.strip()))\n\n        return IntegerTuple(int_values)\n\ndef tuple_str_int(raw: str) -> tuple[int, ...]:\n    \"\"\"\n    Converts a string representation of an integer tuple to a Python tuple of integers.\n    \"\"\"\n    parser = TupleParser()\n    integer_tuple = parser.parse(raw)\n    return integer_tuple.to_tuple()"}
