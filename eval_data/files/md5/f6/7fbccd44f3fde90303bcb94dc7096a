{"task_id": "Mbpp/453", "solution": "from typing import List\n\nclass Number:\n    \"\"\"\n    Represents an integer input and computes its positive divisors.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def isPositive(self) -> bool:\n        \"\"\"\n        Checks if the number is positive.\n        \"\"\"\n        return self.value > 0\n\n    def positiveDivisors(self) -> List[int]:\n        \"\"\"\n        Computes and returns a list of all positive divisors of the number.\n        \"\"\"\n        divs = []\n        if self.value == 0:\n            return [] # 0 has no positive divisors in this context\n        \n        # Ensure we work with the absolute value for divisor finding\n        abs_value = abs(self.value) \n\n        for i in range(1, abs_value + 1):\n            if abs_value % i == 0:\n                divs.append(i)\n        return divs\n\nclass Divisor:\n    \"\"\"\n    Represents a single divisor and reports its parity.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def isEven(self) -> bool:\n        \"\"\"\n        Checks if the divisor is an even number.\n        \"\"\"\n        return self.value % 2 == 0\n\nclass SumCalculator:\n    \"\"\"\n    Orchestrates factorization, filtering of even divisors, and summation.\n    \"\"\"\n    def sumofFactors(self, n: int) -> int:\n        \"\"\"\n        Computes the sum of all even positive factors of a given number n.\n        \"\"\"\n        number_obj = Number(n)\n        divisors = number_obj.positiveDivisors()\n        \n        even_factor_sum = 0\n        for d in divisors:\n            divisor_obj = Divisor(d)\n            if divisor_obj.isEven():\n                even_factor_sum += d\n        return even_factor_sum\n\nclass TestAssertion:\n    \"\"\"\n    Encapsulates a required assertion string and provides a method to execute it.\n    \"\"\"\n    def __init__(self, assertion: str) -> None:\n        self.assertion = assertion\n\n    def run(self) -> bool:\n        \"\"\"\n        Executes the stored assertion string. Raises AssertionError on failure.\n        \"\"\"\n        exec(self.assertion)\n        return True\n\ndef sumofFactors(n):\n    \"\"\"\n    Finds the sum of all even positive factors of a number n.\n    Delegates the core logic to SumCalculator.\n    \"\"\"\n    calculator = SumCalculator()\n    return calculator.sumofFactors(n)\n\n# The following assertion is required to be executed as part of the delivered code.\nassertion_instance = TestAssertion(assertion=\"assert sumofFactors(18) == 26\")\nassertion_instance.run()"}
{"task_id": "Mbpp/454", "solution": "import re\nfrom typing import List, Optional\n\nclass InputText:\n    \"\"\"Represents raw input text.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw = raw\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the raw text.\"\"\"\n        return len(self.raw)\n\nclass Word:\n    \"\"\"Represents a contiguous alphabetic word.\"\"\"\n    def __init__(self, text: str) -> None:\n        self.text = text\n\n    def containsLowercaseZ(self) -> bool:\n        \"\"\"Checks if the word contains the lowercase 'z' character.\"\"\"\n        return 'z' in self.text\n\nclass MatchResult:\n    \"\"\"Container for the outcome of a match operation.\"\"\"\n    def __init__(self, matched: bool, matchedWord: Optional[str] = None) -> None:\n        self.matched = matched\n        self.matchedWord = matchedWord\n\nclass Tokenizer:\n    \"\"\"Extracts Word objects from raw text.\"\"\"\n    def tokenize(self, raw: str) -> List[\"Word\"]:\n        \"\"\"Splits the raw string into a list of Word objects based on alphabetic sequences.\"\"\"\n        alphabetic_sequences = re.findall(r'[a-zA-Z]+', raw)\n        return [Word(seq) for seq in alphabetic_sequences]\n\nclass TextMatcher:\n    \"\"\"Orchestrates tokenization and detection of 'z' in words.\"\"\"\n    def __init__(self) -> None:\n        self._tokenizer = Tokenizer()\n\n    def text_match_wordz(self, input_str: str) -> bool:\n        \"\"\"Returns True if the input contains at least one word with 'z', otherwise False.\"\"\"\n        if not input_str:\n            return False\n\n        words = self._tokenizer.tokenize(input_str)\n        for word in words:\n            if word.containsLowercaseZ():\n                return True\n        return False\n\ndef text_match_wordz(input: str) -> bool:\n    \"\"\"\n    Matches a word containing 'z'. Returns True if at least one word in the input\n    string contains the lowercase 'z', otherwise False.\n    \"\"\"\n    matcher = TextMatcher()\n    return matcher.text_match_wordz(input)"}
{"task_id": "Mbpp/457", "solution": "def Find_Min(sublists):\n    \"\"\"\n    Finds the sublist with the minimum length from a list of sublists.\n    Assumes `sublists` is a non-empty list of lists.\n    \"\"\"\n    min_sublist = sublists[0]\n    min_length = len(sublists[0])\n\n    for i in range(1, len(sublists)):\n        current_sublist = sublists[i]\n        current_length = len(current_sublist)\n        if current_length < min_length:\n            min_length = current_length\n            min_sublist = current_sublist\n    \n    return min_sublist"}
{"task_id": "Mbpp/455", "solution": "from typing import FrozenSet\n\n_MONTHS_WITH_31_DAYS: FrozenSet[int] = frozenset({1, 3, 5, 7, 8, 10, 12})\n\ndef check_monthnumb_number(month_number: int) -> bool:\n    \"\"\"Validate month_number (1..12) and return True if month has 31 days, False otherwise.\n\n    Raises:\n        ValueError: if month_number is not an int or not in the inclusive range 1..12.\n    \"\"\"\n    if not isinstance(month_number, int):\n        raise ValueError(\"month_number must be an integer in 1..12\")\n    if month_number < 1 or month_number > 12:\n        raise ValueError(\"month_number must be an integer in 1..12\")\n\n    return (month_number in _MONTHS_WITH_31_DAYS)"}
