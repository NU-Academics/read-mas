{"task_id": "Mbpp/239", "solution": "class Validator:\n    \"\"\"Helper for validating input parameters.\"\"\"\n    def validatePositiveInteger(self, x: int, name: str) -> None:\n        \"\"\"Ensures input is a positive integer, raising ValueError if not.\"\"\"\n        if not isinstance(x, int) or x < 1:\n            raise ValueError(f\"{name} must be a positive integer, got: {x}\")\n\nclass InputParameters:\n    \"\"\"Encapsulates m and n, and provides validation.\"\"\"\n    def __init__(self, m: int, n: int) -> None:\n        self.m = m\n        self.n = n\n\n    def validate(self) -> None:\n        \"\"\"Validates m and n using a Validator instance.\"\"\"\n        validator = Validator()\n        validator.validatePositiveInteger(self.m, \"m\")\n        validator.validatePositiveInteger(self.n, \"n\")\n\nclass SequenceCounter:\n    \"\"\"Calculates the total number of sequences using dynamic programming with memoization.\"\"\"\n    def __init__(self) -> None:\n        self._memo = {}\n        self._max_m = 0 # Stores the 'm' for the current top-level calculation.\n\n    def get_total_number_of_sequences(self, m: int, n: int) -> int:\n        \"\"\"Initializes the counter and starts the sequence calculation.\"\"\"\n        self._max_m = m\n        self._memo = {} # Reset memoization for each new top-level call.\n\n        if n == 1:\n            return m # Any integer from 1 to m is a sequence of length 1.\n\n        total_sequences = 0\n        # The first element a1 can be any value from 1 to m.\n        # For each possible a1, we find how many sequences of length (n-1) can follow it.\n        for first_element_val in range(1, m + 1):\n            total_sequences += self._countFrom(first_element_val, n - 1)\n\n        return total_sequences\n\n    def _countFrom(self, prev_element_val: int, remaining_length: int) -> int:\n        \"\"\"\n        Recursively counts valid subsequences of 'remaining_length'.\n        'prev_element_val' is the last element chosen, so the next must be >= 2 * prev_element_val.\n        \"\"\"\n        if remaining_length == 0:\n            return 1 # A valid sequence of the desired total length was formed.\n\n        # Calculate the minimum allowed value for the next element in the sequence.\n        min_next_element_val = prev_element_val * 2\n\n        # If the minimum possible next value already exceeds m, no valid sequence can extend from here.\n        if min_next_element_val > self._max_m:\n            return 0\n\n        memo_key = (prev_element_val, remaining_length)\n        if memo_key in self._memo:\n            return self._memo[memo_key]\n\n        count = 0\n        # Iterate through all possible values for the next element.\n        for next_val in range(min_next_element_val, self._max_m + 1):\n            count += self._countFrom(next_val, remaining_length - 1)\n\n        self._memo[memo_key] = count\n        return count\n\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Finds the number of sequences of length n, such that each element is a positive\n    integer and is greater than or equal to twice the previous element but less than or equal to m.\n    \"\"\"\n    # 1. Validate inputs as per design.\n    params = InputParameters(m, n)\n    params.validate()\n\n    # 2. Delegate to SequenceCounter for actual calculation.\n    counter = SequenceCounter()\n    return counter.get_total_number_of_sequences(m, n)"}
