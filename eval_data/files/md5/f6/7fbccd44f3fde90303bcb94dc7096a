{"task_id": "Mbpp/116", "solution": "from typing import Tuple\n\nclass InputValidator:\n    \"\"\"\n    Validates that an input is a tuple of positive integers.\n    Raises TypeError or ValueError for invalid input.\n    \"\"\"\n    def validate(self, input_tuple: tuple) -> bool:\n        if not isinstance(input_tuple, tuple):\n            raise TypeError(\"Input must be a tuple.\")\n        \n        if not input_tuple: # Empty tuple is considered invalid per design \"treats empty tuple as invalid by raising ValueError\"\n            raise ValueError(\"Input tuple cannot be empty.\")\n\n        for item in input_tuple:\n            if not isinstance(item, int):\n                raise ValueError(\"All elements in the tuple must be integers.\")\n            if item <= 0:\n                raise ValueError(\"All elements in the tuple must be positive integers.\")\n        return True\n\ndef tuple_to_int(input_tuple: tuple) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer by concatenation.\n    Raises TypeError or ValueError if the input is invalid.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate(input_tuple)\n    \n    # Convert each integer to string, join them, then convert the result back to an integer\n    return int(\"\".join(str(item) for item in input_tuple))"}
{"task_id": "Mbpp/119", "solution": "from typing import List\n\ndef search(nums: List[int]) -> int:\n    \"\"\"Return the integer that appears only once in a sorted list where every other integer appears exactly twice.\"\"\"\n    lo = 0\n    hi = len(nums) - 1\n    while lo < hi:\n        mid = (lo + hi) // 2\n        # Ensure mid points to the start of a pair or potentially the single element\n        if mid % 2 == 1:\n            mid -= 1\n        # Check if the current element is part of a pair\n        if nums[mid] == nums[mid + 1]:\n            lo = mid + 2 # Skip the pair\n        else:\n            hi = mid # The single element is in the left half, including mid\n    return nums[lo]"}
{"task_id": "Mbpp/120", "solution": "from typing import Union\n\nNumber = Union[int, float]\n\ndef _validate_input(pairs):\n    \"\"\"\n    Validates the input list of pairs to ensure it conforms to expectations.\n    Checks for iterable type, 2-element tuples/lists, and numeric components.\n    \"\"\"\n    if not isinstance(pairs, (list, tuple)):\n        raise ValueError(\"Input must be an iterable (list or tuple) of pairs.\")\n\n    for i, pair in enumerate(pairs):\n        if not isinstance(pair, (list, tuple)) or len(pair) != 2:\n            raise ValueError(f\"Element at index {i} must be a 2-element tuple or list.\")\n        if not all(isinstance(x, (int, float)) for x in pair):\n            raise ValueError(f\"Elements within pair at index {i} must be numeric (int or float).\")\n\ndef _compute_abs_product(pair: tuple[Number, Number]) -> Number:\n    \"\"\"\n    Computes the absolute product of the two numbers within a given pair.\n    \"\"\"\n    a, b = pair[0], pair[1]\n    return abs(a * b)\n\ndef max_product_tuple(pairs: list[tuple[Number, Number]]) -> Number:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    It validates the input, computes absolute products for each pair, and returns the maximum.\n    \"\"\"\n    _validate_input(pairs)\n    \n    products = [_compute_abs_product(p) for p in pairs]\n    \n    # If `pairs` is empty, `products` will be empty, and `max([])` raises ValueError.\n    # This aligns with Python's default behavior for max on an empty sequence.\n    return max(products)"}
{"task_id": "Mbpp/124", "solution": "import math\n\nclass ComplexNumber:\n    \"\"\"A data holder for real and imag components of a complex number.\"\"\"\n    def __init__(self, real: float, imag: float) -> None:\n        self.real = real\n        self.imag = imag\n\n    def repr(self) -> str:\n        return f\"ComplexNumber(real={self.real}, imag={self.imag})\"\n\nclass AngleResult:\n    \"\"\"A data holder for the computed angle in radians.\"\"\"\n    def __init__(self, radians: float) -> None:\n        self.radians = radians\n\nclass AngleCalculator:\n    \"\"\"Computes the argument (angle) of a ComplexNumber in radians.\"\"\"\n    def computeAngle(self, c: ComplexNumber) -> float:\n        \"\"\"Uses math.atan2 to calculate the angle from real and imaginary parts.\"\"\"\n        return math.atan2(c.imag, c.real)\n\ndef angle_complex(z: complex) -> float:\n    \"\"\"\n    Computes the angle (argument) of a complex number in radians.\n\n    This function accepts a Python complex number and returns its angle as a float.\n    \"\"\"\n    c = ComplexNumber(z.real, z.imag)\n    calculator = AngleCalculator()\n    radians = calculator.computeAngle(c)\n    # The design specifies returning AngleResult.radians as a float,\n    # but the AngleResult class itself is a data holder.\n    # The float(radians) is explicit in the design for the return type.\n    return float(radians)<ctrl63>"}
{"task_id": "Mbpp/123", "solution": "import math\n\nclass DivisorCalculator:\n    \"\"\"Encapsulates proper divisor summation logic.\"\"\"\n    def sumProperDivisors(self, n: int) -> int:\n        \"\"\"Efficiently computes and returns sum of proper divisors of n.\"\"\"\n        if n <= 1:\n            return 0\n        \n        divisors_sum = 1 # Start with 1, as it's always a proper divisor for n > 1\n        # Iterate up to sqrt(n)\n        for i in range(2, int(math.isqrt(n)) + 1):\n            if n % i == 0:\n                divisors_sum += i\n                if i * i != n: # Avoid adding the same divisor twice for perfect squares\n                    divisors_sum += (n // i)\n        return divisors_sum\n\nclass AmicableCalculator:\n    \"\"\"\n    Implements core algorithm: computes divisor sums, finds amicable pairs,\n    and maintains a cache for divisor sums and a running total.\n    \"\"\"\n    def __init__(self):\n        self.divisorSums: dict[int, int] = {}\n        self.divisor_calculator = DivisorCalculator()\n\n    def computeDivisorSum(self, n: int) -> int:\n        \"\"\"Computes and caches the sum of proper divisors for a number.\"\"\"\n        if n < 1:\n            return 0\n        if n in self.divisorSums:\n            return self.divisorSums[n]\n        \n        sum_val = self.divisor_calculator.sumProperDivisors(n)\n        self.divisorSums[n] = sum_val\n        return sum_val\n\n    def amicable_numbers_sum(self, upper_bound: int) -> int:\n        \"\"\"\n        Finds and sums all amicable numbers up to the upper_bound.\n        Uses a cache for divisor sums and a set for included numbers to avoid duplicates.\n        \"\"\"\n        total_sum = 0\n        included_numbers = set()\n\n        for n in range(1, upper_bound + 1):\n            if n in included_numbers:\n                continue\n\n            sum_div_n = self.computeDivisorSum(n)\n\n            if sum_div_n > 0 and sum_div_n <= upper_bound and sum_div_n != n:\n                sum_div_of_dsn = self.computeDivisorSum(sum_div_n)\n\n                if sum_div_of_dsn == n:\n                    # Found an amicable pair (n, sum_div_n)\n                    if n not in included_numbers:\n                        total_sum += n\n                        included_numbers.add(n)\n                    if sum_div_n not in included_numbers:\n                        total_sum += sum_div_n\n                        included_numbers.add(sum_div_n)\n        return total_sum\n\ndef amicable_numbers_sum(upper_bound: int) -> int:\n    \"\"\"\n    Calculates the sum of all amicable numbers up to a specified upper bound.\n    Delegates computation to AmicableCalculator.\n    \"\"\"\n    # Input validation checks (e.g., for upper_bound type or value) are omitted per strict requirements.\n    \n    calculator = AmicableCalculator()\n    return calculator.amicable_numbers_sum(upper_bound)"}
{"task_id": "Mbpp/127", "solution": "def _validate_two_integers(a, b) -> None:\n    \"\"\"Validates that both inputs are integers, raising TypeError otherwise.\"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"Both arguments must be integers.\")\n\ndef multiply_int(a: int, b: int) -> int:\n    \"\"\"Multiplies two integers after validating their types.\"\"\"\n    _validate_two_integers(a, b)\n    return a * b"}
{"task_id": "Mbpp/125", "solution": "def find_length(value: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring.\n    Applies a Kadane-style algorithm after mapping '0' to +1 and '1' to -1.\n    \"\"\"\n    if not all(c in '01' for c in value):\n        raise ValueError(\"input must contain only '0' and '1'\")\n\n    if not value:\n        return 0\n\n    max_so_far = 0      # Stores the maximum difference found across all substrings.\n    current_max = 0     # Stores the maximum difference ending at the current position.\n\n    for char_val in value:\n        # Map '0' to +1, '1' to -1 to convert the problem to maximum contiguous subarray sum.\n        mapped_val = 1 if char_val == '0' else -1\n        \n        # Kadane's algorithm: choose between starting a new subarray or extending the current one.\n        current_max = max(mapped_val, current_max + mapped_val)\n        \n        # Update the overall maximum found so far.\n        max_so_far = max(max_so_far, current_max)\n        \n    return max_so_far"}
{"task_id": "Mbpp/126", "solution": "import math\n\nclass DivisorSet:\n    def __init__(self, n: int) -> None:\n        \"\"\"Constructs and computes positive divisors for n, using abs(n).\"\"\"\n        self.divisors = self._compute_divisors(n)\n\n    def _compute_divisors(self, n: int) -> set[int]:\n        \"\"\"Computes all positive divisors for a given integer n, using abs(n).\"\"\"\n        n_abs = abs(n)\n        divs = set()\n        if n_abs == 0:\n            return set()\n        \n        for i in range(1, int(math.sqrt(n_abs)) + 1):\n            if n_abs % i == 0:\n                divs.add(i)\n                divs.add(n_abs // i)\n        return divs\n\n    def intersect(self, other: 'DivisorSet') -> set[int]:\n        \"\"\"Returns the intersection of this DivisorSet's divisors with another DivisorSet's divisors.\"\"\"\n        return self.divisors.intersection(other.divisors)\n\nclass SumFunction:\n    @staticmethod\n    def sum(a: int, b: int) -> int:\n        \"\"\"Compute sum of common positive divisors of a and b.\"\"\"\n        divisors_a = DivisorSet(a)\n        divisors_b = DivisorSet(b)\n        common_divisors = divisors_a.intersect(divisors_b)\n        return sum(common_divisors)\n\ndef sum(a, b) -> int:\n    \"\"\"Public API: accepts two integers and returns int (sum of common divisors). Raises TypeError if non-int provided.\"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"Inputs must be integers.\")\n    return SumFunction.sum(a, b)"}
{"task_id": "Mbpp/128", "solution": "def _validate_n(n):\n    \"\"\"Validates that n is an integer.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n\ndef _validate_words_input(words_input):\n    \"\"\"Validates that words_input is a string or a list of strings.\"\"\"\n    if isinstance(words_input, str):\n        pass\n    elif isinstance(words_input, list):\n        if not all(isinstance(item, str) for item in words_input):\n            raise TypeError(\"words_input must be a string or a list of strings\")\n    else:\n        raise TypeError(\"words_input must be a string or a list of strings\")\n\ndef _parse_words_from_string(s: str) -> list:\n    \"\"\"Parses a string into a list of words using whitespace splitting.\"\"\"\n    return s.split()\n\ndef long_words(n, words_input):\n    \"\"\"\n    Finds words that are longer than n characters from a given list of words or string.\n    Validates inputs and processes words to return a filtered list.\n    \"\"\"\n    _validate_n(n)\n    _validate_words_input(words_input)\n\n    if isinstance(words_input, str):\n        tokens = _parse_words_from_string(words_input)\n    else:  # words_input must be a list of strings at this point due to validation\n        tokens = words_input\n\n    result = []\n    for word in tokens:\n        if len(word) > n:\n            result.append(word)\n    return result"}
{"task_id": "Mbpp/129", "solution": "from typing import List, Tuple\n\nclass Cell:\n    \"\"\"Lightweight value object representing a cell (row, col, value).\"\"\"\n    def __init__(self, row: int, col: int, value: int):\n        self.row: int = row\n        self.col: int = col\n        self.value: int = value\n\nclass Matrix:\n    \"\"\"Represent n\u00d7n integer matrix and provide shape helpers.\"\"\"\n    def __init__(self, values: List[List[int]]):\n        self.values: List[List[int]] = values\n        self.n: int = len(values) if values else 0\n\n    def is_square(self) -> bool:\n        \"\"\"Checks if the matrix is n x n.\"\"\"\n        if not self.values: # An empty list of lists\n            return False\n        if self.n == 0: # Empty matrix, i.e., values = [[]] or n from empty values\n             return False # Technically, a 0x0 matrix is square, but per requirement, empty should be False.\n        for row in self.values:\n            if len(row) != self.n:\n                return False\n        return True\n\n    def size(self) -> int:\n        \"\"\"Returns the dimension n of the n x n matrix.\"\"\"\n        return self.n\n\nclass MagicSquareTester:\n    \"\"\"Encapsulate validation and computation logic to decide magic-square-ness.\"\"\"\n    def magic_square_test(self, matrix: Matrix) -> bool:\n        \"\"\"Orchestrates validation, computes magic constant, sums, and compares, returning a boolean result.\"\"\"\n        if not self.validate_shape(matrix):\n            return False\n\n        if not self.validate_uniqueness(matrix):\n            return False\n        \n        n = matrix.n\n        magic_constant = self.compute_magic_constant(n)\n\n        for row_sum in self.sum_rows(matrix):\n            if row_sum != magic_constant:\n                return False\n\n        for col_sum in self.sum_columns(matrix):\n            if col_sum != magic_constant:\n                return False\n\n        for diag_sum in self.sum_diagonals(matrix):\n            if diag_sum != magic_constant:\n                return False\n\n        return True\n\n    def compute_magic_constant(self, n: int) -> int:\n        \"\"\"Computes the magic constant for a magic square of dimension n.\"\"\"\n        return n * (n * n + 1) // 2\n\n    def validate_shape(self, matrix: Matrix) -> bool:\n        \"\"\"Returns False if the matrix is empty or not n\u00d7n.\"\"\"\n        if matrix.n == 0:\n            return False\n        return matrix.is_square()\n\n    def validate_uniqueness(self, matrix: Matrix) -> bool:\n        \"\"\"Verifies elements are exactly integers 1..n^2 each once.\"\"\"\n        n_squared = matrix.n * matrix.n\n        expected_elements = set(range(1, n_squared + 1))\n        \n        actual_elements = set()\n        for row in matrix.values:\n            for val in row:\n                if val < 1 or val > n_squared or val in actual_elements:\n                    return False\n                actual_elements.add(val)\n        \n        return actual_elements == expected_elements\n\n    def sum_rows(self, matrix: Matrix) -> List[int]:\n        \"\"\"Returns a list of row sums.\"\"\"\n        return [sum(row) for row in matrix.values]\n\n    def sum_columns(self, matrix: Matrix) -> List[int]:\n        \"\"\"Returns a list of column sums.\"\"\"\n        sums = [0] * matrix.n\n        for r in range(matrix.n):\n            for c in range(matrix.n):\n                sums[c] += matrix.values[r][c]\n        return sums\n\n    def sum_diagonals(self, matrix: Matrix) -> List[int]:\n        \"\"\"Returns [main_diagonal_sum, anti_diagonal_sum].\"\"\"\n        main_diag_sum = 0\n        anti_diag_sum = 0\n        for i in range(matrix.n):\n            main_diag_sum += matrix.values[i][i]\n            anti_diag_sum += matrix.values[i][matrix.n - 1 - i]\n        return [main_diag_sum, anti_diag_sum]\n\ndef _to_Matrix(values: List[List[int]]) -> Matrix:\n    \"\"\"Construct Matrix domain object from list-of-lists.\"\"\"\n    return Matrix(values)\n\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"Public API. Converts input to Matrix and delegates to MagicSquareTester; returns boolean result.\"\"\"\n    m = _to_Matrix(matrix)\n    tester = MagicSquareTester()\n    return tester.magic_square_test(m)"}
