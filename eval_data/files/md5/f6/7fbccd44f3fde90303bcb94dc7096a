{"task_id": "Mbpp/86", "solution": "class InputValidator:\n    \"\"\"Validates input for centered hexagonal number calculation.\"\"\"\n    def is_positive_integer(self, n: int) -> bool:\n        \"\"\"Checks if n is a positive integer (n >= 1).\"\"\"\n        return isinstance(n, int) and n >= 1\n\nclass CenteredHexagonalNumber:\n    \"\"\"Encapsulates the calculation of a centered hexagonal number.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n\n    def compute(self) -> int:\n        \"\"\"Computes the nth centered hexagonal number using the formula H_n = 3 * n * (n - 1) + 1.\"\"\"\n        return 3 * self.n * (self.n - 1) + 1\n\ndef centered_hexagonal_number(n: int) -> int:\n    \"\"\"\n    Finds the nth centered hexagonal number.\n    Validates input n and computes H_n = 3 * n * (n - 1) + 1.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.is_positive_integer(n):\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n    calculator = CenteredHexagonalNumber(n)\n    return calculator.compute()"}
{"task_id": "Mbpp/84", "solution": "class ErrorResponse:\n    def __init__(self, message: str) -> None:\n        self.message = message\n\n    def raise_(self) -> None:\n        \"\"\"Raise ValueError(self.message) to surface the error.\"\"\"\n        raise ValueError(self.message)\n\nclass InputValidator:\n    def isPositiveInteger(self, n: any) -> bool:\n        \"\"\"Return True if n is int and n >= 1\"\"\"\n        return isinstance(n, int) and n >= 1\n\n    def raiseInvalidInputError(self, n: any) -> None:\n        \"\"\"Construct ErrorResponse and raise ValueError with message.\"\"\"\n        er = ErrorResponse(f\"Invalid input for sequence: {n!r}. Expected a positive integer (n >= 1).\")\n        er.raise_()\n\nclass Computation:\n    def __init__(self) -> None:\n        self._memo = {1: 1, 2: 1}\n\n    def compute(self, n: int) -> int:\n        \"\"\"Return memoized value for n or compute via _applyRecurrence and memoize.\"\"\"\n        if n in self._memo:\n            return self._memo[n]\n        val = self._applyRecurrence(n)\n        self._memo[n] = val\n        return val\n\n    def _applyRecurrence(self, n: int) -> int:\n        \"\"\"Apply Newman\u2013Conway recurrence using compute() for subcalls.\n           All recursive subcalls go through compute to use memoization.\"\"\"\n        k = self.compute(n - 1)\n        return self.compute(k) + self.compute(n - k)\n\nclass SequenceFunction:\n    def __init__(self) -> None:\n        self._validator = InputValidator()\n        self._computation = Computation()\n        self._baseCases = {1: 1, 2: 1}\n\n    def sequence(self, n: int) -> int:\n        \"\"\"Validate input and return nth value.\"\"\"\n        if not self._validator.isPositiveInteger(n):\n            self._validator.raiseInvalidInputError(n)\n        if n in self._baseCases:\n            return self._baseCases[n]\n        return self._computation.compute(n)\n\n    def computeRecurrence(self, n: int) -> int:\n        \"\"\"Compute recurrence for n; delegates to Computation.\"\"\"\n        return self._computation.compute(n)\n\ndef sequence(n: int) -> int:\n    \"\"\"Public API: compute nth Newman\u2013Conway value. Raises ValueError for invalid input.\"\"\"\n    sf = SequenceFunction()\n    return sf.sequence(n)"}
{"task_id": "Mbpp/87", "solution": "def merge_dictionaries_three(dict1: dict, dict2: dict, dict3: dict) -> dict:\n    \"\"\"Merge three dictionaries into one per SRS FR-1..FR-5.\n    Returns a merged dictionary containing the union of keys, with values drawn from inputs based on a first-wins insertion order.\n    \"\"\"\n    merged_dict = {}\n    merged_dict.update(dict1)\n\n    for key, value in dict2.items():\n        if key not in merged_dict:\n            merged_dict[key] = value\n\n    for key, value in dict3.items():\n        if key not in merged_dict:\n            merged_dict[key] = value\n\n    return merged_dict"}
{"task_id": "Mbpp/90", "solution": "def len_log(input_list):\n    \"\"\"\n    Finds the length of the longest word in a list of strings.\n    Returns 0 if the input list is empty.\n    \"\"\"\n    if not input_list:\n        return 0\n\n    max_length = 0\n    for word in input_list:\n        max_length = max(max_length, len(word))\n    return max_length"}
{"task_id": "Mbpp/91", "solution": "def find_substring(list_of_strings: list[str], search_string: str) -> bool:\n    \"\"\"Return True if search_string is a substring of any element in list_of_strings; otherwise False.\n\n    Preconditions (per SRS): list_of_strings is an iterable of strings and search_string is a string.\n    \"\"\"\n    for s in list_of_strings:\n        if search_string in s:\n            return True\n    return False"}
{"task_id": "Mbpp/89", "solution": "\"\"\"\nThis module provides the closest_num function to find the largest integer strictly less than n.\nIt accepts a single integer parameter `n` and returns `n - 1`.\nRaises TypeError or ValueError for missing or non-integer inputs.\n\"\"\"\n\nclass InputNumber:\n    \"\"\"Immutable container for input integer.\"\"\"\n    def __init__(self, value: int) -> None:\n        # Per strict instruction, actual validation (e.g., isinstance) is not performed here.\n        self.value = value\n\nclass OutputNumber:\n    \"\"\"Container for integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass ClosestNumFunction:\n    \"\"\"Stateless encapsulation of computation logic.\"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the largest integer strictly less than n.\"\"\"\n        return n - 1\n\ndef closest_num(n) -> int:\n    \"\"\"\n    Finds the largest integer strictly less than n.\n\n    Raises TypeError or ValueError for invalid or missing inputs.\n    \"\"\"\n    # Creates an InputNumber instance to process the input.\n    input_obj = InputNumber(n)\n\n    # Delegates computation to the ClosestNumFunction.\n    calculator = ClosestNumFunction()\n    result_value = calculator.compute(input_obj.value)\n\n    # Wraps the result in an OutputNumber and returns its value.\n    output_obj = OutputNumber(result_value)\n    return output_obj.value"}
{"task_id": "Mbpp/88", "solution": "def freq_count(input_list):\n    \"\"\"Compute frequency counts for elements in input_list and return a built-in dict.\"\"\"\n    counts = {}\n    for element in input_list:\n        counts[element] = counts.get(element, 0) + 1\n    return counts"}
{"task_id": "Mbpp/93", "solution": "from dataclasses import dataclass\nfrom typing import Union, Optional\n\nNumber = Union[int, float]\n\nclass PowerFunction:\n    \"\"\"Helper class to encapsulate power calculation logic.\"\"\"\n    def __init__(self, a: Number, b: Number) -> None:\n        self.a: Number = a\n        self.b: Number = b\n        self.result: Optional[Number] = None\n\n    def validateInputs(self) -> bool:\n        # Validation checks and error raising are omitted per explicit instruction.\n        return True\n\n    def compute(self) -> Number:\n        \"\"\"Computes 'a' to the power of 'b'.\"\"\"\n        self.result = pow(self.a, self.b)\n        return self.result\n\n@dataclass\nclass Operand:\n    \"\"\"Represents an operand with its value and role.\"\"\"\n    value: Number\n    role: str  # 'base' or 'exponent'\n\ndef power(a: Number, b: Number) -> Number:\n    \"\"\"Calculates 'a' to the power of 'b'.\"\"\"\n    pf = PowerFunction(a, b)\n    pf.validateInputs()\n    return pf.compute()"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(list_of_tuples):\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple\n    with the smallest second value.\n    \"\"\"\n    # Find the tuple with the minimum second value using the 'min' function with a custom key.\n    # The lambda function specifies that comparison should be based on the second element of each tuple.\n    min_tuple = min(list_of_tuples, key=lambda item: item[1])\n    \n    # Return the first element of the identified tuple.\n    return min_tuple[0]"}
{"task_id": "Mbpp/92", "solution": "class Number:\n    \"\"\"Holds a numeric value and provides its absolute decimal digits as a string.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def get_digits(self) -> str:\n        \"\"\"Returns the decimal digits of the absolute value of the number.\"\"\"\n        return str(abs(self.value))\n\nclass UndulatingChecker:\n    \"\"\"Evaluates whether a number's digit sequence is undulating.\"\"\"\n    def __init__(self):\n        pass\n\n    def is_undulating(self, n: Number) -> bool:\n        \"\"\"Checks if the digit sequence derived from Number n is undulating.\"\"\"\n        digits = n.get_digits()\n        length = len(digits)\n\n        if length < 2:\n            return False\n\n        char_A = digits[0]  # Expected digit for even positions (0, 2, 4, ...)\n        char_B = None       # Expected digit for odd positions (1, 3, 5, ...)\n\n        for i in range(1, length):\n            current_char = digits[i]\n            if i % 2 == 1:  # Odd position\n                if char_B is None:\n                    char_B = current_char\n                elif current_char != char_B:\n                    return False\n            else:  # Even position\n                if current_char != char_A:\n                    return False\n        \n        # After loop, if char_B is still None, it means length was 1, already handled.\n        # If length >= 2, char_B will have been set by digits[1].\n        # The two distinct digits must be different.\n        return char_A != char_B\n\ndef is_undulating(n: int) -> bool:\n    \"\"\"\n    Checks if the given integer is an undulating number.\n    An undulating number has exactly two distinct digits that strictly alternate.\n    \"\"\"\n    num = Number(n)\n    checker = UndulatingChecker()\n    return checker.is_undulating(num)"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists):\n    \"\"\"\n    Compute and return the length (int) of the shortest inner list in list_of_lists.\n    This function assumes the input is a non-empty list of lists.\n    \"\"\"\n    return min(len(inner_list) for inner_list in list_of_lists)"}
{"task_id": "Mbpp/96", "solution": "def divisor(n):\n    \"\"\"Calculates the number of positive divisors for a given integer n.\n    Assumes n is a non-zero integer.\n    \"\"\"\n    m = abs(n)\n    \n    if m == 1:\n        return 1\n\n    count = 0\n    # Iterate from 1 up to the integer part of the square root of m.\n    for i in range(1, int(m**0.5) + 1):\n        if m % i == 0:\n            if i * i == m:\n                count += 1\n            else:\n                count += 2\n    return count"}
{"task_id": "Mbpp/97", "solution": "def _flatten(listOfLists):\n    \"\"\"\n    Flattens a list of lists into a single sequence of elements.\n    It yields each element from the top-level sublists.\n    \"\"\"\n    for sublist in listOfLists:\n        for item in sublist:\n            yield item\n\ndef frequency_lists(listOfLists):\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n    Returns a dictionary mapping each element to its count.\n    \"\"\"\n    counts = {}\n    for item in _flatten(listOfLists):\n        counts[item] = counts.get(item, 0) + 1\n    return counts"}
{"task_id": "Mbpp/98", "solution": "from typing import Iterable\n\nclass MultiplyNumFunction:\n    \"\"\"\n    Encapsulates validation and computation logic for multiplying numbers in a sequence.\n    Handles checks for empty sequences and non-numeric elements.\n    \"\"\"\n    def validate_sequence(self, sequence: Iterable) -> None:\n        \"\"\"\n        Validates that the sequence is not empty and contains only numeric elements.\n        \"\"\"\n        if not sequence:\n            raise ValueError(\"Sequence cannot be empty.\")\n        for element in sequence:\n            if not isinstance(element, (int, float)):\n                raise TypeError(\"All elements in the sequence must be numeric (int or float).\")\n\n    def multiply_num(self, sequence: Iterable) -> float:\n        \"\"\"\n        Computes the product of elements in the sequence and divides by its length.\n        First, validates the input sequence as per design requirements.\n        \"\"\"\n        self.validate_sequence(sequence)\n\n        product = 1.0\n        for num in sequence:\n            product *= num\n\n        length = len(sequence)\n        result = product / length\n        return result\n\ndef multiply_num(sequence: Iterable) -> float:\n    \"\"\"\n    Public function to multiply all numbers in a sequence and divide by its length.\n    Delegates to MultiplyNumFunction for validation and computation.\n    \"\"\"\n    calculator = MultiplyNumFunction()\n    return calculator.multiply_num(sequence)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal integer to its binary string representation.\n    The binary string will have no leading zeros, except for the input 0 which returns \"0\".\n    \"\"\"\n    if decimal == 0:\n        return \"0\"\n\n    binary_digits = []\n    while decimal > 0:\n        remainder = decimal % 2\n        binary_digits.append(str(remainder))\n        decimal //= 2\n    \n    return \"\".join(reversed(binary_digits))"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"Compute smallest integer palindrome strictly greater than integer n.\n    Input: n (int)\n    Returns: p (int)\n    \"\"\"\n\n    def _is_palindrome(num: int) -> bool:\n        \"\"\"Checks if a given integer is a palindrome.\"\"\"\n        s = str(num)\n        return s == s[::-1]\n\n    candidate = n + 1\n    while True:\n        if _is_palindrome(candidate):\n            return candidate\n        candidate += 1"}
