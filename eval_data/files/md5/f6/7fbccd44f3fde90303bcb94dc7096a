{"task_id": "Mbpp/233", "solution": "import math\n\nclass InputValidator:\n    \"\"\"\n    Validates input parameters for type and non-negativity.\n    Raises TypeError for non-numeric inputs and ValueError for negative inputs.\n    \"\"\"\n    def is_numeric(self, value) -> bool:\n        return isinstance(value, (int, float))\n\n    def is_non_negative(self, value) -> bool:\n        return value >= 0\n\n    def validate(self, height, radius) -> None:\n        if not self.is_numeric(height):\n            raise TypeError(\"Height must be a numeric value (int or float).\")\n        if not self.is_numeric(radius):\n            raise TypeError(\"Radius must be a numeric value (int or float).\")\n\n        if not self.is_non_negative(height):\n            raise ValueError(\"Height cannot be negative.\")\n        if not self.is_non_negative(radius):\n            raise ValueError(\"Radius cannot be negative.\")\n\nclass LateralSurfaceCalculator:\n    \"\"\"Calculates the lateral surface area of a cylinder.\"\"\"\n    def compute(self, height: float, radius: float) -> float:\n        return 2.0 * math.pi * radius * height\n\ndef lateralsuface_cylinder(height, radius):\n    \"\"\"\n    Validates inputs and returns the lateral surface area of a cylinder as a float.\n    Raises TypeError for non-numeric inputs and ValueError for negative inputs.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate(height, radius)\n    calc = LateralSurfaceCalculator()\n    result = calc.compute(float(height), float(radius))\n    return float(result)"}
{"task_id": "Mbpp/235", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass InputNumber:\n    \"\"\"Lightweight container for the input integer.\"\"\"\n    value: int\n\n@dataclass\nclass Result:\n    \"\"\"Lightweight container for the result integer.\"\"\"\n    value: int\n\nclass BitMask:\n    \"\"\"Generates an even-bit mask.\"\"\"\n    def generate_up_to(self, bit_count: int) -> int:\n        \"\"\"\n        Generates and returns an int mask with bits at 1-based even positions\n        (0-based odd indices) set to 1 up to bit_count.\n        \"\"\"\n        mask = 0\n        for i in range(1, bit_count, 2): # Iterate 0-based odd indices\n            mask |= (1 << i)\n        return mask\n\ndef even_bit_set_number(number: int) -> int:\n    \"\"\"\n    Sets all even bit positions (1-based indexing; LSB == position 1)\n    in an integer to 1, leaving other bits unchanged.\n    \"\"\"\n    input_model = InputNumber(value=number)\n    # Determine bit coverage, ensuring at least 2 bits to cover position 2.\n    bit_count = max(2, input_model.value.bit_length())\n    \n    mask = BitMask().generate_up_to(bit_count)\n    result_value = input_model.value | mask\n    return Result(value=result_value).value"}
{"task_id": "Mbpp/238", "solution": "class StringInput:\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\nclass SubstringResult:\n    def __init__(self, count: int) -> None:\n        self.count = count\n\nclass SubstringCounter:\n    @classmethod\n    def number_of_substrings(cls, input: str) -> int:\n        \"\"\"\n        Computes the number of non-empty substrings for a given string.\n        Returns 0 for an empty string.\n        \"\"\"\n        string_input = StringInput(input)\n        n = string_input.length()\n        # The number of non-empty substrings of a string of length n is n * (n + 1) / 2.\n        count = n * (n + 1) // 2\n        return SubstringResult(count).count\n\ndef number_of_substrings(input: str) -> int:\n    \"\"\"\n    Counts the number of non-empty substrings of a given string.\n    This function acts as the API entry point and delegates to SubstringCounter.\n    \"\"\"\n    return SubstringCounter.number_of_substrings(input)"}
{"task_id": "Mbpp/237", "solution": "from typing import List, Tuple, Dict\nfrom collections import defaultdict\n\nclass NormalizedTuple:\n    def __init__(self, elements: Tuple):\n        \"\"\"\n        Initializes NormalizedTuple by sorting the input elements into a canonical form.\n        \"\"\"\n        self.elements = tuple(sorted(elements))\n\n    def as_tuple(self) -> Tuple:\n        \"\"\"\n        Returns the normalized tuple.\n        \"\"\"\n        return self.elements\n\nclass ResultDictionary:\n    def __init__(self, mapping: Dict[Tuple, int] = None):\n        \"\"\"\n        Initializes ResultDictionary with an optional mapping.\n        \"\"\"\n        self.mapping = mapping if mapping is not None else {}\n\n    def get(self, key: Tuple) -> int:\n        \"\"\"\n        Retrieves the count for a given normalized tuple key.\n        \"\"\"\n        return self.mapping.get(key, 0)\n\nclass OccurrenceCounter:\n    def check_occurences(self, input_list: List[Tuple]) -> ResultDictionary:\n        \"\"\"\n        Delegates to aggregate to process the list of tuples and returns a ResultDictionary.\n        \"\"\"\n        return self.aggregate(input_list)\n\n    def normalize(self, t: Tuple) -> NormalizedTuple:\n        \"\"\"\n        Creates and returns a NormalizedTuple object from the input tuple.\n        \"\"\"\n        return NormalizedTuple(t)\n\n    def aggregate(self, list_of_tuples: List[Tuple]) -> ResultDictionary:\n        \"\"\"\n        Aggregates counts for normalized tuples in the given list.\n        \"\"\"\n        counts = defaultdict(int)\n        for original_tuple in list_of_tuples:\n            normalized_tuple_obj = self.normalize(original_tuple)\n            counts[normalized_tuple_obj.as_tuple()] += 1\n        return ResultDictionary(dict(counts))\n\ndef check_occurences(input_list: List[Tuple]) -> Dict[Tuple, int]:\n    \"\"\"\n    Public API function that normalizes and counts occurrences of tuples\n    in a list, returning a dictionary.\n    \"\"\"\n    counter = OccurrenceCounter()\n    result_obj = counter.check_occurences(input_list)\n    return result_obj.mapping"}
