{"task_id": "Mbpp/799", "solution": "MASK = 0xFFFFFFFF\n\ndef apply_mask(val: int) -> int:\n    \"\"\"Applies the 32-bit mask to a value.\"\"\"\n    return val & MASK\n\ndef normalize_d(d: int) -> int:\n    \"\"\"Normalizes the rotation count to be within 0-31.\"\"\"\n    return d % 32\n\ndef left_rotate(value: int, d: int) -> int:\n    \"\"\"\n    Performs a 32-bit circular left rotation on a given number.\n    The number is treated as unsigned 32-bit.\n    \"\"\"\n    mask_value = apply_mask(value)\n    d_mod = normalize_d(d)\n\n    if d_mod == 0:\n        return mask_value\n\n    rotated = ((mask_value << d_mod) | (mask_value >> (32 - d_mod)))\n    return apply_mask(rotated)"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(input_string: str) -> str:\n    \"\"\"Return input string with spaces, tabs, and newlines removed, preserving non-whitespace order.\"\"\"\n    result_chars = []\n    for char in input_string:\n        if not char.isspace():\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"\n    Counts the number of equal integers among three given integers.\n    Returns 3 if all are equal, 2 if exactly two are equal, and 0 if all are distinct.\n    \"\"\"\n    if a == b and b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/804", "solution": "def _is_even_number(value) -> bool:\n    \"\"\"Checks if a number is even, handling integers and integral floats. Non-integral floats are not considered even.\"\"\"\n    if isinstance(value, int):\n        return value % 2 == 0\n    elif isinstance(value, float):\n        return value.is_integer() and int(value) % 2 == 0\n    return False\n\ndef validate_numeric(numbers: list) -> None:\n    \"\"\"Validates that all elements in the list are numeric (int or float), raising TypeError on invalid elements.\"\"\"\n    for i, num in enumerate(numbers):\n        if not isinstance(num, (int, float)):\n            raise TypeError(f\"Element at index {i} is not a numeric type (int or float): {num}\")\n\ndef is_product_even(numbers: list) -> bool:\n    \"\"\"\n    Returns True if the product of numbers in a list is even (i.e., if any element is even), otherwise False.\n    This includes zero, which is considered an even number.\n    \"\"\"\n    validate_numeric(numbers)\n\n    for num in numbers:\n        if _is_even_number(num):\n            return True\n    return False"}
{"task_id": "Mbpp/808", "solution": "def check_K(t: tuple, k: object) -> bool:\n    \"\"\"Return True if k is an element of tuple t, otherwise False.\"\"\"\n    return k in t"}
{"task_id": "Mbpp/803", "solution": "def is_perfect_square(n):\n    \"\"\"\n    Checks if a given number is a perfect square.\n    Returns True if n is a perfect square (e.g., 9, 4.0), False otherwise (e.g., 10, -4).\n    \"\"\"\n    if n < 0:\n        return False\n    \n    # Compute the square root. For perfect squares, its square root will be an integer.\n    root = n ** 0.5\n    # Check if the square root has no fractional part.\n    return root == int(root)"}
{"task_id": "Mbpp/806", "solution": "class UppercaseSequenceAnalyzer:\n    \"\"\"Analyzes a string to find the maximum run of uppercase characters.\"\"\"\n\n    def __init__(self):\n        # Initialize internal state for tracking current and maximum runs.\n        self._current_run = 0\n        self._max_run = 0\n\n    def _is_upper(self, c: str) -> bool:\n        \"\"\"Checks if a character is an ASCII uppercase letter ('A' through 'Z').\"\"\"\n        return 'A' <= c <= 'Z'\n\n    def max_run_uppercase(self, input: str) -> int:\n        \"\"\"Scans the input string to compute the longest contiguous uppercase run.\"\"\"\n        # Reset runs for a fresh analysis, ensuring consistent behavior for multiple calls.\n        self._current_run = 0\n        self._max_run = 0\n\n        for char in input:\n            if self._is_upper(char):\n                self._current_run += 1\n                # Update max_run if the current_run exceeds it.\n                if self._current_run > self._max_run:\n                    self._max_run = self._current_run\n            else:\n                # Reset current_run if a non-uppercase character is encountered.\n                self._current_run = 0\n        return self._max_run\n\n\ndef max_run_uppercase(input: str) -> int:\n    \"\"\"\n    Finds the maximum run of uppercase ASCII characters in the given string.\n    \"\"\"\n    # Create an analyzer instance and use its method to process the input string.\n    analyzer = UppercaseSequenceAnalyzer()\n    return analyzer.max_run_uppercase(input)"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(list_of_lists):\n    \"\"\"Public API. Accepts a list-of-lists of numeric values and returns the inner list with maximum sum.\"\"\"\n    max_current_sum = float('-inf')\n    max_list = None\n\n    if not list_of_lists:\n        return None\n\n    for inner_list in list_of_lists:\n        current_sum = sum(inner_list)\n        if current_sum > max_current_sum:\n            max_current_sum = current_sum\n            max_list = inner_list\n\n    return max_list"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers: list) -> int:\n    \"\"\"Finds the first odd number in a list, performing input validation.\"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for item in numbers:\n        if not isinstance(item, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n        if item % 2 != 0:\n            return item\n\n    raise ValueError(\"No odd numbers found in input list\")"}
{"task_id": "Mbpp/809", "solution": "def _compare_elements(a, b) -> bool:\n    \"\"\"Compares if b is strictly smaller than a.\"\"\"\n    try:\n        return b < a\n    except TypeError:\n        raise\n\ndef check_smaller(first, second) -> bool:\n    \"\"\"Checks if each element of the second tuple is smaller than its corresponding element in the first tuple.\"\"\"\n    if not isinstance(first, tuple) or not isinstance(second, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n\n    if len(first) != len(second):\n        raise TypeError(\"Tuples must have the same length.\")\n\n    for i in range(len(first)):\n        if not _compare_elements(first[i], second[i]):\n            return False\n\n    return True"}
