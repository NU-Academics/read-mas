{"task_id": "Mbpp/476", "solution": "def big_sum(numbers):\n    \"\"\"\n    Finds the sum of the largest and smallest value in a given array.\n    Validates input for type and emptiness, raising appropriate errors.\n    \"\"\"\n    if not isinstance(numbers, (list, tuple)):\n        raise TypeError(\"Input 'numbers' must be a list or tuple.\")\n    \n    if not numbers:\n        raise ValueError(\"Input list 'numbers' cannot be empty.\")\n\n    for item in numbers:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"All elements in 'numbers' must be numeric (int or float).\")\n\n    min_val = min(numbers)\n    max_val = max(numbers)\n    return min_val + max_val"}
{"task_id": "Mbpp/478", "solution": "def remove_lowercase(input: str) -> str:\n    \"\"\"Return input with every contiguous ASCII-lowercase substring removed.\n    ASCII lowercase letters are 'a' through 'z'.\n    \"\"\"\n    result_chars = []\n    i = 0\n    n = len(input)\n\n    while i < n:\n        current_char = input[i]\n        # If the current character is an ASCII lowercase letter, skip all subsequent lowercase letters.\n        if 'a' <= current_char <= 'z':\n            while i < n and 'a' <= input[i] <= 'z':\n                i += 1\n        else:\n            # If not lowercase, append it to the result and move to the next character.\n            result_chars.append(current_char)\n            i += 1\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/479", "solution": "import math\nfrom dataclasses import dataclass\n\n@dataclass\nclass IntegerInput:\n    value: int\n    is_negative: bool\n\n    def __post_init__(self):\n        self.is_negative = self.value < 0\n\n    def normalized(self) -> int:\n        \"\"\"Returns the absolute value of the input.\"\"\"\n        return abs(self.value)\n\n@dataclass\nclass FirstDigitResult:\n    digit: int\n\ndef first_Digit(n: int) -> int:\n    \"\"\"\n    Finds the first digit of a given integer.\n    Handles negative numbers by taking their absolute value and returns 0 for 0.\n    \"\"\"\n    input_obj = IntegerInput(n)\n    normalized_value = input_obj.normalized()\n\n    if normalized_value == 0:\n        return 0\n\n    # Option A: Repeated integer division\n    while normalized_value >= 10:\n        normalized_value //= 10\n    return normalized_value\n\n    # Option B: Convert to string (also valid based on design context)\n    # return int(str(normalized_value)[0])"}
{"task_id": "Mbpp/554", "solution": "def Split(input_list: list[int]) -> list[int]:\n    \"\"\"\n    Filters a list of integers, returning only the odd ones while preserving order.\n    \"\"\"\n    odd_numbers = []\n    for number in input_list:\n        if number % 2 != 0:\n            odd_numbers.append(number)\n    return odd_numbers"}
{"task_id": "Mbpp/555", "solution": "class NaturalNumber:\n    \"\"\"Represents a validated natural number.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\nclass Sum:\n    \"\"\"Computes the sum of the first n natural numbers (S1).\"\"\"\n    def compute(self, n) -> int:\n        return n * (n + 1) // 2\n\nclass SumOfCubes:\n    \"\"\"Computes the sum of cubes of the first n natural numbers (S3).\"\"\"\n    def compute(self, n) -> int:\n        return (n * (n + 1) // 2) ** 2\n\nclass Result:\n    \"\"\"A simple data wrapper for an integer result.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\ndef _validate_n(n) -> None:\n    \"\"\"Validates that n is an integer and n >= 1, raising ValueError if not.\"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"Input n must be a positive integer (n >= 1)\")\n\ndef difference(n) -> int:\n    \"\"\"\n    Finds the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    _validate_n(n)\n    \n    # NaturalNumber(n) is conceptual, actual value is used directly\n    \n    sum_calculator = Sum()\n    s1_n = sum_calculator.compute(n)\n    \n    sum_of_cubes_calculator = SumOfCubes()\n    s3_n = sum_of_cubes_calculator.compute(n)\n    \n    diff = s3_n - s1_n\n    \n    # Result(diff) is conceptual, the integer value is returned directly\n    return diff"}
{"task_id": "Mbpp/556", "solution": "from typing import List\n\nclass ArrayInput:\n    \"\"\"Represents the input array and its effective size.\"\"\"\n    def __init__(self, arr: List[int], n: int) -> None:\n        self.arr = arr\n        self.n = n\n\nclass Pair:\n    \"\"\"Conceptual representation of an index pair and its xor value.\"\"\"\n    def __init__(self, i: int, j: int, xor_value: int) -> None:\n        self.i = i\n        self.j = j\n        self.xor_value = xor_value\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the xor_value of the pair is odd.\"\"\"\n        return self.xor_value % 2 != 0\n\nclass Result:\n    \"\"\"Container for the integer count result.\"\"\"\n    def __init__(self, count: int) -> None:\n        self.count = count\n\nclass PairCounter:\n    \"\"\"Computes the number of unordered pairs whose xor value is odd.\"\"\"\n    def countOddPairs(self, arrInput: ArrayInput) -> int:\n        \"\"\"\n        Counts pairs (i, j) with 0 <= i < j < n such that arr[i] XOR arr[j] is odd.\n        An XOR is odd if one operand is even and the other is odd.\n        \"\"\"\n        if not isinstance(arrInput.n, int) or arrInput.n < 0 or arrInput.n > len(arrInput.arr):\n            raise ValueError(\"n must be an integer, 0 <= n <= len(arr).\")\n\n        count_even = 0\n        count_odd = 0\n        \n        for i in range(arrInput.n):\n            element = arrInput.arr[i]\n            if not isinstance(element, int):\n                raise TypeError(f\"All elements in arr[0:{arrInput.n}] must be integers, but found non-int at index {i}.\")\n            if element % 2 == 0:\n                count_even += 1\n            else:\n                count_odd += 1\n                \n        return count_even * count_odd\n\ndef find_Odd_Pair(arr, n) -> int:\n    \"\"\"\n    Counts the number of unordered pairs (i, j) with 0 <= i < j < n\n    such that arr[i] XOR arr[j] is odd.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer.\")\n    if n < 0 or n > len(arr):\n        raise ValueError(f\"n must be between 0 and len(arr) (inclusive), but got n={n} for array of length {len(arr)}.\")\n\n    array_input = ArrayInput(arr, n)\n    counter = PairCounter()\n    return counter.countOddPairs(array_input)"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input: str) -> str:\n    \"\"\"Return a new string with each alphabetic character toggled in case.\n\n    Pure function: performs no I/O and does not mutate external state.\n    \"\"\"\n    toggled_chars = []\n    for char in input:\n        if char.isupper():\n            toggled_chars.append(char.lower())\n        elif char.islower():\n            toggled_chars.append(char.upper())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a, b):\n    \"\"\"Return int sum of per-digit differences between integers a and b.\"\"\"\n\n    def _digits_of(n):\n        \"\"\"Return List[int] of decimal digits LSB-first for integer n.\"\"\"\n        n = abs(n)\n        if n == 0:\n            return [0]\n        digits = []\n        while n > 0:\n            digits.append(n % 10)\n            n //= 10\n        return digits\n\n    def _sum_per_digit_diffs(a_digits, b_digits):\n        \"\"\"Return int sum of absolute differences of aligned digit lists.\"\"\"\n        total_diff = 0\n        max_len = max(len(a_digits), len(b_digits))\n        for i in range(max_len):\n            digit_a = a_digits[i] if i < len(a_digits) else 0\n            digit_b = b_digits[i] if i < len(b_digits) else 0\n            total_diff += abs(digit_a - digit_b)\n        return total_diff\n\n    a_digits = _digits_of(a)\n    b_digits = _digits_of(b)\n\n    return _sum_per_digit_diffs(a_digits, b_digits)"}
{"task_id": "Mbpp/559", "solution": "from typing import List\n\ndef max_sub_array_sum(list: List[int], length: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist within the first 'length' elements.\n    Applies a variation of Kadane's algorithm to handle all-negative numbers correctly.\n    \"\"\"\n    if length == 0:\n        return 0\n\n    max_so_far = list[0]\n    current_max = list[0]\n\n    for i in range(1, length):\n        num = list[i]\n        current_max = max(num, current_max + num)\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/562", "solution": "from typing import List, Any\n\ndef Find_Max_Length(sublists: List[Any]) -> int:\n    \"\"\"\n    Finds the length of the longest sublist in a list of sublists.\n    Returns 0 if the input list is empty.\n    \"\"\"\n    if not sublists:\n        return 0\n\n    max_length = 0\n    for sublist in sublists:\n        max_length = max(max_length, len(sublist))\n    return max_length"}
{"task_id": "Mbpp/564", "solution": "from typing import List\n\ndef _validate_inputs(lst: List[int], n: int) -> None:\n    \"\"\"Raise ValueError if preconditions are violated (type checks, 0 <= n <= len(lst)).\"\"\"\n    if not isinstance(lst, list):\n        raise ValueError(\"Input 'lst' must be a list.\")\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' cannot be negative.\")\n    if n > len(lst):\n        raise ValueError(\"Input 'n' cannot be greater than the length of 'lst'.\")\n\n    # Check if elements in the relevant part of the list are integers\n    for i in range(n):\n        if not isinstance(lst[i], int):\n            raise ValueError(f\"Element at index {i} in 'lst' is not an integer.\")\n\ndef _count_unequal_pairs(sublist: List[int]) -> int:\n    \"\"\"Return integer count of unordered pairs (i, j) with i < j and sublist[i] != sublist[j].\"\"\"\n    count = 0\n    num_elements = len(sublist)\n    for i in range(num_elements):\n        for j in range(i + 1, num_elements):\n            if sublist[i] != sublist[j]:\n                count += 1\n    return count\n\ndef count_Pairs(lst: List[int], n: int) -> int:\n    \"\"\"Compute number of unordered unequal pairs among first n elements of lst.\"\"\"\n    _validate_inputs(lst, n)\n    \n    sublist = lst[0:n]\n    \n    return _count_unequal_pairs(sublist)"}
{"task_id": "Mbpp/566", "solution": "class NonNegativeInteger:\n    \"\"\"\n    Represents and encapsulates a non-negative integer value; provides lightweight validation.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        if value < 0:\n            raise ValueError(\"Input must be a non-negative integer.\")\n        self.value = value\n\nclass DigitSumResult:\n    \"\"\"\n    Encapsulates the integer result (sum of decimal digits).\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass SumDigitsFunction:\n    \"\"\"\n    Core computation service that validates input and computes the sum of decimal digits.\n    \"\"\"\n    def validateInput(self, n: int) -> None:\n        \"\"\"\n        Validates that n is a non-negative integer; raises ValueError if invalid.\n        \"\"\"\n        # Delegating validation to NonNegativeInteger\n        NonNegativeInteger(n)\n\n    def execute(self, n: int) -> int:\n        \"\"\"\n        Computes and returns the sum of decimal digits of integer n.\n        \"\"\"\n        self.validateInput(n)\n\n        s_n = str(n)\n        digit_sum = 0\n        for digit_char in s_n:\n            digit_sum += int(digit_char)\n\n        result = DigitSumResult(digit_sum)\n        return result.value\n\ndef sum_digits(n: int) -> int:\n    \"\"\"\n    Public API function to get the sum of the digits of a non-negative integer.\n    Delegates to SumDigitsFunction for validation and computation.\n    \"\"\"\n    service = SumDigitsFunction()\n    return service.execute(n)"}
{"task_id": "Mbpp/565", "solution": "from typing import List\n\ndef split(input: str) -> List[str]:\n    \"\"\"\n    Splits a string into a list of its individual characters.\n\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"split() expects a str input\")\n    return list(input)"}
{"task_id": "Mbpp/567", "solution": "def issort_list(list):\n    \"\"\"Checks if a list is sorted in non-strict ascending order.\n    Returns True for empty or single-element lists.\"\"\"\n    n = len(list)\n\n    if n <= 1:\n        return True\n\n    for i in range(1, n):\n        if list[i] < list[i - 1]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/568", "solution": "def empty_list(N: int) -> list[dict]:\n    \"\"\"\n    Create and return a list containing N empty dictionaries.\n\n    Args:\n        N (int): number of empty dictionaries to produce.\n\n    Returns:\n        list[dict]: list of length N where each element is {}.\n    \"\"\"\n    return [{} for _ in range(N)]"}
{"task_id": "Mbpp/572", "solution": "def _build_frequency_map(input_list) -> dict:\n    \"\"\"Internal helper returning dict[int,int] frequency map for input_list.\"\"\"\n    frequency_map = {}\n    for num in input_list:\n        frequency_map[num] = frequency_map.get(num, 0) + 1\n    return frequency_map\n\ndef two_unique_nums(input_list) -> list:\n    \"\"\"Accepts a list of integers and returns a list of integers that appear exactly once in input_list in original relative order.\"\"\"\n    frequency_map = _build_frequency_map(input_list)\n    result_list = []\n    for num in input_list:\n        if frequency_map[num] == 1:\n            result_list.append(num)\n    return result_list"}
{"task_id": "Mbpp/573", "solution": "def unique_product(numbers: list):\n    \"\"\"Compute product of unique numbers in `numbers` and return numeric result.\"\"\"\n    unique_nums = set(numbers)\n    product = 1\n    for num in unique_nums:\n        product *= num\n    return product"}
