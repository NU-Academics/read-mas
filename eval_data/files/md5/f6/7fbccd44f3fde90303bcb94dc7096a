{"task_id": "Mbpp/276", "solution": "import math\n\ndef volume_cylinder(radius, height):\n    \"\"\"\n    Calculates the volume of a cylinder given its radius and height.\n    \"\"\"\n    volume = math.pi * (radius ** 2) * height\n    return volume"}
{"task_id": "Mbpp/274", "solution": "class InputValidator:\n    \"\"\"Validates if an input is a positive integer.\"\"\"\n    @staticmethod\n    def is_positive_integer(n) -> bool:\n        \"\"\"Checks if n is an integer and n > 0.\"\"\"\n        return isinstance(n, int) and n > 0\n\nclass BinomialCalculator:\n    \"\"\"Calculates the sum of even-index binomial coefficients.\"\"\"\n    def sum_even_coefficients(self, n: int) -> int:\n        \"\"\"Computes the sum using the identity 2^(n-1).\"\"\"\n        # For n >= 1, the sum of even-indexed binomial coefficients is 2^(n-1).\n        # Using bit shift for efficiency: 1 << (n - 1) is equivalent to 2**(n-1).\n        return 1 << (n - 1)\n\nclass Result:\n    \"\"\"A simple container for the integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\ndef even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of even-index binomial coefficients for a positive integer n.\n    Uses the identity that the sum is 2^(n-1) for n >= 1.\n    \"\"\"\n    if not InputValidator.is_positive_integer(n):\n        raise ValueError(\"n must be a positive integer\")\n\n    calculator = BinomialCalculator()\n    result_int = calculator.sum_even_coefficients(n)\n    \n    return Result(result_int).value"}
{"task_id": "Mbpp/280", "solution": "def sequential_search(array, element):\n    \"\"\"\n    Performs a left-to-right linear search for an element in an array.\n    Returns a tuple (found, index) where index is -1 if not found.\n    \"\"\"\n    for i, item in enumerate(array):\n        if item == element:\n            return (True, i)\n    return (False, -1)"}
{"task_id": "Mbpp/279", "solution": "import sys\n\nclass InputParameter:\n    \"\"\"Represents and validates the input parameter n.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def isValid(self) -> bool:\n        \"\"\"Returns True if n is a valid 1-based positive integer.\"\"\"\n        return isinstance(self.n, int) and self.n >= 1\n\nclass DecagonalFunction:\n    \"\"\"Encapsulates the computation of the decagonal number.\"\"\"\n    _formula: str = \"4*n*n - 3*n\"\n\n    def compute(self, n: int) -> int:\n        \"\"\"Calculates the nth decagonal number using the formula.\"\"\"\n        return 4 * n * n - 3 * n\n\nclass Result:\n    \"\"\"A simple data holder for the computed integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass NumericLimits:\n    \"\"\"Checks whether a numeric value is within runtime integer limits.\"\"\"\n    def __init__(self, max_int: int, min_int: int):\n        self.max_int = max_int\n        self.min_int = min_int\n\n    def isWithinLimits(self, value: int) -> bool:\n        \"\"\"Returns True if the value is within the defined integer limits.\"\"\"\n        return self.min_int <= value <= self.max_int\n\ndef is_num_decagonal(n):\n    \"\"\"\n    Finds the nth decagonal number.\n    Raises ValueError for invalid input or OverflowError if the result exceeds runtime limits.\n    \"\"\"\n    ip = InputParameter(n)\n    if not ip.isValid():\n        raise ValueError(\"n must be an integer >= 1\")\n\n    df = DecagonalFunction()\n    value = df.compute(n)\n\n    limits = NumericLimits(max_int=sys.maxsize, min_int=-sys.maxsize - 1)\n    if not limits.isWithinLimits(value):\n        raise OverflowError(\"computed decagonal number exceeds runtime numeric limits\")\n\n    return value"}
{"task_id": "Mbpp/281", "solution": "def _is_hashable(item) -> bool:\n    \"\"\"Return True if item is hashable (can be used as a set/dict key); otherwise False.\"\"\"\n    try:\n        hash(item)\n    except TypeError:\n        return False\n    return True\n\ndef all_unique(input_list):\n    \"\"\"Check whether all elements in the provided list are unique.\n\n    Prefer O(n) set-based detection when elements are hashable; fall back to O(n^2) pairwise equality checks for unhashable items.\n    \"\"\"\n    if not input_list:\n        return True\n\n    # Determine if all elements are hashable to choose the optimal strategy\n    all_elements_hashable = True\n    for item in input_list:\n        if not _is_hashable(item):\n            all_elements_hashable = False\n            break\n\n    if all_elements_hashable:\n        # Use O(n) set-based approach\n        seen = set()\n        for item in input_list:\n            if item in seen:\n                return False\n            seen.add(item)\n        return True\n    else:\n        # Fallback to O(n^2) pairwise comparison for lists with unhashable items\n        n = len(input_list)\n        for i in range(n):\n            for j in range(i + 1, n):\n                if input_list[i] == input_list[j]:\n                    return False\n        return True"}
