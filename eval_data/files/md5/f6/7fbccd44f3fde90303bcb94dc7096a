{"task_id": "Mbpp/283", "solution": "from typing import List\nfrom collections import Counter\n\nclass IntegerInput:\n    \"\"\"\n    Represents an integer input and provides methods to extract its decimal digits.\n    Uses the absolute value of the integer for digit extraction.\n    \"\"\"\n    value: int\n\n    def __init__(self, value: int):\n        self.value = value\n\n    def digits(self) -> List[int]:\n        \"\"\"\n        Extracts decimal digits from the absolute value of the integer.\n        Returns a list of integer digits.\n        \"\"\"\n        s_val = str(abs(self.value))\n        return [int(d) for d in s_val]\n\nclass DigitCount:\n    \"\"\"\n    A simple data class to hold a digit and its frequency count.\n    \"\"\"\n    def __init__(self, digit: int, count: int):\n        self.digit = digit\n        self.count = count\n\nclass ValidationResult:\n    \"\"\"\n    A simple data class to hold the result of a validation.\n    \"\"\"\n    def __init__(self, is_valid: bool, reason: str = \"\"):\n        self.is_valid = is_valid\n        self.reason = reason\n\nclass ValidatorService:\n    \"\"\"\n    Implements the core validation logic according to the design rules.\n    It checks digit frequencies and special conditions for digit '0'.\n    \"\"\"\n    def validate(self, n: int) -> bool:\n        \"\"\"\n        Validates an integer based on digit frequency rules.\n        Returns False if digit '0' is present or if any digit's frequency exceeds its value.\n        \"\"\"\n        integer_input = IntegerInput(n)\n        digits = integer_input.digits()\n\n        digit_counts = Counter(digits)\n\n        # FR-5: If digit 0 appears, return False\n        if 0 in digit_counts:\n            return False\n\n        # FR-4: For each digit d present, verify count(d) <= d\n        for digit, count in digit_counts.items():\n            if count > digit:\n                return False\n\n        # If all checks pass\n        return True\n\ndef validate(n: int) -> bool:\n    \"\"\"\n    Checks whether the frequency of each digit in the integer is less than or equal to the digit itself.\n    This function acts as the public API entry point.\n    \"\"\"\n    # FR-2: Raise TypeError for non-integer input\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    # Delegate the core algorithm to ValidatorService\n    return ValidatorService().validate(n)"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"Return the sum of squares of the first n even natural numbers.\n\n    This function uses a closed-form formula for O(1) computation.\n    \"\"\"\n    # The sum of squares of the first n even numbers (2k)^2 is equivalent to 4 * sum_{k=1..n} k^2.\n    # The sum of squares of first n natural numbers is n * (n + 1) * (2 * n + 1) / 6.\n    # So, the sum is 4 * n * (n + 1) * (2 * n + 1) // 6.\n    result = 4 * n * (n + 1) * (2 * n + 1) // 6\n    return result"}
{"task_id": "Mbpp/285", "solution": "import re\nfrom datetime import datetime\nfrom typing import Optional\n\nclass TextInput:\n    \"\"\"Value object representing the input string (SRS domain class).\"\"\"\n    def __init__(self, value: str):\n        self.value: str = value\n    def length(self) -> int:\n        \"\"\"Return length of the text input.\"\"\"\n        return len(self.value)\n\nclass PatternMatcher:\n    \"\"\"Encapsulates pattern detection logic.\"\"\"\n    @staticmethod\n    def text_match_two_three(input: str) -> bool:\n        \"\"\"Return True if input contains 'abb' or 'abbb' (delegates to containsAbb/containsAbbb).\"\"\"\n        return re.search(r\"ab{2,3}\", input) is not None\n\n    @staticmethod\n    def containsAbb(input: str) -> bool:\n        \"\"\"Internal check for contiguous substring 'abb'.\"\"\"\n        return \"abb\" in input\n\n    @staticmethod\n    def containsAbbb(input: str) -> bool:\n        \"\"\"Internal check for contiguous substring 'abbb'.\"\"\"\n        return \"abbb\" in input\n\nclass MatchResult:\n    def __init__(self, matched: bool, matchedSubstring: Optional[str] = None, timestamp: Optional[datetime] = None):\n        self.matched: bool = matched\n        self.matchedSubstring: Optional[str] = matchedSubstring\n        self.timestamp: Optional[datetime] = timestamp if timestamp is not None else (datetime.utcnow() if matched else None)\n\ndef text_match_two_three(input: str) -> bool:\n    \"\"\"Public API required by FR1.\n\n    Signature: text_match_two_three(input: str) -> bool\n    Behavior: return True if input contains 'abb' or 'abbb'; case-sensitive matching.\n    \"\"\"\n    return PatternMatcher.text_match_two_three(input)"}
{"task_id": "Mbpp/290", "solution": "def _compute_max_length(list_of_lists):\n    \"\"\"Returns the maximum length among inner lists, or 0 if list_of_lists is empty.\"\"\"\n    return max((len(inner) for inner in list_of_lists), default=0)\n\ndef _select_representative_list(list_of_lists, max_len):\n    \"\"\"Returns the first inner list with the given maximum length, or an empty list if none found.\"\"\"\n    for inner in list_of_lists:\n        if len(inner) == max_len:\n            return inner\n    return []\n\ndef max_length(list_of_lists):\n    \"\"\"Return (max_length:int, representative_list:list).\n\n    Args:\n        list_of_lists: a list where each element is itself a list.\n\n    Returns:\n        tuple: (max_length, representative_list)\n    \"\"\"\n    max_len = _compute_max_length(list_of_lists)\n    rep = _select_representative_list(list_of_lists, max_len)\n    return (max_len, rep)"}
{"task_id": "Mbpp/292", "solution": "import math\n\nclass DivisionByZeroError(Exception):\n    def __init__(self, message: str = \"Division by zero\") -> None:\n        super().__init__(message)\n        self.message = message\n\ndef find(dividend, divisor) -> int:\n    if divisor == 0:\n        raise DivisionByZeroError(\"Division by zero\")\n    result = math.floor(dividend / divisor)\n    return int(result)"}
{"task_id": "Mbpp/286", "solution": "from typing import List\n\ndef max_sub_array_sum_repeated(array: List[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in the modified array\n    formed by repeating the given array k times.\n    \"\"\"\n    def _kadane(arr: List[int]) -> int:\n        \"\"\"\n        Finds the maximum contiguous subarray sum using Kadane's algorithm.\n        Handles arrays with all negative numbers by returning the largest single element.\n        \"\"\"\n        if not arr:\n            return 0\n\n        max_so_far = arr[0]\n        current_max = arr[0]\n\n        for i in range(1, len(arr)):\n            current_max = max(arr[i], current_max + arr[i])\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    def _max_prefix_sum(arr: List[int]) -> int:\n        \"\"\"\n        Calculates the maximum prefix sum of the given array, or 0 if all prefix sums are negative.\n        \"\"\"\n        if not arr:\n            return 0\n\n        current_sum = 0\n        max_prefix = 0\n\n        for x in arr:\n            current_sum += x\n            max_prefix = max(max_prefix, current_sum)\n        return max_prefix\n\n    def _max_suffix_sum(arr: List[int]) -> int:\n        \"\"\"\n        Calculates the maximum suffix sum of the given array, or 0 if all suffix sums are negative.\n        \"\"\"\n        if not arr:\n            return 0\n\n        current_sum = 0\n        max_suffix = 0\n\n        for i in range(len(arr) - 1, -1, -1):\n            current_sum += arr[i]\n            max_suffix = max(max_suffix, current_sum)\n        return max_suffix\n\n    if not isinstance(array, list):\n        raise ValueError(\"Input 'array' must be a list.\")\n    if not all(isinstance(x, int) for x in array):\n        raise ValueError(\"All elements in 'array' must be integers.\")\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n != len(array):\n        raise ValueError(f\"Input 'n' ({n}) must be equal to len(array) ({len(array)}).\")\n    if not isinstance(k, int):\n        raise ValueError(\"Input 'k' must be an integer.\")\n    if k < 1:\n        raise ValueError(\"Input 'k' must be an integer greater than or equal to 1.\")\n    \n    if not array:\n        return 0\n\n    if k == 1:\n        return _kadane(array)\n    else:\n        kadane_on_two_arrays = _kadane(array + array)\n\n        total_array_sum = sum(array)\n        max_prefix_sum = _max_prefix_sum(array)\n        max_suffix_sum = _max_suffix_sum(array)\n\n        if total_array_sum > 0:\n            potential_long_span_sum = max_prefix_sum + max_suffix_sum + (k - 2) * total_array_sum\n            return max(kadane_on_two_arrays, potential_long_span_sum)\n        else:\n            return kadane_on_two_arrays"}
{"task_id": "Mbpp/293", "solution": "import math\n\nclass NumericPrecisionConstraint:\n    \"\"\"\n    Documents numeric precision and determinism non-functional requirements.\n    \"\"\"\n    def __init__(self, precision: str = 'IEEE 754 double precision', deterministic: bool = True):\n        self.precision = precision\n        self.deterministic = deterministic\n\nclass RightTriangle:\n    \"\"\"\n    Domain entity representing a right triangle and computing its hypotenuse.\n    \"\"\"\n    def __init__(self, legA: float, legB: float):\n        self.legA = legA\n        self.legB = legB\n        self.hypotenuse = 0.0\n\n    def computeHypotenuse(self) -> float:\n        \"\"\"Computes the hypotenuse using the Pythagorean theorem.\"\"\"\n        self.hypotenuse = math.sqrt(self.legA**2 + self.legB**2)\n        return self.hypotenuse\n\nclass OthersideRightAngleFunction:\n    \"\"\"\n    Encapsulates the computation workflow for finding the hypotenuse.\n    \"\"\"\n    def compute(self, a: float, b: float) -> float:\n        \"\"\"\n        Calculates the hypotenuse of a right triangle given two perpendicular sides.\n        \"\"\"\n        # NumericPrecisionConstraint can be instantiated here to document expectations,\n        # but it doesn't directly influence the calculation logic in this simple case.\n        # constraint = NumericPrecisionConstraint()\n        \n        triangle = RightTriangle(a, b)\n        return triangle.computeHypotenuse()\n\ndef otherside_rightangle(a: float, b: float) -> float:\n    \"\"\"\n    Finds the length of the hypotenuse of a right-angled triangle given the lengths of the two perpendicular sides.\n    \"\"\"\n    function_executor = OthersideRightAngleFunction()\n    return function_executor.compute(a, b)\n\n__all__ = ['otherside_rightangle']"}
{"task_id": "Mbpp/294", "solution": "from typing import List, Optional, Union\nimport numbers\n\nclass Result:\n    \"\"\"DTO to hold the result of max value computation.\"\"\"\n    def __init__(self, value: Optional[Union[int, float]], found_numeric: bool):\n        self.value = value\n        self.found_numeric = found_numeric\n\nclass ListElement:\n    \"\"\"Base class for an element within the input list.\"\"\"\n    def __init__(self, raw_value):\n        self.raw_value = raw_value\n\n    def is_numeric(self) -> bool:\n        \"\"\"Determines if the element is considered numeric.\"\"\"\n        raise NotImplementedError\n\n    def as_number(self) -> Union[int, float]:\n        \"\"\"Returns the numeric value of the element.\"\"\"\n        raise NotImplementedError\n\nclass NumericElement(ListElement):\n    \"\"\"Represents a numeric element in the list.\"\"\"\n    def __init__(self, raw_value: Union[int, float]):\n        super().__init__(raw_value)\n        self.numeric_value = raw_value\n\n    def is_numeric(self) -> bool:\n        return True\n\n    def as_number(self) -> Union[int, float]:\n        return self.numeric_value\n\nclass NonNumericElement(ListElement):\n    \"\"\"Represents a non-numeric element in the list.\"\"\"\n    def is_numeric(self) -> bool:\n        return False\n\n    def as_number(self) -> Union[int, float]:\n        return None # This method should not be called on a NonNumericElement in this design.\n\nclass InputList:\n    \"\"\"Wraps the raw input list, classifying each element.\"\"\"\n    def __init__(self, raw_list: List):\n        self._elements: List[ListElement] = []\n        for item in raw_list:\n            if isinstance(item, numbers.Number) and not isinstance(item, bool):\n                self._elements.append(NumericElement(item))\n            else:\n                self._elements.append(NonNumericElement(item))\n\n    def get_elements(self) -> List[ListElement]:\n        \"\"\"Returns the list of wrapped elements.\"\"\"\n        return self._elements\n\nclass MaxValFunction:\n    \"\"\"Orchestrates the process of finding the maximum numeric value.\"\"\"\n    def filter_numeric(self, elements: List[ListElement]) -> List[NumericElement]:\n        \"\"\"Filters a list of elements, returning only numeric ones.\"\"\"\n        return [e for e in elements if e.is_numeric()]\n\n    def compute_max(self, numeric_elements: List[NumericElement]) -> Result:\n        \"\"\"Computes the maximum value from a list of numeric elements.\"\"\"\n        if not numeric_elements:\n            return Result(value=None, found_numeric=False)\n        \n        numeric_values = [e.as_number() for e in numeric_elements]\n        return Result(value=max(numeric_values), found_numeric=True)\n\n    def max_val(self, input_list: List) -> Optional[Union[int, float]]:\n        \"\"\"Main method to find the maximum numeric value in a list.\"\"\"\n        input_wrapper = InputList(input_list)\n        numeric_elements = self.filter_numeric(input_wrapper.get_elements())\n        result = self.compute_max(numeric_elements)\n        return result.value\n\ndef max_val(input_list: List) -> Optional[Union[int, float]]:\n    \"\"\"Finds the maximum numeric value in a heterogeneous list.\"\"\"\n    return MaxValFunction().max_val(input_list)"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(list_obj):\n    \"\"\"\n    Counts inversions in an array using a merge-sort based approach.\n    \"\"\"\n\n    def merge_count(left, right):\n        \"\"\"\n        Merges two sorted lists and counts cross inversions.\n        \"\"\"\n        merged_list = []\n        cross_inversion_count = 0\n        i, j = 0, 0\n        n_left = len(left)\n\n        while i < n_left and j < len(right):\n            if left[i] <= right[j]:\n                merged_list.append(left[i])\n                i += 1\n            else:\n                merged_list.append(right[j])\n                j += 1\n                cross_inversion_count += (n_left - i)\n\n        merged_list.extend(left[i:])\n        merged_list.extend(right[j:])\n        return merged_list, cross_inversion_count\n\n    def count_merge_sort(arr):\n        \"\"\"\n        Recursively sorts an array and counts total inversions.\n        \"\"\"\n        if len(arr) <= 1:\n            return arr, 0\n\n        mid = len(arr) // 2\n        left_half = arr[:mid]\n        right_half = arr[mid:]\n\n        sorted_left, left_inversions = count_merge_sort(left_half)\n        sorted_right, right_inversions = count_merge_sort(right_half)\n\n        merged, cross_inversions = merge_count(sorted_left, sorted_right)\n\n        total_inversions = left_inversions + right_inversions + cross_inversions\n        return merged, total_inversions\n\n    _, inversions = count_merge_sort(list_obj)\n    return inversions"}
{"task_id": "Mbpp/297", "solution": "def _flatten_recursive(item, out_list):\n    \"\"\"\n    Recursively processes an item: if it's a list, it iterates and flattens its sub-items;\n    otherwise, it appends the item to the provided output list.\n    \"\"\"\n    if isinstance(item, list):\n        for sub_item in item:\n            _flatten_recursive(sub_item, out_list)\n    else:\n        out_list.append(item)\n\n\ndef flatten_list(input_list):\n    \"\"\"\n    Flattens a nested list structure into a single-dimensional list,\n    preserving order and not modifying the original input list.\n    \"\"\"\n    flat_list = []\n    # Iterate through the top-level elements of the input list.\n    # The _flatten_recursive helper handles any further nesting within these elements.\n    for item in input_list:\n        _flatten_recursive(item, flat_list)\n    return flat_list"}
{"task_id": "Mbpp/299", "solution": "from typing import List, Tuple, Dict, Union\n\ndef max_aggregate(records: List[Tuple[str, Union[int, float]]]) -> Tuple[str, float]:\n    \"\"\"\n    Calculate the maximum aggregate from a list of tuples, validating input and handling edge cases.\n    The function aggregates values by name, finds the name with the highest total, and returns it.\n    \"\"\"\n    if not isinstance(records, list):\n        raise ValueError(\"Input must be a list.\")\n    if not records:\n        raise ValueError(\"input list is empty\")\n\n    for i, item in enumerate(records):\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise ValueError(f\"Element at index {i} is not a 2-tuple: {item}\")\n        \n        name, value = item\n        if not isinstance(name, str):\n            raise ValueError(f\"Name in element at index {i} is not a string: {name}\")\n        \n        if not isinstance(value, (int, float)):\n            raise ValueError(f\"Value in element at index {i} is not numeric: {value}\")\n\n    aggregates: Dict[str, float] = {}\n    for name, value in records:\n        aggregates[name] = aggregates.get(name, 0.0) + float(value)\n\n    max_name: str = \"\"\n    max_total: float = -float('inf')\n\n    for name, total in aggregates.items():\n        if total > max_total:\n            max_total = total\n            max_name = name\n    \n    return (max_name, max_total)"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef count_binary_seq(n):\n    \"\"\"\n    Calculates the count of binary sequences of length 2n where the sum of the first n bits\n    equals the sum of the last n bits, which is C(2n, n).\n    \"\"\"\n    return math.comb(2 * n, n)"}
{"task_id": "Mbpp/305", "solution": "def start_withp(lines: list) -> tuple:\n    \"\"\"Orchestrates tokenization, matching, and collection to return the first two words starting with 'p' or 'P'.\"\"\"\n    matched_words = []\n    for line in lines:\n        words = line.split()  # Splits on whitespace by default\n        for word in words:\n            if word and (word[0] == 'p' or word[0] == 'P'):\n                matched_words.append(word)\n                if len(matched_words) == 2:\n                    return (matched_words[0], matched_words[1])\n    # Precondition ensures this point is not reached without two matches being found."}
{"task_id": "Mbpp/301", "solution": "class Validator:\n    @staticmethod\n    def is_dict(obj) -> bool:\n        \"\"\"Checks if the given object is a dictionary.\"\"\"\n        return isinstance(obj, dict)\n\nclass DictDepthCalculator:\n    def dict_depth(self, d: dict) -> int:\n        \"\"\"Recursively calculates the maximum depth of a dictionary, counting top-level as 1.\"\"\"\n        # If the dictionary is empty, its depth is 1 (it still counts as a level).\n        if not d:\n            return 1\n\n        max_child_depth = 0\n        for value in d.values():\n            if isinstance(value, dict):\n                # Recursively find the depth of child dictionaries\n                child_depth = self.dict_depth(value)\n                if child_depth > max_child_depth:\n                    max_child_depth = child_depth\n        \n        # The current dictionary itself adds 1 to the maximum depth of its children.\n        return 1 + max_child_depth\n\ndef dict_depth(d):\n    \"\"\"\n    Finds the maximum nesting depth of a dictionary.\n    Top-level dictionary counts as depth 1.\n    \"\"\"\n    # Validate input type as per design context.\n    if not Validator.is_dict(d):\n        raise TypeError(\"dict_depth: expected dict input\")\n    \n    # Delegate to the calculator for depth computation.\n    calculator = DictDepthCalculator()\n    return calculator.dict_depth(d)"}
{"task_id": "Mbpp/306", "solution": "class Element:\n    \"\"\"Represents an array element with its value and index.\"\"\"\n    def __init__(self, value: int, index: int):\n        self.value = value\n        self.index = index\n\nclass Subsequence:\n    \"\"\"Represents a subsequence as a list of Element objects and computes its sum.\"\"\"\n    def __init__(self, elements: list[Element] = None):\n        self.elements = elements if elements is not None else []\n\n    def sum(self) -> int:\n        \"\"\"Calculates the sum of values of elements in the subsequence.\"\"\"\n        return sum(elem.value for elem in self.elements)\n\n    def append(self, elem: Element) -> None:\n        \"\"\"Appends an element to the subsequence.\"\"\"\n        self.elements.append(elem)\n\nclass Array:\n    \"\"\"Represents the input array and provides its values and length.\"\"\"\n    def __init__(self, values: list[int]):\n        self.values = values\n        self.length = len(values)\n\nclass Validator:\n    \"\"\"Validates inputs for the max_sum_increasing_subseq function.\"\"\"\n    def validate(self, arr: list[int], n: int, i: int, k: int) -> None:\n        \"\"\"\n        Validates array length, index bounds, and k > i.\n        Raises ValueError on invalid input.\n        \"\"\"\n        if n != len(arr):\n            raise ValueError(\"Input error: n must be equal to len(arr)\")\n        if not (0 <= i < n):\n            raise ValueError(\"Input error: index i must be within 0 and n-1\")\n        if not (0 <= k < n):\n            raise ValueError(\"Input error: index k must be within 0 and n-1\")\n        if k <= i:\n            raise ValueError(\"Input error: index k must be strictly greater than i\")\n\ndef max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Computes the maximum sum of an increasing subsequence from arr[0..i]\n    followed by arr[k], where k > i.\n    \"\"\"\n    Validator().validate(arr, n, i, k)\n\n    array_obj = Array(arr)\n    arr_k_value = array_obj.values[k]\n\n    # dp[x] stores the maximum sum of an increasing subsequence ending at arr[x],\n    # where x is in the prefix 0..i, and arr[x] < arr[k].\n    # If arr[x] >= arr[k], dp[x] is 0 as it cannot be part of the prefix for arr[k].\n    dp = [0] * (i + 1)\n    max_overall_prefix_sum = 0\n\n    for x in range(i + 1):\n        current_val = array_obj.values[x]\n\n        if current_val < arr_k_value:\n            current_dp_sum = current_val # Subsequence can be just arr[x] itself\n\n            for prev_x in range(x):\n                # Check for strictly increasing subsequence and that prev_x was a valid prefix element\n                if array_obj.values[prev_x] < current_val and dp[prev_x] > 0:\n                    current_dp_sum = max(current_dp_sum, dp[prev_x] + current_val)\n            \n            dp[x] = current_dp_sum\n            max_overall_prefix_sum = max(max_overall_prefix_sum, dp[x])\n        # If current_val >= arr_k_value, dp[x] remains its initial 0, indicating\n        # it cannot form a prefix for arr[k].\n\n    # The final sum is the maximum prefix sum found (or 0 if none) plus arr[k].\n    # This correctly handles cases where no valid preceding elements exist, returning arr[k].\n    return max_overall_prefix_sum + arr_k_value"}
{"task_id": "Mbpp/309", "solution": "def maximum(a, b):\n    \"\"\"\n    Returns the maximum of two numbers.\n    If the numbers are equal, the first number is returned.\n    \"\"\"\n    if a > b:\n        return a\n    elif b > a:\n        return b\n    else: # a == b\n        return a"}
{"task_id": "Mbpp/310", "solution": "def string_to_tuple(s: str) -> tuple:\n    \"\"\"Primary API. Returns tuple of single-character strings excluding U+0020 spaces.\"\"\"\n\n    def filter_spaces(text: str) -> str:\n        \"\"\"Return text with all U+0020 characters removed.\"\"\"\n        return text.replace(' ', '')\n\n    def to_char_list(text: str) -> list:\n        \"\"\"Return list of single-character strings from text in order.\"\"\"\n        return list(text)\n\n    if not s:\n        return ()\n\n    filtered = filter_spaces(s)\n    chars = to_char_list(filtered)\n    return tuple(chars)"}
{"task_id": "Mbpp/308", "solution": "import heapq\nfrom typing import List, Optional, Union\n\nNumber = Union[int, float]\n\nclass ValidationResult:\n    \"\"\"Indicates validation success/failure and stores errors.\"\"\"\n    def __init__(self, is_valid: bool, errors: Optional[list] = None):\n        self.is_valid = is_valid\n        self.errors = errors or []\n\nclass NumberList:\n    \"\"\"Encapsulates an input list and provides numeric validation.\"\"\"\n    def __init__(self, elements: List[Number], side: str):\n        self.elements = elements\n        self.side = side\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\n    def validate_numeric(self) -> ValidationResult:\n        \"\"\"Validates that all elements in the list are numeric.\"\"\"\n        errors = []\n        for i, element in enumerate(self.elements):\n            if not isinstance(element, (int, float)):\n                errors.append(f\"Non-numeric element found at index {i} in {self.side} list: {element}\")\n        \n        return ValidationResult(is_valid=not errors, errors=errors)\n\nclass Product:\n    \"\"\"Lightweight value object for product value and original factor indices.\"\"\"\n    def __init__(self, value: Number, factor1_index: int, factor2_index: int):\n        self.value = value\n        self.factor1_index = factor1_index\n        self.factor2_index = factor2_index\n\nclass ResultList:\n    \"\"\"Optional convenience container for returned results.\"\"\"\n    def __init__(self, products: List[Number], k: int):\n        self.products = products\n        self.k = k\n\nclass LargeProductFunction:\n    \"\"\"Orchestrates validation, product generation, and top-k selection.\"\"\"\n    def compute(self, list1: List[Number], list2: List[Number], k: int) -> List[Number]:\n        # 1. Early-exit checks (BR1)\n        if not list1 or not list2 or k <= 0:\n            return []\n\n        # 2. Numeric validation (BR2, FR7)\n        num_list1 = NumberList(list1, 'left')\n        num_list2 = NumberList(list2, 'right')\n\n        validation_result1 = num_list1.validate_numeric()\n        validation_result2 = num_list2.validate_numeric()\n\n        if not validation_result1.is_valid or not validation_result2.is_valid:\n            # Combine errors from both lists, if any\n            all_errors = validation_result1.errors + validation_result2.errors\n            raise TypeError(f\"Non-numeric elements detected: {'; '.join(all_errors)}\")\n\n        # 3. Product generation and Top-K selection using a bounded min-heap (BR3, BR9, NFR2)\n        min_heap: List[tuple[tuple[Number, int, int], Product]] = []\n\n        for i_idx, val1 in enumerate(list1):\n            for j_idx, val2 in enumerate(list2):\n                product_value = val1 * val2\n                product_obj = Product(product_value, i_idx, j_idx)\n                \n                # Heap key for min-heap behavior to find top-k (largest) products.\n                # (value, -factor1_index, -factor2_index) ensures that:\n                # - Larger value is considered 'better' (so smaller value is popped from min-heap).\n                # - For equal values, smaller factor1_index is 'better' (so larger factor1_index is popped from min-heap).\n                # - For equal factor1_index, smaller factor2_index is 'better' (so larger factor2_index is popped from min-heap).\n                heap_entry_key = (product_value, -i_idx, -j_idx)\n                \n                if len(min_heap) < k:\n                    heapq.heappush(min_heap, (heap_entry_key, product_obj))\n                else:\n                    # If current product is 'better' (i.e., its heap_entry_key is greater)\n                    # than the smallest in the heap (the root), replace the root.\n                    if heap_entry_key > min_heap[0][0]:\n                        heapq.heapreplace(min_heap, (heap_entry_key, product_obj))\n        \n        # 4. Finalization and Sorting (BR6, BR7, FR8)\n        # Extract Product objects from the heap\n        final_products: List[Product] = [item[1] for item in min_heap]\n\n        # Sort the extracted Product objects by the specified final ordering:\n        # value descending, then factor1_index ascending, then factor2_index ascending.\n        final_products.sort(key=lambda p: (-p.value, p.factor1_index, p.factor2_index))\n\n        # Return list of numeric product values\n        return [p.value for p in final_products]\n\ndef large_product(list1: List[Number], list2: List[Number], k: int) -> List[Number]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    return LargeProductFunction().compute(list1, list2, k)"}
{"task_id": "Mbpp/312", "solution": "import math\nfrom typing import Any\n\nclass MathLib:\n    \"\"\"Provides mathematical constants like pi.\"\"\"\n    pi: float = math.pi\n\nclass InputValidator:\n    \"\"\"Validates if inputs are numeric.\"\"\"\n    @staticmethod\n    def isNumeric(value: Any) -> bool:\n        \"\"\"Checks if a value is an int or float.\"\"\"\n        return isinstance(value, (int, float))\n\n    @staticmethod\n    def validateDimensions(radius: Any, height: Any) -> None:\n        \"\"\"Ensures radius and height are numeric, raising TypeError otherwise.\"\"\"\n        if not InputValidator.isNumeric(radius):\n            raise TypeError(\"Radius must be a numeric value (int or float).\")\n        if not InputValidator.isNumeric(height):\n            raise TypeError(\"Height must be a numeric value (int or float).\")\n\nclass VolumeCalculator:\n    \"\"\"Calculates the volume of a cone using the standard formula.\"\"\"\n    @staticmethod\n    def computeConeVolume(radius: float, height: float) -> float:\n        \"\"\"Computes cone volume: (1/3) * pi * radius^2 * height.\"\"\"\n        return (1.0 / 3.0) * MathLib.pi * (radius ** 2) * height\n\nclass Cone:\n    \"\"\"A data holder for cone dimensions and its computed volume.\"\"\"\n    def __init__(self, radius: float, height: float) -> None:\n        self.radius = radius\n        self.height = height\n        self.volume: float = 0.0\n\n    def computeVolume(self) -> float:\n        \"\"\"Calculates and stores the cone's volume.\"\"\"\n        self.volume = VolumeCalculator.computeConeVolume(self.radius, self.height)\n        return self.volume\n\ndef volume_cone(radius, height) -> float:\n    \"\"\"\n    Calculates the volume of a cone given its radius and height.\n    Raises TypeError if radius or height are not numeric.\n    \"\"\"\n    InputValidator.validateDimensions(radius, height)\n    result: float = VolumeCalculator.computeConeVolume(float(radius), float(height))\n    return float(result)"}
{"task_id": "Mbpp/311", "solution": "class Bit:\n    \"\"\"Represents a single bit with its position and value.\"\"\"\n    def __init__(self, position: int, value: int) -> None:\n        self.position = position\n        self.value = value\n\nclass IntegerValue:\n    \"\"\"Encapsulates an integer value and provides conversion to binary.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def toBinary(self) -> 'BinaryRepresentation':\n        \"\"\"Converts the integer to its minimal binary string representation.\"\"\"\n        if self.value == 0:\n            binary_string = \"0\"\n        else:\n            binary_string = bin(self.value)[2:]\n        return BinaryRepresentation(binary_string)\n\nclass BinaryRepresentation:\n    \"\"\"Represents a minimal-length binary string and provides bit manipulation.\"\"\"\n    def __init__(self, bits: str) -> None:\n        self.bits = bits\n\n    def to_string(self) -> str:\n        \"\"\"Returns the binary string.\"\"\"\n        return self.bits\n\n    def find_left_most_unset_bit_position(self) -> int | None:\n        \"\"\"Finds the position of the left-most unset bit (0).\"\"\"\n        for i, bit_char in enumerate(self.bits):\n            if bit_char == '0':\n                return i\n        return None\n\n    def set_bit_at_position(self, pos: int) -> 'BinaryRepresentation':\n        \"\"\"Creates a new BinaryRepresentation with the bit at 'pos' set to '1'.\"\"\"\n        bits_list = list(self.bits)\n        bits_list[pos] = '1'\n        new_bits_str = \"\".join(bits_list)\n        return BinaryRepresentation(new_bits_str)\n\n    def to_int(self) -> int:\n        \"\"\"Converts the binary string back to an integer.\"\"\"\n        return int(self.bits, 2)\n\nclass SetLeftMostUnsetBitFunction:\n    \"\"\"Encapsulates the algorithm to find and set the left-most unset bit.\"\"\"\n    def set_left_most_unset_bit(self, n: int) -> int:\n        \"\"\"\n        Sets the left-most unset bit in the binary representation of n.\n        Returns the resulting integer.\n        \"\"\"\n        integer_value = IntegerValue(n)\n        binary_rep = integer_value.toBinary()\n\n        unset_bit_pos = binary_rep.find_left_most_unset_bit_position()\n\n        if unset_bit_pos is not None:\n            new_binary_rep = binary_rep.set_bit_at_position(unset_bit_pos)\n            return new_binary_rep.to_int()\n        else:\n            # If no unset bit is found, return the original number as no bit can be set.\n            return n\n\ndef set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Sets the left-most unset bit in the binary representation of n.\n    Returns the resulting integer.\n    \"\"\"\n    return SetLeftMostUnsetBitFunction().set_left_most_unset_bit(n)"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"Compute and return the largest power of two less than or equal to n.\n    Handles n <= 0 by returning 0, as no positive power of 2 satisfies the condition.\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    power = 1\n    # Continue doubling 'power' as long as it does not exceed n.\n    while (power << 1) <= n:\n        power <<= 1\n    return power"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n):\n    \"\"\"\n    Calculates the n'th Lucas number iteratively.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    # Initialize for L_0 and L_1\n    a, b = 2, 1\n\n    # Iterate from L_2 up to L_n\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    \n    return b"}
{"task_id": "Mbpp/390", "solution": "def add_string(input_list, format_string):\n    \"\"\"\n    Applies a format string to each element in a list, substituting '{0}' with the element's string representation.\n    Returns a new list with the formatted strings, without modifying the original input list.\n    \"\"\"\n    return [format_string.replace('{0}', str(element)) for element in input_list]"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(list1, list2, list3):\n    \"\"\"\n    Converts three lists into a list of nested dictionaries, where each element is `{list1[i]: {list2[i]: list3[i]}}`.\n    Raises ValueError if input lists have unequal lengths.\n    \"\"\"\n    len1 = len(list1)\n    len2 = len(list2)\n    len3 = len(list3)\n\n    if not (len1 == len2 and len2 == len3):\n        raise ValueError(\"Input lists must have equal length\")\n\n    result = []\n    for i in range(len1):\n        inner_dict = {list2[i]: list3[i]}\n        outer_dict = {list1[i]: inner_dict}\n        result.append(outer_dict)\n\n    return result"}
{"task_id": "Mbpp/394", "solution": "def check_distinct(input_tuple: tuple) -> bool:\n    \"\"\"\n    Returns True if all elements in input_tuple are unique; returns False if any duplicates found.\n    Does not modify input_tuple.\n    \"\"\"\n    seen = set()\n    for element in input_tuple:\n        if element in seen:\n            return False\n        seen.add(element)\n    return True"}
{"task_id": "Mbpp/395", "solution": "class StringInput:\n    \"\"\"Encapsulates the incoming string and provides utility methods.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def is_empty(self) -> bool:\n        \"\"\"Returns True if the encapsulated string is empty.\"\"\"\n        return len(self.value) == 0\n\nclass Character:\n    \"\"\"Data carrier for a character and its frequency.\"\"\"\n    def __init__(self, char: str, frequency: int = 0) -> None:\n        self.char = char\n        self.frequency = frequency\n\n    def is_non_repeated(self) -> bool:\n        \"\"\"Returns True if the character's frequency is 1.\"\"\"\n        return self.frequency == 1\n\nclass FrequencyMap:\n    \"\"\"Encapsulates character counting logic.\"\"\"\n    def __init__(self) -> None:\n        self._map: dict[str, int] = {}\n\n    def increment(self, ch: str) -> None:\n        \"\"\"Increments the count for a given character.\"\"\"\n        self._map[ch] = self._map.get(ch, 0) + 1\n\n    def get(self, ch: str) -> int:\n        \"\"\"Returns the frequency of a character, defaulting to 0 if not present.\"\"\"\n        return self._map.get(ch, 0)\n\n    def build_from_string(self, s: str) -> None:\n        \"\"\"Populates the frequency map from a string.\"\"\"\n        for char in s:\n            self.increment(char)\n\nclass NonRepeatingCharacterFinder:\n    \"\"\"Orchestrates finding the first non-repeated character.\"\"\"\n    def first_non_repeating_character(self, s_input: StringInput) -> str | None:\n        \"\"\"\n        Finds the first non-repeated character in the input string.\n        Returns the character (str) or None if no such character exists.\n        \"\"\"\n        if s_input.is_empty():\n            return None\n\n        frequency_map = self._build_frequency_map(s_input)\n\n        for char in s_input.value:\n            if frequency_map.get(char) == 1:\n                return char\n        return None\n\n    def _build_frequency_map(self, s_input: StringInput) -> FrequencyMap:\n        \"\"\"Builds and returns a FrequencyMap from the given StringInput.\"\"\"\n        f_map = FrequencyMap()\n        f_map.build_from_string(s_input.value)\n        return f_map\n\n\ndef first_non_repeating_character(s: str) -> str | None:\n    \"\"\"\n    Accepts a string and returns the first non-repeated character (str) or None.\n    Builds a frequency map over the entire input, then scans left-to-right.\n    \"\"\"\n    string_input = StringInput(s)\n    finder = NonRepeatingCharacterFinder()\n    return finder.first_non_repeating_character(string_input)"}
{"task_id": "Mbpp/392", "solution": "from typing import Optional\n\nclass MemoizationCache:\n    \"\"\"\n    In-memory dictionary-based cache for storing computed values of f(n).\n    Provides methods for storing, retrieving, and checking existence of values.\n    \"\"\"\n    def __init__(self):\n        self._cache = {}\n\n    def store(self, n: int, value: int) -> None:\n        \"\"\"Stores a computed value for a given n.\"\"\"\n        self._cache[n] = value\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a cached value for n, or None if not present.\"\"\"\n        return self._cache.get(n)\n\n    def contains(self, n: int) -> bool:\n        \"\"\"Checks if a value for n is present in the cache.\"\"\"\n        return n in self._cache\n\nclass MaxSumCalculator:\n    \"\"\"\n    Calculates the maximum sum f(n) using the recurrence relation.\n    Utilizes memoization to optimize recursive computations.\n    \"\"\"\n    def __init__(self, cache: MemoizationCache = None):\n        self.cache = cache if cache is not None else MemoizationCache()\n\n    def get_max_sum(self, n: int) -> int:\n        \"\"\"\n        Public method to compute f(n).\n        Delegates to the internal recursive 'compute' method.\n        \"\"\"\n        return self.compute(n)\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Internal recursive method to calculate f(n) with memoization.\n        f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n        \"\"\"\n        if n == 0:\n            return 0\n        \n        if self.cache.contains(n):\n            return self.cache.get(n)\n        \n        sum_subproblems = (\n            self.compute(n // 2) +\n            self.compute(n // 3) +\n            self.compute(n // 4) +\n            self.compute(n // 5)\n        )\n        \n        result = max(sum_subproblems, n)\n        self.cache.store(n, result)\n        return result\n\ndef get_max_sum(n):\n    \"\"\"\n    Finds the maximum sum possible by using the given equation f(n).\n    f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    \"\"\"\n    calculator = MaxSumCalculator()\n    return calculator.get_max_sum(n)"}
{"task_id": "Mbpp/397", "solution": "def validate_inputs(a, b, c) -> bool:\n    \"\"\"\n    Validates if all three inputs are numeric (int or float).\n    \"\"\"\n    return (isinstance(a, (int, float)) and\n            isinstance(b, (int, float)) and\n            isinstance(c, (int, float)))\n\ndef median_numbers(a, b, c) -> float:\n    \"\"\"\n    Calculates the median of three numbers.\n    Raises TypeError if inputs are not numeric.\n    \"\"\"\n    if not validate_inputs(a, b, c):\n        raise TypeError(\"All inputs must be numeric (int or float).\")\n\n    # The sum of three numbers minus their min and max equals the median.\n    median_val = a + b + c - min(a, b, c) - max(a, b, c)\n\n    return float(median_val)"}
{"task_id": "Mbpp/398", "solution": "class IntegerNumber:\n    \"\"\"Represents an integer value and computes its decimal digit sum.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def digitSum(self) -> int:\n        \"\"\"Computes the sum of the decimal digits of the absolute value of the integer.\"\"\"\n        num = abs(self.value)\n        total_digit_sum = 0\n        while num > 0:\n            total_digit_sum += num % 10\n            num //= 10\n        return total_digit_sum\n\nclass IntegerList:\n    \"\"\"A lightweight domain wrapper around a Python list of integers.\"\"\"\n    def __init__(self, numbers: list):\n        self.numbers = numbers\n\nclass Result:\n    \"\"\"A domain container representing the aggregated total digit sum.\"\"\"\n    def __init__(self, total: int):\n        self.total = total\n\nclass SumOfDigitsFunction:\n    \"\"\"Core algorithm: compute per-number digit sums, and aggregate.\"\"\"\n    def sum_of_digits(self, numbers: list) -> int:\n        \"\"\"\n        Computes the sum of digits for each number and aggregates these sums.\n        Assumes input is a list of integers as per primary requirements.\n        \"\"\"\n        current_total_sum = 0\n        integer_list_wrapper = IntegerList(numbers)\n\n        for value in integer_list_wrapper.numbers:\n            integer_number = IntegerNumber(value)\n            current_total_sum += integer_number.digitSum()\n        \n        final_result = Result(current_total_sum)\n        return final_result.total\n\ndef sum_of_digits(numbers: list) -> int:\n    \"\"\"\n    Computes the sum of digits of each number in a given list,\n    then returns the total sum of these digit sums.\n    Delegates the core logic to SumOfDigitsFunction.\n    \"\"\"\n    calculator = SumOfDigitsFunction()\n    return calculator.sum_of_digits(numbers)"}
{"task_id": "Mbpp/404", "solution": "def minimum(a, b):\n    \"\"\"Return the smaller of two numeric values.\n\n    Raises TypeError if either a or b is not an int or float.\n    \"\"\"\n    if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n        raise TypeError(\"Both parameters must be int or float\")\n\n    if a <= b:\n        return a\n    else:\n        return b"}
{"task_id": "Mbpp/405", "solution": "from typing import Any\n\ndef check_tuplex(t: tuple, v: Any) -> bool:\n    \"\"\"Return True if value v equals any element in tuple t, otherwise False.\n\n    Precondition: t is intended to be a tuple (BR-01). Behavior for non-tuple first argument is unspecified in the SRS.\n    \"\"\"\n    for e in t:\n        if e == v:\n            return True\n    return False"}
{"task_id": "Mbpp/409", "solution": "class Pair:\n    \"\"\"Represents a 2-element tuple of integers. Computes their product.\"\"\"\n    def __init__(self, a: int, b: int):\n        self.a = a\n        self.b = b\n\n    def product(self) -> int:\n        \"\"\"Returns the product of the two elements (a * b).\"\"\"\n        return self.a * self.b\n\nclass ListOfPairs:\n    \"\"\"Container for Pair instances, normalizing input tuples to Pair objects.\"\"\"\n    def __init__(self, items: list):\n        self.items = [Pair(item[0], item[1]) for item in items]\n\n    def __iter__(self):\n        \"\"\"Allows iteration over the contained Pair instances.\"\"\"\n        return iter(self.items)\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of Pair instances.\"\"\"\n        return len(self.items)\n\nclass ProductResult:\n    \"\"\"A simple wrapper class for an integer product value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\ndef min_product_tuple(list_of_pairs):\n    \"\"\"\n    Computes the product of elements for each tuple in the list\n    and returns the smallest product found.\n    \"\"\"\n    pairs_container = ListOfPairs(list_of_pairs)\n    \n    products = []\n    for pair in pairs_container:\n        products.append(pair.product())\n    \n    return min(products)"}
{"task_id": "Mbpp/406", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass Number:\n    value: int\n\n@dataclass\nclass ParityResult:\n    is_odd: bool\n\n@dataclass\nclass TestCase:\n    input: int\n    expected: bool\n\nclass ParityChecker:\n    def find_Parity(self, number: int) -> bool:\n        \"\"\"Return True if number is odd else False. Implements parity logic per SRS.\"\"\"\n        return (number % 2) != 0\n\ndef find_Parity(number: int) -> bool:\n    \"\"\"Return True if number is odd, False if number is even. Delegates to ParityChecker.\"\"\"\n    checker = ParityChecker()\n    return checker.find_Parity(number)"}
{"task_id": "Mbpp/412", "solution": "def remove_odd(input_list):\n    \"\"\"remove_odd(input_list) -> list\n\n    Returns a list of even integers from input_list preserving original order.\n    Raises TypeError if input_list is not a list or if any element is not an int.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list\")\n\n    output_list = []\n    for element in input_list:\n        if not isinstance(element, int):\n            raise TypeError(\"all elements must be int\")\n        if element % 2 == 0:\n            output_list.append(element)\n    return output_list"}
{"task_id": "Mbpp/410", "solution": "def _is_numeric(value) -> bool:\n    \"\"\"Return True if value is an instance of int or float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef min_val(input_list):\n    \"\"\"\n    Computes the minimum numeric value in a heterogeneous list.\n    Behavior for lists with no numeric elements or non-list inputs is not specified\n    by the SRS and relies on Python's built-in `min()` behavior.\n    \"\"\"\n    numeric_elements = []\n    for item in input_list:\n        if _is_numeric(item):\n            numeric_elements.append(item)\n    \n    return min(numeric_elements)"}
{"task_id": "Mbpp/414", "solution": "def overlapping(seq1, seq2) -> bool:\n    \"\"\"\n    Checks if any value in seq1 exists in seq2.\n    Returns True if an overlap is found, False otherwise.\n    \"\"\"\n    if not seq1 or not seq2:\n        return False\n\n    try:\n        # Attempt to use a set for O(1) average time complexity lookup.\n        set2 = set(seq2)\n        for item1 in seq1:\n            if item1 in set2:\n                return True\n    except TypeError:\n        # Fallback to nested iteration for unhashable elements.\n        for item1 in seq1:\n            for item2 in seq2:\n                if item1 == item2:\n                    return True\n    \n    return False"}
{"task_id": "Mbpp/413", "solution": "def extract_nth_element(list_of_tuples, n):\n    \"\"\"Extract nth element from each tuple.\n\n    Returns a new list containing tuple[n] for each tuple in list_of_tuples.\n    \"\"\"\n    return [tup[n] for tup in list_of_tuples]"}
{"task_id": "Mbpp/415", "solution": "import math\nfrom typing import List, Tuple\n\nclass InputList:\n    \"\"\"A wrapper for a list of integers with basic access methods.\"\"\"\n    def __init__(self, items: List[int]):\n        self.items = items\n\n    def length(self) -> int:\n        return len(self.items)\n\n    def get(self, i: int) -> int:\n        return self.items[i]\n\nclass IntegerItem:\n    \"\"\"A wrapper for a single integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass IntegerPair:\n    \"\"\"Represents a pair of integers, providing product and normalization.\"\"\"\n    def __init__(self, a: int, b: int):\n        self.a = a\n        self.b = b\n\n    def product(self) -> int:\n        return self.a * self.b\n\n    def normalize(self) -> Tuple[int, int]:\n        return (min(self.a, self.b), max(self.a, self.b))\n\ndef validate_length(items: List[int]) -> None:\n    \"\"\"Raises ValueError if the list has fewer than two elements.\"\"\"\n    if len(items) < 2:\n        raise ValueError(\"items must contain at least two integers\")\n\ndef validate_types(items: List[int]) -> None:\n    \"\"\"Raises TypeError if any element in the list is not an integer.\"\"\"\n    for item in items:\n        if not isinstance(item, int):\n            raise TypeError(\"all elements in items must be integers\")\n\ndef generate_pairs(items: List[int]) -> List[IntegerPair]:\n    \"\"\"Generates all unique unordered pairs from the input list.\"\"\"\n    pairs = []\n    n = len(items)\n    for i in range(n):\n        for j in range(i + 1, n):\n            pairs.append(IntegerPair(items[i], items[j]))\n    return pairs\n\ndef select_max_pair(pairs: List[IntegerPair]) -> IntegerPair:\n    \"\"\"Selects the IntegerPair with the highest product, using a tie-breaker for equal products.\"\"\"\n    if not pairs:\n        raise ValueError(\"No pairs to select from.\")\n\n    max_pair_found = pairs[0]\n    max_product_value = max_pair_found.product()\n    max_normalized_tuple_value = max_pair_found.normalize()\n\n    for i in range(1, len(pairs)):\n        current_pair = pairs[i]\n        current_product = current_pair.product()\n\n        if current_product > max_product_value:\n            max_product_value = current_product\n            max_pair_found = current_pair\n            max_normalized_tuple_value = max_pair_found.normalize()\n        elif current_product == max_product_value:\n            current_normalized_tuple = current_pair.normalize()\n            if current_normalized_tuple > max_normalized_tuple_value:\n                max_pair_found = current_pair\n                max_normalized_tuple_value = current_normalized_tuple\n    return max_pair_found\n\ndef normalize_pair(pair: IntegerPair) -> Tuple[int, int]:\n    \"\"\"Returns the normalized (ascending order) tuple of an IntegerPair.\"\"\"\n    return pair.normalize()\n\ndef max_Product(items: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    Finds a pair with the highest product from a given array of integers.\n    Returns the pair as a tuple (a, b) where a <= b.\n    \"\"\"\n    validate_length(items)\n    validate_types(items)\n    all_pairs = generate_pairs(items)\n    selected_pair = select_max_pair(all_pairs)\n    return normalize_pair(selected_pair)"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(input_list):\n    \"\"\"Return the element of input_list that has the maximum len() value.\n\n    Uses built-in len() to evaluate element lengths and selects the element with maximum len().\n    \"\"\"\n    if not input_list:\n        return None # As per design, unspecified behavior for empty list is not resolved. The provided assertion implies non-empty input.\n\n    max_length_element = input_list[0]\n    for element in input_list:\n        if len(element) > len(max_length_element):\n            max_length_element = element\n    return max_length_element"}
{"task_id": "Mbpp/420", "solution": "def validate_input(n: int) -> None:\n    \"\"\"Validates that n is an integer and n >= 1.\n    Raises ValueError for invalid inputs.\"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\ndef generate_sequence(n: int) -> list[int]:\n    \"\"\"Generates the first n even natural numbers.\"\"\"\n    return [2 * i for i in range(1, n + 1)]\n\ndef compute_cubes(seq: list[int]) -> list[int]:\n    \"\"\"Computes the cube of each number in the sequence.\"\"\"\n    return [x**3 for x in seq]\n\ndef sum_cubes(cubes: list[int]) -> int:\n    \"\"\"Calculates the sum of a list of numbers.\"\"\"\n    return sum(cubes)\n\ndef cube_Sum(n: int) -> int:\n    \"\"\"Finds the cube sum of the first n even natural numbers.\"\"\"\n    validate_input(n)\n    seq = generate_sequence(n)\n    cubes = compute_cubes(seq)\n    result = sum_cubes(cubes)\n    return result"}
