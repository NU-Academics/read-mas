{"task_id": "Mbpp/445", "solution": "from typing import Tuple, Any\n\nclass IndexMultiplicationFunction:\n    def execute(self, tuple1: Tuple[Tuple[Any, ...], ...], tuple2: Tuple[Tuple[Any, ...], ...]) -> Tuple[Tuple[Any, ...], ...]:\n        \"\"\"Validate tuples and return a new tuple-of-tuples with element-wise products.\n        Raises ValueError on outer or inner length mismatch; raises TypeError on incompatible element multiplication.\n        \"\"\"\n        self.validate_outer_length(tuple1, tuple2)\n        if not tuple1: # If both outer tuples are empty (validated by outer_length check)\n            return ()\n        self.validate_inner_lengths(tuple1, tuple2)\n        return self.multiply_elements(tuple1, tuple2)\n\n    def validate_outer_length(self, tuple1: Tuple[Tuple[Any, ...], ...], tuple2: Tuple[Tuple[Any, ...], ...]) -> None:\n        \"\"\"Raise ValueError if len(tuple1) != len(tuple2).\"\"\"\n        if len(tuple1) != len(tuple2):\n            raise ValueError(\"Input tuples must have the same outer length.\")\n\n    def validate_inner_lengths(self, tuple1: Tuple[Tuple[Any, ...], ...], tuple2: Tuple[Tuple[Any, ...], ...]) -> None:\n        \"\"\"For each outer index i raise ValueError if len(tuple1[i]) != len(tuple2[i]).\"\"\"\n        for i in range(len(tuple1)):\n            if len(tuple1[i]) != len(tuple2[i]):\n                raise ValueError(f\"Inner tuples at index {i} must have the same length.\")\n\n    def multiply_elements(self, tuple1: Tuple[Tuple[Any, ...], ...], tuple2: Tuple[Tuple[Any, ...], ...]) -> Tuple[Tuple[Any, ...], ...]:\n        \"\"\"Compute and return the new tuple-of-tuples where result[i][j] = tuple1[i][j] * tuple2[i][j].\"\"\"\n        result_outer_tuple = []\n        for i in range(len(tuple1)):\n            result_inner_tuple = []\n            for j in range(len(tuple1[i])):\n                try:\n                    product = tuple1[i][j] * tuple2[i][j]\n                    result_inner_tuple.append(product)\n                except TypeError as e:\n                    raise TypeError(f\"Incompatible element types for multiplication at index ({i}, {j}): {tuple1[i][j]} and {tuple2[i][j]}\") from e\n            result_outer_tuple.append(tuple(result_inner_tuple))\n        return tuple(result_outer_tuple)\n\ndef index_multiplication(tuple1: Tuple[Tuple[Any, ...], ...], tuple2: Tuple[Tuple[Any, ...], ...]) -> Tuple[Tuple[Any, ...], ...]:\n    \"\"\"Public API: accepts two outer tuples and returns a new tuple-of-tuples of products.\n    Delegates to IndexMultiplicationFunction.execute and documents raised exceptions.\n    \"\"\"\n    return IndexMultiplicationFunction().execute(tuple1, tuple2)"}
{"task_id": "Mbpp/448", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass Input:\n    n: int\n\n@dataclass\nclass SumResult:\n    total: int\n    up_to_index: int\n\nclass PerrinNumber:\n    index: int\n    value: int\n\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\n\n    @staticmethod\n    def compute(index: int) -> int:\n        \"\"\"Compute Perrin number P(index) using definition:\n           P(0)=3, P(1)=0, P(2)=2; for index>=3: P(index)=P(index-2)+P(index-3).\n        \"\"\"\n        if index == 0:\n            return 3\n        elif index == 1:\n            return 0\n        elif index == 2:\n            return 2\n        \n        # Iterative DP for index >= 3\n        # p_prev3 corresponds to P(i-3)\n        # p_prev2 corresponds to P(i-2)\n        # p_prev1 corresponds to P(i-1)\n        p_prev3 = 3  # P(0)\n        p_prev2 = 0  # P(1)\n        p_prev1 = 2  # P(2)\n\n        for _ in range(3, index + 1):\n            p_curr = p_prev3 + p_prev2 # P(i) = P(i-3) + P(i-2)\n            p_prev3 = p_prev2\n            p_prev2 = p_prev1\n            p_prev1 = p_curr\n        return p_prev1\n\nclass CalSumFunction:\n    def cal_sum(self, n: int) -> SumResult:\n        \"\"\"Validate n, compute Perrin numbers P(0)..P(n), aggregate sum,\n           and return SumResult(total, up_to_index=n).\n        \"\"\"\n        self._validate_input(n)\n\n        total_sum = 0\n        for i in range(n + 1):\n            total_sum += PerrinNumber.compute(i)\n        \n        return SumResult(total=total_sum, up_to_index=n)\n\n    def _validate_input(self, n: int) -> None:\n        \"\"\"Raise ValueError if n is negative or not an integer.\"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"n must be an integer.\")\n        if n < 0:\n            raise ValueError(\"n must be a non-negative integer.\")\n\ndef cal_sum(n: int) -> SumResult:\n    \"\"\"Public API function per SRS FR1: delegates to CalSumFunction.\"\"\"\n    calculator = CalSumFunction()\n    return calculator.cal_sum(n)"}
{"task_id": "Mbpp/450", "solution": "def extract_string(list_of_strings, size):\n    \"\"\"\n    Extracts strings of a specified length from a list, preserving order.\n    Returns a new list containing only the matching strings.\n    \"\"\"\n    result = []\n    for s in list_of_strings:\n        if len(s) == size:\n            result.append(s)\n    return result"}
{"task_id": "Mbpp/440", "solution": "import collections\n\ndef find_adverb_position(sentence):\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Delegates to FindAdverbService for core logic.\n    \"\"\"\n    class Sentence:\n        def __init__(self, text: str):\n            self.text = text\n\n        def length(self) -> int:\n            return len(self.text)\n\n    class Adverb:\n        def __init__(self, text: str, start_index: int, end_index: int):\n            self.text = text\n            self.start_index = start_index\n            self.end_index = end_index\n\n        def as_lowercase(self) -> str:\n            return self.text.lower()\n\n    # Module-local TokenRun class as defined in the design\n    class TokenRun:\n        def __init__(self, text: str, start_index: int, end_index: int):\n            self.text = text\n            self.start_index = start_index\n            self.end_index = end_index\n\n        def normalize_text(self) -> str:\n            return self.text.lower()\n\n    class FindAdverbService:\n        def find_adverb_position(self, sentence_obj: \"Sentence\") -> tuple | None:\n            \"\"\"\n            Tokenizes sentence into TokenRun list, matches first run whose normalize_text()\n            endswith 'ly' (case-insensitive), constructs Adverb and returns tuple or None.\n            \"\"\"\n            runs = self.tokenize_alpha_runs(sentence_obj)\n            adverb = self.match_first_ly_token(runs)\n            if adverb:\n                return (adverb.start_index, adverb.end_index, adverb.as_lowercase())\n            return None\n\n        def tokenize_alpha_runs(self, sentence_obj: \"Sentence\") -> list:\n            \"\"\"\n            Scans characters, identifies contiguous alphabetic runs, and records\n            start_index and exclusive end_index for each run.\n            \"\"\"\n            runs = []\n            current_run_start = -1\n            for i, char in enumerate(sentence_obj.text):\n                if char.isalpha():\n                    if current_run_start == -1:\n                        current_run_start = i\n                else:\n                    if current_run_start != -1:\n                        runs.append(TokenRun(sentence_obj.text[current_run_start:i], current_run_start, i))\n                        current_run_start = -1\n            if current_run_start != -1: # Catch last run if sentence ends with alpha chars\n                runs.append(TokenRun(sentence_obj.text[current_run_start:sentence_obj.length()], current_run_start, sentence_obj.length()))\n            return runs\n\n        def match_first_ly_token(self, runs: list) -> \"Adverb\" | None:\n            \"\"\"\n            Iterates runs in order; for the first run where run.normalize_text().endswith('ly'),\n            return an Adverb. Otherwise return None.\n            \"\"\"\n            for run in runs:\n                if run.normalize_text().endswith('ly'):\n                    return Adverb(run.text, run.start_index, run.end_index)\n            return None\n\n    sentence_obj = Sentence(sentence)\n    service = FindAdverbService()\n    result = service.find_adverb_position(sentence_obj)\n    return result"}
{"task_id": "Mbpp/451", "solution": "def remove_whitespaces(input: str) -> str:\n    \"\"\"Accepts a single string parameter and returns a new string with all whitespace characters removed.\n\n    Implementation note: iterate characters and skip those for which str.isspace() is True.\n    \"\"\"\n    cleaned_chars = []\n    for char in input:\n        if not char.isspace():\n            cleaned_chars.append(char)\n    return \"\".join(cleaned_chars)"}
