{"task_id": "Mbpp/419", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import List, Union\n\ndef _round_half_away_from_zero(value: float) -> int:\n    \"\"\"Rounds a float to the nearest integer using the \"round half away from zero\" rule.\"\"\"\n    if value == 0:\n        return 0\n    sign = 1 if value >= 0 else -1\n    abs_val = abs(value)\n    floor_abs = math.floor(abs_val)\n    if abs_val - floor_abs >= 0.5:\n        return sign * (floor_abs + 1)\n    else:\n        return sign * floor_abs\n\n@dataclass\nclass Number:\n    \"\"\"Represents an original numeric value and its rounded integer equivalent.\"\"\"\n    original_value: float\n    rounded_value: int\n\n@dataclass\nclass NumberList:\n    \"\"\"A list of Number objects, with its length.\"\"\"\n    numbers: List[Number]\n\n    @property\n    def length(self) -> int:\n        \"\"\"Returns the number of items in the list.\"\"\"\n        return len(self.numbers)\n\n@dataclass\nclass SumResult:\n    \"\"\"Holds the sum of rounded values, list length, and the final calculated result.\"\"\"\n    rounded_sum: int\n    length: int\n    result: int\n\nclass RoundAndSumFunction:\n    \"\"\"Encapsulates the logic for rounding, summing, and multiplying list elements.\"\"\"\n    def round_and_sum(self, numbers: List[Union[float, int]]) -> int:\n        \"\"\"Processes a list of numbers according to the specified rounding and sum rules.\"\"\"\n        processed_numbers: List[Number] = []\n        for num in numbers:\n            rounded_val = _round_half_away_from_zero(float(num))\n            processed_numbers.append(Number(original_value=float(num), rounded_value=rounded_val))\n\n        number_list_obj = NumberList(numbers=processed_numbers)\n        \n        total_rounded_sum = sum(n.rounded_value for n in number_list_obj.numbers)\n        final_result = total_rounded_sum * number_list_obj.length\n\n        _ = SumResult(rounded_sum=total_rounded_sum, length=number_list_obj.length, result=final_result)\n        return final_result\n\ndef round_and_sum(numbers: List[Union[float, int]]) -> int:\n    \"\"\"\n    Rounds every number of a given list using \"round half away from zero\" rule,\n    and returns the total sum multiplied by the length of the list.\n    \"\"\"\n    return RoundAndSumFunction().round_and_sum(numbers)"}
{"task_id": "Mbpp/422", "solution": "class InputParameter:\n    \"\"\"Encapsulates raw input n and provides predicate checks for validation.\"\"\"\n    def __init__(self, n_val):\n        self.n = n_val\n\n    def is_integer(self) -> bool:\n        \"\"\"Checks if n is an integer.\"\"\"\n        return isinstance(self.n, int)\n\n    def is_positive(self) -> bool:\n        \"\"\"Checks if n is a positive number.\"\"\"\n        return self.n > 0\n\nclass Validator:\n    \"\"\"Validates InputParameter instances and raises ValueError on invalid input.\"\"\"\n    def validate_positive_integer(self, n) -> bool:\n        \"\"\"Checks if n is a positive integer.\"\"\"\n        # The design implies Validator receives the raw 'n' and checks it.\n        # It's not explicitly requiring InputParameter for internal validation here,\n        # but rather checking the raw n against the criteria.\n        return isinstance(n, int) and n > 0\n\n    def raise_on_invalid(self, n) -> None:\n        \"\"\"Raises ValueError if n is not a positive integer.\"\"\"\n        if not self.validate_positive_integer(n):\n            raise ValueError(\"n must be a positive integer > 0\")\n\nclass CubeCalculator:\n    \"\"\"Computes sum of cubes and average using the closed-form formula.\"\"\"\n    def sum_of_cubes_closed_form(self, n: int) -> int:\n        \"\"\"Calculates the sum of cubes using the closed-form formula.\"\"\"\n        # Formula: (n(n+1)/2)^2\n        sum_val = (n * (n + 1) // 2) ** 2\n        return sum_val\n\n    def average_of_cubes(self, n: int) -> float:\n        \"\"\"Calculates the average of cubes using the closed-form formula.\"\"\"\n        # Formula: average = n*(n+1)^2 / 4\n        # Using 4.0 to ensure float division.\n        average = (n * (n + 1)**2) / 4.0\n        return average\n\nclass Result:\n    \"\"\"Simple value object guaranteeing float-typed output.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n\n    def as_float(self) -> float:\n        \"\"\"Returns the stored float value.\"\"\"\n        return float(self.value)\n\ndef find_Average_Of_Cube(n: int) -> float:\n    \"\"\"\n    Calculates the average of cubes of the first n natural numbers.\n\n    Validates n, computes the average using a closed-form formula, and returns\n    the result as a float.\n    \"\"\"\n    # Validate input 'n'\n    validator = Validator()\n    validator.raise_on_invalid(n)\n\n    # Compute the average of cubes\n    calculator = CubeCalculator()\n    average_value = calculator.average_of_cubes(n)\n\n    # Encapsulate and return the result as a float\n    result_obj = Result(average_value)\n    return result_obj.as_float()"}
{"task_id": "Mbpp/425", "solution": "def count_element_in_list(list_of_sublists, element) -> int:\n    \"\"\"Return the number of sublists in list_of_sublists that contain element at least once.\"\"\"\n    count = 0\n    for sublist in list_of_sublists:\n        if element in sublist:\n            count += 1\n    return count"}
{"task_id": "Mbpp/426", "solution": "from typing import List\n\n# Type aliases for conceptual clarity as per design\nInputList = List[int]\nOutputList = List[int]\n\ndef filter_oddnumbers(list: InputList) -> OutputList:\n    \"\"\"Accepts a single list of integers and returns a new list containing only odd integers preserving input order.\"\"\"\n    odd_numbers = []\n    for number in list:\n        if number % 2 != 0:\n            odd_numbers.append(number)\n    return odd_numbers"}
{"task_id": "Mbpp/427", "solution": "class DateInput:\n    \"\"\"Holds raw input string and provides syntactic validation and parsed accessors.\"\"\"\n    def __init__(self, rawDate: str) -> None:\n        self.rawDate = rawDate\n        self.year = None\n        self.month = None\n        self.day = None\n\n    def isValid(self) -> bool:\n        \"\"\"Checks syntactic conformance to 'yyyy-mm-dd'.\"\"\"\n        if len(self.rawDate) != 10:\n            return False\n        if self.rawDate[4] != '-' or self.rawDate[7] != '-':\n            return False\n\n        parts = self.rawDate.split('-')\n        if len(parts) != 3:\n            return False\n\n        year_str, month_str, day_str = parts\n        if not (len(year_str) == 4 and year_str.isdigit()):\n            return False\n        if not (len(month_str) == 2 and month_str.isdigit()):\n            return False\n        if not (len(day_str) == 2 and day_str.isdigit()):\n            return False\n        \n        return True\n\n    def parse(self) -> None:\n        \"\"\"Populates year, month, day fields assuming isValid() is True.\"\"\"\n        parts = self.rawDate.split('-')\n        self.year = parts[0]\n        self.month = parts[1]\n        self.day = parts[2]\n\n    def get_year(self) -> str:\n        return self.year\n\n    def get_month(self) -> str:\n        return self.month\n\n    def get_day(self) -> str:\n        return self.day\n\nclass FormattedDate:\n    \"\"\"Represents separated date parts and produces formatted string 'dd-mm-yyyy'.\"\"\"\n    def __init__(self, day: str, month: str, year: str) -> None:\n        self.day = day\n        self.month = month\n        self.year = year\n\n    def toString(self) -> str:\n        \"\"\"Returns formatted 'dd-mm-yyyy'.\"\"\"\n        return f\"{self.day}-{self.month}-{self.year}\"\n\n    def __str__(self) -> str:\n        \"\"\"Alias to toString().\"\"\"\n        return self.toString()\n\nclass DateFormatter:\n    \"\"\"Coordinates validation and conversion of date formats.\"\"\"\n    def change_date_format(self, rawDate: str) -> str:\n        \"\"\"Validates rawDate, parses components, and returns 'dd-mm-yyyy'.\"\"\"\n        date_input = self._validate_and_build_input(rawDate)\n        \n        day = date_input.get_day()\n        month = date_input.get_month()\n        year = date_input.get_year()\n        \n        formatted_date = FormattedDate(day, month, year)\n        return formatted_date.toString()\n\n    def _validate_and_build_input(self, rawDate: str) -> DateInput:\n        \"\"\"Internal helper to create and validate DateInput; raises ValueError for invalid format.\"\"\"\n        date_input = DateInput(rawDate)\n        if not date_input.isValid():\n            raise ValueError(\"Invalid date format. Expected 'yyyy-mm-dd'.\")\n        date_input.parse()\n        return date_input\n\ndef change_date_format(rawDate: str) -> str:\n    \"\"\"Converts a date from 'yyyy-mm-dd' format to 'dd-mm-yyyy' format.\"\"\"\n    formatter = DateFormatter()\n    return formatter.change_date_format(rawDate)"}
{"task_id": "Mbpp/428", "solution": "import dataclasses\nfrom typing import List, Any\n\n\n@dataclasses.dataclass\nclass InputArray:\n    values: list[int]\n    length: int\n\n@dataclasses.dataclass\nclass OutputArray:\n    values: list[int]\n    length: int\n\n\nclass ArrayValidator:\n    \"\"\"Validates array preconditions.\"\"\"\n    def is_not_null(self, arr: list[Any]) -> bool:\n        \"\"\"Checks if the array is not None.\"\"\"\n        return arr is not None\n\n    def is_integer_array(self, arr: list[Any]) -> bool:\n        \"\"\"Checks if all elements in the array are integers.\"\"\"\n        return all(isinstance(x, int) for x in arr)\n\n\nclass ShellSortAlgorithm:\n    \"\"\"Implements the Shell sort algorithm and gap sequence generation.\"\"\"\n    def sort(self, arr: list[int], gap_sequence: list[int]) -> None:\n        \"\"\"Sorts the array in-place using the Shell sort algorithm.\"\"\"\n        n = len(arr)\n        for gap in gap_sequence:\n            for i in range(gap, n):\n                temp = arr[i]\n                j = i\n                while j >= gap and arr[j - gap] > temp:\n                    arr[j] = arr[j - gap]\n                    j -= gap\n                arr[j] = temp\n\n    def default_gap_sequence(self, n: int) -> list[int]:\n        \"\"\"Generates a default (Knuth) gap sequence for Shell sort.\"\"\"\n        gaps = []\n        h = 1\n        while h < n // 3:\n            h = 3 * h + 1\n        while h >= 1:\n            gaps.append(h)\n            h //= 3\n        return gaps\n\n\nclass ShellSortFunction:\n    \"\"\"Orchestrates validation and delegates sorting to ShellSortAlgorithm.\"\"\"\n    def shell_sort(self, arr: list[int]) -> list[int]:\n        \"\"\"Validates input, performs Shell sort, and returns the sorted list.\"\"\"\n        self.validateInput(arr)\n        \n        # Create a copy to ensure the original list is not modified if it's not desired (though design allows in-place)\n        # However, the design also mentions \"in-place sorting is used in sequence diagrams\", so we can use the input directly.\n        # But to match the return of a \"new list\" conceptually and avoid unexpected side effects to the caller if they\n        # didn't expect in-place, we will clone it.\n        # Rereading \"Whether sorting is in-place or returns a new list is an implementation detail that the orchestrator may choose\"\n        # and \"the design provides an in-place Shell sort implementation option invoked by ShellSortFunction via ShellSortAlgorithm.sort\".\n        # The sequence diagram shows `Algo-->>Orch: (in-place sorted arr)`, and `Orch->>Out: construct OutputArray(values=arr)`\n        # This implies `arr` is modified in place and then returned. So, no copy is strictly necessary here.\n        \n        input_data = InputArray(values=arr, length=len(arr)) # Used for clarity, but the algorithm operates on `arr` directly.\n\n        if len(arr) > 0:\n            self._performShellSort(arr)\n\n        output_data = OutputArray(values=arr, length=len(arr)) # Returns the modified input array.\n        return output_data.values\n\n    def validateInput(self, arr: list[int]) -> bool:\n        \"\"\"Validates the input array against preconditions.\"\"\"\n        validator = ArrayValidator()\n        if not validator.is_not_null(arr):\n            raise ValueError(\"Input array cannot be None.\")\n        if not validator.is_integer_array(arr):\n            raise TypeError(\"Input array must contain only integer elements.\")\n        return True\n\n    def _performShellSort(self, arr: list[int]) -> None:\n        \"\"\"Performs the Shell sort on the given array.\"\"\"\n        algo = ShellSortAlgorithm()\n        gap_sequence = algo.default_gap_sequence(len(arr))\n        algo.sort(arr, gap_sequence)\n\n\ndef shell_sort(arr: list[int]) -> list[int]:\n    \"\"\"Sorts the given array by using shell sort.\"\"\"\n    sorter = ShellSortFunction()\n    return sorter.shell_sort(arr)"}
{"task_id": "Mbpp/433", "solution": "def _is_number(value) -> bool:\n    \"\"\"Checks if a value is an integer or a float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef _validate_inputs(array, number) -> None:\n    \"\"\"Validates that inputs are numeric and array is iterable, raising TypeError on invalid input.\"\"\"\n    if not isinstance(array, (list, tuple)):\n        raise TypeError(\"Input 'array' must be a list or tuple of numbers.\")\n    if not _is_number(number):\n        raise TypeError(\"Input 'number' must be an int or float.\")\n    for i, element in enumerate(array):\n        if not _is_number(element):\n            raise TypeError(f\"Array element at index {i} ('{element}') is not an int or float.\")\n\ndef check_greater(array, number) -> bool:\n    \"\"\"\n    Checks if the entered number is strictly greater than all elements of the given array.\n    Raises TypeError if inputs are not numeric or array is not iterable.\n    \"\"\"\n    _validate_inputs(array, number)\n\n    for element in array:\n        if number <= element:\n            return False\n    return True"}
