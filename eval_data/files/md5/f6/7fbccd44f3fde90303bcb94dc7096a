{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"\n    Moves all ASCII digit characters to the end of the given string,\n    preserving the relative order of non-digit characters and digit characters.\n    \"\"\"\n    non_digits = []\n    digits = []\n    for char in input_string:\n        if '0' <= char <= '9':\n            digits.append(char)\n        else:\n            non_digits.append(char)\n    return \"\".join(non_digits) + \"\".join(digits)"}
{"task_id": "Mbpp/623", "solution": "class NumberList:\n    def __init__(self, values: list) -> None:\n        self._values = list(values)\n    def get_values(self) -> list:\n        return list(self._values)\n\nclass Exponent:\n    def __init__(self, n: int) -> None:\n        self._n = n\n    def is_integer(self) -> bool:\n        return isinstance(self._n, int)\n    def get_value(self) -> int:\n        return self._n\n\nclass ResultList:\n    def __init__(self, values: list) -> None:\n        self._values = list(values)\n    def get_values(self) -> list:\n        return list(self._values)\n\nclass InputValidator:\n    def validate(self, values, n) -> None:\n        \"\"\"Raise TypeError if 'values' is not a list or 'n' is not an integer.\"\"\"\n        if not isinstance(values, list):\n            raise TypeError(\"values must be a list\")\n        if not isinstance(n, int):\n            raise TypeError(\"n must be an integer\")\n\ndef nth_nums(values, n):\n    \"\"\"Public API for computing the n-th power of numbers in a list.\n    Orchestrates validation, domain wrapping, and element-wise exponentiation.\"\"\"\n    InputValidator().validate(values, n)\n    num_list = NumberList(values)\n    exp = Exponent(n)\n    \n    if not num_list.get_values():\n        return []\n    \n    results = [v ** exp.get_value() for v in num_list.get_values()]\n    return ResultList(results).get_values()"}
{"task_id": "Mbpp/622", "solution": "from typing import List\n\ndef get_median(A: List[float], B: List[float], n: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size n.\n    The median for 2n elements is the average of the n-th and (n+1)-th smallest elements (1-based).\n    \"\"\"\n    \n    i = 0  # Pointer for list A\n    j = 0  # Pointer for list B\n\n    median1 = 0.0 # Stores the (n)-th smallest element found so far.\n    median2 = 0.0 # Stores the (n+1)-th smallest element found so far.\n\n    # Iterate n+1 times to find the n-th and (n+1)-th elements from the combined sorted list.\n    for count in range(n + 1):\n        # The element found in the previous iteration (which was median2)\n        # becomes median1 for the current step.\n        median1 = median2 \n\n        # Compare elements from both lists and pick the smaller one.\n        if i < n and j < n:\n            if A[i] <= B[j]:\n                median2 = A[i]\n                i += 1\n            else:\n                median2 = B[j]\n                j += 1\n        # If list A is exhausted, take from list B.\n        elif i < n:\n            median2 = A[i]\n            i += 1\n        # If list B is exhausted, take from list A.\n        elif j < n:\n            median2 = B[j]\n            j += 1\n            \n    # The median is the average of the n-th (median1) and (n+1)-th (median2) smallest elements.\n    return (median1 + median2) / 2.0"}
{"task_id": "Mbpp/620", "solution": "from typing import List\n\n# Domain Classes (internal definitions as if imported from src.domain)\n\nclass IntegerElement:\n    \"\"\"Value object wrapping a single integer.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value: int = value\n\nclass InputList:\n    \"\"\"Encapsulates raw input integers as IntegerElement objects and preserves input order.\"\"\"\n    def __init__(self, rawElements: List[int]) -> None:\n        self.elements: List[IntegerElement] = [IntegerElement(val) for val in rawElements]\n\nclass DivisibilityRelation:\n    \"\"\"Encapsulates divisibility rule and handles division-by-zero.\"\"\"\n    def divides(self, a: IntegerElement, b: IntegerElement) -> bool:\n        \"\"\"Returns True iff a.value != 0 and (b.value % a.value) == 0; raises ValueError on a.value == 0.\"\"\"\n        if a.value == 0:\n            raise ValueError(\"Divisor (a.value) cannot be zero.\")\n        return b.value % a.value == 0\n\nclass Subset:\n    \"\"\"Represents a candidate subset and tests whether every unordered pair satisfies divisibility.\"\"\"\n    def __init__(self, elements: List[IntegerElement]) -> None:\n        self.elements: List[IntegerElement] = elements\n\n    def size(self) -> int:\n        \"\"\"Returns the size of the subset.\"\"\"\n        return len(self.elements)\n\n    def isPairwiseDivisible(self, rel: DivisibilityRelation) -> bool:\n        \"\"\"\n        Returns True iff for every unordered pair (a,b) in elements,\n        rel.divides(a,b) or rel.divides(b,a) returns True.\n        \"\"\"\n        if self.size() <= 1:\n            return True\n\n        sorted_elements = sorted(self.elements, key=lambda x: x.value)\n\n        for i in range(len(sorted_elements)):\n            for j in range(i + 1, len(sorted_elements)):\n                el1 = sorted_elements[i]\n                el2 = sorted_elements[j]\n                # For positive integers, since el1.value <= el2.value,\n                # 'el2 divides el1' is only true if el1 == el2 or el1 == 0.\n                # If el1.value == 0, it raises ValueError.\n                # Otherwise, the condition simplifies to checking if el1 divides el2.\n                if not rel.divides(el1, el2):\n                    return False\n        return True\n\nclass Result:\n    \"\"\"Simple data object holding the integer size of the chosen maximal subset.\"\"\"\n    def __init__(self, size: int) -> None:\n        self.size: int = size\n\ndef largest_subset(elements: List[int]) -> int:\n    \"\"\"Compute and return size of the largest pairwise-divisible subset.\"\"\"\n    if not elements:\n        return 0\n\n    # Sort the input elements to ensure deterministic processing and\n    # to enable the Longest Divisible Subsequence (LDS) dynamic programming approach.\n    sorted_raw_elements = sorted(elements)\n\n    input_list = InputList(sorted_raw_elements)\n    rel = DivisibilityRelation()\n\n    n = len(input_list.elements)\n    if n == 0:\n        return 0\n\n    # dp[i] stores the length of the longest divisible subset ending with input_list.elements[i].\n    dp = [1] * n\n    max_size = 1\n\n    for i in range(n):\n        current_el = input_list.elements[i]\n        for j in range(i):\n            prev_el = input_list.elements[j]\n            # We check if 'prev_el' divides 'current_el' to extend the divisible chain.\n            try:\n                if rel.divides(prev_el, current_el):\n                    dp[i] = max(dp[i], dp[j] + 1)\n            except ValueError:\n                # As per design, division by zero from DivisibilityRelation.divides propagates.\n                raise\n\n        max_size = max(max_size, dp[i])\n\n    result = Result(max_size)\n    return result.size"}
