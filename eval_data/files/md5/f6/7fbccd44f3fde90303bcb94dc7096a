{"task_id": "Mbpp/463", "solution": "from typing import List\n\ndef max_subarray_product(array: List[int]) -> int:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray within the given array.\n    Handles positive, negative, and zero integers correctly, per specified design.\n    \"\"\"\n    if not array:\n        raise ValueError(\"Input array cannot be empty.\")\n\n    # max_so_far stores the overall maximum product found till the current point.\n    # max_ending_here stores the maximum product of a subarray ending at the current position.\n    # min_ending_here stores the minimum product of a subarray ending at the current position.\n    # The min_ending_here is crucial for handling negative numbers, as a very small\n    # negative number multiplied by another negative number could become a very large positive number.\n    max_so_far = array[0]\n    max_ending_here = array[0]\n    min_ending_here = array[0]\n\n    for i in range(1, len(array)):\n        num = array[i]\n        \n        # If the current number is negative, swapping max_ending_here and min_ending_here\n        # ensures that when we multiply by 'num', the 'old' max_ending_here will become\n        # a candidate for the new min_ending_here, and vice-versa for min_ending_here.\n        if num < 0:\n            max_ending_here, min_ending_here = min_ending_here, max_ending_here\n        \n        # A subarray ending at 'num' can either be 'num' itself,\n        # or 'num' multiplied by the max product of a subarray ending at the previous position.\n        max_ending_here = max(num, max_ending_here * num)\n        # Similarly for the minimum product.\n        min_ending_here = min(num, min_ending_here * num)\n        \n        # Update the overall maximum product found so far.\n        max_so_far = max(max_so_far, max_ending_here)\n\n    return max_so_far"}
{"task_id": "Mbpp/462", "solution": "class Combination:\n    \"\"\"Data holder for a combination with its items and mask.\"\"\"\n    def __init__(self, items: list, mask: int):\n        self.items = items\n        self.mask = mask\n\nclass CombinationGenerator:\n    \"\"\"Encapsulates the algorithm to enumerate combinations by mask iteration.\"\"\"\n    def combinations_list(self, items: list) -> list:\n        \"\"\"\n        Returns a list of combination lists ordered by mask,\n        with items inside each combination in descending input-index order.\n        \"\"\"\n        n = len(items)\n        num_masks = 1 << n  # Equivalent to 2**n\n        \n        result_combinations = []\n        for mask in range(num_masks):\n            combination_items = []\n            # Iterate through input items in reverse order to get descending input-index order\n            for i in range(n - 1, -1, -1):\n                # Check if the i-th bit (from LSB) of the mask is set\n                if (mask >> i) & 1:\n                    combination_items.append(items[i])\n            result_combinations.append(combination_items)\n            \n        return result_combinations\n\n    def computeMaskCount(self, n: int) -> int:\n        \"\"\"Returns the number of masks / combinations for input length n (i.e., 2**n).\"\"\"\n        return 1 << n\n\ndef combinations_list(items: list) -> list:\n    \"\"\"Public API. Delegates to CombinationGenerator for implementation.\"\"\"\n    gen = CombinationGenerator()\n    return gen.combinations_list(items)"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(array, n):\n    \"\"\"\n    Compute product of integers in 'array' and return product % n.\n    Raise ValueError if n == 0.\n    \"\"\"\n    if n == 0:\n        raise ValueError(\"n must not be zero\")\n\n    product = 1\n    for element in array:\n        product = (product * element) % n\n    \n    return product"}
{"task_id": "Mbpp/468", "solution": "import math\nfrom typing import List, Union, Optional\n\nclass Element:\n    \"\"\"Represents a single element with its numeric value and original index.\"\"\"\n    def __init__(self, value: Union[int, float], index: int):\n        self.value = value\n        self.index = index\n\nclass Subsequence:\n    \"\"\"Represents a subsequence, computes and caches its product, and checks strictly increasing property.\"\"\"\n    def __init__(self, elements: List[Union[int, float]]):\n        self.elements = elements\n        self._product: Optional[Union[int, float]] = None\n\n    def isStrictlyIncreasing(self) -> bool:\n        \"\"\"Returns True if the subsequence is strictly increasing.\"\"\"\n        if not self.elements:\n            return True\n        for i in range(1, len(self.elements)):\n            if self.elements[i] <= self.elements[i-1]:\n                return False\n        return True\n\n    def computeProduct(self) -> Union[int, float]:\n        \"\"\"Computes and caches the subsequence product.\"\"\"\n        if self._product is not None:\n            return self._product\n        \n        if not self.elements:\n            self._product = 1\n        else:\n            current_product = 1\n            for elem in self.elements:\n                current_product *= elem\n            self._product = current_product\n        return self._product\n\n    @property\n    def product(self) -> Union[int, float]:\n        \"\"\"Returns the cached product, computing it if not already done.\"\"\"\n        if self._product is None:\n            self.computeProduct()\n        return self._product\n\nclass InputArray:\n    \"\"\"Encapsulates input list and provides numeric validation.\"\"\"\n    def __init__(self, array: List[Union[int, float]]):\n        self.elements = array\n\n    def validateNumeric(self):\n        \"\"\"Ensures all entries in the array are numeric (integers or floats).\"\"\"\n        for elem in self.elements:\n            if not isinstance(elem, (int, float)):\n                raise TypeError(\"All elements in the input array must be numeric.\")\n\nclass ProductCalculation:\n    \"\"\"Generates strictly increasing subsequences, computes products, and selects maximum product.\"\"\"\n    def computeAllSubsequences(self, input_array: InputArray) -> List[Subsequence]:\n        \"\"\"Enumerates all strictly increasing subsequences preserving original index order.\"\"\"\n        elements = input_array.elements\n        all_subsequences: List[Subsequence] = []\n        \n        subsequences_ending_at_index: List[List[Subsequence]] = [[] for _ in range(len(elements))]\n\n        for i, current_val in enumerate(elements):\n            single_elem_subseq = Subsequence(elements=[current_val])\n            subsequences_ending_at_index[i].append(single_elem_subseq)\n            all_subsequences.append(single_elem_subseq)\n\n            for j in range(i):\n                prev_val = elements[j]\n                if current_val > prev_val:\n                    for prev_subseq in subsequences_ending_at_index[j]:\n                        new_elements = prev_subseq.elements + [current_val]\n                        new_subseq = Subsequence(elements=new_elements)\n                        subsequences_ending_at_index[i].append(new_subseq)\n                        all_subsequences.append(new_subseq)\n        \n        return all_subsequences\n\n    def selectMaxProduct(self, subsequences: List[Subsequence]) -> Union[int, float]:\n        \"\"\"Determines the maximum product among given subsequences.\"\"\"\n        if not subsequences:\n            return -math.inf\n\n        max_prod = -math.inf\n        for subseq in subsequences:\n            max_prod = max(max_prod, subseq.product)\n        return max_prod\n\nclass MaxProductResult:\n    \"\"\"Simple wrapper for the result value.\"\"\"\n    def __init__(self, value: Union[int, float]):\n        self.value = value\n\ndef max_product(array: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence of that array.\n    \"\"\"\n    if not array:\n        return 0\n\n    input_array = InputArray(array)\n    input_array.validateNumeric()\n\n    product_calculation = ProductCalculation()\n    \n    all_subsequences = product_calculation.computeAllSubsequences(input_array)\n    \n    for s in all_subsequences:\n        s.computeProduct()\n\n    max_subsequence_product = product_calculation.selectMaxProduct(all_subsequences)\n\n    max_single_element = max(input_array.elements)\n\n    return max(max_subsequence_product, max_single_element)"}
{"task_id": "Mbpp/470", "solution": "from typing import Tuple, Any\n\ndef _is_numeric(value: Any) -> bool:\n    \"\"\"Checks if a given value is an integer or a float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef _validate_input(input_tuple: tuple) -> None:\n    \"\"\"Validates the input to ensure it is a tuple containing only numeric elements.\"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n    for element in input_tuple:\n        if not _is_numeric(element):\n            raise TypeError(\"All elements in the tuple must be numeric (int or float).\")\n\ndef add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Computes the pairwise addition of neighboring elements of the given tuple.\n    It validates the input for type and element numericity, raising TypeError on invalid input.\n    \"\"\"\n    _validate_input(input_tuple)\n\n    if len(input_tuple) < 2:\n        return ()\n\n    results = []\n    for i in range(len(input_tuple) - 1):\n        results.append(input_tuple[i] + input_tuple[i+1])\n\n    return tuple(results)"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(list_input):\n    \"\"\"\n    Checks if a given list of numbers contains consecutive numbers,\n    meaning the absolute difference between adjacent elements is exactly 1.\n    \"\"\"\n    if len(list_input) < 2:\n        # A list with less than two elements is considered consecutive\n        # as there are no adjacent pairs to violate the condition.\n        return True\n\n    for i in range(len(list_input) - 1):\n        if abs(list_input[i] - list_input[i+1]) != 1:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/473", "solution": "from typing import List, Tuple, Set\n\nclass TuplePair:\n    \"\"\"Represent a 2-element integer tuple, providing canonicalization and supporting hashing.\"\"\"\n    def __init__(self, a: int, b: int):\n        self.a = a\n        self.b = b\n\n    def canonical(self) -> 'TuplePair':\n        \"\"\"Return a new TuplePair with elements ordered such that a <= b.\"\"\"\n        return TuplePair(min(self.a, self.b), max(self.a, self.b))\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"Compare this TuplePair with another for equality.\"\"\"\n        if not isinstance(other, TuplePair):\n            return NotImplemented\n        return self.a == other.a and self.b == other.b\n\n    def __hash__(self) -> int:\n        \"\"\"Return the hash value for this TuplePair, essential for set operations.\"\"\"\n        return hash((self.a, self.b))\n\n    def equals_unordered(self, other: 'TuplePair') -> bool:\n        \"\"\"Compare this TuplePair with another, treating pairs as unordered.\"\"\"\n        return self.canonical() == other.canonical()\n\nclass TupleList:\n    \"\"\"Represent an input collection of TuplePair elements and facilitate conversion to a canonical set.\"\"\"\n    def __init__(self, tuples: List[TuplePair]):\n        self.tuples = tuples\n\n    def toCanonicalSet(self) -> Set[TuplePair]:\n        \"\"\"Convert all contained TuplePair elements to their canonical form and return them as a set.\"\"\"\n        return {tp.canonical() for tp in self.tuples}\n\nclass ResultSet:\n    \"\"\"Container for the intersection result, holding a set of canonical TuplePair items.\"\"\"\n    def __init__(self, items: Set[TuplePair]):\n        self.items = items\n\n    def to_native_set(self) -> Set[Tuple[int, int]]:\n        \"\"\"Convert the internal set of TuplePair objects into a native Python set of 2-element tuples.\"\"\"\n        return {(tp.a, tp.b) for tp in self.items}\n\nclass TupleIntersectionFunction:\n    \"\"\"Encapsulate the algorithm for computing the intersection of two lists of tuples.\"\"\"\n    def tuple_intersection(self, listA: 'TupleList', listB: 'TupleList') -> 'ResultSet':\n        \"\"\"Compute the intersection of two TupleList objects, returning a ResultSet of canonical pairs.\"\"\"\n        set_a_canonical = listA.toCanonicalSet()\n        set_b_canonical = listB.toCanonicalSet()\n        intersection_set = set_a_canonical.intersection(set_b_canonical)\n        return ResultSet(intersection_set)\n\ndef tuple_intersection(listA: List[Tuple[int, int]], listB: List[Tuple[int, int]]) -> Set[Tuple[int, int]]:\n    \"\"\"\n    Finds the tuple intersection of elements in the given tuple list irrespective of their order.\n    Returns a set of canonical 2-element tuples (smaller element first).\n    \"\"\"\n    tuple_list_a_objs = TupleList([TuplePair(x, y) for x, y in listA])\n    tuple_list_b_objs = TupleList([TuplePair(x, y) for x, y in listB])\n\n    intersection_service = TupleIntersectionFunction()\n    result_set = intersection_service.tuple_intersection(tuple_list_a_objs, tuple_list_b_objs)\n\n    return result_set.to_native_set()"}
{"task_id": "Mbpp/475", "solution": "def sort_counter(input: dict) -> list[tuple]:\n    \"\"\"Sorts a dictionary by its values in descending order.\"\"\"\n    return sorted(input.items(), key=lambda item: item[1], reverse=True)"}
{"task_id": "Mbpp/474", "solution": "def validate_inputs(input_string, target_char, replacement_char):\n    \"\"\"\n    Validates the types and lengths of input parameters.\n    Raises TypeError if validation fails.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"input_string must be a string\")\n    if not isinstance(target_char, str) or len(target_char) != 1:\n        raise TypeError(\"target_char must be a single-character string\")\n    if not isinstance(replacement_char, str) or len(replacement_char) != 1:\n        raise TypeError(\"replacement_char must be a single-character string\")\n\ndef replace_char(input_string: str, target_char: str, replacement_char: str) -> str:\n    \"\"\"\n    Replaces all occurrences of a target character with a replacement character in a string.\n    Inputs are validated for type and single-character constraint.\n    \"\"\"\n    validate_inputs(input_string, target_char, replacement_char)\n\n    if input_string == \"\":\n        return \"\"\n    if target_char == replacement_char:\n        return input_string\n    if target_char not in input_string:\n        return input_string\n\n    chars = []\n    for ch in input_string:\n        if ch == target_char:\n            chars.append(replacement_char)\n        else:\n            chars.append(ch)\n    return ''.join(chars)"}
