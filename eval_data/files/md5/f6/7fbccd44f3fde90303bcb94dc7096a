{"task_id": "Mbpp/255", "solution": "class Element:\n    \"\"\"A simple wrapper for a single element value.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def get(self):\n        \"\"\"Returns the wrapped value.\"\"\"\n        return self.value\n\nclass CombinationResult:\n    \"\"\"Represents one generated combination as a tuple of Element instances.\"\"\"\n    def __init__(self, values: tuple):\n        # values is expected to be a tuple of Element instances\n        self.values = values\n        self.length = len(values)\n\n    def to_tuple(self) -> tuple:\n        \"\"\"Converts the combination of Element instances to a tuple of raw values.\"\"\"\n        return tuple(e.get() for e in self.values)\n\nclass CombinationGenerator:\n    \"\"\"Encapsulates algorithm and validation for generating combinations with repetition.\"\"\"\n    def __init__(self, input_list, n):\n        self.input_list = input_list\n        self.n = n\n        self._results = [] # Stores CombinationResult objects\n\n    def validate_input(self) -> bool:\n        \"\"\"Validates that input_list is a list, n is an int, and n is not negative.\"\"\"\n        if not isinstance(self.input_list, list):\n            return False\n        if not isinstance(self.n, int):\n            return False\n        if self.n < 0: # Combinations of negative length are not meaningful\n            return False\n        return True\n\n    def _generate_recursive(self, current_combo_values: list, k: int):\n        \"\"\"Recursive helper to build combinations of raw values.\"\"\"\n        if k == 0:\n            # Base case: a combination of desired length n is formed.\n            # Wrap raw values in Element objects and create a CombinationResult.\n            self._results.append(CombinationResult(tuple(Element(v) for v in current_combo_values)))\n            return\n\n        # Iterate through the input_list to pick the next element\n        for element_value in self.input_list:\n            current_combo_values.append(element_value)\n            self._generate_recursive(current_combo_values, k - 1)\n            current_combo_values.pop() # Backtrack for the next iteration\n\n    def generate(self) -> list:\n        \"\"\"Generates all combinations and returns a list of CombinationResult objects.\"\"\"\n        if self.n == 0:\n            # Special case for n=0, always yields one empty combination.\n            self._results.append(CombinationResult(tuple()))\n            return self._results\n            \n        if not self.input_list and self.n > 0:\n            # If the input list is empty and n > 0, no combinations can be formed.\n            return []\n\n        # Start the recursive generation process.\n        self._generate_recursive([], self.n)\n        return self._results\n\ndef combinations_colors(input_list, n) -> list:\n    \"\"\"\n    Generates all combinations (with repetition) of elements from input_list of length n.\n    Returns a list where each element is a tuple for each combination.\n    \"\"\"\n    generator = CombinationGenerator(input_list, n)\n    if not generator.validate_input():\n        raise ValueError(\"Invalid input_list or n\")\n    \n    combination_results = generator.generate()\n    \n    # Convert the list of CombinationResult objects to a list of tuples of raw values.\n    return [cr.to_tuple() for cr in combination_results]"}
{"task_id": "Mbpp/256", "solution": "class InputNumber:\n    \"\"\"Represents a numeric input and provides checks for its properties.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def is_numeric(self):\n        \"\"\"Checks if the value is an integer or float.\"\"\"\n        return isinstance(self.value, (int, float))\n\n    def is_non_negative(self):\n        \"\"\"Checks if the value is non-negative.\"\"\"\n        return self.value >= 0\n\nclass Validator:\n    \"\"\"Validates input according to business rules, raising ValueError for invalid inputs.\"\"\"\n    def validate(self, n):\n        \"\"\"Validates if n is a non-negative number.\"\"\"\n        inp = InputNumber(n)\n        if not inp.is_numeric() or not inp.is_non_negative():\n            raise ValueError(\"Input must be a non-negative number.\")\n\nclass PrimeNumber:\n    \"\"\"Encapsulates an integer and provides a method to check if it's prime.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def is_prime(self):\n        \"\"\"Checks if the encapsulated value is a prime number.\"\"\"\n        if not isinstance(self.value, int) or self.value <= 1:\n            return False\n        if self.value <= 3:\n            return True\n        if self.value % 2 == 0 or self.value % 3 == 0:\n            return False\n        i = 5\n        while i * i <= self.value:\n            if self.value % i == 0 or self.value % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\nclass PrimeGenerator:\n    \"\"\"Generates a list of prime numbers less than a given bound.\"\"\"\n    def generate_primes_less_than(self, bound):\n        \"\"\"Returns a list of prime numbers strictly less than the bound.\"\"\"\n        primes = []\n        # Iterate up to but not including the bound, handling non-integer bounds strictly.\n        # Candidates are integers.\n        for candidate in range(2, int(bound) + 1):\n            if candidate < bound: # Strict comparison for the bound as per BR-4, BR-6\n                pn = PrimeNumber(candidate)\n                if pn.is_prime():\n                    primes.append(candidate)\n        return primes\n\nclass Result:\n    \"\"\"A simple data holder for the count of primes.\"\"\"\n    def __init__(self, count):\n        self.count = count\n\ndef count_Primes_nums(n):\n    \"\"\"\n    Counts the number of prime numbers strictly less than a given non-negative number.\n    Raises ValueError for non-numeric or negative inputs.\n    \"\"\"\n    Validator().validate(n)\n\n    if n <= 2:\n        return 0\n\n    prime_generator = PrimeGenerator()\n    primes = prime_generator.generate_primes_less_than(n)\n\n    result = Result(len(primes))\n    return result.count"}
