{"task_id": "Mbpp/170", "solution": "class SumRangeFunction:\n    \"\"\"Encapsulates validation and summation logic for a list range.\"\"\"\n\n    def validate_indices(self, lst, start_index, end_index):\n        \"\"\"Checks if indices are valid integers and within list bounds; raises IndexError otherwise.\"\"\"\n        if not isinstance(start_index, int) or not isinstance(end_index, int):\n            raise IndexError(\"Indices must be integers.\")\n\n        list_length = len(lst)\n\n        if not (0 <= start_index and start_index <= end_index and end_index < list_length):\n            if start_index > end_index:\n                raise IndexError(\"Start index cannot be greater than end index.\")\n            raise IndexError(\"Indices are out of bounds.\")\n\n    def compute_sum(self, lst, start_index, end_index):\n        \"\"\"Computes the sum of elements within the specified range, checking for numeric types.\"\"\"\n        total_sum = 0\n        for i in range(start_index, end_index + 1):\n            element = lst[i]\n            if not isinstance(element, (int, float)):\n                raise TypeError(f\"Non-numeric element '{element}' found at index {i}.\")\n            total_sum += element\n        return total_sum\n\n    def sum_range_list(self, lst, start_index, end_index):\n        \"\"\"Delegates validation and summation to internal methods.\"\"\"\n        self.validate_indices(lst, start_index, end_index)\n        return self.compute_sum(lst, start_index, end_index)\n\n\ndef sum_range_list(lst, start_index, end_index):\n    \"\"\"Public API: compute numeric sum of list[start_index..end_index] inclusive.\n\n    Raises IndexError for invalid indices or TypeError for non-numeric elements.\n    \"\"\"\n    calculator = SumRangeFunction()\n    return calculator.sum_range_list(lst, start_index, end_index)"}
{"task_id": "Mbpp/172", "solution": "class InputString:\n    \"\"\"Encapsulates the input string value.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input string.\"\"\"\n        return len(self.value)\n\nclass OccurrenceResult:\n    \"\"\"Holds the count of occurrences.\"\"\"\n    def __init__(self, count: int):\n        self.count = count\n\nclass CountOccuranceFunction:\n    \"\"\"Encapsulates the logic for counting occurrences of 'std'.\"\"\"\n    name: str = \"count_occurance\"\n\n    def count(self, input: str) -> int:\n        \"\"\"Counts the occurrences of 'std' in the given input string using an explicit search loop.\"\"\"\n        input_obj = InputString(input)\n        \n        count = 0\n        substring_to_find = \"std\"\n        start_index = 0\n\n        while True:\n            # Find the next occurrence of 'std' starting from start_index\n            index = input_obj.value.find(substring_to_find, start_index)\n            \n            if index == -1:\n                break\n            \n            count += 1\n            # Move start_index past the found occurrence to search for the next one\n            start_index = index + len(substring_to_find)\n            \n        result = OccurrenceResult(count)\n        return result.count\n\ndef count_occurance(input: str) -> int:\n    \"\"\"Counts the number of occurence of the string 'std' in a given string.\"\"\"\n    counter = CountOccuranceFunction()\n    return counter.count(input)"}
