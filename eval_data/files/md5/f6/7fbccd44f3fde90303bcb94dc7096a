{"task_id": "Mbpp/104", "solution": "from typing import List, Sequence\n\ndef sort_sublists(input_sequence: Sequence[Sequence[str]]) -> List[List[str]]:\n    \"\"\"\n    Accepts: input_sequence -- a sequence (e.g., list or tuple) of sequences of strings.\n    Returns: list of lists of strings where each inner list is the ascending lexicographically sorted version of the corresponding input sublist.\n    Behavior: Preserves order of sublists. If input_sequence is empty, returns [] (empty list). Empty sublists yield empty lists in corresponding positions.\n    \"\"\"\n    return [sorted(sublist) for sublist in input_sequence]"}
{"task_id": "Mbpp/109", "solution": "class BinaryString:\n    \"\"\"Represents a binary string and provides validation.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\n\n    def isValidBinary(self) -> bool:\n        \"\"\"Checks if the string contains only '0' or '1' characters.\"\"\"\n        return all(char in ('0', '1') for char in self.value)\n\nclass RotationOperation:\n    \"\"\"Performs cyclic left rotations on a string.\"\"\"\n    def __init__(self, rotations: int):\n        # The 'rotations' parameter is stored but not directly used in the methods' logic.\n        # It aligns with the design's class structure.\n        self.rotations = rotations\n\n    def rotateLeftOne(self, s: str) -> str:\n        \"\"\"Performs a single left rotation.\"\"\"\n        if not s:\n            return s\n        return s[1:] + s[0]\n\n    def getRotated(self, s: str, index: int) -> str:\n        \"\"\"Performs 'index' left rotations on the string.\"\"\"\n        if not s:\n            return s\n        # Calculate the effective rotation index to handle rotations > length\n        effective_index = index % len(s)\n        return s[effective_index:] + s[:effective_index]\n\nclass RotatedString:\n    \"\"\"Represents a rotated string and determines its oddness.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def isOdd(self) -> bool:\n        \"\"\"Returns True if the last character of the string is '1', False otherwise.\"\"\"\n        if not self.value:\n            return False\n        return self.value[-1] == '1'\n\n\ndef odd_Equivalent(binary_string, rotations):\n    \"\"\"\n    Finds the number of numbers with an odd value when rotating a binary string\n    the given number of times.\n    \"\"\"\n    odd_count = 0\n\n    binary_obj = BinaryString(binary_string)\n    if not binary_obj.isValidBinary():\n        raise ValueError(\"Input string must contain only '0' or '1' characters.\")\n\n    if binary_obj.length == 0:\n        return 0\n\n    rot_op = RotationOperation(rotations)\n\n    # Determine the number of iterations for rotation.\n    # If rotations is 0, the 0-th rotation (original string) is processed once.\n    # Otherwise, rotations from 0 to rotations-1 are processed.\n    num_iterations = max(1, rotations)\n\n    for i in range(num_iterations):\n        rotated_val = rot_op.getRotated(binary_obj.value, i)\n        rotated_obj = RotatedString(rotated_val)\n        if rotated_obj.isOdd():\n            odd_count += 1\n\n    return odd_count"}
{"task_id": "Mbpp/111", "solution": "from typing import Iterable, Any\n\ndef common_in_nested_lists(nested_lists: Iterable[Iterable[Any]]) -> Iterable[Any]:\n    \"\"\"\n    Finds common elements across all given nested lists.\n    Returns an iterable of unique elements present in every inner list.\n    \"\"\"\n    if not nested_lists:\n        return []\n\n    # Initialize the common set with the elements from the first sublist.\n    # If the first sublist is empty, the result will be an empty set.\n    iterator = iter(nested_lists)\n    try:\n        first_sublist = next(iterator)\n    except StopIteration:\n        return [] # nested_lists was an empty iterable\n\n    common_elements = set(first_sublist)\n\n    # If the first sublist itself was empty, no common elements are possible.\n    if not common_elements:\n        return []\n\n    # Intersect with subsequent sublists.\n    for sublist in iterator:\n        common_elements.intersection_update(set(sublist))\n        # If at any point the intersection becomes empty, we can short-circuit.\n        if not common_elements:\n            return []\n\n    return list(common_elements)"}
{"task_id": "Mbpp/113", "solution": "class IntegerValidator:\n    \"\"\"Helper class to encapsulate the integer validation logic.\"\"\"\n\n    def check_integer(self, s: str) -> bool:\n        \"\"\"Delegates to the core validation method.\"\"\"\n        return self.matchesSignAndDigits(s)\n\n    def matchesSignAndDigits(self, s: str) -> bool:\n        \"\"\"\n        Validates if a string represents an integer with an optional leading sign and one or more ASCII digits.\n        Performs a single-pass scan.\n        \"\"\"\n        n = len(s)\n        if n == 0:\n            return False\n\n        idx = 0\n        # Check for optional leading sign\n        if s[0] == '+' or s[0] == '-':\n            idx = 1\n\n        # Must have at least one digit after the sign (if present)\n        if idx == n:\n            return False\n\n        has_digits = False\n        # Check for ASCII digits\n        for i in range(idx, n):\n            char = s[i]\n            if '0' <= char <= '9':\n                has_digits = True\n            else:\n                return False # Non-digit character found\n\n        return has_digits\n\n\ndef check_integer(s: str) -> bool:\n    \"\"\"\n    Checks if a string represents an integer, allowing an optional leading sign and requiring one or more ASCII digits.\n    \"\"\"\n    validator = IntegerValidator()\n    return validator.check_integer(s)"}
