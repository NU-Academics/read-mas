{"task_id": "Mbpp/244", "solution": "import math\nimport numbers\n\ndef _validate_numeric(x: object) -> None:\n    \"\"\"\n    Validates that the input is a numeric type (int or float).\n    Raises TypeError if the input is not numeric.\n    \"\"\"\n    if not isinstance(x, numbers.Real):\n        raise TypeError(\"next_Perfect_Square expects a numeric input\")\n\ndef _compute_next_square(x: \"int | float\") -> int:\n    \"\"\"\n    Computes the smallest integer perfect square strictly greater than x.\n    Handles negative inputs by returning 0, the smallest non-negative perfect square.\n    \"\"\"\n    if x < 0:\n        return 0\n    \n    # For non-negative x, apply the algorithm: n = floor(sqrt(x)) + 1\n    square_root = math.sqrt(x)\n    n = math.floor(square_root) + 1\n    \n    return int(n * n)\n\ndef next_Perfect_Square(x: \"int | float\") -> int:\n    \"\"\"\n    Finds the next perfect square strictly greater than a given number.\n    Examples: next_Perfect_Square(35) == 36, next_Perfect_Square(-2) == 0.\n    \"\"\"\n    _validate_numeric(x)\n    return _compute_next_square(x)"}
{"task_id": "Mbpp/247", "solution": "def lps(input: str) -> int:\n    \"\"\"\n    Calculates the length of the longest palindromic subsequence (LPS) of the given string.\n    Uses dynamic programming to build a table of LPS lengths for all substrings.\n    \"\"\"\n    s = input\n    n = len(s)\n\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the LPS for the substring s[i...j]\n    dp = [[0] * n for _ in range(n)]\n\n    # All single characters are palindromes of length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the table for substrings of increasing length\n    for substr_len in range(2, n + 1):\n        for i in range(n - substr_len + 1):\n            j = i + substr_len - 1  # j is the end index of the current substring s[i...j]\n\n            if s[i] == s[j]:\n                # If outer characters match, include them and add LPS of inner substring s[i+1...j-1]\n                dp[i][j] = 2 + (dp[i + 1][j - 1] if substr_len > 2 else 0)\n            else:\n                # If outer characters don't match, take the maximum LPS from excluding s[i] or s[j]\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    # The result for the entire string is at dp[0][n-1]\n    return dp[0][n - 1]"}
{"task_id": "Mbpp/245", "solution": "from typing import List\n\ndef max_sum(arr: List[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence for the given array.\n    A sequence is bitonic if it is first strictly increasing and then strictly decreasing.\n    \"\"\"\n    n = len(arr)\n\n    if n == 0:\n        return 0\n\n    # LIS_sum[i] stores the maximum sum of a strictly increasing subsequence ending at arr[i].\n    lis_sum = list(arr)\n    for i in range(n):\n        for j in range(i):\n            if arr[j] < arr[i]:\n                lis_sum[i] = max(lis_sum[i], lis_sum[j] + arr[i])\n\n    # LDS_sum[i] stores the maximum sum of a strictly decreasing subsequence starting at arr[i].\n    lds_sum = list(arr)\n    for i in range(n - 1, -1, -1):\n        for j in range(n - 1, i, -1):\n            if arr[j] < arr[i]:\n                lds_sum[i] = max(lds_sum[i], lds_sum[j] + arr[i])\n\n    # A bitonic subsequence has a peak at some element arr[i].\n    # The sum is LIS_sum[i] + LDS_sum[i] - arr[i] (arr[i] is counted twice).\n    max_bitonic_sum = float('-inf')\n    for i in range(n):\n        current_bitonic_sum = lis_sum[i] + lds_sum[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n\n    return max_bitonic_sum"}
{"task_id": "Mbpp/251", "solution": "def insert_element(input_list, element):\n    \"\"\"Return a new list where `element` appears immediately before each item of `input_list`.\n\n    Args:\n        input_list (list): input list of items\n        element: value to insert before each input element\n\n    Returns:\n        list: new list constructed per SRS\n    \"\"\"\n    result = []\n    for item in input_list:\n        result.append(element)\n        result.append(item)\n    return result"}
