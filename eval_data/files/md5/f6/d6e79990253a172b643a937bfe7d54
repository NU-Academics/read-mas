{"task_id": "Mbpp/69", "solution": "from typing import List, Any\n\ndef is_sublist(main_list: List[Any], sublist: List[Any]) -> bool:\n    \"\"\"\n    Checks if a sublist appears as a contiguous subsequence within a main list.\n    It returns True for an empty sublist and False if a non-empty sublist\n    is searched within an empty main list.\n    \"\"\"\n    len_main = len(main_list)\n    len_sub = len(sublist)\n\n    if len_sub == 0:\n        return True\n\n    if len_main == 0:\n        return False\n\n    for i in range(len_main - len_sub + 1):\n        match = True\n        for j in range(len_sub):\n            if main_list[i + j] != sublist[j]:\n                match = False\n                break\n        if match:\n            return True\n\n    return False"}
{"task_id": "Mbpp/69", "solution": "from typing import List, Any\n\ndef is_sublist(main_list: List[Any], sublist: List[Any]) -> bool:\n    \"\"\"\n    Check if sublist appears as contiguous subsequence in main_list.\n    Handles empty lists and maintains O(n*m) time, O(1) space complexity.\n    \"\"\"\n    if not sublist:\n        return True\n\n    n = len(main_list)\n    m = len(sublist)\n\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        match = True\n        for j in range(m):\n            if main_list[i + j] != sublist[j]:\n                match = False\n                break\n        if match:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/70", "solution": "def get_equal(tuples: list) -> bool:\n    \"\"\"\n    Checks if all given tuples in a list have the same length.\n    Returns True if all tuples have equal length, False otherwise.\n    \"\"\"\n    if not tuples:\n        # If the list is empty, all tuples vacuously have equal length.\n        return True\n\n    # Get the length of the first tuple to use as a reference.\n    first_length = len(tuples[0])\n\n    # Iterate through the remaining tuples and compare their lengths.\n    for tpl in tuples[1:]:\n        if len(tpl) != first_length:\n            return False\n\n    # If the loop completes, all tuples have the same length.\n    return True"}
{"task_id": "Mbpp/71", "solution": "def get_next_gap(gap: int) -> int:\n    \"\"\"Calculates the next gap value for the comb sort algorithm.\"\"\"\n    gap = (gap * 10) // 13  # Apply shrink factor of 1.3 using integer arithmetic\n    if gap < 1:\n        return 1\n    return gap\n\ndef swap(arr: list, i: int, j: int) -> None:\n    \"\"\"Swaps elements at positions i and j in the given list.\"\"\"\n    arr[i], arr[j] = arr[j], arr[i]\n\ndef comb_sort(elements: list) -> list:\n    \"\"\"\n    Sorts a list of numerical elements in ascending order using the comb sort algorithm.\n    Returns a new list with elements sorted, without modifying the original input.\n    \"\"\"\n    arr = elements.copy()\n    n = len(arr)\n    gap = n\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = get_next_gap(gap)\n        swapped = False\n\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                swap(arr, i, i + gap)\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/71", "solution": "def _get_next_gap(gap: int) -> int:\n    \"\"\"Calculates the next gap value using a shrink factor of 1.3.\n    Ensures the minimum gap is 1.\"\"\"\n    gap = int(gap / 1.3)\n    if gap < 1:\n        return 1\n    return gap\n\ndef _swap_if_greater(arr: list, i: int, j: int) -> bool:\n    \"\"\"Compares and swaps elements if arr[i] is greater than arr[j].\n    Returns True if a swap occurred, False otherwise.\"\"\"\n    swapped = False\n    if arr[i] > arr[j]:\n        arr[i], arr[j] = arr[j], arr[i]\n        swapped = True\n    return swapped\n\ndef comb_sort(arr: list) -> list:\n    \"\"\"Sorts a list of integer elements in ascending order using the comb sort algorithm.\n    It works by repeatedly reducing the gap between compared elements.\"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n\n    gap = n\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = _get_next_gap(gap)\n        swapped = False\n\n        for i in range(n - gap):\n            if _swap_if_greater(arr, i, i + gap):\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/72", "solution": "def _validate_input(n: int) -> bool:\n    \"\"\"Validates that input is a positive integer.\n    Returns True if valid, False otherwise.\n    \"\"\"\n    return n > 0\n\ndef dif_Square(n: int) -> bool:\n    \"\"\"Determines if a number can be represented as the difference of two squares.\n    Returns True if representable, False otherwise.\n    \"\"\"\n    if not _validate_input(n):\n        return False\n\n    # A positive integer n can be represented as a\u00b2 - b\u00b2 if and only if\n    # n is not congruent to 2 modulo 4 (i.e., n % 4 != 2).\n    return n % 4 != 2"}
{"task_id": "Mbpp/74", "solution": "def extract_pattern(array):\n    \"\"\"Converts an array into a pattern string by mapping unique elements to sequential identifiers.\"\"\"\n    mapping = {}\n    next_id = 0\n    pattern_parts = []\n\n    for element in array:\n        if element not in mapping:\n            mapping[element] = str(next_id)\n            next_id += 1\n        pattern_parts.append(mapping[element])\n\n    return \"\".join(pattern_parts)\n\ndef patterns_equal(pattern1, pattern2):\n    \"\"\"Compares two pattern strings for exact equality.\"\"\"\n    return pattern1 == pattern2\n\ndef is_samepatterns(array1, array2):\n    \"\"\"Checks if two arrays follow the same structural pattern.\"\"\"\n    pattern1 = extract_pattern(array1)\n    pattern2 = extract_pattern(array2)\n    return patterns_equal(pattern1, pattern2)"}
{"task_id": "Mbpp/72", "solution": "def _validate_input(number: int) -> bool:\n    \"\"\"Validates that the input is a positive integer.\n    Returns True if the number is positive, False otherwise.\"\"\"\n    return number > 0\n\ndef _calculate_square_difference(number: int) -> bool:\n    \"\"\"Performs the mathematical calculation to check if a number can be\n    represented as the difference of two squares (a\u00b2 - b\u00b2).\"\"\"\n    # A number N can be represented as a difference of two squares\n    # if and only if N is odd or N is a multiple of 4.\n    # This means N cannot be congruent to 2 modulo 4.\n    return number % 4 != 2\n\ndef dif_Square(number: int) -> bool:\n    \"\"\"Determines whether the given number can be represented\n    as the difference of two squares.\"\"\"\n    if not _validate_input(number):\n        return False\n    return _calculate_square_difference(number)"}
