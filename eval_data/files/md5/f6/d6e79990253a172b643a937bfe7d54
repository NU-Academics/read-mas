{"task_id": "Mbpp/632", "solution": "```python\ndef move_zero(input_list: list) -> list:\n    \"\"\"\n    Move all zero values to the end of the list while preserving\n    the relative order of non-zero elements.\n    Returns a new list with zeros moved to the end.\n    \"\"\"\n    non_zeros = []\n    zero_count = 0\n\n    for element in input_list:\n        if element == 0:\n            zero_count += 1\n        else:\n            non_zeros.append(element)\n\n    non_zeros.extend([0] * zero_count)\n    return non_zeros\n```"}
{"task_id": "Mbpp/633", "solution": "from typing import List, Tuple, Iterator\n\ndef _calculate_xor(a: int, b: int) -> int:\n    \"\"\"Calculate XOR of two integers.\"\"\"\n    return a ^ b\n\ndef _generate_pairs(numbers: List[int]) -> Iterator[Tuple[int, int]]:\n    \"\"\"Generate all unique pairs (a, b) from the list where a comes before b.\"\"\"\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            yield (numbers[i], numbers[j])\n\ndef pair_xor_Sum(numbers: List[int], count: int) -> int:\n    \"\"\"\n    Calculate sum of XOR operations for all unique pairs of numbers.\n    The 'count' parameter is provided as per the design specification but not directly used in this implementation.\n    \"\"\"\n    total_xor_sum = 0\n    for num1, num2 in _generate_pairs(numbers):\n        total_xor_sum += _calculate_xor(num1, num2)\n    return total_xor_sum"}
{"task_id": "Mbpp/633", "solution": "def _validate_inputs(numbers_list, count):\n    \"\"\"\n    Validates input parameters as per design, but due to critical requirements,\n    it trusts caller inputs and simply returns True.\n    \"\"\"\n    return True\n\ndef _generate_pairs(numbers_list):\n    \"\"\"\n    Generates all unique pairs (num1, num2) from the input list,\n    where num1 appears before num2 to ensure uniqueness.\n    \"\"\"\n    pairs = []\n    n = len(numbers_list)\n    for i in range(n):\n        for j in range(i + 1, n):\n            pairs.append((numbers_list[i], numbers_list[j]))\n    return pairs\n\ndef _calculate_xor_sum(pairs):\n    \"\"\"\n    Calculates the bitwise XOR for each given pair and sums all the results.\n    \"\"\"\n    total_xor_sum = 0\n    for num1, num2 in pairs:\n        total_xor_sum += (num1 ^ num2)\n    return total_xor_sum\n\ndef pair_xor_Sum(numbers_list, count):\n    \"\"\"\n    Computes the sum of XOR operations for all unique pairs in the given list.\n    Orchestrates input validation, pair generation, XOR calculation, and sum aggregation.\n    \"\"\"\n    # Adhere to the design's call structure for validation,\n    # but the actual validation logic is simplified per critical requirements.\n    if not _validate_inputs(numbers_list, count):\n        pass # No explicit error handling as per critical requirements.\n\n    pairs = _generate_pairs(numbers_list)\n    total_sum = _calculate_xor_sum(pairs)\n\n    return total_sum"}
{"task_id": "Mbpp/635", "solution": "from typing import List\n\ndef swap(arr: List[int], i: int, j: int) -> None:\n    \"\"\"Swaps elements at positions i and j in the array.\"\"\"\n    arr[i], arr[j] = arr[j], arr[i]\n\ndef heapify(arr: List[int], n: int, i: int) -> None:\n    \"\"\"Maintains heap property for subtree rooted at index i within a heap of size n.\"\"\"\n    largest = i\n    left = 2 * i + 1\n    right = 2 * i + 2\n\n    if left < n and arr[left] > arr[largest]:\n        largest = left\n\n    if right < n and arr[right] > arr[largest]:\n        largest = right\n\n    if largest != i:\n        swap(arr, i, largest)\n        heapify(arr, n, largest)\n\ndef build_max_heap(arr: List[int]) -> None:\n    \"\"\"Builds a max heap from the input array in-place.\"\"\"\n    n = len(arr)\n    # Start from the last non-leaf node and go up to the root.\n    for i in range(n // 2 - 1, -1, -1):\n        heapify(arr, n, i)\n\ndef heap_sort(input_list: List[int]) -> List[int]:\n    \"\"\"Sorts a list of integers in ascending order using the heap sort algorithm.\"\"\"\n    arr = input_list.copy() # Create a copy to preserve the original list.\n    n = len(arr)\n\n    build_max_heap(arr)\n\n    # One by one extract elements from the heap.\n    for i in range(n - 1, 0, -1):\n        # Move current root (largest element) to the end of the unsorted part.\n        swap(arr, 0, i)\n        # Call heapify on the reduced heap to restore heap property.\n        heapify(arr, i, 0)\n\n    return arr"}
{"task_id": "Mbpp/635", "solution": "def _heapify(arr: list, n: int, i: int) -> None:\n    \"\"\"Maintains the max-heap property for a subtree rooted at index i.\"\"\"\n    largest = i\n    left = 2 * i + 1\n    right = 2 * i + 2\n\n    if left < n and arr[left] > arr[largest]:\n        largest = left\n\n    if right < n and arr[right] > arr[largest]:\n        largest = right\n\n    if largest != i:\n        arr[i], arr[largest] = arr[largest], arr[i]\n        _heapify(arr, n, largest)\n\ndef _build_max_heap(arr: list) -> None:\n    \"\"\"Builds a max-heap from an unsorted list.\"\"\"\n    n = len(arr)\n    for i in range(n // 2 - 1, -1, -1):\n        _heapify(arr, n, i)\n\ndef heap_sort(input_list: list) -> list:\n    \"\"\"Sorts a list of integers using the heap sort algorithm.\"\"\"\n    arr = input_list.copy()\n    n = len(arr)\n\n    if n <= 1:\n        return arr\n\n    _build_max_heap(arr)\n\n    for i in range(n - 1, 0, -1):\n        arr[i], arr[0] = arr[0], arr[i]\n        _heapify(arr, i, 0)\n\n    return arr"}
