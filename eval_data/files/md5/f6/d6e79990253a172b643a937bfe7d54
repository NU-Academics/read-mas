{"task_id": "Mbpp/245", "solution": "def _calculate_increasing_sums(arr: list[int]) -> list[int]:\n    \"\"\"\n    Calculates the maximum sum of an increasing subsequence ending at each position.\n    This is a helper for the max_sum function.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n\n    inc_sums = list(arr)\n\n    for i in range(1, n):\n        for j in range(i):\n            if arr[i] > arr[j]:\n                inc_sums[i] = max(inc_sums[i], inc_sums[j] + arr[i])\n    return inc_sums\n\ndef _calculate_decreasing_sums(arr: list[int]) -> list[int]:\n    \"\"\"\n    Calculates the maximum sum of a decreasing subsequence starting at each position.\n    This is a helper for the max_sum function.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n\n    dec_sums = list(arr)\n\n    for i in range(n - 2, -1, -1):\n        for j in range(i + 1, n):\n            if arr[i] > arr[j]:\n                dec_sums[i] = max(dec_sums[i], dec_sums[j] + arr[i])\n    return dec_sums\n\ndef max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence in the given array.\n    A bitonic sequence is one that is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    inc_sums = _calculate_increasing_sums(arr)\n    dec_sums = _calculate_decreasing_sums(arr)\n\n    max_bitonic_sum = float('-inf')\n\n    for i in range(n):\n        current_bitonic_sum = inc_sums[i] + dec_sums[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n\n    return int(max_bitonic_sum)"}
{"task_id": "Mbpp/247", "solution": "def calculate_lps_length(s: str) -> int:\n    \"\"\"\n    Implements the dynamic programming algorithm to find the length of the longest palindromic subsequence.\n    The dp[i][j] table stores the LPS length for the substring s[i...j].\n    \"\"\"\n    n = len(s)\n    dp = [[0] * n for _ in range(n)]\n\n    # All single characters are palindromic subsequences of length 1.\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the table for lengths from 2 to n.\n    for current_length in range(2, n + 1):\n        for i in range(n - current_length + 1):\n            j = i + current_length - 1\n            if s[i] == s[j]:\n                # If characters match, add 2 to LPS of the inner substring.\n                # Handle base case for length 2 (inner substring is empty, length 0).\n                dp[i][j] = 2 + (dp[i + 1][j - 1] if current_length > 2 else 0)\n            else:\n                # If characters don't match, take the maximum of excluding s[i] or s[j].\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    return dp[0][n - 1]\n\n\ndef lps(s: str) -> int:\n    \"\"\"\n    Calculates the length of the longest palindromic subsequence in the given string.\n    It handles empty strings and delegates the core logic to a dynamic programming helper.\n    \"\"\"\n    if not s:\n        return 0\n    return calculate_lps_length(s)"}
{"task_id": "Mbpp/251", "solution": "def _validate_inputs(input_list: list, element: any) -> bool:\n    \"\"\"\n    Validates input parameters as per design.\n    Due to critical constraints, this function performs no actual validation and always returns True.\n    \"\"\"\n    return True\n\ndef _create_result_list(input_list: list, element: any) -> list:\n    \"\"\"\n    Constructs the result list by inserting the specified element before each original list item.\n    This process ensures O(n) time complexity by iterating through the input list once.\n    \"\"\"\n    result_list = []\n    for item in input_list:\n        result_list.append(element)\n        result_list.append(item)\n    return result_list\n\ndef insert_element(list: list, element: any) -> list:\n    \"\"\"\n    Inserts a specified element before each existing element in the input list.\n    Returns a new list containing the element inserted before each original list element.\n    \"\"\"\n    _validate_inputs(list, element)\n    return _create_result_list(list, element)"}
{"task_id": "Mbpp/247", "solution": "```python\ndef _validate_input(s: str) -> bool:\n    \"\"\"\n    Validates the input string for basic conditions.\n    Returns True for non-empty strings, False otherwise.\n    \"\"\"\n    return len(s) > 0\n\ndef _build_dp_matrix(s: str, length: int) -> list[list[int]]:\n    \"\"\"\n    Initializes a 2D dynamic programming matrix.\n    Sets diagonal elements to 1 for single-character palindromes.\n    \"\"\"\n    dp = [[0 for _ in range(length)] for _ in range(length)]\n    for i in range(length):\n        dp[i][i] = 1  # A single character is a palindrome of length 1\n    return dp\n\ndef _calculate_lps(s: str) -> int:\n    \"\"\"\n    Calculates the length of the longest palindromic subsequence using dynamic programming.\n    This function implements the core algorithm logic.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 0\n\n    dp = _build_dp_matrix(s, n)\n\n    # Fill the DP table for lengths from 2 to n\n    for current_length in range(2, n + 1):\n        for i in range(n - current_length + 1):\n            j = i + current_length - 1\n            if s[i] == s[j]:\n                # Characters match, extend the palindrome from inner substring\n                # For length 2, dp[i+1][j-1] is dp[i+1][i] which is 0\n                dp[i][j] = 2 + (dp[i+1][j-1] if current_length > 2 else 0)\n            else:\n                # Characters don't match, take the maximum from removing either s[i] or s[j]\n                dp[i][j] = max(dp[i+1][j], dp[i][j-1])\n    \n    return dp[0][n-1]\n\ndef lps(string: str) -> int:\n    \"\"\"\n    Calculates the length of the longest palindromic subsequence (LPS) in the given string.\n    It serves as the public interface, handling input validation and delegating to the core algorithm.\n    \"\"\"\n    if not _validate_input(string):\n        return 0  # Empty string has an LPS of length 0\n\n    return _calculate_lps(string)\n```"}
{"task_id": "Mbpp/252", "solution": "import math\n\ndef convert(z):\n    \"\"\"Converts a complex number or real number to its polar coordinates.\n    Returns a tuple (magnitude, angle) where angle is in radians.\n    \"\"\"\n    # Treat the input as a complex number, handling real numbers by converting them to complex with zero imaginary part.\n    z_complex = complex(z)\n\n    def _calculate_magnitude(complex_num):\n        \"\"\"Calculates the magnitude of a complex number.\"\"\"\n        return math.sqrt(complex_num.real**2 + complex_num.imag**2)\n\n    def _calculate_angle(complex_num):\n        \"\"\"Calculates the angle (argument) of a complex number in radians.\"\"\"\n        return math.atan2(complex_num.imag, complex_num.real)\n\n    magnitude = _calculate_magnitude(z_complex)\n    angle = _calculate_angle(z_complex)\n\n    return (magnitude, angle)"}
