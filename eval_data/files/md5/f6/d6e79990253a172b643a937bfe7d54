{"task_id": "Mbpp/100", "solution": "def reverse_number(n: int) -> int:\n    \"\"\"Reverses the digits of a non-negative integer.\n    For example, reverse_number(123) returns 321.\n    \"\"\"\n    reversed_num = 0\n    temp = n\n    while temp > 0:\n        digit = temp % 10\n        reversed_num = reversed_num * 10 + digit\n        temp //= 10\n    return reversed_num\n\ndef is_palindrome(n: int) -> bool:\n    \"\"\"Checks if a non-negative integer is a palindrome.\n    A number is a palindrome if it reads the same forwards and backwards.\n    \"\"\"\n    return n == reverse_number(n)\n\ndef increment_to_palindrome(n: int) -> int:\n    \"\"\"Finds the next smallest palindrome starting from integer n (inclusive).\n    It iteratively increments the number until a palindrome is found.\n    \"\"\"\n    candidate = n\n    while not is_palindrome(candidate):\n        candidate += 1\n    return candidate\n\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"Finds the next smallest palindrome strictly greater than the input integer.\n    This function leverages helper utilities to perform the core calculation.\n    \"\"\"\n    return increment_to_palindrome(n + 1)"}
{"task_id": "Mbpp/99", "solution": "def _convert_to_binary(number: int) -> str:\n    \"\"\"Performs the mathematical conversion from decimal to binary.\"\"\"\n    if number == 0:\n        return '0'\n    binary_digits = []\n    while number > 0:\n        binary_digits.append(str(number % 2))\n        number //= 2\n    return \"\".join(reversed(binary_digits))\n\ndef _remove_leading_zeros(binary_string: str) -> str:\n    \"\"\"Removes leading zeros from a binary string while preserving '0' for zero input.\"\"\"\n    stripped_string = binary_string.lstrip('0')\n    if not stripped_string:\n        return '0'\n    return stripped_string\n\ndef decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"Converts a decimal number to its binary string representation without leading zeros.\"\"\"\n    raw_binary = _convert_to_binary(decimal_number)\n    formatted_binary = _remove_leading_zeros(raw_binary)\n    return formatted_binary"}
{"task_id": "Mbpp/100", "solution": "def is_palindrome(number: int) -> bool:\n    \"\"\"Checks if a given integer is a palindrome.\n    It converts the number to a string and compares it to its reverse.\"\"\"\n    s = str(number)\n    return s == s[::-1]\n\ndef validate_input(input_num: int) -> bool:\n    \"\"\"Validates if the input is a positive integer.\n    Per design, this function confirms the input is positive.\"\"\"\n    return input_num > 0\n\ndef next_smallest_palindrome(input: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome greater than the given integer input.\n    The function iteratively checks numbers starting from input + 1.\n    \"\"\"\n    # Adhere to design: validate_input is called.\n    # Adhere to CRITICAL REQUIREMENTS: trust caller's inputs,\n    # so validate_input's return doesn't gate the core logic.\n    _ = validate_input(input)\n\n    candidate = input + 1\n    while not is_palindrome(candidate):\n        candidate += 1\n    return candidate"}
{"task_id": "Mbpp/99", "solution": "```python\n# decimal_to_binary/src/validator.py\n\n\"\"\"Input validation logic.\"\"\"\n\nclass DecimalNumber:\n    \"\"\"Represents decimal input value with validation.\n    Validation logic is simplified per critical requirements.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n        # is_valid is set to True due to \"Trust the caller's inputs\" constraint.\n        self._is_valid = True\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the decimal number is valid.\"\"\"\n        return self._is_valid\n\n    def get_value(self) -> int:\n        \"\"\"Returns the decimal number's value.\"\"\"\n        return self.value\n\nclass InputValidator:\n    \"\"\"Validates decimal input parameters.\n    Validation logic is simplified per critical requirements.\n    \"\"\"\n    def validate_input(self, decimal_number: int) -> bool:\n        \"\"\"Validates if the input is a valid decimal number.\"\"\"\n        num = DecimalNumber(decimal_number)\n        return num.is_valid()\n\n    def is_integer(self, value: any) -> bool:\n        \"\"\"Checks if a value is an integer.\n        Always returns True due to \"Trust the caller's inputs\" constraint.\n        \"\"\"\n        return True\n\n\n# decimal_to_binary/src/converter.py\n\n\"\"\"Core binary conversion implementation.\"\"\"\n\nclass BinaryProcessor:\n    \"\"\"Performs mathematical decimal to binary conversion.\"\"\"\n    def convert_to_binary(self, decimal_number: int) -> str:\n        \"\"\"Converts a decimal number to its binary string representation.\"\"\"\n        if decimal_number == 0:\n            return \"0\"\n        return self._divide_by_two_method(decimal_number)\n\n    def _divide_by_two_method(self, decimal_number: int) -> str:\n        \"\"\"Converts a positive decimal number to binary using repeated division.\n        This method assumes a non-negative integer input.\n        \"\"\"\n        binary_digits = []\n        current_number = decimal_number\n        while current_number > 0:\n            remainder = current_number % 2\n            binary_digits.append(str(remainder))\n            current_number //= 2\n        return \"\".join(reversed(binary_digits))\n\n\n# decimal_to_binary/src/formatter.py\n\n\"\"\"Binary string formatting utilities.\"\"\"\n\nclass BinaryString:\n    \"\"\"Represents binary output with formatting capabilities.\"\"\"\n    def __init__(self, binary_value: str, original_decimal: int = 0):\n        \"\"\"Initializes a BinaryString object.\"\"\"\n        self.value = binary_value\n        self._original_decimal = original_decimal\n\n    def has_leading_zeros(self) -> bool:\n        \"\"\"Checks if the binary string has leading zeros.\"\"\"\n        return len(self.value) > 1 and self.value.startswith('0')\n\n    def remove_leading_zeros(self) -> str:\n        \"\"\"Removes leading zeros from the binary string.\"\"\"\n        stripped = self.value.lstrip('0')\n        if not stripped:\n            return \"0\"\n        return stripped\n\n    def get_value(self) -> str:\n        \"\"\"Returns the formatted binary string value.\"\"\"\n        return self.value\n\nclass StringFormatter:\n    \"\"\"Formats binary strings removing leading zeros.\"\"\"\n    def remove_leading_zeros(self, binary_string: str) -> str:\n        \"\"\"Removes leading zeros from the binary string, keeping '0' for zero.\"\"\"\n        binary_obj = BinaryString(binary_string)\n        return binary_obj.remove_leading_zeros()\n\n    def _strip_leading_zeros(self, binary_string: str) -> str:\n        \"\"\"Internal helper to strip leading zeros directly.\"\"\"\n        stripped = binary_string.lstrip('0')\n        if not stripped:\n            return \"0\"\n        return stripped\n\n\n# decimal_to_binary/src/main.py\n\n\"\"\"Entry point with decimal_to_binary function.\"\"\"\n\nfrom src.validator import InputValidator\nfrom src.converter import BinaryProcessor\nfrom src.formatter import StringFormatter\n\ndef decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"Converts a decimal integer to its binary string representation.\n    Orchestrates input validation, binary conversion, and string formatting.\n    \"\"\"\n    # Input Validation (logic simplified per critical requirements)\n    validator = InputValidator()\n    # This validation will always return True due to the \"Trust the caller's inputs\" constraint.\n    validator.validate_input(decimal_number)\n\n    # Binary Conversion Logic\n    converter = BinaryProcessor()\n    raw_binary = converter.convert_to_binary(decimal_number)\n\n    # String Formatting (remove leading zeros)\n    formatter = StringFormatter()\n    final_binary = formatter.remove_leading_zeros(raw_binary)\n\n    return final_binary\n```"}
