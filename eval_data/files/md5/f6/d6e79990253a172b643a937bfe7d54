{"task_id": "Mbpp/109", "solution": "def _rotate_left(s: str, positions: int) -> str:\n    \"\"\"Rotate string left by specified positions with wraparound.\n    Positions are taken modulo the string length to handle excessive rotations.\"\"\"\n    if not s:\n        return s\n    actual_positions = positions % len(s)\n    return s[actual_positions:] + s[:actual_positions]\n\ndef _binary_to_decimal(binary_str: str) -> int:\n    \"\"\"Convert binary string to decimal integer.\"\"\"\n    return int(binary_str, 2)\n\ndef _is_odd(value: int) -> bool:\n    \"\"\"Check if value is odd.\"\"\"\n    return value % 2 != 0\n\ndef odd_Equivalent(binary_string: str, rotation_count: int) -> int:\n    \"\"\"\n    Find the number of numbers with odd values when rotating a binary string.\n    Processes left rotations, converts to decimal, and counts odd results.\n    \"\"\"\n    odd_count = 0\n    for i in range(rotation_count):\n        rotated_string = _rotate_left(binary_string, i)\n        decimal_value = _binary_to_decimal(rotated_string)\n        if _is_odd(decimal_value):\n            odd_count += 1\n    return odd_count"}
{"task_id": "Mbpp/109", "solution": "def _validate_binary_string(binary_string: str) -> None:\n    \"\"\"Validates that input contains only '0' and '1' characters.\n    Raises ValueError if the string contains non-binary digits.\n    \"\"\"\n    if not all(char in '01' for char in binary_string):\n        raise ValueError(\"Invalid binary string: contains non-binary digits.\")\n\ndef _rotate_left(binary_string: str) -> str:\n    \"\"\"Performs a single left rotation of a binary string.\n    Moves the first character to the end of the string.\n    \"\"\"\n    if not binary_string:\n        return \"\"\n    return binary_string[1:] + binary_string[0]\n\ndef _binary_to_decimal(binary_string: str) -> int:\n    \"\"\"Converts a binary string to its decimal integer equivalent.\n    Uses Python's built-in integer conversion for base 2.\n    \"\"\"\n    if not binary_string: # Handle empty string case for consistency, though validation handles non-empty inputs\n        return 0\n    return int(binary_string, 2)\n\ndef _is_odd(decimal_value: int) -> bool:\n    \"\"\"Determines if a decimal integer value is odd.\n    Returns True if the value is odd, False otherwise.\n    \"\"\"\n    return decimal_value % 2 != 0\n\ndef odd_Equivalent(binary_string: str, rotation_count: int) -> int:\n    \"\"\"Counts the number of odd decimal values generated by rotating a binary string.\n    The string is rotated left 'rotation_count' times, and each resulting string is evaluated.\n    \"\"\"\n    _validate_binary_string(binary_string)\n\n    odd_values_count = 0\n    current_string = binary_string\n\n    for _ in range(rotation_count):\n        current_string = _rotate_left(current_string)\n        decimal_value = _binary_to_decimal(current_string)\n        if _is_odd(decimal_value):\n            odd_values_count += 1\n\n    return odd_values_count"}
