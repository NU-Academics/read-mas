{"task_id": "Mbpp/6", "solution": "def _count_set_bits(n: int) -> int:\n    \"\"\"Counts the number of set bits in an integer using Brian Kernighan's algorithm.\n    This internal helper function processes the XOR result.\"\"\"\n    count = 0\n    while n > 0:\n        n &= (n - 1)\n        count += 1\n    return count\n\ndef differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"Checks if two numbers differ at exactly one bit position.\n    It performs an XOR operation and then counts the set bits.\"\"\"\n    xor_result = num1 ^ num2\n    set_bit_count = _count_set_bits(xor_result)\n    return set_bit_count == 1"}
{"task_id": "Mbpp/3", "solution": "import math\n\ndef _is_prime_helper(number: int) -> bool:\n    \"\"\"Checks if a number is prime.\n    Handles special cases for 1, 2, and even numbers.\n    \"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    limit = int(math.sqrt(number))\n    i = 3\n    while i <= limit:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\n\ndef is_not_prime(number: int) -> bool:\n    \"\"\"Identifies if a number is not prime using inverse primality logic.\n    Returns True if the number is composite, False if it is prime.\n    \"\"\"\n    return not _is_prime_helper(number)"}
{"task_id": "Mbpp/3", "solution": "def _is_prime_helper(number: int) -> bool:\n    \"\"\"\n    Checks if a number is prime according to mathematical definitions.\n    This internal function handles the core logic for prime number identification.\n    \"\"\"\n    if number < 2:\n        return False  # Numbers less than 2 are not prime\n    if number == 2 or number == 3:\n        return True   # 2 and 3 are prime numbers\n    if number % 2 == 0 or number % 3 == 0:\n        return False  # Multiples of 2 or 3 (except 2 and 3 themselves) are not prime\n\n    # Check for factors from 5 onwards using an optimized wheel factorization\n    i = 5\n    while i * i <= number:\n        if number % i == 0 or number % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\n\ndef is_not_prime(number: int) -> bool:\n    \"\"\"\n    Identifies if a given integer is a non-prime number.\n    Returns True if the number is non-prime, False if it is prime.\n    \"\"\"\n    return not _is_prime_helper(number)"}
{"task_id": "Mbpp/6", "solution": "def is_power_of_two(n: int) -> bool:\n    \"\"\"\n    Checks if a given integer is a power of two.\n    This is true if n > 0 and (n & (n - 1)) is 0.\n    \"\"\"\n    return n > 0 and (n & (n - 1)) == 0\n\ndef differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Determines if two integers differ at exactly one bit position.\n    It uses XOR and a power-of-two check on the result.\n    \"\"\"\n    xor_result = num1 ^ num2\n    return is_power_of_two(xor_result)"}
