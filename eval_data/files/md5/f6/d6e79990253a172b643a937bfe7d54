{"task_id": "Mbpp/123", "solution": "import math\n\ndef find_proper_divisors(number: int) -> list[int]:\n    \"\"\"Finds all proper divisors of a given number.\"\"\"\n    if number <= 1:\n        return []\n    divs = [1]\n    limit = int(math.sqrt(number))\n    for i in range(2, limit + 1):\n        if number % i == 0:\n            divs.append(i)\n            if i * i != number:\n                divs.append(number // i)\n    return divs\n\ndef sum_proper_divisors(number: int) -> int:\n    \"\"\"Calculates the sum of proper divisors for a number.\"\"\"\n    return sum(find_proper_divisors(number))\n\ndef is_amicable_pair(num1: int, num2: int) -> bool:\n    \"\"\"Verifies if two numbers form an amicable pair.\"\"\"\n    if num1 == num2:\n        return False\n    return sum_proper_divisors(num1) == num2 and \\\n           sum_proper_divisors(num2) == num1\n\ndef amicable_numbers_sum(upper_limit: int) -> int:\n    \"\"\"Calculates the sum of all amicable numbers within a specified range.\n    Uses a set to prevent double-counting pairs.\"\"\"\n    total_sum = 0\n    checked_numbers = set()\n\n    for n in range(1, upper_limit + 1):\n        if n in checked_numbers:\n            continue\n\n        divisor_sum = sum_proper_divisors(n)\n\n        # Check for amicable pairs where n is less than its amicable pair\n        # to process each pair only once (e.g., 220, 284, not 284, 220).\n        if n < divisor_sum and divisor_sum <= upper_limit:\n            if is_amicable_pair(n, divisor_sum):\n                total_sum += n\n                total_sum += divisor_sum\n                checked_numbers.add(n)\n                checked_numbers.add(divisor_sum)\n\n    return total_sum"}
