{"task_id": "Mbpp/16", "solution": "def text_lowercase_underscore(text: str) -> bool:\n    \"\"\"\n    Validates if string contains only lowercase letters joined with underscores.\n    Returns True for \"aab_cbbbc\", False for invalid characters, consecutive or boundary underscores.\n    \"\"\"\n    if not text:\n        return False\n\n    if text[0] == '_' or text[-1] == '_':\n        return False\n\n    has_underscore = False\n    for i in range(len(text)):\n        char = text[i]\n\n        if not ('a' <= char <= 'z' or char == '_'):\n            return False\n\n        if char == '_':\n            has_underscore = True\n            if i + 1 < len(text) and text[i+1] == '_':\n                return False\n\n    if not has_underscore and len(text) > 0: # If string is not empty but has no underscores, it's invalid\n        return False\n\n    return True"}
{"task_id": "Mbpp/16", "solution": "def is_valid_character(char: str) -> bool:\n    # Checks if a character is a lowercase letter or an underscore.\n    return 'a' <= char <= 'z' or char == '_'\n\ndef contains_only_valid_chars(text: str) -> bool:\n    # Ensures the string only contains valid lowercase letters and underscores.\n    for char in text:\n        if not is_valid_character(char):\n            return False\n    return True\n\ndef check_sequence_format(text: str) -> bool:\n    # Validates the structure of letter sequences and underscores.\n    if not text:\n        return False\n    \n    if text.startswith('_') or text.endswith('_'):\n        return False\n    \n    if '__' in text:\n        return False\n        \n    parts = text.split('_')\n    for part in parts:\n        if not part: # Handles cases like \"a__b\" or strings starting/ending with underscore if not caught earlier\n            return False\n        for char in part:\n            if not ('a' <= char <= 'z'): # Ensures each segment is purely lowercase letters\n                return False\n    \n    return True\n\ndef validate_pattern(input_string: str) -> bool:\n    # Validates the overall pattern structure based on the design rules.\n    return check_sequence_format(input_string)\n\ndef text_lowercase_underscore(input_string: str) -> bool:\n    # Determines if the input string matches the lowercase_underscore pattern.\n    if not input_string:\n        return False\n\n    if not contains_only_valid_chars(input_string):\n        return False\n\n    return validate_pattern(input_string)"}
