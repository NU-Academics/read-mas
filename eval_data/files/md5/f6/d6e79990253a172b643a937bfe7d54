{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"Moves all numeric characters to the end of the string while preserving relative order.\n    Achieves O(n) time and space complexity.\"\"\"\n    non_numeric_chars = []\n    numeric_chars = []\n\n    for char in input_string:\n        if char.isdigit():\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n\n    return \"\".join(non_numeric_chars) + \"\".join(numeric_chars)"}
{"task_id": "Mbpp/622", "solution": "def merge_sorted_lists(list1: list, list2: list) -> list:\n    \"\"\"\n    Merges two sorted lists into a single sorted list.\n    This function assumes input lists are already sorted in ascending order.\n    \"\"\"\n    merged_list = []\n    i, j = 0, 0\n    n1, n2 = len(list1), len(list2)\n\n    while i < n1 and j < n2:\n        if list1[i] <= list2[j]:\n            merged_list.append(list1[i])\n            i += 1\n        else:\n            merged_list.append(list2[j])\n            j += 1\n\n    # Append any remaining elements from list1\n    while i < n1:\n        merged_list.append(list1[i])\n        i += 1\n    # Append any remaining elements from list2\n    while j < n2:\n        merged_list.append(list2[j])\n        j += 1\n\n    return merged_list\n\ndef calculate_median(merged_list: list) -> float:\n    \"\"\"\n    Calculates the median of a sorted list.\n    This function assumes the list has an even number of elements.\n    \"\"\"\n    length = len(merged_list)\n    mid_right_idx = length // 2\n    mid_left_idx = mid_right_idx - 1\n    median = (merged_list[mid_left_idx] + merged_list[mid_right_idx]) / 2.0\n    return median\n\ndef get_median(list1: list, list2: list, size: int) -> float:\n    \"\"\"\n    Calculates the median of combined elements from two sorted lists of equal size.\n    It merges the lists and then finds the median of the merged list.\n    \"\"\"\n    merged = merge_sorted_lists(list1, list2)\n    median_value = calculate_median(merged)\n    return median_value"}
{"task_id": "Mbpp/619", "solution": "def extract_numeric_chars(input_string: str) -> str:\n    \"\"\"Collects all numeric characters from a string, preserving their original order.\"\"\"\n    numeric_chars = [char for char in input_string if char.isdigit()]\n    return \"\".join(numeric_chars)\n\ndef extract_non_numeric_chars(input_string: str) -> str:\n    \"\"\"Collects all non-numeric characters from a string, preserving their original order.\"\"\"\n    non_numeric_chars = [char for char in input_string if not char.isdigit()]\n    return \"\".join(non_numeric_chars)\n\ndef concatenate_parts(non_numeric: str, numeric: str) -> str:\n    \"\"\"Combines two string parts, placing the non-numeric part first.\"\"\"\n    return non_numeric + numeric\n\ndef move_num(input_string: str) -> str:\n    \"\"\"\n    Relocates all numeric characters to the end of the given string.\n    Maintains the original relative order of both non-numeric and numeric characters.\n    \"\"\"\n    non_numeric_part = extract_non_numeric_chars(input_string)\n    numeric_part = extract_numeric_chars(input_string)\n    return concatenate_parts(non_numeric_part, numeric_part)"}
{"task_id": "Mbpp/620", "solution": "from typing import List, Tuple\n\n# Helper function for checking divisibility between two numbers.\ndef is_divisible_pair(a: int, b: int) -> bool:\n    # Checks if one number divides the other, handling zero cases where appropriate.\n    if a == 0:\n        return True\n    if b == 0:\n        return True\n    return a % b == 0 or b % a == 0\n\n# Helper function for generating all unique pairs from a list.\ndef get_all_pairs(numbers: List[int]) -> List[Tuple[int, int]]:\n    # Generates all distinct pairs (a, b) from the input list, where a != b.\n    pairs = []\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            pairs.append((numbers[i], numbers[j]))\n    return pairs\n\n# Helper function to validate if all pairs in a subset satisfy the divisibility relationship.\ndef is_valid_subset(subset: List[int]) -> bool:\n    # Returns True if every pair in the subset is divisible, otherwise False.\n    if len(subset) <= 1:\n        return True\n    pairs = get_all_pairs(subset)\n    for a, b in pairs:\n        if not is_divisible_pair(a, b):\n            return False\n    return True\n\n# Helper function for generating all possible subsets of a list.\ndef generate_all_subsets(numbers: List[int]) -> List[List[int]]:\n    # Produces a list containing all possible subsets of the input numbers.\n    subsets = [[]]\n    for num in numbers:\n        new_subsets = []\n        for s in subsets:\n            new_subsets.append(s + [num])\n        subsets.extend(new_subsets)\n    return subsets\n\n# Main function to find the size of the largest subset with the divisibility property.\ndef largest_subset(numbers: List[int]) -> int:\n    # Finds the size of the largest subset where every pair has a divisibility relationship.\n    if not numbers:\n        return 0\n    if len(numbers) == 1:\n        return 1\n\n    all_subsets = generate_all_subsets(numbers)\n    max_size = 0\n\n    for subset in all_subsets:\n        if is_valid_subset(subset):\n            max_size = max(max_size, len(subset))\n    return max_size"}
{"task_id": "Mbpp/622", "solution": "```python\ndef get_median(list1: list[int], list2: list[int], size: int) -> float:\n    \"\"\"\n    Calculate median from two sorted lists of equal size.\n\n    Args:\n        list1: First sorted list of integers\n        list2: Second sorted list of integers\n        size: Size of each list (must be equal)\n\n    Returns:\n        float: Median value of combined sorted data\n\n    Example:\n        >>> get_median([1, 12, 15, 26, 38], [2, 13, 17, 30, 45], 5)\n        16.0\n    \"\"\"\n    i = 0  # Pointer for list1\n    j = 0  # Pointer for list2\n    m1 = -1  # Stores the (size-1)-th element of the combined sorted list\n    m2 = -1  # Stores the size-th element of the combined sorted list\n\n    # Iterate size + 1 times to find the two middle elements (at 0-indexed positions size-1 and size)\n    for _ in range(size + 1):\n        m1 = m2 # Shift m2 to m1, as m2 will hold the next element\n\n        if i < size and j < size:\n            if list1[i] < list2[j]:\n                m2 = list1[i]\n                i += 1\n            else:\n                m2 = list2[j]\n                j += 1\n        elif i < size: # list2 is exhausted\n            m2 = list1[i]\n            i += 1\n        elif j < size: # list1 is exhausted\n            m2 = list2[j]\n            j += 1\n        # No else for both exhausted, as loop runs max size+1 times and we need size+1 elements total.\n\n    return (m1 + m2) / 2.0\n```"}
