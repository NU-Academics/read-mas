{"task_id": "Mbpp/605", "solution": "def prime_num(n: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a prime number.\n    It handles edge cases for numbers less than or equal to 1 and uses an optimized O(sqrt(n)) algorithm.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "Mbpp/603", "solution": "def _validate_input(limit: int) -> bool:\n    \"\"\"Validates the input limit for generating lucid numbers.\n    Returns True if the limit is a positive integer, False otherwise.\n    \"\"\"\n    return limit >= 1\n\ndef _generate_sequence(limit: int) -> list[int]:\n    \"\"\"Generates an initial sequence of natural numbers from 1 up to the given limit.\"\"\"\n    return list(range(1, limit + 1))\n\ndef _apply_sieve_algorithm(numbers: list[int]) -> list[int]:\n    \"\"\"Applies a sieve-like algorithm to filter numbers, identifying 1 and prime numbers.\n    This method assumes 'lucid numbers' are defined as 1 and the prime numbers up to the limit.\n    \"\"\"\n    if not numbers:\n        return []\n\n    limit = numbers[-1]\n    if limit < 2: # Handles cases like [1] or empty list\n        return numbers\n\n    # Sieve of Eratosthenes to find primes up to limit\n    is_prime = [True] * (limit + 1)\n    is_prime[0] = False\n    is_prime[1] = False # 1 is not a prime number\n\n    p = 2\n    while p * p <= limit:\n        if is_prime[p]:\n            for multiple in range(p * p, limit + 1, p):\n                is_prime[multiple] = False\n        p += 1\n\n    # Collect lucid numbers: 1 (if present in original sequence) and identified primes\n    lucid_numbers = []\n    if 1 in numbers:\n        lucid_numbers.append(1)\n\n    for i in range(2, limit + 1):\n        if is_prime[i]:\n            lucid_numbers.append(i)\n\n    return lucid_numbers\n\ndef get_ludic(limit: int) -> list[int]:\n    \"\"\"Generates all lucid numbers smaller than or equal to a given integer limit.\n    This function implements a sieve algorithm, returning 1 and prime numbers.\n    \"\"\"\n    if not _validate_input(limit):\n        return []\n\n    initial_numbers = _generate_sequence(limit)\n    lucid_numbers = _apply_sieve_algorithm(initial_numbers)\n    return lucid_numbers"}
{"task_id": "Mbpp/605", "solution": "def prime_num(n: int) -> bool:\n    \"\"\"\n    Checks if a given integer is a prime number.\n    Handles positive integers, returning True for primes and False otherwise.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "Mbpp/603", "solution": "```python\nfrom typing import List\n\ndef is_valid_integer(value) -> bool:\n    \"\"\"Checks if value is a valid integer >= 1.\n    Assumes value is an integer based on caller's input trust.\n    \"\"\"\n    return value >= 1\n\ndef validate_input(limit: int) -> bool:\n    \"\"\"Validates the input limit meets requirements.\n    Ensures the limit is an integer and is greater than or equal to 1.\n    \"\"\"\n    return is_valid_integer(limit)\n\ndef sieve_ludic_numbers(candidates: List[int]) -> List[int]:\n    \"\"\"Applies the lucid sieve algorithm to a list of candidate numbers.\n    It generates lucid numbers by iteratively removing every p-th remaining number.\n    \"\"\"\n    current_numbers = list(candidates)\n    lucid_numbers = []\n\n    # Include 1 as the first lucid number if present.\n    if current_numbers and current_numbers[0] == 1:\n        lucid_numbers.append(1)\n        current_numbers.pop(0)\n\n    while current_numbers:\n        p = current_numbers.pop(0)  # The first remaining number is the next lucid number.\n        lucid_numbers.append(p)\n\n        if p > 1:  # The sieve operation only applies for pivots greater than 1.\n            next_list = []\n            for idx, num in enumerate(current_numbers):\n                if (idx + 1) % p != 0:  # Keep numbers whose 1-indexed position is not a multiple of p.\n                    next_list.append(num)\n            current_numbers = next_list\n            \n    return lucid_numbers\n\ndef generate_ludic_sequence(limit: int) -> List[int]:\n    \"\"\"Generates lucid numbers up to the given limit.\n    It creates an initial candidate list and then applies the sieve algorithm.\n    \"\"\"\n    if limit < 1:\n        return []\n\n    candidates = list(range(1, limit + 1))\n    return sieve_ludic_numbers(candidates)\n\ndef get_ludic(limit: int) -> List[int]:\n    \"\"\"Generate all lucid numbers less than or equal to the given limit.\n    This is the primary interface, orchestrating validation and sequence generation.\n    \"\"\"\n    if not validate_input(limit):\n        return []\n\n    lucid_numbers = generate_ludic_sequence(limit)\n    lucid_numbers.sort()  # Ensure the list is sorted as per requirements.\n    return lucid_numbers\n```"}
