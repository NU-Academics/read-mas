{"task_id": "Mbpp/554", "solution": "```python\nfrom typing import List\n\ndef Split(input_list: List[int]) -> List[int]:\n    \"\"\"Filters a list of integers, returning only the odd numbers while maintaining their original order.\n    It handles empty lists and lists with no odd numbers gracefully.\n    \"\"\"\n    odd_numbers = []\n    for number in input_list:\n        if number % 2 != 0:\n            odd_numbers.append(number)\n    return odd_numbers\n```"}
{"task_id": "Mbpp/479", "solution": "def first_Digit(number):\n    \"\"\"\n    Extracts the first digit from a numeric input (int or float).\n    Converts the absolute value of the number to a string and returns the first character as an integer.\n    \"\"\"\n    num_str = str(abs(number))\n    # Handle scientific notation and leading zeros if any, by finding the first actual digit\n    for char in num_str:\n        if char.isdigit():\n            return int(char)\n    # This case should ideally not be reached for valid numeric inputs,\n    # but added for robustness if the string conversion results in something unexpected (e.g., '.5' for 0.5)\n    # The requirement is to trust caller's input and not crash,\n    # so if num_str somehow ends up without digits (e.g., from inf/nan), it would return 0.\n    # However, for regular numbers, it will always find a digit.\n    return 0"}
{"task_id": "Mbpp/478", "solution": "def _is_lowercase_char(char: str) -> bool:\n    \"\"\"Check if character is lowercase letter (a-z).\"\"\"\n    return 'a' <= char <= 'z'\n\ndef _build_result_string(chars: list) -> str:\n    \"\"\"Build result string from list of preserved characters.\"\"\"\n    return \"\".join(chars)\n\ndef remove_lowercase(input_string: str) -> str:\n    \"\"\"Remove all contiguous lowercase substrings from input string.\n    This function processes the string character by character, preserving non-lowercase letters.\n    \"\"\"\n    result_chars = []\n    for char in input_string:\n        if not _is_lowercase_char(char):\n            result_chars.append(char)\n    return _build_result_string(result_chars)"}
{"task_id": "Mbpp/554", "solution": "from typing import List\n\ndef Split(input_list: List[int]) -> List[int]:\n    \"\"\"Filters a list of integers, returning only the odd numbers.\n    It maintains the original order of odd numbers from the input list.\"\"\"\n    odd_numbers = []\n    for number in input_list:\n        if number % 2 != 0:  # Check if the number is odd\n            odd_numbers.append(number)\n    return odd_numbers"}
{"task_id": "Mbpp/555", "solution": "def _sum_of_natural_numbers(n: int) -> int:\n    \"\"\"Calculate sum of first n natural numbers.\n    Uses the closed-form formula n * (n + 1) / 2.\n    \"\"\"\n    return n * (n + 1) // 2\n\ndef _sum_of_cubes(n: int) -> int:\n    \"\"\"Calculate sum of cubes of first n natural numbers.\n    Uses the closed-form formula (n * (n + 1) / 2)^2.\n    \"\"\"\n    sum_naturals = _sum_of_natural_numbers(n)\n    return sum_naturals * sum_naturals\n\ndef difference(n: int) -> int:\n    \"\"\"Calculate difference between sum of cubes and sum of natural numbers.\n    This function orchestrates the calculation using helper functions.\n    \"\"\"\n    sum_cubes = _sum_of_cubes(n)\n    sum_naturals = _sum_of_natural_numbers(n)\n    return sum_cubes - sum_naturals"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes and sum of natural numbers for the first n integers.\n    It uses direct mathematical formulas for efficiency.\n    \"\"\"\n    sum_natural_numbers = n * (n + 1) // 2\n    sum_cubes_of_natural_numbers = sum_natural_numbers * sum_natural_numbers\n    return sum_cubes_of_natural_numbers - sum_natural_numbers"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(array: list[int], size: int) -> int:\n    \"\"\"\n    Counts the number of pairs in an array whose XOR value is odd.\n    An XOR operation between two numbers is odd if one number is even and the other is odd.\n    \"\"\"\n    odd_count = 0\n    even_count = 0\n\n    for i in range(size):\n        if array[i] % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return odd_count * even_count"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"Toggles the case of alphabetic characters in a string.\n    Uppercase characters become lowercase, and lowercase become uppercase; non-alphabetic characters remain unchanged.\"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if char.isupper():\n            toggled_chars.append(char.lower())\n        elif char.islower():\n            toggled_chars.append(char.upper())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in a string.\n    Uppercase becomes lowercase, and lowercase becomes uppercase; non-alphabetic characters are preserved.\n    \"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if char.isalpha():\n            if char.isupper():\n                toggled_chars.append(char.lower())\n            else: # Character is alphabetic and not uppercase, so it must be lowercase\n                toggled_chars.append(char.upper())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"Calculates the sum of absolute differences between corresponding digits of two integers.\n    Handles different lengths by padding with zeros and processes absolute values of inputs.\n    \"\"\"\n    abs_num1 = abs(num1)\n    abs_num2 = abs(num2)\n\n    str_num1 = str(abs_num1)\n    str_num2 = str(abs_num2)\n\n    max_length = max(len(str_num1), len(str_num2))\n\n    padded_str_num1 = str_num1.zfill(max_length)\n    padded_str_num2 = str_num2.zfill(max_length)\n\n    total_sum = 0\n    for i in range(max_length):\n        digit1 = int(padded_str_num1[i])\n        digit2 = int(padded_str_num2[i])\n        total_sum += abs(digit1 - digit2)\n\n    return total_sum"}
{"task_id": "Mbpp/556", "solution": "```python\ndef find_Odd_Pair(array: list[int], size: int) -> int:\n    \"\"\"Counts pairs of elements in an array whose XOR operation results in an odd value.\n    It iterates through all unique pairs, calculates their XOR, and checks if the result is odd.\"\"\"\n    \n    count = 0\n    for i in range(size):\n        for j in range(i + 1, size):\n            element1 = array[i]\n            element2 = array[j]\n\n            # Calculate XOR, mirroring XORCalculator's responsibility.\n            xor_result = element1 ^ element2\n            \n            # Check if the XOR result is odd, mirroring XORCalculator's responsibility.\n            # An XOR result is odd if its least significant bit is 1, meaning x % 2 != 0.\n            if xor_result % 2 != 0:\n                count += 1\n    return count\n```"}
{"task_id": "Mbpp/558", "solution": "```python\ndef digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculate the sum of per-digit absolute differences between two integers.\n    This function handles different lengths and negative inputs.\n    \"\"\"\n    # Convert negative numbers to positive for consistent digit extraction.\n    abs_num1 = abs(num1)\n    abs_num2 = abs(num2)\n\n    # Extract digits from numbers into lists.\n    digits1 = [int(d) for d in str(abs_num1)]\n    digits2 = [int(d) for d in str(abs_num2)]\n\n    # Align lengths by padding the shorter list with leading zeros.\n    max_len = max(len(digits1), len(digits2))\n    digits1 = [0] * (max_len - len(digits1)) + digits1\n    digits2 = [0] * (max_len - len(digits2)) + digits2\n\n    # Calculate and sum the absolute differences of corresponding digits.\n    total_distance = 0\n    for i in range(max_len):\n        total_distance += abs(digits1[i] - digits2[i])\n\n    return total_distance\n```"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr: list, length: int) -> int:\n    \"\"\"\n    Calculates the maximum sum of a contiguous subarray using Kadane's algorithm.\n    Handles negative, positive, and mixed integer arrays efficiently.\n    \"\"\"\n    if not arr:\n        # Per design, trust caller inputs, but an empty array technically has no sum.\n        # Following Kadane's typical initialization for non-empty arrays.\n        # If array can be empty, this needs a clearer definition (e.g., return 0 or raise error).\n        # Assuming arr will always have at least one element based on typical Kadane's usage.\n        return 0 # Or some appropriate default for an empty list\n        \n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, length):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n        \n    return max_so_far"}
{"task_id": "Mbpp/559", "solution": "```python\ndef max_sub_array_sum(arr: list, length: int) -> int:\n    \"\"\"\n    Finds the maximum sum of any contiguous sublist within the input list using Kadane's algorithm.\n    Handles empty arrays, returning 0 as the sum for no elements.\n    \"\"\"\n    if length == 0:\n        return 0\n\n    max_sum = arr[0]\n    current_sum = arr[0]\n\n    for i in range(1, length):\n        current_sum = max(arr[i], current_sum + arr[i])\n        max_sum = max(max_sum, current_sum)\n\n    return max_sum\n```"}
{"task_id": "Mbpp/560", "solution": "def union_elements(tuple1, tuple2):\n    \"\"\"Computes the union of elements from two tuples, returning unique elements sorted as a tuple.\n    Uses set operations for deduplication and built-in sorted for ordering.\"\"\"\n    combined_set = set(tuple1).union(set(tuple2))\n    sorted_elements = sorted(combined_set)\n    return tuple(sorted_elements)"}
{"task_id": "Mbpp/560", "solution": "```python\ndef union_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Find the union of elements from two tuples and return them in sorted order.\n\n    Args:\n        tuple1: First input tuple\n        tuple2: Second input tuple\n\n    Returns:\n        tuple: Sorted tuple containing unique elements from both inputs\n    \"\"\"\n    combined_set = set(tuple1).union(set(tuple2))\n    sorted_elements = sorted(list(combined_set))\n    return tuple(sorted_elements)\n```"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(input_list: list[list]) -> int:\n    \"\"\"\n    Finds the length of the longest sublist within a list of sublists.\n    Handles empty input lists and empty sublists by returning 0 if no sublists or all sublists are empty.\n    \"\"\"\n    max_length = 0\n    for sublist in input_list:\n        max_length = max(max_length, len(sublist))\n    return max_length"}
{"task_id": "Mbpp/562", "solution": "```python\nfrom typing import List\n\ndef Find_Max_Length(sublists: List[List]) -> int:\n    \"\"\"\n    Calculates the length of the longest sublist within a given list of sublists.\n    It leverages Python's built-in len() to get sublist lengths and max() to find the maximum.\n    \"\"\"\n    lengths = [len(sublist) for sublist in sublists]\n    return max(lengths)\n```"}
{"task_id": "Mbpp/563", "solution": "def _validate_input(input_string: str) -> bool:\n    # Performs basic input validation.\n    # Constraints forbid type checks or exceptions, so this is a passthrough.\n    return True\n\ndef _find_quote_pairs(text: str) -> list[tuple[int, int]]:\n    # Locates paired double quotation marks in the input text.\n    # Returns a list of (start_index_of_quote, end_index_of_quote) tuples.\n    quote_indices = [i for i, char in enumerate(text) if char == '\"']\n\n    pairs = []\n    # Iterate to form complete (opening, closing) quote pairs.\n    for i in range(0, len(quote_indices) - 1, 2):\n        start_quote_idx = quote_indices[i]\n        end_quote_idx = quote_indices[i+1]\n        pairs.append((start_quote_idx, end_quote_idx))\n    return pairs\n\ndef _extract_content(text: str, start: int, end: int) -> str:\n    # Extracts text content between the specified start and end indices.\n    # The content starts at 'start' (exclusive of opening quote) and ends at 'end' (exclusive of closing quote).\n    return text[start:end]\n\ndef extract_values(input_string: str) -> list[str]:\n    # Extracts all text values enclosed within double quotation marks from the input string.\n    # Returns extracted values as a list of strings, excluding the quotation marks.\n    _validate_input(input_string)\n\n    extracted_list = []\n    quote_pairs = _find_quote_pairs(input_string)\n\n    for start_quote_idx, end_quote_idx in quote_pairs:\n        # Extract content from the character after the opening quote\n        # up to, but not including, the closing quote.\n        content = _extract_content(input_string, start_quote_idx + 1, end_quote_idx)\n        extracted_list.append(content)\n\n    return extracted_list"}
{"task_id": "Mbpp/563", "solution": "def extract_values(input_string: str) -> list[str]:\n    \"\"\"\n    Extracts all text values enclosed within double quotation marks from an input string.\n    Returns extracted values as a list of strings, without the quotation marks.\n    \"\"\"\n    \n    def _find_quoted_segments(text: str) -> list[tuple]:\n        \"\"\"Locates all pairs of double quotes in the given text, returning their start and end indices.\"\"\"\n        segments = []\n        in_quote = False\n        quote_start_index = -1\n\n        for i, char in enumerate(text):\n            if char == '\"':\n                if not in_quote:\n                    quote_start_index = i\n                    in_quote = True\n                else:\n                    if quote_start_index != -1:\n                        segments.append((quote_start_index, i))\n                    in_quote = False\n                    quote_start_index = -1\n        return segments\n\n    def _extract_content(text: str, start_quote_idx: int, end_quote_idx: int) -> str:\n        \"\"\"Extracts content between (but not including) the start and end quote indices.\"\"\"\n        return text[start_quote_idx + 1 : end_quote_idx]\n\n    extracted_list = []\n    \n    quote_segments = _find_quoted_segments(input_string)\n\n    for start_idx, end_idx in quote_segments:\n        extracted_list.append(_extract_content(input_string, start_idx, end_idx))\n    \n    return extracted_list"}
