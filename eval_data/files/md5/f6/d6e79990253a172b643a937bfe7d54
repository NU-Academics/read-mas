{"task_id": "Mbpp/721", "solution": "from typing import List\n\n# 1. Position Class\nclass Position:\n    \"\"\"Represents a coordinate position (row, col) in the matrix.\"\"\"\n    def __init__(self, row: int, col: int):\n        self.row = row\n        self.col = col\n\n    def getRow(self) -> int:\n        \"\"\"Returns the row index.\"\"\"\n        return self.row\n\n    def getCol(self) -> int:\n        \"\"\"Returns the column index.\"\"\"\n        return self.col\n\n    def canMoveRight(self, matrix_size: int) -> bool:\n        \"\"\"Checks if a move to the right is possible.\"\"\"\n        return self.col + 1 < matrix_size\n\n    def canMoveDown(self, matrix_size: int) -> bool:\n        \"\"\"Checks if a move down is possible.\"\"\"\n        return self.row + 1 < matrix_size\n\n# 2. Matrix Class\nclass Matrix:\n    \"\"\"Encapsulates matrix data and provides cell access operations.\"\"\"\n    def __init__(self, cells: List[List[int]]):\n        self.cells = cells\n        self.size = len(cells)\n\n    def getCellCost(self, row: int, col: int) -> int:\n        \"\"\"Returns the cost of a cell at given coordinates.\"\"\"\n        return self.cells[row][col]\n\n    def getSize(self) -> int:\n        \"\"\"Returns the size (N) of the N*N matrix.\"\"\"\n        return self.size\n\n    def isValidPosition(self, row: int, col: int) -> bool:\n        \"\"\"Checks if the given coordinates are within matrix bounds.\"\"\"\n        return 0 <= row < self.size and 0 <= col < self.size\n\n# 3. Path Class\nclass Path:\n    \"\"\"Represents a path sequence and calculates its average cost.\"\"\"\n    def __init__(self):\n        self.positions: List[Position] = []\n        self._total_cost: float = 0.0\n        self._cell_count: int = 0\n\n    def addPosition(self, pos: Position) -> None:\n        \"\"\"Adds a position to the path.\"\"\"\n        self.positions.append(pos)\n        self._cell_count += 1\n        self._total_cost = 0.0 # Reset to trigger recalculation if path changes\n\n    def calculateAverage(self, matrix: Matrix) -> float:\n        \"\"\"Calculates and stores the total cost and returns the average cost of the path.\"\"\"\n        if self._cell_count == 0:\n            return 0.0\n\n        if self._total_cost == 0.0:\n            current_total_cost = 0.0\n            for pos in self.positions:\n                current_total_cost += matrix.getCellCost(pos.getRow(), pos.getCol())\n            self._total_cost = current_total_cost\n\n        return self._total_cost / self._cell_count\n\n    def getTotalCost(self) -> float:\n        \"\"\"Returns the total cost of cells in the path. Call calculateAverage first.\"\"\"\n        return self._total_cost\n\n    def getCellCount(self) -> int:\n        \"\"\"Returns the number of cells in the path.\"\"\"\n        return self._cell_count\n\n# 4. PathFinder Class\nclass PathFinder:\n    \"\"\"Orchestrates path generation and maximum average calculation.\"\"\"\n    def __init__(self, matrix: Matrix):\n        self.matrix = matrix\n        self.matrix_size = matrix.getSize()\n        self.all_paths: List[Path] = []\n\n    def findMaxAveragePath(self) -> float:\n        \"\"\"Finds and returns the maximum average path cost.\"\"\"\n        self.all_paths = self.generateAllPaths()\n        \n        if not self.all_paths:\n            return 0.0\n\n        max_average = 0.0\n        # Initialize with the first path's average, assuming positive costs\n        max_average = self.calculatePathAverage(self.all_paths[0]) \n\n        for i in range(1, len(self.all_paths)):\n            path = self.all_paths[i]\n            current_average = self.calculatePathAverage(path)\n            if current_average > max_average:\n                max_average = current_average\n        return max_average\n\n    def generateAllPaths(self) -> List[Path]:\n        \"\"\"Generates all possible paths from top-left to bottom-right.\"\"\"\n        generated_paths: List[Path] = []\n        start_position = Position(0, 0)\n        \n        def _generate(current_pos: Position, current_path_obj: Path):\n            # Create a new Path object for this branch to ensure independence\n            new_path_branch = Path()\n            for p in current_path_obj.positions:\n                new_path_branch.addPosition(p)\n            new_path_branch.addPosition(current_pos)\n\n            # If destination reached, add path and return\n            if current_pos.getRow() == self.matrix_size - 1 and \\\n               current_pos.getCol() == self.matrix_size - 1:\n                generated_paths.append(new_path_branch)\n                return\n\n            # Explore right\n            if current_pos.canMoveRight(self.matrix_size):\n                next_pos_right = Position(current_pos.getRow(), current_pos.getCol() + 1)\n                _generate(next_pos_right, new_path_branch)\n\n            # Explore down\n            if current_pos.canMoveDown(self.matrix_size):\n                next_pos_down = Position(current_pos.getRow() + 1, current_pos.getCol())\n                _generate(next_pos_down, new_path_branch)\n        \n        # Start the recursive generation with the first position and an empty path\n        _generate(start_position, Path())\n        return generated_paths\n\n    def calculatePathAverage(self, path: Path) -> float:\n        \"\"\"Calculates the average cost for a given path.\"\"\"\n        return path.calculateAverage(self.matrix)\n\n# 5. Main function (maxAverageOfPath)\ndef maxAverageOfPath(matrix: List[List[int]]) -> float:\n    \"\"\"Finds the path with the maximum average cost in a square matrix.\"\"\"\n    matrix_obj = Matrix(matrix)\n    path_finder = PathFinder(matrix_obj)\n    return path_finder.findMaxAveragePath()"}
{"task_id": "Mbpp/724", "solution": "def _calculate_power(base: int, power: int) -> int:\n    \"\"\"Calculates base raised to the specified power.\"\"\"\n    return base ** power\n\ndef _extract_digits(number: int) -> list:\n    \"\"\"Extracts individual digits from a number.\"\"\"\n    return [int(digit_char) for digit_char in str(number)]\n\ndef _sum_digits(digits: list) -> int:\n    \"\"\"Sums all digits in the provided list.\"\"\"\n    return sum(digits)\n\ndef power_base_sum(base: int, power: int) -> int:\n    \"\"\"Calculates the sum of all digits in the result of raising a base number to a specified power.\"\"\"\n    calculated_power = _calculate_power(base, power)\n    extracted_digits = _extract_digits(calculated_power)\n    digit_sum = _sum_digits(extracted_digits)\n    return digit_sum"}
{"task_id": "Mbpp/724", "solution": "```python\ndef validate_inputs(base: int, power: int) -> bool:\n    \"\"\"Validate that inputs are integers.\n    This function assumes valid integer inputs as per critical requirements.\n    \"\"\"\n    return True\n\n\ndef calculate_power(base: int, power: int) -> int:\n    \"\"\"Calculate base raised to power using built-in operator.\n    Python handles large integer calculations automatically.\n    \"\"\"\n    return base ** power\n\n\ndef extract_digits(number: int) -> list[int]:\n    \"\"\"Extract individual digits from integer.\n    Converts the number to a string and then processes each character.\n    \"\"\"\n    return [int(digit) for digit in str(number)]\n\n\ndef sum_digits(digits: list[int]) -> int:\n    \"\"\"Sum all digits in the list.\n    Uses the built-in sum function for efficiency.\n    \"\"\"\n    return sum(digits)\n\n\ndef power_base_sum(base: int, power: int) -> int:\n    \"\"\"Calculate sum of digits in base^power.\n    Orchestrates validation, power calculation, digit extraction, and summation.\n    \"\"\"\n    # The design specifies validation, but critical requirements forbid type checks.\n    # Therefore, this function performs no actual validation beyond returning True.\n    _ = validate_inputs(base, power)\n\n    result_number = calculate_power(base, power)\n    digits_list = extract_digits(result_number)\n    final_sum = sum_digits(digits_list)\n\n    return final_sum\n```"}
{"task_id": "Mbpp/725", "solution": "def extract_quotation(input_string: str) -> list[str]:\n    \"\"\"\n    Extracts all text values enclosed within double quotation marks from an input string.\n    Returns extracted values as an ordered list of strings, excluding the quotation marks.\n    \"\"\"\n    extracted_values = []\n    current_quotation_buffer = []\n    inside_quote = False\n\n    for char in input_string:\n        if char == '\"':\n            if not inside_quote:\n                # Found an opening quote\n                inside_quote = True\n            else:\n                # Found a closing quote\n                extracted_values.append(\"\".join(current_quotation_buffer))\n                current_quotation_buffer = []\n                inside_quote = False\n        elif inside_quote:\n            # Accumulate characters if inside a quote\n            current_quotation_buffer.append(char)\n\n    return extracted_values"}
