{"task_id": "Mbpp/459", "solution": "def _validate_input(input_string: str) -> bool:\n    \"\"\"Validates the input string according to design specifications.\n    As per critical requirements, actual validation logic (type, length, error handling) is omitted here.\n    \"\"\"\n    # Critical requirements forbid isinstance checks, type guards, or raising exceptions.\n    # Therefore, this helper function, though part of the design, will simply return True.\n    return True\n\ndef _identify_uppercase_ranges(input_string: str) -> list[tuple[int, int]]:\n    \"\"\"Identifies contiguous uppercase letter substrings in the input string.\n    Returns a list of (start_index, end_index) tuples for each uppercase substring.\n    \"\"\"\n    ranges: list[tuple[int, int]] = []\n    current_uppercase_start: int = -1\n\n    for i, char in enumerate(input_string):\n        if 'A' <= char <= 'Z': # Check if char is an uppercase ASCII letter\n            if current_uppercase_start == -1:\n                current_uppercase_start = i\n        else: # Not an uppercase letter\n            if current_uppercase_start != -1:\n                ranges.append((current_uppercase_start, i))\n                current_uppercase_start = -1\n    \n    # If an uppercase sequence extends to the end of the string\n    if current_uppercase_start != -1:\n        ranges.append((current_uppercase_start, len(input_string)))\n        \n    return ranges\n\ndef _reconstruct_string(input_string: str, ranges: list[tuple[int, int]]) -> str:\n    \"\"\"Reconstructs the string by excluding characters within the specified ranges.\n    This builds the final string by concatenating parts outside the uppercase segments.\n    \"\"\"\n    result_parts: list[str] = []\n    last_index: int = 0\n\n    for start, end in ranges:\n        # Append the segment before the current uppercase block\n        if last_index < start:\n            result_parts.append(input_string[last_index:start])\n        # Move past the current uppercase block\n        last_index = end\n    \n    # Append any remaining segment after the last uppercase block\n    if last_index < len(input_string):\n        result_parts.append(input_string[last_index:])\n        \n    return \"\".join(result_parts)\n\ndef remove_uppercase(input_string: str) -> str:\n    \"\"\"Removes all contiguous uppercase letter substrings from the input string.\n    Preserves lowercase letters and non-alphabetic characters.\n    \"\"\"\n    _validate_input(input_string) # Called as per design, but no actual validation occurs here.\n    \n    uppercase_ranges = _identify_uppercase_ranges(input_string)\n    \n    processed_string = _reconstruct_string(input_string, uppercase_ranges)\n    \n    return processed_string"}
{"task_id": "Mbpp/462", "solution": "def _build_combination(elements: list, binary_mask: int) -> list:\n    \"\"\"\n    Build single combination based on binary mask and return it in reverse order.\n    \"\"\"\n    current_combination = []\n    n = len(elements)\n    for i in range(n):\n        if (binary_mask >> i) & 1:\n            current_combination.append(elements[i])\n    current_combination.reverse()\n    return current_combination\n\ndef _generate_binary_combinations(elements: list, n: int) -> list[list]:\n    \"\"\"\n    Generate all combinations using binary representation, from 0 to 2^n - 1.\n    \"\"\"\n    all_combinations = []\n    num_combinations = 1 << n\n    for i in range(num_combinations):\n        all_combinations.append(_build_combination(elements, i))\n    return all_combinations\n\ndef combinations_list(input_list: list) -> list[list]:\n    \"\"\"\n    Generate all possible combinations of elements from input list, including empty.\n    The order of elements within each combination is reversed compared to input order.\n    \"\"\"\n    n = len(input_list)\n    return _generate_binary_combinations(input_list, n)"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(array: list[int]) -> int:\n    \"\"\"\n    Find the maximum product of any contiguous subarray.\n\n    This handles positive, negative, and zero values efficiently.\n    \"\"\"\n\n    if not array:\n        return 0\n\n    max_product = array[0]\n    current_max = array[0]\n    current_min = array[0]\n\n    for i in range(1, len(array)):\n        num = array[i]\n\n        if num < 0:\n            current_max, current_min = current_min, current_max\n\n        current_max = max(num, current_max * num)\n        current_min = min(num, current_min * num)\n\n        max_product = max(max_product, current_max)\n\n    return max_product"}
