{"task_id": "Mbpp/86", "solution": "```python\nclass Result:\n    \"\"\"Encapsulates calculation results.\n    Stores the computed value and a validity flag.\n    \"\"\"\n    def __init__(self, value: int, isValid: bool):\n        self.value = value\n        self.isValid = isValid\n\nclass InputValidator:\n    \"\"\"Validates input parameters for correctness.\n    Checks if an input is a positive integer.\n    \"\"\"\n    def isPositiveInteger(self, n: int) -> bool:\n        \"\"\"Checks if the input is a positive integer.\"\"\"\n        return isinstance(n, int) and n > 0\n\n    def isWithinRange(self, n: int) -> bool:\n        \"\"\"Checks if the input is within valid language limits.\n        For Python, integers have arbitrary precision, so this is always true for valid integers.\n        \"\"\"\n        return True\n\nclass MathematicalFormula:\n    \"\"\"Applies the mathematical formula for centered hexagonal numbers.\"\"\"\n    def __init__(self):\n        self._formula = \"3n(n-1) + 1\"\n\n    def applyFormula(self, n: int) -> int:\n        \"\"\"Applies the centered hexagonal formula 3n(n-1) + 1.\"\"\"\n        return 3 * n * (n - 1) + 1\n\nclass CenteredHexagonalCalculator:\n    \"\"\"Orchestrates the calculation of centered hexagonal numbers.\n    It uses an InputValidator and a MathematicalFormula to perform the calculation.\n    \"\"\"\n    def __init__(self):\n        self._validator = InputValidator()\n        self._formula_engine = MathematicalFormula()\n\n    def validateInput(self, n: int) -> bool:\n        \"\"\"Validates the input parameter n using the internal validator.\"\"\"\n        return self._validator.isPositiveInteger(n) and self._validator.isWithinRange(n)\n\n    def calculateCenteredHexagonal(self, n: int) -> int:\n        \"\"\"Calculates the nth centered hexagonal number using the mathematical formula.\"\"\"\n        # Per specification, \"Trust the caller's inputs\" implies validation for types/ranges\n        # is handled by the overall system, so we proceed directly with computation here.\n        # The design includes validateInput, but the final function requirement is direct.\n        result_value = self._formula_engine.applyFormula(n)\n        return result_value\n\ndef centered_hexagonal_number(n: int) -> int:\n    \"\"\"Calculates the nth centered hexagonal number.\n    This function serves as the main entry point for the calculator.\n    \"\"\"\n    calculator = CenteredHexagonalCalculator()\n    return calculator.calculateCenteredHexagonal(n)\n```"}
