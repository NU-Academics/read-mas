{"task_id": "Mbpp/285", "solution": "```python\ndef _count_following_bs(text: str, start_pos: int) -> int:\n    \"\"\"\n    Count consecutive 'b' characters starting from position.\n    It iterates from start_pos, incrementing a counter for each 'b' found.\n    \"\"\"\n    count = 0\n    for i in range(start_pos, len(text)):\n        if text[i] == 'b':\n            count += 1\n        else:\n            break\n    return count\n\ndef _find_pattern_match(text: str) -> bool:\n    \"\"\"\n    Internal helper to find pattern match in text.\n    It searches for 'a' and then counts following 'b' characters.\n    \"\"\"\n    for i in range(len(text)):\n        if text[i] == 'a':\n            b_count = _count_following_bs(text, i + 1)\n            if b_count == 2 or b_count == 3:\n                return True\n    return False\n\ndef text_match_two_three(input_string: str) -> bool:\n    \"\"\"\n    Check if string contains 'a' followed by exactly 2 or 3 'b' characters.\n    This function acts as the main entry point for validation.\n    \"\"\"\n    return _find_pattern_match(input_string)\n```"}
{"task_id": "Mbpp/285", "solution": "def _validate_sequence(text: str, start_pos: int) -> bool:\n    \"\"\"\n    Internal function to validate character sequence for 'bb' or 'bbb'.\n    It checks if the characters at start_pos, start_pos+1, and optionally start_pos+2 match the pattern.\n    \"\"\"\n    n = len(text)\n\n    # Must have at least two 'b's after 'a'\n    if start_pos + 1 >= n or text[start_pos] != 'b' or text[start_pos + 1] != 'b':\n        return False\n\n    # At this point, we have found 'ab'. Now determine if it's exactly 'abb' or 'abbb'.\n    # Check if there is a third 'b' character.\n    if start_pos + 2 < n and text[start_pos + 2] == 'b':\n        # We found 'abbb'. Now ensure there isn't a fourth 'b'.\n        if start_pos + 3 < n and text[start_pos + 3] == 'b':\n            return False  # Found 'abbbb', which is not allowed.\n        return True  # Found 'abbb'.\n    else:\n        # We found 'abb' because there was no third 'b' (either out of bounds or not 'b').\n        return True  # Found 'abb'.\n\ndef _scan_for_pattern(text: str) -> bool:\n    \"\"\"\n    Internal function to scan for pattern in text.\n    It iterates through the string to find 'a' and then calls a helper to validate the following sequence.\n    \"\"\"\n    n = len(text)\n    # The shortest pattern 'abb' requires 'a' to be at least 3 characters before the end.\n    # So, 'a' can be at index i, where i+2 is the last index for 'bb'. Thus i <= n-3.\n    # The range function goes up to n-3 inclusive.\n    for i in range(n - 2):\n        if text[i] == 'a':\n            # Validate sequence starting from the character immediately after 'a'.\n            if _validate_sequence(text, i + 1):\n                return True\n    return False\n\ndef text_match_two_three(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string contains the character 'a' followed by exactly 2 or 3 'b' characters.\n    Returns True if 'abb' or 'abbb' is found, False otherwise.\n    \"\"\"\n    if not input_string:\n        return False\n    return _scan_for_pattern(input_string)"}
{"task_id": "Mbpp/287", "solution": "```python\ndef square_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of squares of the first n even natural numbers.\n    This function computes \u03a3(2i)\u00b2 for i from 1 to n.\"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        even_number = 2 * i\n        total_sum += even_number ** 2\n    return total_sum\n```"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of squares of the first n even natural numbers.\n    This function generates the first n even numbers, squares each, and sums them.\n    \"\"\"\n    return sum((2 * i) ** 2 for i in range(1, n + 1))"}
{"task_id": "Mbpp/286", "solution": "```python\ndef kadane_algorithm(array: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum sum of a contiguous subarray within the given array.\n    Handles arrays with all negative numbers by returning the largest element.\n    \"\"\"\n    if not array:\n        return float('-inf')\n\n    max_current = array[0]\n    max_global = array[0]\n\n    for i in range(1, len(array)):\n        max_current = max(array[i], max_current + array[i])\n        max_global = max(max_global, max_current)\n    return max_global\n\ndef calculate_prefix_suffix(array: list[int]) -> tuple[int, int]:\n    \"\"\"\n    Computes the maximum prefix sum and maximum suffix sum of the array.\n    Initializes sums to negative infinity for empty arrays.\n    \"\"\"\n    if not array:\n        return float('-inf'), float('-inf')\n\n    max_prefix_sum = float('-inf')\n    current_prefix_sum = 0\n    for x in array:\n        current_prefix_sum += x\n        max_prefix_sum = max(max_prefix_sum, current_prefix_sum)\n\n    max_suffix_sum = float('-inf')\n    current_suffix_sum = 0\n    for x in reversed(array):\n        current_suffix_sum += x\n        max_suffix_sum = max(max_suffix_sum, current_suffix_sum)\n\n    return max_prefix_sum, max_suffix_sum\n\ndef optimize_repeated_sum(\n    array: list[int],\n    k: int,\n    single_max: int,\n    max_prefix_sum: int,\n    max_suffix_sum: int,\n    total_sum_array: int\n) -> int:\n    \"\"\"\n    Calculates the maximum subarray sum for a repeated array using precomputed values.\n    Considers single, two-array span, and multi-array span cases.\n    \"\"\"\n    # If k is 1, the maximum sum is simply the single array's maximum.\n    if k == 1:\n        return single_max\n\n    # Calculate the maximum sum that spans across two arrays.\n    max_sum_two_arrays = max_prefix_sum + max_suffix_sum\n\n    # If the total sum of the original array is positive, we can benefit from including (k-2) full arrays.\n    if total_sum_array > 0:\n        max_sum_multi_arrays = max_prefix_sum + (k - 2) * total_sum_array + max_suffix_sum\n        return max(single_max, max_sum_two_arrays, max_sum_multi_arrays)\n    else:\n        # If the total sum is non-positive, including full arrays would not increase the sum.\n        # Only consider the max within a single array or spanning two arrays.\n        return max(single_max, max_sum_two_arrays)\n\ndef max_sub_array_sum_repeated(array: list[int], array_length: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in a modified array\n    formed by repeating the given array k times, optimized for O(n) complexity.\n    \"\"\"\n    # Handle the edge case where k is 0, meaning no repetitions and thus an empty array.\n    if k == 0:\n        return 0\n\n    # Handle the edge case where the input array is empty.\n    if not array:\n        return 0\n\n    # Compute key sums for the single array.\n    single_max = kadane_algorithm(array)\n    max_prefix_sum, max_suffix_sum = calculate_prefix_suffix(array)\n    total_sum_array = sum(array)\n\n    # Use the optimization logic to find the overall maximum sum.\n    return optimize_repeated_sum(array, k, single_max, max_prefix_sum, max_suffix_sum, total_sum_array)\n```"}
{"task_id": "Mbpp/290", "solution": "from typing import List, Tuple\n\ndef max_length(list_of_lists: List[List[int]]) -> Tuple[int, List[int]]:\n    \"\"\"\n    Find the list with maximum length from a list of lists.\n    Returns a tuple containing the length and the longest list (first occurrence for ties).\n    \"\"\"\n    max_len = 0\n    longest_list: List[int] | None = None # Initialized as per design sequence diagram.\n\n    for sublist in list_of_lists:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            longest_list = sublist\n    \n    # If no list was found (e.g., input was empty or only contained empty lists),\n    # ensure longest_list is an empty list to match the return type.\n    if longest_list is None:\n        return (0, [])\n\n    return (max_len, longest_list)"}
