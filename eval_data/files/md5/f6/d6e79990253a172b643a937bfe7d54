{"task_id": "Mbpp/119", "solution": "def search(array: list) -> int:\n    \"\"\"Finds the element appearing only once in a sorted array where others appear twice.\"\"\"\n    low = 0\n    high = len(array) - 1\n\n    while low < high:\n        mid = low + (high - low) // 2\n\n        # Ensure mid always points to an even index. If mid is odd, decrement it.\n        if mid % 2 == 1:\n            mid -= 1\n\n        # If array[mid] == array[mid + 1], the unique element is to the right.\n        if array[mid] == array[mid + 1]:\n            low = mid + 2\n        # Otherwise, array[mid] is potentially the unique element or it's in the left half.\n        else:\n            high = mid\n    \n    return array[low]"}
{"task_id": "Mbpp/119", "solution": "```python\ndef binary_search_unique(array: list, start: int, end: int) -> int:\n    \"\"\"\n    Recursively finds the unique element using binary search.\n    It identifies whether the unique element is on the left or right\n    based on pair patterns and index parity.\n    \"\"\"\n    if start == end:\n        return array[start]\n\n    mid = start + (end - start) // 2\n\n    # Ensure 'mid' always points to an even index for consistent pair checking (mid, mid+1).\n    if mid % 2 == 1:\n        mid -= 1\n\n    # If the elements at mid and mid+1 are equal, this pair is 'normal'.\n    # The unique element must be in the right subarray, after this pair.\n    if array[mid] == array[mid+1]:\n        return binary_search_unique(array, mid + 2, end)\n    else:\n        # If array[mid] != array[mid+1], the pairing is broken.\n        # The unique element is at or to the left of 'mid'.\n        return binary_search_unique(array, start, mid)\n\ndef search(array: list) -> int:\n    \"\"\"\n    Finds the element that appears exactly once in a sorted array.\n    Implements an O(log n) binary search algorithm.\n    \"\"\"\n    # Initiates the recursive binary search on the entire array.\n    return binary_search_unique(array, 0, len(array) - 1)\n```"}
{"task_id": "Mbpp/120", "solution": "```python\nimport math\n\nclass ProductCalculator:\n    \"\"\"Performs mathematical calculations on numeric pairs.\n    It handles product calculation and absolute value retrieval.\"\"\"\n    def calculate_product(self, num1: float, num2: float) -> float:\n        \"\"\"Multiplies two numbers.\"\"\"\n        return num1 * num2\n\n    def get_absolute_value(self, product: float) -> float:\n        \"\"\"Returns the absolute value of a number.\"\"\"\n        return math.fabs(product)\n\nclass MaxFinder:\n    \"\"\"Identifies maximum values from numeric collections.\n    It provides methods for finding the maximum in a list and comparing two values.\"\"\"\n    def find_max(self, values: list) -> float:\n        \"\"\"Returns the maximum value from a list of numbers.\"\"\"\n        # Trusting the caller's inputs as per critical requirements,\n        # assuming `values` will not be empty when this is called from TupleProcessor.\n        return max(values)\n\n    def compare_values(self, val1: float, val2: float) -> float:\n        \"\"\"Compares two values and returns the larger one.\"\"\"\n        return max(val1, val2)\n\nclass NumericTuple:\n    \"\"\"Encapsulates and provides access to two numeric elements from a tuple.\n    It assumes the input tuple is valid as per critical requirements.\"\"\"\n    def __init__(self, tuple_data):\n        \"\"\"Initializes with two numeric elements, converting them to floats.\"\"\"\n        # Critical requirements forbid explicit type/length checks;\n        # assuming `tuple_data` is a two-element tuple of numeric types.\n        self._first_number = float(tuple_data[0])\n        self._second_number = float(tuple_data[1])\n\n    def get_first(self) -> float:\n        \"\"\"Returns the first numeric element.\"\"\"\n        return self._first_number\n\n    def get_second(self) -> float:\n        \"\"\"Returns the second numeric element.\"\"\"\n        return self._second_number\n\nclass TupleProcessor:\n    \"\"\"Orchestrates the tuple processing workflow and coordinates other components.\n    It iterates through tuples, calculates absolute products, and finds the maximum.\"\"\"\n    def __init__(self):\n        \"\"\"Initializes dependencies: ProductCalculator and MaxFinder.\"\"\"\n        self._product_calculator = ProductCalculator()\n        self._max_finder = MaxFinder()\n\n    def process_tuples(self, tuple_list: list) -> float:\n        \"\"\"Main processing method to find the maximum absolute product from the list.\"\"\"\n        absolute_products = []\n        for tuple_pair in tuple_list:\n            # NumericTuple is instantiated assuming valid input as per critical requirements.\n            numeric_tuple = NumericTuple(tuple_pair)\n            abs_product = self.calculate_absolute_product(numeric_tuple)\n            absolute_products.append(abs_product)\n\n        if not absolute_products:\n            # Handles the edge case of an empty input list without raising an exception.\n            return 0.0\n            \n        return self._max_finder.find_max(absolute_products)\n\n    def calculate_absolute_product(self, numeric_tuple_obj: NumericTuple) -> float:\n        \"\"\"Calculates the absolute product for a single NumericTuple object.\"\"\"\n        product = self._product_calculator.calculate_product(\n            numeric_tuple_obj.get_first(),\n            numeric_tuple_obj.get_second()\n        )\n        return self._product_calculator.get_absolute_value(product)\n\ndef max_product_tuple(tuple_list: list) -> float:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    It delegates the processing to a TupleProcessor instance.\n    \"\"\"\n    processor = TupleProcessor()\n    return processor.process_tuples(tuple_list)\n```"}
{"task_id": "Mbpp/120", "solution": "```python\nfrom typing import List, Tuple, Union\n\ndef max_product_tuple(tuple_list: List[Tuple[Union[int, float], Union[int, float]]]) -> Union[int, float]:\n    \"\"\"\n    Find the maximum absolute product between numbers in pairs of tuples.\n    Calculates absolute products and returns the largest.\n    \"\"\"\n    if not tuple_list:\n        raise ValueError(\"Cannot find maximum product from an empty list.\")\n\n    # Calculate the absolute product for each tuple pair using a list comprehension.\n    absolute_products = [abs(num1 * num2) for num1, num2 in tuple_list]\n\n    # Find the maximum value from the list of absolute products.\n    return max(absolute_products)\n```"}
{"task_id": "Mbpp/123", "solution": "def get_proper_divisors(number: int) -> list[int]:\n    \"\"\"Get list of proper divisors of a number.\n    This includes all positive divisors except the number itself.\n    \"\"\"\n    if number <= 1:\n        return []\n    divs = [1]\n    for i in range(2, int(number**0.5) + 1):\n        if number % i == 0:\n            divs.append(i)\n            if i * i != number:\n                divs.append(number // i)\n    return sorted(divs)\n\ndef sum_of_divisors(number: int) -> int:\n    \"\"\"Calculate sum of proper divisors of a number.\n    It sums all positive divisors excluding the number itself.\n    \"\"\"\n    return sum(get_proper_divisors(number))\n\ndef is_amicable_pair(num1: int, num2: int) -> bool:\n    \"\"\"Check if two numbers form an amicable pair.\n    An amicable pair means the sum of proper divisors of each equals the other.\n    \"\"\"\n    if num1 == num2:\n        return False\n    return sum_of_divisors(num1) == num2 and sum_of_divisors(num2) == num1\n\ndef find_amicable_numbers(limit: int) -> list[int]:\n    \"\"\"Find all amicable numbers in range 1 to limit.\n    It efficiently identifies pairs within the specified upper bound.\n    \"\"\"\n    amicable_set = set()\n    for n in range(1, limit + 1):\n        if n in amicable_set:  # Skip if already identified as part of a pair\n            continue\n\n        sum_n = sum_of_divisors(n)\n\n        # Ensure sum_n is within range and not equal to n (to avoid perfect numbers or self-pairs)\n        if sum_n > n and sum_n <= limit:\n            sum_partner = sum_of_divisors(sum_n)\n            if sum_partner == n:\n                amicable_set.add(n)\n                amicable_set.add(sum_n)\n    return sorted(list(amicable_set))\n\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"Calculate sum of all amicable numbers from 1 to limit (inclusive).\n    It orchestrates finding and summing the identified amicable numbers.\n    \"\"\"\n    amicable_numbers = find_amicable_numbers(limit)\n    return sum(amicable_numbers)"}
