{"task_id": "Mbpp/130", "solution": "from typing import List, Any, Dict\n\ndef max_occurrences(input_list: List) -> Any:\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Handles empty lists by raising a ValueError.\n    \"\"\"\n    if not input_list:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    counts: Dict[Any, int] = {}\n    for item in input_list:\n        counts[item] = counts.get(item, 0) + 1\n\n    max_item: Any = None\n    max_count: int = -1\n\n    for item, count in counts.items():\n        if count > max_count:\n            max_count = count\n            max_item = item\n    \n    return max_item"}
{"task_id": "Mbpp/131", "solution": "def _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel (a, e, i, o, u), case-insensitive, excluding 'y'.\n    Uses a set for efficient lookup of vowel characters.\"\"\"\n    return char.lower() in {'a', 'e', 'i', 'o', 'u'}\n\ndef _extract_vowels(s: str) -> list:\n    \"\"\"Extracts all vowels from the input string in their original order.\n    It identifies vowels using the _is_vowel helper function.\"\"\"\n    vowels = []\n    for char in s:\n        if _is_vowel(char):\n            vowels.append(char)\n    return vowels\n\ndef _reconstruct_string(original: str, reversed_vowels: list) -> str:\n    \"\"\"Rebuilds the string by placing the reversed vowels back into their original positions.\n    Consonants and non-vowel characters remain in their original places.\"\"\"\n    result_chars = list(original)\n    vowel_idx = 0\n    for i, char in enumerate(original):\n        if _is_vowel(char):\n            result_chars[i] = reversed_vowels[vowel_idx]\n            vowel_idx += 1\n    return \"\".join(result_chars)\n\ndef reverse_vowels(s: str) -> str:\n    \"\"\"Reverses only the vowels in a given string while preserving consonant positions.\n    It identifies vowels as 'a', 'e', 'i', 'o', 'u' (case-insensitive), excluding 'y'.\"\"\"\n    extracted_vowels = _extract_vowels(s)\n    reversed_vowels = extracted_vowels[::-1]\n    return _reconstruct_string(s, reversed_vowels)"}
{"task_id": "Mbpp/129", "solution": "def validate_square_matrix(matrix):\n    \"\"\"Checks if the input matrix is square and non-empty.\"\"\"\n    num_rows = len(matrix)\n    if num_rows == 0:\n        return False\n    num_cols = len(matrix[0])\n    if num_cols == 0:\n        return False\n    for row in matrix:\n        if len(row) != num_cols:\n            return False\n    return num_rows == num_cols\n\ndef calculate_row_sums(matrix):\n    \"\"\"Calculates the sum of each row in the matrix.\"\"\"\n    row_sums = []\n    for row in matrix:\n        row_sums.append(sum(row))\n    return row_sums\n\ndef calculate_column_sums(matrix):\n    \"\"\"Calculates the sum of each column in the matrix.\"\"\"\n    n = len(matrix)\n    column_sums = [0] * n\n    for i in range(n):\n        for j in range(n):\n            column_sums[j] += matrix[i][j]\n    return column_sums\n\ndef calculate_diagonal_sums(matrix):\n    \"\"\"Calculates the sums of the main and anti-diagonals.\"\"\"\n    n = len(matrix)\n    main_diag_sum = 0\n    anti_diag_sum = 0\n    for i in range(n):\n        main_diag_sum += matrix[i][i]\n        anti_diag_sum += matrix[i][n - 1 - i]\n    return [main_diag_sum, anti_diag_sum]\n\ndef all_sums_equal(sums):\n    \"\"\"Checks if all values in a list of sums are equal.\"\"\"\n    if not sums:\n        return True # Vacuously true for no sums\n    first_sum = sums[0]\n    for s in sums:\n        if s != first_sum:\n            return False\n    return True\n\ndef magic_square_test(matrix):\n    \"\"\"Determines if a given 2D matrix is a magic square.\"\"\"\n    if not validate_square_matrix(matrix):\n        return False\n\n    row_sums = calculate_row_sums(matrix)\n    col_sums = calculate_column_sums(matrix)\n    diag_sums = calculate_diagonal_sums(matrix)\n\n    all_calculated_sums = row_sums + col_sums + diag_sums\n    return all_sums_equal(all_calculated_sums)"}
{"task_id": "Mbpp/129", "solution": "from typing import List\n\nclass Matrix:\n    \"\"\"\n    Encapsulates matrix data and provides validated access methods.\n    Manages 2D matrix data storage with size validation.\n    \"\"\"\n    def __init__(self, data: List[List[int]]):\n        self._data = data\n        self._size = len(data) if data else 0\n\n    def get_element(self, row: int, col: int) -> int:\n        \"\"\"Retrieves an element at the specified row and column.\"\"\"\n        return self._data[row][col]\n\n    def get_size(self) -> int:\n        \"\"\"Returns the dimension of the square matrix.\"\"\"\n        return self._size\n\n    def is_square(self) -> bool:\n        \"\"\"Checks if the matrix is square and not empty.\"\"\"\n        if self._size == 0:\n            return False\n        return all(len(row) == self._size for row in self._data)\n\n    def get_row(self, row: int) -> List[int]:\n        \"\"\"Returns a specific row from the matrix.\"\"\"\n        return self._data[row]\n\n    def get_column(self, col: int) -> List[int]:\n        \"\"\"Returns a specific column from the matrix.\"\"\"\n        return [self._data[i][col] for i in range(self._size)]\n\nclass SumCalculator:\n    \"\"\"\n    Provides efficient sum calculation methods for matrix validation.\n    Handles row, column, and diagonal sum calculations.\n    \"\"\"\n    def calculate_row_sums(self, matrix: Matrix) -> List[int]:\n        \"\"\"Calculates the sum for each row in the matrix.\"\"\"\n        size = matrix.get_size()\n        return [sum(matrix.get_row(i)) for i in range(size)]\n\n    def calculate_column_sums(self, matrix: Matrix) -> List[int]:\n        \"\"\"Calculates the sum for each column in the matrix.\"\"\"\n        size = matrix.get_size()\n        return [sum(matrix.get_column(i)) for i in range(size)]\n\n    def calculate_main_diagonal_sum(self, matrix: Matrix) -> int:\n        \"\"\"Calculates the sum of the main diagonal (top-left to bottom-right).\"\"\"\n        size = matrix.get_size()\n        return sum(matrix.get_element(i, i) for i in range(size))\n\n    def calculate_anti_diagonal_sum(self, matrix: Matrix) -> int:\n        \"\"\"Calculates the sum of the anti-diagonal (top-right to bottom-left).\"\"\"\n        size = matrix.get_size()\n        return sum(matrix.get_element(i, size - 1 - i) for i in range(size))\n\nclass MagicSquareValidator:\n    \"\"\"\n    Orchestrates magic square validation using calculator and comparison logic.\n    Implements dimension validation and sum equality checking.\n    \"\"\"\n    def __init__(self):\n        self._calculator = SumCalculator()\n\n    def validate(self, matrix: Matrix) -> bool:\n        \"\"\"Performs comprehensive magic square validation for a given matrix.\"\"\"\n        if not self._validate_dimensions(matrix):\n            return False\n        return self._validate_sums(matrix)\n\n    def _validate_dimensions(self, matrix: Matrix) -> bool:\n        \"\"\"Validates if the matrix is a non-empty square.\"\"\"\n        return matrix.is_square()\n\n    def _validate_sums(self, matrix: Matrix) -> bool:\n        \"\"\"Calculates and compares all row, column, and diagonal sums.\"\"\"\n        size = matrix.get_size()\n        if size == 0: # An empty square cannot be a magic square.\n            return False\n\n        row_sums = self._calculator.calculate_row_sums(matrix)\n        col_sums = self._calculator.calculate_column_sums(matrix)\n        main_diag_sum = self._calculator.calculate_main_diagonal_sum(matrix)\n        anti_diag_sum = self._calculator.calculate_anti_diagonal_sum(matrix)\n\n        return self._compare_all_sums(row_sums, col_sums, main_diag_sum, anti_diag_sum)\n\n    def _compare_all_sums(self, row_sums: List[int], col_sums: List[int], main_diag: int, anti_diag: int) -> bool:\n        \"\"\"Compares all calculated sums to ensure they are equal.\"\"\"\n        if not row_sums: # If the matrix size was 0, row_sums would be empty.\n            return False\n\n        expected_sum = row_sums[0]\n\n        if any(s != expected_sum for s in row_sums):\n            return False\n        if any(s != expected_sum for s in col_sums):\n            return False\n\n        return main_diag == expected_sum and anti_diag == expected_sum\n\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"\n    Determines whether a given 2D matrix constitutes a valid magic square.\n    All rows, columns, and diagonals must sum to the same value.\n    \"\"\"\n    matrix_instance = Matrix(matrix)\n    validator_instance = MagicSquareValidator()\n    return validator_instance.validate(matrix_instance)"}
{"task_id": "Mbpp/131", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Check if character is a vowel (a,e,i,o,u case-insensitive).\n    'y' is explicitly treated as a consonant.\n    \"\"\"\n    return char.lower() in VOWELS\n\ndef _extract_vowels_with_positions(text: str) -> list[tuple[int, str]]:\n    \"\"\"Extracts all vowels from the string along with their original positions.\n    Returns a list of (index, vowel_character) tuples.\n    \"\"\"\n    vowels_with_pos = []\n    for i, char in enumerate(text):\n        if _is_vowel(char):\n            vowels_with_pos.append((i, char))\n    return vowels_with_pos\n\ndef _reconstruct_string(original: str, vowels_to_place: list[tuple[int, str]]) -> str:\n    \"\"\"Reconstructs the original string by placing new vowels at specified positions.\n    The `vowels_to_place` list contains (position, character) tuples.\n    \"\"\"\n    char_list = list(original)\n    for pos, char in vowels_to_place:\n        char_list[pos] = char\n    return \"\".join(char_list)\n\ndef reverse_vowels(input_string: str) -> str:\n    \"\"\"Reverse only the vowels in the given string, preserving case and consonant positions.\n    This function coordinates helper functions for vowel identification and string reconstruction.\n    \"\"\"\n    extracted_vowels_with_positions = _extract_vowels_with_positions(input_string)\n\n    # Extract only the vowel characters and reverse their order\n    vowel_chars_only = [v[1] for v in extracted_vowels_with_positions]\n    reversed_vowel_chars = vowel_chars_only[::-1]\n\n    # Map the reversed vowel characters back to their original positions\n    vowels_for_reconstruction = []\n    for i in range(len(extracted_vowels_with_positions)):\n        original_pos = extracted_vowels_with_positions[i][0]\n        new_vowel_char = reversed_vowel_chars[i]\n        vowels_for_reconstruction.append((original_pos, new_vowel_char))\n\n    return _reconstruct_string(input_string, vowels_for_reconstruction)"}
