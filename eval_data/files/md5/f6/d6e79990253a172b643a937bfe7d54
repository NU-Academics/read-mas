{"task_id": "Mbpp/804", "solution": "from typing import List, Union\n\ndef _contains_zero(numbers: List[Union[int, float]]) -> bool:\n    \"\"\"Checks if the list contains the number zero.\n    Returns True if zero is found, False otherwise.\"\"\"\n    for num in numbers:\n        if num == 0:\n            return True\n    return False\n\ndef _calculate_product(numbers: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Calculates the product of all numbers in a list.\n    Returns the accumulated product.\"\"\"\n    product = 1\n    for num in numbers:\n        product *= num\n    return product\n\ndef _is_even(number: Union[int, float]) -> bool:\n    \"\"\"Checks if a number is even.\n    A number is even if its remainder when divided by 2 is 0.\"\"\"\n    return number % 2 == 0\n\ndef is_product_even(numbers: List[Union[int, float]]) -> bool:\n    \"\"\"\n    Check whether the product of numbers in a list is even.\n\n    Args:\n        numbers: List of numbers (integers or floats)\n\n    Returns:\n        bool: True if product is even, False if odd\n    \"\"\"\n    if not numbers:\n        return False\n\n    if _contains_zero(numbers):\n        return True\n\n    product = _calculate_product(numbers)\n    return _is_even(product)"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(lists_of_lists):\n    \"\"\"\n    Returns the list with the highest sum of elements.\n    Handles ties by returning the first occurrence.\n    \"\"\"\n    if not lists_of_lists:\n        return []\n\n    # Calculate sums for all inner lists\n    # Use enumerate to keep track of the original index for tie-breaking\n    sums_with_indices = []\n    for i, inner_list in enumerate(lists_of_lists):\n        sums_with_indices.append((sum(inner_list), i))\n\n    # Find the entry with the maximum sum.\n    # Python's max() will return the first occurrence for ties if elements are compared by the key.\n    # The key is the sum (the first element of the tuple).\n    max_sum_and_index = max(sums_with_indices, key=lambda item: item[0])\n\n    # The index of the list with the max sum is the second element of the tuple.\n    max_index = max_sum_and_index[1]\n\n    return lists_of_lists[max_index]"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum run of consecutive uppercase characters in a string.\n    It processes the string in a single pass, achieving O(n) time and O(1) space complexity.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n            if current_run > max_run:\n                max_run = current_run\n        else:\n            current_run = 0\n    return max_run"}
