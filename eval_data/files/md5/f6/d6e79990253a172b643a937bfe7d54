{"task_id": "Mbpp/766", "solution": "from typing import List, Tuple\n\ndef _validate_input(input_list: List) -> bool:\n    \"\"\"Validates if the input list has at least two elements.\"\"\"\n    return len(input_list) >= 2\n\ndef _create_pairs(input_list: List) -> List[Tuple]:\n    \"\"\"Generates consecutive pairs from a list.\"\"\"\n    pairs = []\n    for i in range(len(input_list) - 1):\n        pairs.append((input_list[i], input_list[i+1]))\n    return pairs\n\ndef pair_wise(input_list: List) -> List[Tuple]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in a given list.\n    Handles lists with fewer than two elements by returning an empty list.\n    \"\"\"\n    if not _validate_input(input_list):\n        return []\n    return _create_pairs(input_list)"}
{"task_id": "Mbpp/767", "solution": "def _validate_input(numbers, target_sum):\n    \"\"\"\n    Validates input parameters for edge cases.\n    Returns True if valid, False otherwise.\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n    return True\n\ndef _count_pairs(numbers, target_sum):\n    \"\"\"\n    Implements the core pair counting algorithm for numbers.\n    Counts pairs (i, j) where i < j and numbers[i] + numbers[j] == target_sum.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count\n\ndef get_pairs_count(numbers, target_sum):\n    \"\"\"\n    Counts pairs of numbers in a list whose sum equals a target value.\n    Handles duplicate elements by considering their positions.\n    \"\"\"\n    if not _validate_input(numbers, target_sum):\n        return 0\n    return _count_pairs(numbers, target_sum)"}
{"task_id": "Mbpp/765", "solution": "```python\ndef find_nth_polite_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth polite number.\n    A polite number is a positive integer that is not a power of 2.\n    \"\"\"\n\n    def is_power_of_two(num: int) -> bool:\n        \"\"\"Determines if a number is a power of 2 using bitwise operations.\"\"\"\n        return num > 0 and (num & (num - 1) == 0)\n\n    # Critical requirements state to \"Trust the caller's inputs\" and\n    # \"Do NOT add ... raise exceptions for edge cases\".\n    # Therefore, explicit input validation for `n > 0` is omitted,\n    # and `validate_input` is not called within this function.\n\n    polite_count = 0\n    current_num = 1\n\n    while True:\n        if not is_power_of_two(current_num):\n            polite_count += 1\n            if polite_count == n:\n                return current_num\n        current_num += 1\n\n```"}
{"task_id": "Mbpp/765", "solution": "```python\nfrom typing import List, Tuple\n\n# --- From src/input_validator.py ---\ndef validate_positive_integer(n: int) -> bool:\n    \"\"\"Validates if the input n is a positive integer.\"\"\"\n    return n > 0\n\ndef handle_invalid_input(n: int) -> None:\n    \"\"\"Handles invalid input cases without raising exceptions.\"\"\"\n    # As per critical requirement, exceptions are not raised here.\n    pass\n\n# --- From src/consecutive_checker.py ---\ndef can_be_consecutive_sum(num: int) -> bool:\n    \"\"\"Checks if a number can be expressed as a sum of two or more consecutive positive integers.\"\"\"\n    # A positive integer is polite (can be expressed as a consecutive sum) if it is not a power of 2.\n    return num > 0 and (num & (num - 1)) != 0\n\ndef find_consecutive_sequences(num: int) -> List[Tuple[int, int]]:\n    \"\"\"Finds all consecutive sequences that sum up to num.\"\"\"\n    # This utility is included as per design, but not directly used by the main polite number algorithm.\n    sequences = []\n    for start in range(1, num // 2 + 1):\n        current_sum = 0\n        for i in range(start, num + 1):\n            current_sum += i\n            if current_sum == num:\n                sequences.append((start, i))\n                break\n            if current_sum > num:\n                break\n    return sequences\n\n# --- From src/polite_calculator.py ---\ndef is_polite_number(num: int) -> bool:\n    \"\"\"Determines if a number is polite by delegating to the consecutive sum checker.\"\"\"\n    return can_be_consecutive_sum(num)\n\ndef calculate_nth_polite(n: int) -> int:\n    \"\"\"Calculates the nth polite number by iterating through positive integers.\"\"\"\n    polite_count = 0\n    current_num = 1\n    while True:\n        if is_polite_number(current_num):\n            polite_count += 1\n            if polite_count == n:\n                return current_num\n        current_num += 1\n\n# --- From src/main.py ---\ndef is_polite(n: int) -> int:\n    \"\"\"\n    Calculates the nth polite number, serving as the public API entry point.\n    This function adheres to critical requirements: no exception raising and trusting caller's inputs.\n    \"\"\"\n    # Input validation functions are defined but not actively used here due to critical constraints.\n    return calculate_nth_polite(n)\n```"}
{"task_id": "Mbpp/766", "solution": "from typing import List, Tuple, Any\n\ndef pair_wise(input_list: List[Any]) -> List[Tuple[Any, Any]]:\n    \"\"\"Generates consecutive item pairs from an input list.\n    Returns an empty list if the input has fewer than 2 items.\"\"\"\n    \n    n = len(input_list)\n    if n < 2:\n        return []\n    \n    return [(input_list[i], input_list[i+1]) for i in range(n - 1)]"}
{"task_id": "Mbpp/769", "solution": "```python\ndef Diff(first_list: list, second_list: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists, returning elements from the first list\n    not present in the second, while preserving the original order.\n    \"\"\"\n    result = []\n    # Convert the second list to a set for efficient lookup of elements.\n    second_set = set(second_list)\n\n    for item in first_list:\n        # If an element from the first list is not found in the second set, add it to the result.\n        if item not in second_set:\n            result.append(item)\n\n    return result\n```"}
{"task_id": "Mbpp/769", "solution": "def Diff(first_list: list, second_list: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists, preserving the order of elements from the first list.\n    Returns elements from the first list that are not present in the second list.\n    \"\"\"\n    second_set = set(second_list) # Use a set for efficient O(1) average time lookups.\n    result_list = []\n    for item in first_list:\n        if item not in second_set:\n            result_list.append(item)\n    return result_list"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list, target_sum) -> int:\n    \"\"\"\n    Counts pairs of numbers from a list that sum to a specified target.\n    Treats elements at different indices as distinct, even if values are identical.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"Calculates the sum of fourth powers of the first n odd natural numbers.\n    The sum is computed iteratively based on the formula \u03a3(2i-1)\u2074 for i=1 to n.\"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        odd_number = (2 * i) - 1\n        total_sum += odd_number ** 4\n    return total_sum"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculate sum of fourth powers of first n odd natural numbers.\n\n    Args:\n        n (int): Number of odd numbers to process\n\n    Returns:\n        int: Sum of fourth powers\n    \"\"\"\n    total_sum = 0\n    for i in range(n):\n        odd_number = 2 * i + 1\n        total_sum += odd_number ** 4\n    return total_sum"}
{"task_id": "Mbpp/772", "solution": "```python\ndef _split_words(text: str) -> list[str]:\n    \"\"\"Split text into words, handling multiple spaces.\n    Uses string's split method to tokenize.\n    \"\"\"\n    return text.split()\n\ndef _filter_words_by_length(words: list[str], length: int) -> list[str]:\n    \"\"\"Return words that do not have exactly 'length' characters.\n    Filters words using a list comprehension based on length.\n    \"\"\"\n    return [word for word in words if len(word) != length]\n\ndef _join_words(words: list[str]) -> str:\n    \"\"\"Join words with single spaces.\n    Uses string's join method for reconstruction.\n    \"\"\"\n    return \" \".join(words)\n\ndef remove_length(input_string: str, k: int) -> str:\n    \"\"\"Remove all words with exactly k characters from input string.\n    Orchestrates splitting, filtering, and joining words.\n    \"\"\"\n    words = _split_words(input_string)\n    filtered_words = _filter_words_by_length(words, k)\n    result_string = _join_words(filtered_words)\n    return result_string\n```"}
{"task_id": "Mbpp/773", "solution": "```python\ndef occurance_substring(source_string: str, target_substring: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Find the first occurrence and position of a substring within a string.\n    Returns a tuple (substring, start_position, end_position) or None if no match.\n    \"\"\"\n    start_position = source_string.find(target_substring)\n\n    if start_position != -1:\n        end_position = start_position + len(target_substring)\n        return (target_substring, start_position, end_position)\n    else:\n        return None\n```"}
{"task_id": "Mbpp/772", "solution": "def _split_words(text: str) -> list[str]:\n    \"\"\"Splits a string into words, handling various whitespace patterns.\"\"\"\n    return text.strip().split()\n\ndef _filter_by_length(words: list[str], k: int) -> list[str]:\n    \"\"\"Filters a list of words, removing those with exact length k.\"\"\"\n    return [word for word in words if len(word) != k]\n\ndef _join_words(words: list[str]) -> str:\n    \"\"\"Joins words into a single string with spaces, ensuring proper formatting.\"\"\"\n    return \" \".join(words)\n\ndef remove_length(input_string: str, k: int) -> str:\n    \"\"\"\n    Removes all words of a specific character length from the input string.\n    Preserves word order and formats the output with single spaces.\n    \"\"\"\n    words = _split_words(input_string)\n    filtered_words = _filter_by_length(words, k)\n    return _join_words(filtered_words)"}
{"task_id": "Mbpp/771", "solution": "class BracketStack:\n    \"\"\"Manages stack operations for bracket tracking.\"\"\"\n    def __init__(self):\n        self._stack = []\n\n    def push(self, bracket: str) -> None:\n        \"\"\"Pushes a bracket onto the stack.\"\"\"\n        self._stack.append(bracket)\n\n    def pop(self) -> str:\n        \"\"\"Removes and returns the top bracket from the stack.\"\"\"\n        return self._stack.pop()\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the stack is empty.\"\"\"\n        return len(self._stack) == 0\n\n    def peek(self) -> str:\n        \"\"\"Returns the top bracket without removing it.\"\"\"\n        return self._stack[-1]\n\nclass Expression:\n    \"\"\"Wraps input string with utility methods.\"\"\"\n    def __init__(self, content: str):\n        self._content = content\n\n    def get_content(self) -> str:\n        \"\"\"Returns the raw string content.\"\"\"\n        return self._content\n\n    def get_length(self) -> int:\n        \"\"\"Returns the length of the expression string.\"\"\"\n        return len(self._content)\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the expression string is empty.\"\"\"\n        return len(self._content) == 0\n\nclass ValidationResult:\n    \"\"\"Wraps boolean validation result.\"\"\"\n    def __init__(self, is_balanced: bool):\n        self._is_balanced = is_balanced\n\n    def get_result(self) -> bool:\n        \"\"\"Returns the boolean result of the validation.\"\"\"\n        return self._is_balanced\n\nclass ExpressionValidator:\n    \"\"\"Implements bracket balance validation algorithm.\"\"\"\n    _opening_brackets = {'(', '[', '{'}\n    _closing_brackets = {')', ']', '}'}\n    _bracket_pairs = {')': '(', ']': '[', '}': '{'}\n\n    def is_opening_bracket(self, char: str) -> bool:\n        \"\"\"Determines if a character is an opening bracket.\"\"\"\n        return char in self._opening_brackets\n\n    def is_closing_bracket(self, char: str) -> bool:\n        \"\"\"Determines if a character is a closing bracket.\"\"\"\n        return char in self._closing_brackets\n\n    def matches_bracket_pair(self, opening: str, closing: str) -> bool:\n        \"\"\"Checks if an opening and closing bracket form a valid pair.\"\"\"\n        return self._bracket_pairs.get(closing) == opening\n\n    def check_expression(self, expression_str: str) -> bool:\n        \"\"\"Performs the core bracket balance validation.\"\"\"\n        expr = Expression(expression_str)\n        if expr.is_empty():\n            return ValidationResult(True).get_result()\n\n        stack = BracketStack()\n\n        for char in expr.get_content():\n            if self.is_opening_bracket(char):\n                stack.push(char)\n            elif self.is_closing_bracket(char):\n                if stack.is_empty():\n                    return ValidationResult(False).get_result()\n                \n                opening_bracket = stack.pop()\n                if not self.matches_bracket_pair(opening_bracket, char):\n                    return ValidationResult(False).get_result()\n        \n        return ValidationResult(stack.is_empty()).get_result()\n\ndef check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given string expression has properly balanced brackets.\n    Supports '()', '[]', '{}' and ignores non-bracket characters.\n    \"\"\"\n    validator = ExpressionValidator()\n    return validator.check_expression(expression)"}
{"task_id": "Mbpp/771", "solution": "# The `BracketType` class provides utility for identifying bracket characters and their matching pairs.\nclass BracketType:\n    BRACKET_PAIRS = {'(': ')', '[': ']', '{': '}'}\n    OPENING_BRACKETS = set(BRACKET_PAIRS.keys())\n    CLOSING_BRACKETS = set(BRACKET_PAIRS.values())\n\n    @staticmethod\n    def getMatchingClose(open_char: str) -> str:\n        \"\"\"Returns the expected closing bracket for a given opening bracket.\"\"\"\n        return BracketType.BRACKET_PAIRS.get(open_char)\n\n# The `BracketStack` class implements LIFO stack operations for tracking opening brackets.\nclass BracketStack:\n    def __init__(self):\n        self._stack = []\n\n    def push(self, char: str) -> None:\n        \"\"\"Adds an item to the top of the stack.\"\"\"\n        self._stack.append(char)\n\n    def pop(self) -> str:\n        \"\"\"Removes and returns the item from the top of the stack, or None if empty.\"\"\"\n        if self._stack:\n            return self._stack.pop()\n        return None\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the stack is empty.\"\"\"\n        return not self._stack\n\n# The `BracketValidator` class contains the core algorithm for LIFO bracket matching.\nclass BracketValidator:\n    def checkExpression(self, expression: str) -> bool:\n        \"\"\"Validates if the given expression has properly balanced brackets.\n        It uses a stack to ensure LIFO matching of opening and closing brackets.\"\"\"\n        stack = BracketStack()\n\n        for char in expression:\n            if char in BracketType.OPENING_BRACKETS:\n                stack.push(char)\n            elif char in BracketType.CLOSING_BRACKETS:\n                if stack.isEmpty():\n                    return False\n                last_open = stack.pop()\n                if BracketType.getMatchingClose(last_open) != char:\n                    return False\n        return stack.isEmpty()\n\ndef check_expression(expression: str) -> bool:\n    \"\"\"Checks if a string expression containing brackets is properly balanced.\n    It returns True for balanced expressions and False for unbalanced ones.\"\"\"\n    validator = BracketValidator()\n    return validator.checkExpression(expression)"}
{"task_id": "Mbpp/773", "solution": "def _validate_inputs(main_string: str, substring: str) -> bool:\n    \"\"\"Validates input parameters are valid strings.\n    This function trusts the caller's inputs and performs no specific checks.\n    \"\"\"\n    return True\n\ndef _calculate_positions(start_index: int, substring_length: int) -> tuple:\n    \"\"\"Calculates the start and end positions of a matched substring.\n    The end position is the index after the last character of the match.\n    \"\"\"\n    end_position = start_index + substring_length\n    return (start_index, end_position)\n\ndef occurance_substring(main_string: str, substring: str) -> tuple | None:\n    \"\"\"Finds the first occurrence of a substring within a main string.\n    Returns a tuple (substring, start_position, end_position) or None if no match.\n    \"\"\"\n    if not _validate_inputs(main_string, substring):\n        # This branch is not expected to be taken due to _validate_inputs implementation\n        return None\n\n    start_index = main_string.find(substring)\n\n    if start_index != -1:\n        substring_length = len(substring)\n        start_position, end_position = _calculate_positions(start_index, substring_length)\n        return (substring, start_position, end_position)\n    else:\n        return None"}
{"task_id": "Mbpp/775", "solution": "def _is_odd_number(number: int) -> bool:\n    \"\"\"Helper function to check if a number is odd.\n    It returns True if the number is odd, False otherwise.\"\"\"\n    return number % 2 != 0\n\ndef _is_odd_index(index: int) -> bool:\n    \"\"\"Helper function to check if an index position is odd.\n    It returns True if the index is odd, False otherwise.\"\"\"\n    return index % 2 != 0\n\ndef odd_position(input_list: list) -> bool:\n    \"\"\"\n    Check whether every odd index contains odd numbers in the given list.\n    Returns True if all odd indices contain odd numbers, False otherwise.\n    \"\"\"\n    for index, number in enumerate(input_list):\n        if _is_odd_index(index):\n            if not _is_odd_number(number):\n                return False\n    return True"}
