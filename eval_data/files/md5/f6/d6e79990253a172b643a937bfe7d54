{"task_id": "Mbpp/564", "solution": "def count_Pairs(lst: list[int], length: int) -> int:\n    \"\"\"Counts unordered pairs of unequal elements in a list of integers.\n    It treats each position separately and considers pairs (a,b) and (b,a) as the same.\n    \"\"\"\n    count = 0\n    n = len(lst)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if lst[i] != lst[j]:\n                count += 1\n    return count"}
{"task_id": "Mbpp/564", "solution": "def _generate_pairs(arr: list[int]):\n    \"\"\"Generates all possible unordered pairs from the input list.\"\"\"\n    n = len(arr)\n    for i in range(n):\n        for j in range(i + 1, n):\n            yield (arr[i], arr[j])\n\ndef _count_unequal_pairs(pairs):\n    \"\"\"Counts the number of pairs where elements are unequal.\"\"\"\n    count = 0\n    for a, b in pairs:\n        if a != b:\n            count += 1\n    return count\n\ndef count_Pairs(arr: list[int], n: int) -> int:\n    \"\"\"Counts all possible unordered pairs from the input list where elements have different values.\"\"\"\n    all_pairs = _generate_pairs(arr)\n    return _count_unequal_pairs(all_pairs)"}
{"task_id": "Mbpp/566", "solution": "def sum_digits(n: int) -> int:\n    \"\"\"\n    Calculate the sum of digits in a non-negative integer.\n    It iteratively extracts and sums digits using modulo and integer division.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    digit_sum = 0\n    while n > 0:\n        digit_sum += n % 10\n        n //= 10\n    return digit_sum"}
{"task_id": "Mbpp/566", "solution": "def _extract_digits(n: int) -> list[int]:\n    \"\"\"Extracts individual digits from an integer.\n    Converts the number to a string and then to a list of integers.\"\"\"\n    return [int(digit) for digit in str(n)]\n\ndef _calculate_sum(digits: list[int]) -> int:\n    \"\"\"Calculates the sum of a list of digits.\"\"\"\n    return sum(digits)\n\ndef sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of all individual digits in a non-negative integer.\n    It processes the input by extracting digits and then summing them.\n    \"\"\"\n    extracted_digits = _extract_digits(n)\n    total_sum = _calculate_sum(extracted_digits)\n    return total_sum"}
{"task_id": "Mbpp/567", "solution": "```python\ndef issort_list(input_list: list) -> bool:\n    \"\"\"Checks if a list is sorted in ascending order.\n    Returns True for empty or single-element lists.\"\"\"\n    n = len(input_list)\n    if n <= 1:\n        return True\n    \n    for i in range(n - 1):\n        if input_list[i] > input_list[i+1]:\n            return False\n            \n    return True\n```"}
