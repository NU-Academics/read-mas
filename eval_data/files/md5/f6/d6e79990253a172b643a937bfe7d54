{"task_id": "Mbpp/445", "solution": "def index_multiplication(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs index-wise multiplication of corresponding nested tuple pairs from two input tuples.\n    Returns a new tuple with the multiplication results, preserving the original structure.\n    \"\"\"\n    result = []\n    for inner_tuple1, inner_tuple2 in zip(tuple1, tuple2):\n        multiplied_pair = (inner_tuple1[0] * inner_tuple2[0], inner_tuple1[1] * inner_tuple2[1])\n        result.append(multiplied_pair)\n    return tuple(result)"}
{"task_id": "Mbpp/440", "solution": "import re\nimport string\n\n_COMMON_ADVERBS_SET = {\n    \"always\", \"almost\", \"also\", \"as\", \"away\", \"back\", \"just\", \"even\", \"ever\",\n    \"far\", \"fast\", \"first\", \"hard\", \"here\", \"how\", \"late\", \"less\", \"more\",\n    \"much\", \"never\", \"next\", \"no\", \"now\", \"off\", \"often\", \"once\", \"only\",\n    \"out\", \"quite\", \"rather\", \"really\", \"seldom\", \"so\", \"soon\", \"still\",\n    \"then\", \"there\", \"too\", \"today\", \"tomorrow\", \"tonight\", \"under\", \"up\",\n    \"very\", \"well\", \"when\", \"where\", \"why\", \"yet\", \"indeed\", \"sometimes\",\n    \"usually\", \"frequently\", \"occasionally\", \"rarely\", \"daily\", \"weekly\",\n    \"monthly\", \"yearly\", \"down\", \"inside\", \"outside\", \"above\", \"below\",\n    \"ago\", \"early\", \"slowly\", \"quickly\", \"loudly\", \"softly\", \"badly\",\n    \"hardly\", \"little\", \"such\", \"enough\", \"barely\", \"scarcely\", \"fairly\",\n    \"pretty\", \"absolutely\", \"definitely\", \"certainly\", \"probably\", \"possibly\",\n    \"perhaps\", \"maybe\", \"truly\", \"simply\", \"merely\", \"otherwise\"\n}\n\ndef _clean_punctuation(word: str) -> str:\n    \"\"\"Removes leading and trailing punctuation marks from a word.\"\"\"\n    return word.strip(string.punctuation)\n\ndef _is_adverb(word: str) -> bool:\n    \"\"\"Determines if a word is an adverb using common rules (ends in -ly or in a predefined set).\"\"\"\n    lower_word = word.lower()\n    return lower_word.endswith(\"ly\") or lower_word in _COMMON_ADVERBS_SET\n\ndef _tokenize_words(sentence: str) -> list:\n    \"\"\"Splits a sentence into words, tracking their start and end positions.\"\"\"\n    return [(match.group(0), match.start(), match.end()) for match in re.finditer(r'\\S+', sentence)]\n\ndef _calculate_positions(sentence: str, word_start: int, word_end: int) -> tuple:\n    \"\"\"Calculates the exact start and end positions of the cleaned adverb within the original sentence.\"\"\"\n    original_token_with_punct = sentence[word_start:word_end]\n    cleaned_adverb_text = _clean_punctuation(original_token_with_punct)\n\n    relative_start_in_token = original_token_with_punct.find(cleaned_adverb_text)\n    \n    actual_start_pos = word_start + relative_start_in_token\n    actual_end_pos = actual_start_pos + len(cleaned_adverb_text)\n    return actual_start_pos, actual_end_pos\n\ndef find_adverb_position(sentence: str) -> tuple:\n    \"\"\"\n    Identifies the first adverb in a sentence and returns its position and text.\n    It tokenizes, cleans, checks for adverbs, and calculates precise positions.\n    \"\"\"\n    if not sentence:\n        return None\n\n    tokenized_words = _tokenize_words(sentence)\n\n    for original_word_text, start_idx, end_idx in tokenized_words:\n        cleaned_word = _clean_punctuation(original_word_text)\n        if cleaned_word and _is_adverb(cleaned_word):\n            adverb_start, adverb_end = _calculate_positions(sentence, start_idx, end_idx)\n            return (adverb_start, adverb_end, cleaned_word)\n\n    return None"}
{"task_id": "Mbpp/440", "solution": "```python\nimport re\nimport string\nimport unicodedata\n\ndef _get_adverb_patterns() -> tuple[list[str], list[str]]:\n    \"\"\"\n    Returns lists of common adverb suffixes and specific adverb words for detection.\n    These patterns aid in identifying adverbs based on their common forms.\n    \"\"\"\n    suffixes = [\n        \"ly\", \"ward\", \"wards\", \"wise\", \"where\", \"time\", \"s\"\n    ]\n    common_adverbs = [\n        \"just\", \"very\", \"quite\", \"rather\", \"too\", \"well\", \"never\", \"always\",\n        \"often\", \"seldom\", \"sometimes\", \"usually\", \"ever\", \"soon\", \"late\",\n        \"early\", \"here\", \"there\", \"now\", \"then\", \"ago\", \"today\", \"yesterday\",\n        \"tomorrow\", \"up\", \"down\", \"in\", \"out\", \"away\", \"back\", \"almost\",\n        \"already\", \"enough\", \"hard\", \"high\", \"low\", \"much\", \"near\", \"only\",\n        \"still\", \"yet\", \"rather\", \"indeed\", \"forth\", \"hence\", \"thereby\", \"thus\",\n        \"also\", \"else\", \"furthermore\", \"moreover\", \"otherwise\", \"besides\",\n        \"consequently\", \"therefore\", \"meanwhile\", \"next\", \"first\", \"second\",\n        \"finally\", \"previously\", \"afterward\", \"backwards\", \"forwards\", \"upwards\",\n        \"downwards\", \"inward\", \"outward\", \"sideways\", \"clockwise\", \"likewise\",\n        \"anywhere\", \"everywhere\", \"nowhere\", \"somewhere\", \"together\",\n        \"apart\", \"alone\"\n    ]\n    return suffixes, common_adverbs\n\ndef _normalize_word(word: str) -> str:\n    \"\"\"\n    Normalizes a word for case-insensitive and Unicode-aware comparison.\n    Converts the word to lowercase and applies NFKC Unicode normalization.\n    \"\"\"\n    return unicodedata.normalize('NFKC', word.lower())\n\ndef is_adverb(word: str) -> bool:\n    \"\"\"\n    Determines if a given word is an adverb based on suffix patterns or a predefined list.\n    Performs case-insensitive detection and handles Unicode normalization.\n    \"\"\"\n    normalized_word = _normalize_word(word)\n    suffixes, common_adverbs = _get_adverb_patterns()\n\n    for suffix in suffixes:\n        if normalized_word.endswith(suffix) and len(normalized_word) > len(suffix):\n            return True\n\n    if normalized_word in common_adverbs:\n        return True\n\n    return False\n\ndef _is_punctuation(char: str) -> bool:\n    \"\"\"\n    Checks if a character is a punctuation mark, supporting a broad range of Unicode punctuation.\n    Utilizes unicodedata categories to identify various punctuation types.\n    \"\"\"\n    return unicodedata.category(char).startswith('P')\n\ndef clean_punctuation(word: str) -> str:\n    \"\"\"\n    Removes leading and trailing punctuation from a word while preserving its core text.\n    This function efficiently processes words with Unicode punctuation marks.\n    \"\"\"\n    start_index = 0\n    while start_index < len(word) and _is_punctuation(word[start_index]):\n        start_index += 1\n\n    end_index = len(word)\n    while end_index > start_index and _is_punctuation(word[end_index - 1]):\n        end_index -= 1\n\n    return word[start_index:end_index]\n\ndef tokenize_with_positions(sentence: str) -> list[tuple[str, int, int]]:\n    \"\"\"\n    Splits a sentence into words, tracking their original start and end character positions.\n    Handles variable spacing and Unicode characters for accurate tokenization.\n    \"\"\"\n    tokens = []\n    current_word = []\n    current_word_start = -1\n\n    for i, char in enumerate(sentence):\n        if char.isspace():\n            if current_word:\n                word_text = \"\".join(current_word)\n                tokens.append((word_text, current_word_start, current_word_start + len(word_text)))\n                current_word = []\n                current_word_start = -1\n        else:\n            if not current_word:\n                current_word_start = i\n            current_word.append(char)\n\n    if current_word:\n        word_text = \"\".join(current_word)\n        tokens.append((word_text, current_word_start, current_word_start + len(word_text)))\n\n    return tokens\n\ndef calculate_word_positions(original_word_with_punctuation: str, original_start_index: int) -> tuple[int, int]:\n    \"\"\"\n    Calculates the accurate start and end character positions for the cleaned version of a word.\n    It identifies the portion of the word that remains after leading and trailing punctuation are removed.\n    \"\"\"\n    leading_punct_count = 0\n    for char in original_word_with_punctuation:\n        if _is_punctuation(char):\n            leading_punct_count += 1\n        else:\n            break\n\n    trailing_punct_count = 0\n    for char in reversed(original_word_with_punctuation):\n        if _is_punctuation(char):\n            trailing_punct_count += 1\n        else:\n            break\n            \n    # If the word is entirely punctuation, adjust trailing_punct_count\n    if leading_punct_count + trailing_punct_count > len(original_word_with_punctuation):\n        trailing_punct_count = len(original_word_with_punctuation) - leading_punct_count\n        if trailing_punct_count < 0: # Should not happen with correct logic, but for safety\n            trailing_punct_count = 0\n\n    cleaned_start_pos = original_start_index + leading_punct_count\n    cleaned_end_pos = original_start_index + len(original_word_with_punctuation) - trailing_punct_count\n\n    return (cleaned_start_pos, cleaned_end_pos)\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str]:\n    \"\"\"\n    Identifies the first adverb in a given sentence and returns its position information.\n    This function processes sentences with Unicode text, handles punctuation, and performs case-insensitive detection.\n    \"\"\"\n    word_tokens_with_pos = tokenize_with_positions(sentence)\n\n    for original_word_text, start_pos_in_sentence, _ in word_tokens_with_pos:\n        clean