{"task_id": "Mbpp/239", "solution": "```python\ndef _validate_inputs(m: int, n: int) -> bool:\n    \"\"\"Validates that m and n are positive integers.\n    This implementation assumes inputs are always valid as per critical requirements.\n    \"\"\"\n    return True\n\n\ndef _count_sequences_recursive(current_last_val: int, remaining_len: int, max_limit: int) -> int:\n    \"\"\"Recursively counts valid sequences starting after current_last_val with remaining_len elements.\n    It applies the doubling rule and upper bound constraint for each subsequent element.\n    \"\"\"\n    if remaining_len == 0:\n        return 1  # A valid sequence of the desired length has been formed.\n\n    count = 0\n    min_next_val = current_last_val * 2\n    for next_val in range(min_next_val, max_limit + 1):\n        count += _count_sequences_recursive(next_val, remaining_len - 1, max_limit)\n    return count\n\n\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"Calculates the total number of valid mathematical sequences based on specific constraints.\n    Each sequence element is a positive integer, greater than or equal to twice the previous element, and less than or equal to m.\n    \"\"\"\n    # Input validation, as per design, but simplified based on critical requirements to trust inputs.\n    if not _validate_inputs(m, n):\n        return 0  # This path should not be reached with valid positive integer inputs.\n\n    # If length is 1, any positive integer from 1 to m is a valid sequence.\n    if n == 1:\n        return m\n\n    total_sequences = 0\n    # Iterate through all possible starting values for the first element of the sequence.\n    for first_num in range(1, m + 1):\n        # Recursively count sequences of length (n-1) that follow 'first_num'.\n        total_sequences += _count_sequences_recursive(first_num, n - 1, m)\n\n    return total_sequences\n```"}
{"task_id": "Mbpp/239", "solution": "```python\n# src/validator.py\n\ndef validate_positive_integers(m: int, n: int) -> bool:\n    \"\"\"\n    Validates if m and n are positive integers.\n    Returns True if both are positive, False otherwise.\n    \"\"\"\n    return m > 0 and n > 0\n\n```\n```python\n# src/sequence_counter.py\n\nfrom .validator import validate_positive_integers\n\ndef count_sequences_dp(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the number of sequences using dynamic programming.\n    dp[i][j] stores the count of sequences of length i ending with j.\n    \"\"\"\n    dp = [[0] * (m + 1) for _ in range(n + 1)]\n\n    # Base case: sequences of length 1 can end with any number from 1 to m.\n    for j in range(1, m + 1):\n        dp[1][j] = 1\n\n    # Fill the DP table for lengths from 2 to n.\n    for i in range(2, n + 1):\n        # Use a prefix sum array for efficient calculation of sum(dp[i-1][k]).\n        prefix_sum = [0] * (m + 1)\n        for k in range(1, m + 1):\n            prefix_sum[k] = prefix_sum[k-1] + dp[i-1][k]\n\n        for j in range(1, m + 1):\n            # An element `j` can be preceded by any `k` such that 1 <= k <= j // 2.\n            max_prev_val = j // 2\n            if max_prev_val >= 1:\n                dp[i][j] = prefix_sum[max_prev_val]\n    \n    # The total count is the sum of all valid sequences of length n.\n    total_count = sum(dp[n])\n    return total_count\n\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the total number of valid sequences of length n.\n    Each element must be positive, >= twice the previous, and <= m.\n    \"\"\"\n    _ = validate_positive_integers(m, n) # As per design, call validation, trust inputs are positive.\n    return count_sequences_dp(m, n)\n\n```\n```python\n# src/main.py\n\nfrom sequence_counter import get_total_number_of_sequences\n\ndef main():\n    \"\"\"\n    Entry point for the application, demonstrating sequence calculation.\n    \"\"\"\n    m_val = 10\n    n_val = 4\n    result = get_total_number_of_sequences(m_val, n_val)\n    print(f\"For m={m_val}, n={n_val}, total sequences: {result}\")\n\n    m_val_2 = 5\n    n_val_2 = 2\n    result_2 = get_total_number_of_sequences(m_val_2, n_val_2)\n    print(f\"For m={m_val_2}, n={n_val_2}, total sequences: {result_2}\")\n\nif __name__ == \"__main__\":\n    main()\n\n```\n```python\n# src/test_sequence_counter.py\n\nfrom sequence_counter import get_total_number_of_sequences\nfrom validator import validate_positive_integers\n\ndef test_get_total_number_of_sequences():\n    \"\"\"\n    Tests the get_total_number_of_sequences function with specific cases.\n    Includes the required assertion from the problem statement.\n    \"\"\"\n    assert get_total_number_of_sequences(10, 4) == 4, f\"Expected 4, got {get_total_number_of_sequences(10, 4)}\"\n    assert get_total_number_of_sequences(5, 2) == 6\n    assert get_total_number_of_sequences(1, 1) == 1\n    assert get_total_number_of_sequences(10, 1) == 10\n    assert get_total_number_of_sequences(1, 2) == 0\n    assert get_total_number_of_sequences(2, 2) == 1\n    print(\"All sequence calculation tests passed!\")\n\ndef test_validate_positive_integers():\n    \"\"\"\n    Tests the input validation utility for positive integers.\n    \"\"\"\n    assert validate_positive_integers(1, 1) == True\n    assert validate_positive_integers(10, 4) == True\n    assert validate_positive_integers(0, 1) == False\n    assert validate_positive_integers(1, 0) == False\n    assert validate_positive_integers(-1, 1) == False\n    assert validate_positive_integers(1, -1) == False\n    print(\"All validation tests passed!\")\n\nif __name__ == \"__main__\":\n    test_get_total_number_of_sequences()\n    test_validate_positive_integers()\n\n```"}
