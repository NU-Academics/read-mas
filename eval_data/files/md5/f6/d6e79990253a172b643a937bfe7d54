{"task_id": "Mbpp/777", "solution": "```python\nfrom typing import List, Dict\n\ndef _count_elements(input_list: List[int]) -> Dict[int, int]:\n    \"\"\"Count occurrences of each element in the list.\n    It returns a dictionary mapping elements to their counts.\"\"\"\n    counts = {}\n    for item in input_list:\n        counts[item] = counts.get(item, 0) + 1\n    return counts\n\ndef _get_unique_elements(counts: Dict[int, int]) -> List[int]:\n    \"\"\"Get elements that appear exactly once.\n    It filters the dictionary to find items with a count of 1.\"\"\"\n    unique_elements = []\n    for element, count in counts.items():\n        if count == 1:\n            unique_elements.append(element)\n    return unique_elements\n\ndef _calculate_sum(elements: List[int]) -> int:\n    \"\"\"Calculate sum of given elements.\n    It sums all integers in the provided list.\"\"\"\n    return sum(elements)\n\ndef find_sum(input_list: List[int]) -> int:\n    \"\"\"\n    Find the sum of non-repeated elements in a given list.\n    It orchestrates counting, filtering unique elements, and summing them.\n    \"\"\"\n    counts = _count_elements(input_list)\n    unique_elements = _get_unique_elements(counts)\n    total_sum = _calculate_sum(unique_elements)\n    return total_sum\n```"}
{"task_id": "Mbpp/777", "solution": "```python\ndef find_sum(input_list: list) -> int:\n    \"\"\"\n    Calculate sum of non-repeated elements in the input list.\n    This interprets \"non-repeated\" as \"distinct values\" based on the provided test case.\n    \"\"\"\n    distinct_elements = set(input_list)\n    return sum(distinct_elements)\n```"}
{"task_id": "Mbpp/778", "solution": "```python\nfrom typing import List\n\ndef pack_consecutive_duplicates(input_list: List) -> List[List]:\n    \"\"\"\n    Pack consecutive duplicates of list elements into sublists.\n    Groups identical elements that appear consecutively.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = []\n    current_sublist = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == input_list[i-1]:\n            current_sublist.append(input_list[i])\n        else:\n            result.append(current_sublist)\n            current_sublist = [input_list[i]]\n\n    # Append the last sublist\n    result.append(current_sublist)\n    return result\n```"}
{"task_id": "Mbpp/780", "solution": "import itertools\n\ndef _validate_input(tuple_list: list) -> bool:\n    \"\"\"Checks if the input list of tuples meets basic criteria.\n    Assumes valid input per critical requirements.\"\"\"\n    return True\n\ndef _generate_pairs(tuple_list: list) -> itertools.combinations:\n    \"\"\"Generates all unique pairwise combinations from the input list.\n    Uses itertools.combinations to ensure uniqueness and exclude self-pairing.\"\"\"\n    return itertools.combinations(tuple_list, 2)\n\ndef _compute_sum(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Computes the element-wise sum of two input tuples.\n    Assumes tuples have compatible numeric elements and equal length.\"\"\"\n    return tuple(a + b for a, b in zip(tuple1, tuple2))\n\ndef find_combinations(tuple_list: list) -> list:\n    \"\"\"Main entry point to find all pairwise combinations of tuples and their element-wise sums.\n    It orchestrates input validation, pair generation, and sum computation.\"\"\"\n    \n    _validate_input(tuple_list) # Validate input, though it's a no-op due to critical requirements\n    \n    pairs = _generate_pairs(tuple_list)\n    \n    result_sums = []\n    for pair_tuple1, pair_tuple2 in pairs:\n        sum_tuple = _compute_sum(pair_tuple1, pair_tuple2)\n        result_sums.append(sum_tuple)\n        \n    return result_sums"}
{"task_id": "Mbpp/780", "solution": "```python\ndef validate_input(tuple_list: list) -> bool:\n    \"\"\"\n    Validates the input list of tuples.\n    Returns True, assuming valid input as per requirements to trust caller's inputs.\n    \"\"\"\n    # Per critical requirements, type checks and error raising are forbidden.\n    return True\n\ndef generate_pairs(tuple_list: list) -> list:\n    \"\"\"\n    Generates all unique pairwise combinations of tuples from the input list.\n    Excludes self-combinations and duplicate pairs.\n    \"\"\"\n    pairs = []\n    n = len(tuple_list)\n    for i in range(n):\n        for j in range(i + 1, n):\n            pairs.append((tuple_list[i], tuple_list[j]))\n    return pairs\n\ndef calculate_sum(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Calculates the element-wise sum of two tuples.\n    Returns a new tuple with the sums.\n    \"\"\"\n    return tuple(x + y for x, y in zip(tuple1, tuple2))\n\ndef find_combinations(tuple_list: list) -> list:\n    \"\"\"\n    Finds all pairwise sum combinations of tuples in a given list.\n    Orchestrates validation, pair generation, and sum calculation.\n    \"\"\"\n    # According to critical requirements, validate_input will always return True.\n    # The structural call is maintained as per the design specification.\n    if not validate_input(tuple_list):\n        return []\n\n    tuple_pairs = generate_pairs(tuple_list)\n    result_sums = []\n    for t1, t2 in tuple_pairs:\n        result_sums.append(calculate_sum(t1, t2))\n\n    return result_sums\n```"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list):\n    \"\"\"\n    Groups consecutive duplicate elements from the input list into sublists.\n    Processes the list through linear iteration, maintaining state for current sublist construction.\n    \"\"\"\n    result = []\n    current_sublist = []\n\n    for element in input_list:\n        if not current_sublist or element != current_sublist[-1]:\n            if current_sublist:\n                result.append(current_sublist)\n            current_sublist = [element]\n        else:\n            current_sublist.append(element)\n\n    if current_sublist:\n        result.append(current_sublist)\n\n    return result"}
{"task_id": "Mbpp/781", "solution": "import math\n\ndef count_divisors(number: int) -> bool:\n    \"\"\"Checks if the count of positive divisors for a number is even.\n    Counts all positive divisors including 1 and the number itself.\n    \"\"\"\n    divisor_count = 0\n    limit = int(math.sqrt(number))\n    for i in range(1, limit + 1):\n        if number % i == 0:\n            if i * i == number:\n                divisor_count += 1\n            else:\n                divisor_count += 2\n    \n    return divisor_count % 2 == 0"}
{"task_id": "Mbpp/781", "solution": "```python\ndef count_divisors(number: int) -> bool:\n    \"\"\"\n    Calculates the total number of divisors for a given integer and checks if the count is even.\n    Returns True if the count of divisors is even, False otherwise.\n    \"\"\"\n    divisor_count = 0\n    for i in range(1, number + 1):\n        if number % i == 0:\n            divisor_count += 1\n    \n    return divisor_count % 2 == 0\n```"}
{"task_id": "Mbpp/782", "solution": "```python\nfrom typing import List\n\ndef odd_length_sum(array: List[int]) -> int:\n    \"\"\"\n    Calculates the total sum of all odd-length subarrays from the input array.\n    It iterates through all possible subarrays, filters for odd lengths, and sums their elements.\n    \"\"\"\n    total_sum = 0\n    n = len(array)\n\n    # Iterate through all possible starting indices 'i'\n    for i in range(n):\n        # Iterate through all possible ending indices 'j' for subarrays starting at 'i'\n        for j in range(i, n):\n            # Extract the current subarray\n            current_subarray = array[i : j + 1]\n            \n            # Check if the length of the current subarray is odd\n            if len(current_subarray) % 2 != 0:\n                # Add the sum of elements in this odd-length subarray to the total sum\n                total_sum += sum(current_subarray)\n                \n    return total_sum\n```"}
{"task_id": "Mbpp/782", "solution": "from typing import List\n\ndef odd_length_sum(input_list: List[int]) -> int:\n    \"\"\"\n    Calculate the sum of all odd-length subarrays.\n    It iterates through all possible subarrays, sums elements of odd-length ones.\n    \"\"\"\n    total_sum = 0\n    n = len(input_list)\n\n    for i in range(n):\n        for j in range(i, n):\n            # current_subarray = input_list[i : j+1]\n            # length = len(current_subarray)\n            length = j - i + 1\n            if length % 2 != 0:  # Check if the length is odd\n                # Sum the elements of the current odd-length subarray\n                for k in range(i, j + 1):\n                    total_sum += input_list[k]\n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "def find_first_even(numbers: list) -> int:\n    \"\"\"Identifies the first even number in a list of integers.\"\"\"\n    for num in numbers:\n        if num % 2 == 0:\n            return num\n\ndef find_first_odd(numbers: list) -> int:\n    \"\"\"Identifies the first odd number in a list of integers.\"\"\"\n    for num in numbers:\n        if num % 2 != 0:\n            return num\n\ndef multiply(a: int, b: int) -> int:\n    \"\"\"Calculates the product of two integers.\"\"\"\n    return a * b\n\ndef mul_even_odd(numbers: list) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd numbers in a list.\n    Orchestrates the identification and multiplication process.\n    \"\"\"\n    first_even = find_first_even(numbers)\n    first_odd = find_first_odd(numbers)\n    return multiply(first_even, first_odd)"}
{"task_id": "Mbpp/785", "solution": "import ast\n\ndef _parse_tuple_string(input_str: str) -> list:\n    \"\"\"Parses a tuple string into a list of its elements using safe evaluation.\n    This function leverages ast.literal_eval to securely interpret the string.\"\"\"\n    # ast.literal_eval directly converts string representations of Python literals.\n    # For \"(7, 8, 9)\", it returns the tuple (7, 8, 9).\n    # We then convert this tuple to a list as required by the design's return type.\n    return list(ast.literal_eval(input_str))\n\ndef _convert_elements_to_int(elements: list) -> list:\n    \"\"\"Converts a list of elements, assumed to be integers or integer-like, to a list of integers.\n    Each element is cast directly to an integer type.\"\"\"\n    # As per critical requirements, we trust the input and directly cast each element.\n    return [int(e) for e in elements]\n\ndef tuple_str_int(string_input: str) -> tuple:\n    \"\"\"Converts a string representation of a tuple into an actual Python tuple of integers.\n    It orchestrates the parsing of the string and the conversion of its elements.\"\"\"\n    # The _parse_tuple_string function, using ast.literal_eval, will return a list of integers.\n    # _convert_elements_to_int will then process this list, effectively re-casting integers to integers.\n    parsed_elements = _parse_tuple_string(string_input)\n    converted_integers = _convert_elements_to_int(parsed_elements)\n    return tuple(converted_integers)"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(input_string: str) -> tuple:\n    \"\"\"Converts a string representation of a tuple into an actual integer tuple.\n    Processes the input by stripping parentheses, splitting elements, and converting each to an integer.\n    \"\"\"\n    # Remove leading and trailing parentheses.\n    content = input_string[1:-1]\n\n    # Handle empty tuple case specifically, as split(',') would return ['']\n    if not content.strip():\n        return ()\n\n    # Split the content by comma to get individual string elements.\n    string_elements = content.split(',')\n\n    # Strip whitespace from each element and convert it to an integer.\n    integer_elements = [int(element.strip()) for element in string_elements]\n\n    # Convert the list of integers into a tuple and return.\n    return tuple(integer_elements)"}
{"task_id": "Mbpp/784", "solution": "from typing import List, Any, Optional\n\n# --- src/validators.py ---\nclass InputValidator:\n    \"\"\"\n    Validates input list format and contents.\n    Actual validation checks are omitted due to critical constraints.\n    \"\"\"\n    def is_valid_list(self, input_data: Any) -> bool:\n        \"\"\"\n        Determines if the input data is a valid list.\n        Returns True without performing actual checks.\n        \"\"\"\n        return True\n\n    def validate_input(self, numbers: List[int]) -> bool:\n        \"\"\"\n        Validates all elements in the list are integers.\n        Returns True without performing actual checks.\n        \"\"\"\n        return True\n\n# --- src/number_processor.py ---\nclass NumberProcessor:\n    \"\"\"\n    Processes a list to find first even and odd numbers and calculates their product.\n    Methods support O(n) sequential processing.\n    \"\"\"\n    def find_first_even(self, numbers: List[int]) -> Optional[int]:\n        \"\"\"\n        Identifies and returns the first even number from a list.\n        Returns None if no even number is found after iteration.\n        \"\"\"\n        for num in numbers:\n            if num % 2 == 0:\n                return num\n        return None\n\n    def find_first_odd(self, numbers: List[int]) -> Optional[int]:\n        \"\"\"\n        Identifies and returns the first odd number from a list.\n        Returns None if no odd number is found after iteration.\n        \"\"\"\n        for num in numbers:\n            if num % 2 != 0:\n                return num\n        return None\n\n    def calculate_product(self, even: int, odd: int) -> int:\n        \"\"\"\n        Computes the product of two given integers.\n        This method assumes valid integer inputs.\n        \"\"\"\n        return even * odd\n\n# --- src/main.py ---\ndef mul_even_odd(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and odd numbers in a list.\n    Returns 0 if either number is not found.\n    \"\"\"\n    validator = InputValidator()\n    processor = NumberProcessor()\n\n    # Conceptual input validation based on design, actual checks skipped per critical requirement.\n    validator.is_valid_list(numbers)\n    validator.validate_input(numbers)\n\n    first_even = processor.find_first_even(numbers)\n    first_odd = processor.find_first_odd(numbers)\n\n    if first_even is not None and first_odd is not None:\n        return processor.calculate_product(first_even, first_odd)\n    else:\n        # If either even or odd number is missing, the product is 0.\n        return 0"}
