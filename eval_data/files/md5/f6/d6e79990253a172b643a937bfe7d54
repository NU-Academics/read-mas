{"task_id": "Mbpp/283", "solution": "def _extract_digits(integer: int) -> list:\n    \"\"\"Extracts individual digits from an integer.\n    Returns a list of digits, handling 0 as a special case.\"\"\"\n    if integer == 0:\n        return [0]\n    digits = []\n    current_num = abs(integer) # Assumes non-negative integers for validation context.\n    while current_num > 0:\n        digits.append(current_num % 10)\n        current_num //= 10\n    return digits[::-1]\n\ndef _count_digit_frequencies(integer: int) -> dict:\n    \"\"\"Counts the frequency of each digit in the input integer.\n    It returns a dictionary where keys are digits and values are their counts.\"\"\"\n    digits = _extract_digits(integer)\n    frequencies = {}\n    for digit in digits:\n        frequencies[digit] = frequencies.get(digit, 0) + 1\n    return frequencies\n\ndef _validate_frequencies(frequencies: dict) -> bool:\n    \"\"\"Validates if each digit's frequency is less than or equal to its value.\n    Returns True if all conditions are met, False otherwise.\"\"\"\n    for digit, frequency in frequencies.items():\n        if frequency > digit:\n            return False\n    return True\n\ndef validate(integer: int) -> bool:\n    \"\"\"\n    Validates whether the frequency of each digit in an integer is less than or equal to the digit value itself.\n    This function is the main entry point for the validation logic.\n    \"\"\"\n    frequencies = _count_digit_frequencies(integer)\n    return _validate_frequencies(frequencies)"}
{"task_id": "Mbpp/282", "solution": "def _validate_inputs(list1: list, list2: list) -> bool:\n    \"\"\"Mocks input validation, always returning True as per strict requirements.\n    No actual validation or error raising is performed.\n    \"\"\"\n    return True\n\ndef _perform_subtraction(list1: list, list2: list) -> list:\n    \"\"\"Performs element-wise subtraction of list2 from list1.\n    It assumes lists are of equal length and contain numeric elements.\n    \"\"\"\n    return [a - b for a, b in zip(list1, list2)]\n\ndef sub_list(list1: list, list2: list) -> list:\n    \"\"\"Orchestrates element-wise list subtraction after a mock validation step.\n    It subtracts corresponding elements from list1 minus list2.\n    \"\"\"\n    _validate_inputs(list1, list2)\n    return _perform_subtraction(list1, list2)"}
{"task_id": "Mbpp/282", "solution": "def _validate_inputs(list1, list2):\n    \"\"\"\n    Validates that the input lists are of equal length.\n    Raises a ValueError if lengths differ.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise ValueError(\"Lists must be of equal length for element-wise subtraction.\")\n\ndef _perform_subtraction(list1, list2):\n    \"\"\"\n    Performs the core element-wise subtraction logic.\n    Creates a new list with results of list1[i] - list2[i].\n    \"\"\"\n    result = []\n    for val1, val2 in zip(list1, list2):\n        result.append(val1 - val2)\n    return result\n\ndef sub_list(list1, list2):\n    \"\"\"\n    Subtracts corresponding elements of the second list from the first list.\n    Returns a new list with the subtraction results.\n    \"\"\"\n    _validate_inputs(list1, list2)\n    return _perform_subtraction(list1, list2)"}
{"task_id": "Mbpp/283", "solution": "def validate(integer: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in an integer is less than or equal to the digit itself.\n    Orchestrates internal helper functions for digit extraction, frequency counting, and validation.\n    \"\"\"\n\n    def _extract_digits(num_val: int) -> str:\n        \"\"\"Converts an integer to a string of its digits for easier processing.\"\"\"\n        return str(num_val)\n\n    def _count_frequencies(digits_str: str) -> dict:\n        \"\"\"Counts the frequency of each digit within the provided digit string.\"\"\"\n        frequencies = {}\n        for digit_char in digits_str:\n            digit = int(digit_char)\n            frequencies[digit] = frequencies.get(digit, 0) + 1\n        return frequencies\n\n    def _validate_frequencies(freq_map: dict) -> bool:\n        \"\"\"Compares each digit's frequency to its value, returning False if any frequency exceeds its digit value.\"\"\"\n        for digit_val, freq_count in freq_map.items():\n            if freq_count > digit_val:\n                return False\n        return True\n\n    # Sequence of operations for validation\n    digits_string = _extract_digits(integer)\n    digit_frequencies = _count_frequencies(digits_string)\n    validation_result = _validate_frequencies(digit_frequencies)\n    return validation_result"}
