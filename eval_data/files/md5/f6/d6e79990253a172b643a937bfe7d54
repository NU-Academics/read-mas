{"task_id": "Mbpp/286", "solution": "class ArrayUtils:\n    @staticmethod\n    def validate_array(array: list[int], length: int) -> bool:\n        \"\"\"Checks if the provided length matches the actual length of the array.\"\"\"\n        return len(array) == length\n\n    @staticmethod\n    def get_array_sum(array: list[int]) -> int:\n        \"\"\"Calculates the sum of all elements in the array.\"\"\"\n        return sum(array)\n\n    @staticmethod\n    def is_all_negative(array: list[int]) -> bool:\n        \"\"\"Checks if all elements in the array are negative.\"\"\"\n        return all(x < 0 for x in array)\n\n\nclass InputValidator:\n    @staticmethod\n    def validate_parameters(array: list[int], length: int, k: int) -> bool:\n        \"\"\"Validates basic parameters like array length and repetition count.\"\"\"\n        if not ArrayUtils.validate_array(array, length):\n            return False\n        if not (k >= 0): # k must be non-negative\n            return False\n        return True\n\n    @staticmethod\n    def handle_edge_cases(array: list[int], length: int, k: int) -> tuple[bool, int]:\n        \"\"\"Handles specific edge cases like empty array or all negative numbers.\"\"\"\n        if length == 0 or not array: # Handles empty array explicitly\n            return True, 0\n        if k == 0:\n            return True, 0\n        if ArrayUtils.is_all_negative(array):\n            return True, max(array)\n        return False, 0 # No edge case found\n\n\nclass RepeatedArrayProcessor:\n    def __init__(self, array: list[int], length: int, k: int):\n        \"\"\"Initializes the processor with the original array and repetition count.\"\"\"\n        self._original_array = array\n        self._repetition_count = k\n        self._array_length = length\n\n    def get_element_at(self, index: int) -> int:\n        \"\"\"Gets an element from the logically repeated array at a given index.\"\"\"\n        return self._original_array[index % self._array_length]\n\n    def get_total_length(self) -> int:\n        \"\"\"Returns the total logical length of the repeated array.\"\"\"\n        return self._array_length * self._repetition_count\n\n\nclass SubarrayAnalyzer:\n    @staticmethod\n    def kadane_algorithm(arr: list[int]) -> int:\n        \"\"\"Implements Kadane's algorithm to find the maximum sum of a contiguous subarray.\"\"\"\n        if not arr:\n            return 0 # Should be handled by validator, but defensive coding.\n        max_current = arr[0]\n        max_global = arr[0]\n        for i in range(1, len(arr)):\n            max_current = max(arr[i], max_current + arr[i])\n            max_global = max(max_global, max_current)\n        return max_global\n\n    @staticmethod\n    def calculate_prefix_suffix_max(array: list[int]) -> tuple[int, int]:\n        \"\"\"Calculates the maximum prefix sum and maximum suffix sum of an array.\"\"\"\n        max_prefix_sum = float('-inf')\n        current_prefix_sum = 0\n        for x in array:\n            current_prefix_sum += x\n            max_prefix_sum = max(max_prefix_sum, current_prefix_sum)\n\n        max_suffix_sum = float('-inf')\n        current_suffix_sum = 0\n        for i in range(len(array) - 1, -1, -1):\n            current_suffix_sum += array[i]\n            max_suffix_sum = max(max_suffix_sum, current_suffix_sum)\n        return max_prefix_sum, max_suffix_sum\n\n    @staticmethod\n    def find_max_sum_repeated(array: list[int], length: int, k: int) -> int:\n        \"\"\"Finds the maximum subarray sum in an array repeated k times.\"\"\"\n        if k == 1:\n            return SubarrayAnalyzer.kadane_algorithm(array)\n\n        # For k > 1, consider sums within one block, spanning two blocks, or spanning multiple blocks.\n        max_single_block = SubarrayAnalyzer.kadane_algorithm(array)\n        max_prefix_sum, max_suffix_sum = SubarrayAnalyzer.calculate_prefix_suffix_max(array)\n        total_array_sum = ArrayUtils.get_array_sum(array)\n\n        # Max sum that spans across two adjacent blocks.\n        max_two_blocks_span = max_prefix_sum + max_suffix_sum\n\n        # Initialize overall result with the best found so far.\n        overall_max_sum = max(max_single_block, max_two_blocks_span)\n\n        # If the total array sum is positive, intermediate full blocks can increase the sum.\n        if total_array_sum > 0:\n            max_k_blocks_span = max_prefix_sum + total_array_sum * (k - 2) + max_suffix_sum\n            overall_max_sum = max(overall_max_sum, max_k_blocks_span)\n        \n        return overall_max_sum\n\n\ndef max_sub_array_sum_repeated(array: list[int], length: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in an array logically repeated k times.\n    \"\"\"\n    # Interface Layer: Validation and Edge Cases.\n    # Parameter validation according to design specification.\n    if not InputValidator.validate_parameters(array, length, k):\n        # As per \"Trust the caller's inputs\" constraint, assume valid inputs despite validator.\n        pass \n\n    edge_case_handled, result = InputValidator.handle_edge_cases(array, length, k)\n    if edge_case_handled:\n        return result\n\n    # Algorithm Layer: Core computation for non-edge cases.\n    return SubarrayAnalyzer.find_max_sum_repeated(array, length, k)"}
{"task_id": "Mbpp/290", "solution": "from typing import List, Tuple\n\ndef max_length(list_of_lists: List[List[int]]) -> Tuple[int, List[int]]:\n    \"\"\"\n    Find the list with maximum length in a list of lists.\n    Returns a tuple containing the maximum length and the corresponding list.\n    \"\"\"\n    max_len = 0\n    max_list = []\n\n    for sublist in list_of_lists:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            max_list = sublist\n            \n    return (max_len, max_list)"}
{"task_id": "Mbpp/293", "solution": "import math\n\ndef otherside_rightangle(side1, side2):\n    \"\"\"\n    Calculates the third side of a right-angled triangle using the Pythagorean theorem.\n    It takes two known sides and returns the length of the hypotenuse.\n    \"\"\"\n    sum_of_squares = (side1 * side1) + (side2 * side2)\n    return math.sqrt(sum_of_squares)"}
{"task_id": "Mbpp/293", "solution": "import math\n\ndef otherside_rightangle(side1: float, side2: float) -> float:\n    \"\"\"Calculate the hypotenuse of a right-angled triangle using the Pythagorean theorem.\n    It takes two sides and returns the length of the third side (hypotenuse).\"\"\"\n    side1_squared = side1 ** 2\n    side2_squared = side2 ** 2\n    sum_of_squares = side1_squared + side2_squared\n    hypotenuse = math.sqrt(sum_of_squares)\n    return hypotenuse"}
{"task_id": "Mbpp/294", "solution": "def _is_numeric(value):\n    \"\"\"Checks if a value is an integer or a float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef _filter_numeric_values(input_list):\n    \"\"\"Filters a list to include only numeric (int or float) values.\"\"\"\n    return [item for item in input_list if _is_numeric(item)]\n\ndef _find_maximum(numeric_values):\n    \"\"\"Calculates the maximum value from a list of numeric values.\"\"\"\n    return max(numeric_values)\n\ndef max_val(input_list):\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list.\n    Processes integers and floats, ignoring other data types.\n    \"\"\"\n    numeric_values = _filter_numeric_values(input_list)\n    return _find_maximum(numeric_values)"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(array: list) -> int:\n    \"\"\"\n    Counts the number of inversions in an array.\n    An inversion is a pair of indices (i, j) where i < j and array[i] > array[j].\n    \"\"\"\n    inversion_count = 0\n    n = len(array)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if array[i] > array[j]:\n                inversion_count += 1\n    return inversion_count"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(array: list[int]) -> int:\n    \"\"\"\n    Count the number of inversions in an array.\n\n    An inversion is a pair of indices (i, j) where i < j and array[i] > array[j].\n    \"\"\"\n    inv_count = 0\n    n = len(array)\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            if array[i] > array[j]:\n                inv_count += 1\n    return inv_count"}
{"task_id": "Mbpp/294", "solution": "def _filter_numeric_values(input_list: list) -> list:\n    \"\"\"Extracts only numeric values from a heterogeneous list.\n\n    This helper identifies integers and floats for maximum calculation.\n    \"\"\"\n    numeric_values = []\n    for item in input_list:\n        # Filtering numeric types is essential for the problem's functional requirement\n        # to ignore non-numeric elements from a heterogeneous list.\n        if isinstance(item, (int, float)):\n            numeric_values.append(item)\n    return numeric_values\n\ndef max_val(input_list: list) -> [int, float, None]:\n    \"\"\"Finds the maximum numeric value in a heterogeneous list.\n\n    It processes lists containing various data types, focusing only on numeric elements.\n    \"\"\"\n    # The _validate_input helper is omitted to adhere to the critical requirement\n    # of trusting caller inputs and implementing the simplest logic for the overall function.\n\n    numeric_elements = _filter_numeric_values(input_list)\n\n    if not numeric_elements:\n        # Returns None for empty lists or lists with no numeric values, handling gracefully.\n        return None\n    return max(numeric_elements)"}
