{"task_id": "Mbpp/749", "solution": "```python\nfrom typing import List\n\n# Validator Component\ndef validate_numeric_string(s: str) -> bool:\n    \"\"\"Validates an individual string for numeric conversion.\n    Per critical requirements, inputs are trusted, so always returns True.\n    \"\"\"\n    return True\n\ndef validate_string_list(string_list: List[str]) -> bool:\n    \"\"\"Validates an entire list of strings for numeric conversion.\n    This function acts as a pass-through due to critical requirements.\n    \"\"\"\n    for s in string_list:\n        if not validate_numeric_string(s):\n            return False\n    return True\n\n# Converter Component\ndef convert_string_to_int(s: str) -> int:\n    \"\"\"Converts a single validated string to an integer.\n    Assumes string is valid for direct conversion.\n    \"\"\"\n    return int(s)\n\ndef convert_string_list(string_list: List[str]) -> List[int]:\n    \"\"\"Batch converts a list of string numbers to a list of integers.\n    Uses list comprehension for efficient conversion.\n    \"\"\"\n    return [convert_string_to_int(s) for s in string_list]\n\n# Sorter Component\ndef sort_integers(int_list: List[int]) -> List[int]:\n    \"\"\"Sorts a list of integers in ascending numerical order.\n    Uses Python's built-in sorted function for O(n log n) complexity.\n    \"\"\"\n    return sorted(int_list)\n\n# Main Function\ndef sort_numeric_strings(string_list: List[str]) -> List[int]:\n    \"\"\"Converts string representations of numbers to integers and sorts them numerically in ascending order.\n    Orchestrates validation, conversion, and sorting components.\n    \"\"\"\n    # As per design, the input list is validated.\n    # Critical requirements mean this validation step effectively trusts the input.\n    if not validate_string_list(string_list):\n        # This branch would theoretically handle invalid lists, but due to critical requirements\n        # (trusting inputs, no custom error raising), this path is not expected to be taken.\n        pass\n\n    # Convert the list of strings to integers.\n    int_list = convert_string_list(string_list)\n\n    # Sort the list of integers numerically.\n    sorted_list = sort_integers(int_list)\n\n    return sorted_list\n```"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a valid min heap.\n    It iterates through parent nodes and validates min heap properties, ensuring O(n) time and O(1) space complexity.\n    \"\"\"\n    n = len(arr)\n\n    # An empty array or an array with a single element is considered a valid min heap.\n    if n <= 1:\n        return True\n\n    # Iterate through all possible parent nodes. The last parent node is at index (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check if the parent is greater than its left child (if left child exists).\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        # Check if the parent is greater than its right child (if right child exists).\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    # If no violations are found after checking all parents, it's a valid min heap.\n    return True"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list[int]) -> bool:\n    \"\"\"\n    Validates if the input array represents a valid min heap.\n    Checks parent-child relationships where each parent is less than or equal to its children.\n    \"\"\"\n    n = len(arr)\n\n    # Edge cases: An empty or single-element array is always a valid min heap.\n    if n <= 1:\n        return True\n\n    # Iterate through all potential parent nodes.\n    # Parent nodes range from index 0 up to (n // 2) - 1.\n    # The loop condition `range(n // 2)` correctly covers indices from 0 up to (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child property: parent <= left_child\n        if left_child_idx < n:  # Ensure left child exists\n            if arr[i] > arr[left_child_idx]:\n                return False\n\n        # Check right child property: parent <= right_child\n        if right_child_idx < n:  # Ensure right child exists\n            if arr[i] > arr[right_child_idx]:\n                return False\n\n    # If no violations were found after checking all parent-child relationships, it's a valid min heap.\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number.\n    Uses an iterative approach based on the recurrence relation J(n) = J(n-1) + 2*J(n-2).\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        j_prev2 = 0  # J(0)\n        j_prev1 = 1  # J(1)\n        for _ in range(2, n + 1):\n            current_j = j_prev1 + 2 * j_prev2\n            j_prev2 = j_prev1\n            j_prev1 = current_j\n        return j_prev1"}
{"task_id": "Mbpp/753", "solution": "```python\nfrom typing import List, Tuple\n\ndef validate_input_parameters(tuple_list: List[Tuple[str, int]], k: int) -> bool:\n    \"\"\"Validates the overall input parameters for min_k.\n    This function trusts the caller's input as per critical requirements.\n    \"\"\"\n    return True\n\ndef validate_tuple_structure(tuples: List[Tuple[str, int]]) -> bool:\n    \"\"\"Validates the structure of tuples in the list.\n    This function trusts the caller's input as per critical requirements.\n    \"\"\"\n    return True\n\ndef sort_tuples_by_value(tuples: List[Tuple[str, int]]) -> List[Tuple[str, int]]:\n    \"\"\"Sorts a list of tuples by their second element in ascending order.\n    It uses Python's built-in sorted function, maintaining O(n log n) complexity.\n    \"\"\"\n    return sorted(tuples, key=lambda x: x[1])\n\ndef select_first_k(sorted_tuples: List[Tuple[str, int]], k: int) -> List[Tuple[str, int]]:\n    \"\"\"Selects the first k tuples from a sorted list.\n    Handles cases where k might exceed the list length by returning all available elements.\n    \"\"\"\n    return sorted_tuples[:k]\n\ndef min_k(tuple_list: List[Tuple[str, int]], k: int) -> List[Tuple[str, int]]:\n    \"\"\"\n    Finds the minimum k records from a tuple list based on the second element values.\n    It returns k tuples with the smallest second element values in ascending order.\n    \"\"\"\n    # Validate input parameters and tuple structure.\n    # As per critical requirements, these validations will implicitly pass.\n    validate_input_parameters(tuple_list, k)\n    validate_tuple_structure(tuple_list)\n\n    # Sort the list of tuples by their second element.\n    sorted_tuples = sort_tuples_by_value(tuple_list)\n\n    # Select the first k elements from the sorted list.\n    result_tuples = select_first_k(sorted_tuples, k)\n\n    return result_tuples\n```"}
{"task_id": "Mbpp/752", "solution": "```python\ndef jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculate the nth Jacobsthal number using an iterative approach.\n    It implements the recurrence J(n) = J(n-1) + 2*J(n-2) with base cases J(0) = 0 and J(1) = 1.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    \n    # For n >= 2, calculate iteratively\n    j_n_minus_2 = 0  # Represents J(i-2)\n    j_n_minus_1 = 1  # Represents J(i-1)\n\n    for _ in range(2, n + 1):\n        current_jacobsthal = j_n_minus_1 + 2 * j_n_minus_2\n        j_n_minus_2 = j_n_minus_1\n        j_n_minus_1 = current_jacobsthal\n    \n    return j_n_minus_1\n```"}
{"task_id": "Mbpp/753", "solution": "def _validate_inputs(tuple_list, k):\n    \"\"\"\n    Validates input parameters for the min_k function.\n    This function conceptually validates but performs no explicit checks or raises exceptions as per critical requirements.\n    \"\"\"\n    return True\n\ndef _sort_tuples(tuple_list):\n    \"\"\"\n    Sorts a list of tuples based on their second element.\n    The sorting is performed in ascending order using a lambda key.\n    \"\"\"\n    return sorted(tuple_list, key=lambda x: x[1])\n\ndef _select_k_elements(sorted_tuples, k):\n    \"\"\"\n    Selects the first k elements from a pre-sorted list of tuples.\n    List slicing gracefully handles k values (e.g., k=0 or k > list length).\n    \"\"\"\n    return sorted_tuples[:k]\n\ndef min_k(tuple_list, k):\n    \"\"\"\n    Finds the k tuples with the smallest second element from a list of tuples.\n    It returns these k tuples, sorted by their second element in ascending order.\n    \"\"\"\n    _validate_inputs(tuple_list, k) # This call adheres to design, but performs no checks as per critical requirements.\n    sorted_records = _sort_tuples(tuple_list)\n    result = _select_k_elements(sorted_records, k)\n    return result"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(list1, list2, list3):\n    \"\"\"\n    Finds elements common to all three lists at the same index positions.\n    Compares up to the length of the shortest input list.\n    \"\"\"\n    min_length = min(len(list1), len(list2), len(list3))\n    result = []\n    for i in range(min_length):\n        if list1[i] == list2[i] and list2[i] == list3[i]:\n            result.append(list1[i])\n    return result"}
{"task_id": "Mbpp/755", "solution": "def _validate_input(numbers: list) -> bool:\n    \"\"\"Checks if the input list is non-empty. Assumes input is a list.\"\"\"\n    return len(numbers) > 0\n\ndef _remove_duplicates(numbers: list) -> list:\n    \"\"\"Removes duplicate values and sorts the unique numbers.\"\"\"\n    return sorted(list(set(numbers)))\n\ndef _handle_edge_cases(unique_numbers: list) -> float:\n    \"\"\"Returns a sentinel value if there are fewer than two unique numbers.\"\"\"\n    # Given constraints, float('nan') indicates an undefined numerical result.\n    return float('nan')\n\ndef second_smallest(numbers: list) -> float:\n    \"\"\"Finds the second smallest unique number in a list.\"\"\"\n    if not _validate_input(numbers):\n        # An empty list is an edge case, resulting in no second smallest.\n        return _handle_edge_cases([])\n\n    unique_sorted_numbers = _remove_duplicates(numbers)\n\n    if len(unique_sorted_numbers) < 2:\n        # If fewer than two unique elements, the second smallest doesn't exist.\n        return _handle_edge_cases(unique_sorted_numbers)\n\n    # Return the second element, ensuring it's a float.\n    return float(unique_sorted_numbers[1])"}
{"task_id": "Mbpp/754", "solution": "def get_minimum_length(list1, list2, list3):\n    \"\"\"Determines the minimum length among the three input lists.\"\"\"\n    return min(len(list1), len(list2), len(list3))\n\ndef compare_elements_at_index(list1, list2, list3, index):\n    \"\"\"Compares elements at a specific index across the three input lists.\"\"\"\n    return list1[index] == list2[index] == list3[index]\n\ndef build_result_list(list1, list2, list3, min_length):\n    \"\"\"Iterates up to the minimum length, building a list of common elements.\"\"\"\n    result = []\n    for i in range(min_length):\n        if compare_elements_at_index(list1, list2, list3, i):\n            result.append(list1[i])\n    return result\n\ndef extract_index_list(list1, list2, list3):\n    \"\"\"Orchestrates finding common elements at the same index across three lists.\"\"\"\n    min_length = get_minimum_length(list1, list2, list3)\n    result_list = build_result_list(list1, list2, list3, min_length)\n    return result_list"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(input_list):\n    \"\"\"\n    Finds the second smallest unique number in a list.\n    Handles duplicates, negative numbers, and zero.\n    \"\"\"\n    unique_numbers = sorted(list(set(input_list)))\n    return unique_numbers[1]"}
{"task_id": "Mbpp/758", "solution": "from typing import List, Dict, Tuple\n\ndef unique_sublists(input_list: List[List]) -> Dict[Tuple, int]:\n    \"\"\"\n    Count occurrences of sublists within a list.\n    Converts each sublist to a tuple and returns a dictionary of tuple counts.\n    \"\"\"\n    counts: Dict[Tuple, int] = {}\n    for sublist in input_list:\n        current_tuple = tuple(sublist)\n        counts[current_tuple] = counts.get(current_tuple, 0) + 1\n    return counts"}
{"task_id": "Mbpp/757", "solution": "def is_reverse(str1: str, str2: str) -> bool:\n    \"\"\"Checks if str2 is the exact reverse of str1.\n    Performs case-sensitive comparison.\"\"\"\n    return str1 == str2[::-1]\n\ndef is_palindrome(string: str) -> bool:\n    \"\"\"Checks if a string is a palindrome.\n    Performs case-sensitive comparison.\"\"\"\n    return string == string[::-1]\n\ndef count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"Counts pairs of reverse strings in the given list.\n    Handles duplicates, palindromes, and empty lists as per design.\"\"\"\n    count = 0\n    unique_strings_list = list(set(string_list))\n    matched_strings = set()\n\n    for i in range(len(unique_strings_list)):\n        s1 = unique_strings_list[i]\n\n        if s1 in matched_strings:\n            continue\n\n        if is_palindrome(s1):\n            matched_strings.add(s1)\n            continue\n\n        for j in range(i + 1, len(unique_strings_list)):\n            s2 = unique_strings_list[j]\n\n            if s2 in matched_strings:\n                continue\n\n            if is_reverse(s1, s2):\n                count += 1\n                matched_strings.add(s1)\n                matched_strings.add(s2)\n                break\n    return count"}
{"task_id": "Mbpp/757", "solution": "```python\nfrom typing import List\n\ndef _reverse_string(s: str) -> str:\n    \"\"\"Reverses a single string.\"\"\"\n    return s[::-1]\n\ndef _are_reverse(s1: str, s2: str) -> bool:\n    \"\"\"Checks if two strings are reverses of each other.\"\"\"\n    return s1 == _reverse_string(s2)\n\ndef count_reverse_pairs(string_list: List[str]) -> int:\n    \"\"\"\n    Counts pairs of strings where one is the exact reverse of another in a list.\n    Handles case-sensitive comparison and counts each pair exactly once.\n    \"\"\"\n    count = 0\n    seen = set()\n    n = len(string_list)\n\n    for i in range(n):\n        s1 = string_list[i]\n        if s1 in seen:\n            continue\n\n        for j in range(i + 1, n):\n            s2 = string_list[j]\n            if s2 in seen:\n                continue\n\n            if _are_reverse(s1, s2):\n                count += 1\n                seen.add(s1)\n                seen.add(s2)\n                # Found a pair for s1, no need to check further with s1 in this inner loop\n                break \n    return count\n```"}
{"task_id": "Mbpp/758", "solution": "```python\ndef unique_sublists(input_list: list) -> dict:\n    \"\"\"\n    Counts occurrences of sublists within a list, converting each sublist to a tuple.\n    Returns a dictionary mapping these unique tuples to their respective counts.\n    \"\"\"\n    occurrence_counts = {}\n\n    for sublist in input_list:\n        sublist_as_tuple = tuple(sublist)\n        occurrence_counts[sublist_as_tuple] = occurrence_counts.get(sublist_as_tuple, 0) + 1\n\n    return occurrence_counts\n```"}
{"task_id": "Mbpp/759", "solution": "def _parse_decimal_string(input_str: str) -> tuple[str, str] | None:\n    \"\"\"Parses string into integer and decimal parts.\n    Returns (integer_part, decimal_part) tuple or None if parsing fails.\n    \"\"\"\n    if '.' in input_str:\n        parts = input_str.split('.')\n        return parts[0], parts[1]\n    return None\n\ndef _validate_format(input_str: str) -> bool:\n    \"\"\"Validates basic decimal format requirements.\n    Checks for a single decimal point and ensures all parts are numeric.\n    \"\"\"\n    if not input_str:\n        return False\n    \n    dot_count = input_str.count('.')\n    if dot_count != 1:\n        return False\n\n    parts = input_str.split('.')\n    integer_part = parts[0]\n    decimal_part = parts[1]\n\n    if not integer_part or not decimal_part: # Ensures no empty parts like \".12\" or \"12.\"\n        return False\n\n    if not integer_part.isdigit() or not decimal_part.isdigit():\n        return False\n        \n    return True\n\ndef _check_precision(decimal_part: str) -> bool:\n    \"\"\"Verifies decimal part has exactly 2 digits.\n    This ensures the required precision level.\n    \"\"\"\n    return len(decimal_part) == 2\n\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"Main validation function - checks if string is valid 2-decimal number.\n    Returns True for valid formats, False otherwise, following functional principles.\n    \"\"\"\n    if not _validate_format(input_string):\n        return False\n    \n    parts = _parse_decimal_string(input_string) # _validate_format ensures this will not be None\n    \n    if parts is None: # Should not happen if _validate_format passes, but for robustness\n        return False\n\n    _, decimal_part = parts\n    \n    return _check_precision(decimal_part)"}
