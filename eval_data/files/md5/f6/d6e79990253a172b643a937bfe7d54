{"task_id": "Mbpp/593", "solution": "def _split_octets(ip_string: str) -> list[str]:\n    \"\"\"Splits an IP address string into a list of octet strings.\"\"\"\n    return ip_string.split('.')\n\ndef _remove_leading_zeros(octet: str) -> str:\n    \"\"\"Removes leading zeroes from an octet string, preserving a single zero if necessary.\"\"\"\n    return str(int(octet))\n\ndef _join_octets(octets: list[str]) -> str:\n    \"\"\"Joins a list of octet strings back into an IP address string.\"\"\"\n    return '.'.join(octets)\n\ndef removezero_ip(ip_string: str) -> str:\n    \"\"\"\n    Removes leading zeroes from each octet in an IP address string.\n    Processes input like \"216.08.094.196\" to \"216.8.94.196\".\n    \"\"\"\n    octets = _split_octets(ip_string)\n    processed_octets = [_remove_leading_zeros(octet) for octet in octets]\n    return _join_octets(processed_octets)"}
{"task_id": "Mbpp/594", "solution": "def find_first_even(numbers: list[int]) -> int | None:\n    \"\"\"Identifies the first even number in the list.\n    Returns the first even number found, or None if no even number exists.\n    \"\"\"\n    for number in numbers:\n        if number % 2 == 0:\n            return number\n    return None\n\ndef find_first_odd(numbers: list[int]) -> int | None:\n    \"\"\"Identifies the first odd number in the list.\n    Returns the first odd number found, or None if no odd number exists.\n    \"\"\"\n    for number in numbers:\n        if number % 2 != 0:\n            return number\n    return None\n\ndef calculate_difference(even: int, odd: int) -> int:\n    \"\"\"Calculates the arithmetic difference between an even and an odd number.\"\"\"\n    return even - odd\n\ndef diff_even_odd(numbers: list[int]) -> int:\n    \"\"\"Finds the difference between the first even and first odd number in a list.\n    Raises ValueError if either an even or an odd number is not found.\n    \"\"\"\n    first_even = find_first_even(numbers)\n    first_odd = find_first_odd(numbers)\n\n    if first_even is None:\n        raise ValueError(\"No even number found\")\n    if first_odd is None:\n        raise ValueError(\"No odd number found\")\n\n    return calculate_difference(first_even, first_odd)"}
