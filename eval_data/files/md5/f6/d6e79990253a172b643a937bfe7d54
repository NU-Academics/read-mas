{"task_id": "Mbpp/573", "solution": "def unique_product(input_list):\n    \"\"\"\n    Calculates the product of unique numbers in a given list.\n    Duplicates are automatically removed before calculating the product.\n    \"\"\"\n    unique_numbers = set(input_list)\n    product = 1\n    for number in unique_numbers:\n        product *= number\n    return product"}
{"task_id": "Mbpp/572", "solution": "def two_unique_nums(input_list: list) -> list:\n    \"\"\"Removes duplicate numbers, returning only those appearing exactly once while preserving order.\n\n    Counts occurrences of each number and then filters the original list based on these counts.\n    \"\"\"\n    occurrence_count = {}\n    for num in input_list:\n        occurrence_count[num] = occurrence_count.get(num, 0) + 1\n\n    result = []\n    for num in input_list:\n        if occurrence_count[num] == 1:\n            result.append(num)\n\n    return result"}
{"task_id": "Mbpp/573", "solution": "```python\ndef unique_product(input_list: list) -> float:\n    \"\"\"\n    Calculates the product of unique numbers in a given list.\n    Handles empty lists (returns 1) and lists containing zero (returns 0).\n    \"\"\"\n    unique_numbers = set(input_list)\n    product = 1.0\n\n    for num in unique_numbers:\n        product *= num\n\n    return product\n```"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Calculates the last digit of the factorial of a given non-negative integer.\n    For n >= 5, the last digit is always 0, which optimizes performance.\n    \"\"\"\n    if n >= 5:\n        return 0\n\n    # For n < 5, calculate the factorial explicitly.\n    factorial_val = 1\n    for i in range(1, n + 1):\n        factorial_val *= i\n\n    # Extract the last digit using the modulo 10 operation.\n    return factorial_val % 10"}
{"task_id": "Mbpp/576", "solution": "def _validate_inputs(main_list, sub_list):\n    \"\"\"\n    Internal function for input validation.\n    As critical requirements forbid type checks, this function structurally fulfills the design while always returning True.\n    \"\"\"\n    return True\n\ndef _find_contiguous_match(main_list, sub_list):\n    \"\"\"\n    Internal function to perform the core contiguous sublist search algorithm.\n    It iterates through main_list to find a matching slice for sub_list.\n    \"\"\"\n    len_main = len(main_list)\n    len_sub = len(sub_list)\n\n    if len_sub > len_main:\n        return False\n\n    for i in range(len_main - len_sub + 1):\n        if main_list[i:i + len_sub] == sub_list:\n            return True\n    return False\n\ndef is_Sub_Array(main_list, sub_list):\n    \"\"\"\n    Checks if the sub_list is a contiguous sublist of the main_list.\n    Returns True if found, False otherwise.\n    \"\"\"\n    _validate_inputs(main_list, sub_list) # Validate inputs as per design, though no-op due to critical requirements.\n\n    if not sub_list:\n        return True # An empty list is always a sublist.\n\n    return _find_contiguous_match(main_list, sub_list)"}
{"task_id": "Mbpp/577", "solution": "def _calculate_factorial(n: int) -> int:\n    \"\"\"Calculates the factorial of a non-negative integer.\n    It returns 1 for n=0 and the product for n > 0.\n    \"\"\"\n    if n == 0:\n        return 1\n    result = 1\n    for i in range(1, n + 1):\n        result *= i\n    return result\n\ndef _extract_last_digit(num: int) -> int:\n    \"\"\"Extracts the last digit of an integer using the modulo operator.\n    This works for both positive and negative integers.\n    \"\"\"\n    return num % 10\n\ndef last_Digit_Factorial(number: int) -> int:\n    \"\"\"\n    Computes the last digit of the factorial for a given number.\n    It leverages the mathematical property that factorials of numbers >= 10 always end in 0.\n    \"\"\"\n    if number >= 10:\n        return 0\n    \n    # For smaller numbers, calculate the factorial and then extract its last digit.\n    factorial_value = _calculate_factorial(number)\n    return _extract_last_digit(factorial_value)"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list: list, sub_list: list) -> bool:\n    \"\"\"Checks if sub_list is a contiguous sublist of main_list.\"\"\"\n\n    # Handle empty list scenarios first.\n    if not sub_list:\n        return True\n    if not main_list:\n        return False\n\n    n = len(main_list)\n    m = len(sub_list)\n\n    # If the sub_list is longer than the main_list, it cannot be a sub_array.\n    if m > n:\n        return False\n\n    # Iterate through all possible starting positions for the sub_list in the main_list.\n    for i in range(n - m + 1):\n        # Assume a match and try to disprove it.\n        match = True\n        for j in range(m):\n            if main_list[i + j] != sub_list[j]:\n                match = False\n                break  # No match at this position, move to the next.\n        if match:\n            return True  # Found a contiguous match.\n\n    return False  # No contiguous sub_list found after checking all positions."}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1, list2, list3) -> list:\n    \"\"\"\n    Interleave three lists of equal length into a single flat list.\n    The output follows the pattern: list1[i], list2[i], list3[i] for each index i.\n    \"\"\"\n    result = []\n    length = len(list1) # Assumes all three lists have equal length\n\n    for i in range(length):\n        result.append(list1[i])\n        result.append(list2[i])\n        result.append(list3[i])\n\n    return result"}
{"task_id": "Mbpp/578", "solution": "```python\ndef interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"Interleaves elements from three lists of equal length into a single flat list.\n    Elements are interleaved in the pattern: list1[i], list2[i], list3[i] for each index i.\n    \"\"\"\n    result = []\n    # All input lists are guaranteed to be of the same length.\n    for i in range(len(list1)):\n        result.append(list1[i])\n        result.append(list2[i])\n        result.append(list3[i])\n    return result\n```"}
{"task_id": "Mbpp/579", "solution": "```python\ndef find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Finds elements present in one tuple but not in both.\n    Maintains relative order: elements from tuple1 appear first, then elements from tuple2.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    result = []\n\n    for item in tuple1:\n        if item not in set2:\n            result.append(item)\n\n    for item in tuple2:\n        if item not in set1:\n            result.append(item)\n\n    return tuple(result)\n```"}
{"task_id": "Mbpp/579", "solution": "def get_unique_elements(source_tuple: tuple, comparison_tuple: tuple) -> list:\n    \"\"\"Identifies elements unique to the source tuple not present in the comparison tuple, maintaining order.\"\"\"\n    comparison_set = set(comparison_tuple)\n    unique_elements = []\n    for item in source_tuple:\n        if item not in comparison_set:\n            unique_elements.append(item)\n    return unique_elements\n\ndef combine_results(first_unique: list, second_unique: list) -> tuple:\n    \"\"\"Combines two lists of unique elements into a single tuple.\"\"\"\n    return tuple(first_unique + second_unique)\n\ndef find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Finds elements that exist in either input tuple but not in both, maintaining their relative order.\n    It identifies elements unique to tuple1 and tuple2, then combines them into a single result tuple.\n    \"\"\"\n    unique_to_tuple1 = get_unique_elements(tuple1, tuple2)\n    unique_to_tuple2 = get_unique_elements(tuple2, tuple1)\n    return combine_results(unique_to_tuple1, unique_to_tuple2)"}
{"task_id": "Mbpp/583", "solution": "def factorial(k: int) -> int:\n    \"\"\"Calculates the factorial of a non-negative integer k.\"\"\"\n    if k == 0:\n        return 1\n    res = 1\n    for i in range(1, k + 1):\n        res *= i\n    return res\n\ndef catalan_number(n: int) -> int:\n    \"\"\"Calculates the nth Catalan number using the standard formula C(n) = (2n)! / ((n+1)! * n!).\"\"\"\n    numerator = factorial(2 * n)\n    denominator = factorial(n + 1) * factorial(n)\n    return numerator // denominator"}
{"task_id": "Mbpp/581", "solution": "```python\ndef surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the total surface area of a square pyramid.\n    The input 'height' is interpreted as the slant height of the pyramid's faces.\n    \"\"\"\n    base_area = base_edge ** 2  # Calculate the area of the square base.\n    \n    # Calculate the lateral surface area using the provided slant height.\n    # The lateral surface area is 4 * (0.5 * base_edge * slant_height), which simplifies to 2 * base_edge * slant_height.\n    lateral_surface_area = 2 * base_edge * height \n    \n    total_surface_area = base_area + lateral_surface_area # Sum base and lateral areas.\n\n    return total_surface_area\n```"}
{"task_id": "Mbpp/581", "solution": "import math\n\ndef surface_Area(base_edge, height):\n    \"\"\"Calculates the total surface area of a square pyramid given its base edge and height.\n    Returns the calculated surface area as a float.\n    \"\"\"\n    # Calculate base area (square)\n    base_area = base_edge ** 2\n\n    # Calculate slant height using Pythagorean theorem\n    slant_height = math.sqrt(height ** 2 + (base_edge / 2) ** 2)\n\n    # Calculate area of one triangular face\n    triangular_area = 0.5 * base_edge * slant_height\n\n    # Calculate total surface area (base + 4 triangular faces)\n    total_surface_area = base_area + 4 * triangular_area\n\n    return total_surface_area"}
{"task_id": "Mbpp/580", "solution": "def _is_even(number: int) -> bool:\n    \"\"\"Checks if a given integer is even.\n    Returns True if even, False otherwise.\"\"\"\n    return number % 2 == 0\n\ndef _process_element(element: any) -> any:\n    \"\"\"Recursively processes elements, filtering odd integers and preserving structure.\n    Returns the processed element or None if an odd integer is filtered.\"\"\"\n    if isinstance(element, tuple):\n        processed_elements = []\n        for item in element:\n            processed_item = _process_element(item)\n            if processed_item is not None:\n                processed_elements.append(processed_item)\n        return tuple(processed_elements)\n    elif isinstance(element, int):\n        if _is_even(element):\n            return element\n        else:\n            return None\n    else:\n        return element\n\ndef extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"Removes odd integer elements from a nested mixed tuple while preserving its structure.\n    Recursively processes all elements to build a new filtered tuple.\"\"\"\n    return _process_element(input_tuple)"}
{"task_id": "Mbpp/580", "solution": "```python\ndef extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Remove odd integer elements from nested mixed tuple while preserving structure.\n\n    Args:\n        input_tuple: Nested tuple containing integers and other tuples\n\n    Returns:\n        Filtered tuple containing only even integers and nested tuples\n    \"\"\"\n    result_elements = []\n    for element in input_tuple:\n        if isinstance(element, int):\n            if element % 2 == 0:\n                result_elements.append(element)\n        elif isinstance(element, tuple):\n            processed_sub_tuple = extract_even(element)\n            # Include the processed sub-tuple only if it contains elements\n            if processed_sub_tuple:\n                result_elements.append(processed_sub_tuple)\n    return tuple(result_elements)\n```"}
{"task_id": "Mbpp/583", "solution": "def _combinations(n: int, k: int) -> int:\n    \"\"\"\n    Calculates the binomial coefficient C(n, k) using an iterative method.\n    Assumes n and k are non-negative integers with k <= n.\n    \"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\n\ndef _compute_catalan(n: int) -> int:\n    \"\"\"\n    Computes the nth Catalan number using the formula C_n = C(2n, n) / (n + 1).\n    Assumes n is a non-negative integer.\n    \"\"\"\n    # C_0 is 1, which the formula also produces: C(0,0)/(0+1) = 1/1 = 1\n    numerator = _combinations(2 * n, n)\n    result = numerator // (n + 1)\n    return result\n\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Catalan number based on the provided integer input n.\n    Input validation and error handling are omitted as per critical requirements.\n    \"\"\"\n    return _compute_catalan(n)"}
