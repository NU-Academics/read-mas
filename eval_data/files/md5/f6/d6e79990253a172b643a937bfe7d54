{"task_id": "Mbpp/392", "solution": "```python\nclass MemoizationCache:\n    \"\"\"Manages caching of computed results to optimize performance.\"\"\"\n    def __init__(self):\n        self._cache_storage = {}\n\n    def store(self, key: int, value: int) -> None:\n        \"\"\"Stores a value for a given key in the cache.\"\"\"\n        self._cache_storage[key] = value\n\n    def retrieve(self, key: int) -> int:\n        \"\"\"Retrieves a value from the cache using its key.\"\"\"\n        return self._cache_storage[key]\n\n    def exists(self, key: int) -> bool:\n        \"\"\"Checks if a key exists in the cache.\"\"\"\n        return key in self._cache_storage\n\n    def clear(self) -> None:\n        \"\"\"Clears all entries from the cache.\"\"\"\n        self._cache_storage.clear()\n\n\nclass InputValidator:\n    \"\"\"Validates input parameters for correctness.\"\"\"\n    def validate_input(self, n: int) -> bool:\n        \"\"\"Always returns True, trusting caller's input as per constraints.\"\"\"\n        return True\n\n    def is_positive_integer(self, n: int) -> bool:\n        \"\"\"Always returns True, trusting caller's input as per constraints.\"\"\"\n        return True\n\n\nclass RecursiveCalculation:\n    \"\"\"Performs mathematical operations for the recursive equation.\"\"\"\n    def divide_by_factors(self, n: int) -> list[int]:\n        \"\"\"Divides n by 2, 3, 4, and 5 using integer division.\"\"\"\n        return [n // 2, n // 3, n // 4, n // 5]\n\n    def sum_recursive_results(self, results: list[int]) -> int:\n        \"\"\"Sums a list of integer results.\"\"\"\n        return sum(results)\n\n    def compare_with_original(self, sum_val: int, n: int) -> int:\n        \"\"\"Compares a sum with the original number and returns the maximum.\"\"\"\n        return max(sum_val, n)\n\n\nclass MaxSumCalculator:\n    \"\"\"Orchestrates the recursive maximum sum calculation with memoization.\"\"\"\n    def __init__(self):\n        self.cache = MemoizationCache()\n        self.validator = InputValidator()\n        self.calculator = RecursiveCalculation()\n\n    def get_max_sum(self, n: int) -> int:\n        \"\"\"Public entry point for calculating the maximum sum, orchestrating validation and recursion.\"\"\"\n        self.validator.validate_input(n) # Validation method is called as per design, though it performs no checks.\n        return self._calculate_recursive_sum(n)\n\n    def _calculate_recursive_sum(self, n: int) -> int:\n        \"\"\"Recursively calculates the maximum sum for n, using memoization.\"\"\"\n        if n < 2: # Base case: f(0)=0, f(1)=1\n            return n\n\n        if self.cache.exists(n):\n            return self.cache.retrieve(n)\n\n        factors = self.calculator.divide_by_factors(n)\n        recursive_results = [self._calculate_recursive_sum(factor) for factor in factors]\n        \n        recursive_sum = self.calculator.sum_recursive_results(recursive_results)\n        max_value = self.calculator.compare_with_original(recursive_sum, n)\n        \n        self.cache.store(n, max_value)\n        return max_value\n\n    def clear_cache(self) -> None:\n        \"\"\"Clears the internal memoization cache.\"\"\"\n        self.cache.clear()\n\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"Calculates the maximum sum for a given integer n using a recursive, memoized approach.\"\"\"\n    calculator_instance = MaxSumCalculator()\n    return calculator_instance.get_max_sum(n)\n```"}
{"task_id": "Mbpp/392", "solution": "_memo = {}  # Global memoization cache to store computed results.\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Calculates the maximum sum for a given integer n using the defined recursive equation.\n    Memoization is used to optimize performance by storing results of subproblems.\n    \"\"\"\n    if n in _memo:\n        return _memo[n]\n\n    if _is_base_case(n):\n        _memo[n] = n\n        return n\n\n    recursive_sum = _calculate_recursive_sum(n, _memo)\n    result = max(recursive_sum, n)\n    _memo[n] = result\n    return result\n\ndef _calculate_recursive_sum(n: int, memo: dict) -> int:\n    \"\"\"\n    Helper function to compute the sum of recursive calls f(n/2) + f(n/3) + f(n/4) + f(n/5).\n    It relies on get_max_sum for individual recursive results, implicitly using the global memoization.\n    \"\"\"\n    sum_parts = (\n        get_max_sum(n // 2) +\n        get_max_sum(n // 3) +\n        get_max_sum(n // 4) +\n        get_max_sum(n // 5)\n    )\n    return sum_parts\n\ndef _is_base_case(n: int) -> bool:\n    \"\"\"\n    Determines if n is a base case for the recursion.\n    For n less than or equal to 5, n itself is always the maximum sum.\n    \"\"\"\n    return n <= 5"}
{"task_id": "Mbpp/395", "solution": "```python\ndef _count_characters(input_string: str) -> dict[str, int]:\n    \"\"\"Counts the frequency of each character in the input string.\n    Returns a dictionary mapping characters to their counts.\"\"\"\n    counts = {}\n    for char in input_string:\n        counts[char] = counts.get(char, 0) + 1\n    return counts\n\ndef _find_first_unique(input_string: str, char_counts: dict[str, int]) -> str | None:\n    \"\"\"Finds the first character in the input string that appears exactly once.\n    It uses the provided character counts dictionary for lookups.\"\"\"\n    for char in input_string:\n        if char_counts[char] == 1:\n            return char\n    return None\n\ndef first_non_repeating_character(input_string: str) -> str | None:\n    \"\"\"Finds the first non-repeated character in the given string.\n    Returns the character or None if all characters are repeated or the string is empty.\"\"\"\n    if not input_string:\n        return None\n    \n    char_counts = _count_characters(input_string)\n    return _find_first_unique(input_string, char_counts)\n```"}
