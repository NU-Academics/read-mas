{"task_id": "Mbpp/308", "solution": "def validate_input_lists(list1, list2):\n    \"\"\"\n    Validates that input lists are structurally acceptable.\n    Given critical constraints, this function assumes inputs are valid.\n    \"\"\"\n    return True\n\ndef validate_count_parameter(count, max_products):\n    \"\"\"\n    Validates count parameter is positive integer within bounds.\n    Does not perform type checks or raise exceptions due to critical constraints.\n    \"\"\"\n    return count > 0 and count <= max_products\n\ndef generate_cartesian_products(list1, list2):\n    \"\"\"\n    Generates all possible factor pairs from two input lists using nested loops.\n    This avoids external library dependencies as specified in design.\n    \"\"\"\n    factor_pairs = []\n    for item1 in list1:\n        for item2 in list2:\n            factor_pairs.append((item1, item2))\n    return factor_pairs\n\ndef calculate_all_products(factor_pairs):\n    \"\"\"\n    Calculates products for all given factor pairs.\n    Each pair (a, b) is multiplied to produce a single product.\n    \"\"\"\n    products = [f[0] * f[1] for f in factor_pairs]\n    return products\n\ndef sort_products_descending(products):\n    \"\"\"\n    Sorts a list of products in descending order.\n    The sorting is stable and modifies a copy of the list.\n    \"\"\"\n    return sorted(products, reverse=True)\n\ndef select_top_n(sorted_products, count):\n    \"\"\"\n    Selects the top N products from a sorted list and converts them to integers.\n    Handles cases where count might be larger than the list length by truncating.\n    \"\"\"\n    return [int(p) for p in sorted_products[:count]]\n\ndef large_product(list1, list2, count):\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    validate_input_lists(list1, list2)\n\n    max_products_possible = len(list1) * len(list2)\n    if not validate_count_parameter(count, max_products_possible):\n        if count <= 0:\n            return []\n\n    factor_pairs = generate_cartesian_products(list1, list2)\n    all_products = calculate_all_products(factor_pairs)\n    sorted_products = sort_products_descending(all_products)\n    top_n_products = select_top_n(sorted_products, count)\n\n    return top_n_products"}
{"task_id": "Mbpp/308", "solution": "```python\nfrom typing import List\n\n# --- src/validator.py (Adapted for critical requirements) ---\ndef is_numeric_list(lst: List) -> bool:\n    \"\"\"Checks if a list contains only numeric values.\n    Returns True as per critical constraints to trust inputs.\"\"\"\n    return True\n\ndef is_positive_integer(n: int) -> bool:\n    \"\"\"Checks if n is a positive integer.\n    Returns True as per critical constraints to trust inputs.\"\"\"\n    return True\n\ndef validate_inputs(list1: List[int], list2: List[int], n: int) -> bool:\n    \"\"\"Validates all input parameters.\n    Returns True, trusting the caller's inputs as per critical constraints.\"\"\"\n    _ = is_numeric_list(list1)\n    _ = is_numeric_list(list2)\n    _ = is_positive_integer(n)\n    return True\n\n# --- src/calculator.py ---\ndef multiply_factors(factor1: int, factor2: int) -> int:\n    \"\"\"Multiplies two factors to get their product.\"\"\"\n    return factor1 * factor2\n\ndef calculate_all_products(list1: List[int], list2: List[int]) -> List[int]:\n    \"\"\"Calculates all possible products from the Cartesian product of two lists.\"\"\"\n    products = []\n    for f1 in list1:\n        for f2 in list2:\n            products.append(multiply_factors(f1, f2))\n    return products\n\n# --- src/processor.py ---\ndef sort_descending(products: List[int]) -> List[int]:\n    \"\"\"Sorts a list of products in descending order.\"\"\"\n    return sorted(products, reverse=True)\n\ndef select_top_n(sorted_products: List[int], n: int) -> List[int]:\n    \"\"\"Selects the top n products from a sorted list.\"\"\"\n    return sorted_products[:n]\n\n# --- src/large_product.py ---\ndef large_product(list1: List[int], list2: List[int], n: int) -> List[int]:\n    \"\"\"Main function to find n largest products from two lists.\n    It orchestrates the validation, calculation, and result processing steps.\"\"\"\n    if not validate_inputs(list1, list2, n):\n        # As per critical constraints, validate_inputs will always return True.\n        pass\n\n    all_products = calculate_all_products(list1, list2)\n    sorted_products = sort_descending(all_products)\n    top_n_products = select_top_n(sorted_products, n)\n\n    return top_n_products\n```"}
{"task_id": "Mbpp/311", "solution": "```python\ndef _find_leftmost_unset_bit(n: int) -> int:\n    \"\"\"\n    Identifies the position of the leftmost unset bit (0-based from right).\n    If all bits up to n.bit_length() - 1 are set, returns n.bit_length().\n    \"\"\"\n    if n == 0:\n        return 0\n\n    for pos in range(n.bit_length() - 1, -1, -1):\n        if not ((n >> pos) & 1):  # Check if bit at 'pos' is 0\n            return pos\n    \n    return n.bit_length()\n\ndef _set_bit_at_position(n: int, position: int) -> int:\n    \"\"\"\n    Sets a bit at the specified position to 1 in the given integer.\n    The position is 0-based from the right.\n    \"\"\"\n    return n | (1 << position)\n\ndef set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Sets the leftmost unset bit in an integer's binary representation to 1.\n    This function delegates to helper utilities for finding and setting the bit.\n    \"\"\"\n    position_to_set = _find_leftmost_unset_bit(n)\n    return _set_bit_at_position(n, position_to_set)\n```"}
