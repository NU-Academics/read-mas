{"task_id": "Mbpp/92", "solution": "```python\ndef validate_input(number: int) -> bool:\n    \"\"\"\n    Validate input meets requirements: positive integer with at least 3 digits.\n    The number must be positive and have a minimum length of 3 digits.\n    \"\"\"\n    if number <= 0:\n        return False\n    \n    str_number = str(number)\n    if len(str_number) < 3:\n        return False\n    \n    return True\n\n\ndef extract_digits(number: int) -> list:\n    \"\"\"\n    Extract individual digits from number.\n    Converts the number to a string and then to a list of integers.\n    \"\"\"\n    return [int(d) for d in str(number)]\n\n\ndef analyze_pattern(digits: list) -> bool:\n    \"\"\"\n    Analyze if digits alternate between exactly two different values.\n    Checks for exactly two unique digits and a strict alternating pattern.\n    \"\"\"\n    if len(digits) < 2:\n        return False\n\n    unique_digits = set(digits)\n    if len(unique_digits) != 2:\n        return False\n\n    d1 = digits[0]\n    d2 = next(d for d in unique_digits if d != d1)\n\n    for i in range(len(digits)):\n        expected_digit = d1 if i % 2 == 0 else d2\n        if digits[i] != expected_digit:\n            return False\n            \n    return True\n\n\ndef is_undulating(number: int) -> bool:\n    \"\"\"\n    Check if a number is undulating (alternates between exactly two different digits).\n    Orchestrates input validation, digit extraction, and pattern analysis.\n    \"\"\"\n    if not validate_input(number):\n        return False\n\n    digits = extract_digits(number)\n    return analyze_pattern(digits)\n```"}
{"task_id": "Mbpp/92", "solution": "def validate_input(number: int) -> bool:\n    \"\"\"Validates if the number is positive and has at least 3 digits.\"\"\"\n    return number > 0 and number >= 100\n\ndef extract_digits(number: int) -> list[int]:\n    \"\"\"Extracts individual digits from the number into a list.\"\"\"\n    return [int(d) for d in str(number)]\n\ndef count_unique_digits(digits: list[int]) -> int:\n    \"\"\"Counts the number of unique digits in the provided list.\"\"\"\n    return len(set(digits))\n\ndef check_alternating_pattern(digits: list[int]) -> bool:\n    \"\"\"Verifies if digits alternate consistently between exactly two values.\"\"\"\n    if len(digits) < 2 or digits[0] == digits[1]:\n        return False\n\n    first_pattern_digit = digits[0]\n    second_pattern_digit = digits[1]\n\n    for i in range(2, len(digits)):\n        expected_digit = first_pattern_digit if i % 2 == 0 else second_pattern_digit\n        if digits[i] != expected_digit:\n            return False\n    return True\n\ndef is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if a given positive integer exhibits an undulating pattern.\n    The pattern must alternate between exactly two different digits throughout its length.\n    \"\"\"\n    if not validate_input(number):\n        return False\n\n    digits = extract_digits(number)\n\n    if count_unique_digits(digits) != 2:\n        return False\n\n    return check_alternating_pattern(digits)"}
