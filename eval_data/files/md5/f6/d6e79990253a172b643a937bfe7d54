{"task_id": "Mbpp/721", "solution": "```python\nclass Cell:\n    def __init__(self, row: int, col: int, cost: int):\n        \"\"\"Initializes a cell with its row, column, and cost.\"\"\"\n        self._row = row\n        self._col = col\n        self._cost = cost\n\n    def getRow(self) -> int:\n        \"\"\"Returns the row index of the cell.\"\"\"\n        return self._row\n\n    def getCol(self) -> int:\n        \"\"\"Returns the column index of the cell.\"\"\"\n        return self._col\n\n    def getCost(self) -> int:\n        \"\"\"Returns the cost associated with the cell.\"\"\"\n        return self._cost\n\n\nclass Matrix:\n    def __init__(self, cells_data: list[list]):\n        \"\"\"Initializes a matrix from a list of lists of costs.\"\"\"\n        self._size = len(cells_data)\n        self._cells: list[list[Cell]] = []\n        for r in range(self._size):\n            row_cells = []\n            for c in range(self._size):\n                row_cells.append(Cell(r, c, cells_data[r][c]))\n            self._cells.append(row_cells)\n\n    def getCell(self, row: int, col: int) -> Cell:\n        \"\"\"Returns the Cell object at the specified row and column.\"\"\"\n        return self._cells[row][col]\n\n    def getSize(self) -> int:\n        \"\"\"Returns the size (N) of the N*N matrix.\"\"\"\n        return self._size\n\n    def isValidPosition(self, row: int, col: int) -> bool:\n        \"\"\"Checks if a given row and column are within matrix bounds.\"\"\"\n        return 0 <= row < self._size and 0 <= col < self._size\n\n\nclass Path:\n    def __init__(self):\n        \"\"\"Initializes an empty path with zero total cost and cell count.\"\"\"\n        self._cells: list[Cell] = []\n        self._total_cost = 0\n        self._cell_count = 0\n\n    def addCell(self, cell: Cell) -> None:\n        \"\"\"Adds a cell to the path and updates total cost and count.\"\"\"\n        self._cells.append(cell)\n        self._total_cost += cell.getCost()\n        self._cell_count += 1\n\n    def calculateAverage(self) -> float:\n        \"\"\"Calculates the average cost of the path.\"\"\"\n        if self._cell_count == 0:\n            return 0.0\n        return self._total_cost / self._cell_count\n\n    def getTotalCost(self) -> int:\n        \"\"\"Returns the total cost accumulated along the path.\"\"\"\n        return self._total_cost\n\n    def getCellCount(self) -> int:\n        \"\"\"Returns the number of cells in the path.\"\"\"\n        return self._cell_count\n\n\nclass PathFinder:\n    def __init__(self, matrix: Matrix):\n        \"\"\"Initializes the PathFinder with a Matrix object.\"\"\"\n        self._matrix = matrix\n        self._all_paths: list[Path] = []\n\n    def findAllPaths(self) -> list[Path]:\n        \"\"\"Initiates the path generation process and returns all found paths.\"\"\"\n        start_cell = self._matrix.getCell(0, 0)\n        initial_path = Path()\n        initial_path.addCell(start_cell)\n        self._all_paths = self._generatePaths(0, 0, initial_path)\n        return self._all_paths\n\n    def _generatePaths(self, row: int, col: int, currentPath: Path) -> list[Path]:\n        \"\"\"Recursively generates all valid paths from (row, col) to (N-1, N-1).\"\"\"\n        paths_from_here = []\n        N = self._matrix.getSize()\n\n        if row == N - 1 and col == N - 1:\n            paths_from_here.append(currentPath)\n            return paths_from_here\n\n        # Move Right\n        if self._matrix.isValidPosition(row, col + 1):\n            next_cell = self._matrix.getCell(row, col + 1)\n            path_right = Path()\n            for cell in currentPath._cells:\n                path_right.addCell(cell)\n            path_right.addCell(next_cell)\n            paths_from_here.extend(self._generatePaths(row, col + 1, path_right))\n\n        # Move Down\n        if self._matrix.isValidPosition(row + 1, col):\n            next_cell = self._matrix.getCell(row + 1, col)\n            path_down = Path()\n            for cell in currentPath._cells:\n                path_down.addCell(cell)\n            path_down.addCell(next_cell)\n            paths_from_here.extend(self._generatePaths(row + 1, col, path_down))\n\n        return paths_from_here\n\n    def calculateMaxAverage(self) -> float:\n        \"\"\"Calculates the maximum average cost among all valid paths.\"\"\"\n        self.findAllPaths()\n        return self._findMaxAverage()\n\n    def _findMaxAverage(self) -> float:\n        \"\"\"Finds the maximum average from the list of all generated paths.\"\"\"\n        max_avg = -1.0 \n        if not self._all_paths:\n            return 0.0\n\n        for path in self._all_paths:\n            current_avg = path.calculateAverage()\n            if current_avg > max_avg:\n                max_avg = current_avg\n        return max_avg\n\n\nclass PathAnalyzer:\n    def analyzeMatrix(self, matrix_data: list[list]) -> float:\n        \"\"\"Analyzes the input matrix to find the maximum average path.\"\"\"\n        self.validateInput(matrix_data) # Placeholder call as per design\n        matrix_obj = Matrix(matrix_data)\n        path_finder = PathFinder(matrix_obj)\n        max_average = path_finder.calculateMaxAverage()\n        return max_average\n\n    def validateInput(self, input_matrix: list[list]) -> bool:\n        \"\"\"A placeholder for input validation as per design specification.\"\"\"\n        return True\n\n\ndef maxAverageOfPath(matrix: list[list]) -> float:\n    \"\"\"\n    Finds the path from top-left to bottom-right with the maximum average cost.\n    Movement is restricted to right and down directions only.\n    \"\"\"\n    analyzer = PathAnalyzer()\n    return analyzer.analyzeMatrix(matrix)\n\n```"}
