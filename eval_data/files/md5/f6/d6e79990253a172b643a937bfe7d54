{"task_id": "Mbpp/743", "solution": "```python\ndef rotate_right(input_list: list, positions: int) -> list:\n    \"\"\"Rotates a list to the right by a specified number of positions.\n    Returns a new list without modifying the original.\"\"\"\n    \n    n = len(input_list)\n    effective_positions = positions % n\n    \n    return input_list[n - effective_positions:] + input_list[:n - effective_positions]\n```"}
{"task_id": "Mbpp/743", "solution": "```python\ndef rotate_right(input_list: list, positions: int) -> list:\n    \"\"\"Rotates a list to the right by a specified number of positions, returning a new list.\n    This function handles lists of integer elements with O(n) time complexity.\"\"\"\n    list_length = len(input_list)\n\n    if list_length == 0:\n        return []\n\n    effective_positions = positions % list_length\n\n    if effective_positions == 0:\n        return list(input_list)  # Return a new shallow copy if no rotation is needed\n\n    # Slice the list into two parts and concatenate them to perform the rotation.\n    rotated_list = input_list[-effective_positions:] + input_list[:-effective_positions]\n\n    return rotated_list\n```"}
{"task_id": "Mbpp/745", "solution": "class ResultManager:\n    \"\"\"Manages collection and sorting of valid numbers.\n    Stores numbers in a private list.\n    \"\"\"\n    def __init__(self):\n        self._valid_numbers = []\n\n    def add_number(self, number: int) -> None:\n        self._valid_numbers.append(number)\n\n    def get_sorted_results(self) -> list[int]:\n        return sorted(self._valid_numbers)\n\nclass DigitValidator:\n    \"\"\"Provides methods for digit extraction and divisibility validation.\n    This class is stateless.\n    \"\"\"\n    def contains_zero(self, number: int) -> bool:\n        return '0' in str(number)\n\n    def get_digits(self, number: int) -> list[int]:\n        return [int(d) for d in str(number)]\n\n    def is_divisible_by_digit(self, number: int, digit: int) -> bool:\n        # Assumes digit is never 0 due to prior 'contains_zero' check.\n        return number % digit == 0\n\nclass NumberProcessor:\n    \"\"\"Orchestrates range iteration and number validation logic.\n    Uses DigitValidator and ResultManager to process numbers.\n    \"\"\"\n    def __init__(self, startnum: int, endnum: int):\n        self._startnum = startnum\n        self._endnum = endnum\n\n    def process_range(self) -> list[int]:\n        digit_validator = DigitValidator()\n        result_manager = ResultManager()\n\n        for number in range(self._startnum, self._endnum + 1):\n            if digit_validator.contains_zero(number):\n                continue\n\n            digits = digit_validator.get_digits(number)\n            \n            is_valid_number = True\n            for digit in digits:\n                if not digit_validator.is_divisible_by_digit(number, digit):\n                    is_valid_number = False\n                    break\n            \n            if is_valid_number:\n                result_manager.add_number(number)\n        \n        return result_manager.get_sorted_results()\n\ndef divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"Finds numbers in a range divisible by all their digits.\n    Orchestrates the NumberProcessor to perform the core logic.\n    \"\"\"\n    processor = NumberProcessor(startnum, endnum)\n    return processor.process_range()"}
{"task_id": "Mbpp/745", "solution": "from typing import List\n\ndef _extract_digits(number: int) -> List[int]:\n    \"\"\"Extracts individual digits from a number.\n    Converts the number to a string and then to a list of integers.\"\"\"\n    return [int(d) for d in str(number)]\n\ndef _contains_zero(digits: List[int]) -> bool:\n    \"\"\"Checks if the digit list contains zero.\n    Returns True if 0 is found, False otherwise.\"\"\"\n    return 0 in digits\n\ndef _is_divisible_by_all_digits(number: int, digits: List[int]) -> bool:\n    \"\"\"Checks if a number is divisible by all its digits.\n    Iterates through digits, returning False if any digit does not divide the number.\"\"\"\n    for digit in digits:\n        if number % digit != 0:\n            return False\n    return True\n\ndef divisible_by_digits(startnum: int, endnum: int) -> List[int]:\n    \"\"\"Finds numbers within a given range where each number is divisible by every digit it contains.\n    Numbers containing the digit 0 are excluded.\"\"\"\n    result = []\n    for number in range(startnum, endnum + 1):\n        digits = _extract_digits(number)\n        if not _contains_zero(digits):\n            if _is_divisible_by_all_digits(number, digits):\n                result.append(number)\n    return result"}
