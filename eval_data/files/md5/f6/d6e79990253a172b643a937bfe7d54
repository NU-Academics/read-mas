{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef find_n_largest(numbers_list: list[int], n: int) -> list[int]:\n    \"\"\"\n    Extracts the n largest elements from the input list.\n    Utilizes Python's heapq.nlargest for efficiency.\n    \"\"\"\n    return heapq.nlargest(n, numbers_list)\n\ndef sort_descending(numbers: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of numbers in descending order.\n    Returns a new sorted list.\n    \"\"\"\n    return sorted(numbers, reverse=True)\n\ndef heap_queue_largest(numbers_list: list[int], n: int) -> list[int]:\n    \"\"\"\n    Finds the n largest integers from a given list and returns them in descending order.\n    Coordinates the selection and sorting steps as per the design.\n    \"\"\"\n    # The design implies input validation, but critical constraints forbid\n    # raising exceptions or explicit type checks. Inputs are trusted.\n\n    largest_elements = find_n_largest(numbers_list, n)\n    final_sorted_result = sort_descending(largest_elements)\n    \n    return final_sorted_result"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(collection1, collection2):\n    \"\"\"\n    Finds elements common to two input collections, returning their intersection as a tuple without duplicates.\n    This pure function efficiently processes lists or tuples to identify shared elements.\n    \"\"\"\n    set1 = set(collection1)\n    set2 = set(collection2)\n    return tuple(set1.intersection(set2))"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List, Union\n\ndef heap_queue_largest(numbers: List[Union[int, float]], n: int) -> List[Union[int, float]]:\n    \"\"\"\n    Finds the n largest numbers from a list and returns them in descending order.\n    Leverages a heap-based algorithm for efficient top-k selection.\n    \"\"\"\n    # heapq.nlargest directly returns the n largest elements from the list.\n    # It also ensures the elements are in descending order, and handles edge cases like n > len(numbers) or empty lists.\n    return heapq.nlargest(n, numbers)"}
