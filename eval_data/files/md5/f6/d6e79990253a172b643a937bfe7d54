{"task_id": "Mbpp/161", "solution": "```python\ndef remove_elements(source_list: list, removal_list: list) -> list:\n    \"\"\"\n    Removes all elements from the source list that are present in the removal list.\n    Preserves the order of remaining elements while returning a new filtered list.\n    \"\"\"\n    removal_set = set(removal_list) # Use a set for efficient O(1) average time lookups.\n    filtered_list = []\n    for element in source_list:\n        if element not in removal_set:\n            filtered_list.append(element)\n    return filtered_list\n```"}
{"task_id": "Mbpp/160", "solution": "def validate_inputs(a: int, b: int, n: int) -> bool:\n    \"\"\"\n    Validates input parameters for the Diophantine equation.\n    Returns True if inputs are valid, False otherwise (e.g., both a and b are zero).\n    \"\"\"\n    return not (a == 0 and b == 0)\n\ndef extended_gcd(a: int, b: int) -> tuple[int, int, int]:\n    \"\"\"\n    Implements the Extended Euclidean Algorithm to find GCD and coefficients x, y such that ax + by = gcd.\n    The GCD returned is always positive.\n    \"\"\"\n    if b == 0:\n        # Base case: gcd(a, 0) = |a|. Coefficients x, y for a*x + 0*y = |a|.\n        # If a is 0, this case is prevented by validate_inputs.\n        return (abs(a), 1 if a > 0 else -1, 0)\n    else:\n        gcd, x1, y1 = extended_gcd(b, a % b)\n        x = y1\n        y = x1 - (a // b) * y1\n        return (gcd, x, y)\n\ndef check_divisibility(gcd: int, n: int) -> bool:\n    \"\"\"\n    Checks if the greatest common divisor (gcd) divides the target value n.\n    Returns True if n is divisible by gcd, False otherwise.\n    \"\"\"\n    return n % gcd == 0\n\ndef calculate_solution(x0: int, y0: int, gcd: int, n: int) -> tuple[int, int]:\n    \"\"\"\n    Scales the base solution (x0, y0) from ax0 + by0 = gcd to ax + by = n.\n    This function assumes n is divisible by gcd.\n    \"\"\"\n    scale_factor = n // gcd\n    x = x0 * scale_factor\n    y = y0 * scale_factor\n    return (x, y)\n\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Main entry point for solving linear Diophantine equations of the form ax + by = n.\n    Returns a tuple (x, y) of integers if a solution exists, otherwise returns None.\n    \"\"\"\n    if not validate_inputs(a, b, n):\n        return None\n\n    gcd_val, x0, y0 = extended_gcd(a, b)\n\n    if not check_divisibility(gcd_val, n):\n        return None\n\n    x, y = calculate_solution(x0, y0, gcd_val, n)\n    return (x, y)"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Calculates the sum of the series (n - 2*i) from i=0 until the term becomes non-positive.\n    The iteration for 'i' is limited to n // 2.\n    \"\"\"\n    current_sum = 0\n    # Iterate 'i' from 0 up to n // 2 (inclusive).\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        # Stop adding terms once they become less than or equal to zero.\n        if term <= 0:\n            break\n        current_sum += term\n    return current_sum"}
{"task_id": "Mbpp/160", "solution": "```python\ndef find_solution(a, b, n):\n    \"\"\"\n    Solves the linear Diophantine equation ax + by = n for integers x and y.\n    Returns a tuple (x, y) if a solution exists, otherwise returns None.\n    \"\"\"\n\n    def _extended_gcd_positive(num1, num2):\n        \"\"\"Helper for Extended Euclidean Algorithm, computes gcd(num1, num2) and Bezout coefficients.\"\"\"\n        if num2 == 0:\n            return (num1, 1, 0)\n        else:\n            gcd, x1, y1 = _extended_gcd_positive(num2, num1 % num2)\n            x = y1\n            y = x1 - (num1 // num2) * y1\n            return (gcd, x, y)\n\n    def extended_gcd(val_a, val_b):\n        \"\"\"Calculates gcd(val_a, val_b) and Bezout coefficients (x, y) such that val_a*x + val_b*y = gcd.\"\"\"\n        if val_a == 0 and val_b == 0:\n            return (0, 0, 0)\n        \n        # Handle cases where one input is zero directly for correct Bezout coefficients.\n        if val_a == 0:\n            return (abs(val_b), 0, (1 if val_b > 0 else -1) if val_b != 0 else 0)\n        if val_b == 0:\n            return (abs(val_a), (1 if val_a > 0 else -1) if val_a != 0 else 0, 0)\n\n        # Compute gcd and Bezout coefficients for absolute values.\n        abs_a, abs_b = abs(val_a), abs(val_b)\n        gcd, x_abs, y_abs = _extended_gcd_positive(abs_a, abs_b)\n\n        # Adjust signs of Bezout coefficients based on original val_a and val_b.\n        x = x_abs if val_a > 0 else -x_abs\n        y = y_abs if val_b > 0 else -y_abs\n        \n        return (gcd, x, y)\n\n    # --- Main logic for find_solution ---\n    gcd, x_bezout, y_bezout = extended_gcd(a, b)\n\n    # Handle the special case where a=0 and b=0.\n    if gcd == 0: # This implies a=0 and b=0.\n        return (0, 0) if n == 0 else None\n\n    # Check if a solution exists: n must be divisible by gcd(a, b).\n    if n % gcd != 0:\n        return None\n\n    # Calculate a particular solution (x0, y0) using the Bezout coefficients.\n    k = n // gcd\n    x0 = x_bezout * k\n    y0 = y_bezout * k\n\n    # Normalize the solution to a canonical form (e.g., smallest non-negative x).\n    # General solutions are x = x0 + (b/gcd)*t and y = y0 - (a/gcd)*t.\n    if b != 0:\n        # Calculate the divisor for normalization, using absolute value to ensure positive modulo behavior.\n        b_norm_divisor = abs(b // gcd)\n        \n        # Find x_result such that 0 <= x_result < b_norm_divisor.\n        x_result = x0 % b_norm_divisor\n        \n        # Calculate the corresponding y_result.\n        y_result = (n - a * x_result) // b\n        return (x_result, y_result)\n    else: # If b is 0, then a must be non-zero (handled gcd=0 case already).\n        # The equation is ax = n, so x = n/a. (x0, y0) is already a valid specific solution.\n        return (x0, y0)\n```"}
{"task_id": "Mbpp/162", "solution": "```python\ndef sum_series(n: int) -> int:\n    \"\"\"Calculates the sum of the series (n - 2*i) for i from 0 up to n // 2.\n    Calculation stops when a term (n - 2*i) becomes less than or equal to 0.\n    \"\"\"\n    current_sum = 0\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        if term <= 0:\n            break  # Stop calculations once a non-positive term is encountered.\n        current_sum += term\n    return current_sum\n```"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string that match their alphabet position (case-insensitive).\n    Compares string characters with 'a' at position 0, 'b' at position 1, and so on.\n    \"\"\"\n    count = 0\n    # Iterate up to the length of the string or 26 (alphabet size), whichever is smaller.\n    for i in range(min(len(input_string), 26)):\n        char_from_string = input_string[i].lower()\n        # Calculate the expected alphabet character for the current position.\n        alphabet_char = chr(ord('a') + i)\n        if char_from_string == alphabet_char:\n            count += 1\n    return count"}
{"task_id": "Mbpp/165", "solution": "def normalize_char_case(char: str) -> str:\n    \"\"\"Converts a character to its lowercase representation.\"\"\"\n    return char.lower()\n\ndef is_alphabetic_char(char: str) -> bool:\n    \"\"\"Checks if the given character is an English alphabet letter.\"\"\"\n    return 'a' <= char.lower() <= 'z'\n\n# Define a constant for the alphabet for easy reference.\n_ALPHABET = \"abcdefghijklmnopqrstuvwxyz\"\n_ALPHABET_LENGTH = len(_ALPHABET)\n\ndef get_alphabet_char_at_position(position: int) -> str:\n    \"\"\"Retrieves the alphabet character at the specified zero-based position.\"\"\"\n    if is_valid_alphabet_position(position):\n        return _ALPHABET[position]\n    return ''\n\ndef is_valid_alphabet_position(position: int) -> bool:\n    \"\"\"Validates if a given position is within the zero-based English alphabet range.\"\"\"\n    return 0 <= position < _ALPHABET_LENGTH\n\ndef compare_char_at_position(char: str, position: int) -> bool:\n    \"\"\"Compares a character (case-insensitively) with the alphabet character at a specific position.\"\"\"\n    if not is_alphabetic_char(char):\n        return False\n    normalized_char = normalize_char_case(char)\n    alphabet_char = get_alphabet_char_at_position(position)\n    return normalized_char == alphabet_char\n\ndef process_string_positions(input_string: str) -> int:\n    \"\"\"Iterates through the string and counts characters matching their alphabet position.\"\"\"\n    match_count = 0\n    for i, char in enumerate(input_string):\n        if compare_char_at_position(char, i):\n            match_count += 1\n    return match_count\n\ndef count_char_position(input_string: str) -> int:\n    \"\"\"Main entry point to count characters matching their alphabet position in a string.\"\"\"\n    return process_string_positions(input_string)"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Calculates the smallest power of 2 greater than or equal to the input non-negative integer n.\n    Handles n=0 by returning 1.\n    \"\"\"\n    if n == 0:\n        return 1\n    return 1 << (n - 1).bit_length()"}
{"task_id": "Mbpp/167", "solution": "def _validate_input(n: int) -> bool:\n    \"\"\"Validates that the input n is a non-negative integer.\n    Returns True if valid, False otherwise.\"\"\"\n    if not isinstance(n, int) or n < 0:\n        return False\n    return True\n\ndef _calculate_power_of_2(n: int) -> int:\n    \"\"\"Performs mathematical calculation for the smallest power of 2 >= n, for n > 0.\n    This function assumes n is a positive integer.\"\"\"\n    power = 1\n    while power < n:\n        power <<= 1\n    return power\n\ndef next_power_of_2(n: int) -> int:\n    \"\"\"\n    Calculates the smallest power of 2 greater than or equal to n.\n    Returns 1 when n is 0 and validates inputs as non-negative integers.\n    \"\"\"\n    if not _validate_input(n):\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    if n == 0:\n        return 1\n\n    return _calculate_power_of_2(n)"}
{"task_id": "Mbpp/166", "solution": "```python\n# src/main.py\n\ndef find_even_pair(numbers):\n    \"\"\"\n    Counts pairs of integers in a list whose XOR operation results in an even number.\n    It iterates through all unique pairs (i < j), calculates their XOR, and checks for evenness.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            xor_result = numbers[i] ^ numbers[j]\n            if xor_result % 2 == 0:\n                count += 1\n    return count\n```\n```python\n# src/test_main.py\nfrom src.main import find_even_pair\n\ndef test_find_even_pair():\n    \"\"\"\n    Validates the find_even_pair function with the specified test case.\n    It asserts that the function correctly counts even XOR pairs for a sample list.\n    \"\"\"\n    result = find_even_pair([5, 4, 7, 2, 1])\n    assert result == 4, f\"Expected 4, but got {result}\"\n\n```"}
