{"task_id": "Mbpp/448", "solution": "class InputValidator:\n    \"\"\"Handles input validation, without raising exceptions or using type checks as per critical requirements.\"\"\"\n    def validate_input(self, n: int) -> bool:\n        \"\"\"Main validation function, ensures input is a non-negative integer.\"\"\"\n        # Critical requirements forbid raising exceptions or using isinstance checks.\n        return self._check_type(n) and self._check_range(n)\n\n    def is_non_negative_integer(self, n: int) -> bool:\n        \"\"\"Checks if input is a non-negative integer by value.\"\"\"\n        # Explicit type checking is forbidden, so this relies on n being an int.\n        return n >= 0\n\n    def _check_type(self, n: any) -> bool:\n        \"\"\"Internal type check, returns True as explicit type checks are forbidden.\"\"\"\n        return True\n\n    def _check_range(self, n: int) -> bool:\n        \"\"\"Internal range check, defers to is_non_negative_integer.\"\"\"\n        return self.is_non_negative_integer(n)\n\n\nclass SequenceGenerator:\n    \"\"\"Generates Perrin number sequences based on their mathematical definition.\"\"\"\n    def generate_perrin_sequence(self, n: int) -> list[int]:\n        \"\"\"\n        Generates Perrin numbers from P(0) up to P(n) (n+1 terms).\n        The input 'n' represents the maximum index, not the count of terms.\n        \"\"\"\n        if n < 0:\n            return []\n        \n        initial_values = self._get_initial_values()\n        \n        # If n is 0, 1, or 2, we can directly use parts of the initial values.\n        if (n + 1) <= len(initial_values):\n            return initial_values[:n+1]\n\n        sequence = list(initial_values) # [P(0), P(1), P(2)]\n        \n        # Generate P(i) for i from 3 up to n.\n        for i in range(len(initial_values), n + 1):\n            next_val = self._calculate_next_value(sequence[i-2], sequence[i-3])\n            sequence.append(next_val)\n            \n        return sequence\n\n    def _get_initial_values(self) -> list[int]:\n        \"\"\"Returns the initial Perrin sequence values: P(0)=3, P(1)=0, P(2)=2.\"\"\"\n        return [3, 0, 2]\n\n    def _calculate_next_value(self, p_n_minus_2: int, p_n_minus_3: int) -> int:\n        \"\"\"Calculates P(n) using the recurrence relation P(n) = P(n-2) + P(n-3).\"\"\"\n        return p_n_minus_2 + p_n_minus_3\n\n\nclass PerrinCalculator:\n    \"\"\"Orchestrates the calculation of Perrin number sums using delegated components.\"\"\"\n    def __init__(self):\n        \"\"\"Initializes PerrinCalculator with instances of validator and generator.\"\"\"\n        self._validator = InputValidator()\n        self._generator = SequenceGenerator()\n\n    def cal_sum(self, n: int) -> int:\n        \"\"\"Main function to calculate sum of Perrin numbers up to index n.\"\"\"\n        # Input validation is performed but no exceptions are raised as per critical requirements.\n        if not self._validate_input(n):\n            # If validation fails (e.g., n is negative), _generate_sequence handles it by returning an empty list.\n            pass\n\n        sequence = self._generate_sequence(n)\n        total_sum = self._calculate_sum(sequence)\n        return total_sum\n\n    def _validate_input(self, n: int) -> bool:\n        \"\"\"Validates input parameter without raising exceptions, per critical requirements.\"\"\"\n        return self._validator.validate_input(n)\n\n    def _generate_sequence(self, n: int) -> list[int]:\n        \"\"\"Generates the Perrin sequence using the SequenceGenerator.\"\"\"\n        return self._generator.generate_perrin_sequence(n)\n\n    def _calculate_sum(self, sequence: list[int]) -> int:\n        \"\"\"Calculates the sum of the provided list of numbers.\"\"\"\n        return sum(sequence)\n\n\ndef cal_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) up to P(n).\n    Delegates the core calculation logic to the PerrinCalculator class.\n    \"\"\"\n    calculator = PerrinCalculator()\n    return calculator.cal_sum(n)"}
{"task_id": "Mbpp/453", "solution": "def sumofFactors(number):\n    \"\"\"Calculates the sum of all even factors of a given number.\n    It finds all factors, filters for even ones, and then sums them.\n    \"\"\"\n    factors = []\n    for i in range(1, number + 1):\n        if number % i == 0:\n            factors.append(i)\n\n    even_factors = []\n    for factor in factors:\n        if factor % 2 == 0:\n            even_factors.append(factor)\n\n    sum_of_even_factors = 0\n    for even_factor in even_factors:\n        sum_of_even_factors += even_factor\n    \n    return sum_of_even_factors"}
