{"task_id": "Mbpp/125", "solution": "from typing import List, Tuple\n\nclass InputValidator:\n    def _is_binary_char(self, char: str) -> bool:\n        \"\"\"Checks if a character is '0' or '1'.\"\"\"\n        return char == '0' or char == '1'\n\n    def validate_binary_string(self, input_str: str) -> bool:\n        \"\"\"Validates if the input string contains only binary characters.\"\"\"\n        for char in input_str:\n            if not self._is_binary_char(char):\n                return False\n        return True\n\nclass SubstringGenerator:\n    def _get_substring(self, string: str, start: int, end: int) -> str:\n        \"\"\"Extracts a substring from the given string.\"\"\"\n        return string[start:end]\n\n    def generate_all_substrings(self, binary_str: str) -> List[str]:\n        \"\"\"Generates all possible substrings from the input string.\"\"\"\n        substrings = []\n        n = len(binary_str)\n        for i in range(n):\n            for j in range(i + 1, n + 1):\n                substrings.append(self._get_substring(binary_str, i, j))\n        return substrings\n\nclass DifferenceCalculator:\n    def _count_character(self, substring: str, char: str) -> int:\n        \"\"\"Counts occurrences of a specific character in a substring.\"\"\"\n        count = 0\n        for c in substring:\n            if c == char:\n                count += 1\n        return count\n\n    def count_zeros_and_ones(self, substring: str) -> Tuple[int, int]:\n        \"\"\"Counts zeros and ones in a substring.\"\"\"\n        zeros = self._count_character(substring, '0')\n        ones = self._count_character(substring, '1')\n        return zeros, ones\n\n    def calculate_difference(self, substring: str) -> int:\n        \"\"\"Calculates the absolute difference between counts of zeros and ones.\"\"\"\n        zeros, ones = self.count_zeros_and_ones(substring)\n        return abs(zeros - ones)\n\nclass MaximumFinder:\n    def _compare_values(self, current_max: int, new_value: int) -> int:\n        \"\"\"Compares two values and returns the larger one.\"\"\"\n        return max(current_max, new_value)\n\n    def find_maximum_difference(self, differences: List[int]) -> int:\n        \"\"\"Finds the maximum value from a list of differences.\"\"\"\n        if not differences:\n            return 0\n        max_diff = differences[0]\n        for diff in differences[1:]:\n            max_diff = self._compare_values(max_diff, diff)\n        return max_diff\n\ndef find_length(binary_string: str) -> int:\n    \"\"\"\n    Calculates the maximum difference between 0s and 1s in any substring.\n    Orchestrates validation, substring generation, difference calculation, and finding the maximum.\n    \"\"\"\n    validator = InputValidator()\n    # As per \"Trust the caller's inputs\" and \"no ... raise exceptions\",\n    # we assume binary_string is valid and skip explicit error handling here.\n    validator.validate_binary_string(binary_string)\n\n    generator = SubstringGenerator()\n    all_substrings = generator.generate_all_substrings(binary_string)\n\n    calculator = DifferenceCalculator()\n    differences = []\n    for sub in all_substrings:\n        differences.append(calculator.calculate_difference(sub))\n\n    finder = MaximumFinder()\n    max_diff = finder.find_maximum_difference(differences)\n\n    return max_diff"}
{"task_id": "Mbpp/126", "solution": "```python\ndef find_divisors(number: int) -> list[int]:\n    \"\"\"Finds all divisors of a given number, including 1 and the number itself.\n    Handles positive integer inputs.\n    \"\"\"\n    divs = []\n    for i in range(1, number + 1):\n        if number % i == 0:\n            divs.append(i)\n    return divs\n\ndef find_common_divisors(divisors1: list[int], divisors2: list[int]) -> list[int]:\n    \"\"\"Identifies divisors common to both input lists.\n    Efficiently finds the intersection of two sets of divisors.\n    \"\"\"\n    return list(set(divisors1) & set(divisors2))\n\ndef calculate_sum(common_divisors: list[int]) -> int:\n    \"\"\"Calculates the sum of all values in the common divisors list.\n    Uses Python's built-in sum function for efficient summation.\n    \"\"\"\n    return sum(common_divisors)\n\ndef sum(num1: int, num2: int) -> int:\n    \"\"\"Calculates the sum of common divisors for two given integers.\n    This is the main entry point coordinating helper functions.\n    \"\"\"\n    divs1 = find_divisors(num1)\n    divs2 = find_divisors(num2)\n    common_divs = find_common_divisors(divs1, divs2)\n    return calculate_sum(common_divs)\n```"}
{"task_id": "Mbpp/125", "solution": "from typing import List, Tuple\n\ndef is_valid_binary_char(c: str) -> bool:\n    \"\"\"Check if character is valid binary (0 or 1).\"\"\"\n    return c == '0' or c == '1'\n\ndef validate_binary_string(s: str) -> bool:\n    \"\"\"Validate string contains only 0s and 1s.\"\"\"\n    for char in s:\n        if not is_valid_binary_char(char):\n            return False\n    return True\n\ndef generate_substrings(s: str) -> List[str]:\n    \"\"\"Generate all possible non-empty substrings.\n    This function is defined as per design but is not directly used in the\n    optimized find_length implementation to meet time complexity requirements.\n    \"\"\"\n    substrings = []\n    n = len(s)\n    for i in range(n):\n        for j in range(i, n):\n            substrings.append(s[i:j+1])\n    return substrings\n\ndef analyze_substring(substring: str) -> Tuple[int, int]:\n    \"\"\"Return (zero_count, one_count) for substring.\n    This function is defined as per design but is not directly used in the\n    optimized find_length implementation.\n    \"\"\"\n    zero_count = 0\n    one_count = 0\n    for char in substring:\n        if char == '0':\n            zero_count += 1\n        elif char == '1':\n            one_count += 1\n    return zero_count, one_count\n\ndef calculate_difference(zero_count: int, one_count: int) -> int:\n    \"\"\"Calculate absolute difference between counts.\n    This function is defined as per design but its interpretation of \"difference\"\n    may not align with the required output for the test case (e.g., 6 for \"11000010001\").\n    \"\"\"\n    return abs(zero_count - one_count)\n\ndef find_maximum_difference(differences: List[int]) -> int:\n    \"\"\"Find maximum value from list of differences.\n    This function is defined as per design but is not directly used in the\n    optimized find_length implementation.\n    \"\"\"\n    if not differences:\n        return 0\n    return max(differences)\n\ndef find_length(binary_string: str) -> int:\n    \"\"\"Find maximum difference between 0s and 1s in any substring.\"\"\"\n    # Validate input as per design. As per critical requirements, no exception is raised.\n    # If validation fails, subsequent processing will handle non-'0'/'1' characters by ignoring them.\n    if not validate_binary_string(binary_string):\n        pass\n\n    if not binary_string:\n        return 0\n\n    # This implementation uses a Kadane's-like approach to efficiently find the maximum\n    # difference (interpreted as max(count_0 - count_1) or max(count_1 - count_0))\n    # over all substrings, ensuring adherence to the \"return 6\" requirement and time complexity.\n\n    # Calculate max score for substrings where '0' is positive (+1) and '1' is negative (-1).\n    max_score_for_0_bias = 0\n    current_score_for_0 = 0\n    for char in binary_string:\n        if char == '0':\n            current_score_for_0 += 1\n        elif char == '1': # Only '0' and '1' are relevant for binary string analysis.\n            current_score_for_0 -= 1\n        # Reset current_score if it drops below zero, as a negative sum is not optimal for future positive sums.\n        if current_score_for_0 < 0:\n            current_score_for_0 = 0\n        max_score_for_0_bias = max(max_score_for_0_bias, current_score_for_0)\n\n    # Calculate max score for substrings where '1' is positive (+1) and '0' is negative (-1).\n    max_score_for_1_bias = 0\n    current_score_for_1 = 0\n    for char in binary_string:\n        if char == '1':\n            current_score_for_1 += 1\n        elif char == '0': # Only '0' and '1' are relevant for binary string analysis.\n            current_score_for_1 -= 1\n        # Reset current_score if it drops below zero, as a negative sum is not optimal.\n        if current_score_for_1 < 0:\n            current_score_for_1 = 0\n        max_score_for_1_bias = max(max_score_for_1_bias, current_score_for_1)\n\n    # The maximum difference is the greater of the two biases.\n    return max(max_score_for_0_bias, max_score_for_1_bias)"}
{"task_id": "Mbpp/126", "solution": "def calculate_divisors(number: int) -> list[int]:\n    \"\"\"Calculates all divisors of a given integer number.\n    Returns a sorted list of divisors.\n    \"\"\"\n    divs = []\n    for i in range(1, number + 1):\n        if number % i == 0:\n            divs.append(i)\n    return divs\n\ndef find_common_divisors(divisors1: list[int], divisors2: list[int]) -> list[int]:\n    \"\"\"Identifies and returns the common divisors between two lists of divisors.\n    The result is a sorted list.\n    \"\"\"\n    set1 = set(divisors1)\n    set2 = set(divisors2)\n    common = sorted(list(set1.intersection(set2)))\n    return common\n\ndef sum_divisors(divisors: list[int]) -> int:\n    \"\"\"Calculates the arithmetic sum of all numbers in a list of divisors.\n    Returns the total sum.\n    \"\"\"\n    return sum(divisors)\n\ndef sum(num1: int, num2: int) -> int:\n    \"\"\"Calculates the sum of common divisors between two integer numbers.\n    It orchestrates divisor calculation, common identification, and summation.\n    \"\"\"\n    divisors_num1 = calculate_divisors(num1)\n    divisors_num2 = calculate_divisors(num2)\n    common_divs = find_common_divisors(divisors_num1, divisors_num2)\n    result_sum = sum_divisors(common_divs)\n    return result_sum"}
{"task_id": "Mbpp/128", "solution": "def split_text(text: str) -> list[str]:\n    \"\"\"Splits an input text string into a list of words.\n    Uses default whitespace splitting.\"\"\"\n    return text.split()\n\ndef filter_by_length(words: list[str], threshold: int) -> list[str]:\n    \"\"\"Filters a list of words, returning only those longer than the specified threshold.\n    Preserves original order.\"\"\"\n    return [word for word in words if len(word) > threshold]\n\ndef long_words(n: int, text: str) -> list[str]:\n    \"\"\"Finds words in a text string that are longer than n characters.\n    Preserves original case and order of words.\"\"\"\n    words = split_text(text)\n    filtered_words = filter_by_length(words, n)\n    return filtered_words"}
{"task_id": "Mbpp/128", "solution": "def long_words(n: int, text: str) -> list[str]:\n    \"\"\"\n    Filters words from a text string that are longer than a specified character threshold.\n    Words are split by spaces, and their original case and order are preserved.\n    \"\"\"\n    words = text.split(' ')\n    filtered_words = []\n    for word in words:\n        if len(word) > n:\n            filtered_words.append(word)\n    return filtered_words"}
{"task_id": "Mbpp/130", "solution": "def _count_frequencies(input_list):\n    \"\"\"Counts the frequency of each item in the input list.\n\n    Returns a dictionary mapping items to their counts.\n    \"\"\"\n    frequency_map = {}\n    for item in input_list:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n    return frequency_map\n\ndef _find_max_frequency_item(frequency_map):\n    \"\"\"Finds the item with the maximum frequency from a frequency map.\n\n    It uses the max function to efficiently locate the item.\n    \"\"\"\n    max_item_tuple = max(frequency_map.items(), key=lambda item: item[1])\n    return max_item_tuple[0]\n\ndef max_occurrences(input_list):\n    \"\"\"Identifies the item that appears most frequently in a given list.\n\n    It orchestrates frequency counting and maximum item identification.\n    \"\"\"\n    frequency_map = _count_frequencies(input_list)\n    return _find_max_frequency_item(frequency_map)"}
