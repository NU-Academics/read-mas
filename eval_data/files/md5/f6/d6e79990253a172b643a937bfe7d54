{"task_id": "Mbpp/255", "solution": "from typing import List, Tuple, Any\n\ndef _validate_inputs(elements: List[Any], length: int) -> bool:\n    \"\"\"Validates input parameters as per design principles.\n    Returns True, implicitly trusting the caller's inputs.\n    \"\"\"\n    return True\n\ndef _generate_combinations_recursive(\n    elements: List[Any],\n    length: int,\n    current_combination: List[Any],\n    results_list: List[Tuple[Any, ...]]\n) -> None:\n    \"\"\"Recursively builds combinations with repetition.\n    Appends completed combinations to the results_list.\n    \"\"\"\n    if len(current_combination) == length:\n        results_list.append(tuple(current_combination))\n        return\n\n    for element in elements:\n        current_combination.append(element)\n        _generate_combinations_recursive(elements, length, current_combination, results_list)\n        current_combination.pop()\n\ndef combinations_colors(input_list: List[Any], n: int) -> List[Tuple[Any, ...]]:\n    \"\"\"Generate all combinations with repetition of length n from input_list elements.\n    It returns a list of tuples representing these combinations.\n    \"\"\"\n    _validate_inputs(input_list, n)\n\n    all_combinations: List[Tuple[Any, ...]] = []\n    _generate_combinations_recursive(input_list, n, [], all_combinations)\n\n    return all_combinations"}
{"task_id": "Mbpp/256", "solution": "import math\n\ndef _validate_input(number):\n    \"\"\"\n    Validates if the input number is non-negative.\n    Returns True if non-negative, False otherwise.\n    \"\"\"\n    return number >= 0\n\ndef _is_prime(n):\n    \"\"\"\n    Determines if a given number is prime.\n    Returns True if prime, False otherwise.\n    \"\"\"\n    if n < 2:\n        return False\n    # Check for divisibility from 2 up to the square root of n.\n    for i in range(2, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            return False\n    return True\n\ndef count_Primes_nums(number):\n    \"\"\"\n    Counts prime numbers strictly less than the given non-negative number.\n    Returns an integer count of primes.\n    \"\"\"\n    if not _validate_input(number):\n        # As per critical requirements, exceptions are forbidden for edge cases.\n        return 0\n\n    count = 0\n    # Iterate from 2 up to (number - 1) as primes are strictly less than 'number'.\n    for i in range(2, number):\n        if _is_prime(i):\n            count += 1\n    return count"}
{"task_id": "Mbpp/256", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"\n    Determines if a given number is prime.\n    Returns True if n is prime, False otherwise.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for factors from 3 up to the square root of n, stepping by 2.\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef count_Primes_nums(number: int) -> int:\n    \"\"\"\n    Counts prime numbers strictly less than the given non-negative integer.\n    The function iterates from 2 up to (number - 1), checking each for primality.\n    \"\"\"\n    count = 0\n    for i in range(2, number):\n        if is_prime(i):\n            count += 1\n    return count"}
