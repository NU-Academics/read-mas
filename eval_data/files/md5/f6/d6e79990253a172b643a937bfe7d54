{"task_id": "Mbpp/18", "solution": "```python\ndef _create_filter_set(filter_string: str) -> set:\n    \"\"\"Converts the filter string into a set of characters for efficient lookups.\"\"\"\n    return set(filter_string)\n\ndef _filter_characters(source_string: str, filter_set: set) -> str:\n    \"\"\"Filters characters from the source string, keeping those not in the filter set.\"\"\"\n    return \"\".join(char for char in source_string if char not in filter_set)\n\ndef remove_dirty_chars(source_string: str, filter_string: str) -> str:\n    \"\"\"\n    Removes all characters from the source_string that are present in the filter_string.\n    Preserves the order of remaining characters and performs case-sensitive matching.\n    \"\"\"\n    if not source_string:\n        return \"\"\n    \n    char_filter_set = _create_filter_set(filter_string)\n    return _filter_characters(source_string, char_filter_set)\n```"}
{"task_id": "Mbpp/18", "solution": "def _create_character_set(filter_string: str) -> set[str]:\n    \"\"\"Helper function to create a character set from a string for efficient lookup.\n    This set allows O(1) average-time complexity for checking character presence.\n    \"\"\"\n    return set(filter_string)\n\ndef remove_dirty_chars(source_string: str, filter_string: str) -> str:\n    \"\"\"Removes all characters from the source_string that are present in the filter_string.\n    It preserves the original order of the remaining characters and returns a new string.\n    \"\"\"\n    filter_set = _create_character_set(filter_string)\n    \n    result_chars = []\n    for char in source_string:\n        if char not in filter_set:\n            result_chars.append(char)\n            \n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/19", "solution": "```python\ndef _validate_input(array: list[int]) -> bool:\n    \"\"\"\n    Checks if the array is suitable for duplicate detection.\n    Returns False for empty or single-element arrays, as they cannot contain duplicates.\n    \"\"\"\n    return len(array) > 1\n\ndef _check_duplicates_with_set(array: list[int]) -> bool:\n    \"\"\"\n    Detects duplicates using a hash set for O(n) time complexity.\n    It iterates through the array, adding elements to a set and checking for existing ones.\n    \"\"\"\n    seen = set()\n    for item in array:\n        if item in seen:\n            return True\n        seen.add(item)\n    return False\n\ndef test_duplicate(array: list[int]) -> bool:\n    \"\"\"\n    Determines if a given array of integers contains any duplicate element.\n    It first validates the input length, then uses a hash set for efficient duplicate checking.\n    \"\"\"\n    if not _validate_input(array):\n        return False\n    return _check_duplicates_with_set(array)\n```"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"\n    Check if the given number is a Woodall number.\n\n    A Woodall number is of the form n \u00d7 2^n - 1 for some positive integer n.\n    \"\"\"\n    n = 1\n    while True:\n        current_woodall = n * (2**n) - 1\n        if current_woodall == number:\n            return True\n        # If calculated value exceeds input, no further n will match since the function grows monotonically.\n        elif current_woodall > number:\n            return False\n        n += 1"}
{"task_id": "Mbpp/56", "solution": "def reverse_number(number: int) -> int:\n    \"\"\"Calculates the reverse of a given number by reversing its digits.\n    Converts the number to a string, reverses it, and converts it back to an integer.\n    \"\"\"\n    return int(str(number)[::-1])\n\ndef validate_condition(original: int, twice_reverse: int) -> bool:\n    \"\"\"Checks if the original number equals one less than twice its reverse.\n    Performs a direct mathematical comparison.\n    \"\"\"\n    return original == twice_reverse - 1\n\ndef check(number: int) -> bool:\n    \"\"\"Validates if a given number is one less than twice its reverse.\n    Orchestrates the reversal and condition validation steps.\n    \"\"\"\n    reversed_num = reverse_number(number)\n    twice_reversed_num = reversed_num * 2\n    return validate_condition(number, twice_reversed_num)"}
{"task_id": "Mbpp/20", "solution": "def _calculate_woodall(n: int) -> int:\n    \"\"\"Calculates the Woodall number for a given positive integer n.\n    The formula is n * 2^n - 1.\"\"\"\n    return n * (2**n) - 1\n\ndef _validate_input(number: int) -> bool:\n    \"\"\"Validates if the input number is a positive integer.\n    Woodall numbers are defined for positive integer n, implying the result is positive.\"\"\"\n    return number > 0\n\ndef is_woodall(number: int) -> bool:\n    \"\"\"Determines if the given number is a Woodall number.\n    A Woodall number is of the form n * 2^n - 1 for a positive integer n.\"\"\"\n    if not _validate_input(number):\n        return False\n\n    n = 1\n    while True:\n        woodall_candidate = _calculate_woodall(n)\n        if woodall_candidate == number:\n            return True\n        if woodall_candidate > number:\n            # Woodall numbers are strictly increasing with n, so if we've passed the target, it's not a Woodall number.\n            return False\n        n += 1"}
{"task_id": "Mbpp/56", "solution": "def reverse_number(number: int) -> int:\n    \"\"\"Reverses the digits of an integer number.\"\"\"\n    return int(str(number)[::-1])\n\ndef validate_condition(original: int, reversed: int) -> bool:\n    \"\"\"Checks if the original number satisfies the validation condition.\"\"\"\n    return original == (2 * reversed) - 1\n\ndef check(number: int) -> bool:\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    This function coordinates digit reversal and mathematical validation.\n    \"\"\"\n    reversed_num = reverse_number(number)\n    return validate_condition(number, reversed_num)"}
{"task_id": "Mbpp/57", "solution": "def _validate_input(digits: list) -> bool:\n    \"\"\"Validates the input list of digits.\n    Per critical requirements, this function trusts the caller's inputs.\n    \"\"\"\n    return True\n\ndef _sort_digits_descending(digits: list) -> list:\n    \"\"\"Sorts a list of digits in descending order.\"\"\"\n    return sorted(digits, reverse=True)\n\ndef _convert_to_integer(sorted_digits: list) -> int:\n    \"\"\"Converts a list of sorted digits into a single integer.\"\"\"\n    return int(\"\".join(map(str, sorted_digits)))\n\ndef find_Max_Num(digits: list) -> int:\n    \"\"\"\n    Finds the largest number that can be formed from a given list of digits.\n    It arranges digits in descending order and converts them into an integer.\n    \"\"\"\n    _validate_input(digits)\n    sorted_digits = _sort_digits_descending(digits)\n    max_num = _convert_to_integer(sorted_digits)\n    return max_num"}
{"task_id": "Mbpp/58", "solution": "def _is_positive(num: int) -> bool:\n    \"\"\"Checks if an integer is positive.\"\"\"\n    return num > 0\n\ndef _is_negative(num: int) -> bool:\n    \"\"\"Checks if an integer is negative.\"\"\"\n    return num < 0\n\ndef _is_zero(num: int) -> bool:\n    \"\"\"Checks if an integer is zero.\"\"\"\n    return num == 0\n\ndef opposite_Signs(a: int, b: int) -> bool:\n    \"\"\"\n    Determines if two integers have opposite signs, treating zero as neither positive nor negative.\n    Returns True if one is positive and the other is negative, False otherwise.\n    \"\"\"\n    if _is_zero(a) or _is_zero(b):\n        return False\n    \n    return (_is_positive(a) and _is_negative(b)) or \\\n           (_is_negative(a) and _is_positive(b))"}
{"task_id": "Mbpp/58", "solution": "```python\ndef opposite_Signs(int1: int, int2: int) -> bool:\n    \"\"\"\n    Check whether two integers have opposite signs.\n    Returns True if integers have opposite signs, False otherwise.\n    \"\"\"\n    return (int1 > 0 and int2 < 0) or (int1 < 0 and int2 > 0)\n```"}
