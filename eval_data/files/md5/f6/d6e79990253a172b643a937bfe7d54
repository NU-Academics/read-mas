{"task_id": "Mbpp/759", "solution": "def _count_decimal_places(input_string: str) -> int:\n    \"\"\"Counts number of digits after the decimal point.\n    Returns 0 if no decimal point is found.\"\"\"\n    if '.' in input_string:\n        # Split by '.' and return the length of the second part.\n        # This handles '123.' correctly as len('') is 0.\n        parts = input_string.split('.')\n        return len(parts[1])\n    return 0\n\ndef _validate_format(input_string: str) -> bool:\n    \"\"\"Validates string contains only digits and exactly one decimal point.\n    Both parts around the decimal must be non-empty and consist only of digits.\"\"\"\n    if not input_string:\n        return False\n    \n    if input_string.count('.') != 1:\n        return False\n    \n    parts = input_string.split('.')\n    integer_part = parts[0]\n    fractional_part = parts[1]\n    \n    # Both parts must be non-empty and consist of digits.\n    if not integer_part.isdigit() or not fractional_part.isdigit():\n        return False\n        \n    return True\n\ndef _check_precision(input_string: str) -> bool:\n    \"\"\"Checks if string has exactly 2 decimal places.\n    Relies on _count_decimal_places to get the count.\"\"\"\n    return _count_decimal_places(input_string) == 2\n\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"Main validation function for decimal strings with exactly 2 decimal places.\n    Orchestrates format and precision checks according to requirements.\"\"\"\n    if not _validate_format(input_string):\n        return False\n    \n    if not _check_precision(input_string):\n        return False\n        \n    return True"}
{"task_id": "Mbpp/762", "solution": "def _is_valid_month(month_number: int) -> bool:\n    \"\"\"Validate month number is in range 1-12.\n    Returns True if the month number is valid, False otherwise.\n    \"\"\"\n    return 1 <= month_number <= 12\n\ndef _has_thirty_days(month_number: int) -> bool:\n    \"\"\"Check if a given month number has exactly 30 days.\n    This function expects a valid month number (1-12).\n    \"\"\"\n    return month_number in (4, 6, 9, 11)\n\ndef check_monthnumber_number(month_number: int) -> bool:\n    \"\"\"Check if given month number has exactly 30 days.\n    Returns True if the month has 30 days, False otherwise (including invalid input).\n    \"\"\"\n    if not _is_valid_month(month_number):\n        return False\n\n    return _has_thirty_days(month_number)"}
{"task_id": "Mbpp/763", "solution": "def _calculate_absolute_difference(a, b):\n    \"\"\"Calculates the absolute difference between two numbers.\n    This helper function ensures the result is always non-negative.\"\"\"\n    return abs(a - b)\n\ndef _find_minimum_difference(differences):\n    \"\"\"Finds the smallest value within a given list of differences.\n    It assumes the list is non-empty for a valid minimum.\"\"\"\n    return min(differences)\n\ndef find_min_diff(array, length):\n    \"\"\"Calculates the minimum absolute difference between any two distinct elements in an array.\n    It iterates through all unique pairs to find the smallest difference.\"\"\"\n    \n    all_differences = []\n\n    # Iterate through all possible unique pairs of elements\n    for i in range(length):\n        for j in range(i + 1, length): # Ensures distinct elements and avoids duplicate pairs\n            diff = _calculate_absolute_difference(array[i], array[j])\n            all_differences.append(diff)\n            \n    # Find the minimum from the collected differences\n    min_overall_diff = _find_minimum_difference(all_differences)\n    \n    return min_overall_diff"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(array, length):\n    \"\"\"\n    Calculates the minimum absolute difference between any two distinct elements in an array.\n    This function first sorts the array to optimize difference calculation.\n    \"\"\"\n    \n    # Sort the array to ensure that the minimum difference will be between adjacent elements.\n    sorted_array = sorted(array)\n    \n    # Initialize minimum difference to a very large value.\n    min_difference = float('inf')\n    \n    # Iterate through the sorted array, comparing adjacent elements.\n    for i in range(length - 1):\n        current_diff = abs(sorted_array[i+1] - sorted_array[i])\n        if current_diff < min_difference:\n            min_difference = current_diff\n            \n    return min_difference"}
