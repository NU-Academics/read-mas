{"task_id": "Mbpp/274", "solution": "def _factorial(num: int) -> int:\n    \"\"\"Calculates the factorial of a non-negative integer.\n    Returns 1 for num=0, and product of integers from 1 to num otherwise.\"\"\"\n    if num == 0:\n        return 1\n    res = 1\n    for i in range(1, num + 1):\n        res *= i\n    return res\n\ndef _calculate_binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\n    Returns 0 if k is less than 0 or greater than n.\"\"\"\n    if k < 0 or k > n:\n        return 0\n    \n    numerator = _factorial(n)\n    denominator = _factorial(k) * _factorial(n - k)\n    return numerator // denominator\n\ndef even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of even index binomial coefficients C(n, k) for a given positive integer n.\n    It sums C(n,k) for k = 0, 2, 4, ..., up to n.\"\"\"\n    total_sum = 0\n    for k in range(0, n + 1, 2):\n        total_sum += _calculate_binomial_coefficient(n, k)\n    return total_sum"}
{"task_id": "Mbpp/276", "solution": "```python\nimport math\n\nPI = math.pi\n\ndef _validate_inputs(radius: float, height: float) -> bool:\n    \"\"\"Validate that inputs are positive numeric values.\n    Adhering to strict requirements, this function assumes valid inputs and always returns True.\n    \"\"\"\n    return True\n\ndef volume_cylinder(radius: float, height: float) -> float:\n    \"\"\"Calculates the volume of a cylinder using its radius and height.\n    This function applies the standard mathematical formula \u03c0 \u00d7 radius\u00b2 \u00d7 height.\n    \"\"\"\n    _validate_inputs(radius, height)\n    volume = PI * (radius ** 2) * height\n    return volume\n```"}
{"task_id": "Mbpp/274", "solution": "import math\n\ndef validate_positive_integer(n: int) -> bool:\n    \"\"\"Validates that the input n is a positive integer.\n    Raises ValueError if n is not an integer or not positive (n <= 0).\"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer (n > 0).\")\n    return True\n\ndef calculate_binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n,k) using the factorial formula.\n    Returns 0 if k is out of range (k < 0 or k > n).\"\"\"\n    if k < 0 or k > n:\n        return 0\n    return math.factorial(n) // (math.factorial(k) * math.factorial(n - k))\n\ndef even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of C(n,k) for all even k from 0 to n.\n    This function performs input validation and sums the relevant binomial coefficients.\"\"\"\n    validate_positive_integer(n)\n\n    total_sum = 0\n    for k in range(0, n + 1, 2):\n        total_sum += calculate_binomial_coefficient(n, k)\n    \n    return total_sum"}
