{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix):\n    \"\"\"\n    Sorts a matrix by the sum of its rows in ascending order.\n    Uses the built-in sort with a custom key for efficiency.\n    \"\"\"\n    # Create a list of tuples where each tuple contains (row, sum_of_row)\n    # This associates each row with its sum for sorting purposes.\n    row_sum_pairs = []\n    for row in matrix:\n        row_sum_pairs.append((row, sum(row)))\n\n    # Sort the list of (row, sum_of_row) tuples based on the sum (the second element of the tuple).\n    # The default sort is ascending.\n    row_sum_pairs.sort(key=lambda x: x[1])\n\n    # Extract the sorted rows from the sorted pairs.\n    sorted_matrix = [pair[0] for pair in row_sum_pairs]\n\n    return sorted_matrix"}
{"task_id": "Mbpp/16", "solution": "def text_lowercase_underscore(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters\n    joined with an underscore.\n    \"\"\"\n\n    def _is_lowercase_letter(char: str) -> bool:\n        \"\"\"Checks if a character is a lowercase letter.\"\"\"\n        return 'a' <= char <= 'z'\n\n    def _validate_pattern_logic(text: str) -> bool:\n        \"\"\"Core logic to validate the pattern of lowercase letters and underscores.\"\"\"\n        if '_' not in text:\n            return False\n\n        parts = text.split('_')\n\n        for part in parts:\n            if not part:  # Sequences of letters cannot be empty\n                return False\n            for char in part:\n                if not _is_lowercase_letter(char):\n                    return False\n        return True\n\n    return _validate_pattern_logic(input_string)"}
{"task_id": "Mbpp/56", "solution": "def check(number: int) -> bool:\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    Uses a helper function to reverse the digits of the number.\n    \"\"\"\n    def _reverse_digits(num: int) -> int:\n        \"\"\"Helper function to reverse the digits of a number.\"\"\"\n        return int(str(num)[::-1])\n\n    reversed_num = _reverse_digits(number)\n    return number == (2 * reversed_num - 1)"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(source_string: str, filter_string: str) -> str:\n    \"\"\"\n    Removes characters from the source_string that are present in the filter_string.\n    Utilizes a set for efficient character lookup.\n    \"\"\"\n    # Create a set of characters from the filter_string for O(1) average time complexity lookup.\n    filter_set = set(filter_string)\n\n    # Build the result string by including only characters not in the filter_set.\n    result_chars = []\n    for char in source_string:\n        if char not in filter_set:\n            result_chars.append(char)\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number.\n    A Woodall number is of the form n * 2^n - 1 for a positive integer n.\n    \"\"\"\n    if number <= 0:\n        return False\n\n    # Iterate through possible values of n\n    # n * 2^n - 1 grows very fast.\n    # For n=1, W_1 = 1*2^1 - 1 = 1\n    # For n=2, W_2 = 2*2^2 - 1 = 7\n    # For n=3, W_3 = 3*2^3 - 1 = 23\n    # For n=4, W_4 = 4*2^4 - 1 = 63\n    # For n=5, W_5 = 5*2^5 - 1 = 159\n    # For n=6, W_6 = 6*2^6 - 1 = 383\n    # For n=7, W_7 = 7*2^7 - 1 = 895\n    # Since number is positive, n must be positive.\n    # We can stop when the calculated Woodall number exceeds the input number.\n    n = 1\n    while True:\n        woodall_candidate = n * (1 << n) - 1 # Use bit shift for 2^n for performance\n\n        if woodall_candidate == number:\n            return True\n        elif woodall_candidate > number:\n            return False # No need to check further, Woodall numbers grow monotonically\n        \n        n += 1"}
{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits: list) -> int:\n    \"\"\"\n    Find the largest number that can be formed with the given list of digits.\n    The function sorts the digits in descending order and concatenates them to form the largest number.\n    \"\"\"\n    if not all(isinstance(d, int) and 0 <= d <= 9 for d in digits):\n        raise ValueError(\"Input must be a list of single integer digits (0-9).\")\n    \n    # Sort digits in descending order to form the largest number\n    sorted_digits = sorted(digits, reverse=True)\n    \n    # Convert sorted digits to strings and concatenate them\n    num_str = \"\".join(str(d) for d in sorted_digits)\n    \n    # Convert the resulting string back to an integer\n    return int(num_str)"}
