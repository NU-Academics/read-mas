{"task_id": "Mbpp/2", "solution": "def similar_elements(collection1, collection2):\n    \"\"\"\n    Finds the shared elements between two given collections.\n    Converts inputs to sets to efficiently compute their intersection.\n    \"\"\"\n    set1 = set(collection1)\n    set2 = set(collection2)\n    intersection = set1 & set2\n    return list(intersection)"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two numbers differ at exactly one bit position.\n    It uses XOR to find differing bits and then counts the set bits in the result.\n    \"\"\"\n    xor_result = num1 ^ num2\n\n    # Helper function to count set bits using Brian Kernighan's algorithm\n    def _count_set_bits(n: int) -> int:\n        count = 0\n        while n > 0:\n            n &= (n - 1)  # Clear the least significant set bit\n            count += 1\n        return count\n\n    return _count_set_bits(xor_result) == 1"}
{"task_id": "Mbpp/7", "solution": "def find_char_long(input_string: str) -> list:\n    \"\"\"Finds words that are at least 4 characters long in a string.\"\"\"\n    words = input_string.split()\n    long_words = []\n    for word in words:\n        if len(word) >= 4:\n            long_words.append(word)\n    return long_words"}
{"task_id": "Mbpp/8", "solution": "def square_nums(input_list):\n    \"\"\"\n    Calculates the square of each individual element in a list.\n    Returns a new list with squared values, preserving element order.\n    \"\"\"\n    return [num * num for num in input_list]"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(number: int | float) -> bool:\n    \"\"\"\n    Determines if a given number is not prime.\n    Returns True for non-prime (composite, 1, or less than 1), False for prime.\n    \"\"\"\n    if number < 2:\n        return True  # Numbers less than 2 are not prime (and 1 is not prime)\n    if number == 2:\n        return False  # 2 is the only even prime number\n    if number % 1 != 0:\n        return True # Floats are not prime\n    if number % 2 == 0:\n        return True  # Even numbers greater than 2 are not prime\n\n    # Check for divisors from 3 up to sqrt(number)\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return True\n        i += 2\n    return False"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List, Union\n\ndef heap_queue_largest(numbers: List[Union[int, float]], n: int) -> List[Union[int, float]]:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n    Utilizes the heapq module for efficient extraction of the largest elements.\n    \"\"\"\n    return heapq.nlargest(n, numbers)"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    \"\"\"\n    if not s:\n        return 1  # Handle empty string as per \"greater than 0\" rotations.\n    return (s + s).find(s, 1)"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, character: str) -> str:\n    \"\"\"\n    Remove first and last occurrence of specified character from string.\n\n    Args:\n        input_string (str): The string to process\n        character (str): The character to remove\n\n    Returns:\n        str: Modified string with first and last occurrences removed\n    \"\"\"\n    first_idx = input_string.find(character)\n\n    # If the character is not found, return the original string\n    if first_idx == -1:\n        return input_string\n\n    last_idx = input_string.rfind(character)\n\n    # If first and last occurrences are at the same position, there's only one occurrence\n    if first_idx == last_idx:\n        return input_string[:first_idx] + input_string[first_idx+1:]\n    else:\n        # Remove both the first and last occurrences\n        # Construct the new string by skipping characters at first_idx and last_idx\n        result_chars = []\n        for i, char in enumerate(input_string):\n            if i != first_idx and i != last_idx:\n                result_chars.append(char)\n        return \"\".join(result_chars)"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(param1, param2, param3):\n    \"\"\"\n    Calculates the volume of a triangular prism.\n    The parameters represent the base, height of the triangular face, and the length of the prism.\n    \"\"\"\n    return 0.5 * param1 * param2 * param3"}
