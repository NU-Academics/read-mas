{"task_id": "HumanEval/139", "solution": "```python\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    def _factorial(k):\n        \"\"\"Calculates the factorial of a non-negative integer k.\"\"\"\n        if k == 0 or k == 1:\n            return 1\n        result = 1\n        for i in range(2, k + 1):\n            result *= i\n        return result\n\n    special_fact_result = 1\n    for i in range(1, n + 1):\n        special_fact_result *= _factorial(i)\n    return special_fact_result\n```"}
{"task_id": "HumanEval/132", "solution": "```python\ndef is_nested(string):\n    '''\n    Checks if the string contains a valid subsequence of brackets '[[ ]]',\n    where at least one bracket is nested.\n    '''\n    open_found = 0\n    close_found = 0\n\n    for char in string:\n        if char == '[':\n            if open_found < 2:\n                open_found += 1\n        elif char == ']':\n            if open_found == 2: # We have found at least two opening brackets\n                if close_found < 2:\n                    close_found += 1\n                    if close_found == 2: # We have found the complete '[[ ]]' subsequence\n                        return True\n    return False\n```"}
{"task_id": "HumanEval/140", "solution": "```python\nimport re\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n    \"\"\"\n    # First, replace all sequences of three or more consecutive spaces with a single hyphen.\n    # This ensures that longer sequences are handled before single spaces.\n    text_processed = re.sub(r' {3,}', '-', text)\n\n    # Second, replace any remaining single space characters with an underscore.\n    # This covers individual spaces and sequences of two spaces.\n    text_processed = re.sub(r' ', '_', text_processed)\n\n    return text_processed\n```"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Represents a fraction with a numerator and a denominator.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    @staticmethod\n    def from_string(fraction_str: str) -> 'Fraction':\n        \"\"\"Parses a string \"num/den\" into a Fraction object.\"\"\"\n        num_str, den_str = fraction_str.split('/')\n        return Fraction(int(num_str), int(den_str))\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another fraction.\"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Determines if the fraction represents a whole number.\"\"\"\n        return self.numerator % self.denominator == 0\n\ndef simplify(x, n):\n    \"\"\"Simplifies the expression x * n and returns True if it's a whole number.\"\"\"\n    fraction_x = Fraction.from_string(x)\n    fraction_n = Fraction.from_string(n)\n    product_fraction = fraction_x.multiply(fraction_n)\n    return product_fraction.is_whole_number()"}
{"task_id": "HumanEval/141", "solution": "class ValidityStatus:\n    YES = 'Yes'\n    NO = 'No'\n\nclass FileExtension:\n    _allowed_types = {'txt', 'exe', 'dll'}\n\n    @staticmethod\n    def is_valid_extension(suffix: str) -> bool:\n        return suffix in FileExtension._allowed_types\n\nclass FileName:\n    def __init__(self, name_string: str):\n        self._name_string = name_string\n        self._prefix = ''\n        self._suffix = ''\n        self._digit_count = sum(1 for char in name_string if char.isdigit())\n        self._dot_count = name_string.count('.')\n        self._parse_name_components()\n\n    def _parse_name_components(self):\n        if self._dot_count == 1:\n            parts = self._name_string.split('.', 1)\n            self._prefix = parts[0]\n            self._suffix = parts[1]\n            if self._prefix:\n                self._first_char_of_prefix = self._prefix[0]\n            else:\n                self._first_char_of_prefix = ''\n        else:\n            self._prefix = self._name_string\n            self._suffix = ''\n            if self._prefix:\n                self._first_char_of_prefix = self._prefix[0]\n            else:\n                self._first_char_of_prefix = ''\n\n    def is_valid(self) -> bool:\n        # Aggregates all individual validation checks.\n        return (\n            self._check_digit_count() and\n            self._check_dot_count() and\n            self._check_prefix_not_empty() and\n            self._check_prefix_starts_with_letter() and\n            self._check_suffix_type()\n        )\n\n    def _check_digit_count(self) -> bool:\n        # Checks if there are no more than three digits.\n        return self._digit_count <= 3\n\n    def _check_dot_count(self) -> bool:\n        # Checks if there is exactly one dot.\n        return self._dot_count == 1\n\n    def _check_prefix_not_empty(self) -> bool:\n        # Checks if the substring before the dot is not empty.\n        if not self._check_dot_count():\n            return False\n        return bool(self._prefix)\n\n    def _check_prefix_starts_with_letter(self) -> bool:\n        # Checks if the substring before the dot starts with a latin alphabet letter.\n        if not self._check_dot_count() or not self._check_prefix_not_empty():\n            return False\n        return self._first_char_of_prefix.isalpha()\n\n    def _check_suffix_type(self) -> bool:\n        # Checks if the substring after the dot is an allowed extension.\n        if not self._check_dot_count():\n            return False\n        return FileExtension.is_valid_extension(self._suffix)\n\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions\n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from\n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    file_obj = FileName(file_name)\n    if file_obj.is_valid():\n        return ValidityStatus.YES\n    else:\n        return ValidityStatus.NO"}
{"task_id": "HumanEval/143", "solution": "```python\ndef words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, returning only those whose lengths are prime numbers.\n    The order of words is maintained, and they are separated by a single space.\n    \"\"\"\n\n    def _is_prime(number: int) -> bool:\n        \"\"\"\n        Checks if a given number is a prime number.\n        \"\"\"\n        if number < 2:\n            return False\n        for i in range(2, int(number**0.5) + 1):\n            if number % i == 0:\n                return False\n        return True\n\n    words = sentence.split(' ')\n    filtered_words = []\n\n    for word in words:\n        if not word:  # Handle multiple spaces between words\n            continue\n        word_length = len(word)\n        if _is_prime(word_length):\n            filtered_words.append(word)\n\n    return ' '.join(filtered_words)\n```"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            modified_num = num ** 2\n        elif i % 4 == 0:  # This 'elif' ensures it's not a multiple of 3 due to the previous 'if'\n            modified_num = num ** 3\n        else:\n            modified_num = num\n        total_sum += modified_num\n    return total_sum\n```"}
{"task_id": "HumanEval/145", "solution": "```python\ndef order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits,\n    then by their original index for tie-breaking.\n    \"\"\"\n\n    def _calculate_digit_sum(number: int) -> int:\n        \"\"\"\n        Calculates the sum of the absolute values of the digits for a single integer.\n        \"\"\"\n        s = 0\n        for digit_char in str(abs(number)):\n            s += int(digit_char)\n        return s\n\n    class SortedInteger:\n        \"\"\"\n        Encapsulates an integer's value, its original index, and its digit sum\n        for custom sorting.\n        \"\"\"\n        def __init__(self, value: int, original_index: int, digit_sum: int):\n            self.value = value\n            self.digit_sum = digit_sum\n            self.original_index = original_index\n\n        def __lt__(self, other: 'SortedInteger') -> bool:\n            if self.digit_sum != other.digit_sum:\n                return self.digit_sum < other.digit_sum\n            return self.original_index < other.original_index\n\n    if not nums:\n        return []\n\n    augmented_nums = []\n    for i, num in enumerate(nums):\n        digit_sum = _calculate_digit_sum(num)\n        augmented_nums.append(SortedInteger(num, i, digit_sum))\n\n    augmented_nums.sort()\n\n    result = [si.value for si in augmented_nums]\n    return result\n```"}
{"task_id": "HumanEval/146", "solution": "```python\ndef specialFilter(nums):\n    \"\"\"Counts elements in the array that are greater than 10 and have both first and last digits odd.\"\"\"\n\n    def _is_greater_than_10(num):\n        \"\"\"Checks if a number is strictly greater than 10.\"\"\"\n        return num > 10\n\n    def _get_first_digit(num):\n        \"\"\"Extracts the first digit of a number's absolute value.\"\"\"\n        return int(str(abs(num))[0])\n\n    def _get_last_digit(num):\n        \"\"\"Extracts the last digit of a number's absolute value.\"\"\"\n        return abs(num) % 10\n\n    def _is_odd(digit):\n        \"\"\"Checks if a digit is odd.\"\"\"\n        return digit % 2 != 0\n\n    count = 0\n    for num in nums:\n        if _is_greater_than_10(num):\n            first_digit = _get_first_digit(num)\n            last_digit = _get_last_digit(num)\n            if _is_odd(first_digit) and _is_odd(last_digit):\n                count += 1\n    return count\n```"}
{"task_id": "HumanEval/148", "solution": "```python\ndef bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets whose orbits are between planet1 and planet2,\n    sorted by proximity to the sun. Returns an empty tuple for invalid planet names.\n    \"\"\"\n    planets = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n\n    if planet1 not in planets or planet2 not in planets:\n        return ()\n\n    idx1 = planets.index(planet1)\n    idx2 = planets.index(planet2)\n\n    if idx1 == idx2:\n        return ()\n\n    start_idx = min(idx1, idx2) + 1\n    end_idx = max(idx1, idx2)\n\n    intermediate_planets = planets[start_idx:end_idx]\n\n    return tuple(intermediate_planets)\n```"}
{"task_id": "HumanEval/149", "solution": "```python\ndef sorted_list_sum(lst):\n    \"\"\"Filters a list of strings, keeping only those with even lengths,\n    and then sorts the remaining strings based on length (ascending)\n    and then alphabetically (ascending).\"\"\"\n    even_length_strings = []\n    for s in lst:\n        if len(s) % 2 == 0:\n            even_length_strings.append(s)\n\n    # Sort primarily by length and secondarily by alphabetical order.\n    return sorted(even_length_strings, key=lambda s: (len(s), s))\n```"}
{"task_id": "HumanEval/150", "solution": "```python\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n\n    \"\"\"\n    def _is_prime(num):\n        # Checks if a number is prime.\n        # Returns True if prime, False otherwise.\n        if num <= 1:\n            return False\n        i = 2\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 1\n        return True\n\n    if _is_prime(n):\n        return x\n    else:\n        return y\n```"}
{"task_id": "HumanEval/152", "solution": "```python\ndef compare(game,guess):\n    \"\"\"Calculates the absolute difference for each pair of game scores and guesses.\n    Returns 0 if the guess was correct, otherwise the absolute difference.\n    \"\"\"\n    result = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            result.append(0)\n        else:\n            result.append(abs(game[i] - guess[i]))\n    return result\n```\n"}
{"task_id": "HumanEval/147", "solution": "```python\ndef get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from array a where i < j < k\n    and their sum is a multiple of 3.\n    \"\"\"\n    a = []\n    # Generate the array 'a' where a[i] = i * i - i + 1 (using 1-based index for formula)\n    for i in range(1, n + 1):\n        a.append(i * i - i + 1)\n\n    count = 0\n    length = len(a)\n\n    # Iterate through all unique combinations of three distinct elements\n    for i in range(length):\n        for j in range(i + 1, length):\n            for k in range(j + 1, length):\n                # Calculate the sum of the triple\n                current_sum = a[i] + a[j] + a[k]\n                # Check if the sum is a multiple of 3\n                if current_sum % 3 == 0:\n                    count += 1\n    return count\n```"}
{"task_id": "HumanEval/151", "solution": "```python\nfrom typing import List, Any\n\nclass Number:\n    \"\"\"\n    Represents a single number and provides methods to check its properties\n    and calculate its square.\n    \"\"\"\n    def __init__(self, value: Any):\n        self._value = value\n\n    def is_integer(self) -> bool:\n        \"\"\"Checks if the value is an integer.\"\"\"\n        return isinstance(self._value, int)\n\n    def is_negative(self) -> bool:\n        \"\"\"Checks if the value is negative.\"\"\"\n        return self._value < 0\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the value is odd (only for integers).\"\"\"\n        return self._value % 2 != 0\n\n    def get_square(self) -> int:\n        \"\"\"Returns the square of the value.\"\"\"\n        return self._value * self._value\n\nclass CalculationResult:\n    \"\"\"\n    Holds the final sum of squares.\n    \"\"\"\n    def __init__(self, sum_val: int):\n        self.sum_of_squares = sum_val\n\nclass NumberList:\n    \"\"\"\n    Manages a list of Number objects and orchestrates the processing to\n    calculate the sum of squares.\n    \"\"\"\n    def __init__(self, raw_list: list):\n        self._numbers: List[Number] = [Number(item) for item in raw_list]\n\n    def process_list(self) -> CalculationResult:\n        \"\"\"\n        Iterates, filters, squares, and sums numbers, returning a CalculationResult.\n        \"\"\"\n        sum_of_squares = 0\n        for number_obj in self._numbers:\n            if number_obj.is_integer() and not number_obj.is_negative() and number_obj.is_odd():\n                sum_of_squares += number_obj.get_square()\n        return CalculationResult(sum_of_squares)\n\ndef double_the_difference(lst: list) -> int:\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n\n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0\n\n    If the input list is empty, return 0.\n    \"\"\"\n    if not lst:\n        return 0\n\n    number_list_processor = NumberList(lst)\n    result = number_list_processor.process_list()\n    return result.sum_of_squares\n```"}
{"task_id": "HumanEval/153", "solution": "```python\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension for a given class name.\n    It calculates strength for each extension, identifies the strongest,\n    and resolves ties by selecting the first occurring extension.\n    \"\"\"\n    def _calculate_strength(extension_name):\n        \"\"\"Calculates the strength of an extension name.\n        Strength = (number of uppercase letters) - (number of lowercase letters).\n        \"\"\"\n        cap_count = 0\n        sm_count = 0\n        for char in extension_name:\n            if 'A' <= char <= 'Z':  # Check for uppercase letters\n                cap_count += 1\n            elif 'a' <= char <= 'z':  # Check for lowercase letters\n                sm_count += 1\n        return cap_count - sm_count\n\n    if not extensions:\n        return f\"{class_name}.\"\n\n    strongest_extension_name = \"\"\n    max_strength = float('-inf')\n\n    for extension_name in extensions:\n        current_strength = _calculate_strength(extension_name)\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension_name\n\n    return f\"{class_name}.{strongest_extension_name}\"\n```"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    len_a = len(a)\n    len_b = len(b)\n\n    # If b is longer than a, no rotation of b can be a substring of a\n    if len_b > len_a:\n        return False\n    # If b is empty, it's considered a substring of any string (or no rotations to check)\n    if len_b == 0:\n        return True\n\n    # Generate all cyclic rotations of b and check if any are substrings of a\n    for i in range(len_b):\n        # Perform a cyclic rotation: move i characters from start to end\n        current_rotation = b[i:] + b[:i]\n\n        # Check if the current rotation is a substring of a\n        if current_rotation in a:\n            return True\n\n    return False"}
{"task_id": "HumanEval/155", "solution": "```python\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\"\"\"\n    even_count = 0\n    odd_count = 0\n    # Process the absolute value of the number to handle negative inputs.\n    num_str = str(abs(num))\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    _ROMAN_MAP = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    def _validate_input(num: int) -> None:\n        \"\"\"Validates if the input integer is within the allowed range [1, 1000].\"\"\"\n        if not isinstance(num, int):\n            raise ValueError(\"Input must be an integer.\")\n        if not (1 <= num <= 1000):\n            raise ValueError(f\"Input number {num} is out of range. Must be between 1 and 1000 inclusive.\")\n\n    def _convert_to_standard_roman(num: int) -> str:\n        \"\"\"Converts a validated integer into its uppercase Roman numeral string representation.\"\"\"\n        roman_numeral = []\n        temp_num = num\n        for value, symbol in _ROMAN_MAP:\n            while temp_num >= value:\n                roman_numeral.append(symbol)\n                temp_num -= value\n        return \"\".join(roman_numeral)\n\n    def _to_lowercase(roman_str: str) -> str:\n        \"\"\"Converts an uppercase Roman numeral string to its lowercase equivalent.\"\"\"\n        return roman_str.lower()\n\n    _validate_input(number)\n    standard_roman = _convert_to_standard_roman(number)\n    mini_roman = _to_lowercase(standard_roman)\n    return mini_roman"}
{"task_id": "HumanEval/157", "solution": "```python\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    '''\n    class Triangle:\n        def __init__(self, side_a, side_b, side_c):\n            # Initializes the triangle with the given side lengths.\n            self._side_a = side_a\n            self._side_b = side_b\n            self._side_c = side_c\n\n        def is_valid_triangle(self):\n            # Checks if sides are positive and satisfy the triangle inequality theorem.\n            if self._side_a <= 0 or self._side_b <= 0 or self._side_c <= 0:\n                return False\n            return (self._side_a + self._side_b > self._side_c and\n                    self._side_a + self._side_c > self._side_b and\n                    self._side_b + self._side_c > self._side_a)\n\n        def is_right_angled(self):\n            # Determines if the triangle is right-angled using the Pythagorean theorem.\n            sides = sorted([self._side_a, self._side_b, self._side_c])\n            x, y, z = sides[0], sides[1], sides[2]\n\n            # Compares sum of squares of two shorter sides to square of the longest side.\n            epsilon = 1e-9\n            return abs(x*x + y*y - z*z) < epsilon\n\n    triangle_instance = Triangle(a, b, c)\n\n    # A right-angled triangle must first be a valid triangle.\n    if not triangle_instance.is_valid_triangle():\n        return False\n\n    return triangle_instance.is_right_angled()\n```"}
{"task_id": "HumanEval/158", "solution": "```python\ndef find_max(words):\n    \"\"\"\n    Returns the word with the maximum number of unique characters from a list of strings.\n    If multiple words have the same maximum, the lexicographically smallest one is returned.\n    \"\"\"\n    def _calculate_unique_characters_count(word: str) -> int:\n        \"\"\"Calculates the number of unique characters in a given string.\"\"\"\n        return len(set(word))\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = _calculate_unique_characters_count(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Apply lexicographical tie-breaking\n            if result_word == \"\" or word < result_word:\n                result_word = word\n\n    return result_word\n```"}
{"task_id": "HumanEval/159", "solution": "```python\ndef eat(number, need, remaining):\n    \"\"\"\n    Calculates total carrots eaten and remaining carrots after a meal.\n    This implementation uses a nested class to encapsulate the calculation logic as per design.\n    \"\"\"\n    class CarrotMealCalculation:\n        \"\"\"\n        Encapsulates the business logic for calculating carrot consumption.\n        \"\"\"\n        def __init__(self, number_eaten: int, carrots_needed: int, carrots_remaining: int):\n            self._initialEatenCarrots = number_eaten\n            self._carrotsNeeded = carrots_needed\n            self._initialRemainingCarrots = carrots_remaining\n\n            # Initialize calculated properties\n            self._carrotsEatenFromStock = 0\n            self._totalEatenCarrots = 0\n            self._carrotsLeftInStock = 0\n\n        def calculateCarrotsEatenFromStock(self) -> None:\n            \"\"\"Calculates the number of carrots eaten from the remaining stock.\"\"\"\n            self._carrotsEatenFromStock = min(self._carrotsNeeded, self._initialRemainingCarrots)\n\n        def calculateTotalEatenCarrots(self) -> None:\n            \"\"\"Calculates the total number of carrots eaten after the meal.\"\"\"\n            self._totalEatenCarrots = self._initialEatenCarrots + self._carrotsEatenFromStock\n\n        def calculateCarrotsLeftInStock(self) -> None:\n            \"\"\"Calculates the number of carrots left in stock after the meal.\"\"\"\n            self._carrotsLeftInStock = self._initialRemainingCarrots - self._carrotsEatenFromStock\n\n        def getMealResult(self) -> list[int]:\n            \"\"\"Returns the final calculated results as a list.\"\"\"\n            return [self._totalEatenCarrots, self._carrotsLeftInStock]\n\n    # Orchestrate the carrot meal calculation using the CarrotMealCalculation class\n    calculator = CarrotMealCalculation(number, need, remaining)\n    calculator.calculateCarrotsEatenFromStock()\n    calculator.calculateTotalEatenCarrots()\n    calculator.calculateCarrotsLeftInStock()\n    return calculator.getMealResult()\n```"}
{"task_id": "HumanEval/160", "solution": "```python\ndef do_algebra(operator, operand):\n    \"\"\"\n    Constructs an algebraic expression by interleaving operands and operators, then evaluates it.\n    The length of operator list is operand list minus one, guaranteeing a valid sequence.\n    \"\"\"\n    expression_parts = [str(operand[0])]\n    for i in range(len(operator)):\n        expression_parts.append(operator[i])\n        expression_parts.append(str(operand[i+1]))\n\n    expression_string = \" \".join(expression_parts)\n\n    # eval() handles the standard mathematical precedence of operators.\n    result = eval(expression_string)\n\n    return int(result)\n```"}
{"task_id": "HumanEval/162", "solution": "```python\nimport hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n\n    # Encode the string to bytes before hashing\n    md5_hash = hashlib.md5(text.encode('utf-8'))\n    # Return the hexadecimal representation of the hash\n    return md5_hash.hexdigest()\n```"}
{"task_id": "HumanEval/161", "solution": "def _is_letter(char):\n    \"\"\"Checks if the given character is an alphabetic letter.\"\"\"\n    return char.isalpha()\n\ndef _reverse_case(char):\n    \"\"\"Reverses the case of a single letter character. Assumes the input char is a letter.\"\"\"\n    return char.swapcase()\n\ndef _has_letters(s):\n    \"\"\"Determines if the input string contains at least one letter character.\"\"\"\n    for char in s:\n        if _is_letter(char):\n            return True\n    return False\n\ndef solve(s):\n    \"\"\"Transforms the input string s according to the specified rules.\n    If s contains no letters, the entire string is reversed. Otherwise, letters have their case reversed, and non-letters remain unchanged.\n    \"\"\"\n    if not _has_letters(s):\n        return s[::-1]\n\n    result_chars = []\n    for char in s:\n        if _is_letter(char):\n            result_chars.append(_reverse_case(char))\n        else:\n            result_chars.append(char)\n\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/163", "solution": "```python\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    def _is_even(number: int) -> bool:\n        \"\"\"Determines if the given integer is even.\"\"\"\n        return number % 2 == 0\n\n    def _is_single_digit(number: int) -> bool:\n        \"\"\"Determines if the given integer is a single digit (0-9).\"\"\"\n        return 0 <= number <= 9\n\n    min_val = min(a, b)\n    max_val = max(a, b)\n    result_list = []\n\n    for num in range(min_val, max_val + 1):\n        if _is_single_digit(num) and _is_even(num):\n            result_list.append(num)\n\n    # Sort the result list in ascending order as per design.\n    result_list.sort()\n\n    return result_list\n```\n"}
