{"task_id": "HumanEval/91", "solution": "```python\ndef _split_into_sentences(text, delimiters):\n    \"\"\"\n    Splits a given text into a list of sentences using specified delimiters.\n    Sentences are stripped of leading/trailing whitespace.\n    \"\"\"\n    sentences = []\n    current_sentence_chars = []\n    for char in text:\n        if char in delimiters:\n            sentence = \"\".join(current_sentence_chars).strip()\n            if sentence:\n                sentences.append(sentence)\n            current_sentence_chars = []\n        else:\n            current_sentence_chars.append(char)\n\n    final_sentence = \"\".join(current_sentence_chars).strip()\n    if final_sentence:\n        sentences.append(final_sentence)\n\n    return sentences\n\ndef _starts_with_i(sentence_text):\n    \"\"\"\n    Checks if a sentence starts with the case-sensitive word \"I\".\n    It considers \"I\" as a word if followed by a space or if it's the entire sentence.\n    \"\"\"\n    stripped_sentence = sentence_text.strip()\n    if not stripped_sentence:\n        return False\n\n    if stripped_sentence == \"I\":\n        return True\n    if stripped_sentence.startswith(\"I \"):\n        return True\n\n    return False\n\ndef is_bored(S):\n    \"\"\"\n    Counts the number of boredoms in a string S.\n    A boredom is a sentence that starts with the word \"I\".\n    \"\"\"\n    boredom_count = 0\n    delimiters = ('.', '?', '!')\n\n    sentences = _split_into_sentences(S, delimiters)\n\n    for sentence in sentences:\n        if _starts_with_i(sentence):\n            boredom_count += 1\n\n    return boredom_count\n```"}
{"task_id": "HumanEval/92", "solution": "```python\ndef any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n\n    Examples\n    any_int(5, 2, 7) \u279e True\n\n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n\n    any_int(3.6, -2.2, 2) \u279e False\n\n\n\n    '''\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False\n\n    if x == y + z or y == x + z or z == x + y:\n        return True\n\n    return False\n```"}
{"task_id": "HumanEval/94", "solution": "```python\ndef skjkasdkd(lst):\n    \"\"\"Finds the largest prime in the list and returns the sum of its digits.\n    Returns 0 if no prime numbers are found or the list is empty.\n    \"\"\"\n\n    def _is_prime(n):\n        \"\"\"Determines if a given integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    def _sum_digits(n):\n        \"\"\"Calculates the sum of the digits of a given integer n.\"\"\"\n        digit_sum = 0\n        while n > 0:\n            digit_sum += n % 10\n            n //= 10\n        return digit_sum\n\n    largest_prime = 0\n    for num in lst:\n        if _is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n\n    if largest_prime == 0:\n        return 0\n    else:\n        return _sum_digits(largest_prime)\n```"}
{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Complete the function that takes two integers and returns\n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    \"\"\"\n    def _get_absolute_unit_digit(number: int) -> int:\n        \"\"\"Determines the absolute value of the unit digit of an integer.\"\"\"\n        return abs(number) % 10\n\n    unit_digit_a = _get_absolute_unit_digit(a)\n    unit_digit_b = _get_absolute_unit_digit(b)\n    product = unit_digit_a * unit_digit_b\n    return product"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    # Determine the expected case from the first string key encountered.\n    # True means expected lower case, False means expected upper case, None if not yet determined.\n    expected_lower_case = None\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n        if expected_lower_case is None:\n            # This is the first string key; establish the expected casing.\n            if key.islower():\n                expected_lower_case = True\n            elif key.isupper():\n                expected_lower_case = False\n            else:\n                # The first string key itself is neither purely lower nor purely upper.\n                return False\n        else:\n            # Subsequent string keys must match the established casing.\n            if expected_lower_case: # Expecting all keys to be lower case\n                if not key.islower():\n                    return False\n            else: # Expecting all keys to be upper case\n                if not key.isupper():\n                    return False\n\n    # If the loop completes, all keys are strings and consistently lower or upper case.\n    return True\n```"}
{"task_id": "HumanEval/96", "solution": "```python\ndef count_up_to(n):\n    \"\"\"Implement a function that takes a non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    for example:\n    count_up_to(5) => [2,3]\n    count_up_to(11) => [2,3,5,7]\n    count_up_to(0) => []\n    count_up_to(20) => [2,3,5,7,11,13,17,19]\n    count_up_to(1) => []\n    count_up_to(18) => [2,3,5,7,11,13,17]\n    \"\"\"\n\n    def _is_prime(num):\n        # Determines if a given integer is a prime number.\n        if num < 2:\n            return False\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    primes = []\n    # If n is 0, 1, or 2, there are no prime numbers strictly less than n.\n    if n <= 2:\n        return primes\n\n    for num in range(2, n):\n        if _is_prime(num):\n            primes.append(num)\n    return primes\n```"}
{"task_id": "HumanEval/93", "solution": "```python\ndef encode(message):\n    \"\"\"\n    Encodes a message by swapping letter cases and replacing vowels.\n    \"\"\"\n\n    def _is_english_letter(char):\n        \"\"\"Checks if a character is an English alphabet letter.\"\"\"\n        return 'a' <= char <= 'z' or 'A' <= char <= 'Z'\n\n    def _swap_case(char):\n        \"\"\"Swaps the case of an English alphabet letter.\"\"\"\n        return char.swapcase()\n\n    def _is_vowel(char):\n        \"\"\"Determines if a character is an English vowel (case-insensitive).\"\"\"\n        return char.lower() in \"aeiou\"\n\n    def _replace_vowel(char):\n        \"\"\"Replaces a vowel with the letter two places ahead in the alphabet, preserving case.\"\"\"\n        return chr(ord(char) + 2)\n\n    encoded_chars = []\n    for char in message:\n        if _is_english_letter(char):\n            # Apply vowel replacement if it's a vowel\n            # The result of this replacement will then have its case swapped\n            if _is_vowel(char):\n                temp_char = _replace_vowel(char)\n            else:\n                temp_char = char\n            # Then, swap the case of all letters (including replaced vowels)\n            encoded_chars.append(_swap_case(temp_char))\n        else:\n            # If not an English letter, append unchanged\n            encoded_chars.append(char)\n\n    return \"\".join(encoded_chars)\n```"}
{"task_id": "HumanEval/98", "solution": "```python\ndef count_upper(s):\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n\n    For example:\n    count_upper('aBCdEf') returns 1\n    count_upper('abcdefg') returns 0\n    count_upper('dBBE') returns 0\n    \"\"\"\n    count = 0\n    uppercase_vowels = 'AEIOU'\n    for i in range(len(s)):\n        if i % 2 == 0:  # Check if the index is even\n            char = s[i]\n            if char in uppercase_vowels:  # Check if the character is an uppercase vowel\n                count += 1\n    return count\n```"}
{"task_id": "HumanEval/99", "solution": "def closest_integer(value):\n    '''\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n\n    Examples\n    >>> closest_integer(\"10\")\n    10\n    >>> closest_integer(\"15.3\")\n    15\n\n    Note:\n    Rounding away from zero means that if the given number is equidistant\n    from two integers, the one you should return is the one that is the\n    farthest from zero. For example closest_integer(\"14.5\") should\n    return 15 and closest_integer(\"-14.5\") should return -15.\n    '''\n    num = float(value)\n\n    # Calculate floor and ceil\n    floor_num = int(num)\n    ceil_num = int(num) + 1 if num > 0 or num != int(num) else int(num)\n    if num < 0 and num != int(num):\n        ceil_num = int(num)\n        floor_num = int(num) - 1\n\n    # Calculate distances\n    dist_to_floor = abs(num - floor_num)\n    dist_to_ceil = abs(num - ceil_num)\n\n    # Apply rounding rules\n    if dist_to_floor < dist_to_ceil:\n        return floor_num\n    elif dist_to_ceil < dist_to_floor:\n        return ceil_num\n    else:  # Equidistant, round away from zero\n        if num >= 0:\n            return ceil_num\n        else:\n            return floor_num"}
