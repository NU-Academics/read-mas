{"task_id": "HumanEval/123", "solution": "```python\nclass CollatzNumber:\n    \"\"\"Represents a single integer within the Collatz sequence, encapsulating its value and Collatz-specific properties/operations.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def get_value(self) -> int:\n        return self._value\n\n    def is_odd(self) -> bool:\n        return self._value % 2 != 0\n\n    def is_even(self) -> bool:\n        return self._value % 2 == 0\n\n    def calculate_next_collatz_term(self) -> 'CollatzNumber':\n        \"\"\"Calculates and returns the next term in the Collatz sequence based on its parity.\"\"\"\n        if self.is_even():\n            return CollatzNumber(self._value // 2)\n        else:\n            return CollatzNumber(3 * self._value + 1)\n\nclass CollatzSequence:\n    \"\"\"Manages the generation of a Collatz sequence from a starting number and provides methods to extract odd numbers.\"\"\"\n    def __init__(self, start_n: int):\n        self._start_n = start_n\n        self._sequence: list[CollatzNumber] = []\n\n    def generate(self) -> None:\n        \"\"\"Generates the complete Collatz sequence until 1 is reached.\"\"\"\n        current_number = CollatzNumber(self._start_n)\n        while current_number.get_value() != 1:\n            self._sequence.append(current_number)\n            current_number = current_number.calculate_next_collatz_term()\n        self._sequence.append(CollatzNumber(1)) # Add the final 1\n\n    def get_odd_numbers(self) -> list[int]:\n        \"\"\"Filters the generated sequence and returns a list of the integer values of odd numbers.\"\"\"\n        odd_numbers_list = []\n        for num in self._sequence:\n            if num.is_odd():\n                odd_numbers_list.append(num.get_value())\n        return odd_numbers_list\n\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    collatz_sequence_generator = CollatzSequence(n)\n    collatz_sequence_generator.generate()\n    odd_numbers = collatz_sequence_generator.get_odd_numbers()\n\n    odd_numbers.sort()\n    return odd_numbers\n```"}
{"task_id": "HumanEval/124", "solution": "```python\ndef valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    \"\"\"\n\n    def _is_not_empty(date_string: str) -> bool:\n        \"\"\"Checks if the date string is not empty.\"\"\"\n        return bool(date_string)\n\n    def _is_format_valid(date_string: str) -> bool:\n        \"\"\"Checks if the date string conforms to the 'mm-dd-yyyy' format.\"\"\"\n        if len(date_string) != 10:\n            return False\n        if date_string[2] != '-' or date_string[5] != '-':\n            return False\n\n        month_str = date_string[0:2]\n        day_str = date_string[3:5]\n        year_str = date_string[6:10]\n\n        return month_str.isdigit() and day_str.isdigit() and year_str.isdigit()\n\n    def _parse_date_components(date_string: str) -> tuple[int, int, int] | None:\n        \"\"\"Parses month, day, and year from a validly formatted date string.\"\"\"\n        try:\n            month = int(date_string[0:2])\n            day = int(date_string[3:5])\n            year = int(date_string[6:10])\n            return (month, day, year)\n        except ValueError:\n            return None\n\n    def _is_month_valid(month: int) -> bool:\n        \"\"\"Validates the month value, ensuring it is between 1 and 12.\"\"\"\n        return 1 <= month <= 12\n\n    def _is_day_valid(month: int, day: int) -> bool:\n        \"\"\"Validates the day value based on the month, adhering to specific day ranges.\"\"\"\n        if not (1 <= day):\n            return False\n\n        days_in_month = {\n            1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n            4: 30, 6: 30, 9: 30, 11: 30,\n            2: 29\n        }\n\n        max_days = days_in_month.get(month)\n        if max_days is None:\n            return False\n\n        return day <= max_days\n\n    # Rule 1: The date string is not empty.\n    if not _is_not_empty(date):\n        return False\n\n    # Rule 4: The date should be in the format: mm-dd-yyyy\n    if not _is_format_valid(date):\n        return False\n\n    # Parse components\n    components = _parse_date_components(date)\n    if components is None:\n        return False\n\n    month, day, year = components\n\n    # Rule 3: The months should not be less than 1 or higher than 12.\n    if not _is_month_valid(month):\n        return False\n\n    # Rule 2: Validate day based on month.\n    if not _is_day_valid(month, day):\n        return False\n\n    return True\n```"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of all signs\n    of each number in the array. Returns None for an empty array.\n    \"\"\"\n    def _get_sign(number):\n        \"\"\"Returns 1 for positive, -1 for negative, and 0 for zero.\"\"\"\n        if number > 0:\n            return 1\n        elif number < 0:\n            return -1\n        else:\n            return 0\n\n    def _get_magnitude(number):\n        \"\"\"Returns the absolute value (magnitude) of a number.\"\"\"\n        return abs(number)\n\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        product_of_signs *= _get_sign(num)\n        sum_of_magnitudes += _get_magnitude(num)\n\n    return sum_of_magnitudes * product_of_signs"}
{"task_id": "HumanEval/125", "solution": "```python\nclass Character:\n    '''\n    Encapsulates a single character and provides methods to determine its properties.\n    '''\n    def __init__(self, char_value: str):\n        self._char_value = char_value\n        self._alphabetical_order = -1\n        if self.is_lowercase():\n            self._alphabetical_order = ord(char_value) - ord('a')\n\n    def is_lowercase(self) -> bool:\n        return 'a' <= self._char_value <= 'z'\n\n    def is_odd_order(self) -> bool:\n        return self.is_lowercase() and self._alphabetical_order % 2 != 0\n\nclass Word:\n    '''\n    Represents a single word.\n    '''\n    def __init__(self, value: str):\n        self._value = value\n\n    def get_value(self) -> str:\n        return self._value\n\nclass InputString:\n    '''\n    Encapsulates the input text and provides methods for content analysis and operations.\n    '''\n    def __init__(self, text: str):\n        self._text = text\n\n    def has_whitespace(self) -> bool:\n        return any(c.isspace() for c in self._text)\n\n    def has_comma(self) -> bool:\n        return ',' in self._text\n\n    def split_by_whitespace(self) -> list[str]:\n        return self._text.split()\n\n    def split_by_comma(self) -> list[str]:\n        return [part.strip() for part in self._text.split(',') if part.strip()]\n\n    def count_odd_ordered_lowercase_letters(self) -> int:\n        count = 0\n        for char_value in self._text:\n            char_obj = Character(char_value)\n            if char_obj.is_odd_order():\n                count += 1\n        return count\n\ndef split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',', if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    '''\n    input_str = InputString(txt)\n\n    if input_str.has_whitespace():\n        return input_str.split_by_whitespace()\n    elif input_str.has_comma():\n        return input_str.split_by_comma()\n    else:\n        return input_str.count_odd_ordered_lowercase_letters()\n```"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    if len(lst) <= 1:\n        return True\n\n    # Check for ascending order\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check for excessive duplicates (more than 1 duplicate means 3 or more occurrences)\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] >= 3:\n            return False\n\n    return True"}
{"task_id": "HumanEval/127", "solution": "```python\nimport math\nfrom dataclasses import dataclass\nfrom typing import Tuple, Optional\n\n@dataclass\nclass Interval:\n    \"\"\"Represents a closed integer interval (start, end).\"\"\"\n    start: int\n    end: int\n\n@dataclass\nclass Intersection:\n    \"\"\"Represents the intersection of two intervals, including its length.\"\"\"\n    start: int\n    end: int\n    length: int\n\ndef is_prime(number: int) -> bool:\n    \"\"\"Determines if a given integer is a prime number.\"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(number)) + 1, 2):\n        if number % i == 0:\n            return False\n    return True\n\ndef calculate_intersection_details(interval1: Interval, interval2: Interval) -> Optional[Intersection]:\n    \"\"\"Calculates the intersection of two intervals and its length, returning None if they don't intersect.\"\"\"\n    start_intersect = max(interval1.start, interval2.start)\n    end_intersect = min(interval1.end, interval2.end)\n\n    if start_intersect > end_intersect:\n        return None\n    else:\n        length = end_intersect - start_intersect + 1\n        return Intersection(start=start_intersect, end=end_intersect, length=length)\n\ndef intersection(interval1: Tuple[int, int], interval2: Tuple[int, int]) -> str:\n    \"\"\"\n    Determines whether the length of the intersection of two closed integer intervals\n    is a prime number. Returns 'YES' if prime, 'NO' otherwise.\n    \"\"\"\n    int1_obj = Interval(start=interval1[0], end=interval1[1])\n    int2_obj = Interval(start=interval2[0], end=interval2[1])\n\n    intersection_details = calculate_intersection_details(int1_obj, int2_obj)\n\n    if intersection_details is None:\n        return \"NO\"\n    else:\n        if is_prime(intersection_details.length):\n            return \"YES\"\n        else:\n            return \"NO\"\n```"}
{"task_id": "HumanEval/131", "solution": "```python\ndef _is_odd(digit):\n    \"\"\"Determines if a given digit is odd.\"\"\"\n    return digit % 2 != 0\n\ndef _extract_digits(number):\n    \"\"\"Extracts individual digits from an integer into a list.\"\"\"\n    return [int(d) for d in str(number)]\n\ndef digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    product = 1\n    found_odd = False\n\n    for digit in _extract_digits(n):\n        if _is_odd(digit):\n            product *= digit\n            found_odd = True\n\n    if found_odd:\n        return product\n    else:\n        return 0\n```"}
{"task_id": "HumanEval/130", "solution": "```python\ndef tri(n):\n    \"\"\"\n    Calculates the first n + 1 numbers of the Tribonacci sequence.\n    The sequence is defined by specific rules for tri(0), tri(1), even n, and odd n.\n    \"\"\"\n    if n == 0:\n        return [1]\n\n    # memo stores computed values; size n + 2 handles tri(k+1) dependency for odd k up to n.\n    memo = [None] * (n + 2)\n\n    def _calculate_tri_k(k):\n        # Return memoized value if already computed.\n        if memo[k] is not None:\n            return memo[k]\n\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # k is even, k >= 2\n            result = 1 + k // 2\n        else:  # k is odd, k >= 3\n            result = _calculate_tri_k(k - 1) + _calculate_tri_k(k - 2) + _calculate_tri_k(k + 1)\n\n        memo[k] = result\n        return result\n\n    # Compute values from tri(0) up to tri(n).\n    for k in range(n + 1):\n        _calculate_tri_k(k)\n\n    return memo[:n + 1]\n```"}
{"task_id": "HumanEval/129", "solution": "```python\ndef minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k,\n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n\n    class Cell:\n        \"\"\"Represents a single cell in the grid with its coordinates and value.\"\"\"\n        def __init__(self, row, col, value):\n            self.row = row\n            self.col = col\n            self.value = value\n\n        def get_neighbors(self, grid_N):\n            \"\"\"Returns a list of valid (row, col) coordinates of adjacent cells.\"\"\"\n            neighbors = []\n            moves = [(0, 1), (0, -1), (1, 0), (-1, 0)] # Right, Left, Down, Up\n            for dr, dc in moves:\n                n_row, n_col = self.row + dr, self.col + dc\n                if 0 <= n_row < grid_N and 0 <= n_col < grid_N:\n                    neighbors.append((n_row, n_col))\n            return neighbors\n\n        def __eq__(self, other):\n            if not isinstance(other, Cell):\n                return NotImplemented\n            return self.row == other.row and self.col == other.col\n\n        def __hash__(self):\n            return hash((self.row, self.col))\n\n        def __repr__(self):\n            return f\"Cell({self.row},{self.col},{self.value})\"\n\n    class Grid:\n        \"\"\"Manages the 2D array of Cell objects and provides methods for access and boundary checks.\"\"\"\n        def __init__(self, grid_data):\n            self.N = len(grid_data)\n            self.cells = [[None for _ in range(self.N)] for _ in range(self.N)]\n            for r in range(self.N):\n                for c in range(self.N):\n                    self.cells[r][c] = Cell(r, c, grid_data[r][c])\n\n        def get_cell(self, row, col):\n            return self.cells[row][col]\n\n    class Path:\n        \"\"\"Represents an ordered sequence of Cell objects and supports lexicographical comparison.\"\"\"\n        def __init__(self, initial_cell=None):\n            self.sequence_of_cells = []\n            if initial_cell:\n                self.sequence_of_cells.append(initial_cell)\n            self.length = len(self.sequence_of_cells)\n\n        def add_cell(self, cell):\n            self.sequence_of_cells.append(cell)\n            self.length += 1\n\n        def remove_last_cell(self):\n            if self.sequence_of_cells:\n                self.sequence_of_cells.pop()\n                self.length -= 1\n\n        def get_values_list(self):\n            return [cell.value for cell in self.sequence_of_cells]\n\n        def __lt__(self, other):\n            \"\"\"Compares this path with another path lexicographically.\"\"\"\n            self_values = self.get_values_list()\n            other_values = other.get_values_list()\n            return self_values < other_values\n\n        def __repr__(self):\n            return f\"Path({[c.value for c in self.sequence_of_cells]})\"\n\n    def _find_paths_recursive(current_path, current_cell, target_k, grid_obj, min_path_values_ref):\n        \"\"\"Recursively explores paths using DFS and updates the minimum path found.\"\"\"\n        if current_path.length == target_k:\n            current_path_values = current_path.get_values_list()\n            if not min_path_values_ref[0] or current_path_values < min_path_values_ref[0]:\n                min_path_values_ref[0] = current_path_values\n            return\n\n        # Pruning: If a minimum path of length `target_k` has been found,\n        # and the current path's prefix is already lexicographically greater than or equal to\n        # the corresponding prefix of the best path found so far, prune this branch.\n        if min_path_values_ref[0] and len(min_path_values_ref[0]) >= current_path.length:\n            current_vals_prefix = current_path.get_values_list()\n            if current_vals_prefix >= min_path_values_ref[0][:current_path.length]:\n                return\n\n        neighbors_coords = current_cell.get_neighbors(grid_obj.N)\n\n        for n_row, n_col in neighbors_coords:\n            neighbor_cell = grid_obj.get_cell(n_row, n_col)\n            current_path.add_cell(neighbor_cell)\n            _find_paths_recursive(current_path, neighbor_cell, target_k, grid_obj, min_path_values_ref)\n            current_path.remove_last_cell() # Backtrack\n\n    # Main logic for minPath function\n    grid_obj = Grid(grid)\n    N = grid_obj.N\n\n    # min_path_values_ref is a list containing the best path (list of values) found so far.\n    # Using a list allows the recursive function to modify the value in the outer scope.\n    min_path_values_ref = [None]\n\n    # Iterate through all possible starting cells\n    for r in range(N):\n        for c in range(N):\n            start_cell = grid_obj.get_cell(r, c)\n            initial_path = Path(start_cell)\n\n            # Special handling for k=1: directly find the minimum value.\n            # This avoids unnecessary recursion depth for the simplest case.\n            if k == 1:\n                current_path_values = initial_path.get_values_list()\n                if not min_path_values_ref[0] or current_path_values < min_path_values_ref[0]:\n                    min_path_values_ref[0] = current_path_values\n                continue\n\n            _find_paths_recursive(initial_path, start_cell, k, grid_obj, min_path_values_ref)\n\n    return min_path_values_ref[0]\n```"}
{"task_id": "HumanEval/135", "solution": "```python\ndef can_arrange(arr):\n    \"\"\"Returns the largest index of an element which is strictly less than the element immediately preceding it.\n    Returns -1 if no such element exists, indicating a non-decreasing array.\n    \"\"\"\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i-1]:\n            return i\n    return -1\n```"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    '''\n    Returns True if the last character of a given string is an alphabetical character\n    and is not a part of a word, and False otherwise.\n    A 'word' is a group of characters separated by space.\n    '''\n    # BR1: Return False if the input string is empty.\n    if not txt:\n        return False\n\n    # BR2: Identify the last character of the input string.\n    last_char = txt[-1]\n\n    # BR3: Determine if the last character is an alphabetical character.\n    if not last_char.isalpha():\n        return False\n\n    # BR4.2: A character is considered 'not part of a word' if it is alphabetical\n    # AND either it is the only character in the string, or the character immediately\n    # preceding it is a space.\n    if len(txt) == 1: # It is the only character in the string\n        return True\n    else:\n        char_before_last = txt[-2]\n        if char_before_last.isspace():\n            return True\n        else:\n            return False # It is part of a word"}
{"task_id": "HumanEval/133", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    \"\"\"\n    import math\n    from typing import List\n\n    class Number:\n        \"\"\"Represents a single number with its original, rounded, and squared values.\"\"\"\n        def __init__(self, value: float):\n            self._original_value = value\n            self._rounded_value: int = 0\n            self._squared_value: int = 0\n\n        def round_up(self) -> None:\n            \"\"\"Rounds the original_value up to the nearest integer (ceiling).\"\"\"\n            self._rounded_value = math.ceil(self._original_value)\n\n        def square(self) -> None:\n            \"\"\"Squares the rounded_value.\"\"\"\n            self._squared_value = self._rounded_value ** 2\n\n        def get_squared_value(self) -> int:\n            return self._squared_value\n\n    class NumberList:\n        \"\"\"Manages a collection of Number objects.\"\"\"\n        def __init__(self, values: List[float]):\n            self._numbers: List[Number] = [Number(val) for val in values]\n\n        def get_numbers(self) -> List[Number]:\n            return self._numbers\n\n    if not lst:\n        return 0\n\n    number_list = NumberList(lst)\n    total_sum = 0\n\n    for num_obj in number_list.get_numbers():\n        num_obj.round_up()\n        num_obj.square()\n        total_sum += num_obj.get_squared_value()\n\n    return total_sum\n```"}
{"task_id": "HumanEval/136", "solution": "```python\ndef largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    '''\n    largest_neg = None\n    smallest_pos = None\n\n    for number in lst:\n        if number < 0:\n            if largest_neg is None or number > largest_neg:\n                largest_neg = number\n        elif number > 0:\n            if smallest_pos is None or number < smallest_pos:\n                smallest_pos = number\n\n    return (largest_neg, smallest_pos)\n```"}
{"task_id": "HumanEval/137", "solution": "```python\ndef _parse_string_to_float(s):\n    \"\"\"Converts a string number to float, handling comma decimals.\"\"\"\n    if ',' in s:\n        s = s.replace(',', '.')\n    return float(s)\n\ndef _get_numerical_value(value):\n    \"\"\"Converts any input (int, float, str) to its float representation for comparison.\"\"\"\n    try:\n        return float(value)\n    except ValueError:\n        # If direct float conversion fails, assume it's a string with a comma decimal.\n        return _parse_string_to_float(value)\n\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n\n    compare_one(1, 2.5) \u279e 2.5\n    compare_one(1, \"2,3\") \u279e \"2,3\"\n    compare_one(\"5,1\", \"6\") \u279e \"6\"\n    compare_one(\"1\", 1) \u279e None\n    \"\"\"\n    a_numerical_value = _get_numerical_value(a)\n    b_numerical_value = _get_numerical_value(b)\n\n    if a_numerical_value == b_numerical_value:\n        return None\n    elif a_numerical_value > b_numerical_value:\n        return a\n    else:\n        return b\n```\n"}
