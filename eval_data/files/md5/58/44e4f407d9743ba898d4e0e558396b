{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if not (base < 10):\n        raise ValueError(\"Invalid Base: Base must be less than 10.\")\n\n    if x == 0:\n        return '0'\n\n    result = []\n    current_x = x\n    while current_x > 0:\n        remainder = current_x % base\n        result.append(str(remainder))\n        current_x //= base\n\n    return \"\".join(result[::-1])"}
{"task_id": "HumanEval/32", "solution": "import math\nimport sys\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    TOLERANCE: float = 1e-7\n    MAX_INTERVAL_SEARCH_ITERATIONS: int = 1000\n    MAX_BISECTION_ITERATIONS: int = 100\n    INTERVAL_EXPANSION_FACTOR: float = 2.0\n    # Use a quarter of max float value to provide a safer bound against overflow\n    MAX_FLOAT_VALUE_BOUND: float = sys.float_info.max / 4.0\n\n    # Early exit if 0.0 is a root\n    if abs(poly(xs, 0.0)) < TOLERANCE:\n        return 0.0\n\n    # Initial interval bracketing\n    a, b = -1.0, 1.0\n    fa = poly(xs, a)\n    fb = poly(xs, b)\n\n    for _ in range(MAX_INTERVAL_SEARCH_ITERATIONS):\n        if abs(fa) < TOLERANCE:\n            return a\n        if abs(fb) < TOLERANCE:\n            return b\n\n        if fa * fb < 0:\n            break  # Interval with sign change found\n        else:\n            # Expand interval, checking for potential overflow before multiplication\n            if abs(a) >= MAX_FLOAT_VALUE_BOUND / INTERVAL_EXPANSION_FACTOR or \\\n               abs(b) >= MAX_FLOAT_VALUE_BOUND / INTERVAL_EXPANSION_FACTOR:\n                # Fallback if interval becomes too large to expand safely\n                return (a + b) / 2.0\n\n            a *= INTERVAL_EXPANSION_FACTOR\n            b *= INTERVAL_EXPANSION_FACTOR\n            fa = poly(xs, a)\n            fb = poly(xs, b)\n    else:\n        # If loop completes without breaking (no sign change found within limits)\n        # This acts as a safeguard; for odd-degree polynomials, a root should exist.\n        return (a + b) / 2.0\n\n    # Bisection method\n    for _ in range(MAX_BISECTION_ITERATIONS):\n        c = (a + b) / 2.0\n        fc = poly(xs, c)\n\n        if abs(fc) < TOLERANCE:\n            return c\n\n        if fa * fc < 0:  # Root is in [a, c]\n            b = c\n            fb = fc\n        else:  # Root is in [c, b]\n            a = c\n            fa = fc\n\n    # Fallback return if tolerance not met after max iterations\n    return (a + b) / 2.0"}
