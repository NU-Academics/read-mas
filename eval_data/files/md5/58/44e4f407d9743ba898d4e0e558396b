{"task_id": "HumanEval/56", "solution": "from enum import Enum\n\nclass BracketType(Enum):\n    \"\"\"Defines the types of brackets.\"\"\"\n    OPEN = '<'\n    CLOSE = '>'\n\nclass Bracket:\n    \"\"\"Represents a single bracket character.\"\"\"\n    def __init__(self, character: str):\n        if character == '<':\n            self._type = BracketType.OPEN\n        elif character == '>':\n            self._type = BracketType.CLOSE\n        else:\n            raise ValueError(f\"Invalid bracket character: {character}\")\n        self._character = character\n\n    def is_open(self) -> bool:\n        \"\"\"Checks if the bracket is an opening bracket.\"\"\"\n        return self._type == BracketType.OPEN\n\n    def is_close(self) -> bool:\n        \"\"\"Checks if the bracket is a closing bracket.\"\"\"\n        return self._type == BracketType.CLOSE\n\n    def get_type(self) -> BracketType:\n        \"\"\"Returns the type of the bracket.\"\"\"\n        return self._type\n\nclass BracketString:\n    \"\"\"Manages a bracket string and checks its correctness.\"\"\"\n    def __init__(self, brackets_string: str):\n        self._value = brackets_string\n\n    def check_correctness(self) -> bool:\n        \"\"\"Determines if the bracket string is correctly bracketed.\"\"\"\n        balance = 0\n        for char in self._value:\n            try:\n                bracket = Bracket(char)\n            except ValueError:\n                # Return False for unexpected characters.\n                return False\n\n            if bracket.is_open():\n                balance += 1\n            elif bracket.is_close():\n                balance -= 1\n\n            # If balance drops below zero, a closing bracket appeared without a preceding open bracket.\n            if balance < 0:\n                return False\n\n        # The total count of opening brackets must equal the total count of closing brackets.\n        return balance == 0\n\ndef correct_bracketing(brackets: str) -> bool:\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n\n    >>> correct_bracketing(\"<\")\n    False\n    >>> correct_bracketing(\"<>\")\n    True\n    >>> correct_bracketing(\"<<><>>\")\n    True\n    >>> correct_bracketing(\"><<>\")\n    False\n    \"\"\"\n    bracket_string_obj = BracketString(brackets)\n    return bracket_string_obj.check_correctness()"}
