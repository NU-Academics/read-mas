{"task_id": "HumanEval/82", "solution": "```python\ndef prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    import math\n\n    length = len(string)\n\n    if length < 2:\n        return False\n\n    if length == 2:\n        return True\n\n    if length % 2 == 0:\n        return False\n\n    for i in range(3, int(math.isqrt(length)) + 1, 2):\n        if length % i == 0:\n            return False\n\n    return True\n```"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write\n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A\n            > 3.3                A-\n            > 3.0                B+\n            > 2.7                B\n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+\n            > 0.7                D\n            > 0.0                D-\\\n              0.0                E\n\n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    class GradingRule:\n        \"\"\"Encapsulates a single GPA to letter grade mapping rule.\"\"\"\n        def __init__(self, gpa_threshold, comparison_operator, letter_grade):\n            self.gpa_threshold = gpa_threshold\n            self.comparison_operator = comparison_operator\n            self.letter_grade = letter_grade\n\n        def applies(self, gpa):\n            \"\"\"Checks if the given GPA satisfies this rule.\"\"\"\n            if self.comparison_operator == '==':\n                return gpa == self.gpa_threshold\n            elif self.comparison_operator == '>':\n                return gpa > self.gpa_threshold\n            return False\n\n    class GradingScale:\n        \"\"\"Manages and applies an ordered set of grading rules to convert a GPA.\"\"\"\n        def __init__(self):\n            # Rules are ordered from highest GPA to lowest to ensure correct application of ranges.\n            self._rules = [\n                GradingRule(4.0, '==', 'A+'),\n                GradingRule(3.7, '>', 'A'),\n                GradingRule(3.3, '>', 'A-'),\n                GradingRule(3.0, '>', 'B+'),\n                GradingRule(2.7, '>', 'B'),\n                GradingRule(2.3, '>', 'B-'),\n                GradingRule(2.0, '>', 'C+'),\n                GradingRule(1.7, '>', 'C'),\n                GradingRule(1.3, '>', 'C-'),\n                GradingRule(1.0, '>', 'D+'),\n                GradingRule(0.7, '>', 'D'),\n                GradingRule(0.0, '>', 'D-'),\n                GradingRule(0.0, '==', 'E')\n            ]\n\n        def convert_gpa(self, gpa):\n            \"\"\"Converts a single numerical GPA to its corresponding letter grade.\"\"\"\n            for rule in self._rules:\n                if rule.applies(gpa):\n                    return rule.letter_grade\n            return 'E' # Default case for GPA not covered, though rules should cover all.\n\n\n    scale = GradingScale()\n    letter_grades = []\n    for gpa in grades:\n        letter_grades.append(scale.convert_gpa(gpa))\n    return letter_grades"}
{"task_id": "HumanEval/83", "solution": "```python\ndef starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        # For n=1, the only 1-digit number is 1, which starts and ends with 1.\n        return 1\n    else:\n        # For n > 1, apply the Inclusion-Exclusion Principle.\n        # This simplifies to 18 * 10^(n-2).\n        return 18 * (10**(n - 2))\n```"}
{"task_id": "HumanEval/86", "solution": "def _sort_word_characters(word: str) -> str:\n    \"\"\"Sorts the characters of a single word based on their ASCII values.\"\"\"\n    return ''.join(sorted(word))\n\ndef anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n    result_parts = []\n    current_word = []\n\n    for char in s:\n        if char.isspace():\n            if current_word:\n                result_parts.append(_sort_word_characters(''.join(current_word)))\n                current_word = []\n            result_parts.append(char)\n        else:\n            current_word.append(char)\n\n    if current_word:\n        result_parts.append(_sort_word_characters(''.join(current_word)))\n\n    return ''.join(result_parts)"}
{"task_id": "HumanEval/84", "solution": "```python\nclass InputValidationError(ValueError):\n    \"\"\"Custom exception for invalid input N.\"\"\"\n    pass\n\ndef _validate_input(N: int) -> None:\n    \"\"\"\n    Validates if N is within [0, 10000] and is an integer.\n    Raises InputValidationError for invalid input.\n    \"\"\"\n    if not isinstance(N, int):\n        raise InputValidationError(\"Input N must be an integer.\")\n    if not (0 <= N <= 10000):\n        raise InputValidationError(f\"Input N must be between 0 and 10000, but got {N}.\")\n\ndef _calculate_digit_sum(N: int) -> int:\n    \"\"\"\n    Calculates the sum of the decimal digits of N.\n    For example, N=147 results in 1 + 4 + 7 = 12.\n    \"\"\"\n    total_sum = 0\n    s_n = str(N)\n    for digit_char in s_n:\n        total_sum += int(digit_char)\n    return total_sum\n\ndef _convert_to_binary_string(decimal_sum: int) -> str:\n    \"\"\"\n    Converts a decimal integer sum into its binary string representation.\n    Returns '0' for a sum of 0.\n    \"\"\"\n    if decimal_sum == 0:\n        return '0'\n\n    binary_digits = []\n    temp_sum = decimal_sum\n    while temp_sum > 0:\n        binary_digits.append(str(temp_sum % 2))\n        temp_sum //= 2\n\n    return ''.join(reversed(binary_digits))\n\ndef solve(N: int) -> str:\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    The sum of N's decimal digits is calculated, then converted to a binary string.\n    \"\"\"\n    _validate_input(N)\n    decimal_sum = _calculate_digit_sum(N)\n    binary_string = _convert_to_binary_string(decimal_sum)\n    return binary_string\n```"}
{"task_id": "HumanEval/88", "solution": "```python\ndef sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    # Handle empty or single-element arrays by returning a copy.\n    if not array or len(array) == 1:\n        return list(array)\n\n    # Create a copy of the original array to avoid modifying it.\n    copied_array = list(array)\n\n    # Calculate the sum of the first and last elements to determine sorting order.\n    total_sum = copied_array[0] + copied_array[-1]\n\n    # Sort the copied array based on whether the sum is odd (ascending) or even (descending).\n    if total_sum % 2 != 0:\n        copied_array.sort()\n    else:\n        copied_array.sort(reverse=True)\n\n    return copied_array\n```\n"}
{"task_id": "HumanEval/87", "solution": "```python\ndef get_row(lst, x):\n    \"\"\"\n    Finds occurrences of integer x in a nested list lst and returns their 0-indexed (row, column) coordinates.\n    The coordinates are sorted primarily by row (ascending) and secondarily by column (descending).\n    \"\"\"\n\n    class Coordinate:\n        \"\"\"Encapsulates a (row, column) pair and defines custom comparison logic for sorting.\"\"\"\n        def __init__(self, row: int, column: int):\n            self.row = row\n            self.column = column\n\n        def __lt__(self, other) -> bool:\n            # Sort primarily by row in ascending order\n            if self.row != other.row:\n                return self.row < other.row\n            # Sort secondarily by column in descending order\n            return self.column > other.column\n\n        def to_tuple(self) -> tuple[int, int]:\n            \"\"\"Converts the Coordinate object to a (row, column) tuple.\"\"\"\n            return (self.row, self.column)\n\n    if not lst:\n        return []\n\n    found_coordinates = []\n    for r_idx, row_list in enumerate(lst):\n        for c_idx, element in enumerate(row_list):\n            if element == x:\n                found_coordinates.append(Coordinate(r_idx, c_idx))\n\n    # Sort the list of Coordinate objects using the custom __lt__ method.\n    found_coordinates.sort()\n\n    # Convert each Coordinate object to a tuple.\n    result_tuples = [coord.to_tuple() for coord in found_coordinates]\n\n    return result_tuples\n```\n"}
{"task_id": "HumanEval/89", "solution": "```python\ndef encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated.\n    The alphabet should be rotated in a manner such that the letters\n    shift down by two multiplied to two places.\n    For example:\n    encrypt('hi') returns 'lm'\n    encrypt('asdfghjkl') returns 'ewhjklnop'\n    encrypt('gf') returns 'kj'\n    encrypt('et') returns 'ix'\n    \"\"\"\n    _ALPHABET = \"abcdefghijklmnopqrstuvwxyz\"\n    _SHIFT_AMOUNT = 4 # The shift is two multiplied by two places.\n\n    def _shift_char(char, shift):\n        # Shifts a single lowercase alphabetic character; returns other characters unchanged.\n        if char in _ALPHABET:\n            original_index = _ALPHABET.index(char)\n            new_index = (original_index + shift) % len(_ALPHABET)\n            return _ALPHABET[new_index]\n        return char\n\n    encrypted_chars = []\n    for char in s:\n        encrypted_chars.append(_shift_char(char, _SHIFT_AMOUNT))\n\n    return \"\".join(encrypted_chars)\n```"}
