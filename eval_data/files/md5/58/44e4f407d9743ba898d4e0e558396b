{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\"\"\"\n\n    # Helper function to determine if a number is prime.\n    def _is_prime(num: int) -> bool:\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    # Helper function to identify and return all prime factors of a number.\n    def _get_prime_factors(n_val: int) -> list[int]:\n        all_factors = set()\n        # Find all factors of n_val up to its square root.\n        # For each factor 'i', its corresponding cofactor 'n_val // i' is also a factor.\n        for i in range(1, int(n_val**0.5) + 1):\n            if n_val % i == 0:\n                all_factors.add(i)\n                all_factors.add(n_val // i)\n\n        # Filter the collected factors, keeping only those that are prime.\n        actual_prime_factors = []\n        for factor in all_factors:\n            if _is_prime(factor):\n                actual_prime_factors.append(factor)\n        return actual_prime_factors\n\n    prime_factors = _get_prime_factors(n)\n    # Since n > 1 and is not prime, prime_factors will contain at least one element.\n    return max(prime_factors)"}
{"task_id": "HumanEval/63", "solution": "```python\n_memo = {}\n\ndef fibfib(n: int):\n    \"\"\"Computes the n-th element of the FibFib sequence efficiently using memoization.\"\"\"\n    if n in _memo:\n        return _memo[n]\n\n    if n == 0:\n        result = 0\n    elif n == 1:\n        result = 0\n    elif n == 2:\n        result = 1\n    else:\n        result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n\n    _memo[n] = result\n    return result\n```"}
{"task_id": "HumanEval/61", "solution": "```python\ndef correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            if balance == 0:\n                return False\n            balance -= 1\n    return balance == 0\n```"}
{"task_id": "HumanEval/62", "solution": "```python\ndef derivative(xs: list) -> list:\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    n = len(xs)\n\n    if n <= 1:\n        return []\n\n    derived_coefficients = []\n    for j in range(n - 1):\n        # The coefficient for x^j in the derivative is (j+1) * original_coefficient_of_x^(j+1).\n        derived_coefficients.append((j + 1) * xs[j + 1])\n\n    return derived_coefficients\n```"}
