{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n\n    def _split_paren_groups(paren_string: str) -> List[str]:\n        \"\"\"Splits the input string into a list of individual parenthesis groups.\"\"\"\n        return paren_string.split(' ')\n\n    def _calculate_deepest_nesting(group_content: str) -> int:\n        \"\"\"Calculates the deepest level of nesting for a single parenthesis group.\"\"\"\n        current_level = 0\n        max_level = 0\n        for char in group_content:\n            if char == '(':\n                current_level += 1\n                max_level = max(max_level, current_level)\n            elif char == ')':\n                current_level -= 1\n        return max_level\n\n    groups = _split_paren_groups(paren_string)\n    results = []\n    for group in groups:\n        if group:  # Ensure not to process empty strings resulting from multiple spaces\n            results.append(_calculate_deepest_nesting(group))\n    return results"}
{"task_id": "HumanEval/8", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n    return (total_sum, total_product)\n```"}
{"task_id": "HumanEval/9", "solution": "```python\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result_list = []\n    current_max = float('-inf')  # Initialize current maximum with negative infinity.\n\n    for number in numbers:\n        current_max = max(current_max, number)  # Update current_max if the current number is greater.\n        result_list.append(current_max)         # Append the current rolling maximum to the result list.\n\n    return result_list\n```"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    # Find the longest palindromic suffix\n    # Iterate from the start of the string to find the smallest index `i`\n    # such that `string[i:]` is a palindrome. This `string[i:]` will be\n    # the longest palindromic suffix.\n    for i in range(len(string)):\n        if string[i:] == string[i:][::-1]:\n            # Found the longest palindromic suffix\n            # The prefix that comes before it is string[0:i]\n            prefix_to_reverse = string[0:i]\n            return string + prefix_to_reverse[::-1]\n\n    # This part should ideally not be reached for non-empty strings\n    # as a single character (the last char) is always a palindrome,\n    # meaning i=len(string)-1 would always be found.\n    return string"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    # Helper to validate if a string consists only of '0's and '1's.\n    def _validate_binary_string(s: str, param_name: str) -> None:\n        if not all(char in ('0', '1') for char in s):\n            raise ValueError(f\"Input '{param_name}' must consist only of '0's and '1's.\")\n\n    # Helper to perform XOR on two single binary characters.\n    def _perform_bitwise_xor_logic(char_a: str, char_b: str) -> str:\n        return '0' if char_a == char_b else '1'\n\n    _validate_binary_string(a, 'a')\n    _validate_binary_string(b, 'b')\n\n    result_chars: List[str] = []\n    for i in range(len(a)):\n        xor_char = _perform_bitwise_xor_logic(a[i], b[i])\n        result_chars.append(xor_char)\n\n    return \"\".join(result_chars)"}
