{"task_id": "HumanEval/64", "solution": "```python\ndef vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    \"\"\"\n    count = 0\n    s_lower = s.lower()\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    for i, char in enumerate(s_lower):\n        if char in standard_vowels:\n            count += 1\n        elif char == 'y' and i == len(s_lower) - 1:\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/67", "solution": "import re\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket.\n    Parses the input string s for apple and orange counts, then calculates and returns the number of mango fruits.\n    \"\"\"\n    apple_match = re.search(r\"(\\d+)\\s*apples\", s)\n    apple_count = int(apple_match.group(1)) if apple_match else 0\n\n    orange_match = re.search(r\"(\\d+)\\s*oranges\", s)\n    orange_count = int(orange_match.group(1)) if orange_match else 0\n\n    mango_count = n - apple_count - orange_count\n    return max(0, mango_count)```"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Given an array of non-negative integers, this function finds the node with the smallest even value.\n    If multiple nodes share the smallest even value, the one with the smallest index is chosen.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = None\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:\n            if smallest_even_value is None or value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            # The condition for value == smallest_even_value and index < smallest_even_index\n            # is implicitly handled because we iterate from left to right.\n            # The first time we find the smallest_even_value, its index will be the smallest.\n\n    if smallest_even_value is None:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    if x < 0:\n        # As per design context, assuming non-negative integers for digit manipulation,\n        # or handling negative sign implicitly by str(x).\n        pass\n\n    digits = list(str(x))\n    num_digits = len(digits)\n\n    if shift > num_digits:\n        manipulated_digits = digits[::-1]\n    else:\n        if not digits:\n            manipulated_digits = []\n        else:\n            actual_shift = shift % num_digits\n            manipulated_digits = digits[-actual_shift:] + digits[:-actual_shift]\n\n    return \"\".join(manipulated_digits)"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    \"\"\"\n    Finds the greatest integer x in a non-empty list of positive integers\n    such that x > 0 and the frequency of x in the list is greater than or equal to x.\n    If no such integer exists, returns -1.\n    \"\"\"\n    frequencies = {}\n    for x in lst:\n        frequencies[x] = frequencies.get(x, 0) + 1\n\n    valid_candidates = []\n    for x, freq in frequencies.items():\n        if x > 0 and freq >= x:\n            valid_candidates.append(x)\n\n    if not valid_candidates:\n        return -1\n    else:\n        return max(valid_candidates)"}
{"task_id": "HumanEval/70", "solution": "```python\nclass _SortableIntegerList:\n    \"\"\"Manages a mutable list of integers, providing efficient min/max retrieval and removal.\"\"\"\n    def __init__(self, initial_list: list[int]):\n        \"\"\"Initializes the list manager with a sorted copy of the input list.\"\"\"\n        self._elements = sorted(initial_list)\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the list is empty.\"\"\"\n        return not self._elements\n\n    def get_and_remove_min(self) -> int:\n        \"\"\"Retrieves and removes the minimum element from the list.\"\"\"\n        return self._elements.pop(0)\n\n    def get_and_remove_max(self) -> int:\n        \"\"\"Retrieves and removes the maximum element from the list.\"\"\"\n        return self._elements.pop()\n\ndef strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    list_manager = _SortableIntegerList(lst)\n    result = []\n\n    while not list_manager.is_empty():\n        result.append(list_manager.get_and_remove_min())\n        if not list_manager.is_empty():\n            result.append(list_manager.get_and_remove_max())\n\n    return result\n```"}
{"task_id": "HumanEval/72", "solution": "```python\ndef will_it_fly(q,w):\n    '''\n    Checks if an object q will fly by verifying if it's a palindromic list and its sum is within weight w.\n    '''\n    def _is_palindrome(lst):\n        # Checks if a list is a palindrome.\n        return lst == lst[::-1]\n\n    def _calculate_sum(lst):\n        # Calculates the sum of elements in a list.\n        return sum(lst)\n\n    if not _is_palindrome(q):\n        return False\n\n    total_weight = _calculate_sum(q)\n    if total_weight > w:\n        return False\n\n    return True\n```"}
{"task_id": "HumanEval/71", "solution": "```python\nimport math\n\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater\n    than the third side.\n    '''\n    class Triangle:\n        '''\n        Encapsulates triangle side lengths and provides methods for validation and area calculation.\n        '''\n        def __init__(self, a_side: float, b_side: float, c_side: float):\n            self._sideA = a_side\n            self._sideB = b_side\n            self._sideC = c_side\n\n        def is_valid(self) -> bool:\n            '''Checks if the current side lengths form a valid triangle.'''\n            if not (self._sideA > 0 and self._sideB > 0 and self._sideC > 0):\n                return False\n            return (self._sideA + self._sideB > self._sideC and\n                    self._sideA + self._sideC > self._sideB and\n                    self._sideB + self._sideC > self._sideA)\n\n        def _calculate_semi_perimeter(self) -> float:\n            '''Calculates the semi-perimeter s.'''\n            return (self._sideA + self._sideB + self._sideC) / 2\n\n        def calculate_area(self) -> float:\n            '''Calculates the area using Heron's formula.'''\n            s = self._calculate_semi_perimeter()\n            # The term under the square root can be very slightly negative due to floating point inaccuracies\n            # for degenerate triangles (where area should be 0). Max(0, ...) handles this.\n            area_squared_term = s * (s - self._sideA) * (s - self._sideB) * (s - self._sideC)\n            return math.sqrt(max(0, area_squared_term))\n\n    triangle_obj = Triangle(a, b, c)\n\n    if triangle_obj.is_valid():\n        raw_area = triangle_obj.calculate_area()\n        return round(raw_area, 2)\n    else:\n        return -1\n```"}
{"task_id": "HumanEval/73", "solution": "```python\ndef smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic.\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes\n```"}
{"task_id": "HumanEval/74", "solution": "```python\ndef total_match(lst1, lst2):\n    '''\n    Write a function that accepts two lists of strings and returns the list that has\n    total number of chars in the all strings of the list less than the other list.\n\n    if the two lists have the same number of chars, return the first list.\n    '''\n\n    def _calculate_total_characters(string_list):\n        \"\"\"Calculates the sum of lengths of all strings in a given list.\"\"\"\n        total_chars = 0\n        for s in string_list:\n            total_chars += len(s)\n        return total_chars\n\n    count1 = _calculate_total_characters(lst1)\n    count2 = _calculate_total_characters(lst2)\n\n    if count1 < count2:\n        return lst1\n    elif count2 < count1:\n        return lst2\n    else:  # count1 == count2\n        return lst1\n```"}
{"task_id": "HumanEval/75", "solution": "```python\ndef is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    def _is_prime(n):\n        # Checks if a given integer n is a prime number.\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    def _get_prime_factors(n):\n        # Finds and returns a list of all prime factors for a given integer n, including duplicates.\n        factors = []\n        d = 2\n        temp_n = n\n        while d * d <= temp_n:\n            while temp_n % d == 0:\n                factors.append(d)\n                temp_n //= d\n            d += 1\n        if temp_n > 1:\n            factors.append(temp_n)\n        return factors\n\n    # As per design context, validate input 'a'. A number must be at least 2*2*2 = 8\n    # to be a product of three primes, and 'a' is less than 100 as per problem statement.\n    if a < 8 or a >= 100:\n        return False\n\n    factors = _get_prime_factors(a)\n    return len(factors) == 3\n```"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Checks if an integer 'a' is a perfect cube.\n    Handles positive, negative, and zero inputs.\n    '''\n    if a == 0:\n        return True\n\n    if a > 0:\n        # Calculate the cube root for positive numbers\n        root = round(a**(1/3))\n        return root**3 == a\n    else: # a < 0\n        # For negative numbers, calculate the cube root of the absolute value,\n        # then apply the negative sign to the rounded integer root.\n        abs_root = round((abs(a))**(1/3))\n        root = -abs_root\n        return root**3 == a"}
