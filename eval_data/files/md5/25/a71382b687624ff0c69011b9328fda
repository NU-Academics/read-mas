{"task_id": "Mbpp/80", "solution": "class InputValidator:\n    def is_valid_integer(self, n) -> bool:\n        \"\"\"Checks if the input is a valid integer (not a boolean).\"\"\"\n        return isinstance(n, int) and not isinstance(n, bool)\n\nclass TetrahedralNumberCalculator:\n    def tetrahedral_number(self, n: int) -> int:\n        \"\"\"Calculates the nth tetrahedral number using the closed-form formula.\"\"\"\n        return (n * (n + 1) * (n + 2)) // 6\n\ndef tetrahedral_number(n) -> int:\n    \"\"\"\n    Finds the nth tetrahedral number.\n    Raises TypeError if n is not a valid integer.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.is_valid_integer(n):\n        raise TypeError('Parameter n must be an integer')\n    \n    calculator = TetrahedralNumberCalculator()\n    return calculator.tetrahedral_number(n)"}
{"task_id": "Mbpp/84", "solution": "def sequence(n: int) -> int:\n    \"\"\"\n    Calculates the nth number in the Newman-Conway sequence.\n    Raises ValueError for invalid input (n not an integer or n < 1).\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n    if n == 1 or n == 2:\n        return 1\n\n    # P[i] will store the i-th Newman-Conway number.\n    # We use a list and 1-based indexing for convenience (P[0] is unused).\n    P = [0] * (n + 1)\n    P[1] = 1\n    P[2] = 1\n\n    for i in range(3, n + 1):\n        # Newman-Conway formula: P(n) = P(P(n-1)) + P(n - P(n-1))\n        P[i] = P[P[i-1]] + P[i - P[i-1]]\n\n    return P[n]"}
{"task_id": "Mbpp/86", "solution": "class InvalidInputException(ValueError):\n    \"\"\"Exception raised for invalid input to the centered_hexagonal_number function.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self._message = message\n\n    @property\n    def type(self) -> str:\n        return self.__class__.__name__\n\n    @property\n    def message(self) -> str:\n        return self._message\n\nclass InputValidator:\n    \"\"\"Validates input for centered hexagonal number calculation.\"\"\"\n    def validate(self, n: int) -> bool:\n        return isinstance(n, int) and n >= 1\n\nclass CenteredHexagonalCalculator:\n    \"\"\"Calculates centered hexagonal numbers using the defined formula.\"\"\"\n    def computeFormula(self, n: int) -> int:\n        return 3 * n * (n - 1) + 1\n\n# Instantiate stateless helper objects once at the module level.\n_validator = InputValidator()\n_calculator = CenteredHexagonalCalculator()\n\ndef centered_hexagonal_number(n: int) -> int:\n    \"\"\"\n    Computes the nth centered hexagonal number.\n    Raises InvalidInputException if n is not an integer >= 1.\n    \"\"\"\n    if not _validator.validate(n):\n        raise InvalidInputException('n must be integer >= 1')\n    return _calculator.computeFormula(n)"}
