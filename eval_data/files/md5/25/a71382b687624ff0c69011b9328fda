{"task_id": "Mbpp/91", "solution": "def find_substring(list_of_strings, target_substring):\n    \"\"\"\n    Checks if a target substring is present in any string within a list.\n    Returns True on the first match, otherwise False after checking all strings.\n    \"\"\"\n    for s in list_of_strings:\n        if target_substring in s:\n            return True\n    return False"}
{"task_id": "Mbpp/92", "solution": "from typing import List\n\nclass NumberValue:\n    \"\"\"Represent input integer and provide absolute value and digit extraction utilities.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def get_absolute_value(self) -> int:\n        \"\"\"Return the absolute value of the number.\"\"\"\n        return abs(self.value)\n\n    def to_digit_list(self) -> List[int]:\n        \"\"\"Return a list of base-10 digits of the absolute value (most-significant first).\"\"\"\n        abs_value = self.get_absolute_value()\n        if abs_value == 0:\n            return [0]\n        return [int(d) for d in str(abs_value)]\n\nclass DigitSequence:\n    \"\"\"Hold a digit list and evaluate the undulating/alternation business rule.\"\"\"\n    def __init__(self, digits: List[int]):\n        self.digits = digits\n        self.length = len(digits)\n\n    def is_alternating(self) -> bool:\n        \"\"\"\n        Returns True if the sequence is undulating (alternating digits A, B, A, B...)\n        and A != B. Returns False if length < 2 or the pattern is not met.\n        \"\"\"\n        if self.length < 2:\n            return False\n\n        digit_a = self.digits[0]\n        digit_b = self.digits[1]\n\n        if digit_a == digit_b:\n            return False\n\n        for i in range(2, self.length):\n            if i % 2 == 0:  # Even position (0-indexed) should match digit_a\n                if self.digits[i] != digit_a:\n                    return False\n            else:  # Odd position (0-indexed) should match digit_b\n                if self.digits[i] != digit_b:\n                    return False\n        return True\n\nclass Result:\n    \"\"\"Simple carrier for the boolean outcome of the undulating check.\"\"\"\n    def __init__(self, is_undulating: bool):\n        self.is_undulating = is_undulating\n\nclass UndulatingChecker:\n    \"\"\"Validate input and coordinate NumberValue and DigitSequence to produce the undulating decision.\"\"\"\n    def validate_input(self, number) -> None:\n        \"\"\"Enforce integer input; raises TypeError for non-int.\"\"\"\n        if not isinstance(number, int):\n            raise TypeError(\"Input must be an integer.\")\n\n    def is_undulating(self, number: int) -> bool:\n        \"\"\"Orchestrates validation, absolute-value handling, digit extraction, and alternation check.\"\"\"\n        self.validate_input(number)\n        \n        number_value = NumberValue(number)\n        digits = number_value.to_digit_list()\n        \n        digit_sequence = DigitSequence(digits)\n        \n        is_undulating_result = digit_sequence.is_alternating()\n        \n        result_carrier = Result(is_undulating_result)\n        return result_carrier.is_undulating\n\ndef is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks whether the given number is undulating.\n    An undulating number has alternating digits, e.g., 1212121.\n    \"\"\"\n    checker = UndulatingChecker()\n    return checker.is_undulating(number)"}
{"task_id": "Mbpp/88", "solution": "def freq_count(inputList) -> dict:\n    \"\"\"\n    Compute and return a dictionary mapping each distinct element in inputList to its integer count.\n    A TypeError is raised if inputList is not a list or if an element is not hashable.\n    \"\"\"\n    if not isinstance(inputList, list):\n        raise TypeError(\"inputList must be a list\")\n\n    counts = {}\n    for element in inputList:\n        counts[element] = counts.get(element, 0) + 1\n    return counts"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(list_of_tuples):\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value.\n    Assumes the input list is non-empty and contains 2-element tuples with comparable second values.\n    \"\"\"\n    min_second_value = list_of_tuples[0][1]\n    result_first_value = list_of_tuples[0][0]\n\n    for first_val, second_val in list_of_tuples[1:]:\n        if second_val < min_second_value:\n            min_second_value = second_val\n            result_first_value = first_val\n\n    return result_first_value"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists: list) -> int:\n    \"\"\"Compute and return the minimum length among inner lists.\n    Note: SRS does not fully define behavior for empty outer list; implementation raises ValueError if list_of_lists is empty.\"\"\"\n    if not list_of_lists:\n        raise ValueError('list_of_lists must contain at least one inner list')\n    lengths = (len(inner) for inner in list_of_lists)\n    return int(min(lengths))"}
{"task_id": "Mbpp/96", "solution": "import math\n\ndef _is_integer(n) -> bool:\n    \"\"\"Check if n is an instance of int.\"\"\"\n    return isinstance(n, int)\n\ndef _is_positive(n) -> bool:\n    \"\"\"Check if n is a positive integer (n >= 1).\"\"\"\n    return n >= 1\n\ndef divisor(n) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer n.\n    Raises TypeError for non-integer input or ValueError for non-positive input.\n    \"\"\"\n    if not _is_integer(n):\n        raise TypeError(\"Input must be an integer.\")\n    if not _is_positive(n):\n        raise ValueError(\"Input must be a positive integer.\")\n\n    count = 0\n    # Iterate from 1 up to the integer square root of n.\n    # math.isqrt(n) returns floor(sqrt(n)).\n    limit = math.isqrt(n)\n\n    for i in range(1, limit + 1):\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n    return count"}
{"task_id": "Mbpp/98", "solution": "def computeProduct(seq) -> float:\n    \"\"\"Computes the multiplicative product of all elements in a sequence.\"\"\"\n    product = 1.0\n    for num in seq:\n        product *= num\n    return product\n\ndef divideByLength(product: float, length: int) -> float:\n    \"\"\"Divides a product by a given length.\"\"\"\n    return product / length\n\ndef multiply_num(sequence):\n    \"\"\"Multiplies all numbers in a sequence and divides by its length.\"\"\"\n    seq_length = len(sequence)\n    product = computeProduct(sequence)\n    result = divideByLength(product, seq_length)\n    return result"}
{"task_id": "Mbpp/97", "solution": "from typing import Any, Dict, List\n\nListOfLists = List[List[Any]]\nFrequencyMap = Dict[Any, int]\n\nclass FrequencyCalculator:\n    @staticmethod\n    def frequency_lists(list_of_lists: ListOfLists) -> FrequencyMap:\n        \"\"\"Flattens a list of lists and counts the frequency of each element.\"\"\"\n        counts: Dict[Any, int] = {}\n        for inner in list_of_lists:\n            for element in inner:\n                counts[element] = counts.get(element, 0) + 1\n        return counts\n\ndef frequency_lists(list_of_lists: ListOfLists) -> FrequencyMap:\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists.\n    Delegates the core logic to an internal FrequencyCalculator.\n    \"\"\"\n    return FrequencyCalculator.frequency_lists(list_of_lists)"}
{"task_id": "Mbpp/99", "solution": "\"\"\"\nImplements decimal_to_binary(decimal_value: int) -> str.\nConverts a decimal integer to its binary string representation.\nConstraints: function name, input type (int), output type (str), and formatting rule (no leading zeros, except input 0 -> '0').\n\"\"\"\n\ndef decimal_to_binary(decimal_value: int) -> str:\n    \"\"\"\n    Convert a decimal integer to its binary string representation with no leading zeros.\n\n    Preconditions (from SRS): decimal_value is an integer.\n    Postconditions (from SRS): returns a string of '0' and '1' characters; if decimal_value == 0 return '0'; otherwise no leading zeros.\n    \"\"\"\n    if decimal_value == 0:\n        return '0'\n\n    binary_string = \"\"\n    temp_value = decimal_value\n    while temp_value > 0:\n        remainder = temp_value % 2\n        binary_string = str(remainder) + binary_string\n        temp_value //= 2\n    return binary_string"}
{"task_id": "Mbpp/101", "solution": "from typing import Any, List\n\nclass InvalidIndexError(Exception):\n    \"\"\"Domain-specific exception for out-of-range index accesses.\"\"\"\n    def __init__(self, message: str, code: str = 'INVALID_INDEX') -> None:\n        self.message = message\n        self.code = code\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return f\"[{self.code}] {self.message}\"\n\nclass Element:\n    \"\"\"Value object holding a single element value and its 1-based position.\"\"\"\n    def __init__(self, value: Any, position: int) -> None:\n        self.value = value\n        self.position = position\n\nclass Array:\n    \"\"\"Represents a sequence of elements and provides length and element access.\"\"\"\n    def __init__(self, elements: List[Any]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self.elements)\n\n    def get_element_at_1_based(self, k: int) -> Element:\n        \"\"\"Returns the Element at 1-based position k.\"\"\"\n        # This method assumes k is already validated as per kth_element's logic.\n        # It's primarily for internal Array usage and consistency with Element wrapper.\n        return Element(self.elements[k - 1], k)\n\ndef kth_element(array, k: int) -> Any:\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    Raises InvalidIndexError if k is out of range.\n    \"\"\"\n    if not isinstance(array, Array):\n        array_obj = Array(list(array))\n    else:\n        array_obj = array\n\n    n = array_obj.length()\n\n    if k < 1 or k > n:\n        raise InvalidIndexError(f\"k ({k}) out of range: must be 1..{n}\", 'INVALID_INDEX')\n\n    element = array_obj.get_element_at_1_based(k)\n    return element.value"}
{"task_id": "Mbpp/100", "solution": "def is_palindrome(x: int) -> bool:\n    \"\"\"Checks if an integer is a numeric palindrome.\"\"\"\n    s = str(x)\n    return s == s[::-1]\n\ndef mirror_left_to_right(x: int) -> int:\n    \"\"\"\n    Constructs an integer by mirroring its left half to create a palindrome.\n    For an even length number like 1234, left half \"12\" mirrors to \"1221\".\n    \"\"\"\n    s_x = str(x)\n    n_digits = len(s_x)\n    \n    left_half = s_x[0 : (n_digits + 1) // 2]\n    right_half_reversed_segment = left_half[0 : n_digits // 2]\n    \n    mirrored_str = left_half + right_half_reversed_segment[::-1]\n    return int(mirrored_str)\n\ndef increment_middle(x: int) -> int:\n    \"\"\"\n    Increments the 'middle' part of an integer, handling carries.\n    This intermediate result is then mirrored to form the next palindrome.\n    \"\"\"\n    s = str(x)\n    n = len(s)\n    \n    left_half_len = (n + 1) // 2\n    left_part_str = s[0:left_half_len]\n    \n    incremented_left_int = int(left_part_str) + 1\n    incremented_left_str = str(incremented_left_int)\n    \n    remaining_digits_len = n - left_half_len\n    \n    if len(incremented_left_str) > left_half_len:\n        incremented_s = incremented_left_str + '0' * remaining_digits_len\n    else:\n        incremented_s = incremented_left_str + s[left_half_len:]\n        \n    return int(incremented_s)\n\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome of a specified integer, returned as an integer.\n    assert next_smallest_palindrome(99)==101\n    \"\"\"\n    candidate = mirror_left_to_right(n)\n\n    if candidate > n:\n        return candidate\n    else:\n        incremented_n = increment_middle(n)\n        new_candidate = mirror_left_to_right(incremented_n)\n        return new_candidate"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(snake_str: str) -> str:\n    \"\"\"Convert snake_case string to CamelCase.\n\n    Splits the input on underscores, capitalizes the first character of each non-empty segment,\n    and concatenates them without underscores.\n    \"\"\"\n    segments = snake_str.split('_')\n    camel_segments = [s.capitalize() for s in segments]\n    return \"\".join(camel_segments)"}
{"task_id": "Mbpp/103", "solution": "class ValueErrorHandler:\n    \"\"\"Handles raising ValueErrors with specific messages.\"\"\"\n    def raise_error(self, msg):\n        raise ValueError(msg)\n\nclass InputValidator:\n    \"\"\"Validates inputs for Eulerian number computation.\"\"\"\n    def __init__(self):\n        self._error_handler = ValueErrorHandler()\n\n    def validate(self, n, m):\n        if not isinstance(n, int) or not isinstance(m, int):\n            self._error_handler.raise_error(\"inputs must be integers\")\n        if n < 0:\n            self._error_handler.raise_error(\"n must be >= 0\")\n        if n == 0 and m != 0:\n            self._error_handler.raise_error(\"for n==0 only m==0 is valid\")\n        if n > 0 and not (0 <= m <= n - 1):\n            self._error_handler.raise_error(f\"m must be between 0 and {n-1} for n>0\")\n\nclass BinomialCoefficient:\n    \"\"\"Computes exact integer binomial coefficients C(n, k).\"\"\"\n    def C(self, n, k):\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        if k > n // 2:\n            k = n - k\n        \n        res = 1\n        for i in range(k):\n            res = res * (n - i) // (i + 1)\n        return res\n\nclass PowerService:\n    \"\"\"Provides integer exponentiation.\"\"\"\n    def pow(self, base, exp):\n        return base ** exp\n\nclass EulerianNumberCalculator:\n    \"\"\"Calculates Eulerian numbers using the combinatorial sum formula.\"\"\"\n    def __init__(self):\n        self._binom = BinomialCoefficient()\n        self._power = PowerService()\n\n    def compute_sum(self, n, m):\n        total = 0\n        for k in range(m + 1):\n            binom_val = self._binom.C(n + 1, k)\n            power_val = self._power.pow(m + 1 - k, n)\n            term = ((-1)**k) * binom_val * power_val\n            total += term\n        return total\n\ndef eulerian_num(n, m):\n    \"\"\"\n    Computes the Eulerian number a(n, m) using a combinatorial sum.\n    Validates inputs, handles base cases, and delegates computation.\n    \"\"\"\n    InputValidator().validate(n, m)\n    if n == 0 and m == 0:\n        return 1\n    \n    calc = EulerianNumberCalculator()\n    return calc.compute_sum(n, m)"}
{"task_id": "Mbpp/104", "solution": "def sort_sublists(inputSequence):\n    \"\"\"\n    Accepts: inputSequence -- a sequence (list or tuple) whose elements are sequences (list or tuple) of strings.\n    Returns: list of lists of strings where each inner list is sorted lexicographically ascending and outer order is preserved.\n    \"\"\"\n    result = []\n    for sub in inputSequence:\n        lst = list(sub)\n        lst.sort()\n        result.append(lst)\n    return result"}
{"task_id": "Mbpp/106", "solution": "def add_lists(list_param, tuple_param):\n    \"\"\"\n    Appends elements of a list to a tuple, returning a new tuple.\n    The original list and tuple remain unchanged.\n    \"\"\"\n    return tuple_param + tuple(list_param)"}
{"task_id": "Mbpp/105", "solution": "from typing import Iterable, Any\n\ndef _is_strict_true(element: Any) -> bool:\n    \"\"\"Returns True if the element is strictly the boolean True.\"\"\"\n    return isinstance(element, bool) and element is True\n\ndef count(input_list: Iterable[Any]) -> int:\n    \"\"\"Return number of elements in input_list that are strictly boolean True.\"\"\"\n    true_count = 0\n    for element in input_list:\n        if _is_strict_true(element):\n            true_count += 1\n    return true_count"}
{"task_id": "Mbpp/108", "solution": "def merge_sorted_list(list1: list[int], list2: list[int], list3: list[int]) -> list[int]:\n    \"\"\"\n    Merges three lists into a single sorted list.\n    Handles unsorted inputs, duplicates, and returns a new sorted list.\n    \"\"\"\n\n    def _validate_inputs(l1, l2, l3) -> None:\n        # As per instructions, skipping explicit isinstance checks or raising exceptions for edge cases.\n        # This function would typically validate that inputs are lists of integers.\n        pass\n\n    def _merge_lists(l1: list[int], l2: list[int], l3: list[int]) -> list[int]:\n        \"\"\"Concatenates elements from the three input lists into a single list.\"\"\"\n        return l1 + l2 + l3\n\n    def _sort_list(merged: list[int]) -> list[int]:\n        \"\"\"Sorts the merged list into ascending (non-decreasing) order.\"\"\"\n        return sorted(merged)\n\n    _validate_inputs(list1, list2, list3)\n    merged = _merge_lists(list1, list2, list3)\n    result = _sort_list(merged)\n    return result"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists: list[list[int]]) -> list[int]:\n    \"\"\"Compute unique integers present in every inner list of nested_lists.\n\n    Returns a list of ints; each returned value appears in every inner list; no duplicates.\n    \"\"\"\n    if not nested_lists:\n        return []\n\n    # Initialize common_elements with the first list converted to a set\n    common_elements = set(nested_lists[0])\n\n    # Intersect with subsequent lists\n    for i in range(1, len(nested_lists)):\n        common_elements.intersection_update(set(nested_lists[i]))\n        # Optimization: if common_elements becomes empty, no further intersection will yield results\n        if not common_elements:\n            break\n\n    return list(common_elements)"}
{"task_id": "Mbpp/113", "solution": "import re\nfrom dataclasses import dataclass\nfrom typing import Pattern\n\nclass IntegerPattern:\n    \"\"\"Encapsulates the regex pattern for integer validation.\"\"\"\n    def __init__(self):\n        self.pattern: str = r\"^[+-]?[0-9]+$\"\n        self._compiled: Pattern[str] = re.compile(self.pattern)\n\n    def matches(self, s: str) -> bool:\n        \"\"\"Checks if the string exactly matches the integer pattern.\"\"\"\n        return bool(self._compiled.match(s))\n\n@dataclass\nclass ValidationResult:\n    \"\"\"Represents the boolean outcome of a validation.\"\"\"\n    is_integer: bool\n\ndef check_integer(input: str) -> bool:\n    \"\"\"Checks if a string represents an integer, including optional sign.\"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"input must be a str\")\n    \n    pattern_checker = IntegerPattern()\n    matched = pattern_checker.matches(input)\n    return bool(matched)"}
{"task_id": "Mbpp/109", "solution": "class Validator:\n    \"\"\"Validates input binary string and rotation count.\"\"\"\n    def validate_string(self, binary_string: str) -> None:\n        \"\"\"Raises ValueError if binary_string is not valid (empty or invalid characters).\"\"\"\n        if not binary_string or not all(c in '01' for c in binary_string):\n            raise ValueError(\"binary_string must contain only '0' and '1' and must not be empty\")\n\n    def validate_rotations(self, rotations: int) -> None:\n        \"\"\"Raises ValueError if rotations is not a non-negative integer.\"\"\"\n        if not isinstance(rotations, int) or rotations < 0:\n            raise ValueError(\"rotations must be a non-negative integer\")\n\nclass BinaryString:\n    \"\"\"Encapsulates a binary string and provides length and LSB access by index offset.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the binary string.\"\"\"\n        return len(self._value)\n\n    def get_lsb(self, index_offset: int) -> str:\n        \"\"\"Returns the least-significant bit (rightmost char) after index_offset left-rotations.\"\"\"\n        n = self.length()\n        if n == 0:\n            return '' # Should be prevented by validation\n        # The character at original index (n - 1 + index_offset) % n becomes the LSB\n        original_index_of_lsb = (n - 1 + index_offset) % n\n        return self._value[original_index_of_lsb]\n\nclass RotationOperation:\n    \"\"\"Stateless utility for rotation index arithmetic.\"\"\"\n    def next_index(self, current_index: int, length: int) -> int:\n        \"\"\"Calculates the next index in a cyclic rotation.\"\"\"\n        if length == 0:\n            return 0 # Handle empty string case, though validation prevents it\n        return (current_index + 1) % length\n\nclass ResultCounter:\n    \"\"\"Maintains and exposes the count of odd configurations.\"\"\"\n    def __init__(self):\n        self._count = 0\n\n    def increment(self) -> None:\n        \"\"\"Increments the odd configuration count.\"\"\"\n        self._count += 1\n\n    def get_count(self) -> int:\n        \"\"\"Returns the current odd configuration count.\"\"\"\n        return self._count\n\ndef odd_Equivalent(binary_string, rotations) -> int:\n    \"\"\"Validate inputs, enumerate exactly 'rotations' cyclic-left configurations (starting with original),\n    count configurations whose LSB == '1', and return count as int.\"\"\"\n    validator = Validator()\n    validator.validate_string(binary_string)\n    validator.validate_rotations(rotations)\n\n    binary_str_obj = BinaryString(binary_string)\n    counter = ResultCounter()\n\n    for i in range(rotations):\n        lsb = binary_str_obj.get_lsb(index_offset=i)\n        if lsb == '1':\n            counter.increment()\n\n    return counter.get_count()"}
{"task_id": "Mbpp/116", "solution": "def _validate_input(tuple_input):\n    \"\"\"Ensures argument is a tuple and every element is int and > 0; raises ValueError on violation.\"\"\"\n    if not isinstance(tuple_input, tuple):\n        raise ValueError(\"Input must be a tuple.\")\n    for element in tuple_input:\n        if not isinstance(element, int):\n            raise ValueError(\"All elements in the tuple must be integers.\")\n        if element <= 0:\n            raise ValueError(\"All elements in the tuple must be positive integers (> 0).\")\n\ndef _concat_elements(elements: tuple) -> int:\n    \"\"\"Builds a concatenated decimal string from elements and returns int(concatenated_string).\"\"\"\n    string_parts = [str(element) for element in elements]\n    return int(\"\".join(string_parts))\n\ndef tuple_to_int(tuple_input):\n    \"\"\"Public API. Accepts exactly one argument (a tuple of positive integers) and returns int.\n    Raises ValueError on invalid input.\"\"\"\n    _validate_input(tuple_input)\n    return _concat_elements(tuple_input)"}
