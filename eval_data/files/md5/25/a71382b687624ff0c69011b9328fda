{"task_id": "Mbpp/57", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass Digit:\n    \"\"\"Represents a single input occurrence of a decimal digit and its occurrence index.\"\"\"\n    value: int\n    occurrenceIndex: int\n\n@dataclass\nclass DigitList:\n    \"\"\"Wraps a list of digits and provides an accessor.\"\"\"\n    digits: List[int]\n\n    def get_digits(self) -> List[int]:\n        return self.digits\n\n@dataclass\nclass ValidationResult:\n    \"\"\"Represents the outcome of input validation.\"\"\"\n    valid: bool\n    message: str = \"\"\n\nclass MaxNumberFunction:\n    \"\"\"Encapsulates the algorithm to validate input and compute the largest integer.\"\"\"\n\n    @staticmethod\n    def _validate_digits(digits: List[int]) -> ValidationResult:\n        \"\"\"Validates that each element in the list is an integer between 0 and 9.\"\"\"\n        if not isinstance(digits, list):\n            return ValidationResult(valid=False, message=\"Input must be a list.\")\n        for i, digit in enumerate(digits):\n            if not isinstance(digit, int):\n                return ValidationResult(valid=False, message=f\"Element at index {i} is not an integer.\")\n            if not (0 <= digit <= 9):\n                return ValidationResult(valid=False, message=f\"Digit {digit} at index {i} is out of range (0-9).\")\n        return ValidationResult(valid=True)\n\n    @staticmethod\n    def _compose_number(sorted_digits: List[int]) -> int:\n        \"\"\"Composes a list of sorted digits into a single integer.\"\"\"\n        return int(\"\".join(map(str, sorted_digits)))\n\n    @staticmethod\n    def find_Max_Num(digits: List[int]) -> int:\n        \"\"\"\n        Validates the input digits, sorts them in descending order, and composes the largest integer.\n        Raises ValueError if the input is invalid.\n        \"\"\"\n        validation_result = MaxNumberFunction._validate_digits(digits)\n        if not validation_result.valid:\n            raise ValueError(validation_result.message)\n\n        sorted_digits = sorted(digits, reverse=True)\n        return MaxNumberFunction._compose_number(sorted_digits)\n\ndef find_Max_Num(digits: List[int]) -> int:\n    \"\"\"\n    Finds the largest number that can be formed with the given list of digits.\n    assert find_Max_Num([1,2,3]) == 321\n    \"\"\"\n    return MaxNumberFunction.find_Max_Num(digits)"}
{"task_id": "Mbpp/59", "solution": "def _validate_n(n: int) -> None:\n    \"\"\"\n    Validates if n is a positive integer (n >= 1).\n    Raises ValueError if n is not an int or n < 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\ndef is_octagonal(n: int) -> int:\n    \"\"\"\n    Computes the nth octagonal number.\n    Input n must be a positive integer.\n    \"\"\"\n    _validate_n(n)\n    return n * (3 * n - 2)"}
