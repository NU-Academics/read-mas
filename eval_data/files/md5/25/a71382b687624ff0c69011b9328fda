{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers: list) -> int:\n    \"\"\"\n    Rounds every number in a list to the nearest integer (ties to nearest even),\n    sums the rounded values, multiplies by the list's length, and prints the result.\n    \"\"\"\n    total_rounded_sum = 0\n    for num in numbers:\n        total_rounded_sum += round(num)\n\n    list_length = len(numbers)\n    final_product = total_rounded_sum * list_length\n\n    print(final_product)\n    return final_product"}
{"task_id": "Mbpp/422", "solution": "class InputParameter:\n    def __init__(self, n):\n        self.n = n\n\n    def validate(self) -> bool:\n        \"\"\"Validates if n is an integer and n >= 1.\"\"\"\n        return isinstance(self.n, int) and self.n >= 1\n\nclass Calculation:\n    def computeSumOfCubes(self, n) -> int:\n        \"\"\"Computes the sum of cubes of first n natural numbers using the closed-form identity.\"\"\"\n        sum_first_n = n * (n + 1) // 2\n        return sum_first_n * sum_first_n\n\n    def computeAverage(self, n) -> float:\n        \"\"\"Computes the average of cubes of first n natural numbers.\"\"\"\n        sum_of_cubes = self.computeSumOfCubes(n)\n        return float(sum_of_cubes) / n\n\nclass ErrorHandler:\n    def raiseInvalidInput(self, msg: str) -> None:\n        \"\"\"Raises a ValueError with the specified message for invalid input.\"\"\"\n        raise ValueError(msg)\n\ndef find_Average_Of_Cube(n):\n    \"\"\"Finds the average of cubes of the first n natural numbers, with input validation.\"\"\"\n    input_param = InputParameter(n)\n    if not input_param.validate():\n        ErrorHandler().raiseInvalidInput(\"n must be integer >= 1\")\n\n    calculation = Calculation()\n    return calculation.computeAverage(n)"}
{"task_id": "Mbpp/421", "solution": "from typing import Tuple, Any, List\n\nclass TupleInput:\n    def __init__(self, elements: Tuple[Any, ...]) -> None:\n        self.elements = elements\n\n    def is_empty(self) -> bool:\n        return not self.elements\n\n    def as_list(self) -> list:\n        return list(self.elements)\n\nclass ConcatenatedString:\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def __str__(self) -> str:\n        return self.value\n\ndef _validate_input(input_tuple: Any) -> None:\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"concatenate_tuple: first argument must be a tuple\")\n\ndef _convert_elements_to_strings(elements: Tuple[Any, ...]) -> List[str]:\n    return [str(e) for e in elements]\n\ndef concatenate_tuple(input_tuple: Tuple[Any, ...], delimiter: str = '-') -> str:\n    _validate_input(input_tuple)\n\n    ti = TupleInput(input_tuple)\n\n    if ti.is_empty():\n        return ''\n\n    parts = _convert_elements_to_strings(ti.elements)\n    result = delimiter.join(parts)\n    \n    return result"}
{"task_id": "Mbpp/426", "solution": "def filter_oddnumbers(input_list: list) -> list:\n    \"\"\"\n    Filters a list of integers, returning only the odd numbers while preserving their relative order.\n    Raises TypeError if input_list is not a list or if any element is not an int.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"filter_oddnumbers expects a list of integers\")\n\n    result = []\n    for item in input_list:\n        if not isinstance(item, int):\n            raise TypeError(\"filter_oddnumbers expects a list of integers\")\n        if item % 2 != 0:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/425", "solution": "def count_element_in_list(list_of_sublists, element) -> int:\n    \"\"\"\n    Count how many sublists in list_of_sublists contain element using equality (==).\n    Each sublist is counted at most once, even if the element appears multiple times within it.\n    \"\"\"\n    count = 0\n    for sublist in list_of_sublists:\n        for candidate in sublist:\n            if candidate == element:\n                count += 1\n                break  # Count this sublist only once\n    return count"}
{"task_id": "Mbpp/428", "solution": "def shell_sort(input_list: list[int]) -> list[int]:\n    \"\"\"Accepts a list of integers and returns a new list of integers sorted ascending using Shell sort.\n    This implementation uses a gap sequence starting with n // 2, then halving it until 1.\n    \"\"\"\n    n = len(input_list)\n    # Create a mutable copy of the input list to sort in place.\n    arr = list(input_list)\n\n    # Start with a large gap, then reduce the gap.\n    gap = n // 2\n    while gap > 0:\n        # Perform a gapped insertion sort for this gap size.\n        for i in range(gap, n):\n            # Save arr[i] in temp and make a hole at position i\n            temp = arr[i]\n            # Shift earlier gap-sorted elements up until the correct position for arr[i] is found\n            j = i\n            while j >= gap and arr[j - gap] > temp:\n                arr[j] = arr[j - gap]\n                j -= gap\n            # Put temp (the original arr[i]) in its correct location\n            arr[j] = temp\n        gap //= 2\n    return arr"}
{"task_id": "Mbpp/427", "solution": "import re\n\nclass ValidationError(Exception):\n    \"\"\"Domain-specific exception to signal validation failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass DateParts:\n    \"\"\"Value object for parsed date components and formatting to dd-mm-yyyy.\"\"\"\n    year: str\n    month: str\n    day: str\n\n    def __init__(self, year: str, month: str, day: str) -> None:\n        self.year = year\n        self.month = month\n        self.day = day\n\n    def to_dd_mm_yyyy(self) -> str:\n        \"\"\"Returns the date in 'dd-mm-yyyy' format.\"\"\"\n        return f\"{self.day}-{self.month}-{self.year}\"\n\nclass DateConverter:\n    \"\"\"Orchestrates validation, parsing, and conversion of date strings.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate(self, dateStr: str) -> bool:\n        \"\"\"Performs syntactic and numeric-range validation for yyyy-mm-dd format.\"\"\"\n        match = re.match(r\"^\\d{4}-\\d{2}-\\d{2}$\", dateStr)\n        if not match:\n            return False\n        \n        parts = dateStr.split('-')\n        month_str, day_str = parts[1], parts[2]\n\n        try:\n            month_int = int(month_str)\n            day_int = int(day_str)\n        except ValueError:\n            return False\n\n        if not (1 <= month_int <= 12):\n            return False\n        if not (1 <= day_int <= 31):\n            return False\n        \n        return True\n\n    def parse(self, dateStr: str) -> DateParts:\n        \"\"\"Parses a validated date string into DateParts, preserving leading zeros.\"\"\"\n        year_str, month_str, day_str = dateStr.split('-')\n        return DateParts(year_str, month_str, day_str)\n\n    def change_date_format(self, dateStr: str) -> str:\n        \"\"\"Validates, parses, and converts a yyyy-mm-dd date string to dd-mm-yyyy, or raises ValidationError.\"\"\"\n        \n        # Perform granular validation to provide specific error messages\n        match = re.match(r\"^\\d{4}-\\d{2}-\\d{2}$\", dateStr)\n        if not match:\n            raise ValidationError(\"Date format must be yyyy-mm-dd.\")\n        \n        year_str, month_str, day_str = dateStr.split('-')\n\n        try:\n            month_int = int(month_str)\n            day_int = int(day_str)\n        except ValueError:\n            raise ValidationError(\"Month and day components must be numeric.\")\n\n        if not (1 <= month_int <= 12):\n            raise ValidationError(f\"Month '{month_str}' is out of range. Must be between 01 and 12.\")\n        \n        if not (1 <= day_int <= 31):\n            raise ValidationError(f\"Day '{day_str}' is out of range. Must be between 01 and 31.\")\n        \n        # If validation passes, parse and format\n        date_parts = self.parse(dateStr)\n        return date_parts.to_dd_mm_yyyy()\n\ndef change_date_format(dateStr: str) -> str:\n    \"\"\"\n    Converts a date of yyyy-mm-dd format to dd-mm-yyyy format.\n    Raises ValidationError for invalid input formats or date components.\n    \"\"\"\n    converter = DateConverter()\n    return converter.change_date_format(dateStr)"}
{"task_id": "Mbpp/429", "solution": "def _validate_is_tuple(obj, name):\n    if not isinstance(obj, tuple):\n        raise TypeError(f\"'{name}' must be a tuple.\")\n\ndef _validate_elements_are_ints(tup, name):\n    for i, element in enumerate(tup):\n        if not isinstance(element, int):\n            raise TypeError(f\"All elements in '{name}' must be integers, but element at index {i} is of type {type(element).__name__}.\")\n\ndef _validate_lengths(t1, t2):\n    if len(t1) != len(t2):\n        raise ValueError(f\"Input tuples must have the same length, but got lengths {len(t1)} and {len(t2)}.\")\n\ndef _bitwise_and_elements(a, b):\n    return tuple(x & y for x, y in zip(a, b))\n\ndef and_tuples(input1, input2) -> tuple:\n    \"\"\"Public function to extract the elementwise bitwise AND from two tuples.\n    Validates inputs and returns a tuple of the bitwise AND results.\"\"\"\n    _validate_is_tuple(input1, 'input1')\n    _validate_is_tuple(input2, 'input2')\n    _validate_elements_are_ints(input1, 'input1')\n    _validate_elements_are_ints(input2, 'input2')\n    _validate_lengths(input1, input2)\n    return _bitwise_and_elements(input1, input2)"}
