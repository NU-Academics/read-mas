{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input string contains 'z', except at the start and end of any ASCII alphabetic word.\n    Words are defined as contiguous sequences of A-Z/a-z; non-alphabetic characters are separators.\n    \"\"\"\n    current_word_chars = []\n    \n    for char in input_string:\n        # Determine if character is an ASCII letter (A-Z or a-z)\n        is_alphabetic = ('a' <= char <= 'z') or ('A' <= char <= 'Z')\n        \n        if is_alphabetic:\n            current_word_chars.append(char)\n        else:\n            # Non-alphabetic character, process the accumulated word if any\n            if current_word_chars:\n                word = \"\".join(current_word_chars)\n                # A 'z' must be at index > 0 and < length - 1, so word length must be at least 3\n                if len(word) >= 3:\n                    # Check characters from index 1 to len-2 (inclusive)\n                    for i in range(1, len(word) - 1):\n                        if word[i] == 'z':\n                            return True\n                current_word_chars = [] # Reset for the next word\n    \n    # After the loop, check if there's an unfinished word at the end of the string\n    if current_word_chars:\n        word = \"\".join(current_word_chars)\n        if len(word) >= 3:\n            for i in range(1, len(word) - 1):\n                if word[i] == 'z':\n                    return True\n                    \n    return False"}
{"task_id": "Mbpp/722", "solution": "def filter_data(students_dict: dict, min_height: float, min_weight: float) -> dict:\n    \"\"\"\n    Filters students based on height and weight criteria.\n    Returns a new dictionary with students whose height is greater than min_height\n    and weight is greater than or equal to min_weight.\n    \"\"\"\n    filtered_students = {}\n    for name, (height, weight) in students_dict.items():\n        if height > min_height and weight >= min_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students"}
{"task_id": "Mbpp/721", "solution": "import math\n\nclass Cell:\n    \"\"\"Represents a cell in the matrix with its coordinates and value.\"\"\"\n    def __init__(self, row: int, col: int, value: float):\n        self.row = row\n        self.col = col\n        self.value = value\n\nclass Matrix:\n    \"\"\"Represents the N x N grid of cells.\"\"\"\n    def __init__(self, rows: list[list[float]]):\n        self._rows = rows\n        self.N = len(rows)\n        # Ensure N is consistent if rows is not empty\n        if self.N > 0:\n            for row in rows:\n                if len(row) != self.N:\n                    raise ValueError(\"Matrix must be square.\")\n        elif self.N == 0 and len(rows) != 0:\n             raise ValueError(\"Matrix must be square.\")\n\n    def getCell(self, i: int, j: int) -> Cell:\n        \"\"\"Returns the Cell object at the given row and column.\"\"\"\n        return Cell(i, j, float(self._rows[i][j]))\n\n    def isSquare(self) -> bool:\n        \"\"\"Checks if the matrix is square.\"\"\"\n        if not self._rows:\n            return False\n        n = len(self._rows)\n        for row in self._rows:\n            if len(row) != n:\n                return False\n        return True\n\nclass Path:\n    \"\"\"Represents a path through the matrix as a sequence of visited cells.\"\"\"\n    def __init__(self, visited_cells: list[Cell]):\n        self.visitedCells = visited_cells\n        self._total_cost = None\n        self._length = None\n        self._average = None\n\n    def length(self) -> int:\n        \"\"\"Returns the number of cells in the path.\"\"\"\n        if self._length is None:\n            self._length = len(self.visitedCells)\n        return self._length\n\n    def totalCost(self) -> float:\n        \"\"\"Returns the sum of values of all cells in the path.\"\"\"\n        if self._total_cost is None:\n            self._total_cost = sum(cell.value for cell in self.visitedCells)\n        return self._total_cost\n\n    def average(self) -> float:\n        \"\"\"Returns the average cost of the path.\"\"\"\n        if self._average is None:\n            path_length = self.length()\n            if path_length == 0:\n                self._average = 0.0 # Or handle as an error if paths must have cells\n            else:\n                self._average = self.totalCost() / path_length\n        return self._average\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str, code: int = 0):\n        self.message = message\n        self.code = code\n        super().__init__(message)\n\nclass Validator:\n    \"\"\"Validates the structure and content of a Matrix.\"\"\"\n    def validate(self, matrix: Matrix) -> ValidationError | None:\n        \"\"\"Returns a ValidationError if the matrix is invalid, otherwise None.\"\"\"\n        if matrix.N == 0:\n            return ValidationError(\"Matrix cannot be empty.\")\n        if not matrix.isSquare():\n            return ValidationError(\"Matrix must be square.\")\n        return None\n\nclass PathEnumerator:\n    \"\"\"Enumerates all valid right/down paths from top-left to bottom-right.\"\"\"\n    def enumerateAllPaths(self, matrix: Matrix) -> list[Path]:\n        \"\"\"Generates all possible paths in the given matrix.\"\"\"\n        all_paths: list[Path] = []\n        N = matrix.N\n\n        if N == 0:\n            return []\n        if N == 1:\n            all_paths.append(Path([matrix.getCell(0, 0)]))\n            return all_paths\n\n        # Use a stack for DFS\n        stack = [(0, 0, [matrix.getCell(0, 0)])] # (row, col, current_path_cells)\n\n        while stack:\n            r, c, current_path_cells = stack.pop()\n\n            if r == N - 1 and c == N - 1:\n                all_paths.append(Path(list(current_path_cells)))\n                continue\n\n            # Move Down\n            if r + 1 < N:\n                next_cell = matrix.getCell(r + 1, c)\n                stack.append((r + 1, c, current_path_cells + [next_cell]))\n\n            # Move Right\n            if c + 1 < N:\n                next_cell = matrix.getCell(r, c + 1)\n                stack.append((r, c + 1, current_path_cells + [next_cell]))\n\n        return all_paths\n\nclass Calculator:\n    \"\"\"Computes path metrics and selects the path with the maximum average.\"\"\"\n    def computeTotal(self, path: Path) -> float:\n        \"\"\"Sums the values of cells in a path.\"\"\"\n        return path.totalCost()\n\n    def computeAverage(self, path: Path) -> float:\n        \"\"\"Calculates the average value of cells in a path.\"\"\"\n        return path.average()\n\n    def selectMaxAverage(self, paths: list[Path]) -> float:\n        \"\"\"Finds the maximum average among a list of paths.\"\"\"\n        if not paths:\n            raise ValueError(\"No paths found to calculate maximum average.\")\n\n        max_avg = -math.inf\n        for path in paths:\n            current_avg = path.average()\n            if current_avg > max_avg:\n                max_avg = current_avg\n        return max_avg\n\ndef _to_matrix(matrix_input: list[list[float]]) -> Matrix:\n    \"\"\"Converts a list-of-lists to a Matrix object.\"\"\"\n    # Basic check for list-of-lists structure and numeric content,\n    # more detailed validation is done by Validator.\n    if not isinstance(matrix_input, list):\n        raise ValueError(\"Input must be a list of lists.\")\n    if not matrix_input:\n        return Matrix([]) # Validator handles empty matrix\n\n    # Check if all rows are lists and have numeric elements\n    for row in matrix_input:\n        if not isinstance(row, list):\n            raise ValueError(\"All rows in the matrix must be lists.\")\n        for item in row:\n            if not isinstance(item, (int, float)):\n                raise ValueError(\"All matrix elements must be numeric.\")\n    \n    return Matrix(matrix_input)\n\n\ndef maxAverageOfPath(matrix: list[list[float]]) -> float:\n    \"\"\"\n    Given a square matrix, finds a path from top-left to bottom-right \n    (moving only right or down) with the maximum average cost.\n    \"\"\"\n    matrix_obj = _to_matrix(matrix)\n\n    validator = Validator()\n    validation_error = validator.validate(matrix_obj)\n    if validation_error:\n        raise ValueError(validation_error.message)\n\n    path_enumerator = PathEnumerator()\n    paths = path_enumerator.enumerateAllPaths(matrix_obj)\n\n    calculator = Calculator()\n    max_avg = calculator.selectMaxAverage(paths)\n\n    return max_avg"}
{"task_id": "Mbpp/724", "solution": "\nclass BigInteger:\n    \"\"\"Helper class to perform exact exponentiation using Python's native arbitrary-precision integers.\"\"\"\n    def compute_power(self, base: int, power: int) -> int:\n        \"\"\"Computes base raised to the power.\"\"\"\n        return base ** power\n\nclass DigitSequence:\n    \"\"\"Helper class to convert an integer to its decimal digits.\"\"\"\n    def extract_digits(self, value: int) -> list[int]:\n        \"\"\"Extracts individual digits from an integer value.\"\"\"\n        # Converts the absolute value to a string and then to a list of integer digits.\n        return [int(d) for d in str(abs(value))]\n\nclass DigitSumResult:\n    \"\"\"Helper class to calculate the sum of a list of digits.\"\"\"\n    @staticmethod\n    def from_digits(digits: list[int]) -> int:\n        \"\"\"Calculates the sum of a list of integer digits.\"\"\"\n        return sum(digits)\n\ndef power_base_sum(base, power):\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    This function coordinates exponentiation, digit extraction, and summation.\n    \"\"\"\n    bigint_calculator = BigInteger()\n    value = bigint_calculator.compute_power(base, power)\n\n    digit_extractor = DigitSequence()\n    digits = digit_extractor.extract_digits(value)\n\n    return DigitSumResult.from_digits(digits)"}
{"task_id": "Mbpp/723", "solution": "class ComparisonResult:\n    \"\"\"A simple container for the matching count.\"\"\"\n    def __init__(self, matching_count: int) -> None:\n        self.matching_count = matching_count\n\n    def to_int(self) -> int:\n        \"\"\"Returns the stored matching count as an integer.\"\"\"\n        return self.matching_count\n\nclass Validator:\n    \"\"\"Stateless component for validating inputs.\"\"\"\n    @staticmethod\n    def validate_inputs(list1: list, list2: list) -> None:\n        \"\"\"\n        Validates that both inputs are lists and have equal length.\n        Raises TypeError or ValueError on invalid inputs.\n        \"\"\"\n        if not isinstance(list1, list) or not isinstance(list2, list):\n            raise TypeError(\"Both inputs must be lists.\")\n        if len(list1) != len(list2):\n            raise ValueError(\"Input lists must have equal length.\")\n\nclass CountSamePairFunction:\n    \"\"\"Performs a single-pass element-wise comparison.\"\"\"\n    @staticmethod\n    def count_same_pair(list1: list, list2: list) -> int:\n        \"\"\"\n        Counts indices where lists have the same values.\n        Returns the integer count.\n        \"\"\"\n        matching_count = 0\n        for i in range(len(list1)):\n            if list1[i] == list2[i]:\n                matching_count += 1\n        return matching_count\n\ndef count_same_pair(list1: list, list2: list) -> int:\n    \"\"\"\n    Counts indices where the two lists have the same values.\n    Validates inputs and performs element-wise comparison.\n    \"\"\"\n    Validator.validate_inputs(list1, list2)\n    return CountSamePairFunction.count_same_pair(list1, list2)"}
{"task_id": "Mbpp/725", "solution": "from typing import List, Tuple\n\ndef extract_quotation(input: str) -> List[str]:\n    \"\"\"\n    Extracts values between quotation marks \" \" from the given string.\n    Forms pairs left-to-right, ignoring an unmatched trailing quote.\n    \"\"\"\n    def _scan_for_quotes(s: str) -> List[Tuple[int, int]]:\n        \"\"\"\n        Scans for double-quote characters and returns matched index pairs (start_index, end_index).\n        If an odd number of quotes is present, the trailing unmatched quote is ignored.\n        \"\"\"\n        quote_indices = [i for i, char in enumerate(s) if char == '\"']\n        pairs = []\n        for i in range(0, len(quote_indices) - 1, 2):\n            pairs.append((quote_indices[i], quote_indices[i+1]))\n        return pairs\n\n    def _slice_pairs(s: str, pairs: List[Tuple[int, int]]) -> List[str]:\n        \"\"\"\n        For each (start_index, end_index) pair, returns the substring without surrounding quotes.\n        \"\"\"\n        extracted_values = []\n        for start, end in pairs:\n            extracted_values.append(s[start + 1:end])\n        return extracted_values\n\n    quote_pairs = _scan_for_quotes(input)\n    return _slice_pairs(input, quote_pairs)"}
{"task_id": "Mbpp/728", "solution": "def sum_list(listA: list, listB: list) -> list:\n    \"\"\"\n    Computes the element-wise sum of two lists.\n    Raises ValueError if input lists have different lengths.\n    \"\"\"\n    if len(listA) != len(listB):\n        raise ValueError(\"Input lists must have equal length\")\n\n    result = []\n    for a, b in zip(listA, listB):\n        result.append(a + b)\n    return result"}
{"task_id": "Mbpp/726", "solution": "class MultiplyElementsService:\n    \"\"\"Internal service to validate input and compute products.\"\"\"\n\n    def validate_input(self, input_tuple: tuple) -> None:\n        \"\"\"Validates the input tuple for length and element types.\"\"\"\n        if len(input_tuple) < 2:\n            raise ValueError(\"input tuple must have at least two elements\")\n\n        if any(not isinstance(x, (int, float)) for x in input_tuple):\n            raise TypeError(\"all elements must be int or float\")\n\n    def multiply_elements(self, input_tuple: tuple) -> tuple:\n        \"\"\"Computes a new tuple of adjacent products after validation.\"\"\"\n        self.validate_input(input_tuple)\n        products = [input_tuple[i] * input_tuple[i+1] for i in range(len(input_tuple) - 1)]\n        return tuple(products)\n\ndef multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Computes a new tuple where each element is the product of adjacent elements from the input tuple,\n    raising ValueError for insufficient length or TypeError for non-numeric elements.\n    \"\"\"\n    service = MultiplyElementsService()\n    return service.multiply_elements(input_tuple)"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list: list) -> list:\n    \"\"\"Return a new list where contiguous equal elements in input_list are collapsed to single instances.\"\"\"\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] != result[-1]:\n            result.append(input_list[i])\n\n    return result"}
{"task_id": "Mbpp/731", "solution": "import math\n\nclass Result:\n    \"\"\"Encapsulates a numeric result and provides it as a float.\"\"\"\n    def __init__(self, value: float):\n        self.value = float(value)\n    def as_float(self) -> float:\n        return self.value\n\nclass MathLibrary:\n    \"\"\"Provides access to standard math.pi and math.sqrt.\"\"\"\n    pi: float = math.pi\n    @staticmethod\n    def sqrt(x: float) -> float:\n        return math.sqrt(x)\n\nclass CalculationEngine:\n    \"\"\"Performs core numeric computations for slant height and lateral surface area.\"\"\"\n    def __init__(self, math_lib: MathLibrary = MathLibrary()):\n        self.math_lib = math_lib\n    def compute_slant_height(self, r: float, h: float) -> float:\n        return self.math_lib.sqrt(r*r + h*h)\n    def compute_lateral_surface(self, r: float, h: float) -> float:\n        s = self.compute_slant_height(r, h)\n        return float(self.math_lib.pi * r * s)\n\nclass InputValidator:\n    \"\"\"Validates that inputs are numeric and non-negative.\"\"\"\n    @staticmethod\n    def validate_numeric(value):\n        if not isinstance(value, (int, float)):\n            raise TypeError(\"r and h must be numeric\")\n        return True\n    @staticmethod\n    def validate_non_negative(value):\n        if value < 0:\n            raise ValueError(\"r and h must be non-negative\")\n        return True\n\ndef lateralsurface_cone(r, h) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cone given radius r and height h.\n    Validates inputs and uses a calculation engine for the computation.\n    \"\"\"\n    InputValidator.validate_numeric(r)\n    InputValidator.validate_numeric(h)\n    InputValidator.validate_non_negative(r)\n    InputValidator.validate_non_negative(h)\n    engine = CalculationEngine()\n    L = engine.compute_lateral_surface(r, h)\n    return Result(L).as_float()"}
{"task_id": "Mbpp/733", "solution": "from typing import List, Union\n\ndef find_first_occurrence(arr: List[Union[int, float]], target: Union[int, float]) -> int:\n    \"\"\"\n    Return the zero-based index of the first (leftmost) occurrence of target in arr.\n    Preconditions: arr is sorted in non-decreasing order.\n    \"\"\"\n    left = 0\n    right = len(arr) - 1\n    result_index = -1\n\n    while left <= right:\n        mid = (left + right) // 2\n        if arr[mid] < target:\n            left = mid + 1\n        elif arr[mid] > target:\n            right = mid - 1\n        else: # arr[mid] == target\n            result_index = mid\n            right = mid - 1 # Continue searching in the left half for an earlier occurrence.\n            \n    return result_index"}
{"task_id": "Mbpp/732", "solution": "import re\n\ndef replace_specialchar(input: str) -> str:\n    \"\"\"Replaces spaces, commas, or dots with a colon in the input string.\"\"\"\n    return re.sub(r'[ ,.]', ':', input)"}
{"task_id": "Mbpp/734", "solution": "from typing import Iterator\n\ndef sum_Of_Subarray_Prod(list_input: list) -> int:\n    \"\"\"Orchestrator per FR-1: returns numeric sum of products of all contiguous subarrays.\"\"\"\n\n    class Accumulator:\n        def __init__(self) -> None:\n            self._sum: int = 0\n        def add(self, v: int) -> None:\n            self._sum += v\n        def value(self) -> int:\n            return self._sum\n\n    def product_of_list(sublist: list) -> int:\n        \"\"\"Returns product of integer elements in sublist.\"\"\"\n        prod = 1\n        for x in sublist:\n            prod *= x\n        return prod\n\n    def generate_contiguous_subarrays(lst: list) -> Iterator[list]:\n        \"\"\"Yields contiguous non-empty sublists of lst in 0-based start/end index order.\"\"\"\n        n = len(lst)\n        for i in range(n):\n            for j in range(i, n):\n                yield lst[i : j + 1]\n\n    acc = Accumulator()\n    for sub in generate_contiguous_subarrays(list_input):\n        prod = product_of_list(sub)\n        acc.add(prod)\n    return acc.value()"}
{"task_id": "Mbpp/735", "solution": "def find_msb_index(n: int) -> int:\n    \"\"\"Return index (>=0) of highest-order set bit in n. Returns -1 if n is 0.\"\"\"\n    if n == 0:\n        return -1\n    return n.bit_length() - 1\n\ndef compute_mask(msb_index: int, lsb_index: int) -> int:\n    \"\"\"Return mask with bits from lsb_index+1 to msb_index-1 set to 1. Returns 0 if no middle bits.\"\"\"\n    if msb_index <= lsb_index + 1:\n        return 0\n    \n    num_middle_bits = msb_index - lsb_index - 1\n    \n    mask_of_ones = (1 << num_middle_bits) - 1\n    return mask_of_ones << (lsb_index + 1)\n\ndef toggle_middle_bits(n: int) -> int:\n    \"\"\"Return integer with every bit strictly between MSB and LSB toggled; preserves MSB and LSB.\"\"\"\n    if n == 0:\n        return 0\n    \n    lsb_index = 0\n    msb_index = find_msb_index(n)\n    \n    mask = compute_mask(msb_index, lsb_index)\n    \n    return n ^ mask"}
{"task_id": "Mbpp/737", "solution": "import re\nimport typing\n\nclass RegexEvaluator:\n    \"\"\"\n    Evaluates regex patterns against input strings using the environment regex engine.\n    \"\"\"\n    def match(self, pattern: typing.Union[str, re.Pattern], input: str) -> bool:\n        \"\"\"\n        Returns True if the pattern matches the input at the start; otherwise False.\n        \"\"\"\n        if isinstance(pattern, str):\n            compiled_pattern = re.compile(pattern)\n        else:\n            compiled_pattern = pattern\n        return compiled_pattern.match(input) is not None\n\n_VOWEL_PATTERN: str = r'(?i)^[aeiou]'\n\ndef check_str(input: str) -> bool:\n    \"\"\"\n    Checks if the given string starts with a vowel using a regular expression.\n    Returns True if the input starts with 'a', 'e', 'i', 'o', or 'u' (case-insensitive); otherwise, returns False.\n    \"\"\"\n    evaluator = RegexEvaluator()\n    return evaluator.match(_VOWEL_PATTERN, input)"}
{"task_id": "Mbpp/736", "solution": "class IndexResult:\n    \"\"\"Simple typed holder for the insertion index.\"\"\"\n    def __init__(self, index: int) -> None:\n        self.index = index\n\nclass SortedList:\n    \"\"\"Thin typed wrapper around a Python sequence; provides validation and length.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\n    def is_sorted_asc(self) -> bool:\n        \"\"\"Checks if the elements are in non-decreasing order.\"\"\"\n        for i in range(1, len(self.elements)):\n            try:\n                if self.elements[i] < self.elements[i-1]:\n                    return False\n            except TypeError:\n                # If elements within the list are incomparable, it's not truly sorted.\n                return False\n        return True\n\n    def __getitem__(self, index: int):\n        \"\"\"Allows indexing the underlying elements.\"\"\"\n        return self.elements[index]\n\ndef as_sorted_list(obj) -> SortedList:\n    \"\"\"Coerces a raw list into a SortedList instance for internal consistency.\"\"\"\n    if isinstance(obj, SortedList):\n        return obj\n    return SortedList(obj)\n\ndef left_insertion(sorted_list, value) -> int:\n    \"\"\"\n    Computes the leftmost insertion index for a value in a sorted list.\n    Raises ValueError if the list is unsorted or elements are incomparable.\n    \"\"\"\n    s_list = as_sorted_list(sorted_list)\n\n    if not s_list.is_sorted_asc():\n        raise ValueError(\"input list is not sorted ascending\")\n\n    n = s_list.length()\n    low = 0\n    high = n\n\n    while low < high:\n        mid = (low + high) // 2\n        try:\n            if s_list[mid] >= value:\n                high = mid\n            else:\n                low = mid + 1\n        except TypeError:\n            raise ValueError(\"elements not comparable with value\")\n\n    return low"}
{"task_id": "Mbpp/740", "solution": "from typing import Iterator\n\ndef _validate_tuple_input(t: tuple) -> None:\n    \"\"\"\n    Validates the input tuple's type and length.\n    Raises TypeError if not a tuple or ValueError if length is odd.\n    \"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n    if len(t) % 2 != 0:\n        raise ValueError(\"Input tuple length must be even.\")\n\ndef _pair_adjacent_elements(t: tuple) -> Iterator[tuple]:\n    \"\"\"\n    Yields adjacent (key, value) pairs from the tuple.\n    Iterates through the tuple in steps of two.\n    \"\"\"\n    for i in range(0, len(t), 2):\n        yield (t[i], t[i+1])\n\ndef tuple_to_dict(t: tuple) -> dict:\n    \"\"\"\n    Converts a tuple of adjacent elements into a key-value dictionary.\n    Validates input and populates a dictionary using adjacent pairs.\n    \"\"\"\n    _validate_tuple_input(t)\n    \n    result_dict = {}\n    for key, value in _pair_adjacent_elements(t):\n        result_dict[key] = value\n        \n    return result_dict"}
{"task_id": "Mbpp/739", "solution": "def compute_triangular(k: int) -> int:\n    \"\"\"Computes the k-th triangular number using the formula T_k = k*(k+1)//2.\"\"\"\n    return k * (k + 1) // 2\n\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    Returns the smallest positive integer k such that T_k has exactly n decimal digits.\n    \"\"\"\n    k = 1\n    while True:\n        triangular_value = compute_triangular(k)\n        num_digits = len(str(triangular_value))\n        \n        if num_digits == n:\n            return k\n        \n        k += 1"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(input_string):\n    \"\"\"\n    Checks if all characters in the input string are identical.\n    Returns True for empty or single-character strings.\n    \"\"\"\n    return len(set(input_string)) <= 1"}
{"task_id": "Mbpp/742", "solution": "import math\n\ndef area_tetrahedron(edge_length):\n    \"\"\"\n    Calculates the surface area of a regular tetrahedron given its edge length.\n    The formula used is sqrt(3) * edge_length^2.\n    \"\"\"\n    return math.sqrt(3) * (edge_length ** 2)"}
{"task_id": "Mbpp/744", "solution": "def check_none(t: tuple) -> bool:\n    \"\"\"Return True if any element of t is None, else False. Does not modify t.\"\"\"\n    for elem in t:\n        if elem is None:\n            return True\n    return False"}
{"task_id": "Mbpp/743", "solution": "def validate_list(input_list):\n    \"\"\"\n    Validates if input_list is a list-like sequence.\n    Raises TypeError if not.\n    \"\"\"\n    try:\n        _ = len(input_list)\n        iter(input_list)\n    except Exception:\n        raise TypeError('input_list must be a list-like sequence')\n    return True\n\ndef validate_k(k):\n    \"\"\"\n    Validates if k is a non-negative integer.\n    Raises ValueError if k is not an integer or is negative.\n    \"\"\"\n    if not isinstance(k, int):\n        raise ValueError('k must be an integer')\n    if k < 0:\n        raise ValueError('k must be non-negative')\n    return True\n\ndef normalize_k(k, length):\n    \"\"\"\n    Normalizes k using modulo arithmetic for a given list length.\n    \"\"\"\n    return k % length\n\ndef compute_rotated_list(input_list, effective_k):\n    \"\"\"\n    Constructs and returns a new list representing the right-rotation\n    of input_list by effective_k, ensuring a distinct list instance.\n    \"\"\"\n    if effective_k == 0:\n        return list(input_list)\n    n = len(input_list)\n    split_idx = n - effective_k\n    return list(input_list[split_idx:]) + list(input_list[:split_idx])\n\ndef rotate_right(input_list, k):\n    \"\"\"\n    Rotates a given list by a specified number of items to the right direction.\n    Returns a new list instance without modifying the original input_list.\n    \"\"\"\n    validate_list(input_list)\n    validate_k(k)\n    if len(input_list) == 0:\n        return []\n    effective_k = normalize_k(k, len(input_list))\n    return compute_rotated_list(input_list, effective_k)"}
{"task_id": "Mbpp/745", "solution": "from typing import List, Iterator\n\nclass Digit:\n    \"\"\"Represents a single decimal digit.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isZero(self) -> bool:\n        \"\"\"Checks if the digit is zero.\"\"\"\n        return self.value == 0\n\n    def divides(self, n: 'Number') -> bool:\n        \"\"\"Checks if this digit divides the given number's value.\"\"\"\n        return n.value % self.value == 0\n\nclass Number:\n    \"\"\"Encapsulates a number under evaluation for digit divisibility.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n        self.digits: List[Digit] = []\n        self._toDigits()\n\n    def _toDigits(self) -> None:\n        \"\"\"Decomposes the number into a list of Digit objects.\"\"\"\n        if self.value == 0:\n            self.digits.append(Digit(0))\n            return\n\n        temp_value = self.value\n        while temp_value > 0:\n            self.digits.insert(0, Digit(temp_value % 10))\n            temp_value //= 10\n\n    def hasZero(self) -> bool:\n        \"\"\"Checks if the number contains the digit 0.\"\"\"\n        for digit in self.digits:\n            if digit.isZero():\n                return True\n        return False\n\n    def allNonZeroDigitsDivide(self) -> bool:\n        \"\"\"Checks if all non-zero digits of the number divide the number evenly.\"\"\"\n        for digit in self.digits:\n            if not digit.isZero():\n                if not digit.divides(self):\n                    return False\n        return True\n\nclass Range:\n    \"\"\"Represents an inclusive integer range and yields its numbers.\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\n\n    def numbers(self) -> Iterator[int]:\n        \"\"\"Yields numbers within the inclusive range.\"\"\"\n        for i in range(self.start, self.end + 1):\n            yield i\n\nclass ResultList:\n    \"\"\"Collects qualifying integers and provides sorted ascending output.\"\"\"\n    def __init__(self):\n        self.numbers: List[int] = []\n\n    def sortAscending(self) -> None:\n        \"\"\"Sorts the collected numbers in ascending order.\"\"\"\n        self.numbers.sort()\n\nclass DivisibleByDigitsFunction:\n    \"\"\"Orchestrates the process of finding numbers divisible by their digits within a range.\"\"\"\n    def __init__(self):\n        self.startnum: int = 0\n        self.endnum: int = 0\n        self.result_list: ResultList = ResultList()\n\n    def divisible_by_digits(self, startnum: int, endnum: int) -> List[int]:\n        \"\"\"Finds numbers in a range where every number is divisible by every digit it contains.\"\"\"\n        self.startnum = startnum\n        self.endnum = endnum\n\n        self.validateInputs()\n        range_obj = self.generateRange()\n        self.result_list = ResultList()\n\n        for n_value in range_obj.numbers():\n            number_obj = Number(n_value)\n            if not number_obj.hasZero():\n                if number_obj.allNonZeroDigitsDivide():\n                    self.result_list.numbers.append(n_value)\n\n        self.result_list.sortAscending()\n        return self.result_list.numbers\n\n    def validateInputs(self) -> None:\n        \"\"\"Validates input parameters, raising ValueError if startnum > endnum.\"\"\"\n        if self.startnum > self.endnum:\n            raise ValueError(\"startnum must be <= endnum\")\n\n    def generateRange(self) -> Range:\n        \"\"\"Generates a Range object based on the stored start and end numbers.\"\"\"\n        return Range(self.startnum, self.endnum)\n\ndef divisible_by_digits(startnum: int, endnum: int) -> List[int]:\n    \"\"\"\n    Finds numbers within a given range from startnum to endnum where every number\n    is divisible by every digit it contains. Numbers containing a zero digit are excluded.\n    \"\"\"\n    orchestrator = DivisibleByDigitsFunction()\n    return orchestrator.divisible_by_digits(startnum, endnum)"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input: str) -> str:\n    \"\"\"\n    Inserts spaces between words starting with capital letters in a given string.\n    A space is added between a lowercase letter and an immediately following uppercase letter.\n    \"\"\"\n    if not input:\n        return \"\"\n\n    result_parts = [input[0]]\n    for i in range(1, len(input)):\n        if input[i-1].islower() and input[i].isupper():\n            result_parts.append(\" \")\n        result_parts.append(input[i])\n\n    return \"\".join(result_parts)"}
{"task_id": "Mbpp/750", "solution": "from typing import Any, List as _PyList, Tuple as _PyTuple\n\ndef add_tuple(lst: _PyList[Any], tup: _PyTuple[Any, ...]) -> _PyList[Any]:\n    \"\"\"Return a new list with elements from the input list followed by elements from the input tuple.\"\"\"\n    return lst + list(tup)"}
{"task_id": "Mbpp/749", "solution": "class NumericString:\n    \"\"\"Represents a string that is expected to be a numeric integer.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def isValidIntegerString(self) -> bool:\n        \"\"\"Checks if the stored string is a valid standard decimal integer.\"\"\"\n        try:\n            int(self.value)\n            return True\n        except ValueError:\n            return False\n\n    def toInteger(self) -> int:\n        \"\"\"Converts the stored string to an integer, raising ValueError on failure.\"\"\"\n        return int(self.value)\n\nclass IntegerValue:\n    \"\"\"A value object for an integer.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass SortNumericStrings:\n    \"\"\"Orchestrates the conversion and sorting of numeric strings.\"\"\"\n    def __init__(self, input_list: list[str]) -> None:\n        self.input = input_list\n\n    def convert(self, s: str) -> int:\n        \"\"\"Converts a single string to an integer using NumericString.\"\"\"\n        numeric_string = NumericString(s)\n        return numeric_string.toInteger()\n\n    def sort(self) -> list[int]:\n        \"\"\"Converts all input strings to integers, sorts them, and returns the sorted list.\"\"\"\n        converted_integers = []\n        for s in self.input:\n            converted_integers.append(self.convert(s))\n        \n        converted_integers.sort()\n        return converted_integers\n\ndef sort_numeric_strings(input_list: list[str]) -> list[int]:\n    \"\"\"\n    Sorts a given list of strings of numbers numerically.\n    Raises ValueError if any string cannot be converted to an integer.\n    \"\"\"\n    sorter = SortNumericStrings(input_list)\n    return sorter.sort()"}
{"task_id": "Mbpp/752", "solution": "class InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to Jacobsthal functions.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass InputValidator:\n    \"\"\"Validates input parameters for Jacobsthal number computation.\"\"\"\n    def validate_non_negative_integer(self, n: int) -> None:\n        \"\"\"Checks if n is a non-negative integer, raising InvalidInputError if not.\"\"\"\n        if not isinstance(n, int):\n            raise InvalidInputError(f\"Input must be an integer, but got type {type(n).__name__}.\")\n        if n < 0:\n            raise InvalidInputError(f\"Input must be a non-negative integer, but got {n}.\")\n\nclass JacobsthalCalculator:\n    \"\"\"Computes Jacobsthal numbers using iterative and recursive methods.\"\"\"\n    def jacobsthal_num(self, n: int) -> int:\n        \"\"\"Public method to compute the nth Jacobsthal number, delegating to iterative.\"\"\"\n        return self._computeIterative(n)\n\n    def _computeRecurrence(self, n: int) -> int:\n        \"\"\"Computes the nth Jacobsthal number recursively.\"\"\"\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n        return self._computeRecurrence(n - 1) + 2 * self._computeRecurrence(n - 2)\n\n    def _computeIterative(self, n: int) -> int:\n        \"\"\"Computes the nth Jacobsthal number iteratively (O(n) time, O(1) space).\"\"\"\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n\n        j_n_minus_2, j_n_minus_1 = 0, 1  # Corresponds to J(0) and J(1)\n        for _ in range(2, n + 1):\n            current_jacobsthal = j_n_minus_1 + 2 * j_n_minus_2\n            j_n_minus_2 = j_n_minus_1\n            j_n_minus_1 = current_jacobsthal\n        return j_n_minus_1\n\nclass JacobsthalNumber:\n    \"\"\"Simple data holder representing a computed Jacobsthal number and its index.\"\"\"\n    def __init__(self, index: int, value: int) -> None:\n        self.index = index\n        self.value = value\n\ndef jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Finds the nth Jacobsthal number using 0-based indexing.\n    Validates input and computes the number based on the recurrence relation.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate_non_negative_integer(n)\n\n    calculator = JacobsthalCalculator()\n    result = calculator.jacobsthal_num(n)\n\n    return result"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(array):\n    \"\"\"Checks if the given array represents a min-heap.\n    It iterates through parent nodes, ensuring each parent is less than or equal to its children.\n    \"\"\"\n    n = len(array)\n    # An empty array or an array with a single element is considered a valid min-heap.\n    if n <= 1:\n        return True\n\n    # Iterate only through parent nodes\n    # The last parent node index is floor(n/2) - 1\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n:\n            if array[i] > array[left_child_idx]:\n                return False\n\n        # Check right child\n        if right_child_idx < n:\n            if array[i] > array[right_child_idx]:\n                return False\n    return True"}
{"task_id": "Mbpp/753", "solution": "def min_k(records, k):\n    \"\"\"Finds the k records with the minimum second element from a list of tuples, ordered ascending.\"\"\"\n    sorted_records = sorted(records, key=lambda record: record[1])\n    return sorted_records[:k]"}
{"task_id": "Mbpp/757", "solution": "from typing import List\n\nclass StringEntry:\n    def __init__(self, index: int, value: str):\n        self.index = index\n        self.value = value\n\n    def reverse(self) -> str:\n        \"\"\"Returns the character-by-character reverse of the stored string value.\"\"\"\n        return self.value[::-1]\n\nclass ReversePairCounter:\n    def count_reverse_pairs(self, strings: List[str]) -> int:\n        \"\"\"Encapsulates the counting algorithm for reverse string pairs.\"\"\"\n        n = len(strings)\n        count = 0\n\n        for i in range(n - 1):\n            current_string_entry = StringEntry(i, strings[i])\n            reversed_current_string = current_string_entry.reverse()\n\n            for j in range(i + 1, n):\n                if strings[j] == reversed_current_string:\n                    count += 1\n        return count\n\ndef count_reverse_pairs(strings: List[str]) -> int:\n    \"\"\"\n    Counts pairs of reverse strings in the given list, delegating to ReversePairCounter.\n    Each unique unordered index pair (i < j) where strings[j] is the reverse of strings[i] is counted once.\n    \"\"\"\n    counter = ReversePairCounter()\n    return counter.count_reverse_pairs(strings)"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(values: list[float]) -> float:\n    \"\"\"Public API: compute second smallest numeric value from a Python list of numeric values.\n    The definition of 'second smallest' includes duplicates, meaning it is the element at index 1 after sorting.\"\"\"\n    sorted_values = sorted(values)\n    return sorted_values[1]"}
{"task_id": "Mbpp/758", "solution": "class OccurrenceCounter:\n    \"\"\"Helper class to count occurrences of hashable keys.\"\"\"\n    def __init__(self):\n        self.counts = {}\n\n    def increment(self, key: tuple) -> None:\n        \"\"\"Increments the count for a given tuple key.\"\"\"\n        self.counts[key] = self.counts.get(key, 0) + 1\n\n    def get_counts(self) -> dict:\n        \"\"\"Returns the internal dictionary of counts.\"\"\"\n        return self.counts\n\ndef unique_sublists(input_lists):\n    \"\"\"Accepts a top-level list of sublists, converts each sublist to tuple, counts occurrences, and returns dict mapping tuple->int.\n\n    Raises:\n      TypeError: if input_lists is not a list or a sublist is not a list, or if tuple keys are unhashable due to unhashable inner elements.\n    Returns:\n      dict: mapping from tuple to integer count (built-in dict and tuple types).\n    \"\"\"\n    if not isinstance(input_lists, list):\n        raise TypeError(\"Input must be a list.\")\n\n    counter = OccurrenceCounter()\n    for sublist in input_lists:\n        if not isinstance(sublist, list):\n            raise TypeError(f\"All elements in the input list must be lists, but found type {type(sublist)}.\")\n        \n        # This will raise TypeError if sublist elements are unhashable\n        # and therefore the resulting tuple cannot be used as a dict key.\n        sublist_as_tuple = tuple(sublist)\n        counter.increment(sublist_as_tuple)\n            \n    return counter.get_counts()"}
{"task_id": "Mbpp/754", "solution": "def _validate_inputs(l1, l2, l3) -> None:\n    \"\"\"\n    Raises TypeError if any of l1, l2, l3 is not a list.\n    Ensures inputs are list-like for safe indexing and length checks.\n    \"\"\"\n    if not isinstance(l1, list):\n        raise TypeError(\"l1 must be a list\")\n    if not isinstance(l2, list):\n        raise TypeError(\"l2 must be a list\")\n    if not isinstance(l3, list):\n        raise TypeError(\"l3 must be a list\")\n\ndef extract_index_list(l1, l2, l3) -> list:\n    \"\"\"\n    Returns a list of elements common at the same index across three lists.\n    Elements are included if l1[i] == l2[i] == l3[i] for valid indices i.\n    \"\"\"\n    _validate_inputs(l1, l2, l3)\n\n    min_len = min(len(l1), len(l2), len(l3))\n    result = []\n\n    for i in range(min_len):\n        if l1[i] == l2[i] == l3[i]:\n            result.append(l1[i])\n\n    return result"}
{"task_id": "Mbpp/759", "solution": "import re\n\nPATTERN: str = r'^[0-9]+\\.[0-9]{2}$'\n\ndef is_decimal(input: str) -> bool:\n    \"\"\"Return True if input matches PATTERN exactly, False otherwise.\n\n    Uses re.fullmatch(PATTERN, input).\n    \"\"\"\n    try:\n        return re.fullmatch(PATTERN, input) is not None\n    except Exception:\n        return False"}
{"task_id": "Mbpp/760", "solution": "from typing import List, Union\n\ndef unique_Element(list: List[Union[int, float]]) -> bool:\n    \"\"\"\n    Checks whether a list of numbers contains only one distinct element.\n    It validates input types and handles an empty list by raising a ValueError.\n    \"\"\"\n    if not isinstance(list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for element in list:\n        if not isinstance(element, (int, float)):\n            raise TypeError(\"All elements in the list must be numbers (int or float).\")\n\n    if not list:\n        raise ValueError(\"empty-list behavior undefined by SRS: stakeholder decision required\")\n\n    distinct_elements = set(list)\n    return len(distinct_elements) == 1"}
{"task_id": "Mbpp/762", "solution": "class Month:\n    \"\"\"Represents a calendar month with number, days, and name.\"\"\"\n    def __init__(self, number: int, days: int, name: str) -> None:\n        self.number = number\n        self.days = days\n        self.name = name\n\nclass MonthRepository:\n    \"\"\"Provides an in-memory lookup for Month instances by number.\"\"\"\n    _MONTHS: dict[int, Month] = {}\n\n    def __init__(self) -> None:\n        if not MonthRepository._MONTHS:\n            MonthRepository._MONTHS = {\n                1: Month(1, 31, \"January\"),\n                2: Month(2, 28, \"February\"),\n                3: Month(3, 31, \"March\"),\n                4: Month(4, 30, \"April\"),\n                5: Month(5, 31, \"May\"),\n                6: Month(6, 30, \"June\"),\n                7: Month(7, 31, \"July\"),\n                8: Month(8, 31, \"August\"),\n                9: Month(9, 30, \"September\"),\n                10: Month(10, 31, \"October\"),\n                11: Month(11, 30, \"November\"),\n                12: Month(12, 31, \"December\"),\n            }\n\n    def get_month(self, number: int) -> Month:\n        \"\"\"Returns the Month instance for the given number, assuming valid input.\"\"\"\n        return MonthRepository._MONTHS[number]\n\nclass MonthChecker:\n    \"\"\"Checks whether a given month number corresponds to a 30-day month.\"\"\"\n    def __init__(self, repository: MonthRepository = None) -> None:\n        self.repository = repository if repository is not None else MonthRepository()\n\n    def check_monthnumber_number(self, month: int) -> bool:\n        \"\"\"Determines if the month has 30 days, assuming valid input.\"\"\"\n        month_data = self.repository.get_month(month)\n        return month_data.days == 30\n\ndef check_monthnumber_number(month: int) -> bool:\n    \"\"\"Checks whether the given month number contains 30 days or not.\"\"\"\n    checker = MonthChecker()\n    return checker.check_monthnumber_number(month)"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(array, n):\n    \"\"\"\n    Finds the minimum difference between any two elements among the first n elements of an array.\n    Assumes valid input: array is a sequence with at least n integers, and n >= 2.\n    \"\"\"\n    elements = list(array[:n])\n    elements.sort()\n\n    min_diff = float('inf')\n    for i in range(1, len(elements)):\n        current_diff = elements[i] - elements[i-1]\n        if current_diff < min_diff:\n            min_diff = current_diff\n            \n    return min_diff"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(s: str) -> int:\n    \"\"\"Count ASCII digits '0'..'9' in string s and return the count as an int.\n\n    Preconditions: s is a Python str (behavior for non-str inputs is unspecified in SRS).\n    \"\"\"\n    count = 0\n    for char in s:\n        if '0' <= char <= '9':\n            count += 1\n    return count"}
{"task_id": "Mbpp/769", "solution": "def _validate_inputs(list1, list2):\n    \"\"\"Raise TypeError if list1 or list2 is not a Python list.\"\"\"\n    if not isinstance(list1, list) or not isinstance(list2, list):\n        raise TypeError(\"list1 and list2 must be Python lists\")\n\ndef Diff(list1, list2):\n    \"\"\"Compute and return list of elements in list1 not present in list2. Raises TypeError if inputs not lists.\"\"\"\n    _validate_inputs(list1, list2)\n    result = []\n    for element in list1:\n        if element not in list2:\n            result.append(element)\n    return result"}
{"task_id": "Mbpp/767", "solution": "from typing import List, Union\n\ndef get_pairs_count(numbers, target_sum):\n    \"\"\"\n    Parameters:\n    - numbers: list of numbers\n    - target_sum: numeric target (int or float)\n\n    Returns:\n    - int: number of unordered index-based pairs (i<j) whose sum equals target_sum\n\n    Raises:\n    - TypeError: if numbers is not a list or target_sum is not numeric\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"numbers must be a list\")\n    if not isinstance(target_sum, (int, float)):\n        raise TypeError(\"target_sum must be a number\")\n\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/765", "solution": "class ErrorHandler:\n    \"\"\"Centralized error raising.\"\"\"\n    def raise_error(self, message: str):\n        raise ValueError(message)\n\nclass InputValidator:\n    \"\"\"Validates input n is an integer and n >= 1.\"\"\"\n    def __init__(self, error_handler: 'ErrorHandler'):\n        self._error_handler = error_handler\n\n    def validate_positive_integer(self, n):\n        if not isinstance(n, int):\n            self._error_handler.raise_error(\"Input must be an integer.\")\n        if n < 1:\n            self._error_handler.raise_error(\"Input must be a positive integer (n >= 1).\")\n\nclass PowerOfTwoChecker:\n    \"\"\"Provides boolean check for exact powers of two.\"\"\"\n    def is_power_of_two(self, x: int) -> bool:\n        return x > 0 and (x & (x - 1) == 0)\n\nclass PoliteNumber:\n    \"\"\"In-memory domain entity for a polite number.\"\"\"\n    def __init__(self, value: int, index: int):\n        self.value = value\n        self.index = index\n\nclass PoliteNumberGenerator:\n    \"\"\"Generates the nth polite number.\"\"\"\n    def __init__(self, power_checker: 'PowerOfTwoChecker', validator: 'InputValidator', error_handler: 'ErrorHandler'):\n        self._power_checker = power_checker\n        self._validator = validator\n        self._error_handler = error_handler\n\n    def get_nth_polite(self, n: int) -> 'PoliteNumber':\n        polite_count = 0\n        candidate_num = 0\n        while polite_count < n:\n            candidate_num += 1\n            if not self._power_checker.is_power_of_two(candidate_num):\n                polite_count += 1\n        return PoliteNumber(value=candidate_num, index=n)\n\ndef is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number (1-based index).\n    A polite number is a positive integer that is not an exact power of two.\n    \"\"\"\n    error_handler = ErrorHandler()\n    validator = InputValidator(error_handler=error_handler)\n    power_checker = PowerOfTwoChecker()\n    generator = PoliteNumberGenerator(\n        power_checker=power_checker,\n        validator=validator,\n        error_handler=error_handler\n    )\n\n    validator.validate_positive_integer(n)\n    polite_num_entity = generator.get_nth_polite(n)\n    return polite_num_entity.value"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(list):\n    \"\"\"Return list of consecutive 2-tuples from input 'list'.\n\n    Args:\n        list: sequence supporting len() and indexing.\n\n    Returns:\n        list: list of 2-tuples where each tuple is (list[i], list[i+1]).\n    \"\"\"\n    if len(list) < 2:\n        return []\n\n    result = []\n    for i in range(len(list) - 1):\n        result.append((list[i], list[i+1]))\n    return result"}
{"task_id": "Mbpp/770", "solution": "class OddNumber:\n    \"\"\"Represents a single odd number based on its index.\"\"\"\n    def __init__(self, index: int):\n        self.index = index\n        self.value = 2 * index - 1\n\nclass OddNumberSequence:\n    \"\"\"Generates an ordered sequence of OddNumber instances up to n.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def __iter__(self):\n        for k in range(1, self.n + 1):\n            yield OddNumber(k)\n\n    def generate(self):\n        return [OddNumber(k) for k in range(1, self.n + 1)]\n\nclass SumResult:\n    \"\"\"Encapsulates the computed integer result.\"\"\"\n    def __init__(self, value: int):\n        self.value = int(value)\n\nclass InputParameter:\n    \"\"\"Validates input parameter n to ensure it's a positive integer.\"\"\"\n    def __init__(self, n):\n        if not isinstance(n, int):\n            raise TypeError(\"n must be an integer\")\n        if n < 1:\n            raise ValueError(\"n must be a positive integer (>= 1)\")\n        self.n = n\n\nclass SumCalculator:\n    \"\"\"Orchestrates the generation of odd numbers and accumulation of their fourth powers.\"\"\"\n    def odd_num_sum(self, n: int) -> int:\n        seq = OddNumberSequence(n)\n        total = 0\n        for odd in seq:\n            total += odd.value ** 4\n        return int(total)\n\ndef odd_num_sum(n: int) -> int:\n    \"\"\"\n    Finds the sum of the fourth power of the first n odd natural numbers.\n    It validates input and delegates computation to SumCalculator.\n    \"\"\"\n    InputParameter(n)\n    return SumCalculator().odd_num_sum(n)"}
{"task_id": "Mbpp/771", "solution": "from typing import List, Optional\n\nclass Stack:\n    \"\"\"Simple LIFO stack for Bracket objects.\"\"\"\n    def __init__(self):\n        self._items: List[\"Bracket\"] = []\n\n    def push(self, b: \"Bracket\") -> None:\n        self._items.append(b)\n\n    def pop(self) -> Optional[\"Bracket\"]:\n        if not self.is_empty():\n            return self._items.pop()\n        return None\n\n    def peek(self) -> Optional[\"Bracket\"]:\n        if not self.is_empty():\n            return self._items[-1]\n        return None\n\n    def is_empty(self) -> bool:\n        return len(self._items) == 0\n\nclass Bracket:\n    \"\"\"Represents a bracket token with symbol, type, and position.\"\"\"\n    _OPENING_SYMBOLS = {'(', '[', '{'}\n    _CLOSING_SYMBOLS = {')', ']', '}'}\n\n    def __init__(self, symbol: str, position: int):\n        self.symbol: str = symbol\n        self.position: int = position\n        if symbol in self._OPENING_SYMBOLS:\n            self.type: str = \"opening\"\n        elif symbol in self._CLOSING_SYMBOLS:\n            self.type: str = \"closing\"\n        else:\n            self.type: str = \"unknown\" # Should ideally not be reached by _tokenize\n\nclass Expression:\n    \"\"\"Lightweight container for the input string and its length.\"\"\"\n    def __init__(self, content: str):\n        self.content: str = content\n        self.length: int = len(content)\n\nclass BalanceChecker:\n    \"\"\"Orchestrates tokenization and stack-based validation for bracket balance.\"\"\"\n    _PAIRS = {')': '(', ']': '[', '}': '{'}\n    _OPENING_BRACKETS = {'(', '[', '{'}\n    _CLOSING_BRACKETS = {')', ']', '}'}\n    _ALL_BRACKETS = _OPENING_BRACKETS.union(_CLOSING_BRACKETS)\n\n    def _tokenize(self, expr: Expression) -> List[Bracket]:\n        \"\"\"Extracts bracket characters from the expression content.\"\"\"\n        tokens: List[Bracket] = []\n        for i, char in enumerate(expr.content):\n            if char in self._ALL_BRACKETS:\n                tokens.append(Bracket(char, i))\n        return tokens\n\n    def _matches(self, opening_symbol: str, closing_symbol: str) -> bool:\n        \"\"\"Checks if a closing bracket symbol matches an opening bracket symbol.\"\"\"\n        return self._PAIRS.get(closing_symbol) == opening_symbol\n\n    def check_expression(self, input_str: str) -> bool:\n        \"\"\"Determines if the grouping symbols in the input string are balanced.\"\"\"\n        if not input_str:\n            return True # Empty string is treated as balanced\n\n        expr = Expression(input_str)\n        tokens = self._tokenize(expr)\n        stack = Stack()\n\n        for bracket in tokens:\n            if bracket.type == \"opening\":\n                stack.push(bracket)\n            elif bracket.type == \"closing\":\n                if stack.is_empty():\n                    return False # Closing bracket found with no matching opening\n                \n                top_bracket = stack.pop()\n                if not self._matches(top_bracket.symbol, bracket.symbol):\n                    return False # Mismatched bracket types\n        \n        return stack.is_empty() # All opening brackets must have been matched\n\ndef check_expression(input: str) -> bool:\n    \"\"\"\n    Public API to check if the given expression is balanced or not.\n    Delegates the balance checking logic to an instance of BalanceChecker.\n    \"\"\"\n    checker = BalanceChecker()\n    return checker.check_expression(input)"}
{"task_id": "Mbpp/772", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    raw_text: str\n\n@dataclass\nclass Word:\n    text: str\n    def length(self) -> int:\n        \"\"\"Return len(self.text). Punctuation counts as part of length.\"\"\"\n        return len(self.text)\n\n@dataclass\nclass OutputString:\n    result_text: str\n\nclass Tokenizer:\n    def tokenize(self, rawText: str) -> list[Word]:\n        \"\"\"Return list[Word] from rawText by splitting on whitespace (maximal non-space sequences).\"\"\"\n        return [Word(text=token_text) for token_text in rawText.split()]\n\nclass Filter:\n    def filterByLength(self, words: list[Word], k: int) -> list[Word]:\n        \"\"\"Return list[Word] where word.length() != k.\"\"\"\n        return [word for word in words if word.length() != k]\n\nclass Joiner:\n    def joinWithSingleSpace(self, words: list[Word]) -> str:\n        \"\"\"Join Word.text values with single ASCII spaces; return empty string if words is empty.\"\"\"\n        word_texts = [word.text for word in words]\n        return ' '.join(word_texts)\n\ndef remove_length(input: str, k: int) -> str:\n    \"\"\"Orchestrates Tokenizer.tokenize, Filter.filterByLength, Joiner.joinWithSingleSpace.\n\n    Example (acceptance):\n    assert remove_length('The person is most value tet', 3) == 'person is most value'\n    \"\"\"\n    raw = InputString(raw_text=input)\n    tokenizer = Tokenizer()\n    tokens = tokenizer.tokenize(raw.raw_text)\n    fltr = Filter()\n    remaining = fltr.filterByLength(tokens, k)\n    joiner = Joiner()\n    result = joiner.joinWithSingleSpace(remaining)\n    return result"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(input_string: str, substring: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence and position of a substring within a string.\n    Returns None if there is no match.\n    \"\"\"\n    start_index = input_string.find(substring)\n    if start_index == -1:\n        return None\n    end_index = start_index + len(substring)\n    return (substring, start_index, end_index)"}
{"task_id": "Mbpp/775", "solution": "def odd_position(lst: list[int]) -> bool:\n    \"\"\"Return True iff every element at odd indices of lst is odd.\"\"\"\n    for i in range(1, len(lst), 2):\n        if lst[i] % 2 == 0:\n            return False\n    return True"}
{"task_id": "Mbpp/777", "solution": "from collections import Counter\nfrom typing import List, Union\n\ndef find_sum(input_list: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Compute sum of elements occurring exactly once in the input list.\n    It uses collections.Counter to efficiently count element occurrences.\n    \"\"\"\n    counts = Counter(input_list)\n    total = 0\n    for val, cnt in counts.items():\n        if cnt == 1:\n            total += val\n    return total"}
{"task_id": "Mbpp/778", "solution": "from typing import Any, List\n\nclass Element:\n    \"\"\"Encapsulates a raw value and provides equality semantics.\"\"\"\n    def __init__(self, value: Any):\n        self.value = value\n\n    def equals(self, other: 'Element') -> bool:\n        \"\"\"Compares the value of this Element with another Element.\"\"\"\n        return self.value == other.value\n\nclass Group:\n    \"\"\"Encapsulates consecutive Element membership and conversion to a plain list.\"\"\"\n    def __init__(self, first: Element = None):\n        self.members: List[Element] = []\n        if first is not None:\n            self.append(first)\n\n    def append(self, e: Element) -> None:\n        \"\"\"Adds an Element to the group.\"\"\"\n        self.members.append(e)\n\n    def to_list(self) -> list:\n        \"\"\"Converts group members to a list of raw values.\"\"\"\n        return [e.value for e in self.members]\n\nclass _GroupBuilder:\n    \"\"\"Internal helper to build groups of consecutive duplicate elements.\"\"\"\n    def __init__(self):\n        self.current_group: Group | None = None\n        self.groups: List[Group] = []\n\n    def build_groups(self, input_list: list) -> List[Group]:\n        \"\"\"Iterates through the input list to form groups of consecutive duplicates.\"\"\"\n        self.groups = []\n        self.current_group = None\n\n        if not input_list:\n            return []\n\n        for item in input_list:\n            new_element = Element(item)\n            if self.current_group is None:\n                self.current_group = Group(new_element)\n                self.groups.append(self.current_group)\n            else:\n                last_element_in_current_group = self.current_group.members[-1]\n                if new_element.equals(last_element_in_current_group):\n                    self.current_group.append(new_element)\n                else:\n                    self.current_group = Group(new_element)\n                    self.groups.append(self.current_group)\n        return self.groups\n\ndef pack_consecutive_duplicates(list: list) -> list:\n    \"\"\"\n    Packs consecutive duplicates of a given list elements into sublists.\n    This function processes the input to group identical, consecutive elements.\n    \"\"\"\n    if not list:\n        return []\n\n    builder = _GroupBuilder()\n    grouped_elements = builder.build_groups(list)\n    return [group.to_list() for group in grouped_elements]"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(input_list: list[int]) -> int:\n    \"\"\"Compute sum of all elements from every contiguous subarray of odd length.\n\n    Returns the integer sum across all odd-length contiguous subarrays.\n    \"\"\"\n    total_sum = 0\n    n = len(input_list)\n\n    for i in range(n):\n        for j in range(i, n):\n            # j - i + 1 gives the length of the current subarray\n            if (j - i + 1) % 2 != 0:  # Check if subarray length is odd\n                for k in range(i, j + 1):\n                    total_sum += input_list[k]\n    return total_sum"}
{"task_id": "Mbpp/780", "solution": "from typing import List, Tuple, Any, Iterable\nfrom dataclasses import dataclass\n\n@dataclass\nclass TupleItem:\n    a: int\n    b: int\n    index: int\n\n@dataclass\nclass Combination:\n    sum_a: int\n    sum_b: int\n    index_i: int\n    index_j: int\n\nclass Validator:\n    @staticmethod\n    def is_valid_tuple(obj: Any) -> bool:\n        \"\"\"Return True if obj is a tuple of length 2 and both elements are ints; otherwise False.\"\"\"\n        return (\n            isinstance(obj, tuple)\n            and len(obj) == 2\n            and isinstance(obj[0], int)\n            and isinstance(obj[1], int)\n        )\n\n    @staticmethod\n    def ensure_all_valid(items: Iterable[Any]) -> None:\n        \"\"\"Iterate items and raise TypeError if any element fails is_valid_tuple.\"\"\"\n        for item in items:\n            if not Validator.is_valid_tuple(item):\n                raise TypeError(\n                    \"Input list must contain only 2-element tuples of integers.\"\n                )\n\nclass FindCombinationsService:\n    def validate_input(self, raw_items: List[Tuple[int, int]]) -> None:\n        \"\"\"Delegate to Validator.ensure_all_valid or raise TypeError.\"\"\"\n        Validator.ensure_all_valid(raw_items)\n\n    def compute_pair_sums(self, items: List[TupleItem]) -> List[Combination]:\n        \"\"\"Enumerate i from 0..n-2 and j from i+1..n-1 producing Combination objects.\"\"\"\n        combinations = []\n        n = len(items)\n        for i in range(n - 1):\n            for j in range(i + 1, n):\n                item_i = items[i]\n                item_j = items[j]\n                sum_a = item_i.a + item_j.a\n                sum_b = item_i.b + item_j.b\n                combinations.append(\n                    Combination(sum_a, sum_b, item_i.index, item_j.index)\n                )\n        return combinations\n\ndef find_combinations(input_list: List[Tuple[int, int]]) -> List[Tuple[int, int]]:\n    \"\"\"\n    Finds combinations of sums with tuples in the given tuple list.\n    Validates input, computes pairwise sums, and returns results as a list of tuples.\n    \"\"\"\n    Validator.ensure_all_valid(input_list)\n\n    n = len(input_list)\n    if n < 2:\n        return []\n\n    tuple_items = [\n        TupleItem(a=item[0], b=item[1], index=idx)\n        for idx, item in enumerate(input_list)\n    ]\n\n    service = FindCombinationsService()\n    combinations_obj = service.compute_pair_sums(tuple_items)\n\n    return [(c.sum_a, c.sum_b) for c in combinations_obj]"}
{"task_id": "Mbpp/781", "solution": "import math\n\nclass NumberInput:\n    \"\"\"Represents and validates input n.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def is_integer(self) -> bool:\n        \"\"\"Returns True if the value is an integer, False otherwise.\"\"\"\n        return isinstance(self.value, int)\n\nclass CalculationResult:\n    \"\"\"Holds result of counting divisors and parity decision.\"\"\"\n    def __init__(self, divisor_count: int, is_even: bool):\n        self.divisor_count = divisor_count\n        self.is_even = is_even\n\nclass DivisorCalculator:\n    \"\"\"Domain logic for divisibility tests, counting divisors, and parity determination.\"\"\"\n    def is_divisor(self, n: int, d: int) -> bool:\n        \"\"\"Return True if d is a positive divisor of n (d >= 1 and n % d == 0).\"\"\"\n        return d >= 1 and n % d == 0\n\n    def count_divisors(self, n: int) -> int:\n        \"\"\"Compute count of positive integer divisors of n.\"\"\"\n        if n < 1:\n            return 0 # Per BR3, there are no positive divisors for n <= 0.\n\n        count = 0\n        for i in range(1, int(math.sqrt(n)) + 1):\n            if self.is_divisor(n, i):\n                if i * i == n:\n                    count += 1\n                else:\n                    count += 2\n        return count\n\n    def is_count_even(self, n: int) -> bool:\n        \"\"\"Return True if divisor count is even, else False.\"\"\"\n        c = self.count_divisors(n)\n        return (c % 2) == 0\n\ndef count_divisors(n) -> bool:\n    \"\"\"\n    Checks whether the count of positive divisors of integer n is even.\n    Returns True if the count is even, False otherwise.\n    \"\"\"\n    inp = NumberInput(n)\n    if not inp.is_integer():\n        raise TypeError(\"n must be an integer\")\n    \n    dc = DivisorCalculator()\n    return dc.is_count_even(n)\n\nclass TestAssertion:\n    \"\"\"Encapsulates the assert count_divisors(10) acceptance test.\"\"\"\n    @staticmethod\n    def assert_count_divisors_10() -> None:\n        \"\"\"Executes assert count_divisors(10) raising AssertionError on failure.\"\"\"\n        assert count_divisors(10)\n\nTestAssertion.assert_count_divisors_10()"}
{"task_id": "Mbpp/787", "solution": "def _contains_abbb(input: str) -> bool:\n    \"\"\"\n    Checks if the literal substring \"abbb\" exists in the input string.\n    This is a module-private helper function.\n    \"\"\"\n    return \"abbb\" in input\n\ndef text_match_three(input: str) -> bool:\n    \"\"\"\n    Matches a string that has an 'a' followed by three 'b' characters (\"abbb\").\n    Returns True if \"abbb\" is found contiguously in the input, False otherwise.\n    \"\"\"\n    return _contains_abbb(input)"}
{"task_id": "Mbpp/785", "solution": "import re\nfrom typing import List, Tuple\n\nclass Parser:\n    \"\"\"Parses input strings formatted as '(n1, n2, ..., nN)' and returns token strings for integer literals.\"\"\"\n\n    def parseTuple(self, input: str) -> List[str]:\n        \"\"\"Extracts numeric token strings from the input tuple string.\"\"\"\n        return self._tokenize(input)\n\n    def _tokenize(self, input: str) -> List[str]:\n        \"\"\"Internal method to tokenize the input string, ignoring whitespace and separators.\"\"\"\n        # This regex pattern matches integers, optionally preceded by a minus sign.\n        integer_pattern = re.compile(r'-?\\d+')\n        # findall extracts all non-overlapping matches, implicitly ignoring surrounding whitespace and non-digit characters.\n        return integer_pattern.findall(input)\n\nclass IntegerToken:\n    \"\"\"Encapsulates conversion from numeric string to integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    @staticmethod\n    def fromString(s: str) -> 'IntegerToken':\n        \"\"\"Converts a numeric token string to an IntegerToken instance.\"\"\"\n        return IntegerToken(int(s))\n\nclass TupleResult:\n    \"\"\"Accumulates integer values and produces the final tuple to return.\"\"\"\n    def __init__(self):\n        self._values: List[int] = []\n\n    def add(self, value: int) -> None:\n        \"\"\"Adds an integer value to the accumulator.\"\"\"\n        self._values.append(value)\n\n    def toTuple(self) -> Tuple[int, ...]:\n        \"\"\"Returns the accumulated integer values as a tuple.\"\"\"\n        return tuple(self._values)\n\nclass TupleStringConverter:\n    \"\"\"Orchestrates parsing and conversion of a tuple string to an integer tuple.\"\"\"\n\n    def tuple_str_int(self, input: str) -> Tuple[int, ...]:\n        \"\"\"Converts a string representation of an integer tuple into a native tuple of integers.\"\"\"\n        parser = Parser()\n        tokens = parser.parseTuple(input)\n\n        tuple_result = TupleResult()\n        for token_str in tokens:\n            integer_token = IntegerToken.fromString(token_str)\n            tuple_result.add(integer_token.value)\n\n        return tuple_result.toTuple()\n\ndef tuple_str_int(input: str) -> Tuple[int, ...]:\n    \"\"\"\n    Converts a tuple string representation like \"(7, 8, 9)\" into an integer tuple (7, 8, 9).\n    This function delegates to an internal TupleStringConverter for orchestration.\n    \"\"\"\n    converter = TupleStringConverter()\n    return converter.tuple_str_int(input)"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(values, x):\n    \"\"\"\n    Locate the right insertion point for a specified value in sorted order using binary search.\n    The function ensures insertion after any existing equal elements.\n    \"\"\"\n    lo = 0\n    hi = len(values)\n\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if values[mid] <= x:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo"}
{"task_id": "Mbpp/784", "solution": "from typing import List\n\ndef _is_even(value: int) -> bool:\n    \"\"\"Checks if a number is even.\"\"\"\n    return value % 2 == 0\n\ndef _is_odd(value: int) -> bool:\n    \"\"\"Checks if a number is odd.\"\"\"\n    return value % 2 != 0\n\ndef mul_even_odd(items: List[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd number in a list.\n    The list is traversed left-to-right to find both numbers.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for item in items:\n        if first_odd is None and _is_odd(item):\n            first_odd = item\n        \n        if first_even is None and _is_even(item):\n            first_even = item\n            \n        if first_even is not None and first_odd is not None:\n            break\n            \n    return first_even * first_odd"}
