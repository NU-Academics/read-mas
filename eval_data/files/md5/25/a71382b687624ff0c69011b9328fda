{"task_id": "Mbpp/415", "solution": "from typing import List, Tuple\n\nclass IntegerPair:\n    \"\"\"\n    Value object for two integers and their product.\n    \"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n\n    def product(self) -> int:\n        \"\"\"Calculates and returns the product of the two integers.\"\"\"\n        return self.a * self.b\n\nclass IntegerList:\n    \"\"\"\n    Validates that items is a list/sequence, length >= 2, and all elements are ints.\n    \"\"\"\n    def __init__(self, items) -> None:\n        self.items = items\n\n    def validate(self) -> bool:\n        \"\"\"\n        Validates the input list, raising TypeError or ValueError for invalid inputs.\n        \"\"\"\n        if not isinstance(self.items, list):\n            raise TypeError(\"Input must be a list.\")\n        if len(self.items) < 2:\n            raise ValueError(\"Input list must contain at least two elements.\")\n        for item in self.items:\n            if not isinstance(item, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n        return True\n\nclass ProductCalculator:\n    \"\"\"\n    Computes the unordered pair of integers from a validated list that yields the maximal product.\n    \"\"\"\n    def compute(self, items: List[int]) -> Tuple[int,int]:\n        \"\"\"\n        Finds the pair with the highest product using an O(N) scan for two largest and two smallest numbers.\n        Tie-breaking: If products are equal, the pair of largest absolute values is chosen, and the returned tuple is sorted.\n        \"\"\"\n        # Initialize variables to track the two largest and two smallest numbers\n        max1 = float('-inf')\n        max2 = float('-inf')\n        min1 = float('inf')\n        min2 = float('inf')\n\n        for num in items:\n            # Update the two largest numbers (max1 is the largest, max2 is the second largest)\n            if num >= max1:\n                max2 = max1\n                max1 = num\n            elif num > max2:\n                max2 = num\n\n            # Update the two smallest numbers (min1 is the smallest, min2 is the second smallest)\n            if num <= min1:\n                min2 = min1\n                min1 = num\n            elif num < min2:\n                min2 = num\n        \n        # Calculate the two potential maximal products:\n        # 1. Product of the two largest numbers (if both are positive, or one is zero/small positive)\n        prod_pos = max1 * max2\n        # 2. Product of the two smallest numbers (if both are negative, resulting in a positive product)\n        prod_neg = min1 * min2\n\n        # Compare the two products and return the pair that yields the maximal product.\n        # The tuple is sorted to ensure a deterministic output format (e.g., (7,8) instead of (8,7)).\n        if prod_pos >= prod_neg:\n            return tuple(sorted((max1, max2)))\n        else:\n            return tuple(sorted((min1, min2)))\n\nclass MaxProductFunction:\n    \"\"\"\n    Orchestrates validation and computation for max_Product.\n    \"\"\"\n    def __init__(self, items: List[int]) -> None:\n        self.items = items\n\n    def computeMaxPair(self) -> Tuple[int,int]:\n        \"\"\"\n        Validates the input list and computes the maximal product pair.\n        \"\"\"\n        integer_list_validator = IntegerList(self.items)\n        integer_list_validator.validate() # This method raises exceptions for invalid inputs.\n\n        product_calculator = ProductCalculator()\n        return product_calculator.compute(self.items)\n\ndef max_Product(items) -> Tuple[int,int]:\n    \"\"\"\n    Finds a pair with the highest product from a given array of integers.\n    \"\"\"\n    mpf = MaxProductFunction(items)\n    return mpf.computeMaxPair()"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    \"\"\"Compute and return the sum of cubes of the first n even natural numbers.\n\n    Parameters:\n        n (int): Number of first even natural numbers (n >= 0).\n\n    Returns:\n        int: Sum_{k=1..n} (2k)^3 computed using closed-form identity 2*(n*(n+1))^2.\n\n    Raises:\n        ValueError: If n < 0 (invalid input).\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Invalid input: n must be a non-negative integer\")\n    elif n == 0:\n        return 0\n    else:\n        # Compute using the closed-form identity: sum_{k=1..n} (2k)^3 = 2 * (n * (n + 1))^2\n        return 2 * (n * (n + 1)) ** 2"}
