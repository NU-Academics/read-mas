{"task_id": "Mbpp/591", "solution": "def swap_List(input_list: list) -> list:\n    \"\"\"Swaps the first and last elements of a list, returning a new list.\n    If the list has fewer than two elements, a copy of the original list is returned.\n    \"\"\"\n    length = len(input_list)\n    if length < 2:\n        return input_list[:]\n    else:\n        return [input_list[-1]] + input_list[1:-1] + [input_list[0]]"}
{"task_id": "Mbpp/589", "solution": "import math\n\ndef perfect_squares(start, end):\n    \"\"\"\n    Return a list of perfect squares m such that start <= m <= end (inclusive).\n    The list is sorted in ascending order.\n    \"\"\"\n    results = []\n    \n    # Calculate the minimum integer k whose square is >= start.\n    # If start is negative, the first possible perfect square is 0 (0*0).\n    # math.sqrt(x) expects x >= 0.\n    # To handle negative 'start' without errors, we use max(0, start).\n    # Then ensure k is non-negative.\n    k_min = max(0, int(math.ceil(math.sqrt(max(0, start)))))\n    \n    # Calculate the maximum integer k whose square is <= end.\n    # If end is negative, there are no perfect squares in the range.\n    # math.sqrt(x) expects x >= 0.\n    # To handle negative 'end' without errors, we use max(0, end).\n    k_max = int(math.floor(math.sqrt(max(0, end))))\n    \n    # Iterate from k_min to k_max (inclusive) to find perfect squares.\n    # If k_min > k_max, the range is empty, and the loop won't execute.\n    for k in range(k_min, k_max + 1):\n        m = k * k\n        # Ensure the generated perfect square is within the original [start, end] bounds.\n        # This check is primarily for edge cases where start is negative but k_min is 0,\n        # or when end is negative, leading to k_max potentially being 0, but m=0*0 might not be in the original range.\n        if start <= m <= end:\n            results.append(m)\n            \n    return results"}
{"task_id": "Mbpp/588", "solution": "from numbers import Number\n\ndef _validate_input(values):\n    \"\"\"\n    Validates the input list for emptiness and numeric elements.\n    Raises ValueError or TypeError for invalid input.\n    \"\"\"\n    if not values:\n        raise ValueError(\"input list must contain at least one numeric value\")\n\n    for element in values:\n        if not isinstance(element, Number):\n            raise TypeError(\"all elements must be numeric\")\n\ndef big_diff(values):\n    \"\"\"\n    Calculates the difference between the largest and smallest value in a given list.\n    Raises ValueError for empty lists or TypeError for non-numeric elements.\n    \"\"\"\n    _validate_input(values)\n    return max(values) - min(values)"}
{"task_id": "Mbpp/592", "solution": "class TypeValidationError(TypeError):\n    \"\"\"Exception raised for type validation errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass NegativeValueError(ValueError):\n    \"\"\"Exception raised for negative input values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass IntegerParameter:\n    \"\"\"Encapsulates input validation logic for an integer parameter.\"\"\"\n    def __init__(self, value: object):\n        self.value = value\n\n    def validate(self) -> None:\n        \"\"\"Validates that the parameter is a non-negative integer.\"\"\"\n        if not isinstance(self.value, int):\n            raise TypeValidationError(\"Input 'n' must be an integer.\")\n        if self.value < 0:\n            raise NegativeValueError(\"Input 'n' cannot be negative.\")\n\nclass BinomialCoefficient:\n    \"\"\"Computes exact integer binomial coefficients C(n,k).\"\"\"\n    def compute(self, n: int, k: int) -> int:\n        \"\"\"Calculates C(n,k) using an iterative product for exact integer results.\"\"\"\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        # Use symmetry C(n, k) = C(n, n-k) to reduce computations\n        if k > n // 2:\n            k = n - k\n        \n        res = 1\n        for i in range(k):\n            res = res * (n - i) // (i + 1)\n        return res\n\nclass Computation:\n    \"\"\"Orchestrates calculation of terms and their aggregation.\"\"\"\n    def __init__(self, n: int, binom: BinomialCoefficient):\n        self.n = n\n        self.binom = binom\n        self.terms: list[int] = []\n\n    def aggregate(self) -> int:\n        \"\"\"Computes and sums the products of consecutive binomial coefficients.\"\"\"\n        total_sum = 0\n        # Iterate for k from 0 to n-1\n        for k in range(self.n):\n            c_nk = self.binom.compute(self.n, k)\n            c_nk_plus_1 = self.binom.compute(self.n, k + 1)\n            term = c_nk * c_nk_plus_1\n            self.terms.append(term)\n            total_sum += term\n        return total_sum\n\nclass Result:\n    \"\"\"Simple holder for the final integer result value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients.\n    S(n) = sum_{k=0}^{n-1} C(n,k) * C(n,k+1).\n    \"\"\"\n    # Validate the input parameter 'n' for type and range.\n    param = IntegerParameter(n)\n    param.validate()\n\n    # Return 0 for the base case where n is 0.\n    if n == 0:\n        return 0\n\n    # Initialize components required for the computation.\n    binom_calculator = BinomialCoefficient()\n    computation_instance = Computation(n, binom_calculator)\n    \n    # Aggregate the sum of products of binomial coefficients.\n    result_value = computation_instance.aggregate()\n\n    # Encapsulate the result as per design and return its value.\n    final_result = Result(result_value)\n    return final_result.value"}
{"task_id": "Mbpp/593", "solution": "from typing import List\n\nclass ValidationError(Exception):\n    \"\"\"Domain exception for input validation failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass Octet:\n    \"\"\"Represents a single octet of an IP address and handles its normalization.\"\"\"\n    def __init__(self, raw_value: str) -> None:\n        self.raw_value = raw_value\n        self.normalized_value = raw_value # Initialize with raw value\n\n    def removeLeadingZeros(self) -> None:\n        \"\"\"Removes leading '0' characters from the octet's value.\"\"\"\n        self.normalized_value = self.raw_value.lstrip('0')\n\n    def isAllZeros(self) -> bool:\n        \"\"\"Checks if the raw octet value consists only of '0' characters.\"\"\"\n        return self.raw_value.strip('0') == ''\n\nclass IPAddress:\n    \"\"\"Represents an IPv4 address, parses it, and orchestrates octet normalization.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw = raw\n        self.octets: List[Octet] = []\n\n    def parse(self) -> None:\n        \"\"\"Splits the raw IP string into octets and creates Octet instances.\"\"\"\n        segments = self.raw.split('.')\n        if len(segments) != 4:\n            raise ValidationError(\"expected 4 segments\")\n        self.octets = [Octet(segment) for segment in segments]\n\n    def normalize(self) -> None:\n        \"\"\"Normalizes each octet by removing leading zeros and handling empty results.\"\"\"\n        for octet in self.octets:\n            octet.removeLeadingZeros()\n            if not octet.normalized_value: # If it became empty (e.g., '00' -> '')\n                octet.normalized_value = '0'\n\n    def get_normalized(self) -> str:\n        \"\"\"Returns the normalized IP address string.\"\"\"\n        return '.'.join([octet.normalized_value for octet in self.octets])\n\ndef removezero_ip(address: str) -> str:\n    \"\"\"Accepts IPv4-like string and returns normalized dotted-decimal string.\n    Raises ValidationError for malformed inputs (non-4-segment strings).\n    \"\"\"\n    ip_address = IPAddress(address)\n    ip_address.parse()\n    ip_address.normalize()\n    return ip_address.get_normalized()"}
{"task_id": "Mbpp/594", "solution": "from typing import Optional, List\nfrom src.domain import InputList, Result\n\ndef _find_first_odd(nums: List[int]) -> Optional[int]:\n    \"\"\"Finds the first odd number in a list by scanning left-to-right. Returns None if no odd number is found.\"\"\"\n    for n in nums:\n        if n % 2 != 0:\n            return n\n    return None\n\ndef _find_first_even(nums: List[int]) -> Optional[int]:\n    \"\"\"Finds the first even number in a list by scanning left-to-right. Returns None if no even number is found.\"\"\"\n    for n in nums:\n        if n % 2 == 0:\n            return n\n    return None\n\ndef diff_even_odd(nums: List[int]) -> int:\n    \"\"\"\n    Finds the difference of the first even and first odd number of a given list.\n    Raises ValueError if either the first odd or first even number is not found.\n    \"\"\"\n    first_odd = _find_first_odd(nums)\n    first_even = _find_first_even(nums)\n\n    if first_odd is None:\n        raise ValueError(\"No odd number found in the list.\")\n    if first_even is None:\n        raise ValueError(\"No even number found in the list.\")\n\n    return first_even - first_odd"}
{"task_id": "Mbpp/590", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import Tuple\n\n@dataclass(frozen=True)\nclass PolarCoordinate:\n    r: float\n    theta: float\n\n    def to_tuple(self) -> Tuple[float, float]:\n        return self.r, self.theta\n\n@dataclass(frozen=True)\nclass RectangularCoordinate:\n    x: float\n    y: float\n\n    def as_complex(self) -> complex:\n        return complex(self.x, self.y)\n\n    def to_tuple(self) -> Tuple[float, float]:\n        return self.x, self.y\n\ndef polar_rect(r: float, theta: float) -> Tuple[Tuple[float, float], complex]:\n    \"\"\"Convert polar coordinates (r, theta) to rectangular (x, y).\"\"\"\n    r_float = float(r)\n    theta_float = float(theta)\n\n    x = r_float * math.cos(theta_float)\n    y = r_float * math.sin(theta_float)\n\n    rect_coord = RectangularCoordinate(x, y)\n\n    return (r_float, theta_float), rect_coord.as_complex()"}
{"task_id": "Mbpp/596", "solution": "import sys\nfrom dataclasses import dataclass\nfrom datetime import datetime\nfrom typing import Optional\n\n@dataclass\nclass SizeResult:\n    \"\"\"Data model for measurement result.\"\"\"\n    bytes: int\n    measured_at: Optional[datetime] = None\n\nclass InputValidator:\n    \"\"\"Input validation utilities.\"\"\"\n    @staticmethod\n    def is_tuple(x: object) -> bool:\n        return isinstance(x, tuple)\n\nclass SystemUtilities:\n    \"\"\"Encapsulate sys.getsizeof for single-point system utility call.\"\"\"\n    @staticmethod\n    def getsizeof(obj: object) -> int:\n        return sys.getsizeof(obj)\n\nclass TupleSizeService:\n    \"\"\"Core domain service implementing tuple_size behavior.\"\"\"\n    def tuple_size(self, t: tuple) -> int:\n        if not InputValidator.is_tuple(t):\n            raise TypeError(\"expected tuple\")\n        bytes_count = SystemUtilities.getsizeof(t)\n        result = SizeResult(bytes=bytes_count, measured_at=datetime.utcnow())\n        return result.bytes\n\ndef _service_factory() -> TupleSizeService:\n    \"\"\"Factory for creating TupleSizeService instances.\"\"\"\n    return TupleSizeService()\n\ndef tuple_size(t: tuple) -> int:\n    \"\"\"\n    Public API: return size in bytes for tuple t.\n\n    Raises:\n        TypeError: if t is not a tuple.\n    \"\"\"\n    service = _service_factory()\n    return service.tuple_size(t)"}
