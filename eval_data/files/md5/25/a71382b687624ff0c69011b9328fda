{"task_id": "Mbpp/223", "solution": "def is_majority(array, n, element):\n    \"\"\"\n    Checks if an element is the majority element in a sorted array.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n\n    def _is_sorted(arr):\n        \"\"\"Checks if the array is sorted in non-decreasing order.\"\"\"\n        for i in range(len(arr) - 1):\n            if arr[i] > arr[i+1]:\n                return False\n        return True\n\n    def _validate_inputs(arr, length):\n        \"\"\"Validates input array length and sortedness.\"\"\"\n        if length != len(arr):\n            return False\n        if not _is_sorted(arr):\n            return False\n        return True\n\n    def _find_first_occurrence(arr, length, target):\n        \"\"\"Finds the first occurrence of target in a sorted array using binary search.\"\"\"\n        low, high = 0, length - 1\n        result = -1\n        while low <= high:\n            mid = low + (high - low) // 2\n            if arr[mid] == target:\n                result = mid\n                high = mid - 1  # Try to find an earlier occurrence in the left half\n            elif arr[mid] < target:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return result\n\n    def _find_last_occurrence(arr, length, target):\n        \"\"\"Finds the last occurrence of target in a sorted array using binary search.\"\"\"\n        low, high = 0, length - 1\n        result = -1\n        while low <= high:\n            mid = low + (high - low) // 2\n            if arr[mid] == target:\n                result = mid\n                low = mid + 1  # Try to find a later occurrence in the right half\n            elif arr[mid] < target:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return result\n\n    if not _validate_inputs(array, n):\n        return False\n\n    first_index = _find_first_occurrence(array, n, element)\n\n    if first_index == -1:\n        return False  # Element not found in the array\n\n    last_index = _find_last_occurrence(array, n, element)\n\n    # Calculate the count of occurrences\n    count = last_index - first_index + 1\n\n    return count > n / 2"}
{"task_id": "Mbpp/230", "solution": "def replace_blank(input_string: str, replacement: str) -> str:\n    \"\"\"Replaces all blank spaces in the input string with the specified replacement character.\n\n    Iterates through the input string, substituting each ASCII space with the given replacement.\n    \"\"\"\n    result_chars = []\n    for char in input_string:\n        if char == ' ':\n            result_chars.append(replacement)\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/227", "solution": "def validate_inputs(a, b, c):\n    \"\"\"Ensures all inputs are numeric (integers or floats).\n    Raises TypeError if any input is not numeric.\n    \"\"\"\n    if not isinstance(a, (int, float)):\n        raise TypeError(\"Argument 'a' must be an integer or a float.\")\n    if not isinstance(b, (int, float)):\n        raise TypeError(\"Argument 'b' must be an integer or a float.\")\n    if not isinstance(c, (int, float)):\n        raise TypeError(\"Argument 'c' must be an integer or a float.\")\n\ndef compute_min(a, b, c):\n    \"\"\"Computes and returns the smallest of the three numeric arguments.\n    This helper assumes inputs are already validated as numbers.\n    \"\"\"\n    return min(a, b, c)\n\ndef min_of_three(a, b, c):\n    \"\"\"Returns the minimum of three numeric values a, b, and c.\n    This function validates inputs and then computes the minimum.\n    \"\"\"\n    validate_inputs(a, b, c)\n    return compute_min(a, b, c)"}
{"task_id": "Mbpp/232", "solution": "import heapq\n\ndef larg_nnum(numbers, n):\n    \"\"\"\n    Accepts:\n      - numbers: list of numeric values\n      - n: integer specifying how many largest items to return\n    Returns:\n      - list containing the n largest items from numbers (order not significant)\n    \"\"\"\n    if n <= 0:\n        return []\n    if n >= len(numbers):\n        return list(numbers)\n    \n    return heapq.nlargest(n, numbers)"}
