{"task_id": "Mbpp/306", "solution": "from typing import List\n\nclass ValidationError(Exception):\n    \"\"\"\n    Exception used to report input validation failures.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef _validate_inputs(arr: List[int], n: int, i: int, k: int) -> None:\n    \"\"\"\n    Enforce input validation checks and raise ValidationError on failure.\n    \"\"\"\n    if not isinstance(arr, list) or not all(isinstance(x, int) for x in arr):\n        raise ValidationError(\"Input 'arr' must be a list of integers.\")\n    if not isinstance(n, int) or not isinstance(i, int) or not isinstance(k, int):\n        raise ValidationError(\"Inputs 'n', 'i', 'k' must be integers.\")\n    if n != len(arr):\n        raise ValidationError(f\"Input 'n' ({n}) must be equal to the length of 'arr' ({len(arr)}).\")\n    if not (0 <= i < n):\n        raise ValidationError(f\"Input 'i' ({i}) must be a valid index within 'arr' (0 to {n-1}).\")\n    if not (0 <= k < n):\n        raise ValidationError(f\"Input 'k' ({k}) must be a valid index within 'arr' (0 to {n-1}).\")\n    if k <= i:\n        raise ValidationError(f\"Input 'k' ({k}) must be strictly greater than 'i' ({i}).\")\n\ndef _compute_prefix_max_sums(arr: List[int], i: int) -> List[int]:\n    \"\"\"\n    Computes for each prefix index j in 0..i the maximum sum of a strictly increasing subsequence\n    that ends at index j (considering only indices <= i).\n    \"\"\"\n    dp = [arr[x] for x in range(i + 1)]\n\n    for j in range(1, i + 1):\n        for prev_j in range(j):\n            if arr[j] > arr[prev_j]:\n                dp[j] = max(dp[j], dp[prev_j] + arr[j])\n    return dp\n\ndef _combine_with_k(prefix_max_sums: List[int], arr: List[int], k: int) -> int:\n    \"\"\"\n    For arr[k], find the best prefix j in 0..i such that arr[j] < arr[k] and maximize\n    prefix_max_sums[j] + arr[k]; allow arr[k] alone.\n    \"\"\"\n    max_combined_sum = arr[k]\n\n    for j in range(len(prefix_max_sums)):\n        if arr[j] < arr[k]:\n            max_combined_sum = max(max_combined_sum, prefix_max_sums[j] + arr[k])\n    return max_combined_sum\n\ndef max_sum_increasing_subseq(arr: List[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from prefix until ith index\n    and also including a given kth element which is after i (k > i).\n    \"\"\"\n    _validate_inputs(arr, n, i, k)\n\n    prefix_max_sums = _compute_prefix_max_sums(arr, i)\n\n    max_sum = _combine_with_k(prefix_max_sums, arr, k)\n\n    return max_sum"}
