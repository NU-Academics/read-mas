{"task_id": "Mbpp/398", "solution": "from typing import List\n\nclass Digit:\n    \"\"\"Value object for a single decimal digit (0..9).\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass IntegerNumber:\n    \"\"\"Represents a single integer; provides digits() and sumDigits().\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def digits(self) -> List[int]:\n        \"\"\"Decompose abs(self.value) into decimal digits (0..9) in most-significant-first order.\"\"\"\n        abs_value = abs(self.value)\n        if abs_value == 0:\n            return [0]\n        return [int(d) for d in str(abs_value)]\n\n    def sumDigits(self) -> int:\n        \"\"\"Returns the sum of its decimal digits.\"\"\"\n        return sum(self.digits())\n\nclass IntegerList:\n    \"\"\"Encapsulates an ordered collection of integers.\"\"\"\n    def __init__(self, numbers: List[int]) -> None:\n        self.numbers: List[IntegerNumber] = [IntegerNumber(num) for num in numbers]\n\nclass SumResult:\n    \"\"\"Holds aggregated total.\"\"\"\n    def __init__(self, total: int) -> None:\n        self.total = total\n\nclass SumOfDigitsFunction:\n    \"\"\"Orchestrates per-number digit decomposition and accumulation.\"\"\"\n    def execute(self, inputList: IntegerList) -> int:\n        \"\"\"Processes the list of numbers and returns the total sum of their digits.\"\"\"\n        total_sum = 0\n        for integer_number in inputList.numbers:\n            total_sum += integer_number.sumDigits()\n        return total_sum\n\ndef sum_of_digits(input_list: List[int]) -> int:\n    \"\"\"\n    Computes the sum of digits of each number in a list and returns their aggregate sum.\n    For negative numbers, the absolute value is used for digit sum.\n    \"\"\"\n    integer_list = IntegerList(input_list)\n    sum_function = SumOfDigitsFunction()\n    return sum_function.execute(integer_list)"}
{"task_id": "Mbpp/406", "solution": "class Number:\n    def __init__(self, value: int):\n        self.value = value\n    def isEven(self) -> bool:\n        return self.value % 2 == 0\n    def isOdd(self) -> bool:\n        return self.value % 2 != 0\n\nclass ParityChecker:\n    @staticmethod\n    def find_Parity(number: int) -> bool:\n        return Number(number).isOdd()\n\ndef find_Parity(number: int) -> bool:\n    \"\"\"Return True if `number` is odd, False if even. Caller must provide an int.\"\"\"\n    return ParityChecker.find_Parity(number)"}
{"task_id": "Mbpp/409", "solution": "def min_product_tuple(tuple_list) -> int:\n    \"\"\"\n    Finds the minimum product from pairs of numbers within a list of tuples.\n    Assumes valid input per constraints: non-empty list of 2-element numeric tuples.\n    \"\"\"\n    class TuplePair:\n        \"\"\"Helper class to store a pair of numbers and calculate their product.\"\"\"\n        def __init__(self, a, b):\n            self.a = a\n            self.b = b\n\n        def product(self):\n            \"\"\"Returns the product of the two stored numbers.\"\"\"\n            return self.a * self.b\n\n    products = []\n    for item in tuple_list:\n        a, b = item\n        pair = TuplePair(a, b)\n        products.append(pair.product())\n\n    min_value = min(products)\n    return int(min_value)"}
{"task_id": "Mbpp/410", "solution": "def min_val(list):\n    \"\"\"\n    Finds the minimum numeric value (int or float) in a given heterogeneous list.\n    Raises TypeError if input is not a list, or ValueError if no numeric elements are found.\n    \"\"\"\n    if not isinstance(list, list):\n        raise TypeError(\"min_val expects a list\")\n\n    numeric_elements = []\n    for item in list:\n        if isinstance(item, (int, float)):\n            numeric_elements.append(item)\n\n    if not numeric_elements:\n        raise ValueError(\"no numeric elements in input list\")\n\n    return min(numeric_elements)"}
