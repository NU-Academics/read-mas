{"task_id": "Mbpp/462", "solution": "class Combination:\n    \"\"\"\n    Domain container for elements (ordered) and mask integer.\n    \"\"\"\n    def __init__(self, elements, mask):\n        self.elements = elements\n        self.mask = mask\n\n    def to_list(self):\n        \"\"\"\n        Converts the combination's elements to a plain list.\n        \"\"\"\n        return self.elements\n\n\nclass CombinationGenerator:\n    \"\"\"\n    Generates Combination instances for masks 0..2^n-1 with elements ordered descending by index.\n    \"\"\"\n    def generate(self, input_list):\n        n = len(input_list)\n        num_combinations = 1 << n # Calculate 2^n\n        \n        result_combinations = []\n\n        # Iterate through all possible masks from 0 to 2^n - 1\n        for mask in range(num_combinations):\n            current_combination_elements = []\n            # Collect elements that correspond to set bits in the mask.\n            # Iterate indices in reverse order to ensure descending original index order within the combination.\n            for i in range(n - 1, -1, -1): \n                if (mask >> i) & 1: # Check if the i-th bit is set\n                    current_combination_elements.append(input_list[i])\n            \n            result_combinations.append(Combination(current_combination_elements, mask))\n        \n        return result_combinations\n\n\nclass CombinationsService:\n    \"\"\"\n    Orchestrates validation and generation; converts domain Combination objects into list-of-lists.\n    \"\"\"\n    def combinations_list(self, input_list):\n        # Minimal validation: The design notes indicate minimal validation,\n        # but specific rules are not detailed in the SRS, so it's omitted here.\n        \n        generator = CombinationGenerator()\n        # Generate raw Combination objects\n        combinations = generator.generate(input_list)\n        \n        # Convert Combination objects to plain lists for the final result\n        return [c.to_list() for c in combinations]\n\n\ndef combinations_list(inputList):\n    \"\"\"\n    Generates all possible combinations (power set) of the elements in the input list.\n    The result is ordered by increasing binary mask values, and elements within each combination\n    are ordered by descending original input index.\n    \"\"\"\n    service = CombinationsService()\n    return service.combinations_list(inputList)"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Computes the pairwise addition of neighboring elements in the given tuple.\n    Returns a new tuple containing these sums.\n    \"\"\"\n    sums = []\n    for i in range(len(input_tuple) - 1):\n        sums.append(input_tuple[i] + input_tuple[i+1])\n    return tuple(sums)"}
{"task_id": "Mbpp/468", "solution": "from typing import List, Iterator, Union, Optional\n\nNumber = Union[int, float]\n\nclass InputArray:\n    \"\"\"\n    Represents the input array of numbers.\n    \"\"\"\n    def __init__(self, numbers: List[Number]) -> None:\n        self.numbers = numbers\n\n    def length(self) -> int:\n        \"\"\"\n        Returns the length of the input array.\n        \"\"\"\n        return len(self.numbers)\n\nclass Subsequence:\n    \"\"\"\n    Represents a contiguous subsequence of the input array.\n    \"\"\"\n    def __init__(self, start_index: int, end_index: int, elements: List[Number]) -> None:\n        self.start_index = start_index\n        self.end_index = end_index\n        self.elements = elements\n\n    def isStrictlyIncreasing(self) -> bool:\n        \"\"\"\n        Checks if the subsequence elements are strictly increasing.\n        A single-element subsequence is considered strictly increasing.\n        \"\"\"\n        if len(self.elements) <= 1:\n            return True\n        for i in range(1, len(self.elements)):\n            if self.elements[i] <= self.elements[i-1]:\n                return False\n        return True\n\n    def product(self) -> Number:\n        \"\"\"\n        Computes the product of the subsequence elements.\n        \"\"\"\n        if not self.elements:\n            return 1 # Multiplicative identity\n        prod: Number = 1\n        for element in self.elements:\n            prod *= element\n        return prod\n\nclass MaxProductResult:\n    \"\"\"\n    Holds the maximum product found and the corresponding subsequence.\n    \"\"\"\n    def __init__(self, value: Number, subsequence: Optional[Subsequence]) -> None:\n        self.value = value\n        self.subsequence = subsequence\n\ndef _enumerate_contiguous_subsequences(numbers: List[Number]) -> Iterator[Subsequence]:\n    \"\"\"\n    Enumerates all possible contiguous subsequences from a list of numbers.\n    \"\"\"\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i, n):\n            yield Subsequence(i, j, numbers[i : j + 1])\n\ndef max_product(array: List[Number]) -> Number:\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence.\n    \"\"\"\n    max_prod: Number = float('-inf')\n\n    for subsequence in _enumerate_contiguous_subsequences(array):\n        if subsequence.isStrictlyIncreasing():\n            current_prod = subsequence.product()\n            if current_prod > max_prod:\n                max_prod = current_prod\n    \n    return max_prod"}
{"task_id": "Mbpp/463", "solution": "from typing import List\n\ndef max_subarray_product(arr: List[int]) -> int:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray within the given list of integers.\n    The input `arr` is assumed to be a non-empty list of integers.\n    \"\"\"\n    current_max = arr[0]\n    current_min = arr[0]\n    max_product = arr[0]\n\n    for x in arr[1:]:\n        if x < 0:\n            current_max, current_min = current_min, current_max\n        \n        current_max = max(x, current_max * x)\n        current_min = min(x, current_min * x)\n        \n        max_product = max(max_product, current_max)\n        \n    return max_product"}
{"task_id": "Mbpp/471", "solution": "from typing import List\n\ndef find_remainder(arr: List[int], n: int) -> int:\n    \"\"\"Compute product(arr) modulo n, returning r such that 0 <= r < n.\n    Raises ValueError if n <= 0, and has O(k) time and O(1) space complexity.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"modulus n must be > 0\")\n\n    result = 1\n    for element in arr:\n        if element == 0:\n            return 0\n        result = (result * (element % n)) % n\n    return result"}
{"task_id": "Mbpp/472", "solution": "class InputList:\n    \"\"\"Lightweight container for the input list.\"\"\"\n    def __init__(self, elements: list[int]):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the contained list.\"\"\"\n        return len(self.elements)\n\nclass Result:\n    \"\"\"Container for the boolean check result.\"\"\"\n    def __init__(self, is_consecutive: bool):\n        self.is_consecutive = is_consecutive\n\nclass Validator:\n    \"\"\"Validates that the input is a list and all elements are integers.\"\"\"\n    def validate_elements_are_integers(self, lst: list) -> bool:\n        \"\"\"\n        Returns True if lst is a list and every element is an int; False otherwise.\n        Checks the type of the list itself and its elements.\n        \"\"\"\n        if not isinstance(lst, list):\n            return False\n        for item in lst:\n            if not isinstance(item, int):\n                return False\n        return True\n\ndef check_Consecutive(lst: list[int]) -> bool:\n    \"\"\"\n    Checks if the given list contains consecutive numbers with a step of +1.\n    Raises TypeError if the input list contains non-integer elements or is not a list.\n    \"\"\"\n    validator = Validator()\n    if not validator.validate_elements_are_integers(lst):\n        raise TypeError(\"Input must be a list containing only integers.\")\n\n    # Empty or single-element lists are considered consecutive per design.\n    if len(lst) <= 1:\n        return True\n\n    # Iterate through adjacent pairs to check for consecutive order.\n    for i in range(len(lst) - 1):\n        if lst[i+1] != lst[i] + 1:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/473", "solution": "from typing import Iterable, Set\n\nclass Tuple:\n    \"\"\"Represents an input tuple and provides canonicalization.\"\"\"\n    def __init__(self, elements: tuple) -> None:\n        self.elements = elements\n\n    def normalize(self) -> 'Tuple':\n        \"\"\"Returns a new Tuple instance with elements sorted in ascending order.\"\"\"\n        sorted_elements = tuple(sorted(self.elements))\n        return Tuple(sorted_elements)\n\n    def to_builtin(self) -> tuple:\n        \"\"\"Returns the internal elements as a built-in tuple.\"\"\"\n        return self.elements\n\nclass TupleCollection:\n    \"\"\"Adapts an input iterable into a list of Tuple objects and provides a normalized set.\"\"\"\n    def __init__(self, source: Iterable[tuple]) -> None:\n        self.tuples = [Tuple(t) for t in source]\n\n    def to_normalized_set(self) -> Set[tuple]:\n        \"\"\"Returns a set of built-in canonical tuples from the collection.\"\"\"\n        return {t.normalize().to_builtin() for t in self.tuples}\n\nclass ResultSet:\n    \"\"\"A simple container for a set of canonical tuples.\"\"\"\n    def __init__(self, tuples: Set[tuple]) -> None:\n        self.tuples = tuples\n\n    def to_builtin_set(self) -> Set[tuple]:\n        \"\"\"Returns the contained set of built-in tuples.\"\"\"\n        return self.tuples\n\nclass TupleIntersectionService:\n    \"\"\"Computes the intersection of two iterables of tuples with order-insensitive matching.\"\"\"\n    def tuple_intersection(self, a: Iterable[tuple], b: Iterable[tuple]) -> Set[tuple]:\n        \"\"\"Calculates the intersection of two tuple collections.\"\"\"\n        collection_a = TupleCollection(a)\n        collection_b = TupleCollection(b)\n\n        normalized_set_a = collection_a.to_normalized_set()\n        normalized_set_b = collection_b.to_normalized_set()\n\n        intersection = normalized_set_a.intersection(normalized_set_b)\n        result_set = ResultSet(intersection)\n        return result_set.to_builtin_set()\n\ndef tuple_intersection(a: Iterable[tuple], b: Iterable[tuple]) -> Set[tuple]:\n    \"\"\"\n    Finds the tuple intersection of elements in the given tuple list irrespective of their order.\n    Returns a set of canonical (ascending-ordered) tuples.\n    \"\"\"\n    service = TupleIntersectionService()\n    return service.tuple_intersection(a, b)"}
{"task_id": "Mbpp/474", "solution": "def replace_char(input_string, target_char, replacement_char):\n    \"\"\"\n    Replace every occurrence of target_char in input_string with replacement_char.\n    \"\"\"\n    result_chars = []\n    for char in input_string:\n        if char == target_char:\n            result_chars.append(replacement_char)\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
