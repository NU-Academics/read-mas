{"task_id": "Mbpp/286", "solution": "class Error(Exception):\n    \"\"\"Custom exception class for validation errors.\"\"\"\n    def __init__(self, message: str, code: int = 1) -> None:\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\nclass ValidationResult:\n    \"\"\"Encapsulates the outcome of an input validation.\"\"\"\n    def __init__(self, is_valid: bool, message: str = \"\", error: 'Error' | None = None) -> None:\n        self.is_valid = is_valid\n        self.message = message\n        self.error = error\n\nclass Validator:\n    \"\"\"Handles input validation based on specified rules.\"\"\"\n    @staticmethod\n    def validateNotEmpty(arr: list[int]) -> bool:\n        \"\"\"Checks if the array is non-empty.\"\"\"\n        return bool(arr)\n\n    @staticmethod\n    def validateNEqualsLen(arr: list[int], n: int) -> bool:\n        \"\"\"Checks if n matches the length of the array.\"\"\"\n        return len(arr) == n\n\n    @staticmethod\n    def validateK(k: int) -> bool:\n        \"\"\"Checks if k is an integer greater than or equal to 1.\"\"\"\n        return isinstance(k, int) and k >= 1\n\n    @staticmethod\n    def validateElementsAreIntegers(arr: list[int]) -> bool:\n        \"\"\"Checks if all elements in the array are integers.\"\"\"\n        return all(isinstance(x, int) for x in arr)\n\n    @staticmethod\n    def build_validation_result(arr: list[int], n: int, k: int) -> ValidationResult:\n        \"\"\"Builds a ValidationResult by running all checks.\"\"\"\n        if not Validator.validateNotEmpty(arr):\n            return ValidationResult(False, \"arr must be non-empty\", Error(\"arr must be non-empty\"))\n        if not Validator.validateNEqualsLen(arr, n):\n            return ValidationResult(False, f\"n ({n}) does not match length of arr ({len(arr)})\", Error(f\"n ({n}) does not match length of arr ({len(arr)})\"))\n        if not Validator.validateK(k):\n            return ValidationResult(False, \"k must be an integer >= 1\", Error(\"k must be an integer >= 1\"))\n        if not Validator.validateElementsAreIntegers(arr):\n            return ValidationResult(False, \"all array elements must be integers\", Error(\"all array elements must be integers\"))\n        return ValidationResult(True)\n\nclass Calculator:\n    \"\"\"Performs the core computation for maximum subarray sum.\"\"\"\n    @staticmethod\n    def totalSum(arr: list[int]) -> int:\n        \"\"\"Calculates the total sum of elements in the array.\"\"\"\n        return sum(arr)\n\n    @staticmethod\n    def kadane(arr: list[int]) -> int:\n        \"\"\"Applies Kadane's algorithm to find the maximum contiguous subarray sum in a single array.\"\"\"\n        if not arr: return 0 # This case should be handled by validation.\n        \n        max_so_far = arr[0]\n        current_max = arr[0]\n\n        for i in range(1, len(arr)):\n            current_max = max(arr[i], current_max + arr[i])\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    @staticmethod\n    def kadaneOnTwoConcats(arr: list[int]) -> int:\n        \"\"\"Finds the maximum subarray sum within a conceptual double concatenation of the array using O(1) space.\"\"\"\n        n = len(arr)\n        if n == 0: return 0 # This case should be handled by validation.\n        \n        max_so_far = arr[0]\n        current_max = arr[0]\n        \n        for i in range(1, 2 * n):\n            element = arr[i % n]\n            current_max = max(element, current_max + element)\n            max_so_far = max(max_so_far, current_max)\n            \n        return max_so_far\n\n    @staticmethod\n    def computeMaxSubarrayRepeated(arr: list[int], n: int, k: int) -> int:\n        \"\"\"Computes the maximum subarray sum for the array repeated k times.\"\"\"\n        sum_all = Calculator.totalSum(arr)\n        max_single = Calculator.kadane(arr)\n        \n        if k == 1:\n            return max_single\n        \n        max_two = Calculator.kadaneOnTwoConcats(arr)\n        \n        if sum_all > 0:\n            # If total sum is positive, extend max_two by adding (k-2) full array sums.\n            return max_two + (k - 2) * sum_all\n        else:\n            # If total sum is non-positive, the max sum is found within up to two concatenations.\n            return max_two\n\ndef max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous array in the modified array which is formed by repeating the given array k times.\n    \"\"\"\n    vr = Validator.build_validation_result(arr, n, k)\n    if not vr.is_valid:\n        raise vr.error\n    \n    result_value = Calculator.computeMaxSubarrayRepeated(arr, n, k)\n    return result_value"}
{"task_id": "Mbpp/290", "solution": "from typing import List, Tuple\n\ndef max_length(input: List[List]) -> Tuple[int, List]:\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns a tuple (max_length, sublist) with the length and the first encountered longest sublist.\n    \"\"\"\n    longest_sublist = max(input, key=len)\n    max_len = len(longest_sublist)\n    return (max_len, longest_sublist)"}
{"task_id": "Mbpp/293", "solution": "import math\nfrom typing import Any\n\nclass InputValidator:\n    \"\"\"Validates input values for type and non-negativity.\"\"\"\n    def validateNumeric(self, value: Any) -> None:\n        if not isinstance(value, (int, float)):\n            raise TypeError(f\"Input must be numeric (int or float), but got {type(value).__name__}.\")\n\n    def validateNonNegative(self, value: Any) -> None:\n        if value < 0:\n            raise ValueError(f\"Input must be non-negative, but got {value}.\")\n\nclass OthersideRightangleFunction:\n    \"\"\"Performs the hypotenuse calculation and orchestrates validation.\"\"\"\n    def __init__(self, validator: 'InputValidator'):\n        self._validator = validator\n\n    def _computeHypotenuse(self, a: float, b: float) -> float:\n        \"\"\"Computes the hypotenuse using the Pythagorean theorem.\"\"\"\n        return math.sqrt(a*a + b*b)\n\n    def otherside_rightangle(self, a: Any, b: Any) -> float:\n        \"\"\"Orchestrates validation and computes the hypotenuse.\"\"\"\n        self._validator.validateNumeric(a)\n        self._validator.validateNonNegative(a)\n        self._validator.validateNumeric(b)\n        self._validator.validateNonNegative(b)\n        return self._computeHypotenuse(float(a), float(b))\n\nclass RightAngledTriangle:\n    \"\"\"Represents a right-angled triangle with its side lengths.\"\"\"\n    def __init__(self, sideA: float, sideB: float, hypotenuse: float) -> None:\n        self.sideA = sideA\n        self.sideB = sideB\n        self.hypotenuse = hypotenuse\n\nclass Side:\n    \"\"\"Represents a side of a triangle with its length.\"\"\"\n    def __init__(self, length: float) -> None:\n        self.length = length\n\nclass Result:\n    \"\"\"Encapsulates the computed result value and its precision.\"\"\"\n    def __init__(self, value: float, precision: str) -> None:\n        self.value = value\n        self.precision = precision\n\ndef otherside_rightangle(a, b):\n    \"\"\"Validate inputs and return the hypotenuse as a float (double precision).\n    Raises TypeError for non-numeric inputs and ValueError for negative inputs.\n    \"\"\"\n    validator = InputValidator()\n    calculator = OthersideRightangleFunction(validator)\n    hypotenuse = calculator.otherside_rightangle(a, b)\n    _result_obj = Result(value=hypotenuse, precision='double')\n    return hypotenuse"}
{"task_id": "Mbpp/294", "solution": "def _is_numeric(obj):\n    \"\"\"\n    Return True if obj is a numeric candidate (int or float), excluding bool.\n    \"\"\"\n    return isinstance(obj, (int, float)) and not isinstance(obj, bool)\n\ndef _filter_numeric(input_list):\n    \"\"\"\n    Return a list of numeric elements extracted from input_list in iteration order.\n    \"\"\"\n    numeric_elements = []\n    for item in input_list:\n        if _is_numeric(item):\n            numeric_elements.append(item)\n    return numeric_elements\n\ndef max_val(input_list):\n    \"\"\"\n    Find the maximum numeric value in a given heterogeneous list.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    numeric_list = _filter_numeric(input_list)\n\n    if not numeric_list:\n        raise ValueError(\"no numeric values in input\")\n\n    return max(numeric_list)"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(input_list):\n    \"\"\"Flattens a given nested list structure into a single list, preserving element order.\"\"\"\n    flat_list = []\n    for item in input_list:\n        if isinstance(item, list):\n            flat_list.extend(flatten_list(item))\n        else:\n            flat_list.append(item)\n    return flat_list"}
{"task_id": "Mbpp/296", "solution": "from typing import List, Tuple, Any\n\nclass InversionCounter:\n    \"\"\"\n    Encapsulates the merge sort algorithm for counting inversions.\n    \"\"\"\n\n    def __init__(self, array: List[Any]):\n        self._array = array\n\n    def get_Inv_Count(self) -> int:\n        \"\"\"\n        Initiates the inversion counting process using merge sort.\n        \"\"\"\n        _, count = self._count_with_merge_sort(self._array)\n        return count\n\n    def _count_with_merge_sort(self, arr: List[Any]) -> Tuple[List[Any], int]:\n        \"\"\"\n        Recursively sorts the array and counts inversions during merging.\n        Returns a tuple of (sorted_array, inversion_count).\n        \"\"\"\n        if len(arr) <= 1:\n            return arr, 0\n\n        mid = len(arr) // 2\n        left_half = arr[:mid]\n        right_half = arr[mid:]\n\n        sorted_left, left_inversions = self._count_with_merge_sort(left_half)\n        sorted_right, right_inversions = self._count_with_merge_sort(right_half)\n\n        merged_array, merge_inversions = self._merge_and_count(sorted_left, sorted_right)\n\n        total_inversions = left_inversions + right_inversions + merge_inversions\n        return merged_array, total_inversions\n\n    def _merge_and_count(self, left_arr: List[Any], right_arr: List[Any]) -> Tuple[List[Any], int]:\n        \"\"\"\n        Merges two sorted arrays while counting inversions.\n        \"\"\"\n        merged = []\n        inversions = 0\n        i = 0  # Pointer for left_arr\n        j = 0  # Pointer for right_arr\n\n        while i < len(left_arr) and j < len(right_arr):\n            if left_arr[i] <= right_arr[j]:\n                merged.append(left_arr[i])\n                i += 1\n            else:\n                merged.append(right_arr[j])\n                # All remaining elements in left_arr (from i to end) are greater than right_arr[j].\n                inversions += len(left_arr) - i\n                j += 1\n\n        # Append any remaining elements\n        merged.extend(left_arr[i:])\n        merged.extend(right_arr[j:])\n\n        return merged, inversions\n\ndef get_Inv_Count(array) -> int:\n    \"\"\"\n    Counts inversions in an array using a modified merge sort algorithm.\n    An inversion is a pair of indices (i, j) such that i < j and array[i] > array[j].\n    \"\"\"\n    arr_list: List[Any] = list(array) # TypeError will propagate here for non-iterables\n\n    if not arr_list:\n        return 0\n\n    counter = InversionCounter(arr_list)\n    return counter.get_Inv_Count()"}
{"task_id": "Mbpp/299", "solution": "from collections import defaultdict\nfrom typing import List, Tuple, Union\n\ndef max_aggregate(entries: List[Tuple[str, Union[int, float]]]) -> Tuple[str, float]:\n    \"\"\"\n    Calculates the maximum aggregate sum for names from a list of (name, value) tuples.\n    Returns the name and its total sum for the highest aggregate.\n    \"\"\"\n    if not entries:\n        raise ValueError(\"empty input\")\n\n    aggregate_map = defaultdict(float)\n    for name, value in entries:\n        aggregate_map[name] += float(value)\n\n    # Initialize with the first entry from the aggregated map to ensure correct tie-breaking\n    # and handling of potentially all-negative sums.\n    max_name, max_total = next(iter(aggregate_map.items()))\n\n    for name, total in aggregate_map.items():\n        if total > max_total:\n            max_total = total\n            max_name = name\n            \n    return (max_name, max_total)"}
{"task_id": "Mbpp/301", "solution": "from typing import Dict, Any, Iterable\nfrom dataclasses import dataclass\n\n@dataclass\nclass Result:\n    \"\"\"Container for the computed depth.\"\"\"\n    depth: int\n\nclass DepthCalculator:\n    \"\"\"Calculates the maximum nesting depth of dictionaries recursively.\"\"\"\n\n    @staticmethod\n    def _is_dict(obj: object) -> bool:\n        \"\"\"Checks if an object is a dictionary.\"\"\"\n        return isinstance(obj, dict)\n\n    @staticmethod\n    def _child_depths(d: Dict[Any, Any]) -> Iterable[int]:\n        \"\"\"Yields the depths of dictionary-valued children.\"\"\"\n        for value in d.values():\n            if DepthCalculator._is_dict(value):\n                yield DepthCalculator.dict_depth(value).depth\n\n    @staticmethod\n    def dict_depth(d: Dict[Any, Any]) -> Result:\n        \"\"\"\n        Recursively computes the depth of a dictionary.\n        Returns a Result object containing the depth.\n        \"\"\"\n        child_depths = list(DepthCalculator._child_depths(d))\n        if child_depths:\n            max_child_depth = max(child_depths)\n            return Result(1 + max_child_depth)\n        else:\n            return Result(1)\n\ndef dict_depth(d: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of dictionaries in the input.\n    \"\"\"\n    return DepthCalculator.dict_depth(d).depth"}
{"task_id": "Mbpp/300", "solution": "def _central_binomial_coefficient(n):\n    \"\"\"Computes the central binomial coefficient C(2n, n) using an efficient multiplicative method.\"\"\"\n    result = 1\n    for k in range(1, n + 1):\n        result = result * (n + k) // k\n    return result\n\ndef count_binary_seq(n):\n    \"\"\"\n    Finds the count of binary sequences of length 2n where the sum of the first n bits\n    is equal to the sum of the last n bits. This count is given by the central binomial coefficient C(2n, n).\n    \"\"\"\n    return _central_binomial_coefficient(n)"}
{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple\n\ndef start_withp(input_list: List[str]) -> Tuple[str, str]:\n    \"\"\"Accepts a list of strings and returns a tuple of two words that start with 'p' or 'P'.\n    If fewer than two matching words are found, raise ValueError.\n    \"\"\"\n    found_words = []\n    for s in input_list:\n        words = s.split()\n        for word in words:\n            if word and word[0].lower() == 'p':\n                found_words.append(word)\n                if len(found_words) == 2:\n                    return (found_words[0], found_words[1])\n    \n    raise ValueError(\"fewer than two words starting with 'p' were found\")"}
