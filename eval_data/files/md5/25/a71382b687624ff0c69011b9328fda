{"task_id": "Mbpp/790", "solution": "def even_position(input_list):\n    \"\"\"\n    Checks if every element at an even index in the list is an even number.\n    Returns True for empty lists or if all checks pass, False otherwise.\n    \"\"\"\n\n    def validate(input_list):\n        \"\"\"Validates that the input is a list of integers.\"\"\"\n        if not isinstance(input_list, list):\n            raise TypeError(\"Input must be a list.\")\n        for item in input_list:\n            if not isinstance(item, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n\n    def check_even_indices(input_list):\n        \"\"\"Checks if elements at even indices are even numbers.\"\"\"\n        for i in range(0, len(input_list), 2):\n            if input_list[i] % 2 != 0:\n                return False\n        return True\n\n    validate(input_list)\n    return check_even_indices(input_list)"}
{"task_id": "Mbpp/791", "solution": "def remove_nested(input_tuple: tuple) -> tuple:\n    \"\"\"Removes nested tuples from the input tuple, preserving order of non-tuple elements.\n    Raises TypeError if the input is not a tuple.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    filtered_elements = [element for element in input_tuple if not isinstance(element, tuple)]\n    return tuple(filtered_elements)"}
{"task_id": "Mbpp/792", "solution": "def count_list(input_list):\n    \"\"\"Return an int equal to the number of top-level elements of input_list that are instances of list.\n    Preconditions: input_list is expected to be a Python list (SRS FR2/BR2).\n    \"\"\"\n    count = 0\n    for item in input_list:\n        if isinstance(item, list):\n            count += 1\n    return count"}
{"task_id": "Mbpp/793", "solution": "\"\"\"\nsrc.last: Provides last(arr, target) implementation per SRS.\n\nPreconditions: arr must be a sorted Sequence and contain target if caller expects an int result. Behavior when target is absent is unspecified in the SRS.\n\"\"\"\nfrom typing import Sequence, TypeVar\n\nT = TypeVar('T')\n\ndef _rightmost_binary_search(arr: Sequence[T], target: T) -> int:\n    \"\"\"Private: perform a binary search variant to find the rightmost index of target in arr.\n\n    Preconditions: arr is sorted and contains target. Returns the int index when found.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    result = -1  # Initialize to -1, will be updated to a valid index if target is found.\n\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] <= target:\n            if arr[mid] == target:\n                result = mid  # Found a potential last occurrence\n            low = mid + 1  # Try to find an even further right occurrence\n        else:\n            high = mid - 1\n    return result\n\ndef last(arr: Sequence[T], target: T) -> int:\n    \"\"\"Return the zero-based index of the rightmost occurrence of target in arr.\n\n    Preconditions: arr is sorted and contains target (SRS precondition). If the caller supplies an array where target is not present, behavior is unspecified by the SRS.\n    \"\"\"\n    index = _rightmost_binary_search(arr, target)\n    return index"}
