{"task_id": "Mbpp/799", "solution": "def left_rotate(value, d):\n    # Mask the input value to ensure it's treated as a 32-bit unsigned integer.\n    masked_value = value & 0xFFFFFFFF\n    # Normalize the rotation amount to be within 0-31 bits.\n    normalized_d = d % 32\n\n    # Perform the circular left rotation operation.\n    # Bits shifted out from the left are re-introduced on the right.\n    rotated = (masked_value << normalized_d) | (masked_value >> (32 - normalized_d))\n\n    # Mask the final result to guarantee it fits within 32 bits.\n    return rotated & 0xFFFFFFFF"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a, b, c) -> int:\n    \"\"\"Count the number of equal values among three integers. Returns 0, 2, or 3.\"\"\"\n    if a == b and b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/804", "solution": "from typing import List\n\nclass Number:\n    \"\"\"Encapsulates an integer value and provides a parity check.\"\"\"\n    def __init__(self, value: int) -> None:\n        self._value = value\n\n    def is_even(self) -> bool:\n        \"\"\"Checks if the encapsulated number is even.\"\"\"\n        return self._value % 2 == 0\n\nclass Result:\n    \"\"\"Simple data holder for a boolean outcome.\"\"\"\n    def __init__(self, value: bool) -> None:\n        self.value = value\n\nclass NumberList:\n    \"\"\"Holds a sequence of integers and determines if their product is even.\"\"\"\n    def __init__(self, numbers: List[int]) -> None:\n        self._numbers = numbers\n\n    def is_product_even(self) -> Result:\n        \"\"\"Determines if the product of numbers in the list is even using short-circuit evaluation.\"\"\"\n        for num_value in self._numbers:\n            number_obj = Number(num_value)\n            if number_obj.is_even():\n                return Result(True)\n        return Result(False)\n\ndef is_product_even(list_of_numbers: List[int]) -> bool:\n    \"\"\"\n    Checks whether the product of numbers in a list is even.\n    The product is even if at least one number in the list is even.\n    \"\"\"\n    number_list_obj = NumberList(list_of_numbers)\n    result_obj = number_list_obj.is_product_even()\n    return result_obj.value"}
{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(n: int) -> bool:\n    \"\"\"\n    Checks if the given number is a perfect square.\n    Returns False if n is negative.\n    \"\"\"\n    if n < 0:\n        return False\n\n    # Compute the integer square root (floor)\n    root = math.isqrt(n)\n    \n    # A number is a perfect square if the square of its integer square root equals the number itself.\n    return root * root == n"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(list_of_lists):\n    \"\"\"\n    Returns the inner list from a list of lists whose sum of elements is the highest.\n    If the input list is empty, returns None. Handles stable tie-breaking by returning the first encountered maximum.\n    \"\"\"\n    if not list_of_lists:\n        return None\n\n    max_list = None\n    max_sum = float('-inf') # Initialize with negative infinity to correctly handle lists with negative sums\n\n    for current_list in list_of_lists:\n        current_sum = sum(current_list)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            max_list = current_list\n            \n    return max_list"}
