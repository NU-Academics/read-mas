{"task_id": "Mbpp/476", "solution": "def validate_input(list):\n    \"\"\"\n    Validates if the input is a non-empty list.\n    Raises ValueError for invalid inputs.\n    \"\"\"\n    if not isinstance(list, list):\n        raise ValueError(\"big_sum requires a list of one or more numeric elements\")\n    if len(list) == 0:\n        raise ValueError(\"big_sum requires a non-empty list\")\n\ndef compute_min(list):\n    \"\"\"\n    Returns the smallest numeric element from the list.\n    \"\"\"\n    return min(list)\n\ndef compute_max(list):\n    \"\"\"\n    Returns the largest numeric element from the list.\n    \"\"\"\n    return max(list)\n\ndef big_sum(list):\n    \"\"\"\n    Finds the sum of the largest and smallest value in a given array.\n    \"\"\"\n    validate_input(list)\n    min_v = compute_min(list)\n    max_v = compute_max(list)\n    return min_v + max_v"}
{"task_id": "Mbpp/478", "solution": "def _is_lowercase_ascii(ch: str) -> bool:\n    \"\"\"Returns True if the character is a single lowercase ASCII letter ('a' through 'z').\"\"\"\n    return 'a' <= ch <= 'z'\n\ndef remove_lowercase(input: str) -> str:\n    \"\"\"Removes all maximal contiguous runs of lowercase ASCII letters from the input string.\"\"\"\n    result_chars = []\n    i = 0\n    while i < len(input):\n        if _is_lowercase_ascii(input[i]):\n            # If current character is lowercase, skip all consecutive lowercase characters.\n            while i < len(input) and _is_lowercase_ascii(input[i]):\n                i += 1\n        else:\n            # If current character is not lowercase, append it to the result and move to the next.\n            result_chars.append(input[i])\n            i += 1\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/554", "solution": "def Split(input) -> list:\n    \"\"\"Return a Python list containing only odd integers from `input` preserving order.\n    Preconditions (per SRS): input is a list of integers.\n    \"\"\"\n    result = []\n    for v in input:\n        if v % 2 != 0:\n            result.append(v)\n    return result"}
{"task_id": "Mbpp/479", "solution": "class InputValidator:\n    \"\"\"Helper class to validate input for the first_Digit function.\"\"\"\n    def validate(self, n):\n        \"\"\"Validates if n is a non-negative integer, raising ValueError if not.\"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"Input must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input must be a non-negative number.\")\n\ndef first_Digit(n):\n    \"\"\"\n    Finds the first digit of a given non-negative number.\n    Raises ValueError for invalid inputs (non-integers, negative values).\n    \"\"\"\n    validator = InputValidator()\n    validator.validate(n)\n\n    if n == 0:\n        return 0\n\n    while n >= 10:\n        n //= 10\n    return n"}
{"task_id": "Mbpp/555", "solution": "def validate_n(n):\n    \"\"\"Raise ValueError if n is not an int or n < 1.\"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\ndef compute_sum_of_cubes(n):\n    \"\"\"Return sum_{i=1}^n i^3 using closed-form: ((n*(n+1))//2)**2.\"\"\"\n    sum_of_numbers_val = n * (n + 1) // 2\n    return sum_of_numbers_val ** 2\n\ndef compute_sum_of_numbers(n):\n    \"\"\"Return sum_{i=1}^n i using closed-form: n*(n+1)//2.\"\"\"\n    return n * (n + 1) // 2\n\ndef difference(n):\n    \"\"\"\n    Public API: Validate n and return (sum_{i=1}^n i**3) - (sum_{i=1}^n i) as Python int.\n    Raises ValueError for invalid n.\n    \"\"\"\n    validate_n(n)\n    sum_of_cubes = compute_sum_of_cubes(n)\n    sum_of_numbers = compute_sum_of_numbers(n)\n    return sum_of_cubes - sum_of_numbers"}
{"task_id": "Mbpp/556", "solution": "from typing import List, Tuple\n\ndef _adjust_n(n: int, length: int) -> int:\n    \"\"\"\n    Adjusts the input 'n' to be within the bounds of the list length.\n    It returns the minimum of 'n' and 'length'.\n    \"\"\"\n    return min(n, length)\n\ndef _count_parity(elements: List[int], n: int) -> Tuple[int, int]:\n    \"\"\"\n    Counts the number of odd and even integers in the first 'n' elements.\n    Returns a tuple of (odd_count, even_count).\n    \"\"\"\n    odd_count = 0\n    even_count = 0\n    for i in range(n):\n        if elements[i] % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    return odd_count, even_count\n\ndef find_Odd_Pair(elements: List[int], n: int) -> int:\n    \"\"\"\n    Counts the number of unordered pairs (i, j) where 0 <= i < j < n_considered\n    such that elements[i] XOR elements[j] is odd.\n    \"\"\"\n    n_considered = _adjust_n(n, len(elements))\n\n    if n_considered < 2:\n        return 0\n    \n    odd_count, even_count = _count_parity(elements, n_considered)\n    \n    # An XOR value is odd if and only if one operand is odd and the other is even.\n    # The total number of such pairs is the product of odd_count and even_count.\n    return odd_count * even_count"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in a string.\n    Non-alphabetic characters remain unchanged.\"\"\"\n    toggled_chars = []\n    for char in input:\n        if char.isalpha():\n            toggled_chars.append(char.swapcase())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/559", "solution": "from typing import List\n\ndef max_sub_array_sum(list: List[int], n: int) -> int:\n    \"\"\"\n    Finds the maximum sum of a contiguous sublist using Kadane's algorithm.\n    Validates `n` against the list's actual length, raising ValueError on mismatch or for empty lists.\n    \"\"\"\n    if not isinstance(list, (list, List)):\n        raise ValueError(\"Input 'list' must be a list of integers.\")\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n\n    if n != len(list):\n        raise ValueError(\"Declared length n does not match actual list length.\")\n\n    if n == 0:\n        raise ValueError(\"Empty lists are not supported as per design and will raise ValueError.\")\n\n    current_max = list[0]\n    global_max = list[0]\n\n    for i in range(1, n):\n        current_max = max(list[i], current_max + list[i])\n        global_max = max(global_max, current_max)\n\n    return global_max"}
{"task_id": "Mbpp/558", "solution": "class Digit:\n    \"\"\"Represents a single decimal digit and its position.\"\"\"\n    def __init__(self, position: int, value: int) -> None:\n        self.position = position\n        self.value = value\n\nclass IntegerNumber:\n    \"\"\"Represents an integer and provides method for digit extraction (LSB-first).\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def digits(self) -> list:\n        \"\"\"Extracts digits from the integer, returning them as a list of Digit instances (LSB-first).\"\"\"\n        digits_list = []\n        current_value = abs(self.value)\n        position = 0\n        if current_value == 0:\n            digits_list.append(Digit(0, 0))\n        while current_value > 0:\n            digit_value = current_value % 10\n            digits_list.append(Digit(position, digit_value))\n            current_value //= 10\n            position += 1\n        return digits_list\n\nclass Difference:\n    \"\"\"Represents the per-position absolute difference between two digits.\"\"\"\n    def __init__(self, position: int, value: int) -> None:\n        self.position = position\n        self.value = value\n\nclass Result:\n    \"\"\"Aggregates computed per-position differences into a single integer result value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass DigitDistanceCalculator:\n    \"\"\"Orchestrates digit distance calculation.\"\"\"\n    def digit_distance_nums(self, a: int, b: int) -> int:\n        \"\"\"Validates inputs and computes the sum of per-digit absolute differences.\"\"\"\n        if not isinstance(a, int) or not isinstance(b, int):\n            raise TypeError(\"Inputs must be integers.\")\n\n        num_a = IntegerNumber(a)\n        num_b = IntegerNumber(b)\n        result = self._compute(num_a, num_b)\n        return result.value\n\n    def _compute(self, num_a: IntegerNumber, num_b: IntegerNumber) -> Result:\n        \"\"\"Computes the sum of per-digit absolute differences between two IntegerNumber objects.\"\"\"\n        digits_a = num_a.digits()\n        digits_b = num_b.digits()\n\n        max_len = max(len(digits_a), len(digits_b))\n        total_difference = 0\n\n        for i in range(max_len):\n            digit_a_val = digits_a[i].value if i < len(digits_a) else 0\n            digit_b_val = digits_b[i].value if i < len(digits_b) else 0\n            \n            total_difference += abs(digit_a_val - digit_b_val)\n        \n        return Result(total_difference)\n\ndef digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"\n    Finds the sum of the per-digit difference between two integers.\n    The core logic is handled by DigitDistanceCalculator.\n    \"\"\"\n    calculator = DigitDistanceCalculator()\n    return calculator.digit_distance_nums(a, b)"}
{"task_id": "Mbpp/560", "solution": "def union_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Finds the union of elements from two tuples, deduplicates them, and returns them in a new sorted tuple.\n    Example: union_elements((3, 4, 5, 6), (5, 7, 4, 10)) == (3, 4, 5, 6, 7, 10)\n    \"\"\"\n    combined_elements = a + b\n    unique_elements = sorted(list(set(combined_elements)))\n    return tuple(unique_elements)"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(list_of_sublists):\n    \"\"\"\n    Finds the length of the longest sublist in a list of sublists.\n    Raises TypeError for invalid input types.\n    \"\"\"\n    if not isinstance(list_of_sublists, list):\n        raise TypeError('outer argument must be a list')\n\n    if not list_of_sublists:\n        return 0\n\n    max_len = 0\n    for sublist in list_of_sublists:\n        try:\n            current_len = len(sublist)\n        except TypeError:\n            raise TypeError('each element of outer list must support len()')\n        if current_len > max_len:\n            max_len = current_len\n    return max_len"}
{"task_id": "Mbpp/563", "solution": "from typing import List\n\ndef extract_values(input_string: str) -> List[str]:\n    \"\"\"\n    Extracts values between double quotation marks from a string.\n    Returns a list of the extracted values without the quotes, in their original order.\n    \"\"\"\n    extracted_list = []\n    current_search_index = 0\n    while True:\n        # Find the first opening double quote\n        first_quote_pos = input_string.find('\"', current_search_index)\n        if first_quote_pos == -1:\n            break  # No more opening quotes found\n\n        # Find the closing double quote after the first one\n        second_quote_pos = input_string.find('\"', first_quote_pos + 1)\n        if second_quote_pos == -1:\n            break  # An opening quote was found but no matching closing quote, stop processing\n\n        # Extract the substring between the two quotes (excluding the quotes themselves)\n        value = input_string[first_quote_pos + 1:second_quote_pos]\n        extracted_list.append(value)\n\n        # Continue searching for the next pair of quotes after the current closing quote\n        current_search_index = second_quote_pos + 1\n\n    return extracted_list"}
{"task_id": "Mbpp/564", "solution": "import collections\n\ndef count_Pairs(arr, n):\n    \"\"\"\n    Counts the number of unordered pairs (i, j) with unequal elements.\n    Validates inputs and calculates pairs among the first effective_n elements.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise ValueError(\"All elements in 'arr' must be integers.\")\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    effective_n = min(n, len(arr))\n\n    if effective_n <= 1:\n        return 0\n\n    # Total possible unordered pairs in effective_n elements\n    total_pairs = effective_n * (effective_n - 1) // 2\n\n    # Count occurrences of each number in the relevant part of the array\n    counts = collections.Counter(arr[:effective_n])\n\n    # Sum of pairs where elements are equal\n    equal_pairs_sum = 0\n    for count in counts.values():\n        if count > 1:\n            equal_pairs_sum += count * (count - 1) // 2\n\n    return total_pairs - equal_pairs_sum"}
