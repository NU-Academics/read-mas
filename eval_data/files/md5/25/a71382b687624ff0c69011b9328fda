{"task_id": "Mbpp/62", "solution": "def smallest_num(input_list):\n    \"\"\"Return the smallest numeric value from input_list.\n\n    Preconditions:\n    - input_list must be a Python list (else TypeError)\n    - elements must be numeric (int or float) (else TypeError)\n    - list must be non-empty (else ValueError)\n\n    The function does not mutate input_list.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input must be a list\")\n\n    if len(input_list) == 0:\n        raise ValueError(\"input list must not be empty\")\n\n    # Initialize min_value with the first element after validating its type\n    if not isinstance(input_list[0], (int, float)):\n        raise TypeError(\"all elements must be int or float\")\n    min_value = input_list[0]\n\n    # Iterate through the rest of the list to find the minimum\n    for elem in input_list[1:]:\n        if not isinstance(elem, (int, float)):\n            raise TypeError(\"all elements must be int or float\")\n        if elem < min_value:\n            min_value = elem\n\n    return min_value"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s):\n    \"\"\"\n    Counts the number of substrings where the sum of their digits equals their length.\n    Assumes input 's' is a string containing only digit characters.\n    \"\"\"\n    count = 0\n    n = len(s)\n\n    for start in range(n):\n        current_sum = 0\n        for end in range(start, n):\n            # The substring is s[start : end+1]\n            # Its length is (end + 1) - start\n            current_sum += int(s[end])\n            if current_sum == (end - start + 1):\n                count += 1\n    return count"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list):\n    \"\"\"Recursively flattens a list and sums all numeric elements.\"\"\"\n    total = 0\n    for element in input_list:\n        if isinstance(element, list):\n            total += recursive_list_sum(element)\n        else:\n            total += element\n    return total"}
{"task_id": "Mbpp/63", "solution": "from typing import List, Tuple, Union\n\nclass ValidationError(Exception):\n    \"\"\"\n    Custom exception raised when input validation fails.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass Pair:\n    \"\"\"\n    Represents a 2-element numeric pair and computes its absolute difference.\n    \"\"\"\n    def __init__(self, a: Union[int, float], b: Union[int, float]) -> None:\n        self.a = float(a)\n        self.b = float(b)\n\n    def abs_difference(self) -> float:\n        \"\"\"\n        Computes the absolute difference between the pair's elements.\n        \"\"\"\n        return abs(self.a - self.b)\n\ndef _validate_pairs(pairs: List[Tuple[Union[int, float], Union[int, float]]]) -> None:\n    \"\"\"\n    Validates that the input is a list of 2-element numeric tuples.\n    Raises ValidationError on invalid input.\n    \"\"\"\n    if not isinstance(pairs, list):\n        raise ValidationError(\"Input must be a list.\")\n\n    for i, pair in enumerate(pairs):\n        if not isinstance(pair, tuple):\n            raise ValidationError(f\"Element at index {i} is not a tuple.\")\n        if len(pair) != 2:\n            raise ValidationError(f\"Tuple at index {i} does not have exactly 2 elements.\")\n        \n        a, b = pair\n        if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n            raise ValidationError(f\"Elements of tuple at index {i} must be numeric (int or float).\")\n\ndef _compute_abs(a: Union[int, float], b: Union[int, float]) -> float:\n    \"\"\"\n    Computes and returns the absolute difference between two numbers as a float.\n    \"\"\"\n    return abs(float(a) - float(b))\n\ndef max_difference(pairs: List[Tuple[float, float]]) -> float:\n    \"\"\"\n    Finds the maximum absolute difference between available pairs in a list of tuples.\n    \"\"\"\n    _validate_pairs(pairs)\n\n    if not pairs:\n        return 0.0\n\n    abs_diffs = [_compute_abs(a, b) for a, b in pairs]\n    return max(abs_diffs)"}
{"task_id": "Mbpp/66", "solution": "def pos_count(nums):\n    \"\"\"Count integers strictly greater than 0.\n\n    Args:\n        nums: list of integers (List[int])\n\n    Returns:\n        int: number of elements in nums strictly greater than 0\n    \"\"\"\n    count = 0\n    for num in nums:\n        if num > 0:\n            count += 1\n    return count"}
{"task_id": "Mbpp/67", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid input to bell_number.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\n_CACHE: dict[int, int] = {}\n\ndef _validate_n(n) -> None:\n    \"\"\"Ensures n is a non-negative integer, raising ValidationError if not.\"\"\"\n    if not isinstance(n, int):\n        raise ValidationError(\"n must be an integer\")\n    if n < 0:\n        raise ValidationError(\"n must be a non-negative integer\")\n\ndef _compute_bell(n: int) -> int:\n    \"\"\"\n    Computes the Bell number for n using Stirling numbers of the second kind,\n    with memoization.\n    \"\"\"\n    if n in _CACHE:\n        return _CACHE[n]\n\n    if n == 0:\n        _CACHE[0] = 1\n        return 1\n\n    # Create a 2D table for Stirling numbers of the second kind, S(i, j)\n    # stirling_s[i][j] stores S(i, j)\n    stirling_s = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Base case: S(0, 0) = 1\n    stirling_s[0][0] = 1\n\n    # Fill the Stirling numbers table using the recurrence relation\n    for i in range(1, n + 1):\n        for j in range(1, i + 1):\n            # S(i, j) = S(i-1, j-1) + j * S(i-1, j)\n            stirling_s[i][j] = stirling_s[i-1][j-1] + j * stirling_s[i-1][j]\n\n    # The Bell number B_n is the sum of S(n, k) for k from 0 to n\n    bell_n = sum(stirling_s[n][k] for k in range(n + 1))\n\n    _CACHE[n] = bell_n\n    return bell_n\n\ndef bell_number(n) -> int:\n    \"\"\"\n    Calculates the Bell number for a set of size n.\n    Raises ValidationError for invalid input.\n    \"\"\"\n    _validate_n(n)\n    return _compute_bell(n)"}
{"task_id": "Mbpp/70", "solution": "from typing import List\n\nclass Tuple:\n    \"\"\"Represent a tuple value as a domain object and provide length() operation.\"\"\"\n    def __init__(self, elements: tuple):\n        self._elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the tuple.\"\"\"\n        return len(self._elements)\n\nclass TupleCollection:\n    \"\"\"Hold and provide collection-level operations over a list of Tuple domain objects.\"\"\"\n    def __init__(self, tuples: List[Tuple]):\n        self.tuples = tuples\n\n    def count(self) -> int:\n        \"\"\"Returns the number of tuples in the collection.\"\"\"\n        return len(self.tuples)\n\n    def get_lengths(self) -> List[int]:\n        \"\"\"Returns a list of lengths of all tuples in the collection.\"\"\"\n        return [t.length() for t in self.tuples]\n\nclass BooleanResult:\n    \"\"\"Wrapper for boolean result of equality evaluation.\"\"\"\n    def __init__(self, value: bool):\n        self.value = value\n\nclass GetEqualFunction:\n    \"\"\"Encapsulate algorithm to determine whether all tuples in a TupleCollection have equal lengths.\"\"\"\n    def get_equal(self, tuples: List[Tuple]) -> bool:\n        \"\"\"Determines if all tuples in the given list have equal lengths.\"\"\"\n        tuple_collection = TupleCollection(tuples)\n        lengths = tuple_collection.get_lengths()\n\n        if not lengths:\n            return BooleanResult(True).value # Empty collection, vacuously true\n        \n        first_length = lengths[0]\n        for length in lengths:\n            if length != first_length:\n                return BooleanResult(False).value\n        \n        return BooleanResult(True).value\n\ndef get_equal(tuples: list[tuple]) -> bool:\n    \"\"\"\n    Checks if all given tuples have equal length.\n\n    Converts input tuples to domain objects, delegates the check, and returns a boolean.\n    \"\"\"\n    domain_tuples = [Tuple(t) for t in tuples]\n    \n    get_equal_func = GetEqualFunction()\n    return get_equal_func.get_equal(domain_tuples)"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(number: int) -> bool:\n    \"\"\"Checks if a number can be represented as the difference of two squares (a^2 - b^2).\n    A number can be represented as a difference of squares if and only if it is not congruent to 2 modulo 4.\"\"\"\n    return number % 4 != 2"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list, sub_list):\n    \"\"\"\n    Return True iff sub_list appears as a consecutive subsequence in main_list.\n    Compares elements using Python's equality operator (==).\n    \"\"\"\n    len_main = len(main_list)\n    len_sub = len(sub_list)\n\n    if len_sub > len_main:\n        return False\n    \n    if len_sub == 0:\n        return True # An empty list is always a sublist\n\n    for i in range(len_main - len_sub + 1):\n        if main_list[i : i + len_sub] == sub_list:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/68", "solution": "from typing import List, Union\nfrom dataclasses import dataclass\n\nNumber = Union[int, float]\n\n@dataclass\nclass Element:\n    \"\"\"Represents an individual element with value and index.\"\"\"\n    value: Number\n    index: int\n\nclass Array:\n    \"\"\"Lightweight domain container representing an ordered list of numeric elements.\"\"\"\n    def __init__(self, elements: List[Number]) -> None:\n        self.elements = elements\n\nclass MonotonicChecker:\n    \"\"\"Evaluates whether an array is monotonic by checking non-decreasing and non-increasing conditions.\"\"\"\n\n    def _is_non_decreasing(self, arr: List[Number]) -> bool:\n        \"\"\"Returns True if the array is non-decreasing (allows equal consecutive elements).\"\"\"\n        for i in range(1, len(arr)):\n            if arr[i] < arr[i - 1]:\n                return False\n        return True\n\n    def _is_non_increasing(self, arr: List[Number]) -> bool:\n        \"\"\"Returns True if the array is non-increasing (allows equal consecutive elements).\"\"\"\n        for i in range(1, len(arr)):\n            if arr[i] > arr[i - 1]:\n                return False\n        return True\n\n    def is_Monotonic(self, arr: List[Number]) -> bool:\n        \"\"\"Returns True if the array is non-decreasing or non-increasing; short-circuits for len <= 1.\"\"\"\n        if len(arr) <= 1:\n            return True\n        return self._is_non_decreasing(arr) or self._is_non_increasing(arr)\n\ndef is_Monotonic(arr: List[Number]) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic (non-decreasing or non-increasing).\n    Empty and single-element lists are considered monotonic.\n    \"\"\"\n    return MonotonicChecker().is_Monotonic(arr)"}
{"task_id": "Mbpp/71", "solution": "from typing import Any, List\n\nclass Validator:\n    \"\"\"Validates input for comb_sort: checks if it's a list and elements are comparable.\"\"\"\n    def is_list(self, input: Any) -> bool:\n        \"\"\"Verifies if the input is a built-in list.\"\"\"\n        return isinstance(input, list)\n\n    def elements_comparable(self, lst: List[Any]) -> bool:\n        \"\"\"Verifies if elements in the list support pairwise comparison.\"\"\"\n        if len(lst) < 2:\n            return True\n\n        try:\n            for i in range(len(lst) - 1):\n                # Attempt various comparisons to check comparability.\n                _ = lst[i] > lst[i+1]\n                _ = lst[i] < lst[i+1]\n                _ = lst[i] == lst[i+1]\n            return True\n        except TypeError:\n            return False\n\nclass CombSort:\n    \"\"\"Executes the comb sort algorithm to sort a list.\"\"\"\n    _shrink_factor: float = 1.3\n\n    def comb_sort(self, lst: List[Any]) -> List[Any]:\n        \"\"\"Sorts a list using the comb sort algorithm and returns a new sorted list.\"\"\"\n        arr = list(lst)\n        n = len(arr)\n        if n <= 1:\n            return arr\n\n        gap = n\n        swapped = True\n\n        while gap > 1 or swapped:\n            if gap > 1:\n                gap = int(gap / self._shrink_factor)\n                if gap < 1:\n                    gap = 1\n\n            swapped = False\n            for i in range(n - gap):\n                if arr[i] > arr[i + gap]:\n                    arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                    swapped = True\n        return arr\n\ndef comb_sort(list: List[Any]) -> List[Any]:\n    \"\"\"Public API: validates and sorts the input list using the CombSort algorithm.\"\"\"\n    validator = Validator()\n    if not validator.is_list(list):\n        raise TypeError(\"input must be a list\")\n    if not validator.elements_comparable(list):\n        raise ValueError(\"elements are not pairwise comparable\")\n\n    sorter = CombSort()\n    return sorter.comb_sort(list)"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(sequence, pattern):\n    \"\"\"\n    Checks if the sequence follows the pattern, ensuring a one-to-one mapping\n    between pattern tokens and sequence elements.\n    \"\"\"\n    if len(sequence) != len(pattern):\n        return False\n\n    pattern_to_sequence_map = {}\n    sequence_to_pattern_map = {}\n\n    for i in range(len(pattern)):\n        p_token = pattern[i]\n        s_element = sequence[i]\n\n        # Rule 1: if pattern[i] == pattern[j] then sequence[i] == sequence[j]\n        # Check consistency for pattern token mapping\n        if p_token in pattern_to_sequence_map:\n            if pattern_to_sequence_map[p_token] != s_element:\n                return False\n        else:\n            pattern_to_sequence_map[p_token] = s_element\n\n        # Rule 2: if pattern[i] != pattern[j] then sequence[i] != sequence[j]\n        # Check consistency for sequence element mapping (injectivity)\n        if s_element in sequence_to_pattern_map:\n            if sequence_to_pattern_map[s_element] != p_token:\n                return False\n        else:\n            sequence_to_pattern_map[s_element] = p_token\n\n    return True"}
{"task_id": "Mbpp/75", "solution": "from typing import Tuple, List\n\n# Define type aliases as per src/find_tuples_lib/types.py\nTupleItem = Tuple[int, ...]\nInputList = List[TupleItem]\nResultList = List[TupleItem]\n\n# Define DivisibilityChecker class as per src/find_tuples_lib/divisibility_checker.py\nclass DivisibilityChecker:\n    \"\"\"Implements modulus-based divisibility checks.\"\"\"\n\n    def is_divisible(self, element: int, k: int) -> bool:\n        \"\"\"Returns True iff element is divisible by k.\"\"\"\n        return element % k == 0\n\n    def all_divisible(self, tuple_item: TupleItem, k: int) -> bool:\n        \"\"\"Returns True iff all elements in the tuple are divisible by k.\"\"\"\n        return all(self.is_divisible(e, k) for e in tuple_item)\n\n# Define the main function as per src/find_tuples_lib/find_tuples.py\ndef find_tuples(input_list: InputList, k: int) -> ResultList:\n    \"\"\"Return list of tuples from input_list where every element is divisible by k.\"\"\"\n    checker = DivisibilityChecker()\n    result: ResultList = []\n    for t in input_list:\n        if checker.all_divisible(t, k):\n            result.append(t)\n    return result"}
