{"task_id": "Mbpp/283", "solution": "from typing import List, Dict\n\nclass IntegerInput:\n    \"\"\"Represent an integer input and produce its decimal digit sequence ignoring sign.\"\"\"\n    def __init__(self, value: int):\n        self.value: int = value\n    def digit_sequence(self) -> str:\n        \"\"\"Return the decimal digit string for abs(self.value).\"\"\"\n        return str(abs(self.value))\n\nclass DigitFrequency:\n    \"\"\"Data holder for a digit (0..9) and its occurrence count.\"\"\"\n    def __init__(self, digit: int, frequency: int):\n        self.digit: int = digit\n        self.frequency: int = frequency\n\nclass ValidationResult:\n    \"\"\"Hold validation outcome and optional message for internal composition.\"\"\"\n    def __init__(self, is_valid: bool, message: str = \"\"):\n        self.is_valid: bool = is_valid\n        self.message: str = message\n\nclass ValidatorService:\n    \"\"\"Stateless service that computes digit frequencies and evaluates the digit-frequency rule.\"\"\"\n    def compute_frequencies(self, value: int) -> List[DigitFrequency]:\n        \"\"\"Count digits in abs(value) and return list of DigitFrequency for digits present.\"\"\"\n        input_obj = IntegerInput(value)\n        digit_str = input_obj.digit_sequence()\n\n        frequency_map: Dict[int, int] = {}\n        for char_digit in digit_str:\n            digit = int(char_digit)\n            frequency_map[digit] = frequency_map.get(digit, 0) + 1\n\n        freq_list: List[DigitFrequency] = []\n        for digit, freq in frequency_map.items():\n            freq_list.append(DigitFrequency(digit, freq))\n        return freq_list\n\n    def validate(self, value: int) -> bool:\n        \"\"\"Return True iff for each digit d present frequency(d) <= d.\"\"\"\n        frequencies = self.compute_frequencies(value)\n        for df in frequencies:\n            if df.frequency > df.digit:\n                return False\n        return True\n\ndef validate(value: int) -> bool:\n    \"\"\"Public API: returns True iff every digit d present in value satisfies frequency(d) <= d.\"\"\"\n    service = ValidatorService()\n    return service.validate(value)"}
