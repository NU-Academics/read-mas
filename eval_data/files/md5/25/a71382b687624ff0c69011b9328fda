{"task_id": "Mbpp/126", "solution": "import math\n\ndef sum(a, b) -> int:\n    \"\"\"Compute sum of positive common divisors of a and b. Uses absolute values for positive divisors and returns 0 if both inputs are zero.\"\"\"\n    aa = abs(a)\n    bb = abs(b)\n\n    if aa == 0 and bb == 0:\n        return 0\n\n    target = 0\n    if aa == 0:\n        target = bb\n    elif bb == 0:\n        target = aa\n    else:\n        # Calculate GCD using Euclidean algorithm\n        x, y = aa, bb\n        while y:\n            x, y = y, x % y\n        target = x\n\n    total_sum = 0\n    \n    # Efficiently find divisors and sum them by iterating up to the square root\n    for i in range(1, math.isqrt(target) + 1):\n        if target % i == 0:\n            total_sum += i\n            if i * i != target: # If i is not the square root, add its pair\n                total_sum += target // i\n    \n    return total_sum"}
{"task_id": "Mbpp/128", "solution": "from typing import List\n\ndef _validate_n(n) -> int:\n    \"\"\"Validates n to be an integer.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    return n\n\ndef _split_text(text: str) -> List[str]:\n    \"\"\"Splits text by whitespace into a list of words.\"\"\"\n    return text.split()\n\ndef _filter_words(tokens: List[str], n: int) -> List[str]:\n    \"\"\"Filters words longer than n characters, preserving order.\"\"\"\n    return [token for token in tokens if len(token) > n]\n\ndef long_words(n, text: str) -> List[str]:\n    \"\"\"\n    Finds words longer than n characters from a given text.\n    Tokenizes text by whitespace, validates n, and returns filtered words.\n    \"\"\"\n    n_valid = _validate_n(n)\n    tokens = _split_text(text)\n    filtered_tokens = _filter_words(tokens, n_valid)\n    return filtered_tokens"}
{"task_id": "Mbpp/129", "solution": "from typing import List, Tuple\n\nclass TestResult:\n    \"\"\"DTO for carrying test results and an optional reason.\"\"\"\n    def __init__(self, result: bool, reason: str = \"\"):\n        self.result = result\n        self.reason = reason\n\nclass Matrix:\n    \"\"\"Adapter around the input list-of-lists for matrix operations.\"\"\"\n    def __init__(self, elements: List[List[int]]):\n        self.elements = elements\n        # n is the side length, assumed to be self.rows() if it's a square matrix.\n        self.n = self.rows() \n\n    def rows(self) -> int:\n        \"\"\"Returns the number of rows in the matrix.\"\"\"\n        return len(self.elements)\n\n    def cols(self) -> int:\n        \"\"\"Returns the number of columns in the matrix.\"\"\"\n        return len(self.elements[0]) if self.rows() > 0 else 0\n\n    def is_square(self) -> bool:\n        \"\"\"Checks if the matrix is a non-empty square matrix with consistent row lengths.\"\"\"\n        num_rows = self.rows()\n        if num_rows == 0:\n            return False \n        num_cols = self.cols()\n        if num_rows != num_cols:\n            return False \n        for row in self.elements:\n            if len(row) != num_cols:\n                return False \n        return True\n\n    def all_integers(self) -> bool:\n        \"\"\"Checks if all elements in the matrix are integers.\"\"\"\n        for row in self.elements:\n            for item in row:\n                if not isinstance(item, int):\n                    return False\n        return True\n\n    def contains_1_to_n2(self) -> bool:\n        \"\"\"Checks if the matrix contains integers from 1 to n^2 exactly once.\"\"\"\n        if not self.is_square():\n            return False \n        \n        n_squared = self.n * self.n\n        if n_squared <= 0:\n            return False\n\n        expected_elements = set(range(1, n_squared + 1))\n        actual_elements = set()\n        \n        for row in self.elements:\n            for item in row:\n                actual_elements.add(item)\n        \n        return actual_elements == expected_elements\n\n    def row_sum(self, i: int) -> int:\n        \"\"\"Calculates the sum of elements in the specified row.\"\"\"\n        if 0 <= i < self.rows():\n            return sum(self.elements[i])\n        return 0\n\n    def col_sum(self, j: int) -> int:\n        \"\"\"Calculates the sum of elements in the specified column.\"\"\"\n        if 0 <= j < self.cols():\n            return sum(self.elements[k][j] for k in range(self.rows()))\n        return 0\n\n    def diag_sums(self) -> Tuple[int, int]:\n        \"\"\"Calculates the sums of the main and anti-diagonals.\"\"\"\n        main_diag_sum = 0\n        anti_diag_sum = 0\n        n = self.n\n        if n == 0:\n            return (0, 0) \n        for i in range(n):\n            main_diag_sum += self.elements[i][i]\n            anti_diag_sum += self.elements[i][n - 1 - i]\n        return (main_diag_sum, anti_diag_sum)\n\n\nclass Validator:\n    \"\"\"Performs structural, type, and uniqueness validations for a matrix.\"\"\"\n    def validate_structure(self, m: Matrix) -> bool:\n        \"\"\"Validates if the input is a non-empty, two-dimensional square matrix.\"\"\"\n        if not isinstance(m.elements, list):\n            return False\n        if m.rows() == 0: \n            return False\n        for row in m.elements:\n            if not isinstance(row, list): \n                return False\n        return m.is_square() \n\n    def validate_integers(self, m: Matrix) -> bool:\n        \"\"\"Validates if all elements in the matrix are integers.\"\"\"\n        return m.all_integers()\n\n    def validate_uniqueness(self, m: Matrix) -> bool:\n        \"\"\"Validates if the matrix contains integers from 1 to n^2 exactly once.\"\"\"\n        return m.contains_1_to_n2()\n\n\nclass MagicSquareTester:\n    \"\"\"Verifies the sum properties of a matrix to determine if it's magic.\"\"\"\n    def __init__(self, validator: Validator = None):\n        pass\n\n    def is_magic(self, m: Matrix) -> TestResult:\n        \"\"\"Checks if all row, column, and diagonal sums are equal.\"\"\"\n        n = m.n\n        if n == 0:\n            return TestResult(False, \"Matrix is empty.\")\n\n        magic_sum = m.row_sum(0)\n\n        for i in range(n):\n            if m.row_sum(i) != magic_sum:\n                return TestResult(False, f\"Row {i} sum does not match the magic sum.\")\n\n        for j in range(n):\n            if m.col_sum(j) != magic_sum:\n                return TestResult(False, f\"Column {j} sum does not match the magic sum.\")\n\n        main_diag_sum, anti_diag_sum = m.diag_sums()\n        if main_diag_sum != magic_sum:\n            return TestResult(False, \"Main diagonal sum does not match the magic sum.\")\n        if anti_diag_sum != magic_sum:\n            return TestResult(False, \"Anti-diagonal sum does not match the magic sum.\")\n\n        return TestResult(True)\n\n\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"Calculates whether the given matrix is a magic square.\"\"\"\n    if not isinstance(matrix, list):\n        return False\n    \n    m = Matrix(matrix)\n    validator = Validator()\n    \n    if not validator.validate_structure(m):\n        return False\n    \n    if not validator.validate_integers(m):\n        return False\n    \n    if not validator.validate_uniqueness(m):\n        return False\n        \n    tester = MagicSquareTester()\n    result = tester.is_magic(m)\n    \n    return result.result"}
{"task_id": "Mbpp/130", "solution": "class FrequencyCounter:\n    \"\"\"\n    Manages frequency counts for items and identifies the item with the maximum frequency.\n    Tie-breaking returns the first encountered item with the maximum count.\n    \"\"\"\n    def __init__(self):\n        self._counts = {}\n\n    def buildCounts(self, items_list):\n        \"\"\"Populates the internal counts dictionary from the given list.\"\"\"\n        for item in items_list:\n            self._counts[item] = self._counts.get(item, 0) + 1\n\n    def maxItem(self):\n        \"\"\"Returns the item with the highest frequency from the collected counts.\"\"\"\n        if not self._counts:\n            return None # Returns None for an empty list, as no item exists.\n\n        max_freq = -1\n        max_item = None\n\n        # Iterate through items, insertion order determines tie-breaking\n        for item, count in self._counts.items():\n            if count > max_freq:\n                max_freq = count\n                max_item = item\n        return max_item\n\ndef max_occurrences(items_list):\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Delegates counting and max item identification to an internal FrequencyCounter.\n    \"\"\"\n    counter = FrequencyCounter()\n    counter.buildCounts(items_list)\n    return counter.maxItem()"}
{"task_id": "Mbpp/131", "solution": "from typing import List, Set\n\nVOWELS: Set[str] = {'a', 'e', 'i', 'o', 'u'}\n\ndef is_vowel(ch: str) -> bool:\n    \"\"\"Return True if ch is a vowel (a,e,i,o,u) case-insensitive. 'y'/'Y' are NOT vowels.\"\"\"\n    return ch.lower() in VOWELS\n\ndef _collect_vowels(s: str) -> List[str]:\n    \"\"\"Return list of vowel characters (as they appear) from s.\"\"\"\n    collected = []\n    for char in s:\n        if is_vowel(char):\n            collected.append(char)\n    return collected\n\ndef reverse_vowels(input: str) -> str:\n    \"\"\"Public API: returns new string with vowels reversed per design.\"\"\"\n    if not input:\n        return \"\"\n\n    collected_vowels = _collect_vowels(input)\n\n    if len(collected_vowels) <= 1:\n        return input\n\n    reversed_vowels = collected_vowels[::-1]\n    \n    s_list = list(input)\n    reversed_vowel_idx = 0\n    for i in range(len(s_list)):\n        if is_vowel(s_list[i]):\n            s_list[i] = reversed_vowels[reversed_vowel_idx]\n            reversed_vowel_idx += 1\n\n    return \"\".join(s_list)"}
{"task_id": "Mbpp/133", "solution": "Number = float\nNumberList = list[Number]\n\ndef sum_negativenum(items: list[float]) -> float:\n    \"\"\"\n    Calculates the sum of negative numbers in a given list of numbers.\n    It iterates through the list, adding only numbers strictly less than zero to a running total.\n    \"\"\"\n    total_sum = 0.0\n    for item in items:\n        if item < 0:\n            total_sum += item\n    return total_sum"}
{"task_id": "Mbpp/132", "solution": "def _validate_input(t: tuple) -> None:\n    \"\"\"Validates that the input is a tuple and contains only string elements.\"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(\"tup_string expects a tuple\")\n    for el in t:\n        if not isinstance(el, str):\n            raise TypeError(\"tup_string expects all tuple elements to be str\")\n\ndef tup_string(t: tuple) -> str:\n    \"\"\"Converts a tuple of strings into a single concatenated string.\"\"\"\n    _validate_input(t)\n    return ''.join(t)"}
{"task_id": "Mbpp/135", "solution": "def hexagonal_num(n):\n    \"\"\"\n    Calculate the nth hexagonal number using the formula H(n) = n * (2 * n - 1).\n    Input n is assumed to be a 1-based positive integer.\n    \"\"\"\n    return n * (2 * n - 1)"}
{"task_id": "Mbpp/137", "solution": "def zero_count(arr: list[int]) -> float:\n    \"\"\"Calculates the ratio of zeroes to non-zeroes in a list of integers.\"\"\"\n    zeroes = 0\n    non_zeroes = 0\n    for x in arr:\n        if x == 0:\n            zeroes += 1\n        else:\n            non_zeroes += 1\n\n    if non_zeroes == 0:\n        raise ValueError(\"Cannot compute ratio: no non-zero elements in the array.\")\n    \n    return float(zeroes) / non_zeroes"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(n: int) -> bool:\n    \"\"\"Return True iff integer n can be expressed as a sum of one or more non-zero powers of two (2^k, k>0).\n    This reduces to checking if n is an even integer greater than or equal to 2.\"\"\"\n    return n >= 2 and n % 2 == 0"}
{"task_id": "Mbpp/140", "solution": "from typing import Iterable, Iterator\n\ndef extract_singly(iterable_of_iterables: Iterable[Iterable[int]]) -> Iterator[int]:\n    \"\"\"Consumes an iterable of iterables and yields each distinct integer found.\n    The function returns an iterator of these unique integers.\n    \"\"\"\n    internal_set: set[int] = set()\n    for inner in iterable_of_iterables:\n        for item in inner:\n            internal_set.add(item)\n    for v in internal_set:\n        yield v"}
{"task_id": "Mbpp/139", "solution": "import math\nfrom dataclasses import dataclass\n\nPI: float = math.pi\n\n@dataclass\nclass Circle:\n    radius: float\n    circumference: float\n\n@dataclass\nclass NumericValue:\n    value: float\n    type: str\n\n@dataclass\nclass ComputationResult:\n    value: float\n    relative_error: float\n\nclass CalculationService:\n    \"\"\"\n    Stateless service to compute circle circumference and encapsulate domain logic.\n    It adheres to the design specification for validation and computation.\n    \"\"\"\n    def circle_circumference(self, radius_input) -> float:\n        \"\"\"\n        Computes the circumference of a circle for a given radius.\n        Returns the circumference as a float.\n        \"\"\"\n        numeric_type = 'int' if isinstance(radius_input, int) else 'float'\n        numeric_value = NumericValue(value=float(radius_input), type=numeric_type)\n\n        circumference = 2 * PI * numeric_value.value\n\n        _ = Circle(radius=numeric_value.value, circumference=circumference)\n\n        # The design specifies computing relative error for ComputationResult, even if it's typically zero in this case.\n        true_value_for_error_check = 2 * PI * numeric_value.value\n        relative_error = abs(circumference - true_value_for_error_check) / abs(true_value_for_error_check) if true_value_for_error_check != 0 else 0.0\n\n        computation_result = ComputationResult(value=circumference, relative_error=relative_error)\n\n        return computation_result.value\n\ndef circle_circumference(radius):\n    \"\"\"\n    Calculates the circumference of a circle given its radius.\n    Delegates the computation to an internal CalculationService.\n    \"\"\"\n    service = CalculationService()\n    return service.circle_circumference(radius)"}
{"task_id": "Mbpp/142", "solution": "import math\nfrom typing import Sequence, Any\n\ndef count_samepair(list1: Sequence[Any], list2: Sequence[Any], list3: Sequence[Any]) -> int:\n    \"\"\"Return integer count of indices i where list1[i] == list2[i] == list3[i].\n    Compares elements only up to the minimum length of the three input sequences.\"\"\"\n    \n    min_len = min(len(list1), len(list2), len(list3))\n    count = 0\n    for i in range(min_len):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/145", "solution": "def _validate_sequence(seq):\n    \"\"\"Internal: ensure seq is iterable and contains at least two numeric values; return list of numeric values or raise ValueError.\"\"\"\n    numeric_values = []\n    for item in seq:\n        if isinstance(item, (int, float)):\n            numeric_values.append(item)\n\n    if len(numeric_values) < 2:\n        raise ValueError(\"Input sequence must contain at least two numeric elements.\")\n    return numeric_values\n\ndef max_Abs_Diff(seq):\n    \"\"\"Public API: returns max(seq) - min(seq) for numeric seq of length >= 2; raises ValueError otherwise.\"\"\"\n    values = _validate_sequence(seq)\n    return max(values) - min(values)"}
{"task_id": "Mbpp/141", "solution": "from typing import List, TypeVar\n\nT = TypeVar('T')\n\nclass PancakeSorter:\n    \"\"\"Encapsulates core pancake sort operations including flip and main algorithm.\"\"\"\n\n    def flip(self, lst: List[T], k: int) -> List[T]:\n        \"\"\"Reverse the first k elements of lst and return lst (prefix flip).\"\"\"\n        left, right = 0, k - 1\n        while left < right:\n            lst[left], lst[right] = lst[right], lst[left]\n            left += 1\n            right -= 1\n        return lst\n\n    def pancake_sort(self, lst: List[T]) -> List[T]:\n        \"\"\"Perform pancake sort using prefix flips and return sorted list.\"\"\"\n        n = len(lst)\n        # Iterate from the end of the list down to the second element\n        for current_size in range(n, 1, -1):\n            # Find the index of the maximum element in the unsorted prefix\n            max_idx = 0\n            for i in range(1, current_size):\n                if lst[i] > lst[max_idx]:\n                    max_idx = i\n\n            # If the maximum element is not already at its correct position\n            # (which is current_size - 1)\n            if max_idx != current_size - 1:\n                # 1. Bring the maximum element to the front\n                if max_idx != 0:\n                    self.flip(lst, max_idx + 1)\n                # 2. Move the maximum element to its correct position\n                self.flip(lst, current_size)\n        return lst\n\ndef pancake_sort(input_list: List[T]) -> List[T]:\n    \"\"\"Return a list containing the elements of input_list sorted in non-decreasing order.\n\n    The function name must be pancake_sort (BR1). The implementation uses PancakeSorter internally.\n    \"\"\"\n    if not input_list:\n        return []\n\n    # Create a shallow copy to avoid modifying the original list\n    working_list = list(input_list)\n    sorter = PancakeSorter()\n    return sorter.pancake_sort(working_list)"}
{"task_id": "Mbpp/160", "solution": "from typing import Optional, Tuple\nfrom dataclasses import dataclass\n\n@dataclass\nclass IntegerParameters:\n    \"\"\"Represents the input triple (a, b, n).\"\"\"\n    a: int\n    b: int\n    n: int\n\n@dataclass\nclass Solution:\n    \"\"\"Represents a concrete integer solution pair (x, y).\"\"\"\n    x: int\n    y: int\n\n    def valid(self, a: int, b: int, n: int) -> bool:\n        \"\"\"Checks if the solution satisfies a*x + b*y == n.\"\"\"\n        return a * self.x + b * self.y == n\n\n@dataclass\nclass Result:\n    \"\"\"Container holding either a Solution or None.\"\"\"\n    solution: Optional[Solution]\n\nclass GCDCalculator:\n    \"\"\"Computes gcd(a,b) and extended Euclidean coefficients.\"\"\"\n\n    def gcd(self, a: int, b: int) -> int:\n        \"\"\"Computes the greatest common divisor of a and b using Euclidean algorithm.\"\"\"\n        a, b = abs(a), abs(b)\n        while b:\n            a, b = b, a % b\n        return a\n\n    def extended_gcd(self, a: int, b: int) -> Tuple[int, int, int]:\n        \"\"\"\n        Computes (g, x, y) such that a*x + b*y = g = gcd(a, b).\n        Handles negative inputs and zero correctly.\n        \"\"\"\n        if a == 0 and b == 0:\n            return (0, 0, 0)\n\n        sign_a = 1 if a >= 0 else -1\n        sign_b = 1 if b >= 0 else -1\n        \n        abs_a = abs(a)\n        abs_b = abs(b)\n\n        def _extended_gcd_non_negative(val1: int, val2: int) -> Tuple[int, int, int]:\n            if val1 == 0:\n                return (val2, 0, 1)\n            g, x_coeff, y_coeff = _extended_gcd_non_negative(val2 % val1, val1)\n            return (g, y_coeff - (val2 // val1) * x_coeff, x_coeff)\n\n        g, x_abs, y_abs = _extended_gcd_non_negative(abs_a, abs_b)\n        \n        x_final = x_abs * sign_a\n        y_final = y_abs * sign_b\n        \n        return (g, x_final, y_final)\n\nclass FindSolutionService:\n    \"\"\"\n    Finds a deterministic integer solution for the Diophantine equation ax + by = n.\n    \"\"\"\n    def __init__(self, gcd_calc: Optional[GCDCalculator] = None):\n        self._gcd_calc = gcd_calc if gcd_calc is not None else GCDCalculator()\n        self._selection_policy_desc = \"scale extended_gcd result by n//gcd and then normalize x to the smallest non-negative value.\"\n\n    def find_solution(self, a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n        \"\"\"\n        Finds integers x and y that satisfy ax + by = n as a tuple,\n        or returns None if no solution exists.\n        \"\"\"\n        g = self._gcd_calc.gcd(a, b)\n\n        if g == 0: # This case implies a=0 and b=0\n            if n == 0:\n                return (0, 0) # (0,0) is a deterministic solution for 0x + 0y = 0\n            else:\n                return None # No solution for 0x + 0y = N (N != 0)\n\n        # At this point, g > 0. Check for solvability.\n        if n % g != 0:\n            return None # No integer solution exists if n is not divisible by g\n\n        # A solution exists. Find a particular one (xg, yg) for a*xg + b*yg = g.\n        _, xg, yg = self._gcd_calc.extended_gcd(a, b)\n\n        # Scale the particular solution from extended_gcd to satisfy ax + by = n.\n        scale = n // g\n        x0 = xg * scale\n        y0 = yg * scale\n\n        # Normalize the solution to a deterministic canonical form.\n        # If b is zero, ax = n, so x = n/a and y can be any integer. We take y=0.\n        # x0 already equals n/a, y0 already equals 0 from extended_gcd(a,0).\n        if b == 0:\n            return (x0, y0)\n        \n        # Normalize x to be the smallest non-negative integer.\n        b_step = b // g \n        x_norm = (x0 % abs(b_step) + abs(b_step)) % abs(b_step)\n        \n        # Recalculate y using the normalized x and the original equation.\n        # (n - a*x_norm) must be divisible by b.\n        y_norm = (n - a * x_norm) // b\n        \n        return (x_norm, y_norm)\n\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple,\n    or returns None if no solution exists.\n    \"\"\"\n    svc = FindSolutionService()\n    return svc.find_solution(a, b, n)"}
{"task_id": "Mbpp/162", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass SeriesTerm:\n    \"\"\"Encapsulates a single series term (index and computed value).\"\"\"\n    i: int\n    value: int\n\n@dataclass\nclass Result:\n    \"\"\"Encapsulates the aggregated integer total.\"\"\"\n    total: int\n\ndef _compute_terms(n: int) -> List[SeriesTerm]:\n    \"\"\"Private helper: generates SeriesTerm objects for i in 0..n//2 (inclusive).\"\"\"\n    terms = []\n    for i in range(0, n // 2 + 1):\n        value = n - 2 * i\n        terms.append(SeriesTerm(i=i, value=value))\n    return terms\n\ndef sum_series(n: int) -> int:\n    \"\"\"Calculates the sum of (n - 2*i) for i from 0 to n // 2.\"\"\"\n    terms = _compute_terms(n)\n    total = sum(t.value for t in terms)\n    return int(total)"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(source: list, to_remove: list) -> list:\n    \"\"\"Return list of items from source not equal to any item in to_remove.\n    Preserves order and does not mutate inputs.\n    \"\"\"\n    if not to_remove:\n        return source.copy()\n\n    to_remove_set = set(to_remove)\n    result = []\n    for item in source:\n        if item not in to_remove_set:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string whose alphabetical position matches their 1-based index.\n    Comparisons are case-insensitive and only include ASCII English letters.\n    \"\"\"\n    count = 0\n    for i, char in enumerate(input_string):\n        string_position = i + 1  # 1-based index\n\n        # Indices > 26 cannot match any alphabet position\n        if string_position > 26:\n            continue\n\n        lower_char = char.lower()\n\n        # Check if the character is an ASCII English letter\n        if 'a' <= lower_char <= 'z':\n            alphabet_position = ord(lower_char) - ord('a') + 1\n\n            if alphabet_position == string_position:\n                count += 1\n    return count"}
{"task_id": "Mbpp/167", "solution": "def _validate_input(n) -> None:\n    \"\"\"Validates if n is an integer and non-negative. Raises TypeError or ValueError on invalid input.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\ndef _is_power_of_two(n: int) -> bool:\n    \"\"\"Checks if n (assumed int >= 0) is an exact power of two.\"\"\"\n    return n > 0 and (n & (n - 1)) == 0\n\ndef next_power_of_2(n: int) -> int:\n    \"\"\"Public API. Validate n and return smallest power of two >= n.\"\"\"\n    _validate_input(n)\n\n    if n == 0:\n        return 1\n\n    if _is_power_of_two(n):\n        return n\n\n    # For n > 0 and not a power of two, calculate the next power of two.\n    # n.bit_length() gives the number of bits required to represent n.\n    # 1 << k produces 2^k.\n    return 1 << n.bit_length()"}
{"task_id": "Mbpp/166", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass ParityCounts:\n    \"\"\"Holds the counts of even and odd numbers from a list.\"\"\"\n    count_even: int\n    count_odd: int\n\ndef _count_parity(numbers: List[int]) -> ParityCounts:\n    \"\"\"Counts even and odd numbers in a list without modifying it.\"\"\"\n    even_count = 0\n    odd_count = 0\n    for num in numbers:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    return ParityCounts(even_count, odd_count)\n\ndef _comb2(n: int) -> int:\n    \"\"\"Computes combinations C(n, 2) safely, returning 0 if n is less than 2.\"\"\"\n    if n < 2:\n        return 0\n    return n * (n - 1) // 2\n\ndef find_even_pair(numbers: List[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list whose bitwise XOR is an even number.\n    This is equivalent to counting pairs where both integers have the same parity.\n    \"\"\"\n    if len(numbers) < 2:\n        return 0\n\n    parity_counts = _count_parity(numbers)\n    \n    # Pairs of even numbers XOR to an even number.\n    # Pairs of odd numbers XOR to an even number.\n    # Pairs of mixed parity (even and odd) XOR to an odd number.\n    result = _comb2(parity_counts.count_even) + _comb2(parity_counts.count_odd)\n    \n    return result"}
{"task_id": "Mbpp/168", "solution": "from typing import List\nfrom numbers import Number\n\ndef frequency(numbers: List[Number], target: Number) -> int:\n    \"\"\"Counts the number of occurrences of a target number in a list.\"\"\"\n    count = 0\n    for number in numbers:\n        if number == target:\n            count += 1\n    return count"}
