{"task_id": "Mbpp/2", "solution": "from typing import Sequence, List, Any, Iterator, Set\n\nclass ResultCollection:\n    \"\"\"A collection wrapper for intersection items, providing iteration and set conversion.\"\"\"\n    def __init__(self, items: List[Any]) -> None:\n        self.items = items\n\n    def __iter__(self) -> Iterator[Any]:\n        return iter(self.items)\n\n    def __len__(self) -> int:\n        return len(self.items)\n\n    def as_set(self) -> Set[Any]:\n        return set(self.items)\n\n    def __repr__(self) -> str:\n        return f\"ResultCollection({self.items!r})\"\n\ndef similar_elements(a: Sequence, b: Sequence) -> ResultCollection:\n    \"\"\"\n    Finds shared elements from two sequences, returning them in a ResultCollection.\n    This function converts inputs to sets for efficient intersection computation.\n    \"\"\"\n    set_a = set(a)\n    set_b = set(b)\n    intersection_set = set_a & set_b\n    return ResultCollection(list(intersection_set))"}
{"task_id": "Mbpp/3", "solution": "from math import isqrt\n\ndef is_not_prime(n):\n    \"\"\"Return True if n is NOT prime, False if n is prime.\n    Handles n <= 1 as not prime.\n    \"\"\"\n    if n <= 1:\n        return True\n    if n == 2:\n        return False\n    if n % 2 == 0:\n        return True\n\n    for i in range(3, isqrt(n) + 1, 2):\n        if n % i == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/7", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass Word:\n    \"\"\"Represents a single token and preserves its original casing.\"\"\"\n    text: str\n\n    def length(self) -> int:\n        \"\"\"Returns the character length of the word.\"\"\"\n        return len(self.text)\n\nclass Tokenizer:\n    \"\"\"Deterministically splits an input string into tokens using whitespace.\"\"\"\n    @staticmethod\n    def tokenize(content: str) -> List[str]:\n        \"\"\"Splits the content string by any whitespace.\"\"\"\n        return content.split()\n\nclass WordFilter:\n    \"\"\"Filters Word objects by a minimum character length threshold.\"\"\"\n    @staticmethod\n    def filter_by_min_length(words: List[Word], min_len: int) -> List[Word]:\n        \"\"\"Returns words whose length is greater than or equal to min_len.\"\"\"\n        return [word for word in words if word.length() >= min_len]\n\nclass ResultList:\n    \"\"\"Converts a list of Word objects to a list of strings.\"\"\"\n    @staticmethod\n    def to_list(words: List[Word]) -> List[str]:\n        \"\"\"Extracts the text from each Word object.\"\"\"\n        return [word.text for word in words]\n\ndef find_char_long(content: str) -> List[str]:\n    \"\"\"\n    Finds all words which are at least 4 characters long in a string.\n    The function orchestrates tokenization, filtering, and result conversion.\n    \"\"\"\n    if not isinstance(content, str):\n        raise TypeError(\"Input must be a string.\")\n\n    tokens = Tokenizer.tokenize(content)\n    words = [Word(token) for token in tokens]\n    filtered_words = WordFilter.filter_by_min_length(words, 4)\n    result = ResultList.to_list(filtered_words)\n    return result"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of left rotations (greater than 0) required to get the same string.\n    Returns the minimum k where 1 <= k <= len(s).\n    \"\"\"\n    n = len(s)\n    # Iterate through possible rotation values from 1 up to n-1.\n    # A rotation of 0 characters is not allowed (k must be > 0).\n    # A rotation of n characters always results in the original string.\n    for k in range(1, n):\n        rotated_s = s[k:] + s[:k]\n        if rotated_s == s:\n            return k\n    \n    # If no rotation k < n resulted in the original string,\n    # then the smallest rotation that matches is a full rotation of n characters.\n    # This also handles the case of a single-character string (e.g., \"a\"), where n=1,\n    # the loop range(1,1) is empty, and it correctly returns 1.\n    return n"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a, b):\n    \"\"\"\n    Checks if two integers differ at exactly one bit position.\n    This is achieved by XORing the numbers and counting set bits in the result.\n    \"\"\"\n    # Calculate the XOR of the two numbers.\n    # The set bits in the XOR result indicate differing bit positions.\n    xor_result = a ^ b\n\n    # Count the number of set bits in the XOR result using Brian Kernighan's algorithm.\n    # This algorithm repeatedly flips the least significant set bit to zero until the number becomes zero.\n    count = 0\n    while xor_result != 0:\n        xor_result &= (xor_result - 1)\n        count += 1\n\n    # Return True if exactly one bit differs, otherwise False.\n    return count == 1"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(s: str, c: str) -> str:\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    If the character appears once, it removes that single occurrence. If not found, returns the original string.\n    \"\"\"\n    # Helper function to find all occurrences of a character\n    def _find_occurrences(text: str, char_to_find: str) -> list[int]:\n        indices = []\n        for i in range(len(text)):\n            if text[i] == char_to_find:\n                indices.append(i)\n        return indices\n\n    # Find all occurrences of character 'c' in string 's'\n    indices = _find_occurrences(s, c)\n    count = len(indices)\n\n    # Convert string to a list of characters for easier modification\n    s_list = list(s)\n\n    if count == 0:\n        # If character 'c' is not found, return the original string\n        return s\n    elif count == 1:\n        # If character 'c' is found exactly once, remove that single occurrence\n        del s_list[indices[0]]\n    else: # count >= 2\n        # If character 'c' is found two or more times, remove the last occurrence first,\n        # then the first occurrence to avoid index shifting issues.\n        del s_list[indices[-1]]\n        del s_list[indices[0]]\n\n    # Join the list of characters back into a string and return\n    return \"\".join(s_list)"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List\n\nclass IntegerList:\n    \"\"\"Represents a list of integers.\"\"\"\n    def __init__(self, values: list):\n        self.values = values\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.values)\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the list is empty.\"\"\"\n        return self.length() == 0\n\nclass ResultList:\n    \"\"\"Represents a list of results, with sorting capabilities.\"\"\"\n    def __init__(self, values: list):\n        self.values = values\n\n    def count(self) -> int:\n        \"\"\"Returns the number of elements in the result list.\"\"\"\n        return len(self.values)\n\n    def sortDescending(self) -> list:\n        \"\"\"Returns a new list sorted in descending order.\"\"\"\n        return sorted(self.values, reverse=True)\n\nclass InputValidator:\n    \"\"\"Validates input parameters and normalizes n.\"\"\"\n    def validateList(self, values):\n        \"\"\"Validates if 'values' is a list of integers.\"\"\"\n        if not isinstance(values, list):\n            raise ValueError(\"Input 'values' must be a list.\")\n        for item in values:\n            if not isinstance(item, int):\n                raise ValueError(\"All items in 'values' must be integers.\")\n\n    def validateN(self, n):\n        \"\"\"Validates if 'n' is an integer.\"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"Input 'n' must be an integer.\")\n\n    def normalizeN(self, n: int, length: int) -> int:\n        \"\"\"Normalizes 'n' for edge cases (n <= 0 or n > length).\"\"\"\n        if n <= 0:\n            return 0\n        if n > length:\n            return length\n        return n\n\nclass HeapQueueLargest:\n    \"\"\"Encapsulates algorithms for finding n largest elements.\"\"\"\n    def heap_queue_largest(self, values: list, n: int) -> list:\n        \"\"\"Selects the n largest elements using an appropriate strategy.\"\"\"\n        if n == 0:\n            return []\n        \n        # Strategy selection heuristic: if n is significantly smaller than list length,\n        # heap method (O(m log n)) is generally faster. Otherwise, sorting the list (O(m log m))\n        # and slicing can be simpler and sometimes more efficient for larger n.\n        if n < len(values) / 2:\n            selected_values = self.selectUsingHeap(values, n)\n        else:\n            selected_values = self.selectUsingSort(values, n)\n            \n        return selected_values\n\n    def selectUsingHeap(self, values: list, n: int) -> list:\n        \"\"\"Uses a min-heap to find the n largest elements.\"\"\"\n        # heapq.nlargest directly returns the n largest elements in descending order.\n        return heapq.nlargest(n, values)\n\n    def selectUsingSort(self, values: list, n: int) -> list:\n        \"\"\"Sorts the entire list and slices the top n elements.\"\"\"\n        # Sorts a copy of the list in descending order and slices.\n        sorted_values = sorted(values, reverse=True)\n        return sorted_values[:n]\n\ndef heap_queue_largest(values, n) -> List[int]:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n    \"\"\"\n    validator = InputValidator()\n    validator.validateList(values)\n    validator.validateN(n)\n\n    integer_list = IntegerList(values)\n    normalized_n = validator.normalizeN(n, integer_list.length())\n\n    if normalized_n == 0:\n        return []\n\n    # Create a copy of the values list for algorithms to ensure non-mutation of original input.\n    values_copy_for_algorithm = list(values)\n\n    hq_manager = HeapQueueLargest()\n    # The internal heap_queue_largest method returns a list already sorted in descending order.\n    selected_list = hq_manager.heap_queue_largest(values_copy_for_algorithm, normalized_n)\n\n    # Wrap in ResultList and sortDescending to strictly adhere to the design's final step,\n    # ensuring the final output is in descending order.\n    final_result_list = ResultList(selected_list)\n    return final_result_list.sortDescending()"}
{"task_id": "Mbpp/8", "solution": "def square_nums(input_list):\n    \"\"\"\n    Calculates the square of each number in the input list.\n    Returns a new list containing the squared numbers, preserving order.\n    \"\"\"\n    return [num ** 2 for num in input_list]"}
{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix):\n    \"\"\"\n    Sorts a given matrix (list of lists) in ascending order according to the sum of its rows.\n    Each row's content is preserved during sorting.\n    \"\"\"\n    # The design specifies validation and sum calculation services,\n    # but for this function completion, we directly apply the sorting logic.\n    # We use Python's built-in sum() function as the key for sorting,\n    # which calculates the sum of elements for each row.\n    sorted_matrix = sorted(matrix, key=sum)\n    return sorted_matrix"}
