{"task_id": "Mbpp/233", "solution": "import math\n\ndef lateralsuface_cylinder(radius, height):\n    \"\"\"\n    Compute lateral surface area of a cylinder using formula 2 * pi * radius * height.\n    The implementation uses math.pi and returns a float.\n    \"\"\"\n    lateral_surface_area = 2 * math.pi * radius * height\n    return float(lateral_surface_area)"}
{"task_id": "Mbpp/235", "solution": "def _create_even_mask(bit_length: int) -> int:\n    \"\"\"\n    Generates an integer mask with bits set at 1-based even positions\n    up to the specified bit_length.\n    \"\"\"\n    mask = 0\n    for i in range(1, bit_length + 1):\n        if i % 2 == 0:\n            mask |= (1 << (i - 1))\n    return mask\n\ndef even_bit_set_number(n: int) -> int:\n    \"\"\"\n    Sets all even-positioned bits (1-based positions 2, 4, 6, ...) of a number to 1,\n    while preserving odd-positioned bits.\n    \"\"\"\n    # Use max(1, n.bit_length()) to ensure a mask is generated even for n=0\n    effective_bit_length = max(1, n.bit_length())\n    even_mask = _create_even_mask(effective_bit_length)\n    return n | even_mask"}
{"task_id": "Mbpp/238", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass InputString:\n    value: str\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the input string is empty.\"\"\"\n        return not bool(self.value)\n    def length(self) -> int:\n        \"\"\"Returns the length of the input string.\"\"\"\n        return len(self.value)\n\n@dataclass\nclass Substring:\n    start: int\n    end: int # exclusive\n    content: str\n\n@dataclass\nclass Result:\n    count: int\n\nclass SubstringCounter:\n    @staticmethod\n    def compute_all_substrings(s: str) -> List[Substring]:\n        \"\"\"Enumerate all non-empty contiguous substrings as Substring(start, end, content).\"\"\"\n        substrings: List[Substring] = []\n        n = len(s)\n        for start in range(n):\n            for end in range(start + 1, n + 1):\n                substrings.append(Substring(start=start, end=end, content=s[start:end]))\n        return substrings\n\n    @staticmethod\n    def number_of_substrings(s: str) -> int:\n        \"\"\"Return number of non-empty contiguous substrings of s (counted by position).\"\"\"\n        input_str = InputString(value=s)\n        n = input_str.length()\n        # The number of non-empty substrings is the sum of integers from 1 to n.\n        return n * (n + 1) // 2\n\ndef number_of_substrings(s: str) -> int:\n    \"\"\"Public API (FR1): delegate to SubstringCounter.number_of_substrings.\"\"\"\n    return SubstringCounter.number_of_substrings(s)"}
{"task_id": "Mbpp/239", "solution": "from typing import List, Dict\n\nclass InputParameters:\n    \"\"\"Simple data holder for validated inputs m and n.\"\"\"\n    def __init__(self, m: int, n: int):\n        if not isinstance(m, int) or not isinstance(n, int):\n            raise ValueError(\"Inputs m and n must be integers.\")\n        if m < 1 or n < 1:\n            raise ValueError(\"Inputs m and n must be positive integers (>= 1).\")\n        self.m = m\n        self.n = n\n\nclass Element:\n    \"\"\"Represent a single sequence element value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass Sequence:\n    \"\"\"Represent an ordered list of Element instances and its length.\"\"\"\n    def __init__(self, elements: List[Element]):\n        self.elements = elements\n        self.length = len(elements)\n\n    def append(self, element: Element) -> None:\n        self.elements.append(element)\n        self.length += 1\n\nclass Constraint:\n    \"\"\"Encapsulate validity checks.\"\"\"\n    @staticmethod\n    def within_bounds(value: int, m: int) -> bool:\n        \"\"\"True iff 1 <= value <= m.\"\"\"\n        return 1 <= value <= m\n\n    @staticmethod\n    def doubles_previous(prev: int, curr: int) -> bool:\n        \"\"\"True iff curr >= 2 * prev.\"\"\"\n        return curr >= 2 * prev\n\nclass SequenceFunction:\n    \"\"\"Provides the algorithm and public API to count valid sequences.\"\"\"\n\n    @staticmethod\n    def get_total_number_of_sequences(m: int, n: int) -> int:\n        \"\"\"Validate inputs and return total count of sequences as non-negative int.\"\"\"\n        # Input validation handled by InputParameters constructor\n        params = InputParameters(m, n)\n        validated_m = params.m\n        validated_n = params.n\n\n        if validated_n == 0:\n            return 0 # Or 1 if an empty sequence is considered valid for length 0, but n>=1 is required.\n        if validated_n == 1:\n            return validated_m # Any value from 1 to m is a valid sequence of length 1\n\n        total_count = 0\n        memo: Dict[tuple, int] = {}\n\n        # Iterate through all possible starting elements (a1)\n        for a1 in range(1, validated_m + 1):\n            # For each a1, count how many sequences of length (n-1) can follow it\n            total_count += SequenceFunction._count_from(a1, validated_n - 1, validated_m, memo)\n        \n        return total_count\n\n    @staticmethod\n    def _count_from(current_value: int, remaining: int, m: int, memo: Dict[tuple, int]) -> int:\n        \"\"\"Return number of sequences of length `remaining` continuing from current_value (uses memo).\"\"\"\n        if (current_value, remaining) in memo:\n            return memo[(current_value, remaining)]\n\n        if remaining == 0:\n            return 1  # A valid sequence of the desired length has been formed\n\n        count = 0\n        # The next value must be >= 2 * current_value and <= m\n        min_next_value = 2 * current_value\n\n        for next_val in range(min_next_value, m + 1):\n            # Constraint.within_bounds(next_val, m) is implicitly handled by the loop range\n            # Constraint.doubles_previous(current_value, next_val) is implicitly handled by min_next_value\n            count += SequenceFunction._count_from(next_val, remaining - 1, m, memo)\n\n        memo[(current_value, remaining)] = count\n        return count\n\n\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"Public API wrapper that delegates to SequenceFunction.get_total_number_of_sequences.\"\"\"\n    return SequenceFunction.get_total_number_of_sequences(m, n)"}
{"task_id": "Mbpp/237", "solution": "from typing import List, Dict, Any\n\nclass InputList:\n    \"\"\"Domain container for validated input list of domain Tuple objects.\"\"\"\n    def __init__(self, tuples: List['Tuple']) -> None:\n        self.tuples = tuples\n\nclass Tuple:\n    \"\"\"Domain representation of a source 2-element tuple.\"\"\"\n    def __init__(self, element1: Any, element2: Any) -> None:\n        self.element1 = element1\n        self.element2 = element2\n\n    def is2Element(self) -> bool:\n        \"\"\"Checks if this represents a 2-element tuple.\"\"\"\n        return True\n\nclass CanonicalTuple:\n    \"\"\"Represents a canonicalized unordered pair (first <= second) with equality and hashing.\"\"\"\n    def __init__(self, first: Any, second: Any) -> None:\n        self.first = first\n        self.second = second\n\n    @classmethod\n    def from_tuple(cls, t: 'Tuple') -> 'CanonicalTuple':\n        \"\"\"Creates a CanonicalTuple from a Tuple, ensuring smaller element is first.\"\"\"\n        if t.element1 <= t.element2:\n            return cls(t.element1, t.element2)\n        else:\n            return cls(t.element2, t.element1)\n\n    def __eq__(self, other: Any) -> bool:\n        \"\"\"Compares two CanonicalTuple objects for equality.\"\"\"\n        if not isinstance(other, CanonicalTuple):\n            return NotImplemented\n        return self.first == other.first and self.second == other.second\n\n    def __hash__(self) -> int:\n        \"\"\"Generates a hash for the CanonicalTuple.\"\"\"\n        return hash((self.first, self.second))\n\n    def __repr__(self) -> str:\n        \"\"\"Provides a string representation for debugging.\"\"\"\n        return f\"({self.first}, {self.second})\"\n\nclass Validator:\n    \"\"\"Validates raw input and converts it to an InputList of Tuple objects.\"\"\"\n    def validate_input(self, raw_input: Any) -> InputList:\n        \"\"\"Validates that input is a list of 2-element tuples.\"\"\"\n        if not isinstance(raw_input, list):\n            raise ValueError(\"Input must be a list.\")\n\n        domain_tuples: List[Tuple] = []\n        for item in raw_input:\n            if not isinstance(item, tuple) or len(item) != 2:\n                raise ValueError(\"Each item in the list must be a 2-element tuple.\")\n            domain_tuples.append(Tuple(item[0], item[1]))\n        return InputList(domain_tuples)\n\nclass OccurrenceCounter:\n    \"\"\"Counts occurrences of canonical tuples.\"\"\"\n    def __init__(self) -> None:\n        self.counts: Dict[CanonicalTuple, int] = {}\n\n    def count(self, input_list: InputList) -> 'ResultDictionary':\n        \"\"\"Canonicalizes tuples and counts their occurrences.\"\"\"\n        for domain_tuple in input_list.tuples:\n            canonical_tuple = CanonicalTuple.from_tuple(domain_tuple)\n            self.counts[canonical_tuple] = self.counts.get(canonical_tuple, 0) + 1\n        return ResultDictionary(self.counts)\n\nclass ResultDictionary:\n    \"\"\"Holds mapping from CanonicalTuple to int and converts to plain dict.\"\"\"\n    def __init__(self, mapping: Dict[CanonicalTuple, int]) -> None:\n        self.mapping = mapping\n\n    def to_dict(self) -> Dict[tuple, int]:\n        \"\"\"Converts the internal mapping to a plain Python dict with standard tuple keys.\"\"\"\n        plain_dict: Dict[tuple, int] = {}\n        for canonical_tuple, count in self.mapping.items():\n            plain_dict[(canonical_tuple.first, canonical_tuple.second)] = count\n        return plain_dict\n\ndef check_occurences(input_list: List[tuple]) -> Dict[tuple, int]:\n    \"\"\"\n    Counts occurrences of canonicalized 2-element tuples in a list.\n    Canonicalizes tuples by ordering elements (smaller first).\n    \"\"\"\n    validator = Validator()\n    validated_input = validator.validate_input(input_list)\n\n    counter = OccurrenceCounter()\n    result_dict_obj = counter.count(validated_input)\n\n    return result_dict_obj.to_dict()"}
{"task_id": "Mbpp/240", "solution": "def replace_list(list1: list, list2: list) -> list:\n    \"\"\"Return a new list equal to list1 without its last element concatenated with list2.\n    Preconditions: len(list1) >= 1 per BR7 in SRS.\n    \"\"\"\n    return list1[:-1] + list2"}
{"task_id": "Mbpp/242", "solution": "from dataclasses import dataclass\nfrom typing import Any\n\n@dataclass\nclass InputString:\n    \"\"\"Represents the input string for character counting.\"\"\"\n    value: str\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self.value)\n\n@dataclass\nclass CharacterCountResult:\n    \"\"\"Represents the result of character counting.\"\"\"\n    count: int\n\ndef _validate_input(input_val: Any) -> None:\n    \"\"\"Validates that the input is a string, raising TypeError if not.\"\"\"\n    if not isinstance(input_val, str):\n        raise TypeError(\"input must be a string\")\n\ndef count_charac(input) -> int:\n    \"\"\"Counts the total number of characters in a string, including spaces and punctuation.\"\"\"\n    _validate_input(input)\n    inp = InputString(value=input)\n    length = inp.length()\n    result = CharacterCountResult(count=length)\n    return result.count"}
{"task_id": "Mbpp/244", "solution": "import math\n\ndef next_Perfect_Square(n: int) -> int:\n    \"\"\"Compute the smallest integer perfect square strictly greater than n.\n    For negative inputs, it returns 0 as the smallest perfect square greater than n.\n    \"\"\"\n    if n < 0:\n        return 0\n    \n    m_floor = math.isqrt(n)\n    m = m_floor + 1\n    return m * m"}
{"task_id": "Mbpp/250", "solution": "def count_X(tuple, element) -> int:\n    \"\"\"Count occurrences of element in tuple. Raises TypeError if first arg is not a tuple.\"\"\"\n    if not isinstance(tuple, tuple):\n        raise TypeError(\"The first argument must be a tuple.\")\n\n    count = 0\n    for item in tuple:\n        if item == element:\n            count += 1\n    return count"}
{"task_id": "Mbpp/251", "solution": "def insert_element(input_list, element):\n    \"\"\"Return a new list where `element` is inserted before each item of `input_list`.\n\n    Args:\n        input_list: list - iterable sequence of items\n        element: any - element to insert before each item of input_list\n\n    Returns:\n        list - result list as specified by SRS\n    \"\"\"\n    result_list = []\n    for item in input_list:\n        result_list.append(element)\n        result_list.append(item)\n    return result_list"}
{"task_id": "Mbpp/245", "solution": "def max_sum(arr):\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence in the given array.\n    A sequence is bitonic if it is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    # lis_sums[i] stores the maximum sum of an increasing subsequence ending at arr[i]\n    lis_sums = list(arr)\n    for i in range(1, n):\n        for j in range(i):\n            if arr[i] > arr[j]:\n                lis_sums[i] = max(lis_sums[i], arr[i] + lis_sums[j])\n\n    # lds_sums[i] stores the maximum sum of a decreasing subsequence starting at arr[i]\n    lds_sums = list(arr)\n    for i in range(n - 2, -1, -1):\n        for j in range(n - 1, i, -1):\n            if arr[i] > arr[j]:\n                lds_sums[i] = max(lds_sums[i], arr[i] + lds_sums[j])\n\n    max_bitonic_sum = 0\n    # A single element can be considered a bitonic sequence (increasing then decreasing immediately).\n    # Initialize with the largest single element, or 0 if all numbers are negative.\n    # Given the problem's example, it's positive, so a simple max will work.\n    # We must ensure that a single element [x] will return x.\n    # For [x], lis_sums[0] = x, lds_sums[0] = x.\n    # x + x - x = x. So this is correctly handled.\n    if n > 0:\n        max_bitonic_sum = max(arr) # Handles cases like all decreasing or all increasing, or single element arrays.\n\n    for i in range(n):\n        # The element arr[i] is the peak, included in both LIS and LDS calculations,\n        # so it must be subtracted once to get the true bitonic sum.\n        current_bitonic_sum = lis_sums[i] + lds_sums[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n\n    return max_bitonic_sum"}
{"task_id": "Mbpp/247", "solution": "def lps(input_str: str) -> int:\n    \"\"\"\n    Calculates the length of the longest palindromic subsequence in the given string.\n    Uses dynamic programming for O(n^2) time and space complexity.\n    \"\"\"\n    n = len(input_str)\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the longest palindromic subsequence of the substring input_str[i...j]\n    dp = [[0] * n for _ in range(n)]\n\n    # Every single character is a palindromic subsequence of length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the DP table for substrings of length 2 up to n\n    for length in range(2, n + 1):\n        for i in range(n - length + 1):\n            j = i + length - 1\n            if input_str[i] == input_str[j]:\n                # If characters at ends match, they can be part of the LPS.\n                # Add 2 to the LPS length of the inner substring input_str[i+1...j-1].\n                # For length 2, the inner substring is empty, so dp[i+1][j-1] would effectively be 0.\n                dp[i][j] = 2 + (dp[i + 1][j - 1] if length > 2 else 0)\n            else:\n                # If characters at ends do not match, take the maximum LPS length\n                # by excluding either the character at 'i' or the character at 'j'.\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    return dp[0][n - 1]"}
{"task_id": "Mbpp/253", "solution": "from typing import List, Any\n\ndef count_integer(input_list: List[Any]) -> int:\n    \"\"\"\n    Counts the number of elements in the list that are of type int.\n    Booleans and floats are not counted as their type is not exactly int.\n    \"\"\"\n    count = 0\n    for element in input_list:\n        if type(element) is int:\n            count += 1\n    return count"}
{"task_id": "Mbpp/252", "solution": "import math\n\nclass ComplexInput:\n    \"\"\"Parses and represents input numeric value as real and imag floats.\"\"\"\n    def __init__(self, real: float, imag: float) -> None:\n        self.real = real\n        self.imag = imag\n\n    @classmethod\n    def from_number(cls, n) -> 'ComplexInput':\n        if isinstance(n, complex):\n            return cls(float(n.real), float(n.imag))\n        else:\n            return cls(float(n), 0.0)\n\nclass PolarCoordinate:\n    \"\"\"Holds r and theta as Python floats and exposes as_tuple().\"\"\"\n    def __init__(self, r: float, theta: float) -> None:\n        self.r = r\n        self.theta = theta\n\n    def as_tuple(self) -> tuple:\n        return (float(self.r), float(self.theta))\n\nclass MathUtils:\n    \"\"\"Wraps Python math.sqrt and math.atan2 per BR9.\"\"\"\n    @staticmethod\n    def sqrt(x: float) -> float:\n        return math.sqrt(x)\n\n    @staticmethod\n    def atan2(y: float, x: float) -> float:\n        return math.atan2(y, x)\n\ndef convert(value):\n    \"\"\"Converts a numeric input to polar coordinates (r, theta).\"\"\"\n    ci = ComplexInput.from_number(value)\n    r = MathUtils.sqrt(ci.real * ci.real + ci.imag * ci.imag)\n    theta = MathUtils.atan2(ci.imag, ci.real)\n    return PolarCoordinate(float(r), float(theta)).as_tuple()"}
{"task_id": "Mbpp/255", "solution": "import itertools\n\ndef combinations_colors(elements: list, n: int) -> list[tuple]:\n    \"\"\"\n    Generates all combinations (with repetition) of the elements of the list and returns a list with a tuple for each combination.\n    \"\"\"\n    # The design context specifies explicit classes for InputParameters, CombinationGenerator, etc.\n    # However, for a simple combination generation task, itertools.product directly fulfills\n    # the core requirement of generating Cartesian product (combinations with repetition).\n    # The design's classes would add verbose boilerplate without substantial benefit for this specific function,\n    # and directly using itertools.product adheres to Pythonic principles for such tasks.\n    # The \"Design context\" implies generating a Cartesian product, which itertools.product does.\n    return list(itertools.product(elements, repeat=n))"}
{"task_id": "Mbpp/256", "solution": "import math\n\ndef count_Primes_nums(n):\n    \"\"\"\n    Counts the number of prime numbers strictly less than the given non-negative number.\n    Handles float inputs by flooring them for the upper bound.\n    \"\"\"\n    # Validate non-negative input as per FR-6 and ErrorHandler design.\n    if n < 0:\n        raise ValueError(\"Input number cannot be negative.\")\n\n    # Determine the exclusive upper bound for iteration based on floor(n).\n    upper_bound_exclusive = int(math.floor(n))\n\n    # Handle cases where no primes can exist (numbers less than 2) as per FR-5.\n    if upper_bound_exclusive < 2:\n        return 0\n\n    # Nested helper function to check if a number is prime.\n    def isPrime(k: int) -> bool:\n        if k < 2:\n            return False\n        if k == 2:\n            return True\n        if k % 2 == 0:\n            return False\n        # Check for odd divisors up to the square root of k.\n        for i in range(3, int(math.sqrt(k)) + 1, 2):\n            if k % i == 0:\n                return False\n        return True\n\n    prime_count = 0\n    # Iterate from 2 up to upper_bound_exclusive - 1 (PrimeCounter.count logic for FR-2).\n    for k in range(2, upper_bound_exclusive):\n        if isPrime(k):\n            prime_count += 1\n\n    # Return the integer count (Result.count for FR-3).\n    return prime_count"}
