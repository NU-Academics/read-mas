{"task_id": "Mbpp/389", "solution": "class InputValidator:\n    @staticmethod\n    def validate_non_negative_integer(n) -> None:\n        \"\"\"Raises ValueError if n is not an int or n < 0.\"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input 'n' must be non-negative.\")\n\n\nclass LucasCalculator:\n    @staticmethod\n    def compute_iterative(n) -> int:\n        \"\"\"Compute Lucas number iteratively: L0=2, L1=1, Ln = Ln-1 + Ln-2 for n>=2.\"\"\"\n        if n == 0:\n            return 2\n        elif n == 1:\n            return 1\n        \n        prev2, prev1 = 2, 1  # L0, L1\n        for _ in range(2, n + 1):\n            current = prev1 + prev2\n            prev2 = prev1\n            prev1 = current\n        return prev1\n\n\ndef find_lucas(n: int) -> int:\n    \"\"\"\n    find_lucas(n)\n\n    Parameters:\n        n (int): non-negative integer index of the Lucas sequence\n\n    Returns:\n        int: the nth Lucas number (L0 = 2, L1 = 1, Ln = Ln-1 + Ln-2)\n\n    Raises:\n        ValueError: if n is not an int or n < 0\n\n    Behavior/Complexity:\n        Uses an iterative algorithm (O(n) time, O(1) extra space). No recursion.\n    \"\"\"\n    InputValidator.validate_non_negative_integer(n)\n    return LucasCalculator.compute_iterative(n)"}
{"task_id": "Mbpp/390", "solution": "from typing import Any, List\n\ndef add_string(input_list: List[Any], format_string: str) -> List[str]:\n    \"\"\"\n    Applies a format string to all elements in a list.\n    Substitutes '{0}' in format_string with the string representation of each element.\n    \"\"\"\n    result = []\n    for e in input_list:\n        s = str(e)\n        formatted = format_string.replace('{0}', s)\n        result.append(formatted)\n    return result"}
{"task_id": "Mbpp/391", "solution": "from typing import Any, List\n\nclass ValidationError(ValueError):\n    \"\"\"Domain-specific exception for validation failures, subclassing ValueError.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass ListInput:\n    \"\"\"Adapter wrapper around input lists to expose length().\"\"\"\n    def __init__(self, items: list):\n        self.items = items\n\n    def length(self) -> int:\n        return len(self.items)\n\nclass NestedDictionaryEntry:\n    \"\"\"Represents a single mapping entry { key: { innerKey: innerValue } }.\"\"\"\n    def __init__(self, key: Any, innerKey: Any, innerValue: Any):\n        self.key = key\n        self.innerKey = innerKey\n        self.innerValue = innerValue\n\n    def to_dict(self) -> dict:\n        \"\"\"Returns the nested dictionary representation of the entry.\"\"\"\n        return {self.key: {self.innerKey: self.innerValue}}\n\nclass ResultList:\n    \"\"\"Collects NestedDictionaryEntry instances and produces the final list-of-dicts.\"\"\"\n    def __init__(self):\n        self.entries: List[NestedDictionaryEntry] = []\n\n    def append(self, entry: NestedDictionaryEntry) -> None:\n        \"\"\"Adds a NestedDictionaryEntry to the list.\"\"\"\n        self.entries.append(entry)\n\n    def to_list(self) -> List[dict]:\n        \"\"\"Returns the ordered list of dictionary representations of entries.\"\"\"\n        return [entry.to_dict() for entry in self.entries]\n\nclass ConvertListDictionary:\n    \"\"\"Encapsulates validation and conversion algorithm for lists to nested dictionaries.\"\"\"\n    def __init__(self, ids: list, names: list, values: list):\n        self.ids = ids\n        self.names = names\n        self.values = values\n\n    def validate_lengths(self) -> None:\n        \"\"\"Validates that all input lists have equal lengths, raising ValidationError if not.\"\"\"\n        ids_len = len(self.ids)\n        names_len = len(self.names)\n        values_len = len(self.values)\n\n        if not (ids_len == names_len == values_len):\n            raise ValidationError(\"Input lists must have equal lengths.\")\n\n    def execute(self) -> List[dict]:\n        \"\"\"Builds and returns the list of nested dictionaries.\"\"\"\n        result_list = ResultList()\n        num_items = len(self.ids) # Lengths are guaranteed equal by validate_lengths\n\n        for i in range(num_items):\n            entry = NestedDictionaryEntry(self.ids[i], self.names[i], self.values[i])\n            result_list.append(entry)\n        \n        return result_list.to_list()\n\ndef convert_list_dictionary(ids: list, names: list, values: list) -> list:\n    \"\"\"Converts three parallel lists into an ordered list of nested dictionaries.\n    Raises ValueError if input lists have unequal lengths.\n    \"\"\"\n    impl = ConvertListDictionary(ids, names, values)\n    impl.validate_lengths()\n    return impl.execute()"}
{"task_id": "Mbpp/394", "solution": "def has_duplicates(elements: tuple) -> bool:\n    \"\"\"Return True if elements contains duplicates, False otherwise.\"\"\"\n    return len(elements) != len(set(elements))\n\ndef check_distinct(input_tuple: tuple) -> bool:\n    \"\"\"Return True if all items in input_tuple are distinct; return False otherwise.\n    Does not modify input_tuple and is deterministic.\"\"\"\n    return not has_duplicates(input_tuple)"}
{"task_id": "Mbpp/392", "solution": "import collections\n\n_cache = {}\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Computes the maximum sum possible using the recurrence f(n) = max((f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    Uses memoization to avoid redundant computations.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if n == 0:\n        return 0\n    \n    if n in _cache:\n        return _cache[n]\n    \n    # Calculate the sum of recursive calls using integer division\n    sum_subproblems = (\n        get_max_sum(n // 2) +\n        get_max_sum(n // 3) +\n        get_max_sum(n // 4) +\n        get_max_sum(n // 5)\n    )\n    \n    result = max(sum_subproblems, n)\n    _cache[n] = result\n    return result"}
{"task_id": "Mbpp/395", "solution": "from typing import Dict\n\n\nclass StringInput:\n    \"\"\"A lightweight wrapper around the input string, providing a length helper.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated string.\"\"\"\n        return len(self.value)\n\n\nclass FrequencyMap:\n    \"\"\"Maintains counts for each character seen in the input string.\"\"\"\n    def __init__(self) -> None:\n        self.map: Dict[str, int] = {}\n\n    def increment(self, char: str) -> None:\n        \"\"\"Increments the count for a given character.\"\"\"\n        self.map[char] = self.map.get(char, 0) + 1\n\n    def get(self, char: str) -> int:\n        \"\"\"Returns the frequency count for a character, or 0 if not present.\"\"\"\n        return self.map.get(char, 0)\n\n\nclass FirstNonRepeatingResult:\n    \"\"\"Data holder for the result of the non-repeating character computation.\"\"\"\n    def __init__(self, char: str | None) -> None:\n        self.char = char\n\n\ndef first_non_repeating_character(s: str) -> str | None:\n    \"\"\"\n    Finds the first non-repeated character in a given string.\n    It computes character frequency and then scans the original string order.\n    \"\"\"\n    string_input = StringInput(s)\n    \n    # If the input string is empty, there's no non-repeating character.\n    if string_input.length() == 0:\n        return FirstNonRepeatingResult(None).char\n\n    frequency_map = FrequencyMap()\n\n    # Populate the frequency map by iterating through the input string.\n    for char in string_input.value:\n        frequency_map.increment(char)\n\n    # Scan the original string in order to find the first character with a frequency of 1.\n    for char in string_input.value:\n        if frequency_map.get(char) == 1:\n            return FirstNonRepeatingResult(char).char\n\n    # If no non-repeating character is found after scanning the entire string.\n    return FirstNonRepeatingResult(None).char"}
{"task_id": "Mbpp/397", "solution": "class MedianCalculator:\n    \"\"\"Encapsulates the median computation algorithm for three numbers.\"\"\"\n\n    @staticmethod\n    def median_numbers(a, b, c) -> float:\n        \"\"\"\n        Computes the median of three numeric values.\n        \"\"\"\n        numbers = sorted([a, b, c])\n        return float(numbers[1])\n\ndef median_numbers(a, b, c) -> float:\n    \"\"\"\n    Finds the median of three numbers by delegating to MedianCalculator.\n    \"\"\"\n    return MedianCalculator.median_numbers(a, b, c)"}
