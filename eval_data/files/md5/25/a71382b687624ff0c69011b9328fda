{"task_id": "Mbpp/119", "solution": "from collections import Counter\n\ndef _is_sorted(seq: list[int]) -> bool:\n    \"\"\"Checks if the list is sorted non-decreasingly.\"\"\"\n    for i in range(len(seq) - 1):\n        if seq[i] > seq[i+1]:\n            return False\n    return True\n\ndef _validate_pairing(seq: list[int]) -> None:\n    \"\"\"Validates frequency: exactly one singleton, all others appear twice.\"\"\"\n    if not seq:\n        raise ValueError(\"Input list cannot be empty for pairing validation.\")\n    \n    counts = Counter(seq)\n    \n    singletons = 0\n    for val_count in counts.values():\n        if val_count == 1:\n            singletons += 1\n        elif val_count != 2:\n            raise ValueError(\"Frequency distribution rule violated: elements must appear once or twice.\")\n            \n    if singletons != 1:\n        raise ValueError(\"Frequency distribution rule violated: exactly one element must appear once.\")\n\ndef search(input_list: list[int]) -> int:\n    \"\"\"Finds the element that appears only once in a sorted array.\"\"\"\n    if not _is_sorted(input_list):\n        raise ValueError(\"Input list is not sorted.\")\n    \n    _validate_pairing(input_list)\n    \n    for i in range(0, len(input_list) - 1, 2):\n        if input_list[i] != input_list[i+1]:\n            return input_list[i]\n            \n    return input_list[-1]"}
{"task_id": "Mbpp/120", "solution": "from typing import List, Union, Tuple\nfrom numbers import Number\n\nclass TuplePair:\n    \"\"\"Encapsulates a two-number pair and provides product computation.\"\"\"\n    def __init__(self, a: float, b: float) -> None:\n        if not isinstance(a, Number) or not isinstance(b, Number):\n            raise TypeError(\"TuplePair elements must be numeric.\")\n        self._a = float(a)\n        self._b = float(b)\n\n    def product(self) -> float:\n        \"\"\"Returns the product of the two numbers.\"\"\"\n        return self._a * self._b\n\nclass ProductComputation:\n    \"\"\"Provides computation utilities for abs product and maximum across a list.\"\"\"\n    def compute_abs_product(self, tp: TuplePair) -> float:\n        \"\"\"Computes the absolute product of a TuplePair.\"\"\"\n        return abs(tp.product())\n\n    def max_abs_product(self, list_of_tp: List[TuplePair]) -> float:\n        \"\"\"Computes the maximum absolute product across a list of TuplePair objects.\"\"\"\n        max_prod = float('-inf')\n        for tp in list_of_tp:\n            max_prod = max(max_prod, self.compute_abs_product(tp))\n        return max_prod\n\nclass Result:\n    \"\"\"Container for a returned numeric value.\"\"\"\n    def __init__(self, value: float) -> None:\n        self._value = value\n\n    def value(self) -> float:\n        \"\"\"Returns the contained numeric value.\"\"\"\n        return self._value\n\ndef max_product_tuple(input_list: list) -> float:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    Validates input elements and raises errors for invalid types or an empty list.\n    \"\"\"\n    if not input_list:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    processed_pairs: List[TuplePair] = []\n    for item in input_list:\n        if isinstance(item, TuplePair):\n            processed_pairs.append(item)\n        elif isinstance(item, (tuple, list)):\n            if len(item) == 2 and all(isinstance(x, Number) for x in item):\n                processed_pairs.append(TuplePair(item[0], item[1]))\n            else:\n                raise ValueError(\n                    f\"Each element (if not TuplePair) must be a 2-element sequence of numeric values. Invalid element: {item}\"\n                )\n        else:\n            raise TypeError(\n                f\"Each element must be a TuplePair or a 2-element sequence (tuple/list). Invalid element type: {type(item)}\"\n            )\n\n    computation = ProductComputation()\n    max_prod_val = computation.max_abs_product(processed_pairs)\n    \n    return Result(max_prod_val).value()"}
{"task_id": "Mbpp/125", "solution": "class Validator:\n    \"\"\"\n    Stateless validator for binary strings.\n    \"\"\"\n    @staticmethod\n    def isBinary(s: str) -> bool:\n        \"\"\"Checks if a string contains only '0's and '1's.\"\"\"\n        return all(c in ('0', '1') for c in s)\n\nclass BinaryString:\n    \"\"\"\n    Encapsulates the original input string.\n    \"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the binary string.\"\"\"\n        return len(self.value)\n\nclass Substring:\n    \"\"\"\n    Represents a contiguous substring and provides counts/difference.\n    \"\"\"\n    def __init__(self, full_string_value: str, start: int, end: int):\n        self.start = start\n        self.end = end\n        self.value = full_string_value[start : end + 1]\n\n    def zeroCount(self) -> int:\n        \"\"\"Counts the number of '0's in the substring.\"\"\"\n        return self.value.count('0')\n\n    def oneCount(self) -> int:\n        \"\"\"Counts the number of '1's in the substring.\"\"\"\n        return self.value.count('1')\n\n    def difference(self) -> int:\n        \"\"\"Calculates the difference: zeroCount - oneCount.\"\"\"\n        return self.zeroCount() - self.oneCount()\n\ndef find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and number of 1s\n    in any sub-string of the given binary string.\n    \"\"\"\n    if not Validator.isBinary(s):\n        raise ValueError(\"input contains non-binary characters\")\n\n    if not s:\n        return 0\n\n    max_difference = -float('inf')\n\n    bs = BinaryString(value=s)\n    n = bs.length()\n\n    for i in range(n):\n        for j in range(i, n):\n            sub = Substring(bs.value, i, j)\n            diff = sub.difference()\n            if diff > max_difference:\n                max_difference = diff\n                \n    return max_difference"}
{"task_id": "Mbpp/123", "solution": "import math\n\nclass InputValidator:\n    \"\"\"Validates input parameters for amicable number calculations.\"\"\"\n    def validate_n(self, n):\n        \"\"\"Validates that n is an integer greater than or equal to 1.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if n < 1:\n            raise ValueError(\"Input 'n' must be greater than or equal to 1.\")\n\nclass NumberUtils:\n    \"\"\"Provides utility methods for number theory calculations.\"\"\"\n    def proper_divisors(self, x: int) -> list[int]:\n        \"\"\"Returns a list of proper divisors for a given number x.\"\"\"\n        if x <= 1:\n            return []\n        divs = [1]\n        for i in range(2, int(math.sqrt(x)) + 1):\n            if x % i == 0:\n                divs.append(i)\n                if i * i != x:\n                    divs.append(x // i)\n        return divs\n\n    def sum_proper_divisors(self, x: int) -> int:\n        \"\"\"Calculates the sum of proper divisors for a given number x.\"\"\"\n        if x <= 1:\n            return 0\n        return sum(self.proper_divisors(x))\n\nclass AmicableService:\n    \"\"\"Orchestrates the calculation and summation of amicable numbers.\"\"\"\n    def __init__(self):\n        self._divisor_sum_store = {}\n\n    def amicable_numbers_sum(self, n: int) -> int:\n        \"\"\"\n        Computes the sum of all amicable numbers up to n.\n        It validates input, calculates divisor sums, identifies amicable pairs, and sums them.\n        \"\"\"\n        InputValidator().validate_n(n)\n        number_utils = NumberUtils()\n\n        # Compute and store divisor sums for all numbers from 1 to n\n        for i in range(1, n + 1):\n            self._divisor_sum_store[i] = number_utils.sum_proper_divisors(i)\n\n        unique_amicables = set()\n\n        # Identify amicable pairs\n        for a in range(1, n + 1):\n            sum_a = self._divisor_sum_store[a]\n\n            # Exclude perfect numbers\n            if sum_a == a:\n                continue\n\n            b = sum_a\n            \n            # Check if b forms an amicable pair with a\n            if 1 <= b <= n and self._divisor_sum_store.get(b) == a:\n                unique_amicables.add(a)\n                unique_amicables.add(b)\n\n        return sum(unique_amicables)\n\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"\n    Sums all amicable numbers from 1 to a specified number.\n    This is a public wrapper for the AmicableService.\n    \"\"\"\n    return AmicableService().amicable_numbers_sum(n)"}
{"task_id": "Mbpp/124", "solution": "import math\n\nclass ComplexNumber:\n    \"\"\"Holds normalized real and imaginary components as floats.\"\"\"\n    def __init__(self, real: float, imag: float):\n        self._real = float(real)\n        self._imag = float(imag)\n\n    def to_tuple(self) -> (float, float):\n        \"\"\"Returns the real and imaginary parts as a tuple.\"\"\"\n        return (self._real, self._imag)\n\nclass InputValidator:\n    \"\"\"Validates and normalizes input forms into (real, imag) floats.\"\"\"\n    @staticmethod\n    def is_numeric(value) -> bool:\n        \"\"\"Returns True if value is int, float, or complex and is finite.\"\"\"\n        if isinstance(value, (int, float)):\n            return math.isfinite(value)\n        elif isinstance(value, complex):\n            return math.isfinite(value.real) and math.isfinite(value.imag)\n        return False\n\n    @staticmethod\n    def normalize_input(a, b) -> (float, float):\n        \"\"\"\n        Normalizes two inputs (a, b) into a single (real, imag) float tuple.\n        Prioritizes complex types: if `a` is complex, its parts are used;\n        else if `b` is complex, its parts are used; else, `a` is real and `b` is imag.\n        \"\"\"\n        final_real = 0.0\n        final_imag = 0.0\n\n        if isinstance(a, complex):\n            final_real = a.real\n            final_imag = a.imag\n        elif isinstance(b, complex):\n            final_real = b.real\n            final_imag = b.imag\n        else: # Assume a and b are numeric types (int/float)\n            final_real = float(a)\n            final_imag = float(b)\n\n        return final_real, final_imag\n\nclass AngleCalculator:\n    \"\"\"Computes the principal argument using atan2(imag, real).\"\"\"\n    def angle_complex(self, a, b) -> float:\n        \"\"\"\n        Validates/normalizes inputs via InputValidator, constructs ComplexNumber,\n        computes atan2(imag, real) and returns the float angle.\n        \"\"\"\n        real, imag = InputValidator.normalize_input(a, b)\n        cn = ComplexNumber(real, imag)\n        r, i = cn.to_tuple()\n        return self._compute_atan2(i, r)\n\n    def _compute_atan2(self, y: float, x: float) -> float:\n        \"\"\"Private wrapper around math.atan2.\"\"\"\n        return math.atan2(y, x)\n\ndef angle_complex(a, b) -> float:\n    \"\"\"\n    Public API to compute the angle of a complex number from inputs a and b.\n    Delegates to AngleCalculator for core logic.\n    \"\"\"\n    return AngleCalculator().angle_complex(a, b)"}
