{"task_id": "Mbpp/79", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass Word:\n    \"\"\"Represents an input word and provides its length.\"\"\"\n    text: str\n\n    def length(self) -> int:\n        \"\"\"Computes and returns the length of the word's text.\"\"\"\n        return len(self.text)\n\n@dataclass\nclass Result:\n    \"\"\"Carries the boolean result indicating if the length is odd.\"\"\"\n    is_odd: bool\n\nclass WordLenFunction:\n    \"\"\"Implements the algorithm to check if a word's length is odd.\"\"\"\n    name: str = \"word_len\"\n    language: str = \"Python\"\n\n    def evaluate(self, word_text: str) -> bool:\n        \"\"\"Determines if the length of the given word_text is odd.\"\"\"\n        length = len(word_text)\n        is_odd = (length % 2 == 1)\n        # The design indicates returning a boolean directly from evaluate,\n        # rather than a Result object, simplifying the interface.\n        return is_odd\n\ndef word_len(word: str) -> bool:\n    \"\"\"Checks whether the length of the given word is odd.\"\"\"\n    # Delegates the core logic to an instance of WordLenFunction.\n    function_service = WordLenFunction()\n    return function_service.evaluate(word)"}
