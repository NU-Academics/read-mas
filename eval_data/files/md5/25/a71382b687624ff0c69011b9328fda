{"task_id": "Mbpp/446", "solution": "def count_Occurrence(tuple_input, list_input):\n    \"\"\"Accepts two parameters: the first a tuple, the second a list; returns an int count of occurrences where tuple elements == any list element.\"\"\"\n    occurrence_count = 0\n    for element in tuple_input:\n        if element in list_input:\n            occurrence_count += 1\n    return occurrence_count"}
{"task_id": "Mbpp/440", "solution": "import re\nfrom typing import List, Optional\n\nclass Punctuation:\n    \"\"\"Defines punctuation characters and provides a method to strip them.\"\"\"\n    CHARS = '!\"#$%&\\'()*+,-./:;<=>?@[\\\\]^_`{|}~'\n\n    @staticmethod\n    def strip(text: str) -> str:\n        \"\"\"Removes leading and trailing punctuation from a string.\"\"\"\n        return text.strip(Punctuation.CHARS)\n\nclass Normalizer:\n    \"\"\"Normalizes text by stripping leading/trailing punctuation.\"\"\"\n    @staticmethod\n    def normalize(raw_text: str) -> str:\n        \"\"\"Applies punctuation stripping to the raw text.\"\"\"\n        return Punctuation.strip(raw_text)\n\nclass Token:\n    \"\"\"Represents a token with its span, raw text, normalized text, and adverb status.\"\"\"\n    def __init__(self, start_index: int, end_index: int, raw_text: str):\n        self.start_index = start_index\n        self.end_index = end_index\n        self.raw_text = raw_text\n        self.normalized_text: Optional[str] = None\n        self.is_adverb: Optional[bool] = None\n\nclass Tokenizer:\n    \"\"\"Splits text into raw token spans with start/end indices.\"\"\"\n    @staticmethod\n    def tokenize(text: str) -> List[Token]:\n        \"\"\"Tokenizes the input text, capturing raw text and its original span.\"\"\"\n        tokens = []\n        for match in re.finditer(r'\\S+', text): # Find sequences of non-whitespace characters\n            start, end = match.span()\n            raw_text = match.group(0)\n            tokens.append(Token(start, end, raw_text))\n        return tokens\n\nclass Sentence:\n    \"\"\"Encapsulates raw sentence text and provides tokenization.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def tokenize(self) -> List[Token]:\n        \"\"\"Delegates to Tokenizer to split the sentence into tokens.\"\"\"\n        return Tokenizer.tokenize(self.text)\n\nclass POSTagger:\n    \"\"\"Abstract interface for part-of-speech tagging, specifically for adverb identification.\"\"\"\n    def is_adverb(self, normalized_text: str) -> bool:\n        \"\"\"Determines if the given normalized text is an adverb.\"\"\"\n        raise NotImplementedError\n\nclass POSTaggerStub(POSTagger):\n    \"\"\"A placeholder POSTagger implementation for testing, treating -ly words as adverbs.\"\"\"\n    def is_adverb(self, normalized_text: str) -> bool:\n        \"\"\"Identifies adverbs using a simple rule: ends with 'ly' and is not too short.\"\"\"\n        return len(normalized_text) > 2 and normalized_text.endswith('ly')\n\nclass AdverbResult:\n    \"\"\"Container for the details of a found adverb.\"\"\"\n    def __init__(self, start_index: int, end_index: int, adverb: str):\n        self.start_index = start_index\n        self.end_index = end_index\n        self.adverb = adverb\n\nclass AdverbFinder:\n    \"\"\"Scans tokens to find the first adverb using a POSTagger.\"\"\"\n    def __init__(self, pos_tagger: POSTagger):\n        self.pos_tagger = pos_tagger\n\n    def find_adverb_position(self, sentence_obj: Sentence) -> Optional[AdverbResult]:\n        \"\"\"Finds the first adverb in the sentence, adjusting indices for normalization.\"\"\"\n        tokens = sentence_obj.tokenize()\n        for token in tokens:\n            normalized_text = Normalizer.normalize(token.raw_text)\n            token.normalized_text = normalized_text\n\n            if self.pos_tagger.is_adverb(normalized_text):\n                token.is_adverb = True\n                \n                # Calculate adjusted start_index by accounting for removed leading punctuation.\n                num_leading_punct = len(token.raw_text) - len(token.raw_text.lstrip(Punctuation.CHARS))\n                adjusted_start_index = token.start_index + num_leading_punct\n                \n                # The adjusted end_index is simply the new start plus the length of the normalized text.\n                adjusted_end_index = adjusted_start_index + len(normalized_text)\n                \n                return AdverbResult(adjusted_start_index, adjusted_end_index, normalized_text)\n            else:\n                token.is_adverb = False\n        return None\n\ndef find_adverb_position(sentence_str: str) -> Optional[tuple]:\n    \"\"\"\n    Finds the first adverb and its positions (start, end) in a given sentence.\n    Returns (start_index, end_index, adverb) or None if no adverb is found.\n    \"\"\"\n    pos_tagger = POSTaggerStub()\n    adverb_finder = AdverbFinder(pos_tagger)\n    sentence_obj = Sentence(sentence_str)\n\n    result = adverb_finder.find_adverb_position(sentence_obj)\n\n    if result:\n        return (result.start_index, result.end_index, result.adverb)\n    else:\n        return None"}
{"task_id": "Mbpp/445", "solution": "def _validate_outer_length(a, b):\n    \"\"\"\n    Validates that the outer tuples a and b have the same length.\n    Raises ValueError if lengths differ.\n    \"\"\"\n    if len(a) != len(b):\n        raise ValueError(f\"Outer tuple lengths differ: len(a)={len(a)}, len(b)={len(b)}\")\n\ndef _validate_inner_lengths(a, b):\n    \"\"\"\n    Validates that corresponding inner tuples in a and b have the same length.\n    Raises ValueError if any inner tuple pair lengths differ.\n    \"\"\"\n    for i in range(len(a)):\n        if len(a[i]) != len(b[i]):\n            raise ValueError(f\"Inner tuple length mismatch at index {i}: len(a[{i}])={len(a[i])}, len(b[{i}])={len(b[i])}\")\n\ndef _validate_numeric_elements(a, b):\n    \"\"\"\n    Validates that all elements in both tuples are numeric (int or float).\n    Raises TypeError if a non-numeric element is found.\n    \"\"\"\n    for i in range(len(a)):\n        for j in range(len(a[i])):\n            val_a = a[i][j]\n            val_b = b[i][j]\n            if not isinstance(val_a, (int, float)):\n                raise TypeError(f\"Non-numeric element at index ({i},{j}): value={val_a} type={type(val_a).__name__}\")\n            if not isinstance(val_b, (int, float)):\n                raise TypeError(f\"Non-numeric element at index ({i},{j}): value={val_b} type={type(val_b).__name__}\")\n\ndef _compute_products(a, b):\n    \"\"\"\n    Computes the element-wise product of corresponding elements in a and b.\n    Returns the results as a tuple of tuples.\n    \"\"\"\n    result = []\n    for i in range(len(a)):\n        inner_result = []\n        for j in range(len(a[i])):\n            inner_result.append(a[i][j] * b[i][j])\n        result.append(tuple(inner_result))\n    return tuple(result)\n\ndef index_multiplication(a, b) -> tuple:\n    \"\"\"\n    Performs index-wise multiplication of tuple elements from two given tuples of tuples.\n    It validates input lengths and element types before computing products.\n    \"\"\"\n    _validate_outer_length(a, b)\n    _validate_inner_lengths(a, b)\n    _validate_numeric_elements(a, b)\n    return _compute_products(a, b)"}
{"task_id": "Mbpp/447", "solution": "def cube_nums(input_list):\n    \"\"\"\n    Computes the cube of each numeric element in a list, validating inputs.\n    Returns a new list with the cubed values, preserving order.\n    \"\"\"\n    if not isinstance(input_list, (list, tuple)):\n        raise TypeError(\"input must be a list or sequence\")\n\n    for item in input_list:\n        if not isinstance(item, (int, float)):\n            raise ValueError(\"all elements must be numeric\")\n\n    return [x ** 3 for x in input_list]"}
{"task_id": "Mbpp/448", "solution": "class ErrorResult:\n    \"\"\"Represents an explicit error with a non-zero code and descriptive message.\"\"\"\n    def __init__(self, code: int, message: str):\n        self.code = code\n        self.message = message\n\nclass InputParameter:\n    \"\"\"Encapsulates and validates an input parameter n.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def validate(self) -> bool:\n        \"\"\"Returns True if n is an integer and n >= 0; otherwise False.\"\"\"\n        return isinstance(self.n, int) and self.n >= 0\n\n# A cache for Perrin numbers used by PerrinNumber.compute\n_perrin_cache = {}\n\nclass PerrinNumber:\n    \"\"\"Represents a single Perrin term (index and value) and computes a single term.\"\"\"\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\n\n    @staticmethod\n    def compute(index: int) -> int:\n        \"\"\"Computes the Perrin number for a given index using memoization.\"\"\"\n        if index < 0:\n            raise ValueError(\"Perrin index cannot be negative\")\n        if index in _perrin_cache:\n            return _perrin_cache[index]\n\n        if index == 0:\n            result = 3\n        elif index == 1:\n            result = 0\n        elif index == 2:\n            result = 2\n        else:\n            result = PerrinNumber.compute(index - 2) + PerrinNumber.compute(index - 3)\n\n        _perrin_cache[index] = result\n        return result\n\nclass PerrinSequence:\n    \"\"\"Generates the list of PerrinNumber terms for indices 0..n inclusive.\"\"\"\n    def __init__(self):\n        self.terms: list[PerrinNumber] = []\n\n    def generate(self, n: int) -> list[PerrinNumber]:\n        \"\"\"Generates and returns a list of PerrinNumber instances for 0..n.\"\"\"\n        self.terms = []\n        for i in range(n + 1):\n            value = PerrinNumber.compute(i)\n            self.terms.append(PerrinNumber(i, value))\n        return self.terms\n\nclass CalculationResult:\n    \"\"\"Computes inclusive sum P(0)+...+P(n) from provided PerrinNumber terms and holds the sum.\"\"\"\n    def __init__(self):\n        self.sum: int = 0\n\n    def computeSum(self, terms: list[PerrinNumber]) -> int:\n        \"\"\"Computes and returns the sum of values from a list of PerrinNumber terms.\"\"\"\n        self.sum = sum(term.value for term in terms)\n        return self.sum\n\ndef cal_sum(n):\n    \"\"\"Public API. Validates input, generates Perrin sequence, sums terms, and returns the integer sum or an ErrorResult on invalid input.\"\"\"\n    ip = InputParameter(n)\n    if not ip.validate():\n        return ErrorResult(code=1, message=\"invalid input: n must be integer >= 0\")\n\n    seq = PerrinSequence()\n    terms = seq.generate(n)\n\n    result = CalculationResult()\n    total = result.computeSum(terms)\n    return total"}
{"task_id": "Mbpp/451", "solution": "_WHITESPACE_CHARS = (' ', '\\t', '\\n', '\\r', '\\v', '\\f')\n\ndef is_whitespace(c: str) -> bool:\n    \"\"\"Helper to classify a single character as whitespace per _WHITESPACE_CHARS.\"\"\"\n    return c in _WHITESPACE_CHARS\n\ndef remove_whitespaces(input: str) -> str:\n    \"\"\"Return a new string with all whitespace characters removed; preserve order and case.\"\"\"\n    result_chars = []\n    for char in input:\n        if not is_whitespace(char):\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/450", "solution": "class ExtractStringService:\n    def extract(self, strings: list, size: int) -> list:\n        \"\"\"\n        Validate inputs and return a new list of strings where len(s) == size.\n\n        Returns: list[str] (new list)\n        \"\"\"\n        if not isinstance(strings, list):\n            raise TypeError(\"First parameter 'strings' must be a list.\")\n\n        if not isinstance(size, int):\n            raise TypeError(\"Second parameter 'size' must be an integer.\")\n\n        if size < 0:\n            raise ValueError(\"Second parameter 'size' cannot be negative.\")\n\n        for s in strings:\n            if not isinstance(s, str):\n                raise TypeError(\"All elements in 'strings' list must be strings.\")\n\n        result = []\n        for s in strings:\n            if len(s) == size:\n                result.append(s)\n        return result\n\ndef extract_string(strings, size):\n    \"\"\"Top-level callable required by SRS that delegates to ExtractStringService.extract.\"\"\"\n    service = ExtractStringService()\n    return service.extract(strings, size)"}
{"task_id": "Mbpp/453", "solution": "class Number:\n    \"\"\"Represents an integer and provides basic predicates.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isPositive(self) -> bool:\n        \"\"\"Checks if the number is positive.\"\"\"\n        return self.value > 0\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the number is even.\"\"\"\n        return self.value % 2 == 0\n\nclass Factor:\n    \"\"\"Represents a positive divisor and provides an evenness predicate.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the factor is even.\"\"\"\n        return self.value % 2 == 0\n\nclass SumOfFactorsService:\n    \"\"\"Encapsulates computation of positive divisors, filtering to even divisors, and summation.\"\"\"\n\n    def sumofFactors(self, n: int) -> int:\n        \"\"\"Primary operation computing and returning the sum of even positive divisors of n.\"\"\"\n        factors = self.getFactors(n)\n        even_factors = self.filterEven(factors)\n        total_sum = self.sum(even_factors)\n        return total_sum\n\n    def getFactors(self, n: int) -> list[Factor]:\n        \"\"\"Compute and return a list of Factor objects (all positive divisors).\"\"\"\n        factors = []\n        # Compute positive divisors of abs(n).\n        if n == 0:\n            return []\n        \n        abs_n = abs(n)\n        for i in range(1, abs_n + 1):\n            if abs_n % i == 0:\n                factors.append(Factor(i))\n        return factors\n\n    def filterEven(self, factors: list[Factor]) -> list[Factor]:\n        \"\"\"Filter a list of Factor objects to only even ones.\"\"\"\n        even_factors = [factor for factor in factors if factor.isEven()]\n        return even_factors\n\n    def sum(self, factors: list[Factor]) -> int:\n        \"\"\"Sum factor values; return 0 when list is empty.\"\"\"\n        if not factors:\n            return 0\n        return sum(factor.value for factor in factors)\n\ndef sumofFactors(n: int) -> int:\n    \"\"\"Finds the sum of even positive factors of a number.\"\"\"\n    service = SumOfFactorsService()\n    return service.sumofFactors(n)"}
{"task_id": "Mbpp/455", "solution": "class ValidationError(ValueError):\n    def __init__(self, message: str = None) -> None:\n        super().__init__(message or \"Invalid month input\")\n\nclass Month:\n    def __init__(self, month_number: int) -> None:\n        self._month_number = month_number\n\n    def has31Days(self) -> bool:\n        \"\"\"Returns True if the month has 31 days, False otherwise.\"\"\"\n        return self._month_number in {1, 3, 5, 7, 8, 10, 12}\n\nclass MonthChecker:\n    _MONTHS_WITH_31: set[int] = {1, 3, 5, 7, 8, 10, 12}\n\n    @staticmethod\n    def check_monthnumb_number(month) -> bool:\n        \"\"\"Validates input and delegates to Month to check for 31 days.\"\"\"\n        if not isinstance(month, int):\n            raise ValidationError(\"Month must be an integer.\")\n        \n        if not (1 <= month <= 12):\n            raise ValidationError(\"Month must be between 1 and 12 (inclusive).\")\n        \n        m = Month(month)\n        return m.has31Days()\n\ndef check_monthnumb_number(month) -> bool:\n    \"\"\"Checks whether the given month number contains 31 days or not.\"\"\"\n    return MonthChecker.check_monthnumb_number(month)"}
{"task_id": "Mbpp/456", "solution": "from typing import List\n\ndef reverse_string_list(input_list: List[str]) -> List[str]:\n    \"\"\"Return a list where each element is the character-wise reversal of the corresponding input string.\n\n    Preserves input order and handles empty input by returning an empty list.\n    \"\"\"\n    return [s[::-1] for s in input_list]"}
{"task_id": "Mbpp/454", "solution": "import re\nfrom dataclasses import dataclass\nfrom typing import List, Optional\n\n@dataclass\nclass Word:\n    \"\"\"Domain token representing a contiguous ASCII letters/digits sequence.\"\"\"\n    text: str\n\n    def hasZ(self) -> bool:\n        \"\"\"Returns True if 'z' is present in self.text (case-insensitive).\"\"\"\n        return 'z' in self.text.lower()\n\nclass WordTokenizer:\n    \"\"\"Tokenizes text into List[Word] using contiguous ASCII letters/digits as tokens.\"\"\"\n    _TOKEN_PATTERN = re.compile(r\"[A-Za-z0-9]+\")\n\n    def tokenize(self, text: str) -> List[Word]:\n        \"\"\"Extracts words from text based on ASCII letters/digits pattern.\"\"\"\n        return [Word(match) for match in self._TOKEN_PATTERN.findall(text)]\n\nclass TextProcessor:\n    \"\"\"Orchestrates tokenization, normalization, and detection of 'z'.\"\"\"\n    def __init__(self, tokenizer: Optional[WordTokenizer] = None):\n        self.tokenizer = tokenizer or WordTokenizer()\n\n    def text_match_wordz(self, text: str) -> bool:\n        \"\"\"Processes text to detect if any word contains 'z'.\"\"\"\n        tokens = self.tokenizer.tokenize(text)\n        for token in tokens:\n            if token.hasZ():\n                return True\n        return False\n\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"Matches a word containing 'z' in the input text.\"\"\"\n    processor = TextProcessor()\n    return processor.text_match_wordz(text)"}
{"task_id": "Mbpp/457", "solution": "def validate_input(input):\n    \"\"\"\n    Validates the input to Find_Min, ensuring it's a non-empty list of sequences.\n    \"\"\"\n    if not isinstance(input, list):\n        raise TypeError(\"input must be a list\")\n    if not input:\n        raise ValueError(\"input list must not be empty\")\n    for item in input:\n        if not isinstance(item, (list, tuple)):\n            raise TypeError(\"each item of input must be a list/sequence\")\n\ndef compute_min(sublists):\n    \"\"\"\n    Finds the first sublist with the minimum length from a list of sublists.\n    \"\"\"\n    min_length = float('inf')\n    min_sublist = None\n\n    for sublist in sublists:\n        if len(sublist) < min_length:\n            min_length = len(sublist)\n            min_sublist = sublist\n    return min_sublist\n\ndef Find_Min(input):\n    \"\"\"\n    Finds the sublist having the minimum length from a list of sublists.\n    \"\"\"\n    validate_input(input)\n    return compute_min(input)"}
