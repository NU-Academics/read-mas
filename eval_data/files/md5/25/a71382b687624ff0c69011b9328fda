{"task_id": "Mbpp/308", "solution": "from typing import Sequence, List, Set\n\n# --- Inlined src/domain.py classes ---\n\nclass InputList:\n    \"\"\"Represents a named input list of numeric elements.\"\"\"\n    def __init__(self, elements: Sequence[float], name: str = \"\") -> None:\n        self.elements = list(elements)\n        self.name = name\n\n    def getElements(self) -> List[float]:\n        \"\"\"Returns the elements of the list.\"\"\"\n        return self.elements\n\nclass ProductPair:\n    \"\"\"Represents an ordered pair of factors and computes their product.\"\"\"\n    def __init__(self, factorA: float, factorB: float) -> None:\n        self.factorA = factorA\n        self.factorB = factorB\n\n    def compute(self) -> float:\n        \"\"\"Computes and returns the product of the two factors.\"\"\"\n        return self.factorA * self.factorB\n\nclass ProductSet:\n    \"\"\"Collects and maintains a set of distinct numeric product values.\"\"\"\n    def __init__(self) -> None:\n        self._distinct_values: Set[float] = set()\n\n    def add(self, value: float) -> None:\n        \"\"\"Adds a product value to the set of distinct values.\"\"\"\n        self._distinct_values.add(value)\n\n    def toSortedListDesc(self) -> List[float]:\n        \"\"\"Returns the distinct product values sorted in descending order.\"\"\"\n        return sorted(list(self._distinct_values), reverse=True)\n\n# --- Inlined src/validator.py classes ---\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for validation errors in input data.\"\"\"\n    pass\n\nclass Validator:\n    \"\"\"Validates input lists and the 'k' parameter.\"\"\"\n    def validateLists(self, listA: InputList, listB: InputList) -> bool:\n        \"\"\"Validates that all elements in the input lists are numeric.\"\"\"\n        for lst_obj in [listA, listB]:\n            for i, element in enumerate(lst_obj.getElements()):\n                if not isinstance(element, (int, float)):\n                    raise ValidationError(f\"Non-numeric element '{element}' found at index {i} in list '{lst_obj.name}'.\")\n        return True\n\n    def validateK(self, k: int) -> bool:\n        \"\"\"Validates the value of k. Returns False if k <= 0.\"\"\"\n        return k > 0\n\n# --- large_product function (src/largest_products_finder.py) ---\n\ndef large_product(listA: Sequence[float], listB: Sequence[float], k: int) -> List[float]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    validator = Validator()\n\n    input_list_a = InputList(listA, name=\"listA\")\n    input_list_b = InputList(listB, name=\"listB\")\n\n    validator.validateLists(input_list_a, input_list_b)\n\n    if not validator.validateK(k):\n        return []\n\n    elements_a = input_list_a.getElements()\n    elements_b = input_list_b.getElements()\n\n    if not elements_a or not elements_b:\n        return []\n\n    product_set = ProductSet()\n    for factor_a in elements_a:\n        for factor_b in elements_b:\n            product_pair = ProductPair(factor_a, factor_b)\n            product_value = product_pair.compute()\n            product_set.add(product_value)\n\n    sorted_distinct_products = product_set.toSortedListDesc()\n    \n    return sorted_distinct_products[:k]"}
{"task_id": "Mbpp/311", "solution": "class IntegerInput:\n    \"\"\"Encapsulates an integer input and provides its minimal binary string representation.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def to_binary_string(self) -> str:\n        \"\"\"Returns the minimal binary string representation of the integer.\"\"\"\n        if self.value == 0:\n            return '0'\n        return bin(self.value)[2:]\n\nclass BinaryRepresentation:\n    \"\"\"Holds a mutable binary string representation and allows bit manipulation.\"\"\"\n    def __init__(self, bits: str) -> None:\n        self.bits_list = list(bits)\n\n    def find_left_most_unset_bit(self) -> int | None:\n        \"\"\"Scans for the leftmost '0' bit and returns its 0-based index, or None if not found.\"\"\"\n        for i, bit_char in enumerate(self.bits_list):\n            if bit_char == '0':\n                return i\n        return None\n\n    def set_bit(self, pos: int) -> None:\n        \"\"\"Mutates the bit at the given position to '1'.\"\"\"\n        if 0 <= pos < len(self.bits_list):\n            self.bits_list[pos] = '1'\n\n    def to_int(self) -> int:\n        \"\"\"Converts the internal binary representation back to an integer.\"\"\"\n        return int(\"\".join(self.bits_list), 2)\n\nclass Result:\n    \"\"\"A simple container for the resulting integer value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\ndef set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Sets the left-most unset bit in an integer's binary representation.\n    If no unset bit exists, extends the representation by prepending a '1'.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    integer_input = IntegerInput(n)\n    binary_string = integer_input.to_binary_string()\n    binary_rep = BinaryRepresentation(binary_string)\n\n    pos = binary_rep.find_left_most_unset_bit()\n\n    if pos is not None:\n        binary_rep.set_bit(pos)\n    else:\n        # No unset bit found, prepend '1' to extend the representation.\n        binary_rep.bits_list.insert(0, '1')\n\n    result_int = binary_rep.to_int()\n    return result_int"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"Return largest power of two less than or equal to n. Precondition: n is a positive integer.\"\"\"\n    p = 1\n    while p * 2 <= n:\n        p *= 2\n    return p"}
