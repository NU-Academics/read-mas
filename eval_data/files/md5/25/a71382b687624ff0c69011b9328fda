{"task_id": "Mbpp/56", "solution": "def reverse(n: int) -> int:\n    \"\"\"\n    Computes the integer formed by reversing n's decimal digits.\n    Leading zeros in the reversed sequence are ignored (e.g., reverse(120) == 21, reverse(70) == 7).\n    \"\"\"\n    s = str(abs(n))\n    reversed_s = s[::-1]\n    return int(reversed_s)\n\ndef check(n: int) -> bool:\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    \"\"\"\n    reversed_n = reverse(n)\n    return n == (2 * reversed_n) - 1"}
{"task_id": "Mbpp/16", "solution": "import re\nfrom dataclasses import dataclass, field\n\n@dataclass\nclass Pattern:\n    regex: str = \"[a-z]+_[a-z]+\"\n    description: str = \"\"\n\n@dataclass\nclass InputString:\n    value: str\n    length: int = field(init=False)\n    def __post_init__(self):\n        self.length = len(self.value)\n\n@dataclass\nclass Result:\n    value: bool\n\nclass Matcher:\n    \"\"\"Executes regex-based matching using Pattern.regex and returns True if any match exists.\"\"\"\n    def match(self, input_str: str, pattern: Pattern) -> bool:\n        \"\"\"Return True when input string contains at least one substring matching pattern.regex, else False.\"\"\"\n        return re.search(pattern.regex, input_str) is not None\n\ndef text_lowercase_underscore(input_string: str) -> bool:\n    \"\"\"Returns true if the input string contains sequences of lowercase letters joined with an underscore.\"\"\"\n    input_obj = InputString(value=input_string)\n    match_pattern = Pattern()\n    matcher_instance = Matcher()\n    result_value = matcher_instance.match(input_obj.value, match_pattern)\n    final_result_obj = Result(value=result_value)\n    return final_result_obj.value"}
{"task_id": "Mbpp/19", "solution": "from typing import List\n\nclass IntegerElement:\n    \"\"\"Represents a single integer element.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass IntegerArray:\n    \"\"\"Represents an array/collection of IntegerElement objects.\"\"\"\n    def __init__(self, elements: List[IntegerElement]) -> None:\n        self.elements = elements\n\nclass Result:\n    \"\"\"Represents the result of duplicate detection.\"\"\"\n    def __init__(self, containsDuplicates: bool) -> None:\n        self.containsDuplicates = containsDuplicates\n\nclass DuplicateDetector:\n    \"\"\"Implements duplicate-detection business rules.\"\"\"\n    def test_duplicate(self, arr: IntegerArray) -> bool:\n        \"\"\"\n        Performs duplicate-detection evaluation on IntegerArray; returns True if duplicates are found.\n        \"\"\"\n        return self.hasDuplicates(arr)\n\n    def hasDuplicates(self, arr: IntegerArray) -> bool:\n        \"\"\"\n        Helper method implementing the detection algorithm; returns True/False.\n        \"\"\"\n        seen_values = set()\n        for element in arr.elements:\n            if element.value in seen_values:\n                return True\n            seen_values.add(element.value)\n        return False\n\ndef test_duplicate(arr: List[int]) -> bool:\n    \"\"\"\n    Finds whether a given array of integers contains any duplicate element.\n    \"\"\"\n    # Adapt native list[int] to IntegerArray\n    integer_elements = [IntegerElement(val) for val in arr]\n    integer_array = IntegerArray(integer_elements)\n\n    # Delegate duplicate detection to DuplicateDetector\n    detector = DuplicateDetector()\n    return detector.test_duplicate(integer_array)"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number.\n    A number N is Woodall if it can be expressed as n * 2^n - 1 for some integer n >= 1.\n    \"\"\"\n    if number < 1:\n        return False\n\n    n = 1\n    while True:\n        woodall_candidate = n * (2**n) - 1\n        if woodall_candidate == number:\n            return True\n        elif woodall_candidate > number:\n            return False\n        n += 1"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(source: str, chars_to_remove: str) -> str:\n    \"\"\"Return a new string equal to source with all characters present in chars_to_remove removed.\n    Preconditions: source and chars_to_remove are str objects.\n    Complexity: O(n + m).\n    \"\"\"\n    if not chars_to_remove:\n        return source\n\n    chars_to_remove_set = set(chars_to_remove)\n    result_chars = []\n\n    for char_in_source in source:\n        if char_in_source not in chars_to_remove_set:\n            result_chars.append(char_in_source)\n\n    return \"\".join(result_chars)"}
