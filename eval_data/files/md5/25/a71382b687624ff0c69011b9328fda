{"task_id": "Mbpp/610", "solution": "from typing import List, Any\n\ndef remove_kth_element(input_list: List[Any], k: int) -> List[Any]:\n    \"\"\"\n    Returns a new list with the k'th (1-based) element removed.\n    Precondition: 1 <= k <= len(input_list).\n    \"\"\"\n    # Convert 1-based k to 0-based index\n    idx = k - 1\n    # Create a new list by concatenating slices before and after the removed element\n    return input_list[:idx] + input_list[idx+1:]"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n):\n    \"\"\"\n    Computes the nth Bell number using the Bell triangle algorithm.\n    This function counts the number of partitions of a set of n elements.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return 1\n\n    # dp_bell stores Bell numbers B0, B1, ..., Bn\n    dp_bell = [0] * (n + 1)\n    dp_bell[0] = 1 # B0 = 1\n\n    # triangle_row represents the (i-1)-th row of the Bell triangle\n    # The first row (for i=0) is [1]\n    triangle_row = [1] \n\n    # Iterate from i=1 to n to compute Bi\n    for i in range(1, n + 1):\n        # new_row will store the i-th row of the Bell triangle\n        new_row = [0] * (i + 1)\n        \n        # The first element of the new row (A[i][0]) is the last element of the previous row (A[i-1][i-1])\n        # This element is also the Bell number B_i\n        new_row[0] = triangle_row[-1]\n        dp_bell[i] = new_row[0]\n\n        # Compute the remaining elements of the new row using A[i][j] = A[i][j-1] + A[i-1][j-1]\n        for j in range(1, i + 1):\n            new_row[j] = new_row[j-1] + triangle_row[j-1]\n        \n        # Update triangle_row for the next iteration\n        triangle_row = new_row\n    \n    return dp_bell[n]"}
{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Optional, Tuple, Any\n\nCompiledPattern = Any\n\nclass MatchResult:\n    \"\"\"Immutable data carrier for a regex match result.\"\"\"\n    def __init__(self, substring: str, start_index: int, end_index: int):\n        self.substring = substring\n        self.start_index = start_index\n        self.end_index = end_index\n\n    def to_tuple(self) -> Tuple[str, int, int]:\n        \"\"\"Converts the match result to a tuple (substring, start_index, end_index).\"\"\"\n        return (self.substring, self.start_index, self.end_index)\n\nclass RegexEngine:\n    \"\"\"Adapter/wrapper around runtime regex operations.\"\"\"\n    def compile(self, pattern: str) -> CompiledPattern:\n        \"\"\"Compile and return the runtime compiled regex object.\"\"\"\n        return re.compile(pattern)\n\n    def find(self, source: str, compiled_pattern: CompiledPattern) -> Optional[MatchResult]:\n        \"\"\"Search for the first (left-most) match.\"\"\"\n        match = compiled_pattern.search(source)\n        if match:\n            return MatchResult(match.group(0), match.start(), match.end())\n        return None\n\ndef find_literals(source: str, pattern: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Searches a string for a regex pattern and returns the matching substring,\n    its start index, and its end index, or None if no match is found.\n    \"\"\"\n    if not isinstance(source, str) or not isinstance(pattern, str):\n        raise TypeError(\"Source and pattern must be strings.\")\n\n    engine = RegexEngine()\n    compiled_pattern = engine.compile(pattern)\n    result = engine.find(source, compiled_pattern)\n\n    if result is None:\n        return None\n    return result.to_tuple()"}
{"task_id": "Mbpp/612", "solution": "def merge(input_list):\n    \"\"\"\n    Splits a list of 2-element sublists into two separate lists.\n    The first output list contains all first elements, the second contains all second elements.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list\")\n    firsts = []\n    seconds = []\n    for i, sub in enumerate(input_list):\n        if not isinstance(sub, (list, tuple)):\n            raise ValueError(f\"sublist at index {i} must be a sequence of length 2\")\n        if len(sub) != 2:\n            raise ValueError(f\"sublist at index {i} must have exactly 2 elements\")\n        firsts.append(sub[0])\n        seconds.append(sub[1])\n    return [firsts, seconds]"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(list_of_tuples):\n    \"\"\"Compute cumulative sum across all numeric elements in list_of_tuples.\n    This function iterates through each tuple and sums all its numeric elements.\n    \"\"\"\n    total_sum = 0\n    for tuple_item in list_of_tuples:\n        for element in tuple_item:\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/611", "solution": "def _validate_inputs(matrix, n):\n    \"\"\"\n    Validates basic properties of the matrix and column index n.\n    \"\"\"\n    if not matrix:\n        raise ValueError(\"Matrix cannot be empty.\")\n    if not isinstance(n, int):\n        raise ValueError(\"Column index n must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Column index n must be a non-negative integer.\")\n\ndef max_of_nth(matrix, n):\n    \"\"\"\n    Returns the maximum value from the n-th column of a given matrix.\n    \"\"\"\n    _validate_inputs(matrix, n)\n\n    max_val = None\n\n    for i, row in enumerate(matrix):\n        try:\n            value = row[n]\n        except IndexError:\n            raise IndexError(f\"Row {i} does not contain column index {n}.\")\n\n        if not isinstance(value, (int, float)):\n            raise TypeError(f\"Value at column {n} in row {i} must be an int or float, but got {type(value).__name__}.\")\n\n        if max_val is None or value > max_val:\n            max_val = value\n\n    return max_val"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(input: tuple[tuple[object, ...], ...]) -> list[float]:\n    \"\"\"\n    Calculates the average value for each 'column' across the inner tuples.\n    It assumes valid input: a non-empty tuple of non-empty tuples, where all inner tuples\n    have the same length and contain only numeric values.\n    \"\"\"\n    averages = []\n    # zip(*input) transposes the tuple of tuples,\n    # effectively grouping elements by their index across all inner tuples.\n    for column_values in zip(*input):\n        average = float(sum(column_values) / len(column_values))\n        averages.append(average)\n    return averages"}
{"task_id": "Mbpp/616", "solution": "class Validation:\n    \"\"\"Helper class for input validation with static methods.\"\"\"\n\n    @staticmethod\n    def validate_type(a: tuple, b: tuple) -> None:\n        \"\"\"Raises TypeError if a or b is not an instance of tuple.\"\"\"\n        if not isinstance(a, tuple) or not isinstance(b, tuple):\n            raise TypeError(\"Both inputs must be instances of tuple.\")\n\n    @staticmethod\n    def validate_length(a: tuple, b: tuple) -> None:\n        \"\"\"Raises ValueError if the lengths of tuples a and b are different.\"\"\"\n        if len(a) != len(b):\n            raise ValueError(\"Input tuples must have the same length.\")\n\n    @staticmethod\n    def validate_elements_are_int(a: tuple, b: tuple) -> None:\n        \"\"\"Raises TypeError if any element in a or b is not an integer.\"\"\"\n        for val in a:\n            if not isinstance(val, int):\n                raise TypeError(\"All elements in both tuples must be integers.\")\n        for val in b:\n            if not isinstance(val, int):\n                raise TypeError(\"All elements in both tuples must be integers.\")\n\n    @staticmethod\n    def validate_no_zero_in_divisors(b: tuple) -> None:\n        \"\"\"Raises ZeroDivisionError if any element in tuple b is zero.\"\"\"\n        for val in b:\n            if val == 0:\n                raise ZeroDivisionError(\"Divisor tuple cannot contain zero.\")\n\ndef tuple_modulo(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo on two tuples of the same length.\n    Validates inputs and raises appropriate exceptions for invalid data.\n    \"\"\"\n    Validation.validate_type(a, b)\n    Validation.validate_length(a, b)\n    Validation.validate_elements_are_int(a, b)\n    Validation.validate_no_zero_in_divisors(b)\n\n    result = tuple(a[i] % b[i] for i in range(len(a)))\n    return result"}
{"task_id": "Mbpp/618", "solution": "def div_list(list_a, list_b):\n    \"\"\"\n    Compute element-wise division of two lists.\n    The SRS assumes preconditions are met (equal-length lists of numeric values).\n    \"\"\"\n    result = []\n    for i in range(len(list_a)):\n        a = list_a[i]\n        b = list_b[i]\n        result.append(float(a / b))\n    return result"}
{"task_id": "Mbpp/620", "solution": "from typing import List\n\n# module: largest_subset\nfrom src.coordinator import LargestSubsetFunction\n\ndef largest_subset(numbers: List[int]) -> int:\n    \"\"\"\n    Public API entry point for finding the size of the largest pairwise-divisible subset.\n    Delegates to LargestSubsetFunction for validation and computation.\n    \"\"\"\n    coordinator = LargestSubsetFunction()\n    return coordinator.largest_subset(numbers)"}
{"task_id": "Mbpp/623", "solution": "def nth_nums(numbers_list, n):\n    \"\"\"\n    Computes the n-th power of each number in the input list.\n    Returns a new list with the results, preserving order and not mutating the input.\n    \"\"\"\n    return [num ** n for num in numbers_list]"}
{"task_id": "Mbpp/624", "solution": "def validate_input(input):\n    \"\"\"\n    Validates the input type, ensuring it is a string.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"is_upper: input must be a str\")\n\ndef is_upper(input: str) -> str:\n    \"\"\"\n    Converts the given string to its uppercase equivalent.\n    Performs input validation and returns the uppercase string.\n    \"\"\"\n    validate_input(input)\n    return input.upper()"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1, list2, n):\n    \"\"\"\n    Computes the median of two sorted lists of equal size n.\n    Raises ValueError if input list lengths are not equal to n.\n    \"\"\"\n    if len(list1) != n or len(list2) != n or len(list1) != len(list2):\n        raise ValueError(\"Input lists must have equal length equal to n\")\n\n    i = 0  # Current index for list1\n    j = 0  # Current index for list2\n    m1 = 0.0 # Stores the (n-1)-th element (0-indexed) of the merged list\n    m2 = 0.0 # Stores the n-th element (0-indexed) of the merged list\n\n    # We iterate n+1 times to find the n-th and (n+1)-th elements\n    # (1-indexed, corresponding to indices n-1 and n in a 0-indexed list).\n    for count in range(n + 1):\n        m1 = m2  # The previous m2 becomes the new m1\n\n        if i < n and j < n:\n            if list1[i] < list2[j]:\n                m2 = float(list1[i])\n                i += 1\n            else:\n                m2 = float(list2[j])\n                j += 1\n        elif i < n:  # list2 is exhausted\n            m2 = float(list1[i])\n            i += 1\n        elif j < n:  # list1 is exhausted\n            m2 = float(list2[j])\n            j += 1\n        # No 'else' needed; both lists can't be exhausted before n+1 elements are found,\n        # as total elements are 2*n.\n\n    return (m1 + m2) / 2.0"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_str: str) -> str:\n    \"\"\"\n    Moves all ASCII digits to the end of the string, preserving relative order of both non-digits and digits.\n    \"\"\"\n    non_digits = []\n    digits = []\n    for char in input_str:\n        if '0' <= char <= '9':\n            digits.append(char)\n        else:\n            non_digits.append(char)\n    return \"\".join(non_digits) + \"\".join(digits)"}
{"task_id": "Mbpp/626", "solution": "from typing import Optional\n\ndef triangle_area(radius) -> Optional[float]:\n    \"\"\"Public API: returns float area when radius >= 0, returns None when radius < 0.\"\"\"\n    if radius < 0:\n        return None\n    else:\n        # The largest triangle inscribed in a semicircle has its base along the diameter\n        # (length 2*radius) and its apex at the highest point on the arc (height = radius).\n        # Area = 0.5 * base * height = 0.5 * (2*radius) * radius = radius**2.\n        return float(radius**2)"}
{"task_id": "Mbpp/629", "solution": "def Split(numbers: list) -> list:\n    \"\"\"Return a list containing only the even numbers from 'numbers', preserving order.\n\n    Parameters:\n        numbers (list): list of numeric values\n    Returns:\n        list: list of even numeric values in original order\n    \"\"\"\n    even_numbers = []\n    for number in numbers:\n        if number % 2 == 0:\n            even_numbers.append(number)\n    return even_numbers"}
