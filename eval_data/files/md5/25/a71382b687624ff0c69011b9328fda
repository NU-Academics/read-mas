{"task_id": "Mbpp/567", "solution": "from typing import List, Any\n\nclass ListInput:\n    \"\"\"Encapsulates the input list and provides its length.\"\"\"\n    def __init__(self, items: List[Any]) -> None:\n        self.items = items\n\n    def length(self) -> int:\n        return len(self.items)\n\nclass Result:\n    \"\"\"Encapsulates the boolean result.\"\"\"\n    def __init__(self, value: bool) -> None:\n        self.value = value\n\nclass SortChecker:\n    \"\"\"Performs the check for ascending order by comparing adjacent elements.\"\"\"\n    def issort_list(self, items: List[Any]) -> bool:\n        list_input = ListInput(items)\n        n = list_input.length()\n\n        if n <= 1:\n            result = Result(True)\n            return result.value\n\n        for i in range(n - 1):\n            if items[i] > items[i+1]:\n                result = Result(False)\n                return result.value\n\n        result = Result(True)\n        return result.value\n\ndef issort_list(items: List[Any]) -> bool:\n    \"\"\"\n    Checks if the specified list is sorted in ascending order.\n    This function acts as a public API delegating the check to a SortChecker instance.\n    \"\"\"\n    checker = SortChecker()\n    return checker.issort_list(items)"}
{"task_id": "Mbpp/566", "solution": "def sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the digits of a non-negative integer.\n    Raises TypeError if n is not an integer or ValueError if n is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    current_sum = 0\n    while n > 0:\n        current_sum += n % 10\n        n //= 10\n    return current_sum"}
{"task_id": "Mbpp/569", "solution": "from typing import List, Any\n\ndef _validate_input(input_value: Any) -> None:\n    \"\"\"Raise TypeError if input_value is not a List[List[str]] or any inner element is not str.\"\"\"\n    if not isinstance(input_value, list):\n        raise TypeError(\"Input must be a list.\")\n    for sublist in input_value:\n        if not isinstance(sublist, list):\n            raise TypeError(\"All elements of the outer list must be lists.\")\n        for item in sublist:\n            if not isinstance(item, str):\n                raise TypeError(\"All elements of inner lists must be strings.\")\n\ndef sort_sublists(input_list: List[List[str]]) -> List[List[str]]:\n    \"\"\"Validate input and return a new List[List[str]] where each inner list is sorted ascending lexicographically.\n    The outer list's order is preserved.\"\"\"\n    _validate_input(input_list)\n    return [sorted(sublist) for sublist in input_list]"}
{"task_id": "Mbpp/573", "solution": "class NumberList:\n    \"\"\"Represents a list of numbers and provides methods to extract unique elements.\"\"\"\n    def __init__(self, numbers):\n        self.numbers = numbers\n\n    def get_unique(self):\n        \"\"\"Returns a UniqueNumberSet containing only the unique numbers from the list.\"\"\"\n        return UniqueNumberSet(set(self.numbers))\n\nclass UniqueNumberSet:\n    \"\"\"Holds a set of unique numbers and provides them as an iterable.\"\"\"\n    def __init__(self, values):  # values: set\n        self.values = values\n\n    def as_iterable(self):\n        \"\"\"Returns the unique values as an iterable.\"\"\"\n        return self.values\n\nclass Product:\n    \"\"\"Calculates and stores the product of a given iterable of numbers.\"\"\"\n    def __init__(self):\n        self.value = 1  # Initialize product to 1\n\n    def compute(self, values):  # values: iterable\n        \"\"\"Computes the product of the given values and stores it.\"\"\"\n        current_product = 1\n        for num in values:\n            current_product *= num\n        self.value = current_product\n\ndef unique_product(numbers):\n    \"\"\"\n    Calculates the product of the unique numbers in a given list.\n    Duplicates are treated as a single value.\n    \"\"\"\n    number_list_instance = NumberList(numbers)\n    unique_number_set_instance = number_list_instance.get_unique()\n    unique_values_iterable = unique_number_set_instance.as_iterable()\n\n    product_calculator = Product()\n    product_calculator.compute(unique_values_iterable)\n    return product_calculator.value"}
{"task_id": "Mbpp/572", "solution": "from dataclasses import dataclass\nfrom typing import List, Dict\n\nclass InputList:\n    \"\"\"Encapsulates the caller-provided list of integers and provides an empty check.\"\"\"\n    def __init__(self, values: List[int]):\n        self.values = values\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the stored list is empty.\"\"\"\n        return not self.values\n\nclass OutputList:\n    \"\"\"Collects integers that satisfy occurrence == 1 and produces a Python list.\"\"\"\n    def __init__(self) -> None:\n        self.values: List[int] = []\n\n    def append(self, value: int) -> None:\n        \"\"\"Adds a value to the internal list.\"\"\"\n        self.values.append(value)\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns a copy of the internal list.\"\"\"\n        return list(self.values)\n\n@dataclass\nclass Number:\n    \"\"\"Logical record storing a numeric value, its computed count, and first-appearance position.\"\"\"\n    value: int\n    count: int\n    position: int\n\nclass FrequencyCounter:\n    \"\"\"Computes and exposes frequency counts for integers in an input list.\"\"\"\n    def __init__(self) -> None:\n        self.counts: Dict[int, int] = {}\n\n    def increment(self, num: int) -> None:\n        \"\"\"Increments the count for a given number.\"\"\"\n        self.counts[num] = self.counts.get(num, 0) + 1\n\n    def get_count(self, num: int) -> int:\n        \"\"\"Returns the current count for a given number, or 0 if not present.\"\"\"\n        return self.counts.get(num, 0)\n\n    def all_counts(self) -> Dict[int, int]:\n        \"\"\"Returns the dictionary of all computed counts.\"\"\"\n        return self.counts\n\ndef two_unique_nums(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Given a list of integers, returns a new list containing the integers that occur\n    exactly once in the input, preserving their first-appearance order.\n    \"\"\"\n    input_wrapper = InputList(input_list)\n\n    if input_wrapper.is_empty():\n        return []\n\n    counter = FrequencyCounter()\n    for num in input_wrapper.values:\n        counter.increment(num)\n\n    output_wrapper = OutputList()\n    for num in input_wrapper.values:\n        if counter.get_count(num) == 1:\n            output_wrapper.append(num)\n\n    return output_wrapper.to_list()"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(source, target) -> bool:\n    \"\"\"\n    Checks if target is a contiguous sublist of source.\n    Returns True if found, False otherwise.\n    \"\"\"\n    n = len(source)\n    m = len(target)\n\n    if m == 0:\n        return True\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        if source[i : i + m] == target:\n            return True\n    return False"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n):\n    \"\"\"\n    Calculates the last decimal digit of the factorial of a given non-negative integer n.\n    Raises ValueError for invalid inputs (negative or non-integer).\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    # For n >= 5, the factorial always ends in 0.\n    if n >= 5:\n        return 0\n\n    # Pre-calculated last digits for n < 5\n    # 0! = 1 -> 1\n    # 1! = 1 -> 1\n    # 2! = 2 -> 2\n    # 3! = 6 -> 6\n    # 4! = 24 -> 4\n    last_digits = [1, 1, 2, 6, 4]\n    return last_digits[n]"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple):\n    \"\"\"\n    Recursively removes odd integers from a nested mixed tuple, preserving even integers and non-empty nested tuples.\n    Raises TypeError for elements that are not integers or tuples.\n    \"\"\"\n    result_elements = []\n    for element in input_tuple:\n        if isinstance(element, int):\n            if element % 2 == 0:\n                result_elements.append(element)\n        elif isinstance(element, tuple):\n            recursive_result = extract_even(element)\n            if recursive_result:  # Only add non-empty nested tuples\n                result_elements.append(recursive_result)\n        else:\n            raise TypeError(f\"Unsupported element type: {type(element)}. Only int and tuple are allowed.\")\n    return tuple(result_elements)"}
{"task_id": "Mbpp/583", "solution": "import math\n\ndef catalan_number(n: int) -> int:\n    \"\"\"Return the nth Catalan number as an exact integer.\n    The formula used is C_n = binomial(2n, n) / (n + 1).\n    \"\"\"\n    comb = math.comb(2 * n, n)\n    return comb // (n + 1)"}
{"task_id": "Mbpp/578", "solution": "class LengthMismatchException(Exception):\n    \"\"\"Exception raised when input lists have different lengths.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InputList:\n    \"\"\"Wrapper for an input list providing length and indexed access.\"\"\"\n    def __init__(self, elements):\n        self._elements = elements\n\n    def length(self) -> int:\n        return len(self._elements)\n\n    def get(self, index: int):\n        return self._elements[index]\n\nclass OutputList:\n    \"\"\"Accumulator for interleaved elements, providing append and list conversion.\"\"\"\n    def __init__(self):\n        self._elements = []\n\n    def append(self, value):\n        self._elements.append(value)\n\n    def length(self) -> int:\n        return len(self._elements)\n\n    def to_list(self) -> list:\n        return self._elements\n\nclass Element:\n    \"\"\"Simple wrapper for an element value, for domain modeling.\"\"\"\n    def __init__(self, value):\n        self._value = value\n\n    @property\n    def value(self):\n        return self._value\n\nclass Interleaver:\n    \"\"\"Handles the core logic of validating and interleaving lists.\"\"\"\n    @staticmethod\n    def interleave_lists(list1, list2, list3) -> list:\n        input1 = InputList(list1)\n        input2 = InputList(list2)\n        input3 = InputList(list3)\n\n        len1, len2, len3 = input1.length(), input2.length(), input3.length()\n\n        if not (len1 == len2 == len3):\n            raise LengthMismatchException(f\"Input lists must have the same length: got {len1}, {len2}, {len3}\")\n\n        output = OutputList()\n\n        for i in range(len1):\n            output.append(input1.get(i))\n            output.append(input2.get(i))\n            output.append(input3.get(i))\n\n        return output.to_list()\n\n\ndef interleave_lists(list1, list2, list3) -> list:\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Raises LengthMismatchException if input lists have different lengths.\n    \"\"\"\n    return Interleaver.interleave_lists(list1, list2, list3)"}
{"task_id": "Mbpp/579", "solution": "def _build_membership_sets(a: tuple, b: tuple) -> tuple:\n    \"\"\"Builds sets from the input tuples for efficient membership testing.\n    This helps in quickly checking if an element exists in the other tuple.\"\"\"\n    set_a = set(a)\n    set_b = set(b)\n    return set_a, set_b\n\ndef _collect_unique_in_order(source: tuple, other_members: set, included: set) -> list:\n    \"\"\"Collects unique elements from the source tuple that are not in other_members and not yet added to the final result.\n    Elements are added to the included set to prevent duplicates in the final output.\"\"\"\n    collected_uniques = []\n    for x in source:\n        if x not in other_members and x not in included:\n            collected_uniques.append(x)\n            included.add(x)\n    return collected_uniques\n\ndef find_dissimilar(a: tuple, b: tuple) -> tuple:\n    \"\"\"Finds elements present in exactly one of the two input tuples, preserving order and deduplicating.\n    It returns a tuple containing elements unique to `a` first, then unique to `b`, in their first-occurrence order.\"\"\"\n    set_a, set_b = _build_membership_sets(a, b)\n    \n    included = set()\n    result_list = []\n    \n    # Collect elements unique to 'a' first, in order\n    result_list.extend(_collect_unique_in_order(a, set_b, included))\n    \n    # Then collect elements unique to 'b' that haven't been included yet\n    result_list.extend(_collect_unique_in_order(b, set_a, included))\n    \n    return tuple(result_list)"}
{"task_id": "Mbpp/585", "solution": "from typing import Iterable, List, Dict, Any, Tuple\n\ndef _validate_inputs(dataset: Any, n: Any) -> None:\n    \"\"\"Validate dataset and n types.\n    Raises TypeError if inputs are invalid.\n    \"\"\"\n    if not isinstance(dataset, Iterable) or isinstance(dataset, (str, bytes)):\n        raise TypeError(\"Dataset must be an iterable of item dictionaries, not a string or bytes.\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an an integer.\")\n\ndef _extract_price(item: Dict[str, Any]) -> float:\n    \"\"\"Return numeric price (float) or raise ValueError if missing/non-numeric.\"\"\"\n    if 'price' not in item:\n        raise ValueError(\"Item dictionary must contain a 'price' key.\")\n    price_value = item['price']\n    if not isinstance(price_value, (int, float)):\n        raise ValueError(\"Item 'price' must be a numeric value (int or float).\")\n    return float(price_value)\n\ndef _select_top_n(items_with_price_and_index: List[Tuple[int, Dict[str, Any], float]], n: int) -> List[Dict[str, Any]]:\n    \"\"\"Return up to n original item dicts sorted descending by price, stable for ties.\"\"\"\n    if n <= 0:\n        return []\n\n    # Sort by price descending. Python's sort is stable, preserving original order for equal prices.\n    items_with_price_and_index.sort(key=lambda x: x[2], reverse=True)\n\n    # Select the top 'n' items and extract the original item dictionaries\n    result = [item_dict for _, item_dict, _ in items_with_price_and_index[:n]]\n    return result\n\ndef expensive_items(dataset: Iterable[Dict[str, Any]], n: int) -> List[Dict[str, Any]]:\n    \"\"\"Public API: returns list of up to n item dicts with highest numeric 'price'.\n    Validates inputs, extracts prices, and returns sorted, top-n items.\n    \"\"\"\n    _validate_inputs(dataset, n)\n\n    items_with_price_and_index: List[Tuple[int, Dict[str, Any], float]] = []\n    for original_index, item_dict in enumerate(dataset):\n        if not isinstance(item_dict, dict):\n            raise TypeError(f\"Item at index {original_index} is not a dictionary.\")\n        try:\n            price = _extract_price(item_dict)\n            items_with_price_and_index.append((original_index, item_dict, price))\n        except ValueError as e:\n            raise ValueError(f\"Invalid item at index {original_index}: {e}\") from e\n\n    return _select_top_n(items_with_price_and_index, n)"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(arr, n):\n    \"\"\"\n    Splits a list at the nth element and moves the first part to the end.\n    Raises TypeError if arr is not a list or n is not an int, ValueError if n is out of range.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if not (0 <= n <= len(arr)):\n        raise ValueError(\"Input 'n' must be within the valid range [0, len(arr)].\")\n\n    return arr[n:] + arr[0:n]"}
{"task_id": "Mbpp/581", "solution": "import math\n\nclass SquarePyramid:\n    \"\"\"Domain class representing a square pyramid and its computed metrics.\n\n    Properties (public): edge, height, slantHeight, baseArea, lateralArea, surfaceArea\n    Methods (public): computeSlantHeight(), computeBaseArea(), computeLateralArea(), computeComputeLateralArea()\n    \"\"\"\n    def __init__(self, edge, height):\n        # enforce numeric inputs per SRS recommendation (V-4)\n        if not (isinstance(edge, (int, float)) and isinstance(height, (int, float))):\n            raise ValueError(\"edge and height must be numeric\")\n        self.edge = float(edge)\n        self.height = float(height)\n        self.slantHeight = 0.0\n        self.baseArea = 0.0\n        self.lateralArea = 0.0\n        self.surfaceArea = 0.0\n\n    def computeSlantHeight(self):\n        self.slantHeight = math.sqrt((self.edge / 2.0) ** 2 + self.height ** 2)\n        return self.slantHeight\n\n    def computeBaseArea(self):\n        self.baseArea = self.edge ** 2\n        return self.baseArea\n\n    def computeLateralArea(self):\n        # ensure slantHeight computed (caller must compute slant height first)\n        if self.slantHeight == 0.0:\n            self.computeSlantHeight()\n        self.lateralArea = 2.0 * self.edge * self.slantHeight\n        return self.lateralArea\n\n    def computeSurfaceArea(self):\n        # ensure base and lateral areas computed\n        if self.baseArea == 0.0:\n            self.computeBaseArea()\n        if self.lateralArea == 0.0:\n            self.computeLateralArea()\n        self.surfaceArea = self.baseArea + self.lateralArea\n        return self.surfaceArea\n\ndef surface_Area(edge, height):\n    \"\"\"Public API function to calculate the surface area of a square pyramid.\n\n    It instantiates a SquarePyramid object, computes its metrics, and returns the total surface area.\n    \"\"\"\n    sp = SquarePyramid(edge, height)\n    sp.computeSlantHeight()\n    sp.computeBaseArea()\n    sp.computeLateralArea()\n    return sp.computeSurfaceArea()"}
