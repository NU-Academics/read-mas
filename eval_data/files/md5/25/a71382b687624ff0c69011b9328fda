{"task_id": "Mbpp/603", "solution": "from typing import List\n\ndef _validate_input(n: int) -> int:\n    \"\"\"\n    Validates the input integer n.\n    Returns 0 if n is less than 1, otherwise returns n.\n    \"\"\"\n    if n < 1:\n        return 0\n    return n\n\ndef _compute_ludic_sequence(n: int) -> List[int]:\n    \"\"\"\n    Computes the Ludic numbers up to n using a sieve-like method.\n    The list is returned in ascending order.\n    \"\"\"\n    if n <= 0:\n        return []\n\n    numbers = list(range(1, n + 1))\n    ludic_numbers = []\n\n    while numbers:\n        ludic_val = numbers.pop(0)\n        ludic_numbers.append(ludic_val)\n\n        if not numbers:\n            break\n\n        # Remove every ludic_val-th element from the remaining 'numbers' list\n        new_numbers = []\n        count = 0\n        for num_in_candidates in numbers:\n            count += 1\n            if count % ludic_val != 0:\n                new_numbers.append(num_in_candidates)\n        numbers = new_numbers\n    \n    return ludic_numbers\n\n\nclass GetLudicService:\n    \"\"\"\n    Service class to encapsulate the logic for retrieving Ludic numbers.\n    \"\"\"\n    def get_ludic(self, n: int) -> List[int]:\n        \"\"\"\n        Retrieves all Ludic numbers less than or equal to n.\n        Returns an ascending list of Ludic numbers.\n        \"\"\"\n        validated_n = _validate_input(n)\n        if validated_n == 0:\n            return []\n        return _compute_ludic_sequence(validated_n)\n\n\ndef get_ludic(n: int) -> List[int]:\n    \"\"\"\n    Returns a list of all Ludic numbers less than or equal to a given integer n.\n    The numbers are returned in ascending order.\n    \"\"\"\n    service = GetLudicService()\n    return service.get_ludic(n)"}
{"task_id": "Mbpp/605", "solution": "def prime_num(n: int) -> bool:\n    \"\"\"Checks if an integer is a prime number.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
