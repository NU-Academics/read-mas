{"task_id": "Mbpp/598", "solution": "from dataclasses import dataclass # Though not strictly used in the final implementation logic, dataclasses were part of the design context for the module.\n\n# Although Number and Result dataclasses are part of the design context for the module,\n# the final implementation outline for ArmstrongChecker's methods uses primitive types\n# directly and does not explicitly require these dataclasses for its operation.\n# Keeping them here per \"File contents summary\" if they are considered part of the \"COMPLETE\" module.\n@dataclass\nclass Number:\n    \"\"\"Holds an integer value and its digit count.\"\"\"\n    value: int\n    digits: int\n\n@dataclass\nclass Result:\n    \"\"\"Holds the boolean outcome of an Armstrong number check.\"\"\"\n    is_armstrong: bool\n\nclass ArmstrongChecker:\n    \"\"\"Encapsulates the logic to check if a number is an Armstrong number.\"\"\"\n\n    def armstrong_number(self, n: int) -> bool:\n        \"\"\"\n        Orchestrates the Armstrong number check by counting digits,\n        computing the powered sum, and comparing it to the original number.\n        \"\"\"\n        digits = self._count_digits(n)\n        total = self._compute_powered_sum(n, digits)\n        return total == n\n\n    def _count_digits(self, n: int) -> int:\n        \"\"\"Returns the number of decimal digits in n.\"\"\"\n        # Using string conversion is a straightforward way to count digits,\n        # handling positive numbers and zero correctly (len(str(0)) is 1).\n        return len(str(n))\n\n    def _compute_powered_sum(self, n: int, digits: int) -> int:\n        \"\"\"\n        Computes the sum of each digit raised to the power of the total number of digits.\n        Handles the special case for n=0 correctly.\n        \"\"\"\n        if n == 0:\n            return 0 # 0 is an Armstrong number (0^1 = 0)\n\n        total_sum = 0\n        temp_n = n\n        while temp_n > 0:\n            digit = temp_n % 10\n            total_sum += digit ** digits\n            temp_n //= 10\n        return total_sum\n\n# TestCase is for unit testing the function, not part of its definition.\n# class TestCase:\n#     def __init__(self, input: int, expected: bool):\n#         self.input = input\n#         self.expected = expected\n\n#     def run(self) -> bool:\n#         result = armstrong_number(self.input)\n#         return result == self.expected\n\ndef armstrong_number(n: int) -> bool:\n    \"\"\"Checks if the given number is an Armstrong number.\"\"\"\n    return ArmstrongChecker().armstrong_number(n)"}
{"task_id": "Mbpp/597", "solution": "import sys\nfrom typing import Sequence, Any\n\nclass KthFinderException(Exception):\n    \"\"\"Custom exception for KthFinder errors.\"\"\"\n    def __init__(self, code: str, message: str):\n        self.code = code\n        self.message = message\n        super().__init__(f\"[{code}] {message}\")\n\nclass SortedArray:\n    \"\"\"Read-only adapter for a sorted sequence.\"\"\"\n    def __init__(self, sequence: Sequence[Any]):\n        self._sequence = sequence\n\n    def __len__(self) -> int:\n        return len(self._sequence)\n\n    def __getitem__(self, i: int) -> Any:\n        return self._sequence[i]\n\nclass Element:\n    \"\"\"Wrapper for an element value.\"\"\"\n    def __init__(self, value: Any):\n        self.value = value\n\nclass FindKthService:\n    \"\"\"Service to find the k-th element using a binary-partition algorithm.\"\"\"\n    def validate_inputs(self, arr1: SortedArray, arr2: SortedArray, k: int) -> None:\n        \"\"\"Validates input parameters k.\"\"\"\n        total_len = len(arr1) + len(arr2)\n        if not (1 <= k <= total_len):\n            raise KthFinderException(\"INVALID_K_RANGE\", f\"k must be between 1 and {total_len}, but got {k}\")\n\n    def find_kth(self, arr1: SortedArray, arr2: SortedArray, k: int) -> Element:\n        \"\"\"Finds the k-th element after validating inputs.\"\"\"\n        self.validate_inputs(arr1, arr2, k)\n        return self._kth_binary_partition(arr1, arr2, k)\n\n    def _kth_binary_partition(self, arr1: SortedArray, arr2: SortedArray, k: int) -> Element:\n        \"\"\"\n        Implements the core binary-partition algorithm to find the k-th element.\n        Assumes k is valid and arr1, arr2 are sorted.\n        \"\"\"\n        m, n = len(arr1), len(arr2)\n\n        # Ensure arr1 is the smaller array to optimize binary search range\n        if m > n:\n            arr1, arr2 = arr2, arr1\n            m, n = n, m\n\n        # Binary search for partition_x in arr1\n        # partition_x is the count of elements taken from arr1 for the left partition\n        # partition_y is the count of elements taken from arr2 for the left partition, such that partition_x + partition_y = k\n        low = max(0, k - n) # Smallest possible partition_x to ensure partition_y <= n\n        high = min(k, m)    # Largest possible partition_x to ensure partition_x <= m and partition_y >= 0\n\n        while low <= high:\n            partition_x = (low + high) // 2\n            partition_y = k - partition_x\n\n            # Determine the four comparison values (leftmost/rightmost elements of partitions)\n            # Use float('-inf') and float('inf') for boundary conditions\n            max_left_x = arr1[partition_x - 1] if partition_x > 0 else float('-inf')\n            min_right_x = arr1[partition_x] if partition_x < m else float('inf')\n\n            max_left_y = arr2[partition_y - 1] if partition_y > 0 else float('-inf')\n            min_right_y = arr2[partition_y] if partition_y < n else float('inf')\n\n            # Check if partitions are correct (elements on left partition <= elements on right partition)\n            if max_left_x <= min_right_y and max_left_y <= min_right_x:\n                # Kth element found: it's the maximum of the elements in the left partitions\n                return Element(max(max_left_x, max_left_y))\n            elif max_left_x > min_right_y:\n                # partition_x is too large, need to reduce it (move left in arr1's search space)\n                high = partition_x - 1\n            else: # max_left_y > min_right_x\n                # partition_x is too small, need to increase it (move right in arr1's search space)\n                low = partition_x + 1\n        \n        # This part should logically not be reached if k is within valid bounds\n        # and the arrays are sorted correctly, as a solution must exist.\n        return Element(None) # Should not happen\n\ndef find_kth(arr1: Sequence[Any], arr2: Sequence[Any], k: int) -> Any:\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays.\n    Delegates to FindKthService for core logic and input validation.\n    \"\"\"\n    sa1 = SortedArray(arr1)\n    sa2 = SortedArray(arr2)\n    svc = FindKthService()\n    element = svc.find_kth(sa1, sa2, k)\n    return element.value"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n: int) -> tuple[int, float]:\n    \"\"\"\n    Calculates the sum and average of the first n natural numbers.\n    Validates input n to be an integer and n >= 1, raising ValueError otherwise.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer.\")\n    if n < 1:\n        raise ValueError(\"n must be greater than or equal to 1.\")\n\n    # Compute sum using the closed-form formula n*(n+1)/2.\n    # Integer division // is used to ensure sum_val is an integer.\n    sum_val = n * (n + 1) // 2\n\n    # Compute average. Python's / operator ensures a float result.\n    average_val = sum_val / n\n\n    return (sum_val, average_val)"}
{"task_id": "Mbpp/602", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    value: str\n    def length(self) -> int:\n        return len(self.value)\n\n@dataclass\nclass CharacterOccurrence:\n    value: str\n    firstIndex: int\n    secondIndex: int\n\ndef first_repeated_char(s: str) -> str:\n    \"\"\"Return the first repeated character as a single-character string.\n    Precondition: s is a Python str.\n    Note: SRS does not specify behavior when no character repeats; the implementation documents the chosen convention (may return None).\n    \"\"\"\n    char_first_index_map = {}\n    earliest_second_occurrence_char = None\n    min_second_index = float('inf')\n\n    for index, char in enumerate(s):\n        if char in char_first_index_map:\n            # This character has appeared before, so it's a repetition.\n            current_second_index = index\n            if current_second_index < min_second_index:\n                min_second_index = current_second_index\n                earliest_second_occurrence_char = char\n        else:\n            # First time seeing this character.\n            char_first_index_map[char] = index\n\n    return earliest_second_occurrence_char"}
