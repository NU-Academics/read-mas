    # If the calculated signed sum is greater than 0, increment the count.\n        if signed_sum > 0:\n            count += 1\n\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/111": [{"task_id": "HumanEval/111", "solution": "def histogram(test):\n    \"\"\"Given a string representing a space separated lowercase letters, return a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\n    \"\"\"\n    if not test or not test.strip():\n        return {}\n\n    tokens = test.split()\n    counts = {}\n    for token in tokens:\n        counts[token] = counts.get(token, 0) + 1\n\n    if not counts:\n        return {}\n\n    max_count = 0\n    for count in counts.values():\n        if count > max_count:\n            max_count = count\n\n    result = {}\n    for token, count in counts.items():\n        if count == max_count:\n            result[token] = count\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/111", "solution": "def histogram(test):\n    \"\"\"Given a string representing a space separated lowercase letters, return a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\n    \"\"\"\n    if not test:\n        return {}\n\n    tokens = test.split()\n    if not tokens:\n        return {}\n\n    from collections import Counter\n    counts = Counter(tokens)\n    max_count = max(counts.values())\n\n    return {letter: count for letter, count in counts.items() if count == max_count}", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/110": [{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if l