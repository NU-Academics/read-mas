rns a list of size n where elements are factorials for even indices\n    and sums for odd indices (1-based).\n    \"\"\"\n    result = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:\n            # Calculate factorial of i\n            current_val = 1\n            for j in range(1, i + 1):\n                current_val *= j\n            result.append(current_val)\n        else:\n            # Calculate sum from 1 to i\n            current_val = 0\n            for j in range(1, i + 1):\n                current_val += j\n            result.append(current_val)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/107": [{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Counts even and odd integer palindromes within the range [1, n].\n    Returns a tuple: (count_of_even_palindromes, count_of_odd_palindromes).\n    \"\"\"\n    even_palindromes_count = 0\n    odd_palindromes_count = 0\n\n    for i in range(1, n + 1):\n        s = str(i)\n        if s == s[::-1]:  # Check if the number is a palindrome\n            if i % 2 == 0:\n                even_palindromes_count += 1\n            else:\n                odd_palindromes_count += 1\n\n    return (even_palindromes_count, odd_palindromes_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Counts even and odd integer palindromes from 1 to n.\n    Returns a tuple with (even_count, odd_count).\n    \"\"\"\n    even_palindromes = 0\n    odd_palindromes = 0\n\n    for i in range(1, n + 1):\n        s = str(i)\n        if s == s[::-1]:  # Check if the number is a palindrome\n            if i % 2 == 0:\n                even_palindromes += 1\n            else:\n                odd_palindromes += 1\n\n    return (even_palindromes, odd_palindromes)", "base_status": "pass", "plus_st