er than or equal to num itself.\n                continue\n            if _miller_rabin_test(num, a, s, d):\n                return False  # num is composite\n        return True  # num is prime\n\n    if _is_prime(n):\n        return x\n    else:\n        return y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"Return x if n is prime, otherwise return y.\n\n    Raises:\n        TypeError: if n is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n\n    if n <= 1:\n        return y\n    if n <= 3:\n        return x  # 2 and 3 are prime\n    if n % 2 == 0 or n % 3 == 0:\n        return y\n\n    i = 5\n    # Test divisors of the form 6k-1 and 6k+1 up to sqrt(n)\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return y\n        i += 6\n\n    return x", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/152": [{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Determines how far off each guess was compared to the actual score.\n    Returns a list where each element is 0 if the guess was correct, otherwise\n    the absolute difference between the actual score and the guess.\n    \"\"\"\n    if len(game) != len(guess):\n        raise ValueError(\"game and guess must have the same length\")\n    return [0 if g == q else abs(g - q) for g, q in zip(game, guess)]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"\n    Compares two lists of scores and guesses to determine the difference for each match.\n    Returns an array showing how far off each guess was.\n    \"\"\"\n    return [0 if g == s else abs(g - s) for g, s in zip(game, guess)]", "base_status": "pass", "