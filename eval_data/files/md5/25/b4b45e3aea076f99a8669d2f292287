 valid triangle; otherwise, returns\n    the area rounded to two decimal places using Heron's formula.\n    \"\"\"\n    if not (a > 0 and b > 0 and c > 0):\n        return -1\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1\n\n    s = (a + b + c) / 2\n    area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n    return round(area, 2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater\n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    tol = 1e-9\n\n    # Type and finiteness checks\n    for side in (a, b, c):\n        if isinstance(side, bool):  # exclude booleans\n            return -1\n        if not isinstance(side, (int, float)):\n            return -1\n        if not math.isfinite(side):\n            return -1\n\n    # Positive side lengths required\n    if not (a > 0 and b > 0 and c > 0):\n        return -1\n\n    # Triangle inequality (with tolerance for floating point errors)\n    if (a + b) <= c + tol or (a + c) <= b + tol or (b + c) <= a + tol:\n        return -1\n\n    s = (a + b + c) / 2.0\n    area_sq = s * (s - a) * (s - b) * (s - c)\n\n    # Clamp tiny negative due to floating point to zero; otherwise invalid\n    if area_sq < -tol:\n        return -1\n    if area_sq < 0:\n        area_sq = 0.0\n\n    area = math.sqrt(area_sq)\n    return round(area, 2)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[true, true, true]]}], "HumanEval/75": [{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"\n    