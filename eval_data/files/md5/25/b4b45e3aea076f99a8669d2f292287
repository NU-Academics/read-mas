< max_expansions:\n        a *= 2.0\n        b *= 2.0\n        fa = poly(trimmed, a)\n        fb = poly(trimmed, b)\n        if abs(fa) <= f_tol:\n            return a\n        if abs(fb) <= f_tol:\n            return b\n        expansions += 1\n\n    if fa * fb > 0:\n        # As a fallback (shouldn't happen for odd-degree with non-zero leading coeff),\n        # try expanding in the other direction for negative b/a growth\n        a = -1.0\n        b = 1.0\n        fa = poly(trimmed, a)\n        fb = poly(trimmed, b)\n        expansions = 0\n        while fa * fb > 0 and expansions < max_expansions:\n            a *= -2.0 if a <= 0 else -2.0\n            b *= 2.0 if b >= 0 else 2.0\n            fa = poly(trimmed, a)\n            fb = poly(trimmed, b)\n            if abs(fa) <= f_tol:\n                return a\n            if abs(fb) <= f_tol:\n                return b\n            expansions += 1\n\n    if fa * fb > 0:\n        # Give up if unable to bracket a root\n        raise RuntimeError(\"Unable to find interval with sign change for root finding\")\n\n    # Bisection method\n    for _ in range(max_iterations):\n        mid = (a + b) / 2.0\n        fmid = poly(trimmed, mid)\n\n        if abs(fmid) <= f_tol or (b - a) / 2.0 <= x_tol:\n            return mid\n\n        # Decide which subinterval contains the root\n        if fa * fmid <= 0:\n            b = mid\n            fb = fmid\n        else:\n            a = mid\n            fa = fmid\n\n    # If we reach here, return midpoint as best approximation\n    return (a + b) / 2.0", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-10, -2]]], "plus_fail_tests": [[[5, 10, -3, 1]]]}, {"task_id": "HumanEval/32", "solution": "import math\nX_TOLERANCE = 1e-12\nF_TOLERANCE = 1e-14\nMAX_EXPAND = 200\nMAX_BISECT_ITER = 200\ndef _strip_trailing_zeros(xs: list):\n    # Trims trailing zero coefficients from the list.\n    n = len(xs) - 1\n    while n >= 0 and xs[n] == 0.0:\n        n -= 1\n    if n < 0:\n        return [0.0] # Return [0.0] if all coefficients are zero.\n    return xs[:n+1]\ndef _horner(xs: list, x: float):\n    # Evaluates polynomial p(x) = xs[0] + xs[1]*x + ... + xs[n]*x^n using Horner's method.\n    if not xs:\n        return 0.0 # Returns 0.0 for an empty coefficient list.\n\n    result = xs[-1]\n    for i in range(len(xs) - 2, -1, -1):\n        result = result * x + xs[i]\n    return result\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Finds a real root x of the polynomial defined by coefficients xs.\n    # Assumes the polynomial has an odd degree and a non-zero highest coefficient, guaranteeing a real root.\n\n    coeffs = _strip_trailing_zeros(xs)\n\n    # Initialize bracketing interval and evaluate polynomial at endpoints.\n    a, b = -1.0, 1.0\n    fa = _horner(coeffs, a)\n    fb = _horner(coeffs, b)\n\n    # Check for roots at initial endpoints within tolerance.\n    if abs(fa) < F_TOLERANCE:\n        return a\n    if abs(fb) < F_TOLERANCE:\n        return b\n\n    # Expand the interval by doubling until a sign change is found.\n    for _ in range(MAX_EXPAND):\n        if fa * fb < 0: # A sign change indicates a bracket.\n            break\n\n        a *= 2.0\n        b *= 2.0\n        fa = _horner(coeffs, a)\n        fb = _horner(coeffs, b)\n\n        # Check for roots at expanded endpoints.\n        if abs(fa) < F_TOLERANCE:\n            return a\n        if abs(fb) < F_TOLERANCE:\n            return b\n\n    # Perform bisection to refine the root within the bracketed interval.\n    for _ in range(MAX_BISECT_ITER):\n        mid = (a + b) / 2.0\n        fmid = _horner(coeffs, mid)\n\n        # Stop if function value is near zero or interval is small enough.\n        if abs(fmid) < F_TOLERANCE or (b - a) / 2.0 < X_TOLERANCE:\n            return mid\n\n        # Update the interval based on the sign of fmid.\n        if fa * fmid < 0:\n            b = mid\n        else:\n            a = mid\n            fa = fmid # Update fa to reflect the function value at the new 'a'.\n\n    # Return the midpoint of the final interval if maximum iterations are reached.\n    return (a + b) / 2.0", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[5, 10, -3, 1]]]}], "HumanEval/34": [{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list.\n\n    Handles both hashable and unhashable elements. If elements cannot be\n    compared with each other (e.g., mixed incomparable types), the function\n    falls back to a stable ordering based on type name and repr to produce a\n    deterministic result.\n\n    Example:\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    if not l:\n        return []\n\n    # Try fast path: use a set for hashable elements\n    try:\n        uniq = set(l)\n    except TypeError:\n        # Contains unhashable elements: deduplicate with O(n^2) equality checks,\n        # preserving first occurrence\n        uniq_list = []\n        for item in l:\n            found = False\n            for seen in uniq_list:\n                if seen == item:\n                    found = True\n                    break\n            if not found:\n                uniq_list.append(item)\n        try:\n            return sorted(uniq_list)\n        except TypeError:\n            # Fallback deterministic ordering when elements are not mutually comparable\n            return sorted(uniq_list, key=lambda x: (type(x).