\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    # Build sequence iteratively. Observations:\n    # - tri(0) = 1 (implied by examples)\n    # - tri(1) = 3 (given)\n    # - For even k: tri(k) = 1 + k // 2\n    # - For odd k >= 3: tri(k) = tri(k-1) + tri(k-2) + tri(k+1)\n    #   but tri(k+1) is even, so tri(k+1) = 1 + (k+1)//2, allowing forward iteration.\n    result = []\n    for i in range(n + 1):\n        if i == 0:\n            result.append(1)\n        elif i == 1:\n            result.append(3)\n        elif i % 2 == 0:\n            result.append(1 + i // 2)\n        else:\n            # i is odd and >= 3\n            next_even = 1 + (i + 1) // 2  # tri(i+1)\n            result.append(result[i - 1] + result[i - 2] + next_even)\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Computes the Brazilian factorial, defined as the product of factorials from 1! to n!.\n    It calculates n! * (n-1)! * ... * 1!.\n    \"\"\"\n    overall_product = 1\n    current_factorial_value = 1\n    for k in range(1, n + 1):\n        current_factorial_value *= k\n        overall_product *= current_factorial_value\n    return overall_product", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Computes the Brazilian (special) factorial: the product of factorials from 1! to n!.\n    For example, special_factorial(4) computes 1! * 2! * 3! * 4! = 288.\"\"\"\n    current_fact = 1\n    result = 1\n    for i in range(1, n + 1):\n        current_fact *= i\n        result *= current_fact\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}