  min_so_far = current_min = nums[0]\n    for num in nums[1:]:\n        current_min = min(num, current_min + num)\n        min_so_far = min(min_so_far, current_min)\n    return min_so_far", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Finds the minimum sum of any non-empty contiguous subarray within nums.\n    This uses a variant of Kadane's algorithm for minimum subarray sums.\n    \"\"\"\n    if nums is None:\n        raise TypeError(\"nums must be a non-empty list or tuple\")\n    if not isinstance(nums, (list, tuple)):\n        raise TypeError(\"nums must be a list or tuple\")\n    if len(nums) == 0:\n        raise ValueError(\"nums must be non-empty\")\n\n    current_min = nums[0]\n    global_min = nums[0]\n\n    for x in nums[1:]:\n        current_min = min(x, current_min + x)\n        global_min = min(global_min, current_min)\n\n    return global_min", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/115": [{"task_id": "HumanEval/115", "solution": "def max_fill(grid, capacity):\n    \"\"\"\n    Computes the minimum number of bucket-lowering operations to remove all water from all wells.\n    Water units in a well are represented by 1s in a row, and each lowering removes up to 'capacity' units.\n    \"\"\"\n    total_lowering_operations = 0\n    for row in grid:\n        units_of_water = sum(row)\n        if units_of_water > 0:\n            # Calculate ceil(units_of_water / capacity) using integer division\n            lowering_for_this_row = (units_of_water + capacity - 1) // capacity\n            total_lowering_operations += lowering_for_this_row\n    return total_lowering_operations", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/115", "solution": "def max_fill(grid, capacity):\n    \"\"\"\n    You are 