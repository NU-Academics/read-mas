g contains no letters, reverse the string.\n    The function returns the resulting string.\n    \"\"\"\n    if any(ch.isalpha() for ch in s):\n        return ''.join(ch.swapcase() if ch.isalpha() else ch for ch in s)\n    return s[::-1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Transforms a string: reverses case of letters if present, else reverses the whole string.\n    Example: \"ab\" -> \"AB\", \"1234\" -> \"4321\".\n    \"\"\"\n    has_letter = any(c.isalpha() for c in s)\n\n    if has_letter:\n        return s.swapcase()\n    else:\n        return s[::-1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/162": [{"task_id": "HumanEval/162", "solution": "def string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n\n    >>> string_to_md5('Hello world') == '3e25960a79dbc69b674cd4ec67a72c62'\n    \"\"\"\n    if text == \"\":\n        return None\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a str\")\n    import hashlib\n    return hashlib.md5(text.encode(\"utf-8\")).hexdigest()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n\n    >>> string_to_md5('Hello world') == '3e25960a79dbc69b674cd4ec67a72c62'\n    \"\"\"\n    if text == \"\":\n        return None\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a str\")\n    return hashlib.md5(text.encode(\"utf-8\")).hexdigest()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator and operand, build and evaluate the algebraic expression\n    formed by interleaving them. Operators supported: +, -, *, //, **.\n    \"\"\"\n    # Basic validation\n    if not isinstance(operator, list) or not isinstance(operand, list):\n        raise TypeError(\"operator and operand must be lists\")\n    if len(operator) != len(operand) - 1:\n        raise ValueError(\"operator length must be operand length minus one\")\n    if len(operator) < 1:\n        raise ValueError(\"operator list must contain at least one operator\")\n    # Validate operands\n    for x in operand:\n        if not isinstance(x, int):\n            raise TypeError(\"all operands must be integers\")\n        if x < 0:\n            raise ValueError(\"operands must be non-negative integers\")\n    # Validate operators\n    allowed_ops = {\"+\", \"-\", \"*\", \"//\", \"**\"}\n    for op in operator:\n        if op not in allowed_ops:\n            raise ValueError(f\"unsupported operator: {op}\")\n\n    # Build token list: operand0, op0, operand1, op1, operand2, ...\n    tokens = []\n    for i, op in enumerate(operator):\n        tokens.append(operand[i])\n        tokens.append(op)\n    tokens.append(operand[-1])\n\n    # Shunting-yard parameters\n    precedence = {\"+\": 1, \"-\": 1, \"*\": 2, \"//\": 2, \"**\": 3}\n    right_associative = {\"**\"}\n\n    # Convert infix tokens to RPN (postfix)\n    output_queue = []\n    op_stack = []\n    for tok in tokens:\n        if isinstance(tok, int):\n            output_queue.append(tok)\n        else:\n            # tok is an operator\n            while op_stack:\n                top = op_stack[-1]\n                if top not in precedence:\n                    break\n                # Pop while (top has greater precedence) or\n                # (top has equal precedence and tok is left-associative)\n                if (precedence[top] > precedence[tok]) or (\n                    precedence[top] == precedence[tok] and tok not in right_associative\n                ):\n                    output_queue.append(op_stack.pop())\n                else:\n                    break\n            op_stack.append(tok)\n    while op_stack:\n        output_queue.append(op_stack.pop())\n\n    # Evaluate RPN\n    eval_stack = []\n    for tok in output_queue:\n        if isinstance(tok, int):\n            eval_stack.append(tok)\n        else:\n            # operator: binary\n            if len(eval_stack) < 2:\n                raise ValueError(\"invalid expression\")\n            b = eval_stack.pop()\n            a = eval_stack.pop()\n            if tok == \"+\":\n                res = a + b\n            elif tok == \"-\":\n                res = a - b\n            elif tok == \"*\":\n                res = a * b\n            elif tok == \"//\":\n                # Let Python raise ZeroDivisionError if b == 0\n                res = a // b\n            elif tok == \"**\":\n                res = a ** b\n            else:\n                raise ValueError(f\"unsupported operator during eval: {tok}\")\n            eval_stack.append(res)\n\n    if len(eval_stack) != 1:\n        raise ValueError(\"invalid expression evaluation result\")\n    return eval_stack[0]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + )\n    Subtraction ( - )\n    Multiplication ( * )\n    Floor division ( // )\n    Exponentiation ( ** )\n\n    Example:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n    \"\"\"\n    # Validation\n    if not isinstance(operator, (list, tuple)):\n        raise ValueError(\"operator must be a list or tuple\")\n    if not isinstance(operand, (list, tuple)):\n        raise ValueError(\"operand must be a list or tuple\")\n    if len(operand) < 2:\n        raise ValueError(\"operand must contain at least two values\")\n    if len(operator) != len(operand) - 1:\n        raise ValueError(\"operator length must be len(operand) - 1\")\n\n    allowed_ops = {'+', '-', '*', '//', '**'}\n    for op in operator:\n        if op not in allowed_ops:\n            raise ValueError(f\"invalid operator: {op}\")\n\n    # Ensure operands are integers (and non-negative as per spec)\n    for v in operand:\n        if not isinstance(v, int):\n            raise ValueError(\"all operands must be integers\")\n        if v < 0:\n            raise ValueError(\"operands must be non-negative integers\")\n\n    # Operator metadata\n    precedence = {'+': 1, '-': 1, '*': 2, '//': 2, '**': 3}\n    associativity = {'+': 'left', '-': 'left', '*': 'left', '//': 'left', '**': 'right'}\n\n    # Build tokens by interleaving operands and operators\n    tokens = []\n    for i in range(len(operator)):\n        tokens.append(operand[i])\n        tokens.append(operator[i])\n    tokens.append(operand[-1])\n\n    # Shunting-yard: convert to RPN\n    output_queue = []\n    op_stack = []\n\n    for token in tokens:\n        if token in precedence:  # operator\n            while op_stack and op_stack[-1] in precedence:\n                top = op_stack[-1]\n                if (associativity[token] == 'left' and precedence[token] <= precedence[top]) or \\\n                   (associativity[token] == 'right' and precedence[token] < precedence[top]):\n                    output_queue.append(op_stack.pop())\n                else:\n                    break\n            op_stack.append(token)\n        else:  # operand (integer)\n            output_queue.append(token)\n\n    while op_stack:\n        output_queue.append(op_stack.pop())\n\n    # Evaluate RPN\n    rpn_stack = []\n    for token in output_queue:\n        if token in precedence:\n            # Pop right then left\n            right = rpn_stack.pop()\n            left = rpn_stack.pop()\n            if token == '+':\n                res = left + right\n            elif token == '-':\n                res = left - right\n            elif token == '*':\n                res = left * right\n            elif token == '//':\n                res = left // right\n            elif token == '**':\n                res = left ** right\n            rpn_stack.append(res)\n        else:\n            rpn_stack.append(token)\n\n    return rpn_stack[0]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/163": [{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Returns even integers between a and b (inclusive), in ascending order.\n    Handles cases where a > b by always iterating from min(a,b) to max(a,b).\n    \"\"\"\n    start = min(a, b)\n    end = max(a, b)\n    result = []\n    for i in range(start, end + 1):\n        if i % 2 == 0:\n            result.append(i)\n    return result", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[2, 10]], "plus_fail_tests": [[6, 12]]}, {"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even single-digit integers\n    between a and b (inclusive), in ascending order.\n\n    Examples:\n    generate_integers(2, 8) -> [2, 4, 6, 8]\n    generate_integers(8, 2) -> [2, 4, 6, 8]\n    generate_integers(10, 14) -> []\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"a and b must be integers\")\n\n    lo, hi = min(a, b), max(a, b)\n    evens = [0, 2, 4, 6, 8]\n    return [d for d in evens if lo <= d <= hi]", "base_status": "