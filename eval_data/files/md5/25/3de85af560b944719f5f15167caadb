{"task_id": "HumanEval/29", "solution": "def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    filtered_strings = []\n    for s in strings:\n        if s.startswith(prefix):\n            filtered_strings.append(s)\n    return filtered_strings"}
{"task_id": "HumanEval/26", "solution": "from typing import List\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    # Count frequencies of each number.\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    # Filter numbers, keeping only those with a count of 1, preserving original order.\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n\n    return result"}
{"task_id": "HumanEval/27", "solution": "def apply_char_mapping(ch: str) -> str:\n    \"\"\"Applies case flipping to a single character if it's alphabetic.\"\"\"\n    if ch.isalpha():\n        if ch.islower():\n            return ch.upper()\n        else: # ch.isupper() or other alpha (e.g., title case)\n            return ch.lower()\n    return ch\ndef flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    flipped_chars = []\n    for char in string:\n        flipped_chars.append(apply_char_mapping(char))\n    return \"\".join(flipped_chars)"}
{"task_id": "HumanEval/30", "solution": "from typing import Any, List\nfrom dataclasses import dataclass\nclass ResultList:\n    \"\"\"Accumulates elements and returns them as a new list instance.\"\"\"\n    def __init__(self) -> None:\n        self.elements: List[Any] = []\n\n    def append(self, element: Any) -> None:\n        \"\"\"Appends an element to the internal list.\"\"\"\n        self.elements.append(element)\n\n    def to_list(self) -> List[Any]:\n        \"\"\"Returns a new list containing the accumulated elements.\"\"\"\n        return list(self.elements) # Return a copy\nclass PositiveFilter:\n    \"\"\"Implements the filtering algorithm to extract positive numbers.\"\"\"\n    def filter(self, lst: List[Any]) -> List[Any]:\n        \"\"\"Iterates over the input list, filters positive numbers, and returns them in a new list.\"\"\"\n        result_list = ResultList()\n        for element in lst:\n            list_element = ListElement(element)\n            if list_element.is_positive():\n                result_list.append(element)\n        return result_list.to_list()\ndef get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\"\"\"\n    filterer = PositiveFilter()\n    return filterer.filter(l)"}
{"task_id": "HumanEval/31", "solution": "import math\ndef is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    # Check for odd divisors from 3 up to the square root of n\n    # We only need to check odd numbers because even numbers are handled above.\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n            \n    return True"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list) -> list:\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    unique_elements = sorted(list(set(l)))\n    return unique_elements"}
{"task_id": "HumanEval/35", "solution": "def validateListType(l):\n    \"\"\"Checks if the input is of type list.\"\"\"\n    return isinstance(l, list)\ndef validateNonEmpty(l):\n    \"\"\"Checks if the list is non-empty.\"\"\"\n    return bool(l)\ndef _compute_max(l: list):\n    \"\"\"Computes the maximum element in a non-empty list.\"\"\"\n    return max(l)\ndef max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    if not validateListType(l):\n        raise ValueError(\"input must be a list\")\n    if not validateNonEmpty(l):\n        raise ValueError(\"cannot compute max of empty list\")\n    return _compute_max(l)"}
{"task_id": "HumanEval/33", "solution": "class InputList:\n    def __init__(self, items: list):\n        self.items = items\n    def length(self) -> int:\n        return len(self.items)\nclass Element:\n    def __init__(self, index: int, value: any):\n        self.index = index\n        self.value = value\nclass IndexSelector:\n    def is_div_by_three(self, i: int) -> bool:\n        return i % 3 == 0\n    def select(self, items: list) -> list[Element]:\n        return [Element(i, items[i]) for i in range(len(items)) if self.is_div_by_three(i)]\nclass Sorter:\n    def sort(self, values: list) -> list:\n        return sorted(values)\nclass Merger:\n    def merge(self, base_items: list, indices: list[int], sorted_values: list) -> list:\n        result = list(base_items)\n        for k, idx in enumerate(indices):\n            result[idx] = sorted_values[k]\n        return result\nclass ResultList:\n    def __init__(self):\n        self.items = []\n    @staticmethod\n    def create_from(input_list: 'InputList', base_items: list) -> 'ResultList':\n        rl = ResultList()\n        rl.items = base_items\n        return rl\ndef sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    input_list = InputList(items=l)\n    if input_list.length() == 0:\n        return []\n\n    selector = IndexSelector()\n    elements = selector.select(input_list.items)\n    indices = [e.index for e in elements]\n    values = [e.value for e in elements]\n\n    sorter = Sorter()\n    sorted_values = sorter.sort(values)\n\n    base_copy = list(input_list.items)\n    merger = Merger()\n    merged = merger.merge(base_copy, indices, sorted_values)\n\n    result = ResultList.create_from(input_list, merged)\n    return result.items"}
{"task_id": "HumanEval/36", "solution": "from typing import List\nfrom dataclasses import dataclass\nclass MultipleFinder:\n    def findMultiples(self, n: int) -> List[IntegerCandidate]:\n        \"\"\"Find integers less than n divisible by 11 or 13.\"\"\"\n        candidates = []\n        for i in range(n):\n            is_divisible_by_11 = (i % 11 == 0)\n            is_divisible_by_13 = (i % 13 == 0)\n            if is_divisible_by_11 or is_divisible_by_13:\n                candidates.append(IntegerCandidate(value=i, divisibleBy11=is_divisible_by_11, divisibleBy13=is_divisible_by_13))\n        return candidates\nclass DigitCounter:\n    def countDigitOccurrences(self, number: int, digit: int) -> int:\n        \"\"\"Count occurrences of a specific digit in a number's decimal representation.\"\"\"\n        if number < 0:\n            number = abs(number)\n        return str(number).count(str(digit))\nclass Aggregator:\n    def aggregate(self, counts: List[int]) -> int:\n        \"\"\"Sum a list of integer counts.\"\"\"\n        return sum(counts)\nclass FizzBuzzService:\n    def __init__(self, multiple_finder: MultipleFinder = None, digit_counter: DigitCounter = None, aggregator: Aggregator = None):\n        \"\"\"Initialize FizzBuzzService with optional dependency injection for components.\"\"\"\n        self._multiple_finder = multiple_finder if multiple_finder is not None else MultipleFinder()\n        self._digit_counter = digit_counter if digit_counter is not None else DigitCounter()\n        self._aggregator = aggregator if aggregator is not None else Aggregator()\n\n    def compute(self, n: int) -> int:\n        \"\"\"Orchestrate the FizzBuzz logic to compute the total count of digit 7.\"\"\"\n        param = Parameter(n)\n        if not param.isValid():\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n        candidates = self._multiple_finder.findMultiples(n)\n        \n        occurrences_per_candidate = []\n        for candidate in candidates:\n            occurrences_per_candidate.append(self._digit_counter.countDigitOccurrences(candidate.value, 7))\n        \n        total_count = self._aggregator.aggregate(occurrences_per_candidate)\n        return total_count\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    service = FizzBuzzService()\n    return service.compute(n)"}
{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\nclass Polynomial:\n    \"\"\"Encapsulates polynomial coefficients and evaluation logic.\"\"\"\n\n    def __init__(self, coefficients: list):\n        self.coefficients = coefficients\n\n    def degree(self) -> int:\n        return len(self.coefficients) - 1\n\n    def evaluate(self, x: float) -> float:\n        return poly(self.coefficients, x)\nclass Constraint:\n    \"\"\"Validates polynomial coefficient lists for root finding.\"\"\"\n\n    def is_valid(self, xs: list) -> bool:\n        return len(xs) % 2 == 0 and len(xs) > 0 and xs[-1] != 0\nclass Root:\n    \"\"\"Represents a found root value.\"\"\"\n\n    def __init__(self, value: float):\n        self.value = value\nclass RootFinder:\n    \"\"\"Finds a single real root of a polynomial using bracket expansion and bisection.\"\"\"\n\n    def __init__(self, tolerance: float = 1e-9, max_iterations: int = 1000):\n        self.tolerance = tolerance\n        self.max_iterations = max_iterations\n\n    def _bisect(self, p: Polynomial, a: float, b: float) -> float:\n        if a > b:  # Ensure a < b for consistent interval handling\n            a, b = b, a\n\n        fa = p.evaluate(a)\n        fb = p.evaluate(b)\n\n        if abs(fa) < self.tolerance:\n            return a\n        if abs(fb) < self.tolerance:\n            return b\n\n        # If fa and fb have the same sign, bisection method is not directly applicable.\n        # The calling 'find' method is designed to ensure fa*fb < 0.\n        # This check is a safeguard if _bisect is called incorrectly.\n        if fa * fb > 0:\n            return (a + b) / 2 # Return mid point as an approximation\n\n        for _ in range(self.max_iterations):\n            mid = (a + b) / 2\n            fmid = p.evaluate(mid)\n\n            if abs(fmid) < self.tolerance:\n                return mid\n\n            if fa * fmid < 0:\n                b = mid\n                fb = fmid\n            else:\n                a = mid\n                fa = fmid\n        return (a + b) / 2\n\n    def find(self, polynomial: Polynomial) -> Root:\n        # Check if 0.0 is a root\n        f_at_0 = polynomial.evaluate(0.0)\n        if abs(f_at_0) < self.tolerance:\n            return Root(0.0)\n\n        # Initialize previous function values for positive and negative scans\n        f_prev_pos = f_at_0\n        f_prev_neg = f_at_0\n\n        # Scan outwards from 0 in increasing magnitude symmetric order\n        for k in range(1, self.max_iterations + 1):\n            x_curr_pos = float(k)\n            x_curr_neg = float(-k)\n\n            # Check positive side bracket (k-1, k)\n            f_curr_pos = polynomial.evaluate(x_curr_pos)\n            if abs(f_curr_pos) < self.tolerance:\n                return Root(x_curr_pos)\n            if f_prev_pos * f_curr_pos < 0:\n                return Root(self._bisect(polynomial, x_curr_pos - 1, x_curr_pos))\n            f_prev_pos = f_curr_pos\n\n            # Check negative side bracket (-k, -(k-1))\n            f_curr_neg = polynomial.evaluate(x_curr_neg)\n            if abs(f_curr_neg) < self.tolerance:\n                return Root(x_curr_neg)\n            if f_prev_neg * f_curr_neg < 0:\n                return Root(self._bisect(polynomial, x_curr_neg, x_curr_neg + 1))\n            f_prev_neg = f_curr_neg\n        \n        # As per the problem description, a solution is guaranteed for valid inputs.\n        # Therefore, a root should always be found within the specified max_iterations,\n        # and this line should ideally be unreachable.\ndef find_zero(xs: list) -> float:\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    constraint_validator = Constraint()\n    if not constraint_validator.is_valid(xs):\n        raise ValueError(\"xs must have even length and non-zero leading coefficient\")\n\n    polynomial = Polynomial(coefficients=xs)\n    root_finder = RootFinder()\n    root = root_finder.find(polynomial)\n\n    return root.value"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/37", "solution": "class ListInput:\n    \"\"\"Represents the input list as a domain object.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\nclass ListOutput:\n    \"\"\"Represents and builds the output list.\"\"\"\n    def __init__(self, length: int):\n        self.elements = [None] * length\n\n    def to_list(self) -> list:\n        \"\"\"Returns the composed Python list.\"\"\"\n        return self.elements\nclass IndexParity:\n    \"\"\"Utility for checking index parity (0-based).\"\"\"\n    @staticmethod\n    def isEven(index: int) -> bool:\n        \"\"\"Checks if an index is even.\"\"\"\n        return index % 2 == 0\n\n    @staticmethod\n    def isOdd(index: int) -> bool:\n        \"\"\"Checks if an index is odd.\"\"\"\n        return not IndexParity.isEven(index)\nclass EvenValueExtractor:\n    \"\"\"Extracts values at even indices.\"\"\"\n    def extractEvenValues(self, elements: list) -> list:\n        \"\"\"Returns a list of values from even indices, preserving their relative order.\"\"\"\n        even_values = []\n        for i in range(len(elements)):\n            if IndexParity.isEven(i):\n                even_values.append(elements[i])\n        return even_values\nclass OddValuePreserver:\n    \"\"\"Records values at odd indices for reinsertion.\"\"\"\n    def preserveOddPositions(self, elements: list) -> dict:\n        \"\"\"Returns a dictionary mapping odd indices to their values.\"\"\"\n        preserved_odds = {}\n        for i in range(len(elements)):\n            if IndexParity.isOdd(i):\n                preserved_odds[i] = elements[i]\n        return preserved_odds\nclass Sorter:\n    \"\"\"Sorts a list of values using Python's default ordering.\"\"\"\n    def sort(self, values: list) -> list:\n        \"\"\"Returns a new list with values sorted in non-decreasing order.\"\"\"\n        return sorted(values)\nclass Recombiner:\n    \"\"\"Recombines sorted even values and preserved odd values into a final list.\"\"\"\n    def recombine(self, sortedEvenValues: list, preservedOdds: dict, length: int) -> list:\n        \"\"\"Creates a list of specified length, filling even indices from sortedEvenValues and odd indices from preservedOdds.\"\"\"\n        output_list_obj = ListOutput(length)\n        even_idx_counter = 0\n        for i in range(length):\n            if IndexParity.isEven(i):\n                output_list_obj.elements[i] = sortedEvenValues[even_idx_counter]\n                even_idx_counter += 1\n            else: # Odd index\n                output_list_obj.elements[i] = preservedOdds[i]\n        return output_list_obj.to_list()\ndef sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    input_obj = ListInput(l)\n\n    extractor = EvenValueExtractor()\n    preserver = OddValuePreserver()\n    sorter = Sorter()\n    recombiner = Recombiner()\n\n    even_values = extractor.extractEvenValues(input_obj.elements)\n    preserved_odds = preserver.preserveOddPositions(input_obj.elements)\n\n    sorted_evens = sorter.sort(even_values)\n\n    result = recombiner.recombine(sorted_evens, preserved_odds, len(input_obj.elements))\n\n    return result"}
{"task_id": "HumanEval/39", "solution": "class PrimeTester:\n    \"\"\"Determines if a number is prime using trial division.\"\"\"\n    def is_prime(self, x: int) -> bool:\n        if x < 2:\n            return False\n        if x == 2 or x == 3:\n            return True\n        if x % 2 == 0 or x % 3 == 0:\n            return False\n        i = 5\n        while i * i <= x:\n            if x % i == 0 or x % (i + 2) == 0:\n                return False\n            i += 6\n        return True\nclass FibonacciSequence:\n    \"\"\"Generates Fibonacci numbers iteratively according to F0=0, F1=1.\"\"\"\n    def __init__(self):\n        self._prev = 0\n        self._curr = 1\n        self._index = 0\n\n    def reset(self) -> None:\n        self._prev = 0\n        self._curr = 1\n        self._index = 0\n\n    def generate_next(self) -> int:\n        \"\"\"Generates and returns the next Fibonacci number in sequence.\"\"\"\n        if self._index == 0:\n            current_fib_val = 0 # F0\n        elif self._index == 1:\n            current_fib_val = 1 # F1\n        else:\n            current_fib_val = self._prev + self._curr\n            self._prev = self._curr\n            self._curr = current_fib_val\n        \n        self._index += 1\n        return current_fib_val\n\n    def get_current_index(self) -> int:\n        \"\"\"Returns the index of the last generated Fibonacci number.\"\"\"\n        return self._index - 1\nclass InputValidator:\n    \"\"\"Validates input type and value, raising TypeError or ValueError.\"\"\"\n    def validate_type(self, n) -> None:\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n\n    def validate_value(self, n: int) -> None:\n        if n < 1:\n            raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\nclass PrimeFibService:\n    \"\"\"Coordinates Fibonacci generation and primality testing to find the Nth Fibonacci prime.\"\"\"\n    def __init__(self):\n        self._validator = InputValidator()\n        self._generator = FibonacciSequence()\n        self._tester = PrimeTester()\n\n    def prime_fib(self, n: int) -> int:\n        self._validator.validate_type(n)\n        self._validator.validate_value(n)\n\n        self._generator.reset()\n        prime_count = 0\n        \n        while prime_count < n:\n            fib_value = self._generator.generate_next()\n            # F0=0, F1=1, F2=1 are not prime by definition or test.\n            if self._tester.is_prime(fib_value):\n                prime_count += 1\n                if prime_count == n:\n                    return fib_value\n        \n        # This part should not be reached under normal circumstances as Fibonacci primes are infinite.\n        return -1\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    service = PrimeFibService()\n    return service.prime_fib(n)"}
{"task_id": "HumanEval/40", "solution": "from typing import Optional, Tuple, List\nclass TriplesSumZeroService:\n    def triples_sum_to_zero(self, l: list) -> bool:\n        \"\"\"Return True if any three distinct indices in l sum to zero, else False.\"\"\"\n        return self._find_triplet(l) is not None\n\n    def _find_triplet(self, l: list) -> Optional[Tuple[int, int, int]]:\n        \"\"\"Deterministic search for indices (i, j, k) with l[i] + l[j] + l[k] == 0.\n        Returns a tuple of indices if found, else None.\"\"\"\n        n = len(l)\n        for i in range(n - 2):\n            for j in range(i + 1, n - 1):\n                for k in range(j + 1, n):\n                    if l[i] + l[j] + l[k] == 0:\n                        return (i, j, k)\n        return None\ndef triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n\n    >>> triples_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> triples_sum_to_zero([1, 3, -2, 1])\n    True\n    >>> triples_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> triples_sum_to_zero([2, 4, -5, 3, 9, 7])\n    True\n    >>> triples_sum_to_zero([1])\n    False\n    \"\"\"\n    _validate_input(l)\n    \n    if len(l) < 3:\n        return False\n\n    svc = TriplesSumZeroService()\n    return svc.triples_sum_to_zero(l)"}
