{"task_id": "HumanEval/25", "solution": "from typing import List\nclass InputNumber:\n    \"\"\"Represents an input number for factorization.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_valid_for_factorization(self) -> bool:\n        \"\"\"Checks if the input number is valid for factorization.\"\"\"\n        return self.value >= 2\nclass PrimeFactor:\n    \"\"\"Represents a prime factor with its multiplicity.\"\"\"\n    def __init__(self, value: int, multiplicity: int = 1) -> None:\n        self.value = value\n        self.multiplicity = multiplicity\nclass FactorizationResult:\n    \"\"\"Encapsulates the list of factors and provides a product verification method.\"\"\"\n    def __init__(self, factors: List[int]) -> None:\n        self.factors = factors\n\n    def product(self) -> int:\n        \"\"\"Calculates the product of all factors.\"\"\"\n        res = 1\n        for factor in self.factors:\n            res *= factor\n        return res\ndef _trial_division(n: int) -> List[PrimeFactor]:\n    \"\"\"Computes prime factors of n using trial division.\"\"\"\n    prime_factors: List[PrimeFactor] = []\n    d = 2\n    temp_n = n\n\n    while d * d <= temp_n:\n        if temp_n % d == 0:\n            count = 0\n            while temp_n % d == 0:\n                temp_n //= d\n                count += 1\n            prime_factors.append(PrimeFactor(d, count))\n        d += 1\n\n    if temp_n > 1:\n        prime_factors.append(PrimeFactor(temp_n, 1))\n\n    return prime_factors\ndef _flatten_factors(prime_factors: List[PrimeFactor]) -> List[int]:\n    \"\"\"Expands PrimeFactor objects into a list of integers with preserved multiplicities.\"\"\"\n    flat_factors: List[int] = []\n    for pf in prime_factors:\n        flat_factors.extend([pf.value] * pf.multiplicity)\n    return flat_factors\nclass FactorizerService:\n    \"\"\"Orchestrates the prime factorization process.\"\"\"\n    def _validate_input(self, n: int) -> InputNumber:\n        \"\"\"Validates the input number and returns an InputNumber object.\"\"\"\n        input_num = InputNumber(n)\n        if not input_num.is_valid_for_factorization():\n            raise ValueError(\"Input number must be an integer greater than or equal to 2.\")\n        return input_num\n\n    def factorize(self, n: int) -> List[int]:\n        \"\"\"Performs the full prime factorization pipeline.\"\"\"\n        input_num = self._validate_input(n)\n        \n        prime_factors_with_multiplicity = _trial_division(input_num.value)\n        expanded_factors = _flatten_factors(prime_factors_with_multiplicity)\n        \n        expanded_factors.sort() \n        \n        result = FactorizationResult(expanded_factors)\n        if result.product() != input_num.value:\n            raise ValueError(\"Product of factors does not match the original number. Internal inconsistency.\")\n            \n        return expanded_factors\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    service = FactorizerService()\n    return service.factorize(n)"}
