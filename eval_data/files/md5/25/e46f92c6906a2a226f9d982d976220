{"task_id": "Mbpp/292", "solution": "def find(dividend: float, divisor: float) -> int:\n    \"\"\"Calculates the quotient of two numbers, rounded down to the nearest integer.\n    This function implements the core logic described in the Quotient Calculator design.\"\"\"\n\n    # Perform floating-point division.\n    floating_point_quotient = dividend / divisor\n\n    # Manually apply floor function to round down, as external math functions are restricted.\n    # int() truncates towards zero. For negative non-integers, we need to subtract 1 to floor.\n    integer_quotient_rounded_down = int(floating_point_quotient)\n    if floating_point_quotient < 0 and floating_point_quotient != integer_quotient_rounded_down:\n        integer_quotient_rounded_down -= 1\n\n    return integer_quotient_rounded_down"}
{"task_id": "Mbpp/286", "solution": "def _kadane(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum subarray sum for a single array using Kadane's algorithm.\n    It correctly handles arrays where all numbers are negative.\n    \"\"\"\n    max_so_far = arr[0]\n    current_max = arr[0]\n    for i in range(1, len(arr)):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n    return max_so_far\ndef _calculate_max_prefix_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum sum of any prefix subarray of the given array.\n    It iterates from the start, accumulating sums and tracking the maximum.\n    \"\"\"\n    current_sum = 0\n    max_prefix_sum = float('-inf')\n    for x in arr:\n        current_sum += x\n        max_prefix_sum = max(max_prefix_sum, current_sum)\n    return max_prefix_sum\ndef _calculate_max_suffix_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum sum of any suffix subarray of the given array.\n    It iterates from the end, accumulating sums and tracking the maximum.\n    \"\"\"\n    current_sum = 0\n    max_suffix_sum = float('-inf')\n    for x in reversed(arr):\n        current_sum += x\n        max_suffix_sum = max(max_suffix_sum, current_sum)\n    return max_suffix_sum\ndef max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in an array repeated k times.\n    It uses Kadane's for single array, and prefix/suffix sums for repeated arrays.\n    \"\"\"\n    # Calculate max subarray sum for a single instance of arr.\n    max_sum_single_array = _kadane(arr)\n\n    # If k is 1, the problem is identical to Kadane's algorithm on the original array.\n    if k == 1:\n        return max_sum_single_array\n\n    # Calculate total sum of the array.\n    total_arr_sum = sum(arr)\n\n    # Calculate maximum prefix sum and maximum suffix sum of the array.\n    max_prefix = _calculate_max_prefix_sum(arr)\n    max_suffix = _calculate_max_suffix_sum(arr)\n\n    # The overall maximum sum is initially the max sum from a single array.\n    overall_max_sum = max_sum_single_array\n\n    # Consider sums that span across two instances of the array (e.g., suffix of first + prefix of second).\n    # This is a candidate for the maximum sum.\n    overall_max_sum = max(overall_max_sum, max_suffix + max_prefix)\n\n    # If k > 2 and the total array sum is positive,\n    # we can potentially include (k-2) full positive sums of the array in the middle.\n    if k > 2 and total_arr_sum > 0:\n        overall_max_sum = max(overall_max_sum, max_suffix + (k - 2) * total_arr_sum + max_prefix)\n\n    return overall_max_sum"}
