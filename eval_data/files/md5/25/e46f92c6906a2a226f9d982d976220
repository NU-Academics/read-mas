{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using dynamic programming based on the Bell triangle.\n    This implementation adheres to the specified construction and ensures accurate results for base cases.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input n must be non-negative\")\n    if n == 0:\n        return 1\n\n    # Initialize a 2D array (list of lists) to construct the Bell triangle.\n    # The size is (n + 1) x (n + 1) to accommodate indices up to n.\n    bell_triangle = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Initialize the first element of the Bell triangle, which is B_0.\n    bell_triangle[0][0] = 1\n\n    # Construct the Bell triangle row by row.\n    for i in range(1, n + 1):\n        # The first element of the current row is the last element of the previous row.\n        bell_triangle[i][0] = bell_triangle[i - 1][i - 1]\n        # Fill the rest of the current row.\n        for j in range(1, i + 1):\n            # Each element is the sum of the element to its left and the element directly above it.\n            bell_triangle[i][j] = bell_triangle[i][j - 1] + bell_triangle[i - 1][j - 1]\n\n    # The nth Bell number is found at the first element of the nth row (bell_triangle[n][0]).\n    return bell_triangle[n][0]"}
{"task_id": "Mbpp/607", "solution": "import re\ndef find_literals(text: str, pattern: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Searches a string for a regex pattern. The function returns the matching substring,\n    a start index, and an end index.\n\n    Args:\n        text (str): The string to search within.\n        pattern (str): The regex pattern to search for.\n\n    Returns:\n        tuple[str, int, int] | None: A tuple containing the matching substring,\n        its start index, and its end index if a match is found. Returns None otherwise.\n    \"\"\"\n    match = re.search(pattern, text)\n    if match:\n        return (match.group(0), match.start(), match.end())\n    return None"}
{"task_id": "Mbpp/607", "solution": "import re\ndef find_literals(text: str, pattern: str):\n    \"\"\"\n    Searches a text string for the first occurrence of a regex pattern.\n    Returns the matched substring, its start and exclusive end indices, or None if no match.\n    \"\"\"\n    match = re.search(pattern, text)\n    if match:\n        matched_substring = match.group(0)\n        start_index = match.start()\n        end_index = match.end()\n        return (matched_substring, start_index, end_index)\n    else:\n        return None"}
