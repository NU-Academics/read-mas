{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers. Returns an integer.\n    \"\"\"\n    sum_n = n * (n + 1) // 2\n    sum_cubes = sum_n * sum_n\n    result_difference = sum_cubes - sum_n\n    return result_difference"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr: list[int], n: int) -> int:\n    \"\"\"\n    Counts pairs (a, b) in arr such that their bitwise XOR sum (a ^ b) is odd.\n    This occurs when one operand is even and the other is odd.\n    \"\"\"\n    count_even = 0\n    count_odd = 0\n\n    for x in arr:\n        if x % 2 == 0:\n            count_even += 1\n        else:\n            count_odd += 1\n\n    return count_even * count_odd"}
{"task_id": "Mbpp/555", "solution": "def _calculate_sum_of_cubes(n):\n    \"\"\"Calculates the sum of cubes for the first n natural numbers.\"\"\"\n    return sum(i**3 for i in range(1, n + 1))\ndef _calculate_sum_of_natural_numbers(n):\n    \"\"\"Calculates the sum of the first n natural numbers.\"\"\"\n    return sum(range(1, n + 1))\ndef difference(n):\n    \"\"\"\n    Calculates the difference between the sum of cubes and sum of natural numbers.\n    Assumes 'n' is a natural number (positive integer) as per requirements.\n    \"\"\"\n    sum_cubes = _calculate_sum_of_cubes(n)\n    sum_numbers = _calculate_sum_of_natural_numbers(n)\n    return sum_cubes - sum_numbers"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n):\n    \"\"\"\n    Counts the number of unique pairs in a list whose bitwise XOR value is odd.\n    Iterates through all pairs (arr[i], arr[j]) with i < j and checks their XOR result.\n    \"\"\"\n    odd_pair_count = 0\n\n    # Iterate through all unique pairs (arr[i], arr[j]) where i < j\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            # Compute the bitwise XOR value\n            xor_value = arr[i] ^ arr[j]\n\n            # Check if the XOR value is odd\n            if xor_value % 2 != 0:\n                odd_pair_count += 1\n\n    return odd_pair_count"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in the input string.\n    Non-alphabetic characters remain unchanged, and a new string is returned.\"\"\"\n    result_chars = []\n    for char in input_string:\n        if char.isalpha():\n            if char.isupper():\n                result_chars.append(char.lower())\n            else:  # Must be lowercase if alphabetic and not uppercase\n                result_chars.append(char.upper())\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
