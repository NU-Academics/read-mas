{"task_id": "Mbpp/260", "solution": "def _is_prime(num: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a prime number.\n    Uses trial division up to the square root of the number.\n    \"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    # Check for divisibility by odd numbers from 3 up to the square root.\n    i = 3\n    while i * i <= num:\n        if num % i == 0:\n            return False\n        i += 2\n    return True\ndef _get_nsw_number(k: int) -> int:\n    \"\"\"\n    Calculates the kth Newman-Shanks-Williams number S_k.\n    Uses the recurrence relation S_0 = 1, S_1 = 1, S_n = 2S_{n-1} + S_{n-2}.\n    \"\"\"\n    if k == 0:\n        return 1\n    if k == 1:\n        return 1\n\n    s_prev2 = 1 # Represents S_{k-2}\n    s_prev1 = 1 # Represents S_{k-1}\n\n    for _ in range(2, k + 1):\n        s_current = 2 * s_prev1 + s_prev2\n        s_prev2 = s_prev1\n        s_prev1 = s_current\n\n    return s_prev1\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman-Shanks-Williams prime number.\n    It iterates through NSW numbers (S_k), checking each for primality.\n    \"\"\"\n    found_primes_count = 0\n    k = 0\n    while True:\n        nsw_num = _get_nsw_number(k)\n        if _is_prime(nsw_num):\n            found_primes_count += 1\n            if found_primes_count == n:\n                return nsw_num\n        k += 1"}
{"task_id": "Mbpp/260", "solution": "def _is_prime(num):\n    \"\"\"Checks if a number is prime. Returns True if prime, False otherwise.\"\"\"\n    if num < 2:\n        return False\n    for i in range(2, int(num**0.5) + 1):\n        if num % i == 0:\n            return False\n    return True\ndef _calculate_s_n(n):\n    \"\"\"Calculates the nth term of the Newman-Shanks-Williams sequence S_n.\"\"\"\n    if n == 0:\n        return 1\n    if n == 1:\n        return 1\n    s_n_minus_2 = 1  # Corresponds to S_0\n    s_n_minus_1 = 1  # Corresponds to S_1\n    for _ in range(2, n + 1):\n        s_n_current = 2 * s_n_minus_1 + s_n_minus_2\n        s_n_minus_2 = s_n_minus_1\n        s_n_minus_1 = s_n_current\n    return s_n_minus_1\ndef newman_prime(n):\n    \"\"\"Finds the nth Newman-Shanks-Williams prime number based on the given design specifications.\n    This function counts prime terms in the S_k sequence.\n    \"\"\"\n    primes_found_count = 0\n    k = 0\n    while True:\n        s_k = _calculate_s_n(k)\n\n        # The design implies checking S_n / 2. As S_n is always odd, S_n / 2 is never integer.\n        # This implementation interprets the intent as checking S_k for primality itself.\n        if s_k > 1 and _is_prime(s_k):\n            primes_found_count += 1\n            # The condition 'primes_found_count == n - 1' makes newman_prime(3) return 7.\n            if primes_found_count == n - 1:\n                return s_k\n        k += 1"}
