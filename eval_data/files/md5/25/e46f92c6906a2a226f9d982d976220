{"task_id": "Mbpp/296", "solution": "def _mergeAndCount(left: list, right: list) -> tuple[int, list]:\n    \"\"\"Merges two sorted lists, counting inversions formed between them.\"\"\"\n    merged_list = []\n    inversion_count = 0\n    i, j = 0, 0\n    left_len, right_len = len(left), len(right)\n\n    while i < left_len and j < right_len:\n        if left[i] <= right[j]:\n            merged_list.append(left[i])\n            i += 1\n        else:\n            merged_list.append(right[j])\n            inversion_count += (left_len - i)  # All remaining elements in left are inversions with right[j]\n            j += 1\n\n    merged_list.extend(left[i:])\n    merged_list.extend(right[j:])\n\n    return inversion_count, merged_list\ndef _mergeSortAndCount(arr: list) -> tuple[int, list]:\n    \"\"\"Recursively sorts a list and counts inversions using a merge sort approach.\"\"\"\n    n = len(arr)\n    if n <= 1:\n        return 0, arr\n\n    mid = n // 2\n    left_arr = arr[:mid]\n    right_arr = arr[mid:]\n\n    left_inversions, sorted_left = _mergeSortAndCount(left_arr)\n    right_inversions, sorted_right = _mergeSortAndCount(right_arr)\n\n    merge_inversions, merged_sorted_arr = _mergeAndCount(sorted_left, sorted_right)\n\n    total_inversions = left_inversions + right_inversions + merge_inversions\n    return total_inversions, merged_sorted_arr\ndef get_Inv_Count(arr: list) -> int:\n    \"\"\"Calculates the total number of inversions in the input array.\"\"\"\n    inversions, _ = _mergeSortAndCount(arr)\n    return inversions"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: list) -> int:\n    \"\"\"\n    Counts inversions in a given array using a nested loop approach.\n    An inversion is a pair (arr[i], arr[j]) such that i < j and arr[i] > arr[j].\n    \"\"\"\n    inv_count = 0\n    n = len(arr)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if arr[i] > arr[j]:\n                inv_count += 1\n    return inv_count"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(input_data):\n    \"\"\"Aggregates scores for names and finds the name with the maximum total score.\"\"\"\n    if not input_data:\n        return (None, 0)\n\n    aggregated_scores = {}\n    for name, score in input_data:\n        aggregated_scores[name] = aggregated_scores.get(name, 0) + score\n\n    # Determine the name and score with the highest aggregate total.\n    name_with_max_score, max_score = max(aggregated_scores.items(), key=lambda item: item[1])\n\n    return (name_with_max_score, max_score)"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(input_list: list) -> list:\n    \"\"\"Flattens a nested list into a single-level list using recursion.\n    It distinguishes list elements by attempting iteration, avoiding explicit type checks.\"\"\"\n    flattened = []\n    for element in input_list:\n        try:\n            # Attempt to iterate over the element. If it succeeds, it's iterable.\n            # For the given problem, this implies it's a list to be recursively flattened.\n            _ = iter(element)\n            flattened.extend(flatten_list(element))\n        except TypeError:\n            # If not iterable (e.g., an integer), it's an atomic element to be appended directly.\n            flattened.append(element)\n    return flattened"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(data: list[tuple[str, int | float]]) -> tuple[str | None, int | float | None]:\n    \"\"\"\n    Aggregates scores for names and finds the name with the maximum aggregate score.\n    Returns (None, 0) if input data is empty.\n    \"\"\"\n    aggregates = {}\n    for name, score in data:\n        aggregates[name] = aggregates.get(name, 0) + score\n\n    if not aggregates:\n        return (None, 0)\n\n    max_name = None\n    max_score = float('-inf')\n\n    for name, score in aggregates.items():\n        if score > max_score:\n            max_score = score\n            max_name = name\n\n    return (max_name, max_score)"}
{"task_id": "Mbpp/300", "solution": "import math\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Calculates the count of binary sequences of length 2n where the sum of the first n bits equals the sum of the last n bits.\n    This is equivalent to C(2n, n), utilizing math.comb for efficiency.\n    \"\"\"\n    # The count is given by the binomial coefficient \"2n choose n\".\n    result = math.comb(2 * n, n)\n    # Return the numerical result as a float.\n    return float(result)"}
{"task_id": "Mbpp/300", "solution": "import math\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Calculates the count of binary sequences of length 2n such that the sum of the first n bits\n    equals the sum of the last n bits. It sums the square of combinations C(n, k) for k from 0 to n.\n    \"\"\"\n    total_count = 0.0\n    for k in range(n + 1):\n        combinations_for_k = math.comb(n, k)\n        total_count += float(combinations_for_k * combinations_for_k)\n    return total_count"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(input_dict: dict) -> int:\n    \"\"\"Calculates the maximum nesting depth of a dictionary.\n    This function recursively finds the deepest nested dictionary.\"\"\"\n    max_sub_depth = 0\n    for value in input_dict.values():\n        if isinstance(value, dict):\n            current_sub_depth = dict_depth(value)\n            if current_sub_depth > max_sub_depth:\n                max_sub_depth = current_sub_depth\n    return 1 + max_sub_depth"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(input_dict: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of dictionaries within the input_dict.\n    The depth is determined by the number of nested dictionary levels.\n    \"\"\"\n    max_nested_depth = 0\n    for value in input_dict.values():\n        if isinstance(value, dict):\n            max_nested_depth = max(max_nested_depth, dict_depth(value))\n    return 1 + max_nested_depth"}
{"task_id": "Mbpp/305", "solution": "def start_withp(input_list: list[str]) -> tuple[str, str]:\n    \"\"\"\n    Identifies and returns the first two words starting with 'p' (case-insensitive).\n    Processes a list of strings, splitting them into individual words.\n    \"\"\"\n    found_words = []\n    for s in input_list:\n        words = s.split()\n        for word in words:\n            if word.lower().startswith('p'):\n                found_words.append(word)\n                if len(found_words) == 2:\n                    return tuple(found_words)\n    # The design implies exactly two words will always be found.\n    # In a real-world scenario, robust error handling or default return would be needed,\n    # but per instructions, we trust the input guarantees two words are present.\n    return tuple(found_words) # This line would only be reached if input guarantees are violated."}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(array, length, i, k):\n    \"\"\"Calculates the maximum sum of an increasing subsequence from array[0...i] that includes array[k].\n    The element array[k] must be greater than the last element chosen from array[0...i].\n    \"\"\"\n    if k <= i:\n        return 0\n\n    # Initialize dp_prefix_sums array to store maximum sum of increasing subsequence ending at each index j in [0...i].\n    dp_prefix_sums = [0] * (i + 1)\n\n    for j in range(i + 1):\n        dp_prefix_sums[j] = array[j] # An increasing subsequence ending at j can be just array[j] itself.\n        for p in range(j):\n            if array[j] > array[p]:\n                dp_prefix_sums[j] = max(dp_prefix_sums[j], dp_prefix_sums[p] + array[j])\n\n    # Calculate max_sum_from_prefix considering elements from [0...i] that array[k] can extend.\n    max_sum_from_prefix = 0\n    for j in range(i + 1):\n        if array[k] > array[j]:\n            max_sum_from_prefix = max(max_sum_from_prefix, dp_prefix_sums[j])\n\n    # The final maximum sum is the sum from the prefix plus the mandatory array[k].\n    final_max_sum = max_sum_from_prefix + array[k]\n    return final_max_sum"}
{"task_id": "Mbpp/308", "solution": "def large_product(list1: list[int], list2: list[int], k: int) -> list[int]:\n    \"\"\"\n    Computes and returns the k largest products formed by multiplying one element\n    from list1 and one element from list2, sorted in descending order.\n    \"\"\"\n    if k <= 0 or not list1 or not list2:\n        return []\n\n    all_products = []\n    for x in list1:\n        for y in list2:\n            all_products.append(x * y)\n\n    all_products.sort(reverse=True)\n\n    return all_products[:k]"}
