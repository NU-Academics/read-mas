{"task_id": "Mbpp/61", "solution": "def _calculate_digit_sum(s: str) -> int:\n    \"\"\"Calculates the sum of numerical digits within a given string. Non-digit characters are ignored.\"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isdigit():\n            total_sum += int(char)\n    return total_sum\ndef count_Substrings(input_string: str) -> int:\n    \"\"\"Counts substrings where the sum of digits equals the substring's length.\"\"\"\n    count = 0\n    n = len(input_string)\n    for i in range(n):\n        for j in range(i, n):\n            substring = input_string[i:j+1]\n            substring_length = len(substring)\n            digit_sum = _calculate_digit_sum(substring)\n            if digit_sum == substring_length:\n                count += 1\n    return count"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(input_string: str) -> int:\n    \"\"\"\n    Counts substrings where the sum of digits equals the substring's length.\n    It expects the input string to contain only digit characters.\n    \"\"\"\n    count = 0\n    n = len(input_string)\n\n    # Iterate through all possible start indices.\n    for i in range(n):\n        current_sum = 0\n        # Iterate through all possible end indices for the current start.\n        for j in range(i, n):\n            # Add the current digit to the running sum.\n            digit = int(input_string[j])\n            current_sum += digit\n\n            # Calculate the length of the current substring.\n            current_length = (j - i) + 1\n\n            # Check if sum of digits equals the substring's length.\n            if current_sum == current_length:\n                count += 1\n    return count"}
