{"task_id": "Mbpp/615", "solution": "from typing import Tuple, List, Union\ndef average_tuple(input_data: Tuple[Tuple[Union[int, float], ...], ...]) -> List[float]:\n    \"\"\"Calculates the average of numerical values within each inner tuple of the input_data.\n    Returns these calculated averages as a list of floating-point numbers.\n    \"\"\"\n    averages = []\n    for inner_tuple in input_data:\n        # Sum the numerical values and count the elements in the current inner tuple.\n        current_sum = sum(inner_tuple)\n        current_count = len(inner_tuple)\n        average = current_sum / current_count\n        averages.append(average)\n    return averages"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs an element-wise modulo operation on two tuples of the same length.\n\n    Args:\n        tuple1: The first tuple (dividends).\n        tuple2: The second tuple (divisors), must be of the same length as tuple1.\n\n    Returns:\n        A new tuple containing the results of the element-wise modulo operations.\n\n    Raises:\n        ValueError: If tuple1 and tuple2 are not of the same length.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Tuples must be of the same length\")\n\n    results = [a % b for a, b in zip(tuple1, tuple2)]\n    return tuple(results)"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(input_data: tuple[tuple[float | int, ...], ...]) -> list[float]:\n    \"\"\"Calculates the average value for each inner tuple in a tuple of tuples.\n    Returns a list of floats, where each float is the average of an inner tuple.\n    \"\"\"\n    results = []\n    for inner_tuple in input_data:\n        sum_elements = sum(inner_tuple)\n        count_elements = len(inner_tuple)\n        average = float(sum_elements) / count_elements\n        results.append(average)\n    return results"}
{"task_id": "Mbpp/616", "solution": "class Tuple:\n    \"\"\"Manages tuple data and provides methods for operations.\"\"\"\n    def __init__(self, elements: tuple[int, ...]):\n        \"\"\"Initializes a Tuple object with provided elements.\"\"\"\n        self._elements = elements\n\n    def get_elements(self) -> tuple[int, ...]:\n        \"\"\"Returns the internal tuple of elements.\"\"\"\n        return self._elements\n\n    def get_length(self) -> int:\n        \"\"\"Returns the length of the internal elements tuple.\"\"\"\n        return len(self._elements)\n\n    def calculate_element_wise_modulo(self, divisor_tuple: 'Tuple') -> 'Tuple':\n        \"\"\"Performs element-wise modulo with another Tuple as divisor.\"\"\"\n        result_elements = []\n        for a, b in zip(self._elements, divisor_tuple._elements):\n            result_elements.append(a % b)\n        return Tuple(tuple(result_elements))\ndef tuple_modulo(tuple1: tuple[int, ...], tuple2: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"Performs element-wise modulo on two input tuples of equal length.\"\"\"\n    t1 = Tuple(tuple1)\n    t2 = Tuple(tuple2)\n\n    if t1.get_length() != t2.get_length():\n        raise ValueError(\"Input tuples must be of equal length.\")\n\n    result_tuple_obj = t1.calculate_element_wise_modulo(t2)\n    return result_tuple_obj.get_elements()"}
{"task_id": "Mbpp/618", "solution": "def div_list(list_a: list, list_b: list) -> list:\n    \"\"\"Performs element-wise floating-point division of two lists.\n    It returns a new list with the division results.\n    \"\"\"\n    if len(list_a) != len(list_b):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    results = []\n    for i in range(len(list_a)):\n        numerator = list_a[i]\n        denominator = list_b[i]\n        if denominator == 0:\n            raise ZeroDivisionError(\"Cannot divide by zero.\")\n        result = float(numerator) / denominator\n        results.append(result)\n    return results"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"\n    Separates numeric and non-numeric characters from an input string,\n    preserving their relative order, and concatenates the non-numeric\n    sequence followed by the numeric sequence.\n\n    Args:\n        input_string: The string to process.\n\n    Returns:\n        The processed string with all numeric characters moved to the end.\n\n    Example:\n        >>> move_num('I1love143you55three3000thousand')\n        'Iloveyouthreethousand1143553000'\n    \"\"\"\n    non_numeric_chars = []\n    numeric_chars = []\n\n    for char in input_string:\n        if char.isdigit():\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n\n    return ''.join(non_numeric_chars) + ''.join(numeric_chars)"}
{"task_id": "Mbpp/618", "solution": "def div_list(list1, list2):\n    \"\"\"\n    Performs element-wise division of two lists, returning a new list of floating-point results.\n    Handles division by zero according to IEEE 754 standard (inf, -inf, nan).\n    \"\"\"\n    results = []\n    for num1, num2 in zip(list1, list2):\n        results.append(float(num1) / num2)\n    return results"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Computes the size of the largest subset from a list of integers\n    where every pair of numbers within the subset is mutually divisible.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    # Sort the numbers to simplify the divisibility checks.\n    numbers.sort()\n\n    n = len(numbers)\n    # dp[i] stores the size of the largest divisible subset ending with numbers[i].\n    dp = [1] * n\n\n    for i in range(n):\n        for j in range(i):\n            # If numbers[i] is divisible by numbers[j], it can extend the subset ending at j.\\n            # We consider numbers[i] % numbers[j] == 0 because after sorting, numbers[j] <= numbers[i].\n            if numbers[i] % numbers[j] == 0:\n                dp[i] = max(dp[i], 1 + dp[j])\n\n    return max(dp)"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset where every pair of numbers is mutually divisible.\n    Uses dynamic programming after sorting the input list.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    sorted_numbers = sorted(numbers)\n    n = len(sorted_numbers)\n    # dp_array[i] stores the size of the largest divisible subset ending with sorted_numbers[i].\n    dp_array = [1] * n\n\n    for i in range(n):\n        for j in range(i):\n            if sorted_numbers[i] % sorted_numbers[j] == 0:\n                dp_array[i] = max(dp_array[i], 1 + dp_array[j])\n\n    return max(dp_array)"}
{"task_id": "Mbpp/623", "solution": "def nth_nums(list_of_numbers: list, exponent: int) -> list:\n    \"\"\"Computes the n-th power for each number in a given list.\n    Returns a new list containing the results of these exponentiations.\n    \"\"\"\n    results = []\n    for num in list_of_numbers:\n        results.append(num ** exponent)\n    return results"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1: list[int], list2: list[int], n: int) -> float:\n    \"\"\"Calculates the median of two sorted lists of the same size.\n    It identifies the n-th and (n+1)-th smallest elements from the combined lists.\n    \"\"\"\n    i = 0\n    j = 0\n    m1 = -1\n    m2 = -1\n\n    for count in range(n + 1):\n        m1 = m2\n\n        if i < n and j < n:\n            if list1[i] <= list2[j]:\n                m2 = list1[i]\n                i += 1\n            else:\n                m2 = list2[j]\n                j += 1\n        elif i < n:\n            m2 = list1[i]\n            i += 1\n        elif j < n:\n            m2 = list2[j]\n            j += 1\n\n    return (float(m1) + float(m2)) / 2.0"}
