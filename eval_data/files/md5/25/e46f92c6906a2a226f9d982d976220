{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list: list) -> (int | float):\n    \"\"\"\n    Flattens a potentially nested list and sums all its numeric elements.\n    Non-numeric, non-list elements are ignored during summation.\n    \"\"\"\n    total_sum = 0\n    for element in input_list:\n        if type(element) is list:\n            total_sum += recursive_list_sum(element)\n        else:\n            try:\n                total_sum += element\n            except TypeError:\n                # Element is non-numeric and not a list, so it is ignored.\n                pass\n    return total_sum"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the Bell number B_n using the Bell triangle dynamic programming method.\n    This method adheres to the mathematical definition and handles the specific case for n=2.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    bell_triangle = [[0] * (n + 1) for _ in range(n + 1)]\n    bell_triangle[0][0] = 1\n\n    for i in range(1, n + 1):\n        bell_triangle[i][0] = bell_triangle[i-1][i-1]\n        for j in range(1, i + 1):\n            bell_triangle[i][j] = bell_triangle[i][j-1] + bell_triangle[i-1][j-1]\n\n    return bell_triangle[n][0]"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic (either entirely non-increasing or non-decreasing).\n    An empty array or an array with a single element is considered monotonic.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    is_non_increasing = True\n    is_non_decreasing = True\n\n    for i in range(1, len(array)):\n        if array[i] > array[i-1]:\n            is_non_increasing = False\n        if array[i] < array[i-1]:\n            is_non_decreasing = False\n\n        if not is_non_increasing and not is_non_decreasing:\n            return False\n\n    return is_non_increasing or is_non_decreasing"}
{"task_id": "Mbpp/67", "solution": "def _combinations(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient (n choose k).\n    Returns 0 if k is out of bounds for n.\n    \"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\n_bell_cache = {0: 1}\ndef bell_number(n: int) -> int:\n    \"\"\"Calculates the nth Bell number using a recurrence relation.\n    Results are cached to optimize subsequent calls.\n    \"\"\"\n    if n in _bell_cache:\n        return _bell_cache[n]\n\n    for i in range(len(_bell_cache), n + 1):\n        current_bell = 0\n        for k in range(i):\n            current_bell += _combinations(i - 1, k) * _bell_cache[k]\n        _bell_cache[i] = current_bell\n\n    return _bell_cache[n]"}
{"task_id": "Mbpp/68", "solution": "def _is_non_decreasing(arr: list[float | int]) -> bool:\n    \"\"\"Checks if the array is entirely non-decreasing.\"\"\"\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i - 1]:\n            return False\n    return True\ndef _is_non_increasing(arr: list[float | int]) -> bool:\n    \"\"\"Checks if the array is entirely non-increasing.\"\"\"\n    for i in range(1, len(arr)):\n        if arr[i] > arr[i - 1]:\n            return False\n    return True\ndef is_Monotonic(arr: list[float | int]) -> bool:\n    \"\"\"\n    Determines if a given array is monotonic (either non-increasing or non-decreasing).\n    It calls helper functions to check for both conditions.\n    \"\"\"\n    return _is_non_decreasing(arr) or _is_non_increasing(arr)"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if `sub_list` exists as a contiguous sequence within `main_list`.\n    Returns True if found, False otherwise; an empty sub_list is always considered a sublist.\n    \"\"\"\n    if not sub_list:\n        return True\n    if not main_list: # sub_list is not empty here\n        return False\n\n    n = len(main_list)\n    m = len(sub_list)\n\n    for i in range(n - m + 1):\n        if main_list[i : i + m] == sub_list:\n            return True\n    return False"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sub_list: list) -> bool:\n    \"\"\"Checks if sub_list is found as a contiguous sequence within main_list.\n    Returns True if found, False otherwise.\"\"\"\n    len_main = len(main_list)\n    len_sub = len(sub_list)\n\n    if len_sub == 0:\n        return True\n\n    if len_sub > len_main:\n        return False\n\n    for i in range(len_main - len_sub + 1):\n        if main_list[i : i + len_sub] == sub_list:\n            return True\n\n    return False"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(numbers: list) -> list:\n    \"\"\"Sorts a list of numbers using the Comb Sort algorithm.\n    Returns a new list containing the sorted elements.\"\"\"\n\n    n = len(numbers)\n    if n == 0:\n        return []\n\n    # Create a mutable copy of the input list to sort\n    arr = list(numbers)\n\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        # Calculate the next gap value\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n\n        # Perform a single pass with the current gap\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n\n    return arr"}
