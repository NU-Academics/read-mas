{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the absolute difference between the first even and first odd number found in a list.\n    It iterates through the list to find these two numbers and then returns their absolute difference.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n\n        if first_even is not None and first_odd is not None:\n            break\n\n    return abs(first_even - first_odd)"}
{"task_id": "Mbpp/597", "solution": "def find_kth(arr1: list[int], arr2: list[int], k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element from two given sorted arrays.\n    This function efficiently identifies the desired element by conceptually merging.\n    \"\"\"\n    len1, len2 = len(arr1), len(arr2)\n    ptr1, ptr2 = 0, 0\n    kth_element = 0\n\n    for _ in range(k):\n        # Check if arr1 is exhausted or if the current element in arr2 is smaller (or arr1 is not exhausted)\n        if ptr1 < len1 and (ptr2 == len2 or arr1[ptr1] <= arr2[ptr2]):\n            kth_element = arr1[ptr1]\n            ptr1 += 1\n        # Otherwise, the current element in arr2 is smaller or arr1 is exhausted\n        else:\n            kth_element = arr2[ptr2]\n            ptr2 += 1\n\n    return kth_element"}
{"task_id": "Mbpp/597", "solution": "def find_kth(arr1: list[int], arr2: list[int], k: int) -> int:\n    \"\"\"Finds the k-th smallest element from two given sorted arrays.\n    It uses a two-pointer approach to conceptually merge the arrays and pick elements until the k-th is found.\n    \"\"\"\n    p1 = 0\n    p2 = 0\n    len1 = len(arr1)\n    len2 = len(arr2)\n    current_kth_element = None\n\n    for _ in range(k):\n        # If arr1 is exhausted, take from arr2\n        if p1 == len1:\n            current_kth_element = arr2[p2]\n            p2 += 1\n        # If arr2 is exhausted, take from arr1\n        elif p2 == len2:\n            current_kth_element = arr1[p1]\n            p1 += 1\n        # Both arrays have elements, compare and take the smaller\n        elif arr1[p1] <= arr2[p2]:\n            current_kth_element = arr1[p1]\n            p1 += 1\n        else: # arr2[p2] is smaller\n            current_kth_element = arr2[p2]\n            p2 += 1\n    return current_kth_element"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"Checks if the given integer is an Armstrong number.\n    An Armstrong number is one where the sum of its digits, each raised to the power of the number of digits, equals the original number.\"\"\"\n    if number < 0:\n        return False  # Armstrong numbers are typically defined for positive integers.\n\n    num_str = str(number)\n    n = len(num_str)\n\n    sum_of_powers = 0\n    temp_num = number\n\n    while temp_num > 0:\n        digit = temp_num % 10\n        sum_of_powers += digit ** n\n        temp_num //= 10\n\n    return sum_of_powers == number"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"Checks if the given number is an Armstrong number.\n    An Armstrong number equals the sum of its digits, each raised to the total number of digits.\"\"\"\n    num_str = str(number)\n    num_digits = len(num_str)\n    sum_of_powers = 0\n    temp_num = number\n\n    while temp_num > 0:\n        digit = temp_num % 10\n        sum_of_powers += digit ** num_digits\n        temp_num //= 10\n\n    return sum_of_powers == number"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n: int) -> tuple[int, float]:\n    \"\"\"Calculates the sum and average of the first n natural numbers.\n    Assumes n is a positive integer.\n    \"\"\"\n    calculated_sum = n * (n + 1) // 2\n    calculated_average = calculated_sum / n\n    return (calculated_sum, calculated_average)"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n: int) -> tuple[float, float]:\n    \"\"\"Calculates the sum and average of the first 'n' natural numbers.\n    It computes the sum using the direct formula and the average from that sum.\n    \"\"\"\n    total_sum = n * (n + 1) / 2\n    average = total_sum / n\n    return (float(total_sum), float(average))"}
