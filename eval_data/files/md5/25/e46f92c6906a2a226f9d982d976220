{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers: list[int], n: int) -> int:\n    \"\"\"\n    Calculates the sum of bitwise XOR operations for all unique pairs in the given list.\n    It iterates through all distinct pairs, computes their XOR, and accumulates the sum.\n    \"\"\"\n    total_xor_sum = 0\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            num1 = numbers[i]\n            num2 = numbers[j]\n            xor_result = num1 ^ num2\n            total_xor_sum += xor_result\n\n    return total_xor_sum"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers: list[int], length: int) -> int:\n    \"\"\"\n    Calculates the sum of the XOR of all unique pairs of numbers in the given list.\n    Returns 0 if the list has fewer than two elements.\n    \"\"\"\n    total_xor_sum = 0\n\n    if length < 2:\n        return 0\n\n    for i in range(length):\n        for j in range(i + 1, length):\n            total_xor_sum += (numbers[i] ^ numbers[j])\n\n    return total_xor_sum"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(list_of_numbers: list) -> list:\n    \"\"\"Sorts a list of numbers in ascending order using the heap sort algorithm.\"\"\"\n\n    def _heapify(arr: list, n: int, i: int) -> None:\n        \"\"\"Maintains the max-heap property in a subtree rooted at index i.\"\"\"\n        largest = i\n        l = 2 * i + 1\n        r = 2 * i + 2\n\n        if l < n and arr[l] > arr[largest]:\n            largest = l\n\n        if r < n and arr[r] > arr[largest]:\n            largest = r\n\n        if largest != i:\n            arr[i], arr[largest] = arr[largest], arr[i]\n            _heapify(arr, n, largest)\n\n    def _build_max_heap(arr: list) -> None:\n        \"\"\"Generates a max-heap from an unsorted list.\"\"\"\n        n = len(arr)\n        # Iterate from the last non-leaf node up to the root\n        for i in range(n // 2 - 1, -1, -1):\n            _heapify(arr, n, i)\n\n    # Create a copy of the input list to avoid modifying the original\n    arr_copy = list(list_of_numbers)\n    n = len(arr_copy)\n\n    # Phase 1: Build a max-heap from the list\n    _build_max_heap(arr_copy)\n\n    # Phase 2: Extract elements one by one from the heap\n    for i in range(n - 1, 0, -1):\n        # Move current root (largest element) to end\n        arr_copy[i], arr_copy[0] = arr_copy[0], arr_copy[i]\n        # Call _heapify on the reduced heap\n        _heapify(arr_copy, i, 0)\n\n    return arr_copy"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(data_list: list) -> None:\n    \"\"\"Sorts a list of numbers in-place using the heap sort algorithm.\"\"\"\n    n = len(data_list)\n\n    # Build a max-heap.\n    for i in range(n // 2 - 1, -1, -1):\n        _heapify(data_list, n, i)\n\n    # Extract elements one by one.\n    for i in range(n - 1, 0, -1):\n        data_list[i], data_list[0] = data_list[0], data_list[i]  # Swap\n        _heapify(data_list, i, 0)\n\ndef _heapify(data_list: list, n: int, i: int) -> None:\n    \"\"\"Maintains the max-heap property for a subtree rooted at index i.\"\"\"\n    largest = i  # Initialize largest as root\n    left_child = 2 * i + 1\n    right_child = 2 * i + 2\n\n    # Check if left child exists and is greater than root\n    if left_child < n and data_list[left_child] > data_list[largest]:\n        largest = left_child\n\n    # Check if right child exists and is greater than current largest\n    if right_child < n and data_list[right_child] > data_list[largest]:\n        largest = right_child\n\n    # If largest is not root, swap and recursively heapify the affected sub-tree\n    if largest != i:\n        data_list[i], data_list[largest] = data_list[largest], data_list[i]\n        _heapify(data_list, n, largest)"}
