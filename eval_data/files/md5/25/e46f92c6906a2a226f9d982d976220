{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"Toggles the case of alphabetic characters in a string.\n    Converts uppercase to lowercase and vice-versa, preserving non-alphabetic characters.\n    \"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if char.islower():\n            toggled_chars.append(char.upper())\n        elif char.isupper():\n            toggled_chars.append(char.lower())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1, num2):\n    \"\"\"\n    Calculates the sum of absolute differences between corresponding digits of two numbers.\n    Numbers are processed by their absolute values and padded with leading zeros to match length.\n    \"\"\"\n    str_num1 = str(abs(num1))\n    str_num2 = str(abs(num2))\n\n    max_len = max(len(str_num1), len(str_num2))\n\n    str_num1_padded = str_num1.zfill(max_len)\n    str_num2_padded = str_num2.zfill(max_len)\n\n    total_difference = 0\n    for i in range(max_len):\n        digit1 = int(str_num1_padded[i])\n        digit2 = int(str_num2_padded[i])\n        total_difference += abs(digit1 - digit2)\n\n    return total_difference"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(numbers: list, length: int) -> int:\n    \"\"\"Calculates the sum of the largest contiguous sublist within the given numbers.\n    It applies Kadane's algorithm to find the maximum sum efficiently.\"\"\"\n\n    # Initialize variables to track the maximum sum found so far and the maximum sum ending at the current position.\n    global_max = numbers[0]\n    current_max = numbers[0]\n\n    # Iterate through the list starting from the second element.\n    for i in range(1, length):\n        # Update current_max by choosing between the current element or extending the previous sublist.\n        current_max = max(numbers[i], current_max + numbers[i])\n\n        # Update global_max if current_max represents a new overall maximum sum.\n        global_max = max(global_max, current_max)\n\n    return global_max"}
