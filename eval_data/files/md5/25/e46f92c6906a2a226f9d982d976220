{"task_id": "Mbpp/286", "solution": "from typing import List\ndef _kadane(arr: List[int]) -> int:\n    \"\"\"Calculates the maximum contiguous subarray sum using Kadane's algorithm.\"\"\"\n    if not arr:\n        return 0\n\n    current_max = arr[0]\n    global_max = arr[0]\n\n    for i in range(1, len(arr)):\n        current_max = max(arr[i], current_max + arr[i])\n        global_max = max(global_max, current_max)\n    return global_max\ndef _get_max_prefix_sum(arr: List[int]) -> int:\n    \"\"\"Calculates the maximum prefix sum of a given array.\"\"\"\n    if not arr:\n        return 0\n\n    current_sum = 0\n    max_prefix_sum = float('-inf')\n\n    for x in arr:\n        current_sum += x\n        max_prefix_sum = max(max_prefix_sum, current_sum)\n    return max_prefix_sum\ndef _get_max_suffix_sum(arr: List[int]) -> int:\n    \"\"\"Calculates the maximum suffix sum of a given array.\"\"\"\n    if not arr:\n        return 0\n\n    current_sum = 0\n    max_suffix_sum = float('-inf')\n\n    for x in reversed(arr):\n        current_sum += x\n        max_suffix_sum = max(max_suffix_sum, current_sum)\n    return max_suffix_sum\ndef max_sub_array_sum_repeated(a: List[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous array in the modified array,\n    which is formed by repeating the given array k times.\n    \"\"\"\n    # The 'n' parameter is not strictly necessary as len(a) can be used.\n    # We keep it for consistency with the original problem signature.\n\n    if not a:\n        return 0\n\n    # Case 1: k == 1\n    if k == 1:\n        return _kadane(a)\n\n    sum_arr = sum(a)\n\n    # Case 2: Sum of original array is negative\n    # The maximum sum will not benefit from repeating the array multiple times.\n    # It will either be entirely within one repetition or span across two.\n    if sum_arr < 0:\n        return _kadane(a * 2)\n    # Case 3: Sum of original array is non-negative\n    # The maximum sum can grow by including full repetitions.\n    else:\n        max_prefix_sum = _get_max_prefix_sum(a)\n        max_suffix_sum = _get_max_suffix_sum(a)\n\n        # Compare the sum spanning multiple full middle arrays with sums entirely within two original arrays.\n        # (k-2) accounts for the full middle blocks of the array.\n        return max(max_prefix_sum + max_suffix_sum + sum_arr * (k - 2), _kadane(a * 2))"}
{"task_id": "Mbpp/290", "solution": "def max_length(list_of_lists: list[list]) -> tuple[int, list]:\n    \"\"\"Finds the list of maximum length in a list of lists.\n    Returns a tuple containing the maximum length and the first list found with that length.\n    \"\"\"\n    max_length_found = 0\n    identified_max_list = []\n\n    for inner_list in list_of_lists:\n        current_length = len(inner_list)\n        if current_length > max_length_found:\n            max_length_found = current_length\n            identified_max_list = inner_list\n\n    return (max_length_found, identified_max_list)"}
