{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(number: int) -> int:\n    \"\"\"\n    Counts the number of set bits (binary digits with value 1) in a given integer.\n    Uses Brian Kernighan's algorithm for efficient counting.\n    \"\"\"\n    count = 0\n    while number != 0:\n        number &= (number - 1)\n        count += 1\n    return count"}
{"task_id": "Mbpp/223", "solution": "def _find_first_occurrence(array, n, element):\n    \"\"\"\n    Finds the index of the first occurrence of an element using binary search.\n    Returns -1 if the element is not found.\n    \"\"\"\n    low, high = 0, n - 1\n    result = -1\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == element:\n            result = mid\n            high = mid - 1  # Look for an earlier occurrence in the left half\n        elif array[mid] < element:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result\ndef _find_last_occurrence(array, n, element):\n    \"\"\"\n    Finds the index of the last occurrence of an element using binary search.\n    Returns -1 if the element is not found.\n    \"\"\"\n    low, high = 0, n - 1\n    result = -1\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == element:\n            result = mid\n            low = mid + 1  # Look for a later occurrence in the right half\n        elif array[mid] < element:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result\ndef is_majority(array, n, element):\n    \"\"\"\n    Checks if a given element is a majority element in a sorted array.\n    A majority element occurs strictly more than n/2 times.\n    \"\"\"\n    if n == 0:\n        return False\n\n    first_idx = _find_first_occurrence(array, n, element)\n\n    if first_idx == -1:\n        return False  # Element not present in the array\n\n    last_idx = _find_last_occurrence(array, n, element)\n\n    # Calculate the number of occurrences\n    count = last_idx - first_idx + 1\n\n    # Check if the count is strictly greater than n/2\n    return count > (n / 2)"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(number: int) -> int:\n    \"\"\"\n    Calculates the number of set bits (binary digits with value 1) in a given integer.\n    It converts the number to its binary representation and counts the '1's.\n    \"\"\"\n    binary_representation = bin(number)\n    return binary_representation.count('1')"}
{"task_id": "Mbpp/223", "solution": "def is_majority(arr: list[int], n: int, x: int) -> bool:\n    \"\"\"\n    Determines if element x is a majority element in the sorted array arr.\n    A majority element occurs strictly more than n/2 times.\n    \"\"\"\n\n    def find_first_occurrence(arr, target, arr_len):\n        \"\"\"Finds the index of the first occurrence of the target using binary search.\"\"\"\n        low, high = 0, arr_len - 1\n        first_index = -1\n        while low <= high:\n            mid = (low + high) // 2\n            if arr[mid] == target:\n                first_index = mid\n                high = mid - 1  # Continue searching in the left half\n            elif arr[mid] < target:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return first_index\n\n    def find_last_occurrence(arr, target, arr_len):\n        \"\"\"Finds the index of the last occurrence of the target using binary search.\"\"\"\n        low, high = 0, arr_len - 1\n        last_index = -1\n        while low <= high:\n            mid = (low + high) // 2\n            if arr[mid] == target:\n                last_index = mid\n                low = mid + 1  # Continue searching in the right half\n            elif arr[mid] < target:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return last_index\n\n    first_idx = find_first_occurrence(arr, x, n)\n\n    # If x is not found in the array, it cannot be a majority element.\n    if first_idx == -1:\n        return False\n\n    last_idx = find_last_occurrence(arr, x, n)\n\n    # Calculate the total count of occurrences of x.\n    count = last_idx - first_idx + 1\n\n    # Check if the count is strictly greater than n/2.\n    return count > (n / 2)"}
