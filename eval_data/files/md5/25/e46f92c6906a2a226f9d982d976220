{"task_id": "Mbpp/56", "solution": "def _reverse_integer(number: int) -> int:\n    \"\"\"Calculates the reverse of an integer, preserving its sign.\"\"\"\n    \"\"\"E.g., 123 -> 321, -123 -> -321, 70 -> 7.\"\"\"\n    sign = -1 if number < 0 else 1\n    abs_number = abs(number)\n    reversed_abs = 0\n    while abs_number > 0:\n        digit = abs_number % 10\n        reversed_abs = reversed_abs * 10 + digit\n        abs_number //= 10\n    return reversed_abs * sign\ndef check(number: int) -> bool:\n    \"\"\"Determines if an input integer is one less than twice its reverse.\"\"\"\n    \"\"\"Returns True if number == (2 * reverse) - 1, False otherwise.\"\"\"\n    reversed_number = _reverse_integer(number)\n    return number == (2 * reversed_number) - 1"}
{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits: list[int]) -> int:\n    \"\"\"Forms the largest number from a list of digits.\n    Returns 0 for an empty input list, or if all digits form '0' (e.g., [0,0]).\n    \"\"\"\n    if not digits:\n        return 0\n\n    str_digits = [str(d) for d in digits]\n\n    class Comparer(str):\n        # Defines custom comparison, prioritizing 'x' over 'y' if x+y forms a larger number than y+x.\n        def __gt__(self, other):\n            return self + other > other + self\n\n    # Sort the string digits using the custom comparison to arrange them for the largest number.\n    sorted_comparers = sorted([Comparer(s) for s in str_digits], reverse=True)\n    sorted_final_strings = [str(s) for s in sorted_comparers]\n\n    # Join the sorted digits and convert to an integer.\n    # The int() function naturally handles leading zeros (e.g., '001' becomes 1, '0' becomes 0).\n    return int(\"\".join(sorted_final_strings))"}
{"task_id": "Mbpp/57", "solution": "import functools\ndef find_Max_Num(digits: list[int]) -> int:\n    \"\"\"\n    Finds the largest number formed by concatenating digits.\n    It sorts digits based on a custom comparison for optimal concatenation.\n    \"\"\"\n    if not digits:\n        return 0\n\n    str_digits = [str(digit) for digit in digits]\n\n    # Sort digits using a custom comparison to ensure `xy` is greater than `yx`\n    # for any two digits x, y, thus forming the largest possible number.\n    sorted_digits = sorted(str_digits, key=functools.cmp_to_key(lambda x, y: int(y + x) - int(x + y)))\n\n    result_str = \"\".join(sorted_digits)\n\n    # Handle the case where the result is \"000...\" which should just be \"0\"\n    # This is implicitly handled by int() conversion but explicit check is good\n    if result_str.startswith('0') and len(result_str) > 1:\n        return 0\n\n    return int(result_str)"}
