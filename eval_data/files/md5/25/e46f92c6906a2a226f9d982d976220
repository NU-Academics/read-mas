{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers):\n    \"\"\"\n    Multiplies all the numbers in a list and divides with the length of the list.\n\n    Args:\n        numbers: A list or tuple of numeric values (integers or floats).\n\n    Returns:\n        A float representing the product of elements divided by the list's length.\n        Returns 0.0 if the list is empty.\n\n    Raises:\n        ValueError: If numbers contains non-numeric values.\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    product = 1.0\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise ValueError(\"All elements in the list must be numeric.\")\n        product *= num\n\n    list_length = len(numbers)\n    return product / list_length"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"\n    Converts a decimal integer to its binary string representation.\n    Returns the binary string without leading zeros, except for input 0, which returns '0'.\n    \"\"\"\n    if decimal_number == 0:\n        return '0'\n\n    binary_string = []\n    temp_number = decimal_number\n    while temp_number > 0:\n        binary_string.append(str(temp_number % 2))\n        temp_number //= 2\n\n    return \"\".join(binary_string[::-1])"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number):\n    \"\"\"Converts a non-negative decimal integer to its binary string equivalent.\n    The result has no leading zeros, except '0' for input 0.\n    \"\"\"\n    if decimal_number == 0:\n        return '0'\n\n    binary_string_parts = []\n    temp_decimal = decimal_number\n\n    while temp_decimal > 0:\n        remainder = temp_decimal % 2\n        binary_string_parts.append(str(remainder))\n        temp_decimal //= 2\n\n    return \"\".join(reversed(binary_string_parts))"}
{"task_id": "Mbpp/100", "solution": "def _is_palindrome(num: int) -> bool:\n    \"\"\"Checks if a given integer is a palindrome.\n    It converts the number to a string and compares it with its reverse.\"\"\"\n    s = str(num)\n    return s == s[::-1]\ndef _is_all_nines(num: int) -> bool:\n    \"\"\"Checks if an integer consists solely of the digit '9'.\n    This is used to handle special cases like 9, 99, or 999.\"\"\"\n    return all(c == '9' for c in str(num))\ndef _handle_all_nines(length: int) -> int:\n    \"\"\"Generates the next smallest palindrome for numbers that are all nines.\n    For example, for length 2 (from 99), it returns 101; for length 3 (from 999), it returns 1001.\"\"\"\n    return int('1' + '0' * (length - 1) + '1')\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"Calculates and returns the next smallest palindrome greater than the input integer n.\n    It handles single-digit numbers, numbers composed entirely of nines, and general cases.\"\"\"\n    if n < 9:\n        return n + 1\n    elif n == 9:\n        return 11\n\n    if _is_all_nines(n):\n        return _handle_all_nines(len(str(n)))\n\n    current_n = n + 1\n    while True:\n        if _is_palindrome(current_n):\n            return current_n\n        current_n += 1"}
