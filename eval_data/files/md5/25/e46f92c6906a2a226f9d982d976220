{"task_id": "Mbpp/244", "solution": "def next_Perfect_Square(number: int) -> int:\n    \"\"\"\n    Finds the next perfect square strictly greater than the given input number.\n    It calculates the integer square root, increments it, and returns its square.\n    \"\"\"\n    # Calculate the integer part of the square root of the number.\n    # We use int() to floor the result, then add 1 to find the base for the next perfect square.\n    next_root = int(number**0.5) + 1\n    return next_root * next_root"}
{"task_id": "Mbpp/239", "solution": "def _count_sequences_recursive(current_length: int, last_element: int, m: int, n: int) -> int:\n    \"\"\"\n    Recursively counts valid sequences given the current length, last element, max value `m`, and target length `n`\n    It explores potential next elements that satisfy the `2*last_element` rule and `m` limit.\n    \"\"\"\n    if current_length == n:\n        return 1\n\n    count = 0\n    start_next = last_element * 2\n    for next_element in range(start_next, m + 1):\n        count += _count_sequences_recursive(current_length + 1, next_element, m, n)\n\n    return count\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the total number of sequences of length `n`, where elements are positive integers,\n    each greater than or equal to twice the previous, and less than or equal to `m`.\n    \"\"\"\n    # CRITICAL REQUIREMENT: Do NOT add isinstance() checks, type guards, or raise exceptions for edge cases.\n    # Input validation as per NFR1 from the design is intentionally omitted based on critical instructions.\n\n    total_count = 0\n\n    # The first element can be any positive integer from 1 to m.\n    for first_element in range(1, m + 1):\n        total_count += _count_sequences_recursive(1, first_element, m, n)\n\n    return total_count"}
{"task_id": "Mbpp/244", "solution": "import math\ndef next_Perfect_Square(number: int) -> int:\n    \"\"\"\n    Calculates the smallest perfect square strictly greater than the given number.\n    It finds the next integer root and squares it.\n    \"\"\"\n    sqrt_number = math.sqrt(number)\n\n    # Determine the smallest integer root whose square is strictly greater than 'number'.\n    # Start with the ceiling of the current square root.\n    next_root = int(math.ceil(sqrt_number))\n\n    # If the square of next_root is not strictly greater than 'number',\n    # increment next_root to find the truly next root.\n    if next_root * next_root <= number:\n        next_root += 1\n\n    return next_root * next_root"}
{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Finds the length of the longest palindromic subsequence in the given string.\n    Uses dynamic programming to build a table of LPS lengths for substrings.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the longest palindromic subsequence of s[i...j].\n    dp = [[0] * n for _ in range(n)]\n\n    # Base case: A single character is a palindrome of length 1.\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the table for substrings of length 2 to n.\n    for length in range(2, n + 1):\n        for i in range(n - length + 1):\n            j = i + length - 1 # End index of the current substring.\n\n            if s[i] == s[j]:\n                if length == 2:\n                    dp[i][j] = 2\n                else:\n                    dp[i][j] = dp[i+1][j-1] + 2\n            else:\n                dp[i][j] = max(dp[i+1][j], dp[i][j-1])\n\n    return dp[0][n-1]"}
