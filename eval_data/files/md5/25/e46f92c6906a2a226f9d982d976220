{"task_id": "Mbpp/161", "solution": "from typing import Any, List\ndef remove_elements(primary_list: List[Any], elements_to_remove: List[Any]) -> List[Any]:\n    \"\"\"\n    Removes all elements from primary_list that are present in elements_to_remove.\n    The relative order of the remaining elements is preserved.\n    \"\"\"\n    elements_to_remove_set = set(elements_to_remove)\n    result_list = [item for item in primary_list if item not in elements_to_remove_set]\n    return result_list"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(primary_list: list, removal_list: list) -> list:\n    \"\"\"Removes all elements from primary_list that are present in removal_list, preserving order.\n    Returns a new list without modifying the original lists.\"\"\"\n\n    # Convert the removal_list to a set for efficient O(1) average time lookups.\n    removal_set = set(removal_list)\n\n    # Initialize a new list to store elements that are not removed.\n    result_list = []\n\n    # Iterate through each element in the primary_list.\n    for element in primary_list:\n        # If the element is not found in the removal_set, add it to the result list.\n        if element not in removal_set:\n            result_list.append(element)\n\n    return result_list"}
{"task_id": "Mbpp/160", "solution": "def _extended_gcd(a: int, b: int) -> tuple[int, int, int]:\n    \"\"\"\n    Implements the extended Euclidean algorithm to find gcd(a, b) and B\u00e9zout coefficients.\n    Returns (gcd_val, x_prime, y_prime) such that a*x_prime + b*y_prime = gcd_val.\n    \"\"\"\n    if b == 0:\n        return a, 1, 0\n    gcd_val, x1, y1 = _extended_gcd(b, a % b)\n    x_prime = y1\n    y_prime = x1 - (a // b) * y1\n    return gcd_val, x_prime, y_prime\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integer solutions (x, y) for the linear Diophantine equation ax + by = n.\n    Returns (x, y) if a solution exists, otherwise None.\n    \"\"\"\n    gcd_val, x_prime, y_prime = _extended_gcd(a, b)\n\n    if gcd_val == 0:  # This condition implies both a and b are 0.\n        return (0, 0) if n == 0 else None\n\n    if n % gcd_val != 0:\n        return None\n    else:\n        k = n // gcd_val\n        x = x_prime * k\n        y = y_prime * k\n        return x, y"}
