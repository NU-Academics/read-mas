{"task_id": "Mbpp/572", "solution": "def two_unique_nums(nums: list) -> list:\n    \"\"\"\n    Identifies numbers appearing an odd number of times in a list, preserving first appearance order.\n    \"\"\"\n    frequency_map = {}\n    for num in nums:\n        frequency_map[num] = frequency_map.get(num, 0) + 1\n\n    result = []\n    seen_in_result = set()\n\n    for num in nums:\n        if frequency_map[num] % 2 != 0:\n            if num not in seen_in_result:\n                result.append(num)\n                seen_in_result.add(num)\n\n    return result"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr: list[int], n: int) -> int:\n    \"\"\"Calculates the maximum sum of a contiguous sublist using Kadane's algorithm.\n    It identifies the largest sum among all possible contiguous subarrays.\n    \"\"\"\n    max_so_far = arr[0]\n    current_max = 0\n\n    for x in arr:\n        current_max += x\n        if current_max > max_so_far:\n            max_so_far = current_max\n        if current_max < 0:\n            current_max = 0\n\n    return max_so_far"}
{"task_id": "Mbpp/573", "solution": "def unique_product(numbers: list) -> int:\n    \"\"\"Calculates the product of unique numbers in a given list.\n    Returns 1 if the list is empty.\"\"\"\n    unique_nums = set(numbers)\n    product = 1\n    for num in unique_nums:\n        product *= num\n    return product"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(list_a: list, list_b: list) -> bool:\n    \"\"\"\n    Checks if list_b is a contiguous sublist within list_a.\n    Returns True if found, False otherwise.\n    \"\"\"\n    len_a = len(list_a)\n    len_b = len(list_b)\n\n    for i in range(len_a - len_b + 1):\n        if list_a[i : i + len_b] == list_b:\n            return True\n    return False"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(number):\n    \"\"\"Calculates the last digit of the factorial of a given number.\n    For numbers 5 or greater, the last digit is 0.\"\"\"\n    if number == 0:\n        return 1\n    elif number == 1:\n        return 1\n    elif number == 2:\n        return 2\n    elif number == 3:\n        return 6\n    elif number == 4:\n        # Factorial of 4 is 24, last digit is 4.\n        return 4\n    else:\n        # For any integer number greater than or equal to 5,\n        # its factorial will contain both 2 and 5 as factors,\n        # making the factorial a multiple of 10, so its last digit is 0.\n        return 0"}
{"task_id": "Mbpp/573", "solution": "def unique_product(numbers: list) -> int:\n    \"\"\"\n    Calculates the product of unique numbers in a given list.\n    Returns 1 if no unique numbers are found.\n    \"\"\"\n    unique_numbers = set(numbers)\n    product = 1\n    for num in unique_numbers:\n        product *= num\n    return product"}
{"task_id": "Mbpp/577", "solution": "def _calculate_factorial(n: int) -> int:\n    \"\"\"\n    Computes the factorial of a non-negative integer n.\n    This helper function ensures accurate factorial calculation.\n    \"\"\"\n    if n == 0:\n        return 1\n    result = 1\n    for i in range(1, n + 1):\n        result *= i\n    return result\ndef _get_last_digit(number: int) -> int:\n    \"\"\"\n    Extracts the last digit from a given integer.\n    This helper performs a modulo 10 operation.\n    \"\"\"\n    return number % 10\ndef last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Calculates the factorial of n and returns its last digit.\n    It orchestrates factorial computation and last digit extraction.\n    \"\"\"\n    # For n >= 5, n! will always end in 0 due to factors of 2 and 5.\n    # This provides a direct and efficient result for larger numbers.\n    if n >= 5:\n        return 0\n\n    # For n < 5, calculate the actual factorial and then extract its last digit.\n    # This handles special cases like 0!, 1!, 4! (24 -> last digit 4).\n    factorial_value = _calculate_factorial(n)\n    last_digit = _get_last_digit(factorial_value)\n    return last_digit"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Identifies and returns elements unique to either of two input tuples.\n    It computes the symmetric difference between the elements of the two tuples.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n\n    # Elements unique to tuple1 (not in tuple2)\n    unique_to_tuple1 = set1 - set2\n\n    # Elements unique to tuple2 (not in tuple1)\n    unique_to_tuple2 = set2 - set1\n\n    # Combine all dissimilar elements\n    dissimilar_elements_set = unique_to_tuple1 | unique_to_tuple2\n\n    return tuple(dissimilar_elements_set)"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1, list2, list3):\n    \"\"\"Interleaves three lists of the same length into a single flat list.\n    Assumes all inputs are lists of equal length, as per critical requirements.\n    \"\"\"\n    result_list = []\n    # Iterate through the common length of the input lists.\n    for i in range(len(list1)):\n        result_list.append(list1[i])\n        result_list.append(list2[i])\n        result_list.append(list3[i])\n    return result_list"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Calculates the symmetric difference between two tuples.\n    It returns elements unique to tuple1 and elements unique to tuple2.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    symmetric_diff_set = set1 ^ set2\n    return tuple(symmetric_diff_set)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"Recursively filters a tuple, retaining only even integers and non-empty filtered nested tuples.\"\"\"\n    result = []\n    for element in input_tuple:\n        if isinstance(element, int):\n            if element % 2 == 0:\n                result.append(element)\n        elif isinstance(element, tuple):\n            filtered_inner_tuple = extract_even(element)\n            if filtered_inner_tuple:\n                result.append(filtered_inner_tuple)\n        # Other types are implicitly ignored.\n    return tuple(result)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(tup: tuple) -> tuple:\n    \"\"\"Recursively filters even integers from a nested tuple, preserving nesting and removing empty sub-tuples.\"\"\"\n    result_list = []\n    for element in tup:\n        if isinstance(element, int):\n            if element % 2 == 0:\n                result_list.append(element)\n        elif isinstance(element, tuple):\n            recursive_result = extract_even(element)\n            if recursive_result:\n                result_list.append(recursive_result)\n    return tuple(result_list)"}
{"task_id": "Mbpp/581", "solution": "import math\ndef surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"Calculates the total surface area of a square pyramid.\n    It uses the base edge and height for calculation.\n    \"\"\"\n    # BR4: Base Area (BA) = base_edge * base_edge\n    base_area = base_edge * base_edge\n\n    # BR5: Slant height (s) = sqrt(height^2 + (base_edge/2)^2)\n    slant_height = math.sqrt(height**2 + (base_edge / 2)**2)\n\n    # BR6: Lateral Surface Area (LSA) = 2 * base_edge * slant_height\n    lateral_surface_area = 2 * base_edge * slant_height\n\n    # BR3: Surface Area (SA) = BA + LSA\n    surface_area = base_area + lateral_surface_area\n    return surface_area"}
{"task_id": "Mbpp/572", "solution": "import collections\ndef two_unique_nums(input_list: list) -> list:\n    \"\"\"\n    Returns a new list containing only the numbers that appear exactly once in the input list.\n    Example: two_unique_nums([1,2,3,2,3,4,5]) == [1, 4, 5]\n    \"\"\"\n    counts = collections.Counter(input_list)\n    result = []\n    for num in input_list:\n        if counts[num] == 1:\n            result.append(num)\n    return result"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Catalan number using an iterative formula.\n    Catalan numbers are defined for non-negative integers.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    catalan = 1\n    for k in range(1, n + 1):\n        catalan = catalan * (4 * k - 2) // (k + 1)\n    return catalan"}
