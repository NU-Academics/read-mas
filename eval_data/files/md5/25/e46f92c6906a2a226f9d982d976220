{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list) -> bool:\n    n = len(arr)\n    if n <= 1:\n        return True\n    for i in range((n // 2) - 1, -1, -1):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n    return True"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(array: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap according to min-heap properties.\n    An empty or single-element array is considered a min-heap.\n    \"\"\"\n    n = len(array)\n\n    # BR1: An empty array or an array with a single element is considered a min-heap.\n    if n <= 1:\n        return True\n\n    # Iterate through all non-leaf nodes.\n    # Non-leaf nodes are at indices 0 to (n // 2) - 1 for a 0-indexed array.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # BR2: For any non-leaf node, its value must be less than or equal to its left child's value.\n        if left_child_idx < n:\n            if array[i] > array[left_child_idx]:\n                return False\n\n        # BR3: For any non-leaf node, its value must be less than or equal to its right child's value.\n        if right_child_idx < n:\n            if array[i] > array[right_child_idx]:\n                return False\n\n    # If all checks pass, the array is a min-heap.\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"Calculates the nth Jacobsthal number.\n    Raises ValueError if n is negative.\"\"\"\n    if n < 0:\n        raise ValueError(\"Input n must be non-negative\")\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    # For n > 1, compute iteratively using J(n) = J(n-1) + 2 * J(n-2).\n    j_n_minus_2 = 0  # Represents J(i-2)\n    j_n_minus_1 = 1  # Represents J(i-1)\n\n    for _ in range(2, n + 1):\n        current_jacobsthal = j_n_minus_1 + 2 * j_n_minus_2\n        j_n_minus_2 = j_n_minus_1\n        j_n_minus_1 = current_jacobsthal\n\n    return j_n_minus_1"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"Calculates the nth Jacobsthal number iteratively.\n    Assumes n is a non-negative integer as per critical requirements.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    j_n_minus_2 = 0  # Represents J(i-2)\n    j_n_minus_1 = 1  # Represents J(i-1)\n\n    for _ in range(2, n + 1):\n        current_j = j_n_minus_1 + 2 * j_n_minus_2\n        j_n_minus_2 = j_n_minus_1\n        j_n_minus_1 = current_j\n\n    return current_j"}
{"task_id": "Mbpp/753", "solution": "def min_k(tuple_list: list[tuple[str, int]], k: int) -> list[tuple[str, int]]:\n    \"\"\"\n    Identifies and returns the k tuples with the smallest scores from a given list, sorted by score.\n    Handles edge cases like an empty input list or k being zero.\n    \"\"\"\n    if k == 0 or not tuple_list:\n        return []\n\n    sorted_list = sorted(tuple_list, key=lambda x: x[1])\n    return sorted_list[:k]"}
{"task_id": "Mbpp/753", "solution": "def min_k(list_of_tuples: list[tuple[str, int]], k: int) -> list[tuple[str, int]]:\n    \"\"\"\n    Finds the minimum k records from a list of tuples, sorted by integer value.\n    Returns the k tuples with the smallest integer values, sorted in ascending order.\n    \"\"\"\n    sorted_records = sorted(list_of_tuples, key=lambda record: record[1])\n    return sorted_records[:k]"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Finds elements common to all three lists at the same index and value.\n    Returns a new list containing these common elements.\n    \"\"\"\n    common_elements = []\n    min_length = min(len(list1), len(list2), len(list3))\n\n    for i in range(min_length):\n        if list1[i] == list2[i] and list2[i] == list3[i]:\n            common_elements.append(list1[i])\n\n    return common_elements"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1: list, l2: list, l3: list) -> list:\n    \"\"\"\n    Finds elements common to l1, l2, and l3 at the same index.\n    Comparison is limited by the shortest list's length; returns an empty list if no common elements are found.\n    \"\"\"\n    min_length = min(len(l1), len(l2), len(l3))\n    common_elements = []\n    for i in range(min_length):\n        if l1[i] == l2[i] and l2[i] == l3[i]:\n            common_elements.append(l1[i])\n    return common_elements"}
{"task_id": "Mbpp/757", "solution": "def _reverse_string(s: str) -> str:\n    \"\"\"Reverses a given string.\n    This helper function is used internally to obtain the reverse of a string.\n    \"\"\"\n    return s[::-1]\ndef count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"Counts unique pairs of strings where one is the exact reverse of the other.\n    Each string can be part of at most one unique pair.\n    \"\"\"\n    pairs_count = 0\n    processed_strings = set()\n    # For efficient O(1) average time complexity lookups, convert the input list to a set.\n    string_set_for_lookup = set(string_list)\n\n    for current_string in string_list:\n        # Skip if the current string has already been paired or processed.\n        if current_string in processed_strings:\n            continue\n\n        reversed_string = _reverse_string(current_string)\n\n        # Check conditions for a valid unique reverse pair:\n        # 1. The reversed string must exist in the set of available strings.\n        # 2. The reversed string must be distinct from the current string.\n        # 3. The reversed string must not have been processed yet.\n        if (reversed_string in string_set_for_lookup and\n                reversed_string != current_string and\n                reversed_string not in processed_strings):\n\n            pairs_count += 1\n            processed_strings.add(current_string)\n            processed_strings.add(reversed_string)\n\n    return pairs_count"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"\n    Counts unique pairs of strings in a list where one is the reverse of the other.\n    It considers strings only once as part of a pair.\n    \"\"\"\n    pair_count = 0\n    # Use a set for efficient O(1) average time lookups of strings.\n    string_set = set(string_list)\n    # Tracks strings already counted as part of a pair to prevent reuse.\n    consumed_strings = set()\n\n    for current_string in string_list:\n        if current_string in consumed_strings:\n            continue\n\n        reversed_string = current_string[::-1]\n\n        # Check if the reversed string exists in the input, hasn't been consumed,\n        # and is not identical to the current string (to form a distinct pair).\n        if reversed_string in string_set and \\\n           reversed_string not in consumed_strings and \\\n           current_string != reversed_string:\n            pair_count += 1\n            consumed_strings.add(current_string)\n            consumed_strings.add(reversed_string)\n\n    return pair_count"}
