{"task_id": "Mbpp/130", "solution": "def _calculate_frequencies(items: list) -> dict:\n    \"\"\"Calculates the frequency of each item in a list.\n    Returns a dictionary mapping items to their counts.\"\"\"\n    frequency_map = {}\n    for item in items:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n    return frequency_map\ndef max_occurrences(items: list):\n    \"\"\"Finds the item with the maximum frequency in a given list.\n    Returns None if the list is empty.\"\"\"\n    if not items:\n        return None\n\n    frequency_map = _calculate_frequencies(items)\n\n    max_item = None\n    max_count = -1\n\n    for item, count in frequency_map.items():\n        if count > max_count:\n            max_count = count\n            max_item = item\n\n    return max_item"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(input_list: list) -> any:\n    # Finds the most frequent item in a list.\n    # Returns None for an empty list, otherwise the item with highest count.\n    if not input_list:\n        return None\n\n    counts = {}\n    for item in input_list:\n        counts[item] = counts.get(item, 0) + 1\n\n    # Returns the item with the maximum count.\n    # In case of ties, it returns one of the items with max frequency.\n    return max(counts, key=counts.get)"}
{"task_id": "Mbpp/129", "solution": "def _get_matrix_size(matrix):\n    \"\"\"Calculates the dimension N of the matrix.\"\"\"\n    return len(matrix)\ndef _is_square_matrix(matrix, size):\n    \"\"\"Verifies if the matrix is square (N x N) and not empty.\"\"\"\n    if size == 0:\n        return False\n    for row in matrix:\n        if len(row) != size:\n            return False\n    return True\ndef _calculate_row_sums(matrix, size):\n    \"\"\"Calculates the sum of elements for each row in the matrix.\"\"\"\n    row_sums = []\n    for row in matrix:\n        row_sums.append(sum(row))\n    return row_sums\ndef _calculate_column_sums(matrix, size):\n    \"\"\"Calculates the sum of elements for each column in the matrix.\"\"\"\n    column_sums = [0] * size\n    for r in range(size):\n        for c in range(size):\n            column_sums[c] += matrix[r][c]\n    return column_sums\ndef _calculate_main_diagonal_sum(matrix, size):\n    \"\"\"Calculates the sum of elements along the main diagonal.\"\"\"\n    main_diagonal_sum = 0\n    for i in range(size):\n        main_diagonal_sum += matrix[i][i]\n    return main_diagonal_sum\ndef _calculate_anti_diagonal_sum(matrix, size):\n    \"\"\"Calculates the sum of elements along the anti-diagonal.\"\"\"\n    anti_diagonal_sum = 0\n    for i in range(size):\n        anti_diagonal_sum += matrix[i][size - 1 - i]\n    return anti_diagonal_sum\ndef _all_sums_equal(sums):\n    \"\"\"Checks if all calculated sums in the list are equal.\"\"\"\n    if not sums:\n        return True\n    first_sum = sums[0]\n    for s in sums:\n        if s != first_sum:\n            return False\n    return True\ndef magic_square_test(matrix):\n    \"\"\"Determines if the given square matrix is a magic square.\"\"\"\n    size = _get_matrix_size(matrix)\n\n    if not _is_square_matrix(matrix, size):\n        return False\n\n    row_sums = _calculate_row_sums(matrix, size)\n    column_sums = _calculate_column_sums(matrix, size)\n    main_diagonal_sum = _calculate_main_diagonal_sum(matrix, size)\n    anti_diagonal_sum = _calculate_anti_diagonal_sum(matrix, size)\n\n    all_sums = row_sums + column_sums + [main_diagonal_sum, anti_diagonal_sum]\n\n    return _all_sums_equal(all_sums)"}
{"task_id": "Mbpp/131", "solution": "def _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel (a, e, i, o, u, case-insensitive).\n    'y' is explicitly excluded.\n    \"\"\"\n    return char.lower() in 'aeiou'\ndef reverse_vowels(s: str) -> str:\n    \"\"\"Reverses the order of vowels in a string, maintaining non-vowel positions.\n    Returns the original string if it contains zero or one vowel.\n    \"\"\"\n    mutable_char_list = list(s)\n    vowel_indices = []\n    extracted_vowels = []\n\n    for i, char in enumerate(mutable_char_list):\n        if _is_vowel(char):\n            vowel_indices.append(i)\n            extracted_vowels.append(char)\n\n    if len(extracted_vowels) <= 1:\n        return s\n\n    extracted_vowels.reverse()\n    reversed_vowel_iterator = iter(extracted_vowels)\n\n    for index in vowel_indices:\n        mutable_char_list[index] = next(reversed_vowel_iterator)\n\n    return \"\".join(mutable_char_list)"}
{"task_id": "Mbpp/131", "solution": "def _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel (a, e, i, o, u, case-insensitive).\"\"\"\n    return char.lower() in ('a', 'e', 'i', 'o', 'u')\ndef reverse_vowels(input_string: str) -> str:\n    \"\"\"Reverses only the vowels within a string, maintaining non-vowel positions.\"\"\"\n    char_list = list(input_string)\n    vowels_found = []\n\n    for char in char_list:\n        if _is_vowel(char):\n            vowels_found.append(char)\n\n    vowels_found.reverse()\n\n    vowel_index = 0\n    for i in range(len(char_list)):\n        if _is_vowel(char_list[i]):\n            char_list[i] = vowels_found[vowel_index]\n            vowel_index += 1\n\n    return \"\".join(char_list)"}
