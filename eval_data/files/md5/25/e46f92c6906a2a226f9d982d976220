{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list, target_sum: int) -> int:\n    \"\"\"\n    Counts pairs within a list that sum up to a specified target value.\n    Each pair is unique based on the indices of its elements.\n    \"\"\"\n    pair_count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                pair_count += 1\n    return pair_count"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list[int], target_sum: int) -> int:\n    \"\"\"\n    Counts distinct pairs from a list whose sum equals the target sum.\n    Pairs are identified by their original indices (i, j where j > i).\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
