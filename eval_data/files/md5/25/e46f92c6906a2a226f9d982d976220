{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"Checks if the given number is a Woodall number.\n    Woodall numbers are of the form N = n * 2^n - 1 for a non-negative integer n.\n    \"\"\"\n    if number < -1:\n        return False\n\n    n = 0\n    while True:\n        woodall_candidate = n * (2**n) - 1\n        if woodall_candidate == number:\n            return True\n        if woodall_candidate > number:\n            return False\n        n += 1"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(text, char_to_remove):\n    \"\"\"\n    Removes the first and last occurrences of a given character from a string.\n    If the character is not found, or only one occurrence exists, it handles those cases.\n    \"\"\"\n    first_idx = text.find(char_to_remove)\n    last_idx = text.rfind(char_to_remove)\n\n    if first_idx == -1:\n        return text  # Character not found, return original string\n    elif first_idx == last_idx:\n        # Only one occurrence or first/last are the same, remove that single instance.\n        return text[:first_idx] + text[first_idx+1:]\n    else:\n        # Both first and last occurrences are found and are different.\n        return text[:first_idx] + text[first_idx+1:last_idx] + text[last_idx+1:]"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(n: int) -> bool:\n    \"\"\"Checks if a given positive integer n is a Woodall number.\n    A Woodall number is defined as k * 2^k - 1 for some natural number k >= 1.\n    \"\"\"\n    k = 1\n    while True:\n        calculated_woodall = k * (2**k) - 1\n        if calculated_woodall == n:\n            return True\n        if calculated_woodall > n:\n            return False\n        k += 1"}
