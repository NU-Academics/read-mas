{"task_id": "Mbpp/804", "solution": "def is_product_even(list_of_numbers: list) -> bool:\n    \"\"\"Determines if the product of numbers in a list is an even number.\n    Returns False for an empty list or an odd product.\n    \"\"\"\n    if not list_of_numbers:\n        return False  # FR5: Return False for empty list\n\n    product = 1\n    for num in list_of_numbers:\n        product *= num\n\n    if product == 0:\n        return True\n\n    return product % 2 == 0"}
{"task_id": "Mbpp/804", "solution": "def _is_even(number: int) -> bool:\n    \"\"\"\n    Determines if a single integer is even.\n    Returns True if the number is even, False otherwise.\n    \"\"\"\n    return number % 2 == 0\ndef is_product_even(numbers: list) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    Returns True if the product is even, False otherwise.\n    \"\"\"\n    if not numbers:\n        # An empty list's product is conventionally 1, which is odd.\n        return False\n\n    if 0 in numbers:\n        # If any number is zero, the product is zero, which is even.\n        return True\n\n    for num in numbers:\n        if _is_even(num):\n            # The product is even if at least one number is even.\n            return True\n\n    # If all numbers are odd, their product will also be odd.\n    return False"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string):\n    \"\"\"\n    Calculates the maximum consecutive run of uppercase characters in the given string.\n    Iterates through the string, tracking current and maximum consecutive uppercase counts.\n    \"\"\"\n    current_run = 0\n    max_run = 0\n\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n        else:\n            current_run = 0\n        max_run = max(max_run, current_run)\n\n    return max_run"}
{"task_id": "Mbpp/805", "solution": "from typing import List\ndef _calculate_list_sum(inner_list: List[int]) -> int:\n    \"\"\"Calculates the sum of elements in a single list.\"\"\"\n    return sum(inner_list)\ndef max_sum_list(input_list_of_lists: List[List[int]]) -> List[int]:\n    \"\"\"\n    Identifies and returns the list from a list of lists whose sum of elements is the highest.\n    It iterates through each inner list, calculates its sum, and tracks the list with the maximum sum found.\n    \"\"\"\n    if not input_list_of_lists:\n        return []\n\n    highest_sum: float = float('-inf')\n    highest_sum_list: List[int] = []\n\n    for inner_list in input_list_of_lists:\n        current_sum = _calculate_list_sum(inner_list)\n        if current_sum > highest_sum:\n            highest_sum = current_sum\n            highest_sum_list = inner_list\n\n    return highest_sum_list"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(s: str) -> int:\n    \"\"\"\n    Calculates the maximum length of a consecutive sequence of uppercase characters in a string.\n    Returns 0 for empty strings or strings with no uppercase characters.\n    \"\"\"\n    max_run_length = 0\n    current_run_length = 0\n\n    for char in s:\n        if char.isupper():\n            current_run_length += 1\n        else:\n            max_run_length = max(max_run_length, current_run_length)\n            current_run_length = 0\n\n    # Final check after the loop to capture any run ending at the string's end\n    max_run_length = max(max_run_length, current_run_length)\n\n    return max_run_length"}
{"task_id": "Mbpp/805", "solution": "from typing import List, Union\nNumber = Union[int, float]\nclass Sublist:\n    \"\"\"Represents an individual sublist and manages its elements and sum.\n    It calculates and stores the sum of its elements upon initialization.\n    \"\"\"\n    def __init__(self, elements: List[Number]):\n        self.elements: List[Number] = elements\n        self._sum: Number\n        self.calculate_sum()\n\n    def calculate_sum(self) -> None:\n        \"\"\"Computes the sum of elements in the sublist and stores it.\"\"\"\n        self._sum = sum(self.elements)\n\n    def get_elements(self) -> List[Number]:\n        \"\"\"Returns the raw list of elements belonging to this sublist.\"\"\"\n        return self.elements\n\n    def get_sum(self) -> Number:\n        \"\"\"Returns the pre-calculated sum of the sublist's elements.\"\"\"\n        return self._sum\nclass ListOfLists:\n    \"\"\"Encapsulates a collection of Sublist objects for processing.\n    It provides functionality to identify the sublist with the maximum sum among its contained `Sublist` instances.\n    \"\"\"\n    def __init__(self, raw_list_of_lists: List[List[Number]]):\n        self.sublists: List[Sublist] = []\n        for raw_sublist in raw_list_of_lists:\n            self.sublists.append(Sublist(raw_sublist))\n\n    def find_max_sum_sublist(self) -> List[Number]:\n        \"\"\"Iterates through its `Sublist` objects to find and return the elements of the one with the highest sum.\"\"\"\n        if not self.sublists:\n            return []\n\n        max_sum: Number = -float('inf')\n        max_sublist_elements: List[Number] = []\n\n        for sublist_obj in self.sublists:\n            current_sum = sublist_obj.get_sum()\n            if current_sum > max_sum:\n                max_sum = current_sum\n                max_sublist_elements = sublist_obj.get_elements()\n\n        return max_sublist_elements\ndef max_sum_list(input_list_of_lists: List[List[Number]]) -> List[Number]:\n    \"\"\"\n    Identifies and returns the sublist from a given list of lists whose sum of elements is the highest.\n    This function acts as the entry point, leveraging `ListOfLists` and `Sublist` for an object-oriented approach.\n    \"\"\"\n    list_of_lists_container = ListOfLists(input_list_of_lists)\n    return list_of_lists_container.find_max_sum_sublist()"}
