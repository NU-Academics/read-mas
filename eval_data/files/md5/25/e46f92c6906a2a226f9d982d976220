{"task_id": "Mbpp/722", "solution": "def filter_data(students_data, minimal_height, minimal_weight):\n    \"\"\"Filters students whose height and weight strictly exceed minimal values.\n    Returns a new dictionary containing only the students who meet both criteria.\"\"\"\n    filtered_students = {}\n    for student_name, (height, weight) in students_data.items():\n        if height > minimal_height and weight > minimal_weight:\n            filtered_students[student_name] = (height, weight)\n    return filtered_students"}
{"task_id": "Mbpp/731", "solution": "import math\ndef lateralsurface_cone(r: float, h: float) -> float:\n    \"\"\"Calculates the lateral surface area of a cone.\n    Uses the formula LSA = \u03c0 * r * sqrt(r^2 + h^2).\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    lsa = math.pi * r * slant_height\n    return lsa"}
{"task_id": "Mbpp/731", "solution": "import math\ndef lateralsurface_cone(r: float, h: float) -> float:\n    \"\"\"Calculates the lateral surface area of a cone.\n    This function applies the formula L = \u03c0 * r * sqrt(r^2 + h^2).\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    lateral_surface_area = math.pi * r * slant_height\n    return lateral_surface_area"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array: list[float | int], target: float | int) -> int:\n    \"\"\"\n    Finds the 0-based index of the first occurrence of a target number in a sorted array.\n    Uses a modified binary search for O(log N) efficiency.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result_index = -1\n\n    while low <= high:\n        mid = (low + high) // 2\n        if array[mid] == target:\n            result_index = mid\n            high = mid - 1  # Search left for an earlier occurrence\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n\n    return result_index"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(text: str) -> str:\n    \"\"\"Replaces spaces, commas, and dots with colons in a string.\n    This function processes the input text sequentially for each specified character.\n    \"\"\"\n    modified_text = text.replace(' ', ':')\n    modified_text = modified_text.replace(',', ':')\n    modified_text = modified_text.replace('.', ':')\n    return modified_text"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of a base number raised to a specified power.\n    This function computes `base` raised to `power` and then sums the integer value of its digits.\n    \"\"\"\n    # Calculate the value of 'base' raised to the 'power'.\n    value = base ** power\n\n    # Convert the value to a string to iterate through its digits and sum them.\n    total_sum = sum(int(digit) for digit in str(value))\n\n    return total_sum"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr: list, num: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array.\n    Returns the index or -1 if the number is not found.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    result_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        current_element = arr[mid]\n\n        if current_element == num:\n            result_index = mid\n            high = mid - 1  # Continue searching in the left half for the first occurrence\n        elif current_element < num:\n            low = mid + 1\n        else:  # current_element > num\n            high = mid - 1\n\n    return result_index"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(n: int) -> int:\n    \"\"\"Toggles bits of the number except the first and the last bit.\"\"\"\n    msb_pos = n.bit_length() - 1\n    lsb_pos = 0\n\n    start_toggle_pos = lsb_pos + 1\n    end_toggle_pos = msb_pos - 1\n\n    num_bits_to_toggle = end_toggle_pos - start_toggle_pos + 1\n\n    if num_bits_to_toggle <= 0:\n        return n\n\n    mask = (1 << num_bits_to_toggle) - 1\n    mask <<= start_toggle_pos\n\n    return n ^ mask"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Calculates the product of adjacent elements in a tuple.\n    Returns a new tuple where each element is t_i * t_{i+1}.\n    Handles input validation and edge cases as per design.\n    \"\"\"\n    # Input Validation: Check if input_tuple is a tuple\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    # Input Validation: Check if all elements are numbers\n    for element in input_tuple:\n        if not isinstance(element, (int, float)):\n            raise TypeError(\"All elements in the tuple must be numbers.\")\n\n    # Length Check: Handle insufficient length (less than 2 elements)\n    if len(input_tuple) < 2:\n        return ()\n\n    results = []\n    # Core Logic: Iterate and multiply adjacent elements\n    for i in range(len(input_tuple) - 1):\n        product = input_tuple[i] * input_tuple[i+1]\n        results.append(product)\n\n    # Convert results list to a tuple and return\n    return tuple(results)"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(numbers_list: list) -> (int | float):\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists within a given list of numbers.\n    The function iterates through all sublists, computes their products, and sums them up.\n    \"\"\"\n    total_sum = 0\n\n    # Iterate through all possible starting indices\n    for i in range(len(numbers_list)):\n        # Iterate through all possible ending indices for the current starting index\n        for j in range(i, len(numbers_list)):\n            # Extract the current sublist\n            sublist = numbers_list[i : j + 1]\n\n            # Calculate the product of elements in the current sublist\n            current_product = 1\n            for num in sublist:\n                current_product *= num\n\n            # Add the sublist's product to the total sum\n            total_sum += current_product\n\n    return total_sum"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list: list) -> int:\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists of the given input list.\n    For an input list `[1,2,3]`, the function returns `20`.\n    \"\"\"\n    total_sum = 0\n    n = len(input_list)\n\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= input_list[j]\n            total_sum += current_product\n\n    return total_sum"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(num: int) -> int:\n    \"\"\"\n    Toggles all bits of num except for the most significant bit and the least significant bit.\n    Returns the modified integer.\n    \"\"\"\n    binary_str = bin(num)[2:]\n    n = len(binary_str)\n\n    if n <= 2:\n        # Numbers with 0, 1, or 2 bits have no \"middle\" bits to toggle.\n        return num\n\n    msb = binary_str[0]\n    lsb = binary_str[n - 1]\n    middle_bits = binary_str[1:n - 1]\n\n    toggled_middle = ['1' if bit == '0' else '0' for bit in middle_bits]\n    modified_binary_str = msb + \"\".join(toggled_middle) + lsb\n\n    return int(modified_binary_str, 2)"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list, value):\n    \"\"\"\n    Locates the leftmost insertion point for a value in a sorted list.\n    The function maintains the sorted order and prioritizes the leftmost index for duplicates.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
