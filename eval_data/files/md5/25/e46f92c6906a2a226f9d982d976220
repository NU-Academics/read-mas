{"task_id": "Mbpp/440", "solution": "from typing import List, Optional, Tuple\nimport re\nimport string\nimport nltk\nclass Word:\n    \"\"\"Represents a word from the sentence, retaining its original text, cleaned text, and positional information.\"\"\"\n    def __init__(self, original_text: str, original_span_start: int):\n        self.original_text = original_text\n        self.original_span_start = original_span_start\n        self.pos_tag: Optional[str] = None\n\n        self.cleaned_text: str = \"\"\n        self.start_index: int = -1\n        self.end_index: int = -1\n\n    def clean_punctuation(self) -> str:\n        \"\"\"Removes leading/trailing punctuation and sets the cleaned text and its new indices.\"\"\"\n        stripped_left = self.original_text.lstrip(string.punctuation)\n        leading_punc_count = len(self.original_text) - len(stripped_left)\n\n        self.cleaned_text = stripped_left.rstrip(string.punctuation)\n\n        self.start_index = self.original_span_start + leading_punc_count\n        self.end_index = self.start_index + len(self.cleaned_text)\n\n        return self.cleaned_text\n\n    def set_pos_tag(self, tag: str):\n        \"\"\"Sets the Part-of-Speech tag for the word.\"\"\"\n        self.pos_tag = tag\n\n    def is_adverb(self) -> bool:\n        \"\"\"Checks if the word's POS tag indicates it is an adverb (RB, RBR, RBS).\"\"\"\n        return self.pos_tag in ['RB', 'RBR', 'RBS']\n\n    def get_start_index(self) -> int:\n        \"\"\"Returns the start index of the cleaned adverb in the original sentence.\"\"\"\n        return self.start_index\n\n    def get_end_index(self) -> int:\n        \"\"\"Returns the end index of the cleaned adverb in the original sentence (exclusive).\"\"\"\n        return self.end_index\n\n    def get_cleaned_text(self) -> str:\n        \"\"\"Returns the word's text cleaned of leading/trailing punctuation.\"\"\"\n        return self.cleaned_text\nclass Sentence:\n    \"\"\"Encapsulates a sentence, its words, and provides methods for tokenization and POS tagging.\"\"\"\n    def __init__(self, content: str):\n        self.content = content\n        self.words: List[Word] = []\n\n    def tokenize(self):\n        \"\"\"Tokenizes the sentence into Word objects, preserving original positions.\"\"\"\n        for match in re.finditer(r'\\S+', self.content):\n            original_text = match.group(0)\n            start_index = match.start()\n            self.words.append(Word(original_text, start_index))\n\n    def tag_pos(self, pos_tagger_func):\n        \"\"\"Performs POS tagging on the cleaned text of each word using the provided tagger function.\"\"\"\n        cleaned_tokens = []\n        for word_obj in self.words:\n            cleaned_token = word_obj.clean_punctuation()\n            cleaned_tokens.append(cleaned_token)\n\n        if cleaned_tokens:\n            tagged_tokens = pos_tagger_func(cleaned_tokens)\n\n            for i, (token, tag) in enumerate(tagged_tokens):\n                # Assign POS tag to the corresponding Word object.\n                if self.words[i].cleaned_text == token: # Basic check for consistency.\n                    self.words[i].set_pos_tag(tag)\n                else:\n                    self.words[i].set_pos_tag(tag)\ndef find_adverb_position(sentence: str) -> Optional[Tuple[int, int, str]]:\n    \"\"\"\n    Identifies the first adverb in a sentence, returning its indices and cleaned text.\n    It uses POS tagging for identification and carefully tracks character positions.\n    \"\"\"\n    sentence_obj = Sentence(sentence)\n    sentence_obj.tokenize()\n    sentence_obj.tag_pos(nltk.pos_tag)\n\n    for word_obj in sentence_obj.words:\n        if word_obj.is_adverb():\n            return (word_obj.get_start_index(), word_obj.get_end_index(), word_obj.get_cleaned_text())\n\n    return None"}
{"task_id": "Mbpp/445", "solution": "def index_multiplication(tuple1: tuple[tuple[int, int], ...], tuple2: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:\n    \"\"\"Performs element-wise multiplication of corresponding integer elements within nested tuples.\n    It returns a new tuple mirroring the input structure with multiplied results.\"\"\"\n    result_inner_tuples = []\n    # Iterate through corresponding inner tuples from tuple1 and tuple2.\n    for i in range(len(tuple1)):\n        inner_tuple_a = tuple1[i]\n        inner_tuple_b = tuple2[i]\n\n        # Multiply elements at index 0 and index 1 separately to form a new inner tuple.\n        product_element_0 = inner_tuple_a[0] * inner_tuple_b[0]\n        product_element_1 = inner_tuple_a[1] * inner_tuple_b[1]\n\n        result_inner_tuples.append((product_element_0, product_element_1))\n\n    return tuple(result_inner_tuples)"}
