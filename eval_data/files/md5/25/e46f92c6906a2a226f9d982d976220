{"task_id": "Mbpp/141", "solution": "def _find_max_index(arr: list[int], n: int) -> int:\n    \"\"\"Finds the index of the maximum element within the first n elements of the list.\"\"\"\n    max_idx = 0\n    for i in range(1, n):\n        if arr[i] > arr[max_idx]:\n            max_idx = i\n    return max_idx\ndef pancake_sort(input_list: list[int]) -> list[int]:\n    \"\"\"Sorts a list of integers using the pancake sort algorithm.\"\"\"\n    arr = list(input_list)\n    n = len(arr)\n\n    for curr_size in range(n, 1, -1):\n        max_idx = _find_max_index(arr, curr_size)\n\n        if max_idx != curr_size - 1:\n            _flip(arr, max_idx)\n            _flip(arr, curr_size - 1)\n\n    return arr"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(items):\n    \"\"\"Flattens a nested list or tuple structure into a set of unique numbers.\n    Recursively processes nested iterables, extracting integers and floats.\n    \"\"\"\n    result_set = set()\n\n    def _flatten_and_collect(current_items):\n        for item in current_items:\n            # Recursively process lists and tuples as per the design's sequence.\n            if isinstance(item, (list, tuple)):\n                _flatten_and_collect(item)\n            # Add numbers (integers and floats) to the result set.\n            elif isinstance(item, (int, float)):\n                result_set.add(item)\n            # Non-numeric, non-list elements are ignored as per the design.\n\n    _flatten_and_collect(items)\n    return result_set"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(arr: list) -> list:\n    \"\"\"Sorts a list of integers in ascending order using the pancake sort algorithm.\n    Returns a new list with sorted elements, leaving the original list unmodified.\n    \"\"\"\n    current_arr = list(arr)  # Create a mutable copy of the input list.\n    n = len(current_arr)\n\n    # Iterate from the end of the list down to the second element.\n    for current_size in range(n, 1, -1):\n        # Find the index of the largest element in the current unsorted portion (0 to current_size-1).\n        max_idx = current_arr.index(max(current_arr[:current_size]))\n\n        # If the largest element is not already at its sorted position.\n        if max_idx != current_size - 1:\n            # First flip: bring the largest element to the front of the list.\n            current_arr[:max_idx + 1] = current_arr[:max_idx + 1][::-1]\n            # Second flip: move the largest element (now at front) to its correct sorted position.\n            current_arr[:current_size] = current_arr[:current_size][::-1]\n\n    return current_arr"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1, list2, list3):\n    \"\"\"Counts identical items at the same position across three lists.\n    Iteration is limited to the length of the shortest input list.\"\"\"\n    min_length = min(len(list1), len(list2), len(list3))\n    count = 0\n    for i in range(min_length):\n        if list1[i] == list2[i] and list2[i] == list3[i]:\n            count += 1\n    return count"}
