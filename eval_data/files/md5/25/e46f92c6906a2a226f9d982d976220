{"task_id": "Mbpp/592", "solution": "def _factorial(num: int) -> int:\n    \"\"\"Calculates the factorial of a non-negative integer.\n    Returns 1 for 0, and num * (num-1) * ... * 1 for num > 0.\n    \"\"\"\n    if num == 0:\n        return 1\n    result = 1\n    for i in range(1, num + 1):\n        result *= i\n    return result\ndef _binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\n    It uses the formula n! / (k! * (n-k)!).\n    \"\"\"\n    return _factorial(n) // (_factorial(k) * _factorial(n - k))\ndef sum_Of_product(n: int) -> int:\n    \"\"\"Calculates the sum of the product of consecutive binomial coefficients.\n    The sum is for k from 0 to n-1 of [C(n, k) * C(n, k+1)].\n    \"\"\"\n    total_sum = 0\n    for k in range(n):\n        coeff_k = _binomial_coefficient(n, k)\n        coeff_k_plus_1 = _binomial_coefficient(n, k + 1)\n        total_sum += coeff_k * coeff_k_plus_1\n    return total_sum"}
{"task_id": "Mbpp/588", "solution": "def big_diff(numbers: list) -> (int | float):\n    \"\"\"\n    Calculates the difference between the largest and smallest values in a list of numbers.\n\n    Args:\n        numbers: A list of numerical values (integers or floats).\n\n    Returns:\n        The numerical difference between the largest and smallest values in the list.\n\n    Raises:\n        TypeError: If the input is not a list.\n        ValueError: If the input list is empty or contains non-numerical values.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    max_val = None\n    min_val = None\n\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise ValueError(\"List must contain only numerical values (int or float).\")\n        if max_val is None or num > max_val:\n            max_val = num\n        if min_val is None or num < min_val:\n            min_val = num\n\n    return max_val - min_val"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip_address_str: str) -> str:\n    \"\"\"Removes leading zeros from each octet of an IP address string.\n    Splits, converts octets to integers and back to strings, then joins them.\"\"\"\n    octets = ip_address_str.split('.')\n    modified_octets = []\n    for octet in octets:\n        # Converting to int removes leading zeros, then converting back to str\n        modified_octets.append(str(int(octet)))\n    return '.'.join(modified_octets)"}
{"task_id": "Mbpp/592", "solution": "def _factorial(n: int) -> int:\n    \"\"\"Computes the factorial of a non-negative integer n.\n    Returns 1 for n=0.\"\"\"\n    if n == 0:\n        return 1\n    res = 1\n    for i in range(1, n + 1):\n        res *= i\n    return res\ndef _binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\n    It computes n! / (k! * (n-k)!).\"\"\"\n    if k < 0 or k > n:\n        return 0\n\n    # Optimize by using C(n, k) = C(n, n-k) for smaller k\n    if k > n // 2:\n        k = n - k\n\n    numerator = _factorial(n)\n    denominator = _factorial(k) * _factorial(n - k)\n    return numerator // denominator\ndef sum_Of_product(n: int) -> int:\n    \"\"\"Calculates the sum of products of consecutive binomial coefficients C(n, k) * C(n, k+1).\n    Sums for k from 0 to n-1.\"\"\"\n    total_sum = 0\n    for k in range(n): # k from 0 to n-1\n        coeff_k = _binomial_coefficient(n, k)\n        coeff_k_plus_1 = _binomial_coefficient(n, k + 1)\n        total_sum += coeff_k * coeff_k_plus_1\n    return total_sum"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers: list):\n    \"\"\"\n    Identifies the first even and first odd number in a list and returns their difference.\n    Assumes valid input where both an even and an odd number will be found.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for number in numbers:\n        if first_even is None and number % 2 == 0:\n            first_even = number\n        elif first_odd is None and number % 2 != 0:\n            first_odd = number\n\n        if first_even is not None and first_odd is not None:\n            break\n\n    return first_even - first_odd"}
{"task_id": "Mbpp/593", "solution": "class Octet:\n    \"\"\"Encapsulates a single IP address octet and handles leading zero removal.\"\"\"\n    def __init__(self, octet_string: str):\n        self._original_string_value = octet_string\n        self._integer_value = int(octet_string)\n        self.processed_string_value = str(self._integer_value)\n\n    def get_processed_value(self) -> str:\n        \"\"\"Returns the processed string value of the octet.\"\"\"\n        return self.processed_string_value\nclass IPAddress:\n    \"\"\"Represents a full IP address, manages parsing, processing, and reconstruction.\"\"\"\n    def __init__(self, ip_address_string: str):\n        self._original_value = ip_address_string\n        octet_strings = ip_address_string.split('.')\n        self._octets = [Octet(os) for os in octet_strings]\n        self.processed_value = \".\".join([o.get_processed_value() for o in self._octets])\n\n    def get_processed_ip(self) -> str:\n        \"\"\"Returns the full processed IP address string.\"\"\"\n        return self.processed_value\ndef removezero_ip(ip_address_string: str) -> str:\n    \"\"\"Removes leading zeroes from an IP address.\"\"\"\n    ip_address_obj = IPAddress(ip_address_string)\n    return ip_address_obj.get_processed_ip()"}
