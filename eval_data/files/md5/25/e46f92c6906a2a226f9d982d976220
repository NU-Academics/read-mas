{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Calculates the maximum sum of an increasing subsequence from the prefix\n    until the i-th index, and also including the k-th element.\n    \"\"\"\n    # Step 1: Calculate the maximum sum of an increasing subsequence ending at each index j up to i.\n    # dp[j] stores this maximum sum for elements within arr[0...i].\n    dp = [0] * (i + 1)\n    for j in range(i + 1):\n        dp[j] = arr[j]  # An increasing subsequence can minimally be the element itself.\n        for p in range(j):\n            if arr[j] > arr[p]:\n                dp[j] = max(dp[j], dp[p] + arr[j])\n\n    # Step 2: Find the maximum sum from dp[j] where arr[j] can be a predecessor to arr[k].\n    # This means arr[j] must be strictly less than arr[k].\n    max_prefix_sum = 0\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            max_prefix_sum = max(max_prefix_sum, dp[j])\n\n    # Step 3: The final maximum sum is the best prefix sum found plus the value of arr[k].\n    final_max_sum = max_prefix_sum + arr[k]\n    return final_max_sum"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Converts three parallel lists into a list of nested dictionaries.\n    Each dictionary follows the structure `{list1[i]: {list2[i]: list3[i]}}`.\n    \"\"\"\n    result = []\n    for i in range(len(list1)):\n        outer_key = list1[i]\n        inner_key = list2[i]\n        inner_value = list3[i]\n        result.append({outer_key: {inner_key: inner_value}})\n    return result"}
{"task_id": "Mbpp/392", "solution": "_memo = {}\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Calculates the maximum sum for n using a recursive formula with memoization.\n    f(n) = max( (f(n//2) + f(n//3) + f(n//4) + f(n//5)), n)\n    \"\"\"\n    if n == 0:\n        return 0\n    if n in _memo:\n        return _memo[n]\n\n    sum_of_subproblems = (\n        get_max_sum(n // 2) +\n        get_max_sum(n // 3) +\n        get_max_sum(n // 4) +\n        get_max_sum(n // 5)\n    )\n\n    result = max(sum_of_subproblems, n)\n    _memo[n] = result\n    return result"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(list1, list2, list3):\n    \"\"\"Converts three corresponding lists into a list of nested dictionaries.\n    Each dictionary has the structure {list1_element: {list2_element: list3_element}}.\n    \"\"\"\n    result_list = []\n    for item1, item2, item3 in zip(list1, list2, list3):\n        inner_dict = {item2: item3}\n        outer_dict = {item1: inner_dict}\n        result_list.append(outer_dict)\n    return result_list"}
