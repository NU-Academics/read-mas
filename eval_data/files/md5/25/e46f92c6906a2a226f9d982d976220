{"task_id": "Mbpp/630", "solution": "def get_coordinates(coordinate_tuple: tuple) -> list[list[int | float]]:\n    \"\"\"Calculates and returns a list of all adjacent coordinates, including the input coordinate itself.\"\"\"\n    x, y = coordinate_tuple\n\n    x_coords = [x - 1, x, x + 1]\n    y_coords = [y - 1, y, y + 1]\n\n    adjacent_coordinates = []\n    for i in x_coords:\n        for j in y_coords:\n            adjacent_coordinates.append([i, j])\n\n    return adjacent_coordinates"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(coordinate: tuple[int, int]) -> list[list[int]]:\n    \"\"\"\n    Calculates a given 2D coordinate and its 8 adjacent neighbors.\n    Returns a list of lists representing the coordinate and its 8 neighbors.\n    \"\"\"\n    x, y = coordinate\n    neighbors = []\n\n    # Iterate through x-variations and y-variations\n    for dx in [-1, 0, 1]:\n        for dy in [-1, 0, 1]:\n            neighbors.append([x + dx, y + dy])\n\n    return neighbors"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"Moves all numeric characters to the end of the string, preserving relative order.\n    Separates the input into non-numeric and numeric character lists, then joins and concatenates them.\n    \"\"\"\n    non_numeric_chars = []\n    numeric_chars = []\n\n    for char in input_string:\n        if char.isdigit():\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n\n    non_numeric_part = \"\".join(non_numeric_chars)\n    numeric_part = \"\".join(numeric_chars)\n\n    final_string = non_numeric_part + numeric_part\n    return final_string"}
{"task_id": "Mbpp/631", "solution": "def replace_spaces(text: str) -> str:\n    \"\"\"\n    Transforms a string by swapping whitespace characters with underscores and vice versa.\n    Uses a temporary character to ensure correct dual replacement.\n    \"\"\"\n    # Select a unique temporary character unlikely to be present in the input string.\n    # Unicode character U+0001 (Start of Header) is used for this intermediate step.\n    temp_char = '\\u0001'\n\n    # First, replace all space characters with the temporary placeholder.\n    # This prevents original spaces from being converted to underscores prematurely.\n    temp_transformed = text.replace(' ', temp_char)\n\n    # Next, replace all underscore characters with a space character.\n    # This completes the conversion for original underscores.\n    partially_transformed = temp_transformed.replace('_', ' ')\n\n    # Finally, replace the temporary placeholder with an underscore character.\n    # This completes the conversion for original spaces.\n    final_transformed = partially_transformed.replace(temp_char, '_')\n\n    return final_transformed"}
{"task_id": "Mbpp/631", "solution": "def replace_spaces(input_string: str) -> str:\n    \"\"\"\n    Replaces all whitespace characters with underscores and all underscore\n    characters with whitespace characters in the given string.\n    \"\"\"\n    result_chars = []\n    for char in input_string:\n        if char.isspace():\n            result_chars.append('_')\n        elif char == '_':\n            result_chars.append(' ')\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/632", "solution": "def move_zero(input_list: list) -> list:\n    \"\"\"Moves all zero elements to the end of a list, preserving non-zero order.\"\"\"\n    non_zero_elements = []\n    zero_elements = []\n\n    for element in input_list:\n        if element == 0:\n            zero_elements.append(element)\n        else:\n            non_zero_elements.append(element)\n\n    return non_zero_elements + zero_elements"}
{"task_id": "Mbpp/632", "solution": "def move_zero(input_list: list) -> list:\n    \"\"\"Moves all zero elements to the end of a list, preserving the relative order of non-zeros.\n    Returns a new list with the reordered elements.\"\"\"\n    non_zeros_list = []\n    zero_count = 0\n\n    for element in input_list:\n        if element != 0:\n            non_zeros_list.append(element)\n        else:\n            zero_count += 1\n\n    return non_zeros_list + ([0] * zero_count)"}
