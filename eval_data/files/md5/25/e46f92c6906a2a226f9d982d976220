{"task_id": "Mbpp/638", "solution": "import math\ndef wind_chill(velocity_kmh: float, temperature_celsius: float) -> int:\n    \"\"\"Calculates the wind chill index using the NWS formula.\n    The result is rounded up to the next whole integer.\"\"\"\n\n    # NWS Wind Chill Formula (for Celsius and km/h):\n    # WC = 13.12 + 0.6215*T - 11.37*V^0.16 + 0.3965*T*V^0.16\n\n    # Calculate the intermediate term V^0.16\n    v_power_0_16 = velocity_kmh ** 0.16\n\n    # Apply the NWS Wind Chill Formula\n    wind_chill_raw = (\n        13.12\n        + (0.6215 * temperature_celsius)\n        - (11.37 * v_power_0_16)\n        + (0.3965 * temperature_celsius * v_power_0_16)\n    )\n\n    # Round the result up to the next whole integer as required\n    rounded_wind_chill = math.ceil(wind_chill_raw)\n\n    return int(rounded_wind_chill)"}
{"task_id": "Mbpp/629", "solution": "def Split(numbers: list[int]) -> list[int]:\n    \"\"\"\n    Finds even numbers from a list of numbers.\n\n    Args:\n        numbers: A list of integers.\n\n    Returns:\n        A new list containing only the even numbers from the input list.\n    \"\"\"\n    even_numbers = []\n    for number in numbers:\n        if number % 2 == 0:\n            even_numbers.append(number)\n    return even_numbers"}
{"task_id": "Mbpp/638", "solution": "import math\ndef wind_chill(velocity: float, temperature: float) -> int:\n    \"\"\"\n    Calculates the wind chill index based on wind velocity (km/h) and temperature (Celsius).\n    The result is rounded up to the next integer using the Canadian Wind Chill Index formula.\n    \"\"\"\n    # Formula: WCI = 13.12 + 0.6215*T - 11.37*V^0.16 + 0.3965*T*V^0.16\n    # T = temperature (Celsius), V = velocity (km/h)\n\n    v_pow_0_16 = math.pow(velocity, 0.16)\n\n    raw_wind_chill = (13.12 +\n                      (0.6215 * temperature) -\\\n                      (11.37 * v_pow_0_16) +\\\n                      (0.3965 * temperature * v_pow_0_16))\n\n    return int(math.ceil(raw_wind_chill))"}
