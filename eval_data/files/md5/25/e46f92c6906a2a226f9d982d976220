{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integer solutions (x, y) for the linear Diophantine equation ax + by = n.\n    Returns (x, y) if a solution exists, otherwise None.\n    \"\"\"\n\n    def _gcd(x_val: int, y_val: int) -> int:\n        \"\"\"Calculates the greatest common divisor of two integers.\"\"\"\n        x_val, y_val = abs(x_val), abs(y_val)\n        while y_val:\n            x_val, y_val = y_val, x_val % y_val\n        return x_val\n\n    def _extended_gcd(a_val: int, b_val: int) -> tuple[int, int, int]:\n        \"\"\"Implements the extended Euclidean algorithm ensuring a*x + b*y = g where g is positive.\"\"\"\n\n        def _extended_gcd_positive(a_pos: int, b_pos: int) -> tuple[int, int, int]:\n            \"\"\"Calculates (g, x, y) for a_pos*x + b_pos*y = g, assuming a_pos, b_pos >= 0.\"\"\"\n            if a_pos == 0:\n                return b_pos, 0, 1\n            gcd_val, x1, y1 = _extended_gcd_positive(b_pos % a_pos, a_pos)\n            x = y1 - (b_pos // a_pos) * x1\n            y = x1\n            return gcd_val, x, y\n\n        # Calculate g and coefficients for absolute values\n        g_val, x_abs, y_abs = _extended_gcd_positive(abs(a_val), abs(b_val))\n\n        # Adjust coefficients based on original signs of a_val and b_val\n        x_final = x_abs if a_val >= 0 else -x_abs\n        y_final = y_abs if b_val >= 0 else -y_abs\n\n        return g_val, x_final, y_final\n\n    g = _gcd(a, b)\n\n    if g == 0:\n        return (0, 0) if n == 0 else None\n\n    if n % g != 0:\n        return None\n\n    # Calculate a particular solution for a*x_prime + b*y_prime = g\n    g_returned, x_prime, y_prime = _extended_gcd(a, b)\n\n    # Scale the particular solution to find (x, y) for ax + by = n\n    scale_factor = n // g_returned\n    x = x_prime * scale_factor\n    y = y_prime * scale_factor\n\n    return (x, y)"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Calculates the sum of the series (n - 2*i) for i from 0 to n // 2.\"\"\"\n    total_sum = 0\n    # Loop from i=0 up to and including n // 2.\n    for i in range(n // 2 + 1):\n        total_sum += (n - 2 * i)\n    return total_sum"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Calculates the smallest power of 2 that is greater than or equal to n.\n    Handles n=0 by returning 1.\n    \"\"\"\n    if n == 0:\n        return 1\n    return 1 << (n - 1).bit_length()"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(input_list: list[int]) -> int:\n    \"\"\"\n    Counts pairs in a list whose bitwise XOR is an even number.\n    This relies on the property that a ^ b is even if a and b are both even, or both odd.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for number in input_list:\n        if number % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # Calculate pairs of even numbers\n    even_even_pairs = even_count * (even_count - 1) // 2\n    # Calculate pairs of odd numbers\n    odd_odd_pairs = odd_count * (odd_count - 1) // 2\n\n    total_pairs = even_even_pairs + odd_odd_pairs\n    return total_pairs"}
{"task_id": "Mbpp/165", "solution": "class _CharacterUtils:\n    \"\"\"\n    Utility class for character-specific operations like alphabetic checks,\n    case conversion, and alphabetical position calculation.\n    \"\"\"\n    @staticmethod\n    def is_alphabetic(char: str) -> bool:\n        \"\"\"Checks if a character is an English alphabet letter.\"\"\"\n        return 'a' <= char <= 'z' or 'A' <= char <= 'Z'\n\n    @staticmethod\n    def to_lowercase(char: str) -> str:\n        \"\"\"Converts a character to its lowercase equivalent.\"\"\"\n        return char.lower()\n\n    @staticmethod\n    def get_alphabetical_position(char_lower: str) -> int:\n        \"\"\"Calculates the 0-based alphabetical position for a lowercase letter.\"\"\"\n        return ord(char_lower) - ord('a')\ndef count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters whose 0-based string position matches their 0-based alphabetical position.\n    Performs case-insensitive comparison and ignores non-alphabetic characters.\n    \"\"\"\n    match_count = 0\n    for index, char in enumerate(input_string):\n        if _CharacterUtils.is_alphabetic(char):\n            lower_char = _CharacterUtils.to_lowercase(char)\n            alpha_pos = _CharacterUtils.get_alphabetical_position(lower_char)\n            if index == alpha_pos:\n                match_count += 1\n    return match_count"}
{"task_id": "Mbpp/165", "solution": "def _is_english_alphabetic(char_val: str) -> bool:\n    \"\"\"Checks if a character is an English alphabet letter, case-insensitive.\"\"\"\n    lower_char = char_val.lower()\n    return 'a' <= lower_char <= 'z'\ndef _get_alphabetical_position(char_val: str) -> int:\n    \"\"\"Calculates the 0-indexed alphabetical position of an English letter.\"\"\"\n    lower_char = char_val.lower()\n    return ord(lower_char) - ord('a')\ndef count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters whose 0-indexed string position matches their 0-indexed\n    position in the English alphabet (case-insensitive).\n    \"\"\"\n    count = 0\n    for index, char in enumerate(input_string):\n        if _is_english_alphabetic(char):\n            alphabetical_position = _get_alphabetical_position(char)\n            if index == alphabetical_position:\n                count += 1\n    return count"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(integer_list: list[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list whose bitwise XOR sum is even.\n    This occurs when both numbers are either both even or both odd.\n    \"\"\"\n    count = 0\n    n = len(integer_list)\n    for i in range(n):\n        for j in range(i + 1, n):\n            # Check if both numbers have the same parity (both even or both odd).\n            if (integer_list[i] % 2) == (integer_list[j] % 2):\n                count += 1\n    return count"}
