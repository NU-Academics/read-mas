{"task_id": "Mbpp/247", "solution": "def lps(input_string: str) -> int:\n    \"\"\"Calculates the length of the longest palindromic subsequence for a given string.\"\"\"\n    n = len(input_string)\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the LPS for substring input_string[i...j]\n    dp = [[0] * n for _ in range(n)]\n\n    # All single characters are palindromic subsequences of length 1.\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the DP table for lengths from 2 to n.\n    for current_len in range(2, n + 1):\n        for i in range(n - current_len + 1):\n            j = i + current_len - 1\n            if input_string[i] == input_string[j]:\n                # If characters match, add 2 to the LPS of the inner substring.\n                dp[i][j] = 2 + (dp[i + 1][j - 1] if current_len > 2 else 0)\n            else:\n                # If characters don't match, take the maximum of excluding either character.\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    return dp[0][n - 1]"}
{"task_id": "Mbpp/245", "solution": "def _calculate_lis_sums(arr: list[int]) -> list[int]:\n    \"\"\"\n    Computes the maximum sum of an increasing subsequence ending at each index.\n    This uses dynamic programming to build up sums from left to right.\n    \"\"\"\n    n = len(arr)\n    lis_sums = list(arr)\n\n    for i in range(1, n):\n        for j in range(i):\n            if arr[i] > arr[j]:\n                lis_sums[i] = max(lis_sums[i], lis_sums[j] + arr[i])\n    return lis_sums\ndef _calculate_lds_sums(arr: list[int]) -> list[int]:\n    \"\"\"\n    Computes the maximum sum of a decreasing subsequence starting at each index.\n    This iterates from right to left to build sums.\n    \"\"\"\n    n = len(arr)\n    lds_sums = list(arr)\n\n    for i in range(n - 2, -1, -1):\n        for j in range(n - 1, i, -1):\n            if arr[i] > arr[j]:\n                lds_sums[i] = max(lds_sums[i], lds_sums[j] + arr[i])\n    return lds_sums\ndef max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence in the given array.\n    A bitonic sequence is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    lis_sums = _calculate_lis_sums(arr)\n    lds_sums = _calculate_lds_sums(arr)\n\n    max_bitonic_sum = 0\n\n    for i in range(n):\n        # Calculate the sum for arr[i] as the peak of a bitonic subsequence.\n        # arr[i] is counted in both LIS and LDS, so subtract it once.\n        current_bitonic_sum = lis_sums[i] + lds_sums[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n\n    return max_bitonic_sum"}
{"task_id": "Mbpp/245", "solution": "def max_sum(arr: list) -> int:\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence within a given array.\n    A bitonic subsequence first strictly increases and then strictly decreases.\n    \"\"\"\n    n = len(arr)\n\n    # Handle edge cases for empty or single-element arrays.\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    # Initialize dynamic programming arrays.\n    # lis_sum[i]: max sum of an increasing subsequence ending at arr[i]\n    # lds_sum[i]: max sum of a decreasing subsequence starting at arr[i]\n    lis_sum = list(arr)\n    lds_sum = list(arr)\n\n    # Calculate lis_sum (Longest Increasing Subsequence Sum)\n    for i in range(1, n):\n        for j in range(i):\n            if arr[j] < arr[i]:\n                lis_sum[i] = max(lis_sum[i], lis_sum[j] + arr[i])\n\n    # Calculate lds_sum (Longest Decreasing Subsequence Sum)\n    for i in range(n - 2, -1, -1):\n        for j in range(n - 1, i, -1):\n            if arr[j] < arr[i]:\n                lds_sum[i] = max(lds_sum[i], lds_sum[j] + arr[i])\n\n    # Find the maximum bitonic subsequence sum\n    max_bitonic_sum = 0\n    for i in range(n):\n        # Subtract arr[i] to avoid double-counting the peak element\n        current_bitonic_sum = lis_sum[i] + lds_sum[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n\n    return max_bitonic_sum"}
