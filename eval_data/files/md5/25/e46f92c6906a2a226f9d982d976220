{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n):\n    \"\"\"Calculates the sum of the fourth power of the first n odd natural numbers.\"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        current_odd_num = (2 * i) - 1\n        fourth_power = current_odd_num ** 4\n        total_sum += fourth_power\n    return total_sum"}
{"task_id": "Mbpp/765", "solution": "def is_power_of_two(k: int) -> bool:\n    \"\"\"\n    Checks if a positive integer k is a power of two.\n    This is true if k > 0 and (k & (k - 1)) == 0.\n    \"\"\"\n    return k > 0 and (k & (k - 1)) == 0\ndef is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number.\n    Polite numbers are positive integers that are not powers of two.\n    \"\"\"\n    polite_count = 0\n    num = 1\n    while True:\n        if not is_power_of_two(num):\n            polite_count += 1\n            if polite_count == n:\n                return num\n        num += 1"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth powers of the first n odd natural numbers.\n    Handles n=0 by returning 0.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    total_sum = 0\n    for i in range(1, n + 1):\n        odd_number = 2 * i - 1\n        fourth_power = odd_number ** 4\n        total_sum += fourth_power\n    return total_sum"}
