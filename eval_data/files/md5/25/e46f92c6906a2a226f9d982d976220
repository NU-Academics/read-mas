{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given string expression has balanced parentheses, square brackets, and curly braces using a stack.\n    Returns True if all brackets are balanced, False otherwise.\n    \"\"\"\n    stack = []\n    bracket_map = {\n        '(': ')',\n        '[': ']',\n        '{': '}'\n    }\n    open_brackets = set(bracket_map.keys())\n    close_brackets = set(bracket_map.values())\n\n    for char in expression:\n        if char in open_brackets:\n            stack.append(char)\n        elif char in close_brackets:\n            if not stack:\n                return False\n            top_bracket = stack.pop()\n            if bracket_map[top_bracket] != char:\n                return False\n\n    return not stack"}
{"task_id": "Mbpp/772", "solution": "def _split_words(text: str) -> list[str]:\n    \"\"\"Splits a string into a list of words, handling multiple and surrounding spaces.\"\"\"\n    return text.strip().split()\ndef _join_words(words: list[str]) -> str:\n    \"\"\"Joins a list of words into a single string, separated by single spaces.\"\"\"\n    return ' '.join(words)\ndef remove_length(input_string: str, k: int) -> str:\n    \"\"\"\n    Removes all words of a specific length k from the input string.\n    Preserves relative order and normalizes spacing.\n    \"\"\"\n    list_of_words = _split_words(input_string)\n    filtered_words_list = [word for word in list_of_words if len(word) != k]\n    result_string = _join_words(filtered_words_list)\n    return result_string"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression):\n    \"\"\"Checks if the given string expression has balanced delimiters using a stack.\"\"\"\n    OPENING_DELIMITERS = {'(', '[', '{'}\n    CLOSING_DELIMITERS = {')', ']', '}'}\n    DELIMITER_MAP = {')': '(', ']': '[', '}': '{'}\n\n    stack = []\n\n    for char in expression:\n        if char in OPENING_DELIMITERS:\n            stack.append(char)\n        elif char in CLOSING_DELIMITERS:\n            if not stack or stack.pop() != DELIMITER_MAP[char]:\n                return False\n\n    return not stack"}
{"task_id": "Mbpp/773", "solution": "from typing import Optional, Tuple\ndef occurance_substring(main_string: str, substring: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Finds the first occurrence of a substring within a main string.\n    Returns the substring, its start and end indices, or None if not found.\n    \"\"\"\n    start_index = main_string.find(substring)\n\n    if start_index != -1:\n        end_index = start_index + len(substring)\n        return (substring, start_index, end_index)\n    else:\n        return None"}
{"task_id": "Mbpp/763", "solution": "def find_min_difference(arr, n):\n    \"\"\"Calculates the minimum absolute difference between any two elements in a tuple.\n    It sorts the tuple and then compares adjacent elements.\"\"\"\n\n    sorted_arr = sorted(arr)\n    min_diff = float('inf')\n\n    # Iterate through adjacent elements to find the minimum difference\n    for i in range(n - 1):\n        current_diff = abs(sorted_arr[i+1] - sorted_arr[i])\n        if current_diff < min_diff:\n            min_diff = current_diff\n\n    return min_diff"}
{"task_id": "Mbpp/775", "solution": "def odd_position(input_list: list) -> bool:\n    \"\"\"\n    Checks if every element located at an odd index within a list is an odd number.\n    Returns True if all elements at odd indices are odd, False otherwise.\n    \"\"\"\n    for index, element in enumerate(input_list):\n        if index % 2 != 0:  # Check if the current index is odd\n            if element % 2 == 0:  # Check if the element at this odd index is even\n                return False  # If it's even, the condition is violated\n    return True  # All odd-indexed elements were odd, or there were no odd indices"}
{"task_id": "Mbpp/777", "solution": "def find_sum(numbers_list):\n    \"\"\"\n    Calculates the sum of distinct elements in the provided list.\n    This implementation prioritizes the specified test case output for non-repeated elements.\n    \"\"\"\n    # Step 1: Count Occurrences of each element in the input list.\n    # A dictionary is used to efficiently store and access element frequencies.\n    counts = {}\n    for number in numbers_list:\n        counts[number] = counts.get(number, 0) + 1\n\n    # Step 2 & 3: Identify the elements to be summed and calculate their sum.\n    # Based on the requirement that find_sum([1,2,3,1,1,4,5,6]) must return 21,\n    # \"non-repeated elements\" is interpreted as \"distinct elements\".\n    # Therefore, we sum all unique elements (the keys of the counts dictionary).\n    calculated_sum = 0\n    for number in counts:\n        calculated_sum += number\n\n    # Step 4: Return the final calculated sum.\n    return calculated_sum"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Packs consecutive duplicate elements of a list into sublists.\n    Returns a list of lists, where each inner list contains consecutive duplicates.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_sublist = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_sublist[0]:\n            current_sublist.append(input_list[i])\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [input_list[i]]\n\n    packed_list.append(current_sublist)\n    return packed_list"}
{"task_id": "Mbpp/777", "solution": "def find_sum(input_list: list) -> int:\n    \"\"\"Calculates the sum of non-repeated elements in a given list of integers.\n    It identifies elements appearing exactly once and sums them.\n    \"\"\"\n    element_counts = {}\n    for element in input_list:\n        element_counts[element] = element_counts.get(element, 0) + 1\n\n    final_sum = 0\n    for element, count in element_counts.items():\n        if count == 1:\n            final_sum += element\n\n    return final_sum"}
{"task_id": "Mbpp/775", "solution": "def odd_position(input_list: list[int]) -> bool:\n    \"\"\"\n    Checks if all elements at odd indices in the input list are odd numbers.\n    Returns True if all elements at odd indices are odd numbers, or if the list is empty\n    or has no odd indices. False otherwise.\n    \"\"\"\n    for i in range(len(input_list)):\n        if i % 2 != 0:  # Check if index is odd.\n            element = input_list[i]\n            if element % 2 == 0:  # Check if element is even.\n                return False  # Immediately return False.\n    return True  # All checks passed or no odd indices."}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list[list]:\n    \"\"\"\n    Packs consecutive identical elements of a list into sublists.\n    This function groups unique and non-consecutive duplicates into separate sublists.\n    \"\"\"\n    output_list = []\n    current_sublist = []\n\n    if not input_list:\n        return output_list\n\n    for element in input_list:\n        if not current_sublist or element == current_sublist[-1]:\n            current_sublist.append(element)\n        else:\n            output_list.append(current_sublist)\n            current_sublist = [element]\n\n    if current_sublist:\n        output_list.append(current_sublist)\n\n    return output_list"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"Calculates the sum of all elements in all odd-length subarrays of the input array.\n    It iterates through all possible subarrays, sums those with odd lengths, and returns the total.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):  # Outer loop for starting index i\n        for j in range(i, n):  # Inner loop for ending index j\n            subarray = arr[i : j + 1]\n            if len(subarray) % 2 != 0:  # Check if subarray length is odd\n                total_sum += sum(subarray)\n\n    return total_sum"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(tuple_list: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    \"\"\"\n    Calculates unique element-wise sums of all distinct pairs of two-integer tuples from the input list.\n    It returns a list of these unique sum tuples, each containing two integers.\n    \"\"\"\n    result_combinations_set = set()\n    n = len(tuple_list)\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            tuple1 = tuple_list[i]\n            tuple2 = tuple_list[j]\n\n            sum_tuple_element1 = tuple1[0] + tuple2[0]\n            sum_tuple_element2 = tuple1[1] + tuple2[1]\n\n            sum_tuple = (sum_tuple_element1, sum_tuple_element2)\n            result_combinations_set.add(sum_tuple)\n\n    return list(result_combinations_set)"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(number: int) -> bool:\n    \"\"\"Checks if the count of positive divisors for a given number is even.\n    The function returns True if the divisor count is even, False otherwise.\"\"\"\n    divisor_count = 0\n    i = 1\n    while i * i <= number:\n        if number % i == 0:\n            if i * i == number:\n                divisor_count += 1\n            else:\n                divisor_count += 2\n        i += 1\n    return divisor_count % 2 == 0"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of all odd-length subarrays for a given input array.\n    This function iterates through all possible subarrays, summing those with an odd length.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        for j in range(i, n):\n            subarray = arr[i : j + 1]\n            if len(subarray) % 2 != 0:\n                total_sum += sum(subarray)\n    return total_sum"}
{"task_id": "Mbpp/781", "solution": "import math\ndef count_divisors(num: int) -> bool:\n    \"\"\"\n    Calculates the total number of positive divisors for num.\n    Returns True if the divisor count is even, False if odd.\n    \"\"\"\n    if num == 0:\n        return False\n    if num == 1:\n        return False\n\n    count = 0\n    limit = int(math.sqrt(abs(num)))\n\n    for i in range(1, limit + 1):\n        if abs(num) % i == 0:\n            count += 1\n            if i * i != abs(num):\n                count += 1\n\n    return count % 2 == 0"}
{"task_id": "Mbpp/772", "solution": "def remove_length(input_string: str, k: int) -> str:\n    \"\"\"\n    Removes all words of length k from the given input string.\n    Preserves the order of remaining words and normalizes whitespace.\n    \"\"\"\n    if not input_string:\n        return ''\n    if k <= 0:\n        # If k is non-positive, no words match for removal; whitespace is normalized.\n        return ' '.join(input_string.split())\n\n    words = input_string.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(input_list: list[int]) -> int:\n    \"\"\"\n    Finds the first odd and first even numbers in a list and returns their product.\n    Iteration stops once both numbers are identified.\n    \"\"\"\n    first_odd = None\n    first_even = None\n\n    for number in input_list:\n        if first_odd is None and number % 2 != 0:\n            first_odd = number\n        if first_even is None and number % 2 == 0:\n            first_even = number\n\n        if first_odd is not None and first_even is not None:\n            break\n\n    return first_odd * first_even"}
{"task_id": "Mbpp/784", "solution": "from typing import List, Union\ndef mul_even_odd(numbers: List[Union[int, float]]) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd number in a given list.\n\n    Args:\n        numbers: A list of numerical values (integers or floats).\n\n    Returns:\n        An integer representing the product of the first even and first odd numbers found.\n        Returns 0 if no even number or no odd number is found in the list.\n    \"\"\"\n    first_even: Union[int, float, None] = None\n    first_odd: Union[int, float, None] = None\n\n    for num in numbers:\n        # Check for even number\n        if num % 2 == 0:\n            if first_even is None:\n                first_even = num\n        # Check for odd number\n        else:\n            if first_odd is None:\n                first_odd = num\n\n        # Optimization: if both are found, no need to continue iterating\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is None or first_odd is None:\n        return 0\n    else:\n        # Calculate product and cast to int\n        return int(first_even * first_odd)"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(input_string: str) -> tuple[int, ...]:\n    \"\"\"\n    Converts a string representation of a tuple into a tuple of integers.\n    The function assumes valid input format based on critical requirements.\n    \"\"\"\n    content = input_string[1:-1]  # Remove outer parentheses.\n    if not content.strip():  # Handle empty tuple string \"()\"\n        return ()\n\n    # Split by comma, strip whitespace, convert to int, and form tuple.\n    int_elements = [int(part.strip()) for part in content.split(',')]\n    return tuple(int_elements)"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_string):\n    \"\"\"Converts a string representation of an integer tuple to a Python integer tuple.\n    Assumes valid input format to directly extract and convert elements.\n    \"\"\"\n    content = tuple_string[1:-1]\n\n    if not content:\n        return ()\n\n    elements_str = content.split(',')\n    int_elements = [int(s.strip()) for s in elements_str]\n\n    return tuple(int_elements)"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list: list, value: int) -> int:\n    \"\"\"Locates the rightmost insertion index for a value in a sorted list.\n    This uses a binary search approach to ensure efficiency for large lists.\"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] <= value:\n            # If current element is less than or equal to value,\n            # we need to search in the right half to find the position *after* duplicates.\n            low = mid + 1\n        else:\n            # If current element is greater than value,\n            # the insertion point must be at or to the left of mid.\n            high = mid\n    return low"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(main_string: str, substring_to_find: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence and position of a substring within a string.\n    Returns a tuple (substring, start_index, end_index) if a match is found.\n    Returns None if there is no match.\n    \"\"\"\n    if not substring_to_find:\n        return None\n\n    index = main_string.find(substring_to_find)\n    if index == -1:\n        return None\n    else:\n        return (substring_to_find, index, index + len(substring_to_find))"}
