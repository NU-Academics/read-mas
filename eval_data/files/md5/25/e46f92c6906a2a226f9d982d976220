{"task_id": "Mbpp/721", "solution": "import math\nclass Matrix:\n    \"\"\"Encapsulates matrix data, providing utilities for cell access and validation.\"\"\"\n    def __init__(self, matrix_data: list[list[int]]):\n        self._cells = matrix_data\n        self.N = len(matrix_data)\n        # Assuming validation for square matrix is handled by design based on \"trust the caller's inputs\".\n\n    def get_cost(self, row: int, col: int) -> int:\n        \"\"\"Returns the cost of the cell at (row, col).\"\"\"\n        return self._cells[row][col]\n\n    def is_valid_cell(self, row: int, col: int) -> bool:\n        \"\"\"Checks if the given row and column are within matrix bounds.\"\"\"\n        return 0 <= row < self.N and 0 <= col < self.N\nclass PathMetrics:\n    \"\"\"Stores and calculates total cost, number of cells, and average for a path.\"\"\"\n    def __init__(self, total_cost: int, num_cells: int):\n        self.total_cost = total_cost\n        self.num_cells = num_cells\n        self.average = 0.0 # Will be calculated by calculate_average\n\n    def calculate_average(self) -> float:\n        \"\"\"Computes and returns the average cost of the path.\"\"\"\n        if self.num_cells == 0:\n            self.average = 0.0\n        else:\n            self.average = float(self.total_cost) / self.num_cells\n        return self.average\nclass PathFinder:\n    \"\"\"Orchestrates pathfinding logic to determine the maximum average path.\"\"\"\n    def __init__(self, matrix: Matrix):\n        self._matrix = matrix\n        self._N = matrix.N\n\n    def _find_max_sum_path_dp(self) -> int:\n        \"\"\"Finds the maximum total cost path from (0,0) to (N-1, N-1) using DP.\"\"\"\n        dp = [[0 for _ in range(self._N)] for _ in range(self._N)]\n\n        dp[0][0] = self._matrix.get_cost(0, 0)\n\n        # Initialize first row\n        for c in range(1, self._N):\n            dp[0][c] = dp[0][c-1] + self._matrix.get_cost(0, c)\n\n        # Initialize first column\n        for r in range(1, self._N):\n            dp[r][0] = dp[r-1][0] + self._matrix.get_cost(r, 0)\n\n        # Fill the rest of the DP table\n        for r in range(1, self._N):\n            for c in range(1, self._N):\n                current_cost = self._matrix.get_cost(r, c)\n                dp[r][c] = current_cost + max(dp[r-1][c], dp[r][c-1])\n\n        return dp[self._N - 1][self._N - 1]\n\n    def find_max_average_path(self) -> float:\n        \"\"\"Finds the path with the maximum sum and calculates its average.\"\"\"\n        max_total_cost = self._find_max_sum_path_dp()\n\n        # All valid paths from top-left to bottom-right in an N*N matrix\n        # (moving only right or down) have the same number of cells: (2*N - 1)\n        num_cells_in_path = (2 * self._N) - 1\n\n        path_metrics = PathMetrics(max_total_cost, num_cells_in_path)\n        return path_metrics.calculate_average()\ndef maxAverageOfPath(matrix_data: list[list[int]]) -> float:\n    \"\"\"\n    Main function to calculate the maximum average path in a square matrix.\n    It identifies the path with the maximum total cost, then computes its average.\n    \"\"\"\n    matrix = Matrix(matrix_data)\n    path_finder = PathFinder(matrix)\n    return path_finder.find_max_average_path()"}
