{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and number of 1s\n    in any sub-string of the given binary string using Kadane's algorithm.\n    \"\"\"\n    if not binary_string:\n        return 0\n\n    # Transform '0' to 1 and '1' to -1.\n    # The sum of a transformed substring will represent (count of '0's) - (count of '1's).\n    transformed_array = [1 if char == '0' else -1 for char in binary_string]\n\n    max_ending_here = 0\n    overall_max = 0\n\n    for num in transformed_array:\n        max_ending_here += num\n        # If max_ending_here becomes negative, it means that the current subarray\n        # has more -1s (original 1s) than 1s (original 0s).\n        # Since we are looking for the maximum difference (0s - 1s), we reset\n        # max_ending_here to 0 if it goes below 0, effectively starting a new subarray.\n        if max_ending_here < 0:\n            max_ending_here = 0\n        # Update the overall maximum difference found so far.\n        overall_max = max(overall_max, max_ending_here)\n\n    return overall_max"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"Calculates the maximum difference between counts of '0's and '1's in any substring.\n    Uses a Kadane's algorithm variant to efficiently find the maximum sum of transformed values.\n    \"\"\"\n    if not binary_string:\n        return 0\n\n    max_diff = -float('inf')\n    current_sum = 0\n\n    for char in binary_string:\n        # Convert '0' to 1 and '1' to -1\n        value = 1 if char == '0' else -1\n\n        current_sum += value\n        max_diff = max(max_diff, current_sum)\n\n        # Reset current_sum if it becomes negative, as per Kadane's variant\n        if current_sum < 0:\n            current_sum = 0\n\n    return max_diff"}
{"task_id": "Mbpp/126", "solution": "def sum(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of common divisors for two given positive integers.\n    \"\"\"\n    divisors1 = set()\n    for i in range(1, int(num1**0.5) + 1):\n        if num1 % i == 0:\n            divisors1.add(i)\n            divisors1.add(num1 // i)\n\n    divisors2 = set()\n    for i in range(1, int(num2**0.5) + 1):\n        if num2 % i == 0:\n            divisors2.add(i)\n            divisors2.add(num2 // i)\n\n    common_divs = divisors1.intersection(divisors2)\n    return sum(common_divs)"}
{"task_id": "Mbpp/126", "solution": "import math\nimport builtins\ndef _get_divisors(n: int) -> set[int]:\n    \"\"\"Finds all positive divisors for a given positive integer.\"\"\"\n    divs = set()\n    for i in range(1, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            divs.add(i)\n            divs.add(n // i)\n    return divs\ndef sum(num1: int, num2: int) -> int:\n    \"\"\"Calculates the sum of common divisors for two positive integers.\"\"\"\n    divisors1 = _get_divisors(num1)\n    divisors2 = _get_divisors(num2)\n    common_divs = divisors1.intersection(divisors2)\n    return builtins.sum(common_divs)"}
