{"task_id": "Mbpp/585", "solution": "def expensive_items(dataset: list[dict], n: int) -> list[dict]:\n    \"\"\"Finds the 'n' most expensive items from a list of item dictionaries.\n    Handles cases where n is zero/negative or larger than the dataset.\n    \"\"\"\n    if n <= 0:\n        return []\n\n    # Sort the items by their 'price' in descending order.\n    # The sorted() function returns a new list without modifying the original.\n    sorted_items = sorted(dataset, key=lambda item: item['price'], reverse=True)\n\n    # Return the first 'n' items from the sorted list.\n    # This slice handles cases where n is larger than the dataset length by returning all items.\n    return sorted_items[:n]"}
{"task_id": "Mbpp/589", "solution": "import math\ndef perfect_squares(lower_bound: int, upper_bound: int) -> list[int]:\n    \"\"\"\n    Finds all perfect squares within the specified inclusive integer range.\n    It efficiently determines the range of integers whose squares fall within the given bounds.\n    \"\"\"\n    perfect_squares_list = []\n\n    # Calculate the starting integer whose square is >= lower_bound\n    start_root = math.ceil(math.sqrt(lower_bound))\n\n    # Calculate the ending integer whose square is <= upper_bound\n    end_root = math.floor(math.sqrt(upper_bound))\n\n    # Iterate from start_root to end_root (inclusive) and collect their squares\n    for i in range(int(start_root), int(end_root) + 1):\n        perfect_squares_list.append(i * i)\n\n    return perfect_squares_list"}
{"task_id": "Mbpp/589", "solution": "def perfect_squares(lower_bound: int, upper_bound: int) -> list[int]:\n    \"\"\"\n    Finds all perfect squares within the inclusive range [lower_bound, upper_bound].\n    Returns a list of perfect squares, or an empty list if none are found or the range is invalid.\n    \"\"\"\n    if lower_bound > upper_bound:\n        return []\n\n    result = []\n    # Determine the starting root for iteration.\n    start_root = 0\n    if lower_bound > 0:\n        start_root = int(lower_bound**0.5)\n        # Adjust start_root if its square is less than lower_bound.\n        if start_root * start_root < lower_bound:\n            start_root += 1\n\n    current_root = start_root\n    while True:\n        square = current_root * current_root\n        if square > upper_bound:\n            break\n        # Add the square to results only if it meets the lower_bound.\n        if square >= lower_bound:\n            result.append(square)\n        current_root += 1\n    return result"}
{"task_id": "Mbpp/581", "solution": "import math\ndef surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"Calculates the surface area of a square pyramid given its base edge and height.\n    It sums the base area and the lateral surface area of the four triangular faces.\"\"\"\n\n    # Calculate the area of the square base.\n    base_area = base_edge * base_edge\n\n    # Calculate the slant height of the pyramid using the Pythagorean theorem.\n    half_base_edge = base_edge / 2\n    slant_height = math.sqrt(height**2 + half_base_edge**2)\n\n    # Calculate the lateral surface area, which is 2 * base_edge * slant_height.\n    # This comes from 4 * (0.5 * base_edge * slant_height).\n    lateral_surface_area = 2 * base_edge * slant_height\n\n    # The total surface area is the sum of the base area and the lateral surface area.\n    total_surface_area = base_area + lateral_surface_area\n\n    return total_surface_area"}
