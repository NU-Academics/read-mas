{"task_id": "Mbpp/7", "solution": "def find_char_long(input_string: str) -> set[str]:\n    \"\"\"\n    Identifies and returns unique words from an input string that are at least 4 characters long.\n    Words are split by whitespace, and the results are stored in a set to ensure uniqueness.\n    \"\"\"\n    result_set = set()\n    words = input_string.split()\n\n    for word in words:\n        if len(word) >= 4:\n            result_set.add(word)\n\n    return result_set"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"Calculates the minimum rotations (greater than 0) for a string to return to its original form.\"\"\"\n    original_s = s\n    rotation_count = 0\n    current_s = s\n\n    # Continuously rotate the string and count until it matches the original.\n    while True:\n        rotation_count += 1\n        current_s = current_s[1:] + current_s[0]  # Perform one rotation.\n\n        if current_s == original_s:\n            return rotation_count"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string, char_to_remove):\n    \"\"\"\n    Removes the first and last occurrences of a specified character from a string.\n    Handles cases where the character is not found or appears only once.\n    \"\"\"\n    first_index = input_string.find(char_to_remove)\n    last_index = input_string.rfind(char_to_remove)\n\n    if first_index == -1:\n        # Character not found, return original string\n        return input_string\n    elif first_index == last_index:\n        # Character found only once, remove that single instance\n        return input_string[:first_index] + input_string[first_index+1:]\n    else:\n        # Character found multiple times, remove both first and last\n        temp_list = list(input_string)\n        del temp_list[last_index]  # Remove last occurrence first to prevent shifting first_index\n        del temp_list[first_index] # Then remove the original first occurrence\n        return \"\".join(temp_list)"}
{"task_id": "Mbpp/7", "solution": "import re\ndef _split_words(text: str) -> list[str]:\n    \"\"\"\n    Splits the input text into a list of words, retaining original casing.\n    It uses regex to find word boundaries and exclude punctuation.\n    \"\"\"\n    return re.findall(r'\\b\\w+\\b', text)\ndef _filter_by_length(words: list[str], min_length: int) -> set[str]:\n    \"\"\"\n    Filters a list of words, keeping only those at least 'min_length' characters long,\n    and returns them as a set of unique strings.\n    \"\"\"\n    return {word for word in words if len(word) >= min_length}\ndef find_char_long(text: str) -> set[str]:\n    \"\"\"\n    Splits the input string into words, filters them by length (>= 4 characters),\n    and returns a set of unique long words.\n    \"\"\"\n    words_list = _split_words(text)\n    return _filter_by_length(words_list, 4)"}
{"task_id": "Mbpp/12", "solution": "class Matrix:\n    \"\"\"Encapsulates a collection of Row objects and provides matrix-level sorting functionality.\"\"\"\n    _rows: List[Row]\n\n    def __init__(self, raw_matrix_data: List[List[Union[int, float]]]):\n        \"\"\"Initializes a Matrix object from raw list of lists data.\"\"\"\n        self._rows = [Row(raw_row) for raw_row in raw_matrix_data]\n\n    def sort_rows_by_sum_ascending(self) -> None:\n        \"\"\"Sorts the internal list of Row objects in ascending order based on their sums.\"\"\"\n        self._rows.sort(key=lambda row: row.calculate_sum())\n\n    def to_list(self) -> List[List[Union[int, float]]]:\n        \"\"\"Converts the Matrix object back into a raw list of lists format.\"\"\"\n        return [row.get_elements() for row in self._rows]\ndef sort_matrix(matrix_data: List[List[Union[int, float]]]) -> List[List[Union[int, float]]]:\n    \"\"\"Sorts a matrix's rows by their sums in ascending order.\n    It orchestrates the use of Matrix and Row objects to perform the sorting.\"\"\"\n    matrix_obj = Matrix(matrix_data)\n    matrix_obj.sort_rows_by_sum_ascending()\n    return matrix_obj.to_list()"}
