{"task_id": "Mbpp/70", "solution": "def get_equal(list_of_tuples: list[tuple]) -> bool:\n    \"\"\"\n    Checks if all tuples in the given list have equal length.\n    Returns True if all tuples have equal length, or if the list is empty or contains only one tuple.\n    \"\"\"\n    # Handle empty or single-tuple lists as per requirements.\n    if not list_of_tuples or len(list_of_tuples) == 1:\n        return True\n\n    # Store the length of the first tuple for comparison.\n    first_tuple_length = len(list_of_tuples[0])\n    # Iterate through remaining tuples, returning False on any length mismatch.\n    for i in range(1, len(list_of_tuples)):\n        if len(list_of_tuples[i]) != first_tuple_length:\n            return False\n\n    return True"}
{"task_id": "Mbpp/71", "solution": "from typing import List, TypeVar, Any\nComparable = TypeVar('Comparable', bound=Any)\ndef comb_sort(input_list: List[Comparable]) -> List[Comparable]:\n    \"\"\"\n    Sorts a list of comparable elements using the Comb Sort algorithm.\n    Returns a new list containing the input elements sorted in ascending order.\n    \"\"\"\n    arr = list(input_list)\n    n = len(arr)\n\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        if gap > 1:\n            gap = int(gap / shrink_factor)\n            if gap < 1:\n                gap = 1\n\n        swapped = False\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n\n    return arr"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(tuples_list: list[tuple[int, ...]], k: int) -> list[tuple[int, ...]]:\n    \"\"\"\n    Filters a list of tuples, returning a new list containing only those\n    where all elements within the tuple are divisible by k.\n    \"\"\"\n    filtered_list = []\n    for current_tuple in tuples_list:\n        if all(element % k == 0 for element in current_tuple):\n            filtered_list.append(current_tuple)\n    return filtered_list"}
{"task_id": "Mbpp/74", "solution": "from typing import List\ndef is_samepatterns(colors: List[str], patterns: List[str]) -> bool:\n    \"\"\"\n    Determines if a list of colors consistently follows a specified pattern sequence\n    with a one-to-one mapping. Returns True if consistent, False otherwise.\n    \"\"\"\n    if len(colors) != len(patterns):\n        return False\n\n    pattern_to_color_map = {}\n    color_to_pattern_map = {}\n\n    for i in range(len(colors)):\n        pattern_element = patterns[i]\n        color_element = colors[i]\n\n        # Check pattern-to-color consistency\n        if pattern_element in pattern_to_color_map:\n            if pattern_to_color_map[pattern_element] != color_element:\n                return False  # Pattern maps to different colors\n        else:\n            # If pattern_element is new, check color-to-pattern consistency\n            if color_element in color_to_pattern_map:\n                if color_to_pattern_map[color_element] != pattern_element:\n                    return False  # Different patterns map to the same color\n            else:\n                # Both pattern and color are new, establish new bidirectional mappings\n                pattern_to_color_map[pattern_element] = color_element\n                color_to_pattern_map[color_element] = pattern_element\n\n    return True"}
{"task_id": "Mbpp/75", "solution": "from typing import List, Tuple\ndef find_tuples(list_of_tuples: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    \"\"\"\n    Filters a list of tuples, returning only those where all elements\n    within each tuple are perfectly divisible by 'k'.\n    \"\"\"\n    filtered_tuples = []\n    for current_tuple in list_of_tuples:\n        if all(element % k == 0 for element in current_tuple):\n            filtered_tuples.append(current_tuple)\n    return filtered_tuples"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(strings, patterns):\n    \"\"\"\n    Checks if two lists follow the same structural sequence with a one-to-one bidirectional mapping.\n    Returns True if patterns are consistent, False otherwise.\n    \"\"\"\n    if len(strings) != len(patterns):\n        return False\n\n    string_to_pattern_map = {}\n    pattern_to_string_map = {}\n\n    for i in range(len(strings)):\n        string_element = strings[i]\n        pattern_element = patterns[i]\n\n        if string_element in string_to_pattern_map:\n            # If string_element is already mapped, verify consistency.\n            if string_to_pattern_map[string_element] != pattern_element:\n                return False\n        else:\n            if pattern_element in pattern_to_string_map:\n                # If pattern_element is already mapped, verify consistency from its side.\n                if pattern_to_string_map[pattern_element] != string_element:\n                    return False\n            else:\n                # Establish new bidirectional mappings for unseen elements.\n                string_to_pattern_map[string_element] = pattern_element\n                pattern_to_string_map[pattern_element] = string_element\n\n    return True"}
