 "solution": "def order_by_points(nums):\n    \"\"\"\n    Write a function which sorts the given list of integers\n    in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their index in original list.\n\n    For example:\n    >>> order_by_points([1, 11, -1, -11, -12]) == [-1, -11, 1, -12, 11]\n    >>> order_by_points([]) == []\n    \"\"\"\n    class DigitSumCalculator:\n        @staticmethod\n        def calculate(num: int) -> int:\n            \"\"\"Calculates the sum of the absolute value of digits for an integer.\"\"\"\n            s = 0\n            num_abs = abs(num)\n            while num_abs > 0:\n                s += num_abs % 10\n                num_abs //= 10\n            return s\n\n    class SortableInteger:\n        \"\"\"Helper to encapsulate value, original index, and digit sum for custom sorting.\"\"\"\n        def __init__(self, value: int, original_index: int, digit_sum: int):\n            self.value = value\n            self.original_index = original_index\n            self.digit_sum = digit_sum\n\n        def __lt__(self, other: 'SortableInteger') -> bool:\n            \"\"\"Defines 'less than' comparison: digit_sum primary, original_index secondary.\"\"\"\n            if self.digit_sum == other.digit_sum:\n                return self.original_index < other.original_index\n            return self.digit_sum < other.digit_sum\n\n    if not nums:\n        return []\n\n    sortable_items = []\n    for i, num in enumerate(nums):\n        digit_sum = DigitSumCalculator.calculate(num)\n        sortable_items.append(SortableInteger(num, i, digit_sum))\n\n    sortable_items.sort()\n\n    return [item.value for item in sortable_items]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[-5, -12, 9, 15]]]}], "HumanEval/149": [{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n 