en positions.\n    \n\n    Examples\n    solution([5, 8, 7, 1]) ==> 12\n    solution([3, 3, 3, 3, 3]) ==> 9\n    solution([30, 13, 24, 321]) ==>0\n    \"\"\"\n    total_sum = 0\n    for i, element in enumerate(lst):\n        # Check if the current position (index) is even and the element is odd.\n        if i % 2 == 0 and element % 2 != 0:\n            total_sum += element\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/116": [{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    Sorts an array of integers according to the number of ones in their binary\n    representation for non-negative numbers, or purely by decimal value for negative numbers.\n    \"\"\"\n    _bit_count_cache = {}\n\n    def count_ones(n: int) -> int:\n        \"\"\"Counts the number of set bits in a non-negative integer using Brian Kernighan's algorithm.\"\"\"\n        if n in _bit_count_cache:\n            return _bit_count_cache[n]\n        \n        count = 0\n        temp_n = n\n        while temp_n > 0:\n            temp_n &= (temp_n - 1)\n            count += 1\n        \n        _bit_count_cache[n] = count\n        return count\n\n    def _sort_key(num: int) -> tuple[int, int]:\n        \"\"\"Generates a sorting key based on problem rules.\"\"\"\n        if num < 0:\n            # Negative numbers are sorted purely by decimal value.\n            return (0, num) # 0 is a placeholder for bit count, ensuring negative numbers are grouped.\n        else:\n            # Non-negative numbers are sorted by bit count, then by decimal value.\n            bit_count = count_ones(num)\n            return (bit_count, num)\n\n    return sorted(arr, key=_sort_key)", "base_status": "fail", "plus_status": "pass", "base_fail_tests": [[[-2, -3, -4, -5, -6]]], "plus_fail_tests": []}], "HumanEval/117": [{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, you have been tasked to implement \n    a function that returns a list of all words from string s that contain exactly \n    n consonants, in order these words appear in the string s.\n    If the string s is empty then the function should return an empty list.\n    Note: you may assume the input string contains only letters and spaces.\n    Examples:\n    select_words(\"Mary had a little lamb\", 4) ==> [\"little\"]\n    select_words(\"Mary had a little lamb\", 3) ==> [\"Mary\", \"lamb\"]\n    select_words(\"simple white space\", 2) ==> []\n    select_words(\"Hello world\", 4) ==> [\"world\"]\n    select_words(\"Uncle sam\", 3) ==> [\"Uncle\"]\n    \"\"\"\n    if not s:\n        return []\n\n    class VowelChecker:\n        def __init__(self):\n            self._VOWELS = \"aeiou\"\n\n        def is_vowel(self, char: str) -> bool:\n            \"\"\"Checks if the input character is a vowel (case-insensitive).\"\"\"\n            return char.lower() in self._VOWELS\n\n    class ConsonantCounter:\n        def __init__(self, vowel_checker: VowelChecker):\n            self._vowel_checker = vowel_checker\n\n        def count_consonants(self, word: str) -> int:\n            \"\"\"Counts the number of consonants in the given word. It uses VowelChecker to identify vowels.\"\"\"\n            consonant_count = 0\n            for char in word:\n                if char.isalpha() and not self._vowel_checker.is_vowel(char):\n                    consonant_count += 1\n            return consonant_count\n\n    class WordSelector:\n        def __init__(self, consonant_counter: ConsonantCounter):\n            self._consonant_counter = consonant_counter\n\n        def select_words_impl(self, s_param: str, n_param: int) -> list[str]:\n            \"\"\"Splits the string into words, counts consonants, and filters words matching the target count.\"\"\"\n            words = s_param.split()\n            result = []\n            for word in words:\n                if self._consonant_counter.count_consonants(word) == n_param:\n                    result.append(word)\n            return result\n\n    vowel_checker = VowelChecker()\n    consonant_counter = ConsonantCounter(vowel_checker)\n    word_selector = WordSelector(consonant_counter)\n    return word_selector.select_words_impl(s, n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/122": [{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Calculates the sum of elements with at most two digits from the first k elements of arr.\n    An element has at most two digits if its absolute value is less than or equal to 99.\n    \"\"\"\n    total_sum = 0\n    for i in range(k):\n        element = arr[i]\n        if -99 <= element <= 99:\n            total_sum += element\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/118": [{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel that stands between two consonants from the right side of the word.\n    Vowels at the beginning and ending do not count.\n    \"\"\"\n    VOWELS_SET = \"aeiouAEIOU\"\n\n    def _is_vowel(char):\n        \"\"\"Checks if a character is an English vowel.\"\"\"\n        return char in VOWELS_SET\n\n    def _is_consonant(char):\n        \"\"\"Checks if a character is an English consonant.\"\"\"\n        return char.isalpha() and not _is_vowel(char)\n\n    n = len(word)\n    # A vowel must have a consonant on its left and right, so a minimum length of 3 is required.\n    # We iterate from n-2 down to 1, excluding the first and last characters.\n    if n < 3:\n        return \"\"\n\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        if _is_vowel(current_char):\n            left_char = word[i - 1]\n            right_char = word[i + 1]\n            if _is_consonant(left_char) and _is_cons