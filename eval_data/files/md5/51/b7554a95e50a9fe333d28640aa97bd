       if is_valid(nr, nc):\n                neighbors.append((nr, nc))\n        return neighbors\n\n    def dfs_search(r, c, current_path):\n        \"\"\"Recursively explores paths of length k using Depth-First Search.\"\"\"\n        nonlocal min_path\n\n        if len(current_path) == k:\n            # Python's list comparison is lexicographical\n            if current_path < min_path:\n                min_path = list(current_path) # Create a copy to avoid modification issues\n            return\n\n        # Optimization: If the current path is already lexicographically greater than\n        # the known minimum path of the same length, prune this branch.\n        # This check is implicitly handled by the comparison `current_path < min_path`\n        # when `len(current_path) == k`. For intermediate paths, it's harder\n        # to prune effectively without knowing future elements.\n        # However, for the first few elements, if current_path[i] > min_path[i],\n        # then we can prune.\n        if len(current_path) <= len(min_path):\n             for i in range(len(current_path)):\n                 if current_path[i] > min_path[i]:\n                     return # Current path is already worse than min_path, prune\n                 if current_path[i] < min_path[i]:\n                     break # Current path is better, continue exploring this branch\n\n        for next_r, next_c in get_neighbors(r, c):\n            dfs_search(next_r, next_c, current_path + [grid[next_r][next_c]])\n\n    # Start DFS from each cell in the grid\n    for r_start in range(N):\n        for c_start in range(N):\n            dfs_search(r_start, c_start, [grid[r_start][c_start]])\n\n    return min_path", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[10, 5, 20, 14, 16], [7, 11, 12, 17, 9], [13, 19, 1, 15, 8], [3, 18, 4, 6, 2], [22, 21, 23, 24, 25]], 25]]}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n + 1 numbers of the Tribonacci sequence.\n    The sequence starts with tri(0) = 1, tri(1) = 3, and follows specific\n    recurrence rules for even and odd numbers.\n    \"\"\"\n    memo = {}\n\n    def _get_tri(k):\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            result = 1.0\n        elif k == 1:\n            result = 3.0\n        elif k % 2 == 0:  # k is even and k > 0\n            result = 1.0 + k / 2.0\n        else:  # k is odd and k > 1\n            # This relies on _get_tri handling recursive calls and memoization\n            term_k_minus_1 = _get_tri(k - 1)\n            term_k_minus_2 = _get_tri(k - 2)\n            term_k_plus_1 = _get_tri(k + 1)\n            result = term_k_minus_1 + term_k_minus_2 + term_k_plus_1\n        \n        memo[k] = result\n        return result\n\n    sequence = []\n    for i in range(n + 1):\n        sequence.append(_get_tri(i))\n    return sequence", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/83": [{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    # For n=1, the only 1-digit positive integer is 1. It starts with 1 and ends with 1.\n    if n == 1:\n        return 1\n\n    # Count numbers that start with 1:\n    # These are numbers from 10^(n-1) to (199...9) (n-1 nines).\n    # There are 10^(n-1) such numbers.\n    count_starts_with_1 = 10**(n - 1)\n\n    # Count numbers that end with 1:\n    # For n > 1, these are numbers like X...X1. The first n-1 digits can range from 10...0 to 99...9.\n    # There are 9 * 10^(n-2) such numbers (e.g., for n=2, 11, 21, ..., 91; for n=3, 101, ..., 991).\n    count_ends_with_1 = 9 * (10**(n - 2))\n\n    # Count numbers that start AND end with 1:\n    # For n=1, it's 1. For n=2, it's 11.\n    # For n > 2, these are numbers like 1X...X1, where the middle (n-2) digits can be any (0-9).\n    # There are 10^(n-2) such numbers.\n    count_starts_and_ends_with_1 = 10**(n - 2)\n\n    # Apply the principle of inclusion-exclusion: P(A or B) = P(A) + P(B) - P(A and B).\n    total_count = count_starts_with_1 + count_ends_with_1 - count_starts_and_ends_with_1\n    return total_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "def _factorial(k):\n    \"\"\"Calculates the standard factorial of a non-negative integer k.\"\"\"\n    res = 1\n    for i in range(1, k + 1):\n        res *= i\n    return res\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    total_special_factorial = 1\n    for i in range(1, n + 1):\n        current_factorial = _factorial(i)\n        total_special_factorial *= current_factorial\n    return total_special_factorial", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}