OTE = \"o\"\n        HALF_NOTE = \"o|\"\n        QUARTER_NOTE = \".|\"\n\n        @staticmethod\n        def get_beat_value(note_symbol: str) -> int:\n            if note_symbol == NoteType.WHOLE_NOTE.value:\n                return 4\n            elif note_symbol == NoteType.HALF_NOTE.value:\n                return 2\n            elif note_symbol == NoteType.QUARTER_NOTE.value:\n                return 1\n            raise ValueError(f\"Unknown note symbol: {note_symbol}\")\n\n    NOTE_BEAT_MAP = {\n        NoteType.WHOLE_NOTE.value: 4,\n        NoteType.HALF_NOTE.value: 2,\n        NoteType.QUARTER_NOTE.value: 1,\n    }\n\n    class MusicParser:\n        def __init__(self):\n            self._note_beat_map = NOTE_BEAT_MAP\n\n        def parse(self, music_string: str) -> List[int]:\n            if not music_string.strip():\n                return []\n\n            note_symbols = music_string.split(' ')\n            beat_durations: List[int] = []\n\n            for symbol in note_symbols:\n                if not symbol:\n                    continue\n                beat_value = self._note_beat_map.get(symbol)\n                if beat_value is None:\n                    raise InvalidNoteError(note_symbol=symbol)\n                beat_durations.append(beat_value)\n\n            return beat_durations\n\n    parser = MusicParser()\n    return parser.parse(music_string)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/27": [{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    flipped_chars = []\n    for char in string:\n        if char.islower():\n            flipped_chars.append(char.upper())\n        elif char.isupper():\n            flipped_chars.append(char.lower())\n        else:\n            flipped_chars.append(char)\n    return \"