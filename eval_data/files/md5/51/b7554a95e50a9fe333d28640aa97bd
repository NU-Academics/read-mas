: "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all \n    elements that hasn't any even digit.\n    \"\"\"\n\n    def _has_even_digit(number):\n        \"\"\"Checks if a given integer contains any even digits (0, 2, 4, 6, 8).\"\"\"\n        temp_num = number\n        while temp_num > 0:\n            digit = temp_num % 10\n            if digit % 2 == 0:\n                return True\n            temp_num //= 10\n        return False\n\n    filtered_list = []\n    for number in x:\n        if not _has_even_digit(number):\n            filtered_list.append(number)\n    \n    filtered_list.sort()\n    return filtered_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/36": [{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\"\"\"\n    count_of_sevens = 0\n    for i in range(1, n):\n        if i % 11 == 0 or i % 13 == 0:\n            count_of_sevens += str(i).count('7')\n    return count_of_sevens", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/99": [{"task_id": "HumanEval/99", "solution": "import math\ndef closest_integer(value):\n    \"\"\"\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n    \"\"\"\n    num = float(value)\n\n    # Handle positive and negative numbers by operating on the absolute value\n    abs_num = abs(num)\n    floor_abs_num = math.floor(abs_num)\n    \n    # Determine if the fractional part is 0.5 or greater\n    if abs_num - floor_abs_num >= 0.5:\n        # If equidistant or rounds up, use ceil on the absolute value\n        rounded_abs = math.ceil(abs_num)\n    else:\n        # Otherwise, use floor on the absolute value\n        rounded_abs = floor_abs_num\n    \n    # Apply the original sign to the rounded absolute value and convert to integer\n    return int(math.copysign(rounded_abs, num))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/107": [{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n    def is_palindrome(num):\n        \"\"\"Checks if a given integer is a palindrome by comparing its string representation with its reverse.\"\"\"\n        s = str(num)\n        return s == s[::-1]\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        if is_palindrome(i):\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return (even_count, odd_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/106": [{"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\" Implement the function f that takes n as a parameter,\n    and returns a list of size n, such that the value of the element at index i is the factorial of i if i is even\n    or the sum of numbers from 1 to i otherwise.\n    i starts from 1.\n    the factorial of i is the multiplication of the numbers from 1 to i (1 * 2 * ... * i).\n    Example:\n    f(5) == [1, 2, 6, 24, 15]\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    def _calculate_factorial(val: int) -> int:\n        \"\"\"Calculates the factorial of a non-negative integer.\"\"\"\n        if val == 0:\n            return 1\n        res = 1\n        for k in range(1, val + 1):\n            res *= k\n        return res\n\n    def _calculate_sum_up_to_i(val: int) -> int:\n        \"\"\"Calculates the sum of all integers from 1 up to val.\"\"\"\n        return val * (val + 1) // 2\n\n    result_list = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # i is even\n            result_list.append(_calculate_factorial(i))\n        else:  # i is odd\n            result_list.append(_calculate_sum_up_to_i(i))\n    return result_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/108": [{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts elements in an array where the sum of digits is greater than 0.\n    For negative numbers, the first digit is treated as negative.\n    \"\"\"\n\n    def _calculate_digit_sum(num: int) -> int:\n        \"\"\"Calculates the sum of digits for a number, applying special handling for negative numbers.\"\"\"\n        if num == 0:\n            return 0\n        \n        s = str(num)\n        digit_sum = 0\n        if s[0] == '-':\n            # The first digit of a negative number is treated as negative.\n            digit_sum += int(s[1]) * -1\n            for digit_char in s[2:]:\n                digit_sum += int(digit_char)\n        else:\n            # All digits are positive for non-negative numbers.\n            for digit_char in s:\n                digit_sum += int(digit_char)\n        return digit_sum\n\n    count = 0\n    for num in arr:\n        if _calculate_digit_sum(num) > 0:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/105": [{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name.\n    \"\"\"\n\n    class DigitMapper:\n        \"\"\"Maps digits (1-9) to their English word representations.\"\"\"\n        def __init__(self):\n            self._DIGIT_WORDS = {\n                1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n                6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n            }\n\n        def get_word(self, digit: int) -> str:\n            \"\"\"Returns the word representation for a given digit.\"\"\"\n            return self._DIGIT_WORDS.get(digit, \"\")\n\n    def is_valid_digit(num: int) -> bool:\n        \"\"\"Checks if a number is an integer between 1 and 9 inclusive.\"\"\"\n        return 1 <= num <= 9\n\n    class NumberProcessor:\n        \"\"\"\n        Processes an array of integers by filtering, sorting, reversing,\n        and converting valid digits to their word representations.\n        \"\"\"\n        def __init__(self, digit_mapper: DigitMapper):\n            self._digit_mapper = digit_mapper\n\n        def process(self, arr: list[int]) -> list[str]:\n            \"\"\"Main method to process the array.\"\"\"\n            filtered_arr = self._filter_valid_digits(arr)\n            if not filtered_arr:\n                return []\n\n            sorted_reversed_arr = self._sort_and_reverse(filtered_arr)\n            result_words = self._map_to_words(sorted_reversed_arr)\n            return result_words\n\n        def _filter_valid_digits(self, arr: list[int]) -> list[int]:\n            \"\"\"Filters the input array to include only integers between 1 and 9.\"\"\"\n            return [num for num in arr if is_valid_digit(num)]\n\n        def _sort_and_reverse(self, arr: list[int]) -> list[int]:\n            \"\"\"Sorts the array in ascending order and then reverses it.\"\"\"\n            arr.sort()\n            arr.reverse()\n            return arr\n\n        def _map_to_words(self, arr: list[int]) -> list[str]:\n            \"\"\"Converts each integer in the array to its word representation.\"\"\"\n            return [self._digit_mapper.get_word(digit) for digit in arr]\n\n    digit_mapper = DigitMapper()\n    processor = NumberProcessor(digit_mapper)\n    return processor.process(arr)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/103": [{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"Computes the rounded average of integers from n through m, converted to binary.\n    Returns -1 if n is greater than m.\n    \"\"\"\n    if n > m:\n        return -1\n\n    # Calculate the sum of integers from n to m using arithmetic progression formula.\n    count = m - n + 1\n    total_sum = (count * (n + m)) // 2\n\n    # Compute the average as a floating-point number.\n    avg_val = total_sum / count\n\n    # Round the average to the nearest integer using Python's default rounding (round half to even).\n    rounded_val = round(avg_val)\n\n    # Convert the rounded integer to its binary string representation.\n    binary_str = bin(rounded_val)\n\n    return binary_str", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/111": [{"task_id": "HumanEval/111", "solution": "def histogram(test):\n    \"\"\"Given a string representing a space separated lowercase letters, return a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\n    \"\"\"\n    from collections import Counter\n\n    if not test:\n        return {}\n\n    letters_list = test.split(' ')\n    # Filter out any empty strings that might result from multiple spaces (e.g., 'a  b')\n    actual_letters = [letter for letter in letters_list if letter]\n\n    if not actual_letters:\n        return {}\n\n    counts = Counter(actual_letters)\n\n    max_count = max(counts.values())\n\n    result = {letter: count for letter, count in counts.items() if count == max_count}\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/109": [{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Determines if an array can be sorted in non-decreasing order by\n    performing right shift operations.\"\"\"\n    if not arr:\n        return True\n\n    n = len(arr)\n    break_points = []\n    for i in range(n - 1):\n        if arr[i] > arr[i+1]:\n            break_points.append(i)\n\n    if len(break_points) == 0:\n        # Array is already sorted\n        return True\n    elif len(break_points) == 1:\n        # One break point indicates a potentially rotated sorted array.\n        # Check if the last element is less than or equal to the first element.\n        return arr[n - 1] <= arr[0]\n    else:\n        # More than one break point means it cannot be sorted by a single rotation.\n        return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/112": [{"task_id": "HumanEval/112", "solution": "def reverse_delete(s,c):\n    \"\"\"Task\n    We are given two strings s and c, you have to deleted all the characters in s that are equal to any character in c\n    then check if the result string is palindrome.\n    A string is called palindrome if it reads the same backward as forward.\n    You should return a tuple containing the result string and True/False for the check.\n    Example\n    For s = \"abcde\", c = \"ae\", the result should be ('bcd',False)\n    For s = \"abcdef\", c = \"b\"  the result should be ('acdef',False)\n    For s = \"abcdedcba\", c = \"ab\", the result should be ('cdedc',True)\n    \"\"\"\n    # Convert 'c' to a set for efficient character lookup (O(1) average time complexity).\n    chars_to_delete_set = set(c)\n\n    # Delete characters from 's' that are present in 'c'.\n    modified_s = \"\".join(char for char in s if char not in chars_to_delete_set)\n\n    # Check if the resulting string is a palindrome.\n    is_palindrome = (modified_s == modified_s[::-1])\n\n    # Return a tuple containing the modified string and the palindrome check result.\n    return (modified_s, is_palindrome)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/110": [{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if lst1 can be made entirely of even numbers by exchanging elements with lst2.\"\"\"\n    odd_count_lst1 = 0\n    for num in lst1:\n        if num % 2 != 0:\n            odd_count_lst1 += 1\n\n    even_count_lst2 = 0\n    for num in lst2:\n        if num % 2 == 0:\n            even_count_lst2 += 1\n\n    if odd_count_lst1 <= even_count_lst2:\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/115": [{"task_id": "HumanEval/115", "solution": "import math\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the total number of times buckets need to be lowered to empty all wells.\n    It sums the water in each well and applies ceiling division by capacity to find bucket operations per well.\n    \"\"\"\n    total_bucket_operations = 0\n    for row in grid:\n        # Calculate the total water units in the current well.\n        total_water_in_well = sum(row)\n        \n        # Calculate the number of bucket operations needed for this well, rounding up.\n        operations_for_well = math.ceil(total_water_in_well / capacity)\n        \n        total_bucket_operations += operations_for_well\n        \n    return total_bucket_operations", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/114": [{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums.\n    \"\"\"\n    min_so_far = float('inf')\n    current_min = float('inf')\n\n    for num in nums:\n        current_min = min(num, current_min