{"task_id": "HumanEval/36", "solution": "```python\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\"\"\"\n\n    def _is_divisible_by_11(num: int) -> bool:\n        \"\"\"Checks if a number is divisible by 11.\"\"\"\n        return num % 11 == 0\n\n    def _is_divisible_by_13(num: int) -> bool:\n        \"\"\"Checks if a number is divisible by 13.\"\"\"\n        return num % 13 == 0\n\n    def _count_digit_7(num: int) -> int:\n        \"\"\"Counts occurrences of the digit '7' in a number.\"\"\"\n        return str(num).count('7')\n\n    total_count = 0\n    for x in range(1, n):\n        if _is_divisible_by_11(x) or _is_divisible_by_13(x):\n            total_count += _count_digit_7(x)\n    return total_count\n```"}
{"task_id": "HumanEval/37", "solution": "```python\ndef sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    \"\"\"\n    if not l:\n        return []\n\n    new_list = [None] * len(l)\n    even_elements = []\n\n    # First pass: collect even-indexed elements and place odd-indexed elements\n    for i in range(len(l)):\n        if i % 2 == 0:  # Even index\n            even_elements.append(l[i])\n        else:  # Odd index\n            new_list[i] = l[i]\n\n    # Sort the collected even-indexed elements\n    even_elements.sort()\n\n    # Second pass: place sorted even-indexed elements back into the new list\n    even_idx_counter = 0\n    for i in range(len(l)):\n        if i % 2 == 0:  # Even index\n            new_list[i] = even_elements[even_idx_counter]\n            even_idx_counter += 1\n\n    return new_list\n```"}
{"task_id": "HumanEval/38", "solution": "```python\ndef decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    # The original encoding moved the first character to the end: group[1:] + group[0]\n    # To reverse, the last character moves to the beginning: group[-1] + group[0] + group[1]\n    groups = [(group[-1] + group[0] + group[1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)\n```"}
{"task_id": "HumanEval/39", "solution": "import math\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n    def _is_prime(num: int) -> bool:\n        \"\"\"Checks if a given integer is a prime number.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    def _is_fibonacci(num: int) -> bool:\n        \"\"\"Checks if a given integer is a Fibonacci number using the mathematical property.\"\"\"\n        # A number N is a Fibonacci number if and only if (5*N*N + 4) or (5*N*N - 4) is a perfect square.\n        val1 = 5 * num * num + 4\n        val2 = 5 * num * num - 4\n\n        def is_perfect_square(x: int) -> bool:\n            s = int(x**0.5)\n            return s * s == x\n\n        return is_perfect_square(val1) or is_perfect_square(val2)\n\n    found_count = 0\n    num_to_check = 1\n\n    while True:\n        num_to_check += 1\n        if _is_fibonacci(num_to_check):\n            if _is_prime(num_to_check):\n                found_count += 1\n                if found_count == n:\n                    return num_to_check"}
{"task_id": "HumanEval/40", "solution": "```python\ndef triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n    return False\n```"}
