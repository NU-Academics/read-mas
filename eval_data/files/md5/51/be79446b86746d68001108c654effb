{"task_id": "HumanEval/54", "solution": "class CharacterSet:\n    \"\"\"Manages a unique collection of characters and provides comparison logic.\"\"\"\n    def __init__(self, input_string: str):\n        \"\"\"Initializes a CharacterSet object by extracting unique characters from input_string.\"\"\"\n        self.characters = set(input_string)\n\n    def is_identical_to(self, other: 'CharacterSet') -> bool:\n        \"\"\"Compares this CharacterSet with another CharacterSet for identity.\"\"\"\n        return self.characters == other.characters\n\ndef same_chars(s0: str, s1: str) -> bool:\n    \"\"\"\n    Check if two words have the same characters.\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')\n    True\n    >>> same_chars('abcd', 'dddddddabc')\n    True\n    >>> same_chars('dddddddabc', 'abcd')\n    True\n    >>> same_chars('eabcd', 'dddddddabc')\n    False\n    >>> same_chars('abcd', 'dddddddabce')\n    False\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddddabc')\n    False\n    \"\"\"\n    char_set_s0 = CharacterSet(s0)\n    char_set_s1 = CharacterSet(s1)\n    return char_set_s0.is_identical_to(char_set_s1)"}
{"task_id": "HumanEval/55", "solution": "```python\ndef fib(n: int):\n    \"\"\"Return n-th Fibonacci number using an iterative approach.\n    It follows the definition F(0)=0, F(1)=1, and F(n) = F(n-1) + F(n-2) for n > 1.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        a, b = 0, 1\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b\n```"}
{"task_id": "HumanEval/56", "solution": "```python\nclass BracketCount:\n    \"\"\"Manages and queries the balance of opening and closing brackets.\"\"\"\n    def __init__(self):\n        self._count = 0\n\n    def increment(self):\n        \"\"\"Increments the internal bracket count.\"\"\"\n        self._count += 1\n\n    def decrement(self):\n        \"\"\"Decrements the internal bracket count.\"\"\"\n        self._count -= 1\n\n    def is_negative(self) -> bool:\n        \"\"\"Returns True if the internal count is less than 0.\"\"\"\n        return self._count < 0\n\n    def is_zero(self) -> bool:\n        \"\"\"Returns True if the internal count is equal to 0.\"\"\"\n        return self._count == 0\n\ndef correct_bracketing(brackets: str) -> bool:\n    \"\"\"\n    Checks if every opening bracket has a corresponding closing bracket.\n    It uses a counter to track the balance of brackets.\n    \"\"\"\n    counter = BracketCount()\n    for char in brackets:\n        if char == '<':\n            counter.increment()\n        elif char == '>':\n            counter.decrement()\n\n        if counter.is_negative():\n            return False\n\n    return counter.is_zero()\n```"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    # Check for monotonically increasing\n    increasing = True\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            increasing = False\n            break\n\n    # Check for monotonically decreasing\n    decreasing = True\n    for i in range(len(l) - 1):\n        if l[i] < l[i+1]:\n            decreasing = False\n            break\n\n    return increasing or decreasing```"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n\n    \"\"\"\n    set_l1 = set(l1)\n    set_l2 = set(l2)\n    common_elements_set = set_l1.intersection(set_l2)\n    result_list = list(common_elements_set)\n    result_list.sort()\n    return result_list"}
