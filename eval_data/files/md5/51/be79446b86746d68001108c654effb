{"task_id": "HumanEval/8", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    # The loop correctly handles an empty list by not executing and returning initial values.\n    for num in numbers:\n        current_sum += num\n        current_product *= num\n\n    return (current_sum, current_product)\n```"}
{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n\n    def _calculate_deepest_nesting(group_string: str) -> int:\n        \"\"\"Calculates the deepest level of nesting for a single group of parentheses.\"\"\"\n        current_level = 0\n        max_level = 0\n        for char in group_string:\n            if char == '(':\n                current_level += 1\n                max_level = max(max_level, current_level)\n            elif char == ')':\n                current_level -= 1\n        return max_level\n\n    groups = paren_string.split(' ')\n    results = []\n    for group in groups:\n        if group: # Handle potential empty strings if multiple spaces exist\n            results.append(_calculate_deepest_nesting(group))\n    return results\n```\n"}
{"task_id": "HumanEval/9", "solution": "```python\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_maximums = []\n    current_max = float('-inf')  # Initialize with negative infinity\n\n    for number in numbers:\n        current_max = max(current_max, number)\n        rolling_maximums.append(current_max)\n\n    return rolling_maximums\n```"}
{"task_id": "HumanEval/10", "solution": "```python\ndef is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\n\n\ndef _get_reverse(s: str) -> str:\n    \"\"\" Reverses a given string. \"\"\"\n    return s[::-1]\n\ndef _get_longest_palindromic_postfix(s: str) -> str:\n    \"\"\" Finds the longest postfix of the supplied string that is a palindrome. \"\"\"\n    for i in range(len(s)):\n        postfix = s[i:]\n        if is_palindrome(postfix):\n            return postfix\n    return \"\" # Should not be reached for non-empty string, as a single char is a palindrome. For empty string, handled by make_palindrome\n\ndef _get_prefix_before(s: str, postfix: str) -> str:\n    \"\"\" Extracts the prefix of a string that comes before a specified postfix. \"\"\"\n    return s[:len(s) - len(postfix)]\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    palindromic_postfix = _get_longest_palindromic_postfix(string)\n    prefix_before_postfix = _get_prefix_before(string, palindromic_postfix)\n    reversed_prefix = _get_reverse(prefix_before_postfix)\n\n    return string + reversed_prefix\n```"}
{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    distinct_chars = set()\n    for char in string.lower():\n        distinct_chars.add(char)\n    return len(distinct_chars)```"}
{"task_id": "HumanEval/11", "solution": "```python\nclass BinaryString:\n    \"\"\"Encapsulates a binary string, validates its format, and provides methods\n    for length comparison and bit-wise XOR operations.\n    \"\"\"\n    def __init__(self, value: str):\n        if not isinstance(value, str):\n            raise TypeError(\"BinaryString value must be a string.\")\n        if not self._is_valid_format(value):\n            raise ValueError(\"Invalid binary string format. Must contain only '0's and '1's.\")\n        self._value = value\n\n    def _is_valid_format(self, s: str) -> bool:\n        \"\"\"Checks if the string consists only of '0's and '1's.\"\"\"\n        return all(char in ('0', '1') for char in s)\n\n    def get_value(self) -> str:\n        \"\"\"Returns the encapsulated binary string value.\"\"\"\n        return self._value\n\n    def get_length(self) -> int:\n        \"\"\"Returns the length of the binary string.\"\"\"\n        return len(self._value)\n\n    def is_equal_length(self, other: 'BinaryString') -> bool:\n        \"\"\"Checks if this string has the same length as another BinaryString.\"\"\"\n        return self.get_length() == other.get_length()\n\n    def perform_xor(self, other: 'BinaryString') -> 'BinaryString':\n        \"\"\"Performs bit-wise XOR with another BinaryString.\n        Raises ValueError if lengths are not equal.\n        \"\"\"\n        if not self.is_equal_length(other):\n            raise ValueError(\"Input strings must be of equal length for XOR operation.\")\n\n        result_chars = []\n        for i in range(self.get_length()):\n            bit_a = int(self._value[i])\n            bit_b = int(other._value[i])\n            xor_result = '1' if bit_a != bit_b else '0'\n            result_chars.append(xor_result)\n        return BinaryString(\"\".join(result_chars))\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    binary_a = BinaryString(a)\n    binary_b = BinaryString(b)\n\n    if not binary_a.is_equal_length(binary_b):\n        raise ValueError(\"Input strings 'a' and 'b' must be of equal length.\")\n\n    result_binary_string = binary_a.perform_xor(binary_b)\n\n    return result_binary_string.get_value()\n```"}
