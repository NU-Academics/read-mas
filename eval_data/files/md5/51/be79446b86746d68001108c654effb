{"task_id": "HumanEval/122", "solution": "```python\ndef _is_two_digit(num: int) -> bool:\n    \"\"\"Checks if an integer has at most two digits (absolute value less than 100).\"\"\"\n    return abs(num) < 100\n\ndef add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    total_sum = 0\n    # Iterate through the first k elements of the array.\n    for i in range(k):\n        element = arr[i]\n        # Add the element to the sum if it has at most two digits.\n        if _is_two_digit(element):\n            total_sum += element\n    return total_sum\n```"}
{"task_id": "HumanEval/123", "solution": "```python\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception raised for invalid input values.\"\"\"\n        pass\n\n    def _validate_input(val):\n        \"\"\"Validates if the input is a positive integer.\"\"\"\n        if not isinstance(val, int) or val <= 0:\n            raise InvalidInputError(\"n must be a positive integer.\")\n\n    def _is_odd(number):\n        \"\"\"Checks if a number is odd.\"\"\"\n        return number % 2 != 0\n\n    def _generate_collatz_sequence(start_n):\n        \"\"\"Generates the Collatz sequence for a given start_n.\"\"\"\n        sequence = []\n        current = start_n\n        while current != 1:\n            sequence.append(current)\n            if _is_odd(current):\n                current = 3 * current + 1\n            else:\n                current = current // 2\n        sequence.append(1)\n        return sequence\n\n    _validate_input(n)\n\n    if n == 1:\n        return [1]\n\n    collatz_sequence = _generate_collatz_sequence(n)\n\n    odd_numbers = []\n    for num in collatz_sequence:\n        if _is_odd(num):\n            odd_numbers.append(num)\n\n    odd_numbers.sort()\n    return odd_numbers\n```"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n\n    for example:\n    valid_date('03-11-2000') => True\n\n    valid_date('15-01-2012') => False\n\n    valid_date('04-0-2040') => False\n\n    valid_date('06-04-2020') => True\n\n    valid_date('06/04/2020') => False\n    \"\"\"\n    import re\n\n    if not date:\n        return False\n\n    match = re.fullmatch(r'(\\d{2})-(\\d{2})-(\\d{4})', date)\n    if not match:\n        return False\n\n    try:\n        month = int(match.group(1))\n        day = int(match.group(2))\n        # year = int(match.group(3)) # Year is parsed but not used for validation per SRS\n    except ValueError:\n        return False\n\n    if not (1 <= month <= 12):\n        return False\n\n    if month in {1, 3, 5, 7, 8, 10, 12}:\n        if not (1 <= day <= 31):\n            return False\n    elif month in {4, 6, 9, 11}:\n        if not (1 <= day <= 30):\n            return False\n    elif month == 2:\n        if not (1 <= day <= 29):\n            return False\n    else:\n        return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "```python\ndef split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',', if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3\n    '''\n    if any(c.isspace() for c in txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                # Calculate 0-indexed ordinal value and check if it's odd.\n                ordinal_value = ord(char) - ord('a')\n                if ordinal_value % 2 != 0:\n                    count += 1\n        return count\n```"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n\n    Examples\n    is_sorted([5]) \u279e True\n    is_sorted([1, 2, 3, 4, 5]) \u279e True\n    is_sorted([1, 3, 2, 4, 5]) \u279e False\n    is_sorted([1, 2, 3, 4, 5, 6]) \u279e True\n    is_sorted([1, 2, 3, 4, 5, 6, 7]) \u279e True\n    is_sorted([1, 3, 2, 4, 5, 6, 7]) \u279e False\n    is_sorted([1, 2, 2, 3, 3, 4]) \u279e True\n    is_sorted([1, 2, 2, 2, 3, 4]) \u279e False\n    '''\n    class NumberList:\n        \"\"\"Encapsulates the list of numbers and provides the internal logic for performing sorting and duplicate count validations.\"\"\"\n        def __init__(self, numbers):\n            \"\"\"Initializes the NumberList with the given list of numbers.\"\"\"\n            self._numbers = numbers\n\n        def check_sorted_and_duplicates(self):\n            \"\"\"\n            Performs both the ascending order check and the duplicate count check.\n            Returns True if both conditions pass, False otherwise.\n            \"\"\"\n            if not self._is_ascending_sorted():\n                return False\n            if not self._has_valid_duplicates():\n                return False\n            return True\n\n        def _is_ascending_sorted(self):\n            \"\"\"Checks if the encapsulated list is sorted in ascending order.\"\"\"\n            for i in range(1, len(self._numbers)):\n                if self._numbers[i] < self._numbers[i-1]:\n                    return False\n            return True\n\n        def _has_valid_duplicates(self):\n            \"\"\"Checks if no number in the encapsulated list appears more than twice.\"\"\"\n            counts = {}\n            for num in self._numbers:\n                counts[num] = counts.get(num, 0) + 1\n                if counts[num] > 2:\n                    return False\n            return True\n\n    number_list_obj = NumberList(lst)\n    return number_list_obj.check_sorted_and_duplicates()"}
{"task_id": "HumanEval/128", "solution": "```python\ndef prod_signs(arr):\n    \"\"\"\n    Returns sum of magnitudes of integers multiplied by product of all signs.\n    Returns None for an empty array.\n    \"\"\"\n    def _get_sign(number):\n        \"\"\"Returns 1 for positive, -1 for negative, and 0 for zero.\"\"\"\n        if number > 0:\n            return 1\n        elif number < 0:\n            return -1\n        else:\n            return 0\n\n    def _get_magnitude(number):\n        \"\"\"Returns the absolute value of a number.\"\"\"\n        return abs(number)\n\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for number in arr:\n        product_of_signs *= _get_sign(number)\n        sum_of_magnitudes += _get_magnitude(number)\n\n    return sum_of_magnitudes * product_of_signs\n```"}
{"task_id": "HumanEval/131", "solution": "```python\ndef digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    product = 1\n    odd_digit_found = False\n    for char_digit in str(n):\n        digit = int(char_digit)\n        if digit % 2 != 0:\n            product *= digit\n            odd_digit_found = True\n\n    if not odd_digit_found:\n        return 0\n    return product\n```"}
{"task_id": "HumanEval/129", "solution": "```python\nclass Cell:\n    \"\"\"Represents a single cell in the grid with its value and coordinates.\"\"\"\n    def __init__(self, value: int, row: int, col: int):\n        self.value = value\n        self.row = row\n        self.col = col\n\n    def __eq__(self, other) -> bool:\n        \"\"\"Compares two cells for equality based on row and col.\"\"\"\n        if not isinstance(other, Cell):\n            return NotImplemented\n        return self.row == other.row and self.col == other.col\n\n    def __hash__(self) -> int:\n        \"\"\"Provides a hash for the cell, enabling use in sets/dicts.\"\"\"\n        return hash((self.row, self.col))\n\nclass Grid:\n    \"\"\"Manages the grid data, provides access to cell values and neighbor information.\"\"\"\n    def __init__(self, grid_data: list[list[int]]):\n        self._grid_data = grid_data\n        self.N = len(grid_data)\n\n    def get_cell_value(self, row: int, col: int) -> int:\n        \"\"\"Returns the value at specified coordinates.\"\"\"\n        return self._grid_data[row][col]\n\n    def is_valid_coord(self, row: int, col: int) -> bool:\n        \"\"\"Checks if coordinates are within grid boundaries.\"\"\"\n        return 0 <= row < self.N and 0 <= col < self.N\n\n    def get_neighbors(self, row: int, col: int) -> list[tuple[int, int]]:\n        \"\"\"Returns a list of valid neighbor coordinates (row, col).\"\"\"\n        neighbors = []\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n        for dr, dc in directions:\n            nr, nc = row + dr, col + dc\n            if self.is_valid_coord(nr, nc):\n                neighbors.append((nr, nc))\n        return neighbors\n\nclass Path:\n    \"\"\"Represents a path taken, stores its sequence of cell values, and supports lexicographical comparison.\"\"\"\n    def __init__(self, initial_values: list[int]):\n        self.values = list(initial_values) # Store a copy of the list\n\n    def add_value(self, value: int):\n        \"\"\"Appends a new cell value to the path.\"\"\"\n        self.values.append(value)\n\n    def get_length(self) -> int:\n        \"\"\"Returns the current length of the path.\"\"\"\n        return len(self.values)\n\n    def __lt__(self, other: 'Path') -> bool:\n        \"\"\"Implements lexicographical comparison for paths.\"\"\"\n        return self.values < other.values\n\n    def __eq__(self, other: 'Path') -> bool:\n        \"\"\"Implements equality comparison for paths.\"\"\"\n        return self.values == other.values\n\ndef _dfs_search(grid_obj: Grid, current_row: int, current_col: int, current_path_values: list[int], k: int, min_path_found_wrapper: list['Path']) -> None:\n    \"\"\"\n    Recursively explores paths of length k using Depth-First Search,\n    updating the minimum path found so far.\n    \"\"\"\n    # Base case: path length k reached\n    if len(current_path_values) == k:\n        current_path_obj = Path(current_path_values) # Create a Path object for comparison\n        # Compare current path with the best path found so far\n        if current_path_obj < min_path_found_wrapper[0]:\n            min_path_found_wrapper[0] = current_path_obj # Update the wrapper with the new minimum path\n        return\n\n    # Recursive step: path length < k\n    neighbors = grid_obj.get_neighbors(current_row, current_col)\n    for nr, nc in neighbors:\n        neighbor_value = grid_obj.get_cell_value(nr, nc)\n        # Recurse by creating a new path list for each branch, avoiding explicit backtracking\n        _dfs_search(grid_obj, nr, nc, current_path_values + [neighbor_value], k, min_path_found_wrapper)\n\ndef minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k,\n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n    N = len(grid)\n    grid_obj = Grid(grid)\n\n    # Initialize min_path_found_wrapper with a sentinel Path object.\n    # The initial path uses values larger than any possible grid value (1 to N*N).\n    max_grid_val = N * N\n    sentinel_path_values = [max_grid_val + 1] * k\n    min_path_found_wrapper = [Path(sentinel_path_values)] # Use a list to pass by reference\n\n    # Iterate through all possible starting cells in the grid\n    for r in range(N):\n        for c in range(N):\n            start_value = grid_obj.get_cell_value(r, c)\n            # Start DFS from this cell, passing the initial path containing only the start value\n            _dfs_search(grid_obj, r, c, [start_value], k, min_path_found_wrapper)\n\n    return min_path_found_wrapper[0].values\n```"}
{"task_id": "HumanEval/133", "solution": "```python\nimport math\n\nclass Number:\n    \"\"\"Encapsulates a numerical value and its transformations (rounding up and squaring).\"\"\"\n    def __init__(self, value: float):\n        self._original_value: float = value\n        self._rounded_up_value: int = int(math.ceil(value))\n        self._squared_value: int = self._rounded_up_value ** 2\n\n    def get_squared_value(self) -> int:\n        \"\"\"Returns the final squared integer value.\"\"\"\n        return self._squared_value\n\ndef sum_squares(lst: list[float]) -> int:\n    \"\"\"Returns the sum of squared numbers in the given list, after rounding each element up to the nearest integer.\"\"\"\n    total_sum = 0\n    for num_val in lst:\n        number_obj = Number(num_val)\n        total_sum += number_obj.get_squared_value()\n    return total_sum\n```"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in\n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8\n    You are given a non-negative integer number n, you have to a return a list of the\n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    from typing import Dict, List, Union\n\n    class TribonacciCalculator:\n        \"\"\"Manages the calculation and memoization of Tribonacci sequence terms.\"\"\"\n        def __init__(self):\n            self._memo: Dict[int, Union[int, float]] = {}\n\n        def calculate_sequence(self, n: int) -> List[Union[int, float]]:\n            \"\"\"Calculates the Tribonacci sequence up to n, including tri(0).\"\"\"\n            # n is guaranteed to be a non-negative integer per problem statement.\n            result = []\n            for k in range(n + 1):\n                result.append(self._get_term(k))\n            return result\n\n        def _get_term(self, k: int) -> Union[int, float]:\n            \"\"\"Retrieves or calculates a single Tribonacci term, using memoization.\"\"\"\n            if k in self._memo:\n                return self._memo[k]\n\n            value = self._calculate_term_value(k)\n            self._memo[k] = value\n            return value\n\n        def _calculate_term_value(self, k: int) -> Union[int, float]:\n            \"\"\"Applies the Tribonacci rules to compute a term's value.\"\"\"\n            if k == 0:\n                return 1\n            elif k == 1:\n                return 3\n            elif k % 2 == 0:  # k is even and k >= 2 (since 0 and 1 handled)\n                return 1 + k // 2  # Use integer division to match example integer output\n            else:  # k is odd and k >= 3 (since 0 and 1 handled)\n                term_k_minus_1 = self._get_term(k - 1)\n                term_k_minus_2 = self._get_term(k - 2)\n                term_k_plus_1 = self._get_term(k + 1)\n                return term_k_minus_1 + term_k_minus_2 + term_k_plus_1\n\n    calculator = TribonacciCalculator()\n    return calculator.calculate_sequence(n)"}
{"task_id": "HumanEval/134", "solution": "```python\ndef check_if_last_char_is_a_letter(txt):\n    '''\n    Returns True if the last character is an alphabetical character and is immediately preceded by a space.\n    Otherwise, returns False.\n    '''\n    if len(txt) == 0:\n        return False\n    if len(txt) < 2:\n        return False\n\n    last_char = txt[-1]\n    second_last_char = txt[-2]\n\n    if not last_char.isalpha():\n        return False\n\n    if second_last_char != ' ':\n        return False\n\n    return True\n```"}
{"task_id": "HumanEval/135", "solution": "```python\ndef can_arrange(arr):\n    \"\"\"\n    Finds the largest index where an element is strictly less than its preceding element.\n    Returns -1 if no such element exists, indicating the array is sorted non-decreasingly.\n    \"\"\"\n    largest_disorder_index = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            largest_disorder_index = i\n    return largest_disorder_index\n```"}
{"task_id": "HumanEval/136", "solution": "```python\ndef largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    '''\n    largest_negative = None\n    smallest_positive = None\n\n    for num in lst:\n        if num < 0:\n            if largest_negative is None or num > largest_negative:\n                largest_negative = num\n        elif num > 0:\n            if smallest_positive is None or num < smallest_positive:\n                smallest_positive = num\n\n    return (largest_negative, smallest_positive)\n```\n"}
{"task_id": "HumanEval/132", "solution": "```python\ndef is_nested(string):\n    '''\n    Checks if a string of square brackets contains a subsequence of '[[ ]]'.\n    Returns True if such a nested subsequence exists, False otherwise.\n    '''\n    found_first_open = False\n    found_second_open = False\n    found_first_close_after_second_open = False\n\n    for char in string:\n        if char == '[':\n            if found_second_open:\n                pass  # Already found two opening brackets, no need for more state changes for '['\n            elif found_first_open:\n                found_second_open = True\n            else:\n                found_first_open = True\n        elif char == ']':\n            if found_second_open:\n                if found_first_close_after_second_open:\n                    return True  # Found '[[ ]' and now a second ']', completing '[[ ]]'\n                else:\n                    found_first_close_after_second_open = True\n            else:\n                pass  # Closing bracket before finding two opening brackets, ignore\n\n    return False\n```"}
{"task_id": "HumanEval/137", "solution": "```python\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n    \"\"\"\n    def _parse_to_float(value):\n        \"\"\"Converts an input value (int, float, or string) into a float, handling different decimal separators for strings.\"\"\"\n        if isinstance(value, (int, float)):\n            return float(value)\n        elif isinstance(value, str):\n            return float(value.replace(',', '.'))\n        return None # This case should not be reached based on problem description\n\n    a_parsed = _parse_to_float(a)\n    b_parsed = _parse_to_float(b)\n\n    if a_parsed > b_parsed:\n        return a\n    elif b_parsed > a_parsed:\n        return b\n    else:\n        return None\n```"}
{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n    \"\"\"\n    # Replace three or more consecutive space characters with a single hyphen.\n    processed_text = re.sub(r' {3,}', '-', text)\n\n    # Replace two consecutive space characters with two underscore characters.\n    processed_text = re.sub(r' {2}', '__', processed_text)\n\n    # Replace single space characters with a single underscore character.\n    processed_text = re.sub(r' ', '_', processed_text)\n\n    return processed_text```"}
{"task_id": "HumanEval/141", "solution": "```python\nimport re\n\nclass FileName:\n    \"\"\"Encapsulates file name data and validation logic.\"\"\"\n\n    ALLOWED_SUFFIXES = ['txt', 'exe', 'dll']\n\n    def __init__(self, name: str):\n        self.name = name\n        self._digit_count = -1  # -1 indicates not yet calculated\n        self._dot_count = -1\n        self._prefix = None\n        self._suffix = None\n\n    def countDigits(self) -> int:\n        \"\"\"Counts the occurrences of digits ('0'-'9') in the file name.\"\"\"\n        if self._digit_count == -1:\n            self._digit_count = sum(1 for char in self.name if char.isdigit())\n        return self._digit_count\n\n    def countDots(self) -> int:\n        \"\"\"Counts the occurrences of the dot character ('.') in the file name.\"\"\"\n        if self._dot_count == -1:\n            self._dot_count = self.name.count('.')\n        return self._dot_count\n\n    def getPrefix(self) -> str:\n        \"\"\"Identifies and returns the substring before the first dot.\"\"\"\n        if self._prefix is None:\n            dot_index = self.name.find('.')\n            if dot_index != -1:\n                self._prefix = self.name[:dot_index]\n            else:\n                self._prefix = self.name # No dot, whole name is prefix\n        return self._prefix\n\n    def getSuffix(self) -> str:\n        \"\"\"Identifies and returns the substring after the first dot.\"\"\"\n        if self._suffix is None:\n            dot_index = self.name.find('.')\n            if dot_index != -1:\n                self._suffix = self.name[dot_index + 1:]\n            else:\n                self._suffix = \"\" # No dot, no suffix\n        return self._suffix\n\n    def isValid(self) -> str:\n        \"\"\"Orchestrates all validation rules and returns 'Yes' if valid, 'No' otherwise.\"\"\"\n        # Check digit count\n        if self.countDigits() > 3:\n            return 'No'\n\n        # Check dot count\n        if self.countDots() != 1:\n            return 'No'\n\n        # Check for non-empty prefix\n        prefix = self.getPrefix()\n        if not prefix:\n            return 'No'\n\n        # Check prefix starting character\n        if not prefix[0].isalpha():\n            return 'No'\n\n        # Check suffix validity\n        suffix = self.getSuffix()\n        if suffix not in self.ALLOWED_SUFFIXES:\n            return 'No'\n\n        return 'Yes'\n\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions\n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from\n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    validator = FileName(file_name)\n    return validator.isValid()\n```"}
{"task_id": "HumanEval/138", "solution": "```python\ndef is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\"\"\"\n    # The minimum possible sum of 4 positive even numbers is 2 + 2 + 2 + 2 = 8.\n    if n < 8:\n        return False\n    # The sum of four even numbers must always be an even number.\n    if n % 2 != 0:\n        return False\n    # If n is even and >= 8, it can always be expressed as 2+2+2+(n-6), where (n-6) is a positive even number.\n    return True\n```"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\n    Calculates the sum of a list of integers after applying index-based transformations.\n    Squares an entry if its index is a multiple of 3, cubes it if its index is a multiple of 4 and not a multiple of 3, otherwise keeps it unchanged.\n    \"\"\"\n    if not lst:\n        return 0\n\n    modified_sum = 0\n    for index, value in enumerate(lst):\n        if index % 3 == 0:\n            modified_sum += value * value\n        elif index % 4 == 0:  # This implies index % 3 != 0 due to the 'elif'\n            modified_sum += value * value * value\n        else:\n            modified_sum += value\n\n    return modified_sum\n```"}
{"task_id": "HumanEval/139", "solution": "```python\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    def _calculate_factorial(k):\n        \"\"\"Helper function to calculate the standard factorial of k.\"\"\"\n        if k == 0:\n            return 1\n        result = 1\n        for i in range(1, k + 1):\n            result *= i\n        return result\n\n    brazilian_factorial_product = 1\n    for i in range(1, n + 1):\n        current_factorial = _calculate_factorial(i)\n        brazilian_factorial_product *= current_factorial\n\n    return brazilian_factorial_product\n```"}
{"task_id": "HumanEval/143", "solution": "```python\ndef words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, keeping only those with prime lengths.\n    Helper functions for primality test and sentence splitting are defined internally.\n    \"\"\"\n\n    def _is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split()\n    filtered_words = []\n    for word in words:\n        if _is_prime(len(word)):\n            filtered_words.append(word)\n\n    return \" \".join(filtered_words)\n```"}
{"task_id": "HumanEval/144", "solution": "```python\ndef _gcd(a, b):\n    \"\"\"Calculates the greatest common divisor of two integers using the Euclidean algorithm.\"\"\"\n    while b:\n        a, b = b, a % b\n    return a\n\nclass Fraction:\n    \"\"\"Represents a mathematical fraction with a numerator and a denominator.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    @staticmethod\n    def parse(fraction_string: str) -> 'Fraction':\n        \"\"\"Parses a string fraction into a Fraction object.\"\"\"\n        num_str, den_str = fraction_string.split('/')\n        return Fraction(int(num_str), int(den_str))\n\n    def multiply(self, other_fraction: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another fraction, returning a new Fraction object.\"\"\"\n        new_numerator = self.numerator * other_fraction.numerator\n        new_denominator = self.denominator * other_fraction.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Determines if the fraction represents a whole number after simplification.\"\"\"\n        common_divisor = _gcd(self.numerator, self.denominator)\n        simplified_denominator = self.denominator // common_divisor\n\n        return simplified_denominator == 1\n\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    fraction_x = Fraction.parse(x)\n    fraction_n = Fraction.parse(n)\n\n    product_fraction = fraction_x.multiply(fraction_n)\n\n    return product_fraction.is_whole_number()\n```"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits,\n    then by their original index for ties.\n    \"\"\"\n\n    if not nums:\n        return []\n\n    def _calculate_digit_sum(num: int) -> int:\n        \"\"\"Calculates the sum of the absolute values of an integer's digits.\"\"\"\n        s = 0\n        num = abs(num)\n        if num == 0:\n            return 0\n        while num > 0:\n            s += num % 10\n            num //= 10\n        return s\n\n    class Integer:\n        \"\"\"Encapsulates an integer's value, original position, and calculated digit sum.\"\"\"\n        def __init__(self, value: int, original_index: int):\n            self.value = value\n            self.original_index = original_index\n            self.calculated_digit_sum = _calculate_digit_sum(value)\n\n    class IntegerList:\n        \"\"\"Manages a collection of Integer objects and provides sorting capabilities.\"\"\"\n        def __init__(self, nums_list: list[int]):\n            self.integers = [Integer(num, i) for i, num in enumerate(nums_list)]\n\n        def sortIntegersByDigitSum(self):\n            \"\"\"Sorts the internal list of Integers by digit sum then original index.\"\"\"\n            self.integers.sort(key=lambda x: (x.calculated_digit_sum, x.original_index))\n\n        def getSortedList(self) -> list[int]:\n            \"\"\"Returns a new list containing only the values of the sorted Integer objects.\"\"\"\n            return [i_obj.value for i_obj in self.integers]\n\n    integer_list_obj = IntegerList(nums)\n    integer_list_obj.sortIntegersByDigitSum()\n    return integer_list_obj.getSortedList()"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    '''\n    total_sum = 0\n    for number in lst:\n        # Check if the number is an integer, non-negative, and odd\n        if isinstance(number, int) and number >= 0 and number % 2 != 0:\n            total_sum += number * number\n    return total_sum"}
{"task_id": "HumanEval/148", "solution": "```python\nPLANETS_LIST = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\nPLANET_TO_ORDER_MAP = {planet: i for i, planet in enumerate(PLANETS_LIST)}\n\ndef bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets located between planet1 and planet2, sorted by proximity to the Sun.\n    Returns an empty tuple if planet names are invalid or no planets are found between them.\n    \"\"\"\n    if planet1 not in PLANET_TO_ORDER_MAP or planet2 not in PLANET_TO_ORDER_MAP:\n        return ()\n\n    idx1 = PLANET_TO_ORDER_MAP[planet1]\n    idx2 = PLANET_TO_ORDER_MAP[planet2]\n\n    if idx1 == idx2:\n        return ()\n\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    # Planets strictly between the two\n    result = PLANETS_LIST[start_idx + 1:end_idx]\n\n    return tuple(result)\n```\n"}
{"task_id": "HumanEval/149", "solution": "```python\ndef sorted_list_sum(lst):\n    \"\"\"Filters a list of strings, keeping only those with even lengths.\n    The remaining strings are sorted by length (ascending), then alphabetically.\n    \"\"\"\n    # Filter out strings with odd lengths.\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort primarily by length (ascending), then alphabetically (ascending).\n    processed_list = sorted(even_length_strings, key=lambda s: (len(s), s))\n\n    return processed_list\n```"}
{"task_id": "HumanEval/146", "solution": "```python\ndef _is_odd(digit):\n    \"\"\"Checks if a given digit is odd (1, 3, 5, 7, 9).\"\"\"\n    return digit in {1, 3, 5, 7, 9}\n\ndef _get_first_digit(num):\n    \"\"\"Extracts the first digit of a number using its absolute value.\"\"\"\n    return int(str(abs(num))[0])\n\ndef _get_last_digit(num):\n    \"\"\"Extracts the last digit of a number using its absolute value.\"\"\"\n    return int(str(abs(num))[-1])\n\ndef _is_special_number(num):\n    \"\"\"Checks if a number is greater than 10, and both its first and last digits are odd.\"\"\"\n    if num > 10:\n        first_digit = _get_first_digit(num)\n        last_digit = _get_last_digit(num)\n        return _is_odd(first_digit) and _is_odd(last_digit)\n    return False\n\ndef specialFilter(nums):\n    \"\"\"\n    Write a function that takes an array of numbers as input and returns\n    the number of elements in the array that are greater than 10 and both\n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    For example:\n    specialFilter([15, -73, 14, -15]) => 1\n    specialFilter([33, -2, -3, 45, 21, 109]) => 2\n    \"\"\"\n    count = 0\n    for num in nums:\n        if _is_special_number(num):\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on the difference between uppercase and lowercase letters.\n    Returns the class name concatenated with the strongest extension name.\n    \"\"\"\n    strongest_extension_name = \"\"\n    max_strength = -float('inf') # Initialize with a very small number to ensure the first extension is chosen\n\n    for extension in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in extension:\n            if char.isupper():\n                cap_count += 1\n            elif char.islower():\n                sm_count += 1\n\n        current_strength = cap_count - sm_count\n\n        # If current_strength is greater, update. If equal, the first one is already kept due to comparison order.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/147", "solution": "```python\ndef get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from array a where i < j < k and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n\n    def _calculate_element_value(idx_1_based: int) -> int:\n        \"\"\"Calculates a[i] = i * i - i + 1 for a 1-based index i.\"\"\"\n        return idx_1_based * idx_1_based - idx_1_based + 1\n\n    def _is_sum_multiple_of_three(val1: int, val2: int, val3: int) -> bool:\n        \"\"\"Checks if the sum of three integers is a multiple of 3.\"\"\"\n        return (val1 + val2 + val3) % 3 == 0\n\n    a_values = []\n    for i in range(1, n + 1):\n        a_values.append(_calculate_element_value(i))\n\n    count = 0\n    for i_idx in range(n - 2):\n        for j_idx in range(i_idx + 1, n - 1):\n            for k_idx in range(j_idx + 1, n):\n                val_i = a_values[i_idx]\n                val_j = a_values[j_idx]\n                val_k = a_values[k_idx]\n\n                if _is_sum_multiple_of_three(val_i, val_j, val_k):\n                    count += 1\n\n    return count\n```"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n    \"\"\"\n    def is_prime(num):\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/152", "solution": "```python\ndef compare(game,guess):\n    \"\"\"I think we all remember that feeling when the result of some long-awaited\n    event is finally known. The feelings and thoughts you have at that moment are\n    definitely worth noting down and comparing.\n    Your task is to determine if a person correctly guessed the results of a number of matches.\n    You are given two arrays of scores and guesses of equal length, where each index shows a match.\n    Return an array of the same length denoting how far off each guess was. If they have guessed correctly,\n    the value is 0, and if not, the value is the absolute difference between the guess and the score.\n\n\n    example:\n\n    compare([1,2,3,4,5,1],[1,2,3,4,2,-2]) -> [0,0,0,0,3,3]\n    compare([0,5,0,0,0,4],[4,1,1,0,0,-2]) -> [4,4,1,0,0,6]\n    \"\"\"\n    if len(game) != len(guess):\\\n        raise ValueError(\"Input arrays must be of equal length\")\n\n    differences = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            differences.append(0)\n        else:\n            differences.append(abs(game[i] - guess[i]))\n\n    return differences\n```\n"}
{"task_id": "HumanEval/155", "solution": "```python\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    abs_num = abs(num)\n    even_count = 0\n    odd_count = 0\n\n    # Handle the special case where the number is 0.\n    if abs_num == 0:\n        even_count = 1\n    else:\n        # Iterate through digits by converting the number to a string.\n        for digit_char in str(abs_num):\n            digit = int(digit_char)\n            if digit % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/154", "solution": "```python\ndef cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\"\"\"\n    if not b:\n        return True\n    if len(b) > len(a):\n        return False\n\n    for i in range(len(b)):\n        rotated_b = b[i:] + b[:i]\n        if rotated_b in a:\n            return True\n\n    return False\n```"}
{"task_id": "HumanEval/156", "solution": "```python\ndef _validate_number(number: int) -> None:\n    \"\"\"\n    Validates if the input number is within the allowed range [1, 1000].\n    Raises ValueError if the number is out of range.\n    \"\"\"\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Number out of range [1, 1000]\")\n\ndef _convert_to_roman_logic(number: int) -> str:\n    \"\"\"\n    Converts a valid integer to its uppercase Roman numeral string.\n    It uses a predefined map of values to Roman numerals.\n    \"\"\"\n    roman_map = {\n        1000: 'M', 900: 'CM', 500: 'D', 400: 'CD', 100: 'C', 90: 'XC',\n        50: 'L', 40: 'XL', 10: 'X', 9: 'IX', 5: 'V', 4: 'IV', 1: 'I'\n    }\n    result = []\n    for value, numeral in sorted(roman_map.items(), reverse=True):\n        while number >= value:\n            result.append(numeral)\n            number -= value\n    return ''.join(result)\n\ndef int_to_mini_roman(number: int) -> str:\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    _validate_number(number)\n    roman_upper = _convert_to_roman_logic(number)\n    return roman_upper.lower()\n```"}
{"task_id": "HumanEval/157", "solution": "```python\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n\n    # Use a small epsilon for floating-point comparisons to account for precision issues.\n    EPSILON = 1e-6\n\n    sides = sorted([a, b, c])\n\n    # The longest side (hypotenuse) will be the last element after sorting.\n    # The other two sides are the legs.\n    leg1_sq = sides[0]**2\n    leg2_sq = sides[1]**2\n    hypotenuse_sq = sides[2]**2\n\n    # Check if a^2 + b^2 = c^2 (Pythagorean theorem) with tolerance.\n    return abs(leg1_sq + leg2_sq - hypotenuse_sq) < EPSILON\n```"}
{"task_id": "HumanEval/158", "solution": "```python\ndef find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    class Word:\n        \"\"\"Represents a word with its value and unique character count.\"\"\"\n        def __init__(self, value: str):\n            self._value = value\n            self._unique_character_count = self._calculate_unique_characters()\n\n        def _calculate_unique_characters(self) -> int:\n            \"\"\"Calculates the number of unique characters in the word.\"\"\"\n            return len(set(self._value))\n\n        def get_value(self) -> str:\n            \"\"\"Returns the string value of the word.\"\"\"\n            return self._value\n\n        def get_unique_character_count(self) -> int:\n            \"\"\"Returns the unique character count of the word.\"\"\"\n            return self._unique_character_count\n\n        def __lt__(self, other: 'Word') -> bool:\n            \"\"\"Enables lexicographical comparison for sorting Word objects.\"\"\"\n            return self._value < other._value\n\n    if not words:\n        return \"\"\n\n    word_objects = [Word(word_str) for word_str in words]\n\n    max_unique_count = max(wo.get_unique_character_count() for wo in word_objects)\n\n    filtered_words = [wo for wo in word_objects if wo.get_unique_character_count() == max_unique_count]\n\n    filtered_words.sort()\n    return filtered_words[0].get_value()\n```"}
{"task_id": "HumanEval/159", "solution": "```python\ndef eat(number, need, remaining):\n    \"\"\"\n    Calculates the total number of eaten carrots and the number of carrots left\n    after a meal, considering the rabbit's hunger and available stock.\n    \"\"\"\n    if not (0 <= number <= 1000):\n        raise ValueError(\"Parameter 'number' must be an integer between 0 and 1000.\")\n    if not (0 <= need <= 1000):\n        raise ValueError(\"Parameter 'need' must be an integer between 0 and 1000.\")\n    if not (0 <= remaining <= 1000):\n        raise ValueError(\"Parameter 'remaining' must be an integer between 0 and 1000.\")\n\n    carrots_consumed_from_stock = min(need, remaining)\n    total_carrots_eaten = number + carrots_consumed_from_stock\n    carrots_left_in_stock = remaining - carrots_consumed_from_stock\n\n    return [total_carrots_eaten, carrots_left_in_stock]\n```"}
{"task_id": "HumanEval/160", "solution": "```python\ndef do_algebra(operator, operand):\n    \"\"\"\n    Constructs and evaluates an algebraic expression from a list of operators and operands.\n    This function handles input validation, expression string construction, and evaluation using Python's built-in `eval`.\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for signaling invalid input conditions.\"\"\"\n        pass\n\n    def _validate_inputs(operators_list, operands_list):\n        \"\"\"Validates the input lists based on specified constraints.\"\"\"\n        if not operators_list or not operands_list:\n            raise InvalidInputError(\"Operator and operand lists cannot be empty.\")\n        if len(operators_list) != len(operands_list) - 1:\n            raise InvalidInputError(\"Length of operator list must be one less than operand list.\")\n        if len(operators_list) < 1:\n            raise InvalidInputError(\"Operator list must have at least one operator.\")\n        if len(operands_list) < 2:\n            raise InvalidInputError(\"Operand list must have at least two operands.\")\n\n        allowed_operators = {'+', '-', '*', '//', '**'}\n        for op in operators_list:\n            if not isinstance(op, str) or op not in allowed_operators:\n                raise InvalidInputError(f\"Invalid operator found: {op}. Allowed operators are {list(allowed_operators)}\")\n\n        for num in operands_list:\n            if not isinstance(num, int) or num < 0:\n                raise InvalidInputError(f\"Invalid operand found: {num}. Operands must be non-negative integers.\")\n\n    def _construct_expression(operators_list, operands_list):\n        \"\"\"Builds the algebraic expression string by interleaving operands and operators.\"\"\"\n        expression = str(operands_list[0])\n        for i in range(len(operators_list)):\n            expression += f\" {operators_list[i]} {operands_list[i+1]}\"\n        return expression\n\n    def _evaluate_expression(expression_string):\n        \"\"\"Evaluates the given algebraic expression string, respecting standard operator precedence.\"\"\"\n        try:\n            return int(eval(expression_string))\n        except ZeroDivisionError:\n            raise ZeroDivisionError(\"Division by zero encountered during expression evaluation.\")\n        except Exception as e:\n            raise ValueError(f\"Error evaluating expression '{expression_string}': {e}\")\n\n    _validate_inputs(operator, operand)\n    expression_string = _construct_expression(operator, operand)\n    result = _evaluate_expression(expression_string)\n    return result\n```"}
{"task_id": "HumanEval/162", "solution": "```python\nimport hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n\n    md5_hash = hashlib.md5(text.encode('utf-8'))\n    return md5_hash.hexdigest()\n```"}
{"task_id": "HumanEval/161", "solution": "```python\ndef solve(s):\n    \"\"\"Reverses the case of letters or reverses the entire string if no letters are present.\"\"\"\n\n    def _has_alphabetic_chars(s_val):\n        \"\"\"Checks if a string contains any alphabetic characters.\"\"\"\n        for char in s_val:\n            if char.isalpha():\n                return True\n        return False\n\n    def _transform_case_char(char_val):\n        \"\"\"Transforms the case of a single alphabetic character or retains non-alphabetic characters.\"\"\"\n        if char_val.isalpha():\n            if char_val.islower():\n                return char_val.upper()\n            else:\n                return char_val.lower()\n        return char_val\n\n    def _reverse_string(s_val):\n        \"\"\"Reverses the entire input string.\"\"\"\n        return s_val[::-1]\n\n    if _has_alphabetic_chars(s):\n        transformed_chars = [_transform_case_char(char) for char in s]\n        return \"\".join(transformed_chars)\n    else:\n        return _reverse_string(s)\n```"}
{"task_id": "HumanEval/163", "solution": "```python\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    # Determine the minimum and maximum of the input integers a and b.\n    # Let these be lower_bound and upper_bound.\n    lower_bound = min(a, b)\n    upper_bound = max(a, b)\n\n    # Initialize an empty list called result.\n    result = []\n\n    # Iterate through the set of single even digits: 2, 4, 6, 8.\n    single_even_digits = [2, 4, 6, 8]\n    for digit in single_even_digits:\n        # For each digit, check if it is within the [lower_bound, upper_bound] range.\n        if lower_bound <= digit <= upper_bound:\n            # If the digit satisfies the condition, add it to the result list.\n            result.append(digit)\n\n    # Return the result list. It is naturally in ascending order.\n    return result\n```\n"}
{"task_id": "HumanEval/127", "solution": "```python\ndef intersection(interval1, interval2):\n    def _isPrime(num):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    # Calculate the intersection interval: [max(start1, start2), min(end1, end2)]\n    intersection_start = max(interval1[0], interval2[0])\n    intersection_end = min(interval1[1], interval2[1])\n\n    # If the calculated start is greater than the end, there is no intersection.\n    if intersection_start > intersection_end:\n        return \"NO\"\n\n    # Calculate the length of the intersection.\n    # The length is defined as (end - start) according to the problem example (2,3) length 1.\n    length = intersection_end - intersection_start\n\n    # Determine if the length is a prime number.\n    if _isPrime(length):\n        return \"YES\"\n    else:\n        return \"NO\"\n```"}
