{"task_id": "HumanEval/63", "solution": "_memo = {0: 0, 1: 0, 2: 1}\n\ndef fibfib(n: int):\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    \"\"\"\n    if n in _memo:\n        return _memo[n]\n\n    # Calculate FibFib numbers iteratively up to n\n    for i in range(len(_memo), n + 1):\n        _memo[i] = _memo[i-1] + _memo[i-2] + _memo[i-3]\n\n    return _memo[n]"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    s = str(x)\n    n = len(s)\n\n    if shift > n:\n        return s[::-1]\n    else:\n        # Perform circular right shift\n        # Take the last 'shift' digits and put them at the beginning\n        return s[n - shift:] + s[:n - shift]"}
{"task_id": "HumanEval/66", "solution": "```python\ndef digitSum(s):\n    \"\"\"Calculates the sum of ASCII codes of only the uppercase characters in the input string.\n    Returns 0 if the string is empty or contains no uppercase characters.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum\n```"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    \"\"\"\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than\n    zero, and has a frequency greater than or equal to the value of the integer itself.\n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    \"\"\"\n\n    class Integer:\n        \"\"\"A simple data class to hold an integer's value and its calculated frequency.\"\"\"\n        def __init__(self, value: int, frequency: int):\n            self.value = value\n            self.frequency = frequency\n\n    class IntegerList:\n        \"\"\"Encapsulates the input list, calculates frequencies, and finds the greatest matching integer.\"\"\"\n        def __init__(self, values: list[int]):\n            self._values = values\n            self._frequencies = self._calculate_frequencies()\n\n        def _calculate_frequencies(self) -> dict[int, int]:\n            \"\"\"Calculates the frequency of each integer in the list.\"\"\"\n            frequencies = {}\n            for x in self._values:\n                frequencies[x] = frequencies.get(x, 0) + 1\n            return frequencies\n\n        def get_frequencies(self) -> dict[int, int]:\n            \"\"\"Returns the calculated frequencies of integers in the list.\"\"\"\n            return self._frequencies\n\n        def find_greatest_matching_integer(self) -> int:\n            \"\"\"Identifies and returns the greatest integer 'x' where x > 0 and its frequency >= x.\"\"\"\n            greatest_matching = -1\n            for value, frequency in self._frequencies.items():\n                if value > 0 and frequency >= value:\n                    if value > greatest_matching:\n                        greatest_matching = value\n            return greatest_matching\n\n    integer_list_processor = IntegerList(lst)\n    return integer_list_processor.find_greatest_matching_integer()"}
{"task_id": "HumanEval/67", "solution": "```python\ndef fruit_distribution(s,n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges\n    that are distributed in a basket of fruit this basket contains\n    apples, oranges, and mango fruits. Given the string that represents the total number of\n    the oranges and apples and an integer that represent the total number of the fruits\n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    import re\n\n    def _extract_fruit_count(s: str, fruit_name: str) -> int:\n        \"\"\"Extracts the numerical count for a specific fruit from the input string.\"\"\"\n        pattern = rf\"(\\d+)\\s+{re.escape(fruit_name)}\"\n        match = re.search(pattern, s)\n        if match:\n            return int(match.group(1))\n        return 0\n\n    apple_count = _extract_fruit_count(s, \"apples\")\n    orange_count = _extract_fruit_count(s, \"oranges\")\n\n    mango_count = n - apple_count - orange_count\n\n    return max(0, mango_count)\n```"}
{"task_id": "HumanEval/68", "solution": "class Node:\n    \"\"\"\n    Represents a single node from the input array, holding its value and original index.\n    \"\"\"\n    def __init__(self, value: int, index: int):\n        self._value = value\n        self._index = index\n\n    def is_even(self) -> bool:\n        \"\"\"\n        Checks if the node's value is even.\n        \"\"\"\n        return self._value % 2 == 0\n\n    def get_value(self) -> int:\n        \"\"\"\n        Returns the node's value.\n        \"\"\"\n        return self._value\n\n    def get_index(self) -> int:\n        \"\"\"\n        Returns the node's index.\n        \"\"\"\n        return self._index\n\ndef pluck(arr):\n    \"\"\"\n    \"Given an array representing a branch of a tree that has non-negative integer nodes\n    your task is to pluck one of the nodes and return it.\n    The plucked node should be the node with the smallest even value.\n    If multiple nodes with the same smallest even value are found return the node that has smallest index.\n\n    The plucked node should be returned in a list, [ smalest_value, its index ],\n    If there are no even values or the given array is empty, return [].\n\n    Example 1:\n        Input: [4,2,3]\n        Output: [2, 1]\n        Explanation: 2 has the smallest even value, and 2 has the smallest index.\n\n    Example 2:\n        Input: [1,2,3]\n        Output: [2, 1]\n        Explanation: 2 has the smallest even value, and 2 has the smallest index.\n\n    Example 3:\n        Input: []\n        Output: []\n\n    Example 4:\n        Input: [5, 0, 3, 0, 4, 2]\n        Output: [0, 1]\n        Explanation: 0 is the smallest value, but  there are two zeros,\n                     so we will choose the first zero, which has the smallest index.\n\n    Constraints:\n        * 1 <= nodes.length <= 10000\n        * 0 <= node.value\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_node = None\n\n    for index, value in enumerate(arr):\n        current_node = Node(value, index)\n\n        if current_node.is_even():\n            if smallest_even_node is None:\n                smallest_even_node = current_node\n            elif current_node.get_value() < smallest_even_node.get_value():\n                smallest_even_node = current_node\n            elif current_node.get_value() == smallest_even_node.get_value():\n                # If values are equal, the node encountered first (smallest index) is kept.\n                pass\n\n    if smallest_even_node is not None:\n        return [smallest_even_node.get_value(), smallest_even_node.get_index()]\n    else:\n        return []"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts vowels in a string, including 'y' if it's the last character.\n\n    Vowels are 'a', 'e', 'i', 'o', 'u' (case-insensitive). 'y' is a vowel only when it is at the end of the given word.\n    \"\"\"\n    count = 0\n    lower_s = s.lower()\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    for i, char in enumerate(lower_s):\n        if char in standard_vowels:\n            count += 1\n        elif char == 'y' and i == len(lower_s) - 1:\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/70", "solution": "```python\ndef strange_sort_list(lst):\n    \"\"\"\n    Sorts a list of integers by alternating between the minimum and maximum\n    of the remaining elements.\n    \"\"\"\n    if not lst:\n        return []\n\n    sorted_list = sorted(lst)\n    result_list = []\n\n    left_ptr = 0\n    right_ptr = len(sorted_list) - 1\n    is_min_turn = True\n\n    while left_ptr <= right_ptr:\n        if is_min_turn:\n            result_list.append(sorted_list[left_ptr])\n            left_ptr += 1\n        else:\n            result_list.append(sorted_list[right_ptr])\n            right_ptr -= 1\n        is_min_turn = not is_min_turn\n\n    return result_list\n```"}
{"task_id": "HumanEval/71", "solution": "```python\nimport math\n\ndef triangle_area(a, b, c):\n    '''\n    Given three side lengths, returns triangle area rounded to 2 decimal places.\n    Returns -1 if sides are invalid (non-positive or fail triangle inequality).\n    '''\n    if a <= 0 or b <= 0 or c <= 0 or \\\n       a + b <= c or a + c <= b or b + c <= a:\n        return -1\n\n    s = (a + b + c) / 2\n    area_raw = math.sqrt(s * (s - a) * (s - b) * (s - c))\n\n    return round(area_raw, 2)\n```"}
{"task_id": "HumanEval/73", "solution": "```python\ndef smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic. A palindromic array is an array that\n    is read the same backwards and forwards. In one change, you can change one element to any other element.\n\n    For example:\n    smallest_change([1,2,3,5,4,7,9,6]) == 4\n    smallest_change([1, 2, 3, 4, 3, 2, 2]) == 1\n    smallest_change([1, 2, 3, 2, 1]) == 0\n    \"\"\"\n    changes = 0\n    left = 0\n    right = len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n\n    return changes\n```"}
{"task_id": "HumanEval/72", "solution": "```python\ndef will_it_fly(q,w):\n    \"\"\"\n    Checks if the object q will fly based on two conditions:\n    being a palindromic list and having a sum of elements less than or equal to w.\n    \"\"\"\n    def _is_palindrome(arr):\n        \"\"\"Checks if a list is a palindrome.\"\"\"\n        return arr == arr[::-1]\n\n    def _calculate_sum(arr):\n        \"\"\"Calculates the sum of elements in a list.\"\"\"\n        return sum(arr)\n\n    is_balanced = _is_palindrome(q)\n    total_weight = _calculate_sum(q)\n\n    return is_balanced and (total_weight <= w)\n```"}
{"task_id": "HumanEval/74", "solution": "def _calculate_total_chars(string_list):\n    \"\"\"\n    Calculates the total number of characters in all strings of a given list.\n    Returns 0 for an empty list.\n    \"\"\"\n    return sum(len(s) for s in string_list)\n\ndef total_match(lst1, lst2):\n    \"\"\"\n    Compares two lists of strings based on their total character counts.\n    Returns the list with fewer total characters. If counts are equal, returns the first list.\n    \"\"\"\n    total_chars_lst1 = _calculate_total_chars(lst1)\n    total_chars_lst2 = _calculate_total_chars(lst2)\n\n    if total_chars_lst1 < total_chars_lst2:\n        return lst1\n    elif total_chars_lst2 < total_chars_lst1:\n        return lst2\n    else:\n        return lst1"}
{"task_id": "HumanEval/75", "solution": "```python\ndef is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    def _is_prime(n):\n        \"\"\"Checks if a given integer is a prime number.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    def _get_prime_factors(n):\n        \"\"\"Finds all prime factors of a given integer.\"\"\"\n        factors = []\n        d = 2\n        temp_n = n\n        while d * d <= temp_n:\n            while temp_n % d == 0:\n                factors.append(d)\n                temp_n //= d\n            d += 1\n        if temp_n > 1:\n            factors.append(temp_n)\n        return factors\n\n    if a < 1:\n        return False\n\n    prime_factors = _get_prime_factors(a)\n\n    # Check if all factors are indeed prime (redundant if _get_prime_factors is perfect, but good for robustness)\n    # The problem implies we're looking for prime factors, not just any factors\n    # Also, we need exactly 3 distinct prime factors if the problem meant distinct,\n    # but the example 30=2*3*5 implies non-distinct if that's what was intended\n    # Assuming 'multiplication of 3 prime numbers' means 3 prime factors, possibly repeated (e.g., 8 = 2*2*2)\n\n    return len(prime_factors) == 3 and all(_is_prime(f) for f in prime_factors)\n```\n"}
{"task_id": "HumanEval/77", "solution": "```python\ndef iscube(a):\n    '''\n    Checks if an integer is a perfect cube.\n    Handles both positive and negative integers.\n    '''\n    if a == 0:\n        return True\n\n    # Calculate the cube root.\n    # We use round to handle potential floating point inaccuracies.\n    # For negative numbers, calculate for absolute value and then apply sign.\n\n    if a > 0:\n        root = round(a**(1/3))\n        return root * root * root == a\n    else: # a < 0\n        root = round((-a)**(1/3))\n        return - (root * root * root) == a\n```"}
{"task_id": "HumanEval/78", "solution": "```python\ndef hex_key(num):\n    \"\"\"Counts prime hexadecimal digits in a given string.\n    It iterates through the input string, identifies prime hexadecimal digits (2, 3, 5, 7, B, D), and returns their total count.\n    \"\"\"\n\n    def _hex_to_decimal(hex_char):\n        \"\"\"Converts a single hexadecimal character to its decimal integer value.\"\"\"\n        if '0' <= hex_char <= '9':\n            return int(hex_char)\n        else:\n            return 10 + ord(hex_char) - ord('A')\n\n    def _is_prime_hex_digit(hex_char):\n        \"\"\"Determines if a given hexadecimal character corresponds to a prime decimal value (2, 3, 5, 7, 11, 13).\"\"\"\n        decimal_value = _hex_to_decimal(hex_char)\n        return decimal_value in {2, 3, 5, 7, 11, 13}\n\n    prime_count = 0\n    for char in num:\n        if _is_prime_hex_digit(char):\n            prime_count += 1\n    return prime_count\n```"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a decimal number to its binary string representation,\n    prefixed and suffixed with \"db\".\n    \"\"\"\n    binary_string = bin(decimal)\n    # Remove the \"0b\" prefix\n    stripped_binary = binary_string[2:]\n    return \"db\" + stripped_binary + \"db\""}
{"task_id": "HumanEval/82", "solution": "```python\ndef prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    \"\"\"\n\n    def _is_prime(n):\n        \"\"\"Checks if an integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        # Check for factors from 3 up to sqrt(n)\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    length = len(string)\n    return _is_prime(length)\n```"}
{"task_id": "HumanEval/76", "solution": "```python\ndef is_simple_power(x, n):\n    \"\"\"Your task is to write a function that returns true if a number x is a simple\n    power of n and false in other cases.\n    x is a simple power of n if n**int=x\n    For example:\n    is_simple_power(1, 4) => true\n    is_simple_power(2, 2) => true\n    is_simple_power(8, 2) => true\n    is_simple_power(3, 2) => false\n    is_simple_power(3, 1) => false\n    is_simple_power(5, 3) => false\n    \"\"\"\n    # Handle the case where x is 1, as n^0 always equals 1.\n    if x == 1:\n        return True\n\n    # Handle cases where x is non-positive or n is non-positive (when x is not 1).\n    if x <= 0 or n <= 0:\n        return False\n\n    # Handle the case where n is 1 and x is not 1 (already covered by previous check).\n    # Since x > 1 and n > 0 here, if n is 1, it cannot be a power of x.\n    if n == 1:\n        return False\n\n    # Iteratively multiply n until current_power is greater than or equal to x.\n    current_power = n\n    while current_power < x:\n        current_power *= n\n\n    # Check if current_power exactly matches x.\n    return current_power == x\n```"}
{"task_id": "HumanEval/80", "solution": "```python\ndef is_happy(s):\n    \"\"\"You are given a string s.\n    Your task is to check if the string is happy or not.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct\n    For example:\n    is_happy(a) => False\n    is_happy(aa) => False\n    is_happy(abcd) => True\n    is_happy(aabb) => False\n    is_happy(adb) => True\n    is_happy(xyy) => False\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        char1 = s[i]\n        char2 = s[i+1]\n        char3 = s[i+2]\n\n        if char1 == char2 or char1 == char3 or char2 == char3:\n            return False\n\n    return True\n```"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPA values to a list of letter grades.\n\n    Args:\n        grades: A list of numerical (float) GPA values.\n    \"\"\"\n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append('A+')\n        elif gpa > 3.7:\n            letter_grades.append('A')\n        elif gpa > 3.3:\n            letter_grades.append('A-')\n        elif gpa > 3.0:\n            letter_grades.append('B+')\n        elif gpa > 2.7:\n            letter_grades.append('B')\n        elif gpa > 2.3:\n            letter_grades.append('B-')\n        elif gpa > 2.0:\n            letter_grades.append('C+')\n        elif gpa > 1.7:\n            letter_grades.append('C')\n        elif gpa > 1.3:\n            letter_grades.append('C-')\n        elif gpa > 1.0:\n            letter_grades.append('D+')\n        elif gpa > 0.7:\n            letter_grades.append('D')\n        elif gpa > 0.0:\n            letter_grades.append('D-')\n        elif gpa == 0.0:\n            letter_grades.append('E')\n    return letter_grades"}
{"task_id": "HumanEval/83", "solution": "```python\ndef starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n\n    # Count of n-digit numbers starting with 1\n    count_starts_with_1 = 10**(n - 1)\n\n    # Count of n-digit numbers ending with 1\n    # The first digit cannot be 0, so 9 choices for the first digit.\n    # The middle n-2 digits can be any of 10 choices.\n    count_ends_with_1 = 9 * (10**(n - 2))\n\n    # Count of n-digit numbers starting WITH 1 AND ending WITH 1\n    # The first and last digits are fixed as 1.\n    # The middle n-2 digits can be any of 10 choices.\n    count_starts_and_ends_with_1 = 10**(n - 2)\n\n    # Apply the Principle of Inclusion-Exclusion\n    total_count = count_starts_with_1 + count_ends_with_1 - count_starts_and_ends_with_1\n\n    return total_count\n```"}
{"task_id": "HumanEval/84", "solution": "```python\ndef solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n\n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n\n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n    def _validate_input(N: int) -> None:\n        \"\"\"Validates if N is an integer within the range [0, 10000].\"\"\"\n        if not (0 <= N <= 10000):\n            raise ValueError(\"N must be between 0 and 10000\")\n\n    def _calculate_sum_of_digits(N: int) -> int:\n        \"\"\"Computes the sum of the decimal digits of N.\"\"\"\n        s = 0\n        temp_N = N\n        if temp_N == 0:\n            return 0\n        while temp_N > 0:\n            s += temp_N % 10\n            temp_N //= 10\n        return s\n\n    def _convert_to_binary(decimal_sum: int) -> str:\n        \"\"\"Converts a decimal integer sum into its binary string representation.\"\"\"\n        if decimal_sum == 0:\n            return \"0\"\n        return bin(decimal_sum)[2:]\n\n    _validate_input(N)\n    decimal_sum = _calculate_sum_of_digits(N)\n    binary_string = _convert_to_binary(decimal_sum)\n    return binary_string\n```"}
{"task_id": "HumanEval/85", "solution": "```python\ndef add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\"\"\"\n    current_sum = 0\n    for index, element in enumerate(lst):\n        if index % 2 != 0:  # Check if the index is odd\n            if element % 2 == 0:  # Check if the element at the odd index is even\n                current_sum += element\n    return current_sum\n```"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n    \"\"\"\n    import abc\n    import re\n\n    class _Character:\n        \"\"\"Encapsulates a single character and its ASCII value.\"\"\"\n        def __init__(self, char_val: str):\n            self.value = char_val\n            self.ascii_value = ord(char_val)\n\n    class _Token(abc.ABC):\n        \"\"\"Abstract base class for string tokens.\"\"\"\n        @abc.abstractmethod\n        def get_value(self) -> str:\n            pass\n\n    class _Word(_Token):\n        \"\"\"Represents a word, managing its characters and sorting them.\"\"\"\n        def __init__(self, word_str: str):\n            self._characters = [_Character(char) for char in word_str]\n\n        def sort_characters(self) -> None:\n            \"\"\"Sorts the internal list of _Character objects by ASCII value.\"\"\"\n            self._characters.sort(key=lambda char_obj: char_obj.ascii_value)\n\n        def get_value(self) -> str:\n            \"\"\"Returns the concatenated string of sorted characters.\"\"\"\n            return ''.join(char_obj.value for char_obj in self._characters)\n\n    class _Space(_Token):\n        \"\"\"Represents a sequence of space characters and preserves their value.\"\"\"\n        def __init__(self, space_str: str):\n            self._value = space_str\n\n        def get_value(self) -> str:\n            \"\"\"Returns the original space string.\"\"\"\n            return self._value\n\n    class InputString:\n        \"\"\"Encapsulates the input string and provides methods for tokenization.\"\"\"\n        def __init__(self, s: str):\n            self.value = s\n\n        def get_tokens(self) -> list[_Token]:\n            \"\"\"Splits the input string into a list of _Word and _Space objects.\"\"\"\n            # Finds sequences of non-whitespace or whitespace characters.\n            token_strings = re.findall(r'(\\S+|\\s+)', self.value)\n\n            tokens = []\n            for ts in token_strings:\n                if ts.isspace():\n                    tokens.append(_Space(ts))\n                else:\n                    tokens.append(_Word(ts))\n            return tokens\n\n    input_str_obj = InputString(s)\n    tokens = input_str_obj.get_tokens()\n\n    result_parts = []\n    for token in tokens:\n        # Sort characters only if the token is a word.\n        if isinstance(token, _Word):\n            token.sort_characters()\n        result_parts.append(token.get_value())\n\n    return ''.join(result_parts)"}
{"task_id": "HumanEval/89", "solution": "```python\ndef encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated.\n    The alphabet should be rotated in a manner such that the letters\n    shift down by two multiplied to two places.\n    \"\"\"\n    ALPHABET = \"abcdefghijklmnopqrstuvwxyz\"\n    SHIFT_VALUE = 4  # Two multiplied by two places equals 4\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            index = ALPHABET.index(char)\n            new_index = (index + SHIFT_VALUE) % len(ALPHABET)\n            encrypted_chars.append(ALPHABET[new_index])\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)\n```"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integer x in the nested list lst and returns a list of\n    (row, column) coordinates, sorted primarily by row (ascending)\n    and secondarily by column (descending).\n    \"\"\"\n    coordinates = []\n    for row_idx, row in enumerate(lst):\n        for col_idx, element in enumerate(row):\n            if element == x:\n                coordinates.append((row_idx, col_idx))\n\n    # Sort the collected coordinates:\n    # Primary sort by row_idx (ascending).\n    # Secondary sort by col_idx (descending) by negating col_idx.\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return coordinates"}
{"task_id": "HumanEval/90", "solution": "```python\ndef next_smallest(lst):\n    \"\"\"\n    You are given a list of integers.\n    Write a function next_smallest() that returns the 2nd smallest element of the list.\n    Return None if there is no such element.\n\n    next_smallest([1, 2, 3, 4, 5]) == 2\n    next_smallest([5, 1, 4, 3, 2]) == 2\n    next_smallest([]) == None\n    next_smallest([1, 1]) == None\n    \"\"\"\n    # Identify unique elements and sort them in ascending order.\n    unique_elements = set(lst)\n    sorted_unique = sorted(list(unique_elements))\n\n    # Return None if there are fewer than two unique elements, otherwise return the second smallest.\n    if len(sorted_unique) < 2:\n        return None\n    else:\n        return sorted_unique[1]\n```"}
{"task_id": "HumanEval/88", "solution": "```python\ndef sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    if not array:\n        return []\n    if len(array) == 1:\n        return list(array)\n\n    copied_array = list(array)\n    first_element = array[0]\n    last_element = array[-1]\n    elements_sum = first_element + last_element\n\n    if elements_sum % 2 != 0:  # Sum is odd, sort ascending\n        copied_array.sort()\n    else:  # Sum is even, sort descending\n        copied_array.sort(reverse=True)\n\n    return copied_array\n```"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts the number of \"boredom\" sentences in a string, where a boredom is a sentence\n    starting with \"I\". Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    import re\n\n    boredom_count = 0\n    # Split the string into potential sentences using sentence delimiters.\n    # re.split will return parts between the delimiters.\n    sentences = re.split(r'[.?!]', S)\n\n    for sentence_part in sentences:\n        # Trim leading and trailing whitespace from each sentence part.\n        trimmed_sentence = sentence_part.strip()\n        # Check if the trimmed sentence starts with \"I \" (case-sensitive, with space).\n        if trimmed_sentence.startswith(\"I \"):\n            boredom_count += 1\n\n    return boredom_count"}
