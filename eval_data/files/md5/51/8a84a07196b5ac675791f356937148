{"task_id": "HumanEval/46", "solution": "def fib4(n: int) -> int:\n    \"\"\"Computes the n-th element of the fib4 number sequence iteratively.\n    fib4(0) = 0\n    fib4(1) = 0\n    fib4(2) = 2\n    fib4(3) = 0\n    For n >= 4: fib4(n) = fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4)\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # a = fib4(n-4), b = fib4(n-3), c = fib4(n-2), d = fib4(n-1)\n    a, b, c, d = 0, 0, 2, 0\n\n    for _ in range(4, n + 1):\n        next_val = a + b + c + d\n        a, b, c, d = b, c, d, next_val\n\n    return d"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return the median of elements in the list l. For even-length lists, the mean of the two middle elements is returned as a float.\"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    # Trust the caller's inputs; no validation for empty list, non-numeric elements, or NaN values.\n\n    if n % 2 == 1:\n        # Odd number of elements\n        middle_index = n // 2\n        return sorted_l[middle_index]\n    else:\n        # Even number of elements\n        mid1_index = n // 2 - 1\n        mid2_index = n // 2\n        return (sorted_l[mid1_index] + sorted_l[mid2_index]) / 2.0"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a str\")\n\n    left = 0\n    right = len(text) - 1\n\n    while left < right:\n        if text[left] != text[right]:\n            return False\n        left += 1\n        right -= 1\n    return True"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    if not isinstance(n, int) or not isinstance(p, int):\n        raise TypeError(\"n and p must be integers\")\n    if n < 0:\n        raise ValueError(\"exponent n must be a non-negative integer\")\n    if p <= 0:\n        raise ValueError(\"modulus p must be a positive integer\")\n    return pow(2, n, p)"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str) -> bool:\n    \"\"\"\n    Checks if the input string is a palindrome using a two-pointer technique.\n    It compares characters from both ends inwards, returning True if all match.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a str\")\n\n    left = 0\n    right = len(text) - 1\n\n    while left < right:\n        if text[left] != text[right]:\n            return False\n        left += 1\n        right -= 1\n\n    return True"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"median() expects a list\")\n    if not l:\n        raise ValueError(\"median() arg is an empty list\")\n\n    import numbers\n    for x in l:\n        if isinstance(x, bool) or not isinstance(x, numbers.Real):\n            raise TypeError(\"median() arg must contain only real numbers\")\n\n    l_sorted = sorted(l)\n    n = len(l_sorted)\n    mid = n // 2\n    if n % 2 == 1:\n        return l_sorted[mid]\n    return (l_sorted[mid - 1] + l_sorted[mid]) / 2.0"}
