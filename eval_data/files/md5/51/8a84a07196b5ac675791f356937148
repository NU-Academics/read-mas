{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in the Collatz sequence.\n    The list includes unique odd numbers from the sequence, sorted in increasing order.\n    \"\"\"\n    odd_values = set()\n    while True:\n        if n % 2 != 0:  # If n is odd\n            odd_values.add(n)\n        if n == 1:\n            break\n        if n % 2 == 0:  # If n is even\n            n = n // 2\n        else:  # If n is odd\n            n = 3 * n + 1\n    return sorted(list(odd_values))"}
{"task_id": "HumanEval/124", "solution": "import re\ndef valid_date(date):\n    # Check if the input is a non-empty string as specified.\n    if not isinstance(date, str) or not date:\n        return False\n\n    # Use regex to enforce the mm-dd-yyyy format.\n    date_pattern = r'^(?P<mm>\\d{2})-(?P<dd>\\d{2})-(?P<yyyy>\\d{4})$'\n    match = re.match(date_pattern, date)\n\n    if not match:\n        return False\n\n    # Parse month and day into integers for numeric validation.\n    mm = int(match.group('mm'))\n    dd = int(match.group('dd'))\n\n    # Validate month range (1-12).\n    if mm < 1 or mm > 12:\n        return False\n\n    # Validate day minimum (at least 1).\n    if dd < 1:\n        return False\n\n    # Validate day based on month-specific limits.\n    if mm in {1, 3, 5, 7, 8, 10, 12}:\n        if dd > 31:\n            return False\n    elif mm in {4, 6, 9, 11}:\n        if dd > 30:\n            return False\n    elif mm == 2: # February allows up to 29 days, no leap year check needed.\n        if dd > 29:\n            return False\n\n    return True"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n\n    At most two digits is interpreted as having absolute value <= 99.\n    \"\"\"\n    if not isinstance(arr, (list, tuple)):\n        raise TypeError(\"arr must be a list or tuple of integers\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n    n = len(arr)\n    if n == 0:\n        raise ValueError(\"arr must be non-empty\")\n    if k < 1 or k > n:\n        raise ValueError(\"k must be between 1 and len(arr)\")\n\n    total = 0\n    for x in arr[:k]:\n        if not isinstance(x, int):\n            raise TypeError(\"arr must contain integers\")\n        if abs(x) <= 99:\n            total += x\n    return total"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Return a sorted list of the distinct odd numbers encountered in the Collatz sequence starting from a given positive integer n.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    odd_nums = set()\n    current = n\n\n    while True:\n        if current % 2 != 0:\n            odd_nums.add(current)\n\n        if current == 1:\n            break\n        elif current % 2 == 0:\n            current = current // 2\n        else:\n            current = 3 * current + 1\n\n    return sorted(list(odd_nums))"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two closed integer intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise or if intervals don't intersect.\n    \"\"\"\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    # Calculate the start and end of the intersection interval\n    intersect_start = max(start1, start2)\n    intersect_end = min(end1, end2)\n\n    # If the intersection start is greater than the end, there is no intersection\n    if intersect_start > intersect_end:\n        length = 0\n    else:\n        length = intersect_end - intersect_start\n\n    # Check if the length is a prime number\n    if length <= 1:\n        return \"NO\"\n\n    # Check for divisors from 2 up to the square root of the length\n    for i in range(2, int(length**0.5) + 1):\n        if length % i == 0:\n            return \"NO\"\n\n    return \"YES\""}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n\n    for example:\n    valid_date('03-11-2000') => True\n\n    valid_date('15-01-2012') => False\n\n    valid_date('04-0-2040') => False\n\n    valid_date('06-04-2020') => True\n\n    valid_date('06/04/2020') => False\n    \"\"\"\n    s = date.strip()\n    if not s:\n        return False\n\n    if s.count('-') != 2:\n        return False\n\n    parts = s.split('-')\n    if len(parts) != 3:\n        return False\n\n    month_str, day_str, year_str = parts\n\n    # Check if each part contains only digits\n    if not (month_str.isdigit() and day_str.isdigit() and year_str.isdigit()):\n        return False\n\n    month = int(month_str)\n    day = int(day_str)\n    year = int(year_str)  # Year is implicitly valid if year_str consists of digits and int() handles leading zeros.\n\n    # Month validation\n    if month < 1 or month > 12:\n        return False\n\n    # Day validation (must be at least 1)\n    if day < 1:\n        return False\n\n    # Determine max_day based on month\n    max_day = 0\n    if month in (1, 3, 5, 7, 8, 10, 12):\n        max_day = 31\n    elif month in (4, 6, 9, 11):\n        max_day = 30\n    else:  # month == 2 (February)\n        max_day = 29\n\n    # Check if day exceeds max_day for the given month\n    if day > max_day:\n        return False\n\n    return True"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether they are sorted in ascending order\n    and if no number appears three or more times.\n    '''\n    if not lst or len(lst) == 1:\n        return True\n\n    prev = lst[0]\n    counts = {prev: 1}\n\n    for x in lst[1:]:\n        if x < prev:\n            return False\n\n        counts[x] = counts.get(x, 0) + 1\n        if counts[x] >= 3:\n            return False\n\n        prev = x\n\n    return True"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order and no number appears more than twice.\n    Assumes non-negative integers.\n    '''\n    counts = {}\n    for i in range(len(lst)):\n        if i > 0 and lst[i] < lst[i-1]:\n            return False\n\n        num = lst[i]\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:\n            return False\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Given a string, return:\n      - a list of words split on any whitespace if the text contains any whitespace;\n      - otherwise, a list of items split on commas if the text contains any commas;\n      - otherwise, the integer count of lowercase letters whose alphabet index is odd\n        (ord('a') = 0, ord('b') = 1, ..., ord('z') = 25).\n    \"\"\"\n    # If any whitespace character is present, split on whitespace\n    if any(c.isspace() for c in txt):\n        return txt.split()\n    # If no whitespace but commas exist, split on commas\n    if ',' in txt:\n        return txt.split(',')\n    # Otherwise count lowercase letters with odd order (a=0, b=1, ...)\n    count = 0\n    base = ord('a')\n    for ch in txt:\n        if 'a' <= ch <= 'z':\n            if (ord(ch) - base) % 2 == 1:\n                count += 1\n    return count"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    \"\"\"\n    if not arr:\n        return None\n\n    sign_product = 1\n    magnitude_sum = 0\n\n    for num in arr:\n        if num == 0:\n            sign_product = 0\n            # If there's a zero, the final product of signs will be zero.\n            # We can stop early because the final result will be 0.\n            break\n        elif num < 0:\n            sign_product *= -1\n\n        magnitude_sum += abs(num)\n\n    return magnitude_sum * sign_product"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two closed integer intervals is a prime number.\n    Returns \"YES\" if prime, otherwise \"NO\".\n    \"\"\"\n    def is_prime(n):\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    a, b = interval1\n    c, d = interval2\n\n    overlap_start = max(a, c)\n    overlap_end = min(b, d)\n\n    if overlap_start >= overlap_end:\n        return \"NO\"\n\n    length = overlap_end - overlap_start\n\n    if length <= 1:\n        return \"NO\"\n\n    return \"YES\" if is_prime(length) else \"NO\""}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"Checks if there's a subsequence '[[]]' in the input string.\"\"\"\n    pattern = ['[', '[', ']', ']']\n    pattern_idx = 0\n\n    for char in string:\n        if pattern_idx < len(pattern) and char == pattern[pattern_idx]:\n            pattern_idx += 1\n        if pattern_idx == len(pattern):\n            return True\n\n    return False"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    n = abs(n)\n    product = 1\n    found_odd = False\n    if n == 0:\n        return 0\n    while n:\n        digit = n % 10\n        if digit & 1:\n            product *= digit\n            found_odd = True\n        n //= 10\n    return product if found_odd else 0"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically minimum path of length k in the grid.\n    Uses a greedy approach to select the smallest possible next value at each step.\n    \"\"\"\n    N = len(grid)\n\n    # Define 4-direction moves (up, down, left, right)\n    dr = [-1, 1, 0, 0]\n    dc = [0, 0, -1, 1]\n\n    # Find the minimum value in the grid and its initial positions\n    min_val_grid = float('inf')\n    initial_S = set()\n    for r_idx in range(N):\n        for c_idx in range(N):\n            current_val = grid[r_idx][c_idx]\n            if current_val < min_val_grid:\n                min_val_grid = current_val\n                initial_S = {(r_idx, c_idx)}\n            elif current_val == min_val_grid:\n                initial_S.add((r_idx, c_idx))\n\n    ans = [min_val_grid]\n    S = initial_S\n\n    if k == 1:\n        return ans\n\n    # For subsequent steps, greedily find the minimum neighbor value\n    for _ in range(1, k):\n        min_neighbor_val = float('inf')\n        next_S = set()\n\n        for r, c in S:\n            for i in range(4):\n                nr, nc = r + dr[i], c + dc[i]\n\n                # Check grid boundaries\n                if 0 <= nr < N and 0 <= nc < N:\n                    neighbor_val = grid[nr][nc]\n\n                    if neighbor_val < min_neighbor_val:\n                        min_neighbor_val = neighbor_val\n                        next_S = {(nr, nc)} # New minimum, reset next_S\n                    elif neighbor_val == min_neighbor_val:\n                        next_S.add((nr, nc)) # Tie, add to next_S\n\n        ans.append(min_neighbor_val)\n        S = next_S\n\n    return ans"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Return the lexicographically smallest sequence of length k by starting at any cell\n    and moving each step to an orthogonal neighbor. Grid contains numbers 1..N*N exactly once.\n    \"\"\"\n    N = len(grid)\n    # find coordinates of value 1 (the global minimum)\n    target = 1\n    start_r = start_c = None\n    for r in range(N):\n        for c in range(N):\n            if grid[r][c] == target:\n                start_r, start_c = r, c\n                break\n        if start_r is not None:\n            break\n\n    res = [target]\n    if k == 1:\n        return res\n\n    r, c = start_r, start_c\n    dirs = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n    for _ in range(k - 1):\n        best_val = None\n        best_r = best_c = None\n        for dr, dc in dirs:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < N and 0 <= nc < N:\n                val = grid[nr][nc]\n                if best_val is None or val < best_val:\n                    best_val = val\n                    best_r, best_c = nr, nc\n        # move to the chosen neighbor (guaranteed to exist because N >= 2)\n        r, c = best_r, best_c\n        res.append(best_val)\n\n    return res"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Calculates the product of odd digits in a non-negative integer n.\n    Returns 0 if no odd digits are found.\"\"\"\n    product = 1\n    found_odd = False\n\n    if n == 0:\n        return 0\n\n    while n > 0:\n        d = n % 10\n        if d % 2 == 1:\n            product *= d\n            found_odd = True\n        n //= 10\n\n    if found_odd:\n        return product\n    else:\n        return 0"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"\n    Return a list of the first n+1 numbers of the Tribonacci-like sequence.\n    Assumed base: tri(0) = 1, tri(1) = 3.\n    For even k: tri(k) = 1 + k // 2\n    For odd k:  tri(k) = tri(k-1) + tri(k-2) + tri(k+1)  (tri(k+1) is even so computed via the even rule)\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    result = [0] * (n + 1)\n    result[0] = 1\n    if n >= 1:\n        result[1] = 3\n\n    for i in range(2, n + 1):\n        if i % 2 == 0:\n            result[i] = 1 + i // 2\n        else:\n            next_even = 1 + (i + 1) // 2\n            result[i] = result[i - 1] + result[i - 2] + next_even\n\n    return result"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Computes the first n+1 numbers of a modified Tribonacci sequence.\n\n    The sequence is defined (after resolving the recurrence) as:\n      tri(0) = 1\n      tri(1) = 3\n      for k >= 2:\n        if k is even: tri(k) = 1 + k//2\n        else: tri(k) = tri(k-1) + tri(k-2) + 1 + (k+1)//2\n\n    Args:\n        n (int): non-negative integer\n\n    Returns:\n        list[int]: list of length n+1 with tri(0) through tri(n)\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    res = [0] * (n + 1)\n    res[0] = 1\n    if n >= 1:\n        res[1] = 3\n\n    for i in range(2, n + 1):\n        if i % 2 == 0:\n            res[i] = 1 + i // 2\n        else:\n            res[i] = res[i - 1] + res[i - 2] + 1 + (i + 1) // 2\n\n    return res"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squared numbers after rounding each to the upper integer.\n    Each element in the list is first rounded up, then squared, and finally summed.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        ceiled_num = math.ceil(num)\n        total_sum += ceiled_num ** 2\n    return total_sum"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    '''\n    Create a function that returns True if the last character\n    of a given string is an alphabetical character and is not\n    a part of a word, and False otherwise.\n    Note: \"word\" is a group of characters separated by space.\n\n    Examples:\n    check_if_last_char_is_a_letter(\"apple pie\") \u279e False\n    check_if_last_char_is_a_letter(\"apple pi e\") \u279e True\n    check_if_last_char_is_a_letter(\"apple pi e \") \u279e False\n    check_if_last_char_is_a_letter(\"\") \u279e False\n    '''\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n    if not last_char.isalpha():\n        return False\n\n    # The last character is not part of a word if it is preceded by a space.\n    # If there's no preceding character (len == 1), it's part of a single-word string -> False.\n    return len(txt) >= 2 and txt[-2] == ' '"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Returns True if the last character of txt is an alphabetical character\n    and is not part of a word (a word is a group of characters separated by space).\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n    if not last_char.isalpha():\n        return False\n\n    # It's not part of a word if it's the only character or the previous character is a space\n    return len(txt) == 1 or txt[-2] == ' '"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if there exists a balanced bracket subsequence with nesting depth >= 2.\n    This is equivalent to finding a subsequence matching pattern '[', '[', ']', ']'.\n    \"\"\"\n    n = len(string)\n    if n < 4:\n        return False\n\n    # suffix_close[i] stores the count of ']' characters strictly after index i.\n    suffix_close = [0] * n\n    current_close_count = 0\n    for i in range(n - 1, -1, -1):\n        suffix_close[i] = current_close_count\n        if string[i] == ']':\n            current_close_count += 1\n\n    open_before = 0\n    for i in range(n):\n        if string[i] == '[':\n            # This '[' is considered the second opening bracket of a potential '[ [ ] ]' subsequence.\n            if open_before >= 1 and suffix_close[i] >= 2:\n                return True\n            open_before += 1\n\n    return False"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squares of numbers in a list, after rounding each element up to the nearest integer.\n    Each element is rounded using math.ceil before squaring.\n    \"\"\"\n    total = 0\n    for x in lst:\n        c = math.ceil(x)\n        total += c * c\n    return total"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Finds the largest negative and smallest positive integers in a list,\n    ignoring non-integer types and booleans.\n    Returns (largest_negative, smallest_positive) or None for missing types.\n    \"\"\"\n    max_neg = None\n    min_pos = None\n\n    for x in lst:\n        # Skip non-integer types and booleans as per design specification.\n        if not isinstance(x, int) or isinstance(x, bool):\n            continue\n\n        if x < 0:\n            if max_neg is None or x > max_neg:\n                max_neg = x\n        elif x > 0:\n            if min_pos is None or x < min_pos:\n                min_pos = x\n\n    return (max_neg, min_pos)"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\n    The smallest positive even is 2, so the minimal sum for four such numbers is 8.\n    Also, the sum of even numbers is even, so n must be even.\n    \"\"\"\n    return isinstance(n, int) and n % 2 == 0 and n >= 8"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Finds the largest negative integer and the smallest positive integer in a list.\n    Returns (largest_negative, smallest_positive), or None for each if not found.\n    '''\n    largest_negative = None\n    smallest_positive = None\n\n    for num in lst:\n        if num < 0:\n            if largest_negative is None or num > largest_negative:\n                largest_negative = num\n        elif num > 0:\n            if smallest_positive is None or num < smallest_positive:\n                smallest_positive = num\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compare two values (int, float, or numeric string with '.' or ',' decimal separator).\n    Return the original input (a or b) that is numerically larger, or None if equal.\n    \"\"\"\n    epsilon = 1e-9\n\n    def _to_float(x):\n        if isinstance(x, str):\n            s = x.strip().replace(',', '.')\n            return float(s)\n        return float(x)\n\n    fa = _to_float(a)\n    fb = _to_float(b)\n\n    if abs(fa - fb) < epsilon:\n        return None\n    return a if fa > fb else b"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    if not isinstance(n, int):\n        return False\n    # Sum of four positive even integers must be even and at least 2+2+2+2 = 8\n    return n % 2 == 0 and n >= 8"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n    \"\"\"\n    def to_float(x):\n        if isinstance(x, (int, float)):\n            return float(x)\n        if isinstance(x, str):\n            # Normalize comma decimal separator to dot\n            s = x.strip().replace(',', '.')\n            return float(s)\n        # Fallback: try converting via str\n        return float(str(x).strip().replace(',', '.'))\n\n    val_a = to_float(a)\n    val_b = to_float(b)\n\n    if val_a > val_b:\n        return a\n    if val_b > val_a:\n        return b\n    return None"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Computes the Brazilian factorial, defined as product_{k=1..n} k!.\n    For example, special_factorial(4) returns 288.\n    \"\"\"\n    total = 1\n    current_fact = 1\n\n    for k in range(1, n + 1):\n        current_fact *= k\n        total *= current_fact\n\n    return total"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Computes the Brazilian factorial, defined as n! * (n-1)! * ... * 1!.\n    This iterative approach avoids recomputing factorials from scratch.\n    \"\"\"\n    factorial = 1\n    result = 1\n    for i in range(1, n + 1):\n        factorial *= i\n        result *= factorial\n    return result"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Given a string text, replace spaces as follows:\n    - Any sequence of 3 or more consecutive spaces -> '-'\n    - Sequences of 1 or 2 spaces -> '_' or '__' respectively\n\n    Examples:\n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a string\")\n\n    result_chars = []\n    space_count = 0\n\n    for char in text:\n        if char == ' ':\n            space_count += 1\n            continue\n\n        if space_count:\n            if space_count >= 3:\n                result_chars.append('-')\n            elif space_count == 1:\n                result_chars.append('_')\n            else:  # space_count == 2\n                result_chars.append('__')\n            space_count = 0\n\n        result_chars.append(char)\n\n    # Handle trailing spaces\n    if space_count:\n        if space_count >= 3:\n            result_chars.append('-')\n        elif space_count == 1:\n            result_chars.append('_')\n        else:\n            result_chars.append('__')\n\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific criteria.\n    Returns 'Yes' if valid, 'No' otherwise.\"\"\"\n\n    # Condition 2: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    name_part, extension_part = file_name.split('.')\n\n    # Condition 3: The substring before the dot should not be empty\n    if not name_part:\n        return 'No'\n\n    # Condition 3: and it starts with a letter from the latin alphabet\n    if not ('a' <= name_part[0] <= 'z' or 'A' <= name_part[0] <= 'Z'):\n        return 'No'\n\n    # Condition 1: There should not be more than three digits ('0'-'9')\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # Condition 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    if extension_part not in ['txt', 'exe', 'dll']:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    Validation rules:\n    - No more than three digits in the entire file_name.\n    - Exactly one dot '.' in file_name.\n    - The substring before the dot is non-empty and starts with a latin letter (A-Z or a-z).\n    - The substring after the dot is one of: 'txt', 'exe', 'dll'.\n    \"\"\"\n    # Exactly one dot\n    if file_name.count('.') != 1:\n        return 'No'\n\n    prefix, suffix = file_name.split('.', 1)\n\n    # Prefix must be non-empty and start with a latin letter\n    if not prefix:\n        return 'No'\n    first_char = prefix[0]\n    if not (('a' <= first_char <= 'z') or ('A' <= first_char <= 'Z')):\n        return 'No'\n\n    # Suffix must be one of the allowed extensions\n    if suffix not in ('txt', 'exe', 'dll'):\n        return 'No'\n\n    # No more than three digits in the entire file name\n    digit_count = sum(1 for ch in file_name if '0' <= ch <= '9')\n    if digit_count > 3:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Transform list entries by index and return their sum.\n    Indexes that are multiples of 3 are squared.\n    Indexes that are multiples of 4 (and not multiples of 3) are cubed.\n    Other entries are unchanged.\n    \"\"\"\n    total = 0\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            total += num ** 2\n        elif i % 4 == 0:\n            total += num ** 3\n        else:\n            total += num\n    return total"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    import math\n\n    def is_prime(n):\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        limit = math.isqrt(n)\n        for i in range(3, limit + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split()\n    return \" \".join(w for w in words if is_prime(len(w)))"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n    \"\"\"\n    total_sum = 0\n    for index, num in enumerate(lst):\n        if index % 3 == 0:\n            total_sum += num ** 2\n        elif index % 4 == 0:\n            total_sum += num ** 3\n        else:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/144", "solution": "import math\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise.\n    \"\"\"\n    num_x_str, den_x_str = x.split('/')\n    num_n_str, den_n_str = n.split('/')\n\n    # Convert to integers\n    a = int(num_x_str)\n    b = int(den_x_str)\n    c = int(num_n_str)\n    d = int(den_n_str)\n\n    # Perform cross-cancellation using gcd\n    g1 = math.gcd(a, d)\n    a //= g1\n    d //= g1\n\n    g2 = math.gcd(c, b)\n    c //= g2\n    b //= g2\n\n    # Calculate final product components\n    product_num = a * c\n    product_den = b * d\n\n    # Check divisibility\n    return product_num % product_den == 0"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Return a string containing words from the input sentence whose lengths are prime numbers.\n    Words are returned in their original order, separated by single spaces. If no words match,\n    an empty string is returned.\n    \"\"\"\n    def is_prime(n):\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    words = sentence.split()\n    return \" \".join(word for word in words if is_prime(len(word)))"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their absolute digits, preserving original order for ties.\n    \"\"\"\n    def sum_digits(n):\n        return sum(int(d) for d in str(abs(n)))\n\n    sorted_pairs = sorted(enumerate(nums), key=lambda item: (sum_digits(item[1]), item[0]))\n    return [value for index, value in sorted_pairs]"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Write a function which sorts the given list of integers\n    in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their index in original list.\n    \"\"\"\n    def _sum_digits(n):\n        n = abs(n)\n        s = 0\n        if n == 0:\n            return 0\n        while n:\n            s += n % 10\n            n //= 10\n        return s\n\n    decorated = ((_sum_digits(num), i, num) for i, num in enumerate(nums))\n    return [num for _, _, num in sorted(decorated)]"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Counts numbers greater than 10 where both their first and last digits are odd.\n    It considers the absolute value of the number for digit extraction.\n    \"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            # Convert absolute number to string to easily get the first digit.\n            s_num = str(abs(num))\n            first_digit = int(s_num[0])\n\n            # Get the last digit using modulo 10 on the absolute number.\n            last_digit = abs(num) % 10\n\n            # Check if both first and last digits are odd.\n            if first_digit % 2 != 0 and last_digit % 2 != 0:\n                count += 1\n    return count"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns\n    the number of elements in the array that are greater than 10 and both\n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    Non-integer floats are ignored; integer-valued floats (e.g. 15.0) are accepted.\n    \"\"\"\n    count = 0\n    if nums is None:\n        return 0\n    for val in nums:\n        # Skip booleans (subclass of int) and non-numeric values\n        if isinstance(val, bool):\n            continue\n        if not isinstance(val, (int, float)):\n            continue\n        # Accept only integer-valued numbers\n        if isinstance(val, float):\n            if not val.is_integer():\n                continue\n            n = int(val)\n        else:\n            n = val\n        # Must be greater than 10\n        if n <= 10:\n            continue\n        n_abs_str = str(abs(n))\n        # Extract first and last digits\n        first_digit = int(n_abs_str[0])\n        last_digit = int(n_abs_str[-1])\n        if (first_digit % 2 == 1) and (last_digit % 2 == 1):\n            count += 1\n    return count"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings to keep only even-length words, then sorts them by length and alphabetically.\"\"\"\n    # Filter out strings with odd lengths.\n    filtered_list = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort the filtered list by length, then alphabetically for ties.\n    filtered_list.sort(key=lambda s: (len(s), s))\n\n    return filtered_list"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planet names between planet1 and planet2, sorted by proximity to the Sun.\n    Returns an empty tuple if either planet name is incorrect.\n    \"\"\"\n    planets_ordered = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n\n    try:\n        idx1 = planets_ordered.index(planet1)\n        idx2 = planets_ordered.index(planet2)\n    except ValueError:\n        return ()\n\n    start_slice_idx = min(idx1, idx2)\n    end_slice_idx = max(idx1, idx2)\n\n    result_planets = planets_ordered[start_slice_idx + 1:end_slice_idx]\n\n    return tuple(result_planets)"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) with i<j<k such that a[i]+a[j]+a[k] is divisible by 3.\n    Elements a[i] = i*i - i + 1 are 0 mod 3 when i % 3 == 2, and 1 mod 3 otherwise.\n    \"\"\"\n    def comb3(x):\n        if x < 3:\n            return 0\n        return x * (x - 1) * (x - 2) // 6\n\n    base = n // 3\n    rem = n % 3\n    # c0: count of elements congruent to 0 mod 3 (i % 3 == 2)\n    c0 = base + (1 if rem >= 2 else 0)\n    # c1: count of elements congruent to 1 mod 3 (the rest)\n    c1 = n - c0\n\n    # Valid triples are all-zeros and all-ones residues\n    return comb3(c0) + comb3(c1)"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets whose orbits lie between planet1 and planet2,\n    sorted by proximity to the Sun. Returns an empty tuple if inputs are invalid or identical.\n    \"\"\"\n    planets = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n    index_map = {p.lower(): idx for idx, p in enumerate(planets)}\n\n    if not isinstance(planet1, str) or not isinstance(planet2, str):\n        return ()\n\n    p1_key = planet1.strip().lower()\n    p2_key = planet2.strip().lower()\n\n    if p1_key not in index_map or p2_key not in index_map:\n        return ()\n\n    i1 = index_map[p1_key]\n    i2 = index_map[p2_key]\n\n    if i1 == i2:\n        return ()\n\n    min_idx = min(i1, i2)\n    max_idx = max(i1, i2)\n\n    return tuple(planets[min_idx + 1 : max_idx])"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    def comb3(x):\n        if x < 3:\n            return 0\n        return x * (x - 1) * (x - 2) // 6\n\n    q = n // 3\n    r = n % 3\n\n    # c0: Count of elements a[i] congruent to 0 mod 3 (i % 3 == 2)\n    c0 = q + (1 if r >= 2 else 0)\n\n    # c1: Count of elements a[i] congruent to 1 mod 3 (i % 3 == 0 or 1)\n    c1 = n - c0\n\n    return comb3(c0) + comb3(c1)"}
