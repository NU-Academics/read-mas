{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n\n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    if not text:\n        return text\n\n    res = []\n    i = 0\n    n = len(text)\n    while i < n:\n        if text[i] == ' ':\n            j = i\n            while j < n and text[j] == ' ':\n                j += 1\n            run_len = j - i\n            if run_len > 2:\n                res.append('-')\n            else:\n                res.append('_' * run_len)\n            i = j\n        else:\n            res.append(text[i])\n            i += 1\n    return ''.join(res)"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Simplifies the expression x * n, returning True if the product is a whole number, False otherwise.\n    x and n are string representations of fractions \"numerator/denominator\".\n    \"\"\"\n    def _gcd(a, b):\n        \"\"\"Calculates the greatest common divisor of two numbers.\"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\n    num_x, den_x = map(int, x.split('/'))\n    num_n, den_n = map(int, n.split('/'))\n\n    # Simplify fraction x\n    common_x = _gcd(num_x, den_x)\n    num_x //= common_x\n    den_x //= common_x\n\n    # Simplify fraction n\n    common_n = _gcd(num_n, den_n)\n    num_n //= common_n\n    den_n //= common_n\n\n    # Cross-cancellation between numerator of x and denominator of n\n    common_cross1 = _gcd(num_x, den_n)\n    num_x //= common_cross1\n    den_n //= common_cross1\n\n    # Cross-cancellation between numerator of n and denominator of x\n    common_cross2 = _gcd(num_n, den_x)\n    num_n //= common_cross2\n    den_x //= common_cross2\n\n    # If the combined denominator is 1, the product is a whole number\n    return (den_x * den_n) == 1"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and remaining after a meal.\n    The rabbit eats as many carrots as needed, or all remaining if insufficient.\n    \"\"\"\n    carrots_eaten_in_this_meal = min(need, remaining)\n    total_eaten = number + carrots_eaten_in_this_meal\n    carrots_left = remaining - carrots_eaten_in_this_meal\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates total carrots eaten and remaining after a meal.\n    If not enough remaining, eats all available carrots.\n    \"\"\"\n    if remaining >= need:\n        total_eaten_after_meals = number + need\n        remaining_after_meals = remaining - need\n    else:  # remaining < need\n        total_eaten_after_meals = number + remaining\n        remaining_after_meals = 0\n\n    return [total_eaten_after_meals, remaining_after_meals]"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    \"\"\"\n    import math\n\n    try:\n        s1 = float(a)\n        s2 = float(b)\n        s3 = float(c)\n    except (TypeError, ValueError):\n        return False\n\n    # Reject NaN or infinite values\n    if not (math.isfinite(s1) and math.isfinite(s2) and math.isfinite(s3)):\n        return False\n\n    # Sides must be positive\n    if s1 <= 0 or s2 <= 0 or s3 <= 0:\n        return False\n\n    # Sort sides so the largest is last\n    sides = sorted((s1, s2, s3))\n    if sides[0] + sides[1] <= sides[2]:\n        return False\n\n    lhs = sides[0] * sides[0] + sides[1] * sides[1]\n    rhs = sides[2] * sides[2]\n\n    return math.isclose(lhs, rhs, rel_tol=1e-9, abs_tol=1e-12)"}
{"task_id": "HumanEval/111", "solution": "def histogram(test):\n    \"\"\"Given a string representing space separated lowercase letters, return a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\n\n    Example:\n    histogram('a b c') == {'a': 1, 'b': 1, 'c': 1}\n    histogram('a b b a') == {'a': 2, 'b': 2}\n    histogram('a b c a b') == {'a': 2, 'b': 2}\n    histogram('b b b b a') == {'b': 4}\n    histogram('') == {}\n    \"\"\"\n    tokens = test.split()\n    if not tokens:\n        return {}\n    from collections import Counter\n    counts = Counter(tokens)\n    max_count = max(counts.values())\n    return {k: v for k, v in counts.items() if v == max_count}"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"Calculate the Mean Absolute Deviation (MAD) around the mean.\n\n    MAD = average(|x - mean|) for x in numbers.\n\n    Raises:\n        ValueError: if numbers is empty.\n        TypeError: if any element in numbers is not int or float.\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"numbers must contain at least one element\")\n\n    n = len(numbers)\n    total = 0.0\n    for x in numbers:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"all elements of numbers must be int or float\")\n        total += x\n\n    mean = total / n\n\n    sum_abs_diff = 0.0\n    for x in numbers:\n        sum_abs_diff += abs(x - mean)\n\n    return sum_abs_diff / n"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits a string based on whitespace, then commas, otherwise counts specific lowercase letters.\n    Returns a list of words or an integer count.\n    \"\"\"\n    if any(c.isspace() for c in txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    count += 1\n        return count"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel from the right that is strictly between two consonants.\n    Vowels at the beginning or end of the word do not count.\n    \"\"\"\n    vowels = set('aeiouAEIOU')\n    n = len(word)\n\n    if n < 3:\n        return ''\n\n    # Iterate from the second to last character down to the second character\n    for i in range(n - 2, 0, -1):\n        ch = word[i]\n        if ch in vowels:\n            left_neighbor = word[i - 1]\n            right_neighbor = word[i + 1]\n            # Check if both neighbors are consonants\n            if left_neighbor not in vowels and right_neighbor not in vowels:\n                return ch\n    return ''"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for x in arr:\n        if x == 0:\n            product_of_signs = 0\n        elif x < 0:\n            product_of_signs *= -1\n\n        sum_of_magnitudes += abs(x)\n\n    return sum_of_magnitudes * product_of_signs"}
{"task_id": "HumanEval/105", "solution": "DIGIT_NAMES = (None, 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine')\ndef by_length(arr):\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name.\n    \"\"\"\n    if not arr:\n        return []\n\n    filtered_values = []\n    for x in arr:\n        # Strictly check for int type and range to exclude booleans and out-of-range numbers.\n        if type(x) is int and 1 <= x <= 9:\n            filtered_values.append(x)\n\n    # Sort the valid integers in ascending order.\n    sorted_ascending = sorted(filtered_values)\n\n    # Reverse the sorted list to get descending order.\n    sorted_descending = sorted_ascending[::-1]\n\n    # Map each digit to its English name.\n    result = []\n    for digit in sorted_descending:\n        result.append(DIGIT_NAMES[digit])\n\n    return result"}
