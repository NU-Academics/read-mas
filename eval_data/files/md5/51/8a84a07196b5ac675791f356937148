{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by shifting each English letter forward by 4 positions, wrapping around.\n    Non-alphabetic characters remain unchanged.\"\"\"\n    result = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            shifted_char = chr(((ord(char) - ord('a') + 4) % 26) + ord('a'))\n            result.append(shifted_char)\n        elif 'A' <= char <= 'Z':\n            shifted_char = chr(((ord(char) - ord('A') + 4) % 26) + ord('A'))\n            result.append(shifted_char)\n        else:\n            result.append(char)\n    return \"\".join(result)"}
{"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S):\n    \"\"\"\n    Counts sentences starting with 'I'. Sentences are delimited by '.', '?', or '!'.\n    Handles optional leading punctuation and punctuation attached to 'I'.\n    \"\"\"\n    boredom_count = 0\n\n    # 1. Split the input S into sentence fragments using the delimiters '.', '?', '!'\n    fragments = re.split(r'[.!?]', S)\n\n    # Set of characters considered as leading opening punctuation\n    leading_opening_punct = set(['\"', \"'\", '\u201c', '\u201d', '\u2018', '\u2019', '(', '[', '{'])\n\n    # String of punctuation characters to strip from ends of the first word for comparison\n    word_end_punct_chars = \"\\\"'(),.:;!?\"\n\n    for fragment in fragments:\n        # 2a. Strip leading and trailing whitespace from the fragment.\n        cleaned_fragment = fragment.strip()\n\n        # 2b. If empty after stripping, continue to the next fragment.\n        if not cleaned_fragment:\n            continue\n\n        # 2c. Remove any leading opening punctuation characters and additional whitespace.\n        while cleaned_fragment and cleaned_fragment[0] in leading_opening_punct:\n            cleaned_fragment = cleaned_fragment[1:].lstrip()\n\n        # Strip again to handle any whitespace that might appear after removing leading punctuation\n        cleaned_fragment = cleaned_fragment.strip()\n\n        # 2d. Split the cleaned fragment into words by whitespace.\n        words = cleaned_fragment.split()\n\n        # Check if there's at least one word in the fragment\n        if words:\n            first_word = words[0]\n\n            # Strip surrounding punctuation characters from the first word before comparison.\n            cleaned_first_word = first_word.strip(word_end_punct_chars)\n\n            # If the cleaned first word equals 'I' (exact match, case-sensitive), increment count.\n            if cleaned_first_word == 'I':\n                boredom_count += 1\n\n    return boredom_count"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    import re\n    # Match start of string or a sentence delimiter, optional spaces/leading quotes/brackets,\n    # then an uppercase I optionally followed by an ASCII or unicode apostrophe + m (I'm / I\u2019m).\n    pattern = re.compile(r'(?:^|[.?!])\\s*[\\'\"\u201c\u201d\u2018\u2019\\)\\]\\}]*\\s*I(?:[\\'\u2019]m)?\\b')\n    return len(pattern.findall(S))"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    \"\"\"\n    Create a function that takes 3 numbers.\n    Returns True if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns False otherwise.\n    \"\"\"\n    def is_whole_number(n):\n        return isinstance(n, int) or (isinstance(n, float) and n.is_integer())\n\n    if not (is_whole_number(x) and is_whole_number(y) and is_whole_number(z)):\n        return False\n\n    xi, yi, zi = int(x), int(y), int(z)\n    return xi == yi + zi or yi == xi + zi or zi == xi + yi"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    \"\"\"\n    Return True if one of the numbers equals the sum of the other two AND\n    all three values are integer-valued numbers (ints or floats that represent integers).\n    Booleans are not considered integers for this check.\n    \"\"\"\n    # Exclude booleans and require numeric types (int or float)\n    def is_numeric_nonbool(v):\n        return isinstance(v, (int, float)) and not isinstance(v, bool)\n\n    if not (is_numeric_nonbool(x) and is_numeric_nonbool(y) and is_numeric_nonbool(z)):\n        return False\n\n    # Check that values are mathematically integers\n    def is_integer_valued(v):\n        return isinstance(v, int) or (isinstance(v, float) and v.is_integer())\n\n    if not (is_integer_valued(x) and is_integer_valued(y) and is_integer_valued(z)):\n        return False\n\n    xi, yi, zi = int(x), int(y), int(z)\n    return xi == yi + zi or yi == xi + zi or zi == xi + yi"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Finds the largest prime number in the list and returns the sum of its digits.\"\"\"\n    def is_prime(n):\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def sum_digits(n):\n        s = 0\n        while n > 0:\n            s += n % 10\n            n //= 10\n        return s\n\n    largest_prime = -1\n    for num in lst:\n        if is_prime(num) and num > largest_prime:\n            largest_prime = num\n\n    if largest_prime == -1:\n        return 0\n\n    return sum_digits(largest_prime)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Find the largest prime in lst and return the sum of its digits.\n    If no prime is found, return 0.\n    \"\"\"\n    def is_prime(n):\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    def sum_digits(n):\n        n = abs(n)\n        s = 0\n        while n:\n            s += n % 10\n            n //= 10\n        return s\n\n    largest_prime = -1\n    for num in lst:\n        if is_prime(num) and num > largest_prime:\n            largest_prime = num\n\n    if largest_prime == -1:\n        return 0\n    return sum_digits(largest_prime)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    for key in dict:\n        if not isinstance(key, str):\n            return False\n\n    all_lower = all(key.islower() for key in dict)\n    all_upper = all(key.isupper() for key in dict)\n    return all_lower or all_upper"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping letter cases and shifting vowels.\n    Vowels are replaced by the letter 2 positions ahead, preserving case.\n    \"\"\"\n    transformed_chars = []\n    vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    for c in message:\n        if c.isalpha():\n            swapped = c.swapcase()\n            if swapped.lower() in vowels:\n                base = ord('A') if swapped.isupper() else ord('a')\n                index = ord(swapped) - base\n                new_index = (index + 2) % 26\n                replaced = chr(base + new_index)\n                transformed_chars.append(replaced)\n            else:\n                transformed_chars.append(swapped)\n        else:\n            transformed_chars.append(c)\n\n    return \"\".join(transformed_chars)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    Examples:\n    check_dict_case({\"a\":\"apple\", \"b\":\"banana\"}) should return True.\n    check_dict_case({\"a\":\"apple\", \"A\":\"banana\", \"B\":\"banana\"}) should return False.\n    check_dict_case({\"a\":\"apple\", 8:\"banana\", \"a\":\"apple\"}) should return False.\n    check_dict_case({\"Name\":\"John\", \"Age\":\"36\", \"City\":\"Houston\"}) should return False.\n    check_dict_case({\"STATE\":\"NC\", \"ZIP\":\"12345\" }) should return True.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lower = True\n    all_upper = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n        if key != key.lower():\n            all_lower = False\n\n        if key != key.upper():\n            all_upper = False\n\n        if not all_lower and not all_upper:\n            return False\n\n    return all_lower or all_upper"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"\n    Return a list of all prime numbers strictly less than n using the Sieve of Eratosthenes.\n    \"\"\"\n    if n <= 2:\n        return []\n\n    is_prime = [True] * n\n    is_prime[0] = is_prime[1] = False\n\n    limit = int(n**0.5) + 1\n    for p in range(2, limit):\n        if is_prime[p]:\n            start = p * p\n            for multiple in range(start, n, p):\n                is_prime[multiple] = False\n\n    return [i for i, prime in enumerate(is_prime) if prime]"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"\n    Finds all prime numbers less than n using the Sieve of Eratosthenes.\n    Returns a list of these prime numbers in ascending order.\n    \"\"\"\n    if n <= 2:\n        return []\n\n    # Initialize a boolean array 'is_prime' where is_prime[i] is True if i is potentially prime.\n    is_prime = [True] * n\n    is_prime[0] = is_prime[1] = False\n\n    # Apply the Sieve of Eratosthenes algorithm.\n    p = 2\n    while p * p < n:\n        if is_prime[p]:\n            for multiple in range(p * p, n, p):\n                is_prime[multiple] = False\n        p += 1\n\n    # Collect all numbers for which is_prime is True.\n    primes = [i for i in range(n) if is_prime[i]]\n    return primes"}
