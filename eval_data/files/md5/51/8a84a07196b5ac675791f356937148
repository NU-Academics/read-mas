{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"a and b must be integers\")\n\n    lo = min(a, b)\n    hi = max(a, b)\n\n    # Return even single-digit numbers (0, 2, 4, 6, 8) that fall within [lo, hi].\n    return [d for d in (0, 2, 4, 6, 8) if lo <= d <= hi]"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    start = min(a, b)\n    end = max(a, b)\n\n    result = []\n    for num in range(start, end + 1):\n        if num % 2 == 0 and num < 10:\n            result.append(num)\n\n    return result"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list) -> list:\n    \"\"\"Return a new list where elements at indices divisible by three are sorted among themselves,\n    while all other elements remain in their original positions.\n    \"\"\"\n    if not l:\n        return []\n\n    # Collect elements at indices divisible by 3\n    third_elements = [l[i] for i in range(0, len(l), 3)]\n    third_elements.sort()\n\n    # Build result as a shallow copy and replace those indices with sorted values\n    result = l.copy()\n    for idx, i in enumerate(range(0, len(result), 3)):\n        result[i] = third_elements[idx]\n\n    return result"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\"Input are two strings a and b consisting only of '1' and '0' characters.\n    Perform binary XOR on these inputs and return result also as a string.\n\n    Behavior:\n    - Both inputs must be strings containing only '0' and '1'.\n    - Both inputs must be of equal length; otherwise a ValueError is raised.\n    - Empty strings are allowed (returns empty string).\n\n    Examples:\n    >>> string_xor('010', '110')\n    '100'\n    >>> string_xor('', '')\n    ''\n    \"\"\"\n    if not isinstance(a, str) or not isinstance(b, str):\n        raise TypeError(\"Both inputs must be strings.\")\n    if len(a) != len(b):\n        raise ValueError(\"Inputs must have the same length.\")\n    valid_chars = {'0', '1'}\n    if any(ch not in valid_chars for ch in a) or any(ch not in valid_chars for ch in b):\n        raise ValueError(\"Inputs must contain only '0' and '1' characters.\")\n    return ''.join('1' if x != y else '0' for x, y in zip(a, b))"}
{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\"For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\"\"\"\n    flipped_chars = []\n    for char in string:\n        if char.islower():\n            flipped_chars.append(char.upper())\n        elif char.isupper():\n            flipped_chars.append(char.lower())\n        else:\n            flipped_chars.append(char)\n    return \"\".join(flipped_chars)"}
