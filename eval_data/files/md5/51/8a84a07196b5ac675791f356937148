{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Return the class name concatenated with the strongest extension.\n\n    Strength of an extension = number of uppercase letters - number of lowercase letters.\n    If multiple extensions have the same strength, the earliest in the list is chosen.\n    \"\"\"\n    if not isinstance(class_name, str):\n        raise TypeError(\"class_name must be a string\")\n    if not isinstance(extensions, (list, tuple)):\n        raise TypeError(\"extensions must be a list or tuple of strings\")\n    if len(extensions) == 0:\n        raise ValueError(\"extensions must contain at least one extension\")\n\n    def strength(name):\n        if not isinstance(name, str):\n            raise TypeError(\"each extension must be a string\")\n        caps = sum(1 for c in name if c.isupper())\n        lowers = sum(1 for c in name if c.islower())\n        return caps - lowers\n\n    best_ext = extensions[0]\n    max_strength = strength(best_ext)\n\n    for ext in extensions[1:]:\n        curr_strength = strength(ext)\n        if curr_strength > max_strength:\n            max_strength = curr_strength\n            best_ext = ext\n\n    return f\"{class_name}.{best_ext}\""}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer, return a tuple (even_count, odd_count) of digit counts.\n\n    Examples:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    if not isinstance(num, int):\n        raise TypeError(\"num must be an integer\")\n\n    even_count = 0\n    odd_count = 0\n    for ch in str(abs(num)):\n        if ch in \"02468\":\n            even_count += 1\n        else:\n            odd_count += 1\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Converts a positive integer to its lowercase Roman numeral equivalent.\n    Supports numbers from 1 to 1000 using a greedy subtractive algorithm.\n    \"\"\"\n    roman_map = [\n        (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n        (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n        (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'), (1, 'i')\n    ]\n\n    result = []\n    for value, symbol in roman_map:\n        while number >= value:\n            result.append(symbol)\n            number -= value\n    return \"\".join(result)"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Counts even and odd digits in an integer.\n\n    Returns a tuple with the number of even and odd digits, respectively.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    num = abs(num)  # Convert to positive to process digits\n\n    if num == 0:  # Special case for 0\n        return (1, 0)\n\n    while num > 0:\n        digit = num % 10\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n        num //= 10\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Converts a positive integer (1-1000) to its lowercase Roman numeral equivalent.\n    This implementation uses a greedy approach with a predefined mapping.\n    \"\"\"\n    roman_map = [\n        (1000, \"m\"), (900, \"cm\"), (500, \"d\"), (400, \"cd\"),\n        (100, \"c\"), (90, \"xc\"), (50, \"l\"), (40, \"xl\"),\n        (10, \"x\"), (9, \"ix\"), (5, \"v\"), (4, \"iv\"), (1, \"i\")\n    ]\n    result = \"\"\n\n    # Iterate through the Roman numeral map to greedily build the string.\n    for value, symbol in roman_map:\n        while number >= value:\n            result += symbol\n            number -= value\n    return result"}
