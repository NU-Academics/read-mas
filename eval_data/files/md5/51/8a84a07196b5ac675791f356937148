{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Return True if there exists integer k >= 0 such that n**k == x, otherwise False.\"\"\"\n    # Handle x == 1: n**0 == 1 for any n (including n == 0 by this function's convention)\n    if x == 1:\n        return True\n\n    # Special cases for n\n    if n == 1:\n        return False  # 1**k == 1 only, and x != 1 here\n    if n == -1:\n        return x == -1  # (-1)**k is either 1 (k even) or -1 (k odd); x==1 handled above\n    if n == 0:\n        return x == 0  # 0**k (k>=1) == 0; x==1 handled above\n\n    # If x == 0 and n not 0, cannot be a power\n    if x == 0:\n        return False\n\n    current = 1\n    # Multiply until magnitude exceeds that of x\n    while abs(current) <= abs(x):\n        if current == x:\n            return True\n        current *= n\n    return False"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"Checks if a string is happy based on length and distinct consecutive letters.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct.\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        # Check if the three consecutive letters at s[i], s[i+1], s[i+2] are all distinct.\n        if not (s[i] != s[i+1] and s[i] != s[i+2] and s[i+1] != s[i+2]):\n            return False\n\n    return True"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Map a list of numerical GPAs to letter grades.\n\n    Args:\n        grades: Iterable of numbers (int/float) representing GPAs.\n\n    Returns:\n        List of single-string letter grades corresponding to each GPA.\n\n    Raises:\n        TypeError: if `grades` is not iterable or contains non-numeric/boolean values.\n        ValueError: if a GPA is NaN/inf or outside the valid range [0.0, 4.0] (with tiny tolerance).\n    \"\"\"\n    import math\n\n    EPS = 1e-9\n\n    # Validate input is iterable\n    try:\n        iterator = iter(grades)\n    except TypeError:\n        raise TypeError(\"grades must be an iterable of numbers\")\n\n    # Thresholds in descending order: (threshold, letter) meaning \"greater than threshold -> letter\"\n    thresholds = [\n        (3.7, \"A\"),\n        (3.3, \"A-\"),\n        (3.0, \"B+\"),\n        (2.7, \"B\"),\n        (2.3, \"B-\"),\n        (2.0, \"C+\"),\n        (1.7, \"C\"),\n        (1.3, \"C-\"),\n        (1.0, \"D+\"),\n        (0.7, \"D\"),\n        (0.0, \"D-\"),\n    ]\n\n    out = []\n    for idx, value in enumerate(iterator):\n        # Exclude booleans (bool is subclass of int)\n        if isinstance(value, bool):\n            raise TypeError(f\"grade at index {idx} is a boolean, expected a numeric GPA\")\n\n        # Ensure numeric\n        if not isinstance(value, (int, float)):\n            raise TypeError(f\"grade at index {idx} is not a number\")\n\n        gpa = float(value)\n\n        # Reject NaN or infinite values\n        if not math.isfinite(gpa):\n            raise ValueError(f\"grade at index {idx} is not a finite number\")\n\n        # Out-of-range checks with tolerance\n        if gpa < -EPS:\n            raise ValueError(f\"grade at index {idx} is negative and out of valid range [0.0, 4.0]\")\n        if gpa > 4.0 + EPS:\n            raise ValueError(f\"grade at index {idx} exceeds maximum valid GPA of 4.0\")\n\n        # Treat values extremely close to 4.0 as exactly 4.0\n        if math.isclose(gpa, 4.0, abs_tol=EPS) or gpa > 4.0 - EPS:\n            out.append(\"A+\")\n            continue\n\n        # Sequentially test strict greater-than thresholds with tolerance\n        assigned = False\n        for thresh, letter in thresholds:\n            if gpa > thresh + EPS:\n                out.append(letter)\n                assigned = True\n                break\n\n        if assigned:\n            continue\n\n        # If we haven't assigned yet, the GPA is <= 0.0 + EPS\n        if math.isclose(gpa, 0.0, abs_tol=EPS):\n            out.append(\"E\")\n        else:\n            # Very small positive values that didn't exceed 0.0 + EPS should be D-\n            # (this branch is defensive; normally the thresholds loop would have caught >0.0)\n            out.append(\"D-\")\n\n    return out"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Returns True if the string's length is prime, False otherwise.\"\"\"\n    import math\n\n    n = len(string)\n\n    if n < 2:\n        return False\n\n    if n in (2, 3):\n        return True\n\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n\n    limit = math.isqrt(n)\n\n    i = 5\n    while i <= limit:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n\n    return True"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Convert a list of numeric GPAs into letter grades using the specified mapping.\n\n    Mapping rules:\n      - 4.0 -> 'A+'\n      - > 3.7 -> 'A'\n      - > 3.3 -> 'A-'\n      - > 3.0 -> 'B+'\n      - > 2.7 -> 'B'\n      - > 2.3 -> 'B-'\n      - > 2.0 -> 'C+'\n      - > 1.7 -> 'C'\n      - > 1.3 -> 'C-'\n      - > 1.0 -> 'D+'\n      - > 0.7 -> 'D'\n      - > 0.0 -> 'D-'\n      - 0.0 -> 'E'\n\n    Args:\n        grades: Iterable of numeric GPAs (int/float convertible).\n\n    Returns:\n        List of letter grade strings in the same order as input.\n\n    Raises:\n        TypeError: if any grade is not numeric / not convertible to float.\n    \"\"\"\n    thresholds = [\n        (3.7, 'A'),\n        (3.3, 'A-'),\n        (3.0, 'B+'),\n        (2.7, 'B'),\n        (2.3, 'B-'),\n        (2.0, 'C+'),\n        (1.7, 'C'),\n        (1.3, 'C-'),\n        (1.0, 'D+'),\n        (0.7, 'D'),\n        (0.0, 'D-'),\n    ]\n\n    result = []\n    for g in grades:\n        try:\n            gpa = float(g)\n        except Exception:\n            raise TypeError(f'GPA must be numeric, got {g!r}')\n\n        # Exact-special cases\n        if gpa == 4.0:\n            result.append('A+')\n            continue\n        if gpa == 0.0:\n            result.append('E')\n            continue\n\n        # Find first threshold that gpa is strictly greater than\n        for threshold, letter in thresholds:\n            if gpa > threshold:\n                result.append(letter)\n                break\n        else:\n            # For values <= 0.0 that are not exactly 0.0 (e.g., negative), treat as 'E'\n            result.append('E')\n\n    return result"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Checks if the length of a string is a prime number.\n    Returns True if the length is prime, False otherwise.\"\"\"\n    n = len(string)\n\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    i = 3\n    # Iterate from 3 up to the square root of n, checking only odd numbers.\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given an integer N, compute the sum of its decimal digits.\n    Return the sum encoded as a binary string, without leading zeros except for \"0\".\n    \"\"\"\n    # Validate input type\n    if not isinstance(N, int):\n        try:\n            N = int(N)\n        except Exception:\n            raise TypeError(\"N must be an integer or convertible to int\")\n    if N < 0:\n        raise ValueError(\"N must be non-negative\")\n\n    total_sum = sum(int(digit) for digit in str(N))\n    return bin(total_sum)[2:]"}
