{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Returns the word with the maximum number of unique characters.\n    If multiple words tie, the lexicographically smallest is returned.\n    \"\"\"\n    max_count = -1\n    candidates = []\n\n    for word in words:\n        count = len(set(word))\n        if count > max_count:\n            max_count = count\n            candidates = [word]\n        elif count == max_count:\n            candidates.append(word)\n\n    if not candidates:\n        return \"\"\n    return min(candidates)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Returns the word with the maximum number of unique characters.\n    If multiple words tie, returns the lexicographically smallest one.\n    Assumes `words` is an iterable of strings. If `words` is empty, returns \"\".\n    \"\"\"\n    # Validate input is iterable and contains strings\n    if words is None:\n        return \"\"\n    # Initialize\n    best_word = \"\"\n    best_count = -1\n\n    for word in words:\n        if not isinstance(word, str):\n            raise TypeError(\"All elements of 'words' must be strings\")\n        current_unique_count = len(set(word))\n\n        if current_unique_count > best_count:\n            best_count = current_unique_count\n            best_word = word\n        elif current_unique_count == best_count:\n            # Tie-break: choose lexicographically smaller word\n            if word < best_word:\n                best_word = word\n\n    return best_word"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    \"\"\"\n    Given three side lengths, return True if they form a right-angled triangle, False otherwise.\n\n    Validation and rules:\n    - Non-numeric inputs -> False\n    - Non-finite values (inf, nan) -> False\n    - Sides must be > 0\n    - Must satisfy triangle inequality (non-degenerate): sum of two smaller sides > largest side\n      (a near-equality due to floating-point error is treated as non-triangle)\n    - Uses math.isclose with relative and absolute tolerances to check the Pythagorean relation.\n    \"\"\"\n    import math\n\n    # Convert to floats, reject non-numeric\n    try:\n        a = float(a)\n        b = float(b)\n        c = float(c)\n    except (TypeError, ValueError):\n        return False\n\n    # Reject NaN or infinite values\n    if not (math.isfinite(a) and math.isfinite(b) and math.isfinite(c)):\n        return False\n\n    # All sides must be positive\n    if a <= 0 or b <= 0 or c <= 0:\n        return False\n\n    # Order sides so that s3 is the longest (hypotenuse candidate)\n    s1, s2, s3 = sorted((a, b, c))\n\n    # Tolerances for comparisons\n    rel_tol = 1e-9\n    abs_tol = 1e-12\n\n    # Check triangle inequality (treat near-equality as non-triangle / degenerate)\n    # If s1 + s2 is less than or very close to s3, it's not a valid (non-degenerate) triangle.\n    if (s1 + s2) <= s3 + max(rel_tol * s3, abs_tol):\n        return False\n\n    # Check Pythagorean theorem with tolerance\n    return math.isclose(s1 * s1 + s2 * s2, s3 * s3, rel_tol=rel_tol, abs_tol=abs_tol)"}
{"task_id": "HumanEval/160", "solution": "def _get_precedence(op_str):\n    if op_str in ('+', '-'):\n        return 1\n    elif op_str in ('*', '//'):\n        return 2\n    elif op_str == '**':\n        return 3\n    else:\n        raise ValueError(f\"Unknown operator: {op_str}\")\ndef _is_left_associative(op_str):\n    return op_str in ('+', '-', '*', '//')\ndef _apply_operator(op_str, left_val, right_val):\n    if op_str == '+':\n        return left_val + right_val\n    elif op_str == '-':\n        return left_val - right_val\n    elif op_str == '*':\n        return left_val * right_val\n    elif op_str == '//':\n        if right_val == 0:\n            raise ZeroDivisionError(\"division by zero\")\n        return left_val // right_val\n    elif op_str == '**':\n        return left_val ** right_val\n    else:\n        raise ValueError(f\"Unknown operator: {op_str}\")\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n    \"\"\"\n    if len(operator) != len(operand) - 1:\n        raise ValueError(\"operator list length must be one less than operand list length\")\n\n    # Validate operators\n    for op in operator:\n        _get_precedence(op)  # will raise ValueError on unknown operator\n\n    values = [operand[0]]\n    ops = []\n\n    for i, current_op in enumerate(operator):\n        next_operand = operand[i + 1]\n\n        while ops:\n            top_op = ops[-1]\n            top_prec = _get_precedence(top_op)\n            cur_prec = _get_precedence(current_op)\n\n            # Pop if top_op has higher precedence, or same precedence and current is left-assoc\n            if (top_prec > cur_prec) or (top_prec == cur_prec and _is_left_associative(current_op)):\n                ops.pop()\n                right = values.pop()\n                left = values.pop()\n                values.append(_apply_operator(top_op, left, right))\n            else:\n                break\n\n        ops.append(current_op)\n        values.append(next_operand)\n\n    while ops:\n        op_to_apply = ops.pop()\n        right = values.pop()\n        left = values.pop()\n        values.append(_apply_operator(op_to_apply, left, right))\n\n    return values[0]"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa,\n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    \"\"\"\n    if not any(ch.isalpha() for ch in s):\n        return s[::-1]\n    return ''.join(ch.swapcase() if ch.isalpha() else ch for ch in s)"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Evaluates an algebraic expression built from given operators and operands using Shunting-Yard.\n    Converts the infix expression to RPN and then evaluates the RPN expression.\n    \"\"\"\n    # Define operator precedence and associativity for Shunting-Yard.\n    _precedence = {'+': 1, '-': 1, '*': 2, '//': 2, '**': 3}\n    _right_associative = {'**': True}\n\n    def _get_precedence(op):\n        return _precedence.get(op, 0)\n\n    def _is_right_associative(op):\n        return _right_associative.get(op, False)\n\n    def _apply_op(op, b, a):\n        # Applies the given operator 'op' to operands 'a' and 'b' in correct order.\n        if op == '+':\n            return a + b\n        elif op == '-':\n            return a - b\n        elif op == '*':\n            return a * b\n        elif op == '//':\n            return a // b\n        elif op == '**':\n            return a ** b\n\n    # --- Shunting-Yard Algorithm: Convert infix expression to RPN ---\n    output_queue = []\n    operator_stack = []\n\n    # Create a single token stream from operands and operators\n    tokens = []\n    for i in range(len(operator)):\n        tokens.append(operand[i])\n        tokens.append(operator[i])\n    tokens.append(operand[len(operator)])  # Add the last operand\n\n    for token in tokens:\n        if isinstance(token, int):  # Token is an operand (number)\n            output_queue.append(token)\n        else:  # Token is an operator\n            o1 = token\n            # Pop operators from stack to output queue based on precedence and associativity\n            while (operator_stack and\n                   (_get_precedence(operator_stack[-1]) > _get_precedence(o1) or\n                    (_get_precedence(operator_stack[-1]) == _get_precedence(o1) and not _is_right_associative(o1)))):\n                output_queue.append(operator_stack.pop())\n            operator_stack.append(o1)\n\n    # Pop any remaining operators from the stack to the output queue\n    while operator_stack:\n        output_queue.append(operator_stack.pop())\n\n    # --- RPN Evaluation: Evaluate the RPN expression ---\n    operand_stack = []\n    for token in output_queue:\n        if isinstance(token, int):  # Token is an operand\n            operand_stack.append(token)\n        else:  # Token is an operator\n            b = operand_stack.pop()  # Second operand\n            a = operand_stack.pop()  # First operand\n            result = _apply_op(token, b, a)\n            operand_stack.append(result)\n\n    return operand_stack[0]"}
