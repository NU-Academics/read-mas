{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shifts digits of x to the right by shift, returning the result as a string.\n    If shift exceeds the number of digits, the digits are returned reversed.\"\"\"\n    is_negative = False\n    if x < 0:\n        is_negative = True\n        x = abs(x)\n\n    s = str(x)\n    n = len(s)\n\n    if n <= 1:\n        # For single-digit numbers (including \"0\"), circular shift or reverse has no effect.\n        # Preserve negative sign if original x was negative and not zero.\n        return ('-' if is_negative and s != '0' else '') + s\n\n    if shift > n:\n        shifted_s = s[::-1]  # Reverse the string\n    else:\n        effective_shift = shift % n\n        shifted_s = s[n - effective_shift:] + s[:n - effective_shift]\n\n    if is_negative:\n        return '-' + shifted_s\n    else:\n        return shifted_s"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circularly shifts the digits of integer x right by shift, returning a string. If shift exceeds the number of digits, the digits are returned reversed.\"\"\"\n    s = str(x)\n    n = len(s)\n\n    if shift > n:\n        return s[::-1]\n    else:\n        # Perform a circular right shift\n        return s[-shift:] + s[:-shift]"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"Computes the n-th FibFib number where:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3)\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    def multiply(A, B):\n        # Multiply two 3x3 matrices\n        return [\n            [\n                A[0][0] * B[0][0] + A[0][1] * B[1][0] + A[0][2] * B[2][0],\n                A[0][0] * B[0][1] + A[0][1] * B[1][1] + A[0][2] * B[2][1],\n                A[0][0] * B[0][2] + A[0][1] * B[1][2] + A[0][2] * B[2][2],\n            ],\n            [\n                A[1][0] * B[0][0] + A[1][1] * B[1][0] + A[1][2] * B[2][0],\n                A[1][0] * B[0][1] + A[1][1] * B[1][1] + A[1][2] * B[2][1],\n                A[1][0] * B[0][2] + A[1][1] * B[1][2] + A[1][2] * B[2][2],\n            ],\n            [\n                A[2][0] * B[0][0] + A[2][1] * B[1][0] + A[2][2] * B[2][0],\n                A[2][0] * B[0][1] + A[2][1] * B[1][1] + A[2][2] * B[2][1],\n                A[2][0] * B[0][2] + A[2][1] * B[1][2] + A[2][2] * B[2][2],\n            ],\n        ]\n\n    def matrix_pow(M, p):\n        # Exponentiation by squaring for 3x3 matrix\n        result = [[1, 0, 0], [0, 1, 0], [0, 0, 1]]  # identity\n        base = M\n        while p > 0:\n            if p & 1:\n                result = multiply(result, base)\n            base = multiply(base, base)\n            p >>= 1\n        return result\n\n    # Transition matrix for F(n) = F(n-1) + F(n-2) + F(n-3)\n    T = [\n        [1, 1, 1],\n        [1, 0, 0],\n        [0, 1, 0],\n    ]\n\n    # F(n) = (T^(n-2) * [F(2),F(1),F(0)])[0] and [F(2),F(1),F(0)] = [1,0,0]\n    pow_T = matrix_pow(T, n - 2)\n    return pow_T[0][0]"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Count vowels in a string, with 'y' counting only if it's the last character.\n    Input non-strings are converted to string representation.\"\"\"\n\n    # Coerce input to string and convert to lowercase for case-insensitive matching.\n    s_lower = str(s).lower()\n\n    count = 0\n    vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    # Handle empty string early.\n    if not s_lower:\n        return 0\n\n    # Iterate through characters to count vowels.\n    for i, char in enumerate(s_lower):\n        if char in vowels:\n            count += 1\n        elif char == 'y' and i == len(s_lower) - 1:\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"The FibFib number sequence:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3)\n    Efficient computation via 3x3 matrix exponentiation.\n    \"\"\"\n    # Input validation\n    if not isinstance(n, int) or isinstance(n, bool):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    # Base cases\n    if n == 0 or n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    def _mat_mult(A, B):\n        \"\"\"Multiply two 3x3 matrices A and B.\"\"\"\n        return [\n            [\n                A[0][0] * B[0][j] + A[0][1] * B[1][j] + A[0][2] * B[2][j]\n                for j in range(3)\n            ],\n            [\n                A[1][0] * B[0][j] + A[1][1] * B[1][j] + A[1][2] * B[2][j]\n                for j in range(3)\n            ],\n            [\n                A[2][0] * B[0][j] + A[2][1] * B[1][j] + A[2][2] * B[2][j]\n                for j in range(3)\n            ],\n        ]\n\n    def _mat_pow(M, p):\n        \"\"\"Raise 3x3 matrix M to integer power p using exponentiation by squaring.\"\"\"\n        # Identity matrix\n        result = [[1, 0, 0], [0, 1, 0], [0, 0, 1]]\n        base = M\n        while p > 0:\n            if p & 1:\n                result = _mat_mult(result, base)\n            base = _mat_mult(base, base)\n            p >>= 1\n        return result\n\n    # Companion matrix for the recurrence\n    M = [[1, 1, 1], [1, 0, 0], [0, 1, 0]]\n\n    # v_n = M^(n-2) * v_2, where v_2 = [1,0,0]^T -> F(n) is P[0][0]\n    P = _mat_pow(M, n - 2)\n    return P[0][0]"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Return the sum of ASCII codes for ASCII uppercase characters in the input string.\n\n    Only characters 'A' through 'Z' are considered uppercase for this function.\n    \"\"\"\n    if not s:\n        return 0\n    total = 0\n    for ch in s:\n        if 'A' <= ch <= 'Z':\n            total += ord(ch)\n    return total"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even-valued node and its index in an array.\n    Returns [smallest_value, index] or [] if no even numbers or array is empty.\n    \"\"\"\n    best_value = None\n    best_index = None\n\n    for i, v in enumerate(arr):\n        if v % 2 == 0:\n            if best_value is None or v < best_value:\n                best_value = v\n                best_index = i\n\n    if best_value is None:\n        return []\n    return [best_value, best_index]"}
{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s, n):\n    \"\"\"\n    Given a string describing numbers of apples and oranges (e.g. \"5 apples and 6 oranges\")\n    and the total number of fruits n, return the number of mangoes:\n        mangoes = n - apples - oranges\n\n    Raises ValueError for invalid inputs or if n < apples + oranges.\n    \"\"\"\n    import re\n\n    if not isinstance(s, str):\n        raise ValueError(\"s must be a string\")\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n\n    s = s.strip()\n\n    # Try to find explicit apple and orange counts by matching number before \"apple\" and \"orange\"\n    m_apples = re.search(r'(\\d+)\\s*appl', s, flags=re.IGNORECASE)\n    m_oranges = re.search(r'(\\d+)\\s*orang', s, flags=re.IGNORECASE)\n\n    if m_apples and m_oranges:\n        apples = int(m_apples.group(1))\n        oranges = int(m_oranges.group(1))\n    else:\n        # Fallback: extract the first two integers found in the string\n        nums = re.findall(r'\\d+', s)\n        if len(nums) >= 2:\n            apples, oranges = int(nums[0]), int(nums[1])\n        else:\n            raise ValueError(\"Could not parse apple and orange counts from string\")\n\n    if apples < 0 or oranges < 0:\n        raise ValueError(\"Apple and orange counts must be non-negative integers\")\n    if n < apples + oranges:\n        raise ValueError(\"Total fruits n is less than the sum of apples and oranges\")\n\n    return n - apples - oranges"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    \"\"\"\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than\n    zero, and has a frequency greater than or equal to the value of the integer itself.\n    If no such a value exist, return -1.\n    \"\"\"\n    from collections import Counter\n\n    if not lst:\n        return -1\n\n    freq = Counter(lst)\n    # Consider only positive integers and check from largest to smallest\n    for num in sorted((n for n in freq.keys() if n > 0), reverse=True):\n        if freq[num] >= num:\n            return num\n    return -1"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even non-negative integer and its index in an array.\n    Returns [value, index] or [] if no even numbers are found.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n\n    if smallest_even_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/69", "solution": "import collections\ndef search(lst):\n    '''\n    Returns the greatest integer x (>0) such that its frequency in the list is >= x.\n    If no such integer exists, returns -1.\n    '''\n    if not lst:\n        return -1\n\n    counts = collections.Counter(lst)\n    result = -1\n\n    for value, count in counts.items():\n        if value > 0 and count >= value:\n            result = max(result, value)\n\n    return result"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s, n):\n    \"\"\"\n    Parses a string for apple and orange counts, computes mangoes.\n    Handles various parsing strategies and raises ValueError if ambiguous.\n    \"\"\"\n\n    if not isinstance(s, str) or not isinstance(n, int):\n        raise TypeError(\"s must be a str and n must be an int\")\n\n    # 1. Primary Parsing: Find all integers and their spans in the string.\n    all_integers_matches = []\n    for m in re.finditer(r\"[+-]?\\d+\", s):\n        all_integers_matches.append((m.group(0), m.start(), m.end()))\n\n    apples_val_str = None\n    oranges_val_str = None\n    apples_num_start_idx = -1\n    oranges_num_start_idx = -1\n    used_num_spans = set()\n\n    # Primary Rule: If exactly two integers, interpret as apples, then oranges.\n    if len(all_integers_matches) == 2:\n        apples_val_str = all_integers_matches[0][0]\n        oranges_val_str = all_integers_matches[1][0]\n        apples_num_start_idx = all_integers_matches[0][1]\n        oranges_num_start_idx = all_integers_matches[1][1]\n    else:\n        # Secondary Parsing: Use keyword patterns if not exactly two general integers.\n        keyword_apple_nums = []\n        keyword_orange_nums = []\n\n        # Find numbers associated with 'apple(s)' and 'orange(s)'\n        # Pattern: Number before word (e.g., \"5 apples\", \"10 oranges\")\n        for m in re.finditer(r\"([+-]?\\d+)\\s*(apples?)\", s, re.IGNORECASE):\n            keyword_apple_nums.append((m.group(1), m.start(1), m.end(1)))\n        for m in re.finditer(r\"([+-]?\\d+)\\s*(oranges?)\", s, re.IGNORECASE):\n            keyword_orange_nums.append((m.group(1), m.start(1), m.end(1)))\n\n        # Pattern: Word before number (e.g., \"apples: 5\", \"oranges 10\")\n        for m in re.finditer(r\"apples?\\s*[:]?\\s*([+-]?\\d+)\", s, re.IGNORECASE):\n            keyword_apple_nums.append((m.group(1), m.start(1), m.end(1)))\n        for m in re.finditer(r\"oranges?\\s*[:]?\\s*([+-]?\\d+)\", s, re.IGNORECASE):\n            keyword_orange_nums.append((m.group(1), m.start(1), m.end(1)))\n\n        # Step 3.1: If both apple and orange counts are found via keywords, use the first match for each.\n        if keyword_apple_nums:\n            apples_val_str = keyword_apple_nums[0][0]\n            apples_num_start_idx = keyword_apple_nums[0][1]\n            used_num_spans.add((keyword_apple_nums[0][1], keyword_apple_nums[0][2]))\n        if keyword_orange_nums:\n            oranges_val_str = keyword_orange_nums[0][0]\n            oranges_num_start_idx = keyword_orange_nums[0][1]\n            used_num_spans.add((keyword_orange_nums[0][1], keyword_orange_nums[0][2]))\n\n        # Step 3.2: If one fruit count is missing and other integers exist, use proximity assignment.\n        unmatched_integers = []\n        for val_str, s_idx, e_idx in all_integers_matches:\n            if (s_idx, e_idx) not in used_num_spans:\n                unmatched_integers.append((val_str, s_idx, e_idx))\n\n        if apples_val_str is None and oranges_val_str is not None and unmatched_integers:\n            # Apples are missing; find closest unmatched integer to the oranges count.\n            closest_match = None\n            min_dist = float('inf')\n            for val_str, s_idx, e_idx in unmatched_integers:\n                dist = abs(s_idx - oranges_num_start_idx)\n                if dist < min_dist:\n                    min_dist = dist\n                    closest_match = (val_str, s_idx, e_idx)\n            if closest_match:\n                apples_val_str = closest_match[0]\n                apples_num_start_idx = closest_match[1]\n                used_num_spans.add((closest_match[1], closest_match[2]))\n\n        elif oranges_val_str is None and apples_val_str is not None and unmatched_integers:\n            # Oranges are missing; find closest unmatched integer to the apples count.\n            closest_match = None\n            min_dist = float('inf')\n            for val_str, s_idx, e_idx in unmatched_integers:\n                dist = abs(s_idx - apples_num_start_idx)\n                if dist < min_dist:\n                    min_dist = dist\n                    closest_match = (val_str, s_idx, e_idx)\n            if closest_match:\n                oranges_val_str = closest_match[0]\n                oranges_num_start_idx = closest_match[1]\n                used_num_spans.add((closest_match[1], closest_match[2]))\n\n    # Step 4: Ambiguity Resolution. Raise error if parsing failed.\n    if apples_val_str is None or oranges_val_str is None:\n        raise ValueError(f\"Could not parse two fruit counts from input: {s}\")\n\n    # Convert extracted string values to integers.\n    apples = int(apples_val_str)\n    oranges = int(oranges_val_str)\n\n    # Computation: Calculate mango count.\n    mango_count = n - apples - oranges\n    return mango_count"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Given list of integers, return list in strange order:\n    start with the minimum value, then maximum of the remaining integers,\n    then minimum of the remaining, and so on.\n    \"\"\"\n    if not lst:\n        return []\n\n    sorted_lst = sorted(lst)\n    result = []\n    left, right = 0, len(sorted_lst) - 1\n    take_min = True\n\n    while left <= right:\n        if take_min:\n            result.append(sorted_lst[left])\n            left += 1\n        else:\n            result.append(sorted_lst[right])\n            right -= 1\n        take_min = not take_min\n\n    return result"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum changes needed to make an array palindromic.\n    It compares elements from both ends and counts mismatches.\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Sorts a list of integers in a strange order: min, max of remaining, min of remaining, and so on.\n    Uses a two-pointer approach on a sorted copy of the input list.\n    \"\"\"\n    if not lst:\n        return []\n\n    sorted_lst = sorted(lst)\n    result = []\n    left, right = 0, len(sorted_lst) - 1\n\n    while left <= right:\n        result.append(sorted_lst[left])\n        left += 1\n        if left <= right:\n            result.append(sorted_lst[right])\n            right -= 1\n    return result"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Finds the minimum number of elements to change to make the array palindromic.\n    It compares elements from both ends, incrementing a counter for each mismatch.\n    \"\"\"\n    changes = 0\n    n = len(arr)\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"\n    Return True if q is a palindromic sequence and the sum of its elements is <= w.\n    Raises TypeError for invalid inputs.\n    \"\"\"\n    from collections.abc import Sequence\n    import numbers\n\n    # Validate q is a sequence (but not a string/bytes)\n    if not isinstance(q, Sequence) or isinstance(q, (str, bytes)):\n        raise TypeError(\"q must be a sequence (e.g., list or tuple) of numeric values\")\n\n    # Validate w is numeric\n    if not isinstance(w, numbers.Real):\n        raise TypeError(\"w must be a real number\")\n\n    # Validate elements are numeric\n    for idx, el in enumerate(q):\n        if not isinstance(el, numbers.Real):\n            raise TypeError(f\"element at index {idx} is not a real number\")\n\n    # Palindrome (balanced) check\n    n = len(q)\n    for i in range(n // 2):\n        if q[i] != q[n - 1 - i]:\n            return False\n\n    # Sum check (weight)\n    return sum(q) <= w"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1.\n    \"\"\"\n    EPSILON = 1e-12\n\n    # 1) Input validation and coercion\n    try:\n        _a = float(a)\n        _b = float(b)\n        _c = float(c)\n    except (ValueError, TypeError):\n        return -1\n\n    if not (math.isfinite(_a) and math.isfinite(_b) and math.isfinite(_c)):\n        return -1\n\n    if _a <= 0 or _b <= 0 or _c <= 0:\n        return -1\n\n    # 2) Triangle validity checks (Triangle inequality)\n    # Using epsilon to ensure strict inequality and treat nearly degenerate triangles as invalid.\n    if not (_a + _b > _c + EPSILON and\n            _a + _c > _b + EPSILON and\n            _b + _c > _a + EPSILON):\n        return -1\n\n    # 3) Computation using Heron's formula\n    s = (_a + _b + _c) / 2.0\n    area_squared = s * (s - _a) * (s - _b) * (s - _c)\n\n    # 3.1) Numerical stability for area_squared\n    # If area_squared is less than or equal to epsilon, treat as degenerate (area 0).\n    # This covers truly 0, slightly negative due to float errors, or slightly positive but too small to be a non-degenerate triangle.\n    if area_squared <= EPSILON:\n        return -1\n    else:\n        area = math.sqrt(area_squared)\n        # 4) Rounding and return type\n        return round(area, 2)"}
{"task_id": "HumanEval/71", "solution": "def triangle_area(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle, return the area rounded to 2 decimal places\n    if the sides form a valid triangle; otherwise return -1.\n    \"\"\"\n    import math\n\n    try:\n        a = float(a)\n        b = float(b)\n        c = float(c)\n    except (TypeError, ValueError):\n        return -1\n\n    # Reject non-positive or non-finite values\n    if not (math.isfinite(a) and math.isfinite(b) and math.isfinite(c)):\n        return -1\n    if a <= 0 or b <= 0 or c <= 0:\n        return -1\n\n    # Triangle inequality: sum of any two sides must be greater than the third\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1\n\n    # Heron's formula with small-epsilon handling for floating-point errors\n    s = (a + b + c) / 2.0\n    val = s * (s - a) * (s - b) * (s - c)\n    eps = 1e-12\n    if val < 0:\n        if val > -eps:\n            val = 0.0\n        else:\n            return -1\n\n    area = math.sqrt(val)\n    return round(area, 2)"}
