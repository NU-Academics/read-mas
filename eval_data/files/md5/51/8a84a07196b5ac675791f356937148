{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Counts even and odd integer palindromes in the range [1, n] inclusive.\n    Returns a tuple (even_count, odd_count).\n    \"\"\"\n    even_palindromes = 0\n    odd_palindromes = 0\n\n    for i in range(1, n + 1):\n        s_i = str(i)\n        if s_i == s_i[::-1]:\n            if i % 2 == 0:\n                even_palindromes += 1\n            else:\n                odd_palindromes += 1\n\n    return (even_palindromes, odd_palindromes)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case and shifting vowels two places ahead.\n    Non-alphabetic characters are left unchanged.\n    \"\"\"\n    output_chars = []\n    for ch in message:\n        if not ch.isalpha():\n            output_chars.append(ch)\n        else:\n            swapped_char = ch.swapcase()\n            if swapped_char.lower() in 'aeiou':\n                # Determine the base character for shifting (a or A)\n                base_val = ord('a') if swapped_char.islower() else ord('A')\n                # Calculate the 0-based index of the character\n                offset = ord(swapped_char) - base_val\n                # Shift by 2, using modular arithmetic to handle potential wrapping (though not strictly needed for vowels +2)\n                shifted_offset = (offset + 2) % 26\n                # Convert back to character\n                shifted_char = chr(base_val + shifted_offset)\n                output_chars.append(shifted_char)\n            else:\n                output_chars.append(swapped_char)\n    return \"\".join(output_chars)"}
{"task_id": "HumanEval/99", "solution": "from decimal import Decimal, InvalidOperation, ROUND_HALF_UP\ndef closest_integer(value):\n    '''\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n\n    Examples\n    >>> closest_integer(\"10\")\n    10\n    >>> closest_integer(\"15.3\")\n    15\n\n    Note:\n    Rounding away from zero means that if the given number is equidistant\n    from two integers, the one you should return is the one that is the\n    farthest from zero. For example closest_integer(\"14.5\") should\n    return 15 and closest_integer(\"-14.5\") should return -15.\n    '''\n    if not isinstance(value, str):\n        raise ValueError(\"input must be a string\")\n\n    s = value.strip()\n    try:\n        d = Decimal(s)\n    except (InvalidOperation, ValueError):\n        raise ValueError(\"invalid numeric value\")\n\n    if not d.is_finite():\n        raise ValueError(\"non-finite numeric value\")\n\n    rounded = d.to_integral_value(rounding=ROUND_HALF_UP)\n    return int(rounded)"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Checks if an array can be sorted by right-shifting its elements.\n    Returns True if a sorted version can be achieved, False otherwise.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return True\n\n    sorted_arr = sorted(arr)\n\n    current_arr = list(arr)  # Create a mutable copy to shift\n\n    for _ in range(n):\n        if current_arr == sorted_arr:\n            return True\n        # Perform one right shift: move last element to the front\n        current_arr = [current_arr[-1]] + current_arr[:-1]\n\n    return False"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n    \"\"\"\n    output_list = []\n    template = \"the number of odd elements in the string i of the input.\"\n    odd_digits = '13579'\n\n    for s in lst:\n        count = sum(1 for char in s if char in odd_digits)\n        replacement_str = str(count)\n        result_string = template.replace('i', replacement_str)\n        output_list.append(result_string)\n\n    return output_list"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determine if elements can be exchanged between lst1 and lst2 so that all elements in lst1 are even.\n    Returns \"YES\" if possible, otherwise \"NO\".\n    \"\"\"\n    odd_in_lst1 = sum(1 for x in lst1 if x % 2 != 0)\n    if odd_in_lst1 == 0:\n        return \"YES\"\n    even_in_lst2 = sum(1 for x in lst2 if x % 2 == 0)\n    return \"YES\" if even_in_lst2 >= odd_in_lst1 else \"NO\""}
