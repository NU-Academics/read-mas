{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\"Checks if every opening angle bracket has a corresponding closing bracket.\n    The order and nesting of brackets must be correct.\"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n\n        # If balance ever drops below zero, a closing bracket appeared without a matching open one.\n        if balance < 0:\n            return False\n\n    # After checking all characters, if balance is zero, all brackets were correctly matched.\n    return balance == 0"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n\n    >>> correct_bracketing(\"<\")\n    False\n    >>> correct_bracketing(\"<>\")\n    True\n    >>> correct_bracketing(\"<<><>>\")\n    True\n    >>> correct_bracketing(\"><<>\")\n    False\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        # if any prefix has more closing than opening, it's invalid\n        if balance < 0:\n            return False\n    return balance == 0"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    Treats equal elements as both non-decreasing and non-increasing.\n    \"\"\"\n    is_increasing = True\n    is_decreasing = True\n\n    # Iterate through the list, checking for violations of both monotonicity types.\n    for i in range(len(l) - 1):\n        if l[i] > l[i + 1]:\n            is_increasing = False\n        if l[i] < l[i + 1]:\n            is_decreasing = False\n\n    return is_increasing or is_decreasing"}
