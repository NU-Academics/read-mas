{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    Checks if there are three distinct elements in the list that sum to zero.\n    It returns True if such a triplet exists, False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    l.sort()  # Sort the list to enable the two-pointer approach.\n\n    for i in range(n - 2):\n        left = i + 1\n        right = n - 1\n        while left < right:\n            current_sum = l[i] + l[left] + l[right]\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else:  # current_sum > 0\n                right -= 1\n    return False"}
{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int):\n    \"\"\"\n    Imagine a road that's a perfectly straight infinitely long line.\n    n cars are driving left to right;  simultaneously, a different set of n cars\n    are driving right to left.   The two sets of cars start out being very far from\n    each other.  All cars move in the same speed.  Two cars are said to collide\n    when a car that's moving left to right hits a car that's moving right to left.\n    However, the cars are infinitely sturdy and strong; as a result, they continue moving\n    in their trajectory as if they did not collide.\n\n    This function outputs the number of such collisions.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    return n * n"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    Checks if there are two distinct elements in the list that sum to zero.\n\n    Uses a set to efficiently find complements in O(n) average time.\n    \"\"\"\n    seen_numbers = set()\n    for num in l:\n        complement = -num\n        if complement in seen_numbers:\n            return True\n        seen_numbers.add(num)\n    return False"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    Return string representation after the conversion.\n    base numbers are less than 10 (and at least 2).\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if not isinstance(x, int):\n        raise TypeError(\"x must be an int\")\n    if not isinstance(base, int):\n        raise TypeError(\"base must be an int\")\n    if base < 2 or base >= 10:\n        raise ValueError(\"base must be an integer >= 2 and < 10\")\n\n    if x == 0:\n        return \"0\"\n\n    sign = \"-\" if x < 0 else \"\"\n    n = abs(x)\n    digits = []\n    while n:\n        digits.append(str(n % base))\n        n //= base\n\n    return sign + \"\".join(reversed(digits))"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    Checks if there are two distinct elements in the list that sum to zero.\n    Returns True if such a pair exists, False otherwise.\n    \"\"\"\n    seen_numbers = set()\n    for num in l:\n        if -num in seen_numbers:\n            return True\n        seen_numbers.add(num)\n    return False"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    Return string representation after the conversion.\n    base numbers are less than 10 (allowed bases: 2..9).\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if not isinstance(x, int):\n        raise TypeError(\"x must be an int\")\n    if not isinstance(base, int):\n        raise TypeError(\"base must be an int\")\n    if base < 2 or base >= 10:\n        raise ValueError(\"base must be between 2 and 9 (inclusive)\")\n\n    if x == 0:\n        return '0'\n\n    negative = x < 0\n    n = -x if negative else x\n\n    digits = []\n    while n > 0:\n        digits.append(str(n % base))\n        n //= base\n\n    result = ''.join(reversed(digits))\n    return '-' + result if negative else result"}
