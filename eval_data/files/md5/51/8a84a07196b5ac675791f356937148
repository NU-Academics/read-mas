{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds occurrences of x in the nested list lst and returns their (row, column) coordinates.\n    Coordinates are sorted primarily by row ascending, then by column descending.\n    \"\"\"\n    matches = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                matches.append((r_idx, c_idx))\n\n    # Sort coordinates by row in ascending order and then by column in descending order.\n    matches.sort(key=lambda coord: (coord[0], -coord[1]))\n    return matches"}
{"task_id": "HumanEval/86", "solution": "import re\ndef anti_shuffle(s):\n    \"\"\"\n    Sorts characters within words of a string while preserving whitespace.\n    Words are sorted by Unicode code point, and whitespace sequences are kept intact.\n    \"\"\"\n    if not s:\n        return s\n\n    # Tokenize the input string into alternating runs of whitespace and non-whitespace\n    tokens = re.findall(r\"\\s+|\\S+\", s)\n\n    transformed_tokens = []\n    for token in tokens:\n        if token.isspace():\n            transformed_tokens.append(token)\n        else:\n            transformed_tokens.append(''.join(sorted(token)))\n\n    return ''.join(transformed_tokens)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds all occurrences of x in a 2D list and returns their (row, column) coordinates.\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    coordinates = []\n    for r_idx, row in enumerate(lst):\n        # Skip non-list rows gracefully by treating them as empty\n        if not isinstance(row, (list, tuple)):\n            continue\n        for c_idx, val in enumerate(row):\n            if val == x:\n                coordinates.append((r_idx, c_idx))\n\n    # Sort by row ascending, then by column descending\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return coordinates"}
