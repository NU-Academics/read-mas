{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"Computes the ties-to-even rounded average of integers from n to m, then returns its binary string representation.\n    If n > m, returns -1.\"\"\"\n    if n > m:\n        return -1\n\n    s = n + m\n    candidate = s // 2\n\n    # If s is odd, s/2 is X.5, requiring ties-to-even rounding.\n    if s % 2 != 0:\n        # If the integer part (candidate) is odd, round up to make it even.\n        if candidate % 2 != 0:\n            candidate += 1\n\n    return bin(candidate)"}
{"task_id": "HumanEval/102", "solution": "def choose_num(x, y):\n    \"\"\"Returns the biggest even integer in range [x, y] inclusive. Returns -1 if no such number exists.\"\"\"\n    if x > y:\n        return -1\n\n    # Start with the largest integer less than or equal to y.\n    candidate = int(y)\n\n    # If the candidate is odd, subtract 1 to find the largest even number <= y.\n    if candidate % 2 != 0:\n        candidate -= 1\n\n    # Check if this even candidate is still within the [x, y] range.\n    if candidate >= x:\n        return candidate\n    else:\n        return -1"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x, return a sorted list of elements\n    that have no even digits.\n    \"\"\"\n    result = []\n    for num in x:\n        has_even_digit = False\n        # Convert number to string to easily check digits\n        for digit_char in str(num):\n            digit = int(digit_char)\n            if digit % 2 == 0:\n                has_even_digit = True\n                break\n        if not has_even_digit:\n            result.append(num)\n\n    result.sort()\n    return result"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"Computes the rounded average of integers from n to m, returning its binary string.\n    Rounds using round-half-to-even (banker's rounding) and handles n > m by returning -1.\n    \"\"\"\n    if n > m:\n        return -1\n\n    count = m - n + 1\n    # Sum of arithmetic series (exact integer)\n    total_sum = (n + m) * count // 2\n\n    # Integer division and remainder to decide rounding\n    avg_floor = total_sum // count\n    rem = total_sum % count\n\n    rounded_value = avg_floor\n\n    if rem * 2 > count:\n        rounded_value = avg_floor + 1\n    elif rem * 2 == count:\n        # Tie: round half to even\n        if avg_floor % 2 != 0:\n            rounded_value = avg_floor + 1\n\n    return bin(rounded_value)"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name\n    from \"One\" to \"Nine\". Non-integer items, booleans, and numbers outside 1-9 are ignored.\n\n    Examples:\n      by_length([2, 1, 1, 4, 5, 8, 2, 3]) ->\n          [\"Eight\", \"Five\", \"Four\", \"Three\", \"Two\", \"Two\", \"One\", \"One\"]\n\n      by_length([]) -> []\n\n      by_length([1, -1, 55]) -> [\"One\"]\n    \"\"\"\n    digit_names = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    if arr is None:\n        return []\n\n    try:\n        iter(arr)\n    except TypeError:\n        raise TypeError(\"arr must be an iterable\")\n\n    # Keep only true integers (exclude booleans) within 1..9\n    filtered = [x for x in arr if type(x) is int and 1 <= x <= 9]\n\n    filtered.sort()\n    filtered.reverse()\n\n    return [digit_names[x] for x in filtered]"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all\n    elements that hasn't any even digit.\"\"\"\n\n    EVEN_DIGITS = {'0', '2', '4', '6', '8'}\n    result = []\n\n    for num in x:\n        s = str(abs(num))\n        if not any(ch in EVEN_DIGITS for ch in s):\n            result.append(num)\n\n    return sorted(result)"}
{"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\"Implements the function f, returning a list of size n where the element at index i (starting from 1) is the factorial of i if i is even, or the sum of numbers from 1 to i if i is odd.\"\"\"\n    if n <= 0:\n        return []\n\n    result = []\n    factorial_current = 1\n    for i in range(1, n + 1):\n        factorial_current *= i\n        if i % 2 == 0:\n            result.append(factorial_current)\n        else:\n            result.append(i * (i + 1) // 2)\n    return result"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Counts even and odd integer palindromes within the range (1, n) inclusive.\n    Returns a tuple containing the counts of even and odd palindromes respectively.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    for i in range(1, n + 1):\n        s = str(i)\n        if s == s[::-1]:\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\"Implement the function f that takes n as a parameter,\n    and returns a list of size n, such that the value of the element at index i is the factorial of i if i is even\n    or the sum of numbers from 1 to i otherwise.\n    i starts from 1.\n    the factorial of i is the multiplication of the numbers from 1 to i (1 * 2 * ... * i).\n    Example:\n    f(5) == [1, 2, 6, 24, 15]\n    \"\"\"\n    result = []\n    current_factorial = 1\n\n    for i in range(1, n + 1):\n        current_factorial *= i  # current_factorial now holds i!\n\n        if i % 2 == 0:  # If i is even, use factorial\n            result.append(current_factorial)\n        else:  # If i is odd, use sum from 1 to i\n            sum_val = i * (i + 1) // 2\n            result.append(sum_val)\n\n    return result"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Write a function count_nums which takes an array of integers and returns\n    the number of elements which has a sum of digits > 0.\n    If a number is negative, then its first signed digit will be negative:\n    e.g. -123 has signed digits -1, 2, and 3.\n    >>> count_nums([]) == 0\n    >>> count_nums([-1, 11, -11]) == 1\n    >>> count_nums([1, 1, 2]) == 3\n    \"\"\"\n    count = 0\n    for n in arr:\n        if n == 0:\n            digit_sum = 0\n        elif n > 0:\n            digit_sum = sum(int(d) for d in str(n))\n        else:\n            s = str(abs(n))\n            # First (most significant) digit is negative, others positive\n            if len(s) == 1:\n                digit_sum = -int(s[0])\n            else:\n                digit_sum = -int(s[0]) + sum(int(d) for d in s[1:])\n        if digit_sum > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"Counts numbers in arr whose signed-digit sum is positive.\n    Negative numbers treat their first digit as negative.\n    \"\"\"\n    counter = 0\n    for n in arr:\n        sum_digits = 0\n        if n >= 0:\n            s = str(n)\n            # sum digits (0 -> 0)\n            sum_digits = sum(int(d) for d in s)\n        else:\n            s = str(abs(n))\n            if len(s) > 1:\n                # first (most significant) digit is negative\n                sum_digits = -int(s[0]) + sum(int(d) for d in s[1:])\n            else:\n                # single-digit negative number, e.g., -5 -> -5\n                sum_digits = -int(s[0])\n\n        if sum_digits > 0:\n            counter += 1\n    return counter"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Determines if an array of unique integers can be sorted by right shifts.\n    It counts 'descending pairs' in a circular array; at most one such pair means it's a rotated sorted array.\n    \"\"\"\n    n = len(arr)\n\n    # If arr is empty or has 0/1 elements, it is considered sorted.\n    if n <= 1:\n        return True\n\n    # Count occurrences where arr[i] > arr[(i+1)%n] (circularly).\n    violations = 0\n    for i in range(n):\n        if arr[i] > arr[(i + 1) % n]:\n            violations += 1\n\n    # Return True if there is at most one such violation, otherwise False.\n    return violations <= 1"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if elements can be exchanged between lists to make lst1 all even.\n    Returns \"YES\" if possible, \"NO\" otherwise, based on parity counts.\n    \"\"\"\n    # Count the number of odd elements in lst1\n    odd_in_lst1 = sum(1 for x in lst1 if x % 2 != 0)\n\n    # Count the number of even elements in lst2\n    even_in_lst2 = sum(1 for y in lst2 if y % 2 == 0)\n\n    # If there are enough even elements in lst2 to replace all odd elements in lst1\n    if even_in_lst2 >= odd_in_lst1:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s,c):\n    \"\"\"Delete all characters from s that appear in c, then check if the result is a palindrome.\n    Returns a tuple: (result_string, is_palindrome).\n    \"\"\"\n    if not isinstance(s, str) or not isinstance(c, str):\n        raise TypeError(\"Both s and c must be strings\")\n\n    remove = set(c)\n    result = ''.join(ch for ch in s if ch not in remove)\n    return (result, result == result[::-1])"}
{"task_id": "HumanEval/111", "solution": "import collections\ndef histogram(test):\n    \"\"\"Given a string of space-separated lowercase letters, returns a dictionary\n    of letter(s) with the highest frequency and their counts.\n    If several letters tie for maximum occurrence, return all of them.\n    \"\"\"\n    tokens = test.split()\n\n    if not tokens:\n        return {}\n\n    counter = collections.Counter(tokens)\n    max_count = max(counter.values())\n    return {char: count for char, count in counter.items() if count == max_count}"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an iterable of numbers nums, return the minimum sum of any non-empty sub-array (contiguous subsequence).\n\n    Examples:\n    minSubArraySum([2, 3, 4, 1, 2, 4]) == 1\n    minSubArraySum([-1, -2, -3]) == -6\n\n    Raises:\n    TypeError: if nums is not an iterable or contains non-numeric values.\n    ValueError: if nums is empty.\n    \"\"\"\n    if nums is None:\n        raise TypeError(\"nums must be a non-empty iterable of numbers\")\n\n    try:\n        it = iter(nums)\n    except TypeError:\n        raise TypeError(\"nums must be an iterable of numbers\")\n\n    try:\n        first = next(it)\n    except StopIteration:\n        raise ValueError(\"nums must be a non-empty iterable\")\n\n    # Ensure the first element is numeric\n    try:\n        min_so_far = current_min = first + 0\n    except Exception:\n        raise TypeError(\"nums must contain numeric values\")\n\n    for item in it:\n        try:\n            val = item + 0\n        except Exception:\n            raise TypeError(\"nums must contain numeric values\")\n\n        # current_min = min(val, current_min + val)\n        summed = current_min + val\n        if val < summed:\n            current_min = val\n        else:\n            current_min = summed\n\n        if current_min < min_so_far:\n            min_so_far = current_min\n\n    return min_so_far"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each output element reports the count of odd digits from the corresponding input string.\"\"\"\n    template = \"the number of odd elements in the string i of the input.\"\n    output_list = []\n    for s in lst:\n        n = sum(1 for ch in s if ch in '13579')\n        ns = str(n)\n        formatted = template.replace('i', ns)\n        output_list.append(formatted)\n    return output_list"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s, c):\n    \"\"\"Deletes characters from s found in c, then checks if the resulting string is a palindrome.\n    Returns a tuple (result_string, is_palindrome_boolean).\"\"\"\n    delete_set = set(c)\n    result_chars = [ch for ch in s if ch not in delete_set]\n    result = ''.join(result_chars)\n    is_palindrome = (result == result[::-1])\n    return (result, is_palindrome)"}
{"task_id": "HumanEval/115", "solution": "import math\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the minimum number of times buckets must be lowered to empty all wells.\n    Each 1 in the grid represents a unit of water, and buckets have a fixed capacity.\n    \"\"\"\n    total_bucket_operations = 0\n    for well in grid:\n        water_in_well = sum(well)\n        if water_in_well > 0:\n            operations_for_well = math.ceil(water_in_well / capacity)\n            total_bucket_operations += operations_for_well\n    return total_bucket_operations"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an iterable of numbers `nums`, return the minimum sum of any non-empty sub-array.\n    Raises:\n        ValueError: if `nums` is empty.\n        TypeError: if `nums` is not an iterable of numeric values.\n    \"\"\"\n    # Validate iterable and get first element\n    try:\n        it = iter(nums)\n    except TypeError:\n        raise TypeError(\"nums must be an iterable of numeric values\")\n\n    try:\n        first = next(it)\n    except StopIteration:\n        raise ValueError(\"nums must be a non-empty iterable\")\n\n    if not isinstance(first, (int, float)):\n        raise TypeError(\"nums must contain numeric values\")\n\n    current_min = global_min = first\n\n    for num in it:\n        if not isinstance(num, (int, float)):\n            raise TypeError(\"nums must contain numeric values\")\n        current_min = min(num, current_min + num)\n        global_min = min(global_min, current_min)\n\n    return global_min"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Returns words from string s containing exactly n consonants.\n    Vowels are 'a', 'e', 'i', 'o', 'u' (case-insensitive); 'y' is a consonant.\"\"\"\n    if not s:\n        return []\n\n    result = []\n    vowels = \"aeiouAEIOU\"\n    words = s.split()\n\n    for word in words:\n        consonant_count = 0\n        for char in word:\n            if char.isalpha() and char not in vowels:\n                consonant_count += 1\n\n        if consonant_count == n:\n            result.append(word)\n\n    return result"}
{"task_id": "HumanEval/115", "solution": "def max_fill(grid, capacity):\n    \"\"\"\n    Compute the total number of times buckets must be lowered to empty all wells in a rectangular grid.\n    Each 1 in a row is a unit of water; lowering a bucket removes up to 'capacity' units.\n    \"\"\"\n    if grid is None or len(grid) == 0:\n        return 0\n    if not isinstance(capacity, int) or capacity < 1:\n        raise ValueError(\"capacity must be an integer >= 1\")\n\n    total_lowerings = 0\n    for row in grid:\n        if row is None:\n            continue\n        # Count units in the row; assume values are 0/1 or booleans.\n        units_in_well = 0\n        for v in row:\n            if v not in (0, 1, True, False):\n                raise TypeError(\"grid elements must be 0 or 1 (or booleans)\")\n            units_in_well += int(bool(v))\n\n        if units_in_well > 0:\n            total_lowerings += (units_in_well + capacity - 1) // capacity\n\n    return total_lowerings"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Returns a list of words from string s that contain exactly n consonants.\n    Vowels are 'a', 'e', 'i', 'o', 'u' (case-insensitive); 'y' is a consonant.\n    \"\"\"\n    if not s:\n        return []\n\n    result_words = []\n    vowels = \"aeiou\"\n\n    words = s.split()\n\n    for word in words:\n        consonant_count = 0\n        for char in word:\n            lower_char = char.lower()\n            if lower_char.isalpha() and lower_char not in vowels:\n                consonant_count += 1\n\n        if consonant_count == n:\n            result_words.append(word)\n\n    return result_words"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"Sorts an array of integers by their absolute binary ones count, then by numeric value.\"\"\"\n    # Helper function to count set bits in the absolute value of a number.\n    def _ones_count(x):\n        # Use int.bit_count for efficiency if available.\n        if hasattr(int, 'bit_count'):\n            return abs(x).bit_count()\n        # Fallback for older Python versions.\n        return bin(abs(x)).count('1')\n\n    # Sort the array using _ones_count for the primary key and the number itself for the secondary key.\n    return sorted(arr, key=lambda x: (_ones_count(x), x))"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel surrounded by consonants from the right side of the word.\n    Returns the vowel, or an empty string if none is found.\n    \"\"\"\n    vowels = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    if len(word) < 3:\n        return ''\n\n    # Iterate from the second to last character down to the second character\n    # to ensure a left and right neighbor exist.\n    for i in range(len(word) - 2, 0, -1):\n        char = word[i]\n        left_neighbor = word[i - 1]\n        right_neighbor = word[i + 1]\n\n        # Check if the current character is a vowel and its neighbors are consonants.\n        if char in vowels and left_neighbor not in vowels and right_neighbor not in vowels:\n            return char\n\n    return ''"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if concatenating two strings of parentheses in some order yields a balanced string.\n    Returns 'Yes' if possible, 'No' otherwise.\n    \"\"\"\n\n    def is_balanced(s):\n        \"\"\"\n        Checks if a given string of parentheses is balanced using a counter.\n        Returns True if balanced, False otherwise.\n        \"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:  # char == ')'\n                balance -= 1\n            if balance < 0:\n                return False  # More closing than opening at some point.\n        return balance == 0\n\n    s1 = lst[0]\n    s2 = lst[1]\n\n    # Early exit: If total length is odd, it cannot be balanced.\n    if (len(s1) + len(s2)) % 2 != 0:\n        return 'No'\n\n    # Check the first concatenation order: s1 + s2\n    if is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Check the second concatenation order: s2 + s1\n    if is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'"}
