{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    '''\n    Checks if object q will fly based on balance (palindrome) and weight.\n    Returns True if q is a palindrome and its sum is less than or equal to w, False otherwise.\n    '''\n    is_balanced = (q == q[::-1])\n    weight_ok = (sum(q) <= w)\n    return is_balanced and weight_ok"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII codes of uppercase characters in a string.\n    Iterates through the string, summing `ord(char)` for each uppercase character.\"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts the number of prime hexadecimal digits in a given hexadecimal string.\n    The prime hexadecimal digits are '2', '3', '5', '7', 'B' (decimal 11), and 'D' (decimal 13).\n    \"\"\"\n    prime_hex_digits = {'2', '3', '5', '7', 'B', 'D'}\n    count = 0\n    for digit in num:\n        if digit in prime_hex_digits:\n            count += 1\n    return count"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece.\n    This function computes the n-th element iteratively.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the four preceding values: fib4(0), fib4(1), fib4(2), fib4(3)\n    # These correspond to the values required to calculate fib4(4)\n    f0, f1, f2, f3 = 0, 0, 2, 0\n\n    # Iterate from n=4 up to the desired n\n    for _ in range(4, n + 1):\n        next_fib = f0 + f1 + f2 + f3\n        # Shift the values: (f_n-3, f_n-2, f_n-1, f_n) become the new (f0, f1, f2, f3)\n        f0 = f1\n        f1 = f2\n        f2 = f3\n        f3 = next_fib\n\n    return f3"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts vowels 'a', 'e', 'i', 'o', 'u' (case-insensitive).\n    'y' is counted only if it is the last character of the word.\n    \"\"\"\n    count = 0\n    s_lower = s.lower()\n\n    for i, char in enumerate(s_lower):\n        if char in \"aeiou\":\n            count += 1\n        elif char == 'y' and i == len(s_lower) - 1:\n            count += 1\n    return count"}
{"task_id": "HumanEval/100", "solution": "def make_a_pile(n):\n    \"\"\"\n    Given a positive integer n, you have to make a pile of n levels of stones.\n    The first level has n stones.\n    The number of stones in the next level is:\n        - the next odd number if n is odd.\n        - the next even number if n is even.\n    Return the number of stones in each level in a list, where element at index\n    i represents the number of stones in the level (i+1).\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    pile_stones = []\n    current_stones = n\n    for _ in range(n):\n        pile_stones.append(current_stones)\n        current_stones += 2\n    return pile_stones"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"Checks if a string is \"happy\" based on length and distinct consecutive triplets.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct.\"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        a, b, c = s[i], s[i+1], s[i+2]\n        if a == b or b == c or a == c:\n            return False\n\n    return True"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a decimal number to its binary string representation.\n    The binary string is prefixed and suffixed with 'db'.\n    \"\"\"\n    binary_string_raw = bin(decimal)\n\n    if binary_string_raw.startswith('-0b'):\n        # For negative numbers, remove '-0b' and prepend '-' to the bits.\n        binary_digits = '-' + binary_string_raw[3:]\n    else:\n        # For positive or zero, just remove '0b'.\n        binary_digits = binary_string_raw[2:]\n\n    return f\"db{binary_digits}db\""}
