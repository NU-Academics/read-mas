{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Return True if integer a is a perfect cube.\n    \"\"\"\n    if a == 0:\n        return True\n\n    n = -a if a < 0 else a\n\n    # Find an upper bound for the cube root by doubling\n    lo, hi = 0, 1\n    while hi * hi * hi < n:\n        hi <<= 1\n\n    # Binary search for integer cube root of n\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        m3 = mid * mid * mid\n        if m3 == n:\n            return True\n        if m3 < n:\n            lo = mid + 1\n        else:\n            hi = mid - 1\n\n    return False"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Return True if integer a is the product of exactly three prime numbers (counting multiplicity).\"\"\"\n    if not isinstance(a, int) or a < 2:\n        return False\n\n    count = 0\n    n = a\n\n    d = 2\n    while d * d <= n:\n        while n % d == 0:\n            count += 1\n            n //= d\n            if count > 3:\n                return False\n        d = 3 if d == 2 else d + 2  # check 2, then odd divisors\n\n    if n > 1:\n        count += 1\n\n    return count == 3"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"\n    Returns True if `a` is the product of exactly three prime numbers (primes may repeat), otherwise False.\n    Works efficiently for values < 100 (but handles other integers gracefully).\n    \"\"\"\n    if not isinstance(a, int) or a < 30:\n        return False\n\n    primes = [2, 3, 5, 7, 11, 13, 17, 19, 23]\n    n = len(primes)\n\n    for i in range(n):\n        p1 = primes[i]\n        if p1 * p1 * p1 > a:\n            break\n        for j in range(i, n):\n            p2 = primes[j]\n            if p1 * p2 * p2 > a:\n                break\n            for k in range(j, n):\n                p3 = primes[k]\n                product = p1 * p2 * p3\n                if product == a:\n                    return True\n                if product > a:\n                    break\n    return False"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts prime hexadecimal digits in a given string.\n    The function checks for '2', '3', '5', '7', 'B' (11), 'D' (13).\n    \"\"\"\n    prime_hex_digits = {'2', '3', '5', '7', 'B', 'D'}\n    count = 0\n    for digit in num:\n        if digit in prime_hex_digits:\n            count += 1\n    return count"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Return True if there exists a non-negative integer k such that n**k == x.\"\"\"\n    # Handle special bases first\n    if n == 0:\n        # 0**0 == 1, 0**k (k>=1) == 0\n        return x == 0 or x == 1\n    if n == 1:\n        return x == 1\n    if n == -1:\n        return x == 1 or x == -1\n\n    # General cases for |n| >= 2\n    if x == 1:\n        return True  # n**0 == 1\n    if x == 0:\n        return False  # nonzero base cannot produce 0\n    if n > 0 and x < 0:\n        return False  # positive base cannot produce negative x\n\n    current_power = 1  # n**0\n    while True:\n        if current_power == x:\n            return True\n        if abs(current_power) > abs(x):\n            return False\n        current_power *= n"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Write a function that takes an integer a and returns True\n    if this integer is a cube of some integer number.\n    \"\"\"\n    if a == 0:\n        return True\n\n    abs_a = abs(a)\n    low = 0\n    high = abs_a\n\n    while low <= high:\n        mid = (low + high) // 2\n        cube = mid * mid * mid\n\n        if cube == abs_a:\n            return True\n        elif cube < abs_a:\n            low = mid + 1\n        else:\n            high = mid - 1\n\n    return False"}
