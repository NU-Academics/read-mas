{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    '''\n    total_sum = 0\n    for x in lst:\n        if isinstance(x, bool):\n            continue\n        if isinstance(x, int) and x >= 0 and x % 2 != 0:\n            total_sum += x * x\n    return total_sum"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Determines how far off each guess was from the actual score.\n    Returns 0 for correct guesses, otherwise the absolute difference.\n    \"\"\"\n    result = []\n    for actual_score, guessed_score in zip(game, guess):\n        if actual_score == guessed_score:\n            result.append(0)\n        else:\n            result.append(abs(actual_score - guessed_score))\n    return result"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM, returning a formatted string.\n    If strengths are equal, the first encountered extension is chosen.\"\"\"\n    max_strength = -float('inf')\n    strongest_extension_name = \"\"\n\n    for extension in extensions:\n        cap_count = sum(1 for c in extension if c.isupper())\n        sm_count = sum(1 for c in extension if c.islower())\n        current_strength = cap_count - sm_count\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension\n\n    return f\"{class_name}.{strongest_extension_name}\""}
