{"task_id": "HumanEval/3", "solution": "def below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    current_balance = 0\n    for op in operations:\n        current_balance += op\n        if current_balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    result = []\n    current_group = []\n    balance = 0\n\n    for char in paren_string:\n        if char == ' ':\n            continue\n\n        current_group.append(char)\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        if balance == 0 and len(current_group) > 0:\n            result.append(\"\".join(current_group))\n            current_group = []\n\n    return result"}
{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    result: List[int] = []\n    for i, num in enumerate(numbers):\n        if i > 0:\n            result.append(delimeter)\n        result.append(num)\n    return result"}
{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers`.\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    result: List[int] = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"Calculate the Mean Absolute Deviation (MAD) around the mean for a list of numbers.\n\n    MAD = average |x - x_mean|\n\n    Args:\n        numbers: List of numeric values (int/float). The caller is expected to\n                 provide at least one value.\n\n    Returns:\n        The mean absolute deviation as a float.\n\n    Raises:\n        TypeError: if `numbers` is not a sequence or contains non-numeric elements.\n        ValueError: if `numbers` is empty or contains NaN/inf values.\n    \"\"\"\n    import math\n\n    if not isinstance(numbers, (list, tuple)):\n        raise TypeError(\"numbers must be a list or tuple of numeric values\")\n\n    n = len(numbers)\n    if n == 0:\n        raise ValueError(\"numbers must contain at least one value\")\n\n    # Validate elements and compute mean with high-precision summation\n    for i, x in enumerate(numbers):\n        if not isinstance(x, (int, float)):\n            raise TypeError(f\"element at index {i} is not numeric: {type(x).__name__}\")\n        if math.isnan(x) or not math.isfinite(x):\n            raise ValueError(f\"element at index {i} is NaN or infinite\")\n\n    mean = math.fsum(numbers) / n\n    abs_diff_sum = math.fsum(abs(x - mean) for x in numbers)\n    return abs_diff_sum / n"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Input is a string containing multiple groups of parentheses separated by whitespace.\n    For each group, return the deepest level of nesting. Raises ValueError on malformed groups\n    (unmatched parentheses) or if a group contains characters other than '(' or ')'.\n\n    Example:\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    if not paren_string:\n        return []\n\n    results: List[int] = []\n    groups = paren_string.split()  # split on any whitespace, ignore empty segments\n\n    for group in groups:\n        current_level = 0\n        max_level = 0\n        for ch in group:\n            if ch == \"(\":\n                current_level += 1\n                if current_level > max_level:\n                    max_level = current_level\n            elif ch == \")\":\n                current_level -= 1\n                if current_level < 0:\n                    raise ValueError(f\"Unmatched closing parenthesis in group: '{group}'\")\n            else:\n                raise ValueError(f\"Invalid character '{ch}' in group: '{group}'\")\n        if current_level != 0:\n            raise ValueError(f\"Unmatched opening parenthesis in group: '{group}'\")\n        results.append(max_level)\n\n    return results"}
{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if isinstance(s, str) and substring in s]"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"For a given list of integers, return a tuple consisting of a sum and a product.\n    Empty sum is 0, and empty product is 1.\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Input is a string with parenthesis groups separated by whitespace.\n    Returns a list with the maximum nesting depth for each group.\n    Raises ValueError for invalid characters or unbalanced parentheses.\n    \"\"\"\n    if not isinstance(paren_string, str):\n        raise TypeError(\"paren_string must be a str\")\n\n    # Fast return for empty or whitespace-only input\n    if paren_string.strip() == \"\":\n        return []\n\n    results: List[int] = []\n    groups = paren_string.split()\n\n    for idx, group in enumerate(groups):\n        current = 0\n        max_depth = 0\n        for ch in group:\n            if ch == \"(\":\n                current += 1\n                if current > max_depth:\n                    max_depth = current\n            elif ch == \")\":\n                current -= 1\n                if current < 0:\n                    raise ValueError(f\"Unbalanced parentheses in group {idx}: too many ')'\")\n            else:\n                raise ValueError(f\"Invalid character '{ch}' in group {idx}; only '(' and ')' allowed\")\n        if current != 0:\n            raise ValueError(f\"Unbalanced parentheses in group {idx}: mismatched '(' and ')'\")\n        results.append(max_depth)\n\n    return results"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = [0] * len(numbers)\n    current_max = numbers[0]\n    result[0] = current_max\n\n    for i in range(1, len(numbers)):\n        val = numbers[i]\n        if val > current_max:\n            current_max = val\n        result[i] = current_max\n\n    return result"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total = 0\n    product = 1\n    for number in numbers:\n        total += number\n        product *= number\n    return total, product"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    rolling_maximums = []\n    current_max = float('-inf')\n\n    for number in numbers:\n        current_max = max(current_max, number)\n        rolling_maximums.append(current_max)\n\n    return rolling_maximums"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Out of list of strings, return the longest one.\n    Return the first one in case of multiple strings of the same length, or None if the list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_so_far = strings[0]\n    for s in strings:\n        if len(s) > len(longest_so_far):\n            longest_so_far = s\n    return longest_so_far"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\"Find the shortest palindrome that begins with the supplied string.\n    Appends the reverse of the prefix before the longest palindromic suffix.\n    \"\"\"\n    def compute_lps(s: str) -> list[int]:\n        \"\"\"Compute the LPS (longest proper prefix which is also suffix) array for KMP.\"\"\"\n        lps = [0] * len(s)\n        length = 0\n        i = 1\n        while i < len(s):\n            if s[i] == s[length]:\n                length += 1\n                lps[i] = length\n                i += 1\n            else:\n                if length != 0:\n                    length = lps[length - 1]\n                else:\n                    lps[i] = 0\n                    i += 1\n        return lps\n\n    n = len(string)\n    if n <= 1:\n        return string\n\n    rev = string[::-1]\n    combined = rev + '#' + string\n    lps = compute_lps(combined)\n    L = lps[-1]  # length of longest palindromic suffix of `string`\n    to_append = (string[: n - L])[::-1]\n    return string + to_append"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b using the Euclidean algorithm.\n    It handles negative inputs by taking absolute values.\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n    return max(strings, key=len)"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\"Input are two strings a and b consisting only of '1's and '0's.\n    Perform binary XOR on these inputs and return result also as a string.\n    Example: string_xor('010', '110') -> '100'\n    \"\"\"\n    if not isinstance(a, str) or not isinstance(b, str):\n        raise TypeError(\"Both inputs must be strings.\")\n    if any(ch not in \"01\" for ch in a):\n        raise ValueError(\"String 'a' contains characters other than '0' and '1'.\")\n    if any(ch not in \"01\" for ch in b):\n        raise ValueError(\"String 'b' contains characters other than '0' and '1'.\")\n\n    max_len = max(len(a), len(b))\n    pa = a.zfill(max_len)\n    pb = b.zfill(max_len)\n    return \"\".join(\"1\" if x != y else \"0\" for x, y in zip(pa, pb))"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"Return a greatest common divisor of two integers a and b.\n\n    Uses the iterative Euclidean algorithm. Negative inputs are handled by taking\n    absolute values. Returns 0 if both a and b are 0.\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/14", "solution": "def all_prefixes(string: str) -> List[str]:\n    \"\"\"Return a list of all prefixes of the input string from shortest to longest.\n    For an empty string, returns an empty list.\n    \"\"\"\n    return [string[:i] for i in range(1, len(string) + 1)]"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\"\n    Find the shortest palindrome that begins with the supplied string by appending\n    as few characters as possible to the end.\n    \"\"\"\n    def _compute_lps(t: str) -> list[int]:\n        m = len(t)\n        lps = [0] * m\n        length = 0\n        i = 1\n        while i < m:\n            if t[i] == t[length]:\n                length += 1\n                lps[i] = length\n                i += 1\n            else:\n                if length != 0:\n                    length = lps[length - 1]\n                else:\n                    lps[i] = 0\n                    i += 1\n        return lps\n\n    n = len(string)\n    if n == 0 or string == string[::-1]:\n        return string\n\n    rev = string[::-1]\n    combined = rev + '#' + string\n    lps = _compute_lps(combined)\n    longest_pal_suffix_len = lps[-1]\n    to_append = string[: n - longest_pal_suffix_len][::-1]\n    return string + to_append"}
