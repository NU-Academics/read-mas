{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if isinstance(n, bool) or not isinstance(n, int):\n        raise TypeError(\"is_prime() requires an integer argument\")\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0:\n        return False\n\n    import math\n    limit = math.isqrt(n)\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return False\n    return True"}
{"task_id": "HumanEval/30", "solution": "import math\ndef get_positive(l: list):\n    \"\"\"Return only positive numbers from the input list, excluding non-numeric items, booleans, and non-finite floats.\n    Preserves original order and numeric types.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    try:\n        return [\n            x for x in l\n            if isinstance(x, (int, float))\n            and not isinstance(x, bool)\n            and (isinstance(x, int) or math.isfinite(x))\n            and x > 0\n        ]\n    except TypeError:\n        raise TypeError(\"Input must be an iterable of values\")"}
{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    Returns xs[0] + xs[1]*x + ... + xs[n]*x^n.\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list):\n    \"\"\"\n    Finds a root of a polynomial with coefficients xs using a bracket-search and bisection.\n    It returns a single zero point where the polynomial evaluates to zero.\n    \"\"\"\n    # 1. Normalize coefficients: Strip trailing zeros (highest-degree zeros).\n    # This loop ensures `xs` is not empty if it started as `[0]`.\n    while len(xs) > 1 and xs[-1] == 0:\n        xs.pop()\n\n    # Handle constant polynomials.\n    if len(xs) == 1:\n        if xs[0] == 0:\n            return 0.0 # Polynomial is constant zero.\n        # For non-zero constant, the design indicates raising an error, but this is forbidden.\n        # The subsequent search and bisection will proceed but will not find a root.\n\n    # Check f(0) as a quick first check for a root.\n    if poly(xs, 0.0) == 0:\n        return 0.0\n\n    # Tolerances and limits for search and bisection.\n    expand_factor = 2.0\n    max_radius = 1e12\n    max_expand_iters = 100\n    tol_x = 1e-12\n    tol_f = 1e-12\n    max_bisect_iters = 1000\n\n    # 2. Bracket search: Find an interval [left, right] with sign change.\n    left = -1.0\n    right = 1.0\n    f_left = poly(xs, left)\n    f_right = poly(xs, right)\n\n    bracket_found = False\n    if f_left * f_right < 0:\n        bracket_found = True\n\n    for _ in range(max_expand_iters):\n        if bracket_found:\n            break\n\n        # Check if expanding further would exceed max_radius.\n        if abs(left * expand_factor) > max_radius or abs(right * expand_factor) > max_radius:\n            # If radius limit is reached without finding a bracket, proceed with current bounds.\n            break\n\n        left *= expand_factor\n        right *= expand_factor\n\n        f_left = poly(xs, left)\n        f_right = poly(xs, right)\n\n        if f_left * f_right < 0:\n            bracket_found = True\n\n    # 3. Bisection: Converge to a root within the bracket.\n    for _ in range(max_bisect_iters):\n        mid = (left + right) / 2.0\n        f_mid = poly(xs, mid)\n\n        # Return if function value is sufficiently small.\n        if abs(f_mid) < tol_f:\n            return mid\n\n        # Return if interval width is sufficiently small.\n        if (right - left) / 2.0 < tol_x:\n            return mid\n\n        # Update the interval based on the sign of f_mid.\n        if f_left * f_mid < 0:\n            right = mid\n            f_right = f_mid\n        elif f_right * f_mid < 0:\n            left = mid\n            f_left = f_mid\n        else:\n            # This case means f_mid is either exactly zero (handled above)\n            # or has the same sign as both f_left and f_right.\n            # This can happen if no proper bracket was found initially,\n            # or due to floating point inaccuracies at an extremum.\n            # We must return to satisfy \"no exceptions\" and \"return only zero point\".\n            return mid\n\n    # If max_bisect_iters is reached, return the current midpoint as the best approximation.\n    return (left + right) / 2.0"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"Sorts elements at indices divisible by 3 in ascending order, keeping other elements unchanged.\"\"\"\n    result_list = list(l)\n    thirds_elements = []\n    third_indices = []\n\n    for i in range(len(l)):\n        if i % 3 == 0:\n            thirds_elements.append(l[i])\n            third_indices.append(i)\n\n    thirds_elements.sort()\n\n    for i, original_index in enumerate(third_indices):\n        result_list[original_index] = thirds_elements[i]\n\n    return result_list"}
{"task_id": "HumanEval/32", "solution": "import math\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    \"\"\"\n\n    # Helper function for polynomial evaluation using Horner's method.\n    def _eval_poly(coeffs, x_val):\n        result = 0.0\n        for coeff in reversed(coeffs):\n            result = result * x_val + coeff\n        return result\n\n    # Tolerances and limits as per design document.\n    TOL = 1e-12\n    F_TOL = 1e-12\n    MAX_ITER = 200\n    MAX_BRACKET_EXPANSION = 200\n    ABS_BRACKET_LIMIT = 1e300\n\n    degree = len(xs) - 1\n\n    # Direct solution for linear polynomial (degree 1), i.e., len(xs) == 2.\n    if degree == 1:\n        # For c0 + c1*x = 0, x = -c0/c1. xs[1] is guaranteed non-zero.\n        return -xs[0] / xs[1]\n\n    # Bracketing phase for polynomials of degree >= 3 (odd).\n    a = -1.0\n    b = 1.0\n    fa = _eval_poly(xs, a)\n    fb = _eval_poly(xs, b)\n\n    if fa == 0.0: return a\n    if fb == 0.0: return b\n\n    # If initial interval doesn't bracket a root, expand it symmetrically.\n    if math.copysign(1.0, fa) == math.copysign(1.0, fb):\n        R = 1.0\n        found_bracket = False\n        for _ in range(MAX_BRACKET_EXPANSION):\n            R *= 2.0\n            if R > ABS_BRACKET_LIMIT:\n                break # R is too large, will raise ValueError after the loop\n\n            new_a = -R\n            new_b = R\n            new_fa = _eval_poly(xs, new_a)\n            new_fb = _eval_poly(xs, new_b)\n\n            if new_fa == 0.0: return new_a\n            if new_fb == 0.0: return new_b\n\n            if math.copysign(1.0, new_fa) != math.copysign(1.0, new_fb):\n                a, b, fa, fb = new_a, new_b, new_fa, new_fb\n                found_bracket = True\n                break\n\n        if not found_bracket:\n            raise ValueError(\"Failed to bracket a root within expansion limits or due to overflow/underflow.\")\n\n    # Ensure a < b for consistent interval handling.\n    if a > b:\n        a, b = b, a\n        fa, fb = fb, fa\n\n    # Hybrid Secant/Bisection method within the found bracket [a, b].\n    for i in range(MAX_ITER):\n        # Current interval width.\n        current_interval_width = b - a\n\n        # Check stopping criteria.\n        # Use midpoint as the root_estimate for tolerance check.\n        root_estimate = (a + b) / 2.0\n        f_root_estimate = _eval_poly(xs, root_estimate) # Re-evaluate for final check.\n\n        if current_interval_width <= TOL * max(1.0, math.fabs(root_estimate)) or math.fabs(f_root_estimate) <= F_TOL:\n            return root_estimate\n\n        # Calculate secant step (Regula Falsi, guaranteed to stay within [a,b]).\n        if math.fabs(fb - fa) < F_TOL: # Avoid division by zero if f(a) ~ f(b)\n            c = (a + b) / 2.0 # Fallback to bisection\n        else:\n            c = b - fb * (b - a) / (fb - fa)\n\n        # If secant step fails to decrease the interval sufficiently, do bisection.\n        # This is a heuristic: if `c` is in the last 10% of the interval at either end, use bisection.\n        bisection_step_needed = False\n        if math.fabs(c - b) < 0.1 * current_interval_width or \\\n           math.fabs(c - a) < 0.1 * current_interval_width:\n            bisection_step_needed = True\n\n        if bisection_step_needed:\n            c = (a + b) / 2.0\n\n        fc = _eval_poly(xs, c)\n\n        if fc == 0.0:\n            return c\n\n        # Update bracket based on sign of fc.\n        if math.copysign(1.0, fa) != math.copysign(1.0, fc):\n            b, fb = c, fc\n        else:\n            a, fa = c, fc\n\n    # If the loop completes, it means max_iter was reached without convergence.\n    raise RuntimeError(\"Failed to converge within maximum iterations.\")"}
