{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    seen_hashable = set()\n    seen_unhashable = []\n    unique_items = []\n\n    for item in l:\n        try:\n            # Try to hash the item for fast deduplication.\n            hash(item)\n            if item not in seen_hashable:\n                seen_hashable.add(item)\n                unique_items.append(item)\n        except TypeError:\n            # If item is unhashable, use equality comparison against a list.\n            if item not in seen_unhashable:\n                seen_unhashable.append(item)\n                unique_items.append(item)\n\n    # Attempt to sort the unique items using Python's default ordering.\n    try:\n        result = sorted(unique_items)\n    except TypeError:\n        # If default sorting fails (e.g., mixed unorderable types), fall back to a key-based sort.\n        try:\n            result = sorted(unique_items, key=lambda x: (type(x).__name__, str(x)))\n        except Exception:\n            # If key-based sorting also fails, return unique items in their original found order.\n            result = unique_items\n    except Exception:\n        # Catch any other unexpected errors during the primary sort, returning unsorted unique items.\n        result = unique_items\n\n    return result"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    if not l:\n        return []\n    try:\n        # Fast path for hashable elements\n        return sorted(set(l))\n    except TypeError:\n        # Contains unhashable elements: preserve first occurrence order while removing duplicates\n        seen = []\n        for item in l:\n            if item not in seen:\n                seen.append(item)\n        try:\n            # Try to return a sorted result if elements are comparable\n            return sorted(seen)\n        except TypeError:\n            # Mixed/comparable-incompatible types: return unique elements in original order\n            return seen"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    try:\n        it = iter(l)\n    except TypeError:\n        raise TypeError(\"max_element() arg must be iterable\")\n\n    try:\n        maximum = next(it)\n    except StopIteration:\n        raise ValueError(\"max_element() arg is an empty list\")\n\n    for item in it:\n        try:\n            if item > maximum:\n                maximum = item\n        except TypeError:\n            raise TypeError(\"Elements are not mutually comparable\")\n\n    return maximum"}
