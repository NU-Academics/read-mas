{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting.\n    If sum(first element, last element) is odd -> ascending order.\n    If the sum is even -> descending order.\n    The original array is not modified.\n    \"\"\"\n    if not array:\n        return []\n\n    arr_copy = list(array)\n    if (array[0] + array[-1]) % 2 == 1:\n        arr_copy.sort()\n    else:\n        arr_copy.sort(reverse=True)\n    return arr_copy"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Sorts characters within each word of a string, preserving word and space order.\n    Words are non-space sequences; characters are sorted by ASCII value.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    result_parts = []\n    i = 0\n    while i < len(s):\n        if s[i].isspace():\n            # Collect sequence of spaces\n            j = i\n            while j < len(s) and s[j].isspace():\n                j += 1\n            result_parts.append(s[i:j])\n            i = j\n        else:\n            # Collect word (sequence of non-space characters)\n            j = i\n            while j < len(s) and not s[j].isspace():\n                j += 1\n            word = s[i:j]\n            result_parts.append(\"\".join(sorted(word)))\n            i = j\n\n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the array based on the parity of the sum of its first and last elements.\n    Ascending if odd, descending if even.\n    \"\"\"\n    copied_array = list(array)\n\n    if len(copied_array) <= 1:\n        return copied_array\n\n    # Calculate sum of first and last elements\n    sum_first_last = copied_array[0] + copied_array[-1]\n\n    # Sort based on the parity of the sum\n    if sum_first_last % 2 != 0:  # Odd sum, sort in ascending order\n        copied_array.sort()\n    else:  # Even sum, sort in descending order\n        copied_array.sort(reverse=True)\n\n    return copied_array"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating lowercase letters forward by 4 positions.\n    Non-alphabetic characters remain unchanged, and the rotation wraps around.\"\"\"\n    result = []\n    shift = 4\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Calculate the new character by shifting its position\n            # within the 0-25 range and then converting back to ASCII.\n            new_char_code = ord('a') + (ord(char) - ord('a') + shift) % 26\n            result.append(chr(new_char_code))\n        else:\n            result.append(char)\n    return \"\".join(result)"}
