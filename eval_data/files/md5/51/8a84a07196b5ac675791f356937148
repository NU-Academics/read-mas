{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    return number - int(number)"}
{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Input is a string containing multiple groups of nested parentheses.\n    Separate those groups into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested\n    within each other. Ignore any spaces in the input string.\n\n    Raises ValueError on invalid characters or unbalanced parentheses.\n    \"\"\"\n    result: List[str] = []\n    current: List[str] = []\n    balance = 0\n\n    for ch in paren_string:\n        if ch.isspace():\n            continue\n        if ch == '(':\n            balance += 1\n            current.append(ch)\n        elif ch == ')':\n            if balance <= 0:\n                raise ValueError(\"Unbalanced parentheses: closing parenthesis without matching opening.\")\n            balance -= 1\n            current.append(ch)\n            if balance == 0:\n                result.append(''.join(current))\n                current = []\n        else:\n            raise ValueError(f\"Invalid character in input: {ch!r}\")\n\n    if balance != 0:\n        raise ValueError(\"Unbalanced parentheses: some opening parentheses are not closed.\")\n\n    return result"}
