tr: str) -> tuple[bool, int, int, int]:\n        \"\"\"Checks if the date string adheres to 'mm-dd-yyyy' format and parses components.\"\"\"\n        if not date_str:\n            return False, 0, 0, 0\n        \n        match = re.fullmatch(r'(\\d{2})-(\\d{2})-(\\d{4})', date_str)\n        if not match:\n            return False, 0, 0, 0\n        \n        try:\n            month = int(match.group(1))\n            day = int(match.group(2))\n            year = int(match.group(3))\n            return True, month, day, year\n        except ValueError:\n            return False, 0, 0, 0\n\n    def _is_valid_month(month: int) -> bool:\n        \"\"\"Validates if the month integer is within the range [1, 12].\"\"\"\n        return 1 <= month <= 12\n\n    def _is_valid_day(day: int, month: int, year: int) -> bool:\n        \"\"\"Validates if the day is within the correct range for the given month and year.\"\"\"\n        if not (1 <= day):\n            return False\n\n        if month in MONTHS_31_DAYS:\n            return day <= 31\n        elif month in MONTHS_30_DAYS:\n            return day <= 30\n        elif month == 2: # February\n            max_days = 29 if _is_leap_year(year) else 28\n            return day <= max_days\n        return False # Should not be reached if month is valid (checked before this function call)\n\n    # Main logic\n    is_format_valid, month, day, year = _is_valid_format(date)\n    if not is_format_valid:\n        return False\n    \n    if not _is_valid_month(month):\n        return False\n    \n    if not _is_valid_day(day, month, year):\n        return False\n        \n    return True", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["02-29-2021"]]}], "HumanEval/133": [{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"\n    Returns the sum of squared numbers in the given list,\n    rounding each element to the upper integer (Ceiling) first.\n    \"\"\"\n    