ch takes an array of integers and returns\n    the number of elements which has a sum of digits > 0.\n    If a number is negative, then its first signed digit will be negative:\n    e.g. -123 has signed digits -1, 2, and 3.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n\n    count = 0\n    for num in arr:\n        if not isinstance(num, int):\n            raise ValueError(f\"All elements in 'arr' must be integers. Found: {type(num)}\")\n        \n        if _calculate_signed_digit_sum(num) > 0:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/106": [{"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\" Implement the function f that takes n as a parameter,\n    and returns a list of size n, such that the value of the element at index i is the factorial of i if i is even\n    or the sum of numbers from 1 to i otherwise.\n    i starts from 1.\n    the factorial of i is the multiplication of the numbers from 1 to i (1 * 2 * ... * i).\n    Example:\n    f(5) == [1, 2, 6, 24, 15]\n    \"\"\"\n\n    def _calculate_factorial(num: int) -> int:\n        # Calculates the factorial of a non-negative integer.\n        if num == 0:\n            return 1\n        result = 1\n        for j in range(1, num + 1):\n            result *= j\n        return result\n\n    def _calculate_sum_up_to(num: int) -> int:\n        # Calculates the sum of numbers from 1 up to a positive integer.\n        return num * (num + 1) // 2\n\n    result_list = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # i is even\n            result_list.append(_calculate_factorial(i))\n        else:  # i is odd\n            result_list.append(_calculate_sum_up_to(i))\n    return result_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/110": [{"task_id": "HumanEval/110", "solut