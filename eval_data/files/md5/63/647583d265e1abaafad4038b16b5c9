mallest index in the array.\n    Returns [value, index] or an empty list if no even values are found or the array is empty.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            elif value == smallest_even_value and index < smallest_even_index:\n                # If values are equal, prioritize the smallest index\n                smallest_even_index = index\n\n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/57": [{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\"\"\"\n    if len(l) <= 1:\n        return True\n\n    # Check if the list is monotonically increasing (non-decreasing)\n    is_increasing = True\n    for i in range(1, len(l)):\n        if l[i] < l[i-1]:\n            is_increasing = False\n            break\n\n    if is_increasing:\n        return True\n\n    # If not increasing, check if the list is monotonically decreasing (non-increasing)\n    is_decreasing = True\n    for i in range(1, len(l)):\n        if l[i] > l[i-1]:\n            is_decreasing = False\n            break\n\n    return is_decreasing", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/65": [{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    is_negative = x < 0\n    x_str = str(abs(x))\n    num_digits = len(x_str)\n\n    if num_digits == 0:\n        return \"0\" if not is_negative else \"-0\"\n\n    if shift > num_digits:\n        result = x_str[::-1]\n    else:\n        effective_shift = shift % num_digits\n        result = x_str[-effective_shift:] + x_str[:-effective_shift]\n    \n    return \"-\" + result if is_negative else result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/69": [{"task_id": "HumanEval/69", "solution": "from collections import Counter\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    frequencies = Counter(lst)\n    \n    qualifying_integers = []\n    for num, freq in frequencies.items():\n        if freq >= num:\n            qualifying_integers.append(num)\n    \n    if not qualifying_integers:\n        return -1\n    \n    return max(qualifying_integers)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/71": [{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    '''\n    # Check for valid side lengths (must be positive) and triangle inequality\n    if not (a > 0 and b > 0 and c > 0 and\n            a + b > c and a + c > b and b + c > a):\n        return -1.0\n\n    # Calculate semi-perimeter\n    s = (a + b + c) / 2\n\n    # Calculate area using Heron's formula\n    area_squared = s * (s - a) * (s - b) * (s - c)\n    \n    # Handle potential floating point inaccuracies that might make area_squared slightly negative\n    if area_squared < 0:\n        area_squared = 0.0\n        \n    area = math.sqrt(area_squared)\n\n    # Round the area to 2 decimal points\n    return round(area, 2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/70": [{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    sorted_list = sorted(lst)\n    result = []\n    is_min_turn = True\n\n    while sorted_list:\n        if is_min_turn:\n            result.append(sorted_list.pop(0)) # Get minimum\n        else:\n            result.append(sorted_list.pop()) # Get maximum\n        is_min_turn = not is_min_turn\n    \n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/66": [{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII values of only the uppercase characters in the input string.\n    Returns 0 for an empty string or if no uppercase characters are found.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/73": [{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic. A palindromic array is an array that\n    is read the same backwards and forwards. In one change, you can change one element to any other element.\n\n    For example:\n    smallest_change([1,2,3,5,4,7,9,6]) == 4\n    smallest_change([1, 2, 3, 4, 3, 2, 2]) == 1\n    smallest_change([1, 2, 3, 2, 1]) == 0\n    \"\"\"\n    changes = 0\n    left = 0\n    right = len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/74": [{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    \"\"\"\n    Compares two lists of strings by their total character count.\n    Returns the list with fewer total characters; if counts are equal, returns the first list.\n    \"\"\"\n    \n    def calculate_total_chars(lst):\n        \"\"\"Calculates the sum of the lengths of all strings in the provided list.\"\"\"\n        return sum(len(s) for s in lst)\n\n    count1 = calculate_total_chars(lst1)\n    count2 = calculate_total_chars(lst2)\n\n    if count1 < count2:\n        return lst1\n    elif count2 < count1:\n        return lst2\n    else:\n        return lst1", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/67": [{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket.\n    \"\"\"\n\n    class InvalidInputFormatException(Exception):\n        \"\"\"Custom exception for invalid input string format.\"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n    class FruitParser:\n        \"\"\"Parses fruit counts from a string.\"\"\"\n        def parse_fruit_string(self, s: str) -> tuple[int, int]:\n            \"\"\"Parses the input string to find the counts of apples and oranges.\"\"\"\n            match = re.match(r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\", s.lower())\n            if not match:\n                raise InvalidInputFormatException(f\"Invalid fruit string format: '{s}'\")\n            \n            try:\n                apples = int(match.group(1))\n                oranges = int(match.group(2))\n            except ValueError:\n                raise InvalidInputFormatException(f\"Could not convert fruit counts to integers in '{s}'\")\n            \n            return apples, oranges\n\n    class FruitCalculator:\n        \"\"\"Calculates the number of mango fruits.\"\"\"\n        def __init__(self, parser: FruitParser):\n            self.parser = parser\n\n        def calculate_mangoes(self, fruit_string: str, total_fruits: int) -> int:\n            \"\"\"Calculates the number of mangoes in a basket.\"\"\"\n            if not isinstance(total_fruits, int) or total_fruits < 0:\n                raise ValueError(f\"Total fruits must be a non-negative integer, got: {total_fruits}\")\n\n            apples, oranges = self.parser.parse_fruit_string(fruit_string)\n\n            total_known_fruits = apples + oranges\n            if total_known_fruits > total_fruits:\n                raise ValueError(\n                    f\"Sum of apples ({apples}) and oranges ({oranges}) \"\n                    f\"exceeds total fruits ({total_fruits}).\"\n                )\n\n            return total_fruits - total_known_fruits\n\n    parser = FruitParser()\n    calculator = FruitCalculator(parser)\n    return calculator.calculate_mangoes(s, n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/72": [{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n\n    Example:\n    will_it_fly([1, 2], 5) \u279e False \n    # 1+2 is less than the maximum possible weight, but it's unbalanced.\n\n    will_it_fly([3, 2, 3], 1) \u279e False\n    # it's balanced, but 3+2+3 is more than the maximum possible weight.\n\n    will_it_fly([3, 2, 3], 9) \u279e True\n    # 3+2+3 is less than the maximum possible weight, and it's balanced.\n\n    will_it_fly([3], 5) \u279e True\n    # 3 is less than the maximum possible weight, and it's balanced.\n    '''\n    # Check if the list q is a palindrome\n    is_balanced = (q == q[::-1])\n\n    # Calculate the sum of elements in q\n    total_weight = sum(q)\n\n    # Check if the total weight is within the limit w\n    within_weight_limit = (total_weight <= w)\n\n    # The object flies if it's balanced AND its weight is within the limit\n    return is_balanced and within_weight_limit", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/75": [{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    def _sieve_of_eratosthenes(limit: int) -> list[int]:\n        \"\"\"Generates prime numbers up to a given limit using Sieve of Eratosthenes.\"\"\"\n        if limit <= 1:\n            return []\n        \n        is_prime = [True] * limit\n        is_prime[0] = is_prime[1] = False\n        \n        for p in range(2, int(limit**0.5) + 1):\n            if is_prime[p]:\n                for multiple in range(p * p, limit, p):\n                    is_prime[multiple] = False\n                    \n        primes = [p for p, prime_status in enumerate(is_prime) if prime_status]\n        return primes\n\n    if a < 2: \n        return False\n\n    primes = _sieve_of_eratosthenes(a + 1)\n    \n    n = len(primes)\n    for i in range(n):\n        p1 = primes[i]\n        if p1 * p1 * p1 > a: # Optimization: if p1^3 > a, no need to check further\n            break\n        for j in range(i, n): # Start from i to allow repeated primes (e.g., 2*2*3)\n            p2 = primes[j]\n            if p1 * p2 * p2 > a: # Optimization\n                break\n            for k in range(j, n): # Start from j\n                p3 = primes[k]\n                product = p1 * p2 * p3\n                if product == a:\n                    return True\n                if product > a: # Optimization: if product exceeds a, no need to check larger p3\n                    break\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/77": [{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Write a function that takes an integer a and returns True\n    if this ingeger is a cube of some integer number.\n    Note: you may assume the input is always valid.\n    Examples:\n    iscube(1) ==> True\n    iscube(2) ==> False\n    iscube(-1) ==> True\n    iscube(64) ==> True\n    iscube(0) ==> True\n    iscube(180) ==> False\n    '''\n    if a == 0:\n        return True\n\n    # Calculate the integer cube root candidate for the absolute value.\n    # Rounding helps mitigate potential floating-point inaccuracies when calculating fractional powers.\n    abs_a = abs(a)\n    cbrt_candidate = round(abs_a**(1/3))\n\n    # Re-cube the candidate and compare with the original number, preserving the sign.\n    if a < 0:\n        return (-cbrt_candidate * -cbrt_candidate * -cbrt_candidate) == a\n    else:\n        return (cbrt_candidate * cbrt_candidate * cbrt_candidate) == a", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/79": [{"task_id": "HumanEval/79", "solution": "