ogic for determining if an array can be sorted by right shifts.\"\"\"\n    def __init__(self):\n        \"\"\"Initializes the analyzer with required utility components.\"\"\"\n        self.shift_simulator = RightShiftSimulator()\n        self.sort_checker = SortChecker()\n\n    def find_rotation_point(self, arr: list[int]) -> int:\n        \"\"\"Finds the index of the single descent in a potentially rotated sorted array.\"\"\"\n        num_descents = 0\n        descent_idx = -1\n        for i in range(len(arr) - 1):\n            if arr[i] > arr[i+1]:\n                num_descents += 1\n                descent_idx = i\n        \n        if num_descents == 0:\n            return -1 # Array is already sorted\n        elif num_descents == 1:\n            return descent_idx # Found a single descent\n        else:\n            return -2 # Multiple descents, not a rotated sorted array\n\n    def analyze_sortability(self, arr: list[int]) -> bool:\n        \"\"\"Determines if the array can be sorted using right shift operations.\"\"\"\n        n = len(arr)\n        if n <= 1:\n            return True\n\n        rotation_point_idx = self.find_rotation_point(arr)\n\n        if rotation_point_idx == -1:\n            return True # Array is already sorted\n        elif rotation_point_idx == -2:\n            return False # Multiple descents, cannot be sorted by one rotation\n        else:\n            shifts = n - (rotation_point_idx + 1)\n            shifted_arr = self.shift_simulator.simulate_shifts(arr, shifts)\n            return self.sort_checker.is_non_decreasing(shifted_arr)\ndef move_one_ball(arr: list[int]) -> bool:\n    \"\"\"Determines if an array can be sorted in non-decreasing order using only right shift operations.\"\"\"\n    array_validator = ArrayValidator()\n    \n    if array_validator.is_empty(arr):\n        return True\n    \n    sortability_analyzer = SortabilityAnalyzer()\n    return sortability_analyzer.analyze_sortability(arr)", "base_status": "pass", "plu