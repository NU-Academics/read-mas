    k_largest_elements = self._k_finder.find_k_largest(self.input_array, self.k)\n        sorted_result = self._sorter.sort_ascending(k_largest_elements)\n\n        return sorted_result\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    processor = MaximumProcessor(arr, k)\n    return processor.process_maximum()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/122": [{"task_id": "HumanEval/122", "solution": "def _is_two_digit_or_less(value):\n    \"\"\"\n    Checks if an integer has at most two digits (absolute value <= 99).\n    Returns True if it qualifies, False otherwise.\n    \"\"\"\n    return -99 <= value <= 99\ndef _calculate_sum(elements):\n    \"\"\"\n    Calculates the sum of a list of integers.\n    Returns the total sum.\n    \"\"\"\n    return sum(elements)\ndef add_elements(arr, k):\n    \"\"\"\n    Given an array arr and integer k, sums elements with at most two digits from the first k elements.\n    Includes input validation and clear separation of concerns.\n    \"\"\"\n    _validate_inputs(arr, k)\n\n    first_k_elements = arr[:k]\n    qualifying_elements = [element for element in first_k_elements if _is_two_digit_or_less(element)]\n\n    return _calculate_sum(qualifying_elements)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, -2, -3, 41, 57, 76, 87, 88, 99], 3]], "plus_fail_tests": [[[98, 87, 76, 65, 54, 43, 32, 21, 10], 5]]}, {"task_id": "HumanEval/122", "solution": "def has_at_most_two_digits(value: int) -> bool:\n    \"\"\"Checks if an integer has at most two digits (absolute value <= 99).\"\"\"\n    return abs(value) <= 99\ndef extract_first_k(arr: list[int], k: int) -> list[int]:\n    \"\"\"Extracts the first k elements from the given array.\"\"\"\n    return arr[:k]\ndef filter_two_digit_elements(elements: list[int]) -> list