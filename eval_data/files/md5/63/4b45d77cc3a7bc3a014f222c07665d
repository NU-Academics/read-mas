ion": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP-SM formula and returns a formatted string.\n    Tie-breaking selects the first extension in list order.\n    \"\"\"\n\n    def _count_uppercase(text):\n        \"\"\"Counts uppercase letters in a string.\"\"\"\n        return sum(1 for char in text if char.isupper())\n\n    def _count_lowercase(text):\n        \"\"\"Counts lowercase letters in a string.\"\"\"\n        return sum(1 for char in text if char.islower())\n\n    def _calculate_strength(extension):\n        \"\"\"Calculates extension strength using the CAP - SM formula.\"\"\"\n        cap_count = _count_uppercase(extension)\n        sm_count = _count_lowercase(extension)\n        return cap_count - sm_count\n\n    def _find_strongest_extension(extensions_list):\n        \"\"\"Identifies the extension with the highest strength, applying tie-breaking.\"\"\"\n        if not extensions_list:\n            return \"\"\n\n        max_strength = float('-inf')\n        strongest_extension_name = \"\"\n\n        for extension in extensions_list:\n            current_strength = _calculate_strength(extension)\n            if current_strength > max_strength:\n                max_strength = current_strength\n                strongest_extension_name = extension\n            # Tie-breaking: if current_strength == max_strength,\n            # the first one encountered (already in strongest_extension_name) is kept.\n\n        return strongest_extension_name\n\n    def _format_result(name, extension):\n        \"\"\"Formats the class name and strongest extension into the required string.\"\"\"\n        return f\"{name}.{extension}\"\n\n    strongest_ext = _find_strongest_extension(extensions)\n    return _format_result(class_name, strongest_ext)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/153", "solution": "from typing import List\ndef count_uppercase(text: str) -> int:\n    \"\"\"Counts uppercase letters in a string.\n    Non-alphabetic characters are ignored.\"\"\"\n    count = 0\n    for char in text:\n        if char.isupper():\n            count += 1\n    return count\ndef count_lowercase(text: str) -> int:\n    \"\"\"Counts lowercase letters in a string.\n    Non-alphabetic characters are ignored.\"\"\"\n    count = 0\n    for char in text:\n        if char.islower():\n            count += 1\n    return count\ndef format_result(class_name: str, extension_name: str) -> str:\n    \"\"\"Formats the result string as 'ClassName.ExtensionName'.\"\"\"\n    return f\"{class_name}.{extension_name}\"\ndef calculate_strength(extension: str) -> int:\n    \"\"\"Calculates the strength of an extension using CAP - SM formula.\n    Uppercase letters are +1, lowercase letters are -1.\"\"\"\n    cap_count = count_uppercase(extension)\n    sm_count = count_lowercase(extension)\n    return cap_count - sm_count\ndef find_strongest_extension(extensions: List[str]) -> str:\n    \"\"\"Identifies the extension with the highest strength, handling tie-breaking.\n    Gracefully handles empty extension lists by returning an empty string.\"\"\"\n    \n    strongest_extension_name = \"\"\n    max_strength = float('-inf')\n\n    for i, current_extension in enumerate(extensions):\n        current_strength = calculate_strength(current_extension)\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = current_extension\n        # Tie-breaking: If current_strength == max_strength, the one encountered first is kept.\n\n    return strongest_extension_name\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"You will be given the name of a class (a string) and a list of extensions.\n    Find the strongest extension and return a string in this format: ClassName.StrongestExtensionName.\"\"\"\n    \n    strongest_ext = find_strongest_extension(extensions)\n 