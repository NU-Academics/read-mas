nuse)\n        return self.compare_floats(sum_of_squares, hypotenuse_squared)\nclass Triangle:\n    \"\"\"\n    Represents a triangle with three side lengths.\n    Provides structured access to side lengths and their arrangements.\n    \"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        self.sideA = a\n        self.sideB = b\n        self.sideC = c\n\n    def get_sides(self) -> tuple[float, float, float]:\n        \"\"\"Returns the triangle's side lengths as a tuple.\"\"\"\n        return (self.sideA, self.sideB, self.sideC)\n\n    def get_side_arrangements(self) -> list[tuple[float, float, float]]:\n        \"\"\"\n        Returns all permutations of sides where each side is considered the hypotenuse.\n        Each tuple is structured as (side1, side2, hypotenuse).\n        \"\"\"\n        return [\n            (self.sideA, self.sideB, self.sideC),  # c is hypotenuse\n            (self.sideA, self.sideC, self.sideB),  # b is hypotenuse\n            (self.sideB, self.sideC, self.sideA)   # a is hypotenuse\n        ]\nclass TriangleValidator:\n    \"\"\"\n    Validates triangle geometry, specifically for right-angled classification.\n    It delegates mathematical operations to GeometricCalculator.\n    \"\"\"\n    def __init__(self):\n        self.calculator = GeometricCalculator()\n\n    def validate_input(self, a: float, b: float, c: float) -> bool:\n        \"\"\"\n        Checks if all side lengths are positive, a basic geometric requirement.\n        This ensures the given lengths can form a physical triangle.\n        \"\"\"\n        return a > 0 and b > 0 and c > 0\n\n    def is_right_angled(self, triangle: Triangle) -> bool:\n        \"\"\"\n        Determines if the provided triangle instance is a right-angled triangle.\n        It checks all three possible hypotenuse arrangements using the theorem.\n        \"\"\"\n        arrangements = triangle.get_side_arrangements()\n        for side1, side2, hypotenuse in arrangements:\n            if self.apply_pythagorean_theorem(side1, side2, hypotenuse):\n                return True\n        return False\n\n    def apply_pythagorean_theorem(self, a: float, b: float, c: float) -> bool:\n        \"\"\"\n        Applies the Pythagorean theorem (a\u00b2 + b\u00b2 = c\u00b2) to three given sides.\n        It uses the GeometricCalculator for accurate floating-point comparisons.\n        \"\"\"\n        return self.calculator.check_pythagorean(a, b, c)\ndef right_angle_triangle(a, b, c):\n    \"\"\"\n    Given three side lengths, determines if they form a right-angled triangle.\n    Returns True if right-angled, False otherwise, based on the Pythagorean theorem.\n    \"\"\"\n    validator = TriangleValidator()\n\n    # Validate inputs for basic geometric conditions (e.g., positive lengths).\n    if not validator.validate_input(a, b, c):\n        return False\n\n    triangle = Triangle(a, b, c)\n    return validator.is_right_angled(triangle)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "def count_unique_characters(word: str) -> int:\n    \"\"\"Counts the number of unique characters in a given string.\n    It converts the string to a set to efficiently count unique elements.\n    \"\"\"\n    return len(set(word))\ndef find_max(words: list[str]) -> str:\n    \"\"\"Finds the word with the maximum number of unique characters from a list of strings.\n    In case of a tie, it selects the word that comes first in lexicographical order.\n    \"\"\"\n    # Sort the words based on two criteria:\n    # 1. Number of unique characters (descending, hence the negative sign)\n    # 2. Lexicographical order (ascending, default for strings)\n    return sorted(words, key=lambda word: (-count_unique_characters(word), word))[0]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/158", "solution": "def _count_unique_chars(word):\n    \"\"\"Counts the number of unique characters in a given string.\n    It uses a set to store unique characters and returns its size.\"\"\"\n    return len(set(word))\ndef _lexicographical_compare(word1, word2):\n    \"\"\"Compares two strings lexicographically.\n    Returns -1 if word1 < word2, 0 if word1 == word2, and 1 if word1 > word2.\"\"\"\n    if word1 < word2:\n        return -1\n    elif word1 == word2:\n        return 0\n    else:\n        return 1\ndef find_max(words):\n    \"\"\"Finds the string with the maximum number of unique characters.\n    In case of ties, it returns the lexicographically first string.\"\"\"\n    if not words:\n        return \"\"\n\n    max_word = words[0]\n    max_unique_chars = _count_unique_chars(words[0])\n\n    for i in range(1, len(words)):\n        current_word = words[i]\n        current_unique_chars = _count_unique_chars(current_word)\n\n        if current_unique_chars > max_unique_chars:\n            max_unique_chars = current_unique_chars\n            max_word = current_word\n        elif current_unique_chars == max_unique_chars:\n            # If unique counts are equal, use lexicographical comparison to break ties.\n            if _lexicographical_compare(current_word, max_word) == -1:\n                max_word = current_word\n    \n    return max_word", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "from typing import List\ndef calculate_consumption(need: int, remaining: int) -> int:\n    \"\"\"Determines the actual number of carrots to be consumed.\"\"\"\n    return min(need, remaining)\ndef determine_total_eaten(number: int, consumed: int) -> int:\n    \"\"\"Calculates the cumulative total of carrots eaten.\"\"\"\n    return number + consumed\ndef format_result(total_eaten: int, carrots_left: int) -> List[int]:\n    \"\"\"Formats the calculated results into the required array structure.\"\"\