erm):\n        return term // 2\n    else:\n        return 3 * term + 1\ndef generate_collatz_sequence(n: int) -> List[int]:\n    \"\"\"Generates the complete Collatz sequence from a starting number n down to 1.\n    The sequence is built by repeatedly applying the Collatz rule.\n    \"\"\"\n    sequence = [n]\n    current_term = n\n    while current_term != 1:\n        current_term = apply_collatz_rule(current_term)\n        sequence.append(current_term)\n    return sequence\ndef extract_odd_numbers(sequence: List[int]) -> List[int]:\n    \"\"\"Filters a list of numbers, returning only the odd numbers.\n    It iterates through the sequence and includes numbers that are not even.\n    \"\"\"\n    return [num for num in sequence if not is_even(num)]\ndef sort_numbers(numbers: List[int]) -> List[int]:\n    \"\"\"Sorts a list of numbers in increasing order.\n    It returns a new list with the elements arranged from smallest to largest.\n    \"\"\"\n    return sorted(numbers)\ndef get_odd_collatz(n: int) -> List[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    This function orchestrates the Collatz sequence generation, odd number extraction, and sorting.\n    \"\"\"\n    # Handle the special case where n is 1, as its sequence is simply [1].\n    if n == 1:\n        return [1]\n\n    # Generate the full Collatz sequence starting from n.\n    collatz_sequence = generate_collatz_sequence(n)\n\n    # Extract only the odd numbers from the generated sequence.\n    odd_numbers = extract_odd_numbers(collatz_sequence)\n\n    # Sort the extracted odd numbers in increasing order.\n    sorted_odd_numbers = sort_numbers(odd_numbers)\n\n    return sorted_odd_numbers", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/124": [{"task_id": "HumanEval/124", "solution": "class DateComponents:\n    \"\"\"Data structure for holding parsed date components.\"\"\"\n    def __init__(self, month, day, year):\n        self.month = month\n        self.day = day\n        self.year = year\n\n    def is_complete(self):\n        \"\"\"Checks if all date components are present.\"\"\"\n        return self.month is not None and self.day is not None and self.year is not None\nclass DateParser:\n    \"\"\"Parses date strings into month, day, year components.\"\"\"\n    def parse_date_string(self, date_string):\n        \"\"\"Extracts month, day, and year from the date string.\"\"\"\n        month, day, year = self._extract_components(date_string)\n        return DateComponents(month, day, year)\n\n    def _extract_components(self, date_string):\n        \"\"\"Internal method to split and convert date string parts.\"\"\"\n        parts = date_string.split('-')\n        if len(parts) == 3:\n            try:\n                month_val = int(parts[0])\n                day_val = int(parts[1])\n                year_val = int(parts[2])\n                return month_val, day_val, year_val\n            except ValueError:\n                pass\n        return None, None, None\nclass FormatValidator:\n    \"\"\"Validates the mm-dd-yyyy format with hyphen separators.\"\"\"\n    def is_valid_format(self, date_string):\n        \"\"\"Checks if the date string conforms to mm-dd-yyyy format.\"\"\"\n        if len(date_string) != 10:\n            return False\n        return self._check_hyphen_separators(date_string)\n\n    def _check_hyphen_separators(self, date_string):\n        \"\"\"Ensures hyphens are at the correct positions.\"\"\"\n        return date_string[2] == '-' and date_string[5] == '-'\nclass MonthValidator:\n    \"\"\"Validates month values are between 1-12.\"\"\"\n    MIN_MONTH = 1\n    MAX_MONTH = 12\n\n    def is_valid_month(self, month):\n        \"\"\"Checks if the given month is within the valid range.\"\"\"\n        return self.MIN_MONTH <= month <= self.MAX_MONTH\nclass DayValidator:\n    \"\"\"Validates day values based on month type.\"\"\"\n    MONTHS_31_DAYS = {1, 3, 5, 7, 8, 10, 12}\n    MONTHS_30_DAYS = {4, 6, 9, 11}\n    FEBRUARY = 2\n\n    def is_valid_day(self, day, month):\n        \"\"\"Checks if the day is valid for the given month.\"\"\"\n        if not (1 <= day):\n            return False\n        \n        max_days = self._get_max_days_for_month(month)\n        return day <= max_days\n\n    def _get_max_days_for_month(self, month):\n        \"\"\"Determines the maximum number of days for a given month.\"\"\"\n        if month in self.MONTHS_31_DAYS:\n            return 31\n        elif month in self.MONTHS_30_DAYS:\n            return 30\n        elif month == self.FEBRUARY:\n            return 29\n        return 0 # Return 0 for invalid months to ensure day validation fails\ndef valid_date(date):\n    \"\"\"Validates a given date string according to specific format and range rules.\"\"\"\n    if not date:\n        return False\n\n    format_validator = FormatValidator()\n    date_parser = DateParser()\n    month_validator = MonthValidator()\n    day_validator = DayValidator()\n\n    if not format_validator.is_valid_format(date):\n        return False\n\n    date_components = date_parser.parse_date_string(date)\n\n    if not date_components.is_complete():\n        return False\n\n    month = date_components.month\n    day = date_components.day\n\n    if not month_validator.is_valid_month(month):\n        return False\n\n    if not day_validator.is_valid_day(day, month):\n        return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/124", "solution": "_MONTH_DAYS = {\n    1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n    4: 30, 6: 30, 9: 30, 11: 30,\n    2: 29 # Month 2 has a maximum of 29 days as per requirements.\n}\n_MIN_MONTH = 1\n_MAX_MONTH = 12\n_MIN_DAY = 1\ndef _is_empty(date_string):\n    \"\"\"Checks if the input date string is empty or None.\n    Returns True if empty, False otherwise.\"\"\"\n    return not date_string\ndef _validate_format(date_string):\n    \"\"\"Validates date string adheres to the mm-dd-yyyy format with hyphens.\n    Checks length, hyphen positions, and if all other parts are digits.\"\"\"\n    if len(date_string) != 10:\n        return False\n    if date_string[2] != '-' or date_string[5] != '-':\n        return False\n    \n    mm_part = date_string[0:2]\n    dd_part = date_string[3:5]\n    yyyy_part = date_string[6:10]\n    \n    return mm_part.isdigit() and dd_part.isdigit() and yyyy_part.isdigit()\ndef _parse_date(date_string):\n    \"\"\"Parses a correctly formatted date string into month, day, and year integers.\n    Returns a tuple (month, day, year).\"\"\"\n    parts = date_string.split('-')\n    month = int(parts[0])\n    day = int(parts[1])\n    year = int(parts[2])\n    return (month, day, year)\ndef _validate_month(month):\n    \"\"\"Validates if the month integer is within the required range (1-12).\n    Returns True if valid, False otherwise.\"\"\"\n    return _MIN_MONTH <= month <= _MAX_MONTH\ndef _get_max_days(month):\n    \"\"\"Retrieves the maximum number of days for a given month.\n    Uses predefined constants, returning 0 for an invalid month.\"\"\"\n    return _MONTH_DAYS.get(month, 0)\ndef _validate_day(day, month):\n    \"\"\"Validates if the day integer is within the valid range for the specified month.\n    Checks against the minimum day and the month's maximum days.\"\"\"\n    if day < _MIN_DAY:\n        return False\n    \n    max_days = _get_max_days(month)\n    return day <= max_days\ndef valid_date(date):\n    \"\"\"Validates a given date string for correctness based on several rules.\n    It checks for emptiness, format, and then month and day ranges sequentially.\"\"\"\n    if _is_empty(date):\n        return False\n    \n    if not _validate_format(date):\n        return False\n        \n    month, day, year = _parse_date(date)\n    \n    if not _validate_month(month):\n        return False\n        \n    if not _validate_day(day, month):\n        return False\n        \n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "from typing import List, Union\ndef _has_whitespace(txt: str) -> bool:\n    \"\"\"Detect presence of whitespace characters in string.\"\"\"\n    return any(c.isspace() for c in txt)\ndef _has_commas(txt: str) -> bool:\n    \"\"\"Detect presence of comma characters in string.\"\"\"\n    return ',' in txt\ndef _is_odd_position_letter(char: str) -> bool:\n    \"\"\"Determine if character is a lowercase letter at an odd alphabetical position (0-indexed).\"\"\"\n    if char.islower():\n        position = ord(char) - ord('a')\n        return position % 2 != 0\n    return False\ndef _count_odd_letters(txt: str) -> int:\n    \"\"\"Count lowercase letters in the string that are at odd alphabetical positions (0-indexed).\"\"\"\n    count = 0\n    for char in txt:\n        if _is_odd_position_letter(char):\n            count += 1\n    return count\ndef split_words(txt: str) -> Union[List[str], int]:\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    '''\n    if _has_whitespace(txt):\n        return txt.split()\n    elif _has_commas(txt):\n        return txt.split(',')\n    else:\n        return _count_odd_letters(txt)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/125", "solution": "def _has_whitespace(txt: str) -> bool:\n    \"\"\"Checks if the input string contains any whitespace characters.\"\"\"\n    return any(char.isspace() for char in txt)\ndef _has_commas(txt: str) -> bool:\n    \"\"\"Checks if the input string contains any comma characters.\"\"\"\n    return ',' in txt\ndef _is_odd_position(char: str) -> bool:\n    \"\"\"Determines if a lowercase character's 0-based alphabet position is odd.\"\"\"\n    if 'a' <= char <= 'z':\n        position = ord(char) - ord('a')\n        return position % 2 != 0\n    return False\ndef _count_odd_lowercase(txt: str) -> int:\n    \"\"\"Counts lowercase letters in the string that have an odd 0-based alphabet position.\"\"\"\n    count = 0\n    for char in txt:\n        if _is_odd_position(char):\n            count += 1\n    return count\ndef split_words(txt):\n    \"\"\"\n    Processes a string by splitting on whitespace, then commas, or counting odd-positioned lowercase letters.\n    The processing precedence is whitespace > commas > odd letter count.\n    \"\"\"\n    if _has_whitespace(txt):\n        return txt.split()\n    elif _has_commas(txt):\n        return txt.split(',')\n    else:\n        return _count_odd_lowercase(txt)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/126": [{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"\n    Main validation function for sorted order and duplicate constraints.\n    Returns True if the list is sorted with valid duplicates, False otherwise.\n    \"\"\"\n    # FR-002: Single element check\n    if len(lst) <= 1:\n        return True\n\n    # FR-004: Ascending order check\n    if not _check_ascending_order(lst):\n        return False\n\n    # FR-005: Duplicate constraint check\n    if not _check_duplicate_constraint(lst):\n        return False\n\n    # FR-003, FR-006: Return True for valid sorted list\n    return True\ndef _check_ascending_order(lst):\n    \"\"\"\n    Validates if the list is in ascending order.\n    Returns False if any element is smaller than its predecessor.\n    \"\"\"\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i-1]:\n            return False\n    return True\ndef _check_duplicate_constraint(lst):\n    \"\"\"\n    Validates that no number appears more than twice.\n    Returns False if any number has more than two occurrences.\n    \"\"\"\n    for num in set(lst):\n        if _count_occurrences(lst, num) > 2:\n            return False\n    return True\ndef _count_occurrences(lst, num):\n    \"\"\"\n    Helper function to count occurrences of a number in a list.\n    Returns the total count of the specified number.\n    \"\"\"\n    return lst.count(num)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/126", "solution": "def _validate_input(lst):\n    \"\"\"This function validates input elements for non-negativity.\n    As per critical constraints, it trusts the input and always returns True.\"\"\"\n    return True\ndef _count_occurrences(lst, number):\n    \"\"\"Counts how many times a specific number appears in the given list.\"\"\"\n    count = 0\n    for item in lst:\n        if item == number:\n            count += 1\n    return count\ndef _validate_duplicate_constraint(lst):\n    \"\"\"Checks if any number in the list appears more than two times.\"\"\"\n    checked_numbers = set()\n    for number in lst:\n        if number not in checked_numbers:\n            if _count_occurrences(lst, number) > 2:\n                return False\n            checked_numbers.add(number)\n    return True\ndef _check_ascending_order(lst):\n    \"\"\"Verifies if the list elements are arranged in strictly ascending order.\"\"\"\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i-1]:\n            return False\n    return True\ndef _validate_sorting(lst):\n    \"\"\"Validates if the list is sorted in ascending order, including single-element lists.\"\"\"\n    if len(lst) <= 1:\n        return True\n    return _check_ascending_order(lst)\ndef is_sorted(lst):\n    \"\"\"\n    Given a list of numbers, return whether they are sorted in ascending order\n    with at most two occurrences of any single number.\n    \"\"\"\n    if not _validate_input(lst):\n        return False\n\n    if not _validate_sorting(lst):\n        return False\n\n    if not _validate_duplicate_constraint(lst):\n        return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "def is_prime(n):\n    \"\"\"Determines if a number is prime.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\ndef calculate_intersection(interval1, interval2):\n    \"\"\"Calculates the intersection of two closed intervals.\"\"\"\n    start1, end1 = interval1\n    start2, end2 = interval2\n    intersection_start = max(start1, start2)\n    intersection_end = min(end1, end2)\n    if intersection_start <= intersection_end:\n        return (intersection_start, intersection_end)\n    else:\n        return None\ndef get_intersection_length(intersection_interval):\n    \"\"\"Calculates the length of an intersection interval.\"\"\"\n    start, end = intersection_interval\n    return end - start + 1\ndef intersection(interval1, interval2):\n    \"\"\"Determines if the length of intersection between two intervals is a prime number.\"\"\"\n    intersect_result = calculate_intersection(interval1, interval2)\n    if intersect_result is None:\n        return \"NO\"\n    length = get_intersection_length(intersect_result)\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-1, 1], [0, 4]]], "plus_fail_tests": [[[10, 20], [15, 25]]]}, {"task_id": "HumanEval/127", "solution": "def validate_interval(interval):\n    \"\"\"Validates if an interval (start, end) is well-formed (start <= end).\n    This function assumes intervals are valid per problem statement and provides a structural check.\"\"\"\n    return interval[0] <= interval[1]\ndef get_interval_length(start, end):\n    \"\"\"Calculates the length of a closed interval [start, end].\"\"\"\n    return end - start\ndef get_intersection_bounds(interval1, interval2):\n    \"\"\"Determines the start and end points of the potential intersection of two intervals.\"\"\"\n    start1, end1 = interval1\n    start2, end2 = interval2\n    \n    intersection_start = max(start1, start2)\n    intersection_end = min(end1, end2)\n    \n    return intersection_start, intersection_end\ndef has_intersection(interval1, interval2):\n    \"\"\"Checks if two closed intervals have an intersection.\"\"\"\n    int_start, int_end = get_intersection_bounds(interval1, interval2)\n    return int_start <= int_end\ndef calculate_intersection(interval1, interval2):\n    \"\"\"Computes the intersection interval as a (start, end) tuple.\"\"\"\n    return get_intersection_bounds(interval1, interval2)\ndef is_prime(number):\n    \"\"\"Determines if a given non-negative integer is a prime number.\"\"\"\n    if number <= 1:\n        return False\n    if number <= 3:\n        return True\n    if number % 2 == 0 or number % 3 == 0:\n        return False\n    \n    i = 5\n    while i * i <= number:\n        if number % i == 0 or number % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef intersection(interval1, interval2):\n    \"\"\"Determines if the length of intersection between two closed intervals is a prime number.\"\"\"\n\n    validate_interval(interval1) \n    validate_interval(interval2) \n\n    if not has_intersection(interval1, interval2):\n        return \"NO\"\n\n    int_start, int_end = calculate_intersection(interval1, interval2)\n    \n    intersection_length = get_interval_length(int_start, int_end)\n    \n    if is_prime(intersection_length):\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/128": [{"task_id": "HumanEval/128", "solution": "def _get_sign(num):\n    \"\"\"Determines the mathematical sign of an integer.\n    Returns 1 for positive, -1 for negative, and 0 for zero.\n    \"\"\"\n    if num > 0:\n        return 1\n    elif num < 0:\n        return -1\n    else:\n        return 0\ndef _validate_input(arr):\n    \"\"\"Validates if the input array is not empty.\n    Returns False if empty, True otherwise.\n    \"\"\"\n    return len(arr) > 0\ndef _calculate_magnitude_sum(arr):\n    \"\"\"Calculates the sum of the absolute values of all integers in the array.\n    This operation handles arbitrary precision integers gracefully in Python.\n    \"\"\"\n    total_magnitude = 0\n    for num in arr:\n        total_magnitude += abs(num)\n    return total_magnitude\ndef _calculate_sign_product(arr):\n    \"\"\"Calculates the product of the signs of all integers in the array.\n    If any number is zero, the product of signs is zero.\n    \"\"\"\n    product_of_signs = 1\n    for num in arr:\n        sign = _get_sign(num)\n        if sign == 0:\n            return 0  # Short-circuit if a zero is found, as the product will be zero.\n        product_of_signs *= sign\n    return product_of_signs\ndef prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of all signs\n    of each number in the array. Returns None for an empty array.\n    \"\"\"\n    if not _validate_input(arr):\n        return None\n\n    magnitude_sum = _calculate_magnitude_sum(arr)\n    sign_product = _calculate_sign_product(arr)\n\n    return magnitude_sum * sign_product", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculate sum of magnitudes multiplied by product of signs.\n    Handles empty arrays by returning None and zero elements by returning 0.\n    \"\"\"\n    if not arr:\n        return None\n\n    magnitude_sum = 0\n    sign_product = 1\n    has_zero = False\n\n    for num in arr:\n        magnitude_sum += abs(num)\n\n        if num == 0:\n            has_zero = True\n        elif num < 0:\n            sign_product *= -1\n\n    if has_zero:\n        return 0\n    else:\n        return magnitude_sum * sign_product", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically smallest path of exactly k cells in a grid.\n    Movement is restricted to edge-adjacent neighbors, and cell revisits are allowed.\n    \"\"\"\n\n    # --- Utility Layer: GridNavigator ---\n    class GridNavigator:\n        \"\"\"Manages grid navigation, neighbor identification, and boundary checks.\"\"\"\n\n        @staticmethod\n        def is_valid_position(grid_ref, r, c):\n            \"\"\"Checks if a given (row, col) is within the grid boundaries.\"\"\"\n            n_dim = len(grid_ref)\n            return 0 <= r < n_dim and 0 <= c < n_dim\n\n        @staticmethod\n        def get_neighbors(grid_ref, r, c):\n            \"\"\"Returns a list of valid neighbor (row, col) tuples for a given cell.\"\"\"\n            neighbors = []\n            moves = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n            for dr, dc in moves:\n                nr, nc = r + dr, c + dc\n                if GridNavigator.is_valid_position(grid_ref, nr, nc):\n                    neighbors.append((nr, nc))\n            return neighbors\n    \n    # --- Validation Layer: GridValidator ---\n    class GridValidator:\n        \"\"\"Validates grid structure, dimensions, and unique value constraints.\"\"\"\n\n        @staticmethod\n        def validate_dimensions(grid_ref):\n            \"\"\"Ensures the grid is N x N with N >= 2.\"\"\"\n            n_dim = len(grid_ref)\n            if n_dim < 2:\n                return False\n            for row in grid_ref:\n                if len(row) != n_dim:\n                    return False\n            return True\n\n        @staticmethod\n        def validate_values(grid_ref):\n            \"\"\"Checks if all values are unique and in range [1, N*N].\"\"\"\n            n_dim = len(grid_ref)\n            expected_values = set(range(1, n_dim * n_dim + 1))\n            actual_values = set()\n            for r in range(n_dim):\n                for c in range(n_dim):\n                    actual_values.add(grid_ref[r][c])\n            return actual_values == expected_values\n\n        @staticmethod\n        def grid_validator(grid_ref):\n            \"\"\"Main validation method, combining dimension and value checks.\"\"\"\n            return GridValidator.validate_dimensions(grid_ref) and GridValidator.validate_values(grid_ref)\n\n    # --- Core Algorithm Layer: PathComparator ---\n    class PathComparator:\n        \"\"\"Compares two paths lexicographically.\"\"\"\n\n        @staticmethod\n        def lexicographic_compare(path1, path2):\n            \"\"\"Compares two paths and returns -1 if path1 < path2, 1 if path1 > path2, 0 if equal.\"\"\"\n            for i in range(len(path1)):\n                if path1[i] < path2[i]:\n                    return -1\n                elif path1[i] > path2[i]:\n                    return 1\n            return 0 # Paths are identical\n\n    # --- Core Algorithm Layer: PathBuilder ---\n    class PathBuilder:\n        \"\"\"Constructs all possible paths of a given length from a starting position.\"\"\"\n\n        @staticmethod\n        def build_paths_recursive(grid_ref, current_path_values, r, c, remaining_steps, all_paths):\n            \"\"\"Recursively builds paths of a specified length.\"\"\"\n            current_path_values = current_path_values + [grid_ref[r][c]]\n\n            if remaining_steps == 1:\n                all_paths.append(current_path_values)\n                return\n\n            neighbors = GridNavigator.get_neighbors(grid_ref, r, c)\n            for nr, nc in neighbors:\n                PathBuilder.build_paths_recursive(grid_ref, current_path_values, nr, nc, remaining_steps - 1, all_paths)\n\n        @staticmethod\n        def path_builder(grid_ref, start_row, start_col, k_len):\n            \"\"\"Initiates the recursive path building process from a start cell.\"\"\"\n            all_paths_from_start = []\n            PathBuilder.build_paths_recursive(grid_ref, [], start_row, start_col, k_len, all_paths_from_start)\n            return all_paths_from_start\n\n    # --- Core Algorithm Layer: PathFinder Engine ---\n    class PathFinder:\n        \"\"\"Core engine for finding the optimal path given the grid and path length k.\"\"\"\n\n        @staticmethod\n        def path_finder(grid_ref, k_len):\n            \"\"\"Finds the lexicographically smallest path of length k in the grid.\"\"\"\n            n_dim = len(grid_ref)\n\n            # Optimization for k=1: return minimum grid value\n            if k_len == 1:\n                min_val = float('inf')\n                for r in range(n_dim):\n                    for c in range(n_dim):\n                        if grid_ref[r][c] < min_val:\n                            min_val = grid_ref[r][c]\n                return [min_val]\n\n            min_overall_path = None\n\n            # Iterate through all possible starting positions\n            for r_start in range(n_dim):\n                for c_start in range(n_dim):\n                    possible_paths_from_start = PathBuilder.path_builder(grid_ref, r_start, c_start, k_len)\n\n                    # Compare generated paths to find the lexicographically smallest\n                    for current_path in possible_paths_from_start:\n                        if min_overall_path is None or PathComparator.lexicographic_compare(current_path, min_overall_path) == -1:\n                            min_overall_path = current_path\n            \n            return min_overall_path\n\n    # --- minPath Function Entry Point ---\n\n    # Call the grid validator as per design, assuming valid input as per requirements.\n    GridValidator.grid_validator(grid) \n\n    # Delegate to the PathFinder to execute the core algorithm.\n    result_path = PathFinder.path_finder(grid, k)\n\n    return result_path", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[12, 13, 10, 1], [9, 3, 15, 6], [5, 16, 14, 4], [11, 8, 7, 2]], 12]], "plus_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 15]]}, {"task_id": "HumanEval/129", "solution": "from typing import List, Tuple, Optional\nclass Cell:\n    \"\"\"Represents a single cell in the grid with its value and position.\"\"\"\n    def __init__(self, value: int, row: int, col: int):\n        self._value = value\n        self._row = row\n        self._col = col\n\n    def get_value(self) -> int:\n        \"\"\"Returns the integer value of the cell.\"\"\"\n        return self._value\n\n    def get_position(self) -> Tuple[int, int]:\n        \"\"\"Returns the (row, col) coordinates of the cell.\"\"\"\n        return (self._row, self._col)\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"Compares two Cell objects for equality based on position and value.\"\"\"\n        if not isinstance(other, Cell):\n            return NotImplemented\n        return self._row == other._row and self._col == other._col and self._value == other._value\n\n    def __hash__(self) -> int:\n        \"\"\"Returns a hash for the cell, allowing it to be used in sets/dicts.\"\"\"\n        return hash((self._value, self._row, self._col))\n\n    def __str__(self) -> str:\n        \"\"\"Returns a string representation of the cell.\"\"\"\n        return f\"Cell({self._value}, {self._row}, {self._col})\"\nclass Path:\n    \"\"\"Represents a sequence of cells forming a path.\"\"\"\n    def __init__(self):\n        self._cells: List[Cell] = []\n        self._values: List[int] = []\n        self._length = 0\n\n    def add_cell(self, cell: Cell):\n        \"\"\"Adds a cell to the end of the path.\"\"\"\n        self._cells.append(cell)\n        self._values.append(cell.get_value())\n        self._length += 1\n\n    def get_values(self) -> List[int]:\n        \"\"\"Returns an ordered list of cell values in the path.\"\"\"\n        return self._values\n\n    def get_length(self) -> int:\n        \"\"\"Returns the current length of the path.\"\"\"\n        return self._length\n\n    def copy(self) -> 'Path':\n        \"\"\"Creates a shallow copy of the path.\"\"\"\n        new_path = Path()\n        new_path._cells = list(self._cells)\n        new_path._values = list(self._values)\n        new_path._length = self._length\n        return new_path\n\n    def is_complete(self, target_length: int) -> bool:\n        \"\"\"Checks if the path has reached the target length.\"\"\"\n        return self._length == target_length\nclass Grid:\n    \"\"\"Manages the grid structure and provides cell access and neighbor lookup.\"\"\"\n    def __init__(self, grid_data: List[List[int]]):\n        self._n = len(grid_data)\n        self._cells: List[List[Cell]] = [[Cell(0,0,0) for _ in range(self._n)] for _ in range(self._n)]\n\n        for r in range(self._n):\n            for c in range(self._n):\n                self._cells[r][c] = Cell(grid_data[r][c], r, c)\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        \"\"\"Returns the Cell object at the specified row and column.\"\"\"\n        return self._cells[row][col]\n\n    def get_neighbors(self, row: int, col: int) -> List[Cell]:\n        \"\"\"Returns a list of edge-adjacent neighbor cells.\"\"\"\n        neighbors = []\n        directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n        for dr, dc in directions:\n            new_row, new_col = row + dr, col + dc\n            if self._is_valid_position(new_row, new_col):\n                neighbors.append(self.get_cell(new_row, new_col))\n        return neighbors\n\n    def get_dimensions(self) -> int:\n        \"\"\"Returns the dimension N of the N\u00d7N grid.\"\"\"\n        return self._n\n\n    def _is_valid_position(self, row: int, col: int) -> bool:\n        \"\"\"Checks if a given (row, col) position is within grid boundaries.\"\"\"\n        return 0 <= row < self._n and 0 <= col < self._n\nclass GridValidator:\n    \"\"\"Validates the input grid matrix according to specified rules.\"\"\"\n    def validate_grid(self, grid: List[List[int]]):\n        \"\"\"Validates grid dimensions and cell values, raising ValueError on failure.\"\"\"\n        if not self._validate_dimensions(grid):\n            raise ValueError(\"Invalid grid dimensions: N must be >= 2 and grid must be N\u00d7N.\")\n        n = len(grid)\n        if not self._validate_values(grid, n):\n            raise ValueError(f\"Invalid grid values: values must be unique integers from 1 to {n*n}.\")\n        return True\n\n    def _validate_dimensions(self, grid: List[List[int]]) -> bool:\n        \"\"\"Checks if the grid is N\u00d7N with N >= 2.\"\"\"\n        n = len(grid)\n        if n < 2:\n            return False\n        for row in grid:\n            if len(row) != n:\n                return False\n        return True\n\n    def _validate_values(self, grid: List[List[int]], n: int) -> bool:\n        \"\"\"Checks if grid contains unique integer values from 1 to N*N.\"\"\"\n        all_values = []\n        for row in grid:\n            all_values.extend(row)\n        \n        if len(all_values) != n * n:\n            return False\n        \n        unique_values = set(all_values)\n        if len(unique_values) != n * n:\n            return False\n        \n        expected_values_sum = n * n * (n * n + 1) // 2\n        actual_values_sum = sum(unique_values)\n\n        return actual_values_sum == expected_values_sum\nclass PathComparator:\n    \"\"\"Compares two paths lexicographically.\"\"\"\n    def _is_lexicographically_smaller(self, values1: List[int], values2: List[int]) -> bool:\n        \"\"\"Checks if the first list of values is lexicographically smaller than the second.\"\"\"\n        for i in range(len(values1)):\n            if values1[i] < values2[i]:\n                return True\n            if values1[i] > values2[i]:\n                return False\n        return False\nclass PathFinder:\n    \"\"\"Implements the pathfinding algorithm to find the lexicographically smallest path.\"\"\"\n    def __init__(self, grid: Grid, k: int):\n        self._grid = grid\n        self._k = k\n        self._min_path: Optional[Path] = None\n        self._path_comparator = PathComparator()\n\n    def find_minimum_path(self) -> List[int]:\n        \"\"\"Discovers and returns the lexicographically smallest path of length k.\"\"\"\n        n = self._grid.get_dimensions()\n        for r in range(n):\n            for c in range(n):\n                start_cell = self._grid.get_cell(r, c)\n                self._explore_from_cell(start_cell, Path(), self._k)\n        \n        return self._min_path.get_values()\n\n    def _explore_from_cell(self, cell: Cell, current_path: Path, remaining_steps: int):\n        \"\"\"Recursively explores paths from a given cell, applying lexicographic pruning.\"\"\"\n        new_path = current_path.copy()\n        new_path.add_cell(cell)\n\n        if remaining_steps == 1:\n            if self._min_path is None or self._path_comparator._is_lexicographically_smaller(new_path.get_values(), self._min_path.get_values()):\n                self._min_path = new_path\n            return\n        \n        # Lexicographic pruning: if current path prefix is already worse than the best known path, prune.\n        if self._min_path is not None:\n            current_new_values = new_path.get_values()\n            current_min_values = self._min_path.get_values()\n            \n            is_prefix_worse = False\n            for i in range(len(current_new_values)):\n                if i >= len(current_min_values): # If current_new_values is longer, it implies current_min_values is a prefix\n                                                 # and potentially current_new_values is not worse based on prefix\n                                                 # This case should not happen for fixed length paths being compared.\n                    break\n                if current_new_values[i] > current_min_values[i]:\n                    is_prefix_worse = True\n                    break\n                if current_new_values[i] < current_min_values[i]:\n                    break # Current path prefix is better, continue exploration.\n            if is_prefix_worse:\n                return\n\n        neighbors = self._grid.get_neighbors(cell.row, cell.col)\n        neighbors.sort(key=lambda c: c.get_value()) \n        \n        for neighbor in neighbors:\n            self._explore_from_cell(neighbor, new_path, remaining_steps - 1)\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Finds the lexicographically smallest path of exactly k cells in an N\u00d7N grid.\n    Moves are restricted to edge-adjacent cells, and cells can be revisited.\n    \"\"\"\n    validator = GridValidator()\n    validator.validate_grid(grid)\n\n    if not isinstance(k, int) or k <= 0:\n        raise ValueError(\"Path length k must be a positive integer.\")\n\n    grid_obj = Grid(grid)\n    pathfinder = PathFinder(grid_obj, k)\n    result_path_values = pathfinder.find_minimum_path()\n\n    return result_path_values", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 3]], "plus_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 9]]}], "HumanEval/131": [{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    digit_list = [int(digit) for digit in str(n)]\n\n    odd_digits = [digit for digit in digit_list if digit % 2 == 1]\n\n    if not odd_digits:\n        return 0\n\n    product = 1\n    for digit in odd_digits:\n        product *= digit\n\n    return product", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/131", "solution": "def extract_digits(n: int) -> list:\n    \"\"\"Extracts individual digits from a positive integer.\n    Returns a list of integer digits.\"\"\"\n    return [int(d) for d in str(n)]\ndef filter_odd_digits(digits: list) -> list:\n    \"\"\"Filters a list of digits to include only the odd ones.\n    Returns a list containing only odd digits.\"\"\"\n    return [d for d in digits if d % 2 != 0]\ndef calculate_product(odd_digits: list) -> int:\n    \"\"\"Calculates the product of a list of odd digits.\n    Returns 0 if the list is empty, otherwise the product.\"\"\"\n    if not odd_digits:\n        return 0\n    product = 1\n    for digit in odd_digits:\n        product *= digit\n    return product\ndef digits(n: int) -> int:\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\"\"\"\n    extracted = extract_digits(n)\n    filtered = filter_odd_digits(extracted)\n    result = calculate_product(filtered)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/132": [{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Analyzes a string of square brackets to detect if a valid nested bracket subsequence exists.\n    Returns True if a subsequence like `[[]]` or `[[][]]` is found, False otherwise.\n    '''\n    \n    current_balance = 0\n    # Flag to indicate if '[[...]]' pattern (two or more open brackets)\n    # was observed within the currently balanced sequence.\n    found_double_open_in_current_segment = False\n    # Final result: True if any valid nested subsequence is found.\n    has_any_valid_nested_subsequence = False\n\n    for char in string:\n        if char == '[':\n            current_balance += 1\n            if current_balance >= 2:\n                # We've seen '[[', which is the start of a nested pattern.\n                found_double_open_in_current_segment = True\n        elif char == ']':\n            if current_balance > 0:\n                # Close an open bracket.\n                current_balance -= 1\n                if current_balance == 0 and found_double_open_in_current_segment:\n                    # A complete, balanced segment '[]' was just closed,\n                    # and it contained at least two levels of opening brackets.\n                    # This means a valid nested subsequence like `[[]]` or `[[][]]` was found.\n                    has_any_valid_nested_subsequence = True\n                    # Reset segment-specific flag as this segment is now closed.\n                    found_double_open_in_current_segment = False\n            else:\n                # Malformed sequence: encountered ']' without a matching '['.\n                # This breaks the current potential valid segment.\n                # Reset balance and potential nesting for a fresh start.\n                current_balance = 0\n                found_double_open_in_current_segment = False\n\n    return has_any_valid_nested_subsequence", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["][]][[[]]"]]}, {"task_id": "HumanEval/132", "solution": "def is_nested(string: str) -> bool:\n    \"\"\"\n    Validates bracket nesting patterns in input string.\n    Returns True if at least one bracket in a valid subsequence is nested.\n    \"\"\"\n    depth = 0  # Tracks current bracket depth for a potential valid segment.\n    max_depth_in_segment = 0  # Max depth reached within the current segment.\n    found_nested = False\n    \n    for char in string:\n        if char == '[':\n        