{"task_id": "HumanEval/129", "solution": "class Cell:\n    \"\"\"Represents a single cell in the grid with its coordinates and value.\"\"\"\n    def __init__(self, row: int, col: int, value: int):\n        self._row = row\n        self._col = col\n        self._value = value\n\n    def get_value(self) -> int:\n        return self._value\n\n    def get_coordinates(self) -> tuple[int, int]:\n        return (self._row, self._col)\n\n    def __eq__(self, other) -> bool:\n        if not isinstance(other, Cell):\n            return NotImplemented\n        return self._row == other._row and self._col == other._col\n\n    def __hash__(self) -> int:\n        return hash((self._row, self._col))\nclass Grid:\n    \"\"\"Manages the grid structure, provides access to cells, and identifies valid neighbors.\"\"\"\n    def __init__(self, grid_data: list[list[int]]):\n        self._N = len(grid_data)\n        self._cells = [[None] * self._N for _ in range(self._N)]\n        for r in range(self._N):\n            for c in range(self._N):\n                self._cells[r][c] = Cell(r, c, grid_data[r][c])\n\n    def _is_valid_coordinate(self, row: int, col: int) -> bool:\n        return 0 <= row < self._N and 0 <= col < self._N\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        return self._cells[row][col]\n\n    def get_neighbors(self, cell: Cell) -> list[Cell]:\n        neighbors = []\n        r, c = cell.get_coordinates()\n        deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n        for dr, dc in deltas:\n            nr, nc = r + dr, c + dc\n            if self._is_valid_coordinate(nr, nc):\n                neighbors.append(self.get_cell(nr, nc))\n        return neighbors\n\n    def get_N(self) -> int:\n        return self._N\n\n    def get_all_cells(self) -> list[Cell]:\n        all_cells = []\n        for r in range(self._N):\n            for c in range(self._N):\n                all_cells.append(self._cells[r][c])\n        return all_cells\nclass Path:\n    \"\"\"Represents an ordered sequence of visited cells and provides lexicographical comparison.\"\"\"\n    def __init__(self, initial_cell: Cell, target_length: int, visited_cells: list[Cell] = None):\n        if visited_cells is None:\n            self._visited_cells = [initial_cell]\n        else:\n            self._visited_cells = visited_cells[:]\n        self._target_length = target_length\n\n    def add_cell(self, cell: Cell) -> 'Path':\n        \"\"\"Returns a new Path object with the new cell appended (immutable approach).\"\"\"\n        new_visited_cells = self._visited_cells + [cell]\n        return Path(new_visited_cells[0], self._target_length, new_visited_cells)\n\n    def get_values(self) -> list[int]:\n        return [cell.get_value() for cell in self._visited_cells]\n\n    def get_current_length(self) -> int:\n        return len(self._visited_cells)\n\n    def get_last_cell(self) -> Cell:\n        return self._visited_cells[-1]\n\n    def is_complete(self) -> bool:\n        return len(self._visited_cells) == self._target_length\n\n    def __lt__(self, other: 'Path') -> bool:\n        return self.get_values() < other.get_values()\ndef _find_paths_recursive(current_path: Path, grid: Grid, k: int, min_path_so_far_wrapper: list[list[int]]) -> None:\n    \"\"\"Recursively explores paths to find the lexicographically smallest path.\"\"\"\n    if current_path.is_complete():\n        path_values = current_path.get_values()\n        if min_path_so_far_wrapper[0] is None or path_values < min_path_so_far_wrapper[0]:\n            min_path_so_far_wrapper[0] = path_values\n        return\n\n    current_values = current_path.get_values()\n    if min_path_so_far_wrapper[0] is not None:\n        # Pruning: if current path's values are already lexicographically greater than the known min_path's prefix\n        # This optimization works because we are building paths in a lexicographical order (implicitly, by sorting neighbors).\n        # If the current path's values up to its current length are already greater than or equal to the known minimum path's\n        # corresponding prefix, then this branch cannot lead to a smaller path.\n        if current_values >= min_path_so_far_wrapper[0][:len(current_values)]:\n            return\n\n    last_cell = current_path.get_last_cell()\n    neighbors = grid.get_neighbors(last_cell)\n    # Sort neighbors by value to find smaller paths earlier, aiding pruning.\n    neighbors.sort(key=lambda cell: cell.get_value())\n\n    for neighbor_cell in neighbors:\n        next_path = current_path.add_cell(neighbor_cell)\n        _find_paths_recursive(next_path, grid, k, min_path_so_far_wrapper)\ndef minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k,\n    find the minimum path of length k.\n    Return an ordered list of the values on the cells that the minimum path go through.\n    \"\"\"\n    validate_grid(grid)\n    validate_k(k)\n\n    grid_obj = Grid(grid)\n    # min_path_so_far_wrapper is used as a mutable container to allow the recursive\n    # function to update the minimum path found so far.\n    min_path_so_far_wrapper = [None]\n\n    all_start_cells = grid_obj.get_all_cells()\n    # Sorting starting cells by value helps find the minimum path quicker\n    # by exploring paths starting with smaller values first.\n    all_start_cells.sort(key=lambda cell: cell.get_value())\n\n    for start_cell in all_start_cells:\n        initial_path = Path(start_cell, k)\n        _find_paths_recursive(initial_path, grid_obj, k, min_path_so_far_wrapper)\n\n    return min_path_so_far_wrapper[0]"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets\n    where at least one bracket in the subsequence is nested.\n    '''\n    n = len(string)\n    # The core logic iterates to find four indices i, j, k, l such that i < j < k < l\n    # and s[i] == '[', s[j] == '[', s[k] == ']', s[l] == ']'.\n    for i in range(n):\n        if string[i] == '[':\n            for j in range(i + 1, n):\n                if string[j] == '[':\n                    for k in range(j + 1, n):\n                        if string[k] == ']':\n                            for l in range(k + 1, n):\n                                if string[l] == ']':\n                                    return True\n    return False"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"\n    Computes the first n+1 numbers of a Tribonacci sequence.\n    The sequence is defined as per the problem description.\n    \"\"\"\n\n    memo = {}\n\n    def _get_tri_recursive(k, memo):\n        \"\"\"Recursively calculates the Tribonacci number for k, using the memoization dictionary.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # k is even\n            result = 1 + k // 2\n        else:  # k is odd\n            # tri(k) = tri(k - 1) + tri(k - 2) + tri(k + 1)\n            result = _get_tri_recursive(k - 1, memo) + \\\n                     _get_tri_recursive(k - 2, memo) + \\\n                     _get_tri_recursive(k + 1, memo)\n\n        memo[k] = result\n        return result\n\n    tribonacci_sequence = []\n    for i in range(n + 1):\n        tribonacci_sequence.append(_get_tri_recursive(i, memo))\n\n    return tribonacci_sequence"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    product_of_odd_digits = 1\n    found_odd_digit = False\n\n    # Convert the integer to a string to easily extract individual digits.\n    for char_digit in str(n):\n        digit = int(char_digit)\n        if digit % 2 != 0:  # Check if the current digit is odd\n            product_of_odd_digits *= digit\n            found_odd_digit = True\n\n    # If no odd digits were found, return 0; otherwise, return the calculated product.\n    if found_odd_digit:\n        return product_of_odd_digits\n    else:\n        return 0"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an isolated alphabetical character.\n    An isolated alphabetical character is one preceded by a space or the beginning of the string.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    # If the character before the last one is a space, the last char is isolated.\n    if txt[-2] == ' ':\n        return True\n\n    # Otherwise, the last alphabetical character is part of a larger word.\n    return False"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Returns the largest index of an element which is strictly less than the element immediately preceding it.\n    If no such element exists, returns -1.\n    \"\"\"\n    largest_decreasing_index = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            largest_decreasing_index = i\n    return largest_decreasing_index"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compares two real numbers (integers, floats, or strings) and returns the larger value\n    in its original type, or None if they are equal.\n    Handles both '.' and ',' as decimal separators in string representations.\n    \"\"\"\n\n    def _convert_to_float(value):\n        \"\"\"Converts an input value to its float representation, handling comma decimals.\"\"\"\n        if isinstance(value, str):\n            value = value.replace(',', '.')\n        return float(value)\n\n    numeric_a = _convert_to_float(a)\n    numeric_b = _convert_to_float(b)\n\n    if numeric_a == numeric_b:\n        return None\n    elif numeric_a > numeric_b:\n        return a\n    else:\n        return b"}
