{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    '''\n    negative_integers = [num for num in lst if num < 0]\n    positive_integers = [num for num in lst if num > 0]\n\n    largest_negative = max(negative_integers) if negative_integers else None\n    smallest_positive = min(positive_integers) if positive_integers else None\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    def factorial(k):\n        \"\"\"Calculates the standard factorial k!.\"\"\"\n        result = 1\n        for i in range(1, k + 1):\n            result *= i\n        return result\n\n    special_fact_result = 1\n    for i in range(n, 0, -1):\n        current_factorial = factorial(i)\n        special_fact_result *= current_factorial\n    return special_fact_result"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n    \"\"\"\n    import re\n    # Replace sequences of more than two spaces (i.e., 3 or more) with a single hyphen.\n    text = re.sub(r' {3,}', '-', text)\n    # Replace any remaining single spaces (or pairs of spaces which become '__') with underscores.\n    text = text.replace(' ', '_')\n    return text"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions\n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from\n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n\n    # Condition 2: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    name_part, extension_part = file_name.split('.', 1)\n\n    # Condition 3a: The substring before the dot should not be empty\n    if not name_part:\n        return 'No'\n\n    # Condition 3b: ...and it starts with a letter from the latin alphabet\n    if not name_part[0].isalpha():\n        return 'No'\n\n    # Condition 1: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = sum(1 for char in file_name if char.isdigit())\n    if digit_count > 3:\n        return 'No'\n\n    # Condition 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    valid_extensions = ['txt', 'exe', 'dll']\n    if extension_part not in valid_extensions:\n        return 'No'\n\n    # If all conditions are met\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n\n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += num * num\n        elif i % 4 == 0:  # Implies i % 3 != 0 because of the previous condition\n            total_sum += num * num * num\n        else:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, returning only those with prime lengths.\n    Maintains original word order, separating them by single spaces.\n    \"\"\"\n\n    def is_prime(number: int) -> bool:\n        \"\"\"Checks if a number is prime. Returns True if prime, False otherwise.\"\"\"\n        if number < 2:\n            return False\n        for i in range(2, int(number**0.5) + 1):\n            if number % i == 0:\n                return False\n        return True\n\n    def _is_valid_sentence(s: str) -> bool:\n        \"\"\"Validates sentence length (1-100) and content (letters/spaces only).\"\"\"\n        if not (1 <= len(s) <= 100):\n            return False\n        for char in s:\n            if not ('a' <= char <= 'z' or 'A' <= char <= 'Z' or char == ' '):\n                return False\n        return True\n\n    def _split_sentence(s: str) -> list[str]:\n        \"\"\"Splits the sentence into words by space.\"\"\"\n        return s.split(' ')\n\n    if not _is_valid_sentence(sentence):\n        return \"\"\n\n    words = _split_sentence(sentence)\n    filtered_words = []\n\n    for word in words:\n        if not word:\n            continue\n        word_length = len(word)\n        if is_prime(word_length):\n            filtered_words.append(word)\n\n    return ' '.join(filtered_words)"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Multiplies two fractions represented as strings and checks if the product is a whole number.\"\"\"\n    x_parts = x.split('/')\n    x_numerator = int(x_parts[0])\n    x_denominator = int(x_parts[1])\n\n    n_parts = n.split('/')\n    n_numerator = int(n_parts[0])\n    n_denominator = int(n_parts[1])\n\n    product_numerator = x_numerator * n_numerator\n    product_denominator = x_denominator * n_denominator\n\n    return (product_numerator % product_denominator) == 0"}
{"task_id": "HumanEval/145", "solution": "class _IntegerWithMetadata:\n    \"\"\"Encapsulates an integer's value, original index, and sum of digits for sorting.\"\"\"\n    def __init__(self, value: int, original_index: int, sum_of_digits: int):\n        self.value = value\n        self.original_index = original_index\n        self.sum_of_digits = sum_of_digits\n\n    def __lt__(self, other) -> bool:\n        \"\"\"Defines the less-than comparison for sorting, prioritizing sum of digits then original index.\"\"\"\n        if self.sum_of_digits != other.sum_of_digits:\n            return self.sum_of_digits < other.sum_of_digits\n        return self.original_index < other.original_index\ndef _calculate_sum_of_digits(num: int) -> int:\n    \"\"\"Calculates the sum of the absolute values of an integer's digits.\"\"\"\n    s = str(abs(num))\n    return sum(int(digit) for digit in s)\ndef order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If sums are equal, items are ordered based on their original index.\n    \"\"\"\n    if not nums:\n        return []\n\n    # Create _IntegerWithMetadata objects for each number, storing its value, original index, and sum of digits.\n    metadata_list = []\n    for i, num in enumerate(nums):\n        sum_of_digits = _calculate_sum_of_digits(num)\n        metadata_list.append(_IntegerWithMetadata(num, i, sum_of_digits))\n\n    # Sort the list of _IntegerWithMetadata objects using the custom __lt__ comparison.\n    metadata_list.sort()\n\n    # Extract the original integer values from the sorted objects.\n    sorted_nums = [item.value for item in metadata_list]\n\n    return sorted_nums"}
{"task_id": "HumanEval/146", "solution": "def _is_greater_than_10(num: int) -> bool:\n    \"\"\"Checks if a given number is strictly greater than 10.\"\"\"\n    return num > 10\ndef _get_first_digit(num: int) -> int:\n    \"\"\"Extracts the first digit of a number, considering its absolute value.\"\"\"\n    return int(str(abs(num))[0])\ndef _get_last_digit(num: int) -> int:\n    \"\"\"Extracts the last digit of a number, considering its absolute value.\"\"\"\n    return abs(num) % 10\ndef _is_odd(digit: int) -> bool:\n    \"\"\"Checks if a single digit is odd.\"\"\"\n    return digit % 2 != 0\ndef _has_odd_first_digit(num: int) -> bool:\n    \"\"\"Determines if a number's first digit is odd.\"\"\"\n    first_digit = _get_first_digit(num)\n    return _is_odd(first_digit)\ndef _has_odd_last_digit(num: int) -> bool:\n    \"\"\"Determines if a number's last digit is odd.\"\"\"\n    last_digit = _get_last_digit(num)\n    return _is_odd(last_digit)\ndef specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns\n    the number of elements in the array that are greater than 10 and both\n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    For example:\n    specialFilter([15, -73, 14, -15]) => 1\n    specialFilter([33, -2, -3, 45, 21, 109]) => 2\n    \"\"\"\n    count = 0\n    for num in nums:\n        if _is_greater_than_10(num) and \\\n           _has_odd_first_digit(num) and \\\n           _has_odd_last_digit(num):\n            count += 1\n    return count"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    Returns a tuple of planets located between planet1 and planet2, sorted by proximity to the sun.\n    Returns an empty tuple if input planet names are incorrect or no planets are between them.\n    '''\n    _PLANETS_IN_ORDER = (\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n    )\n    _PLANET_TO_INDEX = {planet: i for i, planet in enumerate(_PLANETS_IN_ORDER)}\n\n    if planet1 not in _PLANET_TO_INDEX or planet2 not in _PLANET_TO_INDEX:\n        return ()\n\n    index1 = _PLANET_TO_INDEX[planet1]\n    index2 = _PLANET_TO_INDEX[planet2]\n\n    # Determine the slice boundaries for planets strictly between planet1 and planet2\n    start_index = min(index1, index2) + 1\n    end_index = max(index1, index2)\n\n    # Slice the _PLANETS_IN_ORDER tuple to get the intermediate planets\n    # The slice is already sorted by proximity to the sun\n    between_planets = _PLANETS_IN_ORDER[start_index:end_index]\n\n    return between_planets"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n\n    \"\"\"\n    import math\n\n    if n <= 1:\n        return y\n    if n == 2:\n        return x\n    if n % 2 == 0:\n        return y\n\n    i = 3\n    limit = math.isqrt(n)\n    while i <= limit:\n        if n % i == 0:\n            return y\n        i += 2\n\n    return x"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings, removing those with odd lengths, and then sorts\n    the remaining strings first by length (ascending), then alphabetically (ascending).\"\"\"\n    filtered_list = [s for s in lst if len(s) % 2 == 0]\n    sorted_list = sorted(filtered_list, key=lambda s: (len(s), s))\n    return sorted_list"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n\n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0\n\n    If the input list is empty, return 0.\n    '''\n    class NumberProcessor:\n        \"\"\"\n        Encapsulates logic for validating and processing individual numbers.\n        \"\"\"\n        def __init__(self, value):\n            self._value = value\n\n        def is_integer(self):\n            \"\"\"Checks if the stored value is an integer.\"\"\"\n            return isinstance(self._value, int)\n\n        def is_odd(self):\n            \"\"\"Checks if the stored value is an odd integer.\"\"\"\n            return self._value % 2 != 0\n\n        def is_negative(self):\n            \"\"\"Checks if the stored value is negative.\"\"\"\n            return self._value < 0\n\n        def get_square(self):\n            \"\"\"Calculates the square of the stored value.\"\"\"\n            return self._value * self._value\n\n        def is_eligible(self):\n            \"\"\"\n            Combines checks to determine if the number is a positive, odd integer.\n            \"\"\"\n            return self.is_integer() and not self.is_negative() and self.is_odd()\n\n    total_sum = 0\n    for item in lst:\n        processor = NumberProcessor(item)\n        if processor.is_eligible():\n            total_sum += processor.get_square()\n    return total_sum"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"I think we all remember that feeling when the result of some long-awaited\n    event is finally known. The feelings and thoughts you have at that moment are\n    definitely worth noting down and comparing.\n    Your task is to determine if a person correctly guessed the results of a number of matches.\n    You are given two arrays of scores and guesses of equal length, where each index shows a match.\n    Return an array of the same length denoting how far off each guess was. If they have guessed correctly,\n    the value is 0, and if not, the value is the absolute difference between the guess and the score.\n\n\n    example:\n\n    compare([1,2,3,4,5,1],[1,2,3,4,2,-2]) -> [0,0,0,0,3,3]\n    compare([0,5,0,0,0,4],[4,1,1,0,0,-2]) -> [4,4,1,0,0,6]\n    \"\"\"\n    result = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            result.append(0)\n        else:\n            result.append(abs(game[i] - guess[i]))\n    return result"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on the difference between uppercase and lowercase letters.\n    The result is formatted as 'ClassName.StrongestExtensionName', with ties broken by original list order.\n    \"\"\"\n    if not extensions:\n        return f\"{class_name}.\"\n\n    strongest_extension_name = \"\"\n    max_strength = -float('inf') # Initialize with a very small number to ensure any valid strength is greater\n\n    for ext_name in extensions:\n        cap_count = sum(1 for char in ext_name if char.isupper())\n        sm_count = sum(1 for char in ext_name if char.islower())\n        current_strength = cap_count - sm_count\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = ext_name\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Input number must be between 1 and 1000, inclusive.\")\n\n    roman_map = {\n        1000: 'm', 900: 'cm', 500: 'd', 400: 'cd', 100: 'c',\n        90: 'xc', 50: 'l', 40: 'xl', 10: 'x', 9: 'ix',\n        5: 'v', 4: 'iv', 1: 'i'\n    }\n\n    result = []\n    for value, numeral in sorted(roman_map.items(), reverse=True):\n        while number >= value:\n            result.append(numeral)\n            number -= value\n\n    return \"\".join(result)"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    # If b is an empty string, it is considered a substring of any string a.\n    if not b:\n        return True\n\n    # If a is an empty string and b is not empty, no rotation of b can be a substring of a.\n    if not a:\n        return False\n\n    len_b = len(b)\n    # Generate all cyclic rotations of string b and check if any is a substring of a.\n    for i in range(len_b):\n        rotation = b[i:] + b[:i]\n        if rotation in a:\n            return True\n\n    # If no rotation of b was found as a substring in a, return False.\n    return False"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) from array a where i < j < k and their sum is a multiple of 3.\n    The array a is defined by a[i] = i * i - i + 1 (1-indexed).\n    \"\"\"\n\n    def combinations(n_val, k_val):\n        \"\"\"Calculates n choose k.\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n\n        res = 1\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    # Analyze a[i] % 3 for 1-indexed i:\n    # a[i] = i*i - i + 1\n    # i % 3 == 0: a[i] = 0*0 - 0 + 1 = 1. So, a[i] % 3 = 1.\n    # i % 3 == 1: a[i] = 1*1 - 1 + 1 = 1. So, a[i] % 3 = 1.\n    # i % 3 == 2: a[i] = 2*2 - 2 + 1 = 4 - 2 + 1 = 3. So, a[i] % 3 = 0.\n\n    # count_rem0_val: number of elements a[i] such that a[i] % 3 == 0.\n    # This occurs when i % 3 == 2 for i in [1, n].\n    # For i = 1, 2, 3, 4, 5, ...\n    # i % 3 = 1, 2, 0, 1, 2, ...\n    # i values where i % 3 == 2 are 2, 5, 8, ...\n    # The number of such values can be found by (n - 2) // 3 + 1, but a simpler way is:\n    # (n + 1) // 3 counts how many numbers from 1 to n (inclusive) have a remainder of 2 when divided by 3.\n    # For n=5: (5+1)//3 = 6//3 = 2 (i.e., i=2, i=5)\n    count_rem0_val = (n + 1) // 3\n\n    # count_rem1_val: number of elements a[i] such that a[i] % 3 == 1.\n    # This is the total elements minus those with remainder 0.\n    count_rem1_val = n - count_rem0_val\n\n    # A triple (x, y, z) has sum x+y+z % 3 == 0 if:\\n\n    # The sum of their remainders modulo 3 must be 0.\n    # Since remainders can only be 0 or 1, the only combinations for (rem_x, rem_y, rem_z) that sum to a multiple of 3 are:\n    # 1. (0, 0, 0) -> sum 0 % 3 == 0\n    # 2. (1, 1, 1) -> sum 3 % 3 == 0\n    # Other combinations like (0,0,1) sum to 1, (0,1,1) sum to 2.\n    # So, we need to choose 3 elements all with remainder 0, OR 3 elements all with remainder 1.\n    total_valid_triples = combinations(count_rem0_val, 3) + combinations(count_rem1_val, 3)\n\n    return total_valid_triples"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Handle negative numbers by taking the absolute value\n    abs_num_str = str(abs(num))\n\n    for digit_char in abs_num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n\n    def _are_sides_positive(s1, s2, s3):\n        \"\"\"Checks if all three side lengths are positive.\"\"\"\n        return s1 > 0 and s2 > 0 and s3 > 0\n\n    def _satisfies_triangle_inequality(s1, s2, s3):\n        \"\"\"Checks if the triangle inequality theorem holds for the given sides.\"\"\"\n        return (s1 + s2 > s3) and (s1 + s3 > s2) and (s2 + s3 > s1)\n\n    def is_valid_triangle_helper(s1, s2, s3):\n        \"\"\"Determines if the three sides can form a geometrically valid triangle.\"\"\"\n        return _are_sides_positive(s1, s2, s3) and _satisfies_triangle_inequality(s1, s2, s3)\n\n    class Triangle:\n        \"\"\"Encapsulates triangle side lengths and provides methods for validation and right-angle determination.\"\"\"\n        def __init__(self, s1, s2, s3):\n            self.sideA = s1\n            self.sideB = s2\n            self.sideC = s3\n\n        def is_valid(self):\n            \"\"\"Determines if the current Triangle instance represents a geometrically valid triangle.\"\"\"\n            return is_valid_triangle_helper(self.sideA, self.sideB, self.sideC)\n\n        def is_right_angled(self):\n            \"\"\"Determines if the current Triangle instance is a right-angled triangle, assuming it is valid.\"\"\"\n            sides = sorted([self.sideA, self.sideB, self.sideC])\n            # Apply Pythagorean theorem: a^2 + b^2 = c^2, with 'c' being the longest side.\n            # Use a small tolerance for floating-point comparisons to avoid precision issues.\n            return abs(sides[0]**2 + sides[1]**2 - sides[2]**2) < 1e-9\n\n    triangle = Triangle(a, b, c)\n\n    if not triangle.is_valid():\n        return False\n\n    return triangle.is_right_angled()"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n\n    find_max([\"name\", \"of\", \"string\"]) == \"string\"\n    find_max([\"name\", \"enam\", \"game\"]) == \"enam\"\n    find_max([\"aaaaaaa\", \"bb\" ,\"cc\"]) == \"\"aaaaaaa\"\n    \"\"\"\n\n    def _calculate_unique_chars(word: str) -> int:\n        \"\"\"Calculates the number of unique characters in a string.\"\"\"\n        return len(set(word))\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = _calculate_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaker: lexicographical order\n            if result_word == \"\" or word < result_word:\n                result_word = word\n\n    return result_word"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \"\"\"\n    if not (0 <= number <= 1000 and 0 <= need <= 1000 and 0 <= remaining <= 1000):\n        raise ValueError(\"Input parameters must be between 0 and 1000.\")\n\n    carrots_consumed_in_meal = min(need, remaining)\n    total_carrots_eaten = number + carrots_consumed_in_meal\n    carrots_remaining_in_stock = remaining - carrots_consumed_in_meal\n\n    return [total_carrots_eaten, carrots_remaining_in_stock]"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n    \"\"\"\n    expression_parts = []\n    for i in range(len(operand)):\n        expression_parts.append(str(operand[i]))\n        if i < len(operator):\n            expression_parts.append(operator[i])\n\n    expression_string = \" \".join(expression_parts)\n    return eval(expression_string)"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Processes a string: reverses case of letters or reverses the entire string if no letters are present.\"\"\"\n\n    def _has_letters(s_param):\n        \"\"\"Checks if the given string contains any alphabetic characters.\"\"\"\n        for char in s_param:\n            if char.isalpha():\n                return True\n        return False\n\n    def _process_character(char_param):\n        \"\"\"Reverses the case of a single character if it is a letter, otherwise returns it unchanged.\"\"\"\n        if char_param.isalpha():\n            if char_param.islower():\n                return char_param.upper()\n            else: # char_param is uppercase\n                return char_param.lower()\n        return char_param\n\n    def _reverse_string(s_param):\n        \"\"\"Reverses the order of characters in the given string.\"\"\"\n        return s_param[::-1]\n\n    if not _has_letters(s):\n        return _reverse_string(s)\n    else:\n        processed_chars = []\n        for char in s:\n            processed_chars.append(_process_character(char))\n        return \"\".join(processed_chars)"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n\n    def _validate_inputs(a, b):\n        \"\"\"Ensures inputs are positive integers.\"\"\"\n        if not (isinstance(a, int) and isinstance(b, int) and a > 0 and b > 0):\n            raise ValueError(\"Inputs must be positive integers\")\n\n    def _determine_range(a, b):\n        \"\"\"Determines the minimum and maximum values from the two input integers.\"\"\"\n        return min(a, b), max(a, b)\n\n    def _is_even(num):\n        \"\"\"Checks if a given integer is even.\"\"\"\n        return num % 2 == 0\n\n    _validate_inputs(a, b)\n    min_val, max_val = _determine_range(a, b)\n\n    result_list = []\n    for num in range(min_val, max_val + 1):\n        if _is_even(num):\n            result_list.append(num)\n\n    return result_list"}
