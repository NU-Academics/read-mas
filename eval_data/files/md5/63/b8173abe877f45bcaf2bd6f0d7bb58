{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, this function returns a list of words\n    from s that contain exactly n consonants, in their original order.\n    \"\"\"\n    if not s:\n        return []\n\n    result_words = []\n    VOWELS = \"aeiouAEIOU\"\n\n    words = s.split()\n\n    for word in words:\n        consonant_count = 0\n        for char in word:\n            if char.isalpha() and char not in VOWELS:\n                consonant_count += 1\n\n        if consonant_count == n:\n            result_words.append(word)\n\n    return result_words"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if concatenating two parenthesis strings in any order results in a balanced string.\n    Uses a helper function to determine if a given string of parentheses is balanced.\n    \"\"\"\n    def _is_balanced(s: str) -> bool:\n        \"\"\"Determines if a string of parentheses is balanced.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    s1, s2 = lst[0], lst[1]\n\n    # Check concatenation order 1: s1 + s2\n    concat1 = s1 + s2\n    is_balanced1 = _is_balanced(concat1)\n\n    # Check concatenation order 2: s2 + s1\n    concat2 = s2 + s1\n    is_balanced2 = _is_balanced(concat2)\n\n    if is_balanced1 or is_balanced2:\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between\n    two consonants from the right side of the word (case sensitive).\n\n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition.\n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n    def _is_vowel(char):\n        return char in 'aeiouAEIOU'\n\n    def _is_consonant(char):\n        return char.isalpha() and not _is_vowel(char)\n\n    n = len(word)\n    if n < 3:\n        return \"\"\n\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        if _is_vowel(current_char) and _is_consonant(left_char) and _is_consonant(right_char):\n            return current_char\n\n    return \"\""}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    Sorts an array of integers based on the count of '1' bits in their binary\n    representation, then by decimal value for tie-breaking.\n    \"\"\"\n    # Use a lambda function to define the custom sorting key.\n    # The key is a tuple: (count of '1's in binary, original number).\n    # Python's sorted() will sort by the first element, then by the second for ties.\n    return sorted(arr, key=lambda num: (bin(num).count('1'), num))"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Sort the array in descending order to easily pick the largest k elements.\n    sorted_arr_desc = sorted(arr, reverse=True)\n    # Take the top k elements.\n    top_k_elements = sorted_arr_desc[:k]\n    # Sort these k elements in ascending order as required by the problem statement.\n    return sorted(top_k_elements)"}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    \"\"\"\n    total_sum = 0\n    for index, value in enumerate(lst):\n        if index % 2 == 0 and value % 2 != 0:\n            total_sum += value\n    return total_sum"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    The sequence is generated by rules: if even, n/2; if odd, 3n+1, until 1.\n    \"\"\"\n\n    def _validate_input(n):\n        \"\"\"Validates if n is a positive integer.\"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise ValueError(\"Input n must be a positive integer.\")\n\n    def _generate_collatz_sequence(n):\n        \"\"\"Generates the complete Collatz sequence for n until 1.\"\"\"\n        sequence = [n]\n        current = n\n        while current != 1:\n            if current % 2 == 0:\n                current //= 2\n            else:\n                current = 3 * current + 1\n            sequence.append(current)\n        return sequence\n\n    def _filter_and_sort_odd_numbers(sequence):\n        \"\"\"Extracts odd numbers from a given sequence and sorts them in increasing order.\"\"\"\n        odd_numbers = sorted(list(set(num for num in sequence if num % 2 != 0)))\n        return odd_numbers\n\n    _validate_input(n)\n\n    if n == 1:\n        return [1]\n\n    sequence = _generate_collatz_sequence(n)\n    odd_sorted_list = _filter_and_sort_odd_numbers(sequence)\n    return odd_sorted_list"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"Validates a given date string according to specific rules and format.\n    Checks for non-empty string, 'mm-dd-yyyy' format, valid month range, and valid day range per month.\n    \"\"\"\n\n    def _is_not_empty(date_string):\n        \"\"\"Checks if the input date string is not empty.\"\"\"\n        return bool(date_string)\n\n    def _parse_date_components(date_string):\n        \"\"\"Parses the 'mm-dd-yyyy' formatted string into month, day, year integers.\"\"\"\n        parts = date_string.split('-')\n        if len(parts) != 3:\n            return None\n\n        # Rule 4: The date should be in the format: mm-dd-yyyy\n        # This implies fixed length for each part.\n        if not (len(parts[0]) == 2 and len(parts[1]) == 2 and len(parts[2]) == 4):\n            return None\n\n        try:\n            month = int(parts[0])\n            day = int(parts[1])\n            year = int(parts[2])\n            return (month, day, year)\n        except ValueError:\n            return None\n\n    def _is_valid_month_range(month):\n        \"\"\"Validates if the month is within the range 1-12.\"\"\"\n        return 1 <= month <= 12\n\n    def _is_valid_day_range(month, day):\n        \"\"\"Validates if the day is within the correct range for the given month.\"\"\"\n        months_31_days = {1, 3, 5, 7, 8, 10, 12}\n        months_30_days = {4, 6, 9, 11}\n\n        if month in months_31_days:\n            return 1 <= day <= 31\n        elif month in months_30_days:\n            return 1 <= day <= 30\n        elif month == 2:  # February\n            return 1 <= day <= 29\n        else:\n            # This case should ideally not be reached if _is_valid_month_range passes first.\n            return False\n\n    # Main orchestration logic\n    if not _is_not_empty(date):\n        return False\n\n    components = _parse_date_components(date)\n    if components is None:\n        return False\n\n    month, day, _ = components  # Year is not used for validation rules\n\n    if not _is_valid_month_range(month):\n        return False\n\n    if not _is_valid_day_range(month, day):\n        return False\n\n    return True"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n\n    Example:\n\n        Input: arr = [111,21,3,4000,5,6,7,8,9], k = 4\n        Output: 24 # sum of 21 + 3\n\n    Constraints:\n        1. 1 <= len(arr) <= 100\n        2. 1 <= k <= len(arr)\n    \"\"\"\n    # Validate array length and k value according to constraints.\n    if not (1 <= len(arr) <= 100):\n        raise ValueError(\"Array length must be between 1 and 100, inclusive.\")\n    if not (1 <= k <= len(arr)):\n        raise ValueError(\"k must be between 1 and the length of the array, inclusive.\")\n\n    total_sum = 0\n    # Iterate through the first k elements of the array.\n    for i in range(k):\n        element = arr[i]\n        # Add element to sum if its absolute value has at most two digits.\n        if abs(element) <= 99:\n            total_sum += element\n\n    return total_sum"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Returns the sum of magnitudes of integers multiplied by the product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = 0\n    product_signs = 1\n\n    for num in arr:\n        sum_magnitudes += abs(num)\n\n        if num > 0:\n            product_signs *= 1\n        elif num < 0:\n            product_signs *= -1\n        else: # num == 0\n            product_signs *= 0\n\n    return sum_magnitudes * product_signs"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',', if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3\n    '''\n\n    def _has_whitespace(text):\n        return any(c.isspace() for c in text)\n\n    def _split_by_whitespace(text):\n        return text.split()\n\n    def _has_comma(text):\n        return ',' in text\n\n    def _split_by_comma(text):\n        return text.split(',')\n\n    def _count_odd_ordered_lowercase_letters(text):\n        count = 0\n        for char in text:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    count += 1\n        return count\n\n    if _has_whitespace(txt):\n        return _split_by_whitespace(txt)\n    elif _has_comma(txt):\n        return _split_by_comma(txt)\n    else:\n        return _count_odd_ordered_lowercase_letters(txt)"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n\n    # Check duplicate constraint: no number appears more than twice.\n    # We create a frequency map to count occurrences.\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:\n            return False\n\n    # Check sorting order: list must be in ascending order.\n    # We iterate through the list comparing adjacent elements.\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # If both checks pass, the list is sorted and adheres to duplicate rules.\n    return True"}
{"task_id": "HumanEval/127", "solution": "def _is_prime(num):\n    # Based on the provided samples, a prime number for this problem\n    # is defined as a number greater than 2 that is not divisible by any number other than 1 and itself.\n    # Lengths 1 and 2 consistently result in \"NO\" from the samples.\n    if num <= 2:\n        return False\n    if num % 2 == 0:\n        return False\n    # Check for odd divisors from 3 up to sqrt(num)\n    i = 3\n    while i * i <= num:\n        if num % i == 0:\n            return False\n        i += 2\n    return True\ndef intersection(interval1, interval2):\n    \"\"\"\n    Determines if the length of the intersection of two closed intervals is a prime number.\n    Returns \"YES\" if the length is a prime number (as implicitly defined by samples), otherwise \"NO\".\n    \"\"\"\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    # Calculate the intersection interval's start and end points\n    intersection_start = max(start1, start2)\n    intersection_end = min(end1, end2)\n\n    # If the calculated intersection_start is greater than intersection_end, there is no intersection\n    if intersection_start > intersection_end:\n        return \"NO\"\n    else:\n        # Calculate the length of the intersection for closed intervals\n        intersection_length = intersection_end - intersection_start + 1\n\n        # Check if the length of the intersection is a prime number\n        if _is_prime(intersection_length):\n            return \"YES\"\n        else:\n            return \"NO\""}
