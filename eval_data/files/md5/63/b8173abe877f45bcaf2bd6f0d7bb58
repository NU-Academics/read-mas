{"task_id": "HumanEval/51", "solution": "def remove_vowels(text):\n    \"\"\"\n    remove_vowels is a function that takes string and returns string without vowels.\n    >>> remove_vowels('')\n    ''\n    >>> remove_vowels(\"abcdef\\nghijklm\")\n    'bcdf\\nghjklm'\n    >>> remove_vowels('abcdef')\n    'bcdf'\n    >>> remove_vowels('aaaaa')\n    ''\n    >>> remove_vowels('aaBAA')\n    'B'\n    >>> remove_vowels('zbcd')\n    'zbcd'\n    \"\"\"\n    vowels = \"aeiouAEIOU\"\n    result = []\n    for char in text:\n        if char not in vowels:\n            result.append(char)\n    return \"\".join(result)"}
{"task_id": "HumanEval/54", "solution": "def same_chars(s0: str, s1: str):\n    \"\"\"\n    Check if two words have the same characters.\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')\n    True\n    >>> same_chars('abcd', 'dddddddabc')\n    True\n    >>> same_chars('dddddddabc', 'abcd')\n    True\n    >>> same_chars('eabcd', 'dddddddabc')\n    False\n    >>> same_chars('abcd', 'dddddddabce')\n    False\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddddabc')\n    False\n    \"\"\"\n    # Convert each string to a set of its unique characters.\n    # Then, compare the two resulting sets for equality.\n    return set(s0) == set(s1)"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n <= 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        a, b = 0, 1\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\"\"\"\n    n = len(l)\n    if n <= 1:\n        return True\n\n    is_increasing = True\n    for i in range(n - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False\n            break\n\n    is_decreasing = True\n    for i in range(n - 1):\n        if l[i] < l[i+1]:\n            is_decreasing = False\n            break\n\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n\n    \"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_elements_set = set1.intersection(set2)\n    return sorted(list(common_elements_set))"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        else:\n            return False # Invalid character found\n\n        if balance < 0:\n            return False # Closing bracket without a corresponding opening bracket\n\n    return balance == 0 # True if all brackets are matched, False if unmatched opening brackets remain"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n\n    # Divide by 2 until n is odd\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Iterate for odd factors from 3 up to sqrt(n)\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n        i += 2\n\n    # If n is still greater than 2, it must be the largest prime factor\n    if n > 2:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\\n    >>> sum_to_n(30)\\n    465\\n    >>> sum_to_n(100)\\n    5050\\n    >>> sum_to_n(5)\\n    15\\n    >>> sum_to_n(10)\\n    55\\n    >>> sum_to_n(1)\\n    1\\n    \"\"\"\\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/63", "solution": "_fibfib_memo = {0: 0, 1: 0, 2: 1}\ndef fibfib(n: int):\n    \"\"\"Efficiently computes the n-th element of the FibFib number sequence using memoization.\n    The sequence is defined by fibfib(0)=0, fibfib(1)=0, fibfib(2)=1, and fibfib(n) = fibfib(n-1) + fibfib(n-2) + fibfib(n-3) for n > 2.\n    \"\"\"\n    if n in _fibfib_memo:\n        return _fibfib_memo[n]\n\n    # Compute values iteratively from the largest known key up to n\n    max_k_in_memo = max(_fibfib_memo.keys())\n    for i in range(max_k_in_memo + 1, n + 1):\n        _fibfib_memo[i] = _fibfib_memo[i-1] + _fibfib_memo[i-2] + _fibfib_memo[i-3]\n\n    return _fibfib_memo[n]"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    if not xs or len(xs) <= 1:\n        return []\n\n    derivative_coefficients = []\n    for i in range(1, len(xs)):\n        derivative_coefficients.append(i * xs[i])\n\n    return derivative_coefficients"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII values of uppercase characters in a string.\n    Returns 0 if the string is empty or contains no uppercase characters.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    def _reverse_string(s):\n        \"\"\"Reverses a given string.\"\"\"\n        return s[::-1]\n\n    def _perform_circular_shift(s, effective_shift):\n        \"\"\"Performs a circular right shift on a string by effective_shift positions.\"\"\"\n        n = len(s)\n        if n == 0:\n            return \"\"\n        # A right circular shift moves the last 'effective_shift' characters to the beginning.\n        return s[n - effective_shift:] + s[:n - effective_shift]\n\n    s_x = str(x)\n    num_digits = len(s_x)\n\n    if shift > num_digits:\n        return _reverse_string(s_x)\n    else:\n        # Calculate the effective shift amount, handling full rotations where shift % num_digits is 0.\n        effective_shift = shift % num_digits\n        return _perform_circular_shift(s_x, effective_shift)"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\"\n    Checks if every opening bracket has a corresponding closing bracket.\n    The balance counter increments for '(' and decrements for ')'.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n    \"\"\"\n    vowels = \"aeiou\"\n    count = 0\n    s_len = len(s)\n\n    for i, char in enumerate(s):\n        char_lower = char.lower()\n        if char_lower in vowels:\n            count += 1\n        elif char_lower == 'y' and i == s_len - 1:\n            count += 1\n            \n    return count"}
{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given a string of apple and orange counts and the total fruits.\n    \"\"\"\n    def _parse_fruit_string(fruit_str):\n        \"\"\"\n        Extracts apple and orange counts from the input string.\n        \"\"\"\n        parts = fruit_str.split(\" apples and \")\n        apples_str = parts[0]\n        oranges_str_part = parts[1]\n\n        apples = int(apples_str)\n        oranges = int(oranges_str_part.split(\" oranges\")[0])\n\n        return apples, oranges\n\n    apples_count, oranges_count = _parse_fruit_string(s)\n    total_known_fruits = apples_count + oranges_count\n    mango_fruits = n - total_known_fruits\n\n    return mango_fruits"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    \"Given an array representing a branch of a tree that has non-negative integer nodes\n    your task is to pluck one of the nodes and return it.\n    The plucked node should be the node with the smallest even value.\n    If multiple nodes with the same smallest even value are found return the node that has smallest index.\n\n    The plucked node should be returned in a list, [ smalest_value, its index ],\n    If there are no even values or the given array is empty, return [].\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        # Check if the current value is even.\n        if value % 2 == 0:\n            # If this even value is smaller than the current smallest_even_value, update.\n            # This naturally ensures we get the smallest index for the smallest value.\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n\n    if smallest_even_index == -1:\n        # If no even values were found throughout the iteration.\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    import collections\n\n    # Determine frequencies of each number in the list.\n    frequencies = collections.Counter(lst)\n\n    valid_candidates = []\n    # Identify numbers that meet the criteria: frequency >= number itself.\n    for num, freq in frequencies.items():\n        if freq >= num:\n            valid_candidates.append(num)\n\n    # Return the greatest valid number or -1 if none exist.\n    if not valid_candidates:\n        return -1\n    else:\n        return max(valid_candidates)"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n\n    Examples:\n    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]\n    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]\n    strange_sort_list([]) == []\n    '''\n    if not lst:\n        return []\n\n    # Create a sorted copy of the input list to easily access min and max.\n    sorted_lst = sorted(lst)\n    result = []\n\n    # Alternately pop the minimum and maximum elements from the sorted list.\n    while sorted_lst:\n        # Append the minimum (first) element.\n        result.append(sorted_lst.pop(0))\n\n        # If there are still elements, append the maximum (last) element.\n        if sorted_lst:\n            result.append(sorted_lst.pop(-1))\n\n    return result"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic. A palindromic array is an array that\n    is read the same backwards and forwards. In one change, you can change one element to any other element.\n    \"\"\"\n    changes_count = 0\n    left = 0\n    right = len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes_count += 1\n        left += 1\n        right -= 1\n    return changes_count"}
{"task_id": "HumanEval/71", "solution": "import math\nclass Triangle:\n    def __init__(self, a: float, b: float, c: float):\n        self._side_a = a\n        self._side_b = b\n        self._side_c = c\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the three sides form a valid triangle.\"\"\"\n        return (self._side_a + self._side_b > self._side_c and\n                self._side_a + self._side_c > self._side_b and\n                self._side_b + self._side_c > self._side_a)\n\n    def _calculate_semi_perimeter(self) -> float:\n        \"\"\"Calculates the semi-perimeter.\"\"\"\n        return (self._side_a + self._side_b + self._side_c) / 2\n\n    def _calculate_area(self) -> float:\n        \"\"\"Calculates the area using Heron's formula.\"\"\"\n        s = self._calculate_semi_perimeter()\n        term = s * (s - self._side_a) * (s - self._side_b) * (s - self._side_c)\n        if term < 0:\n            return 0.0\n        return math.sqrt(term)\n\n    def get_area(self) -> float:\n        \"\"\"Returns the rounded area.\"\"\"\n        raw_area = self._calculate_area()\n        return round(raw_area, 2)\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater\n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    triangle = Triangle(a, b, c)\n    if triangle.is_valid():\n        return triangle.get_area()\n    else:\n        return -1"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n    '''\n    # Check if the list q is a palindrome by comparing it with its reversed version.\n    if q != q[::-1]:\n        return False\n\n    # If q is a palindrome, calculate the sum of its elements and compare it with w.\n    if sum(q) <= w:\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    \"\"\"\n    Compares two lists of strings based on their total character counts.\n    Returns the list with the smaller total character count, or the first list if counts are equal.\n    \"\"\"\n    count1 = sum(len(s) for s in lst1)\n    count2 = sum(len(s) for s in lst2)\n\n    if count1 < count2:\n        return lst1\n    elif count2 < count1:\n        return lst2\n    else:  # counts are equal\n        return lst1"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Write a function that takes an integer a and returns True\n    if this ingeger is a cube of some integer number.\n    '''\n    if a == 0:\n        return True\n\n    # Calculate the integer cube root of the absolute value of a.\n    # Using round() helps mitigate floating point inaccuracies for numbers like 26.999... or 27.000...1\n    abs_a_cbrt = round(abs(a)**(1/3))\n\n    # Adjust the sign of the root based on the original number 'a'.\n    # If a is negative, its cube root must also be negative.\n    if a < 0:\n        root = -abs_a_cbrt\n    else:\n        root = abs_a_cbrt\n\n    # Check if the cube of this integer root equals the original number 'a'.\n    return root * root * root == a"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    def is_prime(n):\n        \"\"\"Helper function to check if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        # Check for odd divisors up to the square root of n.\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    if a < 30:\n        # 30 is the smallest product of three distinct primes (2*3*5).\n        return False\n\n    # Iterate through possible first prime factors p1.\n    # Based on design, p1 can go up to a // (2*3) = a // 6.\n    for p1 in range(2, a // 6 + 1):\n        if not is_prime(p1):\n            continue\n        if a % p1 == 0:\n            remainder1 = a // p1\n            # Iterate through possible second prime factors p2, starting from p1\n            # to ensure p1 <= p2 and avoid duplicate combinations.\n            # Based on design, p2 can go up to remainder1 // 2.\n            for p2 in range(p1, remainder1 // 2 + 1):\n                if not is_prime(p2):\n                    continue\n                if remainder1 % p2 == 0:\n                    p3 = remainder1 // p2\n                    # Check if p3 is prime and maintains the order p1 <= p2 <= p3.\n                    if is_prime(p3) and p3 >= p2:\n                        return True\n    return False"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"\n    Checks if a string is happy: length at least 3 and every 3 consecutive letters are distinct.\n    Returns True if happy, False otherwise.\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        # Check if the current triplet of characters s[i], s[i+1], s[i+2] are all distinct.\n        if s[i] == s[i+1] or s[i] == s[i+2] or s[i+1] == s[i+2]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Your task is to write a function that returns true if a number x is a simple\n    power of n and false in other cases.\n    x is a simple power of n if n**int=x\n    \"\"\"\n    if x == 1:\n        return True\n\n    if n == 1:\n        return False\n\n    if n == 0:\n        return x == 0\n\n    # If x or n are negative, or x is zero (and n is not zero), it's not a simple power.\n    # The iterative check below assumes positive x and n.\n    if x <= 0 or n <= 0:\n        return False\n\n    current_power = n\n    while current_power < x:\n        current_power *= n\n    return current_power == x"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts the number of prime hexadecimal digits in a given hexadecimal string.\n    Prime hexadecimal digits are 2, 3, 5, 7, B (11), and D (13).\"\"\"\n    _PRIME_HEX_DIGITS = frozenset({'2', '3', '5', '7', 'B', 'D'})\n\n    count = 0\n    if not num:\n        return 0\n\n    for char in num:\n        if char in _PRIME_HEX_DIGITS:\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a decimal number to its binary string representation,\n    formatted with 'db' prefix and suffix.\n    \"\"\"\n    binary_str = bin(decimal).replace('0b', '')\n    formatted_str = \"db\" + binary_str + \"db\"\n    return formatted_str"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Returns True if the string length is a prime number, False otherwise.\n    It uses a helper function _is_prime to check for primality.\"\"\"\n    def _is_prime(n):\n        \"\"\"Checks if an integer n is prime.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n\n    def _calculate_count_starting_with_1(num_digits):\n        # Calculates the count of n-digit positive integers that begin with 1.\n        return 10**(num_digits - 1)\n\n    def _calculate_count_ending_with_1(num_digits):\n        # Calculates the count of n-digit positive integers that end with 1 (for n > 1).\n        # The first digit has 9 choices (1-9), and the middle num_digits-2 digits have 10 choices each.\n        return 9 * (10**(num_digits - 2))\n\n    def _calculate_count_starting_and_ending_with_1(num_digits):\n        # Calculates the count of n-digit positive integers that begin and end with 1 (for n > 1).\n        # The first and last digits are fixed as 1, leaving num_digits-2 middle digits with 10 choices each.\n        return 10**(num_digits - 2)\n\n    if n == 1:\n        return 1\n\n    count_starts_with_1 = _calculate_count_starting_with_1(n)\n    count_ends_with_1 = _calculate_count_ending_with_1(n)\n    count_starts_and_ends_with_1 = _calculate_count_starting_and_ending_with_1(n)\n\n    # Apply the Principle of Inclusion-Exclusion: |A U B| = |A| + |B| - |A intersection B|\n    return count_starts_with_1 + count_ends_with_1 - count_starts_and_ends_with_1"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n\n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n\n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n    # Calculate the sum of the decimal digits of N\n    sum_digits = 0\n    for digit_char in str(N):\n        sum_digits += int(digit_char)\n\n    # Convert the sum of digits to its binary string representation\n    # Python's bin() returns a string like '0b101'. We strip the '0b' prefix.\n    binary_sum = bin(sum_digits)[2:]\n\n    return binary_sum"}
{"task_id": "HumanEval/81", "solution": "class GradingRule:\n    \"\"\"Represents a single GPA to letter grade conversion rule.\"\"\"\n    def __init__(self, lower_bound: float, upper_bound: float, letter_grade: str, is_lower_inclusive: bool, is_upper_inclusive: bool):\n        self._lower_bound = lower_bound\n        self._upper_bound = upper_bound\n        self._letter_grade = letter_grade\n        self._is_lower_inclusive = is_lower_inclusive\n        self._is_upper_inclusive = is_upper_inclusive\n\n    def applies_to(self, gpa: float) -> bool:\n        \"\"\"Checks if a given GPA falls within this rule's defined range.\"\"\"\n        lower_match = gpa >= self._lower_bound if self._is_lower_inclusive else gpa > self._lower_bound\n        upper_match = gpa <= self._upper_bound if self._is_upper_inclusive else gpa < self._upper_bound\n        return lower_match and upper_match\n\n    def get_letter_grade(self) -> str:\n        \"\"\"Returns the letter grade associated with this rule.\"\"\"\n        return self._letter_grade\n_GRADING_RULES = [\n    GradingRule(4.0, 4.0, 'A+', True, True),   # GPA == 4.0\n    GradingRule(3.7, 4.0, 'A', False, False),  # 3.7 < GPA < 4.0\n    GradingRule(3.3, 3.7, 'A-', False, True),  # 3.3 < GPA <= 3.7\n    GradingRule(3.0, 3.3, 'B+', False, True),  # 3.0 < GPA <= 3.3\n    GradingRule(2.7, 3.0, 'B', False, True),   # 2.7 < GPA <= 3.0\n    GradingRule(2.3, 2.7, 'B-', False, True),  # 2.3 < GPA <= 2.7\n    GradingRule(2.0, 2.3, 'C+', False, True),  # 2.0 < GPA <= 2.3\n    GradingRule(1.7, 2.0, 'C', False, True),   # 1.7 < GPA <= 2.0\n    GradingRule(1.3, 1.7, 'C-', False, True),  # 1.3 < GPA <= 1.7\n    GradingRule(1.0, 1.3, 'D+', False, True),  # 1.0 < GPA <= 1.3\n    GradingRule(0.7, 1.0, 'D', False, True),   # 0.7 < GPA <= 1.0\n    GradingRule(0.0, 0.7, 'D-', False, True),  # 0.0 < GPA <= 0.7\n    GradingRule(0.0, 0.0, 'E', True, True)     # GPA == 0.0\n]\ndef _convert_single_gpa(gpa: float, rules: list[GradingRule]) -> str:\n    \"\"\"Converts a single numerical GPA to its corresponding letter grade using predefined rules.\"\"\"\n    for rule in rules:\n        if rule.applies_to(gpa):\n            return rule.get_letter_grade()\n    # As per the problem description, all valid GPAs within the 0.0-4.0 range\n    # are expected to match a rule.\n    return \"N/A\" # Should ideally not be reached with valid inputs as per problem context.\ndef numerical_letter_grade(grades: list[float]) -> list[str]:\n    \"\"\"Converts a list of numerical GPAs into a list of corresponding letter grades.\"\"\"\n    letter_grades_list = []\n    for gpa in grades:\n        letter_grades_list.append(_convert_single_gpa(gpa, _GRADING_RULES))\n    return letter_grades_list"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n\n    Examples:\n        add([4, 2, 6, 7]) ==> 2\n    \"\"\"\n    total_sum = 0\n    for i, element in enumerate(lst):\n        if i % 2 != 0:  # Check if index is odd\n            if element % 2 == 0:  # Check if element is even\n                total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Returns an ordered version of a string where all words have characters\n    arranged in ascending order based on ASCII value, preserving word and space order.\n    \"\"\"\n    result_parts = []\n    current_word_chars = []\n\n    for char in s:\n        if char.isspace():\n            if current_word_chars:\n                sorted_word = ''.join(sorted(current_word_chars))\n                result_parts.append(sorted_word)\n                current_word_chars = []\n            result_parts.append(char)\n        else:\n            current_word_chars.append(char)\n\n    # Append any remaining word characters after the loop\n    if current_word_chars:\n        sorted_word = ''.join(sorted(current_word_chars))\n        result_parts.append(sorted_word)\n\n    return ''.join(result_parts)"}
{"task_id": "HumanEval/87", "solution": "from typing import List, Tuple\ndef get_row(lst: List[List[int]], x: int) -> List[Tuple[int, int]]:\n    \"\"\"\n    Finds integer x in the nested list lst and returns a list of\n    (row, column) coordinates, sorted primarily by row ascending\n    and secondarily by column descending.\n    \"\"\"\n    found_coordinates = []\n\n    for row_idx, row in enumerate(lst):\n        for col_idx, element in enumerate(row):\n            if element == x:\n                found_coordinates.append((row_idx, col_idx))\n\n    # Sort primarily by row in ascending order (coord[0])\n    # Sort secondarily by column in descending order (-coord[1])\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return found_coordinates"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    You are given a list of integers.\n    Write a function next_smallest() that returns the 2nd smallest element of the list.\n    Return None if there is no such element.\n    \"\"\"\n\n    def _get_distinct_sorted_elements(input_list):\n        \"\"\"Helper to get a sorted list of unique integers from the input list.\"\"\"\n        if not input_list:\n            return []\n        distinct_elements = sorted(list(set(input_list)))\n        return distinct_elements\n\n    distinct_sorted = _get_distinct_sorted_elements(lst)\n\n    if len(distinct_sorted) < 2:\n        return None\n\n    return distinct_sorted[1]"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts the input string s by shifting alphabetic characters by 4 positions.\"\"\"\n\n    _SHIFT_AMOUNT = 4\n\n    def _is_lowercase(char: str) -> bool:\n        \"\"\"Checks if the given character is a lowercase letter.\"\"\"\n        return 'a' <= char <= 'z'\n\n    def _is_uppercase(char: str) -> bool:\n        \"\"\"Checks if the given character is an uppercase letter.\"\"\"\n        return 'A' <= char <= 'Z'\n\n    def _shift_char(char_code: int, base_code: int, shift_amount: int) -> int:\n        \"\"\"Calculates the new character code after applying a shift, with wrapping.\"\"\"\n        offset = char_code - base_code\n        shifted_offset = (offset + shift_amount) % 26\n        return base_code + shifted_offset\n\n    encrypted_chars = []\n    for char in s:\n        if _is_lowercase(char):\n            new_char_code = _shift_char(ord(char), ord('a'), _SHIFT_AMOUNT)\n            encrypted_chars.append(chr(new_char_code))\n        elif _is_uppercase(char):\n            new_char_code = _shift_char(ord(char), ord('A'), _SHIFT_AMOUNT)\n            encrypted_chars.append(chr(new_char_code))\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/88", "solution": "from enum import Enum\nclass OrderType(Enum):\n    # Represents the 'reverse' argument for sorting functions.\n    ASCENDING = False\n    DESCENDING = True\ndef _calculate_first_last_sum(array):\n    # Calculates the sum of the first and last elements of the array.\n    return array[0] + array[-1]\ndef _perform_sort(array_copy, order):\n    # Sorts the given array copy based on the specified order type.\n    array_copy.sort(reverse=order.value)\n    return array_copy\ndef sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n\n    # Handle edge cases for empty or single-element arrays by returning a copy.\n    if not array or len(array) == 1:\n        return array[:]\n\n    # Create a mutable copy of the array for sorting operations.\n    array_copy = array[:]\n\n    # Determine the sorting order based on the parity of the sum of first and last elements.\n    first_last_sum = _calculate_first_last_sum(array)\n    if first_last_sum % 2 != 0: # Sum is odd, sort in ascending order.\n        sort_order = OrderType.ASCENDING\n    else: # Sum is even, sort in descending order.\n        sort_order = OrderType.DESCENDING\n\n    # Perform the sort on the copy and return the result.\n    return _perform_sort(array_copy, sort_order)"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts the number of \"boredoms\" in a string. A boredom is a sentence that starts with \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n\n    class Sentence:\n        \"\"\"Encapsulates a single sentence and checks if it starts with 'I'.\"\"\"\n        def __init__(self, text: str):\n            self._text = text\n\n        def starts_with_i(self) -> bool:\n            \"\"\"Trims spaces and checks if the first word is 'I' (case-sensitive).\"\"\"\n            trimmed_text = self._text.strip()\n            if not trimmed_text:\n                return False\n            # Check if it starts with \"I \" or \"I.\" or \"I?\" or \"I!\" or simply \"I\"\n            return trimmed_text.startswith(\"I \") or trimmed_text == \"I\"\n\n    class InputString:\n        \"\"\"Encapsulates the raw input string and provides sentence splitting logic.\"\"\"\n        def __init__(self, text: str):\n            self._text = text\n\n        def split_into_sentences(self) -> list[Sentence]:\n            \"\"\"Splits the text into a list of Sentence objects using delimiters '.', '?', '!'.\"\"\"\n            sentences = []\n            current_sentence = []\n            for char in self._text:\n                current_sentence.append(char)\n                if char in ['.', '?', '!']:\n                    sentence_text = \"\".join(current_sentence)\n                    sentences.append(Sentence(sentence_text.strip()))\n                    current_sentence = []\n\n            # Add any remaining text as a sentence if it's not empty\n            if current_sentence:\n                remaining_text = \"\".join(current_sentence).strip()\n                if remaining_text:\n                    sentences.append(Sentence(remaining_text))\n\n            return sentences\n\n    input_obj = InputString(S)\n    sentence_objects = input_obj.split_into_sentences()\n\n    boredom_count = 0\n    for sentence in sentence_objects:\n        if sentence.starts_with_i():\n            boredom_count += 1\n\n    return boredom_count"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    '''\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False\n\n    if x == y + z or y == x + z or z == x + y:\n        return True\n\n    return False"}
{"task_id": "HumanEval/93", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u'}\nALPHABET_LOWER = 'abcdefghijklmnopqrstuvwxyz'\nALPHABET_UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'\ndef encode(message):\n    \"\"\"\n    Encodes a message by swapping letter cases and shifting vowels.\n    Non-alphabetical characters remain unchanged.\n    \"\"\"\n\n    def _is_vowel(char_val):\n        \"\"\"Checks if a character is an English vowel (case-insensitive).\"\"\"\n        return char_val.lower() in VOWELS\n\n    def _is_alphabetical(char_val):\n        \"\"\"Checks if a character is an English alphabet letter.\"\"\"\n        return char_val.isalpha()\n\n    def _shift_char(char_val, places):\n        \"\"\"\n        Shifts an alphabetical character 'places' positions ahead in the alphabet,\n        preserving its original case.\n        \"\"\"\n        if char_val.islower():\n            alphabet = ALPHABET_LOWER\n        else:\n            alphabet = ALPHABET_UPPER\n\n        current_index = alphabet.find(char_val)\n        if current_index == -1: # Should not happen if _is_alphabetical is true\n            return char_val\n\n        new_index = (current_index + places) % len(alphabet)\n        return alphabet[new_index]\n\n    def _swap_case(char_val):\n        \"\"\"Swaps the case of an alphabetical character.\"\"\"\n        return char_val.swapcase()\n\n    encoded_chars = []\n    for char in message:\n        if _is_alphabetical(char):\n            processed_char = char\n            if _is_vowel(char):\n                processed_char = _shift_char(char, 2)\n            processed_char = _swap_case(processed_char)\n            encoded_chars.append(processed_char)\n        else:\n            encoded_chars.append(char)\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Implement a function that takes a non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    \"\"\"\n    def is_prime(number: int) -> bool:\n        \"\"\"Checks if 'number' is prime. Returns True if prime, False otherwise.\"\"\"\n        if number < 2:\n            return False\n        for i in range(2, int(number**0.5) + 1):\n            if number % i == 0:\n                return False\n        return True\n\n    if n <= 1:\n        return []\n\n    primes = []\n    for number in range(2, n):\n        if is_prime(number):\n            primes.append(number)\n    return primes"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lower = True\n    all_upper = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n        if not key.islower():\n            all_lower = False\n\n        if not key.isupper():\n            all_upper = False\n\n    return all_lower or all_upper"}
{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Complete the function that takes two integers and returns\n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    \"\"\"\n    unit_digit_a = abs(a) % 10\n    unit_digit_b = abs(b) % 10\n    return unit_digit_a * unit_digit_b"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def find_largest_prime_in_list(numbers: list[int]) -> int | None:\n        \"\"\"Identifies all prime numbers in a list and returns the largest one.\"\"\"\n        largest_prime = None\n        for num in numbers:\n            if is_prime(num):\n                if largest_prime is None or num > largest_prime:\n                    largest_prime = num\n        return largest_prime\n\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the individual digits of an integer.\"\"\"\n        n = abs(n) # Handle negative numbers by summing digits of their absolute value.\n        s = 0\n        while n > 0:\n            s += n % 10\n            n //= 10\n        return s\n\n    largest_prime_val = find_largest_prime_in_list(lst)\n\n    if largest_prime_val is None:\n        return 0\n\n    return sum_digits(largest_prime_val)"}
{"task_id": "HumanEval/98", "solution": "def count_upper(s):\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n    \"\"\"\n    count = 0\n    uppercase_vowels = {'A', 'E', 'I', 'O', 'U'}\n    for i, char in enumerate(s):\n        if i % 2 == 0 and char in uppercase_vowels:\n            count += 1\n    return count"}
{"task_id": "HumanEval/99", "solution": "import math\ndef closest_integer(value):\n    '''\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n\n    Examples\n    >>> closest_integer(\"10\")\n    10\n    >>> closest_integer(\"15.3\")\n    15\n\n    Note:\n    Rounding away from zero means that if the given number is equidistant\n    from two integers, the one you should return is the one that is the\n    farthest from zero. For example closest_integer(\"14.5\") should\n    return 15 and closest_integer(\"-14.5\") should return -15.\n    '''\n    num_float = float(value)\n    # This logic implements 'round half away from zero'.\n    # It adds 0.5 to the absolute value, floors it, and then applies the original sign.\n    rounded_num = math.copysign(math.floor(abs(num_float) + 0.5), num_float)\n    return int(rounded_num)"}
