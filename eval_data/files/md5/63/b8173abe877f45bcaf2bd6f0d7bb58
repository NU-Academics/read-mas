{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    def _is_divisible_by_11_or_13(number: int) -> bool:\n        \"\"\"Checks if a number is divisible by 11 or 13.\"\"\"\n        return (number % 11 == 0) or (number % 13 == 0)\n\n    def _count_digit_seven(number: int) -> int:\n        \"\"\"Counts occurrences of the digit '7' in a number.\"\"\"\n        return str(number).count('7')\n\n    total_sevens = 0\n    for i in range(1, n):\n        if _is_divisible_by_11_or_13(i):\n            total_sevens += _count_digit_seven(i)\n    return total_sevens"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    result = list(l) # Create a mutable copy of the input list.\n    even_indexed_values = []\n\n    for i in range(0, len(l), 2):\n        even_indexed_values.append(l[i])\n\n    even_indexed_values.sort()\n\n    even_idx_ptr = 0\n    for i in range(0, len(result), 2):\n        result[i] = even_indexed_values[even_idx_ptr]\n        even_idx_ptr += 1\n\n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    import math\n\n    def _is_perfect_square(num: int) -> bool:\n        \"\"\"Checks if a given number is a perfect square.\"\"\"\n        if num < 0:\n            return False\n        if num == 0:\n            return True\n        sqrt_num = int(math.sqrt(num))\n        return sqrt_num * sqrt_num == num\n\n    def _is_fibonacci(num: int) -> bool:\n        \"\"\"Determines if a number is a Fibonacci number using a mathematical property.\"\"\"\n        return _is_perfect_square(5 * num * num + 4) or _is_perfect_square(5 * num * num - 4)\n\n    def _is_prime(num: int) -> bool:\n        \"\"\"Checks if a given number is prime using trial division.\"\"\"\n        if num <= 1:\n            return False\n        if num <= 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def _fibonacci_generator():\n        \"\"\"A generator that yields Fibonacci numbers (0, 1, 1, 2, 3, 5, ...).\"\"\"\n        a, b = 0, 1\n        while True:\n            yield a\n            a, b = b, a + b\n\n    prime_fib_count = 0\n    fib_gen = _fibonacci_generator()\n\n    while True:\n        fib_num = next(fib_gen)\n        # The _is_prime function handles non-positive numbers and 1 correctly.\n        if _is_prime(fib_num):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return fib_num"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    import itertools\n\n    if len(l) < 3:\n        return False\n\n    for i, j, k in itertools.combinations(range(len(l)), 3):\n        if l[i] + l[j] + l[k] == 0:\n            return True\n\n    return False"}
