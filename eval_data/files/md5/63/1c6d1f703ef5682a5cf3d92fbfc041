{"task_id": "HumanEval/139", "solution": "def _calculate_factorial(num):\n    \"\"\"Calculates the standard factorial of a positive integer.\"\"\"\n    result = 1\n    for i in range(1, num + 1):\n        result *= i\n    return result\ndef _calculate_brazilian_factorial(n):\n    \"\"\"Calculates the Brazilian factorial by multiplying individual factorials.\"\"\"\n    brazilian_factorial_result = 1\n    for i in range(n, 0, -1):\n        brazilian_factorial_result *= _calculate_factorial(i)\n    return brazilian_factorial_result\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    return _calculate_brazilian_factorial(n)"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    # First, replace sequences of 3 or more spaces with a single dash.\n    # This handles the specific rule for \"more than 2 consecutive spaces\".\n    processed_text = re.sub(r' {3,}', '-', text)\n\n    # Then, replace any remaining single spaces with underscores.\n    # This covers individual spaces and sequences of exactly two spaces (e.g., \"  \" becomes \"__\").\n    processed_text = processed_text.replace(' ', '_')\n\n    return processed_text"}
{"task_id": "HumanEval/142", "solution": "from typing import List\ndef sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n\n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    if not lst:\n        return 0\n\n    total = 0\n    for i, value in enumerate(lst):\n        if i % 3 == 0:\n            total += value * value\n        elif i % 4 == 0:\n            total += value * value * value\n        else:\n            total += value\n    return total"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts integers by digit sum in ascending order.\n    Maintains original order for equal digit sums.\n    \"\"\"\n    def digit_sum(num):\n        \"\"\"\n        Calculates digit sum with negative sign applying to first digit only.\n        \"\"\"\n        if num == 0:\n            return 0\n        \n        s = 0\n        s_str = str(num)\n        \n        if s_str[0] == '-':\n            s += -int(s_str[1])  # Apply negative sign to the first digit\n            for digit_char in s_str[2:]:\n                s += int(digit_char)\n        else:\n            for digit_char in s_str:\n                s += int(digit_char)\n        return s\n\n    # Create a list of tuples (original_number, original_index) to preserve original order\n    indexed_nums = [(num, i) for i, num in enumerate(nums)]\n\n    # Sort using a custom key: (digit_sum, original_index)\n    # Python's sorted() is stable, but adding index ensures tie-breaking as required.\n    sorted_indexed_nums = sorted(indexed_nums, key=lambda x: (digit_sum(x[0]), x[1]))\n\n    # Extract the original numbers from the sorted tuples\n    return [num for num, _ in sorted_indexed_nums]"}
{"task_id": "HumanEval/141", "solution": "def _count_digits(s: str) -> int:\n    \"\"\"Helper to count digits in file name.\"\"\"\n    count = 0\n    for char in s:\n        if '0' <= char <= '9':\n            count += 1\n    return count\ndef _count_dots(s: str) -> int:\n    \"\"\"Helper to count dots in file name.\"\"\"\n    return s.count('.')\ndef _validate_prefix(prefix: str) -> bool:\n    \"\"\"Helper to validate prefix format.\"\"\"\n    if not prefix:\n        return False\n    return prefix[0].isalpha()\ndef _validate_extension(extension: str) -> bool:\n    \"\"\"Helper to validate extension against allowed list.\"\"\"\n    allowed_extensions = ['txt', 'exe', 'dll']\n    return extension in allowed_extensions\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions \n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from \n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    # Condition: The file's name contains exactly one dot '.'\n    dot_count = _count_dots(file_name)\n    if dot_count != 1:\n        return 'No'\n\n    # Split the file name into prefix and extension.\n    parts = file_name.split('.')\n    prefix = parts[0]\n    extension = parts[1]\n\n    # Condition: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = _count_digits(file_name)\n    if digit_count > 3:\n        return 'No'\n\n    # Condition: The substring before the dot should not be empty, and it starts with a letter.\n    if not _validate_prefix(prefix):\n        return 'No'\n\n    # Condition: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    if not _validate_extension(extension):\n        return 'No'\n\n    # If all conditions are met, the file name is valid.\n    return 'Yes'"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, keeping only those with prime lengths.\n    Preserves original word order.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split()\n    prime_length_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/144", "solution": "import math\ndef simplify(x, n):\n    \"\"\"\n    Checks if the product of two fractions, represented as strings, is a whole number.\n    Parses fractions, multiplies them, and determines if the result is a whole number.\n    \"\"\"\n\n    def parse_fraction(fraction_str):\n        \"\"\"Parses a fraction string into its numerator and denominator.\"\"\"\n        parts = fraction_str.split('/')\n        return int(parts[0]), int(parts[1])\n\n    def multiply_fractions(frac1, frac2):\n        \"\"\"Multiplies two fractions and returns the resulting fraction.\"\"\"\n        num1, den1 = frac1\n        num2, den2 = frac2\n        return num1 * num2, den1 * den2\n\n    def is_whole_number(fraction):\n        \"\"\"Determines if a fraction represents a whole number after simplification.\"\"\"\n        numerator, denominator = fraction\n        # Use GCD to simplify the fraction before checking divisibility\n        common_divisor = math.gcd(numerator, denominator)\n        simplified_numerator = numerator // common_divisor\n        simplified_denominator = denominator // common_divisor\n        return simplified_numerator % simplified_denominator == 0\n\n    frac_x = parse_fraction(x)\n    frac_n = parse_fraction(n)\n    \n    product_fraction = multiply_fractions(frac_x, frac_n)\n    \n    return is_whole_number(product_fraction)"}
{"task_id": "HumanEval/146", "solution": "def extract_first_digit(num: int) -> int:\n    \"\"\"Extracts the leftmost digit from the absolute value of a number.\"\"\"\n    return int(str(abs(num))[0])\ndef extract_last_digit(num: int) -> int:\n    \"\"\"Extracts the rightmost digit from the absolute value of a number.\"\"\"\n    return abs(num) % 10\ndef is_odd_digit(digit: int) -> bool:\n    \"\"\"Checks if a digit is odd (1, 3, 5, 7, 9).\"\"\"\n    return digit % 2 != 0\ndef process_number(num: int) -> bool:\n    \"\"\"Processes an individual number against all filtering criteria.\"\"\"\n    if num <= 10:\n        return False\n    \n    first_digit = extract_first_digit(num)\n    last_digit = extract_last_digit(num)\n    \n    return is_odd_digit(first_digit) and is_odd_digit(last_digit)\ndef specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns \n    the number of elements in the array that are greater than 10 and both \n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    For example:\n    specialFilter([15, -73, 14, -15]) => 1 \n    specialFilter([33, -2, -3, 45, 21, 109]) => 2\n    \"\"\"\n    count = 0\n    for num in nums:\n        if process_number(num):\n            count += 1\n    return count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, \n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    # Generate the array 'a' based on the formula.\n    # For a 0-indexed array 'a', where 'idx' ranges from 0 to n-1,\n    # the corresponding 'i' in the formula (1-indexed) is (idx + 1).\n    # So, a[idx] = (idx + 1) * (idx + 1) - (idx + 1) + 1,\n    # which simplifies to a[idx] = idx*idx + idx + 1.\n    a = []\n    for idx in range(n):\n        a.append(idx * idx + idx + 1)\n\n    # Initialize a counter for valid triples.\n    valid_triples_count = 0\n\n    # Iterate through all possible combinations of indices (i, j, k)\n    # such that 0 <= i < j < k < n.\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                # Calculate the sum of the elements at the current indices.\n                current_sum = a[i] + a[j] + a[k]\n\n                # Check if the sum is a multiple of 3.\n                if current_sum % 3 == 0:\n                    valid_triples_count += 1\n\n    return valid_triples_count"}
{"task_id": "HumanEval/150", "solution": "def is_prime(n):\n    \"\"\"Determines if a number n is prime.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n    \"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/148", "solution": "PLANETS = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\nPLANET_POSITIONS = {planet: i + 1 for i, planet in enumerate(PLANETS)}\ndef validate_planet(name):\n    \"\"\"Checks if a given planet name is valid.\"\"\"\n    return name in PLANET_POSITIONS\ndef get_planet_position(name):\n    \"\"\"Returns the 1-indexed position of a planet from the Sun.\"\"\"\n    return PLANET_POSITIONS[name]\ndef get_planets_between(pos1, pos2):\n    \"\"\"Retrieves planet names located between two 1-indexed orbital positions.\"\"\"\n    idx1 = pos1 - 1\n    idx2 = pos2 - 1\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n    return PLANETS[start_idx + 1 : end_idx]\ndef sort_by_proximity(planets_list):\n    \"\"\"Converts a list of planets (already sorted by proximity) to a tuple.\"\"\"\n    return tuple(planets_list)\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    if not validate_planet(planet1) or not validate_planet(planet2):\n        return ()\n\n    pos1 = get_planet_position(planet1)\n    pos2 = get_planet_position(planet2)\n\n    intermediate_planets_list = get_planets_between(pos1, pos2)\n    result_tuple = sort_by_proximity(intermediate_planets_list)\n\n    return result_tuple"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Write a function that accepts a list of strings as a parameter,\n    deletes the strings that have odd lengths from it,\n    and returns the resulted list with a sorted order,\n    The list is always a list of strings and never an array of numbers,\n    and it may contain duplicates.\n    The order of the list should be ascending by length of each word, and you\n    should return the list sorted by that rule.\n    If two words have the same length, sort the list alphabetically.\n    The function should return a list of strings in sorted order.\n    You may assume that all words will have the same length.\n    For example:\n    assert list_sort([\"aa\", \"a\", \"aaa\"]) => [\"aa\"]\n    assert list_sort([\"ab\", \"a\", \"aaa\", \"cd\"]) => [\"ab\", \"cd\"]\n    \"\"\"\n    # Filter out strings with odd lengths from the list.\n    filtered_list = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort the remaining strings by length in ascending order,\n    # then alphabetically for strings of the same length.\n    filtered_list.sort(key=lambda s: (len(s), s))\n\n    return filtered_list"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        # Check if the number is an integer, positive, and odd.\n        if isinstance(num, int) and num > 0 and num % 2 != 0:\n            total_sum += num * num\n    return total_sum"}
{"task_id": "HumanEval/154", "solution": "def generate_rotations(s):\n    \"\"\"Generates all cyclic rotations of a given string.\"\"\"\n    n = len(s)\n    if n == 0:\n        return [\"\"]\n    rotations = []\n    for i in range(n):\n        rotated_s = s[i:] + s[:i]\n        rotations.append(rotated_s)\n    return rotations\ndef is_substring(main_str, pattern):\n    \"\"\"Checks if a pattern string is a substring of the main string.\"\"\"\n    return pattern in main_str\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    rotations_of_b = generate_rotations(b)\n\n    for rotation in rotations_of_b:\n        if is_substring(a, rotation):\n            return True\n            \n    return False"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Compares game scores to guesses and returns the absolute difference for each match.\n    A correct guess results in a difference of 0.\"\"\"\n    result = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            result.append(0)\n        else:\n            result.append(abs(game[i] - guess[i]))\n    return result"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on CAP - SM strength and returns a formatted string.\n    Handles ties by choosing the first encountered strongest extension.\n    \"\"\"\n\n    def count_uppercase(text):\n        \"\"\"Counts the number of uppercase letters in a string.\"\"\"\n        return sum(1 for char in text if char.isupper())\n\n    def count_lowercase(text):\n        \"\"\"Counts the number of lowercase letters in a string.\"\"\"\n        return sum(1 for char in text if char.islower())\n\n    def calculate_strength(extension):\n        \"\"\"Calculates the strength of an extension as CAP - SM.\"\"\"\n        cap = count_uppercase(extension)\n        sm = count_lowercase(extension)\n        return cap - sm\n\n    def format_result(class_name, extension_name):\n        \"\"\"Formats the result string.\"\"\"\n        return f\"{class_name}.{extension_name}\"\n\n    max_strength = float('-inf')\n    strongest_ext_name = \"\"\n\n    for extension in extensions:\n        current_strength = calculate_strength(extension)\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = extension\n    \n    # If extensions list is empty, strongest_ext_name remains \"\", which will result in ClassName.\n    # The problem description implies extensions will not be empty or expects the default \"\" behavior.\n    return format_result(class_name, strongest_ext_name)"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n\n    def _is_even(digit):\n        # Determines if a digit is even, including zero.\n        return digit % 2 == 0\n\n    def _extract_digits(n):\n        # Extracts individual digits from the absolute value of an integer.\n        if n == 0:\n            return [0]\n        abs_n = abs(n)\n        return [int(d) for d in str(abs_n)]\n\n    even_count = 0\n    odd_count = 0\n\n    digits = _extract_digits(num)\n\n    for digit in digits:\n        if _is_even(digit):\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    if not 1 <= number <= 1000:\n        raise ValueError(\"Input must be between 1 and 1000\")\n\n    roman_map = {\n        1000: 'M', 900: 'CM', 500: 'D', 400: 'CD', 100: 'C',\n        90: 'XC', 50: 'L', 40: 'XL', 10: 'X', 9: 'IX', 5: 'V',\n        4: 'IV', 1: 'I'\n    }\n\n    result = []\n    for value, numeral in sorted(roman_map.items(), reverse=True):\n        while number >= value:\n            result.append(numeral)\n            number -= value\n    return \"\".join(result).lower()"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Sort the sides to easily identify the legs and the hypotenuse\n    sides = sorted([a, b, c])\n    \n    # The two shortest sides are the legs, and the longest side is the hypotenuse.\n    leg1 = sides[0]\n    leg2 = sides[1]\n    hypotenuse = sides[2]\n    \n    # Define a small tolerance for floating-point comparisons.\n    epsilon = 1e-9\n    \n    # Apply the Pythagorean theorem: leg1^2 + leg2^2 = hypotenuse^2.\n    # Use epsilon to compare floating-point results.\n    return abs(leg1**2 + leg2**2 - hypotenuse**2) < epsilon"}
{"task_id": "HumanEval/158", "solution": "def _count_unique_chars(word):\n    \"\"\"Helper function to count unique characters in a string.\"\"\"\n    return len(set(word))\ndef _find_max_count(word_counts):\n    \"\"\"Helper function to find the maximum unique character count from word-count pairs.\"\"\"\n    max_count = 0\n    for _, count in word_counts:\n        if count > max_count:\n            max_count = count\n    return max_count\ndef _select_lexicographically_first(candidates):\n    \"\"\"Helper function to select the lexicographically first string from a list.\"\"\"\n    if not candidates:\n        return \"\"\n    return min(candidates)\ndef find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    # Step 1: Calculate unique character count for each word\n    # Store as (word, unique_char_count) tuples.\n    word_counts_pairs = []\n    for word in words:\n        count = _count_unique_chars(word)\n        word_counts_pairs.append((word, count))\n\n    # Step 2: Find the maximum unique character count among all words\n    max_unique_count = _find_max_count(word_counts_pairs)\n\n    # Step 3: Filter words that have this maximum unique character count\n    candidate_words = []\n    for word, count in word_counts_pairs:\n        if count == max_unique_count:\n            candidate_words.append(word)\n\n    # Step 4: If there are multiple candidates, select the lexicographically first one\n    return _select_lexicographically_first(candidate_words)"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    \n    md5_hash = hashlib.md5(text.encode('utf-8'))\n    return md5_hash.hexdigest()"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and remaining after a rabbit's meal.\n    The rabbit eats as many carrots as needed, up to the remaining stock.\n    \"\"\"\n    \n    carrots_eaten_now = min(need, remaining)\n    \n    total_eaten_carrots = number + carrots_eaten_now\n    carrots_left_in_stock = remaining - carrots_eaten_now\n    \n    return [total_eaten_carrots, carrots_left_in_stock]"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"\n    Reverses case of letters or reverses the whole string if no letters are present.\n    \"\"\"\n    def _has_letters(s_val):\n        \"\"\"Checks if the string contains any letters.\"\"\"\n        for char in s_val:\n            if char.isalpha():\n                return True\n        return False\n\n    def _reverse_case(char_val):\n        \"\"\"Reverses the case of a single letter character.\"\"\"\n        if char_val.isupper():\n            return char_val.lower()\n        elif char_val.islower():\n            return char_val.upper()\n        return char_val\n\n    def _reverse_string(s_val):\n        \"\"\"Reverses the order of characters in a string.\"\"\"\n        return s_val[::-1]\n\n    if _has_letters(s):\n        result_chars = []\n        for char in s:\n            result_chars.append(_reverse_case(char))\n        return \"\".join(result_chars)\n    else:\n        return _reverse_string(s)"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + ) \n    Subtraction ( - ) \n    Multiplication ( * ) \n    Floor division ( // ) \n    Exponentiation ( ** ) \n\n    Example:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n\n    \"\"\"\n    expression_parts = []\n    expression_parts.append(str(operand[0]))\n\n    for i in range(len(operator)):\n        expression_parts.append(operator[i])\n        expression_parts.append(str(operand[i+1]))\n    \n    expression_string = \" \".join(expression_parts)\n    result = eval(expression_string)\n    \n    return result"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    \n    # Helper function to validate inputs (positive integers)\n    def _validate_inputs(x, y):\n        # The design context states not to raise exceptions here,\n        # but to assume valid positive integers for the core logic based on requirements.\n        # This function would typically check for int type and positivity.\n        pass\n\n    # Helper function to filter even digits within the specified range\n    def _get_even_digits_in_range(min_val, max_val):\n        even_digits = []\n        # Only single digits 0-9 are considered for \"even digits\".\n        # The problem statement implies \"digits\" within the range, not numbers.\n        # However, the example generate_integers(2, 8) => [2, 4, 6, 8]\n        # clearly implies *numbers* that are single-digit and even,\n        # which are also *digits*. The example generate_integers(10, 14) => []\n        # reinforces that two-digit numbers like 10, 12, 14 are ignored,\n        # thus implying only single-digit numbers (0-9) are of interest.\n        \n        # Given the examples and the \"Process only single digits (0-9)\" requirement:\n        # We need to find single even digits that fall within the *numerical* range [min_val, max_val].\n        \n        for digit in [0, 2, 4, 6, 8]:\n            if min_val <= digit <= max_val:\n                even_digits.append(digit)\n        return even_digits\n\n    # Helper function to sort the results in ascending order\n    def _sort_ascending(digits):\n        return sorted(digits)\n\n    # Main function logic following the sequence diagram\n    _validate_inputs(a, b) # Assume validation passes as per design context\n\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    # Filter even digits that are also within the numerical range [min_val, max_val]\n    result_digits = _get_even_digits_in_range(min_val, max_val)\n\n    # Sort the filtered digits\n    sorted_result = _sort_ascending(result_digits)\n\n    return sorted_result"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic. A palindromic array is an array that\n    is read the same backwards and forwards. In one change, you can change one element to any other element.\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes"}
