{"task_id": "HumanEval/52", "solution": "def below_threshold(l: list, t: int):\n    \"\"\"Return True if all numbers in the list l are below threshold t.\n    >>> below_threshold([1, 2, 4, 10], 100)\n    True\n    >>> below_threshold([1, 20, 4, 10], 5)\n    False\n    \"\"\"\n    return all(num < t for num in l)"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n == 1:\n        return 1\n    # For n > 1, calculate iteratively starting with F_1 and F_2\n    a, b = 1, 1\n    for _ in range(n - 2):\n        a, b = b, a + b\n    return b"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        \n        # If balance goes negative, a closing bracket appeared without a matching opening bracket\n        if balance < 0:\n            return False\n            \n    # After iterating, if balance is 0, all brackets are correctly matched\n    return balance == 0"}
{"task_id": "HumanEval/54", "solution": "def same_chars(s0: str, s1: str):\n    \"\"\"\n    Check if two words have the same characters.\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')\n    True\n    >>> same_chars('abcd', 'dddddddabc')\n    True\n    >>> same_chars('dddddddabc', 'abcd')\n    True\n    >>> same_chars('eabcd', 'dddddddabc')\n    False\n    >>> same_chars('abcd', 'dddddddabce')\n    False\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddddabc')\n    False\n    \"\"\"\n    return set(s0) == set(s1)"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list) -> bool:\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    # Determine initial trend (increasing, decreasing, or still undetermined if first elements are equal)\n    i = 1\n    while i < len(l) and l[i] == l[i-1]:\n        i += 1\n    \n    # If all elements are equal or list has only one distinct element\n    if i == len(l):\n        return True\n\n    # Now a clear trend is established\n    is_increasing = l[i] > l[i-1]\n    \n    # Check the rest of the list\n    for j in range(i + 1, len(l)):\n        if is_increasing:\n            if l[j] < l[j-1]:\n                return False\n        else: # is_decreasing\n            if l[j] > l[j-1]:\n                return False\n    \n    return True"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n\n    \"\"\"\n    # Convert lists to sets to find common elements efficiently\n    # Then convert the resulting set back to a sorted list.\n    return sorted(list(set(l1) & set(l2)))"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int) -> int:\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    # Calculates the sum of integers from 1 to n using the arithmetic series formula.\n    # This formula provides an efficient O(1) computation.\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n\n    # Divide by 2 until n is odd\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Check for odd factors from 3 up to sqrt(n)\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n        i += 2\n\n    # If n is still greater than 1, it must be the largest prime factor\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            if balance == 0:\n                return False\n            balance -= 1\n    return balance == 0"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\"\n    Calculates the derivative of a polynomial represented by its coefficients.\n    The derivative of a polynomial ax^n is n*ax^(n-1).\n    \"\"\"\n    if not xs or len(xs) == 1:\n        return []\n\n    # The derivative of c_0 + c_1*x + c_2*x^2 + ... + c_n*x^n is\n    # c_1 + 2*c_2*x + 3*c_3*x^2 + ... + n*c_n*x^(n-1)\n    # The new coefficients are derived from the old ones starting from xs[1].\n    # For a term xs[i] * x^i, its derivative is i * xs[i] * x^(i-1).\n    # This means the new coefficient at index (i-1) will be i * xs[i].\n    \n    # Iterate from the second coefficient (index 1) up to the last coefficient.\n    # The term xs[i] corresponds to x^i, so its power is i.\n    # The new coefficient for x^(i-1) is i * xs[i].\n    return [i * xs[i] for i in range(1, len(xs))]"}
{"task_id": "HumanEval/63", "solution": "_fibfib_cache = {0: 0, 1: 0, 2: 1}\ndef fibfib(n: int):\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if n in _fibfib_cache:\n        return _fibfib_cache[n]\n\n    # Compute and cache fibfib numbers iteratively up to n.\n    for i in range(len(_fibfib_cache), n + 1):\n        _fibfib_cache[i] = _fibfib_cache[i-1] + _fibfib_cache[i-2] + _fibfib_cache[i-3]\n        \n    return _fibfib_cache[n]"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    s = str(x)\n    n = len(s)\n\n    if shift > n:\n        return s[::-1]\n    else:\n        effective_shift = shift % n\n        return s[n - effective_shift:] + s[:n - effective_shift]"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculate the sum of ASCII codes for uppercase characters in a string.\n    It iterates through the string, checks if each character is uppercase, and adds its ASCII value to a running total.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given the counts of apples and oranges\n    and the total number of fruits.\n    \"\"\"\n    parts = s.split()\n    apples = int(parts[0])\n    oranges = int(parts[3])\n    \n    mangoes = n - apples - oranges\n    return mangoes"}
{"task_id": "HumanEval/69", "solution": "import collections\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    def _calculate_frequencies(data_list):\n        return collections.Counter(data_list)\n\n    def _find_qualifying_integers(freq_map):\n        qualifiers = []\n        for num, count in freq_map.items():\n            if num > 0 and count >= num:\n                qualifiers.append(num)\n        return qualifiers\n\n    def _get_maximum(candidates_list):\n        if not candidates_list:\n            return -1\n        return max(candidates_list)\n\n    frequencies = _calculate_frequencies(lst)\n    qualifying_integers = _find_qualifying_integers(frequencies)\n    result = _get_maximum(qualifying_integers)\n    return result"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even node and its index in an array.\n    Returns [value, index] or [] if no even values or array is empty.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_found = None # Stores a (value, index) tuple of the smallest even found\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:\n            if smallest_even_found is None:\n                # This is the first even number encountered\n                smallest_even_found = (value, i)\n            elif value < smallest_even_found[0]:\n                # Found an even number with a smaller value\n                smallest_even_found = (value, i)\n            elif value == smallest_even_found[0]:\n                # Found an even number with the same smallest value, check index\n                if i < smallest_even_found[1]:\n                    smallest_even_found = (value, i)\n    \n    if smallest_even_found is None:\n        return []\n    else:\n        return list(smallest_even_found)"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    # Sort the list to easily pick min (first element) and max (last element)\n    remaining_elements = sorted(list(lst))\n    result = []\n    min_turn = True\n\n    while remaining_elements:\n        if min_turn:\n            # Pick the minimum remaining element\n            result.append(remaining_elements.pop(0))\n        else:\n            # Pick the maximum remaining element\n            result.append(remaining_elements.pop())\n        min_turn = not min_turn\n\n    return result"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"\n    Counts the number of vowels in a string, including 'y' if it's at the end.\n    Vowels are 'a', 'e', 'i', 'o', 'u' (case-insensitive).\n    \"\"\"\n    vowels = {'a', 'e', 'i', 'o', 'u'}\n    count = 0\n    s_lower = s.lower()\n\n    for i, char in enumerate(s_lower):\n        if char in vowels:\n            count += 1\n        elif char == 'y' and i == len(s_lower) - 1:\n            count += 1\n            \n    return count"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    def _validate_triangle(a_side, b_side, c_side):\n        \"\"\"Checks if the given side lengths form a valid triangle.\"\"\"\n        if not (a_side + b_side > c_side and a_side + c_side > b_side and b_side + c_side > a_side):\n            return False\n        return True\n\n    def _calculate_area(a_side, b_side, c_side):\n        \"\"\"Calculates the area of a triangle using Heron's formula.\"\"\"\n        s = (a_side + b_side + c_side) / 2\n        area = math.sqrt(s * (s - a_side) * (s - b_side) * (s - c_side))\n        return area\n\n    if not _validate_triangle(a, b, c):\n        return -1\n\n    area = _calculate_area(a, b, c)\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "def is_palindromic(q):\n    \"\"\"Checks if a list is a palindrome.\"\"\"\n    return q == q[::-1]\ndef calculate_sum(q):\n    \"\"\"Calculates the sum of elements in a list.\"\"\"\n    return sum(q)\ndef validate_weight(current_sum, max_weight):\n    \"\"\"Checks if the current sum is within the maximum allowed weight.\"\"\"\n    return current_sum <= max_weight\ndef will_it_fly(q,w):\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n\n    Example:\n    will_it_fly([1, 2], 5) \u279e False\n    # 1+2 is less than the maximum possible weight, but it's unbalanced.\n\n    will_it_fly([3, 2, 3], 1) \u279e False\n    # it's balanced, but 3+2+3 is more than the maximum possible weight.\n\n    will_it_fly([3, 2, 3], 9) \u279e True\n    # 3+2+3 is less than the maximum possible weight, and it's balanced.\n\n    will_it_fly([3], 5) \u279e True\n    # 3 is less than the maximum possible weight, and it's balanced.\n    '''\n    balanced = is_palindromic(q)\n    total_weight = calculate_sum(q)\n    weight_ok = validate_weight(total_weight, w)\n\n    return balanced and weight_ok"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    '''\n    Write a function that accepts two lists of strings and returns the list that has \n    total number of chars in the all strings of the list less than the other list.\n\n    if the two lists have the same number of chars, return the first list.\n\n    Examples\n    total_match([], []) \u279e []\n    total_match(['hi', 'admin'], ['hI', 'Hi']) \u279e ['hI', 'Hi']\n    total_match(['hi', 'admin'], ['hi', 'hi', 'admin', 'project']) \u279e ['hi', 'admin']\n    total_match(['hi', 'admin'], ['hI', 'hi', 'hi']) \u279e ['hI', 'hi', 'hi']\n    total_match(['4'], ['1', '2', '3', '4', '5']) \u279e ['4']\n    '''\n    count1 = sum(len(s) for s in lst1)\n    count2 = sum(len(s) for s in lst2)\n\n    if count1 <= count2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Convert decimal number to binary format with db prefix and suffix.\n\n    The built-in bin() function returns a string prefixed with '0b', which needs to be removed.\n    \"\"\"\n    binary_string = bin(decimal)[2:]\n    return f\"db{binary_string}db\""}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Write a function that takes an integer a and returns True \n    if this ingeger is a cube of some integer number.\n    Note: you may assume the input is always valid.\n    Examples:\n    iscube(1) ==> True\n    iscube(2) ==> False\n    iscube(-1) ==> True\n    iscube(64) ==> True\n    iscube(0) ==> True\n    iscube(180) ==> False\n    '''\n    if a == 0:\n        return True\n    \n    # Calculate the cube root of the absolute value of 'a'.\n    # Using 1.0/3.0 ensures floating-point division.\n    abs_cbrt = abs(a) ** (1.0/3.0)\n    \n    # Round the floating-point cube root to the nearest integer to find the candidate integer root.\n    rounded_root = round(abs_cbrt)\n    \n    # Reapply the original sign to the rounded root, as negative numbers have negative cube roots.\n    potential_root = -rounded_root if a < 0 else rounded_root\n    \n    # Check if the cube of this potential integer root is exactly equal to the original number 'a'.\n    return potential_root ** 3 == a"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n\n    # Helper function to validate input range (1 <= a < 100).\n    def validate_input_range(a_val):\n        return 1 <= a_val < 100\n\n    # Helper function to find all prime factors of a number, including multiplicities.\n    def find_prime_factors(n):\n        factors = []\n        if n <= 1:\n            return factors\n\n        # Factor out 2s\n        while n % 2 == 0:\n            factors.append(2)\n            n //= 2\n\n        # Factor out odd numbers\n        i = 3\n        while i * i <= n:\n            while n % i == 0:\n                factors.append(i)\n                n //= i\n            i += 2\n\n        # If n is still greater than 1, it must be a prime factor itself.\n        if n > 1:\n            factors.append(n)\n        return factors\n\n    # Helper function to count the total number of prime factors.\n    def count_prime_factors(factors_list):\n        return len(factors_list)\n\n    # Main logic of is_multiply_prime function.\n    if not validate_input_range(a):\n        return False\n\n    prime_factors = find_prime_factors(a)\n    num_prime_factors = count_prime_factors(prime_factors)\n\n    return num_prime_factors == 3"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts the number of prime hexadecimal digits in a given string.\n    Prime hexadecimal digits are 2, 3, 5, 7, B (decimal 11), and D (decimal 13).\n    \"\"\"\n    prime_hex_digits = {'2', '3', '5', '7', 'B', 'D'}\n    count = 0\n    for digit in num:\n        if digit in prime_hex_digits:\n            count += 1\n    return count"}
{"task_id": "HumanEval/80", "solution": "def _are_chars_distinct(char1: str, char2: str, char3: str) -> bool:\n    \"\"\"Check if three characters are all different.\"\"\"\n    return char1 != char2 and char1 != char3 and char2 != char3\ndef _check_length(s: str) -> bool:\n    \"\"\"Check if string meets minimum length requirement.\"\"\"\n    return len(s) >= 3\ndef _check_consecutive_distinctness(s: str) -> bool:\n    \"\"\"Analyze all consecutive 3-character substrings for distinctness.\"\"\"\n    for i in range(len(s) - 2):\n        if not _are_chars_distinct(s[i], s[i+1], s[i+2]):\n            return False\n    return True\ndef is_happy(s):\n    \"\"\"You are given a string s.\n    Your task is to check if the string is happy or not.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct\n    For example:\n    is_happy(a) => False\n    is_happy(aa) => False\n    is_happy(abcd) => True\n    is_happy(aabb) => False\n    is_happy(adb) => True\n    is_happy(xyy) => False\n    \"\"\"\n    if not _check_length(s):\n        return False\n    return _check_consecutive_distinctness(s)"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if a number x is a simple power of n, i.e., n**k = x for some integer k.\n    This function assumes x >= 0 and n is an integer, based on examples and O(log x) complexity.\n    \"\"\"\n    # Case 1: x is 1. Any n (including 0, 1, or negative numbers) raised to the power of 0 is 1.\n    if x == 1:\n        return True\n\n    # Case 2: x is not 1, and n is 0.\n    # 0 raised to any positive integer power is 0.\n    # Since x is not 1, if n is 0, x must be 0 for it to be a simple power.\n    if n == 0:\n        return x == 0\n\n    # Case 3: x is not 1, and n is 1.\n    # 1 raised to any integer power is 1. Since x is not 1, it cannot be a simple power of 1.\n    if n == 1:\n        return False\n\n    # Case 4: x is 0.\n    # If x is 0, and n is not 0 or 1 (i.e., n >= 2 or n < 0), then n raised to any integer power can never be 0.\n    if x == 0:\n        return False\n\n    # General case: x > 1 and n > 1.\n    # We repeatedly divide x by n. If x is a power of n, it should eventually become 1\n    # after successive divisions by n, and each division must be exact.\n    # This approach is valid for positive x and n based on the problem's examples and complexity hint.\n    temp_x = x\n    while temp_x > 1:\n        if temp_x % n != 0:\n            return False\n        temp_x //= n\n    return True"}
{"task_id": "HumanEval/82", "solution": "def _calculate_length(string):\n    \"\"\"Calculates the length of the input string.\"\"\"\n    return len(string)\ndef _is_prime(n):\n    \"\"\"Checks if a number is prime using an optimized algorithm.\"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:  # Handles 2 and 3\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    length = _calculate_length(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \n    This function orchestrates input validation, digit sum calculation, and binary conversion.\n    \"\"\"\n    def validate_input(N_val):\n        \"\"\"Validates input constraints and type requirements.\"\"\"\n        # No explicit check or raise exception as per instructions\n        # but the design context implied a check\n        pass\n\n    def calculate_digit_sum(N_val):\n        \"\"\"Calculates sum of individual digits in input number.\"\"\"\n        total_sum = 0\n        s_N = str(N_val)\n        for digit_char in s_N:\n            total_sum += int(digit_char)\n        return total_sum\n\n    def convert_to_binary(value):\n        \"\"\"Converts integer value to binary string representation.\"\"\"\n        return bin(value)[2:] # Remove the '0b' prefix\n\n    # Orchestration based on the design context\n    validate_input(N) # Call validation, though it's a no-op per instructions\n    digit_sum = calculate_digit_sum(N)\n    binary_string = convert_to_binary(digit_sum)\n    return binary_string"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n    \"\"\"\n    total_sum = 0\n    for i in range(len(lst)):\n        # Check if the current index is odd (1, 3, 5, ...)\n        if i % 2 != 0:\n            element = lst[i]\n            # Check if the element at the odd index is even\n            if element % 2 == 0:\n                total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs to a list of letter grades based on a predefined grading scale.\"\"\"\n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append('A+')\n        elif gpa > 3.7:\n            letter_grades.append('A')\n        elif gpa > 3.3:\n            letter_grades.append('A-')\n        elif gpa > 3.0:\n            letter_grades.append('B+')\n        elif gpa > 2.7:\n            letter_grades.append('B')\n        elif gpa > 2.3:\n            letter_grades.append('B-')\n        elif gpa > 2.0:\n            letter_grades.append('C+')\n        elif gpa > 1.7:\n            letter_grades.append('C')\n        elif gpa > 1.3:\n            letter_grades.append('C-')\n        elif gpa > 1.0:\n            letter_grades.append('D+')\n        elif gpa > 0.7:\n            letter_grades.append('D')\n        elif gpa > 0.0:\n            letter_grades.append('D-')\n        else: # gpa must be 0.0\n            letter_grades.append('E')\n    return letter_grades"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    \n    # Calculate numbers starting with 1\n    # For n-digits, numbers are 10...0 to 19...9 (n-1 zeros/nines)\n    # This is 1 * 10^(n-1) numbers.\n    count_starts_with_1 = 10**(n - 1)\n    \n    # Calculate numbers ending with 1\n    # First digit can be 1-9 (9 choices)\n    # Middle n-2 digits can be 0-9 (10 choices each)\n    # Last digit is 1 (1 choice)\n    # Total: 9 * 10^(n-2) numbers.\n    count_ends_with_1 = 9 * (10**(n - 2))\n    \n    # Calculate numbers both starting AND ending with 1\n    # First digit is 1, last digit is 1\n    # Middle n-2 digits can be 0-9 (10 choices each)\n    # Total: 1 * 10^(n-2) numbers.\n    count_both_start_end_1 = 10**(n - 2)\n    \n    # Apply inclusion-exclusion principle: A U B = A + B - (A INTERSECTION B)\n    total_count = count_starts_with_1 + count_ends_with_1 - count_both_start_end_1\n    \n    return total_count"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting.\n    The sorting order depends on the parity of the sum of the first and last elements.\n    \"\"\"\n    if len(array) <= 1:\n        return array.copy()\n\n    sum_condition = array[0] + array[-1]\n\n    if sum_condition % 2 == 1:  # Odd sum: sort in ascending order.\n        return sorted(array)\n    else:  # Even sum: sort in descending order.\n        return sorted(array, reverse=True)"}
{"task_id": "HumanEval/87", "solution": "from typing import List, Tuple\ndef get_row(lst: List[List[int]], x: int) -> List[Tuple[int, int]]:\n    \"\"\"\n    Search for integer x in 2D nested list and return sorted coordinates.\n    Sorts by row ascending, then column descending within rows.\n    \"\"\"\n    coordinates = []\n    for row_idx, row in enumerate(lst):\n        for col_idx, item in enumerate(row):\n            if item == x:\n                coordinates.append((row_idx, col_idx))\n\n    # Sort primarily by row ascending, secondarily by column descending.\n    # Negating col_idx allows sorting in descending order when using an ascending sort key.\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return coordinates"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n    components = s.split(' ')\n    processed_components = [\n        ''.join(sorted(component)) if component else ''\n        for component in components\n    ]\n    return ' '.join(processed_components)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by shifting lowercase letters by 4 positions, wrapping around the alphabet.\"\"\"\n    encrypted_chars = []\n    shift = 4  # The alphabet shifts down by two multiplied to two places (2 * 2 = 4)\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Calculate the new position after shifting and wrapping around\n            shifted_ascii = ((ord(char) - ord('a') + shift) % 26) + ord('a')\n            encrypted_chars.append(chr(shifted_ascii))\n        else:\n            # Non-alphabetic characters remain unchanged\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Returns the 2nd smallest unique element of the list.\n    Returns None if there is no such element (empty list, or fewer than two unique elements).\n    \"\"\"\n    if not lst:\n        return None\n\n    unique_elements = sorted(list(set(lst)))\n\n    if len(unique_elements) < 2:\n        return None\n    else:\n        return unique_elements[1]"}
