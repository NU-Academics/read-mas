{"task_id": "HumanEval/81", "solution": "```python\ndef numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs into a list of corresponding letter grades based on a predefined grading scale.\"\"\"\n\n    def _convert_single_gpa(gpa_val: float) -> str:\n        \"\"\"Converts a single numerical GPA to its corresponding letter grade.\"\"\"\n        if gpa_val == 4.0:\n            return 'A+'\n        elif gpa_val == 0.0:\n            return 'E'\n        elif gpa_val > 3.7:\n            return 'A'\n        elif gpa_val > 3.3:\n            return 'A-'\n        elif gpa_val > 3.0:\n            return 'B+'\n        elif gpa_val > 2.7:\n            return 'B'\n        elif gpa_val > 2.3:\n            return 'B-'\n        elif gpa_val > 2.0:\n            return 'C+'\n        elif gpa_val > 1.7:\n            return 'C'\n        elif gpa_val > 1.3:\n            return 'C-'\n        elif gpa_val > 1.0:\n            return 'D+'\n        elif gpa_val > 0.7:\n            return 'D'\n        elif gpa_val > 0.0:\n            return 'D-'\n        else:\n            return 'E'\n\n    letter_grades = []\n    for gpa in grades:\n        letter_grades.append(_convert_single_gpa(gpa))\n    return letter_grades\n```"}
{"task_id": "HumanEval/91", "solution": "```python\ndef is_bored(S):\n    \"\"\"\n    Counts the number of \"boredom\" sentences in a given text.\n    A boredom is a sentence that starts with the word \"I\".\n    \"\"\"\n    import re\n\n    if not S:\n        return 0\n\n    # Split text into sentences using '.', '?' or '!'.\n    # re.split can produce empty strings if delimiters are at the start/end or consecutive.\n    sentences = re.split(r'[.?!]', S)\n\n    boredom_count = 0\n    for sentence in sentences:\n        cleaned_sentence = sentence.strip()\n        # Check if the cleaned sentence starts with \"I \" or is exactly \"I\", case-insensitively.\n        if cleaned_sentence.lower().startswith(\"i \") or cleaned_sentence.lower() == \"i\":\n            boredom_count += 1\n\n    return boredom_count\n```"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n\n    Examples\n    any_int(5, 2, 7) \u279e True\n\n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n\n    any_int(3.6, -2.2, 2) \u279e False\n\n\n\n    '''\n    # First, check if all three inputs are strictly integers.\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False\n\n    # If they are all integers, check if one number is the sum of the other two.\n    return (x == y + z) or (y == x + z) or (z == x + y)"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Checks if all string keys in a dictionary are uniformly cased (all lowercase or all uppercase).\n    Returns False for an empty dictionary or if any key is not a string.\n    \"\"\"\n    if not dict:\n        return False\n\n    keys = list(dict.keys())\n\n    # First, check if all keys are strings. If not, return False.\n    for key in keys:\n        if not isinstance(key, str):\n            return False\n\n    # If there are no keys, it means the dictionary was empty (handled above) or no string keys,\n    # but at this point all keys must be strings if we passed the loop.\n    # An edge case for an empty dict of only string keys is not possible.\n\n    # Check if all string keys are lowercase\n    all_lower = True\n    for key in keys:\n        if not key.islower():\n            all_lower = False\n            break\n    if all_lower:\n        return True\n\n    # Check if all string keys are uppercase\n    all_upper = True\n    for key in keys:\n        if not key.isupper():\n            all_upper = False\n            break\n    if all_upper:\n        return True\n\n    # If neither all lowercase nor all uppercase, return False\n    return False\n```"}
{"task_id": "HumanEval/96", "solution": "```python\ndef count_up_to(n):\n    \"\"\"Returns a list of prime numbers less than n.\"\"\"\n\n    def _is_prime(num):\n        \"\"\"Checks if a given number is prime.\"\"\"\n        if num < 2:\n            return False\n        i = 2\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 1\n        return True\n\n    if n <= 1:\n        return []\n\n    primes = []\n    for num in range(2, n):\n        if _is_prime(num):\n            primes.append(num)\n    return primes\n```"}
