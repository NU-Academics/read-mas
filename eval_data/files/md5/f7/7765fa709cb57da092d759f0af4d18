{"task_id": "HumanEval/103", "solution": "```python\ndef rounded_avg(n, m):\n    \"\"\"You are given two positive integers n and m, and your task is to compute the\n    average of the integers from n through m (including n and m).\n    Round the answer to the nearest integer and convert that to binary.\n    If n is greater than m, return -1.\n    \"\"\"\n    if n > m:\n        return -1\n\n    # Calculate the count of integers from n to m (inclusive)\n    total_count = m - n + 1\n\n    # Calculate the sum of integers from n to m using the arithmetic series sum formula\n    total_sum = (total_count * (n + m)) // 2\n\n    # Compute the average\n    average = total_sum / total_count\n\n    # Round the average to the nearest integer.\n    # Using int(x + 0.5) to achieve \"round half up\" behavior as per examples.\n    rounded_average = int(average + 0.5)\n\n    # Convert the rounded integer to its binary string representation\n    return bin(rounded_average)\n```"}
{"task_id": "HumanEval/104", "solution": "```python\ndef unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all\n    elements that hasn't any even digit.\n\n    Note: Returned list should be sorted in increasing order.\n\n    For example:\n    >>> unique_digits([15, 33, 1422, 1])\n    [1, 15, 33]\n    >>> unique_digits([152, 323, 1422, 10])\n    []\n    \"\"\"\n\n    class DigitChecker:\n        # Utility class to check if a number contains any even digit.\n        def has_even_digit(self, number: int) -> bool:\n            for digit_char in str(number):\\\n                digit = int(digit_char)\n                if digit % 2 == 0:\n                    return True\n            return False\n\n    class UniqueDigitsFilterService:\n        # Service responsible for filtering numbers and sorting the result.\n        def __init__(self, digit_checker: DigitChecker):\n            self._digit_checker = digit_checker\n\n        def filter_numbers(self, numbers: list[int]) -> list[int]:\n            filtered_list = []\n            for number in numbers:\n                if not self._digit_checker.has_even_digit(number):\n                    filtered_list.append(number)\n\n            filtered_list.sort()\n            return filtered_list\n\n    digit_checker = DigitChecker()\n    filter_service = UniqueDigitsFilterService(digit_checker)\n    return filter_service.filter_numbers(x)\n```"}
{"task_id": "HumanEval/106", "solution": "```python\ndef f(n):\n    \"\"\"\n    Returns a list of size n, where elements are factorials or sums based on index.\n    Index i starts from 1.\n    \"\"\"\n\n    def _factorial(k):\n        \"\"\"Calculates the factorial of k (k >= 1).\"\"\"\n        res = 1\n        for x in range(1, k + 1):\n            res *= x\n        return res\n\n    def _sum_up_to(k):\n        \"\"\"Calculates the sum of numbers from 1 to k (k >= 1).\"\"\"\n        return k * (k + 1) // 2\n\n    if n <= 0:\n        return []\n\n    result = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # Even index\n            result.append(_factorial(i))\n        else:  # Odd index\n            result.append(_sum_up_to(i))\n    return result\n```"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts the number of elements in an array whose sum of signed digits is greater than 0.\n    \"\"\"\n    def _sum_signed_digits(num):\n        # Helper to calculate the sum of signed digits for a single number.\n        # For negative numbers, the first digit carries the negative sign.\n        if num == 0:\n            return 0\n\n        s = str(abs(num))\n        digit_sum = 0\n\n        if num < 0:\n            digit_sum += -int(s[0])\n            for digit_char in s[1:]:\n                digit_sum += int(digit_char)\n        else:\n            for digit_char in s:\n                digit_sum += int(digit_char)\n        return digit_sum\n\n    count = 0\n    for num in arr:\n        if _sum_signed_digits(num) > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    def _is_palindrome(num):\n        \"\"\"Helper method to check if an integer is a palindrome.\"\"\"\n        s_num = str(num)\n        return s_num == s_num[::-1]\n\n    for i in range(1, n + 1):\n        if _is_palindrome(i):\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n    return (even_count, odd_count)"}
