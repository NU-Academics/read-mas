{"task_id": "HumanEval/135", "solution": "```python\ndef can_arrange(arr):\n    \"\"\"Returns the largest index of an element which is not greater than or\n    equal to the element immediately preceding it. Returns -1 if no such element exists.\"\"\"\n    if len(arr) < 2:\n        return -1\n\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i-1]:\n            return i\n    return -1\n```"}
{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n    \"\"\"\n    # First, replace sequences of three or more spaces with a hyphen.\n    # This must be done before replacing single spaces to ensure precedence.\n    transformed_text = re.sub(r' {3,}', '-', text)\n\n    # Then, replace all remaining single spaces with underscores.\n    transformed_text = transformed_text.replace(' ', '_')\n\n    return transformed_text"}
{"task_id": "HumanEval/137", "solution": "```python\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n    \"\"\"\n    from typing import Any\n\n    class InvalidNumberStringError(ValueError):\n        \"\"\"Custom exception for invalid number strings.\"\"\"\n        pass\n\n    class NumberConverter:\n        DECIMAL_SEPARATOR_COMMA = ','\n        DECIMAL_SEPARATOR_DOT = '.'\n\n        @staticmethod\n        def to_float(value: Any) -> float:\n            \"\"\"\n            Converts an input value to a float. Handles int, float, and str.\n            Raises InvalidNumberStringError or TypeError on failure.\n            \"\"\"\n            if isinstance(value, (int, float)):\n                return float(value)\n            elif isinstance(value, str):\n                normalized_string = NumberConverter._normalize_string_number(value)\n                try:\n                    return float(normalized_string)\n                except ValueError as e:\n                    raise InvalidNumberStringError(\n                        f\"Could not convert string '{value}' to a number.\"\n                    ) from e\n            else:\n                raise TypeError(\n                    f\"Unsupported type for conversion: {type(value)}. \"\n                    \"Expected int, float, or str.\"\n                )\n\n        @staticmethod\n        def _normalize_string_number(s: str) -> str:\n            \"\"\"Replaces a comma decimal separator with a dot in a string.\"\"\"\n            return s.replace(NumberConverter.DECIMAL_SEPARATOR_COMMA, NumberConverter.DECIMAL_SEPARATOR_DOT)\n\n    try:\n        a_numeric = NumberConverter.to_float(a)\n        b_numeric = NumberConverter.to_float(b)\n    except (InvalidNumberStringError, TypeError):\n        raise # Re-raise specific errors for client handling as per design\n\n    if a_numeric > b_numeric:\n        return a\n    elif b_numeric > a_numeric:\n        return b\n    else:\n        return None\n```"}
{"task_id": "HumanEval/139", "solution": "import math\n\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n    \"\"\"\n    result = 1\n    # Calculate the product of factorials from 1! up to n!.\n    for i in range(1, n + 1):\n        result *= math.factorial(i)\n    return result"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\n    Calculates the sum of elements in a list after applying index-dependent transformations.\n    If an element's index is a multiple of 3, square it. If index is a multiple of 4 (and not 3), cube it.\n    \"\"\"\n    total_sum = 0\n    for index, value in enumerate(lst):\n        transformed_value = value\n        if index % 3 == 0:\n            transformed_value = value * value\n        elif index % 4 == 0:  # This implicitly means not a multiple of 3 due to the 'elif' condition\n            transformed_value = value * value * value\n        total_sum += transformed_value\n    return total_sum\n```"}
{"task_id": "HumanEval/141", "solution": "```python\nimport string\n\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions\n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from\n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n\n    # Condition 1: Not more than three digits\n    digit_count = sum(1 for char in file_name if char.isdigit())\n    if digit_count > 3:\n        return 'No'\n\n    # Condition 2: Exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split the file name into prefix and suffix\n    parts = file_name.split('.', 1)\n    prefix = parts[0]\n    suffix = parts[1]\n\n    # Condition 3: Substring before the dot\n    # Should not be empty\n    if not prefix:\n        return 'No'\n    # Should start with a letter from the latin alphabet\n    first_char = prefix[0]\n    if not (first_char in string.ascii_letters):\n        return 'No'\n\n    # Condition 4: Substring after the dot\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if suffix not in allowed_extensions:\n        return 'No'\n\n    # All conditions met\n    return 'Yes'\n```"}
{"task_id": "HumanEval/143", "solution": "```python\ndef words_in_sentence(sentence):\n    \"\"\"\n    Returns a string containing words from the original sentence whose lengths are prime numbers,\n    maintaining the original order.\n    \"\"\"\n    def is_prime(n):\n        \"\"\"Checks if a given integer is a prime number.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split()\n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n\n    return \" \".join(filtered_words)\n```"}
{"task_id": "HumanEval/146", "solution": "```python\ndef specialFilter(nums):\n    \"\"\"Counts elements greater than 10 where both first and last digits are odd.\n    Handles negative numbers by considering their absolute value for digit checks.\n    \"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            # Determine the last digit\n            last_digit = abs(num) % 10\n\n            # Determine the first digit\n            abs_val_num = abs(num)\n            if abs_val_num == 0:\n                first_digit = 0\n            else:\n                while abs_val_num >= 10:\n                    abs_val_num //= 10\n                first_digit = abs_val_num\n\n            # Check if both first and last digits are odd\n            if (first_digit % 2 != 0) and (last_digit % 2 != 0):\n                count += 1\n    return count\n```"}
{"task_id": "HumanEval/145", "solution": "```python\ndef order_by_points(nums):\n    \"\"\"\n    Write a function which sorts the given list of integers\n    in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their index in original list.\n\n    For example:\n    >>> order_by_points([1, 11, -1, -11, -12]) == [-1, -11, 1, -12, 11]\n    >>> order_by_points([]) == []\n    \"\"\"\n    if not nums:\n        return []\n\n    # Helper function to calculate the sum of the absolute value of digits for an integer.\n    def _calculate_digit_sum(num):\n        s = 0\n        for digit_char in str(abs(num)):\n            s += int(digit_char)\n        return s\n\n    # Create a list of tuples: (sum_of_digits, original_index, number).\n    # Python's sorted() will use these tuple elements for comparison in order.\n    decorated_list = []\n    for i, num in enumerate(nums):\n        digit_sum = _calculate_digit_sum(num)\n        decorated_list.append((digit_sum, i, num))\n\n    # Sort the decorated list.\n    # Python's default tuple sorting handles the primary key (sum_of_digits)\n    # and secondary key (original_index) automatically.\n    decorated_list.sort()\n\n    # Extract the original numbers from the sorted list of tuples.\n    sorted_nums = [item[2] for item in decorated_list]\n    return sorted_nums\n```"}
{"task_id": "HumanEval/149", "solution": "```python\ndef sorted_list_sum(lst):\n    \"\"\"Filters a list of strings by even length, then sorts by length and alphabetically.\"\"\"\n    filtered_list = [s for s in lst if len(s) % 2 == 0]\n    sorted_list = sorted(filtered_list, key=lambda s: (len(s), s))\n    return sorted_list\n```"}
{"task_id": "HumanEval/144", "solution": "```python\nclass Fraction:\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        return self.numerator % self.denominator == 0\n\n    def __repr__(self) -> str:\n        return f\"Fraction({self.numerator}/{self.denominator})\"\n\nclass FractionParser:\n    def parse_fraction(self, fraction_str: str) -> Fraction:\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return Fraction(numerator, denominator)\n\nclass FractionSimplifierService:\n    def __init__(self, parser: 'FractionParser'):\n        self.parser = parser\n\n    def simplify(self, x: str, n: str) -> bool:\n        fraction_x = self.parser.parse_fraction(x)\n        fraction_n = self.parser.parse_fraction(n)\n\n        product_fraction = fraction_x.multiply(fraction_n)\n\n        return product_fraction.is_whole_number()\n\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n    \"\"\"\n    parser = FractionParser()\n    service = FractionSimplifierService(parser=parser)\n    return service.simplify(x, n)\n```"}
{"task_id": "HumanEval/148", "solution": "```python\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun\n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn,\n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2.\n    The function should return a tuple containing all planets whose orbits are\n    located between the orbit of planet1 and the orbit of planet2, sorted by\n    the proximity to the sun.\n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names.\n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    PLANET_ORDER = (\n        \"Mercury\",\n        \"Venus\",\n        \"Earth\",\n        \"Mars\",\n        \"Jupiter\",\n        \"Saturn\",\n        \"Uranus\",\n        \"Neptune\",\n    )\n\n    try:\n        idx1 = PLANET_ORDER.index(planet1)\n    except ValueError:\n        return ()\n\n    try:\n        idx2 = PLANET_ORDER.index(planet2)\n    except ValueError:\n        return ()\n\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    return tuple(PLANET_ORDER[start_idx + 1 : end_idx])\n```"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"Counts triples (a[i], a[j], a[k]) from a generated array where i < j < k and a[i] + a[j] + a[k] is a multiple of 3.\"\"\"\n\n    a = []\n    for i in range(1, n + 1):\n        a.append(i * i - i + 1)\n\n    if n < 3:\n        return 0\n\n    def _combinations(m, k_val):\n        if k_val < 0 or k_val > m:\n            return 0\n        if k_val == 0 or k_val == m:\n            return 1\n        if k_val > m // 2:\n            k_val = m - k_val\n\n        res = 1\n        for j in range(k_val):\n            res = res * (m - j) // (j + 1)\n        return res\n\n    rem0_count = 0\n    rem1_count = 0\n    rem2_count = 0\n\n    for x in a:\n        remainder = x % 3\n        if remainder == 0:\n            rem0_count += 1\n        elif remainder == 1:\n            rem1_count += 1\n        else:\n            rem2_count += 1\n\n    total_triples = 0\n\n    total_triples += _combinations(rem0_count, 3)\n    total_triples += _combinations(rem1_count, 3)\n    total_triples += _combinations(rem2_count, 3)\n    total_triples += rem0_count * rem1_count * rem2_count\n\n    return total_triples"}
{"task_id": "HumanEval/151", "solution": "```python\ndef double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n\n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0\n\n    If the input list is empty, return 0.\n    '''\n    total_sum_of_squares = 0\n    for num in lst:\n        # Check if the number is an integer, positive, and odd.\n        if isinstance(num, int) and num > 0 and num % 2 != 0:\n            total_sum_of_squares += num * num\n    return total_sum_of_squares\n```"}
{"task_id": "HumanEval/152", "solution": "```python\ndef compare(game,guess):\n    \"\"\"Calculates the absolute difference between game scores and guesses for each match.\n    Returns a list of these differences, where 0 indicates a correct guess.\"\"\"\n    differences = []\n    for i in range(len(game)):\n        diff = abs(game[i] - guess[i])\n        differences.append(diff)\n    return differences\n```"}
{"task_id": "HumanEval/150", "solution": "```python\nimport math\n\ndef x_or_y(n, x, y):\n    \"\"\"\n    Returns x if n is a prime number, otherwise returns y.\n    It includes an inline primality test for n.\n    \"\"\"\n    is_n_prime = False\n    if n < 2:\n        is_n_prime = False\n    elif n == 2:\n        is_n_prime = True\n    elif n % 2 == 0:\n        is_n_prime = False\n    else:\n        is_n_prime = True\n        # Check for factors from 3 up to sqrt(n)\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                is_n_prime = False\n                break\n\n    if is_n_prime:\n        return x\n    else:\n        return y\n```"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    num_str = str(abs(num))\n\n    for char_digit in num_str:\n        digit = int(char_digit)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Calculates the strength of each extension and finds the strongest one.\n    The strength is defined as (number of uppercase letters) - (number of lowercase letters).\n    \"\"\"\n\n    def _calculate_strength(extension_name: str) -> int:\n        \"\"\"Calculates the strength of a single extension string.\"\"\"\n        uppercase_count = sum(1 for char in extension_name if char.isupper())\n        lowercase_count = sum(1 for char in extension_name if char.islower())\n        return uppercase_count - lowercase_count\n\n    def _find_strongest(extensions_list: list[str]) -> str:\n        \"\"\"Finds the strongest extension from a list, using tie-breaking for first occurrence.\"\"\"\n        # The problem context implies extensions_list will not be empty.\n        strongest_extension_name = extensions_list[0]\n        max_strength = _calculate_strength(extensions_list[0])\n\n        for i in range(1, len(extensions_list)):\n            extension = extensions_list[i]\n            current_strength = _calculate_strength(extension)\n            if current_strength > max_strength:\n                max_strength = current_strength\n                strongest_extension_name = extension\n        return strongest_extension_name\n\n    strongest_ext = _find_strongest(extensions)\n    return f\"{class_name}.{strongest_ext}\""}
{"task_id": "HumanEval/154", "solution": "```python\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n\n    def _generate_rotations(s: str) -> list[str]:\n        \"\"\"Generates all unique cyclic rotations of a string.\"\"\"\n        if not s:\n            return [\"\"]\n\n        rotations = set()\n        n = len(s)\n        for i in range(n):\n            rotated_s = s[i:] + s[:i]\n            rotations.add(rotated_s)\n        return list(rotations)\n\n    if not b:\n        return True\n\n    if len(b) > len(a):\n        return False\n\n    rotations_of_b = _generate_rotations(b)\n\n    for rotation in rotations_of_b:\n        if rotation in a:\n            return True\n\n    return False\n```\n"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    roman_map = [\n        (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n        (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n        (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'),\n        (1, 'i')\n    ]\n\n    result = []\n    for value, symbol in roman_map:\n        while number >= value:\n            result.append(symbol)\n            number -= value\n\n    return \"\".join(result)"}
{"task_id": "HumanEval/159", "solution": "```python\ndef eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and remaining carrots after a rabbit's meal.\n    \"\"\"\n    carrots_eaten_from_stock = min(need, remaining)\n    total_eaten_carrots = number + carrots_eaten_from_stock\n    carrots_left = remaining - carrots_eaten_from_stock\n\n    return [total_eaten_carrots, carrots_left]\n```"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Use a small epsilon for floating-point comparisons to account for precision errors.\n    EPSILON = 1e-9\n\n    # Sort the sides to easily identify the potential hypotenuse (the longest side).\n    sides = sorted([a, b, c])\n\n    # Apply the Pythagorean theorem: a^2 + b^2 = c^2, where c is the hypotenuse.\n    side1_sq = sides[0] ** 2\n    side2_sq = sides[1] ** 2\n    hypotenuse_sq = sides[2] ** 2\n\n    # Check if the sum of squares of the two shorter sides is approximately equal\n    # to the square of the longest side.\n    return abs(side1_sq + side2_sq - hypotenuse_sq) < EPSILON"}
{"task_id": "HumanEval/158", "solution": "```python\ndef find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: lexicographical order\n            if word < result_word:\n                result_word = word\n\n    return result_word\n```"}
{"task_id": "HumanEval/161", "solution": "```python\ndef solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa,\n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    \"\"\"\n\n    # Check if the string contains any letters\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    # If no letters are found, reverse the entire string\n    if not has_letters:\n        return s[::-1]\n\n    # Otherwise, process character by character\n    result_chars = []\n    for char in s:\n        if char.isalpha():\n            if char.islower():\n                result_chars.append(char.upper())\n            else: # char is an uppercase letter\n                result_chars.append(char.lower())\n        else: # char is not a letter\n            result_chars.append(char)\n\n    return \"\".join(result_chars)\n```"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    even_digits_in_range = []\n    # According to examples, \"even digits\" refers to 0, 2, 4, 6, 8.\n    # Since a and b are positive, 0 will never be in the range [min_val, max_val].\n    possible_even_digits = [2, 4, 6, 8]\n\n    for digit in possible_even_digits:\n        if min_val <= digit <= max_val:\n            even_digits_in_range.append(digit)\n\n    return even_digits_in_range"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Constructs an algebraic expression from given operators and operands, then evaluates it.\n    The expression follows standard mathematical operator precedence.\n    \"\"\"\n    expression_parts = []\n    for i in range(len(operand)):\n        expression_parts.append(str(operand[i]))\n        if i < len(operator):\n            expression_parts.append(operator[i])\n\n    expression_string = \" \".join(expression_parts)\n\n    result = eval(expression_string)\n\n    return int(result)"}
{"task_id": "HumanEval/162", "solution": "import hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n\n    >>> string_to_md5('Hello world') == '3e25960a79dbc69b674cd4ec67a72c62'\n    \"\"\"\n    if not text:\n        return None\n    md5_hash = hashlib.md5(text.encode('utf-8'))\n    return md5_hash.hexdigest()"}
