{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n == 1 or n == 2:\n        return 1\n    else:\n        a, b = 1, 1\n        for _ in range(3, n + 1):\n            a, b = b, a + b\n        return b"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    n = len(l)\n    if n <= 1:\n        return True\n\n    # Check if the list is strictly increasing.\n    is_strictly_increasing = True\n    for i in range(1, n):\n        if l[i] <= l[i-1]:\n            is_strictly_increasing = False\n            break\n\n    # Check if the list is strictly decreasing.\n    is_strictly_decreasing = True\n    for i in range(1, n):\n        if l[i] >= l[i-1]:\n            is_strictly_decreasing = False\n            break\n\n    return is_strictly_increasing or is_strictly_decreasing"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_elements = list(set1.intersection(set2))\n    common_elements.sort()\n    return common_elements"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        \n        # If balance drops below zero, a closing bracket appeared without a corresponding opening one.\n        if balance < 0:\n            return False\n            \n    # If balance is zero at the end, all brackets are matched.\n    return balance == 0"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n    current_n = n\n\n    # Handle factor 2\n    while current_n % 2 == 0:\n        largest_factor = 2\n        current_n //= 2\n\n    # Handle odd factors\n    i = 3\n    while i * i <= current_n:\n        while current_n % i == 0:\n            largest_factor = i\n            current_n //= i\n        i += 2\n\n    # If current_n is still greater than 1, it must be the largest prime factor\n    if current_n > 1:\n        largest_factor = current_n\n\n    return largest_factor"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\"Computes the derivative of a polynomial represented by its coefficients.\n    Returns an empty list `[]` for constant polynomials.\"\"\"\n    if not xs or len(xs) == 1:\n        return []\n\n    derived_coefficients = []\n    for i in range(1, len(xs)):\n        derived_coefficients.append(xs[i] * i)\n\n    return derived_coefficients"}
{"task_id": "HumanEval/63", "solution": "_memo = {}\n\ndef fibfib(n: int):\n    \"\"\"Computes the n-th FibFib number efficiently using memoization.\"\"\"\n    if n in _memo:\n        return _memo[n]\n\n    if n == 0:\n        result = 0\n    elif n == 1:\n        result = 0\n    elif n == 2:\n        result = 1\n    else:\n        result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n    \n    _memo[n] = result\n    return result"}
{"task_id": "HumanEval/47", "solution": "import math\n\ndef median(l: list):\n    \"\"\"Return median of elements in the list l.\"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n    \n    if n % 2 == 1:\n        # Odd number of elements, return the middle one\n        return sorted_l[n // 2]\n    else:\n        # Even number of elements, return the average of the two middle ones\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts the number of vowels in a string, including 'y' only if it's the last character.\n    Vowels are 'a', 'e', 'i', 'o', 'u' (case-insensitive).\n    \"\"\"\n    count = 0\n    s_lower = s.lower()\n    standard_vowels = \"aeiou\"\n\n    for i, char in enumerate(s_lower):\n        if char in standard_vowels:\n            count += 1\n        elif char == 'y' and i == len(s_lower) - 1:\n            count += 1\n            \n    return count"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII codes of uppercase characters in a string.\n\n    Iterates through the string, adds the ASCII value of each uppercase character to a running sum.\"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/65", "solution": "def _convert_to_digits_string(x):\n    \"\"\"Converts an integer to its string representation of digits.\"\"\"\n    return str(x)\n\ndef _reverse_digits(digits_str):\n    \"\"\"Reverses a string of digits.\"\"\"\n    return digits_str[::-1]\n\ndef _perform_circular_shift(digits_str, shift_amount):\n    \"\"\"Performs a circular right shift on a string of digits.\"\"\"\n    num_digits = len(digits_str)\n    effective_shift = shift_amount % num_digits\n    if effective_shift == 0:\n        return digits_str\n    return digits_str[num_digits - effective_shift:] + digits_str[:num_digits - effective_shift]\n\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    digits_str = _convert_to_digits_string(x)\n    num_digits = len(digits_str)\n\n    if shift > num_digits:\n        return _reverse_digits(digits_str)\n    else:\n        return _perform_circular_shift(digits_str, shift)"}
{"task_id": "HumanEval/69", "solution": "import collections\n\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    frequency_map = collections.Counter(lst)\n    valid_integers = []\n\n    for num, freq in frequency_map.items():\n        if freq >= num:\n            valid_integers.append(num)\n\n    if not valid_integers:\n        return -1\n    else:\n        return max(valid_integers)"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even non-negative integer and its smallest index in the input array.\n    Returns [value, index] or [] if no even values are found or the array is empty.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            elif value == smallest_even_value and i < smallest_even_index:\n                # If values are equal, prioritize the one with the smallest index\n                smallest_even_index = i\n    \n    if smallest_even_index != -1: # An even value was found\n        return [smallest_even_value, smallest_even_index]\n    else: # No even values were found\n        return []"}
{"task_id": "HumanEval/67", "solution": "import re\n\ndef parse_fruit_string(s: str) -> tuple[int, int]:\n    \"\"\"\n    Parses a string like 'X apples and Y oranges' to extract apple and orange counts.\n    \"\"\"\n    match = re.match(r\"^(\\d+) apples and (\\d+) oranges$\", s)\n    # The design context implies that invalid formats raise ValueError,\n    # but the completion instructions say \"Do NOT add isinstance() checks or raise exceptions for edge cases\".\n    # Given the examples and the prompt's constraints, it's safer to assume valid input format\n    # and not explicitly raise exceptions here, as the problem statement only shows valid inputs.\n    # If match is None due to invalid input, subsequent int() calls on None.group(x) would error naturally.\n    apples = int(match.group(1))\n    oranges = int(match.group(2))\n    return apples, oranges\n\ndef calculate_mango_count(total_fruits: int, apple_count: int, orange_count: int) -> int:\n    \"\"\"\n    Calculates the number of mango fruits.\n    \"\"\"\n    sum_apples_oranges = apple_count + orange_count\n    # Similar to parsing, the design specifies raising ValueError for total_fruits < sum_apples_oranges,\n    # but the completion instructions prohibit raising exceptions for edge cases.\n    # We will simply perform the calculation as described.\n    return total_fruits - sum_apples_oranges\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given a string of apples and oranges\n    and the total number of fruits.\n    \"\"\"\n    apple_count, orange_count = parse_fruit_string(s)\n    mango_count = calculate_mango_count(n, apple_count, orange_count)\n    return mango_count"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n\n    Examples:\n    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]\n    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]\n    strange_sort_list([]) == []\n    '''\n    working_list = list(lst)  # Create a copy to avoid modifying the original list\n    result_list = []\n    is_min_turn = True\n\n    while working_list:\n        if is_min_turn:\n            # Find and remove the minimum element\n            min_element = min(working_list)\n            working_list.remove(min_element)\n            result_list.append(min_element)\n        else:\n            # Find and remove the maximum element\n            max_element = max(working_list)\n            working_list.remove(max_element)\n            result_list.append(max_element)\n        \n        is_min_turn = not is_min_turn  # Toggle for the next turn\n\n    return result_list"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    def _is_valid_triangle(a_side, b_side, c_side):\n        # Check if all sides are positive and satisfy the triangle inequality theorem.\n        if a_side <= 0 or b_side <= 0 or c_side <= 0:\n            return False\n        if not (a_side + b_side > c_side and a_side + c_side > b_side and b_side + c_side > a_side):\n            return False\n        return True\n\n    def _calculate_herons_area(a_side, b_side, c_side):\n        # Calculate the area using Heron's formula.\n        s = (a_side + b_side + c_side) / 2\n        area_squared = s * (s - a_side) * (s - b_side) * (s - c_side)\n        return math.sqrt(area_squared)\n\n    if not _is_valid_triangle(a, b, c):\n        return -1\n    \n    area = _calculate_herons_area(a, b, c)\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n    '''\n    def is_palindrome(q: list) -> bool:\n        \"\"\"Returns True if the list q reads the same forwards and backwards, False otherwise.\"\"\"\n        return q == q[::-1]\n\n    def calculate_sum(q: list) -> int:\n        \"\"\"Returns the sum of all integer elements in the list q.\"\"\"\n        return sum(q)\n\n    is_balanced = is_palindrome(q)\n    total_weight = calculate_sum(q)\n\n    return is_balanced and (total_weight <= w)"}
{"task_id": "HumanEval/74", "solution": "from typing import List\n\ndef total_match(lst1: List[str], lst2: List[str]) -> List[str]:\n    \"\"\"\n    Calculates the total number of characters in each list of strings\n    and returns the list with the smaller total count.\n    If counts are equal, the first list is returned.\n    \"\"\"\n    char_count1 = sum(len(s) for s in lst1)\n    char_count2 = sum(len(s) for s in lst2)\n\n    if char_count1 <= char_count2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Checks if an integer `a` is a perfect cube.\n    Calculates the cube root, rounds it to the nearest integer, and then cubes it to check equality.\n    '''\n    # Calculate the cube root and round it to the nearest integer\n    # Python's ** operator handles negative bases for odd fractional exponents correctly.\n    root = round(a**(1/3))\n    \n    # Check if the cube of the rounded root equals the original number\n    return int(root)**3 == a"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic. A palindromic array is an array that\n    is read the same backwards and forwards. In one change, you can change one element to any other element.\n    \"\"\"\n    changes_count = 0\n    left_ptr = 0\n    right_ptr = len(arr) - 1\n\n    while left_ptr < right_ptr:\n        if arr[left_ptr] != arr[right_ptr]:\n            changes_count += 1\n        left_ptr += 1\n        right_ptr -= 1\n\n    return changes_count"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a given number is prime.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    def get_prime_factors(n):\n        \"\"\"Returns a list of prime factors for a given number, including multiplicity.\"\"\"\n        factors = []\n        if n <= 1:\n            return factors\n\n        temp_n = n\n        d = 2\n        # Iterate through potential divisors, checking primality as per design.\n        while d * d <= temp_n:\n            if is_prime(d):\n                while temp_n % d == 0:\n                    factors.append(d)\n                    temp_n //= d\n            d += 1\n        \n        # If temp_n is still greater than 1, it must be the last prime factor.\n        if temp_n > 1:\n            factors.append(temp_n)\n        return factors\n\n    # The smallest product of three primes is 2 * 2 * 2 = 8.\n    if a < 8:\n        return False\n    \n    prime_factors = get_prime_factors(a)\n    \n    # Check if the number of prime factors is exactly 3.\n    return len(prime_factors) == 3"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts the number of prime hexadecimal digits in a given hexadecimal string.\n    The prime hexadecimal digits are '2', '3', '5', '7', 'B', 'D'.\n    \"\"\"\n    prime_hex_digits = {'2', '3', '5', '7', 'B', 'D'}\n    count = 0\n    for char in num:\n        if char in prime_hex_digits:\n            count += 1\n    return count"}
{"task_id": "HumanEval/80", "solution": "def _check_distinct_three(sub):\n    \"\"\"Checks if the three characters in a 3-character string are distinct.\"\"\"\n    return len(set(sub)) == 3\n\ndef is_happy(s):\n    \"\"\"You are given a string s.\n    Your task is to check if the string is happy or not.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct\n    For example:\n    is_happy(a) => False\n    is_happy(aa) => False\n    is_happy(abcd) => True\n    is_happy(aabb) => False\n    is_happy(adb) => True\n    is_happy(xyy) => False\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        substring = s[i:i+3]\n        if not _check_distinct_three(substring):\n            return False\n\n    return True"}
{"task_id": "HumanEval/82", "solution": "def _is_prime(n: int) -> bool:\n    \"\"\"Helper function to determine if a number is prime.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef prime_length(string: str) -> bool:\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/76", "solution": "import math\n\ndef is_simple_power(x, n):\n    \"\"\"Your task is to write a function that returns true if a number x is a simple\n    power of n and false in other cases.\n    x is a simple power of n if n**int=x\n    For example:\n    is_simple_power(1, 4) => true\n    is_simple_power(2, 2) => true\n    is_simple_power(8, 2) => true\n    is_simple_power(3, 2) => false\n    is_simple_power(3, 1) => false\n    is_simple_power(5, 3) => false\n    \"\"\"\n    EPSILON = 1e-9 # Tolerance for floating point comparisons.\n\n    # Case 1: x == 1\n    # n**0 = 1 for any n (including n=0) is a common mathematical definition.\n    if math.isclose(x, 1.0, rel_tol=EPSILON, abs_tol=EPSILON):\n        return True\n\n    # Case 2: x == 0\n    # From the design context, if x is 0, it's always false (e.g., 0**k = 0 for k > 0, but design says False).\n    if math.isclose(x, 0.0, rel_tol=EPSILON, abs_tol=EPSILON):\n        return False\n\n    # Case 3: n == 1\n    # 1 raised to any non-negative integer power is 1. Since x is not 1, it cannot be a power of 1.\n    if math.isclose(n, 1.0, rel_tol=EPSILON, abs_tol=EPSILON):\n        return False\n\n    # Case 4: n == 0\n    # 0 raised to k > 0 is 0. 0 raised to k=0 is 1. Since x is not 0 or 1, it cannot be a power of 0.\n    if math.isclose(n, 0.0, rel_tol=EPSILON, abs_tol=EPSILON):\n        return False\n\n    # From this point, x is not 0 or 1, and n is not 0 or 1.\n\n    # Handle cases where x is negative\n    if x < 0:\n        if n > 0: # A positive base 'n' raised to a non-negative integer power cannot be negative.\n            return False\n        # If n < 0 and x < 0: Check if abs(x) is a power of abs(n) where k is an odd non-negative integer.\n        base = abs(n)\n        val = abs(x)\n        try:\n            k_float = math.log(val, base)\n        except ValueError: # log(val, base) requires val > 0 and base > 0, base != 1 (handled above).\n            return False\n\n        k_rounded = round(k_float)\n        # Check if k_float is close to an integer, non-negative, and odd.\n        if (math.isclose(k_float, k_rounded, rel_tol=EPSILON, abs_tol=EPSILON) and\n                k_rounded >= 0 and k_rounded % 2 != 0):\n            return math.isclose(n**k_rounded, x, rel_tol=EPSILON, abs_tol=EPSILON)\n        return False\n\n    # Handle cases where x is positive (x > 1 since x=1 handled)\n    # If x > 0 and n < 0: Check if x is a power of abs(n) where k is an even non-negative integer.\n    if n < 0:\n        base = abs(n)\n        val = x # x is positive here\n        try:\n            k_float = math.log(val, base)\n        except ValueError:\n            return False\n\n        k_rounded = round(k_float)\n        # Check if k_float is close to an integer, non-negative, and even.\n        if (math.isclose(k_float, k_rounded, rel_tol=EPSILON, abs_tol=EPSILON) and\n                k_rounded >= 0 and k_rounded % 2 == 0):\n            return math.isclose(n**k_rounded, x, rel_tol=EPSILON, abs_tol=EPSILON)\n        return False\n\n    # Final case: x > 1 and n > 1 (both positive, n not 0 or 1)\n    # Use logarithmic approach for robustness with float inputs.\n    try:\n        k_float = math.log(x, n) # k = log_n(x)\n    except ValueError:\n        return False\n\n    # Check if k_float is a non-negative integer (within tolerance).\n    k_rounded = round(k_float)\n    if k_rounded < 0: # Power must be non-negative.\n        return False\n\n    if math.isclose(k_float, k_rounded, rel_tol=EPSILON, abs_tol=EPSILON):\n        # Double check with actual power to mitigate floating point inaccuracies.\n        return math.isclose(n**k_rounded, x, rel_tol=EPSILON, abs_tol=EPSILON)\n    return False"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a decimal number to a binary string, prefixed and suffixed with 'db'.\n    Uses built-in `bin()` to get the binary representation and formats it accordingly.\n    \"\"\"\n    binary_representation = bin(decimal)[2:]  # Convert to binary and remove \"0b\" prefix\n    return \"db\" + binary_representation + \"db\""}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write \n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A \n            > 3.3                A- \n            > 3.0                B+\n            > 2.7                B \n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+ \n            > 0.7                D \n            > 0.0                D-\n              0.0                E\n    \n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    def _convert_single_gpa(gpa):\n        \"\"\"Converts a single GPA to its corresponding letter grade.\"\"\"\n        if gpa == 4.0:\n            return 'A+'\n        elif gpa > 3.7:\n            return 'A'\n        elif gpa > 3.3:\n            return 'A-'\n        elif gpa > 3.0:\n            return 'B+'\n        elif gpa > 2.7:\n            return 'B'\n        elif gpa > 2.3:\n            return 'B-'\n        elif gpa > 2.0:\n            return 'C+'\n        elif gpa > 1.7:\n            return 'C'\n        elif gpa > 1.3:\n            return 'C-'\n        elif gpa > 1.0:\n            return 'D+'\n        elif gpa > 0.7:\n            return 'D'\n        elif gpa > 0.0:\n            return 'D-'\n        elif gpa == 0.0:\n            return 'E'\n        else: # Handle negative GPAs or other unexpected values if any, though not specified\n            return 'E' # Default to E for anything below 0.0 as well\n\n    letter_grades = []\n    for gpa_value in grades:\n        letter_grades.append(_convert_single_gpa(gpa_value))\n    return letter_grades"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    # Validate n: it must be a positive integer.\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"Input n must be a positive integer (n >= 1).\")\n\n    if n == 1:\n        # For n=1, the only 1-digit positive integer is '1', which starts and ends with 1.\n        return 1\n    else:\n        # Calculate the count of n-digit numbers that start with 1.\n        # The first digit is 1, and the remaining n-1 digits can be any of 0-9.\n        count_starts_with_one = 10**(n - 1)\n\n        # Calculate the count of n-digit numbers that end with 1.\n        # The last digit is 1. The first digit cannot be 0 (9 choices: 1-9),\n        # and the middle n-2 digits can be any of 0-9.\n        count_ends_with_one = 9 * (10**(n - 2))\n\n        # Calculate the count of n-digit numbers that both start and end with 1.\n        # The first digit is 1, the last digit is 1, and the middle n-2 digits can be any of 0-9.\n        count_starts_and_ends_with_one = 10**(n - 2)\n\n        # Apply the Principle of Inclusion-Exclusion.\n        total_count = count_starts_with_one + count_ends_with_one - count_starts_and_ends_with_one\n        return total_count"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n    \n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n\n    def _calculate_sum_of_decimal_digits(number: int) -> int:\n        \"\"\"Calculates the sum of the individual decimal digits of a given integer.\"\"\"\n        s = 0\n        num_str = str(number)\n        for digit_char in num_str:\n            s += int(digit_char)\n        return s\n\n    def _convert_decimal_to_binary_string(decimal_value: int) -> str:\n        \"\"\"Converts a decimal integer into its binary string representation.\"\"\"\n        return bin(decimal_value)[2:]\n\n    sum_of_digits = _calculate_sum_of_decimal_digits(N)\n    binary_sum_string = _convert_decimal_to_binary_string(sum_of_digits)\n    \n    return binary_sum_string"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n\n    Examples:\n        add([4, 2, 6, 7]) ==> 2 \n    \"\"\"\n    total_sum = 0\n    for index, element in enumerate(lst):\n        # Check if the index is odd (1, 3, 5, ...)\n        if index % 2 != 0:\n            # Check if the element at the odd index is even\n            if element % 2 == 0:\n                total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/86", "solution": "import re\nfrom abc import ABC, abstractmethod\nfrom typing import List\n\nclass StringPart(ABC):\n    \"\"\"Abstract base class for segments of the input string.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    @abstractmethod\n    def get_processed_value(self) -> str:\n        \"\"\"Returns the processed string representation of the part.\"\"\"\n        pass\n\nclass Word(StringPart):\n    \"\"\"Represents a word segment with character sorting logic.\"\"\"\n    def __init__(self, value: str):\n        super().__init__(value)\n\n    def get_processed_value(self) -> str:\n        \"\"\"Sorts the characters of the word in ascending ASCII order.\"\"\"\n        return ''.join(sorted(self._value))\n\nclass Space(StringPart):\n    \"\"\"Represents a space segment, preserving its exact value.\"\"\"\n    def __init__(self, value: str):\n        super().__init__(value)\n\n    def get_processed_value(self) -> str:\n        \"\"\"Returns the original value of the space.\"\"\"\n        return self._value\n\nclass InputString:\n    \"\"\"Encapsulates the raw input string and provides tokenization.\"\"\"\n    def __init__(self, s: str):\n        self._content = s\n\n    def split_into_parts(self) -> List[StringPart]:\n        \"\"\"Splits the content into a list of Word and Space objects.\"\"\"\n        parts: List[StringPart] = []\n        tokens = re.findall(r'(\\S+|\\s+)', self._content)\n\n        for token in tokens:\n            if token.isspace():\n                parts.append(Space(token))\n            else:\n                parts.append(Word(token))\n        return parts\n\nclass OutputString:\n    \"\"\"Collects processed StringPart objects and reconstructs the final string.\"\"\"\n    def __init__(self):\n        self._parts: List[StringPart] = []\n\n    def add_part(self, part: StringPart):\n        \"\"\"Adds a processed StringPart to the internal list.\"\"\"\n        self._parts.append(part)\n\n    def build_from_parts(self) -> str:\n        \"\"\"Concatenates the processed values of all stored StringPart objects.\"\"\"\n        return ''.join(part.get_processed_value() for part in self._parts)\n\ndef anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n    \"\"\"\n    input_obj = InputString(s)\n    string_parts = input_obj.split_into_parts()\n\n    output_obj = OutputString()\n    for part in string_parts:\n        output_obj.add_part(part)\n\n    return output_obj.build_from_parts()"}
{"task_id": "HumanEval/88", "solution": "from enum import Enum\n\nclass SortingOrder(Enum):\n    \"\"\"Enumeration to define sorting directions.\"\"\"\n    ASCENDING = 1\n    DESCENDING = 2\n\ndef _determine_sorting_order(array):\n    \"\"\"Determines if the array should be sorted ascending or descending based on the sum of its first and last elements.\"\"\"\n    first_val = array[0]\n    last_val = array[-1]\n    if (first_val + last_val) % 2 == 0:\n        return SortingOrder.DESCENDING\n    else:\n        return SortingOrder.ASCENDING\n\ndef _sort_ascending(array):\n    \"\"\"Sorts a copy of the given array in ascending order.\"\"\"\n    return sorted(array)\n\ndef _sort_descending(array):\n    \"\"\"Sorts a copy of the given array in descending order.\"\"\"\n    return sorted(array, reverse=True)\n\ndef sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    if not array:\n        return []\n    if len(array) == 1:\n        return array[:]\n\n    sorting_order = _determine_sorting_order(array)\n\n    if sorting_order == SortingOrder.ASCENDING:\n        return _sort_ascending(array)\n    else: # SortingOrder.DESCENDING\n        return _sort_descending(array)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating lowercase English letters by four places, wrapping around the alphabet.\"\"\"\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Calculate the new position (0-25) after shifting by 4, with wrap-around\n            shifted_position = (ord(char) - ord('a') + 4) % 26\n            # Convert the new position back to a character\n            encrypted_chars.append(chr(shifted_position + ord('a')))\n        else:\n            # Non-lowercase letters are kept unchanged\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    '''\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False\n\n    return (x == y + z) or (y == x + z) or (z == x + y)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Returns the 2nd smallest unique element of the list, or None if not available.\n    \"\"\"\n    if not lst:\n        return None\n\n    unique_elements = sorted(list(set(lst)))\n\n    if len(unique_elements) < 2:\n        return None\n    else:\n        return unique_elements[1]"}
{"task_id": "HumanEval/87", "solution": "from typing import List, Tuple\n\nclass Coordinate:\n    \"\"\"\n    Represents a zero-indexed (row, column) pair and provides comparison logic for sorting.\n    \"\"\"\n    def __init__(self, row: int, col: int):\n        self._row = row\n        self._col = col\n\n    @property\n    def row_index(self) -> int:\n        return self._row\n\n    @property\n    def column_index(self) -> int:\n        return self._col\n\n    def to_tuple(self) -> Tuple[int, int]:\n        \"\"\"Converts the Coordinate object into a standard Python (int, int) tuple.\"\"\"\n        return (self._row, self._col)\n\n    def __lt__(self, other: 'Coordinate') -> bool:\n        \"\"\"\n        Compares two Coordinate objects for sorting by row ascending, then column descending.\n        \"\"\"\n        if self._row < other._row:\n            return True\n        if self._row == other._row:\n            return self._col > other._col\n        return False\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"\n        Checks if two Coordinate objects are equal.\n        \"\"\"\n        return self._row == other._row and self._col == other._col\n\ndef get_row(lst: List[List[int]], x: int) -> List[Tuple[int, int]]:\n    \"\"\"\n    Finds integers x in the 2D list and returns a list of (row, columns) coordinates.\n    Coordinates are sorted by rows in ascending order, then by columns in descending order.\n    \"\"\"\n    found_coordinates: List[Coordinate] = []\n\n    if not lst:\n        return []\n\n    for row_idx, row_list in enumerate(lst):\n        for col_idx, element in enumerate(row_list):\n            if element == x:\n                found_coordinates.append(Coordinate(row_idx, col_idx))\n\n    if not found_coordinates:\n        return []\n\n    found_coordinates.sort()\n\n    return [coord.to_tuple() for coord in found_coordinates]"}
{"task_id": "HumanEval/91", "solution": "import re\n\ndef is_bored(S):\n    \"\"\"\n    Counts the number of 'boredoms' in a given string S.\n    A boredom is a sentence that starts with the word \"I\".\n    \"\"\"\n    boredom_count = 0\n    # Split the string by delimiters '.', '?', and '!'\n    sentences = re.split(r'[.?!]', S)\n\n    for sentence in sentences:\n        cleaned_sentence = sentence.strip()\n        if cleaned_sentence:\n            # Check if the cleaned sentence starts with \"I \" or is exactly \"I\"\n            if cleaned_sentence.startswith(\"I \") or cleaned_sentence == \"I\":\n                boredom_count += 1\n\n    return boredom_count"}
{"task_id": "HumanEval/93", "solution": "_ALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\n_ALPHABET_UPPER = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n_VOWELS = \"aeiouAEIOU\"\n\ndef _is_english_letter(char):\n    \"\"\"Determines if a given character is an English alphabet letter.\"\"\"\n    return char.isalpha()\n\ndef _swap_case(char):\n    \"\"\"Swaps the case of an English letter.\"\"\"\n    return char.swapcase()\n\ndef _is_english_vowel(char):\n    \"\"\"Determines if a given character is an English vowel.\"\"\"\n    return char in _VOWELS\n\ndef _get_letter_two_positions_ahead(char):\n    \"\"\"Calculates the letter two positions ahead in the English alphabet, preserving case.\"\"\"\n    if char.islower():\n        alphabet = _ALPHABET_LOWER\n    else:\n        alphabet = _ALPHABET_UPPER\n    \n    current_index = alphabet.index(char)\n    new_index = (current_index + 2) % len(alphabet)\n    return alphabet[new_index]\n\ndef encode(message):\n    \"\"\"\n    Encodes a message by swapping case of letters and replacing vowels with\n    the letter two places ahead in the alphabet.\n    \"\"\"\n    encoded_chars = []\n    for char in message:\n        if _is_english_letter(char):\n            processed_char = _swap_case(char)\n            if _is_english_vowel(processed_char):\n                final_char = _get_letter_two_positions_ahead(processed_char)\n            else:\n                final_char = processed_char\n        else:\n            final_char = char\n        encoded_chars.append(final_char)\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Checks if a number is prime (natural number > 1 with no positive divisors other than 1 and itself).\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def _sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the decimal digits of a number.\"\"\"\n        s = 0\n        while n > 0:\n            s += n % 10\n            n //= 10\n        return s\n\n    largest_prime = -1\n    found_prime = False\n\n    for num in lst:\n        if _is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n                found_prime = True\n\n    if found_prime:\n        return _sum_digits(largest_prime)\n    else:\n        return 0"}
{"task_id": "HumanEval/98", "solution": "UPPERCASE_VOWELS = {'A', 'E', 'I', 'O', 'U'}\n\ndef count_upper(s):\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n    \n    For example:\n    count_upper('aBCdEf') returns 1\n    count_upper('abcdefg') returns 0\n    count_upper('dBBE') returns 0\n    \"\"\"\n    count = 0\n    for i, char in enumerate(s):\n        if i % 2 == 0 and char in UPPERCASE_VOWELS:\n            count += 1\n    return count"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lower = True\n    all_upper = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n        \n        if not key.islower():\n            all_lower = False\n        if not key.isupper():\n            all_upper = False\n            \n    return all_lower or all_upper"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Implement a function that takes a non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    for example:\n    count_up_to(5) => [2,3]\n    count_up_to(11) => [2,3,5,7]\n    count_up_to(0) => []\n    count_up_to(20) => [2,3,5,7,11,13,17,19]\n    count_up_to(1) => []\n    count_up_to(18) => [2,3,5,7,11,13,17]\n    \"\"\"\n    def _is_prime(num):\n        \"\"\"Checks if a given number is prime.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    primes = []\n    if n <= 2: # No primes less than or equal to 2, considering primes start from 2\n        return []\n\n    for num in range(2, n):\n        if _is_prime(num):\n            primes.append(num)\n    return primes"}
{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Complete the function that takes two integers and returns\n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    \"\"\"\n    unit_digit_a = abs(a) % 10\n    unit_digit_b = abs(b) % 10\n\n    product = unit_digit_a * unit_digit_b\n\n    return product"}
{"task_id": "HumanEval/99", "solution": "import math\n\ndef closest_integer(value):\n    \"\"\"\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n    \"\"\"\n    numeric_value = float(value)\n\n    floor_val = math.floor(numeric_value)\n    ceil_val = math.ceil(numeric_value)\n\n    dist_to_floor = abs(numeric_value - floor_val)\n    dist_to_ceil = abs(numeric_value - ceil_val)\n\n    if dist_to_floor == dist_to_ceil:\n        # Equidistant, round away from zero\n        if numeric_value >= 0:\n            return int(ceil_val)\n        else:\n            return int(floor_val)\n    elif dist_to_floor < dist_to_ceil:\n        return int(floor_val)\n    else:\n        return int(ceil_val)"}
