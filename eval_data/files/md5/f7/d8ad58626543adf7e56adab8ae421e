{"task_id": "HumanEval/36", "solution": "def _is_divisible_by_11_or_13(number: int) -> bool:\n    \"\"\"Checks if a number is divisible by 11 or 13.\"\"\"\n    return (number % 11 == 0) or (number % 13 == 0)\n\ndef _count_digit_7(number: int) -> int:\n    \"\"\"Counts the occurrences of the digit '7' in a number.\"\"\"\n    return str(number).count('7')\n\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_count = 0\n    for number in range(1, n):\n        if _is_divisible_by_11_or_13(number):\n            total_count += _count_digit_7(number)\n    return total_count"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    \"\"\"\n    l_prime = list(l)  # Create a mutable copy of the input list for the output.\n    \n    # Collect elements from indices divisible by three.\n    elements_to_sort = []\n    for i in range(len(l)):\n        if i % 3 == 0:\n            elements_to_sort.append(l[i])\n            \n    # Sort the collected elements.\n    elements_to_sort.sort()\n    \n    # Place the sorted elements back into l_prime at their original divisible-by-three indices.\n    sorted_idx = 0\n    for i in range(len(l)):\n        if i % 3 == 0:\n            l_prime[i] = elements_to_sort[sorted_idx]\n            sorted_idx += 1\n            \n    return l_prime"}
{"task_id": "HumanEval/39", "solution": "import math\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    def is_prime(num: int) -> bool:\n        \"\"\"Determines if a given number is a prime number.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    def is_perfect_square(num: int) -> bool:\n        \"\"\"Helper function to check if a number is a perfect square.\"\"\"\n        if num < 0:\n            return False\n        s = int(math.isqrt(num))\n        return s * s == num\n\n    def is_fibonacci(num: int) -> bool:\n        \"\"\"\n        Determines if a number is Fibonacci using the property: x is Fibonacci if 5x^2 + 4 or 5x^2 - 4 is a perfect square.\n        \"\"\"\n        if num < 0:\n            return False\n        return is_perfect_square(5 * num * num + 4) or \\\n               is_perfect_square(5 * num * num - 4)\n\n    def generate_fibonacci_sequence():\n        \"\"\"Generates an infinite sequence of Fibonacci numbers starting from 0, 1, 1, 2, ...\"\"\"\n        a, b = 0, 1\n        while True:\n            yield a\n            a, b = b, a + b\n\n    prime_fib_count = 0\n    fib_gen = generate_fibonacci_sequence()\n\n    while True:\n        fib_num = next(fib_gen)\n        # Skip 0 and 1 as they are not considered prime numbers.\n        if fib_num > 1 and is_prime(fib_num):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return fib_num"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    \n    if not l:\n        return []\n\n    even_elements_buffer = []\n    # Create a new list for the result, initially with None or placeholder values\n    # The length is the same as the input list.\n    result_list = [None] * len(l)\n\n    # First pass: populate odd-indexed elements directly and collect even-indexed elements\n    for i in range(len(l)):\n        if i % 2 != 0:  # Odd index\n            result_list[i] = l[i]\n        else:  # Even index\n            even_elements_buffer.append(l[i])\n\n    # Sort the collected even-indexed elements\n    even_elements_buffer.sort()\n\n    # Second pass: place the sorted even-indexed elements back into their positions\n    even_index_pointer = 0\n    for i in range(len(l)):\n        if i % 2 == 0:  # Even index\n            result_list[i] = even_elements_buffer[even_index_pointer]\n            even_index_pointer += 1\n\n    return result_list"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    Checks if there are three distinct elements in the list that sum to zero.\n    Returns True if such a triple exists, False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n    return False"}
