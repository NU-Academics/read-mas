{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i in range(len(numbers)):\n        result.append(numbers[i])\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/7", "solution": "from typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\ndef _clean_string(s: str) -> str:\n    \"\"\"Removes all space characters from the input string.\"\"\"\n    return s.replace(\" \", \"\")\n\n\ndef _find_groups(cleaned_string: str) -> List[str]:\n    \"\"\"Identifies and extracts distinct, balanced, and non-nested parenthesis groups.\"\"\"\n    result = []\n    current_group_chars = []\n    balance = 0\n    group_in_progress = False\n\n    for char in cleaned_string:\n        if char == '(':\n            balance += 1\n            if not group_in_progress:\n                group_in_progress = True\n            current_group_chars.append(char)\n        elif char == ')':\n            balance -= 1\n            if group_in_progress:\n                current_group_chars.append(char)\n\n            if balance == 0 and group_in_progress:\n                result.append(\"\".join(current_group_chars))\n                current_group_chars = []\n                group_in_progress = False\n    return result\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    cleaned_string = _clean_string(paren_string)\n    return _find_groups(cleaned_string)"}
{"task_id": "HumanEval/4", "solution": "from typing import List\nimport math\n\n\ndef _calculate_mean(numbers: List[float]) -> float:\n    \"\"\"Calculates the arithmetic mean of a list of floating-point numbers.\n    Precondition: The input list must not be empty.\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty for mean calculation.\")\n    return sum(numbers) / len(numbers)\n\n\ndef _calculate_absolute_differences(numbers: List[float], mean_value: float) -> List[float]:\n    \"\"\"Calculates the absolute difference between each number and the mean.\"\"\"\n    return [math.fabs(number - mean_value) for number in numbers]\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        # This check is also in _calculate_mean, but good to have at entry point\n        raise ValueError(\"Input list cannot be empty for MAD calculation.\")\n\n    mean_value = _calculate_mean(numbers)\n    absolute_diffs = _calculate_absolute_differences(numbers, mean_value)\n\n    # Calculate the average of the absolute differences\n    if not absolute_diffs:\n        return 0.0 # Should only happen if initial numbers was empty, handled above\n    mad_value = sum(absolute_diffs) / len(absolute_diffs)\n\n    return mad_value"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef _calculate_group_depth(group_string: str) -> int:\n    \"\"\"Calculates the maximum nesting depth for a single parenthesis group string.\"\"\"\n    current_depth = 0\n    max_depth = 0\n    for char in group_string:\n        if char == '(':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            if current_depth > 0:\n                current_depth -= 1\n    return max_depth\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    groups = paren_string.split(' ')\n    results: List[int] = []\n    for group_string in groups:\n        if not group_string.strip():\n            continue\n        depth = _calculate_group_depth(group_string)\n        results.append(depth)\n    return results"}
{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    # Sort the list to efficiently check only adjacent elements for closeness.\n    sorted_numbers = sorted(numbers)\n\n    for i in range(len(sorted_numbers) - 1):\n        if abs(sorted_numbers[i+1] - sorted_numbers[i]) < threshold:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    integer_part = math.floor(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/3", "solution": "from typing import List\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    balance: int = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    result = []\n    current_max = None\n    for num in numbers:\n        if current_max is None or num > current_max:\n            current_max = num\n        result.append(current_max)\n    return result"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    def is_palindrome(s: str) -> bool:\n        \"\"\" Test if given string is a palindrome \"\"\"\n        return s == s[::-1]\n\n    # Find the longest postfix of supplied string that is a palindrome.\n    longest_palindromic_postfix_start_index = len(string)\n    for i in range(len(string)):\n        postfix = string[i:]\n        if is_palindrome(postfix):\n            longest_palindromic_postfix_start_index = i\n            break\n\n    # The prefix that comes before the palindromic suffix\n    prefix_before_postfix = string[:longest_palindromic_postfix_start_index]\n\n    # Append to the end of the string reverse of a string prefix\n    return string + prefix_before_postfix[::-1]"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/11", "solution": "class InvalidBinaryStringError(ValueError):\n    \"\"\"Raised when a string contains characters other than '0' or '1'.\"\"\"\n    pass\n\nclass UnequalLengthStringsError(ValueError):\n    \"\"\"Raised when two input strings for XOR operation have different lengths.\"\"\"\n    pass\n\nclass StringInput:\n    def __init__(self, value: str):\n        if not isinstance(value, str):\n            raise TypeError(\"Input must be a string.\")\n        self._value = value\n        self.validateBinaryContent()\n\n    def validateBinaryContent(self) -> None:\n        if not all(char in ('0', '1') for char in self._value):\n            raise InvalidBinaryStringError(\"Input string must consist only of '0's and '1's.\")\n\n    def getLength(self) -> int:\n        return len(self._value)\n\n    def get_value(self) -> str:\n        return self._value\n\nclass XORResult:\n    def __init__(self, value: str):\n        if not isinstance(value, str):\n            raise TypeError(\"Result must be a string.\")\n        self._value = value\n\n    def get_value(self) -> str:\n        return self._value\n\nclass XOROperation:\n    def performXOR(self, a: StringInput, b: StringInput) -> XORResult:\n        if a.getLength() != b.getLength():\n            raise UnequalLengthStringsError(\"Input strings must be of equal length.\")\n\n        result_chars = []\n        for i in range(a.getLength()):\n            char_a = a.get_value()[i]\n            char_b = b.get_value()[i]\n            if char_a != char_b:\n                result_chars.append('1')\n            else:\n                result_chars.append('0')\n        return XORResult(\"\".join(result_chars))\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    try:\n        input_a = StringInput(a)\n        input_b = StringInput(b)\n\n        xor_operator = XOROperation()\n        xor_result = xor_operator.performXOR(input_a, input_b)\n\n        return xor_result.get_value()\n    except (InvalidBinaryStringError, UnequalLengthStringsError) as e:\n        raise e\n    except Exception as e:\n        raise RuntimeError(f\"An unexpected error occurred during XOR operation: {e}\") from e"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_so_far: Optional[str] = None\n    max_length: int = -1\n\n    for current_string in strings:\n        current_length = len(current_string)\n        if current_length > max_length:\n            max_length = current_length\n            longest_so_far = current_string\n\n    return longest_so_far"}
