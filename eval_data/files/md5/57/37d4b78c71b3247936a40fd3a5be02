{"task_id": "HumanEval/6", "solution": "from typing import List\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Computes the maximum nesting depth for each group of parentheses in a string.\n    Groups are separated by whitespace, and malformed groups raise a ValueError.\n    \"\"\"\n    groups = paren_string.split()\n    result = []\n\n    for i, group in enumerate(groups):\n        current_depth = 0\n        max_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n                if current_depth < 0:\n                    raise ValueError(f\"Unmatched closing parenthesis in group {i}: '{group}'\")\n            else:\n                raise ValueError(f\"Invalid character in group {i}: '{char}'\")\n\n        if current_depth != 0:\n            raise ValueError(f\"Unmatched opening parenthesis in group {i}: '{group}'\")\n\n        result.append(max_depth)\n\n    return result"}
{"task_id": "HumanEval/26", "solution": "from typing import List\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    result: List[int] = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n    return result"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    Checks if there are three distinct elements in the list that sum to zero.\n    The list is sorted, and a three-pointer approach is used for efficient checking.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    l.sort()  # Sorts the list in-place to enable the two-pointer approach.\n\n    for i in range(n - 2):\n        left = i + 1\n        right = n - 1\n\n        while left < right:\n            current_sum = l[i] + l[left] + l[right]\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else: # current_sum > 0\n                right -= 1\n\n    return False"}
{"task_id": "HumanEval/69", "solution": "import collections\n\ndef search(lst):\n    \"\"\"\n    Finds the greatest positive integer x such that its frequency in lst is >= x.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    counts = collections.Counter(lst)\n    max_candidate = -1\n\n    for value, frequency in counts.items():\n        # Check if the value is positive and its frequency is greater than or equal to itself.\n        if value > 0 and frequency >= value:\n            if value > max_candidate:\n                max_candidate = value\n\n    return max_candidate"}
