{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on the count of uppercase and lowercase letters.\n    Returns the class name concatenated with the strongest extension name.\n    \"\"\"\n    max_strength = float('-inf')\n    strongest_extension_name = \"\"\n\n    for extension in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in extension:\n            if char.isupper():\n                cap_count += 1\n            elif char.islower():\n                sm_count += 1\n\n        current_strength = cap_count - sm_count\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"Calculates the absolute difference between corresponding elements of two lists.\n    Returns a new list showing how far off each guess was from the actual score.\n    \"\"\"\n    return [abs(score - player_guess) for score, player_guess in zip(game, guess)]"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Selects the extension with the highest strength and returns a formatted string.\n    Strength is calculated as (number of uppercase letters) - (number of lowercase letters).\n    \"\"\"\n    best_ext = None\n    best_strength = float('-inf')\n\n    for ext in extensions:\n        cap = sum(1 for c in ext if c.isupper())\n        sm = sum(1 for c in ext if c.islower())\n        strength = cap - sm\n\n        if strength > best_strength:\n            best_strength = strength\n            best_ext = ext\n\n    if best_ext is not None:\n        return f\"{class_name}.{best_ext}\"\n    else:\n        return f\"{class_name}.\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if b or any of its rotations is a substring of a.\"\"\"\n    len_b = len(b)\n    if len_b == 0:\n        return True\n\n    for i in range(len_b):\n        # Generate each rotation of b and check if it's in a.\n        rotated_b = b[i:] + b[:i]\n        if rotated_b in a:\n            return True\n    return False"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word.\"\"\"\n    len_b = len(b)\n\n    # An empty string is considered a substring of any string, including an empty string.\n    if len_b == 0:\n        return True\n\n    # Concatenate b with itself to easily generate all its rotations as substrings.\n    b_doubled = b + b\n\n    # Check if any rotation of b is a substring of a.\n    for i in range(len_b):\n        rotation = b_doubled[i : i + len_b]\n        if rotation in a:\n            return True\n\n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\n    The absolute value of the number is used to process its digits.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Convert the absolute value of the number to a string to iterate through its digits.\n    for digit_char in str(abs(num)):\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\n    This implementation uses an arithmetic approach to count digits.\"\"\"\n    if not isinstance(num, int) or isinstance(num, bool):\n        raise TypeError(\"num must be an int\")\n\n    n = abs(num)\n    if n == 0:\n        return (1, 0)\n\n    even = 0\n    odd = 0\n    while n > 0:\n        digit = n % 10\n        if digit % 2 == 0:\n            even += 1\n        else:\n            odd += 1\n        n //= 10\n    return (even, odd)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    if not isinstance(number, int):\n        raise ValueError(\"number must be an integer\")\n    if number < 1 or number > 1000:\n        raise ValueError(\"number must be between 1 and 1000 inclusive\")\n\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'),\n        (1, 'I')\n    ]\n\n    parts = []\n    for value, numeral in roman_map:\n        if number == 0:\n            break\n        count, number = divmod(number, value)\n        if count:\n            parts.append(numeral * count)\n\n    return \"\".join(parts).lower()"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle, return True if they form\n    a right-angled triangle, False otherwise.\n\n    Uses robust validation and floating-point tolerant comparison.\n    \"\"\"\n    import math\n\n    # Convert to floats and validate numeric input\n    try:\n        x, y, z = float(a), float(b), float(c)\n    except (TypeError, ValueError):\n        return False\n\n    # Must be finite and positive\n    if not (math.isfinite(x) and math.isfinite(y) and math.isfinite(z)):\n        return False\n    if x <= 0 or y <= 0 or z <= 0:\n        return False\n\n    # Sort so z is the longest side\n    x, y, z = sorted((x, y, z))\n\n    # Tolerances for floating point comparisons\n    rel_tol = 1e-9\n    abs_tol = 1e-12\n\n    # Reject degenerate or invalid triangle (x + y must be greater than z)\n    if x + y <= z + max(rel_tol * z, abs_tol):\n        return False\n\n    # Check Pythagorean theorem with tolerance\n    return math.isclose(x * x + y * y, z * z, rel_tol=rel_tol, abs_tol=abs_tol)"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    \"\"\"\n    Returns True if the three side lengths form a valid right-angled triangle, False otherwise.\n    Handles floats, NaNs, infinities, and non-positive lengths per design.\n    \"\"\"\n    # Type checks: disallow bools explicitly\n    for val in (a, b, c):\n        if isinstance(val, bool):\n            raise TypeError(\"Inputs must be int or float (not bool)\")\n        if not isinstance(val, (int, float)):\n            raise TypeError(\"Inputs must be int or float\")\n\n    f_a = float(a)\n    f_b = float(b)\n    f_c = float(c)\n\n    # Check for NaN or non-finite inputs\n    if not (f_a == f_a and f_a != float('inf') and f_a != float('-inf')):\n        return False\n    if not (f_b == f_b and f_b != float('inf') and f_b != float('-inf')):\n        return False\n    if not (f_c == f_c and f_c != float('inf') and f_c != float('-inf')):\n        return False\n\n    # Non-positive sides are invalid\n    if f_a <= 0 or f_b <= 0 or f_c <= 0:\n        return False\n\n    # Sort sides so z is the largest\n    x, y, z = sorted([f_a, f_b, f_c])\n\n    # Triangle inequality: strict\n    if x + y <= z:\n        return False\n\n    # Scaled comparison to avoid overflow: (x/z)^2 + (y/z)^2 == 1\n    sx = x / z\n    sy = y / z\n    left_hand_side = sx * sx + sy * sy\n    right_hand_side = 1.0\n\n    # Tolerances\n    rel_tol = 1e-9\n    abs_tol = 1e-12\n\n    diff = abs(left_hand_side - right_hand_side)\n    tolerance = max(rel_tol * max(abs(left_hand_side), abs(right_hand_side)), abs_tol)\n\n    return diff <= tolerance"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its Roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= number <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    if not isinstance(number, int):\n        raise ValueError(\"number must be an integer\")\n    if number < 1 or number > 1000:\n        raise ValueError(\"number must be in range 1..1000\")\n\n    roman_map = [\n        (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"),\n        (100, \"C\"), (90, \"XC\"), (50, \"L\"), (40, \"XL\"),\n        (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"),\n        (1, \"I\")\n    ]\n\n    parts = []\n    n = number\n    for value, numeral in roman_map:\n        if n == 0:\n            break\n        count, n = divmod(n, value)\n        if count:\n            parts.append(numeral * count)\n\n    return \"\".join(parts).lower()"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Return the word with the maximum number of unique characters.\n    If multiple words tie, return the lexicographically smallest one.\n    If the input list is empty, return an empty string.\n    \"\"\"\n    if not words:\n        return \"\"\n    best = words[0]\n    best_count = len(set(best))\n    for word in words[1:]:\n        cnt = len(set(word))\n        if cnt > best_count or (cnt == best_count and word < best):\n            best = word\n            best_count = cnt\n    return best"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and remaining after a rabbit's meal.\n    The rabbit eats the minimum of its need or the available remaining carrots.\n    \"\"\"\n    carrots_to_eat = min(need, remaining)\n    total_eaten = number + carrots_to_eat\n    carrots_left = remaining - carrots_to_eat\n    return [total_eaten, carrots_left]"}
