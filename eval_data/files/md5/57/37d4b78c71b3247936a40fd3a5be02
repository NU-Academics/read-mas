{"task_id": "HumanEval/99", "solution": "from decimal import Decimal, ROUND_HALF_UP\n\ndef closest_integer(value):\n    \"\"\"\n    Returns the closest integer to a numeric string, rounding halves away from zero.\n    This implementation uses Decimal for precise arithmetic.\n    \"\"\"\n    if not isinstance(value, str):\n        raise TypeError(\"value must be a string\")\n    stripped_value = value.strip()\n    try:\n        d = Decimal(stripped_value)\n    except Exception:\n        raise ValueError(f\"Invalid numeric string: {value!r}\")\n    if d.is_nan() or d.is_infinite():\n        raise ValueError(f\"Invalid numeric string: {value!r}\")\n    rounded_d = d.quantize(Decimal('1'), rounding=ROUND_HALF_UP)\n    return int(rounded_d)"}
{"task_id": "HumanEval/99", "solution": "def closest_integer(value):\n    \"\"\"\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n\n    Returns:\n        int: nearest integer (ties away from zero)\n\n    Raises:\n        ValueError: if the input is not a valid numeric string\n    \"\"\"\n    from decimal import Decimal, InvalidOperation, localcontext, ROUND_FLOOR, ROUND_CEILING\n\n    if not isinstance(value, str):\n        raise ValueError(\"Input must be a string representing a number\")\n\n    s = value.strip()\n    if s == \"\":\n        raise ValueError(\"Empty string is not a valid number\")\n\n    try:\n        # Use a local context with sufficient precision to parse the input exactly\n        with localcontext() as ctx:\n            ctx.prec = max(28, len(s) + 5)\n            d = Decimal(s)\n    except (InvalidOperation, ValueError, TypeError):\n        raise ValueError(f\"Invalid numeric string: {value!r}\")\n\n    if d.is_nan() or d.is_infinite():\n        raise ValueError(f\"Invalid numeric value: {value!r}\")\n\n    # Integral boundaries\n    floor = d.to_integral_value(rounding=ROUND_FLOOR)\n    ceil = d.to_integral_value(rounding=ROUND_CEILING)\n\n    # If already an integer\n    if d == floor == ceil:\n        return int(d)\n\n    dist_to_floor = d - floor  # >= 0\n    dist_to_ceil = ceil - d    # >= 0\n\n    if dist_to_floor < dist_to_ceil:\n        return int(floor)\n    if dist_to_floor > dist_to_ceil:\n        return int(ceil)\n\n    # Tie: choose the integer that is farther from zero\n    return int(ceil if d >= 0 else floor)"}
