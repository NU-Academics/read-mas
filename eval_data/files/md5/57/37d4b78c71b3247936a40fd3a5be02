{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n\n    Example 1:\n\n        Input: arr = [-3, -4, 5], k = 3\n        Output: [-4, -3, 5]\n\n    Example 2:\n\n        Input: arr = [4, -4, 4], k = 2\n        Output: [4, 4]\n\n    Example 3:\n\n        Input: arr = [-3, 2, 1, 2, -1, -2, 1], k = 1\n        Output: [2]\n\n    Note:\n        1. The length of the array will be in the range of [1, 1000].\n        2. The elements in the array will be in the range of [-1000, 1000].\n        3. 0 <= k <= len(arr)\n    \"\"\"\n    # Validate types\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an int\")\n\n    n = len(arr)\n    if k < 0 or k > n:\n        raise ValueError(\"k must be in the range 0 <= k <= len(arr)\")\n\n    if k == 0:\n        return []\n\n    # Sort the array (ascending) and return the last k elements which are the largest.\n    sorted_arr = sorted(arr)\n    start = n - k\n    return sorted_arr[start:]"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list of odd numbers in its Collatz sequence.\n    The sequence stops when it reaches 1.\n    \"\"\"\n    odd_numbers = set()\n    current = n\n    while current != 1:\n        if current % 2 != 0:\n            odd_numbers.add(current)\n            current = 3 * current + 1\n        else:\n            current = current // 2\n    odd_numbers.add(1)  # 1 is always part of the sequence and is odd\n\n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\"\"\"\n    return sum(value for index, value in enumerate(lst) if index % 2 == 0 and value % 2 != 0)"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n\n    The returned list contains unique odd numbers from the sequence, sorted in increasing order.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be a positive integer (>= 1)\")\n\n    odd_numbers = set()\n    current = n\n\n    while current != 1:\n        if current % 2 != 0:\n            odd_numbers.add(current)\n            current = 3 * current + 1\n        else:\n            current = current // 2\n\n    odd_numbers.add(1)\n    return sorted(odd_numbers)"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"Return True if date is a valid mm-dd-yyyy string according to the spec, else False.\"\"\"\n    if date is None:\n        return False\n    s = date.strip()\n    if not s:\n        return False\n\n    import re\n    if not re.fullmatch(r\"\\d{2}-\\d{2}-\\d{4}\", s):\n        return False\n\n    month_str, day_str, _ = s.split('-')\n    try:\n        month = int(month_str)\n        day = int(day_str)\n    except ValueError:\n        return False\n\n    if not (1 <= month <= 12):\n        return False\n\n    if month == 2:\n        max_day = 29\n    elif month in (4, 6, 9, 11):\n        max_day = 30\n    else:\n        max_day = 31\n\n    return 1 <= day <= max_day"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits text by whitespace, then by commas, or counts lowercase letters with odd alphabetical indices.\n    Returns a list of strings or an integer count based on the content of txt.\n    \"\"\"\n    if any(ch.isspace() for ch in txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                pos = ord(char) - ord('a')\n                if pos % 2 == 1:\n                    count += 1\n        return count"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"\n    Checks if a list of non-negative integers is sorted in ascending order\n    and if no number appears more than twice.\n    \"\"\"\n    if len(lst) <= 1:\n        return True\n\n    counts = {}\n    for i in range(len(lst)):\n        num = lst[i]\n        counts[num] = counts.get(num, 0) + 1\n\n        if counts[num] > 2:\n            return False\n\n        if i > 0 and num < lst[i-1]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/124", "solution": "import re\n\ndef valid_date(date):\n    \"\"\"Validates a date string against specific format and range rules.\"\"\"\n    # 1. If date is None or an empty string (after stripping whitespace), return False.\n    if date is None:\n        return False\n\n    # 2. Strip any leading/trailing whitespace from the input.\n    date = date.strip()\n\n    # If the string became empty after stripping\n    if not date:\n        return False\n\n    # 3. Use a strict regular expression to check format: '^\\d{2}-\\d{2}-\\d{4}$'.\n    # 4. If regex fails, return False.\n    date_pattern = r'^\\d{2}-\\d{2}-\\d{4}$'\n    if not re.fullmatch(date_pattern, date):\n        return False\n\n    # 5. Split the string by '-' into three parts: mm, dd, yyyy.\n    mm_str, dd_str, yyyy_str = date.split('-')\n\n    # 6. Convert mm and dd to integers. Regex ensures they are digits.\n    month = int(mm_str)\n    day = int(dd_str)\n    # yyyy_str is not needed for numeric range validation.\n\n    # 7. Validate month in 1..12.\n    if not (1 <= month <= 12):\n        return False\n\n    # 8. Determine max_day for the month.\n    months_with_31_days = {1, 3, 5, 7, 8, 10, 12}\n    months_with_30_days = {4, 6, 9, 11}\n\n    if month in months_with_31_days:\n        max_day = 31\n    elif month in months_with_30_days:\n        max_day = 30\n    else:  # month == 2 -> February\n        max_day = 29  # 29 is allowed per specification (no leap-year checks).\n\n    # 9. Validate day is between 1 and max_day inclusive.\n    if not (1 <= day <= max_day):\n        return False\n\n    # 10. If all checks pass, return True.\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits text by whitespace, then by comma, or counts odd-indexed lowercase letters.\n    Handles non-string inputs by coercing to string.\n    \"\"\"\n    txt = str(txt)\n\n    if any(ch.isspace() for ch in txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for ch in txt:\n            if 'a' <= ch <= 'z' and ((ord(ch) - ord('a')) % 2 == 1):\n                count += 1\n        return count"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"You are given two closed intervals (start, end) with start <= end.\n    Determine whether the length of their intersection (end - start) is a prime number.\n    Return \"YES\" if prime, otherwise \"NO\". If they don't intersect, return \"NO\".\n    \"\"\"\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    inter_start = max(start1, start2)\n    inter_end = min(end1, end2)\n\n    intersection_length = max(0, inter_end - inter_start)\n\n    def is_prime(n):\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    return \"YES\" if is_prime(intersection_length) else \"NO\""}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers.\n    \"\"\"\n    a1, b1 = interval1\n    a2, b2 = interval2\n\n    inter_start = max(a1, a2)\n    inter_end = min(b1, b2)\n\n    if inter_start > inter_end:\n        return \"NO\"\n\n    length = inter_end - inter_start\n\n    if length <= 1:\n        return \"NO\"\n\n    # Primality check for length (integer >= 2)\n    if length == 2 or length == 3:\n        return \"YES\"\n    if length % 2 == 0 or length % 3 == 0:\n        return \"NO\"\n\n    i = 5\n    while i * i <= length:\n        if length % i == 0 or length % (i + 2) == 0:\n            return \"NO\"\n        i += 6\n    return \"YES\""}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates sum of magnitudes of integers multiplied by product of all signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    sign_product = 1\n    magnitude_sum = 0\n\n    for num in arr:\n        if num == 0:\n            return 0\n        if num < 0:\n            sign_product *= -1\n        magnitude_sum += abs(num)\n\n    return magnitude_sum * sign_product"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    sign_product = 1\n    magnitude_sum = 0\n\n    for x in arr:\n        if x == 0:\n            sign_product = 0\n        elif x < 0:\n            sign_product *= -1\n\n        magnitude_sum += abs(x)\n\n    return magnitude_sum * sign_product"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"Finds the lexicographically smallest path of length k in a grid.\"\"\"\n    if not grid or k <= 0:\n        return []\n\n    N = len(grid)\n\n    # 1. Identify the starting cell: the globally smallest cell value.\n    min_val = float('inf')\n    start_r, start_c = -1, -1\n\n    for r_idx in range(N):\n        for c_idx in range(N):\n            if grid[r_idx][c_idx] < min_val:\n                min_val = grid[r_idx][c_idx]\n                start_r, start_c = r_idx, c_idx\n\n    # 2. Initialize result list and set current position.\n    path_values = []\n    current_r, current_c = start_r, start_c\n\n    # 3. Repeat up to k steps.\n    for _ in range(k):\n        # a. Append the value at the current position to the result.\n        path_values.append(grid[current_r][current_c])\n\n        # b. If the result has length k, stop.\n        if len(path_values) == k:\n            break\n\n        # c. Otherwise, find the neighbor with minimal numeric value and update current position.\n        min_neighbor_val = float('inf')\n        next_r, next_c = -1, -1\n\n        # Check up to four neighbors (up, down, left, right)\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # dr, dc\n\n        for dr, dc in directions:\n            nr, nc = current_r + dr, current_c + dc\n\n            # Check if neighbor is within grid bounds\n            if 0 <= nr < N and 0 <= nc < N:\n                if grid[nr][nc] < min_neighbor_val:\n                    min_neighbor_val = grid[nr][nc]\n                    next_r, next_c = nr, nc\n\n        current_r, current_c = next_r, next_c\n\n    # 4. Return the result list.\n    return path_values"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the Tribonacci sequence up to tri(n) using an iterative approach.\n    It handles a forward dependency for odd indices by pre-calculating even terms.\"\"\"\n    if n == 0:\n        return [1]\n\n    res = [0] * (n + 2)\n    res[0] = 1\n    res[1] = 3\n\n    for k in range(2, n + 1):\n        if k % 2 == 0:\n            res[k] = 1 + k // 2\n        else:\n            # k+1 is even, so res[k+1] can be directly computed\n            res[k + 1] = 1 + (k + 1) // 2\n            res[k] = res[k - 1] + res[k - 2] + res[k + 1]\n\n    return res[0 : n + 1]"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Given an N x N grid containing all integers from 1 to N*N exactly once,\n    return the lexicographically smallest path of length k (list of values),\n    where you may start at any cell and at each step move to an orthogonally\n    adjacent cell. Paths may revisit cells.\n    \"\"\"\n    import heapq\n\n    if k <= 0:\n        return []\n\n    if not grid or not grid[0]:\n        return []\n\n    N = len(grid)\n    # Basic validation: square grid\n    for row in grid:\n        if len(row) != N:\n            raise ValueError(\"grid must be square (N x N)\")\n\n    # Min-heap ordered by the path tuple (lexicographic ordering of visited values)\n    heap = []\n    for r in range(N):\n        for c in range(N):\n            heapq.heappush(heap, ((grid[r][c],), r, c, 1))\n\n    directions = ((0, 1), (0, -1), (1, 0), (-1, 0))\n\n    while heap:\n        path_tuple, r, c, steps = heapq.heappop(heap)\n        if steps == k:\n            return list(path_tuple)\n        for dr, dc in directions:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < N and 0 <= nc < N:\n                new_path = path_tuple + (grid[nr][nc],)\n                heapq.heappush(heap, (new_path, nr, nc, steps + 1))\n\n    return []"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\"\"\"\n    product_of_odds = 1\n    found_odd_digit = False\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:\n            product_of_odds *= digit\n            found_odd_digit = True\n\n    if found_odd_digit:\n        return product_of_odds\n    else:\n        return 0"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if there's a nested balanced bracket subsequence (depth >= 2) by searching for \"[[]]\" as a subsequence.\n    This is achieved by greedily finding two opening brackets followed by two closing brackets in order.\n    \"\"\"\n    i1 = string.find('[')\n    if i1 == -1:\n        return False\n\n    i2 = string.find('[', i1 + 1)\n    if i2 == -1:\n        return False\n\n    j1 = string.find(']', i2 + 1)\n    if j1 == -1:\n        return False\n\n    j2 = string.find(']', j1 + 1)\n    if j2 == -1:\n        return False\n\n    return True"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n+1 Tribonacci numbers and returns them as a list.\n    Definition:\n      tri(0) = 1\n      tri(1) = 3\n      if k is even: tri(k) = 1 + k // 2\n      if k is odd:  tri(k) = tri(k-1) + tri(k-2) + tri(k+1)\n    The implementation precomputes all even indices (including tri(n+1) when needed)\n    then fills odd indices in increasing order.\n    \"\"\"\n    if n == 0:\n        return [1]\n    if n == 1:\n        return [1, 3]\n\n    # Need values up to tri(n+1) to resolve forward references for odd indices.\n    trib_values = [0] * (n + 2)\n    trib_values[0] = 1\n    trib_values[1] = 3\n\n    # Compute all even-indexed values (including index n+1).\n    for k in range(0, n + 2):\n        if k % 2 == 0:\n            trib_values[k] = 1 + k // 2\n\n    # Compute odd-indexed values (starting from 3).\n    for k in range(3, n + 1):\n        if k % 2 != 0:\n            trib_values[k] = trib_values[k - 1] + trib_values[k - 2] + trib_values[k + 1]\n\n    return trib_values[: n + 1]"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Return True iff there exists a balanced subsequence with nesting (depth >= 2).\n    Equivalent to checking if the subsequence '[[]]' exists as indices i<j<k<l.\n    \"\"\"\n    total_closes = string.count(']')\n    opens_seen = 0\n    for ch in string:\n        if ch == '[':\n            # current '[' can serve as the inner '[' (j) if there was a previous '['\n            # and there are at least two ']' remaining after it (k and l)\n            if opens_seen >= 1 and total_closes >= 2:\n                return True\n            opens_seen += 1\n        elif ch == ']':\n            total_closes -= 1\n    return False"}
{"task_id": "HumanEval/133", "solution": "import math\n\ndef sum_squares(lst):\n    \"\"\"\n    Calculates the sum of squares of numbers in a list after rounding each up to the nearest integer.\n    Each element is first rounded up using ceiling, then squared, and finally all squares are summed.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        rounded_num = math.ceil(num)\n        total_sum += rounded_num ** 2\n    return total_sum"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Create a function that returns True if the last character\n    of a given string is an alphabetical character and is not\n    a part of a word, and False otherwise.\n    Note: \"word\" is a group of characters separated by space.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    # The last character is a standalone letter if it's the only character\n    # in the string, or if it is preceded by a space.\n    return len(txt) == 1 or txt[-2] == ' '"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Create a function which returns the largest index of an element which\n    is not greater than or equal to the element immediately preceding it. If\n    no such element exists then return -1.\n    \"\"\"\n    if arr is None or len(arr) < 2:\n        return -1\n\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i - 1]:\n            return i\n\n    return -1"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n\n    Zero is treated as neither positive nor negative.\n    Non-integer values are ignored; bools are excluded.\n    \"\"\"\n    largest_neg = None\n    smallest_pos = None\n\n    for x in lst:\n        # Exclude booleans (subclass of int) and non-integers\n        if isinstance(x, bool) or not isinstance(x, int):\n            continue\n\n        if x < 0:\n            if largest_neg is None or x > largest_neg:\n                largest_neg = x\n        elif x > 0:\n            if smallest_pos is None or x < smallest_pos:\n                smallest_pos = x\n\n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    '''\n    Create a function that returns True if the last character\n    of a given string is an alphabetical character and is not\n    a part of a word, and False otherwise.\n    Note: \"word\" is a group of characters separated by space.\n    '''\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    # Split the string by spaces and filter out empty segments.\n    words = [word for word in txt.split(' ') if word]\n\n    if not words:\n        return False\n\n    last_word = words[-1]\n\n    return len(last_word) == 1 and last_word == last_char"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"\n    Finds the largest index where an element is less than its predecessor.\n    Returns -1 if no such element exists.\n    \"\"\"\n    result_index = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i - 1]:\n            result_index = i\n    return result_index"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    if not isinstance(n, int):\n        return False\n    return n % 2 == 0 and n >= 8"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    \"\"\"\n    max_negative = None\n    min_positive = None\n\n    # Ensure the input is iterable; this will naturally raise TypeError if not.\n    for x in lst:\n        # Exclude booleans (since bool is a subclass of int) and non-int types\n        if isinstance(x, bool) or not isinstance(x, int):\n            continue\n        if x == 0:\n            continue\n        if x < 0:\n            if max_negative is None or x > max_negative:\n                max_negative = x\n        else:  # x > 0\n            if min_positive is None or x < min_positive:\n                min_positive = x\n\n    return (max_negative, min_positive)"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluates if n can be written as the sum of exactly 4 positive even numbers.\n    This is true if n is even and n is at least 8.\"\"\"\n    return n % 2 == 0 and n >= 8"}
{"task_id": "HumanEval/137", "solution": "import decimal\n\ndef compare_one(a, b):\n    \"\"\"\n    Compares two numbers (int, float, or string representing real numbers)\n    and returns the larger in its original type, or None if equal.\n    Handles decimal point variations in strings.\n    \"\"\"\n    def _to_decimal(value):\n        \"\"\"Converts an input value to a decimal.Decimal, handling different types and string formats.\"\"\"\n        if isinstance(value, int):\n            return decimal.Decimal(value)\n        elif isinstance(value, float):\n            # Convert float via string to preserve decimal accuracy.\n            return decimal.Decimal(str(value))\n        elif isinstance(value, str):\n            s = value.strip().replace(',', '.')\n            if not s:\n                raise ValueError(\"Empty string after stripping whitespace and replacing commas.\")\n            try:\n                d = decimal.Decimal(s)\n            except decimal.InvalidOperation as e:\n                raise ValueError(f\"Could not parse string '{value}' to Decimal: {e}\")\n\n            # Raise an error if the string represents NaN or Infinity.\n            if d.is_nan() or d.is_infinite():\n                raise ValueError(f\"String '{value}' represents NaN or Infinity, which is not allowed.\")\n            return d\n        else:\n            raise TypeError(f\"Unsupported input type: {type(value)}. Expected int, float, or str.\")\n\n    da = _to_decimal(a)\n    db = _to_decimal(b)\n\n    if da == db:\n        return None\n    elif da > db:\n        return a\n    else:\n        return b"}
{"task_id": "HumanEval/137", "solution": "from decimal import Decimal\nimport math\n\ndef parse_to_decimal(x):\n    \"\"\"Parses various types to a Decimal for consistent comparison.\"\"\"\n    if isinstance(x, bool):\n        # Treat booleans as their integer equivalents.\n        x = int(x)\n    if isinstance(x, int):\n        return Decimal(x)\n    if isinstance(x, float):\n        # Check for non-finite floats before conversion.\n        if math.isnan(x) or math.isinf(x):\n            raise ValueError('non-finite float numbers are not supported')\n        # Convert float via its string representation to preserve precision.\n        return Decimal(str(x))\n    if isinstance(x, str):\n        s = x.strip()\n        s2 = s.replace(',', '.') # Normalize decimal separator.\n        try:\n            d = Decimal(s2)\n        except Exception as e:\n            # Catch parsing errors for invalid numeric strings.\n            raise ValueError(f'invalid numeric string: {x}') from e\n        # Check for non-finite results from string parsing.\n        if d.is_nan() or d.is_infinite():\n            raise ValueError('non-finite number from string is not supported')\n        return d\n    # Raise TypeError for unsupported input types.\n    raise TypeError(f'unsupported type for comparison: {type(x)}')\n\ndef compare_one(a, b):\n    \"\"\"\n    Compares two numbers (int, float, or string representing real numbers)\n    and returns the larger in its original type, or None if equal.\n    \"\"\"\n    da = parse_to_decimal(a)\n    db = parse_to_decimal(b)\n\n    if da == db:\n        return None\n    return a if da > db else b"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Replaces runs of 3+ spaces with '-' and single/double spaces with underscores.\n    Non-string inputs are coerced to str.\n    \"\"\"\n    import re\n    text = str(text)\n    step1 = re.sub(r' {3,}', '-', text)\n    result = step1.replace(' ', '_')\n    return result"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Calculates the product of factorials from 1! up to n!.\n    This is also known as the Brazilian factorial.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    total_product = 1\n    current_factorial = 1\n    for i in range(1, n + 1):\n        current_factorial *= i\n        total_product *= current_factorial\n    return total_product"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Calculates the Brazilian factorial of n, which is the product of factorials from 1! to n!.\n    n is an integer greater than 0.\n    \"\"\"\n    product = 1\n    current_factorial = 1\n    for i in range(1, n + 1):\n        current_factorial *= i\n        product *= current_factorial\n    return product"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Replaces single/double spaces with underscores.\n    Runs of three or more consecutive spaces are replaced by a single hyphen.\n    \"\"\"\n    result = []\n    space_count = 0\n    for char in text:\n        if char == ' ':\n            space_count += 1\n        else:\n            if space_count >= 3:\n                result.append('-')\n            elif space_count == 2:\n                result.append('__')\n            elif space_count == 1:\n                result.append('_')\n            space_count = 0\n            result.append(char)\n\n    # Handle any trailing spaces at the end of the string\n    if space_count >= 3:\n        result.append('-')\n    elif space_count == 2:\n        result.append('__')\n    elif space_count == 1:\n        result.append('_')\n\n    return \"\".join(result)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions\n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from\n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    \"\"\"\n\n    # 1. Digit limit: There must not be more than three digits (0-9)\n    digit_count = sum(1 for char in file_name if '0' <= char <= '9')\n    if digit_count > 3:\n        return 'No'\n\n    # 2. Single dot: The file_name must contain exactly one '.' character\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # 3. Split into name and ext\n    name_part, ext_part = file_name.split('.', 1)\n\n    # 4. Validate name part (before dot)\n    # Must be non-empty\n    if not name_part:\n        return 'No'\n\n    # Must start with an ASCII Latin letter (A-Z or a-z)\n    first_char = name_part[0]\n    if not ('a' <= first_char <= 'z' or 'A' <= first_char <= 'Z'):\n        return 'No'\n\n    # 5. Validate extension part (after dot)\n    allowed_extensions = {'txt', 'exe', 'dll'}\n    if ext_part not in allowed_extensions:\n        return 'No'\n\n    # If all checks pass\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    This function processes a list of integers based on their index and returns the sum.\n    It squares entries at indices multiple of 3, cubes entries at indices multiple of 4 but not 3, and keeps others unchanged.\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += num ** 2\n        elif i % 4 == 0:  # This implies i % 3 != 0 due to the `if` condition\n            total_sum += num ** 3\n        else:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Returns a string containing words whose lengths are prime numbers, maintaining original order.\n    A helper function `is_prime` is defined internally to check for primality.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a given number is prime.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split()\n    prime_length_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n    \"\"\"\n    total = 0\n    for i, v in enumerate(lst):\n        transformed_value = v\n        if i % 3 == 0:\n            transformed_value = v * v\n        elif i % 4 == 0:\n            transformed_value = v * v * v\n        total += transformed_value\n    return total"}
{"task_id": "HumanEval/144", "solution": "import math\n\ndef simplify(x, n):\n    \"\"\"Checks if the product of two fractions x and n is a whole number.\n    Inputs x and n are strings in \"numerator/denominator\" format.\"\"\"\n    x_num, x_den = map(int, x.split('/'))\n    n_num, n_den = map(int, n.split('/'))\n\n    # Cross-cancel common factors to avoid large intermediate values\n    g1 = math.gcd(x_num, n_den)\n    x_num //= g1\n    n_den //= g1\n\n    g2 = math.gcd(n_num, x_den)\n    n_num //= g2\n    x_den //= g2\n\n    final_num = x_num * n_num\n    final_den = x_den * n_den\n\n    return final_num % final_den == 0"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Returns words from the input sentence whose lengths are prime numbers,\n    preserving original order and separated by single spaces.\n    \"\"\"\n    def is_prime(n):\n        \"\"\"Checks if a number n is prime.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split()\n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n\n    return ' '.join(filtered_words)"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Checks if the product of two fraction strings is a whole number.\n    Returns True if x * n evaluates to a whole number, False otherwise.\n    \"\"\"\n\n    def _gcd(a, b):\n        \"\"\"Calculates the greatest common divisor of two non-negative integers.\"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\n    # Parse the first fraction x\n    num_x_str, den_x_str = x.split('/')\n    num_x = int(num_x_str)\n    den_x = int(den_x_str)\n\n    # Parse the second fraction n\n    num_n_str, den_n_str = n.split('/')\n    num_n = int(num_n_str)\n    den_n = int(den_n_str)\n\n    # Calculate the numerator and denominator of the product\n    product_num = num_x * num_n\n    product_den = den_x * den_n\n\n    # Simplify the product fraction using GCD\n    common_divisor = _gcd(product_num, product_den)\n    simplified_den = product_den // common_divisor\n\n    # If the simplified denominator is 1, the product is a whole number\n    return simplified_den == 1"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Counts numbers greater than 10 where both their first and last digits are odd.\n    Handles negative numbers correctly for digit extraction.\n    \"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            s_num = str(num)\n            # Determine the first digit, skipping the '-' for negative numbers\n            first_digit_char = s_num[1] if s_num[0] == '-' else s_num[0]\n            last_digit_char = s_num[-1]\n\n            # If the string representation contains non-digit characters (e.g., floats),\n            # find the first/last digit characters explicitly\n            if not first_digit_char.isdigit():\n                for ch in s_num:\n                    if ch.isdigit():\n                        first_digit_char = ch\n                        break\n            if not last_digit_char.isdigit():\n                for ch in reversed(s_num):\n                    if ch.isdigit():\n                        last_digit_char = ch\n                        break\n\n            first_digit = int(first_digit_char)\n            last_digit = int(last_digit_char)\n\n            if first_digit % 2 != 0 and last_digit % 2 != 0:\n                count += 1\n    return count"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits.\n    Ties are broken by preserving the original relative order.\n    \"\"\"\n\n    def sum_digits(n):\n        \"\"\"Calculates the sum of digits for the absolute value of n.\n        Handles zero correctly.\"\"\"\n        n = abs(n)\n        s = 0\n        if n == 0:\n            return 0\n        while n > 0:\n            s += n % 10\n            n //= 10\n        return s\n\n    return sorted(nums, key=sum_digits)"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Count elements in nums that are greater than 10 and have both their\n    first and last digits odd (1, 3, 5, 7, 9).\n\n    Non-integer numeric values are ignored (except floats that are exact integers,\n    e.g., 15.0). Non-numeric items are ignored.\n    \"\"\"\n    count = 0\n    odd_digits = {1, 3, 5, 7, 9}\n\n    for val in nums:\n        # Accept ints and floats that are whole numbers\n        if isinstance(val, bool):\n            # bool is subclass of int; skip to avoid counting True/False\n            continue\n        if isinstance(val, (int, float)):\n            if isinstance(val, float) and not val.is_integer():\n                continue\n            n = int(val)\n        else:\n            continue\n\n        if n <= 10:\n            continue\n\n        m = abs(n)\n        last = m % 10\n\n        # extract first digit using integer division\n        first = m\n        while first >= 10:\n            first //= 10\n\n        if first in odd_digits and last in odd_digits:\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sort a list of integers in ascending order by the sum of their digits.\n    Preserve original relative order for items with equal digit-sum (stable sort).\n    \"\"\"\n    def sum_digits(n):\n        return sum(int(d) for d in str(abs(n)))\n\n    return sorted(nums, key=sum_digits)"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (i < j < k) such that a[i] + a[j] + a[k] is divisible by 3.\n    Values a[i] are defined as i*i - i + 1.\n    \"\"\"\n    def _combinations_3(x):\n        \"\"\"Calculates C(x, 3). Returns 0 if x is less than 3.\"\"\"\n        if x < 3:\n            return 0\n        return x * (x - 1) * (x - 2) // 6\n\n    # Count indices i where a[i] % 3 == 0. This occurs when i % 3 == 2.\n    c0 = (n + 1) // 3\n    # Count indices i where a[i] % 3 == 1. This occurs when i % 3 == 0 or i % 3 == 1.\n    c1 = n - c0\n\n    # The sum of three values is divisible by 3 if their residues modulo 3 sum to 0.\n    # Given a[i] % 3 can only be 0 or 1, the only valid combinations are (0,0,0) or (1,1,1).\n    return _combinations_3(c0) + _combinations_3(c1)"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) with i < j < k where\n    a[i] = i*i - i + 1 and (a[i] + a[j] + a[k]) is divisible by 3.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    # count of indices i (1-based) with a[i] % 3 == 0 occurs when i % 3 == 2\n    count_mod_0 = n // 3 + (1 if n % 3 >= 2 else 0)\n    count_mod_1 = n - count_mod_0\n\n    def comb3(x):\n        return x * (x - 1) * (x - 2) // 6 if x >= 3 else 0\n\n    # valid triples are either (0,0,0) or (1,1,1)\n    return comb3(count_mod_0) + comb3(count_mod_1)"}
