{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    result = []\n    current_group_chars = []\n    balance = 0\n\n    for char in paren_string:\n        if char == ' ':\n            continue\n\n        current_group_chars.append(char)\n\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        if balance == 0 and current_group_chars:\n            result.append(\"\".join(current_group_chars))\n            current_group_chars = []\n\n    return result"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those groups into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    cleaned_string = \"\".join(char for char in paren_string if char == '(' or char == ')')\n\n    result = []\n    current_group_chars = []\n    depth = 0\n\n    for char in cleaned_string:\n        if char == '(':\n            current_group_chars.append('(')\n            depth += 1\n        elif char == ')':\n            current_group_chars.append(')')\n            depth -= 1\n            if depth < 0:\n                raise ValueError('unbalanced')\n            if depth == 0:\n                result.append(\"\".join(current_group_chars))\n                current_group_chars = []\n\n    if depth != 0:\n        raise ValueError('unbalanced')\n\n    return result"}
{"task_id": "HumanEval/3", "solution": "from typing import List\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/3", "solution": "from typing import List\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"Detects if a bank account balance, starting at zero, ever falls below zero.\n    Returns True at the first moment balance becomes negative, otherwise False.\"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, any two numbers are closer to each other than\n    the given threshold.\n\n    Behavior and validations:\n    - threshold must be a finite, non-negative number (ValueError otherwise).\n    - NaN values in `numbers` are rejected (ValueError).\n    - For threshold == 0.0, the function returns True if there are any duplicate values.\n    - Uses sorting to achieve O(n log n) time and O(n) additional space.\n\n    Examples:\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    import math\n\n    # Validate threshold\n    if not isinstance(threshold, (int, float)):\n        raise TypeError(\"threshold must be a numeric type\")\n    if math.isnan(threshold) or not math.isfinite(threshold):\n        raise ValueError(\"threshold must be a finite number\")\n    if threshold < 0:\n        raise ValueError(\"threshold must be non-negative\")\n\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    # Validate numbers: reject NaN\n    for x in numbers:\n        # allow ints and floats; only floats can be NaN/inf in typical usage\n        if isinstance(x, float) and math.isnan(x):\n            raise ValueError(\"numbers must not contain NaN\")\n\n    # Fast path for threshold == 0: check duplicates\n    if threshold == 0.0:\n        seen = set()\n        for x in numbers:\n            if x in seen:\n                return True\n            seen.add(x)\n        return False\n\n    # Sort and check adjacent differences (O(n log n))\n    sorted_nums = sorted(numbers)\n    prev = sorted_nums[0]\n    for curr in sorted_nums[1:]:\n        # equality covers cases like +inf == +inf, -0.0 == 0.0, etc.\n        if prev == curr:\n            return True\n        # sorted ensures curr >= prev for comparable numbers; difference is non-negative\n        diff = curr - prev\n        # diff may be NaN in pathological cases; treat NaN as not < threshold\n        if isinstance(diff, float) and math.isnan(diff):\n            # fallback: compute absolute difference via abs (handles many cases)\n            try:\n                diff = abs(curr - prev)\n            except Exception:\n                diff = float(\"inf\")\n        if diff < threshold:\n            return True\n        prev = curr\n\n    return False"}
{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    import math\n\n    if not isinstance(number, (int, float)):\n        raise TypeError(\"number must be an int or float\")\n    if not math.isfinite(number):\n        raise ValueError(\"number must be a finite value\")\n    if number < 0:\n        raise ValueError(\"number must be non-negative\")\n\n    return number - math.floor(number)"}
{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers`\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    n = len(numbers)\n    if n == 0:\n        return []\n    if n == 1:\n        return numbers.copy()\n    result = [0] * (2 * n - 1)\n    for i, num in enumerate(numbers):\n        result[2 * i] = num\n        if i < n - 1:\n            result[2 * i + 1] = delimeter\n    return result"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n\n    Mean Absolute Deviation is the average absolute difference between each\n    element and the mean:\n    MAD = average | x - x_mean |\n\n    Parameters\n    ----------\n    numbers:\n        An iterable of numeric values.\n\n    Returns\n    -------\n    float\n        The mean absolute deviation.\n\n    Raises\n    ------\n    ValueError\n        If `numbers` is empty.\n    TypeError\n        If `numbers` is not iterable or contains non-numeric values.\n\n    Examples\n    --------\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    # Ensure iterable and materialize to list for multiple passes\n    try:\n        nums = list(numbers)\n    except TypeError:\n        raise TypeError(\"numbers must be an iterable of numeric values\")\n\n    if len(nums) == 0:\n        raise ValueError(\"numbers must contain at least one value\")\n\n    # Validate/convert elements to float\n    converted = []\n    for i, x in enumerate(nums):\n        try:\n            converted.append(float(x))\n        except (TypeError, ValueError):\n            raise TypeError(f\"Element at index {i} is not a numeric value: {x!r}\")\n\n    # Use math.fsum for better floating-point precision\n    import math\n    mean_val = math.fsum(converted) / len(converted)\n    abs_devs = [abs(x - mean_val) for x in converted]\n    mad = math.fsum(abs_devs) / len(converted)\n    return mad"}
{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers, threshold):\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold (strictly less than threshold).\n\n    Behavior:\n    - Returns True if there exist i != j such that abs(numbers[i] - numbers[j]) < threshold.\n    - Returns False for empty lists or single-element lists.\n    - If threshold <= 0 returns False (no non-negative distance is < = 0; strict <).\n    - Raises TypeError if threshold or any element of numbers is not numeric.\n    - Raises ValueError if threshold or any element of numbers is NaN or threshold is infinite.\n\n    Examples:\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    import math\n\n    # Validate threshold\n    if not isinstance(threshold, (int, float)):\n        raise TypeError(\"threshold must be a numeric type\")\n    if math.isnan(threshold):\n        raise ValueError(\"threshold must not be NaN\")\n    if not math.isfinite(threshold):\n        raise ValueError(\"threshold must be finite\")\n    if threshold <= 0:\n        return False\n\n    # Ensure numbers is iterable and make a local list copy (do not mutate caller's list)\n    try:\n        seq = list(numbers)\n    except TypeError:\n        raise TypeError(\"numbers must be an iterable of numeric values\")\n\n    if len(seq) < 2:\n        return False\n\n    # Validate elements (disallow NaN; infinities are allowed but behave naturally)\n    for x in seq:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"all elements of numbers must be numeric\")\n        if math.isnan(x):\n            raise ValueError(\"numbers must not contain NaN\")\n\n    # Sort and check adjacent differences (O(n log n) time, O(n) additional space for the copy)\n    seq.sort()\n    for a, b in zip(seq, seq[1:]):\n        if (b - a) < threshold:\n            return True\n\n    return False"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n    result: List[int] = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n\n    MAD = average | x - x_mean |\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"numbers must contain at least one element\")\n\n    n = len(numbers)\n    mean = sum(numbers) / n\n    return sum(abs(x - mean) for x in numbers) / n"}
{"task_id": "HumanEval/7", "solution": "from typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\"Filter an input list of strings, keeping only those that contain the given substring.\n    None values and non-string elements in the list are skipped.\n    \"\"\"\n    return [s for s in strings if isinstance(s, str) and substring in s]"}
{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Input: a string containing space-separated groups of parentheses.\n    Output: list of integers where each integer is the maximum nesting depth\n            for the corresponding group.\n\n    Examples:\n        parse_nested_parens('(()()) ((())) () ((())()())') -> [2, 3, 1, 3]\n\n    Raises:\n        TypeError: if paren_string is not a string.\n        ValueError: on unbalanced parentheses or invalid characters.\n    \"\"\"\n    if not isinstance(paren_string, str):\n        raise TypeError(\"paren_string must be a string\")\n\n    # Handle empty or whitespace-only input\n    if not paren_string.strip():\n        return []\n\n    result: List[int] = []\n    groups = paren_string.split()  # split on any whitespace\n\n    for group_index, group in enumerate(groups, start=1):\n        current_depth = 0\n        max_depth = 0\n\n        for pos, ch in enumerate(group):\n            if ch == \"(\":\n                current_depth += 1\n                if current_depth > max_depth:\n                    max_depth = current_depth\n            elif ch == \")\":\n                current_depth -= 1\n                if current_depth < 0:\n                    raise ValueError(\n                        f\"Unbalanced parentheses in group {group_index}: \"\n                        f\"too many ')' at position {pos} in '{group}'\"\n                    )\n            else:\n                raise ValueError(\n                    f\"Invalid character '{ch}' in group {group_index} at position {pos}; \"\n                    \"only '(' and ')' are allowed\"\n                )\n\n        if current_depth != 0:\n            raise ValueError(\n                f\"Unbalanced parentheses in group {group_index}: \"\n                f\"mismatched '(' in '{group}'\"\n            )\n\n        result.append(max_depth)\n\n    return result"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n    return total_sum, total_product"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"Calculates the sum and product of a list of integers.\n    Handles an empty list by returning sum 0 and product 1.\"\"\"\n    total_sum = 0\n    total_product = 1\n\n    for number in numbers:\n        total_sum += number\n        total_product *= number\n\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/9", "solution": "from typing import List\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    result = []\n    current_max = float('-inf')  # Initialize with negative infinity to ensure the first number becomes the max.\n\n    for num in numbers:\n        current_max = max(current_max, num)  # Update current_max with the maximum seen so far.\n        result.append(current_max)  # Add the current rolling maximum to the result list.\n\n    return result"}
{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\"Filter an input list of strings, returning only those that contain the given substring.\n\n    Non-string elements in `strings` are ignored. If `strings` is None it is treated as an empty list.\n    If `substring` is not a str a TypeError is raised.\n\n    Examples\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    if not isinstance(substring, str):\n        raise TypeError(\"substring must be a str\")\n    if strings is None:\n        return []\n    return [s for s in strings if isinstance(s, str) and substring in s]"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    current_max = numbers[0]\n    result.append(current_max)\n\n    for x in numbers[1:]:\n        current_max = max(current_max, x)\n        result.append(current_max)\n\n    return result"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Find the longest palindromic suffix and append the reverse of the remaining prefix.\n    \"\"\"\n    if not string:\n        return \"\"\n\n    n = len(string)\n\n    # Find the length of the longest palindromic suffix\n    # Iterate from the full string down to a single character (or empty)\n    for i in range(n):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            # The current suffix is palindromic; since we iterate from left to right,\n            # string[i:] is the longest such suffix starting at or after index i.\n            # The part before it is string[:i].\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]\n\n    # This case should ideally not be reached if an empty string is handled or a single char is always a palindrome.\n    # If the loop finishes without finding any suffix (which implies the entire string is not palindrome\n    # and even single characters are not considered, which is incorrect),\n    # it implies the whole string needs reversal of its prefix.\n    # However, for a non-empty string, at least the last character will be a palindrome.\n    # So the loop will always find a suffix.\n    return string # Should not be reached based on the algorithm, but as a fallback."}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\"Find the shortest palindrome that begins with the supplied string.\n\n    Algorithm:\n    - Find the longest suffix of `string` that is a palindrome.\n    - Append to the end the reverse of the prefix that comes before that palindromic suffix.\n\n    Examples:\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    n = len(string)\n    # For each starting position i, check if string[i:] is a palindrome.\n    # The first (smallest i) palindromic suffix found is the longest suffix palindrome.\n    for i in range(n):\n        suffix = string[i:]\n        if suffix == suffix[::-1]:\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]\n    # If string is empty, or in the extremely unlikely case no suffix is found,\n    # return the original string (for empty string this returns \"\").\n    return string"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\"Performs binary XOR on two string inputs consisting of '0's and '1's.\n    Pads the shorter string on the left with '0's. Raises ValueError on invalid characters.\n    \"\"\"\n    if not all(ch in \"01\" for ch in a) or not all(ch in \"01\" for ch in b):\n        raise ValueError(\"Input strings must contain only '0' or '1' characters.\")\n\n    max_len = max(len(a), len(b))\n    pa = a.zfill(max_len)\n    pb = b.zfill(max_len)\n\n    return \"\".join(\"1\" if pa[i] != pb[i] else \"0\" for i in range(max_len))"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\"Perform bitwise XOR on two equal-length binary strings composed of '0' and '1'.\n\n    Args:\n        a: First binary string.\n        b: Second binary string.\n\n    Returns:\n        A binary string representing the bitwise XOR of a and b.\n\n    Raises:\n        TypeError: If inputs are not strings.\n        ValueError: If inputs have different lengths or contain characters other than '0' or '1'.\n\n    Example:\n        >>> string_xor('010', '110')\n        '100'\n    \"\"\"\n    if not isinstance(a, str) or not isinstance(b, str):\n        raise TypeError(\"Inputs must be strings\")\n\n    if len(a) != len(b):\n        raise ValueError(\"Inputs must have the same length\")\n\n    if not all(ch in \"01\" for ch in a):\n        raise ValueError(\"First input contains invalid characters; only '0' and '1' allowed\")\n    if not all(ch in \"01\" for ch in b):\n        raise ValueError(\"Second input contains invalid characters; only '0' and '1' allowed\")\n\n    return \"\".join(\"1\" if x != y else \"0\" for x, y in zip(a, b))"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_so_far = strings[0]\n    for s in strings[1:]:\n        if len(s) > len(longest_so_far):\n            longest_so_far = s\n    return longest_so_far"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"Return a greatest common divisor of two integers a and b using the Euclidean algorithm.\n    It handles zero and negative inputs by taking absolute values.\n    \"\"\"\n    a_val = abs(a)\n    b_val = abs(b)\n    while b_val:\n        a_val, b_val = b_val, a_val % b_val\n    return a_val"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"Return a greatest common divisor of two integers a and b.\n    Uses the iterative Euclidean algorithm with absolute values.\n    \"\"\"\n    a, b = abs(a), abs(b)\n\n    if a == 0 and b == 0:\n        return 0\n\n    while b != 0:\n        a, b = b, a % b\n\n    return a"}
{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\"Return a string containing space-delimited numbers starting from 0 up to n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    return ' '.join(str(i) for i in range(n + 1))"}
{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\"Given a string, find out how many distinct characters (regardless of case) it consists of.\"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"string must be of type str\")\n    return len({char.casefold() for char in string})"}
{"task_id": "HumanEval/14", "solution": "def all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string.\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    prefixes = []\n    for i in range(1, len(string) + 1):\n        prefixes.append(string[:i])\n    return prefixes"}
