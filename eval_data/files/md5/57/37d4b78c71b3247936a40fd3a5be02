{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    Preserves sign for negative x. Raises ValueError for negative shift.\n    Examples:\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    >>> circular_shift(-123, 1)\n    \"-312\"\n    >>> circular_shift(123, 5)\n    \"321\"\n    \"\"\"\n    if not isinstance(shift, int):\n        raise TypeError(\"shift must be an integer\")\n    if shift < 0:\n        raise ValueError(\"shift must be non-negative\")\n\n    # Handle sign and work with absolute digits\n    sign = \"-\" if isinstance(x, int) and x < 0 else \"\"\n    s = str(abs(int(x)))\n    n = len(s)\n\n    # If shift strictly greater than number of digits, return digits reversed\n    if shift > n:\n        return sign + s[::-1]\n\n    # Effective right shift (shift == n leaves string unchanged)\n    effective_shift = shift % n if n else 0\n    if effective_shift == 0:\n        return sign + s\n\n    return sign + s[-effective_shift:] + s[:-effective_shift]"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII codes for all uppercase characters in a string.\n    It iterates through the string, adding the ASCII value of each uppercase letter to a running total.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits given a string of apples and oranges\n    and the total number of fruits.\n    \"\"\"\n    parts = s.split(\" apples and \")\n    apples_str = parts[0]\n    oranges_str_part = parts[1]\n\n    oranges_str_parts = oranges_str_part.split(\" oranges\")\n    oranges_str = oranges_str_parts[0]\n\n    apples = int(apples_str)\n    oranges = int(oranges_str)\n\n    mangoes = n - apples - oranges\n    return mangoes"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even-valued node and its index in an array.\n    Returns [smallest_even_value, index] or [] if none found or array is empty.\n    \"\"\"\n    if not arr:\n        return []\n\n    min_val = None\n    min_idx = None\n\n    for i, val in enumerate(arr):\n        if val % 2 == 0:  # Check if the value is even\n            if min_val is None or val < min_val:\n                min_val = val\n                min_idx = i\n\n    if min_val is None:\n        return []\n    else:\n        return [min_val, min_idx]"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    \"\"\"\n    Returns the greatest positive integer whose frequency in the list is greater than or equal to its value.\n    If no such integer exists, returns -1.\n    \"\"\"\n    freq_map = {}\n    for num in lst:\n        freq_map[num] = freq_map.get(num, 0) + 1\n\n    # Sort unique numbers in descending order to find the greatest eligible number first.\n    unique_numbers_desc = sorted(freq_map.keys(), reverse=True)\n\n    for num in unique_numbers_desc:\n        if freq_map[num] >= num:\n            return num\n\n    return -1"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even non-negative integer and its index in the array.\n    Returns [value, index] or [] if no even numbers or array is empty.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    # Iterate through the array to find the smallest even value and its first occurrence index.\n    for i, num in enumerate(arr):\n        if num % 2 == 0:\n            if num < smallest_even_value:\n                smallest_even_value = num\n                smallest_even_index = i\n\n    # If no even numbers were found, return an empty list.\n    if smallest_even_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Given list of integers, return list in strange order:\n    minimum, then maximum of the remaining, then next minimum, etc.\n    \"\"\"\n    if not lst:\n        return []\n\n    sorted_lst = sorted(lst)\n    result = []\n    left, right = 0, len(sorted_lst) - 1\n\n    while left <= right:\n        result.append(sorted_lst[left])\n        left += 1\n        if left <= right:\n            result.append(sorted_lst[right])\n            right -= 1\n\n    return result"}
{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s, n):\n    \"\"\"\n    Parse a string s describing apples and oranges (e.g. \"5 apples and 6 oranges\")\n    and return the number of mangoes as: mangoes = n - apples - oranges.\n    \"\"\"\n    import re\n\n    if not isinstance(n, int) or isinstance(n, bool):\n        raise TypeError(\"n must be an int\")\n\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a str\")\n\n    # Try to find numbers directly associated with the words 'apples' and 'oranges'\n    apple_match = re.search(r\"(-?\\d+)\\s*apples?\\b\", s, re.I)\n    orange_match = re.search(r\"(-?\\d+)\\s*oranges?\\b\", s, re.I)\n\n    if apple_match and orange_match:\n        apples = int(apple_match.group(1))\n        oranges = int(orange_match.group(1))\n    else:\n        # Fallback: extract the first two integers found in the string\n        nums = re.findall(r\"-?\\d+\", s)\n        if len(nums) < 2:\n            raise ValueError(\"Could not parse counts for apples and oranges from the string\")\n        apples = int(nums[0])\n        oranges = int(nums[1])\n\n    return n - apples - oranges"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q, w):\n    '''\n    Checks if object q will fly: it must be a palindromic list (balanced) and its sum of elements must not exceed maximum weight w.\n    Returns True if both conditions are met, False otherwise.\n    '''\n    is_balanced = (q == q[::-1])\n    weight_is_ok = (sum(q) <= w)\n    return is_balanced and weight_is_ok"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    # Convert the input iterable q to a list for palindrome checking and summing.\n    # Returns True if q is a palindrome and its sum is less than or equal to w.\n    q_list = list(q)\n\n    # Check if the sequence is palindromic.\n    if q_list != q_list[::-1]:\n        return False\n\n    # Calculate the total weight of the elements.\n    total_weight = sum(q_list)\n\n    # Return True if the total weight is within the limit, False otherwise.\n    return total_weight <= w"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum changes needed to make an array palindromic.\n    It counts mismatches between elements at symmetric positions from array ends.\n    \"\"\"\n    n = len(arr)\n    changes_count = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes_count += 1\n    return changes_count"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"Given list of integers, return list in strange order:\n    minimum, then maximum of remaining, then minimum, etc.\n    \"\"\"\n    sorted_lst = sorted(lst)\n    result = []\n    left, right = 0, len(sorted_lst) - 1\n    is_min_turn = True\n\n    while left <= right:\n        if is_min_turn:\n            result.append(sorted_lst[left])\n            left += 1\n        else:\n            result.append(sorted_lst[right])\n            right -= 1\n        is_min_turn = not is_min_turn\n\n    return result"}
{"task_id": "HumanEval/71", "solution": "def triangle_area(a, b, c):\n    import math\n    # Coerce inputs to float, return -1 for invalid types\n    try:\n        a = float(a)\n        b = float(b)\n        c = float(c)\n    except (TypeError, ValueError):\n        return -1.0\n\n    # Non-positive sides are invalid\n    if a <= 0 or b <= 0 or c <= 0:\n        return -1.0\n\n    # Triangle inequality with a small tolerance for floating-point errors\n    eps = 1e-12\n    if (a + b) <= c + eps or (a + c) <= b + eps or (b + c) <= a + eps:\n        return -1.0\n\n    s = (a + b + c) / 2.0\n    area_sq = s * (s - a) * (s - b) * (s - c)\n\n    # Guard against tiny negative values from floating-point arithmetic\n    if area_sq < 0 and abs(area_sq) < 1e-12:\n        area_sq = 0.0\n    if area_sq < 0:\n        return -1.0\n\n    area = math.sqrt(area_sq)\n    return round(area, 2)"}
