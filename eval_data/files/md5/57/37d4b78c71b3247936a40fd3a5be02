{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if not isinstance(x, int) or not isinstance(base, int):\n        raise TypeError(\"Both x and base must be integers.\")\n    if base < 2 or base >= 10:\n        raise ValueError(\"base must be an integer between 2 and 9 inclusive.\")\n\n    if x == 0:\n        return '0'\n\n    is_negative = x < 0\n    n = abs(x)\n    digits = []\n    while n > 0:\n        digits.append(str(n % base))\n        n //= base\n\n    result = ''.join(reversed(digits))\n    return '-' + result if is_negative else result"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list\")\n    if len(l) == 0:\n        raise ValueError(\"median() arg is an empty list\")\n    # Ensure elements are numeric\n    try:\n        sorted_list = sorted(l)\n    except TypeError:\n        raise TypeError(\"All elements must be comparable and numeric\")\n    n = len(sorted_list)\n    mid = n // 2\n    if n % 2 == 1:\n        return sorted_list[mid]\n    else:\n        return (sorted_list[mid - 1] + sorted_list[mid]) / 2"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if not isinstance(x, int) or not isinstance(base, int):\n        raise TypeError(\"x and base must be integers\")\n    if base < 2 or base >= 10:\n        raise ValueError(\"base must be >= 2 and < 10\")\n    if x < 0:\n        raise ValueError(\"x must be non-negative\")\n\n    if x == 0:\n        return \"0\"\n\n    digits = []\n    while x > 0:\n        digits.append(str(x % base))\n        x //= base\n    return ''.join(reversed(digits))"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence.\n    Computes the n-th element efficiently without recursion.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize a, b, c, d to represent fib4(0), fib4(1), fib4(2), fib4(3) respectively\n    a, b, c, d = 0, 0, 2, 0\n\n    # Iterate from n=4 up to the desired n\n    for _ in range(4, n + 1):\n        e = d + c + b + a\n        # Shift the values: new_a is old_b, new_b is old_c, new_c is old_d, new_d is e\n        a, b, c, d = b, c, d, e\n\n    return d"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    >>> median([1])\n    1\n    >>> median([1.0, 2.0])\n    1.5\n    >>> median([1, 2])\n    1.5\n    >>> median([1, 2, 3, 4])\n    2.5\n    \"\"\"\n    sorted_list = sorted(l)\n    n = len(sorted_list)\n    if n == 0:\n        raise ValueError(\"median requires at least one data point\")\n    mid = n // 2\n\n    if n % 2 == 1:  # If odd length, return the middle element.\n        return sorted_list[mid]\n    else:  # Otherwise (even length), return the average of the two middle elements.\n        return (sorted_list[mid - 1] + sorted_list[mid]) / 2"}
{"task_id": "HumanEval/51", "solution": "def remove_vowels(text):\n    \"\"\"\n    remove_vowels is a function that takes string and returns string without vowels.\n    >>> remove_vowels('')\n    ''\n    >>> remove_vowels(\"abcdef\\nghijklm\")\n    'bcdf\\nghjklm'\n    >>> remove_vowels('abcdef')\n    'bcdf'\n    >>> remove_vowels('aaaaa')\n    ''\n    >>> remove_vowels('aaBAA')\n    'B'\n    >>> remove_vowels('zbcd')\n    'zbcd'\n    \"\"\"\n    vowels = set(\"aeiouAEIOU\")\n    return \"\".join(ch for ch in text if ch not in vowels)"}
