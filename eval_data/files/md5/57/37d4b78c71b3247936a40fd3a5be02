{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        n = -n\n\n    product = 1\n    found_odd = False\n\n    if n == 0:\n        return 0\n\n    while n:\n        digit = n % 10\n        if digit % 2 == 1:\n            product *= digit\n            found_odd = True\n        n //= 10\n\n    return product if found_odd else 0"}
{"task_id": "HumanEval/133", "solution": "def sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    \"\"\"\n    import math\n    total = 0\n    for num in lst:\n        ceiled = math.ceil(num)\n        total += ceiled * ceiled\n    return total"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    Returns planets strictly between planet1 and planet2, ordered by proximity to the Sun.\n    Returns an empty tuple if inputs are invalid or no planets are between them.\n    '''\n    PLANETS = ['Mercury', 'Venus', 'Earth', 'Mars', 'Jupiter', 'Saturn', 'Uranus', 'Neptune']\n\n    if planet1 not in PLANETS or planet2 not in PLANETS:\n        return ()\n\n    i1 = PLANETS.index(planet1)\n    i2 = PLANETS.index(planet2)\n\n    if i1 == i2:\n        return ()\n\n    low = min(i1, i2)\n    high = max(i1, i2)\n\n    return tuple(PLANETS[low + 1 : high])"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    \"\"\"\n    Returns planets between planet1 and planet2, ordered by proximity to the Sun.\n    Returns an empty tuple if inputs are invalid or no planets are between them.\n    \"\"\"\n    planets = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n\n    if planet1 not in planets or planet2 not in planets:\n        return ()\n\n    i = planets.index(planet1)\n    j = planets.index(planet2)\n\n    if i == j:\n        return ()\n\n    lower = min(i, j)\n    upper = max(i, j)\n\n    if upper - lower <= 1:\n        return ()\n\n    between = planets[lower + 1 : upper]\n    return tuple(between)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Return the word with the maximum number of unique characters from the input list.\n    If multiple words tie for the maximum unique-character count, return the lexicographically smallest one.\n    For an empty input list, return an empty string.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    best_word = \"\"\n    max_unique_count = -1\n\n    for word in words:\n        if not isinstance(word, str):\n            raise TypeError(\"All items in 'words' must be strings\")\n\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            best_word = word\n        elif current_unique_count == max_unique_count:\n            if word < best_word:\n                best_word = word\n\n    return best_word"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific criteria.\n    Returns 'Yes' for valid names, 'No' otherwise.\"\"\"\n\n    if file_name.count('.') != 1:\n        return 'No'\n\n    name_part, extension_part = file_name.split('.')\n\n    digit_count = sum(c.isdigit() for c in file_name)\n    if digit_count > 3:\n        return 'No'\n\n    if not name_part or not name_part[0].isalpha():\n        return 'No'\n\n    if extension_part not in ['txt', 'exe', 'dll']:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    Other characters remain unchanged.\n    \"\"\"\n    flipped_chars = []\n    for char in string:\n        if char.islower():\n            flipped_chars.append(char.upper())\n        elif char.isupper():\n            flipped_chars.append(char.lower())\n        else:\n            flipped_chars.append(char)\n    return \"\".join(flipped_chars)"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Computes carrots eaten by a rabbit to fulfill its need and remaining stock.\n    Returns [total_eaten, remaining_after] based on available carrots.\n    \"\"\"\n    eat_amount = min(need, remaining)\n    total_eaten = number + eat_amount\n    remaining_after = remaining - eat_amount\n    return [total_eaten, remaining_after]"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str) -> bool:\n    \"\"\"\n    Checks if the given string is a palindrome by comparing it to its reverse.\n    This handles empty strings, single characters, and multi-character strings correctly.\n    \"\"\"\n    return text == text[::-1]"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Checks if a list of non-negative integers is sorted non-decreasingly.\n    Returns False if any integer occurs more than twice consecutively.\n    '''\n    if len(lst) <= 1:\n        return True\n\n    prev = lst[0]\n    count = 1\n\n    for x in lst[1:]:\n        if x < prev:\n            return False\n        elif x == prev:\n            count += 1\n            if count > 2:\n                return False\n        else: # x > prev\n            count = 1\n            prev = x\n\n    return True"}
