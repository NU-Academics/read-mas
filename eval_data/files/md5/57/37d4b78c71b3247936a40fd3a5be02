{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function returns False for an empty dictionary or if any key is not a string.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lower = True\n    all_upper = True\n\n    for key in dict:\n        if not isinstance(key, str):\n            return False\n        if not key.islower():\n            all_lower = False\n        if not key.isupper():\n            all_upper = False\n        if not all_lower and not all_upper:\n            return False\n\n    return all_lower or all_upper"}
{"task_id": "HumanEval/100", "solution": "def make_a_pile(n):\n    \"\"\"\n    Given a positive integer n, returns a list of length n where:\n    - the first element is n,\n    - each subsequent element is the next odd number if the previous was odd,\n      or the next even number if the previous was even.\n    This is equivalent to adding 2 each level.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    pile = []\n    current = n\n    for _ in range(n):\n        pile.append(current)\n        current += 2\n    return pile"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    if not isinstance(n, int) or not isinstance(p, int):\n        raise TypeError(\"n and p must be integers\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if p <= 0:\n        raise ValueError(\"p must be a positive integer\")\n    # Use built-in modular exponentiation which is efficient and handles large integers\n    return pow(2, n, p)"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Filters numbers between 1 and 9, sorts them descending, then maps them to their English names.\n    Ignores numbers outside the 1-9 range and returns an empty list for empty input.\n    \"\"\"\n    digit_names = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    if not arr:\n        return []\n\n    # Filter numbers between 1 and 9\n    filtered_arr = [num for num in arr if isinstance(num, int) and 1 <= num <= 9]\n\n    # Sort the filtered numbers in ascending order and then reverse\n    filtered_arr.sort()\n    filtered_arr.reverse()\n\n    # Map each digit to its English name\n    return [digit_names[num] for num in filtered_arr]"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Write a function count_nums which takes an array of integers and returns\n    the number of elements which has a sum of digits > 0.\n    If a number is negative, then its first signed digit will be negative:\n    e.g. -123 has signed digits -1, 2, and 3.\n    >>> count_nums([]) == 0\n    >>> count_nums([-1, 11, -11]) == 1\n    >>> count_nums([1, 1, 2]) == 3\n    \"\"\"\n    def _sum_signed_digits(n: int) -> int:\n        s = str(n)\n        total = 0\n        if s[0] == '-':\n            # First digit after sign is negative\n            if len(s) > 1:\n                total -= int(s[1])\n            # Remaining digits are positive\n            for ch in s[2:]:\n                total += int(ch)\n        else:\n            for ch in s:\n                total += int(ch)\n        return total\n\n    count = 0\n    for num in arr:\n        if _sum_signed_digits(num) > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"Computes the rounded average of integers from n to m, then converts to binary.\n    If n is greater than m, it returns -1.\n    \"\"\"\n    if n > m:\n        return -1\n\n    # Average of consecutive integers from n to m is (n + m) / 2\n    average = (n + m) / 2\n    rounded_value = round(average)\n    return bin(rounded_value)"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, return the minimum sum of any non-empty contiguous subarray.\n    Raises ValueError if nums is empty.\n    \"\"\"\n    if not nums:\n        raise ValueError(\"nums must be a non-empty sequence of integers\")\n\n    current_min = global_min = nums[0]\n    for num in nums[1:]:\n        current_min = min(num, current_min + num)\n        global_min = min(global_min, current_min)\n\n    return global_min"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Checks if an array can be sorted by performing right shift operations.\n    Returns True if a sorted array can be obtained, False otherwise.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return True\n\n    descent_count = 0\n\n    # Count the number of descents (arr[i] > arr[i+1])\n    for i in range(n - 1):\n        if arr[i] > arr[i + 1]:\n            descent_count += 1\n\n    # An array is sortable by right shifts if it has 0 or 1 descent,\n    # and for a single descent, the wrap-around condition must hold.\n    if descent_count == 0:\n        return True\n    elif descent_count == 1:\n        # Check the wrap-around: last element should be <= first element\n        return arr[-1] <= arr[0]\n    else:\n        return False"}
{"task_id": "HumanEval/111", "solution": "from collections import Counter\n\ndef histogram(test):\n    \"\"\"Given a string representing a space separated lowercase letters, return a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\n    \"\"\"\n    tokens = test.strip().split()\n\n    if not tokens:\n        return {}\n\n    letter_counts = Counter(tokens)\n\n    max_count = 0\n    if letter_counts: # Ensure letter_counts is not empty before calling max\n        max_count = max(letter_counts.values())\n\n    result_dict = {}\n    for letter, count in letter_counts.items():\n        if count == max_count:\n            result_dict[letter] = count\n\n    return result_dict"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s,c):\n    \"\"\"Deletes characters from s present in c and checks if the resulting string is a palindrome.\n    Returns a tuple (result_string, is_palindrome).\n    \"\"\"\n    chars_to_delete = set(c)\n    result_string_list = []\n    for char_s in s:\n        if char_s not in chars_to_delete:\n            result_string_list.append(char_s)\n\n    result_string = \"\".join(result_string_list)\n    is_palindrome = (result_string == result_string[::-1])\n\n    return (result_string, is_palindrome)"}
