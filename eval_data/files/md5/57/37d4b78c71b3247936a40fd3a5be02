{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic. A palindromic array is an array that\n    is read the same backwards and forwards. In one change, you can change one element to any other element.\n    \"\"\"\n    changes = 0\n    left = 0\n    right = len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n\n    return changes"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef triangle_area(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle, return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1.\n    \"\"\"\n    # Attempt to convert inputs to floats\n    try:\n        a_f = float(a)\n        b_f = float(b)\n        c_f = float(c)\n    except (TypeError, ValueError):\n        return -1\n\n    # Check for finite, positive side lengths\n    if not (math.isfinite(a_f) and math.isfinite(b_f) and math.isfinite(c_f)):\n        return -1\n    if a_f <= 0 or b_f <= 0 or c_f <= 0:\n        return -1\n\n    # Triangle inequality: sum of any two sides must be greater than the third\n    if (a_f + b_f) <= c_f or (a_f + c_f) <= b_f or (b_f + c_f) <= a_f:\n        return -1\n\n    # Heron's formula\n    s = (a_f + b_f + c_f) / 2.0\n    area_sq = s * (s - a_f) * (s - b_f) * (s - c_f)\n\n    # Handle tiny negative values due to floating-point errors\n    EPS = 1e-12\n    if area_sq < 0:\n        if area_sq > -EPS:\n            area_sq = 0.0\n        else:\n            return -1\n\n    area = math.sqrt(area_sq)\n    return round(area, 2)"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    \"\"\"\n    Compares two lists of strings by their total character count and returns the list with fewer characters.\n    If counts are equal, the first list is returned.\n    \"\"\"\n    total_chars_lst1 = sum(len(s) for s in lst1)\n    total_chars_lst2 = sum(len(s) for s in lst2)\n    return lst1 if total_chars_lst1 <= total_chars_lst2 else lst2"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    def _get_prime_factors_count(n_val):\n        \"\"\"Helper to count all prime factors of n_val, with multiplicity.\"\"\"\n        count = 0\n        d = 2\n        temp_n = n_val\n        while d * d <= temp_n:\n            while temp_n % d == 0:\n                count += 1\n                temp_n //= d\n            d += 1\n        if temp_n > 1:\n            count += 1\n        return count\n\n    if a < 8:\n        return False\n\n    return _get_prime_factors_count(a) == 3"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Write a function that takes an integer a and returns True\n    if this ingeger is a cube of some integer number.\n    Note: you may assume the input is always valid.\n    Examples:\n    iscube(1) ==> True\n    iscube(2) ==> False\n    iscube(-1) ==> True\n    iscube(64) ==> True\n    iscube(0) ==> True\n    iscube(180) ==> False\n    '''\n    if a == 0:\n        return True\n\n    n = abs(a)\n    low = 0\n    high = n\n\n    while low <= high:\n        mid = (low + high) // 2\n        cube = mid * mid * mid\n\n        if cube == n:\n            return True\n        elif cube < n:\n            low = mid + 1\n        else:\n            high = mid - 1\n\n    return False"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Returns True if integer a is a perfect cube, otherwise False.\n    Uses integer binary search to avoid floating-point inaccuracies.\n    '''\n    if a == 0:\n        return True\n\n    n = abs(a)\n\n    # Find an upper bound for the cube root\n    hi = 1\n    # Doubling hi until hi^3 >= n quickly bounds the search for large n\n    while hi**3 < n:\n        hi = hi * 2\n\n    lo = hi // 2  # Start search from half the upper bound\n\n    # Binary search for k such that k^3 == n\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        # Use integer multiplication for mid^3 to avoid float errors\n        cube = mid * mid * mid\n\n        if cube == n:\n            return True\n        elif cube < n:\n            lo = mid + 1\n        else:  # cube > n\n            hi = mid - 1\n\n    return False"}
