{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n <= 1:\n        raise ValueError(\"n must be greater than 1\")\n\n    if n % 2 == 0:\n        return n // 2\n\n    d = 3\n    while d * d <= n:\n        if n % d == 0:\n            return n // d\n        d += 2\n    return 1"}
{"task_id": "HumanEval/26", "solution": "from typing import List\nfrom collections import Counter\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\"From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    \"\"\"\n    counts = Counter(numbers)\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n    return result"}
{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\"Finds the largest divisor of n that is smaller than n.\n    Returns 1 for n <= 1 or if n is prime.\n    \"\"\"\n    if n <= 1:\n        return 1\n\n    i = 2\n    while i * i <= n:\n        if n % i == 0:\n            return n // i\n        i += 1\n    return 1"}
{"task_id": "HumanEval/25", "solution": "from typing import List\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\"Return list of prime factors of given integer in non-decreasing order.\n    Each factor appears as many times as its multiplicity in the factorization.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"Prime factorization is defined for positive integers.\")\n    if n == 1:\n        return []\n\n    factors: List[int] = []\n\n    # Extract factors of 2\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Check odd divisors\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            factors.append(i)\n            n //= i\n        i += 2\n\n    # Remaining prime factor\n    if n > 1:\n        factors.append(n)\n\n    return factors"}
