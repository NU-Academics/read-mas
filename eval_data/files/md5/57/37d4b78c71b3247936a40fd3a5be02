{"task_id": "HumanEval/29", "solution": "def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n\n    Args:\n        strings: Iterable of strings (List[str] in the annotation).\n        prefix: Prefix to filter by.\n\n    Returns:\n        A new list containing only elements of `strings` that are instances of str\n        and start with `prefix`.\n\n    Raises:\n        TypeError: If `prefix` is not a str or `strings` is not iterable.\n    \"\"\"\n    if not isinstance(prefix, str):\n        raise TypeError(\"prefix must be a str\")\n\n    # Accept None as empty input for convenience\n    if strings is None:\n        return []\n\n    try:\n        iter(strings)\n    except TypeError:\n        raise TypeError(\"strings must be an iterable of strings\")\n\n    result: List[str] = []\n    for s in strings:\n        if not isinstance(s, str):\n            # Ignore non-string entries rather than raising to be tolerant\n            continue\n        if s.startswith(prefix):\n            result.append(s)\n    return result"}
{"task_id": "HumanEval/29", "solution": "from typing import List\n\ndef filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\"Filter an input list of strings only for ones that start with a given prefix.\"\"\"\n    if prefix == \"\":\n        return list(strings)\n    return [s for s in strings if s.startswith(prefix)]"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0:\n        return False\n    limit = int(n ** 0.5)\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return False\n    return True"}
{"task_id": "HumanEval/30", "solution": "import numbers\n\ndef get_positive(l: list):\n    \"\"\"Return only positive numbers from the list, excluding non-numeric types and booleans.\n    Preserves original order and duplicates.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    if l is None:\n        return []\n\n    return [x for x in l if isinstance(x, numbers.Real) and not isinstance(x, bool) and x > 0]"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    import math\n\n    if not isinstance(n, int):\n        return False\n    if n < 2:\n        return False\n    if n % 2 == 0:\n        return n == 2\n\n    limit = math.isqrt(n)\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return False\n    return True"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' where elements at indices divisible by three are sorted.\n    Other elements remain in their original positions.\n    \"\"\"\n    third_elements = []\n    third_indices = []\n    for i in range(len(l)):\n        if i % 3 == 0:\n            third_elements.append(l[i])\n            third_indices.append(i)\n\n    third_elements.sort()\n\n    result_list = list(l)\n    for i in range(len(third_indices)):\n        result_list[third_indices[i]] = third_elements[i]\n\n    return result_list"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"Return a new list where elements at indices divisible by three (0, 3, 6, ...)\n    are replaced by the sorted values of the original elements at those indices.\n    Other elements remain unchanged.\n    \"\"\"\n    result = list(l)  # copy to avoid mutating the input\n    # collect values at indices divisible by 3\n    values = [result[i] for i in range(0, len(result), 3)]\n    values.sort()\n    # place sorted values back into positions divisible by 3\n    vi = 0\n    for i in range(0, len(result), 3):\n        result[i] = values[vi]\n        vi += 1\n    return result"}
