{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n (n**k == x for k >= 0).\n    Handles type normalization and various edge cases as specified.\"\"\"\n\n    # 1. Input Normalization\n    # Convert floats representing integers to int, or return False for invalid types.\n    if isinstance(x, float):\n        if x.is_integer():\n            x = int(x)\n        else:\n            return False\n    elif not isinstance(x, int):\n        return False\n\n    if isinstance(n, float):\n        if n.is_integer():\n            n = int(n)\n        else:\n            return False\n    elif not isinstance(n, int):\n        return False\n\n    # Now x and n are guaranteed to be integers.\n\n    # 2. Edge Cases\n\n    # x == 1: returns True for k = 0 (n**0 = 1).\n    if x == 1:\n        return True\n\n    # n == 0: 0**0 = 1, 0**k = 0 for k > 0. Returns True iff x is 0 or 1.\n    if n == 0:\n        return x in {0, 1}\n\n    # x == 0: Only true when n == 0 (handled above). Otherwise, if n is not 0, it's False.\n    if x == 0:\n        return False\n\n    # n == 1: all powers equal 1. Returns True iff x == 1 (already covered, so this effectively implies False if x != 1).\n    if n == 1:\n        return x == 1\n\n    # n == -1: powers alternate between 1 and -1. Returns True iff x is 1 or -1.\n    if n == -1:\n        return x in {1, -1}\n\n    # 3. General case (|n| >= 2)\n    current = 1  # Represents n**k, starting with k = 0\n\n    # Loop while the absolute value of the current power is less than or equal to abs(x).\n    # This correctly handles both positive and negative x and n values.\n    while abs(current) <= abs(x):\n        if current == x:\n            return True\n        current *= n # Increment k by multiplying by n\n\n    # If the loop finishes without finding a match, x is not a power of n.\n    return False"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"You are given a string s.\n    Your task is to check if the string is happy or not.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct\n    For example:\n    is_happy(a) => False\n    is_happy(aa) => False\n    is_happy(abcd) => True\n    is_happy(aabb) => False\n    is_happy(adb) => True\n    is_happy(xyy) => False\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a string\")\n\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        a, b, c = s[i], s[i + 1], s[i + 2]\n        if a == b or a == c or b == c:\n            return False\n\n    return True"}
