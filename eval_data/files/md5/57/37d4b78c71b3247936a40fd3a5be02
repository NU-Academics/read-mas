{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list, handling both hashable and unhashable comparable types.\n    Raises TypeError if elements are not mutually comparable.\n    \"\"\"\n    if not l:\n        return []\n\n    try:\n        # Fast path for hashable elements\n        s = set(l)\n        try:\n            return sorted(s)\n        except TypeError:\n            # Elements are hashable but not mutually comparable (e.g., set of int and str)\n            # Fall through to the general sorting and deduplication path.\n            pass\n    except TypeError:\n        # Elements are unhashable (e.g., lists, dicts)\n        # Fall through to the general sorting and deduplication path.\n        pass\n\n    # Fallback path for unhashable or non-mutually-comparable hashable elements\n    try:\n        sorted_l = sorted(l)\n    except TypeError:\n        raise TypeError(\"Elements are not mutually comparable, cannot produce unique sorted result.\")\n\n    # Deduplicate the sorted list\n    unique_elements = []\n    if sorted_l:\n        unique_elements.append(sorted_l[0])\n        for item in sorted_l[1:]:\n            if item != unique_elements[-1]:\n                unique_elements.append(item)\n    return unique_elements"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial in increasing order.\n    find_zero finds x such that p(x) = 0 and returns a single real root (float).\n\n    Preconditions (per problem statement):\n    - len(xs) is even\n    - leading coefficient xs[-1] is non-zero (odd polynomial degree -> at least one real root)\n    \"\"\"\n    import math\n\n    # Input validation\n    if not isinstance(xs, (list, tuple)):\n        raise TypeError(\"xs must be a list or tuple of coefficients\")\n    if len(xs) == 0:\n        raise ValueError(\"xs must be non-empty\")\n    if len(xs) % 2 != 0:\n        raise ValueError(\"len(xs) must be even (precondition of the problem)\")\n    if not isinstance(xs[-1], (int, float)) or xs[-1] == 0:\n        raise ValueError(\"leading coefficient must be a non-zero number\")\n\n    # Horner's method for polynomial evaluation (numerically stable & O(n))\n    def horner(coeffs, x_val):\n        res = 0.0\n        for c in reversed(coeffs):\n            res = res * x_val + c\n            if not math.isfinite(res):\n                # Return large signed infinity to indicate overflow direction\n                return float('inf') if res > 0 else float('-inf')\n        return res\n\n    # Tolerances and iteration limits\n    tol_x = 1e-12\n    tol_f = 1e-14\n    max_iterations = 200\n    max_scale_iters = 200\n    max_bound = 1e300\n\n    # Bracket search: symmetric expansion about 0 until sign change is found\n    scale = 1.0\n    a = -scale\n    b = scale\n    fa = horner(xs, a)\n    fb = horner(xs, b)\n\n    if fa == 0.0:\n        return float(a)\n    if fb == 0.0:\n        return float(b)\n\n    for _ in range(max_scale_iters):\n        if (fa < 0 and fb > 0) or (fa > 0 and fb < 0):\n            break\n        scale *= 2.0\n        if scale > max_bound:\n            break\n        a = -scale\n        b = scale\n        fa = horner(xs, a)\n        fb = horner(xs, b)\n        if fa == 0.0:\n            return float(a)\n        if fb == 0.0:\n            return float(b)\n\n    # If no sign change was found, raise an error (shouldn't happen for valid odd-degree polynomial\n    # but numerical issues could prevent bracketing)\n    if not ((fa < 0 and fb > 0) or (fa > 0 and fb < 0)):\n        raise RuntimeError(\"Failed to bracket a root; polynomial may overflow or violate preconditions\")\n\n    # Bisection method\n    for _ in range(max_iterations):\n        mid = (a + b) / 2.0\n        fm = horner(xs, mid)\n\n        # Stopping criteria\n        if fm == 0.0 or abs(fm) <= tol_f or (b - a) / 2.0 <= tol_x:\n            return float(mid)\n\n        # Narrow bracket\n        if (fm < 0 and fa < 0) or (fm > 0 and fa > 0):\n            a = mid\n            fa = fm\n        else:\n            b = mid\n            fb = fm\n\n    # If maximum iterations reached, return midpoint as best estimate\n    return float((a + b) / 2.0)"}
