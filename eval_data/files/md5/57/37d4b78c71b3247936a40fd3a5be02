{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Convert an iterable of numeric GPAs to their letter grades.\n\n    Grading rules (applied in descending order):\n      - 4.0  -> 'A+'\n      - > 3.7 -> 'A'\n      - > 3.3 -> 'A-'\n      - > 3.0 -> 'B+'\n      - > 2.7 -> 'B'\n      - > 2.3 -> 'B-'\n      - > 2.0 -> 'C+'\n      - > 1.7 -> 'C'\n      - > 1.3 -> 'C-'\n      - > 1.0 -> 'D+'\n      - > 0.7 -> 'D'\n      - > 0.0 -> 'D-'\n      - 0.0  -> 'E'\n\n    Input validation:\n      - `grades` must be an iterable.\n      - Each element must be a real number (int/float). None or non-numeric types raise TypeError.\n      - NaN values raise ValueError.\n      - Values outside [0.0, 4.0] (with a small tolerance) raise ValueError.\n\n    Returns a list of letter-grade strings corresponding to each input GPA.\n    \"\"\"\n    import math\n\n    if grades is None:\n        raise TypeError(\"grades must be an iterable of numeric GPA values\")\n\n    try:\n        iterator = iter(grades)\n    except TypeError:\n        raise TypeError(\"grades must be an iterable of numeric GPA values\")\n\n    eps = 1e-9\n    result = []\n    for idx, val in enumerate(iterator):\n        # Validate and convert\n        if isinstance(val, bool):  # bool is a subclass of int; treat as invalid\n            raise TypeError(f\"grade at index {idx} is not a numeric GPA\")\n        try:\n            gpa = float(val)\n        except (TypeError, ValueError):\n            raise TypeError(f\"grade at index {idx} is not a numeric GPA\")\n\n        if math.isnan(gpa):\n            raise ValueError(f\"grade at index {idx} is NaN\")\n\n        # Clamp values extremely close to 0.0 or 4.0\n        if math.isclose(gpa, 0.0, abs_tol=eps):\n            gpa = 0.0\n        if math.isclose(gpa, 4.0, abs_tol=eps):\n            gpa = 4.0\n\n        if gpa < -eps or gpa > 4.0 + eps:\n            raise ValueError(f\"grade at index {idx} is out of valid range [0.0, 4.0]\")\n\n        # Apply grading rules (note: comparisons follow the specification: '>' thresholds)\n        if gpa == 4.0:\n            result.append('A+')\n        elif gpa > 3.7:\n            result.append('A')\n        elif gpa > 3.3:\n            result.append('A-')\n        elif gpa > 3.0:\n            result.append('B+')\n        elif gpa > 2.7:\n            result.append('B')\n        elif gpa > 2.3:\n            result.append('B-')\n        elif gpa > 2.0:\n            result.append('C+')\n        elif gpa > 1.7:\n            result.append('C')\n        elif gpa > 1.3:\n            result.append('C-')\n        elif gpa > 1.0:\n            result.append('D+')\n        elif gpa > 0.7:\n            result.append('D')\n        elif gpa > 0.0:\n            result.append('D-')\n        else:  # gpa == 0.0\n            result.append('E')\n\n    return result"}
{"task_id": "HumanEval/82", "solution": "import math\n\ndef prime_length(string):\n    \"\"\"Checks if the length of the input string is a prime number.\n    Returns True if len(string) is prime, False otherwise.\n    \"\"\"\n    n = len(string)\n\n    if n <= 1:\n        return False\n    if n == 2 or n == 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n\n    i = 5\n    limit = math.isqrt(n)\n    while i <= limit:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numeric GPA values to letter grades based on a defined grading table.\n    Handles numeric conversion, range validation, and precise threshold comparisons.\n    \"\"\"\n    result = []\n    epsilon = 1e-9\n\n    for item in grades:\n        try:\n            value = float(item)\n        except Exception:\n            raise TypeError(f\"Non-numeric item encountered: '{item}'. Must be convertible to float.\")\n\n        if value < -epsilon or value > 4.0 + epsilon:\n            raise ValueError(f\"GPA value {value} is out of the allowed range [0.0, 4.0].\")\n\n        if abs(value - 4.0) <= epsilon:\n            letter_grade = 'A+'\n        elif value > 3.7 + epsilon:\n            letter_grade = 'A'\n        elif value > 3.3 + epsilon:\n            letter_grade = 'A-'\n        elif value > 3.0 + epsilon:\n            letter_grade = 'B+'\n        elif value > 2.7 + epsilon:\n            letter_grade = 'B'\n        elif value > 2.3 + epsilon:\n            letter_grade = 'B-'\n        elif value > 2.0 + epsilon:\n            letter_grade = 'C+'\n        elif value > 1.7 + epsilon:\n            letter_grade = 'C'\n        elif value > 1.3 + epsilon:\n            letter_grade = 'C-'\n        elif value > 1.0 + epsilon:\n            letter_grade = 'D+'\n        elif value > 0.7 + epsilon:\n            letter_grade = 'D'\n        elif value > 0.0 + epsilon:\n            letter_grade = 'D-'\n        else:  # value <= 0.0 + epsilon\n            letter_grade = 'E'\n\n        result.append(letter_grade)\n\n    return result"}
