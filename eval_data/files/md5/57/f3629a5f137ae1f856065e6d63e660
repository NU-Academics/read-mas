se\n\n```"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr: list[int]) -> int:\n    \"\"\"\n    Identifies the largest index `i` within a given array `arr` such that the element `arr[i]`\n    is strictly less than its immediate predecessor `arr[i-1]`.\n    If the array is fully sorted in non-decreasing order or has fewer than two elements,\n    the function returns -1.\n\n    Args:\n        arr: A list of integers to be analyzed.\n\n    Returns:\n        The largest index `i` (where `i > 0`) such that `arr[i] < arr[i-1]`.\n        -1 if no such index exists (i.e., the array is sorted in non-decreasing order,\n        or has fewer than two elements).\n    \"\"\"\n    # Handle edge cases: arrays with less than 2 elements cannot have a predecessor comparison.\n    if len(arr) < 2:\n        return -1\n\n    # Iterate from the second-to-last element down to the second element (index 1).\n    # The range function generates indices from len(arr) - 1 down to 1 (exclusive of 0).\n    for i in range(len(arr) - 1, 0, -1):\n        # Check if the current element is smaller than its predecessor.\n        if arr[i] < arr[i-1]:\n            # This is the largest index that satisfies the condition due to reverse iteration.\n            return i\n\n    # If the loop completes, it means no element was found that violates the non-decreasing order.\n    return -1\n"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst: list[int]) -> tuple[int | None, int | None]:\n    \"\"\"\n    Identifies the largest negative integer and the smallest positive integer from a given list of integers.\n\n    This function iterates through the input list once to find the required values.\n    It adheres to O(N) time complexity and O(1) space complexity.\n\n    Args:\n        lst (list[int]): A list of integers.\n\n    Returns:\n        tuple[int | None, int | None]: A tuple containing two elements:\n            - The largest negative integer found in `lst`, or `None` if no negative\n              integers are present.\n            - The smallest positive integer found in `lst`, or `None` if no positive\n              integers are present.\n\n    Examples:\n        >>> largest_smallest_integers([2, -1, 4, -5, 1, 0])\n        (-1, 1)\n        >>> largest_smallest_integers([2, 4, 1, 3, 5, 7])\n        (None, 1)\n        >>> largest_smallest_integers([])\n        (None, None)\n        >>> largest_smallest_integers([0])\n        (None, None)\n        >>> largest_smallest_integers([-1, -2, -3])\n        (-1, None)\n        >>> largest_smallest_integers([-1, 5, -10, 2])\n        (-1, 2)\n        >>> largest_smallest_integers([100])\n        (None, 100)\n    \"\"\"\n    largest_neg = None\n    smallest_pos = None\n\n    for number in lst:\n        if number < 0:\n            if largest_neg is None or number > largest_neg:\n                largest_neg = number\n        elif number > 0:  # Zero is explicitly excluded\n            if smallest_pos is None or number < smallest_pos:\n                smallest_pos = number\n\n    return largest_neg, smallest_pos\n"}
{"task_id": "HumanEval/137", "solution": "```python\nfrom typing import Any, Optional\n\ndef _normalize_to_float(value: Any) -> float:\n    \"\"\"\n    Internal helper to convert a value (int, float, or str representing a real number)\n    to its float representation. Handles ',' as a decimal separator in strings.\n\n    Raises:\n        TypeError: If the input value is not int, float, or str.\n        ValueError: If a string input cannot be converted to a float.\n    \"\"\"\n    if isinstance(value, (int, float)):\n        return float(value)\n    elif isinstance(value, str):\n        # FR2: Convert decimal separator from ',' to '.' if present.\n        normalized_str = value.replace(',', '.')\n        # FR3: Convert to float for numerical comparison.\n        return float(normalized_str)\n    else:\n        # FR1 specifies expected types (int, float, str). Other types are invalid.\n        raise TypeError(f\"Unsupported input type for comparison: {type(value)}. Expected int, float, or str.\")\n\ndef compare_one(a: Any, b: Any) -> Optional[Any]:\n    \"\"\"\n    Compares two values (int, float, or string representing real numbers)\n    and returns the numerically larger value in its original type.\n    Returns None if the values are numerically equal or if a conversion error occurs.\n\n    Args:\n        a (Any): The first value to compare. Can be int, float, or str.\n        b (Any): The second value to compare. Can be int, float, or str.\n\n    Returns:\n        Optional[Any]: The numerically larger value (preserving its original type),\n                       or None if the values are numerically equal,\n                       or None if an error occurs during conversion (e.g., invalid string format or unsupported type).\n    \"\"\"\n    try:\n        # FR3: Convert all inputs to a common numerical representation (float).\n        float_a = _normalize_to_float(a)\n        float_b = _normalize_to_float(b)\n\n        # FR4: Perform numerical comparison.\n        if float_a > float_b:\n            # FR5: Return original 'a' if it's numerically greater.\n            return a\n        elif float_b > float_a:\n            # FR6: Return original 'b' if it's numerically greater.\n            return b\n        else: # float_a == float_b\n            # FR7: Return None if numerical values are equal.\n            return None\n    except (ValueError, TypeError):\n        # FR3.3.3 Reliability: Do not raise unhandled exceptions.\n        # Catch errors from _normalize_to_float (e.g., invalid string, unsupported type)\n        # and return None as per the design's error handling strategy.\n        return None\n```"}
{"task_id": "HumanEval/138", "solution": "```python\ndef is_equal_to_sum_even(n: int) -> bool:\n    \"\"\"\n    Checks if an integer n can be written as the sum of exactly 4 positive even numbers.\n\n    Args:\n        n (int): The integer to check.\n\n    Returns:\n        bool: True if n can be expressed as the sum of 4 positive even numbers,\n              False otherwise.\n\n    Examples:\n        is_equal_to_sum_even(4) == False\n        is_equal_to_sum_even(6) == False\n        is_equal_to_sum_even(8) == True\n        is_equal_to_sum_even(9) == False\n        is_equal_to_sum_even(10) == True\n    \"\"\"\n    # Condition 1: The sum of four positive even numbers must be an even number.\n    # So, if n is odd, it's impossible. (FR-002, FR-005)\n    if n % 2 != 0:\n        return False\n\n    # Condition 2: The smallest sum of four positive even numbers is 2+2+2+2 = 8.\n    # So, if n is less than 8, it's impossible. (FR-003, FR-005)\n    if n < 8:\n        return False\n\n    # If n is even and n is 8 or greater, it's always possible to find\n    # four positive even numbers that sum to n. (FR-004)\n    # For instance, if n = 8, 2+2+2+2 = 8.\n    # If n = 10, 2+2+2+4 = 10.\n    # If n = 12, 2+2+2+6 = 12 (or 2+2+4+4 = 12).\n    # Generally, for any even n >= 8, let n = 2k. We need k1+k2+k3+k4 = k, with k_i >= 1.\n    # Since n >= 8, k >= 4. We can always pick k1=1, k2=1, k3=1, and k4=k-3.\n    # As k >= 4, k-3 >= 1, so all k_i are positive integers.\n    return True\n```"}
{"task_id": "HumanEval/139", "solution": "import math\n\ndef special_factorial(n: int) -> int:\n    \"\"\"\n    Calculates the Brazilian factorial of n.\n\n    The Brazilian factorial is defined as the product of factorials from n! down to 1!,\n    i.e., n! * (n-1)! * (n-2)! * ... * 1!, for a positive integer n.\n\n    Args:\n        n (int): A positive integer for which the Brazilian factorial is to be calculated.\n\n    Returns:\n        int: The calculated Brazilian factorial of n.\n\n    Raises:\n        TypeError: If n is not an integer.\n        ValueError: If n is not a positive integer (i.e., n <= 0).\n    \"\"\"\n    # FR2: Validate that n is an integer.\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    # FR3: Validate that n is a positive integer.\n    if n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer (n > 0).\")\n\n    # FR5: Initialize the product accumulator.\n    brazilian_factorial_product = 1\n\n    # FR4, FR5: Loop from n down to 1, calculating each factorial and multiplying it into the product.\n    # DI3: Use math.factorial for individual factorial calculations.\n    for k in range(n, 0, -1):\n        brazilian_factorial_product *= math.factorial(k)\n\n    # FR6: Return the final calculated product.\n    return brazilian_factorial_product\n"}
{"task_id": "HumanEval/140", "solution": "```python\nimport re\n\n\ndef fix_spaces(text: str) -> str:\n    \"\"\"\n    Modifies a string according to specific space transformation rules.\n\n    Rules:\n    1. Replace all single spaces in the text with underscores.\n    2. If the string contains more than 2 consecutive spaces (i.e., 3 or more spaces together),\n       replace all those consecutive spaces with a single hyphen.\n    Sequences of exactly two spaces are left unchanged.\n\n    Args:\n        text (str): The input string to modify.\n\n    Returns:\n        str: The modified string.\n    \"\"\"\n    # FR2: Replace 3 or more consecutive spaces with a single hyphen.\n    # This regex matches any sequence of 3 or more space characters.\n    # Example: \"a    b\" -> \"a-b\", \"c   d\" -> \"c-d\"\n    temp_text = re.sub(r' {3,}', '-', text)\n\n    # FR3: Replace all single spaces with underscores.\n    # FR6: Handle Exactly Two Consecutive Spaces - do not modify them.\n    # This regex uses negative lookbehind `(?<! )` and negative lookahead `(?! )`\n    # to ensure it only matches a space character that is NOT preceded by another space\n    # AND NOT followed by another space.\n    # This precisely targets 'single spaces' and explicitly leaves '  ' (two spaces) untouched.\n    # Example: \"a b\" -> \"a_b\", but \"a  b\" remains \"a  b\"\n    final_text = re.sub(r'(?<! ) (?! )', '_', temp_text)\n\n    # FR4: Return Modified String\n    return final_text\n```"}
{"task_id": "HumanEval/141", "solution": "```python\nimport re\n\n\ndef file_name_check(file_name: str) -> str:\n    \"\"\"\n    Checks if a given file name string is valid based on specific criteria.\n\n    Validity conditions:\n    1. The file name must not contain more than three digits (0-9).\n    2. The file name must contain exactly one dot '.'.\n    3. The substring before the dot must not be empty and must start with a letter \n       from the Latin alphabet (a-z, A-Z).\n    4. The substring after the dot (the extension) must be one of ['txt', 'exe', 'dll'].\n\n    Args:\n        file_name (str): The string representing the file name to be validated.\n\n    Returns:\n        str: 'Yes' if the file name is valid, 'No' otherwise.\n\n    Examples:\n        >>> file_name_check(\"example.txt\")\n        'Yes'\n        >>> file_name_check(\"1example.dll\")\n        'No'\n        >>> file_name_check(\"my.document.txt\")\n        'No'\n        >>> file_name_check(\".txt\")\n        'No'\n        >>> file_name_check(\"file.jpg\")\n        'No'\n        >>> file_name_check(\"file1234.txt\")\n        'No'\n        >>> file_name_check(\"file123.txt\")\n        'Yes'\n        >>> file_name_check(\"file.TxT\")\n        'No'\n    \"\"\"\n    # Condition 1: The file name must not contain more than three digits (0-9).\n    digit_count = sum(c.isdigit() for c in file_name)\n    if digit_count > 3:\n        return 'No'\n\n    # Condition 2: The file name must contain exactly one dot '.'.\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split the file name into name_part and extension_part\n    name_part, extension_part = file_name.split('.')\n\n    # Condition 3a: The substring before the dot must not be empty.\n    if not name_part:\n        return 'No'\n\n    # Condition 3b: The substring before the dot must start with a letter \n    # from the Latin alphabet (a-z, A-Z).\n    # isalpha() checks for unicode letters. For \"Latin alphabet (a-z, A-Z)\",\n    # this is sufficient. If strict ASCII was required, a regex or range check would be used.\n    if not name_part[0].isalpha():\n        return 'No'\n\n    # Condition 4: The substring after the dot (the extension) must be one of \n    # ['txt', 'exe', 'dll'] (case-sensitive).\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if extension_part not in allowed_extensions:\n        return 'No'\n\n    # If all conditions are met\n    return 'Yes'\n\n```"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst: list) -> int:\n    \"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for index, value in enumerate(lst):\n        transformed_value = value\n        if index % 3 == 0:\n            transformed_value = value ** 2\n        elif index % 4 == 0:  # This condition implicitly handles \"AND NOT a multiple of 3\" due to the 'elif'\n            transformed_value = value ** 3\n        \n        total_sum += transformed_value\n            \n    return total_sum\n```"}
{"task_id": "HumanEval/143", "solution": "```python\nimport math\n\ndef _is_prime(number: int) -> bool:\n    \"\"\"\n    Helper function to determine if a given integer is a prime number.\n\n    A prime number is a natural number greater than 1 that has no positive divisors\n    other than 1 and itself.\n\n    Args:\n        number (int): The integer to check for primality.\n\n    Returns:\n        bool: True if the number is prime, False otherwise.\n    \"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    \n    # Check for divisors from 3 up to the square root of the number, stepping by 2\n    # (only odd divisors need to be checked after handling 2)\n    for i in range(3, math.isqrt(number) + 1, 2):\n        if number % i == 0:\n            return False\n    return True\n\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Filters words in a given sentence, retaining only those whose lengths are prime numbers.\n\n    The input sentence is expected to contain only letters (a-z, A-Z) and single spaces\n    between words. There will be no leading/trailing spaces, multiple spaces, or other characters.\n\n    Args:\n        sentence (str): The input sentence to be processed.\n                        Expected length between 1 and 100 characters.\n\n    Returns:\n        str: A new string containing words from the original sentence with prime lengths,\n             preserving their original order and separated by single spaces.\n             Returns an empty string if no words meet the criteria.\n    \"\"\"\n    words = sentence.split(' ')\n    prime_length_words = []\n\n    for word in words:\n        if _is_prime(len(word)):\n            prime_length_words.append(word)\n            \n    return ' '.join(prime_length_words)\n```"}
{"task_id": "HumanEval/144", "solution": "```python\nimport math\n\ndef _gcd(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the Greatest Common Divisor (GCD) of two positive integers.\n    Uses the Euclidean algorithm, leveraging the math.gcd function.\n\n    Args:\n        a (int): The first positive integer.\n        b (int): The second positive integer.\n\n    Returns:\n        int: The greatest common divisor of a and b.\n    \"\"\"\n    return math.gcd(a, b)\n\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"\n    Determines if the product of two fractions results in a whole number.\n\n    This function parses two fraction strings, multiplies them, simplifies\n    the resulting fraction using a GCD helper, and checks if the simplified\n    denominator is 1 (indicating a whole number).\n\n    Args:\n        x (str): A string representing the first fraction (e.g., \"1/5\").\n                 Expected format: \"<numerator>/<denominator>\".\n                 Numerators and denominators are positive whole numbers.\n        n (str): A string representing the second fraction (e.g., \"5/1\").\n                 Expected format: \"<numerator>/<denominator>\".\n                 Numerators and denominators are positive whole numbers.\n\n    Returns:\n        bool: True if the product of x and n is a whole number, False otherwise.\n    \"\"\"\n    # REQ-FUN-001: Parse input string x into its numerator (num_x) and denominator (den_x).\n    num_x_str, den_x_str = x.split('/')\n    num_x = int(num_x_str)\n    den_x = int(den_x_str)\n\n    # REQ-FUN-002: Parse input string n into its numerator (num_n) and denominator (den_n).\\\n    num_n_str, den_n_str = n.split('/')\n    num_n = int(num_n_str)\n    den_n = int(den_n_str)\n\n    # REQ-FUN-003: Calculate the product's numerator as product_num = num_x * num_n.\n    product_num = num_x * num_n\n\n    # REQ-FUN-004: Calculate the product's denominator as product_den = den_x * den_n.\n    product_den = den_x * den_n\n\n    # REQ-FUN-006: Use the GCD helper function to find the common_divisor\n    # REQ-FUN-005 is satisfied by the _gcd function definition above.\n    common_divisor = _gcd(product_num, product_den)\n\n    # REQ-FUN-007: Simplify the product fraction by dividing product_num by common_divisor.\n    # We don't strictly need simplified_num for the final check, but computing it aligns with\n    # the \"simplification\" requirement.\n    # simplified_num = product_num // common_divisor\n\n    # REQ-FUN-008: Simplify the product fraction by dividing product_den by common_divisor.\n    simplified_den = product_den // common_divisor\n\n    # REQ-FUN-009: Return True if simplified_den is equal to 1.\n    # REQ-FUN-010: Return False if simplified_den is not equal to 1.\n    return simplified_den == 1\n\n```"}
{"task_id": "HumanEval/145", "solution": "```python\ndef _calculate_sum_of_digits(n: int) -> int:\n    \"\"\"Calculates the sum of the absolute values of the digits of an integer.\"\"\"\n    n_abs = abs(n)\n    digit_sum = 0\n    if n_abs == 0:\n        return 0\n    while n_abs > 0:\n        digit_sum += n_abs % 10\n        n_abs //= 10\n    return digit_sum\n\n\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers in ascending order according to the sum of their digits.\n    If there are several items with a similar sum of their digits,\n    order them based on their original index in the list.\n\n    Args:\n        nums: A list of integers.\n\n    Returns:\n        A new list of integers sorted by sum of digits, then by original index.\n    \"\"\"\n    # Create a list of tuples: (sum_of_digits, original_index, number)\n    # This structure allows sorting first by sum_of_digits, then by original_index\n    # and finally preserving the original number.\n    decorated_list = []\n    for index, num in enumerate(nums):\n        s_digits = _calculate_sum_of_digits(num)\n        decorated_list.append((s_digits, index, num))\n\n    # Sort the decorated list. Python's Timsort (used by sorted()) is stable,\n    # and using a tuple as a key naturally sorts by the first element,\n    # then the second, and so on. This satisfies the primary and secondary\n    # sorting criteria.\n    sorted_decorated_list = sorted(decorated_list, key=lambda x: (x[0], x[1]))\n\n    # Extract the original numbers from the sorted decorated list\n    result = [item[2] for item in sorted_decorated_list]\n\n    return result\n```"}
{"task_id": "HumanEval/146", "solution": "```python\ndef specialFilter(nums: list[int]) -> int:\n    \"\"\"\n    Filters an array of numbers to count those meeting specific criteria:\n    - The number must be greater than 10.\n    - Both its first and last digits (considering absolute value) must be odd.\n\n    Args:\n        nums: A list of integers to be filtered.\n\n    Returns:\n        The total count of numbers satisfying both conditions.\n    \"\"\"\n\n    def _get_first_digit(num: int) -> int:\n        \"\"\"\n        Extracts the first digit of a non-negative integer.\n        e.g., _get_first_digit(123) -> 1\n        e.g., _get_first_digit(7) -> 7\n        \"\"\"\n        if num == 0:\n            return 0\n        while num >= 10:\n            num //= 10\n        return num\n\n    def _get_last_digit(num: int) -> int:\n        \"\"\"\n        Extracts the last digit of a non-negative integer.\n        e.g., _get_last_digit(123) -> 3\n        e.g., _get_last_digit(7) -> 7\n        \"\"\"\n        return num % 10\n\n    def _is_odd(digit: int) -> bool:\n        \"\"\"\n        Checks if a given digit is odd.\n        \"\"\"\n        return digit % 2 != 0\n\n    special_count = 0\n    for number in nums:\n        # FR3.1: Check if number is greater than 10\n        if number <= 10:\n            continue\n\n        # FR3.2: Determine the absolute value for digit extraction\n        abs_number = abs(number)\n\n        # FR3.4: Determine the first digit\n        first_digit = _get_first_digit(abs_number)\n\n        # FR3.3: Determine the last digit\n        last_digit = _get_last_digit(abs_number)\n\n        # FR3.5 and FR3.6: Check if both first and last digits are odd\n        if _is_odd(first_digit) and _is_odd(last_digit):\n            # FR3.7: Increment special_count if both conditions met\n            special_count += 1\n\n    # FR4: Return the final count\n    return special_count\n```"}
{"task_id": "HumanEval/147", "solution": "```python\ndef get_max_triples(n: int) -> int:\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from a sequence 'a'\n    where a[x] = x*x - x + 1, such that 1 <= i < j < k <= n and a[i] + a[j] + a[k] is a multiple of 3.\n\n    The mathematical insight:\n    a[x] = x*x - x + 1 = x*(x-1) + 1\n\n    Analyzing a[x] % 3 based on x % 3:\n    - If x % 3 == 0: x = 3k. Then a[x] = 3k * (3k - 1) + 1. So, a[x] % 3 == 1.\n    - If x % 3 == 1: x = 3k + 1. Then x - 1 = 3k. So, a[x] = (3k + 1) * 3k + 1. So, a[x] % 3 == 1.\n    - If x % 3 == 2: x = 3k + 2. Then x - 1 = 3k + 1. So, a[x] = (3k + 2) * (3k + 1) + 1\n                      = (9k^2 + 9k + 2) + 1 = 9k^2 + 9k + 3. So, a[x] % 3 == 0.\n\n    Summary of a[x] % 3:\n    - a[x] % 3 == 0 if x % 3 == 2\n    - a[x] % 3 == 1 if x % 3 == 0 or x % 3 == 1\n\n    For a sum a[i] + a[j] + a[k] to be a multiple of 3, given that a[x] % 3 can only be 0 or 1,\n    the remainders (r_i, r_j, r_k) must be either (0, 0, 0) or (1, 1, 1).\n    This means we need to count:\n    1. Triples where all three elements a[i], a[j], a[k] are 0 mod 3.\n    2. Triples where all three elements a[i], a[j], a[k] are 1 mod 3.\n\n    Args:\n        n (int): A positive integer representing the upper bound for the sequence.\n\n    Returns:\n        int: The count of valid triples.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    count_rem0 = 0  # Count of a[x] such that a[x] % 3 == 0 (i.e., x % 3 == 2)\n    count_rem1 = 0  # Count of a[x] such that a[x] % 3 == 1 (i.e., x % 3 == 0 or x % 3 == 1)\n\n    for i in range(1, n + 1):\n        if i % 3 == 2:\n            count_rem0 += 1\n        else:  # i % 3 == 0 or i % 3 == 1\n            count_rem1 += 1\n\n    def combinations_3(count: int) -> int:\n        \"\"\"\n        Calculates 'count choose 3' combinations.\n        C(n, k) = n! / (k! * (n-k)!)\n        For k=3, C(n, 3) = n * (n-1) * (n-2) / (3 * 2 * 1) = n * (n-1) * (n-2) // 6\n        \"\"\"\n        if count < 3:\n            return 0\n        return (count * (count - 1) * (count - 2)) // 6\n\n    total_triples = combinations_3(count_rem0) + combinations_3(count_rem1)\n    return total_triples\n```"}
{"task_id": "HumanEval/148", "solution": "```python\nPLANETS_IN_ORDER = (\n    \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n)\n\n\ndef bf(planet1: str, planet2: str) -> tuple[str, ...]:\n    \"\"\"\n    Identifies planets located strictly between the orbits of two specified planets.\n\n    Args:\n        planet1: A string representing the name of the first planet.\n        planet2: A string representing the name of the second planet.\n\n    Returns:\n        A tuple of strings, where each string is the name of a planet located\n        strictly between planet1 and planet2 in orbital order, sorted by\n        proximity to the Sun. Returns an empty tuple if planet1 or planet2 are\n        not valid planet names, or if no planets exist between them.\n    \"\"\"\n    try:\n        idx1 = PLANETS_IN_ORDER.index(planet1)\n        idx2 = PLANETS_IN_ORDER.index(planet2)\n    except ValueError:\n        return ()  # Invalid planet name\n\n    # Determine the start and end indices for slicing (exclusive of original planets)\n    min_idx = min(idx1, idx2)\n    max_idx = max(idx1, idx2)\n\n    # Slice the planets between the two input planets\n    # The slice will be from min_idx + 1 up to (but not including) max_idx\n    result_planets = PLANETS_IN_ORDER[min_idx + 1:max_idx]\n\n    return tuple(result_planets)\n```"}
{"task_id": "HumanEval/149", "solution": "```python\ndef sorted_list_sum(lst: list[str]) -> list[str]:\n    \"\"\"\n    Filters a list of strings, keeping only those with even lengths,\n    then sorts them first by length (ascending) and then alphabetically (ascending).\n\n    Args:\n        lst: A list of strings.\n\n    Returns:\n        A new list containing strings from the input that have even lengths,\n        sorted according to the specified criteria.\n    \"\"\"\n    # 1. Filter: Remove strings with odd lengths.\n    #    A list comprehension is used for conciseness and efficiency.\n    filtered_strings = [s for s in lst if len(s) % 2 == 0]\n\n    # 2. Sort: Sort the remaining strings.\n    #    The 'key' argument for sorted() is a lambda function that returns a tuple.\n    #    Python sorts tuples lexicographically, meaning it will first compare\n    #    the first elements (string length) and then the second elements (the string itself)\n    #    if the first elements are equal.\n    #    This naturally achieves the desired two-level sorting.\n    sorted_result = sorted(filtered_strings, key=lambda s: (len(s), s))\n\n    return sorted_result\n```"}
{"task_id": "HumanEval/150", "solution": "```python\nimport math\nfrom typing import Any\n\ndef _is_prime(n: int) -> bool:\n    \"\"\"\n    Determines if a given integer n is a prime number.\n\n    Args:\n        n (int): The integer to check for primality.\n\n    Returns:\n        bool: True if n is prime, False otherwise.\n    \"\"\"\n    # F2.1: Non-Prime (n <= 1)\n    if n <= 1:\n        return False\n    # F2.2: Prime (n=2)\n    if n == 2:\n        return True\n    # F2.3: Non-Prime (Even numbers > 2)\n    if n % 2 == 0:\n        return False\n\n    # F2.4: Primality Test (Odd numbers > 2)\n    # Check for divisors from 3 up to sqrt(n), only odd numbers.\n    # We only need to check up to the square root of n because if n has a divisor\n    # larger than its square root, it must also have a divisor smaller than its square root.\n    for i in range(3, int(math.isqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\n\ndef x_or_y(n: int, x: Any, y: Any) -> Any:\n    \"\"\"\n    Determines if a given number n is prime.\n    If n is prime, the function returns x.\n    Otherwise, it returns y.\n\n    Args:\n        n (int): The integer to check for primality.\n        x (Any): The value to return if n is prime.\n        y (Any): The value to return if n is not prime.\n\n    Returns:\n        Any: Returns x if n is prime, otherwise returns y.\n    \"\"\"\n    if _is_prime(n):\n        # F3.1: Return X for Prime\n        return x\n    else:\n        # F3.2: Return Y for Non-Prime\n        return y\n```"}
{"task_id": "HumanEval/151", "solution": "```python\ndef double_the_difference(lst: list) -> int:\n    \"\"\"\n    Calculates the sum of squares of numbers in a list that are integers, positive, and odd.\n\n    Args:\n        lst: A list of numbers (can contain integers, floats, negative numbers).\n\n    Returns:\n        An integer representing the sum of squares of qualifying numbers.\n        Returns 0 if the list is empty or no numbers meet the criteria.\n    \"\"\"\n    total_sum = 0\n\n    if not lst:\n        return 0\n\n    for number in lst:\n        # FR-3, FR-4: Check if type is int\n        if not isinstance(number, int):\n            continue\n\n        # FR-5, FR-6: Check if positive\n        if number <= 0:\n            continue\n\n        # FR-7, FR-8: Check if odd\n        if number % 2 == 0:  # If number is even\n            continue\n\n        # FR-9, FR-10: Calculate square and add to total\n        total_sum += number * number\n\n    # FR-11, FR-13: Return the accumulated total\n    return total_sum\n```"}
{"task_id": "HumanEval/152", "solution": "```python\nimport math\n\ndef compare(game: list[int], guess: list[int]) -> list[int]:\n    \"\"\"\n    Compares actual game scores with guessed scores and returns a list of absolute differences.\n\n    Args:\n        game (list[int]): A list of actual scores for a series of matches.\n        guess (list[int]): A list of guessed scores for the respective matches.\n                           Must be of the same length as 'game'.\n\n    Returns:\n        list[int]: A list where each element is the absolute difference between the\n                   corresponding game score and guess. If the guess is correct, the\n                   difference is 0.\n\n    Raises:\n        ValueError: If 'game' and 'guess' lists are not of equal length.\n\n    Example:\n        >>> compare([1,2,3,4,5,1],[1,2,3,4,2,-2])\n        [0,0,0,0,3,3]\n        >>> compare([0,5,0,0,0,4],[4,1,1,0,0,-2])\n        [4,4,1,0,0,6]\n    \"\"\"\n    if len(game) != len(guess):\n        raise ValueError(\"Input lists 'game' and 'guess' must be of equal length.\")\n\n    differences = []\n    # Using zip for a more Pythonic and robust iteration over corresponding elements\n    # without explicitly managing indices or lengths after the initial check.\n    for actual_score, guessed_score in zip(game, guess):\n        diff = abs(actual_score - guessed_score)\n        differences.append(diff)\n    return differences\n\nif __name__ == \"__main__\":\n    # Example usage as provided in the design\n    print(compare([1,2,3,4,5,1],[1,2,3,4,2,-2]))\n    # Expected Output: [0, 0, 0, 0, 3, 3]\n    print(compare([0,5,0,0,0,4],[4,1,1,0,0,-2]))\n    # Expected Output: [4, 4, 1, 0, 0, 6]\n\n    # Test with empty lists\n    print(compare([], []))\n    # Expected Output: []\n\n    # Test with negative numbers and zeros\n    print(compare([-1, 0, 10], [-5, 0, 8]))\n    # Expected Output: [4, 0, 2]\n\n    # Test unequal length (should raise ValueError)\n    try:\n        compare([1, 2], [1])\n    except ValueError as e:\n        print(f\"Error: {e}\")\n    # Expected: Error: Input lists 'game' and 'guess' must be of equal length.\n```"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name: str, extensions: list[str]) -> str:\n    \"\"\"\n    Determines the strongest extension based on a strength formula\n    and returns a formatted string.\n\n    Args:\n        class_name: The name of the class (string).\n        extensions: A list of extension names (list of strings).\n                    Assumed to contain at least one string element.\n\n    Returns:\n        A string in the format \"{class_name}.{StrongestExtensionName}\".\n    \"\"\"\n    max_strength: float = float('-inf')\n    strongest_extension: str = \"\" # Will be updated by the first element due to initial max_strength\n\n    for ext in extensions:\n        # F-01: Calculate Extension Strength\n        upper_count = sum(1 for char in ext if char.isupper())\n        lower_count = sum(1 for char in ext if char.islower())\n        current_strength = upper_count - lower_count\n\n        # F-02: Identify Strongest Extension\n        # F-03: Handle Tie-breaking (first occurring extension wins)\n        # We only update if the current_strength is strictly greater.\n        # If current_strength is equal, the previously selected (earlier)\n        # extension is retained.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension = ext\n\n    # F-04: Format Output String\n    return f\"{class_name}.{strongest_extension}\""}
{"task_id": "HumanEval/154", "solution": "```python\nclass PatternUtil:\n    @staticmethod\n    def cycpattern_check(a: str, b: str) -> bool:\n        \"\"\"\n        Checks if the second string (b) or any of its cyclic rotations\n        is a substring in the first string (a).\n\n        Args:\n            a: The first string (text).\n            b: The second string (pattern).\n\n        Returns:\n            True if b or any of its rotations is a substring in a, False otherwise.\n        \"\"\"\n        # FR-002: If b is an empty string, an empty string is considered a substring\n        # of any string. This covers the edge case where 'b' is empty.\n        if not b:\n            return True\n\n        # FR-003: If the length of b is greater than the length of a,\n        # no rotation of b can possibly be a substring of a.\n        if len(b) > len(a):\n            return False\n\n        # FR-004: Create a doubled version of 'b'. Any cyclic rotation of 'b'\n        # of length len(b) will be a contiguous substring of b_double.\n        b_double = b + b\n\n        # FR-005, FR-006, FR-007: Iterate through all possible cyclic rotations of b\n        # and check if any are substrings of a.\n        # The loop runs 'len(b)' times, generating each unique rotation once.\n        for i in range(len(b)):\n            current_rotation = b_double[i : i + len(b)]\n            # FR-005: Check if the current_rotation exists as a substring within 'a'.\n            if current_rotation in a:\n                # FR-006: If a match is found, return True immediately as per requirement.\n                return True\n        \n        # FR-007: If the loop completes, it means no rotation of 'b' was found\n        # as a substring in 'a', so return False.\n        return False\n\n```"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num: int) -> tuple[int, int]:\n    \"\"\"\n    Counts the number of even and odd digits in an integer.\n\n    Args:\n        num (int): The integer to analyze. Its sign is ignored.\n\n    Returns:\n        tuple[int, int]: A tuple (even_count, odd_count) representing the\n                         number of even and odd digits, respectively.\n    \"\"\"\n    # Handle the absolute value of the number as per FR-2\n    abs_num = abs(num)\n\n    # Special case for num = 0 as per FR-8\n    if abs_num == 0:\n        return (1, 0) # '0' is considered an even digit\n\n    even_count = 0\n    odd_count = 0\n\n    # Convert the number to a string to easily iterate through its digits as per FR-3\n    num_str = str(abs_num)\n\n    # Iterate through each digit character\n    for digit_char in num_str:\n        digit_int = int(digit_char) # Convert char back to int\n        # Determine parity as per FR-4\n        if digit_int % 2 == 0:\n            even_count += 1 # Increment even count as per FR-5\n        else:\n            odd_count += 1 # Increment odd count as per FR-6\n\n    return (even_count, odd_count) # Return counts as a tuple as per FR-7\n"}
{"task_id": "HumanEval/156", "solution": "```python\nclass RomanNumeralConverter:\n    \"\"\"\n    Converts positive integers (1-1000) into their lowercase Roman numeral string representations.\n\n    This utility class provides a clear, encapsulated approach to implement the\n    int_to_mini_roman functionality, emphasizing reusability and maintainability.\n    \"\"\"\n\n    # A private class-level constant representing an ordered list of tuples,\n    # where each tuple contains an integer value and its corresponding lowercase\n    # Roman numeral symbol. This list is ordered in descending value to\n    # facilitate a greedy conversion algorithm and includes subtractive\n    # combinations (e.g., 900 for 'cm').\n    _ROMAN_MAP = [\n        (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n        (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n        (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'),\n        (1, 'i')\n    ]\n\n    def convert(self, number: int) -> str:\n        \"\"\"\n        Converts an integer to its lowercase Roman numeral string representation.\n\n        Parameters:\n            number (int): A positive integer between 1 and 1000 (inclusive)\n                          to be converted.\n\n        Returns:\n            str: The lowercase Roman numeral equivalent of the input number.\n\n        Preconditions:\n            - number must be an integer.\n            - 1 <= number <= 1000.\n            (Assumed to be handled by the client or prior validation layer.)\n\n        Postconditions:\n            - The returned string is a valid Roman numeral.\n            - All characters in the returned string are lowercase.\n        \"\"\"\n        result_parts = []\n        num_remaining = number\n\n        for value, symbol in self._ROMAN_MAP:\n            while num_remaining >= value:\n                result_parts.append(symbol)\n                num_remaining -= value\n            if num_remaining == 0:\n                # Optimization: if the number has been fully converted, stop early.\n                break\n\n        return \"\".join(result_parts)\n\n\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    converter = RomanNumeralConverter()\n    return converter.convert(number)\n\n```"}
{"task_id": "HumanEval/157", "solution": "```python\nfrom typing import Union\n\ndef right_angle_triangle(a: Union[int, float], b: Union[int, float], c: Union[int, float]) -> bool:\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    \"\"\"\n    # Calculate the squares of all three sides\n    a_sq = a * a\n    b_sq = b * b\n    c_sq = c * c\n\n    # Check all three permutations of the Pythagorean theorem\n    # (side1^2 + side2^2 = hypotenuse^2)\n    # The hypotenuse is the longest side, so we check if any side\n    # could be the hypotenuse.\n    \n    # Using direct equality comparison.\n    # For highly sensitive floating-point comparisons, an epsilon check\n    # (e.g., abs(a_sq + b_sq - c_sq) < EPSILON) would be more robust,\n    # but direct equality is sufficient based on the specification's examples.\n    return (a_sq + b_sq == c_sq or  # c is the hypotenuse\n            a_sq + c_sq == b_sq or  # b is the hypotenuse\n            b_sq + c_sq == a_sq)    # a is the hypotenuse\n\n```"}
{"task_id": "HumanEval/158", "solution": "```python\ndef find_max(words: list[str]) -> str:\n    \"\"\"\n    Accepts a list of strings and returns the word with the maximum number\n    of unique characters. If multiple strings have the maximum number of unique\n    characters, returns the one which comes first in lexicographical order.\n\n    Args:\n        words: A list of strings.\n\n    Returns:\n        The word with the maximum number of unique characters.\n        In case of a tie, the lexicographically first word.\n        Returns an empty string if the input list is empty.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    best_word = \"\"\n    max_unique_chars = -1 # Initialize with a value guaranteed to be less than any valid count\n\n    for word in words:\n        current_unique_chars = len(set(word))\n\n        if current_unique_chars > max_unique_chars:\n            max_unique_chars = current_unique_chars\n            best_word = word\n        elif current_unique_chars == max_unique_chars:\n            # Tie-breaker: lexicographical order\n            if word < best_word: # Python's string comparison is lexicographical\n                best_word = word\n    \n    return best_word\n```"}
{"task_id": "HumanEval/159", "solution": "```python\ndef eat(number: int, need: int, remaining: int) -> list[int, int]:\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \n    Example:\n    * eat(5, 6, 10) -> [11, 4]\n    * eat(4, 8, 9) -> [12, 1]\n    * eat(1, 10, 10) -> [11, 0]\n    * eat(2, 11, 5) -> [7, 0]\n    \n    Variables:\n    @number : integer\n        the number of carrots that you have eaten.\n    @need : integer\n        the number of carrots that you need to eat.\n    @remaining : integer\n        the number of remaining carrots thet exist in stock\n    \n    Constrain:\n    * 0 <= number <= 1000\n    * 0 <= need <= 1000\n    * 0 <= remaining <= 1000\n\n    Have fun :)\n    \"\"\"\n    carrots_to_eat = min(need, remaining)\n    \n    total_eaten_carrots = number + carrots_to_eat\n    carrots_left_in_stock = remaining - carrots_to_eat\n    \n    return [total_eaten_carrots, carrots_left_in_stock]\n```"}
{"task_id": "HumanEval/160", "solution": "```python\ndef do_algebra(operator: list[str], operand: list[int]) -> int:\n    \"\"\"\n    Constructs an algebraic expression from a list of operators and operands,\n    then evaluates it according to standard mathematical precedence.\n\n    Args:\n        operator (list[str]): A list of strings, each representing an algebraic\n                              operation ('+', '-', '*', '//', '**').\n        operand (list[int]): A list of non-negative integers.\n\n    Returns:\n        int: The integer result of the evaluated algebraic expression.\n\n    Preconditions:\n        - len(operator) == len(operand) - 1\n        - len(operator) >= 1\n        - len(operand) >= 2\n        - All elements in operator are one of '+', '-', '*', '//', '**'.\n        - All elements in operand are non-negative integers.\n    \"\"\"\n    expression_parts = [str(operand[0])]\n\n    for i in range(len(operator)):\n        expression_parts.append(operator[i])\n        expression_parts.append(str(operand[i+1]))\n\n    full_expression = \" \".join(expression_parts)\n    result = eval(full_expression)\n    return int(result)\n```"}
{"task_id": "HumanEval/161", "solution": "```python\ndef solve(s: str) -> str:\n    \"\"\"\n    Transforms a string s based on specific rules:\n    - If s contains no letters, reverses the entire string.\n    - If s contains at least one letter, reverses the case of all letters\n      (lower to upper, upper to lower) and keeps non-letters unchanged.\n    \"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if not has_letters:\n        # FR3: If no letters, reverse the entire string\n        return s[::-1]\n    else:\n        # FR4: If letters are present, apply character-wise transformation\n        transformed_chars = []\n        for char in s:\n            if char.isalpha():\n                # FR4.1: Letter Case Reversal\n                if char.islower():\n                    transformed_chars.append(char.upper())\n                else:  # char.isupper()\n                    transformed_chars.append(char.lower())\n            else:\n                # FR4.2: Non-Letter Preservation\n                transformed_chars.append(char)\n        # FR4.3: Result Construction and FR5: Return Value\n        return \"\".join(transformed_chars)\n\n```"}
{"task_id": "HumanEval/162", "solution": "```python\nimport hashlib\nfrom typing import Optional\n\ndef string_to_md5(text: str) -> Optional[str]:\n    \"\"\"\n    Computes the MD5 hash of a given string and returns it as a hexadecimal string.\n\n    If the input string is empty, it returns None.\n\n    Args:\n        text (str): The input string to hash.\n\n    Returns:\n        Optional[str]: The 32-character hexadecimal MD5 hash string, or None if the\n                       input string is empty.\n    \"\"\"\n    if not text:\n        return None\n    \n    # MD5 requires bytes-like object, so encode the string\n    md5_hash = hashlib.md5(text.encode('utf-8')).hexdigest()\n    return md5_hash\n```"}
{"task_id": "HumanEval/163", "solution": "```python\ndef generate_integers(a: int, b: int) -> list[int]:\n    \"\"\"\n    Given two positive integers a and b, return the even integers between a\n    and b (inclusive), in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    generate_integers(1, 1) => []\n    generate_integers(1, 2) => [2]\n    \"\"\"\n    start = min(a, b)\n    end = max(a, b)\n\n    even_numbers = []\n    for i in range(start, end + 1):\n        if i % 2 == 0:\n            even_numbers.append(i)\n\n    return even_numbers\n\n```"}
