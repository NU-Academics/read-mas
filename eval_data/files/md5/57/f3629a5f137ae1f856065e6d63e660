{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\"\n    Finds the largest number that divides n evenly, and is smaller than n.\n\n    Args:\n        n (int): The integer for which to find the largest proper divisor.\n                 Must be a positive integer greater than 1.\n\n    Returns:\n        int: The largest proper divisor of n.\n\n    Raises:\n        ValueError: If n is not a positive integer or n <= 1.\n\n    Examples:\n        >>> largest_divisor(15)\n        5\n        >>> largest_divisor(2)\n        1\n        >>> largest_divisor(7)\n        1\n        >>> largest_divisor(100)\n        50\n    \"\"\"\n    if not isinstance(n, int) or n <= 1:\n        raise ValueError(\"Input 'n' must be a positive integer greater than 1.\")\n\n    # Iterate downwards from n-1 to 1.\n    # The first integer 'i' found that evenly divides 'n' will be the largest proper divisor.\n    for i in range(n - 1, 0, -1):\n        if n % i == 0:\n            return i\n    \n    # This line should ideally not be reached if n > 1, as 1 is always a divisor.\n    # It acts as a theoretical safeguard, though 'i=1' would be caught by the loop for any n > 1.\n    return 1\n"}
{"task_id": "HumanEval/25", "solution": "```python\nfrom typing import List\n\ndef factorize(n: int) -> List[int]:\n    \"\"\"\n    Calculates the prime factors of a given integer n.\n\n    Args:\n        n (int): The integer to factorize.\n\n    Returns:\n        List[int]: A list of prime factors, sorted from smallest to largest,\n                   with repetitions for each factor. Returns an empty list\n                   for n <= 1.\n    \"\"\"\n    factors = []\n\n    # FR.2: If n is less than or equal to 1, the system shall return an empty list [].\n    if n <= 1:\n        return factors\n\n    # Divide by 2 (the only even prime number)\n    # This handles all factors of 2 and ensures n becomes odd.\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Divide by odd numbers starting from 3\n    # NFR.1.1: Optimized with sqrt(n) limit for trial division.\n    divisor = 3\n    while divisor * divisor <= n:\n        while n % divisor == 0:\n            factors.append(divisor)\n            n //= divisor\n        divisor += 2  # Increment by 2 to check only odd numbers\n\n    # If n is still greater than 1, it must be a prime number itself\n    # (the remaining factor, which is greater than sqrt(original_n)).\n    if n > 1:\n        factors.append(n)\n\n    # FR.4: The list of prime factors shall be ordered from smallest to largest.\n    # The algorithm naturally adds factors in ascending order.\n\n    # FR.5: Each prime factor shall appear in the list the number of times it divides n.\n    # The inner while loops ensure this by repeatedly dividing until n is no longer divisible.\n\n    return factors\n```"}
{"task_id": "HumanEval/26", "solution": "```python\nfrom typing import List\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    >>> remove_duplicates([])\n    []\n    >>> remove_duplicates([1, 1, 1, 1])\n    []\n    >>> remove_duplicates([1, 2, 3, 4])\n    [1, 2, 3, 4]\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n\n    return result\n```"}
{"task_id": "HumanEval/27", "solution": "```python\ndef flip_case(string: str) -> str:\n    \"\"\"\n    For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    Non-alphabetic characters remain unchanged.\n\n    Args:\n        string (str): The input string to process.\n\n    Returns:\n        str: A new string with the case of alphabetic characters flipped.\n\n    >>> flip_case('Hello World! 123')\n    'hELLO wORLD! 123'\n    >>> flip_case('')\n    ''\n    >>> flip_case('PYTHON')\n    'python'\n    >>> flip_case('pYtHoN')\n    'PyThOn'\n    \"\"\"\n    flipped_chars = []\n    for char in string:\n        if char.islower():\n            flipped_chars.append(char.upper())\n        elif char.isupper():\n            flipped_chars.append(char.lower())\n        else:\n            flipped_chars.append(char)\n    return \"\".join(flipped_chars)\n```"}
{"task_id": "HumanEval/28", "solution": "from typing import List\n\n\ndef concatenate(strings: List[str]) -> str:\n    \"\"\"\n    Concatenates a list of strings into a single string.\n\n    Args:\n        strings: A list of strings to be concatenated.\n\n    Returns:\n        A single string that is the result of joining all strings in the list.\n        Returns an empty string if the input list is empty.\n\n    Example:\n        >>> concatenate([])\n        ''\n        >>> concatenate(['a', 'b', 'c'])\n        'abc'\n        >>> concatenate(['hello', ' ', 'world'])\n        'hello world'\n    \"\"\"\n    return \"\".join(strings)"}
{"task_id": "HumanEval/29", "solution": "```python\nfrom typing import List\n\n\ndef filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n\n    This function iterates through the input list of strings and selects\n    only those that begin with the specified prefix. The comparison is\n    case-sensitive.\n\n    Args:\n        strings: A list of strings to filter.\n        prefix: The string prefix to match.\n\n    Returns:\n        A new list containing strings from the input that start with the prefix.\n\n    Raises:\n        TypeError: If 'strings' is not a list of strings or 'prefix' is not a string.\n\n    Examples:\n        >>> filter_by_prefix([], 'a')\n        []\n        >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n        ['abc', 'array']\n        >>> filter_by_prefix(['apple', 'Banana', 'apricot'], 'a')\n        ['apple', 'apricot']\n        >>> filter_by_prefix(['hello', 'world'], 'xyz')\n        []\n        >>> filter_by_prefix(['', 'abc'], '')\n        ['', 'abc']\n    \"\"\"\n    if not isinstance(strings, list) or not all(isinstance(s, str) for s in strings):\n        raise TypeError(\"The 'strings' argument must be a list of strings.\")\n    if not isinstance(prefix, str):\n        raise TypeError(\"The 'prefix' argument must be a string.\")\n\n    return [s for s in strings if s.startswith(prefix)]\n```"}
{"task_id": "HumanEval/30", "solution": "```python\ndef _validate_numeric_list(data_list: list):\n    \"\"\"\n    Helper function to validate that the input data_list is a list\n    and all its elements are numeric (int or float).\n    \"\"\"\n    if not isinstance(data_list, list):\n        raise TypeError(\"Input 'l' must be a list.\")\n    for item in data_list:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"List 'l' must contain only numeric elements (int or float).\")\n\ndef get_positive(l: list) -> list:\n    \"\"\"\n    This function takes a list `l` as input and returns a new list containing\n    only the positive numbers from the input list.\n\n    Raises:\n        TypeError: If 'l' is not a list or contains non-numeric elements.\n    \"\"\"\n    # 1. Input Validation using the helper function\n    _validate_numeric_list(l)\n\n    # 2. Filtering using a list comprehension to include only numbers greater than 0\n    # 3. Return Value: A new list with positive numbers\n    return [num for num in l if num > 0]\n```"}
{"task_id": "HumanEval/31", "solution": "```python\nimport math\n\n\ndef is_prime(n: int) -> bool:\n    \"\"\"\n    Checks if a given integer n is a prime number.\n\n    A prime number is a natural number greater than 1 that has no positive\n    divisors other than 1 and itself.\n\n    Args:\n        n (int): The integer to check for primality.\n\n    Returns:\n        bool: True if n is a prime number, False otherwise.\n    \"\"\"\n    # Rule 1: Numbers less than or equal to 1 are not prime.\n    if n <= 1:\n        return False\n\n    # Rule 2: 2 is the only even prime number.\n    if n == 2:\n        return True\n\n    # Rule 3: All other even numbers are not prime.\n    if n % 2 == 0:\n        return False\n\n    # Rule 4: Check for odd divisors from 3 up to the square root of n.\n    # We only need to check up to sqrt(n) because if n has a divisor greater\n    # than its square root, it must also have a divisor smaller than its\n    # square root (or the square root itself).\n    # We iterate with a step of 2 because we've already excluded even numbers.\n\n    # Using math.isqrt (integer square root) for Python 3.8+ for slight efficiency,\n    # or math.sqrt for broader compatibility, casting to int.\n    # Adding +1 to the limit to ensure the square root itself is checked if it's an odd divisor.\n    limit = int(math.sqrt(n))\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return False\n\n    # If no divisors were found, the number is prime.\n    return True\n```"}
{"task_id": "HumanEval/32", "solution": "import math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[2] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list):\n    \"\"\"\n    Finds a single real root of a polynomial with coefficients xs using the bisection method.\n\n    Args:\n        xs (list[float]): List of polynomial coefficients. xs[i] is the coefficient of x^i.\n                          Guaranteed to have an even number of coefficients (odd degree).\n\n    Returns:\n        float: An approximation of a real root x_0 such that poly(xs, x_0) = 0.\n    \"\"\"\n    # Define constants for the algorithm\n    tolerance = 1e-7\n    max_expansion_iterations = 50\n    max_bisection_iterations = 100\n    large_abs_bound = 1e10 # A practical limit for expanding bounds\n\n    # --- Bracketing Phase (REQ-FZ-004) ---\n    # Start with an initial interval and expand until a root is bracketed\n    lower_bound = -1.0  # REQ-FZ-004.1\n    upper_bound = 1.0   # REQ-FZ-004.1\n\n    for _ in range(max_expansion_iterations): # REQ-FZ-004.3 (max 50 iterations)\n        val_lower = poly(xs, lower_bound)\n        val_upper = poly(xs, upper_bound)\n\n        # Check if either bound is already a root within tolerance (REQ-FZ-004.4)\n        if abs(val_lower) < tolerance:\n            return lower_bound\n        if abs(val_upper) < tolerance:\n            return upper_bound\n\n        # Check if a sign change occurred (root is bracketed) (REQ-FZ-004.3)\n        if val_lower * val_upper < 0:\n            break\n        \n        # Check if bounds became excessively large (REQ-FZ-004.3)\n        if abs(lower_bound) > large_abs_bound or abs(upper_bound) > large_abs_bound:\n            # If bounds become too large and no sign change yet,\n            # for an odd-degree polynomial, a root must exist beyond these bounds.\n            # Proceed with bisection on the current, very large bounds.\n            break\n\n        # Expand bounds (REQ-FZ-004.2)\n        lower_bound *= 2.0\n        upper_bound *= 2.0\n    \n    # --- Bisection Phase (REQ-FZ-005) ---\n    # Perform bisection within the bracketed interval\n    # REQ-FZ-005.1: tolerance = 1e-7 is already defined.\n    for _ in range(max_bisection_iterations): # REQ-FZ-005.2 (max 100 iterations)\n        mid = (lower_bound + upper_bound) / 2.0 # REQ-FZ-005.3\n        poly_mid = poly(xs, mid)\n\n        # If the polynomial value at midpoint is close to zero, we found our root (REQ-FZ-005.4)\n        if abs(poly_mid) < tolerance:\n            return mid\n\n        # Re-evaluate poly(xs, lower_bound) for the current lower_bound\n        # This is robust in case lower_bound was updated in the previous bisection iteration.\n        val_lower_current = poly(xs, lower_bound)\n\n        # Determine which half of the interval contains the root\n        if val_lower_current * poly_mid < 0: # REQ-FZ-005.5\n            # Root is in the lower half [lower_bound, mid]\n            upper_bound = mid\n        else: # REQ-FZ-005.6 (implies poly(xs, upper_bound) * poly_mid < 0)\n            # Root is in the upper half [mid, upper_bound]\n            lower_bound = mid\n    \n    # If max_bisection_iterations reached without satisfying tolerance,\n    # return the last calculated midpoint as the best approximation (REQ-FZ-006).\n    return mid"}
{"task_id": "HumanEval/33", "solution": "```python\ndef sort_third(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n    \n    if not l: # Handle empty list\n        return []\n\n    # 1. Identify indices divisible by three and extract corresponding elements\n    indices_to_sort = []\n    elements_to_sort = []\n    for i in range(len(l)):\n        if i % 3 == 0:\n            indices_to_sort.append(i)\n            elements_to_sort.append(l[i])\n    \n    # 2. Sort the extracted elements\n    try:\n        elements_to_sort.sort()\n    except TypeError:\n        # Catch cases where elements are not sortable (e.g., mixed types like int and str)\n        raise TypeError(\"Elements at divisible-by-three indices must be sortable.\")\n\n    # 3. Create a new list and reconstruct it\n    result_list = list(l) # Start with a copy of the original list\n\n    # 4. Place sorted elements back into their original positions\n    for i, original_index in enumerate(indices_to_sort):\n        result_list[original_index] = elements_to_sort[i]\n        \n    return result_list\n```"}
{"task_id": "HumanEval/34", "solution": "```python\ndef unique(l: list) -> list:\n    \"\"\"Return sorted unique elements in a list\n\n    This function takes a list, extracts all unique elements,\n    and returns them in a new list sorted in ascending order.\n    The original list remains unchanged.\n\n    Args:\n        l (list): The input list. Elements must be comparable.\n\n    Returns:\n        list: A new list containing sorted unique elements.\n\n    Examples:\n        >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n        [0, 2, 3, 5, 9, 123]\n        >>> unique([])\n        []\n        >>> unique([1, 1, 1])\n        [1]\n        >>> unique(['b', 'a', 'c', 'b'])\n        ['a', 'b', 'c']\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n\n    # 1. Convert to a set to get unique elements. Sets inherently store only unique values.\n    unique_elements = set(l)\n\n    # 2. Convert the set back to a list and sort it.\n    # The sorted() function works directly on sets and returns a new sorted list.\n    sorted_unique_elements = sorted(unique_elements)\n\n    return sorted_unique_elements\n```"}
{"task_id": "HumanEval/35", "solution": "```python\ndef max_element(l: list) -> any:\n    \"\"\"\n    Finds and returns the maximum element in a list.\n\n    This function iterates through the list to find the largest element.\n    It handles empty lists by raising a ValueError.\n\n    Args:\n        l (list): A list of comparable elements (e.g., numbers, strings).\n\n    Returns:\n        any: The maximum element in the list.\n\n    Raises:\n        ValueError: If the input list is empty.\n        TypeError: If elements in the list are not comparable (e.g., mixing int and str).\n\n    Example Usage:\n        >>> max_element([1, 5, 2, 8, 3])\n        8\n        >>> max_element([-10, -1, -5])\n        -1\n        >>> max_element(['apple', 'banana', 'cherry'])\n        'cherry'\n        >>> max_element([])\n        Traceback (most recent call last):\n            ...\n        ValueError: Input list cannot be empty\n\n        # Example with incomparable types (will raise TypeError implicitly from Python's comparison)\n        # >>> max_element([1, 'a'])\n        # Traceback (most recent call last):\n        #     ...\n        # TypeError: '>' not supported between instances of 'str' and 'int'\n    \"\"\"\n    if not l:\n        raise ValueError(\"Input list cannot be empty\")\n\n    # Initialize max_val with the first element of the list\n    # This assumes the list is not empty, which is checked above.\n    max_val = l[0]\n\n    # Iterate through the rest of the elements starting from the second one\n    # If the list has only one element, this loop will not run, and max_val (the first element) will be returned.\n    for element in l[1:]:\n        if element > max_val:\n            max_val = element\n\n    return max_val\n```"}
{"task_id": "HumanEval/36", "solution": "```python\n# fizzbuzz_calculator/fizzbuzz.py\n\nclass FizzBuzzService:\n    @staticmethod\n    def _count_digit_occurrences(number: int, digit: str) -> int:\n        \"\"\"\n        Counts the occurrences of a specific digit in a number.\n\n        Args:\n            number (int): The integer to check for digit occurrences.\n            digit (str): The digit (as a string, e.g., '7') to count.\n\n        Returns:\n            int: The total count of the specified digit in the number.\n        \"\"\"\n        return str(number).count(digit)\n\n    @staticmethod\n    def fizz_buzz(n: int) -> int:\n        \"\"\"\n        Calculates the total number of times the digit '7' appears in integers\n        less than 'n' which are divisible by 11 or 13.\n\n        Args:\n            n (int): The upper limit (exclusive) for the integers to check.\n                     Must be a non-negative integer.\n\n        Returns:\n            int: The total count of the digit '7'.\n        \"\"\"\n        total_sevens_count = 0\n        for i in range(1, n):  # Iterate from 1 up to n-1\n            if (i % 11 == 0) or (i % 13 == 0):\n                total_sevens_count += FizzBuzzService._count_digit_occurrences(i, '7')\n        return total_sevens_count\n\n```"}
{"task_id": "HumanEval/37", "solution": "```python\ndef sort_even(l: list) -> list:\n    \"\"\"\n    This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n\n    Args:\n        l (list): The input list. Elements at even indices must be comparable.\n\n    Returns:\n        list: A new list with even-indexed elements sorted and odd-indexed elements preserved.\n\n    Raises:\n        TypeError: If the input 'l' is not a list.\n\n    Examples:\n        >>> sort_even([1, 2, 3])\n        [1, 2, 3]\n        >>> sort_even([5, 6, 3, 4])\n        [3, 6, 5, 4]\n        >>> sort_even([])\n        []\n        >>> sort_even([10])\n        [10]\n        >>> sort_even([10, 2, 8, 4, 6])\n        [6, 2, 8, 4, 10]\n        >>> sort_even([10, 5, 8, 3, 6, 1])\n        [6, 5, 8, 3, 10, 1]\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input 'l' must be a list.\")\n\n    if not l:\n        return []\n\n    # 1. Extract even-indexed elements\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n\n    # 2. Sort the extracted even-indexed elements\n    even_elements.sort()\n\n    # 3. Create the result list, preserving odd-indexed elements\n    result_list = l[:] # Create a shallow copy to preserve original odd elements and structure\n\n    # 4. Iterate through result_list and replace even-indexed elements with sorted ones\n    #    Use a pointer for the sorted_even_elements list\n    sorted_even_idx = 0\n    for i in range(0, len(result_list), 2):\n        result_list[i] = even_elements[sorted_even_idx]\n        sorted_even_idx += 1\n\n    return result_list\n```"}
{"task_id": "HumanEval/38", "solution": "```python\ndef decode_cyclic(encoded_string: str) -> str:\n    \"\"\"\n    Decodes a string that was encoded using the encode_cyclic function.\n\n    The encode_cyclic function works as follows:\n    1. Splits the input string into groups of three characters.\n    2. For each group of three, it cycles the characters (e.g., \"abc\" becomes \"bca\").\n    3. Groups with fewer than three characters are left unchanged.\n    4. Finally, it joins the modified groups back into a single string.\n\n    This function reverses that process.\n\n    Args:\n        encoded_string: The string to decode.\n\n    Returns:\n        The original, decoded string.\n    \"\"\"\n    decoded_parts = []\n    n = len(encoded_string)\n    for i in range(0, n, 3):\n        chunk = encoded_string[i:i+3]\n        if len(chunk) == 3:\n            # If original \"abc\" became \"bca\" (chunk[0]=b, chunk[1]=c, chunk[2]=a),\n            # to reverse \"bca\" back to \"abc\":\n            # The original 'a' is chunk[2].\n            # The original 'b' is chunk[0].\n            # The original 'c' is chunk[1].\n            decoded_chunk = chunk[2] + chunk[0] + chunk[1]\n            decoded_parts.append(decoded_chunk)\n        else:\n            # Groups with fewer than three characters are left unchanged by encode_cyclic,\n            # so they remain unchanged during decoding as well.\n            decoded_parts.append(chunk)\n\n    return \"\".join(decoded_parts)\n```"}
{"task_id": "HumanEval/39", "solution": "```python\nimport math\nfrom typing import Iterator\n\ndef _is_prime(num: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a prime number.\n\n    Parameters:\n        num (int): The integer to check.\n\n    Returns:\n        bool: True if num is prime, False otherwise.\n    \"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    # Check for odd divisors from 3 up to sqrt(num)\n    for i in range(3, int(math.sqrt(num)) + 1, 2):\n        if num % i == 0:\n            return False\n    return True\n\ndef _fib_generator() -> Iterator[int]:\n    \"\"\"\n    A generator function that yields Fibonacci numbers, starting from 2.\n    The sequence starts: 2, 3, 5, 8, 13, ...\n    (F_4, F_5, F_6, ...) based on the common F_0=0, F_1=1, F_2=1, F_3=2, F_4=3, F_5=5, ...\n    Or F_2=1, F_3=2, F_4=3, F_5=5, ...\n    Based on the SRS example (prime_fib(1) -> 2), it yields 2 as the first element.\n\n    Yields:\n        int: The next Fibonacci number in the sequence.\n    \"\"\"\n    # Initialize as F_2 and F_3 according to the conventional 0-indexed Fibonacci sequence\n    # where F_0=0, F_1=1, F_2=1, F_3=2\n    # The SRS states \"starting from F_3 = 2\", and yields 2, 3, 5...\n    # So, we'll start with a=1 (F_2) and b=2 (F_3) and yield b first.\n    a, b = 1, 2  # a represents F_{k-1}, b represents F_k\n    yield b      # Yield the first relevant Fibonacci number, which is 2 (F_3)\n\n    while True:\n        next_fib = a + b\n        a = b\n        b = next_fib\n        yield b\n\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    if n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n    found_primes_count = 0\n    fib_gen = _fib_generator()\n\n    while True:\n        current_fib = next(fib_gen)\n        if _is_prime(current_fib):\n            found_primes_count += 1\n            if found_primes_count == n:\n                return current_fib\n\n```"}
{"task_id": "HumanEval/40", "solution": "```python\nimport math\n\ndef triples_sum_to_zero(l: list) -> bool:\n    \"\"\"\n    Determines if a given list of integers contains three distinct elements\n    that sum up to zero.\n\n    Args:\n        l (list[int]): A list of integer numbers.\n\n    Returns:\n        bool: True if three distinct elements in l sum to zero, False otherwise.\n    \"\"\"\n    # REQ-FUNC-002: Return False if the input list l contains fewer than three elements.\n    if len(l) < 3:\n        return False\n\n    # Create a sorted copy of the input list.\n    # This step is O(N log N) time complexity and O(N) space complexity (for the copy).\n    nums = sorted(l)\n    n = len(nums)\n\n    # Iterate through the array to fix the first element 'a'.\n    # REQ-FUNC-003: Identify if there exist three distinct elements l[i], l[j], l[k]\n    # (where i \u2260 j, j \u2260 k, i \u2260 k) such that their sum l[i] + l[j] + l[k] equals zero.\n    for i in range(n - 2):\n        # Optimization: Skip duplicate elements for the first number 'a'\n        # to avoid processing duplicate triplets and improve performance.\n        if i > 0 and nums[i] == nums[i - 1]:\n            continue\n\n        # If nums[i] is already positive, then no way to get a sum of zero with\n        # two other non-negative numbers after it.\n        # This is an optimization, not strictly required for correctness but improves average performance.\n        if nums[i] > 0:\n            break\n\n        # Initialize two pointers for the remaining part of the array.\n        # 'left' pointer starts immediately after 'i'.\n        # 'right' pointer starts at the end of the array.\n        left = i + 1\n        right = n - 1\n\n        # Search for the other two numbers 'b' and 'c' using the two-pointer technique.\n        while left < right:\n            current_sum = nums[i] + nums[left] + nums[right]\n\n            if current_sum == 0:\n                # REQ-FUNC-004: If such a triplet of distinct elements summing to zero is found,\n                # the system shall return True.\n                return True\n            elif current_sum < 0:\n                # Sum is too small, need to increase it. Move the left pointer forward.\n                left += 1\n            else:  # current_sum > 0\n                # Sum is too large, need to decrease it. Move the right pointer backward.\n                right -= 1\n\n    # REQ-FUNC-005: If no such triplet of distinct elements summing to zero is found\n    # after checking all possible combinations, the system shall return False.\n    return False\n```"}
{"task_id": "HumanEval/41", "solution": "```python\ndef car_race_collision(n: int) -> int:\n    \"\"\"\n    Imagine a road that's a perfectly straight infinitely long line.\n    n cars are driving left to right; simultaneously, a different set of n cars\n    are driving right to left. The two sets of cars start out being very far from\n    each other. All cars move in the same speed. Two cars are said to collide\n    when a car that's moving left to right hits a car that's moving right to left.\n    However, the cars are infinitely sturdy and strong; as a result, they continue moving\n    in their trajectory as if they did not collide.\n\n    This function outputs the number of such collisions.\n\n    Args:\n        n (int): The number of cars in each set (n L-cars and n R-cars).\n\n    Returns:\n        int: The total number of collisions.\n\n    Raises:\n        TypeError: If `n` is not an integer.\n        ValueError: If `n` is a negative integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    # Each of the n L-cars will collide with each of the n R-cars.\n    # Since cars pass through each other, each pair collides exactly once.\n    # Total collisions = (number of L-cars) * (number of R-cars)\n    return n * n\n```"}
{"task_id": "HumanEval/42", "solution": "```python\ndef incr_list(l: list) -> list:\n    \"\"\"Return a new list with elements incremented by 1.\n\n    This function iterates through the input list and creates a new list\n    where each element is the original element plus one. The original\n    list is not modified.\n\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    >>> incr_list([])\n    []\n    >>> incr_list([1.5, 2.5])\n    [2.5, 3.5]\n    \"\"\"\n    return [x + 1 for x in l]\n```"}
{"task_id": "HumanEval/43", "solution": "```python\ndef pairs_sum_to_zero(l: list[int]) -> bool:\n    \"\"\"\n    Checks if there exist two distinct elements within the input list that sum to zero.\n\n    Two elements x and y from a list l are considered distinct if they originate\n    from different indices in the list (e.g., l[i] and l[j] where i != j),\n    even if their values are identical (e.g., [0, 0] should return True).\n\n    Args:\n        l: A list of integers.\n\n    Returns:\n        True if two distinct elements sum to zero, False otherwise.\n\n    Examples:\n        >>> pairs_sum_to_zero([1, 2, -1])\n        True\n        >>> pairs_sum_to_zero([3, 4, 5])\n        False\n        >>> pairs_sum_to_zero([0, 0])\n        True\n        >>> pairs_sum_to_zero([])\n        False\n        >>> pairs_sum_to_zero([5])\n        False\n        >>> pairs_sum_to_zero([-7, 7, 10])\n        True\n    \"\"\"\n    if len(l) < 2:\n        return False\n\n    seen_numbers = set()\n    for number in l:\n        complement = -number\n        if complement in seen_numbers:\n            return True\n        seen_numbers.add(number)\n\n    return False\n```"}
{"task_id": "HumanEval/44", "solution": "```python\nclass BaseConverter:\n    @staticmethod\n    def change_base(x: int, base: int) -> str:\n        \"\"\"\n        Converts a non-negative decimal integer to its string representation\n        in a specified numerical base.\n\n        Args:\n            x (int): The non-negative integer to be converted.\n            base (int): The target base for conversion (an integer between 2 and 9).\n\n        Returns:\n            str: A string representing x in the specified base.\n\n        Raises:\n            ValueError: If 'base' is outside the range [2, 9].\n        \"\"\"\n        if not (2 <= base <= 9):\n            raise ValueError(\"Base must be an integer between 2 and 9 (inclusive).\")\n\n        if x == 0:\n            return \"0\"\n\n        digits = []\n        current_x = x\n        while current_x > 0:\n            remainder = current_x % base\n            digits.append(str(remainder))\n            current_x //= base\n\n        # Digits are collected in reverse order (least significant first),\n        # so we need to reverse them before joining to get the correct order.\n        return \"\".join(reversed(digits))\n\n```"}
{"task_id": "HumanEval/45", "solution": "```python\ndef triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    if not (isinstance(a, (int, float)) and a > 0):\n        raise ValueError(\"Base must be a positive number.\")\n    if not (isinstance(h, (int, float)) and h > 0):\n        raise ValueError(\"Height must be a positive number.\")\n    return 0.5 * a * h\n\n```"}
{"task_id": "HumanEval/46", "solution": "```python\ndef fib4(n: int) -> int:\n    \"\"\"\n    Computes the n-th element of the fib4 number sequence.\n\n    The sequence is defined as:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4) for n > 3\n\n    This implementation uses an iterative approach with O(1) space complexity\n    to avoid recursion and redundant calculations.\n\n    Args:\n        n: The non-negative integer index of the desired fib4 number.\n\n    Returns:\n        The n-th fib4 number.\n\n    Raises:\n        ValueError: If n is a negative integer.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    \n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # Initialize the last four values for n=0, 1, 2, 3 respectively\n    # These represent fib4(i-4), fib4(i-3), fib4(i-2), fib4(i-1) in the loop\n    a = 0  # Represents fib4(k-4)\n    b = 0  # Represents fib4(k-3)\n    c = 2  # Represents fib4(k-2)\n    d = 0  # Represents fib4(k-1)\n\n    # Iterate from n=4 up to the desired 'n'\n    for _ in range(4, n + 1):\n        next_fib = d + c + b + a\n        # Shift values for the next iteration\n        a = b\n        b = c\n        c = d\n        d = next_fib\n        \n    return d\n```"}
{"task_id": "HumanEval/47", "solution": "```python\nfrom typing import List, Union\n\ndef median(l: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the median of a list of numbers.\n\n    The median is the middle element of a sorted list.\n    If the list has an odd number of elements, the median is the middle element.\n    If the list has an even number of elements, the median is the average of the two middle elements.\n\n    Args:\n        l: A list of numbers (integers or floats).\n\n    Returns:\n        The median of the elements in the list, which can be an int or float.\n\n    Raises:\n        ValueError: If the input list is empty.\n\n    Examples:\n        >>> median([3, 1, 2, 4, 5])\n        3\n        >>> median([-10, 4, 6, 1000, 10, 20])\n        15.0\n        >>> median([1])\n        1\n        >>> median([1, 2])\n        1.5\n    \"\"\"\n    if not l:\n        raise ValueError(\"Input list cannot be empty\")\n\n    # Create a sorted copy to avoid modifying the original list\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # Odd number of elements\n        middle_index = n // 2\n        return sorted_l[middle_index]\n    else:\n        # Even number of elements\n        # Python's integer division (//) gives the floor, so n // 2 is the right-middle index.\n        # The left-middle index is n // 2 - 1.\n        middle_idx1 = n // 2 - 1\n        middle_idx2 = n // 2\n        return (sorted_l[middle_idx1] + sorted_l[middle_idx2]) / 2.0\n```"}
