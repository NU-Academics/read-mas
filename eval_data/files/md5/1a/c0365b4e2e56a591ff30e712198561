{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = []\n    for i, num in enumerate(numbers):\n        if i > 0:\n            result.append(delimeter)\n        result.append(num)\n    return result"}
{"task_id": "HumanEval/6", "solution": "from typing import List, Optional\nimport re\nfrom collections import deque\nfrom datetime import datetime\n\n\n# --- Exception Classes (from src/parens/exceptions.py) ---\nclass ParseError(Exception):\n    \"\"\"Base exception for parsing errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n\nclass InputValidationError(ParseError):\n    \"\"\"Exception raised for invalid input characters or malformed groups.\"\"\"\n    pass\n\n\nclass UnbalancedParenthesesError(ParseError):\n    \"\"\"Exception raised when parentheses within a group are unbalanced.\"\"\"\n    pass\n\n\n# --- Utility Functions (from src/parens/utils.py) ---\ndef split_groups(s: str) -> List[str]:\n    \"\"\"Splits a string into a list of non-empty groups based on whitespace.\"\"\"\n    return [g for g in re.split(r'\\s+', s.strip()) if g]\n\n\n# --- Validator Class (from src/parens/validators.py) ---\nclass InputValidator:\n    \"\"\"Validates input groups for allowed characters and non-emptiness.\"\"\"\n    ALLOWED_CHARS = set(\"()\")\n\n    def validate_group(self, group: str) -> None:\n        \"\"\"Raises InputValidationError if the group is empty or contains invalid characters.\"\"\"\n        if not group:\n            raise InputValidationError(\"Empty group is not allowed.\")\n        invalid = set(group) - self.ALLOWED_CHARS\n        if invalid:\n            raise InputValidationError(f\"Invalid characters found in group: {', '.join(sorted(list(invalid)))}\")\n\n    def validate_all(self, groups: List[str]) -> None:\n        \"\"\"Validates all groups in a list, raising an error on the first invalid group.\"\"\"\n        for group in groups:\n            self.validate_group(group)\n\n\n# --- Parser Class (from src/parens/parser.py) ---\nclass ParenthesesParser:\n    \"\"\"Computes the deepest nesting level for a single parenthesis group.\"\"\"\n    def parse_group(self, group: str) -> int:\n        \"\"\"\n        Scans characters to compute max depth, raising UnbalancedParenthesesError if invalid.\n        Depth must not go negative and must be zero at the end for a balanced group.\n        \"\"\"\n        depth = 0\n        max_depth = 0\n        for ch in group:\n            if ch == '(':\n                depth += 1\n                if depth > max_depth:\n                    max_depth = depth\n            elif ch == ')':\n                depth -= 1\n                if depth < 0:\n                    raise UnbalancedParenthesesError(\"Too many closing parentheses in group.\")\n        if depth != 0:\n            raise UnbalancedParenthesesError(\"Unbalanced parentheses: open parentheses unmatched at end of group.\")\n        return max_depth\n\n\n# --- Data Models (from src/parens/models.py) ---\nclass ParseResult:\n    \"\"\"Data transfer object for parsing results.\"\"\"\n    def __init__(self, input: str, result: List[int]):\n        self.input = input\n        self.result = result\n\n    def to_dict(self) -> dict:\n        return {\"input\": self.input, \"result\": self.result}\n\n\nclass ParseRecord:\n    \"\"\"Data transfer object for a persisted parse run record.\"\"\"\n    def __init__(self, timestamp: str, input: str, result: List[int], error: Optional[str]):\n        self.timestamp = timestamp\n        self.input = input\n        self.result = result\n        self.error = error\n\n    def to_dict(self) -> dict:\n        return {\n            \"timestamp\": self.timestamp,\n            \"input\": self.input,\n            \"result\": self.result,\n            \"error\": self.error\n        }\n\n\n# --- Repository Class (from src/parens/repository.py) ---\nclass InMemoryRepository:\n    \"\"\"Stores recent parse run records in a bounded in-memory deque.\"\"\"\n    def __init__(self, capacity: int = 100):\n        self.capacity = capacity\n        self.store: deque[ParseRecord] = deque()\n\n    def add(self, record: ParseRecord) -> None:\n        \"\"\"Adds a parse record to the repository, evicting oldest if capacity is exceeded.\"\"\"\n        self.store.append(record)\n        if len(self.store) > self.capacity:\n            self.store.popleft()\n\n    def list_all(self) -> List[ParseRecord]:\n        \"\"\"Returns all records currently in the repository.\"\"\"\n        return list(self.store)\n\n    def clear(self) -> None:\n        \"\"\"Clears all records from the repository.\"\"\"\n        self.store.clear()\n\n\n# --- Service Class (from src/parens/service.py) ---\nclass ParserService:\n    \"\"\"Orchestrates validation, parsing, and optional persistence for parenthesis groups.\"\"\"\n    def __init__(self, repository: Optional[InMemoryRepository] = None,\n                 validator: Optional[InputValidator] = None,\n                 parser: Optional[ParenthesesParser] = None):\n        self.repository = repository\n        self.validator = validator if validator is not None else InputValidator()\n        self.parser = parser if parser is not None else ParenthesesParser()\n\n    def parse_all(self, input_str: str) -> List[int]:\n        \"\"\"\n        Splits input into groups, validates them, and computes max nesting depth for each.\n        Returns a list of depths, raising exceptions on validation or parsing errors.\n        \"\"\"\n        groups = split_groups(input_str)\n        \n        if not groups and not input_str.strip():\n             return []\n\n        self.validator.validate_all(groups)\n        results = []\n        for g in groups:\n            results.append(self.parser.parse_group(g))\n        return results\n\n    def parse_and_record(self, input_str: str) -> ParseRecord:\n        \"\"\"\n        Parses input, records the outcome (success or error), and then re-raises any exception.\n        Stores the ParseRecord in the repository if one is configured.\n        \"\"\"\n        result: List[int] = []\n        error_message: Optional[str] = None\n        \n        try:\n            result = self.parse_all(input_str)\n        except (InputValidationError, UnbalancedParenthesesError) as e:\n            error_message = str(e)\n            raise # Re-raise the exception after recording\n        finally:\n            record = ParseRecord(\n                timestamp=datetime.now().isoformat(),\n                input=input_str,\n                result=result,\n                error=error_message\n            )\n            if self.repository:\n                self.repository.add(record)\n        return record\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n    \"\"\"\n    service = ParserService()\n    return service.parse_all(paren_string)"}
{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    filtered_strings = []\n    for s in strings:\n        if substring in s:\n            filtered_strings.append(s)\n    return filtered_strings"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total = 0\n    prod = 1\n    for n in numbers:\n        total += n\n        prod *= n\n    return total, prod"}
{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    total = 0\n    product_val = 1\n\n    for num in numbers:\n        total += num\n        product_val *= num\n\n    return (total, product_val)"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n    \n    result: List[int] = []\n    current_max = numbers[0]\n    for n in numbers:\n        if n > current_max:\n            current_max = n\n        result.append(current_max)\n    return result"}
