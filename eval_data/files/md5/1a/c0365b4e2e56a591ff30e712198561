{"task_id": "HumanEval/134", "solution": "import os\nimport uuid\nimport datetime\nimport json\n\ndef check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an alphabetical character\n    and is a standalone single-letter word.\n    \"\"\"\n\n    class TextInput:\n        def __init__(self, content: str):\n            self.content = content\n\n    class CheckResult:\n        def __init__(self, id: str, input_text: str, result: bool, timestamp: str):\n            self.id = id\n            self.input_text = input_text\n            self.result = result\n            self.timestamp = timestamp\n        def to_dict(self) -> dict:\n            return {\n                \"id\": self.id,\n                \"input_text\": self.input_text,\n                \"result\": self.result,\n                \"timestamp\": self.timestamp\n            }\n\n    class ValidationError(Exception):\n        pass\n\n    class RepositoryError(Exception):\n        pass\n\n    def get_audit_path() -> str:\n        return os.environ.get(\"LASTCHAR_AUDIT_PATH\", \"lastchar_audit.jsonl\")\n\n    class Validators:\n        def is_alpha(self, ch: str) -> bool:\n            return isinstance(ch, str) and len(ch) == 1 and ch.isalpha()\n\n        def tokenize_on_spaces(self, txt: str) -> list:\n            return txt.split(\" \")\n\n        def is_single_letter_token(self, token: str) -> bool:\n            return len(token) == 1 and self.is_alpha(token)\n\n    class ResultRepository:\n        def __init__(self, path: str):\n            self._path = path\n\n        def persist(self, result):\n            try:\n                with open(self._path, \"a\", encoding=\"utf-8\") as fh:\n                    fh.write(json.dumps(result.to_dict(), ensure_ascii=False) + \"\\n\")\n            except OSError as e:\n                raise RepositoryError(str(e))\n\n    class CheckerService:\n        def __init__(self, repository, validators):\n            self.repository = repository\n            self.validators = validators\n\n        def _evaluate(self, content: str) -> bool:\n            if not isinstance(content, str):\n                raise ValidationError(\"input must be str\")\n            if content == \"\":\n                return False\n            if content[-1] == \" \":\n                return False\n            tokens = self.validators.tokenize_on_spaces(content)\n            if not tokens:\n                return False\n            last_token = tokens[-1]\n            return self.validators.is_single_letter_token(last_token)\n\n        def check(self, text_input: TextInput) -> CheckResult:\n            if text_input is None or not isinstance(text_input.content, str):\n                raise ValidationError(\"TextInput.content must be a string\")\n            \n            outcome = self._evaluate(text_input.content)\n            result = CheckResult(str(uuid.uuid4()), text_input.content, outcome, datetime.datetime.utcnow().isoformat()+\"Z\")\n            try:\n                self.repository.persist(result)\n            except RepositoryError:\n                # Audit log write failure should not prevent main function result.\n                pass\n            return result\n\n    # Main logic as per src/lastcharchecker/api.py snippet\n    repo = ResultRepository(get_audit_path())\n    svc = CheckerService(repository=repo, validators=Validators())\n    result = svc.check(TextInput(txt))\n    return result.result"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Create a function which returns the largest index of an element which\n    is not greater than or equal to the element immediately preceding it. If\n    no such element exists then return -1. The given array will not contain\n    duplicate values.\n\n    Examples:\n    can_arrange([1,2,4,3,5]) = 3\n    can_arrange([1,2,3]) = -1\n    \"\"\"\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i - 1]:\n            return i\n    return -1"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    '''\n    largest_negative = None\n    smallest_positive = None\n\n    for num in lst:\n        if num < 0:\n            if largest_negative is None or num > largest_negative:\n                largest_negative = num\n        elif num > 0:\n            if smallest_positive is None or num < smallest_positive:\n                smallest_positive = num\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Returns the largest index of an element which is strictly less than the element\n    immediately preceding it. Returns -1 if no such element exists.\n    \"\"\"\n    n = len(arr)\n    if n < 2:\n        return -1\n    for i in range(n - 1, 0, -1):\n        if arr[i] < arr[i - 1]:\n            return i\n    return -1"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compares two numbers (int, float, or string representations) and returns the larger in its original type, or None if equal.\n    Handles ',' or '.' as decimal separators in strings.\n    \"\"\"\n\n    class CompareError(Exception):\n        \"\"\"Custom exception for comparison-related errors.\"\"\"\n        def __init__(self, message: str):\n            self.message = message\n            super().__init__(message)\n\n    def is_number_like(s: str) -> bool:\n        \"\"\"\n        Checks if a string broadly resembles a number, allowing for optional sign and a single decimal separator.\n        \"\"\"\n        s_stripped = s.strip()\n        if not s_stripped:\n            return False\n\n        if s_stripped[0] in ('+', '-'):\n            s_stripped = s_stripped[1:]\n            if not s_stripped:\n                return False\n\n        dot_count = s_stripped.count('.')\n        comma_count = s_stripped.count(',')\n\n        if dot_count > 1 or comma_count > 1 or (dot_count == 1 and comma_count == 1):\n            return False\n        \n        if dot_count == 1:\n            s_stripped = s_stripped.replace('.', '')\n        elif comma_count == 1:\n            s_stripped = s_stripped.replace(',', '')\n            \n        return s_stripped.isdigit()\n\n    def normalize_decimal(s: str) -> str:\n        \"\"\"\n        Normalizes decimal separators in a string, replacing ',' with '.' if safe.\n        Raises CompareError for ambiguous formats (e.g., both '.' and ',').\n        \"\"\"\n        s_stripped = s.strip()\n        dot_count = s_stripped.count('.')\n        comma_count = s_stripped.count(',')\n\n        if dot_count >= 1 and comma_count >= 1:\n            raise CompareError(f\"Ambiguous numeric string format: '{s}'. Contains both '.' and ','.\")\n        \n        if comma_count > 1:\n             raise CompareError(f\"Invalid numeric string format: '{s}'. Multiple comma separators detected.\")\n\n        if comma_count == 1:\n            return s_stripped.replace(',', '.')\n        \n        return s_stripped\n\n    def _parse_str_to_float(s: str) -> float:\n        \"\"\"\n        Parses a string representation to a float after validation and normalization.\n        \"\"\"\n        if not is_number_like(s):\n            raise CompareError(f\"Invalid numeric string format: '{s}'\")\n        \n        normalized_s = normalize_decimal(s)\n        \n        try:\n            return float(normalized_s)\n        except ValueError:\n            raise CompareError(f\"Cannot parse numeric string: '{s}' into a float.\")\n    \n    def _get_numeric_and_original(value):\n        \"\"\"\n        Converts an input (int, float, or str) into its numeric float representation and returns the original value.\n        \"\"\"\n        if isinstance(value, (int, float)):\n            return float(value), value\n        elif isinstance(value, str):\n            numeric_val = _parse_str_to_float(value)\n            return numeric_val, value\n        else:\n            raise CompareError(f\"Unsupported input type: {type(value)}\")\n\n    numeric_a, original_a = _get_numeric_and_original(a)\n    numeric_b, original_b = _get_numeric_and_original(b)\n\n    if numeric_a > numeric_b:\n        return original_a\n    elif numeric_b > numeric_a:\n        return original_b\n    else:\n        return None"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n\n    Examples:\n    largest_smallest_integers([2, 4, 1, 3, 5, 7]) == (None, 1)\n    largest_smallest_integers([]) == (None, None)\n    largest_smallest_integers([0]) == (None, None)\n    '''\n    largest_negative = None\n    smallest_positive = None\n\n    for num in lst:\n        if num < 0:\n            if largest_negative is None or num > largest_negative:\n                largest_negative = num\n        elif num > 0:\n            if smallest_positive is None or num < smallest_positive:\n                smallest_positive = num\n        # num == 0 is ignored as per requirements\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n    \"\"\"\n\n    from typing import Any, Optional, Union\n\n    class ParseError(ValueError):\n        \"\"\"Custom exception for errors during numeric string parsing.\"\"\"\n        pass\n\n    class NumberValue:\n        \"\"\"Represents a parsed numeric input, retaining its original value and type.\"\"\"\n        def __init__(self, original_value: Any, numeric_value: float, original_type: str) -> None:\n            self.original_value = original_value\n            self.numeric_value = numeric_value\n            self.original_type = original_type\n\n        def __repr__(self) -> str:\n            return f\"NumberValue({self.original_value!r}, {self.numeric_value}, {self.original_type})\"\n\n    def sanitize_numeric_string(s: str) -> str:\n        \"\"\"Trims whitespace and replaces comma decimal with dot.\"\"\"\n        s_trim = s.strip()\n        s_norm = s_trim.replace(',', '.')\n        return s_norm\n\n    def _parse_value(value: Any) -> NumberValue:\n        \"\"\"Parses an input value (int, float, or str) into a NumberValue object.\"\"\"\n        if isinstance(value, int):\n            return NumberValue(value, float(value), 'int')\n        if isinstance(value, float):\n            return NumberValue(value, value, 'float')\n        if isinstance(value, str):\n            s = sanitize_numeric_string(value)\n            try:\n                num = float(s)\n            except ValueError as e:\n                raise ParseError(f\"Cannot parse numeric string: {value!r}\") from e\n            return NumberValue(value, num, 'str')\n        raise ParseError(f\"Unsupported type: {type(value).__name__}\")\n\n    EPSILON = 1e-12\n\n    def _is_equal(num1: float, num2: float) -> bool:\n        \"\"\"Compares two floats for equality within a small tolerance.\"\"\"\n        return abs(num1 - num2) <= EPSILON\n\n    def _compare_numeric_values(na: NumberValue, nb: NumberValue) -> Optional[Any]:\n        \"\"\"Compares two NumberValue objects and returns the larger original value or None if equal.\"\"\"\n        if _is_equal(na.numeric_value, nb.numeric_value):\n            return None\n        return na.original_value if na.numeric_value > nb.numeric_value else nb.original_value\n\n    na = _parse_value(a)\n    nb = _parse_value(b)\n    return _compare_numeric_values(na, nb)"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\"\"\"\n    return n % 2 == 0 and n >= 8"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    # A number can be written as the sum of exactly 4 positive even numbers\n    # if and only if it is an even number and is greater than or equal to 8 (2+2+2+2).\n    return (n % 2 == 0) and (n >= 8)"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    MIN_RUN_FOR_DASH = 3 # From design context, 3 or more spaces -> hyphen\n\n    out_chars = []\n    i = 0\n    n = len(text)\n    while i < n:\n        ch = text[i]\n        if ch == ' ':\n            # Count consecutive spaces\n            j = i + 1\n            while j < n and text[j] == ' ':\n                j += 1\n            run_len = j - i\n            \n            if run_len >= MIN_RUN_FOR_DASH:\n                out_chars.append('-')\n            else:\n                out_chars.append('_' * run_len) # Replace 1 or 2 spaces with underscores\n            i = j # Move index past the processed run of spaces\n        else:\n            out_chars.append(ch)\n            i += 1\n    return ''.join(out_chars)"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    total_special_factorial = 1\n    current_factorial = 1\n    for k in range(1, n + 1):\n        current_factorial *= k\n        total_special_factorial *= current_factorial\n    return total_special_factorial"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n\n    def _factorial(k):\n        \"\"\"Calculates the factorial of k for k >= 0.\"\"\"\n        res = 1\n        for i in range(2, k + 1):\n            res *= i\n        return res\n\n    total_product = 1\n    for i in range(1, n + 1):\n        total_product *= _factorial(i)\n    \n    return total_product"}
{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    # The minimum number of consecutive spaces that should be replaced by a hyphen.\n    MIN_HYPHEN_RUN = 3\n\n    # Define a replacement function for re.sub that applies the transformation logic.\n    def repl(m):\n        run = m.group(0)  # Get the matched sequence of spaces\n        if len(run) >= MIN_HYPHEN_RUN:\n            return '-'  # Replace sequences of 3 or more spaces with a single hyphen\n        return '_' * len(run)  # Replace each individual space with an underscore\n\n    # Use re.sub with a regex to find all sequences of one or more spaces and apply the replacement function.\n    return re.sub(r' +', repl, text)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific rules.\"\"\"\n\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    parts = file_name.split('.')\n    if len(parts) != 2:\n        return 'No'\n\n    name_part = parts[0]\n    ext_part = parts[1]\n\n    if not name_part:\n        return 'No'\n\n    first_char_name = name_part[0]\n    if not ('a' <= first_char_name <= 'z' or 'A' <= first_char_name <= 'Z'):\n        return 'No'\n\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if ext_part not in allowed_extensions:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    \"\"\"\n    # Condition 1: There should not be more than three digits ('0'-'9')\n    digit_count = sum(1 for char in file_name if char.isdigit())\n    if digit_count > 3:\n        return 'No'\n\n    # Condition 2: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split into name and extension parts.\n    name_part, ext_part = file_name.rsplit('.', 1)\n\n    # Condition 3: The substring before the dot should not be empty.\n    if not name_part:\n        return 'No'\n\n    # Condition 3: ...and it starts with a letter from the latin alphapet.\n    if not name_part[0].isalpha():\n        return 'No'\n\n    # Condition 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    valid_extensions = ['txt', 'exe', 'dll']\n    if ext_part not in valid_extensions:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    \n    if not lst:\n        return 0\n\n    transformed_elements = []\n    for i, val in enumerate(lst):\n        if i % 3 == 0:\n            transformed_elements.append(val * val)\n        elif i % 4 == 0: \n            transformed_elements.append(val * val * val)\n        else:\n            transformed_elements.append(val)\n            \n    return sum(transformed_elements)"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Calculates the sum of transformed integers in a list based on their indices.\n    Index-0-based rules: square if index is a multiple of 3, cube if index is a multiple of 4 and not 3, else keep original.\n    \"\"\"\n    total_sum = 0\n    for i, val in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += val ** 2\n        elif i % 4 == 0:  # and i % 3 != 0, this condition is implicitly handled by the `elif`\n            total_sum += val ** 3\n        else:\n            total_sum += val\n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    You are given a string representing a sentence,\n    the sentence contains some words separated by a space,\n    and you have to return a string that contains the words from the original sentence,\n    whose lengths are prime numbers,\n    the order of the words in the new string should be the same as the original one.\n    \"\"\"\n    def is_prime(n):\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split()\n    \n    prime_length_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n            \n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/143", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Checks if a number is prime.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef words_in_sentence(sentence):\n    \"\"\"\n    Returns a string containing words from the original sentence whose lengths are prime numbers.\n    \"\"\"\n    words = sentence.split()\n    filtered_words = [word for word in words if is_prime(len(word))]\n    return \" \".join(filtered_words)"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n    \"\"\"\n    import math\n\n    def _parse_fraction(frac_str):\n        \"\"\"Parses a fraction string 'num/den' into (numerator, denominator) integers.\n        Assumes valid format and positive whole numbers per problem statement.\n        \"\"\"\n        parts = frac_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return numerator, denominator\n\n    def _gcd(a, b):\n        \"\"\"Returns the greatest common divisor using math.gcd.\"\"\"\n        return math.gcd(a, b)\n\n    def _is_product_whole(a_num, a_den, b_num, b_den):\n        \"\"\"Determines if (a_num/a_den) * (b_num/b_den) is a whole number\n        using cross-cancellation to avoid overflow.\n        \"\"\"\n        # Cross-cancellation: reduce a_num with b_den\n        common_divisor_1 = _gcd(a_num, b_den)\n        a_num_reduced = a_num // common_divisor_1\n        b_den_reduced = b_den // common_divisor_1\n\n        # Cross-cancellation: reduce b_num with a_den\n        common_divisor_2 = _gcd(b_num, a_den)\n        b_num_reduced = b_num // common_divisor_2\n        a_den_reduced = a_den // common_divisor_2\n\n        # Final product's components after cancellation\n        final_numerator = a_num_reduced * b_num_reduced\n        final_denominator = a_den_reduced * b_den_reduced\n\n        # A fraction simplified to its lowest terms is a whole number if its denominator is 1.\n        return final_denominator == 1\n\n    # Parse x and n into their numerator and denominator components\n    x_num, x_den = _parse_fraction(x)\n    n_num, n_den = _parse_fraction(n)\n\n    # Check if the product of the two fractions is a whole number\n    return _is_product_whole(x_num, x_den, n_num, n_den)"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If sums are equal, original order is preserved.\n    \"\"\"\n\n    def compute_digit_sum(n):\n        \"\"\"Calculates the sum of the absolute value of digits for an integer.\"\"\"\n        return sum(int(d) for d in str(abs(n)))\n\n    # Pair each number with its digit sum and original index\n    # (digit_sum, original_index, number)\n    decorated = []\n    for i, num in enumerate(nums):\n        digit_sum = compute_digit_sum(num)\n        decorated.append((digit_sum, i, num))\n\n    # Sort the decorated list. Python's sort is stable,\n    # but explicitly including the original index as a secondary key\n    # ensures stability and makes the sorting criteria explicit.\n    decorated.sort(key=lambda x: (x[0], x[1]))\n\n    # Extract the original numbers in the new sorted order\n    return [num for _, _, num in decorated]"}
{"task_id": "HumanEval/144", "solution": "import threading\nfrom collections import OrderedDict\nfrom typing import Optional\n\nclass FractionParseError(ValueError):\n    \"\"\"Custom exception for fraction parsing errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef gcd(a: int, b: int) -> int:\n    \"\"\"Computes the greatest common divisor of two integers.\"\"\"\n    while b:\n        a, b = b, a % b\n    return abs(a)\n\nclass Fraction:\n    \"\"\"Represents a fraction with integer numerator and denominator.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        if denominator == 0:\n            raise FractionParseError(\"Denominator cannot be zero.\")\n        self.numerator = numerator\n        self.denominator = denominator\n\n    def simplify(self) -> \"Fraction\":\n        \"\"\"Returns a new simplified Fraction.\"\"\"\n        common = gcd(self.numerator, self.denominator)\n        return Fraction(self.numerator // common, self.denominator // common)\n\n    def multiply(self, other: \"Fraction\") -> \"Fraction\":\n        \"\"\"Multiplies this fraction by another and returns a new unsimplified Fraction.\"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole(self) -> bool:\n        \"\"\"Returns True if the simplified fraction has a denominator of 1.\"\"\"\n        simplified_fraction = self.simplify()\n        return simplified_fraction.denominator == 1\n\n    def to_tuple(self) -> tuple[int, int]:\n        \"\"\"Returns the fraction as a (numerator, denominator) tuple.\"\"\"\n        return (self.numerator, self.denominator)\n\n    def __eq__(self, other):\n        if not isinstance(other, Fraction):\n            return NotImplemented\n        s_self = self.simplify()\n        s_other = other.simplify()\n        return s_self.numerator == s_other.numerator and s_self.denominator == s_other.denominator\n\n    def __hash__(self):\n        s = self.simplify()\n        return hash((s.numerator, s.denominator))\n\ndef parse_fraction(s: str) -> \"Fraction\":\n    \"\"\"Parses a string into a Fraction object.\"\"\"\n    parts = s.split('/')\n    if len(parts) != 2:\n        raise FractionParseError(f\"Invalid fraction format: {s}. Expected 'numerator/denominator'.\")\n    try:\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n    except ValueError:\n        raise FractionParseError(f\"Invalid number in fraction: {s}. Numerator and denominator must be integers.\")\n\n    # Numerators and denominators must be positive whole numbers (greater than zero)\n    if numerator <= 0 or denominator <= 0:\n        raise FractionParseError(f\"Numerators and denominators must be positive whole numbers (greater than zero): {s}.\")\n    \n    return Fraction(numerator, denominator)\n\nclass FractionCacheRepository:\n    \"\"\"A thread-safe in-memory cache for parsed Fraction objects.\"\"\"\n    DEFAULT_MAX_ENTRIES: int = 10000\n\n    def __init__(self):\n        self._store: OrderedDict[str, Fraction] = OrderedDict()\n        self._lock = threading.Lock()\n\n    def get(self, key: str) -> Optional[\"Fraction\"]:\n        \"\"\"Retrieves a Fraction from the cache.\"\"\"\n        with self._lock:\n            return self._store.get(key)\n\n    def set(self, key: str, value: \"Fraction\") -> None:\n        \"\"\"Stores a Fraction in the cache, with simple LRU eviction.\"\"\"\n        with self._lock:\n            if key in self._store:\n                self._store.move_to_end(key)\n            self._store[key] = value\n            if len(self._store) > self.DEFAULT_MAX_ENTRIES:\n                self._store.popitem(last=False) # LRU eviction\n\n    def clear(self) -> None:\n        \"\"\"Clears the cache.\"\"\"\n        with self._lock:\n            self._store.clear()\n\nclass SimplifyService:\n    \"\"\"Business logic for checking if a product of fractions is a whole number.\"\"\"\n    def __init__(self, repo: Optional[\"FractionCacheRepository\"] = None):\n        self.repo = repo\n\n    def _parse_or_fetch(self, s: str) -> \"Fraction\":\n        \"\"\"Parses a fraction string, using the cache if available.\"\"\"\n        if self.repo:\n            cached_fraction = self.repo.get(s)\n            if cached_fraction:\n                return cached_fraction\n        \n        parsed_fraction = parse_fraction(s)\n        \n        if self.repo:\n            self.repo.set(s, parsed_fraction)\n            \n        return parsed_fraction\n\n    def is_whole_product(self, x_str: str, n_str: str) -> bool:\n        \"\"\"Determines if the product of two fraction strings is a whole number.\"\"\"\n        frac_x = self._parse_or_fetch(x_str)\n        frac_n = self._parse_or_fetch(n_str)\n\n        product_fraction = frac_x.multiply(frac_n)\n        return product_fraction.is_whole()\n\nclass SimplifyController:\n    \"\"\"API layer for simplifying fraction expressions.\"\"\"\n    def __init__(self, service: \"SimplifyService\"):\n        self.service = service\n\n    def simplify(self, x: str, n: str) -> bool:\n        \"\"\"Delegates to the service to check if x * n is a whole number.\"\"\"\n        return self.service.is_whole_product(x, n)\n\n_DEFAULT_CACHE_REPO = FractionCacheRepository()\n_DEFAULT_SIMPLIFY_SERVICE = SimplifyService(repo=_DEFAULT_CACHE_REPO)\n_DEFAULT_SIMPLIFY_CONTROLLER = SimplifyController(service=_DEFAULT_SIMPLIFY_SERVICE)\n\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    return _DEFAULT_SIMPLIFY_CONTROLLER.simplify(x, n)"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Write a function which sorts the given list of integers\n    in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their index in original list.\n    \"\"\"\n\n    def _digit_sum(n):\n        \"\"\"Calculates the sum of the absolute value of digits of an integer.\"\"\"\n        return sum(int(d) for d in str(abs(n)))\n\n    # Create a list of tuples: (digit_sum, original_index, original_value)\n    # This structure allows Python's default tuple sorting to apply the rules:\n    # 1. Primary sort key is digit_sum (ascending).\n    # 2. Secondary sort key for ties in digit_sum is original_index (ascending).\n    decorated_nums = []\n    for i, num in enumerate(nums):\n        s = _digit_sum(num)\n        decorated_nums.append((s, i, num))\n\n    # Sort the list of tuples. Python's sort is stable and sorts by\n    # successive elements of the tuple.\n    decorated_nums.sort()\n\n    # Extract the original values from the sorted list\n    return [item[2] for item in decorated_nums]"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Counts elements in the array that are greater than 10 and whose first and last digits are odd.\n    Non-numeric items are ignored.\n    \"\"\"\n    count = 0\n    for item in nums:\n        try:\n            # Convert item to integer, skipping if conversion fails.\n            iv = int(item)\n        except (ValueError, TypeError):\n            continue\n\n        # Numbers must be strictly greater than 10.\n        if iv <= 10:\n            continue\n\n        # Digit determination uses decimal representation of the absolute integer.\n        abs_iv = abs(iv)\n\n        # Extract the first digit.\n        first_digit = abs_iv\n        if first_digit == 0: # Handle the case of 0 separately, although 0 <= 10 is already filtered\n            first_digit = 0 # Or could be considered not having a \"first digit\" relevant for 'odd' check\n                            # But per example, 15, 33, 45, 21, 109 are positive. \n                            # If we get here with 0, its first/last digit is 0. 0 is not odd.\n        else:\n            while first_digit >= 10:\n                first_digit //= 10\n\n        # Extract the last digit.\n        last_digit = abs_iv % 10\n\n        # Check if both first and last digits are odd.\n        is_first_odd = (first_digit % 2 == 1)\n        is_last_odd = (last_digit % 2 == 1)\n\n        if is_first_odd and is_last_odd:\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns \n    the number of elements in the array that are greater than 10 and both \n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    For example:\n    specialFilter([15, -73, 14, -15]) => 1 \n    specialFilter([33, -2, -3, 45, 21, 109]) => 2\n    \"\"\"\n    \n    def _is_odd_digit(d: int) -> bool:\n        \"\"\"Checks if a given digit is odd.\"\"\"\n        return d in {1, 3, 5, 7, 9}\n\n    def _first_digit(n: int) -> int:\n        \"\"\"Extracts the first digit of the absolute value of a number.\"\"\"\n        n = abs(n)\n        if n == 0:\n            return 0\n        while n >= 10:\n            n //= 10\n        return n\n\n    def _last_digit(n: int) -> int:\n        \"\"\"Extracts the last digit of the absolute value of a number.\"\"\"\n        return abs(n) % 10\n\n    count = 0\n    for num in nums:\n        # Check if the number is greater than 10.\n        if num <= 10:\n            continue\n        \n        # Extract the first and last digits of the absolute value.\n        first = _first_digit(num)\n        last = _last_digit(num)\n        \n        # Check if both digits are odd.\n        if _is_odd_digit(first) and _is_odd_digit(last):\n            count += 1\n            \n    return count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Computes the number of triples (a[i], a[j], a[k]) from the array a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n\n    def _choose(n_val, k_val):\n        \"\"\"Calculates n_val choose k_val.\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n\n        res = 1\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    def _get_residue_counts(n_val):\n        \"\"\"Returns counts of a[i] modulo 3 for i from 1 to n_val.\"\"\"\n        # Counts of i in 1..n_val for each i % 3\n        count_i_mod1 = (n_val + 2) // 3\n        count_i_mod2 = (n_val + 1) // 3\n        count_i_mod0 = n_val // 3\n\n        # a[i] = i*i - i + 1\n        # If i % 3 == 0, a[i] % 3 == 1\n        # If i % 3 == 1, a[i] % 3 == 1\n        # If i % 3 == 2, a[i] % 3 == 0 (since 2*2 - 2 + 1 = 3)\n        # Therefore, a[i] % 3 will never be 2.\n\n        c0 = count_i_mod2  # Count of a[i] % 3 == 0\n        c1 = count_i_mod0 + count_i_mod1  # Count of a[i] % 3 == 1\n        c2 = 0  # Count of a[i] % 3 == 2 (always zero)\n\n        return c0, c1, c2\n\n    if n < 3:\n        return 0\n\n    c0, c1, c2 = _get_residue_counts(n)\n\n    # For a[i] + a[j] + a[k] to be a multiple of 3, their residues modulo 3 must sum to 0 (mod 3).\n    # Given that c2 is always 0, we cannot have elements with residue 2.\n    # The only possible combinations of residues (r_i, r_j, r_k) that sum to 0 (mod 3) are:\n    # 1. (0, 0, 0): three elements with residue 0. Number of ways: _choose(c0, 3).\n    # 2. (1, 1, 1): three elements with residue 1. Number of ways: _choose(c1, 3).\n    # Combinations like (0, 1, 2) or (2, 2, 2) are not possible because c2 is 0.\n\n    total_triples = _choose(c0, 3) + _choose(c1, 3)\n\n    return total_triples"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    \n    CANONICAL_PLANET_ORDER = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n\n    def normalize_planet_name(name: str) -> str:\n        '''Strips whitespace and converts the planet name to title case for lookup.'''\n        return name.strip().title()\n\n    normalized_planet1 = normalize_planet_name(planet1)\n    normalized_planet2 = normalize_planet_name(planet2)\n\n    if normalized_planet1 not in CANONICAL_PLANET_ORDER or \\\n       normalized_planet2 not in CANONICAL_PLANET_ORDER:\n        return tuple()\n\n    idx1 = CANONICAL_PLANET_ORDER.index(normalized_planet1)\n    idx2 = CANONICAL_PLANET_ORDER.index(normalized_planet2)\n\n    if idx1 == idx2:\n        return tuple()\n\n    # Determine the smaller and larger index to correctly slice the list\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    # Slice the list to get planets strictly between the two, excluding the start and end planets\n    return tuple(CANONICAL_PLANET_ORDER[start_idx + 1:end_idx])"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Computes the number of triples (a[i], a[j], a[k]) where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n\n    def _comb3(k: int) -> int:\n        \"\"\"Returns the number of ways to choose 3 items from k, or 0 if k < 3.\"\"\"\n        if k < 3:\n            return 0\n        return (k * (k - 1) * (k - 2)) // 6\n\n    def _count_residue_zero(num: int) -> int:\n        \"\"\"Counts numbers of i in 1..num where a[i] % 3 == 0. This occurs when i % 3 == 2.\"\"\"\n        return num // 3 + (1 if num % 3 >= 2 else 0)\n\n    count0 = _count_residue_zero(n)\n    count1 = n - count0\n\n    total_triples = _comb3(count0) + _comb3(count1)\n\n    return total_triples"}
{"task_id": "HumanEval/148", "solution": "\ndef bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets whose orbits are located between the orbit of planet1 and planet2.\n    Returns an empty tuple if planet1 or planet2 are not correct planet names.\n    \"\"\"\n    from typing import Tuple, List, Optional, Sequence\n\n    class InvalidPlanetError(ValueError):\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(message)\n\n    def normalize_name(name: str) -> str:\n        \"\"\"Normalizes a planet name for case-insensitive matching and consistent casing.\"\"\"\n        return name.strip().capitalize()\n\n    ORDERED_PLANET_NAMES: Tuple[str, ...] = (\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n    )\n\n    class PlanetRepository:\n        def __init__(self, planet_names: Optional[Sequence[str]] = None) -> None:\n            names = tuple(planet_names) if planet_names is not None else ORDERED_PLANET_NAMES\n            self._ordered_names: Tuple[str, ...] = tuple(normalize_name(n) for n in names)\n\n        def get_ordered_planet_names(self) -> Tuple[str, ...]:\n            \"\"\"Returns the canonical ordered list of planet names.\"\"\"\n            return self._ordered_names\n\n        def get_index(self, name: str) -> int:\n            \"\"\"Returns the 0-based index of a planet name, raises InvalidPlanetError if not found.\"\"\"\n            n = normalize_name(name)\n            try:\n                return self._ordered_names.index(n)\n            except ValueError:\n                raise InvalidPlanetError(f\"Unknown planet: {name}\")\n\n        def get_between_indices(self, idx1: int, idx2: int) -> List[int]:\n            \"\"\"Returns a list of indices strictly between the two given indices.\"\"\"\n            if idx1 == idx2:\n                return []\n            low, high = sorted((idx1, idx2))\n            return list(range(low + 1, high))\n\n    class PlanetService:\n        def __init__(self, repo: PlanetRepository) -> None:\n            self._repo = repo\n\n        def get_planets_between(self, planet1: str, planet2: str) -> Tuple[str, ...]:\n            \"\"\"\n            Gets planets strictly between planet1 and planet2, sorted by proximity to the sun.\n            Raises InvalidPlanetError if either planet name is invalid.\n            \"\"\"\n            i1 = self._repo.get_index(planet1)\n            i2 = self._repo.get_index(planet2)\n            indices = self._repo.get_between_indices(i1, i2)\n            names = self._repo.get_ordered_planet_names()\n            return tuple(names[i] for i in indices)\n\n    class PlanetController:\n        def __init__(self, service: PlanetService) -> None:\n            self._service = service\n\n        def handle_get_between(self, planet1: str, planet2: str) -> Tuple[str, ...]:\n            \"\"\"Delegates to the service to get planets between, propagating exceptions.\"\"\"\n            return self._service.get_planets_between(planet1, planet2)\n\n    # Instantiate singletons for the duration of this function's scope\n    _repo = PlanetRepository()\n    _service = PlanetService(_repo)\n    _controller = PlanetController(_service)\n\n    try:\n        return _controller.handle_get_between(planet1, planet2)\n    except InvalidPlanetError:\n        return tuple()"}
