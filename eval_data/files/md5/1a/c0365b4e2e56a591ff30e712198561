{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n    \n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n    decimal_digit_sum = sum(int(digit) for digit in str(N))\n    return bin(decimal_digit_sum)[2:]"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n\n    Examples:\n        add([4, 2, 6, 7]) ==> 2 \n    \"\"\"\n    total_sum = 0\n    for i, value in enumerate(lst):\n        if i % 2 == 1 and value % 2 == 0:\n            total_sum += value\n    return total_sum"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n    result_parts = []\n    current_word_chars = []\n\n    for char in s:\n        if char == ' ':\n            # If a word was being built, sort it and add to the result\n            if current_word_chars:\n                result_parts.append(\"\".join(sorted(current_word_chars)))\n                current_word_chars = []  # Reset for the next word\n            # Add the space character itself\n            result_parts.append(' ')\n        else:\n            # Accumulate characters for the current word\n            current_word_chars.append(char)\n\n    # After the loop, if there's any pending word, process it\n    if current_word_chars:\n        result_parts.append(\"\".join(sorted(current_word_chars)))\n\n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Returns an ordered version of the input string where words are reordered\n    by their characters' ASCII values, preserving word order and spaces.\n    \"\"\"\n    def _sort_chars(word):\n        \"\"\"Sorts characters in a word based on their ASCII value.\"\"\"\n        return ''.join(sorted(word, key=ord))\n\n    result_parts = []\n    n = len(s)\n    i = 0\n\n    while i < n:\n        start = i\n        if s[i] == ' ':\n            # Accumulate spaces\n            while i < n and s[i] == ' ':\n                i += 1\n            result_parts.append(s[start:i])\n        else:\n            # Accumulate non-spaces (words or punctuation)\n            while i < n and s[i] != ' ':\n                i += 1\n            result_parts.append(_sort_chars(s[start:i]))\n            \n    return ''.join(result_parts)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the given array based on the parity of the sum of its first and last elements.\n    Returns an ascending sorted copy if the sum is odd, or a descending sorted copy if the sum is even.\n    \"\"\"\n    arr_copy = list(array)\n\n    if len(arr_copy) <= 1:\n        return arr_copy\n\n    first_val = arr_copy[0]\n    last_val = arr_copy[-1]\n    sum_first_last = first_val + last_val\n\n    if sum_first_last % 2 == 1:  # Odd sum, sort ascending\n        return sorted(arr_copy)\n    else:  # Even sum, sort descending\n        return sorted(arr_copy, reverse=True)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integer x in the 2D list and returns a list of (row, column) coordinates.\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    coordinates = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                coordinates.append((r_idx, c_idx))\n\n    # Sort coordinates: primary key row (ascending), secondary key column (descending)\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return coordinates"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integer x in the 2D list and returns coordinates (row, column) sorted as specified.\n    Coordinates are sorted by row ascending, then by columns descending for elements in the same row.\n    \"\"\"\n    found_coordinates = []\n    for r_idx, row in enumerate(lst):\n        current_row_matches_cols = []\n        for c_idx, value in enumerate(row):\n            if value == x:\n                current_row_matches_cols.append(c_idx)\n        \n        # Sort column indices in descending order for the current row.\n        current_row_matches_cols.sort(reverse=True)\n        \n        # Extend the main list with coordinates for the current row.\n        # This implicitly maintains the row-ascending order.\n        for col_index in current_row_matches_cols:\n            found_coordinates.append((r_idx, col_index))\n            \n    return found_coordinates"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the given array based on the parity of the sum of its first and last elements.\n    If the sum is odd, it sorts in ascending order; if even, it sorts in descending order.\n    \"\"\"\n    if len(array) <= 1:\n        return list(array)\n\n    first_element = array[0]\n    last_element = array[-1]\n    sum_of_elements = first_element + last_element\n\n    if sum_of_elements % 2 == 1:  # Odd sum, sort ascending\n        sorted_result = sorted(array)\n    else:  # Even sum, sort descending\n        sorted_result = sorted(array, reverse=True)\n\n    return sorted_result"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating the alphabet by 4 positions.\n    Non-alphabetic characters are preserved, and case is maintained.\n    \"\"\"\n    result = []\n    shift = 4\n    for char in s:\n        if 'a' <= char <= 'z':\n            base = ord('a')\n            shifted_char_code = (ord(char) - base + shift) % 26 + base\n            result.append(chr(shifted_char_code))\n        elif 'A' <= char <= 'Z':\n            base = ord('A')\n            shifted_char_code = (ord(char) - base + shift) % 26 + base\n            result.append(chr(shifted_char_code))\n        else:\n            result.append(char)\n    return \"\".join(result)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    You are given a list of integers.\n    Write a function next_smallest() that returns the 2nd smallest element of the list.\n    Return None if there is no such element.\n    \n    next_smallest([1, 2, 3, 4, 5]) == 2\n    next_smallest([5, 1, 4, 3, 2]) == 2\n    next_smallest([]) == None\n    next_smallest([1, 1]) == None\n    \"\"\"\n    min1 = None  # Stores the smallest distinct element found so far\n    min2 = None  # Stores the second smallest distinct element found so far\n    seen = set() # Keeps track of unique elements processed to handle duplicates\n    \n    for v in lst:\n        if v in seen:\n            continue\n        \n        seen.add(v)\n        \n        if min1 is None or v < min1:\n            min2 = min1\n            min1 = v\n        elif min2 is None or v < min2:\n            min2 = v\n            \n    return min2"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating the alphabet by 4 places, preserving case and non-alphabetic characters.\"\"\"\n\n    # --- Inline defined helper classes, functions, and constants from design context ---\n\n    # Exceptions\n    class ValidationError(ValueError):\n        \"\"\"Raised for invalid input.\"\"\"\n        pass\n\n    class EncryptionError(RuntimeError):\n        \"\"\"Raised for unexpected errors during encryption.\"\"\"\n        pass\n\n    # Alphabet constants\n    ALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\n    ALPHABET_UPPER = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n    DEFAULT_SHIFT = 4 # Shift by 2 * 2 = 4 as per description\n\n    # AlphabetMapper class (from src/encryptor/alphabet.py snippet)\n    class AlphabetMapper:\n        def __init__(self):\n            self.lower = ALPHABET_LOWER\n            self.upper = ALPHABET_UPPER\n\n        def map_char(self, ch: str, shift: int) -> str:\n            if len(ch) != 1:\n                return ch\n            if ch in self.lower:\n                idx = (self.lower.index(ch) + shift) % len(self.lower)\n                return self.lower[idx]\n            if ch in self.upper:\n                idx = (self.upper.index(ch) + shift) % len(self.upper)\n                return self.upper[idx]\n            return ch\n\n    # RotationalCipher class (from src/encryptor/ciphers.py snippet)\n    class RotationalCipher:\n        def __init__(self, shift: int = DEFAULT_SHIFT, mapper: 'AlphabetMapper' = None):\n            self._shift = shift\n            self._mapper = mapper or AlphabetMapper()\n\n        def encrypt(self, text: str) -> str:\n            try:\n                return \"\".join(self._mapper.map_char(ch, self._shift) for ch in text)\n            except Exception as exc:\n                raise EncryptionError(\"cipher failure\") from exc\n\n    # DTOs (from src/encryptor/models.py snippet)\n    class EncryptRequest:\n        def __init__(self, text: str):\n            self.text = text\n\n    class EncryptResult:\n        def __init__(self, encrypted: str, algorithm: str, shift: int):\n            self.encrypted = encrypted\n            self.algorithm = algorithm\n            self.shift = shift\n\n    # Logging dependencies (from src/encryptor/repositories.py and src/encryptor/services.py snippets)\n    import time # Import time inline as per \"Do NOT call any helper that is not defined inline\"\n\n    class LogEntry:\n        def __init__(self, timestamp: float, input_length: int, algorithm: str, shift: int, result_length: int):\n            self.timestamp = timestamp\n            self.input_length = input_length\n            self.algorithm = algorithm\n            self.shift = shift\n            self.result_length = result_length\n\n    class LogRepository: # Minimal interface to satisfy EncryptorService\n        def append(self, entry: LogEntry) -> None:\n            pass\n        def list_entries(self) -> list[LogEntry]:\n            return []\n\n    class InMemoryLogRepository(LogRepository):\n        def __init__(self):\n            self._entries = []\n\n        def append(self, entry: LogEntry) -> None:\n            self._entries.append(entry)\n\n        def list_entries(self) -> list[LogEntry]:\n            return list(self._entries)\n\n    # Utils: validate_text (from src/encryptor/utils.py snippet)\n    def validate_text(text: str) -> None:\n        if not isinstance(text, str):\n            raise ValidationError(\"text must be a string\")\n\n    # EncryptorService class (from src/encryptor/services.py snippet)\n    class EncryptorService:\n        def __init__(self, cipher: 'RotationalCipher', logger: 'LogRepository'):\n            self._cipher = cipher\n            self._logger = logger\n\n        def encrypt_text(self, request: EncryptRequest) -> EncryptResult:\n            validate_text(request.text) # Validate input as per design\n\n            encrypted = self._cipher.encrypt(request.text)\n            result = EncryptResult(encrypted=encrypted, algorithm=\"rotational\", shift=self._cipher._shift)\n            \n            # Log the operation (gracefully handle logging failures)\n            entry = LogEntry(timestamp=time.time(), input_length=len(request.text),\n                             algorithm=result.algorithm, shift=result.shift, result_length=len(encrypted))\n            try:\n                self._logger.append(entry)\n            except Exception:\n                pass # Do not fail encryption due to logging problems\n\n            return result\n\n    # --- Main logic for the top-level encrypt(s) function ---\n    # Instantiate necessary components for the EncryptorService\n    mapper = AlphabetMapper()\n    cipher = RotationalCipher(shift=DEFAULT_SHIFT, mapper=mapper)\n    logger = InMemoryLogRepository() # Using the in-memory logger as default\n    service = EncryptorService(cipher, logger)\n\n    # Create an EncryptRequest and call the service's encrypt_text method\n    request = EncryptRequest(text=s)\n    result = service.encrypt_text(request)\n\n    return result.encrypted"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    You are given a list of integers.\n    Write a function next_smallest() that returns the 2nd smallest element of the list.\n    Return None if there is no such element.\n    \n    next_smallest([1, 2, 3, 4, 5]) == 2\n    next_smallest([5, 1, 4, 3, 2]) == 2\n    next_smallest([]) == None\n    next_smallest([1, 1]) == None\n    \"\"\"\n    min1 = None  # Stores the smallest unique element found\n    min2 = None  # Stores the second smallest unique element found\n    seen = set() # Tracks unique elements to ensure we consider only unique values\n\n    for v in lst:\n        # If the element has already been processed as a unique value, skip it\n        if v in seen:\n            continue\n        seen.add(v)\n\n        # Update min1 and min2 based on the current element v\n        if min1 is None or v < min1:\n            # v is the new smallest, so the old min1 becomes min2\n            min2 = min1\n            min1 = v\n        elif min2 is None or v < min2:\n            # v is not the smallest, but it might be the second smallest\n            min2 = v\n            \n    return min2"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts sentences starting with \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    import re\n    import string\n\n    # Helper to strip surrounding quotes and punctuation from a token.\n    def normalize_token(token):\n        return token.strip(string.punctuation).strip()\n\n    # Helper to split text into sentences using '.', '?', '!' as delimiters.\n    def _split_sentences(text):\n        # Splits by one or more delimiters, ensuring delimiters are not part of the resulting sentences.\n        return re.split(r'[.?!]+', text)\n\n    # Helper to get the first token of a sentence string.\n    def _first_token(sentence_text):\n        # Splits the sentence text by whitespace and returns the first part.\n        parts = sentence_text.split(maxsplit=1)\n        return parts[0] if parts else ''\n\n    boredom_count = 0\n    \n    if not S:\n        return 0\n\n    raw_sentences = _split_sentences(S)\n\n    for raw_sentence in raw_sentences:\n        sentence_stripped = raw_sentence.strip()\n        \n        if not sentence_stripped:\n            continue\n        \n        first_token = _first_token(sentence_stripped)\n        \n        normalized_first_token = normalize_token(first_token)\n        \n        if normalized_first_token == \"I\":\n            boredom_count += 1\n            \n    return boredom_count"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    \n    Examples\n    any_int(5, 2, 7) \u279e True\n    \n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n    \n    any_int(3.6, -2.2, 2) \u279e False\n  \n\n    \n    '''\n    # Helper to strictly check if a value is an integer as per design context.\n    # It returns True only if the value is of type int and not of type bool.\n    def _is_strict_int(val):\n        return isinstance(val, int) and not isinstance(val, bool)\n\n    if _is_strict_int(x) and _is_strict_int(y) and _is_strict_int(z):\n        return (x == y + z) or \\\n               (y == x + z) or \\\n               (z == x + y)\n    else:\n        return False"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts the number of boredoms in a string, where a boredom is a sentence\n    that starts with the word \"I\". Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n\n    class Config:\n        \"\"\"Central configuration for boredom detection, including case sensitivity.\"\"\"\n        def __init__(self, case_sensitive: bool = False):\n            self.case_sensitive = case_sensitive\n\n    class Sentence:\n        \"\"\"Domain object representing a single sentence with methods to extract its first word.\"\"\"\n        def __init__(self, raw: str):\n            self._raw = raw.strip()\n\n        def normalized(self) -> str:\n            \"\"\"Returns the sentence with internal whitespace normalized to single spaces.\"\"\"\n            # Replace multiple spaces with single spaces for consistency\n            words = self._raw.split()\n            return ' '.join(words) if words else ''\n\n        def first_word(self, case_sensitive: bool) -> str:\n            \"\"\"\n            Extracts the first token of the sentence, stripping surrounding punctuation,\n            and applies case sensitivity.\n            \"\"\"\n            normalized_sentence = self.normalized()\n            if not normalized_sentence:\n                return \"\"\n\n            tokens = normalized_sentence.split(maxsplit=1)\n            if not tokens:\n                return \"\"\n\n            first_token = tokens[0]\n\n            # Manually clean the first token by removing leading/trailing non-alphanumeric characters.\n            cleaned_word_chars = []\n            start_idx = 0\n            end_idx = len(first_token) - 1\n\n            while start_idx <= end_idx and not first_token[start_idx].isalnum():\n                start_idx += 1\n\n            while end_idx >= start_idx and not first_token[end_idx].isalnum():\n                end_idx -= 1\n\n            if start_idx > end_idx:\n                cleaned_word = \"\"\n            else:\n                cleaned_word = first_token[start_idx : end_idx + 1]\n            \n            if case_sensitive:\n                return cleaned_word\n            else:\n                return cleaned_word.lower()\n\n    class TextParser:\n        \"\"\"Splits raw text into Sentence objects based on predefined delimiters.\"\"\"\n        def __init__(self, delimiters: str = \".!?\"):\n            self._delimiters = delimiters\n\n        def split_into_sentences(self, text: str) -> list[Sentence]:\n            \"\"\"Splits the input text into a list of Sentence objects, ignoring empty parts.\"\"\"\n            sentences = []\n            current_sentence_start = 0\n            \n            for i in range(len(text)):\n                char = text[i]\n                if char in self._delimiters:\n                    sentence_text = text[current_sentence_start:i]\n                    stripped_part = sentence_text.strip()\n                    if stripped_part:\n                        sentences.append(Sentence(stripped_part))\n                    current_sentence_start = i + 1\n            \n            # Add the last segment after the last delimiter (or if no delimiters were found)\n            last_segment = text[current_sentence_start:]\n            stripped_last_segment = last_segment.strip()\n            if stripped_last_segment:\n                sentences.append(Sentence(stripped_last_segment))\n            \n            return sentences\n\n    # Main logic of the is_bored function\n    config = Config(case_sensitive=False) # Default to case-insensitive per design context\n    parser = TextParser()\n    \n    boredom_count = 0\n    sentences = parser.split_into_sentences(S)\n    \n    for sentence_obj in sentences:\n        first_word_val = sentence_obj.first_word(config.case_sensitive)\n        \n        # Compare against \"i\" because the default config is case-insensitive,\n        # and the first_word method returns a lowercased string in that scenario.\n        if first_word_val == \"i\":\n            boredom_count += 1\n            \n    return boredom_count"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    '''\n    # First, validate that all inputs are integers and not booleans.\n    # Booleans are a subclass of int in Python, so we explicitly exclude them.\n    if not isinstance(x, int) or isinstance(x, bool):\n        return False\n    if not isinstance(y, int) or isinstance(y, bool):\n        return False\n    if not isinstance(z, int) or isinstance(z, bool):\n        return False\n\n    # If all inputs are valid integers, perform the sum check.\n    return (x == y + z) or (y == x + z) or (z == x + y)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case of all letters and replacing vowels.\n    \"\"\"\n\n    # --- Start of inline helper classes and functions from design context ---\n\n    VOWELS_LOWER = \"aeiou\"\n    VOWELS_UPPER = \"AEIOU\"\n\n    def is_letter(ch: str) -> bool:\n        \"\"\"Returns True if the character is an alphabetic letter.\"\"\"\n        return len(ch) == 1 and ch.isalpha()\n\n    def is_vowel(ch: str) -> bool:\n        \"\"\"Returns True if the character is a vowel (a, e, i, o, u, case-insensitive).\"\"\"\n        return ch in VOWELS_LOWER or ch in VOWELS_UPPER\n\n    class CaseSwapper:\n        \"\"\"Handles swapping the case of a single character.\"\"\"\n        def swap(self, ch: str) -> str:\n            \"\"\"Swaps the case of an alphabetic character, otherwise returns it unchanged.\"\"\"\n            return ch.swapcase() if is_letter(ch) else ch\n\n    class VowelReplacer:\n        \"\"\"Handles replacing vowels with letters shifted by a fixed amount.\"\"\"\n        def __init__(self, shift: int = 2):\n            self.shift = shift\n\n        def _shift_char(self, ch: str, shift: int) -> str:\n            \"\"\"Shifts an alphabetic character by 'shift' positions, wrapping around.\"\"\"\n            base = ord('A') if ch.isupper() else ord('a')\n            pos = ord(ch) - base\n            new_pos = (pos + shift) % 26\n            return chr(base + new_pos)\n\n        def replace(self, ch: str) -> str:\n            \"\"\"Replaces a vowel with the shifted character, preserving case.\"\"\"\n            if is_vowel(ch):\n                return self._shift_char(ch, self.shift)\n            return ch\n\n    class CharTransformer:\n        \"\"\"Orchestrates character-level transformations.\"\"\"\n        def __init__(self, case_swapper: CaseSwapper, vowel_replacer: VowelReplacer):\n            self.case_swapper = case_swapper\n            self.vowel_replacer = vowel_replacer\n\n        def transform(self, message: str) -> str:\n            \"\"\"Applies case swapping then vowel replacement to each character in the message.\"\"\"\n            transformed_chars = []\n            for ch in message:\n                ch1 = self.case_swapper.swap(ch)\n                ch2 = self.vowel_replacer.replace(ch1)\n                transformed_chars.append(ch2)\n            return \"\".join(transformed_chars)\n\n    class EncoderService:\n        \"\"\"Provides the main encoding service by coordinating transformations.\"\"\"\n        def __init__(self, transformer: CharTransformer):\n            self.transformer = transformer\n\n        def encode(self, message: str) -> str:\n            \"\"\"Encodes the given message using the configured transformer.\"\"\"\n            return self.transformer.transform(message)\n\n    # --- End of inline helper classes and functions ---\n\n    # Instantiate the default encoder based on the design's __init__.py snippet\n    _default_encoder = EncoderService(\n        transformer=CharTransformer(case_swapper=CaseSwapper(), vowel_replacer=VowelReplacer())\n    )\n\n    # Delegate the encoding task to the default encoder instance\n    return _default_encoder.encode(message)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case of letters and replacing vowels with the letter\n    two places ahead in the alphabet, preserving case.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n    encoded_chars = []\n    for char in message:\n        if not char.isalpha():\n            encoded_chars.append(char)\n        else:\n            swapped_char = char.swapcase()\n            if swapped_char.lower() in VOWELS:\n                # Shift vowel by 2, preserving the case of the swapped character\n                shifted_char = chr(ord(swapped_char) + 2)\n                encoded_chars.append(shifted_char)\n            else:\n                encoded_chars.append(swapped_char)\n    return ''.join(encoded_chars)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    Examples:\n    check_dict_case({\"a\":\"apple\", \"b\":\"banana\"}) should return True.\n    check_dict_case({\"a\":\"apple\", \"A\":\"banana\", \"B\":\"banana\"}) should return False.\n    check_dict_case({\"a\":\"apple\", 8:\"banana\", \"a\":\"apple\"}) should return False.\n    check_dict_case({\"Name\":\"John\", \"Age\":\"36\", \"City\":\"Houston\"}) should return False.\n    check_dict_case({\"STATE\":\"NC\", \"ZIP\":\"12345\" }) should return True.\n    \"\"\"\n    if not dict:\n        return False\n\n    # Check if all keys are strings. If not, return False.\n    if not all(isinstance(key, str) for key in dict.keys()):\n        return False\n\n    # Check if all string keys are in lowercase.\n    if all(key == key.lower() for key in dict.keys()):\n        return True\n\n    # If not all lowercase, check if all string keys are in uppercase.\n    if all(key == key.upper() for key in dict.keys()):\n        return True\n\n    # If neither condition is met, return False.\n    return False"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime using an optimized trial division method.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def sum_digits(n):\n        \"\"\"Calculates the sum of the decimal digits of a non-negative integer.\"\"\"\n        total_sum = 0\n        n_abs = abs(n)\n        while n_abs > 0:\n            total_sum += n_abs % 10\n            n_abs //= 10\n        return total_sum\n\n    largest_prime = 0  # Initialize with 0. Primes are > 1.\n\n    for num in lst:\n        # Check if the number is greater than the current largest_prime\n        # and if it is indeed a prime number.\n        if num > largest_prime and is_prime(num):\n            largest_prime = num\n\n    # If no prime was found, largest_prime remains 0, and sum_digits(0) correctly returns 0.\n    return sum_digits(largest_prime)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_keys_are_lower = True\n    all_keys_are_upper = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n        \n        if not key.islower():\n            all_keys_are_lower = False\n        if not key.isupper():\n            all_keys_are_upper = False\n            \n    return all_keys_are_lower or all_keys_are_upper"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    def sum_digits(n):\n        \"\"\"Calculates the sum of the decimal digits of a given number.\"\"\"\n        if n is None:\n            return 0\n        s = 0\n        n_str = str(abs(n))\n        for digit_char in n_str:\n            s += int(digit_char)\n        return s\n\n    def power(base, exp, mod):\n        \"\"\"Computes (base^exp) % mod using modular exponentiation.\"\"\"\n        res = 1\n        base %= mod\n        while exp > 0:\n            if exp % 2 == 1:\n                res = (res * base) % mod\n            base = (base * base) % mod\n            exp //= 2\n        return res\n\n    def miller_rabin_test(n, d, s, a):\n        \"\"\"Performs a single Miller-Rabin test with base 'a'.\"\"\"\n        x = power(a, d, n)\n        if x == 1 or x == n - 1:\n            return True\n        for _ in range(s - 1):\n            x = power(x, 2, n)\n            if x == n - 1:\n                return True\n        return False\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a number n is prime using deterministic Miller-Rabin.\"\"\"\n        if n < 2:\n            return False\n        # Small primes check as per design snippet.\n        small_primes = (2, 3, 5, 7, 11, 13, 17, 19, 23)\n        for p in small_primes:\n            if n == p:\n                return True\n            if n % p == 0:\n                return False\n\n        # Apply deterministic Miller-Rabin test for numbers up to 2^64.\n        s = 0\n        d = n - 1\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n\n        # Deterministic bases for n < 2^64.\n        BASES_64_BIT = [2, 325, 9375, 28178, 450775, 9780504, 1795265022]\n        \n        for a in BASES_64_BIT:\n            if a >= n: # Ensure the base 'a' is less than 'n' for the test.\n                continue\n            if not miller_rabin_test(n, d, s, a):\n                return False\n        return True\n\n    largest_prime_found = None\n    for num in lst:\n        if is_prime(num):\n            if largest_prime_found is None or num > largest_prime_found:\n                largest_prime_found = num\n\n    return sum_digits(largest_prime_found)"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Implement a function that takes a non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    for example:\n    count_up_to(5) => [2,3]\n    count_up_to(11) => [2,3,5,7]\n    count_up_to(0) => []\n    count_up_to(20) => [2,3,5,7,11,13,17,19]\n    count_up_to(1) => []\n    count_up_to(18) => [2,3,5,7,11,13,17]\n    \"\"\"\n\n    class InvalidInputError(ValueError):\n        \"\"\"Custom exception for invalid inputs.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class PrimeRepository:\n        \"\"\"Generates prime numbers below a given limit using the Sieve of Eratosthenes.\"\"\"\n        def generate_primes_below(self, limit: int) -> list[int]:\n            if limit <= 2:\n                return []\n            sieve = [True] * limit\n            sieve[0:2] = [False, False]  # 0 and 1 are not prime.\n\n            # Sieve of Eratosthenes optimization: iterate up to sqrt(limit)\n            for i in range(2, int(limit**0.5) + 1):\n                if sieve[i]:\n                    # Mark multiples as composite, starting from i*i.\n                    step = i\n                    start = i * i\n                    # Calculate the count of elements for slicing (from design context).\n                    if start < limit:\n                        count_to_mark = (limit - 1 - start) // step + 1\n                        sieve[start:limit:step] = [False] * count_to_mark\n            return [i for i, is_prime in enumerate(sieve) if is_prime]\n\n    class PrimeService:\n        \"\"\"Handles business logic, validating semantics and delegating to the repository.\"\"\"\n        def __init__(self, repo: 'PrimeRepository') -> None:\n            self._repo = repo\n\n        def get_primes_less_than(self, n: int) -> list[int]:\n            return self._repo.generate_primes_below(n)\n\n    class PrimeController:\n        \"\"\"Manages input validation and orchestrates prime number generation.\"\"\"\n        def __init__(self, service: 'PrimeService') -> None:\n            self._service = service\n\n        def count_up_to(self, n: int) -> list[int]:\n            try:\n                val = int(n)\n            except (TypeError, ValueError):\n                raise InvalidInputError(\"n must be an integer\")\n            if val < 0:\n                raise InvalidInputError(\"n must be non-negative\")\n            return self._service.get_primes_less_than(val)\n\n    # Initialize the dependency chain and execute the main logic.\n    repo = PrimeRepository()\n    service = PrimeService(repo)\n    controller = PrimeController(service)\n    return controller.count_up_to(n)"}
{"task_id": "HumanEval/96", "solution": "import math\n\ndef _sieve_of_eratosthenes(limit: int) -> list[int]:\n    \"\"\"Computes all prime numbers less than 'limit' using the Sieve of Eratosthenes.\"\"\"\n    if limit <= 2:\n        return []\n\n    # Initialize a bytearray where sieve[i] is 1 if i is potentially prime, 0 otherwise.\n    sieve = bytearray(b'\\x01') * limit\n    sieve[0] = sieve[1] = 0  # 0 and 1 are not prime numbers\n\n    # Iterate from p=2 up to the square root of (limit-1).\n    for p in range(2, int(math.isqrt(limit - 1)) + 1):\n        if sieve[p]:\n            # Mark all multiples of p (starting from p*p) as not prime.\n            # Numbers less than p*p that are multiples of p would have already been marked.\n            sieve[p * p:limit:p] = b'\\x00' * (((limit - 1 - (p * p)) // p) + 1)\n\n    # Collect all numbers for which sieve[i] is still 1 (prime).\n    primes = [i for i, is_prime in enumerate(sieve) if is_prime]\n    return primes\n\ndef count_up_to(n):\n    \"\"\"Implement a function that takes a non-negative integer and returns an array of the prime numbers less than n.\"\"\"\n    return _sieve_of_eratosthenes(n)"}
