{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n\n    if not hasattr(fib, '_initialized'):\n        # Define necessary standard library imports\n        from collections import OrderedDict\n        import sqlite3\n        import datetime # Required for TIMESTAMP in SQLite, though not directly used in Python logic here\n\n        # Define custom exceptions\n        class InputError(Exception):\n            \"\"\"Exception raised for invalid input parameters.\"\"\"\n            pass\n\n        # Define Validator utility\n        class Validator:\n            \"\"\"Utility class for input validation.\"\"\"\n            @staticmethod\n            def validate_n(n: int) -> None:\n                \"\"\"Validates if n is a non-negative integer, raising InputError if not.\"\"\"\n                if not isinstance(n, int) or n < 0:\n                    raise InputError(\"Input n must be a non-negative integer.\")\n\n        # Define Config (simplified for inline use, hardcoding defaults instead of from_env)\n        class Config:\n            \"\"\"Configuration for the Fibonacci service.\"\"\"\n            def __init__(self):\n                self.sqlite_path: str | None = \"fib_cache.db\"\n                self.cache_max_size: int | None = 128  # Example max size for LRU\n                self.use_persistence: bool = True      # Enable persistence by default\n\n        # Define CacheRepository (in-memory LRU cache)\n        class CacheRepository:\n            \"\"\"Implements an in-memory LRU cache for Fibonacci numbers.\"\"\"\n            def __init__(self, max_size: int | None = None) -> None:\n                self._store = OrderedDict()\n                self._max_size = max_size\n\n            def get(self, n: int) -> int | None:\n                \"\"\"Retrieves a value from the cache, moving it to the end (MRU).\"\"\"\n                v = self._store.get(n)\n                if v is not None:\n                    self._store.move_to_end(n)\n                return v\n\n            def set(self, n: int, value: int) -> None:\n                \"\"\"Adds or updates a value in the cache, managing LRU eviction.\"\"\"\n                self._store[n] = value\n                self._store.move_to_end(n)\n                if self._max_size and len(self._store) > self._max_size:\n                    self._store.popitem(last=False) # Evict LRU item\n\n            def clear(self) -> None:\n                \"\"\"Clears all items from the cache.\"\"\"\n                self._store.clear()\n\n        # Define PersistenceRepository (SQLite)\n        class PersistenceRepository:\n            \"\"\"Manages persistence of Fibonacci numbers in an SQLite database.\"\"\"\n            TABLE_NAME = \"fib_cache\"\n            CREATE_TABLE_SQL = f\"CREATE TABLE IF NOT EXISTS {TABLE_NAME} (n INTEGER PRIMARY KEY, value TEXT NOT NULL, computed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP)\"\n\n            def __init__(self, db_path: str) -> None:\n                self._db_path = db_path\n                self.migrate()\n\n            def migrate(self) -> None:\n                \"\"\"Ensures the necessary table exists in the database.\"\"\"\n                conn = None\n                try:\n                    conn = sqlite3.connect(self._db_path)\n                    cursor = conn.cursor()\n                    cursor.execute(self.CREATE_TABLE_SQL)\n                    conn.commit()\n                except sqlite3.Error as e:\n                    # In a real app, use proper logging. Here, print for visibility.\n                    print(f\"Persistence error during migration: {e}\")\n                finally:\n                    if conn:\n                        conn.close()\n\n            def get(self, n: int) -> int | None:\n                \"\"\"Retrieves a Fibonacci number from the database.\"\"\"\n                conn = None\n                try:\n                    conn = sqlite3.connect(self._db_path)\n                    cursor = conn.cursor()\n                    cursor.execute(f\"SELECT value FROM {self.TABLE_NAME} WHERE n = ?\", (n,))\n                    row = cursor.fetchone()\n                    if row:\n                        return int(row[0])\n                except sqlite3.Error as e:\n                    print(f\"Persistence error during get({n}): {e}\")\n                finally:\n                    if conn:\n                        conn.close()\n                return None\n\n            def set(self, n: int, value: int) -> None:\n                \"\"\"Stores a Fibonacci number in the database.\"\"\"\n                conn = None\n                try:\n                    conn = sqlite3.connect(self._db_path)\n                    cursor = conn.cursor()\n                    cursor.execute(f\"INSERT OR REPLACE INTO {self.TABLE_NAME}(n, value, computed_at) VALUES (?, ?, CURRENT_TIMESTAMP)\", (n, str(value)))\n                    conn.commit()\n                except sqlite3.Error as e:\n                    print(f\"Persistence error during set({n}, {value}): {e}\")\n                finally:\n                    if conn:\n                        conn.close()\n\n        # Define FibonacciService (core logic with caching)\n        class FibonacciService:\n            \"\"\"Provides the core Fibonacci computation logic, utilizing caching and persistence.\"\"\"\n            def __init__(self, cache_repo: CacheRepository, persistence_repo: PersistenceRepository | None, config: Config) -> None:\n                self._cache_repo = cache_repo\n                self._persistence_repo = persistence_repo\n                self._config = config\n\n            def compute(self, n: int, use_cache: bool = True) -> int:\n                \"\"\"Computes the n-th Fibonacci number, using caches if enabled.\"\"\"\n                Validator.validate_n(n) # Validate input using the inline Validator\n\n                if use_cache:\n                    # 1. Check in-memory cache\n                    val = self._cache_repo.get(n)\n                    if val is not None:\n                        return val\n\n                    # 2. Check persistence if enabled and configured\n                    if self._persistence_repo and self._config.use_persistence:\n                        pval = self._persistence_repo.get(n)\n                        if pval is not None:\n                            self._cache_repo.set(n, pval) # Populate in-memory cache from persistence\n                            return pval\n\n                # 3. Compute if not found in any cache\n                f_n, _ = self._fast_doubling(n)\n\n                # 4. Store in caches if enabled\n                if use_cache:\n                    self._cache_repo.set(n, f_n)\n                    if self._persistence_repo and self._config.use_persistence:\n                        try:\n                            self._persistence_repo.set(n, f_n)\n                        except Exception:\n                            # Log and continue if persistence fails (non-critical failure)\n                            print(f\"Failed to persist F({n}) to DB.\") # Simplified logging\n\n                return f_n\n\n            def _fast_doubling(self, n: int) -> tuple[int, int]:\n                \"\"\"Computes (F(n), F(n+1)) using the fast doubling algorithm.\"\"\"\n                if n == 0:\n                    return (0, 1) # Base case: (F(0), F(1))\n\n                a, b = self._fast_doubling(n >> 1) # Recurse for n/2: (F(k), F(k+1)) where k = n/2\n\n                # Calculate F(2k) and F(2k+1)\n                c = a * (2 * b - a) # F(2k) = F(k) * (2*F(k+1) - F(k))\n                d = a * a + b * b   # F(2k+1) = F(k)^2 + F(k+1)^2\n\n                if n & 1: # If n is odd, F(n) is F(2k+1), F(n+1) is F(2k+2)\n                    return (d, c + d)\n                else:     # If n is even, F(n) is F(2k), F(n+1) is F(2k+1)\n                    return (c, d)\n\n        # Initialize the service and its dependencies once\n        fib._config = Config()\n        fib._cache = CacheRepository(max_size=fib._config.cache_max_size)\n        fib._persist = PersistenceRepository(fib._config.sqlite_path) if fib._config.use_persistence else None\n        fib._service = FibonacciService(fib._cache, fib._persist, fib._config)\n        fib._initialized = True # Mark as initialized\n\n    # Use the initialized service to compute the Fibonacci number\n    return fib._service.compute(n)"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\"\"\"\n    n = len(l)\n    if n <= 1:\n        return True\n\n    # Check if the list is non-decreasing\n    is_non_decreasing = True\n    for i in range(1, n):\n        if l[i] < l[i-1]:\n            is_non_decreasing = False\n            break\n\n    # Check if the list is non-increasing\n    is_non_increasing = True\n    for i in range(1, n):\n        if l[i] > l[i-1]:\n            is_non_increasing = False\n            break\n\n    # Return True if it's either non-decreasing or non-increasing\n    return is_non_decreasing or is_non_increasing"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    This function computes the n-th Fibonacci number using the fast doubling method,\n    leveraging an in-memory cache for performance.\n    \"\"\"\n    import time\n    import threading\n    from typing import Optional, Dict, Tuple\n\n    class ValidationError(Exception):\n        \"\"\"Custom exception for validation errors.\"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n    def validate_n(value: any) -> int:\n        \"\"\"Validate value to be a non-negative integer.\"\"\"\n        try:\n            iv = int(value)\n        except (ValueError, TypeError):\n            raise ValidationError(\"n must be an integer\")\n        if iv < 0:\n            raise ValidationError(\"n must be >= 0\")\n        return iv\n\n    def fast_doubling_fib(num: int) -> int:\n        \"\"\"Computes the num-th Fibonacci number using the fast doubling method.\"\"\"\n        if num == 0:\n            return 0\n        \n        # Helper function to compute (F(k), F(k+1))\n        def _fd(k_val):\n            if k_val == 0:\n                return (0, 1)\n            \n            a, b = _fd(k_val >> 1)  # Recurse for k/2\n            \n            c = a * (2 * b - a)    # F(2k) = F(k) * (2 * F(k+1) - F(k))\n            d = a * a + b * b      # F(2k + 1) = F(k)^2 + F(k+1)^2\n            \n            if k_val & 1:  # If k_val is odd\n                return (d, c + d)\n            return (c, d)\n            \n        return _fd(num)[0]\n\n    class CacheRepository:\n        \"\"\"Abstract base class for cache repositories.\"\"\"\n        def get(self, key: str) -> Optional[str]:\n            raise NotImplementedError\n        def set(self, key: str, value: str, ttl: Optional[int] = None) -> None:\n            raise NotImplementedError\n        def delete(self, key: str) -> None:\n            raise NotImplementedError\n\n    class InMemoryCacheRepository(CacheRepository):\n        \"\"\"Basic in-memory cache implementation, thread-safe.\"\"\"\n        def __init__(self, ttl_seconds: Optional[int] = None):\n            self._store: Dict[str, Tuple[str, Optional[float]]] = {}\n            self._ttl = ttl_seconds\n            self._lock = threading.Lock()\n\n        def get(self, key: str) -> Optional[str]:\n            with self._lock:\n                item = self._store.get(key)\n                if not item:\n                    return None\n                value, expiry = item\n                if expiry and time.time() > expiry:\n                    del self._store[key]\n                    return None\n                return value\n\n        def set(self, key: str, value: str, ttl: Optional[int] = None) -> None:\n            actual_ttl = ttl if ttl is not None else self._ttl\n            expiry = time.time() + actual_ttl if actual_ttl is not None else None\n            with self._lock:\n                self._store[key] = (value, expiry)\n\n        def delete(self, key: str) -> None:\n            with self._lock:\n                if key in self._store:\n                    del self._store[key]\n\n    class FibonacciService:\n        \"\"\"Orchestrates validation, cache lookup, compute, and caching.\"\"\"\n        def __init__(self, cache: CacheRepository, algorithm: str = \"fast_doubling\"):\n            self._cache = cache\n            self._default_algorithm = algorithm\n            self._algorithms = {\n                \"fast_doubling\": fast_doubling_fib,\n            }\n\n        def compute(self, num: int, mode: Optional[str] = None) -> int:\n            num = validate_n(num)\n            mode_to_use = mode or self._default_algorithm\n            \n            key = self._get_cache_key(num, mode_to_use)\n            \n            cached = self._cache.get(key)\n            if cached is not None:\n                return int(cached)\n            \n            value = self._compute_uncached(num, mode_to_use)\n            \n            try:\n                self._cache.set(key, str(value))\n            except Exception:\n                # Log and continue in a real application.\n                pass \n            return value\n\n        def _compute_uncached(self, num: int, mode: str) -> int:\n            algorithm_func = self._algorithms.get(mode)\n            if not algorithm_func:\n                raise ValueError(f\"Unknown algorithm mode: {mode}\")\n            return algorithm_func(num)\n\n        def _get_cache_key(self, num: int, mode: str) -> str:\n            return f\"fib:{num}:{mode}\"\n\n    # Initialize service and cache only once across calls to fib()\n    if not hasattr(fib, \"_fib_service_instance\"):\n        _fib_cache_instance = InMemoryCacheRepository()\n        fib._fib_service_instance = FibonacciService(_fib_cache_instance, algorithm=\"fast_doubling\")\n\n    return fib._fib_service_instance.compute(n)"}
