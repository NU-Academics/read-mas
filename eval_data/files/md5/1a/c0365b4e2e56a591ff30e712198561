{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0  \n   \n    If the input list is empty, return 0.\n    \"\"\"\n    total_sum_of_squares = 0\n    for item in lst:\n        current_num = None\n        \n        # Check if the item is an integer or an integer-like float\n        if isinstance(item, int):\n            current_num = item\n        elif isinstance(item, float) and item.is_integer():\n            current_num = int(item)\n        \n        # If not an integer-like number, ignore it\n        if current_num is None:\n            continue\n            \n        # Ignore numbers that are negative\n        if current_num < 0:\n            continue\n            \n        # Check if the number is odd (non-negative numbers only)\n        if (current_num % 2) == 1:\n            total_sum_of_squares += current_num * current_num\n            \n    return total_sum_of_squares"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n\n    If the input list is empty, return 0.\n    \"\"\"\n    total_sum_of_squares = 0\n    for num in lst:\n        if isinstance(num, (int, float)):\n            # Ignore numbers that are negative\n            if num < 0:\n                continue\n            # Treat float numbers that are exact integers as integers\n            if isinstance(num, float):\n                if not num.is_integer():\n                    continue\n                num = int(num) # Convert to int for modulo operation\n\n            # Consider only numbers that are odd\n            if num % 2 != 0:\n                total_sum_of_squares += num * num\n        # Ignore non-numeric types automatically by not processing them further\n    return total_sum_of_squares"}
{"task_id": "HumanEval/150", "solution": "from math import isqrt\n\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    # Determine if n is a prime number.\n    if n < 2:\n        is_prime = False\n    elif n == 2 or n == 3:\n        is_prime = True\n    elif n % 2 == 0 or n % 3 == 0:\n        is_prime = False\n    else:\n        # Optimized trial division: check factors of the form 6k \u00b1 1 up to sqrt(n).\n        is_prime = True\n        limit = isqrt(n)\n        i = 5\n        while i <= limit:\n            if n % i == 0 or n % (i + 2) == 0:\n                is_prime = False\n                break\n            i += 6\n\n    if is_prime:\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    \n    def is_prime(num):\n        \"\"\"Checks if a number is prime using an optimized trial division method.\"\"\"\n        if num < 2:\n            return False\n        if num == 2 or num == 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        \n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"I think we all remember that feeling when the result of some long-awaited\n    event is finally known. The feelings and thoughts you have at that moment are\n    definitely worth noting down and comparing.\n    Your task is to determine if a person correctly guessed the results of a number of matches.\n    You are given two arrays of scores and guesses of equal length, where each index shows a match. \n    Return an array of the same length denoting how far off each guess was. If they have guessed correctly,\n    the value is 0, and if not, the value is the absolute difference between the guess and the score.\n    \n    \n    example:\n\n    compare([1,2,3,4,5,1],[1,2,3,4,2,-2]) -> [0,0,0,0,3,3]\n    compare([0,5,0,0,0,4],[4,1,1,0,0,-2]) -> [4,4,1,0,0,6]\n    \"\"\"\n    return [abs(g_score - g_guess) for g_score, g_guess in zip(game, guess)]"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"I think we all remember that feeling when the result of some long-awaited\n    event is finally known. The feelings and thoughts you have at that moment are\n    definitely worth noting down and comparing.\n    Your task is to determine if a person correctly guessed the results of a number of matches.\n    You are given two arrays of scores and guesses of equal length, where each index shows a match. \n    Return an array of the same length denoting how far off each guess was. If they have guessed correctly,\n    the value is 0, and if not, the value is the absolute difference between the guess and the score.\n    \n    \n    example:\n\n    compare([1,2,3,4,5,1],[1,2,3,4,2,-2]) -> [0,0,0,0,3,3]\n    compare([0,5,0,0,0,4],[4,1,1,0,0,-2]) -> [4,4,1,0,0,6]\n    \"\"\"\n    return [0 if s == g else abs(s - g) for s, g in zip(game, guess)]"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on (uppercase count - lowercase count) and formats the result.\"\"\"\n    \n    max_strength = float('-inf')\n    strongest_extension_name = \"\"\n\n    for extension_name in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in extension_name:\n            if 'A' <= char <= 'Z':\n                cap_count += 1\n            elif 'a' <= char <= 'z':\n                sm_count += 1\n        \n        current_strength = cap_count - sm_count\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension_name\n    \n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\"\"\"\n    if not b:\n        return True\n\n    m = len(b)\n    n = len(a)\n\n    if m > n:\n        return False\n\n    # All cyclic rotations of 'b' are substrings of 'b' + 'b'.\n    # We check if any substring of 'a' with length 'm' (length of 'b')\n    # is present within the doubled string 'b+b'.\n    doubled_b = b + b\n\n    for i in range(n - m + 1):\n        candidate_substring = a[i : i + m]\n        if candidate_substring in doubled_b:\n            return True\n\n    return False"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on CAP - SM strength calculation.\n    Returns the class name concatenated with the strongest extension name.\n    \"\"\"\n    # Helper to count uppercase letters in a string\n    def _count_upper(s: str) -> int:\n        return sum(1 for ch in s if ch.isalpha() and ch.isupper())\n\n    # Helper to count lowercase letters in a string\n    def _count_lower(s: str) -> int:\n        return sum(1 for ch in s if ch.isalpha() and ch.islower())\n\n    # Helper to compute the strength of an extension\n    def _compute_strength(extension_name: str) -> int:\n        return _count_upper(extension_name) - _count_lower(extension_name)\n\n    # Initialize with the first extension to handle tie-breaking and assume non-empty list.\n    strongest_extension_name = extensions[0]\n    max_strength = _compute_strength(strongest_extension_name)\n\n    # Iterate from the second extension onwards\n    for ext_name in extensions[1:]:\n        current_strength = _compute_strength(ext_name)\n\n        # If current extension is strictly stronger, update the strongest found so far.\n        # This implicitly handles the \"first in list\" tie-breaking rule.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = ext_name\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\"\"\"\n    \n    if len(b) > len(a):\n        return False\n\n    b_doubled = b + b\n    for i in range(len(b)):\n        rotation_b = b_doubled[i : i + len(b)]\n        if rotation_b in a:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    n = abs(num)\n    if n == 0:\n        return (1, 0) # Zero is a single even digit.\n\n    even_count = 0\n    odd_count = 0\n\n    while n > 0:\n        n, digit = divmod(n, 10)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    roman_map = [\n        (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"),\n        (100, \"C\"), (90, \"XC\"), (50, \"L\"), (40, \"XL\"),\n        (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"), (1, \"I\"),\n    ]\n\n    result = []\n    n = number\n    for value, symbol in roman_map:\n        while n >= value:\n            result.append(symbol)\n            n -= value\n    return \"\".join(result).lower()"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_digits = 0\n    odd_digits = 0\n    \n    # Handle the absolute value of the number to ignore the sign.\n    # Handle 0 specifically as its only digit is 0, which is even.\n    if num == 0:\n        return (1, 0)\n\n    n = abs(num)\n    \n    while n > 0:\n        digit = n % 10\n        if digit % 2 == 0:\n            even_digits += 1\n        else:\n            odd_digits += 1\n        n //= 10\n            \n    return (even_digits, odd_digits)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    roman_map = [\n        (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"),\n        (100, \"C\"), (90, \"XC\"), (50, \"L\"), (40, \"XL\"),\n        (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"), (1, \"I\")\n    ]\n\n    result_parts = []\n    remaining_num = number\n    for value, numeral in roman_map:\n        while remaining_num >= value:\n            result_parts.append(numeral)\n            remaining_num -= value\n\n    return \"\".join(result_parts).lower()"}
{"task_id": "HumanEval/157", "solution": "import math\n\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    sides = sorted([float(a), float(b), float(c)])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n\n    if s1 + s2 <= s3:\n        return False\n\n    epsilon = 1e-9\n    return math.isclose(s1*s1 + s2*s2, s3*s3, rel_tol=epsilon, abs_tol=epsilon)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Returns the word with the maximum number of unique characters.\n    If multiple words tie, the lexicographically first word is returned.\"\"\"\n    if not words:\n        return \"\"\n\n    unique_counts = {word: len(set(word)) for word in words}\n\n    max_count = 0\n    if unique_counts:\n        max_count = max(unique_counts.values())\n\n    candidates = [word for word, count in unique_counts.items() if count == max_count]\n\n    return min(candidates)"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    def _normalize_sides(s_a: float, s_b: float, s_c: float) -> tuple[float, float, float]:\n        \"\"\"Sorts the side lengths in ascending order.\"\"\"\n        sides = sorted((s_a, s_b, s_c))\n        return (sides[0], sides[1], sides[2])\n\n    def _is_close(x: float, y: float, tol: float) -> bool:\n        \"\"\"Compares two floats for equality within a given tolerance.\"\"\"\n        return abs(x - y) <= tol * max(1.0, abs(x), abs(y))\n\n    # Convert inputs to float to handle both int and float consistently.\n    fa = float(a)\n    fb = float(b)\n    fc = float(c)\n\n    # Normalize sides to ensure s1 <= s2 <= s3 for consistent checks.\n    s1, s2, s3 = _normalize_sides(fa, fb, fc)\n\n    # All sides must be positive.\n    if s1 <= 0:\n        return False\n\n    # Check triangle inequality: The sum of the lengths of any two sides must be\n    # greater than the length of the third side.\n    if s1 + s2 <= s3:\n        return False\n\n    # Check Pythagorean theorem using a tolerance for floating-point comparisons.\n    # A default tolerance of 1e-9 is used as per design context.\n    tolerance = 1e-9\n    \n    s1_sq = s1 * s1\n    s2_sq = s2 * s2\n    s3_sq = s3 * s3\n    \n    return _is_close(s1_sq + s2_sq, s3_sq, tolerance)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Returns the word with the maximum number of unique characters,\n    breaking ties by lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    candidates = []\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            candidates = [word]\n        elif current_unique_count == max_unique_count:\n            candidates.append(word)\n\n    # From the candidates with the maximum unique character count,\n    # return the one that comes first lexicographically.\n    return min(candidates)"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and the number of carrots left.\n    The rabbit eats up to the 'need' amount, but no more than 'remaining'.\n    \"\"\"\n    if remaining >= need:\n        total_eaten = number + need\n        carrots_left = remaining - need\n    else:\n        total_eaten = number + remaining\n        carrots_left = 0\n\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Computes total eaten carrots and remaining carrots after a rabbit's meal.\n    It returns an array of [total_eaten, remaining_after_meal].\n    \"\"\"\n    carrots_to_eat = min(need, remaining)\n    total_eaten = number + carrots_to_eat\n    remaining_after_meal = remaining - carrots_to_eat\n    return [total_eaten, remaining_after_meal]"}
{"task_id": "HumanEval/160", "solution": "from dataclasses import dataclass\nfrom typing import List, Any, Dict, Set\n\ndef do_algebra(operator: List[str], operand: List[int]) -> int:\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n\n    @dataclass\n    class Token:\n        kind: str  # \"NUMBER\" or \"OP\"\n        value: Any\n\n    PRECEDENCE: Dict[str, int] = {\"**\": 4, \"*\": 3, \"//\": 3, \"+\": 2, \"-\": 2}\n    RIGHT_ASSOC: Set[str] = {\"**\"}\n\n    # 1. Convert infix expression to a list of tokens\n    tokens: List[Token] = []\n    tokens.append(Token(kind=\"NUMBER\", value=operand[0]))\n    for op, num in zip(operator, operand[1:]):\n        tokens.append(Token(kind=\"OP\", value=op))\n        tokens.append(Token(kind=\"NUMBER\", value=num))\n\n    # 2. Convert infix tokens to Reverse Polish Notation (RPN) using Shunting-yard algorithm\n    output_queue: List[Token] = []\n    operator_stack: List[Token] = []\n\n    for token in tokens:\n        if token.kind == \"NUMBER\":\n            output_queue.append(token)\n        elif token.kind == \"OP\":\n            while (operator_stack and operator_stack[-1].kind == \"OP\" and\n                   (PRECEDENCE[operator_stack[-1].value] > PRECEDENCE[token.value] or\n                    (PRECEDENCE[operator_stack[-1].value] == PRECEDENCE[token.value] and token.value not in RIGHT_ASSOC))):\n                output_queue.append(operator_stack.pop())\n            operator_stack.append(token)\n\n    while operator_stack:\n        output_queue.append(operator_stack.pop())\n    \n    rpn_tokens = output_queue\n\n    # 3. Evaluate the RPN expression\n    stack: List[int] = []\n    for tok in rpn_tokens:\n        if tok.kind == \"NUMBER\":\n            stack.append(int(tok.value))\n        else: # tok.kind == \"OP\"\n            b = stack.pop()\n            a = stack.pop()\n            if tok.value == \"+\":\n                stack.append(a + b)\n            elif tok.value == \"-\":\n                stack.append(a - b)\n            elif tok.value == \"*\":\n                stack.append(a * b)\n            elif tok.value == \"//\":\n                stack.append(a // b)\n            elif tok.value == \"**\":\n                stack.append(a ** b)\n\n    return stack[0]"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Reverses the case of letters in a string, or reverses the string if no letters are present.\"\"\"\n    has_letter = False\n    for char in s:\n        if char.isalpha():\n            has_letter = True\n            break\n\n    if has_letter:\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                result_chars.append(char.swapcase())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n    else:\n        return s[::-1]"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator: list[str], operand: list[int]) -> int:\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + ) \n    Subtraction ( - ) \n    Multiplication ( * ) \n    Floor division ( // ) \n    Exponentiation ( ** ) \n\n    Example:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n\n    \"\"\"\n    from typing import List, Union\n\n    class AlgebraError(Exception):\n        \"\"\"Base exception for algebraic operations.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class InputValidationError(AlgebraError):\n        \"\"\"Raised for invalid input formats or values.\"\"\"\n        pass\n\n    class EvaluationError(AlgebraError):\n        \"\"\"Raised for runtime evaluation problems.\"\"\"\n        pass\n\n    class Token:\n        \"\"\"Represents a number or an operator in the expression.\"\"\"\n        def __init__(self, value: Union[int, str], type: str) -> None:\n            self._value = value\n            self._type = type\n\n        def is_number(self) -> bool:\n            return self._type == \"NUMBER\"\n\n        def is_operator(self) -> bool:\n            return self._type == \"OP\"\n\n        @property\n        def value(self) -> Union[int, str]:\n            return self._value\n\n        def __repr__(self) -> str:\n            return f\"Token({self._value!r}, {self._type!r})\"\n\n    # Operator precedence and associativity definitions.\n    PRECEDENCE = {\"**\": 3, \"*\": 2, \"//\": 2, \"+\": 1, \"-\": 1}\n    RIGHT_ASSOC = {\"**\"}\n    LEFT_ASSOC = {\"*\", \"//\", \"+\", \"-\"}\n    VALID_OPERATORS = {\"+\", \"-\", \"*\", \"//\", \"**\"}\n\n    class InputValidator:\n        \"\"\"Validates the structure and content of input lists.\"\"\"\n        def validate(self, operators: List[str], operands: List[int]) -> None:\n            if not isinstance(operands, list) or len(operands) < 2:\n                raise InputValidationError(\"Operand list must be a list with at least two numbers.\")\n            if not isinstance(operators, list) or len(operators) < 1:\n                raise InputValidationError(\"Operator list must be a list with at least one operator.\")\n            if len(operators) != len(operands) - 1:\n                raise InputValidationError(\"The length of operator list must be equal to the length of operand list minus one.\")\n\n            for op in operators:\n                if not isinstance(op, str) or op not in VALID_OPERATORS:\n                    raise InputValidationError(f\"Invalid operator found: '{op}'. Valid operators are {', '.join(VALID_OPERATORS)}.\")\n\n            for num in operands:\n                if not isinstance(num, int) or num < 0:\n                    raise InputValidationError(f\"Invalid operand found: '{num}'. Operands must be non-negative integers.\")\n\n    class ShuntingYardParser:\n        \"\"\"Converts an infix expression (lists) to Reverse Polish Notation (RPN).\"\"\"\n        def parse(self, operators: List[str], operands: List[int]) -> List[Token]:\n            output: List[Token] = []\n            op_stack: List[str] = []\n\n            def get_precedence(op_symbol: str) -> int:\n                return PRECEDENCE.get(op_symbol, 0)\n\n            def is_higher_precedence(op1_on_stack: str, op2_current: str) -> bool:\n                return get_precedence(op1_on_stack) > get_precedence(op2_current)\n\n            def is_equal_precedence(op1_on_stack: str, op2_current: str) -> bool:\n                return get_precedence(op1_on_stack) == get_precedence(op2_current)\n\n            for i in range(len(operands)):\n                output.append(Token(operands[i], \"NUMBER\"))\n\n                if i < len(operators):\n                    current_op = operators[i]\n                    if current_op not in VALID_OPERATORS:\n                         raise InputValidationError(f\"Unexpected invalid operator during parsing: '{current_op}'\")\n\n                    while op_stack:\n                        top_op = op_stack[-1]\n                        if is_higher_precedence(top_op, current_op) or \\\n                           (is_equal_precedence(top_op, current_op) and top_op in LEFT_ASSOC):\n                            output.append(Token(op_stack.pop(), \"OP\"))\n                        else:\n                            break\n                    op_stack.append(current_op)\n\n            while op_stack:\n                output.append(Token(op_stack.pop(), \"OP\"))\n\n            return output\n\n    class RpnEvaluator:\n        \"\"\"Evaluates an expression in Reverse Polish Notation (RPN).\"\"\"\n        def evaluate(self, rpn_tokens: List[Token]) -> int:\n            stack: List[int] = []\n\n            for token in rpn_tokens:\n                if token.is_number():\n                    stack.append(int(token.value))\n                elif token.is_operator():\n                    if len(stack) < 2:\n                        raise EvaluationError(\"Insufficient operands for operator in RPN expression.\")\n                    b = stack.pop()\n                    a = stack.pop()\n                    op_symbol = str(token.value)\n\n                    try:\n                        if op_symbol == \"+\":\n                            res = a + b\n                        elif op_symbol == \"-\":\n                            res = a - b\n                        elif op_symbol == \"*\":\n                            res = a * b\n                        elif op_symbol == \"//\":\n                            if b == 0:\n                                raise EvaluationError(\"Division by zero.\")\n                            res = a // b\n                        elif op_symbol == \"**\":\n                            res = a ** b\n                        else:\n                            raise EvaluationError(f\"Unknown operator in RPN: '{op_symbol}'\")\n                        stack.append(res)\n                    except OverflowError:\n                        raise EvaluationError(f\"Arithmetic overflow during evaluation with operator '{op_symbol}'.\")\n                    except Exception as e:\n                        raise EvaluationError(f\"Error during evaluation with operator '{op_symbol}': {e}\")\n\n            if len(stack) != 1:\n                raise EvaluationError(\"Malformed RPN expression: stack did not resolve to a single result.\")\n            return stack[0]\n\n    # Orchestrate the validation, parsing, and evaluation steps.\n    validator = InputValidator()\n    parser = ShuntingYardParser()\n    evaluator = RpnEvaluator()\n\n    validator.validate(operator, operand)\n    rpn_tokens = parser.parse(operator, operand)\n    result = evaluator.evaluate(rpn_tokens)\n\n    return result"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if has_letters:\n        transformed_chars = []\n        for char in s:\n            if char.isalpha():\n                transformed_chars.append(char.swapcase())\n            else:\n                transformed_chars.append(char)\n        return \"\".join(transformed_chars)\n    else:\n        return s[::-1]"}
{"task_id": "HumanEval/162", "solution": "import hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    \n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
