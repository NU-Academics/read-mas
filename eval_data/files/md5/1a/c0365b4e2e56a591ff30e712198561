{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    # Computes the sum of integers from 1 to n using the arithmetic series formula.\n    # This provides an O(1) time complexity solution.\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/59", "solution": "import math\nimport json\nimport os\nimport sys\n\ndef largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        pass\n\n    class ComputationError(Exception):\n        pass\n\n    class CacheError(Exception):\n        pass\n\n    ENABLE_CACHE = True\n    CACHE_PATH = \"data/cache.json\"\n\n    class PrimeUtils:\n        MAX_TRIAL_DIVISION = 1_000_000\n\n        @staticmethod\n        def is_prime(n: int) -> bool:\n            if n < 2:\n                return False\n            if n % 2 == 0:\n                return n == 2\n            r = int(math.isqrt(n))\n            f = 3\n            while f <= r:\n                if n % f == 0:\n                    return False\n                f += 2\n            return True\n\n        @staticmethod\n        def largest_prime_factor(n: int) -> int:\n            if n <= 1:\n                raise ComputationError(\"n must be > 1\")\n            last_factor = None\n            # remove factors of 2\n            while n % 2 == 0:\n                last_factor = 2\n                n //= 2\n            f = 3\n            while f * f <= n:\n                while n % f == 0:\n                    last_factor = f\n                    n //= f\n                f += 2\n            if n > 1:\n                last_factor = n\n            if last_factor is None:\n                raise ComputationError(\"no prime factors found\")\n            return int(last_factor)\n\n    class NumberInput:\n        def __init__(self, value: int) -> None:\n            self._value = value\n\n        def validate(self) -> None:\n            if not isinstance(self._value, int):\n                raise InvalidInputError(\"value must be int\")\n            if self._value <= 1:\n                raise InvalidInputError(\"value must be > 1\")\n            if PrimeUtils.is_prime(self._value):\n                raise InvalidInputError(\"value must not be prime\")\n\n        def get_value(self) -> int:\n            return self._value\n\n    class CacheRepository:\n        DEFAULT_CACHE_PATH = \"data/cache.json\"\n\n        def __init__(self, path: str = DEFAULT_CACHE_PATH) -> None:\n            self.path = path\n            self.cache = self._load()\n\n        def get(self, n: int):\n            return self.cache.get(str(n))\n\n        def set(self, n: int, value: int) -> None:\n            self.cache[str(n)] = int(value)\n            self._save(self.cache)\n\n        def _load(self):\n            try:\n                if not os.path.exists(self.path):\n                    os.makedirs(os.path.dirname(self.path), exist_ok=True)\n                    with open(self.path, \"w\") as fh:\n                        json.dump({}, fh)\n                    return {}\n                with open(self.path, \"r\") as fh:\n                    return json.load(fh)\n            except Exception:\n                # Swallow cache read errors and fall back to compute (as per design context)\n                print(f\"Warning: Failed to load cache from {self.path}, starting with empty cache.\", file=sys.stderr)\n                return {}\n\n        def _save(self, cache):\n            try:\n                tmp = f\"{self.path}.tmp\"\n                with open(tmp, \"w\") as fh:\n                    json.dump(cache, fh)\n                os.replace(tmp, self.path)\n            except Exception as exc:\n                raise CacheError(f\"Failed to save cache: {exc}\")\n\n    class FactorService:\n        def __init__(self, prime_utils, cache_repo=None) -> None:\n            self._prime_utils = prime_utils\n            self._cache = cache_repo\n\n        def largest_prime_factor(self, n: int) -> int:\n            num = NumberInput(n)\n            num.validate()\n\n            if self._cache:\n                val = self._cache.get(n)\n                if val is not None:\n                    return int(val)\n\n            result = self._prime_utils.largest_prime_factor(num.get_value())\n\n            if self._cache:\n                try:\n                    self._cache.set(n, result)\n                except Exception:\n                    # Log cache write errors and continue; do not break computation.\n                    pass\n            return int(result)\n\n    prime_utils = PrimeUtils()\n    cache = CacheRepository(CACHE_PATH) if ENABLE_CACHE else None\n    service = FactorService(prime_utils, cache)\n    return service.largest_prime_factor(n)"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    max_prime_factor = 1\n\n    # Divide by 2 until n is odd\n    while n % 2 == 0:\n        max_prime_factor = 2\n        n //= 2\n\n    # n must be odd at this point, so we can skip even numbers.\n    # Iterate from 3 up to sqrt(n) to find prime factors.\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            max_prime_factor = i\n            n //= i\n        i += 2 # Move to the next odd number\n\n    # If n is still greater than 1, it must be the largest prime factor.\n    if n > 1:\n        max_prime_factor = n\n\n    return max_prime_factor"}
{"task_id": "HumanEval/60", "solution": "from .repositories.sqlite_repository import SqliteRepository\nfrom .utils.validator import Validator\nfrom .services.sum_service import SumService\nfrom . import config\n\ndef sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    repo = None\n    try:\n        # Initialize the necessary components for the sum calculation service.\n        repo = SqliteRepository(config.DB_PATH)\n        validator = Validator(config.MAX_N)\n        service = SumService(repo=repo, validator=validator)\n\n        # Delegate the actual calculation and caching logic to the SumService.\n        sum_result = service.sum_to_n(n)\n        return sum_result.sum_value\n    finally:\n        # Ensure the repository connection is closed when the function finishes.\n        if repo:\n            repo.close()"}
