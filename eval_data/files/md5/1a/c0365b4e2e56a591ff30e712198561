{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    \"\"\"\n    Compares two lists of strings based on their total character count and returns the list with fewer characters.\n    If counts are equal, the first list is returned.\n    \"\"\"\n    total_chars_lst1 = sum(len(s) for s in lst1)\n    total_chars_lst2 = sum(len(s) for s in lst2)\n\n    if total_chars_lst1 <= total_chars_lst2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    def _prime_factors(n: int) -> list[int]:\n        \"\"\"Calculates the prime factors of n, with multiplicity.\"\"\"\n        factors = []\n        d = 2\n        while d * d <= n:\n            while n % d == 0:\n                factors.append(d)\n                n //= d\n            d += 1 if d == 2 else 2\n        if n > 1:\n            factors.append(n)\n        return factors\n\n    factors = _prime_factors(a)\n    return len(factors) == 3"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"\n    Checks if the given number is the multiplication of exactly 3 prime numbers.\n    The input 'a' is less than 100.\n    \"\"\"\n\n    def _sieve_primes_upto(limit):\n        \"\"\"Generates a list of prime numbers up to a given limit using the Sieve of Eratosthenes.\"\"\"\n        sieve = [True] * (limit + 1)\n        if limit >= 0:\n            sieve[0] = False\n        if limit >= 1:\n            sieve[1] = False\n        for p in range(2, int(limit**0.5) + 1):\n            if sieve[p]:\n                for multiple in range(p * p, limit + 1, p):\n                    sieve[multiple] = False\n        return [p for p, is_prime in enumerate(sieve) if is_prime]\n\n    def _factorize(n, primes):\n        \"\"\"Returns a list of prime factors for n, including multiplicities.\"\"\"\n        if n < 2:\n            return []\n        factors = []\n        temp_n = n\n        for p in primes:\n            while temp_n % p == 0:\n                factors.append(p)\n                temp_n //= p\n            if temp_n == 1:\n                break\n        # If temp_n is still greater than 1, it must be a prime factor itself\n        # (this should not happen for n < 100 if primes up to sqrt(n) are included,\n        # but for robustness)\n        if temp_n > 1:\n            factors.append(temp_n)\n        return factors\n\n    # The design context specifies 'a' is less than 100, which implies 2 <= a <= 99.\n    # We need primes up to 99 to factorize any number up to 99.\n    all_primes_up_to_99 = _sieve_primes_upto(99)\n\n    prime_factors = _factorize(a, all_primes_up_to_99)\n\n    return len(prime_factors) == 3"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Your task is to write a function that returns true if a number x is a simple\n    power of n and false in other cases.\n    x is a simple power of n if n**int=x\n    For example:\n    is_simple_power(1, 4) => true\n    is_simple_power(2, 2) => true\n    is_simple_power(8, 2) => true\n    is_simple_power(3, 2) => false\n    is_simple_power(3, 1) => false\n    is_simple_power(5, 3) => false\n    \"\"\"\n    # If x is 1, it is n^0 for any n >= 2.\n    if x == 1:\n        return True\n    \n    # For a simple power, x must be positive and n must be a base >= 2.\n    if x < 1 or n < 2:\n        return False\n\n    # Repeatedly divide x by n. If it's a simple power, x must eventually become 1.\n    current_x = x\n    while current_x > 1:\n        if current_x % n != 0:\n            return False\n        current_x //= n\n    \n    return True"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n, i.e., n**k == x for some integer k >= 0.\"\"\"\n    \n    # x is 1: This is n**0 for any n, so it's always a simple power.\n    if x == 1:\n        return True\n\n    # After handling x=1, if x is not 1, k must be >= 1.\n\n    # Handle special cases for n:\n    if n == 0:\n        # If n is 0, x must be 0 for n**k=x (for k>=1), or x=1 (for k=0, already handled).\n        return x == 0\n    if n == 1:\n        # If n is 1, 1**k is always 1. Since x is not 1 (handled above), it cannot be a simple power of 1.\n        return False\n\n    # If x is 0 and n is not 0 or 1, it's not a power.\n    if x == 0:\n        return False\n        \n    # If x is negative and n is positive, it's impossible for n**k = x with k >= 0.\n    if x < 0 and n > 0:\n        return False\n\n    # General case: iterate by division\n    # We need to find if there's an integer k >= 1 such that n**k == x.\n    \n    current_x = x\n    # For negative bases, we need to consider the absolute values and the parity of k.\n    if n < 0:\n        # If x is not divisible by abs(n), it cannot be a power.\n        if current_x % n != 0: # Note: x % n works correctly for negative numbers here.\n            return False\n\n        k = 0\n        while current_x != 1 and current_x != -1:\n            if current_x % n != 0:\n                return False\n            current_x //= n\n            k += 1\n        \n        # At this point, abs(n)**k == abs(x) (roughly), and current_x is 1 or -1.\n        # Now check if current_x matches the expected sign based on x.\n        if x > 0: # If x was positive, final current_x must be 1 (even k).\n            return current_x == 1\n        else: # If x was negative, final current_x must be -1 (odd k).\n            return current_x == -1\n    \n    # For positive base n > 1\n    # x must be positive (since x=1, x=0, negative x and positive n cases handled).\n    while current_x > 1:\n        if current_x % n != 0:\n            return False\n        current_x //= n\n    \n    return current_x == 1"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    if a == 0:\n        return True\n\n    sign = -1 if a < 0 else 1\n    abs_a = abs(a)\n\n    # Perform binary search to find the integer cube root of abs_a.\n    # The search space for the cube root x of N is typically [0, N].\n    # For efficiency, the upper bound can be tightened, but max(1, abs_a) is safe.\n    lo, hi = 0, max(1, abs_a)\n\n    # This variable will store the integer root candidate for abs_a.\n    abs_root_candidate = 0 \n\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        cube = mid * mid * mid\n\n        if cube == abs_a:\n            abs_root_candidate = mid\n            break # Exact cube root found\n        elif cube < abs_a:\n            lo = mid + 1\n        else: # cube > abs_a\n            hi = mid - 1\n    else:\n        # If the loop finishes without finding an exact match (i.e., no 'break'),\n        # 'hi' will hold the largest integer whose cube is less than or equal to abs_a.\n        # This is the floor of the cube root.\n        abs_root_candidate = hi\n    \n    # Construct the final integer root candidate for 'a', considering its original sign.\n    final_root = sign * abs_root_candidate\n\n    # Verify if cubing this final root candidate yields the original number 'a'.\n    return final_root * final_root * final_root == a"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Write a function that takes an integer a and returns True \n    if this ingeger is a cube of some integer number.\n    Note: you may assume the input is always valid.\n    Examples:\n    iscube(1) ==> True\n    iscube(2) ==> False\n    iscube(-1) ==> True\n    iscube(64) ==> True\n    iscube(0) ==> True\n    iscube(180) ==> False\n    '''\n    if a == 0:\n        return True\n\n    abs_a = abs(a)\n    sign_a = 1 if a >= 0 else -1\n\n    def _integer_cuberoot_floor(n_val):\n        lo, hi = 0, max(1, n_val)\n        while lo <= hi:\n            mid = (lo + hi) // 2\n            cube = mid * mid * mid\n            if cube == n_val:\n                return mid\n            if cube < n_val:\n                lo = mid + 1\n            else:\n                hi = mid - 1\n        return hi\n\n    def _integer_cuberoot_round(n_val):\n        floor = _integer_cuberoot_floor(n_val)\n        \n        cube_floor = floor * floor * floor\n        cube_ceil = (floor + 1) * (floor + 1) * (floor + 1)\n\n        if cube_ceil - n_val <= n_val - cube_floor:\n            return floor + 1\n        return floor\n\n    r = _integer_cuberoot_round(abs_a)\n    candidate = (sign_a * r) ** 3\n\n    return candidate == a"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"\n    Counts the number of hexadecimal digits that are prime numbers within the input string.\n    Prime hexadecimal digits are '2', '3', '5', '7', 'B' (decimal 11), and 'D' (decimal 13).\n    \"\"\"\n    # The set of prime hexadecimal digits as strings.\n    # B represents decimal 11, and D represents decimal 13.\n    prime_hex_digits = {'2', '3', '5', '7', 'B', 'D'}\n    \n    count = 0\n    for char in num:\n        if char in prime_hex_digits:\n            count += 1\n            \n    return count"}
