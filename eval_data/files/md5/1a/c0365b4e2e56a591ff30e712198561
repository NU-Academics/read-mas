{"task_id": "HumanEval/1", "solution": "```python\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    groups = []\n    current_group_buffer = []\n    balance = 0\n    \n    for char in paren_string:\n        if char.isspace():\n            continue\n        \n        if char == '(':\n            balance += 1\n            current_group_buffer.append(char)\n        elif char == ')':\n            if balance > 0:\n                balance -= 1\n                current_group_buffer.append(char)\n                if balance == 0:\n                    groups.append(\"\".join(current_group_buffer))\n                    current_group_buffer = []\n            # The design context indicates that ParsingError should be raised for unexpected closing parens.\n            # However, the prompt specifically says \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n            # and \"No class wrapper, no if __name__ == \"__main__\" guard\".\n            # This implies to implement the core logic for valid inputs and not handle specific error conditions\n            # that would require custom exception classes from the detailed design (like ParsingError).\n            # Therefore, this branch is effectively a no-op for an unexpected ')' at balance 0.\n            # For the given problem statement and example, this path should ideally not be hit with valid input.\n    \n    return groups\n```"}
{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    integer_part = math.floor(number)\n    return number - integer_part"}
{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    # Create a sorted copy of the list to efficiently compare adjacent elements.\n    sorted_numbers = sorted(numbers)\n\n    # Iterate through the sorted list and check differences between adjacent elements.\n    for i in range(len(sorted_numbers) - 1):\n        if abs(sorted_numbers[i+1] - sorted_numbers[i]) < threshold:\n            return True\n\n    return False"}
{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    from typing import List\n    import math\n\n    class ValidationError(Exception):\n        def __init__(self, message: str, cause: Exception | None = None) -> None:\n            self.message = message\n            self.cause = cause\n            super().__init__(message)\n\n    class ServiceError(Exception):\n        def __init__(self, message: str, cause: Exception | None = None) -> None:\n            self.message = message\n            self.cause = cause\n            super().__init__(message)\n\n    def validate_numbers(numbers: List[float], max_len: int | None = None) -> List[float]:\n        # Validates that numbers is a list/tuple of finite floats.\n        if not isinstance(numbers, (list, tuple)):\n            raise ValidationError(\"numbers must be a list/tuple of floats\")\n        if max_len is not None and len(numbers) > max_len:\n            raise ValidationError(f\"numbers length {len(numbers)} exceeds max {max_len}\")\n        out = []\n        for i, v in enumerate(numbers):\n            try:\n                fv = float(v)\n            except (TypeError, ValueError):\n                raise ValidationError(f\"numbers[{i}] is not a float\")\n            if math.isinf(fv) or math.isnan(fv):\n                raise ValidationError(f\"numbers[{i}] is not finite\")\n            out.append(fv)\n        return out\n\n    def validate_threshold(threshold: float) -> float:\n        # Validates that threshold is a non-negative finite float.\n        try:\n            t = float(threshold)\n        except (TypeError, ValueError):\n            raise ValidationError(\"threshold must be a float\")\n        if t < 0 or not (t == t):  # NaN check: NaN != NaN\n            raise ValidationError(\"threshold must be a non-negative finite float\")\n        return t\n\n    class ICloseElementsStrategy:\n        def has_close_elements(self, numbers: List[float], threshold: float) -> bool:\n            raise NotImplementedError\n\n    class NaiveStrategy(ICloseElementsStrategy):\n        def has_close_elements(self, numbers: List[float], threshold: float) -> bool:\n            # Implements O(n^2) pairwise comparison for small lists.\n            n = len(numbers)\n            for i in range(n):\n                for j in range(i + 1, n):\n                    if abs(numbers[i] - numbers[j]) < threshold:\n                        return True\n            return False\n\n    class SortStrategy(ICloseElementsStrategy):\n        def has_close_elements(self, numbers: List[float], threshold: float) -> bool:\n            # Sorts the list and checks adjacent elements in O(n log n).\n            if len(numbers) < 2:\n                return False\n            sorted_nums = sorted(numbers)\n            for a, b in zip(sorted_nums, sorted_nums[1:]):\n                if abs(b - a) < threshold:\n                    return True\n            return False\n\n    class BucketStrategy(ICloseElementsStrategy):\n        def has_close_elements(self, numbers: List[float], threshold: float) -> bool:\n            # Uses a hash-bucket approach for expected O(n) performance.\n            if threshold == 0:\n                seen = set()\n                for v in numbers:\n                    if v in seen:\n                        return True\n                    seen.add(v)\n                return False\n\n            width = threshold\n            buckets: dict[int, float] = {}\n            for v in numbers:\n                idx = int(math.floor(v / width))\n                # Check current bucket and neighboring buckets\n                for neighbor_idx_offset in (-1, 0, 1):\n                    neighbor_idx = idx + neighbor_idx_offset\n                    if neighbor_idx in buckets and abs(buckets[neighbor_idx] - v) < threshold:\n                        return True\n                buckets[idx] = v # Store the current value in its bucket\n            return False\n\n    class StrategyFactory:\n        def __init__(self, naive_limit: int = 50) -> None:\n            self._naive_limit = naive_limit\n\n        def choose_strategy(self, numbers: list[float], threshold: float) -> ICloseElementsStrategy:\n            # Selects an optimal strategy based on list size and threshold.\n            n = len(numbers)\n            if n <= self._naive_limit:\n                return NaiveStrategy()\n            if threshold == 0:\n                # For threshold 0, sort strategy effectively checks for exact duplicates.\n                return SortStrategy()\n            # Heuristic: if list is large and threshold non-zero, BucketStrategy is generally faster.\n            if n > 1000 and threshold > 0:\n                return BucketStrategy()\n            return SortStrategy()\n\n    class CloseElementsService:\n        def __init__(self, factory: StrategyFactory | None = None) -> None:\n            self.factory = factory or StrategyFactory()\n\n        def has_close_elements(self, numbers: List[float], threshold: float) -> bool:\n            # Validates inputs, selects a strategy, and executes it.\n            nums = validate_numbers(numbers)\n            t = validate_threshold(threshold)\n            strategy = self.factory.choose_strategy(nums, t)\n            try:\n                return strategy.has_close_elements(nums, t)\n            except Exception as exc:\n                raise ServiceError(\"algorithm failed\", cause=exc)\n\n    _default_service = CloseElementsService(factory=StrategyFactory())\n    return _default_service.has_close_elements(numbers, threshold)"}
{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Separates a string of nested parentheses into a list of top-level balanced groups, ignoring spaces and other characters.\n    Each returned group is a balanced string of parentheses.\n    \"\"\"\n    cleaned_string = \"\".join(char for char in paren_string if char == '(' or char == ')')\n\n    groups: List[str] = []\n    depth = 0\n    current_group_start_index = -1\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            if depth == 0:\n                current_group_start_index = i\n            depth += 1\n        elif char == ')':\n            depth -= 1\n            if depth == 0 and current_group_start_index != -1:\n                groups.append(cleaned_string[current_group_start_index : i + 1])\n                current_group_start_index = -1\n            elif depth < 0:\n                # Encountered an unmatched closing parenthesis.\n                # Reset depth and start index to discard this malformed section and continue searching for new groups.\n                current_group_start_index = -1\n                depth = 0\n\n    return groups"}
{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    # Calculate the decimal part by subtracting the largest integer smaller than or equal to the number.\n    return number - math.floor(number)"}
