{"task_id": "HumanEval/54", "solution": "import unicodedata\n\ndef same_chars(s0: str, s1: str):\n    \"\"\"\n    Check if two words have the same characters.\n    \"\"\"\n    def _canonicalize(s: str) -> str:\n        # Normalize string using NFKC and strip leading/trailing whitespace.\n        normalized_s = unicodedata.normalize(\"NFKC\", s).strip()\n        # Extract unique characters, sort them, and join into a new string.\n        return \"\".join(sorted(set(normalized_s)))\n\n    canonical_s0 = _canonicalize(s0)\n    canonical_s1 = _canonicalize(s1)\n\n    return canonical_s0 == canonical_s1"}
{"task_id": "HumanEval/53", "solution": "from .config import Config\nfrom .repositories import JsonlAdapter\nfrom .utils import Validator\nfrom .services import CalculatorService\n\n\ndef add(x: int, y: int) -> int:\n    \"\"\"Add two numbers x and y\n    >>> add(2, 3)\n    5\n    >>> add(5, 7)\n    12\n    \"\"\"\n    config = Config.load_from_env()\n    repo = JsonlAdapter(config.storage_path)\n    validator = Validator()\n    service = CalculatorService(repo, validator)\n\n    # Delegate to the CalculatorService; the public API only returns the result.\n    result, _ = service.add(x, y)\n    return result"}
