{"task_id": "HumanEval/24", "solution": "import math\n\ndef largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    # Check for divisibility by 2 first for an early exit for even numbers.\n    if n % 2 == 0:\n        return n // 2\n\n    # Iterate through odd numbers from 3 up to the square root of n.\n    # If a divisor `i` is found, then `n // i` is the largest divisor smaller than `n`.\n    limit = int(math.isqrt(n))\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return n // i\n\n    # If no divisors are found up to sqrt(n), the number n must be prime,\n    # and its largest divisor (smaller than itself) is 1.\n    return 1"}
{"task_id": "HumanEval/26", "solution": "def remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n    return result"}
{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    if n <= 1:\n        return 0\n\n    import math\n    largest = 1\n    # Iterate from 2 up to the square root of n\n    # Any divisor greater than sqrt(n) will have a corresponding divisor smaller than sqrt(n)\n    limit = int(math.isqrt(n))\n    for i in range(2, limit + 1):\n        if n % i == 0:\n            # i is a divisor, and n // i is its pair\n            # We want the largest divisor smaller than n.\n            # n // i will be larger than i (unless i is sqrt(n)),\n            # and could be the largest proper divisor.\n            other = n // i\n            if other < n and other > largest:\n                largest = other\n            if i < n and i > largest:\n                largest = i\n\n    # If n is prime, largest will still be 1 (initialized value).\n    # If n is composite, largest will be updated to the largest proper divisor found.\n    return largest"}
{"task_id": "HumanEval/25", "solution": "```python\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    \"\"\"\n    factors = []\n    d = 2\n    temp_n = n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n    if temp_n > 1:\n        factors.append(temp_n)\n    return factors\n```"}
{"task_id": "HumanEval/26", "solution": "from typing import List\nfrom collections import Counter\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    # Count occurrences of each number in the input list.\n    counts = Counter(numbers)\n    # Build a new list containing only elements that appeared exactly once, preserving original order.\n    return [num for num in numbers if counts[num] == 1]"}
{"task_id": "HumanEval/25", "solution": "def factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    factors = []\n    \n    # Handle negative numbers by adding -1 and factorizing the absolute value.\n    if n < 0:\n        factors.append(-1)\n        n = abs(n)\n    \n    # Handle edge cases for 0 and 1 (or -1 after abs).\n    if n == 0:\n        return []\n    if n == 1:\n        return factors # If original was 1, factors is []. If original was -1, factors is [-1].\n    \n    # Factor out any factors of 2.\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n    \n    # Factor out odd numbers starting from 3 up to the square root of n.\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 2\n    \n    # If n is still greater than 1, it must be a prime factor itself.\n    if n > 1:\n        factors.append(n)\n        \n    return factors"}
{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    flipped_chars = []\n    for char in string:\n        if 'a' <= char <= 'z':  # ASCII lowercase\n            flipped_chars.append(char.upper())\n        elif 'A' <= char <= 'Z':  # ASCII uppercase\n            flipped_chars.append(char.lower())\n        else:\n            flipped_chars.append(char)\n    return ''.join(flipped_chars)"}
