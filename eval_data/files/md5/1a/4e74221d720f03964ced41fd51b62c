ecimal value.\n\n    It must be implemented like this:\n    >>> sort_array([1, 5, 2, 3, 4]) == [1, 2, 3, 4, 5]\n    >>> sort_array([-2, -3, -4, -5, -6]) == [-6, -5, -4, -3, -2]\n    >>> sort_array([1, 0, 2, 3, 4]) [0, 1, 2, 3, 4]\n    \"\"\"\n    if not arr:\n        return []\n\n    # Helper function to count set bits in a non-negative integer.\n    # This uses Brian Kernighan's algorithm.\n    def _count_set_bits(n: int) -> int:\n        count = 0\n        # The problem specifies \"non-negative integers\" for bit counting.\n        # However, Python's `bin()` handles negative numbers as well,\n        # but the standard interpretation for counting set bits usually refers to\n        # positive numbers or their two's complement in a fixed-width system.\n        # Given the problem's context and examples, we apply this only to non-negative numbers.\n        # If n is negative, it will not be passed to this function by _get_sort_key for bit counting.\n        while n > 0:\n            n &= (n - 1)\n            count += 1\n        return count\n\n    # Helper function to generate a custom key for sorting each number.\n    def _get_sort_key(n: int) -> tuple[int, int]:\n        if n < 0:\n            # For negative numbers, sort purely by their decimal value.\n            # We use a primary key of -1 to ensure all negative numbers\n            # are grouped and sorted before any non-negative numbers.\n            # The secondary key is the number itself, ensuring ascending decimal order.\n            return (-1, n)\n        else:\n            # For non-negative numbers, sort by the count of set bits first,\n            # then by their decimal value if bit counts are equal.\n            return (_count_set_bits(n), n)\n\n    # Use the custom key function with sorted() to sort the array.\n    return sorted(arr, key=_get_sort_key)", "base_status": "fail", "plus_status": "pass", "base_fail_tests": [[[-2, -3, -4, -5, -6]]], "plus_fail_tests": []}, {"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    Sorts an array of integers based on specific criteria: bit count for non-negative, decimal value for negative.\n    Non-negative integers are sorted primarily by set bit count, then by decimal value.\n    \"\"\"\n\n    def count_set_bits_inline(n):\n        # Counts set bits for non-negative integers; returns 0 for negative.\n        if n < 0:\n            return 0\n        return bin(n).count('1')\n\n    def _get_sort_key_inline(n):\n        # Generates a tuple (primary_key, secondary_key) for sorting `n`.\n        # Negative numbers are grouped first and sorted by decimal value.\n        if n < 0:\n            return (-1, n)\n        else:\n            return (count_set_bits_inline(n), n)\n\n    return sorted(arr, key=_get_sort_key_inline)", "base_status": "fail", "plus_status": "pass", "base_fail_tests": [[[-2, -3, -4, -5, -6]]], "plus_fail_tests": []}], "HumanEval/118": [{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"\n    Finds the closest vowel surrounded by two consonants from the right side of the word.\n    Returns an empty string if no such vowel is found.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n    n = len(word)\n\n    if n < 3:\n        return \"\"\n\n    # Iterate from right to left, excluding the first and last characters.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        # Check if current character is a vowel (case-insensitive).\n        is_current_vowel = current_char.lower() in VOWELS\n\n        # Check if left character is a consonant (case-insensitive).\n        is_left_consonant = left_char.isalpha() and left_char.lower() not in VOWELS\n\n        # Check if right character is a consonant (case-insensitive).\n        is_right_consonant = right_char.isalpha() and right_char.lower() not in VOWELS\n\n        if is_current_vowel and is_left_consonant and is_r