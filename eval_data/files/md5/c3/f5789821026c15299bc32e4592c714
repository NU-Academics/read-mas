{"task_id": "HumanEval/55", "solution": "class FibonacciCalculator:\n    \"\"\"Encapsulates the logic for calculating Fibonacci numbers.\"\"\"\n\n    def calculate(self, n: int) -> int:\n        \"\"\"Computes the n-th Fibonacci number.\"\"\"\n        if n <= 0:\n            raise ValueError(\"Input 'n' must be a positive integer.\")\n        elif n == 1:\n            return 1\n        elif n == 2:\n            return 1\n        else:\n            a, b = 1, 1\n            for _ in range(3, n + 1):\n                a, b = b, a + b\n            return b\ndef fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    This function serves as the public API, delegating the calculation to the FibonacciCalculator class.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    calculator = FibonacciCalculator()\n    return calculator.calculate(n)"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n.\n    This function finds the largest prime factor by iteratively dividing n by its smallest prime factors.\n    \"\"\"\n    largest_factor = 1\n\n    # Divide by 2 until n is odd\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Check for odd factors from 3 up to sqrt(n)\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n        i += 2 # Move to the next odd number\n\n    # If n is still greater than 1, it must be the largest prime factor\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n\n    \"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_elements_set = set1.intersection(set2)\n    common_elements_list = list(common_elements_set)\n    common_elements_list.sort()\n    return common_elements_list"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n\n    def _is_non_decreasing(l: list) -> bool:\n        \"\"\"Determines if the elements in list l are in non-decreasing order.\"\"\"\n        if len(l) <= 1:\n            return True\n        for i in range(len(l) - 1):\n            if l[i] > l[i+1]:\n                return False\n        return True\n\n    def _is_non_increasing(l: list) -> bool:\n        \"\"\"Determines if the elements in list l are in non-increasing order.\"\"\"\n        if len(l) <= 1:\n            return True\n        for i in range(len(l) - 1):\n            if l[i] < l[i+1]:\n                return False\n        return True\n\n    is_decreasing = _is_non_decreasing(l)\n    is_increasing = _is_non_increasing(l)\n\n    return is_decreasing or is_increasing"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    counter = 0\n    for char in brackets:\n        if char == '<':\n            counter += 1\n        elif char == '>':\n            counter -= 1\n        if counter < 0:  # Premature closing bracket\n            return False\n    return counter == 0"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    # Use the arithmetic series formula for efficient calculation.\n    # The formula is n * (n + 1) / 2.\n    return n * (n + 1) // 2"}
