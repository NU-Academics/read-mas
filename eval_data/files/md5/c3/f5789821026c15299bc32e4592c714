{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel surrounded by consonants from the right.\"\"\"\n    def _is_vowel(char):\n        \"\"\"Checks if a character is a vowel (case-sensitive).\"\"\"\n        return char in 'aeiouAEIOU'\n\n    def _is_consonant(char):\n        \"\"\"Checks if a character is an English consonant.\"\"\"\n        return char.isalpha() and not _is_vowel(char)\n\n    n = len(word)\n    # We need at least 3 characters to have a vowel surrounded by two neighbors.\n    if n < 3:\n        return \"\"\n\n    # Iterate from right to left, skipping the first and last characters.\n    # The loop should cover indices from n-2 down to 1.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        if _is_vowel(current_char):\n            left_neighbor = word[i - 1]\n            right_neighbor = word[i + 1]\n            if _is_consonant(left_neighbor) and _is_consonant(right_neighbor):\n                return current_char\n\n    return \"\""}
{"task_id": "HumanEval/117", "solution": "def _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n    return char.lower() in 'aeiou'\ndef _count_consonants(word: str) -> int:\n    \"\"\"Counts the number of consonants in a word.\"\"\"\n    consonant_count = 0\n    for char in word:\n        if char.isalpha() and not _is_vowel(char):\n            consonant_count += 1\n    return consonant_count\ndef select_words(s, n):\n    \"\"\"Given a string s and a natural number n, returns a list of all words from string s\n    that contain exactly n consonants, in order these words appear in the string s.\n    \"\"\"\n    if not s:\n        return []\n\n    words = s.split()\n    result_words = []\n\n    for word in words:\n        if _count_consonants(word) == n:\n            result_words.append(word)\n\n    return result_words"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    Sorts an array of non-negative integers by binary ones count, then by decimal value.\n    \"\"\"\n\n    def _count_ones(n: int) -> int:\n        \"\"\"Counts the number of set bits (1s) in the binary representation of n.\"\"\"\n        return bin(n).count('1')\n\n    class SortableInteger:\n        \"\"\"Encapsulates an integer with its binary ones count for custom sorting.\"\"\"\n        def __init__(self, value: int):\n            self.decimal_value = value\n            self.ones_count = _count_ones(value)\n\n        def __lt__(self, other):\n            if self.ones_count != other.ones_count:\n                return self.ones_count < other.ones_count\n            return self.decimal_value < other.decimal_value\n\n    sortable_items = [SortableInteger(x) for x in arr]\n    sortable_items.sort()\n    return [item.decimal_value for item in sortable_items]"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Sort the array in descending order to easily pick the largest elements.\n    arr.sort(reverse=True)\n\n    # Select the first k elements, which are the k maximum numbers.\n    top_k_elements = arr[:k]\n\n    # Sort these k elements in ascending order as required by the problem.\n    top_k_elements.sort()\n\n    return top_k_elements"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if concatenating two parentheses strings in any order results in a balanced string.\n    Returns 'Yes' if a good string can be formed, 'No' otherwise.\n    \"\"\"\n\n    def _is_valid_parentheses_string(s: str) -> bool:\n        \"\"\"Returns True if the string contains only '(' and ')' characters.\"\"\"\n        for char in s:\n            if char not in ['(', ')']:\n                return False\n        return True\n\n    def _get_balance_info(s: str) -> tuple[int, int]:\n        \"\"\"Calculates the final balance and the minimum balance during a left-to-right scan.\"\"\"\n        balance = 0\n        min_balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:\n                balance -= 1\n            min_balance = min(min_balance, balance)\n        return (balance, min_balance)\n\n    def _is_balanced(s: str) -> bool:\n        \"\"\"Determines if a string is balanced based on its final and minimum balance.\"\"\"\n        final_balance, min_balance = _get_balance_info(s)\n        return final_balance == 0 and min_balance >= 0\n\n    if len(lst) != 2:\n        return 'No'\n\n    s1 = lst[0]\n    s2 = lst[1]\n\n    if not _is_valid_parentheses_string(s1) or not _is_valid_parentheses_string(s2):\n        return 'No'\n\n    concat1 = s1 + s2\n    concat2 = s2 + s1\n\n    if _is_balanced(concat1) or _is_balanced(concat2):\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        # Check if the index is even and the number is odd.\n        if i % 2 == 0 and num % 2 != 0:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/122", "solution": "def _is_at_most_two_digits(num: int) -> bool:\n    \"\"\"Determines if an integer has an absolute value less than 100.\"\"\"\n    return abs(num) < 100\nclass SumCalculator:\n    \"\"\"Orchestrates the validation, filtering, and summation of elements based on business rules.\"\"\"\n    def calculate_sum(self, arr: list[int], k: int) -> int:\n        \"\"\"\n        Validates inputs, identifies the first k elements, filters them by digit count,\n        and calculates their sum.\n        \"\"\"\n        _validate_array(arr)\n        _validate_k(k, len(arr))\n\n        total_sum = 0\n        for i in range(k):\n            element = arr[i]\n            if _is_at_most_two_digits(element):\n                total_sum += element\n        return total_sum\ndef add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    calculator = SumCalculator()\n    return calculator.calculate_sum(arr, k)"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n\n    def _generate_collatz_sequence(num):\n        \"\"\"Generates the Collatz sequence starting from num until 1 is reached.\"\"\"\n        sequence = []\n        current_num = num\n        while current_num != 1:\n            sequence.append(current_num)\n            if current_num % 2 == 0:\n                current_num //= 2\n            else:\n                current_num = 3 * current_num + 1\n        sequence.append(1)  # Add the final 1 to the sequence\n        return sequence\n\n    def _extract_unique_odd_numbers(sequence):\n        \"\"\"Filters a given sequence to identify and collect only unique odd numbers.\"\"\"\n        odd_numbers = set()\n        for num in sequence:\n            if num % 2 != 0:\n                odd_numbers.add(num)\n        return list(odd_numbers)\n\n    def _sort_numbers(numbers):\n        \"\"\"Sorts a list of numbers in increasing order.\"\"\"\n        return sorted(numbers)\n\n    collatz_sequence = _generate_collatz_sequence(n)\n    unique_odd_numbers = _extract_unique_odd_numbers(collatz_sequence)\n    sorted_odd_numbers = _sort_numbers(unique_odd_numbers)\n\n    return sorted_odd_numbers"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    \"\"\"\n    if not lst:\n        return True\n\n    # Check for ascending order\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i-1]:\n            return False\n\n    # Check for numbers appearing three or more times\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] >= 3:\n            return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3\n    '''\n\n    def _has_whitespace(text: str) -> bool:\n        return any(char.isspace() for char in text)\n\n    def _has_comma(text: str) -> bool:\n        return ',' in text\n\n    def _split_by_whitespace(text: str) -> list[str]:\n        return text.split()\n\n    def _split_by_comma(text: str) -> list[str]:\n        return text.split(',')\n\n    def _is_lowercase(char: str) -> bool:\n        return 'a' <= char <= 'z'\n\n    def _get_alphabetical_order(char: str) -> int:\n        return ord(char) - ord('a')\n\n    def _is_odd_ordered(order: int) -> bool:\n        return order % 2 != 0\n\n    def _count_odd_ordered_lowercase_letters(text: str) -> int:\n        count = 0\n        for char in text:\n            if _is_lowercase(char):\n                order = _get_alphabetical_order(char)\n                if _is_odd_ordered(order):\n                    count += 1\n        return count\n\n    if _has_whitespace(txt):\n        return _split_by_whitespace(txt)\n    elif _has_comma(txt):\n        return _split_by_comma(txt)\n    else:\n        return _count_odd_ordered_lowercase_letters(txt)"}
{"task_id": "HumanEval/124", "solution": "import re\ndef _is_valid_format(date_string: str) -> tuple[bool, int, int, int]:\n    \"\"\"Helper to check 'mm-dd-yyyy' format and extract components.\n    Returns (True, month, day, year) or (False, 0, 0, 0) on failure.\n    \"\"\"\n    match = re.fullmatch(r'(\\d{2})-(\\d{2})-(\\d{4})', date_string)\n    if not match:\n        return False, 0, 0, 0\n    try:\n        month = int(match.group(1))\n        day = int(match.group(2))\n        year = int(match.group(3))\n        return True, month, day, year\n    except ValueError: # This should ideally not be reached with the regex.\n        return False, 0, 0, 0\ndef _is_valid_month_range(month: int) -> bool:\n    \"\"\"Helper to validate if month is between 1 and 12, inclusive.\"\"\"\n    return 1 <= month <= 12\ndef _is_valid_day_range(day: int, month: int) -> bool:\n    \"\"\"Helper to validate day based on month, considering specific day limits.\"\"\"\n    if day < 1:\n        return False\n    if month in {1, 3, 5, 7, 8, 10, 12}:\n        return day <= 31\n    elif month in {4, 6, 9, 11}:\n        return day <= 30\n    elif month == 2:\n        return day <= 29\n    return False\ndef valid_date(date):\n    \"\"\"Validates a given date string for format 'mm-dd-yyyy' and component ranges.\n    Returns True if valid, False otherwise.\n    \"\"\"\n    # Rule 1: The date string is not empty.\n    if not date:\n        return False\n\n    # Rule 4: The date should be in the format: mm-dd-yyyy\n    is_format_valid, month, day, year = _is_valid_format(date)\n    if not is_format_valid:\n        return False\n\n    # Rule 3: The months should not be less than 1 or higher than 12.\n    if not _is_valid_month_range(month):\n        return False\n\n    # Rule 2: Day validation based on month.\n    if not _is_valid_day_range(day, month):\n        return False\n\n    # If all checks pass, the date is valid."}
{"task_id": "HumanEval/127", "solution": "import math\ndef intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two\n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    intersection_start = max(start1, start2)\n    intersection_end = min(end1, end2)\n\n    if intersection_start > intersection_end:\n        return \"NO\"\n\n    intersection_length = intersection_end - intersection_start\n\n    is_length_prime = _is_prime(intersection_length)\n\n    if is_length_prime:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        if num > 0:\n            product_of_signs *= 1\n        elif num < 0:\n            product_of_signs *= -1\n        else: # num == 0\n            product_of_signs *= 0\n\n        sum_of_magnitudes += abs(num)\n\n    return sum_of_magnitudes * product_of_signs"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product = 1\n    has_odd_digit = False\n\n    # Process digits from right to left\n    while n > 0:\n        digit = n % 10\n        if digit % 2 != 0:  # Check if the digit is odd\n            product *= digit\n            has_odd_digit = True\n        n //= 10\n\n    return product if has_odd_digit else 0"}
{"task_id": "HumanEval/133", "solution": "def sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    \"\"\"\n    import math\n\n    def _round_up(number):\n        \"\"\"Rounds a number up to the nearest integer (ceiling function).\"\"\"\n        return math.ceil(number)\n\n    def _square(number):\n        \"\"\"Squares an integer.\"\"\"\n        return number * number\n\n    total_sum = 0\n    for number in lst:\n        rounded_number = _round_up(number)\n        squared_number = _square(rounded_number)\n        total_sum += squared_number\n    return total_sum"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k,\n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n\n    class Cell:\n        \"\"\"\n        Represents a cell in the grid with its value and coordinates.\n        Provides methods to get coordinates of neighbor cells.\n        \"\"\"\n        def __init__(self, value, row, col):\n            self.value = value\n            self.row = row\n            self.col = col\n\n        def get_neighbors_coords(self, N):\n            \"\"\"\n            Returns a list of valid neighbor coordinates (up, down, left, right).\n            \"\"\"\n            neighbors = []\n            directions = [(0, 1), (0, -1), (1, 0), (-1, 0)] # right, left, down, up\n\n            for dr, dc in directions:\n                nr, nc = self.row + dr, self.col + dc\n                if 0 <= nr < N and 0 <= nc < N:\n                    neighbors.append((nr, nc))\n            return neighbors\n\n    class Grid:\n        \"\"\"\n        Manages the 2D grid structure, storing Cell objects, and provides access\n        and coordinate validation.\n        \"\"\"\n        def __init__(self, grid_data):\n            self.N = len(grid_data)\n            self._cells = [[None for _ in range(self.N)] for _ in range(self.N)]\n            for r in range(self.N):\n                for c in range(self.N):\n                    self._cells[r][c] = Cell(grid_data[r][c], r, c)\n\n        def get_cell(self, row, col):\n            \"\"\"Returns the Cell object at specified coordinates.\"\"\"\n            return self._cells[row][col]\n\n        def is_valid_coord(self, row, col):\n            \"\"\"Checks if coordinates are within grid boundaries.\"\"\"\n            return 0 <= row < self.N and 0 <= col < self.N\n\n    class PathFinder:\n        \"\"\"\n        Implements a recursive Depth-First Search to find the lexicographically\n        smallest path of length k in the grid.\n        \"\"\"\n        def __init__(self, grid, k):\n            self._grid = grid\n            self._k = k\n            self._N = grid.N\n            # Initialize _min_path with 'infinity' values for lexicographical comparison.\n            # Max possible cell value is N*N, so N*N + 1 works as infinity.\n            self._min_path = [self._N * self._N + 1] * self._k\n\n        def find_min_path(self):\n            \"\"\"\n            Orchestrates the search by trying every cell as a starting point.\n            \"\"\"\n            for r in range(self._N):\n                for c in range(self._N):\n                    # Start DFS from each cell\n                    self._dfs(r, c, [self._grid.get_cell(r, c).value])\n            return self._min_path\n\n        def _dfs(self, current_row, current_col, current_path_values):\n            \"\"\"\n            Recursive DFS to explore paths, updating _min_path if a smaller one is found.\n            Includes pruning to avoid exploring paths already known to be larger.\n            \"\"\"\n            current_len = len(current_path_values)\n\n            # Pruning: If current path prefix is already lexicographically greater\n            # or equal to the best path prefix of the same length, stop this branch.\n            if current_len > 0 and current_path_values >= self._min_path[:current_len]:\n                return\n\n            # Base case: Path of length k found\n            if current_len == self._k:\n                if current_path_values < self._min_path: # Lexicographical comparison\n                    self._min_path = list(current_path_values) # Make a copy\n                return\n\n            # Recursive step: Explore neighbors\n            current_cell = self._grid.get_cell(current_row, current_col)\n            neighbors_coords = current_cell.get_neighbors_coords(self._N)\n\n            for nr, nc in neighbors_coords:\n                neighbor_value = self._grid.get_cell(nr, nc).value\n                self._dfs(nr, nc, current_path_values + [neighbor_value])\n\n    def _validate_input(grid_data, k):\n        \"\"\"\n        Validates input grid_data and k according to problem constraints.\n        Raises ValueError for invalid inputs.\n        \"\"\"\n        if not isinstance(grid_data, list) or not grid_data:\n            raise ValueError(\"grid_data must be a non-empty list.\")\n\n        N = len(grid_data)\n        if N < 2:\n            raise ValueError(\"Grid dimension N must be at least 2.\")\n\n        for row in grid_data:\n            if not isinstance(row, list) or len(row) != N:\n                raise ValueError(\"Grid must be square (N x N).\")\n            for val in row:\n                if not isinstance(val, int):\n                    raise ValueError(\"Grid cells must contain integers.\")\n\n        if not isinstance(k, int) or k < 1:\n            raise ValueError(\"k must be a positive integer.\")\n\n    _validate_input(grid, k)\n\n    grid_obj = Grid(grid)\n    path_finder = PathFinder(grid_obj, k)\n\n    return path_finder.find_min_path()"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Generates the first n + 1 numbers of the Tribonacci sequence.\n    The sequence is defined by specific recurrence relations, including a forward dependency for odd-indexed terms.\n    \"\"\"\n    trib_sequence = [0] * (n + 2)\n\n    trib_sequence[0] = 1\n\n    if n == 0:\n        return [trib_sequence[0]]\n\n    trib_sequence[1] = 3\n\n    # First Pass (Compute Even Terms up to n + 1)\n    for i in range(2, n + 2):\n        if i % 2 == 0:\n            trib_sequence[i] = 1 + (i // 2)\n\n    # Second Pass (Compute Odd Terms up to n)\n    for i in range(2, n + 1):\n        if i % 2 != 0:\n            trib_sequence[i] = trib_sequence[i - 1] + trib_sequence[i - 2] + trib_sequence[i + 1]\n\n    return trib_sequence[0:n+1]"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Returns True if the last character of a given string is an alphabetical character\n    and is not a part of a word, and False otherwise.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    char_before_last = txt[-2]\n    if char_before_last == ' ':\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Checks if the input string contains a valid nested bracket subsequence '[[]]'.\n    Returns True if the subsequence '[[]]' is found, False otherwise.\n    '''\n    idx1 = -1\n    idx2 = -1\n    idx3 = -1\n    idx4 = -1\n\n    for i, char in enumerate(string):\n        if char == '[':\n            if idx1 == -1:\n                idx1 = i\n            elif idx2 == -1:\n                idx2 = i\n        elif char == ']':\n            if idx3 == -1 and idx2 != -1:\n                idx3 = i\n            elif idx4 == -1 and idx3 != -1:\n                idx4 = i\n\n    return idx1 != -1 and idx2 != -1 and idx3 != -1 and idx4 != -1"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Finds the largest index i such that arr[i] < arr[i-1]. Returns -1 if no such index exists.\"\"\"\n    n = len(arr)\n    if n < 2:\n        return -1\n\n    # Iterate from the second to last element down to the second element (index 1).\n    # This finds the largest index i that satisfies the condition first.\n    for i in range(n - 1, 0, -1):\n        if arr[i] < arr[i-1]:\n            return i\n\n    # If the loop completes, no such index was found.\n    return -1"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\n    This is possible if n is an even number and is greater than or equal to 8.\n    \"\"\"\n    if n < 8:\n        return False\n    if n % 2 != 0:\n        return False\n    return True"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    '''\n    negative_integers = [x for x in lst if x < 0]\n    positive_integers = [x for x in lst if x > 0]\n\n    largest_negative = max(negative_integers) if negative_integers else None\n    smallest_positive = min(positive_integers) if positive_integers else None\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/137", "solution": "from typing import Any, Optional, Type\nclass ComparableValue:\n    \"\"\"\n    Encapsulates a value for comparison, storing its original form and a standardized\n    numerical representation. Handles string parsing for real numbers.\n    \"\"\"\n    def __init__(self, value: Any):\n        self._original_input: Any = value\n        self._original_type: Type = type(value)\n        self._numeric_value: float\n\n        if isinstance(value, str):\n            self._numeric_value = self._parse_string(value)\n        elif isinstance(value, (int, float)):\n            self._numeric_value = float(value)\n        else:\n            raise TypeError(f\"Unsupported input type: {self._original_type}\")\n\n    def _parse_string(self, input_str: str) -> float:\n        \"\"\"Converts a string to a float, handling '.' or ',' as decimal separators.\"\"\"\n        cleaned_str = input_str.replace(',', '.')\n        return float(cleaned_str)\n\n    def get_original_value(self) -> Any:\n        \"\"\"Returns the original input value.\"\"\"\n        return self._original_input\n\n    def get_larger(self, other: 'ComparableValue') -> Optional['ComparableValue']:\n        \"\"\"Compares this instance with another and returns the numerically larger, or None if equal.\"\"\"\n        if self._numeric_value > other._numeric_value:\n            return self\n        elif other._numeric_value > self._numeric_value:\n            return other\n        else:\n            return None\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, ComparableValue):\n            return NotImplemented\n        return self._numeric_value == other._numeric_value\n\n    def __lt__(self, other: object) -> bool:\n        if not isinstance(other, ComparableValue):\n            return NotImplemented\n        return self._numeric_value < other._numeric_value\n\n    def __gt__(self, other: object) -> bool:\n        if not isinstance(other, ComparableValue):\n            return NotImplemented\n        return self._numeric_value > other._numeric_value\n\n    def __repr__(self) -> str:\n        return f\"ComparableValue(original={self._original_input!r}, numeric={self._numeric_value})\"\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n\n    compare_one(1, 2.5) \u279e 2.5\n    compare_one(1, \"2,3\") \u279e \"2,3\"\n    compare_one(\"5,1\", \"6\") \u279e \"6\"\n    compare_one(\"1\", 1) \u279e None\n    \"\"\"\n    val_a = ComparableValue(a)\n    val_b = ComparableValue(b)\n\n    if val_a == val_b:\n        return None\n    elif val_a > val_b:\n        return val_a.get_original_value()\n    else:\n        return val_b.get_original_value()"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n    \"\"\"\n    def _calculate_factorial(k):\n        \"\"\"Calculates the standard factorial of a non-negative integer k.\"\"\"\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    special_fact_total = 1\n    for k in range(n, 0, -1):\n        current_factorial = _calculate_factorial(k)\n        special_fact_total *= current_factorial\n    return special_fact_total"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n\n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    # Replace sequences of three or more consecutive space characters with a single hyphen.\n    modified_text = re.sub(r' {3,}', '-', text)\n\n    # Replace all remaining individual space characters with an underscore.\n    modified_text = modified_text.replace(' ', '_')\n\n    return modified_text"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, keeping only those with prime lengths.\n    It orchestrates the process by splitting the sentence, checking word lengths for primality, and joining the valid words.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split()\n    prime_length_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    This function processes a list of integers, modifying entries based on their index,\n    and returns the sum of all processed entries.\n    \"\"\"\n    total_sum = 0\n    for i, entry in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += entry ** 2\n        elif i % 4 == 0:\n            total_sum += entry ** 3\n        else:\n            total_sum += entry\n    return total_sum"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    \"\"\"\n\n    class FileName:\n        \"\"\"Encapsulates a file name string and provides methods to parse its components.\"\"\"\n        def __init__(self, name_string: str):\n            self._name_string = name_string\n            self._prefix = None\n            self._extension = None\n\n        def parse_name(self) -> bool:\n            \"\"\"Parses the name into prefix and extension. Returns True if exactly one dot is found, False otherwise.\"\"\"\n            dot_count = self._name_string.count('.')\n            if dot_count != 1:\n                self._prefix = None\n                self._extension = None\n                return False\n\n            parts = self._name_string.rsplit('.', 1)\n            self._prefix = parts[0]\n            self._extension = parts[1]\n            return True\n\n        def get_name_string(self) -> str:\n            return self._name_string\n\n        def get_prefix(self) -> str | None:\n            return self._prefix\n\n        def get_extension(self) -> str | None:\n            return self._extension\n\n    class FileValidationReport:\n        \"\"\"Stores the overall validation result and a list of specific rule violations.\"\"\"\n        def __init__(self):\n            self._is_valid = True\n            self._violations = []\n\n        def add_violation(self, rule_description: str):\n            self._is_valid = False\n            self._violations.append(rule_description)\n\n        def get_result(self) -> str:\n            return 'Yes' if self._is_valid else 'No'\n\n        def get_violations(self) -> list[str]:\n            return self._violations\n\n    def _validate_digit_count(file_name_obj: FileName, report: FileValidationReport) -> bool:\n        \"\"\"Checks if there are more than three digits in the file's name.\"\"\"\n        digit_count = sum(1 for char in file_name_obj.get_name_string() if char.isdigit())\n        if digit_count > 3:\n            report.add_violation(\"More than three digits found.\")\n            return False\n        return True\n\n    def _validate_dot_count_and_parse(file_name_obj: FileName, report: FileValidationReport) -> bool:\n        \"\"\"Ensures exactly one dot and attempts to parse the file name, adding a violation if parsing fails.\"\"\"\n        if not file_name_obj.parse_name():\n            report.add_violation(\"File name does not contain exactly one dot.\")\n            return False\n        return True\n\n    def _validate_prefix_not_empty(file_name_obj: FileName, report: FileValidationReport) -> bool:\n        \"\"\"Checks if the substring before the dot is not empty.\"\"\"\n        prefix = file_name_obj.get_prefix()\n        if prefix is None or len(prefix) == 0:\n            report.add_violation(\"Prefix before dot cannot be empty.\")\n            return False\n        return True\n\n    def _validate_prefix_starts_with_letter(file_name_obj: FileName, report: FileValidationReport) -> bool:\n        \"\"\"Checks if the substring before the dot starts with a latin alphabet letter.\"\"\"\n        prefix = file_name_obj.get_prefix()\n        if prefix is None or not prefix[0].isalpha():\n            report.add_violation(\"Prefix must start with a latin alphabet letter.\")\n            return False\n        return True\n\n    def _validate_extension_type(file_name_obj: FileName, report: FileValidationReport) -> bool:\n        \"\"\"Checks if the extension is one of the allowed types: ['txt', 'exe', 'dll'].\"\"\"\n        allowed_extensions = ['txt', 'exe', 'dll']\n        extension = file_name_obj.get_extension()\n        if extension is None or extension.lower() not in allowed_extensions:\n            report.add_violation(\"Invalid file extension.\")\n            return False\n        return True\n\n    name_obj = FileName(file_name)\n    validation_report = FileValidationReport()\n\n    _validate_digit_count(name_obj, validation_report)\n\n    # This step handles the \"exactly one dot\" condition and populates prefix/extension.\n    # Subsequent checks will operate on these parsed parts.\n    dot_and_parse_ok = _validate_dot_count_and_parse(name_obj, validation_report)\n\n    # Only perform prefix/extension-specific checks if the name was successfully parsed with one dot.\n    # The helper functions are designed to handle 'None' gracefully if dot_and_parse_ok is False,\n    # but this guard prevents redundant violation messages.\n    if dot_and_parse_ok:\n        _validate_prefix_not_empty(name_obj, validation_report)\n        _validate_prefix_starts_with_letter(name_obj, validation_report)\n        _validate_extension_type(name_obj, validation_report)\n\n    return validation_report.get_result()"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n    \"\"\"\n\n    def _gcd(a: int, b: int) -> int:\n        \"\"\"Calculates the greatest common divisor of two integers.\"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\n    class Fraction:\n        \"\"\"Represents a mathematical fraction and provides operations.\"\"\"\n        def __init__(self, numerator: int, denominator: int):\n            common = _gcd(numerator, denominator)\n            self.numerator = numerator // common\n            self.denominator = denominator // common\n\n        @classmethod\n        def from_string(cls, fraction_string: str) -> 'Fraction':\n            \"\"\"Parses a string in '<numerator>/<denominator>' format to create a Fraction.\"\"\"\n            num_str, den_str = fraction_string.split('/')\n            return cls(int(num_str), int(den_str))\n\n        def multiply(self, other_fraction: 'Fraction') -> 'Fraction':\n            \"\"\"Multiplies this fraction by another fraction and returns the product as a new simplified Fraction.\"\"\"\n            new_numerator = self.numerator * other_fraction.numerator\n            new_denominator = self.denominator * other_fraction.denominator\n            return Fraction(new_numerator, new_denominator)\n\n        def is_whole_number(self) -> bool:\n            \"\"\"Determines if the fraction represents a whole number (i.e., its denominator is 1 after simplification).\"\"\"\n            return self.denominator == 1\n\n    fraction_x = Fraction.from_string(x)\n    fraction_n = Fraction.from_string(n)\n\n    product_fraction = fraction_x.multiply(fraction_n)\n\n    return product_fraction.is_whole_number()"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order based on the sum of their digits,\n    then by their original index for ties.\n    \"\"\"\n\n    class AugmentedNumber:\n        \"\"\"\n        Helper class to encapsulate a number's value, original index, and digit sum for custom sorting.\n        \"\"\"\n        def __init__(self, value: int, original_index: int):\n            self.value = value\n            self.original_index = original_index\n            self.digit_sum = _calculate_digit_sum(value)\n\n        def __lt__(self, other: 'AugmentedNumber') -> bool:\n            \"\"\"\n            Compares two AugmentedNumber objects first by digit_sum, then by original_index.\n            \"\"\"\n            if self.digit_sum != other.digit_sum:\n                return self.digit_sum < other.digit_sum\n            return self.original_index < other.original_index\n\n    def _calculate_digit_sum(number: int) -> int:\n        \"\"\"\n        Calculates the sum of digits for a given integer using its absolute value.\n        \"\"\"\n        s = str(abs(number))\n        return sum(int(digit) for digit in s)\n\n    if not nums:\n        return []\n\n    # Augment numbers with their digit sums and original indices\n    augmented_numbers = [AugmentedNumber(num, i) for i, num in enumerate(nums)]\n\n    # Sort the augmented numbers using the custom comparison\n    augmented_numbers.sort()\n\n    # Extract the original values from the sorted augmented numbers\n    sorted_result = [an.value for an in augmented_numbers]\n\n    return sorted_result"}
{"task_id": "HumanEval/146", "solution": "class NumberProcessor:\n    \"\"\"Helper class to encapsulate logic for determining if a number is 'special'.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def _get_first_digit(self):\n        \"\"\"Extracts the first digit of the number's absolute value.\"\"\"\n        num_str = str(abs(int(self.value)))\n        return int(num_str[0])\n\n    def _get_last_digit(self):\n        \"\"\"Extracts the last digit of the number's absolute value.\"\"\"\n        num_str = str(abs(int(self.value)))\n        return int(num_str[-1])\n\n    def is_odd(self, digit):\n        \"\"\"Checks if a given digit is odd.\"\"\"\n        return digit in (1, 3, 5, 7, 9)\n\n    def is_special(self):\n        \"\"\"Determines if the number meets all 'special' criteria.\"\"\"\n        if self.value <= 10:\n            return False\n\n        first_digit = self._get_first_digit()\n        last_digit = self._get_last_digit()\n\n        return self.is_odd(first_digit) and self.is_odd(last_digit)\ndef specialFilter(nums):\n    \"\"\"\n    Counts elements greater than 10 where both first and last digits are odd.\n    Applies a NumberProcessor for each number to check conditions.\n    \"\"\"\n    count = 0\n    for num in nums:\n        processor = NumberProcessor(num)\n        if processor.is_special():\n            count += 1\n    return count"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings to keep only those with even lengths,\n    then sorts them by length and alphabetically.\"\"\"\n    even_length_strings = []\n    for word in lst:\n        if len(word) % 2 == 0:\n            even_length_strings.append(word)\n\n    even_length_strings.sort(key=lambda word: (len(word), word))\n    return even_length_strings"}
{"task_id": "HumanEval/148", "solution": "_PLANET_DATA = {\n    'PLANETS_ORDERED_LIST': [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"],\n}\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun\n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn,\n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2.\n    The function should return a tuple containing all planets whose orbits are\n    located between the orbit of planet1 and the orbit of planet2, sorted by\n    the proximity to the sun.\n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names.\n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n\n    # Validate input planet names using the pre-defined map.\n    if planet1 not in _PLANET_DATA['PLANET_TO_ORDER_MAP'] or \\\n       planet2 not in _PLANET_DATA['PLANET_TO_ORDER_MAP']:\\\n        return ()\n\n    # Get the orbital indices of the two input planets.\n    order1 = _PLANET_DATA['PLANET_TO_ORDER_MAP'][planet1]\n    order2 = _PLANET_DATA['PLANET_TO_ORDER_MAP'][planet2]\n\n    # Determine the effective start and end indices for slicing the ordered list.\n    start_index = min(order1, order2)\n    end_index = max(order1, order2)\n\n    # Slice the list to get planets strictly between the two indices.\n    # The slice [start_index + 1 : end_index] naturally excludes the boundary planets\n    # and keeps the result sorted by proximity to the sun.\n    intermediate_planets = _PLANET_DATA['PLANETS_ORDERED_LIST'][start_index + 1 : end_index]\n\n    return tuple(intermediate_planets)"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n    \"\"\"\n\n    def is_prime(num: int) -> bool:\n        \"\"\"Determines if an integer num is a prime number.\"\"\"\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n\n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0\n\n    If the input list is empty, return 0.\n    '''\n\n    def _is_integer(num):\n        # Checks if num is an integer type or a float that numerically represents an integer.\n        if isinstance(num, int):\n            return True\n        if isinstance(num, float):\n            return num == int(num)\n        return False\n\n    def _is_positive(num):\n        # Checks if the number is greater than zero.\n        return num > 0\n\n    def _is_odd(num):\n        # Checks if the number is odd.\n        return num % 2 != 0\n\n    def _get_square(num):\n        # Returns the square of the number.\n        return num * num\n\n    total_sum_of_squares = 0\n\n    for num in lst:\n        if _is_integer(num):\n            # Convert to int after validating it's an integer-like number.\n            int_num = int(num)\n            if _is_positive(int_num) and _is_odd(int_num):\n                total_sum_of_squares += _get_square(int_num)\n\n    return total_sum_of_squares"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Determines how far off each guess was for a series of matches.\n    Returns 0 if the guess was correct, otherwise the absolute difference.\n    \"\"\"\n    differences = []\n    for score, g in zip(game, guess):\n        if score == g:\n            differences.append(0)\n        else:\n            differences.append(abs(score - g))\n    return differences"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Take the absolute value to handle negative numbers\n    absolute_num = abs(num)\n\n    # Convert the number to a string to iterate through its digits\n    num_str = str(absolute_num)\n\n    for digit_char in num_str:\n        digit_int = int(digit_char)\n        if digit_int % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Converts a positive integer to its lowercase Roman numeral equivalent.\n    The input number must be between 1 and 1000 inclusive.\n    \"\"\"\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'),\n        (1, 'I')\n    ]\n\n    roman_numeral = []\n    for value, symbol in roman_map:\n        while number >= value:\n            roman_numeral.append(symbol)\n            number -= value\n\n    return \"\".join(roman_numeral).lower()"}
{"task_id": "HumanEval/153", "solution": "class Extension:\n    \"\"\"Represents a potential extension with its name and calculated strength.\"\"\"\n    def __init__(self, name: str):\n        self.name = name\n        self.strength = self._calculate_strength()\n\n    def _calculate_strength(self) -> int:\n        \"\"\"Calculates the strength of the extension based on CAP - SM.\"\"\"\n        cap_count = sum(1 for char in self.name if char.isupper())\n        sm_count = sum(1 for char in self.name if char.islower())\n        return cap_count - sm_count\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension for a given class name, based on character counts.\n    Returns the class name combined with the strongest extension name.\"\"\"\n    if not extensions:\n        return class_name + \".NoExtension\"\n\n    strongest_ext_obj = None\n    max_strength = -float('inf')\n\n    for ext_name in extensions:\n        current_ext_obj = Extension(ext_name)\n        if current_ext_obj.strength > max_strength:\n            max_strength = current_ext_obj.strength\n            strongest_ext_obj = current_ext_obj\n\n    if strongest_ext_obj:\n        return f\"{class_name}.{strongest_ext_obj.name}\"\n    else:\n        # This case should not be reached if extensions list is not empty\n        return class_name + \".Error\""}
{"task_id": "HumanEval/154", "solution": "def _generate_cyclic_rotations(s: str) -> list[str]:\n    \"\"\"\n    Generates all unique cyclic rotations of a given string.\n    \"\"\"\n    if not s:\n        return [\"\"]\n    rotations = set()\n    n = len(s)\n    for i in range(n):\n        rotated_s = s[i:] + s[:i]\n        rotations.add(rotated_s)\n    return sorted(list(rotations))\ndef cycpattern_check(a , b):\n    \"\"\"\n    Checks if the second word `b` or any of its unique cyclic rotations\n    is a substring in the first word `a`.\n    \"\"\"\n    if not b:\n        return \"\" in a\n\n    unique_rotations_b = _generate_cyclic_rotations(b)\n\n    for rotation in unique_rotations_b:\n        if rotation in a:\n            return True\n    return False"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) from array a where i < j < k and a[i] + a[j] + a[k] is a multiple of 3.\n    Array a is generated with a[x] = x*x - x + 1 for 1 <= x <= n.\n    \"\"\"\n\n    class Element:\n        def __init__(self, index: int, value: int, value_mod_3: int):\n            self.index = index\n            self.value = value\n            self.valueMod3 = value_mod_3\n\n    class Triple:\n        def __init__(self, val_i: int, val_j: int, val_k: int):\n            self.sum = val_i + val_j + val_k\n\n        def isSumMultipleOf3(self) -> bool:\n            return self.sum % 3 == 0\n\n    class IntegerArray:\n        def __init__(self):\n            self._elements = []\n            self.length = 0\n\n        def generate(self, n_val: int) -> None:\n            # Use 1-based indexing, element at index 0 is unused.\n            self._elements = [None] * (n_val + 1)\n            self.length = n_val\n            for i in range(1, n_val + 1):\n                value = i * i - i + 1\n                value_mod_3 = value % 3\n                self._elements[i] = Element(i, value, value_mod_3)\n\n        def getElement(self, index: int) -> Element:\n            return self._elements[index]\n\n    class ProblemSolver:\n        def solve(self, n_val: int) -> int:\n            integer_array = IntegerArray()\n            integer_array.generate(n_val)\n\n            count = 0\n            # Iterate through all possible unique triples (a[i], a[j], a[k]) with i < j < k.\n            # Indices are 1-based, from 1 to n_val.\n            for i in range(1, n_val - 1):\n                elem_i = integer_array.getElement(i)\n                for j in range(i + 1, n_val):\n                    elem_j = integer_array.getElement(j)\n                    for k in range(j + 1, n_val + 1):\n                        elem_k = integer_array.getElement(k)\n\n                        # Create Triple object and check if its sum is a multiple of 3.\n                        current_triple = Triple(elem_i.value, elem_j.value, elem_k.value)\n                        if current_triple.isSumMultipleOf3():\n                            count += 1\n            return count\n\n    solver = ProblemSolver()\n    return solver.solve(n)"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total number of carrots eaten and the remaining carrots after a meal.\n    The rabbit eats either its 'need' or all 'remaining' carrots, whichever is less.\n    \"\"\"\n    carrots_eaten_this_meal = min(need, remaining)\n    total_eaten_carrots = number + carrots_eaten_this_meal\n    final_remaining_carrots = remaining - carrots_eaten_this_meal\n    return [total_eaten_carrots, final_remaining_carrots]"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    # Encode the string to bytes before hashing using UTF-8.\n    md5_hash = hashlib.md5(text.encode('utf-8')).hexdigest()\n    return md5_hash"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n\n    find_max([\"name\", \"of\", \"string\"]) == \"string\"\n    find_max([\"name\", \"enam\", \"game\"]) == \"enam\"\n    find_max([\"aaaaaaa\", \"bb\" ,\"cc\"]) == \"\"aaaaaaa\"\n    \"\"\"\n    import functools\n\n    @functools.total_ordering\n    class Word:\n        \"\"\"Represents a single word, calculates its unique character count, and supports lexicographical comparison.\"\"\"\n        def __init__(self, value: str):\n            self._value = value\n            self._unique_character_count = self._calculate_unique_character_count()\n\n        def _calculate_unique_character_count(self) -> int:\n            \"\"\"Calculates the number of unique characters in the word.\"\"\"\n            return len(set(self._value))\n\n        def get_value(self) -> str:\n            \"\"\"Returns the string value of the word.\"\"\"\n            return self._value\n\n        def get_unique_character_count(self) -> int:\n            \"\"\"Returns the unique character count of the word.\"\"\"\n            return self._unique_character_count\n\n        def __lt__(self, other: 'Word') -> bool:\n            \"\"\"Compares two Word objects lexicographically.\"\"\"\n            return self._value < other._value\n\n        def __eq__(self, other: object) -> bool:\n            \"\"\"Checks for equality based on the word's value.\"\"\"\n            if not isinstance(other, Word):\n                return NotImplemented\n            return self._value == other._value\n\n        def __repr__(self) -> str:\n            \"\"\"String representation for debugging.\"\"\"\n            return f\"Word(value='{self._value}', unique_chars={self._unique_character_count})\"\n\n    class WordList:\n        \"\"\"Manages a collection of Word objects and finds the word with the maximum unique characters.\"\"\"\n        def __init__(self, string_list: list[str]):\n            self._words: list[Word] = [Word(s) for s in string_list]\n\n        def get_word_with_max_unique_chars(self) -> str:\n            \"\"\"Finds and returns the string with the maximum unique characters, applying lexicographical tie-breaking.\"\"\"\n            if not self._words:\n                return \"\"\n\n            max_unique_count = -1\n            best_word: Word | None = None\n\n            for word in self._words:\n                current_unique_count = word.get_unique_character_count()\n\n                if current_unique_count > max_unique_count:\n                    max_unique_count = current_unique_count\n                    best_word = word\n                elif current_unique_count == max_unique_count:\n                    if best_word is None or word < best_word: # Tie-breaking: return the one which comes first in lexicographical order\n                        best_word = word\n\n            return best_word.get_value() if best_word else \"\"\n\n    word_list_processor = WordList(words)\n    return word_list_processor.get_word_with_max_unique_chars()"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa,\n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n\n    def _has_letters(s):\n        \"\"\"Checks if the string contains any alphabetic characters.\"\"\"\n        for char in s:\n            if char.isalpha():\n                return True\n        return False\n\n    def _reverse_string(s):\n        \"\"\"Reverses the order of characters in a string.\"\"\"\n        return s[::-1]\n\n    def _transform_character_case(char):\n        \"\"\"Reverses the case of a letter or keeps non-letters unchanged.\"\"\"\n        if char.isalpha():\n            if char.islower():\n                return char.upper()\n            else: # char.isupper()\n                return char.lower()\n        else:\n            return char\n\n    if not _has_letters(s):\n        return _reverse_string(s)\n    else:\n        transformed_chars = []\n        for char in s:\n            transformed_chars.append(_transform_character_case(char))\n        return \"\".join(transformed_chars)"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Builds an algebraic expression from given operators and operands and returns its evaluation.\n    The function assumes valid inputs according to the problem description's notes.\n    \"\"\"\n    expression_parts = []\n    expression_parts.append(str(operand[0]))\n\n    for i in range(len(operator)):\n        expression_parts.append(operator[i])\n        expression_parts.append(str(operand[i+1]))\n\n    expression_str = \" \".join(expression_parts)\n\n    # Evaluate the expression string. Python's eval() handles standard operator precedence.\n    # The result is cast to an integer as specified in the example and problem notes.\n    return int(eval(expression_str))"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    start = min(a, b)\n    end = max(a, b)\n    even_digits = []\n\n    for i in range(start, end + 1):\n        # Check if it's a single digit (0-9) and if it's even.\n        if 0 <= i <= 9 and i % 2 == 0:\n            even_digits.append(i)\n\n    return even_digits"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Sides must be positive to form a valid triangle.\n    if a <= 0 or b <= 0 or c <= 0:\n        return False\n\n    # Sort the sides to easily identify the hypotenuse (longest side).\n    sides = sorted([a, b, c])\n\n    # Assign the sorted sides to variables for clarity.\n    # x and y are the shorter sides (legs), z is the longest side (hypotenuse).\n    x, y, z = sides[0], sides[1], sides[2]\n\n    # The Pythagorean theorem states: x^2 + y^2 = z^2\n    # Due to potential floating-point inaccuracies, direct equality (==) should be avoided.\n    # Instead, check if the absolute difference between (x^2 + y^2) and z^2 is very small.\n    epsilon = 1e-9  # A small tolerance for floating-point comparison\n\n    return abs(x**2 + y**2 - z**2) < epsilon"}
