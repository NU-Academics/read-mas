{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n    return False"}
{"task_id": "HumanEval/42", "solution": "def incr_list(l: list):\n    \"\"\"Return list with elements incremented by 1.\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    \"\"\"\n    new_list = []\n    for item in l:\n        new_list.append(item + 1)\n    return new_list"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    seen_numbers = set()\n\n    for num in l:\n        complement = -num\n        if complement in seen_numbers:\n            return True\n        seen_numbers.add(num)\n\n    return False"}
{"task_id": "HumanEval/39", "solution": "import math\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    def _is_perfect_square_inline(n_check: int) -> bool:\n        if n_check < 0:\n            return False\n        s = int(math.sqrt(n_check))\n        return s * s == n_check\n\n    def _is_fibonacci(num: int) -> bool:\n        if num < 0:\n            return False\n        if num == 0 or num == 1:\n            return True\n        return _is_perfect_square_inline(5 * num * num + 4) or _is_perfect_square_inline(5 * num * num - 4)\n\n    def _is_prime(num: int) -> bool:\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False"}
{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    class Triangle:\n        \"\"\"Encapsulates triangle dimensions and the logic to calculate its area.\"\"\"\n        def __init__(self, side_length: float, height: float):\n            self.side_length = side_length\n            self.height = height\n\n        def calculate_area(self) -> float:\n            \"\"\"Calculates the area of the triangle using the formula (side_length * height) / 2.\"\"\"\n            return (self.side_length * self.height) / 2\n\n    triangle = Triangle(a, h)\n    return triangle.calculate_area()"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x == 0:\n        return '0'\n\n    result_digits = []\n    is_negative = False\n    if x < 0:\n        is_negative = True\n        x = abs(x)\n\n    while x > 0:\n        remainder = x % base\n        result_digits.append(str(remainder))\n        x //= base\n\n    if is_negative:\n        result_digits.append('-')\n\n    return ''.join(result_digits[::-1])"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize a list for dynamic programming to store fib4(i)\n    dp = [0] * (n + 1)\n\n    # Set base cases\n    dp[0] = 0\n    dp[1] = 0\n    dp[2] = 2\n    dp[3] = 0\n\n    # Compute iteratively for n > 3\n    for i in range(4, n + 1):\n        dp[i] = dp[i-1] + dp[i-2] + dp[i-3] + dp[i-4]\n\n    return dp[n]"}
{"task_id": "HumanEval/49", "solution": "class ModulusOperation:\n    \"\"\"Encapsulates the algorithm for computing 2^n modulo p using modular exponentiation.\"\"\"\n    def __init__(self, n: int, p: int):\n        self._n = n\n        self._p = p\n\n    def calculate(self) -> int:\n        \"\"\"Computes 2^n % p using exponentiation by squaring to prevent overflow.\"\"\"\n        res = 1\n        base = 2\n        exponent = self._n\n        modulus = self._p\n\n        while exponent > 0:\n            if exponent % 2 == 1:\n                res = (res * base) % modulus\n            base = (base * base) % modulus\n            exponent //= 2\n        return res\ndef modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\"\"\"\n    calculator = ModulusOperation(n, p)\n    return calculator.calculate()"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    if not l:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # For odd length lists, return the middle element.\n        return sorted_l[n // 2]\n    else:\n        # For even length lists, return the average of elements at indices n//2 and n//2 + 1.\n        # This matches the provided example's expected output.\n        middle1 = sorted_l[n // 2 - 1] # Corrected index based on common median definition\n        middle2 = sorted_l[n // 2]\n        return (middle1 + middle2) / 2.0"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    return text == text[::-1]"}
