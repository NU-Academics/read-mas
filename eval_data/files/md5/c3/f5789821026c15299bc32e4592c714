{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers or len(numbers) == 1:\n        return list(numbers)\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    def _preprocess_string(raw_content: str) -> str:\n        \"\"\"Removes all space characters from the input string.\"\"\"\n        return raw_content.replace(' ', '')\n\n    def _is_balanced(group_content: str) -> bool:\n        \"\"\"Checks if a given parenthesis string segment is balanced.\"\"\"\n        balance = 0\n        for char in group_content:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    def _find_top_level_groups(processed_content: str) -> List[str]:\n        \"\"\"Identifies and extracts distinct, balanced, and non-nested top-level parenthesis groups.\"\"\"\n        groups = []\n        balance = 0\n        start_index = 0\n\n        for i, char in enumerate(processed_content):\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n\n            if balance == 0 and i >= start_index:\n                group = processed_content[start_index : i + 1]\n                groups.append(group)\n                start_index = i + 1\n            elif balance < 0:\n                balance = 0\n                start_index = i + 1\n        return groups\n\n    processed_string = _preprocess_string(paren_string)\n    separated_groups = _find_top_level_groups(processed_string)\n    return separated_groups"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    result_list = []\n    for s in strings:\n        if substring in s:\n            result_list.append(s)\n    return result_list"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    \"\"\"\n\n    class ParenthesesGroup:\n        \"\"\"Represents a single group of parentheses and calculates its deepest nesting level.\"\"\"\n\n        def __init__(self, group_string: str):\n            self._group_string: str = group_string\n            self._deepest_nesting_level: int = 0\n\n        def calculate_deepest_nesting(self) -> None:\n            current_level = 0\n            max_level = 0\n            for char in self._group_string:\n                if char == '(':\n                    current_level += 1\n                    max_level = max(max_level, current_level)\n                elif char == ')':\n                    current_level -= 1\n            self._deepest_nesting_level = max_level\n\n        def get_deepest_nesting_level(self) -> int:\n            return self._deepest_nesting_level\n\n    class ParenthesesString:\n        \"\"\"Manages the raw input string and orchestrates the parsing into groups.\"\"\"\n\n        def __init__(self, raw_input: str):\n            self._raw_input: str = raw_input\n            self._groups: List[ParenthesesGroup] = []\n\n        def parse_groups(self) -> None:\n            group_strings = self._raw_input.split(' ')\n            for group_str in group_strings:\n                if group_str:  # Handle potential empty strings from multiple spaces\n                    group = ParenthesesGroup(group_str)\n                    group.calculate_deepest_nesting()\n                    self._groups.append(group)\n\n        def get_nesting_levels(self) -> List[int]:\n            return [group.get_deepest_nesting_level() for group in self._groups]\n\n    paren_string_obj = ParenthesesString(paren_string)\n    paren_string_obj.parse_groups()\n    return paren_string_obj.get_nesting_levels()"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    current_max = float('-inf')\n\n    for num in numbers:\n        current_max = max(current_max, num)\n        result.append(current_max)\n\n    return result"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    for i in range(len(string)):\n        postfix = string[i:]\n        if is_palindrome(postfix):\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]\n    return string"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n    for num in numbers:\n        current_sum += num\n        current_product *= num\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    class BinaryString:\n        \"\"\"Encapsulates a binary string, provides validation, and ensures immutability.\"\"\"\n        def __init__(self, value: str):\n            if not self.is_valid_content(value):\n                raise ValueError(\"Input string must consist exclusively of '0's and '1's.\")\n            self._value = value\n\n        def get_value(self) -> str:\n            \"\"\"Returns the string value.\"\"\"\n            return self._value\n\n        def get_length(self) -> int:\n            \"\"\"Returns the length of the string.\"\"\"\n            return len(self._value)\n\n        @staticmethod\n        def is_valid_content(value: str) -> bool:\n            \"\"\"Checks if a string consists only of '0's and '1's.\"\"\"\n            return all(char in ('0', '1') for char in value)\n\n    # Validate inputs using BinaryString class\n    binary_a = BinaryString(a)\n    binary_b = BinaryString(b)\n\n    # Check for equal length\n    if binary_a.get_length() != binary_b.get_length():\n        raise ValueError(\"Input strings must have the same length.\")\n\n    result_chars: List[str] = []\n    for i in range(binary_a.get_length()):\n        char_a = binary_a.get_value()[i]\n        char_b = binary_b.get_value()[i]\n        # Perform XOR operation\n        if char_a != char_b:\n            result_chars.append('1')\n        else:\n            result_chars.append('0')\n\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    distinct_chars = set()\n    for char in string:\n        distinct_chars.add(char.lower())\n    return len(distinct_chars)"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Out of list of strings, return the longest one.\n    Returns the first one in case of multiple strings of the same length, or None if the list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_so_far = strings[0]\n    max_length = len(strings[0])\n\n    for i in range(1, len(strings)):\n        current_string = strings[i]\n        current_string_length = len(current_string)\n        if current_string_length > max_length:\n            longest_so_far = current_string\n            max_length = current_string_length\n\n    return longest_so_far"}
{"task_id": "HumanEval/14", "solution": "from typing import List\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    prefixes = []\n    for i in range(1, len(string) + 1):\n        prefixes.append(string[0:i])\n    return prefixes"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    if b == 0:\n        return abs(a)\n    while b:\n        a, b = b, a % b\n    return abs(a)"}
{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    if n < 0:\n        # Handle cases where n is negative, returning an empty string.\n        return ''\n\n    # Generate strings for numbers from 0 to n and join them with spaces.\n    numbers = [str(i) for i in range(n + 1)]\n    return ' '.join(numbers)"}
{"task_id": "HumanEval/17", "solution": "from typing import List\nclass MusicalNote:\n    \"\"\"Encapsulates a musical note's symbol and calculates its beat duration.\"\"\"\n\n    _BEAT_MAP = {\n        'o': 4,\n        'o|': 2,\n        '.|': 1\n    }\n\n    def __init__(self, symbol: str):\n        \"\"\"Initializes a MusicalNote with a symbol and calculates its beats.\"\"\"\n        self._symbol = symbol\n        self._beats = self._BEAT_MAP.get(symbol, 0)\n\n    def get_beats(self) -> int:\n        \"\"\"Returns the beat duration of the note.\"\"\"\n        return self._beats\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\" Parses a string of musical notes and returns a list of their beat durations.\n    \"\"\"\n    beat_durations = []\n    note_symbols = music_string.split(' ')\n\n    for symbol in note_symbols:\n        note = MusicalNote(symbol)\n        beat_durations.append(note.get_beats())\n\n    return beat_durations"}
{"task_id": "HumanEval/19", "solution": "def sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    _NUMBER_WORD_MAP = {\n        'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n        'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n    }\n\n    # Split the input string into individual number words.\n    number_words = numbers.split(' ')\n\n    # Filter out unrecognized words and map valid words to their integer values.\n    # Each item in `mapped_words` will be a tuple (word, value).\n    mapped_words = []\n    for word in number_words:\n        if word in _NUMBER_WORD_MAP:\n            mapped_words.append((word, _NUMBER_WORD_MAP[word]))\n\n    # Sort the mapped words based on their integer values.\n    # The default behavior for tuples is to sort by the first element, then the second.\n    # Here, we need to sort explicitly by the second element (the integer value).\n    mapped_words.sort(key=lambda item: item[1])\n\n    # Extract the sorted number words back into a list.\n    sorted_number_words = [item[0] for item in mapped_words]\n\n    # Join the sorted words back into a single space-delimited string.\n    return ' '.join(sorted_number_words)"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlaping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n    count = 0\n    # Iterate through the string from the first character to the last possible starting position\n    # where the substring could fit. This handles overlapping occurrences naturally.\n    for i in range(len(string) - len(substring) + 1):\n        if string[i : i + len(substring)] == substring:\n            count += 1\n    return count"}
{"task_id": "HumanEval/20", "solution": "def find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\" From a supplied list of numbers (of length at least two) select and return two that are the closest to each\n    other and return them in order (smaller number, larger number).\n    \"\"\"\n    sorted_numbers = sorted(numbers)\n\n    min_diff = float('inf')\n    closest_pair = (sorted_numbers[0], sorted_numbers[1])\n\n    for i in range(len(sorted_numbers) - 1):\n        num1 = sorted_numbers[i]\n        num2 = sorted_numbers[i + 1]\n        current_diff = num2 - num1\n\n        if current_diff < min_diff:\n            min_diff = current_diff\n            closest_pair = (num1, num2)\n\n    return closest_pair"}
