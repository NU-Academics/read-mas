s: List[float]) -> None:\n        self.numbers = list(numbers) # Defensive copy\n\n    def __iter__(self) -> Iterator[float]:\n        return iter(self.numbers)\n\n    def __len__(self) -> int:\n        return len(self.numbers)\n\n    def as_list(self) -> List[float]:\n        return list(self.numbers) # Return shallow copy\nclass InputValidator:\n    \"\"\"Validates and coerces incoming iterables into a NumberList.\n    Handles type checking and optional string to float conversion.\"\"\"\n    def validate(self, numbers: Iterable[Any], allow_str_coercion: bool = True) -> NumberList:\n        if numbers is None:\n            raise InvalidInputError(\"numbers cannot be None\")\n        \n        if not isinstance(numbers, Iterable):\n             raise InvalidInputError(\"numbers must be an iterable\")\n\n        out: List[float] = []\n        for i, v in enumerate(numbers):\n            try:\n                if isinstance(v, str) and not allow_str_coercion:\n                    raise ValueError(\"string coercion not allowed for this element\")\n                \n                out.append(self._coerce_to_number(v))\n            except (ValueError, TypeError) as e:\n                raise InvalidInputError(f\"element at index {i} is not numeric: {v!r} (Error: {e})\")\n        return NumberList(out)\n\n    def _coerce_to_number(self, value: Any) -> float:\n        \"\"\"Converts a value to float if it's an int, float, or numeric string.\"\"\"\n        if isinstance(value, (int, float)):\n            return float(value)\n        if isinstance(value, str):\n            try:\n                return float(value.strip())\n            except ValueError:\n                raise ValueError(\"string is not a valid number format\")\n        raise ValueError(\"value cannot be coerced to a number\")\nclass SumNegativeService:\n    \"\"\"Provides the core business logic to sum negative numbers.\"\"\"\n    def sum_negative(self, number_list: NumberList) -> float:\n        total: float