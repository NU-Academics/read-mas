ches) == 2:\n                    return (collected_matches[0], collected_matches[1])\n        \n        # Per the prompt's constraints (\"DO NOT raise exceptions for edge cases\" and\n        # `Tuple[str, str]` return type), this code path implies that the input\n        # is guaranteed to provide at least two matching words, ensuring the function\n        # always returns from within the loop.\ndef start_withp(words: List[str]) -> Tuple[str, str]:\n    \"\"\"\n    Returns two words from a list of words starting with letter 'p' (case-insensitive).\n    Assumes input always contains at least two such words.\n    \"\"\"\n    tokenizer = WordTokenizer()\n    normalizer = StringNormalizer()\n    svc = StartWithPService(tokenizer, normalizer)\n    return svc.start_withp(words)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[["python Programming", "Java Programming", "perl Programming", "Ruby Programming", "PHP Programming", "C Programming"]]]}], "Mbpp/306": [{"task_id": "Mbpp/306", "solution": "from typing import List\ndef max_sum_increasing_subseq(arr: List[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from arr[0...i]\n    that includes arr[k], where elements from arr[0...i] are strictly\n    less than arr[k] to form the increasing sequence.\n    \"\"\"\n    # msis_sums[j] stores the maximum sum of an increasing subsequence\n    # ending at arr[j] within the prefix arr[0...i].\n    msis_sums = [arr[j] for j in range(i + 1)]\n\n    # Compute MSIS for the prefix arr[0...i] using dynamic programming.\n    for j in range(i + 1):\n        for p in range(j):\n            if arr[p] < arr[j]:\n                msis_sums[j] = max(msis_sums[j], msis_sums[p] + arr[j])\n\n    target_k_value = arr[k]\n    max_prefix_sum_less_than_k = 0\n\n    # Find the maximum MSIS sum from the prefix arr[0...i]\n    # where the last element of that subsequence is strictly less than arr[k].\n    