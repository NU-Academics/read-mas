e sum of parts using floor division\n        sum_parts = (\n            _get_max_sum_memoized(current_n // 2) +\n            _get_max_sum_memoized(current_n // 3) +\n            _get_max_sum_memoized(current_n // 4) +\n            _get_max_sum_memoized(current_n // 5)\n        )\n\n        # Return the maximum of the sum of parts or n itself\n        return max(sum_parts, current_n)\n    \n    return _get_max_sum_memoized(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/441": [{"task_id": "Mbpp/441", "solution": "def surfacearea_cube(size: float) -> float:\n    \"\"\"Calculate the surface area of a cube given its side length.\"\"\"\n    return 6 * size * size", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/445": [{"task_id": "Mbpp/445", "solution": "def index_multiplication(left_tuple, right_tuple):\n    \"\"\"\n    Performs index-wise multiplication of tuple elements in two given tuples.\n    Assumes inputs are tuples of tuples, where each inner tuple contains two integers.\n    \"\"\"\n    return tuple(\n        (inner_left[0] * inner_right[0], inner_left[1] * inner_right[1])\n        for inner_left, inner_right in zip(left_tuple, right_tuple)\n    )", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/440": [{"task_id": "Mbpp/440", "solution": "import re\nfrom dataclasses import dataclass\nfrom typing import List, Tuple, Set, Optional\nADVERB_SUFFIXES: List[str] = ['ly']\nADVERB_EXCEPTIONS: Set[str] = {'very', 'too', 'quite', 'almost', 'always', 'never', 'often', 'well', 'rather', 'just', 'soon', 'already'}\nWORD_RE: str = r\"[A-Za-z']+\"\nDEFAULT_NOT_FOUND: Tuple[int, int, str] = (-1, -1, '')\nclass AdverbNotFoundError(Exception):\n    \"\"\"Exception raised when no adverb is found in the input text.\"\"\"\n    def __init__(self, message: str = \"No adverb found\") -> None:\n        super().__init__(message)\n        self.message = message\nclass TextTokenizer:\n    \"\"\"Utility for tokenizing text and normalizing tokens.\"\"\"\n    def tokenize_with_indices(self, text: str) -> List[Token]:\n        matches = re.finditer(WORD_RE, text)\n        tokens = []\n        for m in matches:\n            raw = text[m.start():m.end()]\n            norm = self.normalize_token(raw)\n            tokens.append(Token(start=m.start(), end=m.end(), text=raw, norm=norm))\n        return tokens\n\n    def normalize_token(self, token_text: str) -> str:\n        \"\"\"Lowercases the token text and strips surrounding punctuation.\"\"\"\n        return token_text.strip(\".,!?;:\\\"()[]\").lower()\nclass AdverbFinder:\n    \"\"\"Core logic to find the first adverb based on defined rules.\"\"\"\n    def __init__(self, tokenizer: Optional[TextTokenizer] = None) -> None:\n        self._tokenizer = tokenizer or TextTokenizer()\n\n    def find_first_adverb(self, text: str) -> Tuple[int, int, str]:\n        \"\"\"Finds the first adverb in the given text and returns its position and normalized form.\"\"\"\n        if not isinstance(text, str):\n            raise TypeError(\"text must be a string\")\n        tokens = self._tokenizer.tokenize_with_indices(text)\n        for t in tokens:\n            if self._is_adverb(t):\n                return (t.start, t.end, t.norm)\n        raise AdverbNotFoundError(\"No adverb found\")\n\n    def _is_adverb(self, token: Token) -> bool:\n        \"\"\"Determines if a given token is an adverb based on suffix or exception list.\"\"\"\n        if any(token.norm.endswith(suf) for suf in ADVERB_SUFFIXES):\n            return True\n        if token.norm in ADVERB_EXCEPTIONS:\n            return True\n        return False\nclass AdverbController:\n    \"\"\"Provides the public API for finding adverbs, handling internal errors gracefully.\"\"\"\n    def __init__(self, finder: Optional[AdverbFinder] = None) -> None:\n        self._finder = finder or AdverbFinder()\n\n    def find_adverb_position(self, text: str) -> Tuple[int, int, str]:\n        \"\"\"Finds the first adverb and its position in the given text, returning a default on failure.\"\"\"\n        if not isinstance(text, str):\n            return DEFAULT_NOT_FOUND\n        try:\n            return self._finder.find_first_adverb(text)\n        except AdverbNotFoundError:\n            return DEFAULT_NOT_FOUND\n        except Exception: # Catch any other unexpected errors\n            return DEFAULT_NOT_FOUND\ndef find_adverb_position(sentence: str) -> Tuple[int, int, str]:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Returns (start_index, end_index, adverb_text) or (-1, -1, '') if not found.\n    \"\"\"\n    controller = AdverbController()\n    return controller.find_adverb_position(sentence)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/446": [{"task_id": "Mbpp/446", "solution": "from collections import Counter\ndef count_Occurrence(data_tuple: tuple, elements_list: list) -> int:\n    \"\"\"\n    Counts the total occurrences of all unique elements from elements_list within data_tuple.\n    Targets are deduplicated before counting.\n    \"\"\"\n    data_counts = Counter(data_tuple)\n    total_occurrence = 0\n    unique_targets = list(dict.fromkeys(elements_list))\n    for element in unique_targets:\n        total_occurrence += data_counts.get(element, 0)\n    return total_occurrence", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, 1, 1, 2, 2, 2, 3, 3, 3], [1, 1, 2, 2, 3, 3]]]}], "Mbpp/447": [{"task_id": "Mbpp/447", "solution": "def cube_nums(nums):\n    \"\"\"\n    Computes the cube of each element in the input list.\n    \"\"\"\n    return [x ** 3 for x in nums]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/448": [{"task_id": "Mbpp/448", "solution": "import threading\nfrom abc import ABC, abstractmethod\nfrom typing import Any, Dict, List, Optional\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input scenarios.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\ndef validate_non_negative_int(n: Any) -> int:\n    \"\"\"Validates if n is a non-negative integer, raising an error otherwise.\"\"\"\n    if not isinstance(n, int):\n        raise InvalidInputError(f\"n must be an int, got {type(n).__name__}\")\n    if n < 0:\n        raise InvalidInputError(\"n must be non-negative\")\n    return n\nclass PerrinRepository(ABC):\n    \"\"\"Abstract base class for Perrin number repositories.\"\"\"\n    @abstractmethod\n    def get(self, n: int) -> int:\n        pass\n\n    @abstractmethod\n    def generate_up_to(self, n: int) -> List[int]:\n        pass\nclass InMemoryPerrinRepository(PerrinRepository):\n    \"\"\"An in-memory repository for Perrin numbers with caching.\"\"\"\n    DEFAULT_CACHE_SIZE: int = 4096\n\n    def __init__(self, preset: Optional[Dict[int,int]] = None) -> None:\n        self._lock = threading.Lock()\n        self._cache: Dict[int,int] = preset.copy() if preset else {0:3, 1:0, 2:2}\n\n    def get(self, n: int) -> int:\n        if n < 0:\n            raise InvalidInputError(\"n must be non-negative\")\n        with self._lock:\n            if n in self._cache:\n                return self._cache[n]\n            self.generate_up_to(n)\n            return self._cache[n]\n\n    def generate_up_to(self, n: int) -> List[int]:\n        if n < 0:\n            raise InvalidInputError(\"n must be non-negative\")\n        with self._lock:\n            max_cached = max(self._cache.keys())\n            for i in range(max_cached + 1, n + 1):\n                val = self._cache[i-2] + self._cache[i-3]\n                self._cache[i] = val\n            return [self._cache[i] for i in range(0, n+1)]\nclass PerrinService:\n    \"\"\"Service layer for Perrin number business logic.\"\"\"\n    def __init__(self, repository: PerrinRepository) -> None:\n        self._repo = repository\n\n    def get(self, n: int) -> int:\n        n = validate_non_negative_int(n)\n        return self._repo.get(n)\n\n    def sum_up_to(self, n: int) -> int:\n        n = validate_non_negative_int(n)\n        seq = self._repo.generate_up_to(n)\n        return sum(seq)\ndef cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from index 0 to n inclusive.\n    It uses an in-memory repository for efficient caching.\n    \"\"\"\n    n = validate_non_negative_int(n)\n    repo = InMemoryPerrinRepository()\n    service = PerrinService(repo)\n    return service.sum_up_to(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[-5]]}], "Mbpp/450": [{"task_id": "Mbpp/450", "solution": "from typing import List\ndef extract_string(values: List[str], size: int) -> List[str]:\n    \"\"\"\n    Extracts strings of a specified size from a list of string values.\n    Filters the input list to include only strings matching the exact length.\n    \"\"\"\n    return [s for s in values if len(s) == size]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/435": [{"task_id": "Mbpp/435", "solution": "import logging\nfrom typing import List, Dict\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    def __init__(self, message: str, invalid_value: object) -> None:\n        super().__init__(message)\n        self.message = message\n        self.invalid_value = invalid_value\n    def __str__(self) -> str:\n        return f\"{self.message}: {self.invalid_value!r}\"\nclass LoggerAdapter:\n    \"\"\"A simple adapter for Python's logging module.\"\"\"\n    def __init__(self, name: str = \"lastdigit_app\") -> None:\n        self._logger = logging.getLogger(name)\n        self._logger.setLevel(logging.INFO)\n      