or pancake_sort function\n    config = Config.from_env()\n    service = PancakeSorterService()\n    repo = SortRepository(config.LOG_PATH)\n    controller = SortController(service, repo, config)\n\n    return controller.sort(items)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/239": [{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m, n):\n    \"\"\"\n    Calculates the number of possible sequences of length n,\n    such that each element is a positive integer and is greater than or equal to twice the previous element but less than or equal to m.\n    \"\"\"\n    memo = {}\n\n    def _count_from(current_element, remaining_length):\n        \"\"\"\n        Recursively counts sequences of `remaining_length` elements\n        starting with `current_element`.\n        \"\"\"\n        if (current_element, remaining_length) in memo:\n            return memo[(current_element, remaining_length)]\n\n        if remaining_length == 1:\n            return 1\n\n        count_for_path = 0\n        next_min_val = 2 * current_element\n\n        if next_min_val > m:\n            memo[(current_element, remaining_length)] = 0\n            return 0\n\n        for next_element_val in range(next_min_val, m + 1):\n            count_for_path += _count_from(next_element_val, remaining_length - 1)\n\n        memo[(current_element, remaining_length)] = count_for_path\n        return count_for_path\n\n    if n == 1:\n        return m\n\n    total_sequences = 0\n    # The first element can be any integer from 1 to m.\n    for first_element_val in range(1, m + 1):\n        total_sequences += _count_from(first_element_val, n)\n\n    return total_sequences", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/264": [{"task_id": "Mbpp/264", "solution": "def dog_age(years: int) -> int:\n    \"\"\"Calculates a dog's age in dog years using a linear formula.\"\"\"\n    dog_years