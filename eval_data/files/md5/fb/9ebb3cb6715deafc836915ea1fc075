alue = self.utils.dp_catalan(n)\n            else: # Default or explicit \"multiplicative\"\n                value = self.utils.multiplicative_catalan(n)\n        except ValueError as e:\n            raise CatalanError(f\"Computation error for n={n}: {e}\") from e\n        except Exception as e:\n            raise CatalanError(f\"An unexpected error occurred for n={n}: {e}\") from e\n        \n        self.repo.set(n, value)\n        return value\n\n    def compute_multiplicative(self, n: int) -> int:\n        \"\"\"Computes the nth Catalan number using the multiplicative formula.\"\"\"\n        return self.utils.multiplicative_catalan(n)\n\n    def compute_dp(self, n: int) -> int:\n        \"\"\"Computes the nth Catalan number using dynamic programming.\"\"\"\n        return self.utils.dp_catalan(n)\nclass ServiceFactory:\n    @staticmethod\n    def create_service(config: Config | None = None) -> CatalanService:\n        \"\"\"Creates a CatalanService instance with its dependencies.\"\"\"\n        if config is None:\n            config = Config()\n\n        repo = CacheRepository()\n        utils = MathUtils()\n        service = CatalanService(repo=repo, utils=utils, algorithm=config.default_algorithm)\n        return service\n_default_service = ServiceFactory.create_service()\ndef catalan_number(n: int) -> int:\n    \"\"\"Returns the nth Catalan number.\"\"\"\n    return _default_service.compute(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/586": [{"task_id": "Mbpp/586", "solution": "def split_Arr(arr, n):\n    \"\"\"\n    Splits a list at the nth element and adds the first part to the end.\n    Negative indices are handled following Python's list slicing semantics.\n    \"\"\"\n    length = len(arr)\n\n    # Normalize negative index to a positive index\n    if n < 0:\n        n = length + n\n\n    # Perform the split and reorder using list slicing\n    # The part from index 'n' to the end comes first,\n  