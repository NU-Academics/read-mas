k = threading.Lock()\n        self._max_size = max_size\n\n    def get(self, key: int) -> Optional[int]:\n        with self._lock:\n            if key in self._store:\n                value = self._store.pop(key)\n                self._store[key] = value\n                return value\n            return None\n\n    def set(self, key: int, value: int) -> None:\n        with self._lock:\n            if key in self._store:\n                self._store.pop(key)\n            elif len(self._store) >= self._max_size:\n                oldest_key = next(iter(self._store))\n                del self._store[oldest_key]\n            self._store[key] = value\n\n    def clear(self) -> None:\n        with self._lock:\n            self._store.clear()\nclass LucasRepository:\n    \"\"\"Abstract interface for a Lucas number repository/cache.\"\"\"\n    def get(self, n: int) -> Optional[int]:\n        raise NotImplementedError\n\n    def set(self, n: int, value: int) -> None:\n        raise NotImplementedError\nclass InMemoryRepository(LucasRepository):\n    \"\"\"An in-memory repository using MemoCache.\"\"\"\n    def __init__(self, cache: Optional[MemoCache] = None) -> None:\n        self._cache = cache or MemoCache()\n\n    def get(self, n: int) -> Optional[int]:\n        return self._cache.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        self._cache.set(n, value)\ndef fast_doubling(n: int) -> Tuple[int, int]:\n    \"\"\"Computes (F(n), F(n+1)) for Fibonacci sequence using fast doubling.\"\"\"\n    if n == 0:\n        return (0, 1)\n    \n    a, b = fast_doubling(n >> 1)\n    f_2k = a * (2 * b - a)\n    f_2k_plus_1 = a * a + b * b\n    \n    if n & 1:\n        return (f_2k_plus_1, f_2k + f_2k_plus_1)\n    else:\n        return (f_2k, f_2k_plus_1)\nclass LucasService:\n    \"\"\"Provides core business logic for Lucas number computation.\"\"\"\n    L0: int = 2\n    L1: int = 1\n\n    def __init__(self, repository: Optional[LucasRepository] = None) -> None:\n        self.repository = repository or InMemoryRepository(MemoCache())\n\n    def find_lucas(self, n: int, method: str = \"iterative\") -> int:\n        \"\"\"Finds the n'th Lucas number using the specified method.\"\"\"\n        n = validate_n(n)\n        \n        cached = self.repository.get(n)\n        if cached is not None:\n            return cached\n        \n        if method == \"iterative\":\n            result = self._compute_iterative(n)\n        elif method == \"fast\":\n            result = self._compute_fast(n)\n        else:\n            raise ValueError(f\"Unsupported method: {method}. Choose 'iterative' or 'fast'.\")\n        \n        self.repository.set(n, result)\n        return result\n\n    def _compute_iterative(self, n: int) -> int:\n        \"\"\"Computes the n'th Lucas number iteratively (O(n)).\"\"\"\n        if n == 0:\n            return self.L0\n        if n == 1:\n            return self.L1\n        \n        a, b = self.L0, self.L1\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b\n\n    def _compute_fast(self, n: int) -> int:\n        \"\"\"Computes the n'th Lucas number using fast doubling (O(log n)).\"\"\"\n        if n == 0:\n            return self.L0\n        if n == 1:\n            return self.L1\n        \n        # L(n) = 2*F(n+1) - F(n) for n >= 0\n        Fn, Fnp1 = fast_doubling(n) # Fn = F(n), Fnp1 = F(n+1)\n        return 2 * Fnp1 - Fn\n_default_lucas_service = LucasService()\ndef find_lucas(n: int) -> int:\n    \"\"\"Computes the n'th Lucas number.\n    Delegates to a LucasService instance, using an iterative algorithm by default.\n    \"\"\"\n    return _default_lucas_service.find_lucas(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[true]]}], "Mbpp/395": [{"task_id": "Mbpp/395", "solution": "from typing import Optional\ndef first_non_repeating_character(s: str) -> Optional[str]:\n    \"\"\"Finds the first non-repeated character in a string.\n    Re