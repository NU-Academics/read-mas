quence[Any]) -> int:\n    \"\"\"\n    Returns the number of integer elements in a given list.\n    Only exact 'int' types (excluding 'bool') are counted.\n    \"\"\"\n    facade = APIFacade()\n    return facade.count_integer(items)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/247": [{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Finds the length of the longest palindromic subsequence using dynamic programming.\n    This implementation uses O(n^2) time complexity and O(n) space complexity.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 0\n\n    # Compute LCS (Longest Common Subsequence) of s and its reverse.\n    # This is equivalent to finding the LPS of s.\n    rev_s = s[::-1]\n\n    # prev stores the DP values for the previous row (i-1)\n    # curr stores the DP values for the current row (i)\n    prev = [0] * (n + 1)\n    curr = [0] * (n + 1)\n\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            if s[i - 1] == rev_s[j - 1]:\n                curr[j] = prev[j - 1] + 1\n            else:\n                curr[j] = max(prev[j], curr[j - 1])\n        # After completing a row, the current row becomes the previous row for the next iteration.\n        prev = list(curr) # Create a copy to avoid modification issues\n        # No need to reset curr, it will be overwritten in the next iteration\n\n    return prev[n]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/98": [{"task_id": "Mbpp/98", "solution": "import os\nimport json\nimport threading\nimport logging\nfrom datetime import datetime\nfrom typing import Iterable, Any, List, Dict, Optional\ndef multiply_num(seq):\n    class InvalidInputError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class CalculationError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    def _multiply_iterable(values: Iterable[float]) -> float:\n        acc = 1.0\n        for v in values:\n            acc *= float(v)\n        return acc\n\n    def _safe_divide(numerator: float, divisor: int) -> float:\n        if divisor == 0:\n            raise CalculationError(\"Division by zero\")\n        return numerator / float(divisor)\n\n    class NumberSequence:\n        def __init__(self, values: List[float]) -> None:\n            self.values: List[float] = values\n        def length(self) -> int:\n            return len(self.values)\n\n    class MultiplyResult(NumberSequence):\n        def __init__(self, result: float, input_seq: List[float], timestamp: str) -> None:\n            super().__init__(input_seq)\n            self.result: float = result\n            self.timestamp: str = timestamp\n\n    class InputValidator:\n        def __init__(self) -> None:\n            self.allowed_types = (int, float)\n        def is_number(self, v: Any) -> bool:\n            return isinstance(v, self.allowed_types) and not isinstance(v, bool)\n        def validate_and_normalize(self, seq: Iterable[Any]) -> List[float]:\n            try:\n                iterator = list(seq)\n            except TypeError:\n                raise InvalidInputError(\"Input is not iterable\")\n            if len(iterator) == 0:\n                raise InvalidInputError(\"Empty sequence is not allowed\")\n            out: List[float] = []\n            for i, v in enumerate(iterator):\n                if not self.is_number(v):\n                    raise InvalidInputError(f\"Element at index {i} is not numeric: {v}\")\n                out.append(float(v))\n            return out\n\n    _DEFAULT_HISTORY_PATH = os.environ.get(\"NUMOPS_HISTORY_PATH\") or os.path.expanduser(\"~/.numops_history.json\")\n\n    class NumberRepository:\n        def __init__(self, path: Optional[str]=None) -> None:\n            self._path = path or _DEFAULT_HISTORY_PATH\n            self._lock = threading.Lock()\n        def append(self, record: Dict) -> None:\n            \"\"\"Appends a record to the JSON history file, ensuring atomic write.\"\"\"\n            try:\n                with self._lock:\n                    data = []\n                    if os.path.exists(self._path):\n                        with open(self._path, \"r\", encoding=\"utf-8\") as f:\n                            data = json.load(f) or []\n                    data.append(record)\n                    tmp = f\"{self._path}.tmp\"\n                    with open(tmp, \"w\", encoding=\"utf-8\") as f:\n                        json.dump(data, f, ensure_ascii=False, indent=2)\n                    os.replace(tmp, self._path)\n            except Exception:\n                logging.getLogger(__name__).warning(\"Failed to persist history; continuing without blocking.\")\n        def read_all(self) -> List[Dict]:\n            \"\"\"Reads all records from the JSON history file.\"\"\"\n            if not os.path.exists(self._path):\n                return []\n            with open(self._path, \"r\", encoding=\"utf-8\") as f:\n                return json.load(f)\n\n    class CalculatorService:\n        def __init__(self, repo: NumberRepository, validator: InputValidator) -> None:\n            self._repo = repo\n            self._validator = validator\n\n        def compute_average_product(self, seq: Iterable) -> float:\n            values = self._validator.validate_and_normalize(seq)\n            product = _multiply_iterable(values)\n            result = _safe_divide(product, len(values))\n            return result\n\n        def compute_and_record(self, seq: Iterable) -> MultiplyResult:\n            \"\"\"Validates input, computes product-average, records to history, and returns MultiplyResult.\"\"\"\n            values = self._validator.validate_and_normalize(seq)\n            product = _multiply_iterable(values)\n            result = _safe_divide(product, len(values))\n            timestamp = datetime.utcnow().isoformat(timespec='milliseconds') + \"Z\"\n            rec = {\"timestamp\": timestamp, \"input\": values, \"result\": result}\n            self._repo.append(rec)\n            return MultiplyResult(result=result, input_seq=values, timestamp=timestamp)\n\n    class MultiplyController:\n        def __init__(self, service: CalculatorService) -> None:\n            self._service = service\n        def multiply_num(self, seq: Iterable) -> float:\n            \"\"\"Computes the average product of a sequence and records it, returning only the float result.\"\"\"\n            result_obj = self._service.compute_and_record(seq)\n            return result_obj.result\n        def multiply_num_with_record(self, seq: Iterable) -> MultiplyResult:\n            return self._service.compute_and_record(seq)\n\n    _default_repo = NumberRepository()\n    _default_validator = InputValidator()\n    _default_service = CalculatorService(_default_repo, _default_validator)\n    default_controller = MultiplyController(_default_service)\n\n    return default_controller.multiply_num(seq)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/141": [{"task_id": "Mbpp/141", "solution": "def pancake_sort(items: list) -> list:\n    \"\"\"Sorts a list of elements using the pancake sort algorithm.\n    This implementation adheres to the design document, including logging and validation.\n    \"\"\"\n    import json\n    import time\n    import sys\n    from pathlib import Path\n    from datetime import datetime, timezone\n    from typing import List, Any, Dict, TypeVar\n\n    T = TypeVar(\"T\")\n\n    class Config:\n        \"\"\"Configuration for the pancake sorter, including log path and persistence settings.\"\"\"\n        LOG_PATH: str = \"./data/sort_log.jsonl\"\n        PERSISTENCE_ENABLED: bool = True\n\n        @staticmethod\n        def from_env() -> \"Config\":\n            \"\"\"Creates a Config instance, currently returning defaults without environment variable parsing.\"\"\"\n            return Config()\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid input to the sorting functions.\"\"\"\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(message)\n\n    class SortResult:\n        \"\"\"Data model representing a single sort operation for logging.\"\"\"\n        def __init__(self, input_list: List[Any], output_list: List[Any], duration_ms: float, timestamp: str):\n            self.input_list = input_list\n            self.output_list = output_list\n            self.duration_ms = duration_ms\n            self.timestamp = timestamp\n\n        def to_dict(self) -> Dict[str, Any]:\n            \"\"\"Converts the SortResult object to a dictionary for JSON serialization.\"\"\"\n            return {\n                \"input\": self.input_list,\n                \"output\": self.output_list,\n                \"duration_ms\": self.duration_ms,\n                \"timestamp\": self.timestamp,\n                \"status\": \"ok\"\n            }\n\n    class ValidationUtils:\n        \"\"\"Utility class for validating input lists and their elements.\"\"\"\n        @staticmethod\n        def is_list(obj: Any) -> bool:\n            \"\"\"Checks if the given object is an instance of a list.\"\"\"\n            return isinstance(obj, list)\n\n        @staticmethod\n        def elements_comparable(lst: List[Any]) -> bool:\n            \"\"\"Checks if all elements in the list can be compared to each other.\"\"\"\n            if len(lst) < 2:\n                return True\n            try:\n                sorted(list(lst))\n                return True\n            except Exception:\n                return False\n\n    class TimingUtils:\n        \"\"\"Utility class for generating timestamps and calculating durations.\"\"\"\