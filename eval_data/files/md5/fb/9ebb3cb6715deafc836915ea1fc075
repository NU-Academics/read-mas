 s = normalize_input(value)\n        except Exception as e:\n            return DecimalCheckResult(False, None, f\"Cannot normalize input: {e}\")\n\n        is_valid = self.validator.validate(s)\n        if is_valid:\n            return DecimalCheckResult(True, s, None)\n        return DecimalCheckResult(False, None, \"Value does not match decimal precision=2\")\n\n    def is_valid(self, value: Any) -> bool:\n        \"\"\"Convenience method to check if the value is a valid decimal.\"\"\"\n        return self.validate(value).is_valid\n_default_service = DecimalService()\ndef is_decimal(value: str) -> bool:\n    \"\"\"Checks if a string is a decimal number with a precision of 2.\"\"\"\n    return _default_service.is_valid(value)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["-123.11"]]}], "Mbpp/762": [{"task_id": "Mbpp/762", "solution": "class MonthValidationError(Exception):\n    \"\"\"Exception raised for invalid month input.\n    Contains a message and an optional exit code.\"\"\"\n    def __init__(self, message: str, code: int = 2) -> None:\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\n    def __str__(self) -> str:\n        return self.message\nclass MonthModel:\n    \"\"\"Immutable data model representing a month.\n    Stores the month number and the count of its days.\"\"\"\n    def __init__(self, number: int, days: int) -> None:\n        self.number: int = number\n        self.days: int = days\n\n    def __repr__(self) -> str:\n        return f\"MonthModel(number={self.number}, days={self.days})\"\nDEFAULT_MONTHS = {1:31,2:28,3:31,4:30,5:31,6:30,7:31,8:31,9:30,10:31,11:30,12:31}\nclass MonthRepository:\n    \"\"\"Provides in-memory lookup of month metadata.\n    Maps month numbers to their corresponding days.\"\"\"\n    def __init__(self, months: dict[int,int] | None = None) -> None:\n        self._months = dict(months or DEFAULT_MONTHS)\n\n    def get_by_number(sel