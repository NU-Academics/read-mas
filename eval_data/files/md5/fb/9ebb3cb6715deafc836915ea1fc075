\"Inputs must be sequences\", field=\"inputs\")\n        if len(a) != len(b):\n            raise ValidationError(\"Input lengths must match\", field=\"length\")\n        for idx, (x, y) in enumerate(zip(a, b)):\n            if not self._is_number(x):\n                raise ValidationError(f\"Non-numeric value at index {idx} in a\", field=\"a\")\n            if not self._is_number(y):\n                raise ValidationError(f\"Non-numeric value at index {idx} in b\", field=\"b\")\n        return ListPair(list(a), list(b))\n\n    def _is_number(self, obj: Any) -> bool:\n        \"\"\"Checks if an object is an allowed numeric type.\"\"\"\n        return isinstance(obj, self.ALLOWED_NUMBER_TYPES)\nclass ListMathService:\n    \"\"\"Performs element-wise division of a ListPair.\"\"\"\n    def __init__(self, repo=None) -> None:\n        # The design includes an optional repo, omitted for this self-contained response.\n        pass\n\n    def div_list(self, pair: ListPair) -> DivisionResult:\n        \"\"\"Computes element-wise division of numbers in a ListPair.\"\"\"\n        res = []\n        for i, (x, y) in enumerate(zip(pair.a, pair.b)):\n            if y == 0:\n                raise DivisionError(f\"Division by zero at index {i}\")\n            res.append(float(x) / float(y))\n        return DivisionResult(res)\nclass DivisionController:\n    \"\"\"Orchestrates validation and mathematical service execution.\"\"\"\n    def __init__(self, validator: ListValidator, service: ListMathService) -> None:\n        self.validator = validator\n        self.service = service\n\n    def divide_raw(self, a: Sequence[Any], b: Sequence[Any]) -> DivisionResult:\n        \"\"\"Validates inputs and performs element-wise division.\"\"\"\n        validated_pair = self.validator.validate(a, b)\n        division_result = self.service.div_list(validated_pair)\n        return division_result\n_validator = ListValidator()\n_service = ListMathService()\n_controller = DivisionController(_validator, _service)\ndef div_list(a, b):\n    \"\"\"\n    Divides two lists element-wise.\n    Raises ValidationError for invalid inputs or DivisionError for division by zero.\n    \"\"\"\n    result = _controller.divide_raw(a, b)\n    return result.result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/622": [{"task_id": "Mbpp/622", "solution": "def get_median(list1: list, list2: list, n: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size using a divide-and-conquer approach.\n    The `n` parameter represents the current effective size of the sub-lists in recursion.\n    \"\"\"\n    if n == 1:\n        return (list1[0] + list2[0]) / 2.0\n    if n == 2:\n        return (max(list1[0], list2[0]) + min(list1[1], list2[1])) / 2.0\n\n    m = n // 2\n\n    if n % 2 == 1:\n        ma = list1[m]\n        mb = list2[m]\n    else:\n        ma = (list1[m-1] + list1[m]) / 2.0\n        mb = (list2[m-1] + list2[m]) / 2.0\n\n    if ma == mb:\n        return float(ma)\n    \n    if ma < mb:\n        if n % 2 == 0:\n            return get_median(list1[m:], list2[:m], n - m)\n        else:\n            return get_median(list1[m:], list2[:m+1], n - m)\n    else: # ma > mb\n        if n % 2 == 0:\n            return get_median(list1[:m], list2[m:], n - m)\n        else:\n            return get_median(list1[:m+1], list2[m:], n - m)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[5, 6, 6, 7], [3, 4, 7, 7], 4]]}], "Mbpp/623": [{"task_id": "Mbpp/623", "solution": "def nth_nums(nums, n):\n    \"\"\"\n    Computes the n-th power of each number in a list.\n    \"\"\"\n    return [float(x ** n) for x in nums]", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[-100, -50, 0, 10, 77, 50, 100, -100], 77]]}], "Mbpp/626": [{"task_id": "Mbpp/626", "solution": "def triangle_area(radius):\n    \"\"\"\n    Calculates the area of the largest triangle inscribed in a semicircle.\n    Returns None if the radius is negative, otherwise returns radius squared.\n    \"\"\"\n    if radius < 0:\n        return None\n    return float(radius * radius)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[999999999]]}], "Mbpp/624": [{"task_id": "Mbpp/624", "solution": "def is_upper(s: str) -> str:\n    \"\"\"Converts a given string to its uppercase equivalent.\"\"\"\n    return s.upper()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/628": [{"task_id": "Mbpp/628", "solution": "def replace_spaces(text):\n    \"\"\"\n    Replaces all space characters in the given string with '%20'.\n    \"\"\"\n    return text.replace(\" \", \"%20\")", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/629": [{"task_id": "Mbpp/629", "solution": "import os\nimport json\nimport datetime\nimport sys\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input.\"\"\"\n    def __init__(self, message: str, details: dict = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.details = details if details is not None else {}\n\n    def __str__(self) -> str:\n        if self.details:\n            return f\"{self.message} Details: {self.details}\"\n        return self.message\nclass EvenFinderService:\n    \"\"\"Core logic to find even numbers from a list.\"\"\"\n    def find_evens(self, numbers: list[int]) -> list[int]:\n        \"\"\"Returns a new list containing only even numbers.\"\"\"\n        return [n for n in numbers if n % 2 == 0]\nclass ListValidator:\n    \"\"\"Validates and normalizes raw input into a list of integers.\"\"\"\n    def validate(self, raw: any) -> list[int]:\n        \"\"\"Parses and validates various input types into a list of integers.\"\"\"\n        if isinstance(raw, str):\n            try:\n                parsed = json.loads(raw)\n                if isinstance(parsed, list):\n                    raw = parsed\n                else:\n                    raw = [x.strip() for x in raw.split(\",\") if x.strip() != \"\"]\n            except json.JSONDecodeError:\n                raw = [x.strip() for x in raw.split(\",\") if x.strip() != \"\"]\n        \n        if not hasattr(raw, '__iter__'):\n            raise InvalidInputError(\"Input is not iterable.\")\n\n        try:\n            validated_list = []\n            for item in raw:\n                validated_list.append(self._coerce_value(item))\n            return validated_list\n        except InvalidInputError as e:\n            raise e\n        except Exception as e:\n            raise InvalidInputError(f\"Error processing input elements: {e}\")\n\n    def _coerce_value(self, value: any) -> int:\n        \"\"\"Attempts to safely coerce a value to an integer.\"\"\"\n        try:\n            if isinstance(value, float):\n                if not value.is_integer():\n                    raise InvalidInputError(f\"Non-integer float found: {value}\")\n            return int(value)\n        except (ValueError, TypeError):\n            raise InvalidInputError(f\"Invalid element for integer conversion: '{value}' (type: {type(value).__name__})\")\nclass EvenRepository:\n    \"\"\"Handles optional audit logging to a JSON-lines file.\"\"\"\n    def __init__(self, audit_path: str = None) -> None:\n        self.audit_path = audit_path\n\n    def append_audit(self, input_numbers: list[int], output_numbers: list[int]) -> None:\n        \"\"\"Appends audit data to the configured audit file.\"\"\"\n        if not self.audit_path:\n            return\n\n        try:\n            timestamp = datetime.datetime.now(datetime.timezone.utc).isoformat()\n            audit_entry = {\n                \"timestamp\": timestamp,\n                \"input\": input_numbers,\n                \"output\": output_numbers\n            }\n            # Ensure directory exists\n            os.makedirs(os.path.dirname(self.audit_path), exist_ok=True)\n            with open(self.audit_path, 'a') as f:\n                f.write(json.dumps(audit_entry) + '\\n')\n        except Exception as e:\n            print(f\"Warning: Failed to write audit log to {self.audit_path}. Error: {e}\", file=sys.stderr)\nclass SplitController:\n    \"\"\"Orchestrates validation, even number finding, and optional auditing.\"\"\"\n    def __init__(self, validator: ListValidator, service: EvenFinderService, repo: EvenRepository = None) -> None:\n        self.validator = validator\n        self.service = service\n        self.repo = repo\n\n    def split(self, raw_numbers: any) -> list[int]:\n        \"\"\"Validates input, finds even numbers, and optionally logs.\"\"\"\n        validated_numbers = self.validator.validate(raw_numbers)\n        even_numbers = self.service.find_evens(validated_numbers)\n        if self.repo:\n            self.repo.append_audit(validated_numbers, even_numbers)\n        return even_numbers\ndef Split(numbers: any) -> list[int]:\n    \"\"\"\n    Finds even numbers from a list of numbers.\n    Accepts various input types including lists, tuples, CSV strings, or JSON arrays.\n    \"\"\"\n    validator = ListValidator()\n    service = EvenFinderService()\n    audit_path = os.getenv(\"EVEN_FINDER_AUDIT_PATH\", None)\n    repo = EvenRepository(audit_path) if audit_path else None\n    controller = SplitController(validator=validator, service=service, repo=repo)\n    return controller.split(numbers)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/631": [{"task_id": "Mbpp/631", "solution": "import re\ndef replace_spaces(text: str) -> str:\n    \"\"\"\n    Replaces whitespaces with underscores or vice versa based on input content.\n    If both spaces and underscores are present, spaces are converted to underscores.\n    \"\"\"\n    has_space = bool(re.search(r\"\\s\", text))\n    has_underscore = \"_\" in text\n\n    if has_space and not has_underscore:\n        # Convert one or more whitespace characters to a single underscore\n        return re.sub(r\"\\s+\", \"_\", text)\n    elif has_underscore and not has_space:\n        # Convert all underscores to single spaces\n        return text.replace(\"_\", \" \")\n    elif has_space and has_underscore:\n        # If both are present, prioritize converting spaces to underscores.\n        return re.sub(r\"\\s+\", \"_\", text)\n    else:\n        # If neither spaces nor underscores are present, return the original text.\n        return text", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["  Jumanji The Jungle  "]]}], "Mbpp/633": [{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(nums, n):\n    \"\"\"\n    Calculates the sum of XORs of all unique pairs of numbers in the list using a bit-wise approach.\n    The parameter 'n' is typically the length of 'nums' and is used for consistency with the prompt.\n    \"\"\"\n    if not nums:\n        return 0\n\n    # Determine the maximum number of bits needed to represent any number in the list.\n    # Use 32 as a default minimum bit length for common integer sizes.\n    max_val = max(nums)\n    max_bits = max(max_val.bit_length(), 32)\n\n    total_xor_sum = 0\n    list_length = len(nums)\n\n    # Iterate through each bit position from 0 up to max_bits - 1.\n    for b in range(max_bits):\n        # Create a mask to check the b-th bit.\n        mask = 1 << b\n        \n        # Count how many numbers in the list have the b-th bit set (1).\n        count_set_bit = sum(1 for x in nums if (x & mask))\n        \n        # Count how many numbers have the b-th bit unset (0).\n        count_unset_bit = list_length - count_set_bit\n        \n        # The contribution of the b-th bit to the total XOR sum is\n        # (count of numbers with bit 0) * (count of numbers with bit 1) * (2^b).\n        # This is becau