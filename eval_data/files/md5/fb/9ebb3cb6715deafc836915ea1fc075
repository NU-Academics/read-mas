f the outer iterable must itself be iterable\") from e\n        except TypeError as e:\n            raise FrequencyError(\"Input must be an iterable of iterables\") from e\nclass FrequencyService:\n    \"\"\"Provides core logic for counting element frequencies.\"\"\"\n    def count_frequencies(self, data, sort_keys=True):\n        \"\"\"Flattens a list of lists and counts element frequencies.\"\"\"\n        flattener = ListFlattener()\n        counts = {}\n        \n        try:\n            for item in flattener.flatten(data):\n                if not is_hashable(item):\n                    raise FrequencyError(f\"Unhashable element: {item!r}\")\n                counts[item] = counts.get(item, 0) + 1\n        except FrequencyError:\n            raise # Re-raise exceptions originating from the flattener\n\n        if sort_keys:\n            return {k: counts[k] for k in sorted(counts)}\n        return counts\ndef frequency_lists(data, sort_keys=True):\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists.\n    Returns the frequencies in a dictionary, sorted by key by default.\n    \"\"\"\n    service = FrequencyService()\n    return service.count_frequencies(data, sort_keys=sort_keys)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/102": [{"task_id": "Mbpp/102", "solution": "def snake_to_camel(s: str) -> str:\n    \"\"\"Converts a snake_case string to CamelCase (PascalCase) by splitting on underscores, capitalizing each word, and joining them.\n    Empty strings, or strings consisting only of underscores, result in an empty string.\"\"\"\n    if not s:\n        return \"\"\n\n    tokens = [token for token in s.split(\"_\") if token]\n    camel_case_string = \"\".join(token[:1].upper() + token[1:].lower() for token in tokens)\n\n    return camel_case_string", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["___python_program"]]}], "Mbpp/103": [{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Computes the Eulerian number A(n, m) using dynamic programming.\n    A(n,m) is the number of permutations of {1, ..., n} with m ascents.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # dp_prev_values stores A(k-1, j) for the current iteration k.\n    # It is initialized to A(0,0)=1, with other A(0,j) being 0.\n    dp_prev_values = [1]\n\n    for k_val in range(1, n + 1):\n        # dp_curr_values will store A(k_val, j). It needs k_val+1 elements for j from 0 to k_val.\n        dp_curr_values = [0] * (k_val + 1)\n\n        for j_val in range(k_val):\n            # Recurrence: A(k,j) = (k - j) * A(k-1, j-1) + (j + 1) * A(k-1, j)\n            \n            # A(k_val-1, j_val-1): value from previous row, at index j_val-1.\n            # It's 0 if j_val-1 is out of bounds (i.e., j_val == 0).\n            term1 = dp_prev_values[j_val - 1] if j_val > 0 else 0\n\n            # A(k_val-1, j_val): value from previous row, at index j_val.\n            # It's 0 if j_val is out of bounds for dp_prev_values (i.e., j_val >= k_val).\n            term2 = dp_prev_values[j_val] if j_val < len(dp_prev_values) else 0\n\n            dp_curr_values[j_val] = (k_val - j_val) * term1 + (j_val + 1) * term2\n        \n        # The current row becomes the previous row for the next iteration.\n        dp_prev_values = dp_curr_values\n\n    # After iterating up to n, dp_prev_values contains A(n, j) for j from 0 to n-1.\n    return dp_prev_values[m]", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[0, 0]]}], "Mbpp/100": [{"task_id": "Mbpp/100", "solution": "import time\nfrom dataclasses import dataclass, asdict\nfrom typing import Any, List, Optional\nclass InputValidationError(ValueError):\n    \"\"\"Custom exception for invalid input validation.\"\"\"\n    pass\nMAX_DIGITS: Optional[int] = None\nclass MathUtils:\n    \"\"\"Utility class for mathematical operations on digits and strings.\"\"\"\n    @staticmethod\n    def is_palindrome_str(s: str) -> bool:\n        \"\"\"Checks if a string is a palindrome.\"\"\"\n        return s == s[::-1]\n\n    @staticmethod\n    def mirror_left_to_right(s: List[str]) -> List[str]:\n        \"\"\"Mirrors the left half of a list of characters to its right half to form a palindrome.\"\"\"\n        n = len(s)\n        mid = n // 2\n        for i in range(mid):\n            s[n - 1 - i] = s[i]\n        return s\n\n    @staticmethod\n    def compare_strings_num(a: List[str], b: List[str]) -> int:\n        \"\"\"Compares two equal-length digit lists numerically. Returns -1 if a<b, 0 if a==b, 1 if a>b.\"\"\"\n        sa = ''.join(a)\n        sb = ''.join(b)\n        if sa == sb: return 0\n        return 1 if sa > sb else -1\nclass InputValidator:\n    \"\"\"Validates and sanitizes integer inputs.\"\"\"\n    def __init__(self, max_digits: Optional[int] = None):\n        self.max_digits = max_digits\n\n    def validate_int(self, value: Any) -> int:\n        \"\"\"Converts input to an integer, raising an error for invalid formats or exceeding digit limits.\"\"\"\n        if isinstance(value, int):\n            n = value\n        else:\n            try:\n                s = str(value).strip()\n                if s == \"\":\n                    raise InputValidationError(\"Empty input\")\n                if \".\" in s:\n                    raise InputValidationError(\"Input contains decimal point, not an integer\")\n                n = int(s)\n            except ValueError:\n                raise InputValidationError(f\"Cannot parse integer from {value!r}\")\n        \n        if self.max_digits is not None and len(str(abs(n))) > self.max_digits:\n            raise InputValidationError(f\"Input {n} exceeds maximum allowed digits of {self.max_digits}\")\n        return n\nclass PalindromeService:\n    \"\"\"Core service for computing the next smallest palindrome.\"\"\"\n    def __init__(self, repo=None):\n        self.repo = repo # Not used in this function but part of the design context.\n\n    def next_palindrome(self, n: int) -> PalindromeResult:\n        \"\"\"Computes the next smallest palindrome strictly greater than n.\"\"\"\n        start = time.time()\n        \n        if n < 0:\n            candidate = 0\n        elif n == 0:\n            candidate = 1\n        else:\n            s_num = str(n)\n            s_list = list(s_num)\n\n            current_candidate_list = MathUtils.mirror_left_to_right(s_list.copy())\n\n            if MathUtils.compare_strings_num(current_candidate_list, s_list) <= 0:\n                current_candidate_list = self._increment_middle(current_candidate_list)\n            \n            candidate = int(''.join(current_candidate_list))\n\n        duration_ms = (time.time() - start) * 1000.0\n        return PalindromeResult(input_value=n, result=candidate, duration_ms=duration_ms, timestamp=\"\")\n\n    def _increment_middle(self, s: List[str]) -> List[str]:\n        \"\"\"Increments the middle part of a digit list, handles carry, and re-mirrors.\"\"\"\n        l = len(s)\n        i = (l - 1) // 2 \n\n        carry = 1\n        while i >= 0 and carry > 0:\n            digit = int(s[i]) + carry\n            s[i] = str(digit % 10)\n            carry = digit // 10\n            i -= 1\n\n        if carry > 0:\n            # If carry remains, it means the number's length must increase (e.g., 9, 99).\n            return list('1' + '0' * (l - 1) + '1')\n        else:\n            # Otherwise, re-mirror the modified left half to form the new palindrome.\n            return MathUtils.mirror_left_to_right(s)\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome integer strictly greater than a specified integer.\n    Example: next_smallest_palindrome(99) == 101.\n    \"\"\"\n    validator = InputValidator(max_digits=MAX_DIGITS)\n    n_int = validator.validate_int(n)\n    svc = PalindromeService()\n    result_dto = svc.next_palindrome(n_int)\n    return result_dto.result", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/104": [{"task_id": "Mbpp/104", "solution": "def sort_sublists(items: list[list[str]]) -> list[list[str]]:\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists.\n\n    The input `items` can be a list or tuple of iterables. Each sublist/subtuple\n    will be sorted lexicographically and returned as a new list of lists.\n    \"\"\"\n    result = []\n    for sublist in items:\n        # Convert sublist to a list and sort it, ensuring a new sorted list is created.\n        result.append(sorted(list(sublist)))\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/106": [{"task_id": "Mbpp/106", "solution": "def add_lists(lst: list, tpl: tuple) -> tuple:\n    \"\"\"Appends all elements from a list to the end of a tuple, returning a new tuple.\"\"\"\n    return tpl + tuple(lst)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/105": [{"task_id": "Mbpp/105", "solution": "from typing import Iterable, List, Any, Optional\nclass InvalidInputError(ValueError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass ElementTypeError(TypeError):\n    def __init__(self, message: str, index: int, value: Any):\n        super().__init__(message)\n        self.index = index\n        self.value = value\ndef validate_iterable(obj: Any) -> Iterable[Any]:\n    \"\"\"Confirms obj is iterable; if not, raise InvalidInputError.\"\"\"\n    try:\n        iter(obj)\n    except TypeError:\n        raise InvalidInputError(\"Provided value is not iterable\")\n    return obj\ndef is_bool(value: Any) -> bool:\n    \"\"\"Returns True iff value is strictly a bool.\"\"\"\n    return type(value) is bool\nclass InMemoryRepository:\n    def __init__(self) -> None:\n        self._records: List[int] = []\n\n    def record(self, count: int) -> None:\n        self._records.append(count)\n\n    def get_records(self) -> List[int]:\n        return list(self._records)\nclass BoolList:\n    def __init__(self, values: Iterable[Any]) -> None:\n        self._raw_values = values\n        self.values: List[bool] = []\n\n    def validate(self) -> None:\n        iterable = validate_iterable(self._raw_values)\n        self.values = []\n        for i, v in enumerate(iterable):\n            if not is_bool(v):\n                raise ElementTypeError(f\"Element at index {i} is not bool\", index=i, value=v)\n            self.values.append(v)\nclass CountService:\n    def __init__(self, repository: Optional[InMemoryRepository] = None) -> None:\n        self._repository = repository\n\n    def count_true(self, values: List[bool]) -> int:\n        count = sum(1 for v in values if v is True)\n        if self._repository:\n            self._repository.record(count)\n        return count\nclass CounterController:\n    def __init__(self, service: CountService) -> None:\n        self._service = service\n\n    def count(self, values: Iterable[Any]) -> int:\n        dto = BoolList(values)\n        dto.validate()\n        return self._service.count_true(dto.values)\ndef count(values: Iterable[Any]) -> int:\n    \"\"\"Counts strictly boolean True values in the provided iterable.\"\"\"\n    repo = InMemoryRepository()\n    service = CountService(repository=repo)\n    controller = CounterController(service=service)\n    return controller.count(values)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/113": [{"task_id": "Mbpp/113", "solution": "def check_integer(value: str, allow_sign: bool = True, allow_whitespace: bool = True) -> bool:\n    \"\"\"Checks if a string represents a valid decimal integer based on sign and whitespace options.\"\"\"\n    import re\n\n    processed_value = value.strip() if allow