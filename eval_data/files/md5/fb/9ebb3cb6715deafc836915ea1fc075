[i]:\n                        inc_sum[i] = inc_sum[j] + arr_inner[i]\n                        inc_seq[i] = inc_seq[j] + [arr_inner[i]]\n        return inc_sum, inc_seq\n\n    # _compute_decreasing_sums computes the maximum sum of a decreasing subsequence\n    # starting at each index, and the corresponding sequence.\n    def _compute_decreasing_sums(arr_inner: list) -> tuple[list[int], list[list[int]]]:\n        dec_sum = list(arr_inner)\n        dec_seq = [[x] for x in arr_inner]\n\n        for i in range(n - 2, -1, -1):\n            for j in range(i + 1, n):\n                if arr_inner[j] < arr_inner[i]:\n                    if dec_sum[j] + arr_inner[i] > dec_sum[i]:\n                        dec_sum[i] = dec_sum[j] + arr_inner[i]\n                        dec_seq[i] = [arr_inner[i]] + dec_seq[j]\n        return dec_sum, dec_seq\n\n    inc_sum, _ = _compute_increasing_sums(arr)\n    dec_sum, _ = _compute_decreasing_sums(arr)\n\n    max_bitonic_sum = float(\"-inf\")\n\n    for i in range(n):\n        # The sum for a bitonic subsequence peaking at arr[i]\n        # is the sum of the longest increasing subsequence ending at arr[i]\n        # plus the sum of the longest decreasing subsequence starting at arr[i],\n        # minus arr[i] itself (to avoid double counting the peak element).\n        current_bitonic_sum = inc_sum[i] + dec_sum[i] - arr[i]\n        if current_bitonic_sum > max_bitonic_sum:\n            max_bitonic_sum = current_bitonic_sum\n\n    return max_bitonic_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/84": [{"task_id": "Mbpp/84", "solution": "def sequence(n: int) -> int:\n    \"\"\"Calculates the nth number in the Newman-Conway sequence using dynamic programming.\n    Results are memoized on the function object to optimize repeated calculations.\n    \"\"\"\n    if not hasattr(sequence, \"_cache\"):\n        sequence._cache = {1: 1, 2: 1}\n\n    if n in sequence._cache:\n        return sequ