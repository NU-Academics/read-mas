rn result\n\n    def _compute_factorial_iterative(self, n: int) -> int:\n        r = 1\n        for i in range(2, n + 1):\n            r *= i\n        return r\nclass LastDigitService:\n    \"\"\"Service to compute the last digit of a factorial.\"\"\"\n    SMALL_FACTORIAL_THRESHOLD = 5\n\n    def __init__(self, factorial_service: 'FactorialService') -> None:\n        self._fact = factorial_service\n\n    def compute_last_digit(self, n: int) -> int:\n        if n < 0:\n            raise InvalidInputError(\"n must be non-negative\")\n\n        if n >= self.SMALL_FACTORIAL_THRESHOLD:\n            return 0\n        \n        return self._fact.factorial(n) % 10\n_default_cache = FactorialCacheRepository(max_size=256)\n_default_factorial_service = FactorialService(cache=_default_cache)\n_default_last_digit_service = LastDigitService(_default_factorial_service)\ndef last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Finds the last digit in factorial of a given number.\n    It handles special cases for small n and uses mathematical properties for larger n.\n    \"\"\"\n    return _default_last_digit_service.compute_last_digit(n)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/578": [{"task_id": "Mbpp/578", "solution": "def interleave_lists(a, b, c):\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Elements are taken alternately from a, b, and c in order.\n    \"\"\"\n    n = len(a)\n    result = [None] * (3 * n)\n    idx = 0\n    for i in range(n):\n        result[idx] = a[i]\n        idx += 1\n        result[idx] = b[i]\n        idx += 1\n        result[idx] = c[i]\n        idx += 1\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/579": [{"task_id": "Mbpp/579", "solution": "def find_dissimilar(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Finds elements present in exactly one of the two input tuples,\n   