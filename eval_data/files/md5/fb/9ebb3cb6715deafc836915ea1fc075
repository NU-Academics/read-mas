 Any, Sequence, Optional\n\n    class InvalidInputError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class ListValidator:\n        @staticmethod\n        def is_iterable_but_not_string(obj: Any) -> bool:\n            try:\n                iter(obj)\n            except TypeError:\n                return False\n            return not isinstance(obj, (str, bytes))\n\n        def validate_count_input(self, obj: Any) -> Sequence[Any]:\n            if not self.is_iterable_but_not_string(obj):\n                raise InvalidInputError(\"Input must be an iterable (like list) but not a string/bytes.\")\n            return obj\n\n    class CountService:\n        def __init__(self, validator: ListValidator, repository: Optional[object] = None) -> None:\n            self._validator = validator\n            self._repo = repository\n\n        def count_lists(self, items: Any) -> int:\n            seq = self._validator.validate_count_input(items)\n            count = self._compute_count(seq)\n            return count\n\n        def _compute_count(self, items: Sequence[Any]) -> int:\n            return sum(1 for x in items if isinstance(x, list))\n\n    validator = ListValidator()\n    service = CountService(validator)\n    return service.count_lists(items)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/794": [{"task_id": "Mbpp/794", "solution": "import re\ndef text_starta_endb(text: str) -> bool:\n    \"\"\"Checks if a string starts with 'a', followed by any characters, and ends with 'b'.\"\"\"\n    # The regex '^a.*b$' matches a string that begins with 'a', contains zero or more\n    # of any character, and then ends with 'b'.\n    pattern = r\"^a.*b$\"\n    return re.fullmatch(pattern, text) is not None", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["xaabbyz1323ababb"]]}], "Mbpp/796"