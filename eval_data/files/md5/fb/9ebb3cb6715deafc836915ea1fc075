with positive digit strings, regardless of the input's sign or type (int/str).\n    number_as_int = int(n)\n    s = str(abs(number_as_int))\n    \n    total_alternating_sum = 0\n    \n    for idx, char_digit in enumerate(s):\n        digit = int(char_digit)\n        if idx % 2 == 0:  # Digits at even indices (0-based: first, third, etc.) are added\n            total_alternating_sum += digit\n        else:             # Digits at odd indices (1-based: second, fourth, etc.) are subtracted\n            total_alternating_sum -= digit\n            \n    # A number is divisible by 11 if its alternating sum of digits is divisible by 11.\n    return abs(total_alternating_sum) % 11 == 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/82": [{"task_id": "Mbpp/82", "solution": "import math\ndef volume_sphere(radius):\n    \"\"\"\n    Calculate the volume of a sphere given its radius.\n    The formula used is (4/3) * pi * r^3.\n    \"\"\"\n    return (4/3) * math.pi * (radius ** 3)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/75": [{"task_id": "Mbpp/75", "solution": "def find_tuples(input_list, k):\n    \"\"\"\n    Finds tuples from a list where all elements are divisible by k.\n    Returns a new list containing only the matching tuples.\n    \"\"\"\n    result = []\n    for current_tuple in input_list:\n        if all(element % k == 0 for element in current_tuple):\n            result.append(current_tuple)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/88": [{"task_id": "Mbpp/88", "solution": "def freq_count(elements):\n    \"\"\"\n    Counts the frequency of each element in a list.\n    \"\"\"\n    counts = {}\n    for item in elements:\n        counts[item] = counts.get(item, 0) + 1\n    return counts", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]