   best_single = kadane(arr)\n    \n    # Calculate the total sum of the array.\n    total_sum = sum(arr)\n\n    # Calculate the maximum prefix sum.\n    prefix_max = float('-inf')\n    current_prefix_sum = 0\n    for x in arr:\n        current_prefix_sum += x\n        prefix_max = max(prefix_max, current_prefix_sum)\n\n    # Calculate the maximum suffix sum.\n    suffix_max = float('-inf')\n    current_suffix_sum = 0\n    for x in reversed(arr):\n        current_suffix_sum += x\n        suffix_max = max(suffix_max, current_suffix_sum)\n\n    # If the total sum of the array is positive, the maximum subarray can potentially\n    # span across multiple repetitions, benefiting from the positive total sum of inner blocks.\n    if total_sum > 0:\n        # The candidate sum is the best suffix of the first block, plus (k-2) full blocks,\n        # plus the best prefix of the last block.\n        # If k=2, total_sum * (k-2) becomes 0, correctly giving suffix_max + prefix_max.\n        candidate_sum = suffix_max + total_sum * (k - 2) + prefix_max\n        return max(best_single, candidate_sum)\n    # If the total sum is non-positive, including more than two blocks won't increase the sum.\n    # The maximum sum will either be within a single block or span across two concatenated blocks.\n    else:\n        # Apply Kadane's algorithm to two concatenated arrays (arr + arr)\n        # to find the maximum sum that spans across the boundary.\n        arr_twice = arr + arr\n        best_double = kadane(arr_twice)\n        return max(best_single, best_double)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/299": [{"task_id": "Mbpp/299", "solution": "def max_aggregate(data):\n    \"\"\"\n    Calculates the maximum aggregate sum from a list of (name, value) tuples.\n    If multiple names tie for the maximum sum, the lexicographically smallest name is returned.\n    \"\"\"\n    aggregates = {}\n    for name, value in data:\n        aggregates[name] = aggregates.get(name, 0.0) + value\n\n    if not aggregates:\n        # According to the design context's AggregatorService, NotFoundError would be raised here.\n        # Per strict completion instructions \"Do NOT add ... raise exceptions for edge cases\",\n        # we let Python's built-in behavior take its course for empty aggregates.\n        # max(empty_iterable) raises ValueError.\n        return None # Or let ValueError propagate if design allows\n\n    max_total = max(aggregates.values())\n    \n    # Find all names that have the max_total\n    candidates = [name for name, total in aggregates.items() if total == max_total]\n    \n    # Apply lexicographical tie-breaker\n    chosen_name = sorted(candidates)[0]\n    \n    return (chosen_name, max_total)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[["Alice", -50], ["AlDavidice", -50]]]]}], "Mbpp/300": [{"task_id": "Mbpp/300", "solution": "def count_binary_seq(n: int) -> float:\n    \"\"\"\n    Counts binary sequences of length 2n where the sum of the first n bits\n    is the same as the sum of the last n bits.\n    This count is given by the central binomial coefficient C(2n, n).\n    \"\"\"\n    def _binomial_coefficient(N: int, K: int) -> int:\n        \"\"\"Calculates C(N, K), the number of ways to choose K items from N, using integer arithmetic.\"\"\"\n        if K < 0 or K > N:\n            return 0\n        \n        # Optimization: C(N, K) = C(N, N - K)\n        K = min(K, N - K)\n        \n        if K == 0:\n            return 1\n        \n        try:\n            # Use math.comb if available (Python 3.8+)\n            return math.comb(N, K)\n        except AttributeError:\n            # Fallback multiplicative algorithm for older Python versions\n            res = 1\n            for i in range(K):\n                res = res * (N - i) // (i + 1)\n            return res\n\n    import math\n\n    # The count is given by the central binomial coefficient C(2n, n)\n    N_val = 2 * n\n    K_val = n\n    \n    result_int = _binomial_coefficient(N_val, K_val)\n    return float(result_int)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[1000]]}], "Mbpp/297": [{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list):\n    flattened = []\n    for item in nested_list:\n        if isinstance(item, list):\n            flattened.extend(flatten_list(item))\n        else:\n            flattened.append(item)\n    return flattened", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/294": [{"task_id": "Mbpp/294", "solution": "from typing import Any, Iterable, Iterator, Union\nfrom decimal import Decimal\nclass NoNumericValueError(Exception):\n    \"\"\"Exception raised when no numeric values are found in the input list.\"\"\"\n    def __init__(self, message: str = None) -> None:\n        super().__init__(message or \"No numeric values found.\")\nACCEPTED_NUMERIC_TYPES = (int, float, Decimal)\ndef is_numeric(obj: Any) -> bool:\n    \"\"\"Checks if an object is a numeric type (int, float, Decimal) but not a boolean.\"\"\"\n    return isinstance(obj, ACCEPTED_NUMERIC_TYPES) and not isinstance(obj, bool)\ndef normalize_number(obj: Any) -> Union[int, float, Decimal]:\n    \"\"\"Returns the object if it's a numeric type, otherwise raises TypeError.\"\"\"\n    if not is_numeric(obj):\n        raise TypeError(\"Object is not a supported numeric type.\")\n    return obj\nclass InputDTO:\n    \"\"\"A data transfer object for validating the input list.\"\"\"\n    def __init__(self, items: list) -> None:\n        self.items = items\n\n    def validate(self) -> None:\n        \"\"\"Validates that the input is a list, raising TypeError if not.\"\"\"\n        if not isinstance(self.items, list):\n            raise TypeError(\"Input 'items' must be a list.\")\nclass NumericFilterAdapter:\n    \"\"\"Filters an iterable, yielding