kenizes and converts a tuple string into a TupleModel.\"\"\"\n    LEFT_PAREN = \"(\"\n    RIGHT_PAREN = \")\"\n    INT_RE = re.compile(r'^[+-]?\\d+$')\n\n    def __init__(self) -> None:\n        self._validator = TupleValidator()\n\n    def parse(self, s: str) -> TupleModel:\n        \"\"\"Parses the input string and returns a TupleModel.\"\"\"\n        self._validator.validate_raw_input(s)\n        body = self._validator.validate_delimiters(s)\n        tokens = self._tokenize_body(body)\n        self._validator.validate_tokens(tokens)\n        \n        final_tokens = [t for t in tokens if t != '']\n        values = tuple(self._parse_int_token(t) for t in final_tokens) if final_tokens else tuple()\n        \n        return TupleModel(values)\n\n    def _tokenize_body(self, body: str) -> list[str]:\n        \"\"\"Splits the tuple body by commas and strips whitespace from each token.\"\"\"\n        if body.strip() == \"\":\n            return []\n        return [tok.strip() for tok in body.split(\",\")]\n\n    def _parse_int_token(self, token: str) -> int:\n        \"\"\"Converts a string token to an integer, validating its format.\"\"\"\n        if not self.INT_RE.match(token):\n            raise ValidationError(f\"Invalid integer token: {token!r}\")\n        return int(token)\nclass ParserController:\n    \"\"\"Facade for the parsing system, providing a high-level API.\"\"\"\n    def __init__(self, parser: TupleParser = None) -> None:\n        self._parser = parser or TupleParser()\n\n    def parse_to_model(self, s: str) -> TupleModel:\n        \"\"\"Parses the string and returns a TupleModel.\"\"\"\n        return self._parser.parse(s)\n\n    def parse_to_tuple(self, s: str) -> tuple[int, ...]:\n        \"\"\"Parses the string and returns a raw tuple of integers.\"\"\"\n        return self.parse_to_model(s).to_tuple()\n_controller = ParserController()\ndef tuple_str_int(s: str) -> tuple[int, ...]:\n    \"\"\"\n    Converts a string representation of an integer tup