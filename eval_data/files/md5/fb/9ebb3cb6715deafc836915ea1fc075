eversed\": self.reverse(),\n            \"timestamp\": datetime.utcnow().isoformat() + \"Z\",\n        }\nclass CheckService:\n    \"\"\"Core business logic to check if a number meets the specified condition.\"\"\"\n    def __init__(self, repo=None) -> None:\n        self._repo = repo\n\n    def is_one_less_than_twice_reverse(self, n: int) -> bool:\n        \"\"\"Determines if n is one less than twice its reverse.\"\"\"\n        num = Number(n)\n        r = num.reverse()\n        expected = 2 * r - 1\n        result = (expected == n)\n        # Persistence is disabled for this `_service` instance as `repo` is None.\n        return result\n_service = CheckService()\ndef check(n):\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    The check uses an internal service for calculation and validation.\n    \"\"\"\n    return _service.is_one_less_than_twice_reverse(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/61": [{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of substrings where the sum of digits equals their length.\n    It uses a prefix sum technique with a digit transformation to achieve O(n) time complexity.\n    \"\"\"\n    from collections import defaultdict\n    from typing import List\n\n    def transform_digits(input_str: str) -> List[int]:\n        \"\"\"Transforms each digit d in the string to (d-1) for prefix sum calculation.\"\"\"\n        return [int(ch) - 1 for ch in input_str]\n\n    def prefix_count_transformed(arr: List[int]) -> int:\n        \"\"\"Counts subarrays summing to zero using prefix sums and a frequency map.\"\"\"\n        counts = defaultdict(int)\n        prefix_sum = 0\n        counts[0] = 1  # Initialize for subarrays starting from index 0\n        result_count = 0\n        for val in arr:\n            prefix_sum += val\n            result_count += counts[prefix_sum]\n            counts[pr