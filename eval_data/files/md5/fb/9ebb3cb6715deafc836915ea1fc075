[{"task_id": "Mbpp/635", "solution": "from typing import List, TypeVar, MutableSequence\nT = TypeVar(\"T\")\ndef heap_sort(items: List[T]) -> List[T]:\n    \"\"\"Sorts a list using the heap sort algorithm.\n    It returns a new sorted list, leaving the original list unchanged.\n    \"\"\"\n\n    def _heapify(arr: MutableSequence[T], n: int, i: int) -> None:\n        \"\"\"Maintains the max-heap property for a subtree rooted at index i.\"\"\"\n        largest = i\n        left = 2 * i + 1\n        right = 2 * i + 2\n\n        if left < n and arr[left] > arr[largest]:\n            largest = left\n\n        if right < n and arr[right] > arr[largest]:\n            largest = right\n\n        if largest != i:\n            arr[i], arr[largest] = arr[largest], arr[i]\n            _heapify(arr, n, largest)\n\n    # Create a mutable copy of the input list to perform in-place sorting on it.\n    a = list(items)\n    n = len(a)\n\n    # Build a max-heap from the input list.\n    for i in range(n // 2 - 1, -1, -1):\n        _heapify(a, n, i)\n\n    # Extract elements one by one from the heap and place them at the end.\n    for i in range(n - 1, 0, -1):\n        a[i], a[0] = a[0], a[i]  # Move current root (largest element) to the end\n        _heapify(a, i, 0)        # Call max _heapify on the reduced heap\n\n    return a", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/639": [{"task_id": "Mbpp/639", "solution": "def sample_nam(names):\n    \"\"\"\n    Sums the length of names that do not start with a lowercase letter.\n    \"\"\"\n    total_length = 0\n    for name in names:\n        if name and not ('a' <= name[0] <= 'z'):\n            total_length += len(name)\n    return total_length", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[["AbCdE", "fGH", "IJKLMnOp", "qrs", "TUVW", "xyz"]]]}], "Mbpp/637": [{"task_id": "Mbpp/637", "solution": "def noprofit_noloss(sp, cp) -> bool:\n    \"\"\"\n    Checks if the selling price equals the cost price, indicating no profit and no loss.\n    Validates inputs to be numeric and non-negative before comparison.\n    \"\"\"\n\n    class DomainError(Exception):\n        \"\"\"Base exception for domain-specific errors.\"\"\"\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(message)\n\n    class ValidationError(DomainError):\n        \"\"\"Exception raised for invalid input data.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    def parse_price(value: any) -> float:\n        \"\"\"Converts a value to a non-negative float price, raising ValidationError on failure.\"\"\"\n        if isinstance(value, (int, float)):\n            val = float(value)\n        elif isinstance(value, str):\n            try:\n                val = float(value.strip())\n            except ValueError:\n                raise ValidationError(f\"Invalid numeric value: {value!r}\")\n        else:\n            raise ValidationError(f\"Unsupported type for price: {type(value).__name__}\")\n        if val < 0:\n            raise ValidationError(\"Price cannot be negative\")\n        return val\n\n    class PriceComparison:\n        \"\"\"Encapsulates selling and cost prices for no profit no loss evaluation.\"\"\"\n        def __init__(self, selling_price: float, cost_price: float) -> None:\n            self._selling_price: float = selling_price\n            self._cost_price: float = cost_price\n\n        def is_no_profit_no_loss(self) -> bool:\n            \"\"\"Returns True if selling price exactly equals cost price.\"\"\"\n            return self._selling_price == self._cost_price\n\n    class NoProfitNoLossService:\n        \"\"\"Provides the core business logic to determine no profit no loss.\"\"\"\n        def __init__(self) -> None:\n            # Repository omitted for inline implementation constraint.\n            pass\n\n        def is_no_profit_no_loss(self, selling_price: float, cost_price: float) -> bool:\n            \"\"\"Compares prices using the PriceComparison model.\"\"\"\n            pc = PriceComparison(selling_price, cost_price)\n            return pc.is_no_profit_no_loss()\n\n    class APIController:\n        \"\"\"Manages input validation and delegates to the NoProfitNoLossService.\"\"\"\n        def __init__(self, service: NoProfitNoLossService) -> None:\n            self._service = service\n\n        def noprofit_noloss(self, selling_price_raw: any, cost_price_raw: any) -> bool:\n            \"\"\"Parses and validates prices, then calls the service for the check.\"\"\"\n            s = parse_price(selling_price_raw)\n            c = parse_price(cost_price_raw)\n            return self._service.is_no_profit_no_loss(s, c)\n\n    # Instantiate the necessary components within the function scope\n    service_instance = NoProfitNoLossService()\n    controller_instance = APIController(service=service_instance)\n\n    # Execute the check using the instantiated controller\n    return controller_instance.noprofit_noloss(sp, cp)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[-2000, -5000]]}], "Mbpp/638": [{"task_id": "Mbpp/638", "solution": "import math\ndef wind_chill(velocity_kmh: float, temperature_c: float) -> int:\n    \"\"\"\n    Calculates the wind chill index rounded to the nearest integer.\n    Uses the standard Celsius wind chill formula.\n    \"\"\"\n    COEFF_A = 13.12\n    COEFF_B = 0.6215\n    COEFF_C = -11.37\n    COEFF_D = 0.3965\n\n    v_pow_0_16 = velocity_kmh ** 0.16\n\n    raw_wind_chill = (\n        COEFF_A\n        + COEFF_B * temperature_c\n        + COEFF_C * v_pow_0_16\n        + COEFF_D * temperature_c * v_pow_0_16\n    )\n\n    if raw_wind_chill >= 0:\n        rounded_wind_chill = int(math.floor(raw_wind_chill + 0.5))\n    else:\n        rounded_wind_chill = int(math.ceil(raw_wind_chill - 0.5))\n\n    return rounded_wind_chill", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/641": [{"task_id": "Mbpp/641", "solution": "def is_nonagonal(n: int) -> int:\n    \"\"\"Calculates the nth nonagonal number using the formula N(n) = (7*n^2 - 5*n) / 2.\"\"\"\n    return (7 * n * n - 5 * n) // 2", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/643": [{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(text: str, persist: bool = False) -> bool:\n    \"\"\"\n    Checks if the given text contains 'z' in the middle of any word.\n    Optionally persists the result to an in-memory database.\n    \"\"\"\n    import re\n    import sqlite3\n    import json\n    from datetime import datetime\n\n    # Configuration constants\n    CASE_INSENSITIVE: bool = True\n    WORD_REGEX: str = r\"\\b\\w+\\b\"\n    DEFAULT_TOKEN_PATTERN: str = WORD_REGEX\n\n    # Exception classes (defined but not raised due to constraints)\n    class TextzError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    class InvalidInputError(TextzError):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    # Utility functions\n    def indices_to_json(indices: list[int]) -> str:\n        \"\"\"Converts a list of integers to a JSON string.\"\"\"\n        return json.dumps(indices)\n\n    def json_to_indices(s: str) -> list[int]:\n        \"\"\"Converts a JSON string back to a list of integers.\"\"\"\n        return json.loads(s)\n\n    # Data model for persistence\n    class TextMatchResult:\n        \"\"\"Represents the result of a single text check.\"\"\"\n        def __init__(self, id: int | None, input_text: str, matched: bool, matched_indices: list[int], created_at: datetime) -> None:\n            self.id = id\n            self.input_text = input_text\n            self.matched = matched\n            self.matched_indices = matched_indices\n            self.created_at = created_at\n\n        @staticmethod\n        def from_row(row: sqlite3.Row) -> 'TextMatchResult':\n            \"\"\"Constructs a TextMatchResult from a database row.\"\"\"\n            return TextMatchResult(\n                id=row[\"id\"],\n                input_text=row[\"input_text\"],\n                matched=bool(row[\"matched\"]),\n                matched_indices=json_to_indices(row[\"matched_indices\"]),\n                created_at=datetime.fromisoformat(row[\"created_at\"]) if row[\"created_at\"] else None,\n            )\n\n    # Tokenizer component\n    class WordTokenizer:\n        \"\"\"Splits text into words with their start and end indices.\"\"\"\n        def __init__(self, token_pattern: str = DEFAULT_TOKEN_PATTERN) -> None:\n            self.token_pattern = token_pattern\n            self._compiled = re.compile(self.token_pattern, flags=re.UNICODE)\n\n        def tokenize(self, text: str) -> list[tuple[str,int,int]]:\n            \"\"\"Returns a list of (word, start_index, end_index) tuples.\"\"\"\n            return [(m.group(0), m.start(), m.end()) for m in self._compiled.finditer(text)]\n\n    # Pattern matching component\n    class PatternMatcher:\n        \"\"\"Checks if a word contains 'z' not at its start or end.\"\"\"\n        def __init__(self, case_insensitive: bool = CASE_INSENSITIVE) -> None:\n            self.case_insensitive = case_insensitive\n\n        def word_has_middle_z(self, word: str) -> tuple[bool, list[int]]:\n            \"\"\"Returns if 'z' is found in the middle and its relative indices.\"\"\"\n            if len(word) < 3:\n                return False, []\n            check_word = word.lower() if self.case_insensitive else word\n            indices = [i for i, ch in enumerate(check_word) if ch == 'z' and 0 < i < (len(check_word)-1)]\n            return (len(indices) > 0), indices\n\n    # Repository for persisting results\n    class ResultRepository:\n        \"\"\"Manages storage and retrieval of TextMatchResult objects.\"\"\"\n        def __init__(self, db_path: str | None = None) -> None:\n            self.db_path = db_path if db_path is not None else \":memory:\" # Default to in-memory for this self-contained function\n            self.conn = sqlite3.connect(self.db_path, detect_types=sqlite3.PARSE_DECLTYPES)\n            self.conn.row_factory = sqlite3.Row\n            self.init_db()\n\n        def init_db(self) -> None:\n            \"\"\"Initializes the database schema if it doesn't exist.\"\"\"\n            sql_script = \"\"\"\n            CREATE TABLE IF NOT EXISTS checks (\n              id INTEGER PRIMARY KEY AUTOINCREMENT,\n              input_text TEXT NOT NULL,\n              matched INTEGER NOT NULL,\n              matched_indices TEXT NOT NULL,\n              created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n            );\n            CREATE INDEX IF NOT EXISTS idx_checks_created_at ON checks(created_at DESC);\n            \"\"\"\n            self.conn.executescript(sql_script)\n            self.conn.commit()\n\n        def save(self, result: TextMatchResult) -> TextMatchResult:\n            \"\"\"Inserts a new TextMatchResult into the database.\"\"\"\n            # Exception handling is omitted due to explicit constraint.\n            cur = self.conn.cursor()\n            cur.execute(\n                \"INSERT INTO checks (input_text, matched, matched_indices) VALUES (?, ?, ?)\",\n                (result.input_text, int(result.matched), indices_to_json(result.matched_indices))\n            )\n            self.conn.commit()\n            result.id = cur.lastrowid\n            return result\n\n    # Main service for analysis and orchestration\n    class TextAnalyzerService:\n        \"\"\"Orchestrates tokenization, matching, and optional persistence.\"\"\"\n        def __init__(self, tokenizer: WordTokenizer, matcher: PatternMatcher, repo: ResultRepository | None = None) -> None:\n            self.tokenizer = tokenizer\n            self.matcher = matcher\n            self.repo = repo\n\n        def find_matches(self, text: str) -> list[tuple[int,int,int]]:\n            \"\"\"Finds all occurrences of 'z' in the middle of words.\"\"\"\n            matches = []\n            for word, start, end in self.tokenizer.tokenize(text):\n                matched, rel_indices = self.matcher.word_has_middle_z(word)\n                for idx in rel_indices:\n                    matches.append((start, end, start + idx))\n            return matches\n\n        def contains_z_in_word_middle(self, text: str, persist: bool=False) -> bool:\n            \"\"\"Checks text for 'z' in the middle of words and optionally persists.\"\"\"\n            matches = self.find_matches(text)\n            matched = len(matches) > 0\n            if persist and self.repo:\n                result = TextMatchResult(\n                    id=None,\n                    input_text=text,\n                    matched=matched,\n                    matched_indices=[m[2] for m in matches],\n                    created_at=datetime.utcnow()\n                )\n                self.repo.save(result)\n            return matched\n\n    # Initialize components and run the service\n    tokenizer = WordTokenizer()\n    matcher = PatternMatcher()\n    repo = ResultRepository(db_path=\":memory:\") if persist else None\n    svc = TextAnalyzerService(tokenizer, matcher, repo)\n    return svc.contains_z_in_word_middle(text, persist=persist)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/644": [{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(arr: list, k: int, in_place: bool = False) -> list:\n    \"\"\"Reverses the first k elements of an array.\n    Optionally performs the reversal in place or returns a new list.\n    \"\"\"\n    if in_place:\n        target_array = arr\n    else:\n        target_array = list(arr)\n\n    left, right = 0, k - 1\n    while left < right:\n        target_array[left], target_array[right] = target_array[right], target_array[left]\n        left += 1\n        right -= 1\n\n    return target_array", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/722": [{"task_id": "Mbpp/722", "solution": "def filter_data(data, min_height, min_weight):\n    \"\"\"\n    Filters students based on their height and weight against minimum thresholds.\n    Returns a new dictionary containing only students who meet both criteria.\n    \"\"\"\n    filtered_students = {}\n    for name, (height, weight) in data.items():\n        if height >= min_height and weight >= min_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/721": [{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix: list[list[int]]) -> float:\n    \"\"\"\n    Given a square matrix, finds a path from top-left to bottom-right\n    moving only right or down, with the maximum average cost.\n    \"\"\"\n    n = len(matrix)\n\n    # dp[r][c] stores the maximum total cost to reach cell (r, c).\n    dp = [[0.0] * n for _ in range(n)]\n\n    # Initialize the starting cell\n    dp[0][0] = float(matrix[0][0])\n\n    # Initialize the first row (only move right)\n    for c in range(1, n):\n        dp[0][c] = dp[0][c - 1] + float(matrix[0][c])\n\n    # Initialize the first column (only move down)\n    for r in range(1, n):\n        dp[r][0] = dp[r - 1][0] + float(matrix[r][0])\n\n    # Fill the rest of the DP table\n    for r in range(1, n):\n        for c in range(1, n):\n            # To reach (r, c), we must come from (r-1, c) or (r, c-1).\n            # Choose the path with the maximum accumulated cost.\n            dp[r][c] = max(dp[r - 1][c], dp[r][c - 1]) + float(matrix[r][c])\n\n    # The maximum total cost for any path ends at the bottom-right cell.\n    total_cost = dp[n - 1][n - 1]\n\n    # For an N x N matrix, any path from top-left to bottom-right\n    # moving only right or down has a fixed length of 2N - 1 cells.\n    path_length = 2 * n - 1\n\n    # Calculate the maximum average\n    average = total_cost / path_length\n\n    return average", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/630": [{"task_id": "Mbpp/630", "solution": "from typing import List, Tuple\ndef get_coordinates(coord: Tuple[int, int]) -> List[List[int]]:\n    \"\"\"\n    Extracts all the 3x3 adjacent coordinates of the given coordinate tuple, including the center.\n    The output is in row-major order.\n    \"\"\"\n    x, y = coord\n    adjacent_coords = []\n    for dx in (-1, 0, 1):\n        for dy in (-1, 0, 1):\n            adjacent_coords.append([x + dx, y + dy])\n    return adjacent_coords", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, 1, 1]]]}], "Mbpp/723": [{"task_id": "Mbpp/723", "solution": "def count_same_pair(list_a, list_b):\n    \"\"\"\n    Counts indices where two equal-length lists contain equal values.\n    Assumes inputs are lists of the same length.\n    \"\"\"\n    count = 0\n    for i in range(len(list_a)):\n        if list_a[i] == list_b[i]:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/725": [{"task_id": "Mbpp/725", "solution": "def extract_quotation(text: str) -> list[str]:\n    import re\n\n    # Regex pattern to find content between double quotes,\n    # handling escaped quotes within the content.\n    # It captures anything that is not a double quote or a backslash,\n    # or an escaped character sequence (like \\\").\n    pattern = re.compile(r'\"((?:\\\\.|[^\"\\\\])*)\"')\n\n    # Find all non-overlapping matches of the pattern in the string.\n    # The findall method returns a list of all captured groups.\n    matches = p