"\n    Determines if an element x is the majority element in a sorted array arr of length n.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n    def _first_occurrence(array, target):\n        \"\"\"\n        Finds the first occurrence of target in a sorted array using binary search.\n        Returns the index of the first occurrence or -1 if not found.\n        \"\"\"\n        lo, hi = 0, len(array) - 1\n        res = -1\n        while lo <= hi:\n            mid = (lo + hi) // 2\n            if array[mid] == target:\n                res = mid\n                hi = mid - 1\n            elif array[mid] < target:\n                lo = mid + 1\n            else:\n                hi = mid - 1\n        return res\n\n    first_idx = _first_occurrence(arr, x)\n\n    if first_idx == -1:\n        return False\n\n    # The majority element must occur more than n/2 times.\n    # If the element at first_idx + n//2 is also x, it means x occurs at least n//2 + 1 times.\n    check_idx = first_idx + n // 2\n\n    return check_idx < n and arr[check_idx] == x", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[52, 52], 52, 52]]}], "Mbpp/168": [{"task_id": "Mbpp/168", "solution": "from typing import List, Any\ndef frequency(list_: List[Any], value: Any) -> int:\n    \"\"\"Counts the number of occurrences of a value in a list.\"\"\"\n    count = 0\n    for item in list_:\n        if item == value:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/222": [{"task_id": "Mbpp/222", "solution": "from typing import Any, Iterable\ndef check_type(iterable: Iterable[Any]) -> bool:\n    \"\"\"\n    Checks if all elements in an iterable have the same data type.\n    An empty iterable is considered to have all elements of the same type.\n    \"\"\"\n    iterator = iter(iterable)\n    try:\n        first_element = next(iterator)\n        first_type = 