{"task_id": "HumanEval/130", "solution": "from typing import Dict, List\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass TribonacciCalculator:\n    \"\"\"Manages Tribonacci sequence calculations, using memoization.\"\"\"\n    def __init__(self):\n        self._memo: Dict[int, int] = {}\n\n    def _calculate_term(self, n: int) -> int:\n        \"\"\"Recursively calculates the n-th Tribonacci term with memoization.\"\"\"\n        if n < 0:\n            raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n        \n        if n in self._memo:\n            return self._memo[n]\n\n        if n == 0:\n            result = 1\n        elif n == 1:\n            result = 3\n        elif n % 2 == 0:  # n is even\n            result = 1 + n // 2\n        else:  # n is odd\n            # tri(n) = tri(n - 1) + tri(n - 2) + tri(n + 1)\n            term_n_minus_1 = self._calculate_term(n - 1)\n            term_n_minus_2 = self._calculate_term(n - 2)\n            term_n_plus_1 = self._calculate_term(n + 1)\n            result = term_n_minus_1 + term_n_minus_2 + term_n_plus_1\n        \n        self._memo[n] = result\n        return result\n\n    def calculate_sequence(self, n: int) -> List[int]:\n        \"\"\"Generates the first n+1 Tribonacci numbers.\"\"\"\n        if n < 0:\n            raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n            \n        sequence = []\n        for i in range(n + 1):\n            sequence.append(self._calculate_term(i))\n        return sequence\ndef tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in \n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8 \n    You are given a non-negative integer number n, you have to a return a list of the \n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    calculator = TribonacciCalculator()\n    return calculator.calculate_sequence(n)"}
{"task_id": "HumanEval/130", "solution": "from typing import List, Dict\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\n    It signals that a provided input does not meet the expected criteria.\n    \"\"\"\n    pass\ndef tri(n: int) -> List[int]:\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in \n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8 \n    You are given a non-negative integer number n, you have to a return a list of the \n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n\n    memo: Dict[int, int] = {}\n\n    def _calculate_term(k: int) -> int:\n        \"\"\"Recursively calculates the k-th Tribonacci term, utilizing memoization.\n        This private helper function handles the core recurrence relations and base cases.\n        \"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # k is even and k >= 2\n            result = 1 + k // 2\n        else:  # k is odd and k >= 3\n            term_k_minus_1 = _calculate_term(k - 1)\n            term_k_minus_2 = _calculate_term(k - 2)\n            term_k_plus_1 = _calculate_term(k + 1)\n            result = term_k_minus_1 + term_k_minus_2 + term_k_plus_1\n        \n        memo[k] = result\n        return result\n\n    # Ensure all terms up to n are calculated and memoized.\n    # The recursive calls within _calculate_term will handle dependencies,\n    # including tri(n+1) if n is odd, populating the memoization table as needed.\n    for i in range(n + 1):\n        _calculate_term(i)\n    \n    return [memo[i] for i in range(n + 1)]"}
{"task_id": "HumanEval/129", "solution": "import heapq\nfrom .models import Path\nfrom .grid_validator import GridValidator\nfrom .utils import Utils\nclass PathFinder:\n    \"\"\"Encapsulates the core logic for finding the lexicographically smallest path.\n    It uses a priority queue to efficiently explore paths.\n    \"\"\"\n    def __init__(self, grid: list[list[int]], N: int, k: int) -> None:\n        self._grid = grid\n        self._N = N\n        self._k = k\n        self._priority_queue: list[Path] = [] # heapq uses a list as its underlying heap structure.\n\n    def find_min_path(self) -> list[int]:\n        \"\"\"Executes the pathfinding algorithm to find the minimum path.\"\"\"\n        # Initialize priority queue with all possible starting paths of length 1.\n        for r in range(self._N):\n            for c in range(self._N):\n                initial_path = Path(values=[self._grid[r][c]], row=r, col=c, length=1)\n                heapq.heappush(self._priority_queue, initial_path)\n\n        return self._explore_paths()\n\n    def _explore_paths(self) -> list[int]:\n        \"\"\"Implements the priority queue-based search.\"\"\"\n        while self._priority_queue:\n            current_path = heapq.heappop(self._priority_queue)\n\n            if current_path.length == self._k:\n                return current_path.values\n\n            if current_path.length < self._k:\n                neighbors = Utils.get_neighbors(current_path.row, current_path.col, self._N)\n                for nr, nc in neighbors:\n                    new_values = current_path.values + [self._grid[nr][nc]]\n                    new_path = Path(values=new_values, row=nr, col=nc, length=current_path.length + 1)\n                    heapq.heappush(self._priority_queue, new_path)\n        \n        # This part should ideally not be reached if k is reachable given problem constraints.\n        # It handles scenarios where no path of length k could be found.\n        return []\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"Finds the lexicographically smallest path of length k in the given grid.\n    This is the main public entry point for the pathfinding functionality.\n    \"\"\"\n    N = GridValidator.validate_grid(grid)\n    GridValidator.validate_k(k, N * N)\n\n    finder = PathFinder(grid, N, k)\n    return finder.find_min_path()"}
