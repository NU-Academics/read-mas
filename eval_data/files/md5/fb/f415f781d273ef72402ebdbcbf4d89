{"task_id": "HumanEval/127", "solution": "import math\nclass Interval:\n    def __init__(self, start: int, end: int):\n        # Initializes an Interval object with start and end values.\n        # Validates that inputs are integers and start is not greater than end.\n        if not isinstance(start, int) or not isinstance(end, int):\n            raise TypeError(\"Interval start and end must be integers.\")\n        if start > end:\n            raise ValueError(\"Interval start cannot be greater than end.\")\n        self.start = start\n        self.end = end\n\n    def __repr__(self) -> str:\n        # Returns a string representation of the Interval object.\n        return f\"Interval({self.start}, {self.end})\"\nclass IntervalService:\n    def calculate_intersection_length(self, interval1: Interval, interval2: Interval) -> int:\n        # Calculates the length of the intersection of two given Interval objects.\n        # Returns 0 if there is no intersection.\n        max_start = max(interval1.start, interval2.start)\n        min_end = min(interval1.end, interval2.end)\n\n        if max_start > min_end:\n            return 0\n        \n        return min_end - max_start\nclass PrimeChecker:\n    def is_prime(self, number: int) -> bool:\n        # Checks if the given integer is a prime number using an optimized trial division method.\n        # Returns True if prime, False otherwise.\n        if number <= 1:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False\n        \n        for i in range(3, int(math.sqrt(number)) + 1, 2):\n            if number % i == 0:\n                return False\n        return True\nclass MainController:\n    def __init__(self):\n        # Initializes MainController and its service dependencies.\n        self._interval_service = IntervalService()\n        self._prime_checker = PrimeChecker()\n\n    def intersection(self, interval1_tuple: tuple[int, int], interval2_tuple: tuple[int, int]) -> str:\n        # Orchestrates the calculation of intersection length and its primality check.\n        # Returns \"YES\" if the length is prime, \"NO\" otherwise.\n        interval1 = Interval(interval1_tuple[0], interval1_tuple[1])\n        interval2 = Interval(interval2_tuple[0], interval2_tuple[1])\n\n        intersection_length = self._interval_service.calculate_intersection_length(interval1, interval2)\n\n        if intersection_length == 0:\n            return \"NO\"\n\n        if self._prime_checker.is_prime(intersection_length):\n            return \"YES\"\n        else:\n            return \"NO\"\n_main_controller_instance = MainController()\ndef intersection(interval1: tuple[int, int], interval2: tuple[int, int]) -> str:\n    \"\"\"\n    Determines if the length of the intersection of two intervals is a prime number.\n    It takes two intervals as tuples and returns \"YES\" or \"NO\".\n    \"\"\"\n    return _main_controller_instance.intersection(interval1, interval2)"}
