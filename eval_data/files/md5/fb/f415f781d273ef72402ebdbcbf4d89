{"task_id": "HumanEval/116", "solution": "from src.utils import BitCounter\nclass BitwiseSorter:\n    @staticmethod\n    def _comparison_key(num: int) -> tuple[int, int]:\n        \"\"\"\n        Generates a key for sorting based on set bit count and original number.\n        For negative numbers, set bits are counted from their absolute value as specified.\n        \"\"\"\n        abs_num = abs(num)\n        set_bits = BitCounter.count_set_bits(abs_num)\n        return (set_bits, num)\n\n    @staticmethod\n    def sort_array(arr: list[int]) -> list[int]:\n        \"\"\"\n        Sorts an array of integers by the count of set bits (ascending), then by decimal value (ascending).\n        This method performs input validation for type correctness.\n        \"\"\"\n        if not isinstance(arr, list):\n            raise TypeError(\"Input must be a list.\")\n        \n        for item in arr:\n            if not isinstance(item, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n\n        return sorted(arr, key=BitwiseSorter._comparison_key)\ndef sort_array(arr: list[int]) -> list[int]:\n    \"\"\"\n    Sorts an array of integers according to the number of ones in their binary representation.\n    The primary sort is by set bit count ascending, and the secondary sort is by decimal value ascending.\n    \"\"\"\n    return BitwiseSorter.sort_array(arr)"}
{"task_id": "HumanEval/116", "solution": "from src.sorter.utils import BitCounter\nclass ArraySorter:\n    def __init__(self):\n        \"\"\"Initializes the ArraySorter instance.\"\"\"\n        pass\n\n    def _validate_input(self, arr: list[int]) -> None:\n        \"\"\"Validates that the input is a list of integers.\n        Raises TypeError if the input is invalid.\"\"\"\n        if not isinstance(arr, list):\n            raise TypeError(\"Input must be a list.\")\n        for item in arr:\n            if not isinstance(item, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n\n    def _get_sort_key(self, num: int) -> tuple[int, int]:\n        \"\"\"Generates a custom sort key (set_bit_count, decimal_value) for an integer.\n        This key is used for the primary and secondary sorting criteria.\"\"\"\n        set_bit_count = BitCounter.count_set_bits(num)\n        return (set_bit_count, num)\n\n    def sort(self, arr: list[int]) -> list[int]:\n        \"\"\"Sorts an array of integers based on set bit count (ascending) then decimal value (ascending).\n        It returns a new list with the sorted elements.\"\"\"\n        self._validate_input(arr)\n        return sorted(arr, key=self._get_sort_key)\ndef sort_array(arr: list[int]) -> list[int]:\n    \"\"\"Sorts an array of integers by their set bit count, then by decimal value.\n    This function provides the main entry point for the sorting utility.\"\"\"\n    sorter = ArraySorter()\n    return sorter.sort(arr)"}
