{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers by alternately taking the minimum and then the maximum\n    of the remaining elements. Returns a new list in this strange order.\n    \"\"\"\n    if not lst:\n        return []\n\n    sorted_copy = sorted(lst)\n    result_list = []\n    left_ptr = 0\n    right_ptr = len(sorted_copy) - 1\n\n    while left_ptr <= right_ptr:\n        # Append minimum\n        result_list.append(sorted_copy[left_ptr])\n        left_ptr += 1\n\n        if left_ptr <= right_ptr:\n            # Append maximum\n            result_list.append(sorted_copy[right_ptr])\n            right_ptr -= 1\n    \n    return result_list"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    \n    INVALID_TRIANGLE_RETURN_VALUE = -1\n\n    def is_valid_triangle(s1: float, s2: float, s3: float) -> bool:\n        \"\"\"Checks if three side lengths can form a valid triangle.\n        It ensures all sides are positive and satisfy the triangle inequality theorem.\"\"\"\n        if s1 <= 0 or s2 <= 0 or s3 <= 0:\n            return False\n        return (s1 + s2 > s3) and (s1 + s3 > s2) and (s2 + s3 > s1)\n\n    if not is_valid_triangle(a, b, c):\n        return float(INVALID_TRIANGLE_RETURN_VALUE)\n\n    s = (a + b + c) / 2\n    area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q: list, w: (int | float)) -> bool:\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n\n    Example:\n    will_it_fly([1, 2], 5) \u279e False \n    # 1+2 is less than the maximum possible weight, but it's unbalanced.\n\n    will_it_fly([3, 2, 3], 1) \u279e False\n    # it's balanced, but 3+2+3 is more than the maximum possible weight.\n\n    will_it_fly([3, 2, 3], 9) \u279e True\n    # 3+2+3 is less than the maximum possible weight, and it's balanced.\n\n    will_it_fly([3], 5) \u279e True\n    # 3 is less than the maximum possible weight, and it's balanced.\n    '''\n    is_palindromic = q == q[::-1]\n    sum_elements = sum(q)\n    \n    return is_palindromic and (sum_elements <= w)"}
{"task_id": "HumanEval/71", "solution": "import math\nclass TriangleValidator:\n    @staticmethod\n    def is_valid(a: float, b: float, c: float) -> bool:\n        return (a + b > c) and (a + c > b) and (b + c > a)\nINVALID_TRIANGLE_CODE: int = -1\nclass TriangleService:\n    @staticmethod\n    def calculate_area(a: float, b: float, c: float) -> float:\n        if not TriangleValidator.is_valid(a, b, c):\n            return float(INVALID_TRIANGLE_CODE)\n\n        s = (a + b + c) / 2\n        area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n        return round(area, 2)\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    return TriangleService.calculate_area(a, b, c)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q, w):\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n\n    Example:\n    will_it_fly([1, 2], 5) \u279e False \n    # 1+2 is less than the maximum possible weight, but it's unbalanced.\n\n    will_it_fly([3, 2, 3], 1) \u279e False\n    # it's balanced, but 3+2+3 is more than the maximum possible weight.\n\n    will_it_fly([3, 2, 3], 9) \u279e True\n    # 3+2+3 is less than the maximum possible weight, and it's balanced.\n\n    will_it_fly([3], 5) \u279e True\n    # 3 is less than the maximum possible weight, and it's balanced.\n    '''\n    if not isinstance(q, list):\n        raise TypeError(\"Object 'q' must be a list.\")\n    if not isinstance(w, (int, float)):\n        raise TypeError(\"Weight 'w' must be a number.\")\n\n    # Check if q is a palindrome (balanced)\n    is_balanced = q == q[::-1]\n\n    # Calculate the sum of elements in q and check against maximum weight w\n    try:\n        total_weight = sum(q)\n    except TypeError:\n        raise TypeError(\"List 'q' must contain only numeric elements for summation.\")\n\n    is_within_weight = total_weight <= w\n\n    return is_balanced and is_within_weight"}
{"task_id": "HumanEval/63", "solution": "from typing import Dict\nclass FibFibCalculator:\n    \"\"\"Calculates FibFib numbers efficiently using memoization.\n    It stores previously computed values to avoid redundant calculations.\"\"\"\n    def __init__(self):\n        self._memo: Dict[int, int] = {\n            0: 0,\n            1: 0,\n            2: 1\n        }\n\n    def calculate(self, n: int) -> int:\n        \"\"\"Computes the n-th FibFib number, validating the input.\n        It raises ValueError for invalid inputs.\"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input 'n' cannot be negative.\")\n\n        return self._get_fibfib(n)\n\n    def _get_fibfib(self, n: int) -> int:\n        \"\"\"Recursive helper for FibFib calculation with memoization.\n        It retrieves from cache if available or computes and stores the result.\"\"\"\n        if n in self._memo:\n            return self._memo[n]\n\n        result = self._get_fibfib(n - 1) + self._get_fibfib(n - 2) + self._get_fibfib(n - 3)\n        self._memo[n] = result\n        return result\n_calculator = FibFibCalculator()\ndef fibfib(n: int) -> int:\n    \"\"\"Public function to compute the n-th FibFib number.\n    It uses an internal FibFibCalculator instance for efficient, memoized calculation.\"\"\"\n    return _calculator.calculate(n)"}
{"task_id": "HumanEval/73", "solution": "# src/palindromic_changer/core.py\n\nclass PalindromicArrayChanger:\n    \"\"\"\n    Encapsulates logic for determining changes to make an array palindromic.\n    This class provides a static method for calculating the minimum modifications.\n    \"\"\"\n\n    @staticmethod\n    def smallest_change(arr: list[int]) -> int:\n        \"\"\"\n        Calculates the minimum number of elements to change to make an array palindromic.\n        It validates input and compares elements from both ends of the array.\n        \"\"\"\n        if not isinstance(arr, list):\n            raise TypeError(\"Input must be a list.\")\n\n        for item in arr:\n            if not isinstance(item, int):\n                raise ValueError(\"All elements in the list must be integers.\")\n\n        n = len(arr)\n        if n <= 1:\n            return 0\n\n        changes = 0\n        left, right = 0, n - 1\n        while left < right:\n            if arr[left] != arr[right]:\n                changes += 1\n            left += 1\n            right -= 1\n        return changes"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    '''\n    Write a function that accepts two lists of strings and returns the list that has\n    total number of chars in the all strings of the list less than the other list.\n\n    if the two lists have the same number of chars, return the first list.\n\n    Examples\n    total_match([], []) \u279e []\n    total_match(['hi', 'admin'], ['hI', 'Hi']) \u279e ['hI', 'Hi']\n    total_match(['hi', 'admin'], ['hi', 'hi', 'admin', 'project']) \u279e ['hi', 'admin']\n    total_match(['hi', 'admin'], ['hI', 'hi', 'hi']) \u279e ['hI', 'hi', 'hi']\n    total_match(['4'], ['1', '2', '3', '4', '5']) \u279e ['4']\n    '''\n    total_chars_lst1 = sum(len(s) for s in lst1)\n    total_chars_lst2 = sum(len(s) for s in lst2)\n\n    if total_chars_lst1 <= total_chars_lst2:\n        return lst1\n    else:\n        return lst2"}
