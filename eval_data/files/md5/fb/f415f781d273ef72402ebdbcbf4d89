{"task_id": "HumanEval/76", "solution": "def is_simple_power(x: int, n: int) -> bool:\n    \"\"\"Checks if x is a simple power of n (n**k = x for integer k).\n    Raises TypeError if x or n are not integers.\n    \"\"\"\n    if not isinstance(x, int) or not isinstance(n, int):\n        raise TypeError(\"Inputs x and n must be integers.\")\n\n    if n == 0:\n        return x == 0 or x == 1 # Handles 0^0=1 and 0^k=0 for k>0.\n\n    if x == 0:\n        return False # If n is not 0, n**k cannot be 0 for integer k.\n\n    if x == 1:\n        return True # Any n (not 0) to the power of 0 is 1.\n\n    if n == 1:\n        return x == 1 # 1^k is always 1; so x must be 1.\n\n    if n == -1:\n        return x == 1 or x == -1 # (-1)^k is 1 for even k, -1 for odd k.\n\n    if x < 0 and n > 0:\n        return False # A positive base cannot produce a negative result.\n\n    # Iterate powers for general cases, avoiding floating point issues.\n    current_power = n\n    while True:\n        if current_power == x:\n            return True\n        \n        # Stop if magnitude exceeds x, preventing infinite loops or going past x.\n        if abs(current_power) > abs(x):\n            return False\n\n        current_power *= n"}
{"task_id": "HumanEval/78", "solution": "from .utils import HexDigitConverter\nfrom .constants import PRIME_HEX_DECIMAL_VALUES\nfrom .core import HexKeyCounter\nfrom .constants import PRIME_HEX_DECIMAL_VALUES\nPRIME_HEX_DECIMAL_VALUES = {2, 3, 5, 7, 11, 13}\nclass HexDigitConverter:\n    @staticmethod\n    def hex_to_decimal(hex_char: str) -> int:\n        \"\"\"Converts a single hexadecimal character to its decimal equivalent.\n        Assumes valid single hex character input.\"\"\"\n        return int(hex_char, 16)\n\n    @staticmethod\n    def is_prime_hex_value(decimal_value: int, prime_values: set[int]) -> bool:\n        \"\"\"Checks if a decimal value is present in the set of prime hexadecimal values.\n        This provides a quick lookup for primality.\"\"\"\n        return decimal_value in prime_values\nclass HexKeyCounter:\n    def __init__(self, prime_values: set[int] = None):\n        \"\"\"Initializes the HexKeyCounter with a set of prime hexadecimal values.\n        Defaults to predefined prime values if none are provided.\"\"\"\n        self._prime_hex_values = prime_values if prime_values is not None else PRIME_HEX_DECIMAL_VALUES\n\n    def count_primes(self, hex_string: str) -> int:\n        \"\"\"Counts the number of prime hexadecimal digits in the input string.\n        It iterates through each character, converts it to decimal, and checks for primality.\"\"\"\n        count = 0\n        for char in hex_string:\n            decimal_value = HexDigitConverter.hex_to_decimal(char)\n            if HexDigitConverter.is_prime_hex_value(decimal_value, self._prime_hex_values):\n                count += 1\n        return count\ndef hex_key(num: str) -> int:\n    \"\"\"Counts the number of prime hexadecimal digits in a given string.\n    This function serves as the public API entry point.\"\"\"\n    counter = HexKeyCounter(prime_values=PRIME_HEX_DECIMAL_VALUES)\n    return counter.count_primes(num)"}
