{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    '''\n    Write a function that accepts two lists of strings and returns the list that has\n    total number of chars in the all strings of the list less than the other list.\n\n    if the two lists have the same number of chars, return the first list.\n\n    Examples\n    total_match([], []) \u279e []\n    total_match(['hi', 'admin'], ['hI', 'Hi']) \u279e ['hI', 'Hi']\n    total_match(['hi', 'admin'], ['hi', 'hi', 'admin', 'project']) \u279e ['hi', 'admin']\n    total_match(['hi', 'admin'], ['hI', 'hi', 'hi']) \u279e ['hI', 'hi', 'hi']\n    total_match(['4'], ['1', '2', '3', '4', '5']) \u279e ['4']\n    '''\n\n    def _calculate_total_characters(str_list):\n        \"\"\"Calculates the total number of characters in a list of strings.\"\"\"\n        return sum(len(s) for s in str_list)\n\n    count1 = _calculate_total_characters(lst1)\n    count2 = _calculate_total_characters(lst2)\n\n    if count1 <= count2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    if a < 1:\n        return False\n\n    # Generate primes up to 'a' using a sieve.\n    # Since a < 100, generating primes up to 'a' is efficient enough for each call.\n    # For a = 99, we need primes up to 99.\n    limit = a\n    sieve = [True] * (limit + 1)\n    \n    # 0 and 1 are not prime numbers.\n    if limit >= 0:\n        sieve[0] = False\n    if limit >= 1:\n        sieve[1] = False\n            \n    # Apply the Sieve of Eratosthenes to mark non-primes.\n    for p in range(2, int(limit**0.5) + 1):\n        if sieve[p]:\n            for multiple in range(p * p, limit + 1, p):\n                sieve[multiple] = False\n    \n    primes = [i for i, is_p in enumerate(sieve) if is_p]\n\n    distinct_prime_factors = set()\n    temp_a = a\n\n    # Factorize 'a' by iterating through the list of primes.\n    for p in primes:\n        # Optimization: If p*p*p is already greater than the remaining temp_a,\n        # it's impossible for temp_a to have three distinct prime factors starting from p.\n        # This optimization is valid for checking distinct prime factors.\n        if p * p * p > temp_a and len(distinct_prime_factors) < 3:\n            break\n        \n        if temp_a % p == 0:\n            distinct_prime_factors.add(p)\n            # Remove all occurrences of p from temp_a.\n            while temp_a % p == 0:\n                temp_a //= p\n    \n    # If temp_a is still greater than 1 after dividing by all primes,\n    # the remaining temp_a must be a prime factor itself.\n    if temp_a > 1:\n        distinct_prime_factors.add(temp_a)\n\n    # Check if exactly three distinct prime factors were found.\n    return len(distinct_prime_factors) == 3"}
{"task_id": "HumanEval/75", "solution": "from typing import List\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\n    This inherits from ValueError to signify an issue with the input's value or type.\n    \"\"\"\n    pass\nclass PrimeUtils:\n    \"\"\"Utility class for prime number operations, including primality testing and factorization.\"\"\"\n\n    _primes_cache: List[int] = []\n    _max_cached_prime: int = 100  # Cache primes up to 100, aligning with problem constraints.\n    MAX_NUMBER_CHECK: int = 100\n\n    @classmethod\n    def _sieve_of_eratosthenes(cls, limit: int) -> None:\n        \"\"\"Generates primes up to 'limit' using Sieve of Eratosthenes and caches them.\"\"\"\n        if limit <= 1:\n            cls._primes_cache = []\n            return\n\n        is_prime_list = [True] * (limit + 1)\n        is_prime_list[0] = is_prime_list[1] = False\n\n        for p in range(2, int(limit**0.5) + 1):\n            if is_prime_list[p]:\n                for multiple in range(p * p, limit + 1, p):\n                    is_prime_list[multiple] = False\n\n        cls._primes_cache = [p for p, is_p in enumerate(is_prime_list) if is_p]\n        cls._max_cached_prime = limit\n\n    @classmethod\n    def is_prime(cls, n: int) -> bool:\n        \"\"\"Determines if a given integer 'n' is a prime number.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input must be an integer.\")\n        if n <= 1:\n            return False\n        \n        # Ensure cache is populated up to n if it hasn't been already.\n        if n > cls._max_cached_prime:\n            cls._sieve_of_eratosthenes(n)\n        elif not cls._primes_cache: # If cache is empty but limit is set, fill it.\n            cls._sieve_of_eratosthenes(cls._max_cached_prime)\n\n        return n in cls._primes_cache\n\n    @classmethod\n    def get_prime_factors(cls, n: int) -> List[int]:\n        \"\"\"Returns a list of prime factors for a given integer, including multiplicity.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input must be an integer.\")\n        if n <= 1:\n            return []\n\n        factors = []\n        temp_n = n\n\n        # Ensure primes cache is populated up to sqrt(n) for efficient trial division.\n        # Given n < 100, sqrt(n) < 10.\n        if not cls._primes_cache or int(n**0.5) + 1 > cls._max_cached_prime:\n            cls._sieve_of_eratosthenes(max(cls._max_cached_prime, int(n**0.5) + 1))\n\n        for prime in cls._primes_cache:\n            if prime * prime > temp_n:\n                break\n            while temp_n % prime == 0:\n                factors.append(prime)\n                temp_n //= prime\n        \n        if temp_n > 1: # Remaining temp_n is a prime factor itself.\n            factors.append(temp_n)\n            \n        return factors\nclass MultiplyPrimeChecker:\n    \"\"\"Core logic for checking if a number is a product of exactly three prime numbers.\"\"\"\n\n    @staticmethod\n    def is_multiply_prime(a: int) -> bool:\n        \"\"\"\n        Checks if the given number 'a' is the product of exactly three prime numbers.\n        It first validates input, then finds prime factors to count them.\n        \"\"\"\n        if not isinstance(a, int):\n            raise InvalidInputError(\"Input 'a' must be an integer.\")\n        if not (0 < a < 100):\n            raise InvalidInputError(\"Input 'a' must be greater than 0 and less than 100.\")\n\n        prime_factors = PrimeUtils.get_prime_factors(a)\n        return len(prime_factors) == 3\ndef is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    return MultiplyPrimeChecker.is_multiply_prime(a)"}
{"task_id": "HumanEval/77", "solution": "def iscube(a: int) -> bool:\n    '''\n    Write a function that takes an integer a and returns True \n    if this ingeger is a cube of some integer number.\n    Note: you may assume the input is always valid.\n    Examples:\n    iscube(1) ==> True\n    iscube(2) ==> False\n    iscube(-1) ==> True\n    iscube(64) ==> True\n    iscube(0) ==> True\n    iscube(180) ==> False\n    '''\n    if a == 0:\n        return True\n\n    sign = 1 if a > 0 else -1\n    abs_a = abs(a)\n\n    # Calculate the cube root using float power, then round to the nearest integer.\n    # This approach ensures accuracy for perfect cubes by comparing the final integer cube.\n    root_candidate = round(abs_a**(1/3))\n\n    # Check if the cube of the candidate, with the original sign, matches 'a'.\n    return sign * (root_candidate**3) == a"}
