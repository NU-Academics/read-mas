{"task_id": "HumanEval/37", "solution": "class ListSorter:\n    @staticmethod\n    def sort_even(l: list) -> list:\n        \"\"\"\n        This function takes a list l and returns a list l' such that\n        l' is identical to l in the odd indicies, while its values at the even indicies are equal\n        to the values of the even indicies of l, but sorted.\n        \"\"\"\n        if not isinstance(l, list):\n            raise TypeError(\"Input must be a list.\")\n\n        if not l:\n            return []\n\n        even_elements = []\n        for i in range(0, len(l), 2):\n            even_elements.append(l[i])\n\n        try:\n            even_elements.sort()\n        except TypeError as e:\n            raise TypeError(f\"Elements in the list are not sortable: {e}\")\n\n        result_list = l[:] # Creates a shallow copy of the input list.\n\n        even_idx_counter = 0\n        for i in range(0, len(l), 2):\n            result_list[i] = even_elements[even_idx_counter]\n            even_idx_counter += 1\n\n        return result_list"}
{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\nclass IntervalError(Exception):\n    \"\"\"Custom exception raised when an initial interval for bisection cannot be found.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\nclass Utils:\n    \"\"\"Utility functions for numerical operations.\"\"\"\n    @staticmethod\n    def sign(value: float) -> int:\n        \"\"\"Returns the sign of a numerical value (1 for positive, -1 for negative, 0 for zero).\"\"\"\n        if value > 0:\n            return 1\n        elif value < 0:\n            return -1\n        else:\n            return 0\nDEFAULT_SEARCH_RANGE: float = 100.0\nDEFAULT_SEARCH_STEP: float = 1.0\nTOLERANCE: float = 1e-6\nMAX_ITERATIONS: int = 1000\ndef _find_initial_interval(xs: list[float], search_range: float, step: float) -> tuple[float, float]:\n    \"\"\"\n    Searches for an initial interval [a, b] such that the polynomial has opposite signs at its ends.\n    It searches symmetrically around zero, both in positive and negative directions.\n    \"\"\"\n    # Search positive direction\n    for i in range(int(search_range / step) + 1):\n        x1 = i * step\n        x2 = (i + 1) * step\n        # Use the global poly function\n        if Utils.sign(poly(xs, x1)) != Utils.sign(poly(xs, x2)):\n            return x1, x2\n    \n    # Search negative direction\n    for i in range(int(search_range / step) + 1):\n        x1 = -i * step\n        x2 = -(i + 1) * step\n        # Ensure a < b for the returned interval.\n        # If poly(xs, x1) and poly(xs, x2) have opposite signs, the root is between x2 and x1.\n        # So the interval should be [x2, x1]\n        if Utils.sign(poly(xs, x1)) != Utils.sign(poly(xs, x2)):\n            return x2, x1 \n\n    raise IntervalError(f\"Could not find an initial interval within range [-{search_range}, {search_range}]\")\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    try:\n        # Use the helper function to find the initial interval\n        a, b = _find_initial_interval(xs, DEFAULT_SEARCH_RANGE, DEFAULT_SEARCH_STEP)\n    except IntervalError as e:\n        # As per problem statement, a solution is guaranteed.\n        # If an IntervalError occurs, it indicates a failure in finding an interval\n        # which goes against the problem's assumption.\n        # Re-raise as a ValueError for a clearer top-level error, linking to the original cause.\n        raise ValueError(f\"Failed to find a zero: {e.message}\") from e\n\n    # Bisection method logic, adapted from ZeroFinder.find_zero\n    for _ in range(MAX_ITERATIONS):\n        mid = (a + b) / 2\n        poly_a = poly(xs, a)\n        poly_mid = poly(xs, mid)\n\n        # Check for convergence\n        if abs(b - a) < TOLERANCE or poly_mid == 0.0:\n            return mid\n\n        # Update interval for bisection\n        if Utils.sign(poly_a) == Utils.sign(poly_mid):\n            a = mid\n        else:\n            b = mid\n    \n    # Returns the midpoint if max iterations are reached without desired tolerance.\n    return (a + b) / 2"}
