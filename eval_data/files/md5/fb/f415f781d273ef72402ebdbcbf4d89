{"task_id": "HumanEval/108", "solution": "# src/count_nums/utils.py\ndef _get_signed_digits(num: int) -> list[int]:\n    \"\"\"\n    Extracts digits from an integer, applying the signed digit rule for negative numbers.\n    E.g., -123 -> [-1, 2, 3].\n    \"\"\"\n    if num == 0:\n        return [0]\n    \n    s_num = str(num)\n    digits = []\n    if s_num[0] == '-':\n        digits.append(int(s_num[1]) * -1)\n        for digit_char in s_num[2:]:\n            digits.append(int(digit_char))\n    else:\n        for digit_char in s_num:\n            digits.append(int(digit_char))\n    return digits"}
{"task_id": "HumanEval/110", "solution": "class ExchangeService:\n    \"\"\"\n    Service class to determine if elements can be exchanged between two lists\n    to make the first list contain only even numbers.\n    \"\"\"\n    def exchange(self, lst1: list[int], lst2: list[int]) -> str:\n        \"\"\"\n        Determines whether it is possible to perform an exchange of elements\n        between lst1 and lst2 to make lst1 a list of only even numbers.\n        Returns \"YES\" if it is possible, \"NO\" otherwise.\n        \"\"\"\n        odd_count_lst1 = sum(1 for x in lst1 if x % 2 != 0)\n        even_count_lst2 = sum(1 for x in lst2 if x % 2 == 0)\n\n        if odd_count_lst1 <= even_count_lst2:\n            return \"YES\"\n        else:\n            return \"NO\""}
