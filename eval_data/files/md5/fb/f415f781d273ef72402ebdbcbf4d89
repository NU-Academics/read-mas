{"task_id": "HumanEval/157", "solution": "import numbers\nimport math\nfrom .models import TriangleSides\nclass TriangleSides:\n    \"\"\"\n    A data transfer object (DTO) to encapsulate the three side lengths of a triangle.\n    It validates that inputs are numeric upon instantiation.\n    \"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        # Validate that all inputs are numeric types.\n        if not all(isinstance(side, numbers.Number) for side in [a, b, c]):\n            raise TypeError(\"Side lengths must be numeric.\")\n        self.a = float(a)\n        self.b = float(b)\n        self.c = float(c)\n\n    def get_sides(self) -> tuple[float, float, float]:\n        \"\"\"Returns the three side lengths as a tuple.\"\"\"\n        return self.a, self.b, self.c\nclass TriangleChecker:\n    \"\"\"\n    Provides the core business logic to determine if a TriangleSides object represents a right-angled triangle.\n    It handles input validation for positivity and triangle inequality.\n    \"\"\"\n    _EPSILON: float = 1e-9\n\n    def __init__(self):\n        \"\"\"Initializes the TriangleChecker with a default epsilon value for float comparisons.\"\"\"\n        pass\n\n    def _is_valid_triangle(self, a: float, b: float, c: float) -> bool:\n        \"\"\"\n        Internal helper to validate if the three sides can form any valid triangle.\n        Checks for positive lengths and satisfies the triangle inequality theorem.\n        \"\"\"\n        if not (a > 0 and b > 0 and c > 0):\n            raise ValueError(\"Side lengths must be positive.\")\n        # Apply the Triangle Inequality Theorem.\n        if not (a + b > c and a + c > b and b + c > a):\n            return False\n        return True\n\n    def _is_pythagorean_triple(self, s1: float, s2: float, hypotenuse: float) -> bool:\n        \"\"\"\n        Internal helper to check if s1^2 + s2^2 is approximately equal to hypotenuse^2.\n        It uses math.isclose for robust floating-point comparison.\n        \"\"\"\n        return math.isclose(s1**2 + s2**2, hypotenuse**2, rel_tol=self._EPSILON)\n\n    def is_right_angle_triangle(self, sides: TriangleSides) -> bool:\n        \"\"\"\n        Determines if the given TriangleSides form a right-angled triangle.\n        It validates inputs and applies the Pythagorean theorem considering all permutations.\n        \"\"\"\n        a, b, c = sides.get_sides()\n\n        if not self._is_valid_triangle(a, b, c):\n            return False\n\n        # Check all permutations for the hypotenuse using the Pythagorean theorem.\n        if (self._is_pythagorean_triple(a, b, c) or\n                self._is_pythagorean_triple(a, c, b) or\n                self._is_pythagorean_triple(b, c, a)):\n            return True\n        return False\ndef right_angle_triangle(a: float, b: float, c: float) -> bool:\n    \"\"\"\n    Given the lengths of the three sides of a triangle, return True if they form a right-angled triangle.\n    This is a convenience function that wraps the TriangleChecker class for direct usage.\n    \"\"\"\n    checker = TriangleChecker()\n    sides = TriangleSides(a, b, c)\n    return checker.is_right_angle_triangle(sides)"}
{"task_id": "HumanEval/158", "solution": "from typing import List\nclass UniqueCharCounter:\n    \"\"\"\n    Provides a utility method to count the number of unique characters within a single string.\n    \"\"\"\n    @staticmethod\n    def count_unique_chars(s: str) -> int:\n        \"\"\"\n        Calculates and returns the number of unique characters in the given string.\n        \"\"\"\n        return len(set(s))\ndef find_max(words: List[str]) -> str:\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n\n    find_max([\"name\", \"of\", \"string\"]) == \"string\"\n    find_max([\"name\", \"enam\", \"game\"]) == \"enam\"\n    find_max([\"aaaaaaa\", \"bb\" ,\"cc\"]) == \"\"aaaaaaa\"\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = UniqueCharCounter.count_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Apply lexicographical tie-breaking rule.\n            # The check `result_word == \"\"` is for the very first word in a tie,\n            # ensuring it gets assigned if it's the first with max_unique_count.\n            # Otherwise, use lexicographical comparison.\n            if result_word == \"\" or word < result_word:\n                result_word = word\n    return result_word"}
{"task_id": "HumanEval/158", "solution": "# src/word_analyzer/analyzer.py\nclass WordAnalyzer:\n    @staticmethod\n    def find_max(words: list[str]) -> str:\n        \"\"\"\n        Returns the word with the maximum unique characters, applying lexicographical tie-breaking.\n        Returns an empty string if the input list is empty.\n        \"\"\"\n        if not words:\n            return \"\"\n\n        max_unique_count = -1\n        result_word = \"\"\n\n        for word in words:\n            current_unique_count = len(set(word))\n\n            if current_unique_count > max_unique_count:\n                max_unique_count = current_unique_count\n                result_word = word\n            elif current_unique_count == max_unique_count:\n                # Apply tie-breaking: select lexicographically smaller word.\n                if result_word == \"\" or word < result_word:\n                    result_word = word\n        return result_word"}
{"task_id": "HumanEval/147", "solution": "from collections import Counter\nclass TriplesCalculator:\n    \"\"\"\n    Encapsulates logic for generating arrays and efficiently counting valid triples.\n    Uses a cache to store generated arrays for improved performance on repeated calls.\n    \"\"\"\n    def __init__(self):\n        self._array_cache = {}\n\n    def calculate_triples(self, n: int) -> int:\n        \"\"\"\n        Orchestrates array generation and counts triples whose sum is a multiple of 3.\n        Raises ValueError if n is not a positive integer.\n        \"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise ValueError(\"Input 'n' must be a positive integer.\")\n        \n        if n < 3:\n            return 0 # Not enough elements to form a triple\n\n        arr = self._array_cache.get(n)\n        if arr is None:\n            arr = self._generate_array(n)\n            self._array_cache[n] = arr\n        \n        return self._count_valid_triples(arr)\n\n    def _generate_array(self, n: int) -> list[int]:\n        \"\"\"\n        Generates the array a where a[i] = i * i - i + 1 for i from 1 to n.\n        This operation is O(n).\n        \"\"\"\n        return [i * i - i + 1 for i in range(1, n + 1)]\n\n    def _get_remainder_counts(self, arr: list[int]) -> dict[int, int]:\n        \"\"\"\n        Calculates the frequency of elements based on their remainder when divided by 3.\n        This provides O(n) performance for initial categorization.\n        \"\"\"\n        remainder_counts = Counter(x % 3 for x in arr)\n        return {0: remainder_counts.get(0, 0),\n                1: remainder_counts.get(1, 0),\n                2: remainder_counts.get(2, 0)}\n\n    def _count_valid_triples(self, arr: list[int]) -> int:\n        \"\"\"\n        Counts triples (a[i], a[j], a[k]) with i < j < k such that their sum is a multiple of 3.\n        This method uses modular arithmetic for efficient O(1) counting after initial remainder categorization.\n        \"\"\"\n        counts = self._get_remainder_counts(arr)\n        c0, c1, c2 = counts[0], counts[1], counts[2]\n        \n        total_triples = 0\n        \n        # Case 1: (0, 0, 0) - all elements are multiples of 3 (sum % 3 == 0)\n        total_triples += c0 * (c0 - 1) * (c0 - 2) // 6\n        \n        # Case 2: (1, 1, 1) - all elements have remainder 1 (sum % 3 == 0)\n        total_triples += c1 * (c1 - 1) * (c1 - 2) // 6\n        \n        # Case 3: (2, 2, 2) - all elements have remainder 2 (sum % 3 == 6 % 3 == 0)\n        total_triples += c2 * (c2 - 1) * (c2 - 2) // 6\n        \n        # Case 4: (0, 1, 2) - one of each remainder (sum % 3 == (0+1+2) % 3 == 0)\n        total_triples += c0 * c1 * c2\n        \n        return total_triples\nclass TriplesService:\n    \"\"\"\n    Provides the public interface for calculating the number of valid triples.\n    Delegates the core computational logic to an instance of TriplesCalculator.\n    \"\"\"\n    def __init__(self):\n        self._calculator = TriplesCalculator()\n\n    def get_max_triples(self, n: int) -> int:\n        \"\"\"\n        Calculates and returns the count of valid triples for a given positive integer n.\n        Propagates ValueError from TriplesCalculator if n is invalid.\n        \"\"\"\n        return self._calculator.calculate_triples(n)\n_triples_service = TriplesService()\ndef get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, \n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation: \n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n    return _triples_service.get_max_triples(n)"}
