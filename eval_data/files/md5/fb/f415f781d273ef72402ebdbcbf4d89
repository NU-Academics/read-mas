x):\n            return 'No'\n\n        # Rule: Extension must be one of the allowed types.\n        if not self._check_extension(extension):\n            return 'No'\n\n        return 'Yes'\ndef file_name_check(file_name: str) -> str:\n    \"\"\"Convenience function to validate a file name directly.\n    It instantiates FileNameValidator and calls its validation method.\n    \"\"\"\n    validator = FileNameValidator()\n    return validator.file_name_check(file_name)"}
{"task_id": "HumanEval/142", "solution": "class SumProcessor:\n    \"\"\"\n    A utility class for processing a list of integers based on index-specific rules\n    and calculating their sum.\n    \"\"\"\n\n    @staticmethod\n    def sum_squares(lst: list[int]) -> int:\n        \"\"\"\n        Processes a list of integers, applying conditional transformations based on index.\n        Returns the sum of all processed entries.\n        \"\"\"\n        if not lst:\n            return 0\n\n        # Create a mutable copy to avoid modifying the original list.\n        processed_list = list(lst)\n        total_sum = 0\n\n        for i, num in enumerate(processed_list):\n            if i % 3 == 0:\n                processed_list[i] = num * num\n            elif i % 4 == 0:  # Implies i % 3 != 0 due to precedence rule.\n                processed_list[i] = num * num * num\n            # Else, num remains unchanged in processed_list.\n\n            total_sum += processed_list[i]\n\n        return total_sum"}
