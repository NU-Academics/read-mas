{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n: int) -> int:\n    \"\"\"\n    Counts n-digit positive integers that start or end with 1.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    if n == 1:\n        # The only 1-digit number is 1, which starts and ends with 1.\n        return 1\n\n    # Calculate counts using the Principle of Inclusion-Exclusion for n > 1.\n    count_starts_with_1 = 10**(n - 1)\n    count_ends_with_1 = 9 * (10**(n - 2))\n    count_starts_and_ends_with_1 = 10**(n - 2)\n\n    total_count = count_starts_with_1 + count_ends_with_1 - count_starts_and_ends_with_1\n    return total_count"}
{"task_id": "HumanEval/81", "solution": "# src/grade_converter.py\n\nclass GradeConverter:\n    # GRADING_SCALE defines the exclusive lower bound for each grade.\n    # It is ordered from highest GPA threshold to lowest.\n    GRADING_SCALE = [\n        (3.7, 'A'),\n        (3.3, 'A-'),\n        (3.0, 'B+'),\n        (2.7, 'B'),\n        (2.3, 'B-'),\n        (2.0, 'C+'),\n        (1.7, 'C'),\n        (1.3, 'C-'),\n        (1.0, 'D+'),\n        (0.7, 'D'),\n        (0.0, 'D-')\n    ]\n\n    def convert_gpa_to_letter_grade(self, gpa: float) -> str:\n        \"\"\"\n        Converts a single GPA to its corresponding letter grade.\n        Handles specific GPA values first, then uses the GRADING_SCALE for ranges.\n        \"\"\"\n        if gpa == 4.0:\n            return 'A+'\n        if gpa == 0.0:\n            return 'E'\n        \n        for threshold, grade in self.GRADING_SCALE:\n            if gpa > threshold:\n                return grade\n        \n        # Default for values not covered (e.g., negative GPAs).\n        return 'E' \n\n    def numerical_letter_grade(self, grades: list[float]) -> list[str]:\n        \"\"\"\n        Converts a list of GPAs to a list of letter grades.\n        Each GPA is processed individually using convert_gpa_to_letter_grade.\n        \"\"\"\n        return [self.convert_gpa_to_letter_grade(gpa) for gpa in grades]"}
{"task_id": "HumanEval/83", "solution": "# src/number_counter.py\nclass NumberCounter:\n    @staticmethod\n    def starts_one_ends(n: int) -> int:\n        \"\"\"\n        Calculates the count of n-digit positive integers that start or end with 1.\n        Raises ValueError if n is not a positive integer.\n        \"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise ValueError(\"Input 'n' must be a positive integer.\")\n\n        if n == 1:\n            # For n=1, only '1' starts or ends with 1.\n            return 1\n        else:\n            # Applies the inclusion-exclusion principle: (starts with 1) + (ends with 1) - (starts AND ends with 1).\n            # This simplifies to 18 * (10**(n - 2)) for n > 1.\n            return 18 * (10**(n - 2))"}
