{"task_id": "HumanEval/56", "solution": "class InvalidBracketStringError(ValueError):\n    \"\"\"Custom exception for invalid characters in bracket strings.\n    This is raised when input contains characters other than '<' or '>'.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nVALID_BRACKET_CHARS = {'<', '>'}\ndef correct_bracketing(brackets: str) -> bool:\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n\n    >>> correct_bracketing(\"<\")\n    False\n    >>> correct_bracketing(\"<>\")\n    True\n    >>> correct_bracketing(\"<<><>>\")\n    True\n    >>> correct_bracketing(\"><<>\")\n    False\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char not in VALID_BRACKET_CHARS:\n            # While the original problem description doesn't explicitly mention\n            # handling invalid characters, the design document specified\n            # raising an error for them. For a self-contained function\n            # matching the original docstring behavior, this part might be\n            # adjusted if strictly adhering to the prompt's examples which\n            # only show '<' and '>'. However, following the design, an error is raised.\n            raise InvalidBracketStringError(\n                f\"Invalid character '{char}' found in bracket string. Only '<' and '>' are allowed.\"\n            )\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \\\"<\\\" and \\\">\\\".\n    return True if every opening bracket has a corresponding closing bracket.\n\n    >>> correct_bracketing(\\\"<\\\")\n    False\n    >>> correct_bracketing(\\\"<>\\\")\n    True\n    >>> correct_bracketing(\\\"<<><>>\\\")\n    True\n    >>> correct_bracketing(\\\"><<>\\\")\n    False\n    \"\"\"\n    if not isinstance(brackets, str):\n        raise TypeError(\"Input 'brackets' must be a string.\")\n\n    balance_counter = 0\n    OPEN_BRACKET = '<'\n    CLOSE_BRACKET = '>'\n\n    for char in brackets:\n        if char == OPEN_BRACKET:\n            balance_counter += 1\n        elif char == CLOSE_BRACKET:\n            balance_counter -= 1\n        \n        # If the counter drops below zero, a closing bracket appeared before a matching opening one.\n        if balance_counter < 0:\n            return False\n\n    # The sequence is correctly bracketed if the final counter is zero.\n    return balance_counter == 0"}
{"task_id": "HumanEval/57", "solution": "from typing import List, Union\nclass MonotonicCheckerException(Exception):\n    \"\"\"Custom exception for MonotonicChecker errors.\"\"\"\n    pass\nclass MonotonicChecker:\n    \"\"\"\n    Provides methods to check for strict monotonicity in a list of numbers.\n    This class is stateless.\n    \"\"\"\n\n    def __init__(self):\n        pass\n\n    def _validate_input(self, l: List[Union[int, float]]) -> None:\n        \"\"\"Validates if the input is a list of numbers.\"\"\"\n        if not isinstance(l, list):\n            raise MonotonicCheckerException(\"Input must be a list.\")\n        for item in l:\n            if not isinstance(item, (int, float)):\n                raise MonotonicCheckerException(\"All list elements must be numbers.\")\n\n    def _is_strictly_increasing(self, l: List[Union[int, float]]) -> bool:\n        \"\"\"Checks if the list is strictly monotonically increasing.\"\"\"\n        if len(l) < 2:\n            return True\n        for i in range(len(l) - 1):\n            if l[i] >= l[i+1]:\n                return False\n        return True\n\n    def _is_strictly_decreasing(self, l: List[Union[int, float]]) -> bool:\n        \"\"\"Checks if the list is strictly monotonically decreasing.\"\"\"\n        if len(l) < 2:\n            return True\n        for i in range(len(l) - 1):\n            if l[i] <= l[i+1]:\n                return False\n        return True\n\n    def is_monotonic(self, l: List[Union[int, float]]) -> bool:\n        \"\"\"\n        Return True if list elements are strictly monotonically increasing or decreasing.\n        Handles empty lists and single-element lists as True.\n        \"\"\"\n        self._validate_input(l)\n\n        if len(l) <= 1:\n            return True\n\n        return self._is_strictly_increasing(l) or self._is_strictly_decreasing(l)\ndef monotonic(l: List[Union[int, float]]) -> bool:\n    \"\"\"\n    Return True if list elements are strictly monotonically increasing or decreasing.\n    This function utilizes the MonotonicChecker class.\n    \"\"\"\n    checker = MonotonicChecker()\n    return checker.is_monotonic(l)"}
{"task_id": "HumanEval/58", "solution": "from typing import List, Any\ndef common(l1: List[Any], l2: List[Any]) -> List[Any]:\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n\n    \"\"\"\n    if not isinstance(l1, list) or not isinstance(l2, list):\n        raise TypeError(\"Both inputs must be lists.\")\n\n    set1 = set(l1)\n    set2 = set(l2)\n\n    common_set = set1.intersection(set2)\n    result_list = list(common_set)\n    result_list.sort()\n\n    return result_list"}
{"task_id": "HumanEval/59", "solution": "class PrimeFactorService:\n    @staticmethod\n    def largest_prime_factor(n: int) -> int:\n        \"\"\"Calculates the largest prime factor of n. Assumes n > 1 and is not prime.\"\"\"\n        largest_factor = 1\n\n        # Handle factor 2 explicitly.\n        while n % 2 == 0:\n            largest_factor = 2\n            n //= 2\n\n        # Iterate through odd numbers up to sqrt(n).\n        i = 3\n        while i * i <= n:\n            while n % i == 0:\n                largest_factor = i\n                n //= i\n            i += 2\n\n        # If n is still greater than 2, it's the largest prime factor.\n        if n > 2:\n            largest_factor = n\n\n        return largest_factor"}
