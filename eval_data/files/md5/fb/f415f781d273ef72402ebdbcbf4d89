{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if two given parenthesis strings can be concatenated to form a balanced string.\n    Returns 'Yes' if possible, 'No' otherwise.\n    \"\"\"\n\n    VALID_PAREN_CHARS = \"()\"\n\n    def _validate_input(input_lst):\n        \"\"\"Validates the input list structure and content.\"\"\"\n        if not isinstance(input_lst, list) or len(input_lst) != 2:\n            raise ValueError(\"Input must be a list of exactly two strings.\")\n        for s in input_lst:\n            if not isinstance(s, str):\n                raise ValueError(\"All elements in the list must be strings.\")\n            if not all(char in VALID_PAREN_CHARS for char in s):\n                raise ValueError(f\"String '{s}' contains invalid characters. Only '(' and ')' are allowed.\")\n\n    def _is_balanced(s: str) -> bool:\n        \"\"\"Determines if a string of parentheses is balanced.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:  # char == ')'\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    _validate_input(lst)\n\n    s1, s2 = lst[0], lst[1]\n\n    # Check s1 + s2\n    if _is_balanced(s1 + s2):\n        return \"Yes\"\n\n    # Check s2 + s1\n    if _is_balanced(s2 + s1):\n        return \"Yes\"\n\n    return \"No\""}
{"task_id": "HumanEval/127", "solution": "import math\ndef _calculate_intersection_interval(interval1: tuple[int, int], interval2: tuple[int, int]) -> tuple[int, int] | None:\n    \"\"\"Calculates the intersection of two closed intervals.\n    Returns the intersection (start, end) or None if no intersection.\"\"\"\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    max_start = max(start1, start2)\n    min_end = min(end1, end2)\n\n    if max_start <= min_end:\n        return (max_start, min_end)\n    else:\n        return None\ndef _calculate_length(interval: tuple[int, int]) -> int:\n    \"\"\"Calculates the length of a closed interval.\n    The length is determined as end - start + 1.\"\"\"\n    start, end = interval\n    return end - start + 1\ndef _is_prime(n: int) -> bool:\n    \"\"\"Checks if a non-negative integer is a prime number.\n    It uses an optimized trial division method.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    # Check for divisors from 3 up to sqrt(n), incrementing by 2.\n    for i in range(3, math.isqrt(n) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\ndef intersection(interval1: tuple[int, int], interval2: tuple[int, int]) -> str:\n    \"\"\"Determines if the length of the intersection of two closed intervals is a prime number.\n    Returns \"YES\" if the length is prime, otherwise \"NO\".\"\"\"\n    intersect_interval = _calculate_intersection_interval(interval1, interval2)\n\n    if intersect_interval is None:\n        return \"NO\"\n    else:\n        length = _calculate_length(intersect_interval)\n        if _is_prime(length):\n            return \"YES\"\n        else:\n            return \"NO\""}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr: list[int]) -> int | None:\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n\n    Example:\n    >>> prod_signs([1, 2, 2, -4]) == -9\n    >>> prod_signs([0, 1]) == 0\n    >>> prod_signs([]) == None\n    \"\"\"\n    if not arr:\n        return None\n\n    def _calculate_sign_product(arr: list[int]) -> int:\n        \"\"\"Calculates the product of signs for all numbers in the array. Returns 0 if any number is zero.\"\"\"\n        sign_product = 1\n        for n in arr:\n            if n == 0:\n                return 0\n            elif n < 0:\n                sign_product *= -1\n        return sign_product\n\n    def _calculate_magnitude_sum(arr: list[int]) -> int:\n        \"\"\"Calculates the sum of magnitudes for all numbers in the array.\"\"\"\n        magnitude_sum = 0\n        for n in arr:\n            magnitude_sum += abs(n)\n        return magnitude_sum\n\n    sign_product = _calculate_sign_product(arr)\n    magnitude_sum = _calculate_magnitude_sum(arr)\n\n    return sign_product * magnitude_sum"}
