{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\"\n    For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n <= 1:\n        raise ValueError(\"Input 'n' must be greater than 1.\")\n\n    # Iterate downwards from n // 2 to find the largest divisor.\n    for i in range(n // 2, 0, -1):\n        if n % i == 0:\n            return i\n    return 1  # For prime numbers, 1 is the largest proper divisor."}
{"task_id": "HumanEval/19", "solution": "from src.constants import WORD_TO_INT_MAP, INT_TO_WORD_MAP\nfrom src.number_word_converter import NumberWordConverter, NumberWordMapping\nWORD_TO_INT_MAP: dict[str, int] = {\n    \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n    \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n}\nINT_TO_WORD_MAP: dict[int, str] = {\n    0: \"zero\", 1: \"one\", 2: \"two\", 3: \"three\", 4: \"four\",\n    5: \"five\", 6: \"six\", 7: \"seven\", 8: \"eight\", 9: \"nine\"\n}\nclass NumberWordMapping:\n    \"\"\"Stores the immutable mappings between number words and integers.\"\"\"\n    def __init__(self):\n        self.WORD_TO_INT_MAP = WORD_TO_INT_MAP\n        self.INT_TO_WORD_MAP = INT_TO_WORD_MAP\nclass NumberWordConverter:\n    \"\"\"Provides methods to convert between number words (e.g., 'one') and their integer equivalents (e.g., 1).\"\"\"\n    def __init__(self, mapping: NumberWordMapping):\n        self._mapping = mapping\n\n    def word_to_int(self, word: str) -> int | None:\n        \"\"\"Converts a number word to its integer equivalent, handling case-insensitivity.\n        Returns the integer or None if the word is not found.\"\"\"\n        return self._mapping.WORD_TO_INT_MAP.get(word.lower())\n\n    def int_to_word(self, num: int) -> str | None:\n        \"\"\"Converts an integer to its number word equivalent.\n        Returns the word or None if the integer is not found.\"\"\"\n        return self._mapping.INT_TO_WORD_MAP.get(num)\nclass NumberSorterService:\n    \"\"\"Orchestrates sorting number words by converting them to integers, sorting, and converting back.\"\"\"\n    def __init__(self, converter: NumberWordConverter):\n        self._converter = converter\n\n    def sort_numbers(self, numbers: str) -> str:\n        \"\"\"Takes a space-delimited string of number words, sorts them numerically, and returns a sorted string.\n        Invalid words are ignored during conversion.\"\"\"\n        if not numbers:\n            return \"\"\n\n        word_list = numbers.split(' ')\n        \n        int_list = []\n        for word in word_list:\n            num = self._converter.word_to_int(word)\n            if num is not None:\n                int_list.append(num)\n        \n        int_list.sort()\n        \n        sorted_word_list = []\n        for num in int_list:\n            word = self._converter.int_to_word(num)\n            if word is not None: # Should not be None if ints are from 0-9\n                sorted_word_list.append(word)\n        \n        return ' '.join(sorted_word_list)\n_number_word_mapping = NumberWordMapping()\n_number_word_converter = NumberWordConverter(_number_word_mapping)\n_number_sorter_service = NumberSorterService(_number_word_converter)\ndef sort_numbers(numbers: str) -> str:\n    \"\"\"Sorts a space-delimited string of number words (e.g., 'zero' to 'nine') numerically.\n    Invalid words are ignored, and the output is a space-delimited string of sorted words.\"\"\"\n    return _number_sorter_service.sort_numbers(numbers)"}
{"task_id": "HumanEval/26", "solution": "from typing import List\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\"Removes elements that occur more than once from a list of integers.\n    Preserves the relative order of the remaining unique elements.\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n    return result"}
