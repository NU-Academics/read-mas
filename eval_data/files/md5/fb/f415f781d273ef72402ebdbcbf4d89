{"task_id": "HumanEval/163", "solution": "# src/integer_generator.py\nclass IntegerGenerator:\n    \"\"\"\n    A utility class for generating even single-digit integers within a specified range.\n    \"\"\"\n\n    @staticmethod\n    def generate_integers(a: int, b: int) -> list[int]:\n        \"\"\"\n        Given two positive integers a and b, return the even single-digit numbers\n        between a and b (inclusive), in ascending order.\n        \"\"\"\n        start = min(a, b)\n        end = max(a, b)\n        result = []\n        for i in range(start, end + 1):\n            # Check if the number is both even and a single-digit (0-9).\n            if 0 <= i <= 9 and i % 2 == 0:\n                result.append(i)\n        return result"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    def _is_even_digit(num: int) -> bool:\n        \"\"\"Checks if a number is an even digit (0, 2, 4, 6, 8).\"\"\"\n        return 0 <= num <= 8 and num % 2 == 0\n\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise ValueError(\"Inputs 'a' and 'b' must be integers.\")\n    if a < 0 or b < 0:\n        raise ValueError(\"Inputs 'a' and 'b' must be positive integers.\")\n\n    start = min(a, b)\n    end = max(a, b)\n\n    even_digits = set()\n    for i in range(start, end + 1):\n        if _is_even_digit(i):\n            even_digits.add(i)\n\n    return sorted(list(even_digits))"}
