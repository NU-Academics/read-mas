{"task_id": "HumanEval/93", "solution": "class EncoderService:\n    VOWELS_LOWER = {'a', 'e', 'i', 'o', 'u'}\n    VOWELS_UPPER = {'A', 'E', 'I', 'O', 'U'}\n\n    def encode(self, message: str) -> str:\n        \"\"\"\n        Encodes a message by swapping case of letters and shifting vowels.\n        Non-alphabetic characters are preserved.\n        \"\"\"\n        encoded_chars = []\n        for char in message:\n            if char.isalpha():\n                swapped_char = self._swap_case(char)\n                if swapped_char in self.VOWELS_LOWER or swapped_char in self.VOWELS_UPPER:\n                    shifted_char = self._shift_vowel(swapped_char)\n                    encoded_chars.append(shifted_char)\n                else:\n                    encoded_chars.append(swapped_char)\n            else:\n                encoded_chars.append(char)\n        return \"\".join(encoded_chars)\n\n    def _swap_case(self, char: str) -> str:\n        \"\"\"\n        Swaps the case of a single alphabetic character.\n        Lowercase becomes uppercase, and vice versa.\n        \"\"\"\n        return char.swapcase()\n\n    def _shift_vowel(self, char: str) -> str:\n        \"\"\"\n        Shifts a vowel character two places forward in the alphabet.\n        This is done by adding 2 to its ASCII value.\n        \"\"\"\n        return chr(ord(char) + 2)"}
