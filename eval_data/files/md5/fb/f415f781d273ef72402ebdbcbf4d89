{"task_id": "HumanEval/87", "solution": "class ListFinder:\n    @staticmethod\n    def get_row(lst: list[list[int]], x: int) -> list[tuple[int, int]]:\n        \"\"\"\n        Finds all occurrences of 'x' in a nested list 'lst' and returns their\n        0-indexed (row, column) coordinates.\n        The results are sorted first by row (ascending) then by column (descending).\n        \"\"\"\n        if not isinstance(lst, list):\n            raise TypeError(\"Input 'lst' must be a list.\")\n        if not isinstance(x, int):\n            raise TypeError(\"Input 'x' must be an integer.\")\n\n        found_coordinates: list[tuple[int, int]] = []\n\n        for row_idx, row in enumerate(lst):\n            if not isinstance(row, list):\n                continue # Skips non-list rows.\n            for col_idx, element in enumerate(row):\n                if not isinstance(element, int):\n                    continue # Skips non-integer elements.\n                if element == x:\n                    found_coordinates.append((row_idx, col_idx))\n\n        # Sort by row (ascending) then by column (descending).\n        found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n        return found_coordinates"}
{"task_id": "HumanEval/98", "solution": "UPPERCASE_VOWELS = {'A', 'E', 'I', 'O', 'U'}\ndef count_upper(s):\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n    \n    For example:\n    count_upper('aBCdEf') returns 1\n    count_upper('abcdefg') returns 0\n    count_upper('dBBE') returns 0\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input 's' must be a string.\")\n\n    count = 0\n    for i, char in enumerate(s):\n        if i % 2 == 0 and char in UPPERCASE_VOWELS:\n            count += 1\n    return count"}
{"task_id": "HumanEval/99", "solution": "import math\ndef closest_integer(value: str) -> int:\n    \"\"\"\n    Takes a string representing a number and returns the closest integer.\n    If equidistant, it rounds away from zero.\n    \"\"\"\n    try:\n        num = float(value)\n    except ValueError:\n        raise ValueError(f\"Invalid input: '{value}' is not a valid number.\")\n\n    floor_num = math.floor(num)\n    ceil_num = math.ceil(num)\n\n    if num == floor_num:\n        return int(num)\n\n    dist_to_floor = abs(num - floor_num)\n    dist_to_ceil = abs(num - ceil_num)\n\n    if dist_to_floor == dist_to_ceil:\n        # Equidistant, round away from zero.\n        return int(ceil_num) if num > 0 else int(floor_num)\n    elif dist_to_floor < dist_to_ceil:\n        return int(floor_num)\n    else:\n        return int(ceil_num)"}
{"task_id": "HumanEval/98", "solution": "# src/string_utils.py\nclass StringUtils:\n    \"\"\"Provides utility methods for string manipulation and analysis.\"\"\"\n    UPPERCASE_VOWELS = {'A', 'E', 'I', 'O', 'U'}\n\n    @staticmethod\n    def count_upper(s: str) -> int:\n        \"\"\"\n        Counts uppercase vowels at even indices in a string.\n        It iterates through the string, checking index parity and character type.\n        \"\"\"\n        count = 0\n        for i, char in enumerate(s):\n            if i % 2 == 0 and char in StringUtils.UPPERCASE_VOWELS:\n                count += 1\n        return count"}
{"task_id": "HumanEval/99", "solution": "import math\ndef closest_integer(value):\n    '''\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n\n    Examples\n    >>> closest_integer(\"10\")\n    10\n    >>> closest_integer(\"15.3\")\n    15\n\n    Note:\n    Rounding away from zero means that if the given number is equidistant\n    from two integers, the one you should return is the one that is the\n    farthest from zero. For example closest_integer(\"14.5\") should\n    return 15 and closest_integer(\"-14.5\") should return -15.\n    '''\n    num_float = float(value)\n    \n    # Determine the two closest integers\n    floor_val = math.floor(num_float)\n    ceil_val = math.ceil(num_float)\n    \n    # Calculate distances\n    dist_to_floor = abs(num_float - floor_val)\n    dist_to_ceil = abs(num_float - ceil_val)\n    \n    if dist_to_floor == dist_to_ceil: # Equidistant case (e.g., X.5)\n        if num_float >= 0:\n            return int(ceil_val) # Round up for positive .5\n        else:\n            return int(floor_val) # Round down for negative .5 (away from zero)\n    elif dist_to_floor < dist_to_ceil:\n        return int(floor_val)\n    else: # dist_to_ceil < dist_to_floor\n        return int(ceil_val)"}
