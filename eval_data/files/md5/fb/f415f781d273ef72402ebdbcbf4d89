{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all\n    elements that hasn't any even digit.\n\n    Note: Returned list should be sorted in increasing order.\n\n    For example:\n    >>> unique_digits([15, 33, 1422, 1])\n    [1, 15, 33]\n    >>> unique_digits([152, 323, 1422, 10])\n    []\n    \"\"\"\n    def has_even_digit(number: int) -> bool:\n        \"\"\"Checks if the given number contains any even digit.\"\"\"\n        for digit_char in str(number):\n            digit = int(digit_char)\n            if digit % 2 == 0:\n                return True\n        return False\n\n    filtered_list = []\n    for num in x:\n        if not has_even_digit(num):\n            filtered_list.append(num)\n\n    filtered_list.sort()\n    return filtered_list"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"You are given two positive integers n and m, and your task is to compute the\n    average of the integers from n through m (including n and m).\n    Round the answer to the nearest integer and convert that to binary.\n    If n is greater than m, return -1.\n    Example:\n    rounded_avg(1, 5) => \"0b11\"\n    rounded_avg(7, 5) => -1\n    rounded_avg(10, 20) => \"0b1111\"\n    rounded_avg(20, 33) => \"0b11010\"\n    \"\"\"\n    if n > m:\n        return -1\n\n    # Calculate the sum of integers from n to m using the arithmetic series formula.\n    # The count of numbers in the range [n, m] is (m - n + 1).\n    # The sum is (count * (first_term + last_term)) // 2.\n    sum_val = (m - n + 1) * (n + m) // 2\n\n    # Calculate the count of integers in the range [n, m].\n    count_val = m - n + 1\n\n    # Compute the average.\n    average = sum_val / count_val\n\n    # Round the average to the nearest integer.\n    # Python's round() function rounds halves to the nearest even integer.\n    rounded_average = round(average)\n\n    # Convert the rounded integer average to its binary string representation.\n    return bin(rounded_average)"}
{"task_id": "HumanEval/104", "solution": "from src.validators import DigitValidator\nclass UniqueDigitsFilter:\n    \"\"\"\n    Filters a list of numbers, keeping only those with all odd digits, and sorts them.\n    This class handles the core business logic and input validation.\n    \"\"\"\n    def __init__(self, digit_validator: DigitValidator = None):\n        \"\"\"\n        Initializes the filter with a DigitValidator instance.\n        If none is provided, a default one is created.\n        \"\"\"\n        self._digit_validator = digit_validator if digit_validator is not None else DigitValidator()\n\n    def filter_and_sort(self, numbers: list[int]) -> list[int]:\n        \"\"\"\n        Given a list of positive integers, returns a sorted list of all\n        elements that haven't any even digit.\n        \"\"\"\n        if not isinstance(numbers, list):\n            raise TypeError(\"Input 'numbers' must be a list.\")\n\n        filtered_numbers = []\n        for num in numbers:\n            if not self._digit_validator.is_positive_integer(num):\n                raise ValueError(f\"All elements in the list must be positive integers. Found: {num}\")\n            \n            if not self._digit_validator.has_even_digit(num):\n                filtered_numbers.append(num)\n        \n        return sorted(filtered_numbers)\ndef unique_digits(x: list[int]) -> list[int]:\n    \"\"\"\n    Given a list of positive integers x. return a sorted list of all \n    elements that hasn't any even digit.\n\n    Note: Returned list should be sorted in increasing order.\n    \n    For example:\n    >>> unique_digits([15, 33, 1422, 1])\n    [1, 15, 33]\n    >>> unique_digits([152, 323, 1422, 10])\n    []\n    \"\"\"\n    filter_service = UniqueDigitsFilter()\n    return filter_service.filter_and_sort(x)"}
