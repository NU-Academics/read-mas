{"task_id": "HumanEval/91", "solution": "from .sentence_splitter import SentenceSplitter\nclass BoredomCounter:\n    \"\"\"Encapsulates logic for identifying and counting \"boredom\" sentences.\"\"\"\n    def __init__(self, sentence_splitter: SentenceSplitter = None):\n        \"\"\"Initializes the counter with an optional SentenceSplitter instance.\"\"\"\n        self._sentence_splitter = sentence_splitter if sentence_splitter else SentenceSplitter()\n\n    def count(self, text: str) -> int:\n        \"\"\"Counts the number of sentences starting with \"I\" in the provided text.\"\"\"\n        sentences = self._sentence_splitter.split(text)\n        boredom_count = 0\n        for sentence in sentences:\n            if self._is_bored_sentence(sentence):\n                boredom_count += 1\n        return boredom_count\n\n    def _is_bored_sentence(self, sentence: str) -> bool:\n        \"\"\"Checks if a single sentence starts with \"I\" (case-sensitive and as a whole word).\"\"\"\n        cleaned_sentence = sentence.lstrip()\n        return cleaned_sentence.startswith(\"I \") or cleaned_sentence == \"I\"\ndef is_bored(S: str) -> int:\n    \"\"\"Public entry point to count \"boredom\" sentences in an input string.\"\"\"\n    if not isinstance(S, str):\n        raise TypeError(\"Input must be a string.\")\n    if not S:\n        return 0\n    \n    counter = BoredomCounter()\n    return counter.count(S)"}
