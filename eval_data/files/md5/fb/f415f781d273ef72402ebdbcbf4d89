{"task_id": "HumanEval/35", "solution": "from typing import List, TypeVar, Union\nComparable = TypeVar('Comparable', bound=Union[int, float, str])\ndef max_element(l: List[Comparable]) -> Comparable:\n    \"\"\"\n    Finds and returns the maximum element in a list.\n\n    Args:\n        l: A list of comparable elements (e.g., int, float, str).\n\n    Returns:\n        The maximum element in the list.\n\n    Raises:\n        ValueError: If the input list is empty.\n\n    Examples:\n        >>> max_element([1, 5, 2, 8, 3])\n        8\n        >>> max_element([-10, -5, -20])\n        -5\n        >>> max_element([3.14, 2.71, 1.618])\n        3.14\n        >>> max_element(['apple', 'banana', 'cherry'])\n        'cherry'\n        >>> max_element([7])\n        7\n    \"\"\"\n    if not l:\n        raise ValueError(\"Input list cannot be empty\")\n\n    max_val = l[0]\n    for element in l[1:]:\n        if element > max_val:\n            max_val = element\n    return max_val"}
{"task_id": "HumanEval/48", "solution": "import re\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input types or values in palindrome checker functions.\"\"\"\n    pass\nclass StringNormalizer:\n    \"\"\"\n    Provides utility methods for normalizing strings.\n    It converts text to lowercase and removes non-alphanumeric characters.\n    \"\"\"\n    def normalize_string(self, text: str) -> str:\n        \"\"\"\n        Converts the input string to lowercase and removes all non-alphanumeric characters.\n        Raises InvalidInputError if the input is not a string.\n        \"\"\"\n        if not isinstance(text, str):\n            raise InvalidInputError(\"Input must be a string.\")\n        # Convert to lowercase and remove non-alphanumeric characters.\n        normalized_text = re.sub(r'[^a-zA-Z0-9]', '', text).lower()\n        return normalized_text\nclass PalindromeService:\n    \"\"\"\n    Service for checking if a string is a palindrome.\n    It utilizes a StringNormalizer to prepare the input string.\n    \"\"\"\n    def __init__(self, normalizer: StringNormalizer):\n        \"\"\"\n        Initializes the PalindromeService with a StringNormalizer instance.\n        \"\"\"\n        self._normalizer = normalizer\n\n    def is_palindrome(self, text: str) -> bool:\n        \"\"\"\n        Determines if the given string is a palindrome, ignoring case and non-alphanumeric characters.\n        Raises InvalidInputError if the input text is not a string.\n        \"\"\"\n        try:\n            normalized_text = self._normalizer.normalize_string(text)\n        except InvalidInputError:\n            raise # Re-raises the caught InvalidInputError for consistency.\n\n        return normalized_text == normalized_text[::-1]\n_string_normalizer = StringNormalizer()\n_palindrome_service = PalindromeService(_string_normalizer)\ndef is_palindrome(text: str) -> bool:\n    \"\"\"\n    Checks if given string is a palindrome, ignoring case and non-alphanumeric characters.\n\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    >>> is_palindrome('A man, a plan, a canal: Panama')\n    True\n    >>> is_palindrome('12321')\n    True\n    >>> try:\n    ...     is_palindrome(123)\n    ... except TypeError as e:\n    ...     print(e)\n    Input must be a string.\n    \"\"\"\n    try:\n        return _palindrome_service.is_palindrome(text)\n    except InvalidInputError as e:\n        # Re-raise InvalidInputError as TypeError to match the original FR1 error handling.\n        raise TypeError(e) from e"}
{"task_id": "HumanEval/51", "solution": "class VowelRemoverService:\n    \"\"\"\n    Service for removing vowels from strings.\n    Utilizes a set for efficient vowel lookup.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    @staticmethod\n    def remove_vowels(text: str) -> str:\n        \"\"\"\n        Removes all occurrences of English vowels (case-insensitive) from the input string.\n        Preserves the order of non-vowel characters and handles empty strings.\n        \"\"\"\n        if not isinstance(text, str):\n            raise TypeError(\"Input must be a string.\")\n        return ''.join(char for char in text if char not in VowelRemoverService.VOWELS)"}
