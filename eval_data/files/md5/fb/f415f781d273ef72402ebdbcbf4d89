{"task_id": "HumanEval/105", "solution": "DIGIT_TO_WORD_MAP = {\n    1: \"One\",\n    2: \"Two\",\n    3: \"Three\",\n    4: \"Four\",\n    5: \"Five\",\n    6: \"Six\",\n    7: \"Seven\",\n    8: \"Eight\",\n    9: \"Nine\",\n}\nclass NumberValidator:\n    def is_valid_digit(self, num: int) -> bool:\n        \"\"\"Checks if an integer is between 1 and 9 inclusive.\"\"\"\n        return 1 <= num <= 9\nclass DigitWordService:\n    def __init__(self, digit_to_word_map: dict[int, str]):\n        \"\"\"Initializes the service with a digit-to-word mapping.\"\"\"\n        self._digit_to_word_map = digit_to_word_map\n\n    def convert_to_word(self, digit: int) -> str:\n        \"\"\"Retrieves the English word name for a given digit.\"\"\"\n        return self._digit_to_word_map[digit]\nclass ArrayProcessor:\n    def __init__(self, number_validator: NumberValidator, digit_word_service: DigitWordService):\n        \"\"\"Initializes ArrayProcessor with required validator and service.\"\"\"\n        self._number_validator = number_validator\n        self._digit_word_service = digit_word_service\n\n    def by_length(self, arr: list[int]) -> list[str]:\n        \"\"\"\n        Filters an array for digits 1-9, sorts, reverses, and converts to word names.\n        Returns an empty list if no valid digits are found or the input is empty.\n        \"\"\"\n        if not arr:\n            return []\n\n        # FR1: Filter an input array to include only integers between 1 and 9 inclusive.\n        filtered_digits = [\n            num for num in arr if self._number_validator.is_valid_digit(num)\n        ]\n\n        # FR5: Return an empty array if the input array is empty or contains no valid numbers.\n        if not filtered_digits:\n            return []\n\n        # FR2: Sort the filtered integers in ascending order.\n        sorted_digits = sorted(filtered_digits)\n        # FR3: Reverse the sorted array.\n        reversed_digits = sorted_digits[::-1]\n\n        # FR4: Replace each integer with its corresponding English word name.\n        word_names = [self._digit_word_service.convert_to_word(digit) for digit in reversed_digits]\n\n        return word_names\ndef by_length(arr: list[int]) -> list[str]:\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name from\n    \"One\", \"Two\", \"Three\", \"Four\", \"Five\", \"Six\", \"Seven\", \"Eight\", \"Nine\".\n\n    For example:\n      arr = [2, 1, 1, 4, 5, 8, 2, 3]\n            -> sort arr -> [1, 1, 2, 2, 3, 4, 5, 8]\n            -> reverse arr -> [8, 5, 4, 3, 2, 2, 1, 1]\n      return [\"Eight\", \"Five\", \"Four\", \"Three\", \"Two\", \"Two\", \"One\", \"One\"]\n\n      If the array is empty, return an empty array:\n      arr = []\n      return []\n\n      If the array has any strange number ignore it:\n      arr = [1, -1 , 55]\n            -> sort arr -> [-1, 1, 55]\n            -> reverse arr -> [55, 1, -1]\n      return = ['One']\n    \"\"\"\n    validator = NumberValidator()\n    converter = DigitWordService(DIGIT_TO_WORD_MAP)\n    processor = ArrayProcessor(validator, converter)\n    return processor.by_length(arr)"}
{"task_id": "HumanEval/106", "solution": "# src/math_operations/calculations.py\nclass CalculationsService:\n    \"\"\"Provides core mathematical functions for sequence generation.\n    All methods are static and perform specific calculations as defined.\"\"\"\n\n    @staticmethod\n    def _factorial(i: int) -> int:\n        \"\"\"Calculates the factorial of a non-negative integer.\n        Raises ValueError for negative inputs or TypeError for non-integers.\"\"\"\n        if not isinstance(i, int):\n            raise TypeError(\"Input must be an integer.\")\n        if i < 0:\n            raise ValueError(\"Factorial is not defined for negative numbers.\")\n        if i == 0 or i == 1:\n            return 1\n        res = 1\n        for num in range(2, i + 1):\n            res *= num\n        return res\n\n    @staticmethod\n    def _sum_up_to(i: int) -> int:\n        \"\"\"Calculates the sum of numbers from 1 to a non-negative integer.\n        Raises ValueError for negative inputs or TypeError for non-integers.\"\"\"\n        if not isinstance(i, int):\n            raise TypeError(\"Input must be an integer.\")\n        if i < 0:\n            raise ValueError(\"Sum up to is not defined for negative numbers in this context.\")\n        if i == 0:\n            return 0\n        return i * (i + 1) // 2\n\n    @staticmethod\n    def f(n: int) -> list[int]:\n        \"\"\"Generates a list of n calculated values based on index parity.\n        Even indices get factorial, odd get sum up to; returns an empty list if n <= 0.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if n <= 0:\n            return []\n\n        result = []\n        for i in range(1, n + 1):\n            if i % 2 == 0:  # Even index\n                result.append(CalculationsService._factorial(i))\n            else:  # Odd index\n                result.append(CalculationsService._sum_up_to(i))\n        return result"}
{"task_id": "HumanEval/106", "solution": "from typing import List\nfrom src.utils import MathUtils\nclass FactorialSumCalculator:\n    \"\"\"Orchestrates list generation based on index parity using MathUtils.\"\"\"\n\n    def __init__(self):\n        \"\"\"Initializes the calculator with a MathUtils instance.\"\"\"\n        self._math_utils = MathUtils()\n\n    def calculate_list(self, n: int) -> List[int]:\n        \"\"\"Generates a list of size n, applying factorial or sum based on index parity.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input 'n' cannot be negative.\")\n\n        result_list = []\n        for i in range(1, n + 1):  # Indices start from 1\n            if i % 2 == 0:  # Even index\n                result_list.append(self._math_utils.factorial(i))\n            else:  # Odd index\n                result_list.append(self._math_utils.sum_up_to(i))\n        return result_list\ndef f(n: int) -> List[int]:\n    \"\"\"Utility function to generate a list based on index parity, mirroring the problem's f(n).\"\"\"\n    calculator = FactorialSumCalculator()\n    return calculator.calculate_list(n)"}
