{"task_id": "HumanEval/67", "solution": "import re\nclass FruitCounts:\n    \"\"\"\n    A data transfer object to hold parsed fruit counts.\n    It stores the number of apples and oranges.\n    \"\"\"\n    def __init__(self, apples: int, oranges: int):\n        if not isinstance(apples, int) or apples < 0:\n            raise ValueError(\"Apples count must be a non-negative integer.\")\n        if not isinstance(oranges, int) or oranges < 0:\n            raise ValueError(\"Oranges count must be a non-negative integer.\")\n        self.apples = apples\n        self.oranges = oranges\nREGEX_FRUIT_COUNTS = r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\"\nclass FruitParser:\n    \"\"\"\n    Parses an input string to extract the number of apples and oranges.\n    It expects the string to be in a specific format.\n    \"\"\"\n    def parse(self, s: str) -> FruitCounts:\n        \"\"\"\n        Extracts apple and orange counts from the given string.\n        Raises ValueError if the string format is invalid.\n        \"\"\"\n        match = re.search(REGEX_FRUIT_COUNTS, s)\n        if not match:\n            raise ValueError(f\"Invalid input string format: '{s}'. Expected 'X apples and Y oranges'.\")\n\n        try:\n            apples = int(match.group(1))\n            oranges = int(match.group(2))\n        except ValueError as e:\n            raise ValueError(f\"Could not parse fruit counts from string: {s}\") from e\n\n        return FruitCounts(apples, oranges)\nclass FruitCalculator:\n    \"\"\"\n    Calculates the number of mangoes.\n    It uses the total fruits and known apple/orange counts.\n    \"\"\"\n    def calculate_mangoes(self, total_fruits: int, fruit_counts: FruitCounts) -> int:\n        \"\"\"\n        Calculates the number of mangoes.\n        Raises ValueError if known fruits exceed total fruits or inputs are invalid.\n        \"\"\"\n        if not isinstance(total_fruits, int) or total_fruits < 0:\n            raise ValueError(\"Total fruits must be a non-negative integer.\")\n\n        total_known_fruits = fruit_counts.apples + fruit_counts.oranges\n        if total_known_fruits > total_fruits:\n            raise ValueError(\n                f\"Total known fruits ({total_known_fruits}) cannot exceed total fruits ({total_fruits}).\"\n            )\n\n        return total_fruits - total_known_fruits\nclass FruitDistributionApp:\n    \"\"\"\n    Main application entry point and orchestrator.\n    It ties together the FruitParser and FruitCalculator components.\n    \"\"\"\n    def __init__(self):\n        self._fruit_parser = FruitParser()\n        self._fruit_calculator = FruitCalculator()\n\n    def fruit_distribution(self, s: str, n: int) -> int:\n        \"\"\"\n        Calculates the number of mango fruits in a basket.\n        Raises ValueError for invalid input string format or inconsistent fruit counts.\n        \"\"\"\n        try:\n            fruit_counts = self._fruit_parser.parse(s)\n            mangoes = self._fruit_calculator.calculate_mangoes(n, fruit_counts)\n            return mangoes\n        except ValueError as e:\n            # Re-raise specific ValueErrors from parser/calculator for clarity.\n            raise e\ndef fruit_distribution(s,n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges \n    that are distributed in a basket of fruit this basket contains \n    apples, oranges, and mango fruits. Given the string that represents the total number of \n    the oranges and apples and an integer that represent the total number of the fruits \n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    app = FruitDistributionApp()\n    return app.fruit_distribution(s, n)"}
