{"task_id": "HumanEval/46", "solution": "class Fib4Calculator:\n    \"\"\"\n    A class to compute the n-th element of the Fib4 number sequence.\n    This implementation uses an iterative approach for efficiency.\n    \"\"\"\n\n    def fib4(self, n: int) -> int:\n        \"\"\"\n        Computes the n-th element of the Fib4 number sequence iteratively.\n        Raises ValueError if 'n' is negative, otherwise returns the correct Fib4 number.\n        \"\"\"\n        if n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n        elif n == 0:\n            return 0\n        elif n == 1:\n            return 0\n        elif n == 2:\n            return 2\n        elif n == 3:\n            return 0\n        else:\n            # Initialize the four previous fib4 numbers for the iteration.\n            # a=fib4(i-4), b=fib4(i-3), c=fib4(i-2), d=fib4(i-1)\n            a, b, c, d = 0, 0, 2, 0\n\n            for _ in range(4, n + 1):\n                next_fib4 = a + b + c + d\n                a, b, c, d = b, c, d, next_fib4\n            return d"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    Takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # inverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/46", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\nFIB4_INITIAL_VALUES = {\n    0: 0,\n    1: 0,\n    2: 2,\n    3: 0\n}\ndef fib4(n: int) -> int:\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n\n    if n in FIB4_INITIAL_VALUES:\n        return FIB4_INITIAL_VALUES[n]\n\n    dp_array = [0] * (n + 1)\n\n    dp_array[0] = FIB4_INITIAL_VALUES[0]\n    dp_array[1] = FIB4_INITIAL_VALUES[1]\n    dp_array[2] = FIB4_INITIAL_VALUES[2]\n    dp_array[3] = FIB4_INITIAL_VALUES[3]\n\n    for i in range(4, n + 1):\n        dp_array[i] = dp_array[i-1] + dp_array[i-2] + dp_array[i-3] + dp_array[i-4]\n\n    return dp_array[n]"}
{"task_id": "HumanEval/50", "solution": "class ShiftDecoder:\n    SHIFT_AMOUNT = 5\n\n    @staticmethod\n    def encode_shift(s: str) -> str:\n        \"\"\"Encodes a string by shifting each character by SHIFT_AMOUNT positions.\n        Raises ValueError if the input contains non-lowercase English letters.\"\"\"\n        if not s.islower() or not s.isalpha():\n            raise ValueError(\"Input string must contain only lowercase English letters.\")\n        return \"\".join([chr(((ord(ch) + ShiftDecoder.SHIFT_AMOUNT - ord(\"a\")) % 26) + ord(\"a\")) for ch in s])\n\n    @staticmethod\n    def decode_shift(s: str) -> str:\n        \"\"\"Decodes a string that has been shifted by SHIFT_AMOUNT positions.\n        Raises ValueError if the input contains non-lowercase English letters.\"\"\"\n        if not s.islower() or not s.isalpha():\n            raise ValueError(\"Input string must contain only lowercase English letters.\")\n        return \"\".join([chr(((ord(ch) - ShiftDecoder.SHIFT_AMOUNT - ord(\"a\") + 26) % 26) + ord(\"a\")) for ch in s])"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list) -> bool:\n    \"\"\"Checks if the elements in the input list `l` are monotonically increasing or monotonically decreasing.\n    Returns True if the list is monotonic (increasing or decreasing), False otherwise.\"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False\n        if l[i] < l[i+1]:\n            is_decreasing = False\n\n    return is_increasing or is_decreasing"}
