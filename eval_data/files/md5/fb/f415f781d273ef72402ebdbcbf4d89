{"task_id": "HumanEval/134", "solution": "class StringChecker:\n    \"\"\"\n    Provides utility methods for analyzing string properties.\n    \"\"\"\n\n    @staticmethod\n    def check_if_last_char_is_a_letter(input_string: str) -> bool:\n        \"\"\"\n        Determines if the last character is an isolated alphabetical character,\n        meaning it's alphabetical and immediately preceded by a space.\n        \"\"\"\n        if not input_string:\n            return False\n\n        last_char = input_string[-1]\n\n        if not last_char.isalpha():\n            return False\n\n        if len(input_string) < 2:\n            return False\n\n        second_to_last_char = input_string[-2]\n\n        if second_to_last_char != ' ':\n            return False\n\n        return True"}
{"task_id": "HumanEval/135", "solution": "class CanArrangeService:\n    @staticmethod\n    def can_arrange(arr: list[int]) -> int:\n        \"\"\"\n        Finds the largest index i where arr[i] < arr[i-1].\n        Returns -1 if no such disarrangement is found.\n        \"\"\"\n        largest_disarrangement_index = -1\n        for i in range(1, len(arr)):\n            if arr[i] < arr[i-1]:\n                largest_disarrangement_index = i\n        return largest_disarrangement_index"}
{"task_id": "HumanEval/134", "solution": "class StringChecker:\n    @staticmethod\n    def check_if_last_char_is_a_letter(txt: str) -> bool:\n        \"\"\"\n        Returns True if the last character of a given string is an alphabetical character\n        and is not a part of a word, and False otherwise.\n        \"\"\"\n        if not txt:\n            return False\n\n        last_char = txt[-1]\n\n        if not last_char.isalpha():\n            return False\n\n        # If it's a single character string, it's considered a word.\n        if len(txt) == 1:\n            return False\n\n        # Check if the character before the last one is a space.\n        second_last_char = txt[-2]\n        return second_last_char.isspace()"}
{"task_id": "HumanEval/135", "solution": "class CanArrangeService:\n    def can_arrange(self, arr: list[int]) -> int:\n        \"\"\"\n        Finds the largest index where an element is less than its preceding element.\n        Returns -1 if the array is sorted or has fewer than two elements.\n        \"\"\"\n        n = len(arr)\n        if n < 2:\n            return -1\n\n        # Iterate from right to left, comparing arr[i] with arr[i-1].\n        for i in range(n - 1, 0, -1):\n            if arr[i] < arr[i-1]:\n                return i\n        \n        # If no disorder is found, the array is sorted.\n        return -1"}
{"task_id": "HumanEval/136", "solution": "class IntegerAnalyzer:\n    @staticmethod\n    def largest_smallest_integers(lst: list[int]) -> tuple[int | None, int | None]:\n        \"\"\"\n        Identifies the largest negative and smallest positive integers in a list.\n        Returns a tuple (largest_negative, smallest_positive), using None if a category is absent.\n        \"\"\"\n        largest_negative = None\n        smallest_positive = None\n\n        for num in lst:\n            if num < 0:\n                if largest_negative is None or num > largest_negative:\n                    largest_negative = num\n            elif num > 0:\n                if smallest_positive is None or num < smallest_positive:\n                    smallest_positive = num\n        \n        return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/136", "solution": "class IntegerAnalyzer:\n    @staticmethod\n    def largest_smallest_integers(lst: list[int]) -> tuple[int | None, int | None]:\n        \"\"\"\n        Calculates the largest negative and smallest positive integers from the input list.\n        Returns a tuple (largest_negative, smallest_positive), with None if not found.\n        \"\"\"\n        negatives = [x for x in lst if x < 0]\n        positives = [x for x in lst if x > 0]\n\n        largest_negative = max(negatives) if negatives else None\n        smallest_positive = min(positives) if positives else None\n\n        return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/138", "solution": "class SumEvenChecker:\n    MIN_SUM_FOUR_EVEN = 8  # Smallest sum of four positive even numbers (2+2+2+2).\n\n    @staticmethod\n    def is_equal_to_sum_even(n: int) -> bool:\n        \"\"\"Determines if n can be expressed as the sum of exactly four positive even numbers.\n        Raises TypeError if the input is not an integer.\n        \"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n\n        # Numbers less than MIN_SUM_FOUR_EVEN or odd numbers cannot be formed.\n        if n < SumEvenChecker.MIN_SUM_FOUR_EVEN or n % 2 != 0:\n            return False\n\n        # Any even number >= 8 can be represented (e.g., as (n-6) + 2 + 2 + 2).\n        return True"}
{"task_id": "HumanEval/137", "solution": "from typing import Union, Optional\nclass NumberConverter:\n    \"\"\"\n    Helper class for converting various types to float for comparison.\n    It handles both '.' and ',' as decimal separators for strings.\n    \"\"\"\n    @staticmethod\n    def to_float(value: Union[int, float, str]) -> Optional[float]:\n        \"\"\"\n        Converts an int, float, or string to a float.\n        Returns None if string conversion fails.\n        \"\"\"\n        if isinstance(value, (int, float)):\n            return float(value)\n        elif isinstance(value, str):\n            try:\n                return float(value) # Try with dot as decimal.\n            except ValueError:\n                try:\n                    return float(value.replace(',', '.')) # Try with comma as decimal.\n                except ValueError:\n                    return None\n        return None # Should not be reached with specified input types.\ndef compare_one(a: Union[int, float, str], b: Union[int, float, str]) -> Union[int, float, str, None]:\n    \"\"\"\n    Compares two values and returns the larger one in its original type.\n    Returns None if the values are numerically equal.\n    \"\"\"\n    float_a = NumberConverter.to_float(a)\n    float_b = NumberConverter.to_float(b)\n\n    if float_a is None and isinstance(a, str):\n        raise ValueError(f\"Invalid number string: '{a}'\")\n    if float_b is None and isinstance(b, str):\n        raise ValueError(f\"Invalid number string: '{b}'\")\n\n    if float_a > float_b:\n        return a\n    elif float_b > float_a:\n        return b\n    else:\n        return None"}
{"task_id": "HumanEval/137", "solution": "from typing import Union\nclass NumberConverter:\n    \"\"\"Utility for converting various types to float for comparison.\n    It handles integers, floats, and string representations of real numbers.\n    \"\"\"\n    def to_float(self, value: Union[int, float, str]) -> float:\n        \"\"\"Converts an input value to a float.\n        It handles strings with both '.' and ',' as decimal separators.\n        \"\"\"\n        if isinstance(value, (int, float)):\n            return float(value)\n        elif isinstance(value, str):\n            # If a comma is present and a dot is not, assume comma is the decimal separator.\n            if ',' in value and '.' not in value:\n                value = value.replace(',', '.')\n            try:\n                return float(value)\n            except ValueError as e:\n                raise ValueError(f\"Invalid string representation of a number: '{value}'\") from e\n        else:\n            raise TypeError(f\"Unsupported type for comparison: {type(value)}\")\nclass ComparatorService:\n    \"\"\"Provides the core comparison logic for two values.\n    It returns the larger value in its original type or None if equal.\n    \"\"\"\n    def __init__(self, number_converter: NumberConverter):\n        \"\"\"Initializes the ComparatorService with a NumberConverter instance.\"\"\"\n        self._number_converter = number_converter\n\n    def compare_one(self, a: Union[int, float, str], b: Union[int, float, str]) -> Union[int, float, str, None]:\n        \"\"\"Compares 'a' and 'b', returning the larger original value or None if equal.\n        Values can be int, float, or string representations of real numbers.\n        \"\"\"\n        float_a = self._number_converter.to_float(a)\n        float_b = self._number_converter.to_float(b)\n\n        if float_a > float_b:\n            return a\n        elif float_b > float_a:\n            return b\n        else:\n            return None\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n\n    compare_one(1, 2.5) \u279e 2.5\n    compare_one(1, \"2,3\") \u279e \"2,3\"\n    compare_one(\"5,1\", \"6\") \u279e \"6\"\n    compare_one(\"1\", 1) \u279e None\n    \"\"\"\n    number_converter = NumberConverter()\n    comparator_service = ComparatorService(number_converter)\n    return comparator_service.compare_one(a, b)"}
