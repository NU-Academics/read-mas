{"task_id": "HumanEval/145", "solution": "def _sum_digits(num: int) -> int:\n    \"\"\"\n    Calculates the sum of the absolute digits of an integer.\n    For example: _sum_digits(-12) == 3 (1+2).\n    \"\"\"\n    s = 0\n    num_abs = abs(num)\n    while num_abs > 0:\n        s += num_abs % 10\n        num_abs //= 10\n    return s\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"\n    Sorts the given list of integers by the sum of their digits in ascending order.\n    For ties, elements are ordered by their original index in the input list.\n    \"\"\"\n    if not nums:\n        return []\n\n    decorated_list = []\n    for index, value in enumerate(nums):\n        digit_sum = _sum_digits(value)\n        decorated_list.append((digit_sum, index, value))\n\n    decorated_list.sort()\n\n    return [item[2] for item in decorated_list]"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"\n    Represents a mathematical fraction with a numerator and a denominator.\n    \"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        if not isinstance(numerator, int) or not isinstance(denominator, int):\n            raise TypeError(\"Numerator and denominator must be integers.\")\n        if denominator == 0:\n            raise ValueError(\"Denominator cannot be zero.\")\n        if numerator <= 0 or denominator <= 0: # This constraint is stricter than the original problem for positive whole numbers.\n            raise ValueError(\"Numerator and denominator must be positive.\")\n\n        self.numerator = numerator\n        self.denominator = denominator\n\n    def __eq__(self, other):\n        if not isinstance(other, Fraction):\n            return NotImplemented\n        return self.numerator == other.numerator and self.denominator == other.denominator\n\n    def __repr__(self):\n        return f\"Fraction({self.numerator}/{self.denominator})\"\nclass FractionParser:\n    \"\"\"\n    Utility class for parsing fraction strings into Fraction objects.\n    \"\"\"\n    @staticmethod\n    def parse(fraction_str: str) -> Fraction:\n        \"\"\"\n        Parses a fraction string (e.g., \"3/4\") into a Fraction object.\n        \"\"\"\n        parts = fraction_str.split('/')\n        if len(parts) != 2:\n            raise ValueError(f\"Invalid fraction string format: {fraction_str}. Expected 'numerator/denominator'.\")\n        \n        try:\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n        except ValueError:\n            raise ValueError(f\"Invalid number in fraction string: {fraction_str}. Numerator and denominator must be integers.\")\n\n        return Fraction(numerator, denominator)\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    fraction_x = FractionParser.parse(x)\n    fraction_n = FractionParser.parse(n)\n\n    product_numerator = fraction_x.numerator * fraction_n.numerator\n    product_denominator = fraction_x.denominator * fraction_n.denominator\n\n    # Check if the product is a whole number\n    return product_numerator % product_denominator == 0"}
{"task_id": "HumanEval/145", "solution": "from src.utils import DigitSumCalculator\nclass OrderByPointsSorter:\n    def __init__(self, digit_sum_calculator: DigitSumCalculator):\n        \"\"\"Initializes the sorter with a DigitSumCalculator instance.\"\"\"\n        self._digit_sum_calculator = digit_sum_calculator\n\n    def order_by_points(self, nums: list[int]) -> list[int]:\n        \"\"\"Sorts integers by sum of digits, then by original index for ties.\n        Returns a new list with the sorted integers.\"\"\"\n        if not nums:\n            return []\n\n        decorated_list = []\n        for index, num in enumerate(nums):\n            sum_digits = self._digit_sum_calculator.calculate_digit_sum(num)\n            decorated_list.append((sum_digits, index, num))\n\n        decorated_list.sort()\n\n        sorted_nums = [item[2] for item in decorated_list]\n        return sorted_nums\n_digit_sum_calculator_instance = DigitSumCalculator()\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"Convenience function to use the OrderByPointsSorter.\"\"\"\n    sorter = OrderByPointsSorter(_digit_sum_calculator_instance)\n    return sorter.order_by_points(nums)"}
{"task_id": "HumanEval/146", "solution": "# src/special_filter/utils.py\n\nclass NumberUtils:\n    \"\"\"\n    NumberUtils provides static utility methods for extracting digits and checking their parity.\n    It handles absolute values for digit extraction.\n    \"\"\"\n\n    @staticmethod\n    def is_odd(digit: int) -> bool:\n        \"\"\"\n        Checks if a given digit is odd.\n        Odd digits are defined as 1, 3, 5, 7, 9.\n        \"\"\"\n        return digit in (1, 3, 5, 7, 9)\n\n    @staticmethod\n    def get_first_digit(num: int) -> int:\n        \"\"\"\n        Extracts the first (most significant) digit of an integer.\n        Handles negative numbers by taking the absolute value.\n        \"\"\"\n        abs_num = abs(num)\n        if abs_num == 0:\n            return 0\n        while abs_num >= 10:\n            abs_num //= 10\n        return abs_num\n\n    @staticmethod\n    def get_last_digit(num: int) -> int:\n        \"\"\"\n        Extracts the last (least significant) digit of an integer.\n        Handles negative numbers by taking the absolute value.\n        \"\"\"\n        return abs(num) % 10"}
