{"task_id": "HumanEval/148", "solution": "from .models import PLANETS_ORDER, PlanetModel\nfrom .exceptions import InvalidPlanetError\nclass InvalidPlanetError(ValueError):\n    \"\"\"Custom exception for invalid planet names.\"\"\"\n    pass\nclass PlanetModel:\n    \"\"\"Represents a planet with its name and orbital order.\"\"\"\n    def __init__(self, name: str, order: int):\n        self.name = name\n        self.order = order\nPLANETS_ORDER: list[PlanetModel] = [\n    PlanetModel(\"Mercury\", 0),\n    PlanetModel(\"Venus\", 1),\n    PlanetModel(\"Earth\", 2),\n    PlanetModel(\"Mars\", 3),\n    PlanetModel(\"Jupiter\", 4),\n    PlanetModel(\"Saturn\", 5),\n    PlanetModel(\"Uranus\", 6),\n    PlanetModel(\"Neptune\", 7),\n]\nclass PlanetService:\n    \"\"\"Provides business logic for finding planets between two given planets.\"\"\"\n    def __init__(self):\n        self._planets_order: list[PlanetModel] = PLANETS_ORDER\n        self._planet_map: dict[str, PlanetModel] = {\n            planet.name: planet for planet in PLANETS_ORDER\n        }\n\n    def _get_planet_index(self, planet_name: str) -> int:\n        \"\"\"Helper to get the ordinal index of a planet from its name.\"\"\"\n        planet = self._planet_map.get(planet_name)\n        if not planet:\n            raise InvalidPlanetError(f\"'{planet_name}' is not a valid planet name.\")\n        return planet.order\n\n    def bf(self, planet1: str, planet2: str) -> tuple[str, ...]:\n        \"\"\"Finds all planets whose orbits are located between planet1 and planet2.\n        Returns them sorted by proximity to the Sun.\"\"\"\n        try:\n            idx1 = self._get_planet_index(planet1)\n            idx2 = self._get_planet_index(planet2)\n        except InvalidPlanetError:\n            return ()\n\n        start_idx = min(idx1, idx2)\n        end_idx = max(idx1, idx2)\n\n        intermediate_planets = [\n            p.name for p in self._planets_order\n            if start_idx < p.order < end_idx\n        ]\n        return tuple(intermediate_planets)\n_planet_service_instance = PlanetService()\ndef bf(planet1: str, planet2: str) -> tuple[str, ...]:\n    \"\"\"\n    There are eight planets in our solar system: the closerst to the Sun\n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn,\n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2.\n    The function should return a tuple containing all planets whose orbits are\n    located between the orbit of planet1 and the orbit of planet2, sorted by\n    the proximity to the sun.\n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names.\n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    \"\"\"\n    return _planet_service_instance.bf(planet1, planet2)"}
