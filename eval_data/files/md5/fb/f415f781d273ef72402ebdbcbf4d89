{"task_id": "HumanEval/11", "solution": "class StringXORService:\n    @staticmethod\n    def string_xor(a: str, b: str) -> str:\n        \"\"\"Performs a bitwise XOR operation on two binary strings.\n        Input strings must be non-empty, of equal length, and contain only '0's and '1's.\"\"\"\n        if not isinstance(a, str) or not isinstance(b, str):\n            raise ValueError(\"Inputs must be strings.\")\n        if not a or not b:\n            raise ValueError(\"Input strings cannot be empty.\")\n        if len(a) != len(b):\n            raise ValueError(\"Input strings must be of the same length.\")\n\n        result = []\n        for char_a, char_b in zip(a, b):\n            if char_a not in ('0', '1') or char_b not in ('0', '1'):\n                raise ValueError(\"Input strings must contain only '0's and '1's.\")\n            \n            if char_a == char_b:\n                result.append('0')\n            else:\n                result.append('1')\n        return \"\".join(result)"}
{"task_id": "HumanEval/11", "solution": "class XORUtils:\n    @staticmethod\n    def _validate_binary_string(s: str) -> None:\n        \"\"\"\n        Validates that a string consists only of '0's and '1's.\n        Raises ValueError if invalid characters are found.\n        \"\"\"\n        if not all(char in ('0', '1') for char in s):\n            raise ValueError(\"Input string must contain only '0' or '1' characters.\")\n\n    @staticmethod\n    def _pad_strings(s1: str, s2: str) -> tuple[str, str]:\n        \"\"\"\n        Pads the shorter of two binary strings with leading '0's to match the length\n        of the longer string.\n        \"\"\"\n        max_len = max(len(s1), len(s2))\n        return s1.zfill(max_len), s2.zfill(max_len)\n\n    @staticmethod\n    def string_xor(a: str, b: str) -> str:\n        \"\"\"\n        Performs a bitwise XOR operation on two binary strings.\n        Pads shorter strings with leading '0's and validates input characters.\n\n        Args:\n            a: The first binary string ('0's and '1's).\n            b: The second binary string ('0's and '1's).\n\n        Returns:\n            A string representing the binary XOR result.\n\n        Raises:\n            ValueError: If input strings contain characters other than '0' or '1'.\n        \"\"\"\n        XORUtils._validate_binary_string(a)\n        XORUtils._validate_binary_string(b)\n\n        padded_a, padded_b = XORUtils._pad_strings(a, b)\n\n        result = []\n        for char_a, char_b in zip(padded_a, padded_b):\n            bit_a = int(char_a)\n            bit_b = int(char_b)\n            xor_result = bit_a ^ bit_b\n            result.append(str(xor_result))\n        return \"\".join(result)"}
{"task_id": "HumanEval/13", "solution": "class GcdCalculator:\n    @staticmethod\n    def greatest_common_divisor(a: int, b: int) -> int:\n        \"\"\"\n        Calculates the greatest common divisor of two integers using the Euclidean algorithm.\n        It handles positive, negative, and zero inputs by considering absolute values and special zero cases.\n        \"\"\"\n        a = abs(a)\n        b = abs(b)\n\n        while b:\n            a, b = b, a % b\n        return a"}
