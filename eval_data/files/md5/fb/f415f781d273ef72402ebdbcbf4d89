{"task_id": "HumanEval/40", "solution": "class TriplesSumToZeroService:\n    @staticmethod\n    def check(numbers: list[int]) -> bool:\n        \"\"\"\n        Determines if there are three distinct elements in the input list that sum to zero.\n        Uses a sorted array and two-pointer technique for efficient checking.\n        \"\"\"\n        n = len(numbers)\n        if n < 3:\n            return False\n\n        # Sort the numbers list to enable the two-pointer approach.\n        numbers.sort()\n\n        for i in range(n - 2):\n            # Skip duplicate elements for 'i' to prevent redundant triplets.\n            if i > 0 and numbers[i] == numbers[i - 1]:\n                continue\n\n            left, right = i + 1, n - 1\n            while left < right:\n                current_sum = numbers[i] + numbers[left] + numbers[right]\n\n                if current_sum == 0:\n                    return True\n                elif current_sum < 0:\n                    left += 1\n                else: # current_sum > 0\n                    right -= 1\n        return False"}
{"task_id": "HumanEval/39", "solution": "from typing import Iterator, TypeGuard\nclass PrimeChecker:\n    \"\"\"Utility class to determine if a given integer is a prime number.\"\"\"\n\n    def __init__(self):\n        \"\"\"Constructor for PrimeChecker. No specific initialization is needed.\"\"\"\n        pass\n\n    def is_prime(self, num: int) -> TypeGuard[int]:\n        \"\"\"Checks if the input `num` is a prime number using an optimized trial division algorithm.\"\"\"\n        if not isinstance(num, int):\n            raise TypeError(\"Input must be an integer.\")\n        if num < 0:\n            raise ValueError(\"Input number must be non-negative.\")\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\nclass FibonacciGenerator:\n    \"\"\"Generates an infinite sequence of Fibonacci numbers.\"\"\"\n\n    def __init__(self):\n        \"\"\"Constructor for FibonacciGenerator. Initializes the starting Fibonacci numbers.\"\"\"\n        self._a = 0\n        self._b = 1\n\n    def generate_fibonacci(self) -> Iterator[int]:\n        \"\"\"An infinite generator that yields Fibonacci numbers sequentially.\"\"\"\n        yield self._a  # Yield 0\n        yield self._b  # Yield 1\n        while True:\n            next_fib = self._a + self._b\n            self._a = self._b\n            self._b = next_fib\n            yield next_fib\nclass PrimeFibonacciService:\n    \"\"\"Orchestrates the process of finding the n-th number that is both a Fibonacci number and a prime number.\"\"\"\n\n    def __init__(self, fibonacci_generator: FibonacciGenerator, prime_checker: PrimeChecker):\n        \"\"\"Initializes the service with concrete implementations of FibonacciGenerator and PrimeChecker.\"\"\"\n        self._fibonacci_generator = fibonacci_generator\n        self._prime_checker = prime_checker\n\n    def prime_fib(self, n: int) -> int:\n        \"\"\"Finds and returns the n-th number that is both a Fibonacci number and a prime.\"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise ValueError(\"n must be a positive integer.\")\n\n        prime_fib_count = 0\n        fib_iterator = self._fibonacci_generator.generate_fibonacci()\n\n        while True:\n            fib_num = next(fib_iterator)\n            # Skip 0 and 1 as they are not prime numbers.\n            if fib_num <= 1:\n                continue\n\n            if self._prime_checker.is_prime(fib_num):\n                prime_fib_count += 1\n                if prime_fib_count == n:\n                    return fib_num\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    fib_generator = FibonacciGenerator()\n    prime_checker = PrimeChecker()\n    service = PrimeFibonacciService(fib_generator, prime_checker)\n    return service.prime_fib(n)"}
{"task_id": "HumanEval/39", "solution": "from .fibonacci import FibonacciGenerator\nfrom .prime import PrimeChecker\nfrom .service import PrimeFibService\nfrom .exceptions import InvalidInputError, NotFoundError\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n    fib_generator = FibonacciGenerator()\n    prime_checker = PrimeChecker()\n    service = PrimeFibService(fib_generator, prime_checker)\n\n    try:\n        return service.find_nth_prime_fib(n)\n    except (InvalidInputError, NotFoundError) as e:\n        # Re-raise specific exceptions from the service layer.\n        raise e\n    except Exception as e:\n        # Catch any unexpected errors and re-raise as a generic runtime error.\n        raise RuntimeError(f\"An unexpected error occurred: {e}\") from e"}
