{"task_id": "HumanEval/44", "solution": "class BaseConverter:\n    MIN_BASE = 2\n    MAX_BASE = 9\n\n    @staticmethod\n    def change_base(x: int, base: int) -> str:\n        \"\"\"Converts integer x from base 10 to target base.\n        Returns the string representation of the converted number.\n        \"\"\"\n        if not isinstance(x, int) or x < 0:\n            raise ValueError(\"Input number 'x' must be a non-negative integer.\")\n        if not isinstance(base, int) or not (BaseConverter.MIN_BASE <= base <= BaseConverter.MAX_BASE):\n            raise ValueError(f\"Base must be an integer between {BaseConverter.MIN_BASE} and {BaseConverter.MAX_BASE} (inclusive).\")\n\n        if x == 0:\n            return \"0\"\n\n        result = []\n        current_x = x\n        while current_x > 0:\n            remainder = current_x % base\n            result.append(str(remainder))\n            current_x //= base\n        \n        return \"\".join(result[::-1])"}
