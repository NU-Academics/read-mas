{"task_id": "HumanEval/66", "solution": "class StringUtils:\n    @staticmethod\n    def digitSum(s: str) -> int:\n        \"\"\"Calculates the sum of ASCII values of all uppercase characters in a string.\n        Raises TypeError if the input is not a string.\"\"\"\n        if not isinstance(s, str):\n            raise TypeError(\"Input must be a string.\")\n        \n        total_sum = 0\n        for char in s:\n            if char.isupper():\n                total_sum += ord(char)\n        return total_sum"}
{"task_id": "HumanEval/67", "solution": "import re\nclass InvalidFruitStringError(ValueError):\n    \"\"\"Raised when the fruit string format is invalid.\"\"\"\n    pass\nclass InvalidFruitCountError(ValueError):\n    \"\"\"Raised when fruit counts are illogical (e.g., total < known fruits).\"\"\"\n    pass\nclass FruitBasket:\n    \"\"\"\n    A data transfer object for fruit counts and total.\n    It ensures all fruit counts and total_fruits are non-negative integers.\n    \"\"\"\n    def __init__(self, apples: int, oranges: int, total_fruits: int):\n        if not all(isinstance(arg, int) and arg >= 0 for arg in [apples, oranges, total_fruits]):\n            raise ValueError(\"All fruit counts and total_fruits must be non-negative integers.\")\n        self.apples = apples\n        self.oranges = oranges\n        self.total_fruits = total_fruits\nclass FruitStringParser:\n    \"\"\"\n    Parses a string to extract apple and orange counts.\n    It expects the format \"X apples and Y oranges\".\n    \"\"\"\n    _PATTERN = re.compile(r\"(\\d+)\\s+apples\\s+and\\s+(\\d+)\\s+oranges\")\n\n    @staticmethod\n    def parse(s: str) -> tuple[int, int]:\n        \"\"\"\n        Parses the input string to extract apple and orange counts.\n        Raises InvalidFruitStringError if the string format is invalid.\n        \"\"\"\n        match = FruitStringParser._PATTERN.match(s)\n        if not match:\n            raise InvalidFruitStringError(f\"Invalid fruit string format: '{s}'\")\n        \n        apples = int(match.group(1))\n        oranges = int(match.group(2))\n        return apples, oranges\nclass FruitDistributionService:\n    \"\"\"\n    Provides the business logic for calculating mango fruits.\n    It orchestrates parsing and performs the final calculation.\n    \"\"\"\n    @staticmethod\n    def calculate_mangoes(s: str, n: int) -> int:\n        \"\"\"\n        Calculates the number of mango fruits in a basket.\n        It parses the string for apples and oranges, then subtracts their sum from the total.\n        \"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise ValueError(\"Total fruits 'n' must be a non-negative integer.\")\n\n        apples, oranges = FruitStringParser.parse(s)\n        \n        basket = FruitBasket(apples=apples, oranges=oranges, total_fruits=n)\n\n        known_fruits_sum = basket.apples + basket.oranges\n        if known_fruits_sum > basket.total_fruits:\n            raise InvalidFruitCountError(\n                f\"Total fruits ({basket.total_fruits}) cannot be less than \"\n                f\"the sum of apples ({basket.apples}) and oranges ({basket.oranges}).\"\n            )\n        \n        mangoes = basket.total_fruits - known_fruits_sum\n        return mangoes\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"\n    Calculates the number of mango fruits in a basket.\n    This function serves as the primary external interface.\n    \"\"\"\n    return FruitDistributionService.calculate_mangoes(s, n)"}
