{"task_id": "HumanEval/77", "solution": "import math\ndef iscube(a: int) -> bool:\n    '''\n    Checks if an integer 'a' is a cube of some integer number.\n    Assumes valid integer input.\n    Examples:\n    iscube(1) ==> True\n    iscube(2) ==> False\n    iscube(-1) ==> True\n    iscube(64) ==> True\n    iscube(0) ==> True\n    iscube(180) ==> False\n    '''\n    if a == 0:\n        return True\n\n    # Calculate the integer cube root.\n    # We use abs() to handle negative numbers during the exponentiation,\n    # then adjust the sign of the root.\n    \n    # Calculate the cube root using `** (1/3.0)` and round it to the nearest integer.\n    # This mitigates floating-point inaccuracies.\n    root = round(abs(a)**(1/3.0))\n\n    # Adjust the sign of the root if the original number was negative.\n    # For example, cube root of -8 is -2, but round(abs(-8)**(1/3.0)) would give 2.\n    if a < 0:\n        root = -root\n    \n    # Check if the cube of the (integer) root is equal to the original number.\n    return root * root * root == a"}
{"task_id": "HumanEval/86", "solution": "class AntiShuffleService:\n    def _sort_word_characters(self, word: str) -> str:\n        \"\"\"\n        Sorts the characters of a single word based on their ASCII values.\n        This uses Python's default sorted function, then joins them into a string.\n        \"\"\"\n        return ''.join(sorted(word))\n\n    def anti_shuffle_logic(self, s: str) -> str:\n        \"\"\"\n        Reorders characters within each word of the input string s.\n        Words are delimited by spaces; their original order and spacing are maintained.\n        \"\"\"\n        words_and_spaces = s.split(' ')\n        shuffled_words = [self._sort_word_characters(word) for word in words_and_spaces]\n        return ' '.join(shuffled_words)\ndef anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n    service = AntiShuffleService()\n    return service.anti_shuffle_logic(s)"}
{"task_id": "HumanEval/86", "solution": "from typing import List\nclass WordSorter:\n    \"\"\"Encapsulates logic for sorting characters within a single word.\"\"\"\n    def sort_chars(self, word: str) -> str:\n        \"\"\"Sorts characters of a word based on ASCII values and returns the new word.\"\"\"\n        return \"\".join(sorted(word))\nclass AntiShuffleService:\n    \"\"\"Implements the core logic for the anti_shuffle function.\"\"\"\n    def __init__(self, word_sorter: WordSorter = None):\n        \"\"\"Initializes the service, optionally with a custom WordSorter.\"\"\"\n        self._word_sorter = word_sorter if word_sorter is not None else WordSorter()\n\n    def anti_shuffle(self, s: str) -> str:\n        \"\"\"Splits the input string, sorts characters within each word, and reconstructs the string.\"\"\"\n        if not s:\n            return \"\"\n\n        result_parts: List[str] = []\n        current_word: List[str] = []\n\n        for char in s:\n            if char == ' ':\n                if current_word:\n                    result_parts.append(self._word_sorter.sort_chars(\"\".join(current_word)))\n                    current_word = []\n                result_parts.append(' ')\n            else:\n                current_word.append(char)\n\n        if current_word:\n            result_parts.append(self._word_sorter.sort_chars(\"\".join(current_word)))\n\n        return \"\".join(result_parts)\ndef anti_shuffle(s: str) -> str:\n    \"\"\"\n    Takes a string and returns an ordered version of it.\n    This orders characters within each word while preserving word and space order.\n    \"\"\"\n    service = AntiShuffleService()\n    return service.anti_shuffle(s)"}
{"task_id": "HumanEval/87", "solution": "class CoordinateFinder:\n    def get_row(self, lst: list[list[int]], x: int) -> list[tuple[int, int]]:\n        \"\"\"\n        Finds all occurrences of an integer x in a 2D list and returns their sorted coordinates.\n        Coordinates are sorted primarily by row ascending, then by column descending.\n        \"\"\"\n        if not isinstance(lst, list):\n            raise TypeError(\"Input 'lst' must be a list.\")\n        if not isinstance(x, int):\n            raise TypeError(\"Input 'x' must be an integer.\")\n\n        coordinates = []\n        for r_idx, row in enumerate(lst):\n            if not isinstance(row, list):\n                raise TypeError(f\"Row at index {r_idx} must be a list.\")\n            for c_idx, val in enumerate(row):\n                if not isinstance(val, int):\n                    raise TypeError(f\"Value at ({r_idx}, {c_idx}) must be an integer.\")\n                if val == x:\n                    coordinates.append((r_idx, c_idx))\n\n        # Sort by row ascending, then by column descending.\n        coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n        return coordinates"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a copy of the input array based on the parity of the sum of its first and last elements.\n    Returns a new list, sorted according to the specified rules.\n    \"\"\"\n    if not array:\n        return []\n    if len(array) == 1:\n        return list(array)\n\n    first_element = array[0]\n    last_element = array[-1]\n    elements_sum = first_element + last_element\n\n    if elements_sum % 2 != 0:  # Odd sum, sort ascending\n        return sorted(array)\n    else:  # Even sum, sort descending\n        return sorted(array, reverse=True)"}
{"task_id": "HumanEval/89", "solution": "LOWERCASE_ALPHABET = \"abcdefghijklmnopqrstuvwxyz\"\nUPPERCASE_ALPHABET = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\nROTATION_SHIFT = 4\ndef _rotate_char(char: str, alphabet: str, shift: int) -> str:\n    \"\"\"Rotates a single character within a given alphabet by a specified shift.\"\"\"\n    index = alphabet.find(char)\n    if index == -1: # Character not found in the alphabet, return as is.\n        return char\n    new_index = (index + shift) % len(alphabet)\n    return alphabet[new_index]\ndef encrypt(s: str) -> str:\n    \"\"\"\n    Encrypts a string by rotating alphabetic characters by a fixed shift.\n    Non-alphabetic characters remain unchanged, and case is preserved.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    encrypted_chars = []\n    for char in s:\n        if char.islower():\n            encrypted_chars.append(_rotate_char(char, LOWERCASE_ALPHABET, ROTATION_SHIFT))\n        elif char.isupper():\n            encrypted_chars.append(_rotate_char(char, UPPERCASE_ALPHABET, ROTATION_SHIFT))\n        else:\n            encrypted_chars.append(char) # Non-alphabetic characters are kept as is.\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/88", "solution": "from typing import List\ndef sort_array(array: List[int]) -> List[int]:\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    if not array:\n        return []\n\n    # Create a copy to avoid modifying the original array\n    array_copy = list(array)\n\n    first_element = array_copy[0]\n    last_element = array_copy[-1]\n    sum_elements = first_element + last_element\n\n    if sum_elements % 2 != 0:  # Sum is odd, sort in ascending order\n        array_copy.sort(reverse=False)\n    else:  # Sum is even, sort in descending order\n        array_copy.sort(reverse=True)\n\n    return array_copy"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s: str) -> str:\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated. \n    The alphabet should be rotated in a manner such that the letters \n    shift down by two multiplied to two places.\n    For example:\n    encrypt('hi') returns 'lm'\n    encrypt('asdfghjkl') returns 'ewhjklnop'\n    encrypt('gf') returns 'kj'\n    encrypt('et') returns 'ix'\n    \"\"\"\n    SHIFT_AMOUNT = 4\n\n    def is_lower(char: str) -> bool:\n        return 'a' <= char <= 'z'\n\n    def is_upper(char: str) -> bool:\n        return 'A' <= char <= 'Z'\n\n    def shift_char(char: str, shift: int) -> str:\n        if is_lower(char):\n            start = ord('a')\n            return chr(start + (ord(char) - start + shift) % 26)\n        elif is_upper(char):\n            start = ord('A')\n            return chr(start + (ord(char) - start + shift) % 26)\n        return char\n\n    encrypted_chars = []\n    for char in s:\n        if is_lower(char) or is_upper(char):\n            encrypted_chars.append(shift_char(char, SHIFT_AMOUNT))\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
