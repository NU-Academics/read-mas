{"task_id": "HumanEval/70", "solution": "from typing import List\nclass StrangeSorter:\n    \"\"\"\n    Encapsulates the core logic for performing the \"strange sort\".\n    This class is designed to be stateless, operating purely on the input provided.\n    \"\"\"\n    def sort(self, input_list: List[int]) -> List[int]:\n        \"\"\"\n        Sorts a list of integers in a strange order (min, max, min, max...).\n        It returns a new list without modifying the original input.\n        \"\"\"\n        if not input_list:\n            return []\n\n        temp_list = sorted(input_list)\n        result = []\n        left, right = 0, len(temp_list) - 1\n        is_min_turn = True\n\n        while left <= right:\n            if is_min_turn:\n                result.append(temp_list[left])\n                left += 1\n            else:\n                result.append(temp_list[right])\n                right -= 1\n            is_min_turn = not is_min_turn\n        return result\ndef strange_sort_list(lst: List[int]) -> List[int]:\n    \"\"\"\n    Provides the public entry point for the strange sorting functionality.\n    It delegates the actual sorting task to a StrangeSorter instance.\n    \"\"\"\n    sorter = StrangeSorter()\n    return sorter.sort(lst)"}
{"task_id": "HumanEval/95", "solution": "\"\"\"Package for dictionary key casing validation.\"\"\"\n\nclass DictCaseChecker:\n    \"\"\"Encapsulates the core logic for determining dictionary key casing consistency.\"\"\"\n\n    @staticmethod\n    def check_dict_case(data: dict) -> bool:\n        \"\"\"\n        Validates if dictionary keys are consistently cased.\n        Returns True if all keys are strings and either all lowercase or all uppercase, False otherwise.\n        \"\"\"\n        if not data:\n            return False\n\n        all_keys = list(data.keys())\n        \n        # Check if all keys are strings\n        if not all(isinstance(key, str) for key in all_keys):\n            return False\n\n        # Check if all keys are lowercase\n        all_lower = all(key.islower() for key in all_keys)\n        if all_lower:\n            return True\n\n        # Check if all keys are uppercase\n        all_upper = all(key.isupper() for key in all_keys)\n        if all_upper:\n            return True\n\n        return False\n\nclass DictCaseCheckerService:\n    \"\"\"Provides the public interface for dictionary key casing validation.\"\"\"\n\n    @staticmethod\n    def check_dict_case(data: dict) -> bool:\n        \"\"\"\n        Provides a service interface for dictionary key casing validation.\n        Delegates the core logic to DictCaseChecker.\n        \"\"\"\n        return DictCaseChecker.check_dict_case(data)"}
