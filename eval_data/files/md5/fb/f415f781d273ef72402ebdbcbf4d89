{"task_id": "HumanEval/93", "solution": "class AlphabetHelper:\n    \"\"\"Provides utility methods for character manipulations within the English alphabet.\"\"\"\n    VOWELS = \"aeiouAEIOU\"\n    \n    @staticmethod\n    def is_letter(char: str) -> bool:\n        \"\"\"Checks if a given character is an English alphabet letter.\"\"\"\n        return 'a' <= char <= 'z' or 'A' <= char <= 'Z'\n\n    @staticmethod\n    def is_vowel(char: str) -> bool:\n        \"\"\"Checks if a given character is an English vowel (case-sensitive).\"\"\"\n        return char in AlphabetHelper.VOWELS\n\n    @staticmethod\n    def swap_case_char(char: str) -> str:\n        \"\"\"Swaps the case of an alphabetic character, returning the original if not a letter.\"\"\"\n        if 'a' <= char <= 'z':\n            return char.upper()\n        elif 'A' <= char <= 'Z':\n            return char.lower()\n        return char\n\n    @staticmethod\n    def shift_char(char: str, places: int) -> str:\n        \"\"\"Shifts an alphabetic character forward by 'places' in the alphabet, with wrap-around and case preservation.\"\"\"\n        if 'a' <= char <= 'z':\n            start = ord('a')\n            return chr(start + (ord(char) - start + places) % 26)\n        elif 'A' <= char <= 'Z':\n            start = ord('A')\n            return chr(start + (ord(char) - start + places) % 26)\n        return char\nclass MessageEncoder:\n    \"\"\"Orchestrates the message encoding process based on defined character transformation rules.\"\"\"\n    def __init__(self, alphabet_helper: AlphabetHelper):\n        \"\"\"Initializes the encoder with an AlphabetHelper instance for character operations.\"\"\"\n        self._alphabet_helper = alphabet_helper\n\n    def encode(self, message: str) -> str:\n        \"\"\"Encodes an input message string by applying case swapping and vowel shifting rules.\"\"\"\n        encoded_chars = []\n        for char in message:\n            if self._alphabet_helper.is_letter(char):\n                swapped_char = self._alphabet_helper.swap_case_char(char)\n                if self._alphabet_helper.is_vowel(swapped_char):\n                    final_char = self._alphabet_helper.shift_char(swapped_char, 2)\n                else:\n                    final_char = swapped_char\n            else:\n                final_char = char  # Preserve non-alphabetic characters\n            encoded_chars.append(final_char)\n        return \"\".join(encoded_chars)\ndef encode(message):\n    \"\"\"\n    Write a function that takes a message, and encodes in such a \n    way that it swaps case of all letters, replaces all vowels in \n    the message with the letter that appears 2 places ahead of that \n    vowel in the english alphabet. \n    Assume only letters. \n    \n    Examples:\n    >>> encode('test')\n    'TGST'\n    >>> encode('This is a message')\n    'tHKS KS C MGSSCGG'\n    \"\"\"\n    helper = AlphabetHelper()\n    encoder = MessageEncoder(helper)\n    return encoder.encode(message)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n\n    Examples:\n    For lst = [0,3,2,1,3,5,7,4,5,5,5,2,181,32,4,32,3,2,32,324,4,3] the output should be 10\n    For lst = [1,0,1,8,2,4597,2,1,3,40,1,2,1,2,4,2,5,1] the output should be 25\n    For lst = [1,3,1,32,5107,34,83278,109,163,23,2323,32,30,1,9,3] the output should be 13\n    For lst = [0,724,32,71,99,32,6,0,5,91,83,0,5,6] the output should be 11\n    For lst = [0,81,12,3,1,21] the output should be 3\n    For lst = [0,8,1,2,1,7] the output should be 7\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a given integer n is a prime number.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input must be an integer.\")\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the digits of a given integer n.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input must be an integer.\")\n        return sum(int(digit) for digit in str(abs(n)))\n\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in lst):\n        raise TypeError(\"All elements in the list must be integers.\")\n\n    largest_prime = 0\n    for number in lst:\n        if is_prime(number):\n            if number > largest_prime:\n                largest_prime = number\n    \n    return sum_digits(largest_prime)"}
