{"task_id": "HumanEval/142", "solution": "from dataclasses import dataclass, field\nfrom typing import List\nclass ListProcessor:\n    def process_list(self, lst: List[int]) -> List[int]:\n        processed_lst = list(lst)  # Operate on a copy to preserve the original input list.\n        for i in range(len(processed_lst)):\n            if i % 3 == 0:  # Rule for multiples of 3 (including 0) takes precedence.\n                processed_lst[i] = processed_lst[i] ** 2\n            elif i % 4 == 0:  # Rule for multiples of 4 (including 0), only if not a multiple of 3.\n                processed_lst[i] = processed_lst[i] ** 3\n        return processed_lst\n\n    def calculate_sum(self, lst: List[int]) -> int:\n        return sum(lst)\ndef sum_squares(lst: List[int]) -> int:\n    \"\"\"\n    This function processes a list of integers, transforming elements based on their index.\n    It returns the sum of the transformed elements.\n    \"\"\"\n    if not lst:\n        return 0\n\n    processor = ListProcessor()\n    modified_list = processor.process_list(lst)\n    total_sum = processor.calculate_sum(modified_list)\n    return total_sum"}
{"task_id": "HumanEval/141", "solution": "import re\nfrom src.constants import VALID_EXTENSIONS\nclass FileNameValidator:\n    \"\"\"Encapsulates file name validation logic.\"\"\"\n\n    def _has_valid_digit_count(self, file_name: str) -> bool:\n        \"\"\"Checks if the file name contains no more than three digits.\"\"\"\n        digit_count = sum(1 for char in file_name if char.isdigit())\n        return digit_count <= 3\n\n    def _has_exactly_one_dot(self, file_name: str) -> bool:\n        \"\"\"Checks if the file name contains exactly one dot.\"\"\"\n        return file_name.count('.') == 1\n\n    def _has_valid_prefix(self, file_name: str) -> bool:\n        \"\"\"Validates the substring before the dot.\n        It must not be empty and must start with a letter.\"\"\"\n        if '.' not in file_name:\n            return False\n        prefix = file_name.split('.')[0]\n        if not prefix:\n            return False\n        return prefix[0].isalpha()\n\n    def _has_valid_extension(self, file_name: str) -> bool:\n        \"\"\"Validates the file extension against allowed types.\"\"\"\n        if '.' not in file_name:\n            return False\n        extension = file_name.split('.')[-1]\n        return extension in VALID_EXTENSIONS\n\n    def is_valid(self, file_name: str) -> bool:\n        \"\"\"Orchestrates all individual validation checks.\n        Returns True if all conditions are met, False otherwise.\"\"\"\n        if not self._has_exactly_one_dot(file_name):\n            return False\n        if not self._has_valid_prefix(file_name):\n            return False\n        if not self._has_valid_extension(file_name):\n            return False\n        if not self._has_valid_digit_count(file_name):\n            return False\n        return True\ndef file_name_check(file_name: str) -> str:\n    \"\"\"Public function to validate a file name and return 'Yes' or 'No'.\n    It uses FileNameValidator to perform the checks.\"\"\"\n    validator = FileNameValidator()\n    if validator.is_valid(file_name):\n        return 'Yes'\n    else:\n        return 'No'"}
