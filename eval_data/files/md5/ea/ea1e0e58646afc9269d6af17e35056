ounds for a matrix with {num_cols} columns.\")\n\n    max_val = float('-inf')\n\n    for row in matrix:\n        # Assuming the matrix is rectangular as per design,\n        # so row[n_column] will always be valid after initial checks.\n        current_value = row[n_column]\n        max_val = max(max_val, current_value)\n\n    return max_val", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[-5, -2, -10], [-5, -2, -10], [-8, -3, -7], [-6, -9, -4]], -1]]}], "Mbpp/615": [{"task_id": "Mbpp/615", "solution": "def average_tuple(data_tuples):\n    \"\"\"\n    Calculates the average value for each inner tuple within a given tuple of tuples.\n\n    Args:\n        data_tuples (tuple[tuple[int | float, ...], ...]):\n            A tuple where each element is itself a tuple of numeric values (int or float).\n\n    Returns:\n        list[float]: A list containing the calculated average for each corresponding\n                     inner tuple from the input `data_tuples`. The order of averages\n                     in the output list will match the order of the inner tuples in the input.\n\n    Raises:\n        TypeError: If `data_tuples` is not a tuple, or if an element within `data_tuples`\n                   is not a tuple, or if an element within an inner tuple is not numeric.\n        ZeroDivisionError: If an `inner_tuple` is empty (contains no elements).\n    \"\"\"\n    averages = []\n    for inner_tuple in data_tuples:\n        # Pre-condition: inner_tuple must be a tuple and contain numeric values.\n        # Python's sum() will raise TypeError if elements are not numeric.\n        # len() will work for any iterable, but the design specifies inner_tuple.\n        sum_elements = sum(inner_tuple)\n        count_elements = len(inner_tuple)\n\n        # Error Handling: ZeroDivisionError is raised if count_elements is 0,\n        # consistent with the design specification for empty inner tuples.\n        average = sum_elements / count_elements\n        averages.append(average)\n    return averages", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[10, 10, 10, 12], [30, 45, 56, 45], [81, 80, 39, 32], [1, 2, 3, 4]]]], "plus_fail_tests": [[[[7, 8, 9], [-2, -4, -6], [0, 20, 30]]]]}], "Mbpp/616": [{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo operation on two tuples of the same length.\n\n    Args:\n        tuple1: The first tuple, containing numeric (int or float) elements.\n        tuple2: The second tuple, containing numeric (int or float) elements.\n                None of the elements in tuple2 can be zero.\n\n    Returns:\n        A new tuple containing the results of the element-wise modulo operations.\n\n    Raises:\n        TypeError: If inputs are not tuples, or if tuple elements are not numeric.\n        ValueError: If the tuples have different lengths.\n        ZeroDivisionError: If any element in tuple2 is zero.\n\n    Examples:\n        >>> tuple_modulo((10, 4, 5, 6), (5, 6, 7, 5))\n        (0, 4, 5, 1)\n        >>> tuple_modulo((7.0, 9.5), (2.0, 3.0))\n        (1.0, 0.5)\n        >>> tuple_modulo((), ())\n        ()\n    \"\"\"\n    # FR2: Input Validation - Tuple Type\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Inputs must be tuples.\")\n\n    # FR3: Input Validation - Tuple Length\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Tuples must have the same length.\")\n\n    result_list = []\n    # FR1: Element-wise Modulo Calculation\n    for i in range(len(tuple1)):\n        element1 = tuple1[i]\n        element2 = tuple2[i]\n\n        # FR4: Input Validation - Numeric Elements\n        if not isinstance(element1, (int, float)) or not isinstance(element2, (int, float)):\n            raise TypeError(\"All tuple elements must be numeric (int or float).\")\n\n        # FR5: Input Validation - Zero Divisor\