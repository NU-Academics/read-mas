ot isinstance(list_of_tuples, list):\n        raise TypeError(\"Input 'list_of_tuples' must be a list.\")\n\n    for i, item in enumerate(list_of_tuples):\n        # F.1.2 Type Check (Tuple Elements)\n        if not isinstance(item, tuple):\n            raise TypeError(f\"Element at index {i} must be a tuple, but got {type(item).__name__}.\")\n        \n        # F.1.3 Length Check (Tuples)\n        if len(item) != 2:\n            raise ValueError(f\"Tuple at index {i} must contain exactly two elements, but got {len(item)}.\")\n        \n        # F.1.4 Type Check (Numeric Elements)\n        if not (isinstance(item[0], (int, float)) and isinstance(item[1], (int, float))):\n            raise TypeError(f\"Elements of tuple at index {i} must be numeric (int or float), but got types {type(item[0]).__name__} and {type(item[1]).__name__}.\")\n\n        # F.2 Product Calculation\n        current_product = item[0] * item[1]\n        \n        # F.3 Minimum Product Determination\n        # Comparisons with NaN typically return False, so NaN products will not\n        # update min_product_value unless min_product_value is also NaN (which it isn't initially).\n        if current_product < min_product_value:\n            min_product_value = current_product\n        \n        found_valid_product = True\n\n    # F.4 Handling Empty Input or No Valid Products & F.5 Output\n    if found_valid_product:\n        return min_product_value\n    else:\n        return None", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/410": [{"task_id": "Mbpp/410", "solution": "def min_numeric_value(input_list: list) -> [int | float | None]:\n    \"\"\"\n    Finds the minimum numeric value in a heterogeneous list.\n\n    Args:\n        input_list: A list containing elements of various data types.\n\n    Returns:\n        The minimum integer or float value found in the list.\n        Returns None if the list is empty or contains no numeric values.\n   