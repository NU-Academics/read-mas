ime number\n    is_prime[1] = False  # 1 is not a prime number (but is a ludic number)\n\n    # FR-2: Ludic Number Identification using Sieve for primes\n    # Iterate from p = 2 up to sqrt(N)\n    for p in range(2, int(math.sqrt(N)) + 1):\n        # If is_prime[p] is still True, then p is a prime number\n        if is_prime[p]:\n            # Mark all multiples of p (starting from p*p) as not prime.\n            # Multiples smaller than p*p would have already been marked by smaller prime factors.\n            for multiple in range(p * p, N + 1, p):\n                is_prime[multiple] = False\n\n    # FR-3, FR-4: Construct the list of ludic numbers, ensuring ascending order.\n    ludic_numbers = []\n    ludic_numbers.append(1)  # 1 is a ludic number by definition\n\n    # Add all identified prime numbers (from 2 up to N) to the list\n    for i in range(2, N + 1):\n        if is_prime[i]:\n            ludic_numbers.append(i)\n\n    return ludic_numbers", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[25]], "plus_fail_tests": [[100]]}], "Mbpp/604": [{"task_id": "Mbpp/604", "solution": "def reverse_words(input_string: str) -> str:\n    \"\"\"\n    Reverses the order of words in a given string.\n\n    Words are delimited by one or more space characters.\n    Leading, trailing, and multiple internal spaces are handled such that\n    the output string has words separated by exactly one space, with no\n    leading or trailing spaces (unless the result is an empty string).\n\n    Args:\n        input_string: The string whose words need to be reversed.\n\n    Returns:\n        A new string with the words from input_string in reverse order.\n    \"\"\"\n    # Split the input string into a list of words.\n    # str.split() without arguments splits by any whitespace and\n    # automatically handles multiple spaces as a single delimiter,\n    # and discards empty strings resulting from leading/trailing spaces.\n    words = input_string.split()\n\n    # Reverse the order of words in the list.\n    # Using slicing [::-1] creates a new reversed list without modifying the original.\n    reversed_words = words[::-1]\n\n    # Join the reversed words back into a single string,\n    # with exactly one space character between each word.\n    # If reversed_words is empty (e.g., from an empty input or a string\n    # with only spaces), \" \".join([]) correctly returns an empty string.\n    result = \" \".join(reversed_words)\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/606": [{"task_id": "Mbpp/606", "solution": "import math", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/607": [{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Tuple, Optional", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/605": [{"task_id": "Mbpp/605", "solution": "import math\ndef prime_num(n: int) -> bool:\n    \"\"\"\n    Checks if a given integer n is a prime number.\n\n    Args:\n        n (int): The integer to check.\n\n    Returns:\n        bool: True if n is prime, False otherwise.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:  # All even numbers greater than 2 are not prime\n        return False\n    \n    # Check for divisibility from 3 up to sqrt(n)\n    # Increment by 2 to only check odd divisors\n    limit = int(math.sqrt(n)) + 1\n    for i in range(3, limit, 2):\n        if n % i == 0:\n            return False\n            \n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/610": [{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"\n    Creates a new list by removing the k'th element (1-indexed) from a given input list.\n\n    If k is out of bounds (less than 1 or greater than the length of the list),\n    the original list is returned unmodified.\n\n    Args:\n        input_list: The list from which to remove an element.\n        k: The 1-indexed position of the element to remove.\n\n    Returns:\n        A new list with the k'th element removed, or the original list if k is out of bounds.\n    \"\"\"\n    n = len(input_list)\n\n    # REQ-F1.2: If k is less than 1 or k is greater than the length of input_list,\n    # the function shall return the original input_list unmodified.\n    if k < 1 or k > n:\n        return input_list\n\n    # Convert 1-indexed k to 0-indexed position\n    index_to_remove = k - 1\n\n    # REQ-F1.3: If k is within the valid range, the function shall return a *new* list\n    # that contains all elements from input_list except for the element at the k'th position.\n    # REQ-F1.4: The original input_list shall not be modified by the function.\n    # This is achieved by slicing and concatenating, which creates new lists.\n    new_list = input_list[:index_to_remove] + input_list[index_to_remove + 1:]\n\n    return new_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/608": [{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number.\n\n    The Bell number B_n counts the number of partitions of a set with n elements.\n    This implementation uses the Bell Triangle (Aitken's Array) method.\n\n    Args:\n        n (int): A non-negative integer representing the index of the Bell number.\n\n    Returns:\n        int: The nth Bell number.\n\n    Raises:\n        TypeError: If n is not an integer.\n        ValueError: If n is a negative integer.\n\n    Examples:\n        >>> bell_Number(0)\n        1\n        >>> bell_Number(1)\n        1\n        >>> bell_Number(2)\n        2\n        >>> bell_Number(3)\n        5\n        >>> bell_Number(4)\n        15\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return 1\n\n    # Initialize a 2D array for the Bell Triangle\n    # bell_triangle[i][j] stores the element at row i, column j\n    # We need n+1 rows and n+1 columns\n    bell_triangle = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Base case for B_0\n    bell_triangle[0][0] = 1\n\n    # Fill the Bell Triangle\n    for i in range(1, n + 1):\n        # The first element of the current row is the last element of the previous row\n        bell_triangle[i][0] = bell_triangle[i-1][i-1]\n        for j in range(1, i + 1):\n            # Each subsequent element in a row is the sum of the element to its left\n            # in the same row and the element above and to its left in the previous row.\n            bell_triangle[i][j] = bell_triangle[i][j-1] + bell_triangle[i-1][j-1]\n\n    # The nth Bell number is the first element of the nth row (B_n = bell_triangle[n][0])\n    return bell_triangle[n][0]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/612": [{"task_id": "Mbpp/612", "solution": "from typing import List, Any\ndef merge(list_of_lists: List[List[Any]]) -> List[List[Any]]:\n    \"\"\"\n    Merges a list of two-element sublists into a list of two lists.\n\n    The first returned list contains the first element of each sublist from the input,\n    and the second returned list contains the second element of each sublist from the input.\n\n    Args:\n        list_of_lists: A list of lists, where each sublist must contain exactly two elements.\n\n    Returns:\n        A list of two lists. The first inner list contains all first elements,\n        and the second inner list contains all second elements from the input sublists,\n        preserving their original order.\n        Returns [[], []] if the input list_of_lists is empty.\n\n    Example:\n   