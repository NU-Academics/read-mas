word_count = word_counts[word]\n\n        # a. Skip if Already Processed:\n        # If the current count is 0, all instances of this word have already\n        # been used to form pairs, so skip it.\n        if current_word_count == 0:\n            continue\n\n        # b. Calculate Reversed Word:\n        # The comparison must be case-sensitive (Constraint 2.4).\n        reversed_word = word[::-1]\n\n        # c. Handle Palindromes:\n        # F.FUN.003 - Unique Pair Counting for palindromes.\n        if word == reversed_word:\n            # If the word is a palindrome, it pairs with other instances of itself.\n            # Example: ['madam', 'madam'] forms 1 pair.\n            # Only count if there are at least two instances.\n            if current_word_count >= 2:\n                reverse_pair_count += current_word_count // 2\n            # Mark all instances of this palindrome as processed.\n            # This ensures they are not re-processed or double-counted.\n            word_counts[word] = 0\n        else:\n            # d. Handle Non-Palindrome Pairs:\n            # F.FUN.002 - Reverse Pair Identification (case-sensitive)\n            # Check if the reversed word exists in our frequency map and has a positive count.\n            reversed_word_current_count = word_counts.get(reversed_word, 0)\n\n            if reversed_word_current_count > 0:\n                # F.FUN.003 - Unique Pair Counting for non-palindromes.\n                # Determine the number of pairs that can be formed.\n                # This is limited by the minimum of the counts of the word and its reverse.\n                # Example: ['a', 'b', 'a', 'b'] where 'b' is reverse of 'a'.\n                # current_word_count['a'] = 2, reversed_word_current_count['b'] = 2.\n                # num_pairs_found = min(2, 2) = 2.\n                num_pairs_found = min(current_word_count, reversed_word_current_count)\n                \n                reverse_pair_count += num_pairs_found\n                \n                # Decrement counts for both the word and its reverse.\n                # This marks these instances as \"used up\" and prevents double-counting.\n                word_counts[word] -= num_pairs_found\n                word_counts[reversed_word] -= num_pairs_found\n    \n    # F.FUN.006 - Handling List with No Pairs:\n    # If no pairs are found, reverse_pair_count will remain 0, which is correctly returned.\n    # F.FUN.004 - Output Specification:\n    return reverse_pair_count", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[["abc", "cba", "def", "fed", "hij", "jih", "klm", "mlk", "def"]]]}], "Mbpp/759": [{"task_id": "Mbpp/759", "solution": "import re\ndef is_decimal(s: str) -> bool:\n    if not isinstance(s, str):\n        return False\n    \n    # Regex pattern:\n    # ^          - start of the string\n    # -?         - optional negative sign\n    # \\d+        - one or more digits before the decimal point\n    # \\.         - a literal decimal point\n    # \\d{2}      - exactly two digits after the decimal point\n    # $          - end of the string\n    pattern = r\"^-?\\d+\\.\\d{2}$\"\n    \n    return re.fullmatch(pattern, s) is not None", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["-123.11"]]}], "Mbpp/760": [{"task_id": "Mbpp/760", "solution": "def is_single_distinct_element(numbers: list) -> bool:\n    \"\"\"\n    Checks if a list of numbers contains exactly one distinct element.\n\n    Args:\n        numbers: A list of numerical values (integers or floats).\n\n    Returns:\n        True if the list contains one distinct element (e.g., [5], [5, 5, 5]).\n        False if the list is empty ([]), or contains two or more distinct elements\n        (e.g., [1, 2], [1, 1, 2]).\n    \"\"\"\n    # REQ-002: Handle empty list scenario\n    if not numbers:\n        return False\n\n    # REQ-003: If the list has only one element, the loop below won't run,\n  