t number\n    # Convert to string for length calculation, as it's straightforward and efficient for typical numbers.\n    num_digits = len(str(original_number))\n\n    sum_of_powers = 0\n    temp_number = number # Use a temporary variable to extract digits\n\n    # F-REQ-003: Power Calculation and Summation\n    while temp_number > 0:\n        digit = temp_number % 10  # Extract the last digit\n        sum_of_powers += digit ** num_digits  # Raise digit to the power of num_digits and add to sum\n        temp_number //= 10  # Remove the last digit by integer division\n\n    # F-REQ-004: Comparison and Result\n    # Compare the calculated sum with the original input number\n    return sum_of_powers == original_number", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/271": [{"task_id": "Mbpp/271", "solution": "def even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the first n even natural numbers, each raised to the fifth power.\n\n    Args:\n        n: An integer representing the count of even natural numbers to consider.\n           Must be a non-negative integer (n >= 0).\n\n    Returns:\n        An integer representing the total sum.\n    \"\"\"\n    total_sum = 0\n\n    # The loop iterates from 1 up to n (inclusive) to find the first n even numbers.\n    # For n=0, range(1, 1) is empty, and the loop won't execute, returning 0.\n    for i in range(1, n + 1):\n        even_num = 2 * i\n        power_fifth = even_num ** 5\n        total_sum += power_fifth\n\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/600": [{"task_id": "Mbpp/600", "solution": "def is_Even(number: int) -> bool:\n    \"\"\"\n    Checks if the given integer is an even number.\n\n    Args:\n        number (int): The integer to check.\n\n    Returns:\n        bool: True if the number is even, False otherwise.\n    \"\"\"\n    return number % 2 == 0", "base_