 or not isinstance(list2, list):\n        raise TypeError(\"Both inputs must be lists for element-wise division.\")\n\n    # ER2: Length Mismatch\n    if len(list1) != len(list2):\n        raise ValueError(\"Input lists must have the same length for element-wise division.\")\n\n    result = []\n    for i in range(len(list1)):\n        num1 = list1[i]\n        num2 = list2[i]\n\n        # ER3: Non-Numeric Elements\n        if not isinstance(num1, (int, float)) or not isinstance(num2, (int, float)):\n            raise TypeError(f\"List elements must be numbers (int or float). Found non-numeric value at index {i}.\")\n\n        # ER4: Division by Zero\n        if num2 == 0:\n            raise ZeroDivisionError(f\"Cannot divide by zero at index {i}.\")\n\n        # FR2 & FR4: Perform Division and ensure float result\n        result.append(float(num1) / num2)\n\n    # FR3: Return Value\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/620": [{"task_id": "Mbpp/620", "solution": "from typing import List\ndef largest_subset(numbers: List[int]) -> int:\n    \"\"\"\n    Determines the size of the largest subset from a given list of numbers,\n    such that every pair of numbers within that subset is mutually divisible.\n\n    Args:\n        numbers: A list of integers.\n\n    Returns:\n        An integer representing the maximum possible size of such a subset.\n    \"\"\"\n    # Handle Edge Case 1: If numbers is empty, return 0.\n    if not numbers:\n        return 0\n\n    # Handle Edge Case 2: If numbers contains only one element, return 1.\n    if len(numbers) == 1:\n        return 1\n\n    # Sort the input list in non-decreasing order.\n    # This simplifies divisibility checks as we only need to check\n    # if sorted_numbers[i] is divisible by sorted_numbers[j] for j < i.\n    sorted_numbers = sorted(numbers)\n    n = len(sorted_numbers)\n\n    # Initialize dp array. dp[i] will store the length of the largest\n    # divisible subset ending with sorted_numbers[i].\n    # Each number itself forms a divisible subset of size 1.\n    dp = [1] * n\n\n    # Populate DP array\n    # Iterate through each number in the sorted list\n    for i in range(n):\n        # For each number, check against all preceding numbers\n        for j in range(i):\n            # If the current number is divisible by a preceding number,\n            # it means sorted_numbers[i] can extend the divisible subset\n            # that ends with sorted_numbers[j].\n            if sorted_numbers[i] % sorted_numbers[j] == 0:\n                # Update dp[i] to be the maximum of its current value\n                # and (length of subset ending at sorted_numbers[j] + 1).\n                dp[i] = max(dp[i], dp[j] + 1)\n\n    # The largest value in the dp array is the size of the overall\n    # largest divisible subset.\n    return max(dp)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[9, 3, 12, 7, 16, 3, 11, 8, 4, 13, 13]]]}], "Mbpp/622": [{"task_id": "Mbpp/622", "solution": "def get_median(list1: list[int], list2: list[int], n: int) -> float:\n    \"\"\"\n    Calculates the median of two equally sized sorted lists of integers.\n\n    Args:\n        list1: The first sorted list of integers.\n        list2: The second sorted list of integers.\n        n: The common size of list1 and list2.\n\n    Returns:\n        The median of the combined 2n elements as a float.\n        The median for an even number of elements is the average of the two middle elements.\n\n    Raises:\n        ValueError: If n is non-positive or if list lengths do not match n.\n        TypeError: If inputs are not lists or if n is not an integer.\n    \"\"\"\n    # Input validation as per System Design Document's error handling section\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n    if not isinstance(list1, list) or not isinstance(list2, list):\n        raise TypeError(\"list1 and list2 must be lists.\")\n    if len(list1) != n or len(list2) != n:\n        raise ValueError(f\"list1 and list2 must both be of size n ({n}).\")\n    \n    # Check for empty lists if n=0 was allowed (not the case here, n>0 is enforced)\n    # The SRS guarantees sorted lists of integers.\n\n    i = 0  # Pointer for list1\n    j = 0  # Pointer for list2\n\n    m1 = -1  # Stores the (n)-th smallest element\n    m2 = -1  # Stores the (n+1)-th smallest element\n\n    # Iterate n+1 times to find the n-th and (n+1)-th smallest elements\n    for count in range(n + 1):\n        m1 = m2  # The previous m2 becomes the current m1\n\n        if i == n:\n            # list1 is exhausted, take from list2\n            m2 = list2[j]\n            j += 1\n        elif j == n:\n            # list2 is exhausted, take from list1\n            m2 = list1[i]\n            i += 1\n        elif list1[i] <= list2[j]:\n            # Current element in list1 is smaller or equal\n            m2 = list1[i]\n            i += 1\n        else:\n            # Current element in list2 is smaller\n            m2 = list2[j]\n            j += 1\n            \n    # After the loop, m1 holds the n-th smallest element\n    # and m2 holds the (n+1)-th smallest element.\n    # The median for an even number of total elements (2n) is the average of these two.\n    return (m1 + m2) / 2.0", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[3, 6, 14, 23], [2, 18, 27, 39, 49, 55], 4]]}], "Mbpp/624": [{"task_id": "Mbpp/624", "solution": "def to_uppercase(input_string: str) -> str:\n    \"\"\"\n    Converts a given string to its uppercase equivalent.\n\n    This function takes a string as input and returns a new string\n    where all alphabetic characters are converted to uppercase.\n    Non-alphabetic characters remain unchanged.\n\n    Args:\n        input_string: The string to be converted.\n\n    Returns:\n        A new string with all alphabetic characters in uppercase.\n    \"\"\"\n    return input_string.upper()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/623": [{"task_id": "Mbpp/623", "solution": "def nth_nums(numbers: list, n: int) -> list:\n    \"\"\"\n    Computes the n-th power of each number in a list.\n\n    Args:\n        numbers (list): A list of numerical values (int or float).\n        n (int): The integer exponent to raise each number to.\n\n    Returns:\n        list: A new list where each element is the corresponding number\n              from the input list raised to the power of 'n'.\n\n    Raises:\n        TypeError: If 'numbers' is not a list, 'n' is not an integer,\n                   or if any element in 'numbers' is not a numerical type (int or float).\n    \"\"\"\n    # F.4 Input Validation for 'numbers' list type\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n\n    # F.4 Input Validation for 'n' exponent type\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' (exponent) must be an integer.\")\n\n    # F.3 Return new list: Initialize an empty list for results\n    result_list = []\n\n    # F.2 Apply to each element & F.1 Compute n-th power\n    # F.5 Empty List Handling: If 'numbers' is empty, this loop is skipped,\n    # and an empty 'result_list' is returned.\n    for num in numbers:\n        # F.4 Input Validation for elements within 'numbers' list\n        if not isinstance(num, (int, float)):\n            raise TypeError(f\"All elements in 'numbers' list must be numerical (int or float), \"\n                            f\"but found type {type(num).__name__} for value {num}.\")\n        \n        # Calculate the n-th power and append to the result list\n        result_list.append(num ** n)\n\n    return result_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/626": [{"task_id": "Mbpp/626", "solution": "def triangle_area(radius: [float, int]) -> [float, None]:\n    \"\"\"\n    Calculates the area of the largest triangle that can be inscribed in a semicircle\n    with a given radius.\n\n    The largest triangle inscribed in a semicircle has its base as the diameter\n    and its height as the radius. The area formula is (1/2) * base * height,\n    which simplifies to radius * radius (radius^2).\n\n    Args:\n        radius (float or int): The radius of the semicircle. Must be non-negative.\n\n    Returns:\n        float: The calculated area if radius is non-negative.\n        None: If radius is negative, as a valid geometric radius cannot be negative.\n    \"\"\"\n    if radius < 0:\n        return None\n    \n    # Mathematical derivation:\n    # Base of the largest inscribed triangle = Diameter = 2 * radius\n    # Height of the largest inscribed triangle = Radius\n    # Area = (1/2) * Base * Height\n    # Area = (1/2) * (2 * radius) * radius\n    # Area = radius * radius\n    \n    return float(radius * radius)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[999999999]]}], "Mbpp/628": [{"task_id": "Mbpp/628", "solution": "from fastapi import FastAPI, HTTPException, status\nfrom pydantic import BaseModel\ndef replace_spaces(input_string: str) -> str:\n    \"\"\"\n    Replaces all space characters (' ') in the input string with the URL-encoded string '%20'.\n\n    Args:\n        input_string: The string to process.\n\n    Returns:\n        A new string with all spaces replaced by '%20'.\n\n    Raises:\n        TypeError: If the input_string is not a string.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n    return input_string.replace(' ', '%20')", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/629": [{"task_id": "Mbpp/629", "solution": "def Split(numbers: list) -> list:\n    \"\"\"\n    Filters a list of numbers, returning a new list containing only the even numbers.\n\n    Args:\n        numbers: A list of integers.\n\n    Returns:\n        A new list containing only the even numbers from the input list,\n        maintaining their original order.\n\n    Raises:\n        TypeError: If the input 'numbers' is not a list.\n\n    Example:\n        >>> Split([1, 2, 3, 4, 5])\n        [2, 4]\n        >>> Split([])\n        []\n        >>> Split([2, 4, 6])\n        [2, 4, 6]\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list of numbers.\")\n\n    even_numbers = []\n    for number in numbers:\n        # The SRS defines an even number as n % 2 == 0.\n        # This handles integers (positive, negative, zero) and floats.\n        if number % 2 == 0:\n            even_numbers.append(number)\n\n    return even_numbers", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/631": [{"task_id": "Mbpp/631", "solution": "import re", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/633": [{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(arr: list[int], N: int) -> int:\n    \"\"\"\n    Calculates the sum of the XOR of all unique pairs of numbers within a given list of integers.\n\n    The function computes sum(arr[i] ^ arr[j]) for all 0 <= i < j < N.\n    It uses a bitwise approach to achieve O(N * MAX_BITS) time complexity.\n\n    Args:\n        arr: A list of N non-negative integer values.\n        N: An integer representing the actual length of arr.\n\n    Returns:\n        An integer representing the sum of XORs of all pairs.\n        Returns 0 if N is less than 2, as no pairs can be formed.\n\n    Pre-conditions:\n        - arr is not None.\n        - N >= 0.\n        - If N > 0, arr contains N integer elements.\n        - All elements in arr are non-negative.\n\n    Examples:\n        pair_xor_Sum([5, 9, 7, 6], 4) == 47\n        pair_xor_Sum([1, 2, 3], 3) == 6\n        pair_xor_Sum([10], 1) == 0\n        pair_xor_Sum([], 0) == 0\n    \"\"\"\n    total_xor_sum = 0\n\n    # Handle edge cases where no pairs can be formed (N < 2).\n    # The main loop logic would naturally result in 0, but this provides an early exit.\n    if N < 2:\n        return 0\n\n    # MAX_BITS is the maximum number of bits to check.\n    # As per the SRS, 31 bits are sufficient for values up to 2*10^9.\n    # Python's integers support arbitrary precision, so iterating up to a reasonable\n    # fixed maximum bit count (like 31 or 60 for larger numbers) is standard practice\n    # unless a truly dynamic bit length is required for extremely large numbers.\n    MAX_BITS = 31\n\n    # Iterate through each bit position from 0 up to MAX_BITS - 1\n    for k in range(MAX_BITS):\n        count_set_k = 0  # Counter for numbers with the k-th bit set to 1\n\n        # Iterate through each number in the input list\n        for num in arr:\n            # Check if the k-th bit of 'num' is set (i.e., is 1)\n            # (num >> k) shifts the k-th bit to the 0th position.\n            # & 1 isolates that bit.\n            if (num >> k) & 1:\n                count_set_k += 1\n\n        # Calculate the count of numbers with the k-th bit unset (i.e., is 0)\n        count_unset_k = N - count_set_k\n\n        # For the k-th bit, a pair (arr[i], arr[j]) will have its k-th XOR bit as 1\n        # if and only if their k-th bits are different (one is 0, the other is 1).\n        # The number of such pairs is `count_set_k * count_unset_k`.\n        # Each such pair contributes `(1 << k)` to the total sum for this bit position.\n        # (1 << k) represents 2^k, the value of the k-th bit.\n        contribution_k = count_set_k * count_unset_k * (1 << k)\n\n        # Add the contribution of the current bit position to the total sum\n        total_xor_sum += contribution_k\n\n    return total_xor_sum", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, 2, 3, 2, 1, 2, 3, 4, 5, 4, 5, 3], 11]]}], "Mbpp/632": [{"task_id": "Mbpp/632", "solution": "def move_zero(numbers: list) -> list:\n    \"\"\"\n    Rearranges a list of numbers by moving all zero elements to the end\n    while preserving the relative order of non-zero elements.\n\n    Args:\n        numbers: A list of numerical elements (integers or floats).\n\n    Returns:\n        A new list with all non-zero elements followed by all zero elements,\n        maintaining original relative order within each group.\n    \"\"\"\n    non_zeros = []\n    zeros = []\n\n    for element in numbers:\n        if element == 0:\n            zeros.append(element)\n        else:\n            non_zeros.append(element)\n\n    return non_zeros + zeros", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/635": [{"task_id": "Mbpp/635", "solution": "def heap_sort(arr: list) -> None:\n    \"\"\"\n    Sorts a list in ascending order using the Heap Sort algorithm.\n    Modifies the list in-place.\n\n    Args:\n        arr: The list of comparable elements to be sorted.\n             Elements must support comparison operations.\n    \"\"\"\n    n = len(arr)\n\n    # Handle edge cases: empty or single-element list\n    if n <= 1:\n        return\n\n    # Build a max-heap (rearrange array)\n    # Iterate from the last non-leaf node down to the root (index 0)\n    for i in range(n // 2 - 1, -1, -1):\n        _heapify(arr, n, i)\n\n    # One by one extract elements from heap\n    # Iterate from the last element of the heap down to the second element\n    for i in range(n - 1, 0, -1):\n        # Move current root (largest element) to end of the unsorted portion\n        arr[i], arr[0] = arr[0], arr[i]\n        # Call _heapify on the reduced heap\n        # 'i' represents the new size of the heap after extractio