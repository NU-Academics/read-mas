eger.\")\n    if not isinstance(power, int):\n        raise TypeError(\"Input 'power' must be an integer.\")\n    \n    if power < 0:\n        raise ValueError(\"Input 'power' cannot be negative as digit sum for non-integer results is undefined.\")\n\n    # Calculate base ** power\n    result_of_power = base ** power\n\n    # Convert the absolute value of the result to a string to handle negative results correctly\n    # (e.g., (-2)**3 = -8, abs(-8) = 8, sum of digits of 8 is 8)\n    result_str = str(abs(result_of_power))\n\n    # Calculate the sum of its digits\n    digit_sum = sum(int(digit) for digit in result_str)\n\n    return digit_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/728": [{"task_id": "Mbpp/728", "solution": "def sum_list(list1: list, list2: list) -> list:\n    \"\"\"\n    Computes the element-wise sum of two input lists.\n\n    Args:\n        list1: The first list of numbers.\n        list2: The second list of numbers.\n\n    Returns:\n        A new list where each element is the sum of corresponding elements\n        from list1 and list2.\n\n    Raises:\n        ValueError: If the input lists have different lengths.\n        TypeError: If elements at a given index are not summable.\n    \"\"\"\n    # FR002: Input List Length Validation\n    if len(list1) != len(list2):\n        raise ValueError(\"Input lists must have the same number of elements.\")\n\n    # FR001: Element-wise Summation\n    result = []\n    for i in range(len(list1)):\n        try:\n            result.append(list1[i] + list2[i])\n        except TypeError:\n            # This handles cases where elements are not summable (e.g., number + string)\n            # and propagates Python's default TypeError which is generally desired.\n            raise TypeError(f\"Elements at index {i} are not summable: {list1[i]} and {list2[i]}\")\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "pl