s zero or negative,\n            # adding more full repetitions will not increase the maximum sum.\n            # In this case, the maximum sum will be found within the first\n            # two repetitions, which is covered by max_sum_double_arr.\n            return max_sum_double_arr", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/287": [{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers.\n\n    Args:\n        n (int): The number of even natural numbers to consider.\n                 If n is non-positive, the function returns 0.\n\n    Returns:\n        int: The sum of squares of the first n even natural numbers.\n             Returns 0 if n <= 0.\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    total_sum = 0\n    for i in range(1, n + 1):\n        current_even_number = 2 * i\n        square = current_even_number * current_even_number\n        total_sum += square\n\n    return total_sum", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[1000000]]}], "Mbpp/290": [{"task_id": "Mbpp/290", "solution": "def max_length(list_of_lists: list[list]) -> tuple[int, list]:\n    # FR3: Handle empty input list\n    if not list_of_lists:\n        return (0, [])\n\n    # Initialize variables (FR1, FR2)\n    max_len = 0\n    max_list = []\n\n    # Iterate through each inner list\n    for inner_list in list_of_lists:\n        current_len = len(inner_list)  # FR1\n\n        # Update if a new maximum length is found\n        # Using '>' ensures that 'max_list' stores the *first* list encountered\n        # for a given maximum length, as per FR2.\n        if current_len > max_len:\n            max_len = current_len\n            max_list = inner_list  # Assign the reference to the inner_list (FR2)\n\n    # FR4: Return the final result\n    return (max_len, max_list)", "base_status": "pass", "