               if it exists, or None otherwise.\n    \"\"\"\n    # EQN-004: Handle special case where both a and b are 0.\n    if a == 0 and b == 0:\n        if n == 0:\n            # If 0x + 0y = 0, any integer pair (x, y) is a solution.\n            # We return (0, 0) as one such valid pair.\n            return (0, 0)\n        else:\n            # If 0x + 0y = n where n != 0, no solution exists.\n            return None\n\n    # For all other cases (at least one of a or b is non-zero),\n    # use the Extended Euclidean Algorithm to find gcd(a, b) and Bezout coefficients.\n    # The _extended_gcd function is robust enough to handle cases where one of a or b is zero\n    # (e.g., a=0, b!=0 or a!=0, b=0).\n    g, x0, y0 = _extended_gcd(a, b)\n\n    # EQN-003: Check for solvability.\n    # A linear Diophantine equation ax + by = n has integer solutions\n    # if and only if n is divisible by g (gcd(a, b)).\n    if n % g != 0:\n        return None  # No integer solution exists.\n\n    # EQN-002: Calculate a particular solution.\n    # If a solution exists, we scale the Bezout identity (a*x0 + b*y0 = g)\n    # by n/g to get a solution for ax + by = n.\n    k = n // g  # Scaling factor. n is guaranteed to be divisible by g here.\n    x = x0 * k\n    y = y0 * k\n\n    return (x, y)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[2, 3, 7]], "plus_fail_tests": [[25, 10, 500]]}], "Mbpp/161": [{"task_id": "Mbpp/161", "solution": "def remove_elements(target_list: list, elements_to_remove_list: list) -> list:\n    \"\"\"\n    Removes all elements from target_list that are present in elements_to_remove_list.\n\n    Args:\n        target_list (list): The list from which elements will be removed.\n        elements_to_remove_list (list): The list containing elements to be removed.\n\n    Returns:\n        list: A new list with elements from target_list that are not in elements_to_remove_list,\n              preserving their original order.\n\n    Raises:\n     