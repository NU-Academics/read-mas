or\nfrom fastapi.responses import JSONResponse\nfrom pydantic import BaseModel, Field\nfrom typing import List, Union\ndef find_first_occurrence(arr: List[int], target: int) -> int:\n    \"\"\"\n    Finds the zero-based index of the first occurrence of a target number\n    in a sorted array using a modified binary search algorithm.\n\n    Args:\n        arr: A list of integers, sorted in non-decreasing order.\n        target: The integer number to search for.\n\n    Returns:\n        The index of the first occurrence of the target, or -1 if not found.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    result_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2  # Prevents potential overflow for very large low/high\n        if arr[mid] == target:\n            result_index = mid  # Potential first occurrence, store it\n            high = mid - 1     # Try to find an earlier occurrence in the left half\n        elif arr[mid] < target:\n            low = mid + 1      # Target is in the right half\n        else:  # arr[mid] > target\n            high = mid - 1     # Target is in the left half\n\n    return result_index", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/731": [{"task_id": "Mbpp/731", "solution": "import math\nclass InvalidGeometricInputError(ValueError):\n    \"\"\"Custom exception for invalid geometric inputs.\"\"\"\n    pass\ndef lateralsurface_cone(r: float, h: float) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n\n    Args:\n        r (float): The radius of the cone's base. Must be > 0.\n        h (float): The perpendicular height of the cone. Must be > 0.\n\n    Returns:\n        float: The lateral surface area of the cone.\n\n    Raises:\n        InvalidGeometricInputError: If radius or height are non-positive numbers.\n    \"\"\"\n    if r <= 0:\n        raise InvalidGeometricInputError(\"Radius must be a positive number.\")\n    if h <= 0:\n 