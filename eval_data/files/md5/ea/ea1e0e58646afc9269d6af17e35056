ecute.\n    common_elements = set(nested_lists[0])\n\n    # F5 (partial): If the first sublist itself was empty, then `common_elements`\n    # will be an empty set. In this case, no elements can be common to all lists.\n    if not common_elements:\n        return set()\n\n    # F2: Iterate through the remaining sublists (from the second one onwards).\n    # F5 (optimization): If `common_elements` becomes empty at any point,\n    # we can stop early, as no further intersections can yield any common elements.\n    for i in range(1, len(nested_lists)):\n        current_sublist = nested_lists[i]\n        current_set = set(current_sublist)\n\n        # Perform set intersection. This updates `common_elements` to include\n        # only elements present in both the current `common_elements` and `current_set`.\n        common_elements = common_elements.intersection(current_set)\n\n        # Optimization: If the set of common elements becomes empty, it means there are\n        # no elements common to all lists processed so far. We can immediately return\n        # an empty set, avoiding unnecessary computations. This fully addresses FR5.\n        if not common_elements:\n            return set()\n\n    # F2, F6: After iterating through all sublists, `common_elements` contains\n    # only the elements present in every original sublist.\n    # Elements of any hashable type are correctly handled by Python's set.\n    return common_elements", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/113": [{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"\n    Determines if a given string represents a valid integer, considering both positive\n    and negative numbers, while excluding floating-point numbers and strings\n    containing non-digit characters (except for an optional leading sign).\n\n    Args:\n        input_string: The string to be evaluated.\n\n    Returns:\n        True if the input_string represents an integer, False otherwise.\n    \"\"\"\n    # 1. Trim Whitespace: Create a new string 's' by stripping leading and trailing whitespace.\n    s = input_string.strip()\n\n    # 2. Handle Empty String: If 's' is empty after trimming, it cannot be an integer.\n    if not s:\n        return False\n\n    # 3. Handle Optional Sign:\n    # Initialize a start_index variable to 0.\n    start_index = 0\n    # If the first character is '-' or '+':\n    if s[0] == '-' or s[0] == '+':\n        # Increment start_index to 1. This skips the sign for digit validation.\n        start_index = 1\n\n    # 4. Validate Remaining Characters:\n    # Check if the string segment from start_index to the end is empty.\n    # This handles cases where input_string was just \"-\" or \"+\".\n    if start_index == len(s):\n        return False\n\n    # Iterate through the characters of 's' starting from 'start_index'.\n    for char in s[start_index:]:\n        # If any character is not a digit, it's not a valid integer.\n        if not char.isdigit():\n            return False\n\n    # 5. Return True: If the function reaches this point, all conditions for a\n    # valid integer have been met.\n    return True", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[""]]}], "Mbpp/116": [{"task_id": "Mbpp/116", "solution": "def tuple_to_int(input_tuple: tuple[int, ...]) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single concatenated integer.\n\n    Args:\n        input_tuple: A tuple containing positive integers.\n                     Example: (1, 2, 3)\n\n    Returns:\n        A single integer formed by concatenating the string representations\n        of the tuple elements. Returns 0 if the input_tuple is empty.\n\n    Raises:\n        TypeError: If the input_tuple is not a tuple, or if any element\n                   within the tuple is not an integer.\n        ValueError: If any element within the tuple is not a p