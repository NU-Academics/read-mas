y the vowels within a given string.\n    Vowels are defined as 'a', 'e', 'i', 'o', 'u' (case-insensitive). 'y' is not a vowel.\n    Non-vowel characters maintain their original positions, and the case of vowels is preserved.\n\n    Args:\n        s: The input string.\n\n    Returns:\n        A new string with only the vowels reversed.\n    \"\"\"\n    vowels_set = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n    \n    # Convert the input string to a list of characters to allow in-place modification\n    char_list = list(s)\n    \n    left = 0\n    right = len(char_list) - 1\n    \n    while left < right:\n        # Move the left pointer until it finds a vowel or crosses the right pointer\n        while left < right and char_list[left] not in vowels_set:\n            left += 1\n            \n        # Move the right pointer until it finds a vowel or crosses the left pointer\n        while left < right and char_list[right] not in vowels_set:\n            right -= 1\n            \n        # If both pointers have found vowels and haven't crossed, swap them\n        if left < right:\n            char_list[left], char_list[right] = char_list[right], char_list[left]\n            # Move both pointers inwards after a swap\n            left += 1\n            right -= 1\n            \n    # Join the list of characters back into a string and return it\n    return \"\".join(char_list)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/132": [{"task_id": "Mbpp/132", "solution": "def tuple_to_string_converter(char_tuple: tuple) -> str:\n    \"\"\"\n    Converts a tuple of characters into a single string.\n\n    Args:\n        char_tuple: A tuple where each element is expected to be a single character string.\n\n    Returns:\n        A single string formed by concatenating the characters in the tuple.\n    \"\"\"\n    return \"\".join(char_tuple)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fa