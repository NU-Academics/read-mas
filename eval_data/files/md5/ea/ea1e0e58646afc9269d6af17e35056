ate 'i' from 0 up to and including 'n // 2'.\n    # In Python, range(start, stop) goes up to stop-1.\n    # So, to include (n // 2), the stop value needs to be (n // 2) + 1.\n    for i in range((n // 2) + 1):\n        term = n - (2 * i)  # Calculate the current term of the series\n        total_sum += term   # Accumulate the sum\n\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/235": [{"task_id": "Mbpp/235", "solution": "def set_even_bits(number: int) -> int:\n    \"\"\"\n    Sets all even-indexed bits of a given non-negative integer to 1,\n    while preserving its odd-indexed bits.\n\n    Args:\n        number (int): The non-negative integer whose even bits are to be set.\n\n    Returns:\n        int: The modified integer with even bits set.\n\n    Raises:\n        ValueError: If the input is not a non-negative integer.\n    \"\"\"\n    # 1. Input Validation (FR1)\n    if not isinstance(number, int) or number < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    # 2. Handle Zero Input (FR4)\n    if number == 0:\n        return 0\n\n    # 3. Determine Bit Length\n    L = number.bit_length()\n\n    # 4. Generate Dynamic Masks\n    even_mask_dynamic = 0\n    odd_mask_dynamic = 0\n    current_bit_position_value = 1  # Represents 2^0\n\n    for i in range(L):\n        if i % 2 == 0:  # Even position\n            even_mask_dynamic |= current_bit_position_value\n        else:  # Odd position\n            odd_mask_dynamic |= current_bit_position_value\n        current_bit_position_value <<= 1  # Move to the next bit position\n\n    # 5. Compute Result (FR2, FR3)\n    # Isolate odd bits from the original number, then combine with the even mask\n    result = (number & odd_mask_dynamic) | even_mask_dynamic\n\n    # 6. Return Result\n    return result", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/237": [{"task_id": "Mbpp/237", "solution": "def check_occurences(tuple_list: list) -> dict:\n    \"\"\"\n    Counts the occurrences of unique tuples within a given list of tuples,\n    treating tuples with the same elements, regardless of order, as identical.\n\n    Args:\n        tuple_list: A list where each element is expected to be a tuple.\n                    Elements within the tuples should be sortable.\n\n    Returns:\n        A dictionary mapping canonical tuples (sorted elements) to their counts.\n    \"\"\"\n    occurrence_counts = {}\n\n    for original_tuple in tuple_list:\n        # FR-3: Tuple Canonicalization\n        # 1. Convert the tuple tup into a temporary list of its elements.\n        temp_list = list(original_tuple)\n        # 2. Sort the elements of this temporary list in ascending order.\n        temp_list.sort()\n        # 3. Convert the sorted list back into a tuple.\n        canonical_tuple = tuple(temp_list)\n\n        # FR-4: Occurrence Counting\n        # FR-5: Output Format\n        occurrence_counts[canonical_tuple] = occurrence_counts.get(canonical_tuple, 0) + 1\n\n    return occurrence_counts", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/239": [{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the total number of sequences of a given length `n`,\n    where each element is a positive integer, less than or equal to `m`,\n    and greater than or equal to twice the previous element.\n\n    A valid sequence (x1, x2, ..., xn) must satisfy:\n    1. 1 <= xi <= m for all i from 1 to n.\n    2. xi >= 2 * x_{i-1} for all i from 2 to n.\n\n    Args:\n        m (int): Maximum allowed value for any element in the sequence. Must be >= 1.\n        n (int): Desired length of the sequence. Must be >= 1.\n\n    Returns:\n        int: The total count of valid sequences. Returns 0 if no valid sequences\n             can be formed under the given constraints.\n\n    Raises:\n        TypeError: If m or n are not integers.\n        ValueError: If m < 1 or n < 1.\n    \"\"\"\n    # FR-02: Input Validation\n    if not isinstance(m, int) or not isinstance(n, int):\n        raise TypeError(\"m and n must be integers.\")\n    if m < 1 or n < 1:\n        raise ValueError(\"m and n must be positive integers.\")\n\n    # FR-01, FR-03: Base Case for n=1\n    # If n is 1, any positive integer from 1 to m can be x1.\n    # So there are m such sequences.\n    if n == 1:\n        return m\n\n    # DP Initialization (for sequences of length 1)\n    # dp_prev[j] stores the number of valid sequences of length (i-1) ending with j.\n    # For length 1, each positive integer j (1 <= j <= m) forms one valid sequence (j).\n    # Array size m+1 to use 1-based indexing for values up to m.\n    dp_prev = [0] * (m + 1)\n    for j in range(1, m + 1):\n        dp_prev[j] = 1\n\n    # FR-01: Iterative DP Calculation for sequence lengths from 2 to n\n    # We build up the solution from length 2 to n.\n    # The outer loop represents the current sequence length `i`.\n    for i in range(2, n + 1):\n        dp_current = [0] * (m + 1)\n        prefix_sum_prev = [0] * (m + 1)\n\n        # Calculate Prefix Sums for dp_prev\n        # prefix_sum_prev[k] stores sum(dp_prev[x]) for 1 <= x <= k.\n        # This allows O(1) lookup for sums required by the DP recurrence.\n        for k in range(1, m + 1):\n            prefix_sum_prev[k] = prefix_sum_prev[k-1] + dp_prev[k]\n        \n        current_length_i_count = 0  # Total count of sequences for current length i\n\n        # Populate dp_current for the current length `i`\n        # `j` represents the potential last element (x_i) of a sequence of length `i`.\\\n        for j in range(1, m + 1):\n            # The previous element (x_{i-1}) must be <= j // 2 to satisfy x_i >= 2 * x_{i-1}.\n            max_prev_val = j // 2\n            \n            if max_prev_val >= 1:\n                # The number of valid sequences of length `i` ending with `j` is the sum\n                # of dp_prev[k] for all 1 <= k <= max_prev_val.\n                # This sum is efficiently retrieved from prefix_sum_prev.\n                dp_current[j] = prefix_sum_prev[max_prev_val]\n            \n            current_length_i_count += dp_current[j]\n        \n        # Early Exit Condition:\n        # If no sequences of length `i` can be formed, then no sequences of length `n`\n        # (where n > i) can be formed either.\n        if current_length_i_count == 0:\n            return 0\n            \n        # Update for Next Iteration:\n        # The `dp_current` results for length `i` become `dp_prev` for length `i+1`.\n        dp_prev = dp_current\n    \n    # FR-03: Return Result\n    # After the loop completes, current_length_i_count holds the total number\n    # of sequences of the desired length `n`.\n    return current_length_i_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/240": [{"task_id": "Mbpp/240", "solution": "def replace_last_element_with_list(primary_list, replacement_list):\n    \"\"\"\n    Replaces the last element of the primary_list with all elements from the replacement_list.\n\n    If primary_list is empty, it returns the replacement_list (a new copy).\n    If replacement_list is empty, it effectively removes the last element of primary_list.\n\n    Args:\n        primary_list (list): The list whose last element is to be replaced.\n        replacement_list (list): The list whose elements will replace the last element\n                                 of primary_list.\n\n    Returns:\n        list: A new list with the last element replaced, or replacement_list if\n              primary_list was empty.\n\n    Raises:\n        TypeError: If either primary_list or replacement_list is not a list.\n    \"\"\"\n    if not isinstance(primary_list, list):\n        raise TypeError(\"primary_list must be a list\")\n    if not isinstance(replacement_list, list):\n        raise TypeError(\"replacement_list must be a list\")\n\n    if not primary_list:\n        # F4: If primary_list is empty, return a copy of replacement_list.\n        # F7: Ensures immutability of the original replacement_list.\n        return list(replacement_list)\n    else:\n        # F3: Core logic - concatenate primary_list excluding its last element\n        #     with the replacement_list.\n        # F5: Handles empty replacement_list implicitly.\n        # F7: Slicing and concatenation create a new list, ensuring immutability.\n        return primary_list[:-1] + replacement_list", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/242": [{"task_id": "Mbpp/242", "solution": "def count_charac(text: str) -> int:\n    \"\"\"\n    Counts the total number of characters in a given string.\n\n    Args:\n        text (str): The input string.\n\n    Returns:\n        int: The total number of characters in the string.\n    \"\"\"\n    return len(text)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/244": [{"task_id": "Mbpp/244", "solution": "import math\nfrom typing import Union", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/245": [{"task_id": "Mbpp/245", "solution": "import math", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/247": [{"task_id": "Mbpp/247", "solution": "The Python code for the `lps` function is provided below. This function calculates the length of the longest palindromic subsequence in a given string using dynamic programming.", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/250": [{"task_id": "Mbpp/250", "solution": "def count_X(input_tuple: tuple, search_element: any) -> int:\n    \"\"\"\n    Counts the occurrences of a specific eleme