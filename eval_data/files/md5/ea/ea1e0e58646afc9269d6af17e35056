gs, without\n    introducing redundant spaces or incorrectly splitting words.\n\n    Args:\n        text (str): The input string to be formatted.\n\n    Returns:\n        str: A new string with spaces inserted according to the rules.\n\n    Examples:\n        >>> capital_words_spaces(\"Python\")\n        'Python'\n        >>> capital_words_spaces(\"HelloWorld\")\n        'Hello World'\n        >>> capital_words_spaces(\"ThisIsAString\")\n        'This Is A String'\n        >>> capital_words_spaces(\"already Has Spaces\")\n        'already Has Spaces'\n        >>> capital_words_spaces(\"AlreadyHasSpaces\")\n        'Already Has Spaces'\n        >>> capital_words_spaces(\"ALLCAPS\")\n        'ALLCAPS'\n        >>> capital_words_spaces(\"HTMLParser\")\n        'HTML Parser'\n        >>> capital_words_spaces(\"MyURLIsHere\")\n        'My URL Is Here'\n        >>> capital_words_spaces(\"\")\n        ''\n        >>> capital_words_spaces(\"singleword\")\n        'singleword'\n    \"\"\"\n    if not text:\n        return \"\"\n\n    result_chars = []\n\n    for i, current_char in enumerate(text):\n        # Conditions for space insertion (FR3 from SRS):\n        # 1. current_char is an uppercase letter.\n        # 2. i is not the first character of the string (i > 0), preventing leading spaces (FR4).\n        # 3. The character immediately preceding current_char is not a space (FR5).\n        if i > 0 and current_char.isupper() and text[i-1] != ' ':\n            # AND one of the following sub-conditions is true (FR3, condition 4):\n            # Sub-condition 1: The preceding character is a lowercase letter.\n            if text[i-1].islower():\n                result_chars.append(' ')\n            # Sub-condition 2: The preceding character is an uppercase letter AND\n            # there is a next character AND the next character is a lowercase letter.\n            elif text[i-1].isupper() and (i + 1 < len(text)) and text[i+1].islower():\n                result_chars.append(' ')\n        \n        result_chars.append(current_char)\n\n    return \"\".join(result_chars)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["MyNameIsAIAndIAmHereToHelpYou"]]}], "Mbpp/751": [{"task_id": "Mbpp/751", "solution": "def is_min_heap(arr: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a valid min-heap.\n\n    A min-heap is a complete binary tree where the value of each node is\n    less than or equal to the value of its children. In an array representation,\n    for any node at index i:\n    - its left child is at 2*i + 1\n    - its right child is at 2*i + 2\n\n    Args:\n        arr: A list of comparable elements.\n\n    Returns:\n        True if the array is a min-heap, False otherwise.\n    \"\"\"\n    n = len(arr)\n\n    # An empty or single-element array is always a min-heap\n    if n <= 1:\n        return True\n\n    # We only need to check non-leaf nodes.\n    # Non-leaf nodes range from index 0 to (n // 2) - 1.\n    # We iterate from the last parent node up to the root.\n    for i in range((n // 2) - 1, -1, -1):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n:  # Ensure left child exists\n            if arr[i] > arr[left_child_idx]:\n                return False\n\n        # Check right child\n        if right_child_idx < n:  # Ensure right child exists\n            if arr[i] > arr[right_child_idx]:\n                return False\n\n    # If no violations were found, it's a min-heap\n    return True", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/752": [{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number.\n\n    The Jacobsthal sequence is defined by the recurrence relation\n    J(n) = J(n-1) + 2 * J(n-2) with base cases J(0) = 0 and J(1) = 1.\n    The sequence starts: 0, 1, 1, 3, 5, 11, 21, 43, ...\n\n    Args:\n        n: A non-negative integer representing the index for which the\n           Jacobsthal number is to be calculated.\n\n    Returns:\n        The integer value of the nth Jacobsthal number.\n\n    Raises:\n        TypeError: If 'n' is not an integer.\n        ValueError: If 'n' is a negative integer.\n    \"\"\"\n    # NFR2 - Robustness: Input validation\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    # FR3, FR4 - Base cases\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    # FR5, NFR1 - Recurrence Relation with O(n) time and O(1) space complexity\n    # Initialize for J(0) and J(1) to start the iteration\n    j_prev_prev = 0  # Represents J(i-2)\n    j_prev = 1       # Represents J(i-1)\n\n    # Iterate from J(2) up to J(n)\n    for _ in range(2, n + 1):\n        j_current = j_prev + 2 * j_prev_prev\n        j_prev_prev = j_prev\n        j_prev = j_current\n\n    return j_prev", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/754": [{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    common_elements = []\n    min_len = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_len):\n        if l1[i] == l2[i] and l2[i] == l3[i]:\n            common_elements.append(l1[i])\n            \n    return common_elements", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/753": [{"task_id": "Mbpp/753", "solution": "def find_min_k_records(data: list[tuple[str, int]], k: int) -> list[tuple[str, int]]:\n    \"\"\"\n    Finds the minimum k records from a list of tuples.\n\n    Each tuple contains a string and an integer. The function returns a list\n    of k tuples with the smallest integer values, sorted by the integer value.\n\n    Args:\n     