t\n            high = mid - 1  # Target is in the left half\n    return result\ndef is_majority(sorted_array: List[Union[int, float]], n: int, element: Union[int, float]) -> bool:\n    \"\"\"\n    Determines if a given element is a \"majority element\" within a provided sorted array.\n    A majority element is an element that occurs strictly more than n/2 times in the array.\n\n    Args:\n        sorted_array: A list of numbers (integers or floats), guaranteed to be sorted in non-decreasing order.\n        n: An integer representing the length of sorted_array.\n        element: A number (integer or float) for which to check majority status.\n\n    Returns:\n        True if element is a majority element, False otherwise.\n    \"\"\"\n    # Handle edge cases\n    if n == 0:\n        return False\n    \n    # If n is 1, the element is a majority if it matches the single array element.\n    # Count must be > n/2 (1/2 = 0.5), so a count of 1 is a majority.\n    if n == 1:\n        return sorted_array[0] == element\n\n    # Step 2: Find First Occurrence\n    first_idx = _find_first_occurrence(sorted_array, element, n)\n\n    # Step 3: Check if Element is Present\n    if first_idx == -1:\n        return False\n\n    # Step 4: Find Last Occurrence\n    # Since first_idx is not -1, the element is guaranteed to be in the array,\n    # so last_idx will also be a valid index.\n    last_idx = _find_last_occurrence(sorted_array, element, n)\n\n    # Step 5: Calculate Count and Determine Majority\n    count = last_idx - first_idx + 1\n    \n    # An element is a majority if its count is strictly greater than n / 2\n    return count > (n / 2)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[], 1, 0]]}], "Mbpp/224": [{"task_id": "Mbpp/224", "solution": "# counter.py\n\ndef count_set_bits(n: int) -> int:\n    \"\"\"\n    Counts the number of set bits (1s) in the binary representation of a non-negative integer.\n\n    This function implement