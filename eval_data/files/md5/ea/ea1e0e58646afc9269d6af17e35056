(8, 15, 'quickly')\n        >>> find_adverb_position(\"She sings beautifully and loudly.\")\n        (10, 20, 'beautifully')\n        >>> find_adverb_position(\"This is a simple sentence.\")\n        None\n        >>> find_adverb_position(\"  \")\n        None\n        >>> find_adverb_position(\"\")\n        None\n        >>> find_adverb_position(123)\n        Traceback (most recent call last):\n            ...\n        ValueError: Input must be a string.\n    \"\"\"\n    if not isinstance(sentence, str):\n        raise ValueError(\"Input must be a string.\")\n    if not sentence.strip():\n        return None\n\n    tokenizer = nltk.tokenize.TreebankWordTokenizer()\n    \n    # Store tokens with their original start and end indices\n    tokens_with_spans_raw: List[Tuple[str, int, int]] = []\n    for start, end in tokenizer.span_tokenize(sentence):\n        token_text = sentence[start:end]\n        tokens_with_spans_raw.append((token_text, start, end))\n\n    # Get raw tokens for POS tagging\n    raw_tokens = [token for token, _, _ in tokens_with_spans_raw]\n    \n    # Perform Part-of-Speech tagging\n    tagged_tokens = nltk.pos_tag(raw_tokens)\n\n    found_adverb_info: Optional[Tuple[int, int, str]] = None\n\n    for i, (token_text_from_tagger, pos_tag) in enumerate(tagged_tokens):\n        if pos_tag in ADVERB_POS_TAGS:\n            original_token_text, original_start_idx, original_end_idx = tokens_with_spans_raw[i]\n            \n            # Clean the adverb word by stripping leading/trailing punctuation\n            cleaned_adverb_word = original_token_text.strip(string.punctuation)\n            \n            # If after stripping punctuation, the word is empty, skip it (e.g., \"!!!\" -> \"\")\n            if not cleaned_adverb_word:\n                continue\n\n            # Calculate the new start and end indices for the cleaned adverb within the original sentence\n            # We need to find the offset of the cleaned word within the original token\n       