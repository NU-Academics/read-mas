wise.\n    # All entries are initially True, representing the assumption that all numbers are prime.\n    is_prime = [True] * n\n\n    # 0 and 1 are not prime numbers.\n    is_prime[0] = False\n    is_prime[1] = False\n\n    # Sieving process using the Sieve of Eratosthenes.\n    # Iterate with 'p' from 2 up to sqrt(n).\n    # The loop condition p * p < n is used because any composite number 'k' less than 'n'\n    # must have at least one prime factor 'p' such that p <= sqrt(k).\n    # If p > sqrt(n), then p*p > n, so multiples p*p, p*2p, etc. would be outside our range,\n    # or would have already been marked by a smaller prime factor.\n    p = 2\n    while p * p < n:\n        # If is_prime[p] is still True, then p is a prime number.\n        if is_prime[p]:\n            # Mark all multiples of p (starting from p*p) as not prime.\n            # Multiples less than p*p would have already been marked by smaller primes.\n            for multiple in range(p * p, n, p):\n                is_prime[multiple] = False\n        p += 1\n\n    # Count the number of primes.\n    # Iterate through the is_prime list from index 2 up to n-1.\n    prime_count = 0\n    for i in range(2, n):\n        if is_prime[i]:\n            prime_count += 1\n\n    return prime_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/259": [{"task_id": "Mbpp/259", "solution": "from typing import Tuple\ndef maximize_elements(tuple1: Tuple[Tuple[int, ...], ...],\n                      tuple2: Tuple[Tuple[int, ...], ...]) -> Tuple[Tuple[int, ...], ...]:\n    \"\"\"\n    Performs element-wise maximization on two nested tuples of integers.\n\n    Args:\n        tuple1: The first input tuple of tuples, where inner elements are integers.\n                Example: ((1, 3), (4, 5))\n        tuple2: The second input tuple of tuples, with an identical structure to tuple1.\n                Example: ((6, 7), (3, 9))\n\n    Returns:\n        A new tuple of tuples of integers, where each element is the maximum of the\n        corresponding elements from tuple1 and tuple2.\n        Example: ((6, 7), (4, 9))\n    \"\"\"\n    result_outer_list = []\n    # Iterate over corresponding inner tuples from tuple1 and tuple2\n    for inner_tuple1, inner_tuple2 in zip(tuple1, tuple2):\n        result_inner_list = []\n        # Iterate over corresponding elements within the inner tuples\n        for element1, element2 in zip(inner_tuple1, inner_tuple2):\n            # Calculate the maximum of the two corresponding elements\n            max_element = max(element1, element2)\n            result_inner_list.append(max_element)\n        # Convert the list of maximized elements to a tuple for the inner tuple\n        maximized_inner_tuple = tuple(result_inner_list)\n        result_outer_list.append(maximized_inner_tuple)\n    # Convert the list of maximized inner tuples to the final output tuple\n    final_result = tuple(result_outer_list)\n    return final_result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/261": [{"task_id": "Mbpp/261", "solution": "def division_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise division of elements from two tuples.\n\n    Applies integer division if both operands are integers and the result is an exact integer.\n    Handles ZeroDivisionError for division by zero and ValueError for tuples of different lengths.\n\n    Args:\n        tuple1 (tuple): A tuple of numbers (int or float) representing numerators.\n        tuple2 (tuple): A tuple of numbers (int or float) representing denominators.\n\n    Returns:\n        tuple: A new tuple containing the results of the element-wise division.\n\n    Raises:\n        ValueError: If the input tuples have different lengths.\n        ZeroDivisionError: If any element in tuple2 (denominator) is zero.\n\n    Examples:\n        >>> division_elements((10, 4, 6, 9), (5, 2, 3, 3))\n        (2, 2, 2, 3)\n        >>> division_elements((10.0, 4, 7), (5, 2.0, 2))\n        (2.0, 2.0, 3.5)\n        >>> division_elements((10, 4), (5, 0))\n        Traceback (most recent call last):\n            ...\n        ZeroDivisionError: Cannot divide by zero.\n        >>> division_elements((10, 4), (5,))\n        Traceback (most recent call last):\n            ...\n        ValueError: Input tuples must have the same length.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    results_list = []\n\n    for i in range(len(tuple1)):\n        numerator = tuple1[i]\n        denominator = tuple2[i]\n\n        if denominator == 0:\n            raise ZeroDivisionError(\"Cannot divide by zero.\")\n\n        # REQ-FUN-006: Integer Division Rule\n        # Check if both are integers AND exact division is possible\n        if isinstance(numerator, int) and isinstance(denominator, int) and (numerator % denominator == 0):\n            result = numerator // denominator\n        else:\n            result = numerator / denominator\n        \n        results_list.append(result)\n\n    return tuple(results_list)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/262": [{"task_id": "Mbpp/262", "solution": "def split_two_parts(input_list: list, L: int) -> tuple[list, list]:\n    \"\"\"\n    Splits a given list into two parts based on a specified length L for the first part.\n\n    The function leverages Python's built-in list slicing to efficiently divide\n    the input list. It handles edge cases where L is 0, L is greater than\n    or equal to the list's length, and when the input list itself is empty.\n\n    Args:\n        input_list: The list to be split. Can contain elements of any type.\n        L: An integer representing the desired length of the first part.\n           Assumed to be non-negative.\n\n    Returns:\n        A tuple containing two new lists