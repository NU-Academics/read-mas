f\n\n    return min_diff", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/765": [{"task_id": "Mbpp/765", "solution": "def find_nth_polite(n: int) -> int:\n    \"\"\"\n    Finds the Nth polite number.\n\n    A polite number is a positive integer that is not a power of two.\n    For example, polite numbers are 3, 5, 6, 7, 9, 10, 11, 12, 13, 14, 15, 17, ...\n\n    Args:\n        n (int): The ordinal position of the polite number to find (n >= 1).\n\n    Returns:\n        int: The Nth polite number.\n\n    Raises:\n        ValueError: If n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    # Helper function to count polite numbers up to a given 'x'\n    def count_polite_up_to(x: int) -> int:\n        \"\"\"\n        Calculates the count of polite numbers (non-powers of two) \n        less than or equal to x.\n        \"\"\"\n        if x <= 0:\n            return 0\n        # x.bit_length() returns floor(log2(x)) + 1 for x >= 1, \n        # which is the count of powers of 2 <= x.\n        num_powers_of_2 = x.bit_length()\n        return x - num_powers_of_2\n\n    # Binary search to find the smallest X such that count_polite_up_to(X) >= n\n    # The Nth polite number X will be roughly n + log2(X).\n    # A safe lower bound for X is n.\n    # A safe upper bound for X can be n + C, where C accounts for max log2(N) (e.g., ~60 for 10^18)\n    # Using 128 as a sufficiently large constant for C.\n    low, high = n, n + 128 \n    ans = high # Initialize with a value that will definitely be overwritten\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        \n        # Calculate how many polite numbers exist up to 'mid'\n        polite_count = count_polite_up_to(mid)\n\n        if polite_count >= n:\n            # 'mid' could be the Nth polite number, or it might be larger.\n            # We store 'mid' as a candidate and try to find a smaller one.\n            ans = mid\n            high = mid - 1\n        else:\n            # 'mid' is too small; we need to look in the upper half.\n            low = mid + 1\n            \n    # After the loop, 'ans' holds the smallest integer X such that X - X.bit_length() >= n.\n    # However, this 'X' itself might be a power of two. \n    # The actual Nth polite number is this 'ans' if 'ans' is polite, \n    # or the next integer if 'ans' is a power of two.\n    # Given the property of count_polite_up_to(X), if X is a power of two, \n    # X - X.bit_length() is the same as (X-1) - (X-1).bit_length().\n    # The binary search correctly finds the *smallest number* 'ans' where count_polite_up_to(ans) >= n.\n    # If 'ans' itself is a power of two, count_polite_up_to(ans) == count_polite_up_to(ans-1).\n    # In such a case, the *true* Nth polite number is (ans + 1).\n    # But this logic is already implicitly handled by the nature of the binary search \n    # finding the smallest 'ans' for which the condition holds.\n    # The design specifies \"The smallest X such that X - X.bit_length() >= n. This X is precisely the Nth polite number.\"\n    # Let's verify with test cases:\n    # find_nth_polite(1) -> ans = 3. count_polite_up_to(3) = 3 - 2 = 1. Condition 1 >= 1 met.\n    # find_nth_polite(2) -> ans = 5. count_polite_up_to(5) = 5 - 3 = 2. Condition 2 >= 2 met.\n    # find_nth_polite(3) -> ans = 6. count_polite_up_to(6) = 6 - 3 = 3. Condition 3 >= 3 met.\n    # The logic is correct as it finds the smallest X satisfying the condition,\n    # which implies it correctly finds the Nth polite number, even if that X is a power of 2 \n    # (in which case it effectively means that Nth polite number is X-1, but the binary search \n    # will land on the smallest value that *contains* N polite numbers, which is correct for ordinality).\n    # Example: N=1. Polite numbers: 3, 5, 6, 7...\n    # We need to find X s.t. X - log2(X)+1 >= 1.\n    # X=1, 1 - 1 = 0 < 1\n    # X=2, 2 - 2 = 0 < 1\n    # X=3, 3 - 2 = 1 >= 1. Smallest such X is 3. Result: 3. Correct.\n\n    # Example: N=2. Polite numbers: 3, 5, 6, 7...\\\n    # We need to find X s.t. X - log2(X)+1 >= 2.\n    # X=3, 3 - 2 = 1 < 2\n    # X=4, 4 - 3 = 1 < 2\n    # X=5, 5 - 3 = 2 >= 2. Smallest such X is 5. Result: 5. Correct.\n\n    return ans", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/764": [{"task_id": "Mbpp/764", "solution": "def number_ctr(s: str) -> int:\n    \"\"\"\n    Counts the number of digit characters in a given string.\n\n    Args:\n        s: The input string.\n\n    Returns:\n        The total count of digit characters in the string.\n\n    Example:\n        >>> number_ctr('program2bedone')\n        1\n        >>> number_ctr('hello123world4')\n        4\n        >>> number_ctr('no_digits_here!')\n        0\n        >>> number_ctr('')\n        0\n    \"\"\"\n    digit_count = 0\n    for char in s:\n        if char.isdigit():\n            digit_count += 1\n    return digit_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/766": [{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list: list) -> list:\n    \"\"\"\n    Generates a list of consecutive pairs from the input list.\n\n    Args:\n        input_list: The list from which consecutive pairs are to be extracted.\n\n    Returns:\n        A new list where each element is a tuple (item_n, item_n+1)\n        representing a consecutive pair from the input_list.\n        Returns an empty list if the input_list has fewer than two elements.\n    \"\"\"\n    result_pairs = []\n\n    # Handle edge cases: empty list or single-element list\n    if len(input_list) < 2:\n        return result_pairs\n\n    # Iterate through the list up to the second-to-last element\n    # to ensure input_list[i+1] is always a valid index.\n    for i in range(len(input_list) - 1):\n        current_pair = (input_list[i], input_list[i+1])\n        result_pairs.append(current_pair)\n\n    return result_pairs", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/767": [{"task_id": "Mbpp/767", "solution": "def get_pairs_count(nums, target_sum):\n    \"\"\"\n    Calculates the total number of pairs of elements (nums[i], nums[j])\n    where i < j within the input list nums such that their sum\n    nums[i] + nums[j] is equal to target_sum.\n\n    This function uses a frequency map to achieve O(N) time complexity.\n\n    Args:\n        nums (list): A list of numbers (integers or floats).\n        target_sum (int or float): The desired sum for the pairs.\n\n    Returns:\n        int: The total count of pairs satisfying the condition.\n    \"\"\"\n    pair_count = 0\n    # freq_map stores the frequency of numbers encountered so far during iteration.\n    # Key: a number from the nums list.\n    # Value: the count of occurrences of that number seen up to the current point.\n    freq_map = {}\n\n    for num in nums:\n        complement = target_sum - num\n\n        # If the complement exists in freq_map, it means we have seen numbers\n        # (at earlier indices) that can form a pair with the current 'num'.\n        # We add its frequency to the pair_count.\n        if complement in freq_map:\n            pair_count += freq_map[complement]\n\n        # Add or increment the frequency of the current 'num' in the map.\n        # This number will be available as a 'complement' for subsequent numbers.\n        if num in freq_map:\n            freq_map[num] += 1\n        else:\n            freq_map[num] = 1\n\n    return pair_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/770": [{"task_id": "Mbpp/770", "solution": "def sum_fourth_power_odd_naturals(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first 'n' odd natural numbers.\n\n    Args:\n        n (int): The number of odd natural numbers to consider. Must be non-negative.\n\n    Returns:\n        int: The sum of the fourth powers.\n\n    Raises:\n        ValueError: If n is negative.\n        TypeError: If n is not an integer.\n    \"\"\"\n    # 1. Input Validation: Check if n is an integer\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n\n    # 1. Input Validation: Check if n is negative\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer.\")\n\n    # 2. Initialization\n    total_sum = 0\n\n    # 3. Iteration\n    # Loop k from 1 up to n (inclusive)\n    for k in range(1, n + 1):\n        # a. Calculate the k-th odd natural number\n        odd_number = (2 * k) - 1\n        \n        # b. Calculate its fourth power\n        fourth_power = odd_number ** 4\n        \n        # c. Add fourth_power to total_sum\n        total_sum += fourth_power\n\n    # 4. Return Value\n    return total_sum", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/769": [{"task_id": "Mbpp/769", "solution": "def Diff(list1: list, list2: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists, returning elements that are\n    in list1 but not in list2. The relative order of elements from list1 is\n    preserved in the result.\n\n    Args:\n        list1 (list): The primary list from which elements are taken.\n        list2 (list): The secondary list whose elements are excluded from the result.\n\n    Returns:\n        list: A new list containing elements from list1 that are not present\n              in list2, preserving their relative order as they appeared in list1.\n\n    Example:\n        >>> Diff([10, 15, 20, 25, 30, 35, 40], [25, 40, 35])\n        [10, 15, 20, 30]\n        (Note: The original SRS example's asserted output `[10, 20, 30, 15]`\n        implies a specific reordering not consistent with preserving relative\n        order from list1. This implementation correctly preserves the relative\n        order from list1 as specified by FR-2.)\n\n        >>> Diff([1, 2, 3, 2, 4], [2])\n        [1, 3, 4]\n        >>> Diff([], [1, 2, 3])\n        []\n        >>> Diff([1, 2, 3], [])\n        [1, 2, 3]\n        >>> Diff([1, 1, 2], [1])\n        [2]\n        >>> Diff([1, 2, 1], [2]) # Example for FR-3 specific note\n        [1, 1]\n    \"\"\"\n    elements_to_exclude = set(list2)\n    result = []\n    for item in list1:\n        if item not in elements_to_exclude:\n            result.append(item)\n    return result", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 2, 3, 4, 5], [6, 7, 1]]], "plus_fail_tests": [[[], [1, 2, 3]]]}], "Mbpp/771": [{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the brackets (parentheses, square brackets, curly braces)\n    in the given expression are balanced and properly nested.\n\n    Args:\n        expression (str): The input string expression to validate.\n\n    Returns:\n        bool: True if the brackets are balanced, False otherwise.\n    \"\"\"\n    stack = []\n    \n    # Define opening brackets for quick lookup\n    opening_brackets = {'(', '[', '{'}\n    \n    # Define matching pairs for closing brackets\n    # Key: closing bracket, Value: corresponding opening bracket\n    matching_pairs = {\n        ')': '(',\n        ']': '[',\n        '}': '{'\n    }\n\n    for char in expression:\n        if char in opening_brackets:\n            # If it's an opening bracket, push it onto the stack\n            stack.append(char)\n        elif char in matching_pairs:\n            # If it's a closing bracket\n            # Check if the stack is empty (no opening bracket to match)\n            if not stack:\n                return False\n            \n            # Pop the most recently opened bracket from the stack\n            last_opened_bracket = stack.pop()\n            \n            # Check 