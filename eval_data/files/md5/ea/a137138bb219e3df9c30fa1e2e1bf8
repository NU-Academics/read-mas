{"task_id": "HumanEval/29", "solution": "from typing import List\nfrom dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass StringList:\n    items: List[str]\n\n@dataclass(frozen=True)\nclass Prefix:\n    value: str\n\n@dataclass(frozen=True)\nclass FilterResult:\n    items: List[str]\n\nclass FilterService:\n    def filter(self, string_list: StringList, prefix: Prefix) -> FilterResult:\n        \"\"\"Applies the filtering logic to find strings that start with the given prefix.\"\"\"\n        filtered_items = [s for s in string_list.items if s.startswith(prefix.value)]\n        return FilterResult(items=filtered_items)\n\ndef filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    input_string_list = StringList(items=strings)\n    input_prefix = Prefix(value=prefix)\n\n    service = FilterService()\n    result = service.filter(input_string_list, input_prefix)\n\n    return result.items"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    \"\"\"\n    indices = [i for i in range(len(l)) if i % 3 == 0]\n    values_to_sort = [l[i] for i in indices]\n    values_to_sort.sort()\n\n    result = l.copy()\n    for i, val in zip(indices, values_to_sort):\n        result[i] = val\n    return result"}
{"task_id": "HumanEval/32", "solution": "import math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    if len(xs) == 2:\n        return -xs[0] / xs[1]\n\n    # For higher degree polynomials, use Newton-Raphson method.\n    # The degree of the polynomial is len(xs) - 1, which is odd.\n    poly_prime_coeffs = [i * coeff for i, coeff in enumerate(xs) if i > 0]\n\n    x_current = 0.0  # Initial guess\n    tolerance = 1e-7\n    max_iterations = 1000\n\n    for _ in range(max_iterations):\n        fx = poly(xs, x_current)\n        if abs(fx) < tolerance:\n            return x_current\n\n        f_prime_x = poly(poly_prime_coeffs, x_current)\n\n        if abs(f_prime_x) < 1e-10: # Avoid division by zero if derivative is too small\n            return x_current\n\n        x_next = x_current - fx / f_prime_x\n\n        if abs(x_next - x_current) < tolerance:\n            return x_next\n\n        x_current = x_next\n\n    return x_current"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    return sorted(set(l))"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\"\"\"\n    count_of_sevens = 0\n    for i in range(1, n):\n        if i % 11 == 0 or i % 13 == 0:\n            count_of_sevens += str(i).count('7')\n    return count_of_sevens"}
{"task_id": "HumanEval/35", "solution": "from typing import List\nfrom .domain.integer_list import IntegerList\nfrom .domain.max_calculator import MaxCalculator\n\ndef max_element(l: list):\n    \"\"\"Return maximum element in the list.\"\"\"\n    integer_list = IntegerList(l)\n    calculator = MaxCalculator()\n    return calculator.get_max(integer_list)"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    # Create a copy to store the result, ensuring the original list is not modified.\n    result = list(l)\n\n    # Extract elements from even indices.\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n\n    # Sort the extracted even elements.\n    even_elements.sort()\n\n    # Place the sorted even elements back into the even indices of the result list.\n    sorted_even_idx = 0\n    for i in range(0, len(l), 2):\n        result[i] = even_elements[sorted_even_idx]\n        sorted_even_idx += 1\n\n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "class PrimeChecker:\n    \"\"\"Checks if a number is prime.\"\"\"\n    def is_prime(self, num: int) -> bool:\n        if num < 2:\n            return False\n        i = 2\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 1\n        return True\n\nclass FibonacciGenerator:\n    \"\"\"Generates Fibonacci numbers (1, 1, 2, 3, 5, ...).\"\"\"\n    def __init__(self):\n        self._a = 1  # Current F(k-1)\n        self._b = 1  # Current F(k)\n        self._counter = 0 # Tracks how many numbers have been generated\n\n    def generate(self) -> int:\n        self._counter += 1\n        if self._counter == 1:\n            return 1 # F_1\n        elif self._counter == 2:\n            return 1 # F_2\n        else:\n            # For F_3 onwards\n            next_val = self._a + self._b\n            self._a = self._b\n            self._b = next_val\n            return next_val\n\nclass PrimeFibonacciSequence:\n    \"\"\"Orchestrates finding the n-th prime Fibonacci number.\"\"\"\n    def __init__(self):\n        self._generator = FibonacciGenerator()\n        self._checker = PrimeChecker()\n\n    def get_prime_fibonacci(self, n: int) -> int:\n        count = 0\n        \n        # Advance the generator past F_1=1 and F_2=1 as they are not prime.\n        self._generator.generate() # Skips F_1 = 1\n        self._generator.generate() # Skips F_2 = 1\n\n        while True:\n            fib_num = self._generator.generate()\n            if self._checker.is_prime(fib_num):\n                count += 1\n                if count == n:\n                    return fib_num\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    sequence_finder = PrimeFibonacciSequence()\n    return sequence_finder.get_prime_fibonacci(n)"}
{"task_id": "HumanEval/40", "solution": "```python\ndef triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    if len(l) < 3:\n        return False\n\n    # The algorithm iterates through all unique pairs (a, b) and\n    # checks if the third required number (c = -(a + b)) exists in the remainder of the list.\n    for i in range(len(l)):\n        a = l[i]\n        for j in range(i + 1, len(l)):\n            b = l[j]\n            c_needed = -(a + b)\n            # Check for c_needed in the part of the list after index j\n            if c_needed in l[j + 1:]:\n                return True\n    return False\n```"}
{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int):\n    \"\"\"\n    Calculates the total number of collisions between two sets of n cars moving in opposite directions.\n    Each of the n cars from one direction collides with each of the n cars from the other direction.\n    \"\"\"\n    return n * n"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    seen = set()\n    for num in l:\n        if -num in seen:\n            return True\n        seen.add(num)\n    return False"}
{"task_id": "HumanEval/42", "solution": "def incr_list(l: list):\n    \"\"\"Return list with elements incremented by 1.\"\"\"\n    return [x + 1 for x in l]"}
