{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers.\n    Uses the formula: 4 * n * (n + 1) * (2 * n + 1) / 6.\n    \"\"\"\n    # The sum of squares of the first n even numbers (2i)^2 can be simplified\n    # using the formula for sum of squares of first n natural numbers i^2.\n    # Sum (2i)^2 from i=1 to n = 4 * Sum (i)^2 from i=1 to n\n    # = 4 * [n * (n + 1) * (2 * n + 1) / 6]\n    return 4 * n * (n + 1) * (2 * n + 1) // 6"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers.\n    For n=2, the even numbers are 2, 4. Their squares are 4, 16. The sum is 20.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        even_num = 2 * i\n        total_sum += even_num ** 2\n    return total_sum"}
{"task_id": "Mbpp/286", "solution": "import math\n\ndef kadane_algorithm(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a contiguous subarray in a single array.\n    Handles arrays with all negative numbers correctly.\n    \"\"\"\n    if not arr:\n        return 0 # The sum of an empty subarray is 0.\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, len(arr)):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n    return max_so_far\n\ndef calculate_array_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the total sum of all elements in the array.\n    \"\"\"\n    return sum(arr)\n\ndef get_max_prefix_sum(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of any prefix subarray in the array.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_prefix_sum = -math.inf\n    current_sum = 0\n    for x in arr:\n        current_sum += x\n        max_prefix_sum = max(max_prefix_sum, current_sum)\n    return max_prefix_sum\n\ndef get_max_suffix_sum(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of any suffix subarray in the array.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_suffix_sum = -math.inf\n    current_sum = 0\n    for i in range(len(arr) - 1, -1, -1):\n        current_sum += arr[i]\n        max_suffix_sum = max(max_suffix_sum, current_sum)\n    return max_suffix_sum\n\ndef max_sub_array_sum_repeated(array: list[int], length: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous array in the modified array\n    formed by repeating the given array k times.\n    \"\"\"\n    if length == 0:\n        return 0\n\n    # Case 1: The maximum subarray is entirely within a single instance of the original array.\n    max_kadane_orig = kadane_algorithm(array)\n\n    # If k is 1, the result is simply the max subarray sum of the original array.\n    if k == 1:\n        return max_kadane_orig\n\n    # Case 2: The maximum subarray spans across multiple instances of the array.\n    # This sum would be formed by a suffix sum from the first array copy,\n    # (k-2) full array sums from middle copies (if k > 2), and a prefix sum from the last array copy.\n    arr_sum = calculate_array_sum(array)\n    max_prefix = get_max_prefix_sum(array)\n    max_suffix = get_max_suffix_sum(array)\n\n    # Initialize the overall maximum with the best sum found within a single array.\n    result = max_kadane_orig\n\n    if arr_sum >= 0:\n        # If the total sum of the array is non-negative, repeating it (k-2) times\n        # between a max suffix and max prefix will always help or keep the sum same.\n        # For k=2, (k-2)*arr_sum becomes 0, correctly calculating max_suffix + max_prefix.\n        result = max(result, max_suffix + (k - 2) * arr_sum + max_prefix)\n    else:\n        # If the total sum of the array is negative, adding more full array copies\n        # would only decrease the sum. So, we only consider connecting a suffix\n        # of the first array to a prefix of the second array (effectively 2 copies).\n        result = max(result, max_suffix + max_prefix)\n    \n    return result"}
