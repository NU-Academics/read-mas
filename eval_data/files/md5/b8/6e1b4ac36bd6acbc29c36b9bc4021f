{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    This iterative bit shifting approach ensures O(log n) time complexity.\n    \"\"\"\n    power = 1\n    while (power << 1) <= n:\n        power <<= 1\n    return power"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n):\n    \"\"\"\n    Calculates the n'th Lucas number using an iterative approach.\n    L(0) = 2, L(1) = 1, L(n) = L(n-1) + L(n-2) for n \u2265 2.\n    \"\"\"\n    if n == 0:\n        return 2\n    elif n == 1:\n        return 1\n    else:\n        a, b = 2, 1  # a represents L(k-2), b represents L(k-1)\n        for _ in range(2, n + 1):\n            next_lucas = a + b\n            a = b\n            b = next_lucas\n        return b"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"\n    Find the highest power of 2 that is less than or equal to n.\n    This function iteratively multiplies by 2 until the next power exceeds n.\n    \"\"\"\n    power = 1\n    while power * 2 <= n:\n        power *= 2\n    return power"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"\n    Calculates the n'th Lucas number iteratively.\n    The sequence starts with L(0)=2, L(1)=1, and L(n)=L(n-1)+L(n-2).\n    \"\"\"\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    a, b = 2, 1  # L(0) and L(1)\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b"}
