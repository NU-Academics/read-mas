{"task_id": "Mbpp/428", "solution": "def shell_sort(array: list) -> list:\n    \"\"\"\n    Sorts an array using the Shell Sort algorithm, returning a new sorted array.\n    This implementation uses a gap sequence starting from half the array length and halving it in each iteration.\n    \"\"\"\n    n = len(array)\n    # Create a copy to ensure the original array remains unchanged.\n    copied_array = list(array)\n\n    # Start with a large gap and reduce it\n    gap = n // 2\n    while gap > 0:\n        # Perform a gapped insertion sort for this gap size.\n        # The first gap elements a[0..gap-1] are already in gapped order\n        # keep adding one more element until the entire array is gap sorted\n        for i in range(gap, n):\n            # save a[i] in temp and make a hole at position i\n            temp = copied_array[i]\n\n            # shift earlier gap-sorted elements up until the correct location for temp is found\n            j = i\n            while j >= gap and copied_array[j - gap] > temp:\n                copied_array[j] = copied_array[j - gap]\n                j -= gap\n\n            # put temp (the original a[i]) in its correct location\n            copied_array[j] = temp\n        gap //= 2\n    return copied_array"}
{"task_id": "Mbpp/428", "solution": "def shell_sort(arr: list) -> list:\n    \"\"\"Sorts an array using the shell sort algorithm in ascending order.\n    It returns a new sorted array without modifying the original input.\n    \"\"\"\n    n = len(arr)\n\n    # Handle empty or single-element arrays efficiently.\n    if n <= 1:\n        return arr.copy()\n\n    # Create a copy of the input array to avoid modifying the original.\n    sorted_arr = arr.copy()\n\n    def _calculate_gaps(length: int) -> list:\n        \"\"\"Calculates a common gap sequence for Shell sort, halving until 1.\"\"\"\n        gaps = []\n        gap = length // 2\n        while gap > 0:\n            gaps.append(gap)\n            gap //= 2\n        return gaps\n\n    def _insertion_sort_with_gap(array_to_sort: list, current_gap: int) -> None:\n        \"\"\"Performs an insertion sort on elements separated by the specified gap.\"\"\"\n        for i in range(current_gap, len(array_to_sort)):\n            temp = array_to_sort[i]\n            j = i\n            # Shift earlier gap-sorted elements up until the correct position for temp is found.\n            while j >= current_gap and array_to_sort[j - current_gap] > temp:\n                array_to_sort[j] = array_to_sort[j - current_gap]\n                j -= current_gap\n            array_to_sort[j] = temp\n\n    # Get the sequence of gaps.\n    gaps = _calculate_gaps(n)\n\n    # Apply gapped insertion sort for each gap in the sequence.\n    for gap in gaps:\n        _insertion_sort_with_gap(sorted_arr, gap)\n\n    return sorted_arr"}
