{"task_id": "Mbpp/622", "solution": "def get_median(list1: list, list2: list, size: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size.\n    It iterates through the lists to find the two middle elements in O(n) time.\n    \"\"\"\n    i = 0  # Pointer for list1\n    j = 0  # Pointer for list2\n    \n    m1 = -1 # Stores the (size-1)-th element of the conceptual merged list\n    m2 = -1 # Stores the (size)-th element of the conceptual merged list\n    \n    # We need to find elements up to the (size)th position (0-indexed) of the merged list.\n    # This means we iterate `size + 1` times.\n    for count in range(size + 1): \n        m1 = m2 # The previous m2 becomes the new m1\n        \n        # Determine the next smallest element from either list1 or list2\n        if i < size and j < size:\n            if list1[i] <= list2[j]:\n                m2 = list1[i]\n                i += 1\n            else:\n                m2 = list2[j]\n                j += 1\n        elif i < size: # list2 is exhausted, take from list1\n            m2 = list1[i]\n            i += 1\n        else: # list1 is exhausted, take from list2\n            m2 = list2[j]\n            j += 1\n            \n    # The median is the average of the two middle elements found.\n    return (m1 + m2) / 2.0"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset where every pair of numbers is divisible.\n    A pair (a, b) is divisible if a % b == 0 or b % a == 0.\n    \"\"\"\n    n = len(numbers)\n    if n <= 1:\n        return n\n\n    max_size = 0\n    \n    # Sort the numbers to ensure consistent order in subsets.\n    sorted_numbers = sorted(numbers)\n\n    # Iterate through all 2^n possible subsets using bit manipulation.\n    for i in range(1 << n):\n        current_subset = []\n        for j in range(n):\n            if (i >> j) & 1:  # If the j-th bit is set, include numbers[j].\n                current_subset.append(sorted_numbers[j])\n\n        # If the current subset is not larger than the max_size found so far, skip validation.\n        if len(current_subset) <= max_size:\n            continue\n\n        is_valid_subset = True\n        # Check all unique pairs in the current subset for divisibility.\n        for k in range(len(current_subset)):\n            for l in range(k + 1, len(current_subset)):\n                a = current_subset[k]\n                b = current_subset[l]\n\n                # A pair (a, b) is valid if a divides b or b divides a.\n                # Handles potential ZeroDivisionError if 0 is present.\n                if not ((b != 0 and a % b == 0) or (a != 0 and b % a == 0)):\n                    is_valid_subset = False\n                    break\n            if not is_valid_subset:\n                break\n\n        if is_valid_subset:\n            max_size = max(max_size, len(current_subset))\n\n    return max_size"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1, list2, size):\n    \"\"\"\n    Finds the median of two sorted lists of the same size using a binary search approach.\n    \"\"\"\n\n    def find_kth_element(arr1, arr2, k, idx1, idx2):\n        \"\"\"\n        Helper function to find the k-th smallest element (1-indexed)\n        in the combined sorted lists arr1[idx1:] and arr2[idx2:].\n        \"\"\"\n        m = len(arr1)\n        n = len(arr2)\n\n        # Base case: if all elements of arr1 are processed, the k-th element must be in arr2\n        if idx1 >= m:\n            return arr2[idx2 + k - 1]\n        # Base case: if all elements of arr2 are processed, the k-th element must be in arr1\n        if idx2 >= n:\n            return arr1[idx1 + k - 1]\n\n        # Base case: if k is 1, return the minimum of the current elements\n        if k == 1:\n            return min(arr1[idx1], arr2[idx2])\n\n        # Determine how many elements to skip from each list (roughly k/2)\n        step = k // 2\n\n        # Calculate actual number of elements to consider from each list, respecting boundaries\n        count1 = min(step, m - idx1)\n        count2 = min(step, n - idx2)\n\n        # Get the values at the (current_idx + count - 1) position from each list\n        # Use float('inf') if a list doesn't have enough elements to reach that position\n        val1 = arr1[idx1 + count1 - 1] if idx1 + count1 <= m else float('inf')\n        val2 = arr2[idx2 + count2 - 1] if idx2 + count2 <= n else float('inf')\n\n        if val1 < val2:\n            # If val1 is smaller, discard count1 elements from arr1 and look for (k - count1)-th element\n            return find_kth_element(arr1, arr2, k - count1, idx1 + count1, idx2)\n        else: # val2 <= val1\n            # If val2 is smaller or equal, discard count2 elements from arr2 and look for (k - count2)-th element\n            return find_kth_element(arr1, arr2, k - count2, idx1, idx2 + count2)\n\n    # For two lists of size 'size', there are 2 * size elements in total.\n    # The median is the average of the (size)-th and (size + 1)-th smallest elements (1-indexed).\n\n    # Find the (size)-th smallest element in the combined list\n    median1 = find_kth_element(list1, list2, size, 0, 0)\n    # Find the (size + 1)-th smallest element in the combined list\n    median2 = find_kth_element(list1, list2, size + 1, 0, 0)\n\n    # The median is the average of these two elements\n    return (median1 + median2) / 2.0"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: list) -> int:\n    \"\"\"\n    Finds the size of the largest subset of a list of numbers so that every pair is divisible.\n    A pair (a, b) is divisible if a divides b or b divides a.\n    \"\"\"\n    # Handle edge cases: empty list or list containing only zero\n    if not numbers:\n        return 0\n\n    # Separate zero from non-zero numbers and sort the non-zero numbers\n    has_zero = False\n    non_zero_numbers = []\n    for num in numbers:\n        if num == 0:\n            has_zero = True\n        else:\n            non_zero_numbers.append(num)\n\n    # Sort non-zero numbers in ascending order. This is crucial for the dynamic programming approach.\n    # If a subset {s1, s2, ..., sk} is divisible and s1 < s2 < ... < sk,\n    # then for any i < j, si must divide sj.\n    non_zero_numbers.sort()\n\n    n = len(non_zero_numbers)\n\n    # If there are no non-zero numbers:\n    # If 0 was present, the largest subset is {0}, size 1.\n    # If no numbers were present (already handled by `if not numbers`), or only non-zero numbers\n    # were filtered out leaving nothing, this means all non-zero numbers list is empty.\n    # E.g. numbers=[0,0,0] -> non_zero_numbers=[] and has_zero=True -> result 1.\n    # E.g. numbers=[0] -> non_zero_numbers=[] and has_zero=True -> result 1.\n    if n == 0:\n        return 1 if has_zero else 0\n\n    # Initialize dp array: dp[i] will store the size of the largest divisible subset\n    # ending with non_zero_numbers[i]. Each number itself forms a subset of size 1.\n    dp = [1] * n\n    max_len_non_zero = 1 # Smallest possible max_len for non-empty non-zero list is 1.\n\n    # Dynamic programming approach to find the Longest Divisible Subsequence (LDS)\n    for i in range(n):\n        for j in range(i):\n            # If non_zero_numbers[i] is divisible by non_zero_numbers[j]\n            # (since non_zero_numbers[j] < non_zero_numbers[i]),\n            # then non_zero_numbers[i] can extend the divisible subset ending at non_zero_numbers[j].\n            if non_zero_numbers[i] % non_zero_numbers[j] == 0:\n                dp[i] = max(dp[i], 1 + dp[j])\n        max_len_non_zero = max(max_len_non_zero, dp[i])\n\n    # If 0 was present in the original list, it can be included with any valid\n    # divisible subset of non-zero numbers to form a larger valid subset.\n    # This is because any non-zero number 'x' divides 0 (0 % x == 0),\n    # so the pair (0, x) is always valid.\n    if has_zero:\n        return max_len_non_zero + 1\n    else:\n        return max_len_non_zero"}
{"task_id": "Mbpp/623", "solution": "from typing import List\n\ndef _validate_inputs(numbers_list: List[int], n: int) -> None:\n    \"\"\"Validate input parameters to ensure they are positive integers.\"\"\"\n    if not isinstance(numbers_list, list):\n        raise TypeError(\"numbers_list must be a list.\")\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n    \n    for num in numbers_list:\n        if not isinstance(num, int) or num <= 0:\n            raise ValueError(\"All numbers in numbers_list must be positive integers.\")\n\ndef _compute_power(number: int, power: int) -> int:\n    \"\"\"Compute the power of a single number.\"\"\"\n    return number ** power\n\ndef nth_nums(numbers_list: List[int], n: int) -> List[int]:\n    \"\"\"Compute the n-th power of each number in a list.\"\"\"\n    _validate_inputs(numbers_list, n)\n    \n    result_list = []\n    for num in numbers_list:\n        result_list.append(_compute_power(num, n))\n    \n    return result_list"}
