{"task_id": "Mbpp/635", "solution": "from typing import List\n\ndef heap_sort(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Sorts a list of integers using heap sort algorithm.\n\n    Args:\n        input_list: List of integers to sort\n\n    Returns:\n        New list with elements sorted in ascending order\n\n    Time Complexity: O(n log n)\n    Space Complexity: O(1) auxiliary space\n    \"\"\"\n    n = len(input_list)\n    if n == 0:\n        return []\n\n    # Create a mutable copy of the input list for in-place sorting\n    arr = list(input_list)\n\n    def _heapify(arr: List[int], n: int, i: int) -> None:\n        \"\"\"\n        Maintains heap property for subtree rooted at index i.\n        \"\"\"\n        largest = i  # Initialize largest as root\n        l = 2 * i + 1  # left child\n        r = 2 * i + 2  # right child\n\n        # See if left child of root exists and is greater than root\n        if l < n and arr[l] > arr[largest]:\n            largest = l\n\n        # See if right child of root exists and is greater than current largest\n        if r < n and arr[r] > arr[largest]:\n            largest = r\n\n        # Change root, if needed\n        if largest != i:\n            arr[i], arr[largest] = arr[largest], arr[i]  # swap\n\n            # Heapify the affected sub-tree.\n            _heapify(arr, n, largest)\n\n    def _build_max_heap(arr: List[int]) -> None:\n        \"\"\"\n        Builds a max heap from unsorted array.\n        \"\"\"\n        n_local = len(arr) # Use a local variable for the full length\n        # Build a maxheap.\n        # The last non-leaf node is at index (n_local // 2 - 1)\n        for i in range(n_local // 2 - 1, -1, -1):\n            _heapify(arr, n_local, i)\n\n    def _extract_elements(heap: List[int]) -> List[int]:\n        \"\"\"\n        Extracts elements from heap in sorted order (in-place).\n        \"\"\"\n        n_local = len(heap) # Use a local variable for the full length\n\n        # One by one extract elements from the heap\n        for i in range(n_local - 1, 0, -1):\n            # Move current root to end\n            heap[i], heap[0] = heap[0], heap[i]  # swap\n            # call _heapify on the reduced heap\n            _heapify(heap, i, 0) # 'i' here represents the shrinking size of the heap for _heapify\n\n        return heap # The array is now sorted\n\n    # --- Main heap sort logic ---\n    _build_max_heap(arr)\n    sorted_arr = _extract_elements(arr)\n    return sorted_arr"}
{"task_id": "Mbpp/638", "solution": "import math\n\ndef wind_chill(velocity: float, temperature: float) -> int:\n    \"\"\"\n    Calculates the wind chill index rounded to the next integer.\n    Uses the standard wind chill formula, converting velocity from km/h to m/s.\n    \"\"\"\n    # Convert wind velocity from kilometers per hour to meters per second\n    wind_velocity_ms = velocity / 3.6\n\n    # Calculate the raw wind chill index using the standard formula\n    # T in Celsius, V in m/s\n    raw_wind_chill = (\n        13.12\n        + (0.6215 * temperature)\n        - (11.37 * math.pow(wind_velocity_ms, 0.16))\n        + (0.3965 * temperature * math.pow(wind_velocity_ms, 0.16))\n    )\n\n    # Round the result up to the next integer\n    rounded_wind_chill = math.ceil(raw_wind_chill)\n\n    return int(rounded_wind_chill)"}
{"task_id": "Mbpp/639", "solution": "def sample_nam(names):\n    \"\"\"\n    Calculates the sum of lengths of names that start with an uppercase letter.\n    Names starting with a lowercase letter are filtered out.\n    \"\"\"\n    total_length = 0\n    for name in names:\n        if name and name[0].isupper():\n            total_length += len(name)\n    return total_length"}
{"task_id": "Mbpp/638", "solution": "import math\n\ndef wind_chill(velocity: float, temperature: float) -> int:\n    \"\"\"\n    Calculate wind chill index from wind velocity and temperature.\n\n    Args:\n        velocity: Wind velocity in kilometers per hour (non-negative)\n        temperature: Temperature in degrees Celsius\n\n    Returns:\n        Wind chill index rounded to next integer\n\n    Raises:\n        ValueError: If inputs are invalid (negative velocity)\n    \"\"\"\n\n    def _validate_inputs(velocity: float, temperature: float) -> bool:\n        \"\"\"\n        Validates input parameters for the wind chill calculation.\n        Checks for non-negative velocity.\n        \"\"\"\n        return velocity >= 0\n\n    def _round_to_next_integer(value: float) -> int:\n        \"\"\"\n        Rounds a float value up to the next integer (ceiling).\n        \"\"\"\n        return math.ceil(value)\n\n    if not _validate_inputs(velocity, temperature):\n        raise ValueError(\"Invalid inputs: velocity must be non-negative.\")\n\n    # Standard meteorological wind chill formula for Celsius and km/h\n    # This formula is often applied for temperatures up to 10\u00b0C,\n    # but the problem statement does not specify this constraint.\n    # WC = 13.12 + 0.6215*Ta - 11.37*V^0.16 + 0.3965*Ta*V^0.16\n    wind_chill_value = (\n        13.12\n        + 0.6215 * temperature\n        - 11.37 * (velocity**0.16)\n        + 0.3965 * temperature * (velocity**0.16)\n    )\n\n    return _round_to_next_integer(wind_chill_value)"}
