{"task_id": "Mbpp/751", "solution": "def get_left_child_index(parent_index):\n    \"\"\"\n    Calculate left child index for a given parent index.\n    \"\"\"\n    return 2 * parent_index + 1\n\ndef get_right_child_index(parent_index):\n    \"\"\"\n    Calculate right child index for a given parent index.\n    \"\"\"\n    return 2 * parent_index + 2\n\ndef check_min_heap(array):\n    \"\"\"\n    Check if the given array represents a min heap.\n    \"\"\"\n    n = len(array)\n\n    # An empty array or an array with a single element is considered a valid min heap.\n    if n <= 1:\n        return True\n\n    # Iterate through all parent nodes.\n    # The last parent node is at index (n // 2) - 1.\n    for i in range(n // 2):\n        parent_value = array[i]\n\n        left_child_idx = get_left_child_index(i)\n        right_child_idx = get_right_child_index(i)\n\n        # Check if left child exists and violates the min heap property.\n        if left_child_idx < n and parent_value > array[left_child_idx]:\n            return False\n\n        # Check if right child exists and violates the min heap property.\n        if right_child_idx < n and parent_value > array[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list) -> bool:\n    \"\"\"Checks if the given array represents a min heap.\"\"\"\n    n = len(arr)\n\n    # An empty or single-element array is considered a valid min heap.\n    if n <= 1:\n        return True\n\n    # Iterate through all parent nodes. For a 0-indexed array representing a complete binary tree,\n    # parent nodes are at indices from 0 up to (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check if left child exists and violates the min heap property.\n        if left_child_idx < n:\n            if arr[i] > arr[left_child_idx]:\n                return False\n\n        # Check if right child exists and violates the min heap property.\n        if right_child_idx < n:\n            if arr[i] > arr[right_child_idx]:\n                return False\n\n    # If no violations were found after checking all parents, it is a min heap.\n    return True"}
{"task_id": "Mbpp/753", "solution": "def min_k(tuple_list: list, k: int) -> list:\n    \"\"\"\n    Finds the minimum k records from a list of tuples, sorted by their second element.\n    Returns the k smallest records in ascending order.\n    \"\"\"\n    if not tuple_list or k <= 0:\n        return []\n\n    # Sort the list of tuples based on the second element\n    sorted_tuples = sorted(tuple_list, key=lambda x: x[1])\n\n    # Return the first k elements from the sorted list\n    return sorted_tuples[:k]"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n):\n    \"\"\"\n    Calculates the nth Jacobsthal number using an iterative approach.\n    The sequence is defined as J(0)=0, J(1)=1, J(n)=J(n-1)+2*J(n-2) for n >= 2.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n\n    a, b = 0, 1  # Initialize J(0) and J(1)\n    for _ in range(2, n + 1):\n        # Calculate J(i) = J(i-1) + 2 * J(i-2)\n        current = b + 2 * a\n        # Update a and b for the next iteration\n        a = b\n        b = current\n    return b"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number.\n    Uses the recurrence relation J(n) = J(n-1) + 2*J(n-2) with base cases J(0)=0, J(1)=1.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    # J(2) = J(1) + 2*J(0) = 1 + 2*0 = 1\n    # We can handle n=2 as a base case or let the loop handle it\n    # The sequence states J(2) = 1, so direct handling is fine.\n    elif n == 2:\n        return 1\n\n    # For n > 2, use an iterative approach\n    # We need to keep track of J(i-2) and J(i-1) to calculate J(i)\n    # Let a be J(k-2) and b be J(k-1)\n    a, b = 0, 1  # Corresponds to J(0) and J(1)\n\n    # The loop will start from k=2 to calculate J(2), J(3), ..., J(n)\n    # After the loop, b will hold J(n)\n    for _ in range(2, n + 1):\n        # The next Jacobsthal number is J(current) = J(prev) + 2 * J(prev_prev)\n        # new_b = b + 2 * a\n        # a becomes b (the old J(prev))\n        # b becomes new_b (the new J(current))\n        a, b = b, b + 2 * a\n\n    return b"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Find common elements that appear at the same index in all three lists.\n    Compares elements up to the minimum length of the three lists.\n    \"\"\"\n    min_length = min(len(l1), len(l2), len(l3))\n    result = []\n\n    for i in range(min_length):\n        if l1[i] == l2[i] == l3[i]:\n            result.append(l1[i])\n\n    return result"}
