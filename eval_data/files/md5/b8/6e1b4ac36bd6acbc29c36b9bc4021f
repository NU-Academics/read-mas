{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        odd_number = 2 * i - 1\n        total_sum += odd_number ** 4\n    return total_sum"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    \"\"\"\n    total_sum = 0\n    for i in range(n):\n        odd_num = 2 * i + 1\n        total_sum += odd_num ** 4\n    return total_sum"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets using a stack-based approach.\n    Supports round, square, and curly brackets.\n    \"\"\"\n    BRACKET_PAIRS = {')': '(', ']': '[', '}': '{'}\n    stack = []\n\n    for char in expression:\n        if char in BRACKET_PAIRS.values():  # It's an opening bracket\n            stack.append(char)\n        elif char in BRACKET_PAIRS.keys():  # It's a closing bracket\n            if not stack:\n                return False  # Closing bracket without a matching opening bracket\n            if stack.pop() != BRACKET_PAIRS[char]:\n                return False  # Mismatched brackets\n    \n    return not stack  # True if stack is empty, False otherwise (unmatched opening brackets)"}
