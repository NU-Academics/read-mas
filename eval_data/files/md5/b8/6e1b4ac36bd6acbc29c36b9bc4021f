{"task_id": "Mbpp/126", "solution": "def sum(number1: int, number2: int) -> int:\n    \"\"\"\n    Calculates the sum of common divisors of two given positive integers.\n    \"\"\"\n\n    def _calculate_divisors(number: int) -> list[int]:\n        \"\"\"\n        Calculates all positive divisors for a given number.\n        \"\"\"\n        divisors = []\n        for i in range(1, number + 1):\n            if number % i == 0:\n                divisors.append(i)\n        return divisors\n\n    def _find_common_divisors(divisors1: list[int], divisors2: list[int]) -> list[int]:\n        \"\"\"\n        Finds common divisors between two lists of divisors.\n        \"\"\"\n        set1 = set(divisors1)\n        set2 = set(divisors2)\n        return list(set1.intersection(set2))\n\n    divisors_num1 = _calculate_divisors(number1)\n    divisors_num2 = _calculate_divisors(number2)\n\n    common_divs = _find_common_divisors(divisors_num1, divisors_num2)\n\n    return sum(common_divs)"}
{"task_id": "Mbpp/126", "solution": "def sum(num1, num2):\n    \"\"\"\n    Calculates the sum of common divisors of two given numbers.\n    Orchestrates finding divisors, identifying common ones, and summing them.\n    \"\"\"\n\n    def calculate_divisors(number):\n        \"\"\"Calculates all divisors of a given integer number.\"\"\"\n        divs = []\n        for i in range(1, number + 1):\n            if number % i == 0:\n                divs.append(i)\n        return divs\n\n    def find_common_divisors(divisors1, divisors2):\n        \"\"\"Finds divisors that are present in both input lists.\"\"\"\n        return list(set(divisors1) & set(divisors2))\n\n    def sum_common_divisors(common_divs):\n        \"\"\"Calculates the arithmetic sum of a list of divisors.\"\"\"\n        return built_in_sum(common_divs) # Use built_in_sum to avoid conflict with function name 'sum'\n\n    # Store the built-in sum function to avoid conflict with the function's own name 'sum'\n    built_in_sum = __builtins__.sum\n\n    divs1 = calculate_divisors(num1)\n    divs2 = calculate_divisors(num2)\n    \n    common = find_common_divisors(divs1, divs2)\n    \n    return sum_common_divisors(common)"}
{"task_id": "Mbpp/128", "solution": "def long_words(n: int, text: str) -> list[str]:\n    \"\"\"\n    Finds words longer than n characters from a given string of words.\n    Splits the text by whitespace and filters words based on length.\n    \"\"\"\n    words = text.split()\n    return [word for word in words if len(word) > n]"}
{"task_id": "Mbpp/128", "solution": "def long_words(n: int, text_string: str) -> list[str]:\n    \"\"\"\n    Finds words that are longer than n characters from a given string.\n    Splits the text by whitespace and filters words based on length.\n    \"\"\"\n    def _split_text(text: str) -> list[str]:\n        \"\"\"Splits the input text into individual words using whitespace.\"\"\"\n        return text.split()\n\n    def _filter_by_length(words: list[str], threshold: int) -> list[str]:\n        \"\"\"Filters a list of words, keeping only those longer than the threshold.\"\"\"\n        return [word for word in words if len(word) > threshold]\n\n    words = _split_text(text_string)\n    filtered_words = _filter_by_length(words, n)\n    return filtered_words"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix):\n    \"\"\"\n    Determines if a given 2D matrix is a magic square.\n    A magic square has equal sums for all its rows, columns, and main diagonals.\n    \"\"\"\n\n    def _is_square_matrix(mat):\n        \"\"\"Checks if the input matrix is square and not empty.\"\"\"\n        if not mat or not mat[0]:\n            return False\n        n = len(mat)\n        for row in mat:\n            if len(row) != n:\n                return False\n        return True\n\n    def _calculate_row_sums(mat, n_dim):\n        \"\"\"Calculates the sum of each row in the matrix.\"\"\"\n        return [sum(row) for row in mat]\n\n    def _calculate_column_sums(mat, n_dim):\n        \"\"\"Calculates the sum of each column in the matrix.\"\"\"\n        column_sums = [0] * n_dim\n        for j in range(n_dim):\n            for i in range(n_dim):\n                column_sums[j] += mat[i][j]\n        return column_sums\n\n    def _calculate_diagonal_sums(mat, n_dim):\n        \"\"\"Calculates the sum of the main and anti-diagonals.\"\"\"\n        main_diag_sum = 0\n        anti_diag_sum = 0\n        for i in range(n_dim):\n            main_diag_sum += mat[i][i]\n            anti_diag_sum += mat[i][n_dim - 1 - i]\n        return main_diag_sum, anti_diag_sum\n\n    def _are_all_sums_equal(sums_list):\n        \"\"\"Verifies if all sums in a list are identical.\"\"\"\n        if not sums_list:\n            return False  # Should not happen if matrix is valid and not empty\n        first_sum = sums_list[0]\n        for s in sums_list:\n            if s != first_sum:\n                return False\n        return True\n\n    # 1. Validate matrix structure\n    if not _is_square_matrix(matrix):\n        return False\n\n    n = len(matrix)\n\n    # 2. Calculate all required sums\n    row_sums = _calculate_row_sums(matrix, n)\n    column_sums = _calculate_column_sums(matrix, n)\n    main_diag_sum, anti_diag_sum = _calculate_diagonal_sums(matrix, n)\n\n    # 3. Combine all sums for equality check\n    all_sums = row_sums + column_sums + [main_diag_sum, anti_diag_sum]\n\n    # 4. Verify equality\n    return _are_all_sums_equal(all_sums)"}
{"task_id": "Mbpp/129", "solution": "from typing import List\n\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"\n    Validates whether the input matrix is a magic square.\n    It checks if the matrix is square and if all row, column, and diagonal sums are equal.\n    \"\"\"\n\n    def _is_square_matrix(matrix: List[List[int]]) -> bool:\n        \"\"\"Validates that matrix has equal rows and columns.\"\"\"\n        if not matrix:\n            return False\n        num_rows = len(matrix)\n        num_cols = len(matrix[0])\n        if num_rows != num_cols:\n            return False\n        for row in matrix:\n            if len(row) != num_cols:\n                return False\n        return True\n\n    def _calculate_row_sums(matrix: List[List[int]]) -> List[int]:\n        \"\"\"Calculates sum for each row in the matrix.\"\"\"\n        return [sum(row) for row in matrix]\n\n    def _calculate_column_sums(matrix: List[List[int]]) -> List[int]:\n        \"\"\"Calculates sum for each column in the matrix.\"\"\"\n        n = len(matrix)\n        column_sums = [0] * n\n        for i in range(n):\n            for j in range(n):\n                column_sums[j] += matrix[i][j]\n        return column_sums\n\n    def _calculate_main_diagonal_sum(matrix: List[List[int]]) -> int:\n        \"\"\"Calculates sum of main diagonal (top-left to bottom-right).\"\"\"\n        n = len(matrix)\n        main_diag_sum = 0\n        for i in range(n):\n            main_diag_sum += matrix[i][i]\n        return main_diag_sum\n\n    def _calculate_anti_diagonal_sum(matrix: List[List[int]]) -> int:\n        \"\"\"Calculates sum of anti-diagonal (top-right to bottom-left).\"\"\"\n        n = len(matrix)\n        anti_diag_sum = 0\n        for i in range(n):\n            anti_diag_sum += matrix[i][n - 1 - i]\n        return anti_diag_sum\n\n    def _all_sums_equal(sums: List[int]) -> bool:\n        \"\"\"Compares all sums to determine if they are equal.\"\"\"\n        if not sums:\n            return True # Or False depending on interpretation for empty, but here it will always have sums\n        first_sum = sums[0]\n        for s in sums:\n            if s != first_sum:\n                return False\n        return True\n\n    if not _is_square_matrix(matrix):\n        return False\n\n    if not matrix: # Handle empty matrix explicitly, even if _is_square_matrix returns False for it\n        return False\n    \n    # A 1x1 matrix is always a magic square.\n    if len(matrix) == 1 and len(matrix[0]) == 1:\n        return True\n\n    all_sums = []\n    all_sums.extend(_calculate_row_sums(matrix))\n    all_sums.extend(_calculate_column_sums(matrix))\n    all_sums.append(_calculate_main_diagonal_sum(matrix))\n    all_sums.append(_calculate_anti_diagonal_sum(matrix))\n\n    return _all_sums_equal(all_sums)"}
{"task_id": "Mbpp/130", "solution": "from collections import defaultdict\nfrom typing import List, Dict, Any\n\ndef count_frequencies(input_list: List[Any]) -> Dict[Any, int]:\n    \"\"\"Counts the frequency of each unique item in the input list.\"\"\"\n    frequency_dict = defaultdict(int)\n    for item in input_list:\n        frequency_dict[item] += 1\n    return frequency_dict\n\ndef find_max_frequency_item(frequency_dict: Dict[Any, int]) -> Any:\n    \"\"\"Finds the item with the highest frequency from a frequency dictionary.\"\"\"\n    if not frequency_dict:\n        return None # Or raise an error, depending on desired behavior for empty dicts\n\n    max_item = None\n    max_count = -1\n    for item, count in frequency_dict.items():\n        if count > max_count:\n            max_count = count\n            max_item = item\n    return max_item\n\ndef max_occurrences(input_list: List[Any]) -> Any:\n    \"\"\"Finds the item with maximum frequency in a given list.\"\"\"\n    if not input_list:\n        return None # Or raise an error for empty lists\n\n    frequencies = count_frequencies(input_list)\n    return find_max_frequency_item(frequencies)"}
