{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list: list) -> int:\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists of a given list.\n    \"\"\"\n    total_sum_of_products = 0\n    n = len(input_list)\n\n    # Iterate through all possible starting points\n    for i in range(n):\n        # Iterate through all possible ending points for the current starting point\n        for j in range(i, n):\n            # Extract the current sublist\n            current_sublist = input_list[i : j+1]\n\n            # Calculate the product of elements in the current sublist\n            current_product = 1\n            for element in current_sublist:\n                current_product *= element\n            \n            # Add the product to the total sum\n            total_sum_of_products += current_product\n\n    return total_sum_of_products"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array: list, target: int) -> int:\n    \"\"\"\n    Find the index of the first occurrence of target in a sorted array using binary search.\n    Returns the zero-based index of the first occurrence, or -1 if not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            result = mid  # Found potential first occurrence, try to find an earlier one\n            high = mid - 1\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array using binary search.\n    Returns -1 if the target is not found.\n    \"\"\"\n    low, high = 0, len(arr) - 1\n    first_occurrence_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == target:\n            first_occurrence_index = mid  # Store this as a potential first occurrence\n            high = mid - 1  # Continue searching in the left half for an earlier occurrence\n        elif arr[mid] < target:\n            low = mid + 1\n        else:  # arr[mid] > target\n            high = mid - 1\n            \n    return first_occurrence_index"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"\n    Toggle middle bits of number except first and last bit.\n\n    Args:\n        number: Integer to process\n\n    Returns:\n        Integer with middle bits toggled\n    \"\"\"\n    bit_length = number.bit_length()\n\n    # If the number has 0, 1, or 2 bits, there are no \"middle\" bits to toggle.\n    if bit_length <= 2:\n        return number\n\n    # Create a mask for the middle bits (excluding MSB and LSB).\n    # This generates a sequence of `bit_length - 2` ones, shifted left by 1.\n    # Example for bit_length=4: ( (1 << 2) - 1 ) << 1 = (3) << 1 = 6 (binary 0110)\n    middle_bits_mask = ((1 << (bit_length - 2)) - 1) << 1\n\n    # XOR the number with the mask to toggle only the middle bits.\n    return number ^ middle_bits_mask"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list: list):\n    \"\"\"Calculates the sum of products of all possible contiguous sublists of a given list.\n    Assumes the input list contains numeric elements.\n    \"\"\"\n    total_sum_of_products = 0\n    n = len(input_list)\n\n    # Iterate over all possible starting indices of sublists\n    for i in range(n):\n        # Iterate over all possible ending indices of sublists, starting from 'i'\n        for j in range(i, n):\n            # Extract the current contiguous sublist\n            current_sublist = input_list[i : j + 1]\n\n            # Calculate the product of elements within the current sublist\n            current_product = 1\n            for item in current_sublist:\n                current_product *= item\n            \n            # Add the calculated product to the running total sum\n            total_sum_of_products += current_product\n\n    return total_sum_of_products"}
{"task_id": "Mbpp/735", "solution": "def _get_bit_length(number: int) -> int:\n    \"\"\"Calculates the number of bits required to represent the given integer.\"\"\"\n    if number == 0:\n        return 0\n    return number.bit_length()\n\ndef _create_toggle_mask(bit_length: int) -> int:\n    \"\"\"Generates a mask with 1s for middle bits and 0s for first/last bits.\"\"\"\n    if bit_length < 3: # No middle bits for length 0, 1, or 2\n        return 0\n    \n    # Mask of all 1s for the given bit_length\n    all_ones_mask = (1 << bit_length) - 1\n    \n    # Mask for the first (MSB) and last (LSB) bits\n    lsb_mask = 1 \n    msb_mask = (1 << (bit_length - 1))\n    \n    # The toggle mask excludes the MSB and LSB from the all_ones_mask\n    toggle_mask = all_ones_mask ^ (lsb_mask | msb_mask)\n    return toggle_mask\n\ndef toggle_middle_bits(number: int) -> int:\n    \"\"\"Toggle middle bits of an integer while preserving first and last bits.\"\"\"\n    bit_length = _get_bit_length(number)\n    toggle_mask = _create_toggle_mask(bit_length)\n    \n    # Apply XOR operation to toggle only the middle bits\n    return number ^ toggle_mask"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(array: list, target_value) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted array.\n    This function uses a binary search algorithm to achieve O(log n) time complexity.\n    \"\"\"\n    low = 0\n    high = len(array)\n\n    while low < high:\n        mid = low + (high - low) // 2\n        if array[mid] < target_value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
