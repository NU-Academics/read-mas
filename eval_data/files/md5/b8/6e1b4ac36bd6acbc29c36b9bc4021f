{"task_id": "Mbpp/308", "solution": "def large_product(list1, list2, count):\n    \"\"\"\n    Finds the specified number of largest products from two lists, selecting one factor from each list.\n    Returns the largest products in descending order.\n    \"\"\"\n    all_products = []\n    for num1 in list1:\n        for num2 in list2:\n            all_products.append(num1 * num2)\n\n    all_products.sort(reverse=True)\n\n    return all_products[:count]"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(array, length, i, k):\n    # dp[j] stores the maximum sum of an increasing subsequence ending at index j\n    # within the prefix from index 0 to i.\n    dp = [0] * (i + 1)\n\n    # Initialize dp values with the elements themselves.\n    for j in range(i + 1):\n        dp[j] = array[j]\n\n    # Calculate dp values for all indices up to i using dynamic programming.\n    for j in range(1, i + 1):\n        for prev_j in range(j):\n            if array[j] > array[prev_j]:\n                dp[j] = max(dp[j], dp[prev_j] + array[j])\n\n    # Find the maximum sum from dp[j] such that array[j] is less than array[k].\n    # This sum will form the increasing prefix before array[k].\n    max_prefix_sum_before_k = 0\n\n    for j in range(i + 1):\n        if array[j] < array[k]:\n            max_prefix_sum_before_k = max(max_prefix_sum_before_k, dp[j])\n            \n    # The total maximum sum is the best found prefix sum plus the mandatory element array[k].\n    return max_prefix_sum_before_k + array[k]"}
{"task_id": "Mbpp/308", "solution": "def large_product(list1, list2, count):\n    \"\"\"\n    Finds the specified number of largest products from two lists, selecting one factor from each.\n    \"\"\"\n\n    def _calculate_all_products(lst1, lst2):\n        \"\"\"Generates all possible products from the Cartesian product of input lists.\"\"\"\n        products = []\n        for x in lst1:\n            for y in lst2:\n                products.append(x * y)\n        return products\n\n    def _get_top_n_products(all_products, num_count):\n        \"\"\"Sorts products in descending order and returns the top N largest values.\"\"\"\n        # Sorting can be done efficiently, especially if num_count is small\n        # compared to the total number of products, but for simplicity\n        # and given the design context, a full sort is acceptable.\n        all_products.sort(reverse=True)\n        return all_products[:num_count]\n\n    all_products = _calculate_all_products(list1, list2)\n    return _get_top_n_products(all_products, count)"}
