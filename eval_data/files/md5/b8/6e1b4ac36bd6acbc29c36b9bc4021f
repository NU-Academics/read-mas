{"task_id": "Mbpp/630", "solution": "def get_coordinates(coord: tuple) -> list[list[int]]:\n    \"\"\"\n    Extracts all adjacent coordinates in a 3x3 grid pattern centered on the given coordinate.\n    Coordinates are returned in row-major order (x changes slower, y changes faster).\n    \"\"\"\n    center_x, center_y = coord\n    result_coordinates = []\n\n    # Iterate through x-offsets (-1, 0, 1) for the 3x3 grid\n    for dx in [-1, 0, 1]:\n        # Iterate through y-offsets (-1, 0, 1) for the 3x3 grid\n        for dy in [-1, 0, 1]:\n            new_x = center_x + dx\n            new_y = center_y + dy\n            result_coordinates.append([new_x, new_y])\n\n    return result_coordinates"}
{"task_id": "Mbpp/632", "solution": "from typing import List\n\ndef move_zero(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Move all zero values to the end of the list while preserving\n    the relative order of non-zero elements.\n    \"\"\"\n    non_zero_elements = []\n    zero_count = 0\n\n    for item in input_list:\n        if item != 0:\n            non_zero_elements.append(item)\n        else:\n            zero_count += 1\n\n    non_zero_elements.extend([0] * zero_count)\n    return non_zero_elements"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers: list, count: int) -> int:\n    \"\"\"\n    Calculates the sum of XOR of all unique pairs of numbers in the given list.\n    \"\"\"\n    total_xor_sum = 0\n    for i in range(count):\n        for j in range(i + 1, count):\n            total_xor_sum += (numbers[i] ^ numbers[j])\n    return total_xor_sum"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers: list, count: int) -> int:\n    \"\"\"\n    Main function to calculate the sum of XOR of all pairs in a list.\n    It orchestrates the generation of pairs, XOR calculation, and summation.\n    \"\"\"\n\n    def _generate_pairs(numbers: list) -> list:\n        \"\"\"Generate all distinct pairs from the input list.\"\"\"\n        pairs = []\n        n = len(numbers)\n        for i in range(n):\n            for j in range(i + 1, n):\n                pairs.append((numbers[i], numbers[j]))\n        return pairs\n\n    def _calculate_xor(num1: int, num2: int) -> int:\n        \"\"\"Calculate the XOR operation for two numbers.\"\"\"\n        return num1 ^ num2\n\n    def _sum_results(xor_results: list) -> int:\n        \"\"\"Sum all the XOR results from the pairs.\"\"\"\n        return sum(xor_results)\n\n    all_pairs = _generate_pairs(numbers)\n    xor_results = []\n    for num1, num2 in all_pairs:\n        xor_results.append(_calculate_xor(num1, num2))\n\n    total_sum = _sum_results(xor_results)\n    return total_sum"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a list using heap sort algorithm in O(n log n) time.\n    Returns a new sorted list without modifying the input.\n    \"\"\"\n    arr = input_list.copy()\n    n = len(arr)\n\n    if n <= 1:\n        return arr\n\n    # Build a maxheap\n    _build_max_heap(arr)\n\n    # One by one extract elements from heap\n    for i in range(n - 1, 0, -1):\n        _swap(arr, 0, i)  # Move current root to end\n        _heapify(arr, i, 0)  # Call heapify on the reduced heap\n\n    return arr\n\ndef _build_max_heap(arr: list) -> None:\n    \"\"\"Builds a max heap from the given array.\"\"\"\n    n = len(arr)\n    # Start from the last non-leaf node and heapify upwards\n    for i in range(n // 2 - 1, -1, -1):\n        _heapify(arr, n, i)\n\ndef _heapify(arr: list, n: int, i: int) -> None:\n    \"\"\"Maintains the max heap property for subtree rooted at index i.\"\"\"\n    largest = i  # Initialize largest as root\n    left_child = 2 * i + 1\n    right_child = 2 * i + 2\n\n    # See if left child of root exists and is greater than root\n    if left_child < n and arr[left_child] > arr[largest]:\n        largest = left_child\n\n    # See if right child of root exists and is greater than current largest\n    if right_child < n and arr[right_child] > arr[largest]:\n        largest = right_child\n\n    # Change root, if needed\n    if largest != i:\n        _swap(arr, i, largest)\n        # Heapify the root.\n        _heapify(arr, n, largest)\n\ndef _swap(arr: list, i: int, j: int) -> None:\n    \"\"\"Swaps elements at indices i and j in the array.\"\"\"\n    arr[i], arr[j] = arr[j], arr[i]"}
