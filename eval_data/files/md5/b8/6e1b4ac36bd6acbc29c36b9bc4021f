{"task_id": "Mbpp/454", "solution": "import re\n\ndef text_match_wordz(input_string: str) -> bool:\n    \"\"\"\n    Check if input string contains any word with the letter 'z'.\n\n    Args:\n        input_string (str): The text to analyze\n\n    Returns:\n        bool: True if any word contains 'z', False otherwise\n    \"\"\"\n    # Use a regular expression to find a word containing 'z'\n    # \\b matches a word boundary, \\w matches word characters (alphanumeric + underscore)\n    # \\w*z\\w* matches any word that contains 'z'\n    return re.search(r'\\b\\w*z\\w*\\b', input_string) is not None"}
{"task_id": "Mbpp/454", "solution": "def _contains_z(word: str) -> bool:\n    \"\"\"Checks if a single word contains the lowercase letter 'z'.\"\"\"\n    return 'z' in word\n\ndef _extract_words(text: str) -> list[str]:\n    \"\"\"Parses input string into individual words based on alphabetic character sequences.\"\"\"\n    words = []\n    current_word_chars = []\n    for char in text:\n        if char.isalpha():\n            current_word_chars.append(char)\n        else:\n            if current_word_chars:\n                words.append(\"\".join(current_word_chars))\n                current_word_chars = []\n    if current_word_chars: # Add any remaining word after the loop\n        words.append(\"\".join(current_word_chars))\n    return words\n\ndef text_match_wordz(input_string: str) -> bool:\n    \"\"\"Checks if any word in the input string contains the lowercase letter 'z'.\"\"\"\n    words = _extract_words(input_string)\n    for word in words:\n        if _contains_z(word):\n            return True\n    return False"}
