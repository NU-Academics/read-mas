{"task_id": "Mbpp/556", "solution": "def _is_odd(value: int) -> bool:\n    \"\"\"Determines if a number is odd using the modulo operator.\"\"\"\n    return value % 2 != 0\n\ndef _calculate_xor(a: int, b: int) -> int:\n    \"\"\"Calculates the bitwise XOR value of two integers.\"\"\"\n    return a ^ b\n\ndef _generate_pairs(array: list[int], size: int) -> list[tuple[int, int]]:\n    \"\"\"Generates all unique pairs of elements from the input array.\"\"\"\n    pairs = []\n    for i in range(size):\n        for j in range(i + 1, size):\n            pairs.append((array[i], array[j]))\n    return pairs\n\ndef find_Odd_Pair(array: list[int], size: int) -> int:\n    \"\"\"\n    Counts the number of pairs in an array whose XOR value is odd.\n    It uses helper functions for pair generation, XOR calculation, and odd number detection.\n    \"\"\"\n    odd_xor_pair_count = 0\n    all_pairs = _generate_pairs(array, size)\n\n    for element1, element2 in all_pairs:\n        xor_result = _calculate_xor(element1, element2)\n        if _is_odd(xor_result):\n            odd_xor_pair_count += 1\n            \n    return odd_xor_pair_count"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers.\n    It treats missing digits in shorter numbers as zero.\n    \"\"\"\n    num1_abs = abs(num1)\n    num2_abs = abs(num2)\n\n    s_num1 = str(num1_abs)\n    s_num2 = str(num2_abs)\n\n    max_len = max(len(s_num1), len(s_num2))\n\n    # Pad shorter string with leading zeros to align digits from the right\n    s_num1_padded = s_num1.zfill(max_len)\n    s_num2_padded = s_num2.zfill(max_len)\n\n    total_diff = 0\n    for i in range(max_len):\n        digit1 = int(s_num1_padded[i])\n        digit2 = int(s_num2_padded[i])\n        total_diff += abs(digit1 - digit2)\n\n    return total_diff"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr: list[int], n: int) -> int:\n    \"\"\"\n    Counts pairs in array whose XOR value is odd using nested loops.\n    An XOR result is odd if one number is even and the other is odd.\n    \"\"\"\n    odd_xor_pair_count = 0\n    for i in range(n):\n        for j in range(i + 1, n):\n            xor_result = arr[i] ^ arr[j]\n            if xor_result % 2 != 0:\n                odd_xor_pair_count += 1\n    return odd_xor_pair_count"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers.\n    Digits are aligned from right-to-left, with missing digits treated as zero.\n    \"\"\"\n\n    def _extract_digits(number: int) -> list[int]:\n        \"\"\"Converts an integer into a list of its individual digits.\"\"\"\n        if number == 0:\n            return [0]\n        return [int(d) for d in str(abs(number))]\n\n    def _align_digits(digits1: list[int], digits2: list[int]) -> tuple[list[int], list[int]]:\n        \"\"\"Pads the shorter digit list with leading zeros to match the length of the longer list.\"\"\"\n        len1 = len(digits1)\n        len2 = len(digits2)\n        max_len = max(len1, len2)\n\n        padded_digits1 = [0] * (max_len - len1) + digits1\n        padded_digits2 = [0] * (max_len - len2) + digits2\n        return padded_digits1, padded_digits2\n\n    def _calculate_difference(digit1: int, digit2: int) -> int:\n        \"\"\"Calculates the absolute difference between two single digits.\"\"\"\n        return abs(digit1 - digit2)\n\n    digits_a = _extract_digits(num1)\n    digits_b = _extract_digits(num2)\n\n    aligned_digits_a, aligned_digits_b = _align_digits(digits_a, digits_b)\n\n    total_difference = 0\n    for i in range(len(aligned_digits_a)):\n        total_difference += _calculate_difference(aligned_digits_a[i], aligned_digits_b[i])\n\n    return total_difference"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr: list[int], n: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist using Kadane's algorithm.\n    Assumes the input list 'arr' is not empty and 'n' is its correct length.\n    \"\"\"\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, n):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr: list[int], n: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist in the given list using Kadane's algorithm.\n    \"\"\"\n    max_so_far = arr[0]\n    max_ending_here = arr[0]\n\n    for i in range(1, n):\n        max_ending_here = max(arr[i], max_ending_here + arr[i])\n        max_so_far = max(max_so_far, max_ending_here)\n\n    return max_so_far"}
