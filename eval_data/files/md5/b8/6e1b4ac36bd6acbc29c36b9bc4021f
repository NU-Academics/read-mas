{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1, tuple2):\n    \"\"\"\n    Performs element-wise modulo operation on two tuples of the same length.\n    Raises ValueError if tuples have different lengths or ZeroDivisionError for modulo by zero.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    results = []\n    for i in range(len(tuple1)):\n        divisor = tuple2[i]\n        if divisor == 0:\n            raise ZeroDivisionError(\"Modulo by zero is not allowed.\")\n        results.append(tuple1[i] % divisor)\n\n    return tuple(results)"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(tuple_data: tuple) -> list[float]:\n    \"\"\"\n    Calculates the average value for each inner tuple in a tuple of tuples.\n    Returns a list of floating-point averages.\n    \"\"\"\n    averages = []\n    for inner_tuple in tuple_data:\n        current_sum = sum(inner_tuple)\n        current_count = len(inner_tuple)\n        average = current_sum / current_count\n        averages.append(average)\n    return averages"}
{"task_id": "Mbpp/615", "solution": "def _calculate_single_average(inner_tuple):\n    \"\"\"\n    Calculate average for a single tuple.\n    Assumes the input tuple is not empty.\n    \"\"\"\n    return sum(inner_tuple) / len(inner_tuple)\n\ndef average_tuple(tuples):\n    \"\"\"\n    Calculate the average value for each 'column' across the input tuples.\n    This effectively transposes the input and averages the resulting rows.\n    \"\"\"\n    # Transpose the tuple of tuples to group elements by their index (columns)\n    transposed_columns = zip(*tuples)\n    \n    # Calculate the average for each transposed column using the helper\n    averages = [_calculate_single_average(column) for column in transposed_columns]\n    \n    return averages"}
{"task_id": "Mbpp/616", "solution": "def _validate_input_length(tuple1: tuple, tuple2: tuple) -> None:\n    \"\"\"Validate that both tuples have the same length.\"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n\ndef _check_division_by_zero(tuple2: tuple) -> None:\n    \"\"\"Check for zero values in the divisor tuple.\"\"\"\n    if 0 in tuple2:\n        raise ZeroDivisionError(\"Cannot perform modulo by zero.\")\n\ndef _perform_element_wise_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Perform the actual element-wise modulo computation.\"\"\"\n    return tuple(t1 % t2 for t1, t2 in zip(tuple1, tuple2))\n\ndef tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Perform element-wise modulo operation on two tuples.\"\"\"\n    _validate_input_length(tuple1, tuple2)\n    _check_division_by_zero(tuple2)\n    return _perform_element_wise_modulo(tuple1, tuple2)"}
