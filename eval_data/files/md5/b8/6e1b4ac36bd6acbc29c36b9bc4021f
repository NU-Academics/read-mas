{"task_id": "Mbpp/160", "solution": "```python\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple,\n    or returns None if no solution exists.\n    \"\"\"\n\n    def gcd(num1: int, num2: int) -> int:\n        \"\"\"Calculates the greatest common divisor of two integers.\"\"\"\n        while num2:\n            num1, num2 = num2, num1 % num2\n        return num1\n\n    def extended_euclidean(num1: int, num2: int) -> tuple[int, int, int]:\n        \"\"\"\n        Implements the Extended Euclidean Algorithm to find (g, x, y)\n        such that num1*x + num2*y = g, where g is gcd(num1, num2).\n        Assumes num1 and num2 are non-negative.\n        \"\"\"\n        if num2 == 0:\n            return num1, 1, 0\n        else:\n            g, x_prev, y_prev = extended_euclidean(num2, num1 % num2)\n            x = y_prev\n            y = x_prev - (num1 // num2) * y_prev\n            return g, x, y\n\n    # Handle trivial cases where a or b (or both) are zero\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n    if a == 0:\n        return (0, n // b) if n % b == 0 else None\n    if b == 0:\n        return (n // a, 0) if n % a == 0 else None\n\n    # For non-zero a and b, compute gcd(a,b). Use absolute values for consistency.\n    common_divisor = gcd(abs(a), abs(b))\n\n    # If n is not divisible by common_divisor, no integer solution exists\n    if n % common_divisor != 0:\n        return None\n\n    # Apply Extended Euclidean Algorithm to |a| and |b|\n    # This finds x_0, y_0 such that |a|*x_0 + |b|*y_0 = common_divisor\n    _, x_abs, y_abs = extended_euclidean(abs(a), abs(b))\n\n    # Scale x_abs and y_abs to find a particular solution for |a|x + |b|y = n\n    scale_factor = n // common_divisor\n    x_particular_abs = x_abs * scale_factor\n    y_particular_abs = y_abs * scale_factor\n\n    # Adjust signs of x and y based on the original 'a' and 'b'\n    # If 'a' was negative, x needs to be negated; similarly for 'b' and 'y'.\n    x_particular = x_particular_abs\n    y_particular = y_particular_abs\n    if a < 0:\n        x_particular = -x_particular\n    if b < 0:\n        y_particular = -y_particular\n\n    # Normalize the solution (x_particular, y_particular) to find the smallest non-negative x\n    # The general solution is x = x_p + (b/g)*k, y = y_p - (a/g)*k\n    # We want 0 <= x < |b/g|. Python's % operator handles negative numbers appropriately.\n    x_normalized = x_particular % (abs(b) // common_divisor)\n    \n    # Determine the 'k' value used for normalization\n    k = (x_normalized - x_particular) // (abs(b) // common_divisor)\n    \n    # Calculate the corresponding normalized 'y'\n    y_normalized = y_particular - (a // common_divisor) * k\n\n    return (x_normalized, y_normalized)\n```"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Calculates the sum of the series (n - 2*i) from i=0, stopping when the term is <= 0.\n    For example, sum_series(6) calculates 6 + 4 + 2 = 12.\n    \"\"\"\n    total_sum = 0\n    # The loop iterates 'i' from 0 up to n // 2, inclusive.\n    # The series calculation stops when a term is less than or equal to 0.\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        if term > 0:\n            total_sum += term\n        else:\n            # According to the problem statement, we stop when n-x =< 0.\n            # This means the current term (which is <= 0) is not added, and the loop terminates.\n            break\n    return total_sum"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string that match their alphabet position (case-insensitive).\n    E.g., 'a' at index 0, 'b' at index 1, etc.\n    \"\"\"\n    match_count = 0\n    for pos, char in enumerate(input_string):\n        normalized_char = char.lower()\n        if 'a' <= normalized_char <= 'z':\n            # Check if the character's alphabetical position matches its string index\n            if ord(normalized_char) - ord('a') == pos:\n                match_count += 1\n    return match_count"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string that match their position in the English alphabet (case-insensitive).\n    Position 0 corresponds to 'a', position 1 to 'b', and so on.\n    \"\"\"\n    count = 0\n    for i, char in enumerate(input_string):\n        if 0 <= i < 26:  # Check if the position is within the alphabet range\n            expected_char_code = ord('a') + i\n            if char.lower() == chr(expected_char_code):\n                count += 1\n    return count"}
{"task_id": "Mbpp/166", "solution": "```python\ndef find_even_pair(input_list: list[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list whose XOR sum is an even number.\n    The XOR of two numbers is even if they have the same parity (both even or both odd).\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # First pass: count total even and odd numbers\n    for num in input_list:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # Pairs with even XOR are formed by:\n    # 1. Two even numbers (Even ^ Even = Even)\n    # 2. Two odd numbers (Odd ^ Odd = Even)\n    \n    # Calculate combinations for even numbers: nC2 = n * (n - 1) / 2\n    pairs_from_even = (even_count * (even_count - 1)) // 2\n    \n    # Calculate combinations for odd numbers: nC2 = n * (n - 1) / 2\n    pairs_from_odd = (odd_count * (odd_count - 1)) // 2\n    \n    return pairs_from_even + pairs_from_odd\n```"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Handles the edge case where n is 0 as per requirements.\n    \"\"\"\n    if n == 0:\n        return 1\n    \n    # If n is already a power of 2, return n.\n    # A number is a power of 2 if it's positive and has only one bit set.\n    if (n & (n - 1)) == 0:\n        return n\n    \n    # Otherwise, calculate the next power of 2.\n    # This involves finding the number of bits in n and shifting 1 by that amount.\n    return 1 << n.bit_length()"}
