{"task_id": "Mbpp/605", "solution": "def prime_num(n: int) -> bool:\n    \"\"\"\n    Checks if an integer is a prime number using trial division up to its square root.\n    Handles edge cases for numbers less than or equal to 1 efficiently.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "Mbpp/605", "solution": "def prime_num(n: int) -> bool:\n    \"\"\"Check if given integer is a prime number.\"\"\"\n    \n    def _validate_input(val: int) -> bool:\n        \"\"\"Validate that input is a positive integer.\"\"\"\n        return val > 0\n\n    def _is_prime_helper(val: int) -> bool:\n        \"\"\"Core prime number calculation algorithm for numbers > 1.\"\"\"\n        if val == 2:\n            return True\n        if val % 2 == 0:\n            return False\n        # Check for divisibility from 3 up to sqrt(n)\n        i = 3\n        while i * i <= val:\n            if val % i == 0:\n                return False\n            i += 2\n        return True\n\n    if not _validate_input(n):\n        return False\n    \n    if n == 1: # 1 is not a prime number by definition\n        return False\n        \n    return _is_prime_helper(n)"}
