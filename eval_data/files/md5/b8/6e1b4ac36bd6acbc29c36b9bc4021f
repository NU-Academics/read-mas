{"task_id": "Mbpp/643", "solution": "import re\nfrom typing import List\n\ndef check_middle_z(word: str) -> bool:\n    \"\"\"\n    Check if word contains 'z' in middle positions.\n\n    Args:\n        word: Single word to check\n\n    Returns:\n        True if 'z' found in middle positions, False otherwise\n    \"\"\"\n    if len(word) < 3:\n        return False\n    # Check for 'z' in the substring excluding the first and last characters.\n    return 'z' in word[1:-1]\n\ndef parse_words(input_string: str) -> List[str]:\n    \"\"\"\n    Extract words from input string using boundary detection.\n\n    Args:\n        input_string: String to parse\n\n    Returns:\n        List of words found in string\n    \"\"\"\n    # Use regex to find sequences of word characters.\n    return re.findall(r'\\w+', input_string)\n\ndef text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"\n    Check if string contains 'z' in middle positions of words.\n\n    Args:\n        input_string: String to validate\n\n    Returns:\n        True if 'z' found in middle of any word, False otherwise\n    \"\"\"\n    words = parse_words(input_string)\n    for word in words:\n        if check_middle_z(word):\n            return True\n    return False"}
{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string contains 'z' in the middle of any word,\n    excluding the start and end of the word.\n    \"\"\"\n\n    def parse_words(s: str) -> list[str]:\n        \"\"\"Extracts alphabetic word sequences from the input string.\"\"\"\n        words = []\n        current_word_chars = []\n        for char in s:\n            if char.isalpha():\n                current_word_chars.append(char)\n            else:\n                if current_word_chars:\n                    words.append(\"\".join(current_word_chars))\n                    current_word_chars = []\n        if current_word_chars:\n            words.append(\"\".join(current_word_chars))\n        return words\n\n    def check_middle_z(word: str) -> bool:\n        \"\"\"Checks if a single word contains 'z' in a middle position.\"\"\"\n        # A word must be at least 3 characters long to have a middle position.\n        if len(word) < 3:\n            return False\n        # Check characters from index 1 (second char) to len(word) - 2 (second to last char).\n        for i in range(1, len(word) - 1):\n            if word[i] == 'z':\n                return True\n        return False\n\n    words = parse_words(input_string)\n    for word in words:\n        if check_middle_z(word):\n            return True\n    return False"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(arr, k):\n    \"\"\"\n    Reverses array elements from index 0 to k-1 (exclusive of k).\n    \"\"\"\n    first_part = arr[:k]\n    second_part = arr[k:]\n    reversed_first_part = first_part[::-1]\n    return reversed_first_part + second_part"}
