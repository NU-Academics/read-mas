{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"\n    Calculates the number of odd decimal equivalents obtained by rotating a binary string.\n\n    Rotates the `binary_string` a given `rotations` number of times,\n    converts each rotated string to decimal, and counts how many are odd.\n    \"\"\"\n\n    def rotate_left(s: str, positions: int) -> str:\n        \"\"\"Rotates a string s to the left by 'positions'.\"\"\"\n        n = len(s)\n        actual_positions = positions % n\n        return s[actual_positions:] + s[:actual_positions]\n\n    def binary_to_decimal(b_str: str) -> int:\n        \"\"\"Converts a binary string to its decimal integer equivalent.\"\"\"\n        return int(b_str, 2)\n\n    def is_odd(value: int) -> bool:\n        \"\"\"Checks if an integer value is odd.\"\"\"\n        return value % 2 != 0\n\n    odd_count = 0\n    for i in range(rotations):\n        rotated_str = rotate_left(binary_string, i)\n        decimal_val = binary_to_decimal(rotated_str)\n        if is_odd(decimal_val):\n            odd_count += 1\n\n    return odd_count"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists: list) -> list:\n    \"\"\"Finds common elements across all sublists in a list of nested lists.\n    Returns elements that appear in every sublist.\n    \"\"\"\n\n    # Helper function: Minimal validation stub due to strict constraints.\n    # Per requirement: \"Do NOT add isinstance() checks or raise exceptions\".\n    # Therefore, actual type/structure validation is omitted here.\n    def _validate_input(input_lists: list) -> bool:\n        \"\"\"Minimal validation stub for design adherence, given constraints.\"\"\"\n        return True\n\n    # Helper function: Finds the intersection of all sublists using set operations.\n    def _find_intersection(input_lists: list) -> set:\n        \"\"\"Find intersection of all sublists using set operations.\"\"\"\n        # Initialize the set with the elements from the first sublist.\n        common_elements = set(input_lists[0])\n        # Iterate through the remaining sublists and find their intersection.\n        for sublist in input_lists[1:]:\n            common_elements.intersection_update(sublist)\n        return common_elements\n\n    # Helper function: Converts a set result to a list format.\n    def _convert_to_list(result_set: set) -> list:\n        \"\"\"Convert set result to list format.\"\"\"\n        return list(result_set)\n\n    # Call the (stub) validation function as per design.\n    # Its return value is not used to prevent forbidden error handling.\n    _validate_input(nested_lists)\n\n    # Handle the case of an empty input list early, without complex validation.\n    if not nested_lists:\n        return []\n\n    # Perform the core intersection logic.\n    intersection_set = _find_intersection(nested_lists)\n\n    # Convert the resulting set to a list and return.\n    return _convert_to_list(intersection_set)"}
{"task_id": "Mbpp/113", "solution": "```python\ndef check_integer(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string represents a valid integer.\n\n    Handles positive, negative, and zero integers, rejecting empty, alphabetic,\n    and mixed alphanumeric strings.\n    \"\"\"\n    if not input_string:\n        return False\n\n    start_index = 0\n    if input_string[0] == '-' or input_string[0] == '+':\n        start_index = 1\n        # A string consisting only of a sign (e.g., \"-\", \"+\") is not an integer.\n        if len(input_string) == 1:\n            return False\n\n    # After handling an optional sign, the string must contain at least one digit.\n    # So, if start_index is now equal to the length, it means there are no digits.\n    if start_index == len(input_string):\n        return False\n\n    for i in range(start_index, len(input_string)):\n        if not ('0' <= input_string[i] <= '9'):\n            return False\n\n    return True\n```"}
{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string represents an integer.\n\n    Handles positive, negative, and zero integers, rejecting non-numeric, empty, or decimal strings.\n    \"\"\"\n    if not input_string:\n        return False\n\n    start_index = 0\n    if input_string[0] == '-':\n        start_index = 1\n        # A standalone '-' is not a valid integer.\n        if len(input_string) == 1:\n            return False\n    elif input_string[0] == '+':\n        # The design implies '+' is not a valid prefix, only '-' for negative numbers.\n        return False\n\n    # After checking for a potential sign, the remaining part must contain digits.\n    # This also covers cases like \"\" after sign processing, e.g., if input was just '-'.\n    if start_index == len(input_string):\n        return False\n\n    for i in range(start_index, len(input_string)):\n        # Check if each character is an ASCII digit.\n        if not '0' <= input_string[i] <= '9':\n            return False\n\n    return True"}
