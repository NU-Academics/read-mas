{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if a number is undulating, meaning it alternates between exactly two different digits.\n    The number must have at least 3 digits.\n    \"\"\"\n    s = str(number)\n    len_s = len(s)\n\n    if len_s < 3:\n        return False\n\n    first_digit = s[0]\n    second_digit = s[1]\n\n    if first_digit == second_digit:\n        return False\n\n    for i in range(2, len_s):\n        if i % 2 == 0:  # Even index, should match the first digit\n            if s[i] != first_digit:\n                return False\n        else:  # Odd index, should match the second digit\n            if s[i] != second_digit:\n                return False\n\n    return True"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(tuple_list):\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value.\n    Handles ties by returning the first occurrence.\n    \"\"\"\n    min_second_value = tuple_list[0][1]\n    result_first_value = tuple_list[0][0]\n\n    for first_val, second_val in tuple_list[1:]:\n        if second_val < min_second_value:\n            min_second_value = second_val\n            result_first_value = first_val\n\n    return result_first_value"}
{"task_id": "Mbpp/94", "solution": "from typing import List, Tuple, Any\n\ndef _find_minimum_tuple(tuple_list: List[Tuple]) -> Tuple:\n    \"\"\"Finds the tuple with the minimum second value, returning the first occurrence in case of a tie.\"\"\"\n    # Python's min() function with a key handles finding the minimum based on the second element\n    # and returns the first matching element if multiple have the same minimum value.\n    return min(tuple_list, key=lambda x: x[1])\n\ndef _extract_first_value(tup: Tuple) -> Any:\n    \"\"\"Extracts the first value from a given tuple.\"\"\"\n    return tup[0]\n\ndef index_minimum(tuple_list: List[Tuple]) -> Any:\n    \"\"\"Returns the first value of the tuple with the smallest second value.\"\"\"\n    # This function orchestrates finding the tuple with the smallest second value\n    # and then extracts its first element.\n    \n    minimum_tuple = _find_minimum_tuple(tuple_list)\n    result = _extract_first_value(minimum_tuple)\n    return result"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Check whether the given number is undulating or not.\n    An undulating number has at least 3 digits and alternates between exactly two different digits.\n    \"\"\"\n\n    def extract_digits(num: int) -> list[int]:\n        \"\"\"Extract individual digits from number as a list.\"\"\"\n        return [int(d) for d in str(num)]\n\n    def check_minimum_length(d_list: list[int]) -> bool:\n        \"\"\"Check if digit list meets minimum length requirement (at least 3).\"\"\"\n        return len(d_list) >= 3\n\n    def verify_two_distinct_digits(d_list: list[int]) -> bool:\n        \"\"\"Verify exactly two distinct digits are present in the list.\"\"\"\n        return len(set(d_list)) == 2\n\n    def validate_alternating_pattern(d_list: list[int]) -> bool:\n        \"\"\"Validate if digits strictly alternate between two values.\"\"\"\n        if len(d_list) < 2:\n            return False\n\n        # The two digits expected to alternate are the first and second\n        digit_a = d_list[0]\n        digit_b = d_list[1]\n\n        # The two alternating digits must be different\n        if digit_a == digit_b:\n            return False\n\n        for i in range(len(d_list)):\n            if i % 2 == 0:  # Even indices should match the first digit\n                if d_list[i] != digit_a:\n                    return False\n            else:  # Odd indices should match the second digit\n                if d_list[i] != digit_b:\n                    return False\n        return True\n\n    digits = extract_digits(number)\n\n    if not check_minimum_length(digits):\n        return False\n\n    if not verify_two_distinct_digits(digits):\n        return False\n\n    return validate_alternating_pattern(digits)"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists: list) -> int:\n    \"\"\"\n    Finds the length of the smallest list within a given list of lists.\n    It iterates through all sublists and returns the minimum length found.\n    \"\"\"\n    min_length = float('inf')\n\n    for sublist in list_of_lists:\n        current_length = len(sublist)\n        if current_length < min_length:\n            min_length = current_length\n\n    return int(min_length)"}
{"task_id": "Mbpp/96", "solution": "def divisor(number: int) -> int:\n    \"\"\"\n    Calculate the number of divisors for a given integer.\n\n    Counts divisors by checking pairs up to the square root of the number.\n    \"\"\"\n    count = 0\n    i = 1\n    while i * i <= number:\n        if number % i == 0:\n            if i * i == number:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of divisors for a given integer.\n    Iterates up to the square root of n to find pairs of divisors efficiently.\n    \"\"\"\n    count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count"}
