{"task_id": "Mbpp/299", "solution": "def max_aggregate(tuple_list):\n    \"\"\"\n    Calculate maximum aggregate from list of tuples.\n\n    Aggregates numeric values for each unique name and returns the name with the highest total.\n    \"\"\"\n    aggregates = {}\n    for name, value in tuple_list:\n        aggregates[name] = aggregates.get(name, 0) + value\n\n    max_name = None\n    max_value = -1  # Initialize with a value lower than any possible sum (assuming non-negative values)\n\n    if not aggregates:\n        return None, 0 # Or handle as per specific requirement for empty input; currently returns based on max_value default\n\n    for name, value in aggregates.items():\n        if value > max_value:\n            max_value = value\n            max_name = name\n\n    return (max_name, max_value)"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(tuples_list):\n    \"\"\"\n    Calculate the maximum aggregate from the list of tuples.\n    Aggregates numeric values for each unique name and returns the name with the highest sum.\n    \"\"\"\n    aggregates = {}\n    for name, value in tuples_list:\n        aggregates[name] = aggregates.get(name, 0) + value\n\n    max_name = None\n    max_value = 0\n\n    for name, total_value in aggregates.items():\n        if total_value > max_value:\n            max_value = total_value\n            max_name = name\n\n    return (max_name, max_value)"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Calculates the count of binary sequences of length 2n where the sum of the first\n    n bits equals the sum of the last n bits using combinatorial formula.\n    \"\"\"\n\n    def binomial_coefficient(n_val: int, k_val: int) -> int:\n        \"\"\"\n        Calculates the binomial coefficient C(n_val, k_val).\n        \"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n        \n        res = 1\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    total_count = 0\n    for k in range(n + 1):\n        coefficient = binomial_coefficient(n, k)\n        total_count += coefficient * coefficient\n    \n    return float(total_count)"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Counts all binary sequences of length 2n where the sum of the first n bits\n    equals the sum of the last n bits.\n    \"\"\"\n    total_count = 0\n    # Iterate through all possible sums 'k' for the first 'n' bits (0 to n).\n    # For each 'k', add (C(n, k))^2 to the total count.\n    for k in range(n + 1):\n        combinations_for_k = math.comb(n, k)\n        total_count += combinations_for_k * combinations_for_k\n    \n    return float(total_count)"}
