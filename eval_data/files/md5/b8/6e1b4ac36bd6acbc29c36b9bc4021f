{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"\n    Count the number of equal integers from three given values.\n    Returns 3 if all are equal, 2 if exactly two are equal, and 0 if all are different.\n    \"\"\"\n    unique_numbers = len({a, b, c})\n\n    if unique_numbers == 1:\n        return 3\n    elif unique_numbers == 2:\n        return 2\n    else:  # unique_numbers == 3\n        return 0"}
{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(number):\n    \"\"\"\n    Checks if the given number is a perfect square.\n    Handles negative numbers, integers, and floating-point inputs.\n    \"\"\"\n    if number < 0:\n        return False\n    \n    # Calculate the square root of the number.\n    # This efficiently handles both integer and floating-point values.\n    root = math.sqrt(number)\n    \n    # A number is a perfect square if its square root is an integer.\n    # This uses the float method .is_integer() for precise checking.\n    return root.is_integer()"}
