{"task_id": "Mbpp/440", "solution": "import string\n\ndef _clean_punctuation(word: str) -> str:\n    \"\"\"Removes leading and trailing punctuation from a word.\"\"\"\n    return word.strip(string.punctuation)\n\ndef _is_adverb(word: str) -> bool:\n    \"\"\"Checks if a cleaned word is a known adverb or ends with 'ly'.\"\"\"\n    adverbs = {\n        \"clearly\", \"quickly\", \"slowly\", \"carefully\", \"happily\", \"sadly\",\n        \"always\", \"never\", \"often\", \"sometimes\", \"usually\", \"rarely\",\n        \"very\", \"quite\", \"rather\", \"too\", \"enough\", \"hard\", \"fast\",\n        \"well\", \"badly\", \"here\", \"there\", \"everywhere\", \"somewhere\",\n        \"now\", \"then\", \"today\", \"tomorrow\", \"yesterday\"\n    }\n    lower_word = word.lower()\n    if lower_word.endswith(\"ly\") and lower_word not in {\"friendly\", \"lovely\", \"daily\", \"early\"}:\n        return True\n    return lower_word in adverbs\n\ndef _calculate_positions(word_start_index: int, clean_word: str) -> tuple[int, int]:\n    \"\"\"Calculates start and end positions of the adverb.\"\"\"\n    start_pos = word_start_index\n    end_pos = start_pos + len(clean_word)\n    return (start_pos, end_pos)\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Returns (start_position, end_position, adverb_text) or None if no adverb is found.\n    \"\"\"\n    if not sentence:\n        return None\n\n    word_start_index = -1\n    for i in range(len(sentence)):\n        char = sentence[i]\n\n        if char.isspace():\n            if word_start_index != -1:\n                word = sentence[word_start_index:i]\n                cleaned_word = _clean_punctuation(word)\n                if _is_adverb(cleaned_word):\n                    start_pos, end_pos = _calculate_positions(word_start_index, cleaned_word)\n                    return (start_pos, end_pos, cleaned_word)\n                word_start_index = -1\n        elif word_start_index == -1:\n            word_start_index = i\n\n    if word_start_index != -1:\n        word = sentence[word_start_index:]\n        cleaned_word = _clean_punctuation(word)\n        if _is_adverb(cleaned_word):\n            start_pos, end_pos = _calculate_positions(word_start_index, cleaned_word)\n            return (start_pos, end_pos, cleaned_word)\n\n    return None"}
{"task_id": "Mbpp/445", "solution": "def _multiply_elements(elem1, elem2):\n    \"\"\"\n    Recursively multiplies elements, handling nested tuples.\n    If both elements are tuples, it performs index-wise multiplication on them.\n    \"\"\"\n    if isinstance(elem1, tuple) and isinstance(elem2, tuple):\n        return tuple(_multiply_elements(e1, e2) for e1, e2 in zip(elem1, elem2))\n    else:\n        return elem1 * elem2\n\ndef index_multiplication(tuple1, tuple2):\n    \"\"\"\n    Performs index-wise multiplication of tuple elements, supporting nested tuples.\n    It iterates through the main tuples and applies a recursive helper for multiplication.\n    \"\"\"\n    result = []\n    for item1, item2 in zip(tuple1, tuple2):\n        result.append(_multiply_elements(item1, item2))\n    return tuple(result)"}
{"task_id": "Mbpp/445", "solution": "def handle_nested_tuples(nested1: tuple, nested2: tuple) -> tuple:\n    \"\"\"Processes nested tuple multiplication element-wise.\"\"\"\n    return tuple(n1 * n2 for n1, n2 in zip(nested1, nested2))\n\ndef multiply_elements(elem1, elem2):\n    \"\"\"Multiplies elements, handling nested tuples or direct numeric multiplication.\"\"\"\n    if isinstance(elem1, tuple) and isinstance(elem2, tuple):\n        return handle_nested_tuples(elem1, elem2)\n    return elem1 * elem2\n\ndef index_multiplication(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Performs index-wise multiplication of tuple elements, handling nested tuples.\"\"\"\n    processed_elements = [\n        multiply_elements(item1, item2)\n        for item1, item2 in zip(tuple1, tuple2)\n    ]\n    return tuple(processed_elements)"}
{"task_id": "Mbpp/440", "solution": "import string\n\ndef remove_punctuation(word: str) -> str:\n    \"\"\"Removes leading and trailing punctuation from a word.\"\"\"\n    return word.strip(string.punctuation)\n\ndef is_adverb(word: str) -> bool:\n    \"\"\"\n    Checks if a word is an adverb based on the 'ly' suffix heuristic.\n    The word should be cleaned of external punctuation before being passed.\n    \"\"\"\n    return word.endswith('ly') and len(word) > 2\n\ndef calculate_positions(raw_word: str, full_sentence: str, raw_word_start_idx: int) -> tuple:\n    \"\"\"\n    Calculates the start and end positions and the clean text of an adverb\n    within the full sentence, considering leading punctuation removal.\n    \"\"\"\n    clean_word = remove_punctuation(raw_word)\n\n    # Determine the length of leading punctuation that was removed from the raw_word\n    leading_punct_len = 0\n    for char in raw_word:\n        if char in string.punctuation:\n            leading_punct_len += 1\n        else:\n            break\n    \n    start_pos_clean = raw_word_start_idx + leading_punct_len\n    end_pos_clean = start_pos_clean + len(clean_word)\n    \n    return (start_pos_clean, end_pos_clean, clean_word)\n\ndef find_adverb_position(sentence: str) -> tuple:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Returns a tuple (start_position, end_position, adverb_text) or None if no adverb is found.\n    \"\"\"\n    if not sentence:\n        return None\n\n    current_search_index = 0\n    words = sentence.split() # Splits the sentence by whitespace\n\n    for raw_word in words:\n        # Find the start index of the raw word in the original sentence,\n        # beginning the search from the current_search_index.\n        word_start_in_sentence = sentence.find(raw_word, current_search_index)\n        \n        # If find() returns -1, it means the word wasn't found from the current index.\n        # This could happen with unusual whitespace or if a word was already processed.\n        # We advance the search index to avoid infinite loops or incorrect re-matching.\n        if word_start_in_sentence == -1:\n            current_search_index += len(raw_word) + 1 # Assume a space separates words\n            continue\n\n        clean_word_for_check = remove_punctuation(raw_word)\n\n        if is_adverb(clean_word_for_check):\n            # If an adverb is found, calculate its precise positions and clean text.\n            return calculate_positions(raw_word, sentence, word_start_in_sentence)\n        \n        # Update current_search_index to search for the next word\n        # immediately after the current raw_word in the original sentence.\n        current_search_index = word_start_in_sentence + len(raw_word)\n    \n    return None"}
