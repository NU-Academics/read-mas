{"task_id": "Mbpp/763", "solution": "def find_min_diff(array, length):\n    \"\"\"\n    Calculates the minimum absolute difference between any two distinct elements in an array.\n    Uses a nested loop to compare all unique pairs.\n    \"\"\"\n    min_diff = float('inf')\n\n    # Iterate over all possible pairs of elements\n    for i in range(length):\n        for j in range(i + 1, length):  # Start j from i+1 to avoid duplicate pairs and self-comparison\n            diff = abs(array[i] - array[j])\n            if diff < min_diff:\n                min_diff = diff\n    \n    return min_diff"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(array, length):\n    \"\"\"\n    Finds the minimum absolute difference between any two distinct elements in an array.\n    Sorts the array first to efficiently calculate differences between adjacent elements.\n    \"\"\"\n    sorted_array = sorted(array)\n    min_diff = float('inf')\n\n    for i in range(1, length):\n        current_diff = sorted_array[i] - sorted_array[i-1]\n        if current_diff < min_diff:\n            min_diff = current_diff\n\n    return min_diff"}
{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number, which is a positive integer that can be expressed as the sum of two or more consecutive positive integers.\n    These numbers are precisely the positive integers that are not powers of two.\n    \"\"\"\n\n    def _is_power_of_two(num: int) -> bool:\n        \"\"\"Checks if a positive integer is a power of two using bitwise operations.\"\"\"\n        return num > 0 and (num & (num - 1)) == 0\n\n    count = 0\n    num = 1\n    while True:\n        # Polite numbers are positive integers that are not powers of two.\n        if not _is_power_of_two(num):\n            count += 1\n            if count == n:\n                return num\n        num += 1"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list, target_sum: int) -> int:\n    \"\"\"\n    Counts the number of pairs in a list whose sum is equal to a target value.\n    Each occurrence of a number is treated as a distinct element.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
