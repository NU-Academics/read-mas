{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Finds elements unique to either of the two input tuples, preserving their original order.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n\n    dissimilar_elements = []\n\n    # Add elements from tuple1 that are not in tuple2, preserving order\n    for item in tuple1:\n        if item not in set2:\n            dissimilar_elements.append(item)\n\n    # Add elements from tuple2 that are not in tuple1, preserving order\n    for item in tuple2:\n        if item not in set1:\n            dissimilar_elements.append(item)\n\n    return tuple(dissimilar_elements)"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Finds elements present in either tuple1 or tuple2 but not in both.\n    \"\"\"\n    def _get_unique_elements(t1: tuple, t2: tuple) -> set:\n        \"\"\"Converts tuples to sets and finds their symmetric difference.\"\"\"\n        set1 = set(t1)\n        set2 = set(t2)\n        return set1.symmetric_difference(set2)\n\n    def _convert_to_tuple(elements: set) -> tuple:\n        \"\"\"Converts a set of elements into a sorted tuple.\"\"\"\n        return tuple(sorted(list(elements)))\n\n    unique_set = _get_unique_elements(tuple1, tuple2)\n    result_tuple = _convert_to_tuple(unique_set)\n    return result_tuple"}
{"task_id": "Mbpp/581", "solution": "import math\n\ndef surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the surface area of a square pyramid given its base edge and height.\n    \"\"\"\n    base_area = base_edge * base_edge\n    \n    # Calculate the slant height of the pyramid\n    half_base_edge = base_edge / 2\n    slant_height = math.sqrt(height**2 + half_base_edge**2)\n    \n    # Calculate the area of one triangular face\n    triangular_face_area = 0.5 * base_edge * slant_height\n    \n    # Total surface area is the base area plus the area of the four triangular faces\n    total_surface_area = base_area + (4 * triangular_face_area)\n    \n    return total_surface_area"}
{"task_id": "Mbpp/581", "solution": "import math\n\ndef surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the total surface area of a square pyramid.\n    It sums the base area and the area of the four triangular faces.\n    \"\"\"\n    base_area = base_edge ** 2\n    \n    # Calculate slant height using Pythagorean theorem\n    # slant_height = sqrt(height^2 + (base_edge/2)^2)\n    slant_height = math.sqrt(height**2 + (base_edge / 2)**2)\n    \n    # Area of the four triangular faces\n    lateral_area = 2 * base_edge * slant_height\n    \n    total_surface_area = base_area + lateral_area\n    return total_surface_area"}
{"task_id": "Mbpp/580", "solution": "def _is_even(value: int) -> bool:\n    \"\"\"Checks if an integer is even.\"\"\"\n    return value % 2 == 0\n\ndef extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"Removes uneven elements from a nested mixed tuple, preserving structure.\"\"\"\n    result_elements = []\n\n    def _process_element(element: any) -> any:\n        \"\"\"Processes individual tuple elements, handling recursion for nested tuples.\"\"\"\n        if isinstance(element, int):\n            if _is_even(element):\n                return element\n            # If an odd integer, return None to indicate removal\n            return None\n        elif isinstance(element, tuple):\n            # Recursively call extract_even on nested tuples\n            return extract_even(element)\n        else:\n            # Keep non-integer, non-tuple elements as is\n            return element\n\n    for element in input_tuple:\n        processed = _process_element(element)\n        # Only add elements that are not None (i.e., not odd integers)\n        if processed is not None:\n            result_elements.append(processed)\n\n    return tuple(result_elements)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"Recursively removes odd integers from a nested tuple, preserving structure and other elements.\"\"\"\n    filtered_elements = []\n    for item in input_tuple:\n        if isinstance(item, tuple):\n            # If it's a nested tuple, recursively process it.\n            filtered_elements.append(extract_even(item))\n        elif isinstance(item, int):\n            # If it's an integer, include only if it's even.\n            if item % 2 == 0:\n                filtered_elements.append(item)\n        else:\n            # For non-integer and non-tuple elements, keep them as is.\n            filtered_elements.append(item)\n    return tuple(filtered_elements)"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Catalan number using the formula C(n) = (2n)! / ((n+1)! * n!).\n    \"\"\"\n    def _factorial(k: int) -> int:\n        \"\"\"\n        Calculates the factorial of a non-negative integer k.\n        \"\"\"\n        if k == 0:\n            return 1\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    numerator = _factorial(2 * n)\n    denominator = _factorial(n + 1) * _factorial(n)\n    return numerator // denominator"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Catalan number using the formula C(n) = (2n)! / ((n+1)! * n!).\n    Assumes n is a non-negative integer.\n    \"\"\"\n    def _compute_factorial(k: int) -> int:\n        \"\"\"Computes the factorial of a non-negative integer k.\"\"\"\n        if k == 0:\n            return 1\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    numerator = _compute_factorial(2 * n)\n    denominator = _compute_factorial(n + 1) * _compute_factorial(n)\n    \n    return numerator // denominator"}
