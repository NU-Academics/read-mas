{"task_id": "Mbpp/123", "solution": "def get_proper_divisors(number: int) -> list[int]:\n    \"\"\"\n    Finds all proper divisors of a given positive integer.\n    Proper divisors are all positive divisors of a number except the number itself.\n    \"\"\"\n    if number <= 1:\n        return []\n    divs = [1]\n    for i in range(2, int(number**0.5) + 1):\n        if number % i == 0:\n            divs.append(i)\n            if i * i != number:\n                divs.append(number // i)\n    return sorted(divs)\n\ndef sum_divisors(number: int) -> int:\n    \"\"\"\n    Calculates the sum of proper divisors for a number.\n    \"\"\"\n    return sum(get_proper_divisors(number))\n\ndef is_amicable_pair(a: int, b: int) -> bool:\n    \"\"\"\n    Determines if two distinct numbers form an amicable pair.\n    \"\"\"\n    if a == b:\n        return False\n    return sum_divisors(a) == b and sum_divisors(b) == a\n\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Calculates the sum of all amicable numbers from 1 up to a specified limit.\n    \"\"\"\n    total_sum = 0\n    found_amicable_numbers = set()\n\n    for i in range(1, limit + 1):\n        if i in found_amicable_numbers:\n            continue\n\n        sum_of_divisors_i = sum_divisors(i)\n\n        if sum_of_divisors_i > i and sum_of_divisors_i <= limit:\n            if is_amicable_pair(i, sum_of_divisors_i):\n                total_sum += i + sum_of_divisors_i\n                found_amicable_numbers.add(i)\n                found_amicable_numbers.add(sum_of_divisors_i)\n    return total_sum"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any sub-string\n    of the given binary string using a single pass (Kadane's algorithm adaptation).\n    \"\"\"\n    max_overall_diff = 0\n    current_max_diff = 0\n\n    for char in binary_string:\n        # Assign 1 for '0' and -1 for '1' to transform the problem\n        # into finding the maximum sum of a subarray.\n        value = 1 if char == '0' else -1\n        \n        current_max_diff += value\n        \n        # If current_max_diff becomes negative, it's better to start a new\n        # substring from the next character, so reset to 0.\n        if current_max_diff < 0:\n            current_max_diff = 0\n        \n        # Update the overall maximum difference found so far.\n        max_overall_diff = max(max_overall_diff, current_max_diff)\n            \n    return max_overall_diff"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring.\n    Iterates through all possible substrings and tracks the maximum absolute difference.\n    \"\"\"\n    max_diff = 0\n    n = len(binary_string)\n\n    # Iterate through all possible starting positions of a substring\n    for i in range(n):\n        zeros_count = 0\n        ones_count = 0\n        # Iterate through all possible ending positions for substrings starting at i\n        for j in range(i, n):\n            # Update counts for the current character at binary_string[j]\n            if binary_string[j] == '0':\n                zeros_count += 1\n            else: # char == '1'\n                ones_count += 1\n\n            # Calculate the absolute difference for the current substring s[i:j+1]\n            current_diff = abs(zeros_count - ones_count)\n            # Update the maximum difference found so far\n            if current_diff > max_diff:\n                max_diff = current_diff\n\n    return max_diff"}
