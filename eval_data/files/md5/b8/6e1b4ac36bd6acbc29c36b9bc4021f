{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Inserts spaces before capital letters that follow lowercase letters in the given string.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    result = [input_string[0]]\n    for i in range(1, len(input_string)):\n        if input_string[i].isupper() and input_string[i-1].islower():\n            result.append(' ')\n        result.append(input_string[i])\n    return \"\".join(result)"}
{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing the digit 0 are excluded.\n    \"\"\"\n\n    def extract_digits(number: int) -> list[int]:\n        \"\"\"Extracts individual digits from a number as a list.\"\"\"\n        return [int(d) for d in str(number)]\n\n    def contains_zero(number: int) -> bool:\n        \"\"\"Checks if a number contains the digit zero.\"\"\"\n        return '0' in str(number)\n\n    def is_divisible_by_all_digits(number: int) -> bool:\n        \"\"\"Verifies if a number is divisible by all its digits.\"\"\"\n        digits = extract_digits(number)\n        for digit in digits:\n            # We assume contains_zero has already filtered out numbers with 0\n            if number % digit != 0:\n                return False\n        return True\n\n    result = []\n    for num in range(startnum, endnum + 1):\n        if not contains_zero(num):\n            if is_divisible_by_all_digits(num):\n                result.append(num)\n    return result"}
{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum: int, endnum: int) -> list:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing the digit zero are excluded.\n    \"\"\"\n\n    def extract_digits(number: int) -> list:\n        \"\"\"Extracts individual digits from a number as a list of integers.\"\"\"\n        return [int(d) for d in str(number)]\n\n    def contains_zero(number: int) -> bool:\n        \"\"\"Checks if a number contains the digit zero.\"\"\"\n        return '0' in str(number)\n\n    def is_divisible_by_all_digits(number: int) -> bool:\n        \"\"\"Verifies if a number is divisible by all of its constituent digits.\"\"\"\n        digits = extract_digits(number)\n        for digit in digits:\n            # Assumes contains_zero has already filtered out numbers with '0'\n            if number % digit != 0:\n                return False\n        return True\n\n    def validate_range(startnum: int, endnum: int) -> bool:\n        \"\"\"Validates that input parameters form a valid range (startnum <= endnum).\"\"\"\n        return startnum <= endnum\n\n    if not validate_range(startnum, endnum):\n        return []\n\n    result = []\n    for num in range(startnum, endnum + 1):\n        if contains_zero(num):\n            continue\n        if is_divisible_by_all_digits(num):\n            result.append(num)\n\n    return result"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Inserts spaces before words starting with capital letters in a given string,\n    except for the very first character if it's capitalized.\n    \"\"\"\n\n    def _find_capital_positions(text: str) -> list[int]:\n        \"\"\"Identifies indices where a space should be inserted before a capital letter.\"\"\"\n        positions = []\n        for i, char in enumerate(text):\n            if i > 0 and char.isupper():\n                positions.append(i)\n        return positions\n\n    def _insert_spaces(text: str, positions: list[int]) -> str:\n        \"\"\"Inserts spaces into the text at the specified sorted positions.\"\"\"\n        if not positions:\n            return text\n\n        result_chars = []\n        pos_idx = 0\n        for i, char in enumerate(text):\n            if pos_idx < len(positions) and i == positions[pos_idx]:\n                result_chars.append(' ')\n                pos_idx += 1\n            result_chars.append(char)\n        return \"\".join(result_chars)\n\n    if not input_string:\n        return \"\"\n\n    capital_positions = _find_capital_positions(input_string)\n    return _insert_spaces(input_string, capital_positions)"}
