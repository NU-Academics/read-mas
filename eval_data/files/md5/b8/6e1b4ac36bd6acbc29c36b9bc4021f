{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(strings: list[str]) -> int:\n    \"\"\"\n    Count pairs of reverse strings in the given string list.\n\n    Iterates through all unique pairs and checks if one is the reverse of the other.\n    \"\"\"\n    count = 0\n    n = len(strings)\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if strings[i] == strings[j][::-1]:\n                count += 1\n    return count"}
{"task_id": "Mbpp/759", "solution": "import re\n\ndef _validate_format(input_str: str) -> bool:\n    \"\"\"\n    Validates the basic format of a string as a decimal number,\n    requiring at least one digit before and after the decimal point.\n    \"\"\"\n    # Matches optional sign, followed by at least one digit, a literal dot,\n    # and then at least one digit.\n    return re.fullmatch(r\"^[+-]?\\d+\\.\\d+$\", input_str) is not None\n\ndef _check_precision(input_str: str) -> bool:\n    \"\"\"\n    Checks if the string has exactly 2 digits after the decimal point.\n    This function assumes input_str has already passed basic format validation.\n    \"\"\"\n    # Find the position of the decimal point.\n    decimal_point_index = input_str.find('.')\n    \n    # Extract the part after the decimal point.\n    # If _validate_format passed, decimal_point_index will not be -1\n    # and there will be digits after the dot.\n    fractional_part = input_str[decimal_point_index + 1:]\n    \n    # Verify that the length of the fractional part is exactly 2.\n    return len(fractional_part) == 2\n\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Checks whether a given string is a decimal number with a precision of 2.\n    \"\"\"\n    # First, ensure the string adheres to a basic decimal format (e.g., '123.45', not '123' or '.45').\n    if not _validate_format(input_string):\n        return False\n    \n    # If the format is correct, then verify that it has exactly two decimal places.\n    if not _check_precision(input_string):\n        return False\n        \n    return True"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(input_list):\n    \"\"\"\n    Counts occurrences of sublists within a list, converting each sublist to a tuple.\n    Returns a dictionary mapping tuples to their occurrence counts.\n    \"\"\"\n    counts = {}\n    for sublist in input_list:\n        sublist_tuple = tuple(sublist)\n        counts[sublist_tuple] = counts.get(sublist_tuple, 0) + 1\n    return counts"}
{"task_id": "Mbpp/759", "solution": "def is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Checks if a given string is a decimal number with a precision of 2.\n    The string must represent a positive number in 'XXX.XX' format.\n    \"\"\"\n\n    def _has_single_decimal_point(s: str) -> bool:\n        \"\"\"Checks if the string contains exactly one decimal point.\"\"\"\n        return s.count('.') == 1\n\n    def _validate_integer_part(integer_part: str) -> bool:\n        \"\"\"Validates if the integer part is not empty and contains only digits.\"\"\"\n        return bool(integer_part) and integer_part.isdigit()\n\n    def _validate_decimal_part(decimal_part: str) -> bool:\n        \"\"\"Validates if the decimal part has exactly 2 digits and contains only digits.\"\"\"\n        return len(decimal_part) == 2 and decimal_part.isdigit()\n\n    if not input_string:\n        return False\n\n    if not _has_single_decimal_point(input_string):\n        return False\n\n    parts = input_string.split('.')\n    integer_part = parts[0]\n    decimal_part = parts[1]\n\n    if not _validate_integer_part(integer_part):\n        return False\n\n    if not _validate_decimal_part(decimal_part):\n        return False\n\n    return True"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list: list) -> int:\n    \"\"\"Counts pairs of reverse strings in the given list.\n    Each string can only be part of one pair.\n    \"\"\"\n\n    def _reverse_string(s: str) -> str:\n        \"\"\"Reverses a given string.\"\"\"\n        return s[::-1]\n\n    def _are_reverse(s1: str, s2: str) -> bool:\n        \"\"\"Checks if s1 is the reverse of s2.\"\"\"\n        return s1 == _reverse_string(s2)\n\n    pairs_count = 0\n    # Stores indices of strings that have already formed a pair.\n    visited_indices = set()\n    n = len(string_list)\n\n    for i in range(n):\n        if i in visited_indices:\n            continue\n        \n        for j in range(i + 1, n):\n            if j in visited_indices:\n                continue\n\n            if _are_reverse(string_list[i], string_list[j]):\n                pairs_count += 1\n                visited_indices.add(i)\n                visited_indices.add(j)\n                # Once a string forms a pair, it's considered \"used\" and cannot form another.\n                break\n                \n    return pairs_count"}
{"task_id": "Mbpp/758", "solution": "from typing import List, Dict, Tuple\n\ndef unique_sublists(input_list: List[List]) -> Dict[Tuple, int]:\n    \"\"\"\n    Count occurrences of sublists by converting them to tuples.\n\n    Args:\n        input_list: List containing sublists to count\n\n    Returns:\n        Dictionary with tuples as keys and occurrence counts as values\n    \"\"\"\n    counts: Dict[Tuple, int] = {}\n    for sublist in input_list:\n        sublist_as_tuple = tuple(sublist)\n        counts[sublist_as_tuple] = counts.get(sublist_as_tuple, 0) + 1\n    return counts"}
