{"task_id": "Mbpp/793", "solution": "def last(array: list, target: any) -> int:\n    \"\"\"\n    Finds the last position of an element in a sorted array using binary search.\n    Returns the index of the last occurrence, or -1 if the element is not found.\n    \"\"\"\n    ans = -1\n    low = 0\n    high = len(array) - 1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            ans = mid\n            low = mid + 1  # Try to find a later occurrence in the right half\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n            \n    return ans"}
{"task_id": "Mbpp/793", "solution": "def last(array: list, element: any) -> int:\n    \"\"\"\n    Finds the last position of an element in a sorted array using binary search.\n    Returns the index of the last occurrence, or -1 if the element is not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == element:\n            result = mid  # Found a potential last occurrence\n            low = mid + 1 # Try to find a more right occurrence\n        elif array[mid] < element:\n            low = mid + 1\n        else: # array[mid] > element\n            high = mid - 1\n    return result"}
