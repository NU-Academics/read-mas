{"task_id": "Mbpp/453", "solution": "def _find_factors(number: int) -> list[int]:\n    \"\"\"Finds all factors of a given number.\"\"\"\n    factors = []\n    for i in range(1, number + 1):\n        if number % i == 0:\n            factors.append(i)\n    return factors\n\ndef _filter_even_factors(factors: list[int]) -> list[int]:\n    \"\"\"Filters a list of numbers to include only even numbers.\"\"\"\n    return [factor for factor in factors if factor % 2 == 0]\n\ndef _calculate_sum(factors: list[int]) -> int:\n    \"\"\"Calculates the sum of a list of numbers.\"\"\"\n    return sum(factors)\n\ndef sumofFactors(number: int) -> int:\n    \"\"\"\n    Calculates the sum of all even factors of a given number.\n    \"\"\"\n    all_factors = _find_factors(number)\n    even_factors = _filter_even_factors(all_factors)\n    total_sum = _calculate_sum(even_factors)\n    return total_sum"}
{"task_id": "Mbpp/453", "solution": "def sumofFactors(number: int) -> int:\n    \"\"\"\n    Calculates the sum of all even factors of a given number.\n    This function orchestrates factor calculation, filtering, and summation.\n    \"\"\"\n\n    def _calculate_factors(n: int) -> list[int]:\n        \"\"\"Calculates all factors of the input number.\"\"\"\n        factors = []\n        for i in range(1, n + 1):\n            if n % i == 0:\n                factors.append(i)\n        return factors\n\n    def _filter_even_factors(factors_list: list[int]) -> list[int]:\n        \"\"\"Filters a list of numbers to include only even numbers.\"\"\"\n        return [factor for factor in factors_list if factor % 2 == 0]\n\n    def _sum_factors(factors_list: list[int]) -> int:\n        \"\"\"Calculates the sum of numbers in a list.\"\"\"\n        return sum(factors_list)\n\n    all_factors = _calculate_factors(number)\n    even_factors = _filter_even_factors(all_factors)\n    return _sum_factors(even_factors)"}
