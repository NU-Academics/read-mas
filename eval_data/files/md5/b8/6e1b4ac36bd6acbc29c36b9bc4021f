{"task_id": "Mbpp/805", "solution": "from typing import List, Union\n\ndef max_sum_list(list_of_lists: List[List[Union[int, float]]]) -> List[Union[int, float]]:\n    \"\"\"\n    Returns the list in a list of lists whose sum of elements is the highest.\n    It returns the first such list encountered in case of a tie in sums.\n    \"\"\"\n    current_max_sum = float('-inf')\n    result_list = []\n\n    for sublist in list_of_lists:\n        sublist_sum = sum(sublist)\n        if sublist_sum > current_max_sum:\n            current_max_sum = sublist_sum\n            result_list = sublist\n            \n    return result_list"}
{"task_id": "Mbpp/804", "solution": "from typing import List, Union\n\nclass NumberList:\n    \"\"\"Manages and validates a list of numbers.\"\"\"\n    def __init__(self, numbers: List[Union[int, float]]) -> None:\n        self._numbers = numbers\n\n    def get_numbers(self) -> List[Union[int, float]]:\n        return self._numbers\n\n    def size(self) -> int:\n        return len(self._numbers)\n\n    def is_empty(self) -> bool:\n        return not self._numbers\n\nclass ProductCalculator:\n    \"\"\"Calculates product and determines evenness of a number.\"\"\"\n    def calculate_product(self, numbers: List[Union[int, float]]) -> Union[int, float]:\n        if not numbers:\n            return 1 # Multiplicative identity for an empty list's product\n        \n        product: Union[int, float] = 1\n        for num in numbers:\n            product *= num\n        return product\n\n    def is_even(self, number: Union[int, float]) -> bool:\n        # A number is even if its remainder when divided by 2 is 0.\n        # This applies to integers (0, 2, -4) and float-integers (0.0, 6.0).\n        return number % 2 == 0\n\nclass EvenChecker:\n    \"\"\"Orchestrates the evenness checking process.\"\"\"\n    def __init__(self) -> None:\n        self._calculator = ProductCalculator()\n\n    def check_product_evenness(self, number_list: NumberList) -> bool:\n        numbers = number_list.get_numbers()\n        product = self._calculator.calculate_product(numbers)\n        return self._calculator.is_even(product)\n    \n    def validate_input(self, number_list: NumberList) -> bool:\n        # As per constraints, this method performs minimal validation without exceptions or specific type checks.\n        return True\n\ndef is_product_even(numbers: List[Union[int, float]]) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    \"\"\"\n    number_list_obj = NumberList(numbers)\n    even_checker = EvenChecker()\n    return even_checker.check_product_evenness(number_list_obj)"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum run of consecutive uppercase characters in the given string.\n    Iterates through the string, tracking current and maximum runs of uppercase letters.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n        else:\n            max_run = max(max_run, current_run)\n            current_run = 0\n\n    # Final check in case the string ends with an uppercase run\n    max_run = max(max_run, current_run)\n\n    return max_run"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Find the maximum run of consecutive uppercase characters.\n    It iterates through the string once, tracking current and maximum runs.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n        else:\n            current_run = 0\n        max_run = max(max_run, current_run)\n\n    return max_run"}
{"task_id": "Mbpp/805", "solution": "from typing import List, Union\n\ndef max_sum_list(lists: List[List[Union[int, float]]]) -> List[Union[int, float]]:\n    \"\"\"\n    Finds the inner list with the highest sum of elements from a list of lists.\n    Returns the first such list if multiple lists have the same maximum sum.\n    \"\"\"\n    max_sum = float('-inf')\n    result_list = []\n\n    for current_list in lists:\n        current_sum = sum(current_list)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            result_list = current_list\n            \n    return result_list"}
