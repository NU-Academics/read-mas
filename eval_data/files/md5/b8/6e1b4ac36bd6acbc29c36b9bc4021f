{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix: list[list[float]]) -> float:\n    \"\"\"\n    Finds the path with the maximum average cost in a square matrix.\n    Paths start top-left, end bottom-right, moving only right or down.\n    \"\"\"\n    N = len(matrix)\n    \n    max_avg_path_value = -float('inf') # Initialize with negative infinity to find the true maximum average\n    \n    def dfs(row: int, col: int, current_sum: float, current_length: int):\n        nonlocal max_avg_path_value\n        \n        # Add the cost of the current cell to the path sum and increment length\n        current_sum += matrix[row][col]\n        current_length += 1\n        \n        # If the bottom-right cell is reached\n        if row == N - 1 and col == N - 1:\n            current_average = current_sum / current_length\n            if current_average > max_avg_path_value:\n                max_avg_path_value = current_average\n            return\n            \n        # Recursively explore moving down\n        if row + 1 < N:\n            dfs(row + 1, col, current_sum, current_length)\n            \n        # Recursively explore moving right\n        if col + 1 < N:\n            dfs(row, col + 1, current_sum, current_length)\n            \n    # Start the depth-first search from the top-left cell (0, 0)\n    # Initial sum and length are 0, as the first cell's values are processed within the DFS call.\n    dfs(0, 0, 0.0, 0)\n    \n    return max_avg_path_value"}
{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix):\n    \"\"\"\n    Finds a path with the maximum average cost from the top-left to the bottom-right\n    of a square matrix, moving only right or down.\n    \"\"\"\n    N = len(matrix)\n    \n    # This list will store tuples of (total_cost, number_of_cells) for each complete path found.\n    all_paths_data = []\n\n    def _generate_paths_recursive(r, c, current_sum, current_count):\n        # Add the cost of the current cell to the path's total sum and increment cell count.\n        current_sum += matrix[r][c]\n        current_count += 1\n\n        # Base case: If we have reached the bottom-right cell, the path is complete.\n        if r == N - 1 and c == N - 1:\n            all_paths_data.append((current_sum, current_count))\n            return\n\n        # Recursive step: Explore moving right.\n        if c + 1 < N:\n            _generate_paths_recursive(r, c + 1, current_sum, current_count)\n\n        # Recursive step: Explore moving down.\n        if r + 1 < N:\n            _generate_paths_recursive(r + 1, c, current_sum, current_count)\n\n    # Start the path generation from the top-left cell (0, 0) with initial sum and count of zero.\n    _generate_paths_recursive(0, 0, 0, 0)\n\n    max_avg = 0.0\n    # Iterate through all collected path data to find the maximum average.\n    for total_cost, cell_count in all_paths_data:\n        current_avg = float(total_cost) / cell_count\n        if current_avg > max_avg:\n            max_avg = current_avg\n            \n    return max_avg"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base, power):\n    \"\"\"\n    Calculates the sum of all digits of the base raised to the specified power.\n    Handles large numbers gracefully using Python's arbitrary-precision integers.\n    \"\"\"\n    # Calculate the exponential result (base^power)\n    result = base ** power\n\n    # Convert the result to a string to extract individual digits\n    result_str = str(result)\n\n    # Sum all extracted digits\n    digit_sum = 0\n    for digit_char in result_str:\n        digit_sum += int(digit_char)\n\n    return digit_sum"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"Calculates the sum of all digits of the base to the specified power.\"\"\"\n    calculated_power = base ** power\n    power_str = str(calculated_power)\n    digit_sum = sum(int(digit) for digit in power_str)\n    return digit_sum"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(numbers_tuple: tuple) -> tuple:\n    \"\"\"\n    Calculates the product of consecutive elements in a tuple of numbers.\n    The i-th output element is t_i * t_{i+1}.\n    \"\"\"\n    if not numbers_tuple:\n        return ()\n\n    # The length of the output tuple will be N where the input tuple has length N+1.\n    # We iterate from the first element up to the second-to-last element.\n    products = [\n        numbers_tuple[i] * numbers_tuple[i+1]\n        for i in range(len(numbers_tuple) - 1)\n    ]\n    return tuple(products)"}
{"task_id": "Mbpp/725", "solution": "def extract_quotation(input_string: str) -> list[str]:\n    \"\"\"\n    Extracts all text values enclosed within double quotation marks from the input string.\n    Processes the string linearly to find and extract quoted segments.\n    \"\"\"\n    extracted_values = []\n    in_quote = False\n    start_index = -1\n\n    for i, char in enumerate(input_string):\n        if char == '\"':\n            if not in_quote:\n                # Found an opening quote\n                in_quote = True\n                start_index = i + 1\n            else:\n                # Found a closing quote\n                in_quote = False\n                extracted_values.append(input_string[start_index:i])\n        # If not a quote character, and we are inside a quote, continue accumulating\n        # If not a quote character, and we are outside a quote, do nothing\n\n    return extracted_values"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Takes a tuple of numbers and returns a tuple where each element\n    is the product of two consecutive elements from the input tuple.\n    \"\"\"\n    products = []\n    for i in range(len(input_tuple) - 1):\n        products.append(input_tuple[i] * input_tuple[i+1])\n    return tuple(products)"}
{"task_id": "Mbpp/725", "solution": "def extract_quotation(input_string: str) -> list[str]:\n    \"\"\"\n    Extracts values enclosed within double quotation marks from the given string.\n    Processes the string character by character to identify and collect quoted segments.\n    \"\"\"\n    extracted_values = []\n    in_quote = False\n    current_quote_value = []\n\n    for char in input_string:\n        if char == '\"':\n            if in_quote:\n                # Closing quote found, append collected value and reset\n                extracted_values.append(\"\".join(current_quote_value))\n                current_quote_value = []\n                in_quote = False\n            else:\n                # Opening quote found\n                in_quote = True\n        elif in_quote:\n            # Inside quotes, collect characters\n            current_quote_value.append(char)\n\n    return extracted_values"}
