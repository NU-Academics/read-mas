{"task_id": "Mbpp/18", "solution": "def _build_filter_set(filter_string: str) -> set:\n    \"\"\"Build a set of characters to filter from the filter string.\"\"\"\n    return set(filter_string)\n\ndef _filter_characters(source_string: str, filter_set: set) -> str:\n    \"\"\"Filter characters from source string using the filter set.\"\"\"\n    result_chars = []\n    for char in source_string:\n        if char not in filter_set:\n            result_chars.append(char)\n    return \"\".join(result_chars)\n\ndef remove_dirty_chars(source_string: str, filter_string: str) -> str:\n    \"\"\"Remove characters from the first string which are present in the second string.\"\"\"\n    filter_set = _build_filter_set(filter_string)\n    return _filter_characters(source_string, filter_set)"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(source_string: str, filter_string: str) -> str:\n    \"\"\"\n    Removes characters from the source_string that are present in the filter_string, preserving order.\n    Uses helper functions for clarity and efficiency.\n    \"\"\"\n    def _build_char_set(s: str) -> set:\n        \"\"\"Creates a set of characters from a string for O(1) lookup.\"\"\"\n        return set(s)\n\n    def _filter_characters(source: str, char_set: set) -> str:\n        \"\"\"Filters characters from the source string using the provided character set.\"\"\"\n        result = []\n        for char in source:\n            if char not in char_set:\n                result.append(char)\n        return \"\".join(result)\n\n    if not filter_string:\n        return source_string\n    if not source_string:\n        return \"\"\n\n    chars_to_remove = _build_char_set(filter_string)\n    return _filter_characters(source_string, chars_to_remove)"}
{"task_id": "Mbpp/56", "solution": "def check(number: int) -> bool:\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    \"\"\"\n\n    def reverse_number(n: int) -> int:\n        \"\"\"Reverses the digits of an integer number.\"\"\"\n        return int(str(n)[::-1])\n\n    def validate_condition(original_num: int, reversed_num: int) -> bool:\n        \"\"\"Evaluates if the original number meets the condition.\"\"\"\n        return original_num == (2 * reversed_num) - 1\n\n    reversed_value = reverse_number(number)\n    return validate_condition(number, reversed_value)"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"Checks if the given number is a Woodall number.\n    A Woodall number is of the form n * 2^n - 1 for a positive integer n.\"\"\"\n    if number <= 0:\n        return False\n\n    n = 1\n    while True:\n        woodall_candidate = n * (2**n) - 1\n        if woodall_candidate == number:\n            return True\n        elif woodall_candidate > number:\n            return False\n        n += 1"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number.\n    A Woodall number is of the form n * 2^n - 1 for a positive integer n.\n    \"\"\"\n    n = 1\n    while True:\n        # Calculate the Woodall number for the current n\n        woodall_candidate = n * (2**n) - 1\n\n        # If the candidate matches the input number, it's a Woodall number\n        if woodall_candidate == number:\n            return True\n        # If the candidate exceeds the input number,\n        # further n values will only yield larger numbers, so it's not a Woodall number\n        if woodall_candidate > number:\n            return False\n        \n        n += 1"}
{"task_id": "Mbpp/56", "solution": "def check(number):\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    \"\"\"\n\n    def _reverse_number(n):\n        \"\"\"Reverses the digits of an integer, handling negative numbers.\"\"\"\n        if n < 0:\n            return -int(str(abs(n))[::-1])\n        return int(str(n)[::-1])\n\n    reversed_num = _reverse_number(number)\n    return number == (2 * reversed_num) - 1"}
