{"task_id": "Mbpp/301", "solution": "def dict_depth(dictionary: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary.\n    Depth starts from 1 for the root dictionary.\n    \"\"\"\n\n    def _is_dict_type(value) -> bool:\n        \"\"\"Checks if the given value is a dictionary.\"\"\"\n        return isinstance(value, dict)\n\n    def _traverse_nested(value, current_depth: int) -> int:\n        \"\"\"\n        Recursively traverses nested dictionary values to find the maximum depth.\n        It passes an incremented depth for actual dictionary nesting.\n        \"\"\"\n        if _is_dict_type(value):\n            # If the current value is a dictionary, increment depth for its contents.\n            next_depth = current_depth + 1\n            max_branch_depth = next_depth\n            for item in value.values():\n                max_branch_depth = max(max_branch_depth, _traverse_nested(item, next_depth))\n            return max_branch_depth\n        else:\n            # Non-dictionary values do not add further depth.\n            return current_depth\n\n    # An empty dictionary or a dictionary with only non-dict values has a depth of 1.\n    max_depth = 1\n\n    for value in dictionary.values():\n        # Start traversal for each top-level value from the current depth (1).\n        max_depth = max(max_depth, _traverse_nested(value, 1))\n    \n    return max_depth"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(dictionary: dict) -> int:\n    \"\"\"\n    Calculates the maximum depth of nested dictionaries.\n    Returns 1 for an empty dictionary or a flat dictionary.\n    \"\"\"\n    # Handle empty dictionary as having depth 1\n    if not dictionary:\n        return 1\n\n    # Define the recursive helper function inline.\n    # It tracks dictionary objects encountered in the current recursion path\n    # to detect and prevent infinite loops from circular references.\n    def _calculate_depth_recursive(current_dict: dict, visited_ids: set) -> int:\n        current_id = id(current_dict)\n\n        # If this dictionary's ID is already in the `visited_ids` set,\n        # it means we've encountered a circular reference in the current path.\n        # This branch contributes 0 to the depth to prevent infinite recursion.\n        if current_id in visited_ids:\n            return 0\n\n        # Create a new set for the next recursive calls by adding the current dictionary's ID.\n        # This ensures `visited_ids` tracks the path unique to each recursive branch.\n        next_visited_ids = visited_ids | {current_id}\n\n        max_sub_depth = 0\n        for value in current_dict.values():\n            if isinstance(value, dict):\n                # Recursively calculate depth for nested dictionaries\n                depth_of_sub_dict = _calculate_depth_recursive(value, next_visited_ids)\n                max_sub_depth = max(max_sub_depth, depth_of_sub_dict)\n        \n        # Add 1 for the current dictionary's level\n        return 1 + max_sub_depth\n\n    # Start the recursion with the initial dictionary and an empty set of visited IDs.\n    return _calculate_depth_recursive(dictionary, set())"}
{"task_id": "Mbpp/305", "solution": "def start_withp(input_list: list) -> tuple:\n    \"\"\"\n    Return exactly two words from a list of words starting with letter 'p'.\n    Searches through space-separated words within each string element.\n    \"\"\"\n    found_words = []\n    for s in input_list:\n        words = s.split()\n        for word in words:\n            if word.startswith('p'):\n                found_words.append(word)\n                if len(found_words) == 2:\n                    return (found_words[0], found_words[1])\n    # Based on the problem description and assert, it's assumed\n    # that exactly two words will always be found.\n    return (found_words[0], found_words[1])"}
