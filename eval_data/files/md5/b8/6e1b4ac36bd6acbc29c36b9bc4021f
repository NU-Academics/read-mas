{"task_id": "Mbpp/130", "solution": "from typing import List, Dict\n\ndef max_occurrences(input_list: List[int]) -> int:\n    \"\"\"\n    Find and return the item with maximum frequency in a given list.\n    Handles empty lists by returning 0, and provides deterministic behavior for frequency ties.\n    \"\"\"\n    if not input_list:\n        # Handles an empty list as an edge case by returning 0, without raising an exception.\n        return 0\n\n    # Count frequencies of each item in the list.\n    freq_map: Dict[int, int] = {}\n    for item in input_list:\n        freq_map[item] = freq_map.get(item, 0) + 1\n\n    # Initialize maximum frequency and the corresponding item using the first entry in the frequency map.\n    # Since input_list is not empty, freq_map will also not be empty.\n    first_item, first_count = next(iter(freq_map.items()))\n    max_freq = first_count\n    most_frequent_item = first_item\n\n    # Iterate through the frequency map to find the item with the highest count.\n    # In case of ties, the item encountered first in the dictionary's iteration order is chosen,\n    # ensuring deterministic behavior.\n    for item, count in freq_map.items():\n        if count > max_freq:\n            max_freq = count\n            most_frequent_item = item\n\n    return most_frequent_item"}
{"task_id": "Mbpp/131", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel (a, e, i, o, u, case-insensitive, 'y' is not a vowel).\"\"\"\n    return char.lower() in VOWELS\n\ndef _extract_vowels(text: str) -> list[str]:\n    \"\"\"Extracts all vowel characters from the input string in their original order.\"\"\"\n    return [char for char in text if _is_vowel(char)]\n\ndef reverse_vowels(input_string: str) -> str:\n    \"\"\"\n    Reverses only the vowels of a given string, keeping consonants in their original positions.\n    'y' is not considered a vowel.\n    \"\"\"\n    if not input_string:\n        return input_string\n\n    string_list = list(input_string)\n    extracted_vowels = _extract_vowels(input_string)\n    extracted_vowels.reverse() # Reverse the list of vowels for placement\n\n    vowel_index = 0\n    for i in range(len(string_list)):\n        if _is_vowel(string_list[i]):\n            string_list[i] = extracted_vowels[vowel_index]\n            vowel_index += 1\n\n    return \"\".join(string_list)"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(input_string: str) -> str:\n    \"\"\"\n    Reverses only the vowels in a given string, where 'y' is not considered a vowel.\n    Consonants remain in their original positions.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Determines if a character is a vowel (case-insensitive, 'y' excluded).\"\"\"\n        return char.lower() in VOWELS\n\n    def _extract_vowels(text: str) -> list:\n        \"\"\"Extracts all vowels from the input string in order.\"\"\"\n        return [char for char in text if _is_vowel(char)]\n\n    def _get_vowel_positions(text: str) -> list:\n        \"\"\"Gets the positions (indices) of all vowels in the input string.\"\"\"\n        return [i for i, char in enumerate(text) if _is_vowel(char)]\n\n    def _reconstruct_string(original: str, vowels: list, positions: list) -> str:\n        \"\"\"Rebuilds the string with new vowels at specified positions.\"\"\"\n        result_chars = list(original)\n        for i, pos in enumerate(positions):\n            result_chars[pos] = vowels[i]\n        return \"\".join(result_chars)\n\n    extracted_vowels = _extract_vowels(input_string)\n    vowel_positions = _get_vowel_positions(input_string)\n\n    if not extracted_vowels:\n        return input_string # No vowels to reverse\n\n    reversed_vowels = extracted_vowels[::-1]\n\n    return _reconstruct_string(input_string, reversed_vowels, vowel_positions)"}
