{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(list1, list2, list3):\n    \"\"\"\n    Converts three parallel lists into a list of nested dictionaries.\n    Each element's corresponding index creates an outer key, an inner key, and an inner value.\n    \"\"\"\n    # Validate that all input lists have equal length, raising an error if not.\n    if not (len(list1) == len(list2) == len(list3)):\n        raise ValueError(\"Input lists must have equal length.\")\n\n    result_list = []\n    # Iterate through the lists, using the index to map corresponding elements.\n    for i in range(len(list1)):\n        outer_key = list1[i]\n        inner_key = list2[i]\n        inner_value = list3[i]\n\n        # Construct a single nested dictionary for the current index.\n        nested_dict = {outer_key: {inner_key: inner_value}}\n        result_list.append(nested_dict)\n\n    return result_list"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(list1, list2, list3):\n    \"\"\"\n    Converts three lists into a list of nested dictionaries, mapping elements by index.\n    The first list provides outer keys, the second list provides inner keys, and the third provides inner values.\n    \"\"\"\n    result = []\n    for outer_key, inner_key, inner_value in zip(list1, list2, list3):\n        inner_dict = {inner_key: inner_value}\n        outer_dict = {outer_key: inner_dict}\n        result.append(outer_dict)\n    return result"}
{"task_id": "Mbpp/392", "solution": "memo = {}\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Calculate maximum sum using equation f(n) = max((f(n/2) + f(n/3) + f(n/4) + f(n/5)), n)\n    with memoization for efficient computation.\n    \"\"\"\n    if n in memo:\n        return memo[n]\n\n    # Base case: for n less than its sum of parts, n itself is the max.\n    # The equation implicitly handles this, as recursive calls for small n will eventually sum to 0\n    # or a value less than n, making n the maximum.\n    \n    sum_of_parts = (\n        get_max_sum(n // 2) +\n        get_max_sum(n // 3) +\n        get_max_sum(n // 4) +\n        get_max_sum(n // 5)\n    )\n    \n    result = max(sum_of_parts, n)\n    memo[n] = result\n    \n    return result"}
{"task_id": "Mbpp/392", "solution": "def get_max_sum(n: int) -> int:\n    \"\"\"\n    Calculates the maximum sum possible by applying the equation \n    f(n) = max((f(n/2) + f(n/3) + f(n/4) + f(n/5)), n), using memoization.\n    \"\"\"\n    memo = {}\n\n    def _calculate_f(k: int) -> int:\n        if k in memo:\n            return memo[k]\n\n        # Base case for recursion: f(0) is 0.\n        # For small k, the sum of parts will be 0, making max(0, k) = k.\n        if k == 0:\n            memo[0] = 0\n            return 0\n\n        # Recursively calculate the sum of f(k/x) using integer division\n        sum_of_parts = _calculate_f(k // 2) + \\\n                       _calculate_f(k // 3) + \\\n                       _calculate_f(k // 4) + \\\n                       _calculate_f(k // 5)\n\n        # Apply the main equation: take the maximum of the sum of parts and k itself\n        result = max(sum_of_parts, k)\n\n        # Store the computed result in the memoization cache before returning\n        memo[k] = result\n        return result\n\n    return _calculate_f(n)"}
{"task_id": "Mbpp/395", "solution": "def first_non_repeating_character(input_string: str) -> str | None:\n    \"\"\"\n    Finds the first non-repeated character in a given string.\n    Returns None if no such character exists or the string is empty.\n    \"\"\"\n    if not input_string:\n        return None\n\n    def _count_characters(s: str) -> dict[str, int]:\n        \"\"\"Counts the occurrences of each character in the string.\"\"\"\n        counts = {}\n        for char in s:\n            counts[char] = counts.get(char, 0) + 1\n        return counts\n\n    def _find_first_unique(s: str, char_counts: dict[str, int]) -> str | None:\n        \"\"\"Finds the first character with a count of 1 based on string order.\"\"\"\n        for char in s:\n            if char_counts[char] == 1:\n                return char\n        return None\n\n    char_counts = _count_characters(input_string)\n    return _find_first_unique(input_string, char_counts)"}
