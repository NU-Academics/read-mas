{"task_id": "Mbpp/462", "solution": "def combinations_list(input_list: list) -> list:\n    \"\"\"\n    Generate all possible combinations of elements from input list using bit manipulation.\n    The order of combinations and elements within them matches the provided example.\n    \"\"\"\n    n = len(input_list)\n    all_combinations = []\n\n    # Iterate from 0 to 2^n - 1, where each integer represents a unique combination through its binary bits.\n    for i in range(1 << n):\n        current_combination = []\n        # Iterate through the input list elements in reverse order of their index.\n        # This ensures the elements within each combination are ordered from highest original index to lowest.\n        for j in range(n - 1, -1, -1):\n            # If the j-th bit of 'i' is set, include the j-th element from the input list.\n            if (i >> j) & 1:\n                current_combination.append(input_list[j])\n        all_combinations.append(current_combination)\n\n    return all_combinations"}
{"task_id": "Mbpp/459", "solution": "def _identify_uppercase_substrings(input_string: str) -> list[tuple[int, int]]:\n    \"\"\"\n    Identifies positions of contiguous uppercase letter sequences.\n    A range (start, end) means input_string[start:end] is an uppercase substring.\n    \"\"\"\n    ranges = []\n    start_index = -1\n    for i, char in enumerate(input_string):\n        if char.isupper():\n            if start_index == -1:\n                start_index = i\n        else:  # Character is not uppercase\n            if start_index != -1:\n                ranges.append((start_index, i)) # End index is exclusive\n                start_index = -1\n    # If the string ends with an uppercase substring\n    if start_index != -1:\n        ranges.append((start_index, len(input_string)))\n    return ranges\n\ndef _build_result_string(input_string: str, uppercase_ranges: list[tuple[int, int]]) -> str:\n    \"\"\"\n    Constructs the output string by excluding characters within the specified uppercase ranges.\n    \"\"\"\n    result_chars = []\n    current_pos = 0\n    \n    for start, end in uppercase_ranges:\n        # Append the segment of the string before the current uppercase range\n        if start > current_pos:\n            result_chars.append(input_string[current_pos:start])\n        # Advance current_pos past the removed uppercase range\n        current_pos = end\n    \n    # Append any remaining segment of the string after the last uppercase range\n    if current_pos < len(input_string):\n        result_chars.append(input_string[current_pos:])\n        \n    return \"\".join(result_chars)\n\ndef remove_uppercase(input_string: str) -> str:\n    \"\"\"\n    Removes uppercase substrings from a given string, preserving lowercase and non-alphabetic characters.\n    \"\"\"\n    if not input_string:\n        return \"\"\n    \n    uppercase_ranges = _identify_uppercase_substrings(input_string)\n    result = _build_result_string(input_string, uppercase_ranges)\n    \n    return result"}
