{"task_id": "Mbpp/773", "solution": "def occurance_substring(source_string: str, search_substring: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Find the occurrence and position of substring within a string.\n\n    Returns a tuple (substring, start_position, end_position) if found, None otherwise.\n    \"\"\"\n    start_pos = source_string.find(search_substring)\n    if start_pos == -1:\n        return None\n    \n    end_pos = start_pos + len(search_substring)\n    return (search_substring, start_pos, end_pos)"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets using a stack-based approach.\n    Supports parentheses, square brackets, and curly braces.\n    \"\"\"\n    stack = []\n    opening_brackets = {'(', '[', '{'}\n    matching_brackets = {')': '(', ']': '[', '}': '{'}\n\n    for char in expression:\n        if char in opening_brackets:\n            stack.append(char)\n        elif char in matching_brackets:\n            if not stack:\n                return False\n            last_open = stack.pop()\n            if matching_brackets[char] != last_open:\n                return False\n    \n    return not stack"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(main_string: str, substring: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence of a substring within a string.\n    Returns a tuple with the substring and its start and end positions, or None if no match is found.\n    \"\"\"\n    start_pos = main_string.find(substring)\n\n    if start_pos != -1:\n        end_pos = start_pos + len(substring)\n        return (substring, start_pos, end_pos)\n    else:\n        return None"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text: str, k: int) -> str:\n    \"\"\"Removes all words of a specific length k from the given string.\"\"\"\n\n    def split_words(s: str) -> list:\n        \"\"\"Splits a string into a list of words using whitespace as a delimiter.\"\"\"\n        return s.split()\n\n    def filter_by_length(words: list, length_to_remove: int) -> list:\n        \"\"\"Filters a list of words, keeping only those not matching the specified length.\"\"\"\n        return [word for word in words if len(word) != length_to_remove]\n\n    def join_words(words: list) -> str:\n        \"\"\"Joins a list of words into a single string with spaces.\"\"\"\n        return ' '.join(words)\n\n    # Split the input string into words\n    words = split_words(text)\n\n    # Filter out words with length k\n    filtered_words = filter_by_length(words, k)\n\n    # Join the remaining words back into a string\n    result_string = join_words(filtered_words)\n    \n    # Normalizing whitespace is implicitly handled by split() and join(' ') for single space separation\n    # No explicit strip() is needed for the prompt's example, as split().join() already cleans up\n    # internal and external whitespace to a single space format.\n\n    return result_string"}
{"task_id": "Mbpp/775", "solution": "def odd_position(input_list: list) -> bool:\n    \"\"\"\n    Check if every odd index contains odd numbers.\n\n    Iterates through the list, verifying that elements at odd indices are themselves odd.\n    \"\"\"\n    for i in range(len(input_list)):\n        # Check if the current index 'i' is an odd index\n        if i % 2 != 0:\n            # If it's an odd index, check if the element at this index is an odd number\n            if input_list[i] % 2 == 0:\n                # If an odd index contains an even number, the condition is not met\n                return False\n    # If the loop completes, all odd indices (if any) contained odd numbers\n    return True"}
{"task_id": "Mbpp/775", "solution": "def odd_position(lst: list) -> bool:\n    \"\"\"\n    Checks if every element at an odd index in the list is an odd number.\n    Returns True if all such elements are odd, False otherwise.\n    \"\"\"\n    for i in range(len(lst)):\n        # Check if the current index is odd\n        if i % 2 != 0:\n            # If the index is odd, check if the number at that index is even\n            if lst[i] % 2 == 0:\n                return False\n    return True"}
{"task_id": "Mbpp/777", "solution": "def _count_elements(input_list: list) -> dict:\n    \"\"\"Count occurrences of each element.\"\"\"\n    counts = {}\n    for element in input_list:\n        counts[element] = counts.get(element, 0) + 1\n    return counts\n\ndef _calculate_sum(element_counts: dict) -> int:\n    \"\"\"Calculate sum of distinct elements from the counts.\"\"\"\n    total_sum = 0\n    for element_value in element_counts.keys():\n        total_sum += element_value\n    return total_sum\n\ndef find_sum(input_list: list) -> int:\n    \"\"\"Calculate sum of non-repeated elements in the list.\"\"\"\n    counts = _count_elements(input_list)\n    result_sum = _calculate_sum(counts)\n    return result_sum"}
{"task_id": "Mbpp/777", "solution": "def find_sum(input_list: list) -> int:\n    \"\"\"\n    Calculates the sum of non-repeated elements in a list.\n    Elements appearing exactly once are considered non-repeated.\n    \"\"\"\n    if not input_list:\n        return 0\n\n    # Element frequency counting\n    frequencies = {}\n    for item in input_list:\n        frequencies[item] = frequencies.get(item, 0) + 1\n\n    # Filtering non-repeated elements and summing them\n    total_sum = 0\n    for item, count in frequencies.items():\n        if count == 1:\n            total_sum += item\n\n    return total_sum"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list):\n    \"\"\"\n    Packs consecutive duplicates of list elements into sublists.\n    Each sublist contains consecutive identical elements, preserving order.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_sublist = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_sublist[-1]:\n            current_sublist.append(input_list[i])\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [input_list[i]]\n    \n    packed_list.append(current_sublist)\n    return packed_list"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list[list]:\n    \"\"\"Packs consecutive duplicates of list elements into sublists.\"\"\"\n    if not input_list:\n        return []\n\n    result = []\n    current_group = []\n\n    for item in input_list:\n        if not current_group or item == current_group[-1]:\n            current_group.append(item)\n        else:\n            result.append(current_group)\n            current_group = [item]\n    \n    if current_group: # Append the last group\n        result.append(current_group)\n        \n    return result"}
{"task_id": "Mbpp/780", "solution": "import itertools\n\ndef _generate_pairwise_combinations(data_list):\n    \"\"\"Generates all unique pairwise combinations from the input list.\"\"\"\n    return list(itertools.combinations(data_list, 2))\n\ndef _calculate_element_sums(pairs):\n    \"\"\"Calculates element-wise sums for a list of tuple pairs.\"\"\"\n    result_sums = []\n    for (t1_x, t1_y), (t2_x, t2_y) in pairs:\n        result_sums.append((t1_x + t2_x, t1_y + t2_y))\n    return result_sums\n\ndef find_combinations(tuple_list):\n    \"\"\"\n    Finds combinations of sums with tuples in the given tuple list.\n    Calculates element-wise sums of all unique pairwise combinations.\n    \"\"\"\n    # Input validation is omitted based on the constraint \"Do NOT add isinstance() checks or raise exceptions for edge cases\".\n\n    pairwise_combinations = _generate_pairwise_combinations(tuple_list)\n    final_sums = _calculate_element_sums(pairwise_combinations)\n\n    return final_sums"}
{"task_id": "Mbpp/780", "solution": "from typing import List, Tuple, Iterator\nimport itertools\n\ndef find_combinations(tuple_list: List[Tuple]) -> List[Tuple]:\n    \"\"\"\n    Finds combinations of sums with tuples in the given tuple list.\n    Calculates pairwise element-wise sums of tuples.\n    \"\"\"\n\n    # Helper function: Validates input tuple list structure.\n    # Per constraints, actual validation logic for types/structure is omitted.\n    def validate_input_tuples(input_list: List[Tuple]) -> bool:\n        return True\n\n    # Helper function: Generates all unique pairwise combinations of input tuples.\n    def generate_tuple_pairs(input_list: List[Tuple]) -> Iterator[Tuple[Tuple, Tuple]]:\n        return itertools.combinations(input_list, 2)\n\n    # Helper function: Calculates element-wise sum of two tuples.\n    def calculate_element_sums(t1: Tuple, t2: Tuple) -> Tuple:\n        return (t1[0] + t2[0], t1[1] + t2[1])\n\n    # Helper function: Formats calculation results into final output list.\n    def create_result_tuples(sum_results: List[Tuple]) -> List[Tuple]:\n        return sum_results\n\n    # Main logic\n    # The validation call is included as per design, but it always returns True due to constraints.\n    if not validate_input_tuples(tuple_list):\n        # In a real scenario, this would handle invalid input, e.g., by raising an error.\n        pass\n\n    summed_pairs = []\n    pairs_iterator = generate_tuple_pairs(tuple_list)\n\n    for tuple1, tuple2 in pairs_iterator:\n        summed_pair = calculate_element_sums(tuple1, tuple2)\n        summed_pairs.append(summed_pair)\n\n    return create_result_tuples(summed_pairs)"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if the total count of divisors for a positive integer `n` is even.\n    Returns True if the count is even, False otherwise.\n    \"\"\"\n    \n    def _calculate_divisor_count(num: int) -> int:\n        \"\"\"\n        Calculates the total number of divisors for a given positive integer.\n        Uses an optimized approach by checking divisors up to the square root of num.\n        \"\"\"\n        count = 0\n        i = 1\n        while i * i <= num:\n            if num % i == 0:\n                if i * i == num:\n                    count += 1\n                else:\n                    count += 2\n            i += 1\n        return count\n\n    total_divisors = _calculate_divisor_count(n)\n    return total_divisors % 2 == 0"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks whether the count of divisors for a given positive integer is even.\n    \"\"\"\n\n    def _validate_input(num: int) -> bool:\n        \"\"\"Validates that input is a positive integer. Returns True as constraints prevent explicit validation.\"\"\"\n        # Due to constraints (no isinstance() checks or raise exceptions for edge cases),\n        # this function assumes 'num' is a positive integer as per the problem context.\n        return True\n\n    def _calculate_divisor_count(num: int) -> int:\n        \"\"\"Calculates the total number of divisors for a given integer.\"\"\"\n        count = 0\n        i = 1\n        while i * i <= num:\n            if num % i == 0:\n                count += 1\n                if i * i != num:\n                    count += 1\n            i += 1\n        return count\n\n    def _is_even(num_count: int) -> bool:\n        \"\"\"Determines if a count is even.\"\"\"\n        return num_count % 2 == 0\n\n    _validate_input(n)\n    total_divisors = _calculate_divisor_count(n)\n    return _is_even(total_divisors)"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list) -> int:\n    \"\"\"\n    Calculate the sum of all odd-length subarrays from the input array.\n    This involves generating all subarrays, filtering by odd length, and summing their elements.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        for j in range(i, n):\n            # Calculate the length of the current subarray arr[i:j+1]\n            current_length = j - i + 1\n            \n            # Check if the length is odd\n            if current_length % 2 == 1:\n                # Sum the elements of the current odd-length subarray\n                for k in range(i, j + 1):\n                    total_sum += arr[k]\n    return total_sum"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr):\n    \"\"\"\n    Calculate the sum of all odd-length subarrays.\n\n    Args:\n        arr (list): List of integers\n\n    Returns:\n        int: Sum of all odd-length subarrays\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    # Iterate through all possible starting indices\n    for i in range(n):\n        # Iterate through all possible ending indices\n        for j in range(i, n):\n            # Extract the current subarray\n            subarray = arr[i : j + 1]\n            # Check if the subarray has an odd length\n            if len(subarray) % 2 != 0:\n                # Add the sum of elements in this odd-length subarray to the total\n                total_sum += sum(subarray)\n\n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "from typing import List, Optional\n\ndef find_first_even(numbers: List[int]) -> Optional[int]:\n    \"\"\"Find first even number in list.\"\"\"\n    for num in numbers:\n        if num % 2 == 0:\n            return num\n    return None\n\ndef find_first_odd(numbers: List[int]) -> Optional[int]:\n    \"\"\"Find first odd number in list.\"\"\"\n    for num in numbers:\n        if num % 2 != 0:\n            return num\n    return None\n\ndef mul_even_odd(numbers: List[int]) -> int:\n    \"\"\"Calculate product of first even and odd numbers in list.\"\"\"\n    first_even = find_first_even(numbers)\n    first_odd = find_first_odd(numbers)\n\n    if first_even is not None and first_odd is not None:\n        return first_even * first_odd\n    else:\n        return 0"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd number in a list.\n    Returns 0 if either the first even or first odd number is not found.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        \n        if first_even is not None and first_odd is not None:\n            break\n            \n    if first_even is None or first_odd is None:\n        return 0\n    \n    return first_even * first_odd"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(input_string: str) -> tuple:\n    \"\"\"\n    Converts a string representation of a tuple of integers to an actual integer tuple.\n    \"\"\"\n\n    def _validate_format(s: str) -> bool:\n        \"\"\"\n        Validates the basic format of the input string (starts with '(' and ends with ')').\n        \"\"\"\n        return len(s) >= 2 and s[0] == '(' and s[-1] == ')'\n\n    def _parse_elements(s: str) -> list[str]:\n        \"\"\"\n        Extracts string elements from the tuple string, removing parentheses and splitting by comma.\n        \"\"\"\n        # Remove outer parentheses\n        inner_string = s[1:-1].strip()\n        if not inner_string:\n            return []\n        # Split by comma and strip whitespace from each element\n        return [element.strip() for element in inner_string.split(',')]\n\n    def _convert_to_integers(elements: list[str]) -> list[int]:\n        \"\"\"\n        Converts a list of string elements to a list of integers.\n        \"\"\"\n        return [int(element) for element in elements]\n\n    # Main logic of tuple_str_int\n    if not _validate_format(input_string):\n        # As per constraints, do not raise exceptions for edge cases.\n        # For simplicity and adherence to provided test case, we proceed assuming a valid format\n        # or return an empty tuple for obviously malformed inputs that might fail later.\n        # Given \"(7, 8, 9)\" is the target, we'll let subsequent steps handle \"malformed\" elements.\n        pass\n\n    string_elements = _parse_elements(input_string)\n    integer_list = _convert_to_integers(string_elements)\n\n    return tuple(integer_list)"}
