{"task_id": "HumanEval/32", "solution": "class Polynomial:\n    \"\"\"Encapsulates polynomial data and provides operations for evaluation and zero-finding.\"\"\"\n    def __init__(self, xs: list[float]):\n        self._coefficients = xs\n\n    def evaluate(self, x: float) -> float:\n        \"\"\"Evaluates the polynomial at point x.\"\"\"\n        return sum([coeff * math.pow(x, i) for i, coeff in enumerate(self._coefficients)])\n\n    def findZero(self) -> float:\n        \"\"\"\n        Finds a single zero point for the polynomial using the bisection method.\n        Assumes an odd-degree polynomial and guarantees a solution exists.\n        \"\"\"\n        coeffs = self._coefficients\n        \n        # Handle linear polynomial as a special, direct case\n        if len(coeffs) == 2:\n            # The problem statement's guarantee of a non-zero leading coefficient ensures coeffs[1] is not zero.\n            return -coeffs[0] / coeffs[1]\n\n        # For higher degree odd polynomials, use bisection method.\n        # An odd-degree polynomial (len(coeffs) is even, so degree is odd)\n        # always has at least one real root.\n        \n        # Define a sufficiently large initial search interval.\n        # For odd-degree polynomials, f(-large) and f(large) will typically have opposite signs.\n        low = -100_000.0\n        high = 100_000.0\n\n        p_low = self.evaluate(low)\n        p_high = self.evaluate(high)\n\n        # Check if a root is found exactly or very close to the boundaries.\n        tolerance_zero_check = 1e-9 \n        if abs(p_low) < tolerance_zero_check:\n            return low\n        if abs(p_high) < tolerance_zero_check:\n            return high\n\n        # Tolerance for convergence of the bisection interval\n        tolerance_interval = 1e-8 \n\n        # Bisection loop, 200 iterations are typically sufficient for high precision over a large interval.\n        for _ in range(200): \n            mid = (low + high) / 2.0\n            p_mid = self.evaluate(mid)\n\n            if abs(p_mid) < tolerance_zero_check: # Check if mid is a root\n                return mid\n\n            if p_low * p_mid < 0: # Root is in the left half [low, mid]\n                high = mid\n                p_high = p_mid\n            else: # Root is in the right half [mid, high]\n                low = mid\n                p_low = p_mid\n            \n            # Check for convergence based on interval size\n            if (high - low) < tolerance_interval:\n                return (low + high) / 2.0\n        \n        # Fallback return if max iterations reached without sufficient convergence.\n        return (low + high) / 2.0\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    polynomial_obj = Polynomial(xs)\n    return polynomial_obj.findZero()"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    n = len(l)\n    # Initialize the result list with placeholders.\n    result_list = [None] * n\n\n    # Collect values from even indices and directly copy odd-indexed values.\n    even_indexed_values = []\n    for i in range(n):\n        if i % 2 == 0:\n            even_indexed_values.append(l[i])\n        else:\n            result_list[i] = l[i]\n            \n    # Sort the collected even-indexed values.\n    even_indexed_values.sort()\n    \n    # Place the sorted values back into the even indices of the result list.\n    sorted_even_elements_ptr = 0\n    for i in range(n):\n        if i % 2 == 0:\n            result_list[i] = even_indexed_values[sorted_even_elements_ptr]\n            sorted_even_elements_ptr += 1\n            \n    return result_list"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # uncycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "import math\n\ndef _is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime.\"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    i = 3\n    while i * i <= num:\n        if num % i == 0:\n            return False\n        i += 2\n    return True\n\ndef _is_fibonacci(num: int) -> bool:\n    \"\"\"Checks if a number is a Fibonacci number using iterative generation.\"\"\"\n    if num < 0:\n        return False\n    if num == 0 or num == 1:\n        return True\n\n    a, b = 0, 1\n    while b < num:\n        a, b = b, a + b\n    return b == num\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    count = 0\n    # Initialize Fibonacci sequence from F_2=1 and F_3=2 to start checking from 2.\n    # The first number generated for current_fib will be 2.\n    a, b = 1, 1 \n    \n    while True:\n        # Generate the next Fibonacci number in the sequence.\n        # Starting with a=1, b=1, the first current_fib will be 2.\n        a, b = b, a + b \n        current_fib = b\n\n        if _is_prime(current_fib):\n            count += 1\n            if count == n:\n                return current_fib"}
