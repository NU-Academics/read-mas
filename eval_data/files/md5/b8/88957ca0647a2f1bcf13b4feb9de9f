{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    integer_part = int(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n\n    return result"}
{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Parses a string of space-separated parentheses groups, calculating the deepest nesting level for each.\n    Returns a list of integers, each representing the maximum nesting depth for a group.\n    \"\"\"\n    results = []\n    groups = paren_string.split(' ')\n\n    for group_str in groups:\n        current_nesting = 0\n        max_nesting = 0\n        for char in group_str:\n            if char == '(':\n                current_nesting += 1\n                if current_nesting > max_nesting:\n                    max_nesting = current_nesting\n            elif char == ')':\n                current_nesting -= 1\n        results.append(max_nesting)\n\n    return results"}
{"task_id": "HumanEval/3", "solution": "def below_zero(operations: List[int]) -> bool:\n    \"\"\"\n    Detects if a bank account balance falls below zero at any point given a list of operations.\n    Starts with a zero balance.\n    \"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Separates groups of nested parentheses into individual strings.\n    Each group is balanced and not nested within others.\n    \"\"\"\n    cleaned_input = paren_string.replace(\" \", \"\")\n    \n    result_list = []\n    balance_counter = 0\n    start_index = 0\n    \n    for i, char in enumerate(cleaned_input):\n        if char == '(':\n            balance_counter += 1\n        elif char == ')':\n            balance_counter -= 1\n        \n        # If balance_counter is 0, we've found a complete top-level group.\n        # The char must be ')' to close a group, but the logic handles cases where it's 0 after a ')'\n        # so explicit char check might be redundant if balance is tracked correctly.\n        # However, checking 'char == ')' ensures we only close groups on a closing brace.\n        if balance_counter == 0 and char == ')':\n            group = cleaned_input[start_index : i + 1]\n            result_list.append(group)\n            start_index = i + 1\n            \n    return result_list"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n\n    def _calculate_mean(nums: List[float]) -> float:\n        \"\"\"Calculates the arithmetic mean of a list of numbers.\"\"\"\n        return sum(nums) / len(nums)\n\n    def _calculate_absolute_differences(nums: List[float], mean_val: float) -> List[float]:\n        \"\"\"Calculates the absolute difference of each number from the given mean.\"\"\"\n        return [abs(num - mean_val) for num in nums]\n\n    def _calculate_average_absolute_differences(abs_diffs: List[float]) -> float:\n        \"\"\"Calculates the average of a list of absolute differences.\"\"\"\n        return sum(abs_diffs) / len(abs_diffs)\n\n    if not numbers:\n        # As per instructions, do not raise exceptions for edge cases,\n        # but a MAD cannot be calculated for an empty list.\n        # Returning 0.0 or NaN would be options, but 0.0 is simpler.\n        return 0.0 \n\n    mean_of_numbers = _calculate_mean(numbers)\n    absolute_differences = _calculate_absolute_differences(numbers, mean_of_numbers)\n    mad = _calculate_average_absolute_differences(absolute_differences)\n\n    return mad"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n\n    if not numbers:\n        return (total_sum, total_product)\n\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    current_max = float('-inf')\n    result = []\n    for num in numbers:\n        if num > current_max:\n            current_max = num\n        result.append(current_max)\n    return result"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Out of list of strings, return the longest one.\n    Return the first one in case of multiple strings of the same length.\n    Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_found = strings[0]\n    max_len = len(strings[0])\n\n    for i in range(1, len(strings)):\n        current_string = strings[i]\n        current_len = len(current_string)\n        if current_len > max_len:\n            longest_found = current_string\n            max_len = current_len\n            \n    return longest_found"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    # Iterate through all possible starting points for a suffix.\n    # The first suffix found to be a palindrome (starting from string[0:]) will be the longest palindromic suffix.\n    for i in range(len(string) + 1):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            # The prefix to reverse is the part of the string before the palindromic suffix.\n            prefix_to_reverse = string[:i]\n            # Append the reversed prefix to the original string to form the shortest palindrome.\n            return string + prefix_to_reverse[::-1]\n\n    return \"\" # This line should not be reached for non-empty strings."}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/11", "solution": "from typing import List\n\n\nclass InvalidBinaryStringError(ValueError):\n    \"\"\"Custom exception for invalid binary string content.\"\"\"\n    pass\n\nclass InputLengthMismatchError(ValueError):\n    \"\"\"Custom exception for unequal input string lengths.\"\"\"\n    pass\n\ndef _validate_binary_string(s: str) -> None:\n    \"\"\"Checks if a string consists only of '0' and '1' characters.\"\"\"\n    for char in s:\n        if char not in ('0', '1'):\n            raise InvalidBinaryStringError(\"Input string must contain only '0's and '1's.\")\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    _validate_binary_string(a)\n    _validate_binary_string(b)\n\n    if len(a) != len(b):\n        raise InputLengthMismatchError(\"Input strings must be of equal length.\")\n\n    result_chars = []\n    for i in range(len(a)):\n        xor_result = str(int(a[i]) ^ int(b[i]))\n        result_chars.append(xor_result)\n        \n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    numbers = [str(i) for i in range(n + 1)]\n    return ' '.join(numbers)"}
{"task_id": "HumanEval/14", "solution": "from typing import List\n\n\nclass InputString:\n    \"\"\"Represents the input string provided to the system.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass Prefix:\n    \"\"\"Represents a single prefix of a string, including its value and length.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\n\n    def __eq__(self, other):\n        if not isinstance(other, Prefix):\n            return NotImplemented\n        return self.value == other.value and self.length == other.length\n\n    def __repr__(self):\n        return f\"Prefix(value='{self.value}', length={self.length})\"\n\nclass PrefixList:\n    \"\"\"Manages a collection of Prefix objects, providing methods for adding and sorting.\"\"\"\n    def __init__(self):\n        self.prefixes: List[Prefix] = []\n\n    def add_prefix(self, prefix: Prefix):\n        \"\"\"Adds a Prefix object to the internal list.\"\"\"\n        self.prefixes.append(prefix)\n\n    def sort_shortest_to_longest(self):\n        \"\"\"Sorts the internal list of prefixes from shortest to longest based on length.\"\"\"\n        self.prefixes.sort(key=lambda p: p.length)\n\n    def to_list_of_strings(self) -> List[str]:\n        \"\"\"Converts the internal list of Prefix objects to a list of their string values.\"\"\"\n        return [p.value for p in self.prefixes]\n\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    _ = InputString(string)\n\n    prefix_list = PrefixList()\n\n    for i in range(1, len(string) + 1):\n        prefix_value = string[:i]\n        prefix = Prefix(prefix_value)\n        prefix_list.add_prefix(prefix)\n\n    prefix_list.sort_shortest_to_longest()\n\n    return prefix_list.to_list_of_strings()"}
{"task_id": "HumanEval/17", "solution": "def parse_music(music_string: str) -> List[int]:\n    \"\"\"Parses a string of musical notes and returns a list of their beat durations.\"\"\"\n    NOTE_BEAT_MAP = {\n        'o': 4,\n        'o|': 2,\n        '.|': 1\n    }\n\n    note_symbols = music_string.split()\n    beat_durations = [NOTE_BEAT_MAP[symbol] for symbol in note_symbols]\n\n    return beat_durations"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlaping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n    if not string:\n        return 0\n    if not substring:\n        return len(string) + 1\n\n    count = 0\n    for i in range(len(string) - len(substring) + 1):\n        if string[i:i+len(substring)] == substring:\n            count += 1\n    return count"}
{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    # Convert the input string to lowercase to handle case-insensitivity.\n    lower_case_string = string.lower()\n    # Use a set to store unique characters, as sets only contain distinct elements.\n    distinct_chars = set(lower_case_string)\n    return len(distinct_chars)"}
{"task_id": "HumanEval/22", "solution": "def filter_integers(values: List[Any]) -> List[int]:\n    \"\"\" Filter given list of any python values only for integers\n    >>> filter_integers(['a', 3.14, 5])\n    [5]\n    >>> filter_integers([1, 2, 3, 'abc', {}, []])\n    [1, 2, 3]\n    \"\"\"\n    filtered_list = []\n    for item in values:\n        if isinstance(item, int):\n            filtered_list.append(item)\n    return filtered_list"}
