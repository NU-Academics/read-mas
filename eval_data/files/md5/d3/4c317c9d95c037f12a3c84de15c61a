{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n\n    def _calculate_deepest_nesting(group: str) -> int:\n        \"\"\"Calculates the deepest nesting level for a single group of parentheses.\"\"\"\n        current_level = 0\n        max_level = 0\n        for char in group:\n            if char == '(':\n                current_level += 1\n                max_level = max(max_level, current_level)\n            elif char == ')':\n                current_level -= 1\n        return max_level\n\n    groups = paren_string.split(' ')\n    results = []\n    for group in groups:\n        results.append(_calculate_deepest_nesting(group))\n    return results"}
{"task_id": "HumanEval/2", "solution": "import math\n\nclass Number:\n    \"\"\"Encapsulates a positive floating-point number and its decomposition into integer and decimal parts.\"\"\"\n    def __init__(self, value: float):\n        if not isinstance(value, (float, int)) or value < 0:\n            raise ValueError(\"Input value for Number must be a positive floating-point number.\")\n        self._value = value\n        self._integerPart = 0\n        self._decimalPart = 0.0\n        self.decompose()\n\n    def decompose(self) -> None:\n        \"\"\"Calculates the integer and decimal parts of the number.\"\"\"\n        self._integerPart = math.floor(self._value)\n        self._decimalPart = self._value - self._integerPart\n\n    def getDecimalPart(self) -> float:\n        \"\"\"Returns the calculated decimal part of the number.\"\"\"\n        return self._decimalPart\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    an integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    if not isinstance(number, (float, int)) or number < 0:\n        raise ValueError(\"Input must be a positive floating-point number.\")\n\n    num_obj = Number(number)\n    return num_obj.getDecimalPart()"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n\n    def _calculate_mean(nums: List[float]) -> float:\n        \"\"\"Computes the arithmetic mean of a list of floating-point numbers.\"\"\"\n        if not nums:\n            return 0.0  # Or handle as per broader error strategy, assuming non-empty for valid MAD.\n        return sum(nums) / len(nums)\n\n    def _calculate_absolute_differences(nums: List[float], mean_val: float) -> List[float]:\n        \"\"\"Determines the absolute difference between each number in a list and a given mean.\"\"\"\n        return [abs(num - mean_val) for num in nums]\n\n    def _calculate_average(diffs: List[float]) -> float:\n        \"\"\"Computes the average of a list of floating-point numbers.\"\"\"\n        if not diffs:\n            return 0.0  # Or handle as per broader error strategy, assuming non-empty for valid MAD.\n        return sum(diffs) / len(diffs)\n\n    if not numbers:\n        return 0.0\n\n    mean_value = _calculate_mean(numbers)\n    absolute_diffs = _calculate_absolute_differences(numbers, mean_value)\n    mad_result = _calculate_average(absolute_diffs)\n\n    return mad_result"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\nclass ParenthesisGroup:\n    \"\"\"Represents a single parenthesis group and provides functionality to check if its content is balanced.\"\"\"\n\n    def __init__(self, content: str):\n        \"\"\"Initializes the group with its string content.\"\"\"\n        self._group_content: str = content\n\n    def is_balanced(self) -> bool:\n        \"\"\"Checks if the group's string content is a balanced parenthesis string.\"\"\"\n        balance = 0\n        for char in self._group_content:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    def get_content(self) -> str:\n        \"\"\"Returns the string content of the group.\"\"\"\n        return self._group_content\n\n\nclass ParenthesisString:\n    \"\"\"Manages the input string, its cleaned version, and the collection of separated parenthesis groups.\"\"\"\n\n    def __init__(self, paren_string: str):\n        \"\"\"Initializes the object, cleans the input, and processes it to identify and separate groups.\"\"\"\n        self._raw_input: str = paren_string\n        self._cleaned_input: str = paren_string.replace(' ', '')\n        self._separated_groups: List[ParenthesisGroup] = []\n        self._process_groups()\n\n    def _process_groups(self):\n        \"\"\"Processes the cleaned input to identify and separate top-level, balanced groups.\"\"\"\n        balance = 0\n        start_index_of_current_group = -1\n\n        for i, char in enumerate(self._cleaned_input):\n            if char == '(':\n                if balance == 0:  # Start of a new top-level group\n                    start_index_of_current_group = i\n                balance += 1\n            elif char == ')':\n                balance -= 1\n\n            if balance == 0 and start_index_of_current_group != -1:\n                # End of a potential top-level group\n                group_content = self._cleaned_input[start_index_of_current_group : i + 1]\n                potential_group = ParenthesisGroup(group_content)\n                if potential_group.is_balanced():\n                    self._separated_groups.append(potential_group)\n                start_index_of_current_group = -1  # Reset for the next group\n\n    def get_separated_groups_as_strings(self) -> List[str]:\n        \"\"\"Returns the string content of all valid, separated groups.\"\"\"\n        return [group.get_content() for group in self._separated_groups]\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    paren_string_processor = ParenthesisString(paren_string)\n    return paren_string_processor.get_separated_groups_as_strings()"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
