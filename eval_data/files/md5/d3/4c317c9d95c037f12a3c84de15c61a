{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n\n        # If balance drops below zero, a closing bracket appeared before an opening one\n        if balance < 0:\n            return False\n\n    # After iterating, if balance is zero, all brackets are matched and ordered correctly\n    return balance == 0"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\"\"\"\n\n    def _is_increasing(lst: list) -> bool:\n        \"\"\"Checks if a list is monotonically increasing.\"\"\"\n        if len(lst) <= 1:\n            return True\n        for i in range(1, len(lst)):\n            if lst[i] < lst[i-1]:\n                return False\n        return True\n\n    def _is_decreasing(lst: list) -> bool:\n        \"\"\"Checks if a list is monotonically decreasing.\"\"\"\n        if len(lst) <= 1:\n            return True\n        for i in range(1, len(lst)):\n            if lst[i] > lst[i-1]:\n                return False\n        return True\n\n    return _is_increasing(l) or _is_decreasing(l)"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    if n < 1:\n        raise ValueError(\"n must be a positive integer\")\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        \n        # If balance becomes negative, a closing bracket appeared without a matching opening bracket.\n        if balance < 0:\n            return False\n            \n    # After iterating, if balance is 0, all brackets are correctly matched.\n    return balance == 0"}
{"task_id": "HumanEval/63", "solution": "_memo = {}\n\ndef fibfib(n: int):\n    \"\"\"Computes the n-th FibFib number using memoization for efficiency.\"\"\"\n    if n in _memo:\n        return _memo[n]\n\n    if n == 0:\n        result = 0\n    elif n == 1:\n        result = 0\n    elif n == 2:\n        result = 1\n    else:\n        result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n\n    _memo[n] = result\n    return result"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_p_factor = 1\n    d = 2\n    while d * d <= n:\n        if n % d == 0:\n            largest_p_factor = d\n            while n % d == 0:\n                n //= d\n        d += 1\n    \n    if n > 1:\n        largest_p_factor = n\n        \n    return largest_p_factor"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    if not xs or len(xs) <= 1:\n        return []\n\n    # The derivative of c * x^n is c * n * x^(n-1).\n    # The constant term xs[0] has a derivative of 0.\n    # So we iterate from the second term (index 1) onwards.\n    derived_coefficients = []\n    for i in range(1, len(xs)):\n        derived_coefficients.append(xs[i] * i)\n\n    return derived_coefficients"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts the number of vowels in a string, including 'y' if it's the last character.\n    Vowel checks are case-insensitive.\"\"\"\n    count = 0\n    s_lower = s.lower()\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n    n = len(s_lower)\n\n    for i, char in enumerate(s_lower):\n        if char in standard_vowels:\n            count += 1\n        elif char == 'y' and i == n - 1:\n            count += 1\n    return count"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    \"\"\"\n\n    def _get_digits_as_string(x: int) -> str:\n        \"\"\"Converts an integer to its string representation.\"\"\"\n        return str(x)\n\n    def _reverse_digits(digits_str: str) -> str:\n        \"\"\"Reverses the order of digits in a given string.\"\"\"\n        return digits_str[::-1]\n\n    def _perform_circular_shift(digits_str: str, shift_amount: int) -> str:\n        \"\"\"Performs a circular right shift on the digits of a string.\"\"\"\n        n = len(digits_str)\n        effective_shift = shift_amount % n\n        return digits_str[n - effective_shift:] + digits_str[:n - effective_shift]\n\n    digits_str = _get_digits_as_string(x)\n    num_digits = len(digits_str)\n\n    if shift > num_digits:\n        return _reverse_digits(digits_str)\n    else:\n        return _perform_circular_shift(digits_str, shift)"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s: str) -> int:\n    \"\"\"Task\n    Write a function that takes a string as input and returns the sum of the upper characters only'\n    ASCII codes.\n    \"\"\"\n    if not s:\n        return 0\n\n    total_sum = 0\n    for char_val in s:\n        # Check if the character is an uppercase letter and add its ASCII value to the total.\n        if 'A' <= char_val <= 'Z':\n            total_sum += ord(char_val)\n    return total_sum"}
{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given a string of apple and orange counts and the total fruit count.\n    It parses the input string to extract apple and orange counts, then subtracts them from the total.\n    \"\"\"\n    def _parse_fruit_string(s: str) -> tuple[int, int]:\n        \"\"\"\n        Extracts numerical counts of apples and oranges from the input string 's'.\n        Assumes the format \"<number> apples and <number> oranges\".\n        \"\"\"\n        parts = s.split(\" apples and \")\n        apples_str = parts[0]\n        \n        oranges_part = parts[1].split(\" oranges\")[0]\n        oranges_str = oranges_part\n        \n        return int(apples_str), int(oranges_str)\n\n    apple_count, orange_count = _parse_fruit_string(s)\n    mango_count = n - apple_count - orange_count\n    return mango_count"}
