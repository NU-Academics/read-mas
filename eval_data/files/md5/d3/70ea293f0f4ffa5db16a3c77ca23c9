{"task_id": "HumanEval/44", "solution": "from typing import List\n\nclass ConversionError(Exception):\n    \"\"\"Exception raised for conversion-phase errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass ConversionResult:\n    \"\"\"Data holder for the conversion result string.\"\"\"\n    def __init__(self, representation: str):\n        self.representation = representation\n\nclass DigitMapper:\n    \"\"\"Maps numeric remainders to digit characters.\"\"\"\n    def digit_for_remainder(self, rem: int) -> str:\n        \"\"\"Returns a single-character string '0' through '9' for a remainder.\"\"\"\n        if not (0 <= rem <= 9):\n            raise ValueError(f\"Remainder {rem} is out of the valid range 0-9 for digit mapping.\")\n        return str(rem)\n\nclass Validator:\n    \"\"\"Validates input types and base constraints.\"\"\"\n    def validate_types(self, x, base) -> None:\n        \"\"\"Raises TypeError if x or base are not integers.\"\"\"\n        if not isinstance(x, int):\n            raise TypeError(f\"Input x must be an integer, but got {type(x).__name__}\")\n        if not isinstance(base, int):\n            raise TypeError(f\"Base must be an integer, but got {type(base).__name__}\")\n\n    def validate_base_range(self, base: int) -> None:\n        \"\"\"Raises ValueError if base is not within the allowed range [2, 9].\"\"\"\n        if not (2 <= base < 10):\n            raise ValueError(f\"Base must be an integer between 2 and 9 (inclusive), but got {base}\")\n\nclass Converter:\n    \"\"\"Performs numerical base conversion.\"\"\"\n    def __init__(self, digit_mapper: DigitMapper = None):\n        self.digit_mapper = digit_mapper if digit_mapper is not None else DigitMapper()\n\n    def _compute_digits(self, x: int, base: int) -> List[int]:\n        \"\"\"Computes a list of remainders (least-significant first) for a non-negative integer x.\"\"\"\n        if x == 0:\n            return [0]\n\n        digits = []\n        current_x = x\n        while current_x > 0:\n            remainder = current_x % base\n            digits.append(remainder)\n            current_x //= base\n        return digits\n\n    def change_base(self, x: int, base: int) -> str:\n        \"\"\"Converts an integer x to its string representation in the specified base.\"\"\"\n        if x == 0:\n            return '0'\n\n        is_negative = x < 0\n        abs_x = abs(x)\n\n        digits = self._compute_digits(abs_x, base)\n        converted_digits = [self.digit_mapper.digit_for_remainder(d) for d in digits]\n        \n        result_str = \"\".join(reversed(converted_digits))\n\n        if is_negative:\n            return '-' + result_str\n        else:\n            return result_str\n\ndef change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    validator = Validator()\n    validator.validate_types(x, base)\n    validator.validate_base_range(base)\n\n    converter = Converter()\n    return converter.change_base(x, base)"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the sliding window with the first four values:\n    # a = fib4(i-4), b = fib4(i-3), c = fib4(i-2), d = fib4(i-1)\n    a, b, c, d = 0, 0, 2, 0\n\n    # Iterate from i = 4 up to n\n    for i in range(4, n + 1):\n        next_fib = a + b + c + d\n        a = b\n        b = c\n        c = d\n        d = next_fib\n    \n    return d"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    # Sort the list to determine the median.\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # For an odd number of elements, the median is the middle element.\n        median_value = sorted_l[n // 2]\n    else:\n        # For an even number of elements, the median is the average of the two middle elements.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        median_value = (mid1 + mid2) / 2.0 # Ensure float division\n\n    # Return as an integer if the median is an integral value, otherwise return as a float.\n    if isinstance(median_value, float) and median_value.is_integer():\n        return int(median_value)\n    return median_value"}
{"task_id": "HumanEval/49", "solution": "def validate_types(n, p) -> None:\n    \"\"\"Ensures n and p are integers, raising TypeError if not.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(f\"The exponent n must be an integer, but got type {type(n).__name__}.\")\n    if not isinstance(p, int):\n        raise TypeError(f\"The modulus p must be an integer, but got type {type(p).__name__}.\")\n\ndef validate_modulus(p) -> None:\n    \"\"\"Ensures the modulus p is positive, raising ValueError if not.\"\"\"\n    if p <= 0:\n        raise ValueError(f\"The modulus p must be a positive integer, but got {p}.\")\n\ndef modexp(base, exp, mod) -> int:\n    \"\"\"Computes (base ** exp) % mod using iterative exponentiation by squaring.\"\"\"\n    result = 1\n    base %= mod\n    while exp > 0:\n        if exp % 2 == 1:\n            result = (result * base) % mod\n        base = (base * base) % mod\n        exp //= 2\n    return result\n\ndef modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    validate_types(n, p)\n    validate_modulus(p)\n    return modexp(2, n, p)"}
