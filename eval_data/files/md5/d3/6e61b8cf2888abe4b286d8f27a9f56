     while start < end:\n            current_arr_segment[start], current_arr_segment[end] = current_arr_segment[end], current_arr_segment[start]\n            start += 1\n            end -= 1\n        return current_arr_segment\n\n    n = len(arr)\n    current_arr = list(arr) # Create a copy to perform sorting on.\n\n    # Iterate from the end of the array down to the second element.\n    # In each iteration, place the largest element of the unsorted segment to its correct position.\n    for current_size in range(n, 1, -1):\n        # Find the index of the maximum element in the current unsorted segment arr[0...current_size-1].\n        max_idx = find_max_index(current_arr, current_size)\n\n        # If the maximum element is not already at its correct position (current_size - 1),\n        # perform flips to move it there.\n        if max_idx != current_size - 1:\n            # First, flip the segment up to max_idx to bring the maximum element to the beginning.\n            if max_idx != 0:\n                flip(current_arr, max_idx)\n\n            # Second, flip the entire unsorted segment (up to current_size - 1)\n            # to move the maximum element to its final sorted position.\n            flip(current_arr, current_size - 1)\n    \n    return current_arr", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/165": [{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"Counts characters matching their position in the English alphabet (0=a, 1=b, etc.), case-insensitively.\"\"\"\n    count = 0\n    for position, char in enumerate(input_string):\n        lower_char = char.lower()\n        if 'a' <= lower_char <= 'z':\n            # Calculate the expected character for the current position in the alphabet.\n            expected_char = chr(ord('a') + position)\n            if lower_char == expected_char:\n                count += 1\n    return count", "base_status": "pass"