ger divisions.\n    step_x = b // g\n    step_y = a // g\n\n    # If step_x is 0 (i.e., b = 0), then x is unique and no normalization is needed.\n    if step_x == 0:\n        return (x0, y0)\n    \n    # Calculate x_final in the range [0, |step_x|-1] if step_x is positive,\n    # or [step_x+1, 0] if step_x is negative. Python's % operator handles this naturally.\n    x_final = x0 % step_x\n    \n    # Determine the integer 'k' that transformed x0 to x_final\n    k = (x_final - x0) // step_x\n    \n    # Calculate the corresponding y_final using the same 'k'\n    y_final = y0 - k * step_y\n\n    return (x_final, y_final)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[25, 123, 7]]}], "Mbpp/167": [{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Handles n=0 as a special case, returning 1.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    power = 1\n    while power < n:\n        power <<= 1\n    return power", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/168": [{"task_id": "Mbpp/168", "solution": "def frequency(numbers_list: list, target: int) -> int:\n    \"\"\"\n    Counts the number of occurrences of a target number in a given list.\n    Returns the count of how many times the target appears in the list.\n    \"\"\"\n    return numbers_list.count(target)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/171": [{"task_id": "Mbpp/171", "solution": "def perimeter_pentagon(side_length: float) -> float:\n    \"\"\"Calculate the perimeter of a regular pentagon.\"\"\"\n    return side_length * 5", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/166": [{"task_id": "Mbpp/166", "solution": "from typing import List\ndef find_even_pair(numbers: List[int]) -> int:\n    \"\"\