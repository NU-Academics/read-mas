e\n\n        def vowels_count(self, s_param: str) -> int:\n            \"\"\"Counts the number of vowels in the given string.\"\"\"\n            word = Word(s_param)\n            if word.isEmpty():\n                return 0\n\n            count = 0\n            for i, char in enumerate(word.text):\n                if self.isVowel(char, i, word.length()):\n                    count += 1\n            return count\n\n    counter = VowelCounter()\n    return counter.vowels_count(s)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/62": [{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    if len(xs) < 2:\n        return []\n    return [(i + 1) * xs[i + 1] for i in range(len(xs) - 1)]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/72": [{"task_id": "HumanEval/72", "solution": "from typing import List\nclass ObjectList:\n    \"\"\"Encapsulates a list of numeric elements and provides palindrome and sum operations.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n\n    def is_palindrome(self) -> bool:\n        \"\"\"Checks if the list of elements is a palindrome.\"\"\"\n        return self.elements == self.elements[::-1]\n\n    def sum(self) -> float:\n        \"\"\"Calculates the arithmetic sum of the elements.\"\"\"\n        return float(sum(self.elements))\nclass WeightLimit:\n    \"\"\"Holds the maximum allowed weight.\"\"\"\n    def __init__(self, max_weight: float) -> None:\n        self.max_weight = max_weight\ndef will_it_fly(q,w):\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n\n    Example:\n    will_it_fly([1, 2], 5) \u279e False \n    # 1+2 is less than the maximum possible weight, but it's unbalanced.\n\n    will_it_fly([3, 2, 3], 1) \u279e False\n    # it's balanced, but 3+2+3 is more than the maximum possible weight.\n\n    will_it_fly([3, 2, 3], 9) \u279e True\n    # 3+2+3 is less than the maximum possible weight, and it's balanced.\n\n    will_it_fly([3], 5) \u279e True\n    # 3 is less than the maximum possible weight, and it's balanced.\n    '''\n    object_list = ObjectList(elements=q)\n    weight_limit = WeightLimit(max_weight=w)\n\n    if not object_list.is_palindrome():\n        return False\n\n    total_weight = object_list.sum()\n    if total_weight > weight_limit.max_weight:\n        return False\n    \n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/69": [{"task_id": "HumanEval/69", "solution": "import collections\nfrom typing import List, Dict, Optional\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n\n    class FrequencyStore:\n        \"\"\"Maintains and provides frequency counts for integers.\"\"\"\n        def __init__(self) -> None:\n            self._freq_map: Dict[int, int] = collections.defaultdict(int)\n\n        def increment(self, value: int) -> None:\n            \"\"\"Increments the count for a given integer value.\"\"\"\n            self._freq_map[value] += 1\n\n        def get_count(self, value: int) -> int:\n            \"\"\"Returns the frequency count for a given integer value.\"\"\"\n            return self._freq_map[value]\n\n        def distinct_values(self) -> List[int]:\n            \"\"\"Returns a list of all distinct integer values in the store.\"\"\"\n            return list(self._freq_map.keys())\n\n    class SearchService:\n        \"\"\"Orchestrates the search logic: frequency counting, candidate identification, and selection.\"\"\"\n\n        def search(self, lst_param: List[int]) -> int:\n            \"\"\"Performs the main search operation on the input list.\"\"\"\n            # Validation checks (e.g., non-empty, positive integers) are omitted\n            # per \"DO NOT add isinstance() checks or raise exceptions for edge cases\" constraint.\n\n            freq_store = self._compute_frequencies(lst_param)\n            candidates = self._find_candidates(freq_store)\n            return self._select_max_candidate(candidates)\n\n        def _compute_frequencies(self, lst_param: List[int]) -> FrequencyStore:\n            \"\"\"Computes frequencies for each number in the list.\"\"\"\n            freq_store = FrequencyStore()\n            for value in lst_param:\n                freq_store.increment(value)\n            return freq_store\n\n        def _find_candidates(self, freq_store: FrequencyStore) -> List[int]:\n            \"\"\"Identifies integers v where frequency(v) >= v.\"\"\"\n            candidates = []\n            for value in freq_store.distinct_values():\n                if freq_store.get_count(value) >= value:\n                    candidates.append(value)\n            return candidates\n\n        def _select_max_candidate(self, candidates: List[int]) -> int:\n            \"\"\"Returns the greatest candidate, or -1 if no candidates exist.\"\"\"\n            if candidates:\n                return max(candidates)\n            return -1\n\n    # Delegates to the SearchService instance as per design.\n    service = SearchService()\n    return service.search(lst)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/71": [{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    # Validate positivity of sides and triangle inequality.\n    if a <= 0 or b <= 0 or c <= 0:\n        return -1\n    if a + b <= c or a + c <= b or b + c <= a:\n        return -1\n    \n    # Calculate semi-perimeter for Heron's formula.\n    s = (a + b + c) / 2\n    \n    # Compute the area using Heron's formula.\n    # Use max(0, ...) to handle potential floating point inaccuracies that\n    # might result in a very small negative value inside the square root.\n    area_squared = s * (s - a) * (s - b) * (s - c)\n    if area_squared < 0:\n        area_squared = 0.0 # Treat as zero area if slightly negative due to precision\n        \n    area = math.sqrt(area_squared)\n    \n    # Round the area to two decimal places.\n    return round(area, 2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/73": [{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return 0\n\n    changes = 0\n    # Iterate from the start up to the middle of the array (exclusive of the middle element for odd lengths).\n    # n // 2 gives the number of pairs to check (e.g., for n=5, 5//2=2, checks indices 0,1. For n=4, 4//2=2, checks indices 0,1).\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/75": [{"task_id": "HumanEval/75", "solution": "class InputNumber:\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def isValid(self) -> bool:\n        \"\"\"Returns True if the value is an integer and less than 100.\"\"\"\n        return isinstance(self.value, int) and self.value < 100\nclass Prime:\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def isPrime(self) -> bool:\n        \"\"\"Determines if the stored value is a prime number (greater than 1).\"\"\"\n        if self.value < 2:\n            return False\n        for i in range(2, int(self.value**0.5) + 1):\n            if self.value % i == 0:\n                return False\n        return True\ndef is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    input_num_obj = InputNumber(a)\n    if not input_num_obj.isValid():\n        raise ValueError(\"Input 'a' must be an integer less than 100.\")\n\n    primes_list = []\n    # Collect all prime numbers up to 'a' itself, as per design instruction.\n    for i in range(2, a + 1):\n        if Prime(i).isPrime():\n            primes_list.append(i)\n\n    # Search for three primes (p, q, r) whose product equals 'a'. Primes may repeat.\n    for p_val in primes_list:\n        if p_val * 4 > a:  # Optimization: Smallest product p*2*2; if p*4 > a, then p is too large.\n            break\n        for q_val in primes_list:\n            if p_val * q_val * 2 > a: # Optimization: Smallest product p*q*2; if p*q*2 > a, then p*q is too large.\n                break\n            for r_val in primes_list:\n                current_product = p_val * q_val * r_val\n                if current_product == a:\n                    # Found a triple of primes whose product is 'a'.\n                    return True\n                elif current_product > a:\n                    # Since primes_list is sorted, further r_val will only increase the product.\n                    break\n\n    # If no such triple is found after checking all combinations.\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/74": [{"task_id": "HumanEval/74", "solution": "class ListInput:\n    def __init__(self, items: list[str]) -> None:\n        self.items = items\n\n    def total_chars(self) -> int:\n        # Sums the lengths of all strings in the list.\n        return sum(len(s) for s in self.items)\nclass TypeValidator:\n    def is_list(self, x) -> bool:\n        return isinstance(x, list)\n\n    def all_strings(self, lst: list) -> bool:\n        return all(isinstance(item, str) for item in lst)\nclass TotalMatchService:\n    def __init__(self, validator: 'TypeValidator' | None = None) -> None:\n        self.validator = validator if validator is not None else TypeValidator()\n\n    def validate(self, lst) -> None:\n        # Validates if the input is a list of strings, raising TypeError if not.\n        if not self.validator.is_list(lst):\n            raise TypeError(\"Input must be a list.\")\n        if not self.validator.all_strings(lst):\n            raise TypeError(\"All elements in the list must be strings.\")\n\n    def compute_total(self, lst: list[str]) -> int:\n        list_input = ListInput(lst)\n        return list_input.total_chars()\n\n    def compare_and_return(self, lst1: list[str], lst2: list[str]) -> list[str]:\n        # Validates inputs, computes totals, and returns the list with fewer total characters.\n        self.validate(lst1)\n        self.validate(lst2)\n\n        total1 = self.compute_total(lst1)\n        total2 = self.compute_total(lst2)\n\n        if total1 <= total2:\n            return lst1\n        else:\n            return lst2\ndef total_match(lst1, lst2):\n    '''\n    Write a function that accepts two lists of strings and returns the list that has \n    total number of chars in the all strings of the list less than the other list.\n\n    if the two lists have the same number of chars, return the first list.\n    '''\n    service = TotalMatchService()\n    return service.compare_and_return(lst1, lst2)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/70": [{"task_id": "HumanEval/70", "solution": "from typing import List\nfrom dataclasses import dataclass\nclass StrangeSorter:\n    \"\"\"Stateless service implementing the alternating min/max algorithm.\"\"\"\n    def strange_sort_list(self, lst: List[int]) -> List[int]:\n        \"\"\"\n        Given list of integers, return list in strange order.\n        Implementation uses alternating min/max selection from a sorted copy.\n        \"\"\"\n        if not lst:\n            return []\n\n        # Convert input list of integers to IntegerElement objects for internal processing.\n        elements_wrapper = [IntegerElement(val) for val in lst]\n        \n        # Sort the elements based on their value to easily retrieve min/max.\n        sorted_elements = sorted(elements_wrapper, key=lambda x: x.value)\n\n        output_elements = []\n        is_min_turn = True\n\n        while sorted_elements:\n            if is_min_turn:\n                # Pop the smallest element from the beginning of the sorted list.\n                element_to_add = sorted_elements.pop(0)\n            else:\n                # Pop the largest element from the end of the sorted list.\n                element_to_add = sorted_elements.pop()\n            \n            output_elements.append(element_to_add)\n            is_min_turn = not is_min_turn\n        \n        # Convert the list of IntegerElement objects back to a list of integer values.\n        return [elem.value for elem in output_elements]\ndef strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n\n    Examples:\n    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]\n    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]\n    strange_sort_list([]) == []\n    '''\n    # Public API wrapper that delegates to StrangeSorter.strange_sort_list.\n    # Ensures a new list is returned and the input is not modified.\n    sorter = StrangeSorter()\n    return sorter.strange_sort_list(lst)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 2, 3, 4]]], "plus_fail_tests": [[[-5, 0, 5, 10]]]}], "HumanEval/76": [{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n, meaning n**k == x for some non-negative integer k.\"\"\"\n    if n == 1:\n        return x == 1\n    if x == 1:\n        return True\n    if x <= 0:  # Handles x=0 and negative x. For 0**k=0, handled by loop.\n        if n == 0: # 0**k only equals 0 for k > 0, but x=0 means 0**0, 0**1, ...\n            return x == 0 and True  # 0**k == 0 for k > 0.\n        return False\n    if n == 0: # If x > 1 and n == 0, then 0**k can never equal x.\n        return False\n\n    k = 0\n    current_power = 1\n    while current_power < x:\n        # Check for potential overflow before multiplication for very large numbers, though Python handles large ints.\n        # Also, check if n is 0 or 1, already handled above, to prevent issues here.\n        # If n is negative and x is positive, current_power might oscillate or never reach x if abs(n) > 1.\n        # For negative n, n**k alternates sign.\n        # If n < -1 and x > 0: current_power will eventually become negative (for odd k), or grow for even k.\n        # If n == -1, current_power alternates between 1 and -1.\n        if n < 0 and k % 2 == 1: # current_power is negative, x is positive, cannot be equal.\n            return False\n        if abs(n) > 1 and x / abs(n) < abs(current_power): # Optimization to prevent overflow or unnecessary computation for large n\n             return False # x would be smaller than the next power\n\n        current_power *= n\n        k += 1\n        if current_power == x:\n            return True\n        if abs(current_power) > abs(x) and n != -1: # If current_power surpassed x, and n isn't -1, it won't hit x.\n            return False # For n=-1, power oscillates between 1 and -1, so this check is not useful.\n\n    return current_power == x", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[-2, -2]]}], "HumanEval/68": [{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    \"Given an array representing a branch of a tree that has non-negative integer nodes\n    your task is to pluck one of the nodes and return it.\n    The plucked node should be the node with the smallest even value.\n    If multiple nodes with the same smallest even value are found return the node that has smallest index.\n\n    The plucked node should be returned in a list, [ smalest_value, its index ],\n    If there are no even values or the given array is empty, return [].\n    \"\"\"\n\n    # Helper function for input validation.\n    def _validate_input(arr_input):\n        if not isinstance(arr_input, list):\n            return False\n        if not (0 <= len(arr_input) <= 10000):\n            return False\n        for x in arr_input:\n            if not isinstance(x, int) or x < 0:\n                return False\n        return True\n\n    # Helper function to find the smallest even value and its earliest index.\n    def _find_smallest_even(arr_input):\n        min_value = None\n        min_index = None\n\n        for i, v in enumerate(arr_input):\n            if v % 2 == 0:  # Check if the number is even\n                if min_value is None or v < min_value:\n                    min_value = v\n                    min_index = i\n                # If v == min_value, do nothing to preserve the earliest index\n        \n        if min_value is None:\n            return None\n        else:\n            return (min_value, min_index)\n\n    # Main logic for the pluck function.\n    if not _validate_input(arr):\n        return []\n\n    if len(arr) == 0:\n        return []\n\n    result = _find_smallest_even(arr)\n\n    if result is None:\n        return []\n    else:\n        value, index = result\n        return [value, index]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/77": [{"task_id": "HumanEval/77", "solution": "class IntegerValue:\n    def __init__(self, value: int) -> None:\n        self.value = value\nclass CubeRootCandidate:\n    def __init__(self, n: int) -> None:\n        self.n = n\nclass CubeResult:\n    def __init__(self, isCube: bool) -> None:\n        self.isCube = isCube\nclass CubeChecker:\n    def isCube(self, a: int) -> bool:\n        # Wrap input in IntegerValue as part of the CubeChecker flow.\n        _ = IntegerValue(a)\n\n        # Compute the integer cube-root candidate.\n        candidate_n = self.findIntegerCubeRoot(a)\n        \n        # Represent the candidate using CubeRootCandidate.\n        _ = CubeRootCandidate(candidate_n)\n\n        # Perform exact integer equality comparison.\n        is_perfect_cube = (candidate_n * candidate_n * candidate_n == a)\n        \n        # Produce CubeResult with the boolean outcome.\n        cube_result = CubeResult(is_perfect_cube)\n        return cube_result.isCube\n\n    def findIntegerCubeRoot(self, a: int) -> int:\n        # Compute and return an integer candidate n using an integer-only binary search.\n        if a == 0:\n            return 0\n\n        sign = 1\n        abs_a = a\n        if a < 0:\n            sign = -1\n            abs_a = -a\n\n        low = 0\n        high = abs_a # The cube root of abs_a is always less than or equal to abs_a.\n\n        floor_cbrt = 0 # Stores the largest integer whose cube is less than or equal to abs_a.\n\n        while low <= high:\n            mid = (low + high) // 2\n            mid_cubed = mid * mid * mid\n\n            if mid_cubed == abs_a:\n                return mid * sign # Exact root found.\n            elif mid_cubed < abs_a:\n                floor_cbrt = mid\n                low = mid + 1\n            else: # mid_cubed > abs_a\n                high = mid - 1\n        \n        # If no exact root was found, return the floor of the cube root with the original sign.\n        return floor_cbrt * sign\ndef iscube(a):\n    '''\n    Write a function that takes an integer a and returns True \n    if this ingeger is a cube of some integer number.\n    Note: you may assume the input is always valid.\n    Examples:\n    iscube(1) ==> True\n    iscube(2) ==> False\n    iscube(-1) ==> True\n    iscube(64) ==> True\n    iscube(0) ==> True\n    iscube(180) ==> False\n    '''\n    checker = CubeChecker()\n    return checker.isCube(a)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/78": [{"task_id": "HumanEval/78", "solution": "_PRIME_HEX_DIGITS = {\"2\", \"3\", \"5\", \"7\", \"B\", \"D\"}\ndef _is_prime_hex_digit(ch: str) -> bool:\n    \"\"\"Return True if ch is in _PRIME_HEX_DIGITS.\"\"\"\n    return ch in _PRIME_HEX_DIGITS\ndef hex_key(num: str) -> int:\n    \"\"\"Counts the number of hexadecimal digits that are primes.\n    Prime hexadecimal digits are 2, 3, 5, 7, B (11), D (13).\n    \"\"\"\n    if not num:\n        return 0\n\n    prime_count = 0\n    for char in num:\n        if _is_prime_hex_digit(char):\n            