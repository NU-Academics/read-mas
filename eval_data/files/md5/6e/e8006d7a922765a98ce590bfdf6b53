in(decimal_value)[2:]\n            return BinaryDigits(binary_str)\n\n    class Formatter:\n        \"\"\"Wraps BinaryDigits into the final formatted string 'db{binary}db'.\"\"\"\n        def wrap(self, digits_obj: BinaryDigits) -> str:\n            \"\"\"Returns the binary digits string wrapped with 'db' prefix and suffix.\"\"\"\n            return \"db\" + digits_obj.digits + \"db\"\n\n    # No need for BinaryOutput class in this direct execution flow as Formatter returns str directly.\n\n    # Orchestration of domain components\n    input_obj = DecimalInput(decimal)\n\n    if not input_obj.validate():\n        raise ValueError(\"invalid decimal input: must be integer\")\n\n    converter = Converter()\n    digits = converter.convert(input_obj)\n\n    formatter = Formatter()\n    formatted_str = formatter.wrap(digits)\n\n    return formatted_str", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/84": [{"task_id": "HumanEval/84", "solution": "class Input:\n    \"\"\"Holds the input integer N.\"\"\"\n    def __init__(self, N: int):\n        self.N = N\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation failures.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass Validator:\n    \"\"\"Validates the type and range of the input N.\"\"\"\n    @staticmethod\n    def validateType(N) -> bool:\n        \"\"\"Checks if N is an integer type.\"\"\"\n        return isinstance(N, int)\n\n    @staticmethod\n    def validateRange(N: int) -> bool:\n        \"\"\"Checks if N is within the allowed range [0, 10000].\"\"\"\n        return 0 <= N <= 10000\nclass DigitSumCalculator:\n    \"\"\"Computes the sum of the decimal digits of N.\"\"\"\n    @staticmethod\n    def sumDigits(N: int) -> int:\n        \"\"\"Calculates the sum of base-10 digits for N.\"\"\"\n        if N == 0:\n            return 0\n        total_sum = 0\n        # Convert N to string to iterate over digits\n        for digit_char in str(N):\n            total_sum += int(digit_char)\n        return total_sum\nclass BinaryConverter:\n    \"\"\"Converts an integer sum to its canonical binary string representation.\"\"\"\n    @staticmethod\n    def toBinary(sum_val: int) -> str:\n        \"\"\"Converts an integer to a binary string without leading zeros (except for 0).\"\"\"\n        if sum_val == 0:\n            return \"0\"\n        return bin(sum_val)[2:] # Slice \"0b\" prefix\nclass Output:\n    \"\"\"Holds the final result string.\"\"\"\n    def __init__(self, result: str):\n        self.result = result\ndef solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n    \n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n    # Create Input object (though N is used directly)\n    _input = Input(N) # Not strictly necessary for this simple use, but adheres to design.\n\n    # Validate input type\n    if not Validator.validateType(N):\n        raise ValidationError(\"invalid type: N must be integer\")\n\n    # Validate input range\n    if not Validator.validateRange(N):\n        raise ValidationError(\"invalid range: N must be 0..10000\")\n\n    # Compute sum of decimal digits\n    s = DigitSumCalculator.sumDigits(N)\n\n    # Convert sum to binary string\n    b = BinaryConverter.toBinary(s)\n\n    # Store and return the result\n    _output = Output(b)\n    return _output.result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/83": [{"task_id": "HumanEval/83", "solution": "class UserInput:\n    \"\"\"Represents user input