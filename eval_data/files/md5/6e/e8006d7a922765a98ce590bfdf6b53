ght_group: CarGroup = None\n\n    def setInput(self, n: int) -> None:\n        \"\"\"Sets the number of cars for the simulation.\"\"\"\n        self.n = n\n        self._road = Road()\n        self._left_group = CarGroup(direction='left-to-right', count=n)\n        self._right_group = CarGroup(direction='right-to-left', count=n)\n\n    def computeCollisions(self) -> int:\n        \"\"\"Computes the total number of collisions.\"\"\"\n        self.result = self.n * self.n\n        return self.result\ndef car_race_collision(n: int):\n    \"\"\"\n    Imagine a road that's a perfectly straight infinitely long line.\n    n cars are driving left to right;  simultaneously, a different set of n cars\n    are driving right to left.   The two sets of cars start out being very far from\n    each other.  All cars move in the same speed.  Two cars are said to collide\n    when a car that's moving left to right hits a car that's moving right to left.\n    However, the cars are infinitely sturdy and strong; as a result, they continue moving\n    in their trajectory as if they did not collide.\n\n    This function outputs the number of such collisions.\n    \"\"\"\n    # As per prompt: \"DO NOT add isinstance() checks or raise exceptions for edge cases\"\n    # We assume 'n' is a valid non-negative integer due to this constraint overriding design's validation.\n\n    simulator = Simulator()\n    simulator.setInput(n)\n    return simulator.computeCollisions()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/45": [{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    return 0.5 * a * h", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/43": [{"task_id": "HumanEval/43", "solution": "from typing import Optional\nclass Element:\n    \"\"\"Represents an element with its value and original index.\"\"\"\n    def __init__(self, value: int, index: int):\n        self.value = value\n        self.index = index\nclass Pair:\n    \"\"\"Represents a pair of elements that sum to zero.\"\"\"\n    def __init__(self, a: 'Element', b: 'Element'):\n        self.a = a\n        self.b = b\nclass PairCheckResult:\n    \"\"\"Encapsulates the result of a zero-sum pair search.\"\"\"\n    def __init__(self, result: bool, pair: 'Pair | None'):\n        self.result = result\n        self.pair = pair\nclass InputList:\n    \"\"\"Manages the input list for validation and searching for zero-sum pairs.\"\"\"\n    def __init__(self, values: list):\n        self.values = values\n\n    def validateTypes(self) -> bool:\n        \"\"\"Checks if all elements in the list are integers.\"\"\"\n        return all(isinstance(x, int) for x in self.values)\n\n    def validateLength(self) -> bool:\n        \"\"\"Checks if the list has at least two elements.\"\"\"\n        return len(self.values) >= 2\n\n    def findZeroSumPair(self) -> 'PairCheckResult':\n        \"\"\"Searches for two distinct elements that sum to zero.\"\"\"\n        n = len(self.values)\n        for i in range(n):\n            for j in range(i + 1, n):\n                if self.values[i] + self.values[j] == 0:\n                    element_a = Element(self.values[i], i)\n                    element_b = Element(self.values[j], j)\n                    return PairCheckResult(result=True, pair=Pair(element_a, element_b))\n        return PairCheckResult(result=False, pair=None)\ndef pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 