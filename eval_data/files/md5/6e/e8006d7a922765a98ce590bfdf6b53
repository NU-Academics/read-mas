e Comparator to find the two NumberElement objects that are closest.\n    # These NumberElement objects preserve their original values and indices.\n    ne_a, ne_b = Comparator.compute_min_diff_pair(numbers)\n\n    # Extract the float values and order them (smaller, larger) as required.\n    first_value = min(ne_a.value, ne_b.value)\n    second_value = max(ne_a.value, ne_b.value)\n\n    return (first_value, second_value)\nclass Validator:\n    \"\"\"Encapsulates precondition logic.\"\"\"\n    @staticmethod\n    def validate_length(numbers: List[float]) -> bool:\n        \"\"\"Returns True if the list length is at least two.\"\"\"\n        return len(numbers) >= 2\nclass Comparator:\n    \"\"\"Computes the minimal-difference pair and returns NumberElement objects.\"\"\"\n    @staticmethod\n    def compute_min_diff_pair(numbers: List[float]) -> Tuple[NumberElement, NumberElement]:\n        \"\"\"\n        Computes the pair of NumberElement objects with the minimal absolute difference.\n        Implements a deterministic tie-breaker based on original indices.\n        \"\"\"\n        # Create NumberElement objects to keep track of original indices.\n        ne_list = [NumberElement(value, index) for index, value in enumerate(numbers)]\n        \n        # Sort the NumberElement list by value to easily find closest elements (adjacent ones).\n        sorted_ne_list = sorted(ne_list, key=lambda ne: ne.value)\n\n        min_diff = float('inf')\n        # Initialize closest_pair_by_index with a dummy pair; it will be overwritten.\n        # The design implies `numbers` has at least two elements, so `closest_pair_by_index` will be set.\n        closest_pair_by_index = (sorted_ne_list[0], sorted_ne_list[1]) \n\n        # Iterate through adjacent elements to find the minimal difference.\n        for i in range(len(sorted_ne_list) - 1):\n            ne1 = sorted_ne_list[i]\n            ne2 = sorted_ne_list[i+1]\n\n            current_diff = abs(ne1.value - ne2.value)\n\n            # Canonicalize the current pair for tie-breaking by sorting its elements by original index.\n            candidate_pair = tuple(sorted((ne1, ne2), key=lambda x: x.index))\n\n            if current_diff < min_diff:\n                min_diff = current_diff\n                closest_pair_by_index = candidate_pair\n            elif current_diff == min_diff:\n                # Apply deterministic tie-breaker rules:\n                # 1. Prefer the pair whose first element has the smallest original index.\n                if candidate_pair[0].index < closest_pair_by_index[0].index:\n                    closest_pair_by_index = candidate_pair\n                # 2. If first elements' indices are tied, prefer the pair whose second element\n                #    has the smallest original index.\n                elif candidate_pair[0].index == closest_pair_by_index[0].index:\n                    if candidate_pair[1].index < closest_pair_by_index[1].index:\n                        closest_pair_by_index = candidate_pair\n        \n        return closest_pair_by_index", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/26": [{"task_id": "HumanEval/26", "solution": "def remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    class FrequencyCounter:\n        from typing import Dict\n        def count(self, elements: List[int]) -> Dict[int, int]:\n            \"\"\"Counts the occurrences of each element in a list.\"\"\"\n            freq_map = {}\n            for x in elements:\n                freq_map[x] = freq_map.get(x, 0) + 1\n            return freq_map\n\n    frequency_counter = FrequencyCounter()\n    freqs = frequency_counter.count(numbers)\n    \n    result = []\n    for x in numbers:\n        if freqs.get