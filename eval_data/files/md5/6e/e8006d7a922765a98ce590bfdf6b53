ents\n\n    def sort_elements(self, elements: List[Element]) -> List[Element]:\n        \"\"\"Sorts a list of Element objects based on their 'value' attribute.\"\"\"\n        return sorted(elements, key=lambda e: e.value)\n\n    def reconstruct_output(self, original_list: list, sorted_elements: List[Element]) -> list:\n        \"\"\"Reconstructs a new list with sorted values at divisible-by-three indices.\"\"\"\n        new_list = list(original_list)\n\n        sorted_iter = iter(sorted_elements)\n        for i in range(len(new_list)):\n            if i % 3 == 0:\n                new_list[i] = next(sorted_iter).value\n        return new_list\ndef sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    service = SortThirdService()\n    return service.sort_third(l)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/35": [{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    max_val = l[0]\n    for item in l[1:]:\n        if item > max_val:\n            max_val = item\n    return max_val", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/34": [{"task_id": "HumanEval/34", "solution": "def unique(l: list) -> list:\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    # Use a set to get unique elements, then convert to a list and sort.\n    return sorted(list(set(l)))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/32": [{"task_id": "HumanEval/32", "solution": "import math\nfrom typing import Sequence\nclass PolynomialEvaluator:\n    TOLERANCE: float = 1e-6\n\n    @staticmethod\n    def evaluate(coefficients: Sequence[float], x: float) -> float:\n        \"\"\"Evaluates a polynomial with given coefficients at point x.\"\"\"\n        return sum(coeff * math.pow(x, i) for i, coeff in enumerate(coefficients))\nclass Validator:\n    @staticmethod\n    def validate_coefficients(xs: Sequence[object]) -> None:\n        \"\"\"Validates that all coefficients are numeric (int or float) and the list is not empty.\"\"\"\n        if not isinstance(xs, (list, tuple)):\n            raise TypeError(\"coefficients must be a list or tuple of numbers\")\n        if not xs:\n            raise ValueError(\"coefficients list cannot be empty\")\n        for coeff in xs:\n            if not isinstance(coeff, (int, float)):\n                raise TypeError(\"coefficients must be numeric (int or float)\")\n\n    @staticmethod\n    def validate_constraints(xs: Sequence[float]) -> None:\n        \"\"\"Validates constraints specific to find_zero: even length and non-zero leading coefficient.\"\"\"\n        if len(xs) % 2 != 0:\n            raise ValueError(\"len(xs) must be even (degree must be odd)\")\n        if not xs[-1]:  # xs[-1] == 0\n            raise ValueError(\"leading coefficient must be non-zero\")\nclass RootFinder:\n    def __init__(self, tolerance: float = 1e-6, max_bracket: float = 1e6, max_iterations: int = 1000):\n        self.tolerance = tolerance\n        self.max_bracket = max_bracket\n        self.max_iterations = max_iterations\n\n    def find_zero(self, xs: Sequence[float]) -> float:\n        \"\"\"\n        Deterministically finds one real root for a polynomial with odd degree.\n        Uses a symmetric bracket search around 0, then bisection.\n        \"\"\"\n        f = lambda val: PolynomialEvaluator.evaluate(xs, val)\n\n        val_at_zero = f(0.0)\n        if abs(val_at_zero) < self.tolerance:\n            return 0.0\n\n        a_bracket, b_bracket = None, None\n        search_step = 0.1\n        \n        prev_x_pos = 0.0\n        prev_f_pos = val_at_zero\n        \n        prev_x_neg = 0.0\n        prev_f_neg = val_at_zero\n\n        current_r = search_step\n        while current_r <= self.max_bracket:\n            x_pos = current_r\n            f_x_pos = f(x_pos)\n            \n            if abs(f_x_pos) < self.tolerance:\n                return x_pos\n            \n            if prev_f_pos * f_x_pos < 0:\n                a_bracket, b_bracket = prev_x_pos, x_pos\n                break\n            \n            x_neg = -current_r\n            f_x_neg = f(x_neg)\n\n            if abs(f_x_neg) < self.tolerance:\n                return x_neg\n            \n            if f_x_neg * prev_f_neg < 0:\n                a_bracket, b_bracket = x_neg, prev_x_neg\n                break\n            \n            prev_x_pos = x_pos\n            prev_f_pos = f_x_pos\n            \n            prev_x_neg = x_neg\n            prev_f_neg = f_x_neg\n\n            current_r += search_step\n        \n        if a_bracket is None:\n            raise ValueError(\"Root not found within search bounds.\")\n\n        a, b = a_bracket, b_bracket\n        fa, fb = f(a), f(b)\n\n        if fa * fb > 0:\n            raise ValueError(\"Internal error: Bisection bracket does not have sign change.\")\n\n        for _ in range(self.max_iterations):\n            mid = (a + b) / 2\n            f_mid = f(mid)\n\n            if abs(f_mid) < self.tolerance or abs(b - a) < self.tolerance:\n                return mid\n\n            if f_mid * fa < 0:\n                b = mid\n                fb = f_mid\n            else:\n                a = mid\n                fa = f_mid\n        \n        return (a + b) / 2\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    Validator.validate_coefficients(xs)\n    Validator.validate_constraints(xs)\n    \n    root_finder_instance = RootFinder(\n        tolerance=PolynomialEvaluator.TOLERANCE,\n        max_bracket=1e6,\n        max_iterations=1000\n    )\n    return root_finder_instance.find_zero(xs)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-10, -2]]], "plus_fail_tests": [[[5, 10, -3, 1]]]}], "HumanEval/19": [{"task_id": "HumanEval/19", "solution": "def sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    from typing import List, Dict\n\n    class DigitMapping:\n        \"\"\"Provides canonical mapping between digit words and integer values and inverse mapping.\"\"\"\n        _WORD_TO_VALUE: Dict[str, int] = {\n            'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n            'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n        }\n        _VALUE_TO_WORD: Dict[int, str] = {\n            0: 'zero', 1: 'one', 2: 'two', 3: 'three', 4: 'four',\n            5: 'five', 6: 'six', 7: 'seven', 8: 'eight', 9: 'nine'\n        }\n\n        @staticmethod\n        def to_value(word: str) -> int:\n            \"\"\"Converts a digit word to its integer value.\"\"\"\n            return DigitMapping._WORD_TO_VALUE[word]\n\n        @staticmethod\n        def to_word(value: int) -> str:\n            \"\"\"Converts an integer value to its digit word.\"\"\"\n            return DigitMapping._VALUE_TO_WORD[value]\n\n    class Token:\n        \"\"\"Represents an input word and its mapped integer value.\"\"\"\n        def __init__(self, word: str) -> None:\n            self.word: str = word\n            self.value: int = -1  # Default invalid value\n\n        def is_valid(self) -> bool:\n            \"\"\"Checks if the token's word is a valid digit word.\"\"\"\n            return self.word in DigitMapping._WORD_TO_VALUE\n\n        def map_value(self) -> None:\n            \"\"\"Sets the token's numeric value using DigitMapping.\"\"\"\n            self.value = DigitMapping.to_value(self.word)\n\n    class InputString:\n        \"\"\"Encapsulates the raw input string and provides a normalized version.\"\"\"\n        def __init__(self, raw: str) -> None:\n            self.raw: str = raw\n\n        def normalize(self) -> str:\n            \"\"\"Returns a normalized string for parsing (trims and prepares for split).\"\"\"\n            return self.raw.strip()\n\n    class Parser:\n        \"\"\"Splits the normalized input into token words and constructs Token objects.\"\"\"\n        def parse(self, raw: str) -> List[Token]:\n            \"\"\"Parses raw input into a list of Token instances, validating and mapping values.\"\"\"\n            words = raw.split()\n            tokens: List[Token] = []\n            for word in words:\n                token = Token(word)\n                if token.is_valid():  # Only map valid tokens\n                    token.map_value()\n                    tokens.append(token)\n            return tokens\n\n    class Sorter:\n        \"\"\"Sorts a list of Token instances by their numeric value.\"\"\"\n        def sort(self, tokens: List[Token]) -> List[Token]:\n            \"\"\"Sorts tokens in ascending order based on their numeric value.\"\"\"\n            # Use a stable sort, which Python's Timsort (used by list.sort() and sorted()) is.\n            return sorted(tokens, key=lambda token: token.value)\n\n    class Formatter:\n        \"\"\"Converts a sorted list of Token objects into a space-delimited output string.\"\"\"\n        def format(self, tokens: List[Token]) -> str:\n            \"\"\"Formats a list of Tokens into a single space-delimited string of words.\"\"\"\n            return ' '.join([token.word for token in tokens])\n\n    # Orchestrate the pipeline\n    isrc = InputString(numbers)\n    normalized = isrc.normalize()\n\n    parser = Parser()\n    tokens = parser.parse(normalized)\n\n    sorter = Sorter()\n    sorted_tokens = sorter.sort(tokens)\n\n    formatter = Formatter()\n    return formatter.format(sorted_tokens)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/25": [{"task_id": "HumanEval/25", "solution": "from typing import List\nfrom math import isqrt\nclass IntegerInput:\n    \"\"\"Encapsulates input semantics and performs validation.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def validate(self) -> bool:\n        \"\"\"Returns True if the input value is valid (positive integer > 1).\"\"\"\n        return self.value > 1\nclass PrimeFactor:\n    \"\"\"Represents a prime factor and its multiplicity.\"\"\"\n    def __init__(self, value: int, multiplicity: int) -> None:\n        self.value = value\n        self.multiplicity = multiplicity\nclass FactorizationResult:\n    \"\"\"Holds final factors and verifies the product equals the input n.\"\"\"\n    def __init__(self, factors: List[int]) -> None:\n        self.factors = factors\n\n    def verify_product(self, n: int) -> bool:\n        \"\"\"Verifies that the product of stored factors equals n.\"\"\"\n        product = 1\n        for factor in self.factors:\n            product *= factor\n        return product == n\nclass FactorizationService:\n    \"\"\"Computes factorization, produces FactorizationResult, ensures ordering and multiplicity.\"\"\"\n    def factorize(self, n: int) -> List[int]:\n        \"\"\"Orchestrates the factorization process for a given integer n.\"\"\"\n        prime_factors = self._generate_prime_factors(n)\n        return self._accumulate_factors(prime_factors)\n\n    def _generate_prime_factors(self, n: int) -> List[PrimeFactor]:\n        \"\"\"Generates prime factors and their multiplicities.\"\"\"\n        prime_factors_list: List[PrimeFactor] = []\n        temp_n = n\n        d = 2\n        \n        while d <= isqrt(temp_n): \n            multiplicity = 0\n            while temp_n % d == 0:\n                multiplicity += 1\n                temp_n //= d\n            if multiplicity > 0:\n                prime_factors_list.append(PrimeFactor(d, multiplicity))\n            d += 1\n\n        if temp_n > 1:\n            prime_factors_list.append(PrimeFactor(temp_n, 1))\n            \n        return prime_factors_list\n\n    def _accumulate_factors(self, prime_factors: List[PrimeFactor]) -> List[int]:\n        \"\"\"Expands prime factors with multiplicities into a flat list.\"\"\"\n        accumulated_factors: List[int] = []\n        for pf in prime_factors:\n            accumulated_factors.extend([pf.value] * pf.multiplicity)\n        return accumulated_factors\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    input_obj = IntegerInput(n)\n    if not input_obj.validate():\n        # As per design, returning an empty list for invalid input (n <= 1).\n        return []\n\n    service = FactorizationService()\n    factors = service.factorize(n)\n\n    result_obj = FactorizationResult(factors)\n    if not result_obj.verify_product(n):\n        # As per design, returning an empty list if verification fails.\n        return []\n    \n    return result_obj.factors", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/37": [{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    even_values = []\n    # Extract values from even indices\n    for i in range(len(l)):\n        if i % 2 == 0:\n            even_values.append(l[i])\n\n    # Sort the extracted even values\n    sorted_even_values = sorted(even_values)\n\n    # Construct the new list, placing sorted even values and original odd values\n    result_list = [None] * len(l)\n    sorted_even_idx = 0\n    for i in range(len(l)):\n        if i % 2 == 0:\n            result_list[i] = sorted_even_values[sorted_even_idx]\n            sorted_even_idx += 1\n        else:\n            result_list[i] = l[i]\n\n    return result_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/38": [{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group. Unless group has fewer elements than 3.\n    # For decoding, perform a right rotation.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/42": [{"task_id": "HumanEval/42", "solution": "import collections.abc\nclass IntegerList:\n    \"\"\"Represents an ordered sequence of integers; exposes length and iteration.\"\"\"\n    def __init__(self, elements: list[int]) -> None:\n        self.elements = list(elements) # Store a copy\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def __iter__(self) -> collections.abc.Iterator[int]:\n        \"\"\"Allows iteration over the integer elements.\"\"\"\n        return iter(self.elements)\n\n    def to_list(self) -> list[int]:\n        \"\"\"Returns the contained elements as a standard Python list.\"\"\"\n        return list(self.elements) # Return a copy\nclass ListProcessor:\n    \"\"\"Encapsulates increment operation mapping each integer to integer+1, preserving order and length.\"\"\"\n    def __init__(self, operation: str = \"increment\") -> None:\n        self.operation = operation\n\n    def increment(self, input_list: 'IntegerList') -> 'IntegerList':\n        \"\"\"Processes an IntegerList to increment each element by 1, returning a new IntegerList.\"\"\"\n        incremented_elements = []\n        for element in input_list:\n            incremented_elements.append(element + 1)\n        return IntegerList(incremented_elements)\ndef incr_list(l: list):\n    \"\"\"Return list with elements incremented by 1.\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    \"\"\"\n    il = IntegerList(l)\n    proc = ListProcessor(operation=\"increment\")\n    result_il = proc.increment(il)\n    return result_il.to_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "