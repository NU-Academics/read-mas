]\n                    groups.append(ParenGroup(group_content, group_start_index, i + 1))\n                    group_start_index = -1\n        return groups\n\n    def _group_to_string(self, g: ParenGroup) -> str:\n        \"\"\"Converts a ParenGroup object to its content string.\"\"\"\n        return g.content\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"\n    Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    parser = ParenParser()\n    return parser.separate_paren_groups(paren_string)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/6": [{"task_id": "HumanEval/6", "solution": "from typing import List\nclass InputString:\n    \"\"\"Encapsulates the raw input string.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw = raw\nclass Group:\n    \"\"\"Represents a single parenthesis group and computes its maximum nesting depth.\"\"\"\n    def __init__(self, token: str) -> None:\n        self.token = token\n        self.maxDepth = 0\n\n    def computeMaxDepth(self) -> int:\n        \"\"\"Iterates characters to track current and maximum nesting depth.\"\"\"\n        current = 0\n        maximum = 0\n        for ch in self.token:\n            if ch == '(':\n                current += 1\n                if current > maximum:\n                    maximum = current\n            else:  # ch == ')'\n                current -= 1\n        self.maxDepth = maximum\n        return maximum\nclass Parser:\n    \"\"\"Orchestrates splitting the input, creating Group objects, and aggregating results.\"\"\"\n    def parse(self, paren_string: str) -> List[int]:\n        input_obj = InputString(paren_string)\n        tokens = [t for t in input_obj.raw.split(' ') if t != '']\n        depths: List[int] = []\n        for token in tokens:\n            g = Group(token)\n            d = g.computeMaxDepth()\n            depths.append(d)\n        return depths\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n    Preconditions: Each non-empty group token contains only '(' and ')' and is well-formed (balanced).\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    parser = Parser()\n    return parser.parse(paren_string)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/2": [{"task_id": "HumanEval/2", "solution": "def _integer_part(number: float) -> int:\n    \"\"\"Return integer portion used to compute decimal part for non-negative inputs.\"\"\"\n    return int(number)\ndef truncate_number(number: float) -> float:\n    \"\"\"Return the decimal (fractional) part of a positive floating-point number.\n    Signature and behavior required by SRS.\n    \"\"\"\n    integer_part = _integer_part(number)\n    return number - integer_part", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/5": [{"task_id": "HumanEval/5", "solution": "from typing import List\nclass InputList:\n    \"\"\"Wrapper for the input list of integers.\"\"\"\n    def __init__(self, elements: List[int]):\n        self._elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the input list.\"\"\"\n        return len(self._elements)\n\n    def get_elements(self) -> List[int]:\n        \"\"\"Returns the underlying list elements.\"\"\"\n        return self._elements\nclass OutputList:\n    \"\"\"Wrapper for the output list of integers.\"\"\"\n    def __init__(self, elements: List[int]):\n        self._elements = elements\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns the underlying Python list.\"\"\"\n        return self._elements\nclass Delimeter:\n    \"\"\"Wrapper for the integer delimiter.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def get_value(self) -> int:\n        \"\"\"Returns the delimiter integer value.\"\"\"\n        return self._value\nclass IntersperseFunction:\n    \"\"\"Stateless service encapsulating validation and the intersperse algorithm.\"\"\"\n\n    def validate_inputs(self, numbers_raw: List[int], delimeter_raw: int) -> None:\n        \"\"\"Validates input types and content, raising TypeError on failure.\"\"\"\n        if not isinstance(numbers_raw, list):\n            raise TypeError(\"Input 'numbers' must be a list.\")\n        for i, num in enumerate(numbers_raw):\n            if not isinstance(num, int):\n                raise TypeError(f\"All elements in 'numbers' must be integers. Element at index {i} is not an integer.\")\n        if not isinstance(delimeter_raw, int):\n            raise TypeError(\"Input 'delimeter' must be an integer.\")\n\n    def execute(self, numbers_raw: List[int], delimeter_raw: int) -> OutputList:\n        \"\"\"Executes the intersperse algorithm to produce the output list.\"\"\"\n        input_list = InputList(numbers_raw)\n        delimeter_obj = Delimeter(delimeter_raw)\n\n        if input_list.length() == 0:\n            return OutputList([])\n\n        result_elements: List[int] = []\n        elements = input_list.get_elements()\n        delimiter_val = delimeter_obj.get_value()\n\n        for i, num in enumerate(elements):\n            result_elements.append(num)\n            if i < input_list.length() - 1:\n                result_elements.append(delimiter_val)\n        \n        return OutputList(result_elements)\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    intersperse_service = IntersperseFunction()\n    intersperse_service.validate_inputs(numbers, delimeter)\n    output_list_obj = intersperse_service.execute(numbers, delimeter)\n    return output_list_obj.to_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/3": [{"task_id": "HumanEval/3", "solution": "from typing import List\nclass Account:\n    def __init__(self) -> None:\n        self.balance: int = 0\n    def initialize(self) -> None:\n        \"\"\"Initializes the account balance to zero.\"\"\"\n        self.balance = 0\n    def applyOperation(self, amount: int) -> None:\n        \"\"\"Applies a deposit or withdrawal amount to the balance.\"\"\"\n        self.balance += amount\n    def isNegative(self) -> bool:\n        \"\"\"Checks if the current account balance is below zero.\"\"\"\n        return self.balance < 0\nclass Operation:\n    def __init__(self, amount: int, sequence: int) -> None:\n        self.amount: int = amount\n        self.sequence: int = sequence\nclass OperationsProcessor:\n    def __init__(self) -> None:\n        self.account = Account()\n    def process(self, operations: List[int]) -> bool:\n        \"\"\"Processes a list of operations to detect if the account balance falls below zero.\"\"\"\n        self.account.initialize()\n        for idx, amt in enumerate(operations):\n            op = Operation(amt, idx)\n            self.account.applyOperation(op.amount)\n            if self.account.isNegative():\n                return True\n        return False\ndef below_zero(operations: List[int]) -> bool:\n  