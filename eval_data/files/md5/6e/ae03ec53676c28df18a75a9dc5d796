{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Bell number, which represents the number of partitions of a set with n elements.\n    Uses the Bell triangle method with O(n^2) time complexity.\n    \"\"\"\n    if n == 0:\n        return 1\n    \n    # Initialize the first row of the Bell triangle, which contains B(0,0)\n    row = [1]\n    \n    # Iterate to build the triangle up to the nth row\n    for i in range(1, n + 1):\n        # The first element of the new row is the last element of the previous row\n        new_row = [row[-1]]\n        # Compute subsequent elements using the sum of the element to its left in the new row\n        # and the element diagonally above it in the previous row.\n        for j in range(1, i + 1):\n            new_row.append(new_row[-1] + row[j - 1])\n        row = new_row\n        \n    # The nth Bell number is the first element of the nth row of the Bell triangle (B_n = B(n,0))\n    # or alternatively, the last element of the (n-1)th row, B(n-1, n-1), which becomes B(n,0)\n    # in the next iteration. In this implementation, row[0] for the final row is B_n.\n    return row[0]"}
{"task_id": "Mbpp/65", "solution": "from collections.abc import Iterable\n\ndef recursive_list_sum(data):\n    \"\"\"\n    Flattens a nested list or iterable and sums all numeric elements.\n    Non-numeric items and strings are ignored.\n    \"\"\"\n    total_sum = 0.0\n    stack = [data]\n\n    while stack:\n        current_item = stack.pop()\n\n        # Check if the current_item is an iterable (but not a string or bytes)\n        if isinstance(current_item, Iterable) and not isinstance(current_item, (str, bytes)):\n            # If it's an iterable, add its elements to the stack in reverse order\n            # to process elements in their original sequence (depth-first).\n            for element in reversed(list(current_item)):\n                stack.append(element)\n        # If it's not an iterable (or it's a string/bytes), check if it's a number.\n        elif isinstance(current_item, (int, float)):\n            # If it's an integer or float, add it to the total sum.\n            total_sum += current_item\n        # Other types (e.g., strings, None) are implicitly ignored as per the problem context.\n\n    return total_sum"}
{"task_id": "Mbpp/68", "solution": "from typing import Sequence, Any, Iterator, Optional\nimport logging\n\nclass MonotonicError(Exception):\n    \"\"\"Exception raised for errors in monotonic checks or invalid input.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass LoggerConfig:\n    \"\"\"Configures and provides logger instances.\"\"\"\n    DEFAULT_LEVEL = logging.INFO\n\n    @staticmethod\n    def get_logger(name: str = \"monotonic\") -> logging.Logger:\n        \"\"\"Returns a configured logger with a stream handler.\"\"\"\n        logger = logging.getLogger(name)\n        if not logger.handlers:\n            logger.setLevel(LoggerConfig.DEFAULT_LEVEL)\n            handler = logging.StreamHandler()\n            formatter = logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n            handler.setFormatter(formatter)\n            logger.addHandler(handler)\n        return logger\n\nclass Validators:\n    \"\"\"Utility class for input validation.\"\"\"\n    @staticmethod\n    def is_sequence(obj: Any) -> bool:\n        \"\"\"Checks if an object is a list or tuple, but not a string.\"\"\"\n        return isinstance(obj, (list, tuple)) and not isinstance(obj, (str, bytes))\n\n    @staticmethod\n    def is_numeric_sequence(seq: Sequence[Any]) -> bool:\n        \"\"\"Checks if all elements in a sequence are numeric (int or float).\"\"\"\n        if not Validators.is_sequence(seq):\n            return False\n        for item in seq:\n            if not isinstance(item, (int, float)):\n                return False\n        return True\n\nclass ArrayModel:\n    \"\"\"Wraps and validates an input sequence of numbers.\"\"\"\n    def __init__(self, values: Sequence[int | float]) -> None:\n        if not Validators.is_sequence(values):\n            raise MonotonicError(\"Input must be a sequence (list or tuple).\")\n        if not Validators.is_numeric_sequence(values):\n            raise MonotonicError(\"All elements in the sequence must be numeric (int or float).\")\n        self.values: list[float] = [float(v) for v in values]\n\n    def __len__(self) -> int:\n        return len(self.values)\n\n    def __iter__(self) -> Iterator[float]:\n        return iter(self.values)\n\n    def as_list(self) -> list[float]:\n        \"\"\"Returns a copy of the internal list of float values.\"\"\"\n        return list(self.values)\n\nclass MonotonicResult:\n    \"\"\"Data transfer object for the result of a monotonicity check.\"\"\"\n    def __init__(self, is_monotonic: bool, trend: Optional[str]) -> None:\n        self.is_monotonic = is_monotonic\n        self.trend = trend\n\n    def to_dict(self) -> dict:\n        \"\"\"Returns the result as a dictionary.\"\"\"\n        return {\"is_monotonic\": self.is_monotonic, \"trend\": self.trend}\n\nclass MonotonicChecker:\n    \"\"\"Core algorithm for checking if an array is monotonic.\"\"\"\n    def __init__(self, logger: logging.Logger) -> None:\n        self._logger = logger\n\n    def is_monotonic(self, arr: ArrayModel) -> MonotonicResult:\n        \"\"\"Determines if the array is monotonically nonincreasing or nondecreasing.\"\"\"\n        vals = arr.as_list()\n        n = len(vals)\n        self._logger.debug(f\"Checking sequence of length {n}.\")\n\n        if n <= 2:\n            return MonotonicResult(True, None)\n\n        noninc = True\n        nondec = True\n        prev = vals[0]\n\n        for cur in vals[1:]:\n            if cur < prev:\n                nondec = False\n            if cur > prev:\n                noninc = False\n            prev = cur\n            \n            if not noninc and not nondec:\n                self._logger.debug(\"Sequence is neither nonincreasing nor nondecreasing.\")\n                return MonotonicResult(False, None)\n        \n        trend = \"nonincreasing\" if noninc else \"nondecreasing\"\n        self._logger.debug(f\"Sequence is monotonic with trend: {trend}.\")\n        return MonotonicResult(True, trend)\n\ndef is_Monotonic(arr: Sequence[int | float]) -> bool:\n    \"\"\"\n    Checks whether the given array (sequence of numbers) is monotonic.\n    A sequence is monotonic if it is either monotonically nonincreasing or nondecreasing.\n    \"\"\"\n    logger = LoggerConfig.get_logger(\"monotonic\")\n    \n    # ArrayModel performs input validation and type conversion.\n    array_model = ArrayModel(arr)\n    \n    checker = MonotonicChecker(logger)\n    result = checker.is_monotonic(array_model)\n    return result.is_monotonic"}
{"task_id": "Mbpp/70", "solution": "from typing import Iterable, Tuple, Iterator, Any\n\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input to the tuple length functions.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass TupleCollection:\n    \"\"\"Encapsulates an iterable of tuples and provides lazy access to their lengths.\"\"\"\n    def __init__(self, tuples: Iterable[Tuple[Any, ...]]) -> None:\n        self._tuples = tuples\n\n    def __iter__(self) -> Iterator[Tuple[Any, ...]]:\n        for t in self._tuples:\n            yield t\n\n    def lengths(self) -> Iterator[int]:\n        \"\"\"Yields the length of each tuple in the collection.\"\"\"\n        for t in self._tuples:\n            yield len(t)\n\nclass TupleValidator:\n    \"\"\"Validates that the input is an iterable of tuples.\"\"\"\n    ERROR_MSG_INVALID_INPUT = \"Input must be an iterable of tuples\"\n\n    def validate_iterable_of_tuples(self, tuples: Iterable[Any]) -> None:\n        \"\"\"Raises InvalidInputError if input is not a valid iterable of tuples.\"\"\"\n        if tuples is None:\n            raise InvalidInputError(self.ERROR_MSG_INVALID_INPUT)\n        try:\n            iterator = iter(tuples)\n        except TypeError:\n            raise InvalidInputError(self.ERROR_MSG_INVALID_INPUT)\n        # Check the type of the first element if available without exhausting a generator.\n        try:\n            first_item = next(iterator)\n            if not isinstance(first_item, tuple):\n                raise InvalidInputError(\"Element at index 0 is not a tuple\")\n        except StopIteration:\n            pass # Empty iterable is valid.\n\n\nclass TupleLengthService:\n    \"\"\"Provides the core algorithm to check if all tuples in an iterable have equal length.\"\"\"\n    def __init__(self, validator: TupleValidator) -> None:\n        self._validator = validator\n\n    def all_equal(self, tuples: Iterable[Tuple[Any, ...]]) -> bool:\n        \"\"\"Determines if all given tuples have equal length. Handles empty and single-tuple cases.\"\"\"\n        self._validator.validate_iterable_of_tuples(tuples)\n        collection = TupleCollection(tuples)\n        it = collection.lengths()\n        try:\n            first_length = next(it)\n        except StopIteration:\n            return True  # Empty iterable or single element are considered equal.\n        for length in it:\n            if length != first_length:\n                return False\n        return True\n\n# Initialize default validator and service instances for the convenience function.\n_default_validator = TupleValidator()\n_default_service = TupleLengthService(_default_validator)\n\ndef get_equal(tuples: Iterable[Tuple[Any, ...]]) -> bool:\n    \"\"\"\n    Checks if all tuples in the given iterable have equal length.\n    Returns True for empty or single-tuple iterables.\n    \"\"\"\n    return _default_service.all_equal(tuples)"}
{"task_id": "Mbpp/69", "solution": "from typing import List, Any\n\ndef is_sublist(main_list: List[Any], sub_list: List[Any]) -> bool:\n    \"\"\"\n    Checks if a sublist is a contiguous subsequence of a main list using the KMP algorithm.\n    Returns True if the sublist is found, False otherwise.\n    \"\"\"\n    len_main = len(main_list)\n    len_sub = len(sub_list)\n\n    if len_sub == 0:\n        return True\n\n    if len_sub > len_main:\n        return False\n\n    def _compute_lps(pattern: List[Any]) -> List[int]:\n        \"\"\"Computes the Longest Proper Prefix which is also Suffix (LPS) array for KMP.\"\"\"\n        lps = [0] * len(pattern)\n        length = 0\n        i = 1\n        while i < len(pattern):\n            if pattern[i] == pattern[length]:\n                length += 1\n                lps[i] = length\n                i += 1\n            else:\n                if length != 0:\n                    length = lps[length - 1]\n                else:\n                    lps[i] = 0\n                    i += 1\n        return lps\n\n    lps = _compute_lps(sub_list)\n\n    i = 0  # index for main_list\n    j = 0  # index for sub_list\n\n    while i < len_main:\n        if main_list[i] == sub_list[j]:\n            i += 1\n            j += 1\n\n        if j == len_sub:\n            return True\n        elif i < len_main and main_list[i] != sub_list[j]:\n            if j != 0:\n                j = lps[j - 1]\n            else:\n                i += 1\n    \n    return False"}
