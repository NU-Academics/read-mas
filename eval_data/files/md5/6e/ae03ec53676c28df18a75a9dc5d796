{"task_id": "Mbpp/603", "solution": "import collections\n\ndef get_ludic(n: int, cache_file: str | None = None) -> list[int]:\n    \"\"\"\n    Computes all ludic numbers less than or equal to a given integer n.\n    The Ludic sieve starts with natural numbers and removes every k-th remaining number, where k is the next ludic number found.\n    \"\"\"\n    # Per instructions, no explicit validation for n is performed; assuming n >= 1.\n    if n <= 0:\n        return []\n\n    numbers = collections.deque(range(1, n + 1))\n    ludic_numbers = []\n\n    while numbers:\n        current_ludic = numbers.popleft()\n        ludic_numbers.append(current_ludic)\n\n        # For the first ludic number (1), no elements are removed from the remaining sequence.\n        # Otherwise, remove every current_ludic-th element from the 1-based indexed remaining sequence.\n        if current_ludic > 1:\n            filtered_numbers = collections.deque()\n            count = 0\n            for num in numbers:\n                count += 1\n                if count % current_ludic != 0:\n                    filtered_numbers.append(num)\n            numbers = filtered_numbers\n\n    # The cache_file parameter is part of the function signature as per design but unused in this monolithic implementation.\n    return ludic_numbers"}
{"task_id": "Mbpp/607", "solution": "import re\nimport sys\nfrom typing import Optional, Tuple\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass RegexCompilationError(ValidationError):\n    \"\"\"Exception raised when a regex pattern fails to compile.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass Logger:\n    \"\"\"A minimal logger for the string search library.\"\"\"\n    def __init__(self, name: str = \"stringsearch\", level: str = \"INFO\"):\n        self.name = name\n        self.level_map = {\"DEBUG\": 0, \"INFO\": 1, \"ERROR\": 2}\n        self.current_level = self.level_map.get(level.upper(), 1)\n\n    def _log(self, msg: str, level: str, level_val: int) -> None:\n        if level_val >= self.current_level:\n            print(f\"[{level}] {self.name}: {msg}\", file=sys.stderr)\n\n    def debug(self, msg: str) -> None:\n        self._log(msg, \"DEBUG\", 0)\n\n    def info(self, msg: str) -> None:\n        self._log(msg, \"INFO\", 1)\n\n    def error(self, msg: str) -> None:\n        self._log(msg, \"ERROR\", 2)\n\ndef validate_text(text: str) -> None:\n    \"\"\"Validates that the input text is a non-empty string.\"\"\"\n    if not isinstance(text, str) or not text:\n        raise ValidationError(\"Text must be a non-empty string.\")\n\ndef validate_pattern(pattern: str) -> None:\n    \"\"\"Validates that the input pattern is a non-empty string.\"\"\"\n    if not isinstance(pattern, str) or not pattern:\n        raise ValidationError(\"Pattern must be a non-empty string.\")\n\nclass SearchResult:\n    \"\"\"DTO representing a regex match, its start, and end indices.\"\"\"\n    def __init__(self, match: str, start: int, end: int):\n        self.match = match\n        self.start = start\n        self.end = end\n\n    def to_tuple(self) -> Tuple[str, int, int]:\n        \"\"\"Converts the SearchResult object to a tuple.\"\"\"\n        return (self.match, self.start, self.end)\n\n    def __repr__(self) -> str:\n        return f\"SearchResult(match='{self.match}', start={self.start}, end={self.end})\"\n\nclass RegexAdapter:\n    \"\"\"Encapsulates regex operations using Python's re module.\"\"\"\n    def __init__(self, flags: int = 0, logger: Logger = None):\n        self._flags = flags\n        self.logger = logger if logger else Logger()\n\n    def compile_pattern(self, pattern: str) -> re.Pattern:\n        \"\"\"Compiles a regex pattern, raising a custom error on failure.\"\"\"\n        try:\n            self.logger.debug(f\"RegexAdapter: Compiling pattern: '{pattern}' with flags: {self._flags}\")\n            return re.compile(pattern, self._flags)\n        except re.error as e:\n            self.logger.error(f\"RegexAdapter: Regex compilation failed for pattern '{pattern}': {e}\")\n            raise RegexCompilationError(f\"Invalid regex pattern: {e}\") from e\n\n    def search(self, text: str, pattern: str) -> SearchResult | None:\n        \"\"\"Searches for the pattern in text, returning a SearchResult or None.\"\"\"\n        validate_text(text)\n        validate_pattern(pattern)\n\n        compiled = self.compile_pattern(pattern)\n        self.logger.debug(f\"RegexAdapter: Searching text for pattern '{pattern}'.\")\n        m = compiled.search(text)\n        if m:\n            result = SearchResult(match=m.group(0), start=m.start(0), end=m.end(0))\n            self.logger.debug(f\"RegexAdapter: Match found: {result}\")\n            return result\n        self.logger.debug(f\"RegexAdapter: No match found for pattern '{pattern}' in text.\")\n        return None\n\nclass SearchService:\n    \"\"\"Orchestrates the search logic, using a RegexAdapter.\"\"\"\n    def __init__(self, adapter: RegexAdapter, logger: Logger = None):\n        self.adapter = adapter\n        self.logger = logger if logger else Logger()\n\n    def search(self, text: str, pattern: str) -> SearchResult | None:\n        \"\"\"Performs a search using the injected regex adapter.\"\"\"\n        self.logger.debug(f\"SearchService: Initiating search for pattern '{pattern}' in text.\")\n        result = self.adapter.search(text, pattern)\n        if result:\n            self.logger.debug(f\"SearchService: Match found: {result}\")\n        else:\n            self.logger.debug(f\"SearchService: No match found.\")\n        return result\n\nclass SearchController:\n    \"\"\"Public API entrypoint, validates inputs and orchestrates search.\"\"\"\n    def __init__(self, service: SearchService, logger: Logger = None):\n        self.service = service\n        self.logger = logger if logger else Logger()\n\n    def find_literals(self, text: str, pattern: str) -> Tuple[str, int, int] | None:\n        \"\"\"Searches for a regex pattern in text and returns the match and indices.\"\"\"\n        self.logger.debug(f\"SearchController: Received request for pattern '{pattern}'.\")\n        search_result = self.service.search(text, pattern)\n        if search_result:\n            self.logger.info(f\"SearchController: Returning match: {search_result.to_tuple()}\")\n            return search_result.to_tuple()\n        self.logger.info(\"SearchController: No match found, returning None.\")\n        return None\n\ndef find_literals(text: str, pattern: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Searches a string for a regex pattern and returns the matching substring, start index, and end index.\n    Returns None if no match is found.\n    \"\"\"\n    logger = Logger()\n    regex_adapter = RegexAdapter(logger=logger)\n    search_service = SearchService(adapter=regex_adapter, logger=logger)\n    search_controller = SearchController(service=search_service, logger=logger)\n\n    return search_controller.find_literals(text, pattern)"}
{"task_id": "Mbpp/610", "solution": "from typing import Sequence, List, TypeVar\n\nT = TypeVar(\"T\")\n\ndef remove_kth_element(lst: Sequence[T], k: int) -> List[T]:\n    \"\"\"\n    Returns a new list with the k'th element removed (k is 1-based index).\n    The original list is not modified.\n    \"\"\"\n    idx = k - 1\n    new_lst = list(lst)\n    new_lst.pop(idx)\n    return new_lst"}
{"task_id": "Mbpp/611", "solution": "from typing import List, Any\n\ndef max_of_nth(matrix: List[List[Any]], n: int) -> Any:\n    \"\"\"\n    Returns the maximum value of the n'th column in a matrix.\n    This assumes the matrix is non-empty, rectangular, and n is a valid column index.\n    \"\"\"\n    return max(row[n] for row in matrix)"}
{"task_id": "Mbpp/612", "solution": "import json\nfrom typing import Any, List, Optional, Sequence, TypeVar\n\nT = TypeVar(\"T\")\n\nclass MergeError(Exception):\n    \"\"\"Custom exception for merge-related errors.\"\"\"\n    def __init__(self, message: str, cause: Optional[Exception] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.cause = cause\n\nclass Utils:\n    \"\"\"Utility methods for sequence detection and JSON handling.\"\"\"\n    JSON_INDENT = 2\n\n    @staticmethod\n    def is_sequence(obj: Any) -> bool:\n        \"\"\"Checks if an object is a sequence (list/tuple) but not a string/bytes.\"\"\"\n        return hasattr(obj, '__iter__') and not isinstance(obj, (str, bytes, bytearray))\n\n    @staticmethod\n    def safe_json_dumps(obj: Any) -> str:\n        \"\"\"Safely dumps an object to a JSON string.\"\"\"\n        try:\n            return json.dumps(obj, ensure_ascii=False, indent=Utils.JSON_INDENT)\n        except (TypeError, ValueError) as e:\n            raise MergeError(\"Unable to JSON-serialize result\", cause=e)\n\n    @staticmethod\n    def safe_json_loads(text: str) -> Any:\n        \"\"\"Safely loads a JSON string into an object.\"\"\"\n        try:\n            return json.loads(text)\n        except Exception as e:\n            raise MergeError(\"Invalid JSON input\", cause=e)\n\nclass MergeResult:\n    \"\"\"Data Transfer Object for merge operation results.\"\"\"\n    def __init__(self, firsts: List[Any], seconds: List[Any]) -> None:\n        self.firsts = firsts\n        self.seconds = seconds\n    \n    def to_list(self) -> List[List[Any]]:\n        \"\"\"Converts the result to a list of two lists.\"\"\"\n        return [self.firsts, self.seconds]\n    \n    def to_json(self) -> str:\n        \"\"\"Converts the result to a JSON string.\"\"\"\n        return Utils.safe_json_dumps(self.to_list())\n\nclass MergeValidator:\n    \"\"\"Validates the input structure for the merge operation.\"\"\"\n    EXPECTED_INNER_LENGTH = 2\n\n    def validate(self, items: Sequence[Sequence[Any]]) -> None:\n        \"\"\"Runs all validation steps on the input items.\"\"\"\n        self._check_outer_iterable(items)\n        self._check_inner_pairs(items)\n\n    def _check_outer_iterable(self, items: Any) -> None:\n        \"\"\"Ensures the input is a sequence.\"\"\"\n        if not Utils.is_sequence(items):\n            raise MergeError(\"Input must be a sequence (e.g., list) of 2-element sequences\")\n\n    def _check_inner_pairs(self, items: Sequence[Sequence[Any]]) -> None:\n        \"\"\"Ensures each inner item is a 2-element sequence.\"\"\"\n        for idx, item in enumerate(items):\n            if not Utils.is_sequence(item):\n                raise MergeError(f\"Item at index {idx} is not a sequence\")\n            if len(item) != self.EXPECTED_INNER_LENGTH:\n                raise MergeError(f\"Item at index {idx} must have length {self.EXPECTED_INNER_LENGTH}, got {len(item)}\")\n\nclass MergeService:\n    \"\"\"Implements the core logic for merging lists of pairs.\"\"\"\n    def __init__(self, validator: Optional[MergeValidator] = None) -> None:\n        self._validator = validator or MergeValidator()\n\n    def merge(self, items: Sequence[Sequence[T]]) -> MergeResult:\n        \"\"\"Validates and merges a sequence of 2-element sequences.\"\"\"\n        self._validator.validate(items)\n        firsts = []\n        seconds = []\n        for item in items:\n            firsts.append(item[0])\n            seconds.append(item[1])\n        return MergeResult(firsts, seconds)\n\nclass MergeController:\n    \"\"\"Controller exposing merge functionality in different formats.\"\"\"\n    def __init__(self, service: Optional[MergeService] = None) -> None:\n        self._service = service or MergeService()\n\n    def merge_to_lists(self, items: Sequence[Sequence[T]]) -> List[List[T]]:\n        \"\"\"Merges items and returns the result as a list of two lists.\"\"\"\n        result = self._service.merge(items)\n        return result.to_list()\n\n    def merge_to_json(self, items: Sequence[Sequence[T]]) -> str:\n        \"\"\"Merges items and returns the result as a JSON string.\"\"\"\n        result = self._service.merge(items)\n        return result.to_json()\n\n_default_controller = MergeController()\n\ndef merge(items: Sequence[Sequence[T]]) -> List[List[T]]:\n    \"\"\"\n    Merges a list of 2-element sublists into two separate lists.\n    The first returned list contains all first elements, the second contains all second elements.\n    \"\"\"\n    return _default_controller.merge_to_lists(items)"}
{"task_id": "Mbpp/614", "solution": "from typing import List, Tuple\n\ndef flatten_tuples(tuples: List[Tuple[int, ...]]) -> List[int]:\n    \"\"\"Flattens a list of tuples of integers into a single list of integers.\"\"\"\n    flat = []\n    for t in tuples:\n        flat.extend(list(t))\n    return flat\n\ndef cummulative_sum(tuple_list: List[Tuple[int, ...]]) -> int:\n    \"\"\"\n    Calculates the cumulative sum of all integers in a list of tuples.\n    Assumes input is a valid list of tuples containing only integers.\n    \"\"\"\n    flat_numbers = flatten_tuples(tuple_list)\n    return sum(flat_numbers)"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo between two tuples of the same length.\n    Assumes inputs are tuples of integers and have matching lengths.\n    \"\"\"\n    return tuple(x % y for x, y in zip(a, b))"}
{"task_id": "Mbpp/619", "solution": "def move_num(s: str) -> str:\n    \"\"\"\n    Moves all numeric characters to the end of the string, preserving relative order.\n    \"\"\"\n    non_digits = []\n    digits = []\n    for char in s:\n        if char.isdigit():\n            digits.append(char)\n        else:\n            non_digits.append(char)\n    return \"\".join(non_digits) + \"\".join(digits)"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(data: tuple[tuple[int | float, ...], ...]) -> list[float]:\n    \"\"\"\n    Calculates the average value for each position across a tuple of tuples.\n    Assumes a non-empty tuple of non-empty, equal-length inner tuples containing numbers.\n    \"\"\"\n    if not data:\n        return []\n\n    num_columns = len(data[0])\n    num_rows = len(data)\n\n    column_sums = [0.0] * num_columns\n\n    for row in data:\n        for i, value in enumerate(row):\n            column_sums[i] += float(value)\n\n    averages = [s / num_rows for s in column_sums]\n\n    return averages"}
{"task_id": "Mbpp/620", "solution": "```python\nfrom typing import List\n\ndef largest_subset(nums: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible.\n    Uses dynamic programming, sorting the input numbers first.\n    \"\"\"\n    if not nums:\n        return 0\n\n    nums_sorted = sorted(nums)\n    n = len(nums_sorted)\n    dp = [1] * n  # dp[i] stores the length of the largest divisible subset ending with nums_sorted[i]\n\n    max_length = 0\n    for i in range(n):\n        for j in range(i):\n            if nums_sorted[i] % nums_sorted[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n        max_length = max(max_length, dp[i])\n    \n    return max_length\n```"}
{"task_id": "Mbpp/618", "solution": "from typing import Iterable, List, Any, Sequence\n\nclass DivisionError(Exception):\n    pass\n\nclass LengthMismatchError(DivisionError):\n    def __init__(self, len_a: int, len_b: int) -> None:\n        super().__init__(f\"Length mismatch: {len_a} != {len_b}\")\n        self.len_a = len_a\n        self.len_b = len_b\n\nclass DivisionByZeroError(DivisionError):\n    def __init__(self, index: int) -> None:\n        super().__init__(f\"Division by zero at index {index}\")\n        self.index = index\n\nclass InvalidElementError(DivisionError):\n    def __init__(self, index: int, value: object) -> None:\n        super().__init__(f\"Invalid element at index {index}: {value!r}\")\n        self.index = index\n        self.value = value\n\ndef _parse_number(value: Any, index: int) -> float:\n    \"\"\"Converts a value to float, raising InvalidElementError if conversion fails.\"\"\"\n    try:\n        return float(value)\n    except (ValueError, TypeError):\n        raise InvalidElementError(index, value)\n\ndef _to_float_list(values: Iterable[Any]) -> List[float]:\n    \"\"\"Converts an iterable of values to a list of floats, raising InvalidElementError on invalid elements.\"\"\"\n    float_list = []\n    for i, v in enumerate(values):\n        float_list.append(_parse_number(v, i))\n    return float_list\n\ndef _validate_lengths(a: Sequence[Any], b: Sequence[Any]) -> None:\n    \"\"\"Raises LengthMismatchError if the lengths of the two sequences are not equal.\"\"\"\n    if len(a) != len(b):\n        raise LengthMismatchError(len(a), len(b))\n\ndef div_list(a: List[Any], b: List[Any]) -> List[float]:\n    \"\"\"Divides two lists element-wise, returning a list of floats.\"\"\"\n    _validate_lengths(a, b)\n\n    float_a = _to_float_list(a)\n    float_b = _to_float_list(b)\n\n    results = []\n    for i in range(len(float_a)):\n        numerator = float_a[i]\n        denominator = float_b[i]\n\n        if denominator == 0.0:\n            raise DivisionByZeroError(i)\n        \n        results.append(numerator / denominator)\n    return results"}
