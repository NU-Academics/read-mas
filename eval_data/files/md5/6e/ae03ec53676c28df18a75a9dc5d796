{"task_id": "Mbpp/125", "solution": "import collections\n\ndef find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring.\n    This uses Kadane's algorithm by transforming '0' to +1 and '1' to -1.\n    \"\"\"\n    max_so_far = 0\n    current_max = 0\n\n    for char in s:\n        if char == '0':\n            current_max += 1\n        else: # char == '1'\n            current_max -= 1\n        \n        # If current_max becomes negative, reset it to 0\n        # as a negative sum means starting a new subarray from this point might yield a better result.\n        if current_max < 0:\n            current_max = 0\n        \n        # Update max_so_far if current_max is greater\n        max_so_far = max(max_so_far, current_max)\n            \n    # If max_so_far is still 0 after the loop, it means all prefixes had negative sums\n    # or the string was empty.\n    # In such a case, the largest difference is the largest single element value.\n    # This specifically handles cases like \"111\" where max_so_far would be 0,\n    # but the max difference is -1 (for any single '1').\n    if max_so_far == 0:\n        # Check if the string contains any '0's. If it does, max_so_far would have been at least 1.\n        # If no '0's, then the max difference will be -count('1').\n        # If the string contains '0's but still `max_so_far` is 0, it means '0's are always\n        # outnumbered by '1's in any substring that starts with a '0' and extends to its right.\n        # This condition is typically handled by standard Kadane if allowing all-negative subarrays.\n        # The prompt implies a non-empty string per design and the \"1\" -> -1 mapping.\n        \n        # To handle cases like \"111\", where the difference is -1,\n        # we need a slightly modified Kadane if we always reset current_max to 0.\n        # The true Kadane handles all-negative arrays by returning the largest single element.\n        # Let's re-evaluate `weights` for the strict Kadane variant.\n        \n        # Re-applying Kadane's logic for potentially all-negative sums\n        # where the max_so_far should be the maximum element itself\n        # if all sums are negative.\n        \n        # The provided example \"11000010001\" has a positive difference.\n        # Let's consider the initial simple Kadane implementation, which is suitable for\n        # problems where we seek a positive sum.\n        # For the \"maximum difference between 0s and 1s\" where 0s give +1 and 1s give -1,\n        # a string like \"111\" would produce weights [-1, -1, -1].\n        # The simple Kadane above (resetting to 0) would yield 0.\n        # However, the largest difference for \"111\" is -1 (from any single '1' substring).\n        \n        # To correctly handle cases where the maximum difference is negative,\n        # we need the traditional Kadane's algorithm that allows max_so_far to be negative\n        # if all possible sums are negative.\n        \n        # Rewriting using standard Kadane that accounts for all negative sums\n        max_so_far = float('-inf')\n        current_max = 0\n        \n        # This flag helps distinguish between an empty string, or a string of all 1s\n        # from a string like \"0\".\n        has_elements = False \n\n        for char in s:\n            has_elements = True\n            val = 1 if char == '0' else -1\n            current_max += val\n            \n            if current_max > max_so_far:\n                max_so_far = current_max\n            \n            # If current_max becomes negative, reset it to 0\n            # for the next iteration to consider a new subarray.\n            # This version finds the max sum of a non-empty subarray,\n            # or 0 if all sums are negative.\n            # To correctly handle all negative elements (e.g., \"111\" -> [-1,-1,-1]),\n            # where the result should be the largest individual element (-1),\n            # the reset condition needs to be current_max < 0.\n            # If we reset current_max = 0 always, we might miss negative maximums.\n            if current_max < 0:\n                current_max = 0\n        \n        if not has_elements: # Empty string edge case, though design implies non-empty.\n            return 0 # Or raise InvalidInputError based on FR1.\n            \n        # The above loop with `current_max = 0` if `current_max < 0`\n        # means `max_so_far` will always be >= 0.\n        # This is for \"maximum sum of a contiguous subarray, where empty subarray sum is 0\".\n        # If we must return the actual max difference, including negative values,\n        # for a string like \"111\", max_so_far would be 0. But the answer is -1.\n        \n        # Let's use the Kadane version specified in `utils.py` snippet (if it were inline):\n        # kadane_max_sum(weights) in design:\n        # if max_ending is None: max_ending = w; max_so_far = w\n        # else: max_ending = max(w, max_ending + w); max_so_far = max(max_so_far, max_ending)\n        # This version correctly handles all-negative arrays by returning max single element.\n\n        max_ending_here = 0\n        max_so_far_correct_kadane = float('-inf')\n        \n        if not s: # Handle empty string specifically, though FR1 implies non-empty.\n            return 0\n            \n        first_element_processed = False\n        for char in s:\n            val = 1 if char == '0' else -1\n            \n            if not first_element_processed:\n                max_ending_here = val\n                max_so_far_correct_kadane = val\n                first_element_processed = True\n            else:\n                max_ending_here = max(val, max_ending_here + val)\n                max_so_far_correct_kadane = max(max_so_far_correct_kadane, max_ending_here)\n                \n    return max_so_far_correct_kadane"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix):\n    \"\"\"\n    Calculates whether the given square matrix is a magic square.\n    A magic square is a square matrix where the sums of every row, every column,\n    and both main diagonals are equal.\n    \"\"\"\n    n = len(matrix)\n\n    if n == 0:\n        return True # An empty matrix can be considered trivially a magic square, or handle as per spec.\n                    # Given the assert, it implies non-empty inputs. If empty is truly an edge case for \"no checks\",\n                    # it could return True. Let's assume non-empty inputs for the problem context.\n                    # Or, more strictly, return False if not meaningfully square, but the assert implies proper inputs.\n                    # For this problem's prompt, sticking to the assert's context is best.\n\n    # Check if it's a square matrix\n    for row in matrix:\n        if len(row) != n:\n            return False\n\n    # Calculate the target sum from the first row\n    target_sum = sum(matrix[0])\n\n    # Check row sums\n    for i in range(n):\n        if sum(matrix[i]) != target_sum:\n            return False\n\n    # Check column sums\n    for j in range(n):\n        col_sum = 0\n        for i in range(n):\n            col_sum += matrix[i][j]\n        if col_sum != target_sum:\n            return False\n\n    # Check primary diagonal sum\n    diag1_sum = 0\n    for i in range(n):\n        diag1_sum += matrix[i][i]\n    if diag1_sum != target_sum:\n        return False\n\n    # Check secondary diagonal sum\n    diag2_sum = 0\n    for i in range(n):\n        diag2_sum += matrix[i][n - 1 - i]\n    if diag2_sum != target_sum:\n        return False\n\n    return True"}
{"task_id": "Mbpp/130", "solution": "import collections\nfrom typing import Any, List, Dict\n\ndef max_occurrences(items: List[Any]) -> Any:\n    # Helper function to find the first occurring item among tied items in the original list order.\n    def stable_first_when_tie_inline(original_order_items: List[Any], tied_items: List[Any]) -> Any:\n        tied_set = set(tied_items)\n        for it in original_order_items:\n            if it in tied_set:\n                return it\n        # Fallback if for some reason no tied item found in original list (should not happen in normal flow).\n        return tied_items[0] if tied_items else None\n\n    # If the input list is empty, return None as per implicit requirement to not raise exceptions for edge cases.\n    if not items:\n        return None\n\n    counts: Dict[Any, int] = collections.defaultdict(int)\n    # Track items in their original order of appearance for stable tie-breaking.\n    first_seen_unique: List[Any] = []\n    seen_items_set: set = set()\n\n    for item in items:\n        if item not in seen_items_set:\n            first_seen_unique.append(item)\n            seen_items_set.add(item)\n        counts[item] += 1\n\n    # Determine the maximum frequency found.\n    max_count = max(counts.values())\n\n    # Find all items that share this maximum frequency.\n    tie_items: List[Any] = [k for k, v in counts.items() if v == max_count]\n\n    # Apply tie-breaking rules if multiple items have the same maximum frequency.\n    if len(tie_items) == 1:\n        return tie_items[0]\n    else:\n        chosen_item: Any\n        try:\n            # Attempt to choose the minimum item if they are all comparable.\n            chosen_item = min(tie_items)\n        except TypeError:\n            # If items are not comparable (e.g., mixed types), choose the first one encountered.\n            chosen_item = stable_first_when_tie_inline(first_seen_unique, tie_items)\n        except Exception:\n            # Catch other potential exceptions during min() comparison and fall back to first seen.\n            chosen_item = stable_first_when_tie_inline(first_seen_unique, tie_items)\n        return chosen_item"}
{"task_id": "Mbpp/133", "solution": "from typing import Iterable, Any, Iterator\n\nclass Validator:\n    \"\"\"Helper for validating iterables and elements.\"\"\"\n    @staticmethod\n    def _is_number(value: Any) -> bool:\n        \"\"\"Checks if a value is an int or float, but not a bool.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    @staticmethod\n    def validate_iterable(numbers: Any) -> Iterable[float]:\n        \"\"\"Validates that the input is an iterable of numbers, yielding elements as floats.\"\"\"\n        if Validator._is_number(numbers):\n            return (float(numbers) for _ in (0,)) # Treat single numeric as single-element iterable\n        try:\n            iterator = iter(numbers)\n        except TypeError as e:\n            raise TypeError(\"Input is not iterable\") from e\n\n        def gen() -> Iterator[float]:\n            for idx, v in enumerate(iterator):\n                if not Validator._is_number(v):\n                    raise TypeError(f\"Element at index {idx} is not a number: {repr(v)}\")\n                yield float(v)\n        return gen()\n\nclass NegativeNumberSumService:\n    \"\"\"Service to calculate the sum of negative numbers in an iterable.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def sum_negatives(self, numbers: Iterable[float]) -> float:\n        \"\"\"Calculates the sum of all negative numbers in the given iterable.\"\"\"\n        validated = Validator.validate_iterable(numbers)\n        total = 0.0\n        for n in validated:\n            if n < 0:\n                total += float(n)\n        return total\n\ndef sum_negativenum(numbers):\n    \"\"\"Calculates the sum of negative numbers from a given list of numbers.\"\"\"\n    svc = NegativeNumberSumService()\n    return svc.sum_negatives(numbers)"}
