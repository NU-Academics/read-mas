{"task_id": "Mbpp/448", "solution": "from typing import Iterator, Tuple, Optional\nfrom abc import ABC, abstractmethod\n\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\n\ndef validate_non_negative_int(n: int) -> None:\n    \"\"\"Validates that n is an integer and non-negative.\"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise InvalidInputError(\"n must be integer >= 0\")\n\nPERRIN_BASE = {0: 3, 1: 0, 2: 2}\n\nclass PerrinSequence:\n    \"\"\"Computes Perrin numbers using an iterative, memoized approach.\"\"\"\n    def __init__(self) -> None:\n        self._memo = dict(PERRIN_BASE)\n\n    def get(self, n: int) -> int:\n        \"\"\"Returns the n-th Perrin number.\"\"\"\n        if n < 0:\n            raise InvalidInputError(\"n must be non-negative for Perrin sequence.\")\n        if n in self._memo:\n            return self._memo[n]\n        for i in range(3, n + 1):\n            if i not in self._memo:\n                self._memo[i] = self._memo[i - 2] + self._memo[i - 3]\n        return self._memo[n]\n\n    def sequence_iter(self, n: int) -> Iterator[Tuple[int, int]]:\n        \"\"\"Yields (index, value) for Perrin numbers from P(0) to P(n).\"\"\"\n        for i in range(0, n + 1):\n            yield i, self.get(i)\n\nclass CacheRepository(ABC):\n    \"\"\"Abstract base class defining the cache interface.\"\"\"\n    @abstractmethod\n    def get_sum(self, n: int) -> Optional[int]:\n        pass\n\n    @abstractmethod\n    def get_value(self, n: int) -> Optional[int]:\n        pass\n\n    @abstractmethod\n    def set(self, n: int, value: int, cumulative_sum: int) -> None:\n        pass\n\n    @abstractmethod\n    def close(self) -> None:\n        pass\n\nclass InMemoryCacheRepository(CacheRepository):\n    \"\"\"An in-memory implementation of the CacheRepository.\"\"\"\n    def __init__(self) -> None:\n        self._value_cache: dict[int, int] = {}\n        self._sum_cache: dict[int, int] = {}\n\n    def get_sum(self, n: int) -> Optional[int]:\n        return self._sum_cache.get(n)\n\n    def get_value(self, n: int) -> Optional[int]:\n        return self._value_cache.get(n)\n\n    def set(self, n: int, value: int, cumulative_sum: int) -> None:\n        self._value_cache[n] = value\n        self._sum_cache[n] = cumulative_sum\n\n    def close(self) -> None:\n        pass\n\nclass PerrinService:\n    \"\"\"Orchestrates Perrin number computation and caching.\"\"\"\n    def __init__(self, sequence: PerrinSequence, cache: CacheRepository) -> None:\n        self.sequence = sequence\n        self.cache = cache\n\n    def sum_upto(self, n: int) -> int:\n        \"\"\"Calculates the sum of Perrin numbers from P(0) to P(n), utilizing cache.\"\"\"\n        cached_sum = self.cache.get_sum(n)\n        if cached_sum is not None:\n            return cached_sum\n        \n        cumulative = 0\n        for i, v in self.sequence.sequence_iter(n):\n            cumulative += v\n            self.cache.set(i, v, cumulative)\n        return cumulative\n\nclass APIFacade:\n    \"\"\"Provides a simple API for Perrin number calculations.\"\"\"\n    def __init__(self, service: PerrinService) -> None:\n        self.service = service\n\n    def cal_sum(self, n: int) -> int:\n        \"\"\"Calculates the sum of Perrin numbers up to n.\"\"\"\n        validate_non_negative_int(n)\n        return self.service.sum_upto(n)\n\n_default_service = PerrinService(PerrinSequence(), InMemoryCacheRepository())\n_default_api = APIFacade(_default_service)\n\ndef cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from P(0) to P(n).\"\"\"\n    return _default_api.cal_sum(n)"}
