{"task_id": "Mbpp/294", "solution": "from typing import Any, Optional, Sequence, Union\nfrom decimal import Decimal, InvalidOperation\n\n# Define Number type as per design context\nNumber = Union[int, float, Decimal]\n\ndef max_val(items: Sequence[Any], allow_string_numbers: bool = False, allow_bool: bool = False) -> Optional[Number]:\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list.\n    Non-numeric items are ignored unless `allow_string_numbers` is True for numeric strings.\n    \"\"\"\n\n    def _parse_element(el: Any) -> Optional[Number]:\n        \"\"\"\n        Parses a single element, converting it to a numeric type based on configuration.\n        Returns the numeric value or None if it cannot be converted or should be ignored.\n        \"\"\"\n        if isinstance(el, bool):\n            if allow_bool:\n                return int(el)\n            else:\n                return None  # Exclude boolean values by default\n        \n        if isinstance(el, (int, float, Decimal)):\n            return el  # Already a recognized numeric type\n\n        if allow_string_numbers and isinstance(el, str):\n            try:\n                d = Decimal(el)\n                # If the decimal is an integer, return it as an int for typical usage\n                if d == d.to_integral():\n                    return int(d)\n                return d\n            except InvalidOperation:\n                return None  # String is not a valid number\n        \n        return None  # Non-numeric type and not a numeric string\n\n    numeric_values = []\n    for item in items:\n        parsed_value = _parse_element(item)\n        if parsed_value is not None:\n            numeric_values.append(parsed_value)\n\n    if not numeric_values:\n        return None\n\n    return max(numeric_values)"}
{"task_id": "Mbpp/286", "solution": "import math\n\ndef max_sub_array_sum_repeated(nums: list, n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous array in the modified array\n    formed by repeating the given array k times.\n    \"\"\"\n\n    def _kadane_extended(arr: list, num_repeats: int) -> int:\n        \"\"\"\n        Calculates the maximum subarray sum using Kadane's algorithm over a virtual\n        array formed by repeating `arr` `num_repeats` times.\n        \"\"\"\n        # Initialize with values from the first element of the (virtual) extended array.\n        max_so_far = arr[0]\n        current_max = arr[0]\n\n        # Iterate over the virtual extended array (len(arr) * num_repeats elements)\n        for i in range(1, len(arr) * num_repeats):\n            val = arr[i % len(arr)]\n            current_max = max(val, current_max + val)\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    # Calculate the total sum of the original array.\n    total_sum = sum(nums)\n\n    # If k is 1, simply find the maximum subarray sum in the original array.\n    if k == 1:\n        return _kadane_extended(nums, 1)\n\n    # For k > 1, we need to consider subarrays that span across multiple repetitions.\n    # We first calculate the maximum subarray sum over two concatenated blocks (nums + nums).\n    # This covers subarrays entirely within one block or crossing the boundary once.\n    max_sum_double_block = _kadane_extended(nums, 2)\n\n    # The result is initialized with the sum from two blocks.\n    result = max_sum_double_block\n\n    # If the total sum of the original array is positive and k is greater than 2,\n    # we can potentially add (k-2) full blocks to 'max_sum_double_block' for a larger sum.\n    if total_sum > 0 and k > 2:\n        result = max(result, max_sum_double_block + (k - 2) * total_sum)\n    \n    return result"}
{"task_id": "Mbpp/293", "solution": "import math\n\ndef otherside_rightangle(a: float, b: float, known_hypotenuse: bool = False) -> float:\n    \"\"\"\n    Calculates the third side of a right-angled triangle.\n    Assumes a and b are legs by default; if known_hypotenuse is True, a is treated as the hypotenuse.\n    \"\"\"\n    if not known_hypotenuse:\n        return math.hypot(a, b)\n    else:\n        # a is hypotenuse, b is a leg\n        return math.sqrt(a*a - b*b)"}
{"task_id": "Mbpp/296", "solution": "from typing import List, Tuple, Any, Dict\nfrom uuid import uuid4\nfrom datetime import datetime, timezone\n\n# --- Exceptions ---\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to the inversion counter.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\n# --- Utilities and Constants ---\nDEFAULT_TIMESTAMP_FORMAT = \"%Y-%m-%dT%H:%M:%S%z\"\n\ndef now_iso() -> str:\n    \"\"\"Returns the current UTC time in ISO 8601 format.\"\"\"\n    return datetime.now(timezone.utc).strftime(DEFAULT_TIMESTAMP_FORMAT)\n\ndef validate_array(array: Any) -> List[int]:\n    \"\"\"\n    Validates if the input is an array-like object and converts its elements to integers.\n    Raises InvalidInputError if validation fails.\n    \"\"\"\n    if not isinstance(array, (list, tuple)):\n        raise InvalidInputError(\"Input must be a list or tuple.\")\n    \n    validated_list = []\n    for item in array:\n        try:\n            validated_list.append(int(item))\n        except (ValueError, TypeError) as e:\n            raise InvalidInputError(f\"Array elements must be convertible to integers. Error: {e}\")\n    return validated_list\n\n# --- Models ---\nclass ArrayInput:\n    \"\"\"Represents a validated array input for inversion counting.\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self._values = list(values)\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns a defensive copy of the array values.\"\"\"\n        return list(self._values)\n\nclass InversionResult:\n    \"\"\"Represents the result of an inversion counting operation.\"\"\"\n    def __init__(self, id: str, timestamp: str, input_values: List[int], count: int) -> None:\n        self._id = id\n        self._timestamp = timestamp\n        self._input_values = list(input_values)\n        self._count = count\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Returns the result as a dictionary for persistence.\"\"\"\n        return {\n            \"id\": self._id,\n            \"timestamp\": self._timestamp,\n            \"input\": self._input_values,\n            \"count\": self._count,\n        }\n\n# --- Algorithms ---\nclass InversionAlgorithm:\n    \"\"\"Abstract base class for inversion counting algorithms.\"\"\"\n    def count_inversions(self, arr: List[int]) -> int:\n        raise NotImplementedError(\"Subclasses must implement count_inversions method.\")\n\nclass MergeSortInversionAlgorithm(InversionAlgorithm):\n    \"\"\"\n    Implements the inversion counting algorithm using a modified merge sort.\n    Time complexity: O(n log n), Space complexity: O(n).\n    \"\"\"\n    def count_inversions(self, arr: List[int]) -> int:\n        \"\"\"Counts inversions in the given array.\"\"\"\n        _, count = self._sort_and_count(list(arr))\n        return count\n\n    def _sort_and_count(self, arr: List[int]) -> Tuple[List[int], int]:\n        \"\"\"\n        Recursively sorts the array and counts inversions.\n        Returns a tuple of (sorted_array, inversion_count).\n        \"\"\"\n        n = len(arr)\n        if n <= 1:\n            return arr, 0\n\n        mid = n // 2\n        left_half, left_count = self._sort_and_count(arr[:mid])\n        right_half, right_count = self._sort_and_count(arr[mid:])\n\n        merged_arr, cross_count = self._merge_count(left_half, right_half)\n\n        return merged_arr, left_count + right_count + cross_count\n\n    def _merge_count(self, left: List[int], right: List[int]) -> Tuple[List[int], int]:\n        \"\"\"\n        Merges two sorted arrays and counts cross-inversions.\n        Returns a tuple of (merged_sorted_array, cross_inversion_count).\n        \"\"\"\n        merged = []\n        inversions = 0\n        i, j = 0, 0\n        len_left = len(left)\n        len_right = len(right)\n\n        while i < len_left and j < len_right:\n            if left[i] <= right[j]:\n                merged.append(left[i])\n                i += 1\n            else:\n                merged.append(right[j])\n                inversions += (len_left - i)\n                j += 1\n\n        merged.extend(left[i:])\n        merged.extend(right[j:])\n\n        return merged, inversions\n\n# --- Repository (Minimal, for non-persistence context) ---\nclass InversionRepository:\n    \"\"\"\n    A minimal repository implementation which does not perform actual persistence.\n    Used when persistence is not desired for a function call.\n    \"\"\"\n    def __init__(self, path: str = \"\") -> None:\n        self._path = path\n\n    def persist(self, result: InversionResult) -> None:\n        \"\"\"Does not persist the result.\"\"\"\n        pass\n\n    def load_all(self) -> List[InversionResult]:\n        \"\"\"Returns an empty list as nothing is persisted.\"\"\"\n        return []\n\n# --- Service ---\nclass InversionService:\n    \"\"\"\n    Orchestrates inversion counting, including input validation and optional persistence.\n    \"\"\"\n    def __init__(self, algorithm: InversionAlgorithm, repository: InversionRepository) -> None:\n        self._algorithm = algorithm\n        self._repository = repository\n\n    def count_inversions(self, array: Any, persist: bool = True) -> int:\n        \"\"\"\n        Validates the input array, computes inversions, and optionally persists the result.\n        Raises InvalidInputError for malformed input.\n        \"\"\"\n        validated_values = ArrayInput(validate_array(array)).to_list()\n        count = self._algorithm.count_inversions(validated_values)\n\n        if persist and self._repository:\n            result = InversionResult(str(uuid4()), now_iso(), validated_values, count)\n            self._repository.persist(result)\n\n        return count\n\ndef get_Inv_Count(array: List[int]) -> int:\n    \"\"\"\n    Counts inversions in an array using an O(n log n) merge sort-based algorithm.\n    This helper function does not persist the results.\n    \"\"\"\n    svc = InversionService(\n        algorithm=MergeSortInversionAlgorithm(),\n        repository=InversionRepository()\n    )\n    return svc.count_inversions(array, persist=False)"}
{"task_id": "Mbpp/285", "solution": "import re\nfrom typing import Optional, Tuple, Any\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InputValidator:\n    \"\"\"Validates and normalizes input for the library.\"\"\"\n    def validate(self, text: Any) -> str:\n        if not isinstance(text, str):\n            raise InvalidInputError(f\"Input must be a string, but got {type(text).__name__}.\")\n        return text\n\nclass MatchResult:\n    \"\"\"DTO representing match outcome and optional match span.\"\"\"\n    def __init__(self, found: bool, pattern: str, span: Optional[Tuple[int, int]]) -> None:\n        self.found = found\n        self.pattern = pattern\n        self.span = span\n\n    def to_dict(self) -> dict[str, Any]:\n        \"\"\"Returns a serializable representation of the match result.\"\"\"\n        return {\"found\": self.found, \"pattern\": self.pattern, \"span\": self.span}\n\nclass RegexAdapter:\n    \"\"\"Encapsulates the regex engine with a small compile/search cache.\"\"\"\n    def __init__(self) -> None:\n        self._compiled_cache: dict[str, re.Pattern] = {}\n\n    def compile(self, pattern: str) -> re.Pattern:\n        \"\"\"Compiles a regex pattern and caches it for reuse.\"\"\"\n        if pattern not in self._compiled_cache:\n            self._compiled_cache[pattern] = re.compile(pattern)\n        return self._compiled_cache[pattern]\n\n    def search(self, pattern: re.Pattern, text: str) -> Optional[Tuple[int, int]]:\n        \"\"\"Searches for the pattern in the text and returns its span (start, end) if found.\"\"\"\n        m = pattern.search(text)\n        return (m.start(), m.end()) if m else None\n\nPATTERN: str = r\"a(?:bb|bbb)\"\n\nclass TextMatcherService:\n    \"\"\"Business logic to detect 'a' followed by 2 or 3 'b's.\"\"\"\n    def __init__(self, regex_adapter: RegexAdapter, pattern: str) -> None:\n        self._regex_adapter = regex_adapter\n        self._pattern = pattern\n\n    def matches(self, text: str) -> MatchResult:\n        \"\"\"Checks if the text contains the configured pattern and returns a MatchResult.\"\"\"\n        compiled = self._regex_adapter.compile(self._pattern)\n        span = self._regex_adapter.search(compiled, text)\n        return MatchResult(found=(span is not None), pattern=self._pattern, span=span)\n\n_adapter = RegexAdapter()\n_service = TextMatcherService(_adapter, PATTERN)\n_validator = InputValidator()\n\ndef text_match_two_three(text: str) -> bool:\n    \"\"\"\n    Checks whether a string contains the 'a' character followed by two or three 'b' characters.\n    \"\"\"\n    validated = _validator.validate(text)\n    return _service.matches(validated).found"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list):\n    \"\"\"\n    Flattens a nested list structure into a single flat list.\n    Only lists and tuples are flattened; strings are treated as atomic.\n    \"\"\"\n\n    def _is_list_or_tuple(obj):\n        \"\"\"Helper to check if an object is a list or a tuple.\"\"\"\n        return isinstance(obj, (list, tuple))\n\n    def _flatten_generator(items):\n        \"\"\"Internal generator to recursively yield flattened elements.\"\"\"\n        for elem in items:\n            if _is_list_or_tuple(elem):\n                yield from _flatten_generator(elem)\n            else:\n                yield elem\n\n    return list(_flatten_generator(nested_list))"}
{"task_id": "Mbpp/300", "solution": "def count_binary_seq(n: int) -> int:\n    \"\"\"\n    Calculates the count of binary sequences of length 2n such that\n    the sum of the first n bits equals the sum of the last n bits,\n    which is equivalent to the central binomial coefficient C(2n, n).\n    \"\"\"\n    # Calculate C(2n, n) using the multiplicative formula:\n    # C(N, K) = product_{i=1 to K} (N - K + i) / i\n    # Here, N = 2n and K = n.\n    # So, C(2n, n) = product_{i=1 to n} (2n - n + i) / i = product_{i=1 to n} (n + i) / i\n\n    result = 1\n    # The loop iterates from i = 1 up to n (inclusive).\n    # For n=0, range(1, 1) is empty, so result remains 1, which is C(0,0).\n    for i in range(1, n + 1):\n        result = result * (n + i) // i\n    \n    return result"}
{"task_id": "Mbpp/301", "solution": "from collections.abc import Mapping\n\ndef dict_depth(d: Mapping) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary.\n\n    The depth is defined such that a top-level dictionary has a depth of 1.\n    For example, {} has a depth of 1, and {'a': {'b': {}}} has a depth of 3.\n    Only mapping types (e.g., dict) contribute to increasing the depth.\n    \"\"\"\n    max_depth = 0\n    stack = [(d, 1)]  # Tuple: (current_dict, current_depth)\n\n    while stack:\n        current_dict, depth = stack.pop()\n        max_depth = max(max_depth, depth)\n\n        for value in current_dict.values():\n            if isinstance(value, Mapping):\n                stack.append((value, depth + 1))\n    return max_depth"}
{"task_id": "Mbpp/299", "solution": "from typing import List, Tuple, Dict, Any\n\ndef max_aggregate(records: List[Tuple[str, Any]]) -> Tuple[str, int]:\n    \"\"\"\n    Calculates the maximum aggregate from a list of (name, value) tuples.\n    If there's a tie in aggregate values, the name that is lexicographically smallest is chosen.\n    \"\"\"\n    if not records:\n        return (\"\", 0)\n\n    totals: Dict[str, int] = {}\n    for name, value in records:\n        # Values are coerced to int for aggregation.\n        totals[name] = totals.get(name, 0) + int(value)\n\n    if not totals:\n        return (\"\", 0)\n\n    # Sort items first by total in descending order, then by name in ascending order for tie-breaking.\n    sorted_aggregates = sorted(totals.items(), key=lambda item: (-item[1], item[0]))\n\n    top_name, top_total = sorted_aggregates[0]\n    return (top_name, top_total)"}
{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple\n\nclass StartWithPError(Exception):\n    \"\"\"Custom exception for errors in finding 'p' words.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\ndef _parse_words(line: str) -> List[str]:\n    \"\"\"Splits a line by whitespace into non-empty tokens.\"\"\"\n    return [tok for tok in line.split() if tok]\n\ndef _normalize_word(word: str) -> str:\n    \"\"\"Normalizes a word for comparison (trims whitespace).\"\"\"\n    return word.strip()\n\ndef _is_p_word(word: str) -> bool:\n    \"\"\"Checks if a word starts with 'p' or 'P' (case-insensitive).\"\"\"\n    normalized_word = _normalize_word(word)\n    return len(normalized_word) > 0 and normalized_word[0].lower() == \"p\"\n\ndef start_withp(words: List[str]) -> Tuple[str, str]:\n    \"\"\"\n    Finds exactly two words starting with 'p' (case-insensitive) from a list of strings.\n    Raises StartWithPError if not exactly two words are found.\n    \"\"\"\n    matches: List[str] = []\n    for line in words:\n        for token in _parse_words(line):\n            if _is_p_word(token):\n                matches.append(token)\n                if len(matches) > 2:\n                    # Optimization: exit early if more than two matches found\n                    break\n        if len(matches) > 2:\n            # Optimization: exit early if more than two matches found across lines\n            break\n\n    if len(matches) != 2:\n        raise StartWithPError(f\"Expected 2 words starting with 'p', found {len(matches)}\")\n\n    return (matches[0], matches[1])"}
{"task_id": "Mbpp/306", "solution": "from typing import List\n\ndef max_sum_increasing_subseq(arr: List[float], n: int, i: int, k: int) -> float:\n    # dp[j] stores the maximum sum of an increasing subsequence ending at arr[j]\n    # considering elements from arr[0...j].\n    dp = [0.0] * (i + 1)\n\n    for j in range(i + 1):\n        dp[j] = float(arr[j])\n        for t in range(j):\n            if arr[t] < arr[j] and dp[t] + arr[j] > dp[j]:\n                dp[j] = dp[t] + arr[j]\n\n    best_prefix_sum = 0.0 # Initialize to 0 to allow arr[k] alone if no valid prefix element exists.\n    found_candidate = False\n\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            if not found_candidate or dp[j] > best_prefix_sum:\n                best_prefix_sum = dp[j]\n                found_candidate = True\n    \n    return best_prefix_sum + arr[k]"}
