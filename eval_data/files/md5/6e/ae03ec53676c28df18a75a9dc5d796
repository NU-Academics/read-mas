{"task_id": "Mbpp/238", "solution": "import sys\nfrom typing import Any, Optional, Protocol\n\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input scenarios.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\n\ndef ensure_is_str(s: Any) -> str:\n    \"\"\"Ensures the input is a string, converting bytes to UTF-8 or other types to str.\"\"\"\n    if s is None:\n        raise InvalidInputError(\"Input cannot be None\")\n    if isinstance(s, bytes):\n        try:\n            return s.decode(\"utf-8\")\n        except Exception as e:\n            raise InvalidInputError(\"Bytes input must be UTF-8 decodable\") from e\n    if not isinstance(s, str):\n        return str(s)\n    return s\n\n\ndef normalize_string(s: str) -> str:\n    \"\"\"Normalizes the string by stripping leading/trailing whitespace.\"\"\"\n    return s.strip()\n\n\nclass SubstringCountRequest:\n    \"\"\"DTO for carrying the input string to the SubstringService.\"\"\"\n    def __init__(self, s: str) -> None:\n        self.s: str = s\n\n\nclass CacheRepository(Protocol):\n    \"\"\"Protocol defining the interface for a cache repository.\"\"\"\n    def get(self, key: str) -> Optional[int]:\n        ...\n    def set(self, key: str, value: int) -> None:\n        ...\n\n\nclass SubstringService:\n    \"\"\"Encapsulates the core algorithm for counting substrings and optional caching.\"\"\"\n    def __init__(self, cache_repo: Optional[CacheRepository] = None) -> None:\n        self._cache_repo = cache_repo\n\n    def count_non_empty_substrings(self, request: SubstringCountRequest) -> int:\n        \"\"\"Computes the number of non-empty substrings for the given request string.\"\"\"\n        if request is None or request.s is None:\n            raise InvalidInputError(\"Request and its string must not be None\")\n        key = request.s\n        if self._cache_repo:\n            cached = self._cache_repo.get(key)\n            if cached is not None:\n                return cached\n        n = len(key)\n        result = n * (n + 1) // 2\n        if self._cache_repo:\n            self._cache_repo.set(key, result)\n        return result\n\n\ndef number_of_substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of non-empty substrings of a given string.\n    This function validates and normalizes the input, then delegates to a service.\n    \"\"\"\n    s_valid = ensure_is_str(s)\n    s_norm = normalize_string(s_valid)\n    req = SubstringCountRequest(s_norm)\n    service = SubstringService(cache_repo=None)\n    return service.count_non_empty_substrings(req)"}
{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the number of possible sequences of length n,\n    such that each element is a positive integer, is greater than or equal to\n    twice the previous element, and is less than or equal to m.\n    \"\"\"\n    \n    # Memoization cache to store results of subproblems: (remaining_length, min_allowed_value) -> count\n    memo = {}\n\n    def _count_from(remaining_length: int, min_allowed_value: int) -> int:\n        # Base case: If no more elements are needed, a valid sequence of length 'n' has been formed.\n        if remaining_length == 0:\n            return 1\n        \n        # Base case: If the minimum allowed value for the current element exceeds 'm',\n        # it's impossible to pick a valid element for this position or any subsequent positions.\n        if min_allowed_value > m:\n            return 0\n        \n        # Check if the result for this subproblem (remaining_length, min_allowed_value)\n        # is already in the cache to avoid redundant computations.\n        key = (remaining_length, min_allowed_value)\n        if key in memo:\n            return memo[key]\n        \n        total_sequences = 0\n        \n        # Determine the maximum possible value for the current element 'v'.\n        # The current element 'v' must be <= 'm'.\n        # Additionally, for a sequence to continue for 'remaining_length' steps,\n        # the smallest possible value for the last element would be `v * (2**(remaining_length - 1))`.\n        # This smallest possible last element must also be <= 'm'.\n        # So, `v * (2**(remaining_length - 1)) <= m`, which implies `v <= m // (2**(remaining_length - 1))`.\n        \n        # The upper limit for 'v' is the minimum of 'm' and this calculated maximum.\n        # For remaining_length = 1, `2**(remaining_length - 1)` is `2**0 = 1`, so max_possible_val is `m`.\n        # For remaining_length > 1, `2**(remaining_length - 1)` ensures 'v' is small enough to allow doubling.\n        max_possible_val = m // (2**(remaining_length - 1))\n        \n        # Iterate through possible integer values for the current element 'v'.\n        # 'v' must be at least `min_allowed_value` and at most `max_possible_val`.\n        for v in range(min_allowed_value, max_possible_val + 1):\n            # Recursively count sequences for the next position:\n            # - One less element needed (`remaining_length - 1`).\n            # - The next element must be at least `2 * v` (twice the current element).\n            total_sequences += _count_from(remaining_length - 1, 2 * v)\n            \n        # Store the computed result in the cache before returning for future use.\n        memo[key] = total_sequences\n        return total_sequences\n\n    # Start the recursive calculation to find the total number of sequences.\n    # The initial call is for a sequence of length 'n', and the first element\n    # must be a positive integer, so its minimum allowed value is 1.\n    return _count_from(n, 1)"}
