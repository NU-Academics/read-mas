{"task_id": "Mbpp/270", "solution": "from typing import List, Sequence, Any, Optional\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass ListValidator:\n    \"\"\"Validates input lists for type and length constraints.\"\"\"\n    DEFAULT_MAX_LENGTH = 10_000_000\n    def __init__(self, max_length: Optional[int] = None) -> None:\n        self._max_length = max_length or self.DEFAULT_MAX_LENGTH\n\n    def validate(self, lst: Sequence[Any]) -> bool:\n        \"\"\"Ensures input is a sequence of integers within length limits.\"\"\"\n        if not hasattr(lst, \"__len__\") or not hasattr(lst, \"__getitem__\"):\n            raise ValidationError(\"Input must be a sequence\")\n        if len(lst) > self._max_length:\n            raise ValidationError(\"Input exceeds maximum allowed length\")\n        for idx, item in enumerate(lst):\n            if not isinstance(item, int):\n                raise ValidationError(f\"Element at index {idx} is not an int\")\n        return True\n\nclass EvenSumService:\n    \"\"\"Core service for computing the sum of even numbers at even positions.\"\"\"\n    def __init__(self, validator: ListValidator) -> None:\n        self._validator = validator\n\n    def compute(self, items: Sequence[int]) -> int:\n        \"\"\"Calculates the sum of even numbers found at even 0-based indices.\"\"\"\n        self._validator.validate(items)\n        total = 0\n        for i in range(0, len(items), 2): # Iterate over even indices (0, 2, 4, ...)\n            val = items[i]\n            if self._is_even(val):\n                total += val\n        return total\n\n    def _is_even(self, n: int) -> bool:\n        \"\"\"Helper to check if a number is even.\"\"\"\n        return n % 2 == 0\n\ndef sum_even_and_even_index(lst: List[int]) -> int:\n    \"\"\"\n    Calculates the sum of even numbers located at even 0-based positions in a list.\n    Internally uses a validator and a service to perform validation and computation.\n    \"\"\"\n    validator = ListValidator()\n    service = EvenSumService(validator)\n    return service.compute(lst)"}
{"task_id": "Mbpp/268", "solution": "import json\nimport logging\nfrom pathlib import Path\nfrom typing import Any, Dict, Optional, Union\n\n# --- Exceptions ---\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass RepositoryError(Exception):\n    \"\"\"Custom exception for repository (cache) operation failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\n# --- Models ---\nclass StarNumber:\n    \"\"\"Immutable value object representing a star number.\"\"\"\n    def __init__(self, value: int) -> None:\n        if value < 1:\n            raise InvalidInputError(\"StarNumber value must be >= 1\")\n        self.value: int = value\n\n    def __int__(self) -> int:\n        return self.value\n\n    def __repr__(self) -> str:\n        return f\"StarNumber({self.value})\"\n\n# --- Validation ---\nclass InputValidator:\n    \"\"\"Validates and parses raw inputs for star number computation.\"\"\"\n    def validate(self, n: Any) -> int:\n        try:\n            if isinstance(n, str):\n                n_int = int(n.strip())\n            elif isinstance(n, int):\n                n_int = n\n            else:\n                raise InvalidInputError(\"Input 'n' must be an integer or integer string.\")\n        except (ValueError, TypeError):\n            raise InvalidInputError(\"Input 'n' must be an integer or integer string.\")\n        if n_int < 1:\n            raise InvalidInputError(\"Input 'n' must be >= 1.\")\n        return n_int\n\n# --- Repository ---\nclass StarRepository:\n    \"\"\"Simple JSON-backed repository for caching computed star numbers.\"\"\"\n    def __init__(self, path: Union[str, Path]) -> None:\n        self.path = Path(path)\n        self.data: Dict[str, int] = {}\n        if self.path.exists():\n            try:\n                self.data = self._load()\n            except Exception as e:\n                raise RepositoryError(f\"Failed to load cache from '{self.path}': {e}\")\n\n    def _load(self) -> Dict[str, int]:\n        \"\"\"Loads cached data from the JSON file.\"\"\"\n        with self.path.open('r', encoding='utf-8') as f:\n            return json.load(f)\n\n    def _save(self, data: Dict[str, int]) -> None:\n        \"\"\"Saves data to the JSON file atomically.\"\"\"\n        tmp = self.path.with_suffix('.tmp')\n        with tmp.open('w', encoding='utf-8') as f:\n            json.dump(data, f)\n        tmp.replace(self.path)\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a cached star number for a given n.\"\"\"\n        return self.data.get(str(n))\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a star number in the cache and persists it to disk.\"\"\"\n        self.data[str(n)] = value\n        try:\n            self._save(self.data)\n        except Exception as e:\n            raise RepositoryError(f\"Failed to save cache to '{self.path}': {e}\")\n\n# --- Service ---\n_logger = logging.getLogger(__name__)\n\nclass StarCalculator:\n    \"\"\"Calculates star numbers, orchestrating input validation and caching.\"\"\"\n    def __init__(self, repository: Optional[StarRepository] = None) -> None:\n        self.validator = InputValidator()\n        self.repository = repository\n\n    def _formula(self, n: int) -> int:\n        \"\"\"The mathematical formula for the n'th star number.\"\"\"\n        return 6 * n * (n - 1) + 1\n\n    def compute(self, n: Any) -> StarNumber:\n        \"\"\"Computes the n'th star number, using cache if available.\"\"\"\n        n_validated = self.validator.validate(n)\n\n        if self.repository:\n            try:\n                cached = self.repository.get(n_validated)\n                if cached is not None:\n                    return StarNumber(cached)\n            except RepositoryError as e:\n                _logger.warning(f\"Failed to read from cache for n={n_validated}, computing without cache. Error: {e}\")\n\n        val = self._formula(n_validated)\n\n        if self.repository:\n            try:\n                self.repository.set(n_validated, val)\n            except RepositoryError as e:\n                _logger.warning(f\"Failed to write to cache for n={n_validated}, continuing without caching. Error: {e}\")\n        return StarNumber(val)\n\n# --- Facade Function ---\nDEFAULT_CACHE_NAME = \".star_cache.json\"\n\ndef find_star_num(n: int) -> int:\n    \"\"\"\n    Finds the n'th star number.\n    It uses a local file-based cache to speed up repeated queries.\n    \"\"\"\n    repo = StarRepository(Path.cwd() / DEFAULT_CACHE_NAME)\n    calc = StarCalculator(repository=repo)\n    return int(calc.compute(n))"}
{"task_id": "Mbpp/271", "solution": "import math\n\ndef even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the first n even natural numbers raised to the fifth power using a closed-form formula.\n    The sum is equivalent to (2^5) * sum_{k=1..n} k^5.\n    \"\"\"\n    if n == 0:\n        return 0\n    # Formula for sum_{k=1..n} k^5 = n^2 * (n+1)^2 * (2n^2 + 2n - 1) / 12\n    sum_k_power_5 = (n * n * (n + 1) * (n + 1) * (2 * n * n + 2 * n - 1)) // 12\n    return (2 ** 5) * sum_k_power_5"}
{"task_id": "Mbpp/274", "solution": "def even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of even-indexed binomial coefficients for a given positive integer n.\n    It uses the identity: sum_{k even} C(n,k) = 2^(n-1) for n >= 1.\n    \"\"\"\n    return 1 << (n - 1)"}
