{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n):\n    \"\"\"\n    Counts the number of unordered pairs in an array whose XOR value is odd.\n    An XOR operation results in an odd number if and only if one operand is odd and the other is even.\n    \"\"\"\n    odd_count = 0\n    even_count = 0\n    for num in arr:\n        if (num & 1) == 1:  # Check if the number is odd using bitwise AND\n            odd_count += 1\n        else:\n            even_count += 1\n    return odd_count * even_count"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers using mathematical formulas.\n    \"\"\"\n    sum_n = n * (n + 1) // 2\n    sum_cubes_n = sum_n * sum_n\n    return sum_cubes_n - sum_n"}
{"task_id": "Mbpp/479", "solution": "def first_Digit(n):\n    \"\"\"\n    Finds the first (most significant) digit of a number, handling negative values and floats.\n    \"\"\"\n    s = str(n)\n\n    # Handle negative sign for absolute value\n    if s.startswith('-'):\n        s = s[1:]\n    \n    # Truncate fractional part for floats\n    if '.' in s:\n        s = s.split('.')[0]\n\n    # Convert to integer for the core algorithm\n    # Assumes 's' is a valid numeric string at this point (e.g., \"123\", \"0\")\n    num = int(s)\n\n    if num == 0:\n        return 0\n    \n    # Repeatedly divide by 10 until only the first digit remains\n    while num >= 10:\n        num //= 10\n        \n    return num"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(text: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in a string.\"\"\"\n    out_chars = []\n    for ch in text:\n        if ch.isupper():\n            out_chars.append(ch.lower())\n        elif ch.islower():\n            out_chars.append(ch.upper())\n        else:\n            out_chars.append(ch)\n    return \"\".join(out_chars)"}
{"task_id": "Mbpp/560", "solution": "def union_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Finds the union of elements of two given tuples and outputs them in sorted order.\n    Assumes elements are hashable and comparable.\n    \"\"\"\n    combined_set = set(a) | set(b)\n    sorted_elements = sorted(list(combined_set))\n    return tuple(sorted_elements)"}
{"task_id": "Mbpp/558", "solution": "from typing import Any, List, Tuple\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass DigitDistanceResult:\n    \"\"\"DTO for storing digit distance computation results.\"\"\"\n    def __init__(self, a: int, b: int, result: int):\n        self.a = a\n        self.b = b\n        self.result = result\n\n    def to_dict(self) -> dict[str, int]:\n        \"\"\"Returns the result as a dictionary.\"\"\"\n        return {\"a\": self.a, \"b\": self.result, \"result\": self.result}\n\nclass InputValidator:\n    \"\"\"Validates and normalizes inputs to integers.\"\"\"\n    def _to_int(self, value: Any) -> int:\n        \"\"\"Converts a single value to an integer safely.\"\"\"\n        try:\n            return int(value)\n        except (ValueError, TypeError) as e:\n            raise InvalidInputError(f\"Input '{value}' cannot be converted to an integer.\") from e\n\n    def validate(self, a: Any, b: Any) -> Tuple[int, int]:\n        \"\"\"Validates two inputs and converts them to integers.\"\"\"\n        a_int = self._to_int(a)\n        b_int = self._to_int(b)\n        return a_int, b_int\n\nclass DigitListFactory:\n    \"\"\"Converts integers to aligned lists of digits.\"\"\"\n    def _int_to_digits(self, n: int) -> List[int]:\n        \"\"\"Converts an absolute integer to a list of its digits, least significant first.\"\"\"\n        if n == 0:\n            return [0]\n        digits = []\n        n_abs = abs(n)\n        while n_abs > 0:\n            digits.append(n_abs % 10)\n            n_abs //= 10\n        return digits\n\n    def to_digit_lists(self, a: int, b: int) -> Tuple[List[int], List[int]]:\n        \"\"\"Converts two integers into right-aligned lists of digits, padding with zeros.\"\"\"\n        digits_a = self._int_to_digits(a)\n        digits_b = self._int_to_digits(b)\n\n        maxlen = max(len(digits_a), len(digits_b))\n\n        digits_a.extend([0] * (maxlen - len(digits_a)))\n        digits_b.extend([0] * (maxlen - len(digits_b)))\n\n        return digits_a, digits_b\n\nclass DigitDistanceService:\n    \"\"\"Core service for computing the sum of per-digit differences.\"\"\"\n    def __init__(self, factory: DigitListFactory, validator: InputValidator):\n        self.factory = factory\n        self.validator = validator\n\n    def _sum_digit_differences(self, digits_a: List[int], digits_b: List[int]) -> int:\n        \"\"\"Calculates the sum of absolute differences between corresponding digits.\"\"\"\n        total_difference = 0\n        for d1, d2 in zip(digits_a, digits_b):\n            total_difference += abs(d1 - d2)\n        return total_difference\n\n    def compute(self, a: Any, b: Any) -> DigitDistanceResult:\n        \"\"\"Validates inputs, processes them into digit lists, and computes the sum of differences.\"\"\"\n        a_int, b_int = self.validator.validate(a, b)\n        \n        digits_a, digits_b = self.factory.to_digit_lists(a_int, b_int)\n        \n        total = self._sum_digit_differences(digits_a, digits_b)\n        return DigitDistanceResult(a=a_int, b=b_int, result=total)\n\ndef digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"\n    Finds the sum of the per-digit difference between two integers.\n    Numbers are right-aligned, shorter numbers are padded with leading zeros, and negative signs are ignored before summing absolute digit differences.\n    \"\"\"\n    validator = InputValidator()\n    factory = DigitListFactory()\n    service = DigitDistanceService(factory=factory, validator=validator)\n    result = service.compute(a, b)\n    return result.result"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(sublists):\n    \"\"\"\n    Finds the length of the longest sublist in a list of sublists.\n    Assumes sublists are iterable objects for which len() is defined.\n    \"\"\"\n    max_length = 0\n    for sublist in sublists:\n        current_length = len(sublist)\n        if current_length > max_length:\n            max_length = current_length\n    return max_length"}
{"task_id": "Mbpp/559", "solution": "from typing import List\n\ndef max_sub_array_sum(nums: List[int], n: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist using Kadane's algorithm.\n    Assumes the input list `nums` is non-empty.\n    \"\"\"\n    max_ending_here = nums[0]\n    max_so_far = nums[0]\n\n    for i in range(1, len(nums)):\n        max_ending_here = max(nums[i], max_ending_here + nums[i])\n        max_so_far = max(max_so_far, max_ending_here)\n\n    return max_so_far"}
{"task_id": "Mbpp/563", "solution": "import re\nfrom typing import List, Optional, Tuple\n\nclass QuoteExtractorError(Exception):\n    \"\"\"Base exception for the quote_extractor library.\"\"\"\n    pass\n\nclass ParseError(QuoteExtractorError):\n    \"\"\"Exception raised for parsing errors in the input string.\"\"\"\n    def __init__(self, message: str, position: Optional[int] = None) -> None:\n        self.message = message\n        self.position = position\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        if self.position is not None:\n            return f\"at position {self.position}: {self.message}\"\n        return self.message\n\nclass ValuesResult:\n    \"\"\"Data transfer object for the result of a value extraction operation.\"\"\"\n    def __init__(self, values: List[str], raw: str) -> None:\n        self.values = values\n        self.raw = raw\n        self.count = len(values)\n\nclass RegexUtils:\n    \"\"\"Utility class for regex operations, particularly escaping and unescaping.\"\"\"\n    ESCAPE_PATTERN: re.Pattern = re.compile(r'\\\\(.)')\n    UNESCAPE_MAP = {'n': '\\n', 't': '\\t', '\\\\': '\\\\', '\"': '\"', \"'\": \"'\"}\n\n    def is_escaped(self, text: str, pos: int) -> bool:\n        \"\"\"Checks if the character at 'pos' is preceded by an odd number of backslashes.\"\"\"\n        i = pos - 1\n        count = 0\n        while i >= 0 and text[i] == '\\\\':\n            count += 1\n            i -= 1\n        return (count % 2) == 1\n\n    def unescape(self, s: str) -> str:\n        \"\"\"Converts recognized backslash escape sequences into their literal characters.\"\"\"\n        def repl(m):\n            ch = m.group(1)\n            return self.UNESCAPE_MAP.get(ch, ch)\n        return self.ESCAPE_PATTERN.sub(repl, s)\n\nclass Token:\n    \"\"\"Represents a token found during parsing, either quoted or unquoted.\"\"\"\n    def __init__(self, value: str, quote_char: Optional[str], start: int, end: int) -> None:\n        self.value = value\n        self.quote_char = quote_char\n        self.start = start\n        self.end = end\n\n    def is_quoted(self) -> bool:\n        \"\"\"Returns True if the token was enclosed in quotation marks.\"\"\"\n        return self.quote_char is not None\n\nclass QuoteTokenizer:\n    \"\"\"Scans a string to identify and extract quoted tokens.\"\"\"\n    ESCAPE_CHAR = '\\\\'\n    def __init__(self) -> None:\n        self._utils = RegexUtils()\n\n    def tokenize(self, text: str) -> List[Token]:\n        \"\"\"Parses the input text and returns a list of identified tokens.\"\"\"\n        tokens: List[Token] = []\n        i = 0\n        n = len(text)\n        while i < n:\n            ch = text[i]\n            if ch in ('\"', \"'\") and not self._utils.is_escaped(text, i):\n                token, i = self._consume_quoted(text, i)\n                tokens.append(token)\n            else:\n                i += 1\n        return tokens\n\n    def _consume_quoted(self, text: str, start: int) -> Tuple[Token, int]:\n        \"\"\"Consumes a quoted string starting from 'start' and returns the token and next index.\"\"\"\n        quote = text[start]\n        i = start + 1\n        buf = []\n        while i < len(text):\n            if text[i] == quote and not self._utils.is_escaped(text, i):\n                raw_content = ''.join(buf)\n                value = self._utils.unescape(raw_content)\n                return Token(value=value, quote_char=quote, start=start, end=i + 1), i + 1\n            buf.append(text[i])\n            i += 1\n        raise ParseError(\"Unterminated quoted string\", position=start)\n\nclass QuoteExtractor:\n    \"\"\"High-level facade for extracting quoted values from a string.\"\"\"\n    def __init__(self, tokenizer: Optional[QuoteTokenizer] = None) -> None:\n        self._tokenizer = tokenizer or QuoteTokenizer()\n\n    def extract(self, text: str) -> ValuesResult:\n        \"\"\"Extracts quoted values along with raw input and count.\"\"\"\n        tokens = self._tokenizer.tokenize(text)\n        values = [t.value for t in tokens if t.is_quoted()]\n        return ValuesResult(values=values, raw=text)\n\n    def extract_values(self, text: str) -> List[str]:\n        \"\"\"Extracts and returns a list of only the quoted string values.\"\"\"\n        return self.extract(text).values\n\n_default_extractor = QuoteExtractor()\n\ndef extract_values(s: str) -> List[str]:\n    \"\"\"\n    Extracts values between quotation marks from a string.\n    Supports single and double quotes, and backslash escapes within quotes.\n    \"\"\"\n    return _default_extractor.extract_values(s)"}
{"task_id": "Mbpp/564", "solution": "import collections\n\ndef count_Pairs(arr: list[int], n: int) -> int:\n    \"\"\"\n    Counts the number of unordered pairs of unequal elements in a list.\n    Assumes `arr` is a valid list of integers and `n` is its correct length.\n    \"\"\"\n    \n    # Calculate total possible unordered pairs from n elements: n * (n - 1) / 2\n    total_pairs = n * (n - 1) // 2\n    \n    # Use a frequency map to count occurrences of each element\n    freq = collections.Counter(arr)\n    \n    # Calculate pairs where elements are equal\n    # For each element with count 'c', it forms c * (c - 1) / 2 equal pairs\n    equal_pairs = 0\n    for count in freq.values():\n        equal_pairs += count * (count - 1) // 2\n        \n    # The number of unequal pairs is total_pairs - equal_pairs\n    return total_pairs - equal_pairs"}
{"task_id": "Mbpp/566", "solution": "def sum_digits(n: int) -> int:\n    \"\"\"Calculates the sum of the digits of a non-negative integer.\"\"\"\n    if n == 0:\n        return 0\n    \n    total_sum = 0\n    current_number = n\n    while current_number > 0:\n        total_sum += current_number % 10\n        current_number //= 10\n    return total_sum"}
{"task_id": "Mbpp/565", "solution": "import logging\nimport datetime\nimport uuid\nimport json\nfrom abc import ABC, abstractmethod\n\n# --- exceptions.py ---\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str, code: int = 400) -> None:\n        self.message = message\n        self.code = code\n        super().__init__(self.message)\n\n# --- models.py ---\nclass SplitResult:\n    \"\"\"DTO for the result of a split operation.\"\"\"\n    def __init__(self, chars: list[str]) -> None:\n        self.chars = chars\n\n    def as_list(self) -> list[str]:\n        \"\"\"Returns the characters as a list.\"\"\"\n        return list(self.chars)\n\n    def as_json(self) -> str:\n        \"\"\"Returns the characters as a JSON string.\"\"\"\n        return json.dumps(self.chars)\n\nclass HistoryEntry:\n    \"\"\"DTO for a historical record of a split operation.\"\"\"\n    def __init__(self, id: str, input_text: str, result: list[str], timestamp: str) -> None:\n        self.id = id\n        self.input_text = input_text\n        self.result = result\n        self.timestamp = timestamp\n\n# --- validators.py ---\nclass InputValidator:\n    \"\"\"Validates input text for splitting.\"\"\"\n    def __init__(self, max_length: int = 10000) -> None:\n        self._max_length = max_length\n\n    def validate(self, text: str) -> None:\n        \"\"\"\n        Validates the input text.\n        Raises: ValidationError if text is invalid.\n        \"\"\"\n        if not isinstance(text, str):\n            raise ValidationError(\"text must be a string\", code=400)\n        if len(text) > self._max_length:\n            raise ValidationError(\"text exceeds maximum allowed length\", code=413)\n\n# --- repositories.py ---\nclass HistoryRepository(ABC):\n    \"\"\"Abstract base class for history repositories.\"\"\"\n    @abstractmethod\n    def save(self, entry: HistoryEntry) -> str:\n        \"\"\"Saves a history entry and returns its ID.\"\"\"\n        pass\n\n    @abstractmethod\n    def list_all(self) -> list[HistoryEntry]:\n        \"\"\"Lists all history entries.\"\"\"\n        pass\n\nclass InMemoryHistoryRepository(HistoryRepository):\n    \"\"\"In-memory implementation of HistoryRepository.\"\"\"\n    def __init__(self) -> None:\n        self._store: dict[str, HistoryEntry] = {}\n\n    def save(self, entry: HistoryEntry) -> str:\n        \"\"\"Stores the entry in an in-memory dictionary.\"\"\"\n        self._store[entry.id] = entry\n        return entry.id\n\n    def list_all(self) -> list[HistoryEntry]:\n        \"\"\"Returns all stored history entries.\"\"\"\n        return list(self._store.values())\n\n# --- adapters/logger_adapter.py ---\nclass LoggerAdapter:\n    \"\"\"A simple adapter for Python's logging module.\"\"\"\n    def __init__(self, name: str = \"strsplitter\") -> None:\n        self._logger = logging.getLogger(name)\n        if not self._logger.handlers:\n            logging.basicConfig(level=logging.INFO)\n\n    def info(self, msg: str) -> None:\n        \"\"\"Logs an informational message.\"\"\"\n        self._logger.info(msg)\n\n    def error(self, msg: str) -> None:\n        \"\"\"Logs an error message.\"\"\"\n        self._logger.error(msg)\n\n# --- utils.py ---\ndef now_iso() -> str:\n    \"\"\"Returns the current UTC time in ISO8601 format.\"\"\"\n    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds') + 'Z'\n\n# --- services.py ---\nclass SplitService:\n    \"\"\"Core business logic for splitting strings.\"\"\"\n    def __init__(self, validator: InputValidator, repo: HistoryRepository, logger: LoggerAdapter) -> None:\n        self._validator = validator\n        self._repo = repo\n        self._logger = logger\n\n    def split_text(self, text: str) -> SplitResult:\n        \"\"\"\n        Validates input, splits the text into characters, records history, and returns the result.\n        \"\"\"\n        self._validator.validate(text)\n        chars = [c for c in text]\n        result = SplitResult(chars)\n\n        try:\n            entry = HistoryEntry(str(uuid.uuid4()), text, chars, now_iso())\n            self._repo.save(entry)\n            self._logger.info(f\"History saved with ID: {entry.id}\")\n        except Exception as e:\n            self._logger.error(f\"Failed to save history: {e}\")\n\n        return result\n\n# --- Public API (as per __init__.py in design) ---\n_validator_global = InputValidator()\n_repo_global = InMemoryHistoryRepository()\n_logger_global = LoggerAdapter()\n_service_global = SplitService(_validator_global, _repo_global, _logger_global)\n\ndef split(text: str) -> list[str]:\n    \"\"\"\n    Splits a string into a list of characters, performing validation and history recording.\n    \"\"\"\n    return _service_global.split_text(text).as_list()"}
{"task_id": "Mbpp/568", "solution": "\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InputValidator:\n    \"\"\"Validates input parameters for creating empty lists.\"\"\"\n    MIN_N: int = 0\n\n    def validate_non_negative_int(self, value: object) -> int:\n        \"\"\"Validates if the value is a non-negative integer.\"\"\"\n        try:\n            iv = int(value)\n        except (ValueError, TypeError):\n            raise InvalidInputError(f\"Cannot convert {value!r} to integer.\")\n        if iv < self.MIN_N:\n            raise InvalidInputError(f\"n must be >= {self.MIN_N}, got {iv}.\")\n        return iv\n\nclass EmptyDictFactory:\n    \"\"\"Factory for creating lists of empty dictionaries.\"\"\"\n    DEFAULT_MAX_SAFE_N: int = 10_000_000\n\n    def create_list(self, n: int) -> list[dict]:\n        \"\"\"Returns a list containing n distinct empty dictionary objects.\"\"\"\n        return [{} for _ in range(n)]\n\nclass EmptyListService:\n    \"\"\"Orchestrates validation and creation of empty dictionary lists.\"\"\"\n    def __init__(self, factory: EmptyDictFactory, validator: InputValidator) -> None:\n        self.factory = factory\n        self.validator = validator\n\n    def create(self, n: int) -> list[dict]:\n        \"\"\"Validates the input n and returns a list of n empty dictionaries.\"\"\"\n        validated_n = self.validator.validate_non_negative_int(n)\n        return self.factory.create_list(validated_n)\n\ndef empty_list(n: int) -> list[dict]:\n    \"\"\"\n    Creates a list of N empty dictionaries.\n\n    Raises InvalidInputError if N is not a non-negative integer.\n    \"\"\"\n    factory = EmptyDictFactory()\n    validator = InputValidator()\n    service = EmptyListService(factory=factory, validator=validator)\n    return service.create(n)"}
{"task_id": "Mbpp/567", "solution": "import json\nimport hashlib\nimport sqlite3\nfrom typing import Sequence, Any, Optional, Dict, Tuple\n\nclass InvalidInputError(Exception):\n    pass\n\nclass ComparisonError(Exception):\n    pass\n\nclass RepositoryError(Exception):\n    pass\n\nclass ListValidator:\n    _sequence_types: Tuple[type, ...] = (list, tuple)\n\n    def validate(self, items: Sequence[Any]) -> None:\n        \"\"\"\n        Validates if the input is a sequence and its elements are comparable.\n        \"\"\"\n        if not self._is_sequence(items):\n            raise InvalidInputError(\"Input is not a sequence (list or tuple).\")\n        if len(items) <= 1:\n            return\n        try:\n            # Attempt basic comparisons to detect uncomparable types early.\n            _ = items[0] <= items[0]\n            if len(items) > 1:\n                _ = items[0] <= items[1]\n        except Exception as e:\n            raise ComparisonError(\"Elements are not comparable: \" + str(e))\n\n    def _is_sequence(self, obj: Any) -> bool:\n        \"\"\"\n        Checks if the object is one of the defined sequence types.\n        \"\"\"\n        return isinstance(obj, self._sequence_types)\n\ndef hash_input(items: Sequence[Any]) -> str:\n    \"\"\"\n    Generates a deterministic SHA256 hash of the input sequence for persistence.\n    \"\"\"\n    try:\n        serialized = json.dumps(items, default=str, sort_keys=True)\n    except Exception:\n        serialized = str(items)\n    return hashlib.sha256(serialized.encode(\"utf-8\")).hexdigest()\n\nclass SortRepository:\n    def __init__(self, db_path: str = \":memory:\") -> None:\n        self._db_path = db_path\n        self._conn: Optional[sqlite3.Connection] = None\n        self.initialize()\n\n    def _get_connection(self) -> sqlite3.Connection:\n        if self._conn is None:\n            self._conn = sqlite3.connect(self._db_path)\n            self._conn.row_factory = sqlite3.Row\n        return self._conn\n\n    def initialize(self) -> None:\n        \"\"\"\n        Creates the 'checks' table if it does not exist.\n        \"\"\"\n        conn = self._get_connection()\n        try:\n            cursor = conn.cursor()\n            cursor.execute(\"\"\"\n                CREATE TABLE IF NOT EXISTS checks (\n                    id INTEGER PRIMARY KEY AUTOINCREMENT,\n                    input_hash TEXT NOT NULL,\n                    result INTEGER NOT NULL,\n                    metadata TEXT,\n                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n                );\n            \"\"\")\n            cursor.execute(\"CREATE INDEX IF NOT EXISTS idx_checks_input_hash ON checks(input_hash);\")\n            conn.commit()\n        except sqlite3.Error as e:\n            raise RepositoryError(f\"Failed to initialize repository: {e}\")\n\n    def save_check(self, input_hash: str, result: bool, metadata: Optional[Dict[str, Any]] = None) -> int:\n        \"\"\"\n        Saves a check result to the repository and returns the inserted ID.\n        \"\"\"\n        conn = self._get_connection()\n        try:\n            cursor = conn.cursor()\n            metadata_str = json.dumps(metadata) if metadata else None\n            cursor.execute(\n                \"INSERT INTO checks (input_hash, result, metadata) VALUES (?, ?, ?)\",\n                (input_hash, 1 if result else 0, metadata_str)\n            )\n            conn.commit()\n            return cursor.lastrowid\n        except sqlite3.Error as e:\n            raise RepositoryError(f\"Failed to save check result: {e}\")\n\nclass SortService:\n    def __init__(self, validator: ListValidator, repository: Optional[SortRepository] = None) -> None:\n        self._validator = validator\n        self._repository = repository\n\n    def is_sorted(self, items: Sequence[Any]) -> bool:\n        \"\"\"\n        Checks if the given sequence of items is sorted in non-decreasing order.\n        \"\"\"\n        self._validator.validate(items)\n        result = self._check_iterable(items)\n        if self._repository is not None:\n            try:\n                # `hash_input` is defined inline above.\n                hid = hash_input(items)\n                self._repository.save_check(hid, result)\n            except Exception as e:\n                # Persistence failures should not prevent the core check result.\n                raise RepositoryError(f\"Failed to persist result: {e}\")\n        return result\n\n    def _check_iterable(self, items: Sequence[Any]) -> bool:\n        \"\"\"\n        Internal method to perform the actual pairwise comparison for sortedness.\n        \"\"\"\n        if len(items) <= 1:\n            return True\n        prev = items[0]\n        for cur in items[1:]:\n            try:\n                if not (prev <= cur):\n                    return False\n            except TypeError as e:\n                raise ComparisonError(f\"Cannot compare elements: {e}\")\n            prev = cur\n        return True\n\n_validator = ListValidator()\n_service = SortService(validator=_validator)\n\ndef issort_list(items: Sequence[Any]) -> bool:\n    \"\"\"\n    Convenience function to check if a list is sorted in non-decreasing order.\n    \"\"\"\n    return _service.is_sorted(items)"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(haystack: list, needle: list) -> bool:\n    \"\"\"\n    Checks if a list is a contiguous sublist of another.\n    \"\"\"\n    n_len = len(needle)\n    h_len = len(haystack)\n\n    if n_len == 0:\n        return True\n\n    if n_len > h_len:\n        return False\n\n    for i in range(h_len - n_len + 1):\n        if haystack[i : i + n_len] == needle:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/572", "solution": "from typing import Any, List, Dict\nfrom abc import ABC, abstractmethod\n\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\ndef is_int_list(obj: Any) -> bool:\n    \"\"\"Check if an object is a list or tuple containing only integers.\"\"\"\n    if not isinstance(obj, (list, tuple)):\n        return False\n    return all(isinstance(x, int) and not isinstance(x, bool) for x in obj)\n\nclass ListInput:\n    \"\"\"DTO for list input with validation.\"\"\"\n    items: List[int]\n\n    def __init__(self, items: List[int]) -> None:\n        self.items = items\n        self.validate()\n\n    def validate(self) -> None:\n        \"\"\"Validates that items is a list of integers.\"\"\"\n        if not is_int_list(self.items):\n            raise InvalidInputError(\"Input must be a list of integers.\")\n\nclass CountRepository(ABC):\n    \"\"\"Abstract base class for counting frequencies.\"\"\"\n    @abstractmethod\n    def count_frequencies(self, nums: List[int]) -> Dict[int, int]:\n        pass\n\nclass InMemoryCountRepository(CountRepository):\n    \"\"\"In-memory implementation of CountRepository.\"\"\"\n    def count_frequencies(self, nums: List[int]) -> Dict[int, int]:\n        # Validate input for robustness as per design\n        if not is_int_list(nums):\n            raise InvalidInputError(\"Repository input must be a list of integers.\")\n        counts: Dict[int, int] = {}\n        for n in nums:\n            counts[n] = counts.get(n, 0) + 1\n        return counts\n\nclass UniqueNumberService:\n    \"\"\"Core service to find unique-once numbers.\"\"\"\n    def __init__(self, repository: CountRepository) -> None:\n        self._repository = repository\n\n    def unique_once(self, nums: List[int]) -> List[int]:\n        # Validate input as per service design's \"Errors\" point\n        if not is_int_list(nums):\n            raise InvalidInputError(\"Service input must be a list of integers.\")\n        freq = self._repository.count_frequencies(nums)\n        return [x for x in nums if freq.get(x, 0) == 1]\n\nclass APIController:\n    \"\"\"Controller for the programmatic API.\"\"\"\n    def __init__(self, service: UniqueNumberService):\n        self.service = service\n\n    def two_unique_nums(self, nums: List[int]) -> List[int]:\n        # Input validation performed by ListInput DTO\n        list_input = ListInput(nums)\n        return self.service.unique_once(list_input.items)\n\ndef two_unique_nums(nums: List[int]) -> List[int]:\n    \"\"\"\n    Removes duplicate numbers from a list, returning only those that appear once.\n    Preserves the original order of the unique numbers.\n    \"\"\"\n    service = UniqueNumberService(InMemoryCountRepository())\n    controller = APIController(service)\n    return controller.two_unique_nums(nums)"}
{"task_id": "Mbpp/573", "solution": "from typing import Sequence, List, Any, Optional\nfrom datetime import datetime\nfrom uuid import uuid4\nfrom abc import ABC, abstractmethod\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    def __init__(self, message: str, index: Optional[int] = None, value: Any = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.index = index\n        self.value = value\n\nclass RepositoryError(Exception):\n    \"\"\"Exception raised for repository persistence failures.\"\"\"\n    def __init__(self, message: str, cause: Optional[Exception] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.cause = cause\n\nclass UniqueProductResult:\n    \"\"\"Data class to hold the result of a unique product computation.\"\"\"\n    def __init__(self, unique_values: List[float], result: float, timestamp: datetime) -> None:\n        self.unique_values = unique_values\n        self.result = result\n        self.timestamp = timestamp\n\nclass Utils:\n    \"\"\"Collection of static utility methods for validation, deduplication, and multiplication.\"\"\"\n    @staticmethod\n    def validate_numbers(numbers: Sequence[Any]) -> List[float]:\n        \"\"\"Validates that all items in the sequence are numeric and converts them to floats.\"\"\"\n        if not isinstance(numbers, (list, tuple)):\n            raise ValidationError(\"numbers must be a list or tuple\")\n        out: List[float] = []\n        for i, v in enumerate(numbers):\n            if isinstance(v, (int, float)):\n                out.append(float(v))\n            else:\n                raise ValidationError(\"non-numeric value\", index=i, value=v)\n        return out\n\n    @staticmethod\n    def deduplicate(numbers: Sequence[float]) -> List[float]:\n        \"\"\"Returns a list of unique numbers from the input sequence, preserving first-seen order.\"\"\"\n        seen = set()\n        unique = []\n        for v in numbers:\n            if v not in seen:\n                seen.add(v)\n                unique.append(v)\n        return unique\n\n    @staticmethod\n    def multiply(numbers: Sequence[float]) -> float:\n        \"\"\"Calculates the product of all numbers in the sequence, returning 1 for an empty sequence.\"\"\"\n        prod: float = 1.0\n        for v in numbers:\n            prod *= v\n        return prod\n\nclass UniqueProductRepository(ABC):\n    \"\"\"Abstract base class defining the interface for storing unique product computation history.\"\"\"\n    @abstractmethod\n    def save(self, entry: dict) -> None:\n        pass\n\n    @abstractmethod\n    def list(self, limit: Optional[int] = None) -> List[dict]:\n        pass\n\nclass InMemoryUniqueProductRepository(UniqueProductRepository):\n    \"\"\"An in-memory implementation of the UniqueProductRepository for storing history.\"\"\"\n    def __init__(self) -> None:\n        self._store: List[dict] = []\n\n    def save(self, entry: dict) -> None:\n        \"\"\"Appends the computation history entry to an internal list.\"\"\"\n        self._store.append(entry)\n\n    def list(self, limit: Optional[int] = None) -> List[dict]:\n        \"\"\"Returns a list of stored history entries, optionally limited.\"\"\"\n        return self._store[:limit]\n\nclass UniqueProductService:\n    \"\"\"Provides the core business logic for computing the unique product.\"\"\"\n    def __init__(self, utils: Utils, repository: Optional[UniqueProductRepository] = None) -> None:\n        self._utils = utils\n        self._repo = repository\n\n    def compute(self, numbers: Sequence[Any]) -> UniqueProductResult:\n        \"\"\"Orchestrates validation, deduplication, and multiplication; optionally persists history.\"\"\"\n        validated = self._utils.validate_numbers(numbers)\n        unique_values = self._utils.deduplicate(validated)\n        result = self._utils.multiply(unique_values)\n        res = UniqueProductResult(unique_values, result, datetime.utcnow())\n        if self._repo:\n            try:\n                self._repo.save({\n                    \"id\": str(uuid4()),\n                    \"timestamp\": res.timestamp.isoformat() + \"Z\",\n                    \"input\": list(validated),\n                    \"unique\": list(unique_values),\n                    \"result\": result\n                })\n            except RepositoryError:\n                # Logs repository errors and continues without re-raising.\n                pass\n\n        return res\n\nclass UniqueProductController:\n    \"\"\"Exposes the public API for unique product computation, delegating to the service.\"\"\"\n    def __init__(self, service: UniqueProductService) -> None:\n        self._service = service\n\n    def unique_product(self, numbers: Sequence[Any]) -> float:\n        \"\"\"Delegates computation to the service and returns the final product.\"\"\"\n        result_obj = self._service.compute(numbers)\n        return result_obj.result\n\n_default_utils = Utils()\n_default_repo = InMemoryUniqueProductRepository()\n_default_service = UniqueProductService(utils=_default_utils, repository=_default_repo)\n_default_controller = UniqueProductController(service=_default_service)\n\ndef unique_product(numbers: Sequence[Any]) -> float:\n    \"\"\"\n    Calculates the product of the unique numbers in a given list.\n    Handles validation, deduplication, and multiplication using an internal service.\n    \"\"\"\n    return _default_controller.unique_product(numbers)"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n):\n    \"\"\"\n    Finds the last digit in the factorial of a given number.\n    For n >= 5, the last digit is 0; otherwise, it computes the factorial's last digit directly.\n    \"\"\"\n    if n >= 5:\n        return 0\n    elif n == 0:\n        return 1\n    elif n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4"}
{"task_id": "Mbpp/569", "solution": "from typing import List\n\ndef sort_sublists(lists: List[List[str]]) -> List[List[str]]:\n    \"\"\"Sorts each sublist lexicographically, case-insensitively, while preserving original case.\n    Returns a new list with sorted sublists, without modifying the input.\n    \"\"\"\n    case_insensitive = True\n    key = (lambda s: s.lower()) if case_insensitive else None\n    return [sorted(sub, key=key) for sub in lists]"}
{"task_id": "Mbpp/579", "solution": "from typing import Tuple, Any\n\ndef find_dissimilar(a: Tuple[Any, ...], b: Tuple[Any, ...]) -> Tuple[Any, ...]:\n    \"\"\"\n    Finds elements present in either tuple but not in both, preserving order\n    and ensuring each unique dissimilar element appears only once in the result.\n    \"\"\"\n    set_a = set(a)\n    set_b = set(b)\n    result = []\n    seen = set()\n\n    for item in a:\n        if item not in set_b and item not in seen:\n            result.append(item)\n            seen.add(item)\n\n    for item in b:\n        if item not in set_a and item not in seen:\n            result.append(item)\n            seen.add(item)\n\n    return tuple(result)"}
{"task_id": "Mbpp/578", "solution": "from typing import List, Any\n\ndef interleave_lists(a: List[Any], b: List[Any], c: List[Any]) -> List[Any]:\n    \"\"\"Interleaves three lists of the same length into a single flat list.\n    Assumes inputs are lists of equal length as per design context.\n    \"\"\"\n    result = []\n    for item_a, item_b, item_c in zip(a, b, c):\n        result.extend([item_a, item_b, item_c])\n    return result"}
{"task_id": "Mbpp/580", "solution": "def extract_even(value: tuple) -> tuple:\n    \"\"\"\n    Recursively removes odd integers from a nested tuple, preserving even integers and tuple structure.\n    Non-integer scalar types (including booleans) are dropped.\n    \"\"\"\n\n    def _extract_recursive(element):\n        # Check if the element is an integer (but not a boolean, as bool is a subclass of int)\n        if isinstance(element, int) and not isinstance(element, bool):\n            # If it's an even integer, keep it; otherwise, mark for removal\n            return element if element % 2 == 0 else None\n        # Check if the element is a tuple\n        elif isinstance(element, tuple):\n            processed_elements = []\n            for item in element:\n                # Recursively process each item in the tuple\n                processed_item = _extract_recursive(item)\n                # If the processed item is not None (i.e., it wasn't marked for removal), add it\n                if processed_item is not None:\n                    processed_elements.append(processed_item)\n            # Return a new tuple with the filtered elements\n            return tuple(processed_elements)\n        # For any other type (e.g., float, string, boolean), mark it for removal\n        else:\n            return None\n\n    # Start the recursive extraction process with the initial tuple\n    return _extract_recursive(value)"}
{"task_id": "Mbpp/587", "solution": "class ConversionError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\ndef list_tuple(items: list) -> tuple:\n    \"\"\"Converts a list to a tuple, raising ConversionError for non-list inputs.\"\"\"\n    if not isinstance(items, list):\n        raise ConversionError(\"Input must be a list instance\")\n    return tuple(items)"}
{"task_id": "Mbpp/583", "solution": "_catalan_number_cache = {}\n\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Catalan number using the multiplicative binomial formula with caching.\n    \"\"\"\n    if n in _catalan_number_cache:\n        return _catalan_number_cache[n]\n\n    def _binomial_multiplicative(N: int, K: int) -> int:\n        if K < 0 or K > N:\n            return 0\n        K = min(K, N - K) # C(N, K) = C(N, N-K)\n        \n        result = 1\n        # Calculate C(N, K) using multiplicative formula product_{i=1..K} (N-K+i)/i.\n        for i in range(1, K + 1):\n            result = result * (N - K + i) // i\n        return result\n\n    # Catalan number formula: Cn = C(2n, n) / (n + 1).\n    computed_value = _binomial_multiplicative(2 * n, n) // (n + 1)\n    \n    _catalan_number_cache[n] = computed_value\n    return computed_value"}
{"task_id": "Mbpp/581", "solution": "import math\nimport json\nimport uuid\nfrom pathlib import Path\nfrom datetime import datetime\nfrom enum import Enum\n\nclass CalculationError(Exception):\n    \"\"\"Custom exception for calculation-related errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass MathUtils:\n    \"\"\"Utility class for mathematical computations.\"\"\"\n    @staticmethod\n    def compute_standard_slant(edge: float, height: float) -> float:\n        \"\"\"Calculates the standard slant height of a square pyramid.\"\"\"\n        return math.sqrt(height * height + (edge / 2.0) ** 2)\n\n    @staticmethod\n    def compute_lateral_area(edge: float, slant: float) -> float:\n        \"\"\"Calculates the lateral surface area of a square pyramid.\"\"\"\n        return 2.0 * edge * slant\n\ndef validate_positive_number(name: str, value: float) -> None:\n    \"\"\"Validates if a value is a positive number, raising CalculationError if not.\"\"\"\n    try:\n        v = float(value)\n    except (TypeError, ValueError):\n        raise CalculationError(f\"{name} must be numeric\")\n    if v <= 0:\n        raise CalculationError(f\"{name} must be > 0\")\n\nclass SquarePyramid:\n    \"\"\"Data model for a square pyramid with base edge and height.\"\"\"\n    def __init__(self, edge: float, height: float) -> None:\n        self.edge = edge\n        self.height = height\n\n    def to_dict(self) -> dict:\n        \"\"\"Returns a dictionary representation of the pyramid.\"\"\"\n        return {\"edge\": float(self.edge), \"height\": float(self.height)}\n\nclass SlantPolicy(Enum):\n    \"\"\"Enumeration for different slant height computation policies.\"\"\"\n    USE_HEIGHT_AS_SLANT = \"USE_HEIGHT_AS_SLANT\"\n    COMPUTE_STANDARD_SLANT = \"COMPUTE_STANDARD_SLANT\"\n\nclass CalculationRepository:\n    \"\"\"Handles persistence of calculation records to a JSON log file.\"\"\"\n    def __init__(self, path: Path):\n        self._path = Path(path)\n        self._ensure_file_exists()\n\n    def _ensure_file_exists(self) -> None:\n        \"\"\"Ensures the log file and its parent directories exist.\"\"\"\n        self._path.parent.mkdir(parents=True, exist_ok=True)\n        if not self._path.exists():\n            self._path.write_text(\"\")\n\n    def append(self, record: dict) -> None:\n        \"\"\"Appends a calculation record to the log file.\"\"\"\n        try:\n            rec = record.copy()\n            rec.setdefault(\"id\", str(uuid.uuid4()))\n            rec.setdefault(\"timestamp\", datetime.utcnow().isoformat() + \"Z\")\n            with self._path.open(\"a\", encoding=\"utf-8\") as fh:\n                fh.write(json.dumps(rec) + \"\\n\")\n        except OSError as e:\n            raise CalculationError(f\"Failed to persist record: {e}\")\n\nclass SurfaceAreaService:\n    \"\"\"Core business logic to compute the surface area of a square pyramid.\"\"\"\n    def __init__(self, repo: CalculationRepository = None, default_policy: SlantPolicy = SlantPolicy.USE_HEIGHT_AS_SLANT):\n        self.repo = repo or CalculationRepository(path=Path(\"./calc_log.json\"))\n        self.default_policy = default_policy\n\n    def compute_surface_area(self, pyramid: SquarePyramid, policy: SlantPolicy = None) -> float:\n        \"\"\"Computes the surface area based on the chosen slant policy.\"\"\"\n        policy = policy or self.default_policy\n        \n        if policy == SlantPolicy.USE_HEIGHT_AS_SLANT:\n            slant = pyramid.height\n        elif policy == SlantPolicy.COMPUTE_STANDARD_SLANT:\n            slant = MathUtils.compute_standard_slant(pyramid.edge, pyramid.height)\n        else:\n            raise CalculationError(\"Unknown slant policy\")\n        \n        lateral = MathUtils.compute_lateral_area(pyramid.edge, slant)\n        base = pyramid.edge ** 2\n        result = base + lateral\n        \n        self.repo.append({\"edge\": pyramid.edge, \"height\": pyramid.height, \"policy\": policy.value, \"result\": result})\n        return result\n\nclass SurfaceAreaController:\n    \"\"\"Public API for computing surface area, handling input validation and service orchestration.\"\"\"\n    def __init__(self, service: SurfaceAreaService):\n        self._service = service\n\n    def surface_Area(self, edge: float, height: float, policy: SlantPolicy | None = None) -> float:\n        \"\"\"Validates inputs, creates pyramid model, and calls the service to compute surface area.\"\"\"\n        validate_positive_number(\"edge\", edge)\n        validate_positive_number(\"height\", height)\n        pyramid = SquarePyramid(edge=float(edge), height=float(height))\n        return self._service.compute_surface_area(pyramid, policy)\n\n_default_service = SurfaceAreaService()\n_controller = SurfaceAreaController(_default_service)\n\ndef surface_Area(edge: float, height: float) -> float:\n    \"\"\"\n    Calculates the surface area of a square pyramid given its base edge and height.\n    By default, assumes height is used as slant height to match the user's assertion.\n    \"\"\"\n    return _controller.surface_Area(edge, height)"}
{"task_id": "Mbpp/585", "solution": "import math\nimport json\nfrom dataclasses import dataclass\nfrom typing import List, Union, Dict\n\nclass InvalidDataError(Exception):\n    \"\"\"Custom exception for invalid data inputs.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n@dataclass\nclass Item:\n    \"\"\"Domain model for an item with name and price.\"\"\"\n    name: str\n    price: float\n\n    def to_dict(self) -> dict:\n        return {\"name\": self.name, \"price\": self.price}\n\n    @staticmethod\n    def from_dict(d: dict) -> \"Item\":\n        return Item(name=d[\"name\"], price=float(d[\"price\"]))\n\nclass Validator:\n    \"\"\"Provides validation helpers for item dicts and input 'n'.\"\"\"\n    @staticmethod\n    def validate_item_dict(d: dict) -> None:\n        if not isinstance(d, dict):\n            raise InvalidDataError(\"Item must be an object/dict\")\n        if \"name\" not in d or not isinstance(d[\"name\"], str):\n            raise InvalidDataError(\"Item missing 'name' string\")\n        if \"price\" not in d:\n            raise InvalidDataError(\"Item missing 'price'\")\n        try:\n            p = float(d[\"price\"])\n        except Exception:\n            raise InvalidDataError(\"Item 'price' is not numeric\")\n        if math.isinf(p) or math.isnan(p):\n            raise InvalidDataError(\"Item 'price' must be finite\")\n\n    @staticmethod\n    def validate_n(n: int) -> None:\n        if not isinstance(n, int) or n < 0:\n            raise InvalidDataError(\"n must be an integer >= 0\")\n\nclass DatasetRepository:\n    \"\"\"Loads and validates datasets into Item instances.\"\"\"\n    def __init__(self, encoding: str = \"utf-8\"):\n        self.encoding = encoding\n\n    def load_from_list(self, data: list) -> list[Item]:\n        items = []\n        for d in data:\n            Validator.validate_item_dict(d)\n            items.append(Item.from_dict(d))\n        return items\n\nclass PricingService:\n    \"\"\"Provides business logic to compute top-n most expensive items.\"\"\"\n    DEFAULT_TIEBREAKER = \"name\"\n\n    def get_top_n(self, items: List[Item], n: int) -> List[Item]:\n        Validator.validate_n(n)\n        if n == 0:\n            return []\n        # Sort by price descending, then by name ascending for deterministic tie-breaking.\n        sorted_items = sorted(items, key=lambda i: (-i.price, i.name))\n        return sorted_items[:n]\n\n    def expensive_items_raw(self, data: List[Dict], n: int) -> List[Dict]:\n        \"\"\"\n        Converts a list of dicts to Item objects, finds top-n, and converts back to dicts.\n        Uses DatasetRepository for initial validation and conversion.\n        \"\"\"\n        repo = DatasetRepository()\n        items = repo.load_from_list(data)\n        top_items = self.get_top_n(items, n)\n        return [i.to_dict() for i in top_items]\n\ndef expensive_items(dataset: List[Dict], n: int) -> List[Dict]:\n    \"\"\"\n    Finds the n most expensive items in a given dataset.\n\n    The dataset is expected to be a list of dictionaries, each with 'name' (str)\n    and 'price' (numeric) fields.\n    \"\"\"\n    service = PricingService()\n    return service.expensive_items_raw(dataset, n)"}
{"task_id": "Mbpp/589", "solution": "import math\n\ndef perfect_squares(start, end):\n    \"\"\"\n    Finds perfect squares between two given numbers, inclusive.\n    Assumes start and end are integers and start <= end.\n    \"\"\"\n    perfect_squares_list = []\n    # Ensure we start checking roots from a non-negative number\n    effective_start = max(start, 0)\n\n    # Calculate the smallest integer root whose square is >= effective_start\n    # math.isqrt gives floor(sqrt(n)). If r*r < n, we need to check (r+1)^2\n    r_start = math.isqrt(effective_start)\n    if r_start * r_start < effective_start:\n        r_start += 1\n    \n    # Calculate the largest integer root whose square is <= end\n    # If end is negative, math.isqrt would raise an error, but we've handled\n    # negative start by setting effective_start to 0. If end itself is negative,\n    # then r_end should yield no squares.\n    if end < 0:\n        r_end = -1 # ensures range(r_start, r_end+1) is empty\n    else:\n        r_end = math.isqrt(end)\n    \n    for r in range(r_start, r_end + 1):\n        square = r * r\n        # Add the square if it falls within the original inclusive range [start, end]\n        if start <= square <= end:\n            perfect_squares_list.append(square)\n\n    return perfect_squares_list"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(arr, n):\n    \"\"\"\n    Splits a list at the nth element and adds the first part to the end (left rotation).\n    \"\"\"\n    if not arr:\n        return []\n\n    # Normalize n to be within the bounds of the list length\n    # This handles negative n and n larger than the list length.\n    n_norm = n % len(arr)\n\n    # Perform the rotation by slicing and concatenating\n    return arr[n_norm:] + arr[:n_norm]"}
