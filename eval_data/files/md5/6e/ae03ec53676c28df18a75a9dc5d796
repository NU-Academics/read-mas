{"task_id": "Mbpp/592", "solution": "import math\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients using the closed-form identity.\n    For n >= 1, the sum is C(2n, n-1); for n = 0, the sum is 0.\n    \"\"\"\n    if n == 0:\n        return 0\n    return math.comb(2 * n, n - 1)"}
{"task_id": "Mbpp/591", "solution": "def swap_List(lst):\n    \"\"\"Interchanges the first and last elements in a list.\n    Returns a new list, leaving the original list unchanged.\n    \"\"\"\n    new_list = list(lst)  # Create a shallow copy of the list\n\n    if len(new_list) >= 2:\n        new_list[0], new_list[-1] = new_list[-1], new_list[0]\n\n    return new_list"}
{"task_id": "Mbpp/594", "solution": "from typing import Sequence, Optional\n\nclass InputValidationError(Exception):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\nclass NotFoundError(Exception):\n    \"\"\"Exception raised when a required number (even or odd) is not found.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\nclass Utils:\n    \"\"\"Provides static methods to find the first odd or even number in a sequence.\"\"\"\n    @staticmethod\n    def find_first_odd(numbers: Sequence[int]) -> int:\n        for v in numbers:\n            if v % 2 != 0:\n                return v\n        raise NotFoundError(\"No odd number found\")\n\n    @staticmethod\n    def find_first_even(numbers: Sequence[int]) -> int:\n        for v in numbers:\n            if v % 2 == 0:\n                return v\n        raise NotFoundError(\"No even number found\")\n\nclass InputValidator:\n    \"\"\"Validates if the input is a sequence of integers.\"\"\"\n    def validate(self, numbers: Sequence[int]) -> None:\n        if not isinstance(numbers, (list, tuple)):\n            raise InputValidationError(\"Input must be a list or tuple of ints\")\n        for idx, v in enumerate(numbers):\n            if not isinstance(v, int):\n                raise InputValidationError(f\"Element at index {idx} is not int: {v}\")\n\nclass DiffFinder:\n    \"\"\"Calculates the difference between the first even and first odd numbers in a list.\"\"\"\n    def __init__(self, validator: Optional[InputValidator] = None) -> None:\n        self._validator = validator or InputValidator()\n\n    def find_difference(self, numbers: Sequence[int]) -> int:\n        self._validator.validate(numbers)\n        odd = Utils.find_first_odd(numbers)\n        even = Utils.find_first_even(numbers)\n        return even - odd\n\ndef diff_even_odd(numbers: Sequence[int]) -> int:\n    \"\"\"\n    Finds the difference of the first even and first odd number of a given list.\n    The difference is calculated as (first even - first odd).\n    \"\"\"\n    return DiffFinder(InputValidator()).find_difference(numbers)"}
