{"task_id": "Mbpp/460", "solution": "from typing import List, Any, Iterable, Sequence, TypeVar\n\nclass ExtractError(Exception):\n    \"\"\"Custom exception for extraction-related errors.\"\"\"\n    pass\n\n_T = TypeVar('_T')\ndef _to_indexable(seq: Iterable[_T]) -> Sequence[_T]:\n    \"\"\"Converts an iterable to an indexable sequence if it's not already.\"\"\"\n    if hasattr(seq, '__getitem__') and hasattr(seq, '__len__'):\n        return seq\n    try:\n        return list(seq)\n    except TypeError as e:\n        raise ExtractError(f\"Input element is not an iterable: {e}\") from e\n\ndef Extract(lists: List[List[Any]]) -> List[Any]:\n    \"\"\"\n    Extracts the first element from each sublist in a nested list.\n    Raises ExtractError if the input is None or an inner sublist is empty.\n    \"\"\"\n    if lists is None:\n        raise ExtractError(\"Input cannot be None\")\n\n    result: List[Any] = []\n    for idx, inner in enumerate(lists):\n        seq: Sequence[Any] = _to_indexable(inner)\n        if len(seq) == 0:\n            raise ExtractError(f\"Empty sublist at index {idx}\")\n        result.append(seq[0])\n    return result"}
{"task_id": "Mbpp/462", "solution": "def combinations_list(items):\n    \"\"\"\n    Compute all combinations (subsets) of a list using an iterative approach.\n    The order is deterministic: for each item, new combinations are formed by\n    prepending the item to all existing combinations.\n    \"\"\"\n    result = [[]]\n    for item in items:\n        # Create new combinations by prepending the current item to all existing combinations\n        new_combinations = [[item] + combo for combo in result]\n        # Add these new combinations to the result list\n        result.extend(new_combinations)\n    return result"}
{"task_id": "Mbpp/463", "solution": "import math\n\ndef max_subarray_product(nums: list[int]) -> int:\n    \"\"\"\n    Finds the maximum product subarray in the given list of integers.\n    Handles positive, negative numbers, and zeros.\n    \"\"\"\n    if not nums:\n        return 0\n\n    max_so_far = nums[0]\n    min_so_far = nums[0]\n    result = nums[0]\n\n    for i in range(1, len(nums)):\n        curr = nums[i]\n        \n        # Swapping max_so_far and min_so_far if curr is negative\n        # because a negative number times a negative number gives a positive number.\n        if curr < 0:\n            max_so_far, min_so_far = min_so_far, max_so_far\n        \n        # Update max_so_far and min_so_far\n        max_so_far = max(curr, max_so_far * curr)\n        min_so_far = min(curr, min_so_far * curr)\n        \n        # Update the overall result\n        result = max(result, max_so_far)\n        \n    return result"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(numbers: list) -> bool:\n    \"\"\"\n    Checks if the given list contains consecutive numbers.\n    The order of numbers in the list does not matter.\n    \"\"\"\n    if not numbers:\n        return False\n\n    # Use a set to handle duplicates and quickly get unique elements.\n    unique_numbers = set(numbers)\n\n    # If there are duplicates, it's not strictly consecutive.\n    if len(unique_numbers) != len(numbers):\n        return False\n\n    # Calculate the minimum and maximum values.\n    min_val = min(unique_numbers)\n    max_val = max(unique_numbers)\n\n    # A sequence is consecutive if (max - min + 1) equals the number of unique elements.\n    return (max_val - min_val + 1) == len(unique_numbers)"}
{"task_id": "Mbpp/471", "solution": "from typing import List\n\ndef find_remainder(arr: List[int], n: int) -> int:\n    \"\"\"\n    Calculates the product of array elements modulo n.\n    It performs modular reduction at each step to manage large intermediate products.\n    \"\"\"\n    # According to business rules, the product of an empty array is 1.\n    if not arr:\n        return 1 % n\n\n    result = 1\n    for x in arr:\n        # Apply modulo n to each element before multiplication\n        # and then apply modulo n to the product to keep numbers manageable.\n        result = (result * (x % n)) % n\n    \n    return result"}
{"task_id": "Mbpp/465", "solution": "from typing import Any, Mapping, Optional, Set, Dict, Sequence\n\ndef drop_empty(mapping: Mapping[str, Any], recursive: bool = True, inplace: bool = False, empties: Optional[Set[Any]] = None) -> Dict[str, Any]:\n    \"\"\"\n    Drops empty items from a dictionary, optionally doing so recursively.\n    The `inplace` parameter is kept for signature consistency but this implementation always returns a new dictionary.\n    \"\"\"\n\n    DEFAULT_EMPTY_SET = {None, \"\", (), [], {}, set()}\n\n    def _is_empty(value: Any, effective_empties: Set[Any]) -> bool:\n        \"\"\"Determines if a given value is considered empty based on a set of 'empty' sentinels.\"\"\"\n        try:\n            if value in effective_empties:\n                return True\n        except TypeError:\n            pass # Value is unhashable, skip `in` check, proceed to type checks\n\n        if isinstance(value, Mapping):\n            return len(value) == 0\n        if isinstance(value, (list, tuple, set)):\n            return len(value) == 0\n        if isinstance(value, str):\n            return value == \"\"\n        return False\n\n    def _drop_empty_copy_recursive(obj: Any, effective_empties: Set[Any], recursive_flag: bool) -> Any:\n        \"\"\"Recursively copies an object, dropping empty items from mappings and sequences.\"\"\"\n        if isinstance(obj, Mapping):\n            new_obj = {}\n            for k, v in obj.items():\n                processed_v = _drop_empty_copy_recursive(v, effective_empties, recursive_flag) if recursive_flag else v\n                if not _is_empty(processed_v, effective_empties):\n                    new_obj[k] = processed_v\n            return new_obj\n        elif isinstance(obj, (list, tuple, set)):\n            new_items = []\n            for item in obj:\n                processed_item = _drop_empty_copy_recursive(item, effective_empties, recursive_flag) if recursive_flag else item\n                if not _is_empty(processed_item, effective_empties):\n                    new_items.append(processed_item)\n            \n            if isinstance(obj, list):\n                return new_items\n            elif isinstance(obj, tuple):\n                return tuple(new_items)\n            elif isinstance(obj, set):\n                # Ensure all items are hashable for set conversion\n                try:\n                    return set(new_items)\n                except TypeError:\n                    # If some item became unhashable after processing (e.g., a list inside a set)\n                    # return as a list or handle as per specific design for such edge cases.\n                    # For this scope, a list is a reasonable fallback if it fails.\n                    return new_items\n        \n        return obj # For non-mapping/non-sequence objects, return them as is.\n\n    effective_empties = set(DEFAULT_EMPTY_SET)\n    if empties:\n        effective_empties.update(empties)\n\n    # The `inplace` parameter is included in the signature as per design,\n    # but this specific function implementation returns a new dictionary,\n    # effectively treating `inplace=True` the same as `inplace=False`.\n    # This aligns with the provided assertion expecting a new dictionary return.\n    \n    return _drop_empty_copy_recursive(mapping, effective_empties, recursive)"}
{"task_id": "Mbpp/470", "solution": "from typing import Tuple, List, Union\n\nNumber = Union[int, float]\n\ndef add_pairwise(input_tuple: Tuple[Number, ...]) -> Tuple[Number, ...]:\n    \"\"\"\n    Computes the pairwise addition of neighboring elements of a given tuple.\n    Resulting types are coerced to int if all inputs were int and all sums are whole numbers, otherwise to float.\n    \"\"\"\n    sums: List[Number] = []\n    for a, b in zip(input_tuple, input_tuple[1:]):\n        sums.append(a + b)\n\n    all_inputs_are_int = True\n    for x in input_tuple:\n        if not isinstance(x, int):\n            all_inputs_are_int = False\n            break\n\n    all_sums_are_integer_values = True\n    for s in sums:\n        if not float(s).is_integer():\n            all_sums_are_integer_values = False\n            break\n\n    if all_inputs_are_int and all_sums_are_integer_values:\n        return tuple(int(s) for s in sums)\n    else:\n        return tuple(float(s) for s in sums)"}
