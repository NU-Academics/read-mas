{"task_id": "Mbpp/84", "solution": "class InvalidArgumentError(Exception):\n    \"\"\"Custom exception for invalid function arguments.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\ndef validate_positive_int(value: any, name: str = 'n') -> int:\n    \"\"\"Validates that the input value is a positive integer.\"\"\"\n    if not isinstance(value, int):\n        try:\n            value = int(value)\n        except (ValueError, TypeError):\n            raise InvalidArgumentError(f\"'{name}' must be an integer.\")\n    if value < 1:\n        raise InvalidArgumentError(f\"'{name}' must be a positive integer (>= 1).\")\n    return value\n\nclass SequenceService:\n    \"\"\"Service for computing Newman-Conway sequence numbers using different strategies.\"\"\"\n    def __init__(self, cache_repo=None) -> None:\n        self._cache_repo = cache_repo\n        self._memo_cache = {1: 1, 2: 1} # Initialize for memoized method\n\n    def get(self, n: int, method: str = 'iterative') -> int:\n        \"\"\"\n        Retrieves the nth Newman-Conway number, handling validation and method selection.\n        \"\"\"\n        n = validate_positive_int(n, 'n')\n\n        # Cache check (simplified, as _cache_repo is None for default service)\n        if self._cache_repo:\n            cached_value = self._cache_repo.get(n)\n            if cached_value is not None:\n                return cached_value\n\n        value = 0\n        if method == 'iterative':\n            value = self.compute_iterative(n)\n        elif method == 'memoized':\n            value = self.compute_memoized(n)\n        else:\n            raise ValueError(f\"Unsupported computation method: {method}\")\n\n        if self._cache_repo:\n            self._cache_repo.set(n, value)\n        return value\n\n    def compute_iterative(self, n: int) -> int:\n        \"\"\"Computes the nth Newman-Conway number iteratively using dynamic programming.\"\"\"\n        if n <= 2:\n            return 1\n\n        a = [0] * (n + 1)\n        a[1], a[2] = 1, 1\n\n        for i in range(3, n + 1):\n            prev_term = a[i - 1]\n            a[i] = a[prev_term] + a[i - prev_term]\n        return a[n]\n\n    def compute_memoized(self, n: int) -> int:\n        \"\"\"Computes the nth Newman-Conway number using recursive memoization.\"\"\"\n        memo = self._memo_cache # Use the instance's memo cache\n\n        def _rec(k: int) -> int:\n            if k in memo:\n                return memo[k]\n\n            # Recurrence: a(k) = a(a(k-1)) + a(k-a(k-1))\n            val_k_minus_1 = _rec(k - 1)\n            term1 = _rec(val_k_minus_1)\n            term2 = _rec(k - val_k_minus_1)\n            \n            memo[k] = term1 + term2\n            return memo[k]\n        \n        return _rec(n)\n\n_default_service = SequenceService()\n\ndef sequence(n: int, method: str = 'iterative') -> int:\n    \"\"\"\n    Return nth Newman-Conway number (1-indexed).\n    \"\"\"\n    return _default_service.get(n, method=method)"}
