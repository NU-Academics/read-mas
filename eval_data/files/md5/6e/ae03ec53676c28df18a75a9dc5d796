{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n    The formula used is pi * r * sqrt(r^2 + h^2).\n    \"\"\"\n    slant_height = math.sqrt(r*r + h*h)\n    lateral_area = math.pi * r * slant_height\n    return lateral_area"}
{"task_id": "Mbpp/730", "solution": "from typing import Iterable, List, TypeVar\n\nT = TypeVar(\"T\")\n_NO_VALUE = object()\n\ndef consecutive_duplicates(items: Iterable[T]) -> List[T]:\n    \"\"\"Remove consecutive duplicates from an iterable, preserving order.\n\n    Returns a new list with adjacent duplicate items removed.\n    \"\"\"\n    result: List[T] = []\n    last_item = _NO_VALUE\n    for item in items:\n        if last_item is _NO_VALUE or item != last_item:\n            result.append(item)\n            last_item = item\n    return result"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(text: str) -> str:\n    \"\"\"\n    Replaces spaces, commas, or dots in a string with a colon using str.translate.\n    \"\"\"\n    translation_map = {\n        ord(' '): ':',\n        ord(','): ':',\n        ord('.'): ':',\n    }\n    return text.translate(translation_map)"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr, value):\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array using binary search.\n    Returns -1 if the value is not found.\n    \"\"\"\n    left = 0\n    right = len(arr) - 1\n    result = -1\n\n    while left <= right:\n        mid = (left + right) // 2\n        if arr[mid] == value:\n            result = mid\n            right = mid - 1  # Try to find an earlier occurrence in the left half\n        elif arr[mid] < value:\n            left = mid + 1\n        else:  # arr[mid] > value\n            right = mid - 1\n            \n    return result"}
{"task_id": "Mbpp/734", "solution": "from typing import List\n\ndef sum_Of_Subarray_Prod(arr: List[int]) -> int:\n    \"\"\"\n    Calculates the sum of products of all contiguous sublists (subarrays) of a given list.\n    Uses a dynamic programming approach to efficiently compute products.\n    \"\"\"\n    if not arr:\n        return 0\n\n    total_sum_of_products = 0\n    # prev_products stores the products of all subarrays ending at the previous element.\n    prev_products: List[int] = []\n\n    for x in arr:\n        # new_products will store the products of all subarrays ending at the current element 'x'.\n        # This includes 'x' itself and 'x' multiplied by each product from prev_products.\n        new_products = [x] + [p * x for p in prev_products]\n        total_sum_of_products += sum(new_products)\n        prev_products = new_products\n        \n    return total_sum_of_products"}
{"task_id": "Mbpp/735", "solution": "import math\n\ndef toggle_middle_bits(n: int) -> int:\n    \"\"\"\n    Toggles all bits of the number except the most significant (first) and least significant (last) bits.\n    Returns the number unchanged if its bit length is 2 or less.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n == 0:\n        return 0\n\n    bit_length = n.bit_length()\n\n    if bit_length <= 2:\n        return n\n\n    # Create a mask with 1s from bit position 1 to bit_length - 2\n    # This excludes the LSB (position 0) and MSB (position bit_length - 1)\n    \n    # 1. Create a mask of 'bit_length - 1' ones from LSB: (1 << (bit_length - 1)) - 1\n    # Example: if bit_length = 4 (number 1001), this gives 0111\n    \n    # 2. Clear the LSB (position 0) by ANDing with ~1 (which is ...1110 in 2's complement)\n    # Example: 0111 & ~1 (effectively 0110) gives 0110\n    \n    mask = ((1 << (bit_length - 1)) - 1) & ~1\n\n    return n ^ mask"}
