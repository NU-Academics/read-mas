{"task_id": "Mbpp/622", "solution": "from typing import List, Union\n\nNumber = Union[int, float]\n\ndef get_median(a: List[Number], b: List[Number], n: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of same size n using a divide-and-conquer approach.\n    \"\"\"\n\n    def _median_single(lst: List[Number]) -> float:\n        \"\"\"Helper to find the median of a single sorted list.\"\"\"\n        length = len(lst)\n        mid = length // 2\n        if length % 2 == 1:\n            return float(lst[mid])\n        return (lst[mid - 1] + lst[mid]) / 2.0\n\n    def _median_recursive(current_a: List[Number], current_b: List[Number], current_n: int) -> float:\n        \"\"\"Recursive helper for the O(log n) median finding algorithm.\"\"\"\n        if current_n == 1:\n            return (current_a[0] + current_b[0]) / 2.0\n        if current_n == 2:\n            return (max(current_a[0], current_b[0]) + min(current_a[1], current_b[1])) / 2.0\n\n        m1 = _median_single(current_a)\n        m2 = _median_single(current_b)\n\n        if m1 == m2:\n            return m1\n\n        if m1 < m2:\n            if current_n % 2 == 0:\n                # For even N, discard from a[0...N/2-2] and b[N/2+1...N-1].\n                # New effective length becomes N/2 + 1.\n                return _median_recursive(current_a[current_n // 2 - 1:], current_b[:current_n // 2 + 1], current_n // 2 + 1)\n            else:\n                # For odd N, discard from a[0...N/2-1] and b[N/2+1...N-1].\n                # New effective length becomes N/2 + 1.\n                return _median_recursive(current_a[current_n // 2:], current_b[:current_n // 2 + 1], current_n // 2 + 1)\n        else: # m1 > m2\n            if current_n % 2 == 0:\n                # For even N, discard from a[N/2+1...N-1] and b[0...N/2-2].\n                # New effective length becomes N/2 + 1.\n                return _median_recursive(current_a[:current_n // 2 + 1], current_b[current_n // 2 - 1:], current_n // 2 + 1)\n            else:\n                # For odd N, discard from a[N/2+1...N-1] and b[0...N/2-1].\n                # New effective length becomes N/2 + 1.\n                return _median_recursive(current_a[:current_n // 2 + 1], current_b[current_n // 2:], current_n // 2 + 1)\n\n    return _median_recursive(a, b, n)"}
{"task_id": "Mbpp/623", "solution": "from datetime import datetime\nfrom typing import Iterable, Any, List, Union\n\nclass InvalidInputError(ValueError):\n    \"\"\"Raised when top-level input is not iterable or missing.\"\"\"\n    pass\n\nclass ElementTypeError(TypeError):\n    \"\"\"Raised when an element in the input list is not numeric.\"\"\"\n    pass\n\nclass InvalidExponentError(TypeError):\n    \"\"\"Raised when the exponent is not an integer.\"\"\"\n    pass\n\nclass PowerRepository:\n    \"\"\"Abstract base class for power calculation persistence.\"\"\"\n    def save(self, record: dict) -> None:\n        raise NotImplementedError\n\nclass InMemoryRepository(PowerRepository):\n    \"\"\"In-memory implementation of PowerRepository.\"\"\"\n    def __init__(self) -> None:\n        self._storage: List[dict] = []\n    def save(self, record: dict) -> None:\n        self._storage.append(record)\n    def get_all(self) -> List[dict]:\n        return list(self._storage)\n\nclass PowerService:\n    \"\"\"Core business logic for computing n-th powers.\"\"\"\n    def __init__(self, repository: PowerRepository) -> None:\n        self._repository = repository\n\n    def nth_nums(self, numbers: Iterable[Union[float, int]], n: int) -> List[Union[float, int]]:\n        \"\"\"Computes the n-th power of each number in the list, optionally persisting the operation.\"\"\"\n        nums_list = list(numbers)\n        results = [x ** n for x in nums_list]\n        record = {\n            \"timestamp\": datetime.utcnow().isoformat() + \"Z\",\n            \"input\": nums_list,\n            \"exponent\": n,\n            \"output\": results,\n        }\n        try:\n            self._repository.save(record)\n        except Exception:\n            # Default policy: do not fail computation because of logging issues.\n            pass\n        return results\n\ndef validate_numbers(numbers: Iterable[Any]) -> List[Union[float, int]]:\n    \"\"\"Ensures input is an iterable of numbers (int or float).\"\"\"\n    try:\n        iterable = list(numbers)\n    except TypeError:\n        raise InvalidInputError(\"numbers must be iterable\")\n    out = []\n    for idx, x in enumerate(iterable):\n        if not isinstance(x, (int, float)):\n            raise ElementTypeError(f\"element at index {idx} is not numeric: {x!r}\")\n        out.append(x)\n    return out\n\ndef validate_exponent(n: Any) -> int:\n    \"\"\"Ensures the exponent n is an integer.\"\"\"\n    if not isinstance(n, int):\n        raise InvalidExponentError(\"exponent must be an integer\")\n    return n\n\ndef nth_nums(numbers: Iterable[Union[float, int]], n: int) -> List[Union[float, int]]:\n    \"\"\"Computes the n-th power for each number in a list.\"\"\"\n    validated_numbers = validate_numbers(numbers)\n    validated_n = validate_exponent(n)\n    svc = PowerService(InMemoryRepository())\n    return svc.nth_nums(validated_numbers, validated_n)"}
