{"task_id": "Mbpp/740", "solution": "from typing import Any, Dict, Tuple\nfrom .controllers import TupleToDictController\nfrom .services import TupleConverterService\n\ndef tuple_to_dict(input_tuple: Tuple[Any, ...]) -> Dict[Any, Any]:\n    \"\"\"\n    Converts a tuple of adjacent elements into a key-value dictionary.\n    This function acts as a facade to the core conversion service.\n    \"\"\"\n    service = TupleConverterService()\n    controller = TupleToDictController(service)\n    return controller.convert_and_return(input_tuple)"}
{"task_id": "Mbpp/741", "solution": "from typing import Optional, Any\n\nclass StringInputError(ValueError):\n    \"\"\"Exception raised for invalid string input types.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass StringUtils:\n    \"\"\"Utility methods for string operations, including type validation.\"\"\"\n    @staticmethod\n    def is_str(s: Any) -> bool:\n        return isinstance(s, str)\n\n    @staticmethod\n    def normalize(s: str) -> str:\n        # Placeholder for normalization, currently returns the string unchanged.\n        return s\n\nclass StringCheckResult:\n    \"\"\"Data Transfer Object holding the result of a string uniformity check.\"\"\"\n    def __init__(self, input_value: str, all_same: bool, representative: Optional[str] = None) -> None:\n        self.input_value = input_value\n        self.all_same = all_same\n        self.representative = representative\n\n    def to_dict(self) -> dict:\n        return {\n            \"input_value\": self.input_value,\n            \"all_same\": self.all_same,\n            \"representative\": self.representative,\n        }\n\nclass StringAnalyzer:\n    \"\"\"Core logic to determine if all characters in a string are identical.\"\"\"\n    def __init__(self, utils: Optional[StringUtils] = None) -> None:\n        self._utils = utils or StringUtils()\n\n    def all_characters_same(self, s: str) -> StringCheckResult:\n        self._validate(s)\n        if s == \"\":\n            return StringCheckResult(s, False, None)\n        first_char = s[0]\n        for char in s:\n            if char != first_char:\n                return StringCheckResult(s, False, None)\n        return StringCheckResult(s, True, first_char)\n\n    def _validate(self, s: str) -> None:\n        if not self._utils.is_str(s):\n            raise StringInputError(\"Input must be a string (str type).\")\n\ndef all_Characters_Same(s: str) -> bool:\n    \"\"\"Checks if all characters in the given string are the same.\"\"\"\n    analyzer = StringAnalyzer()\n    result = analyzer.all_characters_same(s)\n    return result.all_same"}
{"task_id": "Mbpp/743", "solution": "from typing import List, Sequence, TypeVar\n\nT = TypeVar(\"T\")\n\ndef rotate_right(lst: Sequence[T], k: int) -> List[T]:\n    \"\"\"Rotates a list to the right by k positions.\"\"\"\n    n = len(lst)\n    if n == 0:\n        return []\n    \n    # Calculate the effective rotation amount.\n    # Python's modulo operator handles negative k correctly for right shifts.\n    r = k % n \n\n    if r == 0:\n        # If effective rotation is 0, return a shallow copy of the original list.\n        return list(lst)\n    \n    # Slice the list into two parts and concatenate them.\n    # The last `r` elements come first, followed by the first `n-r` elements.\n    return list(lst[-r:]) + list(lst[:-r])"}
{"task_id": "Mbpp/745", "solution": "class InvalidRangeError(ValueError):\n    \"\"\"Exception raised for invalid range inputs.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\ndef digits_of(n: int) -> list[int]:\n    \"\"\"Returns a list of digits for a positive integer n.\"\"\"\n    return [int(ch) for ch in str(abs(n))]\n\ndef is_divisible_by_digits(n: int) -> bool:\n    \"\"\"Checks if a number is divisible by every non-zero digit it contains.\"\"\"\n    # As per business rules, numbers containing '0' are excluded.\n    for d in digits_of(n):\n        if d == 0:\n            return False  # Exclude numbers containing digit '0'\n        if n % d != 0:\n            return False  # Not divisible by this digit\n    return True\n\ndef divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by\n    every non-zero digit it contains.\n    \"\"\"\n    if startnum > endnum:\n        raise InvalidRangeError(\"startnum cannot be greater than endnum.\")\n    if startnum < 1:\n        raise InvalidRangeError(\"startnum must be greater than or equal to 1.\")\n\n    result: list[int] = []\n    for n in range(startnum, endnum + 1):\n        if is_divisible_by_digits(n):\n            result.append(n)\n    return result"}
{"task_id": "Mbpp/748", "solution": "import re\n\ndef capital_words_spaces(text: str) -> str:\n    \"\"\"\n    Inserts spaces between words indicated by capital letters, handling acronyms.\n    \"\"\"\n    s = text\n    # Split aB -> a B\n    s = re.sub(r'(?<=[a-z])(?=[A-Z])', r' ', s)\n    # Split HTTPServer -> HTTP Server\n    s = re.sub(r'(?<=[A-Z])(?=[A-Z][a-z])', r' ', s)\n    # Normalize spaces: join parts with a single space, removing empty parts\n    return ' '.join(part for part in s.split(' ') if part)"}
