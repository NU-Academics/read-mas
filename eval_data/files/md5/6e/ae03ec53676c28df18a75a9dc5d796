{"task_id": "Mbpp/166", "solution": "from typing import List\n\ndef find_even_pair(nums: List[int]) -> int:\n    \"\"\"\n    Counts the number of unordered pairs of integers in a list that XOR to an even number.\n    Pairs XOR to an even number if and only if both integers have the same parity.\n    \"\"\"\n    evens = 0\n    odds = 0\n    for x in nums:\n        if (x & 1) == 0:  # Check if the number is even using bitwise AND\n            evens += 1\n        else:\n            odds += 1\n\n    # The number of pairs from 'n' items is n * (n - 1) // 2\n    # Sum pairs of even numbers and pairs of odd numbers.\n    even_pairs = evens * (evens - 1) // 2\n    odd_pairs = odds * (odds - 1) // 2\n\n    return even_pairs + odd_pairs"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"Finds the smallest power of 2 greater than or equal to n.\"\"\"\n    if n <= 1:\n        return 1\n\n    # If n is already a power of 2, return n.\n    if (n & (n - 1)) == 0:\n        return n\n\n    # Otherwise, propagate the most significant bit to the right\n    # to form a number with all bits set up to the MSB, then add 1.\n    v = n - 1\n    shift = 1\n    while True:\n        v |= (v >> shift)\n        if (v >> shift) == 0:\n            break\n        shift <<= 1\n    return v + 1"}
{"task_id": "Mbpp/170", "solution": "from typing import List, Optional, Sequence, Tuple\n\nclass SumRangeError(Exception):\n    \"\"\"Base exception for the sumrange library.\"\"\"\n    pass\n\nclass TypeValidationError(SumRangeError):\n    \"\"\"Raised when an input has an incorrect type.\"\"\"\n    pass\n\nclass InvalidIndexError(SumRangeError):\n    \"\"\"Raised when indices are out of bounds or form an invalid range.\"\"\"\n    pass\n\nclass EmptyListError(SumRangeError):\n    \"\"\"Raised when the input list of numbers is empty.\"\"\"\n    pass\n\nclass IndexValidator:\n    \"\"\"Validates types and normalizes indices for list operations.\"\"\"\n\n    def validate_numbers(self, numbers: Sequence) -> None:\n        \"\"\"Ensures 'numbers' is a non-empty sequence of numeric elements.\"\"\"\n        if not hasattr(numbers, \"__len__\"):\n            raise TypeValidationError(\"numbers must be a sequence\")\n        if len(numbers) == 0:\n            raise EmptyListError(\"numbers list is empty\")\n        for i, v in enumerate(numbers):\n            if not isinstance(v, (int, float)):\n                raise TypeValidationError(f\"element at {i} is not numeric\")\n\n    def validate_indices(self, start: int, end: int) -> None:\n        \"\"\"Ensures 'start' and 'end' are integers.\"\"\"\n        if not isinstance(start, int) or not isinstance(end, int):\n            raise TypeValidationError(\"start and end must be integers\")\n\n    def normalize_indices(self, start: int, end: int, length: int) -> Tuple[int,int]:\n        \"\"\"\n        Converts negative indices to positive equivalents, clamps them within bounds,\n        and ensures the start index does not exceed the end index.\n        \"\"\"\n        s = start + length if start < 0 else start\n        e = end + length if end < 0 else end\n\n        # Clamp indices to be within [0, length-1] for actual element access.\n        s = max(0, min(s, length - 1))\n        e = max(0, min(e, length - 1))\n\n        if s > e:\n            raise InvalidIndexError(\"start index must be <= end index after normalization\")\n        return (s, e)\n\nclass SumService:\n    \"\"\"Provides the core logic for summing numbers within a specified range.\"\"\"\n\n    def __init__(self, validator: Optional[IndexValidator]=None) -> None:\n        \"\"\"Initializes SumService with an optional IndexValidator.\"\"\"\n        self.validator = validator or IndexValidator()\n\n    def sum_range(self, numbers: List[int], start: int, end: int) -> int:\n        \"\"\"\n        Calculates the sum of numbers in the list from 'start' to 'end' inclusive.\n        Validates inputs and normalizes indices before summing.\n        \"\"\"\n        self.validator.validate_numbers(numbers)\n        self.validator.validate_indices(start, end)\n        ns, ne = self.validator.normalize_indices(start, end, len(numbers))\n        # The slice 'ns:ne+1' is used because 'ne' is the inclusive upper bound.\n        return int(sum(numbers[ns:ne+1]))\n\n_default_service = SumService()\n\ndef sum_range_list(numbers: list[int], start: int, end: int) -> int:\n    \"\"\"\n    Calculates the sum of numbers in a list within a range specified by two indices.\n    The range is inclusive of both the start and end indices.\n    \"\"\"\n    return _default_service.sum_range(numbers, start, end)"}
{"task_id": "Mbpp/171", "solution": "from math import isfinite\n\nclass PerimeterError(Exception):\n    \"\"\"Base exception for pentagon perimeter calculations.\"\"\"\n    pass\n\nclass InvalidSideLengthError(PerimeterError):\n    \"\"\"Raised when the side length provided is invalid.\"\"\"\n    pass\n\ndef perimeter_pentagon(side_length: float) -> float:\n    \"\"\"\n    Compute the perimeter of a regular pentagon from its side length.\n    Validates that the side length is a finite, non-negative number.\n    \"\"\"\n    try:\n        val = float(side_length)\n    except (TypeError, ValueError):\n        raise InvalidSideLengthError(\"Side length must be a number.\")\n\n    if not isfinite(val) or val < 0:\n        raise InvalidSideLengthError(\"Side length must be finite and non-negative.\")\n\n    return 5.0 * val"}
{"task_id": "Mbpp/172", "solution": "def count_occurance(s: str) -> int:\n    \"\"\"\n    Counts the number of occurrences of the substring 'std' in the given string,\n    allowing for overlapping occurrences.\n    \"\"\"\n    substring = \"std\"\n    if not substring:\n        return 0\n\n    count = 0\n    i = 0\n    n, m = len(s), len(substring)\n\n    while i <= n - m:\n        if s[i:i+m] == substring:\n            count += 1\n            i += 1  # Allow overlapping by advancing index by 1\n        else:\n            i += 1\n    return count"}
{"task_id": "Mbpp/222", "solution": "def check_type(tup: tuple) -> bool:\n    \"\"\"\n    Checks if all elements in a tuple have the same data type.\n    An empty tuple is considered to have homogeneous types.\n    \"\"\"\n    if not tup:\n        return True\n\n    first_type = type(tup[0])\n    for item in tup[1:]:\n        if type(item) is not first_type:\n            return False\n    return True"}
{"task_id": "Mbpp/223", "solution": "def is_majority(arr, n, x):\n    \"\"\"\n    Checks if an element x is the majority element in a sorted array.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n    \n    # Step 1: Find the first occurrence of x using binary search.\n    lo, hi = 0, n - 1\n    first_occurrence_idx = -1\n\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        if arr[mid] == x:\n            first_occurrence_idx = mid\n            hi = mid - 1  # Try to find an earlier occurrence in the left half\n        elif arr[mid] < x:\n            lo = mid + 1\n        else:\n            hi = mid - 1\n    \n    # If x is not found at all, it cannot be a majority element.\n    if first_occurrence_idx == -1:\n        return False\n    \n    # Step 2: Check if the element at first_occurrence_idx + n/2 is also x.\n    # If it is, then x occurs more than n/2 times.\n    \n    # Calculate the index where the (n/2)-th occurrence *after* the first one would be.\n    # If the first occurrence is at index `i`, then `n//2` positions later\n    # (i.e., at `i + n//2`), we expect to still find `x` if it's a majority.\n    check_index = first_occurrence_idx + (n // 2)\n\n    # Ensure check_index is within array bounds and the element at that index is x.\n    return (check_index < n) and (arr[check_index] == x)"}
