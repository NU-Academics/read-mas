{"task_id": "Mbpp/247", "solution": "import re\n\ndef lps(s: str) -> int:\n    \"\"\"\n    Calculates the length of the longest palindromic subsequence of the given string.\n    The input string is normalized by removing all whitespace and converting to uppercase\n    before computation, according to the design context.\n    \"\"\"\n    # Normalize the input string as per design context defaults:\n    # 1. Collapse multiple whitespace characters into single spaces and strip leading/trailing whitespace.\n    # 2. Convert to uppercase.\n    # 3. Remove all spaces (since remove_non_alnum is False by default).\n    normalized_s = re.sub(r'\\s+', ' ', s).strip()\n    normalized_s = normalized_s.upper()\n    normalized_s = normalized_s.replace(\" \", \"\")\n\n    n = len(normalized_s)\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the longest palindromic subsequence of normalized_s[i...j]\n    dp = [[0] * n for _ in range(n)]\n\n    # All single characters are palindromes of length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the table for lengths from 2 to n\n    for length in range(2, n + 1):\n        for i in range(n - length + 1):\n            j = i + length - 1\n            if normalized_s[i] == normalized_s[j]:\n                # If characters match, they can form a palindrome.\n                # Add 2 to the LPS of the inner substring s[i+1...j-1].\n                # dp[i+1][j-1] will be 0 if the inner substring is empty (e.g., length 2).\n                dp[i][j] = 2 + dp[i + 1][j - 1]\n            else:\n                # If characters don't match, take the maximum of:\n                # LPS of s[i+1...j] (excluding s[i])\n                # LPS of s[i...j-1] (excluding s[j])\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    return dp[0][n - 1]"}
{"task_id": "Mbpp/252", "solution": "import math\n\ndef convert(value):\n    \"\"\"\n    Converts a complex number or numeric input to polar coordinates (radius, angle).\n    Angle is in radians and normalized to (-pi, pi].\n    \"\"\"\n    try:\n        c = complex(value)\n    except Exception as e:\n        # Based on design, InvalidComplexError should be raised, but current scope does not allow importing it.\n        # So we'll let complex() raise its default ValueError or TypeError.\n        raise ValueError(f\"Could not convert value to complex: {e}\")\n\n    real = c.real\n    imag = c.imag\n\n    r = math.hypot(real, imag)\n    \n    # math.atan2 already returns angle in (-pi, pi]\n    theta = math.atan2(imag, real)\n\n    # Special case: if radius is zero, the angle is conventionally 0.0\n    if r == 0.0:\n        theta = 0.0\n\n    return (r, theta)"}
{"task_id": "Mbpp/255", "solution": "import itertools\nfrom typing import List, Tuple, Any\n\ndef combinations_colors(elements: List[str], length: int) -> List[Tuple[str, ...]]:\n    \"\"\"\n    Generates all combinations with repetition of the elements of the list.\n    Returns a list with a tuple for each combination.\n    \"\"\"\n    if length == 0:\n        return [()]\n\n    # itertools.product is used to generate combinations with repetition\n    # The 'repeat' argument specifies the length of the combinations\n    return list(itertools.product(elements, repeat=length))"}
{"task_id": "Mbpp/253", "solution": "import collections.abc\nfrom typing import Any, List\n\n\ndef count_integer(items: List[Any]) -> int:\n    \"\"\"\n    Counts the number of integer elements in a given list, excluding booleans.\n    Raises InvalidInputError if the input is not a list.\n    \"\"\"\n\n    class InvalidInputError(ValueError):\n        \"\"\"Custom exception for invalid function input.\"\"\"\n        def __init__(self, message: str, invalid_value: Any = None) -> None:\n            super().__init__(message)\n            self.invalid_value = invalid_value\n\n    class TypeChecker:\n        \"\"\"Utility for checking if a value is considered an integer.\"\"\"\n        @staticmethod\n        def is_integer(value: Any) -> bool:\n            # Accepts pure int but excludes bool as per design requirements.\n            return type(value) is int\n\n    class Validator:\n        \"\"\"Validates input to ensure it's a list or allowed sequence type.\"\"\"\n        def __init__(self, allow_tuples: bool = False):\n            self.allow_tuples = allow_tuples\n\n        def _is_list_like(self, items: Any) -> bool:\n            \"\"\"Internal helper to check if items is a list or allowed tuple.\"\"\"\n            if isinstance(items, list):\n                return True\n            if self.allow_tuples and isinstance(items, tuple):\n                return True\n            return False\n\n        def validate_list(self, items: Any) -> None:\n            \"\"\"Raises InvalidInputError if the input is not a valid list-like object.\"\"\"\n            if not self._is_list_like(items):\n                raise InvalidInputError(\"Input must be a list\", invalid_value=items)\n\n    class CountService:\n        \"\"\"Core logic to count integer elements using a TypeChecker.\"\"\"\n        def __init__(self, type_checker: TypeChecker):\n            self._type_checker = type_checker\n\n        def count(self, items: List[Any]) -> int:\n            \"\"\"Iterates through items and counts integers based on TypeChecker.\"\"\"\n            count = 0\n            for v in items:\n                if self._type_checker.is_integer(v):\n                    count += 1\n            return count\n\n    class Controller:\n        \"\"\"Orchestrates validation and counting for the public API.\"\"\"\n        def __init__(self, service: CountService, validator: Validator):\n            self.service = service\n            self.validator = validator\n\n        def count_integer(self, items: List[Any]) -> int:\n            \"\"\"Validates input and delegates to service for counting.\"\"\"\n            self.validator.validate_list(items)\n            return self.service.count(items)\n\n    # Instantiate the components as per the design's __init__.py snippet\n    # Default configuration: only list is allowed (allow_tuples=False)\n    validator = Validator(allow_tuples=False) \n    type_checker = TypeChecker()\n    service = CountService(type_checker=type_checker)\n    controller = Controller(service=service, validator=validator)\n\n    return controller.count_integer(items)"}
{"task_id": "Mbpp/256", "solution": "import math\n\ndef count_Primes_nums(n: int) -> int:\n    \"\"\"\n    Counts the number of prime numbers less than n using the Sieve of Eratosthenes.\n    Handles n < 2 specifically.\n    \"\"\"\n    if n < 2:\n        return 0\n\n    is_prime = [True] * n\n    is_prime[0] = is_prime[1] = False\n\n    for p in range(2, int(math.sqrt(n)) + 1):\n        if is_prime[p]:\n            for multiple in range(p * p, n, p):\n                is_prime[multiple] = False\n\n    return sum(is_prime)"}
