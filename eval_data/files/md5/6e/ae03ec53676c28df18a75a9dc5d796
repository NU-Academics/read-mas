{"task_id": "Mbpp/722", "solution": "import typing\nfrom typing import Dict, Tuple\n\ndef filter_data(students: Dict[str, Tuple[float, float]], min_height: float, min_weight: float) -> Dict[str, Tuple[float, float]]:\n    \"\"\"\n    Filters a dictionary of students, returning only those whose height and weight\n    are strictly greater than the provided minimums.\n    \"\"\"\n    filtered_students = {}\n    for name, (height, weight) in students.items():\n        if height > min_height and weight > min_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students"}
{"task_id": "Mbpp/725", "solution": "import re\nimport json\n\nclass ExtractionResult:\n    \"\"\"A data transfer object to hold extracted tokens and optional source metadata.\"\"\"\n    def __init__(self, tokens: list[str], source: str | None = None) -> None:\n        self.tokens = tokens\n        self.source = source\n\n    def to_list(self) -> list[str]:\n        \"\"\"Returns the list of extracted tokens.\"\"\"\n        return self.tokens\n\n    def to_json(self) -> str:\n        \"\"\"Returns a JSON string representation of the tokens.\"\"\"\n        return json.dumps(self.tokens)\n\nDEFAULT_PATTERN = r'\"((?:\\\\.|[^\"\\\\])*)\"'\n\nclass RegexQuotationAdapter:\n    \"\"\"Extracts quoted values from a string using regular expressions.\"\"\"\n    def __init__(self, pattern: str | None = None) -> None:\n        self.pattern = re.compile(pattern or DEFAULT_PATTERN)\n\n    def extract(self, text: str) -> ExtractionResult:\n        matches = [m.group(1).replace('\\\\\"', '\"') for m in self.pattern.finditer(text)]\n        return ExtractionResult(tokens=matches)\n\nclass QuotationExtractorService:\n    \"\"\"Business logic for extracting quoted strings, coordinating with an adapter.\"\"\"\n    def __init__(self, adapter: RegexQuotationAdapter) -> None:\n        self._adapter = adapter\n\n    def extract(self, text: str, source: str | None = None) -> ExtractionResult:\n        res = self._adapter.extract(text)\n        res.source = source\n        return res\n\n    def extract_values(self, text: str) -> list[str]:\n        \"\"\"Convenience method to extract and return only the list of token strings.\"\"\"\n        return self.extract(text).to_list()\n\n_default_service = QuotationExtractorService(adapter=RegexQuotationAdapter())\n\ndef extract_quotation(text: str) -> list[str]:\n    \"\"\"\n    Extracts values between double quotation marks from the given string.\n    Supports escaped double quotes within the extracted value.\n    \"\"\"\n    return _default_service.extract_values(text)"}
