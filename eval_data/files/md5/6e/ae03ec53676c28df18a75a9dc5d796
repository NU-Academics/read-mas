{"task_id": "Mbpp/445", "solution": "import numbers\nfrom typing import Tuple, Sequence, Any\nfrom dataclasses import dataclass\n\nclass ValidationError(ValueError):\n    \"\"\"Custom exception for validation failures.\"\"\"\n    pass\n\nclass TupleValidator:\n    \"\"\"Validates the shape and item types of tuple-of-tuples inputs.\"\"\"\n    def validate_shape(self, a: Sequence[Sequence[Any]], b: Sequence[Sequence[Any]]) -> None:\n        if len(a) != len(b):\n            raise ValidationError(f\"Outer length mismatch: {len(a)} != {len(b)}\")\n        for i, (ai, bi) in enumerate(zip(a, b)):\n            if len(ai) != len(bi):\n                raise ValidationError(f\"Inner length mismatch at index {i}: {len(ai)} != {len(bi)}\")\n\n    def validate_numeric_items(self, seq: Sequence[Sequence[Any]]) -> None:\n        for i, inner in enumerate(seq):\n            for j, v in enumerate(inner):\n                if not isinstance(v, numbers.Number):\n                    raise ValidationError(f\"Non-numeric item at [{i}][{j}]: {v!r}\")\n\n@dataclass(frozen=True)\nclass Pair:\n    \"\"\"Represents an inner tuple and provides element-wise multiplication behavior.\"\"\"\n    values: Tuple[numbers.Number, ...]\n\n    def multiply(self, other: 'Pair') -> Tuple[numbers.Number, ...]:\n        if len(self.values) != len(other.values):\n            raise ValidationError(\"Inner tuple lengths differ during multiplication\")\n        return tuple(a * b for a, b in zip(self.values, other.values))\n\n    def as_tuple(self) -> Tuple[numbers.Number, ...]:\n        return self.values\n\nclass ResultFormatter:\n    \"\"\"Formats the tuple-of-tuples result into a string representation.\"\"\"\n    def format_result(self, result: Tuple[Tuple[numbers.Number, ...], ...]) -> str:\n        return repr(result)\n\nclass IndexMultiplicationService:\n    \"\"\"Orchestrates validation and performs index-wise multiplication of tuple elements.\"\"\"\n    def __init__(self, validator: TupleValidator, formatter: ResultFormatter) -> None:\n        self._validator = validator\n        self._formatter = formatter\n\n    def multiply(self, a: Tuple[Tuple[numbers.Number, ...], ...],\n                       b: Tuple[Tuple[numbers.Number, ...], ...]) -> Tuple[Tuple[numbers.Number, ...], ...]:\n        self._validator.validate_shape(a, b)\n        self._validator.validate_numeric_items(a)\n        self._validator.validate_numeric_items(b)\n        results = []\n        for left_inner, right_inner in zip(a, b):\n            left_pair = Pair(tuple(left_inner))\n            right_pair = Pair(tuple(right_inner))\n            results.append(left_pair.multiply(right_pair))\n        return tuple(results)\n\n_default_service = IndexMultiplicationService(TupleValidator(), ResultFormatter())\n\ndef index_multiplication(a: Tuple[Tuple[numbers.Number, ...], ...],\n                         b: Tuple[Tuple[numbers.Number, ...], ...]) -> Tuple[Tuple[numbers.Number, ...], ...]:\n    \"\"\"\n    Performs index-wise multiplication of tuple elements in the given two tuples-of-tuples.\n    Inputs must be tuples-of-tuples of numbers with matching shapes.\n    \"\"\"\n    return _default_service.multiply(a, b)"}
{"task_id": "Mbpp/440", "solution": "import re\nimport string\nfrom collections.abc import ABC, abstractmethod\nfrom typing import List, Tuple, Optional\n\nclass Token:\n    \"\"\"Represents a token and its offsets in source text.\"\"\"\n    def __init__(self, text: str, start: int, end: int):\n        self.text = text\n        self.start = start\n        self.end = end\n\n    def __repr__(self) -> str:\n        return f\"Token(text='{self.text}', start={self.start}, end={self.end})\"\n\nclass AdverbResult:\n    \"\"\"Return structure for the first adverb found.\"\"\"\n    def __init__(self, start: int, end: int, token: str):\n        self.start = start\n        self.end = end\n        self.token = token\n\n    def __repr__(self) -> str:\n        return f\"AdverbResult(start={self.start}, end={self.end}, token='{self.token}')\"\n\nclass TextUtils:\n    \"\"\"Utility helpers for text processing.\"\"\"\n    @staticmethod\n    def strip_surrounding_punct(token_text: str) -> Tuple[str, int, int]:\n        \"\"\"Strips surrounding punctuation from a token, returning cleaned text and offset adjustments.\"\"\"\n        prefix_punct_len = 0\n        for char in token_text:\n            if char in string.punctuation:\n                prefix_punct_len += 1\n            else:\n                break\n\n        suffix_punct_len = 0\n        for char in reversed(token_text):\n            if char in string.punctuation:\n                suffix_punct_len += 1\n            else:\n                break\n        \n        cleaned_text = token_text[prefix_punct_len : len(token_text) - suffix_punct_len]\n        return cleaned_text, prefix_punct_len, suffix_punct_len\n\n    @staticmethod\n    def normalize_token(token_text: str) -> str:\n        \"\"\"Lowercases a token and strips surrounding punctuation.\"\"\"\n        cleaned_text, _, _ = TextUtils.strip_surrounding_punct(token_text)\n        return cleaned_text.lower()\n\nclass Tokenizer:\n    \"\"\"Tokenizes input into Token objects with offsets.\"\"\"\n    TOKEN_RE = re.compile(r\"\\w+|[^\\w\\s]+\", re.UNICODE)\n\n    def tokenize_with_offsets(self, text: str) -> List[Token]:\n        \"\"\"Returns tokens with their start and end offsets in the original text.\"\"\"\n        tokens = []\n        for m in self.TOKEN_RE.finditer(text):\n            tokens.append(Token(text=m.group(0), start=m.start(), end=m.end()))\n        return tokens\n\nclass PosTaggerInterface(ABC):\n    \"\"\"Abstract base class defining the contract for POS taggers.\"\"\"\n    @abstractmethod\n    def tag(self, tokens: List[Token]) -> List[Tuple[Token, str]]:\n        pass\n\nclass HeuristicPosTagger(PosTaggerInterface):\n    \"\"\"Provides a fast heuristic POS tagging to identify adverbs.\"\"\"\n    ADVERB_SUFFIXES = (\"ly\",)\n    EXCEPTIONS = {\"family\", \"supply\", \"early\", \"daily\", \"friendly\", \"lovely\", \"ugly\", \"only\"}\n\n    def tag(self, tokens: List[Token]) -> List[Tuple[Token, str]]:\n        \"\"\"Tags tokens based on heuristic rules (e.g., -ly suffix).\"\"\"\n        out = []\n        for t in tokens:\n            core = TextUtils.normalize_token(t.text)\n            if core and any(core.endswith(s) for s in self.ADVERB_SUFFIXES) and core not in self.EXCEPTIONS:\n                out.append((t, \"ADV\"))\n            else:\n                out.append((t, \"OTHER\"))\n        return out\n\nclass AdverbFinderService:\n    \"\"\"Orchestrates tokenization and tagging to find the first adverb.\"\"\"\n    def __init__(self, pos_tagger: PosTaggerInterface):\n        self.pos_tagger = pos_tagger\n        self.tokenizer = Tokenizer()\n\n    def find_first_adverb(self, sentence: str) -> Optional[AdverbResult]:\n        \"\"\"Finds the first adverb in the given sentence and returns its position and normalized token.\"\"\"\n        tokens = self.tokenizer.tokenize_with_offsets(sentence)\n        tagged = self.pos_tagger.tag(tokens)\n\n        for token, pos in tagged:\n            if pos == \"ADV\":\n                normalized_token_text = TextUtils.normalize_token(token.text)\n                # The end index should be start_of_original_token + length_of_normalized_token\n                # to satisfy the requirement: sentence[start:end].lower() == normalized_token\n                adverb_end_index = token.start + len(normalized_token_text)\n                return AdverbResult(start=token.start, end=adverb_end_index, token=normalized_token_text)\n        return None\n\ndef find_adverb_position(sentence: str) -> Optional[Tuple[int, int, str]]:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    This function uses a heuristic POS tagger and returns the start and end\n    indices along with the normalized adverb token.\n    \"\"\"\n    tagger = HeuristicPosTagger()\n    service = AdverbFinderService(pos_tagger=tagger)\n    \n    result = service.find_first_adverb(sentence)\n    if result is None:\n        return None\n    \n    return (result.start, result.end, result.token)"}
{"task_id": "Mbpp/446", "solution": "import collections\n\ndef count_Occurrence(tuple_data: tuple, items) -> int:\n    \"\"\"\n    Counts the total occurrences of all elements from a list within a tuple.\n    \"\"\"\n    element_counts = collections.Counter(tuple_data)\n    total_occurrence = 0\n    for item in items:\n        total_occurrence += element_counts[item]\n    return total_occurrence"}
