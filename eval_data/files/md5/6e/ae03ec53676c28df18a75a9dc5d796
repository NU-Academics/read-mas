{"task_id": "Mbpp/244", "solution": "import math\n\ndef next_Perfect_Square(n):\n    \"\"\"\n    Finds the smallest perfect square strictly greater than the given number n.\n    This function implements the core mathematical logic from the design context.\n    \"\"\"\n    # Helper to calculate the floor of the square root, handling negative inputs.\n    def _integer_sqrt(val):\n        if val < 0:\n            return 0\n        return int(math.isqrt(val))\n\n    k = _integer_sqrt(n)\n    \n    # Determine the next perfect square based on k.\n    # If k*k is already strictly greater than n, use k*k. Otherwise, use (k+1)*(k+1).\n    if k * k > n:\n        return k * k\n    else:\n        return (k + 1) * (k + 1)"}
{"task_id": "Mbpp/245", "solution": "import math\n\ndef max_sum(arr: list) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence in the given array.\n    A sequence is bitonic if it is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n\n    def _compute_max_increasing_sum(sequence: list) -> list:\n        \"\"\"Computes the maximum sum of an increasing subsequence ending at each index.\"\"\"\n        length = len(sequence)\n        inc = list(sequence)  # Initialize with the element itself\n        \n        for i in range(1, length):\n            for j in range(i):\n                if sequence[i] > sequence[j]:\n                    inc[i] = max(inc[i], inc[j] + sequence[i])\n        return inc\n\n    def _compute_max_decreasing_sum(sequence: list) -> list:\n        \"\"\"Computes the maximum sum of a decreasing subsequence starting at each index.\"\"\"\n        length = len(sequence)\n        dec = list(sequence)  # Initialize with the element itself\n        \n        for i in range(length - 2, -1, -1):  # Iterate from n-2 down to 0\n            for j in range(length - 1, i, -1):  # Iterate from n-1 down to i+1\n                if sequence[i] > sequence[j]:\n                    dec[i] = max(dec[i], dec[j] + sequence[i])\n        return dec\n\n    inc_sums = _compute_max_increasing_sum(arr)\n    dec_sums = _compute_max_decreasing_sum(arr)\n\n    # Combine the increasing and decreasing sums to find the maximum bitonic sum.\n    # For each element arr[i], it can be the peak of a bitonic subsequence.\n    # Subtract arr[i] because it's included in both increasing and decreasing sums.\n    max_bitonic_sum = -math.inf \n\n    for i in range(n):\n        current_sum = inc_sums[i] + dec_sums[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_sum)\n    \n    return max_bitonic_sum"}
{"task_id": "Mbpp/250", "solution": "import ast\n\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass TupleCountRequest:\n    def __init__(self, t: tuple, x: object) -> None:\n        self.t = t\n        self.x = x\n\nclass LoggerAdapter:\n    def __init__(self) -> None:\n        pass\n    def info(self, msg: str) -> None:\n        pass\n    def error(self, msg: str) -> None:\n        pass\n    def debug(self, msg: str) -> None:\n        pass\n\nclass TupleValidator:\n    def __init__(self, allow_list_conversion: bool = True) -> None:\n        self.allow_list_conversion = allow_list_conversion\n\n    def validate_tuple_input(self, raw: object) -> tuple:\n        if isinstance(raw, tuple):\n            return raw\n        if isinstance(raw, list) and self.allow_list_conversion:\n            return tuple(raw)\n        if isinstance(raw, str):\n            try:\n                val = ast.literal_eval(raw)\n                if isinstance(val, tuple):\n                    return val\n                if isinstance(val, list) and self.allow_list_conversion:\n                    return tuple(val)\n                raise ValueError(\"Parsed string is not a tuple or list literal.\")\n            except (ValueError, SyntaxError):\n                parts = [p.strip() for p in raw.split(\",\") if p.strip() != \"\"]\n                return tuple(self._parse_part(p) for p in parts)\n            except Exception:\n                raise InvalidInputError(\"Unable to parse tuple string.\")\n        raise InvalidInputError(\"Expected tuple, list, or parseable string.\")\n\n    def validate_element(self, x: object) -> object:\n        if isinstance(x, str):\n            try:\n                return ast.literal_eval(x)\n            except (ValueError, SyntaxError):\n                return x\n            except Exception:\n                return x\n        return x\n\n    def _parse_part(self, s: str) -> object:\n        try:\n            return ast.literal_eval(s)\n        except (ValueError, SyntaxError):\n            return s\n        except Exception:\n            return s\n\nclass TupleCounterService:\n    def __init__(self) -> None:\n        pass\n\n    def count(self, request: TupleCountRequest) -> int:\n        \"\"\"Returns the number of occurrences of request.x in request.t.\"\"\"\n        items = request.t\n        target = request.x\n        return self._count_matches(items, target)\n\n    def _count_matches(self, items: tuple, x: object) -> int:\n        \"\"\"Internal helper to count matches.\"\"\"\n        cnt = 0\n        for it in items:\n            if it == x:\n                cnt += 1\n        return cnt\n\nclass CountController:\n    def __init__(self, validator: TupleValidator, service: TupleCounterService, logger: LoggerAdapter = None) -> None:\n        self.validator = validator\n        self.service = service\n        self.logger = logger if logger is not None else LoggerAdapter()\n\n    def handle(self, raw_t: object, raw_x: object) -> int:\n        \"\"\"Validates inputs, creates DTO, calls service, and returns count.\"\"\"\n        t_valid = self.validator.validate_tuple_input(raw_t)\n        x_valid = self.validator.validate_element(raw_x)\n        req = TupleCountRequest(t_valid, x_valid)\n        return self.service.count(req)\n\nDEFAULT_ALLOW_LIST_CONVERSION = True\n\ndef count_X(tuple_input, element):\n    \"\"\"Counts the occurrences of an element in a tuple.\"\"\"\n    validator = TupleValidator(allow_list_conversion=DEFAULT_ALLOW_LIST_CONVERSION)\n    service = TupleCounterService()\n    controller = CountController(validator, service)\n    return controller.handle(tuple_input, element)"}
