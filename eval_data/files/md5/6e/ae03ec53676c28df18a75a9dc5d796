{"task_id": "Mbpp/309", "solution": "from typing import Any\nimport math\n\nclass InvalidNumberError(ValueError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass MaxServiceError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\ndef parse_numeric(value: str) -> float:\n    \"\"\"Try to parse a string to float; strip underscores and whitespace; raise ValueError on failure.\"\"\"\n    s = value.strip().replace(\"_\", \"\")\n    return float(s)\n\nclass NumberValidator:\n    EPSILON_NAN_CHECK: float = 1e-12\n\n    def validate(self, value: Any) -> float:\n        \"\"\"Validate and coerce arbitrary input into numeric float.\"\"\"\n        if isinstance(value, (int, float)):\n            v = float(value)\n        elif isinstance(value, str):\n            v = parse_numeric(value)\n        else:\n            raise InvalidNumberError(f\"Unsupported type: {type(value)!r}\")\n        if math.isnan(v):\n            raise InvalidNumberError(\"NaN is not a valid number\")\n        return v\n\nclass MaxService:\n    def __init__(self, validator: NumberValidator) -> None:\n        self.validator = validator\n\n    def max(self, a: float, b: float) -> float:\n        \"\"\"Core comparison logic to determine the maximum.\"\"\"\n        try:\n            return a if a >= b else b\n        except Exception as exc:\n            raise MaxServiceError(str(exc)) from exc\n\nclass CalculatorController:\n    def __init__(self, service: MaxService, validator: NumberValidator) -> None:\n        self.service = service\n        self.validator = validator\n\n    def compute_max(self, a: Any, b: Any) -> float | int:\n        \"\"\"Orchestrate validation and service call; provide the main programmatic interface.\"\"\"\n        a_val = self.validator.validate(a)\n        b_val = self.validator.validate(b)\n        result = self.service.max(a_val, b_val)\n        if isinstance(a, int) and isinstance(b, int):\n            return int(result)\n        return result\n\n_validator = NumberValidator()\n_service = MaxService(validator=_validator)\n_controller = CalculatorController(service=_service, validator=_validator)\n\ndef maximum(a: float | int, b: float | int) -> float | int:\n    \"\"\"Return maximum of a and b.\"\"\"\n    return _controller.compute_max(a, b)"}
{"task_id": "Mbpp/311", "solution": "def _find_msb(n: int) -> int:\n    \"\"\"Returns the position of the most significant set bit. If n is 0, returns 0.\"\"\"\n    if n == 0:\n        return 0\n    return n.bit_length() - 1\n\ndef _is_bit_set(n: int, pos: int) -> bool:\n    \"\"\"Checks if the bit at the given position is set in n.\"\"\"\n    return (n >> pos) & 1 == 1\n\ndef _set_bit(n: int, pos: int) -> int:\n    \"\"\"Sets the bit at the given position in n.\"\"\"\n    return n | (1 << pos)\n\ndef set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Sets the left-most (most significant) unset bit in a non-negative integer.\n    If all bits up to the MSB are set, the next higher bit is set.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    msb = _find_msb(n)\n    changed_bit = None\n\n    # Search from MSB down to 0 for the first unset bit\n    for pos in range(msb, -1, -1):\n        if not _is_bit_set(n, pos):\n            changed_bit = pos\n            break\n\n    # If all bits from MSB down to 0 are set, set the bit at msb + 1\n    if changed_bit is None:\n        changed_bit = msb + 1\n\n    return _set_bit(n, changed_bit)"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n):\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    Assumes n is a positive integer (n >= 1).\n    \"\"\"\n    return 1 << (n.bit_length() - 1)"}
{"task_id": "Mbpp/308", "solution": "import heapq\nfrom typing import List, Tuple, Set\n\ndef large_product(list1: List[int], list2: List[int], k: int) -> List[int]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists, selecting one factor from each list.\n    The algorithm sorts the lists and uses a max-heap to efficiently explore product combinations.\n    \"\"\"\n    if k <= 0:\n        return []\n    if not list1 or not list2:\n        return []\n\n    # Sort both lists in descending order to easily access largest elements.\n    a_sorted = sorted(list1, reverse=True)\n    b_sorted = sorted(list2, reverse=True)\n\n    n, m = len(a_sorted), len(b_sorted)\n\n    # Use a set to keep track of visited index pairs (i, j) to prevent redundant computations.\n    visited: Set[Tuple[int, int]] = set()\n\n    # Max-heap to store (negative_product, index_a, index_b) tuples.\n    # Python's heapq is a min-heap, so products are negated to simulate a max-heap.\n    heap: List[Tuple[int, int, int]] = []\n\n    # Initialize the heap with the product of the two largest elements.\n    initial_product = a_sorted[0] * b_sorted[0]\n    heapq.heappush(heap, (-initial_product, 0, 0))\n    visited.add((0, 0))\n\n    results: List[int] = []\n\n    # Extract products from the heap until k products are found or the heap is exhausted.\n    while heap and len(results) < k:\n        neg_product, i, j = heapq.heappop(heap)\n        results.append(-neg_product)\n\n        # Explore the next potential largest product by incrementing the index in the first list.\n        if i + 1 < n and (i + 1, j) not in visited:\n            visited.add((i + 1, j))\n            next_product = a_sorted[i + 1] * b_sorted[j]\n            heapq.heappush(heap, (-next_product, i + 1, j))\n\n        # Explore the next potential largest product by incrementing the index in the second list.\n        if j + 1 < m and (i, j + 1) not in visited:\n            visited.add((i, j + 1))\n            next_product = a_sorted[i] * b_sorted[j + 1]\n            heapq.heappush(heap, (-next_product, i, j + 1))\n\n    return results"}
{"task_id": "Mbpp/312", "solution": "import math\nimport sqlite3\nimport logging\nimport os\nfrom typing import Any, Optional\n\n# Set up a basic logger for internal components if not configured externally\nlogging.basicConfig(level=logging.WARNING, format='%(asctime)s - %(levelname)s - %(message)s')\n_logger = logging.getLogger(__name__)\n\nclass InvalidDimensionError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass CacheError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass Settings:\n    \"\"\"Holds application settings and defaults.\"\"\"\n    def __init__(self, cache_db_path: str = \"data/volume_cache.sqlite\", cache_ttl_days: int = 30) -> None:\n        self.cache_db_path = cache_db_path\n        self.cache_ttl_days = cache_ttl_days\n\ndef validate_positive(value: Any, name: str) -> float:\n    \"\"\"Converts value to float and ensures it's positive, raising an error if not.\"\"\"\n    try:\n        float_value = float(value)\n        if float_value <= 0:\n            raise InvalidDimensionError(f\"{name} must be a positive number.\")\n        return float_value\n    except (ValueError, TypeError):\n        raise InvalidDimensionError(f\"{name} must be a valid number.\")\n\ndef normalize_float(value: float, precision: int = 6) -> float:\n    \"\"\"Rounds a float to a specified precision for consistent cache keys.\"\"\"\n    return round(value, precision)\n\nclass VolumeCalculator:\n    \"\"\"Provides mathematical calculations for geometric shapes.\"\"\"\n    def cone_volume(self, radius: float, height: float) -> float:\n        \"\"\"Calculates the volume of a cone.\"\"\"\n        if radius <= 0 or height <= 0:\n            raise InvalidDimensionError(\"radius and height must be positive\")\n        return (1.0 / 3.0) * math.pi * (radius ** 2) * height\n\nclass CacheRepository:\n    \"\"\"Persists and reads cache entries for computed volumes.\"\"\"\n    TABLE_SQL = \"\"\"\n    CREATE TABLE IF NOT EXISTS cone_volume_cache (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      radius REAL NOT NULL,\n      height REAL NOT NULL,\n      volume REAL NOT NULL,\n      computed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n      UNIQUE(radius, height)\n    );\n    \"\"\"\n\n    def __init__(self, db_path: str) -> None:\n        self.db_path = db_path\n        self.conn: Optional[sqlite3.Connection] = None\n\n        db_dir = os.path.dirname(db_path)\n        if db_dir and not os.path.exists(db_dir):\n            try:\n                os.makedirs(db_dir)\n            except OSError as e:\n                _logger.warning(f\"Could not create directory {db_dir}: {e}. Cache might fail if directory isn't writable.\")\n\n        try:\n            self.conn = sqlite3.connect(self.db_path, check_same_thread=False)\n            self.conn.execute(self.TABLE_SQL)\n            self.conn.commit()\n        except Exception as e:\n            raise CacheError(f\"Failed to initialize CacheRepository at {db_path}: {e}\")\n\n    def get(self, radius: float, height: float) -> Optional[float]:\n        \"\"\"Retrieves a cached volume for the given radius and height.\"\"\"\n        if not self.conn:\n            _logger.warning(\"Cache connection is not established. Cannot perform get operation.\")\n            return None\n        try:\n            cursor = self.conn.cursor()\n            cursor.execute(\"SELECT volume FROM cone_volume_cache WHERE radius = ? AND height = ?\", (radius, height))\n            result = cursor.fetchone()\n            return result[0] if result else None\n        except Exception as e:\n            _logger.error(f\"Cache get error for (r={radius}, h={height}): {e}\")\n            return None\n\n    def set(self, radius: float, height: float, volume: float) -> None:\n        \"\"\"Inserts or updates a cache entry for cone volume.\"\"\"\n        if not self.conn:\n            _logger.warning(\"Cache connection is not established. Cannot perform set operation.\")\n            raise CacheError(\"Cache connection not established.\")\n        try:\n            cursor = self.conn.cursor()\n            cursor.execute(\n                \"INSERT INTO cone_volume_cache (radius, height, volume) VALUES (?, ?, ?) \"\n                \"ON CONFLICT(radius, height) DO UPDATE SET volume = EXCLUDED.volume, computed_at = CURRENT_TIMESTAMP\",\n                (radius, height, volume)\n            )\n            self.conn.commit()\n        except Exception as e:\n            _logger.error(f\"Cache set error for (r={radius}, h={height}, v={volume}): {e}\")\n            raise CacheError(f\"Failed to set cache entry: {e}\")\n\n    def cleanup(self, ttl_days: int) -> None:\n        \"\"\"Removes cache entries older than the specified TTL.\"\"\"\n        if not self.conn:\n            _logger.warning(\"Cache connection is not established. Cannot perform cleanup operation.\")\n            raise CacheError(\"Cache connection not established.\")\n        try:\n            self.conn.execute(\"DELETE FROM cone_volume_cache WHERE computed_at < datetime('now', ?)\", (f'-{ttl_days} days',))\n            self.conn.commit()\n        except Exception as e:\n            _logger.error(f\"Cache cleanup error: {e}\")\n            raise CacheError(f\"Failed to cleanup cache: {e}\")\n\nclass VolumeService:\n    \"\"\"Orchestrates validation, caching, and calculation for cone volume.\"\"\"\n    def __init__(self, calculator: VolumeCalculator, cache_repo: CacheRepository, settings: Settings) -> None:\n        self.calculator = calculator\n        self.cache = cache_repo\n        self.settings = settings\n\n    def compute_cone_volume(self, radius: float, height: float) -> float:\n        \"\"\"Computes cone volume, utilizing cache if available and validating inputs.\"\"\"\n        r = validate_positive(radius, \"radius\")\n        h = validate_positive(height, \"height\")\n\n        r_norm = normalize_float(r)\n        h_norm = normalize_float(h)\n\n        cached = self.cache.get(r_norm, h_norm)\n        if cached is not None:\n            return cached\n\n        volume = self.calculator.cone_volume(r, h)\n\n        try:\n            self.cache.set(r_norm, h_norm, volume)\n        except CacheError:\n            pass\n        except Exception as e:\n            _logger.error(f\"Unexpected error when setting cache for (r={r_norm}, h={h_norm}, v={volume}): {e}\")\n            pass\n        return volume\n\ndef volume_cone(radius: float, height: float) -> float:\n    \"\"\"Calculates the volume of a cone, using caching and input validation.\"\"\"\n    settings = Settings()\n    calculator = VolumeCalculator()\n    cache = CacheRepository(settings.cache_db_path)\n    service = VolumeService(calculator, cache, settings)\n    return service.compute_cone_volume(radius, height)"}
{"task_id": "Mbpp/389", "solution": "import os\nimport json\nfrom typing import Any, Dict, Optional\n\nclass InvalidParameterError(ValueError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass PersistenceError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass LucasValidator:\n    def validate_n(self, n: Any) -> int:\n        if isinstance(n, bool):\n            raise InvalidParameterError(\"n must be an integer >= 0, not a boolean\")\n        try:\n            iv = int(n)\n        except (TypeError, ValueError):\n            raise InvalidParameterError(\"n must be an integer\")\n        if iv < 0:\n            raise InvalidParameterError(\"n must be >= 0\")\n        return iv\n\nclass LucasUtils:\n    @staticmethod\n    def iterative(n: int) -> int:\n        if n == 0:\n            return 2\n        if n == 1:\n            return 1\n        a, b = 2, 1\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b\n\n# Using a global dictionary for the cache to simulate a shared singleton instance\n_GLOBAL_LUCAS_CACHE: Dict[int, int] = {}\n_DEFAULT_CACHE_PERSIST_PATH = os.path.expanduser(\"~/.cache/lucas_app/cache.json\")\n\nclass LucasRepository:\n    def __init__(self, persist_path: Optional[str] = None) -> None:\n        self._cache = _GLOBAL_LUCAS_CACHE\n        self._persist_path = os.path.expanduser(persist_path) if persist_path else None\n        if self._persist_path:\n            try:\n                self.load_from_disk()\n            except PersistenceError:\n                pass\n\n    def get(self, n: int) -> Optional[int]:\n        return self._cache.get(n)\n\n    def save(self, n: int, value: int) -> None:\n        self._cache[n] = value\n        if self._persist_path:\n            try:\n                self.save_to_disk()\n            except Exception as e:\n                raise PersistenceError(f\"Failed to persist cache: {e}\")\n\n    def load_from_disk(self) -> None:\n        if not self._persist_path or not os.path.exists(self._persist_path):\n            return\n        try:\n            with open(self._persist_path, \"r\", encoding=\"utf-8\") as f:\n                data = json.load(f)\n            self._cache.clear()\n            for k, v in data.items():\n                self._cache[int(k)] = int(v)\n        except (json.JSONDecodeError, ValueError, IOError) as e:\n            raise PersistenceError(f\"Failed to load cache from disk: {e}\")\n\n    def save_to_disk(self) -> None:\n        if not self._persist_path:\n            return\n        os.makedirs(os.path.dirname(self._persist_path), exist_ok=True)\n        tmp_path = f\"{self._persist_path}.tmp\"\n        try:\n            with open(tmp_path, \"w\", encoding=\"utf-8\") as f:\n                json.dump({str(k): v for k, v in self._cache.items()}, f, indent=2)\n            os.replace(tmp_path, self._persist_path)\n        except IOError as e:\n            raise PersistenceError(f\"Failed to save cache to disk: {e}\")\n\nclass LucasService:\n    def __init__(self, repo: LucasRepository) -> None:\n        self._repo = repo\n\n    def compute(self, n: int) -> int:\n        cached = self._repo.get(n)\n        if cached is not None:\n            return cached\n        \n        value = LucasUtils.iterative(n)\n        try:\n            self._repo.save(n, value)\n        except PersistenceError:\n            pass\n        return value\n\nclass LucasController:\n    def __init__(self, service: LucasService, validator: Optional[LucasValidator] = None) -> None:\n        self._service = service\n        self._validator = validator or LucasValidator()\n\n    def find_lucas(self, n: Any) -> int:\n        ni = self._validator.validate_n(n)\n        return self._service.compute(ni)\n\n_default_repo = LucasRepository()\n_default_service = LucasService(_default_repo)\n_default_controller = LucasController(_default_service)\n\ndef find_lucas(n: int) -> int:\n    \"\"\"\n    Calculates the n'th Lucas number.\n    This function uses an iterative approach with an in-memory cache for efficiency.\n    \"\"\"\n    return _default_controller.find_lucas(n)"}
{"task_id": "Mbpp/395", "solution": "from collections import Counter\nfrom typing import Optional\n\ndef first_non_repeating_character(s: str, case_sensitive: bool = True) -> Optional[str]:\n    \"\"\"\n    Finds the first non-repeated character in a given string.\n\n    The search is case-sensitive by default, but can be made case-insensitive.\n    Returns None if no non-repeating character is found.\n    \"\"\"\n    if not s:\n        return None\n\n    # Process the string based on case_sensitive flag\n    # This acts as the StringUtils.normalize step from the design\n    processed_s = s.lower() if not case_sensitive else s\n\n    # Compute character frequencies\n    # This acts as the CharFrequencyRepository.compute_frequencies step from the design\n    char_counts = Counter(processed_s)\n\n    # Iterate through the processed string to find the first character with a count of 1\n    # This acts as the _iterate_first_unique step from the design\n    for char in processed_s:\n        if char_counts[char] == 1:\n            return char\n            \n    return None"}
{"task_id": "Mbpp/390", "solution": "from typing import Any, List, Optional, Protocol\nimport time\n\nclass InvalidFormatStringError(ValueError):\n    pass\n\nclass InvalidElementError(ValueError):\n    pass\n\nclass FormatRequest:\n    def __init__(self, items: List[Any], fmt: str) -> None:\n        if not isinstance(fmt, str):\n            raise TypeError(\"fmt must be a str\")\n        self.items: List[Any] = list(items)\n        self.fmt: str = fmt\n\n    def to_dict(self) -> dict:\n        return {\"items\": self.items, \"fmt\": self.fmt}\n\nclass FormatResult:\n    def __init__(self, formatted: List[str], count: int, timestamp: float) -> None:\n        self.formatted = formatted\n        self.count = count\n        self.timestamp = timestamp\n\n    def to_dict(self) -> dict:\n        return {\"formatted\": self.formatted, \"count\": self.count, \"timestamp\": self.timestamp}\n\nTEST_SENTINEL = \"__TEST__\"\n\ndef validate_format(fmt: str) -> None:\n    if not isinstance(fmt, str):\n        raise InvalidFormatStringError(\"Format must be a string\")\n    try:\n        fmt.format(TEST_SENTINEL)\n    except Exception as e:\n        raise InvalidFormatStringError(f\"Invalid format string: {e}\") from e\n\ndef safe_format(element: Any, fmt: str) -> str:\n    try:\n        return fmt.format(element)\n    except Exception as e:\n        raise InvalidElementError(f\"Cannot format element {element!r}: {e}\") from e\n\nclass RepositoryProtocol(Protocol):\n    def save(self, result: FormatResult) -> None: ...\n    def get_last(self) -> Optional[FormatResult]: ...\n\nclass InMemoryRepository:\n    def __init__(self) -> None:\n        self._last_result: Optional[FormatResult] = None\n\n    def save(self, result: FormatResult) -> None:\n        self._last_result = result\n\n    def get_last(self) -> Optional[FormatResult]:\n        return self._last_result\n\nclass AddStringService:\n    def __init__(self, repository: RepositoryProtocol) -> None:\n        self._repo = repository\n\n    def apply_format(self, request: FormatRequest) -> FormatResult:\n        validate_format(request.fmt)\n        formatted = []\n        for e in request.items:\n            formatted.append(self._format_element(e, request.fmt))\n        result = FormatResult(formatted=formatted, count=len(formatted), timestamp=time.time())\n        try:\n            self._repo.save(result)\n        except Exception:\n            pass # Best-effort persistence; do not fail main flow\n        return result\n\n    def _format_element(self, element: Any, fmt: str) -> str:\n        return safe_format(element, fmt)\n\nclass AddStringController:\n    def __init__(self, service: AddStringService) -> None:\n        self._service = service\n\n    def add_string(self, items: List[Any], fmt: str) -> List[str]:\n        request = FormatRequest(items=items, fmt=fmt)\n        result = self._service.apply_format(request)\n        return result.formatted\n\n    def get_last_result(self) -> Optional[FormatResult]:\n        return self._service._repo.get_last()\n\ndef add_string(items: List[Any], fmt: str, repository: Optional[RepositoryProtocol] = None) -> List[str]:\n    \"\"\"Applies a format string to each element in a list.\"\"\"\n    repo = repository or InMemoryRepository()\n    service = AddStringService(repo)\n    controller = AddStringController(service)\n    return controller.add_string(items, fmt)"}
{"task_id": "Mbpp/394", "solution": "from typing import Tuple, Any\n\ndef check_distinct(input_tuple: Tuple[Any, ...]) -> bool:\n    \"\"\"\n    Checks if the given tuple contains no duplicate elements.\n    Uses an O(n) set-based approach for hashable elements, or an O(n^2)\n    pairwise comparison for tuples containing unhashable elements.\n    \"\"\"\n\n    def is_hashable(value: Any) -> bool:\n        \"\"\"Determines if a value is hashable.\"\"\"\n        try:\n            hash(value)\n            return True\n        except TypeError:\n            return False\n\n    def _fast_path(current_tuple: Tuple[Any, ...]) -> bool:\n        \"\"\"Checks distinctness using a set for hashable elements.\"\"\"\n        return len(current_tuple) == len(set(current_tuple))\n\n    def _slow_path(current_tuple: Tuple[Any, ...]) -> bool:\n        \"\"\"Checks distinctness using pairwise comparison for unhashable elements.\"\"\"\n        n = len(current_tuple)\n        for i in range(n):\n            for j in range(i + 1, n):\n                if current_tuple[i] == current_tuple[j]:\n                    return False\n        return True\n\n    if all(is_hashable(item) for item in input_tuple):\n        result = _fast_path(input_tuple)\n    else:\n        result = _slow_path(input_tuple)\n        \n    return result"}
{"task_id": "Mbpp/397", "solution": "def median_numbers(a, b, c) -> float:\n    \"\"\"\n    Calculates the median of three numbers by sorting them and returning the middle element.\n    Inputs are assumed to be numeric.\n    \"\"\"\n    numbers = [a, b, c]\n    numbers.sort()\n    return float(numbers[1])"}
{"task_id": "Mbpp/392", "solution": "import json\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    pass\n\nclass RepositoryError(Exception):\n    \"\"\"Exception raised for repository-related issues.\"\"\"\n    pass\n\nclass InMemoryMemoRepository:\n    \"\"\"\n    An in-memory repository for caching f(n) values, with optional JSON persistence.\n    \"\"\"\n    def __init__(self, persist_path=None):\n        self._store = {}\n        self._persist_path = persist_path\n        if persist_path:\n            try:\n                self.load_from_file(persist_path)\n            except Exception:\n                pass\n\n    def get(self, key: int) -> int | None:\n        \"\"\"Retrieves a cached value by key.\"\"\"\n        return self._store.get(key)\n\n    def set(self, key: int, value: int) -> None:\n        \"\"\"Stores a value in the cache.\"\"\"\n        self._store[key] = value\n\n    def clear(self) -> None:\n        \"\"\"Clears the entire in-memory cache.\"\"\"\n        self._store.clear()\n\n    def save_to_file(self, path: str) -> None:\n        \"\"\"Saves the cache to a JSON file.\"\"\"\n        try:\n            with open(path, \"w\") as f:\n                json.dump({str(k): v for k, v in self._store.items()}, f)\n        except Exception as e:\n            raise RepositoryError(f\"Failed to save cache: {e}\")\n\n    def load_from_file(self, path: str) -> None:\n        \"\"\"Loads the cache from a JSON file.\"\"\"\n        try:\n            with open(path, \"r\") as f:\n                data = json.load(f)\n            self._store = {int(k): int(v) for k, v in data.items()}\n        except FileNotFoundError:\n            return\n        except Exception as e:\n            raise RepositoryError(f\"Failed to load cache: {e}\")\n\nclass MaxSumService:\n    \"\"\"\n    Service to compute the maximum sum using the recurrence relation f(n).\n    Uses an injected repository for memoization.\n    \"\"\"\n    def __init__(self, repo: InMemoryMemoRepository):\n        self._repo = repo\n\n    def get_max_sum(self, n: int) -> int:\n        \"\"\"\n        Public entry point to compute f(n), handling validation and memoization.\n        \"\"\"\n        if n < 0:\n            raise ValidationError(\"n must be non-negative\")\n        \n        cached = self._repo.get(n)\n        if cached is not None:\n            return cached\n        \n        result = self._compute(n)\n        self._repo.set(n, result)\n        return result\n\n    def _compute(self, n: int) -> int:\n        \"\"\"\n        Recursive helper to compute f(n), ensuring all sub-problems utilize the cache.\n        \"\"\"\n        if n == 0:\n            return 0\n        \n        # Check cache again, as per design description for _compute\n        cached = self._repo.get(n)\n        if cached is not None:\n            return cached\n\n        # Recursive calls use the public get_max_sum to leverage memoization.\n        parts = (self.get_max_sum(n // 2),\n                 self.get_max_sum(n // 3),\n                 self.get_max_sum(n // 4),\n                 self.get_max_sum(n // 5))\n        \n        total = sum(parts)\n        result = max(total, n)\n        \n        self._repo.set(n, result)\n        return result\n\n_default_repo = InMemoryMemoRepository()\n_default_service = MaxSumService(_default_repo)\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Finds the maximum sum for integer n using the recurrence\n    f(n) = max((f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    \"\"\"\n    return _default_service.get_max_sum(n)"}
{"task_id": "Mbpp/391", "solution": "from typing import Any, Dict, List, Sequence, Optional\n\nclass ConversionError(Exception):\n    \"\"\"Exception raised for conversion-related errors, providing details about the issue.\"\"\"\n    def __init__(self, message: str, details: Dict[str, Any] | None = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.details = details\n\n    def __str__(self) -> str:\n        return f\"{self.message} - details={self.details}\"\n\n\nclass ListValidator:\n    \"\"\"Provides methods to validate input lists for type, length consistency, and hashability of IDs.\"\"\"\n    def validate_iterable(self, obj: Any, name: str) -> None:\n        if not hasattr(obj, \"__iter__\"):\n            raise ConversionError(f\"'{name}' is not iterable\", {\"name\": name, \"type\": type(obj).__name__})\n\n    def validate_lengths(self, *lists: Sequence[Any]) -> None:\n        if not lists:\n            return\n        lengths = [len(l) for l in lists]\n        first_length = lengths[0]\n        if any(length != first_length for length in lengths):\n            raise ConversionError(\"Input lists have differing lengths\", {\"lengths\": lengths})\n\n    def validate_hashable_ids(self, ids: Sequence[Any]) -> None:\n        for idx, i in enumerate(ids):\n            try:\n                {i: None}\n            except TypeError:\n                raise ConversionError(f\"Non-hashable id '{i}' at index {idx}\", {\"index\": idx, \"value\": i})\n\n\nclass NestedDictConverter:\n    \"\"\"Core service for converting parallel lists into a list of nested dictionaries, applying necessary validations.\"\"\"\n    def __init__(self, validator: Optional[ListValidator] = None) -> None:\n        self._validator = validator or ListValidator()\n\n    def convert(self, ids: Sequence[Any], names: Sequence[str], values: Sequence[Any]) -> List[Dict[Any, Dict[str, Any]]]:\n        self._validator.validate_iterable(ids, \"ids\")\n        self._validator.validate_iterable(names, \"names\")\n        self._validator.validate_iterable(values, \"values\")\n        self._validator.validate_lengths(ids, names, values)\n        self._validator.validate_hashable_ids(ids)\n\n        result: List[Dict[Any, Dict[str, Any]]] = []\n        for id_val, name, value in zip(ids, names, values):\n            entry = self._make_entry(id_val, name, value)\n            result.append(entry)\n        return result\n\n    def _make_entry(self, id_val: Any, name: str, value: Any) -> Dict[Any, Dict[str, Any]]:\n        return {id_val: {name: value}}\n\n\n_default_converter = NestedDictConverter()\n\ndef convert_list_dictionary(ids: list, names: list, values: list) -> list[dict]:\n    \"\"\"\n    Converts three parallel lists (IDs, names, values) into a list of nested dictionaries.\n    Each resulting dictionary maps an ID to a dictionary containing a name-value pair.\n    \"\"\"\n    return _default_converter.convert(ids, names, values)"}
{"task_id": "Mbpp/398", "solution": "import collections\n\ndef sum_of_digits(numbers):\n    \"\"\"\n    Computes the sum of digits of each number in a list and returns the total sum.\n    Handles negative numbers by using their absolute value for digit summation.\n    \"\"\"\n    total_sum = 0\n    for number in numbers:\n        # Convert number to string to iterate through digits, handle negatives by taking absolute value\n        for digit_char in str(abs(number)):\n            total_sum += int(digit_char)\n    return total_sum"}
