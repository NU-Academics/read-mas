{"task_id": "Mbpp/87", "solution": "from typing import Dict, Any\n\ndef merge_dictionaries_three(d1: dict, d2: dict, d3: dict) -> dict:\n    \"\"\"\n    Merges three dictionaries into a single dictionary, with values from\n    earlier dictionaries taking precedence for duplicate keys.\n    The merge order is d1, then d2, then d3.\n    \"\"\"\n    merged_dict: Dict[Any, Any] = {}\n    for d in (d1, d2, d3):\n        for key, value in d.items():\n            if key not in merged_dict:\n                merged_dict[key] = value\n    return merged_dict"}
{"task_id": "Mbpp/90", "solution": "from collections.abc import Sequence\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to the word length functions.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InputValidator:\n    \"\"\"Validates raw input to ensure it's a sequence of strings.\"\"\"\n    def validate_words(self, items: Sequence) -> list[str]:\n        if not isinstance(items, Sequence):\n            raise InvalidInputError(\"Input must be a sequence of strings\")\n        result = []\n        for i, elem in enumerate(items):\n            if not isinstance(elem, str):\n                raise InvalidInputError(f\"Element at index {i} is not a string: {repr(elem)}\")\n            result.append(elem)\n        return result\n\nclass WordListModel:\n    \"\"\"Immutable DTO encapsulating a validated list of words.\"\"\"\n    def __init__(self, words: Sequence[str]) -> None:\n        self.words = list(words)\n\n    def get_max_length(self) -> int:\n        \"\"\"Returns the maximum length of words, or 0 if the list is empty.\"\"\"\n        if not self.words:\n            return 0\n        return max(len(w) for w in self.words)\n\nclass LongestWordService:\n    \"\"\"Core algorithm for computing longest word length.\"\"\"\n    def find_longest_length(self, word_list: \"WordListModel\") -> int:\n        max_len = 0\n        for w in word_list.words:\n            l = len(w)\n            if l > max_len:\n                max_len = l\n        return max_len\n\ndef len_log(words: Sequence[str]) -> int:\n    \"\"\"Finds the length of the longest word in a sequence of strings.\"\"\"\n    validator = InputValidator()\n    validated = validator.validate_words(words)\n    model = WordListModel(validated)\n    service = LongestWordService()\n    return service.find_longest_length(model)"}
{"task_id": "Mbpp/89", "solution": "import math\n\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self) -> str:\n        return self.message\n\n\ndef safe_parse_number(value: object) -> float:\n    \"\"\"Parses a raw input value into a finite float, or raises an error.\"\"\"\n    if isinstance(value, (int, float)):\n        if not math.isfinite(value):\n            raise InvalidInputError(f\"Input {value} must be a finite number.\")\n        return float(value)\n    if isinstance(value, str):\n        try:\n            val = float(value.strip())\n            if not math.isfinite(val):\n                raise InvalidInputError(f\"Input '{value}' represents a non-finite number.\")\n            return val\n        except ValueError:\n            raise ValueError(f\"Input '{value}' is not a valid numeric string.\")\n    raise ValueError(f\"Input type {type(value)} is not supported.\")\n\n\nclass Validator:\n    \"\"\"Validates and normalizes raw input values.\"\"\"\n\n    def validate_number(self, raw: object) -> float:\n        \"\"\"Validates the raw input and returns it as a float.\"\"\"\n        try:\n            val = safe_parse_number(raw)\n        except ValueError as e:\n            raise InvalidInputError(str(e))\n        except InvalidInputError:\n            raise\n        return val\n\n\nclass ClosestNumberService:\n    \"\"\"Provides the core logic for finding the closest smaller number.\"\"\"\n\n    def __init__(self) -> None:\n        pass\n\n    def closest_smaller(self, n: float) -> int:\n        \"\"\"Computes the integer strictly less than n that is closest.\"\"\"\n        if not math.isfinite(n):\n            raise InvalidInputError(\"Input must be finite.\")\n        if float(int(n)) == n:\n            return int(n) - 1\n        return math.floor(n)\n\n\n_service = ClosestNumberService()\n_validator = Validator()\n\n\ndef closest_num(n: float | int) -> int:\n    \"\"\"Public API: return closest smaller integer strictly less than n.\"\"\"\n    parsed = _validator.validate_number(n)\n    return _service.closest_smaller(parsed)"}
{"task_id": "Mbpp/91", "solution": "import collections\nfrom typing import List, Optional\n\nfrom .list_repository import ListRepository\nfrom .substring_service import SubstringService\nfrom .input_validator import InputValidator\nfrom .config import DEFAULT_CASE_SENSITIVE\n\n\ndef find_substring(values: List[str], query: str) -> bool:\n    \"\"\"\n    Checks if a string is present as a substring in any of the given list of string values.\n    Uses SubstringService for core logic with a default in-memory repository.\n    \"\"\"\n    # Create instances of dependencies\n    repo = ListRepository(values)\n    validator = InputValidator()\n    \n    # Pass repository and validator to the service\n    service = SubstringService(repository=repo, case_sensitive=DEFAULT_CASE_SENSITIVE, validator=validator)\n    \n    # Call the service method, passing the values directly to ensure the provided list is used.\n    # The `values` parameter in `contains` method takes precedence over repository values.\n    return service.contains(query, values)"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(n: int) -> bool:\n    \"\"\"\n    Checks if an integer is an undulating number.\n    An undulating number has at least three digits and alternates between exactly two distinct digits (A,B,A,B,...).\n    \"\"\"\n    s = str(abs(n))\n\n    if len(s) < 3:\n        return False\n\n    a, b = s[0], s[1]\n\n    if a == b:\n        return False\n\n    for i in range(len(s)):\n        expected_digit = a if (i % 2 == 0) else b\n        if s[i] != expected_digit:\n            return False\n\n    return True"}
{"task_id": "Mbpp/93", "solution": "from typing import Union\nimport math\n\n# Exception classes, as per the design document.\nclass BaseError(Exception):\n    \"\"\"Base exception for the library.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\nclass ValidationError(BaseError):\n    \"\"\"Exception for input validation failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\n# Utility for exponent validation, as per the design document.\n# This implementation is adapted to adhere to the prompt's constraint\n# \"Do NOT add isinstance() checks or raise exceptions for edge cases\".\ndef validate_exponent(value: Union[int, float]) -> bool:\n    \"\"\"Performs basic validation for the exponent value.\"\"\"\n    # The design suggests raising ValidationError for invalid/extreme exponents.\n    # However, to comply with the prompt, explicit error raising is omitted here.\n    return True\n\n# Adapter for mathematical operations, as per the design document.\nclass MathAdapter:\n    \"\"\"Provides numerical algorithms for exponentiation.\"\"\"\n    def compute(self, base: float, exponent: Union[int, float]) -> float:\n        if isinstance(exponent, int) or (isinstance(exponent, float) and exponent.is_integer()):\n            exp_int = int(exponent)\n            return self._integer_power(float(base), exp_int)\n        return self._float_power(float(base), float(exponent))\n\n    def _integer_power(self, base: float, exponent: int) -> float:\n        \"\"\"Calculates power for integer exponents using exponentiation by squaring.\"\"\"\n        if exponent == 0:\n            return 1.0\n        negative = exponent < 0\n        exp = abs(exponent)\n        result = 1.0\n        b = base\n        while exp:\n            if exp & 1:\n                result *= b\n            b *= b\n            exp >>= 1\n        return 1.0 / result if negative else result\n\n    def _float_power(self, base: float, exponent: float) -> float:\n        \"\"\"Calculates power for float exponents using math.pow.\"\"\"\n        return math.pow(base, exponent)\n\n# Service layer, as per the design document.\nclass PowerService:\n    \"\"\"Orchestrates validation and computation of power values.\"\"\"\n    def __init__(self, adapter: MathAdapter) -> None:\n        self._adapter = adapter\n\n    def power_value(self, base: float, exponent: Union[int, float]) -> float:\n        \"\"\"Computes the value of base to the power of exponent.\"\"\"\n        validate_exponent(exponent)  # Validation call, modified to be a no-op as per constraints.\n        return self._adapter.compute(base, exponent)\n\ndef power(a, b):\n    \"\"\"\n    Calculates the value of 'a' to the power 'b'.\n    \"\"\"\n    math_adapter = MathAdapter()\n    power_service = PowerService(adapter=math_adapter)\n    return power_service.power_value(float(a), b)"}
{"task_id": "Mbpp/95", "solution": "from typing import List, Any\n\ndef Find_Min_Length(list_of_lists: List[List[Any]]) -> int:\n    \"\"\"\n    Finds the length of the smallest list within a list of lists.\n    Raises ValueError if the input list of lists is empty.\n    \"\"\"\n    if not list_of_lists:\n        raise ValueError(\"Input list of lists cannot be empty.\")\n\n    return min(len(inner_list) for inner_list in list_of_lists)"}
{"task_id": "Mbpp/94", "solution": "from typing import List, Tuple, Any\n\ndef index_minimum(data: List[Tuple]) -> Any:\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple with the smallest second value.\n    In case of ties for the smallest second value, the first encountered tuple's first value is returned.\n    \"\"\"\n    min_tuple = min(data, key=lambda item: item[1])\n    return min_tuple[0]"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer n using prime factorization.\n    Assumes n is a positive integer (n >= 1).\n    \"\"\"\n    if n == 1:\n        return 1\n\n    factors = {}\n    temp_n = n\n    d = 2\n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors[d] = factors.get(d, 0) + 1\n            temp_n //= d\n        d += 1 if d == 2 else 2\n\n    if temp_n > 1:\n        factors[temp_n] = factors.get(temp_n, 0) + 1\n\n    count = 1\n    for exponent in factors.values():\n        count *= (exponent + 1)\n        \n    return count"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(values):\n    \"\"\"\n    Multiplies all numbers in an iterable and divides the product by the length of the iterable.\n    Relies on Python's default error handling for non-numeric elements or an empty iterable.\n    \"\"\"\n    product = 1\n    for num in values:\n        product *= num\n    return float(product) / len(values)"}
{"task_id": "Mbpp/97", "solution": "from typing import Any, Iterable, Iterator, Dict, List\nimport collections.abc\nfrom collections import defaultdict\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to the frequency calculation.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\ndef is_iterable(obj: Any) -> bool:\n    \"\"\"Checks if an object is iterable but not a string or bytes.\"\"\"\n    return isinstance(obj, collections.abc.Iterable) and not isinstance(obj, (str, bytes))\n\ndef is_hashable(obj: Any) -> bool:\n    \"\"\"Checks if an object is hashable.\"\"\"\n    try:\n        hash(obj)\n        return True\n    except TypeError:\n        return False\n\nclass FlatInput:\n    \"\"\"Validates input structure and provides iterables for flattening.\"\"\"\n    def __init__(self, data: Any) -> None:\n        self._data = data\n\n    def validate(self) -> None:\n        \"\"\"Ensures the input is an iterable of iterables.\"\"\"\n        if not is_iterable(self._data):\n            raise InvalidInputError(\"Input must be an iterable (e.g., list of lists).\")\n\n        for i, inner in enumerate(self._data):\n            if not is_iterable(inner):\n                raise InvalidInputError(f\"Inner element at index {i} ({inner!r}) is not an iterable.\")\n\n    def as_iterables(self) -> Iterable[Iterable[Any]]:\n        \"\"\"Yields each inner iterable from the validated input.\"\"\"\n        for inner in self._data:\n            yield inner\n\nclass ListFlattener:\n    \"\"\"Flattens one level of nested iterables.\"\"\"\n    def flatten(self, iterables: Iterable[Iterable[Any]]) -> Iterator[Any]:\n        \"\"\"Yields items from each inner iterable.\"\"\"\n        for i, inner in enumerate(iterables):\n            if not is_iterable(inner): # Defensive check, though FlatInput.validate() should cover this.\n                raise InvalidInputError(f\"Inner element at index {i} is not iterable.\")\n            for item in inner:\n                yield item\n\nclass FrequencyCounter:\n    \"\"\"Counts occurrences of hashable items.\"\"\"\n    def count(self, items: Iterable[Any]) -> Dict[Any, int]:\n        \"\"\"Counts occurrences of each item, raising an error for unhashable elements.\"\"\"\n        counts: Dict[Any, int] = defaultdict(int)\n        for item in items:\n            if not is_hashable(item):\n                raise InvalidInputError(f\"Unhashable element encountered: {item!r}\")\n            counts[item] += 1\n        return dict(counts)\n\nclass FrequencyResult:\n    \"\"\"DTO for the frequency calculation result.\"\"\"\n    def __init__(self, result: Dict[Any, int]) -> None:\n        self._result = result\n\n    def to_dict(self) -> Dict[Any, int]:\n        \"\"\"Returns the stored frequency result as a dictionary.\"\"\"\n        return self._result\n\ndef frequency_lists(lists: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists, returned in a dictionary.\n    \"\"\"\n    flat_input = FlatInput(lists)\n    flat_input.validate()\n    iterables_to_flatten = flat_input.as_iterables()\n\n    flattener = ListFlattener()\n    flattened_items = flattener.flatten(iterables_to_flatten)\n\n    counter = FrequencyCounter()\n    result_dict = counter.count(flattened_items)\n\n    return FrequencyResult(result_dict).to_dict()"}
