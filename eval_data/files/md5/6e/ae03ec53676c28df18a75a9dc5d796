{"task_id": "Mbpp/793", "solution": "from typing import List, Optional\n\ndef last(array: List[int], value: int) -> Optional[int]:\n    \"\"\"\n    Finds the last position (highest index) of an element in a sorted array using a modified binary search.\n    Returns the index if found, otherwise None.\n    \"\"\"\n    left, right = 0, len(array) - 1\n    result = None\n\n    while left <= right:\n        mid = (left + right) // 2\n        if array[mid] == value:\n            result = mid\n            left = mid + 1  # Try to find a later occurrence in the right half\n        elif array[mid] < value:\n            left = mid + 1\n        else:\n            right = mid - 1\n    return result"}
{"task_id": "Mbpp/794", "solution": "import re\nimport logging\nfrom dataclasses import dataclass\nfrom typing import Pattern\n\nDEFAULT_PATTERN: str = r\"^a.*b$\"\n\n@dataclass(frozen=True)\nclass MatchResult:\n    text: str\n    matched: bool\n    pattern: str\n\n    def to_dict(self) -> dict[str, object]:\n        return {\"text\": self.text, \"matched\": self.matched, \"pattern\": self.pattern}\n\nclass InputValidator:\n    def validate(self, text: str) -> None:\n        if not isinstance(text, str):\n            raise ValueError(\"text must be a str\")\n\n    def sanitize(self, text: str) -> str:\n        return text.rstrip(\"\\n\")\n\nclass TextMatcher:\n    def __init__(self, pattern: str = DEFAULT_PATTERN) -> None:\n        self._pattern = pattern\n        self._compiled = self.compile_pattern(pattern)\n\n    def compile_pattern(self, pattern: str) -> Pattern:\n        return re.compile(pattern)\n\n    def matches(self, text: str) -> bool:\n        return bool(self._compiled.match(text))\n\nclass LoggerAdapter:\n    def __init__(self, logger_name: str = \"textmatcher\") -> None:\n        self._logger = logging.getLogger(logger_name)\n\n    def debug(self, msg: str, **kwargs) -> None:\n        self._logger.debug(msg, extra=kwargs)\n\n    def info(self, msg: str, **kwargs) -> None:\n        self._logger.info(msg, extra=kwargs)\n\n    def error(self, msg: str, **kwargs) -> None:\n        self._logger.error(msg, extra=kwargs)\n\nclass MatchService:\n    def __init__(self, validator: InputValidator, matcher: TextMatcher, logger: LoggerAdapter) -> None:\n        self.validator = validator\n        self.matcher = matcher\n        self.logger = logger\n\n    def match_text(self, text: str) -> MatchResult:\n        self.validator.validate(text)\n        sanitized = self.validator.sanitize(text)\n        matched = self.matcher.matches(sanitized)\n        self.logger.info(\"match_evaluated\", text=sanitized, matched=matched)\n        return MatchResult(sanitized, matched, self.matcher._pattern)\n\ndef text_starta_endb(text: str) -> bool:\n    \"\"\"\n    Checks if a string starts with 'a', is followed by anything, and ends with 'b'.\n    Raises ValueError for non-string input.\n    \"\"\"\n    validator = InputValidator()\n    matcher = TextMatcher(pattern=DEFAULT_PATTERN)\n    logger = LoggerAdapter()\n    service = MatchService(validator, matcher, logger)\n    return service.match_text(text).matched"}
{"task_id": "Mbpp/799", "solution": "```python\ndef left_rotate(value: int, d: int) -> int:\n    \"\"\"\n    Rotates the bits of a 32-bit unsigned integer to the left by d positions.\n    The rotation wraps around the 32-bit boundary.\n    \"\"\"\n    BIT_WIDTH = 32\n    MASK_32 = 0xFFFFFFFF\n\n    # Normalize shift amount d to be within [0, BIT_WIDTH-1]\n    n = d % BIT_WIDTH\n\n    # Ensure value is treated as an unsigned 32-bit integer\n    u = value & MASK_32\n\n    # Perform the left rotation\n    # (u << n) shifts left, filling with zeros on the right\n    # (u >> (BIT_WIDTH - n)) shifts right, bringing bits from the left end\n    # The result is masked to ensure it remains a 32-bit number\n    rotated = ((u << n) | (u >> (BIT_WIDTH - n))) & MASK_32\n    return rotated\n```"}
{"task_id": "Mbpp/792", "solution": "import collections.abc\nfrom typing import Sequence, Any\n\ndef count_list(items: Sequence[Any], strict: bool = False) -> int:\n    \"\"\"Counts the number of list-like elements in the top-level of the input sequence.\n    When `strict` is True, counts any sequence (excluding strings and bytes).\"\"\"\n    count = 0\n    for elem in items:\n        if strict:\n            if isinstance(elem, collections.abc.Sequence) and not isinstance(elem, (str, bytes)):\n                count += 1\n        else:\n            if isinstance(elem, list):\n                count += 1\n    return count"}
{"task_id": "Mbpp/796", "solution": "import re\nfrom typing import Any, Dict, Union, Optional\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input during sum calculation.\"\"\"\n    def __init__(self, message: str, details: Optional[Dict[str, Any]] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.details = details\n\nNUMERIC_STRING_REGEX = r'^[+-]?\\d+(\\.\\d+)?$'\n\ndef coerce_number(value: Any) -> Union[int, float]:\n    \"\"\"Converts a value to an integer or float if numeric, otherwise raises ValueError.\"\"\"\n    if isinstance(value, (int, float)):\n        return value\n    if isinstance(value, str):\n        s = value.strip()\n        if re.match(NUMERIC_STRING_REGEX, s):\n            if '.' in s:\n                return float(s)\n            return int(s)\n    raise ValueError(f\"Value {value!r} is not numeric/coercible\")\n\ndef return_sum(data: Dict[str, Any]) -> Union[int, float]:\n    \"\"\"\n    Calculates the sum of all numeric values in a dictionary.\n    Values are coerced to numbers; non-numeric values will raise InvalidInputError.\n    \"\"\"\n    if not isinstance(data, dict):\n        raise InvalidInputError(\"Input must be a dictionary\", {\"input_type\": type(data).__name__})\n\n    normalized_values = []\n    errors = {}\n    for k, v in data.items():\n        try:\n            normalized_values.append(coerce_number(v))\n        except ValueError as e:\n            errors[k] = str(e)\n\n    if errors:\n        raise InvalidInputError(\"Some values are not numeric\", {\"value_errors\": errors})\n\n    total = sum(normalized_values)\n\n    # Return integer if all values were integers, otherwise float\n    if all(isinstance(v, int) for v in normalized_values):\n        return int(total)\n    return float(total)"}
{"task_id": "Mbpp/797", "solution": "from typing import Any, Optional\n\nclass InputTypeError(TypeError):\n    \"\"\"Exception raised for invalid input types.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InvalidRangeError(ValueError):\n    \"\"\"Exception raised for invalid range conditions.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nMIN_NATURAL = 1\n\ndef validate_int(name: str, value: Any) -> int:\n    \"\"\"Validates that a value is an integer, raising InputTypeError if not.\"\"\"\n    if not isinstance(value, int):\n        raise InputTypeError(f\"{name} must be an integer, but got {type(value).__name__}\")\n    return value\n\ndef first_odd_ge(x: int) -> int:\n    \"\"\"Returns the smallest odd integer greater than or equal to x.\"\"\"\n    return x if x % 2 == 1 else x + 1\n\ndef last_odd_le(x: int) -> int:\n    \"\"\"Returns the largest odd integer less than or equal to x.\"\"\"\n    return x if x % 2 == 1 else x - 1\n\nclass Range:\n    \"\"\"Represents an inclusive integer range [l, r].\"\"\"\n    def __init__(self, l: int, r: int) -> None:\n        self.l = l\n        self.r = r\n\n    def validate(self) -> None:\n        \"\"\"Validates the range boundaries based on business rules.\"\"\"\n        if self.l > self.r:\n            raise InvalidRangeError(\"l must be <= r\")\n        if self.l < MIN_NATURAL or self.r < MIN_NATURAL:\n            raise InvalidRangeError(f\"bounds must be >= {MIN_NATURAL}\")\n\nclass SumResult:\n    \"\"\"A data transfer object for the sum result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass OddSumService:\n    \"\"\"Provides core business logic for summing odd natural numbers.\"\"\"\n    def __init__(self, generator: Optional[Any] = None) -> None:\n        self._generator = generator\n\n    def compute_sum(self, rng: Range) -> SumResult:\n        \"\"\"Computes the sum of odd natural numbers within the given range.\"\"\"\n        first = first_odd_ge(rng.l)\n        last = last_odd_le(rng.r)\n\n        if first > last:\n            return SumResult(0)\n\n        n = ((last - first) // 2) + 1\n        total = n * (first + last) // 2\n        return SumResult(total)\n\nclass SumController:\n    \"\"\"Acts as an adapter for the public API, handling input validation and delegation.\"\"\"\n    def __init__(self, service: OddSumService) -> None:\n        self._service = service\n\n    def sum_in_range(self, l: Any, r: Any) -> int:\n        \"\"\"Validates inputs and delegates the sum computation to the service.\"\"\"\n        l_int = validate_int(\"l\", l)\n        r_int = validate_int(\"r\", r)\n        rng = Range(l_int, r_int)\n        rng.validate()\n        return self._service.compute_sum(rng).value\n\n_default_controller = SumController(service=OddSumService())\n\ndef sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Finds the sum of all odd natural numbers within the inclusive range l and r.\n    This function validates inputs and computes the sum using an arithmetic formula.\n    \"\"\"\n    return _default_controller.sum_in_range(l, r)"}
{"task_id": "Mbpp/798", "solution": "from typing import Any, List, Sequence, Union\nimport math\n\nNumber = Union[int, float]\n\nclass SumError(Exception):\n    \"\"\"Custom exception for errors encountered during sum calculation.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass Utils:\n    \"\"\"Provides utility methods for type coercion.\"\"\"\n    @staticmethod\n    def coerce_to_number(value: Any) -> Number:\n        if isinstance(value, (int, float)) and not isinstance(value, bool):\n            return value\n        if isinstance(value, str):\n            s = value.strip()\n            try:\n                return int(s)\n            except ValueError:\n                try:\n                    return float(s)\n                except ValueError:\n                    raise SumError(f\"Cannot convert '{value}' to number\")\n        raise SumError(f\"Unsupported type: {type(value).__name__}\")\n\nclass ArrayValidator:\n    \"\"\"Validates input arrays and coerces elements to numeric types.\"\"\"\n    def __init__(self, utils: \"Utils\" = None) -> None:\n        self.utils = utils or Utils()\n\n    def validate_and_coerce(self, array: Any) -> List[Number]:\n        if array is None:\n            raise SumError(\"Input array is None\")\n        try:\n            iterable = list(array)\n        except TypeError:\n            raise SumError(\"Input is not iterable\")\n        result = []\n        for v in iterable:\n            result.append(self.utils.coerce_to_number(v))\n        return result\n\nclass ArraySummer:\n    \"\"\"Calculates the sum of a sequence of numbers, preserving integer type if all elements are integers.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def compute_sum(self, numbers: Sequence[Number]) -> Number:\n        if not numbers:\n            return 0\n\n        all_ints = all(isinstance(x, int) for x in numbers)\n\n        if all_ints:\n            return sum(numbers)\n        else:\n            # Use math.fsum for better precision with floating-point numbers\n            return math.fsum(numbers)\n\nclass SumAPI:\n    \"\"\"Provides a programmatic API for summing arrays by orchestrating validation and summation services.\"\"\"\n    def __init__(self, validator: ArrayValidator, summer: ArraySummer) -> None:\n        self.validator = validator\n        self.summer = summer\n\n    def compute(self, array: Sequence[Any]) -> Number:\n        numbers = self.validator.validate_and_coerce(array)\n        return self.summer.compute_sum(numbers)\n\ndef _sum(arr: Sequence[Any]) -> Number:\n    \"\"\"\n    Computes the sum of elements in an array-like input.\n    Accepts integers, floats, and strings convertible to numbers.\n    \"\"\"\n    api = SumAPI(ArrayValidator(), ArraySummer())\n    return api.compute(arr)"}
{"task_id": "Mbpp/800", "solution": "import re\n\n# Compiled regex to match one or more Unicode whitespace characters.\n# \\s matches spaces, tabs, newlines, and various other Unicode whitespace characters.\nWHITESPACE_REGEX = re.compile(r\"\\s+\", flags=re.UNICODE)\n\ndef remove_all_spaces(s: str) -> str:\n    \"\"\"\n    Removes all whitespace characters from a string, including spaces, tabs, and newlines.\n    If the input is None, an empty string is returned.\n    \"\"\"\n    if s is None:\n        return \"\"\n    return WHITESPACE_REGEX.sub(\"\", s)"}
{"task_id": "Mbpp/801", "solution": "from dataclasses import dataclass\n\nclass InvalidInputError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef parse_int(value: object) -> int:\n    \"\"\"\n    Converts a value to an integer, raising InvalidInputError on failure.\n    \"\"\"\n    try:\n        return int(value)\n    except (TypeError, ValueError):\n        raise InvalidInputError(f\"Value '{value}' is not an integer\")\n\n@dataclass\nclass Triple:\n    \"\"\"\n    Domain object representing three integer inputs.\n    \"\"\"\n    a: int\n    b: int\n    c: int\n\nclass InputValidator:\n    \"\"\"\n    Validates inputs and constructs a Triple domain object.\n    \"\"\"\n    def validate(self, a, b, c) -> Triple:\n        return Triple(parse_int(a), parse_int(b), parse_int(c))\n\nclass EqualityService:\n    \"\"\"\n    Contains the core logic to count equal numbers among a Triple.\n    \"\"\"\n    def count_equal(self, triple: Triple) -> int:\n        a, b, c = triple.a, triple.b, triple.c\n        if a == b == c:\n            return 3\n        if a == b or b == c or a == c:\n            return 2\n        return 1\n\ndef test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"\n    Counts the number of equal numbers from three given integers.\n    \"\"\"\n    validator = InputValidator()\n    triple = validator.validate(a, b, c)\n    service = EqualityService()\n    return service.count_equal(triple)"}
{"task_id": "Mbpp/803", "solution": "from math import isqrt\n\ndef is_perfect_square(n):\n    \"\"\"\n    Checks if a given number is a perfect square using integer arithmetic.\n    Negative numbers are not considered perfect squares.\n    \"\"\"\n    if n < 0:\n        return False\n    root = isqrt(n)\n    return root * root == n"}
{"task_id": "Mbpp/806", "solution": "import collections\n\ndef max_run_uppercase(text: str) -> int:\n    \"\"\"\n    Computes the maximum contiguous run length of uppercase characters in a string.\n    Any non-uppercase character resets the current run.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in text:\n        if char.isupper():\n            current_run += 1\n            if current_run > max_run:\n                max_run = current_run\n        else:\n            current_run = 0\n    return max_run"}
{"task_id": "Mbpp/804", "solution": "from typing import Sequence\n\ndef is_product_even(numbers: Sequence[int]) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    The product is even if at least one number in the list is even.\n    \"\"\"\n    for n in numbers:\n        if n % 2 == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers):\n    \"\"\"\n    Finds the first odd number in a given list of numbers.\n    \"\"\"\n    for n in numbers:\n        if n % 2 != 0:\n            return n\n    return None"}
