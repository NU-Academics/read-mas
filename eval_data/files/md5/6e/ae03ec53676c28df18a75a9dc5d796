{"task_id": "Mbpp/787", "solution": "import re\nfrom dataclasses import dataclass\nfrom typing import Optional, Tuple\n\nclass TextMatcherError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self) -> str:\n        return f\"TextMatcherError: {self.message}\"\n\n@dataclass\nclass Config:\n    case_sensitive: bool = True\n    default_pattern: str = r\"abbb\"\n\n    def get_regex_flags(self) -> int:\n        return 0 if self.case_sensitive else re.IGNORECASE\n\n@dataclass(frozen=True)\nclass Pattern:\n    id: str\n    regex: str\n    description: Optional[str] = None\n    compile_flags: int = 0\n\n    def to_regex(self) -> str:\n        return self.regex\n\n@dataclass\nclass MatchResult:\n    matched: bool\n    span: Optional[Tuple[int, int]] = None\n    matched_text: Optional[str] = None\n\n    def __bool__(self) -> bool:\n        return self.matched\n\ndef validate_text(text):\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a str\")\n\nclass RegexAdapter:\n    def search(self, text: str, pattern: Pattern) -> MatchResult:\n        try:\n            compiled = re.compile(pattern.to_regex(), pattern.compile_flags)\n            m = compiled.search(text)\n            if m:\n                return MatchResult(matched=True, span=m.span(), matched_text=m.group(0))\n            return MatchResult(matched=False)\n        except re.error as e:\n            raise TextMatcherError(str(e))\n\nclass PatternMatcher:\n    def __init__(self, adapter: RegexAdapter, pattern: Pattern):\n        self.adapter = adapter\n        self.pattern = pattern\n\n    def match(self, text: str) -> MatchResult:\n        validate_text(text)\n        return self.adapter.search(text, self.pattern)\n\n    def matches(self, text: str) -> bool:\n        return bool(self.match(text))\n\ndef text_match_three(text: str, case_sensitive: Optional[bool] = None) -> bool:\n    \"\"\"\n    Checks if the string contains 'a' followed by exactly three 'b' characters (\"abbb\").\n    \"\"\"\n    cfg = Config() if case_sensitive is None else Config(case_sensitive=case_sensitive)\n    patt = Pattern(id=\"a-followed-by-3-b\", regex=cfg.default_pattern, compile_flags=cfg.get_regex_flags())\n    matcher = PatternMatcher(adapter=RegexAdapter(), pattern=patt)\n    return matcher.matches(text)"}
