{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels in a given string. 'y' is not considered a vowel.\n    \"\"\"\n    VOWELS = frozenset(\"aeiouAEIOU\")\n\n    vowel_chars = []\n    vowel_indices = []\n\n    # Identify and store vowels along with their original indices\n    for i, char in enumerate(s):\n        if char in VOWELS:\n            vowel_chars.append(char)\n            vowel_indices.append(i)\n\n    # Reverse the order of the extracted vowels\n    reversed_vowels = vowel_chars[::-1]\n\n    # Convert the string to a list of characters for mutable modification\n    s_list = list(s)\n\n    # Place the reversed vowels back into their original positions\n    for i, original_index in enumerate(vowel_indices):\n        s_list[original_index] = reversed_vowels[i]\n\n    # Join the list of characters back into a string\n    return \"\".join(s_list)"}
{"task_id": "Mbpp/135", "solution": "from hexagonalnum.config import load_config\nfrom hexagonalnum.calculator import HexagonalCalculator\nfrom hexagonalnum.repository import CacheRepository\nfrom hexagonalnum.service import HexagonalService\nfrom hexagonalnum.controller import HexagonalController\n\ndef hexagonal_num(n: int) -> int:\n    \"\"\"\n    Computes the nth hexagonal number using the defined service architecture.\n    Validates input and optionally uses a cache.\n    \"\"\"\n    # Load configuration settings for caching\n    config = load_config()\n\n    # Initialize the core components of the hexagonal number calculation system\n    calculator = HexagonalCalculator()\n    repository = CacheRepository(\n        enabled=config['CACHE_ENABLED'],\n        cache_path=config['CACHE_PATH']\n    )\n    service = HexagonalService(calculator=calculator, repository=repository)\n    controller = HexagonalController(service=service)\n\n    # Use the controller to handle the request, which orchestrates validation, caching, and computation\n    result = controller.handle(n)\n\n    # Return the computed hexagonal value\n    return result.value"}
