{"task_id": "Mbpp/451", "solution": "import re\nfrom typing import Any, Optional\n\nclass RemoverError(Exception):\n    \"\"\"Domain exception wrapper for all removal-related errors.\"\"\"\n    def __init__(self, message: str, original: Optional[Exception]=None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.original = original\n\n    def __str__(self) -> str:\n        return self.message\n\nclass Config:\n    \"\"\"Centralizes configuration values for the removal process.\"\"\"\n    WHITESPACE_REGEX: str = r\"\\s\"\n    USE_REGEX_BY_DEFAULT: bool = True\n\nclass Validator:\n    \"\"\"Provides common validation helpers.\"\"\"\n    @staticmethod\n    def ensure_str(value: Any) -> str:\n        \"\"\"Ensures the input value is a string, decoding bytes if necessary.\"\"\"\n        if isinstance(value, str):\n            return value\n        if isinstance(value, bytes):\n            try:\n                return value.decode(\"utf-8\")\n            except Exception as e:\n                raise RemoverError(\"Bytes input could not be decoded\", original=e)\n        raise RemoverError(\"Input must be a string\")\n\nclass StringAdapter:\n    \"\"\"Encapsulates low-level string operations for whitespace removal.\"\"\"\n    def remove_whitespace_regex(self, text: str) -> str:\n        \"\"\"Removes all Unicode whitespace characters using regex.\"\"\"\n        return re.sub(r\"\\s+\", \"\", text, flags=re.UNICODE)\n\n    def remove_whitespace_iter(self, text: str) -> str:\n        \"\"\"Removes all Unicode whitespace characters by iterating and checking isspace().\"\"\"\n        return \"\".join(ch for ch in text if not ch.isspace())\n\nclass RemoverService:\n    \"\"\"Implements the core business logic for removing whitespace.\"\"\"\n    def __init__(self, adapter: StringAdapter, config: Config = None) -> None:\n        self._adapter = adapter\n        self._config = config or Config()\n\n    def remove_whitespace(self, text: str) -> str:\n        \"\"\"Performs whitespace removal using the configured adapter method.\"\"\"\n        try:\n            if self._config.USE_REGEX_BY_DEFAULT:\n                return self._adapter.remove_whitespace_regex(text)\n            return self._adapter.remove_whitespace_iter(text)\n        except Exception as e:\n            raise RemoverError(\"Failed to remove whitespace\", original=e)\n\nclass RemoverFacade:\n    \"\"\"Provides a minimal and stable entrypoint for callers.\"\"\"\n    def __init__(self, service: RemoverService) -> None:\n        self.service = service\n\n    def remove(self, text: str) -> str:\n        \"\"\"Validates input text and delegates whitespace removal to the service.\"\"\"\n        try:\n            text = Validator.ensure_str(text)\n            return self.service.remove_whitespace(text)\n        except RemoverError:\n            raise\n        except Exception as e:\n            raise RemoverError(\"Unexpected error in facade\", original=e)\n\n# Initialize a default facade for the top-level function\n_default_facade = RemoverFacade(RemoverService(StringAdapter()))\n\ndef remove_whitespaces(text: str) -> str:\n    \"\"\"\n    Removes all whitespaces from the given string.\n    The implementation uses a layered architecture to perform the operation.\n    \"\"\"\n    return _default_facade.remove(text)"}
{"task_id": "Mbpp/453", "solution": "from math import isqrt\n\ndef sumofFactors(n):\n    \"\"\"\n    Calculates the sum of even factors of a given number.\n    Handles negative inputs by using their absolute value.\n    \"\"\"\n    num = abs(n)\n    if num == 0:\n        return 0\n\n    divisors = set()\n    limit = isqrt(num)\n    for i in range(1, limit + 1):\n        if num % i == 0:\n            divisors.add(i)\n            divisors.add(num // i)\n\n    even_divisors_sum = 0\n    for d in divisors:\n        if d % 2 == 0:\n            even_divisors_sum += d\n            \n    return even_divisors_sum"}
