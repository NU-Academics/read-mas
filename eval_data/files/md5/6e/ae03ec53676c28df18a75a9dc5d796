{"task_id": "Mbpp/267", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the squares of the first n odd natural numbers using a closed-form formula.\n    \"\"\"\n    if n == 0:\n        return 0\n    # Sum of k from 1 to n is n*(n+1)/2\n    s1 = n * (n + 1) // 2\n    # Sum of k^2 from 1 to n is n*(n+1)*(2n+1)/6\n    s2 = n * (n + 1) * (2 * n + 1) // 6\n    # The sum of squares of first n odd numbers is 4 * sum(k^2) - 4 * sum(k) + n\n    return 4 * s2 - 4 * s1 + n"}
{"task_id": "Mbpp/260", "solution": "from typing import Optional, List, Dict\n\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\n\nclass NotFoundError(RuntimeError):\n    \"\"\"Custom exception when a requested item is not found within limits.\"\"\"\n    pass\n\nDEFAULT_CACHE_SIZE = 1024\nSMALL_PRIME_LIMIT = 1000\nDEFAULT_MAX_INDEX = 10000\n\ndef generate_small_primes(limit: int) -> List[int]:\n    \"\"\"Generates primes up to a limit using the Sieve of Eratosthenes.\"\"\"\n    if limit < 2:\n        return []\n    sieve = [True] * (limit + 1)\n    sieve[0] = sieve[1] = False\n    for p in range(2, int(limit**0.5) + 1):\n        if sieve[p]:\n            for multiple in range(p * p, limit + 1, p):\n                sieve[multiple] = False\n    return [p for p, is_prime in enumerate(sieve) if is_prime]\n\nclass NewmanSequence:\n    \"\"\"Computes Newman\u2013Shanks\u2013Williams numbers S(n) efficiently with caching.\"\"\"\n    def __init__(self, cache_max_size: int = DEFAULT_CACHE_SIZE):\n        self.cache: Dict[int, int] = {0: 1, 1: 1}\n        self.cache_max_size = cache_max_size\n\n    def _mul_matrix(self, a: tuple, b: tuple) -> tuple:\n        \"\"\"Multiplies two 2x2 matrices (a11, a12, a21, a22).\"\"\"\n        a11, a12, a21, a22 = a\n        b11, b12, b21, b22 = b\n        return (\n            a11 * b11 + a12 * b21,\n            a11 * b12 + a12 * b22,\n            a21 * b11 + a22 * b21,\n            a21 * b12 + a22 * b22\n        )\n\n    def _matrix_pow(self, n: int) -> tuple:\n        \"\"\"Computes the n-th power of the transition matrix [[2,1],[1,0]].\"\"\"\n        # M = [[2,1],[1,0]]\n        # M^0 = [[1,0],[0,1]] (identity matrix)\n        # M^1 = [[2,1],[1,0]]\n        if n < 0:\n            raise InvalidInputError(\"Matrix power exponent must be non-negative.\")\n        if n == 0:\n            return (1, 0, 0, 1)  # Identity matrix\n\n        res = (1, 0, 0, 1)  # Result starts as identity\n        mat = (2, 1, 1, 0)   # Base matrix M\n\n        while n > 0:\n            if n % 2 == 1:\n                res = self._mul_matrix(res, mat)\n            mat = self._mul_matrix(mat, mat)\n            n //= 2\n        return res\n\n    def compute(self, n: int) -> int:\n        \"\"\"Returns the n-th Newman\u2013Shanks\u2013Williams number S(n).\"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise InvalidInputError(\"n must be a non-negative integer\")\n        if n in self.cache:\n            return self.cache[n]\n\n        # Recurrence: S(0)=1, S(1)=1, S(n)=2*S(n-1)+S(n-2)\n        # Matrix method: [S(k), S(k-1)]^T = M^(k-1) * [S(1), S(0)]^T\n        # Where M = [[2,1],[1,0]].\n        # If M^(n-1) = [[a,b],[c,d]], then S(n) = a*S(1) + b*S(0) = a*1 + b*1 = a+b.\n        # This formula holds for n >= 1. S(0) is a base case.\n\n        if n == 0:\n            value = 1\n        else:\n            a, b, _, _ = self._matrix_pow(n - 1)\n            value = a + b\n\n        # Simple LRU-like cache eviction\n        if len(self.cache) >= self.cache_max_size:\n            self.cache.pop(next(iter(self.cache)))\n        self.cache[n] = value\n        return value\n\nclass PrimalityTester:\n    \"\"\"Tests if a number is prime using trial division and Miller\u2013Rabin.\"\"\"\n    def __init__(self, probabilistic_rounds: int = 10):\n        self._small_primes = generate_small_primes(SMALL_PRIME_LIMIT)\n        # Deterministic bases for Miller-Rabin for numbers up to 2^64 (long long in C++)\n        self._mr_bases_64 = [2, 325, 9375, 28178, 450775, 9780504, 1795265022]\n        self.probabilistic_rounds = probabilistic_rounds\n\n    def _trial_division(self, n: int) -> bool:\n        \"\"\"Checks for divisibility by small primes from the precomputed list.\"\"\"\n        for p in self._small_primes:\n            if p * p > n:\n                break\n            if n % p == 0:\n                return False\n        return True\n\n    def _is_probable_prime_mr(self, n: int, bases: Optional[List[int]]) -> bool:\n        \"\"\"Miller\u2013Rabin primality test using provided bases.\"\"\"\n        d = n - 1\n        s = 0\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n\n        bases_to_use = bases if bases is not None else [2] * self.probabilistic_rounds\n\n        for a in bases_to_use:\n            if a >= n: # Base 'a' must be < n for pow(a, d, n) to be meaningful, skip if too large\n                continue\n            x = pow(a, d, n)\n            if x == 1 or x == n - 1:\n                continue\n\n            composite = True\n            for _ in range(s - 1):\n                x = pow(x, 2, n)\n                if x == n - 1:\n                    composite = False\n                    break\n            if composite:\n                return False\n        return True\n\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Determines if a number is prime using an efficient algorithm.\"\"\"\n        if not isinstance(n, int):\n            raise InvalidInputError(\"Input must be an integer.\")\n        if n < 2:\n            return False\n        if n == 2 or n == 3:\n            return True\n        if n % 2 == 0: # All other even numbers are composite\n            return False\n        \n        # Check against small primes up to SMALL_PRIME_LIMIT\n        if n <= SMALL_PRIME_LIMIT:\n            return n in self._small_primes\n        if not self._trial_division(n):\n            return False\n\n        # Apply Miller-Rabin: deterministic for 64-bit, probabilistic for larger\n        if n.bit_length() <= 64:\n            return self._is_probable_prime_mr(n, self._mr_bases_64)\n        return self._is_probable_prime_mr(n, None)\n\nclass NewmanPrimeService:\n    \"\"\"Orchestrates finding Newman\u2013Shanks\u2013Williams numbers and primes.\"\"\"\n    def __init__(self, sequence: Optional[NewmanSequence] = None, tester: Optional[PrimalityTester] = None, default_max_index: int = DEFAULT_MAX_INDEX):\n        self.sequence = sequence if sequence is not None else NewmanSequence()\n        self.tester = tester if tester is not None else PrimalityTester()\n        self.default_max_index = default_max_index\n\n    def _validate_index(self, n: int) -> None:\n        \"\"\"Validates that n is a non-negative integer.\"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise InvalidInputError(\"Index n must be a non-negative integer.\")\n\n    def _validate_count(self, k: int) -> None:\n        \"\"\"Validates that k is a positive integer (1-based count).\"\"\"\n        if not isinstance(k, int) or k < 1:\n            raise InvalidInputError(\"Count k must be a positive integer (1-based).\")\n\n    def get_number(self, n: int) -> int:\n        \"\"\"Returns the n-th NSW number S(n).\"\"\"\n        self._validate_index(n)\n        return self.sequence.compute(n)\n\n    def get_prime_by_index(self, index: int, max_index: Optional[int] = None) -> int:\n        \"\"\"Finds an NSW prime at or after the given index (0-based).\"\"\"\n        self._validate_index(index)\n        current_max_index = max_index if max_index is not None else self.default_max_index\n\n        i = index\n        while i <= current_max_index:\n            val = self.sequence.compute(i)\n            if self.tester.is_prime(val):\n                return val\n            i += 1\n        raise NotFoundError(f\"No NSW prime found at or after index {index} up to {current_max_index}\")\n\n    def get_prime_by_count(self, k: int, max_index: Optional[int] = None) -> int:\n        \"\"\"Finds the k-th NSW prime (1-based count) by scanning the sequence.\"\"\"\n        self._validate_count(k)\n        current_max_index = max_index if max_index is not None else self.default_max_index\n\n        found_count = 0\n        i = 0\n        while i <= current_max_index:\n            val = self.sequence.compute(i)\n            if self.tester.is_prime(val):\n                found_count += 1\n                if found_count == k:\n                    return val\n            i += 1\n        raise NotFoundError(f\"The {k}-th NSW prime not found within index {current_max_index}\")\n\n_default_service = NewmanPrimeService(NewmanSequence(), PrimalityTester())\n\ndef newman_prime(n: int, mode: str = \"index\", max_index: Optional[int] = None) -> int:\n    \"\"\"\n    Finds the nth Newman\u2013Shanks\u2013Williams prime number.\n\n    By default (`mode='index'`), `n` is interpreted as a 0-based sequence index;\n    if S(n) is prime, it's returned, otherwise the next prime S(m) where m > n is found.\n    If `mode='count'`, `n` is interpreted as the 1-based k-th prime to find.\n    \"\"\"\n    if mode == \"index\":\n        return _default_service.get_prime_by_index(n, max_index=max_index)\n    elif mode == \"count\":\n        return _default_service.get_prime_by_count(n, max_index=max_index)\n    else:\n        raise InvalidInputError(\"mode must be 'index' or 'count'\")"}
{"task_id": "Mbpp/264", "solution": "def dog_age(human_years: float, size: str = 'mixed') -> int:\n    \"\"\"\n    Calculates a dog's age in dog years based on human years and size category.\n    \"\"\"\n    # Configuration for size multipliers as per design context\n    DEFAULT_SIZE_MULTIPLIERS = {\n        'small': 4.3,\n        'medium': 4.0,\n        'large': 5.0,\n        'mixed': 3.7\n    }\n\n    # Handle non-positive human years as 0 dog years, as per design.\n    # The prompt prohibits raising exceptions for edge cases.\n    if human_years <= 0:\n        return 0\n\n    total_dog_years = 0.0\n\n    # Calculate dog years for the first human year\n    if human_years < 1.0:\n        total_dog_years = 15.0 * human_years\n    else:\n        # If human years is 1.0 or more, add 15 dog years for the first year\n        total_dog_years += 15.0\n        \n        # Calculate dog years for the second human year\n        if human_years >= 2.0:\n            total_dog_years += 9.0  # Second year adds 9 dog years\n            remaining_human_years = human_years - 2.0\n        else: # Between 1.0 and 2.0 human years\n            # Proportionally add dog years for the partial second year\n            total_dog_years += 9.0 * (human_years - 1.0)\n            remaining_human_years = 0.0\n        \n        # Calculate dog years for subsequent years based on size multiplier\n        # The design context implies 'size' will be one of the keys,\n        # and explicitly forbids raising exceptions for unknown sizes.\n        multiplier = DEFAULT_SIZE_MULTIPLIERS[size]\n        total_dog_years += remaining_human_years * multiplier\n\n    # Round the final result to the nearest integer as per design.\n    return int(round(total_dog_years))"}
