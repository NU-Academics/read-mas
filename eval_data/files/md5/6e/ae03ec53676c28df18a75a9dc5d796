{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(number: int) -> int:\n    \"\"\"\n    Counts the number of set bits (1s) in a non-negative integer using Python's built-in bit_count.\n    Falls back to a string conversion method if bit_count is not available (for older Python versions).\n    \"\"\"\n    # Using the builtin int.bit_count method (Python 3.10+) for efficiency\n    # For older versions, fallback to bin().count('1')\n    if hasattr(number, 'bit_count'):\n        return number.bit_count()\n    else:\n        return bin(number).count('1')"}
{"task_id": "Mbpp/227", "solution": "import math\nfrom typing import Any, Sequence\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input values, such as non-numeric types or non-finite numbers.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass NumbersDTO:\n    \"\"\"A data transfer object to group three numeric values.\"\"\"\n    def __init__(self, a: float, b: float, c: float) -> None:\n        self.a = a\n        self.b = b\n        self.c = c\n\n    @classmethod\n    def from_args(cls, a: float, b: float, c: float) -> \"NumbersDTO\":\n        return cls(a, b, c)\n\nclass InputValidator:\n    \"\"\"Provides methods to validate and coerce input values to floats.\"\"\"\n    NUMERIC_TYPES = (int, float)\n\n    @classmethod\n    def validate_number(cls, value: Any) -> float:\n        \"\"\"Validates a single value, coercing it to float and checking for finiteness.\"\"\"\n        try:\n            if isinstance(value, cls.NUMERIC_TYPES):\n                f = float(value)\n            else:\n                f = float(value)\n        except (TypeError, ValueError):\n            raise InvalidInputError(f\"Value {value!r} is not numeric\")\n        if not math.isfinite(f):\n            raise InvalidInputError(f\"Value {value!r} is not finite\")\n        return f\n\n    @classmethod\n    def validate_three(cls, args: Sequence[Any]) -> NumbersDTO:\n        \"\"\"Validates a sequence of three values, returning a NumbersDTO if valid.\"\"\"\n        if len(args) != 3:\n            raise InvalidInputError(\"Three values are required\")\n        a = cls.validate_number(args[0])\n        b = cls.validate_number(args[1])\n        c = cls.validate_number(args[2])\n        return NumbersDTO.from_args(a, b, c)\n\nclass MinService:\n    \"\"\"Encapsulates the business logic for finding the minimum of three numbers.\"\"\"\n    @staticmethod\n    def min_of_three(a: float, b: float, c: float) -> float:\n        \"\"\"Computes the minimum of three given float values.\"\"\"\n        return min(a, b, c)\n\nclass APIController:\n    \"\"\"A facade to combine input validation and the minimum calculation logic.\"\"\"\n    def __init__(self, validator: InputValidator = None, service: MinService = None) -> None:\n        self.validator = validator or InputValidator\n        self.service = service or MinService()\n\n    def compute_min(self, a: Any, b: Any, c: Any) -> float:\n        \"\"\"Validates inputs and then computes their minimum.\"\"\"\n        dto = self.validator.validate_three([a, b, c])\n        return self.service.min_of_three(dto.a, dto.b, dto.c)\n\ndef min_of_three(a: Any, b: Any, c: Any) -> float:\n    \"\"\"Finds the minimum of three numbers, validating inputs to ensure they are finite and numeric.\"\"\"\n    return APIController().compute_min(a, b, c)"}
