{"task_id": "Mbpp/71", "solution": "from typing import Sequence, List, Callable, Optional, Tuple, TypeVar, Any\n\nT = TypeVar('T')\n\nclass CombSortAlgorithm:\n    \"\"\"\n    Implements the Comb Sort algorithm.\n    It sorts a list in-place (on a copy) and tracks comparisons and swaps.\n    \"\"\"\n    def __init__(self, shrink: float = 1.3) -> None:\n        self._shrink = shrink\n        self._comparisons = 0\n        self._swaps = 0\n\n    def sort(self, items: Sequence[T], key: Optional[Callable[[T], Any]] = None, reverse: bool = False) -> Tuple[List[T], int, int]:\n        \"\"\"\n        Sorts a copy of the input list using the Comb Sort algorithm.\n        Returns the sorted list, total comparisons, and total swaps.\n        \"\"\"\n        arr = list(items)\n        n = len(arr)\n        gap = n\n        swapped = True\n        self._comparisons = 0\n        self._swaps = 0\n\n        while gap > 1 or swapped:\n            gap = max(1, int(gap / self._shrink))\n            swapped = False\n\n            for i in range(0, n - gap):\n                a = key(arr[i]) if key else arr[i]\n                b = key(arr[i+gap]) if key else arr[i+gap]\n                self._comparisons += 1\n                if (a > b) ^ reverse:\n                    arr[i], arr[i+gap] = arr[i+gap], arr[i]\n                    self._swaps += 1\n                    swapped = True\n        return arr, self._comparisons, self._swaps\n\ndef comb_sort(items: Sequence[T], key: Optional[Callable[[T], Any]] = None, reverse: bool = False) -> List[T]:\n    \"\"\"\n    Sorts a list of elements using the Comb Sort algorithm.\n    Returns a new sorted list.\n    \"\"\"\n    algo = CombSortAlgorithm()\n    sorted_list, _, _ = algo.sort(items, key=key, reverse=reverse)\n    return sorted_list"}
{"task_id": "Mbpp/74", "solution": "from typing import List, Sequence, Dict\n\ndef is_samepatterns(sequence: Sequence[str], pattern: Sequence[str]) -> bool:\n    # Convert inputs to lists for consistent indexing and length checking.\n    seq_list = list(sequence)\n    pat_list = list(pattern)\n\n    # Patterns cannot match if their lengths are different.\n    if len(seq_list) != len(pat_list):\n        return False\n\n    # Dictionaries to store the one-to-one mappings in both directions.\n    # forward_map: maps elements from 'sequence' to 'pattern'.\n    # reverse_map: maps elements from 'pattern' to 'sequence'.\n    forward_map: Dict[str, str] = {}\n    reverse_map: Dict[str, str] = {}\n\n    # Iterate through both lists simultaneously.\n    for s_elem, p_elem in zip(seq_list, pat_list):\n        # Check consistency for the forward mapping:\n        # If s_elem has been mapped before and its current mapping contradicts, return False.\n        if s_elem in forward_map:\n            if forward_map[s_elem] != p_elem:\n                return False\n        else:\n            # Establish new forward mapping.\n            forward_map[s_elem] = p_elem\n\n        # Check consistency for the reverse mapping:\n        # If p_elem has been mapped before and its current mapping contradicts, return False.\n        if p_elem in reverse_map:\n            if reverse_map[p_elem] != s_elem:\n                return False\n        else:\n            # Establish new reverse mapping.\n            reverse_map[p_elem] = s_elem\n\n    # If the loop completes, all elements followed a consistent, bijective pattern.\n    return True"}
{"task_id": "Mbpp/77", "solution": "def is_Diff(n: int) -> bool:\n    \"\"\"\n    Return True if integer n is divisible by 11 using the alternating-sum difference rule.\n    \"\"\"\n    n_abs = abs(n)\n    odd_sum = 0\n    even_sum = 0\n    pos = 1\n    while n_abs > 0:\n        digit = n_abs % 10\n        if pos % 2 == 1:\n            odd_sum += digit\n        else:\n            even_sum += digit\n        n_abs //= 10\n        pos += 1\n    return ((odd_sum - even_sum) % 11) == 0"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(tuples: list[tuple], k: int) -> list[tuple]:\n    \"\"\"\n    Filters a list of tuples, returning only those where all elements are divisible by k.\n    Assumes k is a non-zero integer.\n    \"\"\"\n    result = []\n    for tpl in tuples:\n        if all(element % k == 0 for element in tpl):\n            result.append(tpl)\n    return result"}
