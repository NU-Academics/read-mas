{"task_id": "Mbpp/161", "solution": "from typing import Iterable, List, Any, Set, Tuple\n\ndef _to_hashable_set(iterable: Iterable[Any]) -> Tuple[Set[Any], List[Any]]:\n    \"\"\"Separates an iterable into a set of hashable items and a list of unhashable items.\"\"\"\n    hashables = set()\n    unhashables = []\n    for item in iterable:\n        try:\n            hashables.add(item)\n        except TypeError:\n            unhashables.append(item)\n    return hashables, unhashables\n\ndef remove_elements(source: Iterable[Any], to_remove: Iterable[Any]) -> List[Any]:\n    \"\"\"Removes all elements from source that are present in to_remove, preserving order.\"\"\"\n    hash_set, unhashable_list = _to_hashable_set(to_remove)\n\n    result = []\n    for item in source:\n        if item in hash_set:\n            continue\n        if any(item == u for u in unhashable_list):\n            continue\n        result.append(item)\n    return result"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) from i=0 to n // 2.\n    For n <= 0, the sum is 0 as per design assumptions.\n    \"\"\"\n    if n <= 0:\n        return 0\n    \n    # Calculate k, the upper bound for i, which is n // 2.\n    k = n // 2\n    \n    # The number of terms in the series is k + 1 (from i=0 to i=k).\n    num_terms = k + 1\n    \n    # The first term in the series is when i=0, which is n - 2*0 = n.\n    first_term = n\n    \n    # The last term in the series is when i=k, which is n - 2*k.\n    last_term = n - 2 * k\n    \n    # The sum of an arithmetic series is (number of terms * (first term + last term)) // 2.\n    # Integer division is used as the result is an integer.\n    total_sum = num_terms * (first_term + last_term) // 2\n    \n    return total_sum"}
{"task_id": "Mbpp/165", "solution": "import string\n\ndef count_char_position(s: str) -> int:\n    \"\"\"\n    Counts characters in a string that match their 1-based English alphabet position (case-insensitive).\n    Positions beyond 26 do not match.\n    \"\"\"\n    count = 0\n    alphabet = string.ascii_lowercase\n    for i, char_in_s in enumerate(s, start=1):\n        if 1 <= i <= len(alphabet) and char_in_s.lower() == alphabet[i - 1]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple,\n    or None if no solution exists.\n    \"\"\"\n\n    # Nested helper for Extended Euclidean Algorithm to find g = gcd(val_a, val_b)\n    # and coefficients x0, y0 such that val_a * x0 + val_b * y0 = g.\n    def _extended_gcd(val_a: int, val_b: int) -> tuple[int, int, int]:\n        a0, b0 = abs(val_a), abs(val_b)\n        old_r, r = a0, b0\n        old_s, s = 1, 0\n        old_t, t = 0, 1\n\n        while r != 0:\n            q = old_r // r\n            old_r, r = r, old_r - q * r\n            old_s, s = s, old_s - q * s\n            old_t, t = t, old_t - q * t\n        \n        g = old_r\n        # Adjust signs of x and y based on original val_a, val_b\n        x = old_s * (1 if val_a >= 0 else -1)\n        y = old_t * (1 if val_b >= 0 else -1)\n        return g, x, y\n\n    g, x0, y0 = _extended_gcd(a, b)\n\n    if g == 0:\n        # This case implies a=0 and b=0.\n        # The equation becomes 0x + 0y = n.\n        # If n is also 0, there are infinite solutions, but the problem usually expects a determined result\n        # or considers this an invalid input scenario. Returning None covers \"no solution\" or \"invalid input\"\n        # in a uniform way for this function.\n        return None\n\n    if n % g != 0:\n        return None  # No integer solution exists if n is not divisible by gcd(a, b)\n\n    # Scale the coefficients to find a particular solution for ax + by = n\n    k = n // g\n    x_particular = x0 * k\n    y_particular = y0 * k\n\n    # Normalize the solution to obtain a specific canonical form (e.g., smallest non-negative x).\n    # This helps satisfy specific test cases like (2, 3, 7) == (2, 1).\n    \n    if b == 0:\n        # If b is 0, the equation is ax = n. x_particular is unique.\n        # The y value derived from extended_gcd for b=0 is 0.\n        return (x_particular, y_particular)\n    if a == 0:\n        # If a is 0, the equation is by = n. y_particular is unique.\n        # The x value derived from extended_gcd for a=0 is 0.\n        return (x_particular, y_particular)\n\n    # For non-zero a and b, normalize x to be in the range [0, abs(b/g)).\n    # This ensures a consistent particular solution.\n    b_prime = b // g  # This is the step size for x in the general solution\n    \n    # Calculate x_final such that 0 <= x_final < abs(b_prime)\n    x_final = x_particular % b_prime\n    if x_final < 0:\n        x_final += b_prime # Ensure x_final is non-negative if b_prime is positive\n\n    # Determine the 't' adjustment factor that transforms x_particular to x_final\n    t_adjust = (x_final - x_particular) // b_prime\n\n    # Apply the same adjustment to y\n    a_prime = a // g  # This is the step size for y in the general solution\n    y_final = y_particular - t_adjust * a_prime\n\n    return (x_final, y_final)"}
