{"task_id": "Mbpp/644", "solution": "from typing import List, Sequence, TypeVar\n\nT = TypeVar(\"T\")\n\ndef reverse_Array_Upto_K(arr: Sequence[T], k: int) -> List[T]:\n    \"\"\"\n    Reverses the first k elements of an array (list) and returns a new list.\n    If k is greater than the array's length, the entire array is reversed.\n    \"\"\"\n    n = len(arr)\n    # Determine the effective cut-off point for reversal, capped by array length.\n    cut = min(k, n)\n    \n    # Separate the array into the part to be reversed (prefix) and the rest (suffix).\n    prefix = arr[:cut]\n    suffix = arr[cut:]\n    \n    # Reverse the prefix and combine it with the unmodified suffix, returning a new list.\n    return list(prefix[::-1]) + list(suffix)"}
{"task_id": "Mbpp/643", "solution": "import re\n\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"Checks if any word in the string contains 'z' as an interior character.\n    A word must have 'z' neither at its beginning nor at its end.\"\"\"\n    word_pattern = re.compile(r\"\\b\\w+\\b\")\n    Z_CHAR = \"z\"\n\n    for match in word_pattern.finditer(text):\n        word = match.group(0)\n        if len(word) < 3:\n            continue\n        # Check for 'z' in the middle (not at index 0 or len-1)\n        for i in range(1, len(word) - 1):\n            if word[i] == Z_CHAR:\n                return True\n    return False"}
