{"task_id": "Mbpp/428", "solution": "from typing import List, Union\n\ndef shell_sort(arr: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"\n    Sorts a list using the Shell Sort algorithm with Knuth's gap sequence.\n    The function returns a new sorted list without modifying the original.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n\n    # Work on a copy of the input array to avoid modifying the original\n    arr_copy = list(arr)\n\n    # Generate Knuth's gap sequence: 1, 4, 13, 40, ...\n    # Store them in descending order for the sorting passes.\n    gaps = []\n    h = 1\n    while h < n:\n        gaps.insert(0, h) # Prepend to get descending sequence\n        h = 3 * h + 1\n\n    # Perform Shell sort passes for each gap\n    for gap in gaps:\n        # Perform insertion sort for elements at 'gap' interval\n        # Start from `gap` index and iterate through the array\n        for i in range(gap, n):\n            temp = arr_copy[i]\n            j = i\n            # Shift elements in the `gap`-separated sub-array\n            while j >= gap and arr_copy[j - gap] > temp:\n                arr_copy[j] = arr_copy[j - gap]\n                j -= gap\n            arr_copy[j] = temp\n    \n    return arr_copy"}
{"task_id": "Mbpp/429", "solution": "class AndTuplesError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n    def __str__(self) -> str:\n        return self.message\n\nclass TuplePair:\n    def __init__(self, a: tuple[int, ...], b: tuple[int, ...]) -> None:\n        if not (isinstance(a, tuple) and isinstance(b, tuple)):\n            raise AndTuplesError(\"TuplePair requires tuple inputs\")\n        self._a = a\n        self._b = b\n\n    def as_tuples(self) -> tuple[tuple[int, ...], tuple[int, ...]]:\n        return (self._a, self._b)\n\nclass AndResult:\n    def __init__(self, result: tuple[int, ...]) -> None:\n        self._result = result\n\n    def as_tuple(self) -> tuple[int, ...]:\n        return self._result\n\nfrom typing import Any, Sequence\nclass Validator:\n    ALLOW_NEGATIVES: bool = False\n\n    def __init__(self, allow_negatives: bool = ALLOW_NEGATIVES) -> None:\n        self._allow_negatives = allow_negatives\n\n    def validate_and_build(self, a: Any, b: Any) -> TuplePair:\n        try:\n            ta = tuple(a)\n            tb = tuple(b)\n        except TypeError:\n            raise AndTuplesError(\"Inputs must be iterable sequences of integers\")\n        if len(ta) != len(tb):\n            raise AndTuplesError(\"Input sequences must have equal length\")\n        for i, (x, y) in enumerate(zip(ta, tb)):\n            if not isinstance(x, int) or not isinstance(y, int):\n                raise AndTuplesError(f\"Elements at index {i} are not integers\")\n            if not self._allow_negatives and (x < 0 or y < 0):\n                raise AndTuplesError(\"Negative integers not allowed by validator\")\n        return TuplePair(ta, tb)\n\n    def parse_tuple_literal(self, s: str) -> tuple[int, ...]:\n        try:\n            cleaned = s.strip()\n            if cleaned.startswith(\"(\") and cleaned.endswith(\")\"):\n                cleaned = cleaned[1:-1]\n            if cleaned == \"\":\n                return tuple()\n            parts = [p.strip() for p in cleaned.split(\",\")]\n            return tuple(int(p) for p in parts)\n        except Exception as exc:\n            raise AndTuplesError(\"Unable to parse tuple literal\") from exc\n\nclass AndService:\n    def __init__(self, validator: Validator) -> None:\n        self._validator = validator\n\n    def compute(self, a: Sequence[int], b: Sequence[int]) -> tuple[int, ...]:\n        pair = self._validator.validate_and_build(a, b)\n        result = self._compute_pair(pair)\n        return result.as_tuple()\n\n    def _compute_pair(self, pair: TuplePair) -> AndResult:\n        a, b = pair.as_tuples()\n        res = tuple(x & y for x, y in zip(a, b))\n        return AndResult(res)\n\ndef and_tuples(a, b):\n    validator = Validator()\n    service = AndService(validator)\n    return service.compute(a, b)"}
{"task_id": "Mbpp/433", "solution": "from typing import List\n\ndef check_greater(array: List[int], number: int) -> bool:\n    \"\"\"\n    Checks if the entered number is strictly greater than all elements of the given array.\n    Returns True if the array is empty (vacuously true).\n    \"\"\"\n    for elem in array:\n        if not (number > elem):\n            return False\n    return True"}
{"task_id": "Mbpp/430", "solution": "import math\n\nclass ParabolaError(Exception):\n    \"\"\"Base exception for parabola-related errors.\"\"\"\n    pass\n\nclass InvalidCoefficientError(ParabolaError):\n    \"\"\"Raised when a coefficient has an invalid value, e.g., 'a' is zero.\"\"\"\n    pass\n\nclass ValidationError(ParabolaError):\n    \"\"\"Raised when input validation fails, e.g., non-finite numbers.\"\"\"\n    pass\n\n# Epsilon for float comparisons, from _config.py in design context.\nEPSILON = 1e-12\n\ndef parabola_directrix(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Computes the y-coordinate of the directrix for a vertical parabola\n    defined by the equation y = ax^2 + bx + c.\n    \"\"\"\n    if not (math.isfinite(a) and math.isfinite(b) and math.isfinite(c)):\n        raise ValidationError(\"Coefficients a, b, and c must be finite numbers.\")\n\n    if abs(a) < EPSILON:\n        raise InvalidCoefficientError(\"Coefficient 'a' cannot be zero for a parabola.\")\n\n    # Calculate the y-coordinate of the vertex (k)\n    k = c - (b**2) / (4 * a)\n    # Calculate the focal length (p)\n    p = 1.0 / (4.0 * a)\n\n    # The directrix for a vertical parabola is y = k - p\n    directrix_y = k - p\n    return directrix_y"}
