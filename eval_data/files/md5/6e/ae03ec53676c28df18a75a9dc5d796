{"task_id": "Mbpp/120", "solution": "```python\nimport math\n\ndef max_product_tuple(pairs):\n    \"\"\"\n    Calculates the maximum absolute product between numbers in pairs of tuples.\n    Assumes valid input: a list of tuples, where each tuple contains two numbers.\n    \"\"\"\n    max_val = 0.0\n    for a, b in pairs:\n        current_product = abs(a * b)\n        if current_product > max_val:\n            max_val = current_product\n    return max_val\n```"}
{"task_id": "Mbpp/123", "solution": "import math\nimport os\nimport json\nfrom typing import List, Dict, Optional, Set\n\n# --- exceptions.py ---\nclass AmicableError(Exception):\n    \"\"\"Base exception for the amicable application.\"\"\"\n    pass\n\nclass InvalidInputError(AmicableError, ValueError):\n    \"\"\"Raised when input parameters are invalid.\"\"\"\n    pass\n\n# --- models.py ---\nclass AmicableResult:\n    \"\"\"Data transfer object for amicable numbers and their sum.\"\"\"\n    def __init__(self, numbers: List[int], total: int) -> None:\n        self.numbers = numbers\n        self.total = total\n\n# --- config.py ---\nclass Config:\n    \"\"\"Configuration holder for dependency injection.\"\"\"\n    def __init__(self, cache_enabled: bool = True, cache_path: str = \"~/.cache/amicable_cache.json\") -> None:\n        self.cache_enabled = cache_enabled\n        self.cache_path = os.path.expanduser(cache_path)\n\n# --- cache_repository.py ---\nclass CacheRepository:\n    \"\"\"Manages in-memory cache and optional JSON persistence for divisor sums.\"\"\"\n    def __init__(self, enabled: bool = True, path: Optional[str] = None) -> None:\n        self._enabled = enabled\n        self._path = path\n        self._mem_cache: Dict[int, int] = {}\n        if self._enabled and self._path:\n            self.load()\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieve a cached value for n.\"\"\"\n        return self._mem_cache.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Store a value in the cache.\"\"\"\n        if self._enabled:\n            self._mem_cache[n] = value\n\n    def persist(self) -> None:\n        \"\"\"Write the in-memory cache to a JSON file.\"\"\"\n        if not self._enabled or not self._path or not self._mem_cache:\n            return\n        \n        cache_dir = os.path.dirname(self._path)\n        if cache_dir and not os.path.exists(cache_dir):\n            os.makedirs(cache_dir, exist_ok=True)\n\n        try:\n            serializable_cache = {str(k): v for k, v in self._mem_cache.items()}\n            with open(self._path, 'w') as f:\n                json.dump(serializable_cache, f)\n        except IOError:\n            # Handle file errors gracefully for non-critical cache\n            pass\n\n    def load(self) -> None:\n        \"\"\"Load persisted cache into memory.\"\"\"\n        if not self._enabled or not self._path or not os.path.exists(self._path):\n            return\n        try:\n            with open(self._path, 'r') as f:\n                loaded_cache = json.load(f)\n                self._mem_cache = {int(k): v for k, v in loaded_cache.items()}\n        except (IOError, json.JSONDecodeError):\n            # Handle file errors or corrupt JSON gracefully\n            self._mem_cache = {}\n\n# --- divisor_service.py ---\nclass DivisorService:\n    \"\"\"Computes the sum of proper divisors for a given integer.\"\"\"\n    def __init__(self, cache: Optional[CacheRepository] = None) -> None:\n        self._cache = cache\n\n    def sum_proper_divisors(self, n: int) -> int:\n        \"\"\"Returns the sum of proper divisors of n, using cache if available.\"\"\"\n        if not isinstance(n, int) or n < 1:\n            raise InvalidInputError(\"n must be integer >= 1\")\n        \n        cached = self._cache.get(n) if self._cache else None\n        if cached is not None:\n            return cached\n        \n        s = self._compute_sum(n)\n        if self._cache:\n            self._cache.set(n, s)\n        return s\n\n    def _compute_sum(self, n: int) -> int:\n        \"\"\"Efficiently computes the sum of proper divisors by iterating up to sqrt(n).\"\"\"\n        if n == 1:\n            return 0 # Proper divisors of 1 sum to 0\n        \n        sum_div = 1 # 1 is always a proper divisor for n > 1\n        limit = int(math.sqrt(n))\n        for i in range(2, limit + 1):\n            if n % i == 0:\n                sum_div += i\n                if i * i != n: # Add the paired divisor if not a perfect square\n                    sum_div += n // i\n        return sum_div\n\n# --- amicable_calculator.py ---\nclass AmicableCalculator:\n    \"\"\"Core logic to discover amicable numbers and compute their sum.\"\"\"\n    def __init__(self, divisor_service: DivisorService, cache: CacheRepository) -> None:\n        self._ds = divisor_service\n        self._cache = cache # Stored for completeness per design, but primarily used by DivisorService\n\n    def find_sum(self, limit: int) -> AmicableResult:\n        \"\"\"Finds all amicable numbers up to limit and returns their sum.\"\"\"\n        if not isinstance(limit, int) or limit < 2:\n            raise InvalidInputError(\"limit must be int >= 2\")\n        \n        amicables: Set[int] = set()\n        for a in range(2, limit + 1):\n            b = self._ds.sum_proper_divisors(a)\n            \n            # Check amicability condition: a != b, b > 0, and sum_proper_divisors(b) == a\n            if b != a and b > 0:\n                if self._ds.sum_proper_divisors(b) == a:\n                    if a <= limit:\n                        amicables.add(a)\n                    if b <= limit:\n                        amicables.add(b)\n        \n        total = sum(amicables)\n        return AmicableResult(sorted(list(amicables)), total)\n\n# --- __init__.py (integration/entry point) ---\n_default_config = Config()\n_default_cache = CacheRepository(enabled=_default_config.cache_enabled, path=_default_config.cache_path)\n_default_divisor = DivisorService(cache=_default_cache)\n_default_calc = AmicableCalculator(divisor_service=_default_divisor, cache=_default_cache)\n\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Sums all amicable numbers from 1 to a specified number (inclusive).\n    \"\"\"\n    result = _default_calc.find_sum(limit)\n    _default_cache.persist() # Persist cache on function completion\n    return result.total"}
{"task_id": "Mbpp/128", "solution": "import re\nfrom typing import List\n\ndef long_words(n: int, text: str) -> List[str]:\n    \"\"\"\n    Finds words longer than n characters from a given text string.\n    Punctuation is stripped from words before checking their length.\n    \"\"\"\n    PUNCTUATION_PATTERN = re.compile(r'^[^\\w]+|[^\\w]+$')\n    \n    words = []\n    for raw_word in text.split():\n        # Remove leading and trailing punctuation\n        cleaned_word = PUNCTUATION_PATTERN.sub('', raw_word)\n        if cleaned_word and len(cleaned_word) > n:\n            words.append(cleaned_word)\n            \n    return words"}
{"task_id": "Mbpp/126", "solution": "import math\n\ndef sum(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the sum of common divisors of two integers a and b.\n    It considers the absolute values of a and b for GCD calculation.\n    \"\"\"\n    # Calculate the greatest common divisor of the absolute values of a and b.\n    g = math.gcd(abs(a), abs(b))\n\n    # If the GCD is 0 (e.g., gcd(0,0)), there are no positive common divisors.\n    if g == 0:\n        return 0\n\n    # Find all positive divisors of the GCD.\n    divs = set()\n    limit = int(g**0.5)\n    for i in range(1, limit + 1):\n        if g % i == 0:\n            divs.add(i)\n            divs.add(g // i)\n            \n    # Sum the found divisors.\n    return sum(divs)"}
{"task_id": "Mbpp/124", "solution": "import math\nfrom typing import Union\n\ndef angle_complex(a: Union[float, complex], b: Union[float, complex, None] = None) -> float:\n    \"\"\"\n    Computes the angle (argument) of a complex number in radians.\n    Handles single complex input or two separate real and imaginary components.\n    \"\"\"\n    if b is None:\n        if isinstance(a, complex):\n            real_part = a.real\n            imag_part = a.imag\n        else: # Assume a is a float representing the real part\n            real_part = float(a)\n            imag_part = 0.0\n    else:\n        real_part = float(a)\n        if isinstance(b, complex):\n            imag_part = b.imag\n        else:\n            imag_part = float(b)\n\n    # Handle the (0,0) case to return 0.0 as per design\n    if real_part == 0.0 and imag_part == 0.0:\n        return 0.0\n    \n    return math.atan2(imag_part, real_part)"}
