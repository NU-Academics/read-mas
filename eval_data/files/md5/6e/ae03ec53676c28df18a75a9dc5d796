{"task_id": "Mbpp/137", "solution": "from dataclasses import dataclass, asdict\nfrom datetime import datetime\nfrom typing import Iterable, Any, List, Optional\n\nclass ZeroRatioError(Exception):\n    \"\"\"Base exception for zero_ratio module errors.\"\"\"\n    pass\n\nclass ValidationError(ZeroRatioError):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    pass\n\n@dataclass\nclass ArrayStats:\n    \"\"\"Data Transfer Object for array statistics.\"\"\"\n    zeros: int\n    nonzeros: int\n    ratio: float\n    timestamp: str\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the ArrayStats object to a dictionary.\"\"\"\n        return asdict(self)\n\n    @staticmethod\n    def from_dict(d: dict) -> \"ArrayStats\":\n        \"\"\"Creates an ArrayStats object from a dictionary.\"\"\"\n        return ArrayStats(d[\"zeros\"], d[\"nonzeros\"], d[\"ratio\"], d[\"timestamp\"])\n\ndef validate_int_array(arr: Iterable[Any]) -> List[int]:\n    \"\"\"\n    Validates that all elements in the iterable can be converted to integers.\n    Raises ValidationError if input is None or contains non-integer convertible elements.\n    \"\"\"\n    if arr is None:\n        raise ValidationError(\"Input cannot be None.\")\n    try:\n        return [int(x) for x in arr]\n    except Exception as e:\n        raise ValidationError(f\"Invalid input: {e}\")\n\nclass ZeroRatioService:\n    \"\"\"\n    Service to compute the ratio of zeroes to non-zeroes in an array.\n    \"\"\"\n    def __init__(self, repository: Optional[Any] = None):\n        \"\"\"Initializes the ZeroRatioService with an optional repository.\"\"\"\n        self._repository = repository\n\n    def compute_ratio(self, arr: List[int]) -> ArrayStats:\n        \"\"\"\n        Computes the ratio of zeroes to non-zeroes from a validated integer array.\n        Handles empty arrays and arrays with no non-zero elements according to business rules.\n        \"\"\"\n        zeros = sum(1 for x in arr if x == 0)\n        nonzeros = len(arr) - zeros\n\n        if len(arr) == 0:\n            ratio = 0.0\n        elif nonzeros == 0:\n            ratio = float('inf')\n        else:\n            ratio = zeros / nonzeros\n\n        stat = ArrayStats(zeros=zeros, nonzeros=nonzeros, ratio=ratio, timestamp=datetime.utcnow().isoformat() + \"Z\")\n\n        # Persistence is optional and not active for the public zero_count function.\n        if self._repository:\n            # try:\n            #     self._repository.persist(stat)\n            # except PersistenceError:\n            #     # Fail-soft: log error and continue.\n            pass\n        return stat\n\ndef zero_count(arr: Iterable[Any]) -> float:\n    \"\"\"\n    Calculates the ratio of zeroes to non-zeroes in an array of integers.\n    Returns 0.0 for an empty array, float('inf') for an array with only zeroes.\n    \"\"\"\n    service = ZeroRatioService(repository=None)\n    validated_arr = validate_int_array(arr)\n    stats = service.compute_ratio(validated_arr)\n    return stats.ratio"}
{"task_id": "Mbpp/142", "solution": "import typing\n\ndef count_samepair(list1: typing.Sequence[typing.Any], list2: typing.Sequence[typing.Any], list3: typing.Sequence[typing.Any]) -> int:\n    \"\"\"\n    Counts the number of items that are identical in the same position across three given lists.\n    Comparison is done up to the minimum length of the three lists.\n    \"\"\"\n    min_len = min(len(list1), len(list2), len(list3))\n    count = 0\n    for i in range(min_len):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/140", "solution": "from typing import Iterable, Set, Any, Iterator\nimport collections.abc\n\nclass InputValidationError(Exception):\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\ndef _is_iterable(obj: Any) -> bool:\n    \"\"\"Checks if an object is iterable but not a string.\"\"\"\n    if isinstance(obj, str):\n        return False\n    return isinstance(obj, collections.abc.Iterable)\n\ndef _validate_iterables(iterables: Any) -> None:\n    \"\"\"Validates the input structure and types.\"\"\"\n    if not _is_iterable(iterables):\n        raise InputValidationError(\"Top-level input must be iterable.\")\n\n    for i, sub_iterable in enumerate(iterables):\n        if not _is_iterable(sub_iterable):\n            raise InputValidationError(f\"Element at index {i} is not an iterable: {sub_iterable!r}\")\n        for j, item in enumerate(sub_iterable):\n            if not isinstance(item, int):\n                raise InputValidationError(f\"Item at index [{i}][{j}] is not an integer: {item!r}\")\n\ndef _iterate_items(iterables: Iterable[Iterable[int]]) -> Iterator[int]:\n    \"\"\"Yields all integer items from nested iterables.\"\"\"\n    for sub_iterable in iterables:\n        for item in sub_iterable:\n            yield item\n\ndef _format_as_set(values: Iterable[int]) -> Set[int]:\n    \"\"\"Converts an iterable of integers to a set.\"\"\"\n    return set(values)\n\ndef extract_singly(iterables: Iterable[Iterable[int]]) -> Set[int]:\n    \"\"\"\n    Flattens a list of lists into a single set of numbers.\n    \"\"\"\n    _validate_iterables(iterables)\n    flattened_items = _iterate_items(iterables)\n    return _format_as_set(flattened_items)"}
{"task_id": "Mbpp/141", "solution": "from typing import TypeVar, List, Sequence, Tuple\n\nT = TypeVar(\"T\")\n\nclass PancakeSorter:\n    \"\"\"\n    Implements the Pancake Sort algorithm.\n    \"\"\"\n    def pancake_sort(self, seq: Sequence[T]) -> Tuple[List[T], List[int]]:\n        \"\"\"\n        Sorts a sequence using the Pancake Sort algorithm.\n        Returns the sorted list and a list of flip operations.\n        \"\"\"\n        arr = list(seq)\n        n = len(arr)\n        steps: List[int] = []\n\n        for curr_size in range(n, 1, -1):\n            max_idx = self._find_max_index(arr, curr_size)\n\n            if max_idx != curr_size - 1:\n                if max_idx != 0:\n                    self._flip(arr, max_idx + 1)\n                    steps.append(max_idx + 1)\n                \n                self._flip(arr, curr_size)\n                steps.append(curr_size)\n        return arr, steps\n\n    def _flip(self, arr: List[T], k: int) -> None:\n        \"\"\"\n        Reverses the order of the first k elements in the given list.\n        \"\"\"\n        arr[:k] = list(reversed(arr[:k]))\n\n    def _find_max_index(self, arr: List[T], upto: int) -> int:\n        \"\"\"\n        Finds the index of the maximum element in the sub-array arr[0:upto].\n        \"\"\"\n        return max(range(upto), key=lambda i: arr[i])\n\ndef pancake_sort(seq: Sequence[T]) -> List[T]:\n    \"\"\"\n    Sorts a list of elements using the Pancake Sort algorithm.\n    \"\"\"\n    sorter = PancakeSorter()\n    sorted_list, _ = sorter.pancake_sort(seq)\n    return sorted_list"}
