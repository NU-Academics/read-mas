{"task_id": "Mbpp/259", "solution": "import ast\nfrom datetime import datetime\nfrom typing import Any, List, Optional, Tuple, Dict, Iterator\nfrom uuid import uuid4\n\nclass ValidationError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass TuplePair:\n    def __init__(self, values: Tuple[int, ...]) -> None:\n        if not all(isinstance(x, int) for x in values):\n            raise ValidationError(\"TuplePair values must be all integers\")\n        self.values: Tuple[int, ...] = tuple(values)\n\n    def to_tuple(self) -> Tuple[int, ...]:\n        return self.values\n\n    def __len__(self) -> int:\n        return len(self.values)\n\n    def __getitem__(self, index: int) -> int:\n        return self.values[index]\n\nclass TupleCollection:\n    def __init__(self, pairs: Tuple[TuplePair, ...]) -> None:\n        self.pairs: Tuple[TuplePair, ...] = tuple(pairs)\n\n    def length(self) -> int:\n        return len(self.pairs)\n\n    def inner_size(self) -> int:\n        return len(self.pairs[0]) if self.pairs else 0\n\n    def to_tuple(self) -> Tuple[Tuple[int, ...], ...]:\n        return tuple(p.to_tuple() for p in self.pairs)\n\n    def __iter__(self) -> Iterator[TuplePair]:\n        return iter(self.pairs)\n\nclass RunRecord:\n    def __init__(self, id: str, input_a: Tuple[Tuple[int,...], ...], input_b: Tuple[Tuple[int,...], ...], result: Tuple[Tuple[int,...], ...], timestamp: str) -> None:\n        self.id = id\n        self.input_a = input_a\n        self.input_b = input_b\n        self.result = result\n        self.timestamp = timestamp\n\nclass InMemoryRepository:\n    def __init__(self) -> None:\n        self._store: Dict[str, RunRecord] = {}\n\n    def save(self, run_record: RunRecord) -> str:\n        self._store[run_record.id] = run_record\n        return run_record.id\n\n    def get(self, run_id: str) -> Optional[RunRecord]:\n        return self._store.get(run_id)\n\n    def list_all(self) -> List[RunRecord]:\n        return list(self._store.values())\n\nclass Validator:\n    def validate_collections(self, a: TupleCollection, b: TupleCollection) -> None:\n        if a.length() != b.length():\n            raise ValidationError(\"Outer lengths do not match\")\n        if a.inner_size() != b.inner_size():\n            raise ValidationError(\"Inner tuple sizes do not match\")\n\nclass MaximizerService:\n    def __init__(self, repository: InMemoryRepository, validator: Validator) -> None:\n        self._repo = repository\n        self._validator = validator\n\n    def _max_pair(self, p1: TuplePair, p2: TuplePair) -> TuplePair:\n        return TuplePair(tuple(max(x, y) for x, y in zip(p1.to_tuple(), p2.to_tuple())))\n\n    def maximize(self, a: TupleCollection, b: TupleCollection) -> TupleCollection:\n        self._validator.validate_collections(a, b)\n        result_pairs = tuple(self._max_pair(pa, pb) for pa, pb in zip(a, b))\n        result = TupleCollection(result_pairs)\n        run = RunRecord(\n            id=str(uuid4()),\n            input_a=a.to_tuple(),\n            input_b=b.to_tuple(),\n            result=result.to_tuple(),\n            timestamp=datetime.utcnow().isoformat()\n        )\n        self._repo.save(run)\n        return result\n\nclass Converter:\n    def to_tuple_collection(self, raw: Any) -> TupleCollection:\n        if isinstance(raw, str):\n            try:\n                raw_eval = ast.literal_eval(raw)\n            except Exception as e:\n                raise ValidationError(f\"Cannot parse string input: {e}\")\n            raw = raw_eval\n        try:\n            pairs = tuple(TuplePair(tuple(inner)) for inner in raw)\n        except TypeError:\n            raise ValidationError(\"Input must be an iterable of iterables\")\n        return TupleCollection(pairs)\n\nclass APIController:\n    def __init__(self, service: MaximizerService, converter: Converter) -> None:\n        self._service = service\n        self._converter = converter\n\n    def maximize_elements_raw(self, a_raw: Any, b_raw: Any) -> Tuple[Tuple[int, ...], ...]:\n        a = self._converter.to_tuple_collection(a_raw)\n        b = self._converter.to_tuple_collection(b_raw)\n        result = self._service.maximize(a, b)\n        return result.to_tuple()\n\ndef maximize_elements(a: Any, b: Any) -> Tuple[Tuple[int, ...], ...]:\n    \"\"\"\n    Computes the element-wise maximum of two nested tuples of integers.\n    Inputs can be raw Python structures or their string representations.\n    \"\"\"\n    repository = InMemoryRepository()\n    validator = Validator()\n    service = MaximizerService(repository, validator)\n    converter = Converter()\n    controller = APIController(service, converter)\n    return controller.maximize_elements_raw(a, b)"}
{"task_id": "Mbpp/262", "solution": "def split_two_parts(items: list, L: int) -> tuple:\n    \"\"\"\n    Splits a list into two parts: the first part with length L, and the remaining part.\n    Returns the two parts as a tuple.\n    \"\"\"\n    first_part = items[:L]\n    second_part = items[L:]\n    return (first_part, second_part)"}
