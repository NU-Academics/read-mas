{"task_id": "Mbpp/737", "solution": "import re\n\nVOWEL_PATTERN: str = '^[aeiou]'\nIGNORECASE_FLAG: int = re.IGNORECASE\n\ndef normalize_input(s: str) -> str:\n    \"\"\"Strips leading whitespace from the string.\"\"\"\n    return s.lstrip()\n\nclass RegexAdapter:\n    \"\"\"Encapsulates regex pattern compilation and matching.\"\"\"\n    def __init__(self, pattern: str, flags: int = 0) -> None:\n        self.pattern: str = pattern\n        self.flags: int = flags\n        self._compiled: re.Pattern = re.compile(self.pattern, self.flags)\n\n    def matches(self, text: str) -> bool:\n        \"\"\"Checks if the compiled pattern matches the start of the text.\"\"\"\n        return bool(self._compiled.match(text))\n\nclass VowelService:\n    \"\"\"Provides business logic for checking if a string starts with a vowel.\"\"\"\n    def __init__(self, adapter: RegexAdapter) -> None:\n        self._adapter = adapter\n\n    def starts_with_vowel(self, s: str) -> bool:\n        \"\"\"Checks if the string starts with a vowel after normalization.\"\"\"\n        normalized = normalize_input(s)\n        if normalized == \"\":\n            return False\n        return self._adapter.matches(normalized)\n\ndef check_str(s: str) -> bool:\n    \"\"\"\n    Checks if the given string is starting with a vowel using regex.\n    Leading whitespace is ignored, and matching is case-insensitive.\n    \"\"\"\n    adapter = RegexAdapter(VOWEL_PATTERN, IGNORECASE_FLAG)\n    service = VowelService(adapter)\n    return service.starts_with_vowel(s)"}
{"task_id": "Mbpp/739", "solution": "import math\n\nclass MathUtils:\n    @staticmethod\n    def integer_sqrt(n: int) -> int:\n        return math.isqrt(n)\n\n    @staticmethod\n    def sqrt_ceil(n: int) -> int:\n        s = MathUtils.integer_sqrt(n)\n        return s if s * s == n else s + 1\n\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    This means finding the smallest k such that T_k >= 10^(n-1).\n    \"\"\"\n    threshold = 10 ** (n - 1)\n    D = 1 + 8 * threshold\n    s = MathUtils.sqrt_ceil(D)\n    k = max(1, (s - 1) // 2)\n    # The quadratic formula (k^2+k-2*threshold=0) gives k = (-1 + sqrt(1 + 8*threshold)) / 2.\n    # Since we need k*(k+1)/2 >= threshold, we take the ceiling of this formula.\n    # MathUtils.sqrt_ceil(D) effectively computes ceil(sqrt(1 + 8 * threshold)).\n    # We then ensure k is at least 1 and verify with an optional increment.\n    while k * (k + 1) // 2 < threshold:\n        k += 1\n    return k"}
