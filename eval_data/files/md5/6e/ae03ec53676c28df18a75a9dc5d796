{"task_id": "Mbpp/100", "solution": "def _int_to_digits(n: int) -> list[int]:\n    \"\"\"Converts a non-negative integer to a list of its digits.\"\"\"\n    if n == 0:\n        return [0]\n    digs = []\n    temp_n = n\n    while temp_n:\n        digs.append(temp_n % 10)\n        temp_n //= 10\n    return list(reversed(digs))\n\ndef _digits_to_int(digits: list[int]) -> int:\n    \"\"\"Converts a list of digits to an integer.\"\"\"\n    v = 0\n    for d in digits:\n        v = v * 10 + d\n    return v\n\ndef _is_all_nines(digits: list[int]) -> bool:\n    \"\"\"Checks if all digits in the list are 9.\"\"\"\n    return all(d == 9 for d in digits)\n\ndef _mirror_left_to_right(digits: list[int]) -> list[int]:\n    \"\"\"Mirrors the left half of the digits to the right half to form a palindrome.\"\"\"\n    n = len(digits)\n    res = digits[:]\n    for i in range(n // 2):\n        res[n - 1 - i] = res[i]\n    return res\n\ndef _increment_middle(digits: list[int]) -> list[int]:\n    \"\"\"Increments the middle digit(s) of a number represented by digits, handling carry.\"\"\"\n    n = len(digits)\n    res = digits[:]\n    mid_idx = (n - 1) // 2\n\n    i = mid_idx\n    carry = 1\n\n    # Increment from the middle (or rightmost of left half) and propagate carry left\n    while i >= 0 and carry:\n        new_digit = res[i] + carry\n        carry = new_digit // 10\n        res[i] = new_digit % 10\n        i -= 1\n    \n    return res\n\ndef next_smallest_palindrome(n: int) -> int:\n    digits = _int_to_digits(n)\n    num_digits = len(digits)\n\n    # If the number consists of all nines (e.g., 9, 99), the next palindrome is 10...01.\n    if _is_all_nines(digits):\n        return int(\"1\" + \"0\" * (num_digits - 1) + \"1\")\n\n    # Mirror the left half to the right half to form a candidate palindrome.\n    mirrored_digits = _mirror_left_to_right(digits)\n    mirrored_val = _digits_to_int(mirrored_digits)\n\n    # If the mirrored number is strictly greater than the input, it's the answer.\n    if mirrored_val > n:\n        return mirrored_val\n    else:\n        # If the mirrored number is not greater (i.e., less than or equal to) the input,\n        # increment the middle digit(s) and then mirror again.\n        incremented_left_half_digits = _increment_middle(digits)\n        final_palindrome_digits = _mirror_left_to_right(incremented_left_half_digits)\n        return _digits_to_int(final_palindrome_digits)"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Computes the Eulerian number a(n, m) using dynamic programming.\n    A(n, m) is the number of permutations of {1, ..., n} having m ascents.\n    \"\"\"\n    if n < 0 or m < 0:\n        return 0\n\n    if n == 0:\n        return 1 if m == 0 else 0\n\n    # dp_prev_row stores A(i-1, k) values.\n    # Initially, it represents A(0,0)=1 for i=1.\n    dp_prev_row = [1] \n\n    # Iterate for i from 1 to n (current 'n' value)\n    for i in range(1, n + 1):\n        # dp_current_row will store A(i, k) values.\n        # A(i, k) is defined for 0 <= k < i. So it needs `i` elements.\n        dp_current_row = [0] * i \n\n        # Iterate for j from 0 to i-1 (current 'm' value)\n        for j in range(i):\n            # Recurrence relation: A(i,j) = (i - j) * A(i-1, j-1) + (j + 1) * A(i-1, j)\n            \n            # Term for A(i-1, j-1)\n            term1 = (i - j) * (dp_prev_row[j - 1] if j - 1 >= 0 and j - 1 < len(dp_prev_row) else 0)\n            \n            # Term for A(i-1, j)\n            term2 = (j + 1) * (dp_prev_row[j] if j < len(dp_prev_row) else 0)\n            \n            dp_current_row[j] = term1 + term2\n        \n        dp_prev_row = dp_current_row\n\n    # After iterating up to n, dp_prev_row holds A(n, k) for k from 0 to n-1.\n    # Return A(n, m) if m is within valid bounds, otherwise 0.\n    if 0 <= m < len(dp_prev_row):\n        return dp_prev_row[m]\n    else:\n        return 0"}
