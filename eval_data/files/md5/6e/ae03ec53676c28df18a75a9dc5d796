{"task_id": "Mbpp/468", "solution": "from typing import Sequence, Union\n\ndef max_product(arr: Sequence[Union[float, int]]) -> Union[float, int]:\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence of the array.\n    Uses dynamic programming to track maximum and minimum products ending at each position.\n    \"\"\"\n    n = len(arr)\n    \n    # Assuming input 'arr' is non-empty as per design preconditions.\n    # If 'arr' is empty, accessing arr[0] would raise an IndexError.\n\n    # max_end[i] stores the maximum product of an increasing subsequence ending at index i.\n    # min_end[i] stores the minimum product of an increasing subsequence ending at index i.\n    # These are crucial for correctly handling negative numbers which can become large positives when multiplied.\n    max_end = list(arr)\n    min_end = list(arr)\n    \n    # Initialize global maximum product with the first element.\n    # This handles cases where the maximum product is a single element.\n    global_max = arr[0]\n\n    for i in range(n):\n        # Iterate over previous elements to find valid increasing subsequences\n        for j in range(i):\n            if arr[j] < arr[i]:\n                # If arr[j] is strictly smaller than arr[i], we can potentially extend\n                # an increasing subsequence ending at j by appending arr[i].\n                \n                # Candidates for the maximum product of an increasing subsequence ending at i:\n                # 1. The current max_end[i] (which could be arr[i] itself, or a product from an earlier j).\n                # 2. The product of arr[i] with the maximum product ending at j (arr[i] * max_end[j]).\n                # 3. The product of arr[i] with the minimum product ending at j (arr[i] * min_end[j]),\n                #    important if arr[i] or min_end[j] are negative, potentially yielding a large positive.\n                \n                max_end[i] = max(max_end[i], arr[i] * max_end[j], arr[i] * min_end[j])\n                \n                # Similarly, update min_end[i] to track the minimum product,\n                # which can be useful if a subsequent element is negative.\n                min_end[i] = min(min_end[i], arr[i] * max_end[j], arr[i] * min_end[j])\n                \n        # Update the overall maximum product found across all subsequences ending at any index.\n        global_max = max(global_max, max_end[i])\n            \n    return global_max"}
{"task_id": "Mbpp/473", "solution": "import collections\nfrom typing import Sequence, Tuple, Set\n\ndef tuple_intersection(a: Sequence[Tuple[int,int]], b: Sequence[Tuple[int,int]]) -> Set[Tuple[int,int]]:\n    \"\"\"\n    Finds the intersection of elements in two lists of 2-item tuples,\n    treating tuples as unordered pairs (e.g., (3,4) == (4,3)).\n    \"\"\"\n    \n    def _canonicalize_tuple(pair: Tuple[int, int]) -> Tuple[int, int]:\n        \"\"\"Returns a canonical representation of a 2-item tuple (min, max).\"\"\"\n        return (min(pair), max(pair))\n\n    canonical_set_a = {_canonicalize_tuple(t) for t in a}\n    canonical_set_b = {_canonicalize_tuple(t) for t in b}\n\n    return canonical_set_a.intersection(canonical_set_b)"}
{"task_id": "Mbpp/475", "solution": "def sort_counter(mapping, descending=True, limit=None):\n    \"\"\"\n    Sorts a dictionary by its values, with keys as a tie-breaker.\n    Returns a list of (key, value) tuples.\n    \"\"\"\n    items = list(mapping.items())\n    \n    if descending:\n        # Sort by value descending, then key ascending (for tie-breaking)\n        # Use negative value for numeric types to achieve descending sort while keeping key ascending\n        # Handle cases where values might not be directly numeric (though design implies they are)\n        items_sorted = sorted(items, key=lambda kv: (-kv[1], kv[0]) if isinstance(kv[1], (int, float)) else (str(kv[1]), kv[0]), reverse=True)\n    else:\n        # Sort by value ascending, then key ascending (for tie-breaking)\n        items_sorted = sorted(items, key=lambda kv: (kv[1], kv[0]))\n\n    if limit is not None and limit >= 0:\n        return items_sorted[:limit]\n    return items_sorted"}
{"task_id": "Mbpp/476", "solution": "from typing import Sequence, Any, List, Iterator\n\nclass BigSumError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\ndef parse_number(token: str) -> float | int:\n    try:\n        return int(token)\n    except ValueError:\n        return float(token)\n\nclass ValueArray:\n    def __init__(self, sequence: Sequence[float | int]) -> None:\n        self.sequence = sequence\n\n    def __iter__(self) -> Iterator[float | int]:\n        return iter(self.sequence)\n\n    def __len__(self) -> int:\n        return len(self.sequence)\n\n    def to_list(self) -> List[float | int]:\n        return list(self.sequence)\n\nclass InputValidator:\n    @staticmethod\n    def validate_sequence(seq: Sequence[Any]) -> List[float | int]:\n        if seq is None or len(seq) == 0:\n            raise BigSumError(\"sequence must be non-empty\")\n        nums = []\n        for x in seq:\n            if isinstance(x, (int, float)):\n                nums.append(x)\n            else:\n                raise BigSumError(f\"non-numeric element: {x!r}\")\n        return nums\n\n    @staticmethod\n    def parse_cli_args(args: List[str]) -> List[float | int]:\n        nums = []\n        for t in args:\n            try:\n                nums.append(parse_number(t))\n            except ValueError as e:\n                raise BigSumError(f\"invalid number token: {t!r}\") from e\n        return nums\n\nclass BigSumService:\n    def compute(self, array: ValueArray) -> float | int:\n        if len(array) == 0:\n            raise BigSumError(\"cannot compute on empty sequence\")\n        it = iter(array)\n        try:\n            first = next(it)\n        except StopIteration:\n            raise BigSumError(\"cannot compute on empty sequence\")\n        min_v = max_v = first\n        for v in it:\n            if v < min_v:\n                min_v = v\n            if v > max_v:\n                max_v = v\n        return min_v + max_v\n\ndef big_sum(seq: Sequence[float | int]) -> float | int:\n    validated = InputValidator.validate_sequence(seq)\n    arr = ValueArray(validated)\n    return BigSumService().compute(arr)"}
