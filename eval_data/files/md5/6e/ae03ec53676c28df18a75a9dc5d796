{"task_id": "Mbpp/232", "solution": "import heapq\n\ndef larg_nnum(lst, n):\n    \"\"\"\n    Returns a list containing the n largest unique items from the input list.\n    \"\"\"\n    if n == 0:\n        return []\n    \n    unique_elements = set(lst)\n    return heapq.nlargest(n, list(unique_elements))"}
{"task_id": "Mbpp/233", "solution": "import math\n\nclass GeometryError(Exception):\n    \"\"\"Domain exception for geometry validation and computation errors.\"\"\"\n    pass\n\nclass Validator:\n    def validate_positive_number(self, value: float, name: str) -> None:\n        if not isinstance(value, (int, float)):\n            raise GeometryError(f\"{name} must be a number\")\n        if math.isnan(value) or math.isinf(value):\n            raise GeometryError(f\"{name} must be finite\")\n        if value < 0:\n            raise GeometryError(f\"{name} must be non-negative\")\n\nclass Cylinder:\n    def __init__(self, height: float, radius: float) -> None:\n        Validator().validate_positive_number(height, \"height\")\n        Validator().validate_positive_number(radius, \"radius\")\n        self._height = float(height)\n        self._radius = float(radius)\n\n    def height(self) -> float:\n        return self._height\n\n    def radius(self) -> float:\n        return self._radius\n\nclass GeometryService:\n    def lateral_surface_area(self, cylinder: Cylinder) -> float:\n        if not isinstance(cylinder, Cylinder):\n            raise GeometryError(\"Expected Cylinder instance\")\n        r = cylinder.radius()\n        h = cylinder.height()\n        return 2.0 * math.pi * r * h\n\nclass LateralAreaAPI:\n    def __init__(self, service: GeometryService = None, validator: Validator = None):\n        self.service = service or GeometryService()\n        self.validator = validator or Validator()\n\n    def lateralsuface_cylinder(self, height: float, radius: float) -> float:\n        self.validator.validate_positive_number(height, \"height\")\n        self.validator.validate_positive_number(radius, \"radius\")\n        cyl = Cylinder(height=height, radius=radius)\n        return self.service.lateral_surface_area(cyl)\n\n_api = LateralAreaAPI()\n\ndef lateralsuface_cylinder(height: float, radius: float) -> float:\n    return _api.lateralsuface_cylinder(height, radius)"}
{"task_id": "Mbpp/234", "solution": "from typing import Any, Dict\n\nclass CubeError(Exception):\n    pass\n\nclass CubeValidationError(CubeError):\n    pass\n\nclass InvalidSideLengthError(CubeValidationError):\n    pass\n\nclass Cube:\n    def __init__(self, side_length: float) -> None:\n        self.side_length: float = side_length\n\n    def volume(self) -> float:\n        return self.side_length ** 3\n\n    def to_dict(self) -> Dict[str, float]:\n        return {\"side\": float(self.side_length), \"volume\": float(self.volume())}\n\nclass InputValidator:\n    @staticmethod\n    def is_number(value: Any) -> bool:\n        try:\n            float(value)\n            return True\n        except (TypeError, ValueError):\n            return False\n\n    @staticmethod\n    def parse_float(value: Any) -> float:\n        try:\n            return float(value)\n        except (TypeError, ValueError) as e:\n            raise CubeValidationError(\"Value is not a number\") from e\n\n    @staticmethod\n    def validate_side_length(value: Any) -> float:\n        val = InputValidator.parse_float(value)\n        if val < 0:\n            raise InvalidSideLengthError(\"Side length must be non-negative\")\n        return val\n\nclass CubeService:\n    def __init__(self, validator: InputValidator = InputValidator()) -> None:\n        self._validator = validator\n\n    def create_cube(self, side_length: float) -> Cube:\n        side = self._validator.validate_side_length(side_length)\n        return Cube(side)\n\n    def compute_volume(self, side_length: float) -> float:\n        cube = self.create_cube(side_length)\n        return cube.volume()\n\nclass CubeController:\n    def __init__(self, service: CubeService) -> None:\n        self._service = service\n\n    def compute_volume(self, side_length: float) -> float:\n        return self._service.compute_volume(side_length)\n\n_default_controller = CubeController(CubeService(InputValidator()))\n\ndef volume_cube(side_length: float) -> float:\n    \"\"\"\n    Computes the volume of a cube given its side length.\n    \"\"\"\n    return _default_controller.compute_volume(side_length)"}
{"task_id": "Mbpp/235", "solution": "import math\n\n\ndef even_bit_set_number(n):\n    \"\"\"\n    Sets all 1-based even bit positions in the given non-negative integer n.\n    For example, for n=10 (binary 1010), bit at position 2 (0-indexed 1) and 4 (0-indexed 3) are already set.\n    \"\"\"\n    # Calculate the maximum bit length needed for the number n.\n    # If n is 0, bit_length() is 0, so we use max(1, ...) to ensure a minimum width for the mask.\n    # The default width in the design context is 64, but using n.bit_length() is more efficient\n    # as it only generates a mask as wide as needed for n. If n=0, width becomes 1.\n    width = max(1, n.bit_length())\n\n    mask = 0\n    # Iterate through bit positions (0-indexed) up to the determined width.\n    # We are interested in 1-based even positions, which correspond to 0-indexed odd positions.\n    for i in range(width):\n        # Check if the 1-based position (i + 1) is even.\n        if (i + 1) % 2 == 0:\n            # If it's an even 1-based position, set the corresponding bit in the mask.\n            mask |= (1 << i)\n\n    # Apply the generated mask to n using a bitwise OR operation.\n    return n | mask"}
{"task_id": "Mbpp/237", "solution": "from typing import List, Tuple, Dict, Any\n\ndef check_occurences(list_of_tuples: List[Tuple[Any, Any]]) -> Dict[Tuple[Any, Any], int]:\n    \"\"\"\n    Counts occurrences of unique unordered 2-item tuples in a list, returning a dictionary.\n    Each tuple is normalized to a canonical (min, max) form before counting.\n    \"\"\"\n    counts: Dict[Tuple[Any, Any], int] = {}\n    for pair in list_of_tuples:\n        # Normalize the pair to a canonical order (min, max) by sorting its elements.\n        normalized_pair = tuple(sorted(pair))\n        counts[normalized_pair] = counts.get(normalized_pair, 0) + 1\n    return counts"}
