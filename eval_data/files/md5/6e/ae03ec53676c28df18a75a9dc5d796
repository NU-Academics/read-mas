{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(lists):\n    \"\"\"\n    Finds elements common to all sublists using set intersections.\n    Assumes valid input: a list of lists containing hashable elements.\n    \"\"\"\n    if not lists:\n        return []\n\n    common_elements = set(lists[0])\n\n    for sublist in lists[1:]:\n        common_elements.intersection_update(sublist)\n        if not common_elements:  # Optimization: if no common elements, stop early\n            break\n\n    return list(common_elements)"}
{"task_id": "Mbpp/108", "solution": "import json\nimport os\nimport tempfile\nfrom datetime import datetime\nfrom typing import List, Iterable, Sequence, Callable, Tuple, Optional, TypeVar\nimport time\nimport uuid\n\n# Define a TypeVar for the timeit_ms function\nT = TypeVar('T')\n\n# --- Custom Exceptions ---\nclass InvalidInputError(Exception):\n    \"\"\"Raised when an input list is invalid (e.g., None, not iterable).\"\"\"\n    pass\n\nclass ElementTypeError(Exception):\n    \"\"\"Raised when elements in lists are not mutually comparable.\"\"\"\n    pass\n\nclass RepositoryError(Exception):\n    \"\"\"Raised for errors related to the persistence repository.\"\"\"\n    pass\n\n# --- Utils ---\ndef timeit_ms(fn: Callable[..., T], *args, **kwargs) -> Tuple[T, float]:\n    \"\"\"\n    Measures the execution time of a function in milliseconds.\n    Returns a tuple of (function_result, duration_in_ms).\n    \"\"\"\n    start_time = time.perf_counter()\n    result = fn(*args, **kwargs)\n    end_time = time.perf_counter()\n    duration_ms = (end_time - start_time) * 1000\n    return result, duration_ms\n\ndef generate_id() -> str:\n    \"\"\"Generates a UUID4 hex string.\"\"\"\n    return uuid.uuid4().hex\n\n# --- Models (DTOs) ---\nclass MergeRequest:\n    \"\"\"DTO for merge request inputs.\"\"\"\n    def __init__(self, inputs: List[Iterable]):\n        # Convert iterables to lists for consistent handling within the DTO\n        self.inputs = [list(i) for i in inputs]\n\n    def to_dict(self) -> dict:\n        return {\"inputs\": self.inputs}\n\nclass MergeResult:\n    \"\"\"DTO for merge result and metadata.\"\"\"\n    def __init__(self, sorted_data: List[object], duration_ms: float, count: int,\n                 id: str, timestamp: str, input_counts: List[int]):\n        self.sorted_data = sorted_data\n        self.duration_ms = duration_ms\n        self.count = count\n        self.id = id\n        self.timestamp = timestamp\n        self.input_counts = input_counts\n\n    def to_dict(self) -> dict:\n        # Sample first 100 elements for persistence, as per design notes\n        sample_size = 100\n        return {\n            \"id\": self.id,\n            \"timestamp\": self.timestamp,\n            \"input_counts\": self.input_counts,\n            \"count\": self.count,\n            \"duration_ms\": self.duration_ms,\n            \"sample\": self.sorted_data[:sample_size],\n            \"full_saved\": len(self.sorted_data) <= sample_size\n        }\n\n# --- Validators ---\nclass ListValidator:\n    \"\"\"Validates inputs for merge operation.\"\"\"\n    MAX_SAMPLE_CHECK = 5\n\n    def validate_lists(self, list1: Iterable, list2: Iterable, list3: Iterable) -> None:\n        \"\"\"\n        Ensures inputs are iterable and elements are mutually comparable.\n        Raises InvalidInputError or ElementTypeError on failure.\n        \"\"\"\n        input_list_iterables = [list1, list2, list3]\n        processed_lists = [] # To store lists converted from iterables for sampling\n\n        for i, lst_iterable in enumerate(input_list_iterables):\n            if lst_iterable is None:\n                raise InvalidInputError(f\"Input list {i+1} cannot be None.\")\n            if not isinstance(lst_iterable, Iterable):\n                raise InvalidInputError(f\"Input list {i+1} must be an iterable.\")\n            \n            # Convert to list for consistent length/indexing for sampling\n            processed_lists.append(list(lst_iterable))\n\n        # Sample elements for type comparability check\n        all_samples = []\n        for lst in processed_lists:\n            # Take up to MAX_SAMPLE_CHECK elements, skip if list is empty\n            all_samples.extend(lst[:min(len(lst), self.MAX_SAMPLE_CHECK)])\n\n        if not all_samples:\n            return # If all lists are empty, types are implicitly comparable.\n\n        # Check for type consistency (numeric vs non-numeric)\n        # The design explicitly disallows mixing numbers with non-numbers (e.g., strings).\n        first_type_is_numeric = isinstance(all_samples[0], (int, float))\n        for item in all_samples:\n            current_type_is_numeric = isinstance(item, (int, float))\n            if first_type_is_numeric != current_type_is_numeric:\n                raise ElementTypeError(\"Cannot merge lists with mixed numeric and non-numeric elements.\")\n\n# --- Sorter ---\nclass Sorter:\n    \"\"\"Provides stable sorting and pre-sort checks.\"\"\"\n    def is_sorted(self, seq: Sequence[object]) -> bool:\n        \"\"\"\n        Checks if a sequence is already sorted in ascending order.\n        Assumes elements are comparable.\n        \"\"\"\n        return all(seq[i] <= seq[i + 1] for i in range(len(seq) - 1))\n\n    def ensure_sorted(self, seq: Sequence[object]) -> List[object]:\n        \"\"\"\n        Returns a sorted version of the sequence. If already sorted,\n        returns a new list (does not mutate original).\n        \"\"\"\n        if self.is_sorted(seq):\n            return list(seq) # Return a new list to avoid mutating original\n        return sorted(seq)\n\n# --- Repository ---\nclass MergeRepository:\n    \"\"\"Handles JSON file persistence of merge records.\"\"\"\n    DEFAULT_DB_PATH = \"merge_history.json\"\n\n    def __init__(self, path: str = DEFAULT_DB_PATH):\n        self._path = path\n\n    def save(self, result: MergeResult) -> None:\n        \"\"\"Appends result.to_dict() to JSON list stored at path with atomic write.\"\"\"\n        records = []\n        if os.path.exists(self._path):\n            try:\n                with open(self._path, 'r', encoding='utf-8') as f:\n                    content = f.read()\n                    if content: # Only attempt to load if file is not empty\n                        records = json.loads(content)\n                if not isinstance(records, list):\n                    records = [] # Reset if file content is not a list\n            except json.JSONDecodeError:\n                records = [] # If file is corrupted or not valid JSON, start fresh\n            except Exception as e:\n                raise RepositoryError(f\"Failed to read existing merge history from {self._path}: {e}\") from e\n\n        records.append(result.to_dict())\n\n        # Atomic write using tempfile and os.replace\n        temp_path = None\n        try:\n            temp_dir = os.path.dirname(self._path) or '.' # Use '.' if no directory specified\n            # Ensure the directory exists for tempfile.mkstemp\n            os.makedirs(temp_dir, exist_ok=True)\n            \n            fd, temp_path = tempfile.mkstemp(dir=temp_dir, suffix=\".tmp\")\n            with os.fdopen(fd, 'w', encoding='utf-8') as tmp_f:\n                json.dump(records, tmp_f, indent=2)\n            os.replace(temp_path, self._path) # Atomically replaces the old file with the new one\n        except Exception as e:\n            if temp_path and os.path.exists(temp_path):\n                os.remove(temp_path) # Clean up temp file on error\n            raise RepositoryError(f\"Failed to save merge history to {self._path}: {e}\") from e\n\n    def load_all(self) -> List[dict]:\n        \"\"\"Loads all persisted records; returns [] if file missing or corrupted.\"\"\"\n        if not os.path.exists(self._path):\n            return []\n        try:\n            with open(self._path, 'r', encoding='utf-8') as f:\n                content = f.read()\n                if not content:\n                    return [] # Return empty if file is empty\n                records = json.loads(content)\n                if not isinstance(records, list):\n                    return [] # Return empty if file content is not a list\n                return records\n        except json.JSONDecodeError:\n            return [] # Return empty if file is corrupted\n        except Exception as e:\n            raise RepositoryError(f\"Failed to load merge history from {self._path}: {e}\") from e\n\n\n# --- Services ---\nclass MergeService:\n    \"\"\"\n    Orchestrates validation, sorting, merging, metadata collection,\n    and optional persistence.\n    \"\"\"\n    def __init__(self, repo: Optional[MergeRepository] = None,\n                 validator: Optional[ListValidator] = None,\n                 sorter: Optional[Sorter] = None):\n        self._repo = repo\n        self._validator = validator if validator is not None else ListValidator()\n        self._sorter = sorter if sorter is not None else Sorter()\n\n    def merge_and_record(self, list1: Iterable, list2: Iterable, list3: Iterable, persist: bool = False) -> MergeResult:\n        \"\"\"\n        Validates inputs, sorts each, merges, collects metadata,\n        and optionally persists the result.\n        \"\"\"\n        self._validator.validate_lists(list1, list2, list3)\n\n        # Ensure all inputs are converted to lists for consistent handling\n        l1_list = list(list1)\n        l2_list = list(list2)\n        l3_list = list(list3)\n\n        sorted_l1 = self._sorter.ensure_sorted(l1_list)\n        sorted_l2 = self._sorter.ensure_sorted(l2_list)\n        sorted_l3 = self._sorter.ensure_sorted(l3_list)\n\n        merge_fn = lambda a, b, c: self._merge_three_sorted(a, b, c)\n        final_sorted_list, duration = timeit_ms(merge_fn, sorted_l1, sorted_l2, sorted_l3)\n\n        result = MergeResult(\n            sorted_data=final_sorted_list,\n            duration_ms=duration,\n            count=len(final_sorted_list),\n            id=generate_id(),\n            timestamp=datetime.now().isoformat(),\n            input_counts=[len(l1_list), len(l2_list), len(l3_list)]\n        )\n\n        if persist:\n            if self._repo is None:\n                raise RepositoryError(\"Persistence requested but no MergeRepository configured for MergeService.\")\n            self._repo.save(result)\n\n        return result\n\n    def _merge_three_sorted(self, a: List[object], b: List[object], c: List[object]) -> List[object]:\n        \"\"\"\n        Performs a linear-time merge of three already sorted lists.\n        Handles comparable types (int, float, etc.).\n        \"\"\"\n        i = j = k = 0\n        out = []\n        while i < len(a) or j < len(b) or k < len(c):\n            candidates = []\n            if i < len(a): candidates.append((a[i], 'a'))\n            if j < len(b): candidates.append((b[j], 'b'))\n            if k < len(c): candidates.append((c[k], 'c'))\n\n            if not candidates:\n                break # All lists are exhausted\n\n            try:\n                val, which = min(candidates, key=lambda x: x[0])\n            except TypeError:\n                # If validation somehow missed non-comparable types, catch it here\n                raise ElementTypeError(\"Elements across lists are not mutually comparable during merge operation.\")\n\n            if which == 'a':\n                out.append(val)\n                i += 1\n            elif which == 'b':\n                out.append(val)\n                j += 1\n            else: # which == 'c'\n                out.append(val)\n                k += 1\n        return out\n\n# --- Controller ---\nclass MergeController:\n    \"\"\"Public API and convenience functions for merging lists.\"\"\"\n    def __init__(self, service: MergeService):\n        self.service = service\n\n    def merge_sorted_list(self, list1: Iterable, list2: Iterable, list3: Iterable, persist: bool = False) -> List[object]:\n        \"\"\"\n        Merges three lists into a single sorted list.\n        Performs validation, sorting, and merging, returning the sorted data.\n        \"\"\"\n        result = self.service.merge_and_record(list1, list2, list3, persist=persist)\n        return result.sorted_data\n\n# --- Top-level function and default service instance ---\n# Instantiate default dependencies for the convenience function.\n# As per the design snippet, _default_service is configured with repo=None,\n# meaning persistence will raise an error if requested.\n_default_validator = ListValidator()\n_default_sorter = Sorter()\n_default_service = MergeService(repo=None, validator=_default_validator, sorter=_default_sorter)\n_default_controller = MergeController(_default_service)\n\n\ndef merge_sorted_list(list1: Iterable, list2: Iterable, list3: Iterable, persist: bool = False) -> List[object]:\n    \"\"\"\n    Merges three lists into a single sorted list.\n    \"\"\"\n    return _default_controller.merge_sorted_list(list1, list2, list3, persist=persist)"}
{"task_id": "Mbpp/113", "solution": "import re\nimport os\nimport json\nfrom datetime import datetime\nfrom pathlib import Path\n\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input types or formats.\"\"\"\n    pass\n\nclass PersistenceError(IOError):\n    \"\"\"Exception raised for issues during log persistence.\"\"\"\n    pass\n\ndef normalize_path(path: str | None) -> str:\n    \"\"\"Expands user path and returns absolute path.\"\"\"\n    if path is None:\n        return \"\"\n    return os.path.abspath(os.path.expanduser(path))\n\ndef default_log_path() -> str:\n    \"\"\"Returns the default log file path.\"\"\"\n    return str(Path.home() / \".intchecker\" / \"log.jsonl\")\n\nclass IntegerChecker:\n    \"\"\"Performs core logic to check if a string is an integer.\"\"\"\n    INT_REGEX: str = r'^[+-]?[0-9]+$'\n\n    def is_integer(self, value: str) -> bool:\n        \"\"\"Returns True if the value matches the integer pattern.\"\"\"\n        if not isinstance(value, str):\n            raise InvalidInputError(\"value must be a string\")\n        return bool(re.match(self.INT_REGEX, value))\n\nclass InputRepository:\n    \"\"\"Handles append-only JSONL logging for checks.\"\"\"\n    DEFAULT_LOG_PATH: str = default_log_path()\n\n    def __init__(self, log_path: str | None = None) -> None:\n        \"\"\"Initializes the repository with a log path.\"\"\"\n        self._log_path = normalize_path(log_path if log_path is not None else self.DEFAULT_LOG_PATH)\n        self._ensure_dir_exists()\n\n    def _ensure_dir_exists(self) -> None:\n        \"\"\"Ensures the directory for the log file exists.\"\"\"\n        log_dir = os.path.dirname(self._log_path)\n        if log_dir and not os.path.exists(log_dir):\n            try:\n                os.makedirs(log_dir, mode=0o700, exist_ok=True)\n            except OSError as e:\n                raise PersistenceError(f\"Failed to create log directory {log_dir}: {e}\") from e\n\n    def append_log(self, timestamp: str, input_value: str, result: bool) -> None:\n        \"\"\"Appends a log entry to the JSONL file.\"\"\"\n        log_entry = {\n            \"timestamp\": timestamp,\n            \"input\": input_value,\n            \"result\": result,\n            \"source\": \"api\"\n        }\n        try:\n            with open(self._log_path, 'a', encoding='utf-8') as f:\n                f.write(json.dumps(log_entry) + '\\n')\n        except IOError as e:\n            raise PersistenceError(f\"Failed to write to log file {self._log_path}: {e}\") from e\n\nclass CheckerService:\n    \"\"\"Orchestrates validation and persistence.\"\"\"\n    def __init__(self, repo: InputRepository, checker: IntegerChecker) -> None:\n        \"\"\"Initializes the service with repository and checker instances.\"\"\"\n        self._repo = repo\n        self._checker = checker\n\n    def is_integer(self, value: str) -> bool:\n        \"\"\"Validates input, calls checker, and logs the result.\"\"\"\n        try:\n            result = self._checker.is_integer(value)\n        except InvalidInputError:\n            raise\n\n        ts = datetime.utcnow().isoformat(timespec='milliseconds') + 'Z'\n        try:\n            self._repo.append_log(ts, value, result)\n        except PersistenceError as e:\n            # As per design, logging errors are non-fatal by default.\n            import sys\n            print(f\"Warning: Failed to log check result: {e}\", file=sys.stderr)\n            pass \n        return result\n\nclass CheckerController:\n    \"\"\"Public API wrapper for library users and CLI.\"\"\"\n    def __init__(self, service: CheckerService) -> None:\n        \"\"\"Initializes the controller with a service instance.\"\"\"\n        self._service = service\n\n    def check(self, value: str) -> bool:\n        \"\"\"Validates input type and delegates to the service.\"\"\"\n        return self._service.is_integer(value)\n\ndef check_integer(s: str) -> bool:\n    \"\"\"\n    Checks if a string represents an integer.\n    \"\"\"\n    repo = InputRepository(log_path=default_log_path())\n    service = CheckerService(repo=repo, checker=IntegerChecker())\n    controller = CheckerController(service=service)\n    return controller.check(s)"}
{"task_id": "Mbpp/116", "solution": "import math\nfrom typing import Tuple\n\ndef tuple_to_int(values: Tuple[int, ...]) -> int:\n    \"\"\"Converts a tuple of positive integers into a single integer by concatenation.\"\"\"\n    result = 0\n    for n in values:\n        # Calculate the number of digits in 'n'\n        # Assumes n is a positive integer based on problem description.\n        digits = int(math.floor(math.log10(n))) + 1\n        result = result * (10 ** digits) + n\n    return result"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_str: str, rotations: int) -> int:\n    \"\"\"\n    Finds the number of numbers with an odd value when rotating a binary string\n    the given number of times. It optimizes by detecting cycle length and\n    checking oddness via index arithmetic.\n    \"\"\"\n\n    def _get_last_char_of_rotated_string(s: str, k: int, n: int) -> str:\n        \"\"\"Returns the last character of s rotated left by k positions.\"\"\"\n        # The character at index `(k + n - 1) % n` in the original string\n        # will be the last character of the string rotated left by `k`.\n        return s[(k + n - 1) % n]\n\n    def _is_odd_rotated(s: str, k: int, n: int) -> bool:\n        \"\"\"Checks if s rotated left by k positions would be odd.\"\"\"\n        return _get_last_char_of_rotated_string(s, k, n) == '1'\n\n    def _compute_cycle_length(s: str) -> int:\n        \"\"\"Computes the minimal cycle length of a string.\"\"\"\n        n = len(s)\n        if n == 0:\n            return 0\n        # The smallest period of string s is found by searching for s\n        # within s+s, starting from index 1. The found index is the cycle length.\n        return (s + s).find(s, 1)\n\n    n = len(binary_str)\n\n    # Handle edge cases as per design context, without raising exceptions\n    if n == 0:\n        return 0\n    if rotations == 0:\n        return 0\n\n    cycle_length = _compute_cycle_length(binary_str)\n\n    # Count odd numbers in one full cycle\n    odd_in_cycle = 0\n    for k_in_cycle in range(cycle_length):\n        if _is_odd_rotated(binary_str, k_in_cycle, n):\n            odd_in_cycle += 1\n\n    # Calculate total odd count based on full cycles and remaining rotations\n    full_cycles_count = rotations // cycle_length\n    remainder_rotations = rotations % cycle_length\n\n    total_odd_count = full_cycles_count * odd_in_cycle\n\n    for k_remainder in range(remainder_rotations):\n        if _is_odd_rotated(binary_str, k_remainder, n):\n            total_odd_count += 1\n\n    return total_odd_count"}
{"task_id": "Mbpp/119", "solution": "def search(nums):\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear twice.\n    \"\"\"\n    left, right = 0, len(nums) - 1\n\n    while left < right:\n        mid = left + (right - left) // 2\n        # If mid is even, check numbers[mid] and numbers[mid + 1]\n        # If mid is odd, check numbers[mid] and numbers[mid - 1]\n        # This parity check ensures we compare the mid element with its pair.\n        if mid % 2 == 0:\n            if nums[mid] == nums[mid + 1]:\n                # Pair found, unique element is to the right\n                left = mid + 2\n            else:\n                # Unique element is at mid or to its left\n                right = mid\n        else: # mid is odd\n            if nums[mid] == nums[mid - 1]:\n                # Pair found, unique element is to the right\n                left = mid + 1\n            else:\n                # Unique element is at mid or to its left\n                right = mid - 1\n    \n    return nums[left]"}
