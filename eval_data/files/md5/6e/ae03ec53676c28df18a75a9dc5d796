{"task_id": "Mbpp/749", "solution": "import re\n\nclass ParseError(ValueError):\n    \"\"\"Exception raised when a string cannot be parsed as a valid integer.\"\"\"\n    pass\n\nclass ValidationError(ValueError):\n    \"\"\"Exception raised for invalid input types or structures for lists.\"\"\"\n    pass\n\nINT_RE = re.compile(r'^[+-]?\\d+$')\n\ndef normalize_string(s: str) -> str:\n    \"\"\"Trims leading/trailing whitespace from a string.\"\"\"\n    return s.strip()\n\ndef is_integer_string(s: str) -> bool:\n    \"\"\"Checks if a string matches the pattern for an integer (optional sign, digits only).\"\"\"\n    return bool(INT_RE.match(s))\n\nclass NumericParser:\n    \"\"\"Handles the conversion of numeric strings to integers.\"\"\"\n    def parse_one(self, s: str) -> int:\n        \"\"\"Parses a single string into an integer, applying normalization and validation.\"\"\"\n        norm = normalize_string(s)\n        if not is_integer_string(norm):\n            raise ParseError(f\"Invalid integer string: {s!r}\")\n        return int(norm)\n\n    def parse_to_ints(self, strings: list) -> list:\n        \"\"\"Converts a list of numeric strings to a list of integers, failing fast on invalid input.\"\"\"\n        return [self.parse_one(s) for s in strings]\n\nclass NumericStringList:\n    \"\"\"A data transfer object (DTO) for handling lists of strings with basic validation.\"\"\"\n    def __init__(self, strings: list) -> None:\n        self.strings = strings\n\n    def validate(self) -> None:\n        \"\"\"Ensures the stored input is a list of strings, raising ValidationError otherwise.\"\"\"\n        if not isinstance(self.strings, list):\n            raise ValidationError(\"Input must be a list of strings.\")\n        for i, s in enumerate(self.strings):\n            if not isinstance(s, str):\n                raise ValidationError(f\"Element at index {i} is not a string: {s!r}\")\n\nclass NumericSorterService:\n    \"\"\"Orchestrates the parsing and numeric sorting of string lists.\"\"\"\n    def __init__(self, parser: NumericParser = None):\n        self._parser = parser or NumericParser()\n\n    def sort(self, strings: list) -> list:\n        \"\"\"Parses the given strings into integers and then sorts them numerically.\"\"\"\n        values = self._parser.parse_to_ints(strings)\n        values.sort()\n        return values\n\nclass SortController:\n    \"\"\"Provides the public API for sorting numeric strings, integrating validation and service logic.\"\"\"\n    def __init__(self, service: NumericSorterService = None):\n        self._service = service or NumericSorterService()\n\n    def sort_numeric_strings(self, strings: list) -> list:\n        \"\"\"Validates the input list of strings and then uses the service to sort them numerically.\"\"\"\n        dto = NumericStringList(strings)\n        dto.validate()\n        return self._service.sort(dto.strings)\n\n_controller = SortController()\n\ndef sort_numeric_strings(strings: list) -> list:\n    \"\"\"\n    Sorts a given list of strings of numbers numerically, converting them to integers.\n    Raises ParseError for invalid numeric string formats or ValidationError for incorrect input list types.\n    \"\"\"\n    return _controller.sort_numeric_strings(strings)"}
{"task_id": "Mbpp/751", "solution": "from typing import Sequence, TypeVar\n\nT = TypeVar(\"T\")\n\ndef check_min_heap(arr: Sequence[T]) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap using 0-based indexing.\n    An empty array or a single-element array is considered a valid min-heap.\n    \"\"\"\n    n = len(arr)\n\n    if n <= 1:\n        return True\n\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        if left_child_idx < n:\n            if not (arr[i] <= arr[left_child_idx]):\n                return False\n\n        if right_child_idx < n:\n            if not (arr[i] <= arr[right_child_idx]):\n                return False\n\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number iteratively.\n    The sequence is defined by J(0)=0, J(1)=1, J(n)=J(n-1)+2*J(n-2) for n>=2.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    a, b = 0, 1\n    for _ in range(2, n + 1):\n        a, b = b, a + 2 * b\n    return b"}
{"task_id": "Mbpp/753", "solution": "import heapq\n\ndef min_k(records, k):\n    \"\"\"\n    Finds the minimum k records from a list of (key, numeric_value) tuples.\n    Returns the k tuples with the smallest numeric values, stable for equal values.\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Decorate records with their numeric value (as float) and original index for stable sorting.\n    # The decorated item is (value, index, original_tuple_with_float_value).\n    decorated_records = []\n    for i, (key, value) in enumerate(records):\n        decorated_records.append((float(value), i, (key, float(value))))\n\n    # Use heapq.nsmallest to efficiently find the k smallest items.\n    # The key function ensures sorting first by value, then by original index for stability.\n    result = heapq.nsmallest(k, decorated_records, key=lambda x: (x[0], x[1]))\n\n    # Extract the original tuples from the result, ensuring values are floats.\n    return [item[2] for item in result]"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that are common in all three lists at the same index.\n    \"\"\"\n    result = []\n    min_length = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_length):\n        if l1[i] == l2[i] == l3[i]:\n            result.append(l1[i])\n            \n    return result"}
{"task_id": "Mbpp/757", "solution": "import collections\n\ndef count_reverse_pairs(strings):\n    \"\"\"\n    Counts pairs of reverse strings in the given list.\n    Uses a dictionary to store counts of normalized strings.\n    \"\"\"\n    counts = collections.defaultdict(int)\n    total_pairs = 0\n\n    for s in strings:\n        # In this completion, we assume default normalization (no case-folding, no trim)\n        # as per the core problem description and the simple assert.\n        # The design context provides guidance for more complex normalization\n        # but the simple problem implies basic string comparison.\n        normalized_s = s \n        reversed_s = normalized_s[::-1]\n\n        # Check if the reversed version of the current string has been seen before\n        # If it has, each occurrence forms a pair with the current string\n        total_pairs += counts[reversed_s]\n\n        # Increment the count for the current normalized string\n        counts[normalized_s] += 1\n        \n    return total_pairs"}
{"task_id": "Mbpp/750", "solution": "import uuid\nfrom datetime import datetime\nimport ast\nfrom typing import Any, List, Tuple\n\nclass InvalidInputError(Exception):\n    \"\"\"Raised when input validation fails.\"\"\"\n    pass\n\nclass OperationError(Exception):\n    \"\"\"Raised for unexpected service operation failures.\"\"\"\n    pass\n\nclass RepositoryError(Exception):\n    \"\"\"Raised when repository operations fail.\"\"\"\n    pass\n\ndef timestamp_now() -> str:\n    \"\"\"Returns the current UTC timestamp in ISO 8601 format.\"\"\"\n    return datetime.utcnow().isoformat(timespec='milliseconds') + 'Z'\n\ndef generate_uuid() -> str:\n    \"\"\"Generates and returns a UUID4 string.\"\"\"\n    return str(uuid.uuid4())\n\nclass ListModel:\n    \"\"\"A typed wrapper for a list input, ensuring it's a list.\"\"\"\n    def __init__(self, items: List[Any]) -> None:\n        if not isinstance(items, list):\n            raise InvalidInputError(\"ListModel expects a list\")\n        self._items = list(items)\n\n    def as_list(self) -> List[Any]:\n        \"\"\"Returns a shallow copy of the internal list.\"\"\"\n        return list(self._items)\n\nclass TupleModel:\n    \"\"\"A typed wrapper for a tuple input, ensuring it's a tuple.\"\"\"\n    def __init__(self, items: Tuple[Any, ...]) -> None:\n        if not isinstance(items, tuple):\n            raise InvalidInputError(\"TupleModel expects a tuple\")\n        self._items = items\n\n    def as_tuple(self) -> Tuple[Any, ...]:\n        \"\"\"Returns the internal tuple.\"\"\"\n        return self._items\n\nclass AddTupleRequest:\n    \"\"\"Data Transfer Object for an add tuple request.\"\"\"\n    def __init__(self, input_list: ListModel, input_tuple: TupleModel) -> None:\n        self.input_list = input_list\n        self.input_tuple = input_tuple\n\nclass AddTupleResponse:\n    \"\"\"Data Transfer Object for an add tuple response.\"\"\"\n    def __init__(self, result: List[Any]) -> None:\n        self.result = result\n\n    def to_json(self) -> str:\n        \"\"\"Converts the result to a JSON string.\"\"\"\n        import json\n        return json.dumps(self.result)\n\nclass OperationRecord:\n    \"\"\"Represents a record of an add tuple operation.\"\"\"\n    def __init__(self, id: str, timestamp: str, input_list: List[Any],\n                 input_tuple: Tuple[Any, ...], result_list: List[Any]) -> None:\n        self.id = id\n        self.timestamp = timestamp\n        self.input_list = input_list\n        self.input_tuple = input_tuple\n        self.result_list = result_list\n\nclass OperationRepository:\n    \"\"\"Abstract base class for an operation repository.\"\"\"\n    def save(self, record: OperationRecord) -> None:\n        raise NotImplementedError\n    def list_all(self) -> List[OperationRecord]:\n        raise NotImplementedError\n\nclass InMemoryRepository(OperationRepository):\n    \"\"\"An in-memory implementation of OperationRepository.\"\"\"\n    def __init__(self) -> None:\n        self._storage: List[OperationRecord] = []\n\n    def save(self, record: OperationRecord) -> None:\n        \"\"\"Saves an operation record to in-memory storage.\"\"\"\n        try:\n            self._storage.append(record)\n        except Exception as e:\n            raise RepositoryError(\"Failed to save record\") from e\n\n    def list_all(self) -> List[OperationRecord]:\n        \"\"\"Returns a shallow copy of all stored operation records.\"\"\"\n        return list(self._storage)\n\nclass InputValidator:\n    \"\"\"Validates inputs and converts them to domain models.\"\"\"\n    def validate_list(self, obj: Any) -> ListModel:\n        \"\"\"Validates an object as a list or ListModel.\"\"\"\n        if isinstance(obj, ListModel):\n            return obj\n        if isinstance(obj, list):\n            return ListModel(obj)\n        if isinstance(obj, str):\n            try:\n                parsed = ast.literal_eval(obj)\n            except (ValueError, SyntaxError):\n                raise InvalidInputError(\"Cannot parse list string\")\n            return self.validate_list(parsed)\n        raise InvalidInputError(\"Expected list or ListModel\")\n\n    def validate_tuple(self, obj: Any) -> TupleModel:\n        \"\"\"Validates an object as a tuple or TupleModel.\"\"\"\n        if isinstance(obj, TupleModel):\n            return obj\n        if isinstance(obj, tuple):\n            return TupleModel(obj)\n        if isinstance(obj, str):\n            try:\n                parsed = ast.literal_eval(obj)\n            except (ValueError, SyntaxError):\n                raise InvalidInputError(\"Cannot parse tuple string\")\n            return self.validate_tuple(parsed)\n        raise InvalidInputError(\"Expected tuple or TupleModel\")\n\nclass AddTupleService:\n    \"\"\"Provides the core business logic for adding a tuple to a list.\"\"\"\n    def __init__(self, validator: InputValidator, repo: OperationRepository) -> None:\n        self.validator = validator\n        self.repo = repo\n\n    def add_tuple(self, req: AddTupleRequest, mutate: bool = False) -> AddTupleResponse:\n        \"\"\"Adds elements from a tuple to a list, optionally mutating a copy of the input list.\"\"\"\n        try:\n            left_list = req.input_list.as_list()\n            right_list = list(req.input_tuple.as_tuple())\n\n            if mutate:\n                left_list.extend(right_list)\n                result = left_list\n            else:\n                result = left_list + right_list\n\n            record = OperationRecord(\n                id=generate_uuid(),\n                timestamp=timestamp_now(),\n                input_list=req.input_list.as_list(),\n                input_tuple=req.input_tuple.as_tuple(),\n                result_list=result\n            )\n            self.repo.save(record)\n            return AddTupleResponse(result)\n        except Exception as e:\n            raise OperationError(f\"Failed to add tuple to list: {e}\") from e\n\ndef add_tuple(list_in: List[Any], tuple_in: Tuple[Any, ...], mutate: bool = False) -> List[Any]:\n    \"\"\"\n    Adds the elements of a given tuple to the given list.\n    By default, it returns a new list without modifying the input list.\n    \"\"\"\n    validator = InputValidator()\n    repo = InMemoryRepository()\n    service = AddTupleService(validator, repo)\n\n    request = AddTupleRequest(\n        validator.validate_list(list_in),\n        validator.validate_tuple(tuple_in)\n    )\n\n    response = service.add_tuple(request, mutate=mutate)\n    return response.result"}
{"task_id": "Mbpp/755", "solution": "import math\nfrom typing import List, Union\n\ndef second_smallest(numbers: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Finds the second smallest number in a list using a single pass (O(n) time, O(1) space).\n    Assumes the input list contains at least two numeric elements.\n    \"\"\"\n    min1 = math.inf  # Smallest number found so far\n    min2 = math.inf  # Second smallest number found so far\n\n    for n in numbers:\n        if n <= min1:\n            # If current number is smaller than or equal to the smallest\n            min2 = min1  # The old smallest becomes the new second smallest\n            min1 = n     # The current number is the new smallest\n        elif n < min2:\n            # If current number is smaller than the second smallest (but not the smallest)\n            min2 = n     # The current number is the new second smallest\n            \n    return min2"}
{"task_id": "Mbpp/759", "solution": "import re\n\ndef is_decimal(s: str) -> bool:\n    \"\"\"\n    Checks if a string is a decimal number with exactly two digits of precision.\n    The default pattern allows an optional leading sign.\n    \"\"\"\n    # Pattern allows an optional sign (+/-), followed by one or more digits,\n    # then a decimal point, and exactly two digits after the decimal point.\n    pattern = r\"^[+-]?\\d+\\.\\d{2}$\"\n    return re.fullmatch(pattern, s) is not None"}
{"task_id": "Mbpp/758", "solution": "from typing import Any, Dict, List, Tuple\n\ndef unique_sublists(input_list: List[List[Any]]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"\n    Counts unique sublists in a list, converting them to tuples, including nested lists.\n    Returns a dictionary mapping these tuples to their occurrence counts.\n    \"\"\"\n    counts: Dict[Tuple[Any, ...], int] = {}\n\n    def _convert_to_hashable(item: Any) -> Any:\n        # Recursively converts lists and tuples into immutable tuples.\n        if isinstance(item, list):\n            return tuple(_convert_to_hashable(element) for element in item)\n        elif isinstance(item, tuple):\n            return tuple(_convert_to_hashable(element) for element in item)\n        else:\n            return item\n\n    for sublist in input_list:\n        # Convert the current sublist (which is a list) to a hashable tuple key.\n        tuple_key = _convert_to_hashable(sublist)\n        counts[tuple_key] = counts.get(tuple_key, 0) + 1\n\n    return counts"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(numbers):\n    \"\"\"\n    Checks if a list of numbers contains only one distinct element.\n    Returns True if the list is empty or all elements are identical.\n    \"\"\"\n    if not numbers:\n        return True\n    \n    first_element = numbers[0]\n    for element in numbers[1:]:\n        if element != first_element:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/765", "solution": "import math\n\ndef nth_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number. A polite number is a positive integer that is not a power of two.\n    \"\"\"\n    if n < 1:\n        raise ValueError(\"n must be a positive integer.\")\n\n    count = 0\n    num = 1\n    while count < n:\n        num += 1\n        # Check if num is a power of two\n        # A number x is a power of two if x > 0 and (x & (x - 1)) == 0\n        if not (num > 0 and (num & (num - 1)) == 0):\n            count += 1\n    return num"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(s: str) -> int:\n    \"\"\"Counts the number of ASCII digits (0-9) in the given string.\"\"\"\n    return sum(1 for char in s if '0' <= char <= '9')"}
{"task_id": "Mbpp/763", "solution": "from typing import Sequence, Union\n\ndef find_min_diff(arr: Sequence[Union[int, float]]) -> float:\n    \"\"\"\n    Finds the minimum difference between any two elements in a given array.\n    Assumes arr is a sequence of numbers (int or float) with at least two elements.\n    \"\"\"\n    sorted_arr = sorted(arr)\n    \n    min_difference = float('inf')\n    \n    for i in range(1, len(sorted_arr)):\n        current_diff = abs(sorted_arr[i] - sorted_arr[i-1])\n        if current_diff < min_difference:\n            min_difference = current_diff\n            \n    return min_difference"}
{"task_id": "Mbpp/762", "solution": "from dataclasses import dataclass\n\nclass InvalidMonthError(ValueError):\n    \"\"\"Exception raised for invalid month numbers.\n    It provides a descriptive message for the error.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nMIN_MONTH: int = 1\nMAX_MONTH: int = 12\n\n@dataclass\nclass MonthModel:\n    \"\"\"Represents a month with its number, name, and number of days.\n    Provides a method to check if the month has 30 days.\"\"\"\n    month_number: int\n    name: str\n    days: int\n\n    def is_30_days(self) -> bool:\n        \"\"\"Checks if the month has exactly 30 days.\"\"\"\n        return self.days == 30\n\nclass MonthRepository:\n    \"\"\"Provides month metadata from an in-memory store.\n    It maps month numbers to their corresponding MonthModel instances.\"\"\"\n    _MONTHS_DATA = {\n        1: {\"name\": \"January\", \"days\": 31},\n        2: {\"name\": \"February\", \"days\": 28},\n        3: {\"name\": \"March\", \"days\": 31},\n        4: {\"name\": \"April\", \"days\": 30},\n        5: {\"name\": \"May\", \"days\": 31},\n        6: {\"name\": \"June\", \"days\": 30},\n        7: {\"name\": \"July\", \"days\": 31},\n        8: {\"name\": \"August\", \"days\": 31},\n        9: {\"name\": \"September\", \"days\": 30},\n        10: {\"name\": \"October\", \"days\": 31},\n        11: {\"name\": \"November\", \"days\": 30},\n        12: {\"name\": \"December\", \"days\": 31},\n    }\n\n    def get_month_by_number(self, month_number: int) -> MonthModel | None:\n        \"\"\"Retrieves month data by its number.\n        Returns a MonthModel instance if found, otherwise None.\"\"\"\n        data = self._MONTHS_DATA.get(month_number)\n        if not data:\n            return None\n        return MonthModel(month_number=month_number, name=data[\"name\"], days=data[\"days\"])\n\nclass InputValidator:\n    \"\"\"Validates input month numbers.\n    Ensures the month is an integer and falls within the valid range (1-12).\"\"\"\n    def validate_month_number(self, month: int) -> None:\n        \"\"\"Ensures the month is an integer and between MIN_MONTH and MAX_MONTH.\n        Raises InvalidMonthError for invalid types or out-of-range values.\"\"\"\n        try:\n            m = int(month)\n        except (TypeError, ValueError):\n            raise InvalidMonthError(f\"month must be an integer between {MIN_MONTH} and {MAX_MONTH}\")\n        if m < MIN_MONTH or m > MAX_MONTH:\n            raise InvalidMonthError(f\"month must be between {MIN_MONTH} and {MAX_MONTH}\")\n\nclass MonthService:\n    \"\"\"Encapsulates the core business logic for checking month properties.\n    It utilizes a repository for data and a validator for input correctness.\"\"\"\n    def __init__(self, repo: MonthRepository, validator: InputValidator):\n        self.repo = repo\n        self.validator = validator\n\n    def check_month_has_30_days(self, month_number: int) -> bool:\n        \"\"\"Validates the month number and checks if the corresponding month has 30 days.\n        Propagates InvalidMonthError if validation fails or month data is not found.\"\"\"\n        self.validator.validate_month_number(month_number)\n        model = self.repo.get_month_by_number(month_number)\n        if model is None:\n            raise InvalidMonthError(\"Month data not found for the given valid month number.\")\n        return model.is_30_days()\n\ndef check_monthnumber_number(month: int) -> bool:\n    \"\"\"Checks whether the given month number contains 30 days.\n    This is the public API entry point, orchestrating validation and service logic.\"\"\"\n    repo = MonthRepository()\n    validator = InputValidator()\n    service = MonthService(repo, validator)\n    return service.check_month_has_30_days(month)"}
{"task_id": "Mbpp/766", "solution": "from typing import List, Tuple, TypeVar\n\nT = TypeVar('T')\n\ndef pair_wise(items: List[T]) -> List[Tuple[T, T]]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in the given list.\n    Handles empty or single-element lists by returning an empty list.\n    \"\"\"\n    result_pairs: List[Tuple[T, T]] = []\n    \n    # Obtain an iterator for the input list to process elements one by one.\n    it = iter(items)\n    \n    try:\n        # Get the first element, which will be the 'previous' item for the first pair.\n        prev = next(it)\n    except StopIteration:\n        # If the list is empty, StopIteration is raised, and we return an empty list.\n        return result_pairs\n\n    # Iterate through the rest of the elements.\n    for cur in it:\n        # Append the current pair (previous, current) to the result list.\n        result_pairs.append((prev, cur))\n        # Update 'prev' to the current item for the next iteration.\n        prev = cur\n    \n    return result_pairs"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth powers of the first n odd natural numbers using a closed-form formula.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    # Sum of first n natural numbers: S1 = n(n+1)/2\n    s1 = n * (n + 1) // 2\n    # Sum of squares of first n natural numbers: S2 = n(n+1)(2n+1)/6\n    s2 = n * (n + 1) * (2 * n + 1) // 6\n    # Sum of cubes of first n natural numbers: S3 = (n(n+1)/2)^2 = S1^2\n    s3 = s1 * s1\n    # Sum of fourth powers of first n natural numbers: S4 = n(n+1)(2n+1)(3n^2+3n-1)/30\n    s4 = n * (n + 1) * (2 * n + 1) * (3 * n * n + 3 * n - 1) // 30\n\n    # The sum of (2k-1)^4 from k=1 to n is derived from expanding (2k-1)^4 = 16k^4 - 32k^3 + 24k^2 - 8k + 1\n    # and applying the sums of powers formulas.\n    total_sum = 16 * s4 - 32 * s3 + 24 * s2 - 8 * s1 + n\n    return total_sum"}
{"task_id": "Mbpp/769", "solution": "from typing import Iterable, TypeVar, List, Any\n\nT = TypeVar('T')\n\ndef Diff(a: Iterable[T], b: Iterable[T]) -> List[T]:\n    \"\"\"\n    Computes the difference between two lists, returning elements in 'a'\n    that are not present in 'b', preserving order and multiplicity from 'a'.\n    \"\"\"\n    list_a = list(a)\n    list_b = list(b)\n    result = []\n\n    try:\n        # Attempt to use a set for efficient lookup if elements are hashable (O(N+M))\n        b_set = set(list_b)\n        for item_a in list_a:\n            if item_a not in b_set:\n                result.append(item_a)\n    except TypeError:\n        # Fallback to O(N*M) comparison if elements in 'b' are unhashable\n        for item_a in list_a:\n            found_in_b = False\n            for item_b in list_b:\n                if item_a == item_b:\n                    found_in_b = True\n                    break\n            if not found_in_b:\n                result.append(item_a)\n                \n    return result"}
{"task_id": "Mbpp/767", "solution": "from typing import List, Iterable, Any, Optional\nfrom collections import Counter\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input scenarios.\"\"\"\n    def __init__(self, message: str, details: Optional[dict] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.details = details\n\ndef _to_int(value: Any) -> int:\n    \"\"\"Converts a value to an integer, raising ValueError if conversion fails.\"\"\"\n    return int(value)\n\ndef _fetch_numbers(source: Iterable[Any]) -> List[int]:\n    \"\"\"Validates and converts an iterable source to a list of integers.\"\"\"\n    if source is None:\n        raise InvalidInputError(\"Input numbers list cannot be None\", {\"source\": None})\n    try:\n        return [_to_int(x) for x in source]\n    except TypeError:\n        raise InvalidInputError(\"Input numbers must be an iterable\", {\"source\": str(source)})\n    except ValueError as e:\n        raise InvalidInputError(\"One or more values in numbers list are not convertible to int\", {\"error\": str(e), \"source\": str(source)})\n\ndef _validate_target(target_val: Any) -> int:\n    \"\"\"Validates and converts the target sum to an integer.\"\"\"\n    if target_val is None:\n        raise InvalidInputError(\"Target sum cannot be None\", {\"target\": None})\n    try:\n        return int(target_val)\n    except (TypeError, ValueError):\n        raise InvalidInputError(f\"Target sum '{target_val}' must be an integer\", {\"target\": target_val})\n\ndef _count_pairs_hashmap_impl(numbers: List[int], target: int) -> int:\n    \"\"\"Counts pairs summing to target using a frequency hash map.\"\"\"\n    freq = Counter(numbers)\n    count = 0\n    for x in list(freq.keys()):\n        y = target - x\n        if y not in freq:\n            continue\n        if x == y:\n            n = freq[x]\n            count += n * (n - 1) // 2\n        elif x < y:\n            count += freq[x] * freq[y]\n    return count\n\ndef get_pairs_count(numbers: Iterable[Any], sum: Any) -> int:\n    \"\"\"\n    Counts the number of unordered pairs in a list whose sum equals a target value.\n    This function uses a hashmap for efficient O(N) time complexity.\n    \"\"\"\n    processed_numbers = _fetch_numbers(numbers)\n    validated_sum = _validate_target(sum)\n    return _count_pairs_hashmap_impl(processed_numbers, validated_sum)"}
{"task_id": "Mbpp/772", "solution": "def remove_length(s: str, k: int) -> str:\n    \"\"\"\n    Removes all words with k length from the given string.\n    Punctuation is considered part of the word for length calculation.\n    \"\"\"\n    words = s.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/773", "solution": "import abc\nfrom typing import Optional, Tuple, Any\n\nclass SearchError(Exception):\n    \"\"\"Custom exception for search-related errors.\"\"\"\n    pass\n\nclass OccurrenceResult:\n    \"\"\"DTO representing a found substring occurrence.\"\"\"\n    def __init__(self, substring: str, start: int, end: int) -> None:\n        self.substring = substring\n        self.start = start\n        self.end = end\n\n    def to_tuple(self) -> Tuple[str, int, int]:\n        \"\"\"Converts the occurrence result to a tuple.\"\"\"\n        return (self.substring, self.start, self.end)\n\n    def __repr__(self) -> str:\n        return f\"OccurrenceResult(substring='{self.substring}', start={self.start}, end={self.end})\"\n\nclass StringRepository:\n    \"\"\"In-memory string repository to encapsulate the haystack.\"\"\"\n    def __init__(self, text: str) -> None:\n        self._text = text\n\n    def get_text(self) -> str:\n        \"\"\"Returns the stored text.\"\"\"\n        return self._text\n\nclass SearchAdapter(abc.ABC):\n    \"\"\"Abstract base class for search algorithm implementations.\"\"\"\n    @abc.abstractmethod\n    def search_first(self, haystack: str, needle: str) -> Optional[OccurrenceResult]:\n        \"\"\"Finds the first occurrence of needle in haystack.\"\"\"\n        pass\n\nclass NaiveSearchAdapter(SearchAdapter):\n    \"\"\"Search adapter using Python's str.find method.\"\"\"\n    def __init__(self, case_sensitive: bool = True) -> None:\n        self.case_sensitive = case_sensitive\n\n    def search_first(self, haystack: str, needle: str) -> Optional[OccurrenceResult]:\n        \"\"\"\n        Finds the first occurrence using str.find, handling empty needle and case sensitivity.\n        \"\"\"\n        if needle == \"\":\n            return OccurrenceResult(\"\", 0, 0)\n\n        if not self.case_sensitive:\n            search_haystack = haystack.lower()\n            search_needle = needle.lower()\n        else:\n            search_haystack = haystack\n            search_needle = needle\n\n        idx = search_haystack.find(search_needle)\n\n        if idx == -1:\n            return None\n        return OccurrenceResult(needle, idx, idx + len(needle))\n\nclass SearchService:\n    \"\"\"Orchestrates search requests using a repository and an adapter.\"\"\"\n    def __init__(self, repository: StringRepository, adapter: SearchAdapter) -> None:\n        self.repository = repository\n        self.adapter = adapter\n\n    def find_in(self, haystack: str, needle: str) -> Optional[OccurrenceResult]:\n        \"\"\"\n        Finds the first occurrence in the given haystack, using the configured adapter.\n        \"\"\"\n        try:\n            return self.adapter.search_first(haystack, needle)\n        except Exception as e:\n            raise SearchError(f\"Search adapter failed: {e}\") from e\n\ndef validate_inputs(haystack: Any, needle: Any) -> None:\n    \"\"\"Validates that haystack and needle are strings.\"\"\"\n    if not isinstance(haystack, str):\n        raise SearchError(f\"Haystack must be a string, got {type(haystack)}\")\n    if not isinstance(needle, str):\n        raise SearchError(f\"Needle must be a string, got {type(needle)}\")\n\nclass SearchController:\n    \"\"\"Controller that validates inputs and delegates to the search service.\"\"\"\n    def __init__(self, service: SearchService) -> None:\n        self.service = service\n\n    def occurance_substring(self, haystack: str, needle: str) -> Optional[Tuple[str, int, int]]:\n        \"\"\"\n        Validates inputs, performs the search, and formats the result.\n        Returns a tuple (substring, start_index, end_index) or None.\n        \"\"\"\n        validate_inputs(haystack, needle)\n        result = self.service.find_in(haystack, needle)\n        if result:\n            return result.to_tuple()\n        return None\n\n# Global instances for the public API function, adhering to the design context.\n_default_adapter = NaiveSearchAdapter()\n_default_service = SearchService(repository=StringRepository(\"\"), adapter=_default_adapter)\n_default_controller = SearchController(service=_default_service)\n\ndef occurance_substring(haystack: str, needle: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Finds the first occurrence and position of a substring within a string.\n    Returns (substring, start_index, end_index) or None if no match.\n    \"\"\"\n    return _default_controller.occurance_substring(haystack, needle)"}
{"task_id": "Mbpp/775", "solution": "def odd_position(my_list: list) -> bool:\n    \"\"\"\n    Checks if every odd index in the list contains an odd number.\n    Returns True if all odd indexed numbers are odd, False otherwise.\n    \"\"\"\n    for i in range(1, len(my_list), 2):\n        if my_list[i] % 2 == 0:\n            return False\n    return True"}
{"task_id": "Mbpp/777", "solution": "import collections\n\ndef find_sum(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of non-repeated elements in a list.\n    By default, \"non-repeated\" means unique elements (deduplicate then sum).\n    \"\"\"\n    # The design context explicitly states that the default mode is \"unique\"\n    # and the provided example assertion matches this interpretation:\n    # assert find_sum([1,2,3,1,1,4,5,6]) == 21 which is sum({1,2,3,4,5,6})\n    return sum(set(numbers))"}
{"task_id": "Mbpp/771", "solution": "from typing import List, Optional, Dict, Set, Callable\n\nclass Expression:\n    \"\"\"Value object wrapping the input expression string.\"\"\"\n    def __init__(self, text: str) -> None:\n        if not isinstance(text, str):\n            raise TypeError(\"Expression.text must be a str\")\n        self.text: str = text\n    def __repr__(self) -> str:\n        return f\"Expression({self.text!r})\"\n\nclass ValidationResult:\n    \"\"\"DTO capturing validation outcome.\"\"\"\n    def __init__(self, is_balanced: bool, reason: Optional[str] = None, index: Optional[int] = None) -> None:\n        self.is_balanced: bool = is_balanced\n        self.reason: Optional[str] = reason\n        self.index: Optional[int] = index\n    def __repr__(self) -> str:\n        return f\"ValidationResult(is_balanced={self.is_balanced}, reason={self.reason!r}, index={self.index!r})\"\n\nclass CharStack:\n    \"\"\"Minimal LIFO stack specialized for single-character pushes/pops.\"\"\"\n    def __init__(self) -> None:\n        self._items: List[str] = []\n    def push(self, ch: str) -> None:\n        self._items.append(ch)\n    def pop(self) -> str:\n        return self._items.pop()\n    def peek(self) -> Optional[str]:\n        return self._items[-1] if self._items else None\n    def is_empty(self) -> bool:\n        return not self._items\n    def size(self) -> int:\n        return len(self._items)\n\nclass InvalidCharacterError(Exception):\n    \"\"\"Raised when an invalid non-bracket character is encountered in strict mode.\"\"\"\n    def __init__(self, char: str, index: int) -> None:\n        super().__init__(f\"Invalid character '{char}' at index {index}\")\n        self.char: str = char\n        self.index: int = index\n\nclass UnbalancedExpressionError(Exception):\n    \"\"\"Reserved for potential future use or more specific unbalanced cases.\"\"\"\n    def __init__(self, message: str, index: Optional[int] = None) -> None:\n        super().__init__(message)\n        self.message: str = message\n        self.index: Optional[int] = index\n\nDEFAULT_BRACKET_PAIRS: Dict[str, str] = {\"(\": \")\", \"[\": \"]\", \"{\": \"}\"}\nOPENING_SET: Set[str] = set(DEFAULT_BRACKET_PAIRS.keys())\nCLOSING_SET: Set[str] = set(DEFAULT_BRACKET_PAIRS.values())\n\nclass ExpressionValidator:\n    \"\"\"Implements bracket balancing algorithm.\"\"\"\n    def __init__(self, bracket_pairs: Dict[str, str] = None, reject_invalid: bool = False, stack_factory: Callable[[], CharStack] = None) -> None:\n        self._bracket_pairs: Dict[str, str] = bracket_pairs if bracket_pairs is not None else DEFAULT_BRACKET_PAIRS\n        self._opening: Set[str] = set(self._bracket_pairs.keys())\n        self._closing: Set[str] = set(self._bracket_pairs.values())\n        self._reject_invalid: bool = reject_invalid\n        self._stack_factory: Callable[[], CharStack] = stack_factory if stack_factory is not None else CharStack\n\n    def validate(self, expression: Expression) -> ValidationResult:\n        \"\"\"Performs O(n) scan, uses stack to match brackets.\"\"\"\n        stack = self._stack_factory()\n        for i, ch in enumerate(expression.text):\n            if ch in self._opening:\n                stack.push(ch)\n            elif ch in self._closing:\n                if stack.is_empty():\n                    return ValidationResult(False, \"Unmatched closing\", i)\n                top = stack.pop()\n                if self._bracket_pairs[top] != ch:\n                    return ValidationResult(False, \"Mismatched pair\", i)\n            else: # Not a bracket character\n                if self._reject_invalid:\n                    raise InvalidCharacterError(ch, i)\n                # Else: ignore non-bracket character\n        \n        if stack.is_empty():\n            return ValidationResult(True)\n        else:\n            return ValidationResult(False, \"Unmatched opening\", None)\n\nclass ExpressionController:\n    \"\"\"Thin adapter for the public `check_expression` function.\"\"\"\n    def __init__(self, validator: Optional['ExpressionValidator'] = None) -> None:\n        self._validator: Optional[ExpressionValidator] = validator\n\n    def check_expression(self, text: str, reject_invalid: bool = False) -> bool:\n        \"\"\"Creates an Expression, delegates to a validator, and returns boolean result.\"\"\"\n        if not isinstance(text, str):\n            raise TypeError(\"Input 'expression' must be a string.\")\n        \n        # Always create a new validator instance to ensure `reject_invalid` is respected per call.\n        validator_to_use = ExpressionValidator(reject_invalid=reject_invalid)\n\n        expression_obj = Expression(text)\n        \n        try:\n            result = validator_to_use.validate(expression_obj)\n            return result.is_balanced\n        except InvalidCharacterError:\n            raise\n\n_controller = ExpressionController()\n\ndef check_expression(expression: str, reject_invalid: bool = False) -> bool:\n    return _controller.check_expression(expression, reject_invalid=reject_invalid)"}
{"task_id": "Mbpp/778", "solution": "from typing import Any, List\n\ndef pack_consecutive_duplicates(lst: List[Any]) -> List[List[Any]]:\n    \"\"\"\n    Packs consecutive duplicates of list elements into sublists.\n    \"\"\"\n    if not lst:\n        return []\n\n    result: List[List[Any]] = []\n    current_group: List[Any] = [lst[0]]\n\n    for item in lst[1:]:\n        if item == current_group[-1]:\n            current_group.append(item)\n        else:\n            result.append(current_group)\n            current_group = [item]\n    \n    result.append(current_group)\n    return result"}
{"task_id": "Mbpp/780", "solution": "import collections\nfrom typing import List, Tuple\n\ndef find_combinations(tuple_list: List[Tuple[int, int]]) -> List[Tuple[int, int]]:\n    \"\"\"\n    Finds combinations of sums with tuples in the given tuple list.\n    Computes element-wise sums for every unique unordered pair of 2-tuples.\n    \"\"\"\n    results: List[Tuple[int, int]] = []\n    n = len(tuple_list)\n    for i in range(n):\n        for j in range(i + 1, n):\n            tuple1 = tuple_list[i]\n            tuple2 = tuple_list[j]\n            results.append((tuple1[0] + tuple2[0], tuple1[1] + tuple2[1]))\n    return results"}
{"task_id": "Mbpp/781", "solution": "import math\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"Return True if the count of positive divisors of n is even, False otherwise.\"\"\"\n    count = 0\n    root = int(math.isqrt(n))\n    for i in range(1, root + 1):\n        if n % i == 0:\n            # If i*i == n, then i is the only divisor, add 1.\n            # Otherwise, i and n//i are two distinct divisors, add 2.\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n    return (count % 2 == 0)"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(nums: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of all odd-length subarrays for a given list of integers.\n    Uses an O(n) contribution method where each number's contribution is summed.\n    \"\"\"\n    total_sum = 0\n    n = len(nums)\n    for i, num in enumerate(nums):\n        # Calculate total number of subarrays containing nums[i]\n        # (i+1) represents choices for the start index (0 to i)\n        # (n-i) represents choices for the end index (i to n-1)\n        total_subarrays_containing_num = (i + 1) * (n - i)\n\n        # Number of odd-length subarrays containing num\n        # If total_subarrays_containing_num is odd, then (odd_count - even_count) is 1, so odd_count = total_sub // 2 + 1\n        # If total_subarrays_containing_num is even, then (odd_count - even_count) is 0, so odd_count = total_sub // 2\n        odd_count = (total_subarrays_containing_num + 1) // 2\n        \n        total_sum += num * odd_count\n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "from typing import Sequence, Any, Optional\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input types or values.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass MissingNumberError(ValueError):\n    \"\"\"Custom exception when a required odd or even number is missing.\"\"\"\n    def __init__(self, missing: str, message: str) -> None:\n        self.missing = missing\n        self.message = message\n        super().__init__(self.message)\n\nclass NumberPair:\n    \"\"\"Represents a pair of numbers, one odd and one even.\"\"\"\n    def __init__(self, odd: int, even: int) -> None:\n        self.odd = odd\n        self.even = even\n\n    def product(self) -> int:\n        \"\"\"Calculates the product of the odd and even numbers.\"\"\"\n        return self.odd * self.even\n\nclass Validator:\n    \"\"\"Utility class for input validation.\"\"\"\n    def validate_list(self, nums: Sequence[Any]) -> None:\n        \"\"\"Validates that the input is a sequence of integers.\"\"\"\n        if not isinstance(nums, (list, tuple)):\n            raise InvalidInputError(\"Input must be a list or tuple of integers.\")\n        for i, v in enumerate(nums):\n            if not self.is_int(v):\n                raise InvalidInputError(f\"Item at index {i} is not an integer: {v!r}\")\n\n    @staticmethod\n    def is_int(value: Any) -> bool:\n        \"\"\"Checks if a value is an integer, excluding booleans.\"\"\"\n        return isinstance(value, int) and not isinstance(value, bool)\n\nclass ListRepository:\n    \"\"\"Repository to find the first even and odd numbers in a sequence.\"\"\"\n    def find_first_even_and_odd(self, nums: Sequence[int]) -> NumberPair:\n        \"\"\"Scans the list to find the first odd and first even numbers.\"\"\"\n        first_odd: Optional[int] = None\n        first_even: Optional[int] = None\n\n        for v in nums:\n            if first_even is None and v % 2 == 0:\n                first_even = v\n            if first_odd is None and v % 2 != 0:\n                first_odd = v\n            \n            if first_even is not None and first_odd is not None:\n                break\n        \n        if first_odd is None:\n            raise MissingNumberError(\"odd\", \"No odd number found in input.\")\n        if first_even is None:\n            raise MissingNumberError(\"even\", \"No even number found in input.\")\n        \n        return NumberPair(odd=first_odd, even=first_even)\n\nclass MulService:\n    \"\"\"Business logic service for computing the product.\"\"\"\n    def __init__(self, repo: ListRepository, validator: Validator) -> None:\n        self._repo = repo\n        self._validator = validator\n\n    def compute_product(self, nums: Sequence[int]) -> int:\n        \"\"\"Validates input, finds the numbers, and returns their product.\"\"\"\n        self._validator.validate_list(nums)\n        pair = self._repo.find_first_even_and_odd(nums)\n        return pair.product()\n\nclass MulController:\n    \"\"\"Controller layer to handle requests and orchestrate the service.\"\"\"\n    def __init__(self, service: MulService) -> None:\n        self._service = service\n\n    def handle(self, nums: Sequence[int]) -> int:\n        \"\"\"Processes the input list and returns the product.\"\"\"\n        return self._service.compute_product(nums)\n\ndef mul_even_odd(nums: Sequence[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd number of a given list.\n\n    Args:\n        nums: A sequence of integers.\n\n    Returns:\n        The product of the first odd and first even number found.\n    \"\"\"\n    _repo = ListRepository()\n    _validator = Validator()\n    _service = MulService(repo=_repo, validator=_validator)\n    _controller = MulController(service=_service)\n    \n    return _controller.handle(nums)"}
{"task_id": "Mbpp/786", "solution": "from typing import Sequence, TypeVar\n\nT = TypeVar(\"T\")\n\ndef right_insertion(seq: Sequence[T], value: T) -> int:\n    \"\"\"\n    Locate the right insertion point for a specified value in sorted order.\n    The index returned is such that all elements to its left are less than or equal to the value.\n    \"\"\"\n    left = 0\n    right = len(seq)\n    while left < right:\n        mid = (left + right) // 2\n        if seq[mid] <= value:\n            left = mid + 1\n        else:\n            right = mid\n    return left"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(s: str) -> tuple[int, ...]:\n    \"\"\"Converts a string representation of a tuple of integers into an actual Python tuple of integers.\"\"\"\n    inner_content = s.strip()[1:-1]  # Remove outer parentheses and strip whitespace\n\n    if not inner_content.strip():  # Handle empty tuple case \"()\"\n        return ()\n\n    # Split the content by comma, strip whitespace from each item, and convert to int\n    int_list = [int(item.strip()) for item in inner_content.split(',')]\n\n    return tuple(int_list)"}
