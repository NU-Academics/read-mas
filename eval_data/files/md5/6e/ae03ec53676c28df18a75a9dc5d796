{"task_id": "Mbpp/409", "solution": "import sys\nfrom typing import Any, Iterable, List, Optional, Tuple\n\nclass MinProdError(Exception):\n    \"\"\"Base exception for minprod library errors.\"\"\"\n    pass\n\nclass InvalidInputError(MinProdError):\n    \"\"\"Raised when the input format or values are invalid.\"\"\"\n    pass\n\nclass EmptyInputError(MinProdError):\n    \"\"\"Raised when the input list of pairs is empty.\"\"\"\n    pass\n\ndef safe_int(x: Any) -> int:\n    \"\"\"Convert a value to an integer, raising InvalidInputError on failure.\"\"\"\n    try:\n        return int(x)\n    except (ValueError, TypeError):\n        raise InvalidInputError(f\"Value {x!r} is not convertible to int\")\n\ndef prod(a: int, b: int) -> int:\n    \"\"\"Compute the product of two integers.\"\"\"\n    return a * b\n\nclass TuplePair:\n    \"\"\"Represents a pair of integers and provides their product.\"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n\n    def product(self) -> int:\n        \"\"\"Returns the product of the two integers in the pair.\"\"\"\n        return prod(self.a, self.b)\n\nclass InputAdapter:\n    \"\"\"Adapts various input forms into a list of TuplePair objects.\"\"\"\n    @staticmethod\n    def from_iterable(pairs: Iterable[Tuple[Any, Any]]) -> List[TuplePair]:\n        \"\"\"Converts an iterable of 2-element pairs into a list of TuplePair objects.\"\"\"\n        out = []\n        for idx, item in enumerate(pairs):\n            try:\n                a, b = item\n            except Exception:\n                raise InvalidInputError(f\"Item at index {idx} is not a 2-element pair.\")\n            out.append(TuplePair(safe_int(a), safe_int(b)))\n        return out\n\nclass MinProductService:\n    \"\"\"Business logic for computing the minimum product from a list of TuplePair objects.\"\"\"\n    def __init__(self, pairs: Iterable[TuplePair]) -> None:\n        self._validate_pairs(pairs)\n        self._pairs = list(pairs)\n\n    def _validate_pairs(self, pairs: Iterable[TuplePair]) -> None:\n        \"\"\"Validates that the input is a non-empty list of TuplePair instances.\"\"\"\n        pairs_list = list(pairs) # Consume iterable for validation\n        if not pairs_list:\n            raise EmptyInputError(\"Input list must contain at least one pair.\")\n        for p in pairs_list:\n            if not isinstance(p, TuplePair):\n                raise InvalidInputError(\"Each item must be a TuplePair instance.\")\n\n    def compute_min_product(self) -> int:\n        \"\"\"Computes and returns the minimum product among the stored pairs.\"\"\"\n        if not self._pairs:\n            # This case should ideally be caught by _validate_pairs during init\n            raise EmptyInputError(\"Cannot compute minimum product from an empty list of pairs.\")\n\n        min_val = None\n        for p in self._pairs:\n            val = p.product()\n            if min_val is None or val < min_val:\n                min_val = val\n        return int(min_val)\n\ndef min_product_tuple(pairs: Iterable[Tuple[Any, Any]]) -> int:\n    \"\"\"\n    Finds the minimum product from the pairs of tuples within a given list.\n\n    It validates input, converts elements to integers, computes products for each pair,\n    and returns the smallest product.\n    \"\"\"\n    normalized = InputAdapter.from_iterable(pairs)\n    service = MinProductService(normalized)\n    return service.compute_min_product()"}
{"task_id": "Mbpp/413", "solution": "from typing import List, Tuple, Any\n\ndef extract_nth_element(list_of_tuples: List[Tuple[Any, ...]], n: int) -> List[Any]:\n    \"\"\"\n    Extracts the nth element from each tuple in a given list of tuples.\n    \"\"\"\n    results: List[Any] = []\n    for tpl in list_of_tuples:\n        results.append(tpl[n])\n    return results"}
{"task_id": "Mbpp/404", "solution": "from typing import Any, Union\nimport math\n\nclass MinimumError(Exception):\n    \"\"\"Custom exception for minimum function errors, including input validation.\"\"\"\n    def __init__(self, message: str, value: Any = None) -> None:\n        super().__init__(message)\n        self.value = value\n\ndef is_integerish(value: float) -> bool:\n    \"\"\"Determines if a float is numerically equivalent to an integer.\"\"\"\n    return value.is_integer()\n\ndef minimum(a: Any, b: Any) -> Union[int, float]:\n    \"\"\"\n    Finds the minimum of two numbers, with robust input validation and type handling.\n    Accepts int, float, or numeric strings, and preserves int return type when appropriate.\n    \"\"\"\n\n    def _validate_numeric(value: Any, allow_string_conversion: bool = True) -> float:\n        \"\"\"Validates and converts a single input to a float, raising MinimumError on invalid input.\"\"\"\n        if isinstance(value, (int, float)):\n            if math.isnan(value) or math.isinf(value):\n                raise MinimumError(f\"NaN or infinite values are not allowed: {value}\", value)\n            return float(value)\n        if isinstance(value, str) and allow_string_conversion:\n            try:\n                float_val = float(value)\n                if math.isnan(float_val) or math.isinf(float_val):\n                    raise MinimumError(f\"NaN or infinite values are not allowed after string conversion: '{value}'\", value)\n                return float_val\n            except ValueError:\n                raise MinimumError(f\"Cannot convert to numeric: '{value}'\", value)\n        raise MinimumError(f\"Unsupported type for numeric conversion: '{type(value).__name__}'\", value)\n\n    # Validate and convert both inputs to float using the internal helper\n    float_a = _validate_numeric(a)\n    float_b = _validate_numeric(b)\n\n    # Determine the minimum value\n    result = float_a if float_a <= float_b else float_b\n\n    # Preserve integer type if the result is numerically an integer\n    if is_integerish(result):\n        return int(result)\n    return result"}
{"task_id": "Mbpp/410", "solution": "from typing import List, Any, Union\n\ndef is_numeric(obj: Any) -> bool:\n    \"\"\"Checks if an object is an int or float, excluding booleans.\"\"\"\n    return isinstance(obj, (int, float)) and not isinstance(obj, bool)\n\ndef min_val(items: List[Any]) -> Union[int, float]:\n    \"\"\"\n    Finds the minimum numeric value in a heterogeneous list, ignoring non-numeric elements.\n    \"\"\"\n    numeric_values = [item for item in items if is_numeric(item)]\n    return min(numeric_values)"}
{"task_id": "Mbpp/412", "solution": "import uuid\nfrom datetime import datetime\nfrom typing import List, Optional, Protocol, Dict\n\nclass PersistRecord:\n    \"\"\"DTO for storing input, result, and metadata of an operation.\"\"\"\n    def __init__(self, id: str, input: List[int], result: List[int], timestamp: str) -> None:\n        self.id = id\n        self.input = input\n        self.result = result\n        self.timestamp = timestamp\n\n    def to_dict(self) -> Dict[str, List[int] | str]:\n        \"\"\"Converts the record to a dictionary.\"\"\"\n        return {\n            \"id\": self.id,\n            \"input\": self.input,\n            \"result\": self.result,\n            \"timestamp\": self.timestamp,\n        }\n\nclass ListRepository(Protocol):\n    \"\"\"Interface for repositories handling list persistence.\"\"\"\n    def save(self, record: PersistRecord) -> str:\n        \"\"\"Saves a PersistRecord and returns its ID.\"\"\"\n        ...\n    def get_last(self) -> Optional[PersistRecord]:\n        \"\"\"Retrieves the last saved PersistRecord.\"\"\"\n        ...\n\nclass InMemoryListRepository:\n    \"\"\"In-memory implementation of ListRepository.\"\"\"\n    def __init__(self) -> None:\n        self._store: Optional[PersistRecord] = None\n\n    def save(self, record: PersistRecord) -> str:\n        \"\"\"Stores the record in memory, overwriting any previous record.\"\"\"\n        self._store = record\n        return record.id\n\n    def get_last(self) -> Optional[PersistRecord]:\n        \"\"\"Returns the last record saved to memory, or None if none.\"\"\"\n        return self._store\n\nclass RemoveOddService:\n    \"\"\"Service containing the core logic to remove odd numbers.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def remove_odd(self, items: List[int]) -> List[int]:\n        \"\"\"Filters a list to return only even integers, preserving order.\"\"\"\n        return [x for x in items if x % 2 == 0]\n\nclass RemoveOddController:\n    \"\"\"Facade for the remove_odd operation, orchestrating service calls and optional persistence.\"\"\"\n    def __init__(self, repo: Optional[ListRepository] = None) -> None:\n        self._service = RemoveOddService()\n        self._repo = repo\n\n    def remove_odd(self, items: List[int]) -> List[int]:\n        \"\"\"Removes odd numbers from the input list and optionally persists the operation.\"\"\"\n        result = self._service.remove_odd(items)\n\n        if self._repo is not None:\n            record = PersistRecord(str(uuid.uuid4()), items, result, datetime.utcnow().isoformat() + \"Z\")\n            try:\n                self._repo.save(record)\n            except Exception:\n                # Persistence errors are logged/caught and do not fail the main operation.\n                pass\n        return result\n\n_default_controller = RemoveOddController(repo=InMemoryListRepository())\n\ndef remove_odd(items: List[int]) -> List[int]:\n    \"\"\"\n    Removes odd numbers from a given list of integers.\n\n    This function acts as a facade, delegating to an internal controller\n    which applies the filtering logic and optionally persists the operation.\n    \"\"\"\n    return _default_controller.remove_odd(items)"}
{"task_id": "Mbpp/414", "solution": "from typing import Any, Iterable, Optional, List, Set\n\nclass OverlapError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InvalidSequenceError(OverlapError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass Utils:\n    @staticmethod\n    def is_iterable(obj: Any) -> bool:\n        \"\"\"Checks if an object is iterable.\"\"\"\n        try:\n            iter(obj)\n            return True\n        except TypeError:\n            return False\n\n    @staticmethod\n    def try_len(iterable: Iterable[Any]) -> Optional[int]:\n        \"\"\"Returns the length of an iterable if possible, otherwise None.\"\"\"\n        try:\n            return len(iterable)\n        except (TypeError, AttributeError):\n            return None\n\n    @staticmethod\n    def make_set_safe(iterable: Iterable[Any]) -> Set[Any]:\n        \"\"\"Attempts to create a set from an iterable. May raise TypeError.\"\"\"\n        return set(iterable)\n\n    @staticmethod\n    def iterable_to_list(iterable: Iterable[Any]) -> List[Any]:\n        \"\"\"Converts an iterable to a list, consuming generators.\"\"\"\n        return list(iterable)\n\nclass SequenceValidator:\n    def validate(self, seq: Any, name: str) -> None:\n        \"\"\"Validates if the input sequence is iterable.\"\"\"\n        if not Utils.is_iterable(seq):\n            raise InvalidSequenceError(f\"{name} is not iterable.\")\n\n    def get_len_hint(self, seq: Iterable[Any]) -> Optional[int]:\n        \"\"\"Provides a length hint for the sequence, if available.\"\"\"\n        return Utils.try_len(seq)\n\nclass OverlapService:\n    def __init__(self, validator: SequenceValidator = None) -> None:\n        self.validator = validator or SequenceValidator()\n\n    def _hashable_overlap(self, smaller: Iterable[Any], larger: Iterable[Any]) -> bool:\n        \"\"\"Checks for overlap using a set for hashable elements.\"\"\"\n        smaller_set = Utils.make_set_safe(smaller)\n        for item in larger:\n            if item in smaller_set:\n                return True\n        return False\n\n    def _unhashable_overlap(self, seq1: Iterable[Any], seq2: Iterable[Any]) -> bool:\n        \"\"\"Checks for overlap using nested loops for unhashable elements.\"\"\"\n        # Convert to lists to handle generators and allow multiple passes\n        list1 = Utils.iterable_to_list(seq1)\n        list2 = Utils.iterable_to_list(seq2)\n\n        for item1 in list1:\n            for item2 in list2:\n                if item1 == item2:\n                    return True\n        return False\n\n    def find_overlap(self, seq1: Iterable[Any], seq2: Iterable[Any]) -> bool:\n        \"\"\"Determines if any element overlaps between two sequences.\"\"\"\n        len1 = self.validator.get_len_hint(seq1)\n        len2 = self.validator.get_len_hint(seq2)\n\n        # Optimize by trying to build a set from the smaller sequence\n        # If lengths are known, pick the smaller one. If not, pick seq1 arbitrarily.\n        _smaller, _larger = (seq1, seq2) if len1 is None or (len2 is not None and len1 <= len2) else (seq2, seq1)\n\n        try:\n            # Attempt O(N+M) path for hashable elements\n            return self._hashable_overlap(_smaller, _larger)\n        except TypeError:\n            # Fallback to O(N*M) path for unhashable elements\n            # Use original seq1 and seq2 for unhashable path\n            return self._unhashable_overlap(seq1, seq2)\n        except Exception as e:\n            raise OverlapError(f\"An unexpected error occurred during overlap check: {e}\")\n\nclass OverlapController:\n    def __init__(self, service: OverlapService, validator: SequenceValidator) -> None:\n        self.service = service\n        self.validator = validator\n\n    def check_overlap(self, seq1: Iterable[Any], seq2: Iterable[Any]) -> bool:\n        \"\"\"Validates inputs and delegates to the service for overlap detection.\"\"\"\n        try:\n            self.validator.validate(seq1, \"seq1\")\n            self.validator.validate(seq2, \"seq2\")\n            return self.service.find_overlap(seq1, seq2)\n        except OverlapError:\n            # Re-raise known OverlapError types (e.g., InvalidSequenceError)\n            raise\n        except Exception as e:\n            # Wrap any other unexpected exceptions\n            raise OverlapError(f\"An unexpected error occurred during overlap check: {e}\")\n\n_default_controller = OverlapController(OverlapService(SequenceValidator()), SequenceValidator())\n\ndef overlapping(seq1: Iterable[Any], seq2: Iterable[Any]) -> bool:\n    \"\"\"Checks if any element in `seq1` also exists in `seq2`.\"\"\"\n    return _default_controller.check_overlap(seq1, seq2)"}
{"task_id": "Mbpp/419", "solution": "from decimal import Decimal, ROUND_HALF_UP\n\ndef round_and_sum(numbers: list[float]) -> int:\n    \"\"\"\n    Rounds every number of a given list using ROUND_HALF_UP, calculates the total sum\n    of the rounded numbers, and multiplies it by the length of the list.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    rounded_numbers = []\n    for num in numbers:\n        # Convert to Decimal via string to preserve precision, then round using ROUND_HALF_UP.\n        decimal_num = Decimal(str(num))\n        rounded_int = int(decimal_num.quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP))\n        rounded_numbers.append(rounded_int)\n\n    total_sum_of_rounded = sum(rounded_numbers)\n    list_length = len(numbers)\n    \n    return total_sum_of_rounded * list_length"}
{"task_id": "Mbpp/415", "solution": "from typing import List, Tuple\n\ndef max_Product(nums: List[int]) -> Tuple[int, int]:\n    def _order_pair(a: int, b: int) -> Tuple[int, int]:\n        \"\"\"Returns a tuple with the smaller element first.\"\"\"\n        return (a, b) if a <= b else (b, a)\n\n    # Initialize variables to track the two largest and two smallest numbers\n    # Using large/small integers as initial values based on design context\n    max1 = -10**18  # Largest element found\n    max2 = -10**18  # Second largest element found\n    min1 = 10**18   # Smallest element found\n    min2 = 10**18   # Second smallest element found\n\n    for x in nums:\n        # Update largest two numbers\n        if x >= max1:\n            max2 = max1\n            max1 = x\n        elif x > max2:\n            max2 = x\n\n        # Update smallest two numbers\n        if x <= min1:\n            min2 = min1\n            min1 = x\n        elif x < min2:\n            min2 = x\n\n    # The maximum product can be either the product of the two largest positive numbers\n    # or the product of the two smallest (most negative) numbers.\n    prod_max_pos = max1 * max2\n    prod_min_neg = min1 * min2\n\n    if prod_max_pos >= prod_min_neg:\n        return _order_pair(max1, max2)\n    else:\n        return _order_pair(min1, min2)"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n):\n    \"\"\"\n    Calculates the sum of the cubes of the first n even natural numbers using a mathematical formula.\n    The formula is sum_{k=1..n} (2k)^3 = 2 * n^2 * (n+1)^2.\n    \"\"\"\n    # Using the optimized O(1) formula: 2 * n^2 * (n+1)^2\n    return 2 * (n * n) * ((n + 1) * (n + 1))"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(input_list):\n    \"\"\"\n    Finds the element with the maximum length in a list of sequence-like elements.\n    If multiple elements have the same maximum length, the first one encountered is returned.\n    \"\"\"\n    if not input_list:\n        return None\n\n    max_element = input_list[0]\n    max_length = len(input_list[0])\n\n    for element in input_list[1:]:\n        current_length = len(element)\n        if current_length > max_length:\n            max_length = current_length\n            max_element = element\n\n    return max_element"}
{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n: int) -> float:\n    \"\"\"\n    Calculates the average of the cubes of the first n natural numbers.\n    Uses the simplified closed-form formula for direct computation.\n    \"\"\"\n    average = n * ((n + 1)**2) / 4\n    return average"}
{"task_id": "Mbpp/421", "solution": "import functools\nfrom typing import Any, Tuple, Optional\n\nclass InvalidTupleError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass TupleValidator:\n    def is_tuple(self, obj: Any) -> bool:\n        return isinstance(obj, tuple)\n\n    def validate(self, items: Any) -> None:\n        if not self.is_tuple(items):\n            raise InvalidTupleError(f\"Expected tuple, got {type(items).__name__}\")\n\ndef stringify(value: Any) -> str:\n    \"\"\"Converts a value to its string representation.\n    Wraps conversion errors in RuntimeError with context.\"\"\"\n    try:\n        return str(value)\n    except Exception as e:\n        raise RuntimeError(f\"Failed to stringify value {value!r}: {e}\") from e\n\nclass ConcatenatorService:\n    def __init__(self, validator: TupleValidator, default_delimiter: str = \"-\"):\n        self._validator = validator\n        self._default_delimiter = default_delimiter\n\n    def concatenate(self, items: Tuple[Any, ...], delimiter: Optional[str] = None) -> str:\n        \"\"\"Concatenates elements of a tuple into a single string using a delimiter.\"\"\"\n        self._validator.validate(items)\n        actual_delimiter = delimiter if delimiter is not None else self._default_delimiter\n        parts = [stringify(e) for e in items]\n        return actual_delimiter.join(parts)\n\n_shared_validator = TupleValidator()\n_shared_service = ConcatenatorService(_shared_validator, default_delimiter=\"-\")\n\ndef concatenate_tuple(items: Tuple[Any, ...], delimiter: Optional[str] = None) -> str:\n    \"\"\"\n    Concatenates each element of a tuple into a single string, separated by a delimiter.\n    Uses '-' as the default delimiter if none is provided.\n    \"\"\"\n    return _shared_service.concatenate(items, delimiter)"}
{"task_id": "Mbpp/424", "solution": "def extract_rear(strings: tuple) -> list:\n    \"\"\"\n    Extracts the last character from each string in the input tuple.\n    Assumes valid input where each string is non-empty.\n    \"\"\"\n    return [s[-1] for s in strings]"}
{"task_id": "Mbpp/425", "solution": "def count_element_in_list(lists, element):\n    \"\"\"Counts the number of immediate sublists that contain the specified element.\n\n    Handles cases where sublist elements might not be iterable by attempting direct equality if `element in sub` fails.\n    \"\"\"\n    count = 0\n    for sub in lists:\n        try:\n            if element in sub:\n                count += 1\n        except TypeError:\n            # If 'sub' is not iterable, check for direct equality.\n            if sub == element:\n                count += 1\n    return count"}
{"task_id": "Mbpp/427", "solution": "import re\n\nclass DateFormatError(Exception):\n    \"\"\"Custom exception for date formatting errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return self.message\n\nclass DateModel:\n    \"\"\"Domain model representing parsed date parts.\"\"\"\n    def __init__(self, year: int, month: int, day: int) -> None:\n        self.year = year\n        self.month = month\n        self.day = day\n\n    def to_tuple(self) -> tuple[int, int, int]:\n        \"\"\"Returns the date components as a tuple (year, month, day).\"\"\"\n        return (self.year, self.month, self.day)\n\n    def validate_semantics(self) -> None:\n        \"\"\"Validates the semantic correctness of the date components.\"\"\"\n        if not (1 <= self.month <= 12):\n            raise DateFormatError(f\"month {self.month} out of range (1-12)\")\n\n        days_in_month = [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]\n        \n        is_leap_year = (self.year % 4 == 0 and self.year % 100 != 0) or (self.year % 400 == 0)\n        if is_leap_year:\n            days_in_month[2] = 29 # February\n\n        if not (1 <= self.day <= days_in_month[self.month]):\n            raise DateFormatError(f\"day {self.day} out of range for month {self.month} in year {self.year}\")\n\nclass DateValidator:\n    \"\"\"Validation and parsing logic for date strings.\"\"\"\n    ISO_DATE_REGEX = r'^\\d{4}-\\d{2}-\\d{2}$'\n\n    def parse_iso(self, date_str: str) -> DateModel:\n        \"\"\"Parses a yyyy-mm-dd string into a DateModel.\"\"\"\n        if not re.match(self.ISO_DATE_REGEX, date_str):\n            raise DateFormatError(\"date must be in yyyy-mm-dd format\")\n        \n        y_str, m_str, d_str = date_str.split('-')\n        \n        try:\n            year = int(y_str)\n            month = int(m_str)\n            day = int(d_str)\n            return DateModel(year, month, day)\n        except ValueError:\n            raise DateFormatError(\"date components must be integers\")\n\nclass DateFormatterService:\n    \"\"\"Core business logic for formatting dates.\"\"\"\n    def __init__(self, validator: DateValidator) -> None:\n        self._validator = validator\n\n    def format(self, date_str: str) -> str:\n        \"\"\"Validates and formats a date string from yyyy-mm-dd to dd-mm-yyyy.\"\"\"\n        model = self._validator.parse_iso(date_str)\n        model.validate_semantics()\n        return self._to_dd_mm_yyyy(model)\n\n    def _to_dd_mm_yyyy(self, model: DateModel) -> str:\n        \"\"\"Converts a DateModel to dd-mm-yyyy format with zero-padding.\"\"\"\n        return f\"{model.day:02d}-{model.month:02d}-{model.year:04d}\"\n\nclass DateController:\n    \"\"\"Public API for date formatting.\"\"\"\n    def __init__(self, service: DateFormatterService) -> None:\n        self._service = service\n\n    def change_date_format(self, date_str: str) -> str:\n        \"\"\"Converts a date string from yyyy-mm-dd to dd-mm-yyyy.\"\"\"\n        return self._service.format(date_str)\n\n    def format_or_raise(self, date_str: str) -> str:\n        \"\"\"Alias for change_date_format.\"\"\"\n        return self.change_date_format(date_str)\n\ndef change_date_format(date_str: str) -> str:\n    \"\"\"\n    Converts a date of yyyy-mm-dd format to dd-mm-yyyy format.\n    Raises DateFormatError for invalid input format or invalid date values.\n    \"\"\"\n    validator = DateValidator()\n    service = DateFormatterService(validator)\n    controller = DateController(service)\n    return controller.change_date_format(date_str)"}
