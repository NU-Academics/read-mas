{"task_id": "Mbpp/630", "solution": "import collections\nfrom typing import List, Tuple\n\ndef get_coordinates(coord: Tuple[int, int]) -> List[List[int]]:\n    \"\"\"\n    Extracts all 8 adjacent coordinates and the coordinate itself for a given 2D integer coordinate.\n    Coordinates are returned in row-major order (x-axis change first, then y-axis change).\n    \"\"\"\n    x0, y0 = coord\n    result = []\n    for dx in (-1, 0, 1):\n        for dy in (-1, 0, 1):\n            x, y = x0 + dx, y0 + dy\n            result.append([x, y])\n    return result"}
{"task_id": "Mbpp/629", "solution": "from typing import Sequence, List, Any, Optional, Dict\nfrom datetime import datetime\nfrom abc import ABC, abstractmethod\n\ndef is_even(n: int) -> bool:\n    \"\"\"Checks if a number is even.\"\"\"\n    return (n % 2) == 0\n\nclass AuditEntry:\n    \"\"\"Represents an audit record of a Split function call.\"\"\"\n    def __init__(self, input: List[int], output: List[int]) -> None:\n        self.timestamp = datetime.now()\n        self.input = input\n        self.output = output\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Converts the audit entry to a dictionary for serialization.\"\"\"\n        return {\n            \"timestamp\": self.timestamp.isoformat(),\n            \"input\": self.input,\n            \"output\": self.output\n        }\n\nclass AuditRepository(ABC):\n    \"\"\"Abstract base class for audit logging repositories.\"\"\"\n    @abstractmethod\n    def save(self, entry: 'AuditEntry') -> None:\n        pass\n\n    @abstractmethod\n    def list_all(self) -> List['AuditEntry']:\n        pass\n\nclass InMemoryAuditRepository(AuditRepository):\n    \"\"\"An in-memory implementation of AuditRepository for transient storage.\"\"\"\n    def __init__(self) -> None:\n        self._entries: List[AuditEntry] = []\n\n    def save(self, entry: AuditEntry) -> None:\n        \"\"\"Saves an audit entry to the in-memory list.\"\"\"\n        self._entries.append(entry)\n\n    def list_all(self) -> List[AuditEntry]:\n        \"\"\"Returns a shallow copy of all stored audit entries.\"\"\"\n        return list(self._entries)\n\n    def clear(self) -> None:\n        \"\"\"Clears all entries from the repository.\"\"\"\n        self._entries.clear()\n\nclass EvenSplitter:\n    \"\"\"Core business logic for splitting even numbers and auditing calls.\"\"\"\n    def __init__(self, audit_repo: Optional[AuditRepository] = None) -> None:\n        self._audit_repo = audit_repo\n\n    def split(self, numbers: Sequence[int]) -> List[int]:\n        \"\"\"Filters a sequence of numbers, returning only the even ones.\"\"\"\n        evens = [n for n in numbers if is_even(n)]\n        if self._audit_repo is not None:\n            self._audit_repo.save(AuditEntry(list(numbers), evens))\n        return evens\n\nclass SplitController:\n    \"\"\"Controller for the Split API, coordinating validation and even number splitting.\"\"\"\n    def __init__(self, splitter: EvenSplitter) -> None:\n        self._splitter = splitter\n\n    def split_request(self, numbers: Sequence[int]) -> List[int]:\n        \"\"\"Processes a split request, returning even numbers.\"\"\"\n        return self._splitter.split(numbers)\n\n_default_audit_repo = InMemoryAuditRepository()\n_default_splitter = EvenSplitter(audit_repo=_default_audit_repo)\n_default_controller = SplitController(splitter=_default_splitter)\n\ndef Split(numbers: Sequence[int]) -> List[int]:\n    \"\"\"Finds and returns even numbers from a list.\"\"\"\n    return _default_controller.split_request(numbers)"}
{"task_id": "Mbpp/631", "solution": "import re\n\ndef replace_spaces(text: str) -> str:\n    \"\"\"\n    Replaces sequences of whitespaces with underscores, and vice versa.\n    The direction of transformation is inferred: if the string predominantly\n    contains underscores (and no spaces), it reverts them to spaces;\n    otherwise, it replaces all whitespace sequences with single underscores.\n    \"\"\"\n    num_spaces = text.count(' ')\n    num_underscores = text.count('_')\n\n    # If the string contains underscores and no spaces, assume it's already\n    # transformed and needs to be reverted.\n    if num_underscores > 0 and num_spaces == 0:\n        return text.replace('_', ' ')\n    else:\n        # Otherwise, replace all sequences of whitespace (including tabs, newlines)\n        # with a single underscore. This also handles cases with no underscores,\n        # or mixed spaces/underscores (prioritizing space replacement).\n        return re.sub(r'\\s+', '_', text)"}
{"task_id": "Mbpp/632", "solution": "```python\ndef move_zero(lst: list[int]) -> list[int]:\n    \"\"\"\n    Moves all zeroes in the list to the end while preserving the order of non-zero elements.\n    Returns a new list, leaving the original list unchanged.\n    \"\"\"\n    result: list[int] = []\n    zero_count = 0\n    for x in lst:\n        if x == 0:\n            zero_count += 1\n        else:\n            result.append(x)\n    result.extend([0] * zero_count)\n    return result\n```"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers, n_ignored_param):\n    \"\"\"\n    Calculates the sum of XOR of all pairs of numbers in the given list.\n    It uses a bitwise counting approach to efficiently sum the XOR values.\n    \"\"\"\n    bit_width = 32 # Default bit width as per design context\n\n    n = len(numbers)\n    if n < 2:\n        return 0\n\n    # Counts for each bit position how many numbers have that bit set.\n    counts = [0] * bit_width\n    mask = (1 << bit_width) - 1\n\n    for x in numbers:\n        x_masked = x & mask\n        for b in range(bit_width):\n            if (x_masked >> b) & 1: # Check if b-th bit is set\n                counts[b] += 1\n\n    # Computes the total sum from the bit counts.\n    # For each bit position 'b', if 'c' numbers have it set, then 'n - c' numbers have it unset.\n    # The pairs where this bit contributes to the XOR sum are those where one number has the bit set\n    # and the other has it unset. There are c * (n - c) such pairs.\n    # Each such pair contributes (1 << b) to the total sum for this bit position.\n    total = 0\n    for b, c in enumerate(counts):\n        total += c * (n - c) * (1 << b)\n\n    return total"}
