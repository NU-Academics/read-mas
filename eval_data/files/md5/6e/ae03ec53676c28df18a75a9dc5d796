{"task_id": "Mbpp/277", "solution": "from typing import Dict, Any, Optional\nimport json\nimport os\nimport tempfile\n\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass RepositoryError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass FilterCriteria:\n    def __init__(self, threshold: int) -> None:\n        self.threshold: int = threshold\n\nclass Utils:\n    @staticmethod\n    def coerce_value_to_int(value: Any) -> int:\n        \"\"\"Attempts to convert a value to an integer, raising InvalidInputError on failure.\"\"\"\n        try:\n            return int(value)\n        except (ValueError, TypeError) as e:\n            raise InvalidInputError(f\"Value {value!r} cannot be converted to an integer for comparison.\") from e\n\n    @staticmethod\n    def validate_dict(data: Any) -> Dict[str, int]:\n        \"\"\"Validates input data as a dictionary and coerces keys to str and values to int.\"\"\"\n        if not isinstance(data, dict):\n            raise InvalidInputError(f\"Input data must be a dictionary, but got {type(data).__name__}.\")\n        \n        validated_data = {}\n        for key, value in data.items():\n            str_key = str(key)\n            int_value = Utils.coerce_value_to_int(value)\n            validated_data[str_key] = int_value\n        return validated_data\n\n    @staticmethod\n    def validate_threshold(n: Any) -> int:\n        \"\"\"Validates the threshold input, coercing it to an integer.\"\"\"\n        try:\n            return int(n)\n        except (ValueError, TypeError) as e:\n            raise InvalidInputError(f\"Threshold {n!r} is not an integer or cannot be converted to an integer.\") from e\n\nclass DictRepository:\n    def __init__(self) -> None:\n        pass\n\n    def filter(self, data: Dict[str, int], threshold: int, persist_path: Optional[str] = None) -> Dict[str, int]:\n        \"\"\"Filters the dictionary to include entries with values greater than or equal to the threshold.\"\"\"\n        result = {k: v for k, v in data.items() if v >= threshold}\n        \n        if persist_path:\n            self._persist_to_json(persist_path, result)\n        \n        return result\n\n    def _persist_to_json(self, path: str, payload: Dict[str, int]) -> None:\n        \"\"\"Persists a dictionary to a JSON file using an atomic write.\"\"\"\n        try:\n            fd, temp_path = tempfile.mkstemp(dir=os.path.dirname(path), prefix=os.path.basename(path) + '.tmp_')\n            with os.fdopen(fd, 'w', encoding='utf-8') as f:\n                json.dump(payload, f, indent=4)\n            os.replace(temp_path, path)\n        except (IOError, OSError, json.JSONDecodeError) as e:\n            raise RepositoryError(f\"Failed to persist data to {path!r}: {e}\") from e\n\nclass DictFilterService:\n    def __init__(self, repository: DictRepository) -> None:\n        self.repository = repository\n\n    def filter(self, data: Any, criteria: FilterCriteria, persist_path: Optional[str] = None) -> Dict[str, int]:\n        \"\"\"Orchestrates validation and delegates filtering to the repository.\"\"\"\n        validated_data = Utils.validate_dict(data)\n        threshold = Utils.validate_threshold(criteria.threshold)\n        \n        return self.repository.filter(validated_data, threshold, persist_path)\n\nclass DictFilterController:\n    def __init__(self, service: DictFilterService) -> None:\n        self.service = service\n\n    def filter(self, data: Any, n: Any, persist_path: Optional[str] = None) -> Dict[str, int]:\n        \"\"\"Provides a convenience method to filter data, converting n to FilterCriteria.\"\"\"\n        criteria = FilterCriteria(threshold=n)\n        return self.service.filter(data, criteria, persist_path)\n\n    def filter_and_print(self, data: Any, n: Any, persist_path: Optional[str] = None) -> None:\n        \"\"\"Calls the filter logic and prints the result or an error message.\"\"\"\n        try:\n            filtered = self.filter(data, n, persist_path)\n            print(filtered)\n        except (InvalidInputError, RepositoryError) as e:\n            print(f\"Error: {e.message}\")\n\n_default_repository = DictRepository()\n_default_service = DictFilterService(repository=_default_repository)\n_default_controller = DictFilterController(service=_default_service)\n\ndef dict_filter(data: Dict[str, int], n: int) -> Dict[str, int]:\n    \"\"\"Filters a dictionary to include only entries with values greater than or equal to n.\"\"\"\n    return _default_controller.filter(data, n)"}
{"task_id": "Mbpp/280", "solution": "from typing import List, Any, Tuple\n\ndef sequential_search(array: List[Any], element: Any) -> Tuple[bool, int]:\n    \"\"\"\n    Searches for an element in an array using a sequential search.\n    Returns a tuple (found: bool, index: int) indicating if the element\n    is present and its index, or -1 if not found.\n    \"\"\"\n    for index, item in enumerate(array):\n        if item == element:\n            return (True, index)\n    return (False, -1)"}
{"task_id": "Mbpp/279", "solution": "import math\n\ndef is_num_decagonal(n: int) -> int:\n    # Validate n based on the design context.\n    # The design context indicates `validate_n` raises `ValueError`.\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer >= 1\")\n\n    # Compute the nth decagonal number using the formula D_n = 4*n^2 - 3*n.\n    return 4 * n * n - 3 * n"}
{"task_id": "Mbpp/283", "solution": "import collections\n\ndef validate(number: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in the integer is less than or equal to the digit itself.\n    The absolute value of the number is used for validation.\n    \"\"\"\n    abs_number = abs(number)\n    \n    # Extract digits from the number\n    if abs_number == 0:\n        digits = [0]\n    else:\n        digits = []\n        temp_num = abs_number\n        while temp_num > 0:\n            digits.append(temp_num % 10)\n            temp_num //= 10\n        # No need to reverse for frequency counting\n        \n    # Count frequency of each digit\n    digit_counts = collections.Counter(digits)\n    \n    # Check the condition for each digit\n    for digit, count in digit_counts.items():\n        if count > digit:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/284", "solution": "def check_element(list, element):\n    \"\"\"\n    Checks if all items in the given list are equal to the specified element.\n    Returns True if the list is empty, per business rule.\n    \"\"\"\n    if not list:\n        return True\n    for item in list:\n        if item != element:\n            return False\n    return True"}
{"task_id": "Mbpp/282", "solution": "from typing import Any, Sequence\n\nclass ListSubtractorError(Exception):\n    \"\"\"Base exception for list subtractor operations.\"\"\"\n    pass\n\nclass InvalidInputError(ListSubtractorError):\n    \"\"\"Raised when an input value is invalid or cannot be coerced.\"\"\"\n    def __init__(self, message: str, invalid_value: Any = None):\n        super().__init__(message)\n        self.invalid_value = invalid_value\n\nclass LengthMismatchError(ListSubtractorError):\n    \"\"\"Raised when input lists have different lengths.\"\"\"\n    def __init__(self, len_a: int, len_b: int, message: str = \"Input lists must have the same length.\"):\n        super().__init__(message)\n        self.len_a = len_a\n        self.len_b = len_b\n\ndef to_number(value: Any) -> float:\n    \"\"\"Coerces a value to float, raising InvalidInputError if unsuccessful.\"\"\"\n    try:\n        return float(value)\n    except (ValueError, TypeError) as e:\n        raise InvalidInputError(f\"Could not convert '{value}' to a number.\", invalid_value=value) from e\n\nclass ListValidator:\n    \"\"\"Validates and coerces input sequences to lists of floats.\"\"\"\n    def validate(self, a: Sequence[Any], b: Sequence[Any]) -> tuple[list[float], list[float]]:\n        \"\"\"Validates and converts two sequences to lists of floats.\"\"\"\n        a_list = self._validate_sequence(a, \"a\")\n        b_list = self._validate_sequence(b, \"b\")\n        return a_list, b_list\n\n    def _validate_sequence(self, seq: Sequence[Any], name: str) -> list[float]:\n        \"\"\"Validates a single sequence and coerces its elements to floats.\"\"\"\n        if not isinstance(seq, (list, tuple)):\n            raise InvalidInputError(f\"Input '{name}' is not a list or tuple.\", invalid_value=seq)\n        out = []\n        for i, v in enumerate(seq):\n            try:\n                out.append(to_number(v))\n            except InvalidInputError as e:\n                # Re-raise with more context, preserving original invalid_value\n                raise InvalidInputError(f\"Element {name}[{i}] invalid: {e.args[0]}\", invalid_value=e.invalid_value) from e\n        return out\n\nclass ListSubtractService:\n    \"\"\"Performs element-wise subtraction of two lists of floats.\"\"\"\n    def subtract(self, a: list[float], b: list[float]) -> list[float]:\n        \"\"\"Subtracts list b from list a element-wise.\"\"\"\n        if len(a) != len(b):\n            raise LengthMismatchError(len_a=len(a), len_b=len(b))\n        return [ai - bi for ai, bi in zip(a, b)]\n\ndef sub_list(a: Sequence[Any], b: Sequence[Any]) -> list[float]:\n    \"\"\"\n    Subtracts two lists element-wise after validating and coercing inputs.\n    \"\"\"\n    validator = ListValidator()\n    a_norm, b_norm = validator.validate(a, b)\n    service = ListSubtractService()\n    return service.subtract(a_norm, b_norm)"}
{"task_id": "Mbpp/281", "solution": "from typing import Iterable, Any, TypeVar, Optional, Generic\nimport collections\nfrom dataclasses import dataclass\n\n# Define TypeVar for generic types\nT = TypeVar('T')\n\n# --- exceptions.py ---\nclass UniqueCheckError(Exception):\n    \"\"\"Custom exception for errors during uniqueness checks.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\n# --- models.py ---\n@dataclass\nclass AllUniqueResult:\n    \"\"\"Result of uniqueness check, including diagnostics.\"\"\"\n    unique: bool\n    checked_len: int\n    duplicates: list[Any]\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the result to a serializable dictionary.\"\"\"\n        return {\n            \"unique\": self.unique,\n            \"checked_len\": self.checked_len,\n            \"duplicates\": self.duplicates,\n        }\n\nDEFAULT_DUPLICATE_SAMPLE: int = 10\n\n# --- utils.py ---\ndef is_hashable(obj: Any) -> bool:\n    \"\"\"Checks if an object is hashable.\"\"\"\n    try:\n        hash(obj)\n        return True\n    except TypeError:\n        return False\n\ndef find_duplicates(items: Iterable[Any], max_sample: int = DEFAULT_DUPLICATE_SAMPLE) -> list[Any]:\n    \"\"\"\n    Finds up to `max_sample` duplicate elements in an iterable.\n    Handles both hashable and unhashable items.\n    \"\"\"\n    duplicates_found: list[Any] = []\n    item_list = list(items) # Convert to list to allow multiple iterations and indexing\n\n    # Attempt hash-based approach first\n    try:\n        seen_counts = collections.Counter(item_list)\n        for item, count in seen_counts.items():\n            if count > 1:\n                duplicates_found.append(item)\n            if len(duplicates_found) >= max_sample:\n                return duplicates_found\n    except TypeError:\n        # Fallback to brute-force for unhashable items\n        n = len(item_list)\n        processed_indices = set() # Track indices of items already identified as duplicates\n\n        for i in range(n):\n            if i in processed_indices:\n                continue\n            \n            is_current_item_duplicate = False\n            for j in range(i + 1, n):\n                if item_list[i] == item_list[j]:\n                    if not is_current_item_duplicate:\n                        duplicates_found.append(item_list[i])\n                        is_current_item_duplicate = True\n                    processed_indices.add(j) # Mark subsequent occurrences of this duplicate\n\n                    if len(duplicates_found) >= max_sample:\n                        return duplicates_found\n            \n            if is_current_item_duplicate:\n                processed_indices.add(i) # Mark the first occurrence as processed if it's a duplicate\n    \n    return duplicates_found\n\ndef ensure_iterable(obj: Any) -> Iterable[Any]:\n    \"\"\"Ensures an object is an iterable, raising UniqueCheckError if not.\"\"\"\n    if not isinstance(obj, collections.abc.Iterable):\n        raise UniqueCheckError(f\"Input must be an iterable, but received {type(obj).__name__}\")\n    return obj\n\n# --- strategies.py ---\nclass UniqueChecker(Generic[T]):\n    \"\"\"Abstract interface for uniqueness checking strategies.\"\"\"\n    def is_unique(self, items: Iterable[T]) -> bool:\n        raise NotImplementedError\n\nclass HashSetStrategy(UniqueChecker[T]):\n    \"\"\"An efficient uniqueness strategy using a hash set.\"\"\"\n    name: str = \"hashset\"\n\n    def is_unique(self, items: Iterable[T]) -> bool:\n        seen = set()\n        for i in items:\n            try:\n                if i in seen:\n                    return False\n                seen.add(i)\n            except TypeError:\n                raise UniqueCheckError(\"Unhashable item encountered, cannot use HashSetStrategy\")\n        return True\n\nclass BruteForceStrategy(UniqueChecker[T]):\n    \"\"\"A robust uniqueness strategy using pairwise comparison, handles unhashable items.\"\"\"\n    name: str = \"bruteforce\"\n\n    def is_unique(self, items: Iterable[T]) -> bool:\n        item_list = list(items) # Convert to list for indexing\n        n = len(item_list)\n        for i in range(n):\n            for j in range(i + 1, n):\n                if item_list[i] == item_list[j]:\n                    return False\n        return True\n\n# --- service.py ---\nclass AllUniqueService:\n    \"\"\"Orchestrates uniqueness checks, including strategy selection and fallback mechanisms.\"\"\"\n    def __init__(self, default_strategy: Optional[UniqueChecker[Any]] = None) -> None:\n        self._default_strategy = default_strategy or HashSetStrategy()\n\n    def check_all_unique(\n        self,\n        items: Iterable[T],\n        strategy: Optional[UniqueChecker[T]] = None,\n        duplicate_sample: int = DEFAULT_DUPLICATE_SAMPLE\n    ) -> AllUniqueResult:\n        \"\"\"\n        Performs a uniqueness check on the given items.\n        Automatically falls back to BruteForceStrategy if hash-based strategy fails due to unhashable items.\n        \"\"\"\n        items_validated = ensure_iterable(items)\n        item_list = list(items_validated) # Convert to list to ensure multiple traversals or indexing is safe\n        checked_len = len(item_list)\n\n        active_strategy = strategy if strategy is not None else self._default_strategy\n        \n        is_unique_result = False\n        try:\n            is_unique_result = active_strategy.is_unique(item_list)\n        except UniqueCheckError as e:\n            if \"Unhashable item encountered\" in e.message:\n                # Fallback to brute force if default/chosen strategy failed due to unhashability\n                fallback_strategy = BruteForceStrategy()\n                is_unique_result = fallback_strategy.is_unique(item_list)\n            else:\n                raise # Re-raise other types of UniqueCheckError\n\n        duplicates: list[Any] = []\n        if not is_unique_result:\n            # Only find duplicates if the items are not unique\n            duplicates = find_duplicates(item_list, max_sample=duplicate_sample)\n\n        return AllUniqueResult(unique=is_unique_result, checked_len=checked_len, duplicates=duplicates)\n\n# --- controller.py ---\nclass AllUniqueController:\n    \"\"\"Provides a programmatic interface for uniqueness checks.\"\"\"\n    def __init__(self, service: Optional[AllUniqueService] = None) -> None:\n        self._service = service or AllUniqueService()\n\n    def handle(self, items: Iterable[Any], strategy: Optional[UniqueChecker[Any]] = None, sample: int = DEFAULT_DUPLICATE_SAMPLE) -> AllUniqueResult:\n        \"\"\"Delegates to AllUniqueService to perform the uniqueness check.\"\"\"\n        return self._service.check_all_unique(items, strategy=strategy, duplicate_sample=sample)\n\ndef all_unique(items: Iterable[Any]) -> bool:\n    \"\"\"\n    Checks if all elements in the given iterable are unique.\n    Uses an optimized strategy (hash-based) with fallback for unhashable items.\n    \"\"\"\n    controller = AllUniqueController()\n    return controller.handle(items).unique"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of squares of the first n even natural numbers using a closed-form formula.\"\"\"\n    # The formula is 4 * sum_{k=1..n} k^2 = 4 * n * (n + 1) * (2 * n + 1) // 6\n    return (4 * n * (n + 1) * (2 * n + 1)) // 6"}
{"task_id": "Mbpp/290", "solution": "from typing import List, Any, Tuple, Sequence\n\ndef max_length(lists: Sequence[Sequence[Any]]) -> Tuple[int, Sequence[Any]]:\n    \"\"\"\n    Finds the list with the maximum length in a list of lists.\n    Returns a tuple containing the maximum length and the first list encountered with that length.\n    \"\"\"\n    max_len = 0\n    chosen_list: Sequence[Any] = []\n\n    for sublist in lists:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            chosen_list = sublist\n            \n    return (max_len, chosen_list)"}
