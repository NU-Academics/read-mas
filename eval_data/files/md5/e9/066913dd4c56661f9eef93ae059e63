{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Transforms an input string by inserting spaces before capital letters\n    that are immediately preceded by a lowercase letter.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    result = []\n    for i, char in enumerate(input_string):\n        if i > 0 and char.isupper() and input_string[i-1].islower():\n            result.append(' ')\n        result.append(char)\n    return \"\".join(result)"}
{"task_id": "Mbpp/745", "solution": "def _get_digits_extract(num: int) -> list[int]:\n    \"\"\"Extracts individual digits from a number into a list.\"\"\"\n    return [int(char) for char in str(num)]\ndef _has_zero_digit_check(digits: list[int]) -> bool:\n    \"\"\"Checks if any digit in the list is zero.\"\"\"\n    for digit in digits:\n        if digit == 0:\n            return True\n    return False\ndef _is_divisible_by_all_digits_check(num: int, digits: list[int]) -> bool:\n    \"\"\"Checks if a number is perfectly divisible by all its digits.\"\"\"\n    for digit in digits:\n        if num % digit != 0:\n            return False\n    return True\ndef _is_divisible_by_its_digits_check(num: int) -> bool:\n    \"\"\"Orchestrates checks to determine if a number meets all criteria.\"\"\"\n    digits = _get_digits_extract(num)\n    if _has_zero_digit_check(digits):\n        return False\n    return _is_divisible_by_all_digits_check(num, digits)\ndef divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a range that are divisible by all their non-zero digits.\n    This function iterates through the range and applies divisibility checks.\n    \"\"\"\n    collected_numbers = []\n    for num in range(startnum, endnum + 1):\n        if _is_divisible_by_its_digits_check(num):\n            collected_numbers.append(num)\n    return collected_numbers"}
