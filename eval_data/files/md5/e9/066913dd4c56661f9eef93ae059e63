{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"Counts pairs of strings where one is the reverse of the other in a list.\n    Each unique pair is counted only once.\"\"\"\n    reverse_pair_count = 0\n    unmatched_strings = set()\n\n    for word in string_list:\n        reversed_word = word[::-1]\n        if reversed_word in unmatched_strings:\n            reverse_pair_count += 1\n            unmatched_strings.remove(reversed_word)\n        else:\n            unmatched_strings.add(word)\n\n    return reverse_pair_count"}
{"task_id": "Mbpp/757", "solution": "from typing import List\ndef _reverse_string(s: str) -> str:\n    \"\"\"Reverses the input string.\"\"\"\n    return s[::-1]\ndef count_reverse_pairs(string_list: List[str]) -> int:\n    \"\"\"\n    Counts unique reverse string pairs in a list.\n    A pair (S1, S2) is counted if S1 is the reverse of S2 and S1 != S2.\n    \"\"\"\n    seen_for_reverse_check = set()\n    pair_count = 0\n\n    for s in string_list:\n        reversed_s = _reverse_string(s)\n\n        if reversed_s in seen_for_reverse_check and s != reversed_s:\n            pair_count += 1\n            seen_for_reverse_check.remove(reversed_s)\n        elif s not in seen_for_reverse_check and s != reversed_s:\n            seen_for_reverse_check.add(s)\n\n    return pair_count"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(list_of_lists: list[list]) -> dict[tuple, int]:\n    \"\"\"\n    Converts inner lists to tuples, counts their occurrences, and returns\n    a dictionary of unique tuples to their counts.\n    Args: list_of_lists: A list of lists, where each inner list contains hashable elements.\n    \"\"\"\n    counts = {}\n    for sublist in list_of_lists:\n        current_tuple = tuple(sublist)\n        counts[current_tuple] = counts.get(current_tuple, 0) + 1\n    return counts"}
