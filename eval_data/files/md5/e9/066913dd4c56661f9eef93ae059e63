{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"Calculates the nth Jacobsthal number recursively.\n    Handles base cases for n=0 and n=1, and applies the recursive formula for n > 1.\"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        return jacobsthal_num(n - 1) + 2 * jacobsthal_num(n - 2)"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    Returns True if it's a min-heap, False otherwise.\n    \"\"\"\n    array_size = len(arr)\n\n    # Edge cases: empty or single-element arrays are considered min-heaps.\n    if array_size <= 1:\n        return True\n\n    # Iterate only through non-leaf nodes.\n    # The last non-leaf node is at index (array_size // 2) - 1.\n    for i in range(array_size // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < array_size:\n            if arr[i] > arr[left_child_idx]:\n                return False\n\n        # Check right child\n        if right_child_idx < array_size:\n            if arr[i] > arr[right_child_idx]:\n                return False\n\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"Calculates the nth Jacobsthal number.\n    It uses an iterative approach based on the recurrence relation J(n) = J(n-1) + 2 * J(n-2).\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n\n    j_n_minus_2 = 0  # Represents J(0) initially\n    j_n_minus_1 = 1  # Represents J(1) initially\n\n    for _ in range(2, n + 1):\n        current_j = j_n_minus_1 + 2 * j_n_minus_2\n        j_n_minus_2 = j_n_minus_1\n        j_n_minus_1 = current_j\n\n    return j_n_minus_1"}
{"task_id": "Mbpp/753", "solution": "from typing import List, Tuple, Any\ndef min_k(tuple_list: List[Tuple[Any, Any]], k: int) -> List[Tuple[Any, Any]]:\n    \"\"\"\n    Identifies and returns the k records with the smallest second element\n    from a given list of tuples, sorted in ascending order.\n    \"\"\"\n    if not tuple_list or k <= 0:\n        return []\n\n    # Sort the list based on the second element of each tuple.\n    sorted_list = sorted(tuple_list, key=lambda x: x[1])\n\n    # Return exactly k tuples, or fewer if the list has less than k elements.\n    return sorted_list[:k]"}
{"task_id": "Mbpp/753", "solution": "def min_k(tuple_list: list[tuple], k: int) -> list[tuple]:\n    \"\"\"Finds the k records with the smallest values from a list of tuples.\"\"\"\n    # Sort the list based on the second element of each tuple and return the first k.\n    sorted_list = sorted(tuple_list, key=lambda x: x[1])\n    return sorted_list[:k]"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a valid min-heap.\n    It verifies that every parent node is less than or equal to its children.\n    \"\"\"\n    n = len(arr)\n\n    # An array with 0 or 1 element is always a min-heap.\n    if n <= 1:\n        return True\n\n    # Iterate only through parent nodes.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child if it exists.\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        # Check right child if it exists.\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    # If no violations were found, it's a min-heap.\n    return True"}
