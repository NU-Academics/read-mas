{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(number: int) -> bool:\n    \"\"\"\n    Checks if the given number can be represented as the sum of distinct non-zero powers of 2.\n    A non-zero power of 2 is 2^n where n > 0 (e.g., 2, 4, 8, ...).\n    \"\"\"\n    if number <= 0:\n        return False\n\n    if number % 2 != 0:\n        return False\n\n    set_bits_count = bin(number).count('1')\n    if set_bits_count <= 1: # A single set bit means it's a power of 2 itself, not a sum of other distinct powers.\n        return False\n\n    return True"}
{"task_id": "Mbpp/137", "solution": "def zero_count(array_of_integers: list[int]) -> float:\n    \"\"\"Calculates the ratio of zero elements to non-zero elements in an array of integers.\n    Handles empty arrays and arrays with no non-zero elements by returning 0.0.\"\"\"\n\n    if not array_of_integers:\n        return 0.0\n\n    zero_elements_count = 0\n    non_zero_elements_count = 0\n\n    for element in array_of_integers:\n        if element == 0:\n            zero_elements_count += 1\n        else:\n            non_zero_elements_count += 1\n\n    if non_zero_elements_count == 0:\n        return 0.0\n    else:\n        return zero_elements_count / non_zero_elements_count"}
{"task_id": "Mbpp/130", "solution": "from collections import Counter\nfrom typing import Any\ndef max_occurrences(input_list: list) -> Any:\n    \"\"\"\n    Determines and returns the item with the maximum frequency from an input list.\n    In case of a tie, one of the items with maximum frequency is returned.\n    \"\"\"\n    frequencies = Counter(input_list)\n\n    if not frequencies:\n        return None  # Or raise an error, depending on desired behavior for empty lists\n\n    max_item = None\n    max_count = -1\n\n    for item, count in frequencies.items():\n        if count > max_count:\n            max_count = count\n            max_item = item\n\n    return max_item"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(number: int) -> bool:\n    \"\"\"\n    Checks if a non-negative integer can be represented as a sum of non-zero powers of 2.\n    This means the number must be greater than 1 and be an even number.\n    \"\"\"\n    return number > 1 and number % 2 == 0"}
