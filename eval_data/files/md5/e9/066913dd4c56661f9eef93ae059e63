{"task_id": "Mbpp/3", "solution": "import math\ndef is_not_prime(number: int) -> bool:\n    \"\"\"Checks if a number is non-prime. Returns True for non-primes and False for primes.\"\"\"\n    if number <= 1:\n        return True  # Numbers less than or equal to 1 are not prime.\n    if number == 2:\n        return False # The number 2 is prime.\n    if number % 2 == 0:\n        return True  # Even numbers greater than 2 are non-prime.\n\n    # Check for odd divisors starting from 3 up to the square root of the number.\n    limit = int(math.isqrt(number)) + 1\n    for i in range(3, limit, 2):\n        if number % i == 0:\n            return True # Found a divisor, so the number is non-prime.\n\n    return False # No divisors found, indicating the number is prime."}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two integers differ at exactly one bit position.\n    Returns True if only one bit differs, False otherwise.\n    \"\"\"\n    xor_result = num1 ^ num2\n    # A number has exactly one set bit if it's positive and (num & (num - 1)) is 0.\n    return xor_result > 0 and (xor_result & (xor_result - 1)) == 0"}
{"task_id": "Mbpp/3", "solution": "import math\ndef is_not_prime(number: int) -> bool:\n    \"\"\"Determines if an integer is a non-prime number.\n    Returns True for non-prime numbers (including numbers less than or equal to 1) and False for prime numbers.\"\"\"\n    if number <= 1:\n        return True  # Numbers less than or equal to 1 are considered non-prime.\n\n    # Iterate from 2 up to the integer square root of the number to check for divisors.\n    for i in range(2, math.isqrt(number) + 1):\n        if number % i == 0:\n            return True  # If a divisor is found, the number is not prime.\n\n    return False  # If no divisors are found, the number is prime."}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two integers differ at exactly one bit position.\n    Calculates XOR, then counts set bits in the result.\n    \"\"\"\n    xor_result = num1 ^ num2\n    set_bits_count = 0\n    while xor_result > 0:\n        xor_result &= (xor_result - 1)\n        set_bits_count += 1\n    return set_bits_count == 1"}
{"task_id": "Mbpp/4", "solution": "from typing import List, Union\nimport heapq\nNumeric = Union[int, float]\ndef _select_and_sort(numbers: List[Numeric], n: int) -> List[Numeric]:\n    \"\"\"\n    Identifies and sorts the n largest numbers from the list.\n    It uses heapq.nlargest for efficiency and ensures descending order.\n    \"\"\"\n    if not numbers:\n        return []\n\n    # BR2: If the list contains fewer than 'n' numbers, all numbers are considered.\n    # This also covers cases where 'n' is larger than or equal to the list size.\n    if n >= len(numbers):\n        # Sort all numbers in descending order as per FR3 and BR3.\n        return sorted(numbers, reverse=True)\n    else:\n        # FR2: Efficiently find the n largest numbers using a min-heap (heapq).\n        # heapq.nlargest inherently returns elements in descending order (FR3, BR3).\n        return heapq.nlargest(n, numbers)\ndef heap_queue_largest(numbers: List[Numeric], n: int) -> List[Numeric]:\n    \"\"\"\n    Finds the n largest integers from a list, returned in descending order.\n    It orchestrates validation, edge case handling, and selection/sorting.\n    \"\"\"\n    # Call internal validation as per design; it's a no-op per critical requirements.\n    _validate_inputs(n)\n\n    # Handle edge cases: if 'n' is 0 or negative, or if the input list is empty.\n    # This covers n=0 (AF2) and negative n (critical requirement: no exception, return empty).\n    if n <= 0 or not numbers:\n        return []\n\n    # Call the helper function to identify and sort the largest numbers.\n    return _select_and_sort(numbers, n)"}
