{"task_id": "Mbpp/96", "solution": "def divisor(integer_value: int) -> int:\n    \"\"\"Calculates the number of positive divisors for a given integer.\n    Returns 0 for non-positive integers as per design specification.\n    \"\"\"\n    if integer_value <= 0:\n        return 0\n\n    count = 0\n    # Iterate from 1 up to the square root of integer_value (inclusive).\n    for i in range(1, int(integer_value**0.5) + 1):\n        if integer_value % i == 0:\n            if i * i == integer_value:\n                count += 1\n            else:\n                count += 2\n    return count"}
{"task_id": "Mbpp/97", "solution": "from collections import Counter\nfrom typing import Any, List, Dict\ndef frequency_lists(input_list_of_lists: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n    Returns a dictionary where keys are unique elements and values are their frequencies.\n    \"\"\"\n    flattened_list = [item for sublist in input_list_of_lists for item in sublist]\n    frequency_map = Counter(flattened_list)\n    return frequency_map"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"Converts a non-negative integer decimal number to its binary string representation.\n    The binary string will not have leading zeros, unless the number itself is 0.\"\"\"\n    if decimal_number == 0:\n        return \"0\"\n\n    binary_digits = []\n    while decimal_number > 0:\n        remainder = decimal_number % 2\n        binary_digits.append(str(remainder))\n        decimal_number //= 2\n\n    return \"\".join(binary_digits[::-1])"}
{"task_id": "Mbpp/98", "solution": "from typing import Collection, Union\ndef multiply_num(numbers: Collection[Union[int, float]]) -> float:\n    \"\"\"Calculates the product of numbers in a collection divided by its length.\n    Returns float('nan') if the collection is empty to handle division by zero.\"\"\"\n\n    if not numbers:\n        return float('nan')\n\n    product = 1.0\n    for num in numbers:\n        product *= num\n\n    collection_length = len(numbers)\n\n    return product / collection_length"}
{"task_id": "Mbpp/97", "solution": "from typing import List, Any, Dict\nimport collections\nimport itertools\ndef frequency_lists(list_of_lists: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists.\n\n    Args:\n        list_of_lists: A list of lists, where each inner list contains elements of any type.\n\n    Returns:\n        A dictionary where keys are the unique elements from the flattened list\n        and values are their corresponding frequencies.\n    \"\"\"\n    # Flatten the list of lists using itertools.chain.from_iterable\n    flattened_list = list(itertools.chain.from_iterable(list_of_lists))\n\n    # Calculate frequencies using collections.Counter\n    frequency_map = collections.Counter(flattened_list)\n\n    return dict(frequency_map)"}
