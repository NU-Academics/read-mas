{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers: list[int]) -> int | None:\n    \"\"\"\n    Calculates the product of the first even and first odd numbers found in a list.\n    Returns None if either number is not found.\n    \"\"\"\n    first_odd = None\n    first_even = None\n\n    for number in numbers:\n        if first_odd is None and number % 2 != 0:\n            first_odd = number\n        if first_even is None and number % 2 == 0:\n            first_even = number\n\n        if first_odd is not None and first_even is not None:\n            break\n\n    if first_odd is not None and first_even is not None:\n        return first_odd * first_even\n    else:\n        return None"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list, value):\n    \"\"\"\n    Locates the right insertion point for a value in a sorted list using binary search.\n    The returned index ensures all elements before it are less than or equal to the value.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = low + (high - low) // 2\n        if sorted_list[mid] <= value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_string: str) -> tuple[int, ...]:\n    \"\"\"Converts a string representation of an integer tuple into a native integer tuple.\n    Assumes valid input string format for direct conversion.\n    \"\"\"\n    if tuple_string == \"()\":\n        return ()\n\n    # Remove leading '(' and trailing ')'\n    content = tuple_string[1:-1]\n\n    # Split by comma and process each element\n    elements_str = content.split(',')\n    result_list = []\n    for element_s in elements_str:\n        # Strip whitespace and convert to integer\n        result_list.append(int(element_s.strip()))\n\n    return tuple(result_list)"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(input_string: str) -> tuple:\n    \"\"\"\n    Converts a string representation of an integer tuple into an actual tuple of integers.\n    Handles parentheses removal, splitting by commas, and integer conversion.\n    \"\"\"\n    content = input_string.strip('()')\n\n    if not content.strip():\n        return ()\n\n    number_strings = [s.strip() for s in content.split(',')]\n    integers = [int(s) for s in number_strings]\n\n    return tuple(integers)"}
{"task_id": "Mbpp/772", "solution": "import re\ndef _split_string_into_tokens(text: str) -> list[tuple[str, str]]:\n    \"\"\"Parses a string into a list of (token_value, token_type) tuples.\n    Matches sequences of word or non-word characters for categorization.\n    \"\"\"\n    tokens = []\n    pattern = re.compile(r'(\\w+)|(\\W+)')\n\n    for match in pattern.finditer(text):\n        word_part = match.group(1)\n        delimiter_part = match.group(2)\n        if word_part is not None:\n            tokens.append((word_part, 'word'))\n        elif delimiter_part is not None:\n            tokens.append((delimiter_part, 'delimiter'))\n    return tokens\ndef remove_length(input_string: str, k: int) -> str:\n    \"\"\"Removes words of a specific length from the input string.\n    It tokenizes, filters, and then joins the remaining parts.\n    \"\"\"\n    tokens = _split_string_into_tokens(input_string)\n    result_tokens = []\n\n    for token_value, token_type in tokens:\n        if token_type == 'word':\n            if len(token_value) != k:\n                result_tokens.append(token_value)\n        elif token_type == 'delimiter':\n            result_tokens.append(token_value)\n\n    return \"\".join(result_tokens).strip()"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers_list):\n    \"\"\"\n    Calculates the product of the first even and first odd number found in the list.\n    If a type of number is not found, its value defaults to 0 for the product calculation.\n    \"\"\"\n    first_even_val = 0\n    first_odd_val = 0\n    found_first_even = False\n    found_first_odd = False\n\n    for number in numbers_list:\n        # Identify the first even number if not already found\n        if not found_first_even and number % 2 == 0:\n            first_even_val = number\n            found_first_even = True\n\n        # Identify the first odd number if not already found\n        if not found_first_odd and number % 2 != 0:\n            first_odd_val = number\n            found_first_odd = True\n\n        # Optimization: stop iterating once both an even and an odd number are found\n        if found_first_even and found_first_odd:\n            break\n\n    # Calculate and return the product, ensuring the result is an integer\n    return int(first_even_val * first_odd_val)"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list: list, value) -> int:\n    \"\"\"Finds the rightmost insertion point for a value in a sorted list.\n    This uses a binary search algorithm to achieve O(log n) time complexity.\"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] <= value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
