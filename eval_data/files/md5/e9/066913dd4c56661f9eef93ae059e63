{"task_id": "Mbpp/721", "solution": "class Cell:\n    \"\"\"Stores coordinates and cost of a matrix element.\"\"\"\n    def __init__(self, row: int, col: int, cost: float):\n        self.row = row\n        self.col = col\n        self.cost = cost\nclass Path:\n    \"\"\"Manages a sequence of cells, calculates its total cost, cell count, and average cost.\"\"\"\n    def __init__(self, cells: list[Cell]):\n        self._cells = list(cells)  # Store a copy to prevent external modification.\n        self._total_cost = sum(cell.cost for cell in self._cells)\n        self._num_cells = len(self._cells)\n\n    def get_cells(self) -> list[Cell]:\n        \"\"\"Returns the list of cells in the path.\"\"\"\n        return self._cells\n\n    def get_total_cost(self) -> float:\n        \"\"\"Returns the total cost of the path.\"\"\"\n        return self._total_cost\n\n    def get_num_cells(self) -> int:\n        \"\"\"Returns the number of cells in the path.\"\"\"\n        return self._num_cells\n\n    def calculate_average(self) -> float:\n        \"\"\"Computes and returns the average cost of the path.\"\"\"\n        if self._num_cells == 0:\n            return 0.0\n        return self._total_cost / self._num_cells\ndef _find_all_paths_recursive(\n    matrix_of_cells: list[list[Cell]],\n    r: int,\n    c: int,\n    current_path_cells: list[Cell],\n    all_paths: list[Path],\n    N: int\n) -> None:\n    \"\"\"Recursive helper to explore paths from a given cell.\"\"\"\n    if r >= N or c >= N: # Base case: out of bounds.\n        return\n\n    current_path_cells.append(matrix_of_cells[r][c])\n\n    if r == N - 1 and c == N - 1: # Base case: reached bottom-right cell.\n        all_paths.append(Path(current_path_cells))\n    else:\n        _find_all_paths_recursive(matrix_of_cells, r, c + 1, current_path_cells, all_paths, N) # Move right.\n        _find_all_paths_recursive(matrix_of_cells, r + 1, c, current_path_cells, all_paths, N) # Move down.\n\n    current_path_cells.pop() # Backtrack: remove current cell.\ndef find_all_paths(matrix_data: list[list[float]]) -> list[Path]:\n    \"\"\"Orchestrates the path discovery process.\"\"\"\n    N = len(matrix_data)\n    if N == 0:\n        return []\n\n    matrix_of_cells = []\n    for r in range(N):\n        row_of_cells = []\n        for c in range(N):\n            row_of_cells.append(Cell(r, c, float(matrix_data[r][c])))\n        matrix_of_cells.append(row_of_cells)\n\n    all_paths: list[Path] = []\n    _find_all_paths_recursive(matrix_of_cells, 0, 0, [], all_paths, N)\n    return all_paths\ndef maxAverageOfPath(matrix_data: list[list[float]]) -> float:\n    \"\"\"\n    Finds the path with the maximum average cost in a square matrix.\n    Orchestrates validation, path discovery, and average calculation.\n    \"\"\"\n    validate_matrix(matrix_data)\n\n    paths = find_all_paths(matrix_data)\n\n    max_average = -float('inf')\n    if not paths:\n        return 0.0\n\n    for path in paths:\n        average_cost = path.calculate_average()\n        if average_cost > max_average:\n            max_average = average_cost\n\n    return max_average"}
