{"task_id": "Mbpp/809", "solution": "def check_smaller(tuple1: tuple[float | int, ...], tuple2: tuple[float | int, ...]) -> bool:\n    \"\"\"\n    Checks if each element of the second tuple is strictly smaller than its corresponding element in the first tuple.\n    Assumes both tuples have the same length and contain numbers.\n    \"\"\"\n    for t1_elem, t2_elem in zip(tuple1, tuple2):\n        if not (t2_elem < t1_elem):\n            return False\n    return True"}
{"task_id": "Mbpp/790", "solution": "def even_position(numbers: list[int]) -> bool:\n    \"\"\"\n    Checks if every number at an even index in the given list is an even number.\n    Returns True if this condition holds for all even indices, False otherwise.\n    \"\"\"\n    for index, number in enumerate(numbers):\n        if index % 2 == 0:  # Check if the current index is even\n            if number % 2 != 0:  # Check if the number at this even index is odd\n                return False  # If an odd number is found at an even index, short-circuit and return False\n    return True  # If the loop completes, all numbers at even indices were even"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(tuple1: tuple, tuple2: tuple) -> bool:\n    \"\"\"\n    Checks if each element of the second tuple is strictly smaller than its\n    corresponding element in the first tuple. Assumes both input tuples have\n    the same number of elements.\n    \"\"\"\n    for i in range(len(tuple1)):\n        if not (tuple2[i] < tuple1[i]):\n            return False\n    return True"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(list_of_lists: list[list[int]]) -> list[int]:\n    \"\"\"Identifies and returns the inner list with the highest sum of its elements.\n    Returns an empty list if the input list of lists is empty.\"\"\"\n    if not list_of_lists:\n        return []\n\n    max_sum = float('-inf')\n    max_list = None\n\n    for inner_list in list_of_lists:\n        current_sum = sum(inner_list)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            max_list = inner_list\n\n    return max_list"}
