{"task_id": "Mbpp/593", "solution": "class Octet:\n    \"\"\"Represents a single IP address octet and handles leading zero removal.\"\"\"\n    def __init__(self, original_value: str):\n        self._original_value = original_value\n        # Convert to int and back to str to remove leading zeros.\n        self._cleaned_value = str(int(original_value))\n\n    def get_cleaned_value(self) -> str:\n        \"\"\"Returns the octet's string value with leading zeros removed.\"\"\"\n        return self._cleaned_value\nclass IPAddress:\n    \"\"\"Represents an IP address, manages its constituent octets, and reconstructs the cleaned IP string.\"\"\"\n    def __init__(self, ip_string: str):\n        self._original_ip_string = ip_string\n        octet_strings = ip_string.split('.')\n        self._octets = [Octet(os) for os in octet_strings]\n\n    def get_cleaned_ip(self) -> str:\n        \"\"\"Returns the full IP address string with leading zeros removed from all octets.\"\"\"\n        cleaned_octet_values = [octet.get_cleaned_value() for octet in self._octets]\n        return '.'.join(cleaned_octet_values)\ndef removezero_ip(ip_address_string: str) -> str:\n    \"\"\"Removes leading zeros from each octet of an IP address string.\n    This function processes an IP address string to remove any leading zeros from its octets.\n    \"\"\"\n    ip_address = IPAddress(ip_address_string)\n    return ip_address.get_cleaned_ip()"}
