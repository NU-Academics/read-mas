{"task_id": "Mbpp/765", "solution": "def _is_power_of_two(num: int) -> bool:\n    \"\"\"Checks if a number is a power of two.\"\"\"\n    if num <= 0:\n        return False\n    return (num & (num - 1)) == 0\ndef is_polite(n: int) -> int:\n    \"\"\"Calculates the nth polite number.\n\n    A polite number is a positive integer that can be expressed as the sum\n    of two or more consecutive positive integers. Numbers that are powers\n    of 2 are not polite numbers.\n\n    Args:\n        n: A positive integer representing the desired ordinal position.\n\n    Returns:\n        The nth polite number.\n\n    Raises:\n        ValueError: If n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    polite_count = 0\n    current_num = 1\n\n    while True:\n        if not _is_power_of_two(current_num):\n            polite_count += 1\n            if polite_count == n:\n                return current_num\n        current_num += 1"}
{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number.\n    A polite number is a positive integer that is not a power of 2.\n    According to geeksforgeeks.org/n-th-polite-number/,\n    the nth polite number can be found using the formula 2*n + 1.\n    \"\"\"\n    return 2 * n + 1"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers, target_sum):\n    \"\"\"Counts unique pairs in a list whose sum equals a target value.\n    Pairs are considered unique based on their indices in the input list.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list: list) -> list[tuple]:\n    \"\"\"\n    Generates a list of tuples, where each tuple contains consecutive items from the input list.\n    Returns an empty list for inputs with fewer than two elements.\n    \"\"\"\n    result_list = []\n\n    # If the list has fewer than two elements, no pairs can be formed.\n    if len(input_list) < 2:\n        return result_list\n\n    # Iterate from the first element up to the second-to-last element.\n    for i in range(len(input_list) - 1):\n        current_item = input_list[i]\n        next_item = input_list[i+1]\n        result_list.append((current_item, next_item))\n\n    return result_list"}
