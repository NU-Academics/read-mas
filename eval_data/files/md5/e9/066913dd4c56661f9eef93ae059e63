{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers, n):\n    \"\"\"\n    Calculates the sum of bitwise XOR operations for all unique pairs in a list.\n    It iterates through pairs (numbers[i], numbers[j]) where i < j and sums their XOR results.\n    \"\"\"\n    total_sum = 0\n\n    if n < 2:\n        return 0\n\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            xor_result = numbers[i] ^ numbers[j]\n            total_sum += xor_result\n\n    return total_sum"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers: list[int], length: int) -> int:\n    \"\"\"Calculates the sum of XOR of all unique pairs in a list.\n    It iterates through all unique pairs (i, j) where i < j and sums their bitwise XOR.\n    \"\"\"\n    total_xor_sum = 0\n\n    for i in range(length):\n        for j in range(i + 1, length):\n            num1 = numbers[i]\n            num2 = numbers[j]\n            pair_xor = num1 ^ num2\n            total_xor_sum += pair_xor\n\n    return total_xor_sum"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a list using the heap sort algorithm and returns a new sorted list.\n    The original input list remains unchanged.\n    \"\"\"\n    arr = list(input_list)\n    n = len(arr)\n\n    def _heapify(arr_inner: list, n_inner: int, i_inner: int) -> None:\n        \"\"\"\n        Maintains the max-heap property for a subtree rooted at a given index.\n        This function modifies the array in-place within the specified bounds.\n        \"\"\"\n        largest = i_inner\n        l = 2 * i_inner + 1\n        r = 2 * i_inner + 2\n\n        if l < n_inner and arr_inner[l] > arr_inner[largest]:\n            largest = l\n\n        if r < n_inner and arr_inner[r] > arr_inner[largest]:\n            largest = r\n\n        if largest != i_inner:\n            arr_inner[i_inner], arr_inner[largest] = arr_inner[largest], arr_inner[i_inner]\n            _heapify(arr_inner, n_inner, largest)\n\n    def _build_max_heap(arr_inner: list) -> None:\n        \"\"\"\n        Builds a max-heap from the given array in-place.\n        It starts from the last non-leaf node and heapifies upwards.\n        \"\"\"\n        n_inner = len(arr_inner)\n        for i_inner in range(n_inner // 2 - 1, -1, -1):\\\n            _heapify(arr_inner, n_inner, i_inner)\n\n    _build_max_heap(arr)\n\n    for i in range(n - 1, 0, -1):\\\n        arr[i], arr[0] = arr[0], arr[i]  # Swap root with last element"}
