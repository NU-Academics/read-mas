{"task_id": "Mbpp/119", "solution": "def find_unique_element(arr: list[int]) -> int:\n    \"\"\"\n    Identifies the single element that appears only once in a sorted array\n    where all other elements appear an even number of times.\n    \"\"\"\n    if not arr:\n        raise ValueError(\"Input array cannot be empty\")\n    if len(arr) == 1:\n        return arr[0]\n\n    low = 0\n    high = len(arr) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n\n        # Adjust mid to be the start of a potential pair.\n        # If mid is odd, make it even by decrementing.\n        if mid % 2 != 0:\n            mid -= 1\n\n        if arr[mid] == arr[mid+1]:\n            # The unique element is to the right of this pair.\n            low = mid + 2\n        else:\n            # The unique element is at or to the left of arr[mid].\n            high = mid\n\n    return arr[low]"}
{"task_id": "Mbpp/119", "solution": "def search(arr: list[int | float]) -> int | float:\n    \"\"\"\n    Identifies the single unique element in a sorted array where all other elements appear an even number of times.\n    It iterates through the array, comparing elements in pairs to find the one without a match.\n    \"\"\"\n    for i in range(0, len(arr), 2):\n        # If the current index is the last element, or if the current element\n        # does not match the next, then arr[i] is the unique element.\n        if i + 1 == len(arr) or arr[i] != arr[i+1]:\n            return arr[i]"}
{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"\n    Determines if the input string represents an integer, optionally prefixed by '+' or '-'.\n    Returns True for valid integers and False otherwise, including for non-numeric strings.\n    \"\"\"\n    if not input_string:\n        return False\n\n    start_index = 0\n    if input_string[0] == '+' or input_string[0] == '-':\n        start_index = 1\n        if len(input_string) == 1:  # String is just \"+\" or \"-\"\n            return False\n\n    for i in range(start_index, len(input_string)):\n        if not input_string[i].isdigit():\n            return False\n\n    return True"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(list_of_tuples: list[tuple[int | float, int | float]]) -> int | float:\n    \"\"\"\n    Calculates the maximum absolute product from pairs of numbers in a list of tuples.\n    It iterates through each tuple, computes the absolute product, and returns the maximum found.\n    \"\"\"\n    max_abs_product = float('-inf')\n\n    for num1, num2 in list_of_tuples:\n        product = num1 * num2\n        current_abs_product = abs(product)\n        max_abs_product = max(max_abs_product, current_abs_product)\n\n    return max_abs_product"}
{"task_id": "Mbpp/111", "solution": "from typing import List, Any, Set\ndef _flatten_list(nested_list: List[Any]) -> Set[Any]:\n    \"\"\"Recursively flattens a nested list into a set of unique elements.\n    It collects all individual elements from a potentially deeply nested structure.\"\"\"\n    flat_set = set()\n    for item in nested_list:\n        if isinstance(item, list):\n            flat_set.update(_flatten_list(item))\n        else:\n            flat_set.add(item)\n    return flat_set\ndef common_in_nested_lists(nested_lists: List[List[Any]]) -> Set[Any]:\n    \"\"\"Finds unique common elements across multiple nested lists.\n    It flattens each list and computes the intersection of all resulting sets.\"\"\"\n\n    all_flattened_sets = [_flatten_list(current_list) for current_list in nested_lists]\n\n    # Handle the case of no input lists or empty lists\n    if not all_flattened_sets:\n        return set()\n\n    common_elements = all_flattened_sets[0]\n\n    for i in range(1, len(all_flattened_sets)):\n        common_elements.intersection_update(all_flattened_sets[i])\n\n    return common_elements"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(n: int) -> int:\n    \"\"\"Calculates the sum of all amicable numbers up to a specified limit.\n    This implementation encapsulates the entire layered design within a single function.\n    \"\"\"\n\n    # --- Domain Entities/Value Objects Layer (models.py components) ---\n    class Range:\n        \"\"\"Encapsulates the upper limit for amicable number calculation.\"\"\"\n        def __init__(self, upper_limit_val: int):\n            self.upper_limit: int = upper_limit_val\n\n    class AmicablePair:\n        \"\"\"Represents a pair of distinct amicable numbers.\"\"\"\n        def __init__(self, num1: int, num2: int):\n            self.number1: int = min(num1, num2)\n            self.number2: int = max(num1, num2)\n\n        def get_numbers(self) -> tuple[int, int]:\n            \"\"\"Returns the two numbers in the pair.\"\"\"\n            return self.number1, self.number2\n\n    # --- Domain Services Layer (number_utils.py components) ---\n    def calculate_sum_of_proper_divisors(k: int) -> int:\n        \"\"\"Computes the sum of all proper divisors for a given positive integer.\"\"\"\n        if k <= 1:\n            return 0\n        sum_divs = 1\n        for i in range(2, int(k**0.5) + 1):\n            if k % i == 0:\n                sum_divs += i\n                if i * i != k:\n                    sum_divs += k // i\n        return sum_divs\n\n    # --- Application/Domain Layer (amicable_calculator.py components) ---\n    class AmicableNumberCalculator:\n        \"\"\"Orchestrates the process of finding and summing amicable numbers.\"\"\"\n        def calculate_sum_of_amicable_numbers(self, range_obj: Range) -> int:\n            \"\"\"Calculates the sum of all distinct amicable numbers up to range_obj.upper_limit.\"\"\"\n            current_upper_limit = range_obj.upper_limit\n            total_sum = 0\n            found_amicable_numbers = set()\n            memoization_cache = {}\n\n            # First pass: Pre-calculate sum of proper divisors for all numbers in range\n            for num_val in range(1, current_upper_limit + 1):\n                if num_val > 1:\n                    memoization_cache[num_val] = calculate_sum_of_proper_divisors(num_val)\n\n            # Second pass: Identify amicable pairs and sum them\n            for a in range(1, current_upper_limit + 1):\n                if a > 1 and a not in found_amicable_numbers:\n                    sum_divisors_a = memoization_cache.get(a)\n\n                    if sum_divisors_a is not None and sum_divisors_a > 1 and a != sum_divisors_a:\n                        b = sum_divisors_a\n                        if 1 < b <= current_upper_limit:\n                            sum_divisors_b = memoization_cache.get(b)\n\n                            if sum_divisors_b == a:\n                                # An AmicablePair object is conceptually created here: AmicablePair(a, b)\n                                found_amicable_numbers.add(a)\n                                found_amicable_numbers.add(b)\n                                total_sum += a + b\n            return total_sum\n\n    # --- Presentation/Application Layer (main.py logic integrated) ---\n    range_obj = Range(n)\n    calculator = AmicableNumberCalculator()\n    final_sum = calculator.calculate_sum_of_amicable_numbers(range_obj)\n\n    return final_sum"}
