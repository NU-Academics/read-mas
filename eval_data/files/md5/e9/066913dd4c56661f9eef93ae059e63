{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in the input string.\n    Uppercase characters become lowercase, and lowercase characters become uppercase.\n    \"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if char.isupper():\n            toggled_chars.append(char.lower())\n        elif char.islower():\n            toggled_chars.append(char.upper())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"Calculates the sum of per-digit absolute differences between two integers.\n    The shorter integer is conceptually padded with leading zeros.\"\"\"\n\n    str_num1 = str(num1)\n    str_num2 = str(num2)\n\n    max_len = max(len(str_num1), len(str_num2))\n\n    padded_str_num1 = str_num1.zfill(max_len)\n    padded_str_num2 = str_num2.zfill(max_len)\n\n    total_difference = 0\n    for i in range(max_len):\n        digit1 = int(padded_str_num1[i])\n        digit2 = int(padded_str_num2[i])\n        total_difference += abs(digit1 - digit2)\n\n    return total_difference"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1, num2):\n    \"\"\"\n    Calculates the sum of absolute per-digit differences between two integers.\n    The shorter number is conceptually padded with leading zeros for alignment.\n    \"\"\"\n    s_num1 = str(num1)\n    s_num2 = str(num2)\n\n    max_len = max(len(s_num1), len(s_num2))\n\n    padded_s_num1 = s_num1.zfill(max_len)\n    padded_s_num2 = s_num2.zfill(max_len)\n\n    total_sum = 0\n    for i in range(max_len):\n        digit1 = int(padded_s_num1[i])\n        digit2 = int(padded_s_num2[i])\n        total_sum += abs(digit1 - digit2)\n\n    return total_sum"}
