{"task_id": "Mbpp/631", "solution": "import re\ndef replace_spaces(input_string: str) -> str:\n    \"\"\"\n    Replaces whitespaces with an underscore and vice versa in a given string.\n    This function performs a bidirectional swap:\n    - All whitespace characters (space, tab, newline, etc.) are replaced by underscores.\n    - All underscore characters are replaced by spaces.\n    To avoid conflicts during replacement, a temporary placeholder is used.\n    \"\"\"\n    # Replace all whitespace characters with a temporary unique character (\\x01)\n    # This handles various forms of whitespace as indicated in the design (space, tab, newline).\n    temp_string = re.sub(r'\\s', '\\x01', input_string)\n\n    # Replace all underscore characters with a space.\n    temp_string = temp_string.replace('_', ' ')\n\n    # Replace the temporary placeholder (\\x01) with an underscore.\n    final_string = temp_string.replace('\\x01', '_')\n\n    return final_string"}
{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string contains the character 'z', but only if 'z' is not at the\n    very beginning or the very end of the string.\n\n    Args:\n        input_string: The string to be analyzed.\n\n    Returns:\n        True if 'z' is found in the middle of the string; False otherwise.\n    \"\"\"\n    if not input_string or 'z' not in input_string:\n        return False\n\n    if input_string[0] == 'z' or input_string[-1] == 'z':\n        return False\n\n    return True # 'z' is present and not at the ends"}
{"task_id": "Mbpp/643", "solution": "import re\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"\n    Determines if any word in the input string contains the character 'z'\n    at a position that is neither the first nor the last character of that word.\n    \"\"\"\n    # Tokenize the input string into words, considering alphanumeric sequences.\n    words = re.findall(r'\\b\\w+\\b', text)\n\n    for word in words:\n        # A word must have at least 3 characters for 'z' to be in a middle position.\n        if len(word) >= 3:\n            # Check indices from 1 up to (length - 2) for 'z'.\n            for i in range(1, len(word) - 1):\n                if word[i] == 'z':\n                    return True # Found 'z' in a valid middle position.\n\n    return False # No 'z' found in the middle of any word after checking all."}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(array: list, k: int) -> list:\n    \"\"\"Reverses the order of elements in an array from the beginning up to position k.\n    Elements beyond k remain unchanged in the returned list.\"\"\"\n\n    # Extract the sub-array to be reversed and reverse it.\n    # Concatenate the reversed sub-array with the untouched remainder of the original array.\n    reversed_segment = array[0:k][::-1]\n    remaining_segment = array[k:]\n    return reversed_segment + remaining_segment"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(input_list: list) -> list:\n    \"\"\"Sorts a given list using the heap sort algorithm.\n\n    This function returns a new list containing the sorted elements.\n    \"\"\"\n    working_list = list(input_list)\n    n = len(working_list)\n\n    def _heapify(arr: list, n: int, i: int):\n        \"\"\"Maintains the max-heap property for a subtree rooted at index i.\"\"\"\n        largest = i\n        left_child = 2 * i + 1\n        right_child = 2 * i + 2\n\n        if left_child < n and arr[left_child] > arr[largest]:\n            largest = left_child\n\n        if right_child < n and arr[right_child] > arr[largest]:\n            largest = right_child\n\n        if largest != i:\n            arr[i], arr[largest] = arr[largest], arr[i]\n            _heapify(arr, n, largest)\n\n    def _build_max_heap(arr: list):\n        \"\"\"Builds a max-heap from the input list.\"\"\"\n        for i in range(n // 2 - 1, -1, -1):\n            _heapify(arr, n, i)\n\n    _build_max_heap(working_list)\n\n    for i in range(n - 1, 0, -1):\n        working_list[i], working_list[0] = working_list[0], working_list[i]\n        _heapify(working_list, i, 0)\n\n    return working_list"}
