{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list, k):\n    \"\"\"\n    Removes the k-th element (1-based index) from a list, returning a new list.\n    The original input_list remains unchanged.\n    \"\"\"\n    # Convert the 1-based index k to a 0-based index for list access.\n    zero_based_k = k - 1\n\n    # Create a shallow copy of the input_list to ensure the original is not modified.\n    new_list = input_list[:]\n\n    # Remove the element at the calculated 0-based index from the new list.\n    new_list.pop(zero_based_k)\n\n    return new_list"}
{"task_id": "Mbpp/619", "solution": "from typing import Tuple\ndef _is_numeric(char: str) -> bool:\n    \"\"\"Checks if a character is a numeric digit (0-9).\n    This helper uses Python's built-in string method.\n    \"\"\"\n    return char.isdigit()\ndef _separate_characters(input_string: str) -> Tuple[str, str]:\n    \"\"\"Separates an input string into non-numeric and numeric character strings.\n    It preserves the relative order within each group.\n    \"\"\"\n    non_numeric_chars = []\n    numeric_chars = []\n    for char in input_string:\n        if _is_numeric(char):\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n    return \"\".join(non_numeric_chars), \"\".join(numeric_chars)\ndef _concatenate_strings(non_numeric_chars: str, numeric_chars: str) -> str:\n    \"\"\"Concatenates two strings: non_numeric_chars followed by numeric_chars.\n    This provides the final rearranged string.\n    \"\"\"\n    return non_numeric_chars + numeric_chars\ndef move_num(input_string: str) -> str:\n    \"\"\"Moves all numeric characters to the end of the given string.\n    The relative order of non-numeric characters and numeric characters is preserved.\n    \"\"\"\n    non_numeric, numeric = _separate_characters(input_string)\n    return _concatenate_strings(non_numeric, numeric)"}
{"task_id": "Mbpp/607", "solution": "import re\ndef find_literals(input_string: str, regex_pattern: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Searches an input string for the first occurrence of a specified regular expression pattern.\n    Returns the matching substring, its start index, and its end index if found, otherwise None.\n    \"\"\"\n    match = re.search(regex_pattern, input_string)\n    if match:\n        return (match.group(0), match.start(), match.end())\n    return None"}
{"task_id": "Mbpp/620", "solution": "import collections\nfrom typing import List\ndef largest_subset(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest divisible subset using dynamic programming.\n    The input list is sorted, and dp_array tracks the longest subset ending at each number.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    numbers.sort()\n    n = len(numbers)\n    dp_array = [1] * n\n    max_size = 1\n\n    for i in range(1, n):\n        for j in range(i):\n            if numbers[i] % numbers[j] == 0:\n                dp_array[i] = max(dp_array[i], dp_array[j] + 1)\n        max_size = max(max_size, dp_array[i])\n\n    return max_size"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1, list2, size):\n    \"\"\"\n    Calculates the median of two sorted lists of equal size.\n    It efficiently finds the two middle elements from the combined sorted sequence.\n    \"\"\"\n    i = 0\n    j = 0\n    median1 = 0.0\n    median2 = 0.0\n\n    # Iterate size + 1 times to find the two median elements\n    for count in range(size + 1):\n        if i < size and (j >= size or list1[i] <= list2[j]):\n            current_element = list1[i]\n            i += 1\n        else:\n            current_element = list2[j]\n            j += 1\n\n        if count == size - 1:\n            median1 = current_element\n        if count == size:\n            median2 = current_element\n            break # Found both required elements, no need to continue\n\n    return (median1 + median2) / 2.0"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the size of the largest subset where every pair is mutually divisible.\n    It uses dynamic programming after sorting the input list of numbers.\n    \"\"\"\n    n = len(numbers)\n    if n == 0:\n        return 0\n\n    numbers.sort()\n    dp = [1] * n  # dp[i] stores the size of the largest divisible subset ending with numbers[i]\n\n    for i in range(n):\n        for j in range(i):\n            if numbers[i] % numbers[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n\n    return max(dp)"}
{"task_id": "Mbpp/623", "solution": "from typing import List, Union\ndef nth_nums(numbers: List[Union[int, float]], n: int) -> List[Union[int, float]]:\n    \"\"\"Compute the n-th power for each number in the input list.\n    Returns a new list containing these computed results.\"\"\"\n    result_list = []\n    for num in numbers:\n        result_list.append(num ** n)\n    return result_list"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1: list[float], list2: list[float], n: int) -> float:\n    \"\"\"Calculates the median of two sorted lists of the same size.\n    It finds the two middle elements from the conceptual merged list without explicit merging.\"\"\"\n    i = 0  # Pointer for list1\n    j = 0  # Pointer for list2\n    m1 = 0.0 # Will store the (n-1)-th element\n    m2 = 0.0 # Will store the n-th element\n\n    # Iterate n+1 times to find the elements at n-1 and n indices\n    for _ in range(n + 1):\n        m1 = m2 # Store the previous m2 as m1\n\n        if i == n:\n            # list1 is exhausted, take from list2\n            m2 = float(list2[j])\n            j += 1\n        elif j == n:\n            # list2 is exhausted, take from list1\n            m2 = float(list1[i])\n            i += 1\n        elif list1[i] <= list2[j]:\n            # Current element from list1 is smaller\n            m2 = float(list1[i])\n            i += 1\n        else:\n            # Current element from list2 is smaller\n            m2 = float(list2[j])\n            j += 1\n\n    # The median is the average of the n-1 and n-th elements\n    return (m1 + m2) / 2.0"}
