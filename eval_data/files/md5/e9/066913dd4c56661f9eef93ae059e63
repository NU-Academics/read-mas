{"task_id": "Mbpp/296", "solution": "from typing import List, Union\ndef _merge_and_count_split_inversions(arr: List[Union[int, float]], temp: List[Union[int, float]], left: int, mid: int, right: int) -> int:\n    \"\"\"\n    Merges two sorted sub-arrays and counts inversions where elements cross the midpoint.\n    Elements are copied from arr to temp during sorting, then back to arr.\n    \"\"\"\n    i = left\n    j = mid + 1\n    k = left\n    inv_count = 0\n\n    while i <= mid and j <= right:\n        if arr[i] <= arr[j]:\n            temp[k] = arr[i]\n            i += 1\n        else:\n            # An inversion is found when arr[i] > arr[j].\n            # All remaining elements in the left sub-array (from i to mid) also form inversions with arr[j].\n            temp[k] = arr[j]\n            inv_count += (mid - i + 1)\n            j += 1\n        k += 1\n\n    while i <= mid:\n        temp[k] = arr[i]\n        i += 1\n        k += 1\n\n    while j <= right:\n        temp[k] = arr[j]\n        j += 1\n        k += 1\n\n    for x in range(left, right + 1):\n        arr[x] = temp[x]\n\n    return inv_count\ndef _merge_sort_and_count_inversions(arr: List[Union[int, float]], temp: List[Union[int, float]], left: int, right: int) -> int:\n    \"\"\"\n    Recursively sorts a sub-array arr[left...right] and accumulates inversion counts.\n    It combines inversions from sub-problems and those found during the merge step.\n    \"\"\"\n    inv_count = 0\n    if left < right:\n        mid = (left + right) // 2\n        inv_count += _merge_sort_and_count_inversions(arr, temp, left, mid)\n        inv_count += _merge_sort_and_count_inversions(arr, temp, mid + 1, right)\n        inv_count += _merge_and_count_split_inversions(arr, temp, left, mid, right)\n    return inv_count\ndef get_Inv_Count(arr: List[Union[int, float]]) -> int:\n    \"\"\"\n    Calculates the total number of inversions in a given numerical array.\n    An inversion exists for a pair of elements (arr[i], arr[j]) if i < j and arr[i] > arr[j].\n    \"\"\"\n    n = len(arr)\n    temp = [0] * n\n    return _merge_sort_and_count_inversions(arr, temp, 0, n - 1)"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list: list) -> list:\n    \"\"\"\n    Flattens a nested list structure into a single, flat list.\n    Preserves element order and handles arbitrary levels of nesting.\n    \"\"\"\n    flat_list = []\n    for item in nested_list:\n        if type(item) is list:  # Recursively flatten sub-lists.\n            flat_list.extend(flatten_list(item))\n        else:  # Add non-list elements directly.\n            flat_list.append(item)\n    return flat_list"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: list) -> int:\n    \"\"\"Counts inversions in an array using a modified merge sort algorithm.\n    An inversion is a pair (i, j) such that i < j and arr[i] > arr[j].\n    \"\"\"\n\n    def _merge_sort_and_count(sub_arr: list) -> tuple[list, int]:\n        n = len(sub_arr)\n        if n <= 1:\n            return sub_arr, 0\n\n        mid = n // 2\n        left_half, left_inv_count = _merge_sort_and_count(sub_arr[:mid])\n        right_half, right_inv_count = _merge_sort_and_count(sub_arr[mid:])\n\n        merged_arr = []\n        i, j = 0, 0\n        split_inv_count = 0\n\n        while i < len(left_half) and j < len(right_half):\n            if left_half[i] <= right_half[j]:\n                merged_arr.append(left_half[i])\n                i += 1\n            else:\n                # If an element from right_half is picked, it means it's smaller\n                # than all remaining elements in left_half, hence count inversions.\n                merged_arr.append(right_half[j])\n                split_inv_count += len(left_half) - i\n                j += 1\n\n        merged_arr.extend(left_half[i:])\n        merged_arr.extend(right_half[j:])\n\n        return merged_arr, left_inv_count + right_inv_count + split_inv_count\n\n    _, total_inversions = _merge_sort_and_count(list(arr))\n    return total_inversions"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list: list) -> list:\n    \"\"\"\n    Flattens a nested list of integers and lists into a single-level list of integers.\n    It recursively processes sub-lists, preserving element order.\n    \"\"\"\n    result = []\n    for element in nested_list:\n        if isinstance(element, int):\n            result.append(element)\n        elif isinstance(element, list):\n            result.extend(flatten_list(element))\n    return result"}
{"task_id": "Mbpp/300", "solution": "import math\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Calculates the number of binary sequences of length 2n where the sum of the first\n    n bits equals the sum of the last n bits. This count is equivalent to C(2n, n).\n    \"\"\"\n    return math.comb(2 * n, n)"}
{"task_id": "Mbpp/299", "solution": "from typing import List, Tuple, Dict\ndef max_aggregate(scores: List[Tuple[str, int]]) -> Tuple[str, int]:\n    \"\"\"Calculates the maximum aggregate score from a list of (name, score) tuples.\n    It sums scores for each name and returns the name with the highest total score.\"\"\"\n    aggregated_scores: Dict[str, int] = {}\n\n    for name, score in scores:\n        aggregated_scores[name] = aggregated_scores.get(name, 0) + score\n\n    if not aggregated_scores:\n        return ('', 0)\n    else:\n        max_name, max_score = max(aggregated_scores.items(), key=lambda item: item[1])\n        return (max_name, max_score)"}
{"task_id": "Mbpp/300", "solution": "import math\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Calculates the count of binary sequences of length 2n such that the sum of\n    the first n bits is the same as the sum of the last n bits, using (2n choose n).\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n    return math.comb(2 * n, n)"}
{"task_id": "Mbpp/290", "solution": "from typing import List, Any, Tuple\ndef max_length(list_of_lists: List[List[Any]]) -> Tuple[int, List[Any]]:\n    \"\"\"Finds the list with the maximum length in a list of lists.\n    Returns a tuple of (max_length_val, identified_list).\"\"\"\n    max_length_val = -1\n    max_list: List[Any] = []\n\n    for inner_list in list_of_lists:\n        current_length = len(inner_list)\n        if current_length > max_length_val:\n            max_length_val = current_length\n            max_list = inner_list\n\n    return (max_length_val, max_list)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(dictionary: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of dictionaries within the given dictionary.\n    Returns 0 for an empty dictionary, 1 for a flat dictionary, and increments for each level of nested dictionaries.\n    \"\"\"\n    if not dictionary:\n        return 0\n\n    max_current_depth = 1\n    for value in dictionary.values():\n        if isinstance(value, dict):\n            max_current_depth = max(max_current_depth, 1 + dict_depth(value))\n    return max_current_depth"}
{"task_id": "Mbpp/305", "solution": "def start_withp(words_list: list[str]) -> tuple[str, str]:\n    \"\"\"\n    Identifies and returns the first two words starting with 'p' (case-insensitive).\n    Raises a ValueError if fewer than two such words are found.\n    \"\"\"\n    p_words_found = []\n    for input_string in words_list:\n        words = input_string.split()\n        for word in words:\n            if word.lower().startswith('p'):\n                p_words_found.append(word)\n                if len(p_words_found) == 2:\n                    return tuple(p_words_found)\n\n    raise ValueError(\"Fewer than two words starting with 'p' were found.\")"}
{"task_id": "Mbpp/293", "solution": "import math\ndef otherside_rightangle(side1: float, side2: float) -> float:\n    \"\"\"\n    Calculates the length of the hypotenuse of a right-angled triangle using the Pythagorean theorem.\n    It takes the lengths of the two legs as input and returns the hypotenuse as a float.\n    \"\"\"\n    return math.sqrt(side1**2 + side2**2)"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Calculates the maximum sum of an increasing subsequence from arr[0...i]\n    that includes arr[k], where k > i.\n    \"\"\"\n    dp = [0] * (i + 1) # dp[j] stores the max increasing subsequence sum ending at index j within prefix.\n\n    # Calculate max sum increasing subsequence for the prefix arr[0...i].\n    for current_idx in range(i + 1):\n        dp[current_idx] = arr[current_idx]\n        for prev_idx in range(current_idx):\n            if arr[current_idx] > arr[prev_idx]:\n                dp[current_idx] = max(dp[current_idx], dp[prev_idx] + arr[current_idx])\n\n    # Find the maximum sum from the prefix (up to index i) that can precede arr[k].\n    max_sum_before_k = 0\n    for idx_in_prefix in range(i + 1):\n        if arr[idx_in_prefix] < arr[k]:\n            max_sum_before_k = max(max_sum_before_k, dp[idx_in_prefix])\n\n    return max_sum_before_k + arr[k]"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(nums: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Computes the maximum sum of an increasing subsequence from nums[0...i]\n    that also includes nums[k]. All elements in the prefix subsequence must be less than nums[k].\n    \"\"\"\n    dp = [0] * (i + 1)\n\n    for current_idx in range(i + 1):\n        current_val = nums[current_idx]\n        if current_val < nums[k]:\n            dp[current_idx] = current_val\n            for prev_idx in range(current_idx):\n                if nums[prev_idx] < current_val:\n                    dp[current_idx] = max(dp[current_idx], dp[prev_idx] + current_val)\n\n    max_prefix_sum = 0\n    for val in dp:\n        max_prefix_sum = max(max_prefix_sum, val)\n\n    return max_prefix_sum + nums[k]"}
{"task_id": "Mbpp/308", "solution": "from typing import List\nclass Product:\n    \"\"\"Represents a product of two integers.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass ProductSet:\n    \"\"\"Generates and stores all possible products from two lists.\"\"\"\n    def __init__(self, list1: List[int], list2: List[int]):\n        self._products: List[Product] = []\n        for val1 in list1:\n            for val2 in list2:\n                self._products.append(Product(val1 * val2))\n\n    def get_all_products(self) -> List[Product]:\n        \"\"\"Returns the complete list of generated Product objects.\"\"\"\n        return self._products\nclass KLargestProductsSelector:\n    \"\"\"Selects and sorts the k largest products from a given list.\"\"\"\n    def __init__(self, all_products: List[Product], k: int):\n        self._all_products = all_products\n        self._k = k\n\n    def select_and_sort(self) -> List[int]:\n        \"\"\"Sorts products and returns the k largest integer values in descending order.\"\"\"\n        self._all_products.sort(key=lambda p: p.value, reverse=True)\n        k_largest_values = [p.value for p in self._all_products[:self._k]]\n        return k_largest_values\ndef large_product(list1: List[int], list2: List[int], k: int) -> List[int]:\n    \"\"\"\n    Computes and returns the k largest products formed by pairing elements\n    from list1 and list2, sorted in descending order.\n    \"\"\"\n    product_set = ProductSet(list1, list2)\n    all_products = product_set.get_all_products()\n\n    selector = KLargestProductsSelector(all_products, k)\n    k_largest_product_values = selector.select_and_sort()\n\n    return k_largest_product_values"}
{"task_id": "Mbpp/309", "solution": "from typing import Union\ndef maximum(num1: Union[int, float], num2: Union[int, float]) -> Union[int, float]:\n    \"\"\"\n    Compares two numerical inputs and returns the larger of the two.\n    If numbers are equal, either can be returned.\n    \"\"\"\n    if num1 >= num2:\n        return num1\n    else:\n        return num2"}
{"task_id": "Mbpp/308", "solution": "def _generate_all_products(list1: list[int], list2: list[int]) -> list[int]:\n    \"\"\"Generates all possible products by multiplying one factor from each list.\n    This implements Business Rule BR1.\n    \"\"\"\n    products = []\n    for factor1 in list1:\n        for factor2 in list2:\n            products.append(factor1 * factor2)\n    return products\ndef large_product(list1: list[int], list2: list[int], n: int) -> list[int]:\n    \"\"\"Finds the specified number of largest products from two lists.\n    It generates all products, sorts them, and returns the top 'n'.\n    \"\"\"\n    # Input validation (e.g., _validate_inputs) is omitted as raising exceptions\n    # for edge cases is forbidden by the critical requirements.\n    # We trust the caller's inputs as per the critical requirements.\n\n    all_products = _generate_all_products(list1, list2)\n\n    # Sort all products in descending order as per BR3.\n    all_products.sort(reverse=True)\n\n    # Select the top N products as per BR2.\n    # Slicing handles cases where 'n' might exceed the total number of products.\n    return all_products[:n]"}
