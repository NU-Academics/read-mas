{"task_id": "Mbpp/801", "solution": "def test_three_equal(arg1: int, arg2: int, arg3: int) -> int:\n    \"\"\"\n    Counts the number of equal integers among three given inputs and returns the count (0, 2, or 3).\n    \"\"\"\n    if arg1 == arg2 == arg3:\n        return 3\n    elif arg1 == arg2 or arg1 == arg3 or arg2 == arg3:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers: list) -> bool:\n    \"\"\"Determines if the product of numbers in a list is an even number, handling empty lists and lists containing zero.\n    \"\"\"\n    if not numbers:\n        return False\n\n    if 0 in numbers:\n        return True\n\n    product = 1\n    for num in numbers:\n        product *= num\n\n    return product % 2 == 0"}
{"task_id": "Mbpp/803", "solution": "import math\nclass Number:\n    \"\"\"Encapsulates a numerical value and provides the perfect square check.\"\"\"\n    def __init__(self, value: float):\n        self._value = value\n\n    def isPerfectSquare(self) -> bool:\n        \"\"\"Determines if the encapsulated number is a perfect square.\"\"\"\n        if self._value < 0:\n            return False\n        \n        # Calculate the square root.\n        sqrt_val = math.sqrt(self._value)\n        # A number is a perfect square if its square root is an integer.\n        return sqrt_val == int(sqrt_val)\ndef is_perfect_square(num: float) -> bool:\n    \"\"\"Checks if a given number is a perfect square using the Number class.\"\"\"\n    number_obj = Number(num)\n    return number_obj.isPerfectSquare()"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers: list) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    Returns True if the product is even, False otherwise.\n    \"\"\"\n    if not numbers:\n        return False\n\n    for num in numbers:\n        if num == 0:\n            return True\n        if num % 2 == 0:\n            return True\n\n    return False"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(list_of_lists: list[list[int]]) -> list[int]:\n    \"\"\"\n    Identifies the inner list with the maximum sum of elements from a given list of lists.\n    This function leverages the built-in `max` function with the `sum` function as a key.\n    \"\"\"\n    return max(list_of_lists, key=sum)"}
{"task_id": "Mbpp/803", "solution": "def is_perfect_square(number):\n    \"\"\"\n    Checks if a number is a perfect square according to the design specification.\n    This function handles negative numbers, zero, and numeric types including floats.\n    \"\"\"\n    if number < 0:\n        return False\n    if number == 0:\n        return True\n\n    # Calculate the square root using the exponentiation operator.\n    # This method avoids external module imports and is directly in-line.\n    sqrt_val = number ** 0.5\n\n    # A number is a perfect square if its square root is an integer.\n    # Compare the calculated float square root to its integer conversion.\n    return sqrt_val == int(sqrt_val)"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Calculates the maximum consecutive run length of uppercase characters in the given string.\n    It iterates through the string, tracking the current and maximum run lengths.\n    \"\"\"\n    current_run_length = 0\n    max_run_length = 0\n\n    for char in input_string:\n        if char.isupper():\n            current_run_length += 1\n        else:\n            max_run_length = max(max_run_length, current_run_length)\n            current_run_length = 0\n\n    # Final check for a run ending at the string's conclusion\n    max_run_length = max(max_run_length, current_run_length)\n    return max_run_length"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers: list) -> int:\n    \"\"\"Finds the first odd number in a list of integers.\n    It iterates through the list and returns the first number whose remainder when divided by 2 is not zero.\n    \"\"\"\n    for number in numbers:\n        if number % 2 != 0:\n            return number"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Calculates the maximum number of consecutive uppercase characters in the given string.\n\n    Args:\n        input_string: The string to be analyzed.\n\n    Returns:\n        An integer representing the maximum run of consecutive uppercase characters.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n        else:\n            current_run = 0\n        max_run = max(max_run, current_run)\n    return max_run"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(input_string):\n    \"\"\"\n    Removes all whitespace characters from the input string.\n    It iterates through the string to build a new string without whitespaces.\n    \"\"\"\n    return \"\".join(char for char in input_string if not char.isspace())"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers: list[int]) -> int | None:\n    \"\"\"Iterates through the list to find the first odd number.\n    Returns the first odd number found, or None if no odd numbers are present.\n    \"\"\"\n    for number in numbers:\n        if number % 2 != 0:\n            return number\n    return None"}
