{"task_id": "Mbpp/448", "solution": "_perrin_cache = {}\ndef _get_perrin_number(n: int) -> int:\n    \"\"\"Computes the nth Perrin number using memoization.\n    Handles base cases P(0)=3, P(1)=0, P(2)=2 and recurrence P(n) = P(n-2) + P(n-3).\"\"\"\n\n    if n in _perrin_cache:\n        return _perrin_cache[n]\n\n    if n == 0:\n        result = 3\n    elif n == 1:\n        result = 0\n    elif n == 2:\n        result = 2\n    else:\n        result = _get_perrin_number(n - 2) + _get_perrin_number(n - 3)\n\n    _perrin_cache[n] = result\n    return result\ndef cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from P(0) up to P(n).\n    It iterates and sums numbers obtained from the helper function.\"\"\"\n\n    total_sum = 0\n    for i in range(n + 1):\n        total_sum += _get_perrin_number(i)\n    return total_sum"}
