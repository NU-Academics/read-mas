{"task_id": "Mbpp/440", "solution": "import re\ndef find_adverb_position(sentence: str) -> tuple:\n    \"\"\"\n    Identifies the first adverb in a sentence, returning its indices and cleaned text.\n    Returns (-1, -1, '') if no adverb is found.\n    \"\"\"\n\n    # Forbidden to import `string` for punctuation, so define it manually.\n    _PUNCTUATION = '!\"#$%&\\'()*+,-./:;<=>?@[\\\\]^_`{|}~'\n\n    class PunctuationCleaner:\n        \"\"\"Utility to remove trailing punctuation from text.\"\"\"\n        @staticmethod\n        def remove_trailing_punctuation(text: str) -> str:\n            \"\"\"Removes all trailing punctuation characters from the given string.\"\"\"\n            return text.rstrip(_PUNCTUATION)\n\n    class AdverbIdentifier:\n        \"\"\"Identifies the first adverb in a sentence using heuristics.\"\"\"\n\n        # A curated list of common adverbs for identification.\n        _COMMON_ADVERBS = {\n            \"always\", \"usually\", \"often\", \"sometimes\", \"rarely\", \"never\",\n            \"very\", \"quite\", \"really\", \"almost\", \"just\", \"yet\", \"too\", \"enough\",\n            \"here\", \"there\", \"everywhere\", \"anywhere\", \"somewhere\",\n            \"now\", \"then\", \"today\", \"yesterday\", \"tomorrow\", \"tonight\",\n            \"early\", \"late\", \"soon\", \"already\", \"still\",\n            \"well\", \"fast\", \"hard\", \"straight\", \"away\", \"back\", \"down\", \"forward\",\n            \"in\", \"off\", \"on\", \"out\", \"up\",\n            \"quickly\", \"slowly\", \"happily\", \"sadly\", \"loudly\", \"softly\",\n            \"exactly\", \"perfectly\", \"actually\", \"eventually\", \"finally\",\n            \"probably\", \"possibly\", \"certainly\", \"definitely\", \"hardly\", \"scarcely\",\n        }\n\n        def identify_first_adverb(self, sentence: str) -> tuple | None:\n            \"\"\"\n            Finds the first adverb in the sentence and returns its raw text, start index, and end index.\n            Returns None if no adverb is found.\n            \"\"\"\n            # Iterate through non-whitespace sequences to find potential words/tokens.\n            for match in re.finditer(r'\\S+', sentence):\n                raw_token_text = match.group(0)\n                raw_start_idx = match.start()\n\n                # Clean the token for adverb identification, converting to lowercase.\n                cleaned_for_check = raw_token_text.strip(_PUNCTUATION).lower()\n\n                is_adverb = False\n                if cleaned_for_check in self._COMMON_ADVERBS:\n                    is_adverb = True\n                # Heuristic for common \"-ly\" adverbs, avoiding very short words.\n                elif len(cleaned_for_check) > 2 and cleaned_for_check.endswith(\"ly\"):\n                    is_adverb = True\n\n                # Ensure the identified word is primarily alphabetic.\n                if is_adverb and cleaned_for_check.isalpha():\n                    # Return the raw token text and its original indices.\n                    return raw_token_text, raw_start_idx, match.end()\n\n            return None # No adverb found\n\n    # Instantiate the helper components as described in the design.\n    adverb_identifier = AdverbIdentifier()\n    punctuation_cleaner = PunctuationCleaner()\n\n    # Attempt to find the first adverb using the identifier.\n    adverb_info = adverb_identifier.identify_first_adverb(sentence)\n\n    if adverb_info is None:\n        # If no adverb is found, return the default negative result.\n        return (-1, -1, '')\n    else:\n        # Unpack the raw adverb details.\n        raw_adverb_text, start_idx, _ = adverb_info\n\n        # Clean the raw adverb text by removing trailing punctuation.\n        cleaned_adverb_text = punctuation_cleaner.remove_trailing_punctuation(raw_adverb_text)\n\n        # Calculate the exclusive end index of the cleaned adverb.\n        cleaned_end_idx = start_idx + len(cleaned_adverb_text)\n\n        return (start_idx, cleaned_end_idx, cleaned_adverb_text)"}
{"task_id": "Mbpp/440", "solution": "import re\nimport string\ndef find_adverb_position(sentence: str) -> tuple:\n    \"\"\"\n    Finds the first adverb and its position in a given sentence.\n    Returns a tuple (start_index, end_index, adverb_string) or (-1, -1, \"\") if no adverb is found.\n    \"\"\"\n\n    COMMON_ADVERBS = {\n        \"clearly\", \"quickly\", \"slowly\", \"happily\", \"sadly\", \"really\", \"badly\",\n        \"easily\", \"finally\", \"very\", \"fast\", \"well\", \"soon\", \"late\", \"always\",\n        \"often\", \"never\", \"now\", \"then\", \"ago\", \"away\", \"back\", \"down\",\n        \"forward\", \"in\", \"off\", \"on\", \"out\", \"up\", \"where\", \"here\", \"there\"\n    }\n\n    word_finder = re.compile(r'\\S+')\n\n    for match in word_finder.finditer(sentence):\n        word_with_punctuation = match.group(0)\n        start_index = match.start()\n\n        cleaned_for_check = word_with_punctuation.strip(string.punctuation).lower()\n\n        is_adverb_candidate = False\n        if cleaned_for_check in COMMON_ADVERBS:\n            is_adverb_candidate = True\n        elif len(cleaned_for_check) > 3 and cleaned_for_check.endswith(\"ly\"):\n            is_adverb_candidate = True\n\n        if is_adverb_candidate:\n            stripped_adverb = word_with_punctuation.rstrip(string.punctuation)\n\n            end_index = start_index + len(stripped_adverb)\n\n            return (start_index, end_index, stripped_adverb)\n\n    return (-1, -1, \"\")"}
