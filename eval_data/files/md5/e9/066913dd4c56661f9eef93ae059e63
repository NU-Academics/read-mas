{"task_id": "Mbpp/780", "solution": "import itertools\ndef find_combinations(tuple_list):\n    \"\"\"\n    Calculates all unique pairwise sums of distinct tuples from the input list.\n    Each sum tuple is formed by adding corresponding components of two input tuples.\n    \"\"\"\n    result_sums = []\n    for tuple_a, tuple_b in itertools.combinations(tuple_list, 2):\n        sum_component1 = tuple_a[0] + tuple_b[0]\n        sum_component2 = tuple_a[1] + tuple_b[1]\n        result_sums.append((sum_component1, sum_component2))\n    return result_sums"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Packs consecutive duplicates of a given list elements into sublists.\n    Each sublist contains consecutive identical elements from the input list.\n    \"\"\"\n    result_list = []\n    current_sublist = []\n\n    for element in input_list:\n        if not current_sublist or element == current_sublist[-1]:\n            current_sublist.append(element)\n        else:\n            result_list.append(current_sublist)\n            current_sublist = [element]\n\n    if current_sublist:\n        result_list.append(current_sublist)\n\n    return result_list"}
{"task_id": "Mbpp/781", "solution": "def _is_perfect_square(n: int) -> bool:\n    \"\"\"Checks if a given integer is a perfect square.\n    This private helper supports determining divisor count parity efficiently.\n    \"\"\"\n    sqrt_n = int(n**0.5)\n    return sqrt_n * sqrt_n == n\ndef count_divisors(number: int) -> bool:\n    \"\"\"Determines if the count of positive divisors for a number is even.\n    A number has an even divisor count if and only if it is not a perfect square.\n    \"\"\"\n    is_square = _is_perfect_square(number)\n    return not is_square"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list) -> int:\n    \"\"\"Calculates the sum of all elements across all odd-length subarrays of a given array.\n    This function iterates through all subarrays, summing elements only if the subarray's length is odd.\"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):  # Start index of subarray\n        for j in range(i, n):  # End index of subarray\n            # Extract the current subarray\n            subarray = arr[i : j+1]\n\n            # Check if the length of the subarray is odd\n            if len(subarray) % 2 != 0:\n                # Sum elements of the odd-length subarray and add to total_sum\n                total_sum += sum(subarray)\n\n    return total_sum"}
