{"task_id": "Mbpp/126", "solution": "def sum_common_divisors(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of all positive common divisors for two given integer numbers.\n    It first determines the GCD and then sums its divisors.\n    \"\"\"\n\n    # Calculate the Greatest Common Divisor (GCD) using the Euclidean algorithm.\n    a, b = num1, num2\n    while b:\n        a, b = b, a % b\n    gcd_value = a\n\n    # Find all positive divisors of the GCD and sum them up.\n    sum_of_divs = 0\n    for i in range(1, int(gcd_value**0.5) + 1):\n        if gcd_value % i == 0:\n            sum_of_divs += i\n            if i * i != gcd_value:  # Add the complementary divisor if it's not the same\n                sum_of_divs += (gcd_value // i)\n    return sum_of_divs"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"Calculates the maximum difference between '0's and '1's in any substring.\n    It uses a modified Kadane's algorithm to find the maximum subarray sum.\n    \"\"\"\n    max_so_far = -float('inf')\n    current_max = 0\n\n    for char in binary_string:\n        value = 1 if char == '0' else -1\n        current_max = max(value, current_max + value)\n        max_so_far = max(max_so_far, current_max)\n\n    # If the string was empty, max_so_far would remain -inf,\n    # but per design constraints, we trust the input is valid and non-empty.\n    return int(max_so_far)"}
{"task_id": "Mbpp/126", "solution": "def _get_divisors(n: int) -> set[int]:\n    \"\"\"Finds all positive divisors of a given integer.\n    It returns these divisors as a set of integers.\"\"\"\n    divs = set()\n    for i in range(1, int(n**0.5) + 1):\n        if n % i == 0:\n            divs.add(i)\n            divs.add(n // i)\n    return divs\ndef _find_common_divisors(divisors1: set[int], divisors2: set[int]) -> set[int]:\n    \"\"\"Computes the intersection of two sets of divisors.\n    This identifies the common divisors between the two sets.\"\"\"\n    return divisors1.intersection(divisors2)\ndef _sum_divisors(divisors: set[int]) -> int:\n    \"\"\"Calculates the sum of all integers in a given set of divisors.\n    It returns the total sum.\"\"\"\n    return sum(divisors)\ndef sum(number1: int, number2: int) -> int:\n    \"\"\"Calculates the sum of common divisors for two positive integers.\n    This is the main entry point for the module.\"\"\"\n    divisors1 = _get_divisors(number1)\n    divisors2 = _get_divisors(number2)\n    common_divs = _find_common_divisors(divisors1, divisors2)\n    return _sum_divisors(common_divs)"}
{"task_id": "Mbpp/120", "solution": "from typing import List\nclass TuplePair:\n    \"\"\"Represents a tuple of two numbers and calculates their product and absolute product.\"\"\"\n    def __init__(self, number1: float, number2: float):\n        self._number1 = number1\n        self._number2 = number2\n\n    def get_product(self) -> float:\n        \"\"\"Calculates the product of the two numbers.\"\"\"\n        return self._number1 * self._number2\n\n    def get_absolute_product(self) -> float:\n        \"\"\"Calculates the absolute product of the two numbers.\"\"\"\n        return abs(self.get_product())\nclass InputList:\n    \"\"\"Manages a collection of TuplePair objects and finds the maximum absolute product.\"\"\"\n    def __init__(self, raw_tuples: List[tuple]):\n        self._tuple_pairs: List[TuplePair] = []\n        for raw_tuple in raw_tuples:\n            self._tuple_pairs.append(TuplePair(raw_tuple[0], raw_tuple[1]))\n\n    def find_max_absolute_product(self) -> float:\n        \"\"\"Identifies the maximum absolute product among all contained TuplePair objects.\"\"\"\n        if not self._tuple_pairs:\n            return 0.0\n\n        max_abs_product = 0.0\n        for tuple_pair in self._tuple_pairs:\n            current_abs_product = tuple_pair.get_absolute_product()\n            if current_abs_product > max_abs_product:\n                max_abs_product = current_abs_product\n        return max_abs_product\ndef max_product_tuple(input_list_of_tuples: List[tuple]) -> float:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples.\n    It orchestrates the calculation using InputList and TuplePair objects.\n    \"\"\"\n    input_list_obj = InputList(input_list_of_tuples)\n    return input_list_obj.find_max_absolute_product()"}
{"task_id": "Mbpp/128", "solution": "def long_words(n: int, text: str) -> list[str]:\n    \"\"\"\n    Identifies words strictly longer than 'n' from the given text.\n    It returns an empty list if no such words are found.\n    \"\"\"\n    words = text.split()\n    long_words_list = [word for word in words if len(word) > n]\n    return long_words_list"}
{"task_id": "Mbpp/128", "solution": "def long_words(n: int, text_string: str) -> list[str]:\n    \"\"\"\n    Finds words from a string that are strictly longer than n characters.\n    Splits the input string by whitespace and filters based on length.\n    \"\"\"\n    words = text_string.split()\n    long_word_list = []\n    for word in words:\n        if len(word) > n:\n            long_word_list.append(word)\n    return long_word_list"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix: list[list[int | float]]) -> bool:\n    \"\"\"\n    Determines if a given square matrix is a magic square.\n    It checks row, column, and diagonal sums against a calculated magic sum.\n    \"\"\"\n    n = len(matrix)\n\n    # FR6: Check for Empty Matrix\n    if n == 0:\n        return False\n\n    # FR7, FR8: Check for Non-Square Matrix or Empty Rows\n    for row in matrix:\n        if len(row) != n:\n            return False\n\n    # FR10: Calculate the Magic Sum based on the first row\n    magic_sum = sum(matrix[0])\n\n    # FR11: Validate Row Sums\n    for row in matrix:\n        if sum(row) != magic_sum:\n            return False\n\n    # FR12: Validate Column Sums\n    for c in range(n):\n        current_col_sum = 0\n        for r in range(n):\n            current_col_sum += matrix[r][c]\n        if current_col_sum != magic_sum:\n            return False\n\n    # FR13: Validate Main Diagonal Sum\n    main_diag_sum = 0\n    for i in range(n):\n        main_diag_sum += matrix[i][i]\n    if main_diag_sum != magic_sum:\n        return False\n\n    # FR14: Validate Anti-Diagonal Sum\n    anti_diag_sum = 0\n    for i in range(n):\n        anti_diag_sum += matrix[i][n - 1 - i]\n    if anti_diag_sum != magic_sum:\n        return False\n\n    # FR3: If all checks pass, it's a magic square\n    return True"}
{"task_id": "Mbpp/129", "solution": "class Matrix:\n    # Represents the input matrix, storing its elements and size.\n    def __init__(self, elements: list[list[float]]) -> None:\n        self.elements = elements\n        self.size = len(elements)\n\n    # Checks if the matrix is a valid square matrix.\n    def is_square(self) -> bool:\n        if not self.elements:\n            return False\n        if self.size == 0:\n            return False # An empty matrix is not considered a magic square.\n        for row in self.elements:\n            if len(row) != self.size:\n                return False\n        return True\nclass SumCollection:\n    # Manages the collection of calculated sums and determines if they are all equal.\n    def __init__(self) -> None:\n        self.row_sums: list[float] = []\n        self.column_sums: list[float] = []\n        self.main_diagonal_sum: float = 0\n        self.anti_diagonal_sum: float = 0\n        self._all_sums: list[float] = [] # Stores all calculated sums for comparison.\n\n    # Calculates and stores the sum of each row.\n    def calculate_row_sums(self, elements: list[list[float]]) -> None:\n        for row in elements:\n            row_sum = sum(row)\n            self.row_sums.append(row_sum)\n            self._all_sums.append(row_sum)\n\n    # Calculates and stores the sum of each column.\n    def calculate_column_sums(self, elements: list[list[float]]) -> None:\n        size = len(elements)\n        for col_idx in range(size):\n            col_sum = 0.0\n            for row_idx in range(size):\n                col_sum += elements[row_idx][col_idx]\n            self.column_sums.append(col_sum)\n            self._all_sums.append(col_sum)\n\n    # Calculates and stores the sum of the main diagonal.\n    def calculate_main_diagonal_sum(self, elements: list[list[float]]) -> None:\n        size = len(elements)\n        diag_sum = 0.0\n        for i in range(size):\n            diag_sum += elements[i][i]\n        self.main_diagonal_sum = diag_sum\n        self._all_sums.append(diag_sum)\n\n    # Calculates and stores the sum of the anti-diagonal.\n    def calculate_anti_diagonal_sum(self, elements: list[list[float]]) -> None:\n        size = len(elements)\n        anti_diag_sum = 0.0\n        for i in range(size):\n            anti_diag_sum += elements[i][size - 1 - i]\n        self.anti_diagonal_sum = anti_diag_sum\n        self._all_sums.append(anti_diag_sum)\n\n    # Checks if all collected sums are equal.\n    def are_all_equal(self) -> bool:\n        if not self._all_sums:\n            return False # Should not happen if a valid square matrix was processed.\n        first_sum = self._all_sums[0]\n        for s in self._all_sums:\n            if s != first_sum:\n                return False\n        return True\nclass MagicSquareChecker:\n    # Orchestrates the process of checking if a given matrix is a magic square.\n    def check(self, matrix_data: list[list[float]]) -> bool:\n        matrix = Matrix(matrix_data)\n        if not matrix.is_square():\n            return False\n\n        sums = SumCollection()\n        sums.calculate_row_sums(matrix.elements)\n        sums.calculate_column_sums(matrix.elements)\n        sums.calculate_main_diagonal_sum(matrix.elements)\n        sums.calculate_anti_diagonal_sum(matrix.elements)\n\n        return sums.are_all_equal()\ndef magic_square_test(matrix_data: list[list[float]]) -> bool:\n    # Determines if the input matrix is a magic square.\n    checker = MagicSquareChecker()\n    return checker.check(matrix_data)"}
{"task_id": "Mbpp/130", "solution": "from typing import Any\ndef max_occurrences(input_list: list) -> Any:\n    \"\"\"\n    Identifies and returns the item with the highest frequency in the input list.\n    Returns None if the list is empty.\n    \"\"\"\n    if not input_list:\n        return None\n\n    counts = {}\n    for item in input_list:\n        counts[item] = counts.get(item, 0) + 1\n\n    max_count = -1\n    most_frequent_item = None\n\n    for item, count in counts.items():\n        if count > max_count:\n            max_count = count\n            most_frequent_item = item\n\n    return most_frequent_item"}
{"task_id": "Mbpp/131", "solution": "VOWELS_SET = {'a', 'e', 'i', 'o', 'u'}\ndef _is_vowel(char: str) -> bool:\n    \"\"\"\n    Checks if a given character is an English vowel (a, e, i, o, u), case-insensitive.\n    'y' is not considered a vowel.\n    \"\"\"\n    return char.lower() in VOWELS_SET\ndef reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels in the input string, preserving the positions of non-vowel characters.\n    Vowels are defined as 'a', 'e', 'i', 'o', 'u' (case-insensitive), with 'y' explicitly excluded.\n    \"\"\"\n    char_list = list(s)\n    vowel_indices = []\n    collected_vowels = []\n\n    for i, char in enumerate(char_list):\n        if _is_vowel(char):\n            vowel_indices.append(i)\n            collected_vowels.append(char)\n\n    collected_vowels.reverse()\n    reversed_vowel_ptr = 0\n\n    for idx in vowel_indices:\n        char_list[idx] = collected_vowels[reversed_vowel_ptr]\n        reversed_vowel_ptr += 1\n\n    return \"\".join(char_list)"}
{"task_id": "Mbpp/131", "solution": "_VOWELS = {'a', 'e', 'i', 'o', 'u'}\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel (a, e, i, o, u), case-insensitive.\"\"\"\n    return char.lower() in _VOWELS\ndef reverse_vowels(input_string: str) -> str:\n    \"\"\"Reverses only the vowels within a string, preserving non-vowel positions.\"\"\"\n    char_list = list(input_string)\n    vowel_indices = []\n    vowel_chars = []\n\n    for i, char in enumerate(char_list):\n        if _is_vowel(char):\n            vowel_indices.append(i)\n            vowel_chars.append(char)\n\n    vowel_chars.reverse()\n\n    for i, original_index in enumerate(vowel_indices):\n        char_list[original_index] = vowel_chars[i]\n\n    return \"\".join(char_list)"}
