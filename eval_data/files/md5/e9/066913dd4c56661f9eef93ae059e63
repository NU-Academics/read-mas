{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(list1: list, list2: list) -> bool:\n    \"\"\"\n    Checks if list2 is a contiguous sublist of list1.\n    Returns True if list2 is a contiguous sublist of list1, False otherwise.\n    \"\"\"\n    # An empty list2 is always considered a sublist of any list1.\n    if not list2:\n        return True\n\n    # If list2 is not empty but list1 is, list2 cannot be a sublist.\n    if not list1:\n        return False\n\n    n = len(list1)\n    m = len(list2)\n\n    # If list2 is longer than list1, it cannot be a sublist.\n    if m > n:\n        return False\n\n    # Iterate through list1 to find a matching contiguous subsegment.\n    for i in range(n - m + 1):\n        if list1[i:i+m] == list2:\n            return True\n\n    return False"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(list1: list, list2: list) -> bool:\n    \"\"\"\n    Checks if list2 is a contiguous sublist of list1.\n    Handles edge cases like empty lists.\n    \"\"\"\n    if len(list2) == 0:\n        return True\n\n    if len(list1) == 0:\n        return False\n\n    if len(list2) > len(list1):\n        return False\n\n    for i in range(len(list1) - len(list2) + 1):\n        if list1[i : i + len(list2)] == list2:\n            return True\n\n    return False"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n):\n    \"\"\"Calculates the last digit of the factorial of n.\n    Handles base cases for n < 5 and returns 0 for n >= 5.\"\"\"\n    if n == 0 or n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4\n    else:  # n >= 5\n        return 0"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    # Convert tuples to sets for efficient symmetric difference calculation and uniqueness.\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n\n    # Calculate the symmetric difference using the ^ operator.\n    # This efficiently finds elements in either set but not both, ensuring uniqueness.\n    symmetric_diff_set = set1 ^ set2\n\n    # Convert the resulting set back to a tuple.\n    return tuple(symmetric_diff_set)"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Finds elements that are dissimilar between two input tuples.\n    Elements are considered dissimilar if they are present in either tuple1 or tuple2, but not in both.\n    \"\"\"\n    set_a = set(tuple1)\n    set_b = set(tuple2)\n\n    dissimilar_elements = set_a.symmetric_difference(set_b)\n\n    return tuple(dissimilar_elements)"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"Interleaves elements from three input lists into a single flat list.\n    Elements are taken sequentially from list1, list2, then list3 for each index.\n    \"\"\"\n    interleaved_list = []\n    # Input lists are assumed to be of the same length.\n    # Iterate through indices, appending elements from each list in sequence.\n    for i in range(len(list1)):\n        interleaved_list.append(list1[i])\n        interleaved_list.append(list2[i])\n        interleaved_list.append(list3[i])\n    return interleaved_list"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Interleaves three input lists of the same length into a single flat output list.\n    Elements are grouped sequentially from corresponding indices (Nth from list1, then list2, then list3).\n    \"\"\"\n    result_list = []\n    # All lists are guaranteed to be of the same length.\n    for i in range(len(list1)):\n        result_list.append(list1[i])\n        result_list.append(list2[i])\n        result_list.append(list3[i])\n    return result_list"}
{"task_id": "Mbpp/569", "solution": "def sort_sublists(list_of_lists: list[list[str]]) -> list[list[str]]:\n    \"\"\"Sorts each sublist of strings in a list of lists alphabetically.\n\n    Args:\n        list_of_lists: A list of lists, where each inner list contains strings.\n\n    Returns:\n        A new list of lists where each inner list is sorted alphabetically.\n    \"\"\"\n    new_list_of_lists = []\n    for sublist in list_of_lists:\n        # Create a sorted copy of the sublist and append it to the new list.\n        new_list_of_lists.append(sorted(sublist))\n    return new_list_of_lists"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"Calculates the last digit of the factorial of a given non-negative integer.\n    This implementation efficiently determines the last digit based on mathematical properties of factorials.\"\"\"\n    if n == 0 or n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4\n    else:  # For n >= 5, n! will always end in 0.\n        return 0"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Recursively extracts even integer elements from a nested tuple,\n    preserving the original nesting structure.\n    Non-integer, non-tuple elements are retained as-is.\n    \"\"\"\n    result_list = []\n    for element in input_tuple:\n        if isinstance(element, tuple):\n            processed_nested_tuple = extract_even(element)\n            result_list.append(processed_nested_tuple)\n        elif isinstance(element, int):\n            if element % 2 == 0:\n                result_list.append(element)\n        else:\n            result_list.append(element)\n    return tuple(result_list)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Processes a nested mixed tuple, removing odd integer elements.\n    It recursively traverses nested tuples and retains other non-integer, non-tuple elements.\n    \"\"\"\n    result_list = []\n    for item in input_tuple:\n        if isinstance(item, tuple):\n            processed_sub_tuple = extract_even(item)\n            # Only append if the sub-tuple is not empty\n            # The example output (4, (6, (2, 4)), 6, 8) implies that empty tuples resulting from all odd numbers in a sub-tuple should not be removed.\n            # However, the problem statement says \"remove uneven elements\". If a sub-tuple contains only uneven elements,\n            # and they are all removed, the result is an empty tuple.\n            # The example `(7, 6, (2, 4))` becomes `(6, (2, 4))`, which is not empty.\n            # Let's re-evaluate: If a tuple like `(7, 9)` is passed, it should become `()`\n            # The current code will append `()` if `processed_sub_tuple` is empty.\n            # The expected output `(4, (6, (2, 4)), 6, 8)` does not remove empty tuples.\n            # So, appending even if empty is the correct behavior based on the example.\n            result_list.append(processed_sub_tuple)\n        elif isinstance(item, int):\n            if item % 2 == 0:\n                result_list.append(item)\n        else:\n            # For non-tuple, non-integer elements, keep them as is.\n            # The example doesn't show such cases, but the design implies mixed tuple.\n            result_list.append(item)\n    return tuple(result_list)"}
{"task_id": "Mbpp/581", "solution": "import math\ndef surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"\n    Calculates the total surface area of a square pyramid.\n    It takes the base edge length and height as input.\n    \"\"\"\n    half_base_edge = base_edge / 2\n    slant_height_squared = height**2 + half_base_edge**2\n    slant_height = math.sqrt(slant_height_squared)\n\n    base_area = base_edge**2\n    lateral_area = 2 * base_edge * slant_height\n\n    total_surface_area = base_area + lateral_area\n    return total_surface_area"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(input_list: list, n: int) -> list:\n    \"\"\"\n    Rotates a list by splitting it at index `n` and moving the first part to the end.\n    Returns the original list if `n` is an invalid index (less than 0 or greater than or equal to list length).\n    \"\"\"\n    if n < 0 or n >= len(input_list):\n        return input_list\n\n    first_part = input_list[0:n]\n    second_part = input_list[n:]\n\n    reordered_list = second_part + first_part\n    return reordered_list"}
