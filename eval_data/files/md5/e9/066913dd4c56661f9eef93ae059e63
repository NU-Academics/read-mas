{"task_id": "Mbpp/597", "solution": "def find_kth(arr1: list[int], arr2: list[int], k: int) -> int:\n    \"\"\"\n    Finds the kth smallest element from two sorted arrays using a binary search approach.\n    This function leverages partitioning to efficiently locate the desired element.\n    \"\"\"\n    m, n = len(arr1), len(arr2)\n\n    # `i` is the number of elements taken from arr1's left partition.\n    # `j` is the number of elements taken from arr2's left partition.\n    # We need `i + j = k` elements in total for the combined left partition.\n    # The valid range for `i` is determined by `k`, `m`, and `n`.\n    low = max(0, k - n)  # Ensures `j = k - i` is not greater than `n`.\n    high = min(k, m)     # Ensures `i` is not greater than `m` since `i` cannot be greater than len(arr1)\n\n    while low <= high:\n        i = low + (high - low) // 2\n        j = k - i\n\n        # L1, R1 are elements around the partition in arr1\n        # L2, R2 are elements around the partition in arr2\n        L1 = float('-inf') if i == 0 else arr1[i - 1]\n        R1 = float('inf') if i == m else arr1[i]\n\n        L2 = float('-inf') if j == 0 else arr2[j - 1]\n        R2 = float('inf') if j == n else arr2[j]\n\n        # Check if partitions are correctly placed (L1 <= R2 and L2 <= R1).\n        # This implies that the k-th element has been found.\n        if L1 <= R2 and L2 <= R1:\n            return max(L1, L2)\n        elif L1 > R2:\n            # L1 is too large, meaning too many elements were taken from arr1.\n            # Adjust the partition in arr1 to the left.\n            high = i - 1\n        else: # L2 > R1\n            # L2 is too large, meaning too few elements were taken from arr1.\n            # Adjust the partition in arr1 to the right.\n            low = i + 1"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"\n    Checks if a given number is an Armstrong number.\n    An Armstrong number is equal to the sum of its digits, each raised to the power of the total number of digits.\n    \"\"\"\n    original_number = number\n    num_digits = 0\n    temp_num_for_digit_count = number\n\n    if number == 0:\n        num_digits = 1\n    else:\n        while temp_num_for_digit_count > 0:\n            temp_num_for_digit_count //= 10\n            num_digits += 1\n\n    sum_of_powers = 0\n    temp_num_for_sum = original_number\n\n    while temp_num_for_sum > 0:\n        digit = temp_num_for_sum % 10\n        sum_of_powers += digit ** num_digits\n        temp_num_for_sum //= 10\n\n    return sum_of_powers == original_number"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is an Armstrong number.\n    An Armstrong number is equal to the sum of its own digits, each raised to the power of the number of digits.\n    \"\"\"\n    original_number = number\n\n    # Extract number of digits, mirroring Integer.get_number_of_digits() logic.\n    str_number = str(number)\n    num_digits = len(str_number)\n\n    # Extract individual digits, mirroring Integer.get_digits() logic.\n    digits_list = [int(d) for d in str_number]\n\n    # Calculate sum of each digit raised to the power of num_digits.\n    calculated_sum = 0\n    for digit in digits_list:\n        calculated_sum += digit ** num_digits\n\n    # Compare calculated sum with the original number.\n    return calculated_sum == original_number"}
{"task_id": "Mbpp/597", "solution": "def find_kth(array1: list[int], array2: list[int], k: int) -> int:\n    \"\"\"Finds the k-th smallest element from two given sorted arrays.\n    It uses a binary search approach to achieve optimal time complexity.\n    \"\"\"\n    len1, len2 = len(array1), len(array2)\n\n    # Ensure array1 is the shorter array for optimization\n    if len1 > len2:\n        array1, array2 = array2, array1\n        len1, len2 = len2, len1\n\n    # `k` is guaranteed to be within bounds: 1 <= k <= (len1 + len2)\n    # as per critical requirements.\n\n    low, high = max(0, k - len2), min(len1, k)\n\n    while low <= high:\n        mid1 = (low + high) // 2  # Number of elements taken from array1\n        mid2 = k - mid1          # Number of elements taken from array2\n\n        # Get elements at partition boundaries\n        # L1: element before mid1 in array1 (or negative infinity if mid1 is 0)\n        # R1: element at mid1 in array1 (or positive infinity if mid1 is len1)\n        # L2: element before mid2 in array2 (or negative infinity if mid2 is 0)\n        # R2: element at mid2 in array2 (or positive infinity if mid2 is len2)\n        L1 = array1[mid1 - 1] if mid1 > 0 else float('-inf')\n        R1 = array1[mid1] if mid1 < len1 else float('inf')\n        L2 = array2[mid2 - 1] if mid2 > 0 else float('-inf')\n        R2 = array2[mid2] if mid2 < len2 else float('inf')\n\n        if L1 <= R2 and L2 <= R1:\n            # Partition is correct, k-th element is max(L1, L2)\n            return max(L1, L2)\n        elif L1 > R2:\n            # Too many elements taken from array1, move partition left in array1\n            high = mid1 - 1\n        else: # L2 > R1\n            # Too few elements taken from array1, move partition right in array1\n            low = mid1 + 1"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n: int) -> tuple[float, float]:\n    \"\"\"\n    Calculates the sum and average of the first 'n' natural numbers.\n    Returns a tuple (sum, average).\n    \"\"\"\n    # Calculate sum using the formula: n * (n + 1) / 2\n    calculated_sum = (n * (n + 1)) / 2.0\n\n    # Calculate average using the formula: sum / n\n    calculated_average = calculated_sum / n\n\n    return (calculated_sum, calculated_average)"}
