{"task_id": "Mbpp/389", "solution": "def find_lucas(n):\n    \"\"\"\n    Calculates the n'th Lucas number using an iterative approach.\n    Handles base cases for L(0)=2 and L(1)=1.\n    \"\"\"\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    a, b = 2, 1  # Initialize with L(0) and L(1)\n    for _ in range(2, n + 1):\n        next_lucas = a + b\n        a = b\n        b = next_lucas\n    return b"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(data: list[tuple[str, int]]) -> tuple[str, int]:\n    \"\"\"Calculates the maximum aggregate score from a list of name-score tuples.\n    It aggregates scores by name and then finds the name with the highest total score.\"\"\"\n    aggregate_scores = {}\n\n    for name, score in data:\n        aggregate_scores[name] = aggregate_scores.get(name, 0) + score\n\n    if not aggregate_scores:\n        return (\"\", 0)\n\n    max_name = \"\"\n    max_score = -1\n\n    for name, total_score in aggregate_scores.items():\n        if total_score > max_score:\n            max_score = total_score\n            max_name = name\n\n    return (max_name, max_score)"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(list1: list, list2: list, list3: list) -> list[dict]:\n    \"\"\"Converts three input lists into a structured list of nested dictionaries.\n    Each dictionary maps an element from list1 to a nested dictionary of list2 and list3 elements.\"\"\"\n    result_list = []\n    for item1, item2, item3 in zip(list1, list2, list3):\n        inner_dict = {item2: item3}\n        outer_dict = {item1: inner_dict}\n        result_list.append(outer_dict)\n    return result_list"}
{"task_id": "Mbpp/392", "solution": "_memo: dict[int, int] = {}\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Calculates the maximum sum possible for a given integer n using a recursive equation.\n    Memoization is used to optimize performance by storing computed results.\n    \"\"\"\n    if n <= 0:\n        return 0\n    if n in _memo:\n        return _memo[n]\n\n    # Calculate the sum of recursive calls\n    sum_of_parts = (\n        get_max_sum(n // 2) +\n        get_max_sum(n // 3) +\n        get_max_sum(n // 4) +\n        get_max_sum(n // 5)\n    )\n\n    # The result is the maximum of n itself or the sum of its parts\n    result = max(n, sum_of_parts)\n    _memo[n] = result\n    return result"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(list1, list2, list3):\n    \"\"\"\n    Converts three lists into a list of nested dictionaries based on corresponding indices.\n    Each outer dictionary has a key from list1 and a value that is an inner dictionary.\n    \"\"\"\n    result = []\n    for item1, item2, item3 in zip(list1, list2, list3):\n        inner_dict = {item2: item3}\n        outer_dict = {item1: inner_dict}\n        result.append(outer_dict)\n    return result"}
