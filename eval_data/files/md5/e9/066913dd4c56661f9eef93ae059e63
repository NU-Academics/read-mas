{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, char_to_remove: str) -> str:\n    \"\"\"\n    Removes the first and last occurrences of a specified character from a string.\n    Returns the original string if the character is not found.\n    \"\"\"\n    first_idx = input_string.find(char_to_remove)\n    last_idx = input_string.rfind(char_to_remove)\n\n    if first_idx == -1:\n        # Character not found, return the original string\n        return input_string\n\n    s_list = list(input_string)\n\n    if first_idx == last_idx:\n        # Character appears only once, remove that single occurrence\n        s_list.pop(first_idx)\n    else:\n        # Multiple occurrences, remove last then first to handle index shifts\n        s_list.pop(last_idx)\n        s_list.pop(first_idx)\n\n    return \"\".join(s_list)"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(input_string: str) -> int:\n    \"\"\"\n    Calculates the minimum number of rotations (greater than 0) required\n    to transform the input string back to its original form. Returns 0 for an empty string.\n    \"\"\"\n    n = len(input_string)\n    if n == 0:\n        return 0\n\n    for i in range(1, n + 1):\n        rotated_string = input_string[i:] + input_string[:i]\n        if rotated_string == input_string:\n            return i\n    # This part should ideally not be reached if the string is non-empty,\n    # as a full rotation (n) will always match the original.\n    # However, the problem statement implies a return value will always be found.\n    return n"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, char_to_remove: str) -> str:\n    \"\"\"Removes the first and last occurrences of a specified character from a string.\n    If the character appears only once, that single occurrence is removed.\"\"\"\n    first_idx = input_string.find(char_to_remove)\n\n    if first_idx == -1:\n        return input_string\n\n    last_idx = input_string.rfind(char_to_remove)\n\n    if first_idx == last_idx:\n        # Character appears only once, remove that single occurrence\n        return input_string[:first_idx] + input_string[first_idx + 1:]\n    else:\n        # Character appears multiple times, remove first and last\n        return input_string[:first_idx] + input_string[first_idx + 1:last_idx] + input_string[last_idx + 1:]"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(input_string: str) -> int:\n    \"\"\"\n    Calculates the minimum number of rotations (greater than 0) required for a string\n    to return to its original state.\n    \"\"\"\n    n = len(input_string)\n\n    if n <= 1:\n        return 1\n\n    for i in range(1, n):\n        rotated_string = input_string[i:] + input_string[:i]\n        if rotated_string == input_string:\n            return i\n\n    # If no rotation less than n brings it back, it means n rotations are required\n    # for a non-repeating string (e.g., \"abc\").\n    # The problem asks for \"minimum number of rotations (greater than 0) required to get the same string.\"\n    # If no smaller period is found, the period is then `n`.\n    return n"}
