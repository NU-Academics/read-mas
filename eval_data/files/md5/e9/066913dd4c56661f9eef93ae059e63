{"task_id": "Mbpp/286", "solution": "def kadane(arr: list[int]) -> int:\n    \"\"\"Finds the maximum subarray sum in a single array.\n    Handles cases where all numbers are negative by returning the largest single element.\"\"\"\n    if not arr:\n        return 0\n\n    current_max = arr[0]\n    global_max = arr[0]\n\n    for i in range(1, len(arr)):\n        current_max = max(arr[i], current_max + arr[i])\n        global_max = max(global_max, current_max)\n\n    return global_max\ndef max_sub_array_sum_repeated(a: list[int], n: int, k: int) -> int:\n    \"\"\"Finds the largest sum of a contiguous subarray in a repeated array.\n    Considers various scenarios for k and the total sum of a.\"\"\"\n\n    if k == 1:\n        return kadane(a)\n\n    max_sub_array_sum_single = kadane(a)\n    total_sum = sum(a)\n\n    max_prefix_sum = float('-inf')\n    current_prefix_sum = 0\n    for x in a:\n        current_prefix_sum += x\n        max_prefix_sum = max(max_prefix_sum, current_prefix_sum)\n    if n == 0: # Handle empty array case, though problem usually implies non-empty\n        max_prefix_sum = 0\n\n    max_suffix_sum = float('-inf')\n    current_suffix_sum = 0\n    for i in range(n - 1, -1, -1):\n        current_suffix_sum += a[i]\n        max_suffix_sum = max(max_suffix_sum, current_suffix_sum)\n    if n == 0: # Handle empty array case\n        max_suffix_sum = 0\n\n    overall_max_sum = max_sub_array_sum_single\n\n    # Consider subarrays spanning two blocks (suffix of first + prefix of second)\n    overall_max_sum = max(overall_max_sum, max_prefix_sum + max_suffix_sum)\n\n    # If total_sum is positive, additional full blocks contribute positively to the sum\n    if total_sum > 0 and k > 2:\n        overall_max_sum = max(overall_max_sum, max_prefix_sum + (k - 2) * total_sum + max_suffix_sum)\n\n    return overall_max_sum"}
{"task_id": "Mbpp/292", "solution": "import math\ndef find(dividend, divisor):\n    \"\"\"\n    Calculates the quotient of two numbers, rounding the result down to the nearest integer.\n    This function performs floating-point division and then applies floor rounding.\n    \"\"\"\n    raw_quotient = dividend / divisor\n    rounded_quotient = math.floor(raw_quotient)\n    return int(rounded_quotient)"}
{"task_id": "Mbpp/293", "solution": "import math\ndef otherside_rightangle(leg1: float, leg2: float) -> float:\n    \"\"\"Calculates the hypotenuse of a right-angled triangle.\n    Uses the Pythagorean theorem: sqrt(leg1^2 + leg2^2).\n    \"\"\"\n    leg1_squared = math.pow(leg1, 2)\n    leg2_squared = math.pow(leg2, 2)\n    sum_of_squares = leg1_squared + leg2_squared\n    hypotenuse = math.sqrt(sum_of_squares)\n    return hypotenuse"}
{"task_id": "Mbpp/294", "solution": "def max_val(input_list: list):\n    \"\"\"\n    Identifies and returns the maximum numerical value from a heterogeneous list.\n    Ignores non-numerical elements and raises ValueError if no numbers are found.\n    \"\"\"\n    max_found_value = None\n\n    for item in input_list:\n        # Consider only numerical values (integers and floats).\n        if isinstance(item, (int, float)):\n            if max_found_value is None or item > max_found_value:\n                max_found_value = item\n\n    if max_found_value is None:\n        raise ValueError(\"No numerical values found in the list.\")\n\n    return max_found_value"}
