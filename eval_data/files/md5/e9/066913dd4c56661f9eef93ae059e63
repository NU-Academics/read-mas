{"task_id": "Mbpp/731", "solution": "import math\nPI = 3.141592653589793\ndef _calculate_slant_height(r: float, h: float) -> float:\n    \"\"\"Calculates the slant height of a cone using radius and height.\"\"\"\n    return math.sqrt(r**2 + h**2)\ndef lateralsurface_cone(r: float, h: float) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n    This uses the formula \u03c0 * r * l, where l is the slant height.\n    \"\"\"\n    slant_height = _calculate_slant_height(r, h)\n    return PI * r * slant_height"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(numbers: list[int | float]) -> int:\n    \"\"\"Calculates the sum of products of all possible sublists from the input list.\n    It iterates through all sublists, computes their product, and sums these products.\"\"\"\n    total_sum = 0\n\n    # Iterate through all possible starting indices 'i'\n    for i in range(len(numbers)):\n        # Iterate through all possible ending indices 'j' for the current starting index 'i'\n        for j in range(i, len(numbers)):\n            # Extract the sublist from index 'i' to 'j' (inclusive)\n            sublist = numbers[i : j + 1]\n\n            # Calculate the product of elements in the current sublist\n            product_of_sublist = 1\n            for num in sublist:\n                product_of_sublist *= num\n\n            # Add the sublist's product to the total sum\n            total_sum += product_of_sublist\n\n    # The final result is explicitly stated to be an integer.\n    return int(total_sum)"}
{"task_id": "Mbpp/734", "solution": "from typing import List\ndef _calculate_product_of_list(sublist: List[int]) -> int:\n    \"\"\"Calculates the product of all elements in a given list.\n    Returns 1 for an empty list, adhering to the multiplicative identity.\n    \"\"\"\n    product = 1\n    for item in sublist:\n        product *= item\n    return product\ndef sum_Of_Subarray_Prod(arr: List[int]) -> int:\n    \"\"\"Calculates the sum of products of all possible contiguous sublists of the input list.\n    It iterates through all sublists, calculates their product using a helper, and sums them up.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        for j in range(i, n):\n            current_sublist = arr[i : j + 1]\n            product_of_sublist = _calculate_product_of_list(current_sublist)\n            total_sum += product_of_sublist\n\n    return total_sum"}
{"task_id": "Mbpp/737", "solution": "import re\ndef check_str(input_string):\n    \"\"\"Checks if the string starts with a vowel (a, e, i, o, u), case-insensitive, using regex.\"\"\"\n    # Define a regex pattern to match the start of the string followed by any vowel.\n    # re.IGNORECASE flag makes the vowel matching case-insensitive.\n    pattern = r\"^[aeiou]\"\n\n    # Use re.match() to check if the string matches the pattern from its beginning.\n    # re.match returns a match object if successful, None otherwise.\n    if re.match(pattern, input_string, re.IGNORECASE):\n        return True"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"\n    Inverts the inner bits of an integer, preserving its MSB and LSB.\n    Numbers with 0, 1, or 2 bits are returned unchanged as they have no inner bits.\n    \"\"\"\n    bin_num = bin(number)[2:]\n\n    if len(bin_num) <= 2:\n        return number\n\n    msb = bin_num[0]\n    lsb = bin_num[-1]\n    inner_bits = bin_num[1:-1]\n\n    inverted_inner_bits = \"\".join('1' if bit == '0' else '0' for bit in inner_bits)\n\n    new_bin_string = msb + inverted_inner_bits + lsb\n    return int(new_bin_string, 2)"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(n: int) -> int:\n    \"\"\"Toggles all bits of n except its most significant (MSB) and least significant (LSB).\n    If n has 0, 1, or 2 bits, no middle bits exist, so the original number is returned.\n    \"\"\"\n    length = n.bit_length()\n\n    if length <= 2:\n        return n\n\n    # Construct a bitmask with '1's at all middle bit positions and '0's at MSB and LSB.\n    all_ones_mask = (1 << length) - 1\n    mask_for_msb = (1 << (length - 1))\n    mask_without_msb = all_ones_mask ^ mask_for_msb\n    mask_for_lsb = (1 << 0)\n    final_mask = mask_without_msb ^ mask_for_lsb\n\n    # Perform a bitwise XOR operation between n and the constructed mask.\n    result = n ^ final_mask\n    return result"}
{"task_id": "Mbpp/736", "solution": "from typing import List, Union\ndef left_insertion(sorted_list: List[Union[int, float]], value: Union[int, float]) -> int:\n    \"\"\"\n    Locates the left insertion point for a value in a sorted list using binary search.\n    Returns the index where the value should be inserted to maintain sorted order.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else: # sorted_list[mid] >= value\n            high = mid\n    return low"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr: list, num: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array using binary search.\n    It returns the index or -1 if the number is not found.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    potential_result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n\n        if arr[mid] == num:\n            potential_result = mid\n            high = mid - 1  # Continue searching in the left half for an earlier occurrence\n        elif arr[mid] < num:\n            low = mid + 1   # Search in the right half\n        else: # arr[mid] > num\n            high = mid - 1  # Search in the left half\n\n    return potential_result"}
{"task_id": "Mbpp/739", "solution": "def _calculate_triangular_number(k: int) -> int:\n    \"\"\"Calculates the k-th triangular number T_k.\"\"\"\n    return k * (k + 1) // 2\ndef _get_number_of_digits(num: int) -> int:\n    \"\"\"Determines the number of digits in a positive integer.\"\"\"\n    return len(str(num))\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with exactly 'n' digits.\n    It iteratively calculates triangular numbers and checks their digit count.\n    \"\"\"\n    k = 1\n    while True:\n        triangular_number = _calculate_triangular_number(k)\n        digits_in_tn = _get_number_of_digits(triangular_number)\n        if digits_in_tn == n:\n            return k\n        k += 1"}
{"task_id": "Mbpp/736", "solution": "from typing import Any\ndef left_insertion(sorted_list: list, value: Any) -> int:\n    \"\"\"Finds the leftmost insertion point for a value in a sorted list using binary search.\n    Returns the index where the value should be inserted to maintain sorted order.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple: tuple) -> dict:\n    \"\"\"\n    Converts a tuple into a dictionary using adjacent elements as key-value pairs.\n    Handles odd-length tuples by ignoring the last element.\n    \"\"\"\n    result_dict = {}\n    # Iterate through the tuple in steps of two, effectively processing pairs.\n    # The loop range handles odd-length tuples by stopping before the last element.\n    for i in range(0, len(input_tuple) // 2 * 2, 2):\n        key = input_tuple[i]\n        value = input_tuple[i + 1]\n        result_dict[key] = value\n    return result_dict"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple: tuple) -> dict:\n    \"\"\"\n    Converts a tuple into a dictionary by pairing adjacent elements.\n    The last element is ignored if the tuple has an odd number of elements.\n    \"\"\"\n    result_dict = {}\n    for i in range(0, len(input_tuple), 2):\n        if i + 1 < len(input_tuple):\n            key = input_tuple[i]\n            value = input_tuple[i + 1]\n            result_dict[key] = value\n    return result_dict"}
