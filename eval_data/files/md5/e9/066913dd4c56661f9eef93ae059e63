{"task_id": "Mbpp/141", "solution": "def pancake_sort(input_list: list) -> list:\n    \"\"\"Sorts a list of integers using the Pancake Sort algorithm.\n    It returns a new sorted list without modifying the original input.\n    \"\"\"\n\n    def _flip(arr: list, k: int):\n        \"\"\"Reverses the prefix of the list up to and including index k.\"\"\"\n        arr[:k+1] = arr[:k+1][::-1]\n\n    def _find_max_idx(arr: list, n: int) -> int:\n        \"\"\"Finds the index of the maximum element in the first n elements of the list.\"\"\"\n        max_idx = 0\n        for i in range(1, n):\n            if arr[i] > arr[max_idx]:\n                max_idx = i\n        return max_idx\n\n    n = len(input_list)\n    current_arr = list(input_list) # Create a mutable copy for sorting.\n\n    # Iterate from the full list size down to 1 (the last element doesn't need to be sorted).\n    for curr_size in range(n, 1, -1):\n        # Find the index of the maximum element in the unsorted portion (0 to curr_size-1).\n        max_idx = _find_max_idx(current_arr, curr_size)\n\n        # If the maximum element is not already in its correct sorted position.\n        if max_idx != curr_size - 1:\n            # Move the maximum element to the beginning if it's not already there.\n            if max_idx != 0:\n                _flip(current_arr, max_idx)\n            # Move the maximum element from the beginning to its correct sorted position.\n            _flip(current_arr, curr_size - 1)\n\n    return current_arr"}
{"task_id": "Mbpp/140", "solution": "from collections.abc import Iterable as AbcIterable\ndef extract_singly(input_list: list[AbcIterable]) -> set[int]:\n    \"\"\"\n    Extracts all unique integer numeric elements from a list of nested iterables.\n    It flattens the input and collects all encountered elements into a set.\n    \"\"\"\n    unique_numbers = set()\n    for iterable_item in input_list:\n        for element in iterable_item:\n            if isinstance(element, int):\n                unique_numbers.add(element)\n    return unique_numbers"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1: list, list2: list, list3: list) -> int:\n    \"\"\"Counts items identical at the same position across three lists.\n    It iterates up to the length of the shortest list and compares elements at each index.\n    \"\"\"\n    min_length = min(len(list1), len(list2), len(list3))\n    count = 0\n\n    for i in range(min_length):\n        item1 = list1[i]\n        item2 = list2[i]\n        item3 = list3[i]\n\n        if item1 == item2 and item2 == item3:\n            count += 1\n\n    return count"}
