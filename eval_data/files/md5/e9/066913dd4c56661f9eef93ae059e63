{"task_id": "Mbpp/615", "solution": "def average_tuple(data: tuple[tuple[int | float, ...], ...]) -> list[float]:\n    \"\"\"\n    Calculates the average value for each inner tuple in a tuple of tuples.\n    Returns 0.0 for empty inner tuples and averages for numeric values otherwise.\n    \"\"\"\n    averages = []\n    for inner_tuple in data:\n        if not inner_tuple:\n            averages.append(0.0)\n        else:\n            current_sum = sum(inner_tuple)\n            current_count = len(inner_tuple)\n            averages.append(float(current_sum) / current_count)\n    return averages"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(data):\n    \"\"\"\n    Calculates the average for each inner tuple in a tuple of tuples.\n    Returns these averages as a list of floats.\n    \"\"\"\n    averages = []\n    for inner_tuple in data:\n        if not inner_tuple:\n            # Handle empty inner tuples as per design specification.\n            current_average = 0.0\n        else:\n            # Compute sum and count for non-empty tuples.\n            current_average = sum(inner_tuple) / len(inner_tuple)\n\n        # Ensure the average is a float and add to the results list.\n        averages.append(float(current_average))\n\n    return averages"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(input_tuple_1: tuple, input_tuple_2: tuple) -> tuple:\n    \"\"\"\n    Performs an element-wise modulo operation on two input tuples of the same length.\n    Raises ValueError if the tuples have different lengths.\n    \"\"\"\n    if len(input_tuple_1) != len(input_tuple_2):\n        raise ValueError(\"Tuples must be of the same length\")\n\n    result_list = []\n    for i in range(len(input_tuple_1)):\n        result_list.append(input_tuple_1[i] % input_tuple_2[i])\n\n    return tuple(result_list)"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1, tuple2):\n    \"\"\"\n    Performs an element-wise modulo operation on two input tuples.\n    Assumes both input tuples are of the same length.\n    \"\"\"\n    return tuple(a % b for a, b in zip(tuple1, tuple2))"}
