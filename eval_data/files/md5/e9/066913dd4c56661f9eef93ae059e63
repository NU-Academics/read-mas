{"task_id": "Mbpp/68", "solution": "def _check_non_increasing(input_list):\n    \"\"\"Checks if a list is non-increasing (each element is less than or equal to the previous).\"\"\"\n    for i in range(len(input_list) - 1):\n        if input_list[i] < input_list[i + 1]:\n            return False\n    return True\ndef _check_non_decreasing(input_list):\n    \"\"\"Checks if a list is non-decreasing (each element is greater than or equal to the previous).\"\"\"\n    for i in range(len(input_list) - 1):\n        if input_list[i] > input_list[i + 1]:\n            return False\n    return True\ndef is_Monotonic(input_list):\n    \"\"\"Determines if a list is monotonic (either entirely non-increasing or non-decreasing).\"\"\"\n    return _check_non_increasing(input_list) or _check_non_decreasing(input_list)"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sub_list: list) -> bool:\n  \"\"\"\n  Checks if a sub_list is present in main_list, maintaining relative order but not necessarily contiguity.\n  Returns True if sub_list is found, False otherwise.\n  \"\"\"\n  if not sub_list:\n      return True\n\n  sub_index = 0\n  for main_item in main_list:\n      if sub_index < len(sub_list) and main_item == sub_list[sub_index]:\n          sub_index += 1\n  return sub_index == len(sub_list)"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(arr: list) -> bool:\n    \"\"\"Checks if an array is monotonic (either increasing or decreasing).\n    An array with zero or one element is considered monotonic.\"\"\"\n    if len(arr) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i - 1]:\n            is_increasing = False\n        if arr[i] > arr[i - 1]:\n            is_decreasing = False\n\n        # Optimization: If it's neither increasing nor decreasing, we can stop early.\n        if not is_increasing and not is_decreasing:\n            return False\n\n    return is_increasing or is_decreasing"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number, representing the number of ways to partition a set of n elements.\n    It utilizes dynamic programming to compute Stirling numbers of the second kind.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # dp_stirling[i][j] stores S(i, j), the Stirling number of the second kind.\n    # S(i, j) is the number of ways to partition a set of i elements into j non-empty subsets.\n    dp_stirling = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Base case: S(0, 0) = 1 (one way to partition an empty set into zero subsets).\n    dp_stirling[0][0] = 1\n\n    # Fill the DP table for Stirling numbers of the second kind.\n    for i in range(1, n + 1):\n        for j in range(1, i + 1):\n            # Recurrence relation: S(i, j) = S(i-1, j-1) + j * S(i-1, j)\n            dp_stirling[i][j] = dp_stirling[i-1][j-1] + j * dp_stirling[i-1][j]\n            # Note: S(i, 0) remains 0 for i > 0, which is correctly initialized.\n\n    # The nth Bell number B_n is the sum of S(n, k) for k from 0 to n.\n    nth_bell = 0\n    for k in range(n + 1):\n        nth_bell += dp_stirling[n][k]\n\n    return nth_bell"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list, sub_list):\n    \"\"\"\n    Checks if `sub_list` is a contiguous sequence within `main_list`.\n    Returns True if `sub_list` is empty or found, False otherwise.\n    \"\"\"\n    if not sub_list:\n        return True\n\n    len_main = len(main_list)\n    len_sub = len(sub_list)\n\n    if len_sub > len_main:\n        return False\n\n    for i in range(len_main - len_sub + 1):\n        # Extract a slice of main_list equal to the length of sub_list\n        # and compare it directly.\n        if main_list[i : i + len_sub] == sub_list:\n            return True\n\n    return False"}
