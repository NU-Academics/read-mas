{"task_id": "Mbpp/245", "solution": "def _calculate_lis_sums(arr: list[int]) -> list[int]:\n    \"\"\"Calculates maximum sum of an increasing subsequence ending at each index.\"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n    lis_sums = list(arr)\n    for i in range(1, n):\n        for j in range(i):\n            if arr[j] < arr[i]:\n                lis_sums[i] = max(lis_sums[i], lis_sums[j] + arr[i])\n    return lis_sums\ndef _calculate_lds_sums(arr: list[int]) -> list[int]:\n    \"\"\"Calculates maximum sum of a decreasing subsequence starting at each index.\"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n    lds_sums = list(arr)\n    for i in range(n - 2, -1, -1):\n        for j in range(n - 1, i, -1):\n            if arr[j] < arr[i]:\n                lds_sums[i] = max(lds_sums[i], lds_sums[j] + arr[i])\n    return lds_sums\ndef max_sum(array_of_numbers: list[int]) -> int:\n    \"\"\"Calculates the maximum sum of a bitonic subsequence within the given array.\"\"\"\n    n = len(array_of_numbers)\n    if n == 0:\n        return 0\n    if n == 1:\n        return array_of_numbers[0]\n\n    lis_sums = _calculate_lis_sums(array_of_numbers)\n    lds_sums = _calculate_lds_sums(array_of_numbers)\n\n    max_bitonic_sum = 0\n    for i in range(n):\n        # Subtract array_of_numbers[i] once as it's included in both LIS and LDS sums\n        current_bitonic_sum = lis_sums[i] + lds_sums[i] - array_of_numbers[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n\n    return max_bitonic_sum"}
{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the total number of sequences of length n with elements up to m.\n    Each element must be a positive integer and at least twice the previous one.\n    \"\"\"\n\n    memo = {}\n\n    def _count_sequences_recursive(current_length: int, prev_element: int) -> int:\n        \"\"\"\n        Recursively counts valid sequences starting from prev_element for remaining length.\n        Uses memoization to store results of subproblems.\n        \"\"\"\n        if current_length == n:\n            return 1\n\n        if (current_length, prev_element) in memo:\n            return memo[(current_length, prev_element)]\n\n        count = 0\n        start_next = prev_element * 2\n        for next_element in range(start_next, m + 1):\n            count += _count_sequences_recursive(current_length + 1, next_element)\n\n        memo[(current_length, prev_element)] = count\n        return count\n\n    total_count = 0\n    for start_val in range(1, m + 1):\n        total_count += _count_sequences_recursive(1, start_val)\n\n    return total_count"}
{"task_id": "Mbpp/245", "solution": "def _calculate_lis_sums(arr: list[int]) -> list[int]:\n    \"\"\"\n    Calculates the maximum sum of an increasing subsequence ending at each index.\n    Initializes each sum with the element itself, then iterates to extend subsequences.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n    lis_sums = list(arr)\n    for i in range(1, n):\n        for j in range(i):\n            if arr[i] > arr[j]:\n                lis_sums[i] = max(lis_sums[i], lis_sums[j] + arr[i])\n    return lis_sums\ndef _calculate_lds_sums(arr: list[int]) -> list[int]:\n    \"\"\"\n    Calculates the maximum sum of a decreasing subsequence starting at each index.\n    Initializes each sum with the element itself, then iterates backward to extend subsequences.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n    lds_sums = list(arr)\n    for i in range(n - 2, -1, -1):\n        for j in range(i + 1, n):\n            if arr[i] > arr[j]:\n                lds_sums[i] = max(lds_sums[i], lds_sums[j] + arr[i])\n    return lds_sums\ndef max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence for the given array.\n    A bitonic sequence is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    lis_sums = _calculate_lis_sums(arr)\n    lds_sums = _calculate_lds_sums(arr)\n\n    max_bitonic_sum = 0\n    for i in range(n):\n        # The peak element arr[i] is counted in both LIS ending at i and LDS starting at i.\n        # So, subtract it once to get the correct total sum for a bitonic subsequence.\n        current_bitonic_sum = lis_sums[i] + lds_sums[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n\n    return max_bitonic_sum"}
