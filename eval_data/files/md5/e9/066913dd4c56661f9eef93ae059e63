{"task_id": "Mbpp/94", "solution": "def index_minimum(list_of_tuples):\n    \"\"\"\n    Finds the tuple with the smallest second value and returns its first value.\n    Returns None if the input list of tuples is empty.\n    \"\"\"\n    if not list_of_tuples:\n        return None\n\n    # Initialize with the first tuple's values\n    min_second_value = list_of_tuples[0][1]\n    result_first_value = list_of_tuples[0][0]\n\n    # Iterate through the rest of the tuples to find the minimum\n    for first_value, second_value in list_of_tuples[1:]:\n        if second_value < min_second_value:\n            min_second_value = second_value\n            result_first_value = first_value\n\n    return result_first_value"}
{"task_id": "Mbpp/94", "solution": "from typing import List, Tuple, Any, Union\ndef index_minimum(list_of_tuples: List[Tuple[Any, Union[int, float]]]) -> Any:\n    \"\"\"\n    Finds the first value of the tuple with the smallest second numerical value.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not list_of_tuples:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    min_tuple = min(list_of_tuples, key=lambda item: item[1])\n    return min_tuple[0]"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(num: int) -> bool:\n    \"\"\"\n    Checks if a given integer is an undulating number.\n    An undulating number has at least 3 digits, strictly alternating between exactly two distinct digits.\n    \"\"\"\n    str_num = str(num)\n\n    # An undulating number must have at least 3 digits.\n    if len(str_num) < 3:\n        return False\n\n    # Identify the unique digits present in the number.\n    distinct_digits_in_num = set(str_num)\n\n    # An undulating number must strictly alternate between exactly two distinct digits.\n    if len(distinct_digits_in_num) != 2:\n        return False\n\n    # Determine the two alternating digits from the first two positions.\n    expected_even_digit = str_num[0]\n    expected_odd_digit = str_num[1]\n\n    # The two alternating digits must be distinct.\n    if expected_even_digit == expected_odd_digit:\n        return False\n\n    # Check for strict alternation throughout the number.\n    for i in range(len(str_num)):\n        if i % 2 == 0:  # Even index (0, 2, 4...)\n            if str_num[i] != expected_even_digit:\n                return False\n        else:  # Odd index (1, 3, 5...)\n            if str_num[i] != expected_odd_digit:\n                return False\n\n    # If all checks pass, the number is undulating.\n    return True"}
