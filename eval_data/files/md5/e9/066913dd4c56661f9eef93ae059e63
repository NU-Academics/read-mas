{"task_id": "Mbpp/743", "solution": "def rotate_right(input_list, k):\n    \"\"\"\n    Rotates a list to the right by k positions.\n    Handles edge cases and normalizes k before slicing.\n    \"\"\"\n    n = len(input_list)\n\n    if n <= 1:\n        return input_list\n\n    effective_k = k % n\n\n    # Form the rotated list by concatenating the last part with the first part.\n    rotated_list = input_list[n - effective_k:] + input_list[:n - effective_k]\n\n    return rotated_list"}
{"task_id": "Mbpp/743", "solution": "def rotate_right(input_list: list, n: int) -> list:\n    \"\"\"\n    Rotates the input_list by n items to the right, with elements wrapping around.\n    Returns a new list with the rotated elements.\n    \"\"\"\n    if not input_list:\n        return []\n    list_length = len(input_list)\n    if list_length == 0:\n        return []\n    effective_n = n % list_length\n    if effective_n == 0:\n        return list(input_list)\n\n    return input_list[list_length - effective_n:] + input_list[:list_length - effective_n]"}
{"task_id": "Mbpp/733", "solution": "from typing import List\ndef find_first_occurrence(arr: List[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array using binary search.\n    Returns the 0-based index or -1 if the target is not found.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    first_occurrence_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == target:\n            first_occurrence_index = mid  # Store potential answer.\n            high = mid - 1  # Try to find an earlier occurrence in the left half.\n        elif arr[mid] < target:\n            low = mid + 1\n        else:  # arr[mid] > target\n            high = mid - 1\n    return first_occurrence_index"}
{"task_id": "Mbpp/745", "solution": "def _contains_zero(num: int) -> bool:\n    \"\"\"Checks if a number contains the digit '0'.\"\"\"\n    return '0' in str(num)\ndef _is_divisible_by_all_non_zero_digits(num: int) -> bool:\n    \"\"\"Checks if a number is divisible by all of its non-zero digits.\"\"\"\n    for char_digit in str(num):\n        digit = int(char_digit)\n        # Numbers containing '0' are already filtered by _contains_zero,\n        # so digit will never be 0 here.\n        if num % digit != 0:\n            return False\n    return True\ndef divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a range that are divisible by all of their non-zero digits.\n    Numbers containing the digit '0' are excluded.\n    \"\"\"\n    result_list = []\n    for current_num in range(startnum, endnum + 1):\n        if not _contains_zero(current_num):\n            if _is_divisible_by_all_non_zero_digits(current_num):\n                result_list.append(current_num)\n    return result_list"}
