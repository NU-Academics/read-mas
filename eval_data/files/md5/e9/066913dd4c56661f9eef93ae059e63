{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers: list) -> int:\n    \"\"\"Calculates the absolute difference between the first even and first odd number.\n\n    Raises ValueError if an even or odd number is not found.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    if not numbers:\n        raise ValueError(\"List is empty, no even or odd numbers found.\")\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n\n        # Optimization: If both numbers are found, we can stop iterating.\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is None:\n        raise ValueError(\"No even number found in the list.\")\n    if first_odd is None:\n        raise ValueError(\"No odd number found in the list.\")\n\n    return int(abs(first_even - first_odd))"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(n: int) -> list[int]:\n    \"\"\"Generates Ludic numbers up to n using a sieve process.\n    The sieve progressively removes elements from a working list.\n    \"\"\"\n    if n <= 0:\n        return []\n    if n == 1:\n        return [1]\n\n    ludic_numbers = [1]\n    # Initialize the working list with numbers from 2 up to n.\n    sieve_list = list(range(2, n + 1))\n\n    while sieve_list:\n        current_ludic = sieve_list[0]\n        ludic_numbers.append(current_ludic)\n\n        # Create the next working list by removing elements.\n        next_sieve_list = []\n        # The sieve removes every current_ludic-th element\n        # from the sequence *after* current_ludic itself is taken.\n        for i, val in enumerate(sieve_list[1:]):\n            position = i + 1  # 1-based position in the 'remaining' part of the list\n            if position % current_ludic != 0:\n                next_sieve_list.append(val)\n\n        sieve_list = next_sieve_list\n\n    return ludic_numbers"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(n: int) -> list[int]:\n    \"\"\"\n    Calculates and returns a list of all Ludic numbers less than or equal to n.\n    It employs a sieve-like algorithm to identify these numbers.\n    \"\"\"\n    if n < 1:\n        return []\n\n    if n == 1:\n        return [1]\n\n    numbers = list(range(1, n + 1))\n    ludic_numbers = []\n\n    while numbers:\n        current_ludic = numbers.pop(0)\n        ludic_numbers.append(current_ludic)\n\n        # Optimization: stop if current_ludic exceeds n. (Note: this condition is generally unreachable\n        # because numbers are initialized up to n, but it's included as per design.)\n        if current_ludic > n:\n            break\n\n        # Special case for 1: it removes no elements based on its value.\n        if current_ludic == 1:\n            continue\n\n        temp_numbers = []\n        count = 0  # 1-based position for removal logic\n        for num in numbers:\n            count += 1\n            if count % current_ludic != 0:\n                temp_numbers.append(num)\n        numbers = temp_numbers\n\n    return ludic_numbers"}
