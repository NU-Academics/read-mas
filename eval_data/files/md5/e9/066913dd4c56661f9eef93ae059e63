{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(input_array: tuple[float | int, ...]) -> float | int:\n    \"\"\"\n    Calculates the maximum absolute difference between any two elements in the given array.\n    Raises ValueError if the input_array contains fewer than two elements.\n    \"\"\"\n    if len(input_array) < 2:\n        raise ValueError(\"Input array must contain at least two elements.\")\n\n    min_val = min(input_array)\n    max_val = max(input_array)\n\n    return abs(max_val - min_val)"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(input_array: tuple | list) -> int:\n    \"\"\"Calculates the largest absolute difference between any two elements in the input array.\n    Assumes input_array contains at least two numerical elements.\"\"\"\n\n    max_abs_diff_val = 0\n\n    n = len(input_array)\n    for i in range(n):\n        for j in range(i + 1, n):\n            current_diff = abs(input_array[i] - input_array[j])\n            if current_diff > max_abs_diff_val:\n                max_abs_diff_val = current_diff\n\n    # Convert the maximum absolute difference to an integer using truncation.\n    return int(max_abs_diff_val)"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a list of comparable elements in ascending order using the pancake sort algorithm.\n\n    Args:\n        input_list: A list of elements that can be compared.\n\n    Returns:\n        A new list containing the elements from input_list, sorted in ascending order.\n    \"\"\"\n    arr = list(input_list)\n    n = len(arr)\n\n    # Helper function to flip a sub-list from index 0 up to k (inclusive).\n    def _flip(current_arr: list, k: int):\n        start = 0\n        while start < k:\n            current_arr[start], current_arr[k] = current_arr[k], current_arr[start]\n            start += 1\n            k -= 1\n\n    # Main pancake sort logic: iterate from the full list size down to 2 elements.\n    for curr_size in range(n, 1, -1):\n        # Find the index of the maximum element in the current unsorted part (0 to curr_size - 1).\n        max_val_idx = 0\n        for i in range(1, curr_size):\n            if arr[i] > arr[max_val_idx]:\n                max_val_idx = i\n\n        # If the maximum element is not already at its correct sorted position.\n        if max_val_idx != curr_size - 1:\n            # Bring the largest element to the front if it's not already there.\n            if max_val_idx != 0:\n                _flip(arr, max_val_idx)\n\n            # Move the largest element from the front to its correct position.\n            _flip(arr, curr_size - 1)\n\n    return arr"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) from i=0 to n // 2.\n    The series includes terms as long as (n - 2*i) > 0.\n    \"\"\"\n    current_sum = 0\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        if term <= 0:\n            break\n        current_sum += term\n    return current_sum"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series n + (n-2) + (n-4) + ...\n    until the term is less than or equal to 0.\n    \"\"\"\n    current_sum = 0\n    current_term = n\n    while current_term > 0:\n        current_sum += current_term\n        current_term -= 2\n    return current_sum"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(primary_list: list, removal_list: list) -> list:\n    \"\"\"\n    Removes all elements from the primary_list that are present in the removal_list.\n    The relative order of the remaining elements from the primary_list is preserved.\n    \"\"\"\n    removal_set = set(removal_list)\n    result_list = []\n    for element in primary_list:\n        if element not in removal_set:\n            result_list.append(element)\n    return result_list"}
{"task_id": "Mbpp/165", "solution": "def _is_alphabetic(char: str) -> bool:\n    \"\"\"Checks if a character is an English alphabet letter.\"\"\"\n    return char.isalpha()\ndef _to_lowercase(char: str) -> str:\n    \"\"\"Converts a character to its lowercase equivalent.\"\"\"\n    return char.lower()\ndef _get_alphabetical_position(char: str) -> int:\n    \"\"\"Determines the 1-based alphabetical position of a lowercase alphabetic character.\"\"\"\n    return ord(char) - ord('a') + 1\ndef count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string that match their 1-based string position with their 1-based alphabetical position.\n    Non-alphabetic characters are ignored; case is insensitive.\n    \"\"\"\n    count = 0\n    for index, char in enumerate(input_string):\n        string_position = index + 1\n        if _is_alphabetic(char):\n            lowercase_char = _to_lowercase(char)\n            alphabetical_position = _get_alphabetical_position(lowercase_char)\n            if string_position == alphabetical_position:\n                count += 1\n    return count"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(primary_list: list, removal_list: list) -> list:\n    \"\"\"\n    Removes elements from primary_list that are present in removal_list, preserving order.\n    Input lists remain unmodified.\n    \"\"\"\n    removal_set = set(removal_list)\n    result_list = []\n\n    for element in primary_list:\n        if element not in removal_set:\n            result_list.append(element)\n\n    return result_list"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string that occur at the same position in the string\n    as in the English alphabet (case insensitive).\n    \"\"\"\n    count = 0\n    for index, char in enumerate(input_string):\n        char_lower = char.lower()\n        if 'a' <= char_lower <= 'z':\n            alphabetical_pos = ord(char_lower) - ord('a')\n            if index == alphabetical_pos:\n                count += 1\n    return count"}
{"task_id": "Mbpp/160", "solution": "def extended_gcd(a: int, b: int) -> tuple[int, int, int]:\n    \"\"\"Implements the Extended Euclidean Algorithm to find GCD and coefficients for Bezout's identity.\n    Returns (g, x, y) such that ax + by = g, where g = gcd(a, b) and g >= 0.\n    \"\"\"\n    if a == 0:\n        return (abs(b), 0, 1 if b >= 0 else -1)\n\n    g, x, y = extended_gcd(b % a, a)\n    # The current (g, x, y) satisfies (b % a)*x + a*y = g.\n    # We transform this to satisfy a*X + b*Y = g.\n    return (g, y - (b // a) * x, x)\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"Solves the linear Diophantine equation ax + by = n for integer x and y.\n    Returns a tuple (x, y) if a solution exists, otherwise returns None.\n    \"\"\"\n    # Handle edge case: a=0 and b=0\n    if a == 0 and b == 0:\n        if n == 0:\n            return (0, 0)  # Any integer pair is a solution, (0,0) is simple\n        else:\n            return None    # No solution possible if n is non-zero\n\n    # Handle edge case: a=0 and b!=0\n    elif a == 0:\n        if n % b == 0:\n            return (0, n // b) # x can be any integer, we choose 0\n        else:\n            return None\n\n    # Handle edge case: a!=0 and b=0\n    elif b == 0:\n        if n % a == 0:\n            return (n // a, 0) # y can be any integer, we choose 0\n        else:\n            return None\n\n    # General Case: a!=0 and b!=0\n    else:\n        g, x0, y0 = extended_gcd(a, b) # g = gcd(a, b), and ax0 + by0 = g\n\n        # A solution exists if and only if n is divisible by g\n        if n % g != 0:\n            return None # No integer solution exists\n        else:\n            # Calculate the particular solution (x, y)\n            # We have ax0 + by0 = g. Multiplying by (n/g) gives a*(x0*n/g) + b*(y0*n/g) = n.\n            k = n // g\n            x_particular = x0 * k\n            y_particular = y0 * k\n\n            return (x_particular, y_particular)"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a, b, n):\n    \"\"\"\n    Finds integer solutions (x, y) for the linear Diophantine equation ax + by = n.\n    Returns (x, y) if a solution exists, otherwise returns None.\n    \"\"\"\n    def _extended_gcd(a_val, b_val):\n        \"\"\"\n        Implements the Extended Euclidean Algorithm to find gcd(a, b) and coefficients x, y.\n        Returns a tuple (gcd_val, x, y) such that a*x + b*y = gcd_val.\n        \"\"\"\n        if b_val == 0:\n            return a_val, 1, 0\n\n        gcd_val, x1, y1 = _extended_gcd(b_val, a_val % b_val)\n        x = y1\n        y = x1 - (a_val // b_val) * y1\n        return gcd_val, x, y\n\n    # Handle zero coefficients\n    if a == 0 and b == 0:\n        if n == 0:\n            return (0, 0)\n        else:\n            return None\n    elif a == 0:  # b is not zero\n        if n % b == 0:\n            return (0, n // b)\n        else:\n            return None\n    elif b == 0:  # a is not zero\n        if n % a == 0:\n            return (n // a, 0)\n        else:\n            return None\n\n    # General case (a != 0 and b != 0)\n    gcd_val, x0, y0 = _extended_gcd(a, b)\n\n    if n % gcd_val != 0:\n        return None\n    else:\n        k = n // gcd_val\n        x = x0 * k\n        y = y0 * k\n        return (x, y)"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"Calculates the smallest power of 2 greater than or equal to n.\n    Handles the edge case where n is 0 by returning 1.\"\"\"\n    if n == 0:\n        return 1\n    power = 1\n    while power < n:\n        power *= 2\n    return power"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers: list[int]) -> int:\n    \"\"\"\n    Counts unordered pairs (a, b) from a list where their bitwise XOR sum (a ^ b) is even.\n    This leverages the rule that a ^ b is even if a and b have the same parity.\n    \"\"\"\n    count_even = 0\n    count_odd = 0\n\n    # Iterate through the list once to determine the count of even and odd numbers.\n    for num in numbers:\n        if num % 2 == 0:\n            count_even += 1\n        else:\n            count_odd += 1\n\n    # Calculate pairs from even numbers and odd numbers using the combination formula n*(n-1)/2.\n    pairs_from_even = count_even * (count_even - 1) // 2\n    pairs_from_odd = count_odd * (count_odd - 1) // 2\n\n    # The total is the sum of pairs where both numbers are even or both are odd.\n    total_even_xor_pairs = pairs_from_even + pairs_from_odd\n    return total_even_xor_pairs"}
