{"task_id": "Mbpp/608", "solution": "_memo_bell_numbers = {0: 1}\n_memo_factorials = {0: 1, 1: 1}\ndef _factorial(x):\n    \"\"\"Calculates factorial of x using memoization. Assumes x is a non-negative integer.\"\"\"\n    if x not in _memo_factorials:\n        _memo_factorials[x] = x * _factorial(x - 1)\n    return _memo_factorials[x]\ndef _combinations(n, k):\n    \"\"\"Calculates the binomial coefficient C(n, k). Returns 0 if k is out of range.\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n    return _factorial(n) // (_factorial(k) * _factorial(n - k))\ndef bell_Number(n):\n    \"\"\"Calculates the nth Bell number using a recurrence relation and memoization. Assumes n is a non-negative integer.\"\"\"\n    if n in _memo_bell_numbers:\n        return _memo_bell_numbers[n]\n\n    current_bell_sum = 0\n    for k in range(n):\n        current_bell_sum += _combinations(n - 1, k) * bell_Number(k)\n\n    _memo_bell_numbers[n] = current_bell_sum\n    return current_bell_sum"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(data: list[tuple]) -> int | float:\n    \"\"\"Calculates the cumulative sum of all numerical values across a list of tuples.\n    It iterates through each number within each tuple and adds it to a running total.\"\"\"\n    total_sum = 0\n    for tup in data:\n        for num in tup:\n            total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/611", "solution": "from typing import List, Union\ndef max_of_nth(matrix: List[List[Union[int, float]]], n: int) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum value in the specified column (n) of a given matrix.\n    This function assumes valid input as per critical requirements, skipping explicit error handling.\n    \"\"\"\n    max_value = matrix[0][n]\n    for i in range(1, len(matrix)):\n        current_value = matrix[i][n]\n        if current_value > max_value:\n            max_value = current_value\n    return max_value"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix: list[list], n: int):\n    \"\"\"\n    Finds the maximum value in the n-th column of a matrix.\n    Assumes valid matrix and column index n, and that the column will contain elements.\n    \"\"\"\n    column_elements = []\n    for row in matrix:\n        if n < len(row):\n            column_elements.append(row[n])\n    return max(column_elements)"}
