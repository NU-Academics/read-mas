{"task_id": "Mbpp/108", "solution": "def merge_sorted_list(list1, list2, list3):\n    \"\"\"Merges and sorts three input lists based on the provided design specification.\n    Returns a single sorted list of all combined elements.\n    \"\"\"\n\n    class Element:\n        def __init__(self, value):\n            self.value = value\n\n    class List:\n        def __init__(self, elements=None):\n            # Converts raw input values into Element objects for internal use.\n            self.elements = [Element(e) for e in (elements if elements is not None else [])]\n\n    class InputList(List):\n        pass\n\n    class SortedList(List):\n        pass\n\n    class ListMerger:\n        def merge_and_sort_lists(self, input_list1: InputList, input_list2: InputList, input_list3: InputList) -> SortedList:\n            \"\"\"Combines elements from three InputList objects and sorts them.\"\"\"\n            combined_values = []\n            for lst_obj in [input_list1, input_list2, input_list3]:\n                for element_obj in lst_obj.elements:\n                    combined_values.append(element_obj.value)\n\n            combined_values.sort()\n            return SortedList(combined_values)\n\n    # Convert raw input lists into InputList objects as per design.\n    input_list_obj1 = InputList(list1)\n    input_list_obj2 = InputList(list2)\n    input_list_obj3 = InputList(list3)\n\n    # Instantiate ListMerger and use its method to perform the core logic.\n    merger = ListMerger()\n    sorted_list_instance = merger.merge_and_sort_lists(input_list_obj1, input_list_obj2, input_list_obj3)\n\n    # Extract the raw values from the SortedList object to return a standard Python list.\n    return [e.value for e in sorted_list_instance.elements]"}
{"task_id": "Mbpp/109", "solution": "def _rotate_binary_string(s: str) -> str:\n    \"\"\"Performs a single left rotation on a binary string. Example: \"011001\" -> \"110010\".\"\"\"\n    if not s:\n        return s\n    return s[1:] + s[0]\ndef _binary_to_decimal(s: str) -> int:\n    \"\"\"Converts a binary string to its decimal integer equivalent.\"\"\"\n    return int(s, 2)\ndef _is_odd(n: int) -> bool:\n    \"\"\"Determines if an integer is an odd number. Odd numbers are not divisible by 2.\"\"\"\n    return n % 2 != 0\ndef odd_Equivalent(binary_string: str, num_rotations: int) -> int:\n    \"\"\"\n    Calculates the count of odd decimal equivalents resulting from binary string rotations.\n    It rotates the string, converts to decimal, and checks for oddness for each rotation.\n    \"\"\"\n    odd_count = 0\n    current_binary_string = binary_string\n    for _ in range(num_rotations):\n        current_binary_string = _rotate_binary_string(current_binary_string)\n        decimal_equivalent = _binary_to_decimal(current_binary_string)\n        if _is_odd(decimal_equivalent):\n            odd_count += 1\n    return odd_count"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_string: str, n_rotations: int) -> int:\n    \"\"\"\n    Counts how many times a rotated binary string represents an odd decimal number.\n    The function performs left rotations and checks the decimal value for oddness.\n    \"\"\"\n    odd_count = 0\n    current_binary_string = binary_string\n\n    for _ in range(n_rotations):\n        # Convert the current binary string to its decimal integer equivalent.\n        decimal_value = int(current_binary_string, 2)\n\n        # Check if the decimal value is odd and increment the counter if it is.\n        if decimal_value % 2 != 0:\n            odd_count += 1\n\n        # Perform a left rotation: move the first character to the end.\n        current_binary_string = current_binary_string[1:] + current_binary_string[0]\n\n    return odd_count"}
{"task_id": "Mbpp/111", "solution": "from typing import List, Any\ndef common_in_nested_lists(listOfLists: List[List[Any]]) -> List[Any]:\n    \"\"\"\n    Identifies and returns elements present in all nested lists within a given input.\n    Uses set operations for efficient intersection.\n    \"\"\"\n    if not listOfLists:\n        return []\n\n    initial_set = set(listOfLists[0])\n\n    if not initial_set:\n        return []\n\n    for current_list in listOfLists[1:]:\n        current_set = set(current_list)\n\n        if not current_set:\n            return []\n\n        initial_set = initial_set.intersection(current_set)\n\n        if not initial_set:\n            return []\n\n    return list(initial_set)"}
