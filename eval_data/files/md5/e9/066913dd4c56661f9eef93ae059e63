{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"Calculates the nth Catalan number.\"\"\"\n\n    def _combinations(n_val: int, k_val: int) -> int:\n        \"\"\"Calculates the binomial coefficient (n_val choose k_val).\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n\n        res = 1\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    # Catalan number C_n = C(2n, n) / (n + 1)\n    combinations_result = _combinations(2 * n, n)\n    catalan_num = combinations_result // (n + 1)\n    return catalan_num"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip_address: str) -> str:\n    \"\"\"Removes leading zeros from each octet of an IPv4 address string.\n    An octet consisting only of '0' will remain '0'.\n    \"\"\"\n    octets = ip_address.split('.')\n    processed_octets = [str(int(octet)) for octet in octets]\n    return \".\".join(processed_octets)"}
{"task_id": "Mbpp/592", "solution": "def nCr(n_val, r_val):\n    \"\"\"\n    Calculates \"n choose r\" (C(n_val, r_val)) using an iterative method and integer division.\n    It includes optimizations and handles edge cases for invalid r_val.\n    \"\"\"\n    if r_val < 0 or r_val > n_val:\n        return 0\n    if r_val == 0 or r_val == n_val:\n        return 1\n    if r_val > n_val // 2:\n        r_val = n_val - r_val\n\n    res = 1\n    for i in range(r_val):\n        res = res * (n_val - i) // (i + 1)\n    return res\ndef sum_Of_product(n):\n    \"\"\"\n    Calculates the sum of C(n, k) * C(n, k + 1) for k from 0 to n-1.\n    Raises ValueError if n is negative, otherwise returns the total sum.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    total_sum = 0\n    for k in range(n):\n        term = nCr(n, k) * nCr(n, k + 1)\n        total_sum += term\n    return total_sum"}
