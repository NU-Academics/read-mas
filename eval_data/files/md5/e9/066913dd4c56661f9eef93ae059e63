{"task_id": "Mbpp/125", "solution": "def _kadane_variant(transformed_arr: list[int]) -> int:\n    \"\"\"\n    Implements a variant of Kadane's algorithm to find the maximum sum of a contiguous subarray.\n    This variant correctly handles arrays where all positive sums are desired.\n    \"\"\"\n    max_so_far = 0\n    current_max = 0\n    for x in transformed_arr:\n        current_max += x\n        if current_max < 0:\n            current_max = 0\n        max_so_far = max(max_so_far, current_max)\n    return max_so_far\ndef find_length(s: str) -> int:\n    \"\"\"\n    Computes the maximum difference between '0's and '1's in any contiguous substring.\n    It orchestrates string transformation and calls a Kadane's algorithm variant.\n    \"\"\"\n    if not s:\n        return 0\n\n    transformed_arr = []\n    for char in s:\n        # Map '0' to 1 and '1' to -1 to find max difference (0s - 1s) as max sum.\n        transformed_arr.append(1 if char == '0' else -1)\n\n    return _kadane_variant(transformed_arr)"}
{"task_id": "Mbpp/133", "solution": "def sum_negativenum(numbers: list) -> float:\n    \"\"\"\n    Calculates the sum of all negative numbers in a given list.\n    Returns 0.0 if no negative numbers are found or the list is empty.\n    \"\"\"\n    running_sum = 0.0\n    for number in numbers:\n        if number < 0:\n            running_sum += number\n    return running_sum"}
