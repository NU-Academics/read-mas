{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    \"\"\"\n    total_sum = 0\n    for i in range(n):\n        current_odd_number = 2 * i + 1\n        fourth_power = current_odd_number ** 4\n        total_sum += fourth_power\n    return total_sum"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    The sum is calculated using the formula (2*i - 1)^4 for i from 1 to n.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        odd_num = (2 * i - 1)\n        power_four = odd_num ** 4\n        total_sum += power_four\n    return total_sum"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1: list, list2: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists, returning elements from list1\n    that are not present in list2, while preserving their original order.\n    \"\"\"\n    set2 = set(list2)\n    result_list = []\n    for item in list1:\n        if item not in set2:\n            result_list.append(item)\n    return result_list"}
{"task_id": "Mbpp/771", "solution": "OPENING_CHARS = {'(', '[', '{'}\nCLOSING_CHARS = {')', ']', '}'}\nMATCHING_PAIRS = {')': '(', ']': '[', '}': '{'}\ndef check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression string has balanced opening and closing characters.\n    It uses a stack to ensure correct nesting and matching order.\n    \"\"\"\n    stack = []\n\n    for char in expression:\n        if char in OPENING_CHARS:\n            stack.append(char)\n        elif char in CLOSING_CHARS:\n            if not stack:\n                return False  # Closing character without a corresponding opening one\n\n            last_opening = stack.pop()\n            if MATCHING_PAIRS[char] != last_opening:\n                return False  # Mismatched opening and closing characters\n        # Characters that are not opening or closing are simply ignored.\n\n    return not stack # Expression is balanced if the stack is empty at the end."}
{"task_id": "Mbpp/772", "solution": "def _split_into_words(text: str) -> list[str]:\n    \"\"\"\n    Splits a string into words based on whitespace characters.\n    Punctuation attached to words is considered part of the word.\n    \"\"\"\n    return text.split()\ndef _filter_words_by_length(words: list[str], k: int) -> list[str]:\n    \"\"\"\n    Filters a list of words, removing those with length k.\n    Assumes k is an integer.\n    \"\"\"\n    return [word for word in words if len(word) != k]\ndef _join_words(words: list[str]) -> str:\n    \"\"\"\n    Joins a list of words into a single string, separated by single spaces.\n    Ensures no leading or trailing spaces.\n    \"\"\"\n    return \" \".join(words)\ndef remove_length(input_string: str, k: int) -> str:\n    \"\"\"\n    Removes all words of length k from the input string.\n    Returns a new string with words of length k removed, separated by single spaces.\n    \"\"\"\n    if not input_string:\n        return \"\"\n    words = _split_into_words(input_string)\n    filtered_words = _filter_words_by_length(words, k)\n    return _join_words(filtered_words)"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(main_string: str, substring: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence and position of a substring within a main string.\n    Returns (found_substring, start_position, end_position) or None.\n    \"\"\"\n    start_position = main_string.find(substring)\n\n    if start_position == -1:\n        return None\n    else:\n        end_position = start_position + len(substring)\n        return (substring, start_position, end_position)"}
