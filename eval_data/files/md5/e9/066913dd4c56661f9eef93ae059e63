{"task_id": "Mbpp/771", "solution": "def check_expression(expression):\n    \"\"\"\n    Checks if the given expression has balanced delimiters.\n    Uses a stack to track opening delimiters.\n    \"\"\"\n    stack = []\n    opening_brackets = \"([{\"\n    bracket_map = {')': '(', ']': '[', '}': '{'}\n\n    for char in expression:\n        if char in opening_brackets:\n            stack.append(char)\n        elif char in bracket_map:\n            if not stack or stack.pop() != bracket_map[char]:\n                return False\n\n    return not stack"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Packs consecutive duplicates of list elements into sublists.\n    Maintains original order and achieves O(N) time complexity.\n    \"\"\"\n    result = []\n    if not input_list:\n        return result\n\n    i = 0\n    while i < len(input_list):\n        current_element = input_list[i]\n        current_sublist = [current_element]\n        j = i + 1\n        while j < len(input_list) and input_list[j] == current_element:\n            current_sublist.append(input_list[j])\n            j += 1\n        result.append(current_sublist)\n        i = j\n    return result"}
{"task_id": "Mbpp/777", "solution": "def find_sum(input_list: list) -> int:\n    \"\"\"Calculates the sum of elements appearing exactly once in the input list.\n    It counts occurrences using a dictionary and then sums unique elements.\"\"\"\n    counts = {}\n    for item in input_list:\n        counts[item] = counts.get(item, 0) + 1\n\n    total_sum = 0\n    for item, count in counts.items():\n        if count == 1:\n            total_sum += item\n\n    return total_sum"}
