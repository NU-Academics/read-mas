{"task_id": "Mbpp/468", "solution": "def max_product(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum product of an increasing contiguous subsequence within an array.\n    Returns 0 for an empty array, as per the design specification's sequence diagram.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_overall_product = arr[0]\n    current_product = arr[0]\n\n    for i in range(1, len(arr)):\n        if arr[i] > arr[i-1]:\n            # Extend the current increasing contiguous subsequence.\n            current_product *= arr[i]\n        else:\n            # The increasing contiguous subsequence is broken, start a new one.\n            current_product = arr[i]\n        \n        # Update the maximum product found across all subsequences.\n        max_overall_product = max(max_overall_product, current_product)\n            \n    return max_overall_product"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"Calculates the pairwise addition of neighboring elements in a tuple.\n    Returns a new tuple containing the sums of adjacent pairs.\"\"\"\n\n    pairwise_sums = []\n    # Iterate up to the second-to-last element to form pairs\n    for i in range(len(input_tuple) - 1):\n        pairwise_sums.append(input_tuple[i] + input_tuple[i+1])\n\n    return tuple(pairwise_sums)"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Calculates the pairwise addition of neighboring elements of the given tuple.\n    Returns an empty tuple if the input tuple has fewer than two elements.\n    \"\"\"\n    n = len(input_tuple)\n    if n < 2:\n        return ()\n\n    sums = []\n    for i in range(n - 1):\n        sums.append(input_tuple[i] + input_tuple[i+1])\n\n    return tuple(sums)"}
{"task_id": "Mbpp/468", "solution": "def max_product(arr: list[int | float]) -> int | float:\n    \"\"\"\n    Calculates the maximum product of an increasing subsequence in the given array.\n    Handles empty, single-element, and all-negative arrays as special cases.\n    \"\"\"\n    if not arr:\n        return 0\n\n    if len(arr) == 1:\n        return arr[0]\n\n    # Check if all numbers are negative, as per design's BR7.\n    # In this specific case, the largest single negative number is returned.\n    all_negative = True\n    for x in arr:\n        if x >= 0:\n            all_negative = False\n            break\n\n    if all_negative:\n        return max(arr)\n\n    # Dynamic programming for the general case.\n    # dp[i] stores the maximum product of an increasing subsequence ending at arr[i].\n    dp = list(arr)\n    max_product_found = max(dp) # Initialize with max of individual elements\n\n    for i in range(len(arr)):\n        for j in range(i):\n            if arr[i] > arr[j]:\n                # Update dp[i] by considering extending a subsequence ending at arr[j].\n                dp[i] = max(dp[i], dp[j] * arr[i])\n        max_product_found = max(max_product_found, dp[i])\n\n    return max_product_found"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(arr: list[int], n: int) -> int:\n    \"\"\"\n    Calculates the product of array elements modulo n, preventing overflow.\n    Applies the modulo operation at each multiplication step.\n    \"\"\"\n    product = 1\n    for element in arr:\n        product = (product * element) % n\n    return product"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(numbers: list[int]) -> bool:\n    \"\"\"\n    Determines if the numbers in the input list are consecutive.\n    Empty lists and single-element lists are trivially consecutive; otherwise, each number must be exactly one greater than the preceding.\n    \"\"\"\n    if not numbers or len(numbers) == 1:\n        return True  # Empty or single-element lists are trivially consecutive\n\n    for i in range(1, len(numbers)):\n        # Each number (except the first) must be exactly one greater than the preceding\n        if numbers[i] != numbers[i-1] + 1:\n            return False  # Condition not met, return False\n\n    return True  # All conditions met, return True"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(input_list: list) -> bool:\n    \"\"\"Checks if the unique, sorted elements of a list form a consecutive sequence.\n\n    Returns True if consecutive and more than one unique element, False otherwise.\n    \"\"\"\n    sorted_unique_list = sorted(list(set(input_list)))\n\n    if len(sorted_unique_list) <= 1:\n        return False\n\n    for i in range(1, len(sorted_unique_list)):\n        if sorted_unique_list[i] != sorted_unique_list[i-1] + 1:\n            return False\n\n    return True"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(arr: list[int | float], n: int) -> int:\n    \"\"\"\n    Calculates the product of all elements in 'arr' modulo 'n'.\n    The modulo operation is applied iteratively to manage intermediate product size.\n    \"\"\"\n    product = 1\n    for x in arr:\n        product = (product * x) % n\n    return int(product)"}
{"task_id": "Mbpp/473", "solution": "from typing import List, Tuple, Any, Set\ndef _normalize_tuple_for_comparison(input_tuple: Tuple[Any, ...]) -> Tuple[Any, ...]:\n    \"\"\"\n    Sorts elements within a tuple to create a canonical representation for order-agnostic comparison.\n    Assumes all elements in the tuple are sortable.\n    \"\"\"\n    return tuple(sorted(input_tuple))\ndef tuple_intersection(list1: List[Tuple[Any, ...]], list2: List[Tuple[Any, ...]]) -> Set[Tuple[Any, ...]]:\n    \"\"\"\n    Finds the intersection of two lists of tuples, treating tuples with the same elements\n    as identical regardless of their internal order.\n    Returns a set of tuples representing the order-agnostic intersection.\n    \"\"\"\n    normalized_set1 = {_normalize_tuple_for_comparison(t) for t in list1}\n    normalized_set2 = {_normalize_tuple_for_comparison(t) for t in list2}\n\n    intersection_normalized = normalized_set1.intersection(normalized_set2)\n\n    return intersection_normalized"}
{"task_id": "Mbpp/474", "solution": "def replace_char(input_string: str, old_char: str, new_char: str) -> str:\n    \"\"\"Replaces all occurrences of old_char with new_char in input_string.\n    The replacement is case-sensitive as per the design.\"\"\"\n    result_chars = []\n    for char in input_string:\n        if char == old_char:\n            result_chars.append(new_char)\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/473", "solution": "def tuple_intersection(list1, list2):\n    \"\"\"\n    Finds the intersection of tuples from two lists, treating tuples as equal irrespective of element order.\n    Returns a set of sorted tuples.\n    \"\"\"\n    def _normalize_tuple(tup):\n        \"\"\"\n        Normalizes a tuple into a frozenset for order-agnostic comparison.\n        This frozenset is hashable and order-agnostic.\n        \"\"\"\n        return frozenset(tup)\n\n    set1_normalized = {_normalize_tuple(t) for t in list1}\n    set2_normalized = {_normalize_tuple(t) for t in list2}\n\n    intersection_frozensets = set1_normalized.intersection(set2_normalized)\n\n    result_set = {tuple(sorted(f)) for f in intersection_frozensets}\n\n    return result_set"}
{"task_id": "Mbpp/474", "solution": "def replace_char(input_string: str, char_to_replace: str, replacement_char: str) -> str:\n    \"\"\"Replaces all occurrences of char_to_replace with replacement_char in input_string.\n    Returns a new string with replacements, leaving the original unchanged.\n    \"\"\"\n    modified_chars = []\n    for char in input_string:\n        if char == char_to_replace:\n            modified_chars.append(replacement_char)\n        else:\n            modified_chars.append(char)\n    return \"\".join(modified_chars)"}
