{"task_id": "Mbpp/71", "solution": "def comb_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a list using the Comb Sort algorithm.\n    It returns a new sorted list.\n    \"\"\"\n    # Create a mutable copy to avoid modifying the original list.\n    arr = input_list[:]\n    n = len(arr)\n\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        # Update the gap value.\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n        # Compare elements with current gap.\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number, B_n, representing the number of ways\n    to partition a set with n elements into non-empty subsets.\n\n    Args:\n        n: A non-negative integer representing the size of the set.\n\n    Returns:\n        The nth Bell number.\n\n    Raises:\n        ValueError: If n is a negative integer.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n    if n == 0 or n == 1:\n        return 1\n\n    memo = {}\n\n    def _stirling_second_kind(current_n: int, current_k: int) -> int:\n        \"\"\"\n        Calculates the Stirling number of the second kind S(n, k)\n        using a recursive recurrence relation with memoization.\n        \"\"\"\n        if (current_n, current_k) in memo:\n            return memo[(current_n, current_k)]\n\n        if current_k < 0 or current_k > current_n:\n            return 0\n        if current_k == 0:\n            return 1 if current_n == 0 else 0\n        if current_k == current_n:\n            return 1\n        if current_k == 1:\n            return 1\n\n        # Recurrence relation: S(n, k) = k * S(n-1, k) + S(n-1, k-1)\n        result = current_k * _stirling_second_kind(current_n - 1, current_k) + \\\n                 _stirling_second_kind(current_n - 1, current_k - 1)\n        memo[(current_n, current_k)] = result\n        return result\n\n    total_bell = 0\n    # B_n is the sum of Stirling numbers of the second kind S(n, k) for k from 0 to n.\n    for k in range(n + 1):\n        total_bell += _stirling_second_kind(n, k)\n\n    return total_bell"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(data_list: list) -> list:\n    \"\"\"\n    Sorts a list of elements using the comb sort algorithm.\n    This function sorts the list in-place and returns the sorted list.\n    \"\"\"\n    n = len(data_list)\n    gap = n\n    swapped = True\n    shrink_factor = 1.3\n\n    while gap > 1 or swapped:\n        # Reduce gap by shrink factor; ensure gap is at least 1.\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n        # Perform a pass with the current gap value.\n        for i in range(n - gap):\n            if data_list[i] > data_list[i + gap]:\n                data_list[i], data_list[i + gap] = data_list[i + gap], data_list[i]\n                swapped = True\n    return data_list"}
