{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"Converts a non-negative decimal integer to its binary string representation.\n    Ensures no leading zeros, except for '0' itself.\"\"\"\n    if decimal_number == 0:\n        return '0'\n\n    binary_digits = []\n    current_number = decimal_number\n    while current_number > 0:\n        remainder = current_number % 2\n        binary_digits.append(str(remainder))\n        current_number //= 2\n\n    return \"\".join(binary_digits[::-1])"}
{"task_id": "Mbpp/100", "solution": "def is_palindrome(num: int) -> bool:\n    \"\"\"Checks if an integer is a palindrome by comparing its string representation with its reverse.\n    This helper function is used internally by next_smallest_palindrome.\"\"\"\n    s = str(num)\n    return s == s[::-1]\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"Calculates and returns the smallest palindrome integer strictly greater than the input n.\n    It iteratively checks numbers starting from n + 1 until a palindrome is found.\"\"\"\n    current_num = n + 1\n    while True:\n        if is_palindrome(current_num):\n            return current_num\n        current_num += 1"}
{"task_id": "Mbpp/96", "solution": "def divisor(number: int) -> int:\n    \"\"\"Calculates the total count of positive divisors for a given integer.\n    For non-positive inputs, the function returns 0.\n    \"\"\"\n    if number <= 0:\n        return 0\n\n    count = 0\n    i = 1\n    while i * i <= number:\n        if number % i == 0:\n            count += 1\n            if i * i != number:\n                count += 1\n        i += 1\n    return count"}
{"task_id": "Mbpp/100", "solution": "def _is_palindrome(num: int) -> bool:\n    \"\"\"\n    Checks if a given integer is a palindrome.\n    A number is a palindrome if it reads the same forwards and backwards.\n    \"\"\"\n    if num < 0:\n        return False\n    s_num = str(num)\n    return s_num == s_num[::-1]\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Calculates the next smallest palindrome for a given integer input `n`.\n    It returns the first palindrome greater than `n`.\n    \"\"\"\n    current_num = n + 1\n    while True:\n        if _is_palindrome(current_num):\n            return current_num\n        current_num += 1"}
{"task_id": "Mbpp/101", "solution": "from typing import List, TypeVar\nT = TypeVar('T')\nclass IndexOutOfBoundsError(Exception):\n    \"\"\"Custom exception for when the 1-based index k is out of bounds.\"\"\"\n    pass\ndef kth_element(array: List[T], k: int) -> T:\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n\n    Args:\n        array: The list of elements.\n        k: The 1-based index of the desired element.\n\n    Returns:\n        The element at the specified 1-based index k.\n\n    Raises:\n        IndexOutOfBoundsError: If k is less than 1, greater than the array length,\n                               or if the array is empty.\n    \"\"\"\n    if not array:\n        raise IndexOutOfBoundsError(\"Array is empty.\")\n    if k < 1 or k > len(array):\n        raise IndexOutOfBoundsError(f\"Index {k} is out of bounds for array of length {len(array)}.\")\n    return array[k - 1]"}
{"task_id": "Mbpp/101", "solution": "def kth_element(array: list, k: int) -> any:\n    \"\"\"\n    Finds and returns the kth element from a given array using 1-based indexing.\n\n    Args:\n        array: The input list.\n        k: The 1-based index.\n\n    Returns:\n        The element at array[k-1].\n\n    Raises:\n        KthElementError: If k is not a positive integer or if k is out of bounds.\n    \"\"\"\n    _validate_k(len(array), k)\n    return array[k - 1]"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n, m):\n    \"\"\"\n    Calculates the Eulerian number A(n, m) using its summation formula.\n    This implementation includes necessary helper functions defined inline.\n    \"\"\"\n\n    def _factorial(val):\n        \"\"\"Computes the factorial of a non-negative integer.\"\"\"\n        if val == 0:\n            return 1\n        res = 1\n        for i in range(1, val + 1):\n            res *= i\n        return res\n\n    def _combinations(n_val, k_val):\n        \"\"\"Calculates the binomial coefficient (n_val choose k_val).\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n\n        numerator = _factorial(n_val)\n        denominator = _factorial(k_val) * _factorial(n_val - k_val)\n        return numerator // denominator\n\n    # Eulerian number formula: A(n, m) = sum_{k=0}^{m+1} (-1)^k * C(n+1, k) * (m+1-k)^n\n    result = 0\n    for k in range(m + 2):  # Loop k from 0 to m+1\n        term_binomial = _combinations(n + 1, k)\n        term_power_base = m + 1 - k\n        term_power_val = term_power_base ** n\n\n        if k % 2 == 1:  # For odd k, (-1)^k is -1\n            result -= term_binomial * term_power_val\n        else:  # For even k, (-1)^k is 1\n            result += term_binomial * term_power_val\n\n    return result"}
