{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(number: int) -> int:\n    \"\"\"Sets the left-most unset bit of the input number and returns the modified integer.\n    The left-most unset bit is the highest position k (>=0) where the k-th bit is 0.\n    \"\"\"\n    if number == 0:\n        return 1\n\n    # Default to the next bit position if all existing bits up to number.bit_length()-1 are set.\n    bit_to_set_pos = number.bit_length()\n\n    # Iterate from the highest significant bit position down to 0.\n    for k in range(number.bit_length() - 1, -1, -1):\n        if not ((number >> k) & 1):  # Check if the k-th bit is 0\n            bit_to_set_pos = k\n            break # Found the left-most unset bit\n\n    return number | (1 << bit_to_set_pos)"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"Sets the leftmost (most significant) unset bit in an integer.\n    Returns the original integer if all bits are already 1.\n    \"\"\"\n    if n >= 0:\n        # Handle 0 explicitly.\n        if n == 0:\n            return 1\n        # If all bits up to its current length are 1.\n        if n == (1 << n.bit_length()) - 1:\n            return n\n\n        # Find the highest unset bit position.\n        bit_to_set_pos = -1\n        for i in range(n.bit_length() - 1, -1, -1):\n            if not (n & (1 << i)):\n                bit_to_set_pos = i\n                break\n\n        # Set the found bit or return original if no unset bit was found.\n        if bit_to_set_pos != -1:\n            return n | (1 << bit_to_set_pos)\n        else:\n            return n\n    else: # n < 0\n        # If all bits are already 1.\n        if n == -1:\n            return -1\n\n        # Find the least significant unset bit and set it.\n        i = 0\n        while True:\n            if not (n & (1 << i)):\n                return n | (1 << i)\n            i += 1"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"Calculates the highest power of 2 that is less than or equal to n.\n    This function iteratively doubles a power of 2 until it exceeds n.\n    \"\"\"\n    power = 1\n    while power * 2 <= n:\n        power *= 2\n    return power"}
