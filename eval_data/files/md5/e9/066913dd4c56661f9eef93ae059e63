{"task_id": "Mbpp/103", "solution": "def _binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"\n    Calculates the binomial coefficient C(n, k).\n    Assumes n >= 0 and 0 <= k <= n.\n    \"\"\"\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number a(n, m).\n    The Eulerian number a(n, m) is the number of permutations of {1, ..., n}\n    in which exactly m ascents occur.\n    \"\"\"\n    # Formula: A(n, m) = sum_{k=0 to m} (-1)^k * C(n+1, k) * (m+1-k)^n\n    result = 0\n    for k in range(m + 1):\n        term = ((-1)**k) * _binomial_coefficient(n + 1, k) * ((m + 1 - k)**n)\n        result += term\n\n    return result"}
{"task_id": "Mbpp/104", "solution": "from typing import List\ndef sort_sublists(input_list: List[List[str]]) -> List[List[str]]:\n    \"\"\"Sorts each sublist of strings in a given list of lists alphabetically.\n    Returns a new list of lists with all inner lists sorted.\"\"\"\n\n    sorted_outer_list: List[List[str]] = []\n\n    for sublist in input_list:\n        current_sublist_copy = list(sublist) # Create a copy to sort, avoiding modification of original sublist.\n        current_sublist_copy.sort() # Sort elements in ascending alphabetical order in-place.\n        sorted_outer_list.append(current_sublist_copy)\n\n    return sorted_outer_list"}
{"task_id": "Mbpp/104", "solution": "from typing import List\ndef sort_sublists(input_list_of_lists: List[List[str]]) -> List[List[str]]:\n    \"\"\"Sorts each sublist of strings alphabetically, returning a new list of lists.\n    The original input list of lists remains unchanged.\"\"\"\n    new_list_of_lists = []\n    for sublist in input_list_of_lists:\n        copied_sublist = list(sublist) # Create a new list object (shallow copy).\\n        copied_sublist.sort() # Sort the copied sublist alphabetically.\\n        new_list_of_lists.append(copied_sublist)\n    return new_list_of_lists"}
