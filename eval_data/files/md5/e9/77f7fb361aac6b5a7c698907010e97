      if max_idx != current_size - 1:\n            # First flip: Bring the maximum element to the beginning of the list.\n            # This reverses the sub-array arr[0...max_idx].\n            left, right = 0, max_idx\n            while left < right:\n                arr[left], arr[right] = arr[right], arr[left]\n                left += 1\n                right -= 1\n\n            # Second flip: Move the maximum element from the beginning to its final sorted position.\n            # This reverses the sub-array arr[0...current_size-1].\n            left, right = 0, current_size - 1\n            while left < right:\n                arr[left], arr[right] = arr[right], arr[left]\n                left += 1\n                right -= 1\n    \n    return arr", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/161": [{"task_id": "Mbpp/161", "solution": "def remove_elements(source_list: list, elements_to_remove: list) -> list:\n    \"\"\"\n    Removes all elements from source_list that are present in elements_to_remove.\n    The order of remaining elements is preserved.\n    \"\"\"\n    elements_to_remove_set = set(elements_to_remove)\n    result_list = [element for element in source_list if element not in elements_to_remove_set]\n    return result_list", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, "apple", [1, 2], [3, 4], {"name": "John"}, 5.5], [2, "apple", [3, 4], {"name": "John"}, 5.5]]]}], "Mbpp/160": [{"task_id": "Mbpp/160", "solution": "def _gcd(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the greatest common divisor of two integers using the Euclidean algorithm.\n    It returns the absolute value of the GCD.\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n    while b:\n        a, b = b, a % b\n    return a\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integer solutions (x, y) for the linear Diophantine equation ax + by = n.\n    Returns a tuple (x, y) if a solution exists, otherwise None.\n    \"\"\"\n\n    # Handle trivial cases where a or b (or both) are zero.\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n    elif a == 0:\n        # Equation becomes by = n. If n is divisible by b, y = n/b. x can be any integer, we choose 0.\n        return (0, n // b) if n % b == 0 else None\n    elif b == 0:\n        # Equation becomes ax = n. If n is divisible by a, x = n/a. y can be any integer, we choose 0.\n        return (n // a, 0) if n % a == 0 else None\n\n    # Define an inner function for the extended Euclidean algorithm.\n    # It calculates g = gcd(num1, num2) and returns (g, x, y) such that num1*x + num2*y = g.\n    def extended_gcd(num1: int, num2: int) -> tuple[int, int, int]:\n        x0, x1 = 1, 0\n        y0, y1 = 0, 1\n        \n        while num2 != 0:\n            q = num1 // num2\n            num1, num2 = num2, num1 % num2\n            x0, x1 = x1, x0 - q * x1\n            y0, y1 = y1, y0 - q * y1\n            \n        # Ensure the GCD (num1) is positive and adjust coefficients accordingly.\n        if num1 < 0:\n            return -num1, -x0, -y0\n        return num1, x0, y0\n\n    # Calculate the greatest common divisor of a and b.\n    g = _gcd(a, b)\n\n    # A solution exists only if n is divisible by g.\n    if n % g != 0:\n        return None\n\n    # Use the extended Euclidean algorithm to find a particular solution (x_prime, y_prime)\n    # for the equation a*x_prime + b*y_prime = g.\n    _, x_prime, y_prime = extended_gcd(a, b)\n\n    # Scale the solution to match n.\n    # If a*x_prime + b*y_prime = g, then a*(x_prime * (n/g)) + b*(y_prime * (n/g)) = n.\n    scale_factor = n // g\n    x0 = x_prime * scale_factor\n    y0 = y_prime * scale_factor\n\n    # Normalize the solution to obtain a specific 'x' value, often the smallest non-negative.\n    # The general solution is x = x0 + k * (b/g), y = y0 - k * (a/g).\n    # We want x in the range [0, |b/g| - 1] (or similar canonical range).\n    # If b/g is 0 (i.e. b is 0), this normalization would involve division by zero,\n    # but the explicit checks for a=0 or b=0 at the beginning handle these cases.\n    \n    # Calculate the modulus for x values.\n    mod_b_g = abs(b // g)\n    \n    # Adjust x0 to be in the desired range using modular arithmetic.\n    # The (x % m + m) % m pattern correctly handles negative x results from extended_gcd.\n    x_final = (x0 % mod_b_g + mod_b_g) % mod_b_g\n\n    # Calculate the corresponding y value for x_final using the original equation.\n    y_final = (n - a * x_final) // b\n\n    return (x_final, y_final)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[25, 123, 7]]}], "Mbpp/165": [{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts the number of characters in a string that occur at the same 1-indexed\n    position in the string as in the English alphabet (case insensitive).\n    \"\"\"\n    counter = 0\n\n    for i, char in enumerate(input_string):\n        string_position = i + 1\n\n        if char.isalpha():\n            alphabetical_position = ord(char.lower()) - ord('a') + 1\n\n            if string_position == alphabetical_position:\n                counter += 1\n\n    return counter", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/166": [{"task_id": "Mbpp/166", "solution": "from typing import List\nclass Integer:\n    \"\"\"Represents a single integer value and provides parity checks.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def isEven(self) -> bool:\n        return self._value % 2 == 0\n\n    def isOdd(self) -> bool:\n        return self._value % 2 != 0\n\n    def getValue(self) -> int:\n        return self._value\n\n    def __eq__(self, other):\n        if not isinstance(other, Integer):\n            return NotImplemented\n        return self._value == other._value\n\n    def __hash__(self):\n        return hash(self._value)\nclass XORResult:\n    \"\"\"Represents the result of an XOR operation and provides parity checks.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def isEven(self) -> bool:\n        return self._value % 2 == 0\n\n    def __eq__(self, other):\n        if not isinstance(other, XORResult):\n            return NotImplemented\n        return self._value == other._value\n\n    def __hash__(self):\n        return hash(self._value)\nclass IntegerPair:\n    \"\"\"Represents a pair of Integer objects, computes their XOR result, and determines if the result is even.\"\"\"\n    def __init__(self, int1: Integer, int2: Integer):\n        self._int1 = int1\n        self._int2 = int2\n\n    def getXORResult(self) -> XORResult:\n        return XORResult(self._int1.getValue() ^ self._int2.getValue())\n\n    def isXORResultEven(self) -> bool:\n        return self.getXORResult().isEven()\n\n    def __eq__(self, other):\n        if not isinstance(other, IntegerPair):\n            return NotImplemented\n        return (self._int1 == other._int1 and self._int2 == other._int2)\n\n    def __hash__(self):\n        return hash((self._int1, self._int2))\nclass IntegerList:\n    \"\"\"Manages a collection of Integer objects and generates unique pairs.\"\"\"\n    def __init__(self, values: List[int]):\n        self._integers: List[Integer] = [Integer(v) for v in values]\n\n    def addInteger(self, value: int):\n        self._integers.append(Integer(value))\n\n    def getPairs(self) -> List[IntegerPair]:\n        pairs: List[IntegerPair] = []\n        n = len(self._integers)\n        for i in range(n):\n            for j in range(i + 1, n):\n                pairs.append(IntegerPair(self._integers[i], self._integers[j]))\n        return pairs\nclass Count:\n    \"\"\"Maintains and provides the total count of pairs whose XOR result is even.\"\"\"\n    def 