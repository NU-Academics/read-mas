y closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n\n    def _clean_string(s: str) -> str:\n        \"\"\"Removes spaces from the input string.\"\"\"\n        return s.replace(' ', '')\n\n    def _is_balanced(s: str) -> bool:\n        \"\"\"Checks if a parenthesis string is balanced.\"\"\"\n        count = 0\n        for char in s:\n            if char == '(':\n                count += 1\n            elif char == ')':\n                count -= 1\n            if count < 0:\n                return False\n        return count == 0\n\n    def _find_groups(cleaned_string: str) -> List[str]:\n        \"\"\"Identifies and filters separate, balanced parenthesis groups.\"\"\"\n        result_groups = []\n        balance = 0\n        current_group_start_index = -1\n\n        for i, char in enumerate(cleaned_string):\n            if char == '(':\n                if balance == 0:\n                    # Marks the potential start of a new top-level group\n                    current_group_start_index = i\n                balance += 1\n            elif char == ')':\n                balance -= 1\n\n            # If balance returns to 0 and we have an active group start index,\n            # it means we've just completed a top-level balanced group.\n            if balance == 0 and current_group_start_index != -1:\n                group_candidate = cleaned_string[current_group_start_index : i + 1]\n                # Explicitly call _is_balanced as per design diagrams.\n                if _is_balanced(group_candidate):\n                    result_groups.append(group_candidate)\n                # Reset for the next top-level group\n                current_group_start_index = -1\n                \n        return result_groups\n\n    # Main logic of separate_paren_groups\n    cleaned_input = _clean_string(paren_string)\n    return _find_groups(cleaned_input)