 spaces.\n    \"\"\"\n    def _sort_word_characters(word_str: str) -> str:\n        \"\"\"Sorts characters in a word by ASCII value.\"\"\"\n        return \"\".join(sorted(word_str))\n\n    if not s:\n        return s\n\n    result_parts = []\n    current_token_start = 0\n    \n    for i in range(len(s)):\n        # If the type of character at `i` is different from the type at `current_token_start`\n        # it means a new token (word or spaces) has started.\n        if s[i].isspace() != s[current_token_start].isspace():\n            token = s[current_token_start:i]\n            if not token[0].isspace():  # It's a word\n                result_parts.append(_sort_word_characters(token))\n            else:  # It's a sequence of spaces\n                result_parts.append(token)\n            current_token_start = i\n            \n    # Process the last token remaining after the loop\n    last_token = s[current_token_start:]\n    if last_token:\n        if not last_token[0].isspace():  # It's a word\n            result_parts.append(_sort_word_characters(last_token))\n        else:  # It's a sequence of spaces\n            result_parts.append(last_token)\n            \n    return \"\".join(result_parts)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\n\n123 456\n789\n"]]}], "HumanEval/84": [{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n    \n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n    \n    # Helper function to calculate the sum of decimal digits.\n    def _calculate_su