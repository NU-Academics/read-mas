>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n\n    def _gcd(a, b):\n        \"\"\"Calculates the Greatest Common Divisor (GCD) of two non-negative integers.\"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\n    class _Fraction:\n        \"\"\"Represents a mathematical fraction, simplifying upon creation.\"\"\"\n        def __init__(self, numerator, denominator):\n            if denominator == 0:\n                raise ValueError(\"Denominator cannot be zero.\")\n            common = _gcd(numerator, denominator)\n            self._numerator = numerator // common\n            self._denominator = denominator // common\n\n        @staticmethod\n        def parse(fraction_string):\n            \"\"\"Parses a string in 'numerator/denominator' format into a _Fraction object.\"\"\"\n            parts = fraction_string.split('/')\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n            return _Fraction(numerator, denominator)\n\n        def multiply(self, other):\n            \"\"\"Multiplies this fraction by another _Fraction and returns a new _Fraction.\"\"\"\n            new_numerator = self._numerator * other._numerator\n            new_denominator = self._denominator * other._denominator\n            return _Fraction(new_numerator, new_denominator)\n\n        def is_whole_number(self):\n            \"\"\"Checks if the fraction represents a whole number (i.e., its denominator is 1).\"\"\"\n            return self._denominator == 1\n\n    fraction_x = _Fraction.parse(x)\n    fraction_n = _Fraction.parse(n)\n    product_fraction = fraction_x.multiply(fraction_n)\n    return product_fraction.is_whole_number()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    _PLANETS_ORDERED = (\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\")\n\n    if planet1 not in _PLANETS_ORDERED or planet2 not in _PLANETS_ORDERED:\n        return ()\n\n    idx1 = _PLANETS_ORDERED.index(planet1)\n    idx2 = _PLANETS_ORDERED.index(planet2)\n\n    # Determine the start and end indices for slicing, ensuring correct order.\n    start_idx = min(idx1, idx2) + 1\n    end_idx = max(idx1, idx2)\n\n    # Slice the tuple to get planets strictly between the two input planets.\n    return _PLANETS_ORDERED[start_idx:end_idx]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/146": [{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns \n    the number of elements in the array that are greater than 10 and both \n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    For example:\n    specialFilter([15, -73, 14, -15]) => 1 \n    specialFilter([33, -2, -3, 45, 21, 109]) => 2\n    \"\"\"\n\n    def _is_greater_than_ten(number: int) -> bool:\n        \"\"\"Checks if a given number is strictly greater than 10.\"\"\"\n        return number > 10\n\n    def _get_first_digit(number: int) -> int:\n        \"\"\"Extracts the first digit of a given number, considering its absolute value.\"\"\"\n        return int(str(abs(number))[0])\n\n    def _get_last_digit(number: int) -> int:\n        \"\"\"Extracts the last digit of a given number, considering its absolute value.\"\"\"\n        return abs(number) % 10\n\n    def _is_odd(digit: int) -> bool:\n        \"\"\"Determines if a single digit is an odd number.\"\"\"\n        return digit in {1, 3, 5, 7, 9}\n\n    def _is_special_number(number: int) -> bool:\n        \"\"\"Orchestrates the checks for all 'special number' criteria.\"\"\"\n        if not _is_greater_than_ten(number):\n            return False\n        \n        first_digit = _get_first_digit(number)\n        last_digit = _get_last_digit(number)\n        \n        return _is_odd(first_digit) and _is_odd(last_digit)\n\n    count = 0\n    for number in nums:\n        if _is_special_number(number):\n            count += 1\n            \n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/149": [{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters strings with odd lengths and returns the remaining strings sorted by length then alphabetically.\"\"\"\n    filtered_list = []\n    for s in lst:\n        if len(s) % 2 == 0:\n            filtered_list.append(s)\n\n    filtered_list.sort(key=lambda s: (len(s), s))\n    return filtered_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/145": [{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If digit sums are similar, order them based on their original index in ascending order.\n    \"\"\"\n\n    def _calculate_digit_sum(num):\n        \"\"\"Calculates the sum of the absolute values of the digits of a given integer.\"\"\"\n        s = 0\n        num_abs = abs(num)\n        if num_abs == 0:\n            return 0\n        while num_abs > 0:\n            s += num_abs % 10\n            num_abs //= 10\n        return s\n\n    class SortableInteger:\n        \"\"\"Encapsulates an integer's value, its calculated digit sum, and its original index for sorting.\"\"\"\n        def __init__(self, value, digit_sum, original_index):\n            self.value = value\n            self.digit_sum = digit_sum\n            self.original_index = original_index\n\n        def __lt__(self, other):\n            # Primary sort by digit_sum (ascending).\n            if self.digit_sum != other.digit_sum:\n                return self.digit_sum < other.digit_sum\n            # Secondary sort by original_index (ascending).\n            return self.original_index < other.original_index\n\n    if not nums:\n        return []\n\n    sortable_items = []\n    for i, num in enumerate(nums):\n        d_sum = _calculate_digit_sum(num)\n        sortable_items.append(SortableInteger(num, d_sum, i))\n\n    sorted_sortable_items = sorted(sortable_items)\n\n    result = [item.value for item in sorted_sortable_items]\n\n    return result", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[-5, -12, 9, 15]]]}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts the number of triples (a[i], a[j], a[k]) from array a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    # Determine counts of i modulo 3 for i from 1 to n\n    # For every 3 consecutive integers, there's one with %0, one with %1, one with %2.\n    num_full_cycles = n // 3\n    remainder_n = n % 3\n\n    count_i_mod_0 = num_full_cycles\n    count_i_mod_1 = num_full_cycles\n    count_i_mod_2 = num_full_cycles\n\n    # Adjust counts for the remaining elements\n    if remainder_n >= 1: # i = 3k+1\n        count_i_mod_1 += 1\n    if remainder_n >= 2: # i = 3k+2\n        count_i_mod_2 += 1\n\n    # Analyze the pattern of a[i] modulo 3:\n    # a[i] = i*i - i + 1\n    # If i % 3 == 0: a[i] % 3 = (0 - 0 + 1) % 3 = 1\n    # If i % 3 == 1: a[i] % 3 = (1 - 1 + 1) % 3 = 1\n    # If i % 3 == 2: a[i] % 3 = (4 - 2 + 1) % 3 = 3 % 3 = 0\n    # This means a[i] % 3 can only be 0 or 1, never 2.\n\n    # c_rem0: count of a[x] such that a[x] % 3 == 0\n    # This corresponds to count_i_mod_2\n    c_rem0 = count_i_mod_2\n\n    # c_rem1: count of a[x] such that a[x] % 3 == 1\n    # This corresponds to count_i_mod_0 + count_i_mod_1\n    c_rem1 = count_i_mod_0 + count_i_mod_1\n\n    # c_rem2: count of a[x] such that a[x] % 3 == 2 (always 0)\n\n    total_triples = 0\n\n    # A triple (a[i], a[j], a[k]) sums to a multiple of 3 if:\n    # (a[i]%3 + a[j]%3 + a[k]%3) % 3 == 0\n\n    # Case 1: All three elements have remainder 0 (mod 3) -> (0, 0, 0)\n    # Requires selecting 3 elements from c_rem0\n    if c_rem0 >= 3:\n        total_triples += (c_rem0 * (c_rem0 - 1) * (c_rem0 - 2)) // 6\n\n    # Case 2: All three elements have remainder 1 (mod 3) -> (1, 1, 1), sum = 3 % 3 = 0\n    # Requires selecting 3 elements from c_rem1\n    if c_rem1 >= 3:\n        total_triples += (c_rem1 * (c_rem1 - 1) * (c_rem1 - 2)) // 6\n\n    # Case 3: One element with remainder 0, one with remainder 1, one with remainder 2 -> (0, 1, 2)\n    # The remainder 2 case (c_rem2) is always 0 for a[i] in this problem, so this case contributes 0.\n    # total_triples += c_rem0 * c_rem1 * c_rem2 # c_rem2 is 0\n\n    return total_triples", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/150": [{"task_id": "HumanEva