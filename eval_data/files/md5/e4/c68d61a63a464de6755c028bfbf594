  \n    month_str = date_string[0:2]\n    day_str = date_string[3:5]\n    year_str = date_string[6:10]\n\n    return month_str.isdigit() and day_str.isdigit() and year_str.isdigit()\ndef _parse_date_components(date_string: str):\n    \"\"\"Parses a 'mm-dd-yyyy' formatted string into month, day, year integers.\"\"\"\n    try:\n        parts = date_string.split('-')\n        month = int(parts[0])\n        day = int(parts[1])\n        year = int(parts[2])\n        return _DateComponents(month, day, year)\n    except (ValueError, IndexError):\n        return None\ndef _get_max_days_in_month(month: int) -> int:\n    \"\"\"Determines the maximum number of days for a given month based on problem rules.\"\"\"\n    if month in [1, 3, 5, 7, 8, 10, 12]:\n        return 31\n    elif month in [4, 6, 9, 11]:\n        return 30\n    elif month == 2:\n        return 29\n    return 0 # Should not be reached if month is validated beforehand\ndef valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n    \"\"\"\n    # Rule 1: The date string is not empty.\n    if not date:\n        return False\n\n    # Rule 4: The date should be in the format: mm-dd-yyyy\n    if not _is_valid_format(date):\n        return False\n\n    date_components = _parse_date_components(date)\n    # If parsing failed, it indicates an issue despite format seemingly being okay (e.g., non-integer parts).\n    if date_components is None:\n        return False\n\n    month = date_components.month\n    day = date_components.day\n\n    # Rule 3: The months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # Rule 2: The number of days is not less than 1.\n    if day < 1:\n        return False\n\n    # Rule 2 (continued): Check day against maximum days for the month.\n    max_days = _get_max_days_in_month(month)\n    if day > max_days:\n        return False\n    \n    # All rules satisfied.\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3 \n    '''\n    def _has_whitespace(text: str) -> bool:\n        \"\"\"Checks if the given text contains any whitespace characters.\"\"\"\n        return any(char.isspace() for char in text)\n\n    def _has_comma(text: str) -> bool:\n        \"\"\"Checks if the given text contains any comma characters.\"\"\"\n        return ',' in text\n\n    def _count_odd_ordered_lowercase_letters(text: str) -> int:\n        \"\"\"Counts lowercase letters whose 0-indexed alphabetical order is odd.\"\"\"\n        count = 0\n        for char in text:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    count += 1\n        return count\n\n    if _has_whitespace(txt):\n        return txt.split()\n    elif _has_comma(txt):\n        return txt.split(',')\n    else:\n        return _count_odd_ordered_lowercase_letters(txt)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"\n    Helper class to encapsulate an interval's start and end.\n    \"\"\"\n    class Interval:\n        def __init__(self, start: int, end: int):\n            self.start = start\n            self.end = end\n\n    \"\"\"\n    Helper class to represent an intersection interval and calculate its length.\n    \"\"\"\n    class Intersection:\n        def __init__(self, start: int, end: int):\n            self.start = start\n            self.end = end\n\n        def calculateLength(self) -> int:\n            return self.end - self.start\n\n    \"\"\"\n    Helper function to check if a non-negative integer is a prime number.\n    \"\"\"\n    def is_prime(n: int) -> bool:\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    \"\"\"\n    Helper function to calculate the intersection of two Interval objects,\n    returning an Intersection object or None if no intersection.\n    \"\"\"\n    def calculate_intersection_interval(int1: Interval, int2: Interval):\n        intersection_start = max(int1.start, int2.start)\n        intersection_end = min(int1.end, int2.end)\n\n        if intersection_start > intersection_end:\n            return None\n        else:\n            return Intersection(intersection_start, intersection_end)\n\n    # Parse the input tuples into Interval objects.\n    int1_obj = Interval(interval1[0], interval1[1])\n    int2_obj = Interval(interval2[0], interval2[1])\n\n    # Calculate the intersection interval.\n    intersect_obj = calculate_intersection_interval(int1_obj, int2_obj)\n\n    # If there is no intersection, return \"NO\".\n    if intersect_obj is None:\n        return \"NO\"\n    else:\n        # Calculate the length of the intersection.\n        length = intersect_obj.calculateLength()\n        # Check if the length is a prime number and return \"YES\" or \"NO\".\n        if is_prime(length):\n            return \"YES\"\n        else:\n            return \"NO\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/128": [{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes multiplied by the product of signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    def _calculate_magnitude(number):\n        \"\"\"Calculates the absolute value (magnitude) of a single integer.\"\"\"\n        return abs(number)\n\n    def _determine_sign(number):\n        \"\"\"Determines the sign (1, -1, or 0) of a single integer.\"\"\"\n        if number > 0:\n            return 1\n        elif number < 0:\n            return -1\n        else:\n            return 0\n\n    def _calculate_product_of_signs(signs_list):\n        \"\"\"Computes the product of all signs in a given list.\"\"\"\n        product = 1\n        for sign in signs_list:\n            product *= sign\n        return product\n\n    def _calculate_sum_of_magnitudes(magnitudes_list):\n        \"\"\"Computes the sum of all magnitudes in a given list.\"\"\"\n        return sum(magnitudes_list)\n\n    magnitudes = []\n    signs = []\n\n    for number in arr:\n        magnitudes.append(_calculate_magnitude(number))\n        signs.append(_determine_sign(number))\n\n    sum_of_mags = _calculate_sum_of_magnitudes(magnitudes)\n    product_of_s = _calculate_product_of_signs(signs)\n\n    return sum_of_mags * product_of_s", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/132": [{"task_id": "HumanEval/132", "solution": "def is_nested(st