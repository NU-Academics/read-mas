* (s - self._side_c)\n            if area_squared < 0: # Handle potential floating point inaccuracies\n                area_squared = 0\n            area = math.sqrt(area_squared)\n            return round(area, 2)\n\n    triangle = Triangle(a, b, c)\n    if triangle.is_valid():\n        return triangle.calculate_area()\n    else:\n        return -1", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/85": [{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n\n    Examples:\n        add([4, 2, 6, 7]) ==> 2 \n    \"\"\"\n    total_sum = 0\n    for index, element in enumerate(lst):\n        if index % 2 != 0:  # Check if the index is odd\n            if element % 2 == 0:  # Check if the element is even\n                total_sum += element\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/81": [{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs to a list of letter grades based on a predefined scale.\n    This function processes each GPA individually according to the specified grading table.\n    \"\"\"\n\n    def _convert_single_gpa(gpa):\n        \"\"\"Converts a single GPA to its corresponding letter grade.\"\"\"\n        if gpa == 4.0:\n            return 'A+'\n        elif gpa > 3.7:\n            return 'A'\n        elif gpa > 3.3:\n            return 'A-'\n        elif gpa > 3.0:\n            return 'B+'\n        elif gpa > 2.7:\n            return 'B'\n        elif gpa > 2.3:\n            return 'B-'\n        elif gpa > 2.0:\n            return 'C+'\n        elif gpa > 1.7:\n            return 'C'\n        elif gpa > 1.3:\n            return 'C-'\n        elif gpa > 1.0:\n            return 'D+'\n        elif gpa > 0.7:\n            return 'D'\n        elif gpa