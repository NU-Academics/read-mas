and self._word == other._word\n\n    def __repr__(self) -> str:\n        return f\"NumberWord('{self._word}', {self._value})\"\nclass NumberWordSequence:\n    def __init__(self):\n        self._words: List[NumberWord] = []\n\n    def add_word(self, word: NumberWord):\n        self._words.append(word)\n\n    def get_sorted_words(self) -> List[NumberWord]:\n        return sorted(self._words)\n\n    def to_space_delimited_string(self) -> str:\n        return ' '.join(nw.get_word() for nw in self._words)\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    if not numbers:\n        return \"\"\n\n    words_str_list = numbers.split(' ')\n    number_sequence = NumberWordSequence()\n\n    for word_str in words_str_list:\n        if not word_str:\n            continue\n        try:\n            numerical_value = NumberWordConverter.convert_word_to_value(word_str)\n            number_word = NumberWord(word_str, numerical_value)\n            number_sequence.add_word(number_word)\n        except ValueError:\n            # As per design, invalid number words are ignored.\n            pass\n\n    sorted_words = number_sequence.get_sorted_words()\n    sorted_word_strings = [nw.get_word() for nw in sorted_words]\n    return ' '.join(sorted_word_strings)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/11": [{"task_id": "HumanEval/11", "solution": "from typing import List\nclass BinaryString:\n    \"\"\"Encapsulates a binary string and provides validation.\"\"\"\n    def __init__(self, value: str):\n        if not isinstance(value, str):\n            raise TypeError(\"Input must be a string.\")\n        if not self._is_valid_content(value):\n            raise ValueError(\"Binary string must contain only '0's and '1's.\")\n        self._value = value\n\n    def get_value(self) -> str:\n        \"\"\"Returns the encapsulated binary string.\"\"\"\n        return self._value\n\n    def get_length(self) -> int:\n        \"\"\"Returns the length of the binary string.\"\"\"\n        return len(self._value)\n\n    @staticmethod\n    def _is_valid_content(value: str) -> bool:\n        \"\"\"Checks if the string contains only '0's and '1's.\"\"\"\n        return all(char in ('0', '1') for char in value)\nclass XORCalculator:\n    \"\"\"Performs the character-by-character binary XOR operation.\"\"\"\n    @staticmethod\n    def perform(binary_str_a: BinaryString, binary_str_b: BinaryString) -> BinaryString:\n        \"\"\"Computes the XOR of two BinaryString objects and returns a new BinaryString result.\"\"\"\n        result_chars: List[str] = []\n        for char_a, char_b in zip(binary_str_a.get_value(), binary_str_b.get_value()):\n            if char_a == char_b:\n                result_chars.append('0')\n            else:\n                result_chars.append('1')\n        return BinaryString(\"\".join(result_chars))\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    binary_a = BinaryString(a)\n    binary_b = BinaryString(b)\n\n    if binary_a.get_length() != binary_b.get_length():\n        raise ValueError(\"Input strings must have the same length.\")\n\n    result_binary_string = XORCalculator.perform(binary_a, binary_b)\n    return result_binary_string.get_value()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/16": [{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Giv