n method within the found interval.\n    for _ in range(max_bisection_iterations):\n        c = (a + b) / 2.0\n        f_c = poly(xs, c)\n\n        if abs(f_c) < tolerance:\n            return c\n\n        if f_a * f_c < 0:  # Root is in [a, c]\n            b = c\n            f_b = f_c\n        else:  # Root is in [c, b] (implies f_b * f_c < 0)\n            a = c\n            f_a = f_c\n\n    # If max_bisection_iterations reached, return the midpoint of the final interval\n    # as an approximation of the root.\n    return (a + b) / 2.0", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-10, -2]]], "plus_fail_tests": [[[5, 10, -3, 1]]]}], "HumanEval/31": [{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    import math\n\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    # Check for divisors from 3 up to sqrt(n), skipping even numbers\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/35": [{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list, or None if the list is empty.\"\"\"\n    if not l:\n        return None\n    return max(l)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/34": [{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    