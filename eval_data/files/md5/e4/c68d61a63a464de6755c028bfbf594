pend(char)\n    \n    return \"\".join(rotated_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/91": [{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts the number of \"boredom\" sentences in a given string.\n    A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    import re\n\n    class Sentence:\n        \"\"\"Represents a single parsed sentence and provides methods to analyze its first word.\"\"\"\n        def __init__(self, text: str):\n            self.text = text\n\n        def get_first_word(self) -> str:\n            \"\"\"Extracts and returns the first word of the sentence, handling leading/trailing spaces.\"\"\"\n            cleaned_text = self.text.strip()\n            words = cleaned_text.split()\n            return words[0] if words else \"\"\n\n        def is_boredom(self) -> bool:\n            \"\"\"Determines if the sentence starts with 'I' (case-sensitive).\"\"\"\n            first_word = self.get_first_word()\n            return first_word == \"I\"\n\n    def _split_into_sentences(text: str) -> list[str]:\n        \"\"\"Parses a given text string into a list of raw sentence strings using defined delimiters.\"\"\"\n        # Split by '.', '?', or '!', then filter out empty strings and strip whitespace from each.\n        sentences = re.split(r'[.?!]', text)\n        return [s.strip() for s in sentences if s.strip()]\n\n    boredom_count = 0\n    parsed_sentences = _split_into_sentences(S)\n\n    for sentence_text in parsed_sentences:\n        sentence = Sentence(sentence_text)\n        if sentence.is_boredom():\n            boredom_count += 1\n\n    return boredom_count", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["I"]]}], "HumanEval/95": [{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Checks if all key