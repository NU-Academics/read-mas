     return 0\n\n        is_negative = num < 0\n        abs_num_str = str(abs(num))\n        digit_sum = 0\n\n        for i, digit_char in enumerate(abs_num_str):\n            digit = int(digit_char)\n            if is_negative and i == 0:\n                digit_sum -= digit\n            else:\n                digit_sum += digit\n        return digit_sum\n\n    count = 0\n    if not arr:\n        return 0\n\n    for num in arr:\n        sum_of_digits = _calculate_sum_of_digits(num)\n        if sum_of_digits > 0:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/109": [{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Determines if the array can be sorted by right shifting.\n    Checks the original array and all possible right-shifted versions for non-decreasing order.\n    \"\"\"\n    if not arr:\n        return True\n\n    def _is_sorted(current_arr):\n        \"\"\"Checks if a given array is sorted in non-decreasing order.\"\"\"\n        for i in range(1, len(current_arr)):\n            if current_arr[i] < current_arr[i-1]:\n                return False\n        return True\n\n    def _right_shift(current_arr):\n        \"\"\"Performs one right shift operation on the array, returning a new shifted array.\"\"\"\n        if not current_arr:\n            return []\n        return [current_arr[-1]] + current_arr[:-1]\n\n    n = len(arr)\n    current_arr = list(arr) \n\n    # We need to check N distinct configurations (original + N-1 shifts)\n    for _ in range(n): \n        if _is_sorted(current_arr):\n            return True\n        current_arr = _right_shift(current_arr)\n        \n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/111": [{"task_id": "HumanEval/111", "solution": "def histogram(test):\n    \"\"\"Given a string representing a space separated lowercase letters, return a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\n    \n    Example:\n    histogram('a b c') == {'a': 1, 'b': 1, 'c': 1}\n    histogram('a b b a') == {'a': 2, 'b': 2}\n    histogram('a b c a b') == {'a': 2, 'b': 2}\n    histogram('b b b b a') == {'b': 4}\n    histogram('') == {}\n\n    \"\"\"\n    import collections\n\n    if not test:\n        return {}\n\n    # Split the input string into individual letters\n    letters = test.split()\n    \n    # Count the occurrences of each letter using collections.Counter\n    counts = collections.Counter(letters)\n\n    # If no letters were found (e.g., input was only spaces or empty), return an empty dict\n    if not counts:\n        return {}\n    \n    # Find the maximum count among all letters\n    max_count = max(counts.values())\n\n    # Collect all letters that have the maximum count\n    result = {}\n    for letter, count in counts.items():\n        if count == max_count:\n            result[letter] = count\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/114": [{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums.\n    Example\n    minSubArraySum([2, 3, 4, 1, 2, 4]) == 1\n    minSubArraySum([-1, -2, -3]) == -6\n    \"\"\"\n    min_so_far = nums[0]\n    current_min = nums[0]\n\n    for i in range(1, len(nums)):\n        current_min = min(nums[i], current_min + nums[i])\n        min_so_far = min(min_so_far, current_min)\n\n    return min_so_far", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/110": [{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if lst1 can be made all even by exchanging elements with lst2.\n    Returns \"YES\" if possible, \"NO\" otherwise.\"\"\"\n\n    def _is_even(number):\n        \"\"\"Checks if a number is even.\"\"\"\n        return number % 2 == 0\n\n    def _is_odd(number):\n        \"\"\"Checks if a number is odd.\"\"\"\n        return number % 2 != 0\n\n    def _count_odd_numbers(lst):\n        \"\"\"Counts the number of odd elements in a list.\"\"\"\n        count = 0\n        for num in lst:\n            if _is_odd(num):\n                count += 1\n        return count\n\n    def _count_even_numbers(lst):\n        \"\"\"Counts the number of even elements in a list.\"\"\"\n        count = 0\n        for num in lst:\n            if _is_even(num):\n                count += 1\n        return count\n\n    # Count odd numbers in lst1 that need to be replaced\n    odd_count_lst1 = _count_odd_numbers(lst1)\n\n    # Count even numbers in lst2 available for exchange\n    even_count_lst2 = _count_even_numbers(lst2)\n\n    # If the number of odd elements in lst1 is less than or equal to the\n    # number of even elements in lst2, an exchange is possible.\n    if odd_count_lst1 <= even_count_lst2:\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/113": [{"task_id": "HumanEval/113", "solution": "def _count_odd_digits(s: str) -> int:\n    \"\"\"Counts the number of odd digits within a given string.\"\"\"\n    count = 0\n    for char_digit in s:\n        digit = int(char_digit)\n        if digit % 2 != 0:\n            count += 1\n    return count\ndef _format_output(count: int) -> str:\n    \"\"\"Constructs the output string based on the odd digit count by replacing 'i'.\"\"\"\n    template = \"the number of odd elements in the string i of the input.\"\n    return template.replace(\"i\", str(count))\ndef odd_count(lst):\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each e