{"task_id": "Mbpp/585", "solution": "from typing import List, Any, Tuple\n\nclass ValidationError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass ExpensiveItemsService:\n    def expensive_items(self, items: list, n: int) -> list:\n        \"\"\"\n        Orchestrates validation, handles n, sorts, and selects the top-n items.\n        Operates on a shallow copy of items to avoid side effects.\n        \"\"\"\n        validated_items_with_indices = self._validate_items(items)\n\n        if n <= 0:\n            return []\n\n        sorted_items = self._sort_items_desc(validated_items_with_indices)\n        return sorted_items[:n]\n\n    def _validate_items(self, items: list) -> List[Tuple[int, Any]]:\n        \"\"\"\n        Validates each item for a numeric 'price' and returns valid items with original indices.\n        Raises ValidationError on the first invalid item.\n        \"\"\"\n        validated_items = []\n        for i, item in enumerate(items):\n            if not isinstance(item, dict):\n                raise ValidationError(f\"Item at index {i} is not a mapping (dict).\")\n            if 'price' not in item:\n                raise ValidationError(f\"Item at index {i} is missing 'price' key.\")\n            if not isinstance(item['price'], (int, float)):\n                raise ValidationError(f\"Item at index {i} has non-numeric 'price' value.\")\n            validated_items.append((i, item))\n        return validated_items\n\n    def _sort_items_desc(self, validated_items: List[Tuple[int, Any]]) -> list:\n        \"\"\"\n        Sorts items stably in descending order by price and returns the sorted item dictionaries.\n        Relies on Python's Timsort for stability.\n        \"\"\"\n        sorted_pairs = sorted(validated_items, key=lambda pair: pair[1]['price'], reverse=True)\n        return [item for _, item in sorted_pairs]\n\ndef expensive_items(items: list, n: int) -> list:\n    \"\"\"\n    Public API. Delegates to ExpensiveItemsService.expensive_items to find the n most expensive items.\n    Raises ValidationError if any input item is invalid.\n    \"\"\"\n    svc = ExpensiveItemsService()\n    return svc.expensive_items(items, n)"}
{"task_id": "Mbpp/588", "solution": "def _validate_nonempty(values):\n    \"\"\"\n    Validates that the input list is not empty.\n    Raises ValueError if the list is empty.\n    \"\"\"\n    if not values:\n        raise ValueError(\"input list is empty\")\n\ndef _validate_all_numeric(values):\n    \"\"\"\n    Validates that all elements in the input list are numeric (int or float).\n    Raises TypeError if any element is non-numeric.\n    \"\"\"\n    for item in values:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"non-numeric element in input list\")\n\ndef big_diff(values):\n    \"\"\"\n    Calculates the difference between the largest and smallest value in a list.\n    Validates the input list for non-emptiness and numeric elements.\n    \"\"\"\n    _validate_nonempty(values)\n    _validate_all_numeric(values)\n    return max(values) - min(values)"}
{"task_id": "Mbpp/589", "solution": "import math\nfrom dataclasses import dataclass\n\n@dataclass\nclass Range:\n    \"\"\"Data holder for start and end.\"\"\"\n    start: int\n    end: int\n\nclass PerfectSquare:\n    \"\"\"Wraps integer square value and provides is_perfect_square().\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_perfect_square(self) -> bool:\n        \"\"\"Checks if the value is a perfect square.\"\"\"\n        if self.value < 0:\n            return False\n        sqrt_val = math.isqrt(self.value)\n        return sqrt_val * sqrt_val == self.value\n\nclass ResultList:\n    \"\"\"Collects integer squares and returns a sorted list.\"\"\"\n    def __init__(self, squares: list[int]):\n        self.squares = squares\n\n    def sort(self) -> list[int]:\n        \"\"\"Returns the collected squares sorted in ascending order.\"\"\"\n        return sorted(self.squares)\n\nclass Validator:\n    \"\"\"Validates types and basic bounds.\"\"\"\n    def is_integer(self, x) -> bool:\n        \"\"\"Checks if the input is an integer.\"\"\"\n        return isinstance(x, int)\n\n    def check_bounds(self, start, end) -> bool:\n        \"\"\"Checks if start is less than or equal to end.\"\"\"\n        return start <= end\n\nclass PerfectSquaresService:\n    \"\"\"Orchestrates validation and generation of perfect squares.\"\"\"\n    def __init__(self):\n        self._validator = Validator()\n\n    def perfect_squares(self, start: int, end: int) -> list[int]:\n        \"\"\"Finds perfect squares in the inclusive integer range [start, end].\"\"\"\n        self.validate_inputs(start, end)\n        squares = self.generate_squares(start, end)\n        return ResultList(squares).sort()\n\n    def validate_inputs(self, start, end) -> bool:\n        \"\"\"Validates that inputs are integers and raises TypeError if not.\"\"\"\n        if not self._validator.is_integer(start):\n            raise TypeError(f\"Start value must be an integer, got {type(start).__name__}\")\n        if not self._validator.is_integer(end):\n            raise TypeError(f\"End value must be an integer, got {type(end).__name__}\")\n        return True\n\n    def generate_squares(self, start, end) -> list[int]:\n        \"\"\"Generates a list of perfect squares within the given range.\"\"\"\n        effective_start_for_sqrt = max(0, start)\n        if effective_start_for_sqrt > end:\n            return []\n\n        k_min = math.ceil(math.sqrt(effective_start_for_sqrt))\n        k_max = math.floor(math.sqrt(end))\n\n        squares = []\n        for k in range(int(k_min), int(k_max) + 1):\n            square = k * k\n            if start <= square <= end:\n                squares.append(square)\n        return squares\n\ndef perfect_squares(start: int, end: int) -> list[int]:\n    \"\"\"Finds perfect squares between two given numbers.\"\"\"\n    svc = PerfectSquaresService()\n    return svc.perfect_squares(start, end)"}
{"task_id": "Mbpp/591", "solution": "def swap_List(lst: list) -> list:\n    \"\"\"Return a list with first and last elements swapped.\n\n    If len(lst) < 2: return lst. Else: return new list with first and last swapped and intermediate elements preserved.\n    \"\"\"\n    if len(lst) < 2:\n        return lst\n    else:\n        new_lst = list(lst)  # Create a copy to avoid modifying the original list\n        new_lst[0], new_lst[-1] = new_lst[-1], new_lst[0]\n        return new_lst"}
{"task_id": "Mbpp/590", "solution": "import math\nfrom typing import Tuple\n\ndef polar_rect(a, b) -> Tuple[Tuple[float, float], complex]:\n    \"\"\"\n    Converts Cartesian coordinates (a, b) to polar coordinates (r, theta) and a complex number.\n    Raises TypeError if inputs are not numeric.\n    \"\"\"\n    if not (isinstance(a, (int, float)) and isinstance(b, (int, float))):\n        raise TypeError(\"polar_rect requires two numeric inputs (a, b)\")\n    r = math.sqrt(a * a + b * b)\n    theta = math.atan2(b, a)  # theta is in radians\n    complex_repr = complex(a, b)\n    return ((r, theta), complex_repr)"}
{"task_id": "Mbpp/592", "solution": "class BinomialCoefficient:\n    \"\"\"Helper class for computing binomial coefficients C(n, k).\"\"\"\n\n    @staticmethod\n    def compute(n: int, k: int) -> int:\n        \"\"\"\n        Computes C(n, k) using the multiplicative method for exact integer results.\n        Returns 0 if k < 0 or k > n.\n        \"\"\"\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        if k > n // 2:\n            k = n - k\n\n        res = 1\n        for i in range(k):\n            res = res * (n - i) // (i + 1)\n        return res\n\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients.\n    Calculates S(n) = sum_{k=0}^{n-1} C(n,k) * C(n,k+1).\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    total_sum = 0\n    for k in range(n):\n        c_k = BinomialCoefficient.compute(n, k)\n        c_k1 = BinomialCoefficient.compute(n, k + 1)\n        \n        product = c_k * c_k1\n        total_sum += product\n    \n    return total_sum"}
{"task_id": "Mbpp/596", "solution": "import sys\n\ndef tuple_size(t: tuple) -> int:\n    \"\"\"\n    Return the size in bytes of the provided tuple using sys.getsizeof.\n    Raises TypeError if the provided argument is not a tuple.\n    \"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(\"tuple_size expects a tuple\")\n    return sys.getsizeof(t)"}
{"task_id": "Mbpp/593", "solution": "class Octet:\n    \"\"\"Represents a single octet of an IP address, with methods for normalization.\"\"\"\n    def __init__(self, raw: str, position: int):\n        self.raw = raw\n        self.value = int(raw)\n        self.position = position\n\n    def removeLeadingZeros(self) -> None:\n        \"\"\"Updates the raw string representation of the octet by removing leading zeros.\"\"\"\n        self.raw = str(self.value)\n\nclass Validator:\n    \"\"\"Provides stateless utility for validating IPv4 address format.\"\"\"\n    def isValidIPv4(self, input_str: str) -> bool:\n        \"\"\"Checks if the input string is in a basic IPv4 dotted-decimal format.\"\"\"\n        parts = input_str.split('.')\n        if len(parts) != 4:\n            return False\n        for part in parts:\n            if not part.isdigit():\n                return False\n        return True\n\nclass Parser:\n    \"\"\"Provides utility for splitting an IP address string into its octet components.\"\"\"\n    def splitToOctets(self, input_str: str) -> list[str]:\n        \"\"\"Splits an IPv4 address string into a list of its four octet strings.\"\"\"\n        return input_str.split('.')\n\nclass Formatter:\n    \"\"\"Provides utility for joining octet components back into an IP address string.\"\"\"\n    def joinOctets(self, octets: list[Octet]) -> str:\n        \"\"\"Joins a list of Octet objects' raw values into a single dotted-decimal string.\"\"\"\n        return \".\".join([o.raw for o in octets])\n\nclass RemoveZeroIPService:\n    \"\"\"Orchestrates the process of removing leading zeros from an IP address.\"\"\"\n    def __init__(self):\n        self.validator = Validator()\n        self.parser = Parser()\n        self.formatter = Formatter()\n\n    def removezero_ip(self, input_str: str) -> str:\n        \"\"\"Processes an IPv4 address string to remove leading zeros from each octet.\"\"\"\n        # The design states SRS assumes valid input; validation is optional here.\n        # If full validation were required:\n        # if not self.validator.isValidIPv4(input_str):\n        #    # Implement error handling or specific behavior for invalid input.\n        #    pass\n\n        octet_strs = self.parser.splitToOctets(input_str)\n        octets = []\n        for idx, raw_octet_str in enumerate(octet_strs):\n            octet = Octet(raw=raw_octet_str, position=idx + 1)\n            octet.removeLeadingZeros()\n            octets.append(octet)\n        return self.formatter.joinOctets(octets)\n\ndef removezero_ip(input: str) -> str:\n    \"\"\"Removes leading zeros from each octet of a given IPv4 address string.\"\"\"\n    service = RemoveZeroIPService()\n    return service.removezero_ip(input)"}
{"task_id": "Mbpp/594", "solution": "from typing import List\n\nclass NumberElement:\n    \"\"\"Represents a number in the list with its original index.\"\"\"\n    def __init__(self, value: int, index: int):\n        self.value = value\n        self.index = index\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the number is even.\"\"\"\n        return self.value % 2 == 0\n\n    def isOdd(self) -> bool:\n        \"\"\"Checks if the number is odd.\"\"\"\n        return self.value % 2 != 0\n    \n    @property\n    def parity(self) -> str:\n        \"\"\"Returns the parity of the number.\"\"\"\n        return 'even' if self.isEven() else 'odd'\n\nclass IntegerList:\n    \"\"\"Wraps a list of integers into a list of NumberElement objects.\"\"\"\n    def __init__(self, numbers: List[int]):\n        self.elements: List[NumberElement] = [NumberElement(value, i) for i, value in enumerate(numbers)]\n\nclass DiffEvenOddService:\n    \"\"\"Service to find the difference between the first even and first odd numbers.\"\"\"\n    def diff_even_odd(self, numbers: List[int]) -> int:\n        first_even: int = None\n        first_odd: int = None\n\n        integer_list = IntegerList(numbers)\n\n        for element in integer_list.elements:\n            if first_odd is None and element.isOdd():\n                first_odd = element.value\n            \n            if first_even is None and element.isEven():\n                first_even = element.value\n            \n            if first_even is not None and first_odd is not None:\n                break\n        \n        return first_even - first_odd\n\ndef diff_even_odd(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the difference of the first even and first odd number of a given list.\n    Scans the list from left-to-right to identify the first occurrence of each.\n    \"\"\"\n    service = DiffEvenOddService()\n    return service.diff_even_odd(numbers)"}
{"task_id": "Mbpp/598", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import List\n\nclass Number:\n    \"\"\"Encapsulates an integer and provides methods to get its digit count and individual digits.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def digit_count(self) -> int:\n        \"\"\"Returns the number of digits in the integer.\"\"\"\n        if self.value == 0:\n            return 1\n        return int(math.log10(abs(self.value))) + 1\n\n    def digits(self) -> List[int]:\n        \"\"\"Returns a list of digits of the integer, from least to most significant.\"\"\"\n        if self.value == 0:\n            return [0]\n        temp_value = abs(self.value)\n        digit_list = []\n        while temp_value > 0:\n            digit_list.append(temp_value % 10)\n            temp_value //= 10\n        return digit_list[::-1] # Reverse to get most significant first, though order for sum of powers doesn't strictly matter\n\nclass Digit:\n    \"\"\"Represents a single digit and provides a method to raise it to a power.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def pow(self, p: int) -> int:\n        \"\"\"Returns the digit raised to the power p.\"\"\"\n        return self.value ** p\n\n@dataclass\nclass Result:\n    \"\"\"A dataclass to represent the outcome of an Armstrong number check.\"\"\"\n    is_armstrong: bool\n\ndef _sum_of_powered_digits(n: int) -> int:\n    \"\"\"Calculates the sum of each digit raised to the power of the total number of digits.\"\"\"\n    number_obj = Number(n)\n    digit_count = number_obj.digit_count()\n    digits = number_obj.digits()\n\n    total_sum = 0\n    for d_val in digits:\n        digit_obj = Digit(d_val)\n        total_sum += digit_obj.pow(digit_count)\n    return total_sum\n\ndef armstrong_number(n: int) -> bool:\n    \"\"\"Checks if the given number is an Armstrong number.\"\"\"\n    total_sum = _sum_of_powered_digits(n)\n    return total_sum == n"}
{"task_id": "Mbpp/597", "solution": "def find_kth(arr1: list, arr2: list, k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays using a binary search approach.\n    This function assumes that the input arrays are sorted and k is within a valid range.\n    \"\"\"\n    m, n = len(arr1), len(arr2)\n\n    # Ensure arr1 is the shorter array to optimize binary search range.\n    if m > n:\n        arr1, arr2 = arr2, arr1\n        m, n = n, m\n\n    # Define the binary search range for 'i', the number of elements taken from arr1.\n    # 'j' (elements from arr2) is determined by k - i.\n    # Constraints: 0 <= i <= m and 0 <= j <= n (which implies k - n <= i <= k).\n    # Combined, this gives the search range for i.\n    low = max(0, k - n)\n    high = min(k, m)\n\n    while low <= high:\n        i = (low + high) // 2  # Number of elements from arr1 in the left partition\n        j = k - i              # Number of elements from arr2 in the left partition\n\n        # Determine the boundary elements for comparison.\n        # Use float('-inf') or float('inf') if an index is out of bounds.\n        L1 = arr1[i - 1] if i > 0 else float('-inf')\n        R1 = arr1[i] if i < m else float('inf')\n        L2 = arr2[j - 1] if j > 0 else float('-inf')\n        R2 = arr2[j] if j < n else float('inf')\n\n        # Check if the partitions are correctly balanced.\n        # The k-th element is found if the largest element in the left partition\n        # is less than or equal to the smallest element in the right partition.\n        if L1 <= R2 and L2 <= R1:\n            # The correct partition is found. The k-th smallest element is the maximum\n            # of the elements at the partition boundary in the left half.\n            return max(L1, L2)\n        elif L1 > R2:\n            # arr1's left partition is too large, meaning 'i' is too big.\n            # Adjust high to search in the left half of the current range.\n            high = i - 1\n        else: # L2 > R1\n            # arr2's left partition is too large, meaning 'i' is too small.\n            # Adjust low to search in the right half of the current range.\n            low = i + 1\n\n    # This part should ideally be unreachable given valid inputs (k within range and arrays sorted),\n    # as a solution for 'i' will always be found.\n    return -1"}
{"task_id": "Mbpp/599", "solution": "from typing import Tuple\n\ndef sum_average(n) -> Tuple[int, float]:\n    \"\"\"\n    Calculates the sum and average of the first n natural numbers.\n    Validates n to be an integer greater than or equal to 1.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer >= 1\")\n\n    natural_sum = n * (n + 1) // 2\n    average = natural_sum / n\n\n    return (natural_sum, average)"}
{"task_id": "Mbpp/600", "solution": "from dataclasses import dataclass\nfrom typing import Union\n\n@dataclass\nclass Number:\n    value: Union[int, float]\n\n@dataclass\nclass ProgrammingLanguage:\n    name: str\n\nclass EvenChecker:\n    \"\"\"Encapsulates parity-check logic.\"\"\"\n    def is_Even(self, n: Union[int, float]) -> bool:\n        \"\"\"Returns True if n is an even number, False otherwise.\"\"\"\n        return n % 2 == 0\n\ndef is_Even(n: Union[int, float]) -> bool:\n    \"\"\"Checks whether the given number is even or not, delegating to EvenChecker.\"\"\"\n    checker = EvenChecker()\n    return checker.is_Even(n)"}
{"task_id": "Mbpp/602", "solution": "from collections import Counter\nfrom typing import Optional\n\ndef first_repeated_char(input_string: str) -> Optional[str]:\n    \"\"\"\n    Finds the first character in the string that appears more than once.\n    Returns None if no character is repeated.\n    \"\"\"\n    counts = Counter(input_string)\n    for char in input_string:\n        if counts[char] >= 2:\n            return char\n    return None"}
{"task_id": "Mbpp/604", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass InputString:\n  value: str\n\n@dataclass\nclass Word:\n  text: str\n  index: int\n\n@dataclass\nclass ReversedString:\n  value: str\n\ndef reverse_words(input: str) -> str:\n    \"\"\"Accepts a single string and returns a string with the order of words reversed.\n\n    Behavior: split on U+0020, reverse token order, join with single spaces, preserve internal word characters.\n    \"\"\"\n    tokens = input.split(' ')\n    words = [Word(text=t, index=i) for i, t in enumerate(tokens)]\n    reversed_words = list(reversed(words))\n    output_str = ' '.join(w.text for w in reversed_words)\n    return output_str"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(n: int) -> list[int]:\n    \"\"\"\n    Returns an ascending list of Ludic numbers less than or equal to n.\n    Preconditions: Caller supplies integer n; behavior for other inputs unspecified.\n    \"\"\"\n    return _generate_ludic_up_to(n)\n\ndef _generate_ludic_up_to(n: int) -> list[int]:\n    \"\"\"\n    Internal generator implementing the Ludic sieve algorithm; returns list[int] \u2264 n in ascending order.\n    \"\"\"\n    if n < 1:\n        return []\n\n    ludic_numbers = []\n    # Initialize a list of numbers from 1 to n. This list will be modified in place.\n    candidates = list(range(1, n + 1))\n\n    # The sieve loop continues as long as there are candidates.\n    # The first element of 'candidates' is always the next Ludic number.\n    while candidates:\n        next_ludic = candidates[0]\n        ludic_numbers.append(next_ludic)\n        \n        # Remove the current Ludic number from candidates before sieving,\n        # as the sieve rule applies to the *remaining* sequence.\n        candidates.pop(0)\n\n        # Apply the sieve step only if 'next_ludic' is greater than 1.\n        # Removing every 1st element would incorrectly empty the list.\n        if next_ludic > 1:\n            _sieve_step(candidates, next_ludic)\n            \n    return ludic_numbers\n\ndef _sieve_step(sequence: list[int], step_index: int) -> None:\n    \"\"\"\n    Internal in-place mutation helper that removes every k-th remaining element according to Ludic sieve rules.\n    Here, k is `step_index` (1-based).\n    \"\"\"\n    indices_to_remove = []\n    current_length = len(sequence)\n    \n    # Iterate from the (step_index-1)-th element (0-indexed) up to the end of the list,\n    # with a step of `step_index`.\n    for i in range(step_index - 1, current_length, step_index):\n        indices_to_remove.append(i)\n        \n    # Remove elements from the end to the beginning to preserve correct indices during popping.\n    for i in reversed(indices_to_remove):\n        if i < len(sequence): \n            sequence.pop(i)"}
{"task_id": "Mbpp/605", "solution": "import math\n\ndef prime_num(n: int) -> bool:\n    \"\"\"\n    Checks if the given integer is a prime number.\n    Applies short-circuit evaluations and an optimized divisor search.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0: # All other even numbers are not prime\n        return False\n    \n    # Check for odd divisors from 3 up to the square root of n.\n    # The +1 ensures that int(sqrt(n)) itself is included if it's an odd divisor.\n    limit = int(math.sqrt(n)) + 1\n    for i in range(3, limit, 2):\n        if n % i == 0:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/608", "solution": "def validate(n):\n    \"\"\"Raise ValueError if n is not int or n < 0.\"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer.\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative.\")\n\ndef _compute_bell_triangle(n):\n    \"\"\"Internal: compute using Bell triangle, return Python int.\"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize Bell triangle\n    # bell_triangle[i][j] stores the element at row i, column j\n    bell_triangle = [[0] * (n + 1) for _ in range(n + 1)]\n    bell_triangle[0][0] = 1\n\n    for i in range(1, n + 1):\n        # The first element of a row is the last element of the previous row\n        bell_triangle[i][0] = bell_triangle[i-1][i-1]\n        for j in range(1, i + 1):\n            # Subsequent elements are sum of element to its left in current row\n            # and element above-left in previous row\n            bell_triangle[i][j] = bell_triangle[i][j-1] + bell_triangle[i-1][j-1]\n    \n    # The nth Bell number is the first element of row n\n    return bell_triangle[n][0]\n\ndef compute(n):\n    \"\"\"Return B_n as Python int using integer arithmetic.\"\"\"\n    return _compute_bell_triangle(n)\n\ndef bell_Number(n):\n    \"\"\"Compute and return B_n (zero-based: B0=1). Validates type and sign and returns Python int or raises ValueError.\"\"\"\n    validate(n)\n    return compute(n)"}
{"task_id": "Mbpp/606", "solution": "import math\n\nPI = math.pi\n\nclass DegreeToRadianConverter:\n    def __init__(self):\n        pass\n\n    def convert(self, degrees) -> float:\n        \"\"\"Converts degrees to radians after validating input type.\"\"\"\n        if not isinstance(degrees, (int, float)):\n            raise TypeError(\"Input 'degrees' must be a numeric value (int or float).\")\n        \n        radians = degrees * PI / 180.0\n        return radians\n\ndef radian_degree(degrees):\n    \"\"\"Converts degrees to radians. Non-numeric inputs raise TypeError.\"\"\"\n    converter = DegreeToRadianConverter()\n    return converter.convert(degrees)"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list, k):\n    \"\"\"Remove the k'th element (1-based index) from input_list and return a new list.\n\n    Raises ValueError if k is not an integer or is out of range (1..len(input_list)).\n    \"\"\"\n    if not isinstance(k, int):\n        raise ValueError(\"k must be an integer.\")\n    if not (1 <= k <= len(input_list)):\n        raise ValueError(\"k is out of range.\")\n\n    # Adjust k to be a 0-based index for list manipulation\n    index_to_remove = k - 1\n\n    return input_list[:index_to_remove] + input_list[index_to_remove+1:]"}
{"task_id": "Mbpp/607", "solution": "import re\n\nclass Text:\n    \"\"\"Holds input text content and provides length information.\"\"\"\n    def __init__(self, content: str):\n        self.content = content\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the text content.\"\"\"\n        return len(self.content)\n\nclass Pattern:\n    \"\"\"Holds pattern expression string.\"\"\"\n    def __init__(self, expression: str):\n        self.expression = expression\n\nclass MatchResult:\n    \"\"\"Represents the 3-tuple (match, start, end).\"\"\"\n    def __init__(self, match: str, start: int, end: int):\n        self.match = match\n        self.start = start\n        self.end = end\n\n    def to_tuple(self) -> tuple[str, int, int]:\n        \"\"\"Converts the MatchResult to a (match, start, end) tuple.\"\"\"\n        return (self.match, self.start, self.end)\n\nclass RegexEngine:\n    \"\"\"Performs regex matching using host regex library and returns first/leftmost MatchResult.\"\"\"\n    def match(self, text: str, pattern: str) -> MatchResult:\n        \"\"\"Applies standard regex matching semantics to find the first/leftmost match.\"\"\"\n        match_obj = re.search(pattern, text)\n        if match_obj:\n            return MatchResult(match_obj.group(0), match_obj.start(), match_obj.end())\n        return MatchResult(\"\", -1, -1) # Default for no match, behavior left unspecified by design.\n\ndef find_literals(text: str, pattern: str) -> tuple[str, int, int]:\n    \"\"\"Public API: search text (string) for regex pattern (string) and return (match, start, end).\"\"\"\n    regex_engine = RegexEngine()\n    match_result = regex_engine.match(text, pattern)\n    return match_result.to_tuple()"}
{"task_id": "Mbpp/611", "solution": "from typing import List, Optional\n\ndef _extract_column_values(matrix: List[List[float]], n: int) -> List[float]:\n    \"\"\"Extracts values at column index n from rows that contain it.\"\"\"\n    values: List[float] = []\n    for row in matrix:\n        if len(row) > n:\n            values.append(row[n])\n    return values\n\ndef max_of_nth(matrix: List[List[float]], n: int) -> Optional[float]:\n    \"\"\"\n    Computes the maximum value of the n-th column in a matrix.\n    Returns None if no values are found for the given column index.\n    \"\"\"\n    values = _extract_column_values(matrix, n)\n    if not values:\n        return None\n    return max(values)"}
{"task_id": "Mbpp/612", "solution": "import typing\n\ndef merge(input: typing.List[typing.List[typing.Any]]) -> typing.List[typing.List[typing.Any]]:\n    \"\"\"\n    Collects first elements of sublists into the first returned list and second elements into the second.\n    If input is empty, returns [[], []].\n    \"\"\"\n    first_list = []\n    second_list = []\n    for sublist in input:\n        first_list.append(sublist[0])\n        second_list.append(sublist[1])\n    return [first_list, second_list]"}
{"task_id": "Mbpp/614", "solution": "from typing import List, Tuple\n\ndef _validate_input(tuple_list: List[Tuple[int, ...]]) -> None:\n    \"\"\"Validates the input to ensure it's a list of tuples with integer elements.\"\"\"\n    if not isinstance(tuple_list, list):\n        raise TypeError('Input must be a list of tuples.')\n    for elem in tuple_list:\n        if not isinstance(elem, tuple):\n            raise TypeError('Each element of the input list must be a tuple.')\n        for v in elem:\n            if not isinstance(v, int):\n                raise TypeError('All elements inside tuples must be integers.')\n\ndef _sum_tuple(tuple_obj: Tuple[int, ...]) -> int:\n    \"\"\"Calculates the sum of integers within a single tuple.\"\"\"\n    return sum(tuple_obj)\n\nclass CummulativeSumFunction:\n    \"\"\"Encapsulates the algorithm to compute the cumulative sum.\"\"\"\n    def execute(self, tupleList: List[Tuple[int, ...]]) -> int:\n        \"\"\"Compute the cumulative sum of all integers in a list of tuples.\"\"\"\n        total = 0\n        for t in tupleList:\n            total += _sum_tuple(t)\n        return total\n\ndef cummulative_sum(tuple_list: List[Tuple[int, ...]]) -> int:\n    \"\"\"\n    Calculates the cumulative sum of all integers in a list of tuples.\n    Raises TypeError for invalid input types as per design.\n    \"\"\"\n    _validate_input(tuple_list)\n    csf = CummulativeSumFunction()\n    return csf.execute(tupleList=tuple_list)"}
{"task_id": "Mbpp/615", "solution": "from typing import Tuple, List\n\ndef compute_mean(inner_tuple: Tuple[float, ...]) -> float:\n    \"\"\"Computes the arithmetic mean of a tuple of numeric values.\n    Returns the sum of elements divided by their count as a float.\n    \"\"\"\n    return sum(inner_tuple) / len(inner_tuple)\n\ndef average_tuple(tuple_of_tuples: Tuple[Tuple[float, ...], ...]) -> List[float]:\n    \"\"\"Calculates the average value for each inner tuple in a tuple of tuples.\n    Returns a list of floats, where each float is the average of an inner tuple.\n    \"\"\"\n    averages = []\n    for inner_tuple in tuple_of_tuples:\n        mean = compute_mean(inner_tuple)\n        averages.append(mean)\n    return averages"}
{"task_id": "Mbpp/619", "solution": "def _is_digit_char(c: str) -> bool:\n    \"\"\"Helper to determine if a character is an ASCII digit ('0'-'9').\"\"\"\n    return '0' <= c <= '9'\n\ndef move_num(s: str) -> str:\n    \"\"\"Moves all digit characters to the end of the string, preserving relative order.\"\"\"\n    non_digits = []\n    digits = []\n    for char in s:\n        if _is_digit_char(char):\n            digits.append(char)\n        else:\n            non_digits.append(char)\n    return \"\".join(non_digits) + \"\".join(digits)"}
{"task_id": "Mbpp/616", "solution": "class Validator:\n    \"\"\"Stateless validator for tuple modulo inputs.\"\"\"\n\n    @staticmethod\n    def validate_length(a: tuple, b: tuple) -> None:\n        \"\"\"Raises ValueError if input tuples have different lengths.\"\"\"\n        if len(a) != len(b):\n            raise ValueError(\"Input tuples must have the same length.\")\n\n    @staticmethod\n    def validate_types(a: tuple, b: tuple) -> None:\n        \"\"\"Raises TypeError if any element in tuples is not an integer.\"\"\"\n        for tup in (a, b):\n            for x in tup:\n                if not isinstance(x, int):\n                    raise TypeError(\"All elements in input tuples must be integers.\")\n\n    @staticmethod\n    def validate_no_zero_divisor(b: tuple) -> None:\n        \"\"\"Raises ZeroDivisionError if any divisor in tuple 'b' is zero.\"\"\"\n        for x in b:\n            if x == 0:\n                raise ZeroDivisionError(\"Cannot perform modulo by zero.\")\n\nclass TupleModuloService:\n    \"\"\"Service to compute element-wise modulo of two tuples.\"\"\"\n\n    def tuple_modulo(self, a: tuple[int, ...], b: tuple[int, ...]) -> tuple[int, ...]:\n        \"\"\"Performs element-wise modulo a[i] % b[i] and returns the result as a tuple.\"\"\"\n        return tuple(a_val % b_val for a_val, b_val in zip(a, b))\n\ndef tuple_modulo(a, b):\n    \"\"\"\n    Performs element-wise modulo on two tuples of the same length.\n\n    The function validates inputs and computes result[i] = a[i] % b[i].\n    \"\"\"\n    Validator.validate_length(a, b)\n    Validator.validate_types(a, b)\n    Validator.validate_no_zero_divisor(b)\n    return TupleModuloService().tuple_modulo(a, b)"}
{"task_id": "Mbpp/618", "solution": "def div_list(list_a: list, list_b: list) -> list:\n    \"\"\"\n    SRS trace: FR1, FR2, FR3. Compute element-wise division of two equal-length lists.\n    Preconditions: len(list_a) == len(list_b) (enforced with assertion per SRS scope).\n    \"\"\"\n    assert len(list_a) == len(list_b), \"Input lists must have equal length.\"\n    return [float(list_a[i] / list_b[i]) for i in range(len(list_a))]"}
{"task_id": "Mbpp/620", "solution": "from typing import List, Optional\n\nclass Number:\n    \"\"\"A wrapper for a single integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value: int = value\n\nclass NumberList:\n    \"\"\"A lightweight wrapper for a list of integers.\"\"\"\n    def __init__(self, numbers: List[int]):\n        self.numbers: List[int] = numbers\n\nclass Subset:\n    \"\"\"An immutable container for a subset of numbers.\"\"\"\n    def __init__(self, members: List[Number]):\n        self.members: List[Number] = members\n\n    def size(self) -> int:\n        \"\"\"Returns the number of elements in the subset.\"\"\"\n        return len(self.members)\n\nclass SubsetFinder:\n    \"\"\"Orchestrates input validation and computation of the largest divisible subset.\"\"\"\n    def largest_subset(self, numbers: List[int]) -> int:\n        \"\"\"Validates input, computes the largest divisible subset, and returns its size.\"\"\"\n        # The design intended validate_input to perform checks and raise errors.\n        # However, due to the strict output constraint \"No isinstance() checks or raise exceptions for edge cases\",\n        # validation is effectively bypassed in this implementation.\n        self.validate_input(numbers)\n        subset = self.compute_largest_divisible_subset(numbers)\n        return subset.size()\n\n    def validate_input(self, numbers) -> bool:\n        \"\"\"Performs input validation (functionally a no-op due to strict output constraints).\"\"\"\n        # This method's logic for type checking and raising ValueError is omitted\n        # to adhere to the specific output instruction \"No isinstance() checks or raise exceptions for edge cases\".\n        return True\n\n    def compute_largest_divisible_subset(self, numbers: List[int]) -> Subset:\n        \"\"\"Computes the largest subset where every pair is divisible using dynamic programming.\"\"\"\n        if not numbers:\n            return Subset(members=[])\n\n        sorted_numbers = sorted(numbers)\n        n = len(sorted_numbers)\n\n        dp: List[int] = [1] * n\n        prev: List[Optional[int]] = [None] * n\n\n        max_len = 0\n        last_idx = -1\n\n        for i in range(n):\n            for j in range(i):\n                # Check for divisibility, ensuring no ZeroDivisionError if 0 is present.\n                if sorted_numbers[j] != 0 and sorted_numbers[i] % sorted_numbers[j] == 0:\n                    if dp[j] + 1 > dp[i]:\n                        dp[i] = dp[j] + 1\n                        prev[i] = j\n            \n            if dp[i] > max_len:\n                max_len = dp[i]\n                last_idx = i\n\n        result_members: List[Number] = []\n        if last_idx != -1:\n            current_idx = last_idx\n            while current_idx is not None:\n                result_members.append(Number(sorted_numbers[current_idx]))\n                current_idx = prev[current_idx]\n            result_members.reverse()\n\n        return Subset(members=result_members)\n\ndef largest_subset(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of a list of numbers\n    so that every pair is divisible.\n    \"\"\"\n    finder = SubsetFinder()\n    return finder.largest_subset(numbers)"}
