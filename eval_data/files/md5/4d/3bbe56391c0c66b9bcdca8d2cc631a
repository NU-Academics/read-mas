{"task_id": "Mbpp/123", "solution": "import math\n\ndef amicable_numbers_sum(N: int) -> int:\n    \"\"\"\n    Sums all amicable numbers from 1 to a specified number N.\n    \"\"\"\n\n    def _sum_of_proper_divisors(num: int) -> int:\n        \"\"\"\n        Computes the sum of proper divisors for a given number.\n        \"\"\"\n        if num <= 1:\n            return 0\n        s = 1  # 1 is always a proper divisor\n        limit = math.isqrt(num)\n        for i in range(2, limit + 1):\n            if num % i == 0:\n                s += i\n                if i * i != num:\n                    s += num // i\n        return s\n\n    amicable_numbers = set()\n    divisor_sum_cache = {}\n\n    def get_cached_divisor_sum(num: int) -> int:\n        \"\"\"\n        Returns the sum of proper divisors, using a cache to avoid recomputation.\n        \"\"\"\n        if num not in divisor_sum_cache:\n            divisor_sum_cache[num] = _sum_of_proper_divisors(num)\n        return divisor_sum_cache[num]\n\n    for a in range(1, N + 1):\n        sum_a = get_cached_divisor_sum(a)\n\n        # A number is not amicable with itself\n        if sum_a == a:\n            continue\n\n        # Compute sum_b even if sum_a is greater than N, as required by design.\n        sum_b = get_cached_divisor_sum(sum_a)\n\n        # Check for mutuality: sum_of_proper_divisors(b) = a\n        if sum_b == a:\n            # If a and sum_a form an amicable pair, add 'a' to the set.\n            amicable_numbers.add(a)\n\n    return sum(amicable_numbers)"}
{"task_id": "Mbpp/126", "solution": "class Number:\n    \"\"\"Represents a number input.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass Divisor:\n    \"\"\"Represents a single positive integer divisor.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass DivisorSet:\n    \"\"\"Manages a collection of unique integer divisors and computes their sum.\"\"\"\n    def __init__(self) -> None:\n        self._divisors: set[int] = set()\n\n    def add(self, divisor: Divisor) -> None:\n        \"\"\"Adds a divisor's value to the set.\"\"\"\n        self._divisors.add(divisor.value)\n\n    def contains(self, divisor: Divisor) -> bool:\n        \"\"\"Checks if the divisor's value is in the set.\"\"\"\n        return divisor.value in self._divisors\n\n    def sum(self) -> int:\n        \"\"\"Calculates the arithmetic sum of all unique divisors.\"\"\"\n        return sum(self._divisors)\n\ndef sum(a: int, b: int) -> int:\n    \"\"\"\n    Computes the sum of all common positive divisors of two given numbers.\n    The search for divisors is limited to the absolute minimum of the two inputs.\n    \"\"\"\n    common_divisors = DivisorSet()\n    limit = min(abs(a), abs(b))\n\n    for d in range(1, limit + 1):\n        if a % d == 0 and b % d == 0:\n            common_divisors.add(Divisor(d))\n\n    return common_divisors.sum()"}
{"task_id": "Mbpp/125", "solution": "from typing import List\n\nclass Substring:\n    \"\"\"Represents a contiguous substring with its '0' and '1' counts and their difference.\"\"\"\n    def __init__(self, start: int, end: int, original_string_ref: str):\n        self.start = start\n        self.end = end # inclusive end index\n        self.zeros: int = 0\n        self.ones: int = 0\n        self.diff: int = 0\n        self._original_string_ref = original_string_ref\n\n    def calculate_counts(self) -> None:\n        \"\"\"Calculates and stores the counts of '0's, '1's, and their difference.\"\"\"\n        sub_content = self._original_string_ref[self.start : self.end + 1]\n        self.zeros = sub_content.count('0')\n        self.ones = sub_content.count('1')\n        self.diff = self.zeros - self.ones\n\nclass FindLengthService:\n    \"\"\"Service to compute the maximum '0' minus '1' difference in binary substrings.\"\"\"\n    def validate(self, s: str) -> None:\n        \"\"\"Validates the input string for non-emptiness and binary content.\"\"\"\n        if not s:\n            raise ValueError(\"Input string cannot be empty.\")\n        if not all(char in ('0', '1') for char in s):\n            raise ValueError(\"Input string must contain only '0' and '1'.\")\n\n    def enumerateSubstrings(self, s: str) -> List[Substring]:\n        \"\"\"Generates all contiguous non-empty substrings as Substring objects.\"\"\"\n        substrings: List[Substring] = []\n        n = len(s)\n        for i in range(n):\n            for j in range(i, n): # j is inclusive end index\n                substrings.append(Substring(i, j, s))\n        return substrings\n\n    def countZerosOnes(self, sub: Substring) -> None:\n        \"\"\"Calculates '0' and '1' counts and their difference for a single Substring object.\"\"\"\n        sub.calculate_counts()\n\n    def computeMaxDiff(self, substrings: List[Substring]) -> int:\n        \"\"\"Finds the maximum difference value among a list of processed Substring objects.\"\"\"\n        return max(sub.diff for sub in substrings)\n\n    def find_length(self, s: str) -> int:\n        \"\"\"\n        Orchestrates the process to find the maximum difference between\n        0s and 1s in any substring of the given binary string.\n        \"\"\"\n        self.validate(s)\n        substrings = self.enumerateSubstrings(s)\n        for sub in substrings:\n            self.countZerosOnes(sub)\n        return self.computeMaxDiff(substrings)\n\n\ndef find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and number of 1s\n    in any sub-string of the given binary string.\n    \"\"\"\n    service = FindLengthService()\n    return service.find_length(s)"}
{"task_id": "Mbpp/128", "solution": "def _is_string(obj):\n    \"\"\"Checks if an object is a string.\"\"\"\n    return isinstance(obj, str)\n\ndef parse_words(words_input):\n    \"\"\"Normalizes input 'words' (string or list) into a list of tokens.\"\"\"\n    if _is_string(words_input):\n        return words_input.split()\n    elif isinstance(words_input, list):\n        return words_input\n    else:\n        raise TypeError(\"Input 'words' must be a string or a list of strings.\")\n\ndef long_words(n, words):\n    \"\"\"\n    Finds words longer than n characters from a given list or string of words.\n    Preserves order and duplicates.\n    \"\"\"\n    tokens = parse_words(words)\n    result = []\n    for token in tokens:\n        if len(token) > n:\n            result.append(token)\n    return result"}
{"task_id": "Mbpp/130", "solution": "from dataclasses import dataclass\nfrom typing import Any, Dict, Optional\nfrom collections import Counter\n\n@dataclass\nclass Item:\n    \"\"\"Represents an item from the input list.\"\"\"\n    value: Any\n\n@dataclass\nclass Occurrence:\n    \"\"\"Represents an item and its frequency count.\"\"\"\n    item_value: Any\n    count: int\n\n@dataclass\nclass Result:\n    \"\"\"Wrapper for the final returned value.\"\"\"\n    value: Any\n\nclass FrequencyCounter:\n    \"\"\"Counts item frequencies and determines the most frequent item.\"\"\"\n    def __init__(self) -> None:\n        self.counts: Dict[Any, int] = {}\n        self._first_occurrence_order: list[Any] = []\n\n    def count_all(self, items: list) -> None:\n        \"\"\"Populates counts and records the first appearance order of unique items.\"\"\"\n        self.counts = Counter(items)\n        seen_items = set()\n        self._first_occurrence_order = []\n        for item in items:\n            if item not in seen_items:\n                self._first_occurrence_order.append(item)\n                seen_items.add(item)\n\n    def most_frequent(self) -> Optional[Occurrence]:\n        \"\"\"Returns the most frequent item with tie-breaking, or None if no items.\"\"\"\n        if not self.counts:\n            return None\n\n        max_count = 0\n        for count in self.counts.values():\n            if count > max_count:\n                max_count = count\n\n        winning_item = None\n        for item in self._first_occurrence_order:\n            if self.counts.get(item) == max_count:\n                winning_item = item\n                break\n\n        if winning_item is not None:\n            return Occurrence(item_value=winning_item, count=max_count)\n        return None\n\ndef max_occurrences(items: list) -> Any:\n    \"\"\"\n    Finds the item with maximum frequency in a given list.\n    Tie-breaking for equal maximum frequency is \"first-occurrence wins\".\n    \"\"\"\n    fc = FrequencyCounter()\n    fc.count_all(items)\n    occ = fc.most_frequent()\n    \n    # Per prompt instructions: Do NOT add isinstance() checks or raise exceptions for edge cases.\n    # Therefore, if the list is empty and occ is None, return None.\n    if occ is None:\n        return None\n        \n    return occ.item_value"}
