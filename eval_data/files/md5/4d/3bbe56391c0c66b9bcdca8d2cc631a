{"task_id": "Mbpp/463", "solution": "import math\nfrom typing import List\n\ndef max_subarray_product(elements: List[int]) -> int:\n    \"\"\"\n    Finds the maximum product of any contiguous subarray within the given list of integers.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not elements:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    # Initialize variables for tracking current max/min products and overall max product\n    current_max_product = elements[0]\n    current_min_product = elements[0]\n    global_max_product = elements[0]\n\n    for i in range(1, len(elements)):\n        num = elements[i]\n\n        # If the current number is negative, it will flip the roles of current_max and current_min\n        # (e.g., a small negative * current negative might become a large positive)\n        if num < 0:\n            current_max_product, current_min_product = current_min_product, current_max_product\n\n        # Update current max and min products ending at the current position\n        current_max_product = max(num, current_max_product * num)\n        current_min_product = min(num, current_min_product * num)\n\n        # Update the overall maximum product found so far\n        global_max_product = max(global_max_product, current_max_product)\n\n    return global_max_product"}
{"task_id": "Mbpp/462", "solution": "import math\nfrom typing import List, Any\ndef combinations_list(inputList: List[Any]) -> List[List[Any]]:\n    \"\"\"\n    Finds all possible combinations of elements from the input list,\n    ordered by binary counting where the last input element is the most significant bit,\n    and elements within each combination are in reverse input order.\n    \"\"\"\n    n = len(inputList)\n    result: List[List[Any]] = []\n\n    for i in range(1 << n):  # Iterate from 0 to 2^n - 1\n        current_combination: List[Any] = []\n        for j in range(n):  # Check each bit position\n            if (i >> j) & 1:\n                # Append elements in reverse input order based on bit position j\n                current_combination.append(inputList[n - 1 - j])\n        result.append(current_combination)\n\n    return result"}
