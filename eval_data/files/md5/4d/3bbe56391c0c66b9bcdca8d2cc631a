{"task_id": "Mbpp/420", "solution": "def cube_Sum(n):\n    \"\"\"\n    Calculates the cube sum of the first n even natural numbers using a closed-form formula.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    return 2 * n**2 * (n + 1)**2"}
{"task_id": "Mbpp/419", "solution": "import sys\nimport math\nfrom typing import List\n\nclass NumberList:\n    \"\"\"Encapsulates a list of numbers, providing length and rounding operations.\"\"\"\n    def __init__(self, numbers: List[float]):\n        self.numbers = numbers\n        self.length = len(numbers)\n\n    def getLength(self) -> int:\n        \"\"\"Returns the length of the original numbers list.\"\"\"\n        return self.length\n\n    def roundNumbers(self) -> List[int]:\n        \"\"\"Rounds each number to the nearest integer, with .5 rounding up.\"\"\"\n        rounded_values = []\n        for n in self.numbers:\n            # Implement the \".5 rounds up\" rule consistently.\n            rounded_values.append(int(math.floor(n + 0.5)))\n        return rounded_values\n\nclass Result:\n    \"\"\"Stores the final integer product and handles printing it.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def getValue(self) -> int:\n        \"\"\"Returns the stored integer product.\"\"\"\n        return self.value\n\n    def print(self) -> None:\n        \"\"\"Prints the stored integer value to standard output.\"\"\"\n        sys.stdout.write(str(self.value) + '\\n')\n\nclass RoundAndSum:\n    \"\"\"Orchestrates the rounding, summing, and multiplication process.\"\"\"\n    def execute(self, numbers: List[float]) -> int:\n        \"\"\"Performs the sequence of operations: rounds, sums, multiplies, prints, and returns the result.\"\"\"\n        number_list = NumberList(numbers)\n        rounded_values = number_list.roundNumbers()\n        \n        sum_rounded = sum(rounded_values)\n        length = number_list.getLength()\n        \n        product = sum_rounded * length\n        \n        result_obj = Result(product)\n        result_obj.print()\n        \n        return product\n\ndef round_and_sum(numbers: List[float]) -> int:\n    \"\"\"\n    Rounds every number in a list, sums them, multiplies by list length, prints, and returns the total.\n    The rounding rule for .5 is to always round up.\n    \"\"\"\n    orchestrator = RoundAndSum()\n    return orchestrator.execute(numbers)"}
{"task_id": "Mbpp/415", "solution": "from typing import List, Tuple\n\nclass Pair:\n    \"\"\"Represents a pair of integers with methods for product and ordering.\"\"\"\n    def __init__(self, a: int, b: int):\n        self._a = a\n        self._b = b\n\n    def as_tuple(self) -> Tuple[int, int]:\n        return (self._a, self._b)\n\n    def ordered(self) -> Tuple[int, int]:\n        return (min(self._a, self._b), max(self._a, self._b))\n\n    def product(self) -> int:\n        return self._a * self._b\n\nclass IntegerList:\n    \"\"\"Encapsulates a list of integers.\"\"\"\n    def __init__(self, elements: List[int]):\n        self._elements = elements\n\n    def length(self) -> int:\n        return len(self._elements)\n\n    def elements(self) -> List[int]:\n        return list(self._elements)\n\nclass Validation:\n    \"\"\"Provides static methods for input list validation.\"\"\"\n    @staticmethod\n    def validate_min_length(input_list: List[int]):\n        \"\"\"Raises ValueError if the list has fewer than two elements.\"\"\"\n        if len(input_list) < 2:\n            raise ValueError(\"Input list must contain at least two elements.\")\n\n    @staticmethod\n    def validate_element_types(input_list: List[int]):\n        \"\"\"Raises TypeError if any element in the list is not an integer.\"\"\"\n        for element in input_list:\n            if not isinstance(element, int):\n                raise TypeError(\"All elements in the input list must be integers.\")\n\nclass ProductCalculator:\n    \"\"\"Calculates the pair with the highest product from a list of integers.\"\"\"\n    @staticmethod\n    def select_max_pair(input_list: List[int]) -> Pair:\n        \"\"\"Finds the pair with the highest product from distinct indices.\"\"\"\n        max_product_value = -float('inf')\n        max_pair_instance = None\n\n        n = len(input_list)\n        for i in range(n):\n            for j in range(i + 1, n):\n                current_product = input_list[i] * input_list[j]\n                if current_product > max_product_value:\n                    max_product_value = current_product\n                    max_pair_instance = Pair(input_list[i], input_list[j])\n        \n        return max_pair_instance\n\ndef max_Product(input_list: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    Finds a pair with the highest product from a given array of integers.\n    The returned tuple (a, b) will have a <= b.\n    \"\"\"\n    Validation.validate_min_length(input_list)\n    Validation.validate_element_types(input_list)\n    pair = ProductCalculator.select_max_pair(input_list)\n    return pair.ordered()"}
{"task_id": "Mbpp/424", "solution": "def extract_rear(input: tuple) -> list:\n    \"\"\"\n    Extracts the rear (last) index element of each string in the given tuple.\n    Raises TypeError if input is not a tuple or if any element is not a string.\n    \"\"\"\n    if not isinstance(input, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n    \n    result = []\n    for s in input:\n        if not isinstance(s, str):\n            raise TypeError(\"All elements in the tuple must be strings.\")\n        if s: # Ensure string is not empty\n            result.append(s[-1])\n        # As per the example, an empty string element would conceptually have no \"rear index element\".\n        # The provided example and requirements imply non-empty strings will be given.\n        # If an empty string should result in an empty string in the output, a simple 'else result.append('')' would suffice.\n        # For now, following the spirit of \"extract only the rear index element\", an empty string element is skipped or implicitly handled if it doesn't appear.\n    return result"}
{"task_id": "Mbpp/425", "solution": "def count_element_in_list(list_of_sublists, target):\n    \"\"\"Count the number of sublists containing target at least once.\n\n    Args:\n        list_of_sublists: An iterable of iterables.\n        target: The element to find.\n    \"\"\"\n    count = 0\n    for sublist in list_of_sublists:\n        if target in sublist:\n            count += 1\n    return count"}
