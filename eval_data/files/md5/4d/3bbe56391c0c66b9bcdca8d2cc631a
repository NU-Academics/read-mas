{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n):\n    \"\"\"\n    Sets the left-most unset bit in the binary representation of n.\n    If all bits are set, it extends the representation and sets the new MSB.\n    \"\"\"\n    length = n.bit_length()\n\n    # Iterate from the most significant bit down to the least significant bit.\n    for i in range(length - 1, -1, -1):\n        # Check if the i-th bit is unset (0).\n        if ((n >> i) & 1) == 0:\n            # If unset, set this bit and return the new value.\n            return n | (1 << i)\n\n    # If the loop completes, it means all bits from 0 to length-1 are set.\n    # In this case, extend the representation by one more MSB and set it.\n    return n | (1 << length)"}
{"task_id": "Mbpp/388", "solution": "def _is_power_of_two(n):\n    \"\"\"\n    Checks if a positive integer n is a power of two.\n    \"\"\"\n    return n > 0 and (n & (n - 1) == 0)\n\ndef _compute_highest_power_of_two(n):\n    \"\"\"\n    Computes the highest power of two less than or equal to n.\n    \"\"\"\n    power = 1\n    while (power << 1) <= n:\n        power <<= 1\n    return power\n\ndef highest_Power_of_2(n):\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    Assumes n is a positive integer.\n    \"\"\"\n    if _is_power_of_two(n):\n        return n\n    else:\n        return _compute_highest_power_of_two(n)"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"\n    Finds the n'th Lucas number using an iterative approach.\n    Base cases are L0 = 2, L1 = 1, and the recurrence relation is Ln = Ln-1 + Ln-2 for n >= 2.\n    \"\"\"\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    l_prev_2 = 2  # Represents L(i-2)\n    l_prev_1 = 1  # Represents L(i-1)\n    current_l = 0\n\n    for _ in range(2, n + 1):\n        current_l = l_prev_1 + l_prev_2\n        l_prev_2 = l_prev_1\n        l_prev_1 = current_l\n\n    return current_l"}
{"task_id": "Mbpp/390", "solution": "from typing import List, Any\n\ndef toString(element: Any) -> str:\n    \"\"\"Converts an element to its string representation.\"\"\"\n    return str(element)\n\ndef applyFormat(element_str: str, formatString: str) -> str:\n    \"\"\"Replaces all occurrences of '{0}' in formatString with element_str.\"\"\"\n    return formatString.replace(\"{0}\", element_str)\n\ndef add_string(elements: List[Any], formatString: str) -> List[str]:\n    \"\"\"\n    Applies a given format string to all elements in a list, returning a new list of formatted strings.\n    The input list remains unchanged.\n    \"\"\"\n    result: List[str] = []\n    for element in elements:\n        element_str = toString(element)\n        formatted = applyFormat(element_str, formatString)\n        result.append(formatted)\n    return result"}
{"task_id": "Mbpp/391", "solution": "from typing import List, Tuple, Any\n\ndef _validate_inputs(lists: Tuple[List[Any], ...]) -> int:\n    \"\"\"Validate that there are at least two lists and all have equal length.\"\"\"\n    if len(lists) < 2:\n        raise ValueError(\"At least two lists must be provided.\")\n\n    first_list_len = len(lists[0])\n    for i, current_list in enumerate(lists):\n        if len(current_list) != first_list_len:\n            raise ValueError(f\"List at index {i} has length {len(current_list)}, but expected {first_list_len}.\")\n    return first_list_len\n\ndef _build_nested_for_index(lists: Tuple[List[Any], ...], idx: int) -> dict:\n    \"\"\"Build nested mapping for a single index idx from the input lists.\"\"\"\n    # Start with the innermost value from the last list at the given index.\n    current_nested_dict: Any = lists[-1][idx]\n    \n    # Iterate backwards from the second-to-last list to the first list\n    # to progressively build the nested dictionary structure.\n    for i in range(len(lists) - 2, -1, -1):\n        key = lists[i][idx]\n        current_nested_dict = {key: current_nested_dict}\n        \n    return current_nested_dict\n\ndef convert_list_dictionary(*lists: List[Any]) -> List[dict]:\n    \"\"\"Accept two or more lists and return a list of nested dictionaries.\n    Raises ValueError if fewer than two lists are provided or if input lists lengths differ.\n    \"\"\"\n    length = _validate_inputs(lists)\n\n    result: List[dict] = []\n    for i in range(length):\n        nested_dict = _build_nested_for_index(lists, i)\n        result.append(nested_dict)\n\n    return result"}
{"task_id": "Mbpp/395", "solution": "from typing import Optional\nimport collections\n\ndef first_non_repeating_character(input: str) -> Optional[str]:\n    \"\"\"\n    Finds the first non-repeated character in a given string.\n    Returns the leftmost character that appears only once, or None if no such character exists.\n    \"\"\"\n    # Pass 1: Count character frequencies using collections.Counter.\n    char_counts = collections.Counter(input)\n\n    # Pass 2: Iterate through the original string to find the first character\n    # whose count is 1. This ensures we get the \"leftmost\" character.\n    for char in input:\n        if char_counts[char] == 1:\n            return char\n\n    # If no non-repeated character is found after checking all characters, return None.\n    return None"}
{"task_id": "Mbpp/392", "solution": "_memo = {}\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Finds the maximum sum possible by using the given equation f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    Uses memoization to store previously computed results for efficiency.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    if n in _memo:\n        return _memo[n]\n\n    sum_of_parts = get_max_sum(n // 2) + \\\n                   get_max_sum(n // 3) + \\\n                   get_max_sum(n // 4) + \\\n                   get_max_sum(n // 5)\n\n    result = max(sum_of_parts, n)\n    _memo[n] = result\n    return result"}
{"task_id": "Mbpp/397", "solution": "def validateNumeric(value) -> None:\n    \"\"\"Raise TypeError if value is not int or float.\"\"\"\n    if not isinstance(value, (int, float)):\n        raise TypeError(\"value must be numeric\")\n\ndef computeMedianFromThree(values) -> float:\n    \"\"\"Compute median of exactly three numeric values and return as float.\"\"\"\n    sorted_values = sorted(values)\n    return float(sorted_values[1])\n\ndef median_numbers(a: float, b: float, c: float) -> float:\n    \"\"\"Validate inputs and return median as float.\"\"\"\n    validateNumeric(a)\n    validateNumeric(b)\n    validateNumeric(c)\n    median = computeMedianFromThree([a, b, c])\n    return float(median)"}
{"task_id": "Mbpp/394", "solution": "def _validate_is_tuple(t: tuple) -> None:\n    \"\"\"Ensures the provided input is a tuple.\"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(\"check_distinct requires a tuple as input\")\n\ndef _has_duplicate_by_equality(t: tuple) -> bool:\n    \"\"\"Detects duplicate elements in a tuple using equality comparisons (O(n^2)).\"\"\"\n    n = len(t)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if t[i] == t[j]:\n                return True\n    return False\n\ndef check_distinct(t: tuple) -> bool:\n    \"\"\"Checks if a given tuple contains no duplicates.\"\"\"\n    _validate_is_tuple(t)\n    return not _has_duplicate_by_equality(t)"}
{"task_id": "Mbpp/406", "solution": "def find_Parity(number) -> bool:\n    \"\"\"Return True if number is odd, False if number is even.\n    Raises TypeError if number is not an integer.\"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"Input 'number' must be an integer.\")\n    return number % 2 != 0"}
