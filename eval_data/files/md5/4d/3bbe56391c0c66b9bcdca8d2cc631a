{"task_id": "Mbpp/429", "solution": "def _validate_inputs(a, b):\n    \"\"\"\n    Validates input tuples for type, length, and element types.\n    Raises TypeError or ValueError if validation fails.\n    \"\"\"\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n\n    if len(a) != len(b):\n        raise ValueError(\"Input tuples must have equal length.\")\n\n    for i in range(len(a)):\n        if not isinstance(a[i], int) or not isinstance(b[i], int):\n            raise TypeError(\"All elements in both tuples must be integers.\")\n\ndef and_tuples(a, b):\n    \"\"\"\n    Computes the elementwise bitwise AND of two input tuples of integers.\n    Validates inputs and raises TypeError or ValueError on failure.\n    \"\"\"\n    _validate_inputs(a, b)\n\n    results = []\n    for val_a, val_b in zip(a, b):\n        results.append(val_a & val_b)\n\n    return tuple(results)"}
{"task_id": "Mbpp/427", "solution": "class DateString:\n    \"\"\"Parses and holds a date string in 'yyyy-mm-dd' format.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n        parts = value.split('-')\n        self._year = parts[0]\n        self._month = parts[1]\n        self._day = parts[2]\n\n    def is_valid(self) -> bool:\n        \"\"\"Validates the basic format of the stored date string.\"\"\"\n        parts = self._value.split('-')\n        return (len(parts) == 3 and\n                len(parts[0]) == 4 and\n                len(parts[1]) == 2 and\n                len(parts[2]) == 2)\n\n    def get_year(self) -> str:\n        \"\"\"Returns the year component.\"\"\"\n        return self._year\n\n    def get_month(self) -> str:\n        \"\"\"Returns the month component.\"\"\"\n        return self._month\n\n    def get_day(self) -> str:\n        \"\"\"Returns the day component.\"\"\"\n        return self._day\n\n\nclass Formatter:\n    \"\"\"Formats date components into 'dd-mm-yyyy' format.\"\"\"\n    def format_dd_mm_yyyy(self, year: str, month: str, day: str) -> str:\n        \"\"\"Formats given year, month, day into 'dd-mm-yyyy' with zero-padding.\"\"\"\n        day_padded = day.zfill(2)\n        month_padded = month.zfill(2)\n        return f\"{day_padded}-{month_padded}-{year}\"\n\n\ndef change_date_format(date_str):\n    \"\"\"\n    Converts a date string from 'yyyy-mm-dd' format to 'dd-mm-yyyy' format.\n    This function orchestrates parsing and formatting.\n    \"\"\"\n    date_obj = DateString(date_str)\n\n    # In a full implementation, date_obj.is_valid() would be checked here.\n    # For this happy-path implementation, we assume valid input format.\n\n    year = date_obj.get_year()\n    month = date_obj.get_month()\n    day = date_obj.get_day()\n\n    formatter = Formatter()\n    formatted_date = formatter.format_dd_mm_yyyy(year, month, day)\n\n    return formatted_date"}
{"task_id": "Mbpp/428", "solution": "class ShellSortModule:\n    @staticmethod\n    def shell_sort(input_list: list) -> list:\n        \"\"\"Return a new list with elements sorted in non-decreasing order using Shell sort.\n        This implementation makes a copy of the input_list and uses a deterministic gap sequence.\n        \"\"\"\n        arr = list(input_list)\n        n = len(arr)\n\n        if n < 2:\n            return arr\n\n        gaps = ShellSortModule._generate_gaps(n)\n\n        for gap in gaps:\n            # Perform gapped insertion sort for the current gap size\n            for i in range(gap, n):\n                temp = arr[i]\n                j = i\n                # Shift elements up until the correct position for temp is found\n                while j >= gap and ShellSortModule._compare(arr[j - gap], temp) > 0:\n                    arr[j] = arr[j - gap]\n                    j -= gap\n                arr[j] = temp\n        return arr\n\n    @staticmethod\n    def _generate_gaps(n: int) -> list:\n        \"\"\"Return a deterministic gap sequence for length n (int) as a list of ints.\n        This implementation uses a halving sequence: [n // 2, n // 4, ..., 1].\n        \"\"\"\n        gaps = []\n        gap = n // 2\n        while gap > 0:\n            gaps.append(gap)\n            gap //= 2\n        return gaps\n\n    @staticmethod\n    def _compare(a, b) -> int:\n        \"\"\"Return negative if a < b, zero if a == b, positive if a > b.\"\"\"\n        if a < b:\n            return -1\n        elif a == b:\n            return 0\n        else:\n            return 1\n\ndef shell_sort(input_list: list) -> list:\n    \"\"\"Module-level public function that delegates to ShellSortModule.shell_sort.\n    This function sorts the given array using the Shell sort algorithm.\n    \"\"\"\n    return ShellSortModule.shell_sort(input_list)"}
{"task_id": "Mbpp/432", "solution": "from typing import List\n\nclass InputParameters:\n    \"\"\"\n    Validates provided list for count and numeric type constraints.\n    Returns True on success; raises ValueError or TypeError on failure.\n    \"\"\"\n    def __init__(self, values: list):\n        self.values = values\n\n    def validate(self) -> bool:\n        \"\"\"\n        Returns True if inputs are valid, raises ValueError or TypeError otherwise.\n        \"\"\"\n        if len(self.values) != 3:\n            raise ValueError(\"median_trapezium requires exactly three arguments\")\n\n        for value in self.values:\n            if not isinstance(value, (int, float)) or isinstance(value, bool):\n                raise TypeError(\"all inputs must be numeric\")\n        return True\n\nclass Trapezium:\n    \"\"\"Holds the three side lengths (a, b, c) as typed numeric fields.\"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        self.a = float(a)\n        self.b = float(b)\n        self.c = float(c)\n\nclass MedianResult:\n    \"\"\"Encapsulates the computed median value.\"\"\"\n    def __init__(self, value: float):\n        self.value = float(value)\n\nclass MedianCalculator:\n    \"\"\"Computes the median of a trapezium as (a + b) / 2.\"\"\"\n    def median_trapezium(self, a: float, b: float, c: float) -> float:\n        \"\"\"Return (a + b) / 2. The parameter c is accepted but unused.\"\"\"\n        return (a + b) / 2.0\n\ndef median_trapezium(a, b, c):\n    \"\"\"Validate inputs and return median computed as (a + b) / 2.\"\"\"\n    validator = InputParameters(values=[a, b, c])\n    validator.validate()\n\n    # Create Trapezium object (as per design, even if not directly used by calculator input)\n    # trapezium_data = Trapezium(a, b, c) # Instantiation is part of design flow\n\n    calculator = MedianCalculator()\n    median_value = calculator.median_trapezium(a, b, c)\n\n    result_obj = MedianResult(median_value)\n    return result_obj.value"}
{"task_id": "Mbpp/430", "solution": "class ParabolaError(Exception):\n    \"\"\"Exception raised for errors in parabola calculations.\"\"\"\n    pass\n\ndef validate_a(a) -> bool:\n    \"\"\"Validates that coefficient 'a' is non-zero.\"\"\"\n    return a != 0\n\nclass Directrix:\n    \"\"\"Represents the directrix of a parabola.\"\"\"\n    def __init__(self, y: float):\n        self.y = y\n\nclass Parabola:\n    \"\"\"Represents a parabola with coefficients a, b, c.\"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        self.a = a\n        self.b = b\n        self.c = c\n\n    def getDirectrix(self) -> float:\n        \"\"\"Computes the y-coordinate of the directrix.\"\"\"\n        numerator = self.b**2 + 1\n        denominator = 4 * self.a\n        y = self.c - numerator / denominator\n        return y\n\ndef parabola_directrix(a, b, c) -> float:\n    \"\"\"Computes the y-coordinate of the directrix for a parabola y = ax^2 + bx + c.\"\"\"\n    if not validate_a(a):\n        raise ParabolaError(\"Coefficient 'a' must be non-zero.\")\n\n    p = Parabola(float(a), float(b), float(c))\n    return p.getDirectrix()"}
{"task_id": "Mbpp/433", "solution": "def check_greater(array, number):\n    \"\"\"\n    Checks if the entered number is strictly greater than all elements in the given array.\n    Returns True for an empty array, or if all array elements are less than the number.\n    \"\"\"\n    for element in array:\n        if element >= number:\n            return False\n    return True"}
{"task_id": "Mbpp/435", "solution": "def last_Digit(number):\n    \"\"\"Return the last decimal digit (0-9) of 'number'.\"\"\"\n    return abs(number) % 10"}
{"task_id": "Mbpp/436", "solution": "import typing\n\ndef _validate_input(input_list: typing.List[typing.Any]) -> None:\n    \"\"\"Validates if the input is a list. Raises TypeError if not.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input must be a list\")\n\ndef _validate_elements(input_list: typing.List[typing.Any]) -> None:\n    \"\"\"Validates if all elements in the list are numeric (int or float). Raises TypeError if any are not.\"\"\"\n    for elem in input_list:\n        if not isinstance(elem, (int, float)):\n            raise TypeError(\"all elements must be numeric (int or float)\")\n\ndef _filter_negatives(input_list: typing.List[typing.Union[int, float]]) -> typing.List[typing.Union[int, float]]:\n    \"\"\"Filters a list to return only negative numbers, preserving their original order.\"\"\"\n    negative_numbers = []\n    for num in input_list:\n        if num < 0:\n            negative_numbers.append(num)\n    return negative_numbers\n\ndef neg_nos(input_list: typing.List[typing.Any]) -> typing.List[typing.Union[int, float]]:\n    \"\"\"\n    Returns a new list containing only the negative numbers from the input list, preserving order.\n    Validates input type and element types, raising TypeError on failure.\n    \"\"\"\n    _validate_input(input_list)\n    _validate_elements(input_list)\n    return _filter_negatives(input_list)"}
{"task_id": "Mbpp/437", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    value: str\n\n@dataclass\nclass OutputString:\n    value: str\n\n@dataclass\nclass Character:\n    value: str\n    index: int\n\nclass Index:\n    def __init__(self, position: int):\n        self.position = position\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the index position is odd (1, 3, 5, ...).\"\"\"\n        return self.position % 2 == 1\n\ndef remove_odd(input: str) -> str:\n    \"\"\"\n    Returns a string containing only the characters from the input string\n    at odd zero-based indices, preserving their original order.\n    \"\"\"\n    input_obj = InputString(value=input)\n    selected_chars = []\n    for i, char_value in enumerate(input_obj.value):\n        character_obj = Character(value=char_value, index=i)\n        index_obj = Index(position=character_obj.index)\n        if index_obj.is_odd():\n            selected_chars.append(character_obj.value)\n\n    output_obj = OutputString(value=\"\".join(selected_chars))\n    return output_obj.value"}
{"task_id": "Mbpp/439", "solution": "class Validator:\n    \"\"\"Validates the input list and its elements.\"\"\"\n    @staticmethod\n    def validate(input_list: list[int]):\n        \"\"\"Ensures the input is a list of integers, raising TypeError otherwise.\"\"\"\n        if not isinstance(input_list, list):\n            raise TypeError(\"Input must be a list.\")\n        for element in input_list:\n            if not isinstance(element, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n\nclass Concatenator:\n    \"\"\"Concatenates integer elements into a single string.\"\"\"\n    @staticmethod\n    def concat(values: list[int]) -> str:\n        \"\"\"Converts each integer to a string and joins them.\"\"\"\n        return \"\".join(str(x) for x in values)\n\nclass IntegerConverter:\n    \"\"\"Converts a digit string into an integer.\"\"\"\n    @staticmethod\n    def toInteger(digit_string: str) -> int:\n        \"\"\"Converts a digit string to an integer, handling empty string as 0.\"\"\"\n        if not digit_string:\n            return 0\n        return int(digit_string)\n\ndef multiple_to_single(input_list: list[int]) -> int:\n    \"\"\"\n    Joins a list of multiple integers into a single integer.\n    Orchestrates validation, string concatenation, and final integer conversion.\n    \"\"\"\n    Validator.validate(input_list)\n    concatenated_string = Concatenator.concat(input_list)\n    result_integer = IntegerConverter.toInteger(concatenated_string)\n    return result_integer"}
{"task_id": "Mbpp/441", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass Cube:\n    size: float\n    surface_area: float = None\n\n    def compute_surface_area(self) -> float:\n        \"\"\"Compute surface area using formula 6 * size * size, store and return it.\"\"\"\n        self.surface_area = 6 * self.size * self.size\n        return self.surface_area\n\n@dataclass\nclass Result:\n    value: float\n\ndef surfacearea_cube(size):\n    \"\"\"Accept one numeric parameter size and return surface area computed as 6 * size * size.\"\"\"\n    cube_instance = Cube(size=float(size))\n    computed_surface_area = cube_instance.compute_surface_area()\n    result_instance = Result(value=computed_surface_area)\n    return result_instance.value"}
{"task_id": "Mbpp/440", "solution": "from dataclasses import dataclass\n\nclass Sentence:\n    \"\"\"Encapsulates the input string and provides minimal helpers.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        return len(self.text)\n\n    def get_text(self) -> str:\n        return self.text\n\nclass Token:\n    \"\"\"Represents a contiguous alphabetic token with original-string indices.\"\"\"\n    def __init__(self, text: str, start: int, end: int):\n        self.text = text\n        self.start = start\n        self.end = end\n\n    def normalized(self) -> str:\n        return self.text.lower()\n\n    def is_alpha(self) -> bool:\n        return self.text.isalpha()\n\nclass Tokenizer:\n    \"\"\"Scans Sentence.text and produces Token objects.\"\"\"\n    def tokenize(self, sentence: 'Sentence') -> list['Token']:\n        tokens = []\n        text = sentence.get_text()\n        n = sentence.length()\n        i = 0\n        while i < n:\n            if text[i].isalpha():\n                start = i\n                while i < n and text[i].isalpha():\n                    i += 1\n                end = i\n                tokens.append(Token(text[start:end], start, end))\n            else:\n                i += 1\n        return tokens\n\n@dataclass\nclass AdverbMatch:\n    \"\"\"Immutable value object carrying start_index, end_index, adverb.\"\"\"\n    start_index: int\n    end_index: int\n    adverb: str\n\nclass AdverbFinder:\n    \"\"\"Inspects tokens left-to-right to find the first adverb.\"\"\"\n    def find_first_adverb(self, tokens: list['Token']) -> 'AdverbMatch' | None:\n        for token in tokens:\n            if token.is_alpha() and token.normalized().endswith('ly'):\n                return AdverbMatch(token.start, token.end, token.normalized())\n        return None\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Returns (start_index, end_index, adverb) or None if no adverb is found.\n    \"\"\"\n    s = Sentence(sentence)\n    tokenizer = Tokenizer()\n    tokens = tokenizer.tokenize(s)\n    finder = AdverbFinder()\n    match = finder.find_first_adverb(tokens)\n    if match is None:\n        return None\n    return (match.start_index, match.end_index, match.adverb)"}
{"task_id": "Mbpp/445", "solution": "class IndexMultiplication:\n    \"\"\"Helper class to encapsulate validation and pairwise multiplication logic.\"\"\"\n\n    def validate_top_level_length(self, a: tuple, b: tuple) -> None:\n        \"\"\"Raise ValueError if len(a) != len(b).\"\"\"\n        if len(a) != len(b):\n            raise ValueError(\"top-level tuple length mismatch\")\n\n    def validate_inner_lengths(self, a_inner: tuple, b_inner: tuple) -> None:\n        \"\"\"Raise ValueError if len(a_inner) != len(b_inner).\"\"\"\n        if len(a_inner) != len(b_inner):\n            raise ValueError(\"inner tuple length mismatch\")\n\n    def multiply_pair(self, a_inner: tuple, b_inner: tuple) -> tuple:\n        \"\"\"Return a new tuple containing element-wise numeric products of a_inner and b_inner.\"\"\"\n        return tuple(a_inner[j] * b_inner[j] for j in range(len(a_inner)))\n\ndef index_multiplication(a: tuple, b: tuple) -> tuple:\n    \"\"\"Public API implementing validations and returning a newly constructed tuple of tuples.\n    Raises ValueError on top-level or inner-tuple length mismatch; does not mutate input tuples.\n    \"\"\"\n    helper = IndexMultiplication()\n    helper.validate_top_level_length(a, b)\n\n    results = []\n    for i in range(len(a)):\n        helper.validate_inner_lengths(a[i], b[i])\n        results.append(helper.multiply_pair(a[i], b[i]))\n\n    return tuple(results)"}
{"task_id": "Mbpp/446", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass OccurrenceResult:\n    value: int\n\nclass Counter:\n    @staticmethod\n    def count_matches(input_tuple, input_list):\n        \"\"\"\n        Counts occurrences of elements from input_list within input_tuple.\n        Returns 0 if either input is empty.\n        \"\"\"\n        count = 0\n        if not input_list or not input_tuple:\n            return 0\n        for item_tuple in input_tuple:\n            for item_list in input_list:\n                if item_tuple == item_list:\n                    count += 1\n        result_obj = OccurrenceResult(value=count)\n        return result_obj.value\n\nclass TypeValidator:\n    @staticmethod\n    def validate(input_tuple, input_list):\n        \"\"\"\n        Validates that the first argument is a tuple and the second is a list.\n        Raises TypeError if validation fails.\n        \"\"\"\n        if not isinstance(input_tuple, tuple):\n            raise TypeError(\"first argument must be a tuple\")\n        if not isinstance(input_list, list):\n            raise TypeError(\"second argument must be a list\")\n\ndef count_Occurrence(input_tuple, input_list):\n    \"\"\"\n    Counts occurrences of all elements of list in a tuple after type validation.\n    Returns an integer count or raises TypeError for invalid inputs.\n    \"\"\"\n    TypeValidator.validate(input_tuple, input_list)\n    return Counter.count_matches(input_tuple, input_list)"}
{"task_id": "Mbpp/447", "solution": "def is_numeric(value):\n    \"\"\"Return True if value is an instance of int or float, but not bool.\"\"\"\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\n\ndef validate(input_list):\n    \"\"\"Raises TypeError if input_list is not a list or contains non-numeric elements.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n    for element in input_list:\n        if not is_numeric(element):\n            raise TypeError(\"All elements in the list must be numeric.\")\n\ndef compute_cubes(input_list):\n    \"\"\"Return a new list where each element is the cube of the corresponding input element.\"\"\"\n    return [x ** 3 for x in input_list]\n\ndef cube_nums(numbers):\n    \"\"\"Validate input list and return a new list with each element cubed.\n    Raises TypeError for non-list input or non-numeric elements.\n    \"\"\"\n    validate(numbers)\n    return compute_cubes(numbers)"}
{"task_id": "Mbpp/450", "solution": "def extract_string(input_list: list[str], size: int) -> list[str]:\n    \"\"\"\n    Extracts strings of a specified length from a list of strings.\n    Returns a new list containing only the matching strings, preserving their original order.\n    \"\"\"\n    return [s for s in input_list if len(s) == size]"}
{"task_id": "Mbpp/451", "solution": "_WHITESPACE_CHARS = {' ', '\\t', '\\n', '\\r'}\n\ndef _is_whitespace_char(char: str) -> bool:\n    \"\"\"Checks if a character is one of the required whitespace characters.\"\"\"\n    return char in _WHITESPACE_CHARS\n\ndef remove_whitespaces(input_str: str) -> str:\n    \"\"\"Removes all specified whitespace characters from the given string.\"\"\"\n    result_chars = []\n    for char in input_str:\n        if not _is_whitespace_char(char):\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/448", "solution": "class CalculationRequest:\n    \"\"\"Holds the input value for calculation.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\nclass Validator:\n    \"\"\"Provides utility for input validation.\"\"\"\n    @staticmethod\n    def isNonNegativeInteger(n) -> bool:\n        \"\"\"Checks if n is a non-negative integer.\"\"\"\n        return isinstance(n, int) and n >= 0\n\nclass PerrinSequence:\n    \"\"\"Encapsulates Perrin number sequence logic and calculation.\"\"\"\n    P0 = 3\n    P1 = 0\n    P2 = 2\n\n    def __init__(self):\n        # Cache for already computed Perrin terms\n        self._perrin_terms = {0: self.P0, 1: self.P1, 2: self.P2}\n\n    def calcTerm(self, n: int) -> int:\n        \"\"\"Calculates the n-th Perrin number, utilizing memoization.\"\"\"\n        if n in self._perrin_terms:\n            return self._perrin_terms[n]\n\n        if n < 0:\n            raise ValueError(\"Perrin number index cannot be negative.\")\n\n        # Iteratively compute terms up to n and store in cache\n        for i in range(3, n + 1):\n            if i not in self._perrin_terms:\n                self._perrin_terms[i] = self._perrin_terms[i-2] + self._perrin_terms[i-3]\n        \n        return self._perrin_terms[n]\n\n    def calcSum(self, n: int) -> int:\n        \"\"\"Computes the sum of Perrin numbers from P(0) to P(n).\"\"\"\n        if n < 0:\n            raise ValueError(\"n must be a non-negative integer for sum calculation.\")\n\n        total_sum = 0\n        for i in range(n + 1):\n            total_sum += self.calcTerm(i)\n        return total_sum\n\ndef cal_sum(n):\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) to P(n) inclusive.\n    Perrin numbers are P(0)=3, P(1)=0, P(2)=2, and P(n)=P(n-2)+P(n-3) for n>=3.\n    \"\"\"\n    request = CalculationRequest(n)\n    if not Validator.isNonNegativeInteger(request.n):\n        raise ValueError(\"n must be a non-negative integer\")\n    \n    seq = PerrinSequence()\n    result_sum = seq.calcSum(request.n)\n    return result_sum"}
{"task_id": "Mbpp/453", "solution": "from typing import List\n\nclass Number:\n    \"\"\"\n    Represents an integer value and provides methods to check its positivity\n    and enumerate its positive divisors.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def isPositive(self) -> bool:\n        \"\"\"\n        Checks if the number is positive.\n        \"\"\"\n        return self.value > 0\n\n    def getDivisors(self) -> List[int]:\n        \"\"\"\n        Returns a list of all positive divisors of the number.\n        \"\"\"\n        divisors = []\n        if self.isPositive():\n            for i in range(1, self.value + 1):\n                if self.value % i == 0:\n                    divisors.append(i)\n        return divisors\n\nclass Factor:\n    \"\"\"\n    Represents a factor (divisor) of a number and provides a method\n    to check its parity (evenness).\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def isEven(self) -> bool:\n        \"\"\"\n        Checks if the factor is an even number.\n        \"\"\"\n        return self.value % 2 == 0\n\nclass SumCalculator:\n    \"\"\"\n    Calculates the sum of even factors for a given number by computing divisors,\n    filtering for even ones, and summing them.\n    \"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def sumofFactors(self, n: int) -> int:\n        \"\"\"\n        Computes the sum of even positive factors of the input number n.\n        \"\"\"\n        divisors = self.computeDivisors(n)\n        even_sum = self.sumEven(divisors)\n        return even_sum\n\n    def computeDivisors(self, n: int) -> List[int]:\n        \"\"\"\n        Returns a list of all positive divisors of n using the Number class.\n        \"\"\"\n        number_obj = Number(n)\n        return number_obj.getDivisors()\n\n    def sumEven(self, divisors: List[int]) -> int:\n        \"\"\"\n        Filters the given list of divisors for even numbers and returns their sum.\n        \"\"\"\n        even_sum = 0\n        for d in divisors:\n            factor_obj = Factor(d)\n            if factor_obj.isEven():\n                even_sum += d\n        return even_sum\n\ndef sumofFactors(n: int) -> int:\n    \"\"\"\n    Calculates the sum of even positive factors of a number.\n    This is the public API function that instantiates and delegates to SumCalculator.\n    \"\"\"\n    calculator = SumCalculator()\n    return calculator.sumofFactors(n)"}
{"task_id": "Mbpp/454", "solution": "import re\nfrom typing import List, Set, Optional\n\nclass Word:\n    \"\"\"Represents a whole-word token.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def containsZ(self) -> bool:\n        \"\"\"Returns True if the token's value includes the character 'z'.\"\"\"\n        return 'z' in self.value\n\nclass TextInput:\n    \"\"\"Helper class for normalizing and tokenizing raw text.\"\"\"\n    def __init__(self, rawText: str) -> None:\n        self.rawText = rawText\n\n    def normalize(self) -> str:\n        \"\"\"Trims surrounding whitespace from the raw text.\"\"\"\n        return self.rawText.strip()\n\n    def tokenize(self, punctuation_set: Set[str]) -> List[Word]:\n        \"\"\"Splits normalized text into Word tokens using whitespace and punctuation as delimiters.\"\"\"\n        normalized_text = self.normalize()\n        \n        # Build regex pattern for splitting. Punctuation characters are escaped.\n        punctuation_pattern = \"\".join(re.escape(p) for p in punctuation_set)\n        delimiter_pattern = r\"[\\s\" + punctuation_pattern + r\"]+\"\n        \n        parts = re.split(delimiter_pattern, normalized_text)\n        \n        # Filter out any empty strings that may result from splitting.\n        word_strings = [part for part in parts if part]\n        \n        return [Word(value) for value in word_strings]\n\nclass TextMatcher:\n    \"\"\"A service that tokenizes text and analyzes words for the presence of 'z'.\"\"\"\n    def __init__(self, punctuation_set: Optional[Set[str]] = None) -> None:\n        self.punctuation_set: Set[str] = punctuation_set if punctuation_set is not None else {'.', ',', '!', '?'}\n\n    def tokenize(self, text: str) -> List[Word]:\n        \"\"\"Splits the input text into a list of Word objects.\"\"\"\n        text_input = TextInput(text)\n        return text_input.tokenize(self.punctuation_set)\n\n    def analyzeWord(self, word: Word) -> bool:\n        \"\"\"Checks if a given Word object contains the character 'z'.\"\"\"\n        return word.containsZ()\n\n    def text_match_wordz(self, text: str) -> bool:\n        \"\"\"Returns True if any whole-word token in the text contains 'z', otherwise False.\"\"\"\n        words = self.tokenize(text)\n        for word in words:\n            if self.analyzeWord(word):\n                return True\n        return False\n\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"Matches a word containing 'z' within the input text.\"\"\"\n    matcher = TextMatcher()\n    return matcher.text_match_wordz(text)"}
{"task_id": "Mbpp/455", "solution": "from typing import Final, FrozenSet\n\n_THIRTYONE_MONTHS: Final[FrozenSet[int]] = frozenset({1, 3, 5, 7, 8, 10, 12})\n\nclass InputValidator:\n    \"\"\"Validates month input to ensure it's an integer within the valid range.\"\"\"\n    def validate_month_input(self, month) -> None:\n        \"\"\"Raises ValueError if month is not an int or not in 1..12.\"\"\"\n        if not isinstance(month, int) or not (1 <= month <= 12):\n            raise ValueError(\"month must be an integer in the inclusive range 1..12\")\n\ndef check_monthnumb_number(month) -> bool:\n    \"\"\"Checks whether the given month number has 31 days.\"\"\"\n    InputValidator().validate_month_input(month)\n    return month in _THIRTYONE_MONTHS"}
{"task_id": "Mbpp/457", "solution": "def Find_Min(input_list):\n    \"\"\"\n    Finds the sublist with the minimum length from a list of sublists.\n    Returns the first such sublist encountered if there are ties in minimum length.\n    \"\"\"\n    if not input_list:\n        return None # As per SRS, empty input behavior is unspecified; returning None is a reasonable default.\n\n    min_sublist = input_list[0]\n    min_length = len(input_list[0])\n\n    for sublist in input_list[1:]:\n        current_length = len(sublist)\n        if current_length < min_length:\n            min_length = current_length\n            min_sublist = sublist\n            \n    return min_sublist"}
