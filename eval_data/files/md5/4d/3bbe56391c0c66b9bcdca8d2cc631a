{"task_id": "Mbpp/743", "solution": "class ListInput:\n    \"\"\"Represents an input list.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n    \n    def length(self) -> int:\n        \"\"\"Returns the length of the list.\"\"\"\n        return len(self.elements)\n\nclass RotationResult:\n    \"\"\"Container for the rotated list.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n    \n    def length(self) -> int:\n        \"\"\"Returns the length of the rotated list.\"\"\"\n        return len(self.elements)\n\nclass Validator:\n    \"\"\"Validates inputs and normalizes rotation count.\"\"\"\n    def validate_list(self, lst) -> bool:\n        \"\"\"Checks if the input is a list.\"\"\"\n        return isinstance(lst, list)\n\n    def validate_k(self, k) -> bool:\n        \"\"\"Checks if k is an integer.\"\"\"\n        return isinstance(k, int)\n\n    def normalize_k(self, k: int, n: int) -> int:\n        \"\"\"Normalizes k relative to list length n.\"\"\"\n        if n == 0:\n            return 0\n        return k % n\n\nclass RotateOperation:\n    \"\"\"Performs the list rotation algorithm.\"\"\"\n    def __init__(self, k: int = 0):\n        # k in __init__ is not explicitly used if execute takes k directly, per design\n        pass\n\n    def execute(self, lst: list, k: int) -> list:\n        \"\"\"Rotates the list to the right by k positions.\"\"\"\n        n = len(lst)\n        # k is expected to be normalized (0 <= k < n) by the caller\n        return lst[n - k:] + lst[:n - k]\n\ndef rotate_right(lst, k):\n    \"\"\"\n    Rotates a given list by specified number of items to the right direction.\n    \"\"\"\n    validator = Validator()\n\n    # Input validation\n    if not validator.validate_list(lst):\n        raise TypeError(\"lst must be a list\")\n    if not validator.validate_k(k):\n        raise TypeError(\"k must be an integer\")\n    if k < 0:\n        raise ValueError(\"k cannot be negative\")\n\n    # Construct ListInput (as per design, even if its length method isn't directly used here)\n    list_input = ListInput(lst) \n\n    # Handle empty list\n    if not list_input.elements:\n        return []\n\n    # Get list length\n    n = list_input.length()\n\n    # Normalize k\n    k_mod = validator.normalize_k(k, n)\n\n    # If normalized k is 0, no rotation is needed\n    if k_mod == 0:\n        return lst\n\n    # Perform rotation\n    rotate_op = RotateOperation()\n    rotated_elements = rotate_op.execute(list_input.elements, k_mod)\n\n    # Wrap in RotationResult and extract elements as per design\n    rotation_result = RotationResult(rotated_elements)\n    return rotation_result.elements"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(s: str) -> str:\n    \"\"\"\n    Inserts spaces between words in a string where a new word starts with an uppercase letter,\n    following specific rules for the preceding character.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    result_chars = []\n    for i, char in enumerate(s):\n        # Insert a space if it's not the first character, the current character is uppercase,\n        # and the previous character is a lowercase letter or a digit.\n        if i > 0 and char.isupper():\n            prev_char = s[i-1]\n            if prev_char.islower() or prev_char.isdigit():\n                result_chars.append(' ')\n        result_chars.append(char)\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/745", "solution": "from typing import List\n\nclass Error(Exception):\n    \"\"\"Domain exception type for reporting specific error conditions.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass NumberRange:\n    \"\"\"Value object for encapsulating the start and end of a number range.\"\"\"\n    def __init__(self, startnum: int, endnum: int):\n        self.startnum = startnum\n        self.endnum = endnum\n\nclass Number:\n    \"\"\"Encapsulates an integer and provides methods to extract its digits.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def digits(self) -> List[int]:\n        \"\"\"Returns a list of integers representing the individual digits of the number.\"\"\"\n        return [int(d) for d in str(self.value)]\n\nclass Digit:\n    \"\"\"Represents a single decimal digit.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass ResultList:\n    \"\"\"Collects unique numbers and provides sorted access to them.\"\"\"\n    def __init__(self):\n        self._numbers = set()\n        self._sorted_numbers = []\n\n    def append(self, n: int) -> None:\n        \"\"\"Adds a number to the collection, ensuring uniqueness.\"\"\"\n        self._numbers.add(n)\n\n    def sort(self) -> None:\n        \"\"\"Sorts the collected numbers in ascending order.\"\"\"\n        self._sorted_numbers = sorted(list(self._numbers))\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns the sorted list of unique numbers.\"\"\"\n        return self._sorted_numbers\n\nclass InputValidator:\n    \"\"\"Validates the input parameters for the number range.\"\"\"\n    def validate(self, startnum: int, endnum: int) -> None:\n        \"\"\"Raises an Error if startnum is greater than endnum.\"\"\"\n        if startnum > endnum:\n            raise Error(\"startnum must be <= endnum\")\n\nclass DivisibleByDigitsService:\n    \"\"\"\n    Core service to find numbers within a range that are divisible by all their non-zero digits.\n    It orchestrates validation, iteration, and divisibility checks.\n    \"\"\"\n    def divisible_by_digits(self, startnum: int, endnum: int) -> List[int]:\n        \"\"\"\n        Executes the logic to find numbers divisible by their digits within the specified range.\n        It uses validator for input checks and collects results.\n        \"\"\"\n        validator = InputValidator()\n        validator.validate(startnum, endnum)\n\n        # Instantiate NumberRange as per design, even if direct parameters are used.\n        number_range = NumberRange(startnum, endnum) \n\n        result_list = ResultList()\n\n        for n in range(number_range.startnum, number_range.endnum + 1):\n            num_obj = Number(n)\n            digits = num_obj.digits()\n\n            # FR-004: Exclude numbers containing digit 0.\n            if 0 in digits:\n                continue\n\n            # FR-002: Check if n is divisible by every non-zero digit it contains.\n            is_divisible_by_all_digits = True\n            for digit_val in digits:\n                if n % digit_val != 0:\n                    is_divisible_by_all_digits = False\n                    break\n            \n            if is_divisible_by_all_digits:\n                result_list.append(n)\n        \n        # FR-005: Sort the resulting list in ascending order.\n        result_list.sort()\n        return result_list.to_list()\n\ndef divisible_by_digits(startnum: int, endnum: int) -> List[int]:\n    \"\"\"\n    Finds numbers within a given range (startnum to endnum inclusive) where every number\n    is divisible by every non-zero digit it contains.\n    \"\"\"\n    return DivisibleByDigitsService().divisible_by_digits(startnum, endnum)"}
{"task_id": "Mbpp/749", "solution": "from typing import List\n\nclass ParseError(Exception):\n    \"\"\"Custom exception for parsing failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass NumericString:\n    \"\"\"Encapsulates a string that represents a numeric value and converts it to an integer.\"\"\"\n    value: str\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def toInteger(self) -> int:\n        \"\"\"Converts the encapsulated string to an integer, raising ParseError on failure.\"\"\"\n        try:\n            return int(self.value)\n        except ValueError as e:\n            raise ParseError(f\"Cannot parse '{self.value}' into an integer.\") from e\n\nclass SortNumericStrings:\n    \"\"\"Coordinates the parsing and sorting of a list of numeric strings.\"\"\"\n    input: List[str]\n    output: List[int]\n    _parsed_integers: List[int]\n\n    def __init__(self, input_list: List[str]) -> None:\n        self.input = input_list\n        self.output = []\n        self._parsed_integers = []\n\n    def parseAll(self) -> None:\n        \"\"\"Parses all input strings into integers, collecting them into an internal list.\"\"\"\n        for s in self.input:\n            numeric_str = NumericString(s)\n            self._parsed_integers.append(numeric_str.toInteger())\n\n    def sortAll(self) -> None:\n        \"\"\"Sorts the internally stored integers in ascending order.\"\"\"\n        self.output = sorted(self._parsed_integers)\n\n    def execute(self) -> List[int]:\n        \"\"\"Executes the parsing and sorting steps and returns the sorted list of integers.\"\"\"\n        self.parseAll()\n        self.sortAll()\n        return self.output\n\ndef sort_numeric_strings(input_list: List[str]) -> List[int]:\n    \"\"\"Public API per SRS: accepts list of strings and returns list of ints sorted ascending.\"\"\"\n    op = SortNumericStrings(input_list)\n    return op.execute()"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(array) -> bool:\n    \"\"\"\n    Check whether the provided sequence 'array' (0-based indexing) satisfies the min-heap property.\n\n    Precondition: 'array' is a sequence of comparable elements (supports <=).\n    Postcondition: Returns True iff for every parent index i with child indices left=2*i+1 and right=2*i+2 (when those indices exist),\n    array[i] <= array[child]. Short-circuits and returns False on first violation.\n    Complexity: O(n) time, O(1) additional space.\n    \"\"\"\n    n = len(array)\n\n    # An array with 0 or 1 element is always a min-heap\n    if n <= 1:\n        return True\n\n    # Iterate only through parent nodes. The last parent node is at index (n-2)//2.\n    for i in range((n - 2) // 2 + 1):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child: if it exists and violates the min-heap property\n        if left_child_idx < n and array[i] > array[left_child_idx]:\n            return False\n\n        # Check right child: if it exists and violates the min-heap property\n        if right_child_idx < n and array[i] > array[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/750", "solution": "def add_tuple(input_list: list, input_tuple: tuple) -> list:\n    \"\"\"Accepts a list and a tuple and returns a list whose elements are the input_list's\n    elements followed by input_tuple's elements, preserving order.\"\"\"\n    return input_list + list(input_tuple)"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n):\n    \"\"\"\n    Calculates the nth Jacobsthal number using an iterative approach.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    a, b = 0, 1  # J(i-2), J(i-1)\n    for _ in range(2, n + 1):\n        a, b = b, b + 2 * a  # J(i-1), J(i-1) + 2*J(i-2)\n    return b"}
{"task_id": "Mbpp/753", "solution": "def min_k(list_of_tuples, k):\n    \"\"\"Finds the minimum k records from a list of (label, value) tuples.\n    Returns the selected tuples ordered ascending by numeric value, stable for ties.\n    \"\"\"\n    n = len(list_of_tuples)\n\n    if k <= 0:\n        return []\n\n    # Prepare records for stable sorting, attaching original index for tie-breaking.\n    # This simulates the TupleRecord from the design for stable sorting.\n    indexed_records = []\n    for i, (label, value) in enumerate(list_of_tuples):\n        indexed_records.append((value, i, (label, value)))\n\n    # Sort primarily by value, secondarily by original index for stability.\n    indexed_records.sort()\n\n    if k >= n:\n        # If k is greater than or equal to the total number of records, return all sorted records.\n        result = [record[2] for record in indexed_records]\n    else:\n        # Otherwise, return the first k elements from the sorted list.\n        result = [record[2] for record in indexed_records[:k]]\n\n    return result"}
{"task_id": "Mbpp/754", "solution": "def validate_inputs(l1, l2, l3):\n    \"\"\"Ensures inputs are sequence-like by attempting to get their length.\"\"\"\n    try:\n        len(l1)\n        len(l2)\n        len(l3)\n    except TypeError as e:\n        raise TypeError(\"All inputs must be sequence-like (support len()).\") from e\n\ndef compute_min_length(l1, l2, l3):\n    \"\"\"Computes the minimum length among the three input lists.\"\"\"\n    return min(len(l1), len(l2), len(l3))\n\ndef extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements common to all three lists at the same index.\n    The function returns a list of these common elements.\n    \"\"\"\n    validate_inputs(l1, l2, l3)\n    min_len = compute_min_length(l1, l2, l3)\n    \n    common_elements = []\n    for i in range(min_len):\n        if l1[i] == l2[i] == l3[i]:\n            common_elements.append(l1[i])\n            \n    return common_elements"}
{"task_id": "Mbpp/755", "solution": "from typing import List, Union\n\nclass Number:\n    \"\"\"A wrapper for a numeric value.\"\"\"\n    def __init__(self, value: Union[int, float]) -> None:\n        self._value = float(value)\n\n    @property\n    def value(self) -> float:\n        return self._value\n\n    def __lt__(self, other):\n        if isinstance(other, Number):\n            return self.value < other.value\n        return self.value < other\n\n    def __eq__(self, other):\n        if isinstance(other, Number):\n            return self.value == other.value\n        return self.value == other\n\nclass NumberList:\n    \"\"\"Holds a list of Number items and provides sorting.\"\"\"\n    def __init__(self, items: List[Number]) -> None:\n        self._items = items\n\n    def sortAscending(self) -> List[Number]:\n        \"\"\"Returns a new list of Number instances sorted by value ascending.\"\"\"\n        return sorted(self._items)\n\nclass Result:\n    \"\"\"A container for a numeric result.\"\"\"\n    def __init__(self, value: float) -> None:\n        self._value = value\n\n    @property\n    def value(self) -> float:\n        return self._value\n\nclass SecondSmallestFunction:\n    \"\"\"Stateless service to compute the second smallest number.\"\"\"\n    def second_smallest(self, numbers: List[Union[Number, float, int]]) -> float:\n        number_objects = [Number(n.value) if isinstance(n, Number) else Number(n) for n in numbers]\n        num_list = NumberList(number_objects)\n        sorted_numbers = num_list.sortAscending()\n        second_smallest_num = sorted_numbers[1]\n        return Result(second_smallest_num.value).value\n\ndef second_smallest(numbers: List[Union[Number, float, int]]) -> float:\n    \"\"\"Finds the second smallest number in a list.\"\"\"\n    service = SecondSmallestFunction()\n    return service.second_smallest(numbers)"}
{"task_id": "Mbpp/758", "solution": "import collections\n\ndef unique_sublists(input_list):\n    \"\"\"\n    Counts occurrences of sublists after converting them to tuples.\n    Returns a dictionary mapping each unique tuple to its frequency.\n    \"\"\"\n    counts = collections.Counter()\n    for sublist in input_list:\n        counts[tuple(sublist)] += 1\n    return dict(counts)"}
{"task_id": "Mbpp/759", "solution": "import re\n\ndef is_decimal(input: str) -> bool:\n    \"\"\"\n    Checks if the input string is a decimal number with exactly two decimal places.\n    Matches the regex ^[0-9]+\\.[0-9]{2}$.\n    \"\"\"\n    pattern = r\"^[0-9]+\\.[0-9]{2}$\"\n    return bool(re.match(pattern, input))"}
{"task_id": "Mbpp/760", "solution": "from typing import List\n\ndef unique_Element(input_list: list) -> bool:\n    \"\"\"Return True when input_list contains exactly one distinct element, else False.\n    Notes: Treats empty list as True (documented implementation decision).\"\"\"\n    if not input_list:\n        return True\n    return len(set(input_list)) == 1"}
{"task_id": "Mbpp/757", "solution": "class StringEntry:\n    \"\"\"Represents an indexed input string.\"\"\"\n    def __init__(self, index: int, value: str):\n        self.index = index\n        self.value = value\n\nclass ReversePair:\n    \"\"\"Represents a unique unordered pair of distinct indices.\"\"\"\n    def __init__(self, index1: int, index2: int):\n        # Store indices in sorted order to enforce unordered semantics for internal consistency if needed.\n        self.index1 = min(index1, index2)\n        self.index2 = max(index1, index2)\n\nclass ReversePairCounter:\n    \"\"\"Computes the count of unordered reverse string pairs.\"\"\"\n    def __init__(self):\n        self.count = 0 # Not strictly used, countPairs will return a local count.\n\n    def isReverse(self, a: str, b: str) -> bool:\n        \"\"\"Returns True if string b is the exact reverse of string a.\"\"\"\n        return b == a[::-1]\n\n    def countPairs(self, list_of_strings: list) -> int:\n        \"\"\"Iterates through unordered pairs and counts those that are reverses of each other.\"\"\"\n        n = len(list_of_strings)\n        if n < 2:\n            return 0\n\n        reverse_pair_count = 0\n        for i in range(n):\n            for j in range(i + 1, n): # j > i ensures distinct indices and counts each unordered pair once\n                if self.isReverse(list_of_strings[i], list_of_strings[j]):\n                    reverse_pair_count += 1\n        return reverse_pair_count\n\ndef count_reverse_pairs(list_of_strings: list) -> int:\n    \"\"\"\n    Counts the pairs of reverse strings in the given list.\n    Delegates the core logic to an internal ReversePairCounter.\n    \"\"\"\n    if len(list_of_strings) < 2:\n        return 0\n    \n    counter = ReversePairCounter()\n    return counter.countPairs(list_of_strings)"}
{"task_id": "Mbpp/762", "solution": "class Month:\n    \"\"\"Represents a month with its number, name, and number of days.\"\"\"\n    def __init__(self, number: int, name: str, days: int):\n        self.number = number\n        self.name = name\n        self.days = days\n\nMONTHS = {\n    1: Month(1, \"January\", 31),\n    2: Month(2, \"February\", 28),\n    3: Month(3, \"March\", 31),\n    4: Month(4, \"April\", 30),\n    5: Month(5, \"May\", 31),\n    6: Month(6, \"June\", 30),\n    7: Month(7, \"July\", 31),\n    8: Month(8, \"August\", 31),\n    9: Month(9, \"September\", 30),\n    10: Month(10, \"October\", 31),\n    11: Month(11, \"November\", 30),\n    12: Month(12, \"December\", 31),\n}\n\nclass InputValidator:\n    \"\"\"Provides validation for month numbers.\"\"\"\n    def is_valid_month(self, month: int) -> bool:\n        \"\"\"Checks if the given month number is a valid integer between 1 and 12.\"\"\"\n        return isinstance(month, int) and 1 <= month <= 12\n\nclass MonthChecker:\n    \"\"\"Determines if a given month number has 30 days, handling input validation.\"\"\"\n    def __init__(self):\n        self._validator = InputValidator()\n\n    def check_monthnumber_number(self, month: int) -> bool:\n        \"\"\"Checks if a month number has 30 days, raising ValueError for invalid input.\"\"\"\n        if not self._validator.is_valid_month(month):\n            raise ValueError(\"invalid month number\")\n        \n        month_data = MONTHS[month]\n        return month_data.days == 30\n\n_month_checker_instance = MonthChecker()\n\ndef check_monthnumber_number(month: int) -> bool:\n    \"\"\"Checks whether the given month number contains 30 days or not.\"\"\"\n    return _month_checker_instance.check_monthnumber_number(month)"}
{"task_id": "Mbpp/764", "solution": "class Digit:\n    \"\"\"Wraps a single character and determines if it is a digit.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def isDigit(self) -> bool:\n        \"\"\"Checks if the stored character is a digit.\"\"\"\n        return self.value.isdigit()\n\nclass Result:\n    \"\"\"Data holder for digitCount.\"\"\"\n    def __init__(self, digitCount: int):\n        self.digitCount = digitCount\n\nclass NumberCtr:\n    \"\"\"Encapsulates counting logic and input storage.\"\"\"\n    def __init__(self, input_string: str):\n        self.input = input_string\n\n    def countDigits(self) -> int:\n        \"\"\"Counts the number of digit characters in the input string.\"\"\"\n        count = 0\n        for char in self.input:\n            digit_obj = Digit(char)\n            if digit_obj.isDigit():\n                count += 1\n        result_obj = Result(count)\n        return result_obj.digitCount\n\ndef number_ctr(input_string: str) -> int:\n    \"\"\"Accepts a single argument (string) and returns an int equal to the number of digit characters ('0'..'9').\"\"\"\n    counter_instance = NumberCtr(input_string)\n    return counter_instance.countDigits()"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(arr, n):\n    \"\"\"\n    Finds the minimum difference between any two elements in a given array.\n    This function validates inputs and computes the minimum absolute difference.\n    \"\"\"\n    # Validate n is an integer and n >= 2.\n    if not isinstance(n, int) or n < 2:\n        raise ValueError(\"n must be an integer >= 2\")\n\n    # Validate arr is a sequence (list or tuple).\n    if not isinstance(arr, (list, tuple)):\n        raise ValueError(\"arr must be a sequence (list or tuple)\")\n\n    # Validate n must equal len(arr).\n    if n != len(arr):\n        raise ValueError(\"n must equal len(arr)\")\n\n    # Validate all elements of arr must be numeric.\n    for element in arr:\n        if not isinstance(element, (int, float)):\n            raise ValueError(\"all elements of arr must be numeric\")\n\n    # Create a shallow list copy and sort it for efficient difference calculation.\n    nums = list(arr)\n    nums.sort()\n\n    # Initialize min_diff with the absolute difference of the first two elements.\n    min_diff = abs(nums[1] - nums[0])\n\n    # Iterate through the sorted array to find the minimum difference between adjacent elements.\n    for i in range(1, n):\n        current_diff = abs(nums[i] - nums[i-1])\n        if current_diff < min_diff:\n            min_diff = current_diff\n\n    return min_diff"}
{"task_id": "Mbpp/765", "solution": "import math\n\nclass InvalidInputException(Exception):\n    \"\"\"Exception raised for invalid input.\"\"\"\n    def __init__(self, message, code=None):\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\nclass ValidationResult:\n    \"\"\"Holds validation result.\"\"\"\n    def __init__(self, valid: bool, message: str = \"\"):\n        self.valid = valid\n        self.message = message\n\nclass InputValidator:\n    \"\"\"Validates input parameters.\"\"\"\n    def validateIntegerGreaterEqualOne(self, n) -> ValidationResult:\n        if not isinstance(n, int):\n            return ValidationResult(False, \"Input must be an integer.\")\n        if n < 1:\n            return ValidationResult(False, \"Input must be an integer greater than or equal to 1.\")\n        return ValidationResult(True)\n\nclass ExceptionHandler:\n    \"\"\"Handles exceptions.\"\"\"\n    def raiseInvalidInputException(self, message: str) -> None:\n        raise InvalidInputException(message)\n\nclass PoliteNumberService:\n    \"\"\"Service to compute polite numbers.\"\"\"\n    def __init__(self):\n        self._validator = InputValidator()\n        self._exception_handler = ExceptionHandler()\n\n    def is_polite(self, n: int) -> int:\n        \"\"\"\n        Validates input and computes the nth polite number.\n        \"\"\"\n        result = self._validator.validateIntegerGreaterEqualOne(n)\n        if not result.valid:\n            self._exception_handler.raiseInvalidInputException(result.message)\n        return self.computeNth(n)\n\n    def computeNth(self, n: int) -> int:\n        \"\"\"\n        Computes the nth polite number.\n        Polite numbers are positive integers that are not powers of 2.\n        \"\"\"\n        candidate_x = n\n        while True:\n            # Calculate the count of powers of 2 less than or equal to candidate_x.\n            # These are 2^0, 2^1, ..., 2^k where 2^k <= candidate_x.\n            # The count is floor(log2(candidate_x)) + 1.\n            # For candidate_x = 0, log2 is undefined, but input 'n' is validated to be >= 1,\n            # so candidate_x will always be >= 1 here.\n            powers_of_2_count = int(math.log2(candidate_x)) + 1\n            \n            # The count of polite numbers up to candidate_x is candidate_x minus\n            # the count of powers of 2 up to candidate_x.\n            polite_count_up_to_x = candidate_x - powers_of_2_count\n\n            if polite_count_up_to_x >= n:\n                # This candidate_x is the nth polite number if it's not a power of 2,\n                # or the first number after previous powers of two if it aligns.\n                return candidate_x\n            \n            candidate_x += 1\n\n# module-level API wrapper\n_service = PoliteNumberService()\n\ndef is_polite(n: int) -> int:\n    return _service.is_polite(n)"}
{"task_id": "Mbpp/767", "solution": "from typing import Sequence, Union\n\nclass NumberValue:\n    \"\"\"Wrapper capturing numeric value and numeric_type metadata.\"\"\"\n    def __init__(self, value: Union[int, float]) -> None:\n        self.value: Union[int, float] = value\n        self.numeric_type: str = \"int\" if isinstance(value, int) else \"float\"\n\nclass IndexPair:\n    \"\"\"Value object representing an ordered index pair (i, j) where i < j.\"\"\"\n    def __init__(self, i: int, j: int) -> None:\n        self.i: int = i\n        self.j: int = j\n\n    def sum(self, numbers: Sequence[Union[int, float]]) -> Union[int, float]:\n        \"\"\"Calculates the sum of numbers at the stored indices.\"\"\"\n        return numbers[self.i] + numbers[self.j]\n\nclass PairCounter:\n    \"\"\"Encapsulates counting algorithm and internal state for finding pairs.\"\"\"\n    def __init__(self, numbers: Sequence[Union[int, float]], target: Union[int, float]) -> None:\n        self._numbers: Sequence[Union[int, float]] = numbers\n        self._target: Union[int, float] = target\n        self._count: int = 0\n\n    def get_pairs_count(self) -> int:\n        \"\"\"Performs index-based scanning and counts pairs that sum to the target.\"\"\"\n        n = len(self._numbers)\n        for i in range(n - 1):\n            for j in range(i + 1, n):\n                if self._numbers[i] + self._numbers[j] == self._target:\n                    self._count += 1\n        return self._count\n\ndef get_pairs_count(numbers: Sequence[Union[int, float]], target: Union[int, float]) -> int:\n    \"\"\"\n    Counts the number of distinct index pairs (i, j) with i < j such that\n    numbers[i] + numbers[j] == target.\n    \"\"\"\n    if len(numbers) < 2:\n        return 0\n    \n    counter = PairCounter(numbers, target)\n    return counter.get_pairs_count()"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(items):\n    \"\"\"\n    Return a list of all pairs of consecutive items in the input list.\n    Returns an empty list if the input has fewer than two items.\n    \"\"\"\n    if len(items) < 2:\n        return []\n    return [(items[i], items[i+1]) for i in range(len(items) - 1)]"}
{"task_id": "Mbpp/770", "solution": "class OddNumberSequence:\n    \"\"\"Generates a sequence of the first n odd natural numbers.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n\n    def generate(self) -> list[int]:\n        \"\"\"Returns a list of odd numbers using the formula 2*k - 1.\"\"\"\n        return [2 * k - 1 for k in range(1, self.n + 1)]\n\nclass PowerOperation:\n    \"\"\"Computes integer powers.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def pow(self, base: int, exponent: int) -> int:\n        \"\"\"Calculates base raised to the power of exponent.\"\"\"\n        return base ** exponent\n\nclass Accumulator:\n    \"\"\"Maintains a running integer sum.\"\"\"\n    def __init__(self) -> None:\n        self._sum = 0\n\n    def add(self, value: int) -> None:\n        \"\"\"Adds a value to the current sum.\"\"\"\n        self._sum += value\n\n    def value(self) -> int:\n        \"\"\"Returns the current accumulated sum.\"\"\"\n        return self._sum\n\nclass Result:\n    \"\"\"A simple wrapper to represent a final integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\ndef odd_num_sum(n: int) -> int:\n    \"\"\"\n    Finds the sum of the fourth power of the first n odd natural numbers.\n    Orchestrates sequence generation, power computation, and accumulation.\n    \"\"\"\n    odd_sequence_generator = OddNumberSequence(n)\n    odd_bases = odd_sequence_generator.generate()\n\n    power_calculator = PowerOperation()\n    accumulator = Accumulator()\n\n    for base in odd_bases:\n        fourth_power = power_calculator.pow(base, 4)\n        accumulator.add(fourth_power)\n\n    final_result = Result(accumulator.value())\n    return final_result.value"}
{"task_id": "Mbpp/769", "solution": "from typing import Any, List\n\nclass TypeChecker:\n    def is_list(self, obj: Any) -> bool:\n        \"\"\"Checks if the given object is a Python list.\"\"\"\n        return isinstance(obj, list)\n\n    def preserve_type(self, elem: Any) -> Any:\n        \"\"\"Returns the element unchanged, documenting no type coercion.\"\"\"\n        return elem\n\nclass ResultList:\n    def __init__(self):\n        self._elements: List[Any] = []\n\n    def append(self, elem: Any) -> None:\n        \"\"\"Appends an element to the internal list.\"\"\"\n        self._elements.append(elem)\n\n    def to_list(self) -> List[Any]:\n        \"\"\"Returns a new Python list containing the accumulated elements.\"\"\"\n        return list(self._elements)\n\nclass Element:\n    def __init__(self, value: Any):\n        self.value: Any = value\n        self.type: type = type(value)\n\n    def equals(self, other: 'Element') -> bool:\n        \"\"\"Compares the value of this element with another.\"\"\"\n        return self.value == other.value\n\nclass DiffFunction:\n    def __init__(self):\n        self._type_checker: TypeChecker = TypeChecker()\n\n    def Diff(self, list_a: List[Any], list_b: List[Any]) -> List[Any]:\n        \"\"\"Coordinates validation and computation of the list difference.\"\"\"\n        self.validate_inputs(list_a, list_b)\n        result_list = self.compute_difference(list_a, list_b)\n        return result_list.to_list()\n\n    def validate_inputs(self, list_a: Any, list_b: Any) -> None:\n        \"\"\"Validates that both inputs are Python list instances.\"\"\"\n        if not self._type_checker.is_list(list_a) or not self._type_checker.is_list(list_b):\n            raise TypeError(\"Diff: both inputs must be python list instances\")\n\n    def compute_difference(self, list_a: List[Any], list_b: List[Any]) -> ResultList:\n        \"\"\"Computes the difference by iterating list_a and checking membership in list_b.\"\"\"\n        result = ResultList()\n        for item_a in list_a:\n            if item_a not in list_b:\n                result.append(self._type_checker.preserve_type(item_a))\n        return result\n\ndef Diff(list_a: List[Any], list_b: List[Any]) -> List[Any]:\n    \"\"\"Public API. Validates inputs and returns a new list of elements from list_a not present in list_b.\"\"\"\n    return DiffFunction().Diff(list_a, list_b)"}
{"task_id": "Mbpp/771", "solution": "from typing import Optional\n\nclass Stack:\n    \"\"\"A simple LIFO stack implementation.\"\"\"\n    def __init__(self) -> None:\n        self._items: list[str] = []\n\n    def push(self, char: str) -> None:\n        self._items.append(char)\n\n    def pop(self) -> str:\n        # Assumes caller checks isEmpty before calling pop\n        return self._items.pop()\n\n    def peek(self) -> Optional[str]:\n        if not self.isEmpty():\n            return self._items[-1]\n        return None\n\n    def isEmpty(self) -> bool:\n        return len(self._items) == 0\n\nclass BracketPair:\n    \"\"\"Represents a pair of opening and closing brackets.\"\"\"\n    def __init__(self, open: str, close: str) -> None:\n        self.open = open\n        self.close = close\n\ndef _default_pairs() -> list[BracketPair]:\n    \"\"\"Provides a list of default bracket pairs: (), [], {}.\"\"\"\n    return [\n        BracketPair('(', ')'),\n        BracketPair('[', ']'),\n        BracketPair('{', '}')\n    ]\n\nclass CheckExpression:\n    \"\"\"Encapsulates the algorithm for checking balanced bracket expressions.\"\"\"\n    def __init__(self) -> None:\n        self._stack = Stack()\n        self._pairs: dict[str, str] = {}\n        self._opening_brackets: set[str] = set()\n        self._closing_brackets: set[str] = set()\n\n        for bp in _default_pairs():\n            self._pairs[bp.open] = bp.close\n            self._opening_brackets.add(bp.open)\n            self._closing_brackets.add(bp.close)\n\n    def check_expression(self, expr: str) -> bool:\n        \"\"\"Checks if the given expression has balanced and correctly nested brackets.\"\"\"\n        for char in expr:\n            if char in self._opening_brackets:\n                self._stack.push(char)\n            elif char in self._closing_brackets:\n                if self._stack.isEmpty():\n                    return False\n                \n                last_open_bracket = self._stack.peek()\n                if self._pairs.get(last_open_bracket) == char:\n                    self._stack.pop()\n                else:\n                    return False\n        \n        return self._stack.isEmpty()\n\ndef check_expression(expr: str) -> bool:\n    \"\"\"\n    Checks if the given expression is balanced or not.\n    \"\"\"\n    checker = CheckExpression()\n    return checker.check_expression(expr)"}
{"task_id": "Mbpp/772", "solution": "from typing import List\n\ndef _tokenize(s: str) -> List[str]:\n    \"\"\"Tokenizes input by one-or-more space separators; returns list of non-empty token strings.\"\"\"\n    return s.split()\n\ndef _filter_tokens(tokens: List[str], k: int) -> List[str]:\n    \"\"\"Returns list of tokens where len(token) != k, preserving original order.\"\"\"\n    return [token for token in tokens if len(token) != k]\n\ndef _join_tokens(tokens: List[str]) -> str:\n    \"\"\"Joins tokens with a single space; returns empty string if tokens is empty.\"\"\"\n    return ' '.join(tokens)\n\ndef remove_length(s: str, k: int) -> str:\n    \"\"\"Removes all words of a specified length k from the input string s.\"\"\"\n    tokens = _tokenize(s)\n    filtered_tokens = _filter_tokens(tokens, k)\n    result = _join_tokens(filtered_tokens)\n    return result"}
{"task_id": "Mbpp/773", "solution": "from typing import NamedTuple, Optional, Tuple\n\nclass Occurrence(NamedTuple):\n    \"\"\"Represents a match as (substring, start, end).\"\"\"\n    substring: str\n    start: int\n    end: int\n\ndef occurance_substring(source: str, substring: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Finds the first occurrence of a substring within a string.\n    Returns: Occurrence (NamedTuple) or None.\n    \"\"\"\n    start_index = source.find(substring)\n    if start_index == -1:\n        return None\n    \n    end_index = start_index + len(substring)\n    return Occurrence(substring, start_index, end_index)"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list:\n    \"\"\"Return a list of lists grouping consecutive equal elements from input_list.\n\n    Args:\n      input_list: list -- sequence of elements to group (value equality used).\n\n    Returns:\n      list of lists where each inner list is a maximal run of equal adjacent elements.\n    \"\"\"\n    if not input_list:\n        return []\n\n    groups = []\n    current_group = []\n\n    for item in input_list:\n        if not current_group or item == current_group[0]:\n            current_group.append(item)\n        else:\n            groups.append(current_group)\n            current_group = [item]\n    \n    # Append the last current_group if it's not empty\n    if current_group:\n        groups.append(current_group)\n            \n    return groups"}
{"task_id": "Mbpp/777", "solution": "def _compute_distinct_sum(iterable):\n    \"\"\"\n    Module-private helper: returns sum of distinct elements from iterable\n    using Python equality semantics.\n    \"\"\"\n    distinct_elements = set(iterable)\n    return sum(distinct_elements)\n\ndef find_sum(input_list):\n    \"\"\"\n    Computes the numeric sum of distinct elements in the provided list.\n    Validation is assumed to be handled externally based on design context constraints.\n    \"\"\"\n    return _compute_distinct_sum(input_list)"}
{"task_id": "Mbpp/775", "solution": "def odd_position(input_list):\n    \"\"\"Return True iff every element at odd indices is odd.\n\n    Parameters:\n        input_list (list): list of integers\n    Returns:\n        bool\n    Raises:\n        TypeError: if input_list is not a list or elements are not integers\n        ValueError: if an element is not an integer (can be coalesced with TypeError for consistency)\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for i, num in enumerate(input_list):\n        if not isinstance(num, int):\n            raise TypeError(f\"All elements in the list must be integers, but found {type(num)} at index {i}.\")\n\n        if i % 2 == 1:  # Check odd indices\n            if num % 2 == 0:  # If the number at an odd index is even\n                return False\n    return True"}
{"task_id": "Mbpp/781", "solution": "import math\n\nclass Number:\n    \"\"\"\n    A simple data model to represent an integer value.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass DivisorCountResult:\n    \"\"\"\n    Data model encapsulating the count of divisors and its parity.\n    \"\"\"\n    def __init__(self, count: int) -> None:\n        self.count = count\n        self.is_even = (count % 2 == 0)\n\nclass DivisorCalculator:\n    \"\"\"\n    Calculates the count of positive divisors for an integer\n    and determines if that count is even.\n    \"\"\"\n    def _count_positive_divisors(self, n: int) -> int:\n        \"\"\"\n        Internal helper to count the number of positive divisors for a given integer n.\n        Handles positive integers for counting divisors, returning 0 for non-positive inputs.\n        \"\"\"\n        if n <= 0:\n            return 0\n        \n        count = 0\n        limit = int(math.sqrt(n))\n        for i in range(1, limit + 1):\n            if n % i == 0:\n                if i * i == n:\n                    count += 1\n                else:\n                    count += 2\n        return count\n\n    def count_divisors(self, n: int) -> bool:\n        \"\"\"\n        Determines if the count of positive divisors for n is an even number.\n        This method delegates to an internal helper and uses DivisorCountResult.\n        \"\"\"\n        divisor_count = self._count_positive_divisors(n)\n        result = DivisorCountResult(divisor_count)\n        return result.is_even\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks whether the count of positive divisors for an integer n is even.\n    Delegates the calculation to a DivisorCalculator instance.\n    \"\"\"\n    calculator = DivisorCalculator()\n    return calculator.count_divisors(n)"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(input_list: list) -> list:\n    \"\"\"\n    Finds combinations of sums with tuples in the given tuple list.\n    Computes element-wise sums for every unordered distinct pair of input tuples.\n    \"\"\"\n    n = len(input_list)\n    if n < 2:\n        return []\n\n    results = []\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            tuple1 = input_list[i]\n            tuple2 = input_list[j]\n            sum_tuple = (tuple1[0] + tuple2[0], tuple1[1] + tuple2[1])\n            results.append(sum_tuple)\n\n    return results"}
{"task_id": "Mbpp/782", "solution": "from dataclasses import dataclass\nfrom typing import Iterator, List\n\n@dataclass\nclass InputArray:\n    elements: List[int]\n\n@dataclass\nclass Subarray:\n    start_index: int\n    end_index: int\n    _elements: List[int]\n\n    def length(self) -> int:\n        return self.end_index - self.start_index + 1\n\n    def sum(self) -> int:\n        return sum(self._elements[self.start_index:self.end_index+1])\n\n@dataclass\nclass Result:\n    total_sum: int\n\ndef _compute_subarrays(elements: list) -> Iterator[Subarray]:\n    \"\"\"Yields all contiguous subarrays as Subarray objects.\"\"\"\n    n = len(elements)\n    for i in range(n):\n        for j in range(i, n):\n            yield Subarray(start_index=i, end_index=j, _elements=elements)\n\ndef odd_length_sum(arr: list) -> int:\n    \"\"\"Compute and return the sum of all odd-length contiguous subarrays of arr.\"\"\"\n    total_sum = 0\n    for subarray in _compute_subarrays(arr):\n        if subarray.length() % 2 != 0:\n            total_sum += subarray.sum()\n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "from __future__ import annotations\n\nclass Number:\n    \"\"\"\n    A value holder for an integer with methods to check its parity.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_even(self) -> bool:\n        \"\"\"Checks if the number is even.\"\"\"\n        return self.value % 2 == 0\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the number is odd.\"\"\"\n        return self.value % 2 != 0\n\ndef find_first_odd(numbers: list[int]) -> int | None:\n    \"\"\"Scans the list to find and return the first odd integer.\"\"\"\n    for num in numbers:\n        number_obj = Number(num)\n        if number_obj.is_odd():\n            return num\n    return None\n\ndef find_first_even(numbers: list[int]) -> int | None:\n    \"\"\"Scans the list to find and return the first even integer.\"\"\"\n    for num in numbers:\n        number_obj = Number(num)\n        if number_obj.is_even():\n            return num\n    return None\n\ndef mul_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd number of a given list.\n    Raises ValueError if either the first odd or first even number is missing.\n    \"\"\"\n    first_odd = find_first_odd(numbers)\n    first_even = find_first_even(numbers)\n\n    if first_odd is None or first_even is None:\n        raise ValueError(\"missing odd or even element in input list\")\n\n    return first_odd * first_even"}
{"task_id": "Mbpp/785", "solution": "import re\nfrom typing import List\n\n\nclass ValidationError(Exception):\n    \"\"\"Represents parsing/validation problems (domain-level).\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\n\nclass TupleStringInput:\n    \"\"\"Represents the raw input string and provides a minimal well-formedness check.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n\n    def is_well_formed(self) -> bool:\n        \"\"\"Checks if the raw string starts and ends with parentheses.\"\"\"\n        return self.raw.startswith('(') and self.raw.endswith(')')\n\n\nclass IntegerTuple:\n    \"\"\"Holds parsed integer elements and provides conversion to a native tuple.\"\"\"\n    def __init__(self, elements: List[int]):\n        self.elements = elements\n\n    def to_tuple(self) -> tuple:\n        \"\"\"Converts the internal list of integers to a native Python tuple.\"\"\"\n        return tuple(self.elements)\n\n\nclass TupleStringParser:\n    \"\"\"Validates and parses a tuple-formatted string into an IntegerTuple.\"\"\"\n\n    def trim_whitespace(self, s: str) -> str:\n        \"\"\"Strips leading and trailing whitespace from a string.\"\"\"\n        return s.strip()\n\n    def validate_format(self, raw: str) -> bool:\n        \"\"\"Checks if the raw string has the basic parenthesized form and is not too short.\"\"\"\n        return raw.startswith('(') and raw.endswith(')') and len(raw) >= 2\n\n    def parse(self, raw: str) -> IntegerTuple:\n        \"\"\"Parses the raw string into an IntegerTuple or raises ValidationError.\"\"\"\n        if not self.validate_format(raw):\n            raise ValidationError(\"malformed tuple representation: missing or incorrect parentheses\")\n\n        inner_content = raw[1:-1].strip() # Remove outer parentheses and strip overall whitespace\n\n        if not inner_content: # Handles empty tuple cases like \"()\" or \"( )\"\n            return IntegerTuple(elements=[])\n\n        elements: List[int] = []\n        # Split by comma, handling optional whitespace around commas.\n        tokens = re.split(r'\\s*,\\s*', inner_content)\n\n        for token in tokens:\n            trimmed_token = self.trim_whitespace(token)\n            if not trimmed_token:\n                raise ValidationError(f\"malformed tuple representation: empty element found in '{raw}'\")\n            try:\n                elements.append(int(trimmed_token))\n            except ValueError:\n                raise ValidationError(f\"non-integer element found: '{trimmed_token}' in '{raw}'\")\n\n        return IntegerTuple(elements=elements)\n\n\ndef tuple_str_int(input_string: str) -> tuple:\n    \"\"\"Converts a string representation of a tuple of integers to an integer tuple.\"\"\"\n    # Construct TupleStringInput, though its is_well_formed() isn't directly used here.\n    # tuple_input = TupleStringInput(raw=input_string)\n\n    parser = TupleStringParser()\n    try:\n        integer_tuple = parser.parse(input_string)\n        return integer_tuple.to_tuple()\n    except ValidationError as e:\n        raise ValueError(e.message)"}
{"task_id": "Mbpp/788", "solution": "def new_tuple(input_list: list, input_string: str) -> tuple:\n    \"\"\"\n    Creates a new tuple by concatenating elements from a list and a string.\n    The list's elements are followed by the string as the last element.\n    \"\"\"\n    return (*input_list, input_string)"}
{"task_id": "Mbpp/786", "solution": "from typing import List, Any\n\ndef compute_index(items: List[Any], value: Any) -> int:\n    \"\"\"\n    Implements rightmost binary search to locate the insertion point after any equal elements.\n    Returns an index in the range [0, len(items)].\n    \"\"\"\n    low = 0\n    high = len(items)\n\n    while low < high:\n        mid = low + (high - low) // 2\n        if items[mid] <= value:\n            low = mid + 1\n        else:\n            high = mid\n    return low\n\ndef right_insertion(sorted_list: List[Any], value: Any) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in sorted order.\n    This function delegates to a binary search helper and does not mutate the input list.\n    \"\"\"\n    return compute_index(sorted_list, value)"}
{"task_id": "Mbpp/790", "solution": "def even_position(lst):\n    \"\"\"Return True iff, for every even index i (0,2,4,...), the element at lst[i] is an even integer.\n    False otherwise, including if any element at an even index is not an integer.\n    \"\"\"\n    for i in range(0, len(lst), 2):\n        v = lst[i]\n        if not isinstance(v, int) or (v % 2) != 0:\n            return False\n    return True"}
{"task_id": "Mbpp/787", "solution": "def text_match_three(input: str) -> bool:\n    \"\"\"\n    Checks if the input string contains an 'a' followed immediately by exactly three 'b's ('abbb').\n    Raises TypeError if input is not a string.\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"Input must be a string.\")\n\n    target_literal = 'a'\n    target_repeat_char = 'b'\n    target_repeat_count = 3\n\n    if len(input) < target_repeat_count + 1:\n        return False\n\n    for i in range(len(input) - target_repeat_count):\n        if input[i] == target_literal:\n            match_found_for_this_a = True\n            for j in range(target_repeat_count):\n                if input[i + 1 + j] != target_repeat_char:\n                    match_found_for_this_a = False\n                    break\n            if match_found_for_this_a:\n                return True\n\n    return False"}
{"task_id": "Mbpp/791", "solution": "def remove_nested(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Returns a new tuple containing only the top-level elements from input_tuple that are not of type tuple.\n    Preserves original element order and does not mutate the input tuple.\n    \"\"\"\n    retained_elements = []\n    for element in input_tuple:\n        if not isinstance(element, tuple):\n            retained_elements.append(element)\n    return tuple(retained_elements)"}
{"task_id": "Mbpp/792", "solution": "def count_list(input):\n    \"\"\"\n    Counts the number of top-level elements that are lists within the given input list.\n    Performs an exact-type check for list elements.\n    \"\"\"\n    if type(input) is not list:\n        raise TypeError(\"count_list: input must be of type list\")\n\n    count = 0\n    for element in input:\n        if type(element) is list:\n            count += 1\n    return count\n\nassert count_list([[1, 3], [5, 7], [9, 11], [13, 15, 17]]) == 4"}
{"task_id": "Mbpp/793", "solution": "def last(arr, target):\n    \"\"\"\n    Return the zero-based index of the last occurrence of target in sorted list arr, or -1 if not found.\n    This implementation uses a modified binary search.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    result = -1\n\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == target:\n            result = mid  # Found a potential last occurrence\n            low = mid + 1 # Try to find an even later occurrence in the right half\n        elif arr[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n            \n    return result"}
{"task_id": "Mbpp/794", "solution": "import re\n\nclass InputString:\n    \"\"\"Encapsulates the input string value.\"\"\"\n    def __init__(self, value: str) -> None:\n        self._value = value\n\n    @property\n    def value(self) -> str:\n        return self._value\n\nclass MatchResult:\n    \"\"\"Represents boolean outcome of evaluation.\"\"\"\n    def __init__(self, matched: bool) -> None:\n        self._matched = matched\n\n    @property\n    def matched(self) -> bool:\n        return self._matched\n\nclass Pattern:\n    \"\"\"Holds the regex string used by TextMatcher.\"\"\"\n    def __init__(self, regex: str) -> None:\n        self._regex = regex\n\n    @property\n    def regex(self) -> str:\n        return self._regex\n\nclass TextMatcher:\n    \"\"\"Evaluates whether an InputString matches the configured Pattern.\"\"\"\n    def __init__(self, pattern: str = \"^a.*b$\") -> None:\n        self.pattern = pattern\n        self._compiled = re.compile(pattern)\n\n    def matches(self, input_string: InputString) -> MatchResult:\n        \"\"\"Evaluates if the input string matches the compiled pattern.\"\"\"\n        match = self._compiled.match(input_string.value)\n        return MatchResult(match is not None)\n\n    def text_starta_endb(self, text: str) -> bool:\n        \"\"\"Convenience wrapper for the public API.\"\"\"\n        input_str = InputString(text)\n        result = self.matches(input_str)\n        return result.matched\n\n_text_matcher_instance = TextMatcher()\n\ndef text_starta_endb(text: str) -> bool:\n    \"\"\"Matches a string that has an 'a' followed by anything, ending in 'b'.\"\"\"\n    return _text_matcher_instance.text_starta_endb(text)"}
{"task_id": "Mbpp/796", "solution": "def return_sum(dictionary: dict):\n    \"\"\"\n    Calculates the sum of all numeric values in a dictionary.\n    Raises TypeError if input is not a dict or if any value is non-numeric.\n    \"\"\"\n    if not isinstance(dictionary, dict):\n        raise TypeError(\"Input must be a dictionary.\")\n\n    total = 0\n    is_float_sum = False\n\n    for value in dictionary.values():\n        if not isinstance(value, (int, float)):\n            raise TypeError(\"All dictionary values must be numeric (int or float).\")\n        if isinstance(value, float):\n            is_float_sum = True\n        total += value\n\n    if is_float_sum:\n        return float(total)\n    else:\n        return int(total)"}
{"task_id": "Mbpp/797", "solution": "class Number:\n    \"\"\"Wraps an integer value and provides predicates.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the number is odd.\"\"\"\n        return self.value % 2 != 0\n\n    def is_natural(self) -> bool:\n        \"\"\"Checks if the number is a natural number (>= 1).\"\"\"\n        return self.value >= 1\n\nclass Range:\n    \"\"\"Encapsulates inclusive range bounds and membership logic.\"\"\"\n    def __init__(self, l: int, r: int):\n        self.l = l\n        self.r = r\n\n    def contains(self, n: int) -> bool:\n        \"\"\"Checks if a number is within the inclusive range.\"\"\"\n        return self.l <= n <= self.r\n\nclass Result:\n    \"\"\"Container for an aggregated sum.\"\"\"\n    def __init__(self, sum: int = 0):\n        self.sum = sum\n\nclass SumFunction:\n    \"\"\"Computes the sum of odd natural numbers within an inclusive range.\"\"\"\n    def compute(self, l: int, r: int) -> int:\n        \"\"\"Calculates the sum of odd natural numbers in [l, r].\"\"\"\n        current_sum_result = Result()\n        range_obj = Range(l, r)\n        for n in range(l, r + 1):\n            if range_obj.contains(n):\n                number = Number(n)\n                if number.is_natural() and number.is_odd():\n                    current_sum_result.sum += n\n        return current_sum_result.sum\n\ndef _validate_and_normalize_bounds(l, r) -> tuple[int, int]:\n    \"\"\"Ensures l and r are integers and normalizes their order.\"\"\"\n    if l > r:\n        return r, l\n    return l, r\n\ndef sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Finds the sum of all odd natural numbers within the range l and r.\n    Natural numbers are defined as integers >= 1.\n    \"\"\"\n    l_norm, r_norm = _validate_and_normalize_bounds(l, r)\n    sum_calculator = SumFunction()\n    return sum_calculator.compute(l_norm, r_norm)"}
{"task_id": "Mbpp/798", "solution": "from typing import Union\n\nclass InputValidator:\n    \"\"\"Validates that a supplied value is a Python list of numeric elements.\"\"\"\n    def is_numeric_list(self, elements: list) -> bool:\n        \"\"\"Return True iff elements is a list and each element is int or float.\"\"\"\n        if not isinstance(elements, list):\n            return False\n        for e in elements:\n            if not isinstance(e, (int, float)):\n                return False\n        return True\n\nclass Accumulator:\n    \"\"\"Maintains a single running total (O(1) extra space).\"\"\"\n    def __init__(self) -> None:\n        self._total: float = 0.0\n\n    def add(self, value: Union[int, float]) -> None:\n        \"\"\"Adds a numeric value to the running total.\"\"\"\n        self._total += value\n\n    def value(self) -> Union[int, float]:\n        \"\"\"Returns the current accumulated total.\"\"\"\n        return self._total\n\nclass NumericList:\n    \"\"\"Domain container for an input list of numbers.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements: list = elements\n        self.length: int = len(elements)\n\nclass Result:\n    \"\"\"Domain container wrapping a numeric return value.\"\"\"\n    def __init__(self, value: Union[int, float]) -> None:\n        self.value: Union[int, float] = value\n\nclass SumFunction:\n    \"\"\"Coordinates validation and accumulation for the _sum function.\"\"\"\n    def validate(self, elements: list) -> bool:\n        \"\"\"Returns True if elements is a list of ints/floats, else False.\"\"\"\n        return InputValidator().is_numeric_list(elements)\n\n    def _sum(self, elements: list) -> Union[int, float]:\n        \"\"\"Computes and returns the arithmetic sum after validation.\"\"\"\n        if not self.validate(elements):\n            raise TypeError(\"_sum expects a list of numeric elements\")\n        nl = NumericList(elements)\n        acc = Accumulator()\n        for e in nl.elements:\n            acc.add(e)\n        return Result(acc.value()).value\n\ndef _sum(elements: list) -> Union[int, float]:\n    \"\"\"\n    Top-level function to find the sum of an array.\n    Validates input and returns numeric sum or raises TypeError.\n    \"\"\"\n    sf = SumFunction()\n    return sf._sum(elements)"}
{"task_id": "Mbpp/800", "solution": "from enum import Enum\nfrom typing import Set\n\nclass WhitespaceChar(Enum):\n    SPACE = ' '\n    TAB = '\\t'\n    NEWLINE = '\\n'\n    CARRIAGE_RETURN = '\\r'\n    FORM_FEED = '\\f'\n\nWHITESPACE_CHARS: Set[str] = {c.value for c in WhitespaceChar}\n\ndef remove_all_spaces(s: str) -> str:\n    \"\"\"Removes all specified whitespace characters from the input string.\n    Returns a new string with these characters removed, preserving order.\n    \"\"\"\n    return ''.join(ch for ch in s if ch not in WHITESPACE_CHARS)"}
{"task_id": "Mbpp/803", "solution": "class NumberInput:\n    \"\"\"Handles number input representation and checks if it's numeric.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def is_numeric(self) -> bool:\n        \"\"\"Returns True if the value is an acceptable numeric type (int or float).\"\"\"\n        return isinstance(self.value, (int, float))\n\nclass PerfectSquareFunction:\n    \"\"\"Stateless class for computing perfect square status.\"\"\"\n    def is_perfect_square(self, number_input: NumberInput) -> bool:\n        \"\"\"Computes and returns a boolean indicating if the input number is a perfect square.\"\"\"\n        num = number_input.value\n\n        if num < 0:\n            return False\n\n        # If it's a float that is not an integer equivalent (e.g., 2.5), it's not a perfect square.\n        if isinstance(num, float) and num != int(num):\n            return False\n\n        n_int = int(num)\n\n        if n_int == 0:\n            return True\n\n        root = n_int**0.5\n        return root == int(root)\n\nclass Result:\n    \"\"\"Encapsulates the boolean outcome of the perfect square check.\"\"\"\n    def __init__(self, value: bool):\n        self.value = value\n\ndef is_perfect_square(number) -> bool:\n    \"\"\"\n    Checks whether the given number is a perfect square.\n    Raises TypeError if the input is not a numeric value (int or float).\n    \"\"\"\n    number_input = NumberInput(number)\n\n    if not number_input.is_numeric():\n        raise TypeError(\"Input must be a numeric value (int or float).\")\n\n    perfect_square_func = PerfectSquareFunction()\n    is_sq = perfect_square_func.is_perfect_square(number_input)\n    \n    result_obj = Result(is_sq)\n    return result_obj.value"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a, b, c):\n    \"\"\"Return int: 3 if a==b==c, 2 if exactly two are equal, 0 if all different.\"\"\"\n    if a == b and b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/804", "solution": "from typing import List\n\nclass IntegerElement:\n    \"\"\"\n    Represents a single integer element with a method to check its parity.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_even(self) -> bool:\n        return self.value % 2 == 0\n\nclass IntegerList:\n    \"\"\"\n    A domain object representing a list of integer elements.\n    \"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self.elements = [IntegerElement(e) for e in elements]\n\nclass ProductEvaluator:\n    \"\"\"\n    Stateless evaluator for determining if a product of integers is even.\n    Implements the business rule: product is even if at least one element is even.\n    \"\"\"\n    @staticmethod\n    def is_product_even(lst: IntegerList) -> bool:\n        \"\"\"\n        Checks if the product of elements in the IntegerList is even.\n        Short-circuits on the first even element found.\n        \"\"\"\n        for element in lst.elements:\n            if element.is_even():\n                return True\n        return False\n\ndef is_product_even(integers: List[int]) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    Delegates the core logic to the ProductEvaluator domain service.\n    \"\"\"\n    integer_list = IntegerList(integers)\n    return ProductEvaluator.is_product_even(integer_list)"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(value, d):\n    \"\"\"\n    Rotates the bits of a 32-bit number left by d bits.\n    The number is assumed to be 32 bits, and rotation count d is reduced modulo 32.\n    \"\"\"\n    BIT_LENGTH = 32\n    MASK = 0xFFFFFFFF\n\n    # Mask the input value to 32 bits (equivalent to Value32.mask())\n    masked_value = value & MASK\n\n    # Reduce d modulo 32 before shifting (equivalent to RotationCount.reduceMod32())\n    d_effective = d % BIT_LENGTH\n\n    # Perform the circular left shift using the specified formula\n    # The final mask ensures the result remains within 32 bits.\n    result = ((masked_value << d_effective) | (masked_value >> (BIT_LENGTH - d_effective))) & MASK\n\n    return result"}
{"task_id": "Mbpp/805", "solution": "# Helper function to compute sums of inner lists.\n# It iterates through each inner list and calculates its sum.\ndef compute_sums(lists_of_lists):\n    return [sum(inner_list) for inner_list in lists_of_lists]\n\n# Helper function to select the inner list with the maximal sum.\n# It finds the maximum sum and returns the first corresponding inner list.\ndef select_max(lists_of_lists, sums):\n    max_sum_value = max(sums)\n    for i, current_sum in enumerate(sums):\n        if current_sum == max_sum_value:\n            return lists_of_lists[i]\n\ndef max_sum_list(lists_of_lists):\n    \"\"\"\n    Returns the list in a list of lists whose sum of elements is the highest.\n    Assumes valid and non-empty input as per constraints.\n    \"\"\"\n    # Compute sums for all inner lists.\n    sums = compute_sums(lists_of_lists)\n\n    # Select the inner list corresponding to the maximum sum.\n    # Ties are resolved by returning the first encountered maximal inner list.\n    return select_max(lists_of_lists, sums)"}
{"task_id": "Mbpp/806", "solution": "class Result:\n    \"\"\"Encapsulates the integer maxRun result and provides accessor.\"\"\"\n    def __init__(self, maxRun: int):\n        self._maxRun = maxRun\n\n    def toInt(self) -> int:\n        \"\"\"Returns the integer value of the max run.\"\"\"\n        return self._maxRun\n\nclass UppercaseRun:\n    \"\"\"Represents a contiguous uppercase run with indices and computes its length.\"\"\"\n    def __init__(self, startIndex: int, endIndex: int):\n        self._startIndex = startIndex\n        self._endIndex = endIndex\n\n    def length(self) -> int:\n        \"\"\"Computes and returns the length of the run.\"\"\"\n        return self._endIndex - self._startIndex + 1\n\nclass InputString:\n    \"\"\"Value object wrapping the input string and exposing minimal operations for scanning.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def getLength(self) -> int:\n        \"\"\"Returns the length of the wrapped string.\"\"\"\n        return len(self._value)\n\n    def charAt(self, idx: int) -> str:\n        \"\"\"Returns the character at the specified index.\"\"\"\n        return self._value[idx]\n\nclass MaxRunUppercaseService:\n    \"\"\"Encapsulates validation and scanning logic for uppercase runs.\"\"\"\n    def validateInput(self, input: any) -> bool:\n        \"\"\"Validates if the input is a string.\"\"\"\n        return isinstance(input, str)\n\n    def computeMaxRun(self, input: str) -> int:\n        \"\"\"Computes the length of the longest contiguous ASCII uppercase run.\"\"\"\n        input_obj = InputString(input)\n        length = input_obj.getLength()\n        max_run = 0\n        current_run = 0\n\n        for i in range(length):\n            char = input_obj.charAt(i)\n            if 'A' <= char <= 'Z': # Only ASCII 'A'..'Z' count as uppercase\n                current_run += 1\n                max_run = max(max_run, current_run)\n            else:\n                current_run = 0\n        return max_run\n\ndef max_run_uppercase(input: str) -> int:\n    \"\"\"\n    Finds the maximum run of uppercase characters in the given string.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    service = MaxRunUppercaseService()\n    \n    if not service.validateInput(input):\n        raise TypeError(\"input must be str\")\n    \n    return service.computeMaxRun(input)"}
{"task_id": "Mbpp/808", "solution": "def check_K(tuple: tuple, k) -> bool:\n    \"\"\"\n    Checks if the given value k is present in the provided tuple.\n    Raises TypeError if the first argument is not a tuple.\n    \"\"\"\n    if not isinstance(tuple, tuple):\n        raise TypeError(\"First argument must be a tuple\")\n    return k in tuple"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers):\n    \"\"\"Finds the first odd number in the given list of numbers.\"\"\"\n    for v in numbers:\n        if (v % 2) != 0:\n            return v"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(a, b):\n    \"\"\"\n    Return True iff for every index i, b[i] < a[i].\n\n    Raises TypeError if a or b is not a tuple, or ValueError if tuples have different lengths.\n    \"\"\"\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise TypeError(\"Both arguments 'a' and 'b' must be tuples.\")\n\n    if len(a) != len(b):\n        raise ValueError(\"Tuples 'a' and 'b' must have the same length.\")\n\n    for i in range(len(a)):\n        if not (b[i] < a[i]):\n            return False\n    return True"}
