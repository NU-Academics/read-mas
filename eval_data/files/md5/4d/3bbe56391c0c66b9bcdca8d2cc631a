{"task_id": "Mbpp/306", "solution": "class Array:\n    \"\"\"Thin wrapper class around list to hold values and length and provide get(index).\"\"\"\n    def __init__(self, values):\n        self.values = values\n        self.length = len(values)\n\n    def get(self, index):\n        return self.values[index]\n\nclass Index:\n    \"\"\"Simple index holder and range-check helper.\"\"\"\n    def __init__(self, i, k):\n        self.i = i\n        self.k = k\n\n    def isInRange(self, arr: Array):\n        return 0 <= self.i < arr.length and 0 <= self.k < arr.length\n\nclass Result:\n    \"\"\"Encapsulate the computed integer result.\"\"\"\n    def __init__(self, value: int = 0):\n        self.value = value\n\nclass Subsequence:\n    \"\"\"Represent a candidate subsequence (indices), provide sum computation and strict-increasing check.\"\"\"\n    def __init__(self, indices):\n        self.indices = indices\n\n    def sum(self, arr: Array) -> int:\n        \"\"\"Return integer sum of arr values at indices.\"\"\"\n        current_sum = 0\n        for idx in self.indices:\n            current_sum += arr.get(idx)\n        return current_sum\n\n    def isStrictlyIncreasing(self, values) -> bool:\n        \"\"\"Return True if provided sequence of values is strictly increasing (>)\"\"\"\n        if not values:\n            return True\n        for j in range(1, len(values)):\n            if values[j] <= values[j-1]:\n                return False\n        return True\n\nclass Validator:\n    \"\"\"Validate inputs according to FR-2 and raise ValueError on invalid inputs.\"\"\"\n    def validate(self, arr_list, n, i, k):\n        \"\"\"Raise ValueError if any of: n != len(arr); i or k out of bounds; k <= i.\"\"\"\n        if n != len(arr_list):\n            raise ValueError(\"n must be equal to len(arr).\")\n\n        arr_model = Array(arr_list)\n        index_model = Index(i, k)\n\n        if not index_model.isInRange(arr_model):\n            raise ValueError(\"Indices i or k are out of bounds.\")\n\n        if k <= i:\n            raise ValueError(\"k must be greater than i.\")\n\nclass Algorithm:\n    \"\"\"Compute the maximum sum of strictly increasing subsequences using elements from arr[0..i] with arr[k] appended.\"\"\"\n    def computeMaxSum(self, arr_list, n, i, k):\n        \"\"\"Return int maximum sum per SRS: choose any subsequence of arr[0..i] (possibly empty), append arr[k], require strict-increasing (>). If no prefix candidate can precede arr[k], return arr[k].\"\"\"\n        arr_k_val = arr_list[k]\n        \n        # Initialize max_sum_with_k with arr_k_val, allowing for single-element subsequence [arr[k]]\n        max_sum_with_k = arr_k_val\n\n        # dp_prefix[j] stores the maximum sum of an increasing subsequence ending at index j (where j <= i)\n        # We consider elements from arr[0...i]\n        # The Validator ensures 0 <= i < n, so i will always be non-negative.\n        dp_prefix = [0] * (i + 1)\n        for j in range(i + 1):\n            current_val = arr_list[j]\n            dp_prefix[j] = current_val # At least the element itself\n            for prev_j in range(j):\n                if arr_list[prev_j] < current_val:\n                    dp_prefix[j] = max(dp_prefix[j], dp_prefix[prev_j] + current_val)\n        \n        # Now, consider combining these prefix subsequences with arr_k_val\n        for j in range(i + 1):\n            if arr_list[j] < arr_k_val:\n                max_sum_with_k = max(max_sum_with_k, dp_prefix[j] + arr_k_val)\n\n        return max_sum_with_k\n\n\ndef max_sum_increasing_subseq(arr, n, i, k):\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from prefix until ith index \n    and also including a given kth element which is after i (k > i).\n    \"\"\"\n    Validator().validate(arr, n, i, k)\n    max_sum = Algorithm().computeMaxSum(arr, n, i, k)\n    res = Result(max_sum)\n    return res.value"}
