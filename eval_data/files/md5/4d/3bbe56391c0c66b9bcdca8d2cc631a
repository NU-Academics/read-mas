{"task_id": "Mbpp/629", "solution": "def Split(numbers: list) -> list:\n    \"\"\"\n    Finds even numbers from a list of numbers.\n    Returns a new list containing only even integers from the input, preserving order.\n    \"\"\"\n    def is_even(number) -> bool:\n        \"\"\"\n        Checks if a number is an even integer.\n        Returns False for non-integer values.\n        \"\"\"\n        return isinstance(number, int) and number % 2 == 0\n\n    even_numbers = []\n    for number in numbers:\n        if is_even(number):\n            even_numbers.append(number)\n    return even_numbers"}
{"task_id": "Mbpp/630", "solution": "class Coordinate:\n    \"\"\"Represents a coordinate pair (row, column) as a domain value.\"\"\"\n    def __init__(self, row: int, col: int) -> None:\n        self.row = row\n        self.col = col\n\nclass Validator:\n    \"\"\"Enforces input contract: input must be a tuple of exactly two integers.\"\"\"\n    def validate_tuple_of_two_ints(self, coord: object) -> None:\n        if not isinstance(coord, tuple):\n            raise TypeError(\"Input must be a tuple.\")\n        if len(coord) != 2:\n            raise TypeError(\"Tuple must contain exactly two elements.\")\n        if not all(isinstance(x, int) for x in coord):\n            raise TypeError(\"Both elements of the tuple must be integers.\")\n\nclass CoordinatesResponse:\n    \"\"\"Holds computed coordinates and provides count metadata.\"\"\"\n    def __init__(self, coordinates: list) -> None:\n        self.coordinates = coordinates\n        self.count = len(coordinates)\n\nclass CoordinatesService:\n    \"\"\"Validates input, computes the 3x3 neighborhood, produces CoordinatesResponse, and returns native list of lists.\"\"\"\n    def validate_input(self, coord: object) -> None:\n        validator = Validator()\n        validator.validate_tuple_of_two_ints(coord)\n\n    def compute_neighbors(self, center: 'Coordinate') -> list:\n        \"\"\"Computes the 3x3 neighborhood around a center coordinate in row-major order.\"\"\"\n        neighbors = []\n        for r_offset in [-1, 0, 1]:\n            for c_offset in [-1, 0, 1]:\n                neighbors.append([center.row + r_offset, center.col + c_offset])\n        return neighbors\n\n    def get_coordinates(self, coord: tuple) -> list:\n        \"\"\"Validates the input, computes and returns the adjacent coordinates.\"\"\"\n        self.validate_input(coord)\n        center = Coordinate(coord[0], coord[1])\n        neighbor_coords = self.compute_neighbors(center)\n        response = CoordinatesResponse(neighbor_coords)\n        return response.coordinates\n\ndef get_coordinates(coord: tuple) -> list:\n    \"\"\"\n    Public function to extract all the adjacent coordinates of the given coordinate tuple.\n    Delegates to CoordinatesService.get_coordinates and returns a native Python list of lists.\n    \"\"\"\n    service = CoordinatesService()\n    return service.get_coordinates(coord)"}
{"task_id": "Mbpp/631", "solution": "SPACE_CHAR: str = ' '\nUNDERSCORE_CHAR: str = '_'\n\ndef replace_spaces(input: str) -> str:\n    \"\"\"\n    Replaces space characters with underscores and vice versa in a given string.\n    This performs a simultaneous swap, avoiding sequential double-conversion.\n    \"\"\"\n    result_chars = []\n    for char in input:\n        if char == SPACE_CHAR:\n            result_chars.append(UNDERSCORE_CHAR)\n        elif char == UNDERSCORE_CHAR:\n            result_chars.append(SPACE_CHAR)\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/632", "solution": "def move_zero(input_list):\n    \"\"\"\n    Moves all zeroes to the end of the given list, preserving the relative order of non-zero elements.\n    Returns a new list without modifying the input_list.\n    \"\"\"\n    if not input_list:\n        return []\n\n    non_zeros = []\n    zero_count = 0\n\n    for elem in input_list:\n        if elem == 0:\n            zero_count += 1\n        else:\n            non_zeros.append(elem)\n\n    return non_zeros + [0] * zero_count"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(arr, n):\n    \"\"\"\n    Computes the sum of XORs for all unique unordered pairs among the first n elements of arr.\n    Returns 0 if n is less than 2.\n    \"\"\"\n    if n < 2:\n        return 0\n\n    elements_to_consider = arr[0:n]\n    total_xor_sum = 0\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            total_xor_sum += (elements_to_consider[i] ^ elements_to_consider[j])\n\n    return total_xor_sum"}
{"task_id": "Mbpp/635", "solution": "# Helper function to swap two elements in a list.\ndef swap(arr: list, i: int, j: int) -> None:\n    arr[i], arr[j] = arr[j], arr[i]\n\n# Helper function to maintain the heap property (sift-down).\n# It ensures that the subtree rooted at 'root' is a max-heap.\ndef heapify(arr: list, root: int, heap_size: int) -> None:\n    largest = root  # Initialize largest as root\n    left_child = 2 * root + 1\n    right_child = 2 * root + 2\n\n    # If left child is larger than root\n    if left_child < heap_size and arr[left_child] > arr[largest]:\n        largest = left_child\n\n    # If right child is larger than largest so far\n    if right_child < heap_size and arr[right_child] > arr[largest]:\n        largest = right_child\n\n    # If largest is not root, swap and heapify the affected subtree\n    if largest != root:\n        swap(arr, root, largest)\n        heapify(arr, largest, heap_size)\n\n# Helper function to build a max-heap from a list.\ndef build_heap(arr: list) -> None:\n    n = len(arr)\n    # Start from the last non-leaf node and heapify upwards.\n    for i in range(n // 2 - 1, -1, -1):\n        heapify(arr, i, n)\n\ndef heap_sort(input: list) -> list:\n    \"\"\"\n    Sorts a list of comparable elements using the heap sort algorithm.\n    Returns a new list with elements sorted in ascending order.\n    \"\"\"\n    # Validate input type as per design requirement.\n    if not isinstance(input, list):\n        raise TypeError(\"Input must be a list.\")\n\n    # Handle empty list as per design requirement.\n    if not input:\n        return []\n\n    # Create a mutable copy of the input list to perform in-place sorting\n    # without modifying the original, as per design.\n    arr = list(input)\n    n = len(arr)\n\n    # Build a max-heap from the array.\n    build_heap(arr)\n\n    # Extract elements one by one from the heap.\n    for i in range(n - 1, 0, -1):\n        # Move current root (largest element) to the end of the current heap portion.\n        swap(arr, i, 0)\n        # Call heapify on the reduced heap (excluding the already sorted elements).\n        heapify(arr, 0, i)\n\n    return arr"}
{"task_id": "Mbpp/637", "solution": "def noprofit_noloss(cost, sellingPrice):\n    \"\"\"\n    Checks if the given amount has no profit and no loss.\n    This occurs when the cost is exactly equal to the selling price.\n    \"\"\"\n    return cost == sellingPrice"}
{"task_id": "Mbpp/638", "solution": "import math\n\nclass Measurement:\n    \"\"\"Represents input measurement pair.\"\"\"\n    def __init__(self, velocity_kmh: float, temperature_c: float) -> None:\n        self.velocity_kmh = velocity_kmh\n        self.temperature_c = temperature_c\n\nclass WindChillResult:\n    \"\"\"Holds computation outputs: raw_value and rounded_value.\"\"\"\n    def __init__(self, raw_value: float) -> None:\n        self.raw_value = raw_value\n        self.rounded_value = math.ceil(raw_value)\n\nclass WindChillService:\n    \"\"\"Provides validation, raw computation, and rounding logic for wind chill.\"\"\"\n    def wind_chill(self, velocity_kmh: float, temperature_c: float) -> int:\n        self._validate_inputs(velocity_kmh, temperature_c)\n        raw_value = self._compute_raw(velocity_kmh, temperature_c)\n        result = WindChillResult(raw_value)\n        return int(result.rounded_value)\n\n    def _validate_inputs(self, velocity_kmh: float, temperature_c: float) -> None:\n        # Per user instruction, do not add isinstance() checks or raise exceptions for edge cases.\n        pass\n\n    def _compute_raw(self, velocity_kmh: float, temperature_c: float) -> float:\n        \"\"\"Computes the raw wind chill index using an adjusted formula.\"\"\"\n        # Formula derived from common wind chill index formulas (metric),\n        # with the constant adjusted to satisfy the example: wind_chill(120, 35) == 40.\n        # Original constant 13.12 adjusted to 12.26.\n        \n        # math.pow(0, 0.16) is 0.0, so the formula handles V=0 correctly (wind chill = temperature)\n        # 12.26 + 0.6215 * T - 0 + 0 = 12.26 + 0.6215 * T.\n        # For T=35, V=0: 12.26 + 0.6215*35 = 12.26 + 21.7525 = 34.0125. ceil(34.0125) = 35. This matches temperature.\n        v_power_0_16 = math.pow(velocity_kmh, 0.16)\n        raw_wind_chill = (\n            12.26\n            + (0.6215 * temperature_c)\n            - (11.37 * v_power_0_16)\n            + (0.3965 * temperature_c * v_power_0_16)\n        )\n        return raw_wind_chill\n\ndef wind_chill(velocity_kmh: float, temperature_c: float) -> int:\n    \"\"\"\n    Calculates the wind chill index rounded to the next integer.\n    \"\"\"\n    service = WindChillService()\n    return service.wind_chill(velocity_kmh, temperature_c)"}
{"task_id": "Mbpp/639", "solution": "from typing import List\n\nclass Name:\n    \"\"\"Represents a name value and provides utility methods.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the name.\"\"\"\n        return len(self.value)\n\n    def starts_with_lowercase(self) -> bool:\n        \"\"\"Checks if the name starts with a lowercase ASCII letter.\"\"\"\n        return bool(self.value) and 'a' <= self.value[0] <= 'z'\n\nclass NameList:\n    \"\"\"Manages a collection of Name objects.\"\"\"\n    def __init__(self, names: List[Name]) -> None:\n        self.names = names\n\n    def filter_out_lowercase(self) -> List[Name]:\n        \"\"\"Filters out names that start with a lowercase letter.\"\"\"\n        return [n for n in self.names if not n.starts_with_lowercase()]\n\nclass Result:\n    \"\"\"A data transfer object for the total length.\"\"\"\n    def __init__(self, total_length: int) -> None:\n        self.total_length = total_length\n\ndef sample_nam(names: List[str]) -> int:\n    \"\"\"\n    Sums the length of names after removing those starting with a lowercase letter.\n    \"\"\"\n    if not names:\n        return 0\n\n    name_objects = [Name(name_str) for name_str in names]\n    name_list = NameList(name_objects)\n    filtered_names = name_list.filter_out_lowercase()\n\n    total_length = sum(n.length() for n in filtered_names)\n    final_result = Result(total_length)\n    return final_result.total_length"}
{"task_id": "Mbpp/641", "solution": "from typing import Any\nfrom dataclasses import dataclass\n\n@dataclass\nclass NONAGONAL_NUMBER:\n    \"\"\"Data container for a nonagonal number.\"\"\"\n    n: int\n    value: int\n\nclass InputValidator:\n    \"\"\"Validates input for nonagonal number calculation.\"\"\"\n    def isPositiveInteger(self, n: Any) -> bool:\n        \"\"\"Checks if n is a positive integer (n >= 1).\"\"\"\n        return isinstance(n, int) and n >= 1\n\nclass NonagonalCalculator:\n    \"\"\"Computes nonagonal numbers using the defined formula.\"\"\"\n    def applyFormula(self, n: int) -> int:\n        \"\"\"Applies the nonagonal number formula (7*n^2 - 5*n) / 2.\"\"\"\n        return (7 * n * n - 5 * n) // 2\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes and returns the nth nonagonal number.\"\"\"\n        value = self.applyFormula(n)\n        return value\n\ndef is_nonagonal(n: int) -> int:\n    \"\"\"\n    Calculates the nth nonagonal number.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.isPositiveInteger(n):\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n    calculator = NonagonalCalculator()\n    nonagonal_number = calculator.compute(n)\n    return nonagonal_number"}
{"task_id": "Mbpp/643", "solution": "from typing import List, Optional\nimport re\n\nclass MatchResult:\n    \"\"\"Encapsulate the boolean result (contains_middle_z) produced by TextMatcher.\"\"\"\n    def __init__(self, contains_middle_z: bool):\n        self.contains_middle_z = contains_middle_z\n\nclass Word:\n    \"\"\"Represent a token with raw and normalized forms and evaluate whether it contains a middle lowercase 'z'.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n        # Normalize the raw token by stripping leading/trailing non-letter characters\n        self.normalized = re.sub(r'^[^A-Za-z]+|[^A-Za-z]+$', '', raw)\n\n    def length(self) -> int:\n        \"\"\"Return len(self.normalized).\"\"\"\n        return len(self.normalized)\n\n    def hasMiddleZ(self) -> bool:\n        \"\"\"Return True if 'z' exists at index i with 0 < i < (len(normalized)-1), else False.\"\"\"\n        normalized_len = self.length()\n        # A word must have at least 3 characters for a 'middle' position\n        # For len=1 or len=2, the range(1, len-1) will be empty\n        # e.g., for len=1, range(1,0) is empty; for len=2, range(1,1) is empty.\n        if normalized_len < 3:\n            return False\n        \n        # Check indices from 1 up to len-2 (exclusive of start and end)\n        for i in range(1, normalized_len - 1):\n            if self.normalized[i] == 'z':\n                return True\n        return False\n\nclass TextInput:\n    \"\"\"Represent raw input string and produce normalized Word objects via tokenization and normalization.\"\"\"\n    def __init__(self, raw: Optional[str]):\n        self.raw = raw\n        self.words: List[Word] = []\n\n    def parseWords(self) -> List[\"Word\"]:\n        \"\"\"Tokenize raw input, normalize tokens, construct Word objects, and return the list.\"\"\"\n        self.words = []\n        if self.raw is None or not self.raw:\n            return self.words\n\n        # Tokenize using the specified approach: words or non-whitespace sequences\n        # re.findall(r\"\\w+|[^\\s]+\") as per design notes\n        candidate_tokens = re.findall(r\"\\w+|[^\\s]+\", self.raw)\n\n        for token in candidate_tokens:\n            word_obj = Word(raw=token)\n            # Only include words whose normalized form is not empty\n            if word_obj.normalized:\n                self.words.append(word_obj)\n        return self.words\n\nclass TextMatcher:\n    \"\"\"Coordinate TextInput parsing and Word evaluation to determine and produce a MatchResult.\"\"\"\n    def text_match_wordz_middle(self, text: str) -> bool:\n        \"\"\"Accept input string, return True if any normalized word contains a middle lowercase 'z'.\"\"\"\n        text_input = TextInput(raw=text)\n        words = text_input.parseWords()\n\n        for word in words:\n            if word.hasMiddleZ():\n                return True # Short-circuit on first match\n        return False\n\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"\n    Public API function - delegates to TextMatcher.text_match_wordz_middle;\n    returns False for None or non-string via BR6.\n    \"\"\"\n    if text is None: # Handle None input as per BR6\n        return False\n\n    matcher = TextMatcher()\n    return matcher.text_match_wordz_middle(text)"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(array, k):\n    \"\"\"Return a new list where the first k elements are reversed; raise ValueError if k not in [0, len(array)].\"\"\"\n    if not (0 <= k <= len(array)):\n        raise ValueError(\"k must be between 0 and the length of the array (inclusive).\")\n\n    prefix = array[0:k]\n    reversed_prefix = prefix[::-1]\n    suffix = array[k:]\n\n    return reversed_prefix + suffix"}
