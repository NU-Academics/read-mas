{"task_id": "Mbpp/723", "solution": "def count_same_pair(listA, listB) -> int:\n    \"\"\"\n    Validate that len(listA) == len(listB). If not, raise ValueError.\n    Iterate index-by-index using equality operator (==) and accumulate matches.\n    Preserve input lists (no mutation). Return integer match count.\n    \"\"\"\n    if len(listA) != len(listB):\n        raise ValueError(\"count_same_pair: input lists must have equal length\")\n    count = 0\n    for i in range(len(listA)):\n        if listA[i] == listB[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/721", "solution": "from typing import List, Union\n\nclass Matrix:\n    \"\"\"Represents the input matrix with its dimensions.\"\"\"\n    def __init__(self, raw: List[List[Union[int, float]]]):\n        self.raw: List[List[float]] = [[float(val) for val in row] for row in raw]\n        self.N: int = len(raw) if raw else 0\n\nclass Cell:\n    \"\"\"Represents a single cell in the matrix.\"\"\"\n    def __init__(self, row: int, col: int, cost: float):\n        self.row: int = row\n        self.col: int = col\n        self.cost: float = cost\n\nclass Path:\n    \"\"\"Represents a path through the matrix.\"\"\"\n    def __init__(self, cells: List[Cell]):\n        self.cells: List[Cell] = cells\n\n    def sum(self) -> float:\n        \"\"\"Calculates the total cost of the path.\"\"\"\n        return sum(cell.cost for cell in self.cells)\n\n    def length(self) -> int:\n        \"\"\"Returns the number of cells in the path.\"\"\"\n        return len(self.cells)\n\n    def average(self) -> float:\n        \"\"\"Calculates the average cost of the path.\"\"\"\n        path_length = self.length()\n        return self.sum() / path_length if path_length > 0 else 0.0\n\nclass Validator:\n    \"\"\"Validates properties of a Matrix object.\"\"\"\n    def isNonEmpty(self, m: Matrix) -> bool:\n        \"\"\"Checks if the matrix is non-empty.\"\"\"\n        return m.N > 0 and (m.raw and len(m.raw[0]) > 0)\n\n    def isSquare(self, m: Matrix) -> bool:\n        \"\"\"Checks if the matrix is square.\"\"\"\n        if m.N == 0:\n            return True\n        return all(len(row) == m.N for row in m.raw)\n\nclass PathFinder:\n    \"\"\"Finds paths and computes their maximum average.\"\"\"\n    def findAll(self, m: Matrix) -> List[Path]:\n        \"\"\"Enumerates all valid paths (not used by findMaxAverage in this optimized approach).\"\"\"\n        paths: List[Path] = []\n        if m.N == 0:\n            return []\n\n        def dfs(r, c, current_path_cells):\n            current_path_cells.append(Cell(r, c, m.raw[r][c]))\n            if r == m.N - 1 and c == m.N - 1:\n                paths.append(Path(list(current_path_cells)))\n                current_path_cells.pop()\n                return\n\n            if c + 1 < m.N:\n                dfs(r, c + 1, current_path_cells)\n            if r + 1 < m.N:\n                dfs(r + 1, c, current_path_cells)\n\n            current_path_cells.pop()\n\n        dfs(0, 0, [])\n        return paths\n\n    def findMaxAverage(self, m: Matrix) -> float:\n        \"\"\"\n        Finds the maximum average path cost using dynamic programming.\n        Since all valid paths have a fixed length (2N-1), this is equivalent to finding the maximum path sum.\n        \"\"\"\n        if m.N == 0:\n            return 0.0\n        \n        dp: List[List[float]] = [[0.0] * m.N for _ in range(m.N)]\n\n        dp[0][0] = m.raw[0][0]\n\n        for c in range(1, m.N):\n            dp[0][c] = dp[0][c-1] + m.raw[0][c]\n\n        for r in range(1, m.N):\n            dp[r][0] = dp[r-1][0] + m.raw[r][0]\n\n        for r in range(1, m.N):\n            for c in range(1, m.N):\n                dp[r][c] = m.raw[r][c] + max(dp[r-1][c], dp[r][c-1])\n\n        max_sum = dp[m.N-1][m.N-1]\n        path_length = (2 * m.N) - 1\n\n        return max_sum / path_length if path_length > 0 else 0.0\n\ndef maxAverageOfPath(matrix: List[List[Union[int, float]]]) -> float:\n    \"\"\"\n    Given a square matrix, find a path from top-left to bottom-right, moving only right or down,\n    that has the maximum average cost (total cost / number of cells).\n    \"\"\"\n    m = Matrix(raw=matrix)\n    v = Validator()\n    if not v.isNonEmpty(m) or not v.isSquare(m):\n        raise ValueError('Input must be a non-empty square matrix')\n    if m.N == 1:\n        return float(m.raw[0][0])\n    pf = PathFinder()\n    return float(pf.findMaxAverage(m))"}
{"task_id": "Mbpp/724", "solution": "class ErrorCondition(Exception):\n    \"\"\"Structured error for validation or computation failures.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\nclass CalculationRequest:\n    \"\"\"Represents caller's request (base, power) and validates inputs.\"\"\"\n    def __init__(self, base: int, power: int):\n        self.base = base\n        self.power = power\n\n    def validate(self):\n        \"\"\"Validates that base and power are integers and power is non-negative.\"\"\"\n        if not isinstance(self.base, int):\n            raise ErrorCondition(f\"Base must be an integer, but got {type(self.base).__name__}.\")\n        if not isinstance(self.power, int):\n            raise ErrorCondition(f\"Power must be an integer, but got {type(self.power).__name__}.\")\n        if self.power < 0:\n            raise ErrorCondition(\"Power must be a non-negative integer.\")\n\nclass PowerComputation:\n    \"\"\"Performs base**power as exact arbitrary-precision integer.\"\"\"\n    @staticmethod\n    def compute(base: int, power: int) -> int:\n        \"\"\"Computes and returns Python int representing base**power.\"\"\"\n        try:\n            return base ** power\n        except Exception as e:\n            raise ErrorCondition(f\"An unexpected computation error occurred: {e}\")\n\nclass DigitSum:\n    \"\"\"Computes decimal-digit sum of an integer.\"\"\"\n    @staticmethod\n    def sumDigits(value: int) -> int:\n        \"\"\"Operates on absolute(value), converts to decimal representation, sums decimal digits.\"\"\"\n        s = str(abs(value))\n        digit_sum = 0\n        for digit_char in s:\n            digit_sum += int(digit_char)\n        return digit_sum\n\nclass Result:\n    \"\"\"Encapsulates final digitSum to return to caller.\"\"\"\n    def __init__(self, digit_sum: int):\n        self.digitSum = digit_sum\n\ndef power_base_sum(base, power):\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    This function orchestrates input validation, arbitrary-precision exponentiation,\n    and decimal-digit summation of the absolute result.\n    \"\"\"\n    request = CalculationRequest(base, power)\n    request.validate()\n\n    computed_value = PowerComputation.compute(request.base, request.power)\n\n    digit_sum_result = DigitSum.sumDigits(computed_value)\n\n    result_obj = Result(digit_sum_result)\n    return result_obj.digitSum"}
{"task_id": "Mbpp/725", "solution": "import typing\n\nclass InputString:\n    \"\"\"Lightweight wrapper around raw input string and its length for indexing and scanning.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw = raw\n        self.length = len(raw)\n\nclass ExtractedSubstring:\n    \"\"\"Represents a single extracted substring with its value and original indices.\"\"\"\n    def __init__(self, value: str, start_index: int, end_index: int) -> None:\n        self.value = value\n        self.start_index = start_index\n        self.end_index = end_index\n\nclass ResultList:\n    \"\"\"Collects ExtractedSubstring items and converts them to a list of strings.\"\"\"\n    def __init__(self) -> None:\n        self.items: typing.List[ExtractedSubstring] = []\n\n    def append(self, extracted: ExtractedSubstring) -> None:\n        self.items.append(extracted)\n\n    def to_list(self) -> typing.List[str]:\n        return [item.value for item in self.items]\n\nclass QuotationExtractor:\n    \"\"\"Encapsulates the algorithm for scanning and extracting content between double quotes.\"\"\"\n    def extract_quotation(self, input_string: str) -> typing.List[str]:\n        input_obj = InputString(input_string)\n        result_list = ResultList()\n\n        quote_indices: typing.List[int] = []\n        for i in range(input_obj.length):\n            if input_obj.raw[i] == '\"':\n                quote_indices.append(i)\n\n        # Pair quote positions and extract substrings between each complete pair.\n        for i in range(0, len(quote_indices) - 1, 2):\n            start_quote_idx = quote_indices[i]\n            end_quote_idx = quote_indices[i+1]\n\n            # The substring is between the quotes, excluding the quotes themselves.\n            substring_start = start_quote_idx + 1\n            substring_end = end_quote_idx\n            \n            extracted_value = input_obj.raw[substring_start:substring_end]\n            extracted_obj = ExtractedSubstring(extracted_value, substring_start, substring_end)\n            result_list.append(extracted_obj)\n\n        return result_list.to_list()\n\ndef extract_quotation(input: str) -> typing.List[str]:\n    \"\"\"Extracts values between double quotation marks from the given string.\"\"\"\n    extractor = QuotationExtractor()\n    return extractor.extract_quotation(input)"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Computes the product of consecutive elements in a tuple of numbers.\n    The output tuple's i-th element is the product of input_tuple[i] and input_tuple[i+1].\n    \"\"\"\n    products = [input_tuple[i] * input_tuple[i+1] for i in range(len(input_tuple) - 1)]\n    return tuple(products)"}
{"task_id": "Mbpp/731", "solution": "from math import pi, sqrt\n\nclass Cone:\n    def __init__(self, radius: float, height: float):\n        self.radius = radius\n        self.height = height\n\n    def slantHeight(self) -> float:\n        return sqrt(self.radius**2 + self.height**2)\n\n    def lateralSurfaceArea(self) -> float:\n        return pi * self.radius * self.slantHeight()\n\nclass CalculationResult:\n    def __init__(self, value: float, units: str = 'unitless'):\n        self.value = value\n        self.units = units\n\ndef lateralsurface_cone(r, h) -> float:\n    \"\"\"Return lateral surface area computed as pi * r * sqrt(r**2 + h**2).\"\"\"\n    cone = Cone(r, h)\n    return cone.lateralSurfaceArea()"}
{"task_id": "Mbpp/728", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid inputs to sum_list.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return self.message\n\ndef _validate_lists(a, b) -> int:\n    \"\"\"Validates inputs for sum_list: checks types, element types, and lengths.\"\"\"\n    if not isinstance(a, list) or not isinstance(b, list):\n        raise ValidationError(\"non-list input: Both inputs must be lists.\")\n\n    if len(a) != len(b):\n        raise ValidationError(\"unequal lengths: Input lists must have the same length.\")\n\n    for i in range(len(a)):\n        if not isinstance(a[i], (int, float)):\n            raise ValidationError(f\"non-numeric element: Element at index {i} in list 'a' is not numeric.\")\n        if not isinstance(b[i], (int, float)):\n            raise ValidationError(f\"non-numeric element: Element at index {i} in list 'b' is not numeric.\")\n            \n    return len(a)\n\ndef sum_list(a, b):\n    \"\"\"\n    Takes two lists of numbers and returns a new list containing their element-wise sum.\n    Raises ValidationError for invalid inputs (non-list, non-numeric elements, unequal lengths).\n    \"\"\"\n    n = _validate_lists(a, b)\n    \n    if n == 0:\n        return []\n\n    result = [a[i] + b[i] for i in range(n)]\n    return result"}
{"task_id": "Mbpp/730", "solution": "from typing import List\n\ndef consecutive_duplicates(input_list: List) -> List:\n    \"\"\"Removes consecutive duplicates from a list, preserving order and non-consecutive duplicates.\"\"\"\n    output = []\n    for item in input_list:\n        if not output or item != output[-1]:\n            output.append(item)\n    return output"}
{"task_id": "Mbpp/732", "solution": "class CharacterProcessor:\n    \"\"\"Helper class to encapsulate character mapping logic.\"\"\"\n    def map(self, c: str) -> str:\n        if c in {' ', ',', '.'}:\n            return ':'\n        return c\n\ndef replace_specialchar(input: str) -> str:\n    \"\"\"Replaces spaces, commas, or dots with a colon in the input string.\"\"\"\n    processor = CharacterProcessor()\n    result_chars = [processor.map(c) for c in input]\n    return ''.join(result_chars)"}
{"task_id": "Mbpp/733", "solution": "class SortedArray:\n    \"\"\"\n    Wrapper representing the input array with explicit accessors used by OccurrenceFinder.\n    \"\"\"\n    def __init__(self, values: list):\n        self.values = values\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the underlying array.\"\"\"\n        return len(self.values)\n\n    def get(self, index: int):\n        \"\"\"Returns the element at the specified index.\"\"\"\n        return self.values[index]\n\nclass SearchResult:\n    \"\"\"\n    Data holder for a search outcome.\n    \"\"\"\n    def __init__(self, index: int):\n        self.index = index\n        self.found = (index != -1)\n\n    def is_found(self) -> bool:\n        \"\"\"Returns true if the target was found, false otherwise.\"\"\"\n        return self.found\n\nclass OccurrenceFinder:\n    \"\"\"\n    Implements the leftmost binary search algorithm and exposes the find_first_occurrence operation.\n    \"\"\"\n    def find_first_occurrence(self, arr: list, target) -> int:\n        \"\"\"\n        Wraps the input array and delegates to the leftmost binary search.\n        \"\"\"\n        sorted_array = SortedArray(arr)\n        return self.binary_search_leftmost(sorted_array, target)\n\n    def binary_search_leftmost(self, arr_wrapper: SortedArray, target) -> int:\n        \"\"\"\n        Performs an iterative left-biased binary search to find the first occurrence.\n        \"\"\"\n        low = 0\n        high = arr_wrapper.length() - 1\n        result_index = -1\n\n        while low <= high:\n            mid = low + (high - low) // 2\n            mid_val = arr_wrapper.get(mid)\n\n            if mid_val == target:\n                result_index = mid\n                high = mid - 1  # Continue searching in the left half for an earlier occurrence\n            elif mid_val < target:\n                low = mid + 1\n            else: # mid_val > target\n                high = mid - 1\n        return result_index\n\ndef find_first_occurrence(arr, target) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array.\n    \"\"\"\n    finder = OccurrenceFinder()\n    return finder.find_first_occurrence(arr, target)"}
{"task_id": "Mbpp/734", "solution": "from typing import Iterator, Tuple, List\n\ndef _product_of_subarray(subarray: list) -> float:\n    \"\"\"Computes the product of all elements in a given subarray.\"\"\"\n    product = 1.0\n    for item in subarray:\n        product *= item\n    return product\n\ndef _generate_subarrays(inputList: list) -> Iterator[Tuple[int, int, list]]:\n    \"\"\"Yields (startIndex, endIndex, elements slice) for all non-empty contiguous subarrays.\"\"\"\n    n = len(inputList)\n    for i in range(n):\n        for j in range(i, n):\n            yield (i, j, inputList[i:j+1])\n\ndef sum_Of_Subarray_Prod(inputList: list) -> float:\n    \"\"\"Compute and return the sum of products of all non-empty contiguous subarrays of inputList.\"\"\"\n    total_sum_of_products = 0.0\n    for _, _, subarray in _generate_subarrays(inputList):\n        product = _product_of_subarray(subarray)\n        total_sum_of_products += product\n    return total_sum_of_products"}
{"task_id": "Mbpp/735", "solution": "def _int_to_bits(n: int) -> str:\n    \"\"\"Return canonical binary string for non-negative integer n (e.g., 9 -> '1001').\"\"\"\n    return bin(n)[2:]\n\ndef _flip_middle_bits(bits: str) -> str:\n    \"\"\"Return bits with all characters except first and last flipped.\"\"\"\n    if len(bits) < 3:\n        return bits\n    first_bit = bits[0]\n    middle_bits = bits[1:-1]\n    last_bit = bits[-1]\n    flipped_middle = ''.join('1' if b == '0' else '0' for b in middle_bits)\n    return first_bit + flipped_middle + last_bit\n\ndef _bits_to_int(bits: str) -> int:\n    \"\"\"Convert binary string to integer (e.g., '1111' -> 15).\"\"\"\n    return int(bits, 2)\n\ndef toggle_middle_bits(n: int) -> int:\n    \"\"\"Toggle (flip) all bits of integer n except the MSB and LSB and return resulting integer.\n\n    If n < 4 (binary length < 3), return n unchanged.\n    \"\"\"\n    bits_str = _int_to_bits(n)\n\n    if len(bits_str) < 3:\n        return n\n\n    flipped_bits_str = _flip_middle_bits(bits_str)\n    return _bits_to_int(flipped_bits_str)"}
{"task_id": "Mbpp/736", "solution": "from typing import Sequence\n\ndef left_insertion(sorted_list: Sequence, value) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted sequence.\n    Returns the index where the value can be inserted to maintain sorted order,\n    such that all elements to the left are less than the value, and all\n    elements to the right are greater than or equal to the value.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = low + (high - low) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/737", "solution": "import re\n\n_REGEX_PATTERN: str = r'^[aeiou]'\n_COMPILED_REGEX = re.compile(_REGEX_PATTERN)\n\ndef check_str(s: str) -> bool:\n    \"\"\"Return True if 's' starts with one of {a,e,i,o,u} using anchored regex '^[aeiou]'.\n    Matches are case-sensitive to lowercase vowels.\n    \"\"\"\n    return _COMPILED_REGEX.match(s) is not None"}
{"task_id": "Mbpp/740", "solution": "class Validator:\n    \"\"\"Class for validating input types and tuple lengths.\n    It raises TypeError for non-tuple inputs and ValueError for odd-length tuples.\"\"\"\n    def validateType(self, input):\n        \"\"\"Raise TypeError if input is not a tuple (BR2/FR4).\"\"\"\n        if not isinstance(input, tuple):\n            raise TypeError(\"input must be a tuple\")\n        return None\n\n    def validateEvenLength(self, input):\n        \"\"\"Raise ValueError if tuple length is odd (BR3/FR4).\"\"\"\n        if len(input) % 2 != 0:\n            raise ValueError(\"tuple length must be even (pairs required)\")\n        return None\n\ndef tuple_to_dict(input_tuple) -> dict:\n    \"\"\"Converts an even-length tuple into a dict using adjacent elements as key/value pairs.\n    Raises TypeError if input is not a tuple, or ValueError if tuple length is odd.\"\"\"\n    validator = Validator()\n    validator.validateType(input_tuple)\n    validator.validateEvenLength(input_tuple)\n\n    result = {}\n    for i in range(0, len(input_tuple), 2):\n        key = input_tuple[i]\n        value = input_tuple[i + 1]\n        result[key] = value\n    return result"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(input_string: str) -> bool:\n    \"\"\"Return True iff every character in input_string is identical to every other. Returns True for empty or single-character strings.\"\"\"\n    if len(input_string) <= 1:\n        return True\n    return len(set(input_string)) == 1"}
{"task_id": "Mbpp/739", "solution": "class InputValidator:\n    def validate(self, n) -> None:\n        \"\"\"Validates that n is a positive integer.\"\"\"\n        if not isinstance(n, int) or n < 1:\n            raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\nclass TriangularNumber:\n    def __init__(self, k: int):\n        self.k = k\n    \n    def computeValue(self) -> int:\n        \"\"\"Computes the k-th triangular number.\"\"\"\n        return self.k * (self.k + 1) // 2\n\nclass DigitCounter:\n    def countDigits(self, value: int) -> int:\n        \"\"\"Counts the base-10 digits of a positive integer value.\"\"\"\n        return len(str(value))\n\nclass IndexFinder:\n    def find_Index(self, n: int) -> int:\n        \"\"\"Delegates validation and search for the smallest index k.\"\"\"\n        validator = InputValidator()\n        validator.validate(n)\n        return self.findSmallestIndexForDigits(n)\n\n    def findSmallestIndexForDigits(self, n: int) -> int:\n        \"\"\"Iteratively searches for the smallest index k with n digits.\"\"\"\n        k = 1\n        while True:\n            triangular_num_instance = TriangularNumber(k)\n            value = triangular_num_instance.computeValue()\n            \n            digit_counter = DigitCounter()\n            digits = digit_counter.countDigits(value)\n            \n            if digits == n:\n                return k\n            k += 1\n\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    This function delegates the task to an internal IndexFinder.\n    \"\"\"\n    finder = IndexFinder()\n    return finder.find_Index(n)"}
