{"task_id": "Mbpp/622", "solution": "from typing import List, Tuple\n\nclass List:\n    \"\"\"A wrapper for a sequence of numeric elements with a derived length.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = [float(e) for e in elements]\n        self.length = len(self.elements)\n\nclass Validator:\n    \"\"\"Provides methods to validate properties of lists.\"\"\"\n    def validate_sorted(self, list_obj: 'List') -> bool:\n        \"\"\"Checks if the elements in a List object are sorted in non-decreasing order.\"\"\"\n        return all(list_obj.elements[i] <= list_obj.elements[i+1] for i in range(list_obj.length - 1))\n\n    def validate_length(self, list1: 'List', list2: 'List', n: int) -> bool:\n        \"\"\"Checks if both List objects have the expected length n.\"\"\"\n        return list1.length == n and list2.length == n\n\nclass Merger:\n    \"\"\"Handles merging sorted lists and finding middle elements.\"\"\"\n    def merge_sorted(self, list1: 'List', list2: 'List') -> List[float]:\n        \"\"\"Merges two sorted List objects into a single sorted list of floats.\"\"\"\n        merged = []\n        i, j = 0, 0\n        while i < list1.length and j < list2.length:\n            if list1.elements[i] <= list2.elements[j]:\n                merged.append(list1.elements[i])\n                i += 1\n            else:\n                merged.append(list2.elements[j])\n                j += 1\n        while i < list1.length:\n            merged.append(list1.elements[i])\n            i += 1\n        while j < list2.length:\n            merged.append(list2.elements[j])\n            j += 1\n        return merged\n\n    def find_middle_two(self, merged: List[float], n: int) -> Tuple[float, float]:\n        \"\"\"Finds the two middle values from a merged list of 2n elements.\"\"\"\n        return merged[n - 1], merged[n]\n\ndef _to_List(seq) -> List:\n    \"\"\"Converts a raw Python sequence to a domain List object.\"\"\"\n    return List(seq)\n\ndef get_median(list1, list2, n) -> float:\n    \"\"\"Compute and return median of two sorted lists of equal length n.\n\n    Args:\n        list1: sequence of numeric values.\n        list2: sequence of numeric values.\n        n: int expected length of each list.\n\n    Returns:\n        float: median of combined sorted sequence (average of two middle values for 2n elements).\n\n    Raises:\n        ValueError: if inputs are invalid (unsorted or length mismatch).\n    \"\"\"\n    list1_obj = _to_List(list1)\n    list2_obj = _to_List(list2)\n\n    validator = Validator()\n    if not validator.validate_length(list1_obj, list2_obj, n):\n        raise ValueError(\"invalid input: length mismatch\")\n    if not validator.validate_sorted(list1_obj):\n        raise ValueError(\"invalid input: list1 not sorted\")\n    if not validator.validate_sorted(list2_obj):\n        raise ValueError(\"invalid input: list2 not sorted\")\n\n    merger = Merger()\n    merged_list = merger.merge_sorted(list1_obj, list2_obj)\n    left_mid, right_mid = merger.find_middle_two(merged_list, n)\n\n    return (left_mid + right_mid) / 2.0"}
{"task_id": "Mbpp/626", "solution": "def triangle_area(radius):\n    \"\"\"\n    Calculates the area of the largest triangle that can be inscribed in a semicircle.\n    Returns None for negative radius, 0.0 for radius 0, and radius^2 for positive radius.\n    \"\"\"\n    if radius < 0:\n        return None\n    elif radius == 0:\n        return 0.0\n    else:\n        # The largest triangle inscribed in a semicircle has its base along the diameter\n        # and its apex at any point on the arc. The base length is 2*radius, and the\n        # maximum height is radius. Area = 0.5 * base * height = 0.5 * (2*radius) * radius = radius^2.\n        return float(radius**2)"}
{"task_id": "Mbpp/623", "solution": "from typing import List, Union, Iterable\n\nclass Number:\n    \"\"\"Encapsulates a numeric value and provides power(n) returning a new Number.\"\"\"\n    def __init__(self, value: Union[int, float]) -> None:\n        # Value is stored as float for consistent power operations.\n        self.value = float(value)\n\n    def power(self, n: int) -> 'Number':\n        \"\"\"Computes the n-th power of the number.\"\"\"\n        return Number(self.value ** n)\n\nclass NumberList:\n    \"\"\"Represents an ordered collection of Number objects and provides accessors.\"\"\"\n    def __init__(self, elements: List[Number]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\n    def get(self, index: int) -> Number:\n        \"\"\"Returns the Number object at the specified index.\"\"\"\n        return self.elements[index]\n\n    def to_plain_list(self) -> List[float]:\n        \"\"\"Converts the NumberList to a plain Python list of numeric values.\"\"\"\n        return [num.value for num in self.elements]\n\nclass PowerOperation:\n    \"\"\"Holds exponent and applies exponentiation to Number instances.\"\"\"\n    def __init__(self, exponent: int) -> None:\n        self.exponent = exponent\n\n    def apply(self, num: Number) -> Number:\n        \"\"\"Applies the exponentiation to a Number object.\"\"\"\n        return num.power(self.exponent)\n\nclass _NthNumsDomain:\n    \"\"\"Orchestrates applying PowerOperation to the elements of a NumberList.\"\"\"\n    def execute(self, input_list_obj: NumberList, n: int) -> NumberList:\n        \"\"\"Executes element-wise exponentiation on a NumberList.\"\"\"\n        power_op = PowerOperation(n)\n        transformed_elements = []\n        for i in range(input_list_obj.length()):\n            num = input_list_obj.get(i)\n            transformed_num = power_op.apply(num)\n            transformed_elements.append(transformed_num)\n        return NumberList(transformed_elements)\n\ndef nth_nums(input_list: Iterable[Union[int, float]], n: int) -> List[float]:\n    \"\"\"\n    Computes the n-th power of each number in a list.\n    \"\"\"\n    # Input validation as per FR-8 / BR-10\n    if not isinstance(input_list, Iterable):\n        raise TypeError(\"Input 'input_list' must be an iterable.\")\n    if isinstance(input_list, (str, bytes)):\n        raise TypeError(\"Input 'input_list' cannot be a string or bytes object.\")\n\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' (exponent) must be an integer.\")\n\n    # FR-5: Return an empty list for an empty input list.\n    if not input_list:\n        return []\n\n    # Construct NumberList from input_list (wrapping each element in Number)\n    number_elements = []\n    for item in input_list:\n        if not isinstance(item, (int, float)):\n            raise TypeError(f\"List elements must be numeric (int or float), got {type(item).__name__}.\")\n        number_elements.append(Number(item))\n    input_number_list = NumberList(number_elements)\n\n    # Delegate to domain-class nth_nums.execute\n    domain_processor = _NthNumsDomain()\n    result_number_list = domain_processor.execute(input_number_list, n)\n\n    # Convert transformed NumberList to a plain list via to_plain_list() and return it.\n    return result_number_list.to_plain_list()"}
