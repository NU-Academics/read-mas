{"task_id": "Mbpp/138", "solution": "def _validate_and_coerce(n):\n    \"\"\"\n    Validates and coerces input to an integer, raising TypeError for invalid types.\n    \"\"\"\n    if isinstance(n, int):\n        return n\n    elif isinstance(n, float):\n        if n.is_integer():\n            return int(n)\n        else:\n            raise TypeError(\"Input must be an integer or an integral float.\")\n    else:\n        raise TypeError(\"Input must be an integer or an integral float.\")\n\ndef _generate_powers_up_to(n):\n    \"\"\"\n    Generates an ascending list of positive powers of two (2^k) up to n.\n    \"\"\"\n    powers = []\n    current_power = 1\n    while current_power <= n:\n        powers.append(current_power)\n        current_power *= 2\n    return powers\n\ndef is_Sum_Of_Powers_Of_Two(n):\n    \"\"\"\n    Checks if the given number can be represented as a sum of powers of 2 where the exponents are strictly greater than 0 (i.e., excluding 2^0 = 1).\n    \"\"\"\n    num = _validate_and_coerce(n)\n\n    if num <= 0:\n        return False\n\n    # Perform binary decomposition / greedy subtraction to find the constituent powers of two.\n    # The interpretation of \"non-zero powers of 2\" here implies exponents k > 0,\n    # meaning 2^0 (which is 1) is not allowed in the sum.\n    \n    powers_list = _generate_powers_up_to(num)\n    \n    remaining_num = num\n    used_powers = []\n    \n    # Iterate through powers in descending order to perform greedy subtraction.\n    for p in reversed(powers_list):\n        if remaining_num >= p:\n            remaining_num -= p\n            used_powers.append(p)\n            \n    # If after decomposition, `remaining_num` is not zero, it means the number could not be\n    # fully decomposed into powers of two, which should not happen for positive integers\n    # if 2^0 is allowed. Given num > 0, this scenario implies an internal inconsistency\n    # if 2^0 were allowed. With `_generate_powers_up_to` returning powers up to `num`,\n    # and `num` being positive, `remaining_num` will always be 0 here.\n\n    # Check if 2^0 (which is 1) was used in the decomposition. If it was,\n    # the number cannot be represented by powers with exponents > 0.\n    return 1 not in used_powers"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(input_iterable):\n    \"\"\"Accepts an outer iterable of inner iterables and returns a set of unique numeric elements.\"\"\"\n    def is_numeric(value) -> bool:\n        \"\"\"Returns True if value is numeric (int or float) and should be included in result set.\"\"\"\n        return isinstance(value, (int, float))\n\n    result_set = set()\n    for inner_iterable in input_iterable:\n        for element in inner_iterable:\n            if is_numeric(element):\n                result_set.add(element)\n    return result_set"}
{"task_id": "Mbpp/141", "solution": "from typing import Sequence, TypeVar\n\n# T represents a comparable type\nT = TypeVar('T')\n\nclass Element:\n    \"\"\"\n    Wraps a comparable value and provides compareTo(other: Element).\n    \"\"\"\n    def __init__(self, value: T):\n        self._value = value\n\n    def compareTo(self, other: 'Element') -> int:\n        \"\"\"\n        Returns negative if self < other, zero if equal, positive if self > other.\n        \"\"\"\n        if self._value < other._value:\n            return -1\n        elif self._value == other._value:\n            return 0\n        else:\n            return 1\n    \n    # Python comparison operators for convenience and potential internal use\n    def __eq__(self, other):\n        if not isinstance(other, Element):\n            return NotImplemented\n        return self._value == other._value\n\n    def __lt__(self, other):\n        if not isinstance(other, Element):\n            return NotImplemented\n        return self._value < other._value\n\n    def __repr__(self):\n        return f\"Element({self._value!r})\"\n\nclass List:\n    \"\"\"\n    Ordered collection of Element instances with indexed access/mutation.\n    \"\"\"\n    def __init__(self, elements: list[Element]):\n        self._elements = elements\n\n    def length(self) -> int:\n        return len(self._elements)\n\n    def get(self, i: int) -> Element:\n        return self._elements[i]\n\n    def set(self, i: int, value: Element) -> None:\n        self._elements[i] = value\n\ndef list_from_sequence(seq: Sequence[T]) -> List:\n    \"\"\"\n    Creates a List of Element instances from a native Python sequence.\n    \"\"\"\n    return List([Element(item) for item in seq])\n\ndef sequence_from_list(list_obj: List) -> list[T]:\n    \"\"\"\n    Extracts underlying values from Element wrappers in a List.\n    \"\"\"\n    return [list_obj.get(i)._value for i in range(list_obj.length())]\n\nclass PancakeSorter:\n    \"\"\"\n    Implements pancake sorting algorithm and orchestrates flips to sort a List.\n    \"\"\"\n    def find_max_index(self, list_obj: List, n: int) -> int:\n        \"\"\"\n        Return index of maximum Element among first n elements (0-based).\n        \"\"\"\n        max_element_idx = 0\n        for i in range(1, n):\n            if list_obj.get(i).compareTo(list_obj.get(max_element_idx)) > 0:\n                max_element_idx = i\n        return max_element_idx\n\n    def flip(self, list_obj: List, k: int) -> None:\n        \"\"\"\n        Reverse the order of first k elements; modifies list in place.\n        \"\"\"\n        start = 0\n        end = k - 1\n        while start < end:\n            temp = list_obj.get(start)\n            list_obj.set(start, list_obj.get(end))\n            list_obj.set(end, temp)\n            start += 1\n            end -= 1\n\n    def pancake_sort(self, list_obj: List) -> List:\n        \"\"\"\n        Sort provided List in non-decreasing order using pancake sort.\n        \"\"\"\n        n = list_obj.length()\n        for current_size in range(n, 1, -1):\n            max_idx = self.find_max_index(list_obj, current_size)\n\n            if max_idx != current_size - 1:\n                self.flip(list_obj, max_idx + 1)\n                self.flip(list_obj, current_size)\n        return list_obj\n\ndef pancake_sort(list: List | Sequence[T]) -> List | Sequence[T]:\n    \"\"\"\n    Sorts a list of elements using the pancake sorting algorithm.\n    \"\"\"\n    is_native_sequence = not isinstance(list, List)\n    \n    if is_native_sequence:\n        domain_list = list_from_sequence(list)\n    else:\n        domain_list = list\n    \n    sorter = PancakeSorter()\n    sorted_domain_list = sorter.pancake_sort(domain_list)\n    \n    if is_native_sequence:\n        return sequence_from_list(sorted_domain_list)\n    else:\n        return sorted_domain_list"}
{"task_id": "Mbpp/142", "solution": "from typing import Any, List as TypingList\n\nclass Element:\n    \"\"\"Immutable container for element value and position.\"\"\"\n    def __init__(self, value: Any, position: int):\n        self.value = value\n        self.position = position\n\nclass List:\n    \"\"\"Domain wrapper around a Python sequence.\"\"\"\n    def __init__(self, raw_elements: TypingList[Any]):\n        self._elements = [Element(value, i) for i, value in enumerate(raw_elements)]\n\n    def length(self) -> int:\n        return len(self._elements)\n\n    def get(self, index: int) -> Element:\n        return self._elements[index]\n\nclass CountResult:\n    \"\"\"Simple holder for an integer count.\"\"\"\n    def __init__(self, count: int):\n        self._count = count\n\n    def to_int(self) -> int:\n        return self._count\n\nclass ComparisonEngine:\n    \"\"\"Stateless class providing the algorithm to compute matching count across three domain Lists.\"\"\"\n    @staticmethod\n    def count_samepair(list1: List, list2: List, list3: List) -> CountResult:\n        count = 0\n        min_len = min(list1.length(), list2.length(), list3.length())\n\n        for i in range(min_len):\n            val1 = list1.get(i).value\n            val2 = list2.get(i).value\n            val3 = list3.get(i).value\n            if val1 == val2 == val3:\n                count += 1\n        return CountResult(count)\n\ndef count_samepair(list1: TypingList[Any], list2: TypingList[Any], list3: TypingList[Any]) -> int:\n    \"\"\"Counts number items that are identical in the same position of three given lists.\"\"\"\n    # Convert raw Python lists to domain List objects.\n    domain_list1 = List(list1)\n    domain_list2 = List(list2)\n    domain_list3 = List(list3)\n\n    # Delegate the comparison logic to the ComparisonEngine.\n    result = ComparisonEngine.count_samepair(domain_list1, domain_list2, domain_list3)\n\n    # Return the integer count from the result.\n    return result.to_int()"}
{"task_id": "Mbpp/145", "solution": "from typing import Union\n\ndef _is_numeric(value: object) -> bool:\n    \"\"\"Checks if a value is an int or float, excluding booleans.\"\"\"\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\n\ndef _validate_sequence(seq: object) -> None:\n    \"\"\"Validates the input sequence based on design rules, raising errors for invalid input.\"\"\"\n    if not isinstance(seq, (list, tuple)):\n        raise TypeError(\"Input must be a list or tuple.\")\n\n    if len(seq) < 2:\n        raise ValueError(\"Sequence must contain at least two numeric elements.\")\n\n    for element in seq:\n        if not _is_numeric(element):\n            raise TypeError(\"All elements in the sequence must be int or float.\")\n\ndef max_Abs_Diff(seq: object) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum difference between any two elements in a given numeric sequence.\n    Validates input type and elements, raising TypeError or ValueError on invalid input.\n    \"\"\"\n    _validate_sequence(seq)\n    return max(seq) - min(seq)"}
{"task_id": "Mbpp/160", "solution": "class IntegerInput:\n    \"\"\"Holds input integers and validates their types.\"\"\"\n    def __init__(self, a, b, n):\n        self.a = a\n        self.b = b\n        self.n = n\n\n    def validate(self):\n        \"\"\"Checks if a, b, and n are all integers.\"\"\"\n        return isinstance(self.a, int) and isinstance(self.b, int) and isinstance(self.n, int)\n\nclass GCDComputation:\n    \"\"\"Provides methods for GCD and extended Euclidean algorithm.\"\"\"\n    @staticmethod\n    def extended_gcd(a: int, b: int) -> tuple[int, int, int]:\n        \"\"\"\n        Computes gcd(a, b) and Bezout coefficients x, y such that ax + by = gcd(a, b).\n        Uses the Extended Euclidean Algorithm.\n        \"\"\"\n        if a == 0:\n            return (b, 0, 1)\n        g, x1, y1 = GCDComputation.extended_gcd(b % a, a)\n        x = y1 - (b // a) * x1\n        y = x1\n        return (g, x, y)\n\nclass GCDResult:\n    \"\"\"Data holder for gcd and base Bezout coefficients.\"\"\"\n    def __init__(self, g: int, coeff_x: int, coeff_y: int):\n        self.g = g\n        self.coeff_x = coeff_x\n        self.coeff_y = coeff_y\n\nclass BezoutSolution:\n    \"\"\"Scales base Bezout coefficients and verifies solutions.\"\"\"\n    @staticmethod\n    def scale_solution(x0: int, y0: int, factor: int) -> tuple[int, int]:\n        \"\"\"Scales base Bezout coefficients by a factor.\"\"\"\n        return (x0 * factor, y0 * factor)\n\n    @staticmethod\n    def is_valid(a: int, b: int, n: int, x: int, y: int) -> bool:\n        \"\"\"Verifies if a*x + b*y == n.\"\"\"\n        return a * x + b * y == n\n\nclass Solver:\n    \"\"\"Orchestrates solving the linear Diophantine equation.\"\"\"\n    def find_solution(self, a: int, b: int, n: int) -> tuple[int, int] | None:\n        \"\"\"\n        Orchestrates solving ax + by = n, returning (x, y) or None.\n        Raises TypeError for non-integer inputs or ArithmeticError for unexpected failures.\n        \"\"\"\n        input_validator = IntegerInput(a, b, n)\n        if not input_validator.validate():\n            raise TypeError(\"Inputs a, b, and n must be integers.\")\n\n        g, x0, y0 = GCDComputation.extended_gcd(a, b)\n\n        if g == 0:\n            return (0, 0) if n == 0 else None\n\n        if n % g != 0:\n            return None\n\n        factor = n // g\n        x, y = BezoutSolution.scale_solution(x0, y0, factor)\n\n        if not BezoutSolution.is_valid(a, b, n, x, y):\n            raise ArithmeticError(\"Internal verification failed: ax + by != n after calculation.\")\n\n        return (x, y)\n\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integer solutions (x, y) for the linear Diophantine equation ax + by = n.\n    Returns (x, y) as a tuple, or None if no integer solution exists.\n    \"\"\"\n    solver = Solver()\n    return solver.find_solution(a, b, n)"}
{"task_id": "Mbpp/161", "solution": "from typing import Iterable, List, Any\n\ndef remove_elements(source: Iterable[Any], to_remove: Iterable[Any]) -> List[Any]:\n    \"\"\"\n    Remove all elements from source that are present in to_remove, returning a new list.\n    The relative order of remaining elements from source is preserved.\n    \"\"\"\n    if not to_remove:\n        return list(source)\n\n    to_remove_set = set(to_remove)\n    result = []\n    for element in source:\n        if element not in to_remove_set:\n            result.append(element)\n    return result"}
{"task_id": "Mbpp/162", "solution": "class InputParameter:\n    \"\"\"Validates input parameter n, raising TypeError for non-integers.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def validate(self) -> bool:\n        \"\"\"Checks if n is an integer and raises TypeError if not.\"\"\"\n        if not isinstance(self.n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        return True\n\nclass SeriesTerm:\n    \"\"\"Data-holder for a term in the series, storing its index and value.\"\"\"\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\n\nclass Accumulator:\n    \"\"\"Maintains a running total for the series calculation.\"\"\"\n    def __init__(self):\n        self.total = 0\n\n    def add(self, value: int) -> None:\n        \"\"\"Adds a given value to the current total.\"\"\"\n        self.total += value\n\n    def value(self) -> int:\n        \"\"\"Returns the accumulated total.\"\"\"\n        return self.total\n\nclass SumSeriesFunction:\n    \"\"\"Encapsulates the logic to compute the sum of the series terms.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n        self.terms = []\n\n    def compute(self) -> int:\n        \"\"\"Calculates the sum of positive terms n, n-2, n-4, ...\"\"\"\n        accumulator = Accumulator()\n        i = 0\n        while True:\n            current_term = self.n - 2 * i\n            if current_term > 0:\n                self.terms.append(SeriesTerm(i, current_term))\n                accumulator.add(current_term)\n            else:\n                break\n            i += 1\n        return accumulator.value()\n\ndef sum_series(n) -> int:\n    \"\"\"\n    Calculates the sum (n - 2*i) from i=0 to n // 2, including only strictly positive terms.\n    If n is not an integer, a TypeError is raised. If n <= 0, 0 is returned.\n    \"\"\"\n    param_validator = InputParameter(n)\n    param_validator.validate()\n\n    if n <= 0:\n        return 0\n\n    series_computer = SumSeriesFunction(n)\n    return series_computer.compute()"}
{"task_id": "Mbpp/165", "solution": "def _is_ascii_alpha(ch: str) -> bool:\n    \"\"\"Returns True if ch is an ASCII alphabetic letter; False otherwise.\"\"\"\n    return ('a' <= ch <= 'z') or ('A' <= ch <= 'Z')\n\ndef _alphabet_letter_for_position(pos: int) -> str | None:\n    \"\"\"Maps 1..26 to 'a'..'z' (lowercase). Returns None for pos <= 0 or pos > 26.\"\"\"\n    if 1 <= pos <= 26:\n        return chr(ord('a') + (pos - 1))\n    return None\n\ndef _to_lower(ch: str) -> str:\n    \"\"\"Deterministic ASCII-lowercasing for comparisons.\"\"\"\n    return ch.lower()\n\ndef count_char_position(s: str) -> int:\n    \"\"\"\n    Count how many characters in s occur at the same 1-based position\n    as the corresponding English alphabet letter (case-insensitive).\n    \"\"\"\n    if not s:\n        return 0\n\n    count = 0\n    for pos, char_in_s in enumerate(s, start=1):\n        mapped_letter = _alphabet_letter_for_position(pos)\n        \n        # If position is out of the 1-26 range, no match is possible.\n        if mapped_letter is None:\n            continue\n        \n        # Only consider ASCII alphabetic characters from the input string.\n        if not _is_ascii_alpha(char_in_s):\n            continue\n\n        # Compare the lowercase version of the string character with the mapped alphabet letter.\n        if _to_lower(char_in_s) == mapped_letter:\n            count += 1\n            \n    return count"}
{"task_id": "Mbpp/166", "solution": "from typing import List\n\nclass InputValidationError(Exception):\n    \"Raised when input is not a list of integers as required.\"\n\ndef _validate_input(values) -> None:\n    \"Raise InputValidationError if values is not a list of ints.\"\n    if not isinstance(values, list):\n        raise InputValidationError(\"Input must be a list.\")\n    for val in values:\n        if not isinstance(val, int):\n            raise InputValidationError(\"All elements in the list must be integers.\")\n\ndef _count_pairs_by_parity(even_count: int, odd_count: int) -> int:\n    \"Return even_count*(even_count-1)//2 + odd_count*(odd_count-1)//2.\"\n    even_pairs = even_count * (even_count - 1) // 2\n    odd_pairs = odd_count * (odd_count - 1) // 2\n    return even_pairs + odd_pairs\n\ndef find_even_pair(values: List[int]) -> int:\n    \"\"\"\n    Return the count of unordered distinct index pairs (i < j) whose bitwise XOR is even.\n\n    Validates input and counts pairs using parity optimization.\n    \"\"\"\n    _validate_input(values)\n\n    if len(values) < 2:\n        return 0\n\n    even_count = 0\n    odd_count = 0\n    for val in values:\n        if val % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return _count_pairs_by_parity(even_count, odd_count)"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Returns the smallest power of 2 greater than or equal to n.\n    Precondition: n is an integer.\n    \"\"\"\n    if n <= 1:\n        return 1\n    \n    power = 1\n    while power < n:\n        power *= 2\n    return power"}
{"task_id": "Mbpp/168", "solution": "def frequency(list, value):\n    \"\"\"Return int count of elements in `list` equal to `value` using ==.\n    Must not modify `list`.\"\"\"\n    count = 0\n    for element in list:\n        if element == value:\n            count += 1\n    return count"}
{"task_id": "Mbpp/170", "solution": "def sum_range_list(input_list, start_index, end_index):\n    \"\"\"Return inclusive sum of elements from start_index to end_index.\n\n    Preconditions (as derived in SRS):\n    - start_index and end_index are integers (TypeError if not)\n    - start_index <= end_index (ValueError if not)\n    - 0 <= start_index <= end_index < len(input_list) (IndexError if violated)\n    \"\"\"\n    if not isinstance(start_index, int) or not isinstance(end_index, int):\n        raise TypeError(\"start_index and end_index must be integers\")\n    if start_index > end_index:\n        raise ValueError(\"start_index must be <= end_index\")\n    if start_index < 0 or end_index >= len(input_list):\n        raise IndexError(\"start_index and end_index must be within list bounds\")\n    return sum(input_list[start_index:end_index+1])"}
{"task_id": "Mbpp/171", "solution": "def perimeter_pentagon(side_length: float) -> float:\n    \"\"\"Return numeric perimeter computed as 5 * side_length.\"\"\"\n    return 5 * side_length"}
{"task_id": "Mbpp/172", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    \"\"\"Lightweight representation of the provided input string with length helper.\"\"\"\n    value: str\n    @property\n    def length(self) -> int:\n        return len(self.value)\n\n@dataclass\nclass Substring:\n    \"\"\"Represents the substring to search for; constant 'std'.\"\"\"\n    value: str = \"std\"\n    length: int = 3\n\n@dataclass\nclass Occurrence:\n    \"\"\"Represents an occurrence position and contributes to counting.\"\"\"\n    index: int\n    count: int = 1\n\ndef count_occurance(input: str) -> int:\n    \"\"\"\n    Counts the number of case-sensitive occurrences of the substring 'std' in a given string.\n    Returns the total count, or 0 if no occurrences are found.\n    \"\"\"\n    if not input:\n        return 0\n\n    # Wrap input string and define target substring using dataclasses for design traceability.\n    input_obj = InputString(value=input)\n    target_obj = Substring()\n\n    count = 0\n    \n    # Iterate through the input string, checking for exact matches of the target substring.\n    for i in range(input_obj.length - target_obj.length + 1):\n        if input_obj.value[i : i + target_obj.length] == target_obj.value:\n            count += 1\n            \n    return count"}
{"task_id": "Mbpp/222", "solution": "def check_type(t: tuple) -> bool:\n    \"\"\"Validate that t is a tuple; return True if all elements have identical runtime types; False otherwise.\n    Raises TypeError for non-tuple input.\"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(\"Input must be a tuple\")\n\n    if not t:\n        return True\n\n    first_type = type(t[0])\n    for elem in t[1:]:\n        if type(elem) is not first_type:\n            return False\n    return True"}
{"task_id": "Mbpp/227", "solution": "def min_of_three(a, b, c):\n    \"\"\"\n    Finds the minimum of three numbers, raising TypeError for non-numeric inputs.\n    The comparison logic ensures O(1) time and space complexity.\n    \"\"\"\n    if not isinstance(a, (int, float)) or \\\n       not isinstance(b, (int, float)) or \\\n       not isinstance(c, (int, float)):\n        raise TypeError(\"All inputs must be numeric (int or float).\")\n\n    return min(a, b, c)"}
{"task_id": "Mbpp/223", "solution": "def is_majority(arr, n, x):\n    \"\"\"\n    Checks if an element is the majority element in a sorted array.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n    if n != len(arr):\n        raise ValueError(\"n does not equal length of arr\")\n\n    def _first_index(elements: list, target) -> int:\n        \"\"\"\n        Finds the first occurrence of the target in a sorted list using binary search.\n        Returns the index of the first occurrence or -1 if not found.\n        \"\"\"\n        low, high = 0, len(elements) - 1\n        result = -1\n        while low <= high:\n            mid = low + (high - low) // 2\n            if elements[mid] == target:\n                result = mid\n                high = mid - 1  # Search in the left half for an earlier occurrence\n            elif elements[mid] < target:\n                low = mid + 1\n            else: # elements[mid] > target\n                high = mid - 1\n        return result\n\n    def _last_index(elements: list, target) -> int:\n        \"\"\"\n        Finds the last occurrence of the target in a sorted list using binary search.\n        Returns the index of the last occurrence or -1 if not found.\n        \"\"\"\n        low, high = 0, len(elements) - 1\n        result = -1\n        while low <= high:\n            mid = low + (high - low) // 2\n            if elements[mid] == target:\n                result = mid\n                low = mid + 1  # Search in the right half for a later occurrence\n            elif elements[mid] < target:\n                low = mid + 1\n            else: # elements[mid] > target\n                high = mid - 1\n        return result\n\n    first = _first_index(arr, x)\n\n    if first == -1:\n        return False  # Element not found in the array\n\n    last = _last_index(arr, x)\n    count = last - first + 1\n\n    return count > (n // 2)"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(n):\n    \"\"\"\n    Validate n is int; return number of '1' in bin(n) excluding leading sign.\n    Raises: TypeError if n is not an int.\n    \"\"\"\n    b = bin(n)\n    if b.startswith('-'):\n        b = b[1:]\n    count = b.count('1')\n    return count"}
