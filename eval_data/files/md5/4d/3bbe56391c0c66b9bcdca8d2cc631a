{"task_id": "Mbpp/459", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    value: str\n\n    def length(self) -> int:\n        return len(self.value)\n\n@dataclass\nclass OutputString:\n    value: str\n\n@dataclass\nclass Character:\n    symbol: str\n\n    def is_uppercase(self) -> bool:\n        \"\"\"Checks if the character is an ASCII uppercase letter (A-Z).\"\"\"\n        return len(self.symbol) == 1 and 'A' <= self.symbol <= 'Z'\n\nclass RemoveUppercaseService:\n    def remove_uppercase(self, input_str: str) -> str:\n        \"\"\"Removes all ASCII uppercase letters from the input string.\"\"\"\n        input_string_obj = InputString(input_str)\n\n        if input_string_obj.length() == 0:\n            return ''\n\n        result_chars = []\n        for char_symbol in input_string_obj.value:\n            char_obj = Character(char_symbol)\n            if not char_obj.is_uppercase():\n                result_chars.append(char_symbol)\n\n        output_value = \"\".join(result_chars)\n        return output_value\n\ndef remove_uppercase(input: str) -> str:\n    \"\"\"Removes all ASCII uppercase letters from the input string.\"\"\"\n    return RemoveUppercaseService().remove_uppercase(input)"}
