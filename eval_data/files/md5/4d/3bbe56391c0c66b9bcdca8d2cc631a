{"task_id": "Mbpp/470", "solution": "class TupleElement:\n    def __init__(self, value):\n        self.value = value\n\nclass InputTuple:\n    def __init__(self, elements: tuple):\n        self.elements = elements\n        self.length = len(elements)\n    def __len__(self) -> int:\n        return self.length\n\nclass ResultTuple:\n    def __init__(self, elements: tuple):\n        self.elements = elements\n        self.length = len(elements)\n    def __len__(self) -> int:\n        return self.length\n\nclass AddPairwiseFunction:\n    def execute(self, input_obj: InputTuple) -> ResultTuple:\n        # Validate all elements are numeric (int or float).\n        for element in input_obj.elements:\n            if not isinstance(element, (int, float)):\n                raise TypeError(\"all elements must be numeric\")\n\n        # Handle edge case for input tuples with less than 2 elements.\n        if input_obj.length < 2:\n            return ResultTuple(elements=())\n\n        pairwise_sums = []\n        for i in range(input_obj.length - 1):\n            sum_val = input_obj.elements[i] + input_obj.elements[i+1]\n            pairwise_sums.append(sum_val)\n        \n        return ResultTuple(elements=tuple(pairwise_sums))\n\ndef add_pairwise(input_tuple):\n    \"\"\"\n    Finds the pairwise addition of the neighboring elements of the given tuple.\n    Raises TypeError for invalid input.\n    \"\"\"\n    # Ensure the input is a tuple as per BR5.\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"input must be a tuple\")\n    \n    input_obj = InputTuple(input_tuple)\n    processor = AddPairwiseFunction()\n    result_obj = processor.execute(input_obj)\n    \n    return result_obj.elements"}
{"task_id": "Mbpp/468", "solution": "class ArrayInput:\n    \"\"\"Represents and validates the input array of numeric elements.\"\"\"\n    def __init__(self, numbers):\n        self.numbers = numbers\n\n    def validate(self):\n        \"\"\"Validates that numbers is an array/list and each element is numeric.\"\"\"\n        pass # Per instructions, validation checks are assumed to pass.\n\nclass Subsequence:\n    \"\"\"Represents a contiguous subsequence with its properties.\"\"\"\n    def __init__(self, elements, startIndex, endIndex):\n        self.elements = elements\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n        self.length = len(elements)\n        self.product = None\n\n    def isStrictlyIncreasing(self):\n        \"\"\"Checks if the elements of the subsequence are strictly increasing.\"\"\"\n        if not self.elements:\n            return True\n\n        for i in range(1, self.length):\n            if self.elements[i] <= self.elements[i-1]:\n                return False\n        return True\n\nclass Result:\n    \"\"\"Holds the computed maximum product value.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\nclass ProductCalculator:\n    \"\"\"Discovers increasing subsequences, computes products, and selects the maximum.\"\"\"\n    def max_product(self, numbers):\n        \"\"\"\n        Given validated array, return numeric maximum product among valid subsequences.\n        Initializes max_product to negative infinity to handle all numeric outcomes.\n        \"\"\"\n        subsequences = self.find_increasing_subsequences(numbers)\n\n        overall_max_product = float('-inf')\n\n        for subseq in subsequences:\n            self.compute_product(subseq)\n            if subseq.product is not None and subseq.product > overall_max_product:\n                overall_max_product = subseq.product\n        \n        # If no valid subsequences were found (e.g., empty array or all decreasing),\n        # return 0 as a default product.\n        if overall_max_product == float('-inf'):\n            return 0\n            \n        return overall_max_product\n\n    def find_increasing_subsequences(self, numbers):\n        \"\"\"\n        Scans numbers and constructs Subsequence objects for each contiguous strictly increasing segment.\n        Includes single-element subsequences.\n        \"\"\"\n        subsequences = []\n        n = len(numbers)\n\n        for i in range(n):\n            for j in range(i, n):\n                current_elements = numbers[i : j + 1]\n                subseq = Subsequence(current_elements, i, j)\n\n                if subseq.isStrictlyIncreasing():\n                    subsequences.append(subseq)\n        return subsequences\n\n    def compute_product(self, subseq):\n        \"\"\"Compute product of subseq.elements and set subseq.product.\"\"\"\n        if not subseq.elements:\n            subseq.product = 1 # Product of an empty sequence is 1 by convention\n            return\n        \n        current_product = 1\n        for num in subseq.elements:\n            current_product *= num\n        subseq.product = current_product\n\n\ndef max_product(array):\n    \"\"\"\n    Accepts an array (list) and returns the maximum product of its strictly increasing contiguous subsequences.\n    It validates the input via ArrayInput.validate() and delegates to ProductCalculator.\n    \"\"\"\n    ai = ArrayInput(array)\n    ai.validate()\n    pc = ProductCalculator()\n    return pc.max_product(ai.numbers)"}
{"task_id": "Mbpp/471", "solution": "from collections.abc import Iterator\n\nclass InvalidModulusException(ValueError):\n    \"\"\"Domain-specific exception for invalid modulus values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass ArrayInput:\n    \"\"\"Lightweight wrapper around the input list of integers.\"\"\"\n    def __init__(self, values: list) -> None:\n        self.values = values\n\n    def __iter__(self) -> Iterator[int]:\n        \"\"\"Yields integers from the wrapped list.\"\"\"\n        return iter(self.values)\n\nclass Modulus:\n    \"\"\"Encapsulates modulus value and validation logic.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n\n    def isValid(self) -> bool:\n        \"\"\"Checks if the modulus is a non-zero integer.\"\"\"\n        return isinstance(self.n, int) and self.n != 0\n\nclass ProductCalculator:\n    \"\"\"Core algorithmic component to compute product modulo n.\"\"\"\n    def compute(self, arr: ArrayInput, m: Modulus) -> int:\n        \"\"\"\n        Computes the product of array elements modulo n.\n        Raises InvalidModulusException if modulus is invalid.\n        \"\"\"\n        if not m.isValid():\n            raise InvalidModulusException(\"invalid modulus: must be a non-zero integer\")\n\n        mod_n = m.n\n        accumulator = 1 # Multiplicative identity\n\n        # If arr is empty, return 1 % mod_n as per design (multiplicative identity modulo n).\n        if not arr.values:\n            return 1 % mod_n\n\n        for x in arr:\n            accumulator = (accumulator * (x % mod_n)) % mod_n\n\n        return accumulator\n\ndef find_remainder(arr, n) -> int:\n    \"\"\"\n    Finds the product of array elements modulo n.\n    Raises InvalidModulusException if n is invalid.\n    \"\"\"\n    array_input = ArrayInput(arr)\n    modulus = Modulus(n)\n    return ProductCalculator().compute(array_input, modulus)"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(input_list):\n    \"\"\"\n    Checks if a list contains strictly consecutive integers in ascending order.\n    Returns True for empty or single-element lists.\n    \"\"\"\n    if len(input_list) <= 1:\n        return True\n\n    for i in range(1, len(input_list)):\n        if input_list[i] != input_list[i-1] + 1:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/473", "solution": "def tuple_intersection(list1, list2) -> set:\n    \"\"\"\n    Public API to find the tuple intersection of elements in the given tuple list\n    irrespective of their order.\n    \"\"\"\n\n    # --- Domain Classes (defined inline as per design context and constraints) ---\n    class TuplePair:\n        \"\"\"Represents a 2-element tuple and provides a normalized, order-invariant key.\"\"\"\n        def __init__(self, first, second):\n            self.first = first\n            self.second = second\n\n        def normalizedKey(self) -> tuple:\n            \"\"\"Returns an order-invariant key for this pair (e.g., tuple(sorted((a, b)))).\"\"\"\n            return tuple(sorted((self.first, self.second)))\n\n        def __eq__(self, other):\n            # As per constraints, isinstance() checks are omitted.\n            return self.normalizedKey() == other.normalizedKey()\n\n        def __hash__(self):\n            return hash(self.normalizedKey())\n\n    class TupleList:\n        \"\"\"A simple container for a list of TuplePair objects.\"\"\"\n        def __init__(self, tuples: list):\n            self.tuples = tuples\n\n    class ResultSet:\n        \"\"\"A deduplicated collection of TuplePair instances, keyed by their normalized forms.\"\"\"\n        def __init__(self):\n            # Stores TuplePair objects, preserving the first one added for each normalized key.\n            self._pairs_by_normalized_key = {}\n\n        def add(self, pair: TuplePair) -> None:\n            \"\"\"Adds a TuplePair, ensuring only one representative per normalized key is stored.\"\"\"\n            normalized_key = pair.normalizedKey()\n            if normalized_key not in self._pairs_by_normalized_key:\n                self._pairs_by_normalized_key[normalized_key] = pair\n\n        def __iter__(self):\n            \"\"\"Iterates over the unique TuplePair objects stored in the set.\"\"\"\n            return iter(self._pairs_by_normalized_key.values())\n\n    # --- Service Class (defined inline as per design context and constraints) ---\n    class TupleIntersectionService:\n        \"\"\"A stateless service that computes the unordered intersection of two lists of TuplePairs.\"\"\"\n        def tuple_intersection(self, list1_pairs: list, list2_pairs: list) -> ResultSet:\n            \"\"\"Computes unordered intersection, returning a ResultSet of matched TuplePair instances.\"\"\"\n            \n            # Create a set of normalized keys from list2 for efficient lookup (FR2).\n            list2_normalized_keys = {pair.normalizedKey() for pair in list2_pairs}\n            \n            result_set = ResultSet() # FR4: ResultSet handles deduplication based on normalized key.\n            \n            # Iterate through list1, checking for unordered matches in list2.\n            for pair1 in list1_pairs:\n                if pair1.normalizedKey() in list2_normalized_keys:\n                    # FR3: Adds the tuple from list1 if an unordered match is found.\n                    result_set.add(pair1)\n            \n            return result_set\n\n    # --- Public API Implementation (FR1) ---\n\n    # Convert native Python tuples from list1 into TuplePair domain objects.\n    list1_pairs = TupleList([TuplePair(a, b) for (a, b) in list1])\n    # Convert native Python tuples from list2 into TuplePair domain objects.\n    list2_pairs = TupleList([TuplePair(a, b) for (a, b) in list2])\n\n    # Instantiate the service and compute the intersection.\n    service = TupleIntersectionService()\n    result_set_pairs = service.tuple_intersection(list1_pairs.tuples, list2_pairs.tuples)\n\n    # Convert the ResultSet of TuplePair objects back into a set of native Python tuples.\n    return {(p.first, p.second) for p in result_set_pairs}"}
{"task_id": "Mbpp/475", "solution": "from typing import Dict, List, Tuple\nfrom dataclasses import dataclass\n\n@dataclass\nclass KeyValuePair:\n    key: str\n    value: int\n\n    def as_tuple(self) -> tuple:\n        \"\"\"Returns the key-value pair as a tuple.\"\"\"\n        return (self.key, self.value)\n\nclass SortedList:\n    def __init__(self, items: List[KeyValuePair]) -> None:\n        \"\"\"Initializes with a list of KeyValuePair objects.\"\"\"\n        self.items = items\n\n    def as_list(self) -> List[Tuple[str, int]]:\n        \"\"\"Converts the internal list of KeyValuePair objects to a list of (key, value) tuples.\"\"\"\n        return [item.as_tuple() for item in self.items]\n\ndef _validate_input(counter: dict) -> None:\n    \"\"\"\n    This helper performs no validation as per completion requirements, despite design context.\n    The prompt's constraints disallow isinstance checks and raising exceptions.\n    \"\"\"\n    pass\n\ndef sort_counter(counter: dict) -> list:\n    \"\"\"\n    Public API: Accept a dictionary mapping strings->ints and return a list of (key,value) tuples sorted descending by value.\n    The function does not mutate the input dictionary.\n    \"\"\"\n    _validate_input(counter)\n\n    key_value_pairs = [KeyValuePair(key, value) for key, value in counter.items()]\n\n    sorted_pairs = sorted(key_value_pairs, key=lambda item: item.value, reverse=True)\n\n    sorted_list_wrapper = SortedList(sorted_pairs)\n    return sorted_list_wrapper.as_list()"}
{"task_id": "Mbpp/474", "solution": "from __future__ import annotations\n\ndef validate(source: str, old_char: str, new_char: str) -> bool:\n    \"\"\"Return True if source is a string and old_char/new_char are single-character strings.\"\"\"\n    return (isinstance(source, str) and\n            isinstance(old_char, str) and len(old_char) == 1 and\n            isinstance(new_char, str) and len(new_char) == 1)\n\ndef replace_char(source: str, old_char: str, new_char: str) -> str:\n    \"\"\"Replace all occurrences of old_char in source with new_char and return a new string.\n\n    Raises:\n        ValueError: if Validation.validate(...) returns False (invalid inputs per FR6).\n    \"\"\"\n    if not validate(source, old_char, new_char):\n        raise ValueError(\"Invalid inputs: see Validation.validate contract\")\n    return source.replace(old_char, new_char)"}
{"task_id": "Mbpp/476", "solution": "from typing import Sequence, Union\n\ndef big_sum(arr: Sequence[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Finds the sum of the largest and smallest value in a given array.\n    Raises ValueError if the input array is empty.\n    \"\"\"\n    if not arr:\n        raise ValueError(\"Input array cannot be empty.\")\n    \n    min_val = min(arr)\n    max_val = max(arr)\n    return min_val + max_val"}
