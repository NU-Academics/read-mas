{"task_id": "Mbpp/412", "solution": "def remove_odd(input):\n    \"\"\"Return a new list containing only even integers from the input list.\n    The function preserves the relative order of even integers and does not modify the input list.\n    \"\"\"\n    even_numbers = []\n    for number in input:\n        if number % 2 == 0:\n            even_numbers.append(number)\n    return even_numbers"}
{"task_id": "Mbpp/398", "solution": "from typing import List, Iterator\n\n# DTO representing computation outcome.\nclass Result:\n    \"\"\"Holds the accumulated total of per-number digit sums.\"\"\"\n    def __init__(self, total: int):\n        self.total = total\n\n# Per-integer encapsulation.\nclass IntegerValue:\n    \"\"\"Encapsulates an integer value, stores its digits, and computes their sum.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n        # Decompose the absolute value into digits, as behavior for negative numbers is undefined.\n        self.digits: List[int] = self._decompose_to_digits(abs(value))\n\n    def _decompose_to_digits(self, number: int) -> List[int]:\n        \"\"\"Helper to decompose a non-negative integer into its decimal digits.\"\"\"\n        if number == 0:\n            return [0]\n        \n        digits_list = []\n        str_num = str(number)\n        for char_digit in str_num:\n            digits_list.append(int(char_digit))\n        return digits_list\n\n    def sumDigits(self) -> int:\n        \"\"\"Computes and returns the sum of its decimal digits.\"\"\"\n        return sum(self.digits)\n\n# Container abstraction.\nclass IntegerList:\n    \"\"\"Transforms a raw list of integers into IntegerValue objects for processing.\"\"\"\n    def __init__(self, values: List[int]):\n        self.integers: List[IntegerValue] = [IntegerValue(val) for val in values]\n\n    def __iter__(self) -> Iterator[IntegerValue]:\n        \"\"\"Allows iteration over the contained IntegerValue objects.\"\"\"\n        return iter(self.integers)\n\n# Orchestrator class.\nclass SumOfDigitsFunction:\n    \"\"\"Orchestrates the computation of the sum of digits for each number in a list.\"\"\"\n    def __init__(self, input_list: List[int]):\n        self.input_list = input_list\n\n    def execute(self) -> int:\n        \"\"\"Executes the sum of digits computation across the list and returns the total.\"\"\"\n        integer_list = IntegerList(self.input_list)\n        result = Result(total=0)\n\n        for integer_value in integer_list:\n            per_number_sum = integer_value.sumDigits()\n            result.total += per_number_sum\n        \n        return result.total\n\ndef sum_of_digits(input_list: List[int]) -> int:\n    \"\"\"\n    Computes the sum of digits of each number in the given list and returns their total sum.\n    \"\"\"\n    function_executor = SumOfDigitsFunction(input_list)\n    return function_executor.execute()"}
{"task_id": "Mbpp/405", "solution": "def check_tuplex(tpl, elt):\n    \"\"\"\n    Checks if an element exists within a tuple using a linear scan.\n    Returns True if elt is found, False otherwise.\n    \"\"\"\n    for item in tpl:\n        if item == elt:\n            return True\n    return False"}
{"task_id": "Mbpp/410", "solution": "from typing import List, Union, Any\n\ndef _is_numeric(value) -> bool:\n    \"\"\"Return True if value is int or float (treat bool as non-numeric).\"\"\"\n    return type(value) is int or type(value) is float\n\ndef _filter_numeric(list_arg) -> List[Union[int, float]]:\n    \"\"\"Return list of numeric elements (int, float) from list_arg.\"\"\"\n    return [item for item in list_arg if _is_numeric(item)]\n\ndef min_val(list_arg):\n    \"\"\"\n    Accept exactly one argument (a list). Return minimum numeric value (int or float).\n    Raises TypeError if not a list, ValueError if no int/float elements present.\n    \"\"\"\n    if not isinstance(list_arg, list):\n        raise TypeError('expected list argument')\n\n    numeric_elements = _filter_numeric(list_arg)\n\n    if not numeric_elements:\n        raise ValueError('no numeric elements found')\n\n    return min(numeric_elements)"}
{"task_id": "Mbpp/409", "solution": "def min_product_tuple(list_of_pairs):\n    \"\"\"\n    Finds the minimum product from pairs of tuples within a given list.\n    Validates input and computes the minimum product in a single pass.\n    \"\"\"\n    if not isinstance(list_of_pairs, list):\n        raise TypeError(\"list_of_pairs must be a list of 2-value numeric tuples\")\n    if len(list_of_pairs) == 0:\n        raise ValueError(\"list_of_pairs must not be empty\")\n\n    min_product = None\n\n    for idx, elem in enumerate(list_of_pairs):\n        if not isinstance(elem, tuple) or len(elem) != 2:\n            raise TypeError(f\"element at index {idx} is not a 2-value tuple\")\n        \n        a, b = elem\n        if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n            raise TypeError(f\"elements of tuple at index {idx} must be int or float\")\n        \n        current_product = a * b\n        \n        if min_product is None or current_product < min_product:\n            min_product = current_product\n            \n    return min_product"}
{"task_id": "Mbpp/265", "solution": "from typing import List, Any\n\nclass ValidationException(ValueError):\n    \"\"\"\n    Concrete validation failure exception; implemented as subclass of ValueError.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass ListSplitService:\n    \"\"\"\n    Implements validation and splitting algorithm.\n    \"\"\"\n    def list_split(self, input_list: List[Any], n: int) -> List[List[Any]]:\n        \"\"\"\n        Validates n, constructs result lists, distributes elements by i mod n, returns result.\n        \"\"\"\n        if not isinstance(n, int) or n < 1:\n            raise ValidationException(\"n must be an integer >= 1\")\n\n        result: List[List[Any]] = [[] for _ in range(n)]\n\n        for i, element in enumerate(input_list):\n            result[i % n].append(element)\n        return result\n\ndef list_split(input_list: List[Any], n: int) -> List[List[Any]]:\n    \"\"\"\n    Splits a list for every nth element, returning a list of the resulting lists.\n    Delegates to ListSplitService.list_split for core logic and validation.\n    \"\"\"\n    service = ListSplitService()\n    return service.list_split(input_list, n)"}
{"task_id": "Mbpp/413", "solution": "```python\ndef extract_nth_element(list_of_tuples, n):\n    \"\"\"\n    Return a list containing the element at index n from each tuple in list_of_tuples.\n    This function adheres to zero-based indexing, preserves input order, and returns an empty list for empty input.\n    \"\"\"\n    return [t[n] for t in list_of_tuples]\n```"}
{"task_id": "Mbpp/414", "solution": "def overlapping(seqA, seqB):\n    \"\"\"Return True if at least one element in seqA equals an element in seqB using ==.\n\n    Returns False if either seqA or seqB is empty. Does not modify seqA or seqB.\n    \"\"\"\n    if not seqA or not seqB:\n        return False\n\n    for item_a in seqA:\n        for item_b in seqB:\n            if item_a == item_b:\n                return True\n    return False"}
{"task_id": "Mbpp/418", "solution": "class InputList:\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n\n    def validate(self) -> bool:\n        \"\"\"Validates that the stored elements object is a list.\"\"\"\n        return isinstance(self.elements, list)\n\nclass Element:\n    def __init__(self, value) -> None:\n        self.value = value\n\n    def compute_length(self) -> int:\n        \"\"\"Computes the length of the element's value using len().\"\"\"\n        try:\n            return len(self.value)\n        except TypeError:\n            raise TypeError(\"element does not support len()\")\n\ndef Find_Max(input_list: list):\n    \"\"\"\n    Public API: Accepts a Python list and returns the element with maximum len().\n    Raises TypeError for non-list input, ValueError for empty list, TypeError for elements without len().\n    \"\"\"\n    input_list_wrapper = InputList(input_list)\n    if not input_list_wrapper.validate():\n        raise TypeError(\"input_list must be a list\")\n\n    if not input_list:\n        raise ValueError(\"input_list must contain at least one element\")\n\n    current_max_length = -1\n    current_max_value = None\n\n    for value in input_list:\n        element_wrapper = Element(value)\n        length = element_wrapper.compute_length()\n\n        if length > current_max_length:\n            current_max_length = length\n            current_max_value = value\n\n    return current_max_value"}
{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n: int) -> float:\n    \"\"\"\n    Finds the average of the cubes of the first n natural numbers.\n    Assumes n is a positive integer.\n    \"\"\"\n    # The sum of the first n cubes is given by the formula (n * (n + 1) / 2)^2\n    sum_of_cubes = (n * (n + 1) / 2) ** 2\n    # The average is the sum divided by n\n    average = sum_of_cubes / n\n    return average"}
