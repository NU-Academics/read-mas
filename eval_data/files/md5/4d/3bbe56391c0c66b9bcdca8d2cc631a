{"task_id": "Mbpp/252", "solution": "import math\n\ndef is_numeric(value) -> bool:\n    \"\"\"Checks if the value is a numeric type (int, float, or complex).\"\"\"\n    return isinstance(value, (int, float, complex))\n\ndef to_complex(value) -> tuple[float, float]:\n    \"\"\"Normalizes a numeric value to its real and imaginary float components.\"\"\"\n    if isinstance(value, complex):\n        return (float(value.real), float(value.imag))\n    else: # int or float\n        return (float(value), 0.0)\n\ndef magnitude(real: float, imag: float) -> float:\n    \"\"\"Computes the magnitude (r) of a complex number.\"\"\"\n    return math.hypot(real, imag)\n\ndef angle(real: float, imag: float) -> float:\n    \"\"\"Computes the angle (theta) of a complex number in radians.\"\"\"\n    return math.atan2(imag, real)\n\ndef convert(value):\n    \"\"\"\n    Converts a complex or real numeric input to polar coordinates (r, theta).\n    Raises TypeError if the input is not a numeric type.\n    \"\"\"\n    if not is_numeric(value):\n        raise TypeError(\"convert() expects an int, float, or complex value\")\n\n    real, imag = to_complex(value)\n    r = magnitude(real, imag)\n    theta = angle(real, imag)\n    \n    return (float(r), float(theta))"}
{"task_id": "Mbpp/253", "solution": "def count_integer(input_list):\n    \"\"\"Count elements in input_list that satisfy isinstance(element, int).\n\n    Args:\n      input_list: list\n\n    Returns:\n      int\n    \"\"\"\n    count = 0\n    for element in input_list:\n        if isinstance(element, int):\n            count += 1\n    return count"}
{"task_id": "Mbpp/255", "solution": "def combinations_colors(elements: list, n: int) -> list:\n    \"\"\"Return a list of tuples: all length-n combinations with repetition drawn from 'elements'.\"\"\"\n\n    def _generate_combinations_recursive(elements_param: list, n_param: int, current_combination_prefix: list):\n        \"\"\"Internal generator yielding tuples of length n representing each combination with repetition.\"\"\"\n        if len(current_combination_prefix) == n_param:\n            yield tuple(current_combination_prefix)\n            return\n\n        for element in elements_param:\n            # Recursive call, extending the current prefix by one element.\n            yield from _generate_combinations_recursive(elements_param, n_param, current_combination_prefix + [element])\n\n    # Start the recursion with an empty list as the initial combination prefix.\n    # The `elements` and `n` from the outer function are passed as parameters to the helper.\n    return list(_generate_combinations_recursive(elements, n, []))"}
{"task_id": "Mbpp/256", "solution": "class InputValidator:\n    \"\"\"Provides static methods for input validation.\"\"\"\n    @staticmethod\n    def validate_non_negative(n: int):\n        \"\"\"Raises ValueError if n is negative.\"\"\"\n        if n < 0:\n            raise ValueError(\"n must be non-negative\")\n\nclass PrimeNumber:\n    \"\"\"A value object representing a prime number.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass PrimeCounter:\n    \"\"\"Contains domain logic for counting prime numbers.\"\"\"\n    @staticmethod\n    def _sieve_of_eratosthenes(limit: int) -> list[int]:\n        \"\"\"Generates primes less than 'limit' using the Sieve of Eratosthenes.\"\"\"\n        if limit < 2:\n            return []\n        is_prime = [True] * limit\n        is_prime[0] = is_prime[1] = False\n        for p in range(2, int(limit**0.5) + 1):\n            if is_prime[p]:\n                for multiple in range(p*p, limit, p):\n                    is_prime[multiple] = False\n        return [i for i, prime_status in enumerate(is_prime) if prime_status]\n\n    @staticmethod\n    def count_Primes_nums(n: int) -> int:\n        \"\"\"Counts prime numbers strictly less than n.\"\"\"\n        InputValidator.validate_non_negative(n)\n        if n < 2:\n            return 0\n        primes_list = PrimeCounter._sieve_of_eratosthenes(n)\n        return len(primes_list)\n\ndef count_Primes_nums(n: int) -> int:\n    \"\"\"\n    Takes a non-negative number and returns the count of prime numbers\n    strictly less than it.\n    \"\"\"\n    return PrimeCounter.count_Primes_nums(n)"}
