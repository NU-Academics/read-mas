{"task_id": "HumanEval/7", "solution": "```python\n# pyproject.toml\n[build-system]\nrequires = [\"poetry-core>=1.0.0\"]\nbuild-backend = \"poetry.core.masonry.api\"\n\n[tool.poetry]\nname = \"strfilter\"\nversion = \"0.1.0\"\ndescription = \"A Python library, CLI, and optional HTTP API for filtering lists of strings.\"\nauthors = [\"Your Name <you@example.com>\"]\nlicense = \"MIT\"\nreadme = \"README.md\"\n\n[tool.poetry.dependencies]\npython = \">=3.9,<4.0\"\n\n[tool.poetry.group.dev.dependencies]\npytest = \"^8.0.0\"\npytest-cov = \"^4.1.0\"\nruff = \"^0.3.0\" # Linter/formatter\nmypy = \"^1.8.0\" # Type checker\n\n[tool.poetry.group.http.dependencies]\nfastapi = \"^0.110.0\"\nuvicorn = {extras = [\"standard\"], version = \"^0.28.0\"}\n\n[tool.poetry.scripts]\nstrfilter = \"strfilter.cli:main\"\n\n[tool.pytest.ini_options]\npythonpath = [\"src\"]\naddopts = \"--doctest-modules --cov=src/strfilter --cov-report=term-missing\"\n\n[tool.coverage.run]\nsource = [\"src/strfilter\"]\nbranch = true\n\n[tool.coverage.report]\nexclude_also = [\n    \"if TYPE_CHECKING:\",\n    \"raise NotImplementedError\",\n    \"if __name__ == \\\"__main__\\\":\"\n]\n```\n```python\n# src/strfilter/__init__.py\nimport importlib.metadata\n\ntry:\n    __version__ = importlib.metadata.version(\"strfilter\")\nexcept importlib.metadata.PackageNotFoundError:\n    __version__ = \"0.0.0-dev\" # Fallback if not installed as a package\n```\n```python\n# src/strfilter/config.py\nimport os\nfrom pathlib import Path\nfrom typing import Optional\n\n# Constants\nDEFAULT_REPO_PATH: str = str(Path.home() / \".local\" / \"share\" / \"strfilter\" / \"runs.jsonl\")\nDEFAULT_API_KEY_ENV: str = \"STRFILTER_API_KEY\"\n\ndef get_repo_path() -> str:\n    \"\"\"Return resolved repository path, expanding user and handling environment override.\"\"\"\n    env_path = os.getenv(\"STRFILTER_REPO_PATH\")\n    return str(Path(env_path).expanduser()) if env_path else DEFAULT_REPO_PATH\n\ndef get_api_key() -> Optional[str]:\n    \"\"\"Read API key from environment variable or return None.\"\"\"\n    return os.getenv(DEFAULT_API_KEY_ENV)\n```\n```python\n# src/strfilter/exceptions.py\nclass ValidationError(Exception):\n    \"\"\"Custom exception for invalid inputs.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return self.message\n```\n```python\n# src/strfilter/models.py\nfrom dataclasses import dataclass, field\nfrom datetime import datetime\nfrom typing import List, Dict, Any\nfrom src.strfilter.__init__ import __version__ # Import __version__\n\n@dataclass\nclass FilterRequest:\n    \"\"\"Data model for a filter request.\"\"\"\n    strings: List[str]\n    substring: str\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Serializes the request to a dictionary.\"\"\"\n        return {\"strings\": self.strings, \"substring\": self.substring}\n\n    @classmethod\n    def from_dict(cls, d: Dict[str, Any]) -> \"FilterRequest\":\n        \"\"\"Creates a FilterRequest from a dictionary.\"\"\"\n        return cls(strings=d[\"strings\"], substring=d[\"substring\"])\n\n@dataclass\nclass FilterResult:\n    \"\"\"Data model for a filter result, including metadata.\"\"\"\n    strings: List[str] = field(compare=False) # Original input strings\n    substring: str = field(compare=False)    # Original substring\n    result: List[str]                        # Filtered result\n    timestamp: datetime = field(default_factory=datetime.utcnow, compare=False)\n    version: str = field(default_factory=lambda: __version__, compare=False)\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Serializes the result to a dictionary for persistence.\"\"\"\n        return {\n            \"version\": self.version,\n            \"timestamp\": self.timestamp.isoformat(timespec='seconds') + 'Z',\n            \"request\": {\"strings\": self.strings, \"substring\": self.substring},\n            \"result\": self.result,\n        }\n\n    @classmethod\n    def from_dict(cls, d: Dict[str, Any]) -> \"FilterResult\":\n        \"\"\"Creates a FilterResult from a dictionary.\"\"\"\n        request_data = d.get(\"request\", {})\n        return cls(\n            strings=request_data.get(\"strings\", []),\n            substring=request_data.get(\"substring\", \"\"),\n            result=d.get(\"result\", []),\n            timestamp=datetime.fromisoformat(d[\"timestamp\"].replace('Z', '+00:00')) if \"timestamp\" in d else datetime.utcnow(),\n            version=d.get(\"version\", \"unknown\")\n        )\n```\n```python\n# src/strfilter/utils.py\nfrom typing import List, Any\nfrom src.strfilter.exceptions import ValidationError\n\nclass ValidationUtils:\n    \"\"\"Utility class for input validation.\"\"\"\n\n    @staticmethod\n    def validate_strings(strings: List[Any]) -> None:\n        \"\"\"Ensure input is list-like and each element is a string.\"\"\"\n        if not isinstance(strings, list):\n            raise ValidationError(\"Input 'strings' must be a list.\")\n        for i, s in enumerate(strings):\n            if not isinstance(s, str):\n                raise ValidationError(f\"All items in 'strings' must be strings. Item at index {i} is not a string.\")\n\n    @staticmethod\n    def validate_substring(substring: Any) -> None:\n        \"\"\"Ensure substring is a non-empty string.\"\"\"\n        if not isinstance(substring, str):\n            raise ValidationError(\"'substring' must be a string.\")\n        if not substring: # Checks for empty string\n            raise ValidationError(\"'substring' cannot be empty.\")\n```\n```python\n# src/strfilter/repository.py\nimport json\nimport logging\nfrom pathlib import Path\nfrom typing import List\nfrom src.strfilter.models import FilterResult\n\nlogger = logging.getLogger(__name__)\n\nclass FileRepository:\n    \"\"\"Persistence adapter for storing FilterResult objects in a JSON-lines file.\"\"\"\n\n    def __init__(self, path: str, strict: bool = False):\n        self._path = Path(path).expanduser()\n        self._strict = strict\n        self._path.parent.mkdir(parents=True, exist_ok=True) # Ensure directory exists\n\n    def save(self, result: FilterResult) -> None:\n        \"\"\"Append a FilterResult object as a JSON line to the file.\"\"\"\n        try:\n            with open(self._path, \"a\", encoding=\"utf-8\") as f:\n                json.dump(result.to_dict(), f)\n                f.write(\"\\n\")\n        except IOError as e:\n            msg = f\"Failed to persist filter run to {self._path}: {e}\"\n            logger.error(msg)\n            if self._strict:\n                raise IOError(msg) from e\n\n    def load_all(self) -> List[FilterResult]:\n        \"\"\"Load all FilterResult entries from the file.\"\"\"\n        results: List[FilterResult] = []\n        if not self._path.exists():\n            return results\n\n        try:\n            with open(self._path, \"r\", encoding=\"utf-8\") as f:\n                for line_num, line in enumerate(f, 1):\n                    try:\n                        data = json.loads(line)\n                        results.append(FilterResult.from_dict(data))\n                    except json.JSONDecodeError as e:\n                        logger.warning(f\"Skipping malformed JSON line {line_num} in {self._path}: {e}\")\n                    except KeyError as e:\n                        logger.warning(f\"Skipping incomplete record on line {line_num} in {self._path}: Missing key {e}\")\n        except IOError as e:\n            logger.error(f\"Failed to read filter runs from {self._path}: {e}\")\n            if self._strict:\n                raise\n        return results\n```\n```python\n# src/strfilter/services.py\nfrom typing import List, Optional\nfrom src.strfilter.models import FilterRequest, FilterResult\nfrom src.strfilter.utils import ValidationUtils\nfrom src.strfilter.repository import FileRepository\nfrom src.strfilter.__init__ import __version__ # Use package version\n\nclass StringFilterService:\n    \"\"\"Core business logic for filtering strings.\"\"\"\n\n    def __init__(self, repository: Optional[FileRepository] = None, case_sensitive: bool = True):\n        self._repository = repository\n        self._case_sensitive = case_sensitive\n\n    def filter_by_substring(self, strings: List[str], substring: str) -> List[str]:\n        \"\"\"\n        Validate inputs and return list of strings that contain the given substring.\n        >>> svc = StringFilterService(repository=None, case_sensitive=True)\n        >>> svc.filter_by_substring([], 'a')\n        []\n        >>> svc.filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n        ['abc', 'bacd', 'array']\n        \"\"\"\n        ValidationUtils.validate_strings(strings)\n        ValidationUtils.validate_substring(substring)\n\n        if self._case_sensitive:\n            return [s for s in strings if substring in s]\n        s_sub = substring.lower()\n        return [s for s in strings if s_sub in s.lower()]\n\n    def filter(self, request: FilterRequest) -> FilterResult:\n        \"\"\"\n        Processes a FilterRequest, computes the result, and persists it.\n        \"\"\"\n        # The filter_by_substring method internally handles validation\n        filtered_strings = self.filter_by_substring(request.strings, request.substring)\n\n        result = FilterResult(\n            strings=request.strings,\n            substring=request.substring,\n            result=filtered_strings,\n            version=__version__ # Ensure version is set from package\n        )\n\n        if self._repository:\n            self._repository.save(result)\n\n        return result\n```\n```python\n# src/strfilter/cli.py\nimport argparse\nimport sys\nfrom typing import List, Optional\n\nfrom src.strfilter.config import get_repo_path\nfrom src.strfilter.models import FilterRequest\nfrom src.strfilter.services import StringFilterService\nfrom src.strfilter.repository import FileRepository\nfrom src.strfilter.exceptions import ValidationError\n\nclass CLIController:\n    \"\"\"Command-line interface controller for the string filter.\"\"\"\n\n    def run(self, argv: Optional[List[str]] = None) -> int:\n        \"\"\"\n        Runs the CLI application.\n        Parses arguments, builds a FilterRequest, calls the service, and prints results.\n        \"\"\"\n        if argv is None:\n            argv = sys.argv[1:]\n\n        try:\n            args = self._parse_cli_args(argv)\n\n            input_strings: List[str]\n            if args.strings is not None:\n                input_strings = args.strings\n            else:\n                input_strings = [line.strip() for line in sys.stdin if line.strip()]\n\n            if not args.substring:\n                raise ValidationError(\"Substring cannot be empty.\")\n            if not input_strings:\n                raise ValidationError(\"No input strings provided. Use --strings or pipe input to stdin.\")\n\n            request = FilterRequest(strings=input_strings, substring=args.substring)\n            \n            repository = FileRepository(get_repo_path())\n            service = StringFilterService(repository=repository, case_sensitive=not args.case_insensitive)\n            result = service.filter(request)\n\n            for line in result.result:\n                print(line)\n            return 0\n        except ValidationError as exc:\n            print(f\"Error: {exc}\", file=sys.stderr)\n            return 2\n        except Exception as exc:\n            print(f\"An unexpected error occurred: {exc}\", file=sys.stderr)\n            return 1\n\n    def _parse_cli_args(self, argv: List[str]) -> argparse.Namespace:\n        \"\"\"Internal method to parse command-line arguments using argparse.\"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Filter a list of strings by a substring.\",\n            epilog=\"Example: echo -e 'apple\\\\nbanana' | strfilter --substring app\"\n        )\n        parser.add_argument(\n            \"--substring\",\n            \"-s\",\n            type=str,\n            required=True,\n            help=\"The substring to filter by.\"\n        )\n        parser.add_argument(\n            \"--strings\",\n            \"-l\",\n            nargs=\"*\",\n            type=str,\n            help=\"List of strings to filter. If not provided, reads from stdin.\"\n        )\n        parser.add_argument(\n            \"--case-insensitive\",\n            \"-i\",\n            action=\"store_true\",\n            help=\"Perform case-insensitive matching. Default is case-sensitive.\"\n        )\n\n        args = parser.parse_args(argv)\n        return args\n\ndef main():\n    \"\"\"Entry point for the command-line interface.\"\"\"\n    controller = CLIController()\n    sys.exit(controller.run())\n```\n```python\n# src/strfilter/api.py\nfrom typing import Optional, Dict, Any\nfrom fastapi import FastAPI, Request, HTTPException, Depends, status\nfrom fastapi.security import APIKeyHeader\nimport uvicorn # For example usage\n\nfrom src.strfilter.config import get_api_key, get_repo_path\nfrom src.strfilter.models import FilterRequest, FilterResult\nfrom src.strfilter.services import StringFilterService\nfrom src.strfilter.repository import FileRepository\nfrom src.strfilter.exceptions import ValidationError\nfrom src.strfilter.utils import ValidationUtils # For body validation\n\n# API key header authentication setup\nAPI_KEY_NAME = \"X-API-Key\"\napi_key_header = APIKeyHeader(name=API_KEY_NAME, auto_error=False)\n\nasync def verify_api_key(api_key: Optional[str] = Depends(api_key_header)) -> bool:\n    \"\"\"Verifies the API key if one is configured.\"\"\"\n    configured_api_key = get_api_key()\n    if configured_api_key:\n        if not api_key or api_key != configured_api_key:\n            raise HTTPException(\n                status_code=status.HTTP_401_UNAUTHORIZED,\n                detail=\"Missing or invalid API key\"\n            )\n    return True # API key not required, or it was valid\n\nclass APIController:\n    \"\"\"FastAPI adapter for the filtering service.\"\"\"\n\n    def create_app(self, repository: Optional[FileRepository] = None) -> FastAPI:\n        \"\"\"\n        Builds and returns a FastAPI app with the POST /filter endpoint.\n        \"\"\"\n        app = FastAPI(\n            title=\"String Filter API\",\n            description=\"API to filter lists of strings by a substring.\",\n            version=\"0.1.0\"\n        )\n\n        if repository is None:\n            repository = FileRepository(get_repo_path())\n\n        filter_service = StringFilterService(repository=repository)\n\n        @app.post(\"/filter\", response_model=FilterResult)\n        async def filter_strings_endpoint(\n            request: FilterRequest,\n            auth_ok: bool = Depends(verify_api_key) # API key check\n        ):\n            \"\"\"\n            Filters a list of strings by a substring.\n            \"\"\"\n            try:\n                ValidationUtils.validate_strings(request.strings)\n                ValidationUtils.validate_substring(request.substring)\n\n                return filter_service.filter(request)\n            except ValidationError as e:\n                raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))\n            except Exception as e:\n                raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"Internal server error\")\n\n        return app\n\nif __name__ == \"__main__\":\n    app_controller = APIController()\n    app = app_controller.create_app()\n    uvicorn.run(app, host=\"0.0.0.0\", port=8000)\n```\n```python\n# src/strfilter/__main__.py\nimport sys\nfrom src.strfilter.cli import main\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n```"}
