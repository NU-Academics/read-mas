{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Computes max nesting depth for multiple groups separated by spaces.\"\"\"\n\n    tokens = [tok for tok in paren_string.split() if tok]\n\n    results: List[int] = []\n\n    for group in tokens:\n        current_depth = 0\n        max_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                if current_depth > max_depth:\n                    max_depth = current_depth\n            elif char == ')':\n                current_depth -= 1\n\n        results.append(max_depth)\n\n    return results"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    \"\"\"\n    results: List[int] = []\n    \n    # Tokenize input by whitespace.\n    # An empty string or string with only whitespace will result in an empty list of tokens.\n    tokens = paren_string.split()\n\n    for token in tokens:\n        current_depth = 0\n        max_depth_for_group = 0\n        \n        # Iterate characters to compute max nesting depth for each token.\n        for char in token:\n            if char == '(':\n                current_depth += 1\n                if current_depth > max_depth_for_group:\n                    max_depth_for_group = current_depth\n            elif char == ')':\n                current_depth -= 1\n            # Per critical requirements, no validation or error raising for invalid chars or unbalanced parentheses.\n            # Trust the caller's inputs; simply update depth based on '(' and ')'.\n\n        results.append(max_depth_for_group)\n    \n    return results"}
