{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, this function returns a list of all words from string s that contain exactly n consonants.\n    'y' is treated as a consonant.\n    \"\"\"\n    vowels = \"aeiouAEIOU\"\n    \n    def is_consonant(char):\n        # Checks if a character is a consonant, treating 'y' as one.\n        return char.isalpha() and char.lower() not in vowels\n\n    def count_consonants_in_word(word_text):\n        # Counts the consonants in a word using the is_consonant helper.\n        return sum(1 for char in word_text if is_consonant(char))\n\n    words = s.split() # Splits string into words, handling multiple spaces and stripping leading/trailing.\n    \n    result = []\n    for word in words:\n        if count_consonants_in_word(word) == n:\n            result.append(word)\n            \n    return result"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, returns words from s with exactly n consonants.\n    Words are split by spaces, and consonants are non-vowel letters (A,E,I,O,U are vowels).\n    \"\"\"\n    VOWELS = frozenset({'a', 'e', 'i', 'o', 'u'})\n\n    def _is_consonant(char):\n        \"\"\"Checks if a character is a consonant.\"\"\"\n        return 'a' <= char.lower() <= 'z' and char.lower() not in VOWELS\n\n    def _count_consonants(word_text):\n        \"\"\"Counts consonants in a given word string.\"\"\"\n        count = 0\n        for char in word_text:\n            if _is_consonant(char):\n                count += 1\n        return count\n\n    if not s:\n        return []\n\n    result = []\n    # Tokenize s into words separated by one or more spaces\n    words = s.split()\n    \n    for word in words:\n        # Count consonant letters case-insensitively\n        consonant_count = _count_consonants(word)\n        if consonant_count == n:\n            result.append(word)\n            \n    return result"}
{"task_id": "HumanEval/118", "solution": "```python\ndef get_closest_vowel(word):\n    \"\"\"Finds the rightmost vowel between two consonants in a word, preserving case.\n    Returns an empty string if no such vowel is found.\n    \"\"\"\n    VOWELS = {\"A\", \"E\", \"I\", \"O\", \"U\", \"a\", \"e\", \"i\", \"o\", \"u\"}\n\n    def _is_vowel(ch: str) -> bool:\n        return ch in VOWELS\n\n    def _is_consonant(ch: str) -> bool:\n        # Assuming 'ch' is an English letter as per the problem's assumptions.\n        return ch not in VOWELS\n\n    n = len(word)\n    if n < 3:\n        return \"\"\n\n    # Iterate from the right side, skipping the first and last characters.\n    # The range goes from n-2 (second to last char) down to 1 (second char).\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_neighbor = word[i-1]\n        right_neighbor = word[i+1]\n\n        if _is_vowel(current_char):\n            if _is_consonant(left_neighbor) and _is_consonant(right_neighbor):\n                return current_char\n\n    return \"\"\n```"}
{"task_id": "HumanEval/118", "solution": "```python\ndef get_closest_vowel(word):\n    \"\"\"Finds the closest vowel between two consonants, scanning from the right.\n    Vowels at the start or end of the word are ignored.\n    \"\"\"\n\n    VOWELS = {\"a\", \"e\", \"i\", \"o\", \"u\", \"A\", \"E\", \"I\", \"O\", \"U\"}\n\n    def is_vowel(char):\n        \"\"\"Checks if a character is a vowel.\"\"\"\n        return char in VOWELS\n\n    def is_consonant(char):\n        \"\"\"Checks if a character is a consonant, assuming it's an English letter.\"\"\"\n        return char not in VOWELS\n\n    n = len(word)\n    if n < 3:\n        return \"\"\n\n    # Scan from right to left, excluding the first and last characters.\n    # The loop iterates from index n-2 down to 1 (inclusive).\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        if is_vowel(current_char) and is_consonant(left_char) and is_consonant(right_char):\n            return current_char\n\n    return \"\"\n```"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if two parenthesis-only strings can be concatenated to form a balanced string.\n    Returns 'Yes' or 'No'.\n    \"\"\"\n    def _net_balance(s: str) -> int:\n        \"\"\"Calculates the net balance of parentheses in a string.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:\n                balance -= 1\n        return balance\n\n    def _min_prefix_balance(s: str) -> int:\n        \"\"\"Calculates the minimum prefix balance encountered in a string.\"\"\"\n        balance = 0\n        min_bal = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:\n                balance -= 1\n            min_bal = min(min_bal, balance)\n        return min_bal\n\n    s1 = lst[0]\n    s2 = lst[1]\n\n    # Calculate aggregates for s1\n    net_s1 = _net_balance(s1)\n    min_prefix_s1 = _min_prefix_balance(s1)\n\n    # Calculate aggregates for s2\n    net_s2 = _net_balance(s2)\n    min_prefix_s2 = _min_prefix_balance(s2)\n\n    # Check if s1 + s2 forms a balanced string using aggregate properties\n    is_s1_s2_balanced = (\n        min_prefix_s1 >= 0 and\n        (min_prefix_s2 + net_s1) >= 0 and\n        (net_s1 + net_s2) == 0\n    )\n    if is_s1_s2_balanced:\n        return 'Yes'\n\n    # Check if s2 + s1 forms a balanced string using aggregate properties\n    is_s2_s1_balanced = (\n        min_prefix_s2 >= 0 and\n        (min_prefix_s1 + net_s2) >= 0 and\n        (net_s2 + net_s1) == 0\n    )\n    if is_s2_s1_balanced:\n        return 'Yes'\n\n    return 'No'"}
{"task_id": "HumanEval/120", "solution": "```python\nimport heapq\n\ndef maximum(arr, k):\n    \"\"\"\n    Returns a sorted list of the maximum k numbers from the input array.\n    Assumes valid inputs as per problem constraints.\n    \"\"\"\n    if k == 0:\n        return []\n    \n    # Efficiently find the k largest elements using a heap.\n    # The result from heapq.nlargest is unsorted, so it needs a final sort.\n    largest_k_elements = heapq.nlargest(k, arr)\n    \n    return sorted(largest_k_elements)\n```"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if two parentheses-only strings can form a balanced string when concatenated.\n    Returns 'Yes' if possible, 'No' otherwise.\n    \"\"\"\n\n    class ParenthesisString:\n        \"\"\"Represents a parentheses string and computes its balance metrics.\"\"\"\n        def __init__(self, data):\n            self._data = data\n            self._total = 0\n            self._min_prefix = 0\n            self.compute_metrics()\n\n        def compute_metrics(self):\n            \"\"\"Computes and stores the total balance and minimum prefix balance.\"\"\"\n            bal = 0\n            min_pref = 0\n            for ch in self._data:\n                bal += 1 if ch == '(' else -1\n                min_pref = min(min_pref, bal)\n            self._total = bal\n            self._min_prefix = min_pref\n\n        def total_balance(self):\n            \"\"\"Returns the computed total balance.\"\"\"\n            return self._total\n\n        def min_prefix(self):\n            \"\"\"Returns the computed minimum prefix balance.\"\"\"\n            return self._min_prefix\n\n    s1_data, s2_data = lst\n    a_obj = ParenthesisString(s1_data)\n    b_obj = ParenthesisString(s2_data)\n\n    # The total balance must be zero for the concatenated string to be balanced.\n    if a_obj.total_balance() + b_obj.total_balance() != 0:\n        return 'No'\n\n    # Check concatenation order: A then B.\n    # Both A's prefixes and B's prefixes (shifted by A's total) must remain non-negative.\n    cond_ab = (a_obj.min_prefix() >= 0 and\n               b_obj.min_prefix() + a_obj.total_balance() >= 0)\n\n    # Check concatenation order: B then A.\n    # Both B's prefixes and A's prefixes (shifted by B's total) must remain non-negative.\n    cond_ba = (b_obj.min_prefix() >= 0 and\n               a_obj.min_prefix() + b_obj.total_balance() >= 0)\n\n    if cond_ab or cond_ba:\n        return 'Yes'\n    else:\n        return 'No'"}
