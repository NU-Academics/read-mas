troller_factory is None:\n            # Default factory for production use\n            def default_factory():\n                repo = FizzBuzzRepository()\n                service = FizzBuzzService(repo)\n                return CLIController(service)\n            self._controller_factory = default_factory\n\n    def run(self, argv: Optional[List[str]] = None) -> int:\n        \"\"\"Parses CLI args, delegates to controller, prints result, handles errors, and returns exit code.\"\"\"\n        configure_logging() # Configure basic logging for CLI\n        parser = argparse.ArgumentParser(\n            prog=\"fizzbuzz\",\n            description=\"Counts occurrences of the digit '7' in numbers divisible by 11 or 13.\"\n        )\n\n        subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\")\n\n        # Count command\n        count_parser = subparsers.add_parser(\n            \"count\",\n            help=\"Computes the count of '7's for a given n.\"\n        )\n        count_parser.add_argument(\n            \"--n\",\n            type=int,\n            required=True,\n            help=\"Upper bound (exclusive) for integers to check. Must be non-negative.\"\n        )\n\n        args = parser.parse_args(argv)\n\n        if args.command == \"count\":\n            controller = self._controller_factory()\n            try:\n                # The service and controller handle validation, but argparse also ensures type=int\n                # Additional non-negative check for consistency with API/service\n                if not isinstance(args.n, int) or args.n < 0:\n                    raise ValidationError(\"Parameter 'n' must be a non-negative integer.\")\n\n                result = controller.handle_count(args.n)\n                self._print_result(result.count)\n                return 0\n            except ValidationError as e:\n                print(f\"Error: {e.message}\", file=sys.stderr)\n                return 1\n            except ServiceError as e:\n                print(f\"Service Error: {e.message}\", file=sys.stderr)\n                return 1\n            except Exception as e:\n                print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n                return 1\n        else:\n            parser.print_help(sys.stderr)\n            return 1\n\n    def _print_result(self, count: int) -> None:\n        \"\"\"Prints the computed count to standard output.\"\"\"\n        print(count)\n\n```\n\nsrc/fizzbuzz/controllers.py\n```python\nfrom fizzbuzz.services import FizzBuzzService\nfrom fizzbuzz.models import CountResult\nfrom fizzbuzz.exceptions import ValidationError, ServiceError\n\nclass CLIController:\n    \"\"\"Bridges CLI inputs to the FizzBuzzService and formats outputs.\"\"\"\n    def __init__(self, service: FizzBuzzService) -> None:\n        self._service = service\n\n    def handle_count(self, n: int) -> CountResult:\n        \"\"\"Calls the service to compute the count and wraps it in a CountResult.\"\"\"\n        try:\n            count = self._service.count_sevens(n)\n            return CountResult(n=n, count=count)\n        except ValidationError as e:\n            raise e # Re-raise for CLIApp to handle specific display\n        except ServiceError as e:\n            raise e # Re-raise for CLIApp to handle specific display\n        except Exception as e:\n            # Catch unexpected errors and wrap them in a generic ServiceError\n            raise ServiceError(f\"An unexpected error occurred: {e}\")\n\n```\n\nsrc/fizzbuzz/api.py\n```python\nfrom fastapi import FastAPI, HTTPException, status\nfrom fizzbuzz.services import FizzBuzzService\nfrom fizzbuzz.models import CountResult\nfrom fizzbuzz.exceptions import ValidationError, ServiceError\nfrom fizzbuzz.config import AppConfig\nfrom fizzbuzz.utils import is_non_negative_int # for path param validation\nimport logging\n\nlogger = logging.getLogger(__name__)\n\nclass APIController:\n    \"\"\"FastAPI application and HTTP controller for the counting service.\"\"\"\n    def __init__(self, service: FizzBuzzService, config: AppConfig):\n        self.app = FastAPI(\n            title=\"FizzBuzz Counter API\",\n            description=\"API to count occurrences of '7' in specific integers.\",\n            version=\"0.1.0\",\n            debug=config.debug\n        )\n        self._service = service\n        self._config = config\n        self.register_routes()\n\n    def register_routes(self):\n        \"\"\"Registers the API routes with the FastAPI application.\"\"\"\n        @self.app.get(\n            \"/count\",\n            response_model=CountResult,\n            summary=\"Count '7's in multiples of 11 or 13\",\n            description=\"Returns the total count of the digit '7' in numbers x (0 <= x < n) \"\n                        \"that are divisible by 11 or 13.\",\n            response_description=\"The count of '7's and the input 'n'.\"\n        )\n        async def get_count(\n            n: int # FastAPI handles int parsing and basic type validation\n        ):\n            # Additional validation for n being non-negative, as FastAPI only checks type by default\n            if not is_non_negative_int(n):\n                raise HTTPException(\n                    status_code=status.HTTP_400_BAD_REQUEST,\n                    detail=\"Parameter 'n' must be a non-negative integer.\"\n                )\n            if n > self._config.max_n:\n                raise HTTPException(\n                    status_code=status.HTTP_400_BAD_REQUEST,\n                    detail=f\"Parameter 'n' exceeds maximum allowed value of {self._config.max_n}.\"\n                )\n\n            try:\n                cnt = self._service.count_sevens(n)\n                return CountResult(n=n, count=cnt)\n            except ValidationError as e:\n                raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=e.message)\n            except ServiceError as e:\n                logger.error(f\"Service error for n={n}: {e.message}\", exc_info=True)\n                raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"Internal server error\")\n            except Exception as e:\n                logger.error(f\"Unhandled exception for n={n}: {e}\", exc_info=True)\n                raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"Internal server error\")\n\n```\n\nsrc/fizzbuzz/services.py\n```python\nfrom fizzbuzz.repository import FizzBuzzRepository\nfrom fizzbuzz.exceptions import ValidationError, ServiceError\nfrom fizzbuzz.utils import is_non_negative_int\nimport logging\n\nlogger = logging.getLogger(__name__)\n\nclass FizzBuzzService:\n    \"\"\"Implements the core logic for counting '7's in FizzBuzz-like numbers.\n    Orchestrates validation and number iteration.\"\"\"\n    def __init__(self, repo: FizzBuzzRepository) -> None:\n        self._repo = repo\n\n    def count_sevens(self, n: int) -> int:\n        \"\"\"Counts occurrences of digit '7' in eligible integers x (0 <= x < n, divisible by 11 or 13).\"\"\"\n        if not is_non_negative_int(n):\n            raise ValidationError(\"n must be a non-negative integer\")\n\n        total = 0\n        try:\n            for x in self._repo.multiples_under(n):\n                total += self._count_in_number(x)\n            return total\n        except Exception as e:\n            logger.exception(\"An unexpected error occurred during counting.\")\n            raise ServiceError(f\"Failed to compute count for n={n}: {e}\")\n\n    def _count_in_number(self, x: int) -> int:\n        \"\"\"Counts occurrences of the digit '7' in the decimal representation of x.\"\"\"\n        return str(x).count(\"7\")\n\n```\n\nsrc/fizzbuzz/repository.py\n```python\nfrom typing import Iterable, Dict\n\nclass FizzBuzzRepository:\n    \"\"\"Provides sequences of candidate integers under n.\n    Abstracts iteration for testability and potential caching.\"\"\"\n 