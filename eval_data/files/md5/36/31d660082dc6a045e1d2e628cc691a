sert stdout.getvalue() == \"\"\n\n    def test_main_argparse_error(self, capture_stdout_stderr):\n        \"\"\"Tests that argparse errors (e.g., missing argument) result in exit code 2.\"\"\"\n        stdout, stderr = capture_stdout_stderr\n        \n        with pytest.raises(SystemExit) as excinfo:\n            main(argv=[]) # No arguments provided\n        \n        assert excinfo.value.code == 2\n        assert \"the following arguments are required: input_str\" in stderr.getvalue()\n        assert stdout.getvalue() == \"\"\n\n```\n```python\n# tests/test_api.py\n\"\"\"\nUnit tests for the public API function `count_upper`.\n\"\"\"\nimport pytest\nfrom count_upper_app import count_upper, InvalidInputError\n\ndef test_count_upper_examples():\n    \"\"\"Tests the public API with provided examples.\"\"\"\n    assert count_upper(\"aBCdEf\") == 1\n    assert count_upper(\"abcdefg\") == 0\n    assert count_upper(\"dBBE\") == 0\n\ndef test_count_upper_empty_string():\n    \"\"\"Tests the public API with an empty string.\"\"\"\n    assert count_upper(\"\") == 0\n\ndef test_count_upper_all_uppercase_vowels_even_indices():\n    \"\"\"Tests the public API with strings having uppercase vowels at even indices.\"\"\"\n    assert count_upper(\"A\") == 1\n    assert count_upper(\"AEIOU\") == 3\n    assert count_upper(\"AaEeIiOoUu\") == 5\n\ndef test_count_upper_no_vowels():\n    \"\"\"Tests the public API with strings having no vowels.\"\"\"\n    assert count_upper(\"BCDFG\") == 0\n    assert count_upper(\"bcdfgh\") == 0\n\ndef test_count_upper_invalid_input_type():\n    \"\"\"Tests that non-string inputs raise InvalidInputError for the public API.\"\"\"\n    with pytest.raises(InvalidInputError, match=\"Input must be a string.\"):\n        count_upper(None)\n    with pytest.raises(InvalidInputError, match=\"Input must be a string.\"):\n        count_upper(123)\n    with pytest.raises(InvalidInputError, match=\"Input must be a string.\"):\n        count_upper(['A', 'B'])\n\n``