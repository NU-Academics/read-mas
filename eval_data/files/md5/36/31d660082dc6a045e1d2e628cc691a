d) -> None:\n        \"\"\"Inserts a usage record into the database.\"\"\"\n        sql = \"INSERT INTO usage_records (input_preview, length, created_at) VALUES (?, ?, ?)\"\n        try:\n            with self._db.connect() as conn:\n                conn.execute(sql, record.to_tuple())\n                conn.commit()\n        except sqlite3.Error as e:\n            raise RepositoryError(f\"Failed to save usage record: {e}\")\n\n    def get_recent(self, limit: int = 100) -> List[UsageRecord]:\n        \"\"\"Retrieves recent usage records from the database.\"\"\"\n        sql = \"SELECT id, input_preview, length, created_at FROM usage_records ORDER BY created_at DESC LIMIT ?\"\n        records: List[UsageRecord] = []\n        try:\n            with self._db.connect() as conn:\n                cursor = conn.execute(sql, (limit,))\n                for row in cursor:\n                    records.append(self._to_usage_record(row))\n        except sqlite3.Error as e:\n            raise RepositoryError(f\"Failed to retrieve recent usage records: {e}\")\n        return records\n\n    def _to_usage_record(self, row: sqlite3.Row) -> UsageRecord:\n        \"\"\"Converts a database row to a UsageRecord object.\"\"\"\n        return UsageRecord(\n            id=row[\"id\"],\n            input_preview=row[\"input_preview\"],\n            length=row[\"length\"],\n            created_at=datetime.fromisoformat(row[\"created_at\"])\n        )\n\n# src/strlen_service/StringService.py\nimport logging\nfrom typing import Optional\nfrom .Utils import validate_string, normalize_text\nfrom .models.UsageRecord import UsageRecord\nfrom .models.StringResponse import StringResponse\nfrom .Exceptions import InvalidInputError, RepositoryError\nfrom .StringRepository import StringRepository\nfrom .Config import Config # Import the Config module\n\nlogger = logging.getLogger(__name__)\n\nclass StringService:\n    \"\"\"Encapsulates business logic for string length computation and recording.\"\"\"\n    def __init__(self, repo: Optional[StringRepository], config: type[Config]) -> None:\n        self._repo = repo\n        self._config = config\n\n    def compute_length(self, text: str) -> int:\n        \"\"\"Validates, normalizes, and computes the length of a string.\"\"\"\n        validate_string(text, self._config.MAX_TEXT_LENGTH)\n        normalized = normalize_text(text)\n        return len(normalized)\n\n    def compute_and_record(self, text: str) -> StringResponse:\n        \"\"\"Computes string length, optionally records usage, and returns a StringResponse.\"\"\"\n        validate_string(text, self._config.MAX_TEXT_LENGTH)\n        normalized = normalize_text(text)\n        length = len(normalized)\n\n        if self._config.PERSISTENCE_ENABLED and self._repo:\n            preview = normalized[:256] # Per spec: first 256 chars for preview\n            record = UsageRecord(id=None, input_preview=preview, length=length, created_at=None)\n            try:\n                self._repo.save_record(record)\n            except RepositoryError as e:\n                logger.error(f\"Failed to persist usage record for text preview '{preview}': {e}\")\n                # NFR3: Persistence failures must not affect ability to compute length.\n                # NFR5: Log error details.\n\n        return StringResponse(length=length, normalized=normalized)\n\n# src/strlen_service/StringController.py\nimport logging\nfrom fastapi import FastAPI, HTTPException, Header, Response, status\nfrom fastapi.responses import JSONResponse\nfrom typing import Optional\nfrom .StringService import StringService\nfrom .models.StringRequest import StringRequest\nfrom .models.StringResponse import StringResponse\nfrom .Exceptions import InvalidInputError, RepositoryError\nfrom .Config import Config # Import the Config module\n\nlogger = logging.getLogger(__name__)\n\nclass StringController:\n    \"\"\"HTTP adapter for the StringService, using FastAPI.\"\"\"\n    def __init__(self, service: StringService, config: type[Config]) -> None:\n        self._service = service\n        self._config = config\n\n    def register_routes(self, app: FastAPI) -> None:\n        \"\"\"Registers the /strlen endpoint with the FastAPI application.\"\"\"\n        @app.post(\"/strlen\", response_model=StringResponse)\n        async def post_strlen(\n            payload: dict,\n            x_api_key: Optional[str] = Header(None)\n        ) -> JSONResponse:\n            \"\"\"\n            Computes the length of a provided string.\n            Optionally requires an API key for authentication.\n            \"\"\"\n            if self._config.API_KEY_ENABLED:\n                if not x_api_key or x_api_key != self._config.API_KEY:\n                    raise HTTPException(\n                        status_code=status.HTTP_401_UNAUTHORIZED,\n                        detail=\"Invalid or missing API key\"\n                    )\n\n            try:\n                request = StringRequest.from_dict(payload)\n                response = self._service.compute_and_record(request.text)\n                return JSONResponse(content=response.to_dict(), status_code=status.HTTP_200_OK)\n            except InvalidInputError as e:\n                logger.warning(f\"Invalid input received: {e.message}\")\n                raise HTTPException(\n                    status_code=status.HTTP_400_BAD_REQUEST,\n                    detail=f\"Invalid input: {e.message}\"\n                )\n            except Exception as e: # Catch other unexpected errors, including RepositoryError\n                logger.error(f\"An unexpected error occurred: {e}\", exc_info=True)\n                # NFR3 Reliability: Persistence failures do not block length computation.\n                # But here we catch any error during `compute_and_record` which might include\n                # a RepositoryError that was caught internally and logged, so this is a general catch.\n                raise HTTPException(\n                    status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                    detail=\"An internal server error occurred.\"\n                )\n\n# src/strlen_service/CLIController.py\nimport sys\nimport click\nimport logging\nfrom typing import Optional\nfrom .StringService import StringService\nfrom .Exceptions import InvalidInputError, RepositoryError\nfrom .Config import Config # Import the Config module\n\nlogger = logging.getLogger(__name__)\n\nclass CLIController:\n    \"\"\"CLI adapter for the StringService, using Click.\"\"\"\n    def __init__(self, service: StringService) -> None:\n        self._service = service\n\n    def run_cli(self, text: Optional[str]) -> int:\n        \"\"\"Entrypoint for the CLI command.\"\"\"\n        try:\n            input_text = text\n            if input_text is None:\n                # If --text is not provided, read from stdin\n                click.echo(\"Enter text (Ctrl+D to finish):\", err=True)\n                input_text = sys.stdin.read().strip()\n                if not input_text:\n                    raise InvalidInputError(\"No text provided via argument or stdin.\")\n\n            response = self._service.compute_and_record(input_text)\n            click.echo(response.length)\n            return 0\n        except InvalidInputError as e:\n            click.echo(f\"Error: {e.message}\", err=True)\n            return 2 # Non-zero for invalid input\n        except Exception as e:\n            logger.error(f\"An unexpected CLI error occurred: {e}\", exc_info=True)\n            click.echo(f\"An unexpected error occurred: {e}\", err=True)\n            return 1 # Generic error code\n\n# src/strlen_service/__init__.py\nimport logging\nfrom .Config import Config, DEFAULT_DB_PATH, PERSISTENCE_ENABLED # Import Config module directly for attributes\nfrom .StringService import StringService\nfrom .Database import Database\nfrom .StringRepository import StringRepository\nfrom .Exceptions import InvalidInputError # Export for library