{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Returns an ordered version of input string where each word's characters are sorted by ASCII value.\n    Preserves original word order and all blank-space sequences.\n    \"\"\"\n\n    class Token:\n        def __init__(self, text: str):\n            self.text = text\n        def render(self) -> str:\n            raise NotImplementedError\n\n    class WordToken(Token):\n        def __init__(self, original: str):\n            super().__init__(original)\n            self.original = original\n            self.sorted_text: str | None = None\n\n        def set_sorted(self, sorted_text: str) -> None:\n            self.sorted_text = sorted_text\n\n        def render(self) -> str:\n            return self.sorted_text if self.sorted_text is not None else self.original\n\n    class SpaceToken(Token):\n        def __init__(self, spaces: str):\n            super().__init__(spaces)\n            self.spaces = spaces\n\n        def render(self) -> str:\n            return self.spaces\n\n    def _is_space(ch: str) -> bool:\n        \"\"\"Checks if a character is an ASCII space.\"\"\"\n        return ch == ' '\n\n    def _sort_chars(text_to_sort: str) -> str:\n        \"\"\"Sorts characters in a string by their ASCII value.\"\"\"\n        return \"\".join(sorted(text_to_sort, key=ord))\n\n    def _tokenize(text: str) -> list[Token]:\n        \"\"\"Splits the input text into WordToken and SpaceToken objects.\"\"\"\n        tokens = []\n        i = 0\n        n = len(text)\n        while i < n:\n            if _is_space(text[i]):\n                j = i\n                while j < n and _is_space(text[j]):\n                    j += 1\n                tokens.append(SpaceToken(text[i:j]))\n                i = j\n            else:\n                j = i\n                while j < n and not _is_space(text[j]):\n                    j += 1\n                tokens.append(WordToken(text[i:j]))\n                i = j\n        return tokens\n\n    def _recompose(tokens: list[Token]) -> str:\n        \"\"\"Reconstructs a string from a list of Token objects.\"\"\"\n        return \"\".join(t.render() for t in tokens)\n\n    processed_tokens = _tokenize(s)\n\n    for token in processed_tokens:\n        if isinstance(token, WordToken):\n            sorted_word = _sort_chars(token.original)\n            token.set_sorted(sorted_word)\n\n    return _recompose(processed_tokens)"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Transforms a string by sorting characters within each word while preserving word order and whitespace.\n    Words are separated by ASCII space characters.\n    \"\"\"\n\n    def split_preserve_spaces_inline(text: str) -> list[str]:\n        # Splits the text into tokens, preserving sequences of spaces and non-spaces.\n        tokens = []\n        buf = []\n        is_space = None\n        for ch in text:\n            current_space = ch.isspace()\n            if is_space is None:\n                is_space = current_space\n            if current_space == is_space:\n                buf.append(ch)\n            else:\n                tokens.append(''.join(buf))\n                buf = [ch]\n                is_space = current_space\n        if buf:\n            tokens.append(''.join(buf))\n        return tokens\n\n    def sort_word_ascii_inline(word: str) -> str:\n        # Sorts characters in a word by their ASCII/Unicode code point values.\n        return ''.join(sorted(word, key=lambda c: ord(c)))\n\n    tokens = split_preserve_spaces_inline(s)\n    transformed_tokens = []\n    for t in tokens:\n        if t and not t.isspace():\n            transformed_tokens.append(sort_word_ascii_inline(t))\n        else:\n            transformed_tokens.append(t)\n    return ''.join(transformed_tokens)"}
{"task_id": "HumanEval/87", "solution": "```python\nfrom typing import List, Tuple\n\ndef get_row(lst: List[List[int]], x: int) -> List[Tuple[int, int]]:\n    \"\"\"\n    Locates all occurrences of integer x in a nested list and returns their coordinates.\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    result: List[Tuple[int, int]] = []\n    for row_idx, row in enumerate(lst):\n        matching_cols = []\n        for col_idx, cell_value in enumerate(row):\n            if cell_value == x:\n                matching_cols.append(col_idx)\n\n        matching_cols.sort(reverse=True)\n        for col in matching_cols:\n            result.append((row_idx, col))\n    return result\n```"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds all occurrences of an integer x in a nested list and returns their coordinates.\n    Coordinates are sorted by row ascending, and by column descending within each row.\n    \"\"\"\n    coordinates = []\n    for r_idx, row in enumerate(lst):\n        cols_found = [c_idx for c_idx, val in enumerate(row) if val == x]\n        cols_found.sort(reverse=True)\n        for c_idx in cols_found:\n            coordinates.append((r_idx, c_idx))\n    return coordinates"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting.\n    Sort ascending if sum of first and last elements is odd, descending if even.\n    \"\"\"\n    if len(array) <= 1:\n        return list(array)\n\n    first_element = array[0]\n    last_element = array[-1]\n    \n    total_sum = first_element + last_element\n    \n    # If the sum is odd, sort in ascending order (default behavior of sorted)\n    # If the sum is even, sort in descending order (reverse=True)\n    ascending = (total_sum % 2 != 0)\n    \n    return sorted(list(array), reverse=not ascending)"}
{"task_id": "HumanEval/88", "solution": "```python\ndef sort_array(array):\n    \"\"\"\n    Sorts a copy of the array based on the parity of the sum of its first and last elements.\n    Returns the sorted copy without modifying the original array.\n    \"\"\"\n    arr_copy = list(array)\n\n    if len(arr_copy) <= 1:\n        return arr_copy\n\n    first_element = arr_copy[0]\n    last_element = arr_copy[-1]\n    \n    sum_first_last = first_element + last_element\n\n    if sum_first_last % 2 == 1:  # Odd sum, sort ascending\n        return sorted(arr_copy)\n    else:  # Even sum, sort descending\n        return sorted(arr_copy, reverse=True)\n\n```"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating alphabetic characters by a fixed shift of 4.\n    Non-alphabetic characters remain unchanged, and case is preserved.\"\"\"\n    result = []\n    shift = 4\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            start_ord = ord('a')\n            shifted_ord = start_ord + (ord(char) - start_ord + shift) % 26\n            result.append(chr(shifted_ord))\n        elif 'A' <= char <= 'Z':\n            start_ord = ord('A')\n            shifted_ord = start_ord + (ord(char) - start_ord + shift) % 26\n            result.append(chr(shifted_ord))\n        else:\n            result.append(char)\n    return \"\".join(result)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating each alphabetical character forward by 4 positions.\n    Case is preserved, and non-alphabetic characters remain unchanged.\n    \"\"\"\n    result = []\n    shift = 4\n    alphabet_lower = 'abcdefghijklmnopqrstuvwxyz'\n    alphabet_upper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            original_index = alphabet_lower.index(char)\n            shifted_index = (original_index + shift) % 26\n            result.append(alphabet_lower[shifted_index])\n        elif 'A' <= char <= 'Z':\n            original_index = alphabet_upper.index(char)\n            shifted_index = (original_index + shift) % 26\n            result.append(alphabet_upper[shifted_index])\n        else:\n            result.append(char)\n    return \"\".join(result)"}
