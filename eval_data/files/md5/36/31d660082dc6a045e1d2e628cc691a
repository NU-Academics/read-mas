{"task_id": "HumanEval/160", "solution": "```python\nfrom typing import List, Union, Callable, Dict, Tuple\nimport collections\n\nclass OperatorMeta:\n    \"\"\"Stores metadata for an operator, including its symbol, precedence, associativity, and function.\"\"\"\n    def __init__(self, symbol: str, precedence: int, associativity: str, func: Callable[[int, int], int]):\n        self.symbol = symbol\n        self.precedence = precedence\n        self.associativity = associativity\n        self.func = func\n\nclass OperatorRegistry:\n    \"\"\"Manages a registry of allowed operators and their associated metadata and functions.\"\"\"\n    def __init__(self):\n        # Operator functions are defined directly; division by zero is handled by Python's native operator.\n        self._operators: Dict[str, OperatorMeta] = {\n            '+': OperatorMeta('+', 1, 'left', lambda a, b: a + b),\n            '-': OperatorMeta('-', 1, 'left', lambda a, b: a - b),\n            '*': OperatorMeta('*', 2, 'left', lambda a, b: a * b),\n            '//': OperatorMeta('//', 2, 'left', lambda a, b: a // b),\n            '**': OperatorMeta('**', 3, 'right', lambda a, b: pow(a, b)),\n        }\n\n    def get(self, symbol: str) -> OperatorMeta:\n        \"\"\"Retrieves the OperatorMeta object for a given operator symbol.\"\"\"\n        return self._operators[symbol]\n\nclass Node:\n    \"\"\"Base class for Abstract Syntax Tree (AST) nodes.\"\"\"\n    def evaluate(self, evaluator: 'Evaluator') -> int:\n        \"\"\"Evaluates the node within the context of an evaluator.\"\"\"\n        raise NotImplementedError\n\nclass ValueNode(Node):\n    \"\"\"Represents a numeric leaf node in the AST.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def evaluate(self, evaluator: 'Evaluator') -> int:\n        \"\"\"Delegates evaluation of a value node to the evaluator.\"\"\"\n        return evaluator._eval_value(self)\n\nclass BinaryOpNode(Node):\n    \"\"\"Represents a binary operation node in the AST, with an operator and left/right children.\"\"\"\n    def __init__(self, operator: str, left: Node, right: Node):\n        self.operator = operator\n        self.left = left\n        self.right = right\n\n    def evaluate(self, evaluator: 'Evaluator') -> int:\n        \"\"\"Delegates evaluation of a binary operation node to the evaluator.\"\"\"\n        return evaluator._eval_binary(self)\n\nclass Evaluator:\n    \"\"\"Recursively evaluates an Abstract Syntax Tree to compute the final integer result.\"\"\"\n    def __init__(self, registry: OperatorRegistry):\n        self._registry = registry\n\n    def evaluate(self, node: Node) -> int:\n        \"\"\"Entry point for evaluating an AST node, dispatching to specific handlers.\"\"\"\n        return node.evaluate(self)\n\n    def _eval_value(self, node: ValueNode) -> int:\n        \"\"\"Evaluates a ValueNode by returning its contained integer value.\"\"\"\n        return node.value\n\n    def _eval_binary(self, node: BinaryOpNode) -> int:\n        \"\"\"Evaluates a BinaryOpNode by evaluating its children and applying the operator's function.\"\"\"\n        left_val = self.evaluate(node.left)\n        right_val = self.evaluate(node.right)\n        meta = self._registry.get(node.operator)\n        return meta.func(left_val, right_val)\n\nclass Parser:\n    \"\"\"Converts lists of operators and operands into an Abstract Syntax Tree (AST) using the Shunting-Yard algorithm.\"\"\"\n    def __init__(self, registry: OperatorRegistry):\n        self._registry = registry\n\n    def parse(self, operators: List[str], operands: List[int]) -> Node:\n        \"\"\"Parses the given operator and operand lists into a complete AST.\"\"\"\n        tokens = self._to_tokens(operators, operands)\n        postfix_tokens = self._shunting_yard(tokens)\n        return self._build_ast(postfix_tokens)\n\n    def _to_tokens(self, operators: List[str], operands: List[int]) -> List[Tuple[str, Union[str, int]]]:\n        \"\"\"Interleaves operands and operators into a flat list of (type, value) tokens.\"\"\"\n        tokens = []\n        for i in range(len(operands)):\n            tokens.append(('NUM', operands[i]))\n            if i < len(operators):\n                tokens.append(('OP', operators[i]))\n        return tokens\n\n    def _shunting_yard(self, tokens: List[Tuple[str, Union[str, int]]]) -> List[Tuple[str, Union[str, int]]]:\n        \"\"\"Applies the Shunting-Yard algorithm to convert an infix token list to postfix (RPN).\"\"\"\n        output_queue = collections.deque()\n        operator_stack = collections.deque()\n\n        for token_type, token_value in tokens:\n            if token_type == 'NUM':\n                output_queue.append((token_type, token_value))\n            elif token_type == 'OP':\n                op1 = self._registry.get(token_value)\n                while operator_stack:\n                    top_op_type, top_op_value = operator_stack[-1]\n                    if top_op_type == 'OP':\n                        op2 = self._registry.get(top_op_value)\n                        # Pop operator from stack if op1 has lower or equal precedence (left-associative)\n                        # or strictly lower precedence (right-associative)\n                        if (op1.associativity == 'left' and op1.precedence <= op2.precedence) or \\\n                           (op1.associativity == 'right' and op1.precedence < op2.precedence):\n                            output_queue.append(operator_stack.pop())\n                        else:\n                            break\n                    else:\n                        break\n                operator_stack.append((token_type, token_value))\n\n        while operator_stack:\n            output_queue.append(operator_stack.pop())\n        return list(output_queue)\n\n    def _build_ast(self, postfix_tokens: List[Tuple[str, Union[str, int]]]) -> Node:\n        \"\"\"Constructs an Abstract Syntax Tree from a list of postfix tokens.\"\"\"\n        stack = collections.deque()\n        for token_type, token_value in postfix_tokens:\n            if token_type == 'NUM':\n                stack.append(ValueNode(token_value))\n            elif token_type == 'OP':\n                # Assumes valid postfix expression, stack will have at least two elements.\n                right = stack.pop()\n                left = stack.pop()\n                stack.append(BinaryOpNode(token_value, left, right))\n        return stack.pop() # The final element on the stack is the root of the AST.\n\ndef do_algebra(operator: List[str], operand: List[int]) -> int:\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n    registry = OperatorRegistry()\n    parser = Parser(registry)\n    evaluator = Evaluator(registry)\n\n    ast_root = parser.parse(operator, operand)\n    result = evaluator.evaluate(ast_root)\n    return result\n```"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Applies a transformation: toggles letter case or reverses the string if no letters.\"\"\"\n    has_any_letter = False\n    for char_s in s:\n        if char_s.isalpha():\n            has_any_letter = True\n            break\n\n    if not has_any_letter:\n        return s[::-1]\n    else:\n        transformed_chars = []\n        for char_s in s:\n            if char_s.isalpha():\n                transformed_chars.append(char_s.swapcase())\n            else:\n                transformed_chars.append(char_s)\n        return \"\".join(transformed_chars)"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Transforms a string based on letter presence: reverses case for letters if any are present, else reverses the whole string.\n    This function processes each character for case modification or performs a full string reversal.\n    \"\"\"\n    contains_letter = False\n    for char_s in s:\n        if char_s.isalpha():\n            contains_letter = True\n            break\n\n    if not contains_letter:\n        return s[::-1]\n    else:\n        transformed_chars = []\n        for char_s in s:\n            if char_s.isalpha():\n                if char_s.islower():\n                    transformed_chars.append(char_s.upper())\n                elif char_s.isupper():\n                    transformed_chars.append(char_s.lower())\n                else:\n                    transformed_chars.append(char_s)\n            else:\n                transformed_chars.append(char_s)\n        return \"\".join(transformed_chars)"}
{"task_id": "HumanEval/162", "solution": "```python\nimport hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string, returns its MD5 hash or None if empty.\n    The hash is a 32-character lowercase hex string.\n    \"\"\"\n    if text == \"\":\n        return None\n    # Trusting input is str and encoding as UTF-8 as per design.\n    bytes_data = text.encode(\"utf-8\")\n    return hashlib.md5(bytes_data).hexdigest()\n```"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two integers a and b, return all even integers between a and b inclusive, in ascending order.\n    The order of a and b does not matter.\n    \"\"\"\n    _start = min(a, b)\n    _end = max(a, b)\n\n    first_even = _start if _start % 2 == 0 else _start + 1\n\n    if first_even > _end:\n        return []\n\n    return list(range(first_even, _end + 1, 2))"}
{"task_id": "HumanEval/162", "solution": "```python\nimport hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if text == \"\":\n        return None\n    # Compute the MD5 hash of the UTF-8 encoded text and return as lowercase hex.\n    md5_hash = hashlib.md5(text.encode(\"utf-8\")).hexdigest().lower()\n    return md5_hash\n```"}
{"task_id": "HumanEval/163", "solution": "```python\ndef generate_integers(a, b):\n    \"\"\"\n    Returns all even single-digit integers between a and b, inclusive and in ascending order.\n    This function assumes valid positive integer inputs for a and b.\n    \"\"\"\n    lower_bound = min(a, b)\n    upper_bound = max(a, b)\n\n    allowed_even_digits = [0, 2, 4, 6, 8]\n    \n    result = []\n    for digit in allowed_even_digits:\n        if lower_bound <= digit <= upper_bound:\n            result.append(digit)\n            \n    return result\n```"}
{"task_id": "HumanEval/30", "solution": "```python\ndef get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    result = []\n    for x in l:\n        if x > 0:\n            result.append(x)\n    return result\n```"}
