{"task_id": "HumanEval/28", "solution": "```python\n# src/strconcat/__init__.py\n__version__ = \"0.1.0\"\nimport logging\n\nlogging.basicConfig(level=logging.INFO, format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n_logger = logging.getLogger(__name__)\n\n# Exposing core components for library use\nfrom .service import concatenate, ConcatenationService\nfrom .main import create_app, main\nfrom .config import Config\n```\n\n```python\n# src/strconcat/config.py\nfrom dataclasses import dataclass\nimport os\n\n@dataclass\nclass Config:\n    \"\"\"Configuration for the concatenation service.\"\"\"\n    db_path: str = \"strconcat.db\"\n    enable_persistence: bool = True\n    log_level: str = \"INFO\"\n\n    def __post_init__(self):\n        \"\"\"Set logging level after initialization.\"\"\"\n        from strconcat import _logger\n        _logger.setLevel(self.log_level.upper())\n\n    @classmethod\n    def from_env(cls):\n        \"\"\"Load configuration from environment variables.\"\"\"\n        db_path = os.getenv(\"STRCONCAT_DB_PATH\", \"strconcat.db\")\n        enable_persistence = os.getenv(\"STRCONCAT_ENABLE_PERSISTENCE\", \"true\").lower() == \"true\"\n        log_level = os.getenv(\"STRCONCAT_LOG_LEVEL\", \"INFO\")\n        return cls(db_path=db_path, enable_persistence=enable_persistence, log_level=log_level)\n```\n\n```python\n# src/strconcat/models.py\nfrom typing import List\nfrom pydantic import BaseModel\n\nclass ConcatenateRequest(BaseModel):\n    \"\"\"Data transfer object for concatenation request.\"\"\"\n    strings: List[str]\n\n    def validate(self) -> None:\n        \"\"\"Ensures strings is a list of string elements.\"\"\"\n        if not isinstance(self.strings, list):\n            raise ValueError(\"Input 'strings' must be a list.\")\n        for i, s in enumerate(self.strings):\n            if not isinstance(s, str):\n                raise TypeError(f\"Element at index {i} in 'strings' is not a string.\")\n\nclass ConcatenateResponse(BaseModel):\n    \"\"\"Data transfer object for concatenation response.\"\"\"\n    result: str\n```\n\n```python\n# src/strconcat/utils.py\nimport json\nfrom datetime import datetime\nfrom typing import Any, List\n\ndef is_string_list(value: Any) -> bool:\n    \"\"\"Checks if a value is a list containing only strings.\"\"\"\n    return isinstance(value, list) and all(isinstance(x, str) for x in value)\n\ndef to_json(obj: Any) -> str:\n    \"\"\"Safely serializes an object to a JSON string.\"\"\"\n    return json.dumps(obj, ensure_ascii=False)\n\ndef now_iso() -> str:\n    \"\"\"Returns the current UTC timestamp in ISO 8601 format.\"\"\"\n    return datetime.utcnow().isoformat()\n```\n\n```python\n# src/strconcat/repository.py\nimport sqlite3\nfrom typing import List, Dict\nfrom strconcat import _logger\n\nCREATE_TABLE_SQL = \"\"\"\nCREATE TABLE IF NOT EXISTS concatenation_history (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  input_json TEXT NOT NULL,\n  result TEXT NOT NULL,\n  created_at TEXT NOT NULL\n);\n\"\"\"\nDEFAULT_TABLE_NAME = \"concatenation_history\"\n\nclass DBAdapter:\n    \"\"\"Provides low-level access to the SQLite database.\"\"\"\n    def __init__(self, db_path: str):\n        self._db_path = db_path\n        self.ensure_schema()\n\n    def _connect(self):\n        \"\"\"Establishes a connection to the SQLite database.\"\"\"\n        return sqlite3.connect(self._db_path)\n\n    def execute(self, query: str, params: tuple = ()) -> None:\n        \"\"\"Executes a SQL query without returning results.\"\"\"\n        with self._connect() as conn:\n            conn.execute(query, params)\n            conn.commit()\n\n    def query(self, query: str, params: tuple = ()) -> List[Dict[str, Any]]:\n        \"\"\"Executes a SQL query and returns results as a list of dictionaries.\"\"\"\n        with self._connect() as conn:\n            conn.row_factory = sqlite3.Row # Allows accessing columns by name\n            cursor = conn.execute(query, params)\n            return [dict(row) for row in cursor.fetchall()]\n\n    def ensure_schema(self) -> None:\n        \"\"\"Ensures the necessary database schema is in place.\"\"\"\n        try:\n            self.execute(CREATE_TABLE_SQL)\n            self.execute(f\"CREATE INDEX IF NOT EXISTS idx_concatenation_history_created_at ON {DEFAULT_TABLE_NAME}(created_at DESC);\")\n        except sqlite3.Error as e:\n            _logger.error(f\"Error ensuring DB schema: {e}\")\n\nclass HistoryRepository:\n    \"\"\"Manages persistence of concatenation operation history.\"\"\"\n    def __init__(self, db_adapter: DBAdapter):\n        self._db = db_adapter\n\n    def insert_history(self, input_json: str, result: str, ts: str) -> int:\n        \"\"\"Inserts a new concatenation operation record into history.\"\"\"\n        query = f\"INSERT INTO {DEFAULT_TABLE_NAME} (input_json, result, created_at) VALUES (?, ?, ?)\"\n        with self._db._connect() as conn: # Direct connection to get lastrowid\n            cursor = conn.execute(query, (input_json, result, ts))\n            conn.commit()\n            return cursor.lastrowid\n\n    def list_recent(self, limit: int = 50) -> List[Dict[str, Any]]:\n        \"\"\"Retrieves a list of recent concatenation operations.\"\"\"\n        query = f\"SELECT id, input_json, result, created_at FROM {DEFAULT_TABLE_NAME} ORDER BY created_at DESC LIMIT ?\"\n        return self._db.query(query, (limit,))\n```\n\n```python\n# src/strconcat/service.py\nfrom typing import List, Optional\nfrom strconcat.repository import HistoryRepository\nfrom strconcat.utils import to_json, now_iso\nfrom strconcat import _logger\n\ndef concatenate(strings: List[str]) -> str:\n    \"\"\"Concatenates a list of strings into a single string.\n    Raises TypeError or ValueError for invalid input elements or type.\n    \"\"\"\n    if not isinstance(strings, list):\n        raise ValueError(\"Input must be a list of strings.\")\n    for i, s in enumerate(strings):\n        if not isinstance(s, str):\n            raise TypeError(f\"Element at index {i} is not a string.\")\n    return \"\".join(strings)\n\nclass ConcatenationService:\n    \"\"\"Business logic for string concatenation and optional history recording.\"\"\"\n    def __init__(self, repository: Optional[HistoryRepository] = None) -> None:\n        self._repository = repository\n\n    def concat(self, strings: List[str]) -> str:\n        \"\"\"Performs string concatenation, validates input, and records history.\"\"\"\n        result = concatenate(strings) # Uses the FR1 standalone concatenate function\n        if self._repository:\n            try:\n                self._repository.insert_history(input_json=to_json(strings), result=result, ts=now_iso())\n            except Exception as e:\n                _logger.error(f\"Failed to record history: {e}\")\n        return result\n```\n\n```python\n# src/strconcat/controllers.py\nfrom fastapi import APIRouter, HTTPException, status\nfrom strconcat.models import ConcatenateRequest, ConcatenateResponse\nfrom strconcat.service import ConcatenationService\nfrom strconcat import _logger\n\nclass APIController:\n    \"\"\"HTTP API controller for concatenation operations.\"\"\"\n    def __init__(self, service: ConcatenationService):\n        self._service = service\n        self.router = self.create_router()\n\n    def create_router(self) -> APIRouter:\n        \"\"\"Creates and configures the FastAPI APIRouter.\"\"\"\n        router = APIRouter()\n\n        @router.post(\"/concatenate\", response_model=ConcatenateResponse, status_code=status.HTTP_200_OK)\n        async def post_concatenate(payload: ConcatenateRequest):\n            \"\"\"Handles POST requests to concatenate a list of strings.\"\"\"\n            try:\n                payload.validate() # Explicit validation for model (FastAPI/Pydantic also does this)\n                result = self._service.concat(payload.strings)\n                return ConcatenateResponse(result=result)\n            except (TypeError, ValueError) as e:\n                _logger.warning(f\"Bad request: {e}\")\n                raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))\n            except Exception as e:\n                _logger.exception(\"An unexpected server error occurred during concatenation.\")\n                raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"Internal server error\")\n        return router\n\n    def register(self, app):\n        \"\"\"Registers the controller's router with the main FastAPI app.\"\"\"\n        app.include_router(self.router)\n```\n\n```python\n# src/strconcat/cli.py\nimport sys\nimport argparse\nfrom typing import List\nfrom strconcat.service import ConcatenationService\nfrom strconcat.config import Config\nfrom strconcat.repository import DBAdapter, HistoryRepository\nfrom strconcat import _logger\n\nclass CLICommand:\n    \"\"\"CLI command to perform string concatenation.\"\"\"\n    def __init__(self, service: ConcatenationService):\n        self._service = service\n\n    def run(self, args: List[str]) -> int:\n        \"\"\"Executes the concatenation command with provided arguments.\"\"\"\n        if not args:\n            print(\"Usage: strconcat concat <strings...>\", file=sys.stderr)\n            return 2\n        try:\n            result = self._service.concat(args)\n            print(result)\n            return 0\n        except (TypeError, ValueError) as e:\n            print(f\"Error: {e}\", file=sys.stderr)\n            return 2\n        except Exception as e:\n            _logger.exception(\"An unexpected error occurred during CLI concatenation.\")\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n\ndef configure_cli_service(cli_args) -> ConcatenationService:\n    \"\"\"Configures ConcatenationService based on CLI arguments.\"\"\"\n    config = Config(\n        db_path=cli_args.db_path,\n        enable_persistence=not cli_args.no_persist,\n        log_level=cli_args.log_level\n    )\n    history_repo = None\n    if config.enable_persistence:\n        try:\n            db_adapter = DBAdapter(config.db_path)\n            history_repo = HistoryRepository(db_adapter)\n        except Exception as e:\n            _logger.error(f\"Failed to initialize history repository: {e}. Persistence will be disabled.\")\n            history_repo = None\n    return ConcatenationService(repository=history_repo)\n\ndef add_common_cli_args(parser: argparse.ArgumentParser):\n    \"\"\"Adds common CLI arguments for configuration.\"\"\"\n    parser.add_argument(\"--db-path\", type=str, default=Config.from_env().db_path,\n                        help=\"Path to the SQLite database file.\")\n    parser.add_argument(\"--no-persist\", action=\"store_true\",\n                        help=\"Disable history persistence to the database.\")\n    parser.add_argument(\"--log-level\", type=str, default=Config.from_env().log_level,\n                        choices=[\"DEBUG\", \"INFO\", \"WARNING\", \"ERROR\", \"CRITICAL\"],\n                        help=\"Set the logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL).\")\n```\n\n```python\n# src/strconcat/main.py\nimport sys\nimport argparse\nfrom typing import Optional, List\nimport uvicorn\nfrom fastapi import FastAPI\nfrom strconcat.config import Config\nfrom strconcat.service import ConcatenationService\nfrom strconcat.repository import DBAdapter, HistoryRepository\nfrom strconcat.controllers import APIController\nfrom strconcat.cli import CLICommand, configure_cli_service, add_common_cli_args\nfrom strconcat import _logger\n\ndef create_app(config: Optional[Config] = None) -> FastAPI:\n    \"\"\"Initializes and configures the FastAPI application.\"\"\"\n    if config is None:\n        config = Config.from_env()\n\n    _logger.setLevel(config.log_level.upper())\n    _logger.info(\"Initializing FastAPI application...\")\n    _logger.info(f\"Config: db_path={config.db_path}, enable_persistence={config.enable_persistence}, log_level={config.log_level}\")\n\n    app = FastAPI(\n        title=\"String Concatenation Service\",\n        description=\"A simple service to concatenate lists of strings.\",\n        version=\"0.1.0\"\n    )\n\n    history_repo: Optional[HistoryRepository] = None\n    if config.enable_persistence:\n        try:\n            db_adapter = DBAdapter(config.db_path)\n            history_repo = HistoryRepository(db_adapter)\n            _logger.info(\"History persistence enabled.\")\n        except Exception as e:\n            _logger.error(f\"Failed to initialize history repository: {e}. Persistence will be disabled.\")\n            history_repo = None\n    else:\n        _logger.info(\"History persistence disabled by configuration.\")\n\n    service = ConcatenationService(repository=history_repo)\n    controller = APIController(service=service)\n    controller.register(app)\n\n    @app.get(\"/health\", status_code=200)\n    async def health_check():\n        \"\"\"Simple health check endpoint.\"\"\"\n        return {\"status\": \"ok\"}\n\n    _logger.info(\"FastAPI application initialized successfully.\")\n    return app\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"Main entry point for the application, handling CLI and API startup.\"\"\"\n    if argv is None:\n        argv = sys.argv[1:]\n\n    parser = argparse.ArgumentParser(\n        prog=\"strconcat\",\n        description=\"String Concatenation CLI and API service.\"\n    )\n    subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\")\n\n    # Serve command for HTTP API\n    serve_parser = subparsers.add_parser(\"serve\", help=\"Run the HTTP API server.\")\n    serve_parser.add_argument(\"--host\", type=str, default=\"0.0.0.0\", help=\"Host address for the API server.\")\n    serve_parser.add_argument(\"--port\", type=int, default=8000, help=\"Port for the API server.\")\n    add_common_cli_args(serve_parser) # Add common args for serve command too\n\n    # Concat command for CLI\n    concat_parser = subparsers.add_parser(\"concat\", help=\"Concatenate strings via CLI.\")\n    concat_parser.add_argument(\"strings\", nargs=\"+\", help=\"Strings to concatenate.\")\n    add_common_cli_args(concat_parser) # Add common args for concat command\n\n    args = parser.parse_args(argv)\n\n    if args.command == \"serve\":\n        _logger.info(f\"Starting API server on {args.host}:{args.port}\")\n        # Configure the service for the API, passing common CLI args to config\n        app_config = Config(\n            db_path=args.db_path,\n            enable_persistence=not args.no_persist,\n            log_level=args.log_level\n        )\n        app = create_app(config=app_config)\n        uvicorn.run(app, host=args.host, port=args.port, log_level=args.log_level.lower())\n        return 0\n    elif args.command == \"concat\":\n        # Configure the service for CLI\n        service = configure_cli_service(args)\n        cli_command = CLICommand(service=service)\n        return cli_command.run(args.strings)\n    else:\n        parser.print_help()\n        return 1\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n```\n\n```sql\n-- migrations/V1__create_history_table.sql\nCREATE TABLE IF NOT EXISTS concatenation_history (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  input_json TEXT NOT NULL,\n  result TEXT NOT NULL,\n  created_at TEXT NOT NULL\n);\nCREATE INDEX IF NOT EXISTS idx_concatenation_history_created_at ON concatenation_history(created_at DESC);\n```\n\n```toml\n# pyproject.toml\n[tool.poetry]\nname = \"strconcat\"\nversion = \"0.1.0\"\ndescription = \"A reusable Python library to concatenate strings with HTTP and CLI interfaces.\"\nauthors = [\"Your Name <you@example.com>\"]\nlicense = \"MIT\"\nreadme = \"README.md\"\npackages = [{include = \"strconcat\", from = \"src\"}]\n\n[tool.poetry.dependencies]\npython = \">=3.9,<4.0\"\nfastapi = \"^0.111.0\"\nuvicorn = {extras = [\"standard\"], version = \"^0.29.0\"}\npydantic = \"^2.7.1\"\ndataclasses-json = \"^0.6.6\" # Used dataclasses, but pydantic could also be used for config for consistency\n\n[tool.poetry.group.dev.dependencies]\npytest = \"^8.2.1\"\nhttpx = \"^0.27.0\"\nsqlite-web = \"^0.2.0\" # Optional: for quick DB inspection\n\n[tool.poetry.scripts]\nstrconcat = \"strconcat.main:main\"\n\n[build-system]\nrequires = [\"poetry-core\"]\nbuild-backend = \"poetry.core.masonry.api\"\n```\n\n```markdown\n# README.md\n\n## String Concatenation Service\n\nThis project provides a Python library to concatenate a list of strings, exposing the functionality via a programmatic API, a simple HTTP API, and a CLI. It optionally records recent operations to a lightweight SQLite database.\n\n## Features\n\n-   **Library Functionality**: `strconcat.concatenate()` and `strconcat.ConcatenationService` for programmatic use.\n-   **HTTP API**: `POST /concatenate` endpoint to join strings via JSON requests.\n-   **CLI Tool**: `strconcat concat <strings...>` to perform concatenations locally.\n-   **Operation History**: Optional persistence of operations to a local SQLite database for audit.\n\n## Installation\n\n1.  **Clone the repository:**\n    ```bash\n    git clone https://github.com/your-username/strconcat.git\n    cd strconcat\n    ```\n\n2.  **Install dependencies using Poetry (recommended):**\n    ```bash\n    poetry install\n    ```\n    If you don't have Poetry, you can install it via `pip install poetry`.\n\n3.  **Alternative (pip):**\n    ```bash\n    pip install -e .  # Installs in editable mode\n    # or build and install wheel:\n    # poetry build\n    # pip install dist/strconcat-0.1.0-py3-none-any.whl\n    ```\n\n## Usage\n\n### 1. Programmatic API\n\n```python\nfrom strconcat.service import ConcatenationService, concatenate\nfrom strconcat.config import Config\nfrom strconcat.repository import DBAdapter, HistoryRepository\n\n# Basic concatenation (FR1 function)\nresult = concatenate(['hello', ' ', 'world'])\nprint(f\"Basic concatenate: {result}\")\n# Expected: hello world\n\n# Using the service (FR2 class)\n# Example with persistence enabled\nconfig = Config(db_path=\"my_app.db\", enable_persistence=True)\ndb_adapter = DBAdapter(config.db_path)\nhistory_repo = HistoryRepository(db_adapter)\nservice = ConcatenationService(repository=history_repo)\n\nresult = service.concat(['a', 'b', 'c'])\nprint(f\"Service concatenate with history: {result}\")\n# Expected: abc\n\n# Example without persistence\nservice_no_persist = ConcatenationService(repository=None)\nresult = service_no_persist.concat(['x', 'y', 'z'])\nprint(f\"Service concatenate without history: {result}\")\n# Expected: xyz\n\n# To inspect history (if enabled):\nrecent_operations = history_repo.list_recent(limit=5)\nprint(\"Recent operations:\")\nfor op in recent_operations:\n    print(op)\n```\n\n### 2. HTTP API\n\nThe HTTP API runs on FastAPI.\n\n**Start the API server:**\n\n```bash\npoetry run strconcat serve --host 0.0.0.0 --port 8000\n```\nor directly via uvicorn (if `uvicorn` is in your PATH):\n```bash\nuvicorn strconcat.main:create_app --host 0.0.0.0 --port 8000 --app-dir src --factory\n```\n\n**Make a request (e.g., using `curl`):**\n\n```bash\ncurl -X POST http://localhost:8000/concatenate \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\"strings\": [\"hello\", \" \", \"api\"]}'\n```\n\n**Expected JSON response:**\n```json\n{\"result\": \"hello api\"}\n```\n\n**Health check:**\n```bash\ncurl http://localhost:8000/health\n```\nExpected: `{\"status\": \"ok\"}`\n\n### 3. CLI Tool\n\n**Concatenate strings:**\n\n```bash\npoetry run strconcat concat \"first\" \"second\" \"third string\"\n# Expected output: firstsecondthird string\n```\n\n**Disable persistence for CLI command:**\n\n```bash\npoetry run strconcat concat --no-persist \"no\" \"history\"\n# Expected output: nohistory\n```\n\n**Specify database path:**\n\n```bash\npoetry run strconcat concat --db-path my_custom.db \"custom\" \"db\"\n```\n\n## Configuration\n\nConfiguration can be set via environment variables or CLI arguments.\n\n| Setting              | Environment Variable        | Default Value     | Description                                        |\n| :------------------- | :-------------------------- | :---------------- | :------------------------------------------------- |\n| `db_path`            | `STRCONCAT_DB_PATH`         | `strconcat.db`    | Path to the SQLite database file.                  |\n| `enable_persistence` | `STRCONCAT_ENABLE_PERSISTENCE` | `true`            | Set to `false` to disable history persistence.     |\n| `log_level`          | `STRCONCAT_LOG_LEVEL`       | `INFO`            | Logging level (DEBUG, INFO, WARNING, ERROR).       |\n\nCLI arguments take precedence over environment variables.\n\n## Development\n\n**Running tests:**\n\n```bash\npoetry run pytest\n```\n\n**Linting (e.g., with `flake8` or `ruff`):**\n\n```bash\npoetry run flake8 src/\n# or\npoetry run ruff check src/\n```\n\n## Project Structure\n\n```\n\u251c\u2500\u2500 src/\n\u2502   \u2514\u2500\u2500 strconcat/\n\u2502       \u251c\u2500\u2500 __init__.py         # Package initialization, logger config\n\u2502       \u251c\u2500\u2500 config.py           # Configuration classes\n\u2502       \u251c\u2500\u2500 models.py           # Pydantic models for API/internal DTOs\n\u2502       \u251c\u2500\u2500 utils.py            # Utility functions (JSON, timestamps, type checking)\n\u2502       \u251c\u2500\u2500 service.py          # Core business logic: `concatenate` function and `ConcatenationService`\n\u2502       \u251c\u2500\u2500 repository.py       # Persistence layer: `DBAdapter` (SQLite) and `HistoryRepository`\n\u2502       \u251c\u2500\u2500 controllers.py      # HTTP API layer (FastAPI)\n\u2502       \u251c\u2500\u2500 cli.py              # CLI command logic\n\u2502       \u2514\u2500\u2500 main.py             # Application entrypoints (FastAPI app creation, CLI runner)\n\u251c\u2500\u2500 migrations/\n\u2502   \u2514\u2500\u2500 V1__create_history_table.sql # SQL schema for history table\n\u251c\u2500\u2500 pyproject.toml              # Project metadata and dependencies\n\u251c\u2500\u2500 README.md                   # This file\n```\n```"}
