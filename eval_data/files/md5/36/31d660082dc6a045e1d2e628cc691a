rses a string to an integer, raising ValidationError if invalid.\"\"\"\n    try:\n        num = int(value)\n        if not is_non_negative_int(num):\n            raise ValueError() # Propagate to the outer except\n        return num\n    except (ValueError, TypeError):\n        raise ValidationError(f\"Invalid parameter {name}: must be a non-negative integer\")\n\n```\n\nsrc/fizzbuzz/config.py\n```python\nimport os\nfrom typing import Optional\n\nclass AppConfig:\n    \"\"\"Holds application configuration values.\n    Built from environment variables or defaults.\"\"\"\n    def __init__(\n        self,\n        host: str = \"0.0.0.0\",\n        port: int = 8000,\n        debug: bool = False,\n        max_n: int = 50_000_000\n    ) -> None:\n        self.host = host\n        self.port = port\n        self.debug = debug\n        self.max_n = max_n\n\n    @classmethod\n    def from_env(cls) -> \"AppConfig\":\n        \"\"\"Constructs AppConfig from environment variables.\"\"\"\n        host = os.getenv(\"APP_HOST\", \"0.0.0.0\")\n        port = int(os.getenv(\"APP_PORT\", \"8000\"))\n        debug = os.getenv(\"APP_DEBUG\", \"false\").lower() == \"true\"\n        max_n = int(os.getenv(\"APP_MAX_N\", str(50_000_000)))\n        return cls(host=host, port=port, debug=debug, max_n=max_n)\n\n```\n\nsrc/fizzbuzz/logging_config.py\n```python\nimport logging\nimport sys\n\nDEFAULT_LOG_FORMAT = \"%(asctime)s - %(name)s - %(levelname)s - %(message)s\"\n\ndef configure_logging(level: str = \"INFO\") -> None:\n    \"\"\"Configures basic logging for the application.\"\"\"\n    logging.basicConfig(\n        level=level.upper(),\n        format=DEFAULT_LOG_FORMAT,\n        stream=sys.stdout\n    )\n\n```\n\ntests/unit/test_services.py\n```python\n# Unit tests for FizzBuzzService go here.\n# As per instructions, no unit test code is generated.\n```\n\ntests/unit/test_repository.py\n```python\n# Unit tests for FizzBuzzRepository go here.\n# As per instructions, no unit test code is gen