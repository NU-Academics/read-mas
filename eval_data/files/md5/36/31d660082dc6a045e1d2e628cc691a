lidate_numbers(large_list)\n\n    # Test with a custom max_size\n    custom_max_size = 10\n    even_larger_list = [1] * (custom_max_size + 1)\n    with pytest.raises(ValidationError, match=f\"Input too large; exceeds {custom_max_size} elements\"):\n        validate_numbers(even_larger_list, max_size=custom_max_size)\n\ndef test_validate_numbers_input_at_max_size():\n    \"\"\"Test `validate_numbers` with an input list exactly at `max_size`.\"\"\"\n    at_max_size_list = [1] * MAX_INPUT_SIZE\n    assert validate_numbers(at_max_size_list) == at_max_size_list\n\n    custom_max_size = 5\n    at_custom_max_size_list = [1] * custom_max_size\n    assert validate_numbers(at_custom_max_size_list, max_size=custom_max_size) == at_custom_max_size_list\n\n```\n```python\n# tests/test_repository.py\n\"\"\"\nUnit tests for the FileRepository class.\nUses pytest's `tmp_path` fixture for temporary file handling.\n\"\"\"\nimport json\nimport pytest\nfrom unittest.mock import patch, MagicMock\nfrom src.unique_filter.repository import FileRepository\nfrom src.unique_filter.exceptions import PersistenceError\n\n@pytest.fixture\ndef repo():\n    \"\"\"Provides a FileRepository instance.\"\"\"\n    return FileRepository()\n\ndef test_read_from_file_success(tmp_path, repo):\n    \"\"\"Test successful reading of a JSON array from a file.\"\"\"\n    test_data = [1, 2, 3, 2, 4]\n    file_path = tmp_path / \"input.json\"\n    file_path.write_text(json.dumps(test_data))\n    \n    result = repo.read(str(file_path))\n    assert result == test_data\n\ndef test_read_from_file_not_found(repo):\n    \"\"\"Test reading from a non-existent file.\"\"\"\n    with pytest.raises(PersistenceError, match=\"Input file not found\"):\n        repo.read(\"non_existent_file.json\")\n\ndef test_read_from_file_invalid_json(tmp_path, repo):\n    \"\"\"Test reading from a file with invalid JSON content.\"\"\"\n    file_path = tmp_path / \"invalid.json\"\n    file_path.write_text(\"not valid json {\")\n    \n    with pytest.raises(PersistenceError, match=\"Invalid JSON format\"):\n        repo.read(str(file_path))\n\ndef test_read_from_stdin_success(repo):\n    \"\"\"Test successful reading of a JSON array from stdin.\"\"\"\n    test_data = [10, 20, 30]\n    with patch('sys.stdin', MagicMock()):\n        sys.stdin.read.return_value = json.dumps(test_data)\n        sys.stdin.readline.side_effect = [\"\", \"\\n\"] # For json.load in some Python versions\n        result = repo.read(\"-\")\n    assert result == test_data\n\ndef test_read_from_stdin_invalid_json(repo):\n    \"\"\"Test reading invalid JSON from stdin.\"\"\"\n    with patch('sys.stdin', MagicMock()):\n        sys.stdin.read.return_value = \"invalid json\"\n        sys.stdin.readline.side_effect = [\"\", \"\\n\"] # For json.load in some Python versions\n        with pytest.raises(PersistenceError, match=\"Invalid JSON format from stdin\"):\n            repo.read(\"-\")\n\ndef test_write_to_file_success(tmp_path, repo):\n    \"\"\"Test successful writing of a JSON array to a file.\"\"\"\n    test_data = [1, 3, 4]\n    file_path = tmp_path / \"output.json\"\n    \n    repo.write(str(file_path), test_data)\n    \n    assert file_path.read_text() == json.dumps(test_data)\n\ndef test_write_to_stdout_success(capsys, repo):\n    \"\"\"Test successful writing of a JSON array to stdout.\"\"\"\n    test_data = [10, 30, 40]\n    \n    repo.write(\"-\", test_data)\n    \n    captured = capsys.readouterr()\n    assert captured.out.strip() == json.dumps(test_data)\n\ndef test_write_to_file_permission_error(repo):\n    \"\"\"Test writing to a file with a simulated permission error.\"\"\"\n    with patch('builtins.open', side_effect=OSError(\"Permission denied\")):\n        with pytest.raises(PersistenceError, match=\"Failed to write\"):\n            repo.write(\"protected_file.json\", [1, 2])\n\n```\n```python\n# tests/test_cli.py\n\"\"\"\nIntegration tests for the CLIController.\nUses pytest's `capsys` and `tmp_path` fixtures to test I/O and exit codes.\n\"\"\"\nimport json\nimport pytest\nfrom unittest.mock import MagicMock, patch\nfrom src.unique_filter.controllers import CLIController\nfrom src.unique_filter.repository import FileRepository\nfrom src.unique_filter.services import DuplicateFilterService\nfrom src.unique_filter.utils import validate_numbers # For setting up default service\n\n@pytest.fixture\ndef mock_service():\n    \"\"\"Provides a mock DuplicateFilterService.\"\"\"\n    service = MagicMock(spec=DuplicateFilterService)\n    # The CLIController implicitly uses validate_numbers from utils.py,\n    # but the service also has a validator. For this test, ensure the mock\n    # service's remove_duplicates always returns something predictable.\n    service.remove_duplicates.return_value = [1, 3, 4]\n    # The CLIController *also* explicitly calls `validate_numbers` directly from `utils.py`.\n    # So, the service's *own* validator might not be called in this specific CLI path.\n    return service\n\n@pytest.fixture\ndef real_service():\n    \"\"\"Provides a real DuplicateFilterService initialized with a real validator.\"\"\"\n    return DuplicateFilterService(validator=validate_numbers)\n\n@pytest.fixture\ndef repo():\n    \"\"\"Provides a real FileRepository instance.\"\"\"\n    return FileRepository()\n\ndef test_cli_file_to_file_success(tmp_path, real_service, repo):\n    \"\"\"Test CLI processing from an input file to an output file.\"\"\"\n    input_data = [1, 2, 3, 2, 4]\n    expected_output = [1, 3, 4]\n    input_file = tmp_path / \"input.json\"\n    output_file = tmp_path / \"output.json\"\n    input_file.write_text(json.dumps(input_data))\n\n    controller = CLIController(real_service, repo)\n    exit_code = controller.run([\"--input\", str(input_file), \"--output\", str(output_file)])\n\n    assert exit_code == 0\n    assert json.loads(output_file.read_text()) == expected_output\n\ndef test_cli_stdin_to_stdout_success(capsys, real_service, repo):\n    \"\"\"Test CLI processing from stdin to stdout.\"\"\"\n    input_data = [1, 5, 2, 3, 5, 2, 4]\n    expected_output = [1, 3, 4]\n\n    # Mock stdin\n    with patch('sys.stdin', MagicMock()):\n        sys.stdin.read.return_value = json.dumps(input_data)\n        sys.stdin.readline.side_effect = [\"\", \"\\n\"] # For json.load\n\n        controller = CLIController(real_service, repo)\n        exit_code = controller.run([\"-i\", \"-\", \"-o\", \"-\"])\n\n        captured = capsys.readouterr()\n        assert exit_code == 0\n        assert json.loads(captured.out.strip()) == expected_output\n        assert captured.err == \"\"\n\ndef test_cli_invalid_input_json(tmp_path, capsys, real_service, repo):\n    \"\"\"Test CLI handling of invalid JSON input.\"\"\"\n    input_file = tmp_path / \"invalid.json\"\n    input_file.write_text(\"not valid json {\")\n\n    controller = CLIController(real_service, repo)\n    exit_code = controller.run([\"-i\", str(input_file)])\n\n    captured = capsys.readouterr()\n    assert exit_code == 1 # PersistenceError\n    assert \"Error: Invalid JSON format\" in captured.err\n\ndef test_cli_input_file_not_found(capsys, real_service, repo):\n    \"\"\"Test CLI handling when input file does not exist.\"\"\"\n    controller = CLIController(real_service, repo)\n    exit_code = controller.run([\"-i\", \"non_existent.json\"])\n\n    captured = capsys.readouterr()\n    assert exit_code == 1 # PersistenceError\n    assert \"Error: Input file not found\" in captured.err\n\ndef test_cli_invalid_data_type_in_list(tmp_path, capsys, real_service, repo):\n    \"\"\"Test CLI handling of a list containing non-integer types.\"\"\"\n    input_data = [1, 2, \"three\", 4]\n    input_file = tmp_path / \"invalid_type.json\"\n    input_file.write_text(json.dumps(input_data))\n\n    controller = CLIController(real_service, repo)\n    exit_code = controller.run([\"-i\", str(input_file)])\n\n    captured = capsys.readouterr()\n    assert exit_code == 1 # ValidationError\n    assert \"Error: Item at index 2 is not an integer\" in captured.err\n\ndef test_cli_input_too_large(tmp_path, capsys, real_service, repo):\n    \"\"\"Test CLI handling of an input list exceeding max_size.\"\"\"\n    from src.unique_filter.config import MAX_INPUT_SIZE\n    large_list = [1] * (MAX_INPUT_SIZE + 1)\n    input_file = tmp_path / \"large_input.json\"\n    input_file.write_text(json.dumps(large_list))\n\n    controller = CLIController(real_service, repo)\n    exit_code = controller.run([\"-i\", str(input_file), \"--max-size\", str(MAX_INPUT_SIZE)])\n\n    captured = capsys.readouterr()\n    assert exit_code == 1 # ValidationError\n    assert f\"Error: Input too large; exceeds {MAX_INPUT_SIZE} elements\" in captured.err\n\ndef test_cli_custom_max_size(tmp_path, real_service, repo):\n    \"\"\"Test CLI with a custom max_size argument.\"\"\"\n    input_data = [1] * 5\n    input_file = tmp_path / \"custom_max_size_input.json\"\n    input_file.write_text(json.dumps(input_data))\n\n    controller = CLIController(real_service, repo)\n    exit_code_ok = controller.run([\"-i\", str(input_file), \"--max-size\", \"5\"])\n    assert exit_code_ok == 0\n\n    exit_code_fail = controller.run([\"-i\", str(input_file), \"--max-size\", \"4\"])\n    assert exit_code_fail == 1 # ValidationError\n\n```\n```markdown\n# docs/design_notes.md\n# Design Notes\n\nThis document provides additional context and reasoning behind certain design decisions.\n\n## 1. Input Validation Strategy\n\nThe design employs a multi-layered validation approach:\n- **`utils.validate_numbers(numbers: Any, max_size: int)`**: This is the primary, robust validation function. It accepts `Any` type, ensures it's a list, checks all elements for integer type, and enforces `max_size`. It's designed to be used at the \"edge\" of the system (CLI, API) where raw, untrusted input enters.\n- **`NumberList.validate()`**: This is a dataclass method that mirrors some aspects of `validate_numbers`. While `validate_numbers` is a standalone utility, `NumberList.validate` exists to demonstrate how a DTO could encapsulate its own validation if needed. In the current implementation, `validate_numbers` is predominantly used.\n- **`DuplicateFilterService.validator`**: The service itself accepts an injectable validator. This promotes testability (mocking validation behavior) and flexibility (different validation rules for different contexts). By default, it uses `utils.validate_numbers`.\n- **FastAPI Pydantic Models**: FastAPI's `BaseModel` (e.g., `NumbersRequest`) provides automatic serialization and initial type validation for HTTP requests. This helps ensure that `req.numbers` is at least a `List[int]`. However, for `max_size` and stricter interpretations (e.g., rejecting `1.0` if Pydantic allowed it implicitly), `utils.validate_numbers` is still called within the API endpoint handler.\n\nThis approach ensures strong validation from external interfaces while keeping the core service focused on business logic, allowing it to assume validated input or delegate validation as configured.\n\n## 2. CLI Error Codes\n\nThe CLI uses specific exit codes:\n- `0`: Success.\n- `1`: General error for `ValidationError` or `PersistenceError`. A more granular mapping (e.g., `2` for validation, `3` for persistence) was considered but kept simple as `1` for any user-facing error.\n- `127`: Unexpected internal error. This is a common convention for \"command not found\" but can also be used for unhandled runtime exceptions.\n\n## 3. Asynchronous Processing\n\nThe API (using FastAPI) leverages Python's `async`/`await` syntax for its endpoint handlers. However, the core `DuplicateFilterService.remove_duplicates` method is synchronous. For typical workloads where filtering is fast (O(N) operations), blocking the event loop for a short duration is acceptable. For very long-running filtering tasks (e.g., millions of elements taking seconds), offloading to a thread pool or a separate process would be necessary to maintain API responsiveness. This initial design does not require such complexity.\n\n## 4. `DEFAULT_MAX_JSON_BYTES`\n\nThe `DEFAULT_MAX_JSON_BYTES` constant is defined in `config.py` but is not actively enforced in the current `FileRepository` or `api.py` implementations. This was included per the specification, but its enforcement would require custom logic (e.g., reading file chunks and checking size before full parse) which adds complexity beyond the current scope of simply loading the entire JSON. FastAPI/Uvicorn can impose request body size limits at a lower level for the API.\n\n## 5. `FileRepository` Base Directory\n\nThe `FileRepository` includes a `base_dir` attribute. In the current implementation, it's not strictly used because `open()` typically resolves paths relative to the current working directory, and stdin/stdout paths are absolute concepts. However, it's maintained to allow for future enhancements where a repository might be constrained to specific directories or perform path sanitization relative to this base directory. For example, preventing path traversal attacks by resolving `../` components against a fixed base.\n\n## 6. `__init__.py` Module-Level `remove_duplicates`\n\nA module-level `remove_duplicates` function is exposed in `__init__.py` to provide a simple, direct entry point for developers using the library, matching the \"As a developer, I want a function remove_duplicates(numbers: List[int]) -> List[int]\" user story. This function internally uses a default `DuplicateFilterService` instance, simplifying its usage. This balances the need for a full architectural design with the requirement for a straightforward function interface.\n```"}
