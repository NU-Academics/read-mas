{"task_id": "HumanEval/31", "solution": "```python\nimport math\nimport random\n\ndef is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    # Handle non-positive and very small numbers as per business rules.\n    if n <= 1:\n        return False\n    if n == 2 or n == 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n\n    # Apply trial division for numbers up to a threshold, then Miller-Rabin.\n    DEFAULT_TRIAL_DIV_THRESHOLD = 10000\n\n    if n <= DEFAULT_TRIAL_DIV_THRESHOLD:\n        i = 5\n        limit = math.isqrt(n)\n        while i <= limit:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n    else:\n        # Miller-Rabin probabilistic test for larger numbers with 5 rounds.\n        rounds = 5\n\n        # Decompose n - 1 as 2^s * d.\n        s = 0\n        d = n - 1\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n\n        # Perform Miller-Rabin rounds.\n        for _ in range(rounds):\n            a = random.randrange(2, n - 1)\n            x = pow(a, d, n)\n            if x == 1 or x == n - 1:\n                continue\n\n            for _ in range(s - 1):\n                x = pow(x, 2, n)\n                if x == n - 1:\n                    break\n            else:\n                return False  # n is composite if witness found.\n        return True  # n is probably prime.\n```"}
{"task_id": "HumanEval/31", "solution": "import math\nfrom typing import Tuple\n\ndef is_prime(n: int) -> bool:\n    \"\"\"Return true if a given number is prime, and false otherwise.\"\"\"\n\n    if n < 2:\n        return False\n    if n == 2 or n == 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n\n    TRIAL_DIVISION_LIMIT: int = 10_000\n    MR_64BIT_BASES: Tuple[int, ...] = (2, 3, 5, 7, 11, 13)\n\n    def _miller_rabin_witness_test(num: int, base: int, d: int, s: int) -> bool:\n        \"\"\"Performs a single Miller-Rabin witness test against a base.\"\"\"\n        x = pow(base, d, num)\n        if x == 1 or x == num - 1:\n            return True\n        for _ in range(s - 1):\n            x = pow(x, 2, num)\n            if x == num - 1:\n                return True\n        return False\n\n    if n <= TRIAL_DIVISION_LIMIT:\n        # Use optimized trial division for smaller numbers.\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n    else:\n        # Use Miller-Rabin for larger numbers with deterministic bases.\n        d = n - 1\n        s = 0\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n        \n        for a in MR_64BIT_BASES:\n            if a >= n:\n                continue\n            if not _miller_rabin_witness_test(n, a, d, s):\n                return False\n        return True"}
{"task_id": "HumanEval/32", "solution": "import math\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list):\n    \"\"\"\n    find_zero finds x such that poly(x) = 0.\n    It takes odd-degree polynomial coefficients and guarantees a solution.\n    \"\"\"\n\n    DEFAULT_TOLERANCE = 1e-12\n    MAX_BRACKET_STEPS = 100\n    MAX_BRACKET_RADIUS = 1e6\n    MAX_BRENT_ITER = 100\n\n    def f_local(x_val: float) -> float:\n        return poly(xs, x_val)\n\n    if abs(f_local(0.0)) <= DEFAULT_TOLERANCE:\n        return 0.0\n\n    bracket_a, bracket_b = None, None\n    search_h = 1.0\n\n    for _ in range(MAX_BRACKET_STEPS):\n        test_a = -search_h\n        test_b = search_h\n        val_a = f_local(test_a)\n        val_b = f_local(test_b)\n\n        if val_a * val_b <= 0:\n            bracket_a, bracket_b = test_a, test_b\n            break\n        \n        search_h *= 2.0\n        if search_h > MAX_BRACKET_RADIUS:\n            break\n    \n    if bracket_a is None:\n        bracket_a, bracket_b = -MAX_BRACKET_RADIUS * 2, MAX_BRACKET_RADIUS * 2\n\n    a = bracket_a\n    b = bracket_b\n    fa = f_local(a)\n    fb = f_local(b)\n\n    if abs(fa) <= DEFAULT_TOLERANCE: return a\n    if abs(fb) <= DEFAULT_TOLERANCE: return b\n\n    c = a\n    fc = fa\n    e = d = b - a\n\n    for _ in range(MAX_BRENT_ITER):\n        if fb * fc > 0:\n            c = a\n            fc = fa\n            d = e = b - a\n\n        if abs(fc) < abs(fb):\n            a, b, c = b, c, b\n            fa, fb, fc = fb, fc, fb\n\n        m = 0.5 * (c - b)\n        if abs(m) <= DEFAULT_TOLERANCE or abs(fb) <= DEFAULT_TOLERANCE:\n            return b\n\n        if abs(e) >= DEFAULT_TOLERANCE and abs(fa) > abs(fb):\n            s = fb / fa\n            if a == c:\n                p = 2.0 * m * s\n                q = 1.0 - s\n            else:\n                q_interp = fa / fc\n                r_interp = fb / fc\n                p = s * (2.0 * m * q_interp * (q_interp - r_interp) - (b - a) * (r_interp - 1.0))\n                q = (q_interp - 1.0) * (r_interp - 1.0) * (s - 1.0)\n\n            if p > 0: q = -q\n            p = abs(p)\n\n            if (2.0 * p) < (3.0 * m * q - abs(DEFAULT_TOLERANCE * q)) and (p < abs(0.5 * e * q)):\n                e = d\n                d = p / q\n            else:\n                e = m\n                d = m\n        else:\n            e = m\n            d = m\n\n        a = b\n        fa = fb\n        if abs(d) > DEFAULT_TOLERANCE:\n            b += d\n        else:\n            b += math.copysign(DEFAULT_TOLERANCE, m)\n        fb = f_local(b)\n\n    return b"}
