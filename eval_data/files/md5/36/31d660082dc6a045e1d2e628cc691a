{"task_id": "HumanEval/121", "solution": "```python\ndef solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    \n\n    Examples\n    solution([5, 8, 7, 1]) ==> 12\n    solution([3, 3, 3, 3, 3]) ==> 9\n    solution([30, 13, 24, 321]) ==>0\n    \"\"\"\n    total_sum = 0\n    # Iterate through the list, keeping track of both index and value.\n    for index, value in enumerate(lst):\n        # Add the value to the sum if its index is even and the value itself is odd.\n        if index % 2 == 0 and value % 2 != 0:\n            total_sum += value\n    return total_sum\n```"}
{"task_id": "HumanEval/122", "solution": "```python\ndef add_elements(arr, k):\n    \"\"\"\n    Computes the sum of elements with at most two digits from the first k elements of arr.\n    Digits are counted ignoring the sign of the number.\n    \"\"\"\n\n    def _count_digits_inline(n_val: int) -> int:\n        \"\"\"Counts digits of n_val's absolute value. Zero counts as one digit.\"\"\"\n        n_val = abs(n_val)\n        if n_val == 0:\n            return 1\n        count = 0\n        while n_val > 0:\n            n_val //= 10\n            count += 1\n        return count\n\n    def _is_at_most_two_digits_inline(n_val: int) -> bool:\n        \"\"\"Determines if n_val (absolute) has two or fewer digits.\"\"\"\n        return _count_digits_inline(n_val) <= 2\n\n    current_sum = 0\n    for element in arr[:k]:\n        if _is_at_most_two_digits_inline(element):\n            current_sum += element\n            \n    return current_sum\n```"}
{"task_id": "HumanEval/123", "solution": "```python\ndef get_odd_collatz(n):\n    \"\"\"\n    Computes the odd numbers in the Collatz sequence for a positive integer n.\n    Returns a sorted list of unique odd integers from the sequence.\n    \"\"\"\n    odd_numbers_found = set()\n    current = n\n\n    while True:\n        if current % 2 != 0:\n            odd_numbers_found.add(current)\n\n        if current == 1:\n            break\n\n        if current % 2 == 0:\n            current = current // 2\n        else:\n            current = 3 * current + 1\n\n    return sorted(list(odd_numbers_found))\n```"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in Collatz sequence.\n    The function iteratively computes the Collatz sequence, collecting unique odd numbers.\n    \"\"\"\n    \n    odd_numbers = set()\n    current_number = n\n\n    while current_number != 1:\n        if current_number % 2 == 1:\n            odd_numbers.add(current_number)\n            current_number = 3 * current_number + 1\n        else:\n            current_number = current_number // 2\n    \n    # Add 1 to the set, as it's always the terminal odd number.\n    odd_numbers.add(1)\n    \n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/124", "solution": "```python\nimport re\n\ndef valid_date(date):\n    \"\"\"\n    Validates a date string in mm-dd-yyyy format according to specific day/month rules.\n    Returns True if valid, False otherwise.\n    \"\"\"\n    # Check strict mm-dd-yyyy format with two-digit month/day and four-digit year (FR4)\n    DATE_PATTERN = re.compile(r'^\\d{2}-\\d{2}-\\d{4}$')\n    if not DATE_PATTERN.match(date):\n        return False\n\n    # Parse month, day, year from the string (FR1)\n    try:\n        month_str, day_str, year_str = date.split('-')\n        month = int(month_str)\n        day = int(day_str)\n        year = int(year_str)\n    except ValueError:\n        # Return False if any part cannot be converted to an integer\n        return False\n\n    # Validate month range (FR2): months should not be less than 1 or higher than 12\n    if not (1 <= month <= 12):\n        return False\n\n    # Validate day range (FR3): Day cannot be less than 1 (e.g., 04-00-2040)\n    if not (1 <= day):\n        return False\n\n    # Define the maximum days for each month, with February allowing up to 29 (Business Rule 1)\n    days_in_month = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31, # Months with 31 days\n        4: 30, 6: 30, 9: 30, 11: 30,                       # Months with 30 days\n        2: 29                                              # February, max 29 days (no leap year logic per spec)\n    }\n\n    # Check if the day exceeds the maximum for the given month\n    # .get(month, 0) handles cases where 'month' might somehow be invalid (though already checked above)\n    if day > days_in_month.get(month, 0):\n        return False\n\n    # Validate year range: years are four-digit values between 0001 and 9999 (Business Rule 3)\n    if not (1 <= year <= 9999):\n        return False\n\n    # If all checks pass, the date is valid\n    return True\n```"}
{"task_id": "HumanEval/124", "solution": "```python\ndef valid_date(date):\n    \"\"\"\n    Validates a date string in mm-dd-yyyy format against specific rules.\n    Returns True if valid, False otherwise for any input.\n    \"\"\"\n    try:\n        if not date: # Handles empty string and None implicitly.\n            return False\n\n        parts = date.split('-')\n        if len(parts) != 3: # Expects exactly two hyphens, three parts.\n            return False\n\n        month_str, day_str, year_str = parts\n\n        # Check if each part consists only of digits.\n        if not (month_str.isdigit() and day_str.isdigit() and year_str.isdigit()):\n            return False\n\n        # Check length constraints for each part, allowing 1 or 2 digits for month/day, 4 for year.\n        if not (1 <= len(month_str) <= 2 and\n                1 <= len(day_str) <= 2 and\n                len(year_str) == 4):\n            return False\n\n        month = int(month_str)\n        day = int(day_str)\n        year = int(year_str) # Year value itself is not explicitly validated beyond being an int.\n\n        if not (1 <= month <= 12): # Rule: month must be between 1 and 12.\n            return False\n\n        # Rule: Validate day based on month; February allows up to 29 days.\n        max_days_by_month = {\n            1: 31, 2: 29, 3: 31, 4: 30, 5: 31, 6: 30,\n            7: 31, 8: 31, 9: 30, 10: 31, 11: 30, 12: 31\n        }\n\n        # `month` is guaranteed to be a valid key here due to the `if not (1 <= month <= 12)` check.\n        max_day = max_days_by_month.get(month)\n\n        if not (1 <= day <= max_day): # Rule: day must be within valid range for the month.\n            return False\n\n        return True\n    except AttributeError:\n        # Catches cases where 'date' is not a string (e.g., int, list) and lacks .split() method.\n        return False\n\n```"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits text based on whitespace, then commas, or counts odd-indexed lowercase letters.\n    Follows specific precedence rules for splitting and counting.\n    \"\"\"\n    has_whitespace = False\n    for char in txt:\n        if char.isspace():\n            has_whitespace = True\n            break\n    \n    if has_whitespace:\n        return txt.split()\n\n    if ',' in txt:\n        return txt.split(',')\n\n    count = 0\n    base_ord_a = ord('a')\n    for char in txt:\n        if 'a' <= char <= 'z':\n            index = ord(char) - base_ord_a\n            if index % 2 == 1:\n                count += 1\n    return count"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Given a string, returns a list of words or an integer count based on content.\n    Prioritizes whitespace splitting, then comma splitting, then lowercase odd-index letter count.\n    \"\"\"\n    \n    # Inlined helper to check for whitespace presence.\n    def _is_whitespace_present(text: str) -> bool:\n        return any(ch.isspace() for ch in text)\n\n    # Inlined helper to check for comma presence.\n    def _is_comma_present(text: str) -> bool:\n        return ',' in text\n\n    # Inlined helper to count lowercase odd-indexed letters.\n    def _count_lowercase_odd_letters(text: str) -> int:\n        count = 0\n        for char in text:\n            if 'a' <= char <= 'z':\n                index = ord(char) - ord('a')\n                if index % 2 == 1:\n                    count += 1\n        return count\n\n    if _is_whitespace_present(txt):\n        return txt.split()\n    elif _is_comma_present(txt):\n        return [token.strip() for token in txt.split(',')]\n    else:\n        return _count_lowercase_odd_letters(txt)"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    # Check duplicate constraint: any number occurring more than twice makes the list invalid.\n    counts = {}\n    for x in lst:\n        counts[x] = counts.get(x, 0) + 1\n\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    # Check for non-decreasing (ascending) order.\n    # An empty or single-element list is considered sorted at this point.\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/126", "solution": "from collections import Counter\n\ndef is_sorted(lst):\n    '''\n    Checks if a list is sorted non-decreasingly and has no number appearing three or more times.\n    Assumes input is a list of non-negative integers.\n    '''\n    # Check for excessive duplicates: a number may appear at most twice.\n    counts = Counter(lst)\n    for count in counts.values():\n        if count >= 3:\n            return False\n\n    # Check if the list is sorted in non-decreasing order.\n    if not lst:\n        return True\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/127", "solution": "import math\n\ndef intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two closed integer intervals is a prime number.\n    Returns \"YES\" if the length is prime, \"NO\" otherwise or if no intersection.\"\"\"\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    # Calculate intersection boundaries\n    intersection_start = max(start1, start2)\n    intersection_end = min(end1, end2)\n\n    # If no intersection, the length is considered 0.\n    if intersection_end < intersection_start:\n        return \"NO\"\n\n    # Calculate length of intersection using (end - start) definition.\n    length = intersection_end - intersection_start\n\n    # Determine if the calculated length is a prime number.\n    n = length\n    if n <= 1:\n        is_prime_result = False\n    elif n <= 3:\n        is_prime_result = True\n    elif n % 2 == 0:\n        is_prime_result = False\n    else:\n        # Check for factors up to the square root of n.\n        r = int(math.isqrt(n))\n        is_prime_result = True\n        for i in range(3, r + 1, 2):\n            if n % i == 0:\n                is_prime_result = False\n                break\n    \n    if is_prime_result:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/127", "solution": "```python\nimport math\n\ndef intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two closed integer intervals is a prime number.\"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a non-negative integer is prime.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0:\n            return False\n        \n        r = int(math.isqrt(n))\n        i = 3\n        while i <= r:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    intersect_start = max(start1, start2)\n    intersect_end = min(end1, end2)\n\n    # Calculate the length of the intersection for closed intervals.\n    # If intersect_start > intersect_end, there is no intersection, resulting in a length of 0.\n    intersection_length = max(0, intersect_end - intersect_start + 1)\n\n    if is_prime(intersection_length):\n        return \"YES\"\n    else:\n        return \"NO\"\n```"}
{"task_id": "HumanEval/128", "solution": "```python\ndef prod_signs(arr):\n    \"\"\"\n    Computes sum of magnitudes of integers multiplied by product of all signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs_val = 1\n    sum_of_magnitudes_val = 0\n\n    def _get_sign(n):\n        if n > 0:\n            return 1\n        elif n < 0:\n            return -1\n        else:\n            return 0\n\n    for x in arr:\n        product_of_signs_val *= _get_sign(x)\n        sum_of_magnitudes_val += abs(x)\n\n    return product_of_signs_val * sum_of_magnitudes_val\n```"}
{"task_id": "HumanEval/128", "solution": "```python\ndef prod_signs(arr):\n    \"\"\"\n    Computes the sum of magnitudes of integers multiplied by the product of their signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    sign_product = 1\n    magnitude_sum = 0\n\n    for x in arr:\n        if x > 0:\n            current_sign = 1\n        elif x < 0:\n            current_sign = -1\n        else:\n            current_sign = 0\n        \n        sign_product *= current_sign\n        magnitude_sum += abs(x)\n\n    return sign_product * magnitude_sum\n```"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Computes the lexicographically minimum path of length k on a grid.\n    Starts at value 1 and greedily moves to the neighbor with the smallest value.\n    \"\"\"\n    N = len(grid)\n    \n    # Preprocessing: Build a map from value to its (row, col) coordinates.\n    value_to_coord = {}\n    for r in range(N):\n        for c in range(N):\n            value_to_coord[grid[r][c]] = (r, c)\n\n    # The path must start at the smallest possible value, which is 1.\n    current_r, current_c = value_to_coord[1]\n\n    path = []\n    # Define orthogonal movement directions: (dr, dc) for (row_change, col_change).\n    DIRECTIONS = [(0, 1), (0, -1), (1, 0), (-1, 0)] # Right, Left, Down, Up\n\n    # Iterate k times to build a path of length k.\n    for _ in range(k):\n        path.append(grid[current_r][current_c])\n\n        # If the path has reached length k, stop.\n        if len(path) == k:\n            break\n\n        # Find the neighbor cell with the minimum value.\n        min_neighbor_value = float('inf')\n        next_r, next_c = -1, -1 # Placeholder for next coordinates\n\n        for dr, dc in DIRECTIONS:\n            neighbor_r, neighbor_c = current_r + dr, current_c + dc\n\n            # Check if the neighbor is within grid bounds.\n            if 0 <= neighbor_r < N and 0 <= neighbor_c < N:\n                neighbor_value = grid[neighbor_r][neighbor_c]\n                # Update if a smaller neighbor value is found.\n                if neighbor_value < min_neighbor_value:\n                    min_neighbor_value = neighbor_value\n                    next_r, next_c = neighbor_r, neighbor_c\n        \n        # Move to the chosen minimum neighbor for the next step.\n        current_r, current_c = next_r, next_c\n            \n    return path"}
{"task_id": "HumanEval/129", "solution": "```python\ndef minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically minimum path of exactly k cells on an N x N grid.\n    Moves are to orthogonally adjacent cells; re-visiting cells is permitted.\n    \"\"\"\n    N = len(grid)\n\n    # Internal helper for Position, similar to src/minpath_app/models/position.py\n    class Position:\n        __slots__ = ('row', 'col')\n        def __init__(self, row, col):\n            self.row = row\n            self.col = col\n        def __eq__(self, other):\n            return self.row == other.row and self.col == other.col\n        def __hash__(self):\n            return hash((self.row, self.col))\n        def __repr__(self):\n            return f\"P({self.row},{self.col})\"\n\n    # Shared constants, similar to src/minpath_app/config.py\n    DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n\n    # Grid model properties and methods (inlined from src/minpath_app/models/grid.py)\n    rows, cols = N, N\n    value_to_pos = {}\n    for r_idx in range(rows):\n        for c_idx in range(cols):\n            value_to_pos[grid[r_idx][c_idx]] = Position(r_idx, c_idx)\n\n    def get_value(pos):\n        return grid[pos.row][pos.col]\n\n    def get_position_of_value(value):\n        return value_to_pos[value]\n\n    def in_bounds(pos):\n        return 0 <= pos.row < rows and 0 <= pos.col < cols\n\n    # Neighbors utility (inlined from src/minpath_app/utils/neighbors.py)\n    def get_neighbors(pos):\n        neighbors = []\n        for dr, dc in DIRECTIONS:\n            nbr_pos = Position(pos.row + dr, pos.col + dc)\n            if in_bounds(nbr_pos):\n                neighbors.append(nbr_pos)\n        return neighbors\n\n    # DPTable for feasibility checks (inlined from src/minpath_app/services/dp_table.py)\n    dp_table_max_k = k\n    dp_table_data = None # This will be the 3D boolean array table[remaining][r][c]\n\n    def build_dp_table():\n        nonlocal dp_table_data\n        dp_table_data = [[[False for _ in range(cols)] for _ in range(rows)] for _ in range(dp_table_max_k + 1)]\n\n        # Base case: A path of length 1 is possible from any cell\n        for r_idx in range(rows):\n            for c_idx in range(cols):\n                dp_table_data[1][r_idx][c_idx] = True\n\n        # Build up for paths of length t from 2 to dp_table_max_k\n        for t in range(2, dp_table_max_k + 1):\n            for r_idx in range(rows):\n                for c_idx in range(cols):\n                    current_pos = Position(r_idx, c_idx)\n                    for nbr_pos in get_neighbors(current_pos):\n                        # If a path of length t-1 can end at a neighbor, then a path of length t can end at current_pos\n                        if dp_table_data[t - 1][nbr_pos.row][nbr_pos.col]:\n                            dp_table_data[t][r_idx][c_idx] = True\n                            break # Found one, no need to check other neighbors\n\n    def can_complete_from(pos, remaining_steps):\n        # remaining_steps refers to the number of cells still to be chosen, including 'pos' itself.\n        if remaining_steps <= 0:\n            return remaining_steps == 0 # If 0 steps remain, the path is complete.\n        if remaining_steps > dp_table_max_k:\n            return False\n        return dp_table_data[remaining_steps][pos.row][pos.col]\n\n    # Initialize and build the DP table\n    build_dp_table()\n\n    # PathFinder core algorithm (inlined from src/minpath_app/services/path_finder.py)\n\n    def _choose_next(current_pos, remaining_steps_to_pick):\n        candidate_neighbors = get_neighbors(current_pos)\n        \n        # Sort neighbors by their values for lexicographical minimality\n        sorted_candidates_with_values = []\n        for nbr_pos in candidate_neighbors:\n            sorted_candidates_with_values.append((get_value(nbr_pos), nbr_pos))\n        sorted_candidates_with_values.sort(key=lambda x: x[0]) # Python's sort is stable\n\n        for _, candidate_pos in sorted_candidates_with_values:\n            # Check if taking this candidate allows completing the remaining path length\n            if can_complete_from(candidate_pos, remaining_steps_to_pick - 1):\n                return candidate_pos\n        \n        # Problem guarantees a unique answer, so a feasible path should always be found.\n        return None # Should not be reached in a valid scenario\n\n    # Main path finding logic\n    # Start at the cell with value 1, as per lexicographical minimality\n    current_pos = get_position_of_value(1)\n    path_values = [get_value(current_pos)]\n\n    remaining_steps = k - 1 # Number of additional cells to pick\n\n    while remaining_steps > 0:\n        current_pos = _choose_next(current_pos, remaining_steps)\n        path_values.append(get_value(current_pos))\n        remaining_steps -= 1\n    \n    return path_values\n```"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Computes the first n+1 numbers of the Tribonacci sequence.\n    This sequence is defined by specific rules for even and odd indices.\"\"\"\n    \n    sequence = []\n\n    # tri(0) is assumed to be 1\n    if n >= 0:\n        sequence.append(1)\n    \n    # tri(1) is defined as 3\n    if n >= 1:\n        sequence.append(3)\n    \n    # Compute subsequent Tribonacci numbers\n    for k in range(2, n + 1):\n        if k % 2 == 0:\n            # tri(k) = 1 + k / 2, for even k (integer division)\n            sequence.append(1 + k // 2)\n        else:\n            # tri(k) = tri(k - 1) + tri(k - 2) + tri(k + 1), for odd k.\n            # tri(k+1) is calculated using the even formula as k+1 is even.\n            val_k_minus_1 = sequence[k - 1]\n            val_k_minus_2 = sequence[k - 2]\n            val_k_plus_1 = 1 + (k + 1) // 2 # Compute tri(k+1) on demand\n            sequence.append(val_k_minus_1 + val_k_minus_2 + val_k_plus_1)\n            \n    return sequence"}
{"task_id": "HumanEval/130", "solution": "def tri(n: int) -> list[int]:\n    \"\"\"Computes the first n+1 numbers of a variant Tribonacci sequence.\n    Handles odd-indexed recurrence by substituting the even rule for tri(i+1).\n    \"\"\"\n    memo: dict[int, int] = {}\n    sequence: list[int] = []\n\n    # Base cases for tri(0) and tri(1) as derived from the problem description and example.\n    memo[0] = 1\n    memo[1] = 3\n\n    for i in range(n + 1):\n        if i in memo:\n            sequence.append(memo[i])\n            continue\n\n        if i % 2 == 0:  # i is even\n            memo[i] = 1 + (i // 2)\n        else:  # i is odd\n            # For an odd index `i`, `i+1` is an even index.\n            # We can substitute `tri(i+1) = 1 + (i+1)//2` directly into the recurrence.\n            tri_i_minus_1 = memo[i - 1]\n            tri_i_minus_2 = memo[i - 2]\n            tri_i_plus_1_val = 1 + ((i + 1) // 2)\n            memo[i] = tri_i_minus_1 + tri_i_minus_2 + tri_i_plus_1_val\n        \n        sequence.append(memo[i])\n        \n    return sequence"}
