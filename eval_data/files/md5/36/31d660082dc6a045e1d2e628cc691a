TTP API endpoint for filtering operations using FastAPI.\"\"\"\n    def __init__(self, service: FilterService) -> None:\n        self.service = service\n        self.app = FastAPI(\n            title=\"IntFilter API\",\n            description=\"API for filtering lists to extract integers.\",\n            version=\"0.1.0\"\n        )\n        self._register_routes()\n\n    def _register_routes(self):\n        \"\"\"Registers the API endpoints with the FastAPI application.\"\"\"\n        @self.app.post(\"/filter\", response_model=Dict[str, List[int]], summary=\"Filter a list for integers\")\n        async def post_filter(request: FilterRequest):\n            \"\"\"\n            Filters a list of values, returning only strict integers.\n            Booleans (True/False) are excluded.\n            \"\"\"\n            try:\n                result = self.service.filter(request.values)\n                return {\"result\": result}\n            except ValidationError as e:\n                raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))\n            except PersistenceError:\n                raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"Internal persistence error occurred.\")\n            except Exception as e:\n                raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=f\"An unexpected error occurred: {e}\")\n\n    def get_app(self) -> FastAPI:\n        \"\"\"Returns the FastAPI application instance.\"\"\"\n        return self.app\n\n```\n# src/intfilter/exceptions.py\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\nclass PersistenceError(Exception):\n    \"\"\"Exception raised for issues during data persistence.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\n```\n# src/intfilter/utils.py\nimport json\nfrom typing import Any, List, Union\n\ndef serialize_json(obj: Any) -> str:\n    \"\"\"Serializes an object to a JSON string, ensuring non-ASCII characters are not escaped.\"\"\"\n    return json.dumps(obj, ensure_ascii=False)\n\ndef parse_values_from_file(path: str) -> List[Any]:\n    \"\"\"Reads a file and attempts to parse it as a JSON array or a series of JSON lines.\"\"\"\n    try:\n        with open(path, \"r\", encoding=\"utf-8\") as fh:\n            data = fh.read().strip()\n            if not data:\n                return []\n            \n            try:\n                parsed = json.loads(data)\n                if isinstance(parsed, list):\n                    return parsed\n            except json.JSONDecodeError:\n                pass\n\n            values = []\n            for line in data.splitlines():\n                stripped_line = line.strip()\n                if stripped_line:\n                    values.append(json.loads(stripped_line))\n            return values\n    except FileNotFoundError:\n        raise FileNotFoundError(f\"File not found: {path}\")\n    except json.JSONDecodeError as e:\n        raise ValueError(f\"Invalid JSON format in file {path}: {e}\")\n    except Exception as e:\n        raise IOError(f\"Error reading or parsing file {path}: {e}\")\n\ndef is_iterable(obj: Any) -> bool:\n    \"\"\"Checks if an object is iterable but not a string or bytes.\"\"\"\n    try:\n        iter(obj)\n        return not isinstance(obj, (str, bytes))\n    except TypeError:\n        return False\n\n```\n# scripts/cli.py\n#!/usr/bin/env python3\nimport sys\nimport logging\n\nfrom intfilter.validators import TypeValidator\nfrom intfilter.services import FilterService\nfrom intfilter.repository import FileRepository\nfrom intfilter.controllers import CLIController\n\nlogging.basicConfig(level=logging.INFO, format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n_logger = logging.getLogger(\"intfilter.cli\")\n\ndef main(argv=None):\n    \"\"\"Main entry point for the command-line interface.\"\"\"\n    argv = argv if argv is not None else sys.argv[1:]\n\n    validator = TypeValidator()\n    repository = FileRepository()\n    \n    service = FilterService(validator=validator, repository=repository, persist=FilterService.DEFAULT_PERSIST, logger=_logger)\n    \n    controller = CLIController(service)\n    return controller.run(argv)\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n```"}
