{"task_id": "HumanEval/14", "solution": "```python\n# src/prefixer/config.py\nfrom dataclasses import dataclass\n\nDEFAULT_CACHE_SIZE: int = 1024\nDEFAULT_CACHE_FILE: str = \"prefix_cache.json\"\n\n@dataclass\nclass AppConfig:\n    \"\"\"Application configuration settings.\"\"\"\n    cache_size: int = DEFAULT_CACHE_SIZE\n    cache_file: str = DEFAULT_CACHE_FILE\n\n```\n```python\n# src/prefixer/utils.py\nimport logging\nimport sys\nfrom typing import Union\n\ndef is_valid_input(string: object) -> bool:\n    \"\"\"Checks if the input object is a string.\"\"\"\n    return isinstance(string, str)\n\ndef configure_logging(level: Union[str, int] = \"INFO\") -> None:\n    \"\"\"Configures basic logging for the application.\"\"\"\n    logging.basicConfig(level=level, stream=sys.stdout,\n                        format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n    # Suppress verbose logging from uvicorn/fastapi by default for cleaner output\n    logging.getLogger(\"uvicorn.access\").setLevel(logging.WARNING)\n    logging.getLogger(\"uvicorn.error\").setLevel(logging.WARNING)\n    logging.getLogger(\"fastapi\").setLevel(logging.WARNING)\n\n```\n```python\n# src/prefixer/core.py\nfrom typing import List\nfrom prefixer.utils import is_valid_input\nimport logging\n\nlogger = logging.getLogger(__name__)\n\nclass PrefixGenerator:\n    \"\"\"Generates all non-empty prefixes of a given string.\"\"\"\n\n    name: str = \"PrefixGenerator\"\n\n    def all_prefixes(self, string: str) -> List[str]:\n        \"\"\"Returns a list of all non-empty prefixes from shortest to longest.\"\"\"\n        self._validate(string)\n        if not string:\n            return []\n        return [string[:i] for i in range(1, len(string) + 1)]\n\n    def _validate(self, string: str) -> None:\n        \"\"\"Ensures the input is a string; raises ValueError otherwise.\"\"\"\n        if not is_valid_input(string):\n            logger.error(f\"Invalid input type: expected str, got {type(string).__name__}\")\n            raise ValueError(\"Input must be a string.\")\n\n```\n```python\n# src/prefixer/repository.py\nfrom abc import ABC, abstractmethod\nfrom collections import OrderedDict\nfrom typing import List, Optional\nimport logging\n\nlogger = logging.getLogger(__name__)\n\nclass PrefixRepository(ABC):\n    \"\"\"Abstract base class for caching prefix results.\"\"\"\n\n    @abstractmethod\n    def get(self, key: str) -> Optional[List[str]]:\n        \"\"\"Retrieves cached prefixes for a given key.\"\"\"\n        pass\n\n    @abstractmethod\n    def set(self, key: str, value: List[str]) -> None:\n        \"\"\"Stores prefixes in the cache for a given key.\"\"\"\n        pass\n\n    @abstractmethod\n    def clear() -> None:\n        \"\"\"Clears all entries from the cache.\"\"\"\n        pass\n\nclass InMemoryPrefixRepository(PrefixRepository):\n    \"\"\"An in-memory cache for prefixes with a maximum size.\"\"\"\n\n    def __init__(self, max_size: int):\n        \"\"\"Initializes the in-memory repository with a max size.\"\"\"\n        if max_size <= 0:\n            raise ValueError(\"max_size must be a positive integer.\")\n        self._store: OrderedDict[str, List[str]] = OrderedDict()\n        self._max_size = max_size\n        logger.info(f\"Initialized InMemoryPrefixRepository with max_size={max_size}\")\n\n    def get(self, key: str) -> Optional[List[str]]:\n        \"\"\"Retrieves cached prefixes for a given key, updating its recency.\"\"\"\n        if key in self._store:\n            value = self._store.pop(key)  # Move to end to mark as recently used (LRU)\n            self._store[key] = value\n            return value\n        return None\n\n    def set(self, key: str, value: List[str]) -> None:\n        \"\"\"Stores prefixes in the cache, managing max size.\"\"\"\n        if key in self._store:\n            self._store.pop(key) # Remove if exists to update its position\n        self._store[key] = value\n\n        if len(self._store) > self._max_size:\n            self._store.popitem(last=False)  # Evict oldest item (FIFO/LRU)\n\n    def clear(self) -> None:\n        \"\"\"Clears all entries from the in-memory cache.\"\"\"\n        self._store.clear()\n        logger.info(\"InMemoryPrefixRepository cleared.\")\n\n```\n```python\n# src/prefixer/adapters/file_adapter.py\nimport json\nimport logging\nfrom typing import List, Optional\nfrom prefixer.repository import PrefixRepository\nfrom prefixer.config import DEFAULT_CACHE_FILE\n\nlogger = logging.getLogger(__name__)\n\nclass FilePrefixRepositoryAdapter(PrefixRepository):\n    \"\"\"A file-backed cache for prefixes, persisting to a JSON file.\"\"\"\n\n    def __init__(self, filepath: str = DEFAULT_CACHE_FILE):\n        \"\"\"Initializes the file-backed repository and loads existing cache.\"\"\"\n        self.filepath = filepath\n        self._store: dict[str, List[str]] = {}\n        self._load()\n        logger.info(f\"Initialized FilePrefixRepositoryAdapter using file: {filepath}\")\n\n    def _load(self) -> None:\n        \"\"\"Loads cache data from the file.\"\"\"\n        try:\n            with open(self.filepath, 'r', encoding='utf-8') as f:\n                self._store = json.load(f)\n            logger.debug(f\"Loaded cache from {self.filepath}\")\n        except FileNotFoundError:\n            logger.info(f\"Cache file not found at {self.filepath}, starting with empty cache.\")\n            self._store = {}\n        except json.JSONDecodeError as e:\n            logger.warning(f\"Corrupt cache file at {self.filepath}: {e}. Starting with empty cache.\")\n            self._store = {}\n        except IOError as e:\n            logger.error(f\"Error loading cache from {self.filepath}: {e}. Starting with empty cache.\")\n            self._store = {}\n\n    def _save(self) -> None:\n        \"\"\"Saves current cache data to the file.\"\"\"\n        try:\n            with open(self.filepath, 'w', encoding='utf-8') as f:\n                json.dump(self._store, f, ensure_ascii=False, indent=2)\n            logger.debug(f\"Saved cache to {self.filepath}\")\n        except IOError as e:\n            logger.error(f\"Error saving cache to {self.filepath}: {e}\")\n\n    def get(self, key: str) -> Optional[List[str]]:\n        \"\"\"Retrieves cached prefixes for a given key.\"\"\"\n        return self._store.get(key)\n\n    def set(self, key: str, value: List[str]) -> None:\n        \"\"\"Stores prefixes in the cache and saves to file.\"\"\"\n        self._store[key] = value\n        self._save()\n\n    def clear(self) -> None:\n        \"\"\"Clears all entries and saves an empty cache to file.\"\"\"\n        self._store.clear()\n        self._save()\n        logger.info(f\"FilePrefixRepositoryAdapter cache cleared at {self.filepath}.\")\n\n```\n```python\n# src/prefixer/dto.py\nfrom typing import List\nfrom pydantic import BaseModel\n\nclass PrefixRequest(BaseModel):\n    \"\"\"Request model for the prefixes endpoint.\"\"\"\n    input: str\n\nclass PrefixResponse(BaseModel):\n    \"\"\"Response model for the prefixes endpoint.\"\"\"\n    prefixes: List[str]\n\n```\n```python\n# src/prefixer/service.py\nimport logging\nfrom typing import List, Optional\n\nfrom prefixer.repository import PrefixRepository\nfrom prefixer.core import PrefixGenerator\n\nlogger = logging.getLogger(__name__)\n\nclass PrefixService:\n    \"\"\"Orchestrates prefix generation and caching.\"\"\"\n\n    def __init__(self, repo: PrefixRepository, generator: PrefixGenerator, cache_enabled: bool = True):\n        \"\"\"Initializes the PrefixService with a repository and generator.\"\"\"\n        self._repo = repo\n        self._generator = generator\n        self.cache_enabled = cache_enabled\n        logger.info(f\"PrefixService initialized with cache_enabled={self.cache_enabled}\")\n\n    def get_prefixes(self, string: str, use_cache: Optional[bool] = None) -> List[str]:\n        \"\"\"Returns prefixes for a string, utilizing cache if enabled.\"\"\"\n        self._generator._validate(string) # Delegate input validation to generator\n\n        effective_use_cache = self.cache_enabled and (use_cache is None or use_cache is True)\n\n        if effective_use_cache:\n            try:\n                cached_result = self._repo.get(string)\n                if cached_result is not None:\n                    logger.debug(f\"Cache hit for '{string}'\")\n                    return cached_result\n                logger.debug(f\"Cache miss for '{string}'\")\n            except Exception as e:\n                logger.error(f\"Error accessing cache for '{string}': {e}. Proceeding without cache.\")\n\n        prefixes = self._generator.all_prefixes(string)\n\n        if effective_use_cache:\n            try:\n                self._repo.set(string, prefixes)\n                logger.debug(f\"Cached result for '{string}'\")\n            except Exception as e:\n                logger.error(f\"Error storing in cache for '{string}': {e}\")\n        return prefixes\n\n    def clear_cache(self) -> None:\n        \"\"\"Clears the underlying repository cache.\"\"\"\n        try:\n            self._repo.clear()\n            logger.info(\"Service cache cleared.\")\n        except Exception as e:\n            logger.error(f\"Error clearing cache: {e}\")\n\n```\n```python\n# src/prefixer/api.py\nimport logging\nfrom fastapi import FastAPI, HTTPException, status\nfrom prefixer.service import PrefixService\nfrom prefixer.dto import PrefixRequest, PrefixResponse\n\nlogger = logging.getLogger(__name__)\n\nclass PrefixAPI:\n    \"\"\"FastAPI application for prefix generation.\"\"\"\n\n    def __init__(self, service: PrefixService):\n        \"\"\"Initializes PrefixAPI with a PrefixService instance.\"\"\"\n        self.app = FastAPI(\n            title=\"Prefixer API\",\n            description=\"API to generate all non-empty prefixes of a string.\",\n            version=\"1.0.0\"\n        )\n        self._service = service\n        self._register_routes()\n\n    def _register_routes(self):\n        \"\"\"Registers API endpoints.\"\"\"\n        @self.app.post(\"/prefixes\", response_model=PrefixResponse, summary=\"Get prefixes for a string\")\n        async def _post_prefixes(req: PrefixRequest):\n            return self._post_prefixes_handler(req)\n\n    def _post_prefixes_handler(self, req: PrefixRequest) -> PrefixResponse:\n        \"\"\"Handles POST /prefixes requests.\"\"\"\n        try:\n            prefixes = self._service.get_prefixes(req.input)\n            return PrefixResponse(prefixes=prefixes)\n        except ValueError as e:\n            logger.warning(f\"Bad request: {e}\")\n            raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))\n        except Exception as e:\n            logger.exception(\"An unexpected error occurred during prefix generation.\")\n            raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"Internal server error\")\n\n    def create_app(self) -> FastAPI:\n        \"\"\"Returns the configured FastAPI application instance.\"\"\"\n        logger.info(\"FastAPI app created and routes registered.\")\n        return self.app\n\n```\n```python\n# src/prefixer/cli.py\nimport argparse\nimport json\nimport sys\nimport logging\nfrom typing import List, Optional\n\nfrom prefixer.service import PrefixService\nfrom prefixer.core import PrefixGenerator\nfrom prefixer.repository import InMemoryPrefixRepository\nfrom prefixer.config import AppConfig\nfrom prefixer.utils import configure_logging\n\nlogger = logging.getLogger(__name__)\n\nclass PrefixCLI:\n    \"\"\"Command-line interface for the prefixer service.\"\"\"\n\n    def __init__(self, service: Optional[PrefixService] = None, config: Optional[AppConfig] = None):\n        \"\"\"Initializes the CLI with an optional service and configuration.\"\"\"\n        if config is None:\n            config = AppConfig()\n        # Initial logging configuration will be overridden by --log-level\n        configure_logging(logging.INFO) \n        if service is None:\n            # Default service setup for CLI\n            repo = InMemoryPrefixRepository(max_size=config.cache_size)\n            generator = PrefixGenerator()\n            self._service = PrefixService(repo=repo, generator=generator)\n        else:\n            self._service = service\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Parses arguments and executes the prefix generation command.\"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"prefixer\", # For correct help message\n            description=\"Generate all non-empty prefixes of a string.\"\n        )\n        parser.add_argument(\n            \"input_string\",\n            type=str,\n            nargs='?', # Make optional to allow --clear-cache alone\n            help=\"The string for which to generate prefixes.\"\n        )\n        parser.add_argument(\n            \"--json\",\n            action=\"store_true\",\n            help=\"Output prefixes as a JSON array.\"\n        )\n        parser.add_argument(\n            \"--no-cache\",\n            action=\"store_true\",\n            help=\"Do not use the cache for this request.\"\n        )\n        parser.add_argument(\n            \"--clear-cache\",\n            action=\"store_true\",\n            help=\"Clear the cache before processing any input string.\"\n        )\n        parser.add_argument(\n            \"--cache-size\",\n            type=int,\n            default=AppConfig().cache_size,\n            help=f\"Set the in-memory cache size (default: {AppConfig().cache_size}).\"\n        )\n        parser.add_argument(\n            \"--log-level\",\n            type=str,\n            default=\"INFO\",\n            choices=[\"DEBUG\", \"INFO\", \"WARNING\", \"ERROR\", \"CRITICAL\"],\n            help=\"Set the logging level.\"\n        )\n\n        args = parser.parse_args(argv)\n\n        configure_logging(args.log_level) # Reconfigure logging with user specified level\n\n        if args.clear_cache:\n            logger.info(\"Clearing cache as requested.\")\n            self._service.clear_cache()\n            if not args.input_string: # If only clear-cache was requested, exit after clearing\n                return 0\n\n        if args.input_string is None:\n            parser.error(\"input_string is required unless --clear-cache is used alone.\")\n            return 2 # Should not be reached due to parser.error\n\n        try:\n            prefixes = self._service.get_prefixes(\n                args.input_string,\n                use_cache=not args.no_cache\n            )\n            if args.json:\n                print(json.dumps({\"prefixes\": prefixes}))\n            else:\n                for prefix in prefixes:\n                    print(prefix)\n            return 0\n        except ValueError as e:\n            logger.error(f\"Error: {e}\")\n            print(f\"Error: {e}\", file=sys.stderr)\n            return 1\n        except Exception as e:\n            logger.exception(\"An unexpected error occurred during CLI execution.\")\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n\ndef main():\n    \"\"\"Entry point for the prefixer CLI console script.\"\"\"\n    sys.exit(PrefixCLI().run(sys.argv[1:]))\n\n```\n```python\n# src/prefixer/__init__.py\nfrom prefixer.core import PrefixGenerator\nfrom prefixer.service import PrefixService\nfrom prefixer.repository import InMemoryPrefixRepository\nfrom prefixer.cli import PrefixCLI, main # Import main for console script\nfrom prefixer.api import PrefixAPI\nfrom prefixer.config import AppConfig\nfrom prefixer.utils import configure_logging\n\n# Factory function to create and configure the FastAPI app\ndef create_app():\n    \"\"\"Factory function to create and configure the FastAPI application.\"\"\"\n    # Configure logging for the API instance\n    configure_logging()\n    \n    config = AppConfig()\n    repo = InMemoryPrefixRepository(max_size=config.cache_size)\n    generator = PrefixGenerator()\n    service = PrefixService(repo=repo, generator=generator)\n    api = PrefixAPI(service=service)\n    return api.create_app()\n\n# Public exports for library usage\n__all__ = [\n    \"PrefixGenerator\",\n    \"PrefixService\",\n    \"InMemoryPrefixRepository\",\n    \"PrefixCLI\",\n    \"PrefixAPI\",\n    \"create_app\", # For API factory\n    \"main\", # For CLI entry point\n    \"AppConfig\", # Allow external configuration access\n]\n\n```\n```toml\n# pyproject.toml\n[project]\nname = \"prefixer\"\nversion = \"0.1.0\"\ndescription = \"A Python library and service to compute string prefixes.\"\nauthors = [\n    { name = \"Your Name\", email = \"your.email@example.com\" },\n]\nlicense = { text = \"MIT\" }\nreadme = \"README.md\"\nrequires-python = \">=3.10\"\nkeywords = [\"prefix\", \"string\", \"utility\", \"api\", \"cli\"]\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n    \"Intended Audience :: Developers\",\n    \"Topic :: Software Development :: Libraries :: Python Modules\",\n    \"Topic :: Utilities\",\n]\ndependencies = [\n    \"fastapi>=0.111.0\",\n    \"uvicorn[standard]>=0.29.0\",\n    \"pydantic>=2.0\",\n    \"pydantic-settings>=2.0\",\n]\n\n[project.scripts]\nprefixer = \"prefixer.cli:main\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\ninclude = [\"prefixer*\"]\n```\n```text\n# requirements.txt\nfastapi==0.111.0\nuvicorn[standard]==0.29.0\npydantic==2.7.1\npydantic-settings==2.3.0\n```"}
