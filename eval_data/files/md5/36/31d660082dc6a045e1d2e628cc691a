{"task_id": "HumanEval/91", "solution": "import re\n\ndef is_bored(S):\n    \"\"\"\n    Counts the number of sentences that start with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    boredom_count = 0\n    delimiters = \".?!\"\n\n    def _normalize_leading_chars(s: str) -> str:\n        \"\"\"Removes specific leading punctuation and whitespace.\"\"\"\n        _LEADING_CHARS = {'\"', \"'\", \"\u201c\", \"\u201d\", \"(\", \"[\", \"{\"}\n        s = s.lstrip()\n        while s and s[0] in _LEADING_CHARS:\n            s = s[1:].lstrip()\n        return s\n\n    _FIRST_WORD_RE = re.compile(r'^[^\\w]*([A-Za-z0-9]+)')\n\n    def _tokenize_first_word(s: str) -> str | None:\n        \"\"\"Extracts the first alphanumeric word from a sentence string.\"\"\"\n        s_normalized = _normalize_leading_chars(s)\n        m = _FIRST_WORD_RE.match(s_normalized)\n        return m.group(1) if m else None\n\n    current_sentence_buffer = []\n    \n    for char in S:\n        if char in delimiters:\n            sentence_text = \"\".join(current_sentence_buffer).strip()\n            if sentence_text:\n                first_word = _tokenize_first_word(sentence_text)\n                if first_word == \"I\":\n                    boredom_count += 1\n            current_sentence_buffer = []\n        else:\n            current_sentence_buffer.append(char)\n\n    final_piece = \"\".join(current_sentence_buffer).strip()\n    if final_piece:\n        first_word = _tokenize_first_word(final_piece)\n        if first_word == \"I\":\n            boredom_count += 1\n\n    return boredom_count"}
{"task_id": "HumanEval/91", "solution": "import re\n\ndef is_bored(S):\n    \"\"\"\n    Counts sentences starting with \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    boredom_count = 0\n    \n    # Normalize whitespace: replace multiple spaces with single space, strip leading/trailing spaces.\n    normalized_S = re.sub(r'\\s+', ' ', S).strip()\n\n    if not normalized_S:\n        return 0\n\n    # Replace sentence delimiters with a unique marker to facilitate splitting, keeping delimiters.\n    temp_text = normalized_S\n    for delimiter in ['.', '?', '!']:\n        temp_text = temp_text.replace(delimiter, delimiter + \"|SENTENCE_SPLIT_MARKER|\")\n    \n    # Split by the marker, then clean and process each candidate sentence.\n    candidate_sentences = [s.strip() for s in temp_text.split(\"|SENTENCE_SPLIT_MARKER|\")]\n\n    for sentence in candidate_sentences:\n        # Remove any trailing delimiters for accurate first-word extraction, then trim.\n        cleaned_sentence = sentence.rstrip('.?!').strip()\n        \n        if not cleaned_sentence:\n            continue\n\n        # Extract the first word and check if it's exactly \"I\" (case-sensitive).\n        first_word = cleaned_sentence.split(maxsplit=1)[0] if cleaned_sentence else \"\"\n        \n        if first_word == \"I\":\n            boredom_count += 1\n            \n    return boredom_count"}
