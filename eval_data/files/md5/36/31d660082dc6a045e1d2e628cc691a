{"task_id": "HumanEval/16", "solution": "```python\n# src/distinct_chars/exceptions.py\nclass DistinctCharsError(Exception):\n    \"\"\"Base exception for distinct_chars library errors.\"\"\"\n    pass\n\nclass ValidationError(DistinctCharsError):\n    \"\"\"Raised when input validation fails.\"\"\"\n    pass\n\nclass FileRepositoryError(DistinctCharsError):\n    \"\"\"Raised when file persistence operations fail.\"\"\"\n    pass\n\n\n# src/distinct_chars/models.py\nfrom dataclasses import dataclass\nfrom datetime import datetime\nfrom typing import Set, Dict, Any, List\n\n@dataclass(frozen=True)\nclass CountResult:\n    \"\"\"Immutable container for distinct character computation results.\"\"\"\n    input_str: str\n    normalized_str: str\n    unique_chars: Set[str]\n    distinct_count: int\n    timestamp: datetime\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Serializes fields to a JSON-serializable dictionary.\"\"\"\n        return {\n            \"input_str\": self.input_str,\n            \"normalized_str\": self.normalized_str,\n            \"unique_chars\": sorted(list(self.unique_chars)),\n            \"distinct_count\": self.distinct_count,\n            \"timestamp\": self.timestamp.isoformat() + \"Z\", # ISO 8601 with Z for UTC\n        }\n\n    @staticmethod\n    def from_dict(d: Dict[str, Any]) -> \"CountResult\":\n        \"\"\"Deserializes from a dictionary into a CountResult object.\"\"\"\n        return CountResult(\n            input_str=d[\"input_str\"],\n            normalized_str=d[\"normalized_str\"],\n            unique_chars=set(d[\"unique_chars\"]),\n            distinct_count=int(d[\"distinct_count\"]),\n            timestamp=datetime.fromisoformat(d[\"timestamp\"].rstrip(\"Z\")),\n        )\n\n\n# src/distinct_chars/utils.py\nimport unicodedata\nfrom .exceptions import ValidationError\n\nclass Normalizer:\n    \"\"\"Handles string normalization and unique character extraction.\"\"\"\n    def __init__(self, normalize_form: str = \"NFKC\"):\n        self._normalize_form = normalize_form\n\n    def normalize(self, s: str) -> str:\n        \"\"\"Applies Unicode normalization and case-folding to a string.\"\"\"\n        if not isinstance(s, str):\n            raise ValidationError(\"Input for normalization must be a string.\")\n        # Apply Unicode normalization (e.g., NFKC) then casefold for case-insensitive comparison\n        normalized = unicodedata.normalize(self._normalize_form, s)\n        return normalized.casefold()\n\n    def extract_unique_chars(self, s: str) -> set[str]:\n        \"\"\"Extracts a set of unique characters from a string after normalization.\"\"\"\n        norm = self.normalize(s)\n        return set(norm)\n\n\n# src/distinct_chars/repositories.py\nimport json\nfrom abc import ABC, abstractmethod\nfrom typing import List, Optional\nfrom .models import CountResult\nfrom .exceptions import FileRepositoryError\nimport os\n\nclass IRepository(ABC):\n    \"\"\"Abstract base class defining the contract for result persistence.\"\"\"\n    @abstractmethod\n    def save_count(self, result: CountResult) -> None:\n        \"\"\"Saves a CountResult object to the repository.\"\"\"\n        pass\n\n    @abstractmethod\n    def get_history(self, limit: Optional[int] = None) -> List[CountResult]:\n        \"\"\"Retrieves a list of historical CountResult objects.\"\"\"\n        pass\n\nclass InMemoryRepository(IRepository):\n    \"\"\"An in-memory append-only store for CountResult objects.\"\"\"\n    def __init__(self) -> None:\n        self._store: List[CountResult] = []\n\n    def save_count(self, result: CountResult) -> None:\n        \"\"\"Adds a CountResult to the in-memory store.\"\"\"\n        self._store.append(result)\n\n    def get_history(self, limit: Optional[int] = None) -> List[CountResult]:\n        \"\"\"Returns historical CountResult objects from memory, optionally limited.\"\"\"\n        if limit is None:\n            return list(self._store)\n        return list(self._store[-limit:]) # Return most recent\n\nclass FileRepository(IRepository):\n    \"\"\"Persists CountResult objects as newline-delimited JSON (NDJSON) to a file.\"\"\"\n    DEFAULT_FILE_ENCODING = \"utf-8\"\n\n    def __init__(self, file_path: str, encoding: str = DEFAULT_FILE_ENCODING) -> None:\n        self._file_path = file_path\n        self._encoding = encoding\n        # Ensure directory exists for the file\n        os.makedirs(os.path.dirname(file_path) or '.', exist_ok=True)\n\n    def save_count(self, result: CountResult) -> None:\n        \"\"\"Appends a CountResult as a JSON line to the configured file.\"\"\"\n        try:\n            with open(self._file_path, 'a', encoding=self._encoding) as f:\n                json_line = json.dumps(result.to_dict())\n                f.write(json_line + '\\n')\n                f.flush() # Ensure data is written to OS buffer\n                os.fsync(f.fileno()) # Force write to disk for durability (Unix-like systems)\n        except Exception as e:\n            raise FileRepositoryError(f\"Failed to save result to file '{self._file_path}': {e}\") from e\n\n    def get_history(self, limit: Optional[int] = None) -> List[CountResult]:\n        \"\"\"Reads and parses CountResult objects from the NDJSON file.\"\"\"\n        history: List[CountResult] = []\n        try:\n            if not os.path.exists(self._file_path):\n                return []\n\n            with open(self._file_path, 'r', encoding=self._encoding) as f:\n                for line in f:\n                    stripped_line = line.strip()\n                    if stripped_line:\n                        try:\n                            data = json.loads(stripped_line)\n                            history.append(CountResult.from_dict(data))\n                        except json.JSONDecodeError as jde:\n                            # Log error but try to continue with next line\n                            print(f\"Warning: Could not decode JSON line in {self._file_path}: {jde} - Line: {stripped_line}\", file=sys.stderr)\n        except Exception as e:\n            raise FileRepositoryError(f\"Failed to read history from file '{self._file_path}': {e}\") from e\n\n        if limit is None:\n            return history\n        return history[-limit:] # Return most recent (last N items)\n\n\n# src/distinct_chars/services.py\nfrom .models import CountResult\nfrom .utils import Normalizer\nfrom .repositories import InMemoryRepository, IRepository\nfrom .exceptions import ValidationError, FileRepositoryError\nfrom datetime import datetime\nfrom typing import Optional\n\nclass CharacterCounterService:\n    \"\"\"Core business logic for counting distinct characters and orchestrating persistence.\"\"\"\n    def __init__(self, repo: Optional[IRepository] = None, normalizer: Optional[Normalizer] = None):\n        self._repo = repo if repo is not None else InMemoryRepository()\n        self._normalizer = normalizer if normalizer is not None else Normalizer()\n\n    def count_distinct(self, input_str: str) -> CountResult:\n        \"\"\"Validates input, computes distinct characters, persists result, and returns CountResult.\"\"\"\n        if not isinstance(input_str, str):\n            raise ValidationError(\"Input for distinct character count must be a string.\")\n        \n        normalized = self._normalizer.normalize(input_str)\n        unique_chars = self._normalizer.extract_unique_chars(input_str)\n\n        result = CountResult(\n            input_str=input_str,\n            normalized_str=normalized,\n            unique_chars=unique_chars,\n            distinct_count=len(unique_chars),\n            timestamp=datetime.utcnow(),\n        )\n        try:\n            self._repo.save_count(result)\n        except Exception as e:\n            raise FileRepositoryError(f\"Failed to persist count result: {e}\") from e\n        return result\n\n    def count_distinct_int(self, input_str: str) -> int:\n        \"\"\"Convenience method returning only the distinct character count as an integer.\"\"\"\n        return self.count_distinct(input_str).distinct_count\n\n\n# src/distinct_chars/controllers.py\nimport sys\nfrom typing import Dict, Any\nfrom .services import CharacterCounterService\nfrom .models import CountResult\nfrom .exceptions import ValidationError, FileRepositoryError, DistinctCharsError\n\nclass CLIController:\n    \"\"\"Adapts the CharacterCounterService for command-line interface usage.\"\"\"\n    def __init__(self, service: CharacterCounterService) -> None:\n        self._service = service\n\n    def run(self, input_str: str, show_chars: bool = False) -> int:\n        \"\"\"Executes the distinct character count and prints results to stdout.\"\"\"\n        try:\n            if not input_str:\n                print(\"Error: No input string provided.\", file=sys.stderr)\n                return 2 # Validation error\n            \n            result = self._service.count_distinct(input_str)\n            print(f\"Distinct character count for '{result.input_str}': {result.distinct_count}\")\n            if show_chars:\n                print(f\"Unique characters: {', '.join(sorted(list(result.unique_chars)))}\")\n            return 0\n        except ValidationError as e:\n            print(f\"Error: {e}\", file=sys.stderr)\n            return 2 # Exit code for validation errors\n        except FileRepositoryError as e:\n            print(f\"Persistence Error: {e}\", file=sys.stderr)\n            return 3 # Exit code for persistence errors\n        except DistinctCharsError as e:\n            print(f\"Application Error: {e}\", file=sys.stderr)\n            return 1 # General application error\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1 # Generic unexpected error\n\nclass APIController:\n    \"\"\"Provides a programmatic adapter for the CharacterCounterService, returning serializable dictionaries.\"\"\"\n    def __init__(self, service: CharacterCounterService) -> None:\n        self._service = service\n\n    def count(self, payload: Dict[str, Any]) -> Dict[str, Any]:\n        \"\"\"Processes a payload, computes distinct characters, and returns a serializable result dict.\"\"\"\n        input_str = payload.get(\"input\")\n        if not isinstance(input_str, str):\n            raise ValidationError(\"Payload must contain an 'input' key with a string value.\")\n        \n        result = self._service.count_distinct(input_str)\n        return result.to_dict()\n\n\n# src/distinct_chars/cli.py\nimport sys\nimport argparse\nimport os\nfrom .controllers import CLIController\nfrom .services import CharacterCounterService\nfrom .repositories import FileRepository, InMemoryRepository\nfrom .exceptions import DistinctCharsError\n\nclass CLIEntry:\n    \"\"\"Command-line entrypoint for the distinct characters application.\"\"\"\n    def __init__(self, argv: list[str] | None = None):\n        self.argv = argv if argv is not None else sys.argv[1:]\n\n    def main(self) -> int:\n        \"\"\"Parses arguments, initializes services, and runs the CLI controller.\"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"distinct-chars\",\n            description=\"Computes the number of distinct characters in a string, case-insensitively.\"\n        )\n        parser.add_argument(\"input\", nargs=\"?\", default=None,\n                            help=\"Input string to process. Reads from stdin if not provided.\")\n        parser.add_argument(\"--show-chars\", action=\"store_true\",\n                            help=\"Display the unique characters found.\")\n        parser.add_argument(\"--save-file\", type=str, default=None,\n                            help=\"Path to a JSON file for saving historical counts (append-only).\")\n        parser.add_argument(\"--history\", action=\"store_true\",\n                            help=\"Show historical counts from the configured repository.\")\n        \n        args = parser.parse_args(self.argv)\n        input_str = args.input\n\n        # Read from stdin if no positional argument and stdin is not interactive\n        if input_str is None and not sys.stdin.isatty() and sys.stdin.buffer.peek():\n            input_str = sys.stdin.read().strip()\n        \n        repo_path = args.save_file\n        if repo_path:\n            os.makedirs(os.path.dirname(repo_path) or '.', exist_ok=True)\n            repo = FileRepository(repo_path)\n        else:\n            repo = InMemoryRepository() # Default to in-memory if no file specified\n\n        service = CharacterCounterService(repo=repo)\n        controller = CLIController(service)\n\n        # Handle --history flag display\n        if args.history:\n            try:\n                history = repo.get_history()\n                print(\"--- Historical Counts ---\")\n                if not history:\n                    print(\"No history found.\")\n                else:\n                    for item in history:\n                        print(f\"[{item.timestamp.isoformat()[:-7]}] '{item.input_str}' -> {item.distinct_count} distinct chars.\")\n                print(\"-----------------------\")\n                if not input_str: # If only history was requested, and no input string, exit success\n                    return 0\n            except DistinctCharsError as e:\n                print(f\"Error fetching history: {e}\", file=sys.stderr)\n                return 3 # Persistence error\n\n        if input_str is None: # If no input string after checking stdin and no --history was the sole action\n            parser.print_help(sys.stderr)\n            return 2 # Indicate missing input\n\n        return controller.run(input_str, show_chars=args.show_chars)\n\n\n# src/distinct_chars/__init__.py\n\"\"\"\nA library and CLI to compute the number of distinct characters in a string, case-insensitively.\nThis package provides a modular and testable solution, including optional persistence.\n\"\"\"\n\nfrom .models import CountResult\nfrom .utils import Normalizer\nfrom .repositories import IRepository, InMemoryRepository, FileRepository\nfrom .services import CharacterCounterService\nfrom .exceptions import DistinctCharsError, ValidationError, FileRepositoryError\n\n# Expose the core functionality as a top-level function for direct use.\ndef count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    # This wrapper uses the CharacterCounterService with a default in-memory repository.\n    service = CharacterCounterService(repo=InMemoryRepository())\n    return service.count_distinct_int(string)\n\n# Expose other key components for library users\n__all__ = [\n    \"CountResult\",\n    \"Normalizer\",\n    \"IRepository\",\n    \"InMemoryRepository\",\n    \"FileRepository\",\n    \"CharacterCounterService\",\n    \"DistinctCharsError\",\n    \"ValidationError\",\n    \"FileRepositoryError\",\n    \"count_distinct_characters\", # The top-level function as specified\n]\n```"}
