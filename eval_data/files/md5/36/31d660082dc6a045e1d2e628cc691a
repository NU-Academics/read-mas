UniqueService\nfrom .repository import UniqueRepository\nfrom .controller import UniqueController\nfrom .models import UniqueRequest\nfrom .config import Config\n\n# Initialize a default service and controller for the top-level unique function.\n# This allows the library API to be used without explicit instantiation of components.\n_default_config = Config()\n_default_repository = UniqueRepository(path=_default_config.cache_path) if _default_config.cache_enabled else None\n_default_service = UniqueService(repository=_default_repository)\n_default_controller = UniqueController(_default_service)\n\ndef unique(items: Iterable[Any], key: Optional[Callable[[Any], Any]] = None, reverse: bool = False, preserve_order: bool = False, use_cache: bool = False) -> List[Any]:\n    \"\"\"\n    Returns sorted unique elements from an iterable, with configurable options.\n    Wraps the core UniqueService functionality for public API access.\n    \"\"\"\n    req = UniqueRequest(items=items, key=key, reverse=reverse, preserve_order=preserve_order, use_cache=use_cache)\n    return _default_controller.handle(req).items\n```\n\n### `src/unique_util/config.py`\n```python\nimport os\nfrom typing import Optional\n\nclass Config:\n    \"\"\"Configuration values for the unique_util library.\"\"\"\n    DEFAULT_CACHE_DIR = os.path.expanduser(\"~/.cache/unique_util\")\n    DEFAULT_CACHE_PATH = os.path.join(DEFAULT_CACHE_DIR, \"cache.json\")\n\n    def __init__(self, cache_path: Optional[str] = None, cache_enabled: bool = False):\n        \"\"\"Initializes configuration with cache path and enabled status.\"\"\"\n        self.cache_path: Optional[str] = cache_path if cache_path is not None else self.DEFAULT_CACHE_PATH\n        self.cache_enabled: bool = cache_enabled\n\n# Constants for module-level use, matching the specification.\nDEFAULT_CACHE_PATH: str = Config.DEFAULT_CACHE_PATH\n```\n\n### `src/unique_util/models.py`\n```python\nfrom typing import Iterable, Any, Callable, Optional, List\nfrom dataclasses import dataclass, field\n\n@dataclass\nclass UniqueRequest:\n    \"\"\"DTO for incoming unique computation requests.\"\"\"\n    items: Iterable[Any]\n    key: Optional[Callable[[Any], Any]] = None\n    reverse: bool = False\n    preserve_order: bool = False\n    use_cache: bool = False\n\n@dataclass\nclass UniqueResult:\n    \"\"\"DTO for unique computation results, possibly with metadata.\"\"\"\n    items: List[Any]\n    metadata: Optional[dict] = field(default_factory=dict)\n```\n\n### `src/unique_util/utils.py`\n```python\nimport hashlib\nimport json\nfrom typing import Iterable, Any, Optional\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to the utility functions.\"\"\"\n    pass\n\ndef ensure_iterable(obj: Any) -> Iterable[Any]:\n    \"\"\"Ensures that the given object is iterable; raises InvalidInputError otherwise.\"\"\"\n    try:\n        iter(obj)\n        return obj\n    except TypeError:\n        raise InvalidInputError(\"Provided object is not iterable.\")\n\ndef safe_serialize(obj: Any) -> Any:\n    \"\"\"Attempts to serialize an object to JSON-compatible format; falls back to repr().\"\"\"\n    try:\n        json.dumps(obj)\n        return obj\n    except TypeError:\n        return repr(obj)\n\ndef compute_input_hash(items: Iterable[Any], options: dict) -> str:\n    \"\"\"Computes a SHA256 hash of the input items and options for caching purposes.\"\"\"\n    serialized_items = [safe_serialize(item) for item in items]\n    serialized_options = {k: safe_serialize(v) for k, v in options.items()}\n    \n    payload = {\"items\": serialized_items, \"options\": serialized_options}\n    s = json.dumps(payload, sort_keys=True, separators=(',', ':'))\n    return hashlib.sha256(s.encode('utf-8')).hexdigest()\n```\n\n### `src/unique_util/algorithms.py`\n```python\nfrom abc import ABC, abstractmethod\nfrom typing import Iterable, List, Callable, Optional, Any\n\nclass UniqueAlgorithm(ABC):\n    \"\"\"Abstract base class for deduplication strategies.\"\"\"\n    @abstractmethod\n    def deduplicate(self, items: Iterable[Any]) -> List[Any]:\n        \"\"\"Deduplicates the given iterable of items.\"\"\"\n        pass\n\nclass HashSetAlgorithm(UniqueAlgorithm):\n    \"\"\"Deduplication strategy using a hash set, typically O(N) but doesn't preserve order.\"\"\"\n    def deduplicate(self, items: Iterable[Any]) -> List[Any]:\n        \"\"\"\n        Deduplicates items using a set for O(N) performance.\n        Raises TypeError for unhashable elements.\n        \"\"\"\n        seen = set()\n        out = []\n        for x in items:\n            if x not in seen:\n                seen.add(x)\n                out.append(x)\n        return out\n\nclass OrderPreservingAlgorithm(UniqueAlgorithm):\n    \"\"\"Deduplication strategy that preserves the first-occurrence order of elements.\"\"\"\n    def deduplicate(self, items: Iterable[Any]) -> List[Any]:\n        \"\"\"\n        Deduplicates items while preserving their original order.\n        Handles unhashable elements by falling back to list containment check.\n        \"\"\"\n        seen_hashables = set()\n        out = []\n        for x in items:\n            try:\n                if x not in seen_hashables:\n                    seen_hashables.add(x)\n                    out.append(x)\n            except TypeError:\n                # Fallback for unhashable elements (e.g., dicts). O(N) lookup.\n                if x not in out: # This `in` check is O(N) but handles unhashable types.\n                    out.append(x)\n        return out\n\nclass SortingAlgorithm:\n    \"\"\"Algorithm for sorting a list of items with an optional key and reverse flag.\"\"\"\n    def sort(self, items: Iterable[Any], key: Optional[Callable[[Any], Any]]=None, reverse: bool=False) -> List[Any]:\n        \"\"\"Sorts the given items using Python's built-in sorted function.\"\"\"\n        return sorted(items, key=key, reverse=reverse)\n```\n\n### `src/unique_util/repository.py`\n```python\nimport os\nimport json\nimport logging\nimport fcntl # POSIX-specific file locking\nfrom typing import Optional, Dict, Any\nfrom datetime import datetime\n\nlogger = logging.getLogger(__name__)\n\nclass UniqueRepository:\n    \"\"\"Manages persistence and retrieval of cached unique computation results.\"\"\"\n\n    DEFAULT_CACHE_FILENAME: str = \"cache.json\" # Defined by spec, but the path parameter often includes it.\n    CACHE_FILE_PERMISSIONS: int = 0o644 # Read/write for owner, read for group/others.\n\n    def __init__(self, path: str):\n        \"\"\"Initializes the repository with the path to the cache file.\"\"\"\n        self.path: str = os.path.expanduser(path)\n        self._ensure_cache_dir_exists()\n\n    def _ensure_cache_dir_exists(self) -> None:\n        \"\"\"Ensures the directory for the cache file exists.\"\"\"\n        cache_dir = os.path.dirname(self.path)\n        if cache_dir and not os.path.exists(cache_dir):\n            try:\n                os.makedirs(cache_dir, exist_ok=True)\n            except OSError as e:\n                logger.error(f\"Failed to create cache directory {cache_dir}: {e}\")\n\n    def get(self, key: str) -> Optional[Dict[str, Any]]:\n        \"\"\"Retrieves a cached result by its key (hash) from the JSON file.\"\"\"\n        if not os.path.exists(self.path):\n            return None\n        try:\n            with open(self.path, 'r') as f:\n                fcntl.flock(f, fcntl.LOCK_SH) # Acquire shared lock for reading.\n                data = json.load(f)\n            return data.get(key)\n        except (IOError, json.JSONDecodeError) as e:\n            logger.warning(f\"Error reading cache file {self.path}: {e}\")\n            return None\n        except Exception as e:\n            logger.error(f\"Unexpected error in get from cache: {e}\")\n            return None\n\n    def set(self, key: str, value: Dict[str, Any]) -> None:\n        \"\"\"\n        Stores a computation result in the cache under the given key.\n        Uses atomic write to prevent corruption.\n        \"\"\"\n        data = {}\n        if os.path.exists(self.path):\n            try:\n                with open(self.path, 'r') as f:\n                    fcntl.flock(f, fcntl.LOCK_SH) # Acquire shared lock to read existing data.\n                    data = json.load(f)\n            except (IOError, json.JSONDecodeError) as e:\n                logger.warning(f\"Could not load existing cache data for update, starting fresh: {e}\")\n\n        data[key] = {\n            \"items\": value.get(\"items\"),\n            \"options\": value.get(\"options\"),\n            \"timestamp\": datetime.utcnow().isoformat() + \"Z\"\n        }\n        self._atomic_write(self.path, data)\n\n    def _atomic_write(self, path: str, data: Any) -> None:\n        \"\"\"Writes data to a file atomically using a temporary file and os.replace.\"\"\"\n        temp_path = path + \".tmp\"\n        try:\n            with open(temp_path, 'w') as f:\n                fcntl.flock(f, fcntl.LOCK_EX) # Acquire exclusive lock for writing to temp file.\n                json.dump(data, f, indent=2)\n            os.replace(temp_path, path) # Atomically replace old file with new one.\n            os.chmod(path, self.CACHE_FILE_PERMISSIONS) # Ensure correct permissions.\n        except IOError as e:\n            logger.error(f\"Failed atomic write to cache file {path}: {e}\")\n            if os.path.exists(temp_path):\n                os.remove(temp_path)\n        except Exception as e:\n            logger.error(f\"Unexpected error during atomic write to cache: {e}\")\n            if os.path.exists(temp_path):\n                os.remove(temp_path)\n```\n\n### `src/unique_util/service.py`\n```python\nimport logging\nfrom typing import Iterable, Any, Callable, Optional, List\nfrom .algorithms import HashSetAlgorithm, OrderPreservingAlgorithm, SortingAlgorithm\nfrom .repository import UniqueRepository\nfrom .utils import ensure_iterable, compute_input_hash, InvalidInputError\n\nlogger = logging.getLogger(__name__)\n\nclass UniqueService:\n    \"\"\"\n    Core service coordinating deduplication, sorting, validation, and caching.\n    It orchestrates the use of different algorithms based on request parameters.\n    \"\"\"\n    def __init__(self, repository: Optional[UniqueRepository]=None):\n        \"\"\"Initializes the service with an optional repository for caching.\"\"\"\n        self.repository = repository\n        self.sorter = SortingAlgorithm()\n        self.hash_algo = compute_input_hash\n\n    def compute(self, items: Iterable[Any], key: Optional[Callable[[Any], Any]]=None, reverse: bool=False, preserve_order: bool=False, use_cache: bool=False) -> List[Any]:\n        \"\"\"\n        Computes unique elements based on the provided options, optionally using a cache.\n        Handles input validation, algorithm selection, and result management.\n        \"\"\"\n        items_list: List[Any] = list(ensure_iterable(items))\n        \n        if preserve_order and (key is not None or reverse is True):\n            raise ValueError(\"Cannot use 'key' or 'reverse' options when 'preserve_order' is True.\")\n\n        options_for_hash = {\n            \"key\": repr(key) if key else None, # Represent callable keys for consistent hashing.\n            \"reverse\": reverse,\n            \"preserve_order\": preserve_order\n        }\n        \n        cache_key: Optional[str] = None\n        if use_cache and self.repository:\n            cache_key = self.hash_algo(items_list, options_for_hash)\n            cached_result = self.repository.get(cache_key)\n            if cached_result:\n                logger.info(f\"Cache hit for key: {cache_key}\")\n                return cached_result[\"items\"]\n            logger.info(f\"Cache miss for key: {cache_key}\")\n\n        deduped: List[Any]\n        if preserve_order:\n            dedup_algo: OrderPreservingAlgorithm = OrderPreservingAlgorithm()\n            deduped = dedup_algo.deduplicate(items_list)\n        else:\n            try:\n                dedup_algo_hash: HashSetAlgorithm = HashSetAlgorithm()\n                deduped = dedup_algo_hash.deduplicate(items_list)\n            except TypeError as e:\n                logger.warning(f\"HashSetAlgorithm failed due to unhashable type, falling back to OrderPreservingAlgorithm: {e}\")\n                dedup_algo_order: OrderPreservingAlgorithm = OrderPreservingAlgorithm()\n                deduped = dedup_algo_order.deduplicate(items_list)\n            \n            try:\n                deduped = self.sorter.sort(deduped, key=key, reverse=reverse)\n            except TypeError as e:\n                raise TypeError(f\"Elements are not comparable for sorting. Consider providing a 'key' function: {e}\")\n\n        result: List[Any] = list(deduped)\n\n        if use_cache and self.repository and cache_key:\n            try:\n                self.repository.set(cache_key, {\"items\": result, \"options\": options_for_hash})\n                logger.info(f\"Result stored in cache for key: {cache_key}\")\n            except Exception as e:\n                logger.error(f\"Failed to store result in cache for key {cache_key}: {e}\")\n\n        return result\n```\n\n### `src/unique_util/controller.py`\n```python\nimport time\nfrom typing import Any\nfrom .service import UniqueService\nfrom .models import UniqueRequest, UniqueResult\nfrom .utils import InvalidInputError\n\nclass UniqueController:\n    \"\"\"\n    High-level controller responsible for handling UniqueRequest objects.\n    It orchestrates the UniqueService and wraps results in UniqueResult DTOs.\n    \"\"\"\n    def __init__(self, service: UniqueService):\n        \"\"\"Initializes the controller with a UniqueService instance.\"\"\"\n        self.service = service\n\n    def handle(self, request: UniqueRequest) -> UniqueResult:\n        \"\"\"\n        Processes a UniqueRequest, calls the service, and returns a UniqueResult.\n        Includes error handling and basic performance metadata.\n        \"\"\"\n        start_time = time.perf_counter()\n        \n        try:\n            items_result = self.service.compute(\n                items=request.items,\n                key=request.key,\n                reverse=request.reverse,\n                preserve_order=request.preserve_order,\n                use_cache=request.use_cache\n            )\n            \n            end_time = time.perf_counter()\n            duration_ms = round((end_time - start_time) * 1000, 2)\n            metadata = {\"duration_ms\": duration_ms} # Add cache_hit if service starts returning it.\n            \n            return UniqueResult(items=items_result, metadata=metadata)\n        except (InvalidInputError, ValueError, TypeError) as e:\n            # Re-raise specific exceptions for upstream handling (CLI/API mapping to errors).\n            raise e\n        except Exception as e:\n            # Catch any other unexpected errors and wrap them.\n            raise RuntimeError(f\"An unexpected error occurred during unique computation: {e}\") from e\n```\n\n### `src/unique_util/cli.py`\n```python\nimport click\nimport json\nimport sys\nimport logging\nimport os\nfrom typing import Optional, List, Any\nfrom .controller import UniqueController\nfrom .service import UniqueService\nfrom .repository import UniqueRepository\nfrom .config import Config\nfrom .models import UniqueRequest\nfrom .utils import InvalidInputError\n\n# Configure basic logging for CLI to stderr.\nlogging.basicConfig(level=os.environ.get(\"UNIQUE_UTIL_LOGLEVEL\", \"INFO\").upper(),\n                    format='%(asctime)s - %(levelname)s - %(message)s',\n                    stream=sys.stderr)\nlogger = logging.getLogger(__name__)\n\ndef _get_configured_components() -> UniqueController:\n    \"\"\"Helper to initialize service and controller with configured cache.\"\"\"\n    cfg = Config(\n        cache_enabled=os.environ.get(\"UNIQUE_UTIL_CACHE_ENABLED\", \"false\").lower() == \"true\",\n        cache_path=os.environ.get(\"UNIQUE_UTIL_CACHE_PATH\")\n    )\n    repo = UniqueRepository(path=cfg.cache_path) if cfg.cache_enabled else None\n    svc = UniqueService(repository=repo)\n    ctrl = UniqueController(svc)\n    return ctrl\n\ndef _parse_input(input_str: str) -> List[Any]:\n    \"\"\"Parses a JSON string into a Python list.\"\"\"\n    try:\n        return json.loads(input_str)\n    except json.JSONDecodeError as e:\n        raise InvalidInputError(f\"Invalid JSON input: {e}\")\n\n@click.command()\n@click.option(\"--preserve-order\", is_flag=True, default=False, help=\"Deduplicate preserving first-occurrence order (ignores sorting options).\")\n@click.option(\"--reverse\", is_flag=True, default=False, help=\"Sort in descending order.\")\n@click.option(\"--use-cache\", is_flag=True, default=False, help=\"Enable caching of computation results.\")\n@click.argument(\"input_data\", required=False, type=click.Path(exists=True, dir_okay=False, readable=True))\ndef main_cli(preserve_order: bool, reverse: bool, use_cache: bool, input_data: Optional[str]):\n    \"\"\"\n    A CLI utility to get sorted unique elements from a JSON array.\n    Input can be provided as a JSON string via stdin or by specifying a file path.\n    \"\"\"\n    text: str\n    if input_data:\n        try:\n            with open(input_data, 'r') as f:\n                text = f.read()\n        except IOError as e:\n            logger.error(f\"Error reading input file {input_data}: {e}\")\n            sys.exit(2)\n    else:\n        text = click.get_text_stream(\"stdin\").read()\n        if not text.strip():\n            logger.error(\"No input provided. Please pipe a JSON array or specify a file.\")\n            sys.exit(2)\n\n    try:\n        items = _parse_input(text)\n        \n        ctrl = _get_configured_components()\n        \n        # CLI does not support passing a callable 'key' function directly.\n        request = UniqueRequest(\n            items=items,\n            key=None, # CLI does not support executable key functions.\n            reverse=reverse,\n            preserve_order=preserve_order,\n            use_cache=use_cache\n        )\n        \n        result = ctrl.handle(request)\n        click.echo(json.dumps(result.items, indent=2))\n        sys.exit(0)\n    except InvalidInputError as e:\n        logger.error(f\"Input error: {e}\")\n        sys.exit(2)\n    except (ValueError, TypeError) as e:\n        logger.error(f\"Processing error: {e}\")\n        sys.exit(1)\n    except Exception as e:\n        logger.exception(\"An unexpected error occurred.\")\n        sys.exit(1)\n\ndef main(argv: Optional[List[str]]=None) -> int:\n    \"\"\"Wrapper for click command, providing argument list for testing.\"\"\"\n    if argv:\n        try:\n            main_cli.main(args=argv, standalone_mode=False)\n            return click.Context.exit_code if click.Context.exit_code is not None else 0\n        except SystemExit as e:\n            return e.code\n    else:\n        main_cli() # Let click handle parsing sys.argv and exit.\n        return 0 # Should be unreachable if click exits.\n```\n\n### `src/unique_util/api.py`\n```python\nimport sys\nimport os\nimport logging\nfrom typing import Optional\n\n# This file is optional and requires Flask.\ntry:\n    from flask import Flask, request, jsonify\nexcept ImportError:\n    Flask = None # type: ignore\n    request = None # type: ignore\n    jsonify = None # type: ignore\n    print(\"Warning: Flask not found. The API functionality will be unavailable.\", file=sys.stderr)\n\nfrom .controller import UniqueController\nfrom .service import UniqueService\nfrom .repository import UniqueRepository\nfrom .config import Config\nfrom .models import UniqueRequest\nfrom .utils import InvalidInputError\n\nlogger = logging.getLogger(__name__)\n\ndef create_app(repository: Optional[UniqueRepository] = None) -> Flask:\n    \"\"\"\n    Creates and configures a Flask application for the unique utility API.\n    Exposes a POST /unique endpoint.\n    \"\"\"\n    if Flask is None:\n        raise RuntimeError(\"Flask is not installed. Cannot create API app.\")\n\n    app = Flask(__name__)\n    \n    # Initialize service and controller, repository from config if not provided.\n    if repository is None:\n        cfg = Config(\n            cache_enabled=os.environ.get(\"UNIQUE_UTIL_CACHE_ENABLED\", \"false\").lower() == \"true\",\n            cache_path=os.environ.get(\"UNIQUE_UTIL_CACHE_PATH\")\n        )\n        repository = UniqueRepository(path=cfg.cache_path) if cfg.cache_enabled else None\n\n    service = UniqueService(repository=repository)\n    controller = UniqueController(service)\n\n    @app.route(\"/unique\", methods=[\"POST\"])\n    def unique_endpoint():\n        \"\"\"\n        Handles POST requests to /unique for deduplicating and sorting lists.\n        Accepts JSON input and returns JSON output.\n        \"\"\"\n        if not request.is_json:\n            return jsonify({\"error\": \"Request must be JSON\"}), 400\n\n        data = request.get_json()\n        if data is None:\n            return jsonify({\"error\": \"Invalid JSON body\"}), 400\n\n        items = data.get(\"items\")\n        if not isinstance(items, list):\n            return jsonify({\"error\": \"'items' field must be a list\"}), 400\n\n        # API does not support executable 'key' functions directly from JSON for security.\n        key_callable = None # Always None for API requests.\n        \n        reverse = data.get(\"reverse\", False)\n        preserve_order = data.get(\"preserve_order\", False)\n        use_cache = data.get(\"use_cache\", False)\n\n        try:\n            unique_request = UniqueRequest(\n                items=items,\n                key=key_callable,\n                reverse=reverse,\n                preserve_order=preserve_order,\n                use_cache=use_cache\n            )\n            result_dto = controller.handle(unique_request)\n            return jsonify({\"items\": result_dto.items, \"metadata\": result_dto.metadata}), 200\n        except (InvalidInputError, ValueError, TypeError) as e:\n            logger.error(f\"API processing error: {e}\")\n            return jsonify({\"error\": str(e)}), 400\n        except Exception as e:\n            logger.exception(\"An unexpected error occurred in unique API endpoint.\")\n            return jsonify({\"error\": \"Internal server error\"}), 500\n\n    return app\n\nif __name__ == \"__main__\":\n    # Example usage for local development:\n    # `python -m src.unique_util.api`\n    # You can then test with curl:\n    # `curl -X POST -H \"Content-Type: application/json\" -d '{\"items\":[5,3,5,2]}' http://127.0.0.1:5000/unique`\n    app = create_app()\n    app.run(debug=True)\n```\n\n### `docs/examples.md`\n```markdown\n# Examples for Unique Utility\n\nThis document provides examples for using the `unique_util` library and CLI.\n\n## Library Usage\n\n### Basic Deduplication and Sorting\n\n```python\nfrom unique_util import unique\n\ndata = [5, 3, 5, 2, 3, 3, 9, 0, 123, -1]\nresult = unique(data)\nprint(f\"Basic unique sorted: {result}\")\n# Expected output: Basic unique sorted: [-1, 0, 2, 3, 5, 9, 123]\n```\n\n### Preserving Input Order\n\n```python\nfrom unique_util import unique\n\ndata = [5, 3, 5, 2, 3, 3, 9, 0, 123]\nresult = unique(data, preserve_order=True)\nprint(f\"Unique preserving order: {result}\")\n# Expected output: Unique preserving order: [5, 3, 2, 9, 0, 123]\n```\n\n### Reverse Sorting with Custom Key\n\n```python\nfrom unique_util import unique\n\ndata = [{'id': 3, 'name': 'Charlie'}, {'id': 1, 'name': 'Alice'}, {'id': 3, 'name': 'Charlie'}, {'id': 2, 'name': 'Bob'}]\nresult = unique(data, key=lambda x: x['id'], reverse=True)\nprint(f\"Unique with custom key (reverse): {result}\")\n# Expected output: Unique with custom key (reverse): [{'id': 3, 'name': 'Charlie'}, {'id': 2, 'name': 'Bob'}, {'id'