print(same_chars('abc', 'cba'))                      # Expected: True\nprint(same_chars('hello', 'world'))                  # Expected: False\nprint(same_chars(' ', ' '))                          # Expected: True\nprint(same_chars('  ', ' '))                         # Expected: True (set({' '}) == set({' '}))\nprint(same_chars('a b', 'ba'))                       # Expected: True (set({'a', 'b', ' '}) == set({'a', 'b'}))\n\n# Invalid input\ntry:\n    same_chars(123, \"abc\")\nexcept InvalidInputError as e:\n    print(f\"Error: {e.message}\") # Expected: \"s0 must be str, got int\"\n```\n\n### As a Command-Line Interface (CLI)\n\nThe `samechars` command can compare two inline strings or the contents of two files.\n\n**Compare inline strings:**\n```bash\nsamechars \"hello world\" \"world hello\"\n# Output: True\n\nsamechars \"apple\" \"aple\"\n# Output: True\n\nsamechars \"apple\" \"banana\"\n# Output: False\n```\n\n**Compare file contents:**\nFirst, create some test files:\n```bash\necho \"characters\" > left.txt\necho \"care sheet\" > right.txt\necho \"race\" > file1.txt\necho \"care\" > file2.txt\n```\n\nThen, use the `samechars` command with file flags:\n```bash\nsamechars --file-left left.txt --file-right right.txt\n# Output: False (characters: c,h,a,r,t,e,s | care sheet: c,a,r,e,s,h,t)\n\nsamechars --file-left file1.txt --file-right file2.txt\n# Output: True (both have c,a,r,e)\n```\n\n**Error Handling:**\n```bash\nsamechars \"one\"\n# Output: Input error: Invalid arguments. Provide two strings (positional) or --file-left and --file-right paths.\n\nsamechars --file-left nonexistent.txt --file-right file2.txt\n# Output: Input error: File not found: nonexistent.txt\n```\n\n## Development\n\n### Running Tests\n\nEnsure `pytest` is installed (`pip install pytest`).\nNavigate to the project root and run:\n```bash\npytest\n```\n\n### Project Structure\n\n```\n\u251c\u2500\u2500 pyproject.toml\n\u251c\u2500\u2500 README.md\n\u251c\u2500\u2500 src/\n\u2502   \u2514\u2500\u2500 samechars_pkg/\n\u2502       \u251c\u2500\u2500 __init__.py\n\u2502       \u251c\u2500\u2500 services.py\n\u2502       \u251c\u2500\u2500 cli.py\n\u2502       \u251c\u2500\u2500 args_parser.py\n\u2502       \u251c\u2500\u2500 adapters.py\n\u2502       \u251c\u2500\u2500 schemas.py\n\u2502       \u2514\u2500\u2500 exceptions.py\n\u251c\u2500\u2500 tests/\n\u2502   \u251c\u2500\u2500 test_services.py\n\u2502   \u2514\u2500\u2500 test_cli.py\n\u2514\u2500\u2500 .gitignore\n```\n\"\"\"\n\n# .gitignore\n# This file specifies intentionally untracked files to ignore.\n# It should be placed at the root of the project.\n\nGITIGNORE_CONTENT = \"\"\"\n# Python\n__pycache__/\n*.pyc\n*.pyo\n*.pyd\n.Python\nenv/\nvenv/\n*.egg-info/\n.pytest_cache/\n.coverage\nhtmlcov/\ndist/\nbuild/\n\n# IDEs\n.idea/\n.vscode/\n\n# OS\n.DS_Store\n\"\"\"\n\n# src/samechars_pkg/exceptions.py\nimport sys\nimport argparse\nimport os\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n# src/samechars_pkg/schemas.py\n\nclass SameCharsRequestDTO:\n    \"\"\"Data Transfer Object for SameCharsService request.\"\"\"\n    def __init__(self, left: str, right: str, left_is_file: bool = False, right_is_file: bool = False) -> None:\n        self.left = left\n        self.right = right\n        self.left_is_file = left_is_file\n        self.right_is_file = right_is_file\n\nclass SameCharsResponseDTO:\n    \"\"\"Data Transfer Object for SameCharsService response.\"\"\"\n    def __init__(self, result: bool) -> None:\n        self.result = result\n\n# src/samechars_pkg/services.py\n\nclass SameCharsService:\n    \"\"\"Core logic for comparing character sets of two strings.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate_input(self, value: object, name: str) -> None:\n        \"\"\"Validates that the input is a string.\"\"\"\n        if not isinstance(value, str):\n            raise InvalidInputError(f\"{name} must be str, got {type(value).__name__}\")\n\n    def _to_char_set(self, s: str) -> set[str]:\n        \"\"\"Converts a string to a set of its unique characters.\"\"\"\n        return set(s)\n\n    def same_characters(self, s0: str, s1: str) -> bool:\n        \"\"\"Compares two strings to see if they contain the same character set.\"\"\"\n        self.validate_input(s0, \"s0\")\n        self.validate_input(s1, \"s1\")\n        return self._to_char_set(s0) == self._to_char_set(s1)\n\n# src/samechars_pkg/adapters.py\n\nclass FileAdapter:\n    \"\"\"Adapter for reading text content from files.\"\"\"\n    def read_text(self, path: str, encoding: str = \"utf-8\") -> str:\n        \"\"\"Reads the entire content of a text file.\"\"\"\n        try:\n            with open(path, \"r\", encoding=encoding) as fh:\n                return fh.read()\n        except FileNotFoundError as e:\n            raise InvalidInputError(f\"File not found: {path}\") from e\n        except OSError as e:\n            raise InvalidInputError(f\"Cannot read file {path}: {e}\") from e\n\n# src/samechars_pkg/args_parser.py\n\nDEFAULT_ENCODING = \"utf-8\"\n\nclass ArgsParser:\n    \"\"\"Parses command-line arguments into a SameCharsRequestDTO.\"\"\"\n    def __init__(self, encoding: str = DEFAULT_ENCODING) -> None:\n        self.encoding = encoding\n\n    def parse(self, argv: list[str]) -> SameCharsRequestDTO:\n        \"\"\"Parses arguments, prioritizing file flags over positional arguments.\"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Compare if two strings or file contents have the same set of characters.\"\n        )\n        parser.add_argument(\n            \"positional_s0\", nargs=\"?\", help=\"First string to compare.\"\n        )\n        parser.add_argument(\n            \"positional_s1\", nargs=\"?\", help=\"Second string to compare.\"\n        )\n        parser.add_argument(\n            \"--file-left\", dest=\"file_left\", help=\"Path to the file for the left string.\"\n        )\n        parser.add_argument(\n            \"--file-right\", dest=\"file_right\", help=\"Path to the file for the right string.\"\n        )\n\n        args = parser.parse_args(argv)\n\n        left_val: str\n        right_val: str\n        left_is_file: bool = False\n        right_is_file: bool = False\n\n        if args.file_left and args.file_right:\n            left_val = args.file_left\n            right_val = args.file_right\n            left_is_file = True\n            right_is_file = True\n        elif args.positional_s0 is not None and args.positional_s1 is not None:\n            left_val = args.positional_s0\n            right_val = args.positional_s1\n            left_is_file = False\n            right_is_file = False\n        else:\n            raise InvalidInputError(\n                \"Invalid arguments. Provide two strings (positional) or \"\n                \"--file-left and --file-right paths.\"\n            )\n\n        return SameCharsRequestDTO(\n            left=left_val,\n            right=right_val,\n            left_is_file=left_is_file,\n            right_is_file=right_is_file\n        )\n\n# src/samechars_pkg/cli.py\n\nclass CLIController:\n    \"\"\"Orchestrates CLI operations, parsing args, reading files, and calling the service.\"\"\"\n    def __init__(self, args_parser: ArgsParser, file_adapter: FileAdapter, service: SameCharsService) -> None:\n        self.args_parser = args_parser\n        self.file_adapter = file_adapter\n        self.service = service\n\n    def _print_result(self, result: bool) -> None:\n        \"\"\"Prints the boolean result to standard output.\"\"\"\n        print(\"True\" if result else \"False\")\n\n    def run(self, argv: list[str]) -> int:\n        \"\"\"Main entry point for the CLI, handling argument parsing and execution.\"\"\"\n        try:\n            req = self.args_parser.parse(argv)\n\n         