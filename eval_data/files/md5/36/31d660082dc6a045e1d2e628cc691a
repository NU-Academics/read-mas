{"task_id": "HumanEval/81", "solution": "```python\ndef numerical_letter_grade(grades):\n    \"\"\"Calculates letter grades for a list of GPA values based on a predefined scale.\n    This function processes each GPA according to exact matches and strict thresholds.\n    \"\"\"\n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append('A+')\n        elif gpa > 3.7:\n            letter_grades.append('A')\n        elif gpa > 3.3:\n            letter_grades.append('A-')\n        elif gpa > 3.0:\n            letter_grades.append('B+')\n        elif gpa > 2.7:\n            letter_grades.append('B')\n        elif gpa > 2.3:\n            letter_grades.append('B-')\n        elif gpa > 2.0:\n            letter_grades.append('C+')\n        elif gpa > 1.7:\n            letter_grades.append('C')\n        elif gpa > 1.3:\n            letter_grades.append('C-')\n        elif gpa > 1.0:\n            letter_grades.append('D+')\n        elif gpa > 0.7:\n            letter_grades.append('D')\n        elif gpa > 0.0:\n            letter_grades.append('D-')\n        elif gpa == 0.0:\n            letter_grades.append('E')\n    return letter_grades\n```"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Maps a list of GPAs to letter grades based on a predefined table.\n    Assumes inputs are valid floats within [0.0, 4.0].\n    \"\"\"\n    result_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grade = \"A+\"\n        elif gpa > 3.7:\n            letter_grade = \"A\"\n        elif gpa > 3.3:\n            letter_grade = \"A-\"\n        elif gpa > 3.0:\n            letter_grade = \"B+\"\n        elif gpa > 2.7:\n            letter_grade = \"B\"\n        elif gpa > 2.3:\n            letter_grade = \"B-\"\n        elif gpa > 2.0:\n            letter_grade = \"C+\"\n        elif gpa > 1.7:\n            letter_grade = \"C\"\n        elif gpa > 1.3:\n            letter_grade = \"C-\"\n        elif gpa > 1.0:\n            letter_grade = \"D+\"\n        elif gpa > 0.7:\n            letter_grade = \"D\"\n        elif gpa > 0.0:\n            letter_grade = \"D-\"\n        else: # Covers gpa == 0.0, assuming valid inputs [0.0, 4.0]\n            letter_grade = \"E\"\n        result_grades.append(letter_grade)\n    return result_grades"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Checks if the length of a string is a prime number.\n    Uses an optimized trial division algorithm for primality testing.\n    \"\"\"\n    n = len(string)\n\n    if n < 2:\n        return False\n    if n == 2 or n == 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "HumanEval/82", "solution": "```python\ndef prime_length(string):\n    \"\"\"Checks if the string length is a prime number.\n    The function trusts its input and includes an in-house primality test.\"\"\"\n    n = len(string)\n\n    if n <= 1:\n        return False\n    if n == 2 or n == 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n```"}
