{"task_id": "HumanEval/136", "solution": "```python\ndef largest_smallest_integers(lst):\n    \"\"\"\n    Finds the largest negative integer and the smallest positive integer in a list.\n    If no numbers of a certain sign are found, the corresponding result is None.\n    \"\"\"\n    negatives = []\n    positives = []\n\n    for x in lst:\n        # Per critical requirements, type checks are forbidden.\n        # We assume elements are comparable numbers or operations will raise TypeError.\n        if x < 0:\n            negatives.append(x)\n        elif x > 0:\n            positives.append(x)\n\n    largest_negative = max(negatives) if negatives else None\n    smallest_positive = min(positives) if positives else None\n\n    return (largest_negative, smallest_positive)\n```"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Finds the largest negative integer and smallest positive integer in a list.\n    Returns (largest_negative, smallest_positive), or None for missing values.\n    \"\"\"\n    largest_negative = None\n    smallest_positive = None\n\n    for n in lst:\n        if n < 0:\n            if largest_negative is None or n > largest_negative:\n                largest_negative = n\n        elif n > 0:\n            if smallest_positive is None or n < smallest_positive:\n                smallest_positive = n\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/137", "solution": "import math\n\nclass InvalidNumberError(Exception):\n    \"\"\"Custom exception for invalid numeric input problems.\"\"\"\n    def __init__(self, message, value):\n        self.message = message\n        self.value = value\n        super().__init__(f\"{message}: {value}\")\n\nclass Utils:\n    \"\"\"General helpers for type checks and normalization.\"\"\"\n    DECIMAL_DOT = \".\"\n    DECIMAL_COMMA = \",\"\n\n    @staticmethod\n    def normalize_decimal_str(s):\n        \"\"\"Normalize comma decimal separators to dot, trim whitespace.\"\"\"\n        s = s.strip()\n        return s.replace(Utils.DECIMAL_COMMA, Utils.DECIMAL_DOT)\n\nclass NumericValue:\n    \"\"\"Domain model: wraps original value and its parsed numeric equivalent.\"\"\"\n    def __init__(self, original, numeric):\n        self._original = original\n        self._numeric = numeric\n        self.type_name = type(original).__name__\n\n    def original_value(self):\n        \"\"\"Returns the original input value.\"\"\"\n        return self._original\n\n    def numeric_value(self):\n        \"\"\"Returns the numeric float value for comparison.\"\"\"\n        return self._numeric\n\n    def is_string(self):\n        \"\"\"Checks if the original value was a string.\"\"\"\n        return type(self._original) is str\n\nclass NumberParser:\n    \"\"\"Parses inputs into numeric floats, handling '.' and ',' separators.\"\"\"\n    def parse(self, value):\n        \"\"\"Converts a value to its float representation.\"\"\"\n        if type(value) is int or type(value) is float:\n            return float(value)\n        if type(value) is str:\n            s = value.strip()\n            norm = Utils.normalize_decimal_str(s)\n            return float(norm)\n        return float(value) # Let float() raise TypeError for unsupported types\n\nclass ComparatorService:\n    \"\"\"Business logic for numeric comparison and tolerance handling.\"\"\"\n    def __init__(self, parser=None, rel_tol=1e-9):\n        self.parser = parser if parser is not None else NumberParser()\n        self.REL_TOL = rel_tol\n\n    def _to_numeric(self, value):\n        \"\"\"Helper to parse a value and wrap in NumericValue.\"\"\"\n        numeric = self.parser.parse(value)\n        return NumericValue(original=value, numeric=numeric)\n\n    def compare(self, a, b):\n        \"\"\"Compares two values and returns the larger, or None if equal.\"\"\"\n        na = self._to_numeric(a)\n        nb = self._to_numeric(b)\n\n        if math.isclose(na.numeric_value(), nb.numeric_value(), rel_tol=self.REL_TOL):\n            return None\n        return a if na.numeric_value() > nb.numeric_value() else b\n\nclass CompareController:\n    \"\"\"Thin API layer exposing compare_one and delegating to ComparatorService.\"\"\"\n    def __init__(self, service=None):\n        self.service = service if service is not None else ComparatorService()\n\n    def compare_one(self, a, b):\n        \"\"\"Public API: delegates comparison to service layer.\"\"\"\n        return self.service.compare(a, b)\n\n_default_controller = CompareController()\n\ndef compare_one(a, b):\n    \"\"\"Compares two number-like values.\n    Returns the larger value in its original input type or None if equal.\n    \"\"\"\n    return _default_controller.compare_one(a, b)"}
{"task_id": "HumanEval/137", "solution": "```python\nimport math\n\ndef compare_one(a, b):\n    \"\"\"\n    Compares two values (int, float, or string representations of real numbers)\n    and returns the larger value in its original variable type.\n    Returns None if the values are numerically equal.\n    \"\"\"\n\n    def _parse_and_normalize(value):\n        # Parses an input value to a float, preserving its original form.\n        # Handles int, float, and string representations with '.' or ',' decimals.\n        original_value = value\n        parsed_float = None\n\n        if isinstance(value, int):\n            parsed_float = float(value)\n        elif isinstance(value, float):\n            # Per critical requirements, any standard float values are accepted.\n            parsed_float = float(value)\n        elif isinstance(value, str):\n            s = value.strip()\n            normalized_s = s\n            # Business rule: Decimal separator can be '.' or ',' but not both.\n            if ',' in s and '.' not in s:\n                normalized_s = s.replace(',', '.')\n            \n            # Trusting caller's input implies float conversion will succeed for valid strings.\n            # Any ValueError from invalid strings will propagate per 'no exceptions' rule.\n            parsed_float = float(normalized_s)\n        # For other types, Python's built-in conversion might raise exceptions,\n        # which will propagate as per critical requirements.\n        return original_value, parsed_float\n\n    # Parse both inputs to get their original values and normalized float representations.\n    original_a, parsed_a = _parse_and_normalize(a)\n    original_b, parsed_b = _parse_and_normalize(b)\n\n    # Compare the parsed float values.\n    if parsed_a == parsed_b:\n        return None\n    elif parsed_a > parsed_b:\n        return original_a\n    else:\n        return original_b\n```"}
{"task_id": "HumanEval/138", "solution": "To implement the software design specification, I will generate the required Python files, `pyproject.toml`, and `README.md`. The `data/cache.json` file will be created at runtime by the application.\n\n```python\n# src/sum_even/config.py\n\"\"\"Configuration constants for the sum_even application.\"\"\"\nimport logging\n\nCACHE_PATH: str = \"./data/cache.json\"\nLOG_LEVEL: str = \"INFO\"\n\n# Configure basic logging\nlogging.basicConfig(level=getattr(logging, LOG_LEVEL.upper(), logging.INFO),\n                    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n```\n\n```python\n# src/sum_even/dto.py\n\"\"\"Data Transfer Objects (DTOs) for the sum_even application.\"\"\"\n\nclass SumEvenResultDTO:\n    \"\"\"A DTO to encapsulate the result of an evaluation.\"\"\"\n    def __init__(self, n: int, result: bool) -> None:\n        self.n = n\n        self.result = result\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the DTO to a dictionary for serialization.\"\"\"\n        return {\"n\": self.n, \"result\": self.result}\n```\n\n```python\n# src/sum_even/input_validator.py\n\"\"\"Input validation utilities and custom exceptions.\"\"\"\n\nfrom typing import Any\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation failures.\"\"\"\n    def __init__(self, message: str, code: int = 400) -> None:\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\nclass InputValidator:\n    \"\"\"Provides methods for validating various inputs.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate_int(self, n_raw: Any) -> int:\n        \"\"\"Validates if input can be converted to an integer.\"\"\"\n        try:\n            n = int(n_raw)\n            return n\n        except (ValueError, TypeError) as e:\n            raise ValidationError(f\"Invalid input: '{n_raw}' is not a valid integer.\") from e\n```\n\n```python\n# src/sum_even/utils.py\n\"\"\"Utility functions for the sum_even application.\"\"\"\n\nimport os\nimport json\nimport logging\nfrom typing import Any, Dict\n\nlogger = logging.getLogger(__name__)\n\nclass Utils:\n    \"\"\"Provides static helper methods for common tasks.\"\"\"\n    @staticmethod\n    def format_result(n: int, result: bool) -> str:\n        \"\"\"Formats the evaluation result into a human-readable string.\"\"\"\n        return f\"{n}: {result}\"\n\n    @staticmethod\n    def _read_json_file(file_path: str) -> Dict[str, Any]:\n        \"\"\"Reads a JSON file, returning an empty dict if not found or invalid.\"\"\"\n        if not os.path.exists(file_path):\n            return {}\n        try:\n            with open(file_path, 'r', encoding='utf-8') as f:\n                return json.load(f)\n        except json.JSONDecodeError as e:\n            logger.error(f\"Error decoding JSON from {file_path}: {e}. Initializing with empty cache.\")\n            return {}\n        except IOError as e:\n            logger.error(f\"Error reading file {file_path}: {e}. Initializing with empty cache.\")\n            return {}\n\n    @staticmethod\n    def _write_json_file_atomic(file_path: str, data: Dict[str, Any]) -> None:\n        \"\"\"Atomically writes data to a JSON file to prevent corruption.\"\"\"\n        temp_path = file_path + \".tmp\"\n        try:\n            os.makedirs(os.path.dirname(file_path), exist_ok=True)\n            with open(temp_path, 'w', encoding='utf-8') as f:\n                json.dump(data, f, indent=2)\n            os.replace(temp_path, file_path) # Atomic rename\n        except IOError as e:\n            logger.error(f\"Failed to persist cache to {file_path}: {e}\")\n            if os.path.exists(temp_path):\n                os.remove(temp_path)\n```\n\n```python\n# src/sum_even/result_repository.py\n\"\"\"Manages in-memory cache and persistence to a JSON file.\"\"\"\n\nimport logging\nfrom typing import Optional, Dict\nfrom sum_even.config import CACHE_PATH\nfrom sum_even.utils import Utils # Using Utils for file operations\n\nlogger = logging.getLogger(__name__)\n\nclass ResultRepository:\n    \"\"\"Provides caching and persistence for computed sum-even results.\"\"\"\n    DEFAULT_CACHE_PATH: str = CACHE_PATH\n\n    def __init__(self, path: str = DEFAULT_CACHE_PATH) -> None:\n        self.path: str = path\n        self.cache: Dict[int, bool] = {}\n        self._load()\n\n    def get(self, n: int) -> Optional[bool]:\n        \"\"\"Retrieves a cached result for n, or None if not found.\"\"\"\n        return self.cache.get(n)\n\n    def set(self, n: int, value: bool) -> None:\n        \"\"\"Stores a result in the cache and triggers persistence.\"\"\"\n        self.cache[n] = value\n        self._persist()\n\n    def _load(self) -> None:\n        \"\"\"Loads cached results from the JSON file into memory.\"\"\"\n        raw_cache = Utils._read_json_file(self.path)\n        self.cache = {int(k): v for k, v in raw_cache.items()}\n        logger.info(f\"Loaded {len(self.cache)} items from cache: {self.path}\")\n\n    def _persist(self) -> None:\n        \"\"\"Persists the current in-memory cache to the JSON file atomically.\"\"\"\n        serializable_cache = {str(k): v for k, v in self.cache.items()}\n        Utils._write_json_file_atomic(self.path, serializable_cache)\n```\n\n```python\n# src/sum_even/sum_even_service.py\n\"\"\"Core service for determining if an integer is a sum of four positive even numbers.\"\"\"\n\nimport logging\nfrom sum_even.result_repository import ResultRepository\n\nlogger = logging.getLogger(__name__)\n\nclass SumEvenService:\n    \"\"\"Provides the core logic for the sum-even evaluation, including caching.\"\"\"\n    MIN_POSITIVE_EVEN: int = 2\n    PARTS: int = 4\n\n    def __init__(self, repository: ResultRepository) -> None:\n        self.repository = repository\n\n    def is_equal_to_sum_even(self, n: int) -> bool:\n        \"\"\"Determines if n can be written as the sum of exactly four positive even integers.\"\"\"\n        cached_result = self.repository.get(n)\n        if cached_result is not None:\n            logger.debug(f\"Cache hit for n={n}\")\n            return cached_result\n        \n        logger.debug(f\"Cache miss for n={n}. Computing...\")\n        result = self._mathematical_check(n)\n        self.repository.set(n, result) # Persist result\n        return result\n\n    def _mathematical_check(self, n: int) -> bool:\n        \"\"\"Performs the mathematical check: n must be even and >= 8.\"\"\"\n        return n % 2 == 0 and n >= (self.MIN_POSITIVE_EVEN * self.PARTS)\n```\n\n```python\n# src/sum_even/sum_even_controller.py\n\"\"\"Orchestrates input validation, service calls, and result formatting.\"\"\"\n\nfrom typing import Any\nfrom sum_even.sum_even_service import SumEvenService\nfrom sum_even.input_validator import InputValidator\nfrom sum_even.dto import SumEvenResultDTO\n\nclass SumEvenController:\n    \"\"\"Manages the flow from raw input to processed output.\"\"\"\n    def __init__(self, service: SumEvenService, validator: InputValidator) -> None:\n        self.service = service\n        self.validator = validator\n\n    def check(self, n_raw: Any) -> SumEvenResultDTO:\n        \"\"\"Validates input, calls the service, and returns a DTO.\"\"\"\n        n = self.validator.validate_int(n_raw)\n        result = self.service.is_equal_to_sum_even(n)\n        return SumEvenResultDTO(n=n, result=result)\n```\n\n```python\n# src/sum_even/cli.py\n\"\"\"Command-line interface (CLI) for the sum_even application.\"\"\"\n\nimport sys\nimport logging\nfrom typing import List\n\nfrom sum_even.result_repository import ResultRepository\nfrom sum_even.input_validator import InputValidator, ValidationError\nfrom sum_even.sum_even_service import SumEvenService\nfrom sum_even.sum_even_controller import SumEvenController\nfrom sum_even.utils import Utils\n\nlogger = logging.getLogger(__name__)\n\nclass CLIApp:\n    \"\"\"Handles command-line argument parsing and execution.\"\"\"\n    def __init__(self, controller: SumEvenController) -> None:\n        self.controller = controller\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Parses arguments, calls the controller, and manages exit codes.\"\"\"\n        if len(argv) < 2 or argv[0] != \"check\":\n            print(\"Usage: sum-even check <integer>\", file=sys.stderr)\n            return 2 # Bad arguments\n        \n        n_raw = argv[1]\n        try:\n            result_dto = self.controller.check(n_raw)\n            print(Utils.format_result(result_dto.n, result_dto.result))\n            return 0 # Success\n        except ValidationError as e:\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return 2 # Validation error\n        except Exception as e:\n            logger.exception(\"An unexpected error occurred.\")\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1 # General error\n\n# This section acts as the CLI entrypoint when cli.py is executed directly.\nif __name__ == \"__main__\":\n    repo = ResultRepository()\n    service = SumEvenService(repository=repo)\n    controller = SumEvenController(service=service, validator=InputValidator())\n    app = CLIApp(controller=controller)\n    sys.exit(app.run(sys.argv[1:]))\n```\n\n```python\n# src/sum_even/http_api.py\n\"\"\"HTTP API adapter using FastAPI for the sum_even application.\"\"\"\n\nimport logging\nfrom fastapi import FastAPI, HTTPException, status\nfrom typing import Dict\n\nfrom sum_even.result_repository import ResultRepository\nfrom sum_even.input_validator import InputValidator, ValidationError\nfrom sum_even.sum_even_service import SumEvenService\nfrom sum_even.sum_even_controller import SumEvenController\n\nlogger = logging.getLogger(__name__)\n\nclass HttpAPIAdapter:\n    \"\"\"FastAPI adapter to expose the sum-even functionality via HTTP.\"\"\"\n    def __init__(self, controller: SumEvenController) -> None:\n        self.controller = controller\n\n    def create_app(self) -> FastAPI:\n        \"\"\"Creates and configures the FastAPI application.\"\"\"\n        app = FastAPI(\n            title=\"Sum Even API\",\n            description=\"API to determine if an integer can be written as the sum of four positive even integers.\",\n            version=\"1.0.0\"\n        )\n\n        @app.get(\"/v1/sum-even\", response_model=Dict[str, bool])\n        async def _get_sum_even(n: int) -> Dict[str, bool]:\n            \"\"\"Endpoint to check if an integer can be written as the sum of exactly four positive even integers.\"\"\"\n            try:\n                result_dto = self.controller.check(n)\n                return {\"n\": result_dto.n, \"result\": result_dto.result}\n            except ValidationError as e:\n                raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=e.message) from e\n            except Exception as e:\n                logger.exception(\"Internal server error during sum-even check for n=%s\", n)\n                raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"Internal server error\") from e\n        \n        return app\n\n# Example for running the app directly (e.g., with `uvicorn sum_even.http_api:app --reload`)\nif __name__ == \"__main__\":\n    repo = ResultRepository()\n    svc = SumEvenService(repository=repo)\n    controller = SumEvenController(service=svc, validator=InputValidator())\n    http_adapter = HttpAPIAdapter(controller=controller)\n    app = http_adapter.create_app()\n    # In a real deployment, uvicorn would be run from the command line:\n    # uvicorn sum_even.http_api:app --host 0.0.0.0 --port 8000\n    # For testing, you can use:\n    # import uvicorn\n    # uvicorn.run(app, host=\"0.0.0.0\", port=8000)\n```\n\n```python\n# src/sum_even/__init__.py\n\"\"\"Package initializer for sum_even, exposing convenience API.\"\"\"\n\nfrom sum_even.result_repository import ResultRepository\nfrom sum_even.input_validator import InputValidator, ValidationError\nfrom sum_even.sum_even_service import SumEvenService\nfrom sum_even.sum_even_controller import SumEvenController\n\ndef is_equal_to_sum_even(n: int) -> bool:\n    \"\"\"Evaluates if n can be written as the sum of exactly four positive even numbers.\"\"\"\n    repo = ResultRepository()\n    svc = SumEvenService(repository=repo)\n    controller = SumEvenController(service=svc, validator=InputValidator())\n    \n    # The programmatic API, as per FR2, expects validated int inputs or raises ValidationError.\n    # The controller's check method includes validation.\n    try:\n        result_dto = controller.check(n)\n        return result_dto.result\n    except ValidationError as e:\n        # Re-raise validation errors as per FR2.\n        raise e\n```\n\n```toml\n# pyproject.toml\n[project]\nname = \"sum-even\"\nversion = \"0.1.0\"\ndescription = \"Library and services to check if an integer is the sum of four positive even numbers.\"\nauthors = [{ name = \"AI Assistant\" }]\ndependencies = []\nrequires-python = \">=3.8\"\n\n[project.optional-dependencies]\nhttp = [\"fastapi~=0.111.0\", \"uvicorn~=0.30.0\"]\n\n[project.scripts]\nsum-even = \"sum_even.cli:CLIApp.run\" # Entry point for the CLI\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n```\n\n```markdown\n# Sum Even Application\n\nThis project provides a Python library, a command-line interface (CLI), and an HTTP API to determine whether a given integer `n` can be expressed as the sum of exactly four positive even integers.\n\n## Features\n\n-   **Core Logic**: Efficient O(1) mathematical check.\n-   **Programmatic API**: `is_equal_to_sum_even(n: int) -> bool` for use in Python code.\n-   **CLI**: `sum-even check <n>` to quickly evaluate numbers from the terminal.\n-   **HTTP API**: `GET /v1/sum-even?n=<int>` endpoint for network queries, returning JSON.\n-   **Caching**: Computed results are cached in-memory and persisted to a JSON file (`./data/cache.json`) for durability across restarts.\n\n## Installation\n\n1.  **Clone the repository**:\n    ```bash\n    git clone <repository_url>\n    cd sum-even\n    ```\n\n2.  **Create and activate a virtual environment**:\n    ```bash\n    python -m venv .venv\n    source .venv/bin/activate # On Windows: .venv\\Scripts\\activate\n    ```\n\n3.  **Install dependencies**:\n    ```bash\n    pip install -e . # Install core library\n    pip install -e \".[http]\" # Install HTTP API dependencies (FastAPI, Uvicorn)\n    ```\n\n## Usage\n\n### Programmatic API\n\n```python\nfrom sum_even import is_equal_to_sum_even\n\nprint(is_equal_to_sum_even(8))   # Output: True\nprint(is_equal_to_sum_even(6))   # Output: False\nprint(is_equal_to_sum_even(100)) # Output: True\nprint(is_equal_to_sum_even(7))   # Output: False\n```\n\n### Command-Line Interface (CLI)\n\n```bash\nsum-even check 8\n# Output: 8: True\n\nsum-even check 6\n# Output: 6: False\n\nsum-even check -2\n# Output: -2: False\n\nsum-even check abc\n# Output: Error: Invalid input: 'abc' is not a valid integer. (Exits with code 2)\n```\n\n### HTTP API\n\n1.  **Run the API server**:\n    ```bash\n    uvicorn sum_even.http_api:app --host 0.0.0.0 --port 8000 --reload\n    ```\n    The API will be available at `http://localhost:8000`.\n\n2.  **Query the endpoint**:\n    ```bash\n    # Example using curl\n    curl \"http://localhost:8000/v1/sum-even?n=8\"\n    # Output: {\"n\":8,\"result\":true}\n\n    curl \"http://localhost:8000/v1/sum-even?n=6\"\n    # Output: {\"n\":6,\"result\":false}\n\n    curl \"http://localhost:8000/v1/sum-even?n=abc\"\n    # Output: {\"detail\":\"Invalid input: 'abc' is not a valid integer.\"} (HTTP 400 Bad Request)\n    ```\n\n## Project Structure\n\n```\n.\n\u251c\u2500\u2500 src/\n\u2502   \u2514\u2500\u2500 sum_even/\n\u2502       \u251c\u2500\u2500 __init__.py         # Package initializer; exports convenience API\n\u2502       \u251c\u2500\u2500 sum_even_service.py # Core algorithm/service\n\u2502       \u251c\u2500\u2500 sum_even_controller.py # Controller for both CLI and HTTP\n\u2502       \u251c\u2500\u2500 input_validator.py  # Validation utilities and exceptions\n\u2502       \u251c\u2500\u2500 result_repository.py # Cache and persistence\n\u2502       \u251c\u2500\u2500 dto.py              # Data Transfer Objects\n\u2502       \u251c\u2500\u2500 cli.py              # CLI adapter\n\u2502       \u251c\u2500\u2500 http_api.py         # HTTP adapter (FastAPI)\n\u2502       \u251c\u2500\u2500 utils.py            # General utility functions\n\u2502       \u2514\u2500\u2500 config.py           # Configuration constants\n\u251c\u2500\u2500 data/\n\u2502   \u2514\u2500\u2500 cache.json              # Default cache file (created at runtime)\n\u251c\u2500\u2500 pyproject.toml              # Build configuration and dependencies\n\u2514\u2500\u2500 README.md\n```\n\n## Mathematical Logic\n\nAn integer `n` can be written as the sum of exactly four positive even integers if and only if:\n1.  `n` is an even number.\n2.  `n` is greater than or equal to 8 (since the smallest sum of four positive even integers is `2 + 2 + 2 + 2 = 8`).\n```"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as: n! * (n-1)! * (n-2)! * ... * 1! for n > 0.\n    This function computes it for a given positive integer n.\n    \"\"\"\n    result = 1\n    current_factorial = 1\n    for k in range(1, n + 1):\n        current_factorial *= k\n        result *= current_factorial\n    return result"}
{"task_id": "HumanEval/139", "solution": "```python\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as: n! * (n-1)! * ... * 1!.\n    It computes the product of factorials from 1! up to n!.\n    \"\"\"\n    def factorial(k):\n        \"\"\"Computes the factorial of a non-negative integer k.\"\"\"\n        res = 1\n        for i in range(2, k + 1):\n            res *= i\n        return res\n\n    special_product = 1\n    for i in range(1, n + 1):\n        current_factorial = factorial(i)\n        special_product *= current_factorial\n    return special_product\n```"}
