tart + (ord(char) - start + shift) % 26\n            encrypted_chars.append(chr(rotated_char_code))\n        elif 'A' <= char <= 'Z':\n            start = ord('A')\n            rotated_char_code = start + (ord(char) - start + shift) % 26\n            encrypted_chars.append(chr(rotated_char_code))\n        else:\n            encrypted_chars.append(char)\n            \n    return \"\".join(encrypted_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/81": [{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs into a list of letter grades based on a predefined scale.\n    It handles exact matches for A+ (4.0) and E (0.0), and uses strict greater than comparisons for other grades.\n    \"\"\"\n\n    def convert_single_gpa(gpa_value):\n        # Handle exact match for A+\n        if gpa_value == 4.0:\n            return \"A+\"\n        # Handle exact match for E\n        if gpa_value == 0.0:\n            return \"E\"\n\n        # Define the grading scale for \"GPA > threshold\" conditions.\n        # This list must be ordered by threshold in descending order.\n        grading_scale_for_gt = [\n            (3.7, \"A\"),\n            (3.3, \"A-\"),\n            (3.0, \"B+\"),\n            (2.7, \"B\"),\n            (2.3, \"B-\"),\n            (2.0, \"C+\"),\n            (1.7, \"C\"),\n            (1.3, \"C-\"),\n            (1.0, \"D+\"),\n            (0.7, \"D\"),\n            (0.0, \"D-\"), # Any GPA > 0.0 (but not 4.0) will eventually match this for D-\n        ]\n\n        # Iterate through the scale to find the first matching grade\n        for threshold, letter_grade in grading_scale_for_gt:\n            if gpa_value > threshold:\n                return letter_grade\n        \n        # This part should theoretically not be reached for valid GPAs between 0.0 and 4.0,\n        # as 0.0 is handled, and any GPA > 0.0 will match a D- or higher