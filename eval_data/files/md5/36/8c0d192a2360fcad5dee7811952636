       common_divisor = gcd(new_numerator, new_denominator)\n        return Fraction(new_numerator // common_divisor, new_denominator // common_divisor)\n\n    def is_whole_number(self, f: Fraction) -> bool:\n        \"\"\"Checks if a fraction represents a whole number.\"\"\"\n        return f.denominator == 1\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    parser = FractionParser()\n    calculator = FractionCalculator()\n\n    fraction_x = parser.parse(x)\n    fraction_n = parser.parse(n)\n\n    result_fraction = calculator.multiply(fraction_x, fraction_n)\n\n    return calculator.is_whole_number(result_fraction)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/149": [{"task_id": "HumanEval/149", "solution": "from typing import List\nclass StringFilter:\n    def filter_even_length(self, strings: List[str]) -> List[str]:\n        return [s for s in strings if len(s) % 2 == 0]\nclass StringSorter:\n    def sort_by_length_then_alpha(self, strings: List[str]) -> List[str]:\n        # Sorts by length first, then alphabetically.\n        return sorted(strings, key=lambda s: (len(s), s))\nclass StringProcessor:\n    def __init__(self):\n        self._filter = StringFilter()\n        self._sorter = StringSorter()\n\n    def process_list(self, input_list: List[str]) -> List[str]:\n        filtered_list = self._filter.filter_even_length(input_list)\n       