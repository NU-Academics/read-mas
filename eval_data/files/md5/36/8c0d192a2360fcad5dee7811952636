d": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"I think we all remember that feeling when the result of some long-awaited\n    event is finally known. The feelings and thoughts you have at that moment are\n    definitely worth noting down and comparing.\n    Your task is to determine if a person correctly guessed the results of a number of matches.\n    You are given two arrays of scores and guesses of equal length, where each index shows a match. \n    Return an array of the same length denoting how far off each guess was. If they have guessed correctly,\n    the value is 0, and if not, the value is the absolute difference between the guess and the score.\n    \"\"\"\n    if len(game) != len(guess):\n        raise ValueError(\"Input arrays must be of equal length.\")\n\n    differences = []\n    for i in range(len(game)):\n        diff = abs(game[i] - guess[i])\n        differences.append(diff)\n    return differences", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/156": [{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    roman_map = [\n        (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n        (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n        (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'), (1, 'i')\n    ]\n\n    roman_numeral = []\n    temp_num = number\n    for value, symbol in roman_map:\n        while temp_num >= value:\n            roman_numeral.append(symbol)\n            temp_num -= value\n    return \"\".join(roman_numeral)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "import math\ndef get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n\n    # Helper function to calculate combinations (n_val choose k_val).\n    def combinations(n_val, k_val):\n        if k_val < 0 or k_val > n_val:\n            return 0\n        return math.comb(n_val, k_val)\n\n    if n < 3:\n        return 0\n\n    count0 = 0 # Count of a[i] such that a[i] % 3 == 0.\n    count1 = 0 # Count of a[i] such that a[i] % 3 == 1.\n\n    # Analyze a[i] = i*i - i + 1 modulo 3:\n    # If i % 3 == 0 or i % 3 == 1, then a[i] % 3 == 1.\n    # If i % 3 == 2, then a[i] % 3 == 0.\n    for i in range(1, n + 1):\n        if i % 3 == 2:\n            count0 += 1\n        else:\n            count1 += 1\n\n    total_triples = 0\n\n    # A sum a[i] + a[j] + a[k] is a multiple of 3 if (a[i]%3 + a[j]%3 + a[k]%3) % 3 == 0.\n    # Since a[x]%3 can only be 0 or 1, the only valid combinations of remainders are (0,0,0) or (1,1,1).\n    total_triples += combinations(count0, 3) # Pick three elements with remainder 0.\n    total_triples += combinations(count1, 3) # Pick three elements with remainder 1.\n\n    return total_triples", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP-SM strength and returns a formatted string.\n    Handles ties by choosing the first encountered extension with the maximum strength.\n    \"\"\"\n\n    def calculate_strength(extension_name_str):\n        \"\"\"Calculates the strength of an extension name (CAP - SM).\"\"\"\n        cap_count = 0\n        sm_count = 0\n        for char in extension_name_str:\n            if 'A' <= char <= 'Z':\n                cap_count += 1\n            elif 'a' <= char <= 'z':\n                sm_count += 1\n        return cap_count - sm_count\n\n    strongest_ext_name = None\n    max_strength = -float('inf')\n\n    for ext_name in extensions:\n        current_strength = calculate_strength(ext_name)\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = ext_name\n        # Tie-breaking: if current_strength == max_strength,\n        # strongest_ext_name is not updated, preserving the first one encountered.\n\n    if strongest_ext_name is not None:\n        return f\"{class_name}.{strongest_ext_name}\"\n    else:\n        # If the extensions list was empty or no valid extensions were found.\n        return class_name", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Handle zero separately as abs(0) is 0, and str(0) is '0'.\n    # '0' is an even digit, and it's the only digit.\n    if num == 0:\n        return (1, 0)\n\n    # Convert to string to iterate through digits, using absolute value.\n    num_str = str(abs(num))\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    \n    return (even_count, odd_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "import math\nEPSILON = 1e-9\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right