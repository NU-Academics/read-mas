he word \"I\".\n    \"\"\"\n    boredom_count = 0\n\n    # Split the text into sentences using '.', '?', '!' as delimiters.\n    # The regex handles optional whitespace after the delimiter.\n    # It might produce empty strings if delimiters are consecutive or at the end.\n    raw_sentences = re.split(r'[.?!]\\s*', S)\n\n    sentences = []\n    for s in raw_sentences:\n        stripped_s = s.strip()\n        if stripped_s: # Keep only non-empty, non-whitespace sentences\n            sentences.append(stripped_s)\n\n    for sentence in sentences:\n        # Tokenize the sentence into words.\n        # First, remove any non-alphanumeric characters except spaces.\n        cleaned_sentence = re.sub(r'[^\\w\\s]', '', sentence)\n        \n        # Then, split by whitespace and filter out any empty strings that result\n        # from multiple spaces or just punctuation being removed.\n        words = [word for word in cleaned_sentence.split() if word]\n\n        # Check if the sentence starts with the word \"I\" (case-sensitive).\n        if words and words[0] == \"I\":\n            boredom_count += 1\n            \n    return boredom_count", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["I"]]}], "HumanEval/95": [{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    keys = list(dict.keys())\n\n    # Check if all keys are strings.\n    if not all(isinstance(key, str) for key in keys):\n        return False\n\n    # Check if all keys are lowercase.\n    all_lower = all(key == key.lower() for key in keys)\n    if all_lower:\n        return True\n\n    # Check if all keys are uppercase.\n    all_upper = all(key == key.upper() for key in keys)\