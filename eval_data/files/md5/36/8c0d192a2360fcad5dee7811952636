dates input strings of number words.\"\"\"\n\n    def parse_and_validate(self, input_string: str, number_word_map: NumberWordMap) -> List[str]:\n        \"\"\"\n        Splits the input string into words, validates them, and returns a list of valid,\n        lowercase number words. Invalid words are ignored.\n        \"\"\"\n        if not input_string:\n            return []\n        \n        words = input_string.split(' ')\n        valid_words = []\n        for word in words:\n            if word: # Filter out empty strings from multiple spaces\n                normalized_word = word.lower()\n                if number_word_map.word_to_int(normalized_word) is not None:\n                    valid_words.append(normalized_word)\n        return valid_words\nclass NumberSorterService:\n    \"\"\"Provides the core business logic for sorting number words.\"\"\"\n\n    def __init__(self, number_word_map: NumberWordMap, input_parser: InputParser):\n        self._number_word_map = number_word_map\n        self._input_parser = input_parser\n\n    def sort_number_words(self, number_words_str: str) -> str:\n        \"\"\"\n        Parses, converts, sorts, and re-converts a string of number words.\n        \"\"\"\n        # 1. Parse and validate input words\n        parsed_words: List[str] = self._input_parser.parse_and_validate(\n            number_words_str, self._number_word_map\n        )\n\n        if not parsed_words:\n            return \"\"\n\n        # 2. Convert words to integers\n        numbers: List[int] = [\n            self._number_word_map.word_to_int(word) for word in parsed_words\n            if self._number_word_map.word_to_int(word) is not None\n        ]\n\n        # 3. Sort integers\n        numbers.sort()\n\n        # 4. Convert integers back to words\n        sorted_words: List[str] = [\n            self._number_word_map.int_to_word(num) for num in numbers\n            if self._number_word_map.int_to_word(num) is not None\n        ]\n\n        # 5. Join 