    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if an integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from an array 'a'\n    whose sum is a multiple of 3, based on the remainders of a[i] values.\n    \"\"\"\n    \n    # We analyze the remainder of a[i] when divided by 3 for a[i] = i*i - i + 1.\n    # If i % 3 == 0 or i % 3 == 1, then a[i] % 3 = 1.\n    # If i % 3 == 2, then a[i] % 3 = 0.\n    # No a[i] will have a remainder of 2 when divided by 3.\n\n    # count_rem[0] stores the count of elements a[x] such that a[x] % 3 == 0\n    # count_rem[1] stores the count of elements a[x] such that a[x] % 3 == 1\n    # count_rem[2] stores the count of elements a[x] such that a[x] % 3 == 2 (this will always be 0)\n    count_rem = [0, 0, 0]\n\n    for i in range(1, n + 1):\n        if i % 3 == 2:\n            count_rem[0] += 1\n        else: # i % 3 == 0 or i % 3 == 1\n            count_rem[1] += 1\n\n    c0 = count_rem[0]\n    c1 = count_rem[1]\n    # c2 = count_rem[2] will always be 0 based on the formula for a[i].\n\n    # A sum (a[i] + a[j] + a[k]) is a multiple of 3 if the sum of their remainders is a multiple of 3.\n    # Given that c2 is 0, the only possible combinations of remainders (r1, r2, r3) that sum to a multiple of 3 are:\n    # 1. (0, 0, 0): Choose 3 elements whose remainders are 0.\n    # 2. (1, 1, 1): Choose 3 elements whose remainders are 1.\n\n    # Number of ways to choose 3 elements from c0 items\n    triples = c0 * (c0 - 1) * (c0 - 2) // 6\n    # Number of ways to choose 3 elements from c1 items\n    triples += c1 * (c1 - 1) * (c1 - 2) // 6\n    \n    return triples", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/151": [{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    '''\n    total_sum_of_squares = 0\n    for num in lst:\n        # Check if the number is an integer and positive\n        if isinstance(num, int) and num > 0:\n            # Check if the positive integer is odd\n            if num % 2 != 0:\n                total_sum_of_squares += num * num\n    return total_sum_of_squares", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/39": [{"task_id": "HumanEval/39", "solution": "import math\nclass FibonacciSequence:\n    \"\"\"Generates Fibonacci numbers iteratively.\"\"\"\n\n    def __init__(self):\n        \"\"\"Initializes the Fibonacci sequence with the first two numbers.\"\"\"\n        self._current_fib_a = 0  # Represents F(n-2)\n        self._current_fib_b = 1  # Represents F(n-1)\n        self._count = 0  # To handle the first two numbers correctly\n\n    def generate_next(self) -> int:\n        \"\"\"Calculates and returns the next Fibonacci number in the sequence.\"\"\"\n        if self._count == 0:\n            self._count += 1\n            return 0\n        elif self._count == 1:\n            self._count += 1\n            return 1\n        else:\n            next_fib = self._current_fib_a + self._current_fib_b\n            self._current_fib_a = self._current_fib_b\n            self._current_fib_b = next_fib\n            return next_fib\nclass PrimalityChecker:\n    \"\"\"Determines if a given integer is a prime number.\"\"\"\n\n    def is_prime(self, num: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if num <= 1:\n            return False\n        if num <= 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\nclass PrimeFibonacciFinder:\n    \"\"\"Finds the n-th number that is both a Fibonacci number and a prime number.\"\"\"\n\n    def __init__(self, fib_sequence: FibonacciSequence, prime_checker: PrimalityChecker):\n        \"\"\"Initializes the finder with dependencies for Fibonacci generation and primality checking.\"\"\"\n        self._fib_sequence = fib_sequence\n        self._prime_checker = prime_checker\n\n    def find_nth_prime_fib(self, n: int) -> int:\n        \"\"\"Finds the n-th prime Fibonacci number.\"\"\"\n        prime_fib_count = 0\n        current_fib = 0\n\n        while prime_fib_count < n:\n            current_fib = self._fib_sequence.generate_next()\n            if current_fib > 1 and self._prime_checker.is_prime(current_fib):\n                prime_fib_count += 1\n\n        return current_fib\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    fib_sequence = FibonacciSequence()\n    prime_checker = PrimalityChecker()\n    finder = PrimeFibonacciFinder(fib_sequence, prime_checker)\n    return finder.find_nth_prime_fib(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[12]]}], "HumanEval/152": [{"task_id": "HumanEval/152", "solution": "class GameScore:\n    \"\"\"Value object representing an actual game score.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def get_value(self) -> int:\n        return self._value\nclass GuessScore:\n    \"\"\"Value object representing a guessed score.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def get_value(self) -> int:\n        return self._value\nclass Difference:\n    \"\"\"Value object representing the calculated difference for a match.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def get_value(self) -> int:\n        return self._value\nclass Match:\n    \"\"\"Encapsulates a single match's game score and guess score, and calculates its difference.\"\"\"\n    def __init__(self, game_score: GameScore, guess_score: GuessScore):\n        self._game_score = game_score\n        self._guess_score = guess_score\n        self._calculated_difference = None\n\n    def calculate_difference(self) -> None:\n        \"\"\"Calculates and stores the difference based on game and guess scores.\"\"\"\n        game_val = self._game_score.get_value()\n        guess_val = self._guess_score.get_value()\n\n        if game_val == guess_val:\n            self._calculated_difference = Difference(0)\n        else:\n            self._calculated_difference = Difference(abs(game_val - guess_val))\n\n    def get_calculated_difference(self) -> Difference:\n        \"\"\"Returns the calculated difference for the match.\"\"\"\n        return self._calculated_difference\ndef compare(game,guess):\n    \"\"\"Compares two lists of integer scores and guesses, returning a list of calculated differences.\"\"\"\n    results = []\n    for i in range(len(game)):\n        game_score_obj = GameScore(game[i])\n        guess_score_obj = GuessScore(guess[i])\n        \n        match_obj = Match(game_score_obj, guess_score_obj)\n        match_obj.calculate_difference()\n        \n        diff_obj = match_obj.get_calculated_difference()\n        results.append(diff_obj.get_value())\n        \n    return results", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "def _get_rotations(word: str) -> list[str]:\n    \"\"\"Generates all cyclic rotations of a given word.\"\"\"\n    rotations = []\n    n = len(word)\n    if n == 0:\n        return []\n    for i in range(n):\n        rotated_word = word[i:] + word[:i]\n        rotations.append(rotated_word)\n    return rotations\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    # If 'b' is empty, an empty string is a substring of 'a' if 'a' is also empty or not.\n    if not b:\n        return \"\" in a\n\n    # Generate all cyclic rotations of word 'b'.\n    rotations_b = _get_rotations(b)\n\n    # Check if any rotation of 'b' is a substring of 'a'.\n    for rotation in rotations_b:\n        if rotation in a:\n            return True\n            \n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    # Convert the absolute value of the number to a string to iterate through digits.\n    for digit_char in str(abs(num)):\n        dig