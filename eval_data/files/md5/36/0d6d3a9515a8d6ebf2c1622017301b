rs of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    # Validate input 'n' using the PositiveInteger class as per design (BR1).\n    # This raises ValueError if n is not a positive integer.\n    validated_n = PositiveInteger(n).get_value()\n\n    if validated_n == 1:\n        # For a 1-digit number, only '1' starts or ends with 1 (BR5).\n        return 1\n    else: # validated_n > 1 (BR9)\n        # Use the helper function to calculate the count for n > 1.\n        return _calculate_count_for_n_greater_than_1(validated_n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "class InputInteger:\n    \"\"\"Represents the input integer n and validates it.\"\"\"\n    def __init__(self, n: int):\n        self.value = n\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the input value is greater than 0.\"\"\"\n        return self.value > 0\nclass Factorial:\n    \"\"\"Calculates and stores the factorial of a given base number.\"\"\"\n    def __init__(self, base_number: int):\n        self.base_number = base_number\n        self.calculated_value = self._calculate()\n\n    def _calculate(self) -> int:\n        \"\"\"Computes the factorial of the base number.\"\"\"\n        if self.base_number == 0:\n            return 1\n        res = 1\n        for i in range(1, self.base_number + 1):\n            res *= i\n        return res\nclass SpecialFactorialCalculation:\n    \"\"\"Orchestrates the entire special factorial calculation process.\"\"\"\n    def __init__(self, n: int):\n        self._input_integer = InputInteger(n)\n        self._intermediate_factorials: list[Factorial] = []\n        self.final_result: int = 0\n\n    def perform_calculation(self) -> int:\n        \"\"\"Executes the full special factorial calculation.\"\"\"\n        self._validate_input()\n        self._calculate_intermediate_factorials()\n        self._compute_product_of_factorials()\n        return self.final_result\n\n    def _validate_input(self):\n        \"\"\"Validates the input integer n.\"\"\"\n        if not self._input_integer.is_valid():\n            raise ValueError(\"Input n must be greater than 0.\")\n\n    def _calculate_intermediate_factorials(self):\n        \"\"\"Calculates factorials for each integer from 1 to n.\"\"\"\n        for i in range(1, self._input_integer.value + 1):\n            self._intermediate_factorials.append(Factorial(i))\n\n    def _compute_product_of_factorials(self):\n        \"\"\"Computes the product of all calculated intermediate factorials.\"\"\"\n        product = 1\n        for fact_obj in self._intermediate_factorials:\n            product *= fact_obj.calculated_value\n        self.final_result = product\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    calculator = SpecialFactorialCalculation(n)\n    return calculator.perform_calculation()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}