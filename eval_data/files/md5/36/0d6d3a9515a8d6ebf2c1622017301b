ts": [], "plus_fail_tests": []}], "HumanEval/67": [{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket.\n    Parses apple and orange counts from a string and subtracts their sum from the total number of fruits.\n    \"\"\"\n    match = re.match(r\"^(\\d+) apples and (\\d+) oranges$\", s)\n    apples_str, oranges_str = match.groups()\n    apples = int(apples_str)\n    oranges = int(oranges_str)\n\n    total_apples_oranges = apples + oranges\n    mango_fruits = n - total_apples_oranges\n    return mango_fruits", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/69": [{"task_id": "HumanEval/69", "solution": "import collections\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    # Calculate the frequency of each integer in the list.\n    frequency_map = collections.Counter(lst)\n    \n    greatest_candidate = -1\n    # Iterate through unique numbers to find candidates and the greatest among them.\n    for num in sorted(frequency_map.keys(), reverse=True):\n        if num > 0 and frequency_map[num] >= num:\n            greatest_candidate = num\n            break # Since we iterate in reverse, the first found is the greatest\n            \n    return greatest_candidate", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/70": [{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    if not lst:\n        return []\n\n    # Create a sorted copy of the input list to efficiently retrieve min and max elements.\n    working_list = sorted(lst)\n    result_list = []\n    \n    # The first element in the strange sort is always the minimum from the original list.\n    result_list.append(working_list.pop(0))\n\n    # Alternate between adding the maximum and minimum of the remaining elements.\n    is_max_turn = True\n    while working_list:\n        if is_max_turn:\n            # Add the maximum remaining element.\n            result_list.append(working_list.pop()) \n        else:\n            # Add the minimum remaining element.\n            result_list.append(working_list.pop(0))\n        is_max_turn = not is_max_turn\n            \n    return result_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/71": [{"task_id": "HumanEval/71", "solution": "import math\nclass Triangle:\n    \"\"\"\n    Encapsulates triangle properties and provides methods for validation and area calculation.\n    \"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        self.side_a = a\n        self.side_b = b\n        self.side_c = c\n        self.area = 0.0 # Stores the unrounded calculated area.\n\n    def validateSides(self) -> bool:\n        \"\"\"\n        Checks if the current side lengths form a valid triangle.\n        A valid triangle requires the sum of any two sides to be greater than the third side.\n        \"\"\"\n        # BR1: Sum of any two sides must be strictly greater than the third side.\n        # This condition implicitly handles non-positive side lengths as they would violate it.\n        return (self.side_a + self.side_b > self.side_c and\n                self.side_a + self.side_c > self.side_b and\n                self.side_b + self.side_c > self.side_a)\n\n    def calculateArea(self) -> float:\n        \"\"\"\n        Calculates the area using Heron's formula and stores it.\n        Returns the raw, unrounded area.\n        \"\"\"\n        # Calculate semi-perimeter\n        s = (self.side_a + self.side_b + self.side_c) / 2\n        \n        # BR3: Heron's formula for area.\n        # The product inside sqrt should be non-negative if validateSides() returns True.\n        product = s * (s - self.side_a) * (s - self.side_b) * (s - self.side_c)\n        self.area = math.sqrt(product)\n        return self.area\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    '''\n    triangle = Triangle(a, b, c)\n\n    if not triangle.validateSides():\n        return -1\n\n    raw_area = triangle.calculateArea()\n    \n    # BR4: Round the area to 2 decimal places.\n    rounded_area = round(raw_area, 2)\n    \n    return rounded_area", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/75": [{"task_id": "HumanEval/75", "solution": "def _get_prime_factors(n):\n    \"\"\"Returns a list of prime factors for n, including multiplicity.\"\"\"\n    factors = []\n    # Handle factor 2\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n    # Handle odd factors\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            factors.append(i)\n            n //= i\n        i += 2\n    # If n is still greater than 1, it must be a prime factor itself\n    if n > 1:\n        factors.append(n)\n    return factors\ndef is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    if a < 8: # Smallest product of 3 primes is 2 * 2 * 2 = 8\n        return False\n    \n    prime_factors = _get_prime_factors(a)\n    \n    return len(prime_factors) == 3", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/73": [{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic. A palindromic array is an array that\n    is read the same backwards and forwards. In one change, you can change one element to any other element.\n\n    For example:\n    smallest_change([1,2,3,5,4,7,9,6]) == 4\n    smallest_change([1, 2, 3, 4, 3, 2, 2]) == 1\n    smallest_change([1, 2, 3, 2, 1]) == 0\n    \"\"\"\n    count = 0\n    left, right = 0, len(arr) - 1\n    while left < right:\n        if arr[left] != arr[right]:\n            count += 1\n        left += 1\n        right -= 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/74": [{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    '''\n    Compares two lists of strings based on total character count and returns the list with fewer characters, \n    or the first list on a tie.\n    '''\n    \n    def _calculate_total_characters(string_list):\n        '''Calculates the sum of lengths of all strings in a given list.'''\n        total_chars = 0\n        for s in string_list:\n            total_chars += len(s)\n        return total_chars\n\n    lst1_char_count = _calculate_total_characters(lst1)\n    lst2_char_count = _calculate_total_characters(lst2)\n\n    if lst1_char_count <= lst2_char_count:\n        return lst1\n    else:\n        return lst2", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/64": [{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"\n    Counts the number of vowels in a 