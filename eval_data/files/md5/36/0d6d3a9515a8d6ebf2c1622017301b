 re\ndef _split_into_sentences(text: str) -> list[str]:\n    \"\"\"Splits the input text into a list of sentences, preserving delimiters.\"\"\"\n    sentences = re.split(r'([.?!])', text)\n    result = []\n    buffer = \"\"\n    for part in sentences:\n        if part in ['.', '?', '!']:\n            if buffer.strip():\n                result.append((buffer + part).strip())\n            buffer = \"\"\n        else:\n            buffer += part\n    if buffer.strip():\n        result.append(buffer.strip())\n    return [s for s in result if s]\ndef _is_boredom_sentence(sentence: str) -> bool:\n    \"\"\"Checks if a sentence starts with the word 'I' (case-sensitive).\"\"\"\n    cleaned_sentence = sentence.strip()\n    if not cleaned_sentence:\n        return False\n    first_word_match = re.match(r'^I\\b', cleaned_sentence)\n    return bool(first_word_match)\ndef is_bored(S):\n    \"\"\"\n    Counts the number of boredom sentences in a given string.\n    A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    boredom_count = 0\n    sentences = _split_into_sentences(S)\n    for sentence in sentences:\n        if _is_boredom_sentence(sentence):\n            boredom_count += 1\n    return boredom_count", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["I"]]}], "HumanEval/92": [{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    '''\n    # First, check if all three numbers are integers (value-wise).\n    # This check handles both actual integers and floats with decimal parts,\n    # without using isinstance() as per the design constraints.\n    if x != int(x) or y != int(y) or z != int(z):\n        return False\n    \n    # If all numbers are integers, p