          elif operator == '-':\n                    result = operand_left - operand_right\n                elif operator == '*':\n                    result = operand_left * operand_right\n                elif operator == '//':\n                    result = operand_left // operand_right\n                elif operator == '**':\n                    result = operand_left ** operand_right\n                \n                new_elements.append(result)\n                i += 2\n            else:\n                new_elements.append(elements[i])\n                i += 1\n        return new_elements\n\n    def evaluate(self) -> int:\n        \"\"\"\n        Evaluates the expression following operator precedence and returns the final integer result.\n        \"\"\"\n        # Operators are processed in order of precedence: **, then *, //, then +, -\n        elements_after_exp = self._perform_operation_pass(self._elements, {'**'})\n        elements_after_mul_div = self._perform_operation_pass(elements_after_exp, {'*', '//'})\n        elements_after_add_sub = self._perform_operation_pass(elements_after_mul_div, {'+', '-'})\n\n        return elements_after_add_sub[0]\ndef do_algebra(operator: List[str], operand: List[int]):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n    _validate_inputs(operator, operand)\n\n    interleaved_elements: List[Union[int, str]] = []\n    for i in range(len(operator)):\n        interleaved_elements.append(operand[i])\n        interleaved_elements.append(operator[i])\n    interleaved_elements.append(operand[len(operand) - 1])\n\n    expr = Expression(interleaved_elements)\n    return expr.evaluate()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[["**", "*", "+"], [2, 3, 4, 5]]], "plus_fail_tests": [[["+", "