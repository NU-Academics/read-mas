      smallest_positive = num\n\n    return (largest_negative, smallest_positive)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/141": [{"task_id": "HumanEval/141", "solution": "class FileName:\n    def __init__(self, name: str):\n        self._name = name\n        self._digit_count = sum(1 for char in name if char.isdigit())\n        self._dot_count = name.count('.')\n\n        # Split the name into prefix and suffix based on the first dot.\n        # ValidationService will enforce the 'exactly one dot' rule.\n        parts = name.split('.', 1)\n        self._prefix = parts[0]\n        self._suffix = parts[1] if len(parts) > 1 else \"\"\n\n    def digit_count(self) -> int:\n        return self._digit_count\n\n    def dot_count(self) -> int:\n        return self._dot_count\n\n    def prefix(self) -> str:\n        return self._prefix\n\n    def suffix(self) -> str:\n        return self._suffix\nclass ValidationCriteria:\n    MAX_DIGITS: int = 3\n    REQUIRED_DOTS: int = 1\n    ALLOWED_EXTENSIONS: list[str] = ['txt', 'exe', 'dll']\n\n    @staticmethod\n    def is_latin_letter(char: str) -> bool:\n        \"\"\"Checks if a character is an ASCII letter (a-z, A-Z).\"\"\"\n        return ('a' <= char <= 'z' or 'A' <= char <= 'Z')\n\n    @staticmethod\n    def is_allowed_extension(extension: str) -> bool:\n        \"\"\"Checks if an extension is in the list of allowed extensions.\"\"\"\n        return extension in ValidationCriteria.ALLOWED_EXTENSIONS\nclass ValidationResult:\n    def __init__(self, status: str):\n        self.status = status\nclass ValidationService:\n    def validate(self, file_name_obj: FileName) -> ValidationResult:\n        # Rule 1: There should not be more than three digits.\n        if file_name_obj.digit_count() > ValidationCriteria.MAX_DIGITS:\n            return ValidationResult('No')\n\n        # Rule 2: The file's name contains exactly one dot.\n        if file_name_obj.dot_count() !=