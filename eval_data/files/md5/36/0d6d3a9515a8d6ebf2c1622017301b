\n    # \"DO NOT add isinstance() checks\". Given the examples, the input is\n    # assumed to be a list of two strings.\n    # Therefore, we skip the explicit input list validation and proceed directly\n    # with string content validation.\n\n    if not (_is_parentheses_string_valid(s1) and _is_parentheses_string_valid(s2)):\n        return 'No' # Based on design, invalid chars imply 'No'\n\n    # Check s1 + s2\n    candidate1 = s1 + s2\n    if _is_balanced(candidate1):\n        return 'Yes'\n\n    # Check s2 + s1\n    candidate2 = s2 + s1\n    if _is_balanced(candidate2):\n        return 'Yes'\n\n    return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/121": [{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    \n\n    Examples\n    solution([5, 8, 7, 1]) ==> 12\n    solution([3, 3, 3, 3, 3]) ==> 9\n    solution([30, 13, 24, 321]) ==>0\n    \"\"\"\n    total_sum = 0\n    # Iterate through the list using index and value.\n    for i, element in enumerate(lst):\n        # Check if the current position is even and the element is odd.\n        if i % 2 == 0 and element % 2 != 0:\n            total_sum += element\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/122": [{"task_id": "HumanEval/122", "solution": "from typing import List\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\nclass Integer:\n    \"\"\"Encapsulates an integer value and checks if it has at most two digits.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def get_value(self) -> int:\n        \"\"\"Returns the encapsulated integer value.\"\"\"\n        return self._value\n\n    def has_at_most_two_digits(self) -> bool:\n        \"\"\"Checks if the absolute value of the integer is less than 100.\"\"\"\n        return abs(self._value) < 100\nclass IntegerArray:\n    \"\"\"Manages a collection of Integer objects, providing methods for validation and subset retrieval.\"\"\"\n    def __init__(self, arr: List[int]):\n        # Validates array length based on constraints (1 <= len(arr) <= 100).\n        if not (1 <= len(arr) <= 100):\n            raise InvalidInputError(\"Array length must be between 1 and 100.\")\n        self._elements = [Integer(val) for val in arr]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self._elements)\n\n    def get_first_k_elements(self, k: int) -> List[Integer]:\n        \"\"\"Returns the first k elements, performing validation for k.\"\"\"\n        # Validates k based on constraints (1 <= k <= len(arr)).\n        if not (1 <= k <= self.length()):\n            raise InvalidInputError(f\"k must be between 1 and array length ({self.length()}).\")\n        return self._elements[:k]\nclass SumCalculator:\n    \"\"\"Calculates the sum of eligible Integer elements.\"\"\"\n    def calculate(self, elements: List[Integer]) -> int:\n        \"\"\"Calculates the sum of Integer objects that have at most two digits.\"\"\"\n        total_sum = 0\n        for element in elements:\n            if element.has_at_most_two_digits():\n                total_sum += element.get_value()\n        return total_sum\ndef add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    integer_array = IntegerArray(arr)\n    first_k_elements = integer_array.get_first_k_elements(k)\n    sum_calculator = SumCalculator()\n    return sum_calculator.calculate(first_k_elements)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "import re\ndef split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    '''\n    def _has_whitespace(text: str) -> bool:\n        return bool(re.search(r'\\s', text))\n\n    def _has_commas(text: str) -> bool:\n        return ',' in text\n\n    def _split_by_whitespace(text: str) -> list[str]:\n        return text.split()\n\n    def _split_by_commas(text: str) -> list[str]:\n        return text.split(',')\n\n    def _count_odd_ordered_lowercase_letters(text: str) -> int:\n        count = 0\n        for char in text:\n            if 'a' <= char <= 'z':\n                if (ord(char) - ord('a')) % 2 != 0:\n                    count += 1\n        return count\n\n    if _has_whitespace(txt):\n        return _split_by_whitespace(txt)\n    elif _has_commas(txt):\n        return _split_by_commas(txt)\n    else:\n        return _count_odd_ordered_lowercase_letters(txt)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/124": [{"task_id": "HumanEval/124", "solution": "def _is_not_empty(date_string):\n    \"\"\"Checks if the date string is not empty.\"\"\"\n    return bool(date_string)\ndef _parse_and_validate_format(date_string):\n    \"\"\"Parses date string into components and validates mm-dd-yyyy format.\"\"\"\n    parts = date_string.split('-')\n    if len(parts) != 3:\n        return False, 0, 0, 0\n\n    # Ensure all parts are digits and have correct lengths\n    if not (parts[0].isdigit() and len(parts[0]) == 2 and\n            parts[1].isdigit() and len(parts[1]) == 2 and\n            parts[2].isdigit() and len(parts[2]) == 4):\n        return False, 0, 0, 0\n\n    try:\n        month = int(parts[0])\n        day = int(parts[1])\n        year = int(parts[2])\n        return True, month, day, year\n    except ValueError:\n        return False, 0, 0, 0\ndef _is_month_valid(month):\n    \"\"\"Validates if the month is between 1 and 12.\"\"\"\n    return 1 <= month <= 12\ndef _is_day_valid(day, month):\n    \"\"\"Validates if the day is within the correct range for the given month.\"\"\"\n    if not (1 <= day):\n        return False\n\n    if month in [1, 3, 5, 7, 8, 10, 12]:\n        return day <= 31\n    elif month in [4, 6, 9, 11]:\n        return day <= 30\n    elif month == 2:\n        return day <= 29  # No leap year consideration as per rules\n    return False\ndef valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n\n    for example: \n    valid_date('03-11-2000') => True\n\n    valid_date('15-01-2012') => False\n\n    valid_date('04-0-2040') => False\n\n    valid_date('06-04-2020') => True\n\n    valid_date('06/04/2020') => False\n    \"\"\"\n    if not _is_not_empty(date):\n        return False\n\n    format_valid, month, day, year = _parse_and_validate_format(date)\n    if not format_valid:\n        return False\n\n    if not _is_month_valid(month):\n        return False\n\n    if not _is_day_valid(day, month):\n        return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/126": [{"task_id": "HumanEval/126", "solution": "from collections import Counter\ndef is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    # Check for ascending order\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check for duplicate constraint (no number appears more than twice)\n    counts = Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Determine if the length of intersection of two intervals is a prime number.\n    Returns \"YES\" if prime, otherwise \"NO\". If no intersection, returns \"NO\".\n    \"\"\"\n\n    class Interval:\n        def __init__(self, start: int, end: int):\n            self.start = start\n            self.end = end\n\n        def get_length(self) -> int:\n            # Calculates the length of the interval (end - start + 1).\n            return self.end - self.start + 1\n\n    def _is_prime(n: int) -> bool:\n        # Checks if a given integer n is a prime number.\n        if n <= 1:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    def _calculate_intersection_length(int1_obj: Interval, int2_obj: Interval) -> int:\n        # Determines the intersection of two Interval objects and returns its length.\n        intersection_start = max(int1_obj.start, int2_obj.start)\n        intersection_end = min(int1_obj.end, int2_obj.end)\n\n        if intersection_start > intersection_end:\n            return 0  # No intersection\n        else:\n            return Interval(intersection_start, intersection_end).get_length()\n\n    # Create Interval objects from input tuples\n    int1_obj = Interval(interval1[0], interval1[1])\n    int2_obj = Interval(interval2[0], interval2[1])\n\n    # Determine intersection and calculate its length\n    length = _calculate_intersection_length(int1_obj, int2_obj)\n\n    if length == 0:\n        return \"NO\"\n\n    # Determine if length is prime\n    if _is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-1, 1], [0, 4]]], "plus_fail_tests": [[[10, 20], [15, 25]]]}], "HumanEval/128": [{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes multiplied by the product of signs of numbers in an array.\n    Returns None for an empty input array.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = 0\n    product_signs = 1\n\n    for num in arr:\n        sum_magnitudes += abs(num)\n\n        if num > 0:\n            product_signs *= 1\n        elif num < 0:\n            product_signs *= -1\n        else: # num == 0\n            product_signs *= 0\n\n    return sum_magnitudes * product_signs", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/131": [{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product = 1\n    found_odd_digit = False\n\n    while n > 0:\n        digit = n % 10\n        if digit % 2 != 0:\n            product *= digit\n            found_odd_digit = True\n        n //= 10\n\n    if found_odd_digit:\n        return product\n    else:\n        return 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "class Cell:\n    \"\"\"Stores the coordinates and value of a single grid cell.\"\"\"\n    def __init__(self, row: int, col: int, value: int):\n        self.row = row\n        self.col = col\n        self.value = value\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, Cell):\n            return NotImplemented\n        return self.row == other.row and self.col == other.col\n\n    def __hash__(self) -> int:\n        return hash((self.row, self.col))\nclass Path:\n    \"\"\"Represents an ordered sequence of cells visited and provides lexicographical comparison.\"\"\"\n    def __init__(self, initial_cell: Cell):\n        self._sequence_of_cells = [initial_cell]\n        self._values_sequence = [initial_cell.value]\n        self._length = 1\n        self.last_cell = initial_cell\n\n    def add_cell(self, cell: Cell) -> 'Path':\n        \"\"\"Returns a new Path object with the given cell appended.\"\"\"\n        new_path = Path(self._sequence_of_cells[0]) # Create a dummy path with the first cell\n        new_path._sequence_of_cells = self._sequence_of_cells + [cell]\n        new_path._values_sequence = self._values_sequence + [cell.value]\n        new_path._length = self._length + 1\n        new_path.last_cell = cell\n        return new_path\n\n    def get_values_sequence(self) -> list[int]:\n        \"\"\"Returns the ordered list of integer values of cells in the path.\"\"\"\n        return self._values_sequence\n\n    def get_length(self) -> int:\n        \"\"\"Returns the current length of the path.\"\"\"\n        return self._length\n\n    def __lt__(self, other: 'Path') -> bool:\n        \"\"\"Compares two paths lexicographically.\"\"\"\n        return self.get_values_sequence() < other.get_values_sequence()\nclass Grid:\n    \"\"\"Manages the 2D grid of cells, provides access to cells and their neighbors.\"\"\"\n    def __init__(self, grid_data: list[list[int]]):\n        self._N = len(grid_data)\n        # These checks are duplicated from _validate_input as per design context.\n        if self._N < 2:\n            raise ValueError(\"Grid dimension N must be at least 2.\")\n        if any(len(row) != self._N for row in grid_data):\n            raise ValueError(\"Grid must be square (N x N).\")\n\n        self._cells = [[None for _ in range(self._N)] for _ in range(self._N)]\n        seen_values = set()\n        for r in range(self._N):\n            for c in range(self._N):\n                value = grid_data[r][c]\n                # These checks are duplicated from _validate_input as per design context.\n                if not (1 <= value <= self._N * self._N):\n                    raise ValueError(f\"Cell value {value} out of range [1, {self._N * self._N}].\")\n                if value in seen_values:\n                    raise ValueError(f\"Duplicate value {value} found in grid.\")\n                seen_values.add(value)\n                self._cells[r][c] = Cell(r, c, value)\n        \n        if len(seen_values) != self._N * self._N:\n            raise ValueError(f\"Not all values from 1 to {self._N * self._N} are present exactly once.\")\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        \"\"\"Returns the Cell object at the specified row and column.\"\"\"\n        return self._cells[row][col]\n\n    def get_neighbors(self, cell: Cell) -> list[Cell]:\n        \"\"\"Returns a list of valid adjacent (up, down, left, right) Cell neighbors.\"\"\"\n        neighbors = []\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # Up, Down, Left, Right\n        for dr, dc in directions:\n            nr, nc = cell.row + dr, cell.col + dc\n            if 0 <= nr < self._N and 0 <= nc < self._N:\n                neighbors.append(self.get_cell(nr, nc))\n        return neighbors\n\n    def get_N(self) -> int:\n        \"\"\"Returns the dimension N of the grid.\"\"\"\n        return self._N\ndef _find_min_path_recursive(grid: Grid, current_path: Path, k: int, min_path_values_wrapper: list[list[int]]) -> None:\n    \"\"\"Recursively explores paths of length k, updating the lexicographically smallest path.\"\"\"\n    if current_path.get_length() == k:\n        if current_path.get_values_sequence() < min_path_values_wrapper[0]:\n            min_path_values_wrapper[0] = current_path.get_values_sequence()\n        return\n\n    if current_path.get_length() < k:\n        neighbors = grid.get_neighbors(current_path.last_cell)\n        # Sorting neighbors by value can prune some branches early, though DFS explores all.\n        neighbors.sort(key=lambda cell: cell.value)\n\n        for neighbor_cell in neighbors:\n            next_path = current_path.add_cell(neighbor_cell)\n            _find_min_path_recursive(grid, next_path, k, min_path_values_wrapper)\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    find the minimum path of length k in the grid.\n    \"\"\"\n    _validate_input(grid, k)\n\n    grid_obj = Grid(grid)\n    N = grid_obj.get_N()\n\n    # Initialize min_path_values with a path guaranteed to be larger than any valid path.\n    # The wrapper list allows passing a mutable reference for the best path found so far.\n    max_possible_value = N * N + 1\n    min_path_values_wrapper = [[max_possible_value] * k]\n\n    for r in range(N):\n        for c in range(N):\n            start_cell = grid_obj.get_cell(r, c)\n            initial_path = Path(start_cell)\n            _find_min_path_recursive(grid_obj, initial_path, k, min_path_values_wrapper)\n\n    return min_path_values_wrapper[0]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 3]], "plus_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 1]]}], "HumanEval/132": [{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Checks if a string of square brackets contains a valid subsequence where at least one bracket is nested.\n    This is determined by finding the pattern `[[...]]` within the string.\n    '''\n    \n    # Find the first opening bracket\n    first_open_idx = string.find('[')\n    if first_open_idx == -1:\n        return False\n\n    # Find the second opening bracket after the first one\n    second_open_idx = string.find('[', first_open_idx + 1)\n    if second_open_idx == -1:\n        return False\n\n    # Find the first closing bracket after the second opening bracket\n    first_close_idx = string.find(']', second_open_idx + 1)\n    if first_close_idx == -1:\n        return False\n\n    # Find the second closing bracket after the first closing bracket\n    second_close_idx = string.find(']', first_close_idx + 1)\n    if second_close_idx == -1:\n        return False\n\n    # If all four indices are found in the correct order, a nested structure exists\n    return True", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["[][][]"]]}], "HumanEval/123": [{"task_id": "HumanEval/123", "solution": "import collections\nclass Integer:\n    \"\"\"Encapsulates an integer value and provides Collatz-specific arithmetic and parity checks.\"\"\"\n\n    def __init__(self, value: int):\n        self._value = value\n\n    def is_even(self) -> bool:\n        return self._value % 2 == 0\n\n    def is_odd(self) -> bool:\n        return self._value % 2 != 0\n\n    def divide_by_two(self) -> 'Integer':\n        return Integer(self._value // 2)\n\n    def multiply_by_three_add_one(self) -> 'Integer':\n        return Integer(3 * self._value + 1)\n\n    def get_value(self) -> int:\n        return self._value\n\n    def __eq__(self, other) -> bool:\n        if not isinstance(other, Integer):\n            return NotImplemented\n        return self._value == other._value\n\n    def __lt__(self, other) -> bool:\n        if not isinstance(other, Integer):\n            return NotImplemented\n        return self._value < other._value\nclass CollatzSequence:\n    \"\"\"Generates the Collatz sequence for a starting number and provides access to its terms.\"\"\"\n\n    def __init__(self):\n        self._terms = []\n\n    def generate(self, start_n: Integer) -> None:\n        current_n = start_n\n        # Using a set to track numbers already added to avoid infinite loops, though Collatz conjecture states this won't happen.\n        seen_numbers = {current_n.get_value()} \n        \n        while current_n.get_value() != 1:\n            self._terms.append(current_n)\n            \n            if current_n.is_even():\n                current_n = current_n.divide_by_two()\n            else:\n                current_n = current_n.multiply_by_three_add_one()\n            \n            # This check is primarily for robustness against unexpected behavior or very large sequences.\n            if current_n.get_value() in seen_numbers and current_n.get_value() != 1:\n                break # Should not happen based on conjecture\n            seen_numbers.add(current_n.get_value())\n            \n        self._terms.append(Integer(1)) # Always add the final 1\n\n    def get_terms(self) -> list[Integer]:\n        return self._terms\nclass OddNumberList:\n    \"\"\"Collects odd numbers and sorts them.\"\"\"\n\n    def __init__(self):\n        self._numbers = []\n\n    def add(self, number: Integer) -> None:\n        if number.is_odd():\n            self._numbers.append(number)\n\n    def sort(self) -> None:\n        self._numbers.sort()\n\n    def get_numbers(self) -> list[int]:\n        return [num.get_value() for num in self._numbers]\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n\n    The Collatz conjecture is a conjecture in mathematics that concerns a sequence defined\n    as follows: start with any positive integer n. Then each term is obtained from the \n    previous term as follows: if the previous term is even, the next term is one half of \n    the previous term. If the previous term is odd, the next term is 3 times the previous\n    term plus 1. The conjecture is that no matter what value of n, the sequence will always reach 1.\n\n    Note: \n        1. Collatz(1) is [1].\n        2. returned list sorted in increasing order.\n\n    For example:\n    get_odd_collatz(5) returns [1, 5] # The collatz sequence for 5 is [5, 16, 8, 4, 2, 1], so the odd numbers are only 1, and 5.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    collatz_seq_generator = CollatzSequence()\n    odd_number_collector = OddNumberList()\n\n    start_n_obj = Integer(n)\n    collatz_seq_generator.generate(start_n_obj)\n\n    for term in collatz_seq_generator.get_terms():\n        odd_number_collector.add(term)\n    \n    # Use a set to remove duplicates before sorting and returning\n    unique_odd_numbers = list(set(odd_number_collector.get_numbers()))\n    unique_odd_numbers.sort()\n\n    return unique_odd_numbers", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/134": [{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an isolated alphabetical character.\n    Returns True if the last character is a letter and is preceded by a space or is the only character; False otherwise.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    # If it's a single character string, and it's alphabetical, it's isolated.\n    if len(txt) == 1:\n        return True\n\n    # If there's more than one character, check the character before the last one.\n    # It must be a space for the last character to be considered \"not a part of a word\".\n    char_before_last = txt[-2]\n    return char_before_last == ' '", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/133": [{"task_id": "HumanEval/133", "solution": "import math\nfrom typing import List\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    Examples:\n    For lst = [1,2,3] the output should be 14\n    For lst = [1,4,9] the output should be 98\n    For lst = [1,3,5,7] the output should be 84\n    For lst = [1.4,4.2,0] the output should be 29\n    For lst = [-2.4,1,1] the output should be 6\n    \"\"\"\n\n    class Number:\n        \"\"\"Encapsulates a single numerical value and its transformations.\"\"\"\n        def __init__(self, value: float):\n            self._original_value = value\n            self.rounded_value: int = 0\n            self.squared_value: int = 0\n\n        def round_up(self) -> None:\n            \"\"\"Rounds the original value up to the nearest integer.\"\"\"\n            self.rounded_value = int(math.ceil(self._original_value))\n\n        def square(self) -> None:\n            \"\"\"Squares the rounded value.\"\"\"\n            self.squared_value = self.rounded_value * self.rounded_value\n\n    class NumberList:\n        \"\"\"Manages a collection of Number objects and orchestrates their processing.\"\"\"\n        def __init__(self, input_list: List[float]):\n            self._numbers: List[Number] = []\n            for value in input_list:\n                self._numbers.append(Number(value))\n\n        def calculate_sum_of_squared_ceilings(self) -> int:\n            \"\"\"Calculates the sum of squared ceiling-rounded numbers.\"\"\"\n            total_sum = 0\n            for number_obj in self._numbers:\n                number_obj.round_up()\n                number_obj.square()\n                total_sum += number_obj.squared_value\n            return total_sum\n\n    number_list_instance = NumberList(lst)\n    return number_list_instance.calculate_sum_of_squared_ceilings()", "base_status"