rts_with_i(self) -> bool:\n        \"\"\"Checks if the first word of the sentence content is 'I' (case-sensitive).\"\"\"\n        if not self._content:\n            return False\n        words = self._content.split()\n        return len(words) > 0 and words[0] == \"I\"\nclass InputString:\n    \"\"\"Encapsulates the raw input text and provides functionality to extract individual sentences.\"\"\"\n    def __init__(self, text: str):\n        self._text = text\n\n    def get_sentences(self) -> list['Sentence']:\n        \"\"\"Parses the text using '.', '?', '!' as delimiters and returns a list of Sentence objects.\"\"\"\n        delimiters = ['.', '?', '!']\n        sentences = []\n        current_sentence_start = 0\n        for i, char in enumerate(self._text):\n            if char in delimiters:\n                sentence_content = self._text[current_sentence_start:i].strip()\n                if sentence_content: # Only add non-empty sentences\n                    sentences.append(Sentence(sentence_content))\n                current_sentence_start = i + 1\n        \n        # Add any remaining text as a sentence if it's not empty and no delimiter at the end\n        remaining_content = self._text[current_sentence_start:].strip()\n        if remaining_content:\n            sentences.append(Sentence(remaining_content))\n            \n        return sentences\nclass BoredomCounter:\n    \"\"\"Orchestrates the process of counting sentences that start with 'I' from a given InputString.\"\"\"\n    def count_boredoms(self, input_string_obj: 'InputString') -> int:\n        \"\"\"Takes an InputString object, retrieves its sentences, and counts how many start with 'I'.\"\"\"\n        boredom_count = 0\n        sentences = input_string_obj.get_sentences()\n        for sentence in sentences:\n            if sentence.starts_with_i():\n                boredom_count += 1\n        return boredom_count\ndef is_bored(S):\n    \"\"\"\n    Counts the number of \"boredoms\" in a string, w