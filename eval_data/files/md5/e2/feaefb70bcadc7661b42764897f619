urn 'No'\n\n    # Split the file name into prefix and extension\n    # rsplit ensures that only the last dot is considered the separator for the extension\n    parts = file_name.rsplit('.', 1)\n    prefix = parts[0]\n    extension = parts[1]\n\n    # Create FileName object\n    file_obj = FileName(file_name, prefix, extension)\n\n    # Validate all other conditions using FileNameValidator\n    if FileNameValidator.validate(file_obj):\n        return 'Yes'\n    else:\n        return 'No'", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\u00e9xample.exe"]]}], "HumanEval/145": [{"task_id": "HumanEval/145", "solution": "import math\nfrom typing import List\nclass SortableInteger:\n    \"\"\"\n    Encapsulates an integer's value, its original position, and its pre-calculated\n    sum of absolute digits for custom sorting.\n    \"\"\"\n    def __init__(self, value: int, original_index: int, calculated_digit_sum: int):\n        self.value = value\n        self.original_index = original_index\n        self.calculated_digit_sum = calculated_digit_sum\ndef _calculate_digit_sum(num: int) -> int:\n    \"\"\"Calculates the sum of the absolute values of the digits of an integer.\"\"\"\n    s = str(abs(num))\n    return sum(int(digit) for digit in s)\ndef order_by_points(nums: List[int]) -> List[int]:\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If there are several items with similar sum of their digits, order them based on their original index.\n    \"\"\"\n    if not nums:\n        return []\n\n    sortable_items = []\n    for i, num in enumerate(nums):\n        digit_sum = _calculate_digit_sum(num)\n        sortable_items.append(SortableInteger(value=num, original_index=i, calculated_digit_sum=digit_sum))\n\n    sortable_items.sort(key=lambda x: (x.calculated_digit_sum, x.original_index))\n\n    return [item.value for item in sortable_items]", "base_status": "fail", "