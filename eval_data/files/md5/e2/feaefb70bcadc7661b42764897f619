 current_min)\n\n    return global_min", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/120": [{"task_id": "HumanEval/120", "solution": "def _find_k_maximum_numbers(arr, k):\n    \"\"\"Identifies the k maximum numbers from the input array arr.\"\"\"\n    if k == 0:\n        return []\n    arr_sorted_desc = sorted(arr, reverse=True)\n    return arr_sorted_desc[:k]\ndef _sort_numbers(numbers):\n    \"\"\"Sorts a given list of numbers in ascending order.\"\"\"\n    return sorted(numbers)\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    _validate_inputs(arr, k)\n    unsorted_k_max = _find_k_maximum_numbers(arr, k)\n    return _sort_numbers(unsorted_k_max)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-3, -4, 5], 3]], "plus_fail_tests": [[[1, 2, 3, 4, 5], 3]]}], "HumanEval/117": [{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, you have been tasked to implement \n    a function that returns a list of all words from string s that contain exactly \n    n consonants, in order these words appear in the string s.\n    If the string s is empty then the function should return an empty list.\n    \"\"\"\n    \n    def _is_vowel(char):\n        \"\"\"Checks if a character is a vowel (a, e, i, o, u), case-insensitively.\"\"\"\n        return char.lower() in 'aeiou'\n\n    def _count_consonants(word):\n        \"\"\"Counts consonants in a word by iterating through its characters.\"\"\"\n        count = 0\n        for char in word:\n            if char.isalpha() and not _is_vowel(char):\n                count += 1\n        return count\n\n    if not s:\n        return []\n\n    words = s.split()\n    result = []\n    for word in words:\n        if _count_consonants(word) == n:\n            result.ap