    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/118": [{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between \n    two consonants from the right side of the word (case sensitive).\n    \n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition. \n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n    def _is_vowel(char):\n        \"\"\"Checks if a character is an English vowel (case-insensitive).\"\"\"\n        return char.lower() in 'aeiou'\n\n    def _is_consonant(char):\n        \"\"\"Checks if a character is an English consonant (case-insensitive).\"\"\"\n        return char.isalpha() and not _is_vowel(char)\n\n    if len(word) < 3:\n        return \"\"\n\n    # Iterate from the second-to-last character down to the second character.\n    # This excludes the first (index 0) and last (index len(word)-1) characters.\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        if _is_vowel(current_char) and _is_consonant(left_char) and _is_consonant(right_char):\n            return current_char\n            \n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/124": [{"task_id": "HumanEval/124", "solution": "from typing import Optional\nclass Date:\n    \"\"\"Represents a date with its month, day, and year components, and encapsulates the rules for their valid ranges.\"\"\"\n    _MONTHS_31_DAYS = {1, 3, 5, 7, 8, 10, 12}\n    _MONTHS_30_DAYS = {4, 6, 9, 11}\n    _MONTH_FEB = 2 # Month 2 has up to 29 days as per rule 2.\n\n    def __init__(self, month: int, day: int, year: int):\n        self._month = month\n        self._day = day\n        self._year = year\n\n    @staticmethod\n    def parse(date_string: str) -> Optional['Date']:\n        \"\"\"Attempts to parse a 'mm-dd-yyyy' formatted string into a Date object.\"\"\"\n        parts = date_string.split('-')\n        if len(parts) != 3:\n            return None\n        \n        try:\n            month = int(parts[0])\n            day = int(parts[1])\n            year = int(parts[2])\n            return Date(month, day, year)\n        except ValueError:\n            return None\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the month and day components of the Date object are within their valid ranges.\"\"\"\n        # Rule 3: The months should not be less than 1 or higher than 12.\n        if not (1 <= self._month <= 12):\n            return False\n\n        # Rule 2: Day ranges based on month.\n        if self._month in Date._MONTHS_31_DAYS:\n            if not (1 <= self._day <= 31):\n                return False\n        elif self._month in Date._MONTHS_30_DAYS:\n            if not (1 <= self._day <= 30):\n                return False\n        elif self._month == Date._MONTH_FEB:\n            # Rule 2 for February: not less than 1 or higher than 29.\n            if not (1 <= self._day <= 29):\n                return False\n        \n        return True\nclass DateValidator:\n    \"\"\"Encapsulates the overall date string validation logic.\"\"\"\n    def validate(self, date_string: str) -> bool:\n        \"\"\"Performs all validation rules on the input date string.\"\"\"\n        # Rule 1: The date string is not empty.\n        if not date_string:\n            return False\n\n        # Rule 4: The date should be in the format: mm-dd-yyyy\n        date_obj = Date.parse(date_string)\n        if date_obj is None:\n            return False\n        \n        return date_obj.is_valid()\ndef valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n    \"\"\"\n    validator = DateValidator()\n    return validator.validate(date)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["06-04-202"]]}], "HumanEval/36": [{"task_id": "HumanEval/36", "solution": "def _is_divisible_by_11_or_13(num: int) -> bool:\n    \"\"\"Checks if a number is divisible by 11 or 13.\"\"\"\n    return (num % 11 == 0) or (num % 13 == 0)\ndef _count_digit_7(num: int) -> int:\n    \"\"\"Counts the occurrences of the digit '7' in an integer.\"\"\"\n    return str(num).count('7')\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_count = 0\n    for i in range(1, n):\n        if _is_divisible_by_11_or_13(i):\n            total_count += _count_digit_7(i)\n    return total_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/122": [{"task_id": "HumanEval/122", "solution": "from typing import List\nclass InputValidationError(ValueError):\n    \"\"\"Custom exception for input validation errors.\"\"\"\n    pass\nclass IntegerValue:\n    \"\"\"Encapsulates an integer value and provides business logic for digit count.\"\"\"\n\n    def __init__(self, value: int):\n        if not isinstance(value, int):\n            raise TypeError(\"Value must be an integer.\")\n        self._value = value\n\n    def get_value(self) -> int:\n        \"\"\"Returns the raw integer value.\"\"\"\n        return self._value\n\n    def is_at_most_two_digits(self) -> bool:\n        \"\"\"Checks if the absolute value of the integer is less than 100.\"\"\"\n        return -100 < self._value < 100\n\n    def __repr__(self) -> str:\n        return f\"IntegerValue({self._value})\"\n\n    def __eq__(self, other) -> bool:\n        if not isinstance(other, IntegerValue):\n            return NotImplemented\n        return self._value == other._value\n\n    def __hash__(self) -> int:\n        return hash(self._value)\nclass IntegerArray:\n    \"\"\"Manages a collection of IntegerValue objects and provides indexed access.\"\"\"\n\n    def __init__(self, arr: List[int]):\n        if not isinstance(arr, list):\n            raise TypeError(\"Input 'arr' must be a list.\")\n        self._elements: List[IntegerValue] = [IntegerValue(val) for val in arr]\n\n    def get_length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self._elements)\n\n    def get_element(self, index: int) -> IntegerValue:\n        \"\"\"Returns the IntegerValue at the specified index.\"\"\"\n        if not isinstance(index, int):\n            raise TypeError(\"Index must be an integer.\")\n        if not (0 <= index < self.get_length()):\n            raise IndexError(\"Index out of bounds.\")\n        return self._elements[index]\n\n    def __repr__(self) -> str:\n        return f\"IntegerArray({[e.get_value() for e in self._elements]})\"\nclass SumCalculationService:\n    \"\"\"Implements the core logic for filtering and summing elements based on business rules.\"\"\"\n\n    def calculate_sum(self, integer_array: IntegerArray, k: int) -> int:\n        \"\"\"Calculates the sum of elements with at most two digits from the first k elements.\"\"\"\n        total_sum = 0\n        for i in range(min(k, integer_array.get_length())):\n            element = integer_array.get_element(i)\n            if element.is_at_most_two_digits():\n                total_sum += element.get_value()\n        return total_sum\ndef add_elements(arr: List[int], k: int) -> int:\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise InputValidationError(\"Input 'arr' must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise InputValidationError(\"All elements in 'arr' must be integers.\")\n\n    if not (1 <= len(arr) <= 100):\n        raise InputValidationError(f\"Length of 'arr' must be between 1 and 100, got {len(arr)}.\")\n\n    if not isinstance(k, int):\n        raise InputValidationError(\"Input 'k' must be an integer.\")\n\n    if not (1 <= k <= len(arr)):\n        raise InputValidationError(f\"Value of 'k' must be between 1 and len(arr) ({len(arr)}), got {k}.\")\n\n    integer_array = IntegerArray(arr)\n    sum_calculator = SumCalculationService()\n\n    calculated_sum = sum_calculator.calculate_sum(integer_array, k)\n\n    return calculated_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/123": [{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    odd_numbers = set()\n    current_term = n\n\n    while current_term != 1:\n        if current_term % 2 != 0:\n            odd_numbers.add(current_term)\n        \n        # Calculate the next term in the Collatz sequence\n        if current_term % 2 == 0:\n            current_term = current_term // 2\n        else:\n            current_term = (3 * current_term) + 1\n\n    # The number 1 is always the final (and odd) term in any Collatz sequence\n    odd_numbers.add(1)\n\n    sorted_odd_numbers = sorted(list(odd_numbers))\n    return sorted_odd_numbers", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/116": [{"task_id": "HumanEval/116", "solution": "def _count_set_bits(n: int) -> int:\n    \"\"\"Counts the number of '1' bits in the binary representation of a non-negative integer.\"\"\"\n    return bin(n).count('1')\ndef sort_array(arr: list[int]) -> list[int]:\n    \"\"\"\n    Sorts an array of non-negative integers according to number of ones in their binary\n    representation in ascending order. For similar number of ones, sort based on decimal value.\n    \"\"\"\n    return sorted(arr, key=lambda x: (_count_set_bits(x), x))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3 \n    '''\n    def _has_whitespace(text: str) -> bool:\n        '''Checks if the text contains any whitespace characters.'''\n        return any(c.isspace() for c in text)\n\n    def _has_comma(text: str) -> bool:\n        '''Checks if the text contains any comma characters.'''\n        return ',' in text\n\n    def _is_lowercase(char: str) -> bool:\n        '''Checks if the character is a lowercase English letter.'''\n        return 'a' <= char <= 'z'\n\n    def _get_alphabetical_order(char: str) -> int:\n        '''Returns the 0-indexed alphabetical order of a lowercase character.'''\n        return ord(char) - ord('a')\n\n    def _is_odd_order(order: int) -> bool:\n        '''Checks if the given integer order is odd.'''\n        return order % 2 != 0\n\n    def _count_odd_ordered_lowercase_letters(text: str) -> int:\n        '''Counts lowercase letters with an odd 0-indexed alphabetical order.'''\n        count = 0\n        for char in text:\n            if _is_lowercase(char):\n                order = _get_alphabetical_order(char)\n                if _is_odd_order(order):\n                    count += 1\n        return count\n\n    if _has_whitespace(txt):\n        return txt.split()\n    elif _has_comma(txt):\n        return txt.split(',')\n    else:\n        return _count_odd_ordered_lowercase_letters(txt)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/128": [{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of their signs.\n    Returns None for an empty array.\n    \"\"\"\n    def _get_magnitude(number):\n        \"\"\"Calculates the absolute value (magnitude) of a single integer.\"\"\"\n        return abs(number)\n\n    def _get_sign(number):\n        \"\"\"Determines the sign of a single integer: 1 for positive, -1 for negative, 0 for zero.\"\"\"\n        if number > 0:\n            return 1\n        elif number < 0:\n            return -1\n        else:\n            return 0\n\n    if not arr:\n        return None\n\n    sum_magnitudes = 0\n    product_signs = 1\n\n    for number in arr:\n        sum_magnitudes += _get_magnitude(number)\n        product_signs *= _get_sign(number)\n\n    final_result = sum_magnitudes * product_signs\n    return final_result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/131": [{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product_of_odd_digits = 1\n    found_odd = False\n\n    # Convert the number to a string to iterate through its digits\n    for char_digit in str(n):\n        digit = int(char_digit)\n        # Check if the digit is odd\n        if digit % 2 != 0:\n            product_of_odd_digits *= digit\n            found_odd = True\n\n    # If no odd digits were found, return 0\n    if not found_odd:\n        return 0\n    \n    return product_of_odd_digits", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "import math\nclass Interval:\n    \"\"\"Represents a closed integer interval.\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\n\n    def get_length(self) -> int:\n        \"\"\"Calculates the length of the interval (end - start).\"\"\"\n        # This calculation aligns with the problem's examples where length of (2,3) is 1.\n        return self.end - self.start\nclass PrimeNumberChecker:\n    \"\"\"Provides functionality to check if a number is prime.\"\"\"\n    @staticmethod\n    def is_prime(number: int) -> bool:\n        \"\"\"Checks if the given number is prime.\"\"\"\n        if number <= 1:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False\n        # Check for odd divisors from 3 up to the square root of the number.\n        for i in range(3, int(math.sqrt(number)) + 1, 2):\n            if number % i == 0:\n                return False\n        return True\ndef intersection(interval1, interval2):\n    \"\"\"\n    Determines whether the length of intersection of two intervals is a prime number.\n    Returns \"YES\" if the length is prime, otherwise \"NO\".\n    \"\"\"\n    s1, e1 = interval1\n    s2, e2 = interval2\n\n    # Calculate the start and end points of the intersection\n    max_start = max(s1, s2)\n    min_end = min(e1, e2)\n\n    # If max_start is greater than min_end, the intervals do not intersect.\n    # As per requirements, return \"NO\".\n    if max_start > min_end:\n        return \"NO\"\n\n    # Create an Interval object for the intersection\n    intersection_interval = Interval(max_start, min_end)\n    \n    # Calculate the length of the intersection\n    length = intersection_interval.get_length()\n\n    # Check if the calculated length is a prime number\n    if PrimeNumberChecker.is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/133": [{"task_id": "HumanEval/133", "solution": "import math\nfrom typing import List\nclass Number:\n    \"\"\"Represents a single numerical value and provides operations for rounding to ceiling and squaring.\n    \"\"\"\n    def __init__(self, value: float):\n        \"\"\"Initializes the Number with a given float value and pre-calculates its ceiling.\n        \"\"\"\n        self._value: float = value\n        self._rounded_value: int = math.ceil(value)\n\n    def get_rounded_value(self) -> int:\n        \"\"\"Returns the ceiling-rounded integer value.\n        \"\"\"\n        return self._rounded_value\n\n    def get_squared_value(self) -> int:\n        \"\"\"Returns the square of the ceiling-rounded integer value.\n        \"\"\"\n        return self._rounded_value ** 2\nclass NumberList:\n    \"\"\"Manages a collection of Number objects and orchestrates the calculation of the sum of their squared ceilings.\n    \"\"\"\n    def __init__(self, raw_numbers: List[float]):\n        \"\"\"Initializes the NumberList by converting raw float inputs into Number objects.\n        \"\"\"\n        self._numbers: List[Number] = [Number(num) for num in raw_numbers]\n\n    def calculate_sum_of_squared_ceilings(self) -> int:\n        \"\"\"Calculates the sum of squared ceiling values for all numbers in the list.\n        \"\"\"\n        total_sum: int = 0\n        for number_obj in self._numbers:\n            total_sum += number_obj.get_squared_value()\n        return total_sum\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    Examples:\n    For lst = [1,2,3] the output should be 14\n    For lst = [1,4,9] the output should be 98\n    For lst = [1,3,5,7] the output should be 84\n    For lst = [1.4,4.2,0] the output should be 29\n    For lst = [-2.4,1,1] the output should be 6\n    \"\"\"\n    number_list_processor = NumberList(lst)\n    return number_list_processor.calculate_sum_of_squared_ceilings()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/126": [{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n\n    Examples\n    is_sorted([5]) \u279e True\n    is_sorted([1, 2, 3, 4, 5]) \u279e True\n    is_sorted([1, 3, 2, 4, 5]) \u279e False\n    is_sorted([1, 2, 3, 4, 5, 6]) \u279e True\n    is_sorted([1, 2, 3, 4, 5, 6, 7]) \u279e True\n    is_sorted([1, 3, 2, 4, 5, 6, 7]) \u279e False\n    is_sorted([1, 2, 2, 3, 3, 4]) \u279e True\n    is_sorted([1, 2, 2, 2, 3, 4]) \u279e False\n    '''\n    # An empty list or a list with a single element is considered sorted\n    # and cannot violate the duplicate constraint.\n    if len(lst) <= 1:\n        return True\n\n    # Use a dictionary to count occurrences of each number.\n    counts = {}\n    \n    # Process the first element to initialize its count.\n    counts[lst[0]] = 1\n\n    # Iterate from the second element to check both sorting and duplicate constraints.\n    for i in range(1, len(lst)):\n        current_num = lst[i]\n        prev_num = lst[i-1]\n\n        # Check if the list is sorted in ascending order.\n        if current_num < prev_num:\n            return False\n\n        # Update the count for the current number.\n        counts[current_num] = counts.get(current_num, 0) + 1\n\n        # Check the duplicate constraint: if any number appears three or more times.\n        # \"More than 1 duplicate\" means a count of 3 or more occurrences.\n        if counts[current_num] >= 3:\n            return False\n\n    # If all checks pass after iterating through the list, it is sorted and\n    # does not violate the duplicate constraint.\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/132": [{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if a string containing only square brackets has a valid subsequence\n    where at least one bracket is nested.\n    \"\"\"\n    stack = []\n    nested_found = False\n\n    for char in string:\n        if char == '[':\n            stack.append(char)\n        elif char == ']':\n            if stack:\n                # If there is more than one opening bracket on the stack\n                # before popping, it means the current closing bracket\n                # is forming a pair nested within at least one other pair.\n                if len(stack) > 1:\n                    nested_found = True\n                    break\n                stack.pop() # Pop the matching opening bracket\n            # If stack is empty, this ']' is unmatched and doesn't contribute\n            # to a valid nested subsequence, so we ignore it.\n            # continue\n    return nested_found", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["[]]]]]]][[[[[]"]], "plus_fail_tests": [["[]][[]"]]}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "from typing import List, Tuple\nclass Cell:\n    \"\"\"\n    Represents a single cell within the grid, storing its value, row, and column.\n    Provides methods to access cell properties and find valid neighbors.\n    \"\"\"\n    def __init__(self, value: int, row: int, col: int):\n        self._value = value\n        self._row = row\n        self._col = col\n\n    def get_value(self) -> int:\n        return self._value\n\n    def get_row(self) -> int:\n        return self._row\n\n    def get_col(self) -> int:\n        return self._col\n\n    def get_neighbors(self, grid: 'Grid') -> List[Tuple[int, int]]:\n        \"\"\"\n        Returns a list of (row, col) coordinates for valid adjacent cells.\n        \"\"\"\n        neighbors = []\n        # Define directions: up, down, left, right\n        dr = [-1, 1, 0, 0]\n        dc = [0, 0, -1, 1]\n\n        for i in range(4):\n            new_row, new_col = self._row + dr[i], self._col + dc[i]\n            if grid.is_valid_coordinate(new_row, new_col):\n                neighbors.append((new_row, new_col))\n        return neighbors\nclass Grid:\n    \"\"\"\n    Manages the grid structure, provides access to cells, and validates coordinates.\n    Initializes Cell objects from raw grid values.\n    \"\"\"\n    def __init__(self, grid_values: List[List[int]]):\n        self._N = len(grid_values)\n        self._cells = [[None for _ in range(self._N)] for _ in range(self._N)]\n        for r in range(self._N):\n            for c in range(self._N):\n                self._cells[r][c] = Cell(grid_values[r][c], r, c)\n\n    def get_N(self) -> int:\n        return self._N\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        return self._cells[row][col]\n\n    def is_valid_coordinate(self, row: int, col: int) -> bool:\n        \"\"\"Checks if a given (row, col) is within the grid boundaries.\"\"\"\n        return 0 <= row < self._N and 0 <= col < self._N\nclass Path:\n    \"\"\"\n    Stores an ordered sequence of cell values and provides lexicographical comparison.\n    Supports adding/removing values for path construction and backtracking.\n    \"\"\"\n    def __init__(self, initial_values: List[int] = None):\n        self._cell_values = list(initial_values) if initial_values is not None else []\n\n    def add_cell_value(self, value: int):\n        self._cell_values.append(value)\n\n    def remove_last_value(self):\n        \"\"\"Removes the last cell value, used for backtracking in DFS.\"\"\"\n        if self._cell_values:\n            self._cell_values.pop()\n\n    def get_current_length(self) -> int:\n        return len(self._cell_values)\n\n    def get_values(self) -> List[int]:\n        \"\"\"Returns a copy of the ordered list of cell values.\"\"\"\n        return list(self._cell_values)\n\n    def is_lexicographically_less_than(self, other_path: 'Path') -> bool:\n        \"\"\"Compares this path with another lexicographically.\"\"\"\n        return self._cell_values < other_path.get_values()\ndef _find_min_path_recursive(grid_obj: Grid, k: int, current_row: int, current_col: int, current_path: Path, min_path_ref: List[Path]):\n    \"\"\"\n    Recursively explores paths of length k, updating the global minimum path found.\n    This function performs a Depth-First Search (DFS) from a given cell.\n    \"\"\"\n    # Base case: If the current path has reached the desired length k\n    if current_path.get_current_length() == k:\n        if min_path_ref[0] is None or current_path.is_lexicographically_less_than(min_path_ref[0]):\n            min_path_ref[0] = Path(current_path.get_values()) # Store a copy of the path\n        return\n\n    # If the path is not yet of length k, explore neighbors.\n    current_cell = grid_obj.get_cell(current_row, current_col)\n    for next_row, next_col in current_cell.get_neighbors(grid_obj):\n        next_cell_value = grid_obj.get_cell(next_row, next_col).get_value()\n        current_path.add_cell_value(next_cell_value) # Add neighbor to path\n        _find_min_path_recursive(grid_obj, k, next_row, next_col, current_path, min_path_ref)\n        current_path.remove_last_value() # Backtrack: remove last cell to explore other branches\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    finds the lexicographically minimum path of length k.\n    \"\"\"\n    _validate_input(grid, k)\n\n    grid_obj = Grid(grid)\n    N = grid_obj.get_N()\n\n    # min_path_ref is a mutable list holding the current best Path object.\n    # It's used to allow the recursive function to update a shared reference.\n    min_path_ref = [None] \n\n    # Iterate through all possible starting cells in the grid.\n    for r in range(N):\n        for c in range(N):\n            # Initialize a new path starting from the current cell.\n            # This path already has length 1.\n            initial_cell_value = grid_obj.get_cell(r, c).get_value()\n            current_path = Path([initial_cell_value])\n            \n            # Start the recursive depth-first search from this initial cell.\n            _find_min_path_recursive(grid_obj, k, r, c, current_path, min_path_ref)\n\n    # Return the values of the lexicographically smallest path found.\n    return min_path_ref[0].get_values()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 3]], "plus_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 1]]}], "HumanEval/135": [{"task_id": "HumanEval/135", "solution": "def can_arrange(arr: list) -> int:\n    \"\"\"Create a function which returns the largest index of an element which\n    is not greater than or equal to the element immediately preceding it. If\n    no such element exists then return -1. The given array will not contain\n    duplicate values.\n    \"\"\"\n    max_index = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            max_index = i\n    return max_index", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/136": [{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    '''\n    largest_negative = None\n    smallest_positive = None\n\n    for num in lst:\n        if num < 0:\n            if largest_negative is None or num > largest_negative:\n                largest_negative = num\n        elif num > 0:\n            if smallest_positive is None or num < smallest_positive:\n                smallest_positive = num\n\n    return (largest_negative, smallest_positive)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/134": [{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an alphabetical character\n    and is not part of a word (i.e., isolated or the only character).\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n    else:\n        preceding_char = txt[-2]\n        return preceding_char.isspace()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["apple pi\ne"]]}], "HumanEval/138": [{"task_id": "HumanEval/138", "solution": "class Number:\n    \"\"\"Encapsulates an integer value and provides property checks.\"\"\"\n    def __init__(self, n: int):\n        self._value = n\n\n    def is_positive(self) -> bool:\n        \"\"\"Returns True if the number is positive.\"\"\"\n        return self._value > 0\n\n    def is_even(self) -> bool:\n        \"\"\"Returns True if the number is even.\"\"\"\n        return self._value % 2 == 0\n\n    def get_value(self) -> int:\n        \"\"\"Returns the encapsulated integer value.\"\"\"\n        return self._value\ndef is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    num_obj = Number(n)\n    return num_obj.is_even() and num_obj.get_value() >= 8", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/137": [{"task_id": "HumanEval/137", "solution": "import dataclasses\nfrom typing import Any, Union\ndef _parse_input_value(value: Any) -> _ParsedValue:\n    \"\"\"Parses an input value (int, float, or str) into a _ParsedValue object.\"\"\"\n    original_type = type(value)\n    if isinstance(value, str):\n        # Handle both comma and period as decimal separators for strings\n        cleaned_value = value.replace(',', '.')\n        numerical_value = float(cleaned_value)\n    else:\n        numerical_value = float(value)\n    return _ParsedValue(original_value=value, original_type=original_type, numerical_value=numerical_value)\ndef compare_one(a, b):\n    \"\"\"\n    Compares two values (int, float, or str representing real numbers)\n    and returns the numerically larger variable in its original type, or None if equal.\n    \"\"\"\n    parsed_a = _parse_input_value(a)\n    parsed_b = _parse_input_value(b)\n\n    if parsed_a.numerical_value > parsed_b.numerical_value:\n        return parsed_a.original_value\n    elif parsed_b.numerical_value > parsed_a.numerical_value:\n        return parsed_b.original_value\n    else:\n        return None", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/140": [{"task_id": "HumanEval/140", "solution": "import re\nclass Text:\n    \"\"\"Encapsulates string content.\"\"\"\n    def __init__(self, content: str):\n        self.content = content\n\n    def get_content(self) -> str:\n        return self.content\nclass SpaceProcessor:\n    \"\"\"Applies space transformation rules.\"\"\"\n    def process(self, inputText: Text) -> Text:\n        original_content = inputText.get_content()\n\n        # Rule: Replace three or more consecutive spaces with a single hyphen.\n        # This must be done first to prevent shorter sequences from being processed incorrectly.\n        processed_content = re.sub(r' {3,}', '-', original_content)\n\n        # Rule: Replace two consecutive spaces with two underscores.\n        # This must be done before single spaces, but after 3+ spaces.\n        processed_content = processed_content.replace('  ', '__')\n\n        # Rule: Replace single spaces with single underscores.\n        processed_content = processed_content.replace(' ', '_')\n\n        return Text(processed_content)\ndef fix_spaces(text: str) -> str:\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    input_text_obj = Text(text)\n    processor = SpaceProcessor()\n    output_text_obj = processor.process(input_text_obj)\n    return output_text_obj.get_content()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/142": [{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for index, value in enumerate(lst):\n        if index % 3 == 0:\n            total_sum += value ** 2\n        elif index % 4 == 0: # This condition implicitly means index % 3 != 0\n            total_sum += value ** 3\n        else:\n            total_sum += value\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/141": [{"task_id": "HumanEval/141", "solution": "MAX_DIGITS = 3\nEXACT_DOTS = 1\nALLOWED_EXTENSIONS = {'txt', 'exe', 'dll'}\nclass FileName:\n    \"\"\"Stores the full file name and its parsed prefix and extension.\"\"\"\n    def __init__(self, name: str, prefix: str, extension: str):\n        self.name = name\n        self.prefix = prefix\n        self.extension = extension\nclass FileNameValidator:\n    \"\"\"Performs individual validation checks based on defined criteria.\"\"\"\n    @staticmethod\n    def _count_digits(text: str) -> int:\n        \"\"\"Counts digits in a string.\"\"\"\n        return sum(1 for char in text if '0' <= char <= '9')\n\n    @staticmethod\n    def _check_digit_count(file_name_str: str, max_digits: int) -> bool:\n        \"\"\"Validates the total digit count in the file name string.\"\"\"\n        return FileNameValidator._count_digits(file_name_str) <= max_digits\n\n    @staticmethod\n    def _check_prefix_not_empty(prefix: str) -> bool:\n        \"\"\"Checks if the file name prefix is not empty.\"\"\"\n        return bool(prefix)\n\n    @staticmethod\n    def _check_prefix_starts_with_letter(prefix: str) -> bool:\n        \"\"\"Checks if the file name prefix star