{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    if n <= 1:\n        raise ValueError(\"Input 'n' must be a positive integer greater than 1.\")\n\n    for i in range(n // 2, 0, -1):\n        if n % i == 0:\n            return i\n    return 1"}
{"task_id": "HumanEval/25", "solution": "def factorize(n: int) -> List[int]:\n    \"\"\"Return a list of prime factors for the given integer `n`, ordered from smallest to largest.\n    Each factor appears as many times as it divides `n`, and their product equals `n`.\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    if n < 2:\n        raise ValueError(\"Input number must be 2 or greater.\")\n\n    factors: List[int] = []\n    divisor = 2\n    temp_n = n\n\n    while divisor * divisor <= temp_n:\n        while temp_n % divisor == 0:\n            factors.append(divisor)\n            temp_n //= divisor\n        divisor += 1\n\n    if temp_n > 1:\n        factors.append(temp_n)\n\n    return factors"}
{"task_id": "HumanEval/26", "solution": "from typing import List\nfrom collections import Counter\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    # Count occurrences of each number in the input list.\n    counts = Counter(numbers)\n\n    # Build the result list, including only elements that appeared exactly once.\n    # The original relative order of elements is preserved.\n    result = [num for num in numbers if counts[num] == 1]\n    return result"}
{"task_id": "HumanEval/30", "solution": "def get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    return [num for num in l if num > 0]"}
{"task_id": "HumanEval/29", "solution": "def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    return [s for s in strings if s.startswith(prefix)]"}
{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    flipped_chars = []\n    for char in string:\n        if char.islower():\n            flipped_chars.append(char.upper())\n        elif char.isupper():\n            flipped_chars.append(char.lower())\n        else:\n            flipped_chars.append(char)\n    return \"\".join(flipped_chars)"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2 or n == 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    \n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    if not l:\n        raise ValueError(\"max_element() arg is an empty sequence\")\n    return max(l)"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    elements_to_sort = []\n    indices_to_sort = []\n    for i, item in enumerate(l):\n        if i % 3 == 0:\n            elements_to_sort.append(item)\n            indices_to_sort.append(i)\n    \n    elements_to_sort.sort()\n\n    result_list = list(l)\n\n    for i, sorted_item in zip(indices_to_sort, elements_to_sort):\n        result_list[i] = sorted_item\n\n    return result_list"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n    even_elements.sort()\n\n    result = l[:]\n    even_idx_counter = 0\n    for i in range(0, len(l), 2):\n        result[i] = even_elements[even_idx_counter]\n        even_idx_counter += 1\n    return result"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\"\"\"\n    total_sevens_count = 0\n    for i in range(1, n):\n        if i % 11 == 0 or i % 13 == 0:\n            total_sevens_count += str(i).count('7')\n    return total_sevens_count"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list.\"\"\"\n    return sorted(list(set(l)))"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    decoded_groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(decoded_groups)"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n    class FibonacciGenerator:\n        def generate_sequence(self) -> 'Iterator[int]':\n            \"\"\"Generates an infinite sequence of Fibonacci numbers starting from 1, 1, 2, 3, 5...\"\"\"\n            a, b = 1, 1\n            while True:\n                yield a\n                a, b = b, a + b\n\n    class PrimalityChecker:\n        def is_prime(self, num: int) -> bool:\n            \"\"\"Checks if a given number is prime.\"\"\"\n            if num < 2:\n                return False\n            for i in range(2, int(num**0.5) + 1):\n                if num % i == 0:\n                    return False\n            return True\n\n    class InvalidInputError(ValueError):\n        \"\"\"Custom exception for invalid input parameters.\"\"\"\n        pass\n\n    class PrimeFibService:\n        def __init__(self, fib_generator: FibonacciGenerator, prime_checker: PrimalityChecker):\n            self._fib_generator = fib_generator\n            self._prime_checker = prime_checker\n\n        def find_nth_prime_fib(self, n: int) -> int:\n            \"\"\"Calculates and returns the n-th number that is both a Fibonacci number and a prime.\"\"\"\n            if n <= 0:\n                raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n            prime_fib_count = 0\n            for fib_num in self._fib_generator.generate_sequence():\n                if self._prime_checker.is_prime(fib_num):\n                    prime_fib_count += 1\n                    if prime_fib_count == n:\n                        return fib_num\n\n    # Instantiate dependencies\n    fib_gen = FibonacciGenerator()\n    prime_checker = PrimalityChecker()\n    service = PrimeFibService(fib_gen, prime_checker)\n\n    # Call the service method\n    return service.find_nth_prime_fib(n)"}
