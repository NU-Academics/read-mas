{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given total fruits and a string\n    describing apples and oranges.\n    \"\"\"\n    pattern = re.compile(r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\")\n    match = pattern.match(s)\n    \n    # Per constraints, assume valid input format; no explicit error handling for mismatch.\n    apples = int(match.group(1))\n    oranges = int(match.group(2))\n    \n    mangoes = n - apples - oranges\n    return mangoes"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts the number of vowels in a string, considering 'y' as a vowel only at the end.\n    Vowels are 'a', 'e', 'i', 'o', 'u' (case-insensitive).\n    \"\"\"\n    if not s:\n        return 0\n\n    count = 0\n    s_lower = s.lower()\n    \n    STANDARD_VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    # Iterate through all characters except the last one for standard vowels\n    for char in s_lower[:-1]:\n        if char in STANDARD_VOWELS:\n            count += 1\n\n    # Check the last character for both standard vowels and conditional 'y'\n    last_char = s_lower[-1]\n    if last_char == 'y':\n        count += 1\n    elif last_char in STANDARD_VOWELS:\n        count += 1\n\n    return count"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even value and its index in the array.\n    If multiple nodes have the same smallest even value, the one with the smallest index is returned.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            elif value == smallest_even_value:\n                # If values are equal, choose the one with the smallest index\n                if i < smallest_even_index:\n                    smallest_even_index = i\n\n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/69", "solution": "import collections\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    '''\n    frequencies = collections.Counter(lst)\n    \n    qualifying_integers = []\n    for num, freq in frequencies.items():\n        if freq >= num:\n            qualifying_integers.append(num)\n    \n    if not qualifying_integers:\n        return -1\n    \n    return max(qualifying_integers)"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string. If shift > number of digits, return digits reversed.\n    \"\"\"\n    digits = list(str(x))\n    num_digits = len(digits)\n\n    if num_digits == 0:\n        return \"\"\n\n    if shift > num_digits:\n        # As per requirement, if shift > number of digits, reverse\n        result_digits = digits[::-1]\n    else:\n        # Perform circular right shift\n        actual_shift = shift % num_digits\n        result_digits = digits[-actual_shift:] + digits[:-actual_shift]\n\n    return \"\".join(result_digits)"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"The FibFib sequence is defined by fibfib(0)=0, fibfib(1)=0, fibfib(2)=1, and fibfib(n) = fibfib(n-1) + fibfib(n-2) + fibfib(n-3). This function efficiently computes the n-th element using memoization.\"\"\"\n\n    class InvalidInputError(ValueError):\n        \"\"\"Custom exception for invalid input.\"\"\"\n        pass\n\n    if not hasattr(fibfib, '_cache'):\n        fibfib._cache = {\n            0: 0,\n            1: 0,\n            2: 1\n        }\n\n    if n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n\n    if n in fibfib._cache:\n        return fibfib._cache[n]\n\n    result = (\n        fibfib(n - 1) +\n        fibfib(n - 2) +\n        fibfib(n - 3)\n    )\n    fibfib._cache[n] = result\n    return result"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    This order alternates between the minimum and maximum of the remaining elements.\n    Examples:\n    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]\n    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]\n    strange_sort_list([]) == []\n    '''\n    if not lst:\n        return []\n\n    sorted_list = sorted(lst)\n    result = []\n    left = 0\n    right = len(sorted_list) - 1\n\n    while left <= right:\n        # Append the current minimum value.\n        result.append(sorted_list[left])\n        left += 1\n        if left > right:\n            break\n\n        # Append the current maximum value.\n        result.append(sorted_list[right])\n        right -= 1\n    return result"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"\n    Checks if object q will fly based on palindromic balance and weight constraint.\n    Returns True if q is a palindrome and its sum is less than or equal to w, False otherwise.\n    \"\"\"\n    is_balanced = (q == q[::-1])\n    \n    if not is_balanced:\n        return False\n        \n    total_weight = sum(q)\n    \n    return total_weight <= w"}
