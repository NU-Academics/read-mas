{"task_id": "HumanEval/147", "solution": "import math\ndef get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    count_rem_0 = 0\n    count_rem_1 = 0\n\n    # Analyze the remainder of a[x] when divided by 3 based on x:\n    # a[x] = x * x - x + 1 = x * (x - 1) + 1\n    # If x % 3 == 0 or x % 3 == 1, then x * (x - 1) is a multiple of 3, so a[x] % 3 == 1.\n    # If x % 3 == 2, then x * (x - 1) % 3 is 2 * 1 = 2, so a[x] % 3 == 2 + 1 = 0.\n    for x in range(1, n + 1):\n        if x % 3 == 2:\n            count_rem_0 += 1\n        else: # x % 3 == 0 or x % 3 == 1\n            count_rem_1 += 1\n\n    # Define combinations function inline as per instructions.\n    def combinations(n_val, k_val):\n        if k_val < 0 or k_val > n_val:\n            return 0\n        # Use math.comb for efficient calculation as per design context.\n        return math.comb(n_val, k_val)\n\n    # A sum (a[i] + a[j] + a[k]) is a multiple of 3 if the sum of their remainders is 0 mod 3.\n    # Since a[x] % 3 can only be 0 or 1, the only valid combinations of remainders are (0, 0, 0) and (1, 1, 1).\n    combinations_000 = combinations(count_rem_0, 3)\n    combinations_111 = combinations(count_rem_1, 3)\n\n    return combinations_000 + combinations_111"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0  \n   \n    If the input list is empty, return 0.\n    '''\n    if not lst:\n        return 0\n\n    total_sum_of_squares = 0\n    for item in lst:\n        # Check if the item is an integer, positive, and odd.\n        if isinstance(item, int) and item > 0 and item % 2 != 0:\n            total_sum_of_squares += item * item\n            \n    return total_sum_of_squares"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n    \"\"\"\n    import math\n\n    class Fraction:\n        \"\"\"Represents a mathematical fraction with a numerator and a denominator.\"\"\"\n        def __init__(self, numerator: int, denominator: int):\n            self._numerator = numerator\n            self._denominator = denominator\n\n        @property\n        def numerator(self) -> int:\n            return self._numerator\n\n        @property\n        def denominator(self) -> int:\n            return self._denominator\n\n    class FractionService:\n        \"\"\"Provides core business logic for fraction operations.\"\"\"\n        def parse_fraction(self, fraction_str: str) -> 'Fraction':\n            parts = fraction_str.split('/')\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n            return Fraction(numerator, denominator)\n\n        def multiply_fractions(self, f1: 'Fraction', f2: 'Fraction') -> 'Fraction':\n            new_numerator = f1.numerator * f2.numerator\n            new_denominator = f1.denominator * f2.denominator\n            return Fraction(new_numerator, new_denominator)\n\n        def is_whole_number(self, f: 'Fraction') -> bool:\n            common_divisor = math.gcd(f.numerator, f.denominator)\n            simplified_denominator = f.denominator // common_divisor\n            return simplified_denominator == 1\n\n    fraction_service = FractionService()\n\n    fraction_x = fraction_service.parse_fraction(x)\n    fraction_n = fraction_service.parse_fraction(n)\n\n    product_fraction = fraction_service.multiply_fractions(fraction_x, fraction_n)\n\n    return fraction_service.is_whole_number(product_fraction)"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\"\"\"\n    if not b:\n        return \"\" in a\n\n    rotations = set()\n    n = len(b)\n    for i in range(n):\n        rotated_b = b[i:] + b[:i]\n        rotations.add(rotated_b)\n    \n    for rotation in rotations:\n        if rotation in a:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Convert the absolute value of the number to a string to iterate through digits.\n    s_num = str(abs(num))\n\n    for digit_char in s_num:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/153", "solution": "class Extension:\n    \"\"\"\n    A data class to represent an extension with its calculated properties.\n    \"\"\"\n    def __init__(self, name: str, cap_count: int, sm_count: int, strength: int):\n        self.name = name\n        self.cap_count = cap_count\n        self.sm_count = sm_count\n        self.strength = strength\nclass ExtensionStrengthCalculator:\n    \"\"\"\n    Calculates the strength of an extension based on uppercase and lowercase letters.\n    \"\"\"\n    def calculate_strength(self, extension_name: str) -> int:\n        cap_count = self._count_caps(extension_name)\n        sm_count = self._count_sms(extension_name)\n        return cap_count - sm_count\n\n    def _count_caps(self, s: str) -> int:\n        return sum(1 for char in s if 'A' <= char <= 'Z')\n\n    def _count_sms(self, s: str) -> int:\n        return sum(1 for char in s if 'a' <= char <= 'z')\nclass StrongestExtensionFinder:\n    \"\"\"\n    Finds the strongest extension from a list and formats the output.\n    \"\"\"\n    def __init__(self, calculator: ExtensionStrengthCalculator):\n        self._calculator = calculator\n\n    def find(self, class_name: str, extensions: list[str]) -> str:\n        extension_objects: list[Extension] = []\n        for ext_name in extensions:\n            strength = self._calculator.calculate_strength(ext_name)\n            # cap_count and sm_count are not directly used in comparison logic,\n            # so they are passed as 0 as placeholders for this specific problem.\n            extension_objects.append(Extension(ext_name, 0, 0, strength))\n\n        strongest_ext_name = self._find_strongest_extension_name(extension_objects)\n        return f\"{class_name}.{strongest_ext_name}\"\n\n    def _find_strongest_extension_name(self, extensions: list[Extension]) -> str:\n        # Assumes extensions list is not empty based on problem constraints.\n        strongest_extension = extensions[0]\n        for ext in extensions[1:]:\n            if ext.strength > strongest_extension.strength:\n                strongest_extension = ext\n        return strongest_extension.name\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on CAP - SM calculation and returns\n    a formatted string: ClassName.StrongestExtensionName.\n    \"\"\"\n    calculator = ExtensionStrengthCalculator()\n    finder = StrongestExtensionFinder(calculator)\n    return finder.find(class_name, extensions)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    result = []\n    for value, symbol in roman_map:\n        while number >= value:\n            result.append(symbol)\n            number -= value\n    return \"\".join(result).lower()"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    epsilon = 1e-9 # Tolerance for floating-point comparisons\n\n    # Calculate squares of the sides\n    a_sq = a * a\n    b_sq = b * b\n    c_sq = c * c\n\n    # Sort the squared sides to easily identify the two shorter sides and the longest side\n    sides_squared = sorted([a_sq, b_sq, c_sq])\n    \n    # Check if the sum of squares of the two shorter sides equals the square of the longest side\n    return abs(sides_squared[0] + sides_squared[1] - sides_squared[2]) < epsilon"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Returns the word with the maximum number of unique characters.\n    If there's a tie, the lexicographically smallest word is returned.\"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: return the one which comes first in lexicographical order\n            if word < result_word:\n                result_word = word\n    return result_word"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and remaining after a rabbit's meal.\n    The rabbit eats the minimum of what it needs and what is available.\n    \"\"\"\n    carrots_to_eat = min(need, remaining)\n    total_eaten = number + carrots_to_eat\n    carrots_left = remaining - carrots_to_eat\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n    \n    even_numbers = []\n    for num in range(min_val, max_val + 1):\n        if num % 2 == 0:\n            even_numbers.append(num)\n    return even_numbers"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Constructs an algebraic expression from given operators and operands and returns its evaluation.\n    This function assumes valid inputs as described in the problem notes.\n    \"\"\"\n    expression_parts = []\n    for i in range(len(operand)):\n        expression_parts.append(str(operand[i]))\n        if i < len(operator):\n            expression_parts.append(operator[i])\n    \n    expression_string = \" \".join(expression_parts)\n    return eval(expression_string)"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    # Compute the MD5 hash of the string, encoded in UTF-8.\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if not has_letters:\n        return s[::-1]\n    else:\n        transformed_chars = []\n        for char in s:\n            if char.isalpha():\n                transformed_chars.append(char.swapcase())\n            else:\n                transformed_chars.append(char)\n        return \"\".join(transformed_chars)"}
