{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if 'sub_list' is a contiguous sublist within 'main_list'.\n    Returns True if 'sub_list' is found, False otherwise.\n    \"\"\"\n    n = len(main_list)\n    m = len(sub_list)\n\n    if m == 0:\n        return True\n\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        if main_list[i : i + m] == sub_list:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(input_array: list) -> bool:\n    \"\"\"\n    Determines if the given array is monotonic.\n    An array is monotonic if it is either monotonically increasing or\n    monotonically decreasing.\n    \"\"\"\n    if len(input_array) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(input_array) - 1):\n        if input_array[i] > input_array[i+1]:\n            is_increasing = False\n        if input_array[i] < input_array[i+1]:\n            is_decreasing = False\n\n    return is_increasing or is_decreasing"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the Bell number B(n) for a non-negative integer n.\n    B(n) is the number of ways to partition a set of n elements into non-empty subsets.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n    if n == 0:\n        return 1\n\n    # Using dynamic programming for Stirling numbers of the second kind\n    # S[i][j] stores Stirling number of second kind S(i, j)\n    S = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Base cases\n    S[0][0] = 1\n\n    for i in range(1, n + 1):\n        S[i][0] = 0 # S(i, 0) = 0 for i > 0\n        for j in range(1, i + 1):\n            if i == j:\n                S[i][j] = 1 # S(i, i) = 1\n            else:\n                S[i][j] = S[i-1][j-1] + j * S[i-1][j]\n\n    # Bell number B(n) is the sum of S(n, k) for k from 0 to n\n    bell_n = 0\n    for k in range(n + 1):\n        bell_n += S[n][k]\n\n    return bell_n"}
