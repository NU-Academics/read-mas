{"task_id": "Mbpp/119", "solution": "def search(arr: list) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear exactly twice.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n\n    while low < high:\n        mid = low + (high - low) // 2\n\n        # If mid is even, check arr[mid] with arr[mid+1]\n        # If mid is odd, check arr[mid] with arr[mid-1]\n        if mid % 2 == 0:  # mid is even\n            if arr[mid] == arr[mid + 1]:\n                # Pair found, unique element is to the right\n                low = mid + 2\n            else:\n                # Pair broken, unique element is at or to the left of mid\n                high = mid\n        else:  # mid is odd\n            if arr[mid] == arr[mid - 1]:\n                # Pair found, unique element is to the right\n                low = mid + 1\n            else:\n                # Pair broken, unique element is at or to the left of mid\n                high = mid\n    \n    return arr[low]"}
{"task_id": "Mbpp/120", "solution": "from typing import List, Tuple, Union\ndef max_product_tuple(list_of_tuples: list[tuple[Union[int, float], Union[int, float]]]) -> int:\n    \"\"\"Calculates the maximum absolute product from a list of numerical tuples.\n    It iterates through each tuple, calculates the absolute product of its elements, and keeps track of the maximum.\n    \"\"\"\n    max_abs_product = 0\n\n    for num1, num2 in list_of_tuples:\n        product = num1 * num2\n        absolute_product = abs(product)\n        max_abs_product = max(max_abs_product, absolute_product)\n\n    return int(max_abs_product)"}
