{"task_id": "Mbpp/61", "solution": "def count_Substrings(input_string: str) -> int:\n    \"\"\"\n    Counts substrings where the sum of their digits equals their length.\n    Iterates through all substrings and checks the condition.\n    \"\"\"\n    total_count = 0\n    n = len(input_string)\n\n    for i in range(n):\n        current_sum_of_digits = 0\n        for j in range(i, n):\n            # Extract current digit and update sum\n            current_sum_of_digits += int(input_string[j])\n            \n            # Calculate substring length\n            substring_length = (j - i) + 1\n\n            # Compare sum of digits with length\n            if current_sum_of_digits == substring_length:\n                total_count += 1\n    return total_count"}
{"task_id": "Mbpp/57", "solution": "import functools\ndef find_Max_Num(digits: list[int]) -> int:\n    \"\"\"\n    Finds the largest number that can be formed with the given list of digits.\n    The core logic involves a custom sorting algorithm to arrange digits as strings.\n    \"\"\"\n    if not digits:\n        return 0\n\n    str_digits = [str(d) for d in digits]\n\n    # Custom comparison logic: compare (b+a) with (a+b) to decide order\n    # If 'ba' > 'ab', then b should come before a for the largest number.\n    def compare_digits_for_largest_number(a: str, b: str) -> int:\n        if int(b + a) > int(a + b):\n            return 1\n        elif int(b + a) < int(a + b):\n            return -1\n        else:\n            return 0\n\n    str_digits.sort(key=functools.cmp_to_key(compare_digits_for_largest_number), reverse=True)\n\n    largest_num_str = \"\".join(str_digits)\n\n    # Handle cases like [0, 0, 0] or [0, 1] which should result in 0\n    if largest_num_str.startswith('0') and len(largest_num_str) > 1:\n        return 0\n\n    return int(largest_num_str)"}
