{"task_id": "Mbpp/12", "solution": "from typing import List\nclass Row:\n    \"\"\"Represents a single row within a matrix, providing its elements and sum.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        if not isinstance(elements, list) or not all(isinstance(e, int) for e in elements):\n            raise ValueError(\"Row elements must be a list of integers.\")\n        self._elements: List[int] = list(elements)\n        self._sum: int = sum(self._elements)\n\n    def get_elements(self) -> List[int]:\n        \"\"\"Returns the elements of the row.\"\"\"\n        return list(self._elements)\n\n    def get_sum(self) -> int:\n        \"\"\"Returns the sum of the row's elements.\"\"\"\n        return self._sum\n\n    def __lt__(self, other: 'Row') -> bool:\n        \"\"\"Enables comparison for sorting based on row sum.\"\"\"\n        if not isinstance(other, Row):\n            return NotImplemented\n        return self.get_sum() < other.get_sum()\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"Enables equality comparison based on elements and sum.\"\"\"\n        if not isinstance(other, Row):\n            return NotImplemented\n        return self.get_elements() == other.get_elements() and self.get_sum() == other.get_sum()\n\n    def __repr__(self) -> str:\n        return f\"Row({self._elements})\"\nclass Matrix:\n    \"\"\"Encapsulates a collection of Row objects and provides matrix-level operations.\"\"\"\n    def __init__(self, raw_matrix: List[List[int]]) -> None:\n        if not isinstance(raw_matrix, list) or not raw_matrix:\n            raise ValueError(\"Input matrix must be a non-empty list of lists.\")\n        self._rows: List[Row] = []\n        for r in raw_matrix:\n            try:\n                self._rows.append(Row(r))\n            except ValueError as e:\n                raise ValueError(f\"Invalid row in matrix: {r}. {e}\")\n\n    def get_rows(self) -> List[Row]:\n        \"\"\"Returns the internal list of Row objects.\"\"\"\n        return list(self._rows)\n\n    def sort_by_row_sum(self) -> 'Matrix':\n        \"\"\"Sorts the rows by their sums in ascending order (stable sort) and returns a new sorted Matrix.\"\"\"\n        sorted_rows = sorted(self._rows)\n        sorted_raw_matrix = [row.get_elements() for row in sorted_rows]\n        return Matrix(sorted_raw_matrix)\n\n    def to_list(self) -> List[List[int]]:\n        \"\"\"Converts the Matrix object back to a list of lists of integers.\"\"\"\n        return [row.get_elements() for row in self._rows]\n\n    def __repr__(self) -> str:\n        return f\"Matrix({self.to_list()})\"\ndef sort_matrix(matrix: List[List[int]]) -> List[List[int]]:\n    \"\"\"\n    Sorts a given matrix in ascending order according to the sum of its rows.\n    \"\"\"\n    try:\n        matrix_obj = Matrix(matrix)\n        sorted_matrix_obj = matrix_obj.sort_by_row_sum()\n        return sorted_matrix_obj.to_list()\n    except ValueError as e:\n        raise ValueError(f\"Invalid input for sort_matrix: {e}\") from e"}
