{"task_id": "Mbpp/603", "solution": "def get_ludic(limit: int) -> list[int]:\n    \"\"\"\n    Calculates and returns all ludic numbers less than or equal to the given limit.\n\n    Args:\n        limit (int): The upper bound (inclusive) for ludic number generation.\n\n    Returns:\n        list[int]: A list of ludic numbers up to the specified limit.\n    \"\"\"\n    if limit < 1:\n        return []\n\n    # Initialize candidates with numbers from 1 to limit.\n    candidates = list(range(1, limit + 1))\n    ludic_numbers = []\n\n    while candidates:\n        p = candidates[0]\n        ludic_numbers.append(p)\n\n        if len(candidates) == 1:\n            break\n\n        next_candidates = []\n        count = 0\n        for i in range(1, len(candidates)):\n            count += 1\n            # Keep numbers whose 1-based index (in the remaining candidates) is not a multiple of p.\n            if count % p != 0:\n                next_candidates.append(candidates[i])\n        candidates = next_candidates\n\n    return ludic_numbers"}
{"task_id": "Mbpp/605", "solution": "def prime_num(number: int) -> bool:\n    \"\"\"\n    Determines if the given integer is a prime number.\n    Returns True if the number is prime, False otherwise.\n    \"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n\n    # Check for divisors from 3 up to the square root of the number, incrementing by 2\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n\n    return True"}
