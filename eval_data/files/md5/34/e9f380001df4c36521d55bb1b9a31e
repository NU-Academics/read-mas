{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Removes consecutive duplicate elements from a list, preserving the order of the first occurrence.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n    for i in range(1, len(input_list)):\n        if input_list[i] != input_list[i-1]:\n            result.append(input_list[i])\n    return result"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array: list[int | float], target: int | float) -> int:\n    \"\"\"\n    Finds the 0-based index of the first occurrence of a target number in a sorted array.\n    Uses a modified binary search to achieve O(log N) time complexity.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            result = mid\n            high = mid - 1  # Move to the left to find the first occurrence\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/736", "solution": "import typing\ndef left_insertion(sorted_list: typing.List[typing.Union[int, float]], value: typing.Union[int, float]) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in sorted order.\n    Uses a binary search algorithm to find the correct insertion index.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(input_integer: int) -> int:\n    \"\"\"Toggles all bits of the input_integer except the most significant bit (MSB) and the least significant bit (LSB).\"\"\"\n    if input_integer < 0:\n        raise ValueError(\"Input integer must be non-negative.\")\n    if input_integer == 0:\n        return 0\n\n    binary_str = bin(input_integer)[2:]\n    num_bits = len(binary_str)\n\n    # Numbers with 0, 1, or 2 bits have no 'middle' bits to toggle.\n    if num_bits <= 2:\n        return input_integer\n\n    # Construct a mask with 1s for all bits between MSB and LSB.\n    # For num_bits = 4 (e.g., 0b1001), mask should be 0b0110.\n    # ((1 << (num_bits - 1)) - 1) creates 0b0111. XORing with 1 (0b0001) clears the LSB.\n    middle_bits_mask = ((1 << (num_bits - 1)) - 1) ^ 1\n\n    # Toggle the middle bits using XOR operation.\n    result = input_integer ^ middle_bits_mask\n    return result"}
{"task_id": "Mbpp/737", "solution": "import re\ndef check_str(input_string: str) -> bool:\n    \"\"\"\n    Determines if the input_string begins with a vowel (a, e, i, o, u, case-insensitive).\n    Utilizes regular expressions for checking.\n    \"\"\"\n    pattern = r\"^[aeiou]\"\n    return re.match(pattern, input_string, re.IGNORECASE) is not None"}
{"task_id": "Mbpp/739", "solution": "def find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    Iteratively calculates triangular numbers and checks their digit count.\n    \"\"\"\n    def _calculate_triangular_number(k: int) -> int:\n        \"\"\"Calculates the k-th triangular number using the formula T_k = k * (k + 1) / 2.\"\"\"\n        return k * (k + 1) // 2\n\n    def _count_digits(number: int) -> int:\n        \"\"\"Counts the number of decimal digits in a given integer.\"\"\"\n        if number == 0:\n            return 1\n        count = 0\n        temp = abs(number)\n        while temp > 0:\n            temp //= 10\n            count += 1\n        return count\n\n    k = 1\n    while True:\n        triangular_num = _calculate_triangular_number(k)\n        num_digits = _count_digits(triangular_num)\n        if num_digits == n:\n            return k\n        k += 1"}
