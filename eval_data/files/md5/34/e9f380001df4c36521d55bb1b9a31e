{"task_id": "Mbpp/123", "solution": "import math\ndef sum_proper_divisors(n: int) -> int:\n    \"\"\"Calculates the sum of proper divisors for a given positive integer n.\"\"\"\n    if n <= 1:\n        return 0\n    total = 1\n    for i in range(2, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            total += i\n            if i * i != n:\n                total += (n // i)\n    return total\ndef is_amicable_pair(a: int, b: int) -> bool:\n    \"\"\"Determines if two distinct positive integers a and b form an amicable pair.\"\"\"\n    if a == b:\n        return False\n    return sum_proper_divisors(a) == b and sum_proper_divisors(b) == a\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Calculates the sum of all amicable numbers from 1 to a specified limit.\n    It uses helper functions to find proper divisor sums and identify amicable pairs.\n    \"\"\"\n    total_sum = 0\n    found_amicable_numbers = set()\n\n    for a in range(1, limit + 1):\n        if a in found_amicable_numbers:\n            continue\n\n        d_a = sum_proper_divisors(a)\n\n        if d_a > a and d_a <= limit:\n            if is_amicable_pair(a, d_a):\n                total_sum += a\n                total_sum += d_a\n                found_amicable_numbers.add(a)\n                found_amicable_numbers.add(d_a)\n    return total_sum"}
{"task_id": "Mbpp/126", "solution": "def sum_common_divisors(num1: int, num2: int) -> int:\n    \"\"\"\n    Finds the sum of common divisors of two given numbers.\n    This function orchestrates helper functions to achieve the result.\n    \"\"\"\n\n    def _get_divisors(num: int) -> set[int]:\n        \"\"\"\n        Calculates all positive divisors for a given integer.\n        Returns a set of these divisors.\n        \"\"\"\n        divs = set()\n        for i in range(1, num + 1):\n            if num % i == 0:\n                divs.add(i)\n        return divs\n\n    def _find_common_divisors(divisors1: set[int], divisors2: set[int]) -> set[int]:\n        \"\"\"\n        Identifies the common elements between two sets of divisors.\n        Returns a set containing only the common divisors.\n        \"\"\"\n        return divisors1.intersection(divisors2)\n\n    def _sum_set_elements(numbers: set[int]) -> int:\n        \"\"\"\n        Calculates the sum of all integer elements within a set.\n        Returns the total sum of the elements.\n        \"\"\"\n        return sum(numbers)\n\n    divisors1_set = _get_divisors(num1)\n    divisors2_set = _get_divisors(num2)\n\n    common_divisors_set = _find_common_divisors(divisors1_set, divisors2_set)\n\n    total_sum = _sum_set_elements(common_divisors_set)\n\n    return total_sum"}
