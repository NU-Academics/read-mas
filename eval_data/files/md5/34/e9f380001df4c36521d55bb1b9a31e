{"task_id": "Mbpp/3", "solution": "import math\ndef is_not_prime(number: int) -> bool:\n    \"\"\"\n    Identifies if a given number is non-prime (composite).\n    Returns True for non-prime numbers, False for prime numbers or numbers less than or equal to 1.\n    \"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return False\n    if number % 2 == 0:\n        return True\n\n    for i in range(3, math.isqrt(number) + 1, 2):\n        if number % i == 0:\n            return True\n\n    return False"}
{"task_id": "Mbpp/7", "solution": "def find_char_long(input_string: str) -> set[str]:\n    \"\"\"Finds all words at least 4 characters long in the given string.\"\"\"\n\n    def _extract_words(text: str) -> list[str]:\n        \"\"\"Extracts individual words from the text, using spaces as delimiters.\"\"\"\n        # Simple split by space; additional punctuation handling could be added if required by a broader spec\n        return text.split()\n\n    def _filter_long_words(words: list[str], min_length: int) -> set[str]:\n        \"\"\"Filters a list of words, returning only those at least min_length characters long.\"\"\"\n        return {word for word in words if len(word) >= min_length}\n\n    list_of_words = _extract_words(input_string)\n    set_of_filtered_words = _filter_long_words(list_of_words, 4)\n    return set_of_filtered_words"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List\ndef heap_queue_largest(numbers: List[int], n: int) -> List[int]:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers and returns them in descending order.\n    Handles edge cases for n <= 0 or an empty list.\n    \"\"\"\n    if n <= 0 or not numbers:\n        return []\n\n    return heapq.nlargest(n, numbers)"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(list1: list, list2: list) -> set:\n    \"\"\"Finds the shared elements from the given two lists.\n\n    Returns a set containing only the unique shared elements.\n    \"\"\"\n    set1 = set(list1)\n    set2 = set(list2)\n    return set1.intersection(set2)"}
{"task_id": "Mbpp/8", "solution": "def square_nums(numbers: list[int | float]) -> list[int | float]:\n    \"\"\"Calculates the square of each individual element in a list.\n\n    Returns a new list containing the squared values of the input elements.\"\"\"\n    squared_numbers = []\n    for num in numbers:\n        squared_numbers.append(num * num)\n    return squared_numbers"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1, num2):\n    \"\"\"\n    Checks if two integer numbers differ at exactly one bit position.\n    Uses XOR and Brian Kernighan's algorithm to count set bits.\n    \"\"\"\n    xor_result = num1 ^ num2\n    count = 0\n    while xor_result > 0:\n        xor_result &= (xor_result - 1)\n        count += 1\n    return count == 1"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(input_string: str) -> int:\n    \"\"\"\n    Calculates the minimum number of rotations (greater than 0) for a string to return to its original form.\n    This is equivalent to finding the length of the smallest repeating unit within the string.\n    \"\"\"\n    n = len(input_string)\n    if n == 0:\n        return 0\n\n    # The smallest number of rotations corresponds to the length of the smallest repeating substring.\n    # We can check for repeating units of increasing length.\n    for i in range(1, n + 1):\n        if n % i == 0:  # If i is a divisor of n, it could be a repeating unit length\n            # Check if the string is formed by repeating the first 'i' characters\n            if input_string == input_string[:i] * (n // i):\n                return i\n    return n"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, char_to_remove: str) -> str:\n    \"\"\"\n    Removes the first and last occurrences of a specified character from a string.\n    Handles cases where the character is not found, found once, or multiple times.\n    \"\"\"\n    first_idx = input_string.find(char_to_remove)\n    if first_idx == -1:\n        return input_string\n\n    last_idx = input_string.rfind(char_to_remove)\n\n    if first_idx == last_idx:\n        # Character found only once\n        return input_string[:first_idx] + input_string[first_idx + 1:]\n    else:\n        # Character found multiple times, remove both first and last\n        result = input_string[:first_idx] + input_string[first_idx + 1:last_idx] + input_string[last_idx + 1:]\n        return result"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base: float, height: float, length: float) -> float:\n    \"\"\"\n    Calculates the volume of a triangular prism.\n    The volume is calculated using the formula: (0.5 * base * height) * length.\n    \"\"\"\n    volume = 0.5 * base * height * length\n    return volume"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number.\n    A Woodall number is an integer of the form n * 2^n - 1 for some non-negative integer n.\n    \"\"\"\n    if number < -1:\n        return False\n    n = 0\n    while True:\n        woodall_candidate = n * (2**n) - 1\n        if woodall_candidate == number:\n            return True\n        if woodall_candidate > number:\n            return False\n        n += 1"}
