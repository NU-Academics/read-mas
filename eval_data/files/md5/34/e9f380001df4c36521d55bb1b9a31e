{"task_id": "Mbpp/137", "solution": "def zero_count(array_of_integers: list[int]) -> float:\n    \"\"\"Calculates the ratio of zero elements to non-zero elements in an array.\"\"\"\n    zeroes = 0\n    non_zeroes = 0\n    for element in array_of_integers:\n        if element == 0:\n            zeroes += 1\n        else:\n            non_zeroes += 1\n\n    if non_zeroes == 0:\n        return 0.0\n    else:\n        return float(zeroes) / non_zeroes"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1: list, list2: list, list3: list) -> int:\n    \"\"\"\n    Counts the number of positions where items are identical across three given lists.\n    Compares items up to the length of the shortest list.\n    \"\"\"\n    min_length = min(len(list1), len(list2), len(list3))\n    count = 0\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/139", "solution": "import math\ndef circle_circumference(radius: float) -> float:\n    \"\"\"\n    Calculates the circumference of a circle.\n    Raises ValueError if the radius is negative.\n    \"\"\"\n    if radius < 0:\n        raise ValueError(\"Radius cannot be negative.\")\n    return 2 * math.pi * radius"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"Returns integers x and y that satisfy ax + by = n as a tuple, or None if no solution exists.\"\"\"\n\n    def extended_gcd(a: int, b: int) -> tuple[int, int, int]:\n        \"\"\"Computes gcd(a, b) and coefficients x, y such that ax + by = gcd(a, b).\"\"\"\n        if b == 0:\n            return a, 1, 0\n        gcd_val, x1, y1 = extended_gcd(b, a % b)\n        x = y1\n        y = x1 - (a // b) * y1\n        return gcd_val, x, y\n\n    # Handle the case where a and b are both zero\n    if a == 0 and b == 0:\n        if n == 0:\n            return (0, 0) # Any (x,y) is a solution for 0x + 0y = 0\n        else:\n            return None   # No solution for 0x + 0y = n (n != 0)\n\n    gcd_val, x0, y0 = extended_gcd(a, b)\n\n    if n % gcd_val != 0:\n        return None  # No integer solution if n is not divisible by gcd(a, b)\n    else:\n        # Scale the Bezout coefficients to find a particular solution for ax + by = n\n        k = n // gcd_val\n        x = x0 * k\n        y = y0 * k\n        return (x, y)"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(list1: list, list2: list) -> list:\n    \"\"\"Removes all elements from list1 that are present in list2.\n    Returns a new list containing elements from list1 not present in list2.\"\"\"\n    elements_to_remove_set = set(list2)\n    result_list = [element for element in list1 if element not in elements_to_remove_set]\n    return result_list"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a list of comparable elements in ascending order using the pancake sort algorithm.\n    Returns a new list with elements sorted.\n    \"\"\"\n    def _flip(arr: list, k: int) -> None:\n        \"\"\"Reverses the order of elements from index 0 up to k (inclusive) in a list.\"\"\"\n        start = 0\n        while start < k:\n            arr[start], arr[k] = arr[k], arr[start]\n            start += 1\n            k -= 1\n\n    def _find_max_index(arr: list, n: int) -> int:\n        \"\"\"Finds the index of the maximum element within arr[0] to arr[n-1].\"\"\"\n        max_val = arr[0]\n        max_idx = 0\n        for i in range(1, n):\n            if arr[i] > max_val:\n                max_val = arr[i]\n                max_idx = i\n        return max_idx\n\n    # Create a copy to avoid modifying the original list\n    arr = list(input_list)\n    n = len(arr)\n\n    # Iterate from the largest element down to the smallest\n    for current_size in range(n, 1, -1):\n        # Find the index of the maximum element in the current unsorted portion\n        max_idx = _find_max_index(arr, current_size)\n\n        # If the maximum element is not already in its correct position (current_size - 1)\n        if max_idx != current_size - 1:\n            # Move the maximum element to the front of the current unsorted portion\n            _flip(arr, max_idx)\n            # Move the maximum element from the front to its correct sorted position\n            _flip(arr, current_size - 1)\n    \n    return arr"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(arr: tuple | list) -> int | float:\n    \"\"\"\n    Calculates the maximum difference between any two elements in the input array.\n    This is achieved by finding the difference between the maximum and minimum elements.\n    \"\"\"\n    min_val = min(arr)\n    max_val = max(arr)\n    return max_val - min_val"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) from i=0 to n // 2.\n    The series continues as long as (n - 2*i) >= 0.\n    \"\"\"\n    total_sum = 0\n    for i in range(n // 2 + 1):\n        term = n - (2 * i)\n        total_sum += term\n    return total_sum"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Calculates the smallest power of 2 that is greater than or equal to n.\n    Handles the edge case n=0 by returning 1.\n    \"\"\"\n    if n == 0:\n        return 1\n    \n    power = 1\n    while power < n:\n        power *= 2\n    return power"}
{"task_id": "Mbpp/166", "solution": "def _is_even(number: int) -> bool:\n    \"\"\"\n    Determines if a given integer is an even number.\n    \"\"\"\n    return number % 2 == 0\nclass IntegerPair:\n    \"\"\"\n    Encapsulates two integers and provides methods for XOR calculation and parity check.\n    \"\"\"\n    def __init__(self, int1: int, int2: int):\n        self.integer1 = int1\n        self.integer2 = int2\n\n    def get_xor_result(self) -> int:\n        \"\"\"\n        Computes and returns the bitwise XOR of the two integers in the pair.\n        \"\"\"\n        return self.integer1 ^ self.integer2\n\n    def is_xor_even(self) -> bool:\n        \"\"\"\n        Determines if the XOR result of the pair is an even number.\n        \"\"\"\n        return _is_even(self.get_xor_result())\ndef find_even_pair(numbers: list[int]) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that xor to an even number.\n    \"\"\"\n    even_xor_pairs_count = 0\n    n = len(numbers)\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            num1 = numbers[i]\n            num2 = numbers[j]\n            \n            pair = IntegerPair(num1, num2)\n            if pair.is_xor_even():\n                even_xor_pairs_count += 1\n                \n    return even_xor_pairs_count"}
{"task_id": "Mbpp/168", "solution": "def frequency(numbers: list[int], target_number: int) -> int:\n    \"\"\"\n    Counts the number of occurrences of a target number in a given list.\n    Returns 0 if the target number is not found.\n    \"\"\"\n    count = 0\n    for number in numbers:\n        if number == target_number:\n            count += 1\n    return count"}
{"task_id": "Mbpp/165", "solution": "ALPHABET_MAP = {chr(ord('a') + i): i + 1 for i in range(26)}\ndef count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string that occur at the same 1-based string position\n    as their 1-based alphabetical position (case insensitive).\n    \"\"\"\n    count = 0\n    for i, char in enumerate(input_string):\n        string_position = i + 1\n        lower_char = char.lower()\n        if lower_char in ALPHABET_MAP:\n            alphabetical_position = ALPHABET_MAP[lower_char]\n            if string_position == alphabetical_position:\n                count += 1\n    return count"}
{"task_id": "Mbpp/172", "solution": "def count_occurance(input_string: str) -> int:\n    \"\"\"\n    Counts the number of non-overlapping occurrences of the substring 'std'\n    in the given input string.\n    \"\"\"\n    return input_string.count('std')"}
{"task_id": "Mbpp/171", "solution": "def perimeter_pentagon(side_length: float) -> float:\n    \"\"\"\n    Calculates the perimeter of a regular pentagon.\n    The perimeter is the side length multiplied by 5.\n    \"\"\"\n    return side_length * 5"}
{"task_id": "Mbpp/170", "solution": "def sum_range_list(numbers: list[int | float], start_index: int, end_index: int) -> int | float:\n    \"\"\"Calculates the sum of numbers in a list within a specified range.\n\n    Returns the sum of numbers within the specified range, or 0 if the list is empty or the effective range is invalid.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    # Adjust indices to be within the valid bounds of the list.\n    effective_start_index = max(0, start_index)\n    effective_end_index = min(len(numbers) - 1, end_index)\n\n    # If the effective range is invalid (start index after end index), return 0.\n    if effective_start_index > effective_end_index:\n        return 0\n\n    current_sum = 0\n    for i in range(effective_start_index, effective_end_index + 1):\n        current_sum += numbers[i]\n\n    return current_sum"}
{"task_id": "Mbpp/226", "solution": "def odd_values_string(input_string: str) -> str:\n    \"\"\"Removes characters with odd 0-based index values from an input string.\"\"\"\n    return input_string[::2]"}
{"task_id": "Mbpp/222", "solution": "def check_type(input_tuple: tuple) -> bool:\n    \"\"\"\n    Checks if all elements in a tuple have the same data type.\n    Returns True if the tuple is empty or all elements share the same type, otherwise False.\n    \"\"\"\n    if not input_tuple:\n        return True\n\n    first_type = type(input_tuple[0])\n    for element in input_tuple[1:]:\n        if type(element) != first_type:\n            return False\n    return True"}
{"task_id": "Mbpp/223", "solution": "import bisect\ndef is_majority(arr: list, n: int, element: int) -> bool:\n    # Find the first occurrence of the element using binary search.\n    first_idx = bisect.bisect_left(arr, element)\n\n    # If the element is not found at all, it cannot be a majority.\n    if first_idx >= n or arr[first_idx] != element:\n        return False\n\n    # Find the index just after the last occurrence of the element.\n    last_idx_plus_one = bisect.bisect_right(arr, element)\n\n    # Calculate the total count of the element.\n    count = last_idx_plus_one - first_idx\n\n    # Check if the count is greater than n/2.\n    return count > n / 2"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(number: int) -> int:\n    \"\"\"\n    Counts the number of set bits (1s) in the binary representation of an integer.\n    Handles negative numbers by interpreting them as 32-bit two's complement.\n    \"\"\"\n    if number < 0:\n        # For negative numbers, interpret as 32-bit two's complement.\n        # 0xFFFFFFFF is a mask for the lower 32 bits.\n        number = number & 0xFFFFFFFF\n    \n    # Convert the number to its binary string representation and count '1's.\n    return bin(number).count('1')"}
