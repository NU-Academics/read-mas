{"task_id": "Mbpp/599", "solution": "def sum_average(n: int) -> tuple[int, float]:\n    \"\"\"Calculates the sum and average of the first 'n' natural numbers.\"\"\"\n    sum_val_float = n * (n + 1) / 2\n    average_val = sum_val_float / n\n    return int(sum_val_float), average_val"}
{"task_id": "Mbpp/597", "solution": "def find_kth(array1: list[int], array2: list[int], k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element from two given sorted arrays using a two-pointer approach.\n    Assumes array1 and array2 are sorted in ascending order and k is a valid 1-based index.\n    \"\"\"\n    ptr1, ptr2 = 0, 0\n    current_k = 0\n    result = 0 # This will be overwritten before returning for a valid k\n\n    while ptr1 < len(array1) and ptr2 < len(array2):\n        current_k += 1\n        if array1[ptr1] < array2[ptr2]:\n            result = array1[ptr1]\n            ptr1 += 1\n        else:\n            result = array2[ptr2]\n            ptr2 += 1\n        if current_k == k:\n            return result\n\n    while ptr1 < len(array1):\n        current_k += 1\n        result = array1[ptr1]\n        ptr1 += 1\n        if current_k == k:\n            return result\n\n    while ptr2 < len(array2):\n        current_k += 1\n        result = array2[ptr2]\n        ptr2 += 1\n        if current_k == k:\n            return result\n    \n    # In a correctly used scenario (k is valid and within bounds), this line will not be reached.\n    return result"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"\n    Checks if a number is an Armstrong number.\n    An Armstrong number is equal to the sum of its own digits each raised to the power of the number of digits.\n    \"\"\"\n    num_str = str(number)\n    num_digits = len(num_str)\n    armstrong_sum = 0\n    for digit_char in num_str:\n        digit = int(digit_char)\n        armstrong_sum += digit ** num_digits\n    return armstrong_sum == number"}
