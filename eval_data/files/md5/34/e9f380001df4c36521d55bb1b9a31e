{"task_id": "Mbpp/245", "solution": "from typing import List\ndef _calculate_lis_sums(arr: List[int]) -> List[int]:\n    \"\"\"\n    Computes the maximum sum of an increasing subsequence ending at each position in the array.\n    result[i] is the maximum sum of an increasing subsequence ending at arr[i].\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n    \n    lis_sums = list(arr) # Initialize with each element itself as a LIS of length 1\n\n    for i in range(1, n):\n        for j in range(i):\n            if arr[i] > arr[j]: # For strictly increasing subsequence\n                lis_sums[i] = max(lis_sums[i], lis_sums[j] + arr[i])\n    return lis_sums\ndef _calculate_lds_sums(arr: List[int]) -> List[int]:\n    \"\"\"\n    Computes the maximum sum of a decreasing subsequence starting at each position in the array.\n    result[i] is the maximum sum of a decreasing subsequence starting at arr[i].\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n\n    lds_sums = list(arr) # Initialize with each element itself as a LDS of length 1\n\n    for i in range(n - 2, -1, -1): # Iterate from n-2 down to 0\n        for j in range(i + 1, n): # Look for elements after i\n            if arr[i] > arr[j]: # For strictly decreasing subsequence\n                lds_sums[i] = max(lds_sums[i], lds_sums[j] + arr[i])\n    return lds_sums\ndef max_sum(arr: List[int]) -> int:\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence within the given array.\n    A bitonic subsequence is first strictly increasing and then strictly decreasing.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n\n    # Calculate LIS sums ending at each position\n    lis_sums = _calculate_lis_sums(arr)\n\n    # Calculate LDS sums starting at each position\n    lds_sums = _calculate_lds_sums(arr)\n\n    # Combine LIS and LDS sums to find the maximum bitonic sum.\n    # The peak element arr[i] is counted twice (once in LIS, once in LDS), so subtract it once.\n    max_bitonic_sum = float('-inf') \n    \n    for i in range(n):\n        current_bitonic_sum = lis_sums[i] + lds_sums[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n    \n    return int(max_bitonic_sum)"}
