{"task_id": "Mbpp/631", "solution": "def replace_characters(input_string: str, mode: str) -> str:\n    \"\"\"\n    Replaces characters in a string based on the specified mode.\n\n    Args:\n        input_string: The string on which to perform character replacement.\n        mode: A string indicating the replacement direction. Valid values are\n              \"space_to_underscore\" or \"underscore_to_space\".\n\n    Returns:\n        The modified string.\n\n    Raises:\n        ValueError: If an invalid mode is provided.\n    \"\"\"\n    if mode == \"space_to_underscore\":\n        return input_string.replace(' ', '_')\n    elif mode == \"underscore_to_space\":\n        return input_string.replace('_', ' ')\n    else:\n        raise ValueError(\"Invalid mode provided. Expected 'space_to_underscore' or 'underscore_to_space'.\")"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(input_coordinate: tuple[int, int]) -> list[list[int]]:\n    \"\"\"\n    Calculates all adjacent coordinates (including itself) for a given (x, y) coordinate.\n\n    Args:\n        input_coordinate: A tuple of two integers (x, y) representing the central coordinate.\n\n    Returns:\n        A list of lists, where each inner list contains two integers [x_coord, y_coord]\n        representing an adjacent coordinate.\n    \"\"\"\n    x, y = input_coordinate\n    adjacent_coords = []\n    for i in range(x - 1, x + 2):\n        for j in range(y - 1, y + 2):\n            adjacent_coords.append([i, j])\n    return adjacent_coords"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a list of numbers in ascending order using the heap sort algorithm.\n    Returns a new list with the sorted elements.\n    \"\"\"\n    n = len(input_list)\n    arr = list(input_list) # Create a mutable copy of the input list\n\n    # Helper function to heapify a subtree rooted with node i\n    # n is size of heap\n    def heapify(arr, n, i):\n        largest = i  # Initialize largest as root\n        left = 2 * i + 1  # left child\n        right = 2 * i + 2  # right child\n\n        # See if left child of root exists and is greater than root\n        if left < n and arr[left] > arr[largest]:\n            largest = left\n\n        # See if right child of root exists and is greater than largest so far\n        if right < n and arr[right] > arr[largest]:\n            largest = right\n\n        # Change root, if needed\n        if largest != i:\n            arr[i], arr[largest] = arr[largest], arr[i]  # swap\n            heapify(arr, n, largest)\n\n    # Build a maxheap.\n    # The last parent node is at index n // 2 - 1.\n    for i in range(n // 2 - 1, -1, -1):\n        heapify(arr, n, i)\n\n    # One by one extract elements\n    for i in range(n - 1, 0, -1):\n        arr[i], arr[0] = arr[0], arr[i]  # swap\n        heapify(arr, i, 0) # Call heapify on the reduced heap\n\n    return arr"}
{"task_id": "Mbpp/632", "solution": "def move_zero(input_list: list) -> list:\n    \"\"\"\n    Moves all zero-valued elements to the end of the given list,\n    preserving the relative order of non-zero elements.\n    \"\"\"\n    non_zeros = []\n    zero_count = 0\n    for element in input_list:\n        if element != 0:\n            non_zeros.append(element)\n        else:\n            zero_count += 1\n    non_zeros.extend([0] * zero_count)\n    return non_zeros"}
