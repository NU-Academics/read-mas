{"task_id": "Mbpp/479", "solution": "from typing import Union\ndef first_Digit(number: Union[int, float]) -> int:\n    \"\"\"\n    Finds the first digit of a given number by repeatedly dividing or multiplying by 10.\n    Handles both integers and floats, and negative numbers by considering their absolute value.\n    \"\"\"\n    if number == 0:\n        return 0\n\n    num_abs = abs(number)\n\n    if num_abs >= 1:\n        # For numbers >= 1, divide by 10 until it's less than 10\n        while num_abs >= 10:\n            num_abs /= 10\n    else: # 0 < num_abs < 1\n        # For numbers between 0 and 1, multiply by 10 until it's >= 1\n        while num_abs < 1:\n            num_abs *= 10\n    \n    return int(num_abs)"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of the cubes of the first 'n' natural numbers\n    and the sum of the first 'n' natural numbers using direct formulas.\n    \"\"\"\n    sum_n = n * (n + 1) // 2\n    sum_cubes = sum_n ** 2\n    result = sum_cubes - sum_n\n    return result"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of the per-digit absolute differences between two integers.\n\n    The digits are aligned from the units place. Missing digits in the shorter\n    number are treated as zero.\n    \"\"\"\n    s_num1 = str(num1)[::-1]\n    s_num2 = str(num2)[::-1]\n\n    total_sum = 0\n    max_len = max(len(s_num1), len(s_num2))\n\n    for i in range(max_len):\n        digit1 = int(s_num1[i]) if i < len(s_num1) else 0\n        digit2 = int(s_num2[i]) if i < len(s_num2) else 0\n        total_sum += abs(digit1 - digit2)\n\n    return total_sum"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr: list[int], n: int) -> int:\n    \"\"\"\n    Counts the number of pairs in a list whose bitwise XOR value is odd.\n    Iterates through all unique pairs and checks the parity of their XOR sum.\n    \"\"\"\n    count = 0\n    for i in range(n):\n        for j in range(i + 1, n):\n            xor_val = arr[i] ^ arr[j]\n            if xor_val % 2 != 0:\n                count += 1\n    return count"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"\n    Toggles the case of each alphabetic character in the input string.\n    Uppercase characters become lowercase, and lowercase characters become uppercase.\n    \"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if char.islower():\n            toggled_chars.append(char.upper())\n        elif char.isupper():\n            toggled_chars.append(char.lower())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/563", "solution": "import re\ndef extract_values(input_string: str) -> list[str]:\n    \"\"\"\n    Extracts values enclosed in double quotation marks from a string.\n    Returns a list of strings, with leading/trailing double quotation marks removed.\n    \"\"\"\n    extracted_list = []\n    pattern = r'\\\"([^\\\"]*)\\\"'\n\n    for match in re.finditer(pattern, input_string):\n        extracted_list.append(match.group(1))\n\n    return extracted_list"}
