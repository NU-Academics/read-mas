{"task_id": "Mbpp/611", "solution": "from typing import List\nclass Column:\n    \"\"\"Encapsulates a column's values and provides the functionality to find its maximum element.\"\"\"\n    def __init__(self, values: List[int]):\n        self._values = values\n\n    def find_max(self) -> int:\n        \"\"\"Finds and returns the maximum value within the column.\"\"\"\n        return max(self._values)\nclass Matrix:\n    \"\"\"Encapsulates matrix data and provides methods for column extraction.\"\"\"\n    def __init__(self, data: List[List[int]]):\n        self._data = data\n        # Assuming data is non-empty and well-formed based on constraints.\n        self._num_rows = len(data)\n        self._num_cols = len(data[0]) if data else 0\n\n    def get_column(self, index: int) -> List[int]:\n        \"\"\"Extracts the elements of the specified column.\"\"\"\n        # Assuming index is valid and within bounds based on constraints.\n        column_values = [row[index] for row in self._data]\n        return column_values\ndef max_of_nth(matrix_data: List[List[int]], n: int) -> int:\n    \"\"\"\n    Given a matrix represented as a list of lists, returns the max of the n'th column.\n    This function orchestrates Matrix and Column classes to find the maximum value.\n    \"\"\"\n    matrix_obj = Matrix(matrix_data)\n    column_values = matrix_obj.get_column(n)\n    column_obj = Column(column_values)\n    max_value = column_obj.find_max()\n    return max_value"}
{"task_id": "Mbpp/614", "solution": "from typing import List, Tuple, Any, Union\ndef cummulative_sum(tuple_list: List[Tuple[Any, ...]]) -> Union[int, float]:\n    \"\"\"Calculates the cumulative sum of all numeric values in a list of tuples.\n\n    It iterates through each tuple and sums all int or float values found.\n    \"\"\"\n    total_sum = 0\n    for tpl in tuple_list:\n        for value in tpl:\n            if isinstance(value, (int, float)):\n                total_sum += value\n    return total_sum"}
{"task_id": "Mbpp/612", "solution": "from typing import Any, List\ndef merge(input_list_of_lists: List[List[Any]]) -> List[List[Any]]:\n    \"\"\"\n    Splits a list of lists into two new lists.\n    Each sublist in the input must contain exactly two elements.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n\n    for sublist in input_list_of_lists:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(input_data: tuple[tuple[int | float, ...], ...]) -> list[float]:\n    \"\"\"\n    Calculates the average of numeric values for each inner tuple in a tuple of tuples.\n    Returns a list of floating-point numbers, where each number is the average of an corresponding inner tuple.\n    \"\"\"\n    averages = []\n    for inner_tuple in input_data:\n        if inner_tuple:  # Avoid division by zero for empty inner tuples\n            current_sum = sum(inner_tuple)\n            current_count = len(inner_tuple)\n            average = float(current_sum) / current_count\n            averages.append(average)\n        else:\n            averages.append(0.0) # Or handle as per specific requirement for empty tuples\n    return averages"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Performs element-wise modulo operation on two tuples of the same length.\n    Returns a new tuple with the results.\n    \"\"\"\n    result = []\n    for i in range(len(tuple1)):\n        result.append(tuple1[i] % tuple2[i])\n    return tuple(result)"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"Moves all numeric characters to the end of the given string, preserving relative order.\n\n    Args:\n        input_string: The string to process.\n    \"\"\"\n    non_numeric_chars = []\n    numeric_chars = []\n\n    for char in input_string:\n        if char.isdigit():\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n\n    return \"\".join(non_numeric_chars) + \"\".join(numeric_chars)"}
{"task_id": "Mbpp/618", "solution": "def div_list(list1: list[float], list2: list[float]) -> list[float]:\n    \"\"\"\n    Performs element-wise division of two lists.\n\n    Raises TypeError, ValueError, or ZeroDivisionError for invalid inputs.\n    \"\"\"\n    if not isinstance(list1, list) or not isinstance(list2, list):\n        raise TypeError(\"Inputs must be lists.\")\n\n    if len(list1) != len(list2):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    result = []\n    for i in range(len(list1)):\n        val1 = list1[i]\n        val2 = list2[i]\n\n        if not isinstance(val1, (int, float)) or not isinstance(val2, (int, float)):\n            raise TypeError(\"List elements must be numeric.\")\n\n        if val2 == 0:\n            raise ZeroDivisionError(\"Cannot divide by zero.\")\n\n        result.append(val1 / val2)\n\n    return result"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1: list, list2: list, size: int) -> float:\n    \"\"\"\n    Calculates the median of two sorted lists of the same size.\n    It iterates through both lists to find the two middle elements of the combined sorted list.\n    \"\"\"\n    i = 0\n    j = 0\n\n    median1 = -1\n    median2 = -1\n\n    # Iterate up to size + 1 to find the two middle elements\n    for count in range(size + 1):\n        if i == size:  # list1 exhausted\n            median1 = median2\n            median2 = list2[j]\n            j += 1\n        elif j == size:  # list2 exhausted\n            median1 = median2\n            median2 = list1[i]\n            i += 1\n        elif list1[i] <= list2[j]:\n            median1 = median2\n            median2 = list1[i]\n            i += 1\n        else:\n            median1 = median2\n            median2 = list2[j]\n            j += 1\n\n    return float(median1 + median2) / 2.0"}
{"task_id": "Mbpp/626", "solution": "def triangle_area(radius: float) -> float | None:\n    \"\"\"Calculates the area of the largest triangle inscribed in a semicircle.\n\n    Returns: The calculated area (float) if radius is non-negative, else None.\n    \"\"\"\n    if radius < 0:\n        return None\n    else:\n        # The largest inscribed triangle has base = 2*radius and height = radius.\n        # Area = 0.5 * base * height = 0.5 * (2*radius) * radius = radius * radius.\n        return radius * radius"}
{"task_id": "Mbpp/623", "solution": "def nth_nums(numbers: list[float | int], n: int) -> list[float | int]:\n    \"\"\"\n    Computes the n-th power of each number in a list.\n\n    Args:\n        numbers: A list of numeric values (integers or floats).\n        n: An integer representing the exponent.\n\n    Returns:\n        A new list containing the n-th power of each number.\n    \"\"\"\n    return [num ** n for num in numbers]"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the size of the largest divisible subset from a list of numbers.\n    Each pair (a, b) in the subset must satisfy a % b == 0 or b % a == 0.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    # Sort the numbers to simplify the dynamic programming approach.\n    # If a % b == 0, then a must be greater than or equal to b.\n    numbers.sort()\n\n    n = len(numbers)\n    # dp[i] stores the size of the largest divisible subset ending with numbers[i]\n    dp = [1] * n\n\n    for i in range(n):\n        for j in range(i):\n            if numbers[i] % numbers[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n\n    return max(dp)"}
