{"task_id": "Mbpp/607", "solution": "import re\ndef find_literals(text: str, pattern: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Searches a string for a regex pattern.\n    Returns the matching substring, its start index, and its end index.\n    \"\"\"\n    match = re.search(pattern, text)\n    if match:\n        return (match.group(0), match.start(), match.end())\n    return None"}
{"task_id": "Mbpp/604", "solution": "def reverse_words(input_string: str) -> str:\n    \"\"\"\n    Reverses the order of words in a given string, using spaces as delimiters.\n\n    Args:\n        input_string: The string whose words are to be reversed.\n\n    Returns:\n        A new string with the order of words reversed.\n\n    Example:\n        >>> reverse_words(\"python program\")\n        \"program python\"\n    \"\"\"\n    words = input_string.split()\n    reversed_words = words[::-1]\n    return ' '.join(reversed_words)"}
{"task_id": "Mbpp/608", "solution": "_memo = {}\ndef _combinations(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient (n choose k).\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\ndef bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using a recurrence relation with memoization.\n    Raises ValueError if n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Bell number is not defined for negative n.\")\n    if n == 0:\n        return 1\n    if n in _memo:\n        return _memo[n]\n\n    total_sum = 0\n    # Recurrence relation: B_n = sum_{k=0}^{n-1} C(n-1, k) * B_k for n > 0\n    for k in range(n):\n        comb = _combinations(n - 1, k)\n        bell_k = bell_Number(k) # Recursive call\n        total_sum += comb * bell_k\n\n    _memo[n] = total_sum\n    return total_sum"}
