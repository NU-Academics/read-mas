{"task_id": "Mbpp/463", "solution": "def max_subarray_product(nums: list[int]) -> int:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray.\n    Handles empty arrays, single elements, negative numbers, and zeros.\n    \"\"\"\n    if not nums:\n        return 0\n\n    max_so_far = nums[0]\n    current_max = nums[0]\n    current_min = nums[0]\n\n    for num in nums[1:]:\n        if num == 0:\n            # If current number is 0, any product containing it will be 0.\n            # We reset current_max and current_min to 1 to start a new subarray product calculation.\n            # max_so_far should still consider 0 as a possible maximum product.\n            current_max = 1\n            current_min = 1\n            max_so_far = max(max_so_far, 0)\n            continue\n\n        # Store the old current_max before it's updated, as current_min's calculation needs it.\n        temp_max = current_max\n\n        # Update current_max: it can be the number itself, or (num * old_current_max), or (num * old_current_min)\n        current_max = max(num, temp_max * num, current_min * num)\n        # Update current_min: it can be the number itself, or (num * old_current_max), or (num * old_current_min)\n        current_min = min(num, temp_max * num, current_min * num)\n\n        # Update the global maximum product found so far\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"Calculates the pairwise sum of neighboring elements in the given tuple.\n    Returns an empty tuple if the input tuple has less than two elements.\"\"\"\n    if len(input_tuple) < 2:\n        return ()\n\n    sums = []\n    for i in range(len(input_tuple) - 1):\n        sums.append(input_tuple[i] + input_tuple[i+1])\n    \n    return tuple(sums)"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(input_list: list) -> bool:\n    \"\"\"\n    Checks if the numbers in the given list are consecutive.\n    Returns True if the numbers in the list are consecutive, False otherwise.\n    \"\"\"\n    if not isinstance(input_list, list):\n        return False\n\n    if len(input_list) <= 1:\n        return False\n\n    for item in input_list:\n        if not isinstance(item, (int, float)):\n            return False\n\n    sorted_list = sorted(input_list)\n\n    for i in range(1, len(sorted_list)):\n        if sorted_list[i] - sorted_list[i - 1] != 1:\n            return False\n\n    return True"}
{"task_id": "Mbpp/468", "solution": "def max_product(numbers: list[int]) -> int:\n    \"\"\"Calculates the maximum product of an increasing subsequence.\n\n    Args:\n        numbers: A list of integers.\n\n    Returns:\n        The maximum product found, or 0 if the input list is empty.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    n = len(numbers)\n    # dp_products[i] stores the maximum product of an increasing subsequence ending at index i.\n    # Initialize with each number itself, as it's an increasing subsequence of length 1.\n    dp_products = [num for num in numbers]\n\n    # Fill dp_products using dynamic programming by iterating through all possible preceding elements.\n    for i in range(n):\n        for j in range(i):\n            if numbers[i] > numbers[j]:\n                # If numbers[i] can extend an increasing subsequence ending at j,\n                # update dp_products[i] with the maximum product found so far.\n                dp_products[i] = max(dp_products[i], dp_products[j] * numbers[i])\n\n    # The maximum value in the dp_products array is the overall maximum product.\n    return max(dp_products)"}
