{"task_id": "Mbpp/290", "solution": "import typing\nfrom typing import List, Any, Tuple\ndef max_length(input_list_of_lists: List[List[Any]]) -> Tuple[int, List[Any]]:\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    It returns the maximum length and the first sub-list with that length.\n    \"\"\"\n    max_len = 0\n    identified_sub_list: List[Any] = []\n\n    if not input_list_of_lists:\n        return (0, [])\n\n    for sub_list in input_list_of_lists:\n        current_len = len(sub_list)\n        if current_len > max_len:\n            max_len = current_len\n            identified_sub_list = sub_list\n\n    return (max_len, identified_sub_list)"}
{"task_id": "Mbpp/286", "solution": "import math\nfrom typing import List\ndef max_sub_array_sum_repeated(array: List[int], length: int, k: int) -> int:\n    \"\"\"\n    Calculates the largest sum of a contiguous subarray in a modified array\n    formed by repeating the given array k times.\n    \"\"\"\n    if not array or k == 0:\n        return 0\n\n    # Kadane's algorithm to find the maximum subarray sum in a given array\n    def kadanes(arr: List[int]) -> int:\n        current_max = 0\n        global_max = -math.inf\n        for x in arr:\n            current_max += x\n            if current_max > global_max:\n                global_max = current_max\n            if current_max < 0:\n                current_max = 0\n        return global_max if global_max != -math.inf else 0 # Handle all negatives case gracefully\n\n    # Calculate max prefix sum\n    def max_prefix_sum(arr: List[int]) -> int:\n        current_sum = 0\n        max_sum = -math.inf\n        for x in arr:\n            current_sum += x\n            max_sum = max(max_sum, current_sum)\n        return max_sum\n\n    # Calculate max suffix sum\n    def max_suffix_sum(arr: List[int]) -> int:\n        current_sum = 0\n        max_sum = -math.inf\n        for x in reversed(arr):\n            current_sum += x\n            max_sum = max(max_sum, current_sum)\n        return max_sum\n    \n    # Case 1: k = 1\n    if k == 1:\n        return kadanes(array)\n\n    # Case 2: k > 1\n    # Create an array of two repetitions to find potential cross-boundary sums\n    two_repetitions = array + array\n    \n    max_sum_two_repetitions = kadanes(two_repetitions)\n    \n    # Calculate the total sum of the original array\n    total_array_sum = sum(array)\n\n    # If total_array_sum is positive, we can potentially add (k-2) * total_array_sum\n    # to the sum obtained from two repetitions.\n    if total_array_sum > 0:\n        if k > 2:\n            max_prefix = max_prefix_sum(array)\n            max_suffix = max_suffix_sum(array)\n            # The maximum sum could be max_suffix + (k-2) * total_array_sum + max_prefix\n            # Or it could be just the max sum from two repetitions (if all of array's sum is not beneficial)\n            return max(max_sum_two_repetitions, max_suffix + (k - 2) * total_array_sum + max_prefix)\n        else: # k == 2, already handled by max_sum_two_repetitions\n            return max_sum_two_repetitions\n    else:\n        # If total_array_sum is non-positive, repeating the array more than twice\n        # will not increase the maximum sum beyond what's found in two repetitions.\n        return max_sum_two_repetitions"}
{"task_id": "Mbpp/293", "solution": "import math\ndef otherside_rightangle(leg1: float, leg2: float) -> float:\n    # Calculates the hypotenuse of a right-angled triangle given two leg lengths.\n    # It first validates inputs and then applies the Pythagorean theorem.\n    if not isinstance(leg1, (int, float)):\n        raise ValueError('leg1 must be a numerical value.')\n    if leg1 <= 0:\n        raise ValueError('leg1 must be a positive numerical value.')\n    if not isinstance(leg2, (int, float)):\n        raise ValueError('leg2 must be a numerical value.')\n    if leg2 <= 0:\n        raise ValueError('leg2 must be a positive numerical value.')\n    \n    hypotenuse_squared = leg1**2 + leg2**2\n    return math.sqrt(hypotenuse_squared)"}
