{"task_id": "Mbpp/296", "solution": "from typing import List\ndef get_Inv_Count(arr: List[int]) -> int:\n    \"\"\"\n    Counts the total number of inversions in a given array of integers.\n    An inversion is a pair of elements (arr[i], arr[j]) such that i < j and arr[i] > arr[j].\n    \"\"\"\n    n = len(arr)\n    inversion_count = 0\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            if arr[i] > arr[j]:\n                inversion_count += 1\n    return inversion_count"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list: list) -> list:\n    \"\"\"\n    Flattens a given nested list structure into a single-level list.\n\n    The function iterates through the input list. If an element is a list,\n    it recursively calls itself to flatten that sublist. Non-list elements\n    are appended directly to the result. The order of elements is preserved.\n    \"\"\"\n    flattened = []\n    for item in nested_list:\n        if isinstance(item, list):\n            flattened.extend(flatten_list(item))\n        else:\n            flattened.append(item)\n    return flattened"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(dictionary: dict) -> int:\n    # Calculate the maximum nesting level of a dictionary using recursion.\n    # The depth is 1 for non-dictionary values at the current level.\n    max_depth = 1\n    for value in dictionary.values():\n        if isinstance(value, dict):\n            max_depth = max(max_depth, dict_depth(value) + 1)\n    return max_depth"}
{"task_id": "Mbpp/300", "solution": "import math\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Calculates the count of all binary sequences of length 2n such that\n    the sum of the first n bits is the same as the sum of the last n bits.\n    \"\"\"\n    total_count = 0\n    for k in range(n + 1):\n        # Number of ways to get a sum of k from n bits\n        combinations_for_k = math.comb(n, k)\n        # Ways for the first n bits to sum to k, and last n bits to sum to k\n        ways_for_sum_k = combinations_for_k * combinations_for_k\n        total_count += ways_for_sum_k\n    return float(total_count)"}
{"task_id": "Mbpp/299", "solution": "import collections\ndef max_aggregate(data: list[tuple[str, int]]) -> tuple[str, int]:\n    \"\"\"\n    Calculates the maximum aggregate score from a list of (name, score) tuples.\n    Aggregates scores by name and returns the name with the highest total score.\n    \"\"\"\n    aggregated_scores = collections.defaultdict(int)\n    for name, score in data:\n        aggregated_scores[name] += score\n\n    if not aggregated_scores:\n        # If the input list is empty, return an empty result based on implicit requirements/common sense\n        # The prompt examples always have data, but this handles an empty case gracefully.\n        return (\"\", 0)\n\n    max_name = None\n    max_score = -1\n    for name, score in aggregated_scores.items():\n        if score > max_score:\n            max_score = score\n            max_name = name\n\n    return (max_name, max_score)"}
{"task_id": "Mbpp/305", "solution": "class Word:\n    \"\"\"Encapsulates a single word's value and provides a method to check if it starts with 'p' or 'P'.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def starts_with_p(self) -> bool:\n        \"\"\"Returns True if the word starts with 'p' or 'P' (case-insensitive), False otherwise.\"\"\"\n        return self.value.lower().startswith('p')\ndef start_withp(input_strings: list[str]) -> tuple[str, ...]:\n    \"\"\"Processes a list of strings to find the first two words starting with 'p' or 'P'.\"\"\"\n    p_words_found = []\n    for input_string in input_strings:\n        words = input_string.split()\n        for word_str in words:\n            if len(p_words_found) < 2:\n                word_obj = Word(word_str)\n                if word_obj.starts_with_p():\n                    p_words_found.append(word_str)\n                    if len(p_words_found) == 2:\n                        break  # Found two words, exit inner loop\n        if len(p_words_found) == 2:\n            break  # Found two words, exit outer loop\n    return tuple(p_words_found)"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Calculates the maximum sum of an increasing subsequence from prefix until ith index\n    and also including a given kth element which is after i, i.e., k > i.\n    \"\"\"\n    if not (0 <= i < n and 0 <= k < n and k > i):\n        raise ValueError(\"Indices n, i, k are out of bounds or k is not greater than i.\")\n\n    k_element = arr[k]\n    dp = [0] * (i + 1)\n\n    for j in range(i + 1):\n        if arr[j] < k_element:\n            dp[j] = arr[j]\n            for p in range(j):\n                if arr[p] < arr[j] and arr[p] < k_element:\n                    dp[j] = max(dp[j], arr[j] + dp[p])\n        else:\n            dp[j] = 0 # Element arr[j] cannot be part of the prefix subsequence\n\n    max_prefix_sum = 0\n    if dp:\n        max_prefix_sum = max(dp)\n\n    return max_prefix_sum + k_element"}
{"task_id": "Mbpp/308", "solution": "import math\nfrom typing import List, Union\ndef large_product(list1: List[Union[int, float]], list2: List[Union[int, float]], n: int) -> List[Union[int, float]]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists.\n    Returns a list of numerical values, representing the n largest products, sorted in descending order.\n    \"\"\"\n    if not list1 or not list2 or n <= 0:\n        return []\n\n    all_products = []\n    for num1 in list1:\n        for num2 in list2:\n            all_products.append(num1 * num2)\n\n    all_products.sort(reverse=True)\n\n    return all_products[:n]"}
