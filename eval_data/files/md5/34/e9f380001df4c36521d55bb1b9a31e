{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"\n    Calculates the n'th Lucas number using a recursive approach.\n    Raises ValueError if n is negative, as Lucas numbers are defined for non-negative indices.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if n == 0:\n        return 2\n    elif n == 1:\n        return 1\n    else:\n        return find_lucas(n - 1) + find_lucas(n - 2)"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    Returns 0 if n is less than or equal to 0.\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    power = 1\n    while (power << 1) <= n:\n        power <<= 1\n    return power"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(input_integer: int) -> int:\n    \"\"\"\n    Sets the leftmost (most significant) unset bit in the input integer.\n    If all bits up to the highest set bit are set, the next higher bit is set.\n    \"\"\"\n    if input_integer == 0:\n        return 1\n\n    # Determine the position of the highest set bit (0-indexed)\n    highest_set_bit_pos = input_integer.bit_length() - 1\n\n    # Initialize target_bit_pos with the fallback for when all lower bits are set\n    target_bit_pos = highest_set_bit_pos + 1\n\n    # Iterate downwards from the highest set bit position to find the most significant unset bit\n    for bit_pos in range(highest_set_bit_pos, -1, -1):\n        if (input_integer >> bit_pos) & 1 == 0:\n            target_bit_pos = bit_pos\n            break # Found the most significant unset bit\n\n    # Set the identified bit\n    return input_integer | (1 << target_bit_pos)"}
