{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Calculates the product of adjacent elements in a tuple of numbers.\n    Returns an empty tuple if input_tuple has fewer than 2 elements.\n    \"\"\"\n    if len(input_tuple) < 2:\n        return ()\n\n    results = []\n    for i in range(len(input_tuple) - 1):\n        results.append(input_tuple[i] * input_tuple[i+1])\n\n    return tuple(results)"}
{"task_id": "Mbpp/724", "solution": "class PowerDigitSumCalculator:\n    \"\"\"\n    Calculates the sum of digits of a base number raised to a specified power.\n    Handles large numbers by storing the result as a string before summing digits.\n    \"\"\"\n    def __init__(self, base: int, power: int):\n        self._base: int = base\n        self._power: int = power\n        self._calculated_power_result: str = \"\"\n        self._sum_of_digits: int = 0\n\n    def calculate_power(self) -> None:\n        \"\"\"Calculates base raised to power and stores its string representation.\"\"\"\n        result = self._base ** self._power\n        self._calculated_power_result = str(result)\n\n    def calculate_sum_of_digits(self) -> None:\n        \"\"\"Calculates the sum of the digits of the power result.\"\"\"\n        self._sum_of_digits = sum(int(digit) for digit in self._calculated_power_result)\n\n    def get_sum_of_digits(self) -> int:\n        \"\"\"Returns the calculated sum of digits.\"\"\"\n        return self._sum_of_digits\ndef power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    \"\"\"\n    calculator = PowerDigitSumCalculator(base, power)\n    calculator.calculate_power()\n    calculator.calculate_sum_of_digits()\n    return calculator.get_sum_of_digits()"}
{"task_id": "Mbpp/721", "solution": "import math\nclass Cell:\n    \"\"\"Represents a single cell in the matrix with its coordinates and cost.\"\"\"\n    def __init__(self, row: int, col: int, cost: float):\n        self.row = row\n        self.col = col\n        self.cost = cost\nclass Path:\n    \"\"\"Manages a sequence of cells forming a path, calculating its total cost, cell count, and average cost dynamically.\"\"\"\n    def __init__(self, initial_cell: Cell):\n        self._cells = [initial_cell]\n        self._total_cost = initial_cell.cost\n        self._num_cells = 1\n        self._average_cost = initial_cell.cost\n\n    def add_cell(self, cell: Cell):\n        \"\"\"Adds a new cell to the path and updates metrics.\"\"\"\n        self._cells.append(cell)\n        self._total_cost += cell.cost\n        self._num_cells += 1\n        self._average_cost = self._total_cost / self._num_cells\n\n    def get_total_cost(self) -> float:\n        \"\"\"Returns the current total cost of the path.\"\"\"\n        return self._total_cost\n\n    def get_num_cells(self) -> int:\n        \"\"\"Returns the current number of cells in the path.\"\"\"\n        return self._num_cells\n\n    def get_average_cost(self) -> float:\n        \"\"\"Returns the current average cost of the path.\"\"\"\n        return self._average_cost\n\n    def get_last_cell(self) -> Cell:\n        \"\"\"Returns the last cell added to the path.\"\"\"\n        return self._cells[-1]\n\n    def remove_last_cell(self):\n        \"\"\"Removes the last cell added to the path and updates metrics (for backtracking).\"\"\"\n        removed_cell = self._cells.pop()\n        self._total_cost -= removed_cell.cost\n        self._num_cells -= 1\n        if self._num_cells > 0:\n            self._average_cost = self._total_cost / self._num_cells\n        else:\n            self._average_cost = 0.0 # Should not happen if path always starts with one cell\ndef _find_paths_recursive(matrix: list[list[int]], N: int, current_path: Path, r: int, c: int, all_paths: list[Path]) -> None:\n    \"\"\"Recursively explores all valid 'right' or 'down' paths from (r, c) to the bottom-right cell.\"\"\"\n    if r == N - 1 and c == N - 1:\n        all_paths.append(Path(current_path._cells[0])) # Create a new Path instance from current_path's cells to store.\n        for i in range(1, len(current_path._cells)):\n            all_paths[-1].add_cell(current_path._cells[i])\n        return\n\n    # Move Down\n    if r + 1 < N:\n        new_cell_down = Cell(r + 1, c, matrix[r + 1][c])\n        current_path.add_cell(new_cell_down)\n        _find_paths_recursive(matrix, N, current_path, r + 1, c, all_paths)\n        current_path.remove_last_cell() # Backtrack\n\n    # Move Right\n    if c + 1 < N:\n        new_cell_right = Cell(r, c + 1, matrix[r][c + 1])\n        current_path.add_cell(new_cell_right)\n        _find_paths_recursive(matrix, N, current_path, r, c + 1, all_paths)\n        current_path.remove_last_cell() # Backtrack\ndef maxAverageOfPath(matrix: list[list[int]]) -> float:\n    \"\"\"\n    Finds a path with the maximum average over all existing paths in a square matrix.\n    A path starts from the top-left, moves only right or down, and ends at the bottom-right.\n    \"\"\"\n    N = len(matrix)\n    if N == 0:\n        return 0.0\n    if N == 1:\n        return float(matrix[0][0])\n\n    all_paths: list[Path] = []\n    initial_cell = Cell(0, 0, matrix[0][0])\n    current_path = Path(initial_cell)\n\n    _find_paths_recursive(matrix, N, current_path, 0, 0, all_paths)\n\n    max_avg = -math.inf\n    for path in all_paths:\n        max_avg = max(max_avg, path.get_average_cost())\n\n    return max_avg"}
{"task_id": "Mbpp/725", "solution": "def extract_quotation(input_string: str) -> list[str]:\n    \"\"\"\n    Extracts all substrings enclosed within double quotation marks from the given string.\n    \"\"\"\n    extracted_values = []\n    start_index = 0\n    while True:\n        first_quote_idx = input_string.find('\"', start_index)\n        if first_quote_idx == -1:\n            break\n        \n        second_quote_idx = input_string.find('\"', first_quote_idx + 1)\n        if second_quote_idx == -1:\n            break \n        \n        extracted_values.append(input_string[first_quote_idx + 1:second_quote_idx])\n        start_index = second_quote_idx + 1\n        \n    return extracted_values"}
