{"task_id": "Mbpp/639", "solution": "class Name:\n    \"\"\"Encapsulates a name string and provides methods for case checking and length calculation.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def is_starts_with_lowercase(self) -> bool:\n        \"\"\"Checks if the name starts with a lowercase letter.\"\"\"\n        if not self._value:\n            return False\n        return self._value[0].islower()\n\n    def get_length(self) -> int:\n        \"\"\"Returns the length of the name string.\"\"\"\n        return len(self._value)\ndef _filter_names(names: list[Name]) -> list[Name]:\n    \"\"\"Filters a list of Name objects, retaining only those that do not start with a lowercase letter.\"\"\"\n    filtered_list = []\n    for name_obj in names:\n        if not name_obj.is_starts_with_lowercase():\n            filtered_list.append(name_obj)\n    return filtered_list\ndef _calculate_and_sum_lengths(filtered_names: list[Name]) -> int:\n    \"\"\"Calculates the sum of lengths for a list of Name objects.\"\"\"\n    total_sum = 0\n    for name_obj in filtered_names:\n        total_sum += name_obj.get_length()\n    return total_sum\ndef sample_nam(names: list[str]) -> int:\n    \"\"\"\n    Sums the length of names from a list after removing names that start with a lowercase letter.\n    \"\"\"\n    all_name_objects = [Name(name_str) for name_str in names]\n    filtered_names = _filter_names(all_name_objects)\n    total_sum = _calculate_and_sum_lengths(filtered_names)\n    return total_sum"}
{"task_id": "Mbpp/638", "solution": "import math\ndef wind_chill(velocity: float, temperature: float) -> int:\n    \"\"\"\n    Calculates the wind chill index given wind velocity in km/h and temperature in Celsius,\n    rounding the result up to the next integer.\n    \"\"\"\n    # Convert velocity from km/h to m/s for the formula\n    velocity_mps = velocity / 3.6\n\n    # The formula for wind chill index is:\n    # WCI = 13.12 + 0.6215T - 11.37V^0.16 + 0.3965T V^0.16\n    # where T is the air temperature in Celsius and V is the wind velocity in km/h.\n    # However, the more common formula used internationally (based on m/s for velocity) is:\n    # WCI = 13.12 + 0.6215*T - 11.37*(V_kmh**0.16) + 0.3965*T*(V_kmh**0.16)\n    # The prompt's example (120, 35) -> 40 suggests the formula usually for km/h:\n    # WCI = 13.12 + 0.6215*T - 11.37*V^0.16 + 0.3965*T*V^0.16\n    # Where T is in Celsius and V is in km/h.\n\n    # Calculate wind chill using the formula with velocity in km/h\n    wind_chill_index = 13.12 + (0.6215 * temperature) - (11.37 * (velocity**0.16)) + (0.3965 * temperature * (velocity**0.16))\n\n    # Round the result to the next integer (ceiling)\n    return math.ceil(wind_chill_index)"}
