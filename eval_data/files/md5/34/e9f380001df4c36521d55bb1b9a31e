{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if sub_list is a contiguous sublist of main_list.\n    Returns True if sub_list is a sublist of main_list, False otherwise.\n    \"\"\"\n    len_main = len(main_list)\n    len_sub = len(sub_list)\n\n    if len_sub == 0:\n        return True\n    if len_sub > len_main:\n        return False\n\n    for i in range(len_main - len_sub + 1):\n        if main_list[i:i+len_sub] == sub_list:\n            return True\n    return False"}
{"task_id": "Mbpp/572", "solution": "from typing import List, Union, Dict\ndef two_unique_nums(numbers: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"\n    Identifies and returns numbers that occur exactly once in the input list,\n    preserving their original relative order.\n    \"\"\"\n    count_map: Dict[Union[int, float], int] = {}\n    for num in numbers:\n        count_map[num] = count_map.get(num, 0) + 1\n\n    unique_ordered_list: List[Union[int, float]] = []\n    for num in numbers:\n        if count_map[num] == 1:\n            unique_ordered_list.append(num)\n    return unique_ordered_list"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Elements are arranged as list1[i], list2[i], list3[i] for each index i.\n    \"\"\"\n    length = len(list1)\n    result = []\n    for i in range(length):\n        result.append(list1[i])\n        result.append(list2[i])\n        result.append(list3[i])\n    return result"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(number: int) -> int:\n    \"\"\"\n    Calculates the last digit of the factorial of a given non-negative integer.\n    \"\"\"\n    if number < 0:\n        return 0  # Factorial is not defined for negative numbers, returning 0 as per common interpretation for last digit.\n    if number >= 5:\n        return 0  # Factorials of numbers 5 or greater will always end in 0.\n\n    # Calculate factorial for numbers less than 5\n    if number == 0:\n        return 1\n    elif number == 1:\n        return 1\n    elif number == 2:\n        return 2\n    elif number == 3:\n        return 6\n    elif number == 4:\n        return 24 % 10  # 24 % 10 = 4"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Finds elements present in one input tuple but not in the other.\n    Returns a new tuple containing the dissimilar elements, sorted in ascending order.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    dissimilar_elements = set1.symmetric_difference(set2)\n    sorted_dissimilar = sorted(list(dissimilar_elements))\n    return tuple(sorted_dissimilar)"}
{"task_id": "Mbpp/583", "solution": "import math\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Catalan number using the formula Cn = C(2n, n) / (n + 1).\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    binomial_coefficient = math.comb(2 * n, n)\n    return binomial_coefficient // (n + 1)"}
