{"task_id": "Mbpp/440", "solution": "import string\ndef _clean_word(word: str) -> str:\n    \"\"\"Removes leading and trailing punctuation from a word.\"\"\"\n    return word.strip(string.punctuation)\ndef _is_adverb(word: str) -> bool:\n    \"\"\"Determines if a given word (after cleaning) is an adverb using a simple heuristic based on the '-ly' suffix.\"\"\"\n    # This is a basic placeholder; a real-world solution would use NLP libraries or a more comprehensive dictionary.\n    # We check for the common '-ly' suffix and exclude a few common words that end in '-ly' but are typically adjectives.\n    return word.endswith(\"ly\") and word.lower() not in {\"friendly\", \"lovely\", \"ugly\", \"daily\", \"early\", \"elderly\", \"ghastly\", \"holy\", \"lonely\", \"silly\", \"worldly\"}\ndef find_adverb_position(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Returns a tuple (start_index, end_index, adverb_string) or None if no adverb is found.\n    \"\"\"\n    current_pos_in_sentence = 0\n    words_in_sentence = sentence.split()\n\n    for original_word_with_punct in words_in_sentence:\n        # Find the start index of the current word (with punctuation) in the original sentence.\n        # The search starts from `current_pos_in_sentence` to correctly handle whitespace and subsequent words.\n        start_idx_original_word_in_sentence = sentence.find(original_word_with_punct, current_pos_in_sentence)\n        \n        # If the word from split() isn't found, advance the position and continue.\n        # This can happen with unusual spacing or if a word is an empty string after multiple delimiters.\n        if start_idx_original_word_in_sentence == -1:\n            current_pos_in_sentence += len(original_word_with_punct) + 1 # +1 for a potential space\n            continue\n\n        cleaned_word = _clean_word(original_word_with_punct)\n\n        if _is_adverb(cleaned_word):\n            # Calculate the precise start index of the cleaned adverb within the original sentence.\n            # This accounts for any leading punctuation that was stripped.\n            num_leading_punct = len(original_word_with_punct) - len(original_word_with_punct.lstrip(string.punctuation))\n            start_adverb_idx = start_idx_original_word_in_sentence + num_leading_punct\n            end_adverb_idx = start_adverb_idx + len(cleaned_word)\n            return (start_adverb_idx, end_adverb_idx, cleaned_word)\n\n        # Update current_pos_in_sentence for the next iteration to begin search after the current word.\n        current_pos_in_sentence = start_idx_original_word_in_sentence + len(original_word_with_punct)\n\n    return None"}
