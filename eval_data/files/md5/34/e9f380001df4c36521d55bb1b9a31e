{"task_id": "Mbpp/792", "solution": "def count_list(number_of_lists):\n    \"\"\"\n    Counts the number of lists within a given collection of items.\n    \"\"\"\n    count = 0\n    for item in number_of_lists:\n        if isinstance(item, list):\n            count += 1\n    return count"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Natural numbers are positive integers (1, 2, 3, ...).\n    \"\"\"\n    total_sum = 0\n    # Iterate through each number in the range from l to r (inclusive)\n    for num in range(l, r + 1):\n        # Check if the number is a natural number (positive) and odd\n        if num > 0 and num % 2 != 0:\n            total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/793", "solution": "def last(arr, ele):\n    \"\"\"\n    Finds the last position of an element in a sorted array using binary search.\n    Returns the highest index of the element, or -1 if not found.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == ele:\n            result = mid\n            low = mid + 1  # Try to find the element further to the right\n        elif arr[mid] < ele:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"Counts the number of equal integers among three given inputs.\n    Returns 3 if all are equal, 2 if two are equal, and 1 if all are distinct.\n    \"\"\"\n    if a == b and b == c:\n        return 3\n    elif a == b or b == c or a == c:\n        return 2\n    else:\n        return 1"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(input_string: str) -> str:\n    \"\"\"Removes all whitespace characters from the input string.\"\"\"\n    return input_string.replace(' ', '')"}
{"task_id": "Mbpp/803", "solution": "import math\ndef is_perfect_square(number):\n    \"\"\"\n    Checks if a given number is a perfect square.\n    It returns True if the number is a perfect square, False otherwise.\n    \"\"\"\n    if number < 0:\n        return False\n    \n    # Calculate the square root of the number\n    sqrt_num = math.sqrt(number)\n    \n    # A number is a perfect square if its square root is an integer\n    return sqrt_num % 1 == 0"}
{"task_id": "Mbpp/798", "solution": "from typing import List, Union\ndef _sum(arr: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the sum of elements in a list.\n    Returns the arithmetic sum of the elements in the list.\n    \"\"\"\n    return sum(arr)"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(number: int, d: int) -> int:\n    \"\"\"\n    Performs a left bit rotation on a 32-bit integer.\n\n    Args:\n        number (int): The integer to be rotated. Treated as a 32-bit unsigned integer.\n        d (int): The number of bits to rotate left.\n\n    Returns:\n        int: The result of the left bit rotation, masked to 32 bits.\n    \"\"\"\n    BIT_LENGTH = 32\n    # Normalize d to ensure it's within [0, BIT_LENGTH-1], handling wrap-around for large d.\n    d_normalized = d % BIT_LENGTH\n\n    # Perform the left shift, combine with the wrapped-around bits, and mask to 32 bits.\n    rotated_value = ((number << d_normalized) | (number >> (BIT_LENGTH - d_normalized))) & (2**BIT_LENGTH - 1)\n\n    return rotated_value"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers: list) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    Returns True if the product is even, False otherwise.\n    \"\"\"\n    if not numbers:\n        # BR2: If the list is empty, the product is considered 1 (multiplicative identity), which is odd.\n        return False\n\n    for num in numbers:\n        # BR1: The product is even if any number in the list is even.\n        # This includes 0, as 0 is an even number and makes the product 0.\n        if num % 2 == 0:\n            return True\n\n    # If no even numbers were found, all numbers are odd, so their product is odd.\n    return False"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(first_tuple, second_tuple):\n    \"\"\"\n    Checks if each element of the second tuple is smaller than its corresponding element in the first tuple.\n    Returns True if all elements in the second tuple are smaller, False otherwise.\n    \"\"\"\n    return all(b < a for a, b in zip(first_tuple, second_tuple))"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers: list[int]) -> int | None:\n    \"\"\"\n    Finds the first odd number in a given list of integers.\n\n    Returns the first odd integer encountered, or None if the list is empty or contains no odd numbers.\n    \"\"\"\n    for number in numbers:\n        if number % 2 != 0:\n            return number\n    return None"}
{"task_id": "Mbpp/805", "solution": "from typing import List, Union\nclass InnerListWrapper:\n    \"\"\"Encapsulates an inner list and its calculated sum.\"\"\"\n    def __init__(self, elements: List[Union[int, float]]):\n        self.elements = elements\n        self._sum = sum(elements)\n\n    def get_sum(self) -> Union[int, float]:\n        \"\"\"Returns the calculated sum of the inner list.\"\"\"\n        return self._sum\nclass MaxSumListProcessor:\n    \"\"\"Manages wrapped inner lists and identifies the one with the highest sum.\"\"\"\n    def __init__(self, list_of_lists: List[List[Union[int, float]]]):\n        self._inner_list_wrappers = [InnerListWrapper(inner_list) for inner_list in list_of_lists]\n\n    def find_max_sum_list(self) -> List[Union[int, float]]:\n        \"\"\"Iterates through wrapped lists, finds and returns the original elements of the list with the highest sum.\"\"\"\n        if not self._inner_list_wrappers:\n            return []\n\n        max_sum = -float('inf')\n        max_list_elements = []\n\n        for wrapper in self._inner_list_wrappers:\n            current_sum = wrapper.get_sum()\n            if current_sum > max_sum:\n                max_sum = current_sum\n                max_list_elements = wrapper.elements\n        \n        return max_list_elements\ndef max_sum_list(input_list_of_lists: List[List[Union[int, float]]]) -> List[Union[int, float]]:\n    \"\"\"\n    Returns the list in a list of lists whose sum of elements is the highest.\n    It delegates processing to MaxSumListProcessor to find the result.\n    \"\"\"\n    processor = MaxSumListProcessor(input_list_of_lists)\n    return processor.find_max_sum_list()"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Calculates the maximum consecutive uppercase character count in a given string.\n    Returns 0 if the string is empty or contains no uppercase characters.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n        else:\n            current_run = 0\n        max_run = max(max_run, current_run)\n    return max_run"}
{"task_id": "Mbpp/808", "solution": "def check_K(input_tuple: tuple, k: int) -> bool:\n    \"\"\"Checks if the integer k is present within the input_tuple.\"\"\"\n    return k in input_tuple"}
