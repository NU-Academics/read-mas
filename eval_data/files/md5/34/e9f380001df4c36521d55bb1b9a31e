{"task_id": "Mbpp/260", "solution": "def newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman-Shanks-Williams prime number by iterating through the sequence.\n    \"\"\"\n\n    def _get_nsw_term(k: int) -> int:\n        \"\"\"\n        Calculates the k-th term of the Newman-Shanks-Williams sequence.\n        S_k = 2*S_{k-1} + S_{k-2}, with S_0 = 1, S_1 = 1.\n        \"\"\"\n        if k == 0:\n            return 1\n        if k == 1:\n            return 1\n        \n        s_prev2 = 1  # Corresponds to S_0\n        s_prev1 = 1  # Corresponds to S_1\n        \n        for _ in range(2, k + 1):\n            s_current = 2 * s_prev1 + s_prev2\n            s_prev2 = s_prev1\n            s_prev1 = s_current\n            \n        return s_prev1\n\n    def _is_prime(num: int) -> bool:\n        \"\"\"\n        Checks if a given number is a prime number.\n        \"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        \n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    prime_count = 0\n    k = 0\n    while True:\n        current_nsw_term = _get_nsw_term(k)\n        if _is_prime(current_nsw_term):\n            prime_count += 1\n            if prime_count == n:\n                return current_nsw_term\n        k += 1"}
{"task_id": "Mbpp/259", "solution": "def maximize_elements(tuple_collection_A: tuple[tuple[int, int], ...], tuple_collection_B: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:\n    \"\"\"\n    Maximizes elements between two corresponding tuple collections.\n    Returns a new tuple collection where each inner tuple's elements are the maximum.\n    \"\"\"\n    result_collection = []\n    for i in range(len(tuple_collection_A)):\n        inner_tuple_A = tuple_collection_A[i]\n        inner_tuple_B = tuple_collection_B[i]\n\n        max_val1 = max(inner_tuple_A[0], inner_tuple_B[0])\n        max_val2 = max(inner_tuple_A[1], inner_tuple_B[1])\n\n        result_collection.append((max_val1, max_val2))\n\n    return tuple(result_collection)"}
{"task_id": "Mbpp/265", "solution": "def list_split(input_list: list, n: int) -> list[list]:\n    \"\"\"\n    Splits an input list into 'n' sub-lists, distributing elements based on their original index modulo 'n'.\n    Maintains relative order within each resulting sub-list.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    if not input_list:\n        return []\n\n    result_list_of_lists = [[] for _ in range(n)]\n\n    for i, element in enumerate(input_list):\n        target_index = i % n\n        result_list_of_lists[target_index].append(element)\n\n    return result_list_of_lists"}
