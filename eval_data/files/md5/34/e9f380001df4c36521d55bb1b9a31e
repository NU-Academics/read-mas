{"task_id": "Mbpp/745", "solution": "def _get_digits(number: int) -> list[int]:\n    \"\"\"Extracts individual digits from an integer.\"\"\"\n    return [int(d) for d in str(number)]\ndef _is_divisible_by_all_digits(number: int, digits: list[int]) -> bool:\n    \"\"\"Checks if a number is divisible by all its non-zero digits.\"\"\"\n    for digit in digits:\n        if digit == 0 or number % digit != 0:\n            return False\n    return True\ndef divisible_by_digits(startNum: int, endNum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range (inclusive) where every number\n    is divisible by every non-zero digit it contains.\n    \"\"\"\n    found_numbers = []\n    for num in range(startNum, endNum + 1):\n        digits = _get_digits(num)\n        if _is_divisible_by_all_digits(num, digits):\n            found_numbers.append(num)\n    return found_numbers"}
{"task_id": "Mbpp/749", "solution": "def _convert_strings_to_numbers(string_list: list[str]) -> list[int]:\n    \"\"\"Converts a list of string representations of numbers to a list of integers.\"\"\"\n    return [int(s) for s in string_list]\ndef _sort_numbers_ascending(number_list: list[int]) -> list[int]:\n    \"\"\"Sorts a list of integers in ascending order.\"\"\"\n    return sorted(number_list)\ndef sort_numeric_strings(string_list: list[str]) -> list[int]:\n    \"\"\"Sorts a given list of strings of numbers numerically in ascending order.\"\"\"\n    numerical_list = _convert_strings_to_numbers(string_list)\n    sorted_numerical_list = _sort_numbers_ascending(numerical_list)\n    return sorted_numerical_list"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Inserts spaces before words starting with capital letters in a string,\n    excluding the first word.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    result = [input_string[0]] # Start with the first character\n\n    for char in input_string[1:]: # Iterate from the second character\n        if char.isupper():\n            result.append(\" \")\n        result.append(char)\n\n    return \"\".join(result)"}
{"task_id": "Mbpp/750", "solution": "def add_tuple(target_list: list, source_tuple: tuple) -> list:\n    \"\"\"Appends all elements from source_tuple to the end of target_list.\n    Returns the modified target_list.\"\"\"\n    target_list.extend(source_tuple)\n    return target_list"}
{"task_id": "Mbpp/753", "solution": "def min_k(tuple_list: list[tuple], k: int) -> list[tuple]:\n    \"\"\"\n    Finds the k tuples with the smallest second element from a list and returns them sorted.\n    Handles cases where k is greater than the list length by returning all available elements.\n    \"\"\"\n    sorted_list = sorted(tuple_list, key=lambda x: x[1])\n    return sorted_list[:k]"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    An array represents a min-heap if for every parent node, its value is less than or equal to its children's values.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    # Iterate from the last non-leaf node up to the root\n    for i in range((n // 2) - 1, -1, -1):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers: list) -> float | int:\n    \"\"\"Finds the second smallest number in a list of numbers.\n\n    Assumes the list contains at least two numeric elements.\n    \"\"\"\n    numbers.sort()\n    return numbers[1]"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"Calculates the nth Jacobsthal number using an iterative approach.\n    The sequence starts with J(0)=0, J(1)=1, and J(n) = J(n-1) + 2*J(n-2) for n > 1.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        # Initialize J(0) and J(1)\n        a, b = 0, 1\n        # Iterate from J(2) up to J(n)\n        for _ in range(2, n + 1):\n            a, b = b, a + 2 * b\n        return b"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1: list, l2: list, l3: list) -> list:\n    \"\"\"\n    Finds elements that appear at the same index in all three input lists.\n    Returns a new list containing these common elements.\n    \"\"\"\n    common_elements = []\n    min_length = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_length):\n        if l1[i] == l2[i] and l2[i] == l3[i]:\n            common_elements.append(l1[i])\n            \n    return common_elements"}
{"task_id": "Mbpp/758", "solution": "from typing import Any, List, Dict, Tuple\nfrom collections import Counter\ndef unique_sublists(input_list: List[List[Any]]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"\n    Counts lists within a list, converting each sublist to a tuple and\n    returning a dictionary of their occurrences.\n    \"\"\"\n    if not input_list:\n        return {}\n\n    converted_tuples = [tuple(sublist) for sublist in input_list]\n\n    return dict(Counter(converted_tuples))"}
{"task_id": "Mbpp/757", "solution": "def _reverse_string(s: str) -> str:\n    \"\"\"\n    Reverses the input string.\n    \"\"\"\n    return s[::-1]\ndef count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"\n    Counts unique pairs of reverse strings in the given list.\n    A pair (s1, s2) is a reverse pair if s1 is the exact reverse of s2.\n    (s1, s2) and (s2, s1) are considered the same unique pair.\n    \"\"\"\n    count = 0\n    processed_strings = set()\n    string_set = set(string_list) # Use a set for O(1) average time lookups\n\n    for s in string_list:\n        if s not in processed_strings:\n            reversed_s = _reverse_string(s)\n            \n            # Check if reversed string exists in the list and is not the same string (to avoid palindromes being counted as pairs)\n            # and if the reversed string itself hasn't already been processed as part of another pair\n            if s != reversed_s and reversed_s in string_set and reversed_s not in processed_strings:\n                count += 1\n                processed_strings.add(s)\n                processed_strings.add(reversed_s)\n    return count"}
{"task_id": "Mbpp/760", "solution": "from typing import List, Union\ndef unique_Element(number_list: List[Union[int, float]]) -> bool:\n    \"\"\"\n    Checks if a list of numbers contains only one distinct element.\n    Returns True if the list is empty, contains one element, or all elements are identical.\n    \"\"\"\n    return len(set(number_list)) <= 1"}
{"task_id": "Mbpp/759", "solution": "import re\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Checks if the given string represents a decimal number with a precision of 2.\n    It verifies optional sign, at least one digit, and exactly two digits after a decimal point if present.\n    \"\"\"\n    pattern = r\"^[+-]?(\\d+|\\d*\\.\\d{2})$\"\n    return bool(re.fullmatch(pattern, input_string))"}
{"task_id": "Mbpp/762", "solution": "def check_monthnumber_number(month_number: int) -> bool:\n    \"\"\"\n    Checks if the given month number (1-12) corresponds to a month containing exactly 30 days.\n    Months with 30 days are April (4), June (6), September (9), and November (11).\n    \"\"\"\n    return month_number in (4, 6, 9, 11)"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(arr: tuple, n: int) -> int:\n    \"\"\"\n    Finds the minimum difference between any two elements in a given array.\n    The array is sorted first to simplify finding adjacent differences.\n    \"\"\"\n    if n < 2:\n        return 0  # Or handle as an error/edge case if differences are not possible\n\n    sorted_arr = sorted(arr)\n    min_diff = float('inf')\n\n    for i in range(n - 1):\n        diff = sorted_arr[i+1] - sorted_arr[i]\n        if diff < min_diff:\n            min_diff = diff\n    \n    return min_diff"}
{"task_id": "Mbpp/765", "solution": "def calculateNthPoliteNumber(n: int) -> int:\n    \"\"\"\n    Calculates the nth polite number.\n    A polite number is any positive integer that is not a power of 2.\n    \"\"\"\n    count = 0\n    num = 1\n    while True:\n        # Check if num is NOT a power of 2 (i.e., it is a polite number).\n        # A positive integer x is a power of 2 if (x & (x - 1)) == 0.\n        if (num & (num - 1)) != 0:\n            count += 1\n            if count == n:\n                return num\n        num += 1"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(s: str) -> int:\n    \"\"\"\n    Counts the number of digits in a given string.\n    \"\"\"\n    digit_count = 0\n    for char in s:\n        if char.isdigit():\n            digit_count += 1\n    return digit_count"}
{"task_id": "Mbpp/766", "solution": "from typing import List, Tuple, Any\ndef pair_wise(input_list: List[Any]) -> List[Tuple[Any, Any]]:\n    \"\"\"\n    Generates a list of consecutive item pairs from an input list.\n    Returns an empty list if the input list has fewer than two elements.\n    \"\"\"\n    result = []\n    if len(input_list) < 2:\n        return []\n\n    for i in range(len(input_list) - 1):\n        result.append((input_list[i], input_list[i+1]))\n\n    return result"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list[int], target_sum: int) -> int:\n    \"\"\"\n    Counts the number of pairs in a list of integers that sum up to a given target,\n    including pairs formed by duplicate numbers at different indices.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression_string: str) -> bool:\n    \"\"\"\n    Checks if the given expression string has balanced pairs of brackets.\n    Uses a stack to track opening brackets and validate matching closing brackets.\n    \"\"\"\n    stack = []\n    opening_brackets = \"([{\"\n    matching_brackets = {')': '(', ']': '[', '}': '{'}\n\n    for char in expression_string:\n        if char in opening_brackets:\n            stack.append(char)\n        elif char in matching_brackets:\n            if not stack or stack.pop() != matching_brackets[char]:\n                return False\n    \n    return not stack"}
{"task_id": "Mbpp/772", "solution": "def remove_length(input_string: str, k: int) -> str:\n    \"\"\"\n    Removes all words of length k from the input string.\n\n    Args:\n        input_string: The string to process.\n        k: The specific word length to remove.\n\n    Returns:\n        A new string with words of length k removed, preserving order.\n    \"\"\"\n    words = input_string.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n):\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    \"\"\"\n    total_sum = 0\n    for i in range(n):\n        odd_num = 2 * i + 1\n        total_sum += odd_num ** 4\n    return total_sum"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1: list, list2: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists.\n\n    Returns a new list containing elements from list1 that are not present in list2.\n    \"\"\"\n    set2 = set(list2)\n    result = []\n    for item in list1:\n        if item not in set2:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(main_string: str, search_substring: str) -> tuple[str, int, int] | None:\n    \"\"\"Finds the first occurrence and position of a substring within a string.\n    Returns a tuple (matched_substring, start_index, end_index) or None if not found.\n    \"\"\"\n    start_index = main_string.find(search_substring)\n\n    if start_index == -1:\n        return None\n    else:\n        end_index = start_index + len(search_substring)\n        return (search_substring, start_index, end_index)"}
{"task_id": "Mbpp/775", "solution": "def odd_position(input_list):\n    \"\"\"\n    Checks whether every odd index contains odd numbers of a given list.\n    Returns True if all conditions are met or the list has no odd indices; otherwise, returns False.\n    \"\"\"\n    for i, element in enumerate(input_list):\n        if i % 2 != 0:  # Check if the current index is odd\n            if element % 2 == 0:  # Check if the element at the odd index is even\n                return False\n    return True"}
{"task_id": "Mbpp/777", "solution": "def find_sum(input_list: list) -> int:\n    \"\"\"Calculates the sum of non-repeated elements in a given list.\n\n    An element is considered 'non-repeated' if its count within the given list is exactly one.\n    \"\"\"\n    element_counts = {}\n    for element in input_list:\n        element_counts[element] = element_counts.get(element, 0) + 1\n\n    sum_non_repeated = 0\n    for element, count in element_counts.items():\n        if count == 1:\n            sum_non_repeated += element\n\n    return sum_non_repeated"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list[list]:\n    \"\"\"\n    Packs consecutive duplicates of a given list elements into sublists.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_sublist = []\n\n    for element in input_list:\n        if not current_sublist or element == current_sublist[0]:\n            current_sublist.append(element)\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [element]\n\n    if current_sublist:\n        packed_list.append(current_sublist)\n\n    return packed_list"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_string: str) -> tuple[int, ...]:\n    \"\"\"Converts a string representation of an integer tuple to a native integer tuple.\n\n    This function parses the input string, removes parentheses, splits by comma,\n    converts each element to an integer, and returns the result as a tuple.\n    \"\"\"\n    # Remove outer parentheses\n    content_str = tuple_string[1:-1]\n\n    # Handle empty tuple case\n    if not content_str.strip():\n        return ()\n\n    # Split the string by comma, strip whitespace from each part, and convert to int\n    elements = [int(e.strip()) for e in content_str.split(',')]\n\n    return tuple(elements)"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(integer_input: int) -> bool:\n    \"\"\"\n    Calculates the total number of positive divisors for the input integer\n    and determines if the count is an even number.\n    \"\"\"\n    divisor_count = 0\n    for i in range(1, integer_input + 1):\n        if integer_input % i == 0:\n            divisor_count += 1\n    return divisor_count % 2 == 0"}
{"task_id": "Mbpp/780", "solution": "import itertools\ndef find_combinations(tuple_list: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    \"\"\"\n    Finds all unique combinations of sums with tuples in the given tuple list.\n\n    Args:\n        tuple_list: A list of tuples, where each tuple contains two integers.\n\n    Returns:\n        A list of summed tuples, where each summed tuple is the element-wise\n        sum of two distinct tuples from the input list.\n    \"\"\"\n    result_sums = []\n    for t1, t2 in itertools.combinations(tuple_list, 2):\n        sum_tuple = (t1[0] + t2[0], t1[1] + t2[1])\n        result_sums.append(sum_tuple)\n    return result_sums"}
{"task_id": "Mbpp/784", "solution": "from typing import List, Optional\nclass ListOfNumbersProcessor:\n    \"\"\"\n    Manages a list of numbers and provides methods to find the first odd and even numbers.\n    \"\"\"\n    def __init__(self, numbers: List[int]):\n        self._numbers = numbers\n\n    def find_first_odd(self) -> Optional[int]:\n        \"\"\"Iterates through the list to find and return the first odd number.\"\"\"\n        for num in self._numbers:\n            if num % 2 != 0:\n                return num\n        return None\n\n    def find_first_even(self) -> Optional[int]:\n        \"\"\"Iterates through the list to find and return the first even number.\"\"\"\n        for num in self._numbers:\n            if num % 2 == 0:\n                return num\n        return None\ndef mul_even_odd(numbers: List[int]) -> Optional[int]:\n    \"\"\"\n    Finds the product of the first even and odd number in a given list.\n    Returns None if either number is not found.\n    \"\"\"\n    processor = ListOfNumbersProcessor(numbers)\n    first_odd_num = processor.find_first_odd()\n    first_even_num = processor.find_first_even()\n\n    if first_odd_num is not None and first_even_num is not None:\n        return first_odd_num * first_even_num\n    else:\n        return None"}
{"task_id": "Mbpp/788", "solution": "def new_tuple(input_list: list, input_string: str) -> tuple:\n    \"\"\"\n    Creates a new tuple by combining elements from the given list and appending the string.\n    \"\"\"\n    return tuple(input_list) + (input_string,)"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int | float]) -> int | float:\n    \"\"\"\n    Calculates the sum of all elements in all odd-length subarrays of the input array.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        for j in range(i, n):\n            # The current subarray is arr[i:j+1]\n            sub_length = j - i + 1\n            if sub_length % 2 != 0:\n                # If the subarray length is odd, sum its elements\n                for k in range(i, j + 1):\n                    total_sum += arr[k]\n    return total_sum"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list, value):\n    \"\"\"\n    Locates the right insertion point for a specified value in a sorted list.\n    This implementation uses binary search to find the index where the value should be inserted\n    to maintain sorted order.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/790", "solution": "def even_position(list_of_numbers: list) -> bool:\n    \"\"\"\n    Checks if every number at an even index (0-based) in a list is an even number.\n    Returns True if all numbers at even indices are even, False otherwise.\n    \"\"\"\n    for i in range(len(list_of_numbers)):\n        if i % 2 == 0:  # Check if the current index is even\n            if list_of_numbers[i] % 2 != 0:  # Check if the number at this even index is odd\n                return False\n    return True"}
