{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number a(n, m) for given non-negative integers n and m.\n    \"\"\"\n\n    def _factorial(k: int) -> int:\n        \"\"\"Helper function to calculate the factorial of a non-negative integer.\"\"\"\n        if k < 0:\n            return 0  # Factorial is not defined for negative numbers in this context\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    def _binomial_coefficient(n_val: int, k_val: int) -> int:\n        \"\"\"Helper function to calculate the binomial coefficient C(n, k).\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n\n        # C(n, k) = n! / (k! * (n-k)!)\n        # Optimized calculation for C(n, k) to avoid large intermediate factorials\n        res = 1\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    if n < 0 or m < 0 or m >= n:\n        return 0\n    \n    if n == 0 and m == 0:\n        return 1\n\n    # The design context sequence diagram implies using the identity A(n,m) = A(n, n-1-m)\n    # The sum formula provided in the diagram is for A(n, n-1-m).\n    # m_prime corresponds to 'm' in the standard sum formula using the identity.\n    m_prime = n - 1 - m\n\n    total_sum = 0\n    for k in range(m_prime + 1):\n        term = ((-1)**k) * _binomial_coefficient(n + 1, k) * ((m_prime - k + 1)**n)\n        total_sum += term\n        \n    return total_sum"}
{"task_id": "Mbpp/104", "solution": "def sort_sublists(input_list_of_lists: list[list[str]]) -> list[list[str]]:\n    \"\"\"\n    Sorts each sublist of strings in the given list of lists in ascending lexicographical order.\n    Returns a new list of lists with each sublist sorted, preserving the original order of sublists.\n    \"\"\"\n    sorted_list_of_lists = []\n    for sublist in input_list_of_lists:\n        sorted_sublist = sorted(sublist)\n        sorted_list_of_lists.append(sorted_sublist)\n    return sorted_list_of_lists"}
