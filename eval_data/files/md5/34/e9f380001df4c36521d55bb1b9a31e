{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if a given positive integer is undulating.\n    An undulating number has digit[i] == digit[i+2] for all valid i.\n    \"\"\"\n    if number < 0:\n        return False\n\n    s_number = str(number)\n    n = len(s_number)\n\n    # Numbers with less than 3 digits are considered non-undulating\n    # as the condition digit[i] == digit[i+2] cannot be fully met.\n    # For example, 1, 12. If interpreted otherwise, 1 and 11 might be\n    # considered undulating by trivially satisfying the condition,\n    # but the design context suggests a pattern that needs at least 3 digits.\n    # However, for 121, i=0 means s_number[0] == s_number[2].\n    # The assert is_undulating(1212121) implies this interpretation.\n    if n < 3:\n        return False\n\n    for i in range(n - 2):\n        if s_number[i] != s_number[i+2]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/94", "solution": "from typing import List, Tuple, Any, TypeVar\nComparable = TypeVar('Comparable', bound='object')\ndef index_minimum(list_of_tuples: List[Tuple[Any, Comparable]]) -> Any:\n    \"\"\"\n    Identifies the tuple with the smallest second value in a list and returns its first element.\n    Returns None if the input list is empty.\n    \"\"\"\n    if not list_of_tuples:\n        return None\n\n    min_tuple = None\n    min_second_value = None\n\n    for current_tuple in list_of_tuples:\n        current_second_value = current_tuple[1]\n\n        if min_tuple is None or current_second_value < min_second_value:\n            min_second_value = current_second_value\n            min_tuple = current_tuple\n\n    return min_tuple[0]"}
{"task_id": "Mbpp/96", "solution": "import math\ndef divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer.\n    The algorithm iterates up to the square root of n to find divisor pairs.\n    \"\"\"\n    count = 0\n    # Iterate from 1 up to the square root of n (inclusive).\n    # math.isqrt is more efficient and handles perfect squares correctly.\n    for i in range(1, math.isqrt(n) + 1):\n        if n % i == 0:\n            # i is a divisor\n            count += 1\n            # If i*i != n, then n/i is another distinct divisor\n            if i * i != n:\n                count += 1\n    return count"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal integer to its binary string equivalent.\n    The returned string will not have leading zeros, unless the input is 0, in which case it returns '0'.\n    \"\"\"\n    # Use the built-in bin() function to get the binary representation.\n    # It returns a string prefixed with '0b', which is removed by slicing.\n    return bin(decimal_number)[2:]"}
{"task_id": "Mbpp/98", "solution": "import math\ndef multiply_num(numbers):\n    \"\"\"\n    Multiplies all numbers in a list and divides the product by the list's length.\n    Returns 0 if the list is empty to avoid division by zero.\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    product = 1.0\n    for num in numbers:\n        product *= num\n\n    length = len(numbers)\n    return product / length"}
