s_prev = s_current\n\n        return s_prev\nclass PrimeValidator:\n    def is_prime(self, num: int) -> bool:\n        if not isinstance(num, int):\n            # As per design, although not explicitly for negative numbers in is_prime's error handling.\n            # The design for is_prime states \"If num is not an integer or is negative, raise a ValueError.\"\n            # The current implementation returns False for negative, 0, and 1.\n            # Sticking to the design of raising ValueError for non-int.\n            raise ValueError(\"Input 'num' must be an integer.\")\n        if num <= 1:\n            return False\n        if num <= 3:\n            return True # 2 and 3 are prime\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\nclass NewmanPrimeService:\n    def __init__(self, nsw_calculator: NSWCalculator, prime_validator: PrimeValidator):\n        self._nsw_calculator = nsw_calculator\n        self._prime_validator = prime_validator\n\n    def find_nth_nsw_prime(self, n: int) -> int:\n        if n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n        nsw_number = self._nsw_calculator.calculate_nsw_number(n)\n\n        if not self._prime_validator.is_prime(nsw_number):\n            raise NotNSWPrimeError(f\"The {n}-th Newman-Shanks-Williams number ({nsw_number}) is not prime.\")\n\n        return nsw_number\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman-Shanks-Williams prime number.\n    Raises ValueError if n is negative.\n    Raises NotNSWPrimeError if the nth NSW number is not prime.\n    \"\"\"\n    calculator = NSWCalculator()\n    validator = PrimeValidator()\n    service = NewmanPrimeService(calculator, validator)\n    return service.find_nth_nsw_prime(n)", "base_status": "pass", "plus_status": "fail