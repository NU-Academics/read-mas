{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n\n    class InputParameter:\n        \"\"\"Holds the validated input integer.\"\"\"\n        def __init__(self, n_val: int):\n            self.n = n_val\n\n    class DecimalRepresentation:\n        \"\"\"Represents an integer's base-10 string form without leading zeros.\"\"\"\n        def __init__(self, value: int):\n            self.digits = str(value)\n\n    class DigitOccurrence:\n        \"\"\"Represents occurrences of a specific digit.\"\"\"\n        def __init__(self, digit: str, occurrences: int):\n            self.digit = digit\n            self.occurrences = occurrences\n\n    class Result:\n        \"\"\"Holds the aggregated total count of '7' occurrences.\"\"\"\n        def __init__(self, totalSevenCount: int):\n            self.totalSevenCount = totalSevenCount\n\n    def _validate_input(n_input) -> InputParameter:\n        \"\"\"Enforces the input contract, raising TypeError if n is not an integer.\"\"\"\n        if not isinstance(n_input, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        return InputParameter(n_input)\n\n    def _to_decimal_representation(value: int) -> DecimalRepresentation:\n        \"\"\"Converts an integer to its DecimalRepresentation.\"\"\"\n        return DecimalRepresentation(value)\n\n    def _count_sevens_in_decimal(decimal: DecimalRepresentation) -> DigitOccurrence:\n        \"\"\"Counts occurrences of '7' in the given DecimalRepresentation.\"\"\"\n        return DigitOccurrence('7', decimal.digits.count('7'))\n\n    class IntegerCandidate:\n        \"\"\"Represents a candidate integer and exposes behavior to count '7' digits.\"\"\"\n        def __init__(self, value: int):\n            self.value = value\n            self.divisibleBy11 = (value % 11 == 0)\n            self.divisibleBy13 = (value % 13 == 0)\n\n        def countSevenDigits(self) -> DigitOccurrence:\n            \"\"\"Counts occurrences of the digit '7' in the integer's decimal representation.\"\"\"\n            decimal_rep = _to_decimal_representation(self.value)\n            return _count_sevens_in_decimal(decimal_rep)\n\n    def _enumerate_candidates(input_param: InputParameter) -> list[IntegerCandidate]:\n        \"\"\"Enumerates integers less than n which are divisible by 11 or 13.\"\"\"\n        candidates = []\n        for i in range(input_param.n):\n            if (i % 11 == 0 or i % 13 == 0):\n                candidates.append(IntegerCandidate(i))\n        return candidates\n\n    def _aggregate_result(digit_occurrences: list[DigitOccurrence]) -> Result:\n        \"\"\"Aggregates the total '7' count from a list of DigitOccurrence objects.\"\"\"\n        total = sum(d.occurrences for d in digit_occurrences)\n        return Result(total)\n\n    # Orchestration logic\n    input_param = _validate_input(n)\n    candidates = _enumerate_candidates(input_param)\n\n    all_digit_occurrences = []\n    for candidate in candidates:\n        all_digit_occurrences.append(candidate.countSevenDigits())\n\n    final_result = _aggregate_result(all_digit_occurrences)\n    return final_result.totalSevenCount"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    return SortEvenFunction().sort_even(l)\n\nclass SortEvenFunction:\n    \"\"\"Orchestrates extraction, sorting, and reconstruction of a list based on index parity.\"\"\"\n\n    def sort_even(self, l: list) -> list:\n        \"\"\"Processes the input list to sort even-indexed elements while preserving odd-indexed ones.\"\"\"\n        if not l:\n            return []\n\n        evens_values = self.extract_even_indices(l)\n        odds_values = self.extract_odd_indices(l)\n        \n        sorted_evens = self.sort(evens_values)\n        \n        result = self.reconstruct(sorted_evens, odds_values)\n        return result\n\n    def extract_even_indices(self, l: list) -> list:\n        \"\"\"Extracts values from the input list at even indices.\"\"\"\n        return [l[i] for i in range(len(l)) if i % 2 == 0]\n\n    def extract_odd_indices(self, l: list) -> list:\n        \"\"\"Extracts values from the input list at odd indices.\"\"\"\n        return [l[i] for i in range(len(l)) if i % 2 != 0]\n\n    def sort(self, lst: list) -> list:\n        \"\"\"Returns a non-decreasing (ascending) sorted list.\"\"\"\n        return sorted(lst)\n\n    def reconstruct(self, evens: list, odds: list) -> list:\n        \"\"\"Reconstructs the final list using sorted even-indexed values and preserved odd-indexed values.\"\"\"\n        original_length = len(evens) + len(odds)\n        result = [None] * original_length\n\n        even_ptr = 0\n        odd_ptr = 0\n\n        for i in range(original_length):\n            if i % 2 == 0:\n                result[i] = evens[even_ptr]\n                even_ptr += 1\n            else:\n                result[i] = odds[odd_ptr]\n                odd_ptr += 1\n        return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group. Unless group has fewer elements than 3.\n    # For decoding, perform a right rotation: move the last character to the beginning.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "import math\n\nclass Result:\n    \"\"\"Simple container for a prime Fibonacci value and its index.\"\"\"\n    def __init__(self, value: int, index: int):\n        self.value = value\n        self.index = index\n\nclass InputValidator:\n    \"\"\"Validates if an input integer n is valid (n >= 1).\"\"\"\n    def validate(self, n: int) -> bool:\n        \"\"\"Returns True if n is an integer and n >= 1, False otherwise.\"\"\"\n        return isinstance(n, int) and n >= 1\n\nclass FibonacciGenerator:\n    \"\"\"Generates Fibonacci numbers sequentially, starting from 2 (F_3).\"\"\"\n    def __init__(self):\n        self._a: int = 0\n        self._b: int = 0\n        self._index: int = 0\n        self.reset()\n\n    def reset(self) -> None:\n        \"\"\"Resets the Fibonacci sequence to its initial state (F_2=1, F_3=2).\"\"\"\n        self._a = 1  # Corresponds to F_2\n        self._b = 2  # Corresponds to F_3\n        self._index = 3 # Current returned fib_value will be F_3\n\n    def next(self) -> int:\n        \"\"\"Advances and returns the next Fibonacci number in the sequence.\"\"\"\n        current_fib = self._b\n        self._a, self._b = self._b, self._a + self._b\n        self._index += 1\n        return current_fib\n\nclass PrimalityTester:\n    \"\"\"Determines primality of an integer using trial division.\"\"\"\n    def is_prime(self, x: int) -> bool:\n        \"\"\"Returns True if x is prime, False otherwise.\"\"\"\n        if x < 2:\n            return False\n        if x == 2:\n            return True\n        if x % 2 == 0:\n            return False\n        # Only check odd divisors up to the square root of x.\n        for i in range(3, int(math.sqrt(x)) + 1, 2):\n            if x % i == 0:\n                return False\n        return True\n\nclass PrimeFibFunction:\n    \"\"\"Orchestrates finding the n-th Fibonacci number that is also prime.\"\"\"\n    def __init__(self):\n        self._validator = InputValidator()\n        self._generator = FibonacciGenerator()\n        self._tester = PrimalityTester()\n\n    def prime_fib(self, n: int) -> int:\n        \"\"\"Computes and returns the n-th Fibonacci number that is prime.\"\"\"\n        if not self._validator.validate(n):\n            raise ValueError(\"Input n must be an integer >= 1.\")\n\n        self._generator.reset()\n        found_count = 0\n        \n        while True:\n            fib_value = self._generator.next()\n            if self._tester.is_prime(fib_value):\n                found_count += 1\n                if found_count == n:\n                    # The Result class is used for potential metadata, but only value is returned.\n                    result = Result(value=fib_value, index=self._generator._index - 1)\n                    return result.value\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    # Delegates to PrimeFibFunction to compute the result.\n    orchestrator = PrimeFibFunction()\n    return orchestrator.prime_fib(n)"}
{"task_id": "HumanEval/41", "solution": "from typing import Any\n\nclass ValidationError(Exception):\n    \"\"\"\n    Exception raised for invalid input parameters.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return self.message\n\nclass CollisionCount:\n    \"\"\"\n    Data container for the computed collision count value.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass InputParameter:\n    \"\"\"\n    Validates input type and value according to requirement (integer and >= 0).\n    \"\"\"\n    def __init__(self, n_raw: Any) -> None:\n        self.n_raw = n_raw\n\n    def validate(self) -> int:\n        if not isinstance(self.n_raw, int):\n            raise ValidationError(\"n must be an integer\")\n        if self.n_raw < 0:\n            raise ValidationError(\"n must be non-negative\")\n        return self.n_raw\n\nclass CarRace:\n    \"\"\"\n    Encapsulates collision-count computation for a validated integer n.\n    \"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n\n    def computeCollisions(self) -> CollisionCount:\n        return CollisionCount(self.n * self.n)\n\ndef car_race_collision(n: int):\n    \"\"\"\n    Outputs the number of collisions for n cars moving in opposite directions.\n    \"\"\"\n    ip = InputParameter(n)\n    validated_n = ip.validate()\n    race = CarRace(validated_n)\n    result = race.computeCollisions()\n    return result.value"}
{"task_id": "HumanEval/40", "solution": "from typing import List, Optional, Tuple\n\nclass IntegerElement:\n    \"\"\"Represents a list element paired with its integer value and index.\"\"\"\n    def __init__(self, value: int, index: int) -> None:\n        self._value = value\n        self._index = index\n\n    def get_value(self) -> int:\n        return self._value\n\n    def get_index(self) -> int:\n        return self._index\n\nclass InputList:\n    \"\"\"Encapsulates the raw input list, performs element-type validation, and provides length information.\"\"\"\n    def __init__(self, raw_list: list) -> None:\n        self._raw_list = raw_list\n        self._elements: List[IntegerElement] = []\n\n    def validate(self) -> None:\n        \"\"\"Validates that the argument is a list and every element is an integer; raises TypeError on failure.\"\"\"\n        if not isinstance(self._raw_list, list):\n            raise TypeError(\"triples_sum_to_zero: input must be a list of integers\")\n        \n        validated_elements: List[IntegerElement] = []\n        for i, item in enumerate(self._raw_list):\n            if not isinstance(item, int):\n                raise TypeError(\"triples_sum_to_zero: input must be a list of integers\")\n            validated_elements.append(IntegerElement(item, i))\n        self._elements = validated_elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self._elements)\n\nclass Triplet:\n    \"\"\"Represents three IntegerElement items and provides simple checks (sum and index distinctness).\"\"\"\n    def __init__(self, a: IntegerElement, b: IntegerElement, c: IntegerElement) -> None:\n        self._a = a\n        self._b = b\n        self._c = c\n\n    def sum(self) -> int:\n        \"\"\"Returns the sum of the values of the three elements.\"\"\"\n        return self._a.get_value() + self._b.get_value() + self._c.get_value()\n\n    def indices_distinct(self) -> bool:\n        \"\"\"Checks if the indices of the three elements are all distinct.\"\"\"\n        return (self._a.get_index() != self._b.get_index() and\n                self._a.get_index() != self._c.get_index() and\n                self._b.get_index() != self._c.get_index())\n\nclass Result:\n    \"\"\"Simple wrapper holding the boolean result.\"\"\"\n    def __init__(self, value: bool) -> None:\n        self._value = value\n\n    def get_value(self) -> bool:\n        \"\"\"Returns the boolean value.\"\"\"\n        return self._value\n\nclass TripletChecker:\n    \"\"\"Implements algorithmic logic to determine whether any three distinct-index elements sum to zero.\"\"\"\n    def __init__(self) -> None:\n        self._input_list: Optional[InputList] = None\n        self._elements: Optional[List[IntegerElement]] = None\n        self._found_triplet: Optional[Triplet] = None\n\n    def find_zero_sum_triplet(self, input_list: InputList) -> bool:\n        \"\"\"Performs search for a zero-sum triplet, populates _found_triplet when found.\"\"\"\n        self._input_list = input_list\n        self._elements = input_list._elements\n        \n        triplet_indices = self._scan_pairs_for_complement()\n        \n        if triplet_indices is not None:\n            a = self._elements[triplet_indices[0]]\n            b = self._elements[triplet_indices[1]]\n            c = self._elements[triplet_indices[2]]\n            self._found_triplet = Triplet(a, b, c)\n            return True\n        return False\n\n    def _scan_pairs_for_complement(self) -> Optional[Tuple[int, int, int]]:\n        \"\"\"Iterates through combinations of elements and returns indices if a zero-sum triplet is found.\"\"\"\n        if not self._elements:\n            return None\n        \n        n = len(self._elements)\n        \n        for i in range(n - 2):\n            for j in range(i + 1, n - 1):\n                for k in range(j + 1, n):\n                    val_i = self._elements[i].get_value()\n                    val_j = self._elements[j].get_value()\n                    val_k = self._elements[k].get_value()\n                    \n                    if val_i + val_j + val_k == 0:\n                        return (i, j, k)\n        return None\n\ndef triples_sum_to_zero(l: list) -> bool:\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    input_list_obj = InputList(l)\n    input_list_obj.validate()\n\n    if input_list_obj.length() < 3:\n        return False\n\n    checker = TripletChecker()\n    return checker.find_zero_sum_triplet(input_list_obj)"}
{"task_id": "HumanEval/42", "solution": "def incr_list(l: list):\n    \"\"\"Return list with elements incremented by 1.\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    \"\"\"\n    return [x + 1 for x in l]"}
{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    if not isinstance(a, (int, float)) or not isinstance(h, (int, float)):\n        raise TypeError(\"a and h must be int or float\")\n    if a < 0 or h < 0:\n        raise ValueError(\"a and h must be non-negative\")\n\n    if a == 0 or h == 0:\n        return 0.0\n\n    return float((a * h) / 2)"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    if len(l) < 2:\n        return False\n\n    seen_numbers = set()\n    for num in l:\n        complement = -num\n        if complement in seen_numbers:\n            # If the complement exists in the set of previously seen numbers,\n            # then we've found two distinct elements (by index) that sum to zero.\n            return True\n        seen_numbers.add(num)\n\n    return False"}
{"task_id": "HumanEval/44", "solution": "from typing import List\n\nclass Number:\n    \"\"\"Simple value object holding numeric input.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass DigitSet:\n    \"\"\"Provides digit set for a given base (0..base-1).\"\"\"\n    def __init__(self, base: int):\n        self.base = base\n        self.digits = list(range(base))\n\n    def get_digits(self) -> List[int]:\n        \"\"\"Returns the list of digits for the base.\"\"\"\n        return self.digits\n\nclass ConversionResult:\n    \"\"\"Holds the resulting string representation and provides accessor.\"\"\"\n    def __init__(self, representation: str, base: int):\n        self.representation = representation\n        self.base = base\n\n    def as_string(self) -> str:\n        \"\"\"Returns the string representation of the conversion.\"\"\"\n        return self.representation\n\nclass Validator:\n    \"\"\"Validates input parameter types and range preconditions.\"\"\"\n    def validate_types(self, x: any, base: any) -> bool:\n        \"\"\"Validates that x and base are integers.\"\"\"\n        return isinstance(x, int) and isinstance(base, int)\n\n    def validate_base_range(self, base: int) -> bool:\n        \"\"\"Validates that the base is less than 10.\"\"\"\n        return base < 10\n\nclass BaseConverter:\n    \"\"\"Performs positional base-N conversion.\"\"\"\n    def change_base(self, x: int, base: int) -> str:\n        \"\"\"Converts an integer x to its string representation in the given base.\"\"\"\n        if x == 0:\n            return ConversionResult(\"0\", base).as_string()\n\n        # Instantiate DigitSet as per design, though its digits aren't directly used in conversion logic here.\n        _ = DigitSet(base) \n\n        digits_list = self.to_digits(x, base)\n        representation = \"\".join(map(str, reversed(digits_list)))\n        \n        conversion_result = ConversionResult(representation, base)\n        return conversion_result.as_string()\n\n    def to_digits(self, x: int, base: int) -> List[int]:\n        \"\"\"Converts a number to a list of its digits in the specified base (least significant first).\"\"\"\n        digits = []\n        current_x = x\n\n        while current_x > 0:\n            remainder = current_x % base\n            digits.append(remainder)\n            current_x //= base\n        return digits\n\ndef change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    validator = Validator()\n\n    if not validator.validate_types(x, base):\n        raise TypeError(\"x and base must be integers\")\n    \n    if not validator.validate_base_range(base):\n        raise ValueError(\"base must be less than 10\")\n    \n    converter = BaseConverter()\n    return converter.change_base(x, base)"}
{"task_id": "HumanEval/48", "solution": "from typing import Any\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    value: str\n\n@dataclass\nclass PalindromeResult:\n    is_palindrome: bool\n\n@dataclass\nclass DoctestExample:\n    example_input: str\n    expected_output: bool\n\ndef _validate_type(text: Any) -> None:\n    \"\"\"Validates that the input text is a string.\n    Raises TypeError if the input is not a string.\"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a str\")\n\ndef _compute_reverse(text: str) -> str:\n    \"\"\"Computes the literal reverse of the input string.\"\"\"\n    return text[::-1]\n\ndef is_palindrome(text: str) -> bool:\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    _validate_type(text)\n    input_obj = InputString(value=text)\n    reversed_text = _compute_reverse(input_obj.value)\n    result_bool = input_obj.value == reversed_text\n    result_obj = PalindromeResult(is_palindrome=result_bool)\n    return result_obj.is_palindrome"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # Initialize the four previous terms: fib4(0), fib4(1), fib4(2), fib4(3)\n    a, b, c, d = 0, 0, 2, 0\n\n    # Iteratively compute fib4(n) for n >= 4\n    for _ in range(4, n + 1):\n        next_fib = a + b + c + d\n        a = b\n        b = c\n        c = d\n        d = next_fib\n    \n    return d"}
{"task_id": "HumanEval/47", "solution": "class MedianFunction:\n    @staticmethod\n    def validate_input(l: list):\n        # Ensures l is a list, not empty, and elements are numeric.\n        if not isinstance(l, list):\n            raise TypeError(\"Input must be a list.\")\n        if not l:\n            raise ValueError(\"Input list cannot be empty.\")\n        for x in l:\n            if not isinstance(x, (int, float)):\n                raise TypeError(\"List elements must be numeric (int or float).\")\n\n    @staticmethod\n    def make_sorted_copy(l: list) -> list:\n        # Returns a new sorted list from the input.\n        return sorted(l)\n\n    @staticmethod\n    def compute_for_odd(sorted_list: list):\n        # Computes the median for an odd-length list.\n        n = len(sorted_list)\n        return sorted_list[n // 2]\n\n    @staticmethod\n    def compute_for_even(sorted_list: list) -> float:\n        # Computes the median for an even-length list, returning a float.\n        n = len(sorted_list)\n        mid1 = sorted_list[n // 2 - 1]\n        mid2 = sorted_list[n // 2]\n        return (mid1 + mid2) / 2.0\n\n    @staticmethod\n    def median(l: list):\n        # Orchestrates validation, sorting, and median computation.\n        MedianFunction.validate_input(l)\n        sorted_list = MedianFunction.make_sorted_copy(l)\n        n = len(sorted_list)\n        if n % 2 == 1:\n            return MedianFunction.compute_for_odd(sorted_list)\n        else:\n            return MedianFunction.compute_for_even(sorted_list)\n\n\ndef median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    return MedianFunction.median(l)"}
{"task_id": "HumanEval/49", "solution": "from typing import Optional, Any\n\nclass ValidationError(ValueError):\n    \"\"\"Custom exception for invalid inputs to modp.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n    def raise_(self) -> None:\n        \"\"\"Raises the stored validation error.\"\"\"\n        raise self\n\nclass InputParameter:\n    \"\"\"Helper for input metadata and type checks.\"\"\"\n    def __init__(self, name: str, value: Any) -> None:\n        self.name = name\n        self.value = value\n\n    def typeCheck(self, expected_type: type, range_check_func=None) -> None:\n        \"\"\"Checks the type and optionally the range of the parameter.\"\"\"\n        if not isinstance(self.value, expected_type):\n            ValidationError(f\"{self.name} must be an integer.\").raise_()\n        if range_check_func and not range_check_func(self.value):\n            if self.name == 'n':\n                ValidationError(f\"{self.name} must be a non-negative integer.\").raise_()\n            elif self.name == 'p':\n                ValidationError(f\"{self.name} must be an integer greater than 0.\").raise_()\n            else:\n                ValidationError(f\"Invalid range for {self.name}.\").raise_()\n\n\nclass ModularExponentiation:\n    \"\"\"Stateless algorithm provider for modular exponentiation.\"\"\"\n    @staticmethod\n    def fastExponentiationBySquaring(n: int, base: int, mod: int) -> int:\n        \"\"\"Computes (base^n) % mod using exponentiation by squaring.\"\"\"\n        result = 1\n        base %= mod\n        while n > 0:\n            if n % 2 == 1:\n                result = (result * base) % mod\n            base = (base * base) % mod\n            n //= 2\n        return result\n\n    @staticmethod\n    def computePow2Mod(n: int, p: int) -> int:\n        \"\"\"Computes 2^n modulo p.\"\"\"\n        return ModularExponentiation.fastExponentiationBySquaring(n, 2, p)\n\n\nclass ModpFunction:\n    \"\"\"Orchestrates validation and computation for modp.\"\"\"\n    def __init__(self, n: int, p: int) -> None:\n        self.n = n\n        self.p = p\n        self.result: Optional[int] = None\n\n    def validateInputs(self) -> None:\n        \"\"\"Validates the input parameters n and p.\"\"\"\n        n_param = InputParameter('n', self.n)\n        p_param = InputParameter('p', self.p)\n\n        n_param.typeCheck(int, lambda val: val >= 0)\n        p_param.typeCheck(int, lambda val: val > 0)\n\n    def compute(self) -> int:\n        \"\"\"Computes 2^n modulo p after validating inputs.\"\"\"\n        self.validateInputs()\n        self.result = ModularExponentiation.computePow2Mod(self.n, self.p)\n        return self.result\n\n\ndef modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    mf = ModpFunction(n, p)\n    return mf.compute()"}
