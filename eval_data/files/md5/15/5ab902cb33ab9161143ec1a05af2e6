{"task_id": "HumanEval/17", "solution": "from typing import List\n\n\n# Module-level constants for note definitions and validation,\n# serving as \"inline\" helpers for the parse_music function.\n_NOTE_BEATS = {\n    \"o\": 4,\n    \"o|\": 2,\n    \".|\": 1,\n}\n_VALID_TOKENS = frozenset(_NOTE_BEATS.keys())\n\n\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n\n    Here is a legend:\n    'o' - whole note, lasts four beats\n    'o|' - half note, lasts two beats\n    '.|' - quater note, lasts one beat\n\n    >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    \"\"\"\n    # Tokenize the music string by splitting on whitespace.\n    # str.split() handles multiple spaces, leading/trailing spaces, and empty strings appropriately.\n    tokens = music_string.split()\n\n    # Filter out invalid tokens and convert valid ones to their beat values.\n    # Invalid tokens are skipped as per design context (\"shall not be interpreted as notes\").\n    beats: List[int] = [\n        _NOTE_BEATS[token] for token in tokens if token in _VALID_TOKENS\n    ]\n\n    return beats"}
{"task_id": "HumanEval/22", "solution": "from typing import List, Any\n\n\ndef filter_integers(values: List[Any]) -> List[int]:\n    \"\"\" Filter given list of any python values only for integers\n    >>> filter_integers(['a', 3.14, 5])\n    [5]\n    >>> filter_integers([1, 2, 3, 'abc', {}, []])\n    [1, 2, 3]\n    \"\"\"\n    if not isinstance(values, list):\n        raise TypeError(\"values must be a list\")\n    result: List[int] = [x for x in values if type(x) is int]\n    return result"}
{"task_id": "HumanEval/24", "solution": "class IntegerInput:\n    \"\"\"Represents an integer input and provides a validation method.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n\n    def validate(self) -> bool:\n        \"\"\"Returns True if the input is an integer, False otherwise.\"\"\"\n        return isinstance(self.n, int)\n\nclass DivisorResult:\n    \"\"\"A simple data holder for a computed divisor.\"\"\"\n    def __init__(self, d: int) -> None:\n        self.d = d\n\nclass LargestDivisorService:\n    \"\"\"Encapsulates the computation of the largest proper divisor.\"\"\"\n    def largest_divisor(self, n: int) -> int:\n        \"\"\"Service-level entry to compute the largest proper divisor.\"\"\"\n        result_d = self.computeLargestDivisor(n)\n        return DivisorResult(result_d).d\n\n    def computeLargestDivisor(self, n: int) -> int:\n        \"\"\"Implements the algorithm to find the largest proper divisor.\"\"\"\n        if n <= 1:\n            # Behavior for n <= 1 is unspecified by SRS, but algorithm requires n > 1\n            # Returning 1 is a safe default for smallest divisor, consistent with primes.\n            return 1 \n        for i in range(n // 2, 0, -1):\n            if n % i == 0:\n                return i\n        return 1 # Fallback for prime numbers or unexpected path, will be reached for primes\n\ndef largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    integer_input = IntegerInput(n)\n    # The design specifies calling validate() but leaves error handling for False unspecified.\n    # Given the type hint `n: int` and \"DO NOT add isinstance() checks\" constraint for this function,\n    # we proceed assuming valid integer input.\n    integer_input.validate()\n\n    service = LargestDivisorService()\n    result = service.largest_divisor(n)\n    return result"}
{"task_id": "HumanEval/25", "solution": "from typing import List\n\n\nclass InputNumber:\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n\nclass PrimeFactor:\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n\nclass FactorizationResult:\n    def __init__(self, input_value: int, factors: List[int]) -> None:\n        \"\"\"Initializes the result with the original input value and computed factors.\"\"\"\n        self.input_value = input_value\n        self.factors = factors\n\n    def verify_product(self) -> bool:\n        \"\"\"Checks if the product of factors equals the original input value.\"\"\"\n        product = 1\n        for factor in self.factors:\n            product *= factor\n        return product == self.input_value\n\n\nclass Validator:\n    def validate_type(self, n: int) -> bool:\n        \"\"\"Checks if the input n is an integer.\"\"\"\n        return isinstance(n, int)\n\n    def validate_precondition(self, n: int) -> bool:\n        \"\"\"Checks if n meets the precondition (n is a positive integer).\"\"\"\n        return n >= 1\n\n\nclass FactorizationService:\n    def trial_division(self, n: int) -> List[int]:\n        \"\"\"Performs trial division to find prime factors of a given number.\"\"\"\n        factors = []\n        d = 2\n        temp_n = n\n        while d * d <= temp_n:\n            while temp_n % d == 0:\n                factors.append(d)\n                temp_n //= d\n            d += 1\n        if temp_n > 1:\n            factors.append(temp_n)\n        return factors\n\n    def factorize(self, n: int) -> List[int]:\n        \"\"\"Computes the prime factorization of the given number. Assumes n > 1.\"\"\"\n        return self.trial_division(n)\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    validator = Validator()\n    if not validator.validate_type(n):\n        raise TypeError('n must be int')\n    if not validator.validate_precondition(n):\n        raise ValueError('precondition failed')\n\n    if n == 1:\n        return []\n\n    service = FactorizationService()\n    factors = service.factorize(n)\n\n    result = FactorizationResult(n, factors)\n    if not result.verify_product():\n        raise RuntimeError('product verification failed')\n\n    return result.factors"}
{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    flipped_chars = []\n    for char in string:\n        if char.islower():\n            flipped_chars.append(char.upper())\n        elif char.isupper():\n            flipped_chars.append(char.lower())\n        else:\n            flipped_chars.append(char)\n    return \"\".join(flipped_chars)"}
