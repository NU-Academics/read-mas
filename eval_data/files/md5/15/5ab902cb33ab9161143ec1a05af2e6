{"task_id": "HumanEval/29", "solution": "from typing import List\n\n\ndef filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    result = []\n    for s in strings:\n        if s.startswith(prefix):\n            result.append(s)\n    return result"}
{"task_id": "HumanEval/26", "solution": "from typing import List, Dict\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    frequency_map: Dict[int, int] = {}\n    for num in numbers:\n        frequency_map[num] = frequency_map.get(num, 0) + 1\n\n    result_list: List[int] = []\n    for num in numbers:\n        if frequency_map[num] == 1:\n            result_list.append(num)\n\n    return result_list"}
{"task_id": "HumanEval/31", "solution": "import math\n\ndef validate_input(n):\n    # Verify n is an integer.\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n\ndef compute_primality(n):\n    # Compute primality using optimized trial division.\n    if n <= 1:\n        return False\n    if n <= 3: # Covers 2 and 3\n        return True\n    if n % 2 == 0: # Exclude even numbers greater than 2\n        return False\n    \n    # Trial division for odd divisors up to the square root of n.\n    i = 3\n    limit = math.isqrt(n)\n    while i <= limit:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    validate_input(n)\n    return compute_primality(n)"}
{"task_id": "HumanEval/33", "solution": "from typing import List, Any\n\nclass InputList:\n    \"\"\"Adapts a raw input list for read-only access.\"\"\"\n    def __init__(self, elements: List[Any]):\n        self._elements = elements\n\n    def length(self) -> int:\n        return len(self._elements)\n\n    def get(self, index: int) -> Any:\n        return self._elements[index]\n\nclass ResultList:\n    \"\"\"Mutable buffer for constructing the result list.\"\"\"\n    def __init__(self, length: int):\n        self._elements = [None] * length\n\n    def set(self, index: int, value: Any):\n        self._elements[index] = value\n\n    def get(self) -> List[Any]:\n        return self._elements\n\nclass Element:\n    \"\"\"Represents a value paired with its original index.\"\"\"\n    def __init__(self, value: Any, index: int):\n        self.value = value\n        self.index = index\n\nclass IndexPosition:\n    \"\"\"Encapsulates an index and checks its divisibility by three.\"\"\"\n    def __init__(self, position: int):\n        self._position = position\n\n    def is_divisible_by_three(self) -> bool:\n        return self._position % 3 == 0\n\nclass Extractor:\n    \"\"\"Collects Element objects for indices divisible by three.\"\"\"\n    def collect_divisible_by_three(self, input_list: InputList) -> List[Element]:\n        extracted_elements = []\n        for i in range(input_list.length()):\n            if IndexPosition(i).is_divisible_by_three():\n                extracted_elements.append(Element(input_list.get(i), i))\n        return extracted_elements\n\nclass SortOperation:\n    \"\"\"Sorts extracted Element values in ascending order.\"\"\"\n    def sort_ascending(self, elements: List[Element]) -> List[Any]:\n        values_to_sort = [e.value for e in elements]\n        return sorted(values_to_sort)\n\nclass Merger:\n    \"\"\"Assembles the ResultList by inserting sorted values and copying others.\"\"\"\n    def merge_sorted_back(self, input_list: InputList, sorted_values: List[Any]) -> ResultList:\n        result_list = ResultList(input_list.length())\n        sorted_values_iter = iter(sorted_values)\n\n        for i in range(input_list.length()):\n            if IndexPosition(i).is_divisible_by_three():\n                result_list.set(i, next(sorted_values_iter))\n            else:\n                result_list.set(i, input_list.get(i))\n        return result_list\n\ndef sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    input_list = InputList(l)\n\n    extractor = Extractor()\n    extracted_elements = extractor.collect_divisible_by_three(input_list)\n\n    sort_operation = SortOperation()\n    sorted_values = sort_operation.sort_ascending(extracted_elements)\n\n    merger = Merger()\n    result_list_obj = merger.merge_sorted_back(input_list, sorted_values)\n\n    return result_list_obj.get()"}
{"task_id": "HumanEval/32", "solution": "import math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Precondition checks as per design document\n    if len(xs) % 2 != 0:\n        raise ValueError(\"xs must have even length\")\n    if xs[-1] == 0:\n        raise ValueError(\"leading coefficient must be non-zero\")\n\n    # Handle linear case directly for precision and efficiency (degree 1)\n    if len(xs) == 2:  # [c0, c1] -> c1*x + c0 = 0\n        return -xs[0] / xs[1]\n\n    # Calculate an upper bound R for the magnitude of real roots\n    # Roots are typically within [-R, R] where R = 1 + max(|a_i/a_n|)\n    leading_coeff = xs[-1]\n    max_coeff_abs_ratio = 0.0\n    for i in range(len(xs) - 1):\n        max_coeff_abs_ratio = max(max_coeff_abs_ratio, abs(xs[i] / leading_coeff))\n    R = 1.0 + max_coeff_abs_ratio\n\n    # Define a nested bisection helper function for refining roots in an interval\n    def _bisect_local(low: float, high: float, tol: float = 1e-7, max_iter: int = 1000) -> float:\n        val_low = poly(xs, low)\n        val_high = poly(xs, high)\n\n        # If an endpoint is already a root within tolerance, return it\n        if abs(val_low) < tol:\n            return low\n        if abs(val_high) < tol:\n            return high\n\n        # If no strict sign change, bisection might not find a root or might be invalid\n        # This occurs if the interval doesn't contain a root or has multiple roots that cancel sign changes\n        # For odd-degree polynomials and sufficiently small intervals, a sign change is expected.\n        if val_low * val_high > 0:\n            return float('nan') # Indicate no root found by bisection\n\n        for _ in range(max_iter):\n            mid = (low + high) / 2\n            val_mid = poly(xs, mid)\n\n            if abs(val_mid) < tol:\n                return mid\n\n            if val_low * val_mid < 0:\n                high = mid\n                val_high = val_mid\n            else:\n                low = mid\n                val_low = val_mid\n        return (low + high) / 2 # Return best approximation if max_iter reached\n\n    # Search for roots by scanning the interval [-R, R] and applying bisection\n    roots = []\n    # Use a small step for scanning to detect sign changes accurately\n    scan_step = R / 2000.0\n    x_current = -R - scan_step # Start slightly before -R to catch roots at boundary\n    x_end = R + scan_step      # End slightly after R to catch roots at boundary\n\n    while x_current <= x_end:\n        next_x = x_current + scan_step\n        # Clamp next_x to x_end to avoid overshooting\n        if next_x > x_end:\n            next_x = x_end\n\n        val_current = poly(xs, x_current)\n        val_next = poly(xs, next_x)\n\n        # If a sign change is detected, there's a root in [x_current, next_x]\n        # or if poly(x_current) is very close to zero, consider it a root\n        if abs(val_current) < 1e-7:\n            # Add only if not too close to an already found root to avoid duplicates\n            if not any(abs(r - x_current) < 1e-5 for r in roots):\n                roots.append(x_current)\n        elif val_current * val_next < 0:\n            root = _bisect_local(x_current, next_x)\n            if not math.isnan(root):\n                # Add only if not too close to an already found root\n                if not any(abs(r - root) < 1e-5 for r in roots):\n                    roots.append(root)\n\n        x_current = next_x\n\n    # The design specifies returning the numerically smallest real root.\n    if not roots:\n        # This path should ideally not be reached given the guarantees in the problem statement\n        # (odd-degree polynomial guarantees at least one real root).\n        # A very robust search and bisection should find it.\n        # However, to avoid an error in an unlikely numerical failure, return a sensible default or raise.\n        # Given \"DO NOT add ... raise exceptions for edge cases\", we assume a root is always found.\n        # In this context, it implies that the numerical method chosen must reliably find a root for valid inputs.\n        # If it truly happens that roots is empty, there is a fundamental failure in the numerical method setup\n        # or interpretation of the polynomial properties.\n        # For now, we proceed under the assumption that 'roots' will not be empty.\n        pass\n\n    return min(roots)"}
{"task_id": "HumanEval/34", "solution": "def _remove_duplicates(items: list) -> list:\n    \"\"\"Removes duplicate elements from a list.\n    The order of elements is not guaranteed after deduplication.\n    \"\"\"\n    return list(set(items))\n\ndef _sort_ascending(items: list) -> list:\n    \"\"\"Sorts a list of comparable items in ascending order.\"\"\"\n    return sorted(items)\n\ndef unique(l: list):\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    deduped_elements = _remove_duplicates(l)\n    sorted_unique_elements = _sort_ascending(deduped_elements)\n    return sorted_unique_elements"}
