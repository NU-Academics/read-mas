{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    clean_string = paren_string.replace(\" \", \"\")\n    \n    result_groups = []\n    balance = 0\n    start_index = 0\n    \n    for i, char in enumerate(clean_string):\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        \n        if balance == 0:\n            # Found a balanced, top-level group\n            group = clean_string[start_index : i + 1]\n            result_groups.append(group)\n            start_index = i + 1\n            \n    return result_groups\n```"}
{"task_id": "HumanEval/2", "solution": "```python\ndef truncate_number(number: float) -> float:\n    \"\"\"\n    Given a positive floating point number, it decomposes the number into an\n    integer part and a decimal part, and returns the decimal part.\n\n    Args:\n        number: The positive floating-point number to be processed.\n\n    Returns:\n        The decimal part of the input number, ranging from 0.0 up to\n        (but not including) 1.0.\n\n    Raises:\n        TypeError: If the input is not a numeric type that can be cast to a float.\n        ValueError: If the input 'number' is negative.\n    \"\"\"\n    if not isinstance(number, (int, float)):\n        # This check makes the TypeError explicit, as per the API spec,\n        # though the modulo operator would raise it implicitly for many types.\n        raise TypeError(\"Input must be a numeric type.\")\n\n    if number < 0:\n        raise ValueError(\"Input 'number' must be a non-negative floating-point value.\")\n\n    return number % 1.0\n```"}
{"task_id": "HumanEval/3", "solution": "```python\nfrom typing import List\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"\n    Determines if a sequence of financial transactions on an account,\n    starting with a zero balance, ever results in a negative balance.\n\n    Args:\n        operations: An ordered list of integers. Positive integers represent\n                    deposits, and negative integers represent withdrawals.\n\n    Returns:\n        True if the account balance drops below zero at any point during the\n        transaction sequence. Otherwise, returns False.\n    \"\"\"\n    balance = 0\n    for operation in operations:\n        balance += operation\n        if balance < 0:\n            return True\n    return False\n```"}
{"task_id": "HumanEval/4", "solution": "```python\nfrom typing import List\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"\n    For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n\n    Args:\n        numbers (List[float]): A list of floating-point numbers.\n\n    Returns:\n        float: The calculated Mean Absolute Deviation.\n\n    Raises:\n        ValueError: If the input list `numbers` is empty.\n    \"\"\"\n    # 1. Input Validation\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    n = len(numbers)\n\n    # 2. Pass 1: Calculate the Mean\n    mean = sum(numbers) / n\n\n    # 3. Pass 2: Calculate Mean of Absolute Deviations\n    # A generator expression is used for memory efficiency (O(1) space).\n    sum_of_absolute_deviations = sum(abs(x - mean) for x in numbers)\n    mad = sum_of_absolute_deviations / n\n\n    # 4. Return Value\n    return mad\n```"}
{"task_id": "HumanEval/5", "solution": "```python\nfrom typing import List, TypeVar\n\nT = TypeVar('T')\n\ndef intersperse(numbers: List[T], delimeter: T) -> List[T]:\n    \"\"\"\n    Insert an element 'delimeter' between every two consecutive elements of \n    the input list 'numbers'.\n\n    Args:\n        numbers: The list of elements to process.\n        delimeter: The element to insert between items in the list.\n\n    Returns:\n        A new list with the delimeter interspersed. The original list is\n        not modified.\n    \"\"\"\n    if len(numbers) < 2:\n        return numbers[:]\n\n    result = []\n    # Using an index to check if it's the last element\n    last_index = len(numbers) - 1\n    for i, element in enumerate(numbers):\n        result.append(element)\n        if i < last_index:\n            result.append(delimeter)\n            \n    return result\n```"}
{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\n# 3.1. Input Parser Component\ndef _split_into_groups(raw_string: str) -> List[str]:\n    \"\"\"\n    Sanitizes and segments the input string into a list of non-empty group strings.\n\n    Args:\n        raw_string: The string to be split.\n\n    Returns:\n        A list of substrings, split by spaces, with empty strings removed.\n    \"\"\"\n    # str.split() with no arguments splits on any whitespace and discards empty strings,\n    # which perfectly fulfills the component's requirements.\n    return raw_string.split()\n\n\n# 3.2. Nesting Calculator Component\ndef _calculate_max_depth(group_string: str) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth for a single string of parentheses.\n\n    Args:\n        group_string: A string consisting only of parentheses.\n\n    Returns:\n        The integer value of the deepest level of nesting.\n\n    Raises:\n        ValueError: If the string contains invalid characters or is malformed\n                    with unbalanced parentheses.\n    \"\"\"\n    max_depth = 0\n    current_depth = 0\n\n    for char in group_string:\n        if char == '(':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            if current_depth == 0:\n                raise ValueError(\"Malformed group: a closing parenthesis appears before a matching opening one.\")\n            current_depth -= 1\n        else:\n            raise ValueError(f\"Malformed group: contains invalid character '{char}'.\")\n\n    if current_depth != 0:\n        raise ValueError(\"Malformed group: parentheses are unbalanced.\")\n\n    return max_depth\n\n\n# 3.3. Orchestrator Component / 6. API Specification\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Parses a string containing space-separated groups of parentheses and\n    calculates the maximum nesting depth for each group.\n\n    Args:\n        paren_string (str): The input string to be processed.\n\n    Returns:\n        List[int]: A list of integers where each element corresponds to the\n        maximum nesting depth of a group in the input string, in order.\n\n    Raises:\n        ValueError: If any group within the `paren_string` is malformed\n                    (contains invalid characters or has unbalanced parentheses).\n    \"\"\"\n    # Invoke the Input Parser to get a list of group strings\n    groups = _split_into_groups(paren_string)\n\n    # If the list of groups is empty (e.g., input was \"\" or \" \"), return empty list\n    if not groups:\n        return []\n\n    # Iterate, invoke Nesting Calculator for each group, and aggregate results\n    results = [_calculate_max_depth(group) for group in groups]\n\n    return results\n```"}
