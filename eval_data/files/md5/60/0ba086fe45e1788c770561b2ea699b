{"task_id": "HumanEval/45", "solution": "```python\n# main.py\nfrom fastapi import FastAPI, HTTPException, status, Query\nfrom fastapi.exceptions import RequestValidationError\nfrom fastapi.responses import JSONResponse\nfrom pydantic import BaseModel, Field\n\n# Define the FastAPI application\napp = FastAPI(\n    title=\"Triangle Area Calculator Service\",\n    description=\"A simple API service to calculate the area of a triangle given its base and height.\",\n    version=\"1.0.0\"\n)\n\n# Custom exception handler for Pydantic validation errors to return 400 Bad Request\n@app.exception_handler(RequestValidationError)\nasync def validation_exception_handler(request, exc: RequestValidationError):\n    errors = []\n    for error in exc.errors():\n        loc = \".\".join(map(str, error[\"loc\"])) if error[\"loc\"] else \"body\"\n        msg = error[\"msg\"]\n        \n        # Customize message based on common validation error types\n        param_name = loc.split('.')[-1]\n        if \"value_error.missing\" in error[\"type\"]:\n            errors.append(f\"Missing input for '{param_name}': {msg.replace('field required', 'is required')}.\")\n        elif \"value_error.number.not_gt\" in error[\"type\"]:\n            errors.append(f\"Invalid input for '{param_name}': Must be a positive number.\")\n        elif \"value_error.float\" in error[\"type\"] or \"value_error.integer\" in error[\"type\"]:\n            errors.append(f\"Invalid input for '{param_name}': Must be a numeric value.\")\n        else:\n            errors.append(f\"Invalid input for '{param_name}': {msg}.\")\n            \n    if len(errors) == 1:\n        error_message = errors[0]\n    else:\n        error_message = \"; \".join(errors)\n\n    return JSONResponse(\n        status_code=status.HTTP_400_BAD_REQUEST,\n        content={\"error\": error_message},\n    )\n\n# Business Logic Module\ndef calculate_triangle_area(base: float, height: float) -> float:\n    \"\"\"Calculates the area of a triangle using the formula (base * height) / 2.\"\"\"\n    return (base * height) / 2\n\n# Pydantic Model for POST requests (Input Validation Module for POST)\nclass TriangleInput(BaseModel):\n    a: float = Field(..., gt=0, description=\"The base of the triangle. Must be a positive number.\")\n    h: float = Field(..., gt=0, description=\"The height of the triangle. Must be a positive number.\")\n\n    class Config:\n        schema_extra = {\n            \"example\": {\n                \"a\": 5.0,\n                \"h\": 3.0\n            }\n        }\n\n# API Endpoint (Controller/API Gateway) for GET requests\n@app.get(\"/calculate/triangle_area\",\n         summary=\"Calculate triangle area using GET\",\n         response_model=dict,\n         status_code=status.HTTP_200_OK,\n         responses={\n             status.HTTP_400_BAD_REQUEST: {\"model\": dict, \"description\": \"Invalid input provided\"},\n             status.HTTP_500_INTERNAL_SERVER_ERROR: {\"model\": dict, \"description\": \"Internal server error\"}\n         })\nasync def get_triangle_area(\n    a: float = Query(..., gt=0, description=\"The base of the triangle. Must be a positive number.\"),\n    h: float = Query(..., gt=0, description=\"The height of the triangle. Must be a positive number.\")\n):\n    \"\"\"\n    Calculates the area of a triangle given its base (a) and height (h) as query parameters.\n    Both 'a' and 'h' must be positive numbers.\n    \"\"\"\n    try:\n        area = calculate_triangle_area(a, h)\n        return {\"area\": area}\n    except Exception as e:\n        # This catches any unexpected internal errors not covered by RequestValidationError\n        raise HTTPException(\n            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n            detail={\"error\": \"An unexpected error occurred.\"}\n        )\n\n# API Endpoint (Controller/API Gateway) for POST requests\n@app.post(\"/calculate/triangle_area\",\n          summary=\"Calculate triangle area using POST\",\n          response_model=dict,\n          status_code=status.HTTP_200_OK,\n          responses={\n              status.HTTP_400_BAD_REQUEST: {\"model\": dict, \"description\": \"Invalid input provided\"},\n              status.HTTP_500_INTERNAL_SERVER_ERROR: {\"model\": dict, \"description\": \"Internal server error\"}\n          })\nasync def post_triangle_area(request: TriangleInput):\n    \"\"\"\n    Calculates the area of a triangle given its base (a) and height (h) in the request body.\n    Both 'a' and 'h' must be positive numbers.\n    \"\"\"\n    try:\n        area = calculate_triangle_area(request.a, request.h)\n        return {\"area\": area}\n    except Exception as e:\n        # This catches any unexpected internal errors not covered by RequestValidationError\n        raise HTTPException(\n            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n            detail={\"error\": \"An unexpected error occurred.\"}\n        )\n```"}
{"task_id": "HumanEval/46", "solution": "```python\ndef fib4(n: int) -> int:\n    \"\"\"\n    Computes the n-th element of the Fib4 number sequence iteratively.\n\n    The Fib4 sequence is defined as:\n    fib4(0) = 0\n    fib4(1) = 0\n    fib4(2) = 2\n    fib4(3) = 0\n    fib4(n) = fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4) for n >= 4\n\n    Args:\n        n: An integer representing the index of the Fib4 number to compute.\n           Assumed to be a non-negative integer.\n\n    Returns:\n        An integer representing the n-th Fib4 number.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the four preceding values for fib4(4)\n    # These correspond to fib4(0), fib4(1), fib4(2), fib4(3)\n    a = 0  # fib4(i-4)\n    b = 0  # fib4(i-3)\n    c = 2  # fib4(i-2)\n    d = 0  # fib4(i-1)\n\n    # Iterate from n=4 up to the desired n\n    for _ in range(4, n + 1):\n        next_fib = a + b + c + d\n        # Shift the values for the next iteration\n        a = b\n        b = c\n        c = d\n        d = next_fib\n    \n    # After the loop, 'd' holds the value of fib4(n)\n    return d\n```"}
{"task_id": "HumanEval/46", "solution": "```python\ndef fib4(n: int) -> int:\n    \"\"\"\n    Computes the n-th element of the Fib4 number sequence iteratively.\n\n    The Fib4 sequence is defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4) for n >= 4.\n\n    Args:\n        n (int): The index of the Fib4 number to compute. Must be a non-negative integer.\n\n    Returns:\n        int: The n-th Fib4 number.\n\n    Raises:\n        ValueError: If n is a negative integer.\n\n    Examples:\n    >>> fib4(0)\n    0\n    >>> fib4(1)\n    0\n    >>> fib4(2)\n    2\n    >>> fib4(3)\n    0\n    >>> fib4(4)\n    2\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    # Error handling for negative input\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    # Base cases for the Fib4 sequence\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # For n >= 4, use an iterative approach (dynamic programming with O(1) space)\n    # We need to keep track of the last four values: fib4(k-4), fib4(k-3), fib4(k-2), fib4(k-1)\n    # Initialize with the base cases:\n    # f_n_minus_4 corresponds to fib4(0)\n    # f_n_minus_3 corresponds to fib4(1)\n    # f_n_minus_2 corresponds to fib4(2)\n    # f_n_minus_1 corresponds to fib4(3)\n    f_n_minus_4 = 0  # Represents fib4(k-4)\n    f_n_minus_3 = 0  # Represents fib4(k-3)\n    f_n_minus_2 = 2  # Represents fib4(k-2)\n    f_n_minus_1 = 0  # Represents fib4(k-1)\n\n    # Iterate from k = 4 up to n\n    for _ in range(4, n + 1):\n        current_fib = f_n_minus_1 + f_n_minus_2 + f_n_minus_3 + f_n_minus_4\n        \n        # Shift values for the next iteration:\n        # The value that was fib4(k-3) becomes fib4(k-4) for the next iteration (k+1)\n        # The value that was fib4(k-2) becomes fib4(k-3)\n        # The value that was fib4(k-1) becomes fib4(k-2)\n        # The newly computed current_fib becomes fib4(k-1)\n        f_n_minus_4 = f_n_minus_3\n        f_n_minus_3 = f_n_minus_2\n        f_n_minus_2 = f_n_minus_1\n        f_n_minus_1 = current_fib\n    \n    # After the loop finishes (i.e., when _ reaches n), f_n_minus_1 will hold fib4(n)\n    return f_n_minus_1\n```"}
{"task_id": "HumanEval/47", "solution": "```python\ndef median(l: list):\n    \"\"\"\n    Calculates the median of a list of numbers.\n\n    The median is the middle value in a sorted list of numbers. If the list has\n    an odd number of elements, it's the single middle element. If it has an\n    even number of elements, it's the average of the two middle elements.\n\n    Args:\n        l (list): A list of numeric values (integers or floats).\n\n    Returns:\n        float: The median value of the input list.\n\n    Raises:\n        ValueError: If the input list `l` is empty.\n    \"\"\"\n    n = len(l)\n\n    if n == 0:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    # Create a sorted copy to avoid modifying the original list\n    sorted_l = sorted(l)\n\n    if n % 2 == 1:\n        # Odd length list: return the middle element\n        return float(sorted_l[n // 2])\n    else:\n        # Even length list: return the average of the two middle elements\n        middle1 = sorted_l[n // 2 - 1]\n        middle2 = sorted_l[n // 2]\n        return (middle1 + middle2) / 2.0\n```"}
{"task_id": "HumanEval/47", "solution": "```python\ndef median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    8\n    \"\"\"\n    # FR2: Empty List Handling\n    if not l:  # Checks if the list is empty (len(l) == 0)\n        raise ValueError(\"Input list cannot be empty.\")\n\n    # FR3: Non-numeric Element Handling\n    for x in l:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"List elements must be numeric.\")\n\n    # FR4: Sorting\n    # Create a sorted copy to avoid modifying the original list and ensure correctness.\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    # FR5, FR6: Median Calculation\n    if n % 2 == 1:\n        # Odd length list: median is the middle element\n        median_value = sorted_l[n // 2]\n        # FR7: For odd length, the element itself maintains its type (int or float).\n        # E.g., median([1, 2, 3]) -> 2 (int)\n        # E.g., median([1.0, 2.0, 3.0]) -> 2.0 (float)\n    else:\n        # Even length list: median is the average of the two middle elements\n        middle_left = sorted_l[n // 2 - 1]\n        middle_right = sorted_l[n // 2]\n        median_value = (middle_left + middle_right) / 2\n        \n        # FR7: For even length, if the result of division is a whole number (e.g., 4.0),\n        # it should be returned as an integer (e.g., 4). Otherwise, as a float.\n        if median_value == int(median_value):\n            median_value = int(median_value)\n        # E.g., median([1, 2, 3, 4]) -> (2+3)/2 = 2.5 (float)\n        # E.g., median([1, 2, 4, 5]) -> (2+4)/2 = 3.0 -> 3 (int)\n\n    return median_value\n```"}
{"task_id": "HumanEval/48", "solution": "```python\ndef is_palindrome(text: str) -> bool:\n    \"\"\"\n    Determines if a given string is a palindrome.\n\n    A palindrome is a sequence of characters which reads the same backward as forward.\n    The comparison is case-sensitive and includes all characters.\n    Empty strings and single-character strings are considered palindromes.\n\n    Args:\n        text (str): The string to be checked.\n\n    Returns:\n        bool: True if the string is a palindrome, False otherwise.\n    \"\"\"\n    # The chosen algorithm involves comparing the original string with its reversed counterpart.\n    # String slicing text[::-1] efficiently creates a reversed copy of the string.\n    # The comparison `==` is case-sensitive and compares all characters,\n    # adhering to the specified constraints (1.2.4).\n    # This approach also correctly handles empty strings (FR.4) and\n    # single-character strings (FR.5) as palindromes.\n    return text == text[::-1]\n\n```"}
{"task_id": "HumanEval/48", "solution": "```python\ndef is_palindrome(text: str) -> bool:\n    \"\"\"\n    Checks if the given string is a palindrome.\n    A palindrome reads the same forwards and backward.\n    Comparison is case-sensitive and includes all characters.\n\n    :param text: The string to check.\n    :return: True if the string is a palindrome, False otherwise.\n    \"\"\"\n    left_pointer = 0\n    right_pointer = len(text) - 1\n\n    while left_pointer < right_pointer:\n        if text[left_pointer] != text[right_pointer]:\n            return False\n        left_pointer += 1\n        right_pointer -= 1\n    return True\n```"}
{"task_id": "HumanEval/49", "solution": "```python\ndef modp(n: int, p: int) -> int:\n    \"\"\"\n    Calculates 2^n modulo p using binary exponentiation.\n\n    This function computes (2 raised to the power of n) % p efficiently,\n    avoiding large intermediate numbers.\n\n    Args:\n        n (int): The non-negative integer exponent.\n        p (int): The positive integer modulus.\n\n    Returns:\n        int: The result of (2^n) % p, where 0 <= result < p.\n\n    Raises:\n        TypeError: If n or p are not integers.\n        ValueError: If n is negative or p is not positive.\n    \"\"\"\n    # 1. Input Validation\n    if not isinstance(n, int) or not isinstance(p, int):\n        raise TypeError(\"Both n and p must be integers.\")\n    if n < 0:\n        raise ValueError(\"Exponent 'n' must be non-negative.\")\n    if p <= 0:\n        raise ValueError(\"Modulus 'p' must be positive.\")\n\n    # 2. Handle p = 1 edge case (any number mod 1 is 0)\n    if p == 1:\n        return 0\n\n    # 3. Initialization\n    result = 1\n    # Start with base 2, but immediately apply modulo p\n    # This ensures `base` never exceeds p-1 (or 0 if p=2 and base=2)\n    base = 2 % p \n\n    # 4. Iterative Modular Exponentiation (Binary Exponentiation)\n    # The loop runs log(n) times.\n    while n > 0:\n        # If n is odd, multiply result by current base\n        # This corresponds to a bit set in the binary representation of n\n        if n % 2 == 1:  # Equivalent to (n & 1)\n            result = (result * base) % p\n        \n        # Square the base for the next iteration\n        # This corresponds to shifting to the next bit in the binary representation\n        base = (base * base) % p\n        \n        # Divide n by 2 (right shift)\n        n //= 2  # Equivalent to (n >>= 1)\n            \n    # 5. Return Result\n    return result\n\n```"}
{"task_id": "HumanEval/49", "solution": "```python\ndef modp(n: int, p: int) -> int:\n    \"\"\"\n    Calculates 2^n modulo p efficiently.\n\n    This function computes the modular exponentiation of 2 raised to the power of n,\n    modulo p. It leverages Python's built-in pow(base, exp, mod) function\n    for optimized performance, especially with large exponents, ensuring that\n    intermediate values do not grow excessively large.\n\n    Args:\n        n (int): The exponent. Must be a non-negative integer.\n        p (int): The modulus. Must be a positive integer.\n\n    Returns:\n        int: The result of (2^n) % p.\n\n    Raises:\n        ValueError: If p is zero or negative, or if n is negative (handled by built-in pow).\n\n    Examples:\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    return pow(2, n, p)\n```"}
{"task_id": "HumanEval/50", "solution": "```python\ndef decode_shift(encoded_string: str) -> str:\n    \"\"\"\n    Decodes a string by shifting every alphabetic character back by 5 positions.\n    Non-alphabetic characters are left unchanged. Case is preserved.\n\n    Args:\n        encoded_string: The string to be decoded.\n\n    Returns:\n        The decoded string.\n    \"\"\"\n    decoded_chars = []\n    SHIFT_AMOUNT = 5\n    ALPHABET_SIZE = 26\n\n    for char in encoded_string:\n        if 'a' <= char <= 'z':\n            # Lowercase letter\n            char_code = ord(char)\n            base = ord('a')\n            pos = char_code - base\n            new_pos = (pos - SHIFT_AMOUNT + ALPHABET_SIZE) % ALPHABET_SIZE\n            decoded_char = chr(new_pos + base)\n            decoded_chars.append(decoded_char)\n        elif 'A' <= char <= 'Z':\n            # Uppercase letter\n            char_code = ord(char)\n            base = ord('A')\n            pos = char_code - base\n            new_pos = (pos - SHIFT_AMOUNT + ALPHABET_SIZE) % ALPHABET_SIZE\n            decoded_char = chr(new_pos + base)\n            decoded_chars.append(decoded_char)\n        else:\n            # Non-alphabetic character\n            decoded_chars.append(char)\n\n    return \"\".join(decoded_chars)\n```"}
{"task_id": "HumanEval/50", "solution": "```python\ndef decode_shift(s: str) -> str:\n    \"\"\"\n    Decodes a string encoded by the encode_shift function.\n    Reverses the shift of every character by 5 in the alphabet.\n    \n    Args:\n        s (str): An encoded string consisting solely of lowercase English alphabet characters ('a'-'z').\n                 It is assumed to have been encoded using a Caesar cipher with a +5 shift.\n\n    Returns:\n        str: The original, decoded message string.\n    \"\"\"\n    decoded_chars = []\n    \n    # Pre-calculate ord('a') for efficiency, as it's a constant\n    ord_a = ord('a')\n    alphabet_size = 26\n    shift_value = 5\n\n    for ch in s:\n        # 1. Determine the 0-indexed position of 'ch' within the lowercase English alphabet.\n        #    'a' is 0, 'b' is 1, ..., 'z' is 25.\n        encoded_pos = ord(ch) - ord_a\n        \n        # 2. Calculate the original 0-indexed position by reversing the shift.\n        #    Subtract the shift value (5).\n        #    Add alphabet_size (26) before modulo 26 to handle negative results correctly,\n        #    ensuring wrap-around (e.g., 'c' (2) becomes 'x' (23) when decoded).\n        original_pos = (encoded_pos - shift_value + alphabet_size) % alphabet_size\n        \n        # 3. Convert 'original_pos' back to its corresponding lowercase alphabet character.\n        decoded_ch = chr(original_pos + ord_a)\n        \n        # 4. Append the decoded character to the list.\n        decoded_chars.append(decoded_ch)\n    \n    # Join all decoded characters to form the final string and return it.\n    return \"\".join(decoded_chars)\n```"}
{"task_id": "HumanEval/51", "solution": "```python\n_VOWELS_SET = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\ndef remove_vowels(text: str) -> str:\n    \"\"\"\n    Removes all English vowels (case-insensitive) from an input string.\n\n    This function processes an input string and returns a new string with all\n    occurrences of the English vowels ('a', 'e', 'i', 'o', 'u' and their\n    uppercase counterparts) removed. All other characters, including spaces,\n    punctuation, numbers, and Unicode characters not defined as English vowels,\n    are preserved in their original relative order.\n\n    Args:\n        text (str): The input string to be processed.\n\n    Returns:\n        str: A new string with all specified vowels removed. An empty string\n             is returned if the input is empty or contains only vowels.\n\n    Raises:\n        TypeError: If the input 'text' is not of type 'str'.\n    \"\"\"\n    # FR-001, SDD 3.1.2 Error Handling: Validate input type\n    if not isinstance(text, str):\n        raise TypeError(\"Input 'text' must be a string.\") # NFR-005\n\n    # SDD 3.1.3 Internal Design: Initialize a mutable list to build the result string.\n    # This is efficient for appending characters as it avoids costly re-allocations\n    # common with immutable string concatenation (NFR-001, NFR-002, SDD 5.1).\n    result_chars = []\n\n    # SDD 3.1.3 Internal Design: Iterate through each character of the input string.\n    for char in text:\n        # FR-002, FR-003, SDD 3.1.3: Check if the character is a vowel using the pre-initialized set.\n        # Set lookups are O(1) on average, contributing to the overall O(L) time complexity (NFR-001, SDD 5.1).\n        if char not in _VOWELS_SET:\n            # FR-004: Append non-vowel characters to the list, preserving their relative order.\n            result_chars.append(char)\n\n    # FR-007, SDD 3.1.3: Join the list of characters to form the final string.\n    # This is an efficient way to construct the final string from a list of characters.\n    return \"\".join(result_chars)\n```"}
{"task_id": "HumanEval/51", "solution": "```python\ndef remove_vowels(text: str) -> str:\n    \"\"\"\n    Removes all vowels (a, e, i, o, u, A, E, I, O, U) from the input string.\n\n    Args:\n        text (str): The input string.\n\n    Returns:\n        str: A new string with all vowels removed.\n\n    Raises:\n        TypeError: If the input 'text' is not a string.\n    \"\"\"\n    vowels_set = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n    \n    result_chars = []\n    for char in text:\n        if char not in vowels_set:\n            result_chars.append(char)\n            \n    return \"\".join(result_chars)\n```"}
