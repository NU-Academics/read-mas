{"task_id": "HumanEval/54", "solution": "```python\n# main.py\nfrom fastapi import FastAPI, HTTPException, status\nfrom fastapi.exceptions import RequestValidationError\nfrom fastapi.responses import JSONResponse\nfrom pydantic import BaseModel\nfrom typing import Set\n\n# --- Core Business Logic ---\ndef _get_unique_chars(s: str) -> Set[str]:\n    \"\"\"Converts a string to a set of its unique characters.\"\"\"\n    return set(s)\n\ndef same_chars(s0: str, s1: str) -> bool:\n    \"\"\"\n    Determines if two strings possess the exact same set of unique characters,\n    irrespective of character frequency or order within each string.\n    \"\"\"\n    return _get_unique_chars(s0) == _get_unique_chars(s1)\n\n# --- Pydantic Models for API ---\nclass SameCharsRequest(BaseModel):\n    string1: str\n    string2: str\n\nclass SameCharsResponse(BaseModel):\n    result: bool\n\nclass ErrorResponse(BaseModel):\n    error: str\n\n# --- FastAPI Application Setup ---\napp = FastAPI(\n    title=\"Same Chars API\",\n    description=\"A microservice to compare unique character sets of two strings.\",\n    version=\"1.0.0\",\n    docs_url=\"/api/docs\",\n    redoc_url=\"/api/redoc\",\n    openapi_url=\"/api/openapi.json\"\n)\n\n# --- Custom Exception Handler for Request Validation Errors (HTTP 400) ---\n@app.exception_handler(RequestValidationError)\nasync def validation_exception_handler(request, exc: RequestValidationError):\n    \"\"\"\n    Custom handler to transform Pydantic validation errors into an HTTP 400\n    Bad Request response with a simplified error message, as per SRS.\n    \"\"\"\n    has_string1_error = False\n    has_string2_error = False\n    \n    for error in exc.errors():\n        # Check for missing or incorrect type for string1 and string2\n        is_string1_issue = error['loc'] == ('string1',) and error['type'] in ['missing', 'string_type']\n        is_string2_issue = error['loc'] == ('string2',) and error['type'] in ['missing', 'string_type']\n        \n        if is_string1_issue:\n            has_string1_error = True\n        if is_string2_issue:\n            has_string2_error = True\n    \n    error_message = \"Invalid input.\"\n    if has_string1_error and has_string2_error:\n        error_message += \" Both string1 and string2 are required and must be strings.\"\n    elif has_string1_error:\n        error_message += \" string1 is required and must be a string.\"\n    elif has_string2_error:\n        error_message += \" string2 is required and must be a string.\"\n    else:\n        # Fallback for other validation errors (e.g., unexpected fields, non-string types for optional fields if any)\n        details = []\n        for error in exc.errors():\n            field_path = \".\".join(map(str, error['loc']))\n            message = error['msg']\n            details.append(f\"Field '{field_path}': {message}\")\n        error_message += f\" {'. '.join(details)}\"\n\n    return JSONResponse(\n        status_code=status.HTTP_400_BAD_REQUEST,\n        content={\"error\": error_message},\n    )\n\n# --- API Endpoint Definition ---\n@app.post(\n    \"/api/v1/same-chars\",\n    response_model=SameCharsResponse,\n    status_code=status.HTTP_200_OK,\n    summary=\"Compare unique character sets of two strings\",\n    description=\"Determines if two input strings possess the exact same set of unique characters.\",\n    responses={\n        status.HTTP_200_OK: {\"description\": \"Comparison result\"},\n        status.HTTP_400_BAD_REQUEST: {\"model\": ErrorResponse, \"description\": \"Invalid input provided\"},\n        status.HTTP_500_INTERNAL_SERVER_ERROR: {\"model\": ErrorResponse, \"description\": \"An unexpected server error occurred\"},\n    }\n)\nasync def compare_character_sets(request_body: SameCharsRequest):\n    \"\"\"\n    Compares the unique character sets of two input strings.\n    \n    - **string1**: The first string to compare.\n    - **string2**: The second string to compare.\n    \n    Returns `{\"result\": true}` if their unique character sets are identical,\n    `{\"result\": false}` otherwise.\n    \"\"\"\n    try:\n        result = same_chars(request_body.string1, request_body.string2)\n        return SameCharsResponse(result=result)\n    except Exception as e:\n        # Catch any unexpected errors during the core logic execution\n        raise HTTPException(\n            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n            detail={\"error\": f\"An unexpected server error occurred: {e}\"}\n        )\n\n```"}
{"task_id": "HumanEval/55", "solution": "```python\ndef fib(n: int) -> int:\n    \"\"\"\n    Calculates the n-th Fibonacci number using an iterative approach.\n\n    The sequence is 1-indexed: F(1)=1, F(2)=1, F(k) = F(k-1) + F(k-2) for k > 2.\n\n    Args:\n        n (int): The 1-indexed position of the desired Fibonacci number.\n                 Must be a positive integer (n >= 1).\n\n    Returns:\n        int: The n-th Fibonacci number.\n    \"\"\"\n    # Handle base cases for the 1-indexed sequence\n    if n == 1:\n        return 1\n    if n == 2:\n        return 1\n\n    # Initialize variables for F(k-2) and F(k-1)\n    # 'a' stores fib(i-2), 'b' stores fib(i-1)\n    # Start with F(1) and F(2)\n    a, b = 1, 1\n\n    # Iterate from the 3rd number up to the n-th number\n    for _ in range(3, n + 1):\n        # Calculate the next Fibonacci number: F(i) = F(i-1) + F(i-2)\n        # Update 'a' to be the old 'b' (which was F(i-1))\n        # Update 'b' to be the new sum (which is F(i))\n        a, b = b, a + b\n\n    return b  # 'b' now holds the n-th Fibonacci number\n\n```"}
{"task_id": "HumanEval/55", "solution": "```python\ndef fib(n: int) -> int:\n    \"\"\"\n    Calculates the n-th Fibonacci number using an iterative approach.\n\n    The Fibonacci sequence is defined as F(1)=1, F(2)=1, F(k)=F(k-1)+F(k-2) for k > 2.\n\n    Args:\n        n: A positive integer representing the index of the desired Fibonacci number.\n\n    Returns:\n        The n-th Fibonacci number.\n\n    Raises:\n        TypeError: If 'n' is not an integer.\n        ValueError: If 'n' is less than 1.\n    \"\"\"\n    # 1. Input Validation\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n    # 2. Base Cases\n    if n == 1:\n        return 1\n    if n == 2:\n        return 1\n\n    # 3. Iterative Calculation (for n > 2)\n    # Initialize a to F(1) and b to F(2)\n    a, b = 1, 1\n\n    # Loop from the 3rd term up to the n-th term\n    for _ in range(3, n + 1):\n        next_fib = a + b\n        a = b\n        b = next_fib\n    \n    # After the loop, b holds the n-th Fibonacci number\n    return b\n```"}
{"task_id": "HumanEval/56", "solution": "```python\ndef correct_bracketing(brackets: str) -> bool:\n    \"\"\"\n    Checks if a string of '<' and '>' characters has correctly balanced brackets.\n\n    Args:\n        brackets: The input string containing '<' and '>' characters.\n\n    Returns:\n        True if every opening bracket has a corresponding closing bracket,\n        meaning the brackets are correctly balanced. False otherwise.\n    \"\"\"\n    open_brackets_count = 0\n\n    for char in brackets:\n        if char == '<':\n            open_brackets_count += 1\n        elif char == '>':\n            if open_brackets_count == 0:\n                # Premature closing bracket found\n                return False\n            open_brackets_count -= 1\n        # Implicitly ignore other characters as per SRS section 2.6 and 4.1.2 REQ-FUNC-6\n\n    # After iterating through all characters, check if all open brackets were closed\n    return open_brackets_count == 0\n```"}
