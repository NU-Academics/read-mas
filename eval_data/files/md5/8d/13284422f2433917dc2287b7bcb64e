's no path.\n    if N == 0:\n        return 0.0\n\n    # dp[r][c] will store the maximum total cost to reach cell (r, c)\n    dp = [[0 for _ in range(N)] for _ in range(N)]\n\n    # Initialize the top-left cell\n    dp[0][0] = matrix[0][0]\n\n    # Fill the first row: can only move right\n    for c in range(1, N):\n        dp[0][c] = dp[0][c-1] + matrix[0][c]\n\n    # Fill the first column: can only move down\n    for r in range(1, N):\n        dp[r][0] = dp[r-1][0] + matrix[r][0]\n\n    # Fill the rest of the DP table\n    for r in range(1, N):\n        for c in range(1, N):\n            # To reach (r,c), we must have come from (r-1, c) or (r, c-1).\n            # We choose the path that yields the maximum total sum.\n            dp[r][c] = max(dp[r-1][c], dp[r][c-1]) + matrix[r][c]\n\n    # The maximum total cost path ends at the bottom-right cell (N-1, N-1)\n    max_total_cost = dp[N-1][N-1]\n\n    # For an N*N matrix, any path from (0,0) to (N-1, N-1) moving only right or down\n    # consists of (N-1) down moves and (N-1) right moves, plus the initial cell.\n    # Total cells visited = (N-1) + (N-1) + 1 = 2*N - 1.\n    path_length = (2 * N) - 1\n\n    # The maximum average is the maximum total cost divided by the path length\n    max_average = max_total_cost / path_length\n\n    return max_average", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/748": [{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Inserts spaces before capital letters in a string, except for the very first character.\n    This converts camelCase or PascalCase strings into spaced words.\n    \"\"\"\n    result = []\n    for i, char in enumerate(input_string):\n        if char.isupper() and i > 0:\n            result.append(' ')\n        result.append(char)\n    return \"\".join(result)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["MyNameIs