{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix):\n    \"\"\"Check if a matrix is a magic square where all rows, columns, and diagonals sum to the same value.\"\"\"\n    n = len(matrix)\n    if n == 0 or len(matrix[0]) != n:\n        return False\n    \n    target_sum = sum(matrix[0])\n    \n    # Check all rows\n    for row in matrix:\n        if sum(row) != target_sum:\n            return False\n    \n    # Check all columns\n    for col in range(n):\n        if sum(matrix[row][col] for row in range(n)) != target_sum:\n            return False\n    \n    # Check main diagonal\n    if sum(matrix[i][i] for i in range(n)) != target_sum:\n        return False\n    \n    # Check anti-diagonal\n    if sum(matrix[i][n-1-i] for i in range(n)) != target_sum:\n        return False\n    \n    return True"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix):\n    \"\"\"Check if the matrix is a magic square where all rows, columns, and diagonals sum to the same value.\"\"\"\n    n = len(matrix)\n    if n == 0 or len(matrix[0]) != n:\n        return False\n    \n    # Calculate the expected sum using the first row\n    target_sum = sum(matrix[0])\n    \n    # Check all rows\n    for row in matrix:\n        if sum(row) != target_sum:\n            return False\n    \n    # Check all columns\n    for col in range(n):\n        if sum(matrix[row][col] for row in range(n)) != target_sum:\n            return False\n    \n    # Check main diagonal\n    if sum(matrix[i][i] for i in range(n)) != target_sum:\n        return False\n    \n    # Check anti-diagonal\n    if sum(matrix[i][n-1-i] for i in range(n)) != target_sum:\n        return False\n    \n    return True"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s):\n    \"\"\"Reverse only the vowels in a string.\"\"\"\n    vowels = \"aeiouAEIOU\"\n    chars = list(s)\n    left, right = 0, len(chars) - 1\n    \n    while left < right:\n        while left < right and chars[left] not in vowels:\n            left += 1\n        while left < right and chars[right] not in vowels:\n            right -= 1\n        \n        if left < right:\n            chars[left], chars[right] = chars[right], chars[left]\n            left += 1\n            right -= 1\n    \n    return ''.join(chars)"}
