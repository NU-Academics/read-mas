{"task_id": "Mbpp/67", "solution": "def bell_number(n):\n    \"\"\"Returns the nth Bell number using dynamic programming with Bell triangle.\"\"\"\n    if n == 0:\n        return 1\n    \n    # Create Bell triangle\n    triangle = [[0 for _ in range(i + 2)] for i in range(n)]\n    triangle[0][0] = 1\n    \n    for i in range(1, n):\n        triangle[i][0] = triangle[i-1][i-1]\n        for j in range(1, i + 1):\n            triangle[i][j] = triangle[i-1][j-1] + triangle[i][j-1]\n    \n    return triangle[n-1][0]"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(arr):\n    \"\"\"Check if array is monotonic (non-increasing or non-decreasing).\"\"\"\n    if len(arr) <= 1:\n        return True\n    \n    increasing = decreasing = True\n    \n    for i in range(1, len(arr)):\n        if arr[i] > arr[i-1]:\n            decreasing = False\n        if arr[i] < arr[i-1]:\n            increasing = False\n    \n    return increasing or decreasing"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(arr):\n    \"\"\"Check if array is monotonic (non-decreasing or non-increasing).\"\"\"\n    if len(arr) <= 1:\n        return True\n    \n    increasing = all(arr[i] <= arr[i + 1] for i in range(len(arr) - 1))\n    decreasing = all(arr[i] >= arr[i + 1] for i in range(len(arr) - 1))\n    \n    return increasing or decreasing"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n):\n    \"\"\"Calculate the nth Bell number using dynamic programming with Bell triangle.\"\"\"\n    if n == 0:\n        return 1\n    \n    # Build Bell triangle row by row\n    triangle = [[1]]\n    \n    for i in range(1, n + 1):\n        row = [triangle[i-1][-1]]  # First element is last element of previous row\n        for j in range(1, i + 1):\n            row.append(row[j-1] + triangle[i-1][j-1])\n        triangle.append(row)\n    \n    return triangle[n][0]"}
