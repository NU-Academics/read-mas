{"task_id": "Mbpp/126", "solution": "class Divisor:\n    \"\"\"\n    A simple wrapper for a divisor value, used for conceptual modeling.\n    Supports hashing and equality for use in sets.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n    \n    def __hash__(self):\n        return hash(self.value)\n    \n    def __eq__(self, other):\n        if not isinstance(other, Divisor):\n            return NotImplemented\n        return self.value == other.value\n\nclass Number:\n    \"\"\"\n    Encapsulates an integer and provides methods to find its divisors.\n    Handles negative inputs by converting to their absolute values.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = abs(value)\n\n    def divisors(self) -> set[Divisor]:\n        \"\"\"\n        Calculates all positive divisors of the encapsulated number, returning them as a set of Divisor objects.\n        For an input of 0, an empty set of divisors is returned.\n        \"\"\"\n        divs = set()\n        if self.value == 0:\n            return set()\n        \n        n = self.value\n        for i in range(1, int(n**0.5) + 1):\n            if n % i == 0:\n                divs.add(Divisor(i))\n                divs.add(Divisor(n // i))\n        return divs\n\ndef sum_common_divisors(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the sum of common divisors of two integers.\n    It leverages the Number and Divisor domain classes for divisor enumeration.\n    \"\"\"\n    num_a = Number(a)\n    num_b = Number(b)\n\n    divisors_a = num_a.divisors()\n    divisors_b = num_b.divisors()\n\n    common_divisors_objects = divisors_a.intersection(divisors_b)\n\n    total_sum = sum(d.value for d in common_divisors_objects)\n\n    return total_sum"}
{"task_id": "Mbpp/129", "solution": "class Matrix:\n    \"\"\"\n    Helper class encapsulating matrix data and validation logic.\n    It provides methods to check for squareness, distinct elements, and calculate various sums.\n    \"\"\"\n    def __init__(self, elements: list[list[int]]):\n        self._elements = elements\n        self._n = len(elements) if elements else 0\n        self._is_valid_square_input = False\n\n        if self._n > 0:\n            if all(len(row) == self._n for row in self._elements):\n                self._is_valid_square_input = True\n\n    def is_square(self) -> bool:\n        \"\"\"Checks if the matrix is square and non-empty.\"\"\"\n        return self._is_valid_square_input\n\n    def has_distinct_elements(self) -> bool:\n        \"\"\"Checks if all elements in the matrix are distinct.\"\"\"\n        if not self.is_square():\n            return False\n        \n        seen = set()\n        for row in self._elements:\n            for x in row:\n                if x in seen:\n                    return False\n                seen.add(x)\n        return True\n\n    def row_sums(self) -> list[int]:\n        \"\"\"Calculates the sum of each row.\"\"\"\n        if not self.is_square():\n            return []\n        return [sum(row) for row in self._elements]\n\n    def col_sums(self) -> list[int]:\n        \"\"\"Calculates the sum of each column.\"\"\"\n        if not self.is_square():\n            return []\n        sums = [0] * self._n\n        for j in range(self._n):\n            for i in range(self._n):\n                sums[j] += self._elements[i][j]\n        return sums\n\n    def diag_sums(self) -> list[int]:\n        \"\"\"Calculates the sum of the main and anti-diagonals.\"\"\"\n        if not self.is_square():\n            return []\n        main_diag_sum = 0\n        anti_diag_sum = 0\n        for i in range(self._n):\n            main_diag_sum += self._elements[i][i]\n            anti_diag_sum += self._elements[i][self._n - 1 - i]\n        return [main_diag_sum, anti_diag_sum]\n\n    def is_magic_square(self) -> bool:\n        \"\"\"Determines if the encapsulated matrix is a magic square.\"\"\"\n        if not self.is_square():\n            return False\n        \n        if not self.has_distinct_elements():\n            return False\n\n        r_sums = self.row_sums()\n        c_sums = self.col_sums()\n        d_sums = self.diag_sums()\n\n        expected_sum = r_sums[0]\n\n        if not all(s == expected_sum for s in r_sums):\n            return False\n        if not all(s == expected_sum for s in c_sums):\n            return False\n        if not all(s == expected_sum for s in d_sums):\n            return False\n        \n        return True\n\ndef magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"\n    Checks if the given matrix is a magic square.\n    It delegates the validation logic to an internal Matrix helper class.\n    \"\"\"\n    matrix_obj = Matrix(matrix)\n    return matrix_obj.is_magic_square()"}
{"task_id": "Mbpp/130", "solution": "from collections import defaultdict\n\ndef max_occurrences(items):\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    \"\"\"\n    if not items:\n        return None\n\n    frequency_map = defaultdict(int)\n    max_freq = -1\n    max_item = None\n\n    for item in items:\n        frequency_map[item] += 1\n        current_freq = frequency_map[item]\n\n        if current_freq > max_freq:\n            max_freq = current_freq\n            max_item = item\n        # If current_freq == max_freq, we keep the existing max_item\n        # as per the example which returns 2 even if 1 also has 5 occurrences.\n        # This implies returning the one encountered first (or first to reach that max frequency).\n\n    return max_item"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels in a given string.\n    'y' is not considered a vowel.\n    \"\"\"\n    vowels = \"aeiouAEIOU\"\n    s_list = list(s)\n    \n    left = 0\n    right = len(s) - 1\n    \n    while left < right:\n        while left < right and s_list[left] not in vowels:\n            left += 1\n        while left < right and s_list[right] not in vowels:\n            right -= 1\n        \n        if left < right:\n            s_list[left], s_list[right] = s_list[right], s_list[left]\n            left += 1\n            right -= 1\n            \n    return \"\".join(s_list)"}
