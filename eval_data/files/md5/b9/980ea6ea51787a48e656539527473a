{"task_id": "Mbpp/232", "solution": "import heapq\n\ndef larg_nnum(items: list, n: int) -> list:\n    \"\"\"\n    Returns a list containing the n largest items from the input list.\n    The returned list is sorted in descending order.\n    \"\"\"\n    if n <= 0:\n        return []\n\n    min_heap = []\n    for item in items:\n        if len(min_heap) < n:\n            heapq.heappush(min_heap, item)\n        else:\n            if item > min_heap[0]:\n                heapq.heapreplace(min_heap, item)\n\n    # Sort the elements retrieved from the heap in descending order.\n    min_heap.sort(reverse=True)\n    return min_heap"}
{"task_id": "Mbpp/233", "solution": "import math\n\nclass Cylinder:\n    \"\"\"Represents a right circular cylinder with a given radius and height.\"\"\"\n    def __init__(self, radius: float, height: float):\n        self.radius = radius\n        self.height = height\n\n    def lateralSurfaceArea(self) -> float:\n        \"\"\"Calculates the lateral surface area of the cylinder.\"\"\"\n        return 2 * math.pi * self.radius * self.height\n\ndef lateralsuface_cylinder(radius: float, height: float) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cylinder.\n    Instantiates a Cylinder object and computes its lateral surface area.\n    \"\"\"\n    cylinder = Cylinder(radius, height)\n    return cylinder.lateralSurfaceArea()"}
