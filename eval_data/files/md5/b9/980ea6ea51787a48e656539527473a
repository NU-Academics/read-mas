{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(array):\n    \"\"\"\n    Calculates the maximum difference between any two elements in the given array.\n    Assumes the input array is a non-empty sequence of integers.\n    \"\"\"\n    if not array:\n        # Based on design, a ValueError would be raised, but per instructions, we don't add checks.\n        # This case should ideally not be reached with valid inputs per the design context's happy path assumption.\n        return 0 # Or raise an error if instructions allowed. For now, a \"safe\" return.\n\n    max_val = array[0]\n    min_val = array[0]\n\n    for x in array:\n        if x > max_val:\n            max_val = x\n        if x < min_val:\n            min_val = x\n            \n    return max_val - min_val"}
{"task_id": "Mbpp/160", "solution": "def _extended_gcd(a: int, b: int) -> tuple[int, int, int]:\n    \"\"\"Returns (gcd, x, y) such that a*x + b*y = gcd(a, b).\"\"\"\n    if a == 0 and b == 0:\n        return (0, 0, 0)\n    if b == 0:\n        return (abs(a), 1 if a >= 0 else -1, 0)\n\n    gcd, x1, y1 = _extended_gcd(b, a % b)\n    x = y1\n    y = x1 - (a // b) * y1\n    return (gcd, x, y)\n\n\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"Returns integers x and y that satisfy ax + by = n as a tuple, or None if no solution exists.\"\"\"\n    if a == 0 and b == 0:\n        if n == 0:\n            return (0, 0)\n        else:\n            return None\n\n    gcd_val, s_particular, t_particular = _extended_gcd(a, b)\n\n    if n % gcd_val != 0:\n        return None\n\n    factor = n // gcd_val\n    x_base = s_particular * factor\n    y_base = t_particular * factor\n\n    b_term_x = b // gcd_val\n    a_term_y = a // gcd_val\n\n    # If b is 0, x is uniquely determined. No further adjustment for x is needed.\n    if b_term_x == 0:\n        return (x_base, y_base)\n\n    # Adjust x to find the smallest non-negative x.\n    # The period for x is abs(b_term_x).\n    abs_b_term_x = abs(b_term_x)\n    x_final = (x_base % abs_b_term_x + abs_b_term_x) % abs_b_term_x\n\n    # Calculate k_adj, the integer factor required to transform x_base to x_final.\n    k_adj = (x_final - x_base) // b_term_x\n\n    # Calculate the corresponding y_final.\n    y_final = y_base - k_adj * a_term_y\n\n    return (x_final, y_final)"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series n + (n-2) + (n-4) + ...\n    until the next term would be less than or equal to 0.\n    \"\"\"\n    total = 0\n    current = n\n    while current > 0:\n        total += current\n        current -= 2\n    return total"}
{"task_id": "Mbpp/165", "solution": "class Alphabet:\n    \"\"\"Provides an immutable mapping from letters to their 0-based alphabet positions.\"\"\"\n    def __init__(self):\n        self.letter_position = {chr(ord('a') + i): i for i in range(26)}\n\n    def get_position(self, letter: str) -> int | None:\n        \"\"\"Returns the 0-based position of a letter in the alphabet, or None if not an alphabet character.\"\"\"\n        return self.letter_position.get(letter)\n\nclass StringProcessor:\n    \"\"\"Processes strings to count characters matching their alphabet position.\"\"\"\n    def __init__(self):\n        self.alphabet = Alphabet()\n\n    def count_char_position(self, input_string: str) -> int:\n        \"\"\"Counts characters in the string that match their alphabet position.\"\"\"\n        count = 0\n        for i, char in enumerate(input_string):\n            lower_char = char.lower()\n            alphabet_pos = self.alphabet.get_position(lower_char)\n            if alphabet_pos is not None and alphabet_pos == i:\n                count += 1\n        return count\n\ndef count_char_position(input_string: str) -> int:\n    \"\"\"Counts characters in the string that match their alphabet position (case-insensitive).\"\"\"\n    processor = StringProcessor()\n    return processor.count_char_position(input_string)"}
{"task_id": "Mbpp/166", "solution": "from typing import List\n\ndef find_even_pair(numbers: List[int]) -> int:\n    \"\"\"\n    Counts unordered pairs of integers in `numbers` whose XOR is even.\n    \"\"\"\n    even_count = sum(1 for n in numbers if n % 2 == 0)\n    odd_count = len(numbers) - even_count\n\n    def comb2(n: int) -> int:\n        return n * (n - 1) // 2\n\n    return comb2(even_count) + comb2(odd_count)"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Handles non-positive values by returning 1.\n    \"\"\"\n    if n <= 0:\n        return 1\n\n    # If n is already a power of 2, return n.\n    if n & (n - 1) == 0:\n        return n\n\n    # Find the next power of 2 using bitwise operations.\n    n -= 1\n    n |= n >> 1\n    n |= n >> 2\n    n |= n >> 4\n    n |= n >> 8\n    n |= n >> 16\n    n |= n >> 32\n    n += 1\n    return n"}
