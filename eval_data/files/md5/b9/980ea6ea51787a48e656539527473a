{"task_id": "Mbpp/62", "solution": "from typing import List\n\nclass NumberList:\n    \"\"\"Represents a collection of integers for domain operations.\"\"\"\n    def __init__(self, numbers: List[int]):\n        self.numbers = numbers\n\nclass SmallestNumberFinder:\n    \"\"\"A service that finds the smallest number within a NumberList.\"\"\"\n    def find_min(self, number_list: NumberList) -> int:\n        return min(number_list.numbers)\n\ndef smallest_num(numbers: List[int]) -> int:\n    \"\"\"Finds the smallest number in a list of integers, adhering to Clean Architecture principles.\"\"\"\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty.\")\n    \n    number_list_entity = NumberList(numbers)\n    finder_service = SmallestNumberFinder()\n    return finder_service.find_min(number_list_entity)"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(digit_string: str) -> int:\n    \"\"\"\n    Count the number of contiguous substrings of `digit_string` where\n    the sum of the digits equals the substring's length.\n\n    Parameters\n    ----------\n    digit_string : str\n        A string consisting only of decimal digits ('0'\u2013'9').\n\n    Returns\n    -------\n    int\n        The count of substrings satisfying the sum\u2011equals\u2011length condition.\n\n    Raises\n    ------\n    ValueError\n        If `digit_string` contains any non\u2011digit characters.\n    \"\"\"\n    if not digit_string.isdigit():\n        raise ValueError(\"Input must contain only digits.\")\n\n    n = len(digit_string)\n    if n == 0:\n        return 0\n\n    count = 0\n    digits = [int(ch) for ch in digit_string]\n\n    for start in range(n):\n        current_sum = 0\n        for end in range(start, n):\n            current_sum += digits[end]\n            length = end - start + 1\n            if current_sum == length:\n                count += 1\n\n    return count"}
