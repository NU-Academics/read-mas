{"task_id": "Mbpp/119", "solution": "from typing import List\n\ndef search(array: List[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array\n    where all other elements appear exactly twice.\n    \"\"\"\n    n = len(array)\n    left, right = 0, n - 1\n\n    while left < right:\n        mid = (left + right) // 2\n\n        if mid % 2 == 0:  # mid is an even index\n            if array[mid] == array[mid + 1]:\n                left = mid + 2  # The unique element is after this pair\n            else:\n                right = mid     # The unique element is at or before mid\n        else:  # mid is an odd index\n            if array[mid] == array[mid - 1]:\n                left = mid + 1  # The unique element is after this pair\n            else:\n                right = mid     # The unique element is at or before mid\n\n    return array[left]"}
{"task_id": "Mbpp/120", "solution": "from dataclasses import dataclass\nfrom typing import List, Tuple\n\n@dataclass\nclass IntegerPair:\n    \"\"\"Simple container for two integers.\"\"\"\n    first: int\n    second: int\n\nclass ProductCalculator:\n    \"\"\"Encapsulates the algorithm to find the maximum absolute product.\"\"\"\n\n    def max_product_tuple(self, pairs: List[IntegerPair]) -> int:\n        \"\"\"\n        Calculates the maximum absolute product from a list of IntegerPair objects.\n        The product is calculated for numbers within each pair.\n        \"\"\"\n        max_abs_prod = 0\n        for pair in pairs:\n            product = pair.first * pair.second\n            max_abs_prod = max(max_abs_prod, abs(product))\n        return max_abs_prod\n\ndef max_product_tuple(pairs: List[Tuple[int, int]]) -> int:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    \"\"\"\n    integer_pairs = [IntegerPair(first=p[0], second=p[1]) for p in pairs]\n    calculator = ProductCalculator()\n    return calculator.max_product_tuple(integer_pairs)"}
{"task_id": "Mbpp/123", "solution": "def _sum_proper_divisors(num: int) -> int:\n    \"\"\"Calculates the sum of proper divisors for a given number.\"\"\"\n    if num <= 1:\n        return 0\n    divisor_sum = 1  # 1 is always a proper divisor\n    # Iterate from 2 up to the square root of num\n    for i in range(2, int(num**0.5) + 1):\n        if num % i == 0:\n            divisor_sum += i\n            if i * i != num:\n                divisor_sum += num // i\n    return divisor_sum\n\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"\n    Sums all amicable numbers from 1 to a specified number n.\n    An amicable pair (a, b) consists of two distinct positive integers\n    where the sum of proper divisors of a equals b and vice versa.\n    \"\"\"\n    total_sum = 0\n    # Cache for storing sum of proper divisors to avoid re-calculation.\n    divisor_sums_cache = {}\n    # Set to track amicable numbers already added to avoid double counting.\n    amicable_numbers_added = set()\n\n    for a in range(1, n + 1):\n        if a in amicable_numbers_added:\n            continue\n\n        if a not in divisor_sums_cache:\n            divisor_sums_cache[a] = _sum_proper_divisors(a)\n\n        b = divisor_sums_cache[a]\n\n        # Check conditions for an amicable pair (a, b)\n        if a != b and 1 <= b <= n:\n            if b not in divisor_sums_cache:\n                divisor_sums_cache[b] = _sum_proper_divisors(b)\n\n            sum_divisors_b = divisor_sums_cache[b]\n\n            if sum_divisors_b == a:\n                # Found an amicable pair (a, b)\n                total_sum += a\n                total_sum += b\n                amicable_numbers_added.add(a)\n                amicable_numbers_added.add(b)\n\n    return total_sum"}
