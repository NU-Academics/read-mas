{"task_id": "Mbpp/6", "solution": "def _popcount(x: int) -> int:\n    \"\"\"\n    Count the number of set bits in an integer.\n    Uses Brian Kernighan's algorithm for O(k) performance.\n    \"\"\"\n    count = 0\n    while x:\n        x &= x - 1\n        count += 1\n    return count\n\ndef differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"\n    Determine whether two non\u2011negative integers differ by exactly one bit.\n    Compares the popcount of their XOR result to 1.\n    \"\"\"\n    xor = a ^ b\n    return _popcount(xor) == 1"}
{"task_id": "Mbpp/3", "solution": "import math\n\ndef is_not_prime(n: int) -> bool:\n    \"\"\"\n    Identifies if a number is not prime based on prime number rules.\n    Returns True for non-prime numbers and False for prime numbers.\n    \"\"\"\n    if n < 2:\n        return True\n    if n == 2:\n        return False\n    \n    # Check for divisibility from 2 up to the square root of n\n    for i in range(2, math.isqrt(n) + 1):\n        if n % i == 0:\n            return True\n    \n    return False"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Return the minimal positive rotation count that reproduces the original string.\n\n    Parameters\n    ----------\n    s : str\n        Non\u2011empty input string.\n\n    Returns\n    -------\n    int\n        Smallest positive integer k such that rotating s by k positions\n        results in s. For strings with all identical characters, k == 1.\n    \"\"\"\n    n = len(s)\n    # Build the prefix function (failure function) for KMP\n    pi = [0] * n\n    for i in range(1, n):\n        j = pi[i - 1]\n        while j > 0 and s[i] != s[j]:\n            j = pi[j - 1]\n        if s[i] == s[j]:\n            j += 1\n        pi[i] = j\n\n    # The length of the longest proper prefix which is also a suffix\n    lps = pi[-1]\n    period = n - lps\n    # If the string is composed of repeated patterns, period is the minimal rotation\n    # Otherwise, the minimal rotation is the length of the string itself\n    return period if period != n else n"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, char: str) -> str:\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    Handles cases where the character is not found or appears only once.\n    \"\"\"\n    first_index = input_string.find(char)\n    last_index = input_string.rfind(char)\n\n    if first_index == -1:\n        # Character not found, return original string\n        return input_string\n    elif first_index == last_index:\n        # Character found only once, remove that single occurrence\n        return input_string[:first_index] + input_string[first_index + 1:]\n    else:\n        # Remove first and last occurrences\n        return input_string[:first_index] + \\\n               input_string[first_index + 1:last_index] + \\\n               input_string[last_index + 1:]"}
