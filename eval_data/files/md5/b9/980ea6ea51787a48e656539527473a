{"task_id": "Mbpp/139", "solution": "import math\n\nclass MathConstants:\n    \"\"\"Contains mathematical constants.\"\"\"\n    PI = math.pi\n\nclass MathUtility:\n    \"\"\"Provides utility methods for mathematical calculations.\"\"\"\n    @staticmethod\n    def circle_circumference(radius: float) -> float:\n        \"\"\"Calculates the circumference of a circle.\"\"\"\n        return 2 * MathConstants.PI * radius\n\ndef circle_circumference(radius: float) -> float:\n    \"\"\"\n    Calculates the circumference of a circle given its radius.\n    Delegates the calculation to MathUtility.\n    \"\"\"\n    return MathUtility.circle_circumference(radius)"}
{"task_id": "Mbpp/137", "solution": "def zero_count(array: list[int]) -> float:\n    \"\"\"Calculates the ratio of zeroes to non-zeroes in an array.\"\"\"\n    num_zeros = 0\n    num_non_zeros = 0\n\n    for x in array:\n        if x == 0:\n            num_zeros += 1\n        else:\n            num_non_zeros += 1\n\n    if num_non_zeros == 0:\n        return 0.0\n    else:\n        return float(num_zeros) / num_non_zeros"}
{"task_id": "Mbpp/140", "solution": "from typing import List, Tuple, Set\n\ndef extract_singly(input_list: List[Tuple[int, ...]]) -> Set[int]:\n    \"\"\"\n    Flattens a list of tuples of integers into a single set of unique numbers.\n    \"\"\"\n    result_set = set()\n    for item_tuple in input_list:\n        for number in item_tuple:\n            result_set.add(number)\n    return result_set"}
{"task_id": "Mbpp/141", "solution": "import copy\nfrom typing import List\n\n\ndef pancake_sort(input_list: List[int]) -> List[int]:\n    \"\"\"Sorts a list of integers in ascending order using pancake sort.\n    Returns a new list with the sorted integers.\n    \"\"\"\n    arr = copy.deepcopy(input_list)\n    n = len(arr)\n\n    def flip(k: int) -> None:\n        arr[:k] = reversed(arr[:k])\n\n    for size in range(n, 1, -1):\n        max_index = max(range(size), key=arr.__getitem__)\n\n        if max_index != size - 1:\n            if max_index != 0:\n                flip(max_index + 1)\n            flip(size)\n\n    return arr"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1, list2, list3):\n    \"\"\"\n    Counts the number of positions where all three input lists have identical items.\n    Raises ValueError if lists are not of equal length.\n    \"\"\"\n    if not (len(list1) == len(list2) == len(list3)):\n        raise ValueError(\"All input lists must have the same length\")\n\n    count = 0\n    for i in range(len(list1)):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
