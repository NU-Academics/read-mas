{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Computes the number of positive divisors for a given positive integer n.\n    Iterates up to sqrt(n) to find divisor pairs.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count"}
{"task_id": "Mbpp/98", "solution": "import math\nfrom typing import Iterable, Union\n\nclass NumberSequence:\n    \"\"\"Domain entity representing a sequence of numbers.\"\"\"\n    def __init__(self, numbers: Iterable[Union[int, float]]):\n        self.numbers = list(numbers)\n\nclass ProductCalculator:\n    \"\"\"Application service for calculating product and division.\"\"\"\n    def multiply_and_divide(self, seq: NumberSequence) -> float:\n        if not seq.numbers:\n            raise ValueError(\"Input sequence cannot be empty.\")\n        \n        product = math.prod(seq.numbers)\n        result = product / len(seq.numbers)\n        return float(result)\n\ndef multiply_num(seq: Iterable[Union[int, float]]) -> float:\n    \"\"\"\n    Multiplies all numbers in a list and divides the product by the list's length.\n    Raises ValueError if the input sequence is empty.\n    \"\"\"\n    number_sequence = NumberSequence(seq)\n    calculator = ProductCalculator()\n    return calculator.multiply_and_divide(number_sequence)"}
{"task_id": "Mbpp/97", "solution": "from collections import Counter\nfrom typing import Any, Dict, List\n\ndef frequency_lists(lists: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"\n    Compute the frequency of each element in a nested list of lists.\n    Returns a dictionary mapping each unique element to its frequency.\n    \"\"\"\n    flattened = (item for sublist in lists for item in sublist)\n    counter = Counter(flattened)\n    return dict(counter)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(number):\n    \"\"\"\n    Converts a decimal number to its binary equivalent as a string.\n    Handles non-negative integers.\n    \"\"\"\n    if number == 0:\n        return '0'\n\n    binary_string = []\n    temp_number = number\n    while temp_number > 0:\n        binary_string.append(str(temp_number % 2))\n        temp_number //= 2\n    \n    return \"\".join(reversed(binary_string))"}
