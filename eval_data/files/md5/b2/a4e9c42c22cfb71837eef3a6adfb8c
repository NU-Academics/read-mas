{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from an array 'a'\n    where a[x] = x*x - x + 1, such that i < j < k and a[i] + a[j] + a[k]\n    is a multiple of 3.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    # We only care about the remainders of a[x] when divided by 3.\n    # a[x] = x*x - x + 1\n    # If x % 3 == 0, then a[x] % 3 = (0 - 0 + 1) % 3 = 1\n    # If x % 3 == 1, then a[x] % 3 = (1 - 1 + 1) % 3 = 1\n    # If x % 3 == 2, then a[x] % 3 = (4 - 2 + 1) % 3 = 3 % 3 = 0\n    # So, a[x] % 3 is 0 if x % 3 == 2, and 1 otherwise. No element has remainder 2.\n\n    count0 = 0  # Number of elements a[x] such that a[x] % 3 == 0\n    count1 = 0  # Number of elements a[x] such that a[x] % 3 == 1\n\n    for i in range(1, n + 1):\n        if i % 3 == 2:\n            count0 += 1\n        else:\n            count1 += 1\n\n    # A triple (a[i], a[j], a[k]) sums to a multiple of 3 if (a[i]%3 + a[j]%3 + a[k]%3) % 3 == 0.\n    # Given that elements can only have remainders 0 or 1:\n    # The valid combinations of remainders are (0, 0, 0) and (1, 1, 1).\n    # Other combinations like (0, 0, 1), (0, 1, 1) do not sum to a multiple of 3.\n\n    def combinations_3(k):\n        \"\"\"Calculates 'k choose 3', which is k*(k-1)*(k-2) / 6, or 0 if k < 3.\"\"\"\n        if k < 3:\n            return 0\n        return (k * (k - 1) * (k - 2)) // 6\n\n    # Count triples of (0, 0, 0) remainders\n    triples_from_0_remainder = combinations_3(count0)\n\n    # Count triples of (1, 1, 1) remainders\n    triples_from_1_remainder = combinations_3(count1)\n\n    return triples_from_0_remainder + triples_from_1_remainder"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Write a function that accepts a list of strings as a parameter,\n    deletes the strings that have odd lengths from it,\n    and returns the resulted list with a sorted order,\n    The list is always a list of strings and never an array of numbers,\n    and it may contain duplicates.\n    The order of the list should be ascending by length of each word, and you\n    should return the list sorted by that rule.\n    If two words have the same length, sort the list alphabetically.\n    The function should return a list of strings in sorted order.\n    You may assume that all words will have the same length.\n    For example:\n    assert list_sort([\"aa\", \"a\", \"aaa\"]) => [\"aa\"]\n    assert list_sort([\"ab\", \"a\", \"aaa\", \"cd\"]) => [\"ab\", \"cd\"]\n    \"\"\"\n    # Filter out strings that have odd lengths.\n    filtered_list = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort strings based on two criteria: primarily by length (ascending),\n    # and secondarily alphabetically for strings of the same length.\n    return sorted(filtered_list, key=lambda s: (len(s), s))"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun\n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn,\n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2.\n    The function should return a tuple containing all planets whose orbits are\n    located between the orbit of planet1 and the orbit of planet2, sorted by\n    the proximity to the sun.\n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names.\n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    class PlanetModel:\n        PLANET_ORDER = [\n            \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n        ]\n\n        def get_planet_order(self):\n            \"\"\"Returns a copy of the canonical ordered list of planets.\"\"\"\n            return list(self.PLANET_ORDER)\n\n    class PlanetValidator:\n        def __init__(self, planet_order):\n            \"\"\"\n            Initializes the PlanetValidator with the canonical list of planets.\n            Args: planet_order: The ordered list of valid planet names.\n            \"\"\"\n            self._planet_order = planet_order\n\n        def is_valid_planet(self, planet_name):\n            \"\"\"\n            Checks if a given planet name is valid.\n            Args: planet_name: The name of the planet to validate.\n            Returns: True if the planet name is valid, False otherwise.\n            \"\"\"\n            return planet_name in self._planet_order\n\n    class PlanetService:\n        def __init__(self, planet_model):\n            \"\"\"\n            Initializes the PlanetService with a PlanetModel instance.\n            Args: planet_model: An instance of PlanetModel to access planet data.\n            \"\"\"\n            self._planet_model = planet_model\n\n        def find_planets_between(self, planet1, planet2):\n            \"\"\"\n            Finds all planets located between the orbits of planet1 and planet2.\n            Assumes planet1 and planet2 are valid planet names.\n            \"\"\"\n            planet_order = self._planet_model.get_planet_order()\n\n            idx1 = planet_order.index(planet1)\n            idx2 = planet_order.index(planet2)\n\n            start_idx = min(idx1, idx2)\n            end_idx = max(idx1, idx2)\n\n            if end_idx - start_idx <= 1:\n                return ()\n\n            return tuple(planet_order[start_idx + 1:end_idx])\n\n    planet_model = PlanetModel()\n    current_planet_order = planet_model.get_planet_order()\n    planet_validator = PlanetValidator(current_planet_order)\n\n    if not planet_validator.is_valid_planet(planet1) or \\\n       not planet_validator.is_valid_planet(planet2):\n        return ()\n\n    planet_service = PlanetService(planet_model)"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    '''\n    total_sum = 0\n    if not lst:\n        return 0\n\n    for num in lst:\n        # Check if the number is an integer, non-negative, and odd.\n        if isinstance(num, int) and num >= 0 and num % 2 != 0:\n            total_sum += num * num\n\n    return total_sum"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n    \"\"\"\n    from math import isqrt\n\n    def _is_prime(num):\n        \"\"\"Checks if the given integer is a prime number.\n        Uses an optimized algorithm checking divisibility up to the square root.\"\"\"\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        # Check for odd divisors from 3 up to the square root of num\n        for i in range(3, isqrt(num) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    if _is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension and returns it in the format 'ClassName.StrongestExtensionName'.\n    Strength is calculated as (number of uppercase letters) - (number of lowercase letters).\n    In case of a tie, the first extension encountered with that strength is chosen.\n    \"\"\"\n    strongest_extension_name = \"\"\n    max_strength = float('-inf') # Initialize with a very small number\n\n    for ext_name in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in ext_name:\n            if char.isupper():\n                cap_count += 1\n            elif char.islower():\n                sm_count += 1\n\n        current_strength = cap_count - sm_count\n\n        # Update if current extension is strictly stronger,\n        # or if it's the very first extension being considered.\n        # For ties, we keep the one that came first (strongest_extension_name)\n        # so we only update if current_strength > max_strength.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = ext_name\n        elif strongest_extension_name == \"\": # Handle the very first extension\n            max_strength = current_strength\n            strongest_extension_name = ext_name\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\"\"\"\n    if not b:\n        return True\n\n    if not a:\n        return False\n\n    rotations = set()\n    for i in range(len(b)):\n        rotated_b = b[i:] + b[:i]\n        rotations.add(rotated_b)\n\n    for rotation in rotations:\n        if rotation in a:\n            return True\n\n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    s_num = str(abs(num))\n    even_count = 0\n    odd_count = 0\n\n    for digit_char in s_num:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    # Define the Roman numeral mapping from largest to smallest value.\n    ROMAN_MAP = [\n        (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"),\n        (100, \"C\"), (90, \"XC\"), (50, \"L\"), (40, \"XL\"),\n        (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"), (1, \"I\")\n    ]\n\n    roman_numeral_parts = []\n    current_number = number\n\n    # Iterate through the map, greedily appending Roman symbols.\n    for value, symbol in ROMAN_MAP:\n        while current_number >= value:\n            roman_numeral_parts.append(symbol)\n            current_number -= value\n\n    return \"\".join(roman_numeral_parts).lower()"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"I think we all remember that feeling when the result of some long-awaited\n    event is finally known. The feelings and thoughts you have at that moment are\n    definitely worth noting down and comparing.\n    Your task is to determine if a person correctly guessed the results of a number of matches.\n    You are given two arrays of scores and guesses of equal length, where each index shows a match.\n    Return an array of the same length denoting how far off each guess was. If they have guessed correctly,\n    the value is 0, and if not, the value is the absolute difference between the guess and the score.\n\n\n    example:\n\n    compare([1,2,3,4,5,1],[1,2,3,4,2,-2]) -> [0,0,0,0,3,3]\n    compare([0,5,0,0,0,4],[4,1,1,0,0,-2]) -> [4,4,1,0,0,6]\n    \"\"\"\n    if len(game) != len(guess):\n        raise ValueError(\"Input arrays 'game' and 'guess' must be of equal length.\")\n\n    result = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            result.append(0)\n        else:\n            result.append(abs(game[i] - guess[i]))\n    return result"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n\n    def _count_unique_chars(word: str) -> int:\n        \"\"\"Counts the number of unique characters in a given string.\"\"\"\n        return len(set(word))\n\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = _count_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-break by lexicographical order\n            if result_word == \"\" or word < result_word:\n                result_word = word\n    return result_word"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten by a rabbit and the remaining stock after a meal.\n    The rabbit eats the minimum of its needs or the available remaining carrots.\n    \"\"\"\n    carrots_eaten_from_stock = min(need, remaining)\n    total_eaten_carrots = number + carrots_eaten_from_stock\n    carrots_left_in_stock = remaining - carrots_eaten_from_stock\n\n    return [total_eaten_carrots, carrots_left_in_stock]"}
{"task_id": "HumanEval/157", "solution": "import math\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Sort sides to identify the hypotenuse, then apply the Pythagorean theorem with tolerance.\n    # FLOAT_TOLERANCE accounts for floating-point inaccuracies.\n    sides = sorted([a, b, c])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n\n    FLOAT_TOLERANCE = 1e-9\n    return math.isclose(s1**2 + s2**2, s3**2, rel_tol=FLOAT_TOLERANCE)"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Reverses case of letters or reverses the whole string if no letters are present.\"\"\"\n\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if not has_letters:\n        return s[::-1]\n\n    result_chars = []\n    for char in s:\n        if char.isalpha():\n            if char.islower():\n                result_chars.append(char.upper())\n            elif char.isupper():\n                result_chars.append(char.lower())\n            else: # Handle other alpha characters (e.g., titlecase, or unexpected unicode which is_alpha but not upper/lower)\n                result_chars.append(char)\n        else:\n            result_chars.append(char)\n\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n\n    >>> string_to_md5('Hello world') == '3e25960a79dbc69b674cd4ec67a72c62'\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/160", "solution": "class InvalidExpressionError(Exception):\n    \"\"\"Exception raised for structurally invalid expressions.\"\"\"\n    pass\nclass InvalidOperatorError(Exception):\n    \"\"\"Exception raised for unsupported or unrecognized operators.\"\"\"\n    pass\nclass OperatorRegistry:\n    \"\"\"Manages the definitions and properties of supported algebraic operators.\"\"\"\n    OPERATOR_PRECEDENCE = {\n        '**': 3,\n        '*': 2,\n        '//': 2,\n        '+': 1,\n        '-': 1\n    }\n\n    def __init__(self):\n        pass\n\n    def get_precedence(self, op: str) -> int:\n        \"\"\"Returns the precedence level for a given operator.\"\"\"\n        if op not in self.OPERATOR_PRECEDENCE:\n            raise InvalidOperatorError(f\"Operator '{op}' not recognized.\")\n        return self.OPERATOR_PRECEDENCE[op]\n\n    def is_operator(self, op: str) -> bool:\n        \"\"\"Checks if a given string is a recognized operator.\"\"\"\n        return op in self.OPERATOR_PRECEDENCE\nclass AlgebraEvaluator:\n    \"\"\"Orchestrates the construction and evaluation of algebraic expressions.\"\"\"\n    def __init__(self):\n        self.operator_registry = OperatorRegistry()\n\n    def evaluate(self, operators: list[str], operands: list[int]) -> int:\n        \"\"\"Constructs an expression string and evaluates it using Python's eval.\"\"\"\n        if not (len(operators) == len(operands) - 1 and len(operands) >= 2):\n            raise InvalidExpressionError(\"Mismatched operator/operand count or insufficient operands.\")\n\n        expression_parts = []\n        expression_parts.append(str(operands[0]))\n        for i in range(len(operators)):\n            op = operators[i]\n            if not self.operator_registry.is_operator(op):\n                raise InvalidOperatorError(f\"Unsupported operator: {op}\")\n            expression_parts.append(op)\n            expression_parts.append(str(operands[i+1]))\n\n        expression_str = \" \".join(expression_parts)\n        try:\n            return int(eval(expression_str))\n        except Exception as e:\n            raise InvalidExpressionError(f\"Error evaluating expression: {e}\")\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n    \"\"\"\n    validate_input_lists(operator, operand)\n    evaluator = AlgebraEvaluator()\n    return evaluator.evaluate(operator, operand)"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    result = []\n    # Even digits to consider (0 is excluded as a and b are positive, >=1)\n    EVEN_DIGITS = (2, 4, 6, 8)\n\n    for digit in EVEN_DIGITS:\n        if min_val <= digit <= max_val:\n            result.append(digit)\n\n    return result"}
