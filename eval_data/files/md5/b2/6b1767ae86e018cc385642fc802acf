        # Explore down\n            if r + 1 < matrix.size:\n                self._find_all_paths_dfs(matrix, r + 1, c, current_path_cells)\n            # Explore right\n            if c + 1 < matrix.size:\n                self._find_all_paths_dfs(matrix, r, c + 1, current_path_cells)\n\n        # Backtrack: Remove current cell to explore other paths\n        current_path_cells.pop()\n\n    def computeMaxAverage(self, matrix: 'Matrix') -> float:\n        \"\"\"Initiates the pathfinding process and returns the maximum average cost.\"\"\"\n        if matrix.size == 0:\n            return 0.0\n        if matrix.size == 1:\n            return float(matrix.get_cell(0, 0).cost)\n\n        self._max_average = -float('inf') # Reset max average for this computation\n        self._find_all_paths_dfs(matrix, 0, 0, [])\n        return self._max_average\ndef maxAverageOfPath(matrix: list[list[int]]) -> float:\n    \"\"\"\n    Given a square matrix, finds a path from top-left to bottom-right with the maximum average cost.\n    Paths can only move right or down.\n    \"\"\"\n    n = len(matrix)\n    if n == 0:\n        return 0.0\n\n    # Validate if the matrix is square as per design specification.\n    for row in matrix:\n        if len(row) != n:\n            raise ValueError(\"Input matrix must be square.\")\n\n    # Instantiate Matrix and PathCostCalculator as per design.\n    matrix_obj = Matrix(matrix)\n    calculator = PathCostCalculator()\n\n    # Compute and return the maximum average.\n    return calculator.computeMaxAverage(matrix_obj)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/794": [{"task_id": "Mbpp/794", "solution": "def text_starta_endb(input: str) -> bool:\n    \"\"\"\n    Checks if a string starts with 'a', is followed by anything, and ends with 'b'.\n    \"\"\"\n    if not input:\n        return False\n    return input[0] == 'a' and input[-1] == 'b'", "base_status": "pass", "plus_status": "fail", "base_