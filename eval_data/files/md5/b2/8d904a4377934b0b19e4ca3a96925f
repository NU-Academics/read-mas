Mbpp/619": [{"task_id": "Mbpp/619", "solution": "import abc\nclass Character(abc.ABC):\n    \"\"\"Abstract base class for representing a single character and its digit status.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    @abc.abstractmethod\n    def is_digit(self) -> bool:\n        \"\"\"Abstract method to determine if the character is a digit.\"\"\"\n        pass\n\n    def get_value(self) -> str:\n        \"\"\"Returns the string value of the character.\"\"\"\n        return self._value\nclass Digit(Character):\n    \"\"\"Represents a character that is a digit.\"\"\"\n    def __init__(self, value: str):\n        super().__init__(value)\n\n    def is_digit(self) -> bool:\n        \"\"\"Returns True, indicating it's a digit.\"\"\"\n        return True\nclass NonDigit(Character):\n    \"\"\"Represents a character that is not a digit.\"\"\"\n    def __init__(self, value: str):\n        super().__init__(value)\n\n    def is_digit(self) -> bool:\n        \"\"\"Returns False, indicating it's not a digit.\"\"\"\n        return False\nclass Sequence:\n    \"\"\"Manages an ordered collection of Character objects.\"\"\"\n    def __init__(self):\n        self._characters: list[Character] = []\n\n    def add_character(self, char: Character) -> None:\n        \"\"\"Adds a character to the end of the sequence.\"\"\"\n        self._characters.append(char)\n\n    def get_characters_as_string(self) -> str:\n        \"\"\"Returns the concatenated string representation of all characters in the sequence.\"\"\"\n        return \"\".join(char.get_value() for char in self._characters)\nclass StringNumberMover:\n    \"\"\"Encapsulates the logic for separating characters, preserving order, and concatenating sequences.\"\"\"\n    def __init__(self, input_str: str):\n        self._input_string: str = input_str\n        self._non_digit_sequence: Sequence = Sequence()\n        self._digit_sequence: Sequence = Sequence()\n        self._output_string: str = \"\"\n\n    def process(self) -> None:\n        \"\"\"Executes the full sequence of separation and concatenation.\"\"\"\n        self._separate_characters()\n        self._concatenate_sequences()\n\n    def get_result(self) -> str:\n        \"\"\"Returns the final processed string.\"\"\"\n        return self._output_string\n\n    def _separate_characters(self) -> None:\n        \"\"\"Iterates through the input string, categorizing characters into non-digit and digit sequences.\"\"\"\n        for char_value in self._input_string:\n            if char_value.isdigit():\n                char_obj = Digit(char_value)\n                self._digit_sequence.add_character(char_obj)\n            else:\n                char_obj = NonDigit(char_value)\n                self._non_digit_sequence.add_character(char_obj)\n\n    def _concatenate_sequences(self) -> None:\n        \"\"\"Combines the non-digit and digit sequences into the final output string.\"\"\"\n        non_digits_str = self._non_digit_sequence.get_characters_as_string()\n        digits_str = self._digit_sequence.get_characters_as_string()\n        self._output_string = non_digits_str + digits_str\ndef move_num(input_string: str) -> str:\n    \"\"\"Accepts an input string, processes it to move numbers to the end, and returns the result.\"\"\"\n    processor = StringNumberMover(input_string)\n    processor.process()\n    return processor.get_result()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/786": [{"task_id": "Mbpp/786", "solution": "import bisect\ndef right_insertion(sorted_list: list[int], value: int) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in a sorted list.\n    The returned index ensures all elements before it are less than or equal to the value,\n    and all elements at or after it are strictly greater than the value.\n    \"\"\"\n    return bisect.bisect_right(sorted_list, value)", "base_status": "pass", "plus_statu