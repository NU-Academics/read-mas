his number's proper divisors sum to 'other_value',\n        and if the two numbers are distinct, forming an amicable pair.\n        \"\"\"\n        if self._value == other_value:\n            return False\n        \n        sum_of_m_divisors = self.calculate_sum_of_proper_divisors()\n        return sum_of_m_divisors == other_value\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Sums all unique amicable numbers from 1 up to a specified limit.\n    \"\"\"\n    amicable_numbers_set = set()\n\n    for n in range(1, limit + 1):\n        num_n = Number(n)\n        sum_div_n = num_n.calculate_sum_of_proper_divisors()\n\n        # Check for a potential amicable partner 'm' (sum_div_n).\n        # 'm' must be greater than 'n' to avoid re-processing pairs and 'm' must be within the limit.\n        if sum_div_n > n and sum_div_n <= limit:\n            num_m = Number(sum_div_n)\n            # If 'm' is an amicable partner of 'n', add both to the set.\n            if num_m.is_amicable_partner(n):\n                amicable_numbers_set.add(n)\n                amicable_numbers_set.add(sum_div_n)\n    \n    return sum(amicable_numbers_set)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/247": [{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"Calculates the length of the longest palindromic subsequence for the input string s.\n\n    Args:\n        s: The input string.\n\n    Returns:\n        The length of the longest palindromic subsequence.\n    \"\"\"\n    n = len(s)\n    dp = [[0] * n for _ in range(n)]\n\n    # Every single character is a palindrome of length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the DP table for subsequences of length 2 to n\n    for cl in range(2, n + 1):  # cl is current length of subsequence\n        for i in range(n - cl + 1):\n            j = i + cl - 1  # j is the ending index of the current subsequence\n            if s[i] == s[j] and cl == 2:\n                dp[i][j] = 2\n            elif s[i] == s[j]:\n                # If characters match, it's 2 + LPS of the inner substring\n                dp[i][j] = 2 + dp[i + 1][j - 1]\n            else:\n                # If characters don't match, take the max of excluding s[i] or s[j]\n                dp[i][j] = max(dp[i][j - 1], dp[i + 1][j])\n    return dp[0][n - 1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/239": [{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the total number of possible sequences of length n.\n    Each element must be a positive integer, less than or equal to m,\n    and greater than or equal to twice the previous element.\n    \"\"\"\n\n    def _count_sequences_recursive(current_length: int, last_element: int) -> int:\n        \"\"\"\n        Recursively counts valid sequences starting from the current state.\n        It progresses by finding valid next elements until the desired length is reached.\n        \"\"\"\n        if current_length == n:\n            return 1\n\n        count = 0\n        min_next_element = last_element * 2\n\n        # Iterate through all possible values for the next element in the sequence.\n        # The next element must be between min_next_element and m (inclusive).\n        for next_element in range(min_next_element, m + 1):\n            count += _count_sequences_recursive(current_length + 1, next_element)\n        \n        return count\n\n    total_sequences = 0\n\n    # Calculate the maximum possible value for the first element.\n    # The last element must be at most m, and it's at least (first_element * 2**(n-1)).\n    # Thus, first_element * 2**(n-1) <= m implies first_element <= m / (2**(n-1)).\n    # This optimization prunes the initial loop for first_element.\n    max_possible_first_element = m // (2**(n - 1))\n\n    # Iterate through all possible values for the