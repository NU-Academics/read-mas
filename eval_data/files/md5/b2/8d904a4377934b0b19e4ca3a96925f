Mbpp/799": [{"task_id": "Mbpp/799", "solution": "class Integer:\n    \"\"\"Encapsulates a 32-bit integer value and provides core rotation logic.\"\"\"\n    _bit_length: int = 32\n\n    def __init__(self, value: int):\n        \"\"\"Initializes the Integer object with a given value.\"\"\"\n        self._value = value & ((1 << self._bit_length) - 1) # Ensure value fits 32 bits\n\n    def left_rotate(self, rotation_count: int) -> int:\n        \"\"\"Performs a left bit rotation on the encapsulated _value.\"\"\"\n        actual_rotation = rotation_count % self._bit_length\n        rotated = (self._value << actual_rotation) | (self._value >> (self._bit_length - actual_rotation))\n        return rotated & ((1 << self._bit_length) - 1) # Mask to ensure 32-bit result\n\n    def get_value(self) -> int:\n        \"\"\"Returns the current integer value stored in the object.\"\"\"\n        return self._value\ndef left_rotate(n: int, d: int) -> int:\n    \"\"\"Rotates the 32-bit integer n to the left by d bits.\"\"\"\n    integer_obj = Integer(n)\n    return integer_obj.left_rotate(d)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/800": [{"task_id": "Mbpp/800", "solution": "import re\ndef remove_all_spaces(input_string: str) -> str:\n    \"\"\"\n    Removes all whitespace characters from the input string.\n    \"\"\"\n    return re.sub(r'\\s+', '', input_string)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["python\nprogram"]]}], "Mbpp/806": [{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Calculates the maximum length of consecutive uppercase characters in a given string.\n    Returns 0 if the string is empty or contains no uppercase characters.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n        else:\n            current_run = 0