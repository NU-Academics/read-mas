{"task_id": "HumanEval/64", "solution": "```python\ndef vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    \"\"\"\n    vowels = \"aeiouAEIOU\"\n    count = 0\n\n    for i, char in enumerate(s):\n        if char in vowels:\n            count += 1\n        elif char in 'yY' and i == len(s) - 1:\n            count += 1\n\n    return count\n```"}
{"task_id": "HumanEval/69", "solution": "```python\ndef search(lst):\n    '''\n    Return the greatest integer whose frequency is greater than or equal to its value.\n    Returns -1 if no such integer exists, considering only positive integers.\n    '''\n    frequency_map = {}\n    for num in lst:\n        frequency_map[num] = frequency_map.get(num, 0) + 1\n\n    max_result = -1\n    for value, freq in frequency_map.items():\n        if freq >= value and value > 0:\n            max_result = max(max_result, value)\n\n    return max_result\n```"}
{"task_id": "HumanEval/69", "solution": "```python\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than\n    zero, and has a frequency greater than or equal to the value of the integer itself.\n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    freq = {}\n    for element in lst:\n        freq[element] = freq.get(element, 0) + 1\n\n    qualifiers = []\n    for num, count in freq.items():\n        if count >= num:\n            qualifiers.append(num)\n\n    if qualifiers:\n        return max(qualifiers)\n    else:\n        return -1\n```"}
{"task_id": "HumanEval/70", "solution": "```python\ndef strange_sort_list(lst):\n    \"\"\"\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    \"\"\"\n    if not lst:\n        return []\n\n    working = lst.copy()\n    result = []\n    switch = True  # True indicates min-selection turn, False for max-selection\n\n    while working:\n        if switch:\n            val = min(working)\n        else:\n            val = max(working)\n\n        result.append(val)\n        working.remove(val)\n        switch = not switch\n\n    return result\n```"}
{"task_id": "HumanEval/71", "solution": "```python\nimport math\n\nclass Triangle:\n    \"\"\"Encapsulates triangle side lengths.\"\"\"\n    def __init__(self, a, b, c):\n        self.side_a = a\n        self.side_b = b\n        self.side_c = c\n\nclass TriangleValidator:\n    \"\"\"Validates if three sides form a valid triangle using the inequality theorem.\"\"\"\n    def validate_sides(self, triangle):\n        a, b, c = triangle.side_a, triangle.side_b, triangle.side_c\n        return (a + b > c) and (a + c > b) and (b + c > a)\n\nclass AreaCalculator:\n    \"\"\"Calculates triangle area using Heron's formula and rounds to two decimal places.\"\"\"\n    def calculate_area(self, triangle):\n        a, b, c = triangle.side_a, triangle.side_b, triangle.side_c\n        s = (a + b + c) / 2\n        area_squared = s * (s - a) * (s - b) * (s - c)\n\n        # Clamp area_squared to 0 if slightly negative due to floating-point inaccuracies.\n        if area_squared < 0:\n            area_squared = 0.0\n\n        area = math.sqrt(area_squared)\n        return round(area, 2)\n\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1\n    '''\n    triangle_instance = Triangle(a, b, c)\n\n    validator = TriangleValidator()\n    if not validator.validate_sides(triangle_instance):\n        return -1\n\n    calculator = AreaCalculator()\n    return calculator.calculate_area(triangle_instance)\n```"}
{"task_id": "HumanEval/71", "solution": "```python\nimport math\n\ndef validate_triangle(a: float, b: float, c: float) -> bool:\n    \"\"\"Validates if three side lengths can form a triangle.\n    It checks the triangle inequality theorem (sum of any two sides is greater than the third).\n    \"\"\"\n    return (a + b > c) and (a + c > b) and (b + c > a)\n\ndef calculate_semi_perimeter(a: float, b: float, c: float) -> float:\n    \"\"\"Calculates the semi-perimeter of a triangle.\n    This value is used in Heron's formula for area calculation.\n    \"\"\"\n    return (a + b + c) / 2\n\ndef apply_herons_formula(s: float, a: float, b: float, c: float) -> float:\n    \"\"\"Applies Heron's formula to calculate the area of a triangle.\n    It uses the semi-perimeter (s) and the three side lengths (a, b, c).\n    \"\"\"\n    # Ensure the value under the square root is non-negative due to potential floating point inaccuracies\n    # for nearly degenerate triangles, although validate_triangle should prevent negative s-a, etc.\n    radicand = s * (s - a) * (s - b) * (s - c)\n    return math.sqrt(max(0.0, radicand))\n\ndef round_to_decimal_places(value: float, places: int) -> float:\n    \"\"\"Rounds a numeric value to a specified number of decimal places.\n    It uses standard mathematical rounding rules.\n    \"\"\"\n    return round(value, places)\n\ndef triangle_area(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle, returns its area rounded to 2 decimal points.\n    Returns -1 if the three sides do not form a valid triangle.\n    \"\"\"\n    if not validate_triangle(a, b, c):\n        return -1\n\n    s = calculate_semi_perimeter(a, b, c)\n    area = apply_herons_formula(s, a, b, c)\n    return round_to_decimal_places(area, 2)\n```"}
{"task_id": "HumanEval/70", "solution": "```python\ndef strange_sort_list(lst):\n    \"\"\"\n    Sorts a list of integers into an alternating min-max pattern, starting with the minimum value.\n    Returns a new list without modifying the original input.\n    \"\"\"\n    if len(lst) == 0:\n        return []\n\n    working_copy = lst.copy()\n    result = []\n    toggle = True  # True to select min, False to select max\n\n    while len(working_copy) > 0:\n        if toggle:\n            value = min(working_copy)\n        else:\n            value = max(working_copy)\n\n        result.append(value)\n        working_copy.remove(value)\n        toggle = not toggle\n\n    return result\n```"}
{"task_id": "HumanEval/72", "solution": "```python\ndef is_palindrome(q):\n    \"\"\"\n    Checks if list is palindromic.\n    Returns True if palindromic, False otherwise.\n    \"\"\"\n    return q == q[::-1]\n\ndef calculate_sum(q):\n    \"\"\"\n    Calculates sum of all elements in list.\n    Returns sum of all elements (0 for empty list).\n    \"\"\"\n    return sum(q)\n\ndef is_within_weight_limit(sum_value, w):\n    \"\"\"\n    Compares sum against weight limit using <= operator.\n    Returns True if sum_value <= w, False otherwise.\n    \"\"\"\n    return sum_value <= w\n\ndef will_it_fly(q,w):\n    \"\"\"\n    Determines if object will fly based on balance and weight constraints.\n    Returns True if object is balanced AND sum of elements <= w, False otherwise.\n    \"\"\"\n    # Check balance first (short-circuit if unbalanced)\n    if not is_palindrome(q):\n        return False\n\n    # Calculate weight and check limit\n    sum_value = calculate_sum(q)\n    return is_within_weight_limit(sum_value, w)\n```"}
