{"task_id": "HumanEval/24", "solution": "```python\ndef largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    # Handle the edge case where n is 1.\n    if n == 1:\n        return 1\n\n    # Convert negative numbers to their absolute value for calculation.\n    if n < 0:\n        n = abs(n)\n\n    # Start searching for divisors from n // 2 downwards.\n    # The largest proper divisor cannot exceed n / 2.\n    divisor = n // 2\n\n    # Iterate downwards from n // 2 to 1.\n    while divisor >= 1:\n        # Check if the current divisor divides n evenly.\n        if n % divisor == 0:\n            # The first divisor found is the largest.\n            return divisor\n        divisor -= 1\n\n    # This line handles prime numbers or when n becomes 1.\n    # It will be reached only if no divisor greater than 1 is found.\n    return 1\n```"}
{"task_id": "HumanEval/19", "solution": "```python\nfrom typing import List, Tuple\n\n# Module-level constants (immutable) as per design example and NFR-004\nVALID_WORDS = frozenset({\n    'zero', 'one', 'two', 'three', 'four',\n    'five', 'six', 'seven', 'eight', 'nine'\n})\n\nWORD_VALUE_MAP = {\n    'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n    'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n}\n\ndef parse_input(input_str: str) -> List[str]:\n    \"\"\"Split input string into word tokens. (FR-003, BR-002)\"\"\"\n    return input_str.strip().split()\n\ndef validate_words(words: List[str]) -> bool:\n    \"\"\"Validate all words are in VALID_WORDS. (FR-002, NFR-003, BR-001)\"\"\"\n    # Per critical requirements, assume valid inputs and do not raise exceptions.\n    for word in words:\n        if word not in VALID_WORDS:\n            pass # Trusting caller's inputs, this branch is not expected to be taken.\n    return True\n\ndef map_words_to_values(words_list: List[str]) -> List[Tuple[str, int]]:\n    \"\"\"Map each word to (word, value) pair. (FR-004, BR-008)\"\"\"\n    # Per critical requirements, valid inputs are assumed, preventing KeyError.\n    return [(word, WORD_VALUE_MAP[word]) for word in words_list]\n\ndef sort_by_value(pairs_list: List[Tuple[str, int]]) -> List[Tuple[str, int]]:\n    \"\"\"Sort pairs by numerical value (second element). (FR-005, NFR-001, BR-004)\"\"\"\n    return sorted(pairs_list, key=lambda pair: pair[1])\n\ndef format_output(sorted_pairs_list: List[Tuple[str, int]]) -> str:\n    \"\"\"Extract words and join with spaces. (FR-006, FR-007, FR-009, BR-003)\"\"\"\n    words_only = [pair[0] for pair in sorted_pairs_list]\n    return ' '.join(words_only)\n\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    words = parse_input(numbers)\n    validate_words(words)\n    pairs = map_words_to_values(words)\n    sorted_pairs = sort_by_value(pairs)\n    return format_output(sorted_pairs)\n```"}
{"task_id": "HumanEval/24", "solution": "```python\ndef largest_divisor(n: int) -> int:\n    \"\"\"\n    For a given number n, finds the largest number that divides n evenly and is strictly smaller than n.\n    Optimizes search from n // 2 downwards, returning 1 for prime numbers.\n    \"\"\"\n    if n == 2:\n        return 1\n\n    candidate = n // 2\n    while candidate >= 1:\n        if n % candidate == 0:\n            return candidate\n        candidate -= 1\n    # This point is technically unreachable for n > 1 because 1 is always a divisor,\n    # and the loop will return when candidate becomes 1.\n    # However, it aligns with the design step: \"If loop completes without finding divisor, return 1 (n is prime, BR3)\".\n    return 1\n```"}
{"task_id": "HumanEval/25", "solution": "```python\nfrom typing import List\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\"Return list of prime factors of given integer.\n    Factors are ordered smallest to largest, with multiplicity.\n    \"\"\"\n    # Handle n=0: returns empty list as 0 has no prime factors and no exceptions are allowed.\n    if n == 0:\n        return []\n\n    # Handle negative inputs by taking absolute value (BR7 from design)\n    current_n = abs(n)\n\n    # Edge case: n=1 has no prime factors (BR5 from design)\n    if current_n == 1:\n        return []\n\n    # Proceed with trial division for positive integers greater than 1\n    return _trial_division(current_n)\n\n\ndef _trial_division(n: int) -> List[int]:\n    \"\"\"Performs trial division to find all prime factors of a positive integer > 1.\n    Factors are returned in ascending order with repetition.\n    \"\"\"\n    result = []\n    divisor = 2  # Start with smallest prime (BR8 from design)\n\n    # Trial division up to \u221an\n    while divisor * divisor <= n:\n        # Exhaustive division until no longer divisible (BR9 from design)\n        while n % divisor == 0:\n            result.append(divisor)\n            n //= divisor\n        divisor += 1\n\n    # If n > 1 after the loop, the remaining n itself is prime (BR10 from design)\n    if n > 1:\n        result.append(n)\n\n    return result\n```"}
{"task_id": "HumanEval/26", "solution": "```python\nfrom typing import List\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    occurrence_map = {}\n    for num in numbers:\n        occurrence_map[num] = occurrence_map.get(num, 0) + 1\n\n    output = []\n    for num in numbers:\n        if occurrence_map[num] == 1:\n            output.append(num)\n    return output\n```"}
{"task_id": "HumanEval/25", "solution": "```python\nfrom typing import List\n\n\ndef _extract_factor_two(n: int, factors: List[int]) -> int:\n    \"\"\"Extracts all factors of 2 from n, appending them to factors.\n    Returns the remaining quotient after removing all 2s.\"\"\"\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n    return n\n\n\ndef _extract_odd_factors(n: int, factors: List[int]) -> None:\n    \"\"\"Extracts odd prime factors from n using trial division, appending them to factors.\n    Modifies factors in-place, assuming n is odd or has had factors of 2 removed.\"\"\"\n    divisor = 3\n    while divisor * divisor <= n:\n        while n % divisor == 0:\n            factors.append(divisor)\n            n //= divisor\n        divisor += 2\n    if n > 1:\n        factors.append(n)\n\n\ndef _decompose(n: int) -> List[int]:\n    \"\"\"Core trial division algorithm for a positive integer greater than 1.\n    Returns a sorted list of prime factors.\"\"\"\n    factors: List[int] = []\n    n = _extract_factor_two(n, factors)\n    _extract_odd_factors(n, factors)\n    return factors\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\"Return list of prime factors of given integer in the order from smallest to largest.\n    Each factor is listed as many times as it appears in the factorization.\"\"\"\n    n_abs = abs(n)\n\n    if n_abs == 1:\n        return []\n\n    return _decompose(n_abs)\n```"}
