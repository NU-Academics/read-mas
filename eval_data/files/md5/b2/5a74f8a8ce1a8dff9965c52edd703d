{"task_id": "HumanEval/81", "solution": "```python\ndef numerical_letter_grade(grades):\n    \"\"\"Converts a list of GPA values to letter grades using a fixed 14-level grading scale.\n    Processes each GPA independently and returns grades in the same order.\n    \"\"\"\n\n    class _GradingScale:\n        \"\"\"Encapsulates the core grading business logic for single GPA-to-grade conversion.\"\"\"\n        def get_letter_grade(self, gpa: float) -> str:\n            \"\"\"Evaluates a single GPA against threshold boundaries and returns its letter grade.\"\"\"\n            if gpa == 4.0:\n                return 'A+'\n            elif gpa > 3.7:\n                return 'A'\n            elif gpa > 3.3:\n                return 'A-'\n            elif gpa > 3.0:\n                return 'B+'\n            elif gpa > 2.7:\n                return 'B'\n            elif gpa > 2.3:\n                return 'B-'\n            elif gpa > 2.0:\n                return 'C+'\n            elif gpa > 1.7:\n                return 'C'\n            elif gpa > 1.3:\n                return 'C-'\n            elif gpa > 1.0:\n                return 'D+'\n            elif gpa > 0.7:\n                return 'D'\n            elif gpa > 0.0:\n                return 'D-'\n            else: # gpa == 0.0\n                return 'E'\n\n    # The numerical_letter_grade function acts as the GPAConverter (Application Layer)\n    grading_scale_service = _GradingScale()\n    result_grades = []\n    for gpa_value in grades:\n        letter_grade = grading_scale_service.get_letter_grade(gpa_value)\n        result_grades.append(letter_grade)\n\n    return result_grades\n```"}
{"task_id": "HumanEval/82", "solution": "```python\ndef _is_prime(n):\n    \"\"\"Checks if an integer n is prime using O(\u221an) trial division.\n    Returns True if n is prime, False otherwise.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:  # Even numbers greater than 2 are not prime\n        return False\n\n    divisor = 3\n    while divisor * divisor <= n:\n        if n % divisor == 0:\n            return False\n        divisor += 2\n\n    return True\n\ndef prime_length(string):\n    \"\"\"Determines if the length of the input string is a prime number.\n    Returns True if the string length is prime, False otherwise.\n    \"\"\"\n    length = len(string)\n    return _is_prime(length)\n```"}
{"task_id": "HumanEval/81", "solution": "```python\ndef numerical_letter_grade(grades):\n    \"\"\"Converts a list of GPA values to a list of letter grades.\n    Handles special cases for 4.0 and 0.0, and maps other GPAs based on thresholds.\n    \"\"\"\n\n    def _map_gpa_to_letter(gpa: float) -> str:\n        \"\"\"Maps a single GPA to its corresponding letter grade based on defined rules.\"\"\"\n\n        # Handle exact special cases for A+ and E.\n        if gpa == 4.0:\n            return 'A+'\n        if gpa == 0.0:\n            return 'E'\n\n        # Grade scale (threshold, letter_grade) in descending order of threshold.\n        GRADE_SCALE = [\n            (3.7, 'A'), (3.3, 'A-'), (3.0, 'B+'), (2.7, 'B'),\n            (2.3, 'B-'), (2.0, 'C+'), (1.7, 'C'), (1.3, 'C-'),\n            (1.0, 'D+'), (0.7, 'D'), (0.0, 'D-')\n        ]\n\n        # Iterate boundaries descending, return first where gpa > threshold.\n        for threshold, letter_grade in GRADE_SCALE:\n            if gpa > threshold:\n                return letter_grade\n\n    # Return empty list for empty input.\n    if not grades:\n        return []\n\n    # Map each GPA in the input list to its corresponding letter grade.\n    converted_grades = [_map_gpa_to_letter(gpa) for gpa in grades]\n\n    return converted_grades\n```"}
{"task_id": "HumanEval/82", "solution": "```python\ndef _check_divisibility(n: int) -> bool:\n    \"\"\"\n    Helper function to check divisibility for odd integers > 2.\n    Returns True if n is prime (not divisible), False if composite.\n    \"\"\"\n    limit = int(n ** 0.5) + 1\n    for divisor in range(3, limit, 2):\n        if n % divisor == 0:\n            return False\n    return True\n\n\ndef _is_prime(n: int) -> bool:\n    \"\"\"\n    Helper function to determine if an integer is prime.\n    Returns True if n is prime, False otherwise.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    return _check_divisibility(n)\n\n\ndef prime_length(string: str) -> bool:\n    \"\"\"\n    Determines if the length of the input string is a prime number.\n    Returns True if string length is prime, False otherwise.\n    \"\"\"\n    length = len(string)\n    return _is_prime(length)\n```"}
{"task_id": "HumanEval/83", "solution": "```python\ndef starts_one_ends(n: int) -> int:\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n\n    Args:\n        n: Positive integer representing number of digits\n\n    Returns:\n        Integer count of n-digit numbers starting or ending with 1\n\n    Algorithm:\n        - For n=1: only the number 1 qualifies, return 1\n        - For n\u22652: apply inclusion-exclusion principle\n          - Numbers starting with 1: 10^(n-1)\n          - Numbers ending with 1: 9 * 10^(n-2)\n          - Numbers both starting and ending with 1: 10^(n-2)\n          - Total = starts + ends - both\n\n    Examples:\n        >>> starts_one_ends(1)\n        1\n        >>> starts_one_ends(2)\n        18\n        >>> starts_one_ends(3)\n        180\n    \"\"\"\n    if n == 1:\n        return 1\n\n    # Calculate counts using mathematical formulas for n >= 2.\n    starts_with_1 = 10 ** (n - 1)\n    ends_with_1 = 9 * (10 ** (n - 2))\n    both = 10 ** (n - 2)\n\n    # Apply the inclusion-exclusion principle.\n    total = starts_with_1 + ends_with_1 - both\n    return total\n```"}
{"task_id": "HumanEval/77", "solution": "I apologize for the confusion. Let me provide you with the code solution directly based on the design document I received:\n\n```python\ndef iscube(a):\n    '''\n    Write a function that takes an integer a and returns True\n    if this ingeger is a cube of some integer number.\n    Note: you may assume the input is always valid.\n    Examples:\n    iscube(1) ==> True\n    iscube(2) ==> False\n    iscube(-1) ==> True\n    iscube(64) ==> True\n    iscube(0) ==> True\n    iscube(180) ==> False\n    '''\n    if a == 0:\n        return True\n\n    if a > 0:\n        cube_root = round(a ** (1/3))\n        return cube_root ** 3 == a\n\n    abs_cube_root = round(abs(a) ** (1/3))\n    cube_root = -abs_cube_root\n    return cube_root ** 3 == a\n```"}
{"task_id": "HumanEval/83", "solution": "```python\ndef starts_one_ends(n: int) -> int:\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n\n    # Service Layer: Count Calculation Helpers, implementing FR-003, FR-004, FR-005, FR-008\n    def _calculate_starts_with_one_digit_count(num_digits: int) -> int:\n        \"\"\"Calculates count of n-digit numbers starting with 1.\"\"\"\n        return 10**(num_digits - 1)\n\n    def _calculate_ends_with_one_digit_count(num_digits: int) -> int:\n        \"\"\"Calculates count of n-digit numbers ending with 1, based on FR-004.\"\"\"\n        if num_digits == 1:\n            return 1\n        return 9 * (10**(num_digits - 1))\n\n    def _calculate_starts_and_ends_with_one_digit_count(num_digits: int) -> int:\n        \"\"\"Calculates count of n-digit numbers both starting and ending with 1.\"\"\"\n        if num_digits == 1:\n            return 1\n        return 10**(num_digits - 2)\n\n    # Business Logic Layer: Orchestration and application of Inclusion-Exclusion (FR-006)\n    count_starts = _calculate_starts_with_one_digit_count(n)\n    count_ends = _calculate_ends_with_one_digit_count(n)\n    count_both = _calculate_starts_and_ends_with_one_digit_count(n)\n\n    total_count = count_starts + count_ends - count_both\n\n    # Data Layer: The computed result is returned as an integer (FR-007)\n    return total_count\n```"}
