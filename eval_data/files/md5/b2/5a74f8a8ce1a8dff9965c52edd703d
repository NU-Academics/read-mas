{"task_id": "HumanEval/32", "solution": "```python\nfrom typing import List\n\nclass Result:\n    \"\"\"Immutable value object containing solution result.\n    It stores the computed root, iteration count, and convergence status.\"\"\"\n\n    def __init__(self, zero_point: float, iterations: int, converged: bool) -> None:\n        \"\"\"Construct result object.\"\"\"\n        self._zero_point = zero_point\n        self._iterations = iterations\n        self._converged = converged\n\n    def get_zero_point(self) -> float:\n        \"\"\"Return computed zero point.\"\"\"\n        return self._zero_point\n\n    def get_iterations(self) -> int:\n        \"\"\"Return iteration count.\"\"\"\n        return self._iterations\n\n    def is_converged(self) -> bool:\n        \"\"\"Return convergence status.\"\"\"\n        return self._converged\n\nclass Polynomial:\n    \"\"\"Represents a polynomial with coefficients in standard form.\n    It provides methods for evaluation and derivative computation.\"\"\"\n\n    def __init__(self, coefficients: List[float]) -> None:\n        \"\"\"Initialize polynomial with coefficient list.\"\"\"\n        self._coefficients = coefficients.copy()\n        self._degree = len(coefficients) - 1\n\n    def evaluate(self, x: float) -> float:\n        \"\"\"Evaluate polynomial at point x using Horner's method.\"\"\"\n        result = 0.0\n        for i in range(self._degree, -1, -1):\n            result = result * x + self._coefficients[i]\n        return result\n\n    def derivative(self) -> 'Polynomial':\n        \"\"\"Compute derivative polynomial.\"\"\"\n        if self._degree == 0:\n            return Polynomial([0.0])\n\n        deriv_coeffs = []\n        for i in range(1, len(self._coefficients)):\n            deriv_coeffs.append(i * self._coefficients[i])\n\n        return Polynomial(deriv_coeffs)\n\n    def get_degree(self) -> int:\n        \"\"\"Return polynomial degree.\"\"\"\n        return self._degree\n\n    def get_coefficients(sel