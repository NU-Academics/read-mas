[i] serves as the peak, counted in both LIS ending at i and LDS starting at i.\n        current_bitonic_sum = lis_sums[i] + lds_sums[i] - arr[i]\n        if current_bitonic_sum > max_bitonic_sum:\n            max_bitonic_sum = current_bitonic_sum\n        \n    return max_bitonic_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/256": [{"task_id": "Mbpp/256", "solution": "def count_Primes_nums(n: int) -> int:\n    \"\"\"\n    Counts the number of prime numbers strictly less than n.\n    \"\"\"\n\n    def _sieve_of_eratosthenes(limit: int) -> list[bool]:\n        \"\"\"\n        Generates a boolean list where is_prime[i] is True if i is prime, up to limit (exclusive).\n        \"\"\"\n        if limit <= 2:\n            return [False] * limit\n\n        is_prime = [True] * limit\n        is_prime[0] = is_prime[1] = False # 0 and 1 are not prime\n\n        for p in range(2, int(limit**0.5) + 1):\n            if is_prime[p]:\n                for multiple in range(p*p, limit, p):\n                    is_prime[multiple] = False\n        return is_prime\n\n    class PrimeCounterService:\n        \"\"\"\n        Service for counting prime numbers.\n        \"\"\"\n        def count_primes(self, n: int) -> int:\n            \"\"\"\n            Counts the number of prime numbers strictly less than n.\n            \"\"\"\n            if n <= 2: # No primes less than or equal to 2\n                return 0\n\n            # Use Sieve of Eratosthenes to find primes up to n\n            is_prime_list = _sieve_of_eratosthenes(n)\n\n            # Count the number of True values (primes)\n            # We start counting from 2, as 0 and 1 are not prime\n            prime_count = sum(1 for i in range(2, n) if is_prime_list[i])\n            return prime_count\n\n    service = PrimeCounterService()\n    return service.count_primes(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/247": [{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Calculates the length of the longest palindromic subsequence of the given string.\n    Uses dynamic programming with O(N^2) time and space complexity.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of LPS in substring s[i..j]\n    dp = [[0 for _ in range(n)] for _ in range(n)]\n\n    # Every single character is a palindrome of length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the dp table\n    # l is length of substring\n    for l in range(2, n + 1):\n        for i in range(n - l + 1):\n            j = i + l - 1\n            if s[i] == s[j] and l == 2:\n                dp[i][j] = 2\n            elif s[i] == s[j]:\n                dp[i][j] = 2 + dp[i + 1][j - 1]\n            else:\n                dp[i][j] = max(dp[i][j - 1], dp[i + 1][j])\n\n    return dp[0][n - 1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/239": [{"task_id": "Mbpp/239", "solution": "from typing import Dict, Tuple\nclass SequenceCalculator:\n    \"\"\"Calculates the number of sequences using dynamic programming with memoization.\"\"\"\n    def __init__(self):\n        self.memo: Dict[Tuple[int, int], int] = {}\n\n    def calculate_sequences(self, m: int, n: int) -> int:\n        \"\"\"Initializes the calculation by considering all possible starting elements.\"\"\"\n        self.memo = {} # Reset memoization for each new calculation\n        total_count = 0\n        # The first element can be any value from 1 to m.\n        for start_val in range(1, m + 1):\n            total_count += self._dp_solve(start_val, m, n - 1) # n-1 because the first element is already chosen\n        return total_count\n\n    def _dp_solve(self, prev_val: int, max_m: int, remaining_n: int) -> int:\n        \"\"\"Recursively calculates the number of sequences for a subproblem using memoization.\"\"\"\n        if remaining_n == 0:\n            return 1 # A valid sequence of the desired length has been formed\n\n        # Memoization key: (remaining length, previous value)\n        if (remaining_n, prev_val) in self.memo:\n            return self.memo[(remaining_n, prev_val)]\n\n        count = 0\n        min_next_val = prev_val * 2\n        for next_val in range(min_next_val, max_m + 1):\n            count += self._dp_solve(next_val, max_m, remaining_n - 1)\n\n        self.memo[(remaining_n, prev_val)] = count\n        return count\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Finds the number of possible sequences of length n, such that each element is a positive\n    integer, is greater than or equal to twice the previous element, and less than or equal to m.\n    \"\"\"\n    if not isinstance(m, int) or not isinstance(n, int) or m <= 0 or n <= 0:\n        raise ValueError(\"Inputs m and n must be positive integers.\")\n\n    if n == 1:\n        return m # Any number from 1 to m can be a sequence of length 1\n\n    calculator = SequenceCalculator()\n    return calculator.calculate_sequences(m, n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/162": [{"task_id": "Mbpp/162", "solution": "def sum_series(n):\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) from i=0 to n // 2.\n    For example, sum_series(6) = 6 + 4 + 2 + 0 = 12.\n    \"\"\"\n    total_sum = 0\n    # Iterate from i=0 up to n // 2 (inclusive)\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        total_sum += term\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/67": [{"task_id": "Mbpp/67", "solution": "from typing import Dict, Any\nclass MemoizationCache:\n    \"\"\"A simple in-memory cache for memoization.\"\"\"\n    def __init__(self):\n        self._cache: Dict[Any, Any] = {}\n\n    def get(self, key: Any) -> Any | None:\n  