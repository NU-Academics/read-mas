Checks if the number is strictly greater than 10.\"\"\"\n        return self._value > 10\n\n    def is_first_digit_odd(self) -> bool:\n        \"\"\"Checks if the first digit of the absolute value is odd.\"\"\"\n        first_digit = self.get_first_digit()\n        return first_digit in {1, 3, 5, 7, 9}\n\n    def is_last_digit_odd(self) -> bool:\n        \"\"\"Checks if the last digit of the absolute value is odd.\"\"\"\n        last_digit = self.get_last_digit()\n        return last_digit in {1, 3, 5, 7, 9}\n\n    def is_special(self) -> bool:\n        \"\"\"Combines all three conditions to determine if the number is 'special'.\"\"\"\n        return (\n            self.is_greater_than_ten() and\n            self.is_first_digit_odd() and\n            self.is_last_digit_odd()\n        )\nclass ArrayOfNumbers:\n    \"\"\"Manages a collection of Number objects and orchestrates the filtering and counting process.\"\"\"\n    def __init__(self, raw_numbers: List[Union[int, float]]):\n        \"\"\"Initializes the collection by converting raw numbers into Number objects.\"\"\"\n        self._numbers: List[Number] = [Number(num) for num in raw_numbers]\n\n    def get_special_filter_count(self) -> int:\n        \"\"\"Iterates through the Number objects, applies the is_special check, and returns the total count.\"\"\"\n        count = 0\n        for number_obj in self._numbers:\n            if number_obj.is_special():\n                count += 1\n        return count\ndef specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns \n    the number of elements in the array that are greater than 10 and both \n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    \"\"\"\n    array_of_numbers = ArrayOfNumbers(nums)\n    return array_of_numbers.get_special_filter_count()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "_PLANETS_ORDERED_LIST = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n_PLANETS_MAP = {planet: i for i, planet in enumerate(_PLANETS_ORDERED_LIST)}\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    \n    if planet1 not in _PLANETS_MAP or planet2 not in _PLANETS_MAP:\n        return ()\n\n    index1 = _PLANETS_MAP[planet1]\n    index2 = _PLANETS_MAP[planet2]\n\n    start_index = min(index1, index2)\n    end_index = max(index1, index2)\n\n    # Planets are located strictly between the two planets,\n    # so we slice from start_index + 1 up to (but not including) end_index.\n    return tuple(_PLANETS_ORDERED_LIST[start_index + 1 : end_index])", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/144": [{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Represents a mathematical fraction and provides arithmetic operations.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self._numerator = numerator\n        self._denominator = denominator\n\n    @classmethod\n    def from_string(cls, fraction_string: str) -> 'Fraction':\n        \"\"\"Parses a string like \"num/den\" int