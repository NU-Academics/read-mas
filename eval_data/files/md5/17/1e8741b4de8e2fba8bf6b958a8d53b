    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    _ROMAN_MAP = [\n        (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n        (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n        (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'), (1, 'i')\n    ]\n\n    def _validate_input(num):\n        \"\"\"Validates if the input number is within the range [1, 1000].\"\"\"\n        if not (1 <= num <= 1000):\n            raise ValueError(\"Input number must be between 1 and 1000, inclusive.\")\n\n    _validate_input(number)\n\n    result = []\n    for value, symbol in _ROMAN_MAP:\n        while number >= value:\n            result.append(symbol)\n            number -= value\n    return \"\".join(result)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    \n    # Handle negative input by taking the absolute value.\n    abs_num = abs(num)\n\n    # Special case for 0, as iterating '0' will count 0 as even.\n    if abs_num == 0:\n        return (1, 0)\n        \n    # Iterate through the digits of the number.\n    while abs_num > 0:\n        digit = abs_num % 10\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n        abs_num //= 10\n        \n    return (even_count, odd_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/152": [{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Calculates the absolute differences between corresponding elements of two input arrays.\n    Returns an array of these differences, with 0 for correct guesses.\"\"\"\n    result = []\n    for i in range(len(game)):\n        game_score = game[i]\n        guess_score = guess[i]\n\n        if game_score == guess_score:\n            result.append(0)\n        else:\n            result.append(abs(game_score - guess_score))\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n\n    # Helper function to generate all cyclic rotations of a string.\n    # It returns a list of all possible rotations.\n    def _generate_rotations(s: str) -> list[str]:\n        if not s:\n            return [\"\"]\n        rotations = []\n        n = len(s)\n        for i in range(n):\n            rotated_s = s[i:] + s[:i]\n            rotations.append(rotated_s)\n        return rotations\n\n    # Helper function to check if a substring exists within a main string.\n    # It leverages Python's 'in' operator for efficient checking.\n    def _is_substring(main_string: str, sub_string: str) -> bool:\n        return sub_string in main_string\n\n    # If 'b' is an empty string, it is considered a substring of any string 'a'.\n    if not b:\n        return True\n    \n    # If 'b' is longer than 'a', no rotation of 'b' can be a substring of 'a'.\n    if len(b) > len(a):\n        return False\n\n    # Generate all cyclic rotations of string 'b'.\n    b_rotations = _generate_rotations(b)\n\n    # Iterate through each rotation and check if it exists as a substring in 'a'.\n    for rotation in b_rotations:\n        if _is_substring(a, rotation):\n            return True\n            \n    # If no rotation is found as a substring, return False.\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Side lengths must be positive.\n    if not (a > 0 and b > 0 and c > 0):\n        return False\n\n    # Check triangle inequality: the sum of the lengths of any two sides must be greater than the length of the third side.\n    if not (a + b > c and a + c > b and b + c > a):\n        return False\n\n    # Sort the sides to easily identify the potential hypotenuse.\n    # Let x, y be the shorter sides and z be the longest side.\n    sides = sorted([a, b, c])\n    x, y, z = sides[0], sides[1], sides[2]\n\n    # Use a small epsilon for floating-point comparison to account for precision issues.\n    epsilon = 1e-9\n\n    # Check the Pythagorean theorem: x^2 + y^2 = z^2 (where z is the hypotenuse).\n    return abs(x*x + y*y - z*z) < epsilon", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n\n    find_max([\"name\", \"of\", \"string\"]) == \"string\"\n    find_max([\"name\", \"enam\", \"game\"]) == \"enam\"\n    find_max([\"aaaaaaa\", \"bb\" ,\"cc\"]) == \"\"aaaaaaa\"\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            if word < result_word:\n                result_word = word\n\n    return result_word", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \"\"\"\n    total_eaten_carrots = 0\n    carrots_left = 0\n\n    if need <= remaining:\n        # Enough carrots are available\n        total_eaten_carrots = number + need\n        carrots_left = remaining - need\n    else:\n        # Not enough carrots, eat all remaining\n        total_eaten_carrots = number + remaining\n        carrots_left = 0\n\n    return [total_eaten_carrots, carrots_left]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/162": [{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/94": [{"task_id": "HumanEval/94", "solution": "def is_prime(n):\n    \"\"\"Checks if a number is prime.\"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef sum_digits(n):\n    \"\"\"Calculates the sum of the digits of a number.\"\"\"\n    total = 0\n    while n > 0:\n        total += n % 10\n        n //= 10\n    return total\ndef find_largest_prime(numbers):\n    \"\"\"Finds the largest prime number in a list. Returns None if no primes are found.\"\"\"\n    largest_prime = None\n    for num in numbers:\n        if is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n    return largest_prime\ndef skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    largest_prime_found = find_largest_prime(lst)\n\n    if largest_prime_found is not None:\n        return sum_digits(largest_prime_found)\n    else:\n        return 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n\n    def _contains_letters(input_str):\n        \"\"\"Checks if the string contains any alphabetic characters.\"\"\"\n        for char in input_str:\n            if char.isalpha():\n                return True\n        return False\n\n    def _process_char(char):\n        \"\"\"Processes a single character by reversing its case if it's a letter.\"\"\"\n        if char.islower():\n            return char.upper()\n        elif char.isupper():\n            return char.lower()\n        else:\n            return char\n\n    def _reverse_string(input_str):\n        \"\"\"Reverses the input string.\"\"\"\n        return input_str[::-1]\n\n    if not _contains_letters(s):\n        return _reverse_string(s)\n    else:\n        processed_chars = []\n        for char in s:\n            processed_chars.append(_process_char(char))\n        return \"\".join(processed_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n    \n    # Helper function to validate inputs (following design context)\n    def _validate_inputs(operator_list, operand_list):\n        \"\"\"Validates the input operator and operand lists.\"\"\"\n        supported_operators = {'+', '-', '*', '//', '**'}\n        \n        if not operator_list or not operand_list:\n            raise ValueError(\"Operator and operand lists cannot be empty.\")\n        \n        if len(operator_list) != len(operand_list) - 1:\n            raise ValueError(\"Length of operator list must be one less than operand list.\")\n            \n        if len(operand_list) < 2:\n            raise ValueError(\"Operand list must have at least two operands.\")\n\n        for op in operator_list:\n            if not isinstance(op, str) or op not in supported_operators:\n                raise ValueError(f\"Invalid operator found: {op}. Supported operators are +, -, *, //, **.\")\n        \n        for num in operand_list:\n            if not isinstance(num, int) or num < 0:\n                raise ValueError(f\"Invalid operand found: {num}. Operands must be non-negative integers.\")\n\n    # Helper function to construct the expression string\n    def _construct_expression_string(operator_list, operand_list):\n        \"\"\"Constructs the algebraic expression string by interleaving operands and operators.\"\"\"\n        expression_parts = []\n        for i in range(len(operator_list)):\n            expression_parts.append(str(operand_list[i]))\n            expression_parts.append(operator_list[i])\n        expression_parts.append(str(operand_list[-1]))\n        return \" \".join(expression_parts)\n\n    # Helper function to evaluate the expression string\n    def _evaluate_expression_string(expression_string):\n        \"\"\"Evaluates the algebraic expression string using Python's eval().\"\"\"\n        try:\n            # eval() handles standard mathematical operator precedence\n            return int(eval(expression_string))\n        except (SyntaxError, TypeError, ZeroDivisionError) as e:\n            raise ValueError(f\"Error evaluating expression '{expression_string}': {e}\")\n            \n    _validate_inputs(operator, operand)\n    expression_str = _construct_expression_string(operator, operand)\n    result = _evaluate_expression_string(expression_str)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/163": [{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    even_digits = []\n    for digit in [0, 2, 4, 6, 8]:\n        if min_val <= digit <= max_val:\n            even_digits.append(digit)\n\n    return even_digits", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/15": [{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    return ' '.join(str(i) for i in range(n + 1))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n\n    class Cell:\n        \"\"\"Represents a single cell in the grid with its coordinates and value.\"\"\"\n        def __init__(self, row: int, col: int, value: int):\n            self._row = row\n            self._col = col\n            self._value = value\n\n        def get_value(self) -> int:\n            return self._value\n\n        def get_coordinates(self) -> tuple[int, int]:\n            return (self._row, self._col)\n\n        def __eq__(self, other: object) -> bool:\n            # Assumes `other` is always a Cell object or compatible when comparison is needed.\n            return self._row == other._row and self._col == other._col and self._value == other._value\n\n        def __hash__(self) -> int:\n            return hash((self._row, self._col, self._value))\n\n\n    class Grid:\n        \"\"\"Encapsulates the 2D grid data and provides access to cell information.\"\"\"\n        def __init__(self, raw_grid: list[list[int]]):\n            self._N = len(raw_grid)\n            self._cells = [[None for _ in range(self._N)] for _ in range(self._N)]\n            for r in range(self._N):\n                for c in range(self._N):\n                    self._cells[r][c] = Cell(r, c, raw_grid[r][c])\n\n        def get_N(self) -> int:\n            return self._N\n\n        def get_cell(self, row: int, col: int) -> Cell:\n            return self._cells[row][col]\n\n        def get_neighbors(self, row: int, col: int) -> list[Cell]:\n            neighbors = []\n            dr = [-1, 1, 0, 0]\n            dc = [0, 0, -1, 1]\n            for i in range(4):\n                nr, nc = row + dr[i], col + dc[i]\n                if 0 <= nr < self._N and 0 <= nc < self._N:\n                    neighbors.append(self._cells[nr][nc])\n            return neighbors\n\n\n    class Path:\n        \"\"\"Represents an ordered sequence of cells forming a path and provides lexicographical comparison.\"\"\"\n        def __init__(self, values: list[int] = None, initial_cell: Cell = None):\n            self._visited_cells: list[Cell] = []\n            self._values: list[int] = []\n            if values is not None:\n                self._values = list(values)\n            elif initial_cell:\n                self.add_cell(initial_cell)\n\n        def add_cell(self, cell: Cell) -> None:\n            self._visited_cells.append(cell)\n            self._values.append(cell.get_value())\n\n        def get_values(self) -> list[int]:\n            return self._values\n\n        def get_length(self) -> int:\n            return len(self._values)\n\n        def is_lexicographically_less_than(self, other_path: 'Path') -> bool:\n            return self._values < other_path.get_values()\n\n        def __lt__(self, other: 'Path') -> bool:\n            # Assumes `other` is always a Path object or compatible.\n            return self.is_lexicographically_less_than(other)\n\n\n    class InputValidator:\n        \"\"\"Validates the input grid and path length k against specified constraints.\"\"\"\n        @staticmethod\n        def validate_grid(grid_data: list[list[int]]) -> None:\n            N = len(grid_data)\n            if N < 2:\n                raise ValueError(\"Grid dimension N must be at least 2.\")\n            for row in grid_data:\n                if len(row) != N:\n                    raise ValueError(\"Grid must be square (N x N).\")\n\n        @staticmethod\n        def validate_k(k_val: int) -> None:\n            if k_val <= 0:\n                raise ValueError(\"Path length k must be a positive integer.\")\n\n        @staticmethod\n        def validate_inputs(grid_data: list[list[int]], k_val: int) -> None:\n            InputValidator.validate_grid(grid_data)\n            InputValidator.validate_k(k_val)\n\n\n    class PathFinder:\n        \"\"\"Implements the core algorithm to explore all possible paths and identify the lexicographically smallest one.\"\"\"\n        def __init__(self, grid_obj: Grid, k_val: int):\n            self._grid = grid_obj\n            self._k = k_val\n            self._N = grid_obj.get_N()\n            self._max_possible_value = (self._N * self._N)\n            self._min_path_values = [self._max_possible_value + 1] * k_val\n\n        def find_minimum_path(self) -> list[int]:\n            for r in range(self._N):\n                for c in range(self._N):\n                    start_cell = self._grid.get_cell(r, c)\n                    self._dfs(start_cell, [start_cell.get_value()])\n            return self._min_path_values\n\n        def _dfs(self, current_cell: Cell, current_path_values: list[int]) -> None:\n            # Base case: if current path length equals k, compare and update minimum.\n            if len(current_path_values) == self._k:\n                if current_path_values < self._min_path_values:\n                    self._min_path_values = list(current_path_values)\n                return\n\n            # Pruning optimization: if current partial path is already lexicographically\n            # greater than the current minimum path (truncated to current length), stop exploring this branch.\n            if current_path_values > self._min_path_values[:len(current_path_values)]:\n                return\n\n            # Recursive step: explore neighbors\n            neighbors = self._grid.get_neighbors(current_cell.get_coordinates()[0], current_cell.get_coordinates()[1])\n            for neighbor in neighbors:\n                self._dfs(neighbor, current_path_values + [neighbor.get_value()])\n\n\n    # Main logic of minPath function\n    InputValidator.validate_inputs(grid, k)\n    grid_obj = Grid(grid)\n    path_finder = PathFinder(grid_obj, k)\n    return path_finder.find_minimum_path()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[10, 5, 20, 14, 16], [7, 11, 12, 17, 9], [13, 19, 1, 15, 8], [3, 18, 4, 6, 2], [22, 21, 23, 24, 25]], 25]]}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n + 1 numbers of the Tribonacci sequence.\n\n    The sequence is defined by specific recurrence relations for even and odd n,\n    with tri(0) = 1 and tri(1) = 3 as base cases.\n    \"\"\"\n    memo = {}\n\n    def _get_tribonacci_number(k, current_memo):\n        # Base cases\n        if k == 0:\n            return 1\n        if k == 1:\n            return 3\n\n        # Check memoization cache\n        if k in current_memo:\n            return current_memo[k]\n\n        # Calculate value based on recurrence rules\n        if k % 2 == 0:  # k is even\n            # tri(k) = 1 + k / 2\n            value = 1 + k / 2\n        else:  # k is odd\n            # tri(k) = tri(k - 1) + tri(k - 2) + tri(k + 1)\n            # Note: k+1 will be even, ensuring termination without infinite recursion.\n            value = (_get_tribonacci_number(k - 1, current_memo) +\n                     _get_tribonacci_number(k - 2, current_memo) +\n                     _get_tribonacci_number(k + 1, current_memo))\n\n        # Store the computed value in memo and return it\n        current_memo[k] = value\n        return value\n\n    # Generate the sequence for n+1 numbers\n    result_sequence = []\n    for i in range(n + 1):\n        result_sequence.append(_get_tribonacci_number(i, memo))\n\n    return result_sequence", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/83": [{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n\n    def _calculate_starts_one(k):\n        \"\"\"Calculates the count of k-digit numbers that start with 1.\"\"\"\n        return 10**(k - 1)\n\n    def _calculate_ends_one(k):\n        \"\"\"Calculates the count of k-digit numbers that end with 1.\"\"\"\n        if k == 1:\n            return 1\n        return 9 * (10**(k - 2))\n\n    def _calculate_both_one(k):\n        \"\"\"Calculates the count of k-digit numbers that both start and end with 1.\"\"\"\n        if k == 1:\n            return 1\n        return 10**(k - 2)\n\n    count_starts_one = _calculate_starts_one(n)\n    count_ends_one = _calculate_ends_one(n)\n    count_both_one = _calculate_both_one(n)\n\n    # Apply the principle of inclusion-exclusion\n    total_count = count_starts_one + count_ends_one - count_both_one\n    \n    return total_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n\n    def _factorial(k):\n        \"\"\"Calculates the factorial of a non-negative integer k.\"\"\"\n        if k == 0 or k == 1:\n            return 1\n        result = 1\n        for i in range(2, k + 1):\n            result *= i\n        return result\n\n    special_product = 1\n    for i in range(1, n + 1):\n        special_product *= _factorial(i)\n\n    return special_product", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}