[-1, 11, -11]) == 1\n    >>> count_nums([1, 1, 2]) == 3\n    \"\"\"\n\n    def _calculate_signed_digit_sum(number: int) -> int:\n        \"\"\"Calculates the sum of digits for a number, treating the first digit of a negative number as negative.\"\"\"\n        if number == 0:\n            return 0\n\n        s_num = str(number)\n        digit_sum = 0\n\n        if s_num[0] == '-':\n            # The first digit (after the sign) is negative\n            digit_sum -= int(s_num[1])\n            # Add subsequent digits as positive\n            for i in range(2, len(s_num)):\n                digit_sum += int(s_num[i])\n        else:\n            # All digits are positive\n            for char_digit in s_num:\n                digit_sum += int(char_digit)\n        return digit_sum\n\n    count = 0\n    for num in arr:\n        if _calculate_signed_digit_sum(num) > 0:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/111": [{"task_id": "HumanEval/111", "solution": "from collections import Counter\ndef _parse_input_string(input_str: str) -> list[str]:\n    \"\"\"Parses the input string to extract individual lowercase letters separated by spaces.\"\"\"\n    if not input_str:\n        return []\n    return [char for char in input_str.split(' ') if char]\ndef _count_occurrences(letters: list[str]) -> dict[str, int]:\n    \"\"\"Counts the occurrences of each unique lowercase letter.\"\"\"\n    return dict(Counter(letters))\ndef _identify_max_occurrence(counts: dict[str, int]) -> int:\n    \"\"\"Identifies the maximum occurrence count among all unique letters.\"\"\"\n    if not counts:\n        return 0\n    return max(counts.values())\ndef _filter_most_frequent(counts: dict[str, int], max_count: int) -> dict[str, int]:\n    \"\"\"Includes only the letters that have the maximum occurrence count.\"\"\"\n    if max_count == 0:\n        return {}\n    return {letter: count for letter, count in counts.items() if count == max_count}\ndef histogram(test: str) -> dict[str, int]:\n    \"\"\"Given a string representing a space separated lowercase letters, return a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\n    \n    Example:\n    histogram('a b c') == {'a': 1, 'b': 1, 'c': 1}\n    histogram('a b b a') == {'a': 2, 'b': 2}\n    histogram('a b c a b') == {'a': 2, 'b': 2}\n    histogram('b b b b a') == {'b': 4}\n    histogram('') == {}\n\n    \"\"\"\n    if not test:\n        return {}\n\n    individual_letters = _parse_input_string(test)\n    if not individual_letters:\n        return {}\n\n    letter_counts = _count_occurrences(individual_letters)\n    max_count = _identify_max_occurrence(letter_counts)\n    final_histogram = _filter_most_frequent(letter_counts, max_count)\n\n    return final_histogram", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/107": [{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n\n    def is_palindrome(num: int) -> bool:\n        \"\"\"Checks if an integer is a palindrome.\"\"\"\n        if num < 0:\n            return False\n        return str(num) == str(num)[::-1]\n\n    def is_even(num: int) -> bool:\n        \"\"\"Checks if an integer is even.\"\"\"\n        return num % 2 == 0\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        if is_palindrome(i):\n            if is_even(i):\n                even_count += 1\n            else:\n                odd_count += 1\n    return (even_count, odd_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/113": [{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n    \"\"\"\n    def _count_odd_digits(s):\n        \"\"\"Counts the number of odd digits (1, 3, 5, 7, 9) in a given string.\"\"\"\n        count = 0\n        for digit_char in s:\n            digit = int(digit_char)\n            if digit % 2 != 0:\n                count += 1\n        return count\n\n    def _format_output_string(odd_count_val):\n        \"\"\"Constructs the output string by replacing all 'i's in the template with the provided odd digit count.\"\"\"\n        template = \"the number of odd elements in the string i of the input.\"\n        return template.replace('i', str(odd_count_val))\n\n    results = []\n    for s in lst:\n        count = _count_odd_digits(s)\n        formatted_string = _format_output_string(count)\n        results.append(formatted_string)\n    return results", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/114": [{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Finds the minimum sum of any non-empty sub-array using a variant of Kadane's algorithm.\n    It tracks the current minimum sum ending at the current position and the overall minimum sum.\n    \"\"\"\n    min_so_far = float('inf')\n    current_min = 0\n\n    for num in nums:\n        current_min += num\n        min_so_far = min(min_so_far, current_min)\n        if current_min > 0:\n            current_min = 0\n            \n    return min_so_far", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/115": [{"task_id": "HumanEval/115", "solution": "import math\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the minimum number of times buckets need to be lowered to empty all wells.\n    It sums all water units in the grid and divides by the bucket capacity, rounding up.\n    \"\"\"\n    total_water_units = 0\n    for row in grid:\n        total_water_units += sum(row)\n\n    if total_water_units == 0:\n        return 0\n\n    return math.ceil(total_water_units / capacity)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[1, 1, 1, 1], [1, 1, 1, 1]], 9]], "plus_fail_tests": [[[[1, 0, 0, 1], [0, 1, 1, 1], [0, 0, 0, 0], [1, 0, 1, 1]], 2]]}], "HumanEval/118": [{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel from the right side of the word that is between two consonants, \n    excluding word-boundary vowels.\n    \"\"\"\n    \n    def _is_vowel(char):\n        return char in \"aeiouAEIOU\"\n\n    def _is_consonant(char):\n        return char.isalpha() and not _is_vowel(char)\n\n    # Iterate from the second to last character down to the second character\n    # This ensures we don't check characters at the beginning or end of the word\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        \n        if _is_vowel(current_char):\n            left_neighbor = word[i - 1]\n            right_neighbor = word[i + 1]\n            \n            if _is_consonant(left_neighbor) and _is_consonant(right_neighbor):\n                return current_char\n                \n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/117": [{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, returns a list of words from s\n    that contain exactly n consonants, in order these words appear in the string s.\n    \"\"\"\n    def _is_consonant(char):\n        \"\"\"Checks if a character is a consonant, case-insensitively.\"\"\"\n        char_lower = char.lower()\n        return char_lower.isalpha() and char_lower not in \"aeiou\"\n\n    def _count_consonants_in_word(word):\n        \"\"\"Counts the number of consonants in a given word.\"\"\"\n        count = 0\n        for char in word:\n            if _is_consonant(char):\n                count += 1\n        return count\n\n    if not s:\n        return []\n\n    result = []\n    words = s.split()\n    for word in words:\n        if _count_consonants_in_word(word) == n:\n            result.append(word)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/116": [{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n    \"\"\"\n\n    class SortableInteger:\n        \"\"\"\n        Wraps an integer to provide methods for calculating its binary representation\n        and '1' bit count, and enables comparison based on sorting rules.\n        \"\"\"\n        def __init__(self, value: int):\n            self._value = value\n            # Calculate and cache the count of '1' bits in the binary representation.\n            self._one_bit_count = bin(value).count('1')\n\n        def get_value(self) -> int:\n            \"\"\"Returns the original integer value.\"\"\"\n            return self._value\n\n        def get_binary_representation(self) -> str:\n            \"\"\"Returns the binary string representation (e.g., '0b101').\"\"\"\n            return bin(self._value)\n\n        def get_one_bit_count(self) -> int:\n            \"\"\"Returns the cached count of '1' bits.\"\"\"\n            return self._one_bit_count\n\n        def __lt__(self, other) -> bool:\n            \"\"\"Defines less-than comparison for sorting (primary by bit count, secondary by decimal value).\"\"\"\n            if self._one_bit_count != other._one_bit_count:\n                return self._one_bit_count < other._one_bit_count\n            return self._value < other._value\n\n        def __eq__(self, other) -> bool:\n            \"\"\"Defines equality comparison.\"\"\"\n            return self._value == other._value\n\n    # Transform the input array into a list of SortableInteger objects.\n    sortable_items = [SortableInteger(num) for num in arr]\n\n    # Sort the list using Python's default sort, which utilizes the __lt__ method.\n    sortable_items.sort()\n\n    # Extract the original integer values from the sorted SortableInteger objects.\n    sorted_arr = [item.get_value() for item in sortable_items]\n\n    return sorted_arr", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/36": [{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n\n    # Helper function to check if a number is divisible by 11 or 13.\n    def _is_divisible_by_11_or_13(number: int) -> bool:\n        return (number % 11 == 0) or (number % 13 == 0)\n\n    # Helper function to count the occurrences of the digit '7' in a number.\n    def _count_digit_7(number: int) -> int:\n        return str(number).count('7')\n\n    total_count = 0\n    # Iterate through numbers from 1 up to n-1 (exclusive of n).\n    for i in range(1, n):\n        if _is_divisible_by_11_or_13(i):\n            total_count += _count_digit_7(i)\n\n    return total_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/121": [{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    \"\"\"\n    total_sum = 0\n    for i, element in enumerate(lst):\n        if i % 2 == 0 and element % 2 != 0:\n            total_sum += element\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/120": [{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Sort the array in descending order to easily pick the k largest\n    arr.sort(reverse=True)\n\n    # Select the first k elements\n    k_largest = arr[:k]\n\n    # Sort these k elements in ascending order as per requirement\n    k_largest.sort()\n\n    return k_largest", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/122": [{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n\n    def _has_at_most_two_digits(value: int) -> bool:\n        \"\"\"Checks if the absolute value of an integer has at most two digits.\"\"\"\n        return -99 <= value <= 99\n\n    arr_len = len(arr)\n\n    if not (1 <= arr_len <= 100):\n        raise ValueError(\"Array length out of bounds or empty\")\n\n    if not (1 <= k <= arr_len):\n        raise ValueError(\"k value out of bounds\")\n\n    current_sum = 0\n    for i in range(k):\n        if _has_at_most_two_digits(arr[i]):\n            current_sum += arr[i]\n\n    return current_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3 \n    '''\n    if any(c.isspace() for c in txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        odd_order_count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                # Calculate 0-indexed alphabetical order\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    odd_order_count += 1\n        return odd_order_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/126": [{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    \n    if len(lst) <= 1:\n        return True\n\n    def _check_sorted_order(numbers):\n        \"\"\"Checks if the list is sorted in ascending order.\"\"\"\n        for i in range(1, len(numbers)):\n            if numbers[i] < numbers[i-1]:\n                return False\n        return True\n\n    def _check_duplicate_count(numbers):\n        \"\"\"Checks if any number appears three or more times.\"\"\"\n        counts = {}\n        for num in numbers:\n            counts[num] = counts.get(num, 0) + 1\n            if counts[num] > 2:\n                return False\n        return True\n\n    if not _check_sorted_order(lst):\n        return False\n    \n    if not _check_duplicate_count(lst):\n        return False\n        \n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/128": [{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        sum_of_magnitudes += abs(num)\n\n        if num > 0:\n            sign = 1\n        elif num < 0:\n            sign = -1\n        else: # num == 0\n            sign = 0\n        \n        product_of_signs *= sign\n    \n    return sum_of_magnitudes * product_of_signs", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/123": [{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    The collatz sequence is generated by halving even numbers or multiplying odd numbers by 3 and adding 1, until 1 is reached.\n    \"\"\"\n\n    def _generate_collatz_sequence(start_n):\n        \"\"\"Generates the full Collatz sequence from start_n down to 1.\"\"\"\n        sequence = []\n        current_n = start_n\n        while current_n != 1:\n            sequence.append(current_n)\n            if current_n % 2 == 0:\n                current_n //= 2\n            else:\n                current_n = 3 * current_n + 1\n        sequence.append(1)\n        return sequence\n\n    def _filter_odd_numbers(sequence_list):\n        \"\"\"Filters a list to include only odd numbers.\"\"\"\n        return [num for num in sequence_list if num % 2 != 0]\n\n    def _sort_numbers(numbers_list):\n        \"\"\"Sorts a list of numbers in increasing order.\"\"\"\n        return sorted(numbers_list)\n\n    if n == 1:\n        return [1]\n\n    collatz_sequence = _generate_collatz_sequence(n)\n    odd_numbers = _filter_odd_numbers(collatz_sequence)\n    sorted_odd_numbers = _sort_numbers(odd_numbers)\n\n    return sorted_odd_numbers", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/124": [{"task_id": "HumanEval/124", "solution": "import re\ndef _is_not_empty(date_string: str) -> bool:\n    \"\"\"Checks if the date string is not empty.\"\"\"\n    return bool(date_string)\ndef _matches_format(date_string: str) -> bool:\n    \"\"\"Checks if the date string matches the 'mm-dd-yyyy' format.\"\"\"\n    return re.fullmatch(r'\\d{2}-\\d{2}-\\d{4}', date_string) is not None\ndef _parse_components(date_string: str) -> tuple[int, int, int] | None:\n    \"\"\"Parses a 'mm-dd-yyyy' string into (month, day, year) integers.\"\"\"\n    try:\n        parts = date_string.split('-')\n        month = int(parts[0])\n        day = int(parts[1])\n        year = int(parts[2])\n        return (month, day, year)\n    except (ValueError, IndexError):\n        return None\ndef _is_month_valid(month: int) -> bool:\n    \"\"\"Checks if the month is between 1 and 12, inclusive.\"\"\"\n    return 1 <= month <= 12\ndef _is_day_valid(day: int, month: int) -> bool:\n    \"\"\"Checks if the day is valid for the given month.\"\"\"\n    if month in (1, 3, 5, 7, 8, 10, 12):\n        return 1 <= day <= 31\n    elif month in (4, 6, 9, 11):\n        return 1 <= day <= 30\n    elif month == 2:\n        return 1 <= day <= 29\n    return False\ndef valid_date(date: str) -> bool:\n    \"\"\"Validates a given date string based on predefined rules.\n    Returns True if the date is valid, False otherwise.\"\"\"\n    if not _is_not_empty(date):\n        return False\n    if not _matches_format(date):\n        return False\n\n    components = _parse_components(date)\n    # If format matched, parsing should ideally not fail unless ints are not parsable,\n    # but check for robustness.\n    if components is None:\n        return False\n\n    month, day, year = components\n\n    if not _is_month_valid(month):\n        return False\n    \n    if not _is_day_valid(day, month):\n        return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/131": [{"task_id": "HumanEval/131", "solution": "class Digit:\n    \"\"\"Represents a single digit and determines its oddness.\"\"\"\n    def __init__(self, digit_value: int):\n        self._value = digit_value\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the digit is odd.\"\"\"\n        return self._value % 2 != 0\nclass PositiveInteger:\n    \"\"\"Encapsulates a positive integer and provides methods to process its digits.\"\"\"\n    def __init__(self, n: int):\n        self._value = n\n\n    def get_digits(self) -> list[int]:\n        \"\"\"Returns a list of individual digits from the integer.\"\"\"\n        return [int(d) for d in str(self._value)]\n\n    def get_odd_digits(self) -> list[int]:\n        \"\"\"Returns a list of odd digits extracted from the integer.\"\"\"\n        all_digits = self.get_digits()\n        odd_digits = []\n        for d_value in all_digits:\n            digit_obj = Digit(d_value)\n            if digit_obj.is_odd():\n                odd_digits.append(d_value)\n        return odd_digits\n\n    def calculate_odd_digit_product(self) -> int:\n        \"\"\"Computes the product of odd digits, or 0 if no odd digits are found.\"\"\"\n        odd_digits = self.get_odd_digits()\n        if not odd_digits:\n            return 0\n        \n        product = 1\n        for digit in odd_digits:\n            product *= digit\n        return product\ndef digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    positive_integer_instance = PositiveInteger(n)\n    return positive_integer_instance.calculate_odd_digit_product()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "from typing import Tuple, Optional\ndef is_prime(number: int) -> bool:\n    \"\"\"Determines if a given integer is a prime number.\"\"\"\n    if number <= 1:\n        return False\n    if number <= 3:\n        return True\n    if number % 2 == 0 or number % 3 == 0:\n        return False\n    i = 5\n    while i * i <= number:\n        if number % i == 0 or number % (i + 2) == 0:\n            return False\n        i += 6\n    return True\nclass Interval:\n    \"\"\"Represents a closed integer interval [start, end].\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\n\n    def get_length(self) -> int:\n        \"\"\"Calculates the length of the interval, interpreted as end - start, based on problem samples.\"\"\"\n        return self.end - self.start\n\n    def intersect(self, other: 'Interval') -> Optional['Interval']:\n        \"\"\"Determines the intersection with another interval.\"\"\"\n        intersect_start = max(self.start, other.start)\n        intersect_end = min(self.end, other.end)\n\n        if intersect_start <= intersect_end:\n            return Interval(intersect_start, intersect_end)\n        else:\n            return None\ndef intersection(interval1: Tuple[int, int], interval2: Tuple[int, int]) -> str:\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two \n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n    int1_obj = Interval(interval1[0], interval1[1])\n    int2_obj = Interval(interval2[0], interval2[1])\n\n    intersection_obj = int1_obj.intersect(int2_obj)\n\n    if intersection_obj is None:\n        return \"NO\"\n    else:\n        length = intersection_obj.get_length()\n        is_prime_result = is_prime(length)\n        if is_prime_result:\n            return \"YES\"\n        else:\n            return \"NO\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/119": [{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if concatenating two strings of parentheses in any order results in a balanced string.\n    A string is balanced if parentheses are properly nested and matched.\n    \"\"\"\n    def _is_balanced_string(s):\n        \"\"\"Determines if a given parentheses string is balanced.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    str1 = lst[0]\n    str2 = lst[1]\n\n    # Check the first concatenation order: str1 + str2\n    concat1 = str1 + str2\n    if _is_balanced_string(concat1):\n        return 'Yes'\n\n    # Check the second concatenation order: str2 + str1\n    concat2 = str2 + str1\n    if _is_bal