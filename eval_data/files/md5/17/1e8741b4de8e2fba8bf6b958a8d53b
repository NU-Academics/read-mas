    _validate_input_list(lst)\n    frequencies_map = _calculate_frequencies(lst)\n    result_integer = _find_greatest_qualifying_integer(frequencies_map)\n    \n    return result_integer", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/71": [{"task_id": "HumanEval/71", "solution": "def triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    \n    import math\n\n    class Triangle:\n        def __init__(self, a: float, b: float, c: float):\n            self._sideA = a\n            self._sideB = b\n            self._sideC = c\n\n        def isValid(self) -> bool:\n            return (self._sideA + self._sideB > self._sideC and\n                    self._sideA + self._sideC > self._sideB and\n                    self._sideB + self._sideC > self._sideA and\n                    self._sideA > 0 and self._sideB > 0 and self._sideC > 0)\n\n        def calculateArea(self) -> float:\n            # Calculate semi-perimeter\n            s = (self._sideA + self._sideB + self._sideC) / 2\n            # Heron's formula\n            area = math.sqrt(s * (s - self._sideA) * (s - self._sideB) * (s - self._sideC))\n            return round(area, 2)\n\n    triangle_obj = Triangle(a, b, c)\n    if not triangle_obj.isValid():\n        return -1\n    else:\n        return triangle_obj.calculateArea()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/75": [{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    def is_prime(n):\n        \"\"\"Checks if a number n is prime.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    def get_prime_factors(n):\n        \"\"\"Returns a list of prime factors for a given integer n.\"\"\"\n        factors = []\n        d = 2\n        temp_n = n\n        while d * d <= temp_n:\n            while temp_n % d == 0:\n                factors.append(d)\n                temp_n //= d\n            d += 1\n        if temp_n > 1:\n            factors.append(temp_n)\n        return factors\n\n    prime_factors = get_prime_factors(a)\n    return len(prime_factors) == 3", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/77": [{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Checks if an integer `a` is a perfect cube of some integer.\n    It computes the cube root and verifies if cubing the nearest integer root\n    reproduces the original number, handling both positive and negative inputs.\n    '''\n    # Calculate the cube root using the exponentiation operator.\n    # This correctly handles both positive and negative numbers by returning a float.\n    cbrt_a = a**(1/3)\n    \n    # Round the cube root to the nearest integer.\n    # This helps in overcoming minor floating-point inaccuracies and finds the closest integer root.\n    root = round(cbrt_a)\n    \n    # Check if the cube of the rounded integer root is exactly equal to the original number.\n    # We explicitly cast 'root' to int, though 'round' often returns an int for integral values.\n    return int(root)**3 =