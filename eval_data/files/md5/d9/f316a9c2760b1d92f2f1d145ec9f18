amePart:\n        \"\"\"Extracts and returns the substring before the first dot as a FileNamePart object.\"\"\"\n        dot_index = self.name_string.find('.')\n        return FileNamePart(self.name_string[:dot_index])\n\n    def get_substring_after_dot(self) -> FileExtension:\n        \"\"\"Extracts and returns the substring after the first dot as a FileExtension object.\"\"\"\n        dot_index = self.name_string.find('.')\n        return FileExtension(self.name_string[dot_index + 1:])\ndef file_name_check(file_name: str) -> str:\n    \"\"\"\n    Checks if a given file name is valid based on specific criteria.\n    Returns 'Yes' if the file name is valid, 'No' otherwise.\n    \"\"\"\n    fn = FileName(file_name)\n\n    # Check digit count\n    if fn.count_digits() > 3:\n        return ValidationResult(False).get_result()\n\n    # Check dot count\n    if fn.count_dots() != 1:\n        return ValidationResult(False).get_result()\n\n    # Extract prefix and extension\n    prefix = fn.get_substring_before_dot()\n    extension = fn.get_substring_after_dot()\n\n    # Check prefix conditions\n    if prefix.is_empty():\n        return ValidationResult(False).get_result()\n    if not prefix.starts_with_latin_letter():\n        return ValidationResult(False).get_result()\n\n    # Check extension validity\n    if not extension.is_valid_extension():\n        return ValidationResult(False).get_result()\n\n    return ValidationResult(True).get_result()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\u00e9xample.exe"]]}, {"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions\n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n