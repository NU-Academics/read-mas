s original word order.\n    \"\"\"\n\n    class PrimeNumberChecker:\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        def is_prime(self, number: int) -> bool:\n            if number < 2:\n                return False\n            for i in range(2, int(number**0.5) + 1):\n                if number % i == 0:\n                    return False\n            return True\n\n    class Word:\n        \"\"\"Represents a word, calculating its length and checking if length is prime.\"\"\"\n        # A shared PrimeNumberChecker instance for all Word objects.\n        _prime_checker = PrimeNumberChecker()\n\n        def __init__(self, text: str):\n            self.text = text\n            self.length = self.calculate_length()\n            self.is_prime_length = self._prime_checker.is_prime(self.length)\n\n        def calculate_length(self) -> int:\n            \"\"\"Calculates and returns the length of the word.\"\"\"\n            return len(self.text)\n\n        def is_length_prime(self) -> bool:\n            \"\"\"Returns true if the word's length is prime.\"\"\"\n            return self.is_prime_length\n\n    class Sentence:\n        \"\"\"Manages a sentence, splitting it into Word objects.\"\"\"\n        def __init__(self, text: str):\n            self.text = text\n            self.words: list[Word] = []\n\n        def split_into_words(self) -> list[Word]:\n            \"\"\"Splits the sentence into Word objects.\"\"\"\n            word_texts = self.text.split(' ')\n            self.words = [Word(wt) for wt in word_texts]\n            return self.words\n\n    # Main logic for words_in_sentence\n    sentence_obj = Sentence(sentence)\n    all_word_objects = sentence_obj.split_into_words()\n\n    filtered_words_text = []\n    for word_obj in all_word_objects:\n        if word_obj.is_length_prime():\n            filtered_words_text.append(word_obj.text)\n\n    return \" \".join(filtered_words_text)", "base_status": "pass", "plus_status": "pass", "base