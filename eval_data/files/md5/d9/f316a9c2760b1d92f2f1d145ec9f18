n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    _memo = {}\n\n    def _fibfib_recursive(k: int):\n        if k == 0:\n            return 0\n        if k == 1:\n            return 0\n        if k == 2:\n            return 1\n\n        if k in _memo:\n            return _memo[k]\n\n        result = _fibfib_recursive(k - 1) + _fibfib_recursive(k - 2) + _fibfib_recursive(k - 3)\n        _memo[k] = result\n        return result\n\n    return _fibfib_recursive(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/62": [{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\"Calculates the derivative of a polynomial represented by coefficients.\n    The resulting list contains the coefficients of the derivative polynomial.\n    \"\"\"\n    derived_coefficients = []\n    # The derivative of a term xs[i] * x^i is i * xs[i] * x^(i-1).\n    # We iterate from the coefficient of x^1 (index 1) to generate the new coefficients.\n    for i in range(1, len(xs)):\n        derived_coefficients.append(i * xs[i])\n\n    return derived_coefficients", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\\\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    if len(xs) == 1:\n        return []\n\n    ys = []\n    for k in range(len(xs) - 1):\n        # Calculate ys[k] = (k + 1) * xs[k + 1]\n        ys.append((k + 1) * xs[k + 1])\n    return ys", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/64": [{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    >>> vowels_count(\"\")\n    0\n    >>> vowels_count(\"rhythm\")\n    1\n    >>> vowels_count(\"hymn\")\n    1\n    >>> vowels_count(\"apple\")\n    2\n    >>> vowels_count(\"banana\")\n    3\n    >>> vowels_count(\"Strength\")\n    1\n    >>> vowels_count(\"sky\")\n    1\n    >>> vowels_count(\"type\")\n    1\n    >>> vowels_count(\"xylophone\")\n    3\n    \"\"\"\n    vowel_count = 0\n    s_lower = s.lower()\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    for i, char in enumerate(s_lower):\n        if char in standard_vowels:\n            vowel_count += 1\n        elif char == 'y' and i == len(s_lower) - 1:\n            # 'y' is a vowel only if it is the last character\n            vowel_count += 1\n\n    return vowel_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts vowels in a string, including 'y' if it is the last character.\n    Standard vowels 'a', 'e', 'i', 'o', 'u' are always counted, case-insensitively.\n    \"\"\"\n    vowel_count = 0\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    s_lower = s.lower()\n    n = len(s_lower)\n\n    if n == 0:\n        return 0\n\n    for i in range(n):\n        char = s_lower[i]\n\n        # Check if the character is a standard vowel.\n        if char in standard_vowels:\n            vowel_count += 1\n        # Check if it's 'y' and is the last character of the string.\n        elif char == 'y' and i == n - 1:\n            vowel_count += 1\n\n    return vowel_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/65": [{"task_id": "HumanEval/65", "solution": "class Number:\n    \"\"\"Domain Model for input x.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def get_digits(self) -> str:\n        \"\"\"Converts the integer value to its string representation.\"\"\"\n        return str(self._value)\n\n    def get_number_of_digits(self) -> int:\n        \"\"\"Returns the length of the string representation of value.\"\"\"\n        return len(str(self._value))\n\n    def get_value(self) -> int:\n        \"\"\"Returns the raw integer value.\"\"\"\n        return self._value\nclass Shift:\n    \"\"\"Domain Model for input shift.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def get_value(self) -> int:\n        \"\"\"Returns the raw integer value.\"\"\"\n        return self._value\nclass ShiftedString:\n    \"\"\"Domain Model for output.\"\"\"\n    def __init__(self, result: str):\n        self._result = result\n\n    def get_result(self) -> str:\n        \"\"\"Returns the stored string result.\"\"\"\n        return self._result\nclass CircularShiftProcessor:\n    \"\"\"Core business logic for circular shifting and reversing digits.\"\"\"\n    def process(self, number: Number, shift: Shift) -> ShiftedString:\n        \"\"\"Processes the number based on the shift value, returning a ShiftedString.\"\"\"\n        num_str = number.get_digits()\n        num_digits = number.get_number_of_digits()\n        shift_val = shift.get_value()\n\n        if shift_val > num_digits:\n            reversed_str = num_str[::-1]\n            return ShiftedString(reversed_str)\n        else:\n            # Perform circular right shift\n            # If shift_val is 0, it means no shift, original string is returned.\n            # If shift_val equals num_digits, original string is returned.\n            shifted_str = num_str[-shift_val:] + num_str[:-shift_val]\n            return ShiftedString(shifted_str)\ndef circular_shift(x: int, shift: int) -> str:\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string. If shift > number of digits, return digits reversed.\n    \"\"\"\n    number_obj = Number(x)\n    shift_obj = Shift(shift)\n    processor = CircularShiftProcessor()\n    shifted_string_obj = processor.process(number_obj, shift_obj)\n    return shifted_string_obj.get_result()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/65", "solution": "def _convert_to_string(x: int) -> str:\n    \"\"\"Converts an integer to its string representation.\"\"\"\n    return str(x)\ndef _get_digit_count(s: str) -> int:\n    \"\"\"Determines the number of digits in a string.\"\"\"\n    return len(s)\ndef _reverse_digits(s: str) -> str:\n    \"\"\"Reverses the order of digits in a string.\"\"\"\n    return s[::-1]\ndef _circular_right_shift(s: str, shift: int) -> str:\n    \"\"\"Performs a circular right shift on a string by a shift amount.\"\"\"\n    if not s:\n        return s\n    effective_shift = shift % len(s)\n    return s[-effective_shift:] + s[:-effective_shift]\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    string_x = _convert_to_string(x)\n    digit_count = _get_digit_count(string_x)\n\n    if shift > digit_count:\n        result = _reverse_digits(string_x)\n    else:\n        result = _circular_right_shift(string_x, shift)\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/66": [{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII codes of uppercase characters in a string.\n    Returns an integer representing this sum.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if 'A' <= char <= 'Z': # Check if character is uppercase ASCII\n            total_sum += ord(char) # Get ASCII value\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII codes for uppercase characters in a string.\n    Iterates through the input, summing ASCII values of only uppercase letters.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/68": [{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"Finds the smallest even non-negative value and its index in an array.\n    Returns [value, index] or an empty list if no even values or the array is empty.\"\"\"\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    if not arr:\n        return []\n\n    for i, value in enumerate(arr):\n        # Check if the current value is even. (Value is non-negative per design spec).\n        if value % 2 == 0:\n            # Update if it's a smaller even value, or a tie with a smaller index.\n            if value < smallest_even_value or (value == smallest_even_value and i < smallest_even_index):\n                smallest_even_value = value\n                smallest_even_index = i\n\n    if smallest_even_value == float('inf'):\n        return []", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[4, 2, 3]]], "plus_fail_tests": [[[2, 2, 2, 2, 2, 2]]]}, {"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Identifies the smallest even-valued node from an array, returning `[value, index]`.\n    Prioritizes the smallest index for tied values; returns `[]` if no even values or an empty array.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    its_index = -1\n\n    for current_index, current_value in enumerate(arr):\n        if current_value % 2 == 0:  # Check if current_value is even\n            if current_value < smallest_even_value:\n                smallest_even_value = current_value\n                its_index = current_index\n\n    if its_index == -1:  # No even values were found\n        return []\n    else:\n        return [smallest_even_value, its_index]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/67": [{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s,n):\n    \"\"\"\n    This function calculates the number of mango fruits in a basket.\n    It parses apple and orange counts from a string and subtracts their sum from the total.\n    \"\"\"\n    import re\n\n    def _parse_fruit_counts(s_input: str) -> tuple[int, int]:\n        \"\"\"\n        Helper to parse apple and orange counts from the input string.\n        It uses regular expressions to extract numerical values.\n        \"\"\"\n        apples_match = re.search(r'(\\d+)\\s+apples', s_input)\n        oranges_match = re.search(r'(\\d+)\\s+oranges', s_input)\n\n        # Trusting caller's inputs as per critical requirements, matches are guaranteed.\n        apples = int(apples_match.group(1))\n        oranges = int(oranges_match.group(1))\n\n        return apples, oranges\n\n    apples, oranges = _parse_fruit_counts(s)\n    total_apples_oranges = apples + oranges\n    mangoes = n - total_apples_oranges\n\n    return mangoes", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/67", "solution": "def _parse_fruit_string(s: str) -> tuple[int, int]:\n    \"\"\"Parses the input string to extract apple and orange counts.\n    Returns a tuple (num_apples, num_oranges).\n    \"\"\"\n    parts = s.split(\" apples and \")\n    num_apples_str = parts[0]\n    oranges_part = parts[1]\n\n    num_apples = int(num_apples_str)\n\n    num_oranges_str = oranges_part.split(\" oranges\")[0]\n    num_oranges = int(num_oranges_str)\n\n    return num_apples, num_oranges\ndef fruit_distribution(s, n):\n    \"\"\"Calculates the number of mango fruits in a basket.\n    It parses apple and orange counts from 's' and subtracts them from total 'n'.\n    \"\"\"\n    num_apples, num_oranges = _parse_fruit_string(s)\n    num_mangoes = n - num_apples - num_oranges\n    return num_mangoes", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/69": [{"task_id": "HumanEval/69", "solution": "def search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than\n    zero, and has a frequency greater than or equal to the value of the integer itself.\n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    frequencies = {}\n    # Determine frequency of each integer\n    for num in lst:\n        frequencies[num] = frequencies.get(num, 0) + 1\n\n    qualifying_integers = []\n    # Identify integers x where x > 0 and frequency >= x\n    for integer, freq in frequencies.items():\n        if integer > 0 and freq >= integer:\n            qualifying_integers.append(integer)\n\n    # Find the greatest among identified integers or return -1\n    if not qualifying_integers:\n        return -1\n    else:\n        return max(qualifying_integers)", "base_status": "pass", "plus_status":