elf._row\n\n    def get_col(self):\n        \"\"\"Returns the column index of the cell.\"\"\"\n        return self._col\nclass Grid:\n    \"\"\"Represents the game board, storing cell values and providing access methods.\"\"\"\n    def __init__(self, raw_grid):\n        self._N = len(raw_grid)\n        self._cells = [[None for _ in range(self._N)] for _ in range(self._N)]\n        for r in range(self._N):\n            for c in range(self._N):\n                self._cells[r][c] = Cell(raw_grid[r][c], r, c)\n\n    def get_N(self):\n        \"\"\"Returns the dimension N of the N x N grid.\"\"\"\n        return self._N\n\n    def get_cell(self, row, col):\n        \"\"\"Retrieves a Cell object at specified coordinates.\"\"\"\n        return self._cells[row][col]\n\n    def get_all_cells(self):\n        \"\"\"Returns a list of all Cell objects in the grid.\"\"\"\n        all_cells = []\n        for r in range(self._N):\n            for c in range(self._N):\n                all_cells.append(self._cells[r][c])\n        return all_cells\n\n    def get_neighbors(self, row, col):\n        \"\"\"Returns a list of valid adjacent Cell objects for a given cell.\"\"\"\n        neighbors = []\n        # Define relative coordinates for 4 directions (up, down, left, right)\n        dr = [-1, 1, 0, 0]\n        dc = [0, 0, -1, 1]\n\n        for i in range(4):\n            nr, nc = row + dr[i], col + dc[i]\n            if 0 <= nr < self._N and 0 <= nc < self._N:\n                neighbors.append(self._cells[nr][nc])\n        return neighbors\nclass Path:\n    \"\"\"Represents a sequence of visited cells, providing functionality to extend and compare paths.\"\"\"\n    def __init__(self, initial_cell, sequence_of_cells=None):\n        if sequence_of_cells is None:\n            self._sequence_of_cells = [initial_cell]\n        else:\n            self._sequence_of_cells = list(sequence_of_cells) # Ensure immutability by copying\n        self._length = len(self._sequence_of_cells)\n\n    def