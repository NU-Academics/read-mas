{"task_id": "Mbpp/764", "solution": "def number_ctr(input_string: str) -> int:\n    \"\"\"\n    Counts the number of digit characters in a given string.\n    Iterates through the string and uses the isdigit() method for each character.\n    \"\"\"\n    count = 0\n    for char in input_string:\n        if char.isdigit():\n            count += 1\n    return count"}
{"task_id": "Mbpp/757", "solution": "_reverse_string = lambda s: s[::-1]\ndef count_reverse_pairs(string_list: list[str]) -> int:\n    # Counts unique pairs of reverse strings in the given list.\n    # Uses sets to track processed strings and unique pairs to ensure accurate counting.\n    processed_strings = set()\n    unique_pairs = set()\n\n    for current_string in string_list:\n        if current_string in processed_strings:\n            continue\n\n        reversed_string = _reverse_string(current_string)\n\n        # Check if the reversed string exists in the original list and is not the current string itself\n        # unless it's a palindrome (which will be handled correctly by frozenset uniqueness)\n        if reversed_string in string_list:\n            # Add a canonical representation of the pair to avoid duplicates (e.g., (a, b) and (b, a))\n            unique_pairs.add(frozenset({current_string, reversed_string}))\n        \n        processed_strings.add(current_string)\n        # Also add the reversed string to processed_strings to avoid re-evaluating it as a 'current_string'\n        # in a future iteration and forming a redundant pair.\n        processed_strings.add(reversed_string)\n\n    return len(unique_pairs)"}
{"task_id": "Mbpp/762", "solution": "def check_monthnumber_number(month_number):\n    \"\"\"\n    Checks whether the given month number contains 30 days.\n    Months with 30 days are April (4), June (6), September (9), and November (11).\n    \"\"\"\n    return month_number in {4, 6, 9, 11}"}
{"task_id": "Mbpp/759", "solution": "def is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string represents a decimal number with exactly two digits after the decimal point.\n    It uses a regular expression to validate the format.\n    \"\"\"\n    import re\n    # Pattern explanation:\n    # ^       - start of the string\n    # -?      - an optional negative sign\n    # \\\\d*    - zero or more digits (for the integer part, allows .11)\n    # \\\\.     - a literal decimal point\n    # \\\\d{2}  - exactly two digits (for the fractional part)\n    # $       - end of the string\n    pattern = r\"^-?\\d*\\.\\d{2}$\"\n    return re.fullmatch(pattern, input_string) is not None"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(sequence: tuple | list, length: int) -> int | float:\n    \"\"\"\n    Finds the minimum absolute difference between any two elements in a given sequence.\n    Returns 0 if the sequence has fewer than two elements, as no unique pairs can be formed.\n    \"\"\"\n    if length < 2:\n        return 0\n\n    min_diff = float('inf')\n\n    for i in range(length):\n        for j in range(i + 1, length):\n            current_diff = abs(sequence[i] - sequence[j])\n            min_diff = min(min_diff, current_diff)\n\n    return min_diff"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list[int], target_sum: int) -> int:\n    \"\"\"\n    Counts the number of pairs in a list whose sum equals the target_sum.\n    Each distinct occurrence of a number is considered when forming pairs.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/765", "solution": "def find_nth_polite_number(n: int) -> int:\n    \"\"\"\n    Finds the nth number in the sequence of polite numbers.\n    A polite number is a positive integer that is not a power of 2.\n    \"\"\"\n    def is_power_of_two(num: int) -> bool:\n        \"\"\"Checks if a positive integer is a power of two.\"\"\"\n        if num <= 0:\n            return False\n        return (num & (num - 1)) == 0\n\n    polite_count = 0\n    current_num = 1\n\n    while True:\n        if not is_power_of_two(current_num):\n            polite_count += 1\n            if polite_count == n:\n                return current_num\n        current_num += 1"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list: list) -> list[tuple]:\n    \"\"\"\n    Generates a list of consecutive pairs from the input_list.\n    Returns an empty list if the input_list has fewer than two items.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n\n    result_pairs = []\n    for i in range(len(input_list) - 1):\n        result_pairs.append((input_list[i], input_list[i+1]))\n\n    return result_pairs"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1: list, list2: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists, preserving the relative order from list1.\n    Elements present in list1 but not in list2 are returned.\n    \"\"\"\n    set2 = set(list2)\n    result = []\n    for item in list1:\n        if item not in set2:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"Calculates the sum of the fourth power of the first 'n' odd natural numbers.\"\"\"\n    total_sum = 0\n    current_odd_number = 1\n    for _ in range(n):\n        total_sum += current_odd_number ** 4\n        current_odd_number += 2\n    return total_sum"}
