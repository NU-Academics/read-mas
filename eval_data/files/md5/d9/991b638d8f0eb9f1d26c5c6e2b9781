{"task_id": "Mbpp/75", "solution": "def find_tuples(list_of_tuples: list[tuple[int, ...]], k: int) -> list[tuple[int, ...]]:\n    \"\"\"\n    Identifies and returns tuples from a list where all elements are perfectly divisible by k.\n    Assumes k is non-zero, as per typical divisibility context and to avoid ZeroDivisionError.\n    \"\"\"\n    filtered_tuples = []\n    for current_tuple in list_of_tuples:\n        is_divisible = True\n        for element in current_tuple:\n            if element % k != 0:\n                is_divisible = False\n                break\n        if is_divisible:\n            filtered_tuples.append(current_tuple)\n    return filtered_tuples"}
{"task_id": "Mbpp/77", "solution": "def is_Diff(number: int) -> bool:\n    \"\"\"\n    Determines if a given integer is divisible by 11 using the alternating sum of digits rule.\n    It returns True if the number is divisible by 11, False otherwise.\n    \"\"\"\n    if number == 0:\n        return True\n\n    num_str = str(abs(number))\n    alternating_sum = 0\n    for i, digit_char in enumerate(reversed(num_str)):\n        digit = int(digit_char)\n        if i % 2 == 0:\n            alternating_sum += digit\n        else:\n            alternating_sum -= digit\n\n    return alternating_sum % 11 == 0"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(input_list: list) -> list:\n    \"\"\"Sorts a list of comparable elements in ascending order using the Comb Sort algorithm.\n    A new sorted list is returned, leaving the original input list unchanged.\n    \"\"\"\n    n = len(input_list)\n    if n == 0:\n        return []\n\n    arr = list(input_list)  # Create a copy to avoid modifying the original list\n\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        if gap > 1:\n            gap = int(gap / shrink_factor)\n            if gap < 1:\n                gap = 1\n\n        swapped = False\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
