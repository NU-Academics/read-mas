{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"Calculates the Eulerian number a(n, m).\"\"\"\n    # Handle base and edge cases for Eulerian numbers\n    if n == 0 and m == 0:\n        return 1\n    if m < 0 or m >= n:\n        return 0\n\n    def _factorial(n: int) -> int:\n        \"\"\"Calculates the factorial of a non-negative integer.\"\"\"\n        if n == 0:\n            return 1\n        res = 1\n        for i in range(1, n + 1):\n            res *= i\n        return res\n\n    def _binomial_coefficient(n: int, k: int) -> int:\n        \"\"\"Calculates the binomial coefficient C(n, k).\"\"\"\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        if k > n // 2:\n            k = n - k\n        \n        return _factorial(n) // (_factorial(k) * _factorial(n - k))\n\n    total_sum = 0\n    # The Eulerian number A(n, m) is given by the formula:\n    # A(n, m) = sum_{k=0 to m} (-1)^k * C(n+1, k) * (m - k + 1)^n\n    for k in range(m + 1):\n        term = ((-1)**k) * _binomial_coefficient(n + 1, k) * ((m - k + 1)**n)\n        total_sum += term\n    \n    return total_sum"}
{"task_id": "Mbpp/108", "solution": "def merge_sorted_list(list1: list, list2: list, list3: list) -> list:\n    \"\"\"Merges three input lists into a single list and sorts it in ascending order.\n\n    This function concatenates the three lists and then sorts the combined result.\n    \"\"\"\n    merged_list = list1 + list2 + list3\n    sorted_merged_list = sorted(merged_list)\n    return sorted_merged_list"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"\n    Calculates the number of odd decimal equivalents obtained by rotating a binary string a specified number of times.\n    \"\"\"\n    def _rotate_string(s: str) -> str:\n        \"\"\"Performs a single left rotation on a string.\"\"\"\n        if not s:\n            return s\n        return s[1:] + s[0]\n\n    def _binary_to_decimal(binary_str: str) -> int:\n        \"\"\"Converts a binary string to its decimal integer equivalent.\"\"\"\n        return int(binary_str, 2)\n\n    def _is_odd(n: int) -> bool:\n        \"\"\"Determines if a given integer is an odd number.\"\"\"\n        return n % 2 != 0\n\n    odd_count = 0\n    current_string = binary_string\n\n    for _ in range(rotations):\n        current_string = _rotate_string(current_string)\n        decimal_value = _binary_to_decimal(current_string)\n        if _is_odd(decimal_value):\n            odd_count += 1\n            \n    return odd_count"}
