{"task_id": "Mbpp/615", "solution": "def average_tuple(data: tuple[tuple[float | int, ...], ...]) -> list[float]:\n    \"\"\"Calculates the average value for each inner tuple in a tuple of tuples.\"\"\"\n    averages_list = []\n    for inner_tuple in data:\n        if not inner_tuple:\n            averages_list.append(0.0)\n        else:\n            average = sum(inner_tuple) / len(inner_tuple)\n            averages_list.append(float(average))\n    return averages_list"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix: list[list[int]], n: int) -> int:\n    \"\"\"\n    Finds the maximum value within the specified column of a given matrix.\n    Assumes a non-empty matrix and valid column index `n`.\n    \"\"\"\n    max_val = matrix[0][n]\n    for row in matrix[1:]:\n        current_value = row[n]\n        if current_value > max_val:\n            max_val = current_value\n    return max_val"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo on two tuples of the same length.\n    It validates inputs for length, numerical types, and zero divisors, raising specific errors.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Tuples must have the same length.\")\n\n    results = []\n    for element1, element2 in zip(tuple1, tuple2):\n        if not isinstance(element1, (int, float)) or not isinstance(element2, (int, float)):\n            raise TypeError(\"Tuple elements must be numerical.\")\n        \n        if element2 == 0:\n            raise ZeroDivisionError(\"Divisor cannot be zero.\")\n            \n        results.append(element1 % element2)\n        \n    return tuple(results)"}
{"task_id": "Mbpp/618", "solution": "def div_list(list1: list, list2: list) -> list:\n    \"\"\"\n    Performs element-wise division of two lists of numbers.\n    Raises ValueError if lists have unequal lengths or ZeroDivisionError for division by zero.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise ValueError(\"Lists must be of equal length\")\n\n    result = []\n    for i in range(len(list1)):\n        if list2[i] == 0:\n            raise ZeroDivisionError(\"Division by zero\")\n        result.append(float(list1[i]) / list2[i])\n    return result"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(tuple_list: list[tuple]) -> int:\n    \"\"\"Calculates the sum of all numerical values across all tuples in a given list of tuples.\"\"\"\n    total_sum = 0\n    for tpl in tuple_list:\n        for value in tpl:\n            total_sum += value\n    return total_sum"}
