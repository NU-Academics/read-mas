{"task_id": "Mbpp/63", "solution": "def max_difference(tuple_list: list[tuple[int | float, int | float]]) -> int | float:\n    \"\"\"\n    Calculates the maximum absolute difference between elements in pairs within a list of tuples.\n    Returns 0.0 if the input list is empty.\n    \"\"\"\n    if not tuple_list:\n        return 0.0\n\n    max_diff = 0.0\n    for pair in tuple_list:\n        val1, val2 = float(pair[0]), float(pair[1])\n        current_diff = abs(val1 - val2)\n        if current_diff > max_diff:\n            max_diff = current_diff\n    return max_diff"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list: list) -> int:\n    \"\"\"\n    Recursively flattens a list and sums all integer elements.\n    \"\"\"\n    total_sum = 0\n    for element in input_list:\n        if isinstance(element, list):\n            total_sum += recursive_list_sum(element)\n        elif isinstance(element, int):\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the Bell number B_n for a given non-negative integer n.\n    B_n is the number of ways to partition a set of n elements into non-empty subsets.\n    \"\"\"\n    _stirling_cache = {}\n\n    def _stirling_second_kind(n: int, k: int) -> int:\n        \"\"\"\n        Calculates the Stirling number of the second kind S(n, k).\n        Uses dynamic programming with memoization.\n        \"\"\"\n        if (n, k) in _stirling_cache:\n            return _stirling_cache[(n, k)]\n\n        if k < 0 or k > n:\n            return 0\n        if k == 0:\n            return 1 if n == 0 else 0\n        if k == n:\n            return 1\n        if k == 1:\n            return 1\n\n        result = _stirling_second_kind(n - 1, k - 1) + k * _stirling_second_kind(n - 1, k)\n        _stirling_cache[(n, k)] = result\n        return result\n\n    if n < 0:\n        raise ValueError(\"Input for Bell number must be a non-negative integer.\")\n\n    if n == 0:\n        return 1\n\n    total_bell = 0\n    for k in range(n + 1):\n        total_bell += _stirling_second_kind(n, k)\n    return total_bell"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic (either monotonically increasing or decreasing).\n    An empty array or a single-element array is considered monotonic.\n    \"\"\"\n    \n    def _is_monotonically_increasing(arr: list) -> bool:\n        \"\"\"Checks if an array is monotonically increasing.\"\"\"\n        for i in range(1, len(arr)):\n            if arr[i] < arr[i - 1]:\n                return False\n        return True\n\n    def _is_monotonically_decreasing(arr: list) -> bool:\n        \"\"\"Checks if an array is monotonically decreasing.\"\"\"\n        for i in range(1, len(arr)):\n            if arr[i] > arr[i - 1]:\n                return False\n        return True\n\n    return _is_monotonically_increasing(array) or _is_monotonically_decreasing(array)"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if a sub_list is present as a contiguous sequence within main_list.\n    \"\"\"\n    if not sub_list:\n        return True\n\n    if len(sub_list) > len(main_list):\n        return False\n\n    for i in range(len(main_list) - len(sub_list) + 1):\n        if main_list[i:i + len(sub_list)] == sub_list:\n            return True\n\n    return False"}
