{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Calculates the maximum sum of an increasing subsequence from arr[0] to arr[i],\n    whose last element is strictly less than arr[k], and then adds arr[k] to this sum.\n    \"\"\"\n\n    def _find_increasing_subsequences_prefix(prefix_arr: list[int], limit_idx: int) -> list[list[int]]:\n        \"\"\"\n        Generates all increasing subsequences from the prefix `prefix_arr[0...limit_idx]`.\n        \"\"\"\n        dp_subsequences = [[] for _ in range(limit_idx + 1)]\n\n        for j in range(limit_idx + 1):\n            current_element = prefix_arr[j]\n            dp_subsequences[j].append([current_element])\n\n            for p in range(j):\n                if prefix_arr[p] < current_element:\n                    for subseq in dp_subsequences[p]:\n                        dp_subsequences[j].append(subseq + [current_element])\n        \n        all_subsequences = []\n        for sublist in dp_subsequences:\n            all_subsequences.extend(sublist)\n        return all_subsequences\n\n    def _is_valid_subsequence(subsequence: list[int], kth_element_value: int) -> bool:\n        \"\"\"\n        Checks if the last element of the `subsequence` is strictly less than `kth_element_value`.\n        \"\"\"\n        return subsequence[-1] < kth_element_value\n\n    def _calculate_subsequence_sum(subsequence: list[int]) -> int:\n        \"\"\"\n        Computes the sum of all elements in the `subsequence`.\n        \"\"\"\n        return sum(subsequence)\n\n    kth_element_value = arr[k]\n    \n    all_subsequences_prefix = _find_increasing_subsequences_prefix(arr, i)\n\n    max_valid_subsequence_sum = 0\n\n    for subseq in all_subsequences_prefix:\n        if _is_valid_subsequence(subseq, kth_element_value):\n            current_sum = _calculate_subsequence_sum(subseq)\n            if current_sum > max_valid_subsequence_sum:\n                max_valid_subsequence_sum = current_sum\n    \n    final_sum = max_valid_subsequence_sum + kth_element_value\n    return final_sum"}
