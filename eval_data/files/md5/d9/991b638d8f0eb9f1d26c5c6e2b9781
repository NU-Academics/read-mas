{"task_id": "Mbpp/592", "solution": "def sum_Of_product(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the product of consecutive binomial coefficients C(n, k) * C(n, k+1).\n    This function includes its mathematical dependencies inline.\n    \"\"\"\n\n    def factorial(val: int) -> int:\n        \"\"\"Calculates the factorial of a non-negative integer.\"\"\"\n        if val < 0:\n            return 0  # Factorial not defined for negative numbers, or interpreted as 0 for combinations context\n        if val == 0:\n            return 1\n        res = 1\n        for i in range(1, val + 1):\n            res *= i\n        return res\n\n    class BinomialCoefficient:\n        \"\"\"Encapsulates the calculation of a binomial coefficient C(n, k).\"\"\"\n        def __init__(self, n_val: int, k_val: int):\n            self._n = n_val\n            self._k = k_val\n\n        def calculate(self) -> int:\n            \"\"\"Calculates and returns the value of C(n, k).\"\"\"\n            if not (0 <= self._k <= self._n):\n                return 0  # C(n, k) is 0 if k is out of range\n            n_fact = factorial(self._n)\n            k_fact = factorial(self._k)\n            nk_fact = factorial(self._n - self._k)\n            return n_fact // (k_fact * nk_fact)\n\n    total_sum = 0\n    if n < 0:\n        return 0\n\n    for k in range(n):  # Loop k from 0 to n-1\n        # C(n, k)\n        bc_nk = BinomialCoefficient(n, k)\n        c_nk_value = bc_nk.calculate()\n\n        # C(n, k+1)\n        bc_nk1 = BinomialCoefficient(n, k + 1)\n        c_nk1_value = bc_nk1.calculate()\n\n        total_sum += c_nk_value * c_nk1_value\n\n    return total_sum"}
{"task_id": "Mbpp/593", "solution": "class Octet:\n    \"\"\"Represents a single octet of an IP address and handles its normalization.\"\"\"\n    def __init__(self, original_value: str):\n        self._original_value = original_value\n        self._normalized_value = self._remove_leading_zeros(original_value)\n\n    def _remove_leading_zeros(self, octet_str: str) -> str:\n        \"\"\"Removes leading zeros from an octet string, preserving '0' for zero value.\"\"\"\n        return str(int(octet_str))\n\n    def get_normalized_value(self) -> str:\n        \"\"\"Returns the normalized string value of the octet.\"\"\"\n        return self._normalized_value\nclass IPAddress:\n    \"\"\"Represents an IP address, handling its parsing, normalization, and reconstruction.\"\"\"\n    def __init__(self, ip_address_string: str):\n        self._original_string = ip_address_string\n        self._octets = []\n        self._normalized_string = \"\"\n        self._parse_and_normalize()\n\n    def _parse_and_normalize(self):\n        \"\"\"Parses the IP string into octets and normalizes them.\"\"\"\n        octet_strings = self._original_string.split('.')\n\n        for octet_str in octet_strings:\n            octet = Octet(octet_str)\n            self._octets.append(octet)\n\n        self._normalized_string = \".\".join([o.get_normalized_value() for o in self._octets])\n\n    def get_normalized_string(self) -> str:\n        \"\"\"Returns the full normalized IP address string.\"\"\"\n        return self._normalized_string\ndef removezero_ip(ip_address_string: str) -> str:\n    \"\"\"\n    Normalizes an IP address string by removing leading zeros from each octet.\n    Example: removezero_ip(\"216.08.094.196\") == \"216.8.94.196\"\n    \"\"\"\n    ip_address = IPAddress(ip_address_string)\n    return ip_address.get_normalized_string()"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n: int) -> tuple[float, float]:\n    \"\"\"\n    Calculates the sum and average of the first n natural numbers.\n    \"\"\"\n    sum_val = n * (n + 1) / 2\n    average_val = sum_val / n\n    return (sum_val, average_val)"}
{"task_id": "Mbpp/597", "solution": "def find_kth(arr1: list[int], arr2: list[int], k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element from two given sorted arrays.\n    Uses a merge-like approach to traverse the arrays and find the element.\n    \"\"\"\n    n1, n2 = len(arr1), len(arr2)\n    \n    # Validate k as per design context, although the prompt says not to raise exceptions for edge cases,\n    # the design context explicitly details raising ValueError for invalid k.\n    # Sticking to the prompt's instruction to NOT raise exceptions or do isinstance() checks.\n    # Therefore, assuming k is valid for the given problem.\n\n    i = 0  # Pointer for arr1\n    j = 0  # Pointer for arr2\n    count = 0  # To keep track of elements visited\n\n    while i < n1 and j < n2:\n        count += 1\n        if arr1[i] < arr2[j]:\n            if count == k:\n                return arr1[i]\n            i += 1\n        else:\n            if count == k:\n                return arr2[j]\n            j += 1\n\n    # If elements from arr1 are exhausted, continue with arr2\n    while i < n1:\n        count += 1\n        if count == k:\n            return arr1[i]\n        i += 1\n\n    # If elements from arr2 are exhausted, continue with arr1\n    while j < n2:\n        count += 1\n        if count == k:\n            return arr2[j]\n        j += 1\n\n    # This part should ideally not be reached if k is within bounds (1 to n1+n2)\n    # The design context implies k will always be valid, and this path signifies\n    # that k was perhaps out of bounds or an unexpected condition.\n    # Returning an arbitrary value or raising an error would be typical,\n    # but adhering to \"No ... raise exceptions for edge cases\", we assume\n    # the function will always find a valid k-th element.\n    # Given the assert example, k will always be valid."}
{"task_id": "Mbpp/598", "solution": "import math\ndef _get_digit_count(num: int) -> int:\n    \"\"\"Determines the total number of digits in an integer.\n    Handles positive integers and zero.\"\"\"\n    if num == 0:\n        return 1\n    return int(math.log10(abs(num))) + 1\ndef _get_digits(num: int) -> list[int]:\n    \"\"\"Extracts individual digits from an integer.\n    Returns digits in their original order.\"\"\"\n    if num == 0:\n        return [0]\n    digits = []\n    temp_num = abs(num)\n    while temp_num > 0:\n        digits.append(temp_num % 10)\n        temp_num //= 10\n    return digits[::-1]\ndef _calculate_sum_of_powers(digits: list[int], power: int) -> int:\n    \"\"\"Calculates the sum of each digit raised to a specified power.\"\"\"\n    total_sum = 0\n    for digit in digits:\n        total_sum += digit ** power\n    return total_sum\ndef armstrong_number(number: int) -> bool:\n    \"\"\"Checks if a given number is an Armstrong number.\n    Returns True if the number is an Armstrong number, False otherwise.\"\"\"\n    if number < 0:\n        return False\n    if number == 0:\n        return True\n\n    original_number = number\n    digit_count = _get_digit_count(original_number)\n    digits = _get_digits(original_number)\n    calculated_sum = _calculate_sum_of_powers(digits, digit_count)\n\n    return calculated_sum == original_number"}
