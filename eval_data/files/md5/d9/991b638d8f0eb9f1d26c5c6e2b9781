{"task_id": "Mbpp/639", "solution": "def sample_nam(name_strings: list[str]) -> int:\n    \"\"\"\n    Calculates the sum of lengths of names after removing those that start with a lowercase letter.\n    \"\"\"\n    class Name:\n        \"\"\"Encapsulates a name string and provides validation and length information.\"\"\"\n        def __init__(self, value: str):\n            self._value = value\n\n        def starts_with_lowercase(self) -> bool:\n            \"\"\"Checks if the name's first character is a lowercase letter.\"\"\"\n            if not self._value:\n                return False\n            return 'a' <= self._value[0] <= 'z'\n\n        def length(self) -> int:\n            \"\"\"Returns the length of the name string.\"\"\"\n            return len(self._value)\n\n    class NameList:\n        \"\"\"Manages a collection of Name objects and filters for valid names.\"\"\"\n        def __init__(self, name_strings: list[str]):\n            self._names = [Name(name_str) for name_str in name_strings]\n\n        def get_valid_names(self) -> list[Name]:\n            \"\"\"Filters and returns a list of Name objects that do not start with a lowercase letter.\"\"\"\n            valid_names_list = []\n            for name_obj in self._names:\n                if not name_obj.starts_with_lowercase():\n                    valid_names_list.append(name_obj)\n            return valid_names_list\n\n    name_list_manager = NameList(name_strings)\n    valid_names = name_list_manager.get_valid_names()\n\n    total_length = 0\n    for name_obj in valid_names:\n        total_length += name_obj.length()\n\n    return total_length"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(arr: list) -> list:\n    \"\"\"\n    Sorts the input list `arr` in ascending order using the heap sort algorithm.\n    Returns a new list containing the sorted elements.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return list(arr) # Return a copy for consistency with non-empty lists\n\n    working_arr = list(arr) # Create a copy to avoid modifying the original list\n\n    def _heapify(arr_local: list, n_local: int, i_local: int) -> None:\n        \"\"\"\n        Maintains the max-heap property for a subtree rooted at index i_local\n        within a list of size n_local.\n        \"\"\"\n        largest = i_local\n        left_child = 2 * i_local + 1\n        right_child = 2 * i_local + 2\n\n        if left_child < n_local and arr_local[left_child] > arr_local[largest]:\n            largest = left_child\n\n        if right_child < n_local and arr_local[right_child] > arr_local[largest]:\n            largest = right_child\n\n        if largest != i_local:\n            arr_local[i_local], arr_local[largest] = arr_local[largest], arr_local[i_local]\n            _heapify(arr_local, n_local, largest)\n\n    def _build_max_heap(arr_local: list) -> None:\n        \"\"\"\n        Transforms an unsorted list into a max-heap by calling _heapify\n        on all non-leaf nodes, starting from the last non-leaf node.\n        \"\"\"\n        # Start from the last non-leaf node and go up to the root\n        for i_local in range(n // 2 - 1, -1, -1):\n            _heapify(arr_local, n, i_local)\n\n    # 1. Build a max-heap from the input data\n    _build_max_heap(working_arr)\n\n    # 2. Extract elements one by one from the heap\n    for i in range(n - 1, 0, -1):\n        # Move current root to end\n        working_arr[i], working_arr[0] = working_arr[0], working_arr[i]\n        # Call _heapify on the reduced heap\n        _heapify(working_arr, i, 0) # 'i' is the new size of the heap\n\n    return working_arr"}
