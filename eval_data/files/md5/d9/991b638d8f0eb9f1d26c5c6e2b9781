{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of digits of 'base' raised to 'power'.\n    Accepts two integer arguments, 'base' and 'power'. Returns the calculated sum of digits.\n    \"\"\"\n    class InputData:\n        def __init__(self, base: int, power: int):\n            self.base = base\n            self.power = power\n\n    class Result:\n        def __init__(self, sum_of_digits: int):\n            self.sum_of_digits = sum_of_digits\n\n    class PowerCalculator:\n        def calculate_power(self, base: int, power: int) -> int:\n            \"\"\"Computes base raised to power.\"\"\"\n            return base ** power\n\n        def sum_digits(self, number: int) -> int:\n            \"\"\"Calculates the sum of digits of a given number.\"\"\"\n            return sum(int(digit) for digit in str(number))\n\n    input_data = InputData(base, power)\n    calculator = PowerCalculator()\n    power_result = calculator.calculate_power(input_data.base, input_data.power)\n    sum_of_digits = calculator.sum_digits(power_result)\n    output_result = Result(sum_of_digits)\n    return output_result.sum_of_digits"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Calculates the product of adjacent elements in a tuple.\n\n    The i-th element of the output tuple is t_i * t_{i+1}.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple\")\n\n    if len(input_tuple) < 2:\n        raise ValueError(\"Input tuple must have at least two elements\")\n\n    products = []\n    for i in range(len(input_tuple) - 1):\n        t_i = input_tuple[i]\n        t_i_plus_1 = input_tuple[i + 1]\n\n        if not isinstance(t_i, (int, float)) or not isinstance(t_i_plus_1, (int, float)):\n            raise TypeError(\"Tuple elements must be numbers\")\n\n        products.append(t_i * t_i_plus_1)\n\n    return tuple(products)"}
{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(grid: list[list[int]]) -> float:\n    \"\"\"\n    Given a square matrix, finds a path from top-left to bottom-right\n    (moving only right or down) with the maximum average cost.\n    \"\"\"\n    from typing import List\n\n    class Cell:\n        \"\"\"Represents a single cell in the matrix with its coordinates and cost.\"\"\"\n        def __init__(self, row: int, col: int, cost: int):\n            self.row = row\n            self.col = col\n            self.cost = cost\n\n        def __repr__(self):\n            return f\"Cell({self.row},{self.col},{self.cost})\"\n\n    class Matrix:\n        \"\"\"Represents the N*N square matrix and provides access to cells.\"\"\"\n        def __init__(self, data: List[List[int]]):\n            N = len(data)\n            self.N = N\n            self.cells: List[List[Cell]] = []\n            for r_idx, row_data in enumerate(data):\n                self.cells.append([Cell(r_idx, c_idx, cost) for c_idx, cost in enumerate(row_data)])\n\n        def get_cell(self, row: int, col: int) -> Cell:\n            return self.cells[row][col]\n\n        def __repr__(self):\n            return f\"Matrix(N={self.N}, cells=...)\"\n\n    class Path:\n        \"\"\"Represents a sequence of cells forming a valid path and stores its calculated metrics.\"\"\"\n        def __init__(self, initial_cell: Cell):\n            self.cells_in_path: List[Cell] = [initial_cell]\n            self.total_cost: float = float(initial_cell.cost)\n            self.number_of_cells: int = 1\n            self.average_cost: float = float(initial_cell.cost)\n\n        def add_cell(self, cell: Cell):\n            \"\"\"Adds a cell to the path and updates metrics incrementally.\"\"\"\n            self.cells_in_path.append(cell)\n            self.total_cost += cell.cost\n            self.number_of_cells += 1\n            self.average_cost = self.total_cost / self.number_of_cells\n\n        def calculate_metrics(self):\n            \"\"\"Recalculates total cost, number of cells, and average cost for the path.\"\"\"\n            self.total_cost = sum(cell.cost for cell in self.cells_in_path)\n            self.number_of_cells = len(self.cells_in_path)\n            self.average_cost = self.total_cost / self.number_of_cells if self.number_of_cells > 0 else 0.0\n\n        def __repr__(self):\n            return f\"Path(avg={self.average_cost:.2f}, cells={len(self.cells_in_path)})\"\n\n        def __lt__(self, other):\n            return self.average_cost < other.average_cost\n\n    def find_all_paths_helper(matrix: Matrix) -> List[Path]:\n        \"\"\"Identifies all valid paths from (0,0) to (N-1, N-1) in the given matrix, moving only right or down.\"\"\"\n        all_paths: List[Path] = []\n        N = matrix.N\n\n        def dfs(current_row: int, current_col: int, current_path: Path):\n            # Base case: Reached the bottom-right cell\n            if current_row == N - 1 and current_col == N - 1:\n                all_paths.append(current_path)\n                return\n\n            # Move right\n            if current_col + 1 < N:\n                next_cell = matrix.get_cell(current_row, current_col + 1)\n                # Create a new path by copying the current path's cells and adding the next cell.\n                new_path_right = Path(current_path.cells_in_path[0])\n                for cell in current_path.cells_in_path[1:]:\n                    new_path_right.add_cell(cell)\n                new_path_right.add_cell(next_cell)\n                dfs(current_row, current_col + 1, new_path_right)\n\n            # Move down\n            if current_row + 1 < N:\n                next_cell = matrix.get_cell(current_row + 1, current_col)\n                # Create a new path by copying the current path's cells and adding the next cell.\n                new_path_down = Path(current_path.cells_in_path[0])\n                for cell in current_path.cells_in_path[1:]:\n                    new_path_down.add_cell(cell)\n                new_path_down.add_cell(next_cell)\n                dfs(current_row + 1, current_col, new_path_down)\n\n        start_cell = matrix.get_cell(0, 0)\n        initial_path = Path(start_cell)\n        dfs(0, 0, initial_path)\n\n        return all_paths\n\n    def calculate_path_metrics_helper(path: Path):\n        \"\"\"Computes the total cost, number of cells, and average cost for a given path.\"\"\"\n        path.calculate_metrics()\n\n    def find_max_average_helper(paths: List[Path]) -> float:\n        \"\"\"Determines the maximum average cost among a list of paths.\"\"\"\n        max_path = max(paths)\n        return max_path.average_cost\n\n    # Main logic starts here\n    matrix = Matrix(grid)\n    all_paths = find_all_paths_helper(matrix)\n\n    # Ensure all path metrics are finalized, as per main.py in design.\n    for path in all_paths:\n        calculate_path_metrics_helper(path)\n\n    max_average_cost = find_max_average_helper(all_paths)\n    return max_average_cost"}
{"task_id": "Mbpp/728", "solution": "def sum_list(list_a: list[float | int], list_b: list[float | int]) -> list[float | int]:\n    \"\"\"\n    Calculates the element-wise sum of two lists of numbers.\n    Assumes inputs are lists of equal length containing only numbers.\n    \"\"\"\n    result_list = []\n    for val_a, val_b in zip(list_a, list_b):\n        result_list.append(val_a + val_b)\n    return result_list"}
