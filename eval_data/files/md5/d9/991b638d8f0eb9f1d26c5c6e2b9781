{"task_id": "Mbpp/299", "solution": "def max_aggregate(entries: list[tuple[str, int]]) -> tuple[str | None, int]:\n    \"\"\"\n    Calculates the maximum aggregate score from a list of (name, score) tuples.\n    It sums scores for each unique name and returns the name with the highest total score along with that score.\n    \"\"\"\n    aggregated_scores = {}\n    for name, score in entries:\n        aggregated_scores[name] = aggregated_scores.get(name, 0) + score\n\n    if not aggregated_scores:\n        return (None, 0)\n\n    max_name = max(aggregated_scores, key=aggregated_scores.get)\n    max_score = aggregated_scores[max_name]\n\n    return (max_name, max_score)"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list: list) -> list:\n    \"\"\"\n    Flattens a given nested list structure into a single-level list.\n    Elements are processed in their original order.\n    \"\"\"\n    flattened_result = []\n    for item in nested_list:\n        if isinstance(item, list):\n            flattened_result.extend(flatten_list(item))\n        else:\n            flattened_result.append(item)\n    return flattened_result"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(input_dictionary: dict) -> int:\n    \"\"\"Calculates the maximum nesting depth of a given dictionary.\n    The depth is defined by the maximum level of nested dictionaries.\n    \"\"\"\n    max_current_depth = 0\n    for value in input_dictionary.values():\n        if isinstance(value, dict):\n            max_current_depth = max(max_current_depth, dict_depth(value))\n\n    return 1 + max_current_depth"}
{"task_id": "Mbpp/305", "solution": "def _is_p_starting(word: str) -> bool:\n    \"\"\"Checks if a given word starts with 'p' or 'P' (case-insensitive).\"\"\"\n    return len(word) > 0 and word[0].lower() == 'p'\ndef start_withp(list_of_strings: list[str]) -> tuple[str, ...]:\n    \"\"\"\n    Identifies and returns the first two words from a list of strings that start with 'p' (case-insensitive).\n    If fewer than two are found, all found words are returned.\n    \"\"\"\n    p_words_found = []\n    for s in list_of_strings:\n        words = s.split()\n        for word in words:\n            if _is_p_starting(word):\n                p_words_found.append(word)\n                if len(p_words_found) == 2:\n                    return tuple(p_words_found)\n    return tuple(p_words_found)"}
{"task_id": "Mbpp/300", "solution": "import math\ndef count_binary_seq(n: int) -> float:\n    \"\"\"Calculates the count of all binary sequences of length 2n where the sum of the first n bits equals the sum of the last n bits.\n    This is mathematically equivalent to C(2n, n), the central binomial coefficient.\n    \"\"\"\n    result = math.comb(2 * n, n)\n    return float(result)"}
{"task_id": "Mbpp/308", "solution": "from typing import List, Union\ndef large_product(list1: List[Union[int, float]], list2: List[Union[int, float]], k: int) -> List[Union[int, float]]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n\n    def _compute_all_products(lst1: List[Union[int, float]], lst2: List[Union[int, float]]) -> List[Union[int, float]]:\n        \"\"\"Computes all possible products from pairs of elements from the two lists.\"\"\"\n        products = []\n        for x in lst1:\n            for y in lst2:\n                products.append(x * y)\n        return products\n\n    def _identify_and_sort_largest(all_products: List[Union[int, float]], num_k: int) -> List[Union[int, float]]:\n        \"\"\"Sorts products in descending order and returns the top k largest.\"\"\"\n        all_products.sort(reverse=True)\n        return all_products[:num_k]\n\n    all_products_list = _compute_all_products(list1, list2)\n    k_largest_products_sorted = _identify_and_sort_largest(all_products_list, k)\n    return k_largest_products_sorted"}
