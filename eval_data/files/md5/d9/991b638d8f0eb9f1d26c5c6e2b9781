{"task_id": "Mbpp/140", "solution": "def extract_singly(list_of_iterables: list) -> set:\n    \"\"\"\n    Flattens a list of iterables into a set of unique numeric elements.\n    It iterates through each iterable, extracts numbers, and aggregates them into a set.\n    \"\"\"\n    unique_numbers = set()\n    for iterable_item in list_of_iterables:\n        for element in iterable_item:\n            if isinstance(element, (int, float)):\n                unique_numbers.add(element)\n    return unique_numbers"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(arr: list) -> list:\n    \"\"\"\n    Sorts a list of comparable elements in ascending order using the pancake sort algorithm.\n    Returns a new sorted list.\n    \"\"\"\n    def _flip(arr: list, i: int) -> None:\n        \"\"\"\n        Reverses elements in the list from index 0 to i (inclusive) in-place.\n        \"\"\"\n        start = 0\n        while start < i:\n            arr[start], arr[i] = arr[i], arr[start]\n            start += 1\n            i -= 1\n\n    n = len(arr)\n    # Create a mutable copy of the list as the design specifies returning a new sorted list.\n    sorted_arr = list(arr)\n\n    # Iterate from the current size of the unsorted part (n) down to 1\n    for current_size in range(n, 1, -1):\n        # Find the index of the maximum element in the current unsorted sub-array\n        max_idx = 0\n        for i in range(1, current_size):\n            if sorted_arr[i] > sorted_arr[max_idx]:\n                max_idx = i\n\n        # If the maximum element is not already at its correct sorted position\n        if max_idx != current_size - 1:\n            # Step 1: Bring the maximum element to the beginning of the sub-array\n            _flip(sorted_arr, max_idx)\n            # Step 2: Bring the maximum element from the beginning to its final sorted position\n            _flip(sorted_arr, current_size - 1)\n    \n    return sorted_arr"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1, list2, list3):\n    \"\"\"\n    Counts the number of items that are identical in the same position of three given lists.\n    The comparison proceeds up to the length of the shortest list.\n    \"\"\"\n    min_length = min(len(list1), len(list2), len(list3))\n    count = 0\n    for i in range(min_length):\n        if list1[i] == list2[i] and list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a, b, n):\n    \"\"\"\n    Finds integer solutions (x, y) for the linear Diophantine equation ax + by = n.\n    Returns a tuple (x, y) if a solution exists, otherwise returns None.\n    \"\"\"\n\n    def _gcd(num1, num2):\n        \"\"\"Calculates the greatest common divisor of two integers.\"\"\"\n        while num2:\n            num1, num2 = num2, num1 % num2\n        return num1\n\n    def _extended_gcd(num1, num2):\n        \"\"\"\n        Implements the Extended Euclidean Algorithm to find x, y, g such that\n        num1*x + num2*y = g, where g is gcd(num1, num2).\n        \"\"\"\n        if num1 == 0:\n            return 0, 1, num2\n        \n        x1, y1, g = _extended_gcd(num2 % num1, num1)\n        x = y1 - (num2 // num1) * x1\n        y = x1\n        return x, y, g\n\n    g = _gcd(a, b)\n\n    # Special case: If a=0 and b=0\n    if g == 0:\n        if n == 0:\n            return (0, 0) # 0x + 0y = 0 has solution (0,0) (and infinitely many others)\n        else:\n            return None # 0x + 0y = n (for n!=0) has no solution\n            \n    # If n is not divisible by g, no integer solution exists\n    if n % g != 0:\n        return None\n\n    # Find x_0, y_0 such that a*x_0 + b*y_0 = g\n    x_egcd, y_egcd, _ = _extended_gcd(a, b)\n\n    # Scale the solution to find a particular solution for a*x + b*y = n\n    scale_factor = n // g\n    x_particular = x_egcd * scale_factor\n    y_particular = y_egcd * scale_factor\n\n    return (x_particular, y_particular)"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Calculates the sum of the series (n - 2*i) for i from 0 to n // 2.\"\"\"\n    total_sum = 0\n    # The loop iterates from i=0 up to n // 2 (inclusive)\n    for i in range(n // 2 + 1):\n        total_sum += (n - 2 * i)\n    return total_sum"}
{"task_id": "Mbpp/145", "solution": "from typing import Iterable, Union\ndef max_Abs_Diff(collection: Iterable[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the maximum absolute difference between any two elements in a given collection of numbers.\n    Returns 0 if the collection is empty or contains only one element.\n    \"\"\"\n    if not collection:\n        return 0\n\n    try:\n        min_val = min(collection)\n        max_val = max(collection)\n    except TypeError:\n        raise TypeError(\"Input collection must contain only numerical values.\")\n\n    return abs(max_val - min_val)"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string whose 1-based alphabetical position matches their 1-based string index.\n    Case-insensitive.\n    \"\"\"\n    count = 0\n    for i, char in enumerate(input_string):\n        if 'a' <= char.lower() <= 'z':\n            # Calculate 1-based alphabetical position\n            alpha_pos = ord(char.lower()) - ord('a') + 1\n            # Calculate 1-based index position\n            index_pos = i + 1\n            \n            if alpha_pos == index_pos:\n                count += 1\n    return count"}
