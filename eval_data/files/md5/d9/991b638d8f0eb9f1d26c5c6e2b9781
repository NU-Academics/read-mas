{"task_id": "Mbpp/133", "solution": "def sum_negativenum(numbers: list[int | float]) -> int | float:\n    \"\"\"\n    Calculates the sum of all negative numbers in a given list.\n    Returns 0 if the list is empty or contains no negative numbers.\n    \"\"\"\n    total_sum = 0\n    for num in numbers:\n        if num < 0:\n            total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/139", "solution": "import math\nclass Circle:\n    \"\"\"Represents a circle and calculates its circumference.\"\"\"\n    def __init__(self, radius: float):\n        if not isinstance(radius, (int, float)) or radius < 0:\n            raise ValueError(\"Radius must be a non-negative numerical value.\")\n        self._radius = float(radius)\n        self.circumference: float = 0.0\n\n    def calculate_circumference(self) -> float:\n        \"\"\"Calculates the circumference of the circle.\"\"\"\n        self.circumference = 2 * math.pi * self._radius\n        return self.circumference\ndef circle_circumference(radius: float) -> float:\n    \"\"\"Public API to calculate the circumference of a circle.\"\"\"\n    circle = Circle(radius)\n    return circle.calculate_circumference()"}
