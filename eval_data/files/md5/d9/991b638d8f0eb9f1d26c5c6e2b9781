{"task_id": "Mbpp/629", "solution": "def Split(numbers: list) -> list:\n    \"\"\"Identifies and returns even numbers from a provided list of integers.\"\"\"\n    even_numbers = []\n    for number in numbers:\n        if number % 2 == 0:\n            even_numbers.append(number)\n    return even_numbers"}
{"task_id": "Mbpp/632", "solution": "def move_zero(input_list: list) -> list:\n    \"\"\"\n    Moves all zero values in a list to the end while preserving the relative\n    order of non-zero elements.\n    \"\"\"\n    non_zeros = []\n    zeros = []\n    for item in input_list:\n        if item == 0:\n            zeros.append(item)\n        else:\n            non_zeros.append(item)\n    return non_zeros + zeros"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(coordinate_tuple: tuple[int, int]) -> list[list[int]]:\n    \"\"\"\n    Extracts all adjacent coordinates for the given coordinate tuple (x, y).\n    An adjacent coordinate (x', y') is where x' is x-1, x, or x+1,\n    and y' is y-1, y, or y+1. The given coordinate itself is included.\n    \"\"\"\n    x, y = coordinate_tuple\n    adjacent_coords = []\n    for dx in [-1, 0, 1]:\n        for dy in [-1, 0, 1]:\n            adjacent_coords.append([x + dx, y + dy])\n    return adjacent_coords"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(arr,n):\n    \"\"\"Calculates the sum of XOR of all unique pairs in the given list.\n    Args:\n        arr: A list of integers.\n        n: The number of elements in the list.\n    Returns:\n        An integer representing the total sum of pairwise XORs.\n    \"\"\"\n    total_xor_sum = 0\n    for i in range(n):\n        for j in range(i + 1, n):\n            total_xor_sum += arr[i] ^ arr[j]\n    return total_xor_sum"}
{"task_id": "Mbpp/631", "solution": "def replace_spaces(input_string: str, direction: str = 'spaces_to_underscores') -> str:\n    \"\"\"\n    Replaces specified characters (whitespaces or underscores) in an input string.\n    The replacement type is determined by the 'direction' parameter.\n    \"\"\"\n    if direction == 'spaces_to_underscores':\n        # Replace common whitespace characters with underscores\n        result = input_string.replace(' ', '_')\n        result = result.replace('\\t', '_')\n        result = result.replace('\\n', '_')\n        result = result.replace('\\r', '_') # Also handle carriage returns\n        result = result.replace('\\f', '_') # Also handle form feeds\n        result = result.replace('\\v', '_') # Also handle vertical tabs\n        return result\n    elif direction == 'underscores_to_spaces':\n        # Replace underscores with single spaces\n        return input_string.replace('_', ' ')\n    else:\n        # Raise an error for invalid direction parameter\n        raise ValueError(f\"Invalid direction: '{direction}'. Expected 'spaces_to_underscores' or 'underscores_to_spaces'.\")"}
