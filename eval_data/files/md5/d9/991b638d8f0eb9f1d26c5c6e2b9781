{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list: list, potential_sublist: list) -> bool:\n    \"\"\"\n    Checks if potential_sublist is a contiguous sublist of main_list.\n    Handles empty sublists and cases where the sublist is longer than the main list.\n    \"\"\"\n    n = len(main_list)\n    m = len(potential_sublist)\n\n    if m == 0:\n        return True  # An empty list is always considered a sublist.\n    if m > n:\n        return False  # A sublist cannot be longer than the main list.\n\n    for i in range(n - m + 1):\n        if main_list[i : i + m] == potential_sublist:\n            return True\n\n    return False"}
{"task_id": "Mbpp/572", "solution": "import collections\ndef two_unique_nums(numbers: list[int]) -> list[int]:\n    \"\"\"\n    Identifies and returns numbers that appear exactly once in the input list,\n    preserving their relative order.\n    \"\"\"\n    counts = collections.Counter(numbers)\n    result_list = []\n    for num in numbers:\n        if counts[num] == 1:\n            result_list.append(num)\n    return result_list"}
{"task_id": "Mbpp/573", "solution": "def unique_product(numbers_list: list) -> [int | float]:\n    \"\"\"\n    Calculates the product of the unique numbers in the given list.\n    Returns 1 if the list is empty or contains no unique numbers.\n    \"\"\"\n    if not numbers_list:\n        return 1\n\n    unique_numbers = set(numbers_list)\n    product = 1\n    for num in unique_numbers:\n        product *= num\n    return product"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(number: int) -> int:\n    \"\"\"\n    Calculates the last digit of the factorial of a given non-negative integer.\n    This function leverages mathematical properties to avoid full factorial calculation.\n    \"\"\"\n    if number <= 1:\n        return 1\n    elif number == 2:\n        return 2\n    elif number == 3:\n        return 6\n    elif number == 4:\n        return 4\n    else: # number >= 5\n        return 0"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Finds elements present in one tuple but not in the other.\n    Returns a new tuple containing all elements that are unique to either tuple1 or tuple2.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n\n    unique_to_tuple1 = set1 - set2\n    unique_to_tuple2 = set2 - set1\n\n    combined_unique = unique_to_tuple1 | unique_to_tuple2\n\n    return tuple(combined_unique)"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"Interleaves three input lists of the same length into a single flat list.\n    Raises ValueError if the input lists do not have the same length.\n    \"\"\"\n    if not (len(list1) == len(list2) == len(list3)):\n        raise ValueError(\"All input lists must have the same length.\")\n\n    interleaved_result = []\n    for i in range(len(list1)):\n        interleaved_result.append(list1[i])\n        interleaved_result.append(list2[i])\n        interleaved_result.append(list3[i])\n    return interleaved_result"}
{"task_id": "Mbpp/585", "solution": "def find_expensive_items(dataset: list[dict[str, any]], n: int) -> list[dict[str, any]]:\n    \"\"\"\n    Finds the 'n' most expensive items in a given dataset.\n    Returns an empty list if n is 0 or less, or if the dataset is empty.\n    \"\"\"\n    if not dataset or n <= 0:\n        return []\n\n    # Sort the dataset by 'price' in descending order\n    sorted_dataset = sorted(dataset, key=lambda item: item['price'], reverse=True)\n\n    # Return the first 'n' items from the sorted list\n    return sorted_dataset[:n]"}
{"task_id": "Mbpp/581", "solution": "def surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the total surface area of a square pyramid given its base edge and slant height.\n    The 'height' parameter is interpreted as the slant height based on the provided assertion.\n    \"\"\"\n    base_area = base_edge * base_edge\n    lateral_surface_area = 2 * base_edge * height\n    total_surface_area = base_area + lateral_surface_area\n    return total_surface_area"}
{"task_id": "Mbpp/583", "solution": "class CatalanNumberCalculator:\n    \"\"\"Calculates the nth Catalan number.\"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the nth Catalan number using an iterative formula.\"\"\"\n        if n == 0:\n            return 1\n        \n        catalan_numbers = [0] * (n + 1)\n        catalan_numbers[0] = 1\n\n        for i in range(1, n + 1):\n            catalan_numbers[i] = (catalan_numbers[i-1] * (2 * (2*i - 1))) // (i + 1)\n        \n        return catalan_numbers[n]\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Returns the nth Catalan number.\n    Delegates the computation to a CatalanNumberCalculator instance.\n    \"\"\"\n    calculator = CatalanNumberCalculator()\n    return calculator.compute(n)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(inputTuple: tuple) -> tuple:\n    \"\"\"\n    Recursively filters even integers from a nested tuple.\n    Preserves original nesting for non-empty results; empty nested tuples are excluded.\n    \"\"\"\n    current_level_results = []\n    for element in inputTuple:\n        if isinstance(element, int):\n            if element % 2 == 0:\n                current_level_results.append(element)\n        elif isinstance(element, tuple):\n            filtered_nested_tuple = extract_even(element)\n            if filtered_nested_tuple:  # Only append if not empty\n                current_level_results.append(filtered_nested_tuple)\n    return tuple(current_level_results)"}
