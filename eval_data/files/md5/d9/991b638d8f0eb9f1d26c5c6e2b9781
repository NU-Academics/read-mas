{"task_id": "Mbpp/409", "solution": "class TuplePair:\n    \"\"\"Encapsulates two numerical elements and calculates their product.\"\"\"\n    def __init__(self, element1: float, element2: float):\n        self.element1 = float(element1)\n        self.element2 = float(element2)\n\n    def get_product(self) -> float:\n        \"\"\"Calculates and returns the product of element1 and element2.\"\"\"\n        return self.element1 * self.element2\ndef min_product_tuple(data: list[tuple[float, float]]) -> float:\n    min_product = float('inf')\n    for tup in data:\n        pair = TuplePair(tup[0], tup[1])\n        product = pair.get_product()\n        if product < min_product:\n            min_product = product\n    return min_product"}
{"task_id": "Mbpp/412", "solution": "def remove_odd(input_list: list) -> list:\n    \"\"\"\n    Removes odd numbers from a list, returning a new list with only even numbers.\n    Maintains the original relative order of elements.\n    \"\"\"\n    def _is_even(number: int) -> bool:\n        \"\"\"\n        Checks if a given integer is even.\n        \"\"\"\n        return number % 2 == 0\n\n    result_list = []\n    for number in input_list:\n        if _is_even(number):\n            result_list.append(number)\n    return result_list"}
{"task_id": "Mbpp/414", "solution": "def overlapping(sequence1, sequence2):\n    \"\"\"Checks if any value in sequence1 exists in sequence2.\n    It returns True if at least one element is common, False otherwise.\"\"\"\n    set_sequence2 = set(sequence2)\n    for item in sequence1:\n        if item in set_sequence2:\n            return True\n    return False"}
{"task_id": "Mbpp/415", "solution": "def max_Product(arr: list) -> tuple:\n    \"\"\"Finds the pair of integers from `arr` with the highest product.\n    Returns a tuple (int, int) representing this pair.\"\"\"\n    max_product = float('-inf')\n    best_pair = None\n\n    # Iterate through all unique pairs of integers\n    n = len(arr)\n    for i in range(n):\n        for j in range(i + 1, n):\n            current_product = arr[i] * arr[j]\n\n            # Update max_product and best_pair if a higher product is found\n            if current_product > max_product:\n                max_product = current_product\n                best_pair = (arr[i], arr[j])\n    \n    return best_pair"}
{"task_id": "Mbpp/410", "solution": "def min_val(input_list: list):\n    \"\"\"\n    Finds the minimum numeric value in a given heterogeneous list.\n    Filters for int and float types and returns the minimum among them.\n    \"\"\"\n    numeric_elements = []\n    for item in input_list:\n        if isinstance(item, (int, float)):\n            numeric_elements.append(item)\n\n    if not numeric_elements:\n        raise ValueError(\"No numeric elements found in the list to determine a minimum.\")\n\n    return min(numeric_elements)"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(list_of_sublists):\n    \"\"\"\n    Finds the sublist with the maximum length from a list of sublists.\n    If the input list is empty, an empty list is returned.\n    \"\"\"\n    if not list_of_sublists:\n        return []\n\n    max_length_sublist = list_of_sublists[0]\n    max_length = len(list_of_sublists[0])\n\n    for sublist in list_of_sublists:\n        if len(sublist) > max_length:\n            max_length = len(sublist)\n            max_length_sublist = sublist\n\n    return max_length_sublist"}
