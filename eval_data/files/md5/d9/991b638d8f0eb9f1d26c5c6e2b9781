{"task_id": "Mbpp/2", "solution": "def similar_elements(list1, list2):\n    \"\"\"\n    Finds the common elements between two input lists and returns them as a set.\n    \"\"\"\n    set1 = set(list1)\n    set2 = set(list2)\n    return set1.intersection(set2)"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(number: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a non-prime number.\n    Returns True for non-prime numbers, False for prime numbers and numbers less than or equal to 1.\n    \"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return False\n    if number % 2 == 0:  # Even numbers greater than 2 are non-prime\n        return True\n    \n    # Check for odd divisors from 3 up to the square root of the number\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return True\n        i += 2\n            \n    return False # If no divisors found, the number is prime"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(input_string: str) -> int:\n    \"\"\"\n    Calculates the minimum positive number of rotations required for a string to return to its original state.\n    This is achieved by checking rotations of the string within a doubled version of itself.\n    \"\"\"\n    n = len(input_string)\n    \n    # Handle the specific case where all characters are the same.\n    # The problem assertion \"find_Rotations(\"aaaa\") == 1\" clarifies this.\n    if n == 0:\n        return 0 # Or raise ValueError based on design context, but the prompt says not to.\n\n    # doubled_string contains all possible rotations of input_string.\n    doubled_string = input_string + input_string\n\n    # Iterate from k=1 to n to find the smallest k such that a rotation equals the original string.\n    for k in range(1, n + 1):\n        if input_string == doubled_string[k : k + n]:\n            return k\n    \n    # This part should ideally not be reached for non-empty strings, \n    # as the string itself is always a rotation of itself (k=n).\n    return n"}
{"task_id": "Mbpp/4", "solution": "def heap_queue_largest(numbers: list[int], n: int) -> list[int]:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n    Leverages heapq.nlargest for efficient retrieval.\n    \"\"\"\n    import heapq\n\n    if not numbers:\n        return []\n\n    if n <= 0:\n        return []\n\n    if n >= len(numbers):\n        return sorted(numbers, reverse=True)\n\n    return heapq.nlargest(n, numbers)"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string, char_to_remove):\n    \"\"\"\n    Removes the first and last occurrences of a given character from the string.\n    Handles cases where the character is not found, or found only once.\n    \"\"\"\n    first_index = input_string.find(char_to_remove)\n    last_index = input_string.rfind(char_to_remove)\n\n    if first_index == -1:\n        # Character not found, return original string\n        return input_string\n    elif first_index == last_index:\n        # Character found only once\n        return input_string[:first_index] + input_string[first_index + 1:]\n    else:\n        # Character found multiple times\n        # Remove the character at last_index first\n        temp_string = input_string[:last_index] + input_string[last_index + 1:]\n        # Remove the character at first_index from the temp_string\n        return temp_string[:first_index] + temp_string[first_index + 1:]"}
{"task_id": "Mbpp/8", "solution": "def square_nums(numbers):\n    \"\"\"\n    Calculates the square of each number in the input list and returns a new list of squared numbers.\n    \"\"\"\n    squared_numbers = []\n    for num in numbers:\n        squared_numbers.append(num * num)\n    return squared_numbers"}
{"task_id": "Mbpp/6", "solution": "def _count_set_bits(n: int) -> int:\n    \"\"\"\n    Counts the number of set bits (1s) in a given integer.\n    Uses Brian Kernighan's algorithm.\n    \"\"\"\n    count = 0\n    while n > 0:\n        n &= (n - 1)\n        count += 1\n    return count\ndef differ_At_One_Bit_Pos(number1: int, number2: int) -> bool:\n    \"\"\"\n    Determines if two given integers differ by exactly one bit position.\n    This is true if their bitwise XOR result has exactly one bit set.\n    \"\"\"\n    xor_result = number1 ^ number2\n    return _count_set_bits(xor_result) == 1"}
{"task_id": "Mbpp/7", "solution": "import re\ndef _tokenize_words(text: str) -> list[str]:\n    \"\"\"Parses the input text into individual words, converting to lowercase.\n    Words are identified by sequences of alphanumeric characters.\n    \"\"\"\n    return re.findall(r'\\b\\w+\\b', text.lower())\ndef _filter_by_length(words: list[str], min_length: int) -> set[str]:\n    \"\"\"Filters a list of words, keeping only those with length >= min_length.\n    Returns a set to ensure uniqueness.\n    \"\"\"\n    return {word for word in words if len(word) >= min_length}\ndef find_char_long(text_string: str) -> set[str]:\n    \"\"\"Finds all words which are at least 4 characters long in a string.\n\n    Args:\n        text_string: The input string to process.\n    Returns:\n        A set of strings, where each string is a word from the input\n        that is 4 or more characters long.\n    \"\"\"\n    tokenized_words = _tokenize_words(text_string)\n    filtered_words = _filter_by_length(tokenized_words, 4)\n    return filtered_words"}
{"task_id": "Mbpp/12", "solution": "class Row:\n    \"\"\"Encapsulates a single row of numerical elements and provides its sum.\"\"\"\n    def __init__(self, elements):\n        self._elements = elements\n\n    def get_elements(self):\n        \"\"\"Returns the list of elements in the row.\"\"\"\n        return self._elements\n\n    def get_sum(self):\n        \"\"\"Calculates and returns the sum of the row's elements.\"\"\"\n        return sum(self._elements)\n\n    def __eq__(self, other):\n        if not isinstance(other, Row):\n            return NotImplemented\n        return self._elements == other._elements\n\n    def __repr__(self):\n        return f\"Row({self._elements})\"\nclass Matrix:\n    \"\"\"Manages a collection of Row objects and orchestrates the sorting process based on row sums.\"\"\"\n    def __init__(self, matrix_data):\n        self._rows = [Row(row_data) for row_data in matrix_data]\n\n    def sort_by_row_sum(self):\n        \"\"\"Sorts the internal _rows list in ascending order based on each Row's sum.\"\"\"\n        self._rows.sort(key=lambda row: row.get_sum())\n        return [row.get_elements() for row in self._rows]\n\n    def get_rows(self):\n        \"\"\"Returns the internal list of Row objects.\"\"\"\n        return self._rows\n\n    def __eq__(self, other):\n        if not isinstance(other, Matrix):\n            return NotImplemented\n        return self._rows == other._rows\n\n    def __repr__(self):\n        return f\"Matrix({[row.get_elements() for row in self._rows]})\"\ndef sort_matrix(matrix_data):\n    \"\"\"Sorts a given matrix in ascending order according to the sum of its rows.\"\"\"\n    matrix_obj = Matrix(matrix_data)\n    return matrix_obj.sort_by_row_sum()"}
