{"task_id": "Mbpp/603", "solution": "def get_ludic(n: int) -> list[int]:\n    \"\"\"\n    Calculates all Ludic numbers up to a given integer n using a sieving process.\n    The algorithm iteratively removes every l-th number from the remaining sequence, where l is the current Ludic number.\n    \"\"\"\n    if n < 1:\n        return []\n\n    # Initialize a list of candidate numbers from 1 to n.\n    sieve_list = list(range(1, n + 1))\n    ludic_numbers = []\n\n    # Continue as long as there are numbers in the sieve list.\n    while sieve_list:\n        # The first number in the current sieve_list is the next Ludic number.\n        current_ludic = sieve_list.pop(0)\n        ludic_numbers.append(current_ludic)\n\n        # The number 1 is a special case; it does not sieve any other numbers\n        # by position, it only removes itself from the candidates.\n        if current_ludic == 1:\n            continue\n\n        # Create a new list for the remaining candidates after sieving.\n        new_sieve_list = []\n        # Iterate through the remaining numbers in sieve_list.\n        # Enumerate with 0-based index to calculate 1-based position for sieving.\n        for i, num in enumerate(sieve_list):\n            # If the 1-based position is not a multiple of current_ludic, keep the number.\n            if (i + 1) % current_ludic != 0:\n                new_sieve_list.append(num)\n        \n        # Update the sieve_list with the numbers that were not removed.\n        sieve_list = new_sieve_list\n\n    return ludic_numbers"}
{"task_id": "Mbpp/607", "solution": "import re\ndef find_literals(text, pattern):\n    # Searches the text for the first occurrence of the regex pattern.\n    match = re.search(pattern, text)\n    if match:\n        # Returns the matched substring, its start index, and end index if a match is found.\n        return (match.group(0), match.start(), match.end())\n    else:\n        # Returns None if no match is found.\n        return None"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using a dynamic programming approach.\n    It applies the recurrence B(i+1) = sum_{k=0 to i} C(i, k) * B(k).\n    \"\"\"\n    if n == 0:\n        return 1\n\n    bell = [0] * (n + 1)\n    bell[0] = 1\n\n    def combinations(n_val, k_val):\n        \"\"\"Calculates the binomial coefficient 'n_val choose k_val'.\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n\n        res = 1\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    for i in range(n):\n        current_bell_n_plus_1 = 0\n        for k in range(i + 1):\n            current_bell_n_plus_1 += combinations(i, k) * bell[k]\n        bell[i + 1] = current_bell_n_plus_1\n\n    return bell[n]"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"Removes the k-th (1-indexed) element from a list and returns a new list.\n    The original list remains unchanged.\"\"\"\n    # Create a new list by concatenating slices before and after the k-th element.\n    # k-1 is the 0-indexed position to remove.\n    return input_list[:k-1] + input_list[k:]"}
