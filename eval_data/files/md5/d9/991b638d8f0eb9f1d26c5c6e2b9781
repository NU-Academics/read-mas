{"task_id": "Mbpp/771", "solution": "OPENING_DELIMITERS = {'(', '{', '['}\nCLOSING_DELIMITERS = {')', '}', ']'}\nDELIMITER_PAIRS = {'(': ')', '{': '}', '[': ']'}\nclass Delimiter:\n    \"\"\"Represents a single delimiter character and provides utility methods for classification and matching.\"\"\"\n    def __init__(self, character: str):\n        self._character = character\n\n    def is_opening(self) -> bool:\n        \"\"\"Returns True if the character is an opening delimiter.\"\"\"\n        return self._character in OPENING_DELIMITERS\n\n    def is_closing(self) -> bool:\n        \"\"\"Returns True if the character is a closing delimiter.\"\"\"\n        return self._character in CLOSING_DELIMITERS\n\n    def matches(self, other_delimiter: 'Delimiter') -> bool:\n        \"\"\"Returns True if this (opening) delimiter matches the given other_delimiter (closing).\"\"\"\n        return DELIMITER_PAIRS.get(self._character) == other_delimiter._character\n\n    @staticmethod\n    def get_matching_pair(opening_char: str) -> str:\n        \"\"\"Returns the corresponding closing delimiter for a given opening character.\"\"\"\n        return DELIMITER_PAIRS.get(opening_char)\nclass DelimiterStack:\n    \"\"\"Manages a LIFO collection of Delimiter objects, specifically opening delimiters.\"\"\"\n    def __init__(self):\n        self._stack = []\n\n    def push(self, delimiter: Delimiter):\n        \"\"\"Adds an opening Delimiter to the top of the stack.\"\"\"\n        self._stack.append(delimiter)\n\n    def pop(self) -> Delimiter:\n        \"\"\"Removes and returns the top Delimiter from the stack.\"\"\"\n        return self._stack.pop()\n\n    def peek(self) -> Delimiter:\n        \"\"\"Returns the top Delimiter without removing it.\"\"\"\n        return self._stack[-1]\n\n    def is_empty(self) -> bool:\n        \"\"\"Returns True if the stack contains no elements, False otherwise.\"\"\"\n        return len(self._stack) == 0\ndef check_expression(expression_string: str) -> bool:\n    \"\"\"Checks if the given expression string has balanced delimiters.\"\"\"\n    stack = DelimiterStack()\n    for char in expression_string:\n        delimiter = Delimiter(char)\n        if delimiter.is_opening():\n            stack.push(delimiter)\n        elif delimiter.is_closing():\n            if stack.is_empty():\n                return False\n            top_delimiter = stack.peek()\n            if top_delimiter.matches(delimiter):\n                stack.pop()\n            else:\n                return False\n    return stack.is_empty()"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(main_string: str, search_string: str) -> tuple[str, int, int] | None:\n    \"\"\"Finds the first occurrence and position of a substring within a main string.\n    Returns None if no match is found.\n    \"\"\"\n    start_index = main_string.find(search_string)\n    if start_index == -1:\n        return None\n    end_index = start_index + len(search_string)\n    return (search_string, start_index, end_index)"}
{"task_id": "Mbpp/775", "solution": "def odd_position(input_list: list) -> bool:\n    \"\"\"\n    Checks whether every odd index contains odd numbers of a given list.\n    Returns True if all elements at odd indices are odd numbers (or if there are no odd indices).\n    \"\"\"\n    def _is_odd(number: int) -> bool:\n        \"\"\"Checks if a given number is odd.\"\"\"\n        return number % 2 != 0\n\n    if not input_list or len(input_list) <= 1:\n        return True\n\n    for i in range(1, len(input_list), 2):\n        element = input_list[i]\n        if not _is_odd(element):\n            return False\n\n    return True"}
{"task_id": "Mbpp/777", "solution": "def find_sum(input_list):\n    \"\"\"\n    Calculates the sum of non-repeated elements in a given list.\n    An element is considered 'non-repeated' if its value appears exactly once in the list.\n    \"\"\"\n    if not input_list:\n        return 0\n\n    element_counts = {}\n    for element in input_list:\n        element_counts[element] = element_counts.get(element, 0) + 1\n\n    total_sum = 0\n    for element, count in element_counts.items():\n        if count == 1:\n            total_sum += element\n\n    return total_sum"}
{"task_id": "Mbpp/781", "solution": "def _get_divisors(number: int) -> list[int]:\n    \"\"\"\n    Identifies all positive integer divisors for a given positive integer. This function is an internal helper.\n    \"\"\"\n    divisors = []\n    for i in range(1, int(number**0.5) + 1):\n        if number % i == 0:\n            divisors.append(i)\n            if i * i != number:\n                divisors.append(number // i)\n    return sorted(divisors)\ndef count_divisors(number: int) -> bool:\n    \"\"\"\n    Checks whether the count of positive divisors for a given positive integer is even. It identifies and counts all divisors, then checks if the total count is an even number.\n    \"\"\"\n    divisors = _get_divisors(number)\n    return len(divisors) % 2 == 0"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(input_list: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    \"\"\"\n    Finds combinations of sums with tuples in the given tuple list.\n    It generates all unique pairs of tuples and computes their element-wise sums.\n    \"\"\"\n    results = []\n    n = len(input_list)\n    for i in range(n):\n        for j in range(i + 1, n):\n            tuple1 = input_list[i]\n            tuple2 = input_list[j]\n            sum_tuple = (tuple1[0] + tuple2[0], tuple1[1] + tuple2[1])\n            results.append(sum_tuple)\n    return results"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list[list]:\n    \"\"\"Packs consecutive duplicates of a given list elements into sublists.\n\n    Args:\n        input_list: The list of elements to process.\n\n    Returns:\n        A new list where consecutive identical elements are grouped into sublists.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = []\n    current_sublist = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_sublist[-1]:\n            current_sublist.append(input_list[i])\n        else:\n            result.append(current_sublist)\n            current_sublist = [input_list[i]]\n    \n    result.append(current_sublist)\n    return result"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"Calculates the sum of all odd-length subarrays from the input array.\"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        for j in range(i, n):\n            subarray_length = j - i + 1\n            if subarray_length % 2 == 1:\n                # Sum the elements of the current odd-length subarray\n                for k in range(i, j + 1):\n                    total_sum += arr[k]\n    return total_sum"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list: list, value) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in sorted order.\n    Returns the index where the value should be inserted to maintain sorted order,\n    inserting after any existing equal elements.\n    \"\"\"\n    for i, x in enumerate(sorted_list):\n        if x > value:\n            return i\n    return len(sorted_list)"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_string: str) -> tuple[int, ...]:\n    \"\"\"\n    Converts a string representation of an integer tuple (e.g., \"(7, 8, 9)\")\n    into a native Python integer tuple (e.g., (7, 8, 9)).\n    \"\"\"\n    if not (tuple_string.startswith('(') and tuple_string.endswith(')')):\n        raise ValueError(\"Input string must be enclosed in parentheses.\")\n\n    content = tuple_string[1:-1]\n    if not content.strip():\n        return ()\n\n    elements_str = [s.strip() for s in content.split(',')]\n\n    converted_elements = []\n    for s in elements_str:\n        try:\n            converted_elements.append(int(s))\n        except ValueError:\n            raise ValueError(f\"Element '{s}' is not a valid integer.\")\n\n    return tuple(converted_elements)"}
{"task_id": "Mbpp/784", "solution": "def is_even(number: int) -> bool:\n    \"\"\"Determines if a given integer is an even number.\"\"\"\n    return number % 2 == 0\ndef is_odd(number: int) -> bool:\n    \"\"\"Determines if a given integer is an odd number.\"\"\"\n    return number % 2 != 0\ndef mul_even_odd(numbers: list[int]) -> int | None:\n    \"\"\"\n    Finds the product of the first even and first odd number of a given list.\n    Returns None if either is not found.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for number in numbers:\n        if first_odd is None and is_odd(number):\n            first_odd = number\n        \n        if first_even is None and is_even(number):\n            first_even = number\n        \n        if first_even is not None and first_odd is not None:\n            break\n            \n    if first_even is not None and first_odd is not None:\n        return first_even * first_odd\n    else:\n        return None"}
{"task_id": "Mbpp/787", "solution": "def text_match_three(input_string):\n    \"\"\"\n    Checks if the input string contains the pattern 'abbb'.\n    \"\"\"\n    import re\n    pattern = r\"abbb\"\n    return bool(re.search(pattern, input_string))"}
{"task_id": "Mbpp/793", "solution": "def last(array, element):\n    \"\"\"\n    Finds the last position of an element in a sorted array.\n    Returns the index of the last occurrence, or -1 if not found.\n    \"\"\"\n    last_index = -1\n    for i in range(len(array)):\n        if array[i] == element:\n            last_index = i\n        elif array[i] > element: # Optimization for sorted arrays\n            break\n    return last_index"}
{"task_id": "Mbpp/794", "solution": "import re\ndef text_starta_endb(input_string: str) -> bool:\n    \"\"\"Checks if a string starts with 'a', is followed by anything, and ends with 'b' using regex.\"\"\"\n    return re.fullmatch(r\"a.*b\", input_string) is not None"}
{"task_id": "Mbpp/791", "solution": "def remove_nested(input_tuple: tuple) -> tuple:\n    \"\"\"Filters an input tuple, returning a new tuple with any direct nested tuples removed.\"\"\"\n    result = []\n    for item in input_tuple:\n        if not isinstance(item, tuple):\n            result.append(item)\n    return tuple(result)"}
{"task_id": "Mbpp/790", "solution": "def even_position(data_list: list) -> bool:\n    \"\"\"\n    Determines if every even index in the input list contains an even number.\n    Returns True if all numbers at even indices are even, False otherwise.\n    \"\"\"\n    def is_even(number: int) -> bool:\n        \"\"\"Checks if a given integer is an even number.\"\"\"\n        return number % 2 == 0\n\n    def is_even_index(index: int) -> bool:\n        \"\"\"Checks if a given integer index is even.\"\"\"\n        return index % 2 == 0\n\n    for i, num in enumerate(data_list):\n        if is_even_index(i):\n            if not is_even(num):\n                return False\n    return True"}
{"task_id": "Mbpp/788", "solution": "def new_tuple(input_list: list, input_string: str) -> tuple:\n    \"\"\"\n    Creates a new tuple from the given list and string.\n    The new tuple will contain all elements from input_list, followed by input_string.\n    \"\"\"\n    return tuple(input_list) + (input_string,)"}
{"task_id": "Mbpp/792", "solution": "def count_list(collection: list) -> int:\n    \"\"\"Counts the number of direct sub-lists within a given collection.\n    It iterates through the collection and checks the type of each element.\n    \"\"\"\n    count = 0\n    for element in collection:\n        if isinstance(element, list):\n            count += 1\n    return count"}
{"task_id": "Mbpp/796", "solution": "def return_sum(input_dict: dict) -> int:\n    \"\"\"\n    Calculates the sum of all numeric values present in the input dictionary.\n    \"\"\"\n    total_sum = 0\n    for value in input_dict.values():\n        total_sum += value\n    return total_sum"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l: int, r: int) -> int:\n    \"\"\"Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Returns 0 if l is greater than r.\n    \"\"\"\n    if l > r:\n        return 0\n\n    total_sum = 0\n    # Natural numbers are positive integers, so the effective lower bound is at least 1.\n    start = max(1, l)\n\n    # Iterate through each number in the inclusive range [start, r].\n    for num in range(start, r + 1):\n        # Add the number to total_sum if it is odd.\n        if num % 2 != 0:\n            total_sum += num\n\n    return total_sum"}
