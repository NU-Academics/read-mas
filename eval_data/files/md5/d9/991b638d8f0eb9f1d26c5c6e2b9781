{"task_id": "Mbpp/441", "solution": "def surfacearea_cube(side_length: float) -> float:\n    \"\"\"Calculates the surface area of a cube given its side length.\"\"\"\n    class Cube:\n        \"\"\"Represents a cube and encapsulates its surface area calculation logic.\"\"\"\n        def __init__(self, side_length: float):\n            self._side_length = side_length\n\n        def calculate_surface_area(self) -> float:\n            \"\"\"Computes and returns the surface area of the cube.\"\"\"\n            return 6 * (self._side_length ** 2)\n\n    cube_instance = Cube(side_length)\n    return cube_instance.calculate_surface_area()"}
{"task_id": "Mbpp/440", "solution": "import string\nimport re\nfrom typing import Optional, Tuple, List\ndef _clean_punctuation(word: str) -> str:\n    \"\"\"Removes leading and trailing punctuation from a given word string.\"\"\"\n    return word.strip(string.punctuation)\ndef _is_adverb_lexical(cleaned_word: str) -> bool:\n    \"\"\"Determines if a given cleaned word is an adverb based on lexical properties.\"\"\"\n    return cleaned_word.lower().endswith(\"ly\")\nclass AdverbPositionResult:\n    \"\"\"A data structure to hold the result of finding an adverb.\"\"\"\n    def __init__(self, start_index: int, end_index: int, adverb_text: str):\n        self.start_index = start_index\n        self.end_index = end_index\n        self.adverb_text = adverb_text\nclass Word:\n    \"\"\"Represents a single word token from a sentence, manages its forms, and determines if it is an adverb.\"\"\"\n    def __init__(self, original_text: str, start_index: int, end_index: int):\n        self.original_text = original_text\n        self.start_index = start_index\n        self.end_index = end_index\n        self._cleaned_text: Optional[str] = None\n        self._is_adverb_flag: Optional[bool] = None\n\n    def get_cleaned_text(self) -> str:\n        \"\"\"Returns the punctuation-cleaned text of the word.\"\"\"\n        if self._cleaned_text is None:\n            self._cleaned_text = _clean_punctuation(self.original_text)\n        return self._cleaned_text\n\n    def is_adverb(self) -> bool:\n        \"\"\"Determines if the cleaned word is an adverb.\"\"\"\n        if self._is_adverb_flag is None:\n            self._is_adverb_flag = _is_adverb_lexical(self.get_cleaned_text())\n        return self._is_adverb_flag\nclass Sentence:\n    \"\"\"Represents a sentence and provides methods to tokenize it into words.\"\"\"\n    def __init__(self, text: str):\n        self._text = text\n        self._words: List[Word] = []\n        # Tokenize the sentence into words, preserving original positions.\n        for match in re.finditer(r'\\S+', self._text):\n            original_word_text = match.group(0)\n            start = match.start()\n            end = match.end()\n            self._words.append(Word(original_word_text, start, end))\n\n    def get_words(self) -> List[Word]:\n        \"\"\"Returns the list of tokenized Word objects.\"\"\"\n        return self._words\ndef find_adverb_position(sentence_text: str) -> Optional[Tuple[int, int, str]]:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Returns (start_index, end_index, adverb_text) or None if not found.\n    \"\"\"\n    sentence_obj = Sentence(sentence_text)\n    for word_obj in sentence_obj.get_words():\n        if word_obj.is_adverb():\n            cleaned_text = word_obj.get_cleaned_text()\n            \n            # Calculate the actual start and end indices of the cleaned adverb\n            # within the original sentence, considering removed leading punctuation.\n            leading_punct_count = len(word_obj.original_text) - len(word_obj.original_text.lstrip(string.punctuation))\n            \n            actual_start_index = word_obj.start_index + leading_punct_count\n            actual_end_index = actual_start_index + len(cleaned_text)\n\n            result = AdverbPositionResult(\n                actual_start_index,\n                actual_end_index,\n                cleaned_text\n            )\n            return (result.start_index, result.end_index, result.adverb_text)\n    return None"}
{"task_id": "Mbpp/448", "solution": "def cal_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) to P(n).\n    Uses a memoized iterative approach for efficiency.\n    \"\"\"\n    # Cache for Perrin numbers, initialized with base cases P(0)=3, P(1)=0, P(2)=2.\n    # This list will be extended as new Perrin numbers are calculated.\n    perrin_numbers_cache = [3, 0, 2]\n\n    def _calculate_perrin_number(index: int) -> int:\n        \"\"\"\n        Computes the Perrin number for a given index using memoization.\n        It recursively calculates and stores values in the shared cache.\n        \"\"\"\n        if index < len(perrin_numbers_cache):\n            return perrin_numbers_cache[index]\n        \n        # Recursively compute P(index) and store it in the cache.\n        val = _calculate_perrin_number(index - 2) + _calculate_perrin_number(index - 3)\n        perrin_numbers_cache.append(val)\n        return val\n\n    total_sum = 0\n    # Iterate from 0 up to n (inclusive) to calculate and sum each Perrin number.\n    for i in range(n + 1):\n        total_sum += _calculate_perrin_number(i)\n    \n    return total_sum"}
