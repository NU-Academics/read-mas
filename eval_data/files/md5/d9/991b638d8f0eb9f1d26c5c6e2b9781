{"task_id": "Mbpp/799", "solution": "def left_rotate(number: int, d: int) -> int:\n    \"\"\"Rotates the bits of a 32-bit integer 'number' left by 'd' positions.\"\"\"\n    BIT_LENGTH = 32\n    d %= BIT_LENGTH  # Normalize rotation amount to be within 0 to BIT_LENGTH-1\n    # Perform left shift and wrap-around, then mask to ensure a 32-bit result\n    return ((number << d) | (number >> (BIT_LENGTH - d))) & 0xFFFFFFFF"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(int1, int2, int3):\n    \"\"\"Counts the number of equal integers among three given integers.\"\"\"\n    numbers = [int1, int2, int3]\n    unique_numbers = set(numbers)\n\n    if len(unique_numbers) == 1:\n        return 3\n    elif len(unique_numbers) == 2:\n        return 2\n    else:\n        return 1"}
{"task_id": "Mbpp/803", "solution": "def is_perfect_square(number: 'Numeric') -> bool:\n    \"\"\"\n    Determines if the given number is a perfect square.\n    It must be non-negative, and its square root must be an integer.\n    \"\"\"\n    if number < 0:\n        return False\n\n    if number == 0 or number == 1:\n        return True\n\n    # If it's a float that is not an integer (e.g., 2.25), it cannot be a perfect square.\n    if not isinstance(number, int) and not number.is_integer():\n        return False\n\n    # Convert to integer to avoid floating point inaccuracies with square root.\n    num_int = int(number)\n\n    # Calculate the integer square root.\n    sqrt_num = int(num_int**0.5)\n\n    # Check if squaring the integer square root yields the original integer.\n    return sqrt_num * sqrt_num == num_int"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers: list[int]) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    The product is even if any number in the list is even or zero.\n    \"\"\"\n    for number in numbers:\n        if number % 2 == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/805", "solution": "def _calculate_list_sum(numeric_list: list) -> int:\n    \"\"\"Calculates the sum of elements for a given list of numbers.\n    Handles empty lists by returning 0.\"\"\"\n    return sum(numeric_list)\ndef max_sum_list(list_of_lists: list) -> list:\n    \"\"\"Returns the list in a list of lists whose sum of elements is the highest.\n    Returns an empty list if the input list_of_lists is empty.\"\"\"\n    if not list_of_lists:\n        return []\n\n    max_sum = float('-inf')\n    max_list = []\n\n    for inner_list in list_of_lists:\n        current_sum = _calculate_list_sum(inner_list)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            max_list = inner_list\n\n    return max_list"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Calculates the maximum length of consecutive uppercase characters in the given string.\n    Returns 0 if the string is empty or contains no uppercase characters.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n\n    for char in input_string:\n        if 'A' <= char <= 'Z':\n            current_run += 1\n        else:\n            current_run = 0\n        max_run = max(max_run, current_run)\n\n    return max_run"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers):\n    \"\"\"\n    Finds the first odd number in a given list of numbers.\n    Raises ValueError if no odd numbers are found in the list.\n    \"\"\"\n    for number in numbers:\n        if number % 2 != 0:\n            return number\n    raise ValueError(\"No odd number found in the list.\")"}
