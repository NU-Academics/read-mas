{"task_id": "Mbpp/463", "solution": "def max_subarray_product(arr: list[int]) -> int:\n    \"\"\"Calculates the maximum product of a contiguous subarray.\n    It tracks the maximum and minimum product ending at the current position to handle negative numbers effectively.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_so_far = arr[0]\n    min_so_far = arr[0]\n    result = arr[0]\n\n    for i in range(1, len(arr)):\n        num = arr[i]\n\n        # We need to store max_so_far because its value will be updated,\n        # but min_so_far's calculation also depends on the *previous* max_so_far.\n        temp_max = max_so_far\n\n        max_so_far = max(num, num * temp_max, num * min_so_far)\n        min_so_far = min(num, num * temp_max, num * min_so_far)\n\n        result = max(result, max_so_far)\n\n    return result"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(arr: list[int], n: int) -> int:\n    \"\"\"Calculates the product of all integers in 'arr' modulo 'n'.\n    This function prevents integer overflow by applying the modulo operation in each step.\n    \"\"\"\n    product = 1\n    for element in arr:\n        product = (product * element) % n\n    return product"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(input_list: list) -> bool:\n    \"\"\"\n    Checks if the given list of numbers contains consecutive integers after removing duplicates and sorting.\n    An empty list or a list with one unique element is considered consecutive.\n    \"\"\"\n    unique_elements = sorted(list(set(input_list)))\n\n    if len(unique_elements) <= 1:\n        return True\n\n    for i in range(1, len(unique_elements)):\n        if unique_elements[i] != unique_elements[i-1] + 1:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/468", "solution": "def _calculate_subsequence_product(subsequence: list[int]) -> int:\n    \"\"\"Calculates the product of all numbers within a single increasing subsequence.\"\"\"\n    product = 1\n    for num in subsequence:\n        product *= num\n    return product\ndef _find_all_increasing_subsequences(arr: list[int]) -> list[list[int]]:\n    \"\"\"Generates all possible increasing subsequences from a given array.\"\"\"\n    if not arr:\n        return []\n\n    n = len(arr)\n    # dp[i] will store a list of all increasing subsequences ending with arr[i].\n    all_is_ending_at = [[] for _ in range(n)]\n\n    for i in range(n):\n        # The element itself forms an increasing subsequence of length 1.\n        all_is_ending_at[i].append([arr[i]])\n\n        # Extend subsequences ending at previous indices j if arr[i] is greater than arr[j].\n        for j in range(i):\n            if arr[i] > arr[j]:\n                for sub in all_is_ending_at[j]:\n                    all_is_ending_at[i].append(sub + [arr[i]])\n\n    # Flatten the list of lists of subsequences into a single list.\n    all_subsequences = []\n    for subsequences_at_i in all_is_ending_at:\n        all_subsequences.extend(subsequences_at_i)\n\n    return all_subsequences\ndef max_product(array: list[int]) -> int:\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence of that array.\n    \"\"\"\n    if not array:\n        return 0\n\n    # Handles single-element arrays as specified in the design context.\n    if len(array) == 1:\n        return array[0]\n\n    all_increasing_subsequences = _find_all_increasing_subsequences(array)\n\n    # Initialize max_prod with negative infinity to correctly handle all possible product values, including negative.\n    max_prod = float('-inf')\n\n    for sub in all_increasing_subsequences:\n        current_product = _calculate_subsequence_product(sub)\n        if current_product > max_prod:\n            max_prod = current_product\n            \n    return int(max_prod)"}
