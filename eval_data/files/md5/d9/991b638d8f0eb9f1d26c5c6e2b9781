{"task_id": "Mbpp/473", "solution": "class Tuple:\n    \"\"\"\n    Represents a 2-element tuple and provides a normalized, order-independent form for comparison.\n    \"\"\"\n    def __init__(self, t: tuple):\n        self._elements = t\n        self._normalized_form = frozenset(t)\n\n    def get_normalized_form(self) -> frozenset:\n        \"\"\"\n        Returns a frozenset of the tuple's elements for order-independent comparison and hashing.\n        \"\"\"\n        return self._normalized_form\n\n    def __eq__(self, other) -> bool:\n        \"\"\"\n        Compares two Tuple objects based on their normalized forms.\n        \"\"\"\n        if not isinstance(other, Tuple):\n            return NotImplemented\n        return self.get_normalized_form() == other.get_normalized_form()\n\n    def __hash__(self) -> int:\n        \"\"\"\n        Computes a hash for the Tuple object based on its normalized form.\n        \"\"\"\n        return hash(self.get_normalized_form())\n\n    def to_original_tuple(self) -> tuple:\n        \"\"\"\n        Returns the original tuple representation.\n        \"\"\"\n        return self._elements\nclass TupleList:\n    \"\"\"\n    Manages a collection of Tuple objects and provides a set of their normalized forms.\n    It also maintains a map from normalized forms to the first encountered original tuple.\n    \"\"\"\n    def __init__(self, raw_tuples: list[tuple]):\n        self._tuples: list[Tuple] = []\n        self._normalized_tuple_set: set[frozenset] = set()\n        self._normalized_to_original_map: dict[frozenset, tuple] = {}\n\n        for raw_tuple in raw_tuples:\n            tuple_obj = Tuple(raw_tuple)\n            self._tuples.append(tuple_obj)\n            normalized_form = tuple_obj.get_normalized_form()\n            self._normalized_tuple_set.add(normalized_form)\n            if normalized_form not in self._normalized_to_original_map:\n                self._normalized_to_original_map[normalized_form] = raw_tuple\n\n    def get_normalized_tuple_set(self) -> set[frozenset]:\n        \"\"\"\n        Returns a set containing the normalized forms of all Tuple objects in the list.\n        \"\"\"\n        return self._normalized_tuple_set\n\n    def get_tuples(self) -> list[Tuple]:\n        \"\"\"\n        Returns the internal list of Tuple objects.\n        \"\"\"\n        return self._tuples\n\n    def get_original_tuple_for_normalized_form(self, normalized_form: frozenset) -> tuple | None:\n        \"\"\"\n        Returns the original tuple associated with a given normalized form from this list.\n        \"\"\"\n        return self._normalized_to_original_map.get(normalized_form)\nclass TupleIntersectionService:\n    \"\"\"\n    Encapsulates the core business logic for finding the intersection between two TupleList instances.\n    \"\"\"\n    def find_intersection(self, list1: TupleList, list2: TupleList) -> set[tuple]:\n        \"\"\"\n        Computes the intersection of two TupleList objects, returning a set of original 2-element tuples.\n        \"\"\"\n        normalized_set1 = list1.get_normalized_tuple_set()\n        normalized_set2 = list2.get_normalized_tuple_set()\n\n        intersection_normalized_forms = normalized_set1.intersection(normalized_set2)\n\n        result_raw_tuples: set[tuple] = set()\n        for normalized_form in intersection_normalized_forms:\n            original_tuple = list1.get_original_tuple_for_normalized_form(normalized_form)\n            if original_tuple:\n                result_raw_tuples.add(original_tuple)\n            else:\n                original_tuple = list2.get_original_tuple_for_normalized_form(normalized_form)\n                if original_tuple: # This case ensures robustness, though unlikely given how intersection works.\n                    result_raw_tuples.add(original_tuple)\n        \n        return result_raw_tuples\ndef tuple_intersection(list1: list[tuple], list2: list[tuple]) -> set[tuple]:\n    \"\"\"\n    Finds the tuple intersection of elements in the given tuple lists, irrespective of their order.\n    \"\"\"\n    list1_domain_object = TupleList(list1)\n    list2_domain_object = TupleList(list2)\n\n    service = TupleIntersectionService()\n\n    return service.find_intersection(list1_domain_object, list2_domain_object)"}
