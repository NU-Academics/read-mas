{"task_id": "Mbpp/125", "solution": "def find_length(binary_string_value: str) -> int:\n    # This function finds the maximum difference between the number of 0s and 1s\n    # in any substring of the given binary string, following the design's brute-force approach.\n    \n    n = len(binary_string_value)\n    \n    # Handle the empty string case where no substrings exist.\n    if n == 0:\n        return 0\n\n    # Initialize max_diff with the difference of the first single-character substring.\n    # This ensures correct handling if all possible differences are negative.\n    max_diff = 1 if binary_string_value[0] == '0' else -1\n    \n    # Iterate through all possible start indices for substrings.\n    for i in range(n):\n        # Iterate through all possible end indices for current start index.\n        for j in range(i, n):\n            # Extract the current substring and calculate its difference.\n            substring = binary_string_value[i : j + 1]\n            current_diff = substring.count('0') - substring.count('1')\n            \n            # Update the maximum difference found so far.\n            if current_diff > max_diff:\n                max_diff = current_diff\n                \n    return max_diff"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"\n    Determines if a given matrix is a magic square by validating its shape and comparing various sums.\n    \"\"\"\n\n    def _is_square(matrix: list[list[int]]) -> bool:\n        \"\"\"Verifies if the input matrix has an equal number of rows and columns.\"\"\"\n        if not matrix:\n            return False\n        n_rows = len(matrix)\n        n_cols = len(matrix[0])\n        if n_rows != n_cols:\n            return False\n        return all(len(row) == n_rows for row in matrix)\n\n    def _calculate_row_sums(matrix: list[list[int]]) -> list[int]:\n        \"\"\"Calculates the sum of elements for each row of the matrix.\"\"\"\n        return [sum(row) for row in matrix]\n\n    def _calculate_column_sums(matrix: list[list[int]]) -> list[int]:\n        \"\"\"Calculates the sum of elements for each column of the matrix.\"\"\"\n        n = len(matrix)\n        column_sums = [0] * n\n        for i in range(n):\n            for j in range(n):\n                column_sums[j] += matrix[i][j]\n        return column_sums\n\n    def _calculate_main_diagonal_sum(matrix: list[list[int]]) -> int:\n        \"\"\"Calculates the sum of elements along the main diagonal of the matrix.\"\"\"\n        n = len(matrix)\n        main_diag_sum = 0\n        for i in range(n):\n            main_diag_sum += matrix[i][i]\n        return main_diag_sum\n\n    def _calculate_anti_diagonal_sum(matrix: list[list[int]]) -> int:\n        \"\"\"Calculates the sum of elements along the anti-diagonal of the matrix.\"\"\"\n        n = len(matrix)\n        anti_diag_sum = 0\n        for i in range(n):\n            anti_diag_sum += matrix[i][n - 1 - i]\n        return anti_diag_sum\n\n    def _are_all_sums_equal(sums: list[int]) -> bool:\n        \"\"\"Compares a list of sums to determine if all values are identical.\"\"\"\n        if not sums:\n            return True # An empty list of sums means nothing to compare, so trivially equal\n        first_sum = sums[0]\n        return all(s == first_sum for s in sums)\n\n    if not _is_square(matrix):\n        return False\n\n    row_sums = _calculate_row_sums(matrix)\n    column_sums = _calculate_column_sums(matrix)\n    main_diagonal_sum = _calculate_main_diagonal_sum(matrix)\n    anti_diagonal_sum = _calculate_anti_diagonal_sum(matrix)\n\n    all_sums = row_sums + column_sums + [main_diagonal_sum, anti_diagonal_sum]\n\n    return _are_all_sums_equal(all_sums)"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(input_list: list) -> any:\n    \"\"\"\n    Finds the item with the maximum frequency in the given list.\n    If the list is empty, returns None.\n    If multiple items share the same maximum frequency, returns the first one encountered.\n    \"\"\"\n    if not input_list:\n        return None\n\n    frequency_map = {}\n    for item in input_list:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n\n    max_item = None\n    max_frequency = -1\n\n    # Iterate through the frequency map to find the item with the highest frequency.\n    # The first item encountered with the max frequency will be selected as per BR4.\n    for item, freq in frequency_map.items():\n        if freq > max_frequency:\n            max_frequency = freq\n            max_item = item\n\n    return max_item"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    # Converts the input string into a list of characters for mutability.\n    char_list = list(s)\n    \n    # Stores the characters that are vowels.\n    vowels_found = []\n    \n    # Stores the original indices of the vowels found in the string.\n    vowel_indices = []\n\n    # Defines the set of vowels (case-insensitive) for efficient lookup.\n    _VOWELS_SET = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    # Helper function to check if a character is a vowel.\n    def _is_vowel(char: str) -> bool:\n        return char in _VOWELS_SET\n\n    # Iterate through the string to identify and store vowels and their indices.\n    for i, char in enumerate(char_list):\n        if _is_vowel(char):\n            vowels_found.append(char)\n            vowel_indices.append(i)\n    \n    # Reverse the list of found vowels.\n    vowels_found.reverse()\n    \n    # Replace the characters at vowel_indices with the reversed vowels.\n    for i, index in enumerate(vowel_indices):\n        char_list[index] = vowels_found[i]\n            \n    # Join the list of characters back into a string and return it.\n    return \"\".join(char_list)"}
