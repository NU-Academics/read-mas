{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(int1, int2):\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers,\n    conceptually padding the shorter number with leading zeros.\n    \"\"\"\n    str1 = str(int1)\n    str2 = str(int2)\n\n    max_len = max(len(str1), len(str2))\n\n    padded_str1 = str1.zfill(max_len)\n    padded_str2 = str2.zfill(max_len)\n\n    total_sum = 0\n    for i in range(max_len):\n        digit1 = int(padded_str1[i])\n        digit2 = int(padded_str2[i])\n        total_sum += abs(digit1 - digit2)\n\n    return total_sum"}
{"task_id": "Mbpp/560", "solution": "def union_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Finds the union of elements from two tuples and returns them in sorted order as a new tuple.\n    \"\"\"\n    combined_set = set(tuple1).union(set(tuple2))\n    sorted_elements = sorted(list(combined_set))\n    return tuple(sorted_elements)"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(numbers: list[int], n: int) -> int:\n    \"\"\"\n    Counts pairs of distinct elements from a list whose bitwise XOR is an odd number.\n    An XOR is odd if one number is odd and the other is even.\n    \"\"\"\n    odd_count = 0\n    even_count = 0\n\n    for num in numbers:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return odd_count * even_count"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr: list[int], n: int) -> int:\n    \"\"\"\n    Calculates the maximum sum of a contiguous sublist in the given list using Kadane's algorithm.\n    This function handles empty lists and parameter mismatches by raising ValueError.\n    \"\"\"\n    if not arr:\n        raise ValueError(\"Input list cannot be empty.\")\n    if n != len(arr):\n        raise ValueError(\"Parameter 'n' must match the length of 'arr'.\")\n\n    current_max = arr[0]\n    global_max = arr[0]\n\n    for i in range(1, n):\n        current_max = max(arr[i], current_max + arr[i])\n        global_max = max(global_max, current_max)\n\n    return global_max"}
