{"task_id": "Mbpp/749", "solution": "def sort_numeric_strings(string_list: list[str]) -> list[int]:\n    \"\"\"Sorts a list of strings representing numbers numerically, returning a list of integers.\"\"\"\n    try:\n        numerical_list = [int(s) for s in string_list]\n    except ValueError as e:\n        raise ValueError(f\"Input list contains non-numeric string: {e}\") from e\n\n    sorted_numerical_list = sorted(numerical_list)\n\n    return sorted_numerical_list"}
{"task_id": "Mbpp/752", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to the Jacobsthal number calculation.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number.\n    Raises InvalidInputError if n is a negative integer.\n    \"\"\"\n    if n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    # Iterative calculation for n > 1\n    a, b = 0, 1  # J(0), J(1)\n    for _ in range(2, n + 1):\n        a, b = b, a + 2 * b\n    return a"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list[int | float]) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    Iterates through non-leaf nodes and verifies the min-heap property against their children.\n    \"\"\"\n    n = len(arr)\n    # An empty array or an array with a single element is considered a valid min-heap.\n    if n <= 1:\n        return True\n\n    # Iterate through all non-leaf nodes.\n    # In a 0-indexed array, the parent nodes are from index 0 to (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/754", "solution": "from typing import List, Any\ndef extract_index_list(list1: List[Any], list2: List[Any], list3: List[Any]) -> List[Any]:\n    \"\"\"\n    Identifies elements that appear in all three input lists at the same index.\n\n    Compares elements at corresponding indices across three lists up to the length\n    of the shortest list.\n    \"\"\"\n    common_elements = []\n    min_length = min(len(list1), len(list2), len(list3))\n\n    for i in range(min_length):\n        if list1[i] == list2[i] and list2[i] == list3[i]:\n            common_elements.append(list1[i])\n    return common_elements"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers):\n    \"\"\"\n    Finds the second smallest distinct number in a list.\n\n    Returns the second smallest distinct number, or None if there are fewer\n    than two distinct numbers in the list.\n    \"\"\"\n    unique_numbers = sorted(list(set(numbers)))\n    if len(unique_numbers) >= 2:\n        return unique_numbers[1]\n    return None"}
