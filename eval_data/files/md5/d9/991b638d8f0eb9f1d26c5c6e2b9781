{"task_id": "Mbpp/91", "solution": "def find_substring(list_of_strings: list[str], substring_to_find: str) -> bool:\n    \"\"\"\n    Checks if a given substring is present within any string in a provided list.\n    The search is case-sensitive.\n    \"\"\"\n    if not list_of_strings and not substring_to_find:\n        return True # Consistent with an empty string being a substring of everything, even an empty string from an empty list perspective\n    if not list_of_strings:\n        return False\n    if not substring_to_find:\n        return True\n\n    for s in list_of_strings:\n        if substring_to_find in s:\n            return True\n    return False"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is undulating, meaning its digits alternate between two distinct values.\n    Returns True if undulating, False otherwise.\n    \"\"\"\n    s = str(number)\n    n = len(s)\n\n    if n < 3:\n        return False\n\n    if s[0] == s[1]:\n        return False\n\n    d1 = s[0]\n    d2 = s[1]\n\n    for i in range(2, n):\n        if i % 2 == 0:  # Even index, should match the first digit\n            if s[i] != d1:\n                return False\n        else:  # Odd index, should match the second digit\n            if s[i] != d2:\n                return False\n\n    return True"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"Calculates the number of positive divisors for a given integer.\"\"\"\n    count = 0\n    for i in range(1, n + 1):\n        if n % i == 0:\n            count += 1\n    return count"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(list_of_tuples: list):\n    min_second_value = float('inf')\n    result_first_value = None\n\n    for current_tuple in list_of_tuples:\n        first_value = current_tuple[0]\n        second_value = current_tuple[1]\n\n        if second_value < min_second_value:\n            min_second_value = second_value\n            result_first_value = first_value\n        # If second_value is equal to min_second_value, the existing result_first_value\n        # is kept, adhering to the tie-breaking rule of selecting the earliest tuple.\n\n    return result_first_value"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists: list) -> int:\n    \"\"\"\n    Finds the length of the smallest list within a list of lists.\n    Returns 0 if the input list of lists is empty.\n    \"\"\"\n    if not list_of_lists:\n        return 0\n    \n    return min(len(inner_list) for inner_list in list_of_lists)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal integer to its binary string representation.\n    Ensures no leading zeros, except when the input is 0, which returns '0'.\n    \"\"\"\n    if decimal_number == 0:\n        return '0'\n\n    binary_string_parts = []\n    temp_number = decimal_number\n    while temp_number > 0:\n        remainder = temp_number % 2\n        binary_string_parts.append(str(remainder))\n        temp_number //= 2\n\n    return \"\".join(reversed(binary_string_parts))"}
{"task_id": "Mbpp/97", "solution": "from typing import Any, List, Dict\ndef frequency_lists(nested_list: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n    Returns a dictionary where keys are unique elements and values are their frequencies.\n    \"\"\"\n    if not isinstance(nested_list, list) or not all(isinstance(sublist, list) for sublist in nested_list):\n        raise TypeError(\"Input must be a list of lists.\")\n\n    if not nested_list or all(not sublist for sublist in nested_list):\n        return {}\n\n    flattened_sequence = []\n    for sublist in nested_list:\n        flattened_sequence.extend(sublist)\n\n    frequency_map = {}\n    for element in flattened_sequence:\n        frequency_map[element] = frequency_map.get(element, 0) + 1\n\n    return frequency_map"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers: (list[float | int] | tuple[float | int, ...])) -> float:\n    \"\"\"\n    Multiplies all numbers in a list or tuple and divides by its length.\n    Returns float('nan') if the input collection is empty.\n    \"\"\"\n    length = len(numbers)\n\n    if length == 0:\n        return float('nan')\n\n    product = 1.0\n    for num in numbers:\n        product *= num\n\n    return product / length"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(num: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome strictly greater than the given integer.\n    \"\"\"\n    def is_palindrome(n: int) -> bool:\n        \"\"\"Checks if an integer is a palindrome.\"\"\"\n        s = str(n)\n        return s == s[::-1]\n\n    current_number = num + 1\n    while True:\n        if is_palindrome(current_number):\n            return current_number\n        current_number += 1"}
