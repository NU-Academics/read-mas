{"task_id": "Mbpp/166", "solution": "def _is_even(number: int) -> bool:\n    \"\"\"Checks if an integer is even.\"\"\"\n    return number % 2 == 0\ndef find_even_pair(numbers: list[int]) -> int:\n    \"\"\"Counts pairs of integers in a list that XOR to an even number.\"\"\"\n    even_xor_count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            xor_result = numbers[i] ^ numbers[j]\n            if _is_even(xor_result):\n                even_xor_count += 1\n    return even_xor_count"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Calculates the smallest power of 2 that is greater than or equal to n.\n    Returns the smallest power of 2 greater than or equal to n.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Check if n is already a power of 2.\n    if n > 0 and (n & (n - 1)) == 0:\n        return n\n\n    # Calculates the next power of 2 using logarithm and ceiling.\n    return 1 << math.ceil(math.log2(n))"}
{"task_id": "Mbpp/172", "solution": "def count_occurance(input_string: str) -> int:\n    \"\"\"\n    Counts non-overlapping occurrences of the substring 'std' in the given string.\n    The search position advances past each found occurrence to ensure non-overlapping counts.\n    \"\"\"\n    count = 0\n    start_index = 0\n    target = \"std\"\n    while True:\n        index = input_string.find(target, start_index)\n        if index == -1:\n            break\n        count += 1\n        start_index = index + len(target)\n    return count"}
