{"task_id": "Mbpp/395", "solution": "def first_non_repeating_character(input_string: str) -> str | None:\n    \"\"\"\n    Identifies the first character in a given string that appears only once.\n    Returns None if all characters are repeated or the string is empty.\n    \"\"\"\n    if not input_string:\n        return None\n\n    # Calculate character frequencies using a dictionary.\n    char_counts = {}\n    for char in input_string:\n        char_counts[char] = char_counts.get(char, 0) + 1\n\n    # Iterate through the string to find the first non-repeating character.\n    for char in input_string:\n        if char_counts[char] == 1:\n            return char\n\n    # If no non-repeating character is found.\n    return None"}
{"task_id": "Mbpp/392", "solution": "def get_max_sum(n: int) -> int:\n    \"\"\"Calculates the maximum sum for a given integer n using memoization.\"\"\"\n    _memo = {}\n\n    def _get_max_sum_recursive(current_n: int) -> int:\n        if current_n <= 1:\n            return current_n\n        if current_n in _memo:\n            return _memo[current_n]\n\n        sum_of_parts = (_get_max_sum_recursive(current_n // 2) +\n                        _get_max_sum_recursive(current_n // 3) +\n                        _get_max_sum_recursive(current_n // 4) +\n                        _get_max_sum_recursive(current_n // 5))\n        \n        result = max(sum_of_parts, current_n)\n        _memo[current_n] = result\n        return result\n\n    return _get_max_sum_recursive(n)"}
{"task_id": "Mbpp/398", "solution": "def sum_of_digits(numbers: list[int]) -> int:\n    \"\"\"Computes the total sum of digits for a list of numbers.\"\"\"\n    def _sum_digits_of_single_number(number: int) -> int:\n        \"\"\"Helper to calculate the sum of digits for a single integer.\"\"\"\n        return sum(int(digit) for digit in str(number))\n\n    total_sum = 0\n    for number in numbers:\n        total_sum += _sum_digits_of_single_number(number)\n    return total_sum"}
