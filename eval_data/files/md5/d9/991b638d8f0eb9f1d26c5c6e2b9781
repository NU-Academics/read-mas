{"task_id": "Mbpp/743", "solution": "def rotate_right(list_of_items: list, rotation_count: int) -> list:\n    \"\"\"Rotates a list to the right by a specified number of items.\n    Returns a new list with elements rotated to the right.\"\"\"\n\n    if not list_of_items:\n        return []\n\n    n = len(list_of_items)\n\n    # Calculate effective rotation count to handle rotations greater than list length or negative rotations\n    effective_rotation = rotation_count % n\n\n    # If effective rotation is zero, return a shallow copy of the original list\n    if effective_rotation == 0:\n        return list_of_items[:]\n\n    # Perform the rotation using slicing and concatenation\n    return list_of_items[-effective_rotation:] + list_of_items[:-effective_rotation]"}
{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing '0' are excluded.\n    \"\"\"\n    result = []\n    for num in range(startnum, endnum + 1):\n        # Convert the number to a string to easily iterate over its digits.\n        s_num = str(num)\n        is_valid = True\n        for char_digit in s_num:\n            digit = int(char_digit)\n            if digit == 0:\n                # A number cannot be divisible by zero (BR3).\n                is_valid = False\n                break\n            if num % digit != 0:\n                # The number is not divisible by one of its digits.\n                is_valid = False\n                break\n        if is_valid:\n            result.append(num)\n    return result"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Inserts spaces between words starting with capital letters in the given string.\n    Handles empty strings and single-word inputs correctly.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    result_parts = [input_string[0]]\n    for char in input_string[1:]:\n        if char.isupper():\n            result_parts.append(' ')\n        result_parts.append(char)\n\n    return \"\".join(result_parts)"}
{"task_id": "Mbpp/753", "solution": "def min_k(tuple_list: list[tuple[str, int]], k: int) -> list[tuple[str, int]]:\n    \"\"\"\n    Finds the minimum k records from a list of tuples, sorted by their integer values.\n    Returns the first k records, or all records if k exceeds the list length.\n    \"\"\"\n    sorted_list = sorted(tuple_list, key=lambda x: x[1])\n    return sorted_list[:k]"}
