{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n):\n    \"\"\"\n    Calculates the average of the cubes of the first 'n' natural numbers.\n    The sum of cubes is accumulated in a loop, then divided by 'n'.\n    \"\"\"\n    sum_of_cubes = 0\n    for i in range(1, n + 1):\n        sum_of_cubes += i ** 3\n    average = sum_of_cubes / n\n    return average"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers: List[float]) -> int:\n    \"\"\"\n    Rounds every number of a given list of numbers and returns the total sum\n    multiplied by the length of the list.\n    \"\"\"\n    import math\n    from typing import List\n\n    class Number:\n        \"\"\"Represents a single numeric value with custom rounding logic.\"\"\"\n        def __init__(self, value: float):\n            self._value = value\n\n        def get_value(self) -> float:\n            \"\"\"Returns the original float value.\"\"\"\n            return self._value\n\n        def round(self) -> int:\n            \"\"\"Rounds the number to the nearest integer, rounding .5 away from zero.\"\"\"\n            if self._value >= 0:\n                return int(self._value + 0.5)\n            else:\n                return int(self._value - 0.5)\n\n    class NumberList:\n        \"\"\"Manages a list of Number objects and performs calculations.\"\"\"\n        def __init__(self, numbers: List[float]):\n            self._numbers: List[Number] = [Number(num) for num in numbers]\n            self._length: int = len(numbers)\n\n        def get_numbers(self) -> List[Number]:\n            \"\"\"Returns the list of Number objects.\"\"\"\n            return self._numbers\n\n        def get_length(self) -> int:\n            \"\"\"Returns the count of numbers in the list.\"\"\"\n            return self._length\n\n        def round_all_numbers(self) -> List[int]:\n            \"\"\"Rounds all contained Number objects and returns a list of rounded integers.\"\"\"\n            return [num_obj.round() for num_obj in self._numbers]\n\n        def calculate_sum_of_rounded_numbers(self) -> int:\n            \"\"\"Calculates the sum of all rounded numbers.\"\"\"\n            rounded_numbers = self.round_all_numbers()\n            return sum(rounded_numbers)\n\n        def calculate_product_with_length(self) -> int:\n            \"\"\"Calculates the product of the sum of rounded numbers and the list length.\"\"\"\n            sum_val = self.calculate_sum_of_rounded_numbers()\n            length_val = self.get_length()\n            return sum_val * length_val\n\n    number_list_processor = NumberList(numbers)\n    return number_list_processor.calculate_product_with_length()"}
