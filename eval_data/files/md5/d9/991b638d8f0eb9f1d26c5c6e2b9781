{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Removes consecutive duplicate elements from a list, retaining only the first occurrence.\n    Returns a new list.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result_list = [input_list[0]]\n    for i in range(1, len(input_list)):\n        if input_list[i] != input_list[i-1]:\n            result_list.append(input_list[i])\n    return result_list"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list: list) -> int:\n    \"\"\"Calculates the sum of products of all possible contiguous sublists of a given list.\"\"\"\n    total_sum_of_products = 0\n    n = len(input_list)\n\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= input_list[j]\n            total_sum_of_products += current_product\n\n    return total_sum_of_products"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(sorted_array: list[int], target_number: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array using a modified binary search.\n    Returns -1 if the target number is not found.\n    \"\"\"\n    low = 0\n    high = len(sorted_array) - 1\n    first_idx = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if sorted_array[mid] == target_number:\n            first_idx = mid\n            high = mid - 1  # Try to find an earlier occurrence\n        elif sorted_array[mid] < target_number:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return first_idx"}
{"task_id": "Mbpp/731", "solution": "import math\ndef lateralsurface_cone(r: float, h: float) -> float:\n    \"\"\"Calculates the lateral surface area of a cone given radius r and height h.\n    The lateral surface area is given by the formula: LSA = \u03c0 * r * l,\n    where l (slant height) = sqrt(r^2 + h^2).\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    lateral_surface_area = math.pi * r * slant_height\n    return lateral_surface_area"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"Toggles bits of the number except the first and the last bit.\n\n    Args:\n        number: The integer input.\n\n    Returns:\n        The integer with middle bits toggled.\n    \"\"\"\n    binary_string = bin(number)[2:]\n\n    if len(binary_string) <= 2:\n        # If there are 0, 1, or 2 bits, there are no \"middle\" bits to toggle.\n        return number\n\n    first_bit = binary_string[0]\n    last_bit = binary_string[-1]\n    middle_bits_str = binary_string[1:-1]\n\n    toggled_middle_bits = ''.join('1' if bit == '0' else '0' for bit in middle_bits_str)\n\n    result_binary_string = first_bit + toggled_middle_bits + last_bit\n    return int(result_binary_string, 2)"}
{"task_id": "Mbpp/737", "solution": "import re\ndef check_str(input_string: str) -> bool:\n    \"\"\"Checks if the given string starts with a vowel (a, e, i, o, u), case-insensitive,\n    using a regular expression.\n    \"\"\"\n    if not input_string:\n        return False\n    vowel_regex = re.compile(r\"^[aeiou]\", re.IGNORECASE)\n    return bool(vowel_regex.match(input_string))"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list: list, value: int) -> int:\n    \"\"\"Locates the left insertion point for a specified value in a sorted list using binary search.\n    It finds index 'i' where all elements before 'i' are < value and elements at/after 'i' are >= value.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple: tuple) -> dict:\n    \"\"\"\n    Converts a tuple to a key-value dictionary using adjacent elements.\n    If the tuple has an odd number of elements, the last element is ignored.\n    \"\"\"\n    result_dict = {}\n    for i in range(0, len(input_tuple) - 1, 2):\n        key = input_tuple[i]\n        value = input_tuple[i + 1]\n        result_dict[key] = value\n    return result_dict"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(input_string: str) -> bool:\n    \"\"\"Checks if all characters in the given string are identical.\n    Returns True for empty or single-character strings, otherwise compares all characters to the first.\n    \"\"\"\n    if len(input_string) <= 1:\n        return True\n    \n    first_char = input_string[0]\n    for char in input_string[1:]:\n        if char != first_char:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/742", "solution": "import math\ndef area_tetrahedron(side_length: float) -> float:\n    \"\"\"Calculates the surface area of a regular tetrahedron.\n    Raises ValueError if side_length is negative.\n    \"\"\"\n    if side_length < 0:\n        raise ValueError(\"Side length cannot be negative.\")\n    return math.sqrt(3) * (side_length ** 2)"}
{"task_id": "Mbpp/739", "solution": "import math\ndef _calculate_triangular_number(k: int) -> int:\n    \"\"\"Calculates the k-th triangular number.\"\"\"\n    return k * (k + 1) // 2\ndef _count_digits(value: int) -> int:\n    \"\"\"Counts the number of digits in a positive integer.\"\"\"\n    return math.floor(math.log10(value)) + 1\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    It iterates through triangular numbers until one with 'n' digits is found.\n    \"\"\"\n    k = 1\n    while True:\n        triangular_value = _calculate_triangular_number(k)\n        current_digits = _count_digits(triangular_value)\n\n        if current_digits == n:\n            return k\n        k += 1"}
