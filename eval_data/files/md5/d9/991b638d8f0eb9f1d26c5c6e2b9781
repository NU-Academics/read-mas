{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(value: int) -> int:\n    \"\"\"Sets the left-most unset bit (most significant 0-bit) in the given integer.\n    The 'left-most unset bit' refers to the bit at the highest position index that has a value of 0.\n    \"\"\"\n    if value == 0:\n        return 1\n\n    # Iterate from a high bit position downwards to find the left-most unset bit.\n    # Start checking from bit_length - 1 down to 0.\n    # If all bits up to bit_length - 1 are set, the target is at bit_length.\n    target_bit_pos = value.bit_length()\n    for i in range(value.bit_length() - 1, -1, -1):\n        if not ((value >> i) & 1):\n            target_bit_pos = i\n            break\n\n    return value | (1 << target_bit_pos)"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(student_ids: list[str], student_names: list[str], scores: list[int]) -> list[dict[str, dict[str, int]]]:\n    \"\"\"Converts three parallel lists into a list of nested dictionaries.\"\"\"\n    if not (len(student_ids) == len(student_names) == len(scores)):\n        raise ValueError(\"Input lists must have equal lengths.\")\n\n    result = []\n    for student_id, student_name, score in zip(student_ids, student_names, scores):\n        inner_dict = {student_name: score}\n        outer_dict = {student_id: inner_dict}\n        result.append(outer_dict)\n    return result"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    Returns 0 for n <= 0.\n    \"\"\"\n    if n <= 0:\n        return 0\n    \n    power = 1\n    while (power << 1) <= n:\n        power <<= 1\n        \n    return power"}
