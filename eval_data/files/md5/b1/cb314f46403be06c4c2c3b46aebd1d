{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    integer_part = int(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/0", "solution": "from typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    \"\"\"\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\nclass Group:\n    \"\"\"Encapsulates a single group of parentheses and calculates its deepest nesting level.\"\"\"\n    def __init__(self, value: str):\n        self._value: str = value\n        self._deepest_nesting_level: int = 0\n\n    def calculate_deepest_nesting(self) -> int:\n        \"\"\"Calculates and returns the deepest nesting level for this group.\"\"\"\n        current_level = 0\n        max_level = 0\n        for char in self._value:\n            if char == '(':\n                current_level += 1\n                max_level = max(max_level, current_level)\n            elif char == ')':\n                current_level -= 1\n        self._deepest_nesting_level = max_level\n        return self._deepest_nesting_level\n\n    def get_deepest_nesting_level(self) -> int:\n        \"\"\"Returns the calculated deepest nesting level.\"\"\"\n        return self._deepest_nesting_level\n\n\nclass ResultList:\n    \"\"\"Collects and manages the list of deepest nesting levels.\"\"\"\n    def __init__(self):\n        self._values: List[int] = []\n\n    def add_nesting_level(self, level: int):\n        \"\"\"Adds a calculated nesting level to the internal list.\"\"\"\n        self._values.append(level)\n\n    def get_values(self) -> List[int]:\n        \"\"\"Returns the complete list of nesting levels.\"\"\"\n        return self._values\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n    \"\"\"\n    group_strings = paren_string.split(' ')\n    result_list = ResultList()\n\n    for group_str in group_strings:\n        if group_str: # Handle potential empty strings from multiple spaces\n            group = Group(group_str)\n            nesting_level = group.calculate_deepest_nesting()\n            result_list.add_nesting_level(nesting_level)\n\n    return result_list.get_values()"}
{"task_id": "HumanEval/7", "solution": "from typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    if not strings:\n        return []\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'. \"\"\"\n    if not numbers:\n        return []\n\n    result_list = [numbers[0]]\n    for i in range(1, len(numbers)):\n        result_list.append(delimeter)\n        result_list.append(numbers[i])\n    return result_list"}
{"task_id": "HumanEval/3", "solution": "from typing import List\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    current_balance: int = 0\n\n    for op in operations:\n        current_balance += op\n        if current_balance < 0:\n            return True\n\n    return False"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\ndef _remove_spaces(s: str) -> str:\n    \"\"\"Removes all space characters from an input string.\"\"\"\n    return s.replace(' ', '')\n\ndef _is_balanced(s: str) -> bool:\n    \"\"\"Checks if a given parenthesis string is balanced.\"\"\"\n    count = 0\n    for char in s:\n        if char == '(':\n            count += 1\n        elif char == ')':\n            count -= 1\n        if count < 0:\n            return False\n    return count == 0\n\ndef _find_and_validate_groups(cleaned_string: str) -> List[str]:\n    \"\"\"Identifies distinct, balanced, and non-externally nested parenthesis groups.\"\"\"\n    groups = []\n    balance = 0\n    start_index = 0\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        if balance == 0 and i >= start_index:\n            current_group = cleaned_string[start_index : i + 1]\n            if _is_balanced(current_group):\n                groups.append(current_group)\n            start_index = i + 1\n    return groups\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    cleaned_string = _remove_spaces(paren_string)\n    return _find_and_validate_groups(cleaned_string)"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\nclass Dataset:\n    \"\"\"Encapsulates the list of floating-point numbers.\"\"\"\n    def __init__(self, numbers: List[float]):\n        self._values = numbers\n\n    def get_values(self) -> List[float]:\n        \"\"\"Returns the encapsulated list of numbers.\"\"\"\n        return self._values\n\n    def get_count(self) -> int:\n        \"\"\"Returns the number of elements in the dataset.\"\"\"\n        return len(self._values)\n\n\nclass Statistic:\n    \"\"\"Abstract base class for statistical values.\"\"\"\n    def __init__(self):\n        self._value = 0.0\n\n    def get_value(self) -> float:\n        \"\"\"Returns the calculated statistical value.\"\"\"\n        return self._value\n\n\nclass Mean(Statistic):\n    \"\"\"Calculates and stores the arithmetic mean of a Dataset.\"\"\"\n    def __init__(self, dataset: Dataset):\n        super().__init__()\n        self.calculate(dataset)\n\n    def calculate(self, dataset: Dataset) -> None:\n        \"\"\"Computes the mean from the provided dataset and stores it.\"\"\"\n        values = dataset.get_values()\n        count = dataset.get_count()\n        # The main orchestrator ensures count is not zero before this method is called.\n        self._value = sum(values) / count\n\n\nclass MeanAbsoluteDeviation(Statistic):\n    \"\"\"Calculates and stores the Mean Absolute Deviation of a Dataset given its Mean.\"\"\"\n    def __init__(self, dataset: Dataset, mean: Mean):\n        super().__init__()\n        self.calculate(dataset, mean)\n\n    def calculate(self, dataset: Dataset, mean: Mean) -> None:\n        \"\"\"Computes the MAD from the provided dataset and mean, and stores it.\"\"\"\n        mean_value = mean.get_value()\n        values = dataset.get_values()\n        count = dataset.get_count()\n        # The main orchestrator ensures count is not zero before this method is called.\n        total_abs_diff = sum(abs(x - mean_value) for x in values)\n        self._value = total_abs_diff / count\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    dataset = Dataset(numbers)\n    mean_calculator = Mean(dataset)\n    mad_calculator = MeanAbsoluteDeviation(dataset, mean_calculator)\n\n    return mad_calculator.get_value()"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    current_max = -float('inf')\n\n    for num in numbers:\n        current_max = max(current_max, num)\n        result.append(current_max)\n\n    return result"}
