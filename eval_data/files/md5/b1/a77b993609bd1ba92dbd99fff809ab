{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list) -> list:\n    \"\"\"\n    Return a sorted list of unique elements common to both l1 and l2.\n\n    Parameters\n    ----------\n    l1 : list\n        First input iterable; can contain hashable elements.\n    l2 : list\n        Second input iterable; can contain hashable elements.\n\n    Returns\n    -------\n    list\n        Sorted list of unique elements that appear in both l1 and l2.\n\n    Raises\n    ------\n    TypeError\n        If either input cannot be converted to a list of hashable elements.\n    \"\"\"\n    try:\n        list1 = list(l1)\n        list2 = list(l2)\n    except Exception as exc:\n        raise TypeError(\"Inputs must be iterable\") from exc\n\n    try:\n        set1 = set(list1)\n        set2 = set(list2)\n    except TypeError as exc:\n        raise TypeError(\"All elements must be hashable\") from exc\n\n    common_set = set1.intersection(set2)\n    return sorted(common_set)"}
{"task_id": "HumanEval/59", "solution": "import math\nfrom typing import Optional\ndef _is_prime(n: int) -> bool:\n    \"\"\"Check if an integer n (>1) is prime.\n\n    Parameters\n    ----------\n    n : int\n        The integer to test for primality.\n\n    Returns\n    -------\n    bool\n        True if n is prime, False otherwise.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    limit = math.isqrt(n)\n    divisor = 3\n    while divisor <= limit:\n        if n % divisor == 0:\n            return False\n        divisor += 2\n    return True\ndef largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of a composite integer n (>1).\n\n    The function validates that n > 1 and that n is not prime.\n    It then factors n using efficient trial division, returning the\n    greatest prime factor found.\n\n    Parameters\n    ----------\n    n : int\n        Integer to factorize. Must be greater than 1 and not prime.\n\n    Returns\n    -------\n    int\n        The largest prime factor of n.\n\n    Raises\n    ------\n    ValueError\n        If n <= 1 or if n is prime.\n\n    Examples\n    --------\n    >>> largest_prime_factor(12)\n    3\n    >>> largest_prime_factor(100)\n    5\n    >>> largest_prime_factor(600851475143)  # Example from Project Euler\n    6857\n    \"\"\"\n    if n <= 1:\n        raise ValueError(\"n must be greater than 1\")\n    if _is_prime(n):\n        raise ValueError(\"n must not be prime\")\n\n    max_factor: Optional[int] = None\n\n    # Remove factor 2\n    while n % 2 == 0:\n        max_factor = 2\n        n //= 2\n\n    # Remove odd factors\n    divisor = 3\n    limit = math.isqrt(n)\n    while divisor <= limit and n > 1:\n        if n % divisor == 0:\n            max_factor = divisor\n            n //= divisor\n            limit = math.isqrt(n)\n        else:\n            divisor += 2\n\n    if n > 1:\n        max_factor = n\n\n    return max_factor  # type: ignore"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int) -> int:\n    \"\"\"\n    Return the sum of all integers from 1 to ``n`` inclusive.\n\n    The sum is computed using the arithmetic series formula for optimal\n    performance (O(1) time, O(1) space).\n\n    Parameters\n    ----------\n    n : int\n        Non\u2011negative integer indicating the upper bound of the series.\n        Must be greater than or equal to 0.\n\n    Returns\n    -------\n    int\n        Sum of the series 1 + 2 + ... + n.\n\n    Raises\n    ------\n    ValueError\n        If ``n`` is negative or not an integer.\n\n    Examples\n    --------\n    >>> sum_to_n(0)\n    0\n    >>> sum_to_n(1)\n    1\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(-3)\n    Traceback (most recent call last):\n        ...\n    ValueError: n must be a non\u2011negative integer\n\n    >>> sum_to_n(1.5)\n    Traceback (most recent call last):\n        ...\n    ValueError: n must be a non\u2011negative integer\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be a non\u2011negative integer\")\n    if n < 0:\n        raise ValueError(\"n must be a non\u2011negative integer\")\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(s: str) -> bool:\n    \"\"\"\n    Verify that a string composed solely of parentheses '(' and ')' is properly balanced.\n\n    Args:\n        s: Input string containing only '(' and ')'.\n\n    Returns:\n        True if brackets are balanced, False otherwise.\n\n    Raises:\n        ValueError: If the string contains characters other than '(' or ')'.\n    \"\"\"\n    balance = 0\n    for c in s:\n        if c == '(':\n            balance += 1\n        elif c == ')':\n            balance -= 1\n            if balance < 0:\n                return False\n        else:\n            raise ValueError(\"Invalid character\")\n    return balance == 0"}
