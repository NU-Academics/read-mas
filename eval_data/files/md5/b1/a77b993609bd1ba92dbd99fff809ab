{"task_id": "HumanEval/69", "solution": "from collections import Counter\nfrom typing import List\ndef search(lst: List[int]) -> int:\n    \"\"\"\n    Return the greatest integer > 0 such that its frequency in lst\n    is >= the integer's value. Return -1 if no such integer exists.\n    \"\"\"\n    freq = Counter(lst)\n    max_candidate = -1\n    for value, count in freq.items():\n        if value > 0 and count >= value:\n            if value > max_candidate:\n                max_candidate = value\n    return max_candidate"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(input_list):\n    \"\"\"\n    Returns a new list sorted in a strange order: min, max, second min, second max, ...\n\n    Parameters\n    ----------\n    input_list : list[int]\n        List of integers to be sorted in strange order.\n\n    Returns\n    -------\n    list[int]\n        New list containing elements in strange order.\n\n    Raises\n    ------\n    TypeError\n        If input is not a list or contains non-integer elements.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input must be a list\")\n\n    for element in input_list:\n        if not isinstance(element, int):\n            raise TypeError(\"all elements must be integers\")\n\n    sorted_list = sorted(input_list)\n    left, right = 0, len(sorted_list) - 1\n    output_list = []\n\n    while left <= right:\n        output_list.append(sorted_list[left])\n        if left != right:\n            output_list.append(sorted_list[right])\n        left += 1\n        right -= 1\n\n    return output_list"}
{"task_id": "HumanEval/71", "solution": "import math\nfrom typing import Union\ndef triangle_area(a: Union[int, float],\n                  b: Union[int, float],\n                  c: Union[int, float]) -> Union[float, int]:\n    \"\"\"Calculate the area of a triangle given side lengths a, b, and c using Heron's formula.\n\n    Parameters\n    ----------\n    a, b, c : int | float\n        The lengths of the sides of the triangle. Must be numeric values.\n\n    Returns\n    -------\n    float\n        The area of the triangle rounded to two decimal places.\n    int\n        Returns -1 if the sides do not form a valid triangle or if any side is non\u2011positive.\n\n    Raises\n    ------\n    TypeError\n        If any of the arguments is not an int or float.\n    \"\"\"\n    # Type checking\n    for side in (a, b, c):\n        if not isinstance(side, (int, float)):\n            raise TypeError(\"All sides must be numeric.\")\n\n    # Positive side check\n    if a <= 0 or b <= 0 or c <= 0:\n        return -1\n\n    # Triangle inequality check\n    if (a + b <= c) or (a + c <= b) or (b + c <= a):\n        return -1\n\n    # Heron's formula\n    s = (a + b + c) / 2.0\n    area_sq = s * (s - a) * (s - b) * (s - c)\n    if area_sq <= 0:\n        return -1\n\n    area = math.sqrt(area_sq)\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "from typing import List\ndef will_it_fly(q: List[int], w: int) -> bool:\n    \"\"\"\n    Determine whether a list of integers qualifies for flight.\n\n    The list must be a palindrome and its sum must not exceed the weight limit `w`.\n\n    Args:\n        q: List of integers representing weights of items.\n        w: Integer weight limit.\n\n    Returns:\n        True if `q` is a palindrome and sum(q) <= w, False otherwise.\n\n    Raises:\n        TypeError: If `q` is not a list of ints or `w` is not an int.\n\n    Examples:\n        >>> will_it_fly([1, 2, 1], 5)\n        True\n        >>> will_it_fly([1, 2, 3], 6)\n        False\n    \"\"\"\n    _validate_inputs(q, w)\n\n    if not _is_palindrome(q):\n        return False\n\n    return sum(q) <= w\ndef _is_palindrome(q: List[int]) -> bool:\n    \"\"\"Return True if q reads the same forwards and backwards.\"\"\"\n    return q == q[::-1]"}
{"task_id": "HumanEval/73", "solution": "from typing import List\ndef smallest_change(arr: List[int]) -> int:\n    \"\"\"Return minimum number of changes to make arr a palindrome.\"\"\"\n    changes = 0\n    n = len(arr)\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes"}
{"task_id": "HumanEval/74", "solution": "from collections.abc import Iterable\nfrom typing import List, Any\ndef _validate_iterable(iterable: Any, name: str) -> List[str]:\n    if not isinstance(iterable, Iterable):\n        raise TypeError(\n            f\"{name} must be an iterable of strings, got {type(iterable).__name__}\"\n        )\n    result = []\n    for idx, item in enumerate(iterable):\n        if not isinstance(item, str):\n            raise ValueError(\n                f\"element at index {idx} in {name} is not a string\"\n            )\n        result.append(item)\n    return result\ndef _total_characters(strings: List[str]) -> int:\n    return sum(len(s) for s in strings)\ndef _select_by_total(list1: List[str], list2: List[str]) -> List[str]:\n    total1 = _total_characters(list1)\n    total2 = _total_characters(list2)\n    return list1 if total1 <= total2 else list2\ndef total_match(list1: Iterable[str], list2: Iterable[str]) -> List[str]:\n    \"\"\"\n    Return the list with the smaller total character count.\n\n    Parameters\n    ----------\n    list1 : Iterable[str]\n        First list of strings.\n    list2 : Iterable[str]\n        Second list of strings.\n\n    Returns\n    -------\n    List[str]\n        The list with the smaller total number of characters, or the first\n        list if both totals are equal.\n\n    Raises\n    ------\n    TypeError\n        If either argument is not an iterable of strings.\n    ValueError\n        If any element in the iterables is not a string.\n    \"\"\"\n    validated1 = _validate_iterable(list1, \"first argument\")\n    validated2 = _validate_iterable(list2, \"second argument\")\n    return _select_by_total(validated1, validated2)"}
{"task_id": "HumanEval/75", "solution": "def _prime_factors(n: int) -> list[int]:\n    \"\"\"\n    Return the list of prime factors of n (with multiplicity).\n\n    Parameters:\n        n (int): The integer to factor (n > 0).\n\n    Returns:\n        list[int]: A list of prime factors, sorted in ascending order.\n    \"\"\"\n    factors: list[int] = []\n    divisor = 2\n    while divisor * divisor <= n:\n        while n % divisor == 0:\n            factors.append(divisor)\n            n //= divisor\n        divisor += 1 if divisor == 2 else 2  # skip even numbers after 2\n    if n > 1:\n        factors.append(n)\n    return factors\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"\n    Return True if ``a`` can be expressed as a product of exactly three prime\n    numbers (primes may repeat).  The order of multiplication is irrelevant.\n\n    Parameters:\n        a (int): Integer to test (must satisfy 0 < a < 100).\n\n    Returns:\n        bool: ``True`` if ``a`` equals ``p1 * p2 * p3`` for some primes\n        ``p1``, ``p2`` and ``p3`` (not necessarily distinct); otherwise\n        ``False``.\n\n    Raises:\n        TypeError: If ``a`` is not an instance of ``int``.\n        ValueError: If ``a`` is less than or equal to 0 or greater than or\n            equal to 100.\n\n    Examples:\n        >>> is_multiply_prime(30)\n        True          # 30 = 2 * 3 * 5\n        >>> is_multiply_prime(7)\n        False         # 7 is prime but not a product of three primes\n        >>> is_multiply_prime(8)\n        True          # 8 = 2 * 2 * 2\n    \"\"\"\n    if not isinstance(a, int):\n        raise TypeError(\"Input must be an integer.\")\n    if a <= 0 or a >= 100:\n        raise ValueError(\"Input must be in the range 1..99.\")\n    factors = _prime_factors(a)\n    return len(factors) == 3"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x: int, n: int) -> bool:\n    \"\"\"\n    Determine if integer x is a simple power of integer n (x = n^k with k >= 1).\n\n    Parameters\n    ----------\n    x : int\n        The target value.\n    n : int\n        The base value.\n\n    Returns\n    -------\n    bool\n        True if such an integer exponent k exists, False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If either x or n is not an integer.\n    \"\"\"\n    if not isinstance(x, int) or not isinstance(n, int):\n        raise TypeError(\"Both x and n must be integers.\")\n\n    # Base cases\n    if n == 0:\n        return x == 0\n    if n == 1:\n        return x == 1\n    if n == -1:\n        return x in (1, -1)\n\n    # Zero or one target values\n    if x == 0:\n        return False\n    if x == 1:\n        return False\n\n    # Negative target with positive base cannot be a power\n    if x < 0 and n > 0:\n        return False\n\n    abs_n = abs(n)\n    value = abs(x)\n\n    if value < abs_n:\n        return False\n\n    k = 0\n    while value % abs_n == 0:\n        value //= abs_n\n        k += 1\n\n    if value != 1:\n        return False\n\n    if n < 0 and k % 2 == 0:\n        return False\n\n    return True"}
{"task_id": "HumanEval/77", "solution": "def iscube(n: int) -> bool:\n    \"\"\"Return True if n is a perfect cube, False otherwise.\n    Raises TypeError if n is not an int.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"iscube expects an integer argument\")\n\n    if n == 0:\n        return True\n\n    abs_n = -n if n < 0 else n\n\n    # The cube root of 2**63-1 is 2097152, so this is the maximum possible root\n    low = 0\n    high = 2097152 if abs_n >= 2097152 else abs_n\n\n    while low <= high:\n        mid = (low + high) >> 1\n        cube = mid * mid * mid\n        if cube == abs_n:\n            return True\n        if cube < abs_n:\n            low = mid + 1\n        else:\n            high = mid - 1\n\n    return False"}
{"task_id": "HumanEval/78", "solution": "from typing import Set\n_PRIME_DIGITS: Set[str] = {'2', '3', '5', '7', 'B', 'D'}\ndef hex_key(hex_string: str) -> int:\n    \"\"\"\n    Counts the number of prime hexadecimal digits in the input string.\n\n    Parameters\n    ----------\n    hex_string : str\n        A string consisting of uppercase hexadecimal digits (0\u20119, A\u2011F).\n        May be empty.\n\n    Returns\n    -------\n    int\n        The count of prime hex digits: 2, 3, 5, 7, B, D.\n    \"\"\"\n    count = 0\n    for ch in hex_string:\n        if ch in _PRIME_DIGITS:\n            count += 1\n    return count"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Convert a decimal integer to a binary string wrapped with 'db' markers.\"\"\"\n    if not isinstance(decimal, int):\n        raise TypeError(\"Input must be an integer\")\n    if decimal < 0:\n        raise ValueError(\"Input must be non-negative\")\n    # Special case for zero\n    binary = \"0\" if decimal == 0 else \"\"\n    # Build binary representation\n    while decimal > 0:\n        binary = (\"1\" if decimal & 1 else \"0\") + binary\n        decimal >>= 1\n    return f\"db{binary}db\""}
{"task_id": "HumanEval/80", "solution": "def is_happy(s: str) -> bool:\n    \"\"\"\n    You are given a string s.\n    Your task is to check if the string is happy or not.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct\n\n    For example:\n    is_happy(\"a\") => False\n    is_happy(\"aa\") => False\n    is_happy(\"abcd\") => True\n    is_happy(\"aabb\") => False\n    is_happy(\"adb\") => True\n    is_happy(\"xyy\") => False\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n    if len(s) < 3:\n        return False\n    for i in range(len(s) - 2):\n        c1, c2, c3 = s[i], s[i + 1], s[i + 2]\n        if c1 == c2 or c1 == c3 or c2 == c3:\n            return False\n    return True"}
{"task_id": "HumanEval/81", "solution": "from typing import List\ndef _map_gpa_to_letter(gpa: float) -> str:\n    \"\"\"Map a single GPA value to its corresponding letter grade.\n\n    The mapping follows these rules:\n    - GPA >= 4.0  -> \"A+\"\n    - GPA < 0.0   -> \"E\"\n    - All other GPAs are mapped to the first grade in the thresholds list\n      where gpa >= threshold.\n    \"\"\"\n    if gpa >= 4.0:\n        return \"A+\"\n    if gpa < 0.0:\n        return \"E\"\n\n    thresholds: List[tuple[float, str]] = [\n        (3.7, \"A\"),\n        (3.3, \"A-\"),\n        (3.0, \"B+\"),\n        (2.7, \"B\"),\n        (2.3, \"B-\"),\n        (2.0, \"C+\"),\n        (1.7, \"C\"),\n        (1.3, \"C-\"),\n        (1.0, \"D+\"),\n        (0.7, \"D\"),\n        (0.0, \"D-\"),\n    ]\n\n    for threshold, grade in thresholds:\n        if gpa >= threshold:\n            return grade\n    return \"E\"\ndef numerical_letter_grade(gpas: List[float]) -> List[str]:\n    \"\"\"Convert a list of GPA float values to their corresponding letter grades.\n\n    Parameters\n    ----------\n    gpas : List[float]\n        List of GPA values to convert.\n\n    Returns\n    -------\n    List[str]\n        List of letter grades in the same order as the input list.\n\n    Examples\n    --------\n    >>> numerical_letter_grade([3.8, 2.5, 1.2])\n    ['A', 'B-', 'C-']\n    >>> numerical_letter_grade([4.0, 3.7, 3.3, 3.0, 2.7, 2.3,\n    ...                         2.0, 1.7, 1.3, 1.0, 0.7, 0.0])\n    ['A+', 'A', 'A-', 'B+', 'B', 'B-', 'C+', 'C', 'C-', 'D+', 'D', 'E']\n    >>> numerical_letter_grade([5.0, -1.0, 0.5])\n    ['A+', 'E', 'D-']\n    \"\"\"\n    return [_map_gpa_to_letter(gpa) for gpa in gpas]"}
{"task_id": "HumanEval/82", "solution": "def prime_length(s: object) -> bool:\n    \"\"\"\n    Determine whether the length of a given string is a prime number.\n\n    Parameters\n    ----------\n    s : Any\n        Any Python object.\n\n    Returns\n    -------\n    bool\n        True if ``s`` is a string and its length is a prime number; otherwise False.\n\n    Examples\n    --------\n    >>> prime_length(\"abc\")\n    True\n    >>> prime_length(\"abcd\")\n    False\n    >>> prime_length(\"\")\n    False\n    >>> prime_length(123)\n    False\n    \"\"\"\n    if not isinstance(s, str) or len(s) <= 1:\n        return False\n    return _is_prime(len(s))\ndef _is_prime(n: int) -> bool:\n    \"\"\"\n    Check if an integer is prime.\n\n    Parameters\n    ----------\n    n : int\n        Positive integer to check.\n\n    Returns\n    -------\n    bool\n        True if n is prime, False otherwise.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    import math\n    limit = math.isqrt(n)\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return False\n    return True"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n: int) -> int:\n    \"\"\"Return the count of all n-digit integers (base\u201110, without leading zeros)\n    that start with 1 or end with 1.\n\n    Parameters\n    ----------\n    n : int\n        Number of digits. Must be >= 1.\n\n    Returns\n    -------\n    int\n        Count of qualifying numbers.\n\n    Raises\n    ------\n    ValueError\n        If n < 1.\n\n    Examples\n    --------\n    >>> starts_one_ends(1)\n    1\n    >>> starts_one_ends(2)\n    19\n    \"\"\"\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n\n    if n == 1:\n        # Numbers 1-9; only 1 satisfies the condition\n        return 1\n\n    pow10_n_minus_1 = 10 ** (n - 1)          # 10^(n-1)\n    pow10_n_minus_2 = 10 ** (n - 2)          # 10^(n-2)\n\n    count_start = pow10_n_minus_1\n    count_end   = 9 * pow10_n_minus_1\n    overlap     = 9 * pow10_n_minus_2\n\n    return count_start + count_end - overlap"}
{"task_id": "HumanEval/84", "solution": "def solve(N: int) -> str:\n    \"\"\"Return the binary representation of the sum of decimal digits of the absolute value of N.\"\"\"\n    if N == 0:\n        return '0'\n    sum_digits = sum(int(d) for d in str(abs(N)))\n    return bin(sum_digits)[2:]"}
{"task_id": "HumanEval/85", "solution": "from typing import List\ndef add(lst: List[int]) -> int:\n    \"\"\"Sum all even integers located at odd indices in a list.\n\n    Parameters\n    ----------\n    lst : list[int]\n        A list of integers. Must be non-empty.\n\n    Returns\n    -------\n    int\n        The sum of even numbers at odd indices (0\u2011based indexing).\n\n    Raises\n    ------\n    TypeError\n        If ``lst`` is not a list or contains non\u2011integer elements.\n    ValueError\n        If ``lst`` is empty.\n\n    Examples\n    --------\n    >>> add([1, 2, 3, 4, 5, 6])\n    12\n    # Explanation: indices 1, 3, 5 contain 2, 4, 6 respectively. All are even,\n    # so the sum is 2 + 4 + 6 = 12.\n\n    >>> add([7, 8, 9, 10])\n    18\n    # Indices 1 and 3 contain 8 and 10 which are even. Sum is 8 + 10 = 18.\n\n    >>> add([1, 3, 5])\n    0\n    # No even numbers at odd indices.\n\n    >>> add([])\n    Traceback (most recent call last):\n        ...\n    ValueError: Input list cannot be empty.\n\n    >>> add([1, 2.5, 3])\n    Traceback (most recent call last):\n        ...\n    TypeError: All elements of the list must be integers.\n    \"\"\"\n    _validate_input(lst)\n    return sum(item for idx, item in enumerate(lst) if idx % 2 == 1 and item % 2 == 0)"}
{"task_id": "HumanEval/86", "solution": "from typing import List\ndef anti_shuffle(text: str) -> str:\n    \"\"\"Return a string where each word's characters are sorted by Unicode code point,\n    preserving the original order of words and all whitespace characters.\n\n    A word is defined as a maximal sequence of non\u2011whitespace characters.\n    Whitespace includes spaces, tabs, newlines, carriage returns, and all\n    Unicode whitespace characters.\n\n    Examples\n    --------\n    >>> anti_shuffle('Hi')\n    'Hi'\n    >>> anti_shuffle('hello')\n    'ehllo'\n    >>> anti_shuffle('Hello World!!!')\n    'Hello !!!Wdlor'\n    \"\"\"\n    result: List[str] = []\n    i = 0\n    n = len(text)\n\n    while i < n:\n        if text[i].isspace():\n            # Preserve whitespace exactly as it appears\n            result.append(text[i])\n            i += 1\n        else:\n            # Extract the full word\n            start = i\n            while i < n and not text[i].isspace():\n                i += 1\n            word = text[start:i]\n            # Sort characters by Unicode code point (ASCII for ASCII subset)\n            sorted_word = ''.join(sorted(word))\n            result.append(sorted_word)\n\n    return ''.join(result)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Find all occurrences of ``x`` in a ragged 2\u2011dimensional list ``lst`` and\n    return a list of tuples ``(row, column)``.\n\n    The returned coordinates are sorted first by the row index in ascending\n    order, and then by the column index in descending order within each row.\n\n    Parameters\n    ----------\n    lst : list[list[int]]\n        A list of rows, each of which may have a different length.\n    x : int\n        The value to search for.\n\n    Returns\n    -------\n    list[tuple[int, int]]\n        A list of coordinates where ``x`` occurs.\n\n    Examples\n    --------\n    >>> get_row([[1,2,3,4,5,6], [1,2,3,4,1,6], [1,2,3,4,5,1]], 1)\n    [(0, 0), (1, 4), (1, 0), (2, 5), (2, 0)]\n    >>> get_row([], 1)\n    []\n    >>> get_row([[], [1], [1, 2, 3]], 3)\n    [(2, 2)]\n    \"\"\"\n    result = []\n    for row_idx, row in enumerate(lst):\n        # Find all column indices where the element equals x\n        cols = [col_idx for col_idx, val in enumerate(row) if val == x]\n        # Sort column indices in descending order\n        for col_idx in sorted(cols, reverse=True):\n            result.append((row_idx, col_idx))\n    return result"}
{"task_id": "HumanEval/88", "solution": "from typing import List\ndef sort_array(array: List[int], descending: bool = False) -> List[int]:\n    \"\"\"Return a new list containing the elements of *array* sorted.\n\n    Parameters\n    ----------\n    array : List[int]\n        The list of integers to sort. Must be a list; elements must be integers.\n    descending : bool, optional\n        If True, the returned list is sorted in descending order.\n        Default is False (ascending order).\n\n    Returns\n    -------\n    List[int]\n        A new list sorted according to the requested order.\n\n    Raises\n    ------\n    TypeError\n        If *array* is not a list or if any element is not an int.\n    \"\"\"\n    if not isinstance(array, list):\n        raise TypeError(\"Input must be a list of integers.\")\n    if not all(isinstance(item, int) for item in array):\n        raise TypeError(\"All elements in the list must be integers.\")\n    return sorted(array, reverse=descending)"}
{"task_id": "HumanEval/89", "solution": "import string\ndef encrypt(s: str) -> str:\n    \"\"\"\n    Encrypts the input string by shifting each ASCII alphabetic character\n    forward by 4 positions while preserving case. Non-alphabetic characters\n    are left unchanged.\n\n    Args:\n        s: The string to encrypt. Must be of type str.\n\n    Returns:\n        A new string with all alphabetic characters shifted by +4.\n        The output string has the same length as the input.\n\n    Raises:\n        TypeError: If `s` is not a string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(f\"encrypt() expects a string, got {type(s).__name__}\")\n\n    # Mapping tables for uppercase and lowercase characters\n    upper = string.ascii_uppercase\n    lower = string.ascii_lowercase\n    shift = 4\n\n    result = []\n    for ch in s:\n        if 'A' <= ch <= 'Z':\n            idx = (ord(ch) - ord('A') + shift) % 26\n            result.append(chr(ord('A') + idx))\n        elif 'a' <= ch <= 'z':\n            idx = (ord(ch) - ord('a') + shift) % 26\n            result.append(chr(ord('a') + idx))\n        else:\n            result.append(ch)\n    return \"\".join(result)"}
