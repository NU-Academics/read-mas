{"task_id": "HumanEval/26", "solution": "from collections import Counter\nfrom typing import List\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\"\n    From a list of integers, remove all elements that occur more than once.\n    Keep the order of elements left the same as in the input.\n    \n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    frequency = Counter(numbers)\n    return [n for n in numbers if frequency[n] == 1]"}
{"task_id": "HumanEval/27", "solution": "def flip_case(s: str) -> str:\n    \"\"\"\n    Return a new string where each alphabetic character in the input string `s`\n    has its case inverted (lower \u2192 upper, upper \u2192 lower). Non-alphabetic\n    characters are left unchanged.\n\n    Parameters\n    ----------\n    s : str\n        The input string to transform.\n\n    Returns\n    -------\n    str\n        A new string with alphabetic case flipped.\n\n    Raises\n    ------\n    TypeError\n        If `s` is not an instance of `str`.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n    return ''.join(\n        c.upper() if c.islower() else\n        c.lower() if c.isupper() else\n        c\n        for c in s\n    )"}
{"task_id": "HumanEval/28", "solution": "def concatenate(a: str, b: str) -> str:\n    \"\"\"Return the concatenation of two strings.\n\n    Parameters\n    ----------\n    a : str\n        The first string.\n    b : str\n        The second string.\n\n    Returns\n    -------\n    str\n        The concatenated string (a + b).\n\n    Raises\n    ------\n    TypeError\n        If either `a` or `b` is not an instance of `str`.\n    \"\"\"\n    if not isinstance(a, str):\n        raise TypeError(f\"Argument 'a' must be str, got {type(a).__name__}\")\n    if not isinstance(b, str):\n        raise TypeError(f\"Argument 'b' must be str, got {type(b).__name__}\")\n\n    return a + b"}
{"task_id": "HumanEval/29", "solution": "from typing import List\ndef filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\"Returns a new list containing only the strings from *strings* that start with\n    *prefix*.\n\n    Parameters\n    ----------\n    strings : List[str]\n        A list of strings to be filtered. May be empty.\n    prefix : str\n        The prefix to filter on.\n\n    Returns\n    -------\n    List[str]\n        A new list with the same ordering as *strings* but only containing\n        entries that start with *prefix*.\n\n    Raises\n    ------\n    TypeError\n        If *strings* is not a list or *prefix* is not a string.\n\n    Examples\n    --------\n    >>> filter_by_prefix(['apple', 'apricot', 'banana'], 'ap')\n    ['apple', 'apricot']\n\n    >>> filter_by_prefix([], 'test')\n    []\n\n    >>> filter_by_prefix(['test', 'toast', 'taste'], 't')\n    ['test', 'toast', 'taste']\n\n    >>> filter_by_prefix(['no', 'match'], 'xyz')\n    []\n    \"\"\"\n    if not isinstance(strings, list):\n        raise TypeError(\"strings must be a list of strings\")\n    if not isinstance(prefix, str):\n        raise TypeError(\"prefix must be a string\")\n    return [s for s in strings if s.startswith(prefix)]"}
{"task_id": "HumanEval/30", "solution": "from typing import List, Union\ndef get_positive(data: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"\n    Filters a list of numbers, returning only the positive numeric elements while preserving the original order.\n\n    Parameters\n    ----------\n    data : List[Union[int, float]]\n        A list of numeric values (int or float).\n\n    Returns\n    -------\n    List[Union[int, float]]\n        A new list containing only values greater than zero.\n\n    Raises\n    ------\n    TypeError\n        If the input is not a list or if any element is not an instance of int or float.\n\n    Examples\n    --------\n    >>> get_positive([1, -2, 0, 3.5, -4.5, 6])\n    [1, 3.5, 6]\n    >>> get_positive([])\n    []\n    >>> get_positive([0, -1, -2])\n    []\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"data must be a list\")\n    result: List[Union[int, float]] = []\n    for x in data:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"all elements must be numeric\")\n        if x > 0:\n            result.append(x)\n    return result"}
