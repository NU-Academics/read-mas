{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int) -> str:\n    \"\"\"Convert a non\u2011negative integer `x` to its representation in a base less than 10.\n\n    Parameters\n    ----------\n    x : int\n        Non\u2011negative integer to convert.\n    base : int\n        Target base, must satisfy 2 <= base <= 9.\n\n    Returns\n    -------\n    str\n        The base-`base` representation of `x`.\n\n    Raises\n    ------\n    TypeError\n        If `x` or `base` is not an integer.\n    ValueError\n        If `x` is negative or `base` is outside the allowed range.\n\n    Examples\n    --------\n    >>> change_base(10, 2)\n    '1010'\n    >>> change_base(255, 8)\n    '377'\n    >>> change_base(0, 5)\n    '0'\n    >>> change_base(12345, 9)\n    '5440'\n    >>> change_base(-1, 3)\n    Traceback (most recent call last):\n        ...\n    ValueError: x must be non\u2011negative\n    >>> change_base(10, 10)\n    Traceback (most recent call last):\n        ...\n    ValueError: base must be between 2 and 9 inclusive\n    \"\"\"\n    # Input validation\n    if not isinstance(x, int) or not isinstance(base, int):\n        raise TypeError(\"x and base must be integers\")\n    if x < 0:\n        raise ValueError(\"x must be non\u2011negative\")\n    if base < 2 or base > 9:\n        raise ValueError(\"base must be between 2 and 9 inclusive\")\n\n    # Special case for zero\n    if x == 0:\n        return \"0\"\n\n    digits = []\n    while x:\n        digits.append(str(x % base))\n        x //= base\n\n    return \"\".join(reversed(digits))"}
{"task_id": "HumanEval/45", "solution": "def triangle_area(a: float, h: float) -> float:\n    \"\"\"Calculate the area of a triangle given a side length and its corresponding height.\n\n    Parameters\n    ----------\n    a : float\n        Length of the side of the triangle.\n    h : float\n        Height (altitude) corresponding to the side `a`.\n\n    Returns\n    -------\n    float\n        The area of the triangle.\n\n    Examples\n    --------\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    return a * h / 2.0"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int) -> int:\n    \"\"\"\n    Compute the n-th element of the fib4 sequence without recursion.\n\n    The fib4 sequence is defined as:\n        fib4(0) = 0\n        fib4(1) = 0\n        fib4(2) = 2\n        fib4(3) = 0\n        fib4(n) = fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4)  for n >= 4\n\n    Parameters\n    ----------\n    n : int\n        The index of the sequence to compute. Must be non\u2011negative.\n\n    Returns\n    -------\n    int\n        The n-th fib4 value.\n\n    Examples\n    --------\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    # Base cases\n    base = [0, 0, 2, 0]\n    if n < 4:\n        return base[n]\n\n    # Use a rolling window of the last four values\n    a, b, c, d = base  # a=fib4(n-4), b=fib4(n-3), c=fib4(n-2), d=fib4(n-1)\n    for _ in range(4, n + 1):\n        e = a + b + c + d  # fib4(n)\n        a, b, c, d = b, c, d, e\n    return d"}
{"task_id": "HumanEval/47", "solution": "from typing import Sequence, Union, List\ndef median(values: Sequence[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Return the median of a non\u2011empty sequence of numeric values.\n\n    The median is the middle value of a sorted sequence; if the number of\n    values is even, it is the arithmetic mean of the two middle values.\n\n    Parameters\n    ----------\n    values : Sequence[Union[int, float]]\n        A non\u2011empty sequence (e.g. list, tuple) containing only integers\n        or floating\u2011point numbers.\n\n    Returns\n    -------\n    Union[int, float]\n        The median value.  If all input values are integers and the median\n        is an integer, the return type is ``int``; otherwise the result is\n        a ``float``.\n\n    Raises\n    ------\n    ValueError\n        If ``values`` is empty.\n    TypeError\n        If any element of ``values`` is not an ``int`` or ``float``.\n\n    Examples\n    --------\n    >>> median([3, 1, 4, 2, 5])\n    3\n    >>> median([1, 2, 3, 4])\n    2.5\n    >>> median([2.5, 3.5, 4.5])\n    3.5\n    \"\"\"\n    if not values:\n        raise ValueError(\"Input sequence must not be empty.\")\n\n    # Validate all elements are numeric and detect types\n    all_int = True\n    for v in values:\n        if not isinstance(v, (int, float)):\n            raise TypeError(f\"All elements must be int or float. Invalid element: {v!r}\")\n        if isinstance(v, float):\n            all_int = False\n\n    sorted_vals: List[Union[int, float]] = sorted(values)\n    n = len(sorted_vals)\n    mid = n // 2\n\n    if n % 2:  # odd\n        median_val = sorted_vals[mid]\n    else:  # even\n        median_val = (sorted_vals[mid - 1] + sorted_vals[mid]) / 2\n\n    # If all integers and the result is an integer, return int\n    if all_int and isinstance(median_val, int):\n        return int(median_val)\n    return float(median_val) if isinstance(median_val, float) else median_val"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str) -> bool:\n    \"\"\"\n    Determine whether the given string is a palindrome.\n\n    The function is case\u2011insensitive and ignores all\n    non\u2011alphanumeric characters (including spaces,\n    punctuation, and Unicode control characters).\n\n    Parameters\n    ----------\n    text : str\n        The string to test for palindrome property.\n\n    Returns\n    -------\n    bool\n        ``True`` if the cleaned string reads the same\n        forwards and backwards, otherwise ``False``.\n\n    Raises\n    ------\n    TypeError\n        If ``text`` is not an instance of ``str``.\n\n    Examples\n    --------\n    >>> is_palindrome('Racecar')\n    True\n    >>> is_palindrome('A man, a plan, a canal, Panama')\n    True\n    >>> is_palindrome('No lemon, no melon')\n    True\n    >>> is_palindrome('Hello, world!')\n    False\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('    ')\n    True\n    >>> is_palindrome(123)\n    Traceback (most recent call last):\n        ...\n    TypeError: text must be a string\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a string\")\n    cleaned = ''.join(ch.lower() for ch in text if ch.isalnum())\n    return cleaned == cleaned[::-1]"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    return pow(2, n, p)"}
{"task_id": "HumanEval/50", "solution": "def decode_shift(text: str) -> str:\n    return _shift_text(text, -5)\ndef _shift_text(text: str, shift: int) -> str:\n    if not text:\n        return \"\"\n    a_ord = ord(\"a\")\n    result = []\n    for ch in text:\n        if ch < \"a\" or ch > \"z\":\n            raise ValueError(f\"Invalid character: {ch}\")\n        offset = ord(ch) - a_ord\n        new_offset = (offset + shift) % 26\n        result.append(chr(a_ord + new_offset))\n    return \"\".join(result)"}
{"task_id": "HumanEval/51", "solution": "_VOWELS = frozenset(\"aeiouAEIOU\")\ndef _is_vowel(ch: str) -> bool:\n    \"\"\"\n    Determine whether a single character is an ASCII vowel.\n\n    Parameters\n    ----------\n    ch : str\n        A single character string.\n\n    Returns\n    -------\n    bool\n        True if `ch` is one of the ASCII vowels (a, e, i, o, u, in either\n        lowercase or uppercase), otherwise False.\n\n    Notes\n    -----\n    Only the characters defined in `_VOWELS` are considered vowels.\n    \"\"\"\n    return ch in _VOWELS\ndef remove_vowels(text: str) -> str:\n    \"\"\"\n    Remove all ASCII vowels from the input string.\n\n    Vowels considered are `a`, `e`, `i`, `o`, `u` in both lowercase and\n    uppercase. All other characters\u2014including whitespace, punctuation,\n    digits, symbols, and non-ASCII Unicode characters\u2014are preserved in the\n    output string in their original order.\n\n    Parameters\n    ----------\n    text : str\n        The string to process.\n\n    Returns\n    -------\n    str\n        The input string with all ASCII vowels removed.\n\n    Raises\n    ------\n    TypeError\n        If `text` is not an instance of `str`.\n\n    Examples\n    --------\n    >>> remove_vowels(\"hello world\")\n    'hll wrld'\n    >>> remove_vowels(\"AEIOU\")\n    ''\n    >>> remove_vowels(\"Python 3.8!\")\n    'Pythn 3.8!'\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a str\")\n\n    return \"\".join(ch for ch in text if not _is_vowel(ch))"}
{"task_id": "HumanEval/52", "solution": "from typing import Iterable, Any, Union\ndef below_threshold(\n    l: Iterable[Any],\n    t: Any,\n    type_check: bool = False\n) -> bool:\n    \"\"\"Return True if every element in ``l`` is strictly less than ``t``.\n\n    Parameters\n    ----------\n    l : Iterable[Any]\n        Iterable containing numeric values.\n    t : Any\n        Threshold value to compare against.\n    type_check : bool, optional\n        If True, perform runtime type validation. Defaults to False.\n\n    Returns\n    -------\n    bool\n        True if all elements in ``l`` are less than ``t``; False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If ``type_check`` is True and inputs are of incorrect type.\n    ValueError\n        If ``l`` contains ``None`` or other invalid values.\n    \"\"\"\n    if type_check:\n        if not isinstance(l, (list, tuple)):\n            raise TypeError(\n                \"l must be a list or tuple of numeric values when type_check is True.\"\n            )\n        for idx, val in enumerate(l):\n            if val is None:\n                raise ValueError(f\"Element at index {idx} is None, which is invalid.\")\n            if not isinstance(val, (int, float)):\n                raise TypeError(\n                    f\"Element at index {idx} is not numeric (found {type(val).__name__}).\"\n                )\n        if not isinstance(t, (int, float)):\n            raise TypeError(\"t must be a numeric type when type_check is True.\")\n\n    for value in l:\n        if value >= t:\n            return False\n    return True"}
{"task_id": "HumanEval/53", "solution": "def add(x: int, y: int) -> int:\n    \"\"\"\n    Return the sum of two integers.\n\n    Parameters\n    ----------\n    x : int\n        First operand.\n    y : int\n        Second operand.\n\n    Returns\n    -------\n    int\n        The arithmetic sum of `x` and `y`.\n\n    Examples\n    --------\n    >>> add(2, 3)\n    5\n    >>> add(-1, 1)\n    0\n    >>> add(0, 0)\n    0\n\n    Edge cases\n    ----------\n    >>> add(2**63, 1)\n    9223372036854775809\n    >>> add(-2**63, -1)\n    -9223372036854775809\n\n    Raises\n    ------\n    TypeError\n        If either argument is not an integer.\n    \"\"\"\n    if not isinstance(x, int) or not isinstance(y, int):\n        raise TypeError(\"Both arguments must be integers.\")\n    return x + y"}
{"task_id": "HumanEval/54", "solution": "import logging\nlogger = logging.getLogger(__name__)\ndef same_chars(str1: str, str2: str) -> bool:\n    \"\"\"\n    Return True if both strings contain the same set of unique characters.\n\n    Parameters\n    ----------\n    str1 : str\n        First input string.\n    str2 : str\n        Second input string.\n\n    Returns\n    -------\n    bool\n        True if both strings have identical character sets; otherwise False.\n\n    Raises\n    ------\n    TypeError\n        If either argument is not a string.\n\n    Examples\n    --------\n    >>> same_chars(\"eabcdzzzz\", \"dddzzzzzzzddeddabc\")\n    True\n    >>> same_chars(\"abcd\", \"dddddddabc\")\n    True\n    >>> same_chars(\"eabcd\", \"dddddddabc\")\n    False\n    \"\"\"\n    # Validation\n    if str1 is None or str2 is None:\n        return False\n    if not isinstance(str1, str) or not isinstance(str2, str):\n        raise TypeError(\"Both arguments must be strings\")\n\n    # Build sets of unique characters\n    set1 = set(str1)\n    set2 = set(str2)\n\n    # Compare and log result\n    result = set1 == set2\n    logger.debug(\"same_chars('%s', '%s') -> %s\", str1, str2, result)\n\n    return result"}
