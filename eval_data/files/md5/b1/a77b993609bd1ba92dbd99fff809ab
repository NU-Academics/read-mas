{"task_id": "HumanEval/91", "solution": "def is_bored(text: str) -> int:\n    count = 0\n    state = 0  # 0: awaiting first non\u2011whitespace char of a sentence\n    is_first_char_I = False\n\n    for ch in text:\n        if ch in '?.!':\n            if state == 1 and is_first_char_I:\n                count += 1\n            state = 0\n            is_first_char_I = False\n        elif ch.isspace():\n            continue\n        else:\n            if state == 0:\n                state = 1\n                is_first_char_I = (ch == 'I')\n\n    if state == 1 and is_first_char_I:\n        count += 1\n\n    return count"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    \"\"\"\n    Return True if any one of the three numbers equals the sum of the other two\n    and all three numbers are integers; otherwise return False.\n    \"\"\"\n    # Check that all inputs are integers\n    if not all(isinstance(v, int) for v in (x, y, z)):\n        return False\n\n    # Check the three possible equalities\n    return (x == y + z) or (y == x + z) or (z == x + y)"}
{"task_id": "HumanEval/93", "solution": "import string\ndef encode(message):\n    vowels = set('aeiou')\n    lower_alpha = string.ascii_lowercase\n    upper_alpha = string.ascii_uppercase\n    result = []\n    for ch in message:\n        if ch.isalpha():\n            swapped = ch.swapcase()\n            if swapped.lower() in vowels:\n                if swapped.islower():\n                    idx = lower_alpha.index(swapped) + 2\n                    new_char = lower_alpha[idx % 26]\n                else:\n                    idx = upper_alpha.index(swapped) + 2\n                    new_char = upper_alpha[idx % 26]\n                result.append(new_char)\n            else:\n                result.append(swapped)\n        else:\n            result.append(ch)\n    return ''.join(result)"}
{"task_id": "HumanEval/94", "solution": "from math import isqrt\nfrom functools import lru_cache\nfrom typing import Iterable\ndef _digit_sum(n: int) -> int:\n    \"\"\"Return the sum of decimal digits of |n|.\"\"\"\n    return sum(int(ch) for ch in str(abs(n)))\ndef skjkasdkd(lst: Iterable[int]) -> int:\n    \"\"\"Find the largest prime in the iterable and return the sum of its digits.\n\n    Parameters\n    ----------\n    lst : Iterable[int]\n        Iterable of integers (positive, negative, or zero).\n\n    Returns\n    -------\n    int\n        Sum of the digits of the largest prime found, or 0 if none.\n    \"\"\"\n    max_prime = None\n    for x in lst:\n        if isinstance(x, int) and _is_prime(x):\n            if max_prime is None or x > max_prime:\n                max_prime = x\n    return _digit_sum(max_prime) if max_prime is not None else 0"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(d):\n    \"\"\"\n    Return True if all keys in the dictionary `d` are strings and\n    either all lowercase or all uppercase. Return False otherwise.\n    An empty dictionary returns False.\n    \"\"\"\n    if not d:\n        return False\n\n    # Check that all keys are strings\n    if not all(isinstance(k, str) for k in d.keys()):\n        return False\n\n    # Determine case of each key\n    lower_keys = [k for k in d if k.islower()]\n    upper_keys = [k for k in d if k.isupper()]\n\n    # Must be either all lower or all upper\n    return bool(lower_keys) != bool(upper_keys) and len(lower_keys) + len(upper_keys) == len(d)"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non\u2011negative\")\n\n    if n <= 2:\n        return []\n\n    sieve = bytearray(b'\\x01') * n\n    sieve[0:2] = b'\\x00\\x00'\n\n    limit = int(n ** 0.5) + 1\n    for i in range(2, limit):\n        if sieve[i]:\n            step = i\n            start = i * i\n            sieve[start:n:step] = b'\\x00' * ((n - start - 1) // step + 1)\n\n    return [i for i in range(2, n) if sieve[i]]"}
