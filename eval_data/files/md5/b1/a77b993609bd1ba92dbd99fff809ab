{"task_id": "HumanEval/64", "solution": "VOWELS = {\n    \"a\", \"e\", \"i\", \"o\", \"u\",\n    \"\u00e1\", \"\u00e9\", \"\u00ed\", \"\u00f3\", \"\u00fa\",\n    \"\u00e0\", \"\u00e8\", \"\u00ec\", \"\u00f2\", \"\u00f9\",\n    \"\u00e4\", \"\u00eb\", \"\u00ef\", \"\u00f6\", \"\u00fc\",\n    \"\u00e2\", \"\u00ea\", \"\u00ee\", \"\u00f4\", \"\u00fb\",\n    \"\u00e3\", \"\u00f5\", \"\u00e5\", \"\u00e6\", \"\u00f8\", \"\u0153\",\n    \"y\", \"\u00ff\", \"\u00fd\",\n}\ndef vowels_count(text: str) -> int:\n    \"\"\"\n    Count the number of vowel characters in ``text``.\n\n    Parameters\n    ----------\n    text : str\n        The string to analyze.\n\n    Returns\n    -------\n    int\n        Number of vowels found in ``text``.\n\n    Raises\n    ------\n    TypeError\n        If ``text`` is not a string.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(f\"Expected a string, got {type(text).__name__}\")\n    count = 0\n    for ch in text:\n        if ch.lower() in VOWELS:\n            count += 1\n    return count"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x: int, shift: int) -> str:\n    \"\"\"Circularly shift the decimal digits of an integer to the right.\n\n    Parameters\n    ----------\n    x : int\n        The integer whose digits will be shifted.\n    shift : int\n        Number of positions to shift the digits to the right.\n        If *shift* is greater than the number of digits in ``x``,\n        the function returns the digits of ``x`` in reverse order.\n\n    Returns\n    -------\n    str\n        The resulting digit string after the circular shift.  The sign\n        of ``x`` is ignored; the function operates on the absolute value.\n\n    Notes\n    -----\n    - A negative ``shift`` value raises ``ValueError``.\n    - ``x`` may be negative; the sign is discarded and the function\n      works on the absolute value.\n    \"\"\"\n    if not isinstance(x, int) or not isinstance(shift, int):\n        raise TypeError(\"x and shift must be integers\")\n    if shift < 0:\n        raise ValueError(\"shift must be non\u2011negative\")\n\n    digits = str(abs(x))\n    n = len(digits)\n\n    if shift > n:\n        return digits[::-1]\n\n    if shift == 0 or shift == n:\n        return digits\n\n    right_part = digits[-shift:]\n    left_part = digits[:-shift]\n    return right_part + left_part"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s: str) -> int:\n    \"\"\"Return the sum of ASCII codes of all uppercase letters in the input string.\n\n    Parameters:\n        s (str): The string to process.\n\n    Returns:\n        int: Sum of ASCII codes of uppercase characters; 0 if none.\n\n    Raises:\n        TypeError: If `s` is not a string.\n\n    Examples:\n        >>> digitSum(\"Hello World!\")\n        1472\n        >>> digitSum(\"abcXYZ123\")\n        219\n        >>> digitSum(\"\")\n        0\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(f\"digitSum expects a string, got {type(s).__name__}\")\n    total = 0\n    for ch in s:\n        if 'A' <= ch <= 'Z':\n            total += ord(ch)\n    return total"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"\n    Calculate the number of mangoes in a basket.\n\n    The input string `s` describes the number of apples and oranges in the\n    format: \"<apples> apples and <oranges> oranges\". The total number of\n    fruits in the basket is given by `n`.  The function returns the\n    count of mangoes, which is `n - apples - oranges`.\n\n    Parameters\n    ----------\n    s : str\n        A string describing the apples and oranges, e.g.\n        \"5 apples and 6 oranges\".\n    n : int\n        The total number of fruits in the basket.\n\n    Returns\n    -------\n    int\n        The number of mangoes.\n\n    Examples\n    --------\n    >>> fruit_distribution(\"5 apples and 6 oranges\", 19)\n    8\n    >>> fruit_distribution(\"0 apples and 1 oranges\", 3)\n    2\n    \"\"\"\n    # Extract all integer numbers from the string\n    numbers = list(map(int, re.findall(r\"\\d+\", s)))\n    if len(numbers) != 2:\n        raise ValueError(\"Input string must contain exactly two integers representing apples and oranges.\")\n    apples, oranges = numbers\n    return n - apples - oranges"}
