{"task_id": "HumanEval/100", "solution": "def make_a_pile(n):\n    \"\"\"\n    Generate a list of stone counts for each level in a pile.\n\n    Each level increases by 2 stones from the previous level, starting at the\n    given integer `n`. The number of levels equals `n`.\n\n    Parameters\n    ----------\n    n : int\n        The starting stone count for the first level. Must be a positive integer.\n\n    Returns\n    -------\n    List[int]\n        A list of stone counts in ascending order.\n\n    Raises\n    ------\n    ValueError\n        If `n` is not an integer greater than zero.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n    return [n + 2 * i for i in range(n)]"}
{"task_id": "HumanEval/101", "solution": "from typing import List, Optional\ndef words_string(input: Optional[str]) -> List[str]:\n    if input is None:\n        return []\n\n    trimmed = input.strip()\n    if not trimmed:\n        return []\n\n    tokens: List[str] = []\n    current_chars: List[str] = []\n\n    for ch in trimmed:\n        if ch == ',' or ch.isspace():\n            if current_chars:\n                tokens.append(''.join(current_chars))\n                current_chars.clear()\n        else:\n            current_chars.append(ch)\n\n    if current_chars:\n        tokens.append(''.join(current_chars))\n\n    return tokens"}
{"task_id": "HumanEval/102", "solution": "def choose_num(x: float, y: float) -> int:\n    \"\"\"\n    Returns the largest even integer in the inclusive range [x, y].\n    If x > y or no even integer exists in the range, returns -1.\n    \"\"\"\n    if x > y:\n        return -1\n\n    # Determine the largest integer <= y\n    upper = int(y)\n    if upper % 2 != 0:\n        upper -= 1  # make it even\n\n    # If upper is less than x or negative, no even integer in range\n    if upper < x or upper < 0:\n        return -1\n\n    return upper"}
{"task_id": "HumanEval/103", "solution": "def validate_range(n: int, m: int) -> bool:\n    \"\"\"Return True if n <= m, else False.\"\"\"\n    return n <= m\ndef compute_sum_and_count(n: int, m: int) -> tuple[int, int]:\n    \"\"\"\n    Uses arithmetic series formula:\n    sum = (count * (n + m)) // 2\n    count = m - n + 1\n    \"\"\"\n    count = m - n + 1\n    sum_val = count * (n + m) // 2\n    return sum_val, count\ndef compute_rounded_average(sum_val: int, count: int) -> int:\n    \"\"\"Computes floating average then rounds half-up.\"\"\"\n    avg = sum_val / count\n    return int(avg + 0.5)\ndef int_to_binary_str(value: int) -> str:\n    \"\"\"Return binary string without '0b' prefix.\"\"\"\n    return bin(value)[2:]\ndef rounded_avg(n: int, m: int) -> int | str:\n    \"\"\"Main function per spec.\"\"\"\n    if not validate_range(n, m):\n        return -1\n    sum_val, count = compute_sum_and_count(n, m)\n    rounded = compute_rounded_average(sum_val, count)\n    return int_to_binary_str(rounded)"}
{"task_id": "HumanEval/104", "solution": "from typing import Any, List\ndef _is_integer_list(obj: Any) -> bool:\n    \"\"\"Check whether obj is a list of integers.\"\"\"\n    if not isinstance(obj, list):\n        return False\n    return all(isinstance(item, int) for item in obj)\ndef _has_even_digit(num: int) -> bool:\n    \"\"\"Determine if an integer contains any even digit.\"\"\"\n    n = abs(num)\n    if n == 0:\n        return True\n    while n:\n        digit = n % 10\n        if digit % 2 == 0:\n            return True\n        n //= 10\n    return False\ndef unique_digits(numbers: List[int]) -> List[int]:\n    \"\"\"Return a list of integers from ``numbers`` that contain no even digits,\n    sorted in ascending order.\n\n    Parameters\n    ----------\n    numbers : list[int]\n        List of integers to filter.\n\n    Returns\n    -------\n    list[int]\n        Sorted list of integers without even digits.\n\n    Raises\n    ------\n    TypeError\n        If ``numbers`` is not a list of integers.\n    \"\"\"\n    if not _is_integer_list(numbers):\n        raise TypeError(\n            f\"Input must be a list of integers; got {type(numbers).__name__}\"\n        )\n\n    filtered: List[int] = [n for n in numbers if not _has_even_digit(n)]\n    return sorted(filtered)"}
{"task_id": "HumanEval/105", "solution": "def by_length(numbers):\n    \"\"\"Return a list of digit names for numbers 1\u20119, sorted descending.\"\"\"\n    digit_to_name = {\n        1: \"one\",\n        2: \"two\",\n        3: \"three\",\n        4: \"four\",\n        5: \"five\",\n        6: \"six\",\n        7: \"seven\",\n        8: \"eight\",\n        9: \"nine\",\n    }\n\n    filtered = [n for n in numbers if 1 <= n <= 9]\n    filtered.sort()\n    filtered.reverse()\n    return [digit_to_name[n] for n in filtered]"}
{"task_id": "HumanEval/106", "solution": "from typing import List\ndef f(n: int) -> List[int]:\n    \"\"\"Generate a list of length `n` where:\n    - For even index i (1\u2011based), the element is i! (factorial of i).\n    - For odd index i, the element is the sum of integers from 1 to i.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    result: List[int] = []\n    fact: int = 1  # 0! base\n    tri: int = 0   # sum of 0\n\n    for i in range(1, n + 1):\n        tri += i\n        if i % 2 == 0:\n            fact *= i\n            result.append(fact)\n        else:\n            result.append(tri)\n\n    return result"}
{"task_id": "HumanEval/107", "solution": "from typing import Tuple\ndef even_odd_palindrome(n: int) -> Tuple[int, int]:\n    \"\"\"\n    Count even- and odd-valued integer palindromes in the inclusive range [1, n].\n\n    Parameters\n    ----------\n    n : int\n        The upper bound of the range (must be >= 1).\n\n    Returns\n    -------\n    Tuple[int, int]\n        A tuple (even_count, odd_count) where\n        even_count is the number of even palindromes in [1, n],\n        odd_count is the number of odd palindromes in [1, n].\n\n    Raises\n    ------\n    ValueError\n        If n is not an integer or is less than 1.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer >= 1\")\n\n    even_count = 0\n    odd_count = 0\n\n    max_len = len(str(n))\n\n    for length in range(1, max_len + 1):\n        half_len = (length + 1) // 2\n        start = 10 ** (half_len - 1)\n        end = 10 ** half_len\n\n        for half in range(start, end):\n            half_str = str(half)\n\n            if length % 2 == 0:\n                pal_str = half_str + half_str[::-1]\n            else:\n                pal_str = half_str + half_str[-2::-1]\n\n            palindrome = int(pal_str)\n\n            if palindrome > n:\n                break\n\n            if palindrome % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return even_count, odd_count"}
{"task_id": "HumanEval/108", "solution": "import collections.abc\nfrom typing import Iterable, Union\ndef _digit_sum(n: int, sign_handling: str) -> int:\n    \"\"\"Compute the digit sum of ``n`` according to ``sign_handling``.\"\"\"\n    abs_str = str(abs(n))\n    sum_digits = sum(int(ch) for ch in abs_str)\n    if sign_handling == \"RAW\":\n        return -sum_digits if n < 0 else sum_digits\n    # sign_handling == \"ABS\"\n    return sum_digits\ndef _is_positive_digit_sum(ds: int) -> bool:\n    \"\"\"Return ``True`` if the digit sum is greater than zero.\"\"\"\n    return ds > 0\ndef count_nums(\n    iterable: Iterable[Union[int, object]],\n    sign_handling: str = \"ABS\",\n) -> int:\n    \"\"\"\n    Count the number of integers in ``iterable`` whose digit sum exceeds zero.\n\n    The digit sum is computed on the absolute value of each integer unless\n    ``sign_handling`` is ``'RAW'``, in which case the sign of the integer is\n    applied after summing its digits.\n\n    Args:\n        iterable: Any iterable yielding integers.\n        sign_handling: Either ``'ABS'`` (default) or ``'RAW'``.\n\n    Returns:\n        The count of numbers whose digit sum is greater than zero.\n\n    Raises:\n        TypeError: If any element of ``iterable`` is not an ``int``.\n        ValueError: If ``sign_handling`` is not ``'ABS'`` or ``'RAW'``.\n    \"\"\"\n    if sign_handling not in {\"ABS\", \"RAW\"}:\n        raise ValueError(\n            f\"sign_handling must be 'ABS' or 'RAW', got {sign_handling!r}\"\n        )\n\n    count = 0\n    for element in iterable:\n        _validate_element(element)\n        ds = _digit_sum(element, sign_handling)\n        if _is_positive_digit_sum(ds):\n            count += 1\n    return count"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(array: list[int]) -> bool:\n    if array is None:\n        raise ValueError(\"Input array cannot be None\")\n    n = len(array)\n    if n <= 1:\n        return True\n    break_count = 0\n    for i in range(n):\n        if array[i] > array[(i + 1) % n]:\n            break_count += 1\n            if break_count > 1:\n                return False\n    if break_count == 0:\n        return True\n    return array[-1] <= array[0]"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"\n    Determine whether it's possible to exchange elements between lst1 and lst2\n    to make all elements in lst1 even.\n\n    Parameters\n    ----------\n    lst1 : list[int]\n        First list of integers.\n    lst2 : list[int]\n        Second list of integers.\n\n    Returns\n    -------\n    str\n        \"YES\" if such an exchange sequence exists, otherwise \"NO\".\n    \"\"\"\n    odd1 = sum(1 for x in lst1 if x % 2 != 0)\n    if odd1 == 0:\n        return \"YES\"\n    return \"YES\" if len(lst2) >= odd1 else \"NO\""}
{"task_id": "HumanEval/111", "solution": "from collections import defaultdict\nfrom typing import Dict\ndef histogram(input_string: str, separator: str = \" \") -> Dict[str, int]:\n    \"\"\"\n    Return the most frequent letter(s) from a space\u2011separated string of lowercase letters.\n\n    The function parses ``input_string`` using ``separator`` (default a single space),\n    validates that each token is a single lowercase alphabetic character, counts\n    occurrences, and returns a dictionary mapping the letter(s) with the highest\n    frequency to that frequency.  If there are multiple letters with the same maximum\n    frequency, the keys are joined by commas in alphabetical order.\n\n    Empty input or input consisting only of separators yields an empty dictionary.\n\n    Parameters\n    ----------\n    input_string : str\n        String containing space\u2011separated lowercase letters.\n    separator : str, optional\n        Character used to split the input string. Defaults to a single space.\n\n    Returns\n    -------\n    Dict[str, int]\n        Dictionary mapping the most frequent letter(s) to their count.\n\n    Raises\n    ------\n    ValueError\n        If any token is not a single lowercase alphabetic character.\n\n    Examples\n    --------\n    >>> histogram(\"a b a c a\")\n    {'a': 3}\n    >>> histogram(\"a b c\")\n    {'a,b,c': 1}\n    >>> histogram(\"\")\n    {}\n    >>> histogram(\"a b 1\")\n    Traceback (most recent call last):\n        ...\n    ValueError: Invalid input: tokens must be single lowercase letters\n    \"\"\"\n    # 1. Strip and handle empty or whitespace\u2011only input\n    stripped = input_string.strip()\n    if not stripped:\n        return {}\n\n    # 2. Split according to separator\n    tokens = stripped.split(separator)\n    if any(token == \"\" for token in tokens):\n        raise ValueError(\"Invalid input: consecutive separators produce empty tokens\")\n\n    # 3. Validate tokens\n    for token in tokens:\n        if len(token) != 1 or not token.islower() or not token.isalpha():\n            raise ValueError(\"Invalid input: tokens must be single lowercase letters\")\n\n    # 4. Count frequencies\n    freq: Dict[str, int] = defaultdict(int)\n    for token in tokens:\n        freq[token] += 1\n\n    # 5. Determine maximum frequency\n    max_count = max(freq.values())\n    max_letters = sorted(k for k, v in freq.items() if v == max_count)\n\n    # 6. Build result dict\n    key = \",\".join(max_letters) if len(max_letters) > 1 else max_letters[0]\n    return {key: max_count}"}
{"task_id": "HumanEval/112", "solution": "from typing import Tuple\ndef reverse_delete(s: str, c: str) -> Tuple[str, bool]:\n    \"\"\"Remove all occurrences of characters in ``c`` from ``s`` and check whether the\n    resulting string is a palindrome.\n\n    Parameters\n    ----------\n    s : str\n        The input string from which characters will be removed.\n    c : str\n        The string containing characters to delete from ``s``.\n\n    Returns\n    -------\n    Tuple[str, bool]\n        cleaned_string : str\n            The string ``s`` after all characters in ``c`` have been removed.\n        is_palindrome : bool\n            ``True`` if ``cleaned_string`` is a palindrome, ``False`` otherwise.\n\n    Raises\n    ------\n    TypeError\n        If ``s`` or ``c`` is not an instance of :class:`str`.\n\n    Notes\n    -----\n    The comparison is case-sensitive. An empty ``cleaned_string`` is considered\n    a palindrome.\n    \"\"\"\n    _validate_inputs(s, c)\n    cleaned = _delete_chars(s, c)\n    palindrome = _is_palindrome(cleaned)\n    return cleaned, palindrome\ndef _delete_chars(s: str, c: str) -> str:\n    remove_set = set(c)\n    return ''.join(ch for ch in s if ch not in remove_set)\ndef _is_palindrome(s: str) -> bool:\n    return s == s[::-1]"}
{"task_id": "HumanEval/113", "solution": "from typing import List\ndef odd_count(numbers: List[int]) -> List[str]:\n    \"\"\"Return a list containing a formatted string that describes the number\n    of odd elements in the provided list.\n\n    Args:\n        numbers: List[int] - list of integers to evaluate.\n\n    Returns:\n        List[str]: A list with a single string following the pattern:\n            \"the number of odd elements {cnt}n the str{cnt}ng {cnt} of the {cnt}nput.\"\n\n    Raises:\n        ValueError: If input is not a list of integers.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise ValueError(\"Input must be a list of integers.\")\n    cnt = 0\n    for num in numbers:\n        if not isinstance(num, int):\n            raise ValueError(\"Input must be a list of integers.\")\n        if num % 2 != 0:\n            cnt += 1\n    pattern = f\"the number of odd elements {cnt}n the str{cnt}ng {cnt} of the {cnt}nput.\"\n    return [pattern]"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums: list[int]) -> int:\n    \"\"\"\n    Return the minimum sum of any non-empty contiguous subarray of nums.\n\n    Parameters:\n        nums (List[int]): List of integers (length >= 1).\n\n    Returns:\n        int: Minimum subarray sum.\n\n    Raises:\n        ValueError: If nums is empty.\n    \"\"\"\n    if not nums:\n        raise ValueError(\"Input array must not be empty\")\n\n    current_min = nums[0]\n    global_min = nums[0]\n\n    for num in nums[1:]:\n        current_min = min(num, current_min + num)\n        global_min = min(global_min, current_min)\n\n    return global_min"}
{"task_id": "HumanEval/115", "solution": "from typing import List\ndef calculate_drops(grid: List[List[int]], capacity: int) -> int:\n    total_drops = 0\n    for row in grid:\n        for volume in row:\n            if volume > 0:\n                drops = (volume + capacity - 1) // capacity\n                total_drops += drops\n    return total_drops\ndef max_fill(grid: List[List[int]], capacity: int) -> int:\n    validate_inputs(grid, capacity)\n    if not grid or all(not row or all(v == 0 for v in row) for row in grid):\n        return 0\n    return calculate_drops(grid, capacity)"}
{"task_id": "HumanEval/116", "solution": "from typing import List, Any\ndef _bit_width(arr: List[int]) -> int:\n    \"\"\"Return the bit width required for two's complement representation if negatives exist.\"\"\"\n    has_negative = any(x < 0 for x in arr)\n    if not has_negative:\n        return 0\n    max_abs = max(abs(x) for x in arr)\n    return max_abs.bit_length() + 1  # add sign bit\ndef _ones_count(x: int, width: int) -> int:\n    \"\"\"Count the number of '1' bits for integer x using the specified two's complement width.\"\"\"\n    if x >= 0:\n        return x.bit_count()\n    mask = (1 << width) - 1\n    return (x & mask).bit_count()\ndef sort_array(arr: List[int]) -> List[int]:\n    \"\"\"\n    Sorts the input list of integers by the number of ones in their binary representation (ascending).\n    Negative numbers are processed using two's complement representation with a bit width that\n    accommodates all input values.\n\n    Parameters\n    ----------\n    arr : List[int]\n        The list of integers to sort.\n\n    Returns\n    -------\n    List[int]\n        A new list containing the sorted integers.\n\n    Raises\n    ------\n    TypeError\n        If the input is not a list or contains non-integer elements.\n    \"\"\"\n    _validate_input(arr)\n    width = _bit_width(arr)\n    # Use stable sort to preserve relative order of equal keys\n    return sorted(arr, key=lambda x: (_ones_count(x, width), x))"}
{"task_id": "HumanEval/117", "solution": "import re\nfrom typing import Callable, List, Optional, Set\n_STOPWORDS: Set[str] = frozenset({\n    \"a\", \"an\", \"the\", \"and\", \"or\", \"but\", \"if\", \"while\", \"with\", \"to\", \"of\", \"in\", \"for\",\n    \"on\", \"at\", \"by\", \"from\", \"up\", \"down\", \"over\", \"under\", \"again\", \"further\", \"then\",\n    \"once\", \"here\", \"there\", \"when\", \"where\", \"why\", \"how\", \"all\", \"any\", \"both\", \"each\",\n    \"few\", \"more\", \"most\", \"other\", \"some\", \"such\", \"no\", \"nor\", \"not\", \"only\", \"own\",\n    \"same\", \"so\", \"than\", \"too\", \"very\", \"can\", \"will\", \"just\", \"don\", \"should\", \"now\",\n})\ndef _tokenize(text: str) -> List[str]:\n    return re.findall(r\"\\b\\w+\\b\", text, flags=re.UNICODE)\ndef _is_stopword(word: str, stopwords: Set[str]) -> bool:\n    return word.lower() in stopwords\ndef select_words(\n    text: str,\n    min_length: int = 1,\n    max_length: Optional[int] = None,\n    exclude_stopwords: bool = False,\n    custom_filter: Optional[Callable[[str], bool]] = None,\n) -> List[str]:\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a string\")\n    _validate_params(min_length, max_length, exclude_stopwords, custom_filter)\n    tokens = _tokenize(text)\n    if custom_filter is not None:\n        tokens = [w for w in tokens if custom_filter(w)]\n    tokens = [w for w in tokens if len(w) >= min_length]\n    if max_length is not None:\n        tokens = [w for w in tokens if len(w) <= max_length]\n    if exclude_stopwords:\n        tokens = [w for w in tokens if not _is_stopword(w, _STOPWORDS)]\n    return sorted(tokens, key=str.lower)"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word: str) -> str:\n    VOWELS = set(\"aeiouAEIOU\")\n    if not isinstance(word, str) or not word:\n        raise ValueError(\"Input must be a non-empty string\")\n    if not word.isalpha():\n        raise ValueError(\"Input must contain only alphabetic characters\")\n    n = len(word)\n    for i in range(n - 1, 0, -1):\n        if word[i] in VOWELS:\n            if i == n - 1:  # vowel at the end\n                continue\n            if word[i - 1] not in VOWELS and word[i + 1] not in VOWELS:\n                return word[i]\n    return \"\""}
{"task_id": "HumanEval/119", "solution": "from typing import List\ndef _compute_balance(s: str) -> tuple[int, int]:\n    \"\"\"Return (total_balance, min_prefix_balance) for string s.\"\"\"\n    bal = 0\n    min_bal = 0\n    for ch in s:\n        bal += 1 if ch == '(' else -1\n        if bal < min_bal:\n            min_bal = bal\n    return bal, min_bal\ndef match_parens(pairs: List[str]) -> str:\n    \"\"\"\n    Determine if two strings of parentheses can be concatenated in any order\n    to produce a balanced parentheses string.\n\n    Parameters\n    ----------\n    pairs : List[str]\n        A list of exactly two strings, each containing only '(' and ')'.\n\n    Returns\n    -------\n    str\n        \"Yes\" if a balanced concatenation exists, otherwise \"No\".\n\n    Raises\n    ------\n    ValueError\n        If the input list does not contain exactly two strings or if any\n        string contains characters other than '(' or ')'.\n    \"\"\"\n    if len(pairs) != 2:\n        raise ValueError(\"Input must be a list of exactly two strings.\")\n    for s in pairs:\n        if any(c not in '()' for c in s):\n            raise ValueError(\"Strings must contain only '(' and ')' characters.\")\n\n    a, b = pairs\n    total_a, min_a = _compute_balance(a)\n    total_b, min_b = _compute_balance(b)\n\n    def order_ok(total1: int, min1: int, total2: int, min2: int) -> bool:\n        return min1 >= 0 and (total1 + min2) >= 0 and (total1 + total2) == 0\n\n    if order_ok(total_a, min_a, total_b, min_b) or \\\n       order_ok(total_b, min_b, total_a, min_a):\n        return \"Yes\"\n    return \"No\""}
{"task_id": "HumanEval/120", "solution": "import heapq\nfrom typing import List, Union\nNumber = Union[int, float]\ndef maximum(arr: List[Number], k: int) -> List[Number]:\n    \"\"\"\n    Return a new list containing the k largest numbers from arr, sorted in descending order.\n    \"\"\"\n    # Input validation\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n    n = len(arr)\n    if k < 0 or k > n:\n        raise ValueError(\"k out of bounds\")\n    if k == 0:\n        return []\n\n    # If k == n, just return sorted copy\n    if k == n:\n        return sorted(arr, reverse=True)\n\n    # Verify all elements are numeric\n    for x in arr:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"arr contains non-numeric element\")\n\n    # Min-heap of size k\n    min_heap: List[Number] = []\n\n    for x in arr:\n        if len(min_heap) < k:\n            heapq.heappush(min_heap, x)\n        elif x > min_heap[0]:\n            heapq.heappushpop(min_heap, x)\n\n    # Extract and sort descending\n    result = list(min_heap)\n    result.sort(reverse=True)\n    return result"}
{"task_id": "HumanEval/121", "solution": "def sum_odd_at_even_indices(input_list):\n    if not isinstance(input_list, list):\n        raise ValueError(\"Input must be a list.\")\n    if len(input_list) == 0:\n        raise ValueError(\"Input list cannot be empty.\")\n    for element in input_list:\n        if not isinstance(element, int):\n            raise ValueError(\"All elements must be integers.\")\n    total = 0\n    for i in range(0, len(input_list), 2):\n        if input_list[i] % 2 != 0:\n            total += input_list[i]\n    return total"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"Return the sum of the elements with at most two digits from the first k elements of arr.\n\n    An element is considered to have at most two digits if its absolute value is less than 100\n    (i.e. |x| < 100).  Negative numbers are treated in the same way; for example, -5\n    contributes -5 to the sum.\n\n    Parameters\n    ----------\n    arr : List[int]\n        Non\u2011empty list of integers.\n    k : int\n        Number of elements to consider from the beginning of ``arr``.\n        Must satisfy ``1 <= k <= len(arr)``.\n\n    Returns\n    -------\n    int\n        Sum of qualifying elements.\n\n    Examples\n    --------\n    >>> add_elements([111, 21, 3, 4000, 5, 6, 7, 8, 9], 4)\n    24\n    \"\"\"\n    if not arr:\n        raise ValueError(\"arr must be non-empty\")\n    if k < 1 or k > len(arr):\n        raise ValueError(\"k must satisfy 1 <= k <= len(arr)\")\n\n    total = 0\n    for x in arr[:k]:\n        if abs(x) < 100:\n            total += x\n    return total"}
{"task_id": "HumanEval/123", "solution": "def collect_odds(seq):\n    \"\"\"Collects all odd numbers from the given sequence into a list.\"\"\"\n    odds = []\n    for value in seq:\n        if value & 1:  # value is odd\n            odds.append(value)\n    return odds\ndef sort_odds(odds):\n    \"\"\"Returns a new list containing the odd numbers sorted in ascending order.\"\"\"\n    return sorted(odds)\ndef get_odd_collatz(n: int):\n    \"\"\"Public API function that returns a sorted list of all odd numbers\n    encountered in the Collatz sequence starting from n, excluding 1.\n\n    Parameters\n    ----------\n    n : int\n        A positive 64\u2011bit unsigned integer.\n\n    Returns\n    -------\n    list[int]\n        Sorted list of odd numbers from the Collatz sequence.\n    \"\"\"\n    _validate(n)\n    odds = collect_odds(collatz_sequence_generator(n))\n    return sort_odds(odds)"}
{"task_id": "HumanEval/124", "solution": "import re\n_DATE_PATTERN = re.compile(r'^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])-(\\d{4})$')\ndef valid_date(date_str: str) -> bool:\n    \"\"\"\n    Validates a date string in the format mm-dd-yyyy.\n    \n    Parameters:\n        date_str (str): Date string to validate.\n    \n    Returns:\n        bool: True if valid, False otherwise.\n    \"\"\"\n    if date_str is None or not isinstance(date_str, str) or date_str == '':\n        return False\n\n    match = _DATE_PATTERN.fullmatch(date_str)\n    if not match:\n        return False\n\n    month = int(match.group(1))\n    day = int(match.group(2))\n    # year is not used for further validation per spec\n\n    # Determine max day for the month\n    if month in (1, 3, 5, 7, 8, 10, 12):\n        max_day = 31\n    elif month in (4, 6, 9, 11):\n        max_day = 30\n    else:  # February\n        max_day = 29\n\n    return 1 <= day <= max_day"}
{"task_id": "HumanEval/125", "solution": "import re\nfrom typing import List, Union\ndef split_words(txt: str) -> Union[List[str], int]:\n    \"\"\"\n    Split a string into words based on whitespace, then commas, or count\n    lowercase ASCII letters at odd zero\u2011based alphabetical positions.\n\n    Parameters\n    ----------\n    txt : str\n        The input string to process.\n\n    Returns\n    -------\n    list[str] | int\n        - If the string contains whitespace, a list of non\u2011empty substrings\n          split on any whitespace sequence.\n        - Else if the string contains commas, a list of non\u2011empty substrings\n          split on commas.\n        - Else, the count of lowercase ASCII letters whose zero\u2011based\n          alphabetical index is odd.\n\n    Raises\n    ------\n    TypeError\n        If `txt` is not an instance of ``str``.\n\n    Examples\n    --------\n    >>> split_words(\"hello world\")\n    ['hello', 'world']\n    >>> split_words(\"hello,world\")\n    ['hello', 'world']\n    >>> split_words(\"abc\")\n    1\n    >>> split_words(\"A,B,C\")\n    []\n    >>> split_words(\"\")\n    0\n    \"\"\"\n    if not isinstance(txt, str):\n        raise TypeError(\"txt must be a string\")\n\n    # 1. Whitespace split\n    ws_parts = [p for p in re.split(r'\\s+', txt) if p]\n    if ws_parts:\n        return ws_parts\n\n    # 2. Comma split\n    comma_parts = [p for p in txt.split(',') if p]\n    if comma_parts:\n        return comma_parts\n\n    # 3. Odd position lowercase count\n    count = 0\n    for c in txt:\n        if 'a' <= c <= 'z':\n            pos = ord(c) - ord('a')\n            if pos % 2 == 1:\n                count += 1\n    return count"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(sequence, reverse=False, cmp=None):\n    \"\"\"\n    Return True if `sequence` is sorted in ascending order, or descending if\n    `reverse=True`. A custom comparator `cmp(a, b)` may be supplied; it must\n    return a negative value if `a < b`, zero if `a == b`, and positive if\n    `a > b`.\n\n    Parameters\n    ----------\n    sequence : iterable\n        The sequence to test for sortedness.\n    reverse : bool, optional\n        If True, check for descending order. Default is False (ascending).\n    cmp : callable, optional\n        A custom comparator function.\n\n    Returns\n    -------\n    bool\n        True if the sequence is sorted according to the specified order.\n\n    Raises\n    ------\n    TypeError\n        If `sequence` is None or not iterable.\n    ValueError\n        If `cmp` is provided but is not callable.\n    \"\"\"\n    if sequence is None:\n        raise TypeError(\"Input sequence cannot be None\")\n    try:\n        it = iter(sequence)\n    except TypeError as exc:\n        raise TypeError(f\"Object of type {type(sequence).__name__} is not iterable\") from exc\n\n    try:\n        prev = next(it)\n    except StopIteration:\n        return True  # Empty sequence is sorted\n\n    if cmp is not None:\n        if not callable(cmp):\n            raise ValueError(\"Comparator must be callable\")\n        if reverse:\n            for curr in it:\n                if cmp(prev, curr) < 0:\n                    return False\n                prev = curr\n        else:\n            for curr in it:\n                if cmp(prev, curr) > 0:\n                    return False\n                prev = curr\n    else:\n        if reverse:\n            for curr in it:\n                if prev < curr:\n                    return False\n                prev = curr\n        else:\n            for curr in it:\n                if prev > curr:\n                    return False\n                prev = curr\n    return True"}
