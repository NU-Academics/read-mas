{"task_id": "HumanEval/128", "solution": "def prod_signs(nums):\n    if not isinstance(nums, (list, tuple)):\n        raise TypeError(\"Input must be a list or tuple\")\n    if not nums:\n        return 1\n    neg_count = 0\n    for num in nums:\n        if not isinstance(num, int):\n            raise TypeError(\"All elements must be integers\")\n        if num == 0:\n            return 0\n        if num < 0:\n            neg_count += 1\n    return 1 if neg_count % 2 == 0 else -1"}
{"task_id": "HumanEval/129", "solution": "import sys\nfrom typing import List, Tuple, Dict\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Return the lexicographically smallest path of length k in an N x N grid\n    where each cell contains a unique integer from 1 to N^2. The path\n    must start at the cell containing value 1 and at each step move to an\n    orthogonally adjacent cell (up, down, left, right). Cells may be\n    revisited.\n\n    Parameters\n    ----------\n    grid : List[List[int]]\n        A square 2D list representing the grid.\n    k : int\n        The desired length of the path (number of cells visited).\n\n    Returns\n    -------\n    List[int]\n        List of values visited along the minimal path.\n\n    Raises\n    ------\n    ValueError\n        If the input grid is not square, contains duplicate or out-of-range\n        values, or if k <= 0.\n    \"\"\"\n    if not grid or not isinstance(grid, list):\n        raise ValueError(\"grid must be a non-empty list of lists\")\n    n = len(grid)\n    for row in grid:\n        if not isinstance(row, list) or len(row) != n:\n            raise ValueError(\"grid must be a square matrix\")\n    total = n * n\n    position_map: Dict[int, Tuple[int, int]] = {}\n    for i in range(n):\n        for j in range(n):\n            val = grid[i][j]\n            if not isinstance(val, int):\n                raise ValueError(\"grid values must be integers\")\n            if val < 1 or val > total:\n                raise ValueError(f\"value {val} out of allowed range 1..{total}\")\n            if val in position_map:\n                raise ValueError(f\"duplicate value {val} found in grid\")\n            position_map[val] = (i, j)\n    if 1 not in position_map:\n        raise ValueError(\"grid must contain the value 1 to start the path\")\n    if not isinstance(k, int) or k <= 0:\n        raise ValueError(\"k must be a positive integer\")\n\n    # Directions: right, left, down, up\n    directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n    path: List[int] = [1]\n    current_pos = position_map[1]\n\n    for _ in range(1, k):\n        best_val = None\n        best_pos = None\n        for dx, dy in directions:\n            nx, ny = current_pos[0] + dx, current_pos[1] + dy\n            if 0 <= nx < n and 0 <= ny < n:\n                neighbor_val = grid[nx][ny]\n                if best_val is None or neighbor_val < best_val:\n                    best_val = neighbor_val\n                    best_pos = (nx, ny)\n        if best_val is None:\n            raise ValueError(\"no valid move available; grid boundaries prevent further steps\")\n        path.append(best_val)\n        current_pos = best_pos\n\n    return path"}
{"task_id": "HumanEval/130", "solution": "def tri(n: int) -> list[int]:\n    \"\"\"Return the first n+1 terms of the Tribonacci sequence.\n\n    The sequence is defined by:\n        tri(0) = 1\n        tri(1) = 3\n        tri(n) = 1 + n/2           if n is even\n        tri(n) = tri(n-1) + tri(n-2) + tri(n+1)  if n is odd\n\n    For odd ``n`` the term ``tri(n+1)`` is always even, therefore its value\n    can be computed directly from the even formula.\n\n    Parameters\n    ----------\n    n : int\n        Non\u2011negative integer specifying the number of terms minus one.\n\n    Returns\n    -------\n    list[int]\n        A list of length ``n + 1`` containing the sequence values from\n        ``tri(0)`` to ``tri(n)``.\n\n    Raises\n    ------\n    TypeError\n        If ``n`` is not an ``int``.\n    ValueError\n        If ``n`` is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non\u2011negative\")\n\n    result: list[int] = []\n    for i in range(n + 1):\n        if i == 0:\n            val = 1\n        elif i == 1:\n            val = 3\n        elif i % 2 == 0:\n            val = 1 + i // 2\n        else:  # i is odd and > 1\n            val = result[i - 1] + result[i - 2] + 1 + (i + 1) // 2\n        result.append(val)\n    return result"}
{"task_id": "HumanEval/131", "solution": "def product_of_odd_digits(number: int) -> int:\n    \"\"\"Return the product of all odd decimal digits in the absolute value of ``number``.\n    If no odd digits are present, the function returns 0.\"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"Input must be an integer\")\n\n    abs_number = abs(number)\n    product = 1\n    has_odd = False\n\n    while abs_number > 0:\n        digit = abs_number % 10\n        if digit % 2 == 1:\n            product *= digit\n            has_odd = True\n        abs_number //= 10\n\n    return product if has_odd else 0"}
{"task_id": "HumanEval/132", "solution": "def is_nested(s: str) -> bool:\n    \"\"\"Return ``True`` if ``s`` contains a valid subsequence of brackets\n    that has at least one nested pair.\n\n    The string ``s`` must consist solely of the characters ``'['`` and\n    ``']'``; otherwise a :class:`ValueError` is raised.\n\n    Parameters\n    ----------\n    s : str\n        Input bracket string.\n\n    Returns\n    -------\n    bool\n        ``True`` if a nested subsequence exists, ``False`` otherwise.\n    \"\"\"\n    # Validate characters\n    if any(ch not in \"[]\" for ch in s):\n        raise ValueError(\"Input string must contain only '[' and ']' characters\")\n\n    n = len(s)\n    if n < 4:  # minimum length for a nested pair \"[[]]\"\n        return False\n\n    # Prefix count of '[' up to but not including position i\n    prefix_open = [0] * (n + 1)\n    for i in range(1, n + 1):\n        prefix_open[i] = prefix_open[i - 1] + (1 if s[i - 1] == '[' else 0)\n\n    # Suffix count of ']' from position i to end (inclusive)\n    suffix_close = [0] * (n + 1)\n    for i in range(n - 1, -1, -1):\n        suffix_close[i] = suffix_close[i + 1] + (1 if s[i] == ']' else 0)\n\n    # Scan for a closing bracket that can close a nested pair\n    for k in range(n):\n        if s[k] == ']':\n            if prefix_open[k] >= 2 and suffix_close[k + 1] >= 1:\n                return True\n    return False"}
{"task_id": "HumanEval/133", "solution": "import math\nfrom typing import Callable, Iterable, Union\ndef sum_squares(\n    data: Iterable[Union[int, float]],\n    round_func: Callable[[float], int] = math.ceil\n) -> int:\n    \"\"\"Return the sum of the squares of the ceiling values of the elements in `data`.\n\n    Parameters\n    ----------\n    data : Iterable[Union[int, float]]\n        Sequence of numeric values to process.\n    round_func : Callable[[float], int], optional\n        Rounding function; defaults to math.ceil.\n\n    Returns\n    -------\n    int\n        Sum of the squares of the ceiled values.\n\n    Raises\n    ------\n    TypeError\n        If `data` is not iterable or `round_func` is not callable.\n    ValueError\n        If an element of `data` is not an int or float.\n    \"\"\"\n    # Validate `data`\n    try:\n        iter(data)\n    except TypeError:\n        raise TypeError(\n            f\"data must be an iterable of numbers, got {type(data).__name__}\"\n        )\n\n    # Validate `round_func`\n    if not callable(round_func):\n        raise TypeError(\n            f\"round_func must be a callable, got {type(round_func).__name__}\"\n        )\n\n    total = 0\n    for element in data:\n        if not isinstance(element, (int, float)):\n            raise ValueError(f\"Non-numeric element encountered: {element!r}\")\n        ceiled = round_func(element)\n        total += ceiled * ceiled\n\n    return total"}
{"task_id": "HumanEval/134", "solution": "import unicodedata\ndef check_if_last_char_is_a_letter(txt: str) -> bool:\n    \"\"\"Determine whether the final character of a given string is a letter that is not part of a longer word.\n\n    Args:\n        txt (str): The text to evaluate.\n\n    Returns:\n        bool: True if the last character is a letter, the preceding character (if any) is a space,\n              and the string does not terminate with a space; False otherwise.\n\n    Raises:\n        TypeError: If txt is not a string.\n    \"\"\"\n    if not isinstance(txt, str):\n        raise TypeError(\"Input must be a string\")\n\n    if not txt:\n        return False\n\n    # Reject strings ending with a space\n    if txt[-1] == ' ':\n        return False\n\n    last_char = txt[-1]\n    # Check if last character is a Unicode letter\n    if not unicodedata.category(last_char).startswith('L'):\n        return False\n\n    # If string length > 1, preceding character must be a space\n    if len(txt) > 1 and txt[-2] != ' ':\n        return False\n\n    return True"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr: list[int]) -> int:\n    \"\"\"\n    Return the largest index i such that arr[i] < arr[i - 1].\n    If no such index exists, return -1.\n\n    Parameters\n    ----------\n    arr : list[int]\n        List of distinct integers.\n\n    Returns\n    -------\n    int\n        Largest index where the element is strictly less than its predecessor,\n        or -1 if the condition is never met.\n    \"\"\"\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i - 1]:\n            return i\n    return -1"}
{"task_id": "HumanEval/136", "solution": "from typing import Iterable, Tuple, Optional, Union\nNumber = Union[int, float]\nResult = Tuple[Optional[int], Optional[int]]\ndef largest_smallest_integers(data: Iterable[Number]) -> Result:\n    \"\"\"\n    Find the largest negative integer and the smallest positive integer in `data`.\n\n    Parameters\n    ----------\n    data : Iterable[Number]\n        An iterable of numeric values.\n\n    Returns\n    -------\n    Result\n        A tuple (largest_negative, smallest_positive). Elements are None if\n        the corresponding value does not exist in the input.\n\n    Raises\n    ------\n    TypeError\n        If `data` is not iterable or contains non-numeric elements.\n    \"\"\"\n    try:\n        iterator = iter(data)\n    except TypeError:\n        raise TypeError(\"data must be an iterable\") from None\n\n    max_neg: Optional[int] = None\n    min_pos: Optional[int] = None\n\n    for x in iterator:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"All elements must be int or float\")\n\n        if isinstance(x, int):\n            if x < 0:\n                if max_neg is None or x > max_neg:\n                    max_neg = x\n            elif x > 0:\n                if min_pos is None or x < min_pos:\n                    min_pos = x\n\n    return (max_neg, min_pos)"}
{"task_id": "HumanEval/137", "solution": "from typing import Union, Optional\ndef compare_one(\n    a: Union[int, float, str],\n    b: Union[int, float, str]\n) -> Optional[Union[int, float, str]]:\n    \"\"\"\n    Compare two numeric inputs and return the larger in its original type.\n    Return None if both represent the same numeric value.\n\n    Parameters\n    ----------\n    a, b\n        Values to compare. Each must be an int, float, or a string\n        containing a decimal number. Decimal separators '.' and ',' are accepted.\n        Leading and trailing whitespace in string inputs is ignored.\n\n    Returns\n    -------\n    Union[int, float, str] | None\n        The larger of the two inputs in its original type, or None if they are equal.\n\n    Raises\n    ------\n    ValueError\n        If either input cannot be interpreted as a number.\n    \"\"\"\n    def _to_float(val: Union[int, float, str], pos: int) -> float:\n        if isinstance(val, (int, float)):\n            return float(val)\n        if isinstance(val, str):\n            stripped = val.strip()\n            normalized = stripped.replace(\",\", \".\")\n            try:\n                return float(normalized)\n            except ValueError:\n                raise ValueError(\n                    f\"Input '{val}' at position {pos} cannot be parsed as a number.\"\n                ) from None\n        raise ValueError(\n            f\"Input '{val}' at position {pos} is not a supported type.\"\n        )\n\n    norm_a = _to_float(a, 1)\n    norm_b = _to_float(b, 2)\n\n    if norm_a > norm_b:\n        return a\n    if norm_b > norm_a:\n        return b\n    return None"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n: int) -> bool:\n    \"\"\"Evaluate whether the given number ``n`` can be written as the sum of exactly\n    four positive even numbers.\n\n    Parameters\n    ----------\n    n : int\n        The target integer.\n\n    Returns\n    -------\n    bool\n        ``True`` if ``n`` is an even integer greater than or equal to 8,\n        otherwise ``False``.\n\n    Examples\n    --------\n    >>> is_equal_to_sum_even(4)\n    False\n    >>> is_equal_to_sum_even(6)\n    False\n    >>> is_equal_to_sum_even(8)\n    True\n    >>> is_equal_to_sum_even(10)\n    True\n    >>> is_equal_to_sum_even(9)\n    False\n    \"\"\"\n    # The sum of four positive even numbers is at least 2+2+2+2 = 8.\n    # Any even integer \u2265 8 can be expressed as such a sum.\n    return isinstance(n, int) and n >= 8 and n % 2 == 0"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n: int) -> int:\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n    product = 1\n    current_fact = 1\n    for k in range(1, n + 1):\n        current_fact *= k\n        product *= current_fact\n    return product"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text: str) -> str:\n    \"\"\"\n    Replace all spaces in a string with underscores, except when there are\n    more than two consecutive spaces. In that case, replace the entire\n    consecutive sequence with a single hyphen.\n\n    Parameters\n    ----------\n    text : str\n        Input string.\n\n    Returns\n    -------\n    str\n        String with spaces replaced according to the rules.\n    \"\"\"\n    # First replace any sequence of three or more spaces with a single hyphen.\n    text = re.sub(r\" {3,}\", \"-\", text)\n\n    # Then replace any remaining single spaces with underscores.\n    text = text.replace(\" \", \"_\")\n\n    return text"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(filename: str) -> bool:\n    \"\"\"Validate a file name against common cross\u2011platform constraints.\"\"\"\n    # Trim leading and trailing whitespace\n    trimmed = filename.strip()\n\n    # Length check\n    if not (1 <= len(trimmed) <= 255):\n        return False\n\n    # Illegal characters set\n    ILLEGAL_CHARS = {'<', '>', ':', '\\\"', '/', '\\\\', '|', '?', '*'}\n    if any(ch in ILLEGAL_CHARS for ch in trimmed):\n        return False\n\n    # Control characters (0x00-0x1F)\n    if any(ord(ch) <= 0x1F for ch in trimmed):\n        return False\n\n    # Trailing dot or space\n    if trimmed[-1] in {' ', '.'}:\n        return False\n\n    # Reserved names on Windows (case\u2011insensitive, without extension)\n    RESERVED_NAMES = {\n        'CON', 'PRN', 'AUX', 'NUL',\n        'COM1', 'COM2', 'COM3', 'COM4', 'COM5', 'COM6', 'COM7', 'COM8', 'COM9',\n        'LPT1', 'LPT2', 'LPT3', 'LPT4', 'LPT5', 'LPT6', 'LPT7', 'LPT8', 'LPT9'\n    }\n    base_name = trimmed.split('.', 1)[0].upper()\n    if base_name in RESERVED_NAMES:\n        return False\n\n    return True"}
{"task_id": "HumanEval/142", "solution": "from typing import List\ndef sum_squares(nums: List[int]) -> int:\n    \"\"\"\n    Sum transformed integers in a list based on their index.\n\n    The transformation rules are:\n    - If the index i is divisible by 3, square the element.\n    - Else if the index i is divisible by 4 (and not by 3), cube the element.\n    - Otherwise, leave the element unchanged.\n\n    Parameters\n    ----------\n    nums : List[int]\n        List of integers to process.\n\n    Returns\n    -------\n    int\n        Sum of all transformed elements.\n\n    Raises\n    ------\n    TypeError\n        If the input is not a list or contains non\u2011integer elements.\n    \"\"\"\n    if not isinstance(nums, list):\n        raise TypeError(\"Input must be a list\")\n\n    total = 0\n    for i, val in enumerate(nums):\n        if not isinstance(val, int):\n            raise TypeError(\"All elements must be integers\")\n\n        if i % 3 == 0:\n            total += val * val\n        elif i % 4 == 0:\n            total += val * val * val\n        else:\n            total += val\n\n    return total"}
{"task_id": "HumanEval/143", "solution": "def _precompute_primes(limit: int) -> list[bool]:\n    \"\"\"Return a list where index i indicates whether i is prime.\"\"\"\n    sieve = [True] * (limit + 1)\n    sieve[0] = sieve[1] = False\n    for p in range(2, int(limit**0.5) + 1):\n        if sieve[p]:\n            step = p\n            start = p * p\n            sieve[start : limit + 1 : step] = [False] * len(range(start, limit + 1, step))\n    return sieve\n_PRIME_TABLE = _precompute_primes(100)\ndef _is_prime(n: int) -> bool:\n    \"\"\"Check if n is a prime number using the pre\u2011computed table.\"\"\"\n    if 0 <= n <= 100:\n        return _PRIME_TABLE[n]\n    return False\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Extract words with prime lengths from a sentence.\n\n    Parameters\n    ----------\n    sentence : str\n        Input sentence containing only letters and spaces, length <= 100.\n\n    Returns\n    -------\n    str\n        Concatenated words (order preserved) whose lengths are prime numbers.\n        Empty string if none.\n\n    Raises\n    ------\n    ValueError\n        If input contains invalid characters or exceeds length limit.\n    \"\"\"\n    _validate_input(sentence)\n    words = sentence.split()\n    prime_words = [w for w in words if _is_prime(len(w))]\n    return \" \".join(prime_words)"}
{"task_id": "HumanEval/144", "solution": "from dataclasses import dataclass\nclass InvalidArgumentException(Exception):\n    pass\ndef gcd(x: int, y: int) -> int:\n    x, y = abs(x), abs(y)\n    while y:\n        x, y = y, x % y\n    return x\ndef normalize_sign(frac: Fraction) -> Fraction:\n    if frac.denominator < 0:\n        return Fraction(-frac.numerator, -frac.denominator)\n    return frac\ndef reduce(frac: Fraction) -> Fraction:\n    if frac.numerator == 0:\n        return Fraction(0, 1)\n    g = gcd(frac.numerator, frac.denominator)\n    return Fraction(frac.numerator // g, frac.denominator // g)\ndef multiply(a: Fraction, b: Fraction) -> Fraction:\n    return Fraction(a.numerator * b.numerator, a.denominator * b.denominator)\ndef is_integer(frac: Fraction) -> bool:\n    return frac.denominator == 1\ndef simplify(fraction1: Fraction, fraction2: Fraction):\n    if fraction1.denominator == 0:\n        raise InvalidArgumentException(\"Denominator cannot be zero in fraction1.\")\n    if fraction2.denominator == 0:\n        raise InvalidArgumentException(\"Denominator cannot be zero in fraction2.\")\n    prod = multiply(fraction1, fraction2)\n    prod = normalize_sign(prod)\n    prod = reduce(prod)\n    if is_integer(prod):\n        return prod.numerator\n    return prod"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Write a function which sorts the given list of integers\n    in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their numeric value.\n\n    For example:\n    >>> order_by_points([1, 11, -1, -11, -12]) == [-1, -11, 1, -12, 11]\n    >>> order_by_points([]) == []\n    \"\"\"\n    def digit_sum(n: int) -> int:\n        return sum(int(d) for d in str(abs(n)))\n\n    return sorted(nums, key=lambda x: (digit_sum(x), x))"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Returns the count of elements in the list that are greater than 10 and\n    whose first and last decimal digits are both odd (1, 3, 5, 7, 9).\n\n    Negative numbers are ignored because they are not greater than 10.\n\n    Args:\n        nums (list[int]): A list of integers.\n\n    Returns:\n        int: The number of elements satisfying the criteria.\n    \"\"\"\n    count = 0\n    odd_digits = {1, 3, 5, 7, 9}\n\n    for n in nums:\n        if n <= 10:\n            continue\n\n        abs_n = abs(n)\n        last_digit = abs_n % 10\n        # Get first digit by dividing by 10 until <10\n        first_digit = abs_n\n        while first_digit >= 10:\n            first_digit //= 10\n\n        if first_digit in odd_digits and last_digit in odd_digits:\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/147", "solution": "from typing import List\ndef get_max_triples(nums: List[int]) -> int:\n    if not isinstance(nums, list):\n        raise TypeError(\"Input must be a list of integers.\")\n    cnt0 = cnt1 = cnt2 = 0\n    for x in nums:\n        if not isinstance(x, int):\n            raise TypeError(\"All elements of nums must be integers.\")\n        r = x % 3\n        if r == 0:\n            cnt0 += 1\n        elif r == 1:\n            cnt1 += 1\n        else:  # r == 2\n            cnt2 += 1\n    triples_from_0 = cnt0 // 3\n    pairs_12 = min(cnt1, cnt2)\n    rem1 = cnt1 - pairs_12\n    rem2 = cnt2 - pairs_12\n    triples_from_1 = rem1 // 3\n    triples_from_2 = rem2 // 3\n    return triples_from_0 + pairs_12 + triples_from_1 + triples_from_2"}
{"task_id": "HumanEval/148", "solution": "from typing import Tuple\n_PLANET_ORDER: Tuple[str, ...] = (\n    \"Mercury\",\n    \"Venus\",\n    \"Earth\",\n    \"Mars\",\n    \"Jupiter\",\n    \"Saturn\",\n    \"Uranus\",\n    \"Neptune\",\n)\ndef _normalize(name: str) -> str:\n    return name.strip().title()\ndef bf(planet_a: str, planet_b: str) -> Tuple[str, ...]:\n    \"\"\"Return the planets that lie strictly between two given planets in\n    order of increasing distance from the Sun.\n\n    Parameters\n    ----------\n    planet_a : str\n        Name of the first planet.\n    planet_b : str\n        Name of the second planet.\n\n    Returns\n    -------\n    Tuple[str, ...]\n        A tuple of intermediate planet names, or an empty tuple if either\n        input is not a valid planet name.\n\n    Examples\n    --------\n    >>> bf(\"Earth\", \"Mars\")\n    ('Mars',)\n    >>> bf(\"Mars\", \"Earth\")\n    ('Mars',)\n    >>> bf(\"Earth\", \"Earth\")\n    ()\n    >>> bf(\"Pluto\", \"Earth\")\n    ()\n    \"\"\"\n    a_norm = _normalize(planet_a)\n    b_norm = _normalize(planet_b)\n\n    try:\n        idx_a = _PLANET_ORDER.index(a_norm)\n        idx_b = _PLANET_ORDER.index(b_norm)\n    except ValueError:\n        return ()\n\n    start, end = sorted((idx_a, idx_b))\n    intermediate = _PLANET_ORDER[start + 1:end]\n    return tuple(intermediate)"}
{"task_id": "HumanEval/149", "solution": "from typing import List\ndef sorted_list_sum(strings: List[str]) -> List[str]:\n    \"\"\"\n    Filters out odd-length strings from the input list and returns a new list\n    sorted by string length (ascending) and alphabetically for ties.\n\n    Parameters:\n        strings (List[str]): The input list of strings.\n\n    Returns:\n        List[str]: A new list containing even-length strings sorted as\n        specified.\n    \"\"\"\n    even_strings = [s for s in strings if len(s) % 2 == 0]\n    return sorted(even_strings, key=lambda s: (len(s), s))"}
{"task_id": "HumanEval/150", "solution": "import math\nfrom typing import Any\ndef is_prime(n: int) -> bool:\n    \"\"\"\n    Determine whether the given integer n is a prime number.\n\n    Parameters\n    ----------\n    n : int\n        Integer to test for primality.\n\n    Returns\n    -------\n    bool\n        True if n is prime, False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If n is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    limit = int(math.isqrt(n))\n    i = 3\n    while i <= limit:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\ndef x_or_y(n: int, x: Any, y: Any) -> Any:\n    \"\"\"\n    Return x if n is a prime number, otherwise return y.\n\n    Parameters\n    ----------\n    n : int\n        The integer to test for primality.\n    x : Any\n        Value returned if n is prime.\n    y : Any\n        Value returned if n is not prime.\n\n    Returns\n    -------\n    Any\n        x if n is prime, otherwise y.\n\n    Raises\n    ------\n    TypeError\n        If n is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n\n    if is_prime(n):\n        return x\n    return y"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(values):\n    \"\"\"Return the sum of squares of all odd, non\u2011negative integers in `values`.\n\n    Parameters\n    ----------\n    values : Iterable\n        Any iterable of values.\n\n    Returns\n    -------\n    int\n        Sum of squares of qualifying values, or 0 if none.\n    \"\"\"\n    total = 0\n    for val in values:\n        if isinstance(val, int) and val >= 0 and val % 2 != 0:\n            total += val * val\n        elif isinstance(val, float) and val.is_integer():\n            int_val = int(val)\n            if int_val >= 0 and int_val % 2 != 0:\n                total += int_val * int_val\n    return total"}
{"task_id": "HumanEval/152", "solution": "from typing import Sequence, List, Union\ndef compare(\n    game: Sequence[Union[int, float]],\n    guess: Sequence[Union[int, float]],\n) -> List[Union[int, float]]:\n    \"\"\"\n    Compare two numeric sequences of equal length.\n\n    Parameters\n    ----------\n    game : Sequence[Union[int, float]]\n        The reference list of scores.\n    guess : Sequence[Union[int, float]]\n        The list of guessed scores to compare against `game`.\n\n    Returns\n    -------\n    List[Union[int, float]]\n        A list where each element is:\n            0                if guess[i] == game[i]\n            abs(guess[i]-game[i]) otherwise.\n\n    Raises\n    ------\n    TypeError\n        If either input is not a sequence or contains non\u2011numeric elements.\n    ValueError\n        If the sequences have different lengths.\n\n    Examples\n    --------\n    >>> compare([10, 20, 30], [10, 25, 27])\n    [0, 5, 3]\n    \"\"\"\n    # Validate input types (FR1)\n    if (\n        not isinstance(game, Sequence)\n        or not isinstance(guess, Sequence)\n        or isinstance(game, (str, bytes))\n        or isinstance(guess, (str, bytes))\n    ):\n        raise TypeError(\"Both 'game' and 'guess' must be non-string sequences.\")\n\n    # Validate length (FR2)\n    if len(game) != len(guess):\n        raise ValueError(\"'game' and 'guess' must have the same length.\")\n\n    # Prepare result list\n    result: List[Union[int, float]] = []\n\n    # Iterate and validate element types (FR3) while computing differences (FR4)\n    for idx, (g_val, guess_val) in enumerate(zip(game, guess)):\n        if not isinstance(g_val, (int, float)) or not isinstance(guess_val, (int, float)):\n            raise TypeError(f\"Element at index {idx} is not numeric.\")\n        if guess_val == g_val:\n            result.append(0)\n        else:\n            result.append(abs(guess_val - g_val))\n\n    return result"}
{"task_id": "HumanEval/153", "solution": "def strongest_extension(class_name, extensions):\n    \"\"\"Return the strongest extension for a given class.\n\n    The *strength* of an extension is defined as the number of uppercase\n    letters minus the number of lowercase letters in the extension string.\n\n    Parameters\n    ----------\n    class_name : str\n        The name of the base class.\n    extensions : Iterable[str]\n        Candidate extensions.\n\n    Returns\n    -------\n    str\n        ``\"{class_name}.{extension}\"`` for the strongest extension, or an\n        empty string if *extensions* is empty.\n    \"\"\"\n    best_strength = None\n    best_extension = None\n\n    for ext in extensions:\n        cap = sum(1 for ch in ext if ch.isupper())\n        sm = sum(1 for ch in ext if ch.islower())\n        strength = cap - sm\n\n        if best_strength is None or strength > best_strength:\n            best_strength = strength\n            best_extension = ext\n        # tie: keep the earlier one (no action)\n\n    if best_extension is None:\n        return \"\"\n\n    return f\"{class_name}.{best_extension}\""}
{"task_id": "HumanEval/154", "solution": "def _build_double_word2(word2: str) -> str:\n    \"\"\"Return the concatenation of *word2* with itself.\"\"\"\n    return word2 + word2\ndef _compute_prefix_hashes(s: str, base: int, mod: int) -> list[int]:\n    \"\"\"Compute prefix hashes for string *s* using the given base and modulus.\"\"\"\n    n = len(s)\n    pref = [0] * (n + 1)\n    h = 0\n    for i, ch in enumerate(s, 1):\n        h = (h * base + ord(ch)) % mod\n        pref[i] = h\n    return pref\ndef _prepare_hashes(word2: str) -> set[tuple[int, int]]:\n    \"\"\"Compute hash set of all cyclic rotations of *word2*.\"\"\"\n    base = 911382323\n    mod1 = 1_000_000_007\n    mod2 = 1_000_000_009\n    m = len(word2)\n    double_word2 = _build_double_word2(word2)\n\n    pow1 = pow(base, m, mod1)\n    pow2 = pow(base, m, mod2)\n\n    pref1 = _compute_prefix_hashes(double_word2, base, mod1)\n    pref2 = _compute_prefix_hashes(double_word2, base, mod2)\n\n    hashes: set[tuple[int, int]] = set()\n    for i in range(m):\n        h1 = (pref1[i + m] - pref1[i] * pow1) % mod1\n        h2 = (pref2[i + m] - pref2[i] * pow2) % mod2\n        hashes.add((h1, h2))\n    return hashes\ndef _search_in_word1(word1: str, rotation_hashes: set[tuple[int, int]], m: int) -> bool:\n    \"\"\"Search *word1* for any substring that matches a rotation hash.\"\"\"\n    base = 911382323\n    mod1 = 1_000_000_007\n    mod2 = 1_000_000_009\n    pow1 = pow(base, m, mod1)\n    pow2 = pow(base, m, mod2)\n\n    pref1 = _compute_prefix_hashes(word1, base, mod1)\n    pref2 = _compute_prefix_hashes(word1, base, mod2)\n\n    for i in range(len(word1) - m + 1):\n        h1 = (pref1[i + m] - pref1[i] * pow1) % mod1\n        h2 = (pref2[i + m] - pref2[i] * pow2) % mod2\n        if (h1, h2) in rotation_hashes:\n            candidate = word1[i : i + m]\n            # Verify with actual string containment to avoid hash collision\n            if candidate in _build_double_word2(word2):\n                return True\n    return False\ndef cycpattern_check(word1: str, word2: str) -> bool:\n    \"\"\"\n    Return True if any cyclic rotation of ``word2`` occurs as a substring of ``word1``.\n\n    Args:\n        word1: The string to search within.\n        word2: The string whose rotations are searched for.\n\n    Returns:\n        True if a rotation of ``word2`` is found in ``word1``, False otherwise.\n\n    Raises:\n        TypeError: If either argument is not a string.\n    \"\"\"\n    if not isinstance(word1, str) or not isinstance(word2, str):\n        raise TypeError(\"Both arguments must be of type 'str'\")\n\n    m = len(word2)\n    n = len(word1)\n\n    if m == 0 or n == 0 or m > n:\n        return False\n\n    rotation_hashes = _prepare_hashes(word2)\n    return _search_in_word1(word1, rotation_hashes, m)"}
{"task_id": "HumanEval/155", "solution": "from typing import Tuple\ndef _count_digits(number: int) -> Tuple[int, int]:\n    \"\"\"Count even and odd digits of a positive integer.\"\"\"\n    even = odd = 0\n    while number > 0:\n        digit = number % 10\n        if digit % 2 == 0:\n            even += 1\n        else:\n            odd += 1\n        number //= 10\n    return even, odd\ndef even_odd_count(number: int) -> Tuple[int, int]:\n    \"\"\"\n    Return a tuple (even_count, odd_count) representing the number of\n    even and odd digits in the absolute value of the input integer.\n\n    Parameters\n    ----------\n    number : int\n        The integer to analyze.\n\n    Returns\n    -------\n    Tuple[int, int]\n        (even_count, odd_count). Zero is treated as an even digit.\n\n    Raises\n    ------\n    TypeError\n        If *number* is not an instance of int.\n\n    Examples\n    --------\n    >>> even_odd_count(12345)\n    (2, 3)\n    >>> even_odd_count(-24680)\n    (5, 0)\n    >>> even_odd_count(0)\n    (0, 0)\n    \"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"Input must be an integer.\")\n    if number == 0:\n        return 0, 0\n    return _count_digits(abs(number))"}
{"task_id": "HumanEval/156", "solution": "ROMAN_MAP = [\n    (1000, 'm'),\n    (900,  'cm'),\n    (500,  'd'),\n    (400,  'cd'),\n    (100,  'c'),\n    (90,   'xc'),\n    (50,   'l'),\n    (40,   'xl'),\n    (10,   'x'),\n    (9,    'ix'),\n    (5,    'v'),\n    (4,    'iv'),\n    (1,    'i'),\n]\ndef int_to_mini_roman(n: int) -> str:\n    if not isinstance(n, int):\n        raise TypeError(\"int_to_mini_roman expects an integer\")\n    if n < 1 or n > 1000:\n        raise ValueError(\"input must be in the range 1\u20131000\")\n    result = []\n    for value, symbol in ROMAN_MAP:\n        while n >= value:\n            result.append(symbol)\n            n -= value\n    return ''.join(result)"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a: float, b: float, c: float) -> bool:\n    \"\"\"\n    Determine whether three side lengths form a right\u2011angled triangle.\n\n    Parameters\n    ----------\n    a, b, c : float\n        Lengths of the sides of a triangle. Values must be positive.\n\n    Returns\n    -------\n    bool\n        True if the sides satisfy the Pythagorean theorem for any ordering,\n        False otherwise.\n\n    Notes\n    -----\n    The function first verifies that the sides can form a triangle using the\n    triangle inequality. It then sorts the sides so that the largest side is\n    considered the hypotenuse and checks if the sum of the squares of the two\n    shorter sides equals the square of the longest side, within a tolerance\n    to account for floating\u2011point inaccuracies.\n    \"\"\"\n    # Validate input\n    if any(side <= 0 for side in (a, b, c)):\n        return False\n\n    # Triangle inequality check\n    if (a + b <= c) or (a + c <= b) or (b + c <= a):\n        return False\n\n    # Sort sides so that c is the largest\n    sides = sorted([a, b, c])\n    x, y, z = sides  # x <= y <= z\n\n    # Use a tolerance for floating\u2011point comparison\n    tolerance = 1e-9\n    return abs(x**2 + y**2 - z**2) <= tolerance"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Return the word with the maximum number of unique characters.\n    If multiple words tie, return the lexicographically smallest.\n    If the input list is empty, return an empty string.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique = -1\n    best_word = \"\"\n    for word in words:\n        unique_count = len(set(word))\n        if unique_count > max_unique:\n            max_unique = unique_count\n            best_word = word\n        elif unique_count == max_unique and word < best_word:\n            best_word = word\n    return best_word"}
{"task_id": "HumanEval/159", "solution": "from typing import List\ndef eat(number: int, need: int, remaining: int) -> List[int]:\n    \"\"\"\n    Parameters:\n        number    (int): Total quantity available before consumption.\n        need      (int): Desired amount to consume.\n        remaining (int): Amount already set aside as remaining.\n\n    Returns:\n        List[int]: [total_eaten, new_remaining]\n    \"\"\"\n    # Type validation\n    if not isinstance(number, int):\n        raise TypeError(\"parameter number must be an integer\")\n    if not isinstance(need, int):\n        raise TypeError(\"parameter need must be an integer\")\n    if not isinstance(remaining, int):\n        raise TypeError(\"parameter remaining must be an integer\")\n\n    # Value validation\n    if number < 0:\n        raise ValueError(\"parameter number cannot be negative\")\n    if need < 0:\n        raise ValueError(\"parameter need cannot be negative\")\n    if remaining < 0:\n        raise ValueError(\"parameter remaining cannot be negative\")\n\n    if remaining > number:\n        raise ValueError(\"remaining cannot exceed number\")\n\n    # Compute possible amount to eat\n    available = number - remaining\n    possible_to_eat = min(need, available)\n\n    total_eaten = possible_to_eat\n    new_remaining = remaining + possible_to_eat\n\n    return [total_eaten, new_remaining]"}
{"task_id": "HumanEval/160", "solution": "from decimal import Decimal\nfrom typing import List, Union, Iterable\nNumber = Union[int, float, Decimal]\nToken = Union[Number, str]\nprecedence = {\n    '^': 4,\n    '*': 3,\n    '/': 3,\n    '+': 2,\n    '-': 2,\n    '(': 1,\n    ')': 1\n}\nassociativity = {\n    '^': 'right',\n    '*': 'left',\n    '/': 'left',\n    '+': 'left',\n    '-': 'left'\n}\ndef do_algebra(operands: List[Number], operators: List[str]) -> Number:\n    if len(operands) == 0:\n        raise ValueError(\"Operands list cannot be empty\")\n    if len(operators) != len(operands) - 1:\n        raise ValueError(\"Operators list length must be operands length - 1\")\n    for op in operators:\n        if op not in ('+', '-', '*', '/', '^'):\n            raise ValueError(f\"Unsupported operator: {op}\")\n\n    tokens: List[Token] = []\n    for i, operand in enumerate(operands):\n        tokens.append(operand)\n        if i < len(operators):\n            tokens.append(operators[i])\n\n    postfix = _shunting_yard(tokens)\n    return _evaluate_postfix(postfix)\ndef _shunting_yard(tokens: Iterable[Token]) -> List[Token]:\n    op_stack: List[str] = []\n    output: List[Token] = []\n\n    for token in tokens:\n        if isinstance(token, (int, float, Decimal)):\n            output.append(token)\n        else:\n            if token == '(':\n                op_stack.append(token)\n            elif token == ')':\n                while op_stack and op_stack[-1] != '(':\n                    output.append(op_stack.pop())\n                if not op_stack:\n                    raise ValueError(\"Mismatched parentheses\")\n                op_stack.pop()\n            else:\n                while (op_stack and op_stack[-1] != '(' and\n                       (precedence[op_stack[-1]] > precedence[token] or\n                        (precedence[op_stack[-1]] == precedence[token] and\n                         associativity[token] == 'left'))):\n                    output.append(op_stack.pop())\n                op_stack.append(token)\n\n    while op_stack:\n        if op_stack[-1] in ('(', ')'):\n            raise ValueError(\"Mismatched parentheses\")\n        output.append(op_stack.pop())\n\n    return output\ndef _evaluate_postfix(postfix: Iterable[Token]) -> Number:\n    stack: List[Number] = []\n\n    for token in postfix:\n        if isinstance(token, (int, float, Decimal)):\n            stack.append(token)\n        else:\n            if len(stack) < 2:\n                raise ValueError(\"Insufficient operands\")\n            right = stack.pop()\n            left = stack.pop()\n            stack.append(_apply_operator(left, right, token))\n\n    if len(stack) != 1:\n        raise ValueError(\"Invalid expression\")\n    return stack[0]\ndef _apply_operator(left: Number, right: Number, op: str) -> Number:\n    if op == '+':\n        return left + right\n    if op == '-':\n        return left - right\n    if op == '*':\n        return left * right\n    if op == '/':\n        if right == 0:\n            raise ZeroDivisionError(\"Division by zero\")\n        return left / right\n    if op == '^':\n        return left ** right\n    raise ValueError(f\"Unknown operator: {op}\")"}
{"task_id": "HumanEval/161", "solution": "def solve(s: str) -> str:\n    \"\"\"Toggle case of letters in `s`. If `s` contains no letters,\n    return the reversed string.\"\"\"\n    if not s:\n        return \"\"\n    # Detect if there is at least one alphabetic character\n    has_letter = any(ch.isalpha() for ch in s)\n    if has_letter:\n        toggled = []\n        for ch in s:\n            if ch.isalpha():\n                toggled.append(ch.upper() if ch.islower() else ch.lower())\n            else:\n                toggled.append(ch)\n        return \"\".join(toggled)\n    return s[::-1]"}
{"task_id": "HumanEval/162", "solution": "import hashlib\nfrom typing import Optional\ndef string_to_md5(input_str: str) -> Optional[str]:\n    \"\"\"Compute the MD5 hash of a non\u2011empty string.\n\n    Parameters\n    ----------\n    input_str : str\n        The string to hash. Must be a Python string.\n\n    Returns\n    -------\n    Optional[str]\n        A 32\u2011character hexadecimal MD5 digest of ``input_str``. Returns\n        ``None`` if ``input_str`` is empty.\n\n    Raises\n    ------\n    TypeError\n        If ``input_str`` is not an instance of ``str``.\n    \"\"\"\n    if not isinstance(input_str, str):\n        raise TypeError(\"input must be a string\")\n    if input_str == \"\":\n        return None\n    md5_obj = hashlib.md5()\n    md5_obj.update(input_str.encode(\"utf-8\"))\n    return md5_obj.hexdigest()"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a: int, b: int) -> list[int]:\n    \"\"\"Return all integers between a and b inclusive where every decimal digit is even.\n    Raises TypeError or ValueError on invalid input.\n    \"\"\"\n    # Validation\n    for val in (a, b):\n        if not isinstance(val, int):\n            raise TypeError(f\"Input {val!r} must be an integer.\")\n        if val <= 0:\n            raise ValueError(f\"Input {val!r} must be a positive integer.\")\n\n    # Normalize range\n    start, end = (a, b) if a <= b else (b, a)\n\n    result = []\n    for n in range(start, end + 1):\n        if _all_digits_even(n):\n            result.append(n)\n    return result\ndef _all_digits_even(n: int) -> bool:\n    \"\"\"Return True if every decimal digit of n is even.\"\"\"\n    while n:\n        if (n % 10) % 2 != 0:\n            return False\n        n //= 10\n    return True"}
