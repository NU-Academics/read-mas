{"task_id": "Mbpp/92", "solution": "def _extract_digits(number: int) -> list[int]:\n    \"\"\"Extract digits from number into list.\"\"\"\n    return [int(d) for d in str(number)]\n\ndef _validate_minimum_digits(digits: list[int]) -> bool:\n    \"\"\"Check if digit list has at least 3 elements.\"\"\"\n    return len(digits) >= 3\n\ndef _check_alternating_pattern(digits: list[int]) -> bool:\n    \"\"\"Validate alternating pattern between exactly two different digits.\"\"\"\n    if len(digits) < 2:  # Should be caught by _validate_minimum_digits, but defensive check\n        return False\n\n    digit_a = digits[0]\n    digit_b = digits[1]\n\n    # Undulating numbers must alternate between exactly two *different* digits.\n    if digit_a == digit_b:\n        return False\n\n    for i in range(len(digits)):\n        if i % 2 == 0:  # Even index, should match digit_a\n            if digits[i] != digit_a:\n                return False\n        else:  # Odd index, should match digit_b\n            if digits[i] != digit_b:\n                return False\n    return True\n\ndef is_undulating(number: int) -> bool:\n    \"\"\"\n    Check if a number is undulating (alternates between exactly two different digits).\n\n    Args:\n        number: Positive integer to check\n\n    Returns:\n        bool: True if undulating, False otherwise\n    \"\"\"\n    digits = _extract_digits(number)\n\n    if not _validate_minimum_digits(digits):\n        return False\n\n    return _check_alternating_pattern(digits)"}
{"task_id": "Mbpp/96", "solution": "def divisor(n):\n    \"\"\"\n    Calculates the number of divisors for a given positive integer.\n    Includes 1 and the number itself in the count.\n    \"\"\"\n    count = 0\n    for i in range(1, int(n**0.5) + 1):\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n    return count"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists):\n    \"\"\"\n    Calculates the length of the smallest list within a given list of lists.\n    Assumes the input is a list of lists and handles empty sublists.\n    \"\"\"\n    if not list_of_lists:\n        return 0 \n    \n    lengths = [len(sublist) for sublist in list_of_lists]\n    return min(lengths)"}
{"task_id": "Mbpp/97", "solution": "from typing import List, Dict\nimport collections\n\ndef frequency_lists(list_of_lists: List[List[int]]) -> Dict[int, int]:\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n    \"\"\"\n    flattened_list = [item for sublist in list_of_lists for item in sublist]\n    frequency_map = collections.Counter(flattened_list)\n    return dict(frequency_map)"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(tuple_list):\n    \"\"\"\n    Finds the tuple with the smallest second value and returns its first value.\n    Assumes a non-empty list of tuples where each tuple has at least two elements and the second element is comparable.\n    \"\"\"\n    min_second_value = tuple_list[0][1]\n    result_first_value = tuple_list[0][0]\n\n    for first_val, second_val in tuple_list[1:]:\n        if second_val < min_second_value:\n            min_second_value = second_val\n            result_first_value = first_val\n            \n    return result_first_value"}
{"task_id": "Mbpp/98", "solution": "import math\n\ndef multiply_num(numbers):\n    \"\"\"\n    Multiplies all numbers in a sequence and divides the product by the sequence's length.\n    Handles various numeric types and negative values.\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input sequence cannot be empty.\")\n\n    product = 1\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise ValueError(\"All elements in the sequence must be numbers.\")\n        product *= num\n\n    return product / len(numbers)"}
