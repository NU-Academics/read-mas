{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Calculate the Bell number for a given non-negative integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return 1\n    if n == 1:\n        return 1\n\n    # Using the Bell triangle method\n    bell = [[0] * (n + 1) for _ in range(n + 1)]\n    bell[0][0] = 1\n\n    for i in range(1, n + 1):\n        # The first element in each row is the last element of the previous row\n        bell[i][0] = bell[i - 1][i - 1]\n        for j in range(1, i + 1):\n            # Each subsequent element is the sum of the element above it and the element to its left\n            bell[i][j] = bell[i - 1][j - 1] + bell[i][j - 1]\n\n    return bell[n][0]"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic (either non-decreasing or non-increasing).\n    An empty array or a single-element array is considered monotonic.\n    \"\"\"\n    def _is_increasing(arr: list) -> bool:\n        \"\"\"\n        Helper to check if the array is monotonically non-decreasing.\n        \"\"\"\n        for i in range(len(arr) - 1):\n            if arr[i] > arr[i+1]:\n                return False\n        return True\n\n    def _is_decreasing(arr: list) -> bool:\n        \"\"\"\n        Helper to check if the array is monotonically non-increasing.\n        \"\"\"\n        for i in range(len(arr) - 1):\n            if arr[i] < arr[i+1]:\n                return False\n        return True\n\n    if len(array) <= 1:\n        return True\n\n    return _is_increasing(array) or _is_decreasing(array)"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list, sublist):\n    \"\"\"\n    Checks if a sublist exists as a consecutive sequence within a main list.\n    \"\"\"\n    if not sublist:\n        return True\n\n    if len(sublist) > len(main_list):\n        return False\n\n    for i in range(len(main_list) - len(sublist) + 1):\n        if main_list[i:i + len(sublist)] == sublist:\n            return True\n\n    return False"}
