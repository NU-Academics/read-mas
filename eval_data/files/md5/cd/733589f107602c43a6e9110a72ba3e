{"task_id": "Mbpp/432", "solution": "from src.input_validator import InputValidator\n\n_recorder = None\n_RECORDING_ENABLED = False\ntry:\n    from src.recorder import Recorder\n    _recorder = Recorder()\n    _RECORDING_ENABLED = True\nexcept ImportError:\n    pass\n\n\ndef median_trapezium(a, b, c):\n    \"\"\"\n    Compute the median length of a trapezium using bases a and b.\n    The parameter c is accepted but ignored in the computation.\n    \"\"\"\n    validator = InputValidator()\n    validator.validateNumeric(a, b, c)\n\n    result = (a + b) / 2\n\n    if _RECORDING_ENABLED and _recorder:\n        _recorder.record_call(a, b, c, result)\n\n    return result"}
{"task_id": "Mbpp/433", "solution": "from typing import Sequence, List, Iterator\n\nclass Number:\n    \"\"\"Minimal wrapper for numeric value.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n\nclass Array:\n    \"\"\"Minimal wrapper representing the input array with convenience operations.\"\"\"\n    def __init__(self, elements: Sequence[float]):\n        self.elements: List[Number] = [Number(e) for e in elements]\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def __iter__(self) -> Iterator[float]:\n        \"\"\"Iterates over the raw numeric values contained in the array.\"\"\"\n        for num_obj in self.elements:\n            yield num_obj.value\n\nclass Result:\n    \"\"\"Hold boolean outcome of CheckGreater computation.\"\"\"\n    def __init__(self, isGreater: bool = False):\n        self.isGreater = isGreater\n\nclass CheckGreater:\n    \"\"\"Encapsulates logic to determine whether a value is strictly greater than every element in an array.\"\"\"\n    def __init__(self, array: Sequence[float], value: float):\n        self.array = Array(array)\n        self.value = Number(value)\n        self.result = Result(False)\n\n    def check(self) -> bool:\n        \"\"\"Determines if the instance's value is strictly greater than all elements in its array.\"\"\"\n        for e_value in self.array:\n            if self.value.value <= e_value:\n                self.result.isGreater = False\n                return False\n        self.result.isGreater = True\n        return True\n\ndef check_greater(array: Sequence[float], value: float) -> bool:\n    \"\"\"Public API that returns True iff value is strictly greater than every element of array.\"\"\"\n    cg = CheckGreater(array, value)\n    return cg.check()"}
