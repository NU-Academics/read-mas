{"task_id": "Mbpp/84", "solution": "from typing import Dict\n\nclass Error:\n    \"\"\"Represents a structured error with a message and code.\"\"\"\n    def __init__(self, message: str, code: int) -> None:\n        self.message = message\n        self.code = code\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to the sequence function.\"\"\"\n    def __init__(self, error: Error) -> None:\n        super().__init__(error.message)\n        self.error = error\n\nclass InputValidator:\n    \"\"\"Validates input parameters for the Newman-Conway sequence.\"\"\"\n    def validatePositiveInteger(self, n: int) -> None:\n        \"\"\"Raises InvalidInputError if n is not a positive integer.\"\"\"\n        if not isinstance(n, int):\n            raise InvalidInputError(Error(\"Input must be an integer.\", 1001))\n        if n <= 0:\n            raise InvalidInputError(Error(\"Input must be a positive integer.\", 1002))\n\nclass NewmanConwaySequence:\n    \"\"\"Calculates terms of the Newman-Conway sequence.\"\"\"\n    def baseCase(self, n: int) -> int:\n        \"\"\"Returns the base case value for n=1 or n=2.\"\"\"\n        return 1\n\n    def term(self, n: int, cache: Dict[int, int]) -> int:\n        \"\"\"Recursively computes the nth term using memoization via the provided cache.\"\"\"\n        if n in cache:\n            return cache[n]\n\n        # P(n) = P(P(n-1)) + P(n - P(n-1)) for n > 2\n        p_n_minus_1 = self.term(n - 1, cache)\n        p_p_n_minus_1 = self.term(p_n_minus_1, cache)\n        p_n_minus_p_n_minus_1 = self.term(n - p_n_minus_1, cache)\n        \n        result = p_p_n_minus_1 + p_n_minus_p_n_minus_1\n        cache[n] = result\n        return result\n\nclass SequenceService:\n    \"\"\"Orchestrates validation, memoization, and computation of Newman-Conway sequence terms.\"\"\"\n    def __init__(self) -> None:\n        self._cache: Dict[int, int] = {}\n        self._validator = InputValidator()\n        self._calculator = NewmanConwaySequence()\n        self._cache[1] = 1\n        self._cache[2] = 1\n\n    def sequence(self, n: int) -> int:\n        \"\"\"Public entry point for the Newman-Conway sequence calculation.\"\"\"\n        self.validateInput(n)\n        return self.compute(n)\n\n    def compute(self, n: int) -> int:\n        \"\"\"Retrieves term from cache or computes it using NewmanConwaySequence.\"\"\"\n        if n in self._cache:\n            return self._cache[n]\n        return self._calculator.term(n, self._cache)\n\n    def validateInput(self, n: int) -> None:\n        \"\"\"Delegates input validation to InputValidator.\"\"\"\n        self._validator.validatePositiveInteger(n)\n\ndef sequence(n: int) -> int:\n    \"\"\"Calculates the nth number in the Newman-Conway sequence.\"\"\"\n    return SequenceService().sequence(n)"}
