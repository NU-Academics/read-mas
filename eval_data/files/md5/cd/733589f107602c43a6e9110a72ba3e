{"task_id": "Mbpp/235", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass InputNumber:\n    \"\"\"Represents the input integer value.\"\"\"\n    value: int\n\n@dataclass\nclass OutputNumber:\n    \"\"\"Represents the returned integer result.\"\"\"\n    value: int\n\nclass BitMask:\n    \"\"\"Handles generation of bitmasks with specific patterns.\"\"\"\n\n    def generate_even_bit_mask(self, max_bits: int) -> int:\n        \"\"\"\n        Generates an integer mask with 1s at even bit positions (2, 4, 6, ...)\n        up to `max_bits` (1-based LSB index).\n        \"\"\"\n        mask = 0\n        # Iterate 0-based indices from 1 up to max_bits-1.\n        # These correspond to 1-based bit positions 2 to max_bits.\n        for i in range(1, max_bits):\n            # Check if the (i+1)-th bit position (1-based) is even.\n            if (i + 1) % 2 == 0:\n                mask |= (1 << i)\n        return mask\n\nclass EvenBitSetter:\n    \"\"\"\n    Sets even-positioned bits in an integer, preserving other bits,\n    by delegating mask generation to BitMask.\n    \"\"\"\n    def even_bit_set_number(self, n: int) -> int:\n        \"\"\"\n        Sets all even bits of the given number, preserving other bits.\n        Even bits are counted from 1 for the LSB (positions 2, 4, 6, ...).\n        \"\"\"\n        input_obj = InputNumber(value=n)\n        \n        # Determine the maximum bit length for the mask generation.\n        # This is derived from the input's bit_length, with a minimum of 2\n        # to ensure the first even bit (position 2) can be included.\n        if n >= 0:\n            max_bits = n.bit_length()\n        else: # For negative numbers, bit_length is based on its absolute value.\n            max_bits = (-n).bit_length()\n        \n        # Ensure max_bits is at least 2 to properly generate masks for the 2nd bit position.\n        max_bits = max(max_bits, 2)\n\n        mask = BitMask().generate_even_bit_mask(max_bits)\n        result = input_obj.value | mask\n        return OutputNumber(value=result).value\n\ndef even_bit_set_number(n: int) -> int:\n    \"\"\"\n    Sets all even bits of a given number, preserving other bits.\n    Even bits are counted from 1 for the LSB (positions 2, 4, 6, ...).\n    \"\"\"\n    return EvenBitSetter().even_bit_set_number(n)"}
{"task_id": "Mbpp/237", "solution": "from typing import List, Tuple, Dict\n\ndef _normalize_pair(t: tuple) -> tuple:\n    \"\"\"Return a normalized 2-element tuple (min, max).\"\"\"\n    return tuple(sorted(t))\n\ndef check_occurences(pairs: list[tuple]) -> dict:\n    \"\"\"Returns a dictionary mapping each unique normalized tuple to its count.\"\"\"\n    counts: Dict[tuple, int] = {}\n    for pair in pairs:\n        normalized_pair = _normalize_pair(pair)\n        counts[normalized_pair] = counts.get(normalized_pair, 0) + 1\n    return counts"}
