{"task_id": "Mbpp/283", "solution": "from typing import List, Dict\nimport collections\n\ndef _normalize_absolute(n: int) -> int:\n    \"\"\"Returns the absolute value of the input integer.\"\"\"\n    return abs(n)\n\ndef _digit_list_from_int(n: int) -> List[int]:\n    \"\"\"Converts a non-negative integer into a list of its decimal digits.\"\"\"\n    if n == 0:\n        return [0]\n    return [int(d) for d in str(n)]\n\ndef _count_digit_frequencies(digits: List[int]) -> Dict[int, int]:\n    \"\"\"Returns a dictionary mapping each digit to its frequency in the list.\"\"\"\n    return collections.Counter(digits)\n\ndef _frequencies_satisfy_digits(freq: Dict[int, int]) -> bool:\n    \"\"\"\n    Checks if for every digit present, its frequency is less than or equal\n    to the digit's numeric value. Presence of digit 0 with non-zero frequency yields False.\n    \"\"\"\n    for digit, count in freq.items():\n        if digit == 0 and count > 0:\n            return False\n        if count > digit:\n            return False\n    return True\n\ndef validate(n: int) -> bool:\n    \"\"\"\n    Checks whether the frequency of each digit in the integer is less than or equal to the digit itself.\n    Operates on the absolute value of the input integer.\n    \"\"\"\n    abs_n = _normalize_absolute(n)\n    digits = _digit_list_from_int(abs_n)\n    freq_map = _count_digit_frequencies(digits)\n    result = _frequencies_satisfy_digits(freq_map)\n    return result"}
