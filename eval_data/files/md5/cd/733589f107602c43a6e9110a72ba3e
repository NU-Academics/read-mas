{"task_id": "Mbpp/223", "solution": "from typing import List, Any\n\ndef is_majority(arr: List[Any], n: int, x: Any) -> bool:\n    \"\"\"\n    Checks if an element x is the majority element in a sorted array arr of length n.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n\n    class MajorityChecker:\n        \"\"\"\n        Encapsulates the core logic for determining if an element is a majority element.\n        \"\"\"\n\n        def _binary_search_first(self, arr: List[Any], n: int, x: Any) -> int:\n            \"\"\"Finds the index of the first occurrence of x in arr[0...n-1] using binary search.\"\"\"\n            low, high = 0, n - 1\n            result = -1\n            while low <= high:\n                mid = low + (high - low) // 2\n                if arr[mid] == x:\n                    result = mid\n                    high = mid - 1  # Try to find an even earlier occurrence\n                elif arr[mid] < x:\n                    low = mid + 1\n                else:  # arr[mid] > x\n                    high = mid - 1\n            return result\n\n        def _binary_search_last(self, arr: List[Any], n: int, x: Any) -> int:\n            \"\"\"Finds the index of the last occurrence of x in arr[0...n-1] using binary search.\"\"\"\n            low, high = 0, n - 1\n            result = -1\n            while low <= high:\n                mid = low + (high - low) // 2\n                if arr[mid] == x:\n                    result = mid\n                    low = mid + 1  # Try to find an even later occurrence\n                elif arr[mid] < x:\n                    low = mid + 1\n                else:  # arr[mid] > x\n                    high = mid - 1\n            return result\n\n        def _countOccurrences(self, arr: List[Any], n: int, x: Any) -> int:\n            \"\"\"Counts occurrences of x in arr by finding its first and last indices.\"\"\"\n            if n == 0:\n                return 0\n\n            first_idx = self._binary_search_first(arr, n, x)\n            if first_idx == -1:  # Element x is not present in the array\n                return 0\n\n            last_idx = self._binary_search_last(arr, n, x)\n            return last_idx - first_idx + 1\n\n        def is_majority(self, arr: List[Any], n: int, x: Any) -> bool:\n            \"\"\"Determines if x is the majority element in the sorted array arr of length n.\"\"\"\n            if n == 0:\n                return False\n\n            count = self._countOccurrences(arr, n, x)\n            return count > n / 2\n\n    # The module-level function delegates to an instance of MajorityChecker\n    return MajorityChecker().is_majority(arr, n, x)"}
{"task_id": "Mbpp/232", "solution": "def larg_nnum(items: list, n: int) -> list:\n    \"\"\"Returns a list containing the n largest items from the input list.\n    Handles boundary cases for n and maintains duplicates.\"\"\"\n    if n <= 0:\n        return []\n    if n >= len(items):\n        return items.copy()\n\n    # Sort the list in descending order and take the first n elements.\n    # Duplicates are preserved, and elements must be comparable.\n    sorted_items = sorted(items, reverse=True)\n    return sorted_items[:n]"}
