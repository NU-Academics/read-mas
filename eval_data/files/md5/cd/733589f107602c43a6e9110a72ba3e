{"task_id": "Mbpp/463", "solution": "from typing import List, Optional\n\nclass ArrayInput:\n    \"\"\"Data holder for input integer array.\"\"\"\n    def __init__(self, elements: List[int]):\n        self.elements = elements\n\nclass MaxProductResult:\n    \"\"\"Result holder for max product and its indices.\"\"\"\n    def __init__(self, value: int, startIndex: Optional[int] = None, endIndex: Optional[int] = None):\n        self.value = value\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n\nclass ProductCalculator:\n    \"\"\"Encapsulates the algorithm to find the maximum product subarray.\"\"\"\n    def max_subarray_product(self, input_array: ArrayInput) -> int:\n        \"\"\"\n        Implements the classic linear-time algorithm using running current_max/current_min.\n        Raises ValueError for empty input_array.elements.\n        \"\"\"\n        elements = input_array.elements\n        if not elements:\n            raise ValueError(\"Input array cannot be empty for ProductCalculator.\")\n\n        max_so_far = elements[0]\n        min_so_far = elements[0]\n        overall_max_product = elements[0]\n\n        for i in range(1, len(elements)):\n            num = elements[i]\n\n            # Store max_so_far from previous iteration to use for min_so_far calculation\n            temp_max_val = max_so_far\n\n            max_so_far = max(num, temp_max_val * num, min_so_far * num)\n            min_so_far = min(num, temp_max_val * num, min_so_far * num)\n            \n            overall_max_product = max(overall_max_product, max_so_far)\n\n        return overall_max_product\n\ndef max_subarray_product(array: List[int]) -> int:\n    \"\"\"\n    Finds the maximum product subarray of the given array.\n    This function validates input and delegates computation to ProductCalculator.\n    \"\"\"\n    if array is None or not array:\n        raise ValueError(\"Input array cannot be None or empty.\")\n\n    array_input = ArrayInput(array)\n    calculator = ProductCalculator()\n    return calculator.max_subarray_product(array_input)"}
{"task_id": "Mbpp/462", "solution": "def _validate_input(input_list):\n    \"\"\"\n    Validates input list.\n    \"\"\"\n    pass\n\nclass CombinationGenerator:\n    \"\"\"\n    Generates combinations using the sequential-prefixing algorithm.\n    \"\"\"\n    def __init__(self):\n        pass\n\n    def combinations_list(self, input_list):\n        \"\"\"\n        Creates a shallow copy and delegates generation.\n        \"\"\"\n        elements = list(input_list)\n        return self._generate_prefixing(elements)\n\n    def _generate_prefixing(self, input_list):\n        \"\"\"\n        Implements the sequential-prefixing algorithm to find all combinations.\n        \"\"\"\n        result = [[]]\n        for e in input_list:\n            prefix_list = []\n            for combo in result:\n                new_combo = [e] + list(combo)\n                prefix_list.append(new_combo)\n            result.extend(prefix_list)\n        return result\n\ndef combinations_list(input_list):\n    \"\"\"\n    Public API. Returns a new list containing all combinations (power set) of input_list\n    in sequential-prefixing order. Does not mutate input_list.\n    \"\"\"\n    _validate_input(input_list)\n    generator = CombinationGenerator()\n    return generator.combinations_list(input_list)"}
{"task_id": "Mbpp/470", "solution": "from typing import Tuple, Union\n\nNumber = Union[int, float]\n\ndef add_pairwise(input_tuple: Tuple[Number, ...]) -> Tuple[Number, ...]:\n    \"\"\"Compute pairwise sums of neighboring elements.\n    Returns a tuple of numeric sums.\n    \"\"\"\n    sums = []\n    for i in range(len(input_tuple) - 1):\n        sums.append(input_tuple[i] + input_tuple[i+1])\n    return tuple(sums)"}
{"task_id": "Mbpp/468", "solution": "from typing import List, Union\n\n# Define Number type as specified in the design context.\nNumber = Union[int, float]\n\nclass ArrayInput:\n    \"\"\"Encapsulates input numeric sequence.\"\"\"\n    def __init__(self, numbers: List[Number]) -> None:\n        self.numbers = numbers\n\nclass Element:\n    \"\"\"Represents array element with index and numeric value.\"\"\"\n    def __init__(self, index: int, value: Number) -> None:\n        self.index = index\n        self.value = value\n\nclass Subsequence:\n    \"\"\"Represents a candidate subsequence and provides validation and product computation.\"\"\"\n    def __init__(self, elements: List[Element]) -> None:\n        self.elements = elements\n\n    def isStrictlyIncreasing(self) -> bool:\n        \"\"\"Verifies each successive value > previous and indices are increasing.\"\"\"\n        if not self.elements:\n            return True\n        \n        prev_value = self.elements[0].value\n        prev_index = self.elements[0].index\n        for i in range(1, len(self.elements)):\n            current_element = self.elements[i]\n            if not (current_element.value > prev_value and current_element.index > prev_index):\n                return False\n            prev_value = current_element.value\n            prev_index = current_element.index\n        return True\n\n    def product(self) -> Number:\n        \"\"\"Returns multiplicative product of elements' values.\"\"\"\n        if not self.elements:\n            return 1 # Multiplicative identity\n        \n        res = 1\n        for element in self.elements:\n            res *= element.value\n        return res\n\nclass MaxProductResult:\n    \"\"\"Value object to carry the numeric maximum product.\"\"\"\n    def __init__(self, value: Number) -> None:\n        self.value = value\n\nclass ProductCalculator:\n    \"\"\"Implements core algorithm to compute maximum product across strictly increasing subsequences.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def generateSubsequences(self, array_input: ArrayInput) -> List[Subsequence]:\n        \"\"\"\n        Produces candidate Subsequence objects using a dynamic programming approach.\n        Each returned Subsequence represents the maximum product IS ending at a particular index.\n        \"\"\"\n        numbers = array_input.numbers\n        n = len(numbers)\n        \n        if n == 0:\n            return []\n        \n        # dp_products[i] stores the maximum product of an IS ending at numbers[i]\n        dp_products = [0] * n\n        # dp_subsequences[i] stores the actual Subsequence object yielding dp_products[i]\n        dp_subsequences: List[Subsequence] = [Subsequence([]) for _ in range(n)]\n\n        for i in range(n):\n            current_element = Element(i, numbers[i])\n            \n            # Base case: subsequence of length 1 ending at i\n            dp_products[i] = numbers[i]\n            dp_subsequences[i] = Subsequence([current_element])\n\n            for j in range(i):\n                # If numbers[i] can extend the subsequence ending at j\n                if numbers[i] > numbers[j]:\n                    candidate_product = dp_products[j] * numbers[i]\n                    \n                    if candidate_product > dp_products[i]:\n                        dp_products[i] = candidate_product\n                        dp_subsequences[i] = Subsequence(dp_subsequences[j].elements + [current_element])\n        \n        return dp_subsequences\n\n    def computeProduct(self, subsequence: Subsequence) -> Number:\n        \"\"\"Computes multiplicative product using subsequence.product().\"\"\"\n        return subsequence.product()\n\n    def max_product(self, array_input: ArrayInput) -> Number:\n        \"\"\"\n        Computes and returns the maximum product across all strictly increasing subsequences.\n        Delegates to generateSubsequences and then finds the maximum product.\n        \"\"\"\n        candidate_subsequences = self.generateSubsequences(array_input)\n        \n        if not candidate_subsequences:\n            return 0 # If no numbers, no subsequences, max product is 0.\n\n        products = [self.computeProduct(s) for s in candidate_subsequences]\n        \n        return max(products)\n\ndef max_product(numbers: List[Number]) -> Number:\n    \"\"\"\n    Public API: constructs ArrayInput and delegates to ProductCalculator.max_product.\n    \"\"\"\n    array_input = ArrayInput(numbers)\n    return ProductCalculator().max_product(array_input)"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(array, n):\n    \"\"\"\n    Calculates the product of array elements modulo n.\n\n    Validates inputs (n and array element types). Computes product modulo n\n    using iterative modulo at each step, preventing large intermediate values.\n\n    Parameters:\n        array (list): A list or iterable of integers.\n        n (int): The modulus, must be an integer greater than 0.\n\n    Returns:\n        int: The product of array elements modulo n, an integer in the range [0, n-1].\n\n    Raises:\n        ValueError: If n is not an integer or is not positive, or if any array\n                    element is not an integer.\n\n    Example:\n        assert find_remainder([100, 10, 5, 25, 35, 14], 11) == 9\n        If the array is empty, the product is treated as 1, so 1 % n is returned.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be integer > 0\")\n\n    for element in array:\n        if not isinstance(element, int):\n            raise ValueError(\"all array elements must be integers\")\n\n    result = 1\n    for element in array:\n        result = (result * element) % n\n\n    # Ensure the final result is in the range [0, n-1].\n    # This also handles the empty array case where result is 1,\n    # and ensures 1 % n is correctly returned (e.g., 1 % 1 == 0).\n    return result % n"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(lst: list) -> bool:\n    \"\"\"\n    Checks if the given list contains consecutive numbers without duplicates.\n    Assumes valid input (list of integers) due to constraints.\n    \"\"\"\n    if not lst:\n        return False\n    if len(lst) == 1:\n        return True\n\n    # Check for duplicates by comparing original list length with unique elements count.\n    if len(set(lst)) != len(lst):\n        return False\n\n    # Sort the list to check for consecutive order.\n    sorted_lst = sorted(lst)\n\n    # Verify that each adjacent element differs by exactly 1.\n    for i in range(1, len(sorted_lst)):\n        if sorted_lst[i] - sorted_lst[i-1] != 1:\n            return False\n\n    return True"}
{"task_id": "Mbpp/473", "solution": "from typing import Any, List, Tuple as PyTuple, Set\n\nclass TupleIntersectionFunction:\n    \"\"\"\n    Internal class encapsulating the logic for tuple validation, canonicalization,\n    and intersection computation.\n    \"\"\"\n    def validateInput(self, lst: Any) -> bool:\n        \"\"\"\n        Validates that the input is a list of 2-element tuples with hashable elements.\n        Raises TypeError or ValueError for invalid inputs.\n        \"\"\"\n        if not isinstance(lst, list):\n            raise TypeError(\"Input must be a list.\")\n        for i, element in enumerate(lst):\n            if not isinstance(element, PyTuple) or len(element) != 2:\n                raise ValueError(f\"List element at index {i} must be a 2-element tuple.\")\n            try:\n                hash(element[0])\n                hash(element[1])\n            except TypeError as e:\n                raise ValueError(f\"Elements within tuple at index {i} must be hashable: {e}\")\n        return True\n\n    def canonicalize(self, tpl: PyTuple[Any, Any]) -> object:\n        \"\"\"\n        Returns a hashable, order-insensitive key for a 2-element tuple.\n        Prefers sorted tuple; falls back to frozenset if elements are not comparable.\n        \"\"\"\n        try:\n            return PyTuple(sorted(tpl))\n        except TypeError:\n            return frozenset(tpl)\n\n    def computeIntersection(self, listA: List[PyTuple[Any, Any]], listB: List[PyTuple[Any, Any]]) -> Set[PyTuple[Any, Any]]:\n        \"\"\"\n        Computes the intersection of two lists of 2-element tuples,\n        treating tuples as order-insensitive pairs.\n        \"\"\"\n        self.validateInput(listA)\n        self.validateInput(listB)\n\n        if not listA or not listB:\n            return set()\n\n        dictA: dict[object, PyTuple[Any, Any]] = {}\n        for tup in listA:\n            key = self.canonicalize(tup)\n            if key not in dictA:\n                dictA[key] = tup\n\n        keysB: Set[object] = set()\n        for tup in listB:\n            key = self.canonicalize(tup)\n            keysB.add(key)\n        \n        intersect_keys = dictA.keys() & keysB\n        result = {dictA[key] for key in intersect_keys}\n        return result\n\ndef tuple_intersection(list_a: List[PyTuple[Any, Any]], list_b: List[PyTuple[Any, Any]]) -> Set[PyTuple[Any, Any]]:\n    \"\"\"\n    Finds the tuple intersection of elements in two given tuple lists,\n    irrespective of their order within the tuples.\n    \"\"\"\n    engine = TupleIntersectionFunction()\n    return engine.computeIntersection(list_a, list_b)"}
