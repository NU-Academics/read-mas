{"task_id": "Mbpp/476", "solution": "from typing import List, Union\n\nclass ValidationError(ValueError):\n    \"\"\"Custom exception for input validation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\ndef big_sum(values: List[Union[int, float]]) -> float:\n    \"\"\"Compute and return min(values) + max(values).\n\n    Raises: ValidationError if values is empty or contains non-numeric elements.\n    \"\"\"\n    if not isinstance(values, list):\n        raise ValidationError(\"Input must be a list.\")\n    \n    if not values:\n        raise ValidationError(\"Input list cannot be empty.\")\n\n    for element in values:\n        if not isinstance(element, (int, float)):\n            raise ValidationError(\"All elements in the list must be numeric (int or float).\")\n\n    min_val = min(values)\n    max_val = max(values)\n    return float(min_val + max_val)"}
{"task_id": "Mbpp/475", "solution": "def _is_empty(input_dict) -> bool:\n    \"\"\"Detect empty dictionary and enable short-circuit return of [].\"\"\"\n    return not input_dict\n\ndef _entries_sorted_by_value_desc(input_dict) -> list:\n    \"\"\"Convert dict items to list of (key, value) tuples and return them sorted by value descending.\"\"\"\n    return sorted(input_dict.items(), key=lambda item: item[1], reverse=True)\n\ndef sort_counter(input_dict):\n    \"\"\"Public API. Accepts a single argument (dict) and returns a list of (key, value) tuples sorted by value descending.\"\"\"\n    if _is_empty(input_dict):\n        return []\n    return _entries_sorted_by_value_desc(input_dict)"}
{"task_id": "Mbpp/477", "solution": "from __future__ import annotations\n\nclass IsLowerFunction:\n    name: str = \"is_lower\"\n\n    def convert(self, input: str) -> str:\n        \"\"\"Return lowercase version of the provided input string.\"\"\"\n        return input.lower()\n\ndef is_lower(input: str) -> str:\n    \"\"\"Public function to convert the given string to lower case.\"\"\"\n    impl = IsLowerFunction()\n    return impl.convert(input)"}
{"task_id": "Mbpp/478", "solution": "def remove_lowercase(input_str: str) -> str:\n    \"\"\"\n    Removes contiguous substrings consisting only of ASCII lowercase letters from the input string.\n    Preserves the original order of remaining characters.\n    \"\"\"\n    if not input_str:\n        return \"\"\n\n    result_chars = []\n    i = 0\n    while i < len(input_str):\n        char = input_str[i]\n        # Check if the character is an ASCII lowercase letter\n        if 'a' <= char <= 'z':\n            # Found the start of a lowercase run, find its end\n            j = i\n            while j < len(input_str) and 'a' <= input_str[j] <= 'z':\n                j += 1\n            # Skip this entire run; move i to the character after the run\n            i = j\n        else:\n            # Not a lowercase letter, add it to the result\n            result_chars.append(char)\n            i += 1\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/479", "solution": "def first_Digit(number):\n    \"\"\"Return the most significant digit of `number` as an int.\"\"\"\n    \n    num_abs = abs(number)\n\n    # Repeatedly divide the absolute value of the number by 10 until it is less than 10.\n    # This leaves the most significant digit (possibly with a fractional part for floats).\n    while num_abs >= 10:\n        num_abs /= 10\n    \n    # Convert the result to an integer to extract the first digit.\n    return int(num_abs)"}
{"task_id": "Mbpp/554", "solution": "def Split(values: list[int]) -> list[int]:\n    \"\"\"Return a list containing only the odd integers from values, preserving order.\n    \"\"\"\n    result: list[int] = []\n    for v in values:\n        if v % 2 != 0:\n            result.append(v)\n    return result"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"Calculates the difference between the sum of cubes of the first n natural numbers and the sum of the first n natural numbers.\"\"\"\n    sum_n = n * (n + 1) // 2\n    sum_cubes = sum_n * sum_n\n    return sum_cubes - sum_n"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n) -> int:\n    \"\"\"Counts pairs in the first n elements of arr whose XOR sum is odd using parity counts.\n    Handles n by clamping it to the array's bounds and returns 0 if n_used is 1 or less.\"\"\"\n    n_used = min(max(int(n), 0), len(arr))\n\n    if n_used <= 1:\n        return 0\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(n_used):\n        if arr[i] % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n            \n    return even_count * odd_count"}
{"task_id": "Mbpp/557", "solution": "def _toggle_char(c: str) -> str:\n    \"\"\"Toggles the case of a single character or returns it unchanged if not alphabetic.\"\"\"\n    if c.islower():\n        return c.upper()\n    elif c.isupper():\n        return c.lower()\n    return c\n\nclass CharacterProcessor:\n    \"\"\"Processes an input string character by character to toggle case.\"\"\"\n    def transform(self, input_string: str) -> str:\n        \"\"\"Applies the case toggle transformation to each character in the string.\"\"\"\n        return \"\".join([_toggle_char(char) for char in input_string])\n\ndef toggle_string(input_string: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in a string, preserving non-alphabetic characters.\"\"\"\n    processor = CharacterProcessor()\n    return processor.transform(input_string)"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(sublists):\n    \"\"\"Return the integer length of the longest sublist in `sublists`.\n\n    Returns 0 if the input list is empty.\n    \"\"\"\n    max_length = 0\n    for sublist in sublists:\n        current_length = len(sublist)\n        if current_length > max_length:\n            max_length = current_length\n    return max_length"}
{"task_id": "Mbpp/560", "solution": "def union_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"Compute the union of elements in two tuples, remove duplicates, sort ascending and return a tuple.\n\n    Preconditions: a and b are tuples; contained elements are comparable for sorting.\n    \"\"\"\n    combined = set(a) | set(b)\n    sorted_list = sorted(combined)\n    return tuple(sorted_list)"}
{"task_id": "Mbpp/558", "solution": "class IntegerInput:\n    \"\"\"Represent an integer input and provide parsed digits in positional order (units at index 0).\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n        self.digits = self.parse_digits()\n\n    def parse_digits(self) -> list[int]:\n        \"\"\"Return digits list (units-first) using integer arithmetic.\"\"\"\n        if self.value == 0:\n            return [0]\n        digits = []\n        current_num = abs(self.value)\n        while current_num > 0:\n            digits.append(current_num % 10)\n            current_num //= 10\n        return digits\n\nclass Digit:\n    \"\"\"Value object representing a single decimal digit and its position (conceptual).\"\"\"\n    def __init__(self, position: int, value: int):\n        self.position = position\n        self.value = value\n\nclass Result:\n    \"\"\"Hold the computed integer sum of per-digit absolute differences.\"\"\"\n    def __init__(self, sum_value: int):\n        self.sum = sum_value\n\nclass DigitDistanceCalculator:\n    \"\"\"Stateless orchestration for computing the sum of per-digit absolute differences.\"\"\"\n    def digit_distance_nums(self, a: int, b: int) -> int:\n        \"\"\"Orchestrates the algorithm to compute the sum of per-digit absolute differences.\"\"\"\n        input_a = IntegerInput(a)\n        input_b = IntegerInput(b)\n\n        digits_a = input_a.digits\n        digits_b = input_b.digits\n\n        total_diff_sum = 0\n        max_len = max(len(digits_a), len(digits_b))\n\n        for i in range(max_len):\n            digit_a = digits_a[i] if i < len(digits_a) else 0\n            digit_b = digits_b[i] if i < len(digits_b) else 0\n            total_diff_sum += abs(digit_a - digit_b)\n\n        return total_diff_sum\n\ndef digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"\n    Computes the sum of the per-digit absolute differences between two integers.\n    Aligns digits by decimal position and treats missing higher-order digits as 0.\n    \"\"\"\n    calculator = DigitDistanceCalculator()\n    return calculator.digit_distance_nums(a, b)"}
