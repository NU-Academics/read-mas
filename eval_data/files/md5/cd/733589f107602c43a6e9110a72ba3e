{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(sequence):\n    \"\"\"Compute and return max(sequence) - min(sequence).\n\n    Raises TypeError for invalid sequence or element types, and ValueError for insufficient length.\n    Returns the difference between the maximum and minimum elements.\n    \"\"\"\n\n    def _validate_sequence_type(seq):\n        \"\"\"Raises TypeError if the sequence is not a list or tuple.\"\"\"\n        if not isinstance(seq, (list, tuple)):\n            raise TypeError(\"Input must be a list or tuple.\")\n\n    def _validate_elements_numeric(seq):\n        \"\"\"Raises TypeError if any element in the sequence is not numeric (int or float).\"\"\"\n        for element in seq:\n            if not isinstance(element, (int, float)):\n                raise TypeError(\"All elements in the sequence must be numeric (int or float).\")\n\n    def _compute_min_max_difference(seq):\n        \"\"\"Computes the difference between the maximum and minimum elements in a single pass.\"\"\"\n        min_val = seq[0]\n        max_val = seq[0]\n        for i in range(1, len(seq)):\n            if seq[i] < min_val:\n                min_val = seq[i]\n            if seq[i] > max_val:\n                max_val = seq[i]\n        return max_val - min_val\n\n    _validate_sequence_type(sequence)\n    _validate_elements_numeric(sequence)\n\n    if len(sequence) < 2:\n        raise ValueError(\"Sequence must contain at least two elements.\")\n\n    return _compute_min_max_difference(sequence)"}
{"task_id": "Mbpp/142", "solution": "from typing import Any, List\n\nclass Result:\n    \"\"\"A simple value holder for an integer count.\"\"\"\n    def __init__(self, count: int):\n        self.count = count\n\nclass CountSamePairFunction:\n    \"\"\"Encapsulates the algorithm for counting identical items in the same position.\"\"\"\n\n    def execute(self, list1: List[Any], list2: List[Any], list3: List[Any]) -> int:\n        \"\"\"Computes the number of positions where elements are identical across three lists.\"\"\"\n        match_count = 0\n        min_length = self.computeMinLength(list1, list2, list3)\n\n        for i in range(min_length):\n            v1 = list1[i]\n            v2 = list2[i]\n            v3 = list3[i]\n            if self.elementsEqual(v1, v2, v3):\n                match_count += 1\n        return match_count\n\n    def computeMinLength(self, list1: List[Any], list2: List[Any], list3: List[Any]) -> int:\n        \"\"\"Returns the minimum length among the three given lists.\"\"\"\n        return min(len(list1), len(list2), len(list3))\n\n    def elementsEqual(self, e1: Any, e2: Any, e3: Any) -> bool:\n        \"\"\"Returns True if all three elements are equal using language equality semantics.\"\"\"\n        return e1 == e2 and e2 == e3\n\ndef count_samepair(list1: List[Any], list2: List[Any], list3: List[Any]) -> int:\n    \"\"\"\n    Counts the number of items that are identical in the same position of three given lists.\n    The comparison is based on the minimum length of the three lists.\n    \"\"\"\n    processor = CountSamePairFunction()\n    return processor.execute(list1, list2, list3)"}
{"task_id": "Mbpp/161", "solution": "from typing import Iterable, Any, List\n\ndef remove_elements(source_list: Iterable[Any], remove_list: Iterable[Any]) -> List[Any]:\n    \"\"\"\n    Return a new list containing only elements from source_list that are not present in remove_list.\n    All occurrences of elements appearing in remove_list are removed, preserving relative order.\n    \"\"\"\n    try:\n        # Attempt to create a set for faster O(1) average time complexity membership checks.\n        elements_to_remove_container = set(remove_list)\n    except TypeError:\n        # Fallback to O(N) linear time complexity membership checks if elements are unhashable.\n        elements_to_remove_container = remove_list\n\n    result_list: List[Any] = []\n    for item in source_list:\n        if item not in elements_to_remove_container:\n            result_list.append(item)\n\n    return result_list"}
{"task_id": "Mbpp/160", "solution": "from typing import Optional, Tuple\n\ndef gcd(a: int, b: int) -> int:\n    \"\"\"\n    Computes the greatest common divisor of two integers.\n    \"\"\"\n    while b:\n        a, b = b, a % b\n    return abs(a)\n\ndef extended_gcd(a: int, b: int) -> Tuple[int, int, int]:\n    \"\"\"\n    Computes g, x, y such that ax + by = g = gcd(a, b).\n    \"\"\"\n    r0, r1 = a, b\n    x0, x1 = 1, 0\n    y0, y1 = 0, 1\n\n    while r1 != 0:\n        q = r0 // r1\n        r0, r1 = r1, r0 - q * r1\n        x0, x1 = x1, x0 - q * x1\n        y0, y1 = y1, y0 - q * y1\n    \n    # Ensure g (r0) is non-negative, and adjust coefficients accordingly.\n    if r0 < 0:\n        r0 = -r0\n        x0 = -x0\n        y0 = -y0\n            \n    return (r0, x0, y0)\n\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple,\n    or None if no solution exists.\n    \"\"\"\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    common_divisor = gcd(a, b)\n\n    if n % common_divisor != 0:\n        return None  # No integer solution\n\n    # Get a particular solution for ax0_base + by0_base = common_divisor\n    g, x0_base, y0_base = extended_gcd(a, b)\n\n    # Scale the base solution to ax_particular + by_particular = n\n    scale_factor = n // g\n    x_particular = x0_base * scale_factor\n    y_particular = y0_base * scale_factor\n\n    # Adjust the particular solution to a canonical form (e.g., for the example (2,3,7) -> (2,1))\n    # The general solution is (x_particular + k * (b/g), y_particular - k * (a/g))\n    \n    if b != 0:\n        # Calculate b_prime = b / g, which is the coefficient for k in x's equation\n        b_prime = b // g\n        \n        # Calculate the offset 'k' to bring x into a more canonical range\n        # For example, to make x as small non-negative as possible, or matching the desired output\n        k_offset = x_particular // b_prime\n        \n        x_final = x_particular - k_offset * b_prime\n        y_final = y_particular + k_offset * (a // g)\n        \n        return (x_final, y_final)\n    elif a != 0: # This branch covers cases where b == 0 and a != 0\n        # For ax = n, y can be 0 (or any integer). extended_gcd(a,0) returns (abs(a), +/-1, 0)\n        # So x_particular becomes (n/g) * (+/-1) = n/a, and y_particular = 0.\n        # This is already a canonical solution.\n        return (x_particular, y_particular)\n    \n    # This point should theoretically not be reached due to initial (a==0, b==0) check\n    # and subsequent if/elif branches for (b!=0) or (a!=0 and b==0).\n    return None"}
{"task_id": "Mbpp/162", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass SeriesTerm:\n    \"\"\"\n    Represents a single term in the series with its index and calculated value.\n    \"\"\"\n    i: int\n    value: int\n\ndef compute_terms(n: int) -> List[SeriesTerm]:\n    \"\"\"\n    Generates a list of SeriesTerm objects for the given n.\n    Each term is (i, n - 2*i) for i from 0 to n // 2.\n    \"\"\"\n    terms = []\n    for i in range(n // 2 + 1):\n        value = n - 2 * i\n        terms.append(SeriesTerm(i, value))\n    return terms\n\ndef sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of terms (n - 2*i) for i from 0 to n // 2.\n    It utilizes compute_terms to generate the series terms.\n    \"\"\"\n    terms = compute_terms(n)\n    return sum(term.value for term in terms)"}
