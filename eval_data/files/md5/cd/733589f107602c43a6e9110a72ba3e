{"task_id": "Mbpp/9", "solution": "class InputString:\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\nclass Validator:\n    def is_non_empty(self, s: str) -> bool:\n        return len(s) > 0\n\nclass RotationResult:\n    def __init__(self, k: int):\n        self.k = k\n\ndef rotate(s: str, k: int) -> str:\n    \"\"\"Performs a cyclic left-rotation of string s by k positions.\"\"\"\n    if not s:\n        return s\n    n = len(s)\n    normalized_k = k % n\n    return s[normalized_k:] + s[:normalized_k]\n\ndef find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    If no such rotation exists in 1..len(s)-1, returns len(s).\n    \"\"\"\n    validator = Validator()\n    if not validator.is_non_empty(s):\n        # Requirements imply non-empty strings. For an empty string, behavior is undefined\n        # but returning 0 or 1 might be reasonable depending on interpretation.\n        # Following the pattern \"return len(s)\" for no specific k, an empty string has length 0.\n        # However, problem constraints indicate positive rotations and non-empty s.\n        return 0 \n\n    n = len(s)\n    original_string = InputString(s)\n\n    for k in range(1, n):\n        rotated_string = rotate(original_string.value, k)\n        if rotated_string == original_string.value:\n            # Found the minimal positive rotation.\n            return RotationResult(k).k\n    \n    # If no smaller rotation is found, the string only repeats after a full length rotation.\n    return RotationResult(n).k"}
{"task_id": "Mbpp/3", "solution": "import math\n\ndef is_not_prime(n: int) -> bool:\n    \"\"\"Return True if n is not a prime number (composite), False if n is prime.\n\n    Preconditions: n is an int. Behavior for n <= 1 and non-int inputs is unspecified in the SRS.\n    \"\"\"\n    # Numbers less than 2 are not considered prime.\n    if n < 2:\n        return True\n\n    # As per FR2, 2 is prime, so is_not_prime(2) should be False.\n    if n == 2:\n        return False\n\n    # Even numbers greater than 2 are composite.\n    if n % 2 == 0:\n        return True\n\n    # Check for odd divisors from 3 up to the square root of n.\n    # If a divisor is found, n is composite (not prime).\n    limit = int(math.sqrt(n)) + 1\n    for i in range(3, limit, 2):\n        if n % i == 0:\n            return True\n\n    # If no divisors were found, n is prime.\n    return False"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"Return True iff a and b differ in exactly one bit position.\"\"\"\n    xor = a ^ b\n    return xor != 0 and (xor & (xor - 1)) == 0"}
{"task_id": "Mbpp/7", "solution": "from typing import List\nimport re\n\nclass InputString:\n    \"\"\"Encapsulates input string and provides whitespace tokenization.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def tokenize(self) -> List[str]:\n        \"\"\"Splits the input string by whitespace into a list of words.\"\"\"\n        # Use re.split to handle various whitespace characters (spaces, tabs, newlines)\n        # and to remove empty strings that might result from multiple consecutive delimiters.\n        return [token for token in re.split(r'\\s+', self.value) if token]\n\nclass Word:\n    \"\"\"Wraps a token string and provides its length.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the word.\"\"\"\n        return len(self.text)\n\nclass ResultCollection:\n    \"\"\"Collects qualifying words, preserving order and occurrences.\"\"\"\n    def __init__(self):\n        self.items: List[str] = []\n\n    def add(self, word: str) -> None:\n        \"\"\"Adds a word to the collection.\"\"\"\n        self.items.append(word)\n\n    def to_list(self) -> List[str]:\n        \"\"\"Returns the collected words as a list.\"\"\"\n        return self.items\n\n    def to_set(self) -> set:\n        \"\"\"Returns the collected words as a set (for uniqueness checks).\"\"\"\n        return set(self.items)\n\ndef find_char_long(input_str: str) -> list:\n    \"\"\"\n    Finds all words in a string that are at least 4 characters long.\n    Tokenizes by whitespace, preserves casing and duplicate occurrences.\n    \"\"\"\n    input_obj = InputString(input_str)\n    tokens = input_obj.tokenize()\n    \n    result_collection = ResultCollection()\n    \n    for token_text in tokens:\n        word_obj = Word(token_text)\n        if word_obj.length() >= 4:\n            result_collection.add(word_obj.text)\n            \n    return result_collection.to_list()"}
{"task_id": "Mbpp/2", "solution": "import collections.abc\n\ndef similar_elements(a, b):\n    \"\"\"Return a list containing each element present in both sequences a and b exactly once.\n\n    Raises TypeError if either a or b is not a sequence.\n    \"\"\"\n    if not isinstance(a, collections.abc.Sequence) or not isinstance(b, collections.abc.Sequence):\n        raise TypeError(\"similar_elements: both arguments must be sequences\")\n\n    result = []\n    seen = set()\n\n    # Iterate over the smaller sequence to optimize membership checks\n    if len(a) <= len(b):\n        iter_seq = a\n        other_seq = b\n    else:\n        iter_seq = b\n        other_seq = a\n\n    # Convert the 'other_seq' to a set for O(1) average time complexity for 'in' operator\n    # This optimization is valid because the design context allows elements to be hashable (for the 'seen' set).\n    other_set = set(other_seq)\n\n    for item in iter_seq:\n        if item in other_set and item not in seen:\n            result.append(item)\n            seen.add(item)\n            \n    return result"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, ch: str) -> str:\n    \"\"\"\n    Removes the first and last occurrences of a given character from the string.\n    Raises ValueError if the character parameter is not a single character.\n    \"\"\"\n    if len(ch) != 1:\n        raise ValueError(\"Character parameter must be a single character.\")\n\n    first_idx = input_string.find(ch)\n\n    if first_idx == -1:\n        # Character not found, return original string\n        return input_string\n    else:\n        last_idx = input_string.rfind(ch)\n\n        if first_idx == last_idx:\n            # Character found exactly once\n            return input_string[:first_idx] + input_string[first_idx + 1:]\n        else:\n            # Character found two or more times, remove first and last\n            return input_string[:first_idx] + \\\n                   input_string[first_idx + 1:last_idx] + \\\n                   input_string[last_idx + 1:]"}
