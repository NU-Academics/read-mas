{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Finds the length of the longest palindromic subsequence in the given string using dynamic programming.\n    \"\"\"\n    n = len(s)\n\n    # Base case: an empty string has an LPS length of 0.\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the longest palindromic subsequence of the substring s[i...j].\n    dp = [[0] * n for _ in range(n)]\n\n    # All single characters are palindromes of length 1.\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the DP table for substrings of increasing length.\n    for length in range(2, n + 1):\n        for i in range(n - length + 1):\n            j = i + length - 1 # Calculate the end index for the current substring.\n\n            if s[i] == s[j]:\n                # If characters at the ends match, they contribute 2 to the LPS length.\n                # The remaining length comes from the LPS of the inner substring s[i+1...j-1].\n                # If length is 2 (e.g., \"aa\"), the inner substring is empty, so dp[i+1][j-1] would effectively be 0.\n                dp[i][j] = 2 + (dp[i + 1][j - 1] if length > 2 else 0)\n            else:\n                # If characters at the ends do not match, the LPS is the maximum of:\n                # 1. LPS of s[i+1...j] (excluding the character s[i])\n                # 2. LPS of s[i...j-1] (excluding the character s[j])\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    # The result for the entire string s[0...n-1] is stored in dp[0][n-1].\n    return dp[0][n - 1]"}
{"task_id": "Mbpp/253", "solution": "def count_integer(input_list):\n    \"\"\"Return the number of integer elements in input_list.\n\n    Raises:\n        TypeError: if input_list is not a list.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError('count_integer expects a list as input')\n    count = 0\n    for element in input_list:\n        if isinstance(element, int):\n            count += 1\n    return count"}
{"task_id": "Mbpp/252", "solution": "import math\n\ndef computeMagnitude(re, im):\n    \"\"\"Return float magnitude computed as math.hypot(re, im).\"\"\"\n    return math.hypot(re, im)\n\ndef computeAngle(re, im):\n    \"\"\"Return float angle computed as math.atan2(im, re).\"\"\"\n    return math.atan2(im, re)\n\ndef convert(z):\n    \"\"\"Accepts z (int | float | complex) and return (r: float, theta: float).\"\"\"\n    try:\n        # Attempt to treat z as a complex number, extracting real and imaginary parts.\n        re = float(z.real)\n        im = float(z.imag)\n    except AttributeError:\n        # If z does not have .real or .imag attributes (e.g., int or float),\n        # treat it as a real number with an imaginary part of zero.\n        re = float(z)\n        im = 0.0\n\n    r = computeMagnitude(re, im)\n    theta = computeAngle(re, im)\n\n    return (float(r), float(theta))"}
{"task_id": "Mbpp/256", "solution": "import math\nfrom dataclasses import dataclass\n\nclass Prime:\n    \"\"\"Represents an integer candidate and provides isPrime() -> bool.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isPrime(self) -> bool:\n        \"\"\"Return True if value > 1 and has no divisors other than 1 and itself.\"\"\"\n        if self.value < 2:\n            return False\n        for i in range(2, int(math.sqrt(self.value)) + 1):\n            if self.value % i == 0:\n                return False\n        return True\n\n@dataclass\nclass NumberInput:\n    \"\"\"Dataclass representing numeric input value.\"\"\"\n    value: float\n\nclass PrimeCounter:\n    \"\"\"Encapsulates prime-counting algorithm.\"\"\"\n    def count_Primes_nums(self, n: float) -> int:\n        \"\"\"Compute and return number of primes strictly less than n; orchestrates NumberInput and Prime usage.\"\"\"\n        count = 0\n        # Loop integer candidates from 2 to floor(n)-1\n        for k in range(2, int(n)):\n            prime_candidate = Prime(k)\n            if prime_candidate.isPrime():\n                count += 1\n        return count\n\ndef count_Primes_nums(n: float) -> int:\n    \"\"\"Return int: number of prime integers strictly less than n.\n    Precondition: n is a non-negative number (n >= 0).\n    \"\"\"\n    if n < 2:\n        return 0\n\n    prime_counter = PrimeCounter()\n    return prime_counter.count_Primes_nums(n)"}
{"task_id": "Mbpp/255", "solution": "import collections\nfrom typing import Any, List, Sequence, Tuple\n\ndef combinations_colors(input_list: Sequence[Any], n: int) -> List[Tuple[Any, ...]]:\n    # This helper validates inputs based on type and value.\n    def _validate_inputs(input_list: Any, n: Any) -> Tuple[Sequence[Any], int]:\n        if not isinstance(input_list, collections.abc.Sequence):\n            raise ValueError(\"input_list must be a sequence.\")\n        if not isinstance(n, int):\n            raise ValueError(\"n must be an integer.\")\n        if n < 0:\n            raise ValueError(\"n cannot be negative.\")\n        return input_list, n\n\n    # This helper generates non-decreasing index sequences.\n    def _index_combinations(m: int, n: int):\n        if n == 0:\n            yield ()\n            return\n        if m == 0:\n            return\n\n        indices = [0] * n\n        while True:\n            yield tuple(indices)\n            \n            i = n - 1\n            while i >= 0 and indices[i] == m - 1:\n                i -= 1\n            \n            if i < 0:\n                break\n            \n            indices[i] += 1\n            for j in range(i + 1, n):\n                indices[j] = indices[i]\n\n    # This helper maps an index tuple to a value tuple from the input list.\n    def _indices_to_tuple(indices: Tuple[int, ...], input_list: Sequence[Any]) -> Tuple[Any, ...]:\n        return tuple(input_list[i] for i in indices)\n\n    validated_input_list, validated_n = _validate_inputs(input_list, n)\n\n    if validated_n == 0:\n        return [()]\n    if not validated_input_list and validated_n > 0:\n        return []\n\n    m = len(validated_input_list)\n    result = []\n    for indices in _index_combinations(m, validated_n):\n        result.append(_indices_to_tuple(indices, validated_input_list))\n    return result"}
{"task_id": "Mbpp/257", "solution": "from typing import Union, Tuple\n\ndef swap_numbers(a: Union[int, float], b: Union[int, float]) -> Tuple[Union[int, float], Union[int, float]]:\n    \"\"\"Swaps two numbers and returns them in a tuple (second, first).\n    Handles int and float types, raising TypeError for non-numeric inputs.\n    \"\"\"\n    if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n        raise TypeError(\"swap_numbers expects numeric arguments (int or float)\")\n    return (b, a)"}
{"task_id": "Mbpp/259", "solution": "def maximize_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"Validate inputs and compute element-wise maxima; returns tuple-of-tuples.\n    Raises ValueError for shape mismatches.\n    \"\"\"\n    def validate_outer_length(a_in: tuple, b_in: tuple) -> None:\n        if len(a_in) != len(b_in):\n            raise ValueError(\"outer tuple length mismatch\")\n\n    def validate_inner_lengths(a_in: tuple, b_in: tuple) -> None:\n        for i in range(len(a_in)):\n            if len(a_in[i]) != len(b_in[i]):\n                raise ValueError(f\"inner tuple length mismatch at index {i}\")\n\n    validate_outer_length(a, b)\n    validate_inner_lengths(a, b)\n\n    result = tuple(\n        tuple(max(x, y) for x, y in zip(a_inner, b_inner))\n        for a_inner, b_inner in zip(a, b)\n    )\n    return result"}
{"task_id": "Mbpp/262", "solution": "from typing import List, Tuple, Any\n\ndef split_two_parts(input_list: List[Any], L: int) -> Tuple[List[Any], List[Any]]:\n    \"\"\"\n    Splits the given list into two parts where the length of the first part is L,\n    and returns the resulting lists in a tuple.\n    \"\"\"\n    first_part = input_list[:L]\n    second_part = input_list[L:]\n    return (first_part, second_part)"}
{"task_id": "Mbpp/260", "solution": "from .validator import InputValidator\nfrom .sequence_generator import SequenceGenerator\nfrom .prime_checker import PrimeChecker\nfrom .types import ValidationError, InputParameter\n\ndef newman_prime(n) -> int:\n    \"\"\"Validate n, compute nth Newman\u2013Shanks\u2013Williams prime, return numeric value or raise ValidationError.\"\"\"\n    # Orchestrate validation, sequence generation, and primality checks starting from index n.\n    InputValidator.validate(n)\n\n    seq_generator = SequenceGenerator()\n    prime_checker = PrimeChecker()\n\n    current_index = n\n    \n    while True:\n        element = seq_generator.generate_element(current_index)\n        if prime_checker.is_prime(element):\n            return element\n        current_index += 1"}
{"task_id": "Mbpp/265", "solution": "from typing import Any, List\n\nclass InputList:\n    \"\"\"A wrapper for the input list elements.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements: List[Any] = elements\n\nclass Element:\n    \"\"\"Represents an element with its value and original index.\"\"\"\n    def __init__(self, value: Any, index: int) -> None:\n        self.value: Any = value\n        self.index: int = index\n\nclass Sublist:\n    \"\"\"Accumulates elements for a specific offset.\"\"\"\n    def __init__(self, offset: int) -> None:\n        self.offset: int = offset\n        self._elements: List[Element] = []\n\n    def append(self, element: Element) -> None:\n        \"\"\"Adds an element to this sublist, preserving order.\"\"\"\n        self._elements.append(element)\n\n    def to_list(self) -> List[Any]:\n        \"\"\"Returns the list of values contained in this sublist.\"\"\"\n        return [e.value for e in self._elements]\n\nclass OutputList:\n    \"\"\"A container for the resulting sublists.\"\"\"\n    def __init__(self, sublists: List['Sublist']) -> None:\n        self.sublists: List['Sublist'] = sublists\n\n    def to_list_of_lists(self) -> List[List[Any]]:\n        \"\"\"Converts the contained Sublist objects into a plain list of lists.\"\"\"\n        return [sub.to_list() for sub in self.sublists]\n\nclass ListSplitter:\n    \"\"\"A domain service to perform the list splitting logic.\"\"\"\n    def list_split(self, inputList: 'InputList', n: int) -> 'OutputList':\n        \"\"\"Distributes elements from the input list into n sublists based on index modulo n.\"\"\"\n        # Initialize n empty sublists\n        sublists: List[Sublist] = [Sublist(offset=i) for i in range(n)]\n\n        # Distribute elements from the input list into the corresponding sublists\n        for idx, value in enumerate(inputList.elements):\n            offset = idx % n\n            sublists[offset].append(Element(value, idx))\n\n        return OutputList(sublists)\n\ndef list_split(input_list: list, n: int) -> List[List[Any]]:\n    \"\"\"Splits an input list into n sublists, distributing elements based on their original index modulo n.\"\"\"\n    # Handle cases where n is not positive to prevent runtime errors\n    # in the ListSplitter's core logic, without raising an explicit exception.\n    if n <= 0:\n        return []\n\n    input_list_obj = InputList(input_list)\n    splitter = ListSplitter()\n    output_list_obj = splitter.list_split(input_list_obj, n)\n    return output_list_obj.to_list_of_lists()"}
{"task_id": "Mbpp/261", "solution": "class ValidationError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass DivisionByZeroError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass NumericElement:\n    def __init__(self, value: 'number') -> None:\n        self.value = value\n\n    def is_integer(self) -> bool:\n        return isinstance(self.value, int)\n\n    def is_float(self) -> bool:\n        return isinstance(self.value, float)\n\n    def as_number(self) -> 'number':\n        return self.value\n\nclass TupleInput:\n    def __init__(self, elements: tuple) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def is_numeric_elements(self) -> bool:\n        \"\"\"Checks if all elements in the tuple are numeric (int or float).\"\"\"\n        for element in self.elements:\n            if not isinstance(element, (int, float)):\n                return False\n        return True\n\n    def get_element(self, index: int) -> NumericElement:\n        return NumericElement(self.elements[index])\n\nclass ResultTuple:\n    def __init__(self, elements: tuple) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def as_tuple(self) -> tuple:\n        return self.elements\n\nclass DivisionOperation:\n    def __init__(self, left: TupleInput, right: TupleInput) -> None:\n        self.left = left\n        self.right = right\n\n    def validate(self) -> None:\n        \"\"\"\n        Validates input tuples for matching length, numeric elements,\n        and absence of zero in the divisor tuple.\n        \"\"\"\n        if self.left.length() != self.right.length():\n            raise ValidationError(\"Input tuples must have the same length.\")\n\n        if not self.left.is_numeric_elements():\n            raise ValidationError(\"All elements in the left tuple must be numeric (int or float).\")\n        if not self.right.is_numeric_elements():\n            raise ValidationError(\"All elements in the right tuple must be numeric (int or float).\")\n\n        for i in range(self.right.length()):\n            if self.right.get_element(i).as_number() == 0:\n                raise DivisionByZeroError(f\"Division by zero at index {i}.\")\n\n    def compute(self) -> ResultTuple:\n        \"\"\"Performs element-wise division and returns the results in a ResultTuple.\"\"\"\n        results = []\n        for i in range(self.left.length()):\n            left_val = self.left.get_element(i).as_number()\n            right_val = self.right.get_element(i).as_number()\n            results.append(left_val / right_val)\n        return ResultTuple(tuple(results))\n\n\ndef division_elements(left_tuple: tuple, right_tuple: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise division operation across two given tuples.\n    Validates inputs and handles division logic using domain objects.\n    \"\"\"\n    left_input = TupleInput(left_tuple)\n    right_input = TupleInput(right_tuple)\n\n    operation = DivisionOperation(left_input, right_input)\n    operation.validate()\n    result_tuple = operation.compute()\n\n    return result_tuple.as_tuple()"}
