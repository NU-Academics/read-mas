{"task_id": "Mbpp/282", "solution": "from dataclasses import dataclass\nfrom typing import List, Union, Sequence, TypeVar\n\nNumber = TypeVar('Number', int, float)\n\nclass LengthMismatchError(Exception):\n    \"\"\"Exception raised when input lists have different lengths.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\n@dataclass\nclass InputList:\n    \"\"\"Represents an ordered sequence of numeric elements supplied to sub_list.\"\"\"\n    elements: List[Number]\n\n    def length(self) -> int:\n        return len(self.elements)\n\n@dataclass\nclass OutputList:\n    \"\"\"Represents resulting ordered sequence produced by sub_list.\"\"\"\n    elements: List[Number]\n\n    def length(self) -> int:\n        return len(self.elements)\n\nclass SubListFunction:\n    \"\"\"Stateless implementation of validation and element-wise subtraction.\"\"\"\n    def sub_list(self, a: InputList, b: InputList) -> OutputList:\n        \"\"\"Enforces validation and computes result or raises LengthMismatchError.\"\"\"\n        if not self.validateLengths(a, b):\n            raise LengthMismatchError(\"Input lists have different lengths.\")\n        return self.compute(a, b)\n\n    def validateLengths(self, a: InputList, b: InputList) -> bool:\n        \"\"\"Returns True if input list lengths are equal.\"\"\"\n        return a.length() == b.length()\n\n    def compute(self, a: InputList, b: InputList) -> OutputList:\n        \"\"\"Produces OutputList with element-wise differences.\"\"\"\n        result_elements: List[Number] = []\n        for i in range(a.length()):\n            diff = a.elements[i] - b.elements[i]\n            result_elements.append(diff)\n        return OutputList(result_elements)\n\ndef sub_list(a: Union[Sequence[Number], InputList], b: Union[Sequence[Number], InputList]) -> List[Number]:\n    \"\"\"\n    Subtracts two lists element-wise, ensuring they have equal lengths.\n    Returns a new list with result[i] = a[i] - b[i].\n    \"\"\"\n    if not isinstance(a, InputList):\n        a = InputList(list(a))\n    if not isinstance(b, InputList):\n        b = InputList(list(b))\n\n    impl = SubListFunction()\n    out = impl.sub_list(a, b)\n\n    return out.elements"}
{"task_id": "Mbpp/285", "solution": "class TextInput:\n    def __init__(self, value: str):\n        self.value: str = value\n    def length(self) -> int:\n        return len(self.value)\n\nclass MatchResult:\n    def __init__(self, matched: bool = False, matchedSubstring: str = \"\"):\n        self.matched: bool = matched\n        self.matchedSubstring: str = matchedSubstring\n\nclass PatternMatcher:\n    def containsAbb(self, text: str) -> bool:\n        \"\"\"Return True if 'abb' appears as a contiguous substring in text.\"\"\"\n        return \"abb\" in text\n\n    def containsAbbb(self, text: str) -> bool:\n        \"\"\"Return True if 'abbb' appears as a contiguous substring in text.\"\"\"\n        return \"abbb\" in text\n\n    def match(self, text: str) -> MatchResult:\n        \"\"\"Return MatchResult where matched is True if containsAbb or containsAbbb is True;\n           matchedSubstring is the first discovered matching substring (e.g., 'abb' or 'abbb').\"\"\"\n        if self.containsAbbb(text):\n            return MatchResult(matched=True, matchedSubstring=\"abbb\")\n        elif self.containsAbb(text):\n            return MatchResult(matched=True, matchedSubstring=\"abb\")\n        else:\n            return MatchResult(matched=False, matchedSubstring=\"\")\n\ndef text_match_two_three(text: str) -> bool:\n    \"\"\"Public API: validate input is a string and return True/False if pattern exists.\n       Preconditions: text is expected to be a str; non-str handling: raise TypeError.\"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a str\")\n    pm = PatternMatcher()\n    result = pm.match(text)\n    return result.matched"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n):\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers.\n    \"\"\"\n\n    def validate_input(val):\n        \"\"\"Ensures the input is a non-negative integer, raising errors if not.\"\"\"\n        if not isinstance(val, int):\n            raise TypeError(\"n must be an integer.\")\n        if val < 0:\n            raise ValueError(\"n must be a non-negative integer.\")\n\n    def compute_series(val):\n        \"\"\"Computes the sum of squares using a closed-form integer formula.\"\"\"\n        if val == 0:\n            return 0\n        # The sum of squares of the first n even numbers is sum_{k=1 to n} (2k)^2\n        # This simplifies to 4 * sum_{k=1 to n} k^2\n        # The sum of the first n squares (sum k^2) is n * (n + 1) * (2n + 1) / 6\n        # So the total sum is 4 * n * (n + 1) * (2n + 1) / 6\n        # Which simplifies to 2 * n * (n + 1) * (2n + 1) / 3.\n        # This expression is always an integer, so integer division (//) can be used.\n        return (2 * val * (val + 1) * (2 * val + 1)) // 3\n\n    validate_input(n)\n    return compute_series(n)"}
{"task_id": "Mbpp/290", "solution": "```python\ndef max_length(input_lists):\n    \"\"\"Finds the list of maximum length in a list of lists.\n    Returns a tuple (max_length: int, representative_inner_list: list).\n    \"\"\"\n    current_max = 0\n    representative = []\n    for inner in input_lists:\n        try:\n            length = len(inner)\n        except TypeError:\n            length = 0  # Treat non-sized elements as length 0\n        if length > current_max:\n            current_max = length\n            representative = inner\n    return (current_max, representative)\n```"}
{"task_id": "Mbpp/286", "solution": "class Result:\n    \"\"\"Holds the maximum sum.\"\"\"\n    def __init__(self, maxSum: int):\n        self.maxSum = maxSum\n\nclass Validation:\n    \"\"\"Validates input parameters for the max subarray sum function.\"\"\"\n    def validateInputs(self, arr, n, k) -> bool:\n        if not isinstance(arr, list):\n            raise ValueError(\"Input 'arr' must be a list.\")\n        if n != len(arr):\n            raise ValueError(\"Input 'n' must be equal to the length of 'arr'.\")\n        if not isinstance(k, int) or k < 1:\n            raise ValueError(\"Input 'k' must be an integer and k >= 1.\")\n        \n        for element in arr:\n            if not isinstance(element, int):\n                raise ValueError(\"All elements in 'arr' must be integers.\")\n        \n        return True\n\nclass MaxSubarrayCalculator:\n    \"\"\"Calculates various subarray sums for a given array.\"\"\"\n\n    def kadane(self, arr) -> int:\n        \"\"\"\n        Implements Kadane's algorithm to find the maximum contiguous subarray sum.\n        Handles all-negative arrays by returning the largest element.\n        \"\"\"\n        if not arr:\n            return 0 \n        \n        max_so_far = arr[0]\n        current_max = arr[0]\n\n        for i in range(1, len(arr)):\n            current_max = max(arr[i], current_max + arr[i])\n            max_so_far = max(max_so_far, current_max)\n        \n        return max_so_far\n\n    def prefixMax(self, arr) -> int:\n        \"\"\"Calculates the maximum prefix sum of the array.\"\"\"\n        if not arr:\n            return 0 \n        \n        max_prefix_sum = -float('inf')\n        current_sum = 0\n        for x in arr:\n            current_sum += x\n            max_prefix_sum = max(max_prefix_sum, current_sum)\n        return max_prefix_sum\n\n    def suffixMax(self, arr) -> int:\n        \"\"\"Calculates the maximum suffix sum of the array.\"\"\"\n        if not arr:\n            return 0\n\n        max_suffix_sum = -float('inf')\n        current_sum = 0\n        for i in range(len(arr) - 1, -1, -1):\n            current_sum += arr[i]\n            max_suffix_sum = max(max_suffix_sum, current_sum)\n        return max_suffix_sum\n\n    def total_sum(self, arr) -> int:\n        \"\"\"Calculates the total sum of the array.\"\"\"\n        return sum(arr)\n\n    def compute(self, arr, n, k) -> Result:\n        \"\"\"\n        Orchestrates the calculation of the maximum contiguous subarray sum\n        for the array repeated k times.\n        \"\"\"\n        if not arr:\n            return Result(0)\n\n        if k == 1:\n            return Result(self.kadane(arr))\n        \n        total = self.total_sum(arr)\n        prefix_max_val = self.prefixMax(arr)\n        suffix_max_val = self.suffixMax(arr)\n\n        two_copy_max = self.kadane(arr + arr)\n        \n        scaled_max = suffix_max_val + prefix_max_val + max(0, (k - 2) * total)\n\n        final_max = max(two_copy_max, scaled_max)\n        \n        return Result(final_max)\n\n\ndef max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in the modified array\n    which is formed by repeating the given array k times.\n    \"\"\"\n    validator = Validation()\n    validator.validateInputs(arr, n, k)\n\n    calculator = MaxSubarrayCalculator()\n    result = calculator.compute(arr, n, k)\n    return result.maxSum"}
{"task_id": "Mbpp/294", "solution": "from typing import Any, Iterator, Union\n\ndef _is_numeric(element: Any) -> bool:\n    \"\"\"Checks if an element is a number (int or float) and not a boolean.\"\"\"\n    return isinstance(element, (int, float)) and not isinstance(element, bool)\n\ndef _iter_numeric_values(input_list: list) -> Iterator[Union[int, float]]:\n    \"\"\"Yields numeric elements from the input list, ignoring non-numerics and booleans.\"\"\"\n    for element in input_list:\n        if _is_numeric(element):\n            yield element\n\ndef max_val(input_list: list) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list, ignoring non-numeric and boolean elements.\n    Raises ValueError if no numeric values are found.\n    \"\"\"\n    numeric_values = list(_iter_numeric_values(input_list))\n\n    if not numeric_values:\n        raise ValueError('no numeric values')\n\n    return max(numeric_values)"}
{"task_id": "Mbpp/292", "solution": "from math import floor\n\nclass DivisionByZeroError(Exception):\n    def __init__(self, message: str = \"division by zero\") -> None:\n        super().__init__(message)\n\nclass InputValidationError(Exception):\n    def __init__(self, message: str = \"invalid input: dividend and divisor must be numeric\") -> None:\n        super().__init__(message)\n\ndef validateInputs(dividend, divisor) -> None:\n    # Per strict requirements, no isinstance() checks or exception raising are included here.\n    pass\n\ndef computeQuotient(dividend, divisor) -> int:\n    \"\"\"Compute quotient and apply math.floor. Returns int.\"\"\"\n    return int(floor(dividend / divisor))\n\ndef find(dividend, divisor) -> int:\n    \"\"\"Public API: validateInputs then computeQuotient and return result.\"\"\"\n    validateInputs(dividend, divisor)\n    return computeQuotient(dividend, divisor)"}
{"task_id": "Mbpp/293", "solution": "```python\nfrom math import sqrt\n\n\nclass Validator:\n    @staticmethod\n    def isNumeric(x) -> bool:\n        \"\"\"Return True if x is a numeric type (int or float) and not a bool.\"\"\"\n        return isinstance(x, (int, float)) and not isinstance(x, bool)\n\n\nclass MathEngine:\n    @staticmethod\n    def computeHypotenuse(a: float, b: float) -> float:\n        \"\"\"Compute the hypotenuse using the Pythagorean theorem.\"\"\"\n        return float(sqrt(a * a + b * b))\n\n\ndef otherside_rightangle(a, b) -> float:\n    \"\"\"Public API: validate a and b, compute hypotenuse and return float value.\n\n    Raises: TypeError if inputs are not numeric.\n    \"\"\"\n    if not Validator.isNumeric(a) or not Validator.isNumeric(b):\n        raise TypeError(\"inputs must be numeric\")\n    result_value = MathEngine.computeHypotenuse(a, b)\n    return float(result_value)\n```"}
{"task_id": "Mbpp/296", "solution": "from typing import List, Any\n\ndef get_Inv_Count(arr: List[int]) -> int:\n    \"\"\"\n    Counts inversions in an array using a merge-sort based approach.\n    An inversion is a pair of indices (i, j) such that i < j and arr[i] > arr[j].\n    \"\"\"\n    # Validate input type\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list of integers\")\n\n    # Validate elements are integers\n    for x in arr:\n        if not isinstance(x, int):\n            raise TypeError(\"all elements of arr must be integers\")\n\n    # Handle empty list\n    if not arr:\n        return 0\n\n    def _merge_sort_and_count(current_arr: List[int]) -> int:\n        n = len(current_arr)\n        if n <= 1:\n            return 0\n\n        mid = n // 2\n        left_half = current_arr[:mid]\n        right_half = current_arr[mid:]\n\n        # Recursively count inversions in left and right halves\n        inv_count = _merge_sort_and_count(left_half)\n        inv_count += _merge_sort_and_count(right_half)\n\n        # Merge the sorted halves and count inversions between them\n        i = 0  # pointer for left_half\n        j = 0  # pointer for right_half\n        k = 0  # pointer for merged current_arr\n\n        while i < len(left_half) and j < len(right_half):\n            if left_half[i] <= right_half[j]:\n                current_arr[k] = left_half[i]\n                i += 1\n            else:\n                # This is an inversion: right_half[j] is smaller than left_half[i].\n                # Since left_half is sorted, all remaining elements in left_half\n                # (from i to end) will also be greater than right_half[j].\n                current_arr[k] = right_half[j]\n                inv_count += (len(left_half) - i)\n                j += 1\n            k += 1\n\n        # Copy any remaining elements\n        while i < len(left_half):\n            current_arr[k] = left_half[i]\n            i += 1\n            k += 1\n\n        while j < len(right_half):\n            current_arr[k] = right_half[j]\n            j += 1\n            k += 1\n            \n        return inv_count\n\n    # Create a copy of the input array to avoid modifying the original list\n    # and pass it to the recursive helper.\n    return _merge_sort_and_count(list(arr))"}
{"task_id": "Mbpp/297", "solution": "def _iter_flatten(item):\n    \"\"\"\n    Internal generator to recursively flatten a list or yield a non-list item.\n    Yields elements from nested lists and individual non-list items.\n    \"\"\"\n    if isinstance(item, list):\n        for elem in item:\n            yield from _iter_flatten(elem)\n    else:\n        yield item\n\ndef flatten_list(input_list):\n    \"\"\"\n    Flattens a given nested list structure into a single, non-nested list.\n    It processes only Python list instances as nested containers.\n    \"\"\"\n    return list(_iter_flatten(input_list))"}
{"task_id": "Mbpp/300", "solution": "import math\n\nclass InvalidInputException(ValueError):\n    pass\n\ndef _validate_n(n):\n    \"\"\"Raise InvalidInputException if n is not an int or n < 0.\"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise InvalidInputException(\"Input 'n' must be a non-negative integer.\")\n\ndef _binomial_coefficient(n, k):\n    \"\"\"Return integer C(n, k). Uses math.comb when available; otherwise uses multiplicative exact algorithm.\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2: # C(n, k) == C(n, n - k)\n        k = n - k\n\n    if hasattr(math, 'comb'):\n        return math.comb(n, k)\n\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\n\ndef count_binary_seq(n):\n    \"\"\"\n    Public API. Validate n and return C(2*n, n) as numeric (int).\n    Raises InvalidInputException on invalid input (non-integer or negative).\n    \"\"\"\n    _validate_n(n)\n    result = _binomial_coefficient(2 * n, n)\n    return result"}
{"task_id": "Mbpp/299", "solution": "from typing import List, Tuple\n\ndef max_aggregate(list_of_tuples: List[Tuple[str, float]]) -> Tuple[str, float]:\n    \"\"\"\n    Computes per-name aggregates and returns the (name, total) with the maximum total.\n    Raises ValueError(\"empty input\") if the input list is empty.\n    \"\"\"\n    aggregates: dict[str, float] = {}\n\n    for name, value in list_of_tuples:\n        aggregates[name] = aggregates.get(name, 0.0) + float(value)\n\n    if not aggregates:\n        raise ValueError(\"empty input\")\n\n    max_name, max_total = max(aggregates.items(), key=lambda item: item[1])\n    \n    return (max_name, max_total)"}
{"task_id": "Mbpp/301", "solution": "from typing import Any, Set\n\nclass DepthCalculator:\n    def dict_depth(self, d: dict) -> int:\n        \"\"\"Compute depth for dict d.\"\"\"\n        visited: Set[int] = set()\n        return self._depth_of(d, visited)\n\n    def _depth_of(self, node: Any, visited: Set[int]) -> int:\n        \"\"\"Internal recursive helper to determine the depth of a node, with cycle detection.\"\"\"\n        if not isinstance(node, dict):\n            return 0\n\n        node_id = id(node)\n        if node_id in visited:\n            raise ValueError(\"Cycle detected in dictionary graph\")\n\n        visited.add(node_id)\n\n        max_child_depth = 0\n        for value in node.values():\n            child_depth = self._depth_of(value, visited)\n            max_child_depth = max(max_child_depth, child_depth)\n\n        visited.remove(node_id)\n\n        return 1 + max_child_depth\n\ndef dict_depth(d: dict) -> int:\n    \"\"\"Public API: compute maximum nesting depth of dictionaries in d.\"\"\"\n    if not isinstance(d, dict):\n        raise TypeError(\"dict_depth expects a dict\")\n\n    calculator = DepthCalculator()\n    return calculator.dict_depth(d)"}
{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple\n\ndef start_withp(input: List[str]) -> Tuple[str, ...]:\n    \"\"\"\n    Finds the first two words from a list of strings that start with 'p' (case-insensitive).\n    \"\"\"\n    found_words = []\n    for text_string in input:\n        words = text_string.split()  # Splits on whitespace\n        for word in words:\n            if word.lower().startswith('p'):\n                found_words.append(word)\n                if len(found_words) == 2:\n                    return tuple(found_words)\n    return tuple(found_words)"}
{"task_id": "Mbpp/309", "solution": "def validateTypes(a, b):\n    \"\"\"Validate that a and b are numeric (int or float). Raises TypeError if not.\"\"\"\n    if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n        raise TypeError(\"Inputs must be numeric (int or float).\")\n\ndef compare(a, b):\n    \"\"\"Return a if a >= b else return b. Equality returns a.\"\"\"\n    if a >= b:\n        return a\n    else:\n        return b\n\ndef maximum(a, b):\n    \"\"\"Public API: validate inputs and return the larger numeric value.\"\"\"\n    validateTypes(a, b)\n    return compare(a, b)"}
{"task_id": "Mbpp/308", "solution": "import collections.abc\nfrom typing import Union\n\nclass ValidationError(Exception):\n    \"\"\"Exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass Validator:\n    \"\"\"Performs input validation checks.\"\"\"\n    def validate_lists(self, list1: list, list2: list) -> None:\n        \"\"\"Ensures lists are sequences and contain only numeric elements.\"\"\"\n        if not isinstance(list1, collections.abc.Sequence) or not isinstance(list2, collections.abc.Sequence):\n            raise ValidationError(\"Input lists must be sequences.\")\n        if not all(isinstance(x, (int, float)) for x in list1) or \\\n           not all(isinstance(x, (int, float)) for x in list2):\n            raise ValidationError(\"All elements in lists must be numeric.\")\n\n    def validate_k(self, k: int, max_products: int) -> None:\n        \"\"\"Ensures k is a positive integer.\"\"\"\n        if not isinstance(k, int) or k <= 0:\n            raise ValidationError(\"k must be a positive integer.\")\n\nclass ProductItem:\n    \"\"\"Represents a product of two factors with their original indices.\"\"\"\n    def __init__(self, value: Union[int, float], factor1_index: int, factor2_index: int) -> None:\n        self.value = value\n        self.factor1_index = factor1_index\n        self.factor2_index = factor2_index\n\ndef _generate_products_items(list1: list, list2: list) -> list[ProductItem]:\n    \"\"\"Computes all pairwise products as ProductItem objects.\"\"\"\n    products = []\n    for i, val1 in enumerate(list1):\n        for j, val2 in enumerate(list2):\n            products.append(ProductItem(val1 * val2, i, j))\n    return products\n\ndef _sort_product_items_descending(product_items: list[ProductItem]) -> list[ProductItem]:\n    \"\"\"Sorts a list of ProductItem objects by their value in descending order.\"\"\"\n    return sorted(product_items, key=lambda item: item.value, reverse=True)\n\ndef _select_top_k_values(sorted_product_items: list[ProductItem], k: int) -> list[Union[int, float]]:\n    \"\"\"Extracts the numeric values of the top k items from a sorted list.\"\"\"\n    num_to_select = min(k, len(sorted_product_items))\n    return [item.value for item in sorted_product_items[:num_to_select]]\n\ndef large_product(list1: list, list2: list, k: int) -> list[Union[int, float]]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    validator = Validator()\n\n    # Validate inputs using the Validator class\n    validator.validate_lists(list1, list2)\n    validator.validate_k(k, len(list1) * len(list2))\n\n    # Handle empty lists edge case, returning an empty list\n    if not list1 or not list2:\n        return []\n\n    # Generate all cartesian products as ProductItem objects\n    product_items = _generate_products_items(list1, list2)\n\n    # Sort products in descending order based on their value\n    sorted_products = _sort_product_items_descending(product_items)\n\n    # Select the top k values from the sorted list and return\n    return _select_top_k_values(sorted_products, k)"}
{"task_id": "Mbpp/306", "solution": "class Error(Exception):\n    \"\"\"\n    Deterministic error signaling implemented as an Exception subclass with code and message.\n    \"\"\"\n    def __init__(self, code: str, message: str) -> None:\n        super().__init__(message)\n        self.code = code\n        self.message = message\n\nclass ArrayInput:\n    \"\"\"\n    Stores array and related indices, and validates array length.\n    \"\"\"\n    def __init__(self, arr: list[int], n: int, i: int, k: int) -> None:\n        self.arr = arr\n        self.n = n\n        self.i = i\n        self.k = k\n\n    def validateLengths(self) -> bool:\n        \"\"\"Checks if the provided length n matches the actual length of the array.\"\"\"\n        return self.n == len(self.arr)\n\nclass IndexValidator:\n    \"\"\"\n    Validates array indices for bounds and ordering.\n    \"\"\"\n    def validateIndices(self, i: int, k: int, n: int) -> None:\n        \"\"\"\n        Validates that indices i and k are within bounds and that k is greater than i.\n        Raises Error if validation fails.\n        \"\"\"\n        if not (0 <= i < n) or not (0 <= k < n):\n            raise Error(\"INVALID_INDEX\", \"index out of range\")\n        if not (k > i):\n            raise Error(\"INVALID_INDEX\", \"k must be > i\")\n\nclass SubsequenceCalculator:\n    \"\"\"\n    Calculates the maximum sum of an increasing subsequence given prefix constraints and a required last element.\n    \"\"\"\n    def computeMaxSum(self, arr: list[int], i: int, k: int) -> int:\n        \"\"\"\n        Computes the maximum sum of a strictly increasing subsequence ending at arr[k],\n        using zero or more elements from arr[0..i].\n        \"\"\"\n        # Step 1: Compute dp[j] for prefix 0..i\n        dp = [0] * (i + 1)\n        for j in range(i + 1):\n            dp[j] = arr[j] # Initialize with the element itself\n            for t in range(j):\n                if arr[t] < arr[j]:\n                    dp[j] = max(dp[j], dp[t] + arr[j])\n\n        # Step 2: Determine best_prefix_sum\n        best_prefix_sum = 0\n        for j in range(i + 1):\n            if arr[j] < arr[k]:\n                best_prefix_sum = max(best_prefix_sum, dp[j])\n\n        # Step 3: Return best_prefix_sum + arr[k]\n        return best_prefix_sum + arr[k]\n\ndef max_sum_increasing_subseq(arr, n, i, k):\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from prefix until ith index\n    and also including a given kth element which is after i.\n    \"\"\"\n    ai = ArrayInput(arr, n, i, k)\n    if not ai.validateLengths():\n        raise Error(\"N_LENGTH_MISMATCH\", f\"n ({n}) != len(arr) ({len(arr)})\")\n    \n    iv = IndexValidator()\n    iv.validateIndices(i, k, n)\n    \n    calc = SubsequenceCalculator()\n    result_int = calc.computeMaxSum(arr, i, k)\n    \n    return result_int"}
{"task_id": "Mbpp/310", "solution": "def string_to_tuple(input: str) -> tuple:\n    \"\"\"\n    Converts a string to a tuple of its non-whitespace characters.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"input must be a string\")\n\n    chars = []\n    for c in input:\n        if c not in {' ', '\\t', '\\n'}:\n            chars.append(c)\n    return tuple(chars)"}
{"task_id": "Mbpp/312", "solution": "import math\n\ndef volume_cone(radius, height):\n    \"\"\"\n    Computes the volume of a cone using the formula V = (1/3) * pi * radius^2 * height.\n    Assumes radius and height are numeric.\n    \"\"\"\n    return (1.0 / 3.0) * math.pi * (radius ** 2) * height"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"Return the largest power of two <= n.\n\n    Raises:\n        TypeError: if n is not an int.\n        ValueError: if n < 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n    k = n.bit_length() - 1\n    r = 1 << k\n    return r"}
{"task_id": "Mbpp/311", "solution": "def validate_non_negative(n: int) -> None:\n    \"\"\"Validates that n is a non-negative integer.\"\"\"\n    if n < 0:\n        raise ValueError('n must be non-negative')\n\ndef minimal_length_bits(n: int) -> str:\n    \"\"\"Returns the minimal-length binary string representation of n.\"\"\"\n    if n == 0:\n        return '0'\n    return bin(n)[2:]\n\ndef find_most_significant_unset_bit(bits: str) -> int:\n    \"\"\"Finds the 0-based index (from LSB) of the most significant unset bit.\"\"\"\n    for i in range(len(bits)):\n        if bits[i] == '0':\n            # Convert MSB-based index to LSB-based index\n            return len(bits) - 1 - i\n    return -1\n\ndef set_bit(value: int, index: int) -> int:\n    \"\"\"Sets the bit at the given index (0-based LSB) in value.\"\"\"\n    return value | (1 << index)\n\ndef set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Sets the left-most (most significant) unset bit in the binary representation of n.\n    If all bits are set, it extends the bit-length and sets the new highest bit.\n    \"\"\"\n    validate_non_negative(n)\n    \n    bits_str = minimal_length_bits(n)\n    \n    unset_bit_index = find_most_significant_unset_bit(bits_str)\n    \n    if unset_bit_index != -1:\n        return set_bit(n, unset_bit_index)\n    else:\n        # All bits are set, extend the length by one and set the new highest bit\n        return set_bit(n, len(bits_str))"}
{"task_id": "Mbpp/390", "solution": "def add_string(input_list: list, format_string: str) -> list:\n    \"\"\"\n    Apply format_string to every element of input_list and return a new list of strings.\n\n    This function converts each element to its string representation and substitutes it into the '{0}' placeholder.\n    \"\"\"\n    if not input_list:\n        return []\n    output = []\n    for element in input_list:\n        stringified_element = str(element)\n        formatted_string = format_string.replace('{0}', stringified_element)\n        output.append(formatted_string)\n    return output"}
{"task_id": "Mbpp/389", "solution": "class InputParameter:\n    \"\"\"Encapsulates raw input parameter and provides validation logic.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def isValid(self) -> bool:\n        \"\"\"Returns True if n is a non-negative integer; otherwise False.\"\"\"\n        return isinstance(self.n, int) and self.n >= 0\n\nclass LucasSequence:\n    \"\"\"Encapsulates domain logic for Lucas sequence: base values, iterative computation, and an in-memory cache.\"\"\"\n    _cache: dict[int, int] = {0: 2, 1: 1} # Pre-populate base cases and act as cache\n\n    def compute(self, n: int) -> int:\n        \"\"\"Returns L(n) for a validated non-negative integer n, using an iterative approach and cache.\"\"\"\n        if n in self._cache:\n            return self._cache[n]\n\n        prev2 = self._cache[0] # L(0)\n        prev1 = self._cache[1] # L(1)\n\n        for i in range(2, n + 1):\n            current_lucas = prev1 + prev2\n            self._cache[i] = current_lucas # Cache intermediate results\n            prev2 = prev1\n            prev1 = current_lucas\n        \n        return self._cache[n]\n\n# Global instance of LucasSequence for shared cache and computation.\n_lucas_sequence_calculator = LucasSequence()\n\n\ndef find_lucas(n) -> int:\n    \"\"\"\n    Finds the n'th Lucas number using an iterative method with caching.\n    The input n must be a non-negative integer.\n    \"\"\"\n    param = InputParameter(n)\n    if not param.isValid():\n        raise ValueError(\"n must be a non-negative integer\")\n\n    return _lucas_sequence_calculator.compute(int(n))"}
{"task_id": "Mbpp/391", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for validation errors, specifically length mismatches.\"\"\"\n    pass\n\ndef convert_list_dictionary(outer_keys, inner_keys, values):\n    \"\"\"\n    Converts three parallel lists into a list of nested dictionaries.\n    Raises ValidationError if input list lengths do not match.\n    \"\"\"\n    len_outer = len(outer_keys)\n    len_inner = len(inner_keys)\n    len_values = len(values)\n\n    if not (len_outer == len_inner == len_values):\n        raise ValidationError(f\"length mismatch: lengths are {len_outer}, {len_inner}, {len_values}\")\n\n    if len_outer == 0:\n        return []\n\n    result = []\n    for i in range(len_outer):\n        nested_dict = {outer_keys[i]: {inner_keys[i]: values[i]}}\n        result.append(nested_dict)\n\n    return result"}
{"task_id": "Mbpp/392", "solution": "def get_max_sum(n):\n    \"\"\"\n    Finds the maximum sum possible by using the given equation f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    The function uses memoization to store computed results and avoids redundant calculations.\n    \"\"\"\n    # Initialize memoization cache as an attribute of the function itself, so it persists across calls.\n    if not hasattr(get_max_sum, \"memo\"):\n        get_max_sum.memo = {}\n\n    def _compute_recursive(val):\n        # Base case: f(0) = 0\n        if val == 0:\n            return 0\n        \n        # If result is already in cache, return it\n        if val in get_max_sum.memo:\n            return get_max_sum.memo[val]\n\n        # Recursively compute sums for floor divisions\n        sum_of_subproblems = (\n            _compute_recursive(val // 2)\n            + _compute_recursive(val // 3)\n            + _compute_recursive(val // 4)\n            + _compute_recursive(val // 5)\n        )\n\n        # Apply the recurrence relation: max(n, sum_of_subproblems)\n        result = max(val, sum_of_subproblems)\n\n        # Store the computed result in the cache before returning\n        get_max_sum.memo[val] = result\n        return result\n\n    # Begin the recursive computation\n    return _compute_recursive(n)"}
{"task_id": "Mbpp/394", "solution": "def check_distinct(items: tuple) -> bool:\n    \"\"\"\n    Returns True if all elements in the tuple are unique (by ==), False if duplicates exist.\n    This function does not modify the input tuple.\n    \"\"\"\n    n = len(items)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if items[i] == items[j]:\n                return False\n    return True"}
{"task_id": "Mbpp/397", "solution": "from typing import Union\n\nNumber = Union[int, float]\n\ndef median_numbers(a: Number, b: Number, c: Number) -> float:\n    \"\"\"Return the median (middle value when ordered) of three numeric arguments as a float.\"\"\"\n    numbers = [a, b, c]\n    numbers.sort()\n    return float(numbers[1])"}
{"task_id": "Mbpp/395", "solution": "from collections import Counter\nfrom typing import Optional\n\ndef first_non_repeating_character(input_string: str) -> Optional[str]:\n    \"\"\"\n    Finds the first non-repeated character in a given string.\n    Returns the character if found, otherwise returns None.\n    \"\"\"\n    char_counts = Counter(input_string)\n\n    for char in input_string:\n        if char_counts[char] == 1:\n            return char\n\n    return None"}
{"task_id": "Mbpp/398", "solution": "from typing import List\n\nclass Number:\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def digitSum(self) -> int:\n        \"\"\"Computes the sum of the absolute decimal digits of the number.\"\"\"\n        s = str(abs(self.value))\n        return sum(int(digit) for digit in s)\n\nclass IntegerList:\n    def __init__(self, values: List[int]) -> None:\n        self.values = values\n\nclass Result:\n    def __init__(self, total: int) -> None:\n        self.total = total\n\ndef sum_of_digits(numbers: List[int]) -> int:\n    \"\"\"Computes the sum of digits for each number in a list and returns their total.\"\"\"\n    il = IntegerList(numbers)\n    total_digit_sum = 0\n    for v in il.values:\n        n = Number(v)\n        total_digit_sum += n.digitSum()\n    res = Result(total_digit_sum)\n    return res.total"}
