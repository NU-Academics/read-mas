{"task_id": "Mbpp/264", "solution": "from src.domain import InputParameter, OutputValue\n\nclass DogAgeFunction:\n    \"\"\"\n    Helper class for dog age calculations, encapsulating validation and mapping logic.\n    \"\"\"\n\n    @staticmethod\n    def validateInput(humanYears: int) -> None:\n        \"\"\"\n        Validates that humanYears is an integer, raising TypeError if not.\n        \"\"\"\n        if not isinstance(humanYears, int):\n            raise TypeError(\"humanYears must be an integer.\")\n\n    @staticmethod\n    def applyMapping(humanYears: int) -> int:\n        \"\"\"\n        Computes the dog's age in dog years using a specific algorithm.\n        This algorithm ensures dog_age(12) returns 61.\n        \"\"\"\n        if humanYears <= 2:\n            # First two human years are equivalent to 10.5 dog years each.\n            # We cast to int for an integer result.\n            return int(humanYears * 10.5)\n        else:\n            # Subsequent human years are equivalent to 4 dog years each.\n            return 21 + (humanYears - 2) * 4\n\ndef dog_age(humanYears: int) -> int:\n    \"\"\"\n    Calculates a dog's age in dog years based on human years.\n    \"\"\"\n    # Create InputParameter as per design context for domain class operations.\n    _ = InputParameter(humanYears=humanYears)\n\n    # Validate input type as specified in BR-5.\n    DogAgeFunction.validateInput(humanYears)\n\n    # Compute dog years using the defined mapping logic.\n    dog_years = DogAgeFunction.applyMapping(humanYears)\n\n    # Create OutputValue as per design context for domain class operations.\n    _ = OutputValue(dogYears=dog_years)\n\n    return dog_years"}
{"task_id": "Mbpp/267", "solution": "class Sequence:\n    \"\"\"Generates sequences of natural numbers based on type and start.\"\"\"\n    _start: int = 1\n    _type: str = 'odd'\n\n    def generate(self, n: int) -> list[int]:\n        \"\"\"Returns a list of the first n odd natural numbers starting from _start.\"\"\"\n        return [self._start + 2 * i for i in range(n)]\n\nclass Calculation:\n    \"\"\"Provides methods for numeric operations, specifically squaring and accumulating sums.\"\"\"\n    def square(self, value: int) -> int:\n        \"\"\"Computes the square of a given integer value.\"\"\"\n        return value * value\n\n    def accumulate(self, values: list[int]) -> int:\n        \"\"\"Calculates the sum of squares for a list of integer values.\"\"\"\n        return sum(self.square(v) for v in values)\n\nclass Result:\n    \"\"\"A simple data container to hold the integer sum result.\"\"\"\n    def __init__(self, sum: int):\n        self.sum = sum\n\ndef square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the squares of the first n odd natural numbers.\n    It orchestrates sequence generation and sum calculation using helper classes.\n    \"\"\"\n    sequence_generator = Sequence()\n    odd_numbers = sequence_generator.generate(n)\n\n    calculator = Calculation()\n    total_sum = calculator.accumulate(odd_numbers)\n\n    result_container = Result(sum=total_sum)\n    return result_container.sum"}
{"task_id": "Mbpp/268", "solution": "class StarNumberResult:\n    \"\"\"Immutable value object to hold a star number.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass StarNumberService:\n    \"\"\"Service to validate input and compute star numbers.\"\"\"\n    def validate_input(self, n) -> None:\n        \"\"\"Validates that n is an integer and n >= 1, raising ValueError otherwise.\"\"\"\n        if not (isinstance(n, int) and n >= 1):\n            raise ValueError(\"n must be int >= 1\")\n\n    def compute_star_number(self, n: int) -> int:\n        \"\"\"Computes the nth star number using the formula 6 * n * (n - 1) + 1.\"\"\"\n        result = 6 * n * (n - 1) + 1\n        return result\n\n    def find_star_num(self, n: int) -> int:\n        \"\"\"Validates input, computes, and returns the nth star number.\"\"\"\n        self.validate_input(n)\n        computed_value = self.compute_star_number(n)\n        # StarNumberResult is a conceptual holder; return the integer value directly.\n        return computed_value\n\ndef find_star_num(n) -> int:\n    \"\"\"Finds the nth star number by delegating to StarNumberService.\"\"\"\n    service = StarNumberService()\n    return service.find_star_num(n)"}
{"task_id": "Mbpp/269", "solution": "class InvalidInputError(Exception):\n    def __init__(self, message: str):\n        self.message: str = message\n        super().__init__(message)\n\nclass Character:\n    def __init__(self, value: str):\n        self.value: str = value\n\nclass AsciiCode:\n    def __init__(self, value: int):\n        self.value: int = value\n\nclass InputValidator:\n    def validateLength(self, char: str) -> bool:\n        \"\"\"Return True if len(char) == 1 else False.\"\"\"\n        return len(char) == 1\n\n    def validateRange(self, char: str) -> bool:\n        \"\"\"Return True if ord(char) in 0..127 else False.\"\"\"\n        return 0 <= ord(char) <= 127\n\nclass AsciiConverter:\n    def __init__(self):\n        self._validator = InputValidator()\n\n    def ascii_value(self, char: str) -> int:\n        \"\"\"Validate and convert; raise InvalidInputError on invalid input.\"\"\"\n        if not self._validator.validateLength(char):\n            raise InvalidInputError('Input must be exactly one character.')\n        if not self._validator.validateRange(char):\n            raise InvalidInputError('Input character out of ASCII range 0..127.')\n\n        ch_model = Character(char)\n        ascii_code_model = self._convert_char_to_code(ch_model)\n        return ascii_code_model.value\n\n    def _convert_char_to_code(self, ch: Character) -> AsciiCode:\n        \"\"\"Return AsciiCode for Character.\"\"\"\n        return AsciiCode(ord(ch.value))\n\ndef ascii_value(char: str) -> int:\n    \"\"\"\n    Finds the ASCII value of a character.\n    Raises InvalidInputError if input is not a single ASCII character.\n    \"\"\"\n    converter = AsciiConverter()\n    return converter.ascii_value(char)"}
