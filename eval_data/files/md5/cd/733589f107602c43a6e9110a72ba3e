{"task_id": "Mbpp/448", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass InputValidator:\n    \"\"\"Validates input parameters.\"\"\"\n    def validateNonNegativeInteger(self, n: object) -> None:\n        \"\"\"Raises ValidationError if n is not a non-negative integer.\"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise ValidationError(\"n must be a non-negative integer\")\n\nclass PerrinSequence:\n    \"\"\"Generates and provides Perrin sequence terms.\"\"\"\n    def __init__(self):\n        self.terms: list[int] = []\n\n    def _ensure_generated_up_to(self, maxIndex: int) -> None:\n        \"\"\"Ensures the Perrin sequence is generated up to maxIndex (inclusive).\"\"\"\n        if maxIndex < 0:\n            return\n\n        while len(self.terms) <= maxIndex:\n            current_len = len(self.terms)\n            if current_len == 0:\n                self.terms.append(3)  # P(0)\n            elif current_len == 1:\n                self.terms.append(0)  # P(1)\n            elif current_len == 2:\n                self.terms.append(2)  # P(2)\n            else:\n                # Recurrence P(n) = P(n-2) + P(n-3) for n > 2\n                self.terms.append(self.terms[current_len - 2] + self.terms[current_len - 3])\n\n    def generateUpToIndex(self, maxIndex: int) -> list[int]:\n        \"\"\"Generates and returns Perrin terms from P(0) up to P(maxIndex).\"\"\"\n        self._ensure_generated_up_to(maxIndex)\n        return self.terms[:maxIndex + 1]\n\n    def getTerm(self, i: int) -> int:\n        \"\"\"Returns the i-th Perrin term, generating it if necessary.\"\"\"\n        self._ensure_generated_up_to(i)\n        return self.terms[i]\n\nclass SumCalculation:\n    \"\"\"Accumulates Perrin sequence terms and computes sums.\"\"\"\n    def __init__(self):\n        self.perrin_sequence_generator = PerrinSequence()\n        self.input_validator = InputValidator()\n\n    def calculateSumByIndex(self, maxIndex: int) -> int:\n        \"\"\"Calculates the sum of Perrin numbers from P(0) to P(maxIndex).\"\"\"\n        self.input_validator.validateNonNegativeInteger(maxIndex)\n        perrin_terms = self.perrin_sequence_generator.generateUpToIndex(maxIndex)\n        return sum(perrin_terms)\n\n    def calculateSumByCount(self, count: int) -> int:\n        \"\"\"Calculates the sum of the first 'count' Perrin numbers.\"\"\"\n        self.input_validator.validateNonNegativeInteger(count)\n        perrin_terms = []\n        if count > 0:\n            perrin_terms = self.perrin_sequence_generator.generateUpToIndex(count - 1)\n        return sum(perrin_terms)\n\ndef cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from index 0 to n (inclusive).\"\"\"\n    input_validator = InputValidator()\n    sum_calculator = SumCalculation()\n\n    try:\n        input_validator.validateNonNegativeInteger(n)\n        result_sum = sum_calculator.calculateSumByIndex(n)\n        return result_sum\n    except ValidationError as e:\n        raise ValueError(e.message) from e"}
{"task_id": "Mbpp/453", "solution": "import math\n\nclass Number:\n    \"\"\"Value object representing an integer with utility predicates.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isPositive(self) -> bool:\n        \"\"\"Checks if the number is positive.\"\"\"\n        return self.value > 0\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the number is even.\"\"\"\n        return self.value % 2 == 0\n\nclass Factor:\n    \"\"\"Value object representing a divisor and its parity.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isFactorOf(self, number: Number) -> bool:\n        \"\"\"Checks if this factor's value divides the given number.\"\"\"\n        return number.value % self.value == 0\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the factor's value is even.\"\"\"\n        return self.value % 2 == 0\n\nclass Result:\n    \"\"\"Wrapper for an integer result (sum of even factors).\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def value(self) -> int:\n        \"\"\"Returns the wrapped integer value.\"\"\"\n        return self._value\n\nclass EvenFactorCalculator:\n    \"\"\"Encapsulates logic to find and sum even factors of a number.\"\"\"\n    def sumofFactors(self, n: int) -> int:\n        \"\"\"Calculates the sum of even positive factors for a given integer n.\"\"\"\n        number_obj = Number(n)\n        # Per BR1, factors must be positive. If n is not positive, there are no positive factors.\n        if not number_obj.isPositive():\n            return 0 \n        \n        factors = self.getFactors(number_obj)\n        even_factors = self.filterEven(factors)\n        total_sum = sum(f.value for f in even_factors)\n        return Result(total_sum).value()\n\n    def getFactors(self, number: Number) -> list[Factor]:\n        \"\"\"Finds all positive integer factors of the given number.\"\"\"\n        factors_set = set()\n        # Iterate up to the square root of the number to find pairs of factors.\n        for i in range(1, int(math.sqrt(number.value)) + 1):\n            if number.value % i == 0:\n                factors_set.add(Factor(i))\n                if i * i != number.value:\n                    factors_set.add(Factor(number.value // i))\n        return list(factors_set)\n\n    def filterEven(self, factors: list[Factor]) -> list[Factor]:\n        \"\"\"Filters a list of Factor objects, returning only the even ones.\"\"\"\n        return [f for f in factors if f.isEven()]\n\ndef sumofFactors(n: int) -> int:\n    \"\"\"\n    Finds the sum of even positive integer factors of a number.\n    \"\"\"\n    calculator = EvenFactorCalculator()\n    return calculator.sumofFactors(n)"}
{"task_id": "Mbpp/454", "solution": "import re\n\nclass Word:\n    def __init__(self, raw: str, letters: str):\n        self.raw = raw\n        self.letters = letters\n\n    def hasZ(self) -> bool:\n        \"\"\"Checks if the word's alphabetic portion contains 'z'.\"\"\"\n        return 'z' in self.letters\n\nclass Text:\n    def __init__(self, content: str):\n        self.content = content\n\n    def tokenize(self) -> list[Word]:\n        \"\"\"Tokenizes the text into Word objects based on alphabetic sequences.\"\"\"\n        tokens = []\n        matches = re.findall(r\"[A-Za-z]+\", self.content)\n        for match_str in matches:\n            tokens.append(Word(raw=match_str, letters=match_str))\n        return tokens\n\nclass TextMatchFunction:\n    def run(self, text: str) -> bool:\n        \"\"\"Orchestrates tokenization and matching for the presence of 'z'.\"\"\"\n        text_obj = Text(text)\n        tokens = text_obj.tokenize()\n        for token in tokens:\n            if token.hasZ():\n                return True\n        return False\n\ndef text_match_wordz(text) -> bool:\n    \"\"\"Matches a word containing 'z' in the input text.\"\"\"\n    return TextMatchFunction().run(text)"}
