{"task_id": "Mbpp/441", "solution": "class InputValidator:\n    \"\"\"Utility for validating numeric input.\"\"\"\n\n    @staticmethod\n    def is_numeric(value) -> bool:\n        \"\"\"Checks if the value is an int or float.\"\"\"\n        return isinstance(value, (int, float))\n\n    @staticmethod\n    def validate_size(value) -> None:\n        \"\"\"Validates that the given size is numeric, raising TypeError if not.\"\"\"\n        if not InputValidator.is_numeric(value):\n            raise TypeError(\"size must be numeric\")\n\nclass SurfaceArea:\n    \"\"\"Value object representing a computed surface area.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\nclass Cube:\n    \"\"\"Represents a cube and can compute its surface area.\"\"\"\n    def __init__(self, side_length: float) -> None:\n        self._side_length = side_length\n\n    def compute_surface_area(self) -> SurfaceArea:\n        \"\"\"Computes the surface area of the cube using the formula 6 * size * size.\"\"\"\n        area_value = 6 * self._side_length * self._side_length\n        return SurfaceArea(area_value)\n\ndef surfacearea_cube(size):\n    \"\"\"\n    Calculates the surface area of a cube given its side length.\n\n    Raises TypeError if the input size is not numeric.\n    \"\"\"\n    InputValidator.validate_size(size)\n    cube = Cube(float(size))\n    area_obj = cube.compute_surface_area()\n    return area_obj.value"}
{"task_id": "Mbpp/440", "solution": "class Token:\n    \"\"\"Represents a contiguous non-whitespace substring and its mapping to the original sentence.\"\"\"\n    def __init__(self, start_index: int, end_index: int, raw_text: str):\n        self.start_index = start_index  # Original start index in sentence\n        self.end_index = end_index      # Original end index in sentence (exclusive)\n        self.raw_text = raw_text        # The full raw token text (e.g., \"clearly!!\")\n        self.core_text = \"\"             # The normalized text without surrounding punctuation (e.g., \"clearly\")\n\n    def is_adverb(self) -> bool:\n        \"\"\"Checks if the token's core_text ends with 'ly' (case-insensitive).\"\"\"\n        return self.core_text.lower().endswith('ly')\n\ndef tokenize(sentence: str) -> list[Token]:\n    \"\"\"Splits the sentence into Token objects based on whitespace, preserving original indices.\"\"\"\n    tokens = []\n    current_pos = 0\n    while current_pos < len(sentence):\n        # Skip leading whitespace\n        while current_pos < len(sentence) and sentence[current_pos].isspace():\n            current_pos += 1\n        \n        if current_pos >= len(sentence):\n            break # Reached end of sentence\n            \n        token_start = current_pos\n        \n        # Find end of current non-whitespace sequence\n        token_end = token_start\n        while token_end < len(sentence) and not sentence[token_end].isspace():\n            token_end += 1\n            \n        raw_text = sentence[token_start:token_end]\n        tokens.append(Token(token_start, token_end, raw_text))\n        current_pos = token_end\n    return tokens\n\ndef strip_surrounding_punctuation(token: Token):\n    \"\"\"Normalizes a Token by removing surrounding non-alphanumeric characters and adjusting indices.\"\"\"\n    original_start_index = token.start_index\n    \n    # Find the first alphanumeric character's relative index in raw_text\n    core_start_in_raw = 0\n    while core_start_in_raw < len(token.raw_text) and not token.raw_text[core_start_in_raw].isalnum():\n        core_start_in_raw += 1\n\n    # Find the last alphanumeric character's relative index in raw_text (exclusive)\n    core_end_in_raw = len(token.raw_text)\n    if core_start_in_raw < core_end_in_raw: # Only search if there's a potential core\n        while core_end_in_raw > core_start_in_raw and not token.raw_text[core_end_in_raw - 1].isalnum():\n            core_end_in_raw -= 1\n    else: # No alphanumeric characters found, so the core is empty\n        core_end_in_raw = core_start_in_raw\n\n    token.core_text = token.raw_text[core_start_in_raw:core_end_in_raw]\n    token.start_index = original_start_index + core_start_in_raw\n    token.end_index = original_start_index + core_end_in_raw\n\ndef find_adverb_position(sentence: str) -> tuple:\n    \"\"\"\n    Finds the first adverb and its position in a given sentence.\n    An adverb is defined as a token whose normalized core_text (without surrounding punctuation) ends with 'ly'.\n    \"\"\"\n    tokens = tokenize(sentence)\n\n    for token in tokens:\n        strip_surrounding_punctuation(token)\n        if token.is_adverb():\n            return (token.start_index, token.end_index, token.core_text)\n    \n    # Behavior when no adverb is found is unspecified per design; return None.\n    return None"}
{"task_id": "Mbpp/446", "solution": "def count_Occurrence(input_tuple, input_list):\n    \"\"\"Count occurrences of any element of input_list in input_tuple.\n    Returns the total count as an integer, without modifying the inputs.\n    \"\"\"\n    count = 0\n    for element in input_tuple:\n        if element in input_list:\n            count += 1\n    return count"}
{"task_id": "Mbpp/445", "solution": "def index_multiplication(input1, input2):\n    \"\"\"\n    Performs index-wise multiplication of tuple elements in two given nested tuples.\n    Assumes valid inputs as per problem constraints.\n    \"\"\"\n    result_outer_tuple = []\n    for i in range(len(input1)):\n        result_inner_tuple = []\n        for j in range(len(input1[i])):\n            product = input1[i][j] * input2[i][j]\n            result_inner_tuple.append(product)\n        result_outer_tuple.append(tuple(result_inner_tuple))\n    return tuple(result_outer_tuple)"}
