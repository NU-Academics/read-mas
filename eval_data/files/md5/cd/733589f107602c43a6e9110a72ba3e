{"task_id": "Mbpp/271", "solution": "def even_Power_Sum(n):\n    \"\"\"\n    Compute the sum of the first n even natural numbers each raised to the fifth power.\n    If n is not an integer, raises TypeError. If n <= 0, returns 0.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n <= 0:\n        return 0\n    \n    total_sum = 0\n    for k in range(1, n + 1):\n        total_sum += (2 * k) ** 5\n    return total_sum"}
{"task_id": "Mbpp/274", "solution": "import math\n\nclass Validator:\n    \"\"\"\n    Validates inputs for the even_binomial_Coeff_Sum function.\n    Raises ValueError for invalid inputs according to design.\n    \"\"\"\n    def validate_positive_integer(self, x: object) -> None:\n        \"\"\"\n        Ensures the input is a positive integer (int and > 0).\n        Raises ValueError if the validation fails.\n        \"\"\"\n        if not isinstance(x, int) or x <= 0:\n            raise ValueError(\"Input must be a positive integer.\")\n\nclass BinomialCoefficient:\n    \"\"\"\n    Computes the binomial coefficient C(n, k).\n    Uses math.comb for Python 3.8+ or an integer-safe fallback.\n    \"\"\"\n    def compute(self, n: int, k: int) -> int:\n        \"\"\"\n        Calculates C(n, k) = n! / (k! * (n-k)!).\n        Returns 0 if k is out of range [0, n].\n        \"\"\"\n        if k < 0 or k > n:\n            return 0\n        if hasattr(math, 'comb'):\n            return math.comb(n, k)\n        else:\n            # Fallback for Python versions < 3.8\n            if k == 0 or k == n:\n                return 1\n            if k > n // 2:\n                k = n - k\n            \n            res = 1\n            for i in range(k):\n                res = res * (n - i) // (i + 1)\n            return res\n\nclass Result:\n    \"\"\"\n    A simple container to hold an integer result.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        \"\"\"Initializes the Result with the given integer value.\"\"\"\n        self.value = value\n\ndef even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of binomial coefficients C(n, k) for even k, where 0 <= k <= n.\n    Validates n to be a positive integer and raises ValueError if invalid.\n    \"\"\"\n    validator = Validator()\n    validator.validate_positive_integer(n)\n\n    bc = BinomialCoefficient()\n    total = 0\n    for k in range(0, n + 1, 2):\n        total += bc.compute(n, k)\n    \n    return Result(total).value"}
