{"task_id": "Mbpp/14", "solution": "class TriangularPrism:\n    \"\"\"Represents a triangular prism and calculates its volume.\"\"\"\n    def __init__(self, base: float, height: float, length: float) -> None:\n        self.base = base\n        self.height = height\n        self.length = length\n        self.volume = None\n\n    def compute_volume(self) -> float:\n        \"\"\"Computes the volume of the triangular prism using its dimensions.\"\"\"\n        self.volume = 0.5 * self.base * self.height * self.length\n        return self.volume\n\ndef find_Volume(base, height, length) -> float:\n    \"\"\"Finds the volume of a triangular prism given its base, height, and length.\"\"\"\n    prism = TriangularPrism(base, height, length)\n    return prism.compute_volume()"}
{"task_id": "Mbpp/19", "solution": "from typing import List\n\ndef test_duplicate(arr: List[int]) -> bool:\n    \"\"\"Return True if arr contains any duplicate integer element; False otherwise (including empty array).\"\"\"\n    seen = set()\n    for num in arr:\n        if num in seen:\n            return True\n        seen.add(num)\n    return False"}
{"task_id": "Mbpp/12", "solution": "from dataclasses import dataclass\nfrom typing import List, Sequence\n\n@dataclass\nclass Row:\n    \"\"\"Represents a single row of a matrix with its elements and original index.\"\"\"\n    elements: List[float]\n    original_index: int\n\n    def sum(self) -> float:\n        \"\"\"Calculates the sum of the elements in the row.\"\"\"\n        return sum(self.elements)\n\nclass Matrix:\n    \"\"\"Represents a matrix as a collection of Row objects and provides sorting capabilities.\"\"\"\n    def __init__(self, rows_data: Sequence[Sequence[float]]):\n        self.rows: List[Row] = []\n        for i, row_elements in enumerate(rows_data):\n            self.rows.append(Row(elements=list(row_elements), original_index=i))\n\n    def get_row_sums(self) -> List[float]:\n        \"\"\"Returns a list of sums for each row in the current order.\"\"\"\n        return [row.sum() for row in self.rows]\n\n    def sort_by_row_sum(self, stable: bool = True) -> 'Matrix':\n        \"\"\"Sorts the rows by their sum and returns a new Matrix instance.\"\"\"\n        # Sorts by sum, then by original index for stable tie-breaking.\n        sorted_rows = sorted(self.rows, key=lambda row: (row.sum(), row.original_index))\n\n        # Convert sorted Row objects back to List[List[float]] to construct a new Matrix instance.\n        sorted_matrix_data = [row.elements for row in sorted_rows]\n        return Matrix(sorted_matrix_data)\n\nclass SortFunction:\n    \"\"\"Encapsulates the execution logic for sorting a matrix.\"\"\"\n    name: str = \"sort_matrix\"\n\n    def __init__(self, input_matrix: Matrix):\n        self.input_matrix: Matrix = input_matrix\n        self.output_matrix: Matrix | None = None\n\n    def execute(self, stable: bool = True) -> Matrix:\n        \"\"\"Executes the matrix sorting by row sum.\"\"\"\n        self.output_matrix = self.input_matrix.sort_by_row_sum(stable=stable)\n        return self.output_matrix\n\ndef sort_matrix(matrix: List[List[float]]) -> List[List[float]]:\n    \"\"\"\n    Sorts a given matrix in ascending order according to the sum of its rows.\n    \"\"\"\n    input_matrix_obj = Matrix(matrix)\n    sort_func = SortFunction(input_matrix_obj)\n    sorted_matrix_obj = sort_func.execute(stable=True)\n    result_matrix_list = [row_obj.elements for row_obj in sorted_matrix_obj.rows]\n    return result_matrix_list"}
{"task_id": "Mbpp/17", "solution": "def square_perimeter(side_length):\n    \"\"\"Calculates the perimeter of a square.\n    The perimeter is four times the side length.\"\"\"\n    return 4 * side_length"}
{"task_id": "Mbpp/16", "solution": "import re\n\n# The canonical regex pattern for validation.\n# ^[a-z]+ : matches one or more lowercase letters at the beginning.\n# _       : matches a single underscore.\n# [a-z]+  : matches one or more lowercase letters.\n# $       : matches the end of the string.\nPATTERN: str = r'^[a-z]+_[a-z]+$'\n\ndef text_lowercase_underscore(text: str) -> bool:\n    \"\"\"Returns True if the input string exactly matches two non-empty sequences of lowercase letters separated by a single underscore, otherwise False.\"\"\"\n    return re.fullmatch(PATTERN, text) is not None"}
{"task_id": "Mbpp/18", "solution": "from dataclasses import dataclass\nfrom typing import Set\n\n@dataclass\nclass StringInput:\n    value: str\n\n@dataclass\nclass CharacterSet:\n    chars: str\n    _set: Set[str]\n\n    def __post_init__(self):\n        self._set = set(self.chars)\n\n    def contains(self, ch: str) -> bool:\n        return ch in self._set\n\n@dataclass\nclass CleanedResult:\n    value: str\n\nclass RemoveDirtyCharsFunction:\n    \"\"\"\n    Implements the core logic for removing characters.\n    \"\"\"\n    def remove_dirty_chars(self, first_string: str, second_string: str) -> str:\n        char_set = self._to_char_set(second_string)\n        string_input = StringInput(first_string)\n        cleaned_result = self._filter(string_input, char_set)\n        return cleaned_result.value\n\n    def _to_char_set(self, chars: str) -> CharacterSet:\n        return CharacterSet(chars, set())\n\n    def _filter(self, first: StringInput, charset: CharacterSet) -> CleanedResult:\n        result_chars = []\n        for char in first.value:\n            if not charset.contains(char):\n                result_chars.append(char)\n        return CleanedResult(\"\".join(result_chars))\n\ndef remove_dirty_chars(first_string: str, second_string: str) -> str:\n    \"\"\"\n    Removes characters from the first string that are present in the second string.\n    Preserves the order of characters from the first string.\n    \"\"\"\n    return RemoveDirtyCharsFunction().remove_dirty_chars(first_string, second_string)"}
{"task_id": "Mbpp/20", "solution": "from typing import Optional\n\nclass Number:\n    \"\"\"Represents an integer value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self._value = value\n\n    @property\n    def value(self) -> int:\n        return self._value\n\nclass Calculation:\n    \"\"\"Encapsulates the Woodall number computation.\"\"\"\n    def compute_value(self, n: int) -> int:\n        \"\"\"Computes V(n) = n * 2^n - 1.\"\"\"\n        return n * (2**n) - 1\n\nclass Result:\n    \"\"\"Holds the boolean outcome of a Woodall check.\"\"\"\n    def __init__(self, is_woodall: bool) -> None:\n        self._is_woodall = is_woodall\n\n    @property\n    def is_woodall(self) -> bool:\n        return self._is_woodall\n\nclass WoodallChecker:\n    \"\"\"Orchestrates the Woodall number determination.\"\"\"\n    def is_woodall(self, N: int) -> bool:\n        \"\"\"Checks if N is a Woodall number by iteration.\"\"\"\n        calculator = Calculation()\n        n = 1\n        while True:\n            woodall_candidate = calculator.compute_value(n)\n            if woodall_candidate == N:\n                return True\n            elif woodall_candidate > N:\n                return False\n            n += 1\n\n    def find_witness(self, N: int) -> Optional[int]:\n        \"\"\"Finds the 'n' for a Woodall number N, if it exists.\"\"\"\n        calculator = Calculation()\n        n = 1\n        while True:\n            woodall_candidate = calculator.compute_value(n)\n            if woodall_candidate == N:\n                return n\n            elif woodall_candidate > N:\n                return None\n            n += 1\n\ndef is_woodall(N: int) -> bool:\n    \"\"\"\n    Public API to check if N is a Woodall number.\n    Delegates to WoodallChecker.\n    \"\"\"\n    return WoodallChecker().is_woodall(N)"}
{"task_id": "Mbpp/56", "solution": "class ReverseOperation:\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the integer formed by reversing decimal digits of n, dropping leading zeros.\"\"\"\n        return int(str(n)[::-1])\n\nclass CheckFunction:\n    def __init__(self, reverse_op: ReverseOperation | None = None) -> None:\n        \"\"\"Initializes CheckFunction with an optional ReverseOperation instance.\"\"\"\n        self._reverse_op = reverse_op or ReverseOperation()\n\n    def check(self, n: int) -> bool:\n        \"\"\"Checks if n is one less than twice its reverse.\"\"\"\n        r = self._reverse_op.compute(n)\n        return n == 2 * r - 1\n\ndef check(n: int) -> bool:\n    \"\"\"Checks if a given number is one less than twice its reverse.\"\"\"\n    return CheckFunction().check(n)"}
{"task_id": "Mbpp/57", "solution": "class InputValidationError(Exception):\n    \"\"\"Exception raised for invalid input to find_Max_Num.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass DigitList:\n    \"\"\"Encapsulates input list handling: stores raw digits, validates, and returns sorted descending.\"\"\"\n    def __init__(self, digits: list[int]):\n        self.digits = digits\n\n    def validate(self) -> None:\n        \"\"\"Validates that the input is a list of integers between 0 and 9.\"\"\"\n        if not isinstance(self.digits, list):\n            raise InputValidationError(\"Input must be a list.\")\n        if not all(isinstance(d, int) for d in self.digits):\n            raise InputValidationError(\"All elements in the list must be integers.\")\n        if not all(0 <= d <= 9 for d in self.digits):\n            raise InputValidationError(\"All digits must be between 0 and 9 inclusive.\")\n\n    def to_sorted_desc(self) -> list[int]:\n        \"\"\"Returns the digits sorted in descending order.\"\"\"\n        return sorted(self.digits, reverse=True)\n\nclass NumberResult:\n    \"\"\"Wraps the assembled numeric result and provides conversion to native int.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def to_int(self) -> int:\n        \"\"\"Returns the stored native Python int value.\"\"\"\n        return self.value\n\ndef find_Max_Num(digits: list[int]) -> int:\n    \"\"\"\n    Finds the largest number that can be formed with the given list of digits.\n    The function orchestrates validation, sorting, and number assembly.\n    \"\"\"\n    dl = DigitList(digits)\n    dl.validate()\n    sorted_digits = dl.to_sorted_desc()\n\n    numeric_str = ''.join(map(str, sorted_digits))\n\n    # Handles empty list case by returning 0, as per design\n    result_value = int(numeric_str) if numeric_str else 0\n\n    result = NumberResult(result_value)\n    return result.to_int()"}
{"task_id": "Mbpp/58", "solution": "def _validate_inputs(a: object, b: object) -> None:\n    \"\"\"Raise TypeError if inputs are not ints.\"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"Both arguments must be integers.\")\n\ndef _have_opposite_signs(a: int, b: int) -> bool:\n    \"\"\"Return True if a * b < 0 else False.\"\"\"\n    return (a * b) < 0\n\ndef opposite_Signs(a: int, b: int) -> bool:\n    \"\"\"Return True iff a and b are integers and have opposite signs (a * b < 0).\n    Raises TypeError if either argument is not an int.\n    \"\"\"\n    _validate_inputs(a, b)\n    return _have_opposite_signs(a, b)"}
{"task_id": "Mbpp/59", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for validation errors in octagonal number calculation.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self) -> str:\n        return self.message\n\ndef validateInput(n) -> None:\n    \"\"\"Validates that n is an integer greater than or equal to 1.\"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValidationError(\"n must be an integer >= 1\")\n\ndef computeOctagonal(n: int) -> int:\n    \"\"\"Computes the nth octagonal number using the formula n * (3 * n - 2).\"\"\"\n    return n * (3 * n - 2)\n\ndef is_octagonal(n: int) -> int:\n    \"\"\"\n    Finds the nth octagonal number.\n    Raises ValidationError if n is not an integer or is less than 1.\n    \"\"\"\n    validateInput(n)\n    return computeOctagonal(n)"}
